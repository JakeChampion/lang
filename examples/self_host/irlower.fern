                //
                // Every slot whose buffer holds POINTERS is excluded, because this
                // dec is box-only and the zeroed slot then hides the element walk
                // from the exit sweep — the elements are stranded with no second
                // owner to reach them. The exclusion set is exactly what that sweep
                // deep-frees in its own dedicated loops: string[] and nested arrays,
                // and the three array-of-boxes classes it documents as "excluded
                // from the plain is_arr sweep above". Naming only the first two left
                // an `E[]` / `Inner[]` / `(T, U)[]` local taking the SCALAR path
                // (#7610): the same program with the same local leaked its element
                // boxes when the precise drop fired and was clean when it did not.
                if (dslot >= s.n_params && s.is_arr_slot(dslot)
                        && !s.is_strarr_slot(dslot) && !s.is_arrarr_slot(dslot)
                        && !slot_is_reclaimable_arrenum(s, dslot)
                        && !slot_is_reclaimable_arrstruct(s, dslot)
                        && !slot_is_reclaimable_arrtup(s, dslot)) {
                    s = s.release_zero(dslot, "__fern_rc_dec", "precise-drop-scalar-arr");
                } else if (dslot >= s.n_params && slot_is_reclaimable_struct(s, dslot)
                        && util.index_of_str(xreuse.donors, pdrops.names[pi]) < 0
                        && util.index_of_str(reuse.bases, pdrops.names[pi]) < 0
                        && util.index_of_str(edon.donors, pdrops.names[pi]) < 0
                        && util.index_of_str(inarm.donors, pdrops.names[pi]) < 0) {
                    // Fresh struct local, last-used at statement j: deep-drop its
                    // leak-safe array fields (emit_struct_field_drops — a no-op for a
                    // scalar-only struct, so this subsumes the old scalar-only branch)
                    // then free its box now (shallow __fern_rc_dec) and zero the slot,
                    // so the exit sweep's struct loop decs a guarded null. EXACTLY the
                    // exit-sweep struct free, moved earlier — bounds the live set (peak
                    // heap) without changing the exit contract. precise_drop_names only
                    // admits sole-owner fresh literals (struct_lit_precise_ok), so the
                    // array-field deep-drop frees each buffer once. Skipped when the box
                    // is a reuse/cross-reuse/donor target — freeing it here would race
                    // the box recycling those paths perform (a double-free / UAF).
                    s = emit_struct_field_drops(s, dslot);
                    s = s.emit(ir.op_load_local(dslot));
                    s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    s = s.emit(ir.op_drop());
                    s = s.emit(ir.op_const_i32(0));
                    s = s.emit(ir.op_store_local(dslot));
                } else if (dslot >= s.n_params && slot_is_reclaimable_tuple(s, dslot)
                        && util.index_of_str(xtuple.donors, pdrops.names[pi]) < 0) {
                    // Fresh scalar tuple local, last-used at statement j: give back any
                    // element retains, free its box, and zero the slot, so the exit
                    // sweep's tuple loop decs a guarded null. The tuple sibling of the
                    // struct precise drop above. Skipped when the tuple is a tuple
                    // cross-reuse DONOR (xtuple.donors): emit_cross_tuple_reuse recycles
                    // its box for the recipient, so freeing it here would race that
                    // reuse (a double-free / write-to-freed box — the UAF this guard
                    // prevents).
                    //
                    // The element release is not optional here, and this branch is why
                    // the #7226 retain looked like it barely worked: this drop and the
                    // exit sweep are alternatives, not a sequence — it ZEROES the slot,
                    // so the sweep that does know about element retains then finds null
                    // and releases nothing. It fires whenever the tuple's last mention
                    // is not the final statement, which is most code.
                    s = emit_tup_elem_releases(s, dslot, s.tup_elem_kinds_of(dslot));
                    s = s.emit(ir.op_load_local(dslot));
                    s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    s = s.emit(ir.op_drop());
                    s = s.emit(ir.op_const_i32(0));
                    s = s.emit(ir.op_store_local(dslot));
                } else if (dslot >= s.n_params && pk == "box-shallow") {
                    // Fresh SCALAR Option/Result/enum local, last-used at statement j (a
                    // nested-block match / borrow — precise_drop_names admitted it only
                    // because it has NO top-level consuming match, so it is DISJOINT
                    // from consumed_scalar_enum_frees): free its rc-headered box now
                    // (shallow __fern_rc_dec — the scalar payload carries no rc pointer)
                    // and zero the slot. Options / enum boxes are never exit-swept, so
                    // this is the box's only release — no double-free. Kind-gated (not
                    // slot-type-gated) so a scalar RESULT box (slot type Result[T,E] is
                    // not type_is_scalar_option) OR an un-annotated enum box (no
                    // struct_type on the slot) is freed too, not just a scalar Option.
                    s = s.emit(ir.op_load_local(dslot));
                    s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    s = s.emit(ir.op_drop());
                    s = s.emit(ir.op_const_i32(0));
                    s = s.emit(ir.op_store_local(dslot));
                } else if (dslot >= s.n_params && pk == "opt-rcpayload") {
                    // Fresh rc-PAYLOAD OPTION/RESULT (Option/Result of a leak-safe array
                    // or struct), last-used in a nested block — precise_drop_names
                    // admitted it only with NO top-level match (disjoint from
                    // consumed_rcpayload_option_frees) and a borrow-only payload binding
                    // (opt_body_binding_escapes). Deep-drop the payload (op_opt_payload →
                    // dec) then free the box (emit_opt_payload_drop zeroes the slot too).
                    // The "opt-rcpayload" kind (recorded when the CONSTRUCTED variant was
                    // known) guarantees offset-8 is a pointer — so this fires for a Result
                    // Ok/Err box too, whose Ok-vs-Err payload can't be read from the slot
                    // type. A scalar payload took the "box-shallow" branch above (op_opt_
                    // payload on an inline scalar would wrongly dec the value).
                    s = emit_opt_payload_drop(s, dslot);
                } else if (dslot >= s.n_params && pk.len() > 18 && slice_unchecked(pk, 0, 18) == "opt-structpayload:") {
                    // The STRUCT-payload sibling of "opt-rcpayload" (#6127): the box at
                    // offset 8 is a struct whose rc-array fields the construction
                    // alias-inc'd, so __struct_drop_<T> runs before the box dec
                    // (emit_opt_struct_payload_drop). The struct NAME rides in the kind,
                    // exactly as the enum name does for "enum-rcpayload:" — the slot type
                    // Option[P] names it, but a Result[P, E] does not.
                    s = emit_opt_struct_payload_drop(s, dslot, slice_unchecked(pk, 18, pk.len()));
                } else if (dslot >= s.n_params && pk.len() > 16 && slice_unchecked(pk, 0, 16) == "opt-payloadfree:") {
                    // Fresh STRING- (#4355) or STRING[]- (#6495) payload Option/Result,
                    // last-used in a nested block — same gates as "opt-rcpayload", but
                    // the payload at offset 8 needs a release a plain rc-dec does not
                    // give: __fern_str_free for a string box (rc-dec would free the
                    // 24-byte string block by the ARRAY layout's size class on asm —
                    // wrong class, heap corruption), __fern_str_arr_free for a string[]
                    // (rc-dec frees the buffer and strands every element box). The
                    // helper NAME rides in the kind, as the struct name does above.
                    s = emit_opt_payload_drop_via(s, dslot, slice_unchecked(pk, 16, pk.len()));
                } else if (dslot >= s.n_params && pk.len() > 15 && slice_unchecked(pk, 0, 15) == "enum-rcpayload:"
                        && util.index_of_str(ecross.donors, pdrops.names[pi]) < 0) {
                    // Fresh rc-PAYLOAD user-enum (a variant with a leak-safe array /
                    // deep-drop-ok struct payload), last-used in a nested block —
                    // precise_drop_names admitted it with NO top-level match (disjoint
                    // from consumed_rcpayload_enum_frees) and no escaping arm payload
                    // binding (enum_body_binds_rc_payload). Deep-drop the runtime
                    // variant's rc payload then free the box (emit_enum_variant_drops
                    // zeroes the slot too). The enum NAME rides in the kind after the
                    // "enum-rcpayload:" prefix (the slot type alone can't name it).
                    // SKIPPED when this enum local is an enum->enum cross-reuse DONOR
                    // (ecross.donors): emit_enum_cross_reuse recycles its box into the
                    // recipient c (releasing only the OLD payload arrays, keeping the
                    // box), so freeing the box here would race that reuse — a UAF /
                    // double-free. The box is then freed exactly once via c.
                    s = emit_enum_variant_drops(s, dslot, slice_unchecked(pk, 15, pk.len()));
                } else if (dslot >= s.n_params && pk == "map-buffers") {
                    // Fresh MAP local, last-used in a nested block — free its keys +
                    // values buffers (emit_map_buffers_free: rc-guarded __fern_rc_dec via
                    // raw_load_ptr) + zero the slot right after that statement, bounding
                    // peak heap. The null guard + slot-zero mean the function-exit sweep's
                    // re-call on the same slot sees null and skips (no double-free).
                    s = emit_map_buffers_free(s, dslot);
                }
            }
            pi = pi + 1;
        }
        // Consumed scalar-enum free: if statement j is the consuming match of a
        // single-owner, dead-after enum local, free its box now (dec + zero the
        // slot), mirroring the array precise drop. Sound: the box has an rc header
        // (op_struct_make) and the match already read its scalar payloads as
        // borrows. This is the FALLTHROUGH release; an arm that `return`s never
        // reaches it and is released by the "#b" pending entry set above instead.
        var ei: i32 = 0;
        while (ei < enumfrees.idxs.len()) {
            // Suppress the free if this donor's box was donated to a later enum-donor
            // reuse site (the reuse consumes the box; freeing it too is a double-free).
            if (enumfrees.idxs[ei] == j && util.index_of_str(edon.donors, enumfrees.names[ei]) < 0) {
                var xslot: i32 = s.slot_of(enumfrees.names[ei]);
                if (xslot >= s.n_params) { s = emit_scalar_enum_box_free(s, xslot); }
            }
            ei = ei + 1;
        }
        // Consumed rc-payload enum deep-drop free: if statement j is the consuming
        // match of an rc-payload enum local, deep-drop its variant's rc payload
        // (variant_is dispatch) then free the box now. Disjoint from enumfrees (a
        // pure-scalar enum is in enumfrees, never here) and never a donor, so the
        // box is freed exactly once.
        var rei: i32 = 0;
        while (rei < rcenumfrees.idxs.len()) {
            // Suppress the deep-drop free if this donor's box was donated to a later
            // enum->enum cross-reuse site (emit_enum_cross_reuse recycles the box into
            // the recipient; freeing it here too is a double-free / UAF). The box is
            // then freed exactly once via the recipient c.
            if (rcenumfrees.idxs[rei] == j && util.index_of_str(ecross.donors, rcenumfrees.names[rei]) < 0) {
                var rxslot: i32 = s.slot_of(rcenumfrees.names[rei]);
                // moved_elided: a construction took over this local's reference, so
                // its release belongs to the destination (see the RCENUMS sweep).
                if (rxslot >= s.n_params && !slot_list_has(s.moved_elided, rxslot)) {
                    // Skip the dec of payload fields whose arm binding escaped —
                    // ownership moved to the escapee (#4400).
                    s = emit_enum_variant_drops_gated(s, rxslot, rcenumfrees.enums[rei], match_moved_rc_payloads(fn.body[j], s.structs), true);
                }
            }
            rei = rei + 1;
        }
        // Consumed rc-payload option/result deep-drop free: if statement j is the
        // consuming match of an rc-array-payload option local, deep-drop its payload
        // (op_opt_payload → dec) then free the box now. Disjoint from enumfrees (a
        // scalar-payload option is there, never here), so the box is freed once.
        var roi: i32 = 0;
        while (roi < rcoptfrees.idxs.len()) {
            if (rcoptfrees.idxs[roi] == j) {
                var roslot: i32 = s.slot_of(rcoptfrees.names[roi]);
                if (roslot >= s.n_params) {
                    if (rcoptfrees.tagged[roi]) {
                        s = emit_opt_tagged_payload_drop(s, roslot, rcoptfrees.pfrees[roi], tagged_errfreefn(rcoptfrees.errstrs[roi]));
                    } else if (rcoptfrees.inners[roi].len() > 0) {
                        s = emit_optopt_rc_deep_free(s, roslot, rcoptfrees.inners[roi]);
                    } else if (rcoptfrees.pfrees[roi] != "__fern_rc_dec") {
                        s = emit_opt_payload_drop_via(s, roslot, rcoptfrees.pfrees[roi]);
                    } else if (rcoptfrees.stys[roi].len() > 0) {
                        s = emit_opt_struct_payload_drop(s, roslot, rcoptfrees.stys[roi]);
                    } else {
                        s = emit_opt_payload_drop(s, roslot);
                    }
                }
            }
            roi = roi + 1;
        }
        // Retire a top-level `for` / `match` statement's scoped bindings (loop
        // var / arm bindings) now — after the precise-drop / enum-free passes
        // above, which resolve their own (function-level) names by slot. Runs
        // only for those statement kinds; a plain `var` persists.
        if (stmt_scopes_bindings(fn.body[j])) { s = s.retire_locals_for_scope(stmt_sbase, [fn.body[j]]); }
        j = j + 1;
    }
    // A void body that falls off its end leaves through the backend's default
    // epilogue, which sweeps nothing: every owned local — an `own` param
    // included — leaked there, where the same body ending in `return;` was
    // clean. Give the fallthrough the exit an explicit return takes.
    if (fn.ret_type == "void" && !body_ends_with_return(fn.body)) {
        s = emit_dec_sweep_except(s, 0 - 1);
        s = s.emit(ir.op_const_i32(0));
        s = s.emit(ir.op_return());
    }
    // Tail-call optimisation (#4328): rewrite self-tail recursion into a loop +
    // param-rebind so deep recursion is O(1) stack instead of a SIGSEGV. A no-op
    // for functions without an adjacent `call_direct self ; return` pair.
    var tco_ops: ir.Op[] = tco_self_tail(s.ops, fn.name, s.n_params);
    // Op-list peepholes: constant-fold adjacent `const; const; <foldable bin>`
    // triples and strength-reduce `const K; <binop>` pairs, to a fixpoint. Runs
    // on every build (constfold.fold_module, the AST-level sibling, is gated
    // behind -O), in the shared lowering rather than per backend, so all three
    // get it. See ir.optimize_ops.
    tco_ops = ir.optimize_ops(tco_ops);
    return LowerResult { ok: true, ops: tco_ops, n_locals: s.locals.len(), n_params: s.n_params, erased_wide: erased_wide_stmts(fn.body, s), arr_slots: arr_slots_of(s), i64_slots: i64_slots_of(s), f64_slots: f64_slots_of(s), str_slots: str_slots_of(s), why: "", alias_incs: s.alias_incs };
}

// lower_module lowers every function in a program. It first collects the
// array-returning function names so move-on-return / move-from-call can fire.
// str_ret_fns_of collects the names of a module's string-returning functions
// (for the call-site string tracking). The emitters compute it once per module.
// str_leaf_is_string reports whether a lifted-lambda leaf return expression is
// statically a STRING — a string literal, a `+` concatenation with a string
// operand (in Fern `+` is concat iff a side is a string, so a literal / string-
// returning side on EITHER operand identifies it), or a call to a string-
// returning function (a str builtin, a user fn, or a nested `__lam`). Works off
// the module function list (no LowerState), like the other *_ret_fns_of
// inferences; an unresolvable operand (e.g. a bare string LOCAL) returns false.
function str_leaf_is_string(e: ast.Expr, funcs: parser.FuncDecl[], depth: i32): boolean {
    if (depth > 8) { return false; }
    match (e) {
        ast.ExprString(_) => { return true; },
        ast.ExprBinary(b) => {
            if (b.op == "+") { return str_leaf_is_string(b.left, funcs, depth + 1) || str_leaf_is_string(b.right, funcs, depth + 1); }
            return false;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "string_from_bytes_unchecked") { return true; }
                    for fn in funcs {
                        if (fn.name == cid.name) {
                            if (fn.ret_type == "string") { return true; }
                            if (cid.name.len() >= 6 && slice_unchecked(cid.name, 0, 6) == "__lam_" && fn.body.len() > 0) {
                                return str_leaf_is_string(iife_first_return_expr(fn.body[fn.body.len() - 1]), funcs, depth + 1);
                            }
                            return false;
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

// lam_leaf_array_elem returns the ELEMENT type ("string" / "i32" / "f64") of a
// lifted `__lam_`'s array return — its leaf return is an array LITERAL — or ""
// when it is not an array literal (or an element type this recovery doesn't
// handle, e.g. i64, which is already correct on the IR path). Recurses through a nested
// `__lam_` leaf. Mirrors fn_inferred_struct_ret for the array case: the lifted
// lambda otherwise carries a default i32 ret_type, so `var xs = if (c) { [..] }
// else { .. }` was mis-treated as a SCALAR i32 — the array tracking (is_arr) and
// element-string typing (is_strarr) were both lost, miscompiling 8-byte string
// elements (#3224). A string element type also routes the binding through the
// array's normal owned-move + RC path (rc=1, drop at scope exit).
pub function lam_leaf_array_elem(fn: parser.FuncDecl, funcs: parser.FuncDecl[], depth: i32): string {
    if (depth > 8) { return ""; }
    if (fn.body.len() == 0) { return ""; }
    var re: ast.Expr = iife_first_return_expr(fn.body[fn.body.len() - 1]);
    match (re) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return ""; }
            match (arr.elements[0]) {
                ast.ExprString(_) => { return "string"; },
                ast.ExprNumber(num) => { if (num.is_float) { return "f64"; } return "i32"; },
                // A struct-array literal `[P{..}, …]` — return the element struct
                // type name (the caller verifies it names a declared leak-safe
                // struct before treating it as a struct-array element).
                ast.ExprStructLit(sl) => { return sl.type_name; },
                _ => { return ""; }
            }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    for each_fn in funcs {
                        if (each_fn.name == cid.name && each_fn.receiver_type.len() == 0) {
                            // A nested `__lam_` — recurse into its body.
                            if (cid.name.len() >= 6 && slice_unchecked(cid.name, 0, 6) == "__lam_") { return lam_leaf_array_elem(each_fn, funcs, depth + 1); }
                            // A regular array-returning function in the branch
                            // (`if (c) { mk() } else { … }` where mk returns P[]):
                            // its declared element type is the array element.
                            var crt: string = each_fn.ret_type;
                            if (crt.len() >= 3 && slice_unchecked(crt, crt.len() - 2, crt.len()) == "[]") { return slice_unchecked(crt, 0, crt.len() - 2) + ""; }
                            return "";
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "";
}

// bool_ret_fns_of: rows for every function returning `boolean`. Keyed exactly
// as str_ret_fns_of keys its own — bare for a free function, and
// "<BaseType>.<method>" for a method, because a method name can collide
// across receiver types with different return types (the `to_lower` case
// str_ret_fns_of's comment records). Generic functions are included: a
// `boolean` return is concrete whatever the type parameters are.
pub function bool_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type == "boolean") {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
    }
    return out;
}

pub function str_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type == "string") {
            // A METHOD is keyed "<BaseType>.<method>" (like i64_ret_fns_of /
            // f64_ret_fns_of), NOT its bare name — a method name can collide
            // across receiver types with DIFFERENT return types. A bare key
            // let a byte fold on an i32 wrongly type as string (back when it
            // shared the name `to_lower` with string's), so the chained
            // `b.to_lower().to_ascii_string()` mis-dispatched to the
            // nonexistent `string.to_ascii_string`. The method
            // str-check (expr_is_str) now looks up the qualified key.
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
        // A lifted if-/match-EXPRESSION (`__lam_N`) whose branch is a string
        // CONCAT carries a default `i32` ret_type (the desugar doesn't infer
        // `string + string : string`), so a `(if (c) { "a" + "b" } else { … })`
        // value would mis-dispatch `.len()` to the array path — a silent
        // miscompile. Trust the body: register it as string-returning when its
        // leaf return is statically a string.
        else if (fn.name.len() >= 6 && slice_unchecked(fn.name, 0, 6) == "__lam_" && fn.body.len() > 0) {
            if (str_leaf_is_string(iife_first_return_expr(fn.body[fn.body.len() - 1]), funcs, 0)) { out = out.append(fn.name); }
        }
        // An ERASED-generic free fn whose ret type IS a bare type var bound to
        // a param (`idg[T](x: T): T` — unbounded type params are stripped, so
        // mono never clones it): record a positional "name|$arg<i>" entry
        // meaning "returns whatever argument i is". expr_is_str's call arm
        // resolves it against the actual argument, so `idg("xyz").len()`
        // dispatches as a string read — before, the result was untyped and
        // `.len()` silently read 0. The '|' keeps these entries invisible to
        // is_str_ret_fn's exact-name membership scan.
        else if (fn.receiver_type.len() == 0 && irl_looks_type_var(fn.ret_type)) {
            var gpi: i32 = 0;
            while (gpi < fn.params.len()) {
                if (fn.params[gpi].type_name == fn.ret_type) {
                    out = out.append(fn.name + "|$arg" + util.i32_to_string(gpi));
                    gpi = fn.params.len();
                } else { gpi = gpi + 1; }
            }
        }
    }
    return out;
}

// append_dyn_str_ret_fns folds trait-method entries into a str_ret_fns list so
// a string-returning method chained on a `dyn Trait` dispatch result tracks as
// a string. A `dyn Trait` receiver's tracked type is the coarse "dyn <Trait>"
// string (mark_struct_type at the binding), so expr_is_str's method arm looks
// up "dyn <Trait>.<method>" — the same "<recvType>.<method>" shape it uses for
// a concrete struct receiver. Without an entry there the dispatch result is
// mis-tracked (an i32), and `d.name().len()` lowers `.len()` as a plain deref
// (reads [ptr+0], the string data) instead of the length read ([ptr-4]),
// returning garbage (#5142). The trait's REQUIRED (abstract) method signatures
// carry the declared return type — every impl of the trait returns it — so one
// "dyn <Trait>.<method>" entry per string-returning required method makes the
// chained lowering see a string receiver, exactly as materialising the result
// into a `var s: string` (whose slot carries the string type) already does.
pub function append_dyn_str_ret_fns(base: string[], trait_reqs: parser.TraitReq[]): string[] {
    var out: string[] = base;
    var t: i32 = 0;
    while (t < trait_reqs.len()) {
        var tr: parser.TraitReq = trait_reqs[t];
        var m: i32 = 0;
        while (m < tr.req_sigs.len()) {
            if (tr.req_sigs[m].ret_type == "string") { out = out.append("dyn " + tr.trait_name + "." + tr.req_sigs[m].name); }
            m = m + 1;
        }
        t = t + 1;
    }
    return out;
}

// append_dyn_i64_ret_fns is the i64/u64-return sibling of
// append_dyn_str_ret_fns: without a "dyn <Trait>.<method>" entry in
// i64_ret_fns a 64-bit value returned by a `dyn Trait` dispatch and chained in
// arithmetic (`d.v() + 1`) width-tracks as i32 (infer_expr_width's method arm
// misses the "dyn <Trait>.<method>" key), so the add lowers 32-bit and
// truncates the high word. Mirrors i64_ret_fns_of's "<key>|<retflag><paramflags>"
// format (retflag '1' for an i64/u64 method — u64 rides the i64 path; '3' for a
// u32 method, whose result needs the same unsigned-op selection — #5245).
pub function append_dyn_i64_ret_fns(base: string[], trait_reqs: parser.TraitReq[]): string[] {
    var out: string[] = base;
    var t: i32 = 0;
    while (t < trait_reqs.len()) {
        var tr: parser.TraitReq = trait_reqs[t];
        var m: i32 = 0;
        while (m < tr.req_sigs.len()) {
            var fn: parser.FuncDecl = tr.req_sigs[m];
            if (fn.ret_type == "i64" || fn.ret_type == "u64") {
                var flags: string = "";
                var pj: i32 = 0;
                while (pj < fn.params.len()) {
                    if (fn.params[pj].type_name == "i64" || fn.params[pj].type_name == "u64") { flags = flags + "1"; }
                    else { flags = flags + "0"; }
                    pj = pj + 1;
                }
                out = out.append("dyn " + tr.trait_name + "." + fn.name + "|1" + flags);
            }
            // A u32-returning dyn method rides the '3' RETURN flag (is_u32_ret_fn):
            // `d.v() >> 1` on a `dyn Trait` receiver selects shr_u. Distinct from
            // the '1' i64/u64 case (u32 is 32-bit, so is_i64_ret_fn must exclude
            // it). u32 params flag '0' like every non-64-bit param. (#5245)
            else if (fn.ret_type == "u32") {
                var uflags: string = "";
                var uj: i32 = 0;
                while (uj < fn.params.len()) {
                    if (fn.params[uj].type_name == "i64" || fn.params[uj].type_name == "u64") { uflags = uflags + "1"; }
                    else { uflags = uflags + "0"; }
                    uj = uj + 1;
                }
                out = out.append("dyn " + tr.trait_name + "." + fn.name + "|3" + uflags);
            }
            m = m + 1;
        }
        t = t + 1;
    }
    return out;
}

// append_dyn_f64_ret_fns is the f64/f32-return sibling: an f64/f32 value
// returned by a `dyn Trait` dispatch and chained (`d.f() + 0.5`) mis-lowers as
// integer arithmetic on the float bits without a "dyn <Trait>.<method>" entry in
// f64_ret_fns (expr_is_f64's method arm misses the key). f32 rides the f64 twin
// for value ops, so is_f64_scalar_type_name (which matches both) is the right
// filter. Plain membership like f64_ret_fns_of (no flag suffix).
pub function append_dyn_f64_ret_fns(base: string[], trait_reqs: parser.TraitReq[]): string[] {
    var out: string[] = base;
    var t: i32 = 0;
    while (t < trait_reqs.len()) {
        var tr: parser.TraitReq = trait_reqs[t];
        var m: i32 = 0;
        while (m < tr.req_sigs.len()) {
            if (is_f64_scalar_type_name(tr.req_sigs[m].ret_type)) { out = out.append("dyn " + tr.trait_name + "." + tr.req_sigs[m].name); }
            m = m + 1;
        }
        t = t + 1;
    }
    return out;
}

// append_dyn_arr_ret_fns folds "dyn <Trait>.<method>" entries into an ARRAY
// element-typing registry (i64arr / f64arr / strarr) for every required trait
// method whose return type is exactly `elem`. Without it a DIRECTLY-indexed
// dyn-array dispatch result (`d.make()[i]`, no explicitly-typed intermediate
// var) reads its element at the wrong width — arr_index_is_i64 / arr_index_is_f64
// and the strarr element path look up "dyn <Trait>.<method>" in these registries,
// which the `*arr_ret_fns_of` classifiers only key for concrete impl types. A
// `var xs: T[] = d.make()` binding already types the slot, so this only affects
// the direct-chain shape. All three registries use plain "<BaseType>.<method>"
// membership, so one shared helper parameterised on the element spelling covers
// them.
pub function append_dyn_arr_ret_fns(base: string[], trait_reqs: parser.TraitReq[], elem: string): string[] {
    var out: string[] = base;
    var t: i32 = 0;
    while (t < trait_reqs.len()) {
        var tr: parser.TraitReq = trait_reqs[t];
        var m: i32 = 0;
        while (m < tr.req_sigs.len()) {
            if (tr.req_sigs[m].ret_type == elem) { out = out.append("dyn " + tr.trait_name + "." + tr.req_sigs[m].name); }
            m = m + 1;
        }
        t = t + 1;
    }
    return out;
}

// str_ret_argref returns the argument index an erased-generic fn's return
// mirrors ("name|$arg<i>" entries from str_ret_fns_of), or -1. The caller
// re-types the call by the ACTUAL argument at that position.
pub function str_ret_argref(s: LowerState, name: string): i32 {
    return sig_reg_argref(s.sigs.str_ret_fns, name);
}

// strarr_ret_argref is the string-ARRAY sibling ("name|$arg<i>" entries from
// strarr_ret_fns_of, for a `T[]` return whose element mirrors argument i).
pub function strarr_ret_argref(s: LowerState, name: string): i32 {
    return sig_reg_argref(s.sigs.strarr_ret_fns, name);
}

// struct_ret_argref is the struct-element twin: for an erased-generic `T[]`
// return it gives the ARGUMENT index whose element type the result's element type
// equals, or -1. Recorded by struct_ret_fns_of; read by expr_struct_type's call
// arm so an unannotated `var s = idf(xs)` recovers `s[i]`'s struct type.
pub function struct_ret_argref(s: LowerState, name: string): i32 {
    return sig_reg_argref(s.sigs.struct_ret_fns, name);
}

// irl_is_alnum_byte: an identifier byte — [0-9A-Za-z_]. Used to detect a
// STANDALONE single-uppercase-letter type variable (T / K / V …) so a longer
// name like "JsonValue" is never mistaken for one.
function irl_is_alnum_byte(b: i32): boolean {
    return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

// is_bare_typevar_name: a STANDALONE single-uppercase-letter type variable
// (T / K / V …) — the erased-generic param spelling (fn_param_sigs flag '5').
// On wasm such a param/return/local is typed i64 (the uniform 8-byte slot the
// register backends give every param), so an 8-byte value moving opaquely through
// it survives; callers coerce their arg/result at the i64 boundary (#erased-wide).
pub function is_bare_typevar_name(t: string): boolean {
    return t.len() == 1 && t[0] >= b'A' && t[0] <= b'Z';
}

// is_erased_typevar: a single-uppercase-letter spelling that is an ERASED
// generic type variable, NOT a declared single-letter struct/enum (a program
// may name a struct `A` — `is_bare_typevar_name` alone would misread it as a
// typevar and wrongly widen `A.default(): A` to an i64 return). The struct/enum
// exclusion needs the module's decls, so this is the predicate the wasm
// erased-wide widening (#5464) keys on — is_bare_typevar_name stays the pure
// syntactic check for the flag-'5' registry, which is width-gated and inert on
// a struct-typed param anyway.
pub function is_erased_typevar(t: string, structs: parser.StructDecl[]): boolean {
    // Only exclude ACTUALLY-DECLARED single-letter structs/enums — not the broad
    // is_enum_like_name heuristic, which reads any bare uppercase letter (incl. a
    // real typevar `T`) as enum-like and would defeat the widening entirely.
    return is_bare_typevar_name(t) && !decl_is_struct(structs, t) && !decl_is_enum(structs, t);
}

// is_erased_typevar_array reports whether `t` spells an ARRAY of a bare typevar
// (`T[]`). The element sibling of is_erased_typevar: the value is a pointer
// either way, so nothing here is "wide", but the element WIDTH is erased and on
// wasm32 that is the difference between a 4- and an 8-byte stride.
pub function is_erased_typevar_array(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() < 3) { return false; }
    if (slice_unchecked(t, t.len() - 2, t.len()) != "[]") { return false; }
    return is_erased_typevar(slice_unchecked(t, 0, t.len() - 2) + "", structs);
}

// erased_expr_uses_any: does `e` reference any of the (erased-param) names?
function erased_expr_uses_any(e: ast.Expr, names: string[]): boolean {
    var ids: string[] = astwalk.collect_idents_expr(e, []);
    var i: i32 = 0;
    while (i < ids.len()) {
        if (util.index_of_str(names, ids[i]) >= 0) { return true; }
        i = i + 1;
    }
    return false;
}

// erased_return_value_ok: is the returned expression a SAFE erased sink — a bare
// erased-param ident (scalar pass-through), or a TUPLE literal whose elements are
// each such (a tuple pass-through `pair(k,v):(K,V) { return (k,v); }`), or an
// expression that doesn't touch the erased params at all? A wasm tuple rides a
// uniform 8-byte-per-element box, so widening each element to i64 and reading it
// back at the concrete per-element width is layout-safe (#5464 tuple slice). A
// non-tuple compound (a call/closure/arith/Some(k)/[k]) is NOT a safe sink here.
function erased_return_value_ok(e: ast.Expr, names: string[]): boolean {
    match (e) {
        ast.ExprIdent(rid) => { if (util.index_of_str(names, rid.name) >= 0) { return true; } },
        ast.ExprTuple(t) => {
            for el in t.elements {
                if (!erased_return_value_ok(el, names)) { return false; }
            }
            return true;
        },
        _ => {}
    }
    return !erased_expr_uses_any(e, names);
}

// erased_uses_only_returned: is every use of an erased-param name confined to a
// `return <that-param>` (or `return (<params…>)` tuple) position? This is the
// body-safety gate for the #5464 erased-wide widening: widening a param to i64 is
// sound ONLY when the opaque value merely FLOWS OUT via return. The moment it is
// bound to a local, passed to a (concrete-typed) closure/function, used in
// arithmetic, or placed in a non-tuple container, its i64 spelling collides with
// the concrete type the sink expects — e.g.
// `fold[T,A](init:A, f:(A,T)=>A): A { var acc = init; acc = f(acc,..); return acc }`
// passes `A` to a closure typed at the concrete `A`, so init must NOT widen.
// Conservative: any unrecognised statement, or any non-return use, fails safe.
function erased_uses_only_returned(stmts: ast.Stmt[], names: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                // The returned value must be a safe erased sink: a bare erased param,
                // a tuple of such, or an expression not touching the erased params.
                if (!erased_return_value_ok(r.value, names)) { return false; }
            },
            ast.StmtIf(iff) => {
                if (erased_expr_uses_any(iff.cond, names)) { return false; }
                if (!erased_uses_only_returned(iff.then_body, names)) { return false; }
                if (!erased_uses_only_returned(iff.else_body, names)) { return false; }
            },
            ast.StmtWhile(w) => {
                if (erased_expr_uses_any(w.cond, names)) { return false; }
                if (!erased_uses_only_returned(w.body, names)) { return false; }
            },
            ast.StmtFor(fo) => {
                if (erased_expr_uses_any(fo.iter, names)) { return false; }
                if (!erased_uses_only_returned(fo.body, names)) { return false; }
            },
            ast.StmtMatch(m) => {
                if (erased_expr_uses_any(m.scrutinee, names)) { return false; }
                for arm in m.arms {
                    if (arm.has_guard && erased_expr_uses_any(arm.guard, names)) { return false; }
                    if (!erased_uses_only_returned(arm.body, names)) { return false; }
                }
            },
            ast.StmtVar(v) => { if (erased_expr_uses_any(v.init, names)) { return false; } },
            ast.StmtAssign(a) => { if (erased_expr_uses_any(a.value, names)) { return false; } },
            ast.StmtExpr(ex) => { if (erased_expr_uses_any(ex.value, names)) { return false; } },
            ast.StmtDefer(d) => { if (!erased_uses_only_returned([d.action], names)) { return false; } },
            _ => { return false; }
        }
    }
    return true;
}

// erased_passthrough_safe: is `fn` a free erased-generic fn that returns a bare
// typevar and merely passes its erased param(s) through to `return` — the shape
// the wasm backend widens to the uniform i64 slot (#5464)? Everything else (a
// container/concrete return, or a body that USES the erased value) is refused
// here (a wide instantiation defers via erased_wide; a narrow one is
// unaffected).
pub function erased_passthrough_safe(fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    if (!declares_typevars(fn)) { return false; }
    if (fn.receiver_type.len() != 0) { return false; }
    if (!is_erased_typevar(fn.ret_type, structs)) { return false; }
    var enames: string[] = [];
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (is_erased_typevar(fn.params[i].type_name, structs)) { enames = enames.append(fn.params[i].name); }
        i = i + 1;
    }
    if (enames.len() == 0) { return false; }
    return erased_uses_only_returned(fn.body, enames);
}

// declares_typevars reports whether `fn` DECLARES the type variables its
// signature spells. A hoisted `<fn>$wrapN` trampoline copies a lambda's
// parameter and return spellings verbatim, so it can read as a bare-typevar
// pass-through while being an ordinary non-generic function — and its ABI is
// fixed by the arity-keyed indirect-call table, not by erasure. Widening one
// gave it `(param i64) (result i64)` against an all-i32 `call_indirect` type on
// wasm: `indirect call type mismatch` at the first call.
function declares_typevars(fn: parser.FuncDecl): boolean {
    return fn.type_params.len() > 0 || fn.type_param_count > 0;
}

// erased_widenable: is `fn` a free erased-generic fn whose erased params can be
// widened to i64 on wasm — a scalar pass-through (erased_passthrough_safe) OR a
// bare-TUPLE return whose erased params flow only into the returned tuple
// (`pair[K,V](k:K,v:V):(K,V) { return (k,v); }`)? The wasm tuple box is a uniform
// 8-byte-per-element layout, so a widened (i64) element is stored 8-byte and read
// back at the caller's concrete per-element width with no layout change (#5464).
// The SCALAR-only erased_passthrough_safe still gates the (result i64) return
// typing + result narrowing; a tuple return stays an i32 pointer.
pub function erased_widenable(fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    if (erased_passthrough_safe(fn, structs)) { return true; }
    if (!declares_typevars(fn)) { return false; }
    if (fn.receiver_type.len() != 0) { return false; }
    // A BARE tuple return `(A, B)` (not a tuple-array `(A,B)[]`).
    if (!(fn.ret_type.len() > 0 && fn.ret_type[0] == b'(' && !is_array_type_name(fn.ret_type))) { return false; }
    var enames: string[] = [];
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (is_erased_typevar(fn.params[i].type_name, structs)) { enames = enames.append(fn.params[i].name); }
        i = i + 1;
    }
    if (enames.len() == 0) { return false; }
    return erased_uses_only_returned(fn.body, enames);
}

// rewrite_typevars_to_argrefs replaces every STANDALONE single-uppercase-letter
// type variable in a type spelling with a positional "$arg<i>" reference to the
// first param declared with that variable. It works token-wise over the whole
// string, so it rewrites a bare payload (`Option[T]` → `Option[$arg0]`), a
// tuple payload (`Option[(T, i32)]` → `Option[($arg0, i32)]`), or a Result Ok
// arm (`Result[T, i32]` → `Result[$arg0, i32]`) uniformly. An unbound type var
// (no param of that type — e.g. an erased Err type) is left as-is.
pub function rewrite_typevars_to_argrefs(t: string, params: ast.ParamDecl[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < t.len()) {
        var c: i32 = t[i] as i32;
        var is_upper: boolean = c >= 65 && c <= 90;
        var prev_alnum: boolean = i > 0 && irl_is_alnum_byte((t[i - 1] as i32));
        var next_alnum: boolean = i + 1 < t.len() && irl_is_alnum_byte((t[i + 1] as i32));
        if (is_upper && !prev_alnum && !next_alnum) {
            var tv: str = slice_unchecked(t, i, i + 1);
            var repl: string = tv + "";
            var pi: i32 = 0;
            while (pi < params.len()) {
                if (params[pi].type_name == tv) { repl = "$arg" + util.i32_to_string(pi); pi = params.len(); }
                else { pi = pi + 1; }
            }
            out = out + repl;
        } else {
            out = out + slice_unchecked(t, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

// resolve_argref_opt_type substitutes every "$arg<i>" positional reference in an
// erased-generic Option/Result type spelling (rewrite_typevars_to_argrefs's
// output) with the call site's argument-i inferred tag — token-wise, so a bare
// payload (`Option[$arg0]`), a tuple payload (`Option[($arg0, i32)]`), and a
// Result Ok arm (`Result[$arg0, i32]`) all resolve. An out-of-range reference
// degrades to "i32" (the same scalar reading the raw type-var tag produced
// before the rewrite). A spelling with no "$arg" passes through unchanged.
pub function resolve_argref_opt_type(t: string, args: ast.Expr[], s: LowerState): string {
    if (!util.contains(t, "$arg")) { return t; }
    var out: string = "";
    var i: i32 = 0;
    while (i < t.len()) {
        if (i + 4 <= t.len() && slice_unchecked(t, i, i + 4) == "$arg") {
            var j: i32 = i + 4;
            while (j < t.len() && t[j] >= b'0' && t[j] <= b'9') { j = j + 1; }
            var an: i32 = util.digits_to_i32(slice_unchecked(t, i + 4, j));
            if (an >= 0 && an < args.len()) { out = out + elem_type_tag(args[an], s); }
            else { out = out + "i32"; }
            i = j;
        } else {
            out = out + slice_unchecked(t, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// strarr_ret_fns_of collects the names of a module's string[]-returning
// functions (for the call-site element-string tracking).
pub function strarr_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type == "string[]") {
            out = out.append(fn.name);
            // A receiver METHOD additionally gets a QUALIFIED
            // "<BaseType>.<method>" entry so a method-call site
            // (`(f.mks(), 3)` — the tuple-element shape) can resolve it via
            // the receiver's struct type; the bare entry stays for the
            // existing consumers. The qualified spelling never collides with
            // a free-fn lookup (free names carry no '.').
            if (fn.receiver_type.len() > 0) {
                out = out.append(util.base_type_name(fn.receiver_type) + "." + fn.name);
            }
        }
        // An ERASED-generic free fn returning `T[]` for a bare type-var `T`
        // bound to a param (`dup[T](x: T): T[]`): record "name|$arg<i>" so
        // expr_is_strarr re-types the call by the ACTUAL argument — the
        // array sibling of str_ret_fns_of's bare-`T` entries. Invisible to
        // is_strarr_ret_fn's exact-name scan (the '|').
        else if (fn.receiver_type.len() == 0 && fn.ret_type.len() == 3
                && slice_unchecked(fn.ret_type, 1, 3) == "[]" && irl_looks_type_var(slice_unchecked(fn.ret_type, 0, 1))) {
            var sgpi: i32 = 0;
            while (sgpi < fn.params.len()) {
                if (fn.params[sgpi].type_name == slice_unchecked(fn.ret_type, 0, 1)) { out = out.append(fn.name + "|$arg" + util.i32_to_string(sgpi)); sgpi = fn.params.len(); }
                else { sgpi = sgpi + 1; }
            }
        }
        // A lifted `__lam_` whose branch is a string-array literal carries a
        // default i32 ret_type; register it so `(if (c) { ["a"] } else { … })[i]`
        // reads its elements as strings (8-byte) instead of i32 (#3224).
        else if (fn.name.len() >= 6 && slice_unchecked(fn.name, 0, 6) == "__lam_" && lam_leaf_array_elem(fn, funcs, 0) == "string") { out = out.append(fn.name); }
    }
    return out;
}

// arr_method_fns_of collects the names of std/array's auto-discovered helper
// functions `__method_Array_<m>` (free functions, no receiver — possibly
// `<mod>__`-mangled). lower_expr resolves an array-receiver method call
// `arr.<m>(args)` to the matching helper (find_arr_method below), the IR
// sibling of the AST backend's find_array_method_func dispatch, so e.g.
// distinct / index_of / mode lower instead of bailing.
pub function arr_method_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() == 0 && util.contains(fn.name, "__method_Array_")) {
            out = out.append(fn.name);
        }
    }
    return out;
}

// find_arr_method resolves an array-method field to the in-scope helper name
// (`__method_Array_<field>` or its `<mod>__`-mangled form, matched by suffix),
// or "" if absent. Mirrors asmcore.find_array_method_func.
pub function (s: LowerState) find_arr_method(field: string): string {
    var target: string = "__method_Array_" + field;
    var tn: i32 = target.len();
    var i: i32 = 0;
    while (i < s.sigs.arr_method_fns.len()) {
        var nm: string = s.sigs.arr_method_fns[i];
        if (nm == target) { return nm; }
        if (nm.len() > tn && slice_unchecked(nm, nm.len() - tn, nm.len()) == target) { return nm; }
        i = i + 1;
    }
    return "";
}

// opt_ret_fns_of collects "name|rettype" for a module's Option/Result-returning
// functions, so a match on `f()` can recover the bound payload type.
// lam_leaf_opt_type returns the Option[..]/Result[..] type a lifted `__lam_`
// returns, inferred from its leaf return — a call to an Option/Result-returning
// function (or a nested `__lam_`) — or "". An if-/match-expression whose branch
// CALLS an opt-returning fn and whose other branch is `None` (a keyword) /
// another gfn call is lambda-LIFTED (no captures), so its `__lam` carries a
// default i32 ret_type and `var o = __lam(); match (o)` lost the payload type.
// A direct `Some(..)` branch keeps the expression INLINE (a captured-looking
// constructor), recovered via the StmtVar inline-IIFE path instead — so this
// only needs the call-leaf case. #3236 sibling for the lifted shape.
pub function lam_leaf_opt_type(fn: parser.FuncDecl, funcs: parser.FuncDecl[], depth: i32): string {
    if (depth > 8) { return ""; }
    if (fn.body.len() == 0) { return ""; }
    var re: ast.Expr = iife_first_return_expr(fn.body[fn.body.len() - 1]);
    match (re) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    for each_fn in funcs {
                        if (each_fn.name == cid.name && each_fn.receiver_type.len() == 0) {
                            var crt: string = each_fn.ret_type;
                            if (crt.len() >= 8 && (slice_unchecked(crt, 0, 7) == "Option[" || slice_unchecked(crt, 0, 7) == "Result[")) { return crt; }
                            if (cid.name.len() >= 6 && slice_unchecked(cid.name, 0, 6) == "__lam_") { return lam_leaf_opt_type(each_fn, funcs, depth + 1); }
                            return "";
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "";
}

pub function opt_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rt: string = fn.ret_type;
        if (rt.len() >= 8 && (slice_unchecked(rt, 0, 7) == "Option[" || slice_unchecked(rt, 0, 7) == "Result[")) {
            // Methods are keyed by the qualified "<BaseType>.<method>" (see
            // i64arr_ret_fns_of) so a `match (x.get())` on a struct-method's
            // Option/Result result recovers its payload type; free functions
            // stay keyed by bare name.
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            // An ERASED-generic free fn's Option/Result return whose payload
            // mentions a bare type-var bound to a param: rewrite every such var
            // to a positional "$arg<i>" reference (resolved at the call site by
            // resolve_argref_opt_type). Handles the bare payload (`Option[T]`),
            // a TUPLE payload (`Option[(T, i32)]`), and the Result Ok arm
            // (`Result[T, i32]`) uniformly — without it the raw type-var tag
            // left the Some/Ok binder untyped and a string payload's `.len()`
            // silently read 0. Methods can't be erased generics here (only free
            // fns lose their type params), so gate on a free function.
            if (fn.receiver_type.len() == 0) { rt = rewrite_typevars_to_argrefs(rt, fn.params); }
            out = out.append(key + "|" + rt);
        }
        // A lifted if-/match-expression `__lam_` whose leaf branch calls an
        // opt-returning fn (`var o = if (c) { mkO(7) } else { None }`): infer its
        // Option/Result type from the body so a later `match (o)` recovers the
        // payload (#3236 sibling for the lambda-lifted shape).
        else if (fn.name.len() >= 6 && slice_unchecked(fn.name, 0, 6) == "__lam_") {
            var inf: string = lam_leaf_opt_type(fn, funcs, 0);
            if (inf.len() > 0) { out = out.append(fn.name + "|" + inf); }
        }
    }
    return out;
}

// --- `?`-consumed fresh source-box reclaim (#4355) -----------------------------
//
// `mk(pre)?` evaluates the callee's Option/Result box into a $try temp, reads
// the success payload, and the box is dead — but it was never dec'd, so a
// per-iteration `?` leaked one box per success (and, for Option, one None box
// per failure). Mirrors native's reclaimableTryScrutinee/emitTryBoxFree.
// The self-host IR path has NO return-transfer inc (a callee returning its
// param hands back an rc==1 alias a runtime rc gate cannot distinguish from a
// fresh box), so freshness is proven STATICALLY: every return in the callee
// must be a DIRECT Ok/Err/Some constructor or None — each allocates a fresh
// rc-headered box (op_opt_make / op_opt_none), so the caller's `?` is the sole
// owner and a shallow __fern_rc_dec at the consume edge frees exactly once.

// opt_return_is_direct_ctor: `e` is a direct Ok(..)/Err(..)/Some(..) call or a
// bare None — the fresh-box return shapes (anything else may alias: a bare
// ident/param/field forwards a live box; a call result's ownership is unknown).
function opt_return_is_direct_ctor(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Ok" || cid.name == "Err" || cid.name == "Some") { return true; }
                },
                _ => {}
            }
        },
        ast.ExprIdent(id) => { if (id.name == "None") { return true; } },
        _ => {}
    }
    return false;
}

// body_has_nonctor_opt_return: any return whose value is NOT a direct
// Ok/Err/Some/None construction (the shape gate for opt_fresh_ret_fns_of).
function body_has_nonctor_opt_return(stmts: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!opt_return_is_direct_ctor(r.value)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonctor_opt_return(f.then_body) || body_has_nonctor_opt_return(f.else_body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonctor_opt_return(w.body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonctor_opt_return(fo.body)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonctor_opt_return(m.arms[a].body)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// body_has_nonfresh_opt_success_payload: any Ok(..)/Some(..) return whose
// payload is NOT a static literal or a syntactically-fresh string producer
// (str_local_binding_is_fresh — concat / .to_upper family / named producer).
// The self-host op_opt_make stores its payload UNCOUNTED (no construction-side
// alias-inc on this path yet — the #4355 remaining item), so a bare-ident
// payload (`Ok(pre)`) aliases a live local: the `?` binding must NOT take
// string ownership of it. A literal payload is admitted — __fern_str_free's
// heap-base guard no-ops on .rodata data, so crediting the binding is safe.
function body_has_nonfresh_opt_success_payload(stmts: ast.Stmt[]): boolean {
    return body_has_nonfresh_opt_payload(stmts, false);
}

// body_has_nonfresh_opt_err_payload: the Err-arm verdict (#6360). Needed because
// the "f" flag above describes the SUCCESS payload only, so it cannot vouch for an
// Err string — and a drop that releases one has to know.
function body_has_nonfresh_opt_err_payload(stmts: ast.Stmt[]): boolean {
    return body_has_nonfresh_opt_payload(stmts, true);
}

// body_has_nonfresh_opt_payload: does any `Ok(..)`/`Some(..)` return (or, with
// `err`, any `Err(..)` return) carry a payload that is NOT a static literal or a
// syntactically-fresh string producer? One walk, selected by which constructor it
// inspects — the two verdicts differ only in that name.
function body_has_nonfresh_opt_payload(stmts: ast.Stmt[], err: boolean): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprCall(c) => {
                        match (c.callee) {
                            ast.ExprIdent(cid) => {
                                var hit: boolean = cid.name == "Ok" || cid.name == "Some";
                                if (err) { hit = cid.name == "Err"; }
                                if (hit && c.args.len() == 1) {
                                    var pfresh: boolean = str_local_binding_is_fresh(c.args[0]);
                                    match (c.args[0]) { ast.ExprString(_) => { pfresh = true; }, _ => {} }
                                    if (!pfresh) { return true; }
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { if (body_has_nonfresh_opt_payload(f.then_body, err) || body_has_nonfresh_opt_payload(f.else_body, err)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_opt_payload(w.body, err)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_opt_payload(fo.body, err)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_opt_payload(m.arms[a].body, err)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// opt_fresh_ret_fns_of collects "name|ptype|flag" for FREE functions whose
// Option/Result box return is ALWAYS a direct constructor (fresh rc=1 box —
// see the section comment above): `ptype` is the SUCCESS payload spelling
// (opt_payload_type, Ok/Some), `flag` is "f" when every success payload is a
// static literal or a fresh string producer (so a string `?` binding may take
// ownership — see collect_try_str_binding_names), else "a" (box-free only;
// the aliased payload keeps its sound leak). lower_func seeds each name as
// the opt-fresh registry, which lower_try's consume-edge box
// free can check eligibility from LowerState (rides the existing opt-fresh
// registry rather than a new field; the old 33-field pin is dead).
pub function opt_fresh_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rt: string = fn.ret_type;
        if (rt.len() >= 8 && (slice_unchecked(rt, 0, 7) == "Option[" || slice_unchecked(rt, 0, 7) == "Result[")
                && fn.receiver_type.len() == 0
                && body_has_return(fn.body) && !body_has_nonctor_opt_return(fn.body)) {
            var flag: string = "a";
            if (!body_has_nonfresh_opt_success_payload(fn.body)) { flag = "f"; }
            out = out.append(fn.name + "|" + opt_payload_type(rt, "Ok") + "|" + flag);
            // #6360: a separate tagged row when every Err payload is a fresh string
            // too. The flag above is the SUCCESS verdict and cannot speak for Err,
            // so a drop that releases the Err payload needs its own proof.
            if (opt_payload_type(rt, "Err") == "string"
                    && !body_has_nonfresh_opt_err_payload(fn.body)) {
                out = out.append("ERRFRESH:" + fn.name);
            }
        }
        // #4355 slice 5: fresh rc-ENUM ctor fns, tagged "RCE:<name>|<Enum>" in the
        // SAME list (the tag keeps the "name|ptype|flag" lookups above from ever
        // matching) so the verdict reaches reclaimable_names_of through the
        // existing lower_func opt_fresh_ret param — no new threading. A qualifying
        // fn's every return is a direct fresh variant construction of its declared
        // enum (the OPTFRESH freshness rule applied to user enums: the self-host
        // IR path has no return-transfer inc, so soleness is proven statically),
        // with the extra string-field gate of rcenum_ctor_payload_strings_fresh.
        // collect_fresh_rcenum_names then admits `var e: E = mk(i)` call inits
        // exactly like direct-ctor inits, so the RCENUM loop-rebind/exit reclaim
        // fires for factored constructors.
        else if (fn.receiver_type.len() == 0 && rc_enum_has_variants(structs, rt)
                && enum_all_variants_rc_droppable(structs, rt)
                && body_has_return(fn.body)
                && !body_has_nonqualifying_rcenum_return(fn.body, structs, rt)) {
            out = out.append("RCE:" + fn.name + "|" + rt);
        }
        // #4355 slice 10: fresh arr-of-arr RETURN fns, tagged "AAC:<name>|<flag>"
        // in the SAME list (the no-new-threading trick RCE: uses above). A
        // qualifying FREE function's every return is a fresh arr-of-arr LITERAL
        // (arrarr_lit_is_fresh — non-empty, rows are array literals), so the
        // returned structure is rc=1 and solely owned by the caller (the
        // self-host IR path has no return-transfer inc). `flag` is "s" when
        // every return also passes arrarr_lit_strings_fresh (string inners are
        // literals / fresh producers — a param-embedding row like `[[s]]`
        // disqualifies, exactly the dangling-pointer hazard the strict credit
        // exists for), else "p" (rows-are-literals only: enough for scalar-kind
        // slots, whose inner elements value-copy; a string-kind slot gets no
        // strict credit and stays on its sound leak).
        // collect_fresh_arrarr_names admits `var g: T[][] = mk(..)` call inits
        // exactly like literal inits off these entries. Deeper nesting
        // (`string[][][]`) may register — its rows are array literals too — but
        // the consuming slot's arrarr_elem is "" for those, so only the lax
        // shallow-row free applies (sound), mirroring the literal-init path.
        else if (fn.receiver_type.len() == 0
                && rt.len() >= 4 && slice_unchecked(rt, rt.len() - 4, rt.len()) == "[][]"
                && body_has_return(fn.body)
                && !body_has_nonfresh_arrarr_return(fn.body)) {
            var aflag: string = "p";
            if (!body_has_nonstrfresh_arrarr_return(fn.body)) { aflag = "s"; }
            out = out.append("AAC:" + fn.name + "|" + aflag);
        }
        // #6102: fresh ROW producers, "ARC:<name>|<flag>" — the single-level
        // sibling of AAC above, consumed by arrarr_self_append_row so an
        // append-built arr-of-arr can take `g = g.append(make_row())`. Return
        // type is one level of `[]` and NOT `[][]` (the AAC arm owns that
        // shape, and this branch is an `else if` behind it anyway).
        else if (fn.receiver_type.len() == 0
                && rt.len() >= 2 && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]"
                && row_producer_kind(fn.body) >= 0) {
            var rflag: string = "p";
            if (row_producer_kind(fn.body) == 1) { rflag = "s"; }
            out = out.append("ARC:" + fn.name + "|" + rflag);
        }
    }
    return out;
}

// arrenum_producer_enum: the element enum of an array-of-enums producer, or "".
// The return type is `E[]` for an enum the element walk admits
// (enum_arr_elems_walk_ok — every payload a scalar or a leak-safe array, the one
// kind whose construction counting is guaranteed), and EVERY return is a fresh
// `[E.A(..), …]` literal of that same enum.
//
// Literal-only, like ARRSTRUCTF: was before the append-built arm: a returned
// container's co-owner would be a local of the frame being left, so soleness needs
// the fresh-literal evidence rather than a count. The append-built shape is the
// next slice and needs the ARRENUMA: local credit first — a self-append is a
// reassignment, which collect_fresh_arrenum_names excludes outright today.
function arrenum_producer_enum(fn: parser.FuncDecl, structs: parser.StructDecl[]): string {
    if (fn.receiver_type.len() > 0) { return ""; }
    var rt: string = fn.ret_type;
    if (rt.len() < 3) { return ""; }
    if (slice_unchecked(rt, rt.len() - 2, rt.len()) != "[]") { return ""; }
    var ename: string = slice_unchecked(rt, 0, rt.len() - 2) + "";
    if (!enum_arr_release_walk_ok(structs, ename)) { return ""; }
    if (!body_has_return(fn.body)) { return ""; }
    if (body_has_nonfresh_arrenum_return(fn.body, fn.body, structs, ename, [])) { return ""; }
    return ename;
}

// arrenum_producer_ret_local: `name` is a local this body builds by self-append
// and hands back. The strictness the producer registry needs is already in
// arrenum_self_append_elem, which admits only a fresh ctor element — there is no
// bare-ident laxity here for a returned container's co-owner to exploit, so the
// same predicate serves both questions.
function arrenum_producer_ret_local(fnbody: ast.Stmt[], name: string, structs: parser.StructDecl[], ename: string): boolean {
    if (!arrenum_local_empty_init(fnbody, name)) { return false; }
    if (!arrenum_name_is_appended(fnbody, name, structs, ename, [])) { return false; }
    return !arrenum_append_escapes(fnbody, name, structs, ename, [], true, []);
}

// arrenum_local_empty_init: `name` is declared IN this body from `[]`. Requiring
// the declaration to be here is what keeps the soleness proof local — a param, or
// a name from an enclosing scope, is already owned by someone else.
function arrenum_local_empty_init(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return arrenum_lit_is_empty(v.init); } },
            ast.StmtIf(f) => {
                if (arrenum_local_empty_init(f.then_body, name)) { return true; }
                if (arrenum_local_empty_init(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (arrenum_local_empty_init(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (arrenum_local_empty_init(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => { for arm in m.arms { if (arrenum_local_empty_init(arm.body, name)) { return true; } } },
            _ => {}
        }
    }
    return false;
}

// body_has_nonfresh_arrenum_return: any return whose value is NOT an
// array-of-enums the callee owns outright — a fresh literal of `ename`, or a
// local this body built by self-append. `fnbody` stays the whole function body so
// a return nested in a block can still find that local's declaration.
function body_has_nonfresh_arrenum_return(stmts: ast.Stmt[], fnbody: ast.Stmt[], structs: parser.StructDecl[], ename: string, borrowable: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (arrenum_lit_enum(r.value, structs) != ename) {
                    match (r.value) {
                        ast.ExprIdent(rid) => { if (!arrenum_producer_ret_local(fnbody, rid.name, structs, ename)) { return true; } },
                        _ => { return true; }
                    }
                }
            },
            ast.StmtIf(f) => { if (body_has_nonfresh_arrenum_return(f.then_body, fnbody, structs, ename, borrowable) || body_has_nonfresh_arrenum_return(f.else_body, fnbody, structs, ename, borrowable)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_arrenum_return(w.body, fnbody, structs, ename, borrowable)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_arrenum_return(fo.body, fnbody, structs, ename, borrowable)) { return true; } },
            ast.StmtMatch(m) => { for arm in m.arms { if (body_has_nonfresh_arrenum_return(arm.body, fnbody, structs, ename, borrowable)) { return true; } } },
            _ => {}
        }
    }
    return false;
}

// --- fresh ROW producers, "ARC:" (#6102) -------------------------------------
//
// The AAC registry above proves a callee returns a whole fresh arr-of-arr. This
// one is its single-level sibling: a free function whose every return hands the
// caller a freshly-allocated, solely-owned ROW. It exists so the append-built
// arr-of-arr credit (#6092) can accept `g = g.append(make_row())` and not just
// `g = g.append([..])` — without it, a row that came from a call stayed
// uncredited and leaked one buffer per append.
//
// Two tiers, the same split AAC uses. "p" (lax): the returned BUFFER is fresh,
// which is all a scalar-kind consumer needs — it frees each row with one
// arr_dec and the row's own elements were value-copied. "s" (strict): every
// element ever placed in the row is a fresh string too, which a string-kind
// consumer needs because it frees element POINTERS.
//
// A qualifying return is either a direct array LITERAL, or an ident naming a
// local built the append way (`var xs: T[] = []` / a literal, every rebind a
// self-append) that does not escape by any route other than the return itself.
// That last proof is body_unsafe_for_allow_ret, which exists for precisely this
// shape: a bare `return name` MOVES the value out rather than retaining it.
// borrowable is empty here — at module-registry time there is no call context,
// so any call-argument use of the local disqualifies it, which is the
// conservative direction.
function row_producer_kind(body: ast.Stmt[]): i32 {
    if (!body_has_return(body)) { return -1; }
    return body_row_return_kind(body, body);
}

// body_row_return_kind: the WEAKEST kind over every return in the body — -1 if
// any return fails to be a fresh row, else 0 (lax) / 1 (strict). `fnbody` stays
// the whole function body so an ident return can find its local's declaration
// and rebinds no matter how deeply the return is nested.
function body_row_return_kind(stmts: ast.Stmt[], fnbody: ast.Stmt[]): i32 {
    var worst: i32 = 1;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var k: i32 = row_return_value_kind(r.value, fnbody);
                if (k < 0) { return -1; }
                if (k < worst) { worst = k; }
            },
            ast.StmtIf(f) => {
                var kt: i32 = body_row_return_kind(f.then_body, fnbody);
                if (kt < 0) { return -1; }
                if (kt < worst) { worst = kt; }
                var ke: i32 = body_row_return_kind(f.else_body, fnbody);
                if (ke < 0) { return -1; }
                if (ke < worst) { worst = ke; }
            },
            ast.StmtWhile(w) => {
                var kw: i32 = body_row_return_kind(w.body, fnbody);
                if (kw < 0) { return -1; }
                if (kw < worst) { worst = kw; }
            },
            ast.StmtFor(fo) => {
                var kf: i32 = body_row_return_kind(fo.body, fnbody);
                if (kf < 0) { return -1; }
                if (kf < worst) { worst = kf; }
            },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    var km: i32 = body_row_return_kind(arm.body, fnbody);
                    if (km < 0) { return -1; }
                    if (km < worst) { worst = km; }
                }
            },
            _ => {}
        }
    }
    return worst;
}

// row_return_value_kind classifies one returned expression: -1 not a fresh row,
// 0 fresh buffer only, 1 also every element a fresh string.
function row_return_value_kind(e: ast.Expr, fnbody: ast.Stmt[]): i32 {
    match (e) {
        ast.ExprArray(lit) => {
            var j: i32 = 0;
            while (j < lit.elements.len()) {
                if (!strarr_elem_store_ok(lit.elements[j])) { return 0; }
                j = j + 1;
            }
            return 1;
        },
        ast.ExprIdent(id) => { return append_built_row_local_kind(fnbody, id.name); },
        _ => { return -1; }
    }
    return -1;
}

// append_built_row_local_kind: `name` is a local of this function declared with
// an array-literal init (`[]` included — that is the shape an append-built row
// starts from) whose every reassignment is the self-append rebind, and which
// escapes by no route other than the return. Returns -1 / 0 / 1 as above.
//
// Requiring the declaration to be IN this body is what makes the soleness proof
// local: a param, or a name declared in an enclosing scope, would already be
// owned by someone else.
function append_built_row_local_kind(fnbody: ast.Stmt[], name: string): i32 {
    var init_kind: i32 = row_local_init_kind(fnbody, name);
    if (init_kind < 0) { return -1; }
    var rebind_kind: i32 = row_local_rebind_kind(fnbody, name);
    if (rebind_kind < 0) { return -1; }
    if (body_unsafe_for_allow_ret(fnbody, name, [], [])) { return -1; }
    if (rebind_kind < init_kind) { return rebind_kind; }
    return init_kind;
}

// row_local_init_kind: the declaration of `name` in this body inits it with an
// array literal. -1 = not declared here, or not an array-literal init.
function row_local_init_kind(stmts: ast.Stmt[], name: string): i32 {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprArray(lit) => {
                            var j: i32 = 0;
                            while (j < lit.elements.len()) {
                                if (!strarr_elem_store_ok(lit.elements[j])) { return 0; }
                                j = j + 1;
                            }
                            return 1;
                        },
                        _ => { return -1; }
                    }
                }
            },
            ast.StmtIf(f) => {
                var kt: i32 = row_local_init_kind(f.then_body, name);
                if (kt >= 0) { return kt; }
                var ke: i32 = row_local_init_kind(f.else_body, name);
                if (ke >= 0) { return ke; }
            },
            ast.StmtWhile(w) => { var kw: i32 = row_local_init_kind(w.body, name); if (kw >= 0) { return kw; } },
            ast.StmtFor(fo) => { var kf: i32 = row_local_init_kind(fo.body, name); if (kf >= 0) { return kf; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    var km: i32 = row_local_init_kind(arm.body, name);
                    if (km >= 0) { return km; }
                }
            },
            _ => {}
        }
    }
    return -1;
}

// row_local_rebind_kind: every reassignment of `name` is `name = name.append(v)`.
// -1 the moment one is not; otherwise the weakest element kind appended (1 when
// there are no rebinds at all — the init alone then governs).
function row_local_rebind_kind(stmts: ast.Stmt[], name: string): i32 {
    var worst: i32 = 1;
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name) {
                    var k: i32 = row_self_append_elem_kind(a.value, name);
                    if (k < 0) { return -1; }
                    if (k < worst) { worst = k; }
                }
            },
            ast.StmtIf(f) => {
                var kt: i32 = row_local_rebind_kind(f.then_body, name);
                if (kt < 0) { return -1; }
                if (kt < worst) { worst = kt; }
                var ke: i32 = row_local_rebind_kind(f.else_body, name);
                if (ke < 0) { return -1; }
                if (ke < worst) { worst = ke; }
            },
            ast.StmtWhile(w) => {
                var kw: i32 = row_local_rebind_kind(w.body, name);
                if (kw < 0) { return -1; }
                if (kw < worst) { worst = kw; }
            },
            ast.StmtFor(fo) => {
                var kf: i32 = row_local_rebind_kind(fo.body, name);
                if (kf < 0) { return -1; }
                if (kf < worst) { worst = kf; }
            },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    var km: i32 = row_local_rebind_kind(arm.body, name);
                    if (km < 0) { return -1; }
                    if (km < worst) { worst = km; }
                }
            },
            _ => {}
        }
    }
    return worst;
}

// row_self_append_elem_kind: `e` is `name.append(v)` — -1 if not, else 1 when
// `v` is a fresh string (or a scalar, which is value-copied and imposes no
// constraint) and 0 when it is a string-typed expression that could alias a
// live local.
function row_self_append_elem_kind(e: ast.Expr, name: string): i32 {
    match (e) {
        ast.ExprCall(c) => {
            var is_self_append: boolean = false;
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "append") {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => { is_self_append = rid.name == name; },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            if (!is_self_append) { return -1; }
            if (c.args.len() != 1) { return -1; }
            if (strarr_elem_store_ok(c.args[0])) { return 1; }
            return 0;
        },
        _ => { return -1; }
    }
    return -1;
}

// body_has_nonfresh_arrarr_return: any return whose value is NOT a fresh
// arr-of-arr literal (arrarr_lit_is_fresh) — disqualifies the function from
// the "AAC:" registry (#4355 slice 10). A param pass-through or a call chain
// disqualifies; `return t;` of a whole local does too. A literal whose ROWS are
// consumed locals still qualifies — the returned value solely owns them.
function body_has_nonfresh_arrarr_return(stmts: ast.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtReturn(r) => { if (!arrarr_lit_is_fresh(arrarr_row_effective(r.value, stmts, i), stmts, i)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonfresh_arrarr_return(f.then_body) || body_has_nonfresh_arrarr_return(f.else_body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_arrarr_return(w.body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_arrarr_return(fo.body)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_arrarr_return(m.arms[a].body)) { return true; } a = a + 1; } },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// body_has_nonstrfresh_arrarr_return: any return whose value fails the STRICT
// strings-fresh test (arrarr_lit_strings_fresh) — withholds the "s" flag from
// an "AAC:" entry, so string-kind consumer slots stay excluded.
function body_has_nonstrfresh_arrarr_return(stmts: ast.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtReturn(r) => { if (!arrarr_lit_strings_fresh(arrarr_row_effective(r.value, stmts, i), stmts, i)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonstrfresh_arrarr_return(f.then_body) || body_has_nonstrfresh_arrarr_return(f.else_body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonstrfresh_arrarr_return(w.body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonstrfresh_arrarr_return(fo.body)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonstrfresh_arrarr_return(m.arms[a].body)) { return true; } a = a + 1; } },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// rcenum_ctor_payload_strings_fresh: every StructLit payload arg of the variant
// construction `e` has FRESH string-typed fields — a string literal or a fresh
// producer (str_local_binding_is_fresh: concat / string-method copy / named
// producer). __struct_drop_<S>'s k_str arm frees the payload struct's string
// fields at the consuming reclaim, so a param-embedding field (`S { name: nm }`,
// nm a callee param) would hand the caller a chain whose deep-drop frees a
// string the CALLER still owns — such a ctor disqualifies its function from the
// RCE set (the exact rule native's exprNoParamEscape enforces per-slot).
// Non-struct-lit args impose no constraint here: variant_struct_payloads_fresh
// (checked by fresh_rcpayload_enum_init) already requires deep-drop-ok struct
// payloads to BE fresh literals and string payloads to be fresh.
function rcenum_ctor_payload_strings_fresh(e: ast.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            for arg in c.args {
                match (arg) {
                    ast.ExprStructLit(sl) => {
                        if (sl.has_base) { return false; }
                        var si: i32 = rc_struct_decl_index(structs, sl.type_name);
                        if (si < 0) { return false; }
                        var fi: i32 = 0;
                        while (fi < sl.field_names.len()) {
                            var fdt: string = "";
                            var df: i32 = 0;
                            while (df < structs[si].fields.len()) {
                                if (structs[si].fields[df].name == sl.field_names[fi]) { fdt = structs[si].fields[df].type_name; }
                                df = df + 1;
                            }
                            if (fdt == "string") {
                                var sfresh: boolean = false;
                                match (sl.field_values[fi]) {
                                    ast.ExprString(_) => { sfresh = true; },
                                    _ => { sfresh = str_local_binding_is_fresh(sl.field_values[fi]); }
                                }
                                if (!sfresh) { return false; }
                            }
                            fi = fi + 1;
                        }
                    },
                    _ => {}
                }
            }
            return true;
        },
        _ => { return true; }
    }
}

// body_has_nonqualifying_rcenum_return: any return whose value is NOT a fresh
// direct construction of enum `owner` (fresh_rcpayload_enum_init) with fresh
// string fields in its StructLit payloads (rcenum_ctor_payload_strings_fresh).
// Statement coverage mirrors body_has_nonctor_opt_return — a return hiding in
// any covered nested block disqualifies; uncovered statement kinds cannot
// contain returns that reach this function's exit.
function body_has_nonqualifying_rcenum_return(stmts: ast.Stmt[], structs: parser.StructDecl[], owner: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                // Strict set only ([]): this proof registers "RCE:" rows while
                // str_fresh_ret_fns is built independently; keeping it syntactic
                // avoids ordering the two registries against each other.
                if (fresh_rcpayload_enum_init(r.value, structs, [], [], false) != owner) { return true; }
                if (!rcenum_ctor_payload_strings_fresh(r.value, structs)) { return true; }
            },
            ast.StmtIf(f) => { if (body_has_nonqualifying_rcenum_return(f.then_body, structs, owner) || body_has_nonqualifying_rcenum_return(f.else_body, structs, owner)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonqualifying_rcenum_return(w.body, structs, owner)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonqualifying_rcenum_return(fo.body, structs, owner)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonqualifying_rcenum_return(m.arms[a].body, structs, owner)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// collect_try_str_binding_names: string LOCALS bound from a `?` over an
// opt-fresh callee with a FRESH string success payload (`var s: string =
// mk(pre)?`, mk in opt_fresh_ret with flag "f") that are NOT reassigned. The
// box free at the `?` edge (lower_try) MOVES the payload's sole reference to
// the binding, so — after reclaimable_names_of's body_unsafe_for escape gate —
// the binding is credited "STR:" and the exit sweep frees it exactly once.
// The `: string` annotation is required (it is what types the slot is_str at
// the StmtVar lowering, and slot_is_reclaimable_str's type gate keys on it).
function collect_try_str_binding_names(stmts: ast.Stmt[], opt_fresh_ret: SigReg, reassigned: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.type_name == "string" && util.index_of_str(reassigned, v.name) < 0) {
                    match (v.init) {
                        ast.ExprUnary(u) => {
                            if (u.op == "try_") {
                                match (u.operand) {
                                    ast.ExprCall(c) => {
                                        match (c.callee) {
                                            ast.ExprIdent(cid) => {
                                                if (sig_reg_has_exact(opt_fresh_ret, cid.name + "|string|f")) {
                                                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                                                }
                                            },
                                            _ => {}
                                        }
                                    },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_try_str_binding_names(f.then_body, opt_fresh_ret, reassigned, a); a = collect_try_str_binding_names(f.else_body, opt_fresh_ret, reassigned, a); },
            ast.StmtWhile(w) => { a = collect_try_str_binding_names(w.body, opt_fresh_ret, reassigned, a); },
            ast.StmtFor(fo) => { a = collect_try_str_binding_names(fo.body, opt_fresh_ret, reassigned, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_try_str_binding_names(m.arms[ai].body, opt_fresh_ret, reassigned, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// --- replaced-string-field reclaim admission (#4355) ---------------------------
//
// The __field_reclaim_<T> string arm frees a REPLACED string field at rc==1.
// That is sound only if no read of the field can outlive the box chain: the
// self-host has no read-side alias-inc discipline for strings, so a field
// read that ESCAPES (a retaining call arg, a return, a container/struct store,
// a slice/trim view) is an UNCOUNTED alias the free would dangle — the
// per-module compiler self-run segfaulted on exactly this (its own
// LowerState/EmitState string fields are passed to helpers everywhere).
// strfld_reclaim_ok_types_of therefore admits a type's string arm only when
// EVERY read of its string-field NAMES, across the WHOLE program, is a
// provable transient borrow: a binary operand (concat/compare), a byte-index
// base, the receiver of a read-only / fresh-copy string method, a BORROWABLE
// call-argument position (#6703), or a direct `var t = x.f` init (retained by
// the #4768 read-side alias-inc). The walk is field-NAME-keyed and
// obj-type-blind — a same-named field on another type over-excludes (sound).
// Callers must pass the WHOLE-PROGRAM func list (all_funcs on the per-module
// paths); a partial list would under-count the reads and re-open the UAF.

// strfld_mark: record e's field name as unsafely read (dedup'd), then keep
// walking its receiver chain.
function strfld_mark(e: ast.Expr, acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(fa) => {
            a = push_str_unique(a, fa.field);
            a = strfld_collect_unsafe(fa.obj, a);
        },
        _ => {}
    }
    return a;
}

// strfld_safe_operand: the DIRECT read in this position is a transient
// borrow — skip marking it, but keep walking beneath it (its obj chain and
// any nested expressions).
function strfld_safe_operand(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprFieldAccess(fa) => { return strfld_collect_unsafe(fa.obj, acc); },
        _ => {}
    }
    return strfld_collect_unsafe(e, acc);
}

// strfld_defer_arg parks the verdict on `callee(… <field> …)` at position
// `idx` — a borrowable position is a transient borrow, any other retains — as
// a "?<callee>#<idx>:<field>" record in the same accumulator. The record is
// inert for every exact field-name lookup, so it does not admit anything on
// its own; strfld_resolve_deferred turns the non-borrowable ones into marks.
// A field already marked cannot be un-marked by any verdict, so it parks
// nothing — which is what keeps the record count (and the resolve's registry
// walks) proportional to the fields that can still change the answer.
function strfld_defer_arg(acc: string[], callee: string, idx: i32, field: string): string[] {
    if (util.index_of_str(acc, field) >= 0) { return acc; }
    return push_str_unique(acc, "?" + callee + "#" + util.i32_to_string(idx) + ":" + field);
}

// strfld_resolve_deferred settles every parked call-argument record against
// the borrowability registry: a field handed to a position the callee only
// reads stays admissible, every other one marks. `borrowable_params_of` admits
// a param only when the callee provably never returns, stores, SLICES or
// captures it — the slice exclusion is what makes this sound for strings
// specifically, a view into the buffer being the one alias a later
// `__fern_str_free` would dangle.
function strfld_resolve_deferred(names: string[], borrowable: string[]): string[] {
    var a: string[] = names;
    var n: i32 = names.len();
    var i: i32 = 0;
    while (i < n) {
        var e: string = names[i];
        if (e.len() > 0 && e[0] == b'?') {
            var h: i32 = 1;
            while (h < e.len() && e[h] != b'#') { h = h + 1; }
            var c: i32 = h + 1;
            var idx: i32 = 0;
            while (c < e.len() && e[c] != b':') { idx = idx * 10 + ((e[c] as i32) - 48); c = c + 1; }   // 48 = '0'
            if (c < e.len() && h < e.len()) {
                if (!param_is_borrowable(borrowable, slice_unchecked(e, 1, h), idx)) {
                    a = push_str_unique(a, slice_unchecked(e, c + 1, e.len()));
                }
            }
        }
        i = i + 1;
    }
    return a;
}

// strfld_collect_unsafe walks one expression and accumulates every field
// NAME read in a position that could outlive its box (see the section
// comment). A bare ExprFieldAccess reached here — i.e. not consumed by one
// of the safe parents (binary operand, byte-index base, read-only /
// fresh-copy method receiver, direct var-init) — is unsafe by default.
function strfld_collect_unsafe(e: ast.Expr, acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(_) => { return strfld_mark(e, a); },
        ast.ExprBinary(b) => {
            // direct operands borrow (concat copies bytes, compares read).
            a = strfld_safe_operand(b.left, a);
            return strfld_safe_operand(b.right, a);
        },
        ast.ExprUnary(u) => { return strfld_collect_unsafe(u.operand, a); },
        ast.ExprIndex(ix) => {
            // x.f[i] byte read borrows the base.
            a = strfld_safe_operand(ix.array, a);
            return strfld_collect_unsafe(ix.index, a);
        },
        ast.ExprSlice(sl) => {
            // a slice/trim of a field is a VIEW aliasing the buffer — unsafe.
            a = strfld_collect_unsafe(sl.array, a);
            match (sl.array) { ast.ExprFieldAccess(_) => { a = strfld_mark(sl.array, a); }, _ => {} }
            a = strfld_collect_unsafe(sl.start, a);
            return strfld_collect_unsafe(sl.end, a);
        },
        ast.ExprCall(c) => {
            // Free calls only: the borrowability registry is keyed by function
            // name, and a method's params are not in it.
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (str_borrowing_method(cfa.field)) {
                        a = strfld_safe_operand(cfa.obj, a);
                    } else {
                        a = strfld_collect_unsafe(cfa.obj, a);
                        match (cfa.obj) { ast.ExprFieldAccess(_) => { a = strfld_mark(cfa.obj, a); }, _ => {} }
                    }
                },
                ast.ExprIdent(cid) => { callee_name = cid.name; },
                _ => { a = strfld_collect_unsafe(c.callee, a); }
            }
            // An argument may retain the value (helpers, appends, map sets are
            // all calls), so a direct read there is unsafe by default — unless
            // the position is BORROWABLE, which is the same warrant the method
            // receiver above gets. The verdict lives in a registry this walk
            // does not carry: threading it through cost the per-module emit-all
            // ~170 s of walk time on its own (#6703), so the site is PARKED as
            // a "?callee#idx:field" record and strfld_resolve_deferred settles
            // every one of them, once, after the walk.
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                var deferred: boolean = false;
                if (callee_name.len() > 0) {
                    match (c.args[ai]) {
                        ast.ExprFieldAccess(fa2) => {
                            a = strfld_defer_arg(a, callee_name, ai, fa2.field);
                            a = strfld_collect_unsafe(fa2.obj, a);
                            deferred = true;
                        },
                        _ => {}
                    }
                }
                if (!deferred) { a = strfld_collect_unsafe(c.args[ai], a); }
                ai = ai + 1;
            }
            return a;
        },
        _ => {}
    }
    return a;
}

// strfld_collect_unsafe_stmts: single-pass statement walk. A direct
// `var t = x.f` init is SAFE (the #4768 read-side retain incs it); a
// REASSIGN `t = x.f` is not retained and stays unsafe.
function strfld_collect_unsafe_stmts(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { a = strfld_safe_operand(v.init, a); },
            ast.StmtReturn(r) => { a = strfld_collect_unsafe(r.value, a); },
            ast.StmtAssign(as2) => { a = strfld_collect_unsafe(as2.value, a); },
            ast.StmtExpr(ex) => { a = strfld_collect_unsafe(ex.value, a); },
            ast.StmtIf(iff) => {
                a = strfld_collect_unsafe(iff.cond, a);
                a = strfld_collect_unsafe_stmts(iff.then_body, a);
                a = strfld_collect_unsafe_stmts(iff.else_body, a);
            },
            ast.StmtWhile(w) => {
                a = strfld_collect_unsafe(w.cond, a);
                a = strfld_collect_unsafe_stmts(w.body, a);
            },
            ast.StmtFor(fo) => {
                a = strfld_collect_unsafe(fo.iter, a);
                a = strfld_collect_unsafe_stmts(fo.body, a);
            },
            ast.StmtMatch(m) => {
                a = strfld_collect_unsafe(m.scrutinee, a);
                for arm in m.arms {
                    if (arm.has_guard) { a = strfld_collect_unsafe(arm.guard, a); }
                    a = strfld_collect_unsafe_stmts(arm.body, a);
                }
            },
            _ => {}
        }
    }
    return a;
}

// struct_routes_field_reclaim: slot type `sty` takes the __field_reclaim_<T>
// consume-rebind path — either it carries an rc-array / nested-struct / enum
// field (the original routing), or it is a STRING-fielded type admitted by
// the whole-program read scan (FnSigs.strfld_ok_types — #4355 slice 3, the
// string-ONLY struct widening). The
// construction-side retain (slit_reclaim in the ExprStructLit lowering) uses
// the same disjunction so the field frees stay balanced.
pub function (s: LowerState) struct_routes_field_reclaim(sty: string): boolean {
    return struct_routes_field_reclaim_at(s.structs, s.sigs.strfld_ok_types, sty);
}

// struct_routes_field_reclaim_at is the same question without a LowerState, so
// the whole-program registry passes can ask it. The construction-side string
// retain is gated on this verdict (slit_reclaim), so any analysis that decides a
// string field store COUNTS has to consult the same one — a credit the retain
// does not honour is an over-release, not a missed optimisation.
pub function struct_routes_field_reclaim_at(structs: parser.StructDecl[], sfok: string[], sty: string): boolean {
    if (struct_has_reclaim_array_field(structs, sty)) { return true; }
    // A direct TUPLE field whose shape is deep-droppable: routes so the
    // IR-level emit_struct_tuple_field_drops reaches it. The construction
    // retain reads this very predicate (slit_reclaim). The asm __struct_drop
    // ladder has no tuple arm — every k_* test is false for a "(…)" type — so
    // the IR side owns the child walk AND the box dec with no second releaser.
    //
    // Removing this clause looks free and is not. With it knocked out, BOTH
    // leak matrices, the tuple / rc-tuple / construction-retain /
    // container-sink / census suites and the stage-2 fixpoint all pass —
    // because no corpus here contains a struct whose tuple field carries a
    // STRUCT element, the shape only this clause admits (via
    // struct_has_reclaim_array_field on the element type). It costs 12800 bytes
    // per 100 rounds. TestSelfHostTupleStructElemFieldX86_64 is what moves.
    if (struct_has_deep_tuple_field(structs, sty)) { return true; }
    // string[]-fielded type admitted by the strarrfld scan (the "arr:"-tagged
    // half of strfld_reclaim_ok_types_of) — routes so the backend
    // __struct_drop k_str_arr arm reaches the field.
    if (struct_has_strarr_field(structs, sty)
        && reclaim_has(sfok, "arr:", sty)) { return true; }
    // fn-fielded (closure) type admitted by the clofld scan ("clo:"-tagged) —
    // routes so the backend k_clo arm shallow-frees the field's env box.
    if (struct_has_clo_field(structs, sty)
        && reclaim_has(sfok, "clo:", sty)) { return true; }
    return struct_has_string_field(structs, sty)
        && reclaim_has(sfok, "", sty);
}

// strfld_reclaim_ok_types_of: struct types whose __field_reclaim_<T> body may
// include the string arm — see the section comment for the contract. The
// backends seed each admitted type as a "strfldok:<T>" need at their
// whole-program emit orchestration, and the lowering-time routing +
// construction-retain decisions read this same list off FnSigs — the two must
// agree, so both come from this one scan; partial-funcs emit paths must pass
// [] funcs (admitting nothing) rather than a unit-local list.
//
// `borrowable` is the SAME registry the caller's FnSigs carries. The two must
// come from one verdict: the interprocedural fixpoint admits more borrows than
// the single pass, so a backend seeding "strfldok:" from the fixpoint while the
// lowering routed on the single pass would free fields nothing retained. Every
// emit path therefore overrides FnSigs.strfld_ok_types wherever it overrides
// FnSigs.borrowable_params.
pub function strfld_reclaim_ok_types_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[], borrowable: string[]): string[] {
    // Single pass: collect every unsafely-read field NAME across the whole
    // program, then admit each candidate type iff none of its string-field
    // names is in the set.
    var unsafe_names: string[] = [];
    for fn in funcs {
        unsafe_names = strfld_collect_unsafe_stmts(fn.body, unsafe_names);
    }
    unsafe_names = strfld_resolve_deferred(unsafe_names, borrowable);
    var out: string[] = [];
    for sd in structs {
        var t: string = sd.name;
        // Any string-fielded struct is a candidate — array-carrying types
        // gain the string arm in their existing __field_reclaim body, and
        // string-ONLY types (slice 3) gain the routing itself (their body is
        // the string arms + the snapshot_dec box free).
        if (struct_has_string_field(structs, t)) {
            var ok: boolean = true;
            var n: i32 = sd.fields.len();
            var fi: i32 = 0;
            while (fi < n) {
                if (sd.fields[fi].type_name == "string"
                    && util.index_of_str(unsafe_names, sd.fields[fi].name) >= 0) { ok = false; }
                fi = fi + 1;
            }
            if (ok) { out = out.append(t); }
        }
    }
    // string[]-FIELD admissions (the string[]-struct-field exit-drop slice),
    // returned as "arr:"-prefixed entries in the SAME list: the lowering asks
    // for them under that tag and the backend gates its k_str_arr arm on
    // "strfldok:arr:<T>", and the prefixed spellings are inert for every
    // untagged scalar lookup. A type T is admitted iff every one of its
    // string[] FIELDS is (a) never read outside a bare `.len()` borrow
    // (strarrfld_scan — any other read binds/escapes an ELEMENT alias the deep
    // free would dangle: element stores into a string[] are MOVES, so element
    // rc does not count the buffer's references) and (b) only ever constructed
    // from an element-fresh array literal (strarr_value_is_fresh elements /
    // `[]`) — the exact element-freshness contract the "SARR:" local credit
    // uses. Marks the scan could key to a type are matched as "<T>.<field>";
    // the bare-name lookup is the fallback for a read whose receiver type it
    // could not resolve, which still poisons the field in every type.
    // __fern_str_arr_free itself rc-guards the BUFFER (shared -> dec only),
    // so buffer aliasing degrades to the old leak instead of corrupting.
    var arr_unsafe: string[] = [];
    // The element-freshness proof consults the whole-program fresh-string
    // registry, so a field built from `[wide(n), …]` is admitted on the same
    // terms as one built from inline concats. Walked only when some type
    // actually has a string[] field — it is linear in every body.
    var arr_str_fresh: string[] = [];
    var wantsf: i32 = 0;
    while (wantsf < structs.len()) {
        if (struct_has_strarr_field(structs, structs[wantsf].name)) { arr_str_fresh = str_fresh_ret_fns_of(funcs); wantsf = structs.len(); }
        else { wantsf = wantsf + 1; }
    }
    // Whole-array PRODUCERS the field store gate may accept, on the same terms
    // the "STRARR:" registry admits them.
    var arr_producers: string[] = [];
    for fn in funcs {
        if (fn_returns_fresh_strarr(fn, arr_str_fresh)) { arr_producers = arr_producers.append(fn.name); }
    }
    // string[]-field FORWARDERS, whose reads move from the forwarding return to
    // the call sites (#7417). Whole-program, like every other row here: the
    // exemption is only sound while every call is visible, which is the same
    // condition the partial-funcs paths already satisfy by passing [] funcs.
    var arr_fwd: string[] = strarrfld_forwarders_of(funcs, structs);
    for fn in funcs {
        // Drop any producer name THIS frame shadows — a local or parameter of
        // that name holds an unknown body, not the registered declaration.
        // The frame's binders are collected once, not once per producer.
        var bound: string[] = astwalk.collect_bound_stmts(fn.body, []);
        var vis: string[] = [];
        var vk: i32 = 0;
        while (vk < arr_producers.len()) {
            if (util.index_of_str(bound, arr_producers[vk]) < 0 && !fn_has_param_named(fn, arr_producers[vk])) {
                vis = vis.append(arr_producers[vk]);
            }
            vk = vk + 1;
        }
        arr_unsafe = strarrfld_scan_stmts(fn.body, structs, strarrfld_fn_binds(fn, structs), arr_str_fresh, vis, arr_fwd, strarrfld_fwd_field_of(fn, structs), arr_unsafe);
    }
    for sd in structs {
        var at: string = sd.name;
        if (struct_has_strarr_field(structs, at)) {
            var aok: boolean = true;
            for fld in sd.fields {
                if (fld.type_name == "string[]"
                    && (util.index_of_str(arr_unsafe, at + "." + fld.name) >= 0
                        || util.index_of_str(arr_unsafe, fld.name) >= 0)) { aok = false; }
            }
            if (aok) { out = out.append("arr:" + at); }
            // The BUFFER-release admission ("arrbuf:"-prefixed), the store half
            // of the verdict above. The construction-side retain for a
            // bare-ident array field value is unconditional, so a type whose
            // string[] fields are only ever stored a retained or sole-owned
            // value has a buffer reference to give back at reclaim time even
            // when an element READ withholds the deep walk. A store the scan
            // refused is an uncounted alias, and dec'ing that frees a buffer
            // another owner still holds.
            var abufok: boolean = true;
            for fld in sd.fields {
                if (fld.type_name == "string[]"
                    && util.index_of_str(arr_unsafe, "store:" + at + "." + fld.name) >= 0) { abufok = false; }
            }
            if (abufok) { out = out.append("arrbuf:" + at); }
        }
        // struct-ARRAY / enum-ARRAY FIELD admissions ("sarr:"-prefixed), read
        // out of the SAME unsafe-mark set (#7067): the backends gate
        // __field_reclaim_<T>'s element walk on "strfldok:sarr:<T>". A type is
        // admitted iff every one of its struct/enum-array fields is (a) never
        // read outside a bare `.len()` borrow — any other read binds an element
        // alias the walk would dangle — and (b) only ever stored an array
        // literal of fresh elements, so no surviving buffer shares an element
        // with the one being released. Marks are matched type-keyed first and
        // by bare NAME as the fallback, exactly like the "arr:" half above.
        // __struct_drop_<T>'s walk needs neither: at scope exit the box and
        // every buffer that ever aliased its elements are dying together.
        var sa_has: boolean = false;
        for fld in sd.fields {
            if (is_struct_array_field_type(structs, fld.type_name)
                || is_enum_array_field_type(structs, fld.type_name)) { sa_has = true; }
        }
        if (sa_has) {
            var saok: boolean = true;
            for fld in sd.fields {
                var saft: string = fld.type_name;
                if ((is_struct_array_field_type(structs, saft) || is_enum_array_field_type(structs, saft))
                    && (util.index_of_str(arr_unsafe, at + "." + fld.name) >= 0
                        || util.index_of_str(arr_unsafe, fld.name) >= 0)) { saok = false; }
            }
            if (saok) { out = out.append("sarr:" + at); }
        }
    }
    // CLOSURE-field admissions ("clo:"-prefixed, threaded exactly like the
    // "arr:" half): a type is admitted iff every fn-typed field name passes
    // clofld_scan — fresh-lambda-only construction values (a lambda lifts to
    // a sole-owned rc=1 `__mkclo$` box), no base-including construction of
    // the type, and no read of the field outside a direct `b.f(x)` call.
    // The k_clo drop arm then shallow-frees the field's closure box
    // (captures leak — the k_struct one-level model).
    var clo_unsafe: string[] = [];
    for fn in funcs {
        clo_unsafe = clofld_scan_stmts(fn.body, structs, clo_unsafe);
    }
    for sd in structs {
        var ct: string = sd.name;
        if (struct_has_clo_field(structs, ct)) {
            var cok: boolean = true;
            for fld in sd.fields {
                if (fld.type_name == "fn"
                    && util.index_of_str(clo_unsafe, fld.name) >= 0) { cok = false; }
            }
            if (cok) { out = out.append("clo:" + ct); }
        }
    }
    return out;
}

// ── structfldok: admit the DIRECT nested-struct / nested-enum field arm ──────
//
// The struct/enum sibling of strfld_reclaim_ok_types_of, and the precondition
// #6148's revert established for #6127's nested_struct row. A rebound struct
// local whose field is itself a struct leaks that field's box on every rebind:
// __struct_drop_<T> HAS k_struct / k_enum arms, so a SINGLE bind reclaims
// cleanly at scope exit (measured 200/200/0), but __field_reclaim_<T>'s field
// loop has no such arm, so only the rebinds leak (900/600/12000 over 100 rounds
// against 0 on native).
//
// #6148 added the arms without an admission scan and it was a use-after-free:
// a struct-literal field value is sole-owned at rc=1, so `items.append(p.node)`
// takes an UNCOUNTED alias, and the next rebind's field release freed a box the
// container still pointed at. The self-host has no read-side alias-inc for these
// reads, so the scan IS the safety argument — hand-rolling a looser predicate to
// make a probe pass is exactly what had to be reverted.
//
// It cannot reuse strfld_collect_unsafe: that walker recurses into a marked
// access's RECEIVER as unsafe, so `o.f.v` would mark `f` and exclude every type
// whose nested field is merely read through. Here the receiver of a borrow chain
// is a borrow — the inner read is judged under its own field's name — which is
// the one structural difference between the two scans.
pub function structfld_reclaim_ok_types_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[], borrowable: string[]): string[] {
    var unsafe_names: string[] = [];
    for fn in funcs {
        unsafe_names = structfld_collect_unsafe_stmts(fn.body, unsafe_names, borrowable);
    }
    var out: string[] = [];
    for sd in structs {
        var has: boolean = false;
        var ok: boolean = true;
        for fld in sd.fields {
            var fdt: string = fld.type_name;
            if (decl_is_struct(structs, fdt) || decl_is_enum(structs, fdt)) {
                has = true;
                if (util.index_of_str(unsafe_names, fld.name) >= 0) { ok = false; }
            }
        }
        if (has && ok) { out = out.append(sd.name); }
    }
    return out;
}

// structfld_mark: record e's field name as unsafely read, then treat its
// RECEIVER as a borrow. This is the difference from strfld_mark, which recurses
// into the receiver as unsafe: reaching `g` through `o.f.g` retains only g's
// box, so `f` is borrowed and stays admissible.
function structfld_mark(e: ast.Expr, acc: string[], borrowable: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(fa) => {
            a = push_str_unique(a, fa.field);
            a = structfld_safe_operand(fa.obj, a, borrowable);
        },
        _ => {}
    }
    return a;
}

// structfld_safe_operand: the DIRECT read here is a transient borrow — do not
// mark it, but keep walking beneath.
function structfld_safe_operand(e: ast.Expr, acc: string[], borrowable: string[]): string[] {
    match (e) {
        ast.ExprFieldAccess(fa) => { return structfld_safe_operand(fa.obj, acc, borrowable); },
        _ => {}
    }
    return structfld_collect_unsafe(e, acc, borrowable);
}

// structfld_collect_unsafe: every field NAME read in a position that could
// outlive its box. A bare ExprFieldAccess reached here — not consumed by one of
// the borrow parents — is unsafe by default.
function structfld_collect_unsafe(e: ast.Expr, acc: string[], borrowable: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(_) => { return structfld_mark(e, a, borrowable); },
        ast.ExprBinary(b) => {
            a = structfld_safe_operand(b.left, a, borrowable);
            return structfld_safe_operand(b.right, a, borrowable);
        },
        ast.ExprUnary(u) => { return structfld_collect_unsafe(u.operand, a, borrowable); },
        ast.ExprIndex(ix) => {
            a = structfld_safe_operand(ix.array, a, borrowable);
            return structfld_collect_unsafe(ix.index, a, borrowable);
        },
        ast.ExprSlice(sl) => {
            a = structfld_collect_unsafe(sl.array, a, borrowable);
            match (sl.array) { ast.ExprFieldAccess(_) => { a = structfld_mark(sl.array, a, borrowable); }, _ => {} }
            a = structfld_collect_unsafe(sl.start, a, borrowable);
            return structfld_collect_unsafe(sl.end, a, borrowable);
        },
        // A struct-literal FIELD VALUE re-homes the box into the new literal
        // (`PS { node: other.node }`) — the new owner outlives this one, so the
        // read is unsafe. strfld's walker never visits ExprStructLit at all;
        // this scan must, because a nested-struct field is exactly the thing
        // that gets copied between literals.
        ast.ExprStructLit(sl2) => {
            var fi: i32 = 0;
            while (fi < sl2.field_values.len()) {
                a = structfld_collect_unsafe(sl2.field_values[fi], a, borrowable);
                fi = fi + 1;
            }
            // A functional-update BASE (`S { ..o, n: 1 }`) copies o's field
            // pointers into the new box, so every one of them gains an owner.
            if (sl2.has_base) { a = structfld_collect_unsafe(sl2.base, a, borrowable); }
            return a;
        },
        // A tuple element is a store into a box that outlives the read, the
        // same position as an array element.
        ast.ExprTuple(tl2) => {
            var ti2: i32 = 0;
            while (ti2 < tl2.elements.len()) {
                a = structfld_collect_unsafe(tl2.elements[ti2], a, borrowable);
                ti2 = ti2 + 1;
            }
            return a;
        },
        // An array literal ELEMENT is a store into a container that outlives
        // the read, the literal-built sibling of `xs.append(o.f)`.
        ast.ExprArray(arr) => {
            var ai2: i32 = 0;
            while (ai2 < arr.elements.len()) {
                a = structfld_collect_unsafe(arr.elements[ai2], a, borrowable);
                ai2 = ai2 + 1;
            }
            return a;
        },
        ast.ExprCall(c) => {
            // A BORROWABLE param position cannot retain what it is handed, so
            // `f(o.inner)` there is a transient borrow like the method receiver
            // below — judged by structfld_safe_operand, which keeps walking
            // beneath without marking the field. Same registry and same rule
            // expr_unsafe_for and the NODEEP field-move scan (#6691) already
            // apply; here it is what lets the type keep its nested-struct / enum
            // arms at all. Free calls only: method-param borrowability is not in
            // the free-function-keyed registry.
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => { callee_name = cid.name; },
                ast.ExprFieldAccess(cfa) => {
                    // A method CALL on a field borrows its receiver for the
                    // call — `o.f.len()` / `o.f.method()` read through it. The
                    // receiver chain is judged by structfld_safe_operand; the
                    // arguments below are what can retain.
                    a = structfld_safe_operand(cfa.obj, a, borrowable);
                },
                _ => { a = structfld_collect_unsafe(c.callee, a, borrowable); }
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                // Shape first, registry second. param_is_borrowable is a linear
                // walk of the registry with a char compare per entry, and this
                // scan visits every call argument in the whole program once per
                // emitted unit — asking it about every argument cost the
                // per-module emit-all ~50%. A bare field access is the only
                // argument shape this arm marks directly, so it is the only one
                // whose answer can change anything.
                var arg_is_field: boolean = false;
                match (c.args[ai]) {
                    ast.ExprFieldAccess(_) => { arg_is_field = true; },
                    _ => {}
                }
                if (arg_is_field && callee_name.len() > 0 && param_is_borrowable(borrowable, callee_name, ai)) {
                    a = structfld_safe_operand(c.args[ai], a, borrowable);
                } else {
                    a = structfld_collect_unsafe(c.args[ai], a, borrowable);
                }
                ai = ai + 1;
            }
            return a;
        },
        _ => {}
    }
    return a;
}

// structfld_collect_unsafe_assign: an assignment's RHS, with the SELF-REBIND
// field reads in `o = S { …, f: o.f, … }` left unmarked (#6653).
//
// The literal's successor box goes into the slot `o` names, so `o.f` gains no
// owner the old box did not already have: the override path retains it and the
// old box's __field_reclaim_ releases it in the same rebind. That is exactly the
// balance the `...o` spelling of the same update has always had — and it has it
// because it reads no field, which is the only reason its type stays admitted.
//
// Every other value in the literal still marks, and a fork to a DIFFERENT local
// (`p = S { f: o.f }`) is not this shape: there the read genuinely creates a
// second owner, and the read scan must keep refusing the type.
function structfld_collect_unsafe_assign(target: string, v: ast.Expr, acc: string[], borrowable: string[]): string[] {
    var a: string[] = acc;
    match (v) {
        ast.ExprStructLit(sl) => {
            for fv in sl.field_values {
                // Only a DIRECT `target.<f>`: a deeper chain reaches a box the
                // successor does not supersede (selfrebind_field_alias).
                if (!selfrebind_field_alias(fv, target)) {
                    a = structfld_collect_unsafe(fv, a, borrowable);
                }
            }
            if (sl.has_base) { a = structfld_collect_unsafe(sl.base, a, borrowable); }
            return a;
        },
        _ => {}
    }
    return structfld_collect_unsafe(v, a, borrowable);
}

// structfld_collect_unsafe_stmts: a direct `var t = x.f` init is SAFE — the
// binding is a borrow the exit sweep does not double-free — while a REASSIGN
// `t = x.f` is not, matching the string scan's split.
function structfld_collect_unsafe_stmts(stmts: ast.Stmt[], acc: string[], borrowable: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { a = structfld_safe_operand(v.init, a, borrowable); },
            ast.StmtReturn(r) => { a = structfld_collect_unsafe(r.value, a, borrowable); },
            ast.StmtAssign(as2) => { a = structfld_collect_unsafe_assign(as2.target, as2.value, a, borrowable); },
            ast.StmtExpr(ex) => { a = structfld_collect_unsafe(ex.value, a, borrowable); },
            ast.StmtIf(iff) => {
                a = structfld_collect_unsafe(iff.cond, a, borrowable);
                a = structfld_collect_unsafe_stmts(iff.then_body, a, borrowable);
                a = structfld_collect_unsafe_stmts(iff.else_body, a, borrowable);
            },
            ast.StmtWhile(w) => {
                a = structfld_collect_unsafe(w.cond, a, borrowable);
                a = structfld_collect_unsafe_stmts(w.body, a, borrowable);
            },
            ast.StmtFor(fo) => {
                a = structfld_collect_unsafe(fo.iter, a, borrowable);
                a = structfld_collect_unsafe_stmts(fo.body, a, borrowable);
            },
            ast.StmtMatch(m) => {
                // A match SCRUTINEE is a transient borrow, exactly as a `var`
                // initialiser is (StmtVar above): the box is read to test its
                // tag and outlives nothing the arms do not own in their own
                // right. Marking it unsafe disqualified the whole struct type
                // from __field_reclaim_<T>, so `match (h.e)` stranded the enum
                // field 100 times over where `var t = h.e; match (t)` did not.
                a = structfld_safe_operand(m.scrutinee, a, borrowable);
                for arm in m.arms {
                    if (arm.has_guard) { a = structfld_collect_unsafe(arm.guard, a, borrowable); }
                    a = structfld_collect_unsafe_stmts(arm.body, a, borrowable);
                }
            },
            ast.StmtDefer(d) => {
                var one: ast.Stmt[] = [d.action];
                a = structfld_collect_unsafe_stmts(one, a, borrowable);
            },
            _ => {}
        }
    }
    return a;
}

// struct_has_strarr_field: does `sty` declare at least one string[] field?
pub function struct_has_strarr_field(structs: parser.StructDecl[], sty: string): boolean {
    for sd in structs {
        if (sd.name == sty) {
            for fld in sd.fields {
                if (fld.type_name == "string[]") { return true; }
            }
            return false;
        }
    }
    return false;
}

// struct_has_clo_field: does `sty` declare at least one fn-typed field (the
// parser coarsens a `(T) => R` field spelling to "fn"; the struct-lit lift
// wraps its value into a `__mkclo$…` env box, so the slot holds an
// rc-headered closure box at runtime)?
pub function struct_has_clo_field(structs: parser.StructDecl[], sty: string): boolean {
    for sd in structs {
        if (sd.name == sty) {
            for fld in sd.fields {
                if (fld.type_name == "fn") { return true; }
            }
            return false;
        }
    }
    return false;
}

// clo_field_names_of: the fn-typed field NAMES of `sty` (empty when none) —
// the moves_fields exemption list for field-closure calls.
function clo_field_names_of(structs: parser.StructDecl[], sty: string): string[] {
    var out: string[] = [];
    for sd in structs {
        if (sd.name == sty) {
            for fld in sd.fields {
                if (fld.type_name == "fn") { out = out.append(fld.name); }
            }
            return out;
        }
    }
    return out;
}

// clofld_scan / clofld_scan_stmts: the fn-field (closure-field) admission
// walk, the closure sibling of strarrfld_scan. Marks a field NAME unsafe
// (name-keyed over-approximation, like the string scans) when:
//   - a struct-literal stores a NON-LAMBDA value into an fn-typed field —
//     only a lambda literal lifts to a FRESH `__mkclo$` box (rc=1, solely
//     the field's, so the k_clo shallow dec frees exactly once with no
//     construction inc); a bare closure ident / field copy / call result
//     may alias a box another owner also drops;
//   - a struct-literal WITH A BASE constructs a type carrying fn fields —
//     the base copy carries the field's box pointer into a second struct
//     (two k_clo decs of one box);
//   - the field is READ anywhere except as a direct CALL callee — `b.f(x)`
//     borrows the box for the call, but `var g = b.f` binds an uncounted
//     alias the drop would dangle.
// Runs on the PRE-lift AST (fn-field values are still lambdas/idents there).
function clofld_scan(e: ast.Expr, structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(fa) => {
            a = push_str_unique(a, fa.field);
            return clofld_scan(fa.obj, structs, a);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    // `b.f(args)` — the direct field CALL is the one tolerated
                    // borrow: skip marking f, keep walking beneath it.
                    match (cfa.obj) {
                        ast.ExprFieldAccess(ffa) => { a = clofld_scan(ffa, structs, a); },
                        _ => { a = clofld_scan(cfa.obj, structs, a); }
                    }
                },
                _ => { a = clofld_scan(c.callee, structs, a); }
            }
            for arg in c.args { a = clofld_scan(arg, structs, a); }
            return a;
        },
        ast.ExprBinary(b) => { return clofld_scan(b.right, structs, clofld_scan(b.left, structs, a)); },
        ast.ExprUnary(u) => { return clofld_scan(u.operand, structs, a); },
        ast.ExprIndex(ix) => { return clofld_scan(ix.index, structs, clofld_scan(ix.array, structs, a)); },
        ast.ExprSlice(sl) => { return clofld_scan(sl.end, structs, clofld_scan(sl.start, structs, clofld_scan(sl.array, structs, a))); },
        ast.ExprStructLit(sl2) => {
            if (sl2.has_base) {
                a = clofld_scan(sl2.base, structs, a);
                // A base copy of an fn-fielded type carries the closure box —
                // mark every fn field of the type unsafe.
                for sd in structs {
                    if (sd.name == sl2.type_name) {
                        for fld in sd.fields {
                            if (fld.type_name == "fn") { a = push_str_unique(a, fld.name); }
                        }
                    }
                }
            }
            var i: i32 = 0;
            while (i < sl2.field_names.len()) {
                if (decl_field_type(structs, sl2.type_name, sl2.field_names[i]) == "fn") {
                    // Fresh forms: a LAMBDA literal (pre-lift AST) or its
                    // lifted spelling — a `__mkclo$…` constructor call (the
                    // emit orchestrations scan the LIFTED module, where every
                    // fn-field lambda has already been wrapped). Both build a
                    // sole-owned rc=1 box at the construction site.
                    var tup_ok: boolean = false;
                    match (sl2.field_values[i]) {
                        ast.ExprLambda(_) => { tup_ok = true; },
                        ast.ExprCall(cv) => {
                            match (cv.callee) {
                                ast.ExprIdent(cvid) => {
                                    if (cvid.name.len() > 8 && slice_unchecked(cvid.name, 0, 8) == "__mkclo$") { tup_ok = true; }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    if (!tup_ok) { a = push_str_unique(a, sl2.field_names[i]); }
                }
                a = clofld_scan(sl2.field_values[i], structs, a);
                i = i + 1;
            }
            return a;
        },
        ast.ExprArray(av2) => {
            var i: i32 = 0;
            while (i < av2.elements.len()) { a = clofld_scan(av2.elements[i], structs, a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = clofld_scan(el, structs, a); }
            return a;
        },
        ast.ExprLambda(lm) => { return clofld_scan_stmts(lm.body, structs, a); },
        _ => { return a; }
    }
}
function clofld_scan_stmts(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { a = clofld_scan(v.init, structs, a); },
            ast.StmtAssign(as2) => { a = clofld_scan(as2.value, structs, a); },
            ast.StmtExpr(ex) => { a = clofld_scan(ex.value, structs, a); },
            ast.StmtReturn(r) => { a = clofld_scan(r.value, structs, a); },
            ast.StmtIf(iff) => {
                a = clofld_scan(iff.cond, structs, a);
                a = clofld_scan_stmts(iff.then_body, structs, a);
                a = clofld_scan_stmts(iff.else_body, structs, a);
            },
            ast.StmtWhile(w) => {
                a = clofld_scan(w.cond, structs, a);
                a = clofld_scan_stmts(w.body, structs, a);
            },
            ast.StmtFor(fo) => {
                a = clofld_scan(fo.iter, structs, a);
                a = clofld_scan_stmts(fo.body, structs, a);
            },
            ast.StmtMatch(m) => {
                a = clofld_scan(m.scrutinee, structs, a);
                for arm in m.arms {
                    if (arm.has_guard) { a = clofld_scan(arm.guard, structs, a); }
                    a = clofld_scan_stmts(arm.body, structs, a);
                }
            },
            ast.StmtDefer(d) => { a = clofld_scan_stmts([d.action], structs, a); },
            _ => {}
        }
    }
    return a;
}

// FnptrAcc threads the two verdict sets of the fn-pointer-array field scan: `cand`
// names ("<sty>.<field>") of fn[] fields SEEN constructed from an all-fn-value
// array literal, and `bad` names of fn[] fields seen constructed from ANY other
// value (a capturing lambda `__mkclo$` box, a closure/local ident, a call, …). A
// field is a fn-pointer array iff it is in `cand` and never in `bad`.
// fnloc: locals PROVEN bound to an all-fn-value array literal in the function
// currently being scanned, so `var a = [inc]; R { hs: a }` credits the field
// exactly as the inline literal does. Reset per function (a name is meaningless
// across functions) and dropped on ANY assignment to the name, so a later
// rebind to a closure array can never leave a stale credit behind — crediting a
// closure array as fn-POINTERS would call an env box as raw code.
struct FnptrAcc { cand: string[], bad: string[], fnloc: string[], ccand: string[], cbad: string[], cloc: string[] }

// remove_str returns `xs` without any element equal to `name`. Used by the
// fnptr scan to retract a local's all-fn-value proof on shadowing or
// reassignment — retraction must be exact, since a stale entry would credit a
// closure array as raw fn pointers.
function remove_str(xs: string[], name: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] != name) { out = out.append(xs[i]); }
        i = i + 1;
    }
    return out;
}


// fnptr_elem_is_fnval reports whether array element `e` is a bare identifier
// naming a receiver-less top-level function in `funcs` — the whole-program
// (LowerState-free) analogue of fn_value_arg_name, used by the fnptr-array scan.
// The lift has already turned every no-capture lambda element into such a
// hoisted `__lam_N` fn-name, and a capturing lambda into a `__mkclo$` call (not
// an ident), so this cleanly separates fn-pointer elements from closure ones.
function fnptr_elem_is_fnval(e: ast.Expr, funcs: parser.FuncDecl[]): boolean {
    match (e) {
        ast.ExprIdent(id) => {
            for fn in funcs {
                if (fn.name == id.name && fn.receiver_type.len() == 0) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// fnptr_array_lit_all_fnval reports whether `e` is a non-empty ExprArray whose
// EVERY element is fnptr_elem_is_fnval — the scan-side twin of fn_value_array_lit.
function fnptr_array_lit_all_fnval(e: ast.Expr, funcs: parser.FuncDecl[]): boolean {
    match (e) {
        ast.ExprArray(a) => {
            if (a.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (!fnptr_elem_is_fnval(a.elements[i], funcs)) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// fnptr_scan / fnptr_scan_stmts: the whole-program walk behind fnptr_arr_fields_of.
// It visits every struct literal reachable from a function body and, for each
// "fn[]" field, records the construction as candidate (all-fn-value array literal)
// or bad (anything else) — mirroring clofld_scan's traversal shape. Runs on the
// LIFTED module (no-capture lambda elements are already hoisted to `__lam_N`
// idents; capturing ones are `__mkclo$` calls, which land in `bad`).
function fnptr_scan(e: ast.Expr, funcs: parser.FuncDecl[], structs: parser.StructDecl[], acc: FnptrAcc): FnptrAcc {
    var a: FnptrAcc = acc;
    match (e) {
        ast.ExprFieldAccess(fa) => { return fnptr_scan(fa.obj, funcs, structs, a); },
        ast.ExprCall(c) => {
            a = fnptr_scan(c.callee, funcs, structs, a);
            for arg in c.args { a = fnptr_scan(arg, funcs, structs, a); }
            return a;
        },
        ast.ExprBinary(b) => { return fnptr_scan(b.right, funcs, structs, fnptr_scan(b.left, funcs, structs, a)); },
        ast.ExprUnary(u) => { return fnptr_scan(u.operand, funcs, structs, a); },
        ast.ExprIndex(ix) => { return fnptr_scan(ix.index, funcs, structs, fnptr_scan(ix.array, funcs, structs, a)); },
        ast.ExprSlice(sl) => { return fnptr_scan(sl.end, funcs, structs, fnptr_scan(sl.start, funcs, structs, fnptr_scan(sl.array, funcs, structs, a))); },
        ast.ExprStructLit(sl2) => {
            if (sl2.has_base) { a = fnptr_scan(sl2.base, funcs, structs, a); }
            var i: i32 = 0;
            while (i < sl2.field_names.len()) {
                if (decl_field_type(structs, sl2.type_name, sl2.field_names[i]) == "fn[]") {
                    var key: string = sl2.type_name + "." + sl2.field_names[i];
                    var fv_ok: boolean = fnptr_array_lit_all_fnval(sl2.field_values[i], funcs);
                    // `var a = [inc, dbl]; R { hs: a }` — the same all-fn-value
                    // construction, one binding removed. Without this the field
                    // landed in `bad`, so field_access_is_fnarr declined it and
                    // field_access_is_closurearr claimed it by negation, and the
                    // call dispatched env-first on a RAW code pointer (#3457).
                    if (!fv_ok) {
                        match (sl2.field_values[i]) {
                            ast.ExprIdent(fvid) => {
                                if (util.has_str(a.fnloc, fvid.name)) { fv_ok = true; }
                            },
                            _ => {}
                        }
                    }
                    // Closure side, symmetric: credit the field when the value is a
                    // proven all-box array literal or a local bound to one, else
                    // mark it bad. This is POSITIVE evidence — the read side then
                    // needs no "not a pointer array ⇒ closure" negation (#3457).
                    var cv_ok: boolean = clo_array_lit_all_box(sl2.field_values[i]);
                    if (!cv_ok) {
                        match (sl2.field_values[i]) {
                            ast.ExprIdent(cvid) => {
                                if (util.has_str(a.cloc, cvid.name)) { cv_ok = true; }
                            },
                            _ => {}
                        }
                    }
                    if (cv_ok) {
                        a = FnptrAcc { cand: a.cand, bad: a.bad, fnloc: a.fnloc, ccand: push_str_unique(a.ccand, key), cbad: a.cbad, cloc: a.cloc };
                    } else {
                        a = FnptrAcc { cand: a.cand, bad: a.bad, fnloc: a.fnloc, ccand: a.ccand, cbad: push_str_unique(a.cbad, key), cloc: a.cloc };
                    }
                    if (fv_ok) {
                        a = FnptrAcc { cand: push_str_unique(a.cand, key), bad: a.bad, fnloc: a.fnloc, ccand: a.ccand, cbad: a.cbad, cloc: a.cloc };
                    } else {
                        a = FnptrAcc { cand: a.cand, bad: push_str_unique(a.bad, key), fnloc: a.fnloc, ccand: a.ccand, cbad: a.cbad, cloc: a.cloc };
                    }
                }
                a = fnptr_scan(sl2.field_values[i], funcs, structs, a);
                i = i + 1;
            }
            return a;
        },
        ast.ExprArray(av2) => {
            var i: i32 = 0;
            while (i < av2.elements.len()) { a = fnptr_scan(av2.elements[i], funcs, structs, a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = fnptr_scan(el, funcs, structs, a); }
            return a;
        },
        ast.ExprLambda(lm) => { return fnptr_scan_stmts(lm.body, funcs, structs, a, false); },
        _ => { return a; }
    }
    return a;
}
// `top` marks the function body's OWN statement list — the one list whose
// statements each execute exactly once, in order, before every statement after
// them. Only there can an ASSIGNMENT hand its proof forward: a rebind nested in
// an if / loop / match arm / lambda body may not run at all, so a credit from it
// would be a claim about a value the program never stored. Nested lists are
// walked with `top` false, where an assignment only ever retracts.
function fnptr_scan_stmts(stmts: ast.Stmt[], funcs: parser.FuncDecl[], structs: parser.StructDecl[], acc: FnptrAcc, top: boolean): FnptrAcc {
    var a: FnptrAcc = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                a = fnptr_scan(v.init, funcs, structs, a);
                // Bind: remember a local proven to hold an all-fn-value array
                // literal; a re-declaration that is NOT one drops any prior
                // credit for the name (shadowing must not inherit it).
                if (fnptr_array_lit_all_fnval(v.init, funcs)) {
                    a = FnptrAcc { cand: a.cand, bad: a.bad, fnloc: push_str_unique(a.fnloc, v.name), ccand: a.ccand, cbad: a.cbad, cloc: remove_str(a.cloc, v.name) };
                } else {
                    a = FnptrAcc { cand: a.cand, bad: a.bad, fnloc: remove_str(a.fnloc, v.name), ccand: a.ccand, cbad: a.cbad, cloc: clo_bind_update(a.cloc, v) };
                }
            },
            ast.StmtAssign(as2) => {
                a = fnptr_scan(as2.value, funcs, structs, a);
                // An assignment retracts whatever the name was proven to hold —
                // `a = a.append(f)` lands here — and, on the function's own
                // statement list, re-proves it from the assigned value. That
                // re-proof is what makes a REBIND land somewhere rather than
                // nowhere: `var a = [seven]; a = [() => n];` retracts the pointer
                // proof and credits the closure one, so the field it is then stored
                // into is PROVEN a closure array instead of falling through
                // unclassified and bailing the module.
                //
                // The POINTER side is deliberately NOT re-proved by an assignment.
                // A local's element representation is fixed by its DECLARATION, not
                // by what is later stored into it, so the mirror-image rebind
                // (`var a = [() => n]; a = [seven];`) does not actually leave raw
                // code addresses in the buffer — crediting it would route a shape
                // the local rebind itself still miscompiles onto the IR path. It
                // stays unproven until that rebind is fixed.
                //
                // Nested assignments re-prove nothing: a branch or loop body may
                // not run, so a credit from one would claim a store the program
                // never made.
                var nfl: string[] = remove_str(a.fnloc, as2.target);
                var ncl: string[] = remove_str(a.cloc, as2.target);
                if (top && clo_array_lit_all_box(as2.value)) { ncl = push_str_unique(ncl, as2.target); }
                a = FnptrAcc { cand: a.cand, bad: a.bad, fnloc: nfl, ccand: a.ccand, cbad: a.cbad, cloc: ncl };
            },
            ast.StmtExpr(ex) => { a = fnptr_scan(ex.value, funcs, structs, a); },
            ast.StmtReturn(r) => { a = fnptr_scan(r.value, funcs, structs, a); },
            ast.StmtIf(iff) => {
                a = fnptr_scan(iff.cond, funcs, structs, a);
                a = fnptr_scan_stmts(iff.then_body, funcs, structs, a, false);
                a = fnptr_scan_stmts(iff.else_body, funcs, structs, a, false);
            },
            ast.StmtWhile(w) => {
                a = fnptr_scan(w.cond, funcs, structs, a);
                a = fnptr_scan_stmts(w.body, funcs, structs, a, false);
            },
            ast.StmtFor(fo) => {
                a = fnptr_scan(fo.iter, funcs, structs, a);
                a = fnptr_scan_stmts(fo.body, funcs, structs, a, false);
            },
            ast.StmtMatch(m) => {
                a = fnptr_scan(m.scrutinee, funcs, structs, a);
                for arm in m.arms {
                    if (arm.has_guard) { a = fnptr_scan(arm.guard, funcs, structs, a); }
                    a = fnptr_scan_stmts(arm.body, funcs, structs, a, false);
                }
            },
            ast.StmtDefer(d) => { a = fnptr_scan_stmts([d.action], funcs, structs, a, false); },
            _ => {}
        }
    }
    return a;
}


// clo_elem_is_box reports whether array element `e` is a `__mkclo$…(caps)` call
// — the env-box constructor the lift pass rewrites every CAPTURING lambda to.
// Post-lift this is the positive signature of a closure element, exactly as a
// bare fn ident is the positive signature of a pointer element
// (fnptr_elem_is_fnval). The two are disjoint by construction: the lift turns a
// no-capture lambda into a hoisted `__lam_N` IDENT and a capturing one into this
// CALL, so no element satisfies both.
function clo_elem_is_box(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    return id.name.len() > 8 && slice_unchecked(id.name, 0, 8) == "__mkclo$";
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}


// clo_bind_update credits `v.name` when the binding is a proven all-box array
// literal, and retracts it otherwise — the closure twin of the fnloc update, so
// shadowing by a non-closure value cannot leave a stale proof behind.
function clo_bind_update(cloc: string[], v: ast.StmtVar): string[] {
    if (clo_array_lit_all_box(v.init)) { return push_str_unique(cloc, v.name); }
    return remove_str(cloc, v.name);
}

// clo_array_lit_all_box: `e` is a non-empty array literal whose EVERY element is
// a closure box — the closure twin of fnptr_array_lit_all_fnval.
function clo_array_lit_all_box(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(a) => {
            if (a.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (!clo_elem_is_box(a.elements[i])) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// fnptr_arr_fields_of returns "FNPTR:<sty>.<field>" markers for every "fn[]"
// struct field that is constructed ONLY from all-fn-value array literals
// program-wide — i.e. a PLAIN fn-pointer array, never a closure array. A field
// whose ANY construction stores a non-fn-value (a capturing lambda `__mkclo$`
// box, a closure/local ident, a call result) is treated as a closure array and
// gets NO marker. The markers are piggybacked on the LowerState.closure_fns list
// so the read side (field_access_is_fnarr) can distinguish the two "fn[]" shapes,
// and are seeded as struct-drop `need`s so a fn-pointer field is not walked as a
// box array on reclamation (its elements are raw code addresses). Runs on the
// LIFTED module (all_funcs/all_structs), so lambda elements are already resolved.
pub function fnptr_arr_fields_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var acc: FnptrAcc = FnptrAcc { cand: [], bad: [], fnloc: [], ccand: [], cbad: [], cloc: [] };
    for fn in funcs {
        // Local names are per-function: a proof from an earlier function must
        // not credit a same-named local here.
        acc = FnptrAcc { cand: acc.cand, bad: acc.bad, fnloc: [], ccand: acc.ccand, cbad: acc.cbad, cloc: [] };
        acc = fnptr_scan_stmts(fn.body, funcs, structs, acc, true);
    }
    var out: string[] = [];
    var j: i32 = 0;
    while (j < acc.cand.len()) {
        if (!util.has_str(acc.bad, acc.cand[j])) { out = out.append("FNPTR:" + acc.cand[j]); }
        j = j + 1;
    }
    // CLOARR:<sty>.<field> — the closure twin, emitted from the same scan so the
    // read side can ask "is this field PROVEN to hold env boxes" instead of
    // inferring it from the absence of a FNPTR marker. A field with neither
    // marker is simply unproven, and the dispatch declines rather than guessing.
    var k: i32 = 0;
    while (k < acc.ccand.len()) {
        if (!util.has_str(acc.cbad, acc.ccand[k])) { out = out.append("CLOARR:" + acc.ccand[k]); }
        k = k + 1;
    }
    // FNFLD:<sty>.<field> — every "fn[]" field this module CONSTRUCTS, proved or
    // not. The two marker sets above answer "which representation", this one
    // answers "was it built here at all", which is what separates a field the
    // module cannot classify (a real error — see check_fn_array_fields) from one
    // it simply never sees constructed (a sibling module's job, so silence).
    var seen: string[] = [];
    var si: i32 = 0;
    while (si < acc.cand.len()) { seen = push_str_unique(seen, acc.cand[si]); si = si + 1; }
    si = 0;
    while (si < acc.bad.len()) { seen = push_str_unique(seen, acc.bad[si]); si = si + 1; }
    si = 0;
    while (si < acc.ccand.len()) { seen = push_str_unique(seen, acc.ccand[si]); si = si + 1; }
    si = 0;
    while (si < acc.cbad.len()) { seen = push_str_unique(seen, acc.cbad[si]); si = si + 1; }
    si = 0;
    while (si < seen.len()) { out = out.append("FNFLD:" + seen[si]); si = si + 1; }
    return out;
}

// check_fn_array_fields is the pre-emit gate for the ONE `fn[]` struct-field
// shape the compiler cannot lower correctly: a field whose construction proves
// neither representation.
//
// `(() => T)[]` is spelled the same for a raw-fn-pointer array and an array of
// `__mkclo$` env boxes, and the two dispatch differently (plain `call_indirect`
// vs env-first). The construction scan proves one or the other and the read side
// asks for the proof (#5790). A field with NEITHER marker is unproven — and
// neither dispatch default is safe: a raw pointer called env-first crashes, and
// an env box called as a plain pointer crashes too. Before this gate the read
// simply bailed the function, the module dropped to the legacy AST emitter, and
// THAT miscompiled it — a SIGSEGV at runtime with no diagnostic (#5787 measured
// both the param-built and loop-built shapes crashing on both paths). With the
// emitters gone the bail alone would be a bare "not IR-eligible", naming
// nothing.
//
// So: report it, the way `wasm_unsupported_builtin` reports a builtin with no
// wasm meaning. A diagnostic naming the field beats a segfault.
//
// Two deliberate narrowings keep this from rejecting working programs:
//   - only a field this module CONSTRUCTS (`FNFLD:`). A field read here but built
//     in a sibling module is not this module's call to make, and per-module emit
//     must not reject it.
//   - only a field this module READS. Building an unclassifiable field and never
//     reading it lowers fine today, because the representation only matters at
//     dispatch.
pub function check_fn_array_fields(mod: parser.Module): string {
    var lifted: parser.Module = lift_lambdas(mod);
    var marks: string[] = fnptr_arr_fields_of(lifted.funcs, lifted.structs);
    var reads: string[] = [];
    var i: i32 = 0;
    while (i < lifted.funcs.len()) {
        // Seed the bindings with the params: `function call(r: Reg)` makes `r`
        // a Reg for every read in the body.
        var binds: string[] = [];
        var pi: i32 = 0;
        while (pi < lifted.funcs[i].params.len()) {
            binds = fnfld_bind(binds, lifted.funcs[i].params[pi].name, lifted.funcs[i].params[pi].type_name, lifted.structs);
            pi = pi + 1;
        }
        reads = fnfld_read_stmts(lifted.funcs[i].body, lifted.structs, binds, reads);
        i = i + 1;
    }
    var out: string = "";
    var r: i32 = 0;
    while (r < reads.len()) {
        var key: string = reads[r];
        if (util.has_str(marks, "FNFLD:" + key)
                && !util.has_str(marks, "FNPTR:" + key)
                && !util.has_str(marks, "CLOARR:" + key)) {
            out = out + "error: cannot determine whether the `fn[]` field `" + key
                + "` holds function pointers or closures\n"
                + "  every construction of it must be an array literal (or a local bound to one)\n"
                + "  whose elements are ALL named functions, or ALL closures\n";
        }
        r = r + 1;
    }
    return out;
}

// fnfld_read_stmts collects `<Type>.<field>` for every "fn[]" struct field READ
// in `stmts`, threading `binds` — the local/param name -> struct type map the
// resolution needs, since the gate runs before any LowerState exists.
//
// A bare `.len()` receiver is not a read for this purpose: it never reaches an
// element, so the representation cannot matter. Same carve-out strarrfld_scan
// makes.
function fnfld_read_stmts(stmts: ast.Stmt[], structs: parser.StructDecl[], binds: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var b: string[] = binds;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                a = fnfld_read_expr(v.init, structs, b, a);
                // `var r: R = …` binds by annotation; `var r = R { … }` by the
                // literal. Anything else drops the name (a shadowing rebind must
                // not inherit the old type).
                var vty: string = v.type_name;
                if (vty.len() == 0) { vty = fnfld_lit_type(v.init); }
                b = fnfld_bind(b, v.name, vty, structs);
            },
            ast.StmtAssign(as2) => { a = fnfld_read_expr(as2.value, structs, b, a); },
            ast.StmtExpr(ex) => { a = fnfld_read_expr(ex.value, structs, b, a); },
            ast.StmtReturn(rt) => { a = fnfld_read_expr(rt.value, structs, b, a); },
            ast.StmtIf(iff) => {
                a = fnfld_read_expr(iff.cond, structs, b, a);
                a = fnfld_read_stmts(iff.then_body, structs, b, a);
                a = fnfld_read_stmts(iff.else_body, structs, b, a);
            },
            ast.StmtWhile(w) => {
                a = fnfld_read_expr(w.cond, structs, b, a);
                a = fnfld_read_stmts(w.body, structs, b, a);
            },
            ast.StmtFor(fo) => {
                a = fnfld_read_expr(fo.iter, structs, b, a);
                a = fnfld_read_stmts(fo.body, structs, b, a);
            },
            ast.StmtMatch(m) => {
                a = fnfld_read_expr(m.scrutinee, structs, b, a);
                for arm in m.arms {
                    if (arm.has_guard) { a = fnfld_read_expr(arm.guard, structs, b, a); }
                    a = fnfld_read_stmts(arm.body, structs, b, a);
                }
            },
            ast.StmtDefer(d) => { a = fnfld_read_stmts([d.action], structs, b, a); },
            _ => {}
        }
    }
    return a;
}

function fnfld_read_expr(e: ast.Expr, structs: parser.StructDecl[], binds: string[], acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = fnfld_obj_type(fa.obj, structs, binds);
            if (oty.len() > 0 && decl_field_type(structs, oty, fa.field) == "fn[]") {
                a = push_str_unique(a, oty + "." + fa.field);
            }
            return fnfld_read_expr(fa.obj, structs, binds, a);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        match (cfa.obj) {
                            ast.ExprFieldAccess(ffa) => { a = fnfld_read_expr(ffa.obj, structs, binds, a); },
                            _ => { a = fnfld_read_expr(cfa.obj, structs, binds, a); }
                        }
                    } else {
                        a = fnfld_read_expr(c.callee, structs, binds, a);
                    }
                },
                _ => { a = fnfld_read_expr(c.callee, structs, binds, a); }
            }
            for arg in c.args { a = fnfld_read_expr(arg, structs, binds, a); }
            return a;
        },
        ast.ExprIndex(ix) => { return fnfld_read_expr(ix.index, structs, binds, fnfld_read_expr(ix.array, structs, binds, a)); },
        ast.ExprBinary(bx) => { return fnfld_read_expr(bx.right, structs, binds, fnfld_read_expr(bx.left, structs, binds, a)); },
        ast.ExprUnary(u) => { return fnfld_read_expr(u.operand, structs, binds, a); },
        ast.ExprSlice(sl) => { return fnfld_read_expr(sl.end, structs, binds, fnfld_read_expr(sl.start, structs, binds, fnfld_read_expr(sl.array, structs, binds, a))); },
        ast.ExprArray(av) => {
            var ei: i32 = 0;
            while (ei < av.elements.len()) { a = fnfld_read_expr(av.elements[ei], structs, binds, a); ei = ei + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = fnfld_read_expr(el, structs, binds, a); }
            return a;
        },
        ast.ExprStructLit(sl2) => {
            var fi: i32 = 0;
            while (fi < sl2.field_values.len()) { a = fnfld_read_expr(sl2.field_values[fi], structs, binds, a); fi = fi + 1; }
            if (sl2.has_base) { a = fnfld_read_expr(sl2.base, structs, binds, a); }
            return a;
        },
        ast.ExprLambda(lm) => { return fnfld_read_stmts(lm.body, structs, binds, a); },
        _ => { return a; }
    }
    return a;
}

// fnfld_obj_type resolves the struct type of a field-access RECEIVER from
// declarations alone: a `T { … }` literal, or a name bound by a param / an
// annotated `var` / a `var` initialised from a literal. Anything else yields ""
// and the gate stays silent — the conservative direction for a rejector.
function fnfld_obj_type(e: ast.Expr, structs: parser.StructDecl[], binds: string[]): string {
    match (e) {
        ast.ExprStructLit(sl) => { return sl.type_name; },
        ast.ExprIdent(id) => { return fnfld_lookup(binds, id.name); },
        _ => { return ""; }
    }
    return "";
}

// fnfld_lit_type reads the struct type off an initialiser that is a struct
// literal, so an UNANNOTATED `var r = R { … }` still binds.
function fnfld_lit_type(e: ast.Expr): string {
    match (e) {
        ast.ExprStructLit(sl) => { return sl.type_name; },
        _ => { return ""; }
    }
    return "";
}

// fnfld_bind records `name` as `ty` when `ty` names a declared struct, and drops
// any prior binding for the name otherwise (shadowing must not inherit a type).
// Entries are "name ty" pairs in one flat list — two slots per binding, so the
// list stays a plain string[] the way the other scan accumulators do.
function fnfld_bind(binds: string[], name: string, ty: string, structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i + 1 < binds.len()) {
        if (binds[i] != name) { out = out.append(binds[i]); out = out.append(binds[i + 1]); }
        i = i + 2;
    }
    var known: boolean = false;
    for sd in structs {
        if (sd.name == ty) { known = true; }
    }
    if (known) { out = out.append(name); out = out.append(ty); }
    return out;
}

function fnfld_lookup(binds: string[], name: string): string {
    var i: i32 = 0;
    while (i + 1 < binds.len()) {
        if (binds[i] == name) { return binds[i + 1]; }
        i = i + 2;
    }
    return "";
}

// strarrfld_scan / strarrfld_scan_stmts: the string[]-field admission walk,
// which the struct[]/enum[]-field admission ("sarr:", #7067) rides — the read
// rule below is the same question for both, so one walk feeds both halves.
// Marks a field unsafe when:
//   - it is READ anywhere except as a bare `.len()` receiver — an indexed
//     read (`x.f[i]`), an iteration (`for s in x.f`), a bare copy, a method
//     receiver, or a call argument all create/bind an element or buffer
//     alias the deep free could dangle;
//   - a struct-literal stores a NON-element-fresh value into a string[]
//     field — anything but an array literal whose every element is
//     strarr_value_is_fresh (string literal / concat / proven producer call)
//     or `[]`;
//   - a struct-literal stores a non-element-fresh value into a struct-ARRAY /
//     enum-ARRAY field (boxarr_lit_all_elems_fresh).
// Over-marking names of fields of the other kind is harmless: each admission
// consults only its own field names.
//
// Marks are keyed "<T>.<field>" wherever the owning type is known — always at
// a struct-literal store, and at a read whose receiver fnfld_obj_type can
// resolve (a param, an annotated `var`, a literal-initialised `var`). An
// unresolvable receiver falls back to the bare field NAME, which the admission
// reads as poisoning that field in EVERY type — the conservative direction,
// and what every mark used to be. Two structs sharing a field name no longer
// share its verdict: a `mk(notes) { Other { notes: notes } }` elsewhere in the
// module used to cost every `notes` field in the program its reclaim.
// strarrfld_transient_elem_recv reports whether a method call's callee is
// `<struct>.<string[] field>[i].<read-only method>` — an ELEMENT borrowed for one
// call and never bound. str_borrowing_method is the method set.
function strarrfld_transient_elem_recv(cfa: ast.ExprFieldAccess, structs: parser.StructDecl[], binds: string[]): boolean {
    if (!str_borrowing_method(cfa.field)) { return false; }
    match (cfa.obj) {
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprFieldAccess(ffa) => {
                    var oty: string = fnfld_obj_type(ffa.obj, structs, binds);
                    if (oty.len() == 0) { return false; }
                    return decl_field_type(structs, oty, ffa.field) == "string[]";
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// strarrfld_fwd_param_own: `name` is an `own` parameter of `fn` — a struct it
// CONSUMES, so a field read out of it is not a borrow anyone else still holds.
function strarrfld_fwd_param_own(fn: parser.FuncDecl, name: string): boolean {
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (fn.params[i].name == name) { return fn.params[i].own; }
        i = i + 1;
    }
    return false;
}

// strarrfld_fwd_ret_key: the `"<T>.<field>"` one return value hands out of a
// BORROWED receiver or struct parameter, "" for anything else.
function strarrfld_fwd_ret_key(e: ast.Expr, fn: parser.FuncDecl, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (strarrfld_fwd_param_own(fn, oid.name)) { return ""; }
                    var oty: string = arrown_obj_struct_type(fn, oid.name, structs);
                    if (oty.len() == 0) { return ""; }
                    if (decl_field_type(structs, oty, fa.field) != "string[]") { return ""; }
                    return oty + "." + fa.field;
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// strarrfld_fwd_ret_keys: strarrfld_fwd_ret_key for every return in `stmts`,
// one entry per return — including the "" a non-forwarding return contributes,
// so the caller sees that it disagrees. Lambda bodies are not walked: a return
// inside one belongs to the lambda.
function strarrfld_fwd_ret_keys(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { a = a.append(strarrfld_fwd_ret_key(r.value, fn, structs)); },
            ast.StmtIf(f) => {
                a = strarrfld_fwd_ret_keys(f.then_body, fn, structs, a);
                a = strarrfld_fwd_ret_keys(f.else_body, fn, structs, a);
            },
            ast.StmtWhile(w) => { a = strarrfld_fwd_ret_keys(w.body, fn, structs, a); },
            ast.StmtFor(fo) => { a = strarrfld_fwd_ret_keys(fo.body, fn, structs, a); },
            ast.StmtMatch(m) => {
                var i: i32 = 0;
                while (i < m.arms.len()) { a = strarrfld_fwd_ret_keys(m.arms[i].body, fn, structs, a); i = i + 1; }
            },
            ast.StmtDefer(_) => {},
            _ => {}
        }
    }
    return a;
}

// strarrfld_fwd_field_of: the `"<T>.<field>"` EVERY return of `fn` hands out,
// or "" when `fn` is not a string[]-field forwarder. All-or-nothing and
// single-valued — a body whose returns forward two different fields, or one
// that returns anything else on some path, is not one.
//
// A forwarder is why declaring `(h: Holder) get(): string[] { return h.xs; }`
// stranded every `Holder` in the program (#7417): `h.xs` is a read the
// admission walk marks, and the mark is keyed on the TYPE, so one declaration
// refused the field reclaim for every instance in every function — whether or
// not the method was ever called. The verdict belongs at the forwarder's CALL
// sites (strarrfld_fwd_marks), and the forwarding return is exempt there.
function strarrfld_fwd_field_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string {
    if (fn.ret_type != "string[]") { return ""; }
    if (!body_has_return(fn.body)) { return ""; }
    var seed: string[] = [];
    var keys: string[] = strarrfld_fwd_ret_keys(fn.body, fn, structs, seed);
    if (keys.len() == 0) { return ""; }
    var k0: string = keys[0];
    if (k0.len() == 0) { return ""; }
    var i: i32 = 1;
    while (i < keys.len()) {
        if (keys[i] != k0) { return ""; }
        i = i + 1;
    }
    return k0;
}

// strarrfld_forwarders_of: the whole program's string[]-field forwarders, as
// registry rows the call-site probe reads with tagged_value_of:
//
//   "m:<Recv>.<method>|<T>.<field>"  a method, for a call whose receiver type
//                                    fnfld_obj_type resolves
//   "n:<method>|<field>"             the same method by NAME alone, for a call
//                                    whose receiver type it does not — the mark
//                                    is the bare field name, which the
//                                    admission reads as poisoning that field in
//                                    every type
//   "f:<name>|<T>.<field>"           a free function
//
// A free-function row is NOT filtered against the names a frame shadows, the
// way the fresh-array producers are. The two registries answer opposite
// questions: a producer row ADMITS a store, so a shadowed name must drop out or
// an unknown body gets credited; a forwarder row MARKS a read, so a shadowed
// name marks a field that was never handed out — over-marking, the direction
// this whole scan already errs in.
function strarrfld_forwarders_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var k: string = strarrfld_fwd_field_of(fn, structs);
        if (k.len() > 0) {
            if (fn.receiver_name.len() > 0) {
                out = push_str_unique(out, "m:" + util.base_type_name(fn.receiver_type) + "." + fn.name + "|" + k);
                var dot: i32 = 0;
                while (dot < k.len() && k[dot] != b'.') { dot = dot + 1; }
                out = push_str_unique(out, "n:" + fn.name + "|" + slice_unchecked(k, dot + 1, k.len()));
            } else {
                out = push_str_unique(out, "f:" + fn.name + "|" + k);
            }
        }
    }
    return out;
}

// strarrfld_fwd_values: every <value> under "<pfx><name>|" in `names`. The
// tagged_value_of sibling for a key more than one row can answer — two types
// may declare the same method name, and a call whose receiver will not resolve
// has to mark what all of them forward.
function strarrfld_fwd_values(names: string[], pfx: string, name: string, acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < names.len()) {
        var e: string = names[i];
        var st: i32 = tagged_value_start(e, pfx, name);
        if (st >= 0 && st < e.len()) { a = push_str_unique(a, slice_unchecked(e, st, e.len()) + ""); }
        i = i + 1;
    }
    return a;
}

// strarrfld_fwd_marks: the field marks a CALL of a registered forwarder makes.
// Empty when the call is not one, which is also how the callers test for it.
function strarrfld_fwd_marks(c: ast.ExprCall, structs: parser.StructDecl[], binds: string[], forwarders: string[]): string[] {
    var out: string[] = [];
    if (forwarders.len() == 0) { return out; }
    match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
            var oty: string = fnfld_obj_type(cfa.obj, structs, binds);
            if (oty.len() > 0) {
                var v: string = tagged_value_of(forwarders, "m:", oty + "." + cfa.field);
                if (v.len() > 0) { out = out.append(v); }
                return out;
            }
            return strarrfld_fwd_values(forwarders, "n:", cfa.field, out);
        },
        ast.ExprIdent(cid) => {
            var fv: string = tagged_value_of(forwarders, "f:", cid.name);
            if (fv.len() > 0) { out = out.append(fv); }
            return out;
        },
        _ => { return out; }
    }
    return out;
}

// strarrfld_scan_under_call: everything beneath a call but not the call itself
// — its receiver expression and its arguments. Used where the call IS a borrow
// the scan tolerates, so it must make no mark of its own while what it is
// applied to still walks.
function strarrfld_scan_under_call(c: ast.ExprCall, structs: parser.StructDecl[], binds: string[], str_fresh: string[], strarr_producers: string[], forwarders: string[], acc: string[]): string[] {
    var a: string[] = acc;
    match (c.callee) {
        ast.ExprFieldAccess(cfa) => { a = strarrfld_scan(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a); },
        _ => {}
    }
    for arg in c.args { a = strarrfld_scan(arg, structs, binds, str_fresh, strarr_producers, forwarders, a); }
    return a;
}

// strarrfld_ret_is_fwd: `e` is exactly the forwarding read `<recv>.<field>`
// that `key` names — the one read a forwarder's own body is exempt from.
function strarrfld_ret_is_fwd(e: ast.Expr, structs: parser.StructDecl[], binds: string[], key: string): boolean {
    if (key.len() == 0) { return false; }
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(_) => {
                    var oty: string = fnfld_obj_type(fa.obj, structs, binds);
                    if (oty.len() == 0) { return false; }
                    return oty + "." + fa.field == key;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function strarrfld_scan(e: ast.Expr, structs: parser.StructDecl[], binds: string[], str_fresh: string[], strarr_producers: string[], forwarders: string[], acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = fnfld_obj_type(fa.obj, structs, binds);
            if (oty.len() > 0) { a = push_str_unique(a, oty + "." + fa.field); }
            else { a = push_str_unique(a, fa.field); }
            return strarrfld_scan(fa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
        },
        ast.ExprCall(c) => {
            // A registered FORWARDER call is a READ of the field it hands out,
            // made HERE rather than at the `return h.xs` inside the forwarder —
            // that is the whole of #7417. Everything but a `.len()` receiver
            // binds or escapes the buffer, and the `.len()` case is skipped one
            // frame up, where that receiver is the visible node.
            var fwdm: string[] = strarrfld_fwd_marks(c, structs, binds, forwarders);
            var fwi: i32 = 0;
            while (fwi < fwdm.len()) { a = push_str_unique(a, fwdm[fwi]); fwi = fwi + 1; }
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    // The transient ELEMENT receiver is tested FIRST: `.len()` is
                    // in both vocabularies, and the whole-array branch below would
                    // otherwise take `x.f[i].len()` and walk the index expression,
                    // marking the field the element came out of.
                    if (strarrfld_transient_elem_recv(cfa, structs, binds)) {
                        // `x.f[i].len()` and its read-only siblings: the ELEMENT
                        // is borrowed for the length of one call and never bound,
                        // so the field's elements stay solely the struct's — the
                        // same transient-vs-lasting line strarr_expr_unsafe draws
                        // for a string[] LOCAL, which this scan did not draw for a
                        // FIELD. Skip marking the receiver field; keep walking the
                        // index expression and everything beneath the field.
                        match (cfa.obj) {
                            ast.ExprIndex(cix) => {
                                a = strarrfld_scan(cix.index, structs, binds, str_fresh, strarr_producers, forwarders, a);
                                match (cix.array) {
                                    ast.ExprFieldAccess(ffa2) => { a = strarrfld_scan(ffa2.obj, structs, binds, str_fresh, strarr_producers, forwarders, a); },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                    } else if (cfa.field == "len") {
                        // `x.f.len()` is the other tolerated borrow: skip marking
                        // the receiver FIELD, but keep walking beneath it.
                        match (cfa.obj) {
                            ast.ExprFieldAccess(ffa) => { a = strarrfld_scan(ffa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a); },
                            // `x.get().len()` — a FORWARDER borrowed for its
                            // length, the same borrow one line up reached
                            // through a call. Walk beneath it so the call makes
                            // no mark of its own.
                            ast.ExprCall(fc) => {
                                if (strarrfld_fwd_marks(fc, structs, binds, forwarders).len() > 0) {
                                    a = strarrfld_scan_under_call(fc, structs, binds, str_fresh, strarr_producers, forwarders, a);
                                } else {
                                    a = strarrfld_scan(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
                                }
                            },
                            _ => { a = strarrfld_scan(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a); }
                        }
                    } else {
                        a = strarrfld_scan(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
                    }
                },
                _ => { a = strarrfld_scan(c.callee, structs, binds, str_fresh, strarr_producers, forwarders, a); }
            }
            for arg in c.args { a = strarrfld_scan(arg, structs, binds, str_fresh, strarr_producers, forwarders, a); }
            return a;
        },
        ast.ExprBinary(b) => { return strarrfld_scan(b.right, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(b.left, structs, binds, str_fresh, strarr_producers, forwarders, a)); },
        ast.ExprUnary(u) => { return strarrfld_scan(u.operand, structs, binds, str_fresh, strarr_producers, forwarders, a); },
        ast.ExprIndex(ix) => { return strarrfld_scan(ix.index, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(ix.array, structs, binds, str_fresh, strarr_producers, forwarders, a)); },
        ast.ExprSlice(sl) => { return strarrfld_scan(sl.end, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(sl.start, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(sl.array, structs, binds, str_fresh, strarr_producers, forwarders, a))); },
        ast.ExprStructLit(sl2) => {
            if (sl2.has_base) {
                a = strarrfld_scan(sl2.base, structs, binds, str_fresh, strarr_producers, forwarders, a);
                // A functional-update BASE copies every field the literal does
                // not override, pointer-for-pointer. The copy takes no retain
                // for an array field, so both boxes hold the same buffer with
                // one reference between them: STORE-unsafe for the buffer dec,
                // whatever the overrides look like.
                for sd in structs {
                    if (sd.name == sl2.type_name) {
                        for fld in sd.fields {
                            if (fld.type_name == "string[]") {
                                a = push_str_unique(a, "store:" + sl2.type_name + "." + fld.name);
                            }
                        }
                    }
                }
            }
            var i: i32 = 0;
            while (i < sl2.field_names.len()) {
                var fkt: string = decl_field_type(structs, sl2.type_name, sl2.field_names[i]);
                // Set by the string[] admission below and read by the value walk
                // at the end of this iteration, so it lives in the loop-body scope
                // rather than inside that branch.
                var share_read: boolean = false;
                // A struct-ARRAY / enum-ARRAY field rides the SAME scan (#7067):
                // its element boxes are freed by __field_reclaim_<T>'s walk on a
                // rebind, so the field is admitted only when every stored value
                // is an array literal of FRESH elements — boxarr_lit_all_elems_fresh,
                // the identical proof the reuse admission makes for these fields.
                // `d.vals.append(v)` and any other non-literal store share element
                // pointers with the buffer it supersedes, and freeing those is a
                // double free.
                if (is_struct_array_field_type(structs, fkt) || is_enum_array_field_type(structs, fkt)) {
                    if (!boxarr_lit_all_elems_fresh(sl2.field_values[i], structs, slice_unchecked(fkt, 0, fkt.len() - 2), is_enum_array_field_type(structs, fkt))) {
                        a = push_str_unique(a, sl2.type_name + "." + sl2.field_names[i]);
                    }
                }
                if (fkt == "string[]") {
                    var store_ok: boolean = false;
                    match (sl2.field_values[i]) {
                        ast.ExprArray(av) => {
                            store_ok = true;
                            var ei: i32 = 0;
                            while (ei < av.elements.len()) {
                                if (!strarr_value_is_fresh(av.elements[ei], str_fresh)) { store_ok = false; }
                                ei = ei + 1;
                            }
                        },
                        // A whole-array PRODUCER call: fn_returns_fresh_strarr
                        // proved whole-program that every element of the result
                        // is a box the callee allocated and handed out at rc=1,
                        // so the struct owns them exactly as it owns a literal's.
                        // `strarr_producers` is filtered per function before the
                        // walk, so a callee name this frame declares or takes
                        // as a parameter is already absent — it would hold an
                        // unknown body, the refusal every registry consumer
                        // makes.
                        ast.ExprCall(fc) => {
                            match (fc.callee) {
                                ast.ExprIdent(fcid) => {
                                    store_ok = util.index_of_str(strarr_producers, fcid.name) >= 0;
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    // A bare IDENT — a parameter or a live local. Admitting it
                    // is what turns the construction retain on for this type
                    // (both ride struct_routes_field_reclaim), so the field
                    // holds a counted reference rather than an uncounted alias
                    // and the drop's dec is balanced against it. Refusing it was
                    // the third leg of the circularity: unadmitted meant no
                    // retain, and no retain meant it could not be admitted.
                    match (sl2.field_values[i]) { ast.ExprIdent(_) => { store_ok = true; }, _ => {} }
                    // A bare `q.f` READ of another holder's string[] field, handed
                    // straight into a string[] field of this literal — the counted
                    // share str_field_share_read draws for a scalar `string`, and
                    // enum_arr_field_share_read for an `E[]`. `string[]` was the one
                    // field kind left out, which is `str_arr__fieldread` (#5338).
                    //
                    // Admitting it is sound for the reason the bare-ident case above
                    // is: the construction RETAINS an array field unconditionally
                    // (is_array_type_name covers string[] in the ExprStructLit arm),
                    // so the new holder co-owns a COUNTED reference and its drop's dec
                    // is balanced against it. `str_arr__local` measures that retain
                    // already working — the difference here is only that the value is
                    // read out of a sibling rather than out of a local.
                    //
                    // Both ends are checked: the SOURCE field and the TARGET field
                    // must both be string[], and the holder must be a bare ident so
                    // the share has one identifiable co-owner. `foo().f` is refused —
                    // there is no second holder to keep alive, so the read is an
                    // ordinary escape.
                    match (sl2.field_values[i]) {
                        ast.ExprFieldAccess(sfa) => {
                            match (sfa.obj) {
                                ast.ExprIdent(_) => {
                                    var soty: string = fnfld_obj_type(sfa.obj, structs, binds);
                                    if (soty.len() > 0
                                        && decl_field_type(structs, soty, sfa.field) == "string[]"
                                        && decl_field_type(structs, sl2.type_name, sl2.field_names[i]) == "string[]") {
                                        store_ok = true;
                                        share_read = true;
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    if (!store_ok) {
                        a = push_str_unique(a, sl2.type_name + "." + sl2.field_names[i]);
                        // The STORE half on its own, under an inert prefixed
                        // spelling. The plain mark above is pushed for a bad
                        // store AND for an unsafe READ, and the two gate
                        // different things: a read hazard costs the ELEMENT
                        // walk, a store hazard costs the BUFFER dec as well,
                        // because the stored value is then an uncounted alias
                        // the construction never retained.
                        a = push_str_unique(a, "store:" + sl2.type_name + "." + sl2.field_names[i]);
                    }
                }
                // The admitted share is NOT walked as a read: marking it would
                // refuse the SOURCE holder's reclaim, and a share needs both ends
                // alive to balance. Its holder is still walked, so a mark owed by a
                // more complex object expression is not lost — though a non-ident
                // holder never reaches here, since the admission above requires one.
                if (share_read) {
                    match (sl2.field_values[i]) {
                        ast.ExprFieldAccess(wfa) => { a = strarrfld_scan(wfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a); },
                        _ => {}
                    }
                } else {
                    a = strarrfld_scan(sl2.field_values[i], structs, binds, str_fresh, strarr_producers, forwarders, a);
                }
                i = i + 1;
            }
            return a;
        },
        ast.ExprArray(av2) => {
            var i: i32 = 0;
            while (i < av2.elements.len()) { a = strarrfld_scan(av2.elements[i], structs, binds, str_fresh, strarr_producers, forwarders, a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = strarrfld_scan(el, structs, binds, str_fresh, strarr_producers, forwarders, a); }
            return a;
        },
        // A map literal and an f-string carry ordinary sub-expressions, which
        // every sibling walk in this file visits and this one did not: an
        // unwalked `f"{h.xs[0]}"` is an element handed to a formatter with
        // nothing marked.
        ast.ExprMapLit(ml) => {
            for k in ml.keys { a = strarrfld_scan(k, structs, binds, str_fresh, strarr_producers, forwarders, a); }
            for v in ml.vals { a = strarrfld_scan(v, structs, binds, str_fresh, strarr_producers, forwarders, a); }
            return a;
        },
        ast.ExprFString(fs) => {
            for x in fs.exprs { a = strarrfld_scan(x, structs, binds, str_fresh, strarr_producers, forwarders, a); }
            return a;
        },
        ast.ExprLambda(lm) => { return strarrfld_scan_stmts(lm.body, structs, binds, str_fresh, strarr_producers, forwarders, "", a); },
        _ => { return a; }
    }
}
// strarrfld_share_bind_stores: the site keys of every
// `var p: T = T { …, <string[] field>: name, … }` bind directly in `stmts` —
// the one position a share-bound local may legally reach. The store retains
// the buffer, so the new holder co-owns a COUNTED reference exactly as the
// inline share's does. Feeds strarr_unsafe_for_alias's `sfld_ok`, which is
// already keyed this way for the local credit's own version of this question.
//
// A store nested inside an if / while / match body is not collected, so
// strarr_unsafe_for_alias flags it and the bind is refused — the conservative
// direction, and the reason this only needs the flat list.
function strarrfld_share_bind_stores(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprStructLit(sl) => {
                        var i: i32 = 0;
                        while (i < sl.field_names.len()) {
                            match (sl.field_values[i]) {
                                ast.ExprIdent(id) => {
                                    if (id.name == name
                                        && decl_field_type(structs, sl.type_name, sl.field_names[i]) == "string[]") {
                                        out = push_str_unique(out, reclaim_site_key_of(v.name, v.line, v.col));
                                    }
                                },
                                _ => {}
                            }
                            i = i + 1;
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    return out;
}

// strarrfld_bind_read: the expression a `var` initialiser contributes to the
// read walk. Normally the initialiser itself; for an admitted share BIND, only
// its HOLDER.
//
// `var tt: string[] = q.f;` is the hoisted spelling of the inline share
// strarrfld_scan admits at its struct-literal store — the same read, through a
// local.
// Marking it would refuse the SOURCE holder's reclaim, and a share needs both
// ends alive to balance, so the read drops out and the holder is still walked.
//
// Admitting it needs one thing the inline position gets for free: proof that
// the local reaches nothing but that store. `tt` is a plain local, so the field
// scan sees none of its uses, and an unchecked bind would let `return tt[0]`
// outlive the holder's deep free. strarr_unsafe_for_alias is that proof, and
// it is the classifier the local "SARR:" credit already uses for the identical
// question: its `sfld_ok` carve-out forgives the struct-literal store, while
// every other use of `tt` — an element bind, a return, a call argument, an
// append, a slice, an iteration — stays a hazard.
//
// `borrowable` is empty rather than the real registry, which is not built at
// admission time: it can only refuse a call-argument borrow, never grant one.
function strarrfld_bind_read(v: ast.StmtVar, stmts: ast.Stmt[], structs: parser.StructDecl[], binds: string[], str_fresh: string[]): ast.Expr {
    if (v.type_name != "string[]") { return v.init; }
    match (v.init) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(_) => {
                    var oty: string = fnfld_obj_type(fa.obj, structs, binds);
                    if (oty.len() == 0 || decl_field_type(structs, oty, fa.field) != "string[]") { return v.init; }
                    var sfld_ok: string[] = strarrfld_share_bind_stores(stmts, v.name, structs);
                    if (sfld_ok.len() == 0) { return v.init; }
                    var no_alias: string[] = [];
                    var no_borrow: string[] = [];
                    var no_producers: string[] = [];
                    if (strarr_unsafe_for_alias(stmts, v.name, no_borrow, str_fresh, no_producers, no_alias, sfld_ok)) { return v.init; }
                    return fa.obj;
                },
                _ => { return v.init; }
            }
        },
        _ => { return v.init; }
    }
    return v.init;
}

function strarrfld_scan_stmts(stmts: ast.Stmt[], structs: parser.StructDecl[], binds: string[], str_fresh: string[], strarr_producers: string[], forwarders: string[], fwd_exempt: string, acc: string[]): string[] {
    var a: string[] = acc;
    var b: string[] = binds;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                a = strarrfld_scan(strarrfld_bind_read(v, stmts, structs, b, str_fresh), structs, b, str_fresh, strarr_producers, forwarders, a);
                // `var r: R = …` binds by annotation, `var r = R { … }` by the
                // literal; anything else drops the name, so a shadowing rebind
                // never inherits the old type. Same rule as fnfld_read_stmts.
                var vty: string = v.type_name;
                if (vty.len() == 0) { vty = fnfld_lit_type(v.init); }
                b = fnfld_bind(b, v.name, vty, structs);
            },
            ast.StmtAssign(as2) => { a = strarrfld_scan(as2.value, structs, b, str_fresh, strarr_producers, forwarders, a); },
            ast.StmtExpr(ex) => { a = strarrfld_scan(ex.value, structs, b, str_fresh, strarr_producers, forwarders, a); },
            ast.StmtReturn(r) => {
                // A forwarder's own forwarding return: handing the field out is
                // its contract, and its CALL sites carry the verdict. Marking
                // it here refused the type program-wide on the declaration
                // alone, called or not (#7417).
                if (!strarrfld_ret_is_fwd(r.value, structs, b, fwd_exempt)) {
                    a = strarrfld_scan(r.value, structs, b, str_fresh, strarr_producers, forwarders, a);
                }
            },
            ast.StmtIf(iff) => {
                a = strarrfld_scan(iff.cond, structs, b, str_fresh, strarr_producers, forwarders, a);
                a = strarrfld_scan_stmts(iff.then_body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
                a = strarrfld_scan_stmts(iff.else_body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
            },
            ast.StmtWhile(w) => {
                a = strarrfld_scan(w.cond, structs, b, str_fresh, strarr_producers, forwarders, a);
                a = strarrfld_scan_stmts(w.body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
            },
            ast.StmtFor(fo) => {
                a = strarrfld_scan(fo.iter, structs, b, str_fresh, strarr_producers, forwarders, a);
                a = strarrfld_scan_stmts(fo.body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
            },
            ast.StmtMatch(m) => {
                a = strarrfld_scan(m.scrutinee, structs, b, str_fresh, strarr_producers, forwarders, a);
                for arm in m.arms {
                    if (arm.has_guard) { a = strarrfld_scan(arm.guard, structs, b, str_fresh, strarr_producers, forwarders, a); }
                    a = strarrfld_scan_stmts(arm.body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
                }
            },
            ast.StmtDefer(d) => { a = strarrfld_scan_stmts([d.action], structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a); },
            _ => {}
        }
    }
    return a;
}

// fn_has_param_named: `fn` takes a parameter (or receiver) spelled `name`.
function fn_has_param_named(fn: parser.FuncDecl, name: string): boolean {
    if (fn.receiver_name == name) { return true; }
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (fn.params[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

// strarrfld_fn_binds seeds the scan's type bindings for one function: its
// receiver and every parameter, so `b.notes[0]` inside a method resolves to
// "<Recv>.notes" instead of poisoning the bare name everywhere.
function strarrfld_fn_binds(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    var b: string[] = [];
    if (fn.receiver_name.len() > 0) {
        b = fnfld_bind(b, fn.receiver_name, util.base_type_name(fn.receiver_type), structs);
    }
    var i: i32 = 0;
    while (i < fn.params.len()) {
        b = fnfld_bind(b, fn.params[i].name, fn.params[i].type_name, structs);
        i = i + 1;
    }
    return b;
}

// tuple_elem_tags parses a tuple type string `(t0, t1, …)` into its element
// type spellings joined by commas ("i32,string,Point"), splitting on top-level
// commas only (nested brackets/parens don't count) and trimming spaces. Each
// spelling drops straight into local_tuple_elems, where "string" selects string
// dispatch, a struct name selects field access, and anything else is scalar.
pub function tuple_elem_tags(rt: string): string {
    if (rt.len() < 2 || rt[0] != b'(') { return ""; }
    var inner: str = slice_unchecked(rt, 1, rt.len() - 1);
    var out: string = "";
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    var first: boolean = true;
    while (i <= inner.len()) {
        if (i == inner.len() || (inner[i] == b',' && depth == 0)) {
            var seg: str = slice_unchecked(inner, start, i);
            if (seg.len() > 0 && seg[0] == b' ') { seg = slice_unchecked(seg, 1, seg.len()); }
            if (seg.len() > 0 && seg[seg.len() - 1] == b' ') { seg = slice_unchecked(seg, 0, seg.len() - 1); }
            if (!first) { out = out + ","; }
            // A declared fn-typed element holds a closure BOX at runtime — the
            // lift pass wraps every fn-valued tuple element (lambda or bare fn
            // name) into a `__mkclo$…` env box — so tag it "clo" for the
            // env-first `t.N(args)` dispatch, matching elem_type_tag's
            // literal-side classification.
            //
            // The element carries its SIGNATURE (#7961), so the arrow form is
            // what a segment holds; the bare tag still reaches here from a
            // substituted type parameter. Same question, same answer, and the
            // same predicate tuple_type_elem_tag asks.
            if (seg == "fn" || parser.ref_is_fn_value(parser.parse_type_ref(seg + ""))) { out = out + "clo"; }
            else { out = out + seg; }
            first = false;
            start = i + 1;
        } else if (inner[i] == b'[' || inner[i] == b'(') { depth = depth + 1; }
        else if (inner[i] == b']' || inner[i] == b')') { depth = depth - 1; }
        i = i + 1;
    }
    return out;
}

// tuple_elems_lowerable reports whether every element of tuple type `rt` is a
// scalar (i32 / bool), a string, a leaf-safe struct, an Option[T], or a NESTED
// tuple of lowerable elements — the set lower_func can return as a tuple box. A
// leaf-safe struct / Option / nested-tuple element is a leak-only pointer (no
// RC), recovered at the call site by its type tag, like the struct-return path.
// Array / i64-array / Result elements still make it false so the function bails
// (they'd need RC / width / payload threading).
pub function tuple_elems_lowerable(rt: string, structs: parser.StructDecl[]): boolean {
    var tags: string = tuple_elem_tags(rt);
    if (tags.len() == 0) { return false; }
    // Depth-aware split: a nested-tuple element tag `(i32,i32)` carries internal
    // commas, so only top-level commas (depth 0) separate elements.
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= tags.len()) {
        if (i == tags.len() || (depth == 0 && tags[i] == b',')) {
            var t: str = slice_unchecked(tags, start, i);
            // The ≤32-bit integer scalars (u32 + the sub-word u8) ride
            // one i32 slot exactly like i32 — a sub-word cast wraps the value BEFORE
            // the tuple store, and construction/access need no width plumbing
            // (verified round-trip on x86-64 + wasm). u64
            // rides the i64 8-byte slot: construction already tags it "i64"
            // (elem_type_tag's infer_expr_width==64 path), and the `.N` / destructure
            // reads route a "u64" type-annotation tag through tuple_get_w(64) below.
            // f32 / usize are NOT here: they need float / pointer-width handling.
            var ok_elem: boolean = (t == "i32" || t == "bool" || t == "boolean" || t == "u32" || t == "u8" || t == "string" || t == "i64" || t == "u64" || t == "f64" || t == "f32" || t == "float");
            // A closure-box element ("clo" — a declared fn-typed element,
            // mapped by tuple_elem_tags) is a leak-only heap box in one
            // pointer slot, like a struct element: construction stores the
            // box pointer (the lift pass built it), `t.N(args)` dispatches
            // env-first off the tag, and a `.N` bind marks a closure local.
            if (!ok_elem && t == "clo") { ok_elem = true; }
            if (!ok_elem && decl_is_struct(structs, t) && decl_is_leaksafe(structs, t)) { ok_elem = true; }
            // A nominal-enum element (Color, Expr, …) is a leak-only box — one
            // pointer slot, like a string / struct / Option element — so a tuple
            // carrying it lowers: construction stores the box pointer, `.N` /
            // destructure read it back and carry the enum name (mark_struct_type)
            // so `match (t.N)` / `t.N.method()` dispatch. The IR exit sweep never
            // frees an enum box (leak mode), so the borrowed-from-tuple box can't
            // double-free. is_enum_like_name can over-match a bare nominal, but the
            // only consequence is the construction site bailing via calls_only_known
            // (never a miscompile).
            if (!ok_elem && is_enum_like_name(t, structs)) { ok_elem = true; }
            // An Option[T] element is a leak-only box — one pointer slot, like a
            // string / struct element — so a tuple-returning fn can return it
            // (the ExprTuple construction admits it too). Only a comma-free tag
            // matches here: a `Result[T, E]` tag has an internal comma this
            // split sees as a top-level separator, so it stays deferred.
            if (!ok_elem && t.len() >= 8 && slice_unchecked(t, 0, 7) == "Option[") { ok_elem = true; }
            // A Result[T, E] element is a leak-only box too (one pointer slot);
            // its internal comma is bracketed, so the depth-aware split above
            // keeps the tag whole. `match (t.N)` recovers both payloads via
            // opt_payload_type. (#3018 deferred this only because the old split
            // was comma-naive.)
            if (!ok_elem && t.len() >= 8 && slice_unchecked(t, 0, 7) == "Result[") { ok_elem = true; }
            // A 4-byte scalar-array element (i32[] / boolean[] / u32[], plus the
            // sub-word u8[] which rides the SAME i32[] 4-byte-slot
            // representation) is a leak-only heap pointer stored in one tuple slot
            // — exactly like a string / struct element — so `.N` reads it via
            // op_tuple_get and the bind marks the slot an array (mark_arr), after
            // which `t.N[i]` rides the 4-byte arr_get.
            if (!ok_elem && (t == "i32[]" || t == "boolean[]" || t == "u32[]" || is_subword_array_type(t))) { ok_elem = true; }
            // The 8-byte-element arrays (f64[]/i64[]) and string[] are ALSO just a
            // heap pointer in the tuple slot — the element WIDTH/kind only matters
            // when reading an element (`t.N[i]`), not the tuple slot itself. The
            // destructure / `.N` bind marks the slot f64arr / i64arr / strarr so
            // `t.N[i]` rides the width-marked arr_get(64) / arr_get_i64 / str read.
            // (u64[] stays deferred: it needs the "u64[]" field-tag plumbing, like
            // the u64 tuple scalar, a separate increment.)
            if (!ok_elem && (is_float_array_type_name(t) || t == "i64[]" || t == "string[]")) { ok_elem = true; }
            // A struct-array (X[]) or enum-array (E[]) element is a heap pointer in
            // one tuple slot, like any other array element — leak mode: the buffer
            // AND its struct/enum-box elements leak with the (leak-only) tuple, so
            // no per-element RC. Construction stores the buffer pointer (admitted
            // via el_arr_ok — a struct-array source is an arr_src); the `.N` /
            // destructure read binds the slot mark_arr + the element struct/enum
            // name (mark_struct_type) so `t.N[i].field` / `match (t.N[i])` resolve
            // the element shape — exactly the struct-array field-read bind (#3292).
            if (!ok_elem && (is_struct_array_field_type(structs, t) || is_enum_array_field_type(structs, t))) { ok_elem = true; }
            // A Map[K, V] element is a leak-only heap box in one pointer slot, like
            // a struct / array element — so a tuple-returning fn can return it (the
            // `(Map, V)` shape of Map.get_or_insert / Map.without). Construction
            // already admits it (el_map_ok); the destructure read binds the slot
            // mark_map_type (the is_map_type_name case below) so `t.N.get(…)` /
            // `t.N.len()` dispatch as map ops. The depth-aware split keeps the
            // Map[K, V] tag whole (its internal comma is bracketed).
            if (!ok_elem && is_map_type_name(t)) { ok_elem = true; }
            // A NESTED tuple element `(…)` is itself a leak-only heap-tuple
            // pointer; admit it iff its own elements are all lowerable (recursion
            // bails on an inner array, matching the construction guard).
            if (!ok_elem && util.is_tuple_type_name(t)) { ok_elem = tuple_elems_lowerable(t, structs); }
            if (!ok_elem) { return false; }
            start = i + 1;
        } else if (tags[i] == b'[' || tags[i] == b'(') { depth = depth + 1; }
        else if (tags[i] == b']' || tags[i] == b')') { depth = depth - 1; }
        i = i + 1;
    }
    return true;
}

// irl_looks_type_var: a bare generic type variable spelling — a single
// uppercase letter (K / V / T / …). Mirrors parser.looks_type_var (private
// there). The self-host ERASES unbounded type params (they never reach
// monomorphize_module's clone worklist), so an erased-generic fn's tuple
// return keeps its type-var spellings ("(K, V)") and the registry tag would
// otherwise degrade the element to a scalar at every call site.
// fn_has_param_typed reports whether `fd` declares a parameter spelled exactly
// `ty`. Used to recognise an ERASED generic from its signature: an unbounded
// type param is stripped from `type_params`, so a bare-`T` return is only
// distinguishable from a same-named enum by the binding site of the var.
function fn_has_param_typed(fd: parser.FuncDecl, ty: string): boolean {
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (fd.params[i].type_name == ty) { return true; }
        i = i + 1;
    }
    return false;
}

function irl_looks_type_var(s: string): boolean {
    if (s.len() != 1) { return false; }
    var c: i32 = s[0] as i32;
    return c >= 65 && c <= 90;
}

// tuple_ret_fns_of records "name|<elem tags>" for each function whose return
// type is a tuple, so a call site can recover the element types for `.N` /
// destructure dispatch. Free functions are keyed by bare name, methods by the
// qualified "<BaseType>.<method>" label (no "." collision between the two).
//
// An ERASED-generic fn (`pair[K, V](k: K, v: V): (K, V)` — unbounded type
// params are stripped by the parser, so mono never clones it) gets each
// type-var ret segment rewritten to a positional "$arg<i>" reference naming
// the first PARAM declared with that type var. The call site substitutes the
// actual argument's inferred tag (resolve_argref_tuple_tags), so
// `pair("xy", 3)` types element 0 "string" — before, the raw "K" tag read as
// a scalar and `s.0.len()` on the returned string silently miscompiled to 0
// on BOTH the IR path and the legacy AST emitters.
// arrtup_ret_fns_of records "name|(elem tuple)" for each function returning an
// ARRAY OF TUPLES (`mk(): (i32, f64)[]`), keyed like tuple_ret_fns_of — bare
// name for a free function, "<BaseType>.<method>" for a method.
//
// The value is the ELEMENT TUPLE's spelling with the "[]" stripped, i.e. exactly
// what an array slot's arrarr_elem holds, so the binding site can transfer it
// onto the slot verbatim.
//
// Only a CONCRETE element tuple is recorded. A generic `(i32, T)[]` return would
// put a type var in the slot tag, and every consumer treats a tag as a resolved
// type — the call site's own instantiation is the checker's job (#6299), not
// something to approximate here.
pub function arrtup_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rt: string = fn.ret_type;
        if (rt.len() >= 5 && rt[0] == b'(' && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]") {
            var elem: str = slice_unchecked(rt, 0, rt.len() - 2);
            if (elem.len() >= 2 && elem[elem.len() - 1] == b')' && !irl_type_has_var(elem)) {
                var key: string = fn.name;
                if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
                out = out.append(key + "|" + elem);
            }
        }
    }
    return out;
}

// irl_type_has_var reports whether a type spelling contains a bare type VARIABLE
// segment — the `irl_looks_type_var` convention tuple_ret_fns_of already keys on,
// applied across a tuple's comma-separated segments.
function irl_type_has_var(ty: string): boolean {
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    var inner: string = ty;
    if (inner.len() >= 2 && inner[0] == b'(') { inner = slice_unchecked(inner, 1, inner.len() - 1) + ""; }
    while (i <= inner.len()) {
        if (i == inner.len() || (inner[i] == b',' && depth == 0)) {
            var seg: str = slice_unchecked(inner, start, i);
            if (seg.len() > 0 && seg[0] == b' ') { seg = slice_unchecked(seg, 1, seg.len()); }
            if (irl_looks_type_var(seg)) { return true; }
            start = i + 1;
        } else {
            if (inner[i] == b'(' || inner[i] == b'[') { depth = depth + 1; }
            if (inner[i] == b')' || inner[i] == b']') { depth = depth - 1; }
        }
        i = i + 1;
    }
    return false;
}

// arrtup_ret_type returns the ELEMENT TUPLE spelling of an array-of-tuples
// returning function `name`, or "" if it isn't one.
pub function (s: LowerState) arrtup_ret_type(name: string): string {
    return sig_reg_value_of(s.sigs.arrtup_ret_fns, name);
}

pub function tuple_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rt: string = fn.ret_type;
        if (rt.len() > 0 && rt[0] == b'(') {
            // Free function → bare name; method → qualified "<BaseType>.<method>"
            // (matching the call_direct dispatch label; no "." collision).
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            var tags: string = tuple_elem_tags(rt);
            // Rewrite bare type-var segments to "$arg<i>" param references
            // (top-level split; a nested "(…)" segment is left whole).
            var rw: string = "";
            var depth: i32 = 0;
            var start: i32 = 0;
            var ti: i32 = 0;
            var first: boolean = true;
            while (ti <= tags.len()) {
                if (ti == tags.len() || (tags[ti] == b',' && depth == 0)) {
                    var seg: str = slice_unchecked(tags, start, ti);
                    if (!first) { rw = rw + ","; }
                    var repl: string = seg + "";
                    if (irl_looks_type_var(seg)) {
                        var pi: i32 = 0;
                        while (pi < fn.params.len()) {
                            if (fn.params[pi].type_name == seg) { repl = "$arg" + util.i32_to_string(pi); pi = fn.params.len(); }
                            else { pi = pi + 1; }
                        }
                    }
                    rw = rw + repl;
                    first = false;
                    start = ti + 1;
                } else if (tags[ti] == b'[' || tags[ti] == b'(') { depth = depth + 1; }
                else if (tags[ti] == b']' || tags[ti] == b')') { depth = depth - 1; }
                ti = ti + 1;
            }
            out = out.append(key + "|" + rw);
        }
    }
    return out;
}

// resolve_argref_tuple_tags substitutes each "$arg<i>" segment of a
// tuple-ret tag list with the CALL SITE's argument-i inferred tag
// (elem_type_tag — "string" for a string arg, a struct/Option/Map/nested
// tag where inferable, "i32" otherwise). Non-reference segments pass
// through. Safe fallback: an out-of-range reference degrades to "i32",
// the same scalar reading the raw type-var tag produced before.
pub function resolve_argref_tuple_tags(tags: string, args: ast.Expr[], s: LowerState): string {
    if (!util.contains(tags, "$arg")) { return tags; }
    var out: string = "";
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    var first: boolean = true;
    while (i <= tags.len()) {
        if (i == tags.len() || (tags[i] == b',' && depth == 0)) {
            var seg: str = slice_unchecked(tags, start, i);
            if (!first) { out = out + ","; }
            if (seg.len() > 4 && slice_unchecked(seg, 0, 4) == "$arg") {
                var an: i32 = util.digits_to_i32(slice_unchecked(seg, 4, seg.len()));
                if (an >= 0 && an < args.len()) { out = out + elem_type_tag(args[an], s); }
                else { out = out + "i32"; }
            } else {
                out = out + seg;
            }
            first = false;
            start = i + 1;
        } else if (tags[i] == b'[' || tags[i] == b'(') { depth = depth + 1; }
        else if (tags[i] == b']' || tags[i] == b')') { depth = depth - 1; }
        i = i + 1;
    }
    return out;
}

// struct_ret_fns_of records "name|StructType" for each free function whose
// return type is a leaf-safe struct OR an ENUM, so a call site can type
// `var p = f()` for later field access / `match`, and an associated call
// `Type.f()` (struct or enum) is recognised by its registered return type.
// Free functions are keyed by bare name; methods by the qualified
// "<BaseType>.<method>" the call site dispatches to (a "." never appears in a
// bare name, so the key spaces don't collide). An enum return is a leak-only
// variant box (its variants are leaf-safe structs); is_enum_like_name can
// over-match a non-enum bare nominal, but a spurious entry only risks an AST
// fallback at a call site (never a miscompile) — the stage-2 fixpoint guards it.
// fn_inferred_struct_ret infers a function's leaf-safe STRUCT return type from
// its body when the declaration carries no real ret_type — the shape an if-/
// match-EXPRESSION desugar produces once lift_lambdas hoists it to a top-level
// `__lam_N` (default `i32` ret_type, real struct result in the body; the IIFE
// callee becomes a bare fn name, so the value position is a plain `__lam_N()`
// call whose result type must come from the body). The leaf returned value
// (iife_first_return_expr sees through nested if/match) must be a struct LITERAL
// of a leak-safe struct. Returns "" otherwise, so an annotated function (rt
// already set) or a non-struct body is unaffected. (An enum-valued if-/match-
// expression is NOT lifted — its variant constructors read as captures — so it
// stays an inline IIFE recovered via expr_enum_type, not here.)
function fn_inferred_struct_ret(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[], depth: i32): string {
    if (depth > 8) { return ""; }
    if (fn.body.len() == 0) { return ""; }
    var re: ast.Expr = iife_first_return_expr(fn.body[fn.body.len() - 1]);
    match (re) {
        ast.ExprStructLit(sl) => {
            if (decl_is_struct(structs, sl.type_name) && decl_is_leaksafe(structs, sl.type_name)) { return sl.type_name; }
        },
        // The leaf return is a call. Two cases resolve the struct type from the
        // callee `cid`: (1) a struct-returning USER function (`if (c) { mk(5) }
        // else { mk(2) }` where `mk` returns `P`) — read its declared leaf-safe
        // struct ret_type directly; (2) a NESTED if-/match-expression branch,
        // itself lifted to another `__lam_M` (ret_type the default `i32`) — its
        // struct comes from ITS body, so recurse (bounded depth keeps a
        // pathological cycle finite).
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    for each_fn in funcs {
                        if (each_fn.name == cid.name) {
                            var crt: string = each_fn.ret_type;
                            if (decl_is_struct(structs, crt) && decl_is_leaksafe(structs, crt)) { return crt; }
                            if (cid.name.len() >= 6 && slice_unchecked(cid.name, 0, 6) == "__lam_") { return fn_inferred_struct_ret(each_fn, structs, funcs, depth + 1); }
                            return "";
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "";
}

pub function struct_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rt: string = fn.ret_type;
        var elig: boolean = false;
        var elem_t: string = rt;
        if (decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)) { elig = true; }
        // A bare type VARIABLE return (`id[T](x: T): T`) is not an enum, but
        // is_enum_like_name says it is — it rules out primitives, arrays,
        // bracketed generics and tuples, and a lone uppercase letter passes all
        // of those. Recording `id|T` then stamped the CALL SITE's slot "T", so a
        // later `v.to_string()` keyed `T.to_string` — a symbol nothing defines —
        // and bailed the module (#6441). Unrecorded, the slot falls through to
        // the scalar path and dispatches on the real type. The `T[]` sibling
        // below resolves its element against the actual argument instead; a bare
        // `T` has no element to resolve, and an annotated binding already
        // supplies the type.
        //
        // The type-var test alone is NOT enough to tell this from a real enum:
        // an `enum E` is a single uppercase letter too, and skipping it sent the
        // whole @derive(Default) enum family off the IR path. So require the
        // ERASED-GENERIC signature the `T[]` sibling already keys on — a free
        // function with a parameter declared at exactly that spelling. A derived
        // `E_default(): E` takes no `E`, so it still records.
        else if (is_enum_like_name(rt, structs)
                && !(irl_looks_type_var(rt) && fn.receiver_type.len() == 0
                     && fn_has_param_typed(fn, rt))) { elig = true; }
        // A lifted if-/match-EXPRESSION (`__lam_N`) carries a default `i32`
        // ret_type from the desugar, not the struct it actually returns — so
        // trust the BODY, not the declaration. Infer a leaf-safe struct return
        // so `var p = if (c) { P{..} } else { .. }` / `(if (c) { P{..} } else {
        // .. }).x` recover the struct type at the `__lam_N()` call site.
        else if (fn.name.len() >= 6 && slice_unchecked(fn.name, 0, 6) == "__lam_") {
            var inf: string = fn_inferred_struct_ret(fn, structs, funcs, 0);
            if (inf.len() > 0) { elig = true; elem_t = inf; }
            else {
                // A struct-ARRAY-valued lifted if-/match-expression (`var ps =
                // if (c) { [P{..}] } else { … }`): its leaf is a struct-array
                // literal, so record the ELEMENT struct type (the slot is is_arr
                // via array_ret_fns, so struct_type_of_slot reads as the element
                // for `ps[i].field`). The P[] sibling of the string[]/f64[] #3224
                // fixes.
                var aelem: string = lam_leaf_array_elem(fn, funcs, 0);
                if (aelem.len() > 0 && decl_is_struct(structs, aelem) && decl_is_leaksafe(structs, aelem)) { elig = true; elem_t = aelem; }
            }
        }
        // A struct-ARRAY return `P[]` (leaf-safe element): record the ELEMENT
        // struct type so a call site `var a = f()` (already is_arr via
        // arr_ret_fns) recovers `a[i]`'s struct type for field access / foreach.
        // The slot is an array, so struct_type_of_slot is read as the element
        // type (expr_struct_type reports "" for the array value itself). #3035.
        else if (rt.len() >= 3 && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]") {
            var et: str = slice_unchecked(rt, 0, rt.len() - 2);
            if (decl_is_struct(structs, et) && decl_is_leaksafe(structs, et)) { elig = true; elem_t = et + ""; }
            // A `dyn Trait[]` return (#4780): record the coarse "dyn <Trait>"
            // ELEMENT type, exactly as the dyn-array LITERAL binding and the
            // dyn-array PARAM do — the slot is already is_arr (arr_ret_fns
            // admits any `[]` return), but without this tag an unannotated
            // `var ys = mk()` lost the trait and `ys[i].m()` mis-dispatched.
            else if (et.len() > 4 && slice_unchecked(et, 0, 4) == "dyn ") { elig = true; elem_t = et + ""; }
            // An ERASED-generic `T[]` return (`idf[T](arr: T[]): T[]`, `sort_by_
            // i32_key[T](arr: T[], key: (T) => i32): T[]`): the element is the bare
            // typevar, so there is no declared struct to record and an UNANNOTATED
            // `var s = f(xs)` lost `s[i]`'s type — which bailed the caller while
            // the generic fn itself lowered fine. Record a
            // positional "name|$arg<i>" entry instead, meaning "the element type is
            // whatever argument i's element type is", and let expr_struct_type
            // resolve it against the ACTUAL argument at the call site. Same
            // convention (and same sig_reg_argref reader) as the erased string / array
            // returns above; the '|' keeps the entry invisible to the exact-name
            // membership scans. Free functions only — a receiver method is never an
            // erased generic — matching the string-side producer.
            else if (fn.receiver_type.len() == 0 && irl_looks_type_var(et + "")) {
                var api: i32 = 0;
                while (api < fn.params.len()) {
                    if (fn.params[api].type_name == rt) {
                        out = out.append(fn.name + "|$arg" + util.i32_to_string(api));
                        api = fn.params.len();
                    } else { api = api + 1; }
                }
            }
        }
        // A SCALAR `dyn Trait` return: record the coarse "dyn <Trait>" type so a
        // call site recovers the result as a `dyn` value — expr_struct_type's
        // ExprCall path then reports "dyn …" for `f()`, which (a) routes a later
        // `d.m()` through op_dyn_dispatch (runtime shape dispatch) and (b) keeps
        // lower_dyn_arg from RE-boxing an already-boxed dyn return (its
        // expr_recv_prim_type sees a non-empty struct type and returns ""). A
        // `dyn Trait[]` return is recorded by the array arm above (#4780), with
        // the coarse "dyn <Trait>" as its ELEMENT type.
        if (!elig && rt.len() > 4 && slice_unchecked(rt, 0, 4) == "dyn " && !(rt.len() >= 3 && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]")) { elig = true; elem_t = rt; }
        if (elig) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key + "|" + elem_t);
        }
    }
    return out;
}

// map_ret_fns_of records "name|Map[K,V]" for each function returning a Map, so
// an unannotated `var m = f()` recovers the slot's map type for method dispatch
// (the annotated `var m: Map[K,V] = f()` form already works). Free functions are
// keyed bare; methods by "<BaseType>.<method>". #3317.
pub function map_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        // `Map[K, V][]` prefix-matches is_map_type_name but returns an ARRAY, and
        // a caller that took this registration typed the un-bound `mk().len()`
        // receiver as a map — op_map_len over array memory.
        if (is_map_type_name(fn.ret_type) && !is_array_type_name(fn.ret_type)) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key + "|" + fn.ret_type);
        }
    }
    return out;
}

// i64_ret_fns_of records the i64 SIGNATURE of each function that has any i64 in
// its return or params, as "name|<ret><p0><p1>…" where each flag is '1' (i64)
// or '0'. The call site reads the ret flag (is the result i64?) and the param
// flags (must this arg be lowered as i64?). Functions with no i64 are omitted
// (their default is all-i32). The field name stays i64_ret_fns for continuity.
// f64_ret_fns_of collects the names of a module's f64-returning functions, so a
// call site recognises the result as an f64 value. Free functions are keyed by
// bare name; methods by the qualified "<BaseType>.<method>" the call site
// dispatches to (a "." never appears in a bare name, so the key spaces agree).
pub function f64_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (is_f64_scalar_type_name(fn.ret_type)) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
    }
    return out;
}
// f64arr_ret_fns_of collects the names of a module's f64[]-returning functions,
// so a call-site `var x = f()` element-width-tracks x as f64[]. Free functions
// are keyed by bare name; methods by the qualified "<BaseType>.<method>" the
// call site dispatches to (a "." never appears in a bare name, so the key spaces
// don't collide — same convention as f64_ret_fns_of).
pub function f64arr_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (is_float_array_type_name(fn.ret_type)) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
        // A lifted `__lam_` whose branch is an f64-array literal carries a
        // default i32 ret_type; register it so `(if (c) { [1.5] } else { … })[i]`
        // reads its 8-byte f64 elements at the right width (#3224, f64 sibling
        // of the string-array fix).
        else if (fn.name.len() >= 6 && slice_unchecked(fn.name, 0, 6) == "__lam_" && lam_leaf_array_elem(fn, funcs, 0) == "f64") { out = out.append(fn.name); }
    }
    return out;
}
// erased_elem_ret_fns_of collects the functions whose RETURN is an array of a
// bare typevar (`map[T, U](…): U[]`, `flat_map`), keyed like f64arr_ret_fns_of.
//
// Such a return's element width is not fixed by the callee at all — the fold
// comment on register_array_method_generics states the rule: an unbounded extra
// type variable is erased, and "its result-element width is driven by the CALL
// SITE's annotation, not by cloning the body". The callee is emitted once and
// strides that array at the i32 element width, which on wasm32 is a 4-byte
// stride through what an `i64[]` / `f64[]` destination then reads at 8 (#6287).
// The register backends are unaffected: their slots are 8 bytes either way.
//
// This is the RESULT-side sibling of the flag-'7' erased `T[]` PARAM registry.
// That one refuses a wide-element array going IN; a wide element can equally
// arrive by coming back OUT, which nothing looked at — and unlike the param
// case it was not a refusal but a silently wrong value.
pub function erased_elem_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (is_erased_typevar_array(fn.ret_type, structs)) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
    }
    return out;
}

// i64arr_ret_fns_of collects the names of a module's i64[]-returning functions,
// so a call-site `var x = f()` element-types x as i64[]. Methods are keyed by the
// qualified "<BaseType>.<method>" (see f64arr_ret_fns_of).
pub function i64arr_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type == "i64[]") {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
    }
    return out;
}
// fn_param_sigs_of records "name|<flags>" for each free function that has at
// least one function-typed ("fn") param — flag i is '1' iff param i is "fn".
// Drives the type-directed function-value detection at call sites
// (callee_param_is_fn). Functions with no "fn" param are omitted (the lookup
// defaults to false). Methods are keyed "<Type>.<method>".
// closure_ret_fns_of returns the names of functions whose body's last statement
// is `return <capturing lambda>` — they produce a closure BOX, so a caller's
// `var f = <call>` binds f as a closure local (closures slice 3a).
// const_fns_of collects the names of zero-arg, receiver-less module functions
// (a `const NAME = expr` desugars to exactly one — see parser.parse_const_decl).
// A bare ident reference to one, in value position, lowers to a CALL (the
// const's value); the LowerState carries this so lower_expr's ExprIdent arm can
// dispatch it instead of bailing the module (#2954). The rule is zero-arg
// receiver-less -> call; >0-arg -> fn-value.
pub function const_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() == 0 && fn.params.len() == 0) {
            out = out.append(fn.name);
        }
    }
    return out;
}

// fn_names_of records the name of every FREE function in the module (receiver
// methods can't collide with a bare-ident call). It's the registry that lets a
// bare-ident call `foo(args)` be recognised as a user function so the same-named
// builtin intercepts (`len` / `exit` / `chr` / …) are skipped — matching native
// + interp, which resolve `foo(args)` to the user function when one exists
// (#3710).
pub function fn_names_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() == 0) {
            out = out.append(fn.name);
        }
    }
    return out;
}

// fn_sig_index records every declared function's parameter count under the
// name a `call_direct` op spells it with — `<BaseType>.<method>` for a
// receiver method, the bare name otherwise, the same key lower_module stores an
// ir.LoweredFn under. It is what lets the IR verifier's call-arity check and its
// callee-resolution pass look a callee up without scanning the declaration
// list per call op.
//
// The arity counts the receiver, because lower_func does: the receiver is
// param slot 0 of a method, and the call site pushes it as the first argument.
// DECLARED functions, not lowered ones — a function whose lowering bailed and
// a generic monomorphised under another name are both absent from the lowered
// set while being perfectly well declared.
pub function fn_sig_index(funcs: parser.FuncDecl[]): irverify.NameIndex {
    var sigs: irverify.FnSig[] = [];
    for fn in funcs {
        var nm: string = fn.name;
        if (fn.receiver_type.len() > 0) {
            nm = util.base_type_name(fn.receiver_type) + "." + fn.name;
        }
        var np: i32 = fn.params.len();
        if (fn.receiver_name.len() > 0) { np = np + 1; }
        sigs = sigs.append(irverify.FnSig { name: nm, n_params: np });
    }
    return irverify.sig_index(sigs);
}

// is_user_fn reports whether `name` is a free function declared in this module
// (a member of the fn_names registry) — i.e. a bare `name(args)` call resolves
// to it, shadowing any same-named builtin.
pub function (s: LowerState) is_user_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.fn_names, name);
}

// body_binds_closure_local reports whether `body` binds local `name` (via a
// top-level `var name = …`) to a CLOSURE BOX: a lambda (always boxed at its
// binding, capturing or not — see the clo_init rule in the StmtVar lowering),
// a `__mkclo$…` env-box constructor, or a call to a function already known to
// return a closure box (`closureset`). Used by closure_ret_fns_of to detect a
// factory whose last statement is `return name`, so the caller's `var g =
// factory()` binds g a closure local and `g(args)` dispatches env-first
// instead of calling the raw box pointer as code (a SIGSEGV otherwise).
function body_binds_closure_local(body: ast.Stmt[], name: string, closureset: string[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprLambda(_) => { return true; },
                        ast.ExprCall(cc) => {
                            match (cc.callee) {
                                ast.ExprIdent(cid) => {
                                    if (cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") { return true; }
                                    if (util.index_of_str(closureset, cid.name) >= 0) { return true; }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            // A binding inside a nested block (`if (…) { var f = <lambda>;
            // return f; }`) is in scope for the return in that same block, so
            // recurse. Over-approximates scoping (a shadowing same-name var in
            // a sibling branch also matches) but the fn-return-type gate on
            // every consumer keeps this to genuine closure factories.
            ast.StmtIf(bif) => {
                if (body_binds_closure_local(bif.then_body, name, closureset)) { return true; }
                if (body_binds_closure_local(bif.else_body, name, closureset)) { return true; }
            },
            ast.StmtWhile(bwh) => {
                if (body_binds_closure_local(bwh.body, name, closureset)) { return true; }
            },
            ast.StmtFor(bfr) => {
                if (body_binds_closure_local(bfr.body, name, closureset)) { return true; }
            },
            ast.StmtMatch(bmt) => {
                var bmi: i32 = 0;
                while (bmi < bmt.arms.len()) {
                    if (body_binds_closure_local(bmt.arms[bmi].body, name, closureset)) { return true; }
                    bmi = bmi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// collect_returns appends the value expression of EVERY `return` in `body` —
// including returns nested inside if/else branches, while/for loop bodies, and
// match arms — to `acc`. closure_ret_fns_of / closurearr_ret_fns_of use it so
// a factory that returns its closure from a BRANCH (`if (flag) { var f = …;
// return f; } else { … }`) is detected, not just one whose LAST statement is
// the return. Before this, a branch-returning factory left the caller's slot
// unmarked and `g(args)` bare-called the box pointer as code — SIGSEGV.
function collect_returns(body: ast.Stmt[], acc: ast.Expr[]): ast.Expr[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtReturn(r) => { acc = acc.append(r.value); },
            ast.StmtIf(cif) => {
                acc = collect_returns(cif.then_body, acc);
                acc = collect_returns(cif.else_body, acc);
            },
            ast.StmtWhile(cwh) => { acc = collect_returns(cwh.body, acc); },
            ast.StmtFor(cfr) => { acc = collect_returns(cfr.body, acc); },
            ast.StmtMatch(cmt) => {
                var cmi: i32 = 0;
                while (cmi < cmt.arms.len()) {
                    acc = collect_returns(cmt.arms[cmi].body, acc);
                    cmi = cmi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return acc;
}

// body_local_decl_type returns the DECLARED type annotation of local `name` in
// `body` (recursing into nested blocks), or "" if none / unannotated. The
// LowerState-free lookup the closure-return detector uses to resolve a local
// container's type (params resolve directly from FuncDecl.params).
function body_local_decl_type(body: ast.Stmt[], name: string): string {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(sv) => { if (sv.name == name && sv.type_name.len() > 0) { return sv.type_name; } },
            ast.StmtIf(bif) => {
                var t: string = body_local_decl_type(bif.then_body, name);
                if (t.len() > 0) { return t; }
                var e: string = body_local_decl_type(bif.else_body, name);
                if (e.len() > 0) { return e; }
            },
            ast.StmtWhile(bwh) => { var wt: string = body_local_decl_type(bwh.body, name); if (wt.len() > 0) { return wt; } },
            ast.StmtFor(bfr) => { var ft: string = body_local_decl_type(bfr.body, name); if (ft.len() > 0) { return ft; } },
            ast.StmtMatch(bmt) => {
                var mi: i32 = 0;
                while (mi < bmt.arms.len()) { var mt: string = body_local_decl_type(bmt.arms[mi].body, name); if (mt.len() > 0) { return mt; } mi = mi + 1; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return "";
}

// detector_expr_type resolves the coarse type spelling of container expr `e`
// within function `fn`, using only fn.params + local annotations + structs —
// the LowerState-free type view the closure-return detector has. Covers the
// shapes closure-return detection needs: an ident (param / annotated local), an
// array index (element type = strip trailing "[]"), and a struct-field access.
// Returns "" when unknown.
function detector_expr_type(e: ast.Expr, fn: parser.FuncDecl, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprIdent(id) => {
            var pi: i32 = 0;
            while (pi < fn.params.len()) {
                if (fn.params[pi].name == id.name) { return fn.params[pi].type_name; }
                pi = pi + 1;
            }
            var bt: string = body_local_decl_type(fn.body, id.name);
            if (bt.len() > 0) { return bt; }
            // typed-IR (#5986): an unannotated local (or the receiver, which
            // the param loop never sees) answers from the checker's stamp.
            return id.ty;
        },
        ast.ExprIndex(ix) => {
            var at: string = detector_expr_type(ix.array, fn, structs);
            if (at.len() >= 2 && slice_unchecked(at, at.len() - 2, at.len()) == "[]") { return slice_unchecked(at, 0, at.len() - 2) + ""; }
            // The stamped tag carries the ELEMENT type directly (#5986).
            return ix.ty;
        },
        ast.ExprFieldAccess(fa) => {
            var ot: string = detector_expr_type(fa.obj, fn, structs);
            if (ot.len() > 0) {
                var dft: string = decl_field_type(structs, ot, fa.field);
                if (dft.len() > 0) { return dft; }
            }
            return fa.ty;
        },
        // A call-valued object in a return chain (`mk(41).hs[0]`) — no walk
        // exists at lift time; the stamp carries the callee's result (#5986).
        ast.ExprCall(c) => { return c.ty; },
        _ => { return ""; }
    }
}

// variant_payload_field_type resolves the payload FIELD TYPE bound by `name` in a
// PatVariant arm (`__ev` for the main binding, `__ev<k+1>` for the k-th extra),
// using only `structs` — the LowerState-free view the closure-return detector has.
// An enum variant desugars to a struct named after the variant carrying its payload
// as field `__ev`; a qualified `Enum.Variant` spelling strips to the bare variant.
// "" when `name` doesn't bind a payload of this variant. Structs-only sibling of
// iife_variant_payload_field.
function variant_payload_field_type(pv: ast.PatVariant, name: string, structs: parser.StructDecl[]): string {
    var vname: string = pv.type_name;
    var vld: i32 = 0;
    while (vld < pv.type_name.len()) {
        if (pv.type_name[vld] == b'.') { vname = slice_unchecked(pv.type_name, vld + 1, pv.type_name.len()) + ""; }
        vld = vld + 1;
    }
    if (!decl_is_struct(structs, vname)) { return ""; }
    if (pv.binding.len() > 0 && pv.binding != "_" && pv.binding == name) { return decl_field_type(structs, vname, "__ev"); }
    var k: i32 = 0;
    while (k < pv.extra_bindings.len()) {
        var eb: string = pv.extra_bindings[k];
        if (eb.len() > 0 && eb != "_" && eb == name) { return decl_field_type(structs, vname, "__ev" + util.i32_to_string(k + 1)); }
        k = k + 1;
    }
    return "";
}

// body_binds_fn_payload_via_match reports whether `body` binds local `name` via a
// MATCH-ARM pattern `V(name)` whose enum variant payload is fn-typed (a `() => …`
// field, coarsened to "fn"). #5202 case D: `match (b) { W(f) => { return f; } }`
// returns a closure BOX the caller must dispatch env-first — but the binding is a
// match arm, not a `var f = …`, so body_binds_closure_local (var-bindings only)
// misses it. Recurses into nested if/while/for/match blocks, mirroring the
// over-approximate scoping of body_binds_closure_local (the fn-return-type gate on
// the sole caller keeps it to genuine higher-order factories).
function body_binds_fn_payload_via_match(body: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtMatch(bmt) => {
                var ai: i32 = 0;
                while (ai < bmt.arms.len()) {
                    match (bmt.arms[ai].pattern) {
                        ast.PatVariant(pv) => {
                            if (variant_payload_field_type(pv, name, structs) == "fn") { return true; }
                        },
                        _ => {}
                    }
                    if (body_binds_fn_payload_via_match(bmt.arms[ai].body, name, structs)) { return true; }
                    ai = ai + 1;
                }
            },
            ast.StmtIf(bif) => {
                if (body_binds_fn_payload_via_match(bif.then_body, name, structs)) { return true; }
                if (body_binds_fn_payload_via_match(bif.else_body, name, structs)) { return true; }
            },
            ast.StmtWhile(bwh) => { if (body_binds_fn_payload_via_match(bwh.body, name, structs)) { return true; } },
            ast.StmtFor(bfr) => { if (body_binds_fn_payload_via_match(bfr.body, name, structs)) { return true; } },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

pub function closure_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var gfns: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() == 0) { gfns = gfns.append(fn.name); }
    }
    // Indexed once for the whole pass: gfns_visible_in asks whether any of this
    // frame's binders shadows a module function, and the list is fixed here.
    let (ghead, gnext) = gfn_index_of(gfns);
    var out: string[] = [];
    // Two forms produce a closure box the caller must dispatch env-first:
    //   (a) `return <capturing lambda>` — a fresh box built at the return.
    //   (b) `return <ident>` where the ident is a top-level local bound to a
    //       closure box (a lambda, `__mkclo$`, or a closure-returning call) —
    //       e.g. `var f = function (b) { … }; return f;`. Form (b) is gated on
    //       a declared `fn` return type so it only fires for genuine
    //       higher-order factories, never the compiler's own no-fn-return
    //       sources — keeping the self-compile fixpoint byte-identical. The
    //       fixpoint loop resolves (b)'s transitive `var f = other_factory()`
    //       chains.
    var changed: boolean = true;
    while (changed) {
        changed = false;
        for fn in funcs {
            if (util.index_of_str(out, fn.name) < 0) {
                var b: ast.Stmt[] = fn.body;
                // With a declared fn return type, check EVERY return in the
                // body (branch / loop / match-arm returns included — see
                // collect_returns); without one, only the last-statement
                // `return <capturing lambda>` form applies (below), keeping
                // the no-annotation behaviour untouched.
                if (fn.ret_type == "fn") {
                    var rets: ast.Expr[] = collect_returns(b, []);
                    var hit: boolean = false;
                    var ri: i32 = 0;
                    while (ri < rets.len()) {
                        match (rets[ri]) {
                            // Same filter as the lift's (#7253): a module-fn
                            // name this function shadows is a local here, so a
                            // lambda reading it IS capturing and this function
                            // DOES return a closure. Filtered only at a lambda
                            // return: the filter walks the body and the whole
                            // module-fn list, and this loop visits every
                            // function every round.
                            ast.ExprLambda(nlam) => {
                                if (!lambda_has_no_captures(nlam, gfns_visible_in(fn, gfns, ghead, gnext))) { hit = true; }
                            },
                            ast.ExprIdent(nrid) => {
                                if (body_binds_closure_local(b, nrid.name, out)) { hit = true; }
                                // (d') `return f` where f is a MATCH-ARM binding to a
                                // fn-typed enum payload (`match (b) { W(f) => return f }`,
                                // #5202 case D) — the box the caller must dispatch env-first.
                                if (!hit && body_binds_fn_payload_via_match(b, nrid.name, structs)) { hit = true; }
                                // (b') `return p` where p is this function's own
                                // fn-typed PARAM. A fn-typed param is ALWAYS a box
                                // here — the lift pass routes every fn-value
                                // argument through try_fn_field_value ("there is
                                // one fn-arg shape, the box"), and lower_func
                                // already mark_closure_local's every "fn" param on
                                // the strength of that. So a declared-fn-returning
                                // function that returns one returns a box, and the
                                // caller's binding has to dispatch env-first.
                                //
                                // Reached by the #6324 hoist: it carries a captured
                                // fn-typed local into the hoisted function as a
                                // param, so the arm that read a local now reads a
                                // param and form (b) stopped matching. Without this
                                // the caller bare-called the box — a bail turned
                                // into a SIGSEGV.
                                if (!hit) {
                                    var pk: i32 = 0;
                                    while (pk < fn.params.len()) {
                                        if (fn.params[pk].name == nrid.name && fn.params[pk].type_name == "fn") { hit = true; }
                                        pk = pk + 1;
                                    }
                                }
                            },
                            // (c) `return <closure-returning call>` — a factory
                            // that forwards another factory's box, e.g.
                            // `return makeAdder();`. The callee is a top-level
                            // fn already known to return a closure box (`out`,
                            // resolved by the fixpoint) or an inline `__mkclo$`
                            // env-box constructor.
                            ast.ExprCall(nrcc) => {
                                match (nrcc.callee) {
                                    ast.ExprIdent(nrccid) => {
                                        if ((nrccid.name.len() > 8 && slice_unchecked(nrccid.name, 0, 8) == "__mkclo$") || util.index_of_str(out, nrccid.name) >= 0) { hit = true; }
                                    },
                                    _ => {}
                                }
                            },
                            // (d) `return hs[0]` — an ELEMENT of a closure ARRAY
                            // (a closure box). Register this fn closure-returning
                            // so the caller's `var g = pick()` binds g a closure
                            // local (env-first `g()`); without it g() bare-calls
                            // the box pointer and SIGSEGVs.
                            ast.ExprIndex(nix) => {
                                var arrok: boolean = false;
                                match (nix.array) {
                                    ast.ExprIdent(naid) => {
                                        if (body_binds_closurearr_local(b, naid.name, out, [])) { arrok = true; }
                                    },
                                    _ => {}
                                }
                                // (e) `return r.hs[0]` / `return fnarr[i]` — indexing a
                                // closure ARRAY that is a struct FIELD, a PARAM, or an
                                // annotated local (its type resolves to "fn[]"); the
                                // element is a closure box (#5202 B). Distinct from the
                                // unannotated-local-literal case above.
                                if (!arrok && detector_expr_type(nix.array, fn, structs) == "fn[]") { arrok = true; }
                                if (arrok) { hit = true; }
                            },
                            // (f) `return kvs[i].f` / `return s.f` — a fn-valued struct
                            // FIELD (a closure box). Resolve the object's struct type +
                            // the field type (#5202 E). A numeric tuple index resolves to
                            // "" (tuples aren't structs), so it can't misfire here.
                            ast.ExprFieldAccess(nfa) => {
                                var foty: string = detector_expr_type(nfa.obj, fn, structs);
                                if (foty.len() > 0 && decl_field_type(structs, foty, nfa.field) == "fn") { hit = true; }
                            },
                            _ => {}
                        }
                        ri = ri + 1;
                    }
                    if (hit) { out = out.append(fn.name); changed = true; }
                } else if (b.len() > 0) {
                    match (b[b.len() - 1]) {
                        ast.StmtReturn(r) => {
                            match (r.value) {
                                ast.ExprLambda(lam) => {
                                    if (!lambda_has_no_captures(lam, gfns_visible_in(fn, gfns, ghead, gnext))) { out = out.append(fn.name); changed = true; }
                                },
                                _ => { }
                            }
                        },
                        _ => { }
                    }
                }
            }
        }
    }
    // "PASSTHRU:<fn>:<argidx>" markers ride the same list — a marker can never
    // collide with a function name, so every membership consumer is unaffected,
    // and the classifiers that ask whether a CALL yields a closure box can
    // recognise the generic passthrough that forwards one (expr_is_closure_elem,
    // arr_elem_is_closure_box).
    var ptm: string[] = typevar_passthrough_markers_of(funcs);
    var pmi: i32 = 0;
    while (pmi < ptm.len()) { out = out.append(ptm[pmi]); pmi = pmi + 1; }
    return out;
}

// closure_and_fnptr_fns_of is the value threaded into a LowerState's closure_fns:
// the closure-box-returning function names (closure_ret_fns_of) PLUS the
// "FNPTR:<sty>.<field>" plain-fn-pointer-array field markers (fnptr_arr_fields_of).
// Both ride one list — a marker can never collide with a function name, so the
// existing closure_fns consumers (membership tests) are unaffected, and the read
// side's field_access_is_fnarr recovers the fn-pointer fields from it. Every
// lower_func / lower_module call site that used to pass closure_ret_fns_of(funcs)
// passes this instead (#5235).
pub function closure_and_fnptr_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = closure_ret_fns_of(funcs, structs);
    var fp: string[] = fnptr_arr_fields_of(funcs, structs);
    var i: i32 = 0;
    while (i < fp.len()) { out = out.append(fp[i]); i = i + 1; }
    // #5281: "RETCLO2:<fn>" markers for functions whose returned closure is
    // ITSELF closure-returning (a `() => (() => T)` factory). Ride the same list
    // as the FNPTR markers — a marker can't collide with a bare fn name, and the
    // membership consumers ignore it. `var g = pick()` reads this to mark g a
    // RETCLO local so a later `var h = g()` binds h a closure local (env-first).
    var rc: string[] = closure_ret_closure_fns_of(funcs, structs);
    var ri: i32 = 0;
    while (ri < rc.len()) { out = out.append("RETCLO2:" + rc[ri]); ri = ri + 1; }
    return out;
}

// typevar_passthrough_markers_of lists "PASSTHRU:<fn>:<argidx>" for every
// receiver-less generic function whose parameter at `argidx` is declared with
// its own return type — the lift-side lift_callee_is_typevar_passthrough test,
// carried to the read side, where the module funcs are no longer in scope.
function typevar_passthrough_markers_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() == 0 && fn.type_param_count > 0) {
            var p: i32 = 0;
            while (p < fn.params.len()) {
                if (fn.params[p].type_name.len() > 0 && fn.params[p].type_name == fn.ret_type) {
                    out = out.append("PASSTHRU:" + fn.name + ":" + util.i32_to_string(p));
                }
                p = p + 1;
            }
        }
    }
    return out;
}

// mkclo_funcval extracts the closure funcval name from a `__mkclo$<fv>` env-box
// constructor marker (`__mkclo$pick$clo0` -> `pick$clo0`), or "" if not one.
function mkclo_funcval(name: string): string {
    if (name.len() > 8 && slice_unchecked(name, 0, 8) == "__mkclo$") { return slice_unchecked(name, 8, name.len()) + ""; }
    return "";
}

// body_binding_mkclo_funcval returns the closure funcval `name` is bound to in
// `body` via a `var name = __mkclo$<fv>(caps)` binding (recursing into nested
// blocks), or "". This is the LIFTED-module shape of a captured lambda bound to a
// local — the form a returned closure takes after lift_lambdas hoists it.
function body_binding_mkclo_funcval(body: ast.Stmt[], name: string): string {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprCall(cc) => {
                            match (cc.callee) {
                                ast.ExprIdent(cid) => { var fv: string = mkclo_funcval(cid.name); if (fv.len() > 0) { return fv; } },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(bif) => {
                var t: string = body_binding_mkclo_funcval(bif.then_body, name); if (t.len() > 0) { return t; }
                var e: string = body_binding_mkclo_funcval(bif.else_body, name); if (e.len() > 0) { return e; }
            },
            ast.StmtWhile(bwh) => { var wt: string = body_binding_mkclo_funcval(bwh.body, name); if (wt.len() > 0) { return wt; } },
            ast.StmtFor(bfr) => { var ft: string = body_binding_mkclo_funcval(bfr.body, name); if (ft.len() > 0) { return ft; } },
            ast.StmtMatch(bmt) => {
                var mi: i32 = 0;
                while (mi < bmt.arms.len()) { var mt: string = body_binding_mkclo_funcval(bmt.arms[mi].body, name); if (mt.len() > 0) { return mt; } mi = mi + 1; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return "";
}

// closure_ret_closure_fns_of returns the names of module functions whose returned
// CLOSURE is itself closure-returning — a `() => (() => T)` two-level factory. Run on
// the LIFTED module (post lift_lambdas): the returned closure is a `__mkclo$<fv>` box
// whose funcval `fv` is another module function; the factory is RETCLO2 when that
// funcval is ITSELF closure-returning (a member of closureset = closure_ret_fns_of).
// A caller's `var g = pick()` reads this to mark g a RETCLO local so a later
// `var h = g()` binds h a closure local and `h()` dispatches env-first instead of
// bare-calling the inner box pointer (#5281 SIGSEGV).
pub function closure_ret_closure_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var closureset: string[] = closure_ret_fns_of(funcs, structs);
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type == "fn") {
            var rets: ast.Expr[] = collect_returns(fn.body, []);
            var hit: boolean = false;
            var ri: i32 = 0;
            while (ri < rets.len()) {
                var fv: string = "";
                match (rets[ri]) {
                    // `return $lamret` bound to `__mkclo$<fv>(caps)` (the lifted form).
                    ast.ExprIdent(rid) => { fv = body_binding_mkclo_funcval(fn.body, rid.name); },
                    // `return __mkclo$<fv>(caps)` directly.
                    ast.ExprCall(rcc) => {
                        match (rcc.callee) {
                            ast.ExprIdent(rcid) => { fv = mkclo_funcval(rcid.name); },
                            _ => {}
                        }
                    },
                    _ => {}
                }
                if (fv.len() > 0 && util.index_of_str(closureset, fv) >= 0) { hit = true; }
                ri = ri + 1;
            }
            if (hit) { out = out.append(fn.name); }
        }
    }
    return out;
}

// body_returns_closurearr reports whether `body` returns an ARRAY of closure
// boxes: a `return [<lambda>|<closure-call>, …]` literal, or a `return <ident>`
// where the ident is a top-level local bound to such a literal. Element 0 is
// the probe (a homogeneous closure-array literal, matching the is_closurearr
// var-binding rule). `closureset` is the set of closure-returning fns (so a
// `[mk(), …]` element counts). Used by closurearr_ret_fns_of.
// expr_is_closure_elem reports whether `e` is a closure VALUE — a lambda, a
// `__mkclo$` env-box construction, or a call to a closure-box-returning factory
// (closureset). A bare named fn is NOT a closure (it lowers to a plain fn
// pointer), so an array built only from those stays a fn-pointer array.
function expr_is_closure_elem(e: ast.Expr, closureset: string[]): boolean {
    match (e) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprCall(ec) => {
            match (ec.callee) {
                ast.ExprIdent(ecid) => {
                    if (ecid.name.len() > 8 && slice_unchecked(ecid.name, 0, 8) == "__mkclo$") { return true; }
                    if (util.index_of_str(closureset, ecid.name) >= 0) { return true; }
                    // A generic passthrough hands its argument back unchanged and
                    // the lift boxes a fn value at that parameter unconditionally,
                    // so the call yields a box. Without this the array holding it
                    // was not classified a closure array and the caller
                    // bare-dispatched a box: `fs[0](3)` SIGSEGV'd, no bail.
                    var pi: i32 = 0;
                    while (pi < ec.args.len()) {
                        if (util.index_of_str(closureset, "PASSTHRU:" + ecid.name + ":" + util.i32_to_string(pi)) >= 0
                                && expr_is_closure_elem(ec.args[pi], closureset)) { return true; }
                        pi = pi + 1;
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

function array_lit_is_closurearr(init: ast.Expr, closureset: string[]): boolean {
    match (init) {
        ast.ExprArray(a) => {
            if (a.elements.len() == 0) { return false; }
            return expr_is_closure_elem(a.elements[0], closureset);
        },
        _ => {}
    }
    return false;
}

// assign_builds_closurearr reports whether `value` (the RHS of `name = value`)
// makes `name` a closure array: either a closure-array literal, or an
// `<arr>.append(<closure>)` / `.push(<closure>)` that adds a closure element —
// the incremental build the initial `var fs = []` literal misses.
function assign_builds_closurearr(value: ast.Expr, closureset: string[]): boolean {
    if (array_lit_is_closurearr(value, closureset)) { return true; }
    match (value) {
        ast.ExprCall(sac) => {
            match (sac.callee) {
                ast.ExprFieldAccess(safa) => {
                    if (safa.field == "append" || safa.field == "push") {
                        var ai: i32 = 0;
                        while (ai < sac.args.len()) {
                            if (expr_is_closure_elem(sac.args[ai], closureset)) { return true; }
                            ai = ai + 1;
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

// body_binds_closurearr_local reports whether `body` (recursing into nested
// blocks, mirroring body_binds_closure_local) binds local `name` to a closure
// ARRAY: a closure-array literal, or a call to a function already known to
// return one (`caset`, resolved by closurearr_ret_fns_of's fixpoint).
function body_binds_closurearr_local(body: ast.Stmt[], name: string, closureset: string[], caset: string[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(sv) => {
                if (sv.name == name) {
                    if (array_lit_is_closurearr(sv.init, closureset)) { return true; }
                    match (sv.init) {
                        ast.ExprCall(bcc) => {
                            match (bcc.callee) {
                                ast.ExprIdent(bcid) => {
                                    if (util.index_of_str(caset, bcid.name) >= 0) { return true; }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            // `fs = fs.append(<closure>)` / `fs = [<closure>, …]` — an
            // incremental reassignment that makes `name` a closure array, which
            // the initial (often empty `[]`) StmtVar literal doesn't reveal.
            // Without this a factory that builds its closure array by append
            // isn't classified closurearr-returning, so the CALLER dispatches
            // `fs[i](x)` as a bare fn pointer and SIGSEGVs on the env box.
            ast.StmtAssign(sasg) => {
                if (sasg.target == name && assign_builds_closurearr(sasg.value, closureset)) { return true; }
            },
            ast.StmtIf(bif) => {
                if (body_binds_closurearr_local(bif.then_body, name, closureset, caset)) { return true; }
                if (body_binds_closurearr_local(bif.else_body, name, closureset, caset)) { return true; }
            },
            ast.StmtWhile(bwh) => {
                if (body_binds_closurearr_local(bwh.body, name, closureset, caset)) { return true; }
            },
            ast.StmtFor(bfr) => {
                if (body_binds_closurearr_local(bfr.body, name, closureset, caset)) { return true; }
            },
            ast.StmtMatch(bmt) => {
                var bmi: i32 = 0;
                while (bmi < bmt.arms.len()) {
                    if (body_binds_closurearr_local(bmt.arms[bmi].body, name, closureset, caset)) { return true; }
                    bmi = bmi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// iife_arms_closurearr counts the arms of a value-position if/match that yield a
// closure ARRAY — a closure-array literal, a call to a closurearr-returning fn
// (`caset`), or a nested if/match whose own arms all do — and answers -1 as soon
// as one yields anything else. The closureset-side twin of
// iife_stmts_all_closurearr, for the registry pass that runs before any
// LowerState exists.
function iife_arms_closurearr(stmts: ast.Stmt[], closureset: string[], caset: string[], seen: i32): i32 {
    var n: i32 = seen;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprArray(_) => {
                        if (!array_lit_is_closurearr(r.value, closureset)) { return 0 - 1; }
                        n = n + 1;
                    },
                    ast.ExprCall(rc) => {
                        match (rc.callee) {
                            ast.ExprIdent(rid) => {
                                if (util.index_of_str(caset, rid.name) < 0) { return 0 - 1; }
                                n = n + 1;
                            },
                            ast.ExprLambda(ril) => {
                                if (rc.args.len() != 0 || ril.params.len() != 0) { return 0 - 1; }
                                n = iife_arms_closurearr(ril.body, closureset, caset, n);
                                if (n < 0) { return 0 - 1; }
                            },
                            _ => { return 0 - 1; }
                        }
                    },
                    _ => { return 0 - 1; }
                }
            },
            ast.StmtIf(iff) => {
                n = iife_arms_closurearr(iff.then_body, closureset, caset, n);
                if (n < 0) { return 0 - 1; }
                n = iife_arms_closurearr(iff.else_body, closureset, caset, n);
                if (n < 0) { return 0 - 1; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    n = iife_arms_closurearr(mm.arms[a].body, closureset, caset, n);
                    if (n < 0) { return 0 - 1; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return n;
}

pub function closurearr_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    // The single-closure registry, reused so a `[mk(), …]` element (mk a
    // closure factory) counts as a closure-array element.
    var closureset: string[] = closure_ret_fns_of(funcs, structs);
    var out: string[] = [];
    // Only functions declared to return a fn-ARRAY (`((T) => R)[]`, coarsed
    // to "fn[]") — never the compiler's own sources, keeping the self-compile
    // fixpoint byte-identical. EVERY return in the body counts (branch /
    // loop / match-arm returns via collect_returns), in three forms:
    //   (a) `return [<closure>, …]` — a closure-array literal;
    //   (b) `return <ident>` bound (anywhere in the body) to such a literal
    //       or to a closurearr-returning call;
    //   (c) `return <closurearr-returning call>` — a factory that FORWARDS
    //       another factory's array, e.g. `return mk();` (fixpoint-ordered,
    //       like closure_ret_fns_of's transitive form).
    var changed: boolean = true;
    while (changed) {
        changed = false;
        for fn in funcs {
            if (fn.ret_type == "fn[]" && util.index_of_str(out, fn.name) < 0) {
                var rets: ast.Expr[] = collect_returns(fn.body, []);
                var hit: boolean = false;
                var ri: i32 = 0;
                while (ri < rets.len()) {
                    match (rets[ri]) {
                        ast.ExprArray(_) => {
                            if (array_lit_is_closurearr(rets[ri], closureset)) { hit = true; }
                        },
                        ast.ExprIdent(rid) => {
                            if (body_binds_closurearr_local(fn.body, rid.name, closureset, out)) { hit = true; }
                        },
                        ast.ExprCall(rcc) => {
                            match (rcc.callee) {
                                ast.ExprIdent(rccid) => {
                                    if (util.index_of_str(out, rccid.name) >= 0) { hit = true; }
                                },
                                // (e) `return (if (c) { [<closure>] } else { … })` —
                                // a value-position if/match is an IIFE, so the arrays
                                // are one level in. EVERY arm has to yield a closure
                                // array: the caller's binding gets one dispatch ABI,
                                // and the boxing pass gives the arms uniform boxes on
                                // exactly the same condition.
                                ast.ExprLambda(ril) => {
                                    if (rcc.args.len() == 0 && ril.params.len() == 0
                                            && iife_arms_closurearr(ril.body, closureset, out, 0) > 0) { hit = true; }
                                },
                                _ => {}
                            }
                        },
                        // (d) `return r.hs` — a whole closure-ARRAY struct FIELD (or a
                        // fn[] param / annotated local): the field type resolves to
                        // "fn[]", so the caller's `var hs = pick()` marks hs
                        // is_closurearr and `hs[i]()` dispatches env-first (#5202 C).
                        ast.ExprFieldAccess(_) => {
                            if (detector_expr_type(rets[ri], fn, structs) == "fn[]") { hit = true; }
                        },
                        _ => {}
                    }
                    ri = ri + 1;
                }
                if (hit) { out = out.append(fn.name); changed = true; }
            }
        }
    }
    // "CAC:<name>" rows (#4354), in the same list so no registry is threaded: a
    // closurearr-returning fn whose EVERY return is a fresh closure array, so
    // the caller's binding is the sole owner of each element box and may take
    // the "CLOARR:" element walk. Exact-match consumers never see a fn named
    // "CAC:…"; collect_fresh_cloarr_names is the one reader of the prefix.
    for fn in funcs {
        if (util.index_of_str(out, fn.name) >= 0 && !body_has_nonfresh_cloarr_return(fn.body, closureset)) { out = out.append("CAC:" + fn.name); }
    }
    return out;
}

pub function (s: LowerState) is_closurearr_ret_fn(name: string): boolean {
    return util.index_of_str(s.sigs.closurearr_ret_fns, name) >= 0;
}

// arg_is_closurearr classifies a call ARGUMENT at an fn-array param position:
// true only when the arg is PROVABLY an array of closure boxes — a closure-
// array literal, a call to a closurearr-returning fn, an ident bound
// (anywhere in the calling body) to either, or an ident naming a PARAM of the
// caller that is itself an already-proven closure-array param (caller_cparams
// — the #5119 forwarding case, resolved by fn_param_sigs_of's fixpoint).
// Anything else — a bare-fn array (`[inc, dbl]`), an unresolvable ident —
// reads false, keeping the callee on the plain fn-pointer dispatch those need.
function arg_is_closurearr(arg: ast.Expr, caller_body: ast.Stmt[], closureset: string[], caset: string[], caller_cparams: string[]): boolean {
    match (arg) {
        ast.ExprArray(_) => { return array_lit_is_closurearr(arg, closureset); },
        ast.ExprCall(ac) => {
            match (ac.callee) {
                ast.ExprIdent(acid) => { return util.index_of_str(caset, acid.name) >= 0; },
                _ => {}
            }
        },
        ast.ExprIdent(aid) => {
            if (util.index_of_str(caller_cparams, aid.name) >= 0) { return true; }
            return body_binds_closurearr_local(caller_body, aid.name, closureset, caset);
        },
        _ => {}
    }
    return false;
}

// ca_classify_top classifies expression `e` when it is a DIRECT call to
// `fname` (the whole init / return value / assign value / expression
// statement): returns (seen, ok) — seen=1 when it IS such a call, ok=1 when
// additionally the arg at `pidx` is a provable closure array.
// ca_classify_expr counts EVERY call to free function `fname` anywhere in the
// expression tree `e` — (seen, ok) where `ok` also requires the pidx arg to be
// a closure array. It mirrors astwalk.collect_idents_expr's recursion so that
// a call is counted wherever collect_idents_expr counts `fname` as a callee
// ident, keeping fnarr_param_all_closurearr's `nident == nseen` cross-check in
// step: without this a call buried in a NESTED expression position — an if/
// match/while CONDITION, a `match` SCRUTINEE, an argument to another call
// (`id(get(fs))`), a binary operand (`get(fs) == 14`, which is also what a
// scalar-literal `match` desugars to) — read as an unaccounted `fname`
// occurrence, failed the proof, and left a genuine closure-array PARAM
// UN-marked, so `fs[i](args)` dispatched PLAIN and bare-called the element box
// as code (SIGSEGV, #5109). Counting the call at its real position lets the
// proof succeed. A bare fn-POINTER-array caller still classifies (1,0) and
// blocks the proof (nok < nseen), and a non-call use of the name is still
// unmatched by any call (nident > nseen) — so the analysis stays conservative.
function ca_classify_expr(e: ast.Expr, fname: string, pidx: i32, caller_body: ast.Stmt[], closureset: string[], caset: string[], caller_cparams: string[]): (i32, i32) {
    var seen: i32 = 0;
    var okc: i32 = 0;
    match (e) {
        // A LAMBDA body is statements inside an expression, and a value-position
        // if/match is exactly that (an IIFE). collect_idents_expr descends into
        // one, so a call to `fname` there counts toward nident; without the same
        // descent here it counted toward nothing, nident outran nseen, and the
        // proof failed silently — leaving a genuine closure-array PARAM unmarked
        // so `fs[i](args)` bare-dispatched the element box (#6571).
        ast.ExprLambda(lm) => {
            var (ls, lo) = ca_scan_stmts(lm.body, fname, pidx, caller_body, closureset, caset, caller_cparams);
            return (ls, lo);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == fname) {
                        seen = seen + 1;
                        if (pidx < c.args.len() && arg_is_closurearr(c.args[pidx], caller_body, closureset, caset, caller_cparams)) { okc = okc + 1; }
                    }
                },
                _ => {
                    var (ka, kb) = ca_classify_expr(c.callee, fname, pidx, caller_body, closureset, caset, caller_cparams);
                    seen = seen + ka; okc = okc + kb;
                }
            }
            for arg in c.args {
                var (aa, ab) = ca_classify_expr(arg, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + aa; okc = okc + ab;
            }
        },
        ast.ExprBinary(b) => {
            var (la, lb) = ca_classify_expr(b.left, fname, pidx, caller_body, closureset, caset, caller_cparams);
            var (ra, rb) = ca_classify_expr(b.right, fname, pidx, caller_body, closureset, caset, caller_cparams);
            seen = seen + la + ra; okc = okc + lb + rb;
        },
        ast.ExprUnary(u) => { var (ua, ub) = ca_classify_expr(u.operand, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + ua; okc = okc + ub; },
        ast.ExprIndex(x) => {
            var (aa, ab) = ca_classify_expr(x.array, fname, pidx, caller_body, closureset, caset, caller_cparams);
            var (ia, ib) = ca_classify_expr(x.index, fname, pidx, caller_body, closureset, caset, caller_cparams);
            seen = seen + aa + ia; okc = okc + ab + ib;
        },
        ast.ExprSlice(sl) => {
            var (aa, ab) = ca_classify_expr(sl.array, fname, pidx, caller_body, closureset, caset, caller_cparams);
            var (sa, sb) = ca_classify_expr(sl.start, fname, pidx, caller_body, closureset, caset, caller_cparams);
            var (ea, eb) = ca_classify_expr(sl.end, fname, pidx, caller_body, closureset, caset, caller_cparams);
            seen = seen + aa + sa + ea; okc = okc + ab + sb + eb;
        },
        ast.ExprFieldAccess(fa) => { var (oa, ob) = ca_classify_expr(fa.obj, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + oa; okc = okc + ob; },
        ast.ExprArray(a) => {
            var ai: i32 = 0;
            while (ai < a.elements.len()) { var (ea, eb) = ca_classify_expr(a.elements[ai], fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + ea; okc = okc + eb; ai = ai + 1; }
        },
        ast.ExprTuple(t) => {
            for el in t.elements { var (ea, eb) = ca_classify_expr(el, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + ea; okc = okc + eb; }
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { var (ba, bb) = ca_classify_expr(sl.base, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + ba; okc = okc + bb; }
            for fv in sl.field_values { var (va, vb) = ca_classify_expr(fv, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + va; okc = okc + vb; }
        },
        _ => {}
    }
    return (seen, okc);
}

// ca_scan_stmts walks `body` counting calls to `fname` at every expression
// position (via ca_classify_expr) plus every nested statement block. It covers
// the same positions astwalk.collect_idents_stmt does, so the (seen) total
// matches the `fname` ident-occurrence total fnarr_param_all_closurearr
// cross-checks against.
function ca_scan_stmts(body: ast.Stmt[], fname: string, pidx: i32, caller_body: ast.Stmt[], closureset: string[], caset: string[], caller_cparams: string[]): (i32, i32) {
    var seen: i32 = 0;
    var okc: i32 = 0;
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(sv) => { var (va, vb) = ca_classify_expr(sv.init, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + va; okc = okc + vb; },
            ast.StmtReturn(sr) => { var (ra, rb) = ca_classify_expr(sr.value, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + ra; okc = okc + rb; },
            ast.StmtExpr(sx) => { var (xa, xb) = ca_classify_expr(sx.value, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + xa; okc = okc + xb; },
            ast.StmtAssign(sa) => { var (aa, ab) = ca_classify_expr(sa.value, fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + aa; okc = okc + ab; },
            ast.StmtDefer(sd) => { var (da, db) = ca_scan_stmts([sd.action], fname, pidx, caller_body, closureset, caset, caller_cparams); seen = seen + da; okc = okc + db; },
            ast.StmtIf(sif) => {
                var (ca, cb) = ca_classify_expr(sif.cond, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + ca; okc = okc + cb;
                var (ia, ib) = ca_scan_stmts(sif.then_body, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + ia; okc = okc + ib;
                var (ea, eb) = ca_scan_stmts(sif.else_body, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + ea; okc = okc + eb;
            },
            ast.StmtWhile(swh) => {
                var (wca, wcb) = ca_classify_expr(swh.cond, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + wca; okc = okc + wcb;
                var (wa, wb) = ca_scan_stmts(swh.body, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + wa; okc = okc + wb;
            },
            ast.StmtFor(sfr) => {
                var (fia, fib) = ca_classify_expr(sfr.iter, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + fia; okc = okc + fib;
                var (fa2, fb2) = ca_scan_stmts(sfr.body, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + fa2; okc = okc + fb2;
            },
            ast.StmtMatch(smt) => {
                var (sca, scb) = ca_classify_expr(smt.scrutinee, fname, pidx, caller_body, closureset, caset, caller_cparams);
                seen = seen + sca; okc = okc + scb;
                var mi: i32 = 0;
                while (mi < smt.arms.len()) {
                    var (ma, mb) = ca_scan_stmts(smt.arms[mi].body, fname, pidx, caller_body, closureset, caset, caller_cparams);
                    seen = seen + ma; okc = okc + mb;
                    mi = mi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return (seen, okc);
}

// fnarr_param_all_closurearr proves that EVERY use of free function `fname`
// in the module passes a definite closure array at param `pidx`: every
// statement-top-level call classifies ok, and the total ident-occurrence
// count of `fname` equals the classified-call count (so a call at a nested
// expression position or a bare fn-value reference — either of which the
// classifier can't see — reads as unknown and blocks the proof). At least
// one call must exist. `cparams` ("fname|pname" entries) is the set of
// closure-array params already proven by fn_param_sigs_of's fixpoint: a
// caller FORWARDING such a param of its own counts as passing a closure
// array (#5119 — without this, `chain(fs)` → `apply(fs, …)` left `apply`'s
// param unproven and its element dispatch went plain → SIGSEGV).
function fnarr_param_all_closurearr(funcs: parser.FuncDecl[], fname: string, pidx: i32, closureset: string[], caset: string[], cparams: string[]): boolean {
    var nseen: i32 = 0;
    var nok: i32 = 0;
    var nident: i32 = 0;
    for fn in funcs {
        // The caller's own already-proven closure-array param NAMES (free
        // functions only — method params are never flagged, and a method
        // sharing a free function's name must not inherit its proof).
        var caller_cparams: string[] = [];
        if (fn.receiver_type.len() == 0) {
            var cpj: i32 = 0;
            while (cpj < fn.params.len()) {
                if (util.index_of_str(cparams, fn.name + "|" + fn.params[cpj].name) >= 0) {
                    caller_cparams = caller_cparams.append(fn.params[cpj].name);
                }
                cpj = cpj + 1;
            }
        }
        var (cs, co) = ca_scan_stmts(fn.body, fname, pidx, fn.body, closureset, caset, caller_cparams);
        nseen = nseen + cs;
        nok = nok + co;
        var ids: string[] = [];
        var sj: i32 = 0;
        while (sj < fn.body.len()) { ids = astwalk.collect_idents_stmt(fn.body[sj], ids); sj = sj + 1; }
        var ii: i32 = 0;
        while (ii < ids.len()) { if (ids[ii] == fname) { nident = nident + 1; } ii = ii + 1; }
    }
    return nseen > 0 && nok == nseen && nident == nseen;
}

// body_ends_with_return: the last top-level statement is a `return`, so the
// body never reaches the fallthrough epilogue.
function body_ends_with_return(body: ast.Stmt[]): boolean {
    if (body.len() == 0) { return false; }
    match (body[body.len() - 1]) {
        ast.StmtReturn(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// own_param_names_of returns the names of `fn`'s `own` (consuming) parameters.
function own_param_names_of(fn: parser.FuncDecl): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (fn.params[i].own) { out = out.append(fn.params[i].name); }
        i = i + 1;
    }
    return out;
}

// own_struct_param_release_rows_of names the `own` struct parameters this frame
// still OWNS at every exit, so the sweep releases them: the caller moved its
// reference in, and a param that is never returned bare, aliased, stored, passed
// to a non-borrowable position or handed back through a result has no other
// owner when the frame ends. A donating reuse site (the own-param families, the
// `$ownret` update) zeroes the slot it takes, so the release finds null there.
//
// "OWNREL:<name>" releases deep — the routed field walk under the box's rc==1
// gate, then the box dec; "OWNRELB:<name>" is box-only, for a param whose
// non-scalar fields may have been copied out uncounted: a method receiver, a
// field moved out, or a `T { ...p, … }` spread over a kind the base copy does
// not retain (spread_copy_counted). A reassigned param is admitted only when
// every assignment is an admitted self-update (`upd`, own_update_params_of):
// the slot then always holds a box this frame owns.
function own_struct_param_release_rows_of(fn: parser.FuncDecl, structs: parser.StructDecl[], sfok: string[], borrowable: string[], recv_borrow: string[], handback: string[], upd: string[]): string[] {
    var out: string[] = [];
    var reassigned: string[] = body_assign_targets(fn.body);
    for pd in fn.params {
        var nm: string = pd.name;
        var ty: string = pd.type_name;
        if (!pd.own || !decl_is_struct(structs, ty) || !decl_is_leaksafe(structs, ty)) { continue; }
        if (local_decl_count(fn.body, nm) != 0) { continue; }
        if (util.index_of_str(reassigned, nm) >= 0 && util.index_of_str(upd, nm) < 0) { continue; }
        if (body_unsafe_for(fn.body, nm, borrowable, recv_borrow)) { continue; }
        if (struct_returned_bare(fn.body, nm)) { continue; }
        if (struct_arg_to_handback(fn.body, nm, handback)) { continue; }
        if (recv_borrow_escapes_via_result(recv_borrow, ty, fn.body, nm, borrowable)) { continue; }
        var nomove: string[] = recv_borrow_methods_of(recv_borrow, ty);
        nomove = append_all(nomove, clo_field_names_of(structs, ty));
        var moved: boolean = moves_fields_stmts(fn.body, nm, nomove, spread_copy_counted(structs, sfok, ty))
            || optstruct_body_moves_field(fn.body, nm, ty, structs, borrowable);
        if (moved) { out = out.append("OWNRELB:" + nm); }
        else { out = out.append("OWNREL:" + nm); }
    }
    return out;
}

pub function fn_param_sigs_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    // The closure registries feed the '3' (closure-array param) proof below.
    // Computed LAZILY — only when some receiver-less function actually has an
    // "fn[]" param — so the bootstrap self-compile (which has none) pays
    // nothing and its registry stays byte-identical.
    var have_fnarr: boolean = false;
    for fn in funcs {
        if (fn.receiver_type.len() == 0) {
            var hpj: i32 = 0;
            while (hpj < fn.params.len()) {
                if (fn.params[hpj].type_name == "fn[]") { have_fnarr = true; }
                hpj = hpj + 1;
            }
        }
    }
    var closureset: string[] = [];
    var caset: string[] = [];
    // caparams: "fname|pname" for every free-function fn[] param proven to be
    // a closure array, computed to a FIXPOINT: a round that proves a param
    // lets the next round accept that param FORWARDED as a call argument
    // (arg_is_closurearr's caller_cparams case), so `main → chain(fs) →
    // apply(fs, …)` proves chain's param first and apply's from it (#5119).
    // Monotone (the set only grows from sound base cases) and bounded by the
    // number of fn[] params, so it terminates; a program with no fn[] params
    // never enters the loop (the bootstrap self-compile pays nothing).
    var caparams: string[] = [];
    if (have_fnarr) {
        closureset = closure_ret_fns_of(funcs, structs);
        caset = closurearr_ret_fns_of(funcs, structs);
        var ca_changed: boolean = true;
        while (ca_changed) {
            ca_changed = false;
            for fn in funcs {
                if (fn.receiver_type.len() == 0) {
                    var fpj: i32 = 0;
                    while (fpj < fn.params.len()) {
                        if (fn.params[fpj].type_name == "fn[]") {
                            var fkey: string = fn.name + "|" + fn.params[fpj].name;
                            if (util.index_of_str(caparams, fkey) < 0
                                && fnarr_param_all_closurearr(funcs, fn.name, fpj, closureset, caset, caparams)) {
                                caparams = caparams.append(fkey);
                                ca_changed = true;
                            }
                        }
                        fpj = fpj + 1;
                    }
                }
            }
        }
    }
    // #4873 port: the may-grow array-param masks, merged below as flag '4'.
    var growset: string[] = grow_param_flags_of(funcs);
    var out: string[] = [];
    for fd in funcs {
        var gmask: string = "";
        var gkey: string = fd.name;
        if (fd.receiver_type.len() > 0) { gkey = util.base_type_name(fd.receiver_type) + "." + fd.name; }
        var gi: i32 = 0;
        while (gi < growset.len()) {
            var ge: string = growset[gi];
            var gb: i32 = 0;
            while (gb < ge.len() && ge[gb] != b'|') { gb = gb + 1; }
            if (gb < ge.len() && slice_unchecked(ge, 0, gb) == gkey) { gmask = slice_unchecked(ge, gb + 1, ge.len()) + ""; gi = growset.len(); }
            else { gi = gi + 1; }
        }
        var flags: string = "";
        var any: boolean = false;
        var pj: i32 = 0;
        while (pj < fd.params.len()) {
            if (fd.params[pj].type_name == "fn") { flags = flags + "1"; any = true; }
            // A SCALAR `dyn Trait` param: flag '2'. A primitive/string arg passed
            // here is heap-boxed into a `dyn` cell at the call site (op_dyn_box) so
            // the receiver carries a shape pointer (docs/DYN-TRAITS.md §4.2.3).
            // '2' is distinct from the fn flag '1', so callee_param_is_fn is
            // unaffected; callee_param_is_dyn reads '2'.
            else if (fd.params[pj].type_name.len() > 4 && slice_unchecked(fd.params[pj].type_name, 0, 4) == "dyn "
                     && !is_array_type_name(fd.params[pj].type_name)) { flags = flags + "2"; any = true; }
            // A `dyn Trait[]` (ARRAY) param: flag '8'. The array pointer itself
            // flows in one word — what needs coercing is each ELEMENT, and only
            // when the argument is an array LITERAL written at the call
            // (`render([1, 2])`, #6906): a literal bound to a local first was
            // already boxed at its `var xs: dyn Trait[] = […]` binding, and any
            // other argument form is an already-built array. callee_param_is_dyn
            // reads '2' only, so the scalar-arg boxing is unaffected.
            else if (fd.params[pj].type_name.len() > 4 && slice_unchecked(fd.params[pj].type_name, 0, 4) == "dyn "
                     && is_array_type_name(fd.params[pj].type_name)) { flags = flags + "8"; any = true; }
            // An fn-ARRAY param (`((T) => R)[]`, coarsed "fn[]") whose every
            // call site provably passes a closure ARRAY: flag '3' (proven by
            // the caparams fixpoint above). lower_func marks the param slot
            // is_closurearr so `fns[i](args)` dispatches env-first (the
            // elements are boxes). Distinct from '1'/'2' so the existing
            // consumers are unaffected. Free functions only — a method's
            // call sites aren't scanned.
            else if (have_fnarr && fd.params[pj].type_name == "fn[]" && fd.receiver_type.len() == 0
                     && util.index_of_str(caparams, fd.name + "|" + fd.params[pj].name) >= 0) { flags = flags + "3"; any = true; }
            // #4873: an array param the callee may grow in place — flag '4'
            // so the call site brackets a surviving argument. Distinct from
            // '1'/'2'/'3' (an array param is never fn/dyn), so the existing
            // consumers are unaffected.
            else if (pj < gmask.len() && gmask[pj] == b'1') { flags = flags + "4"; any = true; }
            // A BARE-TYPEVAR (erased-generic) param (`x: T` — a standalone
            // single-uppercase-letter type spelling, the same convention
            // rewrite_typevars_to_argrefs keys on; unbounded type params are
            // STRIPPED from the decl, so fd.type_params can't be
            // consulted): flag '5', or '6' when the fn is a wasm-WIDENABLE
            // pass-through (erased_passthrough_safe — bare-typevar return + the
            // erased value only FLOWS OUT via return; #5464). The call site width-
            // dispatches a 64-bit argument through lower_i64 (the erased slot is 8
            // bytes on the register backends). callee_param_is_typevar accepts BOTH
            // '5' and '6' (so the register i64-arg path is unchanged), while the
            // wasm-only widening/coercion keys on '6' via callee_param_is_erased_widened.
            // Free functions only (methods are never erased generics).
            else if (fd.receiver_type.len() == 0 && is_erased_typevar(fd.params[pj].type_name, structs)) {
                if (erased_widenable(fd, structs)) { flags = flags + "6"; } else { flags = flags + "5"; }
                any = true;
            }
            // '7': an erased typevar ARRAY param (`xs: T[]`). Distinct from '5'
            // because the erasure is in the ELEMENT, not the value: nothing wide
            // is passed by value, so the '5' detector never fires — but on wasm32
            // the element STRIDE is erased too, and a wide-element array copied
            // at the i32 stride is silently wrong. Flags it so erased_wide_expr
            // can refuse the shape instead of miscompiling it.
            //
            // Only when the body actually READS an element (elem_read_in_body).
            // A callee that only asks for `.len()` never uses a stride, so the
            // refusal would cost coverage for nothing — `is_empty[T](xs: T[])`
            // at an `f64[]`. The predicate calls everything but `.len()` a read.
            else if (fd.receiver_type.len() == 0 && is_erased_typevar_array(fd.params[pj].type_name, structs)
                     && elem_read_in_body(fd.body, fd.params[pj].name)) {
                flags = flags + "7";
                any = true;
            }
            else { flags = flags + "0"; }
            pj = pj + 1;
        }
        if (any) {
            var key: string = fd.name;
            if (fd.receiver_type.len() > 0) { key = util.base_type_name(fd.receiver_type) + "." + fd.name; }
            out = out.append(key + "|" + flags);
        }
    }
    return out;
}
// elem_read_expr / elem_read_stmt / elem_read_in_body decide whether an erased
// `T[]` param's ELEMENT is ever touched — the question flag '7' skipped asking.
//
// The wasm refusal exists because an erased element width makes the callee copy
// an 8-byte-element array at a 4-byte stride. A callee that never reads an
// element never uses a stride, so refusing it costs coverage and buys nothing:
// `is_empty[T](xs: T[]): boolean { return xs.len() == 0; }` at an `f64[]` was
// rejected outright.
//
// The predicate is deliberately lopsided. It answers "does this use read an
// element?" with YES for everything except the one form that provably cannot —
// `name` as the receiver of `.len()`, which reads the header word and nothing
// else. A bare mention of `name` anywhere else counts as a read, including a
// reassignment target, because the array flows on from there and this pass does
// not follow it. Getting this wrong in the permissive direction reopens a
// silent-miscompile class, so an unrecognised use is a read.
//
// Measured before narrowing: of the 47 single-typevar `T[]`-param generics in
// std/array, exactly ONE is element-blind (`is_empty`). Every other
// concrete-return shape (`all`, `any`, `count_where`, `position`, `sum_by`, …)
// feeds elements to a predicate and stays refused, correctly.
function elem_read_expr(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    // `name.len()` — the one blind use. Skip the receiver, still
                    // walk the args (`f(name)` inside them is a read).
                    var blind: boolean = false;
                    if (fa.field == "len") {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => { if (rid.name == name) { blind = true; } },
                            _ => {}
                        }
                    }
                    if (!blind && elem_read_expr(fa.obj, name)) { return true; }
                },
                _ => { if (elem_read_expr(c.callee, name)) { return true; } }
            }
            for arg in c.args { if (elem_read_expr(arg, name)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return elem_read_expr(b.left, name) || elem_read_expr(b.right, name); },
        ast.ExprUnary(u) => { return elem_read_expr(u.operand, name); },
        ast.ExprIndex(ix) => { return elem_read_expr(ix.array, name) || elem_read_expr(ix.index, name); },
        ast.ExprSlice(sl) => { return elem_read_expr(sl.array, name) || elem_read_expr(sl.start, name) || elem_read_expr(sl.end, name); },
        ast.ExprFieldAccess(fa) => { return elem_read_expr(fa.obj, name); },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (elem_read_expr(a.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (elem_read_expr(el, name)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && elem_read_expr(sl.base, name)) { return true; }
            for fv in sl.field_values { if (elem_read_expr(fv, name)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) { if (elem_read_stmt(lm.body[i], name)) { return true; } i = i + 1; }
            return false;
        },
        _ => { return false; }
    }
    return false;
}
function elem_read_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return elem_read_expr(v.init, name); },
        ast.StmtReturn(r) => { return elem_read_expr(r.value, name); },
        ast.StmtExpr(e) => { return elem_read_expr(e.value, name); },
        // A reassignment target is a read: the param is rebound and the array
        // flows on from a place this pass does not follow.
        ast.StmtAssign(a) => { return a.target == name || elem_read_expr(a.value, name); },
        ast.StmtIf(f) => {
            if (elem_read_expr(f.cond, name)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (elem_read_stmt(f.then_body[ti], name)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (elem_read_stmt(f.else_body[ei], name)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (elem_read_expr(w.cond, name)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (elem_read_stmt(w.body[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (elem_read_expr(fo.iter, name)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (elem_read_stmt(fo.body[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (elem_read_expr(m.scrutinee, name)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && elem_read_expr(arm.guard, name)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (elem_read_stmt(arm.body[bi], name)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return elem_read_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}
function elem_read_in_body(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (elem_read_stmt(stmt, name)) { return true; } }
    return false;
}
// borrowable_params_of computes, for each free function, which params are
// "borrowable" — provably only borrow-read in the body and never escaping
// (returned, stored in a container, passed to ANY call, sliced, or captured).
// A borrowable param means the callee cannot retain the argument, so a
// sole-owner array passed there can still be precise-dropped at the call site
// (the Level-2 reclaim in expr_unsafe_for). This is a conservative,
// intra-procedural UNDER-approximation: borrowability is computed with an EMPTY
// borrowable registry (`none`), so the strict escape walker treats a param
// passed to any call as escaping — i.e. we don't yet do the inter-procedural
// inferParamEscapes fixpoint (native ir.go:2554). Encoded "callee|flags"
// (flag i = '1' iff param i borrowable); methods keyed "<Type>.<method>" but
// only free-function entries are consulted at call sites. Entries with no
// borrowable param are omitted (lookup defaults to false). Mirrors native's
// borrow inference, the conservative first cut.
// param_consumed_in_body reports whether the callee body CONSUMES param `name`
// in a way the borrow walker reads as a harmless borrow: a reassignment
// (`name = …` — the functional-update spelling `xs = xs.append(x)` /
// `m = m.insert(k, v)`), or `name.append(…)` in ANY position — append REUSES or
// FREES a unique receiver's buffer on growth, so even the unbound
// `var ys = xs.append(x)` can free the caller's buffer out from under a
// caller-side release. expr_unsafe_for deliberately treats a bare-ident method
// receiver as a borrow (that rule is correct for its named-LOCAL consumers,
// which bail on reassignment separately via body_assign_targets), but a
// borrowability verdict feeds CALLER-side frees (the Level-2 precise drop, the
// call-arg temp reclaim), so a consumed param admitted as borrowable
// over-released: caller dec'd a buffer append had already freed (rc underflow,
// found by the #4365 stage-(b) probes; pre-existing for the L2 named-local
// drop). Consuming set: `append` — the one receiver method that releases the
// receiver buffer itself; map mutators keep the box pointer alive so the
// caller's release stays sole.
function param_consumed_expr(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "append") {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => { if (rid.name == name) { return true; } },
                            _ => {}
                        }
                    }
                    if (param_consumed_expr(fa.obj, name)) { return true; }
                },
                _ => { if (param_consumed_expr(c.callee, name)) { return true; } }
            }
            for arg in c.args { if (param_consumed_expr(arg, name)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return param_consumed_expr(b.left, name) || param_consumed_expr(b.right, name); },
        ast.ExprUnary(u) => { return param_consumed_expr(u.operand, name); },
        ast.ExprIndex(ix) => { return param_consumed_expr(ix.array, name) || param_consumed_expr(ix.index, name); },
        ast.ExprSlice(sl) => { return param_consumed_expr(sl.array, name) || param_consumed_expr(sl.start, name) || param_consumed_expr(sl.end, name); },
        ast.ExprFieldAccess(fa) => { return param_consumed_expr(fa.obj, name); },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (param_consumed_expr(a.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (param_consumed_expr(el, name)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && param_consumed_expr(sl.base, name)) { return true; }
            for fv in sl.field_values { if (param_consumed_expr(fv, name)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) { if (param_consumed_stmt(lm.body[i], name)) { return true; } i = i + 1; }
            return false;
        },
        _ => { return false; }
    }
    return false;
}
function param_consumed_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return param_consumed_expr(v.init, name); },
        ast.StmtReturn(r) => { return param_consumed_expr(r.value, name); },
        ast.StmtExpr(e) => { return param_consumed_expr(e.value, name); },
        ast.StmtAssign(a) => { return param_consumed_expr(a.value, name); },
        ast.StmtIf(f) => {
            if (param_consumed_expr(f.cond, name)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (param_consumed_stmt(f.then_body[ti], name)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (param_consumed_stmt(f.else_body[ei], name)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (param_consumed_expr(w.cond, name)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (param_consumed_stmt(w.body[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (param_consumed_expr(fo.iter, name)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (param_consumed_stmt(fo.body[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (param_consumed_expr(m.scrutinee, name)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && param_consumed_expr(arm.guard, name)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (param_consumed_stmt(arm.body[bi], name)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return param_consumed_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}
function param_consumed_in_body(stmts: ast.Stmt[], name: string, reassigned: string[]): boolean {
    if (util.index_of_str(reassigned, name) >= 0) { return true; }
    for stmt in stmts { if (param_consumed_stmt(stmt, name)) { return true; } }
    return false;
}

// param_match_binding_escapes: for every `match (name)` anywhere in `stmts`, does
// any arm bind a name that escapes its arm (binding_escapes_arm)? This is the
// hazard the scrutinee-is-a-borrow reading opens up on a PARAM: `b` itself is
// never mentioned outside the match, so no walk over `b` can see a payload the
// arm handed out, and a caller that then released `b` would free a live buffer.
//
// Every binding is checked, not just the rc-droppable ones match_arm_binds_rc_payload
// filters to. That gate resolves a binding's type through the enum's StructDecl,
// which the built-in Option / Result do not have — a `Some(p) => { return p; }`
// would read as "no rc payload bound" and be admitted. Checking bindings without
// consulting their type costs only the scalar arms, which no caller frees anyway.
function param_match_binding_escapes(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        if (param_match_binding_escapes_stmt(stmt, name)) { return true; }
    }
    return false;
}
function param_match_binding_escapes_stmt(st: ast.Stmt, name: string): boolean {
    var none: string[] = [];
    match (st) {
        ast.StmtMatch(m) => {
            var scrut_is_name: boolean = false;
            match (m.scrutinee) {
                ast.ExprIdent(sid) => { if (sid.name == name) { scrut_is_name = true; } },
                _ => {}
            }
            for arm in m.arms {
                if (scrut_is_name) {
                    match (arm.pattern) {
                        ast.PatVariant(pv) => {
                            if (pv.binding != "" && pv.binding != "_"
                                && binding_escapes_arm(arm, pv.binding, none)) { return true; }
                            var eb: i32 = 0;
                            while (eb < pv.extra_bindings.len()) {
                                var ebn: string = pv.extra_bindings[eb];
                                if (ebn != "" && ebn != "_" && binding_escapes_arm(arm, ebn, none)) { return true; }
                                eb = eb + 1;
                            }
                        },
                        _ => {}
                    }
                }
                if (param_match_binding_escapes(arm.body, name)) { return true; }
            }
            return false;
        },
        ast.StmtIf(iff) => {
            return param_match_binding_escapes(iff.then_body, name)
                || param_match_binding_escapes(iff.else_body, name);
        },
        ast.StmtWhile(w) => { return param_match_binding_escapes(w.body, name); },
        ast.StmtFor(f) => { return param_match_binding_escapes(f.body, name); },
        ast.StmtDefer(d) => { return param_match_binding_escapes_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}

// A borrowability registry is a fixed-width bucket array, NOT a list of entries:
// exactly BORROW_REG_BUCKETS strings, bucket b holding the '\n'-terminated
// "<key>|<flags>" records whose key hashes to b. It stays a `string[]` so the
// ~20 walker signatures that thread it are untouched, and so regs_equal — which
// compares positionally — keeps working unchanged.
//
// Bucketing on the key's FIRST BYTE would not do: self-host names are dominated
// by shared prefixes (set_*, emit_*, is_*, lower_*, collect_*), so the worst
// first-byte bucket holds 159 of irlower.fern's 1,359 functions — 11.7% of the
// table. The whole key is hashed instead.
//
// A prime count keeps unrelated hash strides from aliasing onto the same bucket.
function borrow_reg_buckets(): i32 { return 251; }

function borrow_reg_new(): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    var n: i32 = borrow_reg_buckets();
    while (i < n) { out = out.append(""); i = i + 1; }
    return out;
}

function borrow_reg_put(reg: string[], key: string, flags: string): string[] {
    var b: i32 = util.hash_bucket(key, reg.len());
    return reg.with(b, reg[b] + key + "|" + flags + "\n");
}

// borrow_reg_bare_index re-buckets a registry's rows by the bare name after
// the key's last '.' (the whole key when it has none), keeping each row
// intact, so a lookup by method name reaches every "<Type>.<method>" row
// without walking the registry. Sized from the row count, unlike the
// registry itself.
function borrow_reg_bare_index(reg: string[]): string[] {
    var nrows: i32 = 0;
    var bi: i32 = 0;
    while (bi < reg.len()) {
        var s: string = reg[bi];
        var k: i32 = 0;
        while (k < s.len()) { if (s[k] == b'\n') { nrows = nrows + 1; } k = k + 1; }
        bi = bi + 1;
    }
    var nb: i32 = sig_bucket_count(nrows);
    var out: string[] = [];
    var j: i32 = 0;
    while (j < nb) { out = out.append(""); j = j + 1; }
    bi = 0;
    while (bi < reg.len()) {
        var buck: string = reg[bi];
        var bl: i32 = 0;
        while (bl < buck.len()) {
            var ble: i32 = bl;
            while (ble < buck.len() && buck[ble] != b'\n') { ble = ble + 1; }
            var bar: i32 = bl;
            while (bar < ble && buck[bar] != b'|') { bar = bar + 1; }
            if (bar < ble) {
                var dot: i32 = bar;
                while (dot > bl && buck[dot - 1] != b'.') { dot = dot - 1; }
                var hb: i32 = util.hash_bucket(slice_unchecked(buck, dot, bar) + "", nb);
                out = out.with(hb, out[hb] + slice_unchecked(buck, bl, ble) + "\n");
            }
            bl = ble + 1;
        }
        bi = bi + 1;
    }
    return out;
}

// ── counted-retain array params (#6522, native's inferParamCountedRetain) ────
//
// The arg-temp stash releases a fresh argument only at a BORROWABLE position,
// because a callee that retains its argument must be the one to free it. That
// leaves the shape the conformance row is built from stranded: a constructor
// that STORES the array — `node(name, deps_of(n), mtime)` — is not borrowable
// by construction, so the caller's reference to the temp has nothing to
// release it.
//
// Native's answer is not to widen borrowability but to ask a different
// question per ARGUMENT: is every appearance of the callee's parameter a
// COUNTED store or a non-retaining read? If so, an argument that reaches the
// callee's result got there through a construction that inc'd it. The temp is
// then rc 2 on the escaping path and rc 1 on the non-escaping one, and a single
// post-call dec nets it to exactly one owner either way — which is why this
// admits where the whole-call gate cannot.
//
// Credited (safe) occurrences, mirroring arrayParamCounted:
//   - a bare `p` as a slot value of a struct / tuple / array literal — the
//     construction incs it;
//   - `p.len()`, the pure-read builtin receiver — reads, retains nothing;
//   - `p` as argument i of a call whose parameter i is itself counted.
// EVERYTHING else disqualifies, including `return p`, `x = p`, an element read
// and a non-counted call argument. Positive evidence only.
//
// ARRAY parameters only. Native also classifies string and struct params and
// then withdraws a scalar exemption when some pointer param is unproven
// (`ptrAllCounted`); classifying only arrays and leaving every other param
// uncredited is strictly narrower than that, so the exemption never arises and
// a missing credit costs a leak rather than an over-release.
function arrparam_use_ok(e: ast.Expr, pn: string, counted: boolean, reg: string[], pfx: string, structs: parser.StructDecl[], sfok: string[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { if (id.name == pn) { return counted; } return true; },
        ast.ExprArray(a) => {
            // Array and tuple construction inc an ARRAY element; whether they inc
            // a STRING one is not established, so the string tier declines both
            // rather than crediting a store that may never have retained.
            var acnt: boolean = pfx == "ACNT:";
            var i: i32 = 0;
            while (i < a.elements.len()) { if (!arrparam_use_ok(a.elements[i], pn, acnt, reg, pfx, structs, sfok)) { return false; } i = i + 1; }
            return true;
        },
        ast.ExprTuple(t) => {
            var tcnt: boolean = pfx == "ACNT:";
            for el in t.elements { if (!arrparam_use_ok(el, pn, tcnt, reg, pfx, structs, sfok)) { return false; } }
            return true;
        },
        ast.ExprStructLit(sl) => {
            // A functional-update BASE copies field pointers without a counted
            // store, so it is not a credited slot.
            if (sl.has_base && !arrparam_use_ok(sl.base, pn, false, reg, pfx, structs, sfok)) { return false; }
            // The construction-side string, enum and TUPLE retains are gated on
            // slit_reclaim, so such a slot in a literal whose type does not route
            // field reclaim is stored UNCOUNTED — crediting it would make the
            // caller's post-call free an over-release. Array slots are
            // unconditional and unaffected.
            var scnt: boolean = true;
            if ((pfx == "SCNT:" || pfx == "ECNT:" || pfx == "TCNT:") && !struct_routes_field_reclaim_at(structs, sfok, sl.type_name)) { scnt = false; }
            // The STRUCT tier credits ONLY the counted append store below. A
            // bare param in a field slot takes the construction-side retain
            // just for a type that routes field reclaim, and crediting it
            // where that retain does not fire makes the caller's post-call
            // release an over-release — `wrap(p, i) -> Box { a: p, n: i }`
            // at rc underflow, which is what callee_wraps_param pins. Refusing
            // costs the leak that shape already had.
            if (pfx == "PCNT:") { scnt = false; }
            for fv in sl.field_values { if (!arrparam_use_ok(fv, pn, scnt, reg, pfx, structs, sfok)) { return false; } }
            return true;
        },
        ast.ExprCall(c) => {
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => { callee_name = cid.name; },
                ast.ExprFieldAccess(fa) => {
                    // `p.len()` — the pure-read builtin receiver. Any other
                    // method may thread the receiver, so it is not credited.
                    var recv_counted: boolean = fa.field == "len";
                    if (!arrparam_use_ok(fa.obj, pn, recv_counted, reg, pfx, structs, sfok)) { return false; }
                    // `xs.append(p)` at the STRUCT tier is a COUNTED store: the
                    // clone-append retains a borrowed-param struct element, so
                    // the caller's post-call release nets to the reference the
                    // array owns.
                    if (pfx == "PCNT:" && fa.field == "append" && c.args.len() == 1) {
                        return arrparam_use_ok(c.args[0], pn, true, reg, pfx, structs, sfok);
                    }
                },
                _ => { if (!arrparam_use_ok(c.callee, pn, false, reg, pfx, structs, sfok)) { return false; } }
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                var argc: boolean = callee_name.len() > 0 && param_counted_at(reg, pfx, callee_name, ai);
                if (!arrparam_use_ok(c.args[ai], pn, argc, reg, pfx, structs, sfok)) { return false; }
                ai = ai + 1;
            }
            return true;
        },
        ast.ExprBinary(b) => { return arrparam_use_ok(b.left, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(b.right, pn, false, reg, pfx, structs, sfok); },
        ast.ExprUnary(u) => { return arrparam_use_ok(u.operand, pn, false, reg, pfx, structs, sfok); },
        // `p[i]` is credited for a STRING parameter and refused for an array
        // one: a string's byte index yields a u8 VALUE copy that references
        // nothing, while an array element may BE a reference the read hands out
        // uncounted. Native draws the same line (stringParamCounted has the
        // Index arm, arrayParamCounted does not).
        //
        // A SLICE is NOT credited for either, though native credits it for
        // strings on the grounds that `__str_slice` copies. In Fern `p[a:b]`
        // yields a `str` — a borrowed VIEW over the parameter's buffer, which
        // the checker's own E043 says when it refuses to store one in a
        // `string` field without `.to_owned()`. A view keeps the argument
        // reachable after the caller's post-call release, so crediting it
        // corrupts the value rather than leaking one.
        ast.ExprIndex(ix) => {
            var icnt: boolean = pfx == "SCNT:";
            return arrparam_use_ok(ix.array, pn, icnt, reg, pfx, structs, sfok) && arrparam_use_ok(ix.index, pn, false, reg, pfx, structs, sfok);
        },
        ast.ExprSlice(sl2) => { return arrparam_use_ok(sl2.array, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(sl2.start, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(sl2.end, pn, false, reg, pfx, structs, sfok); },
        ast.ExprFieldAccess(fa2) => { return arrparam_use_ok(fa2.obj, pn, false, reg, pfx, structs, sfok); },
        ast.ExprLambda(lm) => { return arrparam_uses_ok_stmts(lm.body, pn, reg, pfx, structs, sfok); },
        _ => { return true; }
    }
    return true;
}

function arrparam_uses_ok_stmts(stmts: ast.Stmt[], pn: string, reg: string[], pfx: string, structs: parser.StructDecl[], sfok: string[]): boolean {
    for stmt in stmts { if (!arrparam_use_ok_stmt(stmt, pn, reg, pfx, structs, sfok)) { return false; } }
    return true;
}
function arrparam_use_ok_stmt(st: ast.Stmt, pn: string, reg: string[], pfx: string, structs: parser.StructDecl[], sfok: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return arrparam_use_ok(v.init, pn, false, reg, pfx, structs, sfok); },
        ast.StmtAssign(a) => { return arrparam_use_ok(a.value, pn, false, reg, pfx, structs, sfok); },
        ast.StmtReturn(r) => { return arrparam_use_ok(r.value, pn, false, reg, pfx, structs, sfok); },
        ast.StmtExpr(e) => { return arrparam_use_ok(e.value, pn, false, reg, pfx, structs, sfok); },
        ast.StmtIf(f) => {
            return arrparam_use_ok(f.cond, pn, false, reg, pfx, structs, sfok)
                && arrparam_uses_ok_stmts(f.then_body, pn, reg, pfx, structs, sfok)
                && arrparam_uses_ok_stmts(f.else_body, pn, reg, pfx, structs, sfok);
        },
        ast.StmtWhile(w) => { return arrparam_use_ok(w.cond, pn, false, reg, pfx, structs, sfok) && arrparam_uses_ok_stmts(w.body, pn, reg, pfx, structs, sfok); },
        ast.StmtFor(fo) => { return arrparam_use_ok(fo.iter, pn, false, reg, pfx, structs, sfok) && arrparam_uses_ok_stmts(fo.body, pn, reg, pfx, structs, sfok); },
        ast.StmtMatch(m) => {
            if (!arrparam_use_ok(m.scrutinee, pn, false, reg, pfx, structs, sfok)) { return false; }
            for arm in m.arms {
                if (arm.has_guard && !arrparam_use_ok(arm.guard, pn, false, reg, pfx, structs, sfok)) { return false; }
                if (!arrparam_uses_ok_stmts(arm.body, pn, reg, pfx, structs, sfok)) { return false; }
            }
            return true;
        },
        ast.StmtDefer(d) => { return arrparam_use_ok_stmt(d.action, pn, reg, pfx, structs, sfok); },
        _ => { return true; }
    }
    return true;
}

// param_counted_at: parameter `ai` of `callee` is counted-retain in tier `pfx`
// ("ACNT:" for array params, "SCNT:" for string ones).
pub function param_counted_at(reg: string[], pfx: string, callee: string, ai: i32): boolean {
    var i: i32 = 0;
    while (i < reg.len()) {
        var st: i32 = tagged_value_start(reg[i], pfx, callee);
        if (st >= 0 && st < reg[i].len()) {
            if (st + ai < reg[i].len()) { return reg[i][st + ai] == b'1'; }
            return false;
        }
        i = i + 1;
    }
    return false;
}
pub function arr_param_counted_at(reg: string[], callee: string, ai: i32): boolean {
    return param_counted_at(reg, "ACNT:", callee, ai);
}
pub function str_param_counted_at(reg: string[], callee: string, ai: i32): boolean {
    return param_counted_at(reg, "SCNT:", callee, ai);
}
pub function struct_param_counted_at(reg: string[], callee: string, ai: i32): boolean {
    return param_counted_at(reg, "PCNT:", callee, ai);
}

// borrow_reg_with_counted folds param_counted_of's verdict into the borrowability
// registry under a "CNT:" key prefix. The verdict was reachable only from the
// argument-temp stash, which holds the sigs; the ESCAPE walker threads the borrow
// registry and nothing else, so a NAMED local passed at a counted position read as
// an escape and lost its scope-exit release entirely — the callee's store retained
// and its drop gave the retain back, and no one ever released the caller's own
// claim, a constant 2-object leak. This closes the `string`, `string[]`, `enum`
// and enum-ARRAY construction-retain `__param` cells. The struct-array one is
// still uncounted: admission is BY TYPE, and its tier is its own slice.
//
// All tiers merge into one flag string: at a call argument the question is
// whether THIS position is counted, not which type tier proved it. What the
// caller then RELEASES is decided by its own local's type — the deep tier needs
// a distinct key only so param_counted_of's consumers can tell a plain-dec
// credit from an element-walk one, not so this merge can. Keys are
// distinct from the bare names by the prefix, so every existing lookup is inert.
function borrow_reg_with_counted(reg: string[], pcnt: string[]): string[] {
    var keys: string[] = [];
    var flags: string[] = [];
    var i: i32 = 0;
    while (i < pcnt.len()) {
        var row: string = pcnt[i];
        var bar: i32 = 0;
        while (bar < row.len() && row[bar] != b'|') { bar = bar + 1; }
        // Every tier key is five bytes ("ACNT:" / "SCNT:" / "ECNT:" / "DCNT:" /
        // "TCNT:" / "PCNT:") — the slice below hard-codes that width;
        // a row with no key or no '|' is not one param_counted_of wrote.
        if (bar < row.len() && bar > 5) {
            var key: string = "CNT:" + slice_unchecked(row, 5, bar);
            var fl: string = slice_unchecked(row, bar + 1, row.len()) + "";
            var at: i32 = util.index_of_str(keys, key);
            if (at < 0) { keys = keys.append(key); flags = flags.append(fl); }
            else { flags = flags.with(at, merge_counted_flags(flags[at], fl)); }
        }
        i = i + 1;
    }
    var out: string[] = reg;
    var k: i32 = 0;
    while (k < keys.len()) { out = borrow_reg_put(out, keys[k], flags[k]); k = k + 1; }
    return out;
}

// merge_counted_flags: '1' at a position either tier credits.
function merge_counted_flags(a: string, b: string): string {
    var n: i32 = a.len();
    if (b.len() > n) { n = b.len(); }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        if ((i < a.len() && a[i] == b'1') || (i < b.len() && b[i] == b'1')) { out = out + "1"; }
        else { out = out + "0"; }
        i = i + 1;
    }
    return out;
}

// param_counted_of: the least fixpoint, over both tiers at once — the walk is
// name-keyed and type-blind, so classifying array and string params in one pass
// costs one traversal instead of two. Starts all-false and only ever
// ADDS credits — a use is credited on positive local evidence or on a callee
// already proven counted — so the iteration is monotone and settles on the
// grounded fixpoint. A mutual-recursion cycle with no grounding stays
// uncredited, which is the conservative direction.
// str_result_cannot_alias: `ret` cannot BE a `string` argument. Native's
// resultCannotAliasArg, and the reason the string tier does not copy the array
// one's CONCRETE SCALAR guard: a struct or enum result CONTAINS the argument,
// which is exactly the shape this tier exists for — the callee's counted store
// and the caller's post-call dec net to the one reference the result owns. The
// shape that is unsafe is a result of the parameter's OWN type, which the use
// vocabulary credits (`both(t, k) { var n = Q { tag: t, k: k }; return n.tag; }`
// reads the field off a LOCAL, so `t` itself never appears in a refused
// position) and only a result-type test can refuse. An unresolved name — a bare
// type var — refuses with everything else it is not.
function str_result_cannot_alias(ret: string, structs: parser.StructDecl[]): boolean {
    if (ret == "string" || ret == "str") { return false; }
    return is_scalar_type_name(ret) || decl_is_struct(structs, ret) || decl_is_enum(structs, ret);
}

// struct_result_cannot_alias: the STRUCT tier's sibling of the two above. A
// result of the parameter's OWN type could hand the argument straight back,
// which one post-call release would dangle; a result that CONTAINS it is what
// the tier exists for.
function struct_result_cannot_alias(ret: string, pty: string, structs: parser.StructDecl[]): boolean {
    if (ret == pty) { return false; }
    return is_scalar_type_name(ret) || decl_is_struct(structs, ret) || decl_is_enum(structs, ret);
}

// enum_result_cannot_alias: the ENUM tier's sibling of str_result_cannot_alias.
// The counted claim is that ONE post-call release nets the argument to the
// owner the callee's construction retained, so a result that could BE the
// argument breaks it. For an enum param that is any enum result — the tier is
// name-keyed and type-blind, so it cannot tell E from some other enum, and the
// conservative reading costs a leak rather than an over-release.
function enum_result_cannot_alias(ret: string, structs: parser.StructDecl[]): boolean {
    if (decl_is_enum(structs, ret)) { return false; }
    return is_scalar_type_name(ret) || decl_is_struct(structs, ret);
}

pub function param_counted_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[], sfok: string[]): string[] {
    var reg: string[] = [];
    var round: i32 = 0;
    while (round < 16) {
        var next: string[] = [];
        var changed: boolean = false;
        for fn in funcs {
            // ARRAY tier. The result must not BE the argument: the release
            // fires immediately after the call, so a callee handing `d` straight
            // back out would leave the caller reading freed memory. A CONCRETE
            // SCALAR result settles that outright; so does a struct result whose
            // drop ROUTES field reclaim, which is the shape this tier exists for
            // — the callee's counted store and the caller's post-call dec net to
            // the one reference the returned struct owns. (The string tier's
            // str_result_cannot_alias reads it the same way, minus the routing
            // requirement.) A `string[]`/array RESULT is refused by both halves.
            //
            // Candidacy spans SCALAR-element arrays and `string[]`. For a
            // pointer-element array the caller's release is a shallow arr_dec,
            // not the deep element free — the returned struct retains the array
            // and deep-frees it on its own drop — so the credited use vocabulary
            // is the same either way: a bare `p` in a struct literal is a
            // counted slot, and the construction-side retain for an ARRAY field
            // is not gated on slit_reclaim the way the string one is.
            var scalar_result: boolean = owned_scalar_field_type(fn.ret_type);
            var aflags: string = "";
            var aany: boolean = false;
            var sflags: string = "";
            var sany: boolean = false;
            var str_ok_result: boolean = str_result_cannot_alias(fn.ret_type, structs);
            var enum_ok_result: boolean = enum_result_cannot_alias(fn.ret_type, structs);
            var eflags: string = "";
            var eany: boolean = false;
            var eaflags: string = "";
            var eaany: boolean = false;
            var tflags: string = "";
            var tany: boolean = false;
            var pflags: string = "";
            var pany: boolean = false;
            var ret_routes: boolean = struct_routes_field_reclaim_at(structs, sfok, fn.ret_type);
            var pj: i32 = 0;
            while (pj < fn.params.len()) {
                var aok: boolean = false;
                if ((scalar_result || ret_routes)
                    && (is_leaksafe_array_field(fn.params[pj].type_name)
                        || fn.params[pj].type_name == "string[]")
                    && !fn.params[pj].own
                    && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "ACNT:", structs, sfok)) { aok = true; }
                if (aok) { aflags = aflags + "1"; aany = true; } else { aflags = aflags + "0"; }
                var sok: boolean = false;
                if (str_ok_result
                    && fn.params[pj].type_name == "string"
                    && !fn.params[pj].own
                    && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "SCNT:", structs, sfok)) { sok = true; }
                if (sok) { sflags = sflags + "1"; sany = true; } else { sflags = sflags + "0"; }
                // ENUM tier. Same shape as the string one: the construction
                // retains the payload box and the holder's field drop decs it,
                // so the caller keeps the claim its own creation owes. Gated on
                // the holder ROUTING field reclaim for the same reason the
                // string slot is — a literal whose type carries no arm of the
                // right type never gives the retain back.
                var eok: boolean = false;
                if (enum_ok_result
                    && decl_is_enum(structs, fn.params[pj].type_name)
                    && !fn.params[pj].own
                    && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "ECNT:", structs, sfok)) { eok = true; }
                if (eok) { eflags = eflags + "1"; eany = true; } else { eflags = eflags + "0"; }
                // ARRAY-OF-BOXES tier, the DEEP class. Its own key rather than
                // a widening of "ACNT:": that tier's credit routes a plain
                // arr_dec, and an array of BOXES owes an element walk, so its
                // consumers must be able to tell the two apart.
                //
                // ENUM and STRUCT element arrays share the key. What the caller
                // RELEASES is decided by its own local's type — emit_arrenum_
                // deep_free or emit_arrstruct_deep_free — not by which type
                // proved the store counted, so one tier answers both and the
                // escape walkers differ only in which one they consult.
                //
                // Admission needs the element walk to EXIST, asked with the same
                // predicate the release side asks: enum_arr_elems_walk_ok for the
                // enum arm (what the backends check before emitting
                // __enum_arr_elems_drop_<E>), and struct_has_reclaim_array_field
                // for the struct one (what slot_is_reclaimable_arrstruct checks
                // before routing emit_arrstruct_deep_free). Without it the credit
                // would route a walk nothing emits, which is the leak it is
                // trying to close rather than a fix.
                //
                // Both releases are rc-gated (the holder's walk and the source's
                // deep free each is_unique-gate the buffer), so the callee's
                // counted store and the caller's own claim net to one owner: with
                // rc 2 the first sweep decs and the second walks. The element
                // handout the "ELB:" tier had to ask about is already refused
                // here — arrparam_use_ok credits `p[i]` only for "SCNT:", so an
                // element read disqualifies the param outright.
                var pty: string = fn.params[pj].type_name;
                var elem_walk_ok: boolean = false;
                if (is_enum_array_field_type(structs, pty)) {
                    elem_walk_ok = enum_arr_elems_walk_ok(structs, slice_unchecked(pty, 0, pty.len() - 2));
                } else if (is_struct_array_field_type(structs, pty)) {
                    elem_walk_ok = struct_has_reclaim_array_field(structs, slice_unchecked(pty, 0, pty.len() - 2));
                }
                // TUPLE tier. `keepit(t) { return Hold { t: t, n: 1 } }`: the
                // callee stores a borrowed tuple param into a struct literal,
                // which since the counted-store trio RETAINS it, so the caller's
                // own deep free and the holder's field drop net to one owner —
                // rc 2, the struct loop's box-only dec, then the rc-tuple loop's
                // walk. Gated on the result routing field reclaim for the same
                // reason the string and enum tiers are: a holder whose drop
                // carries no arm of the right type never gives the retain back.
                //
                // The element handout that sinks the "TUPB:" payload tier is
                // already refused here — arrparam_use_ok credits `p[i]` only for
                // "SCNT:", and a `p.<i>` field read is not in its credited
                // vocabulary at all, so a callee that extracts an element never
                // reaches this flag.
                var tok: boolean = false;
                if (ret_routes
                    && tuple_field_deep_droppable(fn.params[pj].type_name, structs)
                    && !fn.params[pj].own
                    && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "TCNT:", structs, sfok)) { tok = true; }
                if (tok) { tflags = tflags + "1"; tany = true; } else { tflags = tflags + "0"; }
                var eaok: boolean = false;
                if (scalar_result
                    && elem_walk_ok
                    && !fn.params[pj].own
                    && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "DCNT:", structs, sfok)) { eaok = true; }
                if (eaok) { eaflags = eaflags + "1"; eaany = true; } else { eaflags = eaflags + "0"; }
                // STRUCT tier. The callee stores a borrowed struct param into a
                // container, which the clone-append now RETAINS, so the caller's
                // post-call release and that retain net to the one reference the
                // result owns (#7853).
                var pok: boolean = false;
                if (struct_result_cannot_alias(fn.ret_type, fn.params[pj].type_name, structs)
                    && decl_is_struct(structs, fn.params[pj].type_name)
                    && !fn.params[pj].own
                    && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "PCNT:", structs, sfok)) { pok = true; }
                if (pok) { pflags = pflags + "1"; pany = true; } else { pflags = pflags + "0"; }
                pj = pj + 1;
            }
            if (aany) {
                var aent: string = "ACNT:" + borrowable_key(fn) + "|" + aflags;
                next = next.append(aent);
                if (util.index_of_str(reg, aent) < 0) { changed = true; }
            }
            if (eany) {
                var eent: string = "ECNT:" + borrowable_key(fn) + "|" + eflags;
                next = next.append(eent);
                if (util.index_of_str(reg, eent) < 0) { changed = true; }
            }
            if (eaany) {
                var eaent: string = "DCNT:" + borrowable_key(fn) + "|" + eaflags;
                next = next.append(eaent);
                if (util.index_of_str(reg, eaent) < 0) { changed = true; }
            }
            if (sany) {
                var sent: string = "SCNT:" + borrowable_key(fn) + "|" + sflags;
                next = next.append(sent);
                if (util.index_of_str(reg, sent) < 0) { changed = true; }
            }
            if (tany) {
                var tent: string = "TCNT:" + borrowable_key(fn) + "|" + tflags;
                next = next.append(tent);
                if (util.index_of_str(reg, tent) < 0) { changed = true; }
            }
            if (pany) {
                var pent: string = "PCNT:" + borrowable_key(fn) + "|" + pflags;
                next = next.append(pent);
                if (util.index_of_str(reg, pent) < 0) { changed = true; }
            }
        }
        reg = next;
        if (!changed) { return reg; }
        round = round + 1;
    }
    return reg;
}

pub function borrowable_params_of(funcs: parser.FuncDecl[]): string[] {
    var none: string[] = [];
    var out: string[] = borrow_reg_new();
    for fn in funcs {
        var flags: string = "";
        var any: boolean = false;
        var reasgn: string[] = body_assign_targets(fn.body);
        var pj: i32 = 0;
        while (pj < fn.params.len()) {
            var pname: string = fn.params[pj].name;
            // A bare-ident `match (pname)` scrutinee is a BORROW, not an escape —
            // #6127's reading, which was applied to the local-reclaim analyses but
            // never to this verdict. A param whose only use is being matched on
            // therefore read as escaping, so `head(b)` refused every caller-side
            // release and a loop-local enum passed to a helper leaked unboundedly
            // (#6606) while the identical match written inline was flat.
            // An `own` position is a MOVE by declaration: the caller
            // relinquishes its reference, so it must never stash-and-free a
            // fresh argument or keep a local's credit across the call —
            // whatever the body then does with the value.
            if (!fn.params[pj].own
                && !param_consumed_in_body(fn.body, pname, reasgn)
                && !body_unsafe_for_match_borrow(fn.body, pname, none, [], [])
                && !param_match_binding_escapes(fn.body, pname)) { flags = flags + "1"; any = true; }
            else { flags = flags + "0"; }
            pj = pj + 1;
        }
        if (any) {
            out = borrow_reg_put(out, borrowable_key(fn), flags);
            // The payload-aware "TUPB:" tier rides the same bucketed registry
            // under a prefixed key (exact-length key match keeps it disjoint
            // from the bare names) — param_is_borrowable("TUPB:<callee>", i)
            // reads it.
            var tupb: string = tuple_payload_borrow_flags(fn, flags);
            if (tupb.len() > 0) { out = borrow_reg_put(out, "TUPB:" + borrowable_key(fn), tupb); }
            // The ELEMENT tier, the array-of-boxes analogue of "TUPB:" and for
            // the same reason: an element WALK is a deep free, so the caller
            // needs the stronger question the box flag does not answer.
            var elb: string = arrenum_elem_borrow_flags(fn, flags);
            if (elb.len() > 0) { out = borrow_reg_put(out, "ELB:" + borrowable_key(fn), elb); }
        }
    }
    return out;
}
// tuple_payload_borrow_flags: the "TUPB:" tier for one function — per-param
// flag '1' iff the box flag is '1', the param is tuple-typed, and the rc-tuple
// payload walker proves no PAYLOAD of the param escapes the callee's body.
// The box flag proves the callee never keeps the BOX and licenses box-only
// releases; a TUPRCS deep free (every rc position, then the box) must ask this
// stronger question — a callee returning src.1 keys box-borrowable while its
// caller's deep free would dangle the handed-out element (native's
// taintedReachesSlot draws the same payload line). Registry-independent (empty
// borrowable inside — an onward pass of the param is an escape) and
// structs-blind (a struct-element field read is a conservative escape), so
// the interproc fixpoint cannot oscillate and both builders share it.
function tuple_payload_borrow_flags(fn: parser.FuncDecl, boxflags: string): string {
    var no_structs: parser.StructDecl[] = [];
    var no_strs: string[] = [];
    var tupb: string = "";
    var any1: boolean = false;
    var pj: i32 = 0;
    while (pj < fn.params.len()) {
        var pty: string = fn.params[pj].type_name;
        if (pj < boxflags.len() && boxflags[pj] == b'1'
            && util.is_tuple_type_name(pty) && !util.contains(pty, "=>")) {
            var tal: string[] = rctuple_param_alias_bind_sites(fn.body, fn.params[pj].name, pty, no_structs, fn.body, no_strs);
            if (!rctuple_payload_escapes_alias(fn.body, fn.params[pj].name, pty, no_structs, no_strs, tal, [], true)) {
                tupb = tupb + "1";
                any1 = true;
            } else { tupb = tupb + "0"; }
        } else { tupb = tupb + "0"; }
        pj = pj + 1;
    }
    if (!any1) { return ""; }
    return tupb;
}

// rctuple_param_alias_bind_sites: alias binds of a tuple PARAM whose payloads
// provably stay confined — the "TUPB:" flavor of param_alias_bind_sites. The
// vet is the rc-tuple payload scan on the ALIAS's own name, never the plain
// box walker: box-level vetting would bless `var x = src; return x.1;`, whose
// caller's TUPRCS deep free walks every rc position and frees the handed-out
// element (the sanitizer-confirmed UAF that killed v1 of the tier). Scanning
// the alias over the whole body with empty alias_ok also keeps a chained
// alias (`var y = x`) and a reassigned alias refused. Empty registries only,
// so the flag stays registry-independent for the interproc fixpoint.
function rctuple_param_alias_bind_sites(stmts: ast.Stmt[], src: string, pty: string, structs: parser.StructDecl[], body: ast.Stmt[], acc: string[]): string[] {
    var no_strs: string[] = [];
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if let ast.ExprIdent(aid) = v.init {
                    if (aid.name == src
                        && !rctuple_payload_escapes_alias(body, v.name, pty, structs, no_strs, no_strs, [], false)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => {
                a = rctuple_param_alias_bind_sites(f.then_body, src, pty, structs, body, a);
                a = rctuple_param_alias_bind_sites(f.else_body, src, pty, structs, body, a);
            },
            ast.StmtWhile(w) => { a = rctuple_param_alias_bind_sites(w.body, src, pty, structs, body, a); },
            ast.StmtFor(fo) => { a = rctuple_param_alias_bind_sites(fo.body, src, pty, structs, body, a); },
            ast.StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) { a = rctuple_param_alias_bind_sites(m.arms[ai].body, src, pty, structs, body, a); ai = ai + 1; }
            },
            ast.StmtDefer(d) => {
                if let ast.StmtWhile(dw) = d.action { a = rctuple_param_alias_bind_sites(dw.body, src, pty, structs, body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// arrenum_elem_borrow_flags: the "ELB:" tier for one function — per-param flag
// '1' iff the box flag is '1', the param is an ARRAY, and no ELEMENT of it
// escapes the callee's body. Element TYPE is not asked, so the one tier answers
// for every array-of-boxes class; arrenum and arrstruct both read it.
//
// The box flag licenses a box-only release: it proves the callee never keeps the
// param. An array-of-boxes local's release is not box-only — it WALKS every
// element box and frees it — so passing such a local to a call needs this
// stronger proof before the caller may keep its walk. Exactly the distinction
// "TUPB:" draws for rc-tuples, and for exactly the same reason.
//
// The element rule is the class's own: `arrenum_escapes` with an EMPTY registry,
// so the only admitted use is `xs.len()` and an onward pass of the param counts
// as an escape. Registry-independent by construction, like
// tuple_payload_borrow_flags, so the interproc fixpoint cannot oscillate.
function arrenum_elem_borrow_flags(fn: parser.FuncDecl, boxflags: string): string {
    var none: string[] = [];
    var elb: string = "";
    var any1: boolean = false;
    var pj: i32 = 0;
    while (pj < fn.params.len()) {
        var pty: string = fn.params[pj].type_name;
        if (pj < boxflags.len() && boxflags[pj] == b'1'
            && pty.len() >= 3 && slice_unchecked(pty, pty.len() - 2, pty.len()) == "[]"
            && !arrenum_param_escapes(fn.body, fn.params[pj].name, fn.body)) {
            elb = elb + "1";
            any1 = true;
        } else { elb = elb + "0"; }
        pj = pj + 1;
    }
    if (!any1) { return ""; }
    return elb;
}

// method_param_borrowable_all: every "<Type>.<method>" entry in the registry
// has position `idx` borrowable, and there is at least one. The receiver's type
// is not known to the AST-side walks, so a method argument is a borrow only when
// the method name settles it whatever the receiver turns out to be.
function method_param_borrowable_all(reg: string[], method: string, idx: i32): boolean {
    var found: boolean = false;
    var bi: i32 = 0;
    while (bi < reg.len()) {
        var e: string = reg[bi];
        var n: i32 = e.len();
        var p: i32 = 0;
        while (p < n) {
            var bar: i32 = p;
            while (bar < n && e[bar] != b'|') { bar = bar + 1; }
            var end: i32 = bar;
            while (end < n && e[end] != b'\n') { end = end + 1; }
            if (bar < n && bar - p > method.len() && e[bar - method.len() - 1] == b'.' && bytes_at(e, bar - method.len(), method)) {
                found = true;
                if (bar + 1 + idx >= end || e[bar + 1 + idx] != b'1') { return false; }
            }
            p = end + 1;
        }
        bi = bi + 1;
    }
    return found;
}

// borrowable_key is the registry key for a function's borrowability entry: the
// bare name for a free function, "<Type>.<method>" for a receiver method.
function borrowable_key(fn: parser.FuncDecl): string {
    if (fn.receiver_type.len() > 0) { return util.base_type_name(fn.receiver_type) + "." + fn.name; }
    return fn.name;
}
// borrowable_params_interproc is the inter-procedural widening of
// borrowable_params_of: an ITERATED greatest fixpoint from above, re-running the
// escape walker over every function until the registry stops changing (cap 64;
// real call graphs converge in a handful of passes). The algorithm is described
// in full inside the body — it replaced a single forward pass with a growing
// registry, which could not bootstrap a mutually recursive borrow.
//
// COST: the growing registry makes the escape walker short-circuit less, so this
// is materially heavier than the empty-registry conservative pass — recomputing it
// once per lowered function OOMs the arm64 self-compile (measured). It is therefore
// used ONLY on the emit path, computed ONCE per module before the per-function emit
// loop and threaded through `emit_function_via_ir` / `emit_function_ir`. The ~15
// inspection passes (module_uses_*, str_values, …) keep using the cheap
// conservative `borrowable_params_of`: they only check op-kind presence, and the
// only op a precise drop adds (__fern_arr_dec) is already emitted by the
// function-exit dec-sweep, so no inspection result can flip.
// param_local_decl_site: the `var` binding-site key for local `name` in `stmts`,
// or "". Needed because an ASSIGNMENT carries only the target's name, while the
// alias_ok forgiveness is keyed on binding sites.
function param_local_decl_site(stmts: ast.Stmt[], name: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return reclaim_site_key_of(v.name, v.line, v.col); } },
            ast.StmtIf(f) => {
                var t1: string = param_local_decl_site(f.then_body, name);
                if (t1.len() > 0) { return t1; }
                var e1: string = param_local_decl_site(f.else_body, name);
                if (e1.len() > 0) { return e1; }
            },
            ast.StmtWhile(w) => { var t2: string = param_local_decl_site(w.body, name); if (t2.len() > 0) { return t2; } },
            ast.StmtFor(fo) => { var t3: string = param_local_decl_site(fo.body, name); if (t3.len() > 0) { return t3; } },
            ast.StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) {
                    var t4: string = param_local_decl_site(m.arms[ai].body, name);
                    if (t4.len() > 0) { return t4; }
                    ai = ai + 1;
                }
            },
            _ => {}
        }
    }
    return "";
}

// param_alias_reassign_sites: the sites of locals REASSIGNED from a bare `src`
// (`t = src`). The assign sibling of param_alias_bind_sites, and the reason the
// param verdict needs both: `var q = p; q = o;` escapes `p` through the bind and
// `o` through the assignment, and forgiving only one leaves the other's caller
// still refusing its release (measured 80/40 with the bind arm alone).
//
// The local must be safe in its own right under the current registry, which is
// what still refuses `q = o; return q;`.
function param_alias_reassign_sites(stmts: ast.Stmt[], src: string, borrowable: string[], recv_borrow: string[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(asg) => {
                if let ast.ExprIdent(rid) = asg.value {
                    if (rid.name == src && asg.target != src
                            && !body_unsafe_for(body, asg.target, borrowable, recv_borrow)) {
                        var site: string = param_local_decl_site(body, asg.target);
                        if (site.len() > 0) { a = push_str_unique(a, site); }
                    }
                }
            },
            ast.StmtIf(f) => {
                a = param_alias_reassign_sites(f.then_body, src, borrowable, recv_borrow, body, a);
                a = param_alias_reassign_sites(f.else_body, src, borrowable, recv_borrow, body, a);
            },
            ast.StmtWhile(w) => { a = param_alias_reassign_sites(w.body, src, borrowable, recv_borrow, body, a); },
            ast.StmtFor(fo) => { a = param_alias_reassign_sites(fo.body, src, borrowable, recv_borrow, body, a); },
            ast.StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) { a = param_alias_reassign_sites(m.arms[ai].body, src, borrowable, recv_borrow, body, a); ai = ai + 1; }
            },
            ast.StmtDefer(d) => {
                if let ast.StmtWhile(dw) = d.action { a = param_alias_reassign_sites(dw.body, src, borrowable, recv_borrow, body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// param_alias_bind_sites: the binding sites of locals bound from a bare `name`,
// for the PARAM borrowability question only. This is alias_bind_sites_of WITHOUT
// its reassigned-target exclusion, and the difference is deliberate.
//
// That exclusion protects a LOCAL's reclaim credit: a slot later reassigned holds
// something else by the time it is swept, so crediting it off the alias would
// release the wrong box. The question here is narrower and different — does the
// PARAM escape? — and `var q = p; q = o;` answers it plainly: q briefly aliases p,
// then stops naming it. p is not referenced afterwards, so p does not escape.
//
// The local still has to be safe in its own right (body_unsafe_for under the
// current registry), which is what refuses `var q = p; return q;`.
function param_alias_bind_sites(stmts: ast.Stmt[], src: string, borrowable: string[], recv_borrow: string[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if let ast.ExprIdent(aid) = v.init {
                    if (aid.name == src && !body_unsafe_for(body, v.name, borrowable, recv_borrow)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => {
                a = param_alias_bind_sites(f.then_body, src, borrowable, recv_borrow, body, a);
                a = param_alias_bind_sites(f.else_body, src, borrowable, recv_borrow, body, a);
            },
            ast.StmtWhile(w) => { a = param_alias_bind_sites(w.body, src, borrowable, recv_borrow, body, a); },
            ast.StmtFor(fo) => { a = param_alias_bind_sites(fo.body, src, borrowable, recv_borrow, body, a); },
            ast.StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) { a = param_alias_bind_sites(m.arms[ai].body, src, borrowable, recv_borrow, body, a); ai = ai + 1; }
            },
            ast.StmtDefer(d) => {
                if let ast.StmtWhile(dw) = d.action { a = param_alias_bind_sites(dw.body, src, borrowable, recv_borrow, body, a); }
            },
            _ => {}
        }
    }
    return a;
}

pub function borrowable_params_interproc(funcs: parser.FuncDecl[]): string[] {
    // Greatest-fixpoint FROM ABOVE (the native `inferParamEscapes`, ir.go): start
    // OPTIMISTIC — EVERY param borrowable — then repeatedly re-run the escape
    // walker; a param flips to NON-borrowable (and never back) the first pass the
    // walker finds it escaping under the CURRENT registry. The non-call escape
    // channels (return / alias / container store / slice / lambda capture) don't
    // consult the registry, so they flip params off on their own; a call-arg
    // escape only fires once the callee's position is known non-borrowable, so the
    // set SHRINKS monotonically to the greatest sound fixpoint.
    //
    // This supersedes the old least-fixpoint FROM BELOW (start empty, grow): the
    // from-below pass could never bootstrap a MUTUALLY RECURSIVE borrow — each
    // param only became borrowable once its callee already was, so a cycle (e.g.
    // the `expr_unsafe_for`/`stmt_unsafe_for`/`body_unsafe_for` walkers passing
    // their read-only registry param around the cycle) stayed conservatively
    // non-borrowable forever. From-above keeps a cyclic param borrowable unless an
    // ACTUAL escape is proven, matching native and recovering those borrows for the
    // downstream reclaim (`reclaimable_names_of`, snapshot/precise-drop gating).
    //
    // SOUNDNESS NOTE: from-below is fail-safe on its iteration cap (an un-converged
    // result is SMALLER than the fixpoint ⇒ conservative). From-above is the
    // opposite — an un-converged result is LARGER ⇒ would mark an escaping param
    // borrowable. So convergence is detected EXACTLY (the registry signature stops
    // changing) and the cap is a generous backstop only; real call graphs converge
    // in a handful of passes (escapes propagate at call-graph-depth speed).
    // Computed ONCE per module on the emit path (the emit_function_via_ir /
    // emit_function_ir call sites), not per lowered function. Encoded
    // "callee|flags"; methods keyed "<Type>.<method>".
    //
    // Seed: every param of every function optimistically borrowable.
    var reg: string[] = borrow_reg_new();
    for fn in funcs {
        if (fn.params.len() > 0) {
            var seedflags: string = "";
            var sp: i32 = 0;
            while (sp < fn.params.len()) { seedflags = seedflags + "1"; sp = sp + 1; }
            reg = borrow_reg_put(reg, borrowable_key(fn), seedflags);
        }
    }
    var cap: i32 = 64;
    var iter: i32 = 0;
    var prev: string[] = [];
    while (iter < cap && !regs_equal(reg, prev)) {
        prev = reg;
        var next: string[] = borrow_reg_new();
        for fn in funcs {
            if (fn.params.len() > 0) {
                var flags: string = "";
                var any: boolean = false;
                var ip_reasgn: string[] = body_assign_targets(fn.body);
                var pj: i32 = 0;
                while (pj < fn.params.len()) {
                    // The scrutinee of a `match (param)` is a BORROW — see
                    // borrowable_params_of for why, and for what
                    // param_match_binding_escapes has to rule out. Widening the set
                    // keeps this pass monotone-decreasing: it only ever withholds a
                    // 1->0 flip, so the convergence test is unaffected.
                    // A param ALIASED into a local that never escapes is still a
                    // BORROW. This call passes an EMPTY alias_ok, so the walker
                    // reads `var q = p` as a bare-ident escape and the param flips
                    // off — and every CALLER then refuses its own release, which is
                    // where the whole cost lands. Measured against one caller: a
                    // callee reading `p.len()` directly leaves it flat at 80/80, the
                    // same callee with `var q: string = p` costs it 80/40, and
                    // adding `q = o` costs the other half at 80/0. The callee
                    // releases nothing in any of the three.
                    //
                    // The two readings are a UNION of independent proofs, not a
                    // relaxation of either: the first forgives a bare-ident match
                    // scrutinee and stays strict on aliases, the second forgives
                    // non-escaping aliases and stays strict on scrutinees. A body
                    // with BOTH satisfies neither and stays refused.
                    //
                    // Both run under the CURRENT registry `reg`, so this shrinks
                    // monotonically with the rest of the from-above fixpoint.
                    var ip_psal: string[] = param_alias_bind_sites(fn.body, fn.params[pj].name, reg, [], fn.body, []);
                    ip_psal = param_alias_reassign_sites(fn.body, fn.params[pj].name, reg, [], fn.body, ip_psal);
                    var ip_borrow: boolean = !body_unsafe_for_match_borrow(fn.body, fn.params[pj].name, reg, [], [])
                        || (ip_psal.len() > 0
                            && !body_unsafe_for_alias(fn.body, fn.params[pj].name, reg, [], ip_psal));
                    if (!fn.params[pj].own
                        && !param_consumed_in_body(fn.body, fn.params[pj].name, ip_reasgn)
                        && ip_borrow
                        && !param_match_binding_escapes(fn.body, fn.params[pj].name)) { flags = flags + "1"; any = true; }
                    else { flags = flags + "0"; }
                    pj = pj + 1;
                }
                if (any) {
                    next = borrow_reg_put(next, borrowable_key(fn), flags);
                    // The "TUPB:" payload tier — registry-independent flags
                    // (tuple_payload_borrow_flags walks with empty registries),
                    // so re-putting them per iteration cannot perturb the
                    // monotone-decreasing convergence argument below.
                    var ip_tupb: string = tuple_payload_borrow_flags(fn, flags);
                    if (ip_tupb.len() > 0) { next = borrow_reg_put(next, "TUPB:" + borrowable_key(fn), ip_tupb); }
                    // The "ELB:" element tier, registry-independent for the same
                    // reason (arrenum_escapes walks with an empty registry).
                    var ip_elb: string = arrenum_elem_borrow_flags(fn, flags);
                    if (ip_elb.len() > 0) { next = borrow_reg_put(next, "ELB:" + borrowable_key(fn), ip_elb); }
                }
            }
        }
        // Monotone-DECREASING (flags only go 1->0), so the registry strictly
        // shrinks until the fixpoint and the cap can never truncate a still-
        // growing sequence.
        reg = next;
        iter = iter + 1;
    }
    return reg;
}

// regs_equal compares two borrowability registries bucket-for-bucket — the
// convergence test for both interprocedural fixpoints. Bucket assignment is a
// pure function of the key and records land in funcs order within a bucket, so
// two passes producing the same verdicts produce byte-identical buckets, and
// positional equality is exactly "the registry is unchanged".
//
// It stops at the first difference, which is the case on every pass but the
// last. The serialised-signature form this replaced could not: it concatenated
// all ~1,300 entries into one string per pass before comparing, so a registry
// that differed in its first entry still paid for the whole ~32 KB build.
function regs_equal(a: string[], b: string[]): boolean {
    if (a.len() != b.len()) { return false; }
    var i: i32 = 0;
    while (i < a.len()) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// consume_safe_params_interproc: the consume-safe (escape) registry — a param is
// consume-safe iff its box does not escape the callee (`body_consume_unsafe_for`),
// the relaxation that admits `s = g(.., s, ..)` consume-rebinds. Encoded
// "callee|flags" like borrowable. Computed ONCE per module on the emit path,
// threaded into lower_func.
//
// A GREATEST fixpoint: every parameter starts consume-safe, and each pass strikes
// out the ones whose body escapes them under the previous pass's registry, until
// a pass strikes nothing. The lowering threads its state through a mutually
// recursive call graph — `sc = lower_expr(x, sc)` inside the very functions
// lower_expr dispatches to — and a least fixpoint from below never admits such a
// cycle, since each member is safe only once the others already are; measured,
// it left every `var sc: LowerState = s` in the compiler with no reclaim. From
// above the cycle stands unless some member really lets the box escape. That is
// what makes it sound: an escape is a concrete statement, the first pass strikes
// the parameter it escapes, and each following pass strikes the forwarders one
// call further out, so a parameter still marked at convergence has no chain to
// any escape. Convergence is exact (regs_equal), never a size test — a pass can
// flip one flag inside an existing entry.
pub function consume_safe_params_interproc(funcs: parser.FuncDecl[], borrowable: string[]): string[] {
    var reg: string[] = borrow_reg_new();
    for fn in funcs {
        if (fn.params.len() > 0) {
            var seed: string = "";
            var sj: i32 = 0;
            while (sj < fn.params.len()) { seed = seed + "1"; sj = sj + 1; }
            reg = borrow_reg_put(reg, borrowable_key(fn), seed);
        }
    }
    var iter: i32 = 0;
    var prev: string[] = [];
    // The cap is a guard against a non-terminating scan, not a budget: striking
    // out is monotone, so the passes are bounded by the number of parameters,
    // and a run that hits the cap hands back an empty registry — nothing
    // consume-safe — rather than a partly-struck one that still marks an escape.
    while (!regs_equal(reg, prev)) {
        if (iter >= 200) { return borrow_reg_new(); }
        prev = reg;
        var next: string[] = borrow_reg_new();
        for fn in funcs {
            if (fn.params.len() > 0) {
                var key: string = borrowable_key(fn);
                var flags: string = "";
                var any: boolean = false;
                var pj: i32 = 0;
                while (pj < fn.params.len()) {
                    if (param_is_borrowable(reg, key, pj)
                        && !body_consume_unsafe_for(fn.body, fn.params[pj].name, borrowable, reg, [], false)) { flags = flags + "1"; any = true; }
                    else { flags = flags + "0"; }
                    pj = pj + 1;
                }
                if (any) { next = borrow_reg_put(next, key, flags); }
            }
        }
        reg = next;
        iter = iter + 1;
    }
    return reg;
}
pub function i64_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        // Free functions are keyed by bare name; methods (lowered now) by the
        // qualified "<BaseType>.<method>" the call site dispatches to (a "." never
        // appears in a bare name, so the key spaces don't collide).
        // u64 rides the i64 64-bit signature path (it is i64-wide; only the
        // signedness of its own ops differs, selected at the producing
        // expression). A u64 PARAM flags '1' like i64 (both route lower_i64; the
        // param slot carries its own u64-ness). The u64 RETURN flags '2' (i64 is
        // '1') so is_u64_ret_fn can recover the callee's unsigned-ness at a
        // directly-chained call site (`f(a) >> 1` picks shr_u — #5159); is_i64_ret_fn
        // treats '1' and '2' alike since both are 64-bit-wide (#2904).
        // A u32 RETURN flags '3' so is_u32_ret_fn can recover the callee's
        // unsigned-ness at a directly-chained call site (`f(a) >> 1` picks shr_u —
        // #5245). It does NOT widen the value (u32 is i32-wide), so a u32 PARAM
        // flags '0' like i32 (the param slot carries its own u32-ness) and the
        // width queries (is_i64_ret_fn / param_is_i64) never see it. A pure-u32
        // function (no i64 anywhere) is now registered too — its '3' ret flag is
        // the only thing consulted.
        var retf: boolean = fn.ret_type == "i64" || fn.ret_type == "u64";
        var retf32: boolean = fn.ret_type == "u32";
        // A u8 RETURN flags '5'. Like u32 it does not widen anything (u8 is
        // i32-wide in a register), so a u8 PARAM still flags '0' and the width
        // queries never see it; it exists so is_u8_ret_fn can recover the
        // callee's SUB-WORD-ness at a call site. Without it expr_subword_kind
        // had no ExprCall arm to consult, so `f(x) +| g(y)` on u8-returning
        // functions clamped against i32 bounds and did not saturate at all.
        var retf8: boolean = fn.ret_type == "u8";
        var flags: string = "";
        var any: boolean = retf || retf32 || retf8;
        var pj: i32 = 0;
        while (pj < fn.params.len()) {
            if (fn.params[pj].type_name == "i64" || fn.params[pj].type_name == "u64") { flags = flags + "1"; any = true; }
            // An f64 PARAM flags '4'. It does not widen anything (f64 rides its
            // own lowering path, not lower_i64), so param_is_i64 — which matches
            // only '1' — never sees it; it exists so param_is_f64 can recover
            // the callee's float-ness at the call site and coerce an integer
            // argument. Without it `addhalf(3)` at `addhalf(x: f64)` pushed a
            // raw i32 and wasm rejected the module with "type mismatch:
            // expected f64, found i32" (#4801). Registering the function on
            // this flag alone is why `any` is set here too — a function with an
            // f64 param and no 64-bit integer anywhere still needs an entry.
            else if (is_f64_scalar_type_name(fn.params[pj].type_name)) { flags = flags + "4"; any = true; }
            else { flags = flags + "0"; }
            pj = pj + 1;
        }
        if (any) {
            var rc: string = "0";
            if (fn.ret_type == "i64") { rc = "1"; }
            else if (fn.ret_type == "u64") { rc = "2"; }
            else if (fn.ret_type == "u32") { rc = "3"; }
            else if (fn.ret_type == "u8") { rc = "5"; }
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key + "|" + rc + flags);
        }
    }
    return out;
}

// fn_sigs_without_ownership clears the freshness / consuming registries, which
// only steer where RC operations land. The eligibility scans lower a body purely
// to inspect its op kinds — call and function-value ops carry the callee name
// regardless of ownership tagging — so they lower with these empty.
pub function fn_sigs_without_ownership(sg: FnSigs): FnSigs {
    var e: string[] = [];
    return FnSigs { ...sg, fresh_struct_ret_fns: e, consume_safe_params: e,
        return_fresh_struct_ret_fns: e, recv_borrow_fns: e, str_fresh_ret_fns: e,
        opt_fresh_ret_fns: sig_reg_empty(), strfld_ok_types: e, tuple_fresh_ret_fns: e, own_positions: e,
        consumed_arr_positions: e, param_counted: e };
}

// fn_sigs_empty is the all-empty registry, for the analysis-only lowerings that
// inspect op kinds rather than emit and so need no return-type tagging.
pub function fn_sigs_empty(): FnSigs {
    var e: string[] = [];
    var r: SigReg = sig_reg_empty();
    return FnSigs { arr_ret_fns: r, str_ret_fns: r, bool_ret_fns: r, strarr_ret_fns: r, arr_method_fns: e, ret_type_fns: r, ret_fn_sigs: r, noesc_ret_fns: r,
        opt_ret_fns: r, i64_ret_fns: r, tuple_ret_fns: r, arrtup_ret_fns: r, struct_ret_fns: r, map_ret_fns: r,
        f64_ret_fns: r, f64arr_ret_fns: r, i64arr_ret_fns: r, erased_elem_ret_fns: r, fn_param_sigs: r, closure_fns: e,
        closurearr_ret_fns: e, const_fns: e, borrowable_params: e, borrow_bare: e, fn_names: r,
        fresh_struct_ret_fns: e, consume_safe_params: e, return_fresh_struct_ret_fns: e,
        recv_borrow_fns: e, str_fresh_ret_fns: e, opt_fresh_ret_fns: r, strfld_ok_types: e,
        tuple_fresh_ret_fns: e, own_positions: e, consumed_arr_positions: e, param_counted: e, trmc_consume_fns: e, handback_params: e };
}

// ret_type_fns_of: "name|ret_type" rows for every non-generic function, in
// declaration order (first row wins on a name collision, matching a linear
// scan). Generic functions are skipped — the syntactic mirror can't
// instantiate the type parameter.
pub function ret_type_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.type_params.len() == 0) { out = out.append(fn.name + "|" + fn.ret_type); }
    }
    return out;
}

// ret_fn_sigs_of: "name|<tag>" for every non-generic function returning a fn
// VALUE whose signature is not already described by the arity-keyed `$fn<N>`
// form. The row is what a call through the RESULT dispatches on, so `mk()(4.5)`
// names the funcref the returned value really has instead of assuming all-i32.
// A generic function is skipped for the reason annotation is: its spelling can
// name a bare type parameter, which only the monomorphised clone resolves — and
// the clone, carrying substituted sidecars, gets its own row.
pub function ret_fn_sigs_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.type_params.len() > 0) { continue; }
        if (fn.ret_type != "fn" || fn.ret_fn_ret.len() == 0) { continue; }
        var tys: string[] = [];
        if (fn.ret_fn_param_types.len() > 0) { tys = split_type_list(fn.ret_fn_param_types); }
        var pd: ast.ParamDecl = fn_param_decl(fn.name, tys, fn.ret_fn_ret);
        if (pd.type_name.len() == 0) { continue; }
        var tag: string = fn_sig_of(pd, []);
        if (tag.len() == 0) { continue; }
        out = out.append(fn.name + "|" + tag);
    }
    return out;
}

// noesc_ret_fns_of: a strict SUBSET port of native findReturnsNoParamEscape —
// the functions whose every return provably aliases no parameter, so a call
// result is fresh regardless of argument taint (rc_fe_rhs_tainted's user-call
// arm consults it). Optimistic knock-out fixpoint over the module: a function
// stays qualified while every return expression is built from literals,
// scalar-typed idents, arithmetic over those, and calls to still-qualified
// callees whose args qualify. Idents of non-scalar (or unknown) type refuse —
// native's version additionally admits fresh locals and cow chains, so every
// name this admits, native admits too: the dump gate can only converge, never
// newly diverge. Rows are "name|" for sig_reg_has_name.
// NoescSet is the qualified-callee set the noesc fixpoint shrinks. Membership
// is asked once per returned expression per body walk per round over ~9,400
// rows, which `util.index_of_str` answered by scanning all of them; this is the
// sig_reg_of index over the same rows plus a live flag per row, so a removal
// clears flags instead of rebuilding the array. The rows are fixed at the seed,
// which is what lets one index serve every round.
struct NoescSet {
    reg: SigReg,
    live: boolean[],
}

function noesc_set_of(rows: string[]): NoescSet {
    var live: boolean[] = [];
    var i: i32 = 0;
    while (i < rows.len()) { live = live.append(true); i = i + 1; }
    return NoescSet { reg: sig_reg_of(rows), live: live };
}

// noesc_set_has tests the row "<pfx><name>" byte-wise, so the three prefixed
// probes ("fn:", "0:") never build the key they ask about.
function noesc_set_has(s: NoescSet, pfx: string, name: string): boolean {
    var want: i32 = pfx.len() + name.len();
    var i: i32 = s.reg.head[sig_key_bucket(pfx, name, s.reg.head.len())];
    while (i >= 0) {
        var e: string = s.reg.rows[i];
        if (s.live[i] && e.len() == want && bytes_at(e, 0, pfx) && bytes_at(e, pfx.len(), name)) { return true; }
        i = s.reg.next[i];
    }
    return false;
}

// noesc_set_kill drops `name` from the set, both as a bare row and as its "fn:"
// row — the pair the fixpoint seeds and retires together. Every matching row
// goes, not the first: the seed can hold a function name and a same-named
// variant struct, and the scan this replaces removed both.
function noesc_set_kill(s: NoescSet, name: string): NoescSet {
    var live: boolean[] = s.live;
    var i: i32 = s.reg.head[sig_key_bucket("", name, s.reg.head.len())];
    while (i >= 0) {
        if (s.reg.rows[i] == name) { live = live.with(i, false); }
        i = s.reg.next[i];
    }
    var nl: i32 = name.len() + 3;
    var j: i32 = s.reg.head[sig_key_bucket("fn:", name, s.reg.head.len())];
    while (j >= 0) {
        var e: string = s.reg.rows[j];
        if (e.len() == nl && bytes_at(e, 0, "fn:") && bytes_at(e, 3, name)) { live = live.with(j, false); }
        j = s.reg.next[j];
    }
    return NoescSet { reg: s.reg, live: live };
}

function noesc_ret_expr_ok(e: ast.Expr, scalars: string[], q: NoescSet, builders: string[]): boolean {
    match (e) {
        ast.ExprNumber(_) => { return true; },
        ast.ExprBool(_) => { return true; },
        ast.ExprString(_) => { return true; },
        ast.ExprIdent(id) => {
            // a nullary variant ctor (`None`, `Nil`) is a fresh (or static)
            // box aliasing nothing; a BUILDER local (fresh container init,
            // append-only growth of admitted values — native's fresh-locals
            // recursion) holds no param pointer; every other ident must be a
            // scalar param.
            if (id.name == "None") { return true; }
            if (util.index_of_str(builders, id.name) >= 0) { return true; }
            return util.index_of_str(scalars, id.name) >= 0 || noesc_set_has(q, "0:", id.name);
        },
        ast.ExprUnary(u) => { return noesc_ret_expr_ok(u.operand, scalars, q, builders); },
        ast.ExprBinary(b) => {
            // A `+` tree witnessed by a string LITERAL anywhere in it is a
            // CONCAT — the result is a fresh owned buffer whatever the other
            // operands are (they are read and copied, never aliased), which
            // is rc_fe_rhs_tainted's own concat rule and native's
            // fresh-construction admission. Bare idents of any type are
            // admissible leaves there — the checker makes them strings.
            if (b.op == "+" && noesc_concat_witness(e)) { return noesc_concat_leaves_ok(e, scalars, q, builders); }
            return noesc_ret_expr_ok(b.left, scalars, q, builders) && noesc_ret_expr_ok(b.right, scalars, q, builders);
        },
        ast.ExprArray(ar) => {
            for el in ar.elements { if (!noesc_ret_expr_ok(el, scalars, q, builders)) { return false; } }
            return true;
        },
        ast.ExprTuple(tu) => {
            for el in tu.elements { if (!noesc_ret_expr_ok(el, scalars, q, builders)) { return false; } }
            return true;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { return false; }
            for fv in sl.field_values { if (!noesc_ret_expr_ok(fv, scalars, q, builders)) { return false; } }
            return true;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (!noesc_set_has(q, "", cid.name)) { return false; }
                    // A still-qualified FUNCTION's result aliases none of its
                    // arguments — that is the property being tracked — so the
                    // args are irrelevant (native composes the oracle the same
                    // way). A variant CTOR's box CONTAINS its payload args, so
                    // those stay strictly checked.
                    if (noesc_set_has(q, "fn:", cid.name)) { return true; }
                    for arg in c.args { if (!noesc_ret_expr_ok(arg, scalars, q, builders)) { return false; } }
                    return true;
                },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// noesc_concat_witness: some leaf of this `+` tree is a string literal, which
// is the syntactic proof the whole tree is string concatenation.
function noesc_concat_witness(e: ast.Expr): boolean {
    match (e) {
        ast.ExprString(_) => { return true; },
        ast.ExprBinary(b) => {
            if (b.op != "+") { return false; }
            return noesc_concat_witness(b.left) || noesc_concat_witness(b.right);
        },
        _ => { return false; }
    }
    return false;
}

function noesc_concat_leaves_ok(e: ast.Expr, scalars: string[], q: NoescSet, builders: string[]): boolean {
    match (e) {
        ast.ExprBinary(b) => {
            if (b.op != "+") { return noesc_ret_expr_ok(e, scalars, q, builders); }
            return noesc_concat_leaves_ok(b.left, scalars, q, builders) && noesc_concat_leaves_ok(b.right, scalars, q, builders);
        },
        ast.ExprIdent(_) => { return true; },
        _ => { return noesc_ret_expr_ok(e, scalars, q, builders); }
    }
    return false;
}

function noesc_scalar_type(t: string): boolean {
    return t == "i32" || t == "u32" || t == "i64" || t == "u64" || t == "f64" || t == "f32"
        || t == "u8" || t == "boolean" || t == "usize";
}

// noesc_decl_names: every declared local name (any nesting) — a local
// shadowing a scalar param's name would make the ident rule read the wrong
// binding, so shadowed names leave the scalar set.
function noesc_decl_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { a = a.append(v.name); },
            ast.StmtIf(f) => { a = noesc_decl_names(f.then_body, a); a = noesc_decl_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = noesc_decl_names(w.body, a); },
            ast.StmtFor(fo) => { a = a.append(fo.var_name); a = noesc_decl_names(fo.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = noesc_decl_names(arm.body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// noesc_builder_locals: the fn's BUILDER locals — declared exactly once, from
// a fresh container literal with admitted contents, and grown only by
// `x = x.append(<admitted>)` or replaced by another admitted fresh literal.
// No param pointer can reach such a local, so a `return x` of one aliases no
// param — native's fresh-locals recursion, subset form. Recomputed per
// fixpoint iteration: q only shrinks, so builders only shrink with it.
function noesc_builder_cands(stmts: ast.Stmt[], scalars: string[], q: NoescSet, declared: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var none: string[] = [];
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                var fresh_lit: boolean = false;
                match (v.init) {
                    ast.ExprArray(_) => { fresh_lit = true; },
                    ast.ExprTuple(_) => { fresh_lit = true; },
                    ast.ExprStructLit(_) => { fresh_lit = true; },
                    _ => {}
                }
                if (fresh_lit && noesc_ret_expr_ok(v.init, scalars, q, none)) {
                    var dc: i32 = 0;
                    for dn in declared { if (dn == v.name) { dc = dc + 1; } }
                    if (dc == 1) { a = a.append(v.name); }
                }
            },
            ast.StmtIf(f) => { a = noesc_builder_cands(f.then_body, scalars, q, declared, a); a = noesc_builder_cands(f.else_body, scalars, q, declared, a); },
            ast.StmtWhile(w) => { a = noesc_builder_cands(w.body, scalars, q, declared, a); },
            ast.StmtFor(fo) => { a = noesc_builder_cands(fo.body, scalars, q, declared, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = noesc_builder_cands(arm.body, scalars, q, declared, a); }
            },
            _ => {}
        }
    }
    return a;
}

function noesc_builder_assign_ok(stmts: ast.Stmt[], cands: string[], scalars: string[], q: NoescSet, bad: string[]): string[] {
    var b: string[] = bad;
    var none: string[] = [];
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (util.index_of_str(cands, a.target) >= 0) {
                    var ok: boolean = false;
                    match (a.value) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprFieldAccess(fa) => {
                                    match (fa.obj) {
                                        ast.ExprIdent(oid) => {
                                            if (oid.name == a.target && fa.field == "append" && c.args.len() == 1
                                                && noesc_ret_expr_ok(c.args[0], scalars, q, none)) { ok = true; }
                                        },
                                        _ => {}
                                    }
                                },
                                _ => {}
                            }
                        },
                        ast.ExprArray(_) => { ok = noesc_ret_expr_ok(a.value, scalars, q, none); },
                        ast.ExprTuple(_) => { ok = noesc_ret_expr_ok(a.value, scalars, q, none); },
                        ast.ExprStructLit(_) => { ok = noesc_ret_expr_ok(a.value, scalars, q, none); },
                        _ => {}
                    }
                    if (!ok) { b = b.append(a.target); }
                }
            },
            ast.StmtIf(f) => { b = noesc_builder_assign_ok(f.then_body, cands, scalars, q, b); b = noesc_builder_assign_ok(f.else_body, cands, scalars, q, b); },
            ast.StmtWhile(w) => { b = noesc_builder_assign_ok(w.body, cands, scalars, q, b); },
            ast.StmtFor(fo) => { b = noesc_builder_assign_ok(fo.body, cands, scalars, q, b); },
            ast.StmtMatch(m) => {
                for arm in m.arms { b = noesc_builder_assign_ok(arm.body, cands, scalars, q, b); }
            },
            _ => {}
        }
    }
    return b;
}

function noesc_builder_locals(fn: parser.FuncDecl, scalars: string[], q: NoescSet, declared: string[]): string[] {
    var cands: string[] = noesc_builder_cands(fn.body, scalars, q, declared, []);
    var bad: string[] = noesc_builder_assign_ok(fn.body, cands, scalars, q, []);
    var out: string[] = [];
    for c in cands { if (util.index_of_str(bad, c) < 0) { out = out.append(c); } }
    return out;
}

function noesc_collect_rets(stmts: ast.Stmt[], acc: ast.Expr[]): ast.Expr[] {
    var a: ast.Expr[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { a = a.append(r.value); },
            ast.StmtIf(f) => { a = noesc_collect_rets(f.then_body, a); a = noesc_collect_rets(f.else_body, a); },
            ast.StmtWhile(w) => { a = noesc_collect_rets(w.body, a); },
            ast.StmtFor(fo) => { a = noesc_collect_rets(fo.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = noesc_collect_rets(arm.body, a); }
            },
            _ => {}
        }
    }
    return a;
}

pub function noesc_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    // Variant ctor names count as qualified callees (a ctor is a fresh box
    // whose qualifying args cannot alias a param), seeded permanently.
    var q: string[] = ["Some", "Ok", "Err"];
    // "fn:" rows mark FUNCTION callees (as opposed to variant ctors): a
    // still-qualified function's result aliases none of its arguments, so
    // the Call arm skips the per-arg admission for them — native's
    // composition — while a ctor's payload args stay strictly checked.
    for fn in funcs { q = q.append(fn.name); q = q.append("fn:" + fn.name); }
    for sd in structs {
        if (sd.enum_owner.len() > 0) {
            q = q.append(sd.name);
            if (sd.fields.len() == 0) { q = q.append("0:" + sd.name); }
        }
    }
    var qs: NoescSet = noesc_set_of(q);
    var changed: boolean = true;
    while (changed) {
        changed = false;
        for fn in funcs {
            if (!noesc_set_has(qs, "", fn.name)) { continue; }
            var declared: string[] = noesc_decl_names(fn.body, []);
            var scalars: string[] = [];
            var pi: i32 = 0;
            while (pi < fn.params.len()) {
                if (noesc_scalar_type(fn.params[pi].type_name)
                    && util.index_of_str(declared, fn.params[pi].name) < 0) { scalars = scalars.append(fn.params[pi].name); }
                pi = pi + 1;
            }
            var builders: string[] = noesc_builder_locals(fn, scalars, qs, declared);
            var rets: ast.Expr[] = noesc_collect_rets(fn.body, []);
            var ok: boolean = true;
            for r in rets { if (!noesc_ret_expr_ok(r, scalars, qs, builders)) { ok = false; } }
            if (!ok) {
                qs = noesc_set_kill(qs, fn.name);
                changed = true;
            }
        }
    }
    var out: string[] = [];
    for fn in funcs { if (noesc_set_has(qs, "", fn.name)) { out = out.append(fn.name + "|"); } }
    return out;
}

// array_ret_fn_names is the plain "return type is an array" scan — the default
// arr_ret_fns for callers with no wider whole-program view to draw on.
pub function array_ret_fn_names(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (is_array_type_name(fn.ret_type)) {
            out = out.append(fn.name);
            // Methods also get the qualified "<BaseType>.<method>" key — see
            // ircore.array_ret_fns_of, whose entries this mirrors.
            if (fn.receiver_type.len() > 0) {
                out = out.append(util.base_type_name(fn.receiver_type) + "." + fn.name);
            }
        }
    }
    return out;
}

// fn_sigs_of derives every registry in FnSigs from one `funcs` list plus the
// struct-decl view field layouts resolve against. `arr_ret_fns` is supplied by
// the caller because each backend scopes it differently (a whole-program union
// vs the module's own array-returning names), and `consume_safe_params` starts
// empty — only the inter-procedural emit paths compute one.
//
// Callers on the Perceus emit paths pass the precomputed fixpoint
// (borrowable_params_interproc) to fn_sigs_for_borrow below, which is
// deliberately NOT borrowable_params_of's single pass.
pub function fn_sigs_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[], arr_ret_fns: string[]): FnSigs {
    return fn_sigs_for_borrow(funcs, structs, arr_ret_fns, borrowable_params_of(funcs));
}

// fn_sigs_for_borrow is fn_sigs_of with the borrowability verdict SUPPLIED. The
// emit paths hold the interprocedural fixpoint and used to override the field
// afterwards, which left fn_sigs_of's single pass — and the whole-program
// strfld scan derived from it — computed and thrown away. Two registries in
// FnSigs read that verdict, so both are built here from the one argument
// (#6703): a strfld admission derived from a WEAKER registry than the one the
// backend seeds "strfldok:" from would free fields nothing retained.
pub function fn_sigs_for_borrow(funcs: parser.FuncDecl[], structs: parser.StructDecl[], arr_ret_fns: string[], bparams: string[]): FnSigs {
    // Hoisted: the counted-retain registry needs the same verdict the
    // construction-side string retain is gated on, and this walk is
    // whole-program — computing it twice would be a second pass over every body.
    var sfok: string[] = strfld_reclaim_ok_types_of(funcs, structs, bparams);
    // The counted-retain verdict is computed here and folded into the
    // borrowability registry the escape walker threads, so the two registries
    // cannot disagree about a position and the walker needs no extra parameter.
    var pcnt: string[] = param_counted_of(funcs, structs, sfok);
    var breg: string[] = borrow_reg_with_counted(bparams, pcnt);
    var bbare: string[] = borrow_reg_bare_index(breg);
    return FnSigs {
        arr_ret_fns: sig_reg_of(arr_ret_fns),
        ret_type_fns: sig_reg_of(ret_type_fns_of(funcs)),
        ret_fn_sigs: sig_reg_of(ret_fn_sigs_of(funcs)),
        noesc_ret_fns: sig_reg_of(noesc_ret_fns_of(funcs, structs)),
        str_ret_fns: sig_reg_of(str_ret_fns_of(funcs)),
        bool_ret_fns: sig_reg_of(bool_ret_fns_of(funcs)),
        strarr_ret_fns: sig_reg_of(strarr_ret_fns_of(funcs)),
        arr_method_fns: arr_method_fns_of(funcs),
        opt_ret_fns: sig_reg_of(opt_ret_fns_of(funcs)),
        i64_ret_fns: sig_reg_of(i64_ret_fns_of(funcs)),
        tuple_ret_fns: sig_reg_of(tuple_ret_fns_of(funcs)),
        arrtup_ret_fns: sig_reg_of(arrtup_ret_fns_of(funcs)),
        struct_ret_fns: sig_reg_of(struct_ret_fns_of(funcs, structs)),
        map_ret_fns: sig_reg_of(map_ret_fns_of(funcs)),
        f64_ret_fns: sig_reg_of(f64_ret_fns_of(funcs)),
        f64arr_ret_fns: sig_reg_of(f64arr_ret_fns_of(funcs)),
        i64arr_ret_fns: sig_reg_of(i64arr_ret_fns_of(funcs)),
        erased_elem_ret_fns: sig_reg_of(erased_elem_ret_fns_of(funcs, structs)),
        fn_param_sigs: sig_reg_of(fn_param_sigs_of(funcs, structs)),
        closure_fns: closure_and_fnptr_fns_of(funcs, structs),
        closurearr_ret_fns: closurearr_ret_fns_of(funcs, structs),
        const_fns: const_fns_of(funcs),
        borrowable_params: breg,
        borrow_bare: bbare,
        fn_names: sig_reg_of(fn_names_of(funcs)),
        fresh_struct_ret_fns: fresh_struct_ret_fns_of(funcs, structs),
        consume_safe_params: [],
        return_fresh_struct_ret_fns: return_fresh_struct_ret_fns_of(funcs, structs, sfok),
        recv_borrow_fns: recv_borrow_fns_of(funcs, structs, bparams),
        str_fresh_ret_fns: str_fresh_ret_fns_of(funcs),
        opt_fresh_ret_fns: sig_reg_of(opt_fresh_ret_fns_of(funcs, structs)),
        strfld_ok_types: sfok,
        tuple_fresh_ret_fns: tuple_fresh_ret_fns_of(funcs),
        own_positions: own_positions_of(funcs),
        consumed_arr_positions: consumed_arr_positions_of(funcs),
        param_counted: pcnt,
        trmc_consume_fns: trmc_consume_fns_of(funcs, structs),
        handback_params: handback_params_of(funcs),
    };
}

// handback_params_of: "fn|idx" for every parameter some return hands back
// BARE — see the FnSigs field comment. Only direct `return <param>` counts;
// a param stored into a returned construction takes the construction's
// counted retain and is not a hand-back.
pub function handback_params_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rets: ast.Expr[] = noesc_collect_rets(fn.body, []);
        var pi: i32 = 0;
        while (pi < fn.params.len()) {
            var hit: boolean = false;
            for r in rets {
                match (r) {
                    ast.ExprIdent(rid) => { if (rid.name == fn.params[pi].name) { hit = true; } },
                    _ => {}
                }
            }
            if (hit) { out = out.append(fn.name + "|" + util.i32_to_string(pi)); }
            pi = pi + 1;
        }
    }
    return out;
}

// trmc_consume_fns_of scans for TRMC functions whose loop may consume its
// scrutinee, as "<fn>|<matched param index>" (#5333). The index rides along
// because the call site needs it to know WHICH argument to retain, and
// recovering it there would mean re-deriving the match shape per call.
pub function trmc_consume_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (trmc_eligible(fn, structs).len() > 0 && trmc_consume_safe(fn, structs)
                && !trmc_name_taken_as_value(funcs, fn.name)) {
            var mp: i32 = trmc_matched_param(fn);
            if (mp >= 0) { out = out.append(fn.name + "|" + util.i32_to_string(mp)); }
        }
    }
    return out;
}

// trmc_name_taken_as_value reports whether `name` is used as a VALUE anywhere —
// a bare ident in any position other than the callee of a direct call.
//
// The retain lives at the DIRECT call site, so a function reached through a
// function value (`var f = inc_all; f(keep)`) would consume without anyone
// retaining — the same use-after-free the retain exists to prevent, arriving by
// a route the call site cannot see. A function whose address is taken anywhere
// is therefore refused the verdict outright rather than trusted not to be called
// that way.
function trmc_name_taken_as_value(funcs: parser.FuncDecl[], name: string): boolean {
    for fn in funcs {
        if (tv_stmts(fn.body, name)) { return true; }
    }
    return false;
}

function tv_expr(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprCall(c) => {
            // The callee of a direct call is a CALL, not a value — that is the one
            // position the retain covers.
            var direct: boolean = false;
            match (c.callee) {
                ast.ExprIdent(cid) => { if (cid.name == name) { direct = true; } },
                _ => {}
            }
            if (!direct && tv_expr(c.callee, name)) { return true; }
            for arg in c.args { if (tv_expr(arg, name)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return tv_expr(b.left, name) || tv_expr(b.right, name); },
        ast.ExprUnary(u) => { return tv_expr(u.operand, name); },
        ast.ExprIndex(ix) => { return tv_expr(ix.array, name) || tv_expr(ix.index, name); },
        ast.ExprSlice(sl) => { return tv_expr(sl.array, name) || tv_expr(sl.start, name) || tv_expr(sl.end, name); },
        ast.ExprFieldAccess(fa) => { return tv_expr(fa.obj, name); },
        ast.ExprArray(a) => {
            var ai: i32 = 0;
            while (ai < a.elements.len()) { if (tv_expr(a.elements[ai], name)) { return true; } ai = ai + 1; }
            return false;
        },
        ast.ExprTuple(tu) => {
            var ti: i32 = 0;
            while (ti < tu.elements.len()) { if (tv_expr(tu.elements[ti], name)) { return true; } ti = ti + 1; }
            return false;
        },
        ast.ExprStructLit(slit) => {
            if (slit.has_base && tv_expr(slit.base, name)) { return true; }
            var fi: i32 = 0;
            while (fi < slit.field_values.len()) { if (tv_expr(slit.field_values[fi], name)) { return true; } fi = fi + 1; }
            return false;
        },
        ast.ExprLambda(lm) => { return tv_stmts(lm.body, name); },
        _ => { return false; }
    }
    return false;
}

function tv_stmts(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (tv_stmt(stmt, name)) { return true; } }
    return false;
}

function tv_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return tv_expr(v.init, name); },
        ast.StmtReturn(r) => { return tv_expr(r.value, name); },
        ast.StmtExpr(ex) => { return tv_expr(ex.value, name); },
        ast.StmtAssign(a) => { return tv_expr(a.value, name); },
        ast.StmtIf(iff) => {
            return tv_expr(iff.cond, name) || tv_stmts(iff.then_body, name) || tv_stmts(iff.else_body, name);
        },
        ast.StmtWhile(w) => { return tv_expr(w.cond, name) || tv_stmts(w.body, name); },
        ast.StmtFor(f) => { return tv_expr(f.iter, name) || tv_stmts(f.body, name); },
        ast.StmtMatch(m) => {
            if (tv_expr(m.scrutinee, name)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && tv_expr(arm.guard, name)) { return true; }
                if (tv_stmts(arm.body, name)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return tv_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}

// fn_sigs_with_dyn folds the module's `dyn Trait` method requirements into the
// return-type registries, which the `*_of` classifiers only key for concrete
// impl types. The module-level emit paths apply this; the analysis-only
// lowerings (which never see a trait object) do not.
pub function fn_sigs_with_dyn(sg: FnSigs, trait_reqs: parser.TraitReq[]): FnSigs {
    return FnSigs { ...sg,
        str_ret_fns: sig_reg_of(append_dyn_str_ret_fns(sg.str_ret_fns.rows, trait_reqs)),
        strarr_ret_fns: sig_reg_of(append_dyn_arr_ret_fns(sg.strarr_ret_fns.rows, trait_reqs, "string[]")),
        i64_ret_fns: sig_reg_of(append_dyn_i64_ret_fns(sg.i64_ret_fns.rows, trait_reqs)),
        f64_ret_fns: sig_reg_of(append_dyn_f64_ret_fns(sg.f64_ret_fns.rows, trait_reqs)),
        f64arr_ret_fns: sig_reg_of(append_dyn_arr_ret_fns(sg.f64arr_ret_fns.rows, trait_reqs, "f64[]")),
    };
}

// lower_func_for is the common-case wrapper over lower_func for callers that
// have only a `funcs` list: it derives the registries with fn_sigs_of. NOT for
// the inter-procedural Perceus emit paths, which thread a precomputed
// borrowable_params fixpoint and build their FnSigs directly.
pub function lower_func_for(fn: parser.FuncDecl, arr_ret_fns: string[], structs: parser.StructDecl[], funcs: parser.FuncDecl[]): LowerResult {
    return lower_func(fn, structs, fn_sigs_of(funcs, structs, arr_ret_fns), false);
}

// lower_func_for_noret is lower_func_for with the array- and string-return name
// sets left empty. The IR-eligibility scanners (asm_ir's calls_only_known /
// const_funcs_only_known) lower a function only to inspect the resulting op
// kinds, so the move-tracking name sets that the array/string return args feed
// are irrelevant there; passing them empty keeps those scans matching their
// previous behaviour while sharing the side-table derivation.
pub function lower_func_for_noret(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[]): LowerResult {
    // Pass the SAME return-type registries the emit path (lower_func_for) uses,
    // not empty lists. This function backs the eligibility checks
    // (calls_only_known / const_funcs_only_known), which resolve a call's
    // dispatch target via the receiver's inferred type. Without str_ret_fns a
    // string-returning METHOD-call receiver (`s.m()` in `s.m().n()`) types as
    // i32, so the chained `.n()` mis-resolves to `i32.n` and the check wrongly
    // BAILs an otherwise-fine module. Mirroring the emit lists keeps the gate
    // and the emit in agreement (and never admits a module the emit can't lower,
    // since both now lower identically).
    var arr_ret: string[] = array_ret_fn_names(funcs);
    return lower_func(fn, structs, fn_sigs_of(funcs, structs, arr_ret), false);
}

// rc_scalar_type_name: the leak-free scalar value types — no heap box, so
// they can appear anywhere in a consumed/owned type without RC wiring.
function rc_scalar_type_name(t: string): boolean {
    return t == "i32" || t == "boolean" || t == "i64" || t == "f64" || t == "f32"
        || t == "u8" || t == "u32" || t == "u64" || t == "usize" || t == "char" || t == "void";
}

// rc_struct_decl_index returns the index of the PLAIN struct decl named `t`
// (enum-variant payload structs, which carry enum_owner, don't count), or -1.
function rc_struct_decl_index(structs: parser.StructDecl[], t: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == t && structs[i].enum_owner.len() == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// rc_enum_has_variants reports whether `t` names a user enum — i.e. at least
// one variant struct carries enum_owner == t.
function rc_enum_has_variants(structs: parser.StructDecl[], t: string): boolean {
    for sd in structs {
        if (sd.enum_owner == t) { return true; }
    }
    return false;
}

// rc_seen_has / rc_seen marks the named-type recursion guard for the two type
// walks below (self-recursive structs/enums terminate as native's `seen` map).
function rc_seen_has(seen: string[], key: string): boolean {
    var i: i32 = 0;
    while (i < seen.len()) {
        if (seen[i] == key) { return true; }
        i = i + 1;
    }
    return false;
}

// rc_type_string_array_free is the port of native typeIsStringArrayFree
// (internal/ir/rc_caps.go): true when the type transitively contains no
// string / array / slice / Map — the gate that keeps a param on the
// owned-by-default baseline instead of the consumed-threading promotion.
function rc_type_string_array_free(t: string, structs: parser.StructDecl[], seen: string[]): boolean {
    if (rc_scalar_type_name(t)) { return true; }
    if (t == "string") { return false; }
    if (is_array_type_name(t)) { return false; }
    if (t == "Map" || util.base_type_name(t) == "Map") { return false; }
    if (t.len() > 1 && t[0] == b'(') {   // tuple: every element
        var tags: string = tuple_elem_tags(t);
        var depth: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= tags.len()) {
            if (i == tags.len() || (tags[i] == b',' && depth == 0)) {
                if (!rc_type_string_array_free(slice_unchecked(tags, start, i), structs, seen)) { return false; }
                start = i + 1;
            } else if (tags[i] == b'[' || tags[i] == b'(') { depth = depth + 1; }
            else if (tags[i] == b']' || tags[i] == b')') { depth = depth - 1; }
            i = i + 1;
        }
        return true;
    }
    var si: i32 = rc_struct_decl_index(structs, t);
    if (si >= 0) {
        if (rc_seen_has(seen, "s:" + t)) { return true; }
        var seen2: string[] = seen.append("s:" + t);
        var f: i32 = 0;
        while (f < structs[si].fields.len()) {
            if (!rc_type_string_array_free(structs[si].fields[f].type_name, structs, seen2)) { return false; }
            f = f + 1;
        }
        return true;
    }
    if (rc_enum_has_variants(structs, t)) {
        if (rc_seen_has(seen, "e:" + t)) { return true; }
        var seen3: string[] = seen.append("e:" + t);
        for sd in structs {
            if (sd.enum_owner == t) {
                for fld in sd.fields {
                    if (!rc_type_string_array_free(fld.type_name, structs, seen3)) { return false; }
                }
            }
        }
        return true;
    }
    return false;
}

// rc_consumed_drop_wired is the port of native consumedDropWired
// (internal/ir/ir.go): every type reachable from `t` has its deep-drop glue
// wired — strings and arrays ARE wired (unlike the string-array-free gate),
// Map and unknown runtime handles (Reader / Writer / MapIter / undeclared
// names) are not.
function rc_consumed_drop_wired(t: string, structs: parser.StructDecl[], seen: string[]): boolean {
    if (rc_scalar_type_name(t) || t == "string") { return true; }
    if (is_array_type_name(t)) { return rc_consumed_drop_wired(slice_unchecked(t, 0, t.len() - 2), structs, seen); }
    if (t == "Map" || util.base_type_name(t) == "Map") { return false; }
    if (t.len() > 1 && t[0] == b'(') {
        var tags: string = tuple_elem_tags(t);
        var depth: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= tags.len()) {
            if (i == tags.len() || (tags[i] == b',' && depth == 0)) {
                if (!rc_consumed_drop_wired(slice_unchecked(tags, start, i), structs, seen)) { return false; }
                start = i + 1;
            } else if (tags[i] == b'[' || tags[i] == b'(') { depth = depth + 1; }
            else if (tags[i] == b']' || tags[i] == b')') { depth = depth - 1; }
            i = i + 1;
        }
        return true;
    }
    var si: i32 = rc_struct_decl_index(structs, t);
    if (si >= 0) {
        if (rc_seen_has(seen, "s:" + t)) { return true; }
        var seen2: string[] = seen.append("s:" + t);
        var f: i32 = 0;
        while (f < structs[si].fields.len()) {
            if (!rc_consumed_drop_wired(structs[si].fields[f].type_name, structs, seen2)) { return false; }
            f = f + 1;
        }
        return true;
    }
    if (rc_enum_has_variants(structs, t)) {
        if (rc_seen_has(seen, "e:" + t)) { return true; }
        var seen3: string[] = seen.append("e:" + t);
        for sd in structs {
            if (sd.enum_owner == t) {
                for fld in sd.fields {
                    if (!rc_consumed_drop_wired(fld.type_name, structs, seen3)) { return false; }
                }
            }
        }
        return true;
    }
    return false;
}

// consumed_params_of is the port of native computeConsumedParams
// (internal/ir/rc_analysis.go, #4482 slice 2): the pointer-shaped
// struct/tuple params REASSIGNED in the body that are promoted to
// consumed-threading. The native paramVerdict ladder mostly drops out of
// this table's condition, so the effective port is:
//   not `own`  AND  reassigned in body  AND  struct- or tuple-typed  AND
//   deep-drop fully wired.
// A string/array-BEARING type is never owned-by-default, so promotion is
// unconditional there (matches native exactly). A string/array-FREE type
// is promoted by native only when borrow inference DEMOTED the param
// (verdict Borrowed — the non-escaping case; the borrowed-param
// over-release fix). The port has no cross-function escape analysis, so
// it promotes every reassigned scalar struct/tuple param — matching
// native for non-escaping params. Documented deviations: (a) a REASSIGNED
// scalar param that ESCAPES is Owned on native (not promoted) but
// promoted here — a corpus case with that shape would pin the gap;
// (b) native returns the empty table for TRMC'd functions, which the
// port doesn't model.
pub function consumed_params_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    var reassigned: string[] = body_assign_targets(fn.body);
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        var p: ast.ParamDecl = fn.params[pi];
        var hit: boolean = !p.own && rc_seen_has(reassigned, p.name);
        if (hit) {
            var is_struct: boolean = rc_struct_decl_index(structs, p.type_name) >= 0;
            var is_tuple: boolean = p.type_name.len() > 1 && p.type_name[0] == b'(';
            hit = is_struct || is_tuple;
        }
        if (hit && !rc_consumed_drop_wired(p.type_name, structs, [])) { hit = false; }
        if (hit) { out = out.append(p.name); }
        pi = pi + 1;
    }
    return out;
}

// --- freeEligible port (#4482, native computeFreeEligible) -------------------
//
// The borrow-aware free analysis: the set of locals (and own/consumed params)
// whose every written value is freshly OWNED, so their dec sites may reclaim
// at rc==0. Ported from internal/ir/rc_analysis.go:392 (post-#4399 shape) with
// ONE scoping cut: native's param owned-by-default ladder (paramVerdict) is
// NOT ported; a param here is non-tainted only when `own` or consumed-threaded
// (consumed_params_of), plus the string exemption the seed documents.
// Divergences that cut produces are PINNED per-case in TestSelfHostRcPlanDiff's
// diverge maps — the harness documents the gap.
//
// The cut is an ABI prerequisite, not analysis fidelity, and the pieces have to
// land together because each rung alone is a widening. What is missing, by
// native symbol:
//
//   - the caller-side retain that pairs with an owned param
//     (calleeParamOwnedByDefault, ir.go:6363) — without it, un-seeding a param
//     grants releases on a box the caller still owns, across this compiler's
//     n_params borrow boundary;
//   - a whole-program param-escape fixpoint (inferParamEscapes,
//     rc_analysis.go:794). Under BorrowInferEnabled every NON-escaping param is
//     demoted to borrowed, so a param reaches Owned by ESCAPING — the rung the
//     tuple-elem-extract-bind pin turns on. borrowable_params_of's header
//     records that this compiler has no such fixpoint, and the interproc cost
//     note downstream measures the budget one would have to fit;
//   - the vtable-dispatched and address-taken rungs (ir.go:6325) — not vacuous
//     here: `dyn Trait` and function values both lower through call_indirect,
//     and skipping them reproduces native's #6465 / #7307 crashes;
//   - an `escaped` set distinct from `tainted` (rc_analysis.go:2216), which
//     FeState does not have; native's owned-param credit reads `escaped`.
//
// The reachable prize is smaller than it looks: ownedByDefaultShapeIn
// (rc_caps.go:304) covers enum / struct / tuple only, so array, Map and string
// params already agree with this seed.

// rc_fe_taint adds name to the taint set if absent.
function rc_fe_taint(tainted: string[], name: string): string[] {
    if (util.index_of_str(tainted, name) >= 0) { return tainted; }
    return tainted.append(name);
}

// rc_fe_ptr_type: the declared/inferred TYPE NAME is pointer-shaped (its
// values live in heap boxes an alias could dangle on): arrays, strings,
// tuples, Map, user structs / enums. Scalars (i32/u32/i64/f64/boolean/usize)
// are not.
function rc_fe_ptr_type(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() == 0) { return false; }
    if (is_array_type_name(t)) { return true; }
    if (t == "string") { return true; }
    if (t[0] == b'(') { return true; }   // tuple
    if (t.len() >= 3 && slice_unchecked(t, 0, 3) == "Map") { return true; }
    if (rc_struct_decl_index(structs, t) >= 0) { return true; }
    if (rc_fe_is_enum_name(structs, t)) { return true; }
    return false;
}

// rc_fe_is_builtin_enum: `t` is a builtin rc enum (Option / Result), bare or
// generic-instantiated (`Option[..]` / `Result[..]`) — native's EnumType arm
// marks these freeEligible, but they carry no StructDecl so rc_fe_is_enum_name
// misses them.
function rc_fe_is_builtin_enum(t: string): boolean {
    if (t == "Option" || t == "Result") { return true; }
    if (t.len() >= 7 && slice_unchecked(t, 0, 7) == "Option[") { return true; }
    if (t.len() >= 7 && slice_unchecked(t, 0, 7) == "Result[") { return true; }
    return false;
}

// rc_fe_call_ret_type: the declared return type of a NON-GENERIC top-level
// function `name`, or "" (unknown / generic / not found). Lets an unannotated
// `var x = f(...)` local pick up f's heap return type so it reaches the
// eligibility gate, mirroring native computeFreeEligible reading the checker's
// resolved call type. Reads the FnSigs ret_type_fns registry (generic
// functions carry no row, so those stay "").
function rc_fe_call_ret_type(retreg: SigReg, name: string): string {
    return sig_reg_value_of(retreg, name);
}

// rc_fe_is_enum_name: `t` names an enum (some variant decl carries it as its
// enum_owner — the self-host has no standalone enum decl entry).
function rc_fe_is_enum_name(structs: parser.StructDecl[], t: string): boolean {
    for sd in structs {
        if (sd.enum_owner == t) { return true; }
    }
    return false;
}

// rc_fe_expr_type: best-effort type name of expression `e` for the pointer
// gates (projection unwrap + cast source). Bare ident → its recorded local /
// param type; index into T[] → T; field access → the field's decl type;
// anything else → "" (not pointer-shaped, so the walk stops — conservative
// toward NOT unwrapping, which over-taints nothing and under-taints only via
// projections the corpus will surface).
function rc_fe_expr_type(e: ast.Expr, types_n: string[], types_t: string[], structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprIdent(id) => {
            var i: i32 = 0;
            while (i < types_n.len()) {
                if (types_n[i] == id.name) { return types_t[i]; }
                i = i + 1;
            }
            return "";
        },
        ast.ExprIndex(ix) => {
            var bt: string = rc_fe_expr_type(ix.array, types_n, types_t, structs);
            if (is_array_type_name(bt)) { return slice_unchecked(bt, 0, bt.len() - 2) + ""; }
            return "";
        },
        ast.ExprFieldAccess(fa) => {
            var ot: string = rc_fe_expr_type(fa.obj, types_n, types_t, structs);
            var si: i32 = rc_struct_decl_index(structs, ot);
            if (si >= 0) {
                var fi: i32 = 0;
                while (fi < structs[si].fields.len()) {
                    if (structs[si].fields[fi].name == fa.field) { return structs[si].fields[fi].type_name; }
                    fi = fi + 1;
                }
            }
            return "";
        },
        ast.ExprString(_) => { return "string"; },
        ast.ExprLambda(_) => { return "fn"; },
        ast.ExprBinary(b) => {
            // string concat (`a + b` where an operand is a string) yields a fresh
            // owned string, mirroring native rhsTainted's IsStringConcat.
            if (b.op == "+" && (rc_fe_expr_type(b.left, types_n, types_t, structs) == "string" || rc_fe_expr_type(b.right, types_n, types_t, structs) == "string")) { return "string"; }
            return "";
        },
        ast.ExprCall(c) => {
            // an array-preserving method (`arr.with(i, v)`, chained) returns the
            // receiver's array type — native knows this from the checker; the
            // dump infers it so a `.with`-bound local reaches the eligibility
            // type-switch (else it stays "" and is wrongly dropped).
            match (c.callee) {
                ast.ExprFieldAccess(mfa) => {
                    if (mfa.field == "with") {
                        var rt: string = rc_fe_expr_type(mfa.obj, types_n, types_t, structs);
                        if (is_array_type_name(rt)) { return rt; }
                    }
                },
                _ => {}
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// rc_fe_escape: the UNCOUNTED-sink taint walk (native `escape`): a bare ident
// taints; a pointer-shaped index / field projection unwraps to its root; an
// array slice unwraps (string slices copy — fresh owned — and do not).
function rc_fe_escape(e: ast.Expr, tainted: string[], types_n: string[], types_t: string[], structs: parser.StructDecl[], env_n: string[], env_s: string[]): string[] {
    match (e) {
        ast.ExprIdent(id) => { return rc_fe_taint(tainted, rc_fe_resolve(env_n, env_s, id.name)); },
        ast.ExprIndex(ix) => {
            if (rc_fe_ptr_type(rc_fe_expr_type(e, types_n, types_t, structs), structs)) {
                return rc_fe_escape(ix.array, tainted, types_n, types_t, structs, env_n, env_s);
            }
            return tainted;
        },
        ast.ExprFieldAccess(fa) => {
            if (rc_fe_ptr_type(rc_fe_expr_type(e, types_n, types_t, structs), structs)) {
                return rc_fe_escape(fa.obj, tainted, types_n, types_t, structs, env_n, env_s);
            }
            return tainted;
        },
        ast.ExprSlice(sl) => {
            if (rc_fe_expr_type(sl.array, types_n, types_t, structs) != "string") {
                return rc_fe_escape(sl.array, tainted, types_n, types_t, structs, env_n, env_s);
            }
            return tainted;
        },
        _ => { return tainted; }
    }
    return tainted;
}

// rc_fe_escape_owned: the COUNTED-sink variant (native `escapeOwned`) — the
// sink dups a needsRcIncOnAlias source and the container's deep drop releases
// that dup, so a COUNTED source keeps a reference of its own and stays
// reclaimable (#7345). Only a source the sink stores UNCOUNTED taints: an
// ident whose type the alias-inc trigger declines (unknown "" stays the
// conservative taint — match bindings and unannotated inits land here, where
// native reads the checker; native's consuming-binding exemption is part of
// the same "" bucket until the consuming-bindings port). Projections were
// never tainted here — the sink dups those too.
function rc_fe_escape_owned(e: ast.Expr, tainted: string[], types_n: string[], types_t: string[], structs: parser.StructDecl[], env_n: string[], env_s: string[]): string[] {
    match (e) {
        ast.ExprIdent(id) => {
            // the counted set mirrors needsRcIncOnAlias's type switch: arrays,
            // strings, tuples/closures ("("-led), Map, user structs and enums
            // (rc_fe_ptr_type), builtin Option/Result, inferred lambda "fn".
            var t: string = rc_fe_expr_type(e, types_n, types_t, structs);
            if (rc_fe_ptr_type(t, structs) || rc_fe_is_builtin_enum(t) || t == "fn") { return tainted; }
            return rc_fe_taint(tainted, rc_fe_resolve(env_n, env_s, id.name));
        },
        _ => { return tainted; }
    }
    return tainted;
}

// FeState threads the taint set + the assigns table (parallel an/av arrays —
// a name may repeat) + the name->type table through the recursive sink walk.
struct FeState { tainted: string[], an: string[], av: ast.Expr[], av_env: string[], types_n: string[], types_t: string[], decl_s: string[], site_mode: boolean }

// The fe engine keys taint by BINDING-SITE id. In name mode (the dump path,
// native parity) the id IS the bare name, so every resolution falls back to
// the name and the analysis is byte-identical to the historical name-level
// one. In site mode the id is the binding's reclaim_site_key, and a scope
// environment (env_n/env_s, threaded as parameters so block recursion scopes
// it for free) resolves each use to its in-scope binding — the per-site
// verdicts the routed release gates consume, which a name-level verdict
// cannot supply for shadow siblings and binder collisions.
function rc_fe_bind_site(site_mode: boolean, name: string, line: i32, col: i32): string {
    if (site_mode) { return reclaim_site_key_of(name, line, col); }
    return name;
}

function rc_fe_resolve(env_n: string[], env_s: string[], name: string): string {
    var i: i32 = env_n.len() - 1;
    while (i >= 0) { if (env_n[i] == name) { return env_s[i]; } i = i - 1; }
    return name;
}

// Per-assign env snapshots are stored FLAT ("name\tsite\n" rows) so FeState
// carries only string[] fields — a string[][] field is outside the IR-eligible
// struct shapes and bailed the whole-module arm64 emit.
function rc_fe_env_encode(env_n: string[], env_s: string[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < env_n.len()) { out = out + env_n[i] + "\t" + env_s[i] + "\n"; i = i + 1; }
    return out;
}

function rc_fe_env_resolve(env: string, name: string): string {
    // last entry wins (shadowing): scan rows from the end.
    var last: string = name;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < env.len()) {
        if (env[i] == b'\n') {
            var t: i32 = start;
            while (t < i && env[t] != b'\t') { t = t + 1; }
            if (t < i && slice_unchecked(env, start, t) == name) { last = slice_unchecked(env, t + 1, i) + ""; }
            start = i + 1;
        }
        i = i + 1;
    }
    return last;
}

// rc_fe_collect_types: record every declared local's (name, type) pair,
// recursively. A destructure `var (a, b) = t` types each binding by splitting
// t's tuple annotation positionally (best-effort: bare-ident RHS only).
function rc_fe_collect_types(stmts: ast.Stmt[], s: FeState, structs: parser.StructDecl[], retreg: SigReg): FeState {
    var st: FeState = s;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (rc_fe_is_destructure(v.name)) {
                    // destructure (`var (a, b) = t` — parsed as a comma-joined
                    // name "a,b"): element types from the RHS ident's recorded
                    // tuple type, split at top-level commas.
                    var tt: string = rc_fe_expr_type(v.init, st.types_n, st.types_t, structs);
                    var names: string[] = rc_fe_split_csv(v.name);
                    var tys: string[] = [];
                    if (tt.len() > 2 && tt[0] == b'(') { tys = rc_fe_split_csv(slice_unchecked(tt, 1, tt.len() - 1)); }
                    var d: i32 = 0;
                    while (d < names.len()) {
                        var dt: string = "";
                        if (d < tys.len()) { dt = tys[d]; }
                        st = FeState { ...st, types_n: st.types_n.append(names[d]), types_t: st.types_t.append(dt), decl_s: st.decl_s.append(rc_fe_bind_site(st.site_mode, names[d], v.line, v.col)) };
                        d = d + 1;
                    }
                } else {
                    var t: string = v.type_name;
                    if (t.len() == 0) {
                        // minimal init inference: array / tuple / struct literals,
                        // enum variant ctors, and value-position IIFE matches
                        // (typed by an arm's constructed-variant owner).
                        match (v.init) {
                            ast.ExprArray(_) => { t = "i32[]"; },
                            ast.ExprTuple(tu) => { t = "("; var z: i32 = 0; while (z < tu.elements.len()) { if (z > 0) { t = t + ", "; } t = t + "i32"; z = z + 1; } t = t + ")"; },
                            ast.ExprStructLit(sl) => { t = sl.type_name; },
                            ast.ExprCall(cc) => {
                                match (cc.callee) {
                                    ast.ExprIdent(cid) => {
                                        var en: string = variant_enum_owner(structs, cid.name);
                                        if (en.len() > 0) { t = en; }
                                        else {
                                            // not a variant ctor: a plain call to a
                                            // non-generic function — the local takes
                                            // that function's declared return type
                                            // (native reads the checker's call type).
                                            t = rc_fe_call_ret_type(retreg, cid.name);
                                        }
                                    },
                                    ast.ExprLambda(_) => {
                                        // type from the first arm's CONSTRUCTED
                                        // result (a same-enum ctor), not its
                                        // pattern — a scalar-yield match stays
                                        // untyped (native infers i32 there).
                                        var iarms: ast.MatchArm[] = inarm_iife_match(v.init, structs);
                                        if (iarms.len() > 0 && iarms[0].body.len() == 1) {
                                            match (iarms[0].body[0]) {
                                                ast.StmtReturn(ir0) => {
                                                    match (ir0.value) {
                                                        ast.ExprCall(rc0) => {
                                                            match (rc0.callee) {
                                                                ast.ExprIdent(rid0) => {
                                                                    var en2: string = variant_enum_owner(structs, rid0.name);
                                                                    if (en2.len() > 0) { t = en2; }
                                                                },
                                                                _ => {}
                                                            }
                                                        },
                                                        _ => {}
                                                    }
                                                },
                                                _ => {}
                                            }
                                        }
                                    },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                        // Fallback for the init forms the explicit cases above
                        // don't name (string literal / concat, bare lambda,
                        // array-preserving method call) — rc_fe_expr_type reads
                        // the locals collected so far, so a chained `.with` off an
                        // earlier array local resolves.
                        if (t.len() == 0) { t = rc_fe_expr_type(v.init, st.types_n, st.types_t, structs); }
                    }
                    st = FeState { ...st, types_n: st.types_n.append(v.name), types_t: st.types_t.append(t), decl_s: st.decl_s.append(rc_fe_bind_site(st.site_mode, v.name, v.line, v.col)) };
                }
            },
            ast.StmtIf(f) => { st = rc_fe_collect_types(f.then_body, st, structs, retreg); st = rc_fe_collect_types(f.else_body, st, structs, retreg); },
            ast.StmtWhile(w) => { st = rc_fe_collect_types(w.body, st, structs, retreg); },
            ast.StmtFor(fr) => { st = rc_fe_collect_types(fr.body, st, structs, retreg); },
            ast.StmtMatch(m) => {
                for arm in m.arms { st = rc_fe_collect_types(arm.body, st, structs, retreg); }
            },
            _ => {}
        }
    }
    return st;
}

// rc_fe_is_destructure: a StmtVar name carrying a tuple destructure — the
// parser encodes `var (a, b) = t` as the comma-joined name "a,b".
function rc_fe_is_destructure(name: string): boolean {
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == b',') { return true; }
        i = i + 1;
    }
    return false;
}

// rc_fe_split_csv splits "a, b, c" at top-level commas (tuple-type aware:
// nested parens / brackets don't split), trimming spaces.
function rc_fe_split_csv(s: string): string[] {
    var out: string[] = [];
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= s.len()) {
        var split: boolean = i == s.len();
        if (!split) {
            var c: i32 = s[i] as i32;
            if (c == 40 || c == 91) { depth = depth + 1; }
            if (c == 41 || c == 93) { depth = depth - 1; }
            if (c == 44 && depth == 0) { split = true; }
        }
        if (split) {
            var piece: str = slice_unchecked(s, start, i);
            var a: i32 = 0;
            while (a < piece.len() && piece[a] == b' ') { a = a + 1; }
            var b: i32 = piece.len();
            while (b > a && piece[b - 1] == b' ') { b = b - 1; }
            if (b > a) { out = out.append(slice_unchecked(piece, a, b)); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// rc_fe_walk_expr: the sink walk over one expression (native's ast.Walk arms
// for StructLit / TupleLit / variant ctors / casts), recursing into
// subexpressions and IIFE lambda bodies (the self-host's value-position
// if/match desugar). Method-call sinks (Map_set / push / with) are ported as
// escape/escape_owned on their value arguments when they appear as
// `.set(...)` / `.append(...)` / `.with(...)` method calls.
// rc_fe_variant_ctor_args taints a variant construction's arguments, for both
// ctor spellings: counted when the enum's payloads are ones the construction
// takes a counted reference to, a full escape otherwise.
function rc_fe_variant_ctor_args(args: ast.Expr[], en: string, s: FeState, structs: parser.StructDecl[], env_n: string[], env_s: string[]): FeState {
    var st: FeState = s;
    var counted: boolean = enum_payloads_counted_at_ctor(structs, en);
    for arg in args {
        // A SCALAR payload cannot alias heap, so escaping it marks a source
        // nothing can reach through — and the any-tainted-arg call rule then
        // refuses every later call that merely passes the same scalar on:
        // `var e = A(i); var h = wrap(e, i)` lost h's whole struct credit to
        // the taint `A(i)` put on `i`. rc_fe_rhs_tainted's ExprBinary arm
        // draws this line already, for the same reason.
        if (rc_scalar_type_name(rc_fe_expr_type(arg, st.types_n, st.types_t, structs))) { continue; }
        if (counted) { st = FeState { ...st, tainted: rc_fe_escape_owned(arg, st.tainted, st.types_n, st.types_t, structs, env_n, env_s) }; }
        else { st = FeState { ...st, tainted: rc_fe_escape(arg, st.tainted, st.types_n, st.types_t, structs, env_n, env_s) }; }
    }
    return st;
}

function rc_fe_walk_expr(e: ast.Expr, s: FeState, structs: parser.StructDecl[], env_n: string[], env_s: string[]): FeState {
    var st: FeState = s;
    match (e) {
        ast.ExprStructLit(sl) => {
            for fv in sl.field_values {
                st = FeState { ...st, tainted: rc_fe_escape_owned(fv, st.tainted, st.types_n, st.types_t, structs, env_n, env_s) };
                st = rc_fe_walk_expr(fv, st, structs, env_n, env_s);
            }
            if (sl.has_base) { st = rc_fe_walk_expr(sl.base, st, structs, env_n, env_s); }
        },
        ast.ExprTuple(tu) => {
            var i: i32 = 0;
            while (i < tu.elements.len()) {
                st = FeState { ...st, tainted: rc_fe_escape_owned(tu.elements[i], st.tainted, st.types_n, st.types_t, structs, env_n, env_s) };
                st = rc_fe_walk_expr(tu.elements[i], st, structs, env_n, env_s);
                i = i + 1;
            }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    // Variant ctor: counted (escape_owned) when the construction
                    // takes a counted reference to the payload; full escape
                    // otherwise. The QUALIFIED spelling takes the same arm below —
                    // it had none at all, so `E.A(p)` was not modelled here while
                    // `A(p)` was, and the two spellings disagreed on whether the
                    // source stayed free-eligible.
                    if (variant_enum_owner(structs, id.name).len() > 0) {
                        st = rc_fe_variant_ctor_args(c.args, variant_enum_owner(structs, id.name), st, structs, env_n, env_s);
                    }
                },
                ast.ExprLambda(lam) => {
                    // value-position if/match IIFE: walk the body inline.
                    st = rc_fe_walk_stmts(lam.body, st, structs, env_n, env_s);
                },
                ast.ExprFieldAccess(fa) => {
                    if (variant_enum_owner(structs, fa.field).len() > 0) {
                        st = rc_fe_variant_ctor_args(c.args, variant_enum_owner(structs, fa.field), st, structs, env_n, env_s);
                    }
                    // method-call sinks on the receiver object.
                    if (fa.field == "set" && c.args.len() == 2) {
                        st = FeState { ...st, tainted: rc_fe_escape(c.args[0], st.tainted, st.types_n, st.types_t, structs, env_n, env_s) };
                        st = FeState { ...st, tainted: rc_fe_escape(c.args[1], st.tainted, st.types_n, st.types_t, structs, env_n, env_s) };
                    }
                    if ((fa.field == "append" || fa.field == "push") && c.args.len() == 1) {
                        st = FeState { ...st, tainted: rc_fe_escape_owned(c.args[0], st.tainted, st.types_n, st.types_t, structs, env_n, env_s) };
                    }
                    if (fa.field == "with" && c.args.len() == 2) {
                        // element-type gate (native: rc-tracked pointer elements
                        // counted, strings full-escape): approximate via the
                        // receiver's element type.
                        var rt: string = rc_fe_expr_type(fa.obj, st.types_n, st.types_t, structs);
                        var et: string = "";
                        if (is_array_type_name(rt)) { et = slice_unchecked(rt, 0, rt.len() - 2) + ""; }
                        if (et == "string") { st = FeState { ...st, tainted: rc_fe_escape(c.args[1], st.tainted, st.types_n, st.types_t, structs, env_n, env_s) }; }
                        else { st = FeState { ...st, tainted: rc_fe_escape_owned(c.args[1], st.tainted, st.types_n, st.types_t, structs, env_n, env_s) }; }
                    }
                },
                _ => {}
            }
            for arg in c.args { st = rc_fe_walk_expr(arg, st, structs, env_n, env_s); }
        },
        ast.ExprBinary(b) => { st = rc_fe_walk_expr(b.left, st, structs, env_n, env_s); st = rc_fe_walk_expr(b.right, st, structs, env_n, env_s); },
        ast.ExprUnary(u) => {
            // `expr as T` desugars to unary op "as_<T>": a pointer-shaped
            // operand cast to a non-pointer target escapes (raw address).
            if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
                var target: str = slice_unchecked(u.op, 3, u.op.len());
                if (!rc_fe_ptr_type(target, structs) && rc_fe_ptr_type(rc_fe_expr_type(u.operand, st.types_n, st.types_t, structs), structs)) {
                    st = FeState { ...st, tainted: rc_fe_escape(u.operand, st.tainted, st.types_n, st.types_t, structs, env_n, env_s) };
                }
            }
            st = rc_fe_walk_expr(u.operand, st, structs, env_n, env_s);
        },
        ast.ExprIndex(ix) => { st = rc_fe_walk_expr(ix.array, st, structs, env_n, env_s); st = rc_fe_walk_expr(ix.index, st, structs, env_n, env_s); },
        ast.ExprFieldAccess(fa) => { st = rc_fe_walk_expr(fa.obj, st, structs, env_n, env_s); },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { st = rc_fe_walk_expr(ar.elements[i], st, structs, env_n, env_s); i = i + 1; }
        },
        _ => {}
    }
    return st;
}

// rc_fe_walk_stmts: the statement-level sink walk — records assigns, taints
// binding forms, recurses into nested blocks and value expressions.
function rc_fe_walk_stmts(stmts: ast.Stmt[], s: FeState, structs: parser.StructDecl[], env_n: string[], env_s: string[]): FeState {
    var st: FeState = s;
    // The scope environment grows through THIS statement list and is passed
    // down into nested blocks; the recursion never hands its extensions back,
    // so lexical scoping falls out of the value threading.
    var en: string[] = env_n;
    var es: string[] = env_s;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                // A destructure's bindings are counted owners (each extracted
                // element is dup'd) — neither tainted nor recorded as assigns.
                if (!rc_fe_is_destructure(v.name)) {
                    var vsid: string = rc_fe_bind_site(st.site_mode, v.name, v.line, v.col);
                    // the init is evaluated in the env BEFORE this binding.
                    st = FeState { ...st, an: st.an.append(vsid), av: st.av.append(v.init), av_env: st.av_env.append(rc_fe_env_encode(en, es)) };
                    st = rc_fe_walk_expr(v.init, st, structs, en, es);
                    en = en.append(v.name);
                    es = es.append(vsid);
                } else {
                    st = rc_fe_walk_expr(v.init, st, structs, en, es);
                    var dns: string[] = rc_fe_split_csv(v.name);
                    var dd: i32 = 0;
                    while (dd < dns.len()) {
                        en = en.append(dns[dd]);
                        es = es.append(rc_fe_bind_site(st.site_mode, dns[dd], v.line, v.col));
                        dd = dd + 1;
                    }
                }
            },
            ast.StmtAssign(a) => {
                st = FeState { ...st, an: st.an.append(rc_fe_resolve(en, es, a.target)), av: st.av.append(a.value), av_env: st.av_env.append(rc_fe_env_encode(en, es)) };
                st = rc_fe_walk_expr(a.value, st, structs, en, es);
            },
            ast.StmtIf(f) => {
                st = rc_fe_walk_expr(f.cond, st, structs, en, es);
                st = rc_fe_walk_stmts(f.then_body, st, structs, en, es);
                st = rc_fe_walk_stmts(f.else_body, st, structs, en, es);
            },
            ast.StmtWhile(w) => { st = rc_fe_walk_expr(w.cond, st, structs, en, es); st = rc_fe_walk_stmts(w.body, st, structs, en, es); },
            ast.StmtFor(fr) => {
                // for-in bindings alias the iterated container — tainted at a
                // per-loop synthetic site scoped to the body, so a same-named
                // outer local keeps its own verdict in site mode.
                var names: string[] = rc_fe_split_csv(fr.var_name);
                var fen: string[] = en;
                var fes: string[] = es;
                var d: i32 = 0;
                while (d < names.len()) {
                    var fid: string = names[d];
                    if (st.site_mode) { fid = "forin:" + names[d]; }
                    st = FeState { ...st, tainted: rc_fe_taint(st.tainted, fid) };
                    fen = fen.append(names[d]);
                    fes = fes.append(fid);
                    d = d + 1;
                }
                st = rc_fe_walk_expr(fr.iter, st, structs, en, es);
                st = rc_fe_walk_stmts(fr.body, st, structs, fen, fes);
            },
            ast.StmtMatch(m) => {
                st = rc_fe_walk_expr(m.scrutinee, st, structs, en, es);
                for arm in m.arms {
                    var aen: string[] = en;
                    var aes: string[] = es;
                    match (arm.pattern) {
                        ast.PatVariant(pv) => {
                            // arm bindings alias enum payloads with no dup —
                            // tainted (no consuming-bindings port yet), at an
                            // arm-scoped synthetic site in site mode.
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                var bid: string = pv.binding;
                                if (st.site_mode) { bid = "arm:" + pv.binding; }
                                st = FeState { ...st, tainted: rc_fe_taint(st.tainted, bid) };
                                aen = aen.append(pv.binding);
                                aes = aes.append(bid);
                            }
                            var xb: i32 = 0;
                            while (xb < pv.extra_bindings.len()) {
                                if (pv.extra_bindings[xb] != "_") {
                                    var xid: string = pv.extra_bindings[xb];
                                    if (st.site_mode) { xid = "arm:" + pv.extra_bindings[xb]; }
                                    st = FeState { ...st, tainted: rc_fe_taint(st.tainted, xid) };
                                    aen = aen.append(pv.extra_bindings[xb]);
                                    aes = aes.append(xid);
                                }
                                xb = xb + 1;
                            }
                        },
                        _ => {}
                    }
                    st = rc_fe_walk_stmts(arm.body, st, structs, aen, aes);
                }
            },
            ast.StmtReturn(r) => { st = rc_fe_walk_expr(r.value, st, structs, en, es); },
            ast.StmtExpr(x) => { st = rc_fe_walk_expr(x.value, st, structs, en, es); },
            _ => {}
        }
    }
    return st;
}

// rc_fe_rhs_tainted: native rhsTainted — whether the value of `e` may alias a
// borrowed (tainted) value. Fresh constructions / literals / string concats /
// string slices are owned; ident reads the taint set; projections and array
// slices are tainted; calls are owned unless the receiver or any arg is
// tainted; unknown shapes default tainted.
function rc_fe_rhs_tainted(e: ast.Expr, tainted: string[], types_n: string[], types_t: string[], structs: parser.StructDecl[], noesc: SigReg, env: string): boolean {
    match (e) {
        ast.ExprArray(_) => { return false; },
        ast.ExprStructLit(_) => { return false; },
        ast.ExprTuple(_) => { return false; },
        ast.ExprLambda(_) => { return false; },   // a fresh closure is owned (native MakeClosure arm)
        ast.ExprIdent(id) => { return util.index_of_str(tainted, rc_fe_env_resolve(env, id.name)) >= 0; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprFieldAccess(fa) => {
            // Dup-at-extract, analysis half — native rhsTainted's FieldAccess
            // arm: an element read out of a TUPLE-typed local/param is a
            // COUNTED alias (the bind's container-read alias_inc / the
            // return-transfer retain), and the tuple's deep drop releases its
            // own claim, so the destination owns its reference. Map elements
            // stay tainted (their slot drop deep-frees the value column).
            // The STRUCT-source half of native's arm is deliberately not
            // ported — the conservative taint is the documented cut.
            if (util.is_all_digits(fa.field)) {
                match (fa.obj) {
                    ast.ExprIdent(_) => {
                        var fot: string = rc_fe_expr_type(fa.obj, types_n, types_t, structs);
                        if (util.is_tuple_type_name(fot) && !util.contains(fot, "=>")
                            && !is_map_type_name(tuple_type_elem_tag(fot, util.digits_to_i32(fa.field)))) { return false; }
                    },
                    _ => {}
                }
            }
            return true;
        },
        ast.ExprIndex(_) => { return true; },
        ast.ExprSlice(sl) => {
            if (rc_fe_expr_type(sl.array, types_n, types_t, structs) == "string") { return false; }
            return true;
        },
        ast.ExprBinary(_) => {
            // String concat copies into a fresh owned buffer, and every OTHER
            // binary (arithmetic / comparison / logical) yields a SCALAR that
            // cannot alias heap — native's rhsTainted answers false for both.
            // The old conservative default tainted any non-concat binary, so
            // `mkw(i % 8)` was refused through its own scalar ARGUMENT (the
            // any-tainted-arg call rule) — the alloc_flat fixtures' shape.
            return false;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // a variant constructor builds a FRESH owned rc=1 box (its
                    // pointer payloads are inc'd like a StructLit), so the
                    // result is reclaimable regardless of a payload arg's taint
                    // — native's variant-ctor rhsTainted -> false. Without this
                    // an enum built from a borrowed-param payload (`A(n)`)
                    // wrongly taints the enum local.
                    if (variant_enum_owner(structs, cid.name).len() > 0) { return false; }
                    // __alloc_u8(n): a fresh zero-filled rc=1 buffer straight
                    // from the runtime allocator, whose only argument is a
                    // SCALAR byte count — the result cannot alias it however
                    // tainted that count is. The generic any-arg-tainted rule
                    // below said otherwise, so `__alloc_u8(16)` (literal,
                    // untainted) reclaimed while `__alloc_u8(n_bytes)` never
                    // did, leaking one buffer per call out of int_to_string /
                    // __int_to_string_u64 / int_to_string_radix — i.e. out of
                    // every `n.to_string()` (#5931, native side; #5935 ports it).
                    //
                    // Sound only because the escape walk taints a buffer whose
                    // ADDRESS is handed out as a raw integer: rc_fe_walk_expr's
                    // `as_` arm escapes a pointer-shaped operand cast to a
                    // non-pointer target, which is what `s.bytes()` does when it
                    // passes `buf as usize` to __memcpy. Without that guard this
                    // untaint would reclaim a buffer still being written through
                    // the raw pointer.
                    if (cid.name == "__alloc_u8") { return false; }
                    // random_bytes(n): same argument — a fresh rc=1 u8[] box
                    // whose only argument is a scalar byte count.
                    if (cid.name == "random_bytes") { return false; }
                    // tcp_recv(fd, max): a fresh rc=1 u8[] box; both
                    // arguments are scalars (fd, byte count).
                    if (cid.name == "tcp_recv") { return false; }
                    // slice_unchecked(s, a, b): the ExprSlice string arm
                    // spelled as a builtin — same untainted result.
                    if (cid.name == "slice_unchecked" && c.args.len() == 3) { return false; }
                    // returns-no-param-escape callee (native #4357's rule via
                    // the subset oracle): the result is fresh however tainted
                    // the inputs — they are only READ to build it.
                    if (sig_reg_has_name(noesc, cid.name)) { return false; }
                },
                ast.ExprFieldAccess(fa) => {
                    // method call: aliases the receiver only.
                    return rc_fe_rhs_tainted(fa.obj, tainted, types_n, types_t, structs, noesc, env);
                },
                _ => {}
            }
            for arg in c.args {
                if (rc_fe_rhs_tainted(arg, tainted, types_n, types_t, structs, noesc, env)) { return true; }
            }
            return false;
        },
        _ => { return true; }
    }
    return true;
}

// free_eligible_of: the ported analysis. Returns the name-set (unsorted) of
// freeEligible locals + own/consumed params for `fn`.
pub function free_eligible_of(fn: parser.FuncDecl, structs: parser.StructDecl[], retreg: SigReg, noesc: SigReg): string[] {
    return rc_fe_run(fn, structs, retreg, noesc, false);
}

// free_eligible_sites_of: the same analysis keyed by BINDING SITE — the
// verdicts the plan-routed release gates consume. A shadow-sibling pair or a
// binder collision resolves per binding here, where the name-level dump
// variant (kept above for native parity) must collapse them.
pub function free_eligible_sites_of(fn: parser.FuncDecl, structs: parser.StructDecl[], retreg: SigReg, noesc: SigReg): string[] {
    return rc_fe_run(fn, structs, retreg, noesc, true);
}

function rc_fe_run(fn: parser.FuncDecl, structs: parser.StructDecl[], retreg: SigReg, noesc: SigReg, site_mode: boolean): string[] {
    var st: FeState = FeState { tainted: [], an: [], av: [], av_env: [], types_n: [], types_t: [], decl_s: [], site_mode: site_mode };
    // param types recorded first (projection unwrap + destructure typing).
    var consumed: string[] = consumed_params_of(fn, structs);
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        var p: ast.ParamDecl = fn.params[pi];
        // params keep NAME identity in both modes: the routed gates only ever
        // query local binding-site keys, and the resolve fallback returns the
        // bare name for anything the env does not hold.
        st = FeState { ...st, types_n: st.types_n.append(p.name), types_t: st.types_t.append(p.type_name), decl_s: st.decl_s.append(p.name) };
        // taint seed: every NON-SCALAR, NON-STRING param that is neither `own`
        // nor consumed-threaded. A scalar param cannot alias heap. The STRING
        // exemption is ours, not native's: seeding it poisoned every call
        // through the any-tainted-arg rule — a scalar arg (`nodeB(s, n)`, the
        // alloc_flat shape) and then a bare string arg (`node(pre, mk(), n)`,
        // the StrArrFieldBufferRelease shape) each refused an entire fixture's
        // credits — and it is what lets #7553's aliased-param borrow reclaim
        // the caller's local. It is load-bearing: pinned by the rc-plan case
        // `fe-string-param-alias` and by the leak matrix's
        // `str__fnscope__alias_param` cell, which is `leak clean` on arm64
        // (native leaks it, #7446) and passes its FERN_SANITIZE leg.
        //
        // Native does NOT exempt a string param — ownedByDefaultShapeIn
        // (internal/ir/rc_caps.go:304) switches on EnumType / StructType /
        // TupleType and returns false for everything else, so native's seed
        // (rc_analysis.go:2228) taints it like any other borrowed param. An
        // earlier version of this comment claimed the opposite and used it as
        // the justification; the exemption is right, the reason was not.
        //
        // What is NOT ported is the enum/struct/tuple rung, and the blocker is
        // an ABI half rather than analysis fidelity: native's owned-by-default
        // param is two-sided — the CALLER retains the argument
        // (calleeParamOwnedByDefault, internal/ir/ir.go:6363) and the callee's
        // exit sweep spends that count. This compiler has no caller-side
        // retain, and `emit_dec_sweep_except`'s n_params borrow boundary is
        // the opposite invariant. Un-seeding a container param here without
        // that retain does not credit the param (no slot predicate accepts a
        // param slot); it only lets taint stop flowing to locals derived from
        // it, which grants releases on a box the caller still owns. Array and
        // Map params are not part of that rung at all — native has no arm for
        // them either, so they already agree.
        if (!p.own && util.index_of_str(consumed, p.name) < 0 && !rc_scalar_type_name(p.type_name) && p.type_name != "string") {
            st = FeState { ...st, tainted: rc_fe_taint(st.tainted, p.name) };
        }
        pi = pi + 1;
    }
    st = rc_fe_collect_types(fn.body, st, structs, retreg);
    var root_en: string[] = [];
    var root_es: string[] = [];
    st = rc_fe_walk_stmts(fn.body, st, structs, root_en, root_es);
    // fixpoint: forward taint via rhs, backward via bare-ident aliasing.
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var i: i32 = 0;
        while (i < st.an.len()) {
            var name: string = st.an[i];
            if (util.index_of_str(st.tainted, name) < 0 && rc_fe_rhs_tainted(st.av[i], st.tainted, st.types_n, st.types_t, structs, noesc, st.av_env[i])) {
                st = FeState { ...st, tainted: st.tainted.append(name) };
                changed = true;
            }
            if (util.index_of_str(st.tainted, name) >= 0) {
                match (st.av[i]) {
                    ast.ExprIdent(src) => {
                        var srcid: string = rc_fe_env_resolve(st.av_env[i], src.name);
                        if (util.index_of_str(st.tainted, srcid) < 0) {
                            st = FeState { ...st, tainted: st.tainted.append(srcid) };
                            changed = true;
                        }
                    },
                    _ => {}
                }
            }
            i = i + 1;
        }
    }
    // eligibility: untainted locals / own+consumed params of reclaimable type.
    var out: string[] = [];
    var pn: string[] = [];
    var qi: i32 = 0;
    while (qi < fn.params.len()) { pn = pn.append(fn.params[qi].name); qi = qi + 1; }
    var ti: i32 = 0;
    while (ti < st.types_n.len()) {
        var nm: string = st.decl_s[ti];
        var t: string = st.types_t[ti];
        var is_param: boolean = util.index_of_str(pn, st.types_n[ti]) >= 0 && nm == st.types_n[ti];
        var dup: boolean = util.index_of_str(out, nm) >= 0;
        if (!dup && util.index_of_str(st.tainted, nm) < 0) {
            var ok: boolean = false;
            if (is_array_type_name(t)) { ok = true; }
            else if (t.len() > 0 && t[0] == b'(') { ok = true; }                         // tuple
            else if (t.len() >= 3 && slice_unchecked(t, 0, 3) == "Map") { ok = true; }
            else if (rc_struct_decl_index(structs, t) >= 0) { ok = true; }             // user struct
            else if (rc_fe_is_enum_name(structs, t)) { ok = true; }
            else if (rc_fe_is_builtin_enum(t)) { ok = true; }                           // builtin Option/Result enums
            else if (t == "string" && !is_param) { ok = true; }                        // locals on every ptrW
            else if (t == "fn") { ok = true; }                                          // owned closure frees its env (native FuncType arm)
            if (ok) { out = out.append(nm); }
        }
        ti = ti + 1;
    }
    return out;
}

// --- movedLocals port (#4482, native computeMovedLocals) ---------------------
//
// Move-on-alias / move-on-construction pair cancellation: an owned rc LOCAL
// whose last mention is a bare-ident RHS of a dominating top-level alias
// (`var b = a` / `b = a` / `var (x, y) = a`) or a bare-ident value in a
// counted construction slot (struct-lit rc-tracked non-string field, array /
// tuple literal element) is MOVED — the alias/construction inc and the exit
// sweep dec cancel, the container frees it once. Ported from
// internal/ir/rc_analysis.go:1037 with two scoping cuts, both documented in
// the diff harness: (a) move-on-call (`own` args into `own` callee params +
// own-param match scrutinees) is not ported — no `own` shapes in the corpus;
// (b) closure-capture construction moves are not ported. "Last mention" is
// approximated as: the name occurs exactly ONCE in the site statement and in
// no later top-level statement — exact for single-mention statements (native
// keys per ident NODE, which only differs when the same name recurs inside
// one statement).

// rc_ml_count_in_expr / rc_ml_count_in_stmt: occurrence count of ident `name`
// in an expression / statement (with duplicates — astwalk's collectors dedupe).
function rc_ml_count_in_expr(e: ast.Expr, name: string): i32 {
    match (e) {
        ast.ExprIdent(id) => { if (id.name == name) { return 1; } return 0; },
        ast.ExprBinary(b) => { return rc_ml_count_in_expr(b.left, name) + rc_ml_count_in_expr(b.right, name); },
        ast.ExprUnary(u) => { return rc_ml_count_in_expr(u.operand, name); },
        ast.ExprIndex(ix) => { return rc_ml_count_in_expr(ix.array, name) + rc_ml_count_in_expr(ix.index, name); },
        ast.ExprFieldAccess(fa) => { return rc_ml_count_in_expr(fa.obj, name); },
        ast.ExprSlice(sl) => { return rc_ml_count_in_expr(sl.array, name) + rc_ml_count_in_expr(sl.start, name) + rc_ml_count_in_expr(sl.end, name); },
        ast.ExprCall(c) => {
            var n: i32 = rc_ml_count_in_expr(c.callee, name);
            for arg in c.args { n = n + rc_ml_count_in_expr(arg, name); }
            return n;
        },
        ast.ExprArray(ar) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < ar.elements.len()) { n = n + rc_ml_count_in_expr(ar.elements[i], name); i = i + 1; }
            return n;
        },
        ast.ExprTuple(tu) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < tu.elements.len()) { n = n + rc_ml_count_in_expr(tu.elements[i], name); i = i + 1; }
            return n;
        },
        ast.ExprStructLit(sl) => {
            var n: i32 = 0;
            for fv in sl.field_values { n = n + rc_ml_count_in_expr(fv, name); }
            if (sl.has_base) { n = n + rc_ml_count_in_expr(sl.base, name); }
            return n;
        },
        ast.ExprLambda(lam) => { return rc_ml_count_in_stmts(lam.body, name); },
        _ => { return 0; }
    }
    return 0;
}

function rc_ml_count_in_stmt(st: ast.Stmt, name: string): i32 {
    match (st) {
        ast.StmtVar(v) => { return rc_ml_count_in_expr(v.init, name); },
        ast.StmtReturn(r) => { return rc_ml_count_in_expr(r.value, name); },
        ast.StmtExpr(x) => { return rc_ml_count_in_expr(x.value, name); },
        ast.StmtAssign(a) => { return rc_ml_count_in_expr(a.value, name); },
        ast.StmtIf(f) => { return rc_ml_count_in_expr(f.cond, name) + rc_ml_count_in_stmts(f.then_body, name) + rc_ml_count_in_stmts(f.else_body, name); },
        ast.StmtWhile(w) => { return rc_ml_count_in_expr(w.cond, name) + rc_ml_count_in_stmts(w.body, name); },
        ast.StmtFor(fr) => { return rc_ml_count_in_expr(fr.iter, name) + rc_ml_count_in_stmts(fr.body, name); },
        ast.StmtMatch(m) => {
            var n: i32 = rc_ml_count_in_expr(m.scrutinee, name);
            for arm in m.arms { n = n + rc_ml_count_in_stmts(arm.body, name); }
            return n;
        },
        _ => { return 0; }
    }
    return 0;
}

function rc_ml_count_in_stmts(stmts: ast.Stmt[], name: string): i32 {
    var n: i32 = 0;
    for stmt in stmts { n = n + rc_ml_count_in_stmt(stmt, name); }
    return n;
}

// rc_ml_stmt_has_return: the statement contains a `return` anywhere (native's
// stmtContainsReturn) — the moved-site scan stops at the first such statement.
function rc_ml_stmt_has_return(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtReturn(_) => { return true; },
        ast.StmtIf(f) => { return rc_ml_stmts_have_return(f.then_body) || rc_ml_stmts_have_return(f.else_body); },
        ast.StmtWhile(w) => { return rc_ml_stmts_have_return(w.body); },
        ast.StmtFor(fr) => { return rc_ml_stmts_have_return(fr.body); },
        ast.StmtMatch(m) => {
            for arm in m.arms { if (rc_ml_stmts_have_return(arm.body)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function rc_ml_stmts_have_return(stmts: ast.Stmt[]): boolean {
    for stmt in stmts { if (rc_ml_stmt_has_return(stmt)) { return true; } }
    return false;
}

// rc_ml_owned_rc_local: `name` is a declared LOCAL (params excluded — native
// isOwnedRcLocal reads info.Locals) whose type carries an rc box: array /
// user struct / enum / tuple / string. (Closures are excluded — scoping cut.)
function rc_ml_owned_rc_local(name: string, fn: parser.FuncDecl, types_n: string[], types_t: string[], structs: parser.StructDecl[]): boolean {
    var pi: i32 = 0;
    while (pi < fn.params.len()) { if (fn.params[pi].name == name) { return false; } pi = pi + 1; }
    var i: i32 = 0;
    while (i < types_n.len()) {
        if (types_n[i] == name) {
            var t: string = types_t[i];
            if (is_array_type_name(t)) { return true; }
            if (t == "string") { return true; }
            if (t.len() > 0 && t[0] == b'(') { return true; }
            if (rc_struct_decl_index(structs, t) >= 0) { return true; }
            if (rc_fe_is_enum_name(structs, t)) { return true; }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// rc_ml_last_use: the single mention of `name` inside top-level statement k is
// its LAST — exactly once in stmt k, never in a later top-level statement.
function rc_ml_last_use(body: ast.Stmt[], name: string, k: i32): boolean {
    if (rc_ml_count_in_stmt(body[k], name) != 1) { return false; }
    return !name_used_after(body, name, k);
}

// rc_ml_arr_elem_rc_tracked: native arrElemIsRcTracked — array / struct / enum
// / closure / tuple. Exactly the element kinds a buffer's deep drop walks and
// dec's, which is what balances a skipped construction inc. STRINGS are
// excluded because a two-word element needs the string-aware walk instead;
// this is the NARROW set, and it mirrors native's storedArrayElemOperand. The
// struct-lit arm above takes the wide one.
function rc_ml_arr_elem_rc_tracked(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() == 0) { return false; }
    if (is_array_type_name(t)) { return true; }
    if (t.len() > 0 && t[0] == b'(') { return true; }             // fn / tuple spelling
    if (rc_struct_decl_index(structs, t) >= 0) { return true; }
    return rc_fe_is_enum_name(structs, t);
}

// rc_ml_local_type: the declared type recorded for local `name`, or "".
function rc_ml_local_type(name: string, types_n: string[], types_t: string[]): string {
    if (name.len() == 0) { return ""; }
    var i: i32 = 0;
    while (i < types_n.len()) {
        if (types_n[i] == name) { return types_t[i]; }
        i = i + 1;
    }
    return "";
}

// rc_ml_recv_elem_type: the ELEMENT type of an array-store RECEIVER. Native
// reads this off the call's type argument, which the checker filled in; here it
// is recovered from the declaration, so only the two receiver spellings that
// can be resolved without a type pass are handled:
//   - a bare local `xs`, and
//   - a struct field of a local, `d.vals` — the accumulator-threading shape.
// Anything else returns "", which declines the move rather than guessing. That
// is the safe direction: a missed move is a retain the deep drop still
// balances, whereas a wrong one would skip a retain that is needed.
function rc_ml_recv_elem_type(obj: ast.Expr, types_n: string[], types_t: string[], structs: parser.StructDecl[]): string {
    var t: string = "";
    match (obj) {
        ast.ExprIdent(rid) => { t = rc_ml_local_type(rid.name, types_n, types_t); },
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(bid) => {
                    var bt: string = rc_ml_local_type(bid.name, types_n, types_t);
                    var si: i32 = rc_struct_decl_index(structs, bt);
                    if (si >= 0) {
                        var fi: i32 = 0;
                        while (fi < structs[si].fields.len()) {
                            if (structs[si].fields[fi].name == fa.field) { t = structs[si].fields[fi].type_name; }
                            fi = fi + 1;
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    if (t.len() >= 3 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") { return slice_unchecked(t, 0, t.len() - 2) + ""; }
    return "";
}

// rc_ml_construction_moves: bare-ident owned rc locals consumed at their last
// use in a counted construction slot of `val` (struct-lit rc-tracked
// field / array-literal element / tuple-literal element / the
// element of an array STORE) — native markConstructionMoves minus the
// closure-capture arm.
//
// A container literal evaluates every operand unconditionally, so the caller's
// dominance guard for this statement covers a construction NESTED in one of
// those operands too — `d = Doc { ...d, vals: d.vals.append(v) }` reaches the
// push, and with it v's move. Only the operands the match already visits are
// descended into; nothing else about the statement is walked.
// rc_ml_move_ok is the loop-body `allow` gate (native markLoopBodyConstruction-
// Moves' closure). At a dominating TOP-LEVEL statement every candidate is
// allowed. Inside a LOOP BODY only a name declared in THAT body before this
// statement qualifies: one declared outside lives across iterations, so moving
// it would hand the same box to every iteration's container — a use-after-free
// rather than a leak.
function rc_ml_move_ok(name: string, allow: string[], restrict: boolean): boolean {
    if (!restrict) { return true; }
    return util.index_of_str(allow, name) >= 0;
}

// rc_ml_expr_has_try: a `?` anywhere in `e`. The parser desugars `expr?` to the
// unary op `try_`, so the operator is an EXPRESSION and a scan over statement
// kinds alone cannot see it — which is what let a `?` sit between an element's
// declaration and its push unnoticed.
function rc_ml_expr_has_try(e: ast.Expr): boolean {
    match (e) {
        ast.ExprUnary(u) => { return u.op == "try_" || rc_ml_expr_has_try(u.operand); },
        ast.ExprBinary(b) => { return rc_ml_expr_has_try(b.left) || rc_ml_expr_has_try(b.right); },
        ast.ExprCall(c) => {
            if (rc_ml_expr_has_try(c.callee)) { return true; }
            for arg in c.args { if (rc_ml_expr_has_try(arg)) { return true; } }
            return false;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (rc_ml_expr_has_try(a.elements[i])) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (rc_ml_expr_has_try(el)) { return true; } }
            return false;
        },
        ast.ExprIndex(ix) => { return rc_ml_expr_has_try(ix.array) || rc_ml_expr_has_try(ix.index); },
        ast.ExprSlice(sl) => { return rc_ml_expr_has_try(sl.array) || rc_ml_expr_has_try(sl.start) || rc_ml_expr_has_try(sl.end); },
        ast.ExprFieldAccess(fa) => { return rc_ml_expr_has_try(fa.obj); },
        ast.ExprStructLit(s) => {
            if (s.has_base && rc_ml_expr_has_try(s.base)) { return true; }
            var i: i32 = 0;
            while (i < s.field_values.len()) { if (rc_ml_expr_has_try(s.field_values[i])) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprMapLit(ml) => {
            var i: i32 = 0;
            while (i < ml.keys.len()) { if (rc_ml_expr_has_try(ml.keys[i])) { return true; } i = i + 1; }
            var j: i32 = 0;
            while (j < ml.vals.len()) { if (rc_ml_expr_has_try(ml.vals[j])) { return true; } j = j + 1; }
            return false;
        },
        ast.ExprFString(fs) => {
            var i: i32 = 0;
            while (i < fs.exprs.len()) { if (rc_ml_expr_has_try(fs.exprs[i])) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprLambda(lm) => { return rc_ml_stmts_have_early_exit(lm.body); },
        _ => { return false; }
    }
}

// rc_ml_stmt_has_early_exit: can `st` leave the enclosing loop body early — a
// `return` / `break` / `continue`, or a `?`, which returns the failure variant
// from the enclosing function and so exits the body exactly as `return` does.
// Native stmtHasEarlyExit.
//
// Coarse in two directions, both of which only forgo a move: a `break`
// belonging to a nested loop counts, and so does a `return` inside a nested
// lambda.
function rc_ml_stmt_has_early_exit(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtReturn(_) => { return true; },
        ast.StmtBreak(_) => { return true; },
        ast.StmtContinue(_) => { return true; },
        ast.StmtVar(v) => { return rc_ml_expr_has_try(v.init); },
        ast.StmtAssign(a) => { return rc_ml_expr_has_try(a.value); },
        ast.StmtExpr(e) => { return rc_ml_expr_has_try(e.value); },
        ast.StmtIf(f) => { return rc_ml_expr_has_try(f.cond) || rc_ml_stmts_have_early_exit(f.then_body) || rc_ml_stmts_have_early_exit(f.else_body); },
        ast.StmtWhile(w) => { return rc_ml_expr_has_try(w.cond) || rc_ml_stmts_have_early_exit(w.body); },
        ast.StmtFor(fo) => { return rc_ml_expr_has_try(fo.iter) || rc_ml_stmts_have_early_exit(fo.body); },
        ast.StmtMatch(m) => {
            if (rc_ml_expr_has_try(m.scrutinee)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && rc_ml_expr_has_try(arm.guard)) { return true; }
                if (rc_ml_stmts_have_early_exit(arm.body)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return rc_ml_stmt_has_early_exit(d.action); },
        _ => { return false; }
    }
}

function rc_ml_stmts_have_early_exit(stmts: ast.Stmt[]): boolean {
    for stmt in stmts {
        if (rc_ml_stmt_has_early_exit(stmt)) { return true; }
    }
    return false;
}

// rc_ml_allow_at: of the names this loop body has declared so far, the ones no
// early exit separates from the statement now being scanned — `exits` is the
// count of exiting statements before it, and a name's recorded count is the one
// before its own declaration, so equality means nothing exits in between.
function rc_ml_allow_at(declared: string[], decl_exits: i32[], exits: i32): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < declared.len()) {
        if (decl_exits[i] == exits) { out = out.append(declared[i]); }
        i = i + 1;
    }
    return out;
}

// rc_ml_decl_count: how many times `name` is declared as a local in the whole
// function. Native's localNameUnique guard — with two declarations the
// body-local `declared` set no longer identifies which one a use refers to.
function rc_ml_decl_count(stmts: ast.Stmt[], name: string): i32 {
    var n: i32 = 0;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { n = n + 1; } },
            ast.StmtIf(f) => { n = n + rc_ml_decl_count(f.then_body, name) + rc_ml_decl_count(f.else_body, name); },
            ast.StmtWhile(w) => { n = n + rc_ml_decl_count(w.body, name); },
            ast.StmtFor(fo) => { if (fo.var_name == name) { n = n + 1; } n = n + rc_ml_decl_count(fo.body, name); },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { n = n + rc_ml_decl_count(m.arms[a].body, name); a = a + 1; } },
            _ => {}
        }
    }
    return n;
}

// rc_ml_ctor_arg_moves marks every variant-ctor argument that is an owned rc
// local at its last use, then descends. Split out because both ctor spellings
// need it and the two callee arms cannot share a match.
function rc_ml_ctor_arg_moves(args: ast.Expr[], body: ast.Stmt[], k: i32, fn: parser.FuncDecl, types_n: string[], types_t: string[], structs: parser.StructDecl[], moved: MlOut, allow: string[], restrict: boolean): MlOut {
    var out: MlOut = moved;
    var ai: i32 = 0;
    while (ai < args.len()) {
        match (args[ai]) {
            ast.ExprIdent(aid) => {
                if (rc_ml_move_ok(aid.name, allow, restrict) && rc_ml_owned_rc_local(aid.name, fn, types_n, types_t, structs) && rc_ml_last_use(body, aid.name, k) && util.index_of_str(out.names, aid.name) < 0) {
                    out = MlOut { names: out.names.append(aid.name), sites: out.sites.append(util.i32_to_string(aid.line) + ":" + util.i32_to_string(aid.col)) };
                }
            },
            _ => {}
        }
        out = rc_ml_construction_moves(args[ai], body, k, fn, types_n, types_t, structs, out, allow, restrict);
        ai = ai + 1;
    }
    return out;
}

function rc_ml_construction_moves(val: ast.Expr, body: ast.Stmt[], k: i32, fn: parser.FuncDecl, types_n: string[], types_t: string[], structs: parser.StructDecl[], moved: MlOut, allow: string[], restrict: boolean): MlOut {
    var out: MlOut = moved;
    match (val) {
        ast.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                match (sl.field_values[i]) {
                    ast.ExprIdent(id) => {
                        // The field must be rc-tracked in the WIDE sense —
                        // native's StructLit arm gates on rcTrackedSlotType
                        // (internal/ir/rc_caps.go), which is arrElemIsRcTracked
                        // PLUS string. The narrow set is the one a buffer's
                        // deep drop can walk with a single-word dec; a struct
                        // FIELD drop is string-aware, so a string field moves
                        // like any other (#6545).
                        var ft: string = "";
                        var si: i32 = rc_struct_decl_index(structs, sl.type_name);
                        if (si >= 0) {
                            var fi: i32 = 0;
                            while (fi < structs[si].fields.len()) {
                                if (structs[si].fields[fi].name == sl.field_names[i]) { ft = structs[si].fields[fi].type_name; }
                                fi = fi + 1;
                            }
                        }
                        var rc_field: boolean = is_array_type_name(ft) || ft == "string" || (ft.len() > 0 && ft[0] == b'(') || rc_struct_decl_index(structs, ft) >= 0 || rc_fe_is_enum_name(structs, ft);
                        if (rc_field && rc_ml_move_ok(id.name, allow, restrict) && rc_ml_owned_rc_local(id.name, fn, types_n, types_t, structs) && rc_ml_last_use(body, id.name, k) && util.index_of_str(out.names, id.name) < 0) {
                            // native keys the construction-move site on the
                            // consumed IDENT node.
                            out = MlOut { names: out.names.append(id.name), sites: out.sites.append(util.i32_to_string(id.line) + ":" + util.i32_to_string(id.col)) };
                        }
                    },
                    _ => {}
                }
                out = rc_ml_construction_moves(sl.field_values[i], body, k, fn, types_n, types_t, structs, out, allow, restrict);
                i = i + 1;
            }
        },
        ast.ExprCall(c) => {
            // `xs.append(v)` / `xs.with(i, v)` store the element into the buffer
            // under the same counted retain an array literal's elements take, and
            // the buffer's deep drop dec's it — so a moved last-use owned local
            // balances there too (native storedArrayElemOperand).
            // An enum VARIANT CTOR argument (native markConstructionMoves' "Slice
            // 1b" arm, which the self-host never ported): the ctor stores each
            // payload under the same counted retain a struct-literal field takes,
            // and the enum's deep drop dec's it, so a moved last-use owned local
            // balances there too. Both spellings — the bare `A(p)` reaches here as
            // an ident callee, the qualified `E.A(p)` as a field access, and native
            // resolves both through lookupVariantOn.
            match (c.callee) {
                ast.ExprIdent(vcid) => {
                    var vowner: string = variant_enum_owner(structs, vcid.name);
                    if (vowner != "" && enum_all_variants_rc_droppable(structs, vowner)) {
                        out = rc_ml_ctor_arg_moves(c.args, body, k, fn, types_n, types_t, structs, out, allow, restrict);
                    }
                },
                _ => {}
            }
            match (c.callee) {
                ast.ExprFieldAccess(qfa) => {
                    var qowner: string = variant_enum_owner(structs, qfa.field);
                    if (qowner != "" && enum_all_variants_rc_droppable(structs, qowner)) {
                        out = rc_ml_ctor_arg_moves(c.args, body, k, fn, types_n, types_t, structs, out, allow, restrict);
                    }
                },
                _ => {}
            }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    var elem_idx: i32 = 0 - 1;
                    if (fa.field == "append" && c.args.len() == 1) { elem_idx = 0; }
                    if (fa.field == "with" && c.args.len() == 2) { elem_idx = 1; }
                    if (elem_idx >= 0) {
                        if (rc_ml_arr_elem_rc_tracked(rc_ml_recv_elem_type(fa.obj, types_n, types_t, structs), structs)) {
                            match (c.args[elem_idx]) {
                                ast.ExprIdent(eid) => {
                                    if (rc_ml_move_ok(eid.name, allow, restrict) && rc_ml_owned_rc_local(eid.name, fn, types_n, types_t, structs) && rc_ml_last_use(body, eid.name, k) && util.index_of_str(out.names, eid.name) < 0) {
                                        out = MlOut { names: out.names.append(eid.name), sites: out.sites.append(util.i32_to_string(eid.line) + ":" + util.i32_to_string(eid.col)) };
                                    }
                                },
                                _ => {}
                            }
                            out = rc_ml_construction_moves(c.args[elem_idx], body, k, fn, types_n, types_t, structs, out, allow, restrict);
                        }
                    }
                },
                _ => {}
            }
        },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) {
                match (ar.elements[i]) {
                    ast.ExprIdent(id) => {
                        if (rc_ml_move_ok(id.name, allow, restrict) && rc_ml_owned_rc_local(id.name, fn, types_n, types_t, structs) && rc_ml_last_use(body, id.name, k) && util.index_of_str(out.names, id.name) < 0) {
                            out = MlOut { names: out.names.append(id.name), sites: out.sites.append(util.i32_to_string(id.line) + ":" + util.i32_to_string(id.col)) };
                        }
                    },
                    _ => {}
                }
                out = rc_ml_construction_moves(ar.elements[i], body, k, fn, types_n, types_t, structs, out, allow, restrict);
                i = i + 1;
            }
        },
        ast.ExprTuple(tu) => {
            var i: i32 = 0;
            while (i < tu.elements.len()) {
                match (tu.elements[i]) {
                    ast.ExprIdent(id) => {
                        if (rc_ml_move_ok(id.name, allow, restrict) && rc_ml_owned_rc_local(id.name, fn, types_n, types_t, structs) && rc_ml_last_use(body, id.name, k) && util.index_of_str(out.names, id.name) < 0) {
                            out = MlOut { names: out.names.append(id.name), sites: out.sites.append(util.i32_to_string(id.line) + ":" + util.i32_to_string(id.col)) };
                        }
                    },
                    _ => {}
                }
                out = rc_ml_construction_moves(tu.elements[i], body, k, fn, types_n, types_t, structs, out, allow, restrict);
                i = i + 1;
            }
        },
        _ => {}
    }
    return out;
}

// rc_ml_loop_body_moves extends the construction-move scan into LOOP BODIES —
// native markLoopBodyConstructionMoves, the half #6569 did not port. The
// top-level driver walks fn.body's own statements only, so `for i in 0..n { var
// v = Val { .. }; vals = vals.append(v); }` — the shape an accumulator is
// actually written in — recorded no move at all, and the append-built credit
// consequently refused every bound element.
//
// A local declared INSIDE the body dies at the end of its iteration, so a
// construction that consumes it there takes its single reference. The `declared`
// set is what enforces that, and it is why the pass cannot simply reuse the
// top-level walk.
function rc_ml_loop_body_moves(stmts: ast.Stmt[], fn: parser.FuncDecl, types_n: string[], types_t: string[], structs: parser.StructDecl[], moved: MlOut): MlOut {
    var out: MlOut = moved;
    for stmt in stmts {
        match (stmt) {
            ast.StmtWhile(w) => {
                out = rc_ml_one_loop_body(w.body, fn, types_n, types_t, structs, out);
                out = rc_ml_loop_body_moves(w.body, fn, types_n, types_t, structs, out);
            },
            ast.StmtFor(fo) => {
                out = rc_ml_one_loop_body(fo.body, fn, types_n, types_t, structs, out);
                out = rc_ml_loop_body_moves(fo.body, fn, types_n, types_t, structs, out);
            },
            ast.StmtIf(f) => {
                out = rc_ml_loop_body_moves(f.then_body, fn, types_n, types_t, structs, out);
                out = rc_ml_loop_body_moves(f.else_body, fn, types_n, types_t, structs, out);
            },
            ast.StmtMatch(m) => {
                for arm in m.arms { out = rc_ml_loop_body_moves(arm.body, fn, types_n, types_t, structs, out); }
            },
            _ => {}
        }
    }
    return out;
}

// rc_ml_one_loop_body scans a single loop body, admitting a construction move
// only for a name this body declared before the site (and declared exactly once
// in the function, so the set identifies it unambiguously). Last use is measured
// WITHIN the body, which is the right scope for a name that dies with the
// iteration.
//
// An early exit disqualifies only the names whose DECLARATION it separates from
// the construction: that interval is what makes the construction unconditional,
// since `moved` is function-wide and a path that builds the box without reaching
// the construction leaks it. Before the declaration no box exists yet, and after
// the construction the container owns it — so the guard-clause shape every
// parser is built out of stays eligible.
//
// This runs after the range-`for` desugar, so a range loop's body opens with
// the advance assign and an `if (done) { break; }` guard. Counting that guard
// is harmless: it precedes every declaration, so it shifts each name's exit
// count and each construction's by the same one, and the comparison is an
// equality.
function rc_ml_one_loop_body(blk: ast.Stmt[], fn: parser.FuncDecl, types_n: string[], types_t: string[], structs: parser.StructDecl[], moved: MlOut): MlOut {
    var out: MlOut = moved;
    var declared: string[] = [];
    var decl_exits: i32[] = [];
    var exits: i32 = 0;
    var i: i32 = 0;
    while (i < blk.len()) {
        var allow: string[] = rc_ml_allow_at(declared, decl_exits, exits);
        match (blk[i]) {
            ast.StmtVar(v) => {
                out = rc_ml_construction_moves(v.init, blk, i, fn, types_n, types_t, structs, out, allow, true);
                if (rc_ml_decl_count(fn.body, v.name) == 1 && util.index_of_str(declared, v.name) < 0) {
                    declared = declared.append(v.name);
                    decl_exits = decl_exits.append(exits);
                }
            },
            ast.StmtAssign(a) => {
                out = rc_ml_construction_moves(a.value, blk, i, fn, types_n, types_t, structs, out, allow, true);
            },
            _ => {}
        }
        if (rc_ml_stmt_has_early_exit(blk[i])) { exits = exits + 1; }
        i = i + 1;
    }
    return out;
}

// MlOut: the movedLocals walk's paired outputs — moved NAMES and their move
// SITES ("line:col" of the node native keys: the Var/Assign/Destructure
// STATEMENT for alias + destructure moves, the consumed IDENT for
// construction moves — internal/ir/rc_dump.go nodePos).
struct MlOut { names: string[], sites: string[] }

// rc_ml_compute: the ported analysis — owned rc locals moved into an alias /
// destructure / construction at their last use, at a dominating
// (pre-first-return) top-level statement, with their move-site positions.
function rc_ml_compute_toplevel(fn: parser.FuncDecl, structs: parser.StructDecl[]): MlOut {
    var moved: MlOut = MlOut { names: [], sites: [] };
    // local name->type table, reusing the freeEligible collector (params
    // recorded first so destructure typing can read them, then locals).
    var st: FeState = FeState { tainted: [], an: [], av: [], av_env: [], types_n: [], types_t: [], decl_s: [], site_mode: false };
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        st = FeState { ...st, types_n: st.types_n.append(fn.params[pi].name), types_t: st.types_t.append(fn.params[pi].type_name), decl_s: st.decl_s.append(fn.params[pi].name) };
        pi = pi + 1;
    }
    // movedLocals does not need call-return typing (it moves already-typed
    // locals), so an empty function table is passed — this keeps rc_ml_compute
    // free of the module funcs thread without changing its behaviour.
    st = rc_fe_collect_types(fn.body, st, structs, sig_reg_empty());
    var saw_return: boolean = false;
    var k: i32 = 0;
    while (k < fn.body.len()) {
        if (!saw_return) {
            match (fn.body[k]) {
                ast.StmtVar(v) => {
                    match (v.init) {
                        ast.ExprIdent(id) => {
                            // move-on-alias (`var b = a`) and the destructure
                            // move (`var (x, y) = a`) share the bare-ident-RHS
                            // site shape; native keys the STATEMENT node.
                            if (rc_ml_owned_rc_local(id.name, fn, st.types_n, st.types_t, structs) && rc_ml_last_use(fn.body, id.name, k) && util.index_of_str(moved.names, id.name) < 0) {
                                moved = MlOut { names: moved.names.append(id.name), sites: moved.sites.append(util.i32_to_string(v.line) + ":" + util.i32_to_string(v.col)) };
                            }
                        },
                        _ => {}
                    }
                    moved = rc_ml_construction_moves(v.init, fn.body, k, fn, st.types_n, st.types_t, structs, moved, [], false);
                },
                ast.StmtAssign(a) => {
                    match (a.value) {
                        ast.ExprIdent(id) => {
                            if (rc_ml_owned_rc_local(id.name, fn, st.types_n, st.types_t, structs) && rc_ml_last_use(fn.body, id.name, k) && util.index_of_str(moved.names, id.name) < 0) {
                                moved = MlOut { names: moved.names.append(id.name), sites: moved.sites.append(util.i32_to_string(a.line) + ":" + util.i32_to_string(a.col)) };
                            }
                        },
                        _ => {}
                    }
                    moved = rc_ml_construction_moves(a.value, fn.body, k, fn, st.types_n, st.types_t, structs, moved, [], false);
                },
                ast.StmtReturn(r) => {
                    // construction moves only (a bare `return x` rides
                    // move-on-return, a different mechanism/table).
                    moved = rc_ml_construction_moves(r.value, fn.body, k, fn, st.types_n, st.types_t, structs, moved, [], false);
                },
                _ => {}
            }
        }
        if (rc_ml_stmt_has_return(fn.body[k])) { saw_return = true; }
        k = k + 1;
    }
    return moved;
}

// rc_ml_compute is rc_ml_compute_toplevel plus the loop-body moves.
function rc_ml_compute(fn: parser.FuncDecl, structs: parser.StructDecl[]): MlOut {
    var st2: FeState = FeState { tainted: [], an: [], av: [], av_env: [], types_n: [], types_t: [], decl_s: [], site_mode: false };
    var pj: i32 = 0;
    while (pj < fn.params.len()) {
        st2 = FeState { ...st2, types_n: st2.types_n.append(fn.params[pj].name), types_t: st2.types_t.append(fn.params[pj].type_name), decl_s: st2.decl_s.append(fn.params[pj].name) };
        pj = pj + 1;
    }
    st2 = rc_fe_collect_types(fn.body, st2, structs, sig_reg_empty());
    return rc_ml_loop_body_moves(fn.body, fn, st2.types_n, st2.types_t, structs, rc_ml_compute_toplevel(fn, structs));
}

// moved_locals_of / move_sites_of: the two pub views over rc_ml_compute.
pub function moved_locals_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    return rc_ml_compute(fn, structs).names;
}

// moved_locals_toplevel_of is the subset the EMITTER acts on (#6726): the
// top-level moves only, without rc_ml_loop_body_moves' additions.
//
// A top-level move is recorded at statement k only when no earlier statement
// contains a return and the local is never read after k, so at every exit the
// move has already happened and skipping the local's sweep dec is exact. A
// LOOP-BODY move is not that: the local is rebound each iteration, and the
// rebind's consume-dec would release a value the previous iteration's
// construction now owns. That half needs the rebind site to agree too, so it
// stays on the retain-and-cancel path until then.
pub function moved_locals_toplevel_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    return rc_ml_compute_toplevel(fn, structs).names;
}
pub function move_sites_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    return rc_ml_compute(fn, structs).sites;
}
// move_sites_toplevel_of: the site keys of the top-level moves — the WHERE half
// of moved_locals_toplevel_of, which is the subset the emitter acts on.
pub function move_sites_toplevel_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    return rc_ml_compute_toplevel(fn, structs).sites;
}

// --- Dead-alias cancellation (#4402 opt 1, native computeBorrowedAliases) ---
//
// A `var y = x` bind whose alias is a pure borrowed VIEW elides the transfer
// inc AND y's exit dec — a net-zero pair — while the source x keeps the sole
// count and releases ONLY at the exit sweep: its precise drop is withheld,
// because an early free would dangle the live borrow. Mirrors native's gates:
// neither name reassigned, y never mentioned in a return, neither a match
// scrutinee, both single-decl, no chains (a cancelled alias sources nothing,
// a source is not itself cancelled). sites: the cancelled alias BIND-site
// keys; srcs: the borrow-source names (the precise-drop exclusion set).
//
// Covers ARRAY, STRING, STRUCT and TUPLE pairs — the pure kind gate is y's
// annotation or kind evidence at x's declaration; the emitting side (the
// per-kind *_dead_alias_bind predicates) re-checks against the SLOT facts
// and is final.
pub struct DeadAliases { sites: string[], srcs: string[] }

// moved: the FULL moved-locals set (rc_ml_compute, loop-body construction
// moves included) — native's movedLocals gate, which is wider than the
// top-level set the emitting predicates read: a loop-body-moved source keeps
// the retain-and-cancel path, so its alias pair must keep the retain too.
pub function dead_alias_of(body: ast.Stmt[], moved: string[]): DeadAliases {
    var assigned: string[] = body_assign_targets(body);
    var rets: string[] = da_returned_names(body, []);
    var scruts: string[] = da_scrutinee_names(body, []);
    return da_scan(body, body, assigned, rets, scruts, moved, DeadAliases { sites: [], srcs: [] });
}

// da_name_in_sites: is `name` the bound name of any recorded site key
// (`name@line:col`)? The cancelled-alias membership check, without a third
// list to keep in step.
function da_name_in_sites(sites: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < sites.len()) {
        if (reclaim_site_name(sites[i]) == name) { return true; }
        i = i + 1;
    }
    return false;
}

// da_decl_array_evidence: x's declaration carries an array annotation or an
// array-literal init — the pure proxy for "x is an owned array local".
function da_decl_array_evidence(stmts: ast.Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (is_array_type_name(v.type_name)) { return true; }
                    match (v.init) {
                        ast.ExprArray(_) => { return true; },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                if (da_decl_array_evidence(f.then_body, name)) { return true; }
                if (da_decl_array_evidence(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (da_decl_array_evidence(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (da_decl_array_evidence(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (da_decl_array_evidence(m.arms[mi].body, name)) { return true; }
                    mi = mi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// da_decl_string_evidence: x's declaration carries a string annotation or a
// string-literal init — the string sibling of da_decl_array_evidence.
function da_decl_string_evidence(stmts: ast.Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (v.type_name == "string") { return true; }
                    match (v.init) {
                        ast.ExprString(_) => { return true; },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                if (da_decl_string_evidence(f.then_body, name)) { return true; }
                if (da_decl_string_evidence(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (da_decl_string_evidence(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (da_decl_string_evidence(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (da_decl_string_evidence(m.arms[mi].body, name)) { return true; }
                    mi = mi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// da_decl_structlit_evidence: x's declaration carries a struct-literal init —
// the struct sibling of the array/string evidence. Syntactic only (there is no
// structs registry here), so an annotation-only struct source is not admitted;
// the slot-fact predicate is final either way.
function da_decl_structlit_evidence(stmts: ast.Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprStructLit(_) => { return true; },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                if (da_decl_structlit_evidence(f.then_body, name)) { return true; }
                if (da_decl_structlit_evidence(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (da_decl_structlit_evidence(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (da_decl_structlit_evidence(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (da_decl_structlit_evidence(m.arms[mi].body, name)) { return true; }
                    mi = mi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// da_decl_tuple_evidence: x's declaration carries a tuple-literal init — the
// tuple sibling of the struct evidence.
function da_decl_tuple_evidence(stmts: ast.Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprTuple(_) => { return true; },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                if (da_decl_tuple_evidence(f.then_body, name)) { return true; }
                if (da_decl_tuple_evidence(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (da_decl_tuple_evidence(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (da_decl_tuple_evidence(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (da_decl_tuple_evidence(m.arms[mi].body, name)) { return true; }
                    mi = mi + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

function da_returned_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtReturn(r) => { a = astwalk.collect_idents_expr(r.value, a); },
            ast.StmtIf(f) => { a = da_returned_names(f.then_body, a); a = da_returned_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = da_returned_names(w.body, a); },
            ast.StmtFor(fo) => { a = da_returned_names(fo.body, a); },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) { a = da_returned_names(m.arms[mi].body, a); mi = mi + 1; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

function da_scrutinee_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtMatch(m) => {
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { a = push_str_unique(a, sid.name); },
                    _ => {}
                }
                var mi: i32 = 0;
                while (mi < m.arms.len()) { a = da_scrutinee_names(m.arms[mi].body, a); mi = mi + 1; }
            },
            ast.StmtIf(f) => { a = da_scrutinee_names(f.then_body, a); a = da_scrutinee_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = da_scrutinee_names(w.body, a); },
            ast.StmtFor(fo) => { a = da_scrutinee_names(fo.body, a); },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

function da_scan(stmts: ast.Stmt[], body: ast.Stmt[], assigned: string[], rets: string[], scruts: string[], moved: string[], acc: DeadAliases): DeadAliases {
    var a: DeadAliases = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprIdent(id) => {
                        if (id.name != v.name
                            && !da_name_in_sites(a.sites, v.name) && !da_name_in_sites(a.sites, id.name)
                            && util.index_of_str(a.srcs, v.name) < 0
                            && util.index_of_str(assigned, id.name) < 0 && util.index_of_str(assigned, v.name) < 0
                            && util.index_of_str(rets, v.name) < 0
                            && util.index_of_str(scruts, id.name) < 0 && util.index_of_str(scruts, v.name) < 0
                            && util.index_of_str(moved, id.name) < 0 && util.index_of_str(moved, v.name) < 0
                            && local_decl_count(body, id.name) == 1 && local_decl_count(body, v.name) == 1
                            && (is_array_type_name(v.type_name) || da_decl_array_evidence(body, id.name)
                                || v.type_name == "string" || da_decl_string_evidence(body, id.name)
                                || da_decl_structlit_evidence(body, id.name)
                                || (util.is_tuple_type_name(v.type_name)
                                    && !util.contains(v.type_name, "=>"))
                                || da_decl_tuple_evidence(body, id.name))) {
                            a = DeadAliases {
                                sites: a.sites.append(reclaim_site_key_of(v.name, v.line, v.col)),
                                srcs: push_str_unique(a.srcs, id.name)
                            };
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { a = da_scan(f.then_body, body, assigned, rets, scruts, moved, a); a = da_scan(f.else_body, body, assigned, rets, scruts, moved, a); },
            ast.StmtWhile(w) => { a = da_scan(w.body, body, assigned, rets, scruts, moved, a); },
            ast.StmtFor(fo) => { a = da_scan(fo.body, body, assigned, rets, scruts, moved, a); },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) { a = da_scan(m.arms[mi].body, body, assigned, rets, scruts, moved, a); mi = mi + 1; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

// arr_dead_alias_bind: THE one predicate deciding whether this array alias
// bind is dead-alias-cancelled — consulted by the ladder (skip the retain)
// and by bind_var_slot (skip the alias slot's sweep dec, via
// note_moved_elided), so the two halves of the net-zero pair cannot drift.
// The slot facts are the final authority: source must be an owned (non-param,
// non-borrowed) array slot, and a MOVE site takes the move path instead.
function arr_dead_alias_bind(v: ast.StmtVar, se: LowerState): boolean {
    match (v.init) {
        ast.ExprIdent(id) => {
            var src: i32 = se.slot_of(id.name);
            if (src < 0 || src < se.n_params) { return false; }
            if (!se.is_arr_slot(src) || se.is_borrowed_arr_slot(src)) { return false; }
            if (se.moves_local_at(id.name, v.line, v.col)) { return false; }
            if (util.index_of_str(se.moved_names, id.name) >= 0 || util.index_of_str(se.moved_names, v.name) >= 0) { return false; }
            return util.index_of_str(se.dead_alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0;
        },
        _ => {}
    }
    return false;
}

// str_dead_alias_bind: the string sibling of arr_dead_alias_bind — THE one
// predicate for the string limb, consulted by the ladder (skip the retain)
// and by bind_var_slot (skip the alias slot's sweep dec). The slot facts are
// final: the source must be a credited (non-param) string slot, and a MOVE
// site takes the move path instead. Strings have no precise-drop class, so
// the pd_filter half of the cancellation is vacuous here — only the inc/dec
// pair is elided; the source's release stays the exit sweep it already was.
function str_dead_alias_bind(v: ast.StmtVar, se: LowerState): boolean {
    match (v.init) {
        ast.ExprIdent(id) => {
            var src: i32 = se.slot_of(id.name);
            if (src < 0 || src < se.n_params) { return false; }
            if (!slot_is_reclaimable_str(se, src)) { return false; }
            if (se.moves_local_at(id.name, v.line, v.col)) { return false; }
            if (util.index_of_str(se.moved_names, id.name) >= 0 || util.index_of_str(se.moved_names, v.name) >= 0) { return false; }
            return util.index_of_str(se.dead_alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0;
        },
        _ => {}
    }
    return false;
}

// struct_dead_alias_bind: the struct sibling — THE one predicate for the
// struct limb, consulted by the ladder (skip the retain) and by bind_var_slot
// (skip the alias slot's sweep dec). Under duplication the alias holds only
// the BOX-ONLY "NODEEP:" release, so that box dec is the whole of what the
// cancellation elides — the source keeps its one deep field walk at the exit
// sweep, exactly as before. The slot facts are final: the source must be a
// credited (non-param) struct slot, and a MOVE site takes the move path
// (which does credit surgery this predicate must not preempt).
function struct_dead_alias_bind(v: ast.StmtVar, se: LowerState): boolean {
    match (v.init) {
        ast.ExprIdent(id) => {
            var src: i32 = se.slot_of(id.name);
            if (src < 0 || src < se.n_params) { return false; }
            if (!slot_is_reclaimable_struct(se, src)) { return false; }
            if (se.moves_local_at(id.name, v.line, v.col)) { return false; }
            if (util.index_of_str(se.moved_names, id.name) >= 0 || util.index_of_str(se.moved_names, v.name) >= 0) { return false; }
            return util.index_of_str(se.dead_alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0;
        },
        _ => {}
    }
    return false;
}

// tuple_dead_alias_bind: the tuple sibling — THE one predicate for the tuple
// limb, consulted by the ladder and bind_var_slot. Under duplication the
// alias holds only the shallow "TUP:" box dec (the deep "TUPRCS:" release
// stays with the source), so that box dec is the whole of what the
// cancellation elides — no credit surgery, and a MOVE site takes the move
// path (which transfers the deep class) instead.
function tuple_dead_alias_bind(v: ast.StmtVar, se: LowerState): boolean {
    match (v.init) {
        ast.ExprIdent(id) => {
            var src: i32 = se.slot_of(id.name);
            if (src < 0 || src < se.n_params) { return false; }
            if (!slot_is_credited_tuple(se, src)) { return false; }
            if (se.moves_local_at(id.name, v.line, v.col)) { return false; }
            if (util.index_of_str(se.moved_names, id.name) >= 0 || util.index_of_str(se.moved_names, v.name) >= 0) { return false; }
            return util.index_of_str(se.dead_alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0;
        },
        _ => {}
    }
    return false;
}

// pd_filter_names: drop the precise-drop rows naming a borrow SOURCE — a
// dead-alias source releases only at the exit sweep (an early free would
// dangle the live borrow). The reuse-donor suppression's shape, shared by
// lower_func and the rc_plan_dump so the dump mirrors the lowering.
pub function pd_filter_names(pd: PreciseDrops, names: string[]): PreciseDrops {
    if (names.len() == 0 || pd.idxs.len() == 0) { return pd; }
    var fidx: i32[] = [];
    var fnames: string[] = [];
    var fkinds: string[] = [];
    var i: i32 = 0;
    while (i < pd.idxs.len()) {
        if (util.index_of_str(names, pd.names[i]) < 0) {
            fidx = fidx.append(pd.idxs[i]);
            fnames = fnames.append(pd.names[i]);
            fkinds = fkinds.append(pd.kinds[i]);
        }
        i = i + 1;
    }
    return PreciseDrops { idxs: fidx, names: fnames, kinds: fkinds };
}

// --- arraySetInc port (#4482, native computeArraySetIncs) --------------------
//
// Per `.with(i, v)` call: must the lowering rc-inc the RECEIVER before the
// CoW (forcing a copy)? true when the receiver buffer may be read again or is
// not solely ours: a borrowed param receiver (non-`own`, non-consumed — the
// caller's buffer, same scoping cut as free_eligible_of), a projection
// receiver (`a[0].with(..)` / `s.b.with(..)` / slice — the container still
// owns the inner buffer), or a bare local read again after the call. false
// (the in-place rc==1 fast path) for a reassign-to-self (`a = a.with(..)`),
// a fresh non-projection receiver (call result), or a receiver at its last
// use. Rendered as native nodePos of the CALL node + "=true"/"=false".

// rc_asi_is_with: the ExprCall is a `.with(index, value)` method call; the
// receiver is the callee FieldAccess's object.
function rc_asi_is_with(c: ast.ExprCall): boolean {
    if (c.args.len() != 2) { return false; }
    match (c.callee) {
        ast.ExprFieldAccess(fa) => { return fa.field == "with"; },
        _ => { return false; }
    }
    return false;
}

// rc_asi_collect: walk every expression under statement k appending each
// `.with` call's dump entry ("line:col=true/false") to `out`. `self_name` is
// the enclosing StmtAssign's ident target ("" elsewhere) — a receiver ident
// equal to it at the assign's own RHS call is the reassign-to-self shape.
function rc_asi_expr(e: ast.Expr, body: ast.Stmt[], k: i32, self_name: string, borrowed: string[], out: string[]): string[] {
    var acc: string[] = out;
    match (e) {
        ast.ExprCall(c) => {
            if (rc_asi_is_with(c)) {
                match (c.callee) {
                    ast.ExprFieldAccess(fa) => {
                        var inc: boolean = false;
                        var decided: boolean = false;
                        match (fa.obj) {
                            ast.ExprIdent(rid) => {
                                if (util.index_of_str(borrowed, rid.name) >= 0) { inc = true; decided = true; }
                                else if (rid.name == self_name) { inc = false; decided = true; }
                                else {
                                    // live after the call iff this is not the
                                    // receiver name's last mention.
                                    inc = !rc_ml_last_use(body, rid.name, k);
                                    decided = true;
                                }
                            },
                            ast.ExprIndex(_) => { inc = true; decided = true; },
                            ast.ExprFieldAccess(_) => { inc = true; decided = true; },
                            ast.ExprSlice(_) => { inc = true; decided = true; },
                            _ => { inc = false; decided = true; }
                        }
                        if (decided) {
                            var tag: string = "false";
                            if (inc) { tag = "true"; }
                            acc = acc.append(util.i32_to_string(c.line) + ":" + util.i32_to_string(c.col) + "=" + tag);
                        }
                        acc = rc_asi_expr(fa.obj, body, k, "", borrowed, acc);
                    },
                    _ => {}
                }
            } else {
                acc = rc_asi_expr(c.callee, body, k, "", borrowed, acc);
            }
            for arg in c.args { acc = rc_asi_expr(arg, body, k, "", borrowed, acc); }
        },
        ast.ExprBinary(b) => { acc = rc_asi_expr(b.left, body, k, "", borrowed, acc); acc = rc_asi_expr(b.right, body, k, "", borrowed, acc); },
        ast.ExprUnary(u) => { acc = rc_asi_expr(u.operand, body, k, "", borrowed, acc); },
        ast.ExprIndex(ix) => { acc = rc_asi_expr(ix.array, body, k, "", borrowed, acc); acc = rc_asi_expr(ix.index, body, k, "", borrowed, acc); },
        ast.ExprFieldAccess(fa2) => { acc = rc_asi_expr(fa2.obj, body, k, "", borrowed, acc); },
        ast.ExprSlice(sl) => { acc = rc_asi_expr(sl.array, body, k, "", borrowed, acc); acc = rc_asi_expr(sl.start, body, k, "", borrowed, acc); acc = rc_asi_expr(sl.end, body, k, "", borrowed, acc); },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { acc = rc_asi_expr(ar.elements[i], body, k, "", borrowed, acc); i = i + 1; }
        },
        ast.ExprTuple(tu) => {
            var i: i32 = 0;
            while (i < tu.elements.len()) { acc = rc_asi_expr(tu.elements[i], body, k, "", borrowed, acc); i = i + 1; }
        },
        ast.ExprStructLit(sl2) => {
            var i: i32 = 0;
            while (i < sl2.field_values.len()) { acc = rc_asi_expr(sl2.field_values[i], body, k, "", borrowed, acc); i = i + 1; }
            if (sl2.has_base) { acc = rc_asi_expr(sl2.base, body, k, "", borrowed, acc); }
        },
        ast.ExprLambda(lam) => { acc = rc_asi_stmts(lam.body, body, k, borrowed, acc); },
        _ => {}
    }
    return acc;
}

function rc_asi_stmts(stmts: ast.Stmt[], body: ast.Stmt[], k: i32, borrowed: string[], out: string[]): string[] {
    var acc: string[] = out;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { acc = rc_asi_expr(v.init, body, k, "", borrowed, acc); },
            ast.StmtAssign(a) => { acc = rc_asi_expr(a.value, body, k, a.target, borrowed, acc); },
            ast.StmtReturn(r) => { acc = rc_asi_expr(r.value, body, k, "", borrowed, acc); },
            ast.StmtExpr(x) => { acc = rc_asi_expr(x.value, body, k, "", borrowed, acc); },
            ast.StmtIf(f) => {
                acc = rc_asi_expr(f.cond, body, k, "", borrowed, acc);
                acc = rc_asi_stmts(f.then_body, body, k, borrowed, acc);
                acc = rc_asi_stmts(f.else_body, body, k, borrowed, acc);
            },
            ast.StmtWhile(w) => { acc = rc_asi_expr(w.cond, body, k, "", borrowed, acc); acc = rc_asi_stmts(w.body, body, k, borrowed, acc); },
            ast.StmtFor(fr) => { acc = rc_asi_expr(fr.iter, body, k, "", borrowed, acc); acc = rc_asi_stmts(fr.body, body, k, borrowed, acc); },
            ast.StmtMatch(m) => {
                acc = rc_asi_expr(m.scrutinee, body, k, "", borrowed, acc);
                for arm in m.arms { acc = rc_asi_stmts(arm.body, body, k, borrowed, acc); }
            },
            _ => {}
        }
    }
    return acc;
}

// array_set_incs_of: the ported analysis — one "line:col=true/false" entry
// per `.with` call in `fn`. The borrow cut matches free_eligible_of's: a
// param is borrowed unless `own` or consumed-threaded.
pub function array_set_incs_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    var consumed: string[] = consumed_params_of(fn, structs);
    var borrowed: string[] = [];
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        var p: ast.ParamDecl = fn.params[pi];
        if (!p.own && util.index_of_str(consumed, p.name) < 0) { borrowed = borrowed.append(p.name); }
        pi = pi + 1;
    }
    var out: string[] = [];
    var k: i32 = 0;
    while (k < fn.body.len()) {
        var one: ast.Stmt[] = [];
        one = one.append(fn.body[k]);
        out = rc_asi_stmts(one, fn.body, k, borrowed, out);
        k = k + 1;
    }
    return out;
}

// --- reuseSources / reuseConsumed port (#4482, native computeReuseSources) --
//
// The general-FBIP pairing: construction site C reuses dead owned donor D's
// box. The SELF-HOST's own pairing lives in cross_reuse_sites (struct) and
// cross_tuple_reuse_sites (tuple); this dump renders THOSE — divergences from
// native's class-based pairing (which also admits same-class cross-kind
// donors, gates on freeEligible/movedLocals, and adds consuming-match ctor
// entries) are pinned per-case in the harness, documenting where the two
// pairing algorithms differ. Keyed on the recipient's construction-literal
// node position, matching native nodePos of the StructLit / TupleLit. Only
// FUNCTION-BODY top-level pairings are rendered (lower_block recomputes
// per nested block at lowering time; nested pairings are a documented
// omission until the dump threads block context).

// reuse_sources_of: "line:col<-donor" per cross-struct / cross-tuple pairing;
// empty when the reuse layer is disabled (native's RcReuseEnabled gate).
// Native computeReuseSources runs TWO passes over every block — a same-block
// pass then a cross-block pass — so the dump does the same: same-block first
// (reuse_sources_block), then cross-block (reuse_xblock_pairs), deduped by
// recipient position (native skips a recipient the same-block pass claimed).
pub function reuse_sources_of(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[]): string[] {
    if (reuse_layer_disabled()) { return []; }
    var fresh_ret: string[] = return_fresh_struct_ret_fns_of(funcs, structs, strfld_reclaim_ok_types_of(funcs, structs, borrowable_params_of(funcs)));
    var same: string[] = reuse_sources_block(fn.body, structs, fresh_ret, []);
    var xb: string[] = reuse_xblock_pairs(fn.body, structs, fresh_ret, []);
    var out: string[] = same;
    var i: i32 = 0;
    while (i < xb.len()) {
        // xb entry is "pos<-donor"; skip if the same-block pass already claimed
        // this recipient position (native's already-paired node check).
        if (!reuse_pos_claimed(out, xb[i])) { out = out.append(xb[i]); }
        i = i + 1;
    }
    return out;
}

// reuse_arrow_pos: the recipient-position prefix of a "pos<-donor" entry.
function reuse_arrow_pos(entry: string): string {
    var i: i32 = 0;
    while (i + 1 < entry.len()) {
        if (entry[i] == b'<' && entry[i + 1] == b'-') { return slice_unchecked(entry, 0, i) + ""; }
        i = i + 1;
    }
    return entry;
}

// reuse_arrow_donor: the donor-name suffix of a "pos<-donor" entry.
function reuse_arrow_donor(entry: string): string {
    var i: i32 = 0;
    while (i + 1 < entry.len()) {
        if (entry[i] == b'<' && entry[i + 1] == b'-') { return slice_unchecked(entry, i + 2, entry.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// reuse_pos_claimed: some entry in `existing` names the same recipient position
// as `entry` ("pos<-...").
function reuse_pos_claimed(existing: string[], entry: string): boolean {
    var pos: string = reuse_arrow_pos(entry);
    var i: i32 = 0;
    while (i < existing.len()) {
        if (reuse_arrow_pos(existing[i]) == pos) { return true; }
        i = i + 1;
    }
    return false;
}

// xblock_recip_pos: the construction-lit "line:col" of the recipient bound at
// site `recip` inside if-statement `iff`'s then / else arm (the cross-block
// pairing places the recipient one block below the donor). "" if not found.
function xblock_recip_pos(iff: ast.StmtIf, recip: string): string {
    var p: string = xblock_recip_pos_in(iff.then_body, recip);
    if (p.len() > 0) { return p; }
    return xblock_recip_pos_in(iff.else_body, recip);
}
function xblock_recip_pos_in(stmts: ast.Stmt[], recip: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (reclaim_site_key_of(v.name, v.line, v.col) == recip) {
                    match (v.init) {
                        ast.ExprStructLit(sl) => { return util.i32_to_string(sl.line) + ":" + util.i32_to_string(sl.col); },
                        ast.ExprTuple(tu) => { return util.i32_to_string(tu.line) + ":" + util.i32_to_string(tu.col); },
                        _ => {}
                    }
                }
            },
            _ => {}
        }
    }
    return "";
}

// reuse_xblock_pairs: the cross-block pairings of every block — for each
// if-statement, xblock_pairings_for yields "recip|donor|dtype"; the recipient
// lit lives in the if-arm one block below. Mirrors lower_block's per-block
// xblock_pairings_for(stmts, structs, k, so.bases, same-block-donors, fresh_ret).
function reuse_xblock_pairs(stmts: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], out: string[]): string[] {
    var acc: string[] = out;
    var so: ReuseSites = self_overwrite_reuse_sites(stmts, structs, fresh_ret);
    var xr: CrossReuseSites = cross_reuse_sites(stmts, structs, fresh_ret);
    var xt: CrossTupleReuseSites = cross_tuple_reuse_sites(stmts);
    var xbcons: string[] = xr.donors;
    var t: i32 = 0;
    while (t < xt.donors.len()) { xbcons = xbcons.append(xt.donors[t]); t = t + 1; }
    var k: i32 = 0;
    while (k < stmts.len()) {
        match (stmts[k]) {
            ast.StmtIf(iff) => {
                var pairs: string[] = xblock_pairings_for(stmts, structs, k, so.bases, xbcons, fresh_ret);
                var p: i32 = 0;
                while (p < pairs.len()) {
                    var e: string = pairs[p];
                    // "recip|donor|dtype" — split on the first two '|' (124).
                    var b1: i32 = 0;
                    while (b1 < e.len() && e[b1] != b'|') { b1 = b1 + 1; }
                    var recip: str = slice_unchecked(e, 0, b1);
                    var rest: str = slice_unchecked(e, b1 + 1, e.len());
                    var b2: i32 = 0;
                    while (b2 < rest.len() && rest[b2] != b'|') { b2 = b2 + 1; }
                    var donor: str = slice_unchecked(rest, 0, b2);
                    var pos: string = xblock_recip_pos(iff, recip);
                    if (pos.len() > 0) { acc = acc.append(pos + "<-" + donor); }
                    p = p + 1;
                }
            },
            _ => {}
        }
        k = k + 1;
    }
    // recurse into nested blocks (a cross-block pairing whose donor is in an
    // inner loop / arm and recipient in an if nested there).
    for stmt in stmts {
        match (stmt) {
            ast.StmtIf(f) => { acc = reuse_xblock_pairs(f.then_body, structs, fresh_ret, acc); acc = reuse_xblock_pairs(f.else_body, structs, fresh_ret, acc); },
            ast.StmtWhile(w) => { acc = reuse_xblock_pairs(w.body, structs, fresh_ret, acc); },
            ast.StmtFor(fo) => { acc = reuse_xblock_pairs(fo.body, structs, fresh_ret, acc); },
            ast.StmtMatch(m) => {
                for arm in m.arms { acc = reuse_xblock_pairs(arm.body, structs, fresh_ret, acc); }
            },
            _ => {}
        }
    }
    return acc;
}

// rc_child_blocks: the nested statement lists of `st` (if arms, loop / for
// bodies, match arm bodies). lower_block runs the per-block reuse pass on each
// of these, so the dump must recurse into them too — same-block pairings in a
// loop body (the canonical FBIP `while(..){ var a=T{}; ..; var b=T{} }`) fire
// at lowering but were invisible to a fn.body-top-level-only scan.
// Encoded flat (no nested arrays): callers pattern-match `st` themselves.

// reuse_sources_block: the same-block cross-struct / cross-tuple pairings of
// `stmts` (recipient-lit position <- donor name), then recurse into nested
// blocks. Mirrors lower_block's per-block cross_reuse_sites /
// cross_tuple_reuse_sites invocation.
function reuse_sources_block(stmts: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], out: string[]): string[] {
    var acc: string[] = out;
    var xr: CrossReuseSites = cross_reuse_sites(stmts, structs, fresh_ret);
    var i: i32 = 0;
    while (i < xr.idxs.len()) {
        match (stmts[xr.idxs[i]]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprStructLit(sl) => {
                        acc = acc.append(util.i32_to_string(sl.line) + ":" + util.i32_to_string(sl.col) + "<-" + xr.donors[i]);
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    var xt: CrossTupleReuseSites = cross_tuple_reuse_sites(stmts);
    var j: i32 = 0;
    while (j < xt.idxs.len()) {
        match (stmts[xt.idxs[j]]) {
            ast.StmtVar(v2) => {
                match (v2.init) {
                    ast.ExprTuple(tu) => {
                        acc = acc.append(util.i32_to_string(tu.line) + ":" + util.i32_to_string(tu.col) + "<-" + xt.donors[j]);
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        j = j + 1;
    }
    // recurse into nested blocks.
    for stmt in stmts {
        match (stmt) {
            ast.StmtIf(f) => { acc = reuse_sources_block(f.then_body, structs, fresh_ret, acc); acc = reuse_sources_block(f.else_body, structs, fresh_ret, acc); },
            ast.StmtWhile(w) => { acc = reuse_sources_block(w.body, structs, fresh_ret, acc); },
            ast.StmtFor(fo) => { acc = reuse_sources_block(fo.body, structs, fresh_ret, acc); },
            ast.StmtMatch(m) => {
                for arm in m.arms { acc = reuse_sources_block(arm.body, structs, fresh_ret, acc); }
            },
            _ => {}
        }
    }
    return acc;
}

// reuse_consumed_of: the donor-name set of the same pairings (all blocks).
pub function reuse_consumed_of(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[]): string[] {
    if (reuse_layer_disabled()) { return []; }
    return reuse_consumed_block(fn.body, structs, return_fresh_struct_ret_fns_of(funcs, structs, strfld_reclaim_ok_types_of(funcs, structs, borrowable_params_of(funcs))), []);
}

function reuse_consumed_block(stmts: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], out: string[]): string[] {
    var acc: string[] = out;
    // cross-block donors of THIS block first (dedup handled per-name below).
    var xbp: string[] = reuse_xblock_pairs(stmts, structs, fresh_ret, []);
    var xi: i32 = 0;
    while (xi < xbp.len()) {
        var dn: string = reuse_arrow_donor(xbp[xi]);
        if (dn.len() > 0 && util.index_of_str(acc, dn) < 0) { acc = acc.append(dn); }
        xi = xi + 1;
    }
    var xr: CrossReuseSites = cross_reuse_sites(stmts, structs, fresh_ret);
    var i: i32 = 0;
    while (i < xr.idxs.len()) {
        if (util.index_of_str(acc, xr.donors[i]) < 0) { acc = acc.append(xr.donors[i]); }
        i = i + 1;
    }
    var xt: CrossTupleReuseSites = cross_tuple_reuse_sites(stmts);
    var j: i32 = 0;
    while (j < xt.idxs.len()) {
        if (util.index_of_str(acc, xt.donors[j]) < 0) { acc = acc.append(xt.donors[j]); }
        j = j + 1;
    }
    for stmt in stmts {
        match (stmt) {
            ast.StmtIf(f) => { acc = reuse_consumed_block(f.then_body, structs, fresh_ret, acc); acc = reuse_consumed_block(f.else_body, structs, fresh_ret, acc); },
            ast.StmtWhile(w) => { acc = reuse_consumed_block(w.body, structs, fresh_ret, acc); },
            ast.StmtFor(fo) => { acc = reuse_consumed_block(fo.body, structs, fresh_ret, acc); },
            ast.StmtMatch(m) => {
                for arm in m.arms { acc = reuse_consumed_block(arm.body, structs, fresh_ret, acc); }
            },
            _ => {}
        }
    }
    return acc;
}

// --- consumingMatchReuse port (#4482, the last rcPlan table) -----------------
//
// Native's table (computeConsumingMatchReuse, #4475) marks the C2 pairing: an
// `own` enum PARAM consumed by a statement `match` whose unguarded arm is
// exactly `return Ctor(..)` of the same enum — those ctors take the scrutinee
// box via the reuse token. The SELF-HOST's consuming-match reuse is the inarm
// family (consumed_inarm_reuse_sites): a fresh sole-owner LOCAL consumed by a
// value-position `var y = match (x) {..}` whose every arm constructs a
// same-size variant. The two mechanisms are structurally different (own-param
// statement match vs local IIFE match) — the diff pins the difference per
// corpus case, documenting both gaps. Entries are the arm CTOR call
// positions, matching native nodePos of the ctor *ast.Call.
pub function consuming_match_reuse_of(fn: parser.FuncDecl, structs: parser.StructDecl[]): string[] {
    if (reuse_layer_disabled()) { return []; }
    return consuming_match_reuse_block(fn.body, structs, []);
}

function consuming_match_reuse_block(stmts: ast.Stmt[], structs: parser.StructDecl[], out: string[]): string[] {
    var acc: string[] = out;
    var sites: InArmReuseSites = consumed_inarm_reuse_sites(stmts, structs);
    var i: i32 = 0;
    while (i < sites.idxs.len()) {
        match (stmts[sites.idxs[i]]) {
            ast.StmtVar(v) => {
                var arms: ast.MatchArm[] = inarm_iife_match(v.init, structs);
                var ai: i32 = 0;
                while (ai < arms.len()) {
                    if (arms[ai].body.len() == 1) {
                        match (arms[ai].body[0]) {
                            ast.StmtReturn(r) => {
                                match (r.value) {
                                    ast.ExprCall(c) => {
                                        acc = acc.append(util.i32_to_string(c.line) + ":" + util.i32_to_string(c.col));
                                    },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                    }
                    ai = ai + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    for stmt in stmts {
        match (stmt) {
            ast.StmtIf(f) => { acc = consuming_match_reuse_block(f.then_body, structs, acc); acc = consuming_match_reuse_block(f.else_body, structs, acc); },
            ast.StmtWhile(w) => { acc = consuming_match_reuse_block(w.body, structs, acc); },
            ast.StmtFor(fo) => { acc = consuming_match_reuse_block(fo.body, structs, acc); },
            ast.StmtMatch(m) => {
                for arm in m.arms { acc = consuming_match_reuse_block(arm.body, structs, acc); }
            },
            _ => {}
        }
    }
    return acc;
}

// rc_plan_dump renders THIS function's Perceus decision tables in the pinned
// cross-compiler dump format (#4482 — the native side is
// internal/ir/rc_dump.go, format pinned by TestRcPlanDumpFormat): one
// `key: value` line per non-empty table, `preciseDrops` as
// `stmtIdx=name+name` groups sorted by index (names within a group sorted).
// Only the tables the self-host actually computes are emitted; a table the
// port doesn't have yet (movedLocals, moveSites, ...) is omitted entirely, so
// the native<->self-host diff DOCUMENTS the port gap instead of hiding it.
// Registries are derived per lower_func_for_noret's convention (the
// module-local `*_of(funcs)` side-tables, not a cross-module fixed point).
pub function rc_plan_dump(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[]): string {
    var head: string = "";
    // consumedParams (line order matches native's dumpRcPlan): the params
    // promoted to consumed-threading, name-sorted.
    var cps: string[] = consumed_params_of(fn, structs);
    if (cps.len() > 0) {
        var sorted: string[] = [];
        var ci: i32 = 0;
        while (ci < cps.len()) {
            var at: i32 = 0;
            while (at < sorted.len() && sorted[at] < cps[ci]) { at = at + 1; }
            var ns: string[] = [];
            var q: i32 = 0;
            while (q < at) { ns = ns.append(sorted[q]); q = q + 1; }
            ns = ns.append(cps[ci]);
            while (q < sorted.len()) { ns = ns.append(sorted[q]); q = q + 1; }
            sorted = ns;
            ci = ci + 1;
        }
        head = "consumedParams: ";
        var co: i32 = 0;
        while (co < sorted.len()) {
            if (co > 0) { head = head + ","; }
            head = head + sorted[co];
            co = co + 1;
        }
        head = head + "\n";
    }
    // freeEligible (#4482 — between consumedParams and preciseDrops, matching
    // native dumpRcPlan's line order): name-sorted, comma-joined.
    var fe: string[] = free_eligible_of(fn, structs, sig_reg_of(ret_type_fns_of(funcs)), sig_reg_of(noesc_ret_fns_of(funcs, structs)));
    if (fe.len() > 0) {
        var fes: string[] = [];
        var fi: i32 = 0;
        while (fi < fe.len()) {
            var at: i32 = 0;
            while (at < fes.len() && fes[at] < fe[fi]) { at = at + 1; }
            var ns: string[] = [];
            var q: i32 = 0;
            while (q < at) { ns = ns.append(fes[q]); q = q + 1; }
            ns = ns.append(fe[fi]);
            while (q < fes.len()) { ns = ns.append(fes[q]); q = q + 1; }
            fes = ns;
            fi = fi + 1;
        }
        head = head + "freeEligible: ";
        var fo: i32 = 0;
        while (fo < fes.len()) {
            if (fo > 0) { head = head + ","; }
            head = head + fes[fo];
            fo = fo + 1;
        }
        head = head + "\n";
    }
    // movedLocals (#4482 — after freeEligible, matching native dumpRcPlan's
    // line order): name-sorted, comma-joined.
    var ml: string[] = moved_locals_of(fn, structs);
    if (ml.len() > 0) {
        var mls: string[] = [];
        var mi: i32 = 0;
        while (mi < ml.len()) {
            var at: i32 = 0;
            while (at < mls.len() && mls[at] < ml[mi]) { at = at + 1; }
            var ns: string[] = [];
            var q: i32 = 0;
            while (q < at) { ns = ns.append(mls[q]); q = q + 1; }
            ns = ns.append(ml[mi]);
            while (q < mls.len()) { ns = ns.append(mls[q]); q = q + 1; }
            mls = ns;
            mi = mi + 1;
        }
        head = head + "movedLocals: ";
        var mo: i32 = 0;
        while (mo < mls.len()) {
            if (mo > 0) { head = head + ","; }
            head = head + mls[mo];
            mo = mo + 1;
        }
        head = head + "\n";
    }
    // moveSites (#4482 — after movedLocals, native dumpRcPlan's order):
    // "line:col" keys sorted as STRINGS (native sort.Strings — lexicographic,
    // so "10:1" orders before "9:2"), comma-joined.
    var msx: string[] = move_sites_of(fn, structs);
    if (msx.len() > 0) {
        var mss: string[] = [];
        var xi: i32 = 0;
        while (xi < msx.len()) {
            if (util.index_of_str(mss, msx[xi]) < 0) {
                var at: i32 = 0;
                while (at < mss.len() && mss[at] < msx[xi]) { at = at + 1; }
                var ns: string[] = [];
                var q: i32 = 0;
                while (q < at) { ns = ns.append(mss[q]); q = q + 1; }
                ns = ns.append(msx[xi]);
                while (q < mss.len()) { ns = ns.append(mss[q]); q = q + 1; }
                mss = ns;
            }
            xi = xi + 1;
        }
        head = head + "moveSites: ";
        var xo: i32 = 0;
        while (xo < mss.len()) {
            if (xo > 0) { head = head + ","; }
            head = head + mss[xo];
            xo = xo + 1;
        }
        head = head + "\n";
    }
    // arraySetInc (#4482 — after moveSites, native dumpRcPlan's order):
    // "line:col=true/false" entries sorted as strings, comma-joined.
    var asi: string[] = array_set_incs_of(fn, structs);
    if (asi.len() > 0) {
        var ass: string[] = [];
        var ii: i32 = 0;
        while (ii < asi.len()) {
            if (util.index_of_str(ass, asi[ii]) < 0) {
                var at: i32 = 0;
                while (at < ass.len() && ass[at] < asi[ii]) { at = at + 1; }
                var ns: string[] = [];
                var q: i32 = 0;
                while (q < at) { ns = ns.append(ass[q]); q = q + 1; }
                ns = ns.append(asi[ii]);
                while (q < ass.len()) { ns = ns.append(ass[q]); q = q + 1; }
                ass = ns;
            }
            ii = ii + 1;
        }
        head = head + "arraySetInc: ";
        var ao: i32 = 0;
        while (ao < ass.len()) {
            if (ao > 0) { head = head + ","; }
            head = head + ass[ao];
            ao = ao + 1;
        }
        head = head + "\n";
    }
    // reuseSources / reuseConsumed (#4482 — after arraySetInc, native
    // dumpRcPlan's order): "pos<-donor" entries and donor names, each
    // string-sorted and comma-joined.
    var rsx: string[] = reuse_sources_of(fn, structs, funcs);
    if (rsx.len() > 0) {
        var rss: string[] = [];
        var ri: i32 = 0;
        while (ri < rsx.len()) {
            if (util.index_of_str(rss, rsx[ri]) < 0) {
                var at: i32 = 0;
                while (at < rss.len() && rss[at] < rsx[ri]) { at = at + 1; }
                var ns: string[] = [];
                var q: i32 = 0;
                while (q < at) { ns = ns.append(rss[q]); q = q + 1; }
                ns = ns.append(rsx[ri]);
                while (q < rss.len()) { ns = ns.append(rss[q]); q = q + 1; }
                rss = ns;
            }
            ri = ri + 1;
        }
        head = head + "reuseSources: ";
        var ro: i32 = 0;
        while (ro < rss.len()) {
            if (ro > 0) { head = head + ","; }
            head = head + rss[ro];
            ro = ro + 1;
        }
        head = head + "\n";
    }
    var rcx: string[] = reuse_consumed_of(fn, structs, funcs);
    if (rcx.len() > 0) {
        var rcs: string[] = [];
        var ci2: i32 = 0;
        while (ci2 < rcx.len()) {
            var at: i32 = 0;
            while (at < rcs.len() && rcs[at] < rcx[ci2]) { at = at + 1; }
            var ns: string[] = [];
            var q: i32 = 0;
            while (q < at) { ns = ns.append(rcs[q]); q = q + 1; }
            ns = ns.append(rcx[ci2]);
            while (q < rcs.len()) { ns = ns.append(rcs[q]); q = q + 1; }
            rcs = ns;
            ci2 = ci2 + 1;
        }
        head = head + "reuseConsumed: ";
        var co2: i32 = 0;
        while (co2 < rcs.len()) {
            if (co2 > 0) { head = head + ","; }
            head = head + rcs[co2];
            co2 = co2 + 1;
        }
        head = head + "\n";
    }
    // consumingMatchReuse (#4482 — after reuseConsumed, native dumpRcPlan's
    // order): arm-ctor positions, string-sorted, comma-joined.
    var cmx: string[] = consuming_match_reuse_of(fn, structs);
    if (cmx.len() > 0) {
        var cms: string[] = [];
        var mi2: i32 = 0;
        while (mi2 < cmx.len()) {
            if (util.index_of_str(cms, cmx[mi2]) < 0) {
                var at: i32 = 0;
                while (at < cms.len() && cms[at] < cmx[mi2]) { at = at + 1; }
                var ns: string[] = [];
                var q: i32 = 0;
                while (q < at) { ns = ns.append(cms[q]); q = q + 1; }
                ns = ns.append(cmx[mi2]);
                while (q < cms.len()) { ns = ns.append(cms[q]); q = q + 1; }
                cms = ns;
            }
            mi2 = mi2 + 1;
        }
        head = head + "consumingMatchReuse: ";
        var mo2: i32 = 0;
        while (mo2 < cms.len()) {
            if (mo2 > 0) { head = head + ","; }
            head = head + cms[mo2];
            mo2 = mo2 + 1;
        }
        head = head + "\n";
    }
    // lastUses (#4482 — before preciseDrops, native dumpRcPlan's order): for
    // each free-eligible name, the LAST top-level statement index mentioning
    // it (ident reads + assign targets — astwalk.collect_idents_stmt, the
    // walk native's identCounts mirrors). Rendered `name=idx`, name-sorted;
    // a name the body never mentions is omitted.
    if (fe.len() > 0) {
        var lu_names: string[] = [];
        var lu_idx: i32[] = [];
        var lsi: i32 = 0;
        while (lsi < fn.body.len()) {
            var ments: string[] = astwalk.collect_idents_stmt(fn.body[lsi], []);
            var mi3: i32 = 0;
            while (mi3 < ments.len()) {
                if (util.index_of_str(fe, ments[mi3]) >= 0) {
                    var at0: i32 = util.index_of_str(lu_names, ments[mi3]);
                    if (at0 >= 0) { lu_idx = lu_idx.with(at0, lsi); }
                    else { lu_names = lu_names.append(ments[mi3]); lu_idx = lu_idx.append(lsi); }
                }
                mi3 = mi3 + 1;
            }
            lsi = lsi + 1;
        }
        if (lu_names.len() > 0) {
            var lu_sorted: string[] = [];
            var so: i32 = 0;
            while (so < lu_names.len()) {
                var at1: i32 = 0;
                while (at1 < lu_sorted.len() && lu_sorted[at1] < lu_names[so]) { at1 = at1 + 1; }
                var ns2: string[] = [];
                var q2: i32 = 0;
                while (q2 < at1) { ns2 = ns2.append(lu_sorted[q2]); q2 = q2 + 1; }
                ns2 = ns2.append(lu_names[so]);
                while (q2 < lu_sorted.len()) { ns2 = ns2.append(lu_sorted[q2]); q2 = q2 + 1; }
                lu_sorted = ns2;
                so = so + 1;
            }
            head = head + "lastUses: ";
            var lo: i32 = 0;
            while (lo < lu_sorted.len()) {
                if (lo > 0) { head = head + ","; }
                head = head + lu_sorted[lo] + "=" + util.i32_to_string(lu_idx[util.index_of_str(lu_names, lu_sorted[lo])]);
                lo = lo + 1;
            }
            head = head + "\n";
        }
    }
    var arr_ret: string[] = array_ret_fn_names(funcs);
    var pd: PreciseDrops = pd_filter_names(precise_drop_names(fn.body, structs, sig_reg_of(arr_ret), sig_reg_of(strarr_ret_fns_of(funcs)), borrowable_params_of(funcs), sig_reg_of(opt_fresh_ret_fns_of(funcs, structs)), str_fresh_ret_fns_of(funcs), move_sites_toplevel_of(fn, structs)), dead_alias_of(fn.body, rc_ml_compute(fn, structs).names).srcs);
    // Dump fidelity: lower_func SUPPRESSES the precise drop of a local consumed
    // as a reuse donor (its box survives into the recipient); the dump must
    // mirror that or it over-reports drops the lowering never emits (native's
    // computePreciseDrops excludes reuseConsumed the same way).
    var rc_donors: string[] = reuse_consumed_of(fn, structs, funcs);
    if (rc_donors.len() > 0) {
        var fidx: i32[] = [];
        var fnames: string[] = [];
        var fkinds: string[] = [];
        var fi2: i32 = 0;
        while (fi2 < pd.idxs.len()) {
            if (util.index_of_str(rc_donors, pd.names[fi2]) < 0) {
                fidx = fidx.append(pd.idxs[fi2]);
                fnames = fnames.append(pd.names[fi2]);
                fkinds = fkinds.append(pd.kinds[fi2]);
            }
            fi2 = fi2 + 1;
        }
        pd = PreciseDrops { idxs: fidx, names: fnames, kinds: fkinds };
    }
    if (pd.idxs.len() == 0) { return head; }
    // Distinct drop indices, insertion-sorted ascending (numeric — the native
    // renderer orders by parsed index, so "10" must sort after "9").
    var uidx: i32[] = [];
    var i: i32 = 0;
    while (i < pd.idxs.len()) {
        var seen: boolean = false;
        var j: i32 = 0;
        while (j < uidx.len()) {
            if (uidx[j] == pd.idxs[i]) { seen = true; }
            j = j + 1;
        }
        if (!seen) {
            var ins: i32 = 0;
            while (ins < uidx.len() && uidx[ins] < pd.idxs[i]) { ins = ins + 1; }
            var grown: i32[] = [];
            var g: i32 = 0;
            while (g < ins) { grown = grown.append(uidx[g]); g = g + 1; }
            grown = grown.append(pd.idxs[i]);
            while (g < uidx.len()) { grown = grown.append(uidx[g]); g = g + 1; }
            uidx = grown;
        }
        i = i + 1;
    }
    var out: string = head + "preciseDrops: ";
    var u: i32 = 0;
    while (u < uidx.len()) {
        // Names dropped after statement uidx[u], insertion-sorted ascending.
        var names: string[] = [];
        var p: i32 = 0;
        while (p < pd.idxs.len()) {
            if (pd.idxs[p] == uidx[u]) {
                var at: i32 = 0;
                while (at < names.len() && names[at] < pd.names[p]) { at = at + 1; }
                var nn: string[] = [];
                var q: i32 = 0;
                while (q < at) { nn = nn.append(names[q]); q = q + 1; }
                nn = nn.append(pd.names[p]);
                while (q < names.len()) { nn = nn.append(names[q]); q = q + 1; }
                names = nn;
            }
            p = p + 1;
        }
        if (u > 0) { out = out + ","; }
        out = out + util.i32_to_string(uidx[u]) + "=";
        var n: i32 = 0;
        while (n < names.len()) {
            if (n > 0) { out = out + "+"; }
            out = out + names[n];
            n = n + 1;
        }
        u = u + 1;
    }
    return out + "\n";
}

// str_own_word renders a str_own / str_*_ownership code as its dump word
// (#4297 CS4; codes + words mirror native ast.Ownership.String()).
function str_own_word(o: i32): string {
    if (o == 0) { return "owned"; }
    if (o == 2) { return "view"; }
    if (o == 3) { return "static"; }
    return "borrowed";
}

// str_own_dump renders the slot-carried string-ownership facts (#4297 CS4)
// for THIS function's top-level bindings -- the -str-own driver mode's body
// and the Go gate's assertion surface (the self-host analogue of native
// internal/ast/ownership_test.go). One line per string PARAM
// (`p <name>: borrowed` -- params are borrowed under owned-by-default), per
// top-level string VAR binding (`v <name>: <word>` -- the seeded
// str_binding_ownership fact read BACK off the slot via str_own_slot, so the
// line proves the mark/read round-trip), and per top-level `return <ident>`
// of a string slot (`r <name>: <word>` -- the read-side str_expr_ownership,
// which reflects the slot fact VERBATIM: an owned local reads owned).
// Top-level statements only: the dump is a unit surface for the classifier +
// accessor round-trip, not an analysis; nested-scope bindings ride the same
// lower_var seeding, validated behaviour-identical by the fixpoint + run
// gates. Registries follow rc_plan_dump's convention (module-local
// str_ret_fns_of side-table; everything irrelevant empty).
pub function str_own_dump(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[]): string {
    var no_ops: ir.Op[] = [];
    var no_blk: i32[] = [];
    var no_strs: string[] = [];
    var no_stmts: ast.Stmt[] = [];
    var locals0: LocalInfo[] = [];
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        var li: LocalInfo = li_new(fn.params[pi].name);
        if (fn.params[pi].type_name == "string") { li = li_set_is_str(li, true); }
        locals0 = locals0.append(li);
        pi = pi + 1;
    }
    var st: LowerState = LowerState { ops: no_ops, locals: locals0, ctrl: 0, loop_blk: no_blk, ret_is_i64: false, ret_arrdyn: 0, sigs: FnSigs { ...fn_sigs_empty(), str_ret_fns: sig_reg_of(str_ret_fns_of(funcs)) }, clo_base: clo_owner_name(fn), cur_fn: fn.name, cur_ret: fn.ret_type, closure_locals: no_strs, tup_elem_kinds: no_strs, alias_incs: no_strs, dead_alias_ok: no_strs, spread_sites: spread_sites_of(fn.body, structs, []), fnval_seed: no_strs, structs: structs, reclaimable_names: no_strs, aliased_names: no_strs, map_clone_sites: no_strs, borrowed_names: no_strs, xblock_pending: no_strs, optret_pending: [], try_cleanup: no_stmts, defer_slots: no_strs, defer_guard: "", grow_exempt: [], append_inplace: [], grow_sole: [], own_params: own_param_names_of(fn), n_params: fn.params.len(), ok: true, fail_why: "", selfrebind: "", moved_names: [], moved_elided: [], move_sites: [] };
    var out: string = "";
    var qi: i32 = 0;
    while (qi < fn.params.len()) {
        if (fn.params[qi].type_name == "string") {
            out = out + "p " + fn.params[qi].name + ": " + str_own_word(st.str_own_slot(qi)) + "\n";
        }
        qi = qi + 1;
    }
    var si: i32 = 0;
    while (si < fn.body.len()) {
        match (fn.body[si]) {
            ast.StmtVar(v) => {
                var vstr: boolean = v.type_name == "string" || expr_is_str(v.init, st);
                var own: i32 = str_binding_ownership(v.init, st);
                st = st.add_local(v.name);
                var slot: i32 = st.slot_of(v.name);
                if (vstr) {
                    st = st.mark_str(slot, true);
                    st = st.mark_str_own(slot, own);
                    out = out + "v " + v.name + ": " + str_own_word(st.str_own_slot(slot)) + "\n";
                }
            },
            ast.StmtAssign(a2) => {
                // The reassignment MEET, mirroring lower_stmt_assign's:
                // equal classes keep the fact, differing classes demote to
                // Borrowed. The `a` line prints the post-meet slot fact.
                var aslot: i32 = st.slot_of(a2.target);
                if (aslot >= 0 && st.is_str_slot(aslot)) {
                    if (str_binding_ownership(a2.value, st) != st.str_own_slot(aslot)) { st = st.mark_str_own(aslot, 1); }
                    out = out + "a " + a2.target + ": " + str_own_word(st.str_own_slot(aslot)) + "\n";
                }
            },
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprIdent(rid) => {
                        var rslot: i32 = st.slot_of(rid.name);
                        if (rslot >= 0 && st.is_str_slot(rslot)) {
                            out = out + "r " + rid.name + ": " + str_own_word(str_expr_ownership(r.value, st)) + "\n";
                        }
                    },
                    _ => { }
                }
            },
            _ => { }
        }
        si = si + 1;
    }
    return out;
}

// i64_sig_of returns the "<ret><params>" flag string for `name`, or "" if the
// function has no i64 signature entry.
pub function (s: LowerState) i64_sig_of(name: string): string {
    return sig_reg_value_of(s.sigs.i64_ret_fns, name);
}
// is_i64_ret_fn reports whether `name` returns a 64-bit integer (i64 OR u64) —
// the ret flag of its sig is '1' (i64) or '2' (u64). Both are i64-wide, so this
// width query accepts either; is_u64_ret_fn distinguishes the unsigned case.
// mod_fn_name returns `name` when it names a module FUNCTION, and "" when a
// local slot shadows it. Every *_ret_fn registry below is keyed by bare name,
// so each has to be asked about a module function rather than a parameter that
// happens to share its name: `map(xs, f)` calls its PARAMETER `f`. Without this
// a user function named `f` returning i64 or i64[] answered for std/array's `f`
// parameter, bailing the module on the register backends and emitting a wasm
// module that would not load (#6283). "" matches no registry entry, so wrapping
// a lookup in it is always the conservative direction.
pub function (s: LowerState) mod_fn_name(name: string): string {
    if (s.slot_of(name) >= 0) { return ""; }
    return name;
}

pub function (s: LowerState) is_i64_ret_fn(name: string): boolean {
    var sig: string = s.i64_sig_of(name);
    return sig.len() >= 1 && (sig[0] == b'1' || sig[0] == b'2');   // ret flag: '1' i64, '2' u64
}
// is_u64_ret_fn reports whether `name` returns u64 specifically (ret flag '2'),
// so a call to it directly chained in an unsigned op (`f(a) >> 1`) selects the
// unsigned form. The i64 case ('1') stays signed (the default), so only the
// unsigned distinction needs its own query. #5159.
pub function (s: LowerState) is_u64_ret_fn(name: string): boolean {
    var sig: string = s.i64_sig_of(name);
    return sig.len() >= 1 && sig[0] == b'2';
}
// is_u32_ret_fn reports whether `name` returns u32 (ret flag '3'), so a call to
// it directly chained in an unsigned op (`f(a) >> 1`, `p.get() / 7`) selects the
// unsigned form. u32 rides the same i64_ret_fns registry as i64 ('1') / u64
// ('2') — but its ret flag '3' is read by NOTHING else (is_i64_ret_fn accepts
// only '1'/'2'; the param flags stay i64-only), so it never perturbs 64-bit
// width or param lowering. wasm-only: x86-64 / arm64 keep the u32 zero-extended
// in a 64-bit register, so a signed shift already matched there (#5245).
pub function (s: LowerState) is_u32_ret_fn(name: string): boolean {
    var sig: string = s.i64_sig_of(name);
    return sig.len() >= 1 && sig[0] == b'3';
}
// is_u8_ret_fn reports whether `name` returns u8 — ret flag '5'. Read by
// expr_subword_kind's ExprCall arm, which is what lets a saturating binary over
// u8-returning calls clamp at 255 / 0 rather than at the i32 bounds.
pub function (s: LowerState) is_u8_ret_fn(name: string): boolean {
    var sig: string = s.i64_sig_of(name);
    return sig.len() >= 1 && sig[0] == b'5';
}
// is_f64_ret_fn reports whether free function `name` returns f64 (so a call to
// it is recognised as an f64 value).
pub function (s: LowerState) is_f64_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.f64_ret_fns, name);
}
// is_f64arr_ret_fn reports whether `name` returns f64[] (so a `var x = f()`
// binding element-width-tracks x as f64[]). `name` is the bare callee for a free
// function or the qualified "<Type>.<method>" for a method call.
pub function (s: LowerState) is_f64arr_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.f64arr_ret_fns, name);
}
// is_i64arr_ret_fn reports whether `name` returns i64[] (bare name or
// "<Type>.<method>", same convention as is_f64arr_ret_fn).
pub function (s: LowerState) is_i64arr_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.i64arr_ret_fns, name);
}
// is_erased_elem_ret_fn reports whether a call to `name` yields an array whose
// ELEMENT width the callee never fixed (`map` / `flat_map` returning `U[]`).
pub function (s: LowerState) is_erased_elem_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.erased_elem_ret_fns, name);
}
// param_is_i64 reports whether arg index `idx` of a call to `name` targets an
// i64 param (so the argument must be lowered as an i64 value).
pub function (s: LowerState) param_is_i64(name: string, idx: i32): boolean {
    var sig: string = s.i64_sig_of(name);
    var pos: i32 = idx + 1;   // skip the ret flag
    return pos < sig.len() && sig[pos] == b'1';
}

// param_is_f64 reports whether callee `name`'s param `idx` is an f64/f32, so
// an integer argument there can be converted rather than pushed raw. Reads the
// same "ret+params" signature registry param_is_i64 does — the f64 flag is '4'
// (see i64_ret_fns_of) — which is why this needs no extra LowerState field.
pub function (s: LowerState) param_is_f64(name: string, idx: i32): boolean {
    var sig: string = s.i64_sig_of(name);
    var pos: i32 = idx + 1;   // skip the ret flag
    return pos < sig.len() && sig[pos] == b'4';
}

// callee_param_is_fn reports whether callee `name`'s param `idx` is a function
// type ("fn") — so a bare function-name argument there is a function VALUE
// (const_func), not a call. Mirrors asmcore.callee_param_is_fn, reading the
// fn_param_sigs registry ("callee|<flags>").
pub function (s: LowerState) callee_param_is_fn(name: string, idx: i32): boolean {
    return sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx) == 49;   // 49 = '1'
}

// erased_wide_stmts / erased_wide_expr: the post-lowering scan behind
// LowerResult.erased_wide — does the body pass a 64-bit (i64/u64) or f64
// value to a BARE-TYPEVAR (erased-generic) param? Uses the FINAL LowerState
// (every local's width mark is recorded), so infer_expr_width / expr_is_f64
// judge argument expressions exactly as the lowering did. f64 is included
// even though the register backends lower it fine: the wasm backend types an
// erased param local i32, so both wide kinds must refuse the wasm lowering.
pub function erased_wide_stmts(stmts: ast.Stmt[], s: LowerState): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (erased_wide_expr(v.init, s)) { return true; }
                if (erased_elem_dest_wide(v.type_name, v.init, s)) { return true; }
            },
            ast.StmtAssign(a) => {
                if (erased_wide_expr(a.value, s)) { return true; }
                // The assigned slot's element width is already recorded, so the
                // same erased-element result question is answerable here.
                if (s.for_wasm() && calls_erased_elem_ret_fn(a.value, s)) {
                    var asl: i32 = s.slot_of(a.target);
                    if (asl >= 0 && (s.is_i64arr_slot(asl) || s.is_f64arr_slot(asl))) { return true; }
                }
            },
            ast.StmtExpr(ex) => { if (erased_wide_expr(ex.value, s)) { return true; } },
            ast.StmtReturn(r) => {
                if (erased_wide_expr(r.value, s)) { return true; }
                if (erased_elem_dest_wide(s.cur_ret, r.value, s)) { return true; }
            },
            ast.StmtIf(iff) => {
                if (erased_wide_expr(iff.cond, s)) { return true; }
                if (erased_wide_stmts(iff.then_body, s)) { return true; }
                if (erased_wide_stmts(iff.else_body, s)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (erased_wide_expr(w.cond, s)) { return true; }
                if (erased_wide_stmts(w.body, s)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (erased_wide_expr(fo.iter, s)) { return true; }
                if (erased_wide_stmts(fo.body, s)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (erased_wide_expr(m.scrutinee, s)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && erased_wide_expr(arm.guard, s)) { return true; }
                    if (erased_wide_stmts(arm.body, s)) { return true; }
                }
            },
            ast.StmtDefer(d) => { if (erased_wide_stmts([d.action], s)) { return true; } },
            _ => {}
        }
    }
    return false;
}
// erased_elem_dest_wide: does `init` call a function whose result array has an
// ERASED element width (map / flat_map returning `U[]`), at a destination that
// reads that array's elements 8 bytes wide? On wasm32 the callee strides the
// array it built at 4 (the erased element's i32 width) while the destination
// indexes at 8, so the length is right and every value is wrong (#6287).
//
// Refusing mirrors what the flag-'7' erased `T[]` PARAM check already does for
// the same hazard arriving from the other direction. wasm only: the register
// backends give the erased element a full 8-byte slot, and both measured shapes
// (`flat_map` and `map` into `i64[]` / `f64[]`) answer correctly there.
function erased_elem_dest_wide(type_name: string, init: ast.Expr, s: LowerState): boolean {
    if (!s.for_wasm()) { return false; }
    if (!(type_name == "i64[]" || type_name == "u64[]" || is_float_array_type_name(type_name))) { return false; }
    return calls_erased_elem_ret_fn(init, s);
}

// calls_erased_elem_ret_fn reports whether `e` is a direct call to a function
// registered in erased_elem_ret_fns.
function calls_erased_elem_ret_fn(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return s.is_erased_elem_ret_fn(s.mod_fn_name(cid.name)); },
                ast.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_erased_elem_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
        },
        _ => { }
    }
    return false;
}

// erased_result_wide_from_callback: the erased element `U` of a `map` /
// `flat_map` result is fixed by the CALLBACK, not by any parameter's type — so
// the call site can be asked directly, whatever the destination does with the
// result. A callback returning a 64-bit or float value (map's `U`) or an array
// of one (flat_map's `U[]`) means the callee built its result array at the
// erased i32 stride while every reader indexes it at 8 (#6287).
//
// Asked of a lambda written at the call site and of an already-lifted `__lam_`
// passed by name, since closure lifting may have run first.
function erased_result_wide_from_callback(arg: ast.Expr, s: LowerState): boolean {
    match (arg) {
        ast.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                match (lm.body[i]) {
                    ast.StmtReturn(r) => {
                        if (expr_is_f64(r.value, s) || infer_expr_width(r.value, s) == 64) { return true; }
                        if (expr_is_f64arr(r.value, s) || expr_is_i64arr(r.value, s)) { return true; }
                        match (r.value) {
                            ast.ExprArray(al) => {
                                if (al.elements.len() > 0
                                    && (expr_is_f64(al.elements[0], s) || infer_expr_width(al.elements[0], s) == 64)) { return true; }
                            },
                            _ => { }
                        }
                    },
                    _ => { }
                }
                i = i + 1;
            }
            return false;
        },
        ast.ExprIdent(id) => {
            var nm: string = s.mod_fn_name(id.name);
            return s.is_i64_ret_fn(nm) || s.is_f64_ret_fn(nm) || s.is_i64arr_ret_fn(nm) || s.is_f64arr_ret_fn(nm);
        },
        _ => { }
    }
    return false;
}

function erased_wide_expr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // A wide value through an erased param is HANDLED on wasm exactly
                    // when that param is WIDENED (flag '6', callee_param_is_erased_widened):
                    // a bare-typevar-return pass-through (`id[T](x:T):T`, #5586) or a
                    // bare-tuple return (`pair[K,V](k,v):(K,V)`, whose 8-byte-per-element
                    // box reads back at the concrete width — #5464 tuple slice). A wide
                    // arg to a NON-widened erased param (flag '5' — a fold-style body, or
                    // an Option/Result/array return not yet handled) still refuses the
                    // module. Non-wasm lowerings ignore erased_wide.
                    if (s.for_wasm()) {
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            if (s.callee_param_is_typevar(cid.name, ai)
                                && (expr_is_f64(c.args[ai], s) || infer_expr_width(c.args[ai], s) == 64)
                                && !s.callee_param_is_erased_widened(cid.name, ai)) { return true; }
                            // A wide-ELEMENT array through an erased `T[]` param.
                            // Nothing wide is passed by value, so the check above
                            // cannot see it; but the callee indexes and appends at
                            // an erased element width, which on wasm32 is a 4-byte
                            // stride through an 8-byte-element array — silently
                            // wrong values, not a trap. Refuse the module instead.
                            if (s.callee_param_is_erased_array(cid.name, ai)
                                && (expr_is_f64arr(c.args[ai], s) || expr_is_i64arr(c.args[ai], s))) { return true; }
                            // A wide element coming back OUT: the callee returns an
                            // erased-element array (`map`/`flat_map`'s `U[]`) and this
                            // site's callback fixes that element wide. Same 4-vs-8
                            // stride hazard as the param case above, in the direction
                            // nothing looked at (#6287).
                            if (s.is_erased_elem_ret_fn(s.mod_fn_name(cid.name))
                                && erased_result_wide_from_callback(c.args[ai], s)) { return true; }
                            ai = ai + 1;
                        }
                    } else {
                        var ai2: i32 = 0;
                        while (ai2 < c.args.len()) {
                            if (s.callee_param_is_typevar(cid.name, ai2)
                                && (expr_is_f64(c.args[ai2], s) || infer_expr_width(c.args[ai2], s) == 64)) { return true; }
                            ai2 = ai2 + 1;
                        }
                    }
                },
                _ => {
                    if (erased_wide_expr(c.callee, s)) { return true; }
                }
            }
            for arg in c.args { if (erased_wide_expr(arg, s)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return erased_wide_expr(b.left, s) || erased_wide_expr(b.right, s); },
        ast.ExprUnary(u) => { return erased_wide_expr(u.operand, s); },
        ast.ExprIndex(ix) => { return erased_wide_expr(ix.array, s) || erased_wide_expr(ix.index, s); },
        ast.ExprSlice(sl) => { return erased_wide_expr(sl.array, s) || erased_wide_expr(sl.start, s) || erased_wide_expr(sl.end, s); },
        ast.ExprFieldAccess(fa) => { return erased_wide_expr(fa.obj, s); },
        ast.ExprStructLit(sl2) => {
            if (sl2.has_base && erased_wide_expr(sl2.base, s)) { return true; }
            var i: i32 = 0;
            while (i < sl2.field_values.len()) { if (erased_wide_expr(sl2.field_values[i], s)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprArray(av) => {
            var i: i32 = 0;
            while (i < av.elements.len()) { if (erased_wide_expr(av.elements[i], s)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (erased_wide_expr(el, s)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => { return erased_wide_stmts(lm.body, s); },
        _ => { return false; }
    }
    return false;
}

// callee_param_is_typevar reports whether callee `name`'s param `idx` is a
// bare-typevar (erased-generic) param — flag '5' OR '6' in fn_param_sigs (both
// mark an erased param; '6' additionally marks a wasm-widenable pass-through) —
// so a 64-bit argument there must be lowered via lower_i64 (the erased slot
// takes the full 8-byte value on the register backends). Accepting both keeps
// the register i64-arg path identical regardless of the pass-through split.
pub function (s: LowerState) callee_param_is_typevar(name: string, idx: i32): boolean {
    var f: i32 = sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx);
    return f == 53 || f == 54;   // 53 = '5', 54 = '6'
}

// callee_param_is_erased_array reports whether callee `name`'s param `idx` is an
// erased typevar ARRAY param — flag '7'. Drives the wasm erased-wide refusal for
// a wide-ELEMENT array argument.
pub function (s: LowerState) callee_param_is_erased_array(name: string, idx: i32): boolean {
    return sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx) == 55;   // 55 = '7'
}

// callee_param_is_erased_widened reports whether callee `name`'s param `idx` is
// a WASM-WIDENABLE erased pass-through param — flag '6' only (erased_passthrough_safe).
// The wasm-only arg coercion / result narrowing / erased_wide carve-out key on
// this, so an erased param of a fn that USES its typevar (fold's closure fold,
// a container return — flag '5') is NOT widened and its module defers on a wide
// instantiation instead of miscompiling.
pub function (s: LowerState) callee_param_is_erased_widened(name: string, idx: i32): boolean {
    return sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx) == 54;   // 54 = '6'
}

// callee_param_is_dyn reports whether callee `name`'s param `idx` is a
// `dyn Trait` type (flag '2' in fn_param_sigs) — so a primitive/string arg
// there must be heap-boxed into a `dyn` cell (op_dyn_box) before the call
// (docs/DYN-TRAITS.md §4.2.3). Same registry/format as callee_param_is_fn.
pub function (s: LowerState) callee_param_is_dyn(name: string, idx: i32): boolean {
    return sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx) == 50;   // 50 = '2'
}

// callee_param_is_dyn_arr reports whether callee `name`'s param `idx` is a
// `dyn Trait[]` ARRAY type (flag '8' in fn_param_sigs) — so an array LITERAL
// argument there must have each element coerced to `dyn` before the buffer is
// built (docs/DYN-TRAITS.md §4.3, #6906).
pub function (s: LowerState) callee_param_is_dyn_arr(name: string, idx: i32): boolean {
    return sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx) == 56;   // 56 = '8'
}

// opt_ret_type returns the recorded ret_type for a function name in opt_ret_fns
// ("Option[T]"/"Result[T, E]"), or "" if not an Option/Result-returning fn.
pub function (s: LowerState) opt_ret_type(name: string): string {
    var v: string = sig_reg_value_of(s.sigs.opt_ret_fns, name);
    if (v.len() > 0) { return v; }
    // Built-in I/O functions return a fixed Option/Result the lowering must
    // recognise so a `match (read_file(p)) { Ok => .., Err => .. }` scrutinee or a
    // `var r = read_file(p)` binding resolves the result type (read_file lowers to
    // op_read_file). Checked AFTER the registry so a user decl of the same name
    // still wins. read_file → Result[string, IoError].
    if (name == "read_file") { return "Result[string, IoError]"; }
    if (name == "read_file_bytes") { return "Result[u8[], IoError]"; }
    if (name == "write_file") { return "Result[void, IoError]"; }
    if (name == "write_file_exec") { return "Result[void, IoError]"; }
    if (name == "remove_dir_all") { return "Result[void, IoError]"; }
    if (name == "remove_file") { return "Result[void, IoError]"; }
    if (name == "create_dir_all") { return "Result[void, IoError]"; }
    if (name == "temp_dir") { return "Result[string, IoError]"; }
    if (name == "read_dir") { return "Result[string[], IoError]"; }
    if (name == "env") { return "Option[string]"; }
    if (name == "stat") { return "Result[FileStat, IoError]"; }
    if (name == "lstat") { return "Result[FileStat, IoError]"; }
    // The streaming-I/O constructors (#7758): open_reader -> Result[Reader,
    // IoError], open_writer / open_appender -> Result[Writer, IoError], so
    // `match (open_reader(p)) { Ok(r) => .., Err(e) => .. }` recovers both
    // payload types. Reader / Writer are represented by the bare fd, so the
    // Ok binder is an i32 slot the resource intrinsics dispatch off.
    if (name == "open_reader") { return "Result[Reader, IoError]"; }
    if (name == "open_writer" || name == "open_appender") { return "Result[Writer, IoError]"; }
    // read_line → Option[string] (#4369): so a `match (read_line()) { Some(s) =>
    // .., None => .. }` scrutinee (or a `var o = read_line()` binding) recovers the
    // payload type and str-tracks the Some binder `s` for `.len()` / write dispatch.
    if (name == "read_line") { return "Option[string]"; }
    // The streaming-I/O METHODS, keyed as native keys its Methods table
    // (registerStructMethod in internal/checker) so the two compilers cannot
    // drift again: the Reader reads yield Option[string], and every close plus
    // Writer.write yields Option[IoError] — write reports failure, NOT the byte
    // count, which native's signature has nowhere to put (#7926).
    // resource_method_opt_ret_type applies the bare-fd receiver gate and routes
    // here; Writer.close shares Reader.close's op and answer.
    if (name == "Reader.read_line" || name == "Reader.read_chunk") { return "Option[string]"; }
    if (name == "Reader.close" || name == "Writer.close" || name == "Writer.write") { return "Option[IoError]"; }
    return "";
}

// tuple_ret_type returns the comma-joined element-type tags for tuple-returning
// free function `name` (e.g. "i32,string,i32"), ready to drop into a slot's
// local_tuple_elems, or "" if `name` isn't a (lowered) tuple-returning function.
pub function (s: LowerState) tuple_ret_type(name: string): string {
    return sig_reg_value_of(s.sigs.tuple_ret_fns, name);
}

// struct_ret_type returns the struct type name returned by free function `name`,
// or "" if `name` isn't a (lowered) struct-returning function.
pub function (s: LowerState) struct_ret_type(name: string): string {
    var v: string = sig_reg_value_of(s.sigs.struct_ret_fns, name);
    // Skip a POSITIONAL "$arg<i>" entry (the erased-generic `T[]` return, read by
    // struct_ret_argref): it is an argument INDEX, not a struct name. Unlike the
    // string-side registries — where the '|' makes an argref invisible to a bare
    // exact-name membership scan — '|' is this registry's field SEPARATOR, so
    // without this guard `var s = idf(xs)` would take "$arg0" as its struct type.
    if (v.len() > 4 && bytes_at(v, 0, "$arg")) { return ""; }
    return v;
}

// map_ret_type returns the Map[K,V] type a function `name` returns (keyed bare
// for free functions, "<Type>.<method>" for methods), or "" — so `var m = f()`
// recovers the map type for method dispatch without an annotation. Mirrors
// struct_ret_type. #3317.
pub function (s: LowerState) map_ret_type(name: string): string {
    return sig_reg_value_of(s.sigs.map_ret_fns, name);
}

// opt_payload_type parses a "Option[T]" / "Result[T, E]" ret_type and the bound
// variant to the payload type tag: T for Some/Ok, E for Err. Returns "" if the
// shape isn't a simple single-type-arg form (nested generics / tuples bail).
pub function opt_payload_type(rettype: string, variant: string): string {
    var n: i32 = rettype.len();
    if (n >= 8 && slice_unchecked(rettype, 0, 7) == "Option[" && rettype[n - 1] == b']') {
        return slice_unchecked(rettype, 7, n - 1) + "";
    }
    if (n >= 8 && slice_unchecked(rettype, 0, 7) == "Result[" && rettype[n - 1] == b']') {
        // Split the inside on the FIRST top-level comma: T , E. Depth counts both
        // `[`/`]` (a nested Option/Result/Map payload) AND `(`/`)` (a tuple
        // payload, e.g. `Result[(i32, i32), string]`), so the comma inside a
        // bracketed/parenthesised T is not mistaken for the T-E separator.
        var inside: str = slice_unchecked(rettype, 7, n - 1);
        var depth: i32 = 0;
        var ci: i32 = 0;
        while (ci < inside.len()) {
            var ch: u8 = inside[ci];
            if (ch == b'[' || ch == b'(') { depth = depth + 1; }
            else if (ch == b']' || ch == b')') { depth = depth - 1; }
            else if (ch == b',' && depth == 0) {           // at top level
                if (variant == "Err") { return trim_spaces(slice_unchecked(inside, ci + 1, inside.len())); }
                return trim_spaces(slice_unchecked(inside, 0, ci));
            }
            ci = ci + 1;
        }
        return "";
    }
    return "";
}

// is_fn_payload_spelling reports whether a recovered Option/Result payload type
// spelling `t` names a FUNCTION type (slice #3445 match-fn). Detected
// CONSERVATIVELY: only the unambiguous single-paren fn forms — `() => …` (no
// params) or `(T) => …` (one param) — count. A multi-element tuple spelling
// `(A, B)` is NEVER a fn (it has no top-level `=>` and the leading `(` is a
// tuple, not a param list), so a top-level comma inside the leading parens
// disqualifies it. The match arm marks a payload of this spelling a closure
// local so the bound `f(args)` dispatches env-first against the env box the
// constructor side wrapped.
pub function is_fn_payload_spelling(t: string): boolean {
    var n: i32 = t.len();
    if (n < 5) { return false; }                 // shortest is "()=>X"
    if (t[0] != b'(') { return false; }
    // Find the matching ')' for the leading '(' at top depth; reject a
    // top-level comma inside (that's a multi-element tuple, not a param list).
    var depth: i32 = 0;
    var i: i32 = 0;
    var close: i32 = 0 - 1;
    while (i < n) {
        var ch: u8 = t[i];
        if (ch == b'(' || ch == b'[') { depth = depth + 1; }
        else if (ch == b')' || ch == b']') {
            depth = depth - 1;
            if (depth == 0 && ch == b')') { close = i; i = n; }
        }
        else if (ch == b',' && depth == 1) { return false; }   // a top-level comma means a tuple
        i = i + 1;
    }
    if (close < 0) { return false; }
    // After the ')' (skipping spaces) the next two chars must be "=>".
    var j: i32 = close + 1;
    while (j < n && t[j] == b' ') { j = j + 1; }
    if (j + 1 >= n) { return false; }
    return t[j] == b'=' && t[j + 1] == b'>';
}

// map_key_kind_of returns 1 for an i32-keyed Map type, 0 for string-keyed
// ("Map[i32, V]" / "Map[string, V]").
pub function map_key_kind_of(typestr: string): i32 {
    if (typestr.len() >= 8 && slice_unchecked(typestr, 0, 8) == "Map[i32,") { return 1; }
    return 0;
}

// map_value_of returns the value type V of a "Map[K, V]" type string (i32 /
// string), or "" if not parseable.
// map_value_is_ptr reports whether a map's VALUE type is a heap pointer (so
// op_map_set must set the wasm `vis` RC-retain flag — #3495). Conservative:
// only the known scalar value types are non-pointers; everything else
// (string / arrays / structs / enums / tuples / fn / generic `V` / unknown)
// retains. Defaulting unknown to "pointer" is the safe direction — an extra
// retain leaks at worst, whereas a missed retain frees a live value under the
// map (the corruption this fixes).
function map_value_is_ptr(vt: string): boolean {
    if (vt == "i32" || vt == "i64" || vt == "f64" || vt == "f32") { return false; }
    if (vt == "bool" || vt == "boolean") { return false; }
    if (vt == "u8" || vt == "u32" || vt == "u64") { return false; }
    return true;
}

// map_owncols (#4353 layer 0, general case — #5335): BOTH of the map's declared
// "Map[K, V]" columns read back as SNAPSHOTS (map_kv_elem_flag != 1: an i32
// column snapshot-copies via __fern_map_snapshot_col, a string column snapshots
// with per-element retain via __fern_map_snapshot_col_str), so no keys()/values()
// read can alias the raw keys@0/vals@8 buffers and the map is therefore their
// sole owner — op_map_set may free the superseded buffer on a grow
// (__fern_arr_push_owned) instead of leaking it. Defined IN TERMS OF
// map_kv_elem_flag so the "owned ⇒ every read snapshots" invariant is structural:
// i64/u64/f64 and struct/generic/unparseable ("Map[K, V]", "") columns are flag 1
// (raw-buffer alias reads) and stay on the leak-only push — freeing their
// superseded buffer would dangle a live `var vs = m.values()`. (A boolean
// annotation normalizes to i32 in the type tag before reaching here, so
// Map[i32, boolean] IS owned — consistently, its reads see the same normalized
// tag and snapshot.)
function map_owncols(mty: string): boolean {
    return map_kv_elem_flag(mty, "keys") != 1 && map_kv_elem_flag(mty, "values") != 1;
}

// map_site_owncols: the insert's receiver is a map local credited "MAPOWN:" —
// reclaimable, and read only through len / has / get / get_or, so no
// keys() / values() alias of a flag-1 column can outlive a grow.
function map_site_owncols(recv: ast.Expr, s: LowerState): boolean {
    match (recv) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0 || !slot_credit_at(s, sl, "MAPOWN:")) { return false; }
            // Only a BOX value column the map free reclaims per element. A
            // wide-scalar (i64 / f64) column keeps the type-level verdict: its
            // cells are the map's and the owned grow buys nothing there, so the
            // pinned flag contract for those columns stands
            // (self_host_map_strcol_owncols_ir_test.go).
            return map_val_box_column_ok(map_value_of(s.map_type_of(sl)), s.structs);
        },
        _ => { return false; }
    }
    return false;
}

// map_kv_elem_flag derives op_map_keys / op_map_values' element-kind flag from
// the map's "Map[K, V]" type tag: 0 = scalar i32 column (the register backends
// SNAPSHOT it — a fresh owned rc=1 copy), 2 = string column (snapshot with
// per-element retain), 1 = pointer/i64/f64/generic/unknown column (the register
// backends keep the raw-buffer ALIAS). map_owncols above is DEFINED from this
// function (owned ⇔ neither column is flag 1): a flag-1 alias read of an owned
// map would dangle once the grow path frees the superseded buffer, so any new
// column kind added here must return 1 until its reads snapshot.
function map_kv_elem_flag(mty: string, field: string): i32 {
    if (field == "keys") {
        if (map_key_kind_of(mty) == 1) { return 0; }
        // #4353 slice 3: a STRING column snapshots with per-element retain
        // (flag 2) — __fern_map_snapshot_col_str copies the column and
        // rc-incs each element (string boxes are rc-headered: __fern_str_box
        // builds {rc,data,len} with box-8 the rc word), so the read owns its
        // strings and the SARR deep release (__fern_str_arr_free, rc-aware
        // per-element __fern_str_free) balances exactly. Flag 1 (raw alias)
        // remains only for i64/f64/struct/generic columns.
        if (map_key_of(mty) == "string") { return 2; }
        return 1;
    }
    if (map_value_of(mty) == "i32") { return 0; }
    if (map_value_of(mty) == "string") { return 2; }
    return 1;
}

pub function map_value_of(typestr: string): string {
    if (typestr.len() < 5 || slice_unchecked(typestr, 0, 4) != "Map[") { return ""; }
    var inner: str = slice_unchecked(typestr, 4, typestr.len() - 1);   // K, V
    var ci: i32 = 0;
    while (ci < inner.len() && inner[ci] != b',') { ci = ci + 1; }   // first comma
    if (ci >= inner.len()) { return ""; }
    return trim_spaces(slice_unchecked(inner, ci + 1, inner.len()));
}

// map_key_of returns the key type K of a "Map[K, V]" type string, or ""
// if not parseable — the K-side counterpart of map_value_of.
// map_with_key respells a "Map[K, V]" tag with a different key type.
function map_with_key(mtype: string, k: string): string {
    var v: string = map_value_of(mtype);
    if (v == "") { return mtype; }
    return "Map[" + k + ", " + v + "]";
}

// lower_map_base_kind2 reports whether `e` is a bare `map_new[_i32](n)` — the
// base a `Map { … }` literal's chain is desugared onto.
function expr_is_map_new_base(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1) { return false; }
            match (c.callee) {
                ast.ExprIdent(cid) => { return cid.name == "map_new" || cid.name == "map_new_i32"; },
                _ => { return false; }
            }
        },
        _ => {}
    }
    return false;
}

// lower_expr_map_base lowers a map-insert RECEIVER. It is ordinary lower_expr
// except for the chain base of a `Map { … }` literal, where it builds the box
// from the `Map[K, V]` in hand instead of from the constructor's NAME.
//
// `map_new` / `map_new_i32` are the only two spellings, and the parser picks
// between them without types: a struct / enum key has no spelling at all and a
// key set it cannot classify falls back to `map_new` — the STRING one either
// way. The generic constructor arm reads the kind off that callee name, so the
// BOX was built string-keyed and no per-insert kind could rescue it, the box
// carrying its own. The recovered / declared `Map[K, V]` is the same authority
// the annotated `var m: Map[K, V] = map_new(n)` binding already builds from.
// #7001 (composite keys), #7438 (i32 keys the parser could not classify).
function lower_expr_map_base(e: ast.Expr, mtype: string, s: LowerState): LowerState {
    if (!expr_is_map_new_base(e)) { return lower_expr(e, s); }
    var k: string = map_key_eqfn(mtype);
    var kind: i32 = map_key_kind_of(mtype);
    if (k != "") { kind = 2; }
    match (e) {
        ast.ExprCall(c) => {
            var b: LowerState = lower_expr(c.args[0], s);
            if (!b.ok) { return b; }
            if (kind != 2) { return b.emit(ir.op_map_new(kind, "")); }
            var kt: string = map_key_of(mtype);
            return b.emit(ir.op_map_new(2, kt + ".hash|" + kt + ".eq"));
        },
        _ => {}
    }
    return lower_expr(e, s);
}

pub function map_key_of(typestr: string): string {
    if (typestr.len() < 5 || slice_unchecked(typestr, 0, 4) != "Map[") { return ""; }
    var inner: str = slice_unchecked(typestr, 4, typestr.len() - 1);   // K, V
    var ci: i32 = 0;
    while (ci < inner.len() && inner[ci] != b',') { ci = ci + 1; }   // first comma
    return trim_spaces(slice_unchecked(inner, 0, ci));
}

// map_key_eqfn returns the derived equality symbol (`__fn_<K>__eq`) for a
// struct/enum map key, or "" for a scalar/string key. A struct/enum key
// is hashed/compared by VALUE through its `@derive(Eq)` method; the
// x86-64 linear-scan map runtime threads this symbol in (per call) and
// dispatches it for key comparison instead of pointer/string equality.
// "" keys (i32 / string) keep the existing scalar/string compare. #2671.
pub function map_key_eqfn(typestr: string): string {
    var k: string = map_key_of(typestr);
    if (k == "" || k == "i32" || k == "string") { return ""; }
    if (k == "i64" || k == "u32" || k == "u64") { return ""; }
    if (k == "u8" || k == "f32" || k == "f64" || k == "bool" || k == "boolean") { return ""; }
    // Bare receiver-method label `K.eq`; the backend builds the real
    // symbol as `__fn_<sanitize(K.eq)>` (= __fn_K__eq), matching the
    // const_func / receiver-method emission idiom.
    return k + ".eq";
}

// is_mapiter_type_name reports whether `t` is a "MapIter[K, V]" type string. The
// MapIter cluster (m.iter() + has_next/key/value/advance) is stored in the same
// per-slot local_map_type column as Map[K, V], but the two are prefix-disjoint
// ("MapIter[" vs "Map[") so a MapIter slot is invisible to is_map_type_name's
// map-method dispatch and vice-versa.
pub function is_mapiter_type_name(t: string): boolean {
    return t.len() >= 9 && slice_unchecked(t, 0, 8) == "MapIter[";
}

// mapiter_value_of / mapiter_key_kind_of recover V / K-kind from a
// "MapIter[K, V]" string by rewriting it to "Map[K, V]" (drop "Iter") and
// delegating to the Map[K, V] parsers.
pub function mapiter_value_of(t: string): string {
    if (!is_mapiter_type_name(t)) { return ""; }
    return map_value_of("Map[" + slice_unchecked(t, 8, t.len()));
}
pub function mapiter_key_kind_of(t: string): i32 {
    if (!is_mapiter_type_name(t)) { return 0; }
    return map_key_kind_of("Map[" + slice_unchecked(t, 8, t.len()));
}

// mapiter_key_of recovers the KEY type NAME (not its kind) the same way, so
// `it.key().field` over a struct-keyed map resolves — the key-side sibling of
// mapiter_value_of.
pub function mapiter_key_of(t: string): string {
    if (!is_mapiter_type_name(t)) { return ""; }
    return map_key_of("Map[" + slice_unchecked(t, 8, t.len()));
}

// mapiter_type_of_iter_call recovers the "MapIter[K, V]" type of an UNANNOTATED
// `var it = m.iter()` from the RECEIVER's map type, so the binding types the
// slot exactly as a `var it: MapIter[K, V] = …` annotation does. Without it the
// slot stayed untyped and every later it.has_next()/key()/value()/advance()
// missed the mapiter dispatch and bailed the module — for ANY value type, an
// `m.iter()` over a Map[i32, i32] included. Returns "" for anything that is not
// a zero-arg `.iter()` on an expression whose map type resolves.
pub function mapiter_type_of_iter_call(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return ""; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "iter") { return ""; }
                    var mt: string = expr_map_type_tag(fa.obj, s);
                    if (!is_map_type_name(mt) || is_array_type_name(mt)) { return ""; }
                    return "MapIter[" + slice_unchecked(mt, 4, mt.len());
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// trim_spaces drops leading/trailing ASCII spaces.
function trim_spaces(t: string): string {
    var a: i32 = 0;
    var b: i32 = t.len();
    while (a < b && t[a] == b' ') { a = a + 1; }
    while (b > a && t[b - 1] == b' ') { b = b - 1; }
    return slice_unchecked(t, a, b) + "";
}

pub function lower_module(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): ir.LoweredFn[] {
    // Derived ONCE for the whole module: every registry is a whole-program scan,
    // so deriving them per function is O(n^2) analysis — on the compiler's own
    // sources that cost +26% peak RSS and tipped the gen2 self-compile into the
    // arena ceiling (#6074).
    var sg: FnSigs = fn_sigs_of(funcs, structs, array_ret_fn_names(funcs));
    var out: ir.LoweredFn[] = [];
    for fn in funcs {
        var r: LowerResult = lower_func(fn, structs, sg, false);
        // A receiver method is registered under the receiver-qualified name
        // `<BaseType>.<method>` — the SAME label a method call lowers to
        // (op_call_direct(receiver_type + "." + field)) and the backends'
        // `__fn_<Type>.<method>` emission. Without this the round-trip
        // evaluator's find_fn looked up "P.getx" while the def was stored as
        // bare "getx", so a method call missed and bailed. (The asm backends
        // re-derive the label from the FuncDecl directly, so they're unaffected
        // by this stored name.)
        var fname: string = fn.name;
        if (fn.receiver_type.len() > 0) {
            fname = util.base_type_name(fn.receiver_type) + "." + fn.name;
        }
        out = out.append(ir.LoweredFn { name: fname, ok: r.ok, ops: r.ops, n_locals: r.n_locals, n_params: r.n_params, arr_slots: r.arr_slots, i64_slots: r.i64_slots, f64_slots: r.f64_slots, str_slots: r.str_slots, ret_type: fn.ret_type, alias_incs: r.alias_incs });
    }
    return out;
}

// --- Lambda lifting (closures slice 2a: no-capture lambdas as call arguments) ---
//
// lift_lambdas rewrites a module so that a no-capture lambda passed directly as
// a call argument is hoisted to a fresh top-level function (__lam_<k>) and the
// argument becomes a bare reference to it. That bare reference, at a "fn"-typed
// param position, is exactly the function VALUE that closures slice 1 lowers via
// const_func — so capture-free lambdas-as-callbacks ride the slice-1 machinery
// with no new IR ops. Capturing lambdas (and lambdas in positions this bounded
// walk doesn't reach) are left as ExprLambda, so the module bails. A module
// with no lifted lambda is returned UNCHANGED (so the
// lambda-free fixpoint is byte-identical).

pub struct LiftAcc { funcs: parser.FuncDecl[], counter: i32 }
struct LiftExpr { expr: ast.Expr, acc: LiftAcc }
struct LiftStmts { stmts: ast.Stmt[], acc: LiftAcc }

// gfn_index_of buckets `gfns` by name and returns (head, next) as plain index
// arrays rather than a SigReg. The distinction is load-bearing rather than
// stylistic: SigReg stores the rows in a field, so `sig_reg_of(gfns)` would
// leave the index and the caller's own `gfns` naming one array for the rest of
// the pass, and the wasm-hosted compiler miscompiles that — it emits a function
// name as the two bytes of a string header (#8210). Index arrays name nothing,
// and cost no copy of the rows either.
//
// Built backward so each chain ascends, which is the order the scan this
// replaces visited.
function gfn_index_of(gfns: string[]): (i32[], i32[]) {
    var nb: i32 = sig_bucket_count(gfns.len());
    var head: i32[] = [];
    var b: i32 = 0;
    while (b < nb) { head = head.append(0 - 1); b = b + 1; }
    var next: i32[] = [];
    var j: i32 = 0;
    while (j < gfns.len()) { next = next.append(0 - 1); j = j + 1; }
    var k: i32 = gfns.len() - 1;
    while (k >= 0) {
        var bk: i32 = sig_key_bucket(gfns[k], "", nb);
        next = next.with(k, head[bk]);
        head = head.with(bk, k);
        k = k - 1;
    }
    return (head, next);
}

// gfn_index_has: is `name` one of the rows the index was built over?
function gfn_index_has(gfns: string[], head: i32[], next: i32[], name: string): boolean {
    var i: i32 = head[sig_key_bucket(name, "", head.len())];
    while (i >= 0) {
        if (gfns[i] == name) { return true; }
        i = next[i];
    }
    return false;
}

// lambda_has_no_captures: every identifier the body uses must be one of the
// lambda's params, a local it binds, a global function, or a literal keyword —
// nothing from the enclosing scope. (A conservative check: a false "captures"
// only costs a fallback to AST, never correctness.)
// gfns_visible_in drops from the module-function list every name THIS function
// also binds — the receiver, a parameter, or any binder in its body.
//
// lambda_has_no_captures forgives a free ident that names a module function, on
// the reasoning that it is a call target rather than a capture. That holds only
// while the name still MEANS the module function. Where the enclosing function
// binds it too, the lambda is reading a local, and hoisting its body to a
// top-level `__lam_N` re-resolves the name against the module.
//
// This is the exclusion #6191 removed from `lambda_captures`, whose doc records
// why: "a name that is BOTH an enclosing local and a module function is
// shadowed, so it must be captured, and the gfns exclusion said the opposite."
// The sibling predicate kept it. Filtering the LIST once per function fixes
// every consumer without threading fd through the lift, and costs one walk of
// the body.
function gfns_visible_in(fd: parser.FuncDecl, gfns: string[], ghead: i32[], gnext: i32[]): string[] {
    var bound: string[] = [];
    if (fd.receiver_name.len() > 0) { bound = bound.append(fd.receiver_name); }
    var pi: i32 = 0;
    while (pi < fd.params.len()) { bound = bound.append(fd.params[pi].name); pi = pi + 1; }
    var b: i32 = 0;
    while (b < fd.body.len()) { bound = astwalk.collect_bound_stmt(fd.body[b], bound); b = b + 1; }
    if (bound.len() == 0) { return gfns; }
    // Ask the SHADOWING question the cheap way round: a frame binds a few dozen
    // names and the module has thousands of functions, so test each binder
    // against the module-fn set and return the list unchanged when none of them
    // shadows one — the overwhelmingly common case. Scanning the whole list
    // against every binder is the same answer at O(gfns x bound).
    var shadows: boolean = false;
    var bi: i32 = 0;
    while (bi < bound.len()) {
        if (gfn_index_has(gfns, ghead, gnext, bound[bi])) { shadows = true; bi = bound.len(); } else { bi = bi + 1; }
    }
    if (!shadows) { return gfns; }
    var out: string[] = [];
    var i: i32 = 0;
    while (i < gfns.len()) {
        if (util.index_of_str(bound, gfns[i]) < 0) { out = out.append(gfns[i]); }
        i = i + 1;
    }
    return out;
}

function lambda_has_no_captures(lam: ast.ExprLambda, gfns: string[]): boolean {
    var used: string[] = [];
    var si: i32 = 0;
    while (si < lam.body.len()) { used = astwalk.collect_idents_stmt(lam.body[si], used); si = si + 1; }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lam.params.len()) { bound = bound.append(lam.params[pi].name); pi = pi + 1; }
    var bi: i32 = 0;
    while (bi < lam.body.len()) { bound = astwalk.collect_bound_stmt(lam.body[bi], bound); bi = bi + 1; }
    var ui: i32 = 0;
    while (ui < used.len()) {
        var u: string = used[ui];
        if (util.index_of_str(bound, u) < 0 && util.index_of_str(gfns, u) < 0
                && u != "None" && u != "true" && u != "false") {
            return false;
        }
        ui = ui + 1;
    }
    return true;
}

// lift_call_arg lifts one call argument: a no-capture lambda becomes __lam_<k>
// and the argument a bare reference to it; any other argument recurses (so a
// lambda nested inside a call argument is still reached).
function lift_call_arg(e: ast.Expr, acc: LiftAcc, gfns: string[]): LiftExpr {
    match (e) {
        ast.ExprLambda(lam) => {
            if (lambda_has_no_captures(lam, gfns)) {
                var nm: string = "__lam_" + util.i32_to_string(acc.counter);
                var tp: string[] = [];
                var nf: parser.FuncDecl = parser.FuncDecl { name: nm, receiver_name: "", receiver_type: "", type_params: tp, params: lam.params, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" };
                var nacc: LiftAcc = LiftAcc { funcs: acc.funcs.append(nf), counter: acc.counter + 1 };
                return LiftExpr { expr: ast.ExprIdent { name: nm, line: 0, col: 0, ty: "" }, acc: nacc };
            }
            // Capturing: keep the lambda, but walk its body so nested lambdas
            // are still lifted.
            return lift_lambda_body_only(lam, acc, gfns);
        },
        _ => { return lift_expr_walk(e, acc, gfns); }
    }
    return LiftExpr { expr: e, acc: acc };
}

// lift_call_callee lifts a call's CALLEE, hoisting it as lift_call_arg does
// except for one shape: a value-position desugar's IIFE nested inside another
// IIFE's body. Hoisting that one splits a single desugar across the IR and AST
// paths, and the outer form then refuses. Its body is still walked, so a user
// lambda nested in the desugar is lifted either way.
function lift_call_callee(c: ast.ExprCall, acc: LiftAcc, gfns: string[]): LiftExpr {
    if (is_iife_callee(c) && lifting_inside_iife(gfns)) {
        match (c.callee) {
            ast.ExprLambda(lam) => { return lift_lambda_body_only(lam, acc, gfns); },
            _ => { return LiftExpr { expr: c.callee, acc: acc }; }
        }
    }
    return lift_call_arg(c.callee, acc, gfns);
}

// `$in_iife$` rides in `gfns` to carry "already inside a desugar's IIFE body"
// down the walk. `gfns` is only ever read as `index_of_str(gfns, <a used
// identifier>)` by lambda_has_no_captures, so a `$`-prefixed name cannot change
// that answer — the collision guarantee `$lamret$` and `$wc$` also rely on.
function lifting_inside_iife(gfns: string[]): boolean { return util.index_of_str(gfns, "$in_iife$") >= 0; }

function mark_inside_iife(gfns: string[]): string[] {
    if (lifting_inside_iife(gfns)) { return gfns; }
    return gfns.append("$in_iife$");
}

// lift_lambda_body_only walks a lambda's body for lifts and returns the lambda
// itself unchanged in shape — never hoisted to a top-level `__lam_N`.
function lift_lambda_body_only(lam: ast.ExprLambda, acc: LiftAcc, gfns0: string[]): LiftExpr {
    var gfns: string[] = mark_inside_iife(gfns0);
    var ba: LiftAcc = acc;
    var nb: ast.Stmt[] = [];
    var bi: i32 = 0;
    while (bi < lam.body.len()) {
        var br: LiftStmts = lift_stmt(lam.body[bi], ba, gfns);
        ba = br.acc;
        var bj: i32 = 0;
        while (bj < br.stmts.len()) { nb = nb.append(br.stmts[bj]); bj = bj + 1; }
        bi = bi + 1;
    }
    return LiftExpr { expr: ast.ExprLambda { ...lam, body: nb }, acc: ba };
}

// lift_expr_walk recurses through the expression forms that commonly hold calls,
// rewriting lambda arguments. Unhandled forms pass through unchanged.
function lift_expr_walk(e: ast.Expr, acc: LiftAcc, gfns: string[]): LiftExpr {
    match (e) {
        ast.ExprCall(c) => {
            var a: LiftAcc = acc;
            // Lift the CALLEE too: a no-capture lambda in call position — an IIFE
            // `(function(b){...})(args)` — hoists to a bare `__lam_N` fn-name, so
            // the call becomes a direct `__lam_N(args)`. lift_call_arg recurses for
            // a non-lambda callee (ident / `mk()` / etc.), leaving it unchanged, so
            // a normal call's numbering is untouched (an ident callee consumes no
            // counter). A capturing lambda callee is left in place (stays on AST).
            var ce: LiftExpr = lift_call_callee(c, a, gfns);
            a = ce.acc;
            var nargs: ast.Expr[] = [];
            for arg in c.args {
                var r: LiftExpr = lift_call_arg(arg, a, gfns);
                a = r.acc;
                nargs = nargs.append(r.expr);
            }
            return LiftExpr { expr: ast.ExprCall { callee: ce.expr, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty }, acc: a };
        },
        // A no-capture lambda in a TUPLE-element position (`(function(x){...}, 10)`)
        // hoists the same way — lift_call_arg turns it into a bare `__lam_N` fn-name
        // (which lowers to a fn pointer), so `t.0(t.1)` rides the existing
        // tuple-element fn-value call_indirect path. A capturing lambda element is
        // left in place (stays on AST).
        ast.ExprTuple(tu) => {
            var ta: LiftAcc = acc;
            var nte: ast.Expr[] = [];
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                var ter: LiftExpr = lift_call_arg(tu.elements[ti], ta, gfns);
                ta = ter.acc;
                nte = nte.append(ter.expr);
                ti = ti + 1;
            }
            return LiftExpr { expr: ast.ExprTuple { elements: nte, line: tu.line, col: tu.col }, acc: ta };
        },
        // An array literal of NO-CAPTURE lambdas (`var fs = [function(x){...}, ...]`):
        // hoist each lambda element to a top-level `__lam_N` (the same lift a
        // no-capture lambda ARGUMENT gets), so the array becomes one of bare
        // function-name idents -- which lower to a function-pointer array, and
        // `fs[i](args)` rides the existing fn-pointer-array call_indirect path.
        // A capturing lambda element is returned unchanged by lift_call_arg, so
        // the module bails.
        ast.ExprArray(arr) => {
            var aa: LiftAcc = acc;
            var nelems: ast.Expr[] = [];
            var ei: i32 = 0;
            while (ei < arr.elements.len()) {
                var er: LiftExpr = lift_call_arg(arr.elements[ei], aa, gfns);
                aa = er.acc;
                nelems = nelems.append(er.expr);
                ei = ei + 1;
            }
            return LiftExpr { expr: ast.ExprArray { ...arr, elements: nelems }, acc: aa };
        },
        // A no-capture lambda in a STRUCT-FIELD value position (`Box { f:
        // function(x){...} }`) hoists the same way — lift_call_arg turns it into
        // a bare `__lam_N` fn-name (which lowers to const_func, like `Box { f:
        // inc }`). A capturing lambda field is left in place (stays on AST).
        ast.ExprStructLit(sl) => {
            var sa: LiftAcc = acc;
            var nvals: ast.Expr[] = [];
            for fv in sl.field_values {
                var vr: LiftExpr = lift_call_arg(fv, sa, gfns);
                sa = vr.acc;
                nvals = nvals.append(vr.expr);
            }
            var nbase: ast.Expr = sl.base;
            if (sl.has_base) {
                var br: LiftExpr = lift_expr_walk(sl.base, sa, gfns);
                sa = br.acc;
                nbase = br.expr;
            }
            return LiftExpr { expr: ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nvals, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col }, acc: sa };
        },
        // Recurse into the compound expression forms so a no-capture lambda CALL
        // nested inside them is still hoisted: `(function(x){...})(5) + 1` (binary),
        // `0 - (function(){...})()` (unary), `a[(function(){...})()]` (index). The
        // operands rarely hold a BARE lambda (that wouldn't type-check), so these
        // recurse via lift_expr_walk (which lifts an IIFE callee / a lambda call
        // argument inside), not lift_call_arg. An operand with nothing to lift is
        // rebuilt identically (the counter is untouched), so existing programs are
        // unchanged.
        ast.ExprBinary(b) => {
            var blr: LiftExpr = lift_expr_walk(b.left, acc, gfns);
            var brr: LiftExpr = lift_expr_walk(b.right, blr.acc, gfns);
            return LiftExpr { expr: ast.ExprBinary { op: b.op, left: blr.expr, right: brr.expr, line: b.line, col: b.col, ty: b.ty }, acc: brr.acc };
        },
        ast.ExprUnary(u) => {
            var uor: LiftExpr = lift_expr_walk(u.operand, acc, gfns);
            return LiftExpr { expr: ast.ExprUnary { op: u.op, operand: uor.expr, line: u.line, col: u.col, ty: u.ty }, acc: uor.acc };
        },
        ast.ExprIndex(ix) => {
            var ixar: LiftExpr = lift_expr_walk(ix.array, acc, gfns);
            var ixir: LiftExpr = lift_expr_walk(ix.index, ixar.acc, gfns);
            return LiftExpr { expr: ast.ExprIndex { array: ixar.expr, index: ixir.expr, unchecked: ix.unchecked, ty: ix.ty }, acc: ixir.acc };
        },
        // Slice bounds + the field-access object can also hold a nested lambda CALL
        // (`a[(iife)(0) : 3]`, `arr[(iife)(0)].v`); recurse so it is hoisted too.
        ast.ExprSlice(sl) => {
            var slar: LiftExpr = lift_expr_walk(sl.array, acc, gfns);
            var slsr: LiftExpr = lift_expr_walk(sl.start, slar.acc, gfns);
            var sler: LiftExpr = lift_expr_walk(sl.end, slsr.acc, gfns);
            return LiftExpr { expr: ast.ExprSlice { array: slar.expr, start: slsr.expr, end: sler.expr, ty: sl.ty, open_end: sl.open_end }, acc: sler.acc };
        },
        ast.ExprFieldAccess(fa) => {
            var faor: LiftExpr = lift_expr_walk(fa.obj, acc, gfns);
            return LiftExpr { expr: ast.ExprFieldAccess { obj: faor.expr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, acc: faor.acc };
        },
        _ => { return LiftExpr { expr: e, acc: acc }; }
    }
    return LiftExpr { expr: e, acc: acc };
}

// desugar_lambda_returns rewrites every `return <lambda>` in `body` (capturing OR
// not, at any depth — inside if/while/for blocks and match arms) to a two-statement
// `var $lamret$N = <lambda>; return $lamret$N;`. Run as a per-function PRE-pass
// (before every closure/lift pass), so the returned lambda is treated exactly like a
// hand-written closure local: box_mutated_scalar_captures + lift_inline_closures give
// it a UNIQUE `<fd>$cloN` name and the env-first make_closure box, and the caller's
// `var g = f()` binds g a closure local (via body_binds_closure_local) so `g()`
// dispatches env-first. This replaces the old inline-return handling — no-capture
// returns hoisted to a bare `__lam_N` fn-value the caller called env-first (SIGSEGV),
// and capturing returns hoisted to a bare `<fd>$clo` that COLLIDED across multiple
// returns (the wrong closure body ran) or bailed the whole module (#5266). `$lamret$N` names are function-local slots (the `$` prefix can't collide
// with user idents); the counter is function-local. The self-host sources contain no
// bare lambda returns, so this fires on none of them and leaves the self-compile
// byte-identical.
struct DesugarRet { body: ast.Stmt[], counter: i32 }
function desugar_lambda_returns(body: ast.Stmt[], counter: i32): DesugarRet {
    var out: ast.Stmt[] = [];
    var c: i32 = counter;
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtReturn(r) => {
                var islam: boolean = false;
                match (r.value) { ast.ExprLambda(_) => { islam = true; }, _ => {} }
                if (islam) {
                    var rn: string = "$lamret$" + util.i32_to_string(c);
                    c = c + 1;
                    out = out.append(ast.StmtVar { name: rn, type_name: "", init: r.value, line: r.line, col: r.col, is_str: false, fn_ret: "", fn_param_types: "" });
                    out = out.append(ast.StmtReturn { value: ast.ExprIdent { name: rn, line: r.line, col: r.col, ty: "" }, line: r.line, col: r.col });
                } else {
                    out = out.append(body[i]);
                }
            },
            ast.StmtIf(f) => {
                var td: DesugarRet = desugar_lambda_returns(f.then_body, c); c = td.counter;
                var ed: DesugarRet = desugar_lambda_returns(f.else_body, c); c = ed.counter;
                out = out.append(ast.StmtIf { ...f, cond: f.cond, then_body: td.body, else_body: ed.body });
            },
            ast.StmtWhile(w) => {
                var wd: DesugarRet = desugar_lambda_returns(w.body, c); c = wd.counter;
                out = out.append(ast.StmtWhile { cond: w.cond, body: wd.body, label: w.label, line: 0, is_loop: w.is_loop });
            },
            ast.StmtFor(fo) => {
                var fod: DesugarRet = desugar_lambda_returns(fo.body, c); c = fod.counter;
                out = out.append(ast.StmtFor { var_name: fo.var_name, iter: fo.iter, body: fod.body, label: fo.label, line: 0 });
            },
            ast.StmtMatch(m) => {
                var narms: ast.MatchArm[] = [];
                for arm in m.arms {
                    var ad: DesugarRet = desugar_lambda_returns(arm.body, c); c = ad.counter;
                    narms = narms.append(ast.MatchArm { pattern: arm.pattern, body: ad.body, line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard, alt_cont: false });
                }
                out = out.append(ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: narms });
            },
            _ => { out = out.append(body[i]); }
        }
        i = i + 1;
    }
    return DesugarRet { body: out, counter: c };
}

// desugar_nontail_lambda_returns applies the same rewrite to every `return
// <lambda>` in `body` EXCEPT one that is the body's final top-level statement.
// That one is hoist_escaping_closure's, and handing it to the desugar instead is
// what regressed the `curry` shape (#5281); every other position has no hoist
// and asked for a `<fd>$clo` nothing built.
//
// It exists for a body ASSEMBLED during lifting, which the pre-worklist pass
// over the source functions cannot have seen — see unwrap_sole_iife_return, its
// only caller. Returns `body` unchanged when nothing is rewritten, so an
// unaffected function serializes byte-identically.
function desugar_nontail_lambda_returns(body: ast.Stmt[]): ast.Stmt[] {
    var n: i32 = body.len();
    if (n == 0) { return body; }
    var tail_is_lam_ret: boolean = false;
    match (body[n - 1]) {
        ast.StmtReturn(tr) => {
            match (tr.value) {
                ast.ExprLambda(_) => { tail_is_lam_ret = true; },
                _ => {}
            }
        },
        _ => {}
    }
    var upto: i32 = n;
    if (tail_is_lam_ret) { upto = n - 1; }
    var head: ast.Stmt[] = [];
    var i: i32 = 0;
    while (i < upto) { head = head.append(body[i]); i = i + 1; }
    var hd: DesugarRet = desugar_lambda_returns(head, 0);
    if (hd.counter == 0) { return body; }
    var nb: ast.Stmt[] = hd.body;
    if (tail_is_lam_ret) { nb = nb.append(body[n - 1]); }
    return nb;
}

// lift_stmt rewrites a single statement, recursing into nested bodies + the
// call-bearing expression positions (return / var-init / expr-stmt / control
// conditions). Other statements pass through.
//
// NOTE: each rebuilt statement is bound to a `var ns: ast.Stmt` before being
// placed in the returned `[ns]` array. Constructing the variant INLINE in the
// array literal (`stmts: [ast.StmtReturn { … }]`) used to read back corrupt:
// the checker did not propagate the Stmt-union element type into an array
// literal in a struct-field position, so the inline variant lowered WITHOUT its
// discriminant tag and the whole lifted module silently bailed IR eligibility to
// AST. That checker bug is now fixed (internal/checker StructLit field
// setElemHintFor; e2e TestInlineEnumVariantInStructArrayField); the typed `var`
// binding is retained as a robust, self-documenting way to express the move.
function lift_stmt(st: ast.Stmt, acc: LiftAcc, gfns: string[]): LiftStmts {
    match (st) {
        ast.StmtReturn(r) => {
            // `return function(x){...}` of a NO-CAPTURE lambda hoists to a
            // top-level `__lam_N` (via lift_call_arg, the same lift a no-capture
            // lambda argument / array element / struct-field value gets), so the
            // return becomes a bare fn-name -> const_func, riding the existing
            // "return a named function value" path. A capturing lambda is left in
            // place (so the module bails); a non-lambda value recurses
            // through lift_expr_walk unchanged. (Inline `return <lambda>` returns are
            // pre-desugared to a `var $lamret$N = <lambda>; return $lamret$N;` local
            // binding before this pass runs — see desugar_lambda_returns — so a bare
            // ExprLambda no longer reaches here in practice.)
            var e: LiftExpr = lift_call_arg(r.value, acc, gfns);
            var ns: ast.Stmt = ast.StmtReturn { value: e.expr, line: r.line, col: r.col };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        ast.StmtVar(v) => {
            var e: LiftExpr = lift_expr_walk(v.init, acc, gfns);
            var ns: ast.Stmt = ast.StmtVar { name: v.name, type_name: v.type_name, init: e.expr, line: v.line, col: v.col, is_str: v.is_str, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        ast.StmtExpr(s) => {
            var e: LiftExpr = lift_expr_walk(s.value, acc, gfns);
            var ns: ast.Stmt = ast.StmtExpr { value: e.expr, line: 0 };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        // `f = function(x){...}` of a NO-CAPTURE lambda hoists to `f = __lam_N`
        // (via lift_call_arg, like the StmtReturn case) — a bare fn-name the assign
        // lowers as a fn-pointer store. A capturing lambda RHS is left in place
        // (stays on AST); a non-lambda RHS recurses through lift_expr_walk.
        ast.StmtAssign(asg) => {
            var e: LiftExpr = lift_call_arg(asg.value, acc, gfns);
            var ns: ast.Stmt = ast.StmtAssign { target: asg.target, value: e.expr, line: asg.line, col: asg.col, target_line: asg.target_line, target_col: asg.target_col };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        ast.StmtIf(f) => {
            var ce: LiftExpr = lift_expr_walk(f.cond, acc, gfns);
            var tb: LiftStmts = lift_stmts(f.then_body, ce.acc, gfns);
            var eb: LiftStmts = lift_stmts(f.else_body, tb.acc, gfns);
            var ns: ast.Stmt = ast.StmtIf { cond: ce.expr, then_body: tb.stmts, else_body: eb.stmts, line: 0, else_chained: false, sugar: parser.no_match_sugar(), origin: "" };
            return LiftStmts { stmts: [ns], acc: eb.acc };
        },
        // A match's ARM BODIES need the same walk StmtIf's branches get. Without
        // it a `return <lambda>` inside an arm never reached lift_call_arg, so no
        // `__lam_N` was hoisted — and lower_expr's ExprLambda arm then asked for a
        // `<cur_fn>$clo` that hoist_escaping_closure never built (it only fires on
        // a body whose LAST statement is literally `return <ExprLambda>`, and a
        // match-EXPRESSION makes that `return <IIFE call>`). The module bailed off
        // the IR path (#6256).
        //
        // The if-expression sibling worked precisely because StmtIf was here, so
        // this is restoring symmetry rather than adding a rule.
        ast.StmtMatch(m) => {
            var se: LiftExpr = lift_expr_walk(m.scrutinee, acc, gfns);
            var ma: LiftAcc = se.acc;
            var narms: ast.MatchArm[] = [];
            for arm in m.arms {
                var ge: LiftExpr = lift_expr_walk(arm.guard, ma, gfns);
                var ab: LiftStmts = lift_stmts(arm.body, ge.acc, gfns);
                ma = ab.acc;
                narms = narms.append(ast.MatchArm { pattern: arm.pattern, body: ab.stmts, line: arm.line, col: arm.col, guard: ge.expr, has_guard: arm.has_guard, alt_cont: false });
            }
            var nm: ast.Stmt = ast.StmtMatch { ...m, scrutinee: se.expr, arms: narms };
            return LiftStmts { stmts: [nm], acc: ma };
        },
        ast.StmtWhile(w) => {
            var ce: LiftExpr = lift_expr_walk(w.cond, acc, gfns);
            var b: LiftStmts = lift_stmts(w.body, ce.acc, gfns);
            var ns: ast.Stmt = ast.StmtWhile { cond: ce.expr, body: b.stmts, label: w.label, line: w.line, is_loop: w.is_loop };
            return LiftStmts { stmts: [ns], acc: b.acc };
        },
        ast.StmtFor(fo) => {
            var ie: LiftExpr = lift_expr_walk(fo.iter, acc, gfns);
            var b: LiftStmts = lift_stmts(fo.body, ie.acc, gfns);
            var ns: ast.Stmt = ast.StmtFor { var_name: fo.var_name, iter: ie.expr, body: b.stmts, label: fo.label, line: fo.line };
            return LiftStmts { stmts: [ns], acc: b.acc };
        },
        _ => { return LiftStmts { stmts: [st], acc: acc }; }
    }
    return LiftStmts { stmts: [st], acc: acc };
}

function lift_stmts(stmts: ast.Stmt[], acc: LiftAcc, gfns: string[]): LiftStmts {
    var a: LiftAcc = acc;
    var out: ast.Stmt[] = [];
    for stmt in stmts {
        var r: LiftStmts = lift_stmt(stmt, a, gfns);
        a = r.acc;
        var j: i32 = 0;
        while (j < r.stmts.len()) { out = out.append(r.stmts[j]); j = j + 1; }
    }
    return LiftStmts { stmts: out, acc: a };
}

// --- Capturing lambdas via classic lambda-lifting (closures slice 2c) ---
//
// A capturing lambda bound to a local and used ONLY as a direct call —
// `var f = function(x){ … base … }; … f(a) … f(b) …` — needs no closure box:
// hoist it to __lam_<k>(origparams…, captures…) and rewrite each `f(args)` to
// `__lam_<k>(args…, captures…)`, threading the captured values as ordinary
// arguments. Pure AST rewrite: the lifted body is unchanged (its free vars are
// now same-named params), and the existing direct-call IR path lowers the
// result on every backend. Declines (leaving ExprLambda → AST) when a capture's
// type can't be resolved, a capture (or f) is reassigned, or f escapes as a
// value — first-class capturing closures (box + env) are a later slice.

// lambda_captures returns the lambda's free variables (its captures): every used
// identifier that is not a param, a local it binds, a global function, or a
// literal keyword. Deduped, first-seen order.
// closure_captures returns the lambda's captures during lowering: free
// identifiers (used minus params minus locally-bound) that resolve to a local
// SLOT in the enclosing function. First-seen order, deduped — matching
// hoist_escaping_closure's lambda_captures order so cap[i] lines up with the
// env box's slot 1+i.
function closure_captures(lam: ast.ExprLambda, s: LowerState): string[] {
    var used: string[] = [];
    var si: i32 = 0;
    while (si < lam.body.len()) { used = astwalk.collect_idents_stmt(lam.body[si], used); si = si + 1; }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lam.params.len()) { bound = bound.append(lam.params[pi].name); pi = pi + 1; }
    var bi: i32 = 0;
    while (bi < lam.body.len()) { bound = astwalk.collect_bound_stmt(lam.body[bi], bound); bi = bi + 1; }
    var caps: string[] = [];
    var ui: i32 = 0;
    while (ui < used.len()) {
        var u: string = used[ui];
        if (util.index_of_str(bound, u) < 0 && util.index_of_str(caps, u) < 0 && s.slot_of(u) >= 0) {
            caps = caps.append(u);
        }
        ui = ui + 1;
    }
    return caps;
}

function lambda_captures(lam: ast.ExprLambda, fd: parser.FuncDecl): string[] {
    var used: string[] = [];
    var si: i32 = 0;
    while (si < lam.body.len()) { used = astwalk.collect_idents_stmt(lam.body[si], used); si = si + 1; }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lam.params.len()) { bound = bound.append(lam.params[pi].name); pi = pi + 1; }
    var bi: i32 = 0;
    while (bi < lam.body.len()) { bound = astwalk.collect_bound_stmt(lam.body[bi], bound); bi = bi + 1; }
    // Only an ENCLOSING LOCAL can be a capture (fd's RECEIVER + params + every name
    // bound in fd.body). Without this, a free ident that is a USER enum constructor
    // or an I/O builtin (not in gfns) was wrongly captured, making make_clo_func
    // decline (not an i32 local). A global that is NOT shadowed is not an enclosing
    // local either, so it fails this test and is referenced directly in the hoisted
    // body — which is why membership in `gfns` is not consulted here. It used to be,
    // as an additional exclusion, and that is what left #6191's capture case broken:
    // a name that is BOTH an enclosing local and a module function is shadowed, so it
    // must be captured, and the gfns exclusion said the opposite. The lambda then
    // reported no captures at all, took the no-capture `$wrapN` lift, and resolved
    // the name against the module function table inside the trampoline — a silent
    // call to an unrelated top-level function of the same name.
    // The receiver is an enclosing local like any param: a method's lambda reading
    // `a.base` captures `a`. Omitting it made `caps` EMPTY for such a lambda, so the
    // no-capture lift hoisted the body to a `<fd>$wrapN` trampoline where the
    // receiver name is unbound — the module then bailed on the wrapper (#3457).
    var encl: string[] = [];
    if (fd.receiver_name.len() > 0) { encl = encl.append(fd.receiver_name); }
    var ep: i32 = 0;
    while (ep < fd.params.len()) { encl = encl.append(fd.params[ep].name); ep = ep + 1; }
    var eb: i32 = 0;
    while (eb < fd.body.len()) { encl = astwalk.collect_bound_stmt(fd.body[eb], encl); eb = eb + 1; }
    var caps: string[] = [];
    var ui: i32 = 0;
    while (ui < used.len()) {
        var u: string = used[ui];
        if (util.index_of_str(bound, u) < 0
                && util.index_of_str(encl, u) >= 0
                && u != "None" && u != "true" && u != "false"
                && u != "Some" && u != "Ok" && u != "Err"
                && util.index_of_str(caps, u) < 0) {
            caps = caps.append(u);
        }
        ui = ui + 1;
    }
    return caps;
}

// lit_init_type infers a capture's type from a literal-shaped initializer:
// scalar literals (i32 / string / boolean — float declines, matching the old
// scalar behaviour), array literals (element type from the first element, so
// `[1,2,3]` is `i32[]` and `["a"]` is `string[]`), and struct literals (their
// named type). "" when it can't infer — the caller then declines the lift, so
// the module bails. Pure AST analysis: the inferred type
// only labels the lifted function's capture PARAM, so an unannotated
// array/struct capture flows exactly like the already-supported annotated /
// param-typed array capture (passed by value as an ordinary argument — no env
// box, no RC). Keeps cap_type small (#2720 oversized-function guard).
function lit_init_type(e: ast.Expr): string {
    match (e) {
        ast.ExprNumber(num) => { if (num.is_float) { return ""; } return "i32"; },
        ast.ExprString(_) => { return "string"; },
        ast.ExprBool(_) => { return "boolean"; },
        ast.ExprArray(a) => {
            if (a.elements.len() == 0) { return ""; }
            var et: string = lit_init_type(a.elements[0]);
            if (et.len() == 0) { return ""; }
            return et + "[]";
        },
        ast.ExprStructLit(sl) => {
            if (sl.type_name.len() == 0) { return ""; }
            return sl.type_name;
        },
        _ => { return ""; }
    }
    return "";
}

// cap_type resolves a captured variable's type from the enclosing function: a
// param type, an annotated `var c: T`, or an initialised `var c = <expr>`
// whose type is statically inferable — a literal (lit_init_type), an IDENT
// chain resolving to one (`var k = i` where `var i = 0`), or i32 ARITHMETIC
// over such (`var k = i % 7`). The binding is found ANYWHERE in the body
// (while/for/if/match nesting included — a loop-body `var k = i` used to be
// invisible, so a tuple-lifted lambda capturing it DECLINED and the module
// bailed — #5051). "" when
// it can't infer (the caller then declines the lift). Mirrors
// ssa.resolve_capture_type.
// pat_variant_payload_field_s is the structs-taking sibling of
// iife_variant_payload_field (which takes a LowerState): the variant struct's
// payload FIELD TYPE for a binding name in a PatVariant arm — `__ev` for the
// main binding, `__ev<k+1>` for the k-th extra. Used by the lift-side
// cap_type walk (which carries `structs`, not a LowerState) so a lambda
// capturing a USER-ENUM match payload resolves its type and lifts instead of
// declining and bailing the module (#5155). "" when the name binds no
// payload of this variant.
function pat_variant_payload_field_s(pv: ast.PatVariant, name: string, structs: parser.StructDecl[]): string {
    var vname: string = pv.type_name;
    var vld: i32 = 0;
    while (vld < pv.type_name.len()) {
        if (pv.type_name[vld] == b'.') { vname = slice_unchecked(pv.type_name, vld + 1, pv.type_name.len()) + ""; }
        vld = vld + 1;
    }
    if (!decl_is_struct(structs, vname)) { return ""; }
    var pvb: string = pv.binding;
    if (pvb.len() > 0 && pvb != "_" && pvb == name) { return decl_field_type(structs, vname, "__ev"); }
    var k: i32 = 0;
    while (k < pv.extra_bindings.len()) {
        var eb: string = pv.extra_bindings[k];
        if (eb.len() > 0 && eb != "_" && eb == name) { return decl_field_type(structs, vname, "__ev" + util.i32_to_string(k + 1)); }
        k = k + 1;
    }
    return "";
}

// callee_ret_type resolves a call's declared return type from the module's
// function decls (threaded as `mfuncs`): `recv_ty` is the receiver's type
// spelling — its base struct name (generic args stripped) is matched against
// the decl's receiver_type — or "" for a free function. Used by the capture
// resolver to type a for-in iter / match scrutinee that is a method or
// function call (`for x in s.get()`, `match (pop(i)) { … }`): a call binder
// used to resolve "" and decline the closure lift (#5193 / #5200). Returns ""
// when no matching decl is found (a miss only declines the lift).
function callee_ret_type(mfuncs: MFuncs, recv_ty: string, fname: string): string {
    var base: string = recv_ty;
    var bi: i32 = 0;
    while (bi < recv_ty.len()) {
        if (recv_ty[bi] == b'[') { base = slice_unchecked(recv_ty, 0, bi) + ""; bi = recv_ty.len(); }
        bi = bi + 1;
    }
    var i: i32 = 0;
    while (i < mfuncs.decls.len()) {
        if (mfuncs.decls[i].name == fname) {
            if (recv_ty.len() == 0 && mfuncs.decls[i].receiver_type.len() == 0) { return mfuncs.decls[i].ret_type; }
            if (recv_ty.len() > 0 && mfuncs.decls[i].receiver_type == base) { return mfuncs.decls[i].ret_type; }
        }
        i = i + 1;
    }
    return "";
}

function cap_type(name: string, fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs): string {
    return cap_type_at(name, fd, 4, structs, mfuncs);
}

// cap_local_init returns the initialiser of the local `name` bound by a `var` in
// `body`, or an unknown expression when there is none. The sibling of
// cap_type_in_stmts' walk — that one answers "what type is it", this one answers
// "what was it bound FROM", which is the only place a fn-typed local's signature
// still survives (see cap_param_for).
function cap_local_init(body: ast.Stmt[], name: string): ast.Expr {
    function init_of(st: ast.Stmt, acc: ast.Expr): ast.Expr {
        match (acc) { ast.ExprUnknown(_) => {}, _ => { return acc; } }
        match (st) {
            ast.StmtVar(v) => { if (v.name == name) { return v.init; } },
            _ => {}
        }
        return acc;
    }
    var found: ast.Expr = parser.e_unknown("");
    for st in body {
        found = astwalk.fold_stmt_nodes(st, found, init_of, no_expr_expr, astwalk.descend_none);
        match (found) { ast.ExprUnknown(_) => {}, _ => { return found; } }
    }
    return found;
}

// The statement-shaped cap walks contribute nothing from an expression slot;
// paired with astwalk.descend_none the spine never enters one.
function no_expr_expr(e: ast.Expr, acc: ast.Expr): ast.Expr { return acc; }
function no_expr_str(e: ast.Expr, acc: string): string { return acc; }

// cap_local_fn_ret is the declared RETURN spelling of fn-typed local `name`'s
// binding (`var f: (i32) => i32` -> "i32"), or "". Same walk as cap_local_init,
// reading the annotation the parser kept on the StmtVar rather than the
// initialiser.
function cap_local_fn_ret(body: ast.Stmt[], name: string): string {
    function fn_ret_of(st: ast.Stmt, acc: string): string {
        if (acc.len() > 0) { return acc; }
        match (st) {
            ast.StmtVar(v) => { if (v.name == name) { return v.fn_ret; } },
            _ => {}
        }
        return acc;
    }
    var found: string = "";
    for st in body {
        found = astwalk.fold_stmt_nodes(st, found, fn_ret_of, no_expr_str, astwalk.descend_none);
        if (found.len() > 0) { return found; }
    }
    return "";
}

// passthrough_forwards_lambda / passthrough_lambda_param_types read the LAMBDA a
// generic passthrough call hands back unchanged (`pick(c, <lambda>, <lambda>)`,
// nested passthroughs included). The lambda carries its own annotated parameter
// types; what it does NOT carry is a return type, because only a binding whose
// init IS the lambda gets one stamped (stamp_lambda_ret). Paired with the
// binding's declared fn_ret that is a complete signature, and an exact one — no
// part of it is reconstructed from a body.
//
// The two are split rather than returning one value because a ZERO-parameter
// lambda's type list is legitimately empty, which a single return could not tell
// from "no lambda here".
function passthrough_forwards_lambda(e: ast.Expr, mfuncs: MFuncs): boolean {
    match (e) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
                                && passthrough_forwards_lambda(c.args[i], mfuncs)) { return true; }
                        i = i + 1;
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

function passthrough_lambda_param_types(e: ast.Expr, mfuncs: MFuncs): string[] {
    var out: string[] = [];
    match (e) {
        ast.ExprLambda(lam) => {
            var pi: i32 = 0;
            while (pi < lam.params.len()) { out = out.append(lam.params[pi].type_name); pi = pi + 1; }
            return out;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
                                && passthrough_forwards_lambda(c.args[i], mfuncs)) {
                            return passthrough_lambda_param_types(c.args[i], mfuncs);
                        }
                        i = i + 1;
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return out;
}

// cap_param_for builds the ParamDecl that carries capture `name` into a hoisted
// function, or declines by returning one with an empty type_name.
//
// The point of it is fn-TYPED captures (#6324). cap_type coarsens every fn type
// to the flat "fn" tag, which is enough for the env-box path (make_clo_func only
// needs to know the value is pointer-shaped) but NOT enough to synthesize a
// fn-typed PARAM: that additionally needs fn_ret, fn_param_types and
// fn_param_dyn, the sidecars parse_param records precisely because the flat tag
// throws the signature away. A param built without them is not the one the call
// side reads — hoist_value_iife used to decline every fn-typed capture for
// exactly this reason, which is what kept #6256's Repro D bailing.
//
// Four sources are exact enough to use, and nothing else is:
//
//   * a PARAM or receiver — copy fd.params[i] wholesale. Nothing is
//     reconstructed, so nothing can be reconstructed wrong.
//   * a LOCAL bound from a lambda literal — the lambda carries its own params
//     and ret_type (the parser stamps a binding's annotated return onto it via
//     stamp_lambda_ret), so the signature is recoverable without guessing.
//   * a LOCAL the lift has already replaced with a `__mkclo$<target>` env-box
//     constructor — the hoisted target carries the real signature after its
//     `__env` param.
//   * a LOCAL whose declared type_name is the full `(P) => R` spelling, which
//     fn_param_from_spelling reads back into the sidecars directly.
//
// A local bound from anything else (a call, another local) declines: StmtVar
// keeps only the coarse type_name, so the signature is genuinely gone and there
// is nothing to recover it from. Declining leaves the module bailing as it does
// today.
//
// Being exact matters more here than usual: wasm funcref types are STRUCTURAL
// (#6282), so a wrong fn_param_types does not degrade into a slow path — it
// produces a module the loader rejects, or an `indirect call type mismatch` at
// runtime. Copy where possible, reconstruct only from an unambiguous source,
// decline otherwise.
function cap_param_for(name: string, fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs): ast.ParamDecl {
    var declined: ast.ParamDecl = ast.ParamDecl { name: name, type_name: "", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" };
    var pi: i32 = 0;
    while (pi < fd.params.len()) {
        if (fd.params[pi].name == name) { return fd.params[pi]; }
        pi = pi + 1;
    }
    var cty: string = cap_type(name, fd, structs, mfuncs);
    if (cty.len() == 0) { return declined; }
    if (cty != "fn") {
        var spp: ast.ParamDecl = fn_param_from_spelling(name, cty);
        if (spp.type_name == "fn") { return spp; }
        return ast.ParamDecl { name: name, type_name: cty, own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" };
    }
    match (cap_local_init(fd.body, name)) {
        ast.ExprLambda(lam) => { return fn_param_from_lambda(name, lam); },
        // `__mkclo$<target>(caps…)` — the env-box constructor the lift leaves in
        // a fn-valued local's place. The hoisted target's params are `__env`
        // followed by the lambda's own, so its signature after that first param
        // is the fn value's.
        ast.ExprCall(mk) => {
            match (mk.callee) {
                ast.ExprIdent(mkid) => {
                    if (mkid.name.len() > 8 && slice_unchecked(mkid.name, 0, 8) == "__mkclo$") {
                        var tgt: string = slice_unchecked(mkid.name, 8, mkid.name.len()) + "";
                        var fi: i32 = 0;
                        while (fi < mfuncs.decls.len()) {
                            if (mfuncs.decls[fi].name == tgt) { return fn_param_from_func(name, mfuncs.decls[fi], 1); }
                            fi = fi + 1;
                        }
                        return declined;
                    }
                    // A generic passthrough hands one of its erased-generic
                    // arguments straight back, so the lambda at that parameter
                    // IS this binding's value. Its own annotated params plus the
                    // return the binding declares make the signature exact.
                    var dret: string = cap_local_fn_ret(fd.body, name);
                    if (dret.len() > 0 && passthrough_forwards_lambda(mk, mfuncs)) {
                        return fn_param_decl(name, passthrough_lambda_param_types(mk, mfuncs), dret);
                    }
                    return declined;
                },
                _ => { return declined; }
            }
            return declined;
        },
        _ => { return declined; }
    }
    return declined;
}

function cap_type_at(name: string, fd: parser.FuncDecl, depth: i32, structs: parser.StructDecl[], mfuncs: MFuncs): string {
    // The receiver binds like a param (see lambda_captures), so resolve it first.
    if (fd.receiver_name.len() > 0 && fd.receiver_name == name) { return fd.receiver_type; }
    var pi: i32 = 0;
    while (pi < fd.params.len()) {
        if (fd.params[pi].name == name) { return fd.params[pi].type_name; }
        pi = pi + 1;
    }
    return cap_type_in_stmts(fd.body, name, fd, depth, structs, mfuncs);
}

// tuple_tag_i32_only reports whether a tuple tag `(t0, t1, …)` (as produced by
// tuple_elem_tags) is composed ENTIRELY of i32 elements, recursively. It gates
// the nested tuple-destructure capture lift (#5201) to the shape whose element
// reads lower correctly: an i32 destructure element captures via the 32-bit env
// slot with the right value, so a nested `var (p, c) = t; var (a, b) = p` over
// an all-i32 tuple lifts soundly. A POINTER (string / struct / array) element of
// a destructure binding is a SEPARATE pre-existing capture-materialisation gap
// (a captured string from a destructure comes through empty on the IR path,
// with or without nesting), so enabling its lift would turn a correct AST
// fallback into a wrong IR build — those stay declined here.
function tuple_tag_i32_only(t: string): boolean {
    if (t.len() < 2 || t[0] != b'(') { return false; }
    var elems: string[] = rc_fe_split_csv(tuple_elem_tags(t));
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        var e: string = elems[i];
        if (e == "i32") {}
        else if (e.len() >= 2 && e[0] == b'(' && tuple_tag_i32_only(e)) {}
        else { return false; }
        i = i + 1;
    }
    return true;
}

// cap_type_in_stmts finds the binding of `name` anywhere in `body` — a `var`
// (annotation or inferable init), a `for` binder, a match-arm pattern — and
// resolves its type; astwalk's statement spine carries the recursion, with
// descend_none keeping it out of expressions and lambda bodies. First match
// wins — shadowing across sibling blocks is an accepted over-approximation,
// same as the other lift-side body walkers (the fn-gates keep consequences to
// a declined or extra lift, never a miscompile: the lifted capture param only
// labels the hoisted function's parameter).
// map_kv_type returns the KEY or VALUE type of a `Map[K, V]` type string, or ""
// when the type is not a Map. The split is on the top-level comma, so a nested
// `Map[i32, Pair[i32, i32]]` keeps its own brackets.
function map_kv_type(mty: string, want_key: boolean): string {
    if (mty.len() <= 5 || slice_unchecked(mty, 0, 4) != "Map[") { return ""; }
    var inner: string = slice_unchecked(mty, 4, mty.len() - 1) + "";
    var depth: i32 = 0;
    var i: i32 = 0;
    var pos: i32 = 0 - 1;
    while (i < inner.len()) {
        if (inner[i] == b'[') { depth = depth + 1; }
        if (inner[i] == b']') { depth = depth - 1; }
        if (inner[i] == b',' && depth == 0 && pos < 0) { pos = i; }
        i = i + 1;
    }
    if (pos <= 0) { return ""; }
    if (want_key) { return slice_unchecked(inner, 0, pos) + ""; }
    var vstart: i32 = pos + 1;
    while (vstart < inner.len() && inner[vstart] == b' ') { vstart = vstart + 1; }
    return slice_unchecked(inner, vstart, inner.len()) + "";
}

function cap_type_in_stmts(body: ast.Stmt[], name: string, fd: parser.FuncDecl, depth: i32, structs: parser.StructDecl[], mfuncs: MFuncs): string {
    function cap_type_of(st: ast.Stmt, acc: string): string {
        if (acc.len() > 0) { return acc; }
        match (st) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (v.type_name.len() > 0) { return v.type_name; }
                    var vt: string = cap_type_expr(v.init, fd, depth, structs, mfuncs);
                    if (vt.len() > 0) { return vt; }
                    // The binding IS the answer even when un-inferable: stop
                    // the scan here ("!" maps to "" at the driver). Walking on
                    // would reach a later `match (name)` whose scrutinee
                    // resolution re-enters cap_type_at on this same body —
                    // unbounded mutual recursion.
                    return "!";
                }
                // A tuple-destructure `var (a, b) = t` binds `name` as the
                // element at its position: resolve the tuple type (annotation
                // or inferred from the init) and read the element tag at that
                // index (#5173). Without this a lambda capturing a destructure
                // binding resolved "" and declined to the miscompiling AST
                // path. Scalar/string element tags are returned, AND an all-i32
                // nested-tuple element tag `(…)` (tuple_tag_i32_only) — that tag
                // is what a SECOND-level destructure `var (a, b) = p` indexes
                // `p`'s element into, and cap_slot_ok admits the tuple itself as
                // a pointer riding the 32-bit env slot, so the nested-destructure
                // capture lifts instead of declining (#5201). A pointer-element
                // tuple stays declined: a captured string from a destructure is a
                // separate pre-existing IR gap.
                if (rc_fe_is_destructure(v.name)) {
                    var dnames: string[] = rc_fe_split_csv(v.name);
                    var didx: i32 = util.index_of_str(dnames, name);
                    if (didx >= 0) {
                        var tty: string = v.type_name;
                        if (tty.len() == 0) { tty = cap_type_expr(v.init, fd, depth, structs, mfuncs); }
                        if (tty.len() >= 2 && tty[0] == b'(') {
                            var etags: string[] = rc_fe_split_csv(tuple_elem_tags(tty));
                            if (didx < etags.len()) {
                                var et: string = etags[didx];
                                if (et == "i32" || et == "string" || et == "boolean" || et == "i64" || et == "u64" || et == "f64" || et == "u32") { return et; }
                                if (et.len() >= 2 && et[0] == b'(' && tuple_tag_i32_only(et)) { return et; }
                            }
                        }
                    }
                }
            },
            ast.StmtFor(fr) => {
                // The for-in BINDER: resolve its type from the iterated
                // expression's element type — an ident iterating a declared
                // `T[]` local/param binds a T (strip the "[]"), and a range
                // (`for x in 0..n`, any non-array iter of scalar shape) binds
                // an i32. Without this a lambda capturing a for-in binder
                // resolved "" → cap_slot_ok declined → the whole module
                // bailed (and the AST emitter it then fell to miscompiled a
                // capturing lambda in a struct fn FIELD — the f5/f4 probes).
                // A capture only labels the hoisted fn's param, so a miss
                // stays a declined lift, never a miscompile.
                // `for (k, v) in m` binds two names, encoded comma-joined, so
                // the single-binder test below never matches either of them and
                // a lambda capturing one resolved "" — the whole module bailed.
                // The pair is a Map's key and value type.
                if (rc_fe_is_destructure(fr.var_name)) {
                    var kvn: string[] = rc_fe_split_csv(fr.var_name);
                    var kvi: i32 = util.index_of_str(kvn, name);
                    if (kvi >= 0) {
                        match (fr.iter) {
                            ast.ExprIdent(kvid) => {
                                var kvt: string = map_kv_type(cap_type_at(kvid.name, fd, depth, structs, mfuncs), kvi == 0);
                                if (kvt.len() > 0) { return kvt; }
                            },
                            _ => {}
                        }
                    }
                }
                if (fr.var_name == name) {
                    var ity: string = "";
                    match (fr.iter) {
                        ast.ExprIdent(itid) => { ity = cap_type_at(itid.name, fd, depth, structs, mfuncs); },
                        ast.ExprFieldAccess(itfld) => {
                            // `for x in s.items` — the iter is a struct FIELD of
                            // array type `T[]`; resolve the field's declared type
                            // (the `[]`-strip below yields the binder T). #5173
                            // follow-up: previously only a bare-ident iter
                            // resolved, so a captured field-array binder declined.
                            match (itfld.obj) {
                                ast.ExprIdent(itsid) => {
                                    var sty: string = cap_type_at(itsid.name, fd, depth, structs, mfuncs);
                                    if (sty.len() > 0) { ity = decl_field_type(structs, sty, itfld.field); }
                                },
                                _ => {}
                            }
                        },
                        ast.ExprSlice(itsl) => {
                            // `for x in xs[0:2]` — the slice's element type is the
                            // sliced array's element type (an ident array here).
                            match (itsl.array) {
                                ast.ExprIdent(itaid) => { ity = cap_type_at(itaid.name, fd, depth, structs, mfuncs); },
                                _ => {}
                            }
                        },
                        ast.ExprCall(itc) => {
                            // `for k in m.keys()` / `for v in m.values()`: the
                            // binder is the receiver Map's key resp. value type.
                            match (itc.callee) {
                                ast.ExprFieldAccess(itfa) => {
                                    if ((itfa.field == "keys" || itfa.field == "values") && itc.args.len() == 0) {
                                        match (itfa.obj) {
                                            ast.ExprIdent(itmid) => {
                                                ity = map_kv_type(cap_type_at(itmid.name, fd, depth, structs, mfuncs), itfa.field == "keys");
                                            },
                                            _ => {}
                                        }
                                    } else {
                                        // `for x in s.get()`: a user-defined method
                                        // returning an array — resolve the method's
                                        // declared return type from `mfuncs` (matched
                                        // on the receiver struct's name), the `[]`-
                                        // strip below yielding the binder (#5193).
                                        match (itfa.obj) {
                                            ast.ExprIdent(itrid) => {
                                                var rty: string = cap_type_at(itrid.name, fd, depth, structs, mfuncs);
                                                if (rty.len() > 0) { ity = callee_ret_type(mfuncs, rty, itfa.field); }
                                            },
                                            _ => {}
                                        }
                                    }
                                },
                                ast.ExprIdent(itfid) => {
                                    // `for x in items()`: a free function returning
                                    // an array — resolve its declared return type
                                    // from `mfuncs` (#5193).
                                    ity = callee_ret_type(mfuncs, "", itfid.name);
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    if (ity == "i32" || ity == "string" || ity == "boolean" || ity == "i64" || ity == "u64" || ity == "f64" || ity == "u32") {
                        return ity;
                    }
                    if (ity.len() > 2 && slice_unchecked(ity, ity.len() - 2, ity.len()) == "[]") {
                        return slice_unchecked(ity, 0, ity.len() - 2) + "";
                    }
                    match (fr.iter) {
                        ast.ExprBinary(itb) => {
                            // `for x in a..b` — the range desugar's iter is a
                            // `..` binary; the binder is an i32.
                            if (itb.op == "..") { return "i32"; }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtMatch(m) => {
                // A match-arm PAYLOAD BINDING (`match (o) { Some(v) => … }`):
                // `v` is not a `var`, so the body walk below never resolves its
                // type — a lambda capturing it declined the lift and the module
                // fell out of the IR subset, onto an AST emitter that miscompiled
                // a fn-field-captured lambda (the m1 probe: native 20,
                // self-host 4). Resolve
                // the MAIN binding of an Option/Result arm from the scrutinee's
                // type spelling (opt_payload_type — no enum decls needed here).
                // A USER-ENUM variant's payload resolves via the enum
                // declaration threaded as `structs` (#5155): the variant
                // struct's `__ev` / `__ev<k>` field type
                // (pat_variant_payload_field_s), covering the main AND extra
                // bindings (`Tag(a, b)`). Option/Result payloads (single-
                // binding, non-struct payload types) still resolve from the
                // scrutinee spelling via opt_payload_type.
                var scrut_ty: string = "";
                match (m.scrutinee) {
                    ast.ExprIdent(scid) => { scrut_ty = cap_type_at(scid.name, fd, depth, structs, mfuncs); },
                    ast.ExprCall(scc) => {
                        // `match (pop(i)) { Some(v) => … }`: the scrutinee is a
                        // call whose Option/Result return type feeds the payload
                        // binding — resolve the callee's declared return type from
                        // `mfuncs` (free function or receiver method) so the arm
                        // binding types below (#5200).
                        match (scc.callee) {
                            ast.ExprIdent(scfid) => { scrut_ty = callee_ret_type(mfuncs, "", scfid.name); },
                            ast.ExprFieldAccess(scfa) => {
                                match (scfa.obj) {
                                    ast.ExprIdent(scrid) => {
                                        var srty: string = cap_type_at(scrid.name, fd, depth, structs, mfuncs);
                                        if (srty.len() > 0) { scrut_ty = callee_ret_type(mfuncs, srty, scfa.field); }
                                    },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
                // typed-IR (#5986): a scrutinee shape the hand-rolled walk above
                // cannot resolve — a field read (`s.o`), a builtin method call —
                // answers from the node's own stamped tag.
                if (scrut_ty.len() == 0) { scrut_ty = stamped_expr_ty(m.scrutinee); }
                for arm in m.arms {
                    match (arm.pattern) {
                        ast.PatVariant(pv) => {
                            // The `@` WHOLE-VALUE binding (`n @ Tag(x)`) binds
                            // the scrutinee itself, so its type is the
                            // scrutinee's. It reaches lowering on the pattern
                            // rather than as a `var` — lower_stmt_match only
                            // materialises `var n = $mscrut` later — so nothing
                            // below this resolves it, and a lambda capturing it
                            // declined the lift.
                            if (pv.at_binding.len() > 0 && pv.at_binding == name && scrut_ty.len() > 0) { return scrut_ty; }
                            // User-enum variant payload (main or extra binding).
                            var evt: string = pat_variant_payload_field_s(pv, name, structs);
                            if (evt.len() > 0) { return evt; }
                            // Option/Result single-payload fall-through.
                            if (scrut_ty.len() >= 8 && (slice_unchecked(scrut_ty, 0, 7) == "Option[" || slice_unchecked(scrut_ty, 0, 7) == "Result[")
                                && pv.binding.len() > 0 && pv.binding != "_" && pv.binding == name) {
                                var pt: string = opt_payload_type(scrut_ty, pv.type_name);
                                if (pt.len() > 0) { return pt; }
                            }
                        },
                        _ => {}
                    }
                }
            },
            _ => { }
        }
        return acc;
    }
    var found: string = "";
    for st in body {
        found = astwalk.fold_stmt_nodes(st, found, cap_type_of, no_expr_str, astwalk.descend_none);
        if (found.len() > 0) {
            if (found == "!") { return ""; }
            return found;
        }
    }
    return "";
}

// stamped_expr_ty reads the checker-stamped `ty` off any carrier node type,
// "" for an unstamped build or a node with no carrier (#5986).
function stamped_expr_ty(e: ast.Expr): string {
    match (e) {
        ast.ExprIdent(id) => { return id.ty; },
        ast.ExprCall(c) => { return c.ty; },
        ast.ExprFieldAccess(fa) => { return fa.ty; },
        ast.ExprIndex(ix) => { return ix.ty; },
        ast.ExprBinary(b) => { return b.ty; },
        ast.ExprUnary(u) => { return u.ty; },
        _ => { return ""; }
    }
    return "";
}

// cap_type_expr infers an initializer expression's type for capture-param
// labelling: literals via lit_init_type; a bare ident by resolving ITS binding
// (depth-bounded so a cycle terminates as ""); comparisons/logic → boolean;
// arithmetic/bitwise where BOTH sides infer i32 → i32; `+` over two strings →
// string (concat — a string capture rides the env box's pointer slot like any
// other pointer-shaped type, so declining it only bailed the module). Every other
// operator still requires both sides i32.
function cap_type_expr(e: ast.Expr, fd: parser.FuncDecl, depth: i32, structs: parser.StructDecl[], mfuncs: MFuncs): string {
    var lt: string = lit_init_type(e);
    if (lt.len() > 0) { return lt; }
    if (depth <= 0) { return ""; }
    match (e) {
        ast.ExprIdent(id) => {
            var ct: string = cap_type_at(id.name, fd, depth - 1, structs, mfuncs);
            if (ct.len() > 0) { return ct; }
            // typed-IR (#5986): a name no receiver/param/body decl binds — a
            // module const — answers from the stamp, which names its DECLARED type.
            return id.ty;
        },
        ast.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||") { return "boolean"; }
            var l: string = cap_type_expr(b.left, fd, depth - 1, structs, mfuncs);
            var r: string = cap_type_expr(b.right, fd, depth - 1, structs, mfuncs);
            if (l == "i32" && r == "i32") { return "i32"; }
            if (b.op == "+" && l == "string" && r == "string") { return "string"; }
            // typed-IR (#5986): wide arithmetic (i64/u64/u32/f64) the two
            // clauses above discard answers from the stamp — int_result types
            // the binary from the settled operand, so the tag is width-correct.
            return b.ty;
        },
        // `var b = s.field` — the object's struct type resolves through the same
        // recursion, then the field's DECLARED type. cap_type_in_stmts already did
        // exactly this for a for-in iter (`for x in s.items`) and a match scrutinee;
        // the plain `var` init arm simply never did, so a lambda capturing such a
        // local resolved "" and the lift declined (#3457).
        ast.ExprFieldAccess(fa) => {
            var oty: string = cap_type_expr(fa.obj, fd, depth - 1, structs, mfuncs);
            if (oty.len() > 0) {
                var ft: string = decl_field_type(structs, oty, fa.field);
                if (ft.len() > 0) { return ft; }
            }
            // typed-IR (#5986): the checker-stamped tag when this depth-bounded
            // walk cannot recover obj's type — either it ran out of depth or obj
            // is a form with no arm here. That "" is what made the lift DECLINE,
            // the exact failure #5982 patched one missing arm at a time. The walk
            // still wins when it resolves: it returns the field's declared
            // SPELLING, which distinguishes f32 from f64 where the checker's
            // TypeFloat does not.
            return fa.ty;
        },
        // A local bound from a lambda literal is a fn value. The flat "fn" tag is
        // what the env-box path wants: cap_slot_ok only asks whether the capture
        // is pointer-shaped, and make_clo_func's `var cap: fn = __env[i]` read is
        // the spelling lower_stmt_var recognises as a closure box.
        ast.ExprLambda(_) => { return "fn"; },
        // `var b = f(…)` / `var b = s.m(…)` — the callee's DECLARED return type,
        // resolved exactly as the for-in / match-scrutinee arms do (callee_ret_type).
        ast.ExprCall(c) => {
            match (c.callee) {
                // `__mkclo$…(caps…)` — the lift's env-box constructor, which is
                // what a fn-valued local's lambda init has already become by the
                // time a sibling closure's capture is typed.
                ast.ExprIdent(cid) => {
                    if (cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") { return "fn"; }
                    var crt: string = callee_ret_type(mfuncs, "", cid.name);
                    if (crt.len() > 0) { return crt; }
                    // typed-IR (#5986): a BUILTIN call (`args()`, `map_new(…)`)
                    // declares nothing in mfuncs; the stamp carries its result.
                    return c.ty;
                },
                ast.ExprFieldAccess(cfa) => {
                    var rty: string = cap_type_expr(cfa.obj, fd, depth - 1, structs, mfuncs);
                    if (rty.len() > 0) {
                        var mrt: string = callee_ret_type(mfuncs, rty, cfa.field);
                        if (mrt.len() > 0) { return mrt; }
                    }
                    // A builtin METHOD call (`s.len()`, `m.get_or(…)`) — same (#5986).
                    return c.ty;
                },
                _ => { return c.ty; }
            }
            return "";
        },
        // `var b = xs[i]` — the element type of the indexed array (`T[]` → T).
        // A non-array (map / string index) resolves "" and still declines
        // unless the checker's stamped element tag answers (#5986).
        ast.ExprIndex(ix) => {
            var aty: string = cap_type_expr(ix.array, fd, depth - 1, structs, mfuncs);
            if (aty.len() > 2 && slice_unchecked(aty, aty.len() - 2, aty.len()) == "[]") { return slice_unchecked(aty, 0, aty.len() - 2) + ""; }
            return ix.ty;
        },
        _ => { return ""; }
    }
    return "";
}

// body_assign_targets collects the names reassigned (`x = …`) anywhere in a body
// (recursing control flow + match arms). Used to decline lifting when a capture
// — or the closure local — is mutated, so the lifted call-time argument always
// equals the capture's value at the lambda's definition.
function body_assign_targets(stmts: ast.Stmt[]): string[] {
    return assign_targets_into([], stmts);
}

// assign_targets_into threads ONE accumulator through astwalk's statement
// spine. It is a hot path: this runs at the head of consumed_scalar_enum_frees /
// consumed_rcpayload_option_frees / consumed_rcpayload_enum_frees, which
// lower_block runs on every nested block (#6911) — assign_target_into captures
// nothing, so the fold allocates nothing per call.
function assign_targets_into(out: string[], stmts: ast.Stmt[]): string[] {
    for stmt in stmts {
        out = astwalk.fold_stmt_nodes(stmt, out, assign_target_into, no_expr_strs, astwalk.descend_none);
    }
    return out;
}

function assign_target_into(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtAssign(a) => { return acc.append(a.target); },
        _ => { return acc; }
    }
    return acc;
}

function no_expr_strs(e: ast.Expr, acc: string[]): string[] { return acc; }

function append_all(dst: string[], src: string[]): string[] {
    var i: i32 = 0;
    while (i < src.len()) { dst = dst.append(src[i]); i = i + 1; }
    return dst;
}

// subst_fcall_expr rewrites every direct call `fname(args)` to
// `lname(args, capargs…)`, recursing through the call-bearing expression forms.
// Calls only — a bare `fname` used as a value is left in place and caught by the
// caller's post-rewrite check.
function subst_fcall_expr(e: ast.Expr, fname: string, lname: string, capargs: ast.Expr[]): ast.Expr {
    match (e) {
        ast.ExprCall(c) => {
            var nargs: ast.Expr[] = [];
            for arg in c.args { nargs = nargs.append(subst_fcall_expr(arg, fname, lname, capargs)); }
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == fname) {
                        var ca: i32 = 0;
                        while (ca < capargs.len()) { nargs = nargs.append(capargs[ca]); ca = ca + 1; }
                        var lc: ast.Expr = ast.ExprIdent { name: lname, line: 0, col: 0, ty: "" };
                        return ast.ExprCall { callee: lc, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
                    }
                },
                _ => { }
            }
            var rc: ast.Expr = subst_fcall_expr(c.callee, fname, lname, capargs);
            return ast.ExprCall { callee: rc, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
        },
        ast.ExprBinary(b) => {
            return ast.ExprBinary { op: b.op, left: subst_fcall_expr(b.left, fname, lname, capargs), right: subst_fcall_expr(b.right, fname, lname, capargs), line: b.line, col: b.col, ty: b.ty };
        },
        ast.ExprUnary(u) => {
            return ast.ExprUnary { op: u.op, operand: subst_fcall_expr(u.operand, fname, lname, capargs), line: u.line, col: u.col, ty: u.ty };
        },
        ast.ExprIndex(ix) => {
            return ast.ExprIndex { array: subst_fcall_expr(ix.array, fname, lname, capargs), index: subst_fcall_expr(ix.index, fname, lname, capargs), unchecked: ix.unchecked, ty: ix.ty };
        },
        // The aggregate literals. A call reached only through one of these was
        // left un-substituted, so the binding's name survived the caller's
        // post-rewrite check, the lift declined, and the lambda fell to the
        // escaping-closure path — which names a `<fn>$clo` nothing hoisted.
        ast.ExprArray(arr) => {
            var ael: ast.Expr[] = [];
            var ai: i32 = 0;
            while (ai < arr.elements.len()) { ael = ael.append(subst_fcall_expr(arr.elements[ai], fname, lname, capargs)); ai = ai + 1; }
            return ast.ExprArray { ...arr, elements: ael };
        },
        ast.ExprTuple(tu) => {
            var tel: ast.Expr[] = [];
            var ti: i32 = 0;
            while (ti < tu.elements.len()) { tel = tel.append(subst_fcall_expr(tu.elements[ti], fname, lname, capargs)); ti = ti + 1; }
            return ast.ExprTuple { elements: tel, line: tu.line, col: tu.col };
        },
        ast.ExprStructLit(sl) => {
            var fvals: ast.Expr[] = [];
            for fv in sl.field_values { fvals = fvals.append(subst_fcall_expr(fv, fname, lname, capargs)); }
            var nbase: ast.Expr = sl.base;
            if (sl.has_base) { nbase = subst_fcall_expr(sl.base, fname, lname, capargs); }
            return ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: fvals, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col };
        },
        ast.ExprFieldAccess(fa) => {
            return ast.ExprFieldAccess { obj: subst_fcall_expr(fa.obj, fname, lname, capargs), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
        },
        ast.ExprLambda(lm) => {
            // Rewrite a hoisted lambda's call sites that appear INSIDE another
            // lambda body (`twice = fn(a){ return add(add(a)); }` → `add`
            // resolves to its hoisted `__lam_0`, with any capture args injected).
            // The injected capture args name the FIRST lambda's captures, which
            // live in the shared enclosing scope — so the nested lambda naturally
            // captures them too when it is itself lifted. This lets a closure
            // that calls another local closure lift through the IR path instead
            // of bailing to AST, INCLUDING a capturing inner closure (the
            // injected caps flow through as the nested lambda's own caps).
            // Declined when `fname` or any injected capture name is shadowed by a
            // binding (param or local `var`) of the nested lambda: the rewrite
            // would then bind the wrong value, so the module bails instead.
            var bound: string[] = [];
            var bpi: i32 = 0;
            while (bpi < lm.params.len()) { bound = bound.append(lm.params[bpi].name); bpi = bpi + 1; }
            var bbi: i32 = 0;
            while (bbi < lm.body.len()) { bound = astwalk.collect_bound_stmt(lm.body[bbi], bound); bbi = bbi + 1; }
            if (util.index_of_str(bound, fname) >= 0) { return e; }
            var ck: i32 = 0;
            while (ck < capargs.len()) {
                match (capargs[ck]) {
                    ast.ExprIdent(cid) => { if (util.index_of_str(bound, cid.name) >= 0) { return e; } },
                    _ => { }
                }
                ck = ck + 1;
            }
            return ast.ExprLambda { ...lm, body: subst_fcall_stmts(lm.body, fname, lname, capargs) };
        },
        _ => { return e; }
    }
    return e;
}

function subst_fcall_stmts(stmts: ast.Stmt[], fname: string, lname: string, capargs: ast.Expr[]): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { var ns: ast.Stmt = ast.StmtReturn { value: subst_fcall_expr(r.value, fname, lname, capargs), line: r.line, col: r.col }; out = out.append(ns); },
            ast.StmtVar(v) => { var ns: ast.Stmt = ast.StmtVar { name: v.name, type_name: v.type_name, init: subst_fcall_expr(v.init, fname, lname, capargs), line: v.line, col: v.col, is_str: v.is_str, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }; out = out.append(ns); },
            ast.StmtExpr(s) => { var ns: ast.Stmt = ast.StmtExpr { value: subst_fcall_expr(s.value, fname, lname, capargs), line: s.line }; out = out.append(ns); },
            ast.StmtAssign(a) => { var ns: ast.Stmt = ast.StmtAssign { target: a.target, value: subst_fcall_expr(a.value, fname, lname, capargs), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }; out = out.append(ns); },
            ast.StmtIf(f) => { var ns: ast.Stmt = ast.StmtIf { ...f, cond: subst_fcall_expr(f.cond, fname, lname, capargs), then_body: subst_fcall_stmts(f.then_body, fname, lname, capargs), else_body: subst_fcall_stmts(f.else_body, fname, lname, capargs) }; out = out.append(ns); },
            ast.StmtWhile(w) => { var ns: ast.Stmt = ast.StmtWhile { cond: subst_fcall_expr(w.cond, fname, lname, capargs), body: subst_fcall_stmts(w.body, fname, lname, capargs), label: w.label, line: w.line, is_loop: w.is_loop }; out = out.append(ns); },
            ast.StmtFor(fr) => { var ns: ast.Stmt = ast.StmtFor { var_name: fr.var_name, iter: subst_fcall_expr(fr.iter, fname, lname, capargs), body: subst_fcall_stmts(fr.body, fname, lname, capargs), label: fr.label, line: fr.line }; out = out.append(ns); },
            // A `match` whose scrutinee / arm bodies / guards call `f`: rewrite
            // each to the hoisted `__lam_N(…)`. Without this arm the match passed
            // through untouched, so an `f()` inside `match (f())` stayed a
            // reference to the binding — the caller's leftover-fname guard then
            // declined the lift and the capture-free lambda fell to the inline
            // escaping-closure path (`const_func(<fn>$clo)`), bailing the module
            // to AST (#3457 slice 3).
            ast.StmtMatch(mm) => {
                var narms: ast.MatchArm[] = [];
                var q: i32 = 0;
                while (q < mm.arms.len()) {
                    // NB: bind `marm`, not `a` — reusing the StmtAssign arm's
                    // local name `a` (a different struct type) makes the native
                    // IR field resolver mis-key `a.target` to MatchArm and abort
                    // codegen ("MatchArm has no field target"). A distinct name
                    // sidesteps that latent collision.
                    var marm: ast.MatchArm = mm.arms[q];
                    var ng: ast.Expr = marm.guard;
                    if (marm.has_guard) { ng = subst_fcall_expr(marm.guard, fname, lname, capargs); }
                    narms = narms.append(ast.MatchArm { ...marm, body: subst_fcall_stmts(marm.body, fname, lname, capargs), guard: ng });
                    q = q + 1;
                }
                var ns: ast.Stmt = ast.StmtMatch { ...mm, scrutinee: subst_fcall_expr(mm.scrutinee, fname, lname, capargs), arms: narms };
                out = out.append(ns);
            },
            _ => { out = out.append(stmt); }
        }
    }
    return out;
}

struct ClosureLift { body: ast.Stmt[], acc: LiftAcc, changed: boolean }

// try_lift_binding attempts to lift the capturing lambda bound at body[idx] to
// fname. Returns changed=true with the rewritten body + appended lifted fn when
// every guard holds, else the inputs unchanged.
function try_lift_binding(body: ast.Stmt[], idx: i32, fname: string, lam: ast.ExprLambda, fd: parser.FuncDecl, acc: LiftAcc, gfns: string[], assigns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): ClosureLift {
    var caps: string[] = lambda_captures(lam, fd);
    // A capture-FREE lambda binding (`var f = function(x){…}; f(a)`) is lifted
    // the same way, with no capture args — `f(a)` becomes a direct call to the
    // hoisted `__lam_N(a)`. (Previously declined here, so it fell through to the
    // first-class-closure lowering, which emits const_func(<fn>$clo) with no
    // such hoisted body and bailed the module.) The
    // fname-not-used-as-a-value guard below still applies, so a lambda that
    // escapes (passed/returned/reassigned) declines and keeps the box path.
    if (util.index_of_str(assigns, fname) >= 0) { return ClosureLift { body: body, acc: acc, changed: false }; }
    // The name must denote ONE binding in this body (#7253). subst_fcall_expr
    // rewrites every `fname(…)` callee it walks past, and it recurses into
    // nested if / while / for / match bodies with no notion of scope — so a
    // nested `var fname = <another lambda>` has its OWN calls rewritten to THIS
    // lambda's hoisted body. Witnessed: two sibling `g`s, the inner one called
    // once, and all three call sites emitted `call __fn___lam_0` while
    // `__fn___lam_1` was emitted and never reached; the answer moved by exactly
    // the difference between the two lambdas. Renaming the inner binding, and
    // nothing else, made it correct.
    //
    // Declining is the fix rather than a scope-aware walk: the substitution's
    // precondition is that the name resolves the same way everywhere it looks,
    // and when it does not, both bindings lower as ordinary closures with their
    // own slots — which is correct, just not lifted.
    if (local_decl_count(body, fname) != 1) { return ClosureLift { body: body, acc: acc, changed: false }; }
    var ctypes: string[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) {
        var t: string = cap_type(caps[ci], fd, structs, mfuncs);
        // A capture REASSIGNED in the enclosing body does NOT decline the lift:
        // the param-lift passes each capture at the CALL SITE, so every call
        // reads the binding's current value — exactly the interpreter's
        // by-reference capture semantics (#5301 pointer captures, #5300
        // outer-mutated scalars; the old decline sent these shapes to the AST
        // emitter, which snapshots at make time and diverges from the oracle).
        // Closure-side writes never reach here un-shared: a written scalar
        // capture is already a boxed cell (box_mutated_scalar_captures runs
        // first), and a written pointer capture is checker-rejected (E049).
        if (t.len() == 0) { return ClosureLift { body: body, acc: acc, changed: false }; }
        ctypes = ctypes.append(t);
        ci = ci + 1;
    }
    var lparams: ast.ParamDecl[] = [];
    var pj: i32 = 0;
    while (pj < lam.params.len()) { lparams = lparams.append(lam.params[pj]); pj = pj + 1; }
    var cj: i32 = 0;
    while (cj < caps.len()) {
        // A capture whose type is spelled out as a fn (`var f: (i32) => i32`, or
        // a capture read make_clo_func typed) becomes the flat "fn" tag plus the
        // sidecars a fn-typed PARAM carries: lower_func marks a "fn" param a
        // closure local, and the spelling on its own does not, so the call
        // inside the lifted body would dispatch the env box as a raw table
        // index.
        var lcp: ast.ParamDecl = fn_param_from_spelling(caps[cj], ctypes[cj]);
        if (lcp.type_name != "fn") { lcp = ast.ParamDecl { name: caps[cj], type_name: ctypes[cj], own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" }; }
        lparams = lparams.append(lcp);
        cj = cj + 1;
    }
    var lname: string = "__lam_" + util.i32_to_string(acc.counter);
    var notp: string[] = [];
    var newfn: parser.FuncDecl = parser.FuncDecl { name: lname, receiver_name: "", receiver_type: "", type_params: notp, params: lparams, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" };
    var capargs: ast.Expr[] = [];
    var ca: i32 = 0;
    while (ca < caps.len()) { capargs = capargs.append(ast.ExprIdent { name: caps[ca], line: 0, col: 0, ty: "" }); ca = ca + 1; }
    var rest: ast.Stmt[] = [];
    var ri: i32 = idx + 1;
    while (ri < body.len()) { rest = rest.append(body[ri]); ri = ri + 1; }
    var subst_rest: ast.Stmt[] = subst_fcall_stmts(rest, fname, lname, capargs);
    var newbody: ast.Stmt[] = [];
    var ki: i32 = 0;
    while (ki < idx) { newbody = newbody.append(body[ki]); ki = ki + 1; }
    var sj: i32 = 0;
    while (sj < subst_rest.len()) { newbody = newbody.append(subst_rest[sj]); sj = sj + 1; }
    var allids: string[] = [];
    var aj: i32 = 0;
    while (aj < newbody.len()) { allids = astwalk.collect_idents_stmt(newbody[aj], allids); aj = aj + 1; }
    if (util.index_of_str(allids, fname) >= 0) { return ClosureLift { body: body, acc: acc, changed: false }; }
    var nacc: LiftAcc = LiftAcc { funcs: acc.funcs.append(newfn), counter: acc.counter + 1 };
    return ClosureLift { body: newbody, acc: nacc, changed: true };
}

// cl_replace_at returns `body` with the statement at `at` replaced by `ns`.
// Used by closure_lift_one to splice a rewritten control-flow statement (whose
// nested body had a lambda lifted) back into its enclosing body.
function cl_replace_at(body: ast.Stmt[], at: i32, ns: ast.Stmt): ast.Stmt[] {
    var nb: ast.Stmt[] = [];
    var k: i32 = 0;
    while (k < body.len()) {
        if (k == at) { nb = nb.append(ns); } else { nb = nb.append(body[k]); }
        k = k + 1;
    }
    return nb;
}

// closure_lift_one lifts the FIRST liftable capturing-lambda binding in body,
// recursing into nested loop / if / match bodies. The caller loops until no
// change. A `var f = <capturing lambda>` that is only CALLED (not escaping)
// is param-lifted to a hoisted `__lam_N` + direct call sites — whether it sits
// at the top level OR inside a `while` / `for` / `if` / `match` body. Before
// the nested recursion only top-level bindings lifted, so a loop-local
// capturing closure (`while (…) { var f = function(n){ return n + base; }; …
// f(i) … }`) was never lifted, taking the whole module off the IR path (the
// loop-local capturing-closure IR gap).
function closure_lift_one(body: ast.Stmt[], fd: parser.FuncDecl, acc: LiftAcc, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): ClosureLift {
    var assigns: string[] = body_assign_targets(body);
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprLambda(lam) => {
                        // Both capturing and capture-free lambda bindings lift to
                        // a hoisted top-level function + direct call sites (the
                        // capture-free case carries no capture args). try_lift_
                        // binding declines (keeping the closure-box path) if
                        // the binding escapes — used as a value, returned, or
                        // reassigned — rather than only called.
                        var lifted: ClosureLift = try_lift_binding(body, i, v.name, lam, fd, acc, gfns, assigns, structs, mfuncs);
                        if (lifted.changed) { return lifted; }
                    },
                    _ => { }
                }
            },
            ast.StmtWhile(w) => {
                // A lambda binding lives in the loop body, not `body`: recurse.
                // Captures resolve against the whole `fd`, so a capture declared
                // outside the loop (`base` / `c.base`) types fine; the escape
                // check runs on the loop-local scope (the binding isn't visible
                // outside it).
                var sw: ClosureLift = closure_lift_one(w.body, fd, acc, gfns, structs, mfuncs);
                if (sw.changed) {
                    return ClosureLift { body: cl_replace_at(body, i, ast.StmtWhile { cond: w.cond, body: sw.body, label: w.label, line: 0, is_loop: w.is_loop }), acc: sw.acc, changed: true };
                }
            },
            ast.StmtFor(fr) => {
                var sf: ClosureLift = closure_lift_one(fr.body, fd, acc, gfns, structs, mfuncs);
                if (sf.changed) {
                    return ClosureLift { body: cl_replace_at(body, i, ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: sf.body, label: fr.label, line: 0 }), acc: sf.acc, changed: true };
                }
            },
            ast.StmtIf(f) => {
                var st: ClosureLift = closure_lift_one(f.then_body, fd, acc, gfns, structs, mfuncs);
                if (st.changed) {
                    return ClosureLift { body: cl_replace_at(body, i, ast.StmtIf { ...f, cond: f.cond, then_body: st.body, else_body: f.else_body }), acc: st.acc, changed: true };
                }
                var se: ClosureLift = closure_lift_one(f.else_body, fd, acc, gfns, structs, mfuncs);
                if (se.changed) {
                    return ClosureLift { body: cl_replace_at(body, i, ast.StmtIf { ...f, cond: f.cond, then_body: f.then_body, else_body: se.body }), acc: se.acc, changed: true };
                }
            },
            ast.StmtMatch(mm) => {
                var ami: i32 = 0;
                while (ami < mm.arms.len()) {
                    var sm: ClosureLift = closure_lift_one(mm.arms[ami].body, fd, acc, gfns, structs, mfuncs);
                    if (sm.changed) {
                        var narms: ast.MatchArm[] = [];
                        var q: i32 = 0;
                        while (q < mm.arms.len()) {
                            if (q == ami) { narms = narms.append(ast.MatchArm { pattern: mm.arms[q].pattern, body: sm.body, line: mm.arms[q].line, col: mm.arms[q].col, guard: mm.arms[q].guard, has_guard: mm.arms[q].has_guard, alt_cont: false }); }
                            else { narms = narms.append(mm.arms[q]); }
                            q = q + 1;
                        }
                        return ClosureLift { body: cl_replace_at(body, i, ast.StmtMatch { ...mm, scrutinee: mm.scrutinee, arms: narms }), acc: sm.acc, changed: true };
                    }
                    ami = ami + 1;
                }
            },
            _ => { }
        }
        i = i + 1;
    }
    return ClosureLift { body: body, acc: acc, changed: false };
}

struct HoistResult { func: parser.FuncDecl, ok: boolean }

// cap_slot_ok reports whether a capture of type `t` fits the env box's single
// (32-bit-op / 8-byte) slot. In the self-host's `-no-pie -static` binary every
// heap / code address fits in 32 bits, so a pointer-shaped capture (string,
// array, struct, enum, Option/Result, tuple, map — and a fn value) rides the
// same 32-bit slot as an i32, exactly like a `string[]` element (which also uses
// the 32-bit arr_get path). Only an 8-byte SCALAR (i64 / u64 / f64) needs a wide
// slot the box doesn't carry, so those (and an unresolved "") still decline.
function cap_slot_ok(t: string): boolean {
    if (t.len() == 0) { return false; }
    if (t == "i64") { return false; }
    if (t == "u64") { return false; }
    if (t == "f64") { return false; }
    return true;
}

// make_clo_func builds the hoisted body of an escaping/inline closure: a top-
// level `<cloname>(__env: i32[], origparams…)` whose body reads each capture
// from the env box (`var cap_i: <T> = __env[1+i]`; box slot 0 is the funcval,
// caps follow) and then runs the lambda body. Each capture must fit the box's
// 32-bit slot (cap_slot_ok: i32 or any pointer-shaped type — string, array,
// struct, enum, …; an 8-byte scalar declines); otherwise it returns ok:false so
// the closure stays an ExprLambda and the module bails. The capture var
// is declared with its REAL type so downstream uses (e.g. a captured string's
// `.len()`) dispatch correctly even though the box is typed i32[] (the 32-bit
// load yields the pointer, which fits). Shared by the return-position
// (`hoist_escaping_closure`) and the array-element / struct-field inline lifts
// (`lift_inline_closures`) so the two agree byte-for-byte on the box layout.
//
// A fn-VALUE capture is read back under its full `(P) => R` spelling rather than
// the flat "fn" tag, which carries no signature: a wasm funcref type is
// structural, so the call inside the hoisted body needs the widths to pick its
// type and to push its arguments (#6862). A fn capture whose signature
// cap_param_for cannot recover declines, leaving the module on its honest bail.
function make_clo_func(lam: ast.ExprLambda, cloname: string, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): HoistResult {
    var none: parser.FuncDecl = fd;
    var caps: string[] = lambda_captures(lam, fd);
    if (caps.len() == 0) { return HoistResult { func: none, ok: false }; }
    var ctys: string[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) {
        var cty: string = cap_type(caps[ci], fd, structs, mfuncs);
        if (!cap_slot_ok(cty)) { return HoistResult { func: none, ok: false }; }
        if (cty == "fn") {
            var cfp: ast.ParamDecl = cap_param_for(caps[ci], fd, structs, mfuncs);
            if (cfp.type_name != "fn") { return HoistResult { func: none, ok: false }; }
            cty = fn_spelling_of(cfp);
        }
        ctys = ctys.append(cty);
        ci = ci + 1;
    }
    // params = __env first, then the lambda's declared params.
    var ps: ast.ParamDecl[] = [ast.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" }];
    var pj: i32 = 0;
    while (pj < lam.params.len()) { ps = ps.append(lam.params[pj]); pj = pj + 1; }
    // body = capture reads (var cap: <T> = __env[1+i]) then the lambda body. The
    // read is typed by the capture's real type (cap_type) so a pointer-shaped
    // capture is a typed slot downstream; the i32[] 32-bit load still yields the
    // (32-bit-fitting) pointer value.
    var bd: ast.Stmt[] = [];
    var cj: i32 = 0;
    while (cj < caps.len()) {
        var idx: ast.Expr = ast.ExprIndex { array: ast.ExprIdent { name: "__env", line: 0, col: 0, ty: "" }, index: ast.ExprNumber { text: util.i32_to_string(1 + cj), suffix: "", raw: "", is_float: false, line: 0, col: 0 }, unchecked: false, ty: "" };
        bd = bd.append(ast.StmtVar { name: caps[cj], type_name: ctys[cj], init: idx, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" });
        cj = cj + 1;
    }
    var bk: i32 = 0;
    while (bk < lam.body.len()) { bd = bd.append(lam.body[bk]); bk = bk + 1; }
    var notp: string[] = [];
    var clo: parser.FuncDecl = parser.FuncDecl { name: cloname, receiver_name: "", receiver_type: "", type_params: notp, params: ps, ret_type: lam.ret_type, body: bd, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" };
    return HoistResult { func: clo, ok: true };
}

// clo_owner_name is the name a function's hoisted closures / wrappers / iife
// temps are keyed under: receiver-qualified (`OrdSet__i32.filter`), the same
// spelling lower_module registers the method by, so two methods sharing a bare
// name (`OrdSet.filter` / `PSet.filter`) never mint the same `$clo0` symbol.
function clo_owner_name(fd: parser.FuncDecl): string {
    if (fd.receiver_type.len() > 0) { return util.base_type_name(fd.receiver_type) + "." + fd.name; }
    return fd.name;
}

// hoist_escaping_closure handles a function whose body ends in
// `return <capturing lambda>` — a first-class closure (slice 3a). It hoists the
// lambda body to `<fd>$clo(__env: i32[], origparams…)` via make_clo_func (each
// i32 capture read from the env box). The lambda STAYS at the return site —
// irlower lowers it to a make_closure box (const_func(<fd>$clo) + caps → i32[]).
function hoist_escaping_closure(fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): HoistResult {
    var none: parser.FuncDecl = fd;
    if (fd.body.len() == 0) { return HoistResult { func: none, ok: false }; }
    match (fd.body[fd.body.len() - 1]) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprLambda(lam) => {
                    return make_clo_func(lam, clo_owner_name(fd) + "$clo", fd, gfns, structs, mfuncs);
                },
                _ => { return HoistResult { func: none, ok: false }; }
            }
        },
        _ => { return HoistResult { func: none, ok: false }; }
    }
    return HoistResult { func: none, ok: false };
}

// ---- inline capturing closures in aggregate position (#2994) -----------
//
// A CAPTURING inline lambda in an array-element (`[function(x){ x+n }]`) or a
// struct-field value (`Box { f: function(x){ x+n } }`) is a first-class closure
// that does NOT come from a `return <lambda>` or a `mk()` call, so neither the
// param-lift (call-only bindings) nor hoist_escaping_closure (return position)
// reaches it — it stayed an ExprLambda and bailed the module to AST. This pass
// hoists each such lambda to a UNIQUELY-named `<fd>$cloN` (so a function may host
// several distinct inline closures) via make_clo_func, and replaces the inline
// lambda with a `__mkclo$<fd>$cloN(caps…)` marker that lower_expr turns into the
// env box [funcval, caps…] — the same box the call side already unpacks for
// closure arrays / struct "fn" fields. Captures must all be i32 (make_clo_func
// declines otherwise), in which case the lambda is left in place (module bails to
// AST — correctness preserved). The marker's capture args are bare idents in
// lambda_captures order, matching make_clo_func's env-box slot order (cap[i] →
// box slot 1+i). The counter persists across all aggregate positions in fd so
// every hoisted closure gets a distinct name.

struct InlineCloRes { expr: ast.Expr, funcs: parser.FuncDecl[], counter: i32 }

// InlineCloAcc is the lift's accumulator on astwalk's rewrite spine: the
// functions hoisted so far and the counter that names the next one. Counter
// order is name order, so the spine's child-order contract is what keeps the
// hoisted `$cloN` / `$wrapN` / `$iifeN` names — and the fixpoint's
// byte-identity — stable.
struct InlineCloAcc { funcs: parser.FuncDecl[], counter: i32 }

// try_inline_closure attempts to hoist one capturing inline lambda `lam` found in
// aggregate position. On success returns the `__mkclo$<name>(caps…)` marker plus
// the hoisted function appended; on decline returns the lambda unchanged.
function try_inline_closure(lam: ast.ExprLambda, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): InlineCloRes {
    var caps: string[] = lambda_captures(lam, fd);
    if (caps.len() == 0) { return InlineCloRes { expr: ast.ExprLambda { ...lam, body: lam.body }, funcs: funcs, counter: counter }; }
    var cloname: string = clo_owner_name(fd) + "$clo" + util.i32_to_string(counter);
    var hr: HoistResult = make_clo_func(lam, cloname, fd, gfns, structs, mfuncs);
    if (!hr.ok) { return InlineCloRes { expr: ast.ExprLambda { ...lam, body: lam.body }, funcs: funcs, counter: counter }; }
    var capargs: ast.Expr[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) { capargs = capargs.append(ast.ExprIdent { name: caps[ci], line: 0, col: 0, ty: "" }); ci = ci + 1; }
    var marker: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + cloname, line: 0, col: 0, ty: "" }, args: capargs, line: 0, col: 0, type_argc: 0, ty: "" };
    return InlineCloRes { expr: marker, funcs: funcs.append(hr.func), counter: counter + 1 };
}

// ---- uniform env-box fn-typed STRUCT FIELDS (slice #3445 / #3435 follow-up) --
//
// A fn-typed struct field (`struct Box { f: (i32) => i32 }`) must store a value
// the field-call path can invoke UNIFORMLY. The capturing inline lambda case
// needs an env box `[funcval, caps…]` whose funcval (`<fd>$cloN`) takes an
// `__env` first param; but a no-capture lambda / bare fn-name field stores a
// plain fn pointer that takes NO `__env`. To make `h.f(args)` dispatch the SAME
// way for every fn-field, EVERY fn-typed field value is wrapped into an env box:
//   * capturing inline lambda  → `__mkclo$<fd>$cloN(caps…)` (try_inline_closure)
//     → box [const_func(<fd>$cloN), caps…], the $cloN reads caps from __env.
//   * no-capture lambda / bare  → a `<fd>$wrapN(__env: i32[], origparams…)`
//     fn-name field                TRAMPOLINE that ignores __env and runs the
//                                  real work, wrapped as `__mkclo$<fd>$wrapN()`
//                                  → box [const_func(<fd>$wrapN)] (slot 0 only).
// The call side (`decl_field_type(...) == "fn"`) then always pushes the box as
// __env, the args, then box[0], and call_indirect(arity+1). Captures must be
// i32 (make_clo_func declines otherwise); a fn-name whose FuncDecl isn't found,
// or any other field-value shape, declines (ok:false) so the field stays as-is
// and the module bails (correctness preserved).

// make_wrap_lambda_func builds the env-taking trampoline for a NO-CAPTURE inline
// lambda field value: `<wrapname>(__env: i32[], origparams…) { <lambda body> }`
// (the lambda body inlined verbatim; __env is unused). Always succeeds — a
// no-capture lambda needs no env reads.
function make_wrap_lambda_func(lam: ast.ExprLambda, wrapname: string): parser.FuncDecl {
    var ps: ast.ParamDecl[] = [ast.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" }];
    var pj: i32 = 0;
    while (pj < lam.params.len()) { ps = ps.append(lam.params[pj]); pj = pj + 1; }
    var notp: string[] = [];
    return parser.FuncDecl { name: wrapname, receiver_name: "", receiver_type: "", type_params: notp, params: ps, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" };
}

// make_wrap_named_func builds the env-taking trampoline for a BARE FN-NAME field
// value (`Box { f: dbl }`): `<wrapname>(__env: i32[], p0, p1…) { return dbl(p0,
// p1…); }`, reusing the target function's parameter list / return type (looked
// up by name in `mfuncs`). Declines (ok:false) if no receiver-less function of
// that name is found — the field then stays as-is and the module bails.
function make_wrap_named_func(fnname: string, wrapname: string, mfuncs: MFuncs): HoistResult {
    var none: parser.FuncDecl = parser.FuncDecl { name: "", receiver_name: "", receiver_type: "", type_params: [], params: [], ret_type: "", body: [], line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" };
    var fi: i32 = 0;
    while (fi < mfuncs.decls.len()) {
        if (mfuncs.decls[fi].name == fnname && mfuncs.decls[fi].receiver_type.len() == 0) {
            var tgt: parser.FuncDecl = mfuncs.decls[fi];
            var ps: ast.ParamDecl[] = [ast.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" }];
            var args: ast.Expr[] = [];
            var pj: i32 = 0;
            while (pj < tgt.params.len()) {
                ps = ps.append(tgt.params[pj]);
                args = args.append(ast.ExprIdent { name: tgt.params[pj].name, line: 0, col: 0, ty: "" });
                pj = pj + 1;
            }
            var call: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: fnname, line: 0, col: 0, ty: "" }, args: args, line: 0, col: 0, type_argc: 0, ty: "" };
            var bd: ast.Stmt[] = [ast.StmtReturn { value: call, line: 0, col: 0 }];
            var notp: string[] = [];
            return HoistResult { func: parser.FuncDecl { name: wrapname, receiver_name: "", receiver_type: "", type_params: notp, params: ps, ret_type: tgt.ret_type, body: bd, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" }, ok: true };
        }
        fi = fi + 1;
    }
    return HoistResult { func: none, ok: false };
}

// BoxedArrayRes is box_array_lit_elems's result: the rewritten literal plus the
// hoisted functions and the counter the rewrite consumed.
struct BoxedArrayRes { expr: ast.Expr, funcs: parser.FuncDecl[], counter: i32 }

// box_array_lit_elems routes every element of an array literal through
// try_fn_field_value, so the whole literal carries env boxes: a capturing lambda
// becomes a `__mkclo$<fd>$cloN` box, a no-capture lambda or bare fn name a
// `$wrapN` trampoline box, and an already-boxed element flows through. The same
// uniform-box loop box_iife_arm_array_elems runs over an IIFE arm's literal.
function box_array_lit_elems(e: ast.Expr, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): BoxedArrayRes {
    if let ast.ExprArray(arr) = e {
        var fs: parser.FuncDecl[] = funcs;
        var ct: i32 = counter;
        var nelems: ast.Expr[] = [];
        var i: i32 = 0;
        while (i < arr.elements.len()) {
            var er: InlineCloRes = try_fn_field_value(arr.elements[i], fd, fs, ct, gfns, mfuncs, structs);
            fs = er.funcs; ct = er.counter; nelems = nelems.append(er.expr);
            i = i + 1;
        }
        return BoxedArrayRes { expr: ast.ExprArray { ...arr, elements: nelems }, funcs: fs, counter: ct };
    }
    return BoxedArrayRes { expr: e, funcs: funcs, counter: counter };
}

// expr_is_array_lit reports whether `e` is an array LITERAL written at this
// position — the only argument form box_array_lit_elems can rewrite.
function expr_is_array_lit(e: ast.Expr): boolean {
    if let ast.ExprArray(_) = e { return true; }
    return false;
}

// try_fn_field_value lifts ONE fn-typed struct-field value into a `__mkclo$…`
// env-box marker. Capturing inline lambda → try_inline_closure (box [funcval,
// caps…]). No-capture inline lambda → a `$wrapN` trampoline, marker with no cap
// args (box [funcval]). Bare fn-name → a `$wrapN` trampoline calling the named
// fn, marker with no cap args. Any other value shape (or an unresolvable fn-name
// / non-i32-capture lambda) declines: the value is returned unchanged so the
// module bails (correctness preserved). The marker arg list is empty for
// the wrap cases, so __mkclo$ lowering emits a 1-slot box [const_func($wrapN)].
function try_fn_field_value(e: ast.Expr, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): InlineCloRes {
    match (e) {
        ast.ExprLambda(lam) => {
            var caps: string[] = lambda_captures(lam, fd);
            if (caps.len() > 0) { return try_inline_closure(lam, fd, funcs, counter, gfns, structs, mfuncs); }
            // No-capture lambda → wrap trampoline (body inlined, __env ignored).
            var wn: string = clo_owner_name(fd) + "$wrap" + util.i32_to_string(counter);
            var wf: parser.FuncDecl = make_wrap_lambda_func(lam, wn);
            var marker: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + wn, line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
            return InlineCloRes { expr: marker, funcs: funcs.append(wf), counter: counter + 1 };
        },
        ast.ExprIdent(id) => {
            // A PARAMETER of the enclosing function is not a module fn-name, even
            // when a module function happens to share its name — the parameter
            // shadows it. The value is already an env box in a slot, so decline
            // and leave the ident alone; that is exactly the path taken when the
            // names do not collide.
            //
            // Without this guard the trampoline below was built against the
            // MODULE function, so `f(target)` where `target` is a fn-typed
            // parameter emitted `call __fn_target` — a hardcoded call to an
            // unrelated top-level function of the same name. No diagnostic, no
            // crash: a running binary that invokes the wrong function (#6191).
            // std/fuzz hit it because its parameter is literally named `target`
            // and fuzz programs conventionally name their target function the
            // same thing.
            if (lift_ident_is_param(fd, id.name)) {
                return InlineCloRes { expr: e, funcs: funcs, counter: counter };
            }
            // Bare fn-name field (`Box { f: dbl }`): build a trampoline calling it.
            var wn2: string = clo_owner_name(fd) + "$wrap" + util.i32_to_string(counter);
            var hr: HoistResult = make_wrap_named_func(id.name, wn2, mfuncs);
            if (!hr.ok) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
            var marker2: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + wn2, line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
            return InlineCloRes { expr: marker2, funcs: funcs.append(hr.func), counter: counter + 1 };
        },
        ast.ExprCall(c) => {
            // A value-position `if`/`match` in a fn-value position parses as an
            // IIFE, and its arms are STATEMENTS inside an expression, so the
            // expression walk stopped here and an arm lambda reached lower_expr
            // asking for a `<fd>$clo` nothing built (#6256). Box the arm values
            // instead — the whole IIFE then yields a box, exactly like the
            // lambda case above, in every position that routes through here
            // (array element, tuple element, struct field, fn-typed argument).
            match (c.callee) {
                ast.ExprLambda(il) => {
                    if (c.args.len() != 0 || il.params.len() != 0) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
                    // What the arms are SELECTED BY is walked first and
                    // unconditionally (#6571) — it is independent of whether the
                    // arm VALUES are boxable, so an IIFE with a capturing lambda
                    // in its condition and plain scalar arms (the shape that
                    // bailed) is rewritten even though the boxing below declines.
                    var (cnds, cnda) = lift_iife_conditions(il.body, fd, funcs, counter, gfns, mfuncs, structs);
                    if (cnda.counter > counter) {
                        var cl2: ast.Expr = ast.ExprLambda { ...il, body: cnds };
                        var ce2: ast.Expr = ast.ExprCall { callee: cl2, args: c.args, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
                        return InlineCloRes { expr: ce2, funcs: cnda.funcs, counter: cnda.counter };
                    }
                    if (!iife_arms_all_boxable(il.body)) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
                    // The arms are lowered INLINE in the enclosing function, so a
                    // name the IIFE itself binds — a match arm's payload, an
                    // arm-body local — is an ordinary local slot there. Boxing an
                    // arm lambda against `fd` alone left such a name out of
                    // lambda_captures' enclosing set, so the lambda read as
                    // capture-free and its `$wrap` trampoline resolved the name
                    // against the module instead. Widening the scope makes it a
                    // capture like any other.
                    var fdx: parser.FuncDecl = iife_scope_fd(fd, il.body);
                    var (brs, bra) = box_iife_arm_values(il.body, fdx, funcs, counter, gfns, mfuncs, structs);
                    if (bra.counter == counter || !iife_arms_all_marked(brs)) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
                    var nlam: ast.Expr = ast.ExprLambda { ...il, body: brs };
                    var niife: ast.Expr = ast.ExprCall { callee: nlam, args: c.args, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
                    return InlineCloRes { expr: niife, funcs: bra.funcs, counter: bra.counter };
                },
                ast.ExprIdent(cid) => {
                    // A generic passthrough (`id(<lambda>)`) hands its argument
                    // straight back, so boxing the argument boxes the call. The
                    // aggregate positions call this directly rather than through
                    // the expression walk, so the call's own arguments were never
                    // reached and the lambda inside stayed raw.
                    var pfs: parser.FuncDecl[] = funcs;
                    var pct: i32 = counter;
                    var pargs: ast.Expr[] = [];
                    var pi2: i32 = 0;
                    while (pi2 < c.args.len()) {
                        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, pi2)
                                && lift_arg_is_passthrough_fn_value(c.args[pi2], mfuncs)) {
                            var pr: InlineCloRes = try_fn_field_value(c.args[pi2], fd, pfs, pct, gfns, mfuncs, structs);
                            pfs = pr.funcs; pct = pr.counter; pargs = pargs.append(pr.expr);
                        } else {
                            pargs = pargs.append(c.args[pi2]);
                        }
                        pi2 = pi2 + 1;
                    }
                    if (pct == counter) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
                    return InlineCloRes { expr: ast.ExprCall { callee: c.callee, args: pargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty }, funcs: pfs, counter: pct };
                },
                _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
            }
        },
        _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
    }
    return InlineCloRes { expr: e, funcs: funcs, counter: counter };
}

// iife_arms_all_boxable reports whether EVERY arm of a value-position if/match
// yields something try_fn_field_value turns into an env box — an inline lambda,
// or a nested value-position if/match that is itself all-boxable — and that at
// least one arm is a lambda. Both halves matter: below "every arm" the
// destination would carry two dispatch ABIs (#5071 one container out), and
// without a lambda there is nothing to box.
function iife_arms_all_boxable(stmts: ast.Stmt[]): boolean {
    return iife_arm_values_boxable(stmts, 0) > 0;
}

// iife_scope_fd returns `fd` with the IIFE's own statements appended to its
// body, so lambda_captures counts a name the IIFE binds as an enclosing local.
// Only the body is read by the capture walk, so nothing else needs adjusting.
function iife_scope_fd(fd: parser.FuncDecl, body: ast.Stmt[]): parser.FuncDecl {
    var nb: ast.Stmt[] = fd.body;
    var i: i32 = 0;
    while (i < body.len()) { nb = nb.append(body[i]); i = i + 1; }
    return parser.FuncDecl { ...fd, body: nb };
}

// Returns the number of lambda arms found, or -1 as soon as an arm yields
// something that is not boxable.
function iife_arm_values_boxable(stmts: ast.Stmt[], seen: i32): i32 {
    var n: i32 = seen;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprLambda(_) => { n = n + 1; },
                    ast.ExprCall(rc) => {
                        match (rc.callee) {
                            ast.ExprLambda(ril) => {
                                if (rc.args.len() != 0 || ril.params.len() != 0) { return 0 - 1; }
                                var deep: i32 = iife_arm_values_boxable(ril.body, n);
                                if (deep < 0) { return 0 - 1; }
                                n = deep;
                            },
                            _ => { return 0 - 1; }
                        }
                    },
                    _ => { return 0 - 1; }
                }
            },
            ast.StmtIf(iff) => {
                n = iife_arm_values_boxable(iff.then_body, n);
                if (n < 0) { return 0 - 1; }
                n = iife_arm_values_boxable(iff.else_body, n);
                if (n < 0) { return 0 - 1; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    n = iife_arm_values_boxable(mm.arms[a].body, n);
                    if (n < 0) { return 0 - 1; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return n;
}

// iife_arms_all_marked is the POST-condition on the rewrite: every arm now
// returns a `__mkclo$…` env-box marker (or a nested IIFE whose arms all do).
// try_fn_field_value declines silently — a capture whose slot it cannot build
// comes back unchanged — and a PARTLY boxed IIFE is worse than an unboxed one:
// the destination reads as a box from one arm and dispatches every arm that
// way. Checked rather than assumed, so a decline anywhere abandons the rewrite.
function iife_arms_all_marked(stmts: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprCall(rc) => {
                        match (rc.callee) {
                            ast.ExprIdent(rid) => {
                                if (!(rid.name.len() > 8 && slice_unchecked(rid.name, 0, 8) == "__mkclo$")) { return false; }
                            },
                            ast.ExprLambda(ril) => {
                                if (!iife_arms_all_marked(ril.body)) { return false; }
                            },
                            _ => { return false; }
                        }
                    },
                    _ => { return false; }
                }
            },
            ast.StmtIf(iff) => {
                if (!iife_arms_all_marked(iff.then_body)) { return false; }
                if (!iife_arms_all_marked(iff.else_body)) { return false; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    if (!iife_arms_all_marked(mm.arms[a].body)) { return false; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return true;
}

// lift_iife_conditions walks what an IIFE's arms are SELECTED BY (#6571).
//
// A value-position `if`/`match` is an IIFE, and its body is STATEMENTS inside an
// expression. Every lift path that reaches into one — the #6256 arm-value boxing
// below, box_iife_arm_array_elems — walks the arms' returned VALUES; nothing
// walked the CONDITION. A capturing lambda there therefore reached lower_expr
// bare and asked for a `$clo` nothing built, bailing the module.
//
// Only the condition / scrutinee is walked, and only through the ordinary
// expression lift: the returns belong to the paths that own them, and running
// both over the same node would box an arm value twice. On the spine that
// reads as: StmtIf declines, so the spine hands its condition to the full lift
// visitor and recurses the bodies through this one; StmtMatch is claimed and
// rebuilt by hand, because declining it would put the arm GUARDS through the
// lift too, which this walk has never done; every statement that owns a value
// slot is claimed unchanged so those slots stay unwalked.
function lift_iife_conditions(stmts: ast.Stmt[], fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): (ast.Stmt[], InlineCloAcc) {
    function ve(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) { return ilc_expr_at(x, a, fd, gfns, structs, mfuncs); }
    function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
        match (s) {
            ast.StmtIf(_) => { return (s, a, false); },
            ast.StmtMatch(mm) => {
                var sr: InlineCloRes = lift_inline_closures_expr(mm.scrutinee, fd, a.funcs, a.counter, gfns, structs, mfuncs);
                var fs: parser.FuncDecl[] = sr.funcs;
                var ct: i32 = sr.counter;
                var narms: ast.MatchArm[] = [];
                for arm in mm.arms {
                    var (abs, aba) = lift_iife_conditions(arm.body, fd, fs, ct, gfns, mfuncs, structs);
                    fs = aba.funcs; ct = aba.counter;
                    narms = narms.append(ast.MatchArm { ...arm, body: abs });
                }
                return (ast.StmtMatch { ...mm, scrutinee: sr.expr, arms: narms }, InlineCloAcc { funcs: fs, counter: ct }, true);
            },
            ast.StmtVar(_) => { return (s, a, true); },
            ast.StmtReturn(_) => { return (s, a, true); },
            ast.StmtExpr(_) => { return (s, a, true); },
            ast.StmtAssign(_) => { return (s, a, true); },
            ast.StmtWhile(_) => { return (s, a, true); },
            ast.StmtFor(_) => { return (s, a, true); },
            ast.StmtDefer(_) => { return (s, a, true); },
            ast.StmtBreak(_) => { return (s, a, false); },
            ast.StmtContinue(_) => { return (s, a, false); },
            ast.StmtUnknown(_) => { return (s, a, false); }
        }
        return (s, a, true);
    }
    return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ve);
}

// ilc_keep_expr claims every expression unchanged — the expression visitor for
// the arm-boxing walks, whose statement visitors own all the rewriting and
// whose condition / scrutinee / guard slots must stay unwalked.
function ilc_keep_expr(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) { return (x, a, true); }

// lift_iife_arm_values puts the VALUES an inline IIFE's arms return through the
// ORDINARY expression lift — the walk every other expression position gets.
//
// hoist_value_iife and box_iife_arm_array_elems own those returns when the arms
// yield a fn value or an array of them. An arm yielding anything else — an
// ordinary call, say — is owned by nobody, and the arms are STATEMENTS inside an
// expression, so the expression walk stops at the IIFE and never reaches it. A
// fn-typed ARGUMENT of a call in such an arm therefore stayed raw while every
// other call site of the same callee boxed its own: the callee's fn parameter
// dispatches env-first and got a bare code address (#8090, seed 15035).
//
// Returns only, and the caller gates it on the fn-value paths not having claimed
// the arms — running two of these over one node would box a value twice. The
// condition is lift_iife_conditions'.
function lift_iife_arm_values(stmts: ast.Stmt[], fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): (ast.Stmt[], InlineCloAcc) {
    function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
        match (s) {
            ast.StmtReturn(r) => {
                var vr: InlineCloRes = lift_inline_closures_expr(r.value, fd, a.funcs, a.counter, gfns, structs, mfuncs);
                return (ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }, InlineCloAcc { funcs: vr.funcs, counter: vr.counter }, true);
            },
            ast.StmtIf(_) => { return (s, a, false); },
            ast.StmtMatch(mm) => {
                var fs: parser.FuncDecl[] = a.funcs;
                var ct: i32 = a.counter;
                var narms: ast.MatchArm[] = [];
                for arm in mm.arms {
                    var (abs, aba) = lift_iife_arm_values(arm.body, fd, fs, ct, gfns, mfuncs, structs);
                    fs = aba.funcs; ct = aba.counter;
                    narms = narms.append(ast.MatchArm { ...arm, body: abs });
                }
                return (ast.StmtMatch { ...mm, arms: narms }, InlineCloAcc { funcs: fs, counter: ct }, true);
            },
            ast.StmtVar(_) => { return (s, a, true); },
            ast.StmtExpr(_) => { return (s, a, true); },
            ast.StmtAssign(_) => { return (s, a, true); },
            ast.StmtWhile(_) => { return (s, a, true); },
            ast.StmtFor(_) => { return (s, a, true); },
            ast.StmtDefer(_) => { return (s, a, true); },
            ast.StmtBreak(_) => { return (s, a, false); },
            ast.StmtContinue(_) => { return (s, a, false); },
            ast.StmtUnknown(_) => { return (s, a, false); }
        }
        return (s, a, true);
    }
    return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ilc_keep_expr);
}

// box_iife_arm_values rewrites each arm's returned VALUE through
// try_fn_field_value — box_iife_arm_array_elems one container in, for an IIFE
// whose arms yield the fn value itself rather than an array of them. A nested
// IIFE arm recurses through try_fn_field_value's own IIFE case.
function box_iife_arm_values(stmts: ast.Stmt[], fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): (ast.Stmt[], InlineCloAcc) {
    function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
        match (s) {
            ast.StmtReturn(r) => {
                var vr: InlineCloRes = try_fn_field_value(r.value, fd, a.funcs, a.counter, gfns, mfuncs, structs);
                return (ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }, InlineCloAcc { funcs: vr.funcs, counter: vr.counter }, true);
            },
            ast.StmtIf(_) => { return (s, a, false); },
            ast.StmtMatch(_) => { return (s, a, false); },
            ast.StmtVar(_) => { return (s, a, true); },
            ast.StmtExpr(_) => { return (s, a, true); },
            ast.StmtAssign(_) => { return (s, a, true); },
            ast.StmtWhile(_) => { return (s, a, true); },
            ast.StmtFor(_) => { return (s, a, true); },
            ast.StmtDefer(_) => { return (s, a, true); },
            ast.StmtBreak(_) => { return (s, a, false); },
            ast.StmtContinue(_) => { return (s, a, false); },
            ast.StmtUnknown(_) => { return (s, a, false); }
        }
        return (s, a, true);
    }
    return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ilc_keep_expr);
}

// passthrough_array_arg returns the index of the erased-generic argument a
// passthrough call forwards when that argument leads to an ARRAY literal, or
// -1. The call yields exactly that literal, so an arm spelled `id([…])` carries
// the same elements an arm spelled `[…]` does.
//
// A forwarded argument may be a passthrough itself — `id(pick(c, […], […]))`,
// which fernsmith does not happen to emit but ordinary source does — so the
// walk follows the chain rather than demanding the literal one level in.
// passthrough_array_literal resolves the far end for the callers that need the
// elements themselves.
function passthrough_array_arg(c: ast.ExprCall, mfuncs: MFuncs): i32 {
    match (c.callee) {
        ast.ExprIdent(cid) => {
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
                        && passthrough_leads_to_array(c.args[i], mfuncs)) { return i; }
                i = i + 1;
            }
        },
        _ => {}
    }
    return 0 - 1;
}

// passthrough_leads_to_array reports whether `e` is an array literal, or a chain
// of passthrough calls ending in one.
function passthrough_leads_to_array(e: ast.Expr, mfuncs: MFuncs): boolean {
    match (e) {
        ast.ExprArray(_) => { return true; },
        ast.ExprCall(c) => { return passthrough_array_arg(c, mfuncs) >= 0; },
        _ => { return false; }
    }
    return false;
}

// passthrough_array_literal returns the array literal at the far end of such a
// chain as a one-element list, or an empty one when there is none — the shape a
// caller can `match` without a second walk.
function passthrough_array_literal(e: ast.Expr, mfuncs: MFuncs): ast.Expr[] {
    match (e) {
        ast.ExprArray(_) => { return [e]; },
        ast.ExprCall(c) => {
            var i: i32 = passthrough_array_arg(c, mfuncs);
            if (i < 0) { return []; }
            return passthrough_array_literal(c.args[i], mfuncs);
        },
        _ => { return []; }
    }
    return [];
}

// passthrough_rebuilt_with replaces the array literal at the far end of the
// chain with `repl`, keeping every call in between — so boxing the elements
// leaves `id(pick(c, [box…], […]))` shaped exactly as it was found.
function passthrough_rebuilt_with(e: ast.Expr, repl: ast.Expr, mfuncs: MFuncs): ast.Expr {
    match (e) {
        ast.ExprArray(_) => { return repl; },
        ast.ExprCall(c) => {
            var i: i32 = passthrough_array_arg(c, mfuncs);
            if (i < 0) { return e; }
            var na: ast.Expr[] = [];
            var k: i32 = 0;
            while (k < c.args.len()) {
                if (k == i) { na = na.append(passthrough_rebuilt_with(c.args[k], repl, mfuncs)); }
                else { na = na.append(c.args[k]); }
                k = k + 1;
            }
            return ast.ExprCall { callee: c.callee, args: na, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
        },
        _ => { return e; }
    }
    return e;
}

// fd_returns_boxed_fn_array reports whether ANY `return [ … ]` in `fd` yields an
// array the lift boxes. Every such literal in the function then has to box,
// including a sibling return whose own elements are all plain lambdas: the
// returns share the CALLER's binding, and a binding gets one dispatch ABI
// (#5071 one container out, #6555). Without it `return (if (c) { [<lambda>] }
// else { [id(<lambda>)] })` handed back a bare fn-pointer array down one path
// and an env-box array down the other, and the caller env-first-dispatched
// whichever arm ran — compiled clean, SIGSEGV.
function fd_returns_boxed_fn_array(fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs): boolean {
    var rets: ast.Expr[] = collect_returns(fd.body, []);
    var i: i32 = 0;
    while (i < rets.len()) {
        match (rets[i]) {
            ast.ExprArray(ra) => {
                var e: i32 = 0;
                while (e < ra.elements.len()) {
                    if (array_elem_is_env_boxed(ra.elements[e], fd, structs, mfuncs)) { return true; }
                    e = e + 1;
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// fd_passes_fn_array_elem reports whether `fd` binds a local from an ARRAY
// ELEMENT (`var f = fs[i]`) and then hands that local to a fn-typed parameter.
//
// The lift boxes every fn-value ARGUMENT, so the callee's fn-typed param
// dispatches env-first — it reads slot 0 of what it assumes is a [funcval,
// caps…] box. An element read out of a POINTER array is a bare code address
// there, so the dispatch jumps through whatever the first instruction word
// decodes as (SIGSEGV, #8090). Answering yes puts this function's fn-value
// array LITERALS on the env-box ABI, so the element the binding reads and the
// parameter that receives it agree by construction. #5071's uniformity rule,
// one container out — the ARGUMENT sibling of fd_returns_boxed_fn_array and
// fd_stores_fn_value_array.
function fd_passes_fn_array_elem(fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
    var names: string[] = fd_index_bound_names(fd.body);
    if (names.len() == 0) { return false; }
    var calls: ast.Expr[] = [];
    var si: i32 = 0;
    while (si < fd.body.len()) {
        calls = astwalk.fold_stmt(fd.body[si], calls, call_exprs_of);
        si = si + 1;
    }
    var ci: i32 = 0;
    while (ci < calls.len()) {
        match (calls[ci]) {
            ast.ExprCall(c) => {
                match (c.callee) {
                    ast.ExprIdent(cid) => {
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            // The name test FIRST, and only then the parameter
                            // types: both lookups are whole-table scans (the
                            // module's functions, then this body's local ones),
                            // and running them per argument of every call in the
                            // function is what a compiler-sized body cannot pay
                            // for. Almost no argument is one of these names.
                            match (c.args[ai]) {
                                ast.ExprIdent(aid) => {
                                    if (util.index_of_str(names, aid.name) >= 0
                                            && (lift_callee_param_is_fn(mfuncs, cid.name, ai) || lift_local_fn_param_is_fn(fd, cid.name, ai))) { return true; }
                                },
                                _ => {}
                            }
                            ai = ai + 1;
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        ci = ci + 1;
    }
    return false;
}

// fd_index_bound_names collects the FN-TYPED names `body` binds from an ARRAY
// ELEMENT (`var f: (i32) => i32 = fs[i]`), at any statement depth. Binders live
// on statements, so the walk needs no descent into initialisers
// (body_binds_lambda's rule).
//
// Fn-typed, not every index binding: only a fn value can reach a fn-typed
// parameter, and the declared type is the cheap test that keeps the caller's
// call walk off the overwhelming majority of functions.
function fd_index_bound_names(body: ast.Stmt[]): string[] {
    var out: string[] = [];
    for st in body {
        out = astwalk.fold_stmt_nodes(st, out, idx_bound_name_at, no_expr_strs, astwalk.descend_none);
    }
    return out;
}

function idx_bound_name_at(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (v.type_name != "fn" && fn_param_from_spelling("", v.type_name).type_name != "fn") { return acc; }
            if let ast.ExprIndex(_) = v.init { return acc.append(v.name); }
        },
        _ => {}
    }
    return acc;
}

// call_exprs_of collects every call node an expression holds.
function call_exprs_of(e: ast.Expr, acc: ast.Expr[]): ast.Expr[] {
    if let ast.ExprCall(_) = e { return acc.append(e); }
    return acc;
}

// array_holds_fn_value reports whether the literal has any fn-VALUED element, so
// the uniformity rule above applies to it at all (an i32[] never does).
function array_holds_fn_value(arr: ast.ExprArray, mfuncs: MFuncs): boolean {
    var i: i32 = 0;
    while (i < arr.elements.len()) {
        match (arr.elements[i]) {
            ast.ExprLambda(_) => { return true; },
            ast.ExprIdent(aid) => { if (lift_module_fn_arity(mfuncs, aid.name) >= 1) { return true; } },
            ast.ExprCall(ac) => {
                match (ac.callee) {
                    ast.ExprIdent(acid) => {
                        var a: i32 = 0;
                        while (a < ac.args.len()) {
                            if (lift_callee_is_typevar_passthrough(mfuncs, acid.name, a)
                                    && lift_arg_is_fn_value(ac.args[a], mfuncs)) { return true; }
                            a = a + 1;
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// fd_bound_names is fd's params plus every name its body binds — the shadowing
// set a bare ident must MISS to read as an unshadowed module function.
function fd_bound_names(fd: parser.FuncDecl): string[] {
    var acc: string[] = [];
    var p: i32 = 0;
    while (p < fd.params.len()) { acc = acc.append(fd.params[p].name); p = p + 1; }
    return astwalk.collect_bound_stmts(fd.body, acc);
}

// arr_with_value_of collects the VALUE argument of every `xs.with(i, v)` /
// `xs.append(v)` an expression tree reaches. The walk visitor for
// fd_stores_fn_value_array below.
function arr_with_value_of(e: ast.Expr, acc: ast.Expr[]): ast.Expr[] {
    if let ast.ExprCall(c) = e {
        if let ast.ExprFieldAccess(fa) = c.callee {
            if (fa.field == "with" && c.args.len() == 2) { return acc.append(c.args[1]); }
            if (fa.field == "append" && c.args.len() == 1) { return acc.append(c.args[0]); }
        }
    }
    return acc;
}

// fd_stores_fn_value_array reports whether `fd` writes a fn VALUE into an array
// through `.with(i, v)` / `.append(v)`. Those clone the receiver and store one
// element into the copy, so the stored value has to carry the receiver's element
// ABI — and the lift, which has no receiver type to read, boxes a fn value at
// every method-argument position (lift_method_arg_is_fn). Answering yes puts the
// function's fn-value array LITERALS on that same env-box ABI, so the receiver
// the store clones and the value it stores agree by construction. #5071's
// uniformity rule, one container out — the `.with` sibling of
// fd_returns_boxed_fn_array. `bound` carries fd's params + body binders so a
// LOCAL shadowing a module function name is not read as a fn value.
function fd_stores_fn_value_array(fd: parser.FuncDecl, mfuncs: MFuncs, bound: string[]): boolean {
    var vals: ast.Expr[] = [];
    var si: i32 = 0;
    while (si < fd.body.len()) {
        vals = astwalk.fold_stmt(fd.body[si], vals, arr_with_value_of);
        si = si + 1;
    }
    var i: i32 = 0;
    while (i < vals.len()) {
        if (with_value_is_fn_value(vals[i], fd, mfuncs, bound)) { return true; }
        i = i + 1;
    }
    return false;
}

// with_value_is_fn_value reports whether a `.with`/`.append` VALUE is a fn
// value: an inline lambda, an unshadowed module-function name, or a local that
// already holds one (an fn-typed param, or a name bound to a lambda — both of
// which the lift materialises as an env BOX).
function with_value_is_fn_value(v: ast.Expr, fd: parser.FuncDecl, mfuncs: MFuncs, bound: string[]): boolean {
    if let ast.ExprLambda(_) = v { return true; }
    if let ast.ExprIdent(vid) = v {
        if (util.index_of_str(bound, vid.name) < 0) { return lift_module_fn_arity(mfuncs, vid.name) >= 1; }
        var p: i32 = 0;
        while (p < fd.params.len()) {
            if (fd.params[p].name == vid.name && fd.params[p].type_name == "fn") { return true; }
            p = p + 1;
        }
        return body_binds_lambda(fd.body, vid.name);
    }
    return false;
}

// body_binds_lambda reports whether `body` binds `name` to a lambda, at any
// nesting depth — the shape the lift holds as an env box.
function body_binds_lambda(body: ast.Stmt[], name: string): boolean {
    function binds_lambda_at(st: ast.Stmt, acc: boolean): boolean {
        if (acc) { return true; }
        match (st) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if let ast.ExprLambda(_) = v.init { return true; }
                }
            },
            _ => {}
        }
        return acc;
    }
    var found: boolean = false;
    for st in body {
        found = astwalk.fold_stmt_nodes(st, found, binds_lambda_at, no_expr_bool, astwalk.descend_none);
        if (found) { return true; }
    }
    return false;
}

function no_expr_bool(e: ast.Expr, acc: boolean): boolean { return acc; }

// lift_callee_param_is_fn reports whether free function / method `callee`'s
// param `idx` is fn-typed (coarse type_name "fn"). The lift-pass mirror of
// LowerState.callee_param_is_fn / asmcore.callee_param_is_fn, reading the module
// funcs directly (no fn_param_sigs registry available at lift time).
// lift_local_fn_param_is_fn is lift_callee_param_is_fn for a NESTED local
// function — `function helper(f: (i32) => i32): i32 { … }` declared inside
// another function's body, which the parser represents as a `var helper =
// <lambda>` binding.
//
// The module-function lookup cannot see one: hoist_local_funcs_module only
// rewrites bodies containing a SELF-RECURSIVE local, so a plain nested function
// stays a statement and never reaches `mfuncs`. The lift therefore judged a
// fn-value argument to it as "callee param is not fn-typed" and passed the value
// RAW. The callee dispatches env-first — it reads slot 0 of what it assumes is a
// [funcval, caps…] box — so it dereferenced a bare code address and the program
// segfaulted with no diagnostic at all (#6341). Binding the same value to a
// local first happened to work, because that path boxes it.
function lift_local_fn_param_is_fn(fd: parser.FuncDecl, callee: string, idx: i32): boolean {
    var i: i32 = 0;
    while (i < fd.body.len()) {
        match (fd.body[i]) {
            ast.StmtVar(v) => {
                if (v.name == callee) {
                    match (v.init) {
                        ast.ExprLambda(lm) => {
                            if (idx < lm.params.len() && lm.params[idx].type_name == "fn") { return true; }
                        },
                        _ => {}
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// MFuncs is the module function table plus a name index over it. The
// lift_callee_* predicates below answer "what does this callee look like?" once
// per call ARGUMENT, and they used to scan the whole table — ~4,600 entries on a
// whole-compiler module, with a string compare each — for a callee name that is
// constant across the argument loop. That was 74 of 400 profile samples, 18.5%
// of a self-compile, all under lift_inline_closures_expr
// (docs/PERFORMANCE-AUDIT-2026-08.md §4d.3).
//
// The index is a chain and not a single slot deliberately: a predicate keeps
// looking past a name match and answers true if ANY same-named decl satisfies
// its remaining conditions, so collapsing a name to one entry would change the
// verdict wherever two decls share a name.
pub struct MFuncs {
    decls: parser.FuncDecl[],
    // head[b] is the first decls index in bucket b (-1 when empty); next[i]
    // chains to the next index in the same bucket, ascending. head.len() IS the
    // bucket count, so the lookups cannot hash against a different modulus than
    // the build did.
    head: i32[],
    next: i32[],
}

// mfuncs_buckets is the bucket count of the name index. Prime, so unrelated
// hash strides do not alias onto one bucket, and sized so a whole-compiler
// module's ~4,600 functions sit at roughly one per bucket.
function mfuncs_buckets(): i32 { return 4093; }

// mfuncs_table indexes `decls` by name. Built by walking BACKWARD and pushing
// each entry onto the front of its bucket, which leaves every chain in
// ascending index order without a per-bucket tail — the same order the linear
// scan visited, so a chain walk and a full scan agree on which same-named decl
// answers first. Mirrors checker.sig_table.
pub function mfuncs_table(decls: parser.FuncDecl[]): MFuncs {
    var head: i32[] = [];
    var b: i32 = 0;
    var nb: i32 = mfuncs_buckets();
    while (b < nb) { head = head.append(0 - 1); b = b + 1; }
    var next: i32[] = [];
    var j: i32 = 0;
    while (j < decls.len()) { next = next.append(0 - 1); j = j + 1; }
    var k: i32 = decls.len() - 1;
    while (k >= 0) {
        var bk: i32 = util.hash_bucket(decls[k].name, nb);
        next = next.with(k, head[bk]);
        head = head.with(bk, k);
        k = k - 1;
    }
    return MFuncs { decls: decls, head: head, next: next };
}

// mfuncs_extend appends `extra` to an existing table and indexes only those, so
// growing the signature list for one worklist entry costs O(extra) instead of
// re-seeding all mfuncs_buckets() heads — which, done per entry, would be more
// work than the scan this index replaces.
//
// The appended entries land at the FRONT of their buckets, so an extended chain
// is not globally ascending. The two indexed predicates answer a BOOLEAN over
// "any same-named decl", so visit order cannot change their verdict; nothing
// else reads the chains.
pub function mfuncs_extend(base: MFuncs, extra: parser.FuncDecl[]): MFuncs {
    var decls: parser.FuncDecl[] = base.decls;
    var head: i32[] = base.head;
    var next: i32[] = base.next;
    var i: i32 = 0;
    while (i < extra.len()) {
        var k: i32 = decls.len();
        decls = decls.append(extra[i]);
        next = next.append(0 - 1);
        var bk: i32 = util.hash_bucket(extra[i].name, head.len());
        next = next.with(k, head[bk]);
        head = head.with(bk, k);
        i = i + 1;
    }
    return MFuncs { decls: decls, head: head, next: next };
}

// lift_callee_is_typevar_passthrough reports whether free function `callee`
// takes an ERASED type-var parameter at `idx` and returns that same type var —
// the `id[T](x: T): T` shape. An unbounded type param is erased rather than
// monomorphised, so the parameter keeps the spelling `T` and
// lift_callee_param_is_fn, which tests for the literal "fn", never matches it.
// A fn-value argument therefore reached lowering unlifted and asked for a
// `<fn>$clo` nothing built (#6466).
//
// The passthrough shape is what makes boxing safe here: the callee returns its
// argument unchanged, so whatever representation the argument has is the
// representation the result has. A generic that CONSUMES the value would need
// the env box to mean something to it.
function lift_callee_is_typevar_passthrough(mfuncs: MFuncs, callee: string, idx: i32): boolean {
    var i: i32 = mfuncs.head[util.hash_bucket(callee, mfuncs.head.len())];
    while (i >= 0) {
        if (mfuncs.decls[i].name == callee && mfuncs.decls[i].type_param_count > 0
                && idx < mfuncs.decls[i].params.len()
                && mfuncs.decls[i].params[idx].type_name.len() > 0
                && mfuncs.decls[i].params[idx].type_name == mfuncs.decls[i].ret_type) {
            return true;
        }
        i = mfuncs.next[i];
    }
    return false;
}

function lift_callee_param_is_fn(mfuncs: MFuncs, callee: string, idx: i32): boolean {
    var i: i32 = mfuncs.head[util.hash_bucket(callee, mfuncs.head.len())];
    while (i >= 0) {
        if (mfuncs.decls[i].name == callee && idx < mfuncs.decls[i].params.len() && mfuncs.decls[i].params[idx].type_name == "fn") {
            return true;
        }
        i = mfuncs.next[i];
    }
    return false;
}

// lift_callee_param_is_fnarr is lift_callee_param_is_fn for an fn-ARRAY
// parameter (`((T) => R)[]`, coarsed "fn[]").
function lift_callee_param_is_fnarr(mfuncs: MFuncs, callee: string, idx: i32): boolean {
    var i: i32 = mfuncs.head[util.hash_bucket(callee, mfuncs.head.len())];
    while (i >= 0) {
        if (mfuncs.decls[i].name == callee && idx < mfuncs.decls[i].params.len() && mfuncs.decls[i].params[idx].type_name == "fn[]") {
            return true;
        }
        i = mfuncs.next[i];
    }
    return false;
}

// fnarr_param_forces_boxes reports whether SOME call site of free function
// `callee` passes, at `pidx`, an array literal that HAS to carry env boxes.
//
// An `fn[]` parameter has one dispatch ABI across every call site — decided by
// fn_param_sigs_of's caparams proof, which demands that every site agree — so a
// site with no choice settles it for all of them: an element that captures, a
// value-position `if`/`match`, or a generic passthrough has no representation
// other than a box. Its disagreeing siblings are then boxed too (the caller of
// this), which is what leaves the proof one representation to see instead of
// two.
//
// #8090: `apply_all([a, b])` and `apply_all([<capturing>])` reached the same
// parameter as a POINTER array and a BOX array. The proof failed on the
// disagreement, so the parameter dispatched plain — and the box array's
// elements were called as code.
function fnarr_param_forces_boxes(mfuncs: MFuncs, structs: parser.StructDecl[], callee: string, pidx: i32): boolean {
    var fi: i32 = 0;
    while (fi < mfuncs.decls.len()) {
        if (fd_passes_boxed_fnarr_lit(mfuncs.decls[fi], callee, pidx, structs, mfuncs)) { return true; }
        fi = fi + 1;
    }
    return false;
}

// lambda_exprs_of collects every lambda an expression holds.
function lambda_exprs_of(e: ast.Expr, acc: ast.Expr[]): ast.Expr[] {
    if let ast.ExprLambda(_) = e { return acc.append(e); }
    return acc;
}

// fd_with_lambda_scopes folds every lambda's params and body in `fd` into one
// flattened scope, so lambda_captures answers against the names an element
// lambda can actually see rather than only `fd`'s own.
//
// The lift itself is exact here — it hoists each lambda and re-asks with that
// hoisted function as the scope — but this query runs BEFORE any of that, from
// a sibling call site, where the enclosing lambda is not a function yet. The
// flattening OVER-approximates: a name bound in an unrelated lambda reads as
// visible. That direction is the safe one — it can only decide an element is
// boxed when it might not be, and an over-boxed literal is correct, just one
// indirection slower.
function fd_with_lambda_scopes(fd: parser.FuncDecl): parser.FuncDecl {
    var lams: ast.Expr[] = [];
    var li: i32 = 0;
    while (li < fd.body.len()) {
        lams = astwalk.fold_stmt(fd.body[li], lams, lambda_exprs_of);
        li = li + 1;
    }
    var ps: ast.ParamDecl[] = fd.params;
    var nb: ast.Stmt[] = fd.body;
    var i: i32 = 0;
    while (i < lams.len()) {
        if let ast.ExprLambda(lam) = lams[i] {
            var pj: i32 = 0;
            while (pj < lam.params.len()) { ps = ps.append(lam.params[pj]); pj = pj + 1; }
            var bj: i32 = 0;
            while (bj < lam.body.len()) { nb = nb.append(lam.body[bj]); bj = bj + 1; }
        }
        i = i + 1;
    }
    return parser.FuncDecl { ...fd, params: ps, body: nb };
}

// fd_passes_boxed_fnarr_lit is fnarr_param_forces_boxes for one function body.
function fd_passes_boxed_fnarr_lit(fd0: parser.FuncDecl, callee: string, pidx: i32, structs: parser.StructDecl[], mfuncs: MFuncs): boolean {
    var fd: parser.FuncDecl = fd_with_lambda_scopes(fd0);
    var calls: ast.Expr[] = [];
    var si: i32 = 0;
    while (si < fd0.body.len()) {
        calls = astwalk.fold_stmt(fd0.body[si], calls, call_exprs_of);
        si = si + 1;
    }
    var ci: i32 = 0;
    while (ci < calls.len()) {
        if let ast.ExprCall(c) = calls[ci] {
            if let ast.ExprIdent(cid) = c.callee {
                if (cid.name == callee && pidx < c.args.len()) {
                    if let ast.ExprArray(arr) = c.args[pidx] {
                        var ei: i32 = 0;
                        while (ei < arr.elements.len()) {
                            if (array_elem_is_env_boxed(arr.elements[ei], fd, structs, mfuncs)) { return true; }
                            ei = ei + 1;
                        }
                    }
                }
            }
        }
        ci = ci + 1;
    }
    return false;
}

// lift_ident_is_param reports whether `name` is bound LOCALLY in `fd` — as its
// receiver, one of its parameters, or a `var` in its body. Any of those SHADOWS
// a module function of the same name, so a lift-pass path that would otherwise
// resolve a bare ident against the module function table has to check this
// first (#6191, see try_fn_field_value).
//
// The body scan is not belt-and-braces: it is what covers CAPTURES. A lambda
// lifted to a `$clo` function reads each captured value through a synthesized
// `var <cap> = __env[1+i]` at the top of its body, so inside the lifted
// function a capture is a local `var`, not a parameter. `std/fuzz`'s receiver
// method — `r.it(name, () => fuzz_run(seeds, iterations, target))` — captures
// `target` exactly that way, and it is the DOCUMENTED entry point, so a
// param-only guard would have left the real API broken while making the
// direct-call form look fixed.
function lift_ident_is_param(fd: parser.FuncDecl, name: string): boolean {
    if (fd.receiver_name == name && fd.receiver_name.len() > 0) { return true; }
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (fd.params[i].name == name) { return true; }
        i = i + 1;
    }
    var bound: string[] = [];
    var b: i32 = 0;
    while (b < fd.body.len()) { bound = astwalk.collect_bound_stmt(fd.body[b], bound); b = b + 1; }
    return util.index_of_str(bound, name) >= 0;
}

// lift_module_fn_arity returns the parameter count of receiver-less module
// function `name`, or -1 if no such function exists. Used to recognise a bare
// fn-VALUE ident (a function name with >= 1 param, distinct from a zero-arg
// `const`) so it can be env-boxed at a fn-value binding / argument position.
function lift_module_fn_arity(mfuncs: MFuncs, name: string): i32 {
    var i: i32 = 0;
    while (i < mfuncs.decls.len()) {
        if (mfuncs.decls[i].name == name && mfuncs.decls[i].receiver_type.len() == 0) { return mfuncs.decls[i].params.len(); }
        i = i + 1;
    }
    return 0 - 1;
}

// lift_arg_is_fn_value reports whether `arg` is a fn-VALUE worth env-boxing at a
// variant-constructor payload position (`Some(f)` / `Ok(f)` / `Err(f)`): an
// inline lambda (capturing or not), or a bare module-fn-name ident naming a
// receiver-less function with >= 1 param (a function pointer, distinct from a
// zero-arg `const`). Anything else (a call returning an already-boxed value, a
// boxed fn-value local, a non-fn payload) is left alone — try_fn_field_value
// also declines those, but checking here keeps the Some/Ok/Err detection from
// firing on ordinary non-fn payloads.
function lift_arg_is_fn_value(arg: ast.Expr, mfuncs: MFuncs): boolean {
    match (arg) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprIdent(id) => { return lift_module_fn_arity(mfuncs, id.name) >= 1; },
        _ => { return false; }
    }
    return false;
}

// lift_arg_is_passthrough_fn_value is lift_arg_is_fn_value through any number of
// generic passthrough calls: `id(<lambda>)` hands the lambda straight back, so a
// position holding that call holds a fn value just as much as one holding the
// lambda. The read side (arr_elem_is_closure_box) already recurses this way, so
// without it the two sides disagreed about a nested passthrough — the boxing
// pass left the inner lambda raw and it reached lower_expr asking for a
// `<fd>$clo` nothing built (#6256).
function lift_arg_is_passthrough_fn_value(arg: ast.Expr, mfuncs: MFuncs): boolean {
    if (lift_arg_is_fn_value(arg, mfuncs)) { return true; }
    match (arg) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
                                && lift_arg_is_passthrough_fn_value(c.args[i], mfuncs)) { return true; }
                        i = i + 1;
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

// array_elem_is_env_boxed reports whether an ARRAY-literal element already
// arrives as an env box, which puts the whole literal on the env-first dispatch
// ABI (#5071): a capturing lambda (box [funcval, caps…]); a value-position
// `if`/`match`, whose hoist yields a box for either kind of arm lambda (#6256);
// and a generic passthrough call handing either straight back (`id(<lambda>)`,
// `pick(c, <iife>, …)`), whose boxing at the erased-generic parameter is
// unconditional.
//
// A NON-capturing lambda element on its own is absent by design: an array of
// only those keeps the bare fn-pointer representation and its plain dispatch.
function array_elem_is_env_boxed(e: ast.Expr, fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs): boolean {
    match (e) {
        ast.ExprLambda(lam) => { return lambda_captures(lam, fd).len() > 0; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprLambda(il) => {
                    return c.args.len() == 0 && il.params.len() == 0
                        && iife_arms_have_lambda(il.body, mfuncs)
                        && iife_arms_hold_fn_value(il.body, fd, structs, mfuncs);
                },
                ast.ExprIdent(cid) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
                                && (lift_arg_is_passthrough_fn_value(c.args[i], mfuncs)
                                    || array_elem_is_env_boxed(c.args[i], fd, structs, mfuncs))) { return true; }
                        i = i + 1;
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

// lift_arg_is_fn_value_declared is lift_arg_is_fn_value for a position whose
// DECLARED type is already known to be a fn — a user-enum variant field typed
// "fn". There the zero-arg exclusion the plain predicate makes is unnecessary:
// it exists so a bare `const X` (which desugars to a zero-arg function) keeps
// reading as its VALUE, and a declared fn field rules that reading out. Without
// this, `enum E { Wrap(() => i32) }` + `Wrap(a1)` left the payload unboxed while
// the match-arm bind dispatched it env-first, and SIGSEGV'd (#5834's family).
function lift_arg_is_fn_value_declared(arg: ast.Expr, mfuncs: MFuncs): boolean {
    match (arg) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprIdent(id) => { return lift_module_fn_arity(mfuncs, id.name) >= 0; },
        _ => { return false; }
    }
    return false;
}

// lift_method_arg_is_fn decides whether a METHOD-call argument (`recv.m(arg)`)
// should be wrapped into an env box. Scoped to the map-value slice (#3445): an
// inline lambda whose method param is NOT a declared user fn-param. The negation
// is the key discriminator —
//   * a Map value slot `Map[K, () => V]` lowers `.set`/`.insert` to the builtin
//     op_map_set, and the method's value parameter is the GENERIC `V` (coarse
//     type, not literally "fn"), so lift_callee_param_is_fn is FALSE → wrap the
//     lambda into a box to STORE; the retrieval-side match-binding (#3466)
//     dispatches it env-first.
//   * a USER method with a DECLARED fn-param (`r.bench(name, iter, fn: () => void)`)
//     has lift_callee_param_is_fn TRUE → NOT wrapped here, so it keeps its
//     existing path (bare dispatch / AST-bail). Converting those to the env-box
//     ABI destabilises the byte-identical self-host fixpoint, so the full
//     uniform-ABI unification for user-method fn-args stays a deferred slice.
// Only an inline lambda qualifies. A bare fn-NAME reaching a builtin value slot
// is a shape the array stores do have, and lift_arr_store_arg_is_fn_name answers
// it for `.with`/`.append`; the map-value slot has no such shape. #3445.
function lift_method_arg_is_fn(arg: ast.Expr, mfield: string, idx: i32, mfuncs: MFuncs): boolean {
    match (arg) {
        ast.ExprLambda(_) => { return !lift_callee_param_is_fn(mfuncs, mfield, idx); },
        _ => {}
    }
    return false;
}

// lift_arr_store_arg_is_fn_name reports whether a `.with(i, v)` / `.append(v)`
// VALUE argument is a bare UNSHADOWED module-function name. The store deposits
// one element into a clone of the receiver, and fd_stores_fn_value_array has
// already put that receiver's literal on the env-box ABI, so the name has to be
// wrapped into a `$wrapN` trampoline box exactly as a fn-name array ELEMENT is —
// otherwise the clone holds a bare code pointer among boxes and the read side
// dereferences it. A zero-arg receiver-less fn is a `const` desugar whose VALUE
// must flow, so arity 1+ is required (mirrors the array/tuple ident rule).
function lift_arr_store_arg_is_fn_name(arg: ast.Expr, mfield: string, idx: i32, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
    if (!((mfield == "with" && idx == 1) || (mfield == "append" && idx == 0))) { return false; }
    match (arg) {
        ast.ExprIdent(aid) => {
            if (lift_module_fn_arity(mfuncs, aid.name) < 1) { return false; }
            return util.index_of_str(fd_bound_names(fd), aid.name) < 0;
        },
        _ => {}
    }
    return false;
}

// iife_callee_boxed_arms reports whether `callee` is a value-position if/match
// desugar (a zero-param IIFE lambda) whose every arm yields a closure BOX, so a
// local bound from it must be marked a closure local and dispatch env-first.
//
// Conservative by construction: an arm that is not provably a box answers false
// for the whole IIFE, so a bare fn-pointer arm (a named function) keeps the
// plain call_indirect dispatch it has today. An empty arm set answers false —
// nothing to prove it is a closure. #6323.
function iife_callee_boxed_arms(callee: ast.Expr, s: LowerState): boolean {
    match (callee) {
        ast.ExprLambda(lam) => {
            if (lam.params.len() != 0) { return false; }
            var seen: i32 = 0;
            return iife_stmts_all_boxed(lam.body, s, seen) > 0;
        },
        _ => { return false; }
    }
    return false;
}

// iife_stmts_all_boxed returns the number of arm returns proved to yield a box,
// or -1 as soon as one is not. Walking the control-flow spine mirrors
// iife_arms_hold_fn_value; the difference is what it asks of each arm value.
function iife_stmts_all_boxed(stmts: ast.Stmt[], s: LowerState, seen: i32): i32 {
    var n: i32 = seen;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (!expr_is_closure_box(r.value, s)) { return 0 - 1; }
                n = n + 1;
            },
            ast.StmtIf(iff) => {
                n = iife_stmts_all_boxed(iff.then_body, s, n);
                if (n < 0) { return 0 - 1; }
                n = iife_stmts_all_boxed(iff.else_body, s, n);
                if (n < 0) { return 0 - 1; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    n = iife_stmts_all_boxed(mm.arms[a].body, s, n);
                    if (n < 0) { return 0 - 1; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return n;
}

// arr_elem_is_closure_box reports whether an array literal's element is a
// closure BOX rather than a raw fn pointer: an inline lambda, a call to a
// closure-returning fn, a `__mkclo$<name>(caps…)` env-box marker
// (lift_inline_closures, #2994), or a closure-LOCAL ident (#5405). A bare
// named-fn element answers false, which is what keeps the #3574 fn-pointer-array
// classification. Read of element[0]: all elements of a closure array share one
// dispatch ABI (#5071 gives a mixed literal uniform boxes).
function arr_elem_is_closure_box(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprCall(cec) => {
            match (cec.callee) {
                ast.ExprIdent(cecid) => {
                    if (util.index_of_str(s.sigs.closure_fns, cecid.name) >= 0) { return true; }
                    if (cecid.name.len() > 8 && slice_unchecked(cecid.name, 0, 8) == "__mkclo$") { return true; }
                    // A generic passthrough hands its argument back unchanged, so
                    // the call is a box exactly when that argument is one.
                    var pa: i32 = 0;
                    while (pa < cec.args.len()) {
                        if (util.index_of_str(s.sigs.closure_fns, "PASSTHRU:" + cecid.name + ":" + util.i32_to_string(pa)) >= 0
                                && arr_elem_is_closure_box(cec.args[pa], s)) { return true; }
                        pa = pa + 1;
                    }
                    return false;
                },
                // A value-position if/match ELEMENT whose arms the lift boxed
                // (#6256): the element yields a box, so the array holding it is
                // a closure array like any other.
                ast.ExprLambda(_) => { return cec.args.len() == 0 && iife_callee_boxed_arms(cec.callee, s); },
                _ => { return false; }
            }
        },
        ast.ExprIdent(ceid) => { return s.is_closure_local(ceid.name); },
        _ => { return false; }
    }
    return false;
}

// iife_callee_closurearr_arms is iife_callee_boxed_arms one container out: every
// arm of the value-position if/match yields a closure ARRAY, so the binding is
// one too. Same walk, different question of each arm value.
function iife_callee_closurearr_arms(callee: ast.Expr, s: LowerState): boolean {
    match (callee) {
        ast.ExprLambda(lam) => {
            if (lam.params.len() != 0) { return false; }
            var seen: i32 = 0;
            return iife_stmts_all_closurearr(lam.body, s, seen) > 0;
        },
        _ => { return false; }
    }
    return false;
}

function iife_stmts_all_closurearr(stmts: ast.Stmt[], s: LowerState, seen: i32): i32 {
    var n: i32 = seen;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (!expr_is_closure_array(r.value, s)) { return 0 - 1; }
                n = n + 1;
            },
            ast.StmtIf(iff) => {
                n = iife_stmts_all_closurearr(iff.then_body, s, n);
                if (n < 0) { return 0 - 1; }
                n = iife_stmts_all_closurearr(iff.else_body, s, n);
                if (n < 0) { return 0 - 1; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    n = iife_stmts_all_closurearr(mm.arms[a].body, s, n);
                    if (n < 0) { return 0 - 1; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return n;
}

// expr_is_closure_array reports whether an arm value yields an array of closure
// boxes: an array LITERAL with a boxed element, a call to a closurearr-returning
// fn, or a nested value-position if/match whose own arms all are.
function expr_is_closure_array(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return arr_elem_is_closure_box(arr.elements[0], s);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (s.is_closurearr_ret_fn(cid.name)) { return true; }
                    // A generic passthrough hands its erased-generic argument
                    // straight back, so `id([<closure>, …])` yields the array it
                    // was given. Without this the arm reads as a plain fn-pointer
                    // array and the binding bare-dispatches a box.
                    var pi: i32 = 0;
                    while (pi < c.args.len()) {
                        if (util.index_of_str(s.sigs.closure_fns, "PASSTHRU:" + cid.name + ":" + util.i32_to_string(pi)) >= 0
                                && expr_is_closure_array(c.args[pi], s)) { return true; }
                        pi = pi + 1;
                    }
                    return false;
                },
                ast.ExprLambda(_) => { return c.args.len() == 0 && iife_callee_closurearr_arms(c.callee, s); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_closure_box reports whether a value is already a closure box: a
// closure LOCAL (the `v0` alias shape), a `__mkclo$…` env-box marker the lift
// pass produced, a call of a closure-RETURNING function (closure_fns, which the
// hoisted `<fd>$iifeN` value-position desugar joins), or a nested value-position
// if/match whose own arms are all boxed. Anything else — a bare fn name, a
// scalar-returning call, a literal — answers false.
function expr_is_closure_box(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprIdent(id) => { return s.is_closure_local(id.name); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") { return true; }
                    return util.index_of_str(s.sigs.closure_fns, cid.name) >= 0;
                },
                ast.ExprLambda(_) => { return c.args.len() == 0 && iife_callee_boxed_arms(c.callee, s); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// ---- fn-valued arms of a value-position if / match (#6256, #7438) ----------
//
// A value-position `if` / `match` parses as an IIFE — `ExprCall{callee:
// ExprLambda{params: [], body: [StmtIf|StmtMatch]}}`. Left alone, its arms are
// STATEMENTS inside an expression, so no closure-lift pass reaches them: a
// fn-valued arm reached lower_expr as a bare ExprLambda and asked for a
// `<cur_fn>$clo` nothing had built (a module bail), and a no-capture one was
// worse — lift_call_arg hoisted it to a bare `__lam_N` fn POINTER while the
// destination dispatched the result env-first as a box, so the call loaded a
// "box slot 0" out of a function's first code bytes and jumped through it.
//
// So the IIFE is hoisted to a real top-level function taking its captures as
// ORDINARY PARAMETERS. An IIFE is applied immediately, so its captures need no
// env box — by-value params carry them, which also lifts the i64/u64/f64
// restriction the env box imposes (cap_slot_ok rejects a wide scalar; a param
// does not). The call site becomes `<fd>$iifeN(caps…)`, an ordinary direct call
// returning a fn value — the shape a local binding and a `return` already
// dispatch env-first, which is what makes the RESULT usable and not just the
// arms well-formed. Boxing the arms alone left the destination unmarked and
// turned a bail into a SIGSEGV.
//
// The hoist runs whether or not the IIFE captures. A no-capture one becoming a
// `__lam_N` FuncDecl is NOT equivalent: the worklist drain deliberately withholds
// the `return <lambda>` desugar from lifted bodies (#5281, the curry shape), which
// is the very rewrite that turns an arm lambda into a boxed closure local — so the
// arm stayed a bare pointer (#7438). hoist_value_iife applies that desugar itself.
//
// Gated on the IIFE holding a fn-VALUED arm; everything else keeps its path.
// iife_arms_have_lambda reports whether any arm of a value-position if/match
// yields an inline LAMBDA — directly, or through a generic passthrough call that
// hands it back unchanged — which is the only thing the hoist is needed for.
//
// The two halves of #6256 must not both fire on the same IIFE. An IIFE whose
// arms are all already-boxed fn values (closure locals) needs no hoist at all:
// #6323's clo_init marking recognises the IIFE init directly and binds the
// destination as a closure local. Hoisting it would REPLACE the IIFE with an
// ordinary call, so that marking no longer matches — measured, it turned three
// green shapes back into SIGSEGVs. A lambda arm is different: nothing has boxed
// it yet, so it needs to become a FuncDecl for the ordinary passes to reach.
//
// So the hoist takes the lambda-arm case and #6323 takes the boxed-arm case,
// and a MIXED IIFE (Repro D — one closure-local arm, one lambda) hoists,
// because the lambda is the binding constraint.
function iife_arms_have_lambda(stmts: ast.Stmt[], mfuncs: MFuncs): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (passthrough_arg_has_lambda(r.value, mfuncs)) { return true; }
            },
            ast.StmtIf(iff) => {
                if (iife_arms_have_lambda(iff.then_body, mfuncs)) { return true; }
                if (iife_arms_have_lambda(iff.else_body, mfuncs)) { return true; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    if (iife_arms_have_lambda(mm.arms[a].body, mfuncs)) { return true; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return false;
}

// passthrough_arg_has_lambda reports whether `e` is a raw lambda, directly or at
// the erased-generic parameter of a passthrough call that hands it straight back
// (`pick(c, v0, <lambda>)`). Nothing has boxed such a lambda, and the expression
// walk stops at the IIFE that holds it, so only the hoist puts it where the
// ordinary passes can reach it.
//
// An arm that is ITSELF a value-position if/match holds its lambdas one level
// in, and the walk stops at that nested IIFE for the same reason it stops at the
// outer one, so the question recurses through it.
function passthrough_arg_has_lambda(e: ast.Expr, mfuncs: MFuncs): boolean {
    match (e) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
                                && passthrough_arg_has_lambda(c.args[i], mfuncs)) { return true; }
                        i = i + 1;
                    }
                },
                ast.ExprLambda(il) => {
                    if (c.args.len() == 0 && il.params.len() == 0) { return iife_arms_have_lambda(il.body, mfuncs); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

function iife_arms_hold_fn_value(stmts: ast.Stmt[], fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (lift_arg_is_fn_value(r.value, mfuncs)) { return true; }
                // A fn-typed LOCAL or PARAM arm (`(if (c) { v0 } else { … })`)
                // is a fn value too, but lift_arg_is_fn_value declines it — that
                // predicate answers "is this worth env-boxing?", and an already-
                // boxed local is not. Here the question is "does this arm yield a
                // fn?", so the declared type answers it.
                match (r.value) {
                    ast.ExprIdent(aid) => { if (cap_type(aid.name, fd, structs, mfuncs) == "fn") { return true; } },
                    // A nested value-position if/match arm yields whatever its own
                    // arms yield, so the question descends into it.
                    ast.ExprCall(rc) => {
                        match (rc.callee) {
                            ast.ExprLambda(ril) => {
                                if (rc.args.len() == 0 && ril.params.len() == 0
                                        && iife_arms_hold_fn_value(ril.body, fd, structs, mfuncs)) { return true; }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(iff) => {
                if (iife_arms_hold_fn_value(iff.then_body, fd, structs, mfuncs)) { return true; }
                if (iife_arms_hold_fn_value(iff.else_body, fd, structs, mfuncs)) { return true; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    if (iife_arms_hold_fn_value(mm.arms[a].body, fd, structs, mfuncs)) { return true; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return false;
}

// iife_arms_are_arrays_with_boxed_elem reports whether EVERY arm of a
// value-position if/match returns an array LITERAL and at least one of those
// arrays holds an env-boxed element. It is the gate on rewriting the arms into
// uniform env boxes: below the "every arm" half the binding would carry two
// dispatch ABIs, and without the "some box" half there is nothing to fix.
//
// The element question is array_elem_is_env_boxed — the SAME one #5071's
// single-literal rule asks — so the two cannot disagree about whether the
// binding is on the env-first ABI. Asking a narrower question here (only
// whether an arm lambda CAPTURES) left `(if (c) { [<lambda>] } else {
// [(match … => <lambda>)] })` with a raw fn-pointer array down one arm and a
// box array down the other: the single-literal rule boxes an IIFE element for
// either kind of arm lambda, so the sibling had to box too (#8151).
//
// Captures read against iife_scope_fd, so a name the IIFE ITSELF binds — a
// match arm's payload — counts. Against the enclosing function alone an arm
// lambda reading `Ok(a) => [(x) => x + a]` looks capture-free, the gate answers
// 0, and the lambda stays raw for a `<fd>$clo` nobody built.
function iife_arms_are_arrays_with_boxed_elem(stmts: ast.Stmt[], fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs): boolean {
    var seen: i32 = iife_arm_arrays_boxed_elems(stmts, iife_scope_fd(fd, stmts), 0, structs, mfuncs);
    return seen > 0;
}

// Returns the number of env-boxed elements found, or -1 as soon as an arm
// returns something that is neither an array literal nor a nested value-position
// if/match whose own arms satisfy the same test.
function iife_arm_arrays_boxed_elems(stmts: ast.Stmt[], fd: parser.FuncDecl, seen: i32, structs: parser.StructDecl[], mfuncs: MFuncs): i32 {
    var n: i32 = seen;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprArray(arr) => {
                        var e: i32 = 0;
                        while (e < arr.elements.len()) {
                            if (array_elem_is_env_boxed(arr.elements[e], fd, structs, mfuncs)) { n = n + 1; }
                            e = e + 1;
                        }
                    },
                    // A nested value-position if/match is the same construct one
                    // level in: its own arms hold the arrays. The spine walk below
                    // reaches a nested if/match written as a STATEMENT; an arm that
                    // is an EXPRESSION carries the identical shape as an IIFE.
                    ast.ExprCall(rc) => {
                        match (rc.callee) {
                            ast.ExprLambda(ril) => {
                                if (rc.args.len() != 0 || ril.params.len() != 0) { return 0 - 1; }
                                n = iife_arm_arrays_boxed_elems(ril.body, iife_scope_fd(fd, ril.body), n, structs, mfuncs);
                                if (n < 0) { return 0 - 1; }
                            },
                            // `id([<lambda>, …])` — a generic passthrough hands the
                            // array straight back, so the arm yields the literal one
                            // level in and its elements count like any other arm's.
                            ast.ExprIdent(rcid) => {
                                var pl: ast.Expr[] = passthrough_array_literal(r.value, mfuncs);
                                if (pl.len() == 0) { return 0 - 1; }
                                match (pl[0]) {
                                    ast.ExprArray(parr) => {
                                        var pe: i32 = 0;
                                        while (pe < parr.elements.len()) {
                                            if (array_elem_is_env_boxed(parr.elements[pe], fd, structs, mfuncs)) { n = n + 1; }
                                            pe = pe + 1;
                                        }
                                    },
                                    _ => { return 0 - 1; }
                                }
                            },
                            _ => { return 0 - 1; }
                        }
                    },
                    _ => { return 0 - 1; }
                }
            },
            ast.StmtIf(iff) => {
                n = iife_arm_arrays_boxed_elems(iff.then_body, fd, n, structs, mfuncs);
                if (n < 0) { return 0 - 1; }
                n = iife_arm_arrays_boxed_elems(iff.else_body, fd, n, structs, mfuncs);
                if (n < 0) { return 0 - 1; }
            },
            ast.StmtMatch(mm) => {
                var a: i32 = 0;
                while (a < mm.arms.len()) {
                    n = iife_arm_arrays_boxed_elems(mm.arms[a].body, fd, n, structs, mfuncs);
                    if (n < 0) { return 0 - 1; }
                    a = a + 1;
                }
            },
            _ => {}
        }
    }
    return n;
}

// box_iife_arm_array_elems rewrites every element of every arm's array literal
// through try_fn_field_value — a capturing lambda becomes a `__mkclo$<fd>$cloN`
// env box, a no-capture lambda / bare fn name a `$wrapN` trampoline box, an
// already-boxed value flows through. Same uniform-box treatment #5071 gives one
// mixed array literal, applied across the arms because they share a binding.
function box_iife_arm_array_elems(stmts: ast.Stmt[], fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): (ast.Stmt[], InlineCloAcc) {
    function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
        match (s) {
            ast.StmtReturn(r) => {
                var fs: parser.FuncDecl[] = a.funcs;
                var ct: i32 = a.counter;
                var nv: ast.Expr = r.value;
                match (r.value) {
                    ast.ExprArray(arr) => {
                        var nelems: ast.Expr[] = [];
                        var e: i32 = 0;
                        while (e < arr.elements.len()) {
                            var er: InlineCloRes = try_fn_field_value(arr.elements[e], fd, fs, ct, gfns, mfuncs, structs);
                            fs = er.funcs; ct = er.counter; nelems = nelems.append(er.expr);
                            e = e + 1;
                        }
                        nv = ast.ExprArray { ...arr, elements: nelems };
                    },
                    // A nested value-position if/match arm: box the arrays its own
                    // arms return, matching the gate's recursion through the same
                    // shape (iife_arm_arrays_boxed_elems).
                    ast.ExprCall(rc) => {
                        match (rc.callee) {
                            ast.ExprLambda(ril) => {
                                if (rc.args.len() == 0 && ril.params.len() == 0) {
                                    var (nbs, nba) = box_iife_arm_array_elems(ril.body, iife_scope_fd(fd, ril.body), fs, ct, gfns, structs, mfuncs);
                                    fs = nba.funcs; ct = nba.counter;
                                    var nlam: ast.Expr = ast.ExprLambda { ...ril, body: nbs };
                                    nv = ast.ExprCall { callee: nlam, args: rc.args, line: rc.line, col: rc.col, type_argc: rc.type_argc, ty: rc.ty };
                                }
                            },
                            // The array a passthrough forwards: box its elements
                            // where they sit, so the call still hands back the same
                            // literal and the arms stay uniform.
                            ast.ExprIdent(_) => {
                                var pl2: ast.Expr[] = passthrough_array_literal(r.value, mfuncs);
                                if (pl2.len() > 0) {
                                    match (pl2[0]) {
                                        ast.ExprArray(parr2) => {
                                            var pnel: ast.Expr[] = [];
                                            var pj: i32 = 0;
                                            while (pj < parr2.elements.len()) {
                                                var per: InlineCloRes = try_fn_field_value(parr2.elements[pj], fd, fs, ct, gfns, mfuncs, structs);
                                                fs = per.funcs; ct = per.counter; pnel = pnel.append(per.expr);
                                                pj = pj + 1;
                                            }
                                            nv = passthrough_rebuilt_with(r.value, ast.ExprArray { ...parr2, elements: pnel }, mfuncs);
                                        },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
                return (ast.StmtReturn { value: nv, line: r.line, col: r.col }, InlineCloAcc { funcs: fs, counter: ct }, true);
            },
            ast.StmtIf(_) => { return (s, a, false); },
            ast.StmtMatch(_) => { return (s, a, false); },
            ast.StmtVar(_) => { return (s, a, true); },
            ast.StmtExpr(_) => { return (s, a, true); },
            ast.StmtAssign(_) => { return (s, a, true); },
            ast.StmtWhile(_) => { return (s, a, true); },
            ast.StmtFor(_) => { return (s, a, true); },
            ast.StmtDefer(_) => { return (s, a, true); },
            ast.StmtBreak(_) => { return (s, a, false); },
            ast.StmtContinue(_) => { return (s, a, false); },
            ast.StmtUnknown(_) => { return (s, a, false); }
        }
        return (s, a, true);
    }
    return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ilc_keep_expr);
}

// hoist_value_iife builds `<fd>$iifeN(caps…)` from the IIFE lambda and
// returns the direct call that replaces it. Declines — signalled by returning
// the counter unchanged — when any capture's type does not resolve, leaving the
// IIFE exactly as it was so the module bails as before. A capture-free IIFE
// hoists to a zero-parameter `<fd>$iifeN()`.
function hoist_value_iife(lam: ast.ExprLambda, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, structs: parser.StructDecl[], mfuncs: MFuncs): InlineCloRes {
    var caps: string[] = lambda_captures(lam, fd);
    var ps: ast.ParamDecl[] = [];
    var args: ast.Expr[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) {
        // cap_param_for carries a fn-TYPED capture through with its signature
        // intact (#6324) — copied from the ParamDecl when the capture is a
        // param, reconstructed from the lambda when it is a local bound from
        // one. It declines (empty type_name) when the signature is unrecoverable,
        // which leaves the module bailing exactly as it does today rather than
        // trading a refusal for a silent miscompile.
        var cp: ast.ParamDecl = cap_param_for(caps[ci], fd, structs, mfuncs);
        if (cp.type_name.len() == 0) { return InlineCloRes { expr: ast.ExprLambda { ...lam, body: lam.body }, funcs: funcs, counter: counter }; }
        ps = ps.append(cp);
        args = args.append(ast.ExprIdent { name: caps[ci], line: 0, col: 0, ty: "" });
        ci = ci + 1;
    }
    var nm: string = clo_owner_name(fd) + "$iife" + util.i32_to_string(counter);
    var notp: string[] = [];
    // Declared `fn` return, not the IIFE lambda's own ret_type. The hoist only
    // fires when the arms yield a fn value, so this function IS a higher-order
    // factory, and closure_ret_fns_of's "return <ident bound to a closure>" form
    // is gated on exactly that declaration. Without it a MIXED IIFE (one closure-
    // local arm, one lambda) hoisted to a call the caller then bound as a plain
    // scalar — `w(3)` bare-dispatched the box and SIGSEGV'd, turning a bail into
    // a crash. The coarse "fn" tag is what a hand-written fn-returning function
    // carries, so this is the same declaration, not a special case.
    // The arms are USER code, so they get the same `return <lambda>` desugar the
    // worklist gives a source function (`var $lamret$N = <lambda>; return
    // $lamret$N;`) — a BRANCH-position returned lambda is out of reach of
    // hoist_escaping_closure, which only claims a body whose LAST statement is
    // the return, so the arm lambda kept asking for a `<nm>$clo` nothing built.
    // Through the local binding it lifts to a uniquely-named `<nm>$cloN` box
    // instead, one per arm. The lifted `__lam_N` / `$cloN` bodies drained onto
    // the worklist do NOT get this (#5281), which is why it is applied here
    // rather than at the drain.
    var dlr: DesugarRet = desugar_lambda_returns(lam.body, 0);
    var nf: parser.FuncDecl = parser.FuncDecl { name: nm, receiver_name: "", receiver_type: "", type_params: notp, params: ps, ret_type: "fn", body: dlr.body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, ret_slice: false, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "" };
    var ncall: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: nm, line: 0, col: 0, ty: "" }, args: args, line: 0, col: 0, type_argc: 0, ty: "" };
    return InlineCloRes { expr: ncall, funcs: funcs.append(nf), counter: counter + 1 };
}

// lift_inline_closures_expr walks an expression, hoisting capturing inline
// lambdas in array-element and struct-field-value positions, AND wrapping
// fn-typed CALL ARGUMENTS into uniform env boxes (slice #3445 follow-up). A call
// `g(a0, a1, …)` whose callee `g` has a fn-typed param at position i has its
// argument ai routed through try_fn_field_value — the SAME env-box wrapper the
// struct-field path uses: a capturing inline lambda → `__mkclo$<fd>$cloN(caps…)`
// box [funcval, caps…]; a no-capture lambda / bare module-fn-name → a `$wrapN`
// env-ignoring trampoline → box [funcval]; an already-boxed value (a boxed
// fn-value local ident, a closure param/local, a `mk()` call returning a
// closure) flows UNWRAPPED. This makes EVERY fn-value argument an env box so the
// callee's fn-typed param (marked a closure local in lower_func) dispatches it
// env-first. Running BEFORE the no-capture __lam_N lift means a no-capture
// lambda / fn-name arg becomes a `__mkclo$…` marker the later lift leaves alone,
// so the two arg representations never fight — there is one fn-arg shape, the box.
// Non-aggregate forms recurse so an array/struct nested inside them is still
// reached; a bare lambda in any other position is left untouched (handled by the
// other lift passes or kept on AST).
//
// ilc_expr_at is that walk's visitor on astwalk's rewrite spine
// (lift_inline_closures_expr wraps it): parent-directed dispatch is
// irreducible policy, so the aggregate arms (call / array / tuple / struct
// literal) claim their whole subtree and rebuild the child slots themselves,
// in the hand order, re-entering the walk through lift_inline_closures_expr
// for exactly the slots the walk owns. ExprLambda / ExprSlice / ExprMapLit /
// ExprFString are claimed UNCHANGED: this pass has never descended into them,
// and a wider walk would box lambdas in positions the lift has never reached.
// Everything else declines and the spine carries the recursion.
function ilc_expr_at(e: ast.Expr, acc: InlineCloAcc, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): (ast.Expr, InlineCloAcc, boolean) {
    match (e) {
        ast.ExprCall(call) => {
            // Wrap each fn-typed-param argument into an env box; recurse the rest
            // (so a nested aggregate / fn-arg call inside a non-fn argument is
            // still reached). A bare-ident callee names the function whose param
            // types we consult; a `__mkclo$…` marker callee (this pass's own
            // output) has no fn-typed-param signature, so its args just recurse.
            var cnm: string = "";
            // A METHOD callee `recv.m(args)` (FieldAccess, non-numeric field):
            // wrap an inline-lambda argument stored into a Map value slot
            // (`m.set(1, <lambda>)`) into the env box, so a `Map[K, () => V]`
            // closure value is stored as a box the retrieval-side match-binding
            // (#3466) dispatches env-first (slice #3445 map-values). The wrap
            // decision (lift_method_arg_is_fn) fires only for a lambda whose method
            // param is NOT a declared user fn-param — a map value lowers to the
            // builtin op_map_set with a generic `V` param, whereas a user method's
            // declared fn-param keeps its existing bare-dispatch / AST-bail path
            // (env-box-unifying those would break the byte-identical fixpoint). A
            // numeric field (`t.0(args)`, a fn-valued tuple element call) is left
            // to its own path. #3445.
            var mfield: string = "";
            match (call.callee) {
                ast.ExprIdent(cid) => { cnm = cid.name; },
                ast.ExprFieldAccess(cfa) => { if (!util.is_all_digits(cfa.field)) { mfield = cfa.field; } },
                _ => {}
            }
            var is_mkclo: boolean = cnm.len() > 8 && slice_unchecked(cnm, 0, 8) == "__mkclo$";
            // A single-arg Option/Result variant constructor `Some(f)` / `Ok(f)`
            // / `Err(f)` whose payload is a fn-VALUE (slice #3445 match-fn): wrap
            // that payload into the uniform env box the SAME way a fn-typed
            // struct-field / call-arg is wrapped, so when the match arm binds the
            // payload (`Some(f) => f()`) it dispatches env-first against a real
            // box. A non-fn-value payload is left untouched (lift_arg_is_fn_value
            // declines it). The wrap only fires for exactly one argument; multi-
            // arg shapes (none of Some/Ok/Err take >1) fall through.
            var is_optvar: boolean = (cnm == "Some" || cnm == "Ok" || cnm == "Err") && call.args.len() == 1;
            var fs: parser.FuncDecl[] = acc.funcs;
            var ct: i32 = acc.counter;
            var nargs: ast.Expr[] = [];
            var ai: i32 = 0;
            while (ai < call.args.len()) {
                if (is_optvar && lift_arg_is_fn_value(call.args[ai], mfuncs)) {
                    var ofr: InlineCloRes = try_fn_field_value(call.args[ai], fd, fs, ct, gfns, mfuncs, structs);
                    fs = ofr.funcs; ct = ofr.counter; nargs = nargs.append(ofr.expr);
                } else if (!is_mkclo && cnm.len() > 0 && decl_is_struct(structs, cnm)
                           && decl_field_type_at(structs, cnm, ai) == "fn"
                           && lift_arg_is_fn_value_declared(call.args[ai], mfuncs)) {
                    // A USER-ENUM variant constructor (`Wrap(f)`, `Pending(n, k)`)
                    // whose field at position ai is fn-typed: wrap the fn-value
                    // payload into the uniform env box — exactly like the
                    // Option/Result is_optvar path above — so a capturing
                    // closure becomes a real box the slice-5 match-arm bind
                    // (mark_closure_local) dispatches env-first against. Without
                    // this, a capturing-lambda payload stayed raw and bailed the
                    // module to AST (slice 5b; bare/non-capturing already worked).
                    var vfr: InlineCloRes = try_fn_field_value(call.args[ai], fd, fs, ct, gfns, mfuncs, structs);
                    fs = vfr.funcs; ct = vfr.counter; nargs = nargs.append(vfr.expr);
                } else if (!is_mkclo && cnm.len() > 0 && (lift_callee_param_is_fn(mfuncs, cnm, ai) || lift_local_fn_param_is_fn(fd, cnm, ai))) {
                    var fr: InlineCloRes = try_fn_field_value(call.args[ai], fd, fs, ct, gfns, mfuncs, structs);
                    fs = fr.funcs; ct = fr.counter; nargs = nargs.append(fr.expr);
                } else if (!is_mkclo && cnm.len() > 0 && expr_is_array_lit(call.args[ai])
                           && lift_callee_param_is_fnarr(mfuncs, cnm, ai)
                           && fnarr_param_forces_boxes(mfuncs, structs, cnm, ai)) {
                    // An fn-ARRAY argument at a parameter another call site has
                    // already committed to env boxes (#8090). The parameter gets
                    // ONE dispatch ABI, so this literal boxes too — the array
                    // sibling of the scalar fn-value rule above, and the same
                    // uniform treatment #5071 gives one literal, one container out.
                    var bxr: BoxedArrayRes = box_array_lit_elems(call.args[ai], fd, fs, ct, gfns, mfuncs, structs);
                    fs = bxr.funcs; ct = bxr.counter; nargs = nargs.append(bxr.expr);
                } else if (!is_mkclo && cnm.len() > 0 && lift_callee_is_typevar_passthrough(mfuncs, cnm, ai)
                           && lift_arg_is_fn_value(call.args[ai], mfuncs)) {
                    // A fn value at an ERASED-GENERIC parameter (`id(<lambda>)`).
                    // The declared parameter reads `T`, so the fn-typed gate above
                    // cannot see it; box it here like every other fn-value argument
                    // position. The binding the result lands in is marked a closure
                    // local by lower_stmt_var's `__mkclo$`-argument rule, so the
                    // box the passthrough returns is dispatched as one rather than
                    // bare-called (#6466 records what that costs when it is not).
                    var gr: InlineCloRes = try_fn_field_value(call.args[ai], fd, fs, ct, gfns, mfuncs, structs);
                    fs = gr.funcs; ct = gr.counter; nargs = nargs.append(gr.expr);
                } else if (mfield.len() > 0 && (lift_callee_param_is_fn(mfuncs, mfield, ai)
                           || lift_method_arg_is_fn(call.args[ai], mfield, ai, mfuncs)
                           || lift_arr_store_arg_is_fn_name(call.args[ai], mfield, ai, fd, mfuncs))) {
                    // Method-call fn-value argument (`m.set(1, <lambda>)`): wrap into
                    // the env box so the stored / called value is a uniform box. #3445.
                    var mr: InlineCloRes = try_fn_field_value(call.args[ai], fd, fs, ct, gfns, mfuncs, structs);
                    fs = mr.funcs; ct = mr.counter; nargs = nargs.append(mr.expr);
                } else {
                    var er: InlineCloRes = lift_inline_closures_expr(call.args[ai], fd, fs, ct, gfns, structs, mfuncs);
                    fs = er.funcs; ct = er.counter; nargs = nargs.append(er.expr);
                }
                ai = ai + 1;
            }
            // Recurse into a NON-IDENT callee — a method callee `recv.m(args)`
            // whose receiver `recv` is itself an expression. Without this, a
            // fn-arg-taking call in RECEIVER position (`take_while(c, lt5).len()`)
            // was never reached: its fn-typed argument stayed a raw const_func
            // while the callee's fn param (marked a closure local in lower_func)
            // dispatched it env-first — loading a "box slot 0" from a bare code
            // pointer and jumping to garbage (SIGSEGV, #4767). Binding the call
            // to a var first dodged it only because a var-init IS walked. An
            // ident callee is left alone: a bare callee NAME is a call target,
            // not a fn VALUE use (mirrors value_use_idents_expr).
            var ncallee: ast.Expr = call.callee;
            match (call.callee) {
                ast.ExprIdent(_) => {},
                ast.ExprLambda(ielam) => {
                    // An IIFE holding a fn-valued arm — the value-position
                    // if/match desugar — leaves its arms where no lift walks them
                    // and its destination unmarked (#6256). Hoist it into a real
                    // function taking its captures as params; the call that
                    // replaces it is an ordinary fn-value-returning call both a
                    // binding and a return already handle.
                    if (call.args.len() == 0 && ielam.params.len() == 0
                        && iife_arms_have_lambda(ielam.body, mfuncs)
                        && iife_arms_hold_fn_value(ielam.body, fd, structs, mfuncs)) {
                        var iar: InlineCloRes = hoist_value_iife(ielam, fd, fs, ct, structs, mfuncs);
                        if (iar.counter > ct) {
                            fs = iar.funcs; ct = iar.counter;
                            return (iar.expr, InlineCloAcc { funcs: fs, counter: ct }, true);
                        }
                    }
                    // An IIFE the hoist does not claim keeps its arms inline, and
                    // this is the only place they are reachable: the arms are
                    // STATEMENTS inside an expression, so the expression walk
                    // stops here. A capturing lambda in an arm's ARRAY literal
                    // therefore never got its `__mkclo$<fd>$cloN` marker and asked
                    // for a `<fd>$clo` nothing built.
                    //
                    // Boxing that one element is not enough, and the two extra
                    // requirements are why this is gated on EVERY arm being an
                    // array literal rather than done element by element. The
                    // binding gets ONE dispatch ABI, so a sibling arm whose array
                    // holds a raw fn pointer (a no-capture lambda the later lift
                    // hoists to `__lam_N`) would be env-first-dispatched as a box —
                    // #5071's problem, one container out. And the DESTINATION has
                    // to read as a closure array (expr_is_closure_array below),
                    // which it only can when every arm answers the same way.
                    // Anything else is left to bail exactly as before.
                    if (call.args.len() == 0 && ielam.params.len() == 0
                        && iife_arms_are_arrays_with_boxed_elem(ielam.body, fd, structs, mfuncs)) {
                        var (ibrs, ibra) = box_iife_arm_array_elems(ielam.body, iife_scope_fd(fd, ielam.body), fs, ct, gfns, structs, mfuncs);
                        if (ibra.counter > ct) {
                            fs = ibra.funcs; ct = ibra.counter;
                            ncallee = ast.ExprLambda { ...ielam, body: ibrs };
                        }
                    }
                    // The arms' own CONDITION is the one part of an inline IIFE
                    // nothing above reaches (#6571): both paths walk what the arms
                    // RETURN, neither walks what selects them. Runs on whichever
                    // body the boxing above settled on, so the two compose rather
                    // than racing for the same node.
                    if (call.args.len() == 0 && ielam.params.len() == 0) {
                        var iebody: ast.Stmt[] = ielam.body;
                        if let ast.ExprLambda(nl) = ncallee { iebody = nl.body; }
                        var (icrs, icra) = lift_iife_conditions(iebody, fd, fs, ct, gfns, mfuncs, structs);
                        if (icra.counter > ct) {
                            fs = icra.funcs; ct = icra.counter;
                            ncallee = ast.ExprLambda { ...ielam, body: icrs };
                        }
                    }
                    // An arm whose value is an ORDINARY expression is claimed by
                    // none of the paths above, so nothing ever put it through the
                    // expression lift at all — see lift_iife_arm_values. Gated on
                    // the fn-value paths NOT owning the arms, so no value is
                    // walked twice.
                    if (call.args.len() == 0 && ielam.params.len() == 0
                            && !iife_arms_hold_fn_value(ielam.body, fd, structs, mfuncs)) {
                        var avbody: ast.Stmt[] = ielam.body;
                        if let ast.ExprLambda(nl2) = ncallee { avbody = nl2.body; }
                        var (avs, ava) = lift_iife_arm_values(avbody, fd, fs, ct, gfns, mfuncs, structs);
                        if (ava.counter > ct) {
                            fs = ava.funcs; ct = ava.counter;
                            ncallee = ast.ExprLambda { ...ielam, body: avs };
                        }
                    }
                },
                _ => {
                    var cr: InlineCloRes = lift_inline_closures_expr(call.callee, fd, fs, ct, gfns, structs, mfuncs);
                    fs = cr.funcs; ct = cr.counter; ncallee = cr.expr;
                }
            }
            return (ast.ExprCall { callee: ncallee, args: nargs, line: call.line, col: call.col, type_argc: call.type_argc, ty: call.ty }, InlineCloAcc { funcs: fs, counter: ct }, true);
        },
        ast.ExprArray(arr) => {
            var fs: parser.FuncDecl[] = acc.funcs;
            var ct: i32 = acc.counter;
            var nelems: ast.Expr[] = [];
            // #5071: a closure-array literal that MIXES capturing and
            // non-capturing lambdas must give every lambda element the SAME
            // env-first box representation. The array gets ONE dispatch ABI
            // (env-first, because a capturing element marks it a closure array
            // via the `__mkclo$` element[0] check), so a non-capturing element
            // left as a bare fn pointer is deref'd as a box → SIGSEGV. When any
            // element is a capturing lambda, wrap EVERY lambda element via
            // try_fn_field_value (capturing → [funcval, caps…]; no-capture → a
            // `$wrap` env-taking trampoline → [funcval]) so all elements are
            // env boxes — the same uniform-env-box treatment the tuple /
            // struct-field cases already apply. An all-non-capturing lambda
            // array (no capturing element) keeps the bare fn-pointer + plain-
            // dispatch representation unchanged.
            // An ELEMENT that is a value-position if/match counts too (#6256):
            // its arms hold the lambdas, and hoist_value_iife turns any such
            // IIFE into a call yielding a box — capturing or not — so the array
            // holding it is on the env-first ABI exactly as a direct capturing
            // element puts it there. The gate is the hoist's own, so the two
            // cannot disagree about the representation (#7438).
            var has_cap_lam: boolean = false;
            var sc: i32 = 0;
            while (sc < arr.elements.len()) {
                if (array_elem_is_env_boxed(arr.elements[sc], fd, structs, mfuncs)) { has_cap_lam = true; }
                sc = sc + 1;
            }
            // Bound names in this function's scope (params + body binders): a
            // bare fn-name ELEMENT is only an unshadowed module fn when it names
            // no local/param — mirrors the tuple case's `tbound`. Needed only
            // for a literal the uniformity rule can reach at all.
            var afnval: boolean = array_holds_fn_value(arr, mfuncs);
            var abound: string[] = [];
            if (has_cap_lam || afnval) { abound = fd_bound_names(fd); }
            // #6555: a sibling `return` of this function yields a boxed fn
            // array, so this literal boxes too — the returns share the caller's
            // binding and a binding gets one dispatch ABI. A `.with`/`.append`
            // storing a fn value into an array forces the same promotion, one
            // container further out again: the store boxes its value, and the
            // array it clones is this literal.
            if (!has_cap_lam && afnval
                    && (fd_returns_boxed_fn_array(fd, structs, mfuncs) || fd_stores_fn_value_array(fd, mfuncs, abound)
                        || fd_passes_fn_array_elem(fd, mfuncs))) {
                has_cap_lam = true;
            }
            var i: i32 = 0;
            while (i < arr.elements.len()) {
                var awrapped: boolean = false;
                match (arr.elements[i]) {
                    ast.ExprLambda(lam) => {
                        if (has_cap_lam) {
                            // Uniform env-box: capturing lambdas box as before,
                            // no-capture lambdas get a `$wrap` env trampoline.
                            var trw: InlineCloRes = try_fn_field_value(arr.elements[i], fd, fs, ct, gfns, mfuncs, structs);
                            fs = trw.funcs; ct = trw.counter; nelems = nelems.append(trw.expr);
                        } else {
                            var tr: InlineCloRes = try_inline_closure(lam, fd, fs, ct, gfns, structs, mfuncs);
                            fs = tr.funcs; ct = tr.counter; nelems = nelems.append(tr.expr);
                        }
                        awrapped = true;
                    },
                    ast.ExprCall(acall) => {
                        // A value-position if/match element in a mixed array: box
                        // its arms so this element carries the same env-first box
                        // the lambda elements do. Declines (leaving the module to
                        // bail as before) unless every arm boxes.
                        match (acall.callee) {
                            ast.ExprLambda(_) => {
                                if (has_cap_lam) {
                                    var aiw: InlineCloRes = try_fn_field_value(arr.elements[i], fd, fs, ct, gfns, mfuncs, structs);
                                    if (aiw.counter > ct) {
                                        fs = aiw.funcs; ct = aiw.counter; nelems = nelems.append(aiw.expr);
                                        awrapped = true;
                                    }
                                }
                            },
                            _ => {}
                        }
                    },
                    ast.ExprIdent(aid) => {
                        // A bare fn-name element in a MIXED closure array (one that
                        // also holds a capturing lambda, so it dispatches env-first):
                        // wrap the unshadowed module fn into a `$wrap` env box too, so
                        // env-first dispatch is valid for it as well — otherwise its
                        // bare fn pointer is plain-dispatched-as-a-box or box-dispatched-
                        // as-bare → SIGSEGV. Mirrors the tuple / struct-field ident
                        // wrapping. Outside a mixed array a named-fn array stays a plain
                        // fn-pointer array (is_fnarr) — left untouched.
                        if (has_cap_lam && util.index_of_str(abound, aid.name) < 0) {
                            var afnok: boolean = false;
                            var ami: i32 = 0;
                            while (ami < mfuncs.decls.len()) {
                                if (mfuncs.decls[ami].name == aid.name && mfuncs.decls[ami].receiver_type.len() == 0 && mfuncs.decls[ami].params.len() > 0) { afnok = true; }
                                ami = ami + 1;
                            }
                            if (afnok) {
                                var aw: InlineCloRes = try_fn_field_value(arr.elements[i], fd, fs, ct, gfns, mfuncs, structs);
                                fs = aw.funcs; ct = aw.counter; nelems = nelems.append(aw.expr);
                                awrapped = true;
                            }
                        }
                    },
                    _ => {}
                }
                if (!awrapped) {
                    var er: InlineCloRes = lift_inline_closures_expr(arr.elements[i], fd, fs, ct, gfns, structs, mfuncs);
                    fs = er.funcs; ct = er.counter; nelems = nelems.append(er.expr);
                }
                i = i + 1;
            }
            return (ast.ExprArray { ...arr, elements: nelems }, InlineCloAcc { funcs: fs, counter: ct }, true);
        },
        ast.ExprTuple(tl) => {
            // Every fn-VALUED tuple element is lifted to a `__mkclo$…` env-box
            // marker, mirroring the struct-field slice below: a capturing lambda
            // → `[funcval, caps…]` (try_inline_closure via try_fn_field_value),
            // a no-capture lambda or a bare fn-name → a `$wrapN` env-taking
            // trampoline → `[funcval]`. This makes `t.N(args)` dispatch
            // uniformly env-first (the "clo" element tag) for every fn-element
            // shape — matching the DECLARED-type tag a factory-returned tuple
            // carries (tuple_elem_tags maps an "fn" segment to "clo"). A bare
            // ident element is wrapped only when it is an UNSHADOWED module
            // function with params (a zero-arg receiver-less fn is a `const`
            // desugar whose VALUE must flow, and a body/param binding wins over
            // the module fn) — anything else recurses / passes through.
            var tfs: parser.FuncDecl[] = acc.funcs;
            var tct: i32 = acc.counter;
            var tnelems: ast.Expr[] = [];
            var tbound: string[] = fd_bound_names(fd);
            var tei: i32 = 0;
            while (tei < tl.elements.len()) {
                var twrapped: boolean = false;
                match (tl.elements[tei]) {
                    ast.ExprLambda(_) => {
                        var ttr: InlineCloRes = try_fn_field_value(tl.elements[tei], fd, tfs, tct, gfns, mfuncs, structs);
                        tfs = ttr.funcs; tct = ttr.counter; tnelems = tnelems.append(ttr.expr);
                        twrapped = true;
                    },
                    ast.ExprIdent(ttid) => {
                        if (util.index_of_str(tbound, ttid.name) < 0) {
                            var tfnok: boolean = false;
                            var tmi: i32 = 0;
                            while (tmi < mfuncs.decls.len()) {
                                if (mfuncs.decls[tmi].name == ttid.name && mfuncs.decls[tmi].receiver_type.len() == 0 && mfuncs.decls[tmi].params.len() > 0) { tfnok = true; }
                                tmi = tmi + 1;
                            }
                            if (tfnok) {
                                var ttw: InlineCloRes = try_fn_field_value(tl.elements[tei], fd, tfs, tct, gfns, mfuncs, structs);
                                tfs = ttw.funcs; tct = ttw.counter; tnelems = tnelems.append(ttw.expr);
                                twrapped = true;
                            }
                        }
                    },
                    _ => {}
                }
                if (!twrapped) {
                    var ter: InlineCloRes = lift_inline_closures_expr(tl.elements[tei], fd, tfs, tct, gfns, structs, mfuncs);
                    tfs = ter.funcs; tct = ter.counter; tnelems = tnelems.append(ter.expr);
                }
                tei = tei + 1;
            }
            return (ast.ExprTuple { elements: tnelems, line: tl.line, col: tl.col }, InlineCloAcc { funcs: tfs, counter: tct }, true);
        },
        ast.ExprStructLit(sl) => {
            // Every fn-typed struct FIELD value is lifted to a `__mkclo$…` env-box
            // marker (slice #3445): a capturing inline lambda → `[funcval, caps…]`
            // (try_inline_closure), a no-capture lambda / bare fn-name → a `$wrapN`
            // env-taking trampoline → `[funcval]` (try_fn_field_value). This makes
            // `h.f(args)` dispatch uniformly env-first for EVERY fn-field shape.
            // A field whose declared type isn't `fn`, or whose value can't be
            // wrapped (e.g. an unresolvable fn-name, a non-i32-capture lambda),
            // recurses / is left unchanged so a nested array INSIDE a field value
            // is still reached and the module bails when it must.
            var fs: parser.FuncDecl[] = acc.funcs;
            var ct: i32 = acc.counter;
            var nvals: ast.Expr[] = [];
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                var is_fn_field: boolean = (sl.type_name.len() > 0 && i < sl.field_names.len()
                    && decl_field_type(structs, sl.type_name, sl.field_names[i]) == "fn");
                if (is_fn_field) {
                    var fr: InlineCloRes = try_fn_field_value(sl.field_values[i], fd, fs, ct, gfns, mfuncs, structs);
                    fs = fr.funcs; ct = fr.counter; nvals = nvals.append(fr.expr);
                } else {
                    var er: InlineCloRes = lift_inline_closures_expr(sl.field_values[i], fd, fs, ct, gfns, structs, mfuncs);
                    fs = er.funcs; ct = er.counter; nvals = nvals.append(er.expr);
                }
                i = i + 1;
            }
            var nbase: ast.Expr = sl.base;
            if (sl.has_base) {
                var br: InlineCloRes = lift_inline_closures_expr(sl.base, fd, fs, ct, gfns, structs, mfuncs);
                fs = br.funcs; ct = br.counter; nbase = br.expr;
            }
            return (ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nvals, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col }, InlineCloAcc { funcs: fs, counter: ct }, true);
        },
        ast.ExprLambda(_) => { return (e, acc, true); },
        ast.ExprSlice(_) => { return (e, acc, true); },
        ast.ExprMapLit(_) => { return (e, acc, true); },
        ast.ExprFString(_) => { return (e, acc, true); },
        ast.ExprFieldAccess(_) => { return (e, acc, false); },
        ast.ExprBinary(_) => { return (e, acc, false); },
        ast.ExprUnary(_) => { return (e, acc, false); },
        ast.ExprIndex(_) => { return (e, acc, false); },
        ast.ExprIdent(_) => { return (e, acc, false); },
        ast.ExprNumber(_) => { return (e, acc, false); },
        ast.ExprString(_) => { return (e, acc, false); },
        ast.ExprBool(_) => { return (e, acc, false); },
        ast.ExprUnknown(_) => { return (e, acc, false); }
    }
    return (e, acc, false);
}

// lift_inline_closures_expr runs the env-box lift over one expression: the
// spine carries the recursion, ilc_expr_at / ilc_stmt_at carry the policy.
function lift_inline_closures_expr(e: ast.Expr, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): InlineCloRes {
    function ve(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) { return ilc_expr_at(x, a, fd, gfns, structs, mfuncs); }
    function vst(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) { return ilc_stmt_at(s, a, fd, gfns, structs, mfuncs); }
    var (ne, na, nh) = astwalk.map_expr_acc(e, InlineCloAcc { funcs: funcs, counter: counter }, vst, ve);
    return InlineCloRes { expr: ne, funcs: na.funcs, counter: na.counter };
}

// value_use_idents_expr collects every ident referenced in a VALUE position —
// i.e. all idents EXCEPT the direct bare-name callee of a call `g(...)`. A
// nested lambda's free vars all count (they ride the env box as values). Used to
// decide whether a fn-value `var` binding must be env-boxed: a var that is only
// ever CALLED is left to closure_lift_one's cheaper direct-call lift; one used
// as a value (passed, returned, stored, captured) is boxed into a uniform box.
function value_use_idents_expr(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(_) => {},
                // A value-position if/match is an immediately-invoked 0-param
                // lambda whose body lowers INLINE in the enclosing frame, so it
                // captures nothing and a name it only calls is still only
                // called. The closure rule below would box such a name.
                ast.ExprLambda(il) => {
                    if (c.args.len() == 0 && il.params.len() == 0) { acc = iife_body_value_use_idents(il, acc); }
                    else { acc = value_use_idents_expr(c.callee, acc); }
                },
                _ => { acc = value_use_idents_expr(c.callee, acc); }
            }
            for arg in c.args { acc = value_use_idents_expr(arg, acc); }
            return acc;
        },
        ast.ExprIdent(id) => { return acc.append(id.name); },
        ast.ExprNumber(_) => { return acc; },
        ast.ExprString(_) => { return acc; },
        ast.ExprBool(_) => { return acc; },
        ast.ExprBinary(b) => { acc = value_use_idents_expr(b.left, acc); return value_use_idents_expr(b.right, acc); },
        ast.ExprUnary(u) => { return value_use_idents_expr(u.operand, acc); },
        ast.ExprArray(a) => { var i: i32 = 0; while (i < a.elements.len()) { acc = value_use_idents_expr(a.elements[i], acc); i = i + 1; } return acc; },
        ast.ExprTuple(t) => { for el in t.elements { acc = value_use_idents_expr(el, acc); } return acc; },
        ast.ExprIndex(x) => { acc = value_use_idents_expr(x.array, acc); return value_use_idents_expr(x.index, acc); },
        ast.ExprSlice(sl) => { acc = value_use_idents_expr(sl.array, acc); acc = value_use_idents_expr(sl.start, acc); return value_use_idents_expr(sl.end, acc); },
        ast.ExprStructLit(sl) => { if (sl.has_base) { acc = value_use_idents_expr(sl.base, acc); } for fv in sl.field_values { acc = value_use_idents_expr(fv, acc); } return acc; },
        ast.ExprFieldAccess(fa) => { return value_use_idents_expr(fa.obj, acc); },
        ast.ExprLambda(_) => {
            // Every free var of a real (non-inlined) lambda is a value-use,
            // INCLUDING one it only calls: each capture is copied into the
            // closure's env box (make_clo_func) or passed as the lifted call's
            // extra argument (closure_lift_one), and both read a fn value with
            // the uniform env-box ABI. collect_idents_expr's own ExprLambda arm
            // computes exactly that free set.
            return astwalk.collect_idents_expr(e, acc);
        },
        ast.ExprMapLit(ml) => {
            var mi: i32 = 0;
            while (mi < ml.keys.len()) {
                acc = value_use_idents_expr(ml.keys[mi], acc);
                acc = value_use_idents_expr(ml.vals[mi], acc);
                mi = mi + 1;
            }
            return acc;
        },
        ast.ExprFString(fs) => {
            var fi: i32 = 0;
            while (fi < fs.exprs.len()) {
                if (fs.is_expr[fi]) { acc = value_use_idents_expr(fs.exprs[fi], acc); }
                fi = fi + 1;
            }
            return acc;
        },
        ast.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

// iife_body_value_use_idents collects the enclosing-scope names a value-position
// if/match's inlined body uses as VALUES: its body walked with the ordinary
// statement rule, minus the names the body itself binds.
function iife_body_value_use_idents(lm: ast.ExprLambda, acc: string[]): string[] {
    var inner: string[] = [];
    var iu: i32 = 0;
    while (iu < lm.body.len()) { inner = value_use_idents_stmt(lm.body[iu], inner); iu = iu + 1; }
    var bound: string[] = [];
    var ib: i32 = 0;
    while (ib < lm.body.len()) { bound = astwalk.collect_bound_stmt(lm.body[ib], bound); ib = ib + 1; }
    var ik: i32 = 0;
    while (ik < inner.len()) {
        if (util.index_of_str(bound, inner[ik]) < 0) { acc = acc.append(inner[ik]); }
        ik = ik + 1;
    }
    return acc;
}

function value_use_idents_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtDefer(d) => { return value_use_idents_stmt(d.action, acc); },
        ast.StmtVar(v) => { return value_use_idents_expr(v.init, acc); },
        ast.StmtReturn(r) => { return value_use_idents_expr(r.value, acc); },
        ast.StmtExpr(e) => { return value_use_idents_expr(e.value, acc); },
        ast.StmtIf(i) => {
            acc = value_use_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) { acc = value_use_idents_stmt(i.then_body[ti], acc); ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) { acc = value_use_idents_stmt(i.else_body[ei], acc); ei = ei + 1; }
            return acc;
        },
        ast.StmtWhile(w) => {
            acc = value_use_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) { acc = value_use_idents_stmt(w.body[i], acc); i = i + 1; }
            return acc;
        },
        ast.StmtAssign(a) => { acc = value_use_idents_expr(a.value, acc); return acc.append(a.target); },
        ast.StmtMatch(m) => {
            acc = value_use_idents_expr(m.scrutinee, acc);
            for arm in m.arms {
                // A `when` guard is executable code — a value-use inside it counts
                // (mirrors ident_used_as_value_stmt, which already checks it).
                if (arm.has_guard) { acc = value_use_idents_expr(arm.guard, acc); }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { acc = value_use_idents_stmt(arm.body[bi], acc); bi = bi + 1; }
            }
            return acc;
        },
        ast.StmtFor(f) => {
            acc = value_use_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < f.body.len()) { acc = value_use_idents_stmt(f.body[i], acc); i = i + 1; }
            return acc;
        },
        ast.StmtBreak(_) => { return acc; },
        ast.StmtContinue(_) => { return acc; },
        ast.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// stmts_value_use returns true iff `name` is referenced as a value (not merely
// as a call callee) anywhere in `stmts`.
function stmts_value_use(stmts: ast.Stmt[], name: string): boolean {
    var used: string[] = [];
    for stmt in stmts { used = value_use_idents_stmt(stmt, used); }
    return util.index_of_str(used, name) >= 0;
}

// wrap_ann_fn_tuple_elems boxes the bare ZERO-ARG module-fn elements of an
// ANNOTATED tuple literal (or of an annotated ARRAY of tuple literals) into
// `__mkclo$…$wrapN()` markers — the same uniform env box every other fn value
// carries.
//
// Only an element the ANNOTATION calls a fn is touched: `tuple_type_elem_tag`
// returns "clo" for a declared fn segment, and that is exactly the case where the
// `const X` reading is impossible, so boxing cannot change what a const read
// means. Elements with >= 1 param are already boxed by the ordinary tuple walk;
// this closes the zero-arg hole it deliberately leaves open (#5834).
//
// A name bound by a param or anywhere in the body shadows the module function and
// is left alone, mirroring the shadowing test the tuple walk makes.
function wrap_ann_fn_tuple_elems(e: ast.Expr, ann: string, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): InlineCloRes {
    var tty: string = ann;
    var is_arr: boolean = false;
    if (tty.len() > 2 && slice_unchecked(tty, tty.len() - 2, tty.len()) == "[]") {
        tty = slice_unchecked(tty, 0, tty.len() - 2) + "";
        is_arr = true;
    }
    // Nothing to do unless the annotation is a tuple with at least one declared
    // fn element.
    if (tuple_type_elem_tag(tty, 0) == "") { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
    var bound: string[] = [];
    var bp: i32 = 0;
    while (bp < fd.params.len()) { bound = bound.append(fd.params[bp].name); bp = bp + 1; }
    var bs: i32 = 0;
    while (bs < fd.body.len()) { bound = astwalk.collect_bound_stmt(fd.body[bs], bound); bs = bs + 1; }
    if (is_arr) {
        match (e) {
            ast.ExprArray(arr) => {
                var afs: parser.FuncDecl[] = funcs;
                var act: i32 = counter;
                var aels: ast.Expr[] = [];
                var ai: i32 = 0;
                while (ai < arr.elements.len()) {
                    var ar: InlineCloRes = wrap_one_ann_tuple(arr.elements[ai], tty, bound, fd, afs, act, gfns, mfuncs, structs);
                    afs = ar.funcs; act = ar.counter; aels = aels.append(ar.expr);
                    ai = ai + 1;
                }
                return InlineCloRes { expr: ast.ExprArray { ...arr, elements: aels }, funcs: afs, counter: act };
            },
            _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
        }
    }
    return wrap_one_ann_tuple(e, tty, bound, fd, funcs, counter, gfns, mfuncs, structs);
}

// wrap_one_ann_tuple applies the boxing to ONE tuple literal against the tuple
// type `tty`. A non-tuple expression passes through untouched.
function wrap_one_ann_tuple(e: ast.Expr, tty: string, bound: string[], fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): InlineCloRes {
    match (e) {
        ast.ExprTuple(tl) => {
            var fs: parser.FuncDecl[] = funcs;
            var ct: i32 = counter;
            var els: ast.Expr[] = [];
            var i: i32 = 0;
            while (i < tl.elements.len()) {
                var did: boolean = false;
                if (tuple_type_elem_tag(tty, i) == "clo") {
                    match (tl.elements[i]) {
                        ast.ExprIdent(id) => {
                            // Zero-arg ONLY: the >= 1 case is already boxed by the
                            // ordinary tuple walk, and re-boxing it here would
                            // hoist two wrappers for one element.
                            if (util.index_of_str(bound, id.name) < 0 && lift_module_fn_arity(mfuncs, id.name) == 0) {
                                var wr: InlineCloRes = try_fn_field_value(tl.elements[i], fd, fs, ct, gfns, mfuncs, structs);
                                match (wr.expr) {
                                    ast.ExprCall(_) => { fs = wr.funcs; ct = wr.counter; els = els.append(wr.expr); did = true; },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                }
                if (!did) { els = els.append(tl.elements[i]); }
                i = i + 1;
            }
            return InlineCloRes { expr: ast.ExprTuple { elements: els, line: tl.line, col: tl.col }, funcs: fs, counter: ct };
        },
        _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
    }
    return InlineCloRes { expr: e, funcs: funcs, counter: counter };
}

// wrap_ann_fn_variant_payload is wrap_ann_fn_tuple_elems for an Option/Result
// PAYLOAD: `var o: Option[() => i32] = Some(a1)` where `a1` is a bare ZERO-ARG
// module fn.
//
// Same disagreement, same resolution. The match-arm bind dispatches the payload
// env-first, so it must be a box; the variant-constructor walk boxes a payload
// with >= 1 param but skips a zero-arg one, because a bare zero-arg name is how
// a `const` reads. The ANNOTATION settles it — `Option[() => i32]` says the
// payload is a fn value, so no const reading exists — and it is available here at
// the binding.
//
// `Ok` takes Result's first type arg, `Err` its second; `Some` takes Option's
// only one. A payload that is not a bare unshadowed zero-arg module fn is left
// to the ordinary walk, which already handles lambdas and >= 1-param names.
function wrap_ann_fn_variant_payload(e: ast.Expr, ann: string, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: parser.StructDecl[]): InlineCloRes {
    var r: parser.TypeRef = parser.parse_type_ref(ann);
    if (r.array_depth != 0 || r.is_tuple) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
    if (r.base != "Option" && r.base != "Result") { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
    match (e) {
        ast.ExprCall(call) => {
            if (call.args.len() != 1) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
            var cn: string = "";
            match (call.callee) {
                ast.ExprIdent(cid) => { cn = cid.name; },
                _ => {}
            }
            var argi: i32 = 0 - 1;
            if (cn == "Some" && r.base == "Option") { argi = 0; }
            if (cn == "Ok" && r.base == "Result") { argi = 0; }
            if (cn == "Err" && r.base == "Result") { argi = 1; }
            if (argi < 0 || argi >= r.args.len()) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
            // A generic ARG is not coarsened the way a tuple segment is, so the
            // payload can render either as the coarse "fn" or as its full
            // spelling ("() => i32"). Accept both — an arrow is unambiguous.
            var pty: string = parser.render_type_ref(r.args[argi]);
            if (pty != "fn" && !util.contains(pty, "=>")) { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
            match (call.args[0]) {
                ast.ExprIdent(id) => {
                    var bound: string[] = [];
                    var bp: i32 = 0;
                    while (bp < fd.params.len()) { bound = bound.append(fd.params[bp].name); bp = bp + 1; }
                    var bs: i32 = 0;
                    while (bs < fd.body.len()) { bound = astwalk.collect_bound_stmt(fd.body[bs], bound); bs = bs + 1; }
                    if (util.index_of_str(bound, id.name) >= 0 || lift_module_fn_arity(mfuncs, id.name) != 0) {
                        return InlineCloRes { expr: e, funcs: funcs, counter: counter };
                    }
                    var wr: InlineCloRes = try_fn_field_value(call.args[0], fd, funcs, counter, gfns, mfuncs, structs);
                    match (wr.expr) {
                        ast.ExprCall(_) => {
                            return InlineCloRes { expr: ast.ExprCall { callee: call.callee, args: [wr.expr], line: call.line, col: call.col, type_argc: call.type_argc, ty: call.ty }, funcs: wr.funcs, counter: wr.counter };
                        },
                        _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
                    }
                },
                _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
            }
        },
        _ => { return InlineCloRes { expr: e, funcs: funcs, counter: counter }; }
    }
    return InlineCloRes { expr: e, funcs: funcs, counter: counter };
}

// ilc_stmt_at is the env-box lift's statement visitor: the statements that OWN
// a fn-value position (var / return / expr / assign) are claimed and rebuilt
// by the hand policy — annotation-directed boxing included — and the compound
// statements decline, the spine carrying what their arms used to spell out:
// condition / iterable / scrutinee / guard through ilc_expr_at, bodies through
// this visitor. StmtDefer is claimed unchanged: this pass has never entered a
// defer's action, and raw-parse drivers can carry a defer into the lift.
function ilc_stmt_at(st: ast.Stmt, acc: InlineCloAcc, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): (ast.Stmt, InlineCloAcc, boolean) {
    var fs: parser.FuncDecl[] = acc.funcs;
    var ct: i32 = acc.counter;
    match (st) {
        ast.StmtVar(v) => {
            // A fn-VALUE local binding `var g = dbl` (the init a bare module
            // fn-name with >= 1 param — a function value, not a zero-arg
            // const) is env-boxed into a `__mkclo$<fd>$wrapN()` trampoline box
            // so the slot holds the SAME uniform env box every fn-value carries
            // (slice #3445 follow-up). Then `g(args)` / passing `g` as a
            // fn-arg both ride the env-first call path (the slot is marked a
            // closure local at lowering, recognising the `__mkclo$` init). A
            // non-fn-value init falls through to the ordinary aggregate walk.
            var bn: string = v.name;
            var bty: string = v.type_name;
            var bln: i32 = v.line;
            var bco: i32 = v.col;
            match (v.init) {
                ast.ExprIdent(vid) => {
                    // A local binding of the same name SHADOWS the module
                    // function, so the init is an ordinary value copy — see
                    // lift_ident_is_param (#6191, and #6854 for this site).
                    if (!lift_ident_is_param(fd, vid.name) && lift_module_fn_arity(mfuncs, vid.name) >= 1) {
                        var wn: string = clo_owner_name(fd) + "$wrap" + util.i32_to_string(ct);
                        var hr: HoistResult = make_wrap_named_func(vid.name, wn, mfuncs);
                        if (hr.ok) {
                            var marker: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + wn, line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
                            return (ast.StmtVar { name: bn, type_name: bty, init: marker, line: bln, col: bco, is_str: false, fn_ret: "", fn_param_types: "" }, InlineCloAcc { funcs: fs.append(hr.func), counter: ct + 1 }, true);
                        }
                    }
                },
                ast.ExprLambda(_) => {
                    // A var-bound lambda USED AS A VALUE (passed, returned,
                    // stored, captured) — not merely called — is env-boxed so
                    // its slot holds the uniform env box every fn-value carries;
                    // `g(args)` then rides the env-first call path. A var only
                    // ever CALLED is left to closure_lift_one's cheaper
                    // direct-call lift (boxing it would pre-empt that and
                    // regress closure-calls-closure). try_fn_field_value boxes a
                    // capturing (i32-only) / no-capture lambda into a `__mkclo$`
                    // marker (ExprCall) and DECLINES (returns the lambda
                    // unchanged) for non-i32 captures — only the ExprCall result
                    // counts as boxed; a decline falls through to the walk so the
                    // module bails (correctness preserved).
                    if (stmts_value_use(fd.body, bn)) {
                        var lr: InlineCloRes = try_fn_field_value(v.init, fd, fs, ct, gfns, mfuncs, structs);
                        match (lr.expr) {
                            ast.ExprCall(_) => {
                                return (ast.StmtVar { name: bn, type_name: bty, init: lr.expr, line: bln, col: bco, is_str: false, fn_ret: "", fn_param_types: "" }, InlineCloAcc { funcs: lr.funcs, counter: lr.counter }, true);
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            // ANNOTATED fn-typed tuple elements (#5834): a bare ZERO-ARG
            // module fn in a tuple element is normally left alone, because
            // `const X = expr` desugars to a zero-arg function and a bare
            // `X` must read as the const's VALUE, not its address. But an
            // annotation naming the element a fn — `((() => i32), i32)` —
            // rules that reading out, and the tag side already assumes a
            // box there (tuple_type_elem_tag maps an "fn" segment to
            // "clo"), so leaving the value unboxed made `t.0()` dispatch
            // env-first on a const-CALL result and SIGSEGV. Wrap it here,
            // where the declared type is in hand, so the value side agrees
            // with the tag side. Unannotated tuples keep their exact
            // behaviour, which is what keeps every const read intact.
            var pre: ast.Expr = v.init;
            var prer: InlineCloRes = wrap_ann_fn_tuple_elems(pre, v.type_name, fd, fs, ct, gfns, mfuncs, structs);
            fs = prer.funcs; ct = prer.counter; pre = prer.expr;
            // The same disagreement one container over: `var o:
            // Option[() => i32] = Some(a1)` left the zero-arg payload
            // unboxed while the match-arm bind dispatches it env-first.
            var pver: InlineCloRes = wrap_ann_fn_variant_payload(pre, v.type_name, fd, fs, ct, gfns, mfuncs, structs);
            fs = pver.funcs; ct = pver.counter; pre = pver.expr;
            var er: InlineCloRes = lift_inline_closures_expr(pre, fd, fs, ct, gfns, structs, mfuncs);
            return (ast.StmtVar { name: v.name, type_name: v.type_name, init: er.expr, line: v.line, col: v.col, is_str: v.is_str, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
        },
        ast.StmtReturn(r) => {
            // `function get(): () => i32 { return a1; }` — the declared RETURN
            // type is the annotation, and it rules out the const reading the
            // same way a tuple element's or an Option payload's does. The
            // caller binds the result as a fn value and dispatches it
            // env-first, so a bare zero-arg name has to be boxed here.
            var rpre: ast.Expr = r.value;
            if (fd.ret_type == "fn" || util.contains(fd.ret_type, "=>")) {
                match (rpre) {
                    ast.ExprIdent(rid) => {
                        var rbound: string[] = [];
                        var rbp: i32 = 0;
                        while (rbp < fd.params.len()) { rbound = rbound.append(fd.params[rbp].name); rbp = rbp + 1; }
                        var rbs: i32 = 0;
                        while (rbs < fd.body.len()) { rbound = astwalk.collect_bound_stmt(fd.body[rbs], rbound); rbs = rbs + 1; }
                        if (util.index_of_str(rbound, rid.name) < 0 && lift_module_fn_arity(mfuncs, rid.name) == 0) {
                            var rwr: InlineCloRes = try_fn_field_value(rpre, fd, fs, ct, gfns, mfuncs, structs);
                            match (rwr.expr) {
                                ast.ExprCall(_) => { fs = rwr.funcs; ct = rwr.counter; rpre = rwr.expr; },
                                _ => {}
                            }
                        }
                    },
                    _ => {}
                }
            }
            var er: InlineCloRes = lift_inline_closures_expr(rpre, fd, fs, ct, gfns, structs, mfuncs);
            return (ast.StmtReturn { value: er.expr, line: r.line, col: r.col }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
        },
        ast.StmtExpr(es) => {
            var er: InlineCloRes = lift_inline_closures_expr(es.value, fd, fs, ct, gfns, structs, mfuncs);
            return (ast.StmtExpr { value: er.expr, line: 0 }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
        },
        ast.StmtAssign(a) => {
            // A fn-value REASSIGNMENT `f = <lambda>` / `f = dbl` must be
            // env-boxed the SAME way the fn-value BINDING `var f = …` is
            // (#3445 follow-up): `f` was marked a closure local at its boxed
            // binding, so `f(args)` / passing `f` dispatch env-first — an
            // UNBOXED reassigned value (a bare lambda / fn pointer) in that
            // slot would env-first-dispatch a non-box and crash. A capturing
            // lambda → __mkclo box; a no-capture lambda / bare module-fn-name
            // → a $wrapN trampoline box (try_fn_field_value); any other RHS
            // (a call returning a box, an already-boxed local, a non-fn value)
            // recurses through the ordinary walk. The RHS being a fn-value
            // implies a fn-typed target (type-checked), so this never boxes a
            // non-fn assignment.
            match (a.value) {
                ast.ExprLambda(_) => {
                    var asgr: InlineCloRes = try_fn_field_value(a.value, fd, fs, ct, gfns, mfuncs, structs);
                    return (ast.StmtAssign { target: a.target, value: asgr.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, InlineCloAcc { funcs: asgr.funcs, counter: asgr.counter }, true);
                },
                ast.ExprIdent(avid) => {
                    if (lift_module_fn_arity(mfuncs, avid.name) >= 1) {
                        var asgr2: InlineCloRes = try_fn_field_value(a.value, fd, fs, ct, gfns, mfuncs, structs);
                        return (ast.StmtAssign { target: a.target, value: asgr2.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, InlineCloAcc { funcs: asgr2.funcs, counter: asgr2.counter }, true);
                    }
                },
                _ => {}
            }
            var er: InlineCloRes = lift_inline_closures_expr(a.value, fd, fs, ct, gfns, structs, mfuncs);
            return (ast.StmtAssign { target: a.target, value: er.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
        },
        ast.StmtDefer(_) => { return (st, acc, true); },
        ast.StmtIf(_) => { return (st, acc, false); },
        ast.StmtWhile(_) => { return (st, acc, false); },
        ast.StmtFor(_) => { return (st, acc, false); },
        ast.StmtMatch(_) => { return (st, acc, false); },
        ast.StmtBreak(_) => { return (st, acc, false); },
        ast.StmtContinue(_) => { return (st, acc, false); },
        ast.StmtUnknown(_) => { return (st, acc, false); }
    }
    return (st, acc, false);
}

// lift_inline_closures rewrites fd, hoisting capturing inline lambdas in
// aggregate position to `<fd>$cloN` funcs (returned alongside the body). When
// nothing is hoisted, fd.body is returned UNCHANGED with no funcs so
// lambda-free / unaffected functions serialize byte-identically
// (fixpoint-safe).
function lift_inline_closures(fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): (ast.Stmt[], parser.FuncDecl[]) {
    function ve(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) { return ilc_expr_at(x, a, fd, gfns, structs, mfuncs); }
    function vst(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) { return ilc_stmt_at(s, a, fd, gfns, structs, mfuncs); }
    var (ns, na) = astwalk.map_stmts_acc(fd.body, InlineCloAcc { funcs: [], counter: 0 }, vst, ve);
    if (na.funcs.len() == 0) { return (fd.body, []); }
    return (ns, na.funcs);
}

// ---- mutable captures (boxing, #2850 / #5394) --------------------------
//
// A closure that WRITES a captured outer scalar (`var x = 0; f = fn(){ x = x+1 }`)
// must share the write with the enclosing scope (scalar captures are mutable
// by-reference — the closures-as-counters feature). The IR path captures by
// VALUE (the env box holds the capture's value), so the write is lost. Fix:
// before lifting, rewrite each captured-AND-mutated local into a 1-element
// array CELL, so the existing array-pointer capture is by-reference:
//   var x = E         ->  var $cell$x: T[] = [E]
//   <read x>          ->  $cell$x[0]
//   x = v             ->  $cell$x = $cell$x.with(0, v)   (in-place arr_set)
// The lambda then captures the cell pointer (cap_type sees `T[]`,
// try_lift_binding passes the pointer); its in-place `.with` mutates the shared
// cell. Two rules select what boxes:
//   1. #2850: an i32/boolean capture the CLOSURE body writes (cell `i32[]`).
//   2. #5394: a capture of an ESCAPING binding (returned / used as a value —
//      the make_closure env-box path, which snapshots at creation) that the
//      ENCLOSING body reassigns — any capturable type, cell `<ct>[]`. The env
//      then snapshots the cell POINTER, so a later outer reassignment stores
//      through the shared cell and the escaped closure reads the live value,
//      matching the interpreter (the oracle per #2896). Directly-called
//      bindings don't need this: the param-lift passes captures at each call
//      site (#5301), which is already by-reference for reads.

// mcap_cell_name is the cell local for a mutated capture. The `$` prefix cannot
// collide with a user ident (the guarantee `$lamret$` and `$wc$` already rely
// on), which is what lets the `.with` gate tell a by-reference capture cell from
// a caller's array once the lift has turned both into plain array params
// (#6185): the mode rides on the name, because ParamDecl carries no mode beyond
// `own` and a cell is neither owned nor borrowed.
function mcap_cell_name(c: string): string { return "$cell$" + c; }

// is_mcap_cell_name reports whether `n` names such a cell.
function is_mcap_cell_name(n: string): boolean {
    return n.len() > 6 && slice_unchecked(n, 0, 6) == "$cell$";
}

// box_rewrite_expr rewrites every READ of a boxed var `x` to `$cell$x[0]`,
// recursing all expression forms (including into lambda bodies). The decl name
// and assign target are handled by box_rewrite_stmt, not here.
function box_rewrite_expr(e: ast.Expr, boxed: string[], btypes: string[], bsites: string[], bound: string[]): ast.Expr {
    match (e) {
        ast.ExprIdent(id) => {
            if (util.index_of_str(boxed, id.name) >= 0 && util.index_of_str(bound, id.name) < 0) {
                return ast.ExprIndex { array: ast.ExprIdent { name: mcap_cell_name(id.name), line: id.line, col: id.col, ty: "" }, index: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: id.line, col: id.col }, unchecked: false, ty: "" };
            }
            return e;
        },
        ast.ExprBinary(b) => { return ast.ExprBinary { op: b.op, left: box_rewrite_expr(b.left, boxed, btypes, bsites, bound), right: box_rewrite_expr(b.right, boxed, btypes, bsites, bound), line: b.line, col: b.col, ty: b.ty }; },
        ast.ExprUnary(u) => { return ast.ExprUnary { op: u.op, operand: box_rewrite_expr(u.operand, boxed, btypes, bsites, bound), line: u.line, col: u.col, ty: u.ty }; },
        ast.ExprCall(c) => {
            var nargs: ast.Expr[] = [];
            for arg in c.args { nargs = nargs.append(box_rewrite_expr(arg, boxed, btypes, bsites, bound)); }
            return ast.ExprCall { callee: box_rewrite_expr(c.callee, boxed, btypes, bsites, bound), args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
        },
        ast.ExprArray(a) => {
            var ne: ast.Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { ne = ne.append(box_rewrite_expr(a.elements[i], boxed, btypes, bsites, bound)); i = i + 1; }
            return ast.ExprArray { ...a, elements: ne };
        },
        ast.ExprTuple(t) => {
            var ne: ast.Expr[] = [];
            for el in t.elements { ne = ne.append(box_rewrite_expr(el, boxed, btypes, bsites, bound)); }
            return ast.ExprTuple { elements: ne, line: t.line, col: t.col };
        },
        ast.ExprIndex(x) => { return ast.ExprIndex { array: box_rewrite_expr(x.array, boxed, btypes, bsites, bound), index: box_rewrite_expr(x.index, boxed, btypes, bsites, bound), unchecked: x.unchecked, ty: x.ty }; },
        ast.ExprSlice(sl) => { return ast.ExprSlice { array: box_rewrite_expr(sl.array, boxed, btypes, bsites, bound), start: box_rewrite_expr(sl.start, boxed, btypes, bsites, bound), end: box_rewrite_expr(sl.end, boxed, btypes, bsites, bound), ty: sl.ty, open_end: sl.open_end }; },
        ast.ExprStructLit(sl) => {
            var nv: ast.Expr[] = [];
            for fv in sl.field_values { nv = nv.append(box_rewrite_expr(fv, boxed, btypes, bsites, bound)); }
            var nbase: ast.Expr = sl.base;
            if (sl.has_base) { nbase = box_rewrite_expr(sl.base, boxed, btypes, bsites, bound); }
            return ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col };
        },
        ast.ExprFieldAccess(fa) => { return ast.ExprFieldAccess { obj: box_rewrite_expr(fa.obj, boxed, btypes, bsites, bound), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }; },
        ast.ExprLambda(lm) => {
            // A lambda PARAMETER of a boxed name is a different variable: inside
            // this body the spelling means the argument, not the enclosing cell.
            var lb: string[] = bound;
            var lp: i32 = 0;
            while (lp < lm.params.len()) { lb = lb.append(lm.params[lp].name); lp = lp + 1; }
            return ast.ExprLambda { ...lm, body: box_rewrite_stmts(lm.body, boxed, btypes, bsites, lb) };
        },
        _ => { return e; }
    }
    return e;
}

// box_rewrite_stmt rewrites one statement: a boxed var's decl wraps its init in
// a cell, a boxed assign becomes an in-place `.with`, everything else recurses.
function box_rewrite_stmt(st: ast.Stmt, boxed: string[], btypes: string[], bsites: string[], bound: string[]): ast.Stmt {
    match (st) {
        ast.StmtVar(v) => {
            var bxi: i32 = util.index_of_str(boxed, v.name);
            // Only the declaration the cell was built from becomes the cell.
            // A re-declaration of the spelling is a different variable, and
            // rewriting it produced a SECOND `$cell$n` — typed from the first
            // one's entry — that shadowed the real cell for the rest of the
            // block. Matched on the site because the name cannot tell them apart.
            if (bxi >= 0 && reclaim_site_key_of(v.name, v.line, v.col) != bsites[bxi]) { bxi = 0 - 1; }
            if (bxi >= 0 && util.index_of_str(bound, v.name) >= 0) { bxi = 0 - 1; }
            if (bxi >= 0) {
                var cell: ast.Expr = ast.ExprArray { elements: [box_rewrite_expr(v.init, boxed, btypes, bsites, bound)], elem_ty: btypes[bxi], line: 0, col: 0 };
                return ast.StmtVar { name: mcap_cell_name(v.name), type_name: btypes[bxi] + "[]", init: cell, line: v.line, col: v.col, is_str: false, fn_ret: "", fn_param_types: "" };
            }
            return ast.StmtVar { name: v.name, type_name: v.type_name, init: box_rewrite_expr(v.init, boxed, btypes, bsites, bound), line: v.line, col: v.col, is_str: v.is_str, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
        },
        ast.StmtAssign(a) => {
            if (util.index_of_str(boxed, a.target) >= 0 && util.index_of_str(bound, a.target) < 0) {
                // x = v  ->  $cell$x = $cell$x.with(0, v)   (receiver stays the raw cell ident)
                var cnm: string = mcap_cell_name(a.target);
                var recv: ast.Expr = ast.ExprIdent { name: cnm, line: a.target_line, col: a.target_col, ty: "" };
                var wcall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: recv, field: "with", line: a.line, col: a.col, ty: "" }, args: [ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: a.line, col: a.col }, box_rewrite_expr(a.value, boxed, btypes, bsites, bound)], line: a.line, col: a.col, type_argc: 0, ty: "" };
                return ast.StmtAssign { target: cnm, value: wcall, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
            }
            return ast.StmtAssign { target: a.target, value: box_rewrite_expr(a.value, boxed, btypes, bsites, bound), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
        },
        ast.StmtReturn(r) => { return ast.StmtReturn { value: box_rewrite_expr(r.value, boxed, btypes, bsites, bound), line: r.line, col: r.col }; },
        ast.StmtExpr(e) => { return ast.StmtExpr { value: box_rewrite_expr(e.value, boxed, btypes, bsites, bound), line: e.line }; },
        ast.StmtIf(f) => { return ast.StmtIf { ...f, cond: box_rewrite_expr(f.cond, boxed, btypes, bsites, bound), then_body: box_rewrite_stmts(f.then_body, boxed, btypes, bsites, bound), else_body: box_rewrite_stmts(f.else_body, boxed, btypes, bsites, bound) }; },
        ast.StmtWhile(w) => { return ast.StmtWhile { cond: box_rewrite_expr(w.cond, boxed, btypes, bsites, bound), body: box_rewrite_stmts(w.body, boxed, btypes, bsites, bound), label: w.label, line: w.line, is_loop: w.is_loop }; },
        ast.StmtFor(fr) => {
            // The loop BINDER shadows: `for n in xs` inside a function with a
            // boxed `n` means the element, not the cell. The iterable is still
            // in the enclosing scope, so only the body takes the extra binding.
            var fb: string[] = bound;
            fb = append_bound_binder(fb, fr.var_name);
            return ast.StmtFor { var_name: fr.var_name, iter: box_rewrite_expr(fr.iter, boxed, btypes, bsites, bound), body: box_rewrite_stmts(fr.body, boxed, btypes, bsites, fb), label: fr.label, line: fr.line };
        },
        ast.StmtMatch(m) => {
            var na: ast.MatchArm[] = [];
            for arm in m.arms {
                // Rewrite a boxed var read in the guard too — else the guard read
                // the raw slot instead of the box (stale value). No-op when the
                // guard references no boxed var (box_rewrite_expr returns it as-is).
                // A payload binder shadows inside its own arm (body AND guard).
                var ab: string[] = bound;
                var bxj: i32 = 0;
                while (bxj < boxed.len()) {
                    if (sa_pat_binds(arm.pattern, boxed[bxj])) { ab = ab.append(boxed[bxj]); }
                    bxj = bxj + 1;
                }
                var ng: ast.Expr = arm.guard;
                if (arm.has_guard) { ng = box_rewrite_expr(arm.guard, boxed, btypes, bsites, ab); }
                na = na.append(ast.MatchArm { ...arm, body: box_rewrite_stmts(arm.body, boxed, btypes, bsites, ab), guard: ng });
            }
            return ast.StmtMatch { ...m, scrutinee: box_rewrite_expr(m.scrutinee, boxed, btypes, bsites, bound), arms: na };
        },
        ast.StmtDefer(d) => { return ast.StmtDefer { action: box_rewrite_stmt(d.action, boxed, btypes, bsites, bound), on_error: d.on_error, line: d.line }; },
        _ => { return st; }
    }
    return st;
}

// box_rewrite_stmts walks a statement LIST, so it is where a `var` shadow takes
// effect: a re-declaration of a boxed name binds it for every LATER statement of
// that list, and only the declaration the cell was built from is rewritten into
// the cell (matched on its line:col, since the name alone cannot tell the two
// apart).
function box_rewrite_stmts(stmts: ast.Stmt[], boxed: string[], btypes: string[], bsites: string[], bound: string[]): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    var bnd: string[] = bound;
    for stmt in stmts {
        out = out.append(box_rewrite_stmt(stmt, boxed, btypes, bsites, bnd));
        match (stmt) {
            ast.StmtVar(sv) => {
                if (util.index_of_str(boxed, sv.name) >= 0 && util.index_of_str(bnd, sv.name) < 0
                    && reclaim_site_key_of(sv.name, sv.line, sv.col) != bsites[util.index_of_str(boxed, sv.name)]) {
                    bnd = bnd.append(sv.name);
                }
            },
            _ => {}
        }
    }
    return out;
}

// append_bound_binder appends a binder name, splitting the comma-joined form a
// tuple destructure and a two-name `for (k, v) in m` use — unsplit, neither name
// is recognised as a shadow. The astwalk twin of this is append_bound_name.
function append_bound_binder(acc: string[], name: string): string[] {
    var start: i32 = 0;
    var i: i32 = 0;
    var out: string[] = acc;
    while (i <= name.len()) {
        if (i == name.len() || name[i] == b',') {
            var piece: string = slice_unchecked(name, start, i) + "";
            if (piece.len() > 0) { out = out.append(piece); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// body_var_decl_names collects every `var`-declared name in `stmts`, recursing
// into nested control-flow bodies (NOT into lambda inits — a lambda's own local
// is its own binding, never the enclosing function's). Gates #5394's boxing to
// locals the StmtVar rewrite can actually turn into a cell — never a parameter.
function body_var_decl_names(stmts: ast.Stmt[]): string[] {
    var out: string[] = [];
    for stmt in stmts {
        out = astwalk.fold_stmt_nodes(stmt, out, var_decl_name_into, no_expr_strs, astwalk.descend_none);
    }
    return out;
}

function var_decl_name_into(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => { return acc.append(v.name); },
        _ => { return acc; }
    }
    return acc;
}

// ident_used_as_value_expr: does `name` occur in `e` as a VALUE — any ident
// occurrence other than a direct-call callee (`name(args)` is a call, not an
// escape)? A use inside a nested lambda body counts (the closure would capture
// the binding). Drives #5394's escape test for `var f = <lambda>` bindings.
function ident_used_as_value_expr(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprBinary(b) => { return ident_used_as_value_expr(b.left, name) || ident_used_as_value_expr(b.right, name); },
        ast.ExprUnary(u) => { return ident_used_as_value_expr(u.operand, name); },
        ast.ExprCall(c) => {
            for arg in c.args { if (ident_used_as_value_expr(arg, name)) { return true; } }
            match (c.callee) {
                ast.ExprIdent(cid) => { if (cid.name == name) { return false; } },
                _ => {}
            }
            return ident_used_as_value_expr(c.callee, name);
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (ident_used_as_value_expr(a.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (ident_used_as_value_expr(el, name)) { return true; } }
            return false;
        },
        ast.ExprIndex(x) => { return ident_used_as_value_expr(x.array, name) || ident_used_as_value_expr(x.index, name); },
        ast.ExprSlice(sl) => { return ident_used_as_value_expr(sl.array, name) || ident_used_as_value_expr(sl.start, name) || ident_used_as_value_expr(sl.end, name); },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && ident_used_as_value_expr(sl.base, name)) { return true; }
            for fv in sl.field_values { if (ident_used_as_value_expr(fv, name)) { return true; } }
            return false;
        },
        ast.ExprFieldAccess(fa) => { return ident_used_as_value_expr(fa.obj, name); },
        ast.ExprLambda(lm) => { return ident_used_as_value_stmts(lm.body, name); },
        _ => { return false; }
    }
    return false;
}

function ident_used_as_value_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return ident_used_as_value_expr(v.init, name); },
        // A reassignment TARGET counts too: `f = other` declines the param-
        // lift (try_lift_binding's fname-in-assigns guard), so the binding
        // keeps the env-box path and needs the cell.
        ast.StmtAssign(a) => { return a.target == name || ident_used_as_value_expr(a.value, name); },
        ast.StmtReturn(r) => { return ident_used_as_value_expr(r.value, name); },
        ast.StmtExpr(e) => { return ident_used_as_value_expr(e.value, name); },
        ast.StmtIf(f) => { return ident_used_as_value_expr(f.cond, name) || ident_used_as_value_stmts(f.then_body, name) || ident_used_as_value_stmts(f.else_body, name); },
        ast.StmtWhile(w) => { return ident_used_as_value_expr(w.cond, name) || ident_used_as_value_stmts(w.body, name); },
        ast.StmtFor(fr) => { return ident_used_as_value_expr(fr.iter, name) || ident_used_as_value_stmts(fr.body, name); },
        ast.StmtMatch(m) => {
            if (ident_used_as_value_expr(m.scrutinee, name)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && ident_used_as_value_expr(arm.guard, name)) { return true; }
                if (ident_used_as_value_stmts(arm.body, name)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function ident_used_as_value_stmts(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (ident_used_as_value_stmt(stmt, name)) { return true; } }
    return false;
}

// ---- wide (8-byte scalar) captures (#6046) ----------------------------
//
// The closure env box is an i32[] (arr_make …, 32), so a capture has to fit a
// 32-bit slot — cap_slot_ok's rule. Pointer-shaped captures do (every heap and
// code address in the -no-pie -static binary is 32-bit), but an i64 / u64 / f64
// does not, so make_clo_func declined and the module bailed. Since the AST
// emitters were deleted (#3457) that bail is a hard compile error, which made a
// closure over a duration, a file size or a timestamp simply not compile.
//
// box_wide_captures fixes it WITHOUT widening the box: it snapshots each wide
// capture into a 1-element cell (`var $wc$b: i64[] = [b];`) immediately before
// the statement that builds the closure, and re-binds the original name from
// that cell at the top of the lambda body (`var b: i64 = $wc$b[0];`). After the
// rewrite `b` is bound INSIDE the lambda, so it is no longer free: the capture
// the lift passes see is `$wc$b`, an `i64[]` — pointer-shaped, so cap_slot_ok
// accepts it as-is and make_clo_func, the env box and all three backends are
// untouched.
//
// The 1-element cell is the SAME representation box_mutated_scalar_captures
// uses (box_rewrite_stmt builds `var x: T[] = [init]` and reads `x[0]`), reused
// rather than duplicated; only the reason differs — slot width here, write
// sharing there.
//
// A capture the enclosing function REASSIGNS is skipped — not declined.
// box_mutated_scalar_captures already boxes those into a SHARED cell (#5394,
// its escaping-binding branch, which takes a capture of any type), and a shared
// cell is what they need: the closure must see the live value, which this
// creation-time snapshot could not give. Skipping is therefore deferring to the
// right mechanism. Both paths land on the same `T[]` shape, so either way the
// capture reaching cap_slot_ok is pointer-shaped.
//
// A function with no wide capture is returned unchanged, so every other
// function stays byte-identical — including all of the self-host's own, which
// contain no wide capture (they could not compile today if they did).
function is_wide_cap_type(t: string): boolean {
    return t == "i64" || t == "u64" || t == "f64";
}

// is_iife_callee reports whether `c` is an immediately-invoked zero-param
// lambda — `(<lambda>)()`, the shape the parser builds for `if` / `match` in
// value position and for the array / map comprehension desugars.
//
// It matters to the wide-capture pass because such a lambda is invoked in the
// enclosing scope and cannot escape it: lower_iife lowers the body INLINE, so
// the names it reads are the enclosing function's own locals and no env box is
// ever built. Snapshotting them into cells is therefore not merely wasted —
// the cell RE-BIND it prepends turns a one-statement body into a value BLOCK,
// and a 64-bit block tail is deferred (#6267), so the enclosing function bailed
// off the IR path over a capture that never needed boxing (#6278).
function is_iife_callee(c: ast.ExprCall): boolean {
    if (c.args.len() != 0) { return false; }
    match (c.callee) {
        ast.ExprLambda(lm) => {
            if (lm.params.len() != 0) { return false; }
            // A defer-carrying IIFE is CALLED, not inlined, so its captures do
            // need boxing and it is not exempt. Every other zero-param
            // immediate call still inlines, so the exemption stands (#7192).
            return lm.origin != parser.ORIGIN_IIFE_SCOPED;
        },
        _ => { return false; }
    }
}

// wcap_cell_name is the cell local for a wide capture. The `$` prefix cannot
// collide with a user ident (the guarantee `$lamret$` already relies on).
function wcap_cell_name(c: string): string { return "$wc$" + c; }

struct WCaps { names: string[], types: string[] }
struct WCapExpr { expr: ast.Expr, caps: WCaps }
struct WCapStmt { stmt: ast.Stmt, caps: WCaps, changed: boolean }
struct WCapBody { stmts: ast.Stmt[], changed: boolean }

// wcaps_add records one capture name + type when it is wide, not already
// recorded, and not reassigned by the enclosing function.
function wcaps_add(acc: WCaps, name: string, ty: string, atargets: string[]): WCaps {
    if (!is_wide_cap_type(ty)) { return acc; }
    if (util.index_of_str(acc.names, name) >= 0) { return acc; }
    if (util.index_of_str(atargets, name) >= 0) { return acc; }
    return WCaps { names: acc.names.append(name), types: acc.types.append(ty) };
}

function wcaps_join(a: WCaps, b: WCaps): WCaps {
    var out: WCaps = a;
    var i: i32 = 0;
    while (i < b.names.len()) {
        if (util.index_of_str(out.names, b.names[i]) < 0) {
            out = WCaps { names: out.names.append(b.names[i]), types: out.types.append(b.types[i]) };
        }
        i = i + 1;
    }
    return out;
}

// wcap_cell_decl builds `var $wc$c: T[] = [c];` — the snapshot cell.
function wcap_cell_decl(c: string, ty: string): ast.Stmt {
    var src: ast.Expr = ast.ExprIdent { name: c, line: 0, col: 0, ty: "" };
    return ast.StmtVar { name: wcap_cell_name(c), type_name: ty + "[]", init: ast.ExprArray { elements: [src], elem_ty: ty, line: 0, col: 0 }, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
}

// wcap_cell_read builds `var c: T = $wc$c[0];` — the lambda-body re-bind.
function wcap_cell_read(c: string, ty: string): ast.Stmt {
    var cell: ast.Expr = ast.ExprIdent { name: wcap_cell_name(c), line: 0, col: 0, ty: "" };
    var idx: ast.Expr = ast.ExprIndex { array: cell, index: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 }, unchecked: false, ty: "" };
    return ast.StmtVar { name: c, type_name: ty, init: idx, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
}

// wcap_expr walks one expression, rewriting every lambda in it (prepending the
// cell reads for ITS wide captures) and accumulating the wide captures seen, so
// the caller can emit their cell decls before the enclosing statement. Mirrors
// box_rewrite_expr's recursion set — the proven list of forms a lambda can hide
// in. Collection and rewriting are fused so the tree is walked once.
function wcap_expr(e: ast.Expr, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs, acc: WCaps, atargets: string[]): WCapExpr {
    match (e) {
        ast.ExprLambda(lm) => {
            // This lambda's own wide captures, in lambda_captures order.
            var mine: WCaps = WCaps { names: [], types: [] };
            var caps: string[] = lambda_captures(lm, fd);
            var ci: i32 = 0;
            while (ci < caps.len()) {
                mine = wcaps_add(mine, caps[ci], cap_type(caps[ci], fd, structs, mfuncs), atargets);
                ci = ci + 1;
            }
            // Rewrite the body first (a nested lambda's own cells are emitted
            // by the recursive statement walk), then re-bind this lambda's wide
            // captures from their cells at the top of the body.
            var inner: WCaps = acc;
            var nb: ast.Stmt[] = [];
            var bi: i32 = 0;
            while (bi < lm.body.len()) {
                var rs: WCapStmt = wcap_stmt(lm.body[bi], fd, gfns, structs, mfuncs, inner, atargets);
                inner = rs.caps;
                nb = nb.append(rs.stmt);
                bi = bi + 1;
            }
            var pre: ast.Stmt[] = [];
            var mi: i32 = 0;
            while (mi < mine.names.len()) { pre = pre.append(wcap_cell_read(mine.names[mi], mine.types[mi])); mi = mi + 1; }
            var full: ast.Stmt[] = pre;
            var fi: i32 = 0;
            while (fi < nb.len()) { full = full.append(nb[fi]); fi = fi + 1; }
            return WCapExpr { expr: ast.ExprLambda { ...lm, body: full }, caps: wcaps_join(inner, mine) };
        },
        ast.ExprBinary(b) => {
            var l: WCapExpr = wcap_expr(b.left, fd, gfns, structs, mfuncs, acc, atargets);
            var r: WCapExpr = wcap_expr(b.right, fd, gfns, structs, mfuncs, l.caps, atargets);
            return WCapExpr { expr: ast.ExprBinary { op: b.op, left: l.expr, right: r.expr, line: b.line, col: b.col, ty: b.ty }, caps: r.caps };
        },
        ast.ExprUnary(u) => {
            var o: WCapExpr = wcap_expr(u.operand, fd, gfns, structs, mfuncs, acc, atargets);
            return WCapExpr { expr: ast.ExprUnary { op: u.op, operand: o.expr, line: u.line, col: u.col, ty: u.ty }, caps: o.caps };
        },
        ast.ExprCall(c) => {
            // An IMMEDIATELY-INVOKED lambda never reaches the env box, so its
            // wide captures need no cell — the same argument
            // wcap_stmt_needs_env_box already makes for a `var f = <lambda>`
            // that is only ever direct-called, applied to the other shape that
            // cannot escape. Recurse into the body (a lambda nested THERE may
            // still escape) but leave this lambda's own captures alone.
            if (is_iife_callee(c)) {
                match (c.callee) {
                    ast.ExprLambda(ilm) => {
                        var iacc: WCaps = acc;
                        var ib: ast.Stmt[] = [];
                        var ii: i32 = 0;
                        while (ii < ilm.body.len()) {
                            var irs: WCapStmt = wcap_stmt(ilm.body[ii], fd, gfns, structs, mfuncs, iacc, atargets);
                            iacc = irs.caps;
                            ib = ib.append(irs.stmt);
                            ii = ii + 1;
                        }
                        var ilam: ast.Expr = ast.ExprLambda { ...ilm, body: ib };
                        var noargs: ast.Expr[] = [];
                        return WCapExpr { expr: ast.ExprCall { callee: ilam, args: noargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty }, caps: iacc };
                    },
                    _ => {}
                }
            }
            var cal: WCapExpr = wcap_expr(c.callee, fd, gfns, structs, mfuncs, acc, atargets);
            var a: WCaps = cal.caps;
            var na: ast.Expr[] = [];
            for arg in c.args {
                var ar: WCapExpr = wcap_expr(arg, fd, gfns, structs, mfuncs, a, atargets);
                a = ar.caps; na = na.append(ar.expr);
            }
            return WCapExpr { expr: ast.ExprCall { callee: cal.expr, args: na, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty }, caps: a };
        },
        ast.ExprArray(ar) => {
            var a: WCaps = acc;
            var ne: ast.Expr[] = [];
            var i: i32 = 0;
            while (i < ar.elements.len()) {
                var er: WCapExpr = wcap_expr(ar.elements[i], fd, gfns, structs, mfuncs, a, atargets);
                a = er.caps; ne = ne.append(er.expr); i = i + 1;
            }
            return WCapExpr { expr: ast.ExprArray { ...ar, elements: ne }, caps: a };
        },
        ast.ExprTuple(t) => {
            var a: WCaps = acc;
            var ne: ast.Expr[] = [];
            for el in t.elements {
                var er: WCapExpr = wcap_expr(el, fd, gfns, structs, mfuncs, a, atargets);
                a = er.caps; ne = ne.append(er.expr); 
            }
            return WCapExpr { expr: ast.ExprTuple { elements: ne, line: t.line, col: t.col }, caps: a };
        },
        ast.ExprIndex(x) => {
            var ax: WCapExpr = wcap_expr(x.array, fd, gfns, structs, mfuncs, acc, atargets);
            var ix: WCapExpr = wcap_expr(x.index, fd, gfns, structs, mfuncs, ax.caps, atargets);
            return WCapExpr { expr: ast.ExprIndex { array: ax.expr, index: ix.expr, unchecked: x.unchecked, ty: x.ty }, caps: ix.caps };
        },
        ast.ExprSlice(sl) => {
            var sa: WCapExpr = wcap_expr(sl.array, fd, gfns, structs, mfuncs, acc, atargets);
            var ss: WCapExpr = wcap_expr(sl.start, fd, gfns, structs, mfuncs, sa.caps, atargets);
            var se: WCapExpr = wcap_expr(sl.end, fd, gfns, structs, mfuncs, ss.caps, atargets);
            return WCapExpr { expr: ast.ExprSlice { array: sa.expr, start: ss.expr, end: se.expr, ty: sl.ty, open_end: sl.open_end }, caps: se.caps };
        },
        ast.ExprStructLit(sl) => {
            var a: WCaps = acc;
            var nv: ast.Expr[] = [];
            for fv in sl.field_values {
                var fr: WCapExpr = wcap_expr(fv, fd, gfns, structs, mfuncs, a, atargets);
                a = fr.caps; nv = nv.append(fr.expr); 
            }
            var nbase: ast.Expr = sl.base;
            if (sl.has_base) {
                var br: WCapExpr = wcap_expr(sl.base, fd, gfns, structs, mfuncs, a, atargets);
                a = br.caps; nbase = br.expr;
            }
            return WCapExpr { expr: ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col }, caps: a };
        },
        ast.ExprFieldAccess(fa) => {
            var o: WCapExpr = wcap_expr(fa.obj, fd, gfns, structs, mfuncs, acc, atargets);
            return WCapExpr { expr: ast.ExprFieldAccess { obj: o.expr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, caps: o.caps };
        },
        _ => { return WCapExpr { expr: e, caps: acc }; }
    }
    return WCapExpr { expr: e, caps: acc };
}

// wcap_stmt rewrites the lambdas in one statement's OWN expressions, returning
// the caps whose cell decls the caller must emit before it. A statement with a
// nested block (if / while / for / match / defer) has that block rewritten by
// box_wide_captures_stmts, which places its cells INSIDE the block — a capture
// declared in the block must not have its cell hoisted out of scope.
function wcap_stmt(st: ast.Stmt, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs, acc: WCaps, atargets: string[]): WCapStmt {
    match (st) {
        ast.StmtVar(v) => {
            var r: WCapExpr = wcap_expr(v.init, fd, gfns, structs, mfuncs, acc, atargets);
            return WCapStmt { stmt: ast.StmtVar { name: v.name, type_name: v.type_name, init: r.expr, line: v.line, col: v.col, is_str: v.is_str, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }, caps: r.caps, changed: false };
        },
        ast.StmtAssign(a) => {
            var r: WCapExpr = wcap_expr(a.value, fd, gfns, structs, mfuncs, acc, atargets);
            return WCapStmt { stmt: ast.StmtAssign { target: a.target, value: r.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, caps: r.caps, changed: false };
        },
        ast.StmtReturn(r) => {
            var rr: WCapExpr = wcap_expr(r.value, fd, gfns, structs, mfuncs, acc, atargets);
            return WCapStmt { stmt: ast.StmtReturn { value: rr.expr, line: r.line, col: r.col }, caps: rr.caps, changed: false };
        },
        ast.StmtExpr(e) => {
            var er: WCapExpr = wcap_expr(e.value, fd, gfns, structs, mfuncs, acc, atargets);
            return WCapStmt { stmt: ast.StmtExpr { value: er.expr, line: 0 }, caps: er.caps, changed: false };
        },
        ast.StmtIf(f) => {
            var cr: WCapExpr = wcap_expr(f.cond, fd, gfns, structs, mfuncs, acc, atargets);
            var tb: WCapBody = box_wide_captures_stmts(f.then_body, fd, gfns, structs, mfuncs, atargets);
            var eb: WCapBody = box_wide_captures_stmts(f.else_body, fd, gfns, structs, mfuncs, atargets);
            return WCapStmt { stmt: ast.StmtIf { cond: cr.expr, then_body: tb.stmts, else_body: eb.stmts, line: 0, else_chained: false, sugar: parser.no_match_sugar(), origin: "" }, caps: cr.caps, changed: tb.changed || eb.changed };
        },
        ast.StmtWhile(w) => {
            var cr: WCapExpr = wcap_expr(w.cond, fd, gfns, structs, mfuncs, acc, atargets);
            var wb: WCapBody = box_wide_captures_stmts(w.body, fd, gfns, structs, mfuncs, atargets);
            return WCapStmt { stmt: ast.StmtWhile { cond: cr.expr, body: wb.stmts, label: w.label, line: w.line, is_loop: w.is_loop }, caps: cr.caps, changed: wb.changed };
        },
        ast.StmtFor(fr) => {
            var itr: WCapExpr = wcap_expr(fr.iter, fd, gfns, structs, mfuncs, acc, atargets);
            var fb: WCapBody = box_wide_captures_stmts(fr.body, fd, gfns, structs, mfuncs, atargets);
            return WCapStmt { stmt: ast.StmtFor { var_name: fr.var_name, iter: itr.expr, body: fb.stmts, label: fr.label, line: fr.line }, caps: itr.caps, changed: fb.changed };
        },
        ast.StmtMatch(m) => {
            var sr: WCapExpr = wcap_expr(m.scrutinee, fd, gfns, structs, mfuncs, acc, atargets);
            var a: WCaps = sr.caps;
            var mchanged: boolean = false;
            var na: ast.MatchArm[] = [];
            for arm in m.arms {
                var ng: ast.Expr = arm.guard;
                if (arm.has_guard) {
                    var gr: WCapExpr = wcap_expr(arm.guard, fd, gfns, structs, mfuncs, a, atargets);
                    a = gr.caps; ng = gr.expr;
                }
                var ab: WCapBody = box_wide_captures_stmts(arm.body, fd, gfns, structs, mfuncs, atargets);
                if (ab.changed) { mchanged = true; }
                na = na.append(ast.MatchArm { ...arm, body: ab.stmts, guard: ng });
            }
            return WCapStmt { stmt: ast.StmtMatch { ...m, scrutinee: sr.expr, arms: na }, caps: a, changed: mchanged };
        },
        _ => { return WCapStmt { stmt: st, caps: acc, changed: false }; }
    }
    return WCapStmt { stmt: st, caps: acc, changed: false };
}

// wcap_stmt_needs_env_box reports whether the lambda(s) in `stmts[i]` can reach
// the closure env box, i.e. whether a wide capture there needs a cell at all.
// The one shape that cannot is `var f = <lambda>` where `f` is only direct-
// called afterwards: the param-lift passes its captures as call arguments, no
// box involved, and a wide scalar rides an argument fine. Every other shape —
// a returned lambda, a lambda in call-argument / array-element / struct-field
// position, or a binding used as a value — goes through the box.
function wcap_stmt_needs_env_box(stmts: ast.Stmt[], i: i32): boolean {
    var bname: string = "";
    match (stmts[i]) {
        ast.StmtVar(v) => {
            match (v.init) { ast.ExprLambda(_) => { bname = v.name; }, _ => {} }
        },
        _ => {}
    }
    if (bname.len() == 0) { return true; }
    var j: i32 = i + 1;
    while (j < stmts.len()) {
        if (ident_used_as_value_stmt(stmts[j], bname)) { return true; }
        j = j + 1;
    }
    return false;
}

// box_wide_captures_stmts rewrites a statement list, emitting each statement's
// wide-capture cell decls immediately before it — so the cell is created after
// everything it reads is in scope, and inside whatever block that is.
function box_wide_captures_stmts(stmts: ast.Stmt[], fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs, atargets: string[]): WCapBody {
    var out: ast.Stmt[] = [];
    var changed: boolean = false;
    var i: i32 = 0;
    while (i < stmts.len()) {
        // A `var f = <lambda>` whose `f` is only ever DIRECTLY CALLED never
        // builds an env box: the param-lift hoists it to __lam_<k>(origparams…,
        // captures…) and threads the captures as call ARGUMENTS (#5301), which
        // carries a wide scalar natively. Cellaring those would be pure damage —
        // it broke `var f = () => base + 2000000000` over an i64 base, which had
        // always lowered. Same escape test box_mutated_scalar_captures uses.
        if (!wcap_stmt_needs_env_box(stmts, i)) {
            out = out.append(stmts[i]);
            i = i + 1;
            continue;
        }
        var empty: WCaps = WCaps { names: [], types: [] };
        var r: WCapStmt = wcap_stmt(stmts[i], fd, gfns, structs, mfuncs, empty, atargets);
        if (r.changed) { changed = true; }
        var ci: i32 = 0;
        while (ci < r.caps.names.len()) {
            out = out.append(wcap_cell_decl(r.caps.names[ci], r.caps.types[ci]));
            changed = true;
            ci = ci + 1;
        }
        out = out.append(r.stmt);
        i = i + 1;
    }
    return WCapBody { stmts: out, changed: changed };
}

// has_wide_cap_expr / _stmt / _stmts are the READ-ONLY detector: the same walk
// wcap_expr does, but answering "is there a wide capture here?" without building
// a single node. It exists because the rewriting walk rebuilds every statement
// and expression it visits, so running it speculatively on every function copied
// the whole compiler AST once per function and exhausted the 16 GiB arena
// (exit 125) long before it reached a function that needed rewriting. Detect
// first, rebuild only where it pays.
function has_wide_cap_expr(e: ast.Expr, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs, atargets: string[]): boolean {
    match (e) {
        ast.ExprLambda(lm) => {
            var caps: string[] = lambda_captures(lm, fd);
            var ci: i32 = 0;
            while (ci < caps.len()) {
                var cn: string = caps[ci];
                if (util.index_of_str(atargets, cn) < 0 && is_wide_cap_type(cap_type(cn, fd, structs, mfuncs))) { return true; }
                ci = ci + 1;
            }
            var si: i32 = 0;
            while (si < lm.body.len()) {
                if (has_wide_cap_stmt(lm.body[si], fd, gfns, structs, mfuncs, atargets)) { return true; }
                si = si + 1;
            }
            return false;
        },
        ast.ExprBinary(b) => { return has_wide_cap_expr(b.left, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(b.right, fd, gfns, structs, mfuncs, atargets); },
        ast.ExprUnary(u) => { return has_wide_cap_expr(u.operand, fd, gfns, structs, mfuncs, atargets); },
        ast.ExprCall(c) => {
            // Mirrors wcap_expr's IIFE exemption: an immediately-invoked
            // lambda's OWN wide captures need no cell, so looking at them here
            // would report work the rewriter declines to do — and
            // box_wide_captures would rebuild a body it did not change.
            if (is_iife_callee(c)) {
                match (c.callee) {
                    ast.ExprLambda(ilm) => {
                        var isi: i32 = 0;
                        while (isi < ilm.body.len()) {
                            if (has_wide_cap_stmt(ilm.body[isi], fd, gfns, structs, mfuncs, atargets)) { return true; }
                            isi = isi + 1;
                        }
                        return false;
                    },
                    _ => {}
                }
            }
            if (has_wide_cap_expr(c.callee, fd, gfns, structs, mfuncs, atargets)) { return true; }
            for arg in c.args {
                if (has_wide_cap_expr(arg, fd, gfns, structs, mfuncs, atargets)) { return true; }
            }
            return false;
        },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) {
                if (has_wide_cap_expr(ar.elements[i], fd, gfns, structs, mfuncs, atargets)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements {
                if (has_wide_cap_expr(el, fd, gfns, structs, mfuncs, atargets)) { return true; }
            }
            return false;
        },
        ast.ExprIndex(x) => { return has_wide_cap_expr(x.array, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(x.index, fd, gfns, structs, mfuncs, atargets); },
        ast.ExprSlice(sl) => { return has_wide_cap_expr(sl.array, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(sl.start, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(sl.end, fd, gfns, structs, mfuncs, atargets); },
        ast.ExprStructLit(sl) => {
            for fv in sl.field_values {
                if (has_wide_cap_expr(fv, fd, gfns, structs, mfuncs, atargets)) { return true; }
            }
            if (sl.has_base) { return has_wide_cap_expr(sl.base, fd, gfns, structs, mfuncs, atargets); }
            return false;
        },
        ast.ExprFieldAccess(fa) => { return has_wide_cap_expr(fa.obj, fd, gfns, structs, mfuncs, atargets); },
        _ => { return false; }
    }
    return false;
}

function has_wide_cap_stmt(st: ast.Stmt, fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs, atargets: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return has_wide_cap_expr(v.init, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtAssign(a) => { return has_wide_cap_expr(a.value, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtReturn(r) => { return has_wide_cap_expr(r.value, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtExpr(e) => { return has_wide_cap_expr(e.value, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtIf(f) => { return has_wide_cap_expr(f.cond, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(f.then_body, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(f.else_body, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtWhile(w) => { return has_wide_cap_expr(w.cond, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(w.body, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtFor(fr) => { return has_wide_cap_expr(fr.iter, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(fr.body, fd, gfns, structs, mfuncs, atargets); },
        ast.StmtMatch(m) => {
            if (has_wide_cap_expr(m.scrutinee, fd, gfns, structs, mfuncs, atargets)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && has_wide_cap_expr(arm.guard, fd, gfns, structs, mfuncs, atargets)) { return true; }
                if (has_wide_cap_stmts(arm.body, fd, gfns, structs, mfuncs, atargets)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function has_wide_cap_stmts(stmts: ast.Stmt[], fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs, atargets: string[]): boolean {
    for stmt in stmts {
        if (has_wide_cap_stmt(stmt, fd, gfns, structs, mfuncs, atargets)) { return true; }
    }
    return false;
}

// box_wide_captures is the per-function entry point (step 0-pre of the lift
// pipeline). The read-only detector runs first: the rewriting walk rebuilds
// every node it visits, so it must only run on a function that actually has a
// wide capture — otherwise it copies the entire compiler AST function by
// function and exhausts the arena.
function box_wide_captures(fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): parser.FuncDecl {
    var atargets: string[] = body_assign_targets(fd.body);
    if (!has_wide_cap_stmts(fd.body, fd, gfns, structs, mfuncs, atargets)) { return fd; }
    var b: WCapBody = box_wide_captures_stmts(fd.body, fd, gfns, structs, mfuncs, atargets);
    if (!b.changed) { return fd; }
    return parser.FuncDecl { ...fd, body: b.stmts };
}

// box_mutated_scalar_captures finds `fd`'s locals to box into shared cells
// (see the block comment above): i32/boolean captures a lambda body writes
// (#2850), and — for ESCAPING bindings — captures of any type that the outer
// body reassigns (#5394). Returns `fd` unchanged when none qualify (lambda-free
// and read-only-capture functions stay byte-identical).
function box_mutated_scalar_captures(fd: parser.FuncDecl, gfns: string[], structs: parser.StructDecl[], mfuncs: MFuncs): parser.FuncDecl {
    var otargets: string[] = body_assign_targets(fd.body);
    var dvars: string[] = body_var_decl_names(fd.body);
    var acc: BoxScan = box_scan_stmts(fd.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: [], types: [] });
    var boxed: string[] = acc.names;
    var btypes: string[] = acc.types;
    if (boxed.len() == 0) { return fd; }
    // The DECLARATION SITE of each boxed name, so the rewrite can tell the `var`
    // the cell is built from apart from a re-declaration of the same spelling
    // (#7253). First-in-source, which is what cap_type_at resolved the capture's
    // type against, so the two agree on which binding the cell stands for.
    var bsites: string[] = [];
    var si: i32 = 0;
    while (si < boxed.len()) { bsites = bsites.append(first_var_site(fd.body, boxed[si])); si = si + 1; }
    var bound: string[] = [];
    return parser.FuncDecl { ...fd, body: box_rewrite_stmts(fd.body, boxed, btypes, bsites, bound) };
}

// first_var_site: the binding-site key of the FIRST `var <name>` in `stmts`,
// pre-order, or "" when the name is a parameter or is never `var`-declared (a
// boxed parameter has no cell declaration to match, so nothing is rewritten
// into one and every read of it stays a read of the parameter).
function first_var_site(stmts: ast.Stmt[], name: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return reclaim_site_key_of(v.name, v.line, v.col); } },
            ast.StmtIf(f) => {
                var t: string = first_var_site(f.then_body, name);
                if (t.len() > 0) { return t; }
                var e2: string = first_var_site(f.else_body, name);
                if (e2.len() > 0) { return e2; }
            },
            ast.StmtWhile(w) => { var t: string = first_var_site(w.body, name); if (t.len() > 0) { return t; } },
            ast.StmtFor(fo) => { var t: string = first_var_site(fo.body, name); if (t.len() > 0) { return t; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    var t: string = first_var_site(arm.body, name);
                    if (t.len() > 0) { return t; }
                }
            },
            ast.StmtDefer(d) => { var t: string = first_var_site([d.action], name); if (t.len() > 0) { return t; } },
            _ => {}
        }
    }
    return "";
}

// BoxScan: box_scan_stmts' paired accumulator — boxed capture NAMES and the
// cell TYPE each is rewritten to.
struct BoxScan { names: string[], types: string[] }

// box_scan_stmts walks one statement LIST for the two lambda-binding shapes
// box_mutated_scalar_captures recognises, and recurses into nested blocks
// (#6539). The scan used to run over `fd.body` alone, so a `var g = <lambda>`
// one block deeper — the overwhelmingly common spelling, inside a loop — was
// never seen and its mutated capture kept the construction-time snapshot.
// Measured: the identical binding returned the reference answer at top level
// and the stale one inside a `while`.
//
// The escape test scans the REMAINDER OF THE SAME BLOCK, which is the scope
// that can still use the binding as a value. `esc` only ever widens what is
// boxed, and boxing an already-correct read-only capture is a representation
// change rather than a behaviour one, so a block-local answer is the
// conservative direction here.
function box_scan_stmts(stmts: ast.Stmt[], fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs, otargets: string[], dvars: string[], acc: BoxScan): BoxScan {
    var boxed: string[] = acc.names;
    var btypes: string[] = acc.types;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var lam_ok: boolean = false;
        var bname: string = "";
        var lam: ast.ExprLambda = ast.ExprLambda { params: [], ret_type: "", body: [], use_infer: false, origin: "", line: 0, col: 0 };
        var nested: ast.ExprLambda[] = [];
        match (stmts[i]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprLambda(l) => { lam = l; lam_ok = true; bname = v.name; },
                    _ => { nested = box_nested_lambdas(v.init, nested); }
                }
            },
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprLambda(l) => { lam = l; lam_ok = true; },
                    _ => { nested = box_nested_lambdas(r.value, nested); }
                }
            },
            ast.StmtAssign(a2) => { nested = box_nested_lambdas(a2.value, nested); },
            ast.StmtExpr(e2) => { nested = box_nested_lambdas(e2.value, nested); },
            ast.StmtIf(f) => {
                var a1: BoxScan = box_scan_stmts(f.then_body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
                var a2: BoxScan = box_scan_stmts(f.else_body, fd, structs, mfuncs, otargets, dvars, a1);
                boxed = a2.names; btypes = a2.types;
            },
            ast.StmtWhile(w) => {
                var aw: BoxScan = box_scan_stmts(w.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
                boxed = aw.names; btypes = aw.types;
            },
            ast.StmtFor(fo) => {
                var af: BoxScan = box_scan_stmts(fo.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
                boxed = af.names; btypes = af.types;
            },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    var am: BoxScan = box_scan_stmts(arm.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
                    boxed = am.names; btypes = am.types;
                }
            },
            _ => {}
        }
        // A lambda in an OPERAND position — a struct-literal field, a call
        // argument, an array element (#6539). The `var f = <lambda>` /
        // `return <lambda>` shapes above match only when the value IS a
        // lambda, so these were invisible at any depth: the capture kept its
        // construction-time snapshot even at top level. Such a lambda is
        // ESCAPING by construction — it is being stored into or passed to
        // something, which is the make_closure env-box path whose snapshot the
        // cell has to bypass — so it needs no `esc` test of its own.
        var ni: i32 = 0;
        while (ni < nested.len()) {
            var nacc: BoxScan = box_apply_lambda(nested[ni], true, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
            boxed = nacc.names; btypes = nacc.types;
            ni = ni + 1;
        }
        if (lam_ok) {
            var caps: string[] = lambda_captures(lam, fd);
            var wtargets: string[] = body_assign_targets(lam.body);
            // Escape test (#5394): a returned inline lambda (bname == "")
            // escapes by definition; a `var f = <lambda>` binding escapes when
            // `f` is later used as a VALUE (returned / passed / stored /
            // captured), not only direct-called. Only escaping bindings take
            // the make_closure env-box path whose creation-time snapshot the
            // cell must bypass; directly-called bindings get call-site capture
            // passing from the param-lift instead (#5301).
            var esc: boolean = true;
            if (bname.len() > 0) {
                esc = false;
                var esci: i32 = i + 1;
                while (esci < stmts.len()) {
                    if (ident_used_as_value_stmt(stmts[esci], bname)) { esc = true; }
                    esci = esci + 1;
                }
            }
            var ci: i32 = 0;
            while (ci < caps.len()) {
                var cn: string = caps[ci];
                var ct: string = cap_type(cn, fd, structs, mfuncs);
                if ((ct == "i32" || ct == "boolean") && util.index_of_str(wtargets, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
                    boxed = boxed.append(cn);
                    btypes = btypes.append("i32");
                } else if (esc && ct.len() > 0 && util.index_of_str(otargets, cn) >= 0
                        && util.index_of_str(dvars, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
                    boxed = boxed.append(cn);
                    btypes = btypes.append(ct);
                }
                ci = ci + 1;
            }
        }
        i = i + 1;
    }
    return BoxScan { names: boxed, types: btypes };
}

// box_apply_lambda applies the two boxing clauses to one lambda's captures:
// #2850 (an i32/boolean the LAMBDA body writes) and #5394 (any type the OUTER
// body reassigns, for an escaping binding). Shared by the statement-shape path
// and the operand-position path so the two cannot drift.
function box_apply_lambda(lam: ast.ExprLambda, esc: boolean, fd: parser.FuncDecl, structs: parser.StructDecl[], mfuncs: MFuncs, otargets: string[], dvars: string[], acc: BoxScan): BoxScan {
    var boxed: string[] = acc.names;
    var btypes: string[] = acc.types;
    var caps: string[] = lambda_captures(lam, fd);
    var wtargets: string[] = body_assign_targets(lam.body);
    var ci: i32 = 0;
    while (ci < caps.len()) {
        var cn: string = caps[ci];
        var ct: string = cap_type(cn, fd, structs, mfuncs);
        if ((ct == "i32" || ct == "boolean") && util.index_of_str(wtargets, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
            boxed = boxed.append(cn);
            btypes = btypes.append("i32");
        } else if (esc && ct.len() > 0 && util.index_of_str(otargets, cn) >= 0
                && util.index_of_str(dvars, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
            boxed = boxed.append(cn);
            btypes = btypes.append(ct);
        }
        ci = ci + 1;
    }
    return BoxScan { names: boxed, types: btypes };
}

// box_nested_lambdas collects lambdas sitting in OPERAND positions of `e` —
// struct-literal field, call argument or callee, array / tuple element, and the
// arithmetic operands. It deliberately does NOT descend into a collected
// lambda's own BODY: that is a different scope, whose captures belong to that
// lambda's own frame and are handled when it is itself lifted.
function box_nested_lambdas(e: ast.Expr, acc: ast.ExprLambda[]): ast.ExprLambda[] {
    var out: ast.ExprLambda[] = acc;
    match (e) {
        ast.ExprLambda(l) => { return out.append(l); },
        ast.ExprStructLit(sl) => {
            for fv in sl.field_values { out = box_nested_lambdas(fv, out); }
            if (sl.has_base) { out = box_nested_lambdas(sl.base, out); }
            return out;
        },
        ast.ExprCall(c) => {
            out = box_nested_lambdas(c.callee, out);
            for arg in c.args { out = box_nested_lambdas(arg, out); }
            return out;
        },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { out = box_nested_lambdas(ar.elements[i], out); i = i + 1; }
            return out;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { out = box_nested_lambdas(el, out); }
            return out;
        },
        ast.ExprBinary(b) => { return box_nested_lambdas(b.right, box_nested_lambdas(b.left, out)); },
        ast.ExprUnary(u) => { return box_nested_lambdas(u.operand, out); },
        ast.ExprIndex(ix) => { return box_nested_lambdas(ix.index, box_nested_lambdas(ix.array, out)); },
        ast.ExprFieldAccess(fa) => { return box_nested_lambdas(fa.obj, out); },
        _ => { return out; }
    }
    return out;
}

// name_source_iifes gives a hand-written IIFE a name, so the ordinary
// bound-lambda lift handles it.
//
// `(function(){ B })()` is exactly `var $iife$N = function(){ B }; $iife$N()`,
// and try_lift_binding already lifts a bound lambda that is only called. So
// rather than teach the lift walk a second shape — it only ever looks at a
// StmtVar initialiser — this normalises the shape it does not know into the one
// it does.
//
// Only the BINDING is hoisted; the call stays where it was. Constructing a
// lambda literal has no side effects, so evaluation order is unchanged.
//
// A MARKED value block is left alone: irlower inlines those, and its defers
// belong to the enclosing function (parser.is_value_block_origin). This pass
// exists for the unmarked one, whose defers belong to itself (#7192).
//
// Scope: an IIFE that is the whole of a `var` initialiser, a `return` value, an
// assignment value, or an expression statement, at any statement nesting depth.
// One nested inside a larger expression is left for the bail to name — the
// counter cannot be threaded through astwalk.map_expr's stateless callback, and
// a partial rewrite there would be worse than a diagnostic.
struct IifeNamed { stmts: ast.Stmt[], k: i32 }

function iife_is_source_written(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return false; }
            match (c.callee) {
                ast.ExprLambda(lm) => {
                    if (lm.params.len() != 0) { return false; }
                    return lm.origin == parser.ORIGIN_IIFE_SCOPED;
                },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function iife_lambda_of(e: ast.Expr): ast.Expr {
    match (e) {
        ast.ExprCall(c) => { return c.callee; },
        _ => { return e; }
    }
    return e;
}

function iife_name(fdname: string, k: i32): string {
    return "$iife$" + fdname + "$" + util.i32_to_string(k);
}

// iife_call_to replaces the IIFE's lambda callee with a reference to the name
// the hoisted binding introduced, keeping the call itself in place.
function iife_call_to(c: ast.ExprCall, nm: string): ast.Expr {
    return ast.ExprCall { ...c, callee: ast.ExprIdent { name: nm, line: c.line, col: c.col, ty: "" } };
}

// iife_bind is the hoisted `var <nm> = <lambda>;`. Untyped: the checker infers
// the lambda's own type, exactly as it does for a written `var f = () => …`.
function iife_bind(nm: string, lam: ast.Expr, line: i32, col: i32): ast.Stmt {
    return ast.StmtVar { name: nm, type_name: "", init: lam, line: line, col: col, is_str: false, fn_ret: "", fn_param_types: "" };
}

function name_source_iifes_stmts(stmts: ast.Stmt[], fdname: string, k0: i32): IifeNamed {
    var out: ast.Stmt[] = [];
    var k: i32 = k0;
    for stmt in stmts {
        var st: ast.Stmt = stmt;
        match (st) {
            ast.StmtVar(v) => {
                if (iife_is_source_written(v.init)) {
                    var nm: string = iife_name(fdname, k);
                    k = k + 1;
                    out = out.append(iife_bind(nm, iife_lambda_of(v.init), v.line, v.col));
                    match (v.init) {
                        ast.ExprCall(c) => { st = ast.StmtVar { ...v, init: iife_call_to(c, nm) }; },
                        _ => {}
                    }
                }
            },
            ast.StmtReturn(r) => {
                if (iife_is_source_written(r.value)) {
                    var nmr: string = iife_name(fdname, k);
                    k = k + 1;
                    out = out.append(iife_bind(nmr, iife_lambda_of(r.value), r.line, r.col));
                    match (r.value) {
                        ast.ExprCall(c2) => { st = ast.StmtReturn { ...r, value: iife_call_to(c2, nmr) }; },
                        _ => {}
                    }
                }
            },
            ast.StmtAssign(a) => {
                if (iife_is_source_written(a.value)) {
                    var nma: string = iife_name(fdname, k);
                    k = k + 1;
                    out = out.append(iife_bind(nma, iife_lambda_of(a.value), a.line, a.col));
                    match (a.value) {
                        ast.ExprCall(c3) => { st = ast.StmtAssign { ...a, value: iife_call_to(c3, nma) }; },
                        _ => {}
                    }
                }
            },
            ast.StmtExpr(x) => {
                if (iife_is_source_written(x.value)) {
                    var nmx: string = iife_name(fdname, k);
                    k = k + 1;
                    out = out.append(iife_bind(nmx, iife_lambda_of(x.value), x.line, 0));
                    match (x.value) {
                        ast.ExprCall(c4) => { st = ast.StmtExpr { ...x, value: iife_call_to(c4, nmx) }; },
                        _ => {}
                    }
                }
            },
            ast.StmtWhile(w) => {
                var rw: IifeNamed = name_source_iifes_stmts(w.body, fdname, k);
                k = rw.k;
                st = ast.StmtWhile { ...w, body: rw.stmts };
            },
            ast.StmtFor(f) => {
                var rf: IifeNamed = name_source_iifes_stmts(f.body, fdname, k);
                k = rf.k;
                st = ast.StmtFor { ...f, body: rf.stmts };
            },
            ast.StmtIf(ifs) => {
                var rt: IifeNamed = name_source_iifes_stmts(ifs.then_body, fdname, k);
                var re: IifeNamed = name_source_iifes_stmts(ifs.else_body, fdname, rt.k);
                k = re.k;
                st = ast.StmtIf { ...ifs, then_body: rt.stmts, else_body: re.stmts };
            },
            _ => {}
        }
        out = out.append(st);
    }
    return IifeNamed { stmts: out, k: k };
}

function name_source_iifes(fd: parser.FuncDecl): parser.FuncDecl {
    var r: IifeNamed = name_source_iifes_stmts(fd.body, fd.name, 0);
    if (r.k == 0) { return fd; }
    return parser.FuncDecl { ...fd, body: r.stmts };
}

// lift_lambdas is the module pre-pass. Returns the module unchanged when no
// lambda was lifted (keeping lambda-free modules byte-identical), else a module
// whose bodies reference the hoisted __lam_<k> functions, with those functions
// appended.
// unwrap_sole_iife_return beta-reduces a function whose ENTIRE body is
// `return (() => { … })()` — a 0-arg immediately-invoked lambda — to just that
// lambda's body. A block-body arrow lambda `() => { STMTS; value }` is
// represented as exactly this IIFE-return, so once such a lambda is lifted to a
// `__lam_N`, its body is `[return (IIFE)()]` and any lambda NESTED in the block
// stays buried inside the IIFE where closure_lift_one never descends → the inner
// lambda doesn't lift and the module bails. Inlining the
// IIFE (rather than hoisting it — which breaks enclosing-loop break/continue and
// match-expression payloads) is semantically neutral: no function boundary is
// added, so control flow and captures resolve exactly as before, and the block's
// nested lambdas become ordinary top-level statements the next closure_lift_one
// round lifts. Only the exact sole-`return`-0-arg-IIFE-0-args shape is touched.
function unwrap_sole_iife_return(fd: parser.FuncDecl): parser.FuncDecl {
    if (fd.body.len() != 1) { return fd; }
    match (fd.body[0]) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprCall(c) => {
                    if (c.args.len() != 0) { return fd; }
                    match (c.callee) {
                        ast.ExprLambda(lam) => {
                            if (lam.params.len() != 0) { return fd; }
                            // The spliced body carries the IIFE's arm returns
                            // into a function, past the pre-worklist `return
                            // <lambda>` desugar, so run it here on everything but
                            // the tail return (desugar_nontail_lambda_returns).
                            // Without it an arm lambda asked for a `<fd>$clo`
                            // nothing built.
                            return parser.FuncDecl { ...fd, body: desugar_nontail_lambda_returns(lam.body) };
                        },
                        _ => { return fd; }
                    }
                },
                _ => { return fd; }
            }
        },
        _ => { return fd; }
    }
    return fd;
}

pub function lift_lambdas(raw_mod: parser.Module): parser.Module {
    // Empty view = "this module is the whole program", the historical behaviour
    // every caller but the per-module concat wants.
    return lift_lambdas_view(raw_mod, []);
}

// module_sig_view is the whole-program signature view a PER-MODULE lift has to
// be given: the union of every part's declarations, collected BEFORE any of them
// is lifted. Collecting pre-lift is sound because lifting only ADDS `$wrap` /
// `__lam_` / `$clo` functions — it never changes a signature already there.
pub function module_sig_view(mods: parser.Module[]): parser.FuncDecl[] {
    var view: parser.FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mods.len()) {
        var f: i32 = 0;
        while (f < mods[i].funcs.len()) { view = view.append(mods[i].funcs[f]); f = f + 1; }
        i = i + 1;
    }
    return view;
}

// lift_lambdas_view is lift_lambdas with an explicit whole-program SIGNATURE
// view: `view` supplies the function declarations the pass consults to answer
// "is this callee's parameter fn-typed?" (lift_callee_param_is_fn), "how many
// params does this fn-name take?" (lift_module_fn_arity) and "what is this
// wrap trampoline's target signature?" (make_wrap_named_func), while the
// functions actually LIFTED remain the module's own.
//
// Those questions decide whether a fn-VALUE argument gets env-boxed at the call
// site. Answering them from the module's own functions is correct only when the
// callee lives in the module. In a per-module build it does not: the caller saw
// no declaration for `srv.apply(f, n)`, so it passed `f` as a raw code address
// while the callee — which always dereferences a box — read slot 1 of that
// address and jumped through garbage (#5698).
//
// An empty `view` means "use the module's own functions", so every caller that
// does not thread a view is byte-identical to before.
pub function lift_lambdas_view(raw_mod: parser.Module, view: parser.FuncDecl[]): parser.Module {
    // Fill omitted trailing arguments from default parameter values before the
    // IR path inspects the module, so `f(5)` to `f(a, b = 128)` reaches the IR
    // as `f(5, 128)`. No-op for default-free modules.
    // #3640 slice B.2: bind an unannotated `var f = mk` (mk a struct-returning
    // zero-arg fn) as a fn-value when `f` is later called, instead of const-
    // calling mk. Runs here on the shared IR funnel (both ircore.lift_lambdas and
    // wasm_ir.lift_lambdas wrap this), so the eligibility probe and the emit see
    // the same rewritten module; the slice-B.1 lower_func registration then
    // resolves the call-result struct.
    var mod: parser.Module = parser.infer_fnvalue_locals_module(parser.fill_default_args_module(raw_mod));
    // sigs is the signature table every "what does this callee look like?" query
    // below reads. It is the whole-program view when one was threaded in, else
    // the module's own functions (identical to the pre-view behaviour).
    var sigs: parser.FuncDecl[] = mod.funcs;
    if (view.len() > 0) { sigs = view; }
    // Indexed once here: sigs is settled before the drain and never changes
    // across its rounds, so every lift_callee_* lookup below shares one index.
    var mf: MFuncs = mfuncs_table(sigs);
    var gfns: string[] = [];
    var gi: i32 = 0;
    while (gi < sigs.len()) {
        if (sigs[gi].receiver_type.len() == 0) { gfns = gfns.append(sigs[gi].name); }
        gi = gi + 1;
    }
    // Indexed once for the whole lift (see gfns_visible_in).
    let (ghead, gnext) = gfn_index_of(gfns);
    var acc: LiftAcc = LiftAcc { funcs: [], counter: 0 };
    var newfuncs: parser.FuncDecl[] = [];
    // Worklist: the module's functions PLUS every function lifted out of a
    // lambda body. Re-processing the lifted `__lam_N` / `$clo` functions is what
    // lets a NESTED lambda (a lambda defined inside another lambda's body) lift:
    // the outer lift produces a top-level function whose body still holds the
    // inner lambda, which a later worklist round then lifts in turn. A two-level
    // capture resolves because the outer lift turns the captured outer var into a
    // PARAM of the lifted function, which the inner lift sees as an ordinary
    // param. Each round strips one nesting level, so the worklist terminates.
    // COPY mod.funcs into a fresh worklist rather than aliasing it: the drain
    // below (`worklist = worklist.append(...)`) must not mutate the caller's
    // `mod.funcs`. The Go backend's append reallocates (so mod is untouched),
    // but the self-host backend appends into the shared backing array in place,
    // so aliasing here leaks lifted `$wrap`/`$clo` trampolines back into the
    // input module — which the AST emit path (`emit_module` loops `mod.funcs`)
    // then emits, diverging the byte-identical self-host fixpoint. (#3445)
    // Desugar every inline `return <lambda>` in the ORIGINAL module functions to
    // `var $lamret$N = <lambda>; return $lamret$N;` (recursing into if/while/for/
    // match arms) as they enter the worklist, so the closure-lift pipeline treats a
    // returned lambda as an ordinary closure local — unique `$cloN` naming +
    // env-first dispatch — fixing the mis-dispatched / colliding / AST-bailing inline
    // lambda returns (#5266). Applied ONLY to source functions, not to the lifted
    // `__lam_N` / `$cloN` bodies drained onto the worklist later: a lifted body's own
    // `return <lambda>` is a lambda-returning-lambda (#5281), which the existing hoist
    // handles and this desugar must not perturb (it regressed the `curry` shape).
    var worklist: parser.FuncDecl[] = [];
    var wlcp: i32 = 0;
    while (wlcp < mod.funcs.len()) {
        var wf: parser.FuncDecl = mod.funcs[wlcp];
        var wdlr: DesugarRet = desugar_lambda_returns(wf.body, 0);
        if (wdlr.counter != 0) {
            wf = parser.FuncDecl { ...wf, body: wdlr.body };
        }
        worklist = worklist.append(wf); wlcp = wlcp + 1;
    }
    var wi: i32 = 0;
    while (wi < worklist.len()) {
        var fd: parser.FuncDecl = worklist[wi];
        // 0-pre. Beta-reduce a `return (() => {…})()` sole body (a lifted
        // block-body arrow lambda) so nested lambdas in the block become ordinary
        // statements the lifts below can reach (#nested-capture). Inline, not
        // hoist — control flow + captures stay in scope.
        fd = unwrap_sole_iife_return(fd);
        // 0-pre. Name a hand-written IIFE so the bound-lambda lift below sees a
        // shape it knows. Must run BEFORE the lifts, and after the beta-reduce
        // above so a genuine block-body arrow lambda is already gone (#7192).
        fd = name_source_iifes(fd);
        // 0-pre. Snapshot 8-byte scalar captures (i64 / u64 / f64) into 1-element
        // cells so they fit the env box's 32-bit slot (#6046). Must run BEFORE
        // the lifts so they see the `i64[]` cell — pointer-shaped, which
        // cap_slot_ok already accepts — instead of a wide scalar it declines.
        fd = box_wide_captures(fd, gfns, mod.structs, mf);
        // 0. Box captured-and-mutated scalar locals into 1-element array cells so
        // a closure's write to a captured outer scalar is shared by reference
        // (#2850). Must run BEFORE the closure lifts so they see the boxed cell
        // (an `i32[]` capture passed by pointer) instead of a by-value scalar.
        fd = box_mutated_scalar_captures(fd, gfns, mod.structs, mf);
        var before: i32 = acc.funcs.len();
        // 0b. Capturing inline lambdas in array-element / struct-field-value
        // position (#2994): hoist each to a unique `<fd>$cloN` and rewrite the
        // lambda to a `__mkclo$<fd>$cloN(caps…)` env-box marker. Runs BEFORE the
        // other lifts so they see the marker (an ordinary call they leave alone),
        // not a bare ExprLambda they'd skip. The hoisted funcs join `acc` so the
        // drain below re-processes them (their own nested lambdas lift in a later
        // round); a body with no such closure is returned unchanged (fixpoint-safe).
        var (ic_stmts, ic_funcs) = lift_inline_closures(fd, gfns, mod.structs, mf);
        if (ic_funcs.len() > 0) {
            fd = parser.FuncDecl { ...fd, body: ic_stmts };
            var ici: i32 = 0;
            while (ici < ic_funcs.len()) { acc = LiftAcc { funcs: acc.funcs.append(ic_funcs[ici]), counter: acc.counter + 1 }; ici = ici + 1; }
        }
        // 1. Capturing lambdas bound to a local + only directly called: param-lift.
        // Each round extends the global-fn set with the lambdas hoisted so far
        // (their `__lam_N` names), so a sibling lambda that CALLS an already-
        // hoisted capture-free lambda sees it as a global — not a capture it
        // can't type — and lifts too (closure-calls-closure).
        var cbody: ast.Stmt[] = fd.body;
        var more: boolean = true;
        while (more) {
            var lgfns: string[] = gfns;
            var gj: i32 = 0;
            while (gj < acc.funcs.len()) { lgfns = lgfns.append(acc.funcs[gj].name); gj = gj + 1; }
            var cl: ClosureLift = closure_lift_one(cbody, fd, acc, lgfns, mod.structs, mf);
            cbody = cl.body;
            acc = cl.acc;
            more = cl.changed;
        }
        // 2. No-capture lambdas passed as call arguments: hoist to function values.
        // The module-fn list is filtered to what is still VISIBLE here: a name
        // this function also binds is a local, not a call target (#7253).
        var r: LiftStmts = lift_stmts(cbody, acc, gfns_visible_in(fd, gfns, ghead, gnext));
        acc = r.acc;
        var nb: ast.Stmt[] = r.stmts;
        newfuncs = newfuncs.append(parser.FuncDecl { ...fd, body: nb });
        // 3. First-class (escaping) closure: a `return <capturing lambda>` hoists
        // its body to `<fd>$clo`. The lambda stays in the body (irlower lowers it
        // to a make_closure box); only the hoisted target is appended here.
        // The functions lifted for THIS entry join the signature list: a capture
        // whose lambda the lift already replaced with an env-box marker resolves
        // its signature through the hoisted target (cap_param_for).
        var hsigs: MFuncs = mf;
        if (acc.funcs.len() > 0) { hsigs = mfuncs_extend(mf, acc.funcs); }
        var hc: HoistResult = hoist_escaping_closure(fd, gfns, mod.structs, hsigs);
        if (hc.ok) { acc = LiftAcc { funcs: acc.funcs.append(hc.func), counter: acc.counter + 1 }; }
        // Drain the functions lifted by THIS iteration onto the worklist so their
        // OWN nested lambdas lift in a later round, then clear them (the counter
        // persists across iterations for unique `__lam_N` naming).
        var k: i32 = before;
        while (k < acc.funcs.len()) { worklist = worklist.append(acc.funcs[k]); k = k + 1; }
        acc = LiftAcc { funcs: [], counter: acc.counter };
        wi = wi + 1;
    }
    // Normalise the lifted module for the IR path, mirroring the transient-node
    // pass module_with_builtins runs:
    //   * lower `defer` / `errdefer` → the action scheduled at every scope exit
    //     (cf. lower_defers).
    // Without this a module whose only IR-ineligible construct was a defer
    // bailed in full. Applied to the FINAL lifted module so defers inside
    // lifted-lambda bodies (now top-level funcs in `newfuncs`) are covered —
    // lower_defers doesn't descend into lambda bodies, but after lifting those
    // bodies are ordinary functions.
    var result: parser.Module = mod;
    if (acc.counter != 0) {
        result = parser.Module { funcs: stamp_fn_local_types(newfuncs), structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls };
    }
    // Infer return types on the FINAL lifted module so a lifted lambda with an
    // inferred (empty) ret_type that returns i64/u64 is typed BEFORE eligibility
    // lowers it. Without this, eligibility ran on the un-inferred module and
    // `lower` bailed on the wide return (ret_is_i64 unknown) → the lambda took
    // the whole module out of the IR subset, even though EMIT (which runs on the
    // separately-inferred module) would have handled it.
    // infer_ret_types_module only fills EMPTY ret_types (annotated fns untouched)
    // and is idempotent with the drivers' own downstream infer pass.
    return parser.infer_ret_types_module(parser.lower_defers_module(result));
}

// ============== #4873 port: cross-function in-place growth containment ==============
//
// The consume-form array append (op_arr_push) mutates its receiver buffer in
// place when the backend's grow helper sees rc==1. A function PARAM is
// borrowed (no call-site inc), so the caller's binding aliases the buffer at
// the same rc — a callee append on a param that is unobservable inside the
// callee silently mutates a caller that keeps its argument live
// (`var c = grow(a, 3)` grew `a`; interp copies — issue #4873). Containment
// is CALLER-side, mirroring the native fix: fn_param_sigs gains flag '4' for
// array params the callee may grow in place (directly or transitively), and
// the user-call lowering brackets each SURVIVING ident arg at such a
// position with __fern_rc_inc before / __fern_rc_dec after — the callee's
// uniqueness gate then takes the copy path. Args that DIE at the statement
// (the strict occurs-once self-reassign `x = f(.., x, ..)` and
// return-position `return f(.., x, ..)` shapes — grow_exempt, set around
// each statement by lower_stmt) skip the bracket, keeping the accumulator
// chains and recursive tails on the O(n) in-place fast path. The struct- and
// field-read append forms already route through the CLONE lowering
// (lower_arr_append_value), so bare-ident params are the only seeding shape.

// grow_ident_count: occurrences of `name` among the idents of `e`.
function grow_ident_count(e: ast.Expr, name: string): i32 {
    var ids: string[] = astwalk.collect_idents_expr(e, []);
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < ids.len()) {
        if (ids[i] == name) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// collect_append_recvs_expr appends the receiver NAME of every
// `<ident>.append(v)` / `<ident>.set(i, v)` call in `e` (recursing all
// expression containers; a nested lambda recurses plainly — an inner
// param shadowing an outer name only over-collects, which at worst adds a
// harmless extra bracket).
function collect_append_recvs_expr(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprBinary(b) => {
            acc = collect_append_recvs_expr(b.left, acc);
            return collect_append_recvs_expr(b.right, acc);
        },
        ast.ExprUnary(u) => { return collect_append_recvs_expr(u.operand, acc); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "append" && c.args.len() == 1) || (cfa.field == "set" && c.args.len() == 2)) {
                        match (cfa.obj) {
                            ast.ExprIdent(rid) => { acc = acc.append(rid.name); },
                            _ => {}
                        }
                    }
                    acc = collect_append_recvs_expr(cfa.obj, acc);
                },
                _ => { acc = collect_append_recvs_expr(c.callee, acc); }
            }
            for arg in c.args {
                acc = collect_append_recvs_expr(arg, acc);
            }
            return acc;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = collect_append_recvs_expr(a.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        ast.ExprTuple(t) => {
            for el in t.elements {
                acc = collect_append_recvs_expr(el, acc);
            }
            return acc;
        },
        ast.ExprIndex(x) => {
            acc = collect_append_recvs_expr(x.array, acc);
            return collect_append_recvs_expr(x.index, acc);
        },
        ast.ExprSlice(sl) => {
            acc = collect_append_recvs_expr(sl.array, acc);
            acc = collect_append_recvs_expr(sl.start, acc);
            return collect_append_recvs_expr(sl.end, acc);
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { acc = collect_append_recvs_expr(sl.base, acc); }
            for fv in sl.field_values {
                acc = collect_append_recvs_expr(fv, acc);
            }
            return acc;
        },
        ast.ExprFieldAccess(fa) => { return collect_append_recvs_expr(fa.obj, acc); },
        ast.ExprMapLit(ml) => {
            var i: i32 = 0;
            while (i < ml.keys.len()) { acc = collect_append_recvs_expr(ml.keys[i], acc); i = i + 1; }
            var j: i32 = 0;
            while (j < ml.vals.len()) { acc = collect_append_recvs_expr(ml.vals[j], acc); j = j + 1; }
            return acc;
        },
        ast.ExprFString(fs) => {
            var i: i32 = 0;
            while (i < fs.exprs.len()) { acc = collect_append_recvs_expr(fs.exprs[i], acc); i = i + 1; }
            return acc;
        },
        ast.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                acc = collect_append_recvs_stmt(lm.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

function collect_append_recvs_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtDefer(d) => { return collect_append_recvs_stmt(d.action, acc); },
        ast.StmtVar(v) => { return collect_append_recvs_expr(v.init, acc); },
        ast.StmtReturn(r) => { return collect_append_recvs_expr(r.value, acc); },
        ast.StmtExpr(e) => { return collect_append_recvs_expr(e.value, acc); },
        ast.StmtAssign(a) => { return collect_append_recvs_expr(a.value, acc); },
        ast.StmtIf(f) => {
            acc = collect_append_recvs_expr(f.cond, acc);
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { acc = collect_append_recvs_stmt(f.then_body[ti], acc); ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { acc = collect_append_recvs_stmt(f.else_body[ei], acc); ei = ei + 1; }
            return acc;
        },
        ast.StmtWhile(w) => {
            acc = collect_append_recvs_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) { acc = collect_append_recvs_stmt(w.body[i], acc); i = i + 1; }
            return acc;
        },
        ast.StmtFor(f2) => {
            acc = collect_append_recvs_expr(f2.iter, acc);
            var i: i32 = 0;
            while (i < f2.body.len()) { acc = collect_append_recvs_stmt(f2.body[i], acc); i = i + 1; }
            return acc;
        },
        ast.StmtMatch(m) => {
            acc = collect_append_recvs_expr(m.scrutinee, acc);
            for arm in m.arms {
                var bi: i32 = 0;
                while (bi < arm.body.len()) { acc = collect_append_recvs_stmt(arm.body[bi], acc); bi = bi + 1; }
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// grow_dying_passes collects, per function, the DYING pass-through sites:
// "callee|argindex|paramname" for each direct ident arg that is one of the
// fn's params passed in a shape the caller-side bracket exempts (the
// occurs-once self-reassign / return-position rules). Used by the fixpoint
// to propagate may-grow flags through unbracketed pass-throughs.
function grow_dying_passes_stmt(st: ast.Stmt, params: string[], acc: string[]): string[] {
    match (st) {
        ast.StmtAssign(a) => {
            match (a.value) {
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprIdent(cid) => {
                            var ai: i32 = 0;
                            while (ai < c.args.len()) {
                                match (c.args[ai]) {
                                    ast.ExprIdent(aid) => {
                                        if (aid.name == a.target && util.index_of_str(params, aid.name) >= 0
                                            && grow_ident_count(a.value, aid.name) == 1) {
                                            acc = acc.append(cid.name + "|" + util.i32_to_string(ai) + "|" + aid.name);
                                        }
                                    },
                                    _ => {}
                                }
                                ai = ai + 1;
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return acc;
        },
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprIdent(cid) => {
                            var ai: i32 = 0;
                            while (ai < c.args.len()) {
                                match (c.args[ai]) {
                                    ast.ExprIdent(aid) => {
                                        if (util.index_of_str(params, aid.name) >= 0
                                            && grow_ident_count(r.value, aid.name) == 1) {
                                            acc = acc.append(cid.name + "|" + util.i32_to_string(ai) + "|" + aid.name);
                                        }
                                    },
                                    _ => {}
                                }
                                ai = ai + 1;
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return acc;
        },
        ast.StmtIf(f) => {
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { acc = grow_dying_passes_stmt(f.then_body[ti], params, acc); ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { acc = grow_dying_passes_stmt(f.else_body[ei], params, acc); ei = ei + 1; }
            return acc;
        },
        ast.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) { acc = grow_dying_passes_stmt(w.body[i], params, acc); i = i + 1; }
            return acc;
        },
        ast.StmtFor(f2) => {
            var i: i32 = 0;
            while (i < f2.body.len()) { acc = grow_dying_passes_stmt(f2.body[i], params, acc); i = i + 1; }
            return acc;
        },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                var bi: i32 = 0;
                while (bi < arm.body.len()) { acc = grow_dying_passes_stmt(arm.body[bi], params, acc); bi = bi + 1; }
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// own_positions_of lists "fname|idx" for every declared `own` parameter of a
// free function. A caller rebinding a local from such a call (`x = f(x)`) must
// not release on an identity return: it moved its reference in, and the callee
// hands the same buffer back without the return-transfer retain.
pub function own_positions_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_name.len() > 0) { continue; }
        var i: i32 = 0;
        while (i < fn.params.len()) {
            if (fn.params[i].own) { out = out.append(fn.name + "|" + util.i32_to_string(i)); }
            i = i + 1;
        }
    }
    return out;
}

// consumed_arr_positions_of lists "fname|idx" for every consumed-threaded
// array parameter of a free function: reassigned in the body and not `own`,
// the predicate lower_func allocates an ownership flag for.
pub function consumed_arr_positions_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_name.len() > 0) { continue; }
        var reassigned: string[] = body_assign_targets(fn.body);
        var i: i32 = 0;
        while (i < fn.params.len()) {
            var p: ast.ParamDecl = fn.params[i];
            if (!p.own && is_array_type_name(p.type_name) && util.index_of_str(reassigned, p.name) >= 0) {
                out = out.append(fn.name + "|" + util.i32_to_string(i));
            }
            i = i + 1;
        }
    }
    return out;
}

// grow_param_flags_of computes, per FREE function, a '0'/'1'-per-param mask
// of the array params the function may grow in place: seeded from a direct
// `<param>.append(v)` / `.set` anywhere in the body, then closed
// transitively over dying pass-throughs (grow_dying_passes). Only
// array-typed params are eligible. Returned as "name|mask" entries for
// functions with at least one '1'.
pub function grow_param_flags_of(funcs: parser.FuncDecl[]): string[] {
    // One mask per func, appended in order: the working per-param mask.
    var masks: string[] = [];
    for fnk in funcs {
        var recvs: string[] = [];
        var si: i32 = 0;
        while (si < fnk.body.len()) { recvs = collect_append_recvs_stmt(fnk.body[si], recvs); si = si + 1; }
        var mask: string = "";
        var pj: i32 = 0;
        while (pj < fnk.params.len()) {
            if (is_array_type_name(fnk.params[pj].type_name) && util.index_of_str(recvs, fnk.params[pj].name) >= 0) {
                mask = mask + "1";
            } else { mask = mask + "0"; }
            pj = pj + 1;
        }
        masks = masks.append(mask);
    }
    // Resolve the dying pass-through EDGES once — they are static across
    // fixpoint rounds (only masks change). Each edge says: caller e_fk's
    // param e_ppi flows to free-function callee e_ck's position e_argi in a
    // dying shape. The fixpoint below is then pure index arithmetic over
    // these parallel arrays — the earlier shape re-walked every function's
    // statements (grow_dying_passes_stmt + registry allocations) on EVERY
    // round, which is pure garbage under the leak-mode self-compile arena
    // (#3425) and helped push the per-module-built compiler over the wall.
    var e_fk: i32[] = [];
    var e_ck: i32[] = [];
    var e_argi: i32[] = [];
    var e_ppi: i32[] = [];
    var fk0: i32 = 0;
    while (fk0 < funcs.len()) {
        var fd0: parser.FuncDecl = funcs[fk0];
        var pnames0: string[] = [];
        var pn0: i32 = 0;
        while (pn0 < fd0.params.len()) { pnames0 = pnames0.append(fd0.params[pn0].name); pn0 = pn0 + 1; }
        var passes0: string[] = [];
        var sj0: i32 = 0;
        while (sj0 < fd0.body.len()) { passes0 = grow_dying_passes_stmt(fd0.body[sj0], pnames0, passes0); sj0 = sj0 + 1; }
        var q0: i32 = 0;
        while (q0 < passes0.len()) {
            var entry: string = passes0[q0];
            var b1: i32 = 0;
            while (b1 < entry.len() && entry[b1] != b'|') { b1 = b1 + 1; }
            var b2: i32 = b1 + 1;
            while (b2 < entry.len() && entry[b2] != b'|') { b2 = b2 + 1; }
            var cname: str = slice_unchecked(entry, 0, b1);
            var argi: i32 = util.digits_to_i32(slice_unchecked(entry, b1 + 1, b2));
            var pname: str = slice_unchecked(entry, b2 + 1, entry.len());
            var ppi0: i32 = util.index_of_str(pnames0, pname + "");
            var ck0: i32 = 0;
            while (ck0 < funcs.len()) {
                if (funcs[ck0].name == cname && funcs[ck0].receiver_type.len() == 0) {
                    if (ppi0 >= 0) {
                        e_fk = e_fk.append(fk0);
                        e_ck = e_ck.append(ck0);
                        e_argi = e_argi.append(argi);
                        e_ppi = e_ppi.append(ppi0);
                    }
                    ck0 = funcs.len();
                } else { ck0 = ck0 + 1; }
            }
            q0 = q0 + 1;
        }
        fk0 = fk0 + 1;
    }
    // Fixpoint over the resolved edges (monotone: only 0->1 flips, so the
    // converged mask set is identical to the per-round re-walk's).
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var ei: i32 = 0;
        while (ei < e_fk.len()) {
            var cmask: string = masks[e_ck[ei]];
            var eargi: i32 = e_argi[ei];
            if (eargi < cmask.len() && cmask[eargi] == b'1') {
                var fmask: string = masks[e_fk[ei]];
                var ppi: i32 = e_ppi[ei];
                if (ppi < fmask.len() && fmask[ppi] != b'1') {
                    masks = masks.with(e_fk[ei], slice_unchecked(fmask, 0, ppi) + "1" + slice_unchecked(fmask, ppi + 1, fmask.len()));
                    changed = true;
                }
            }
            ei = ei + 1;
        }
    }
    var out: string[] = [];
    var ok2: i32 = 0;
    while (ok2 < funcs.len()) {
        if (util.contains(masks[ok2], "1")) {
            var key: string = funcs[ok2].name;
            if (funcs[ok2].receiver_type.len() > 0) { key = util.base_type_name(funcs[ok2].receiver_type) + "." + funcs[ok2].name; }
            out = out.append(key + "|" + masks[ok2]);
        }
        ok2 = ok2 + 1;
    }
    return out;
}

// callee_param_may_grow reads flag '4' — the may-grow array param positions
// merged into fn_param_sigs by fn_param_sigs_of.
pub function (s: LowerState) callee_param_may_grow(name: string, idx: i32): boolean {
    return sig_reg_flag_at(s.sigs.fn_param_sigs, name, idx) == 52;   // '4'
}

// grow_exempt_names_of_stmt returns the ident args exempt from the grow
// bracket for this statement — the occurs-once self-reassign and
// return-position shapes (see the grow_exempt field doc). Empty otherwise.
// --- #6043 sole-occurrence death, ported (#6048) ------------------------------
//
// The two shapes above are the pre-#6043 rule: a self-reassign `x = f(.., x, ..)`
// and a `return f(.., x, ..)`, each gated on the name occurring once in that
// statement. Native's callArgDeaths grew a third: a PARAM read exactly once in the
// WHOLE body, at a call no loop or lambda encloses, is dead at that call — so the
// #4873 grow bracket need not force a full-buffer copy on it.
//
// Both of native's restrictions are carried over, and both are load-bearing:
//
//   - The LOOP/LAMBDA exclusion. A single textual read inside a repeating construct
//     is still many dynamic reads, and the next iteration would observe the previous
//     one's in-place growth — which the interpreter never performs. Without this the
//     rule degenerates into the textually-last-occurrence heuristic callArgDeaths
//     deliberately rejects.
//   - PARAMS only. A param is bound once per frame from the caller, and the caller's
//     own bracket already contains what the callee does to it, so a param that dies
//     here is a complete account of this frame's interest in the buffer. A match-arm
//     payload binding is a view into a scrutinee that outlives the arm, and the #4402
//     borrowed-view exemption means not every `var` local takes the retain that would
//     push a callee onto its copy path.
//
// A shadowing inner declaration of the same name inflates the census, which only ever
// WITHHOLDS the verdict — the safe direction, same as native.

function grow_ident_census(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = astwalk.collect_idents_stmt(stmt, a); }
    return a;
}

function grow_count_in(xs: string[], name: string): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < xs.len()) { if (xs[i] == name) { n = n + 1; } i = i + 1; }
    return n;
}

// grow_repeating_idents: every ident read from inside a loop or a lambda — the
// exclusion set. A while/for contributes its CONDITION and ITERATOR as well as its
// body, since those re-evaluate too.
function grow_repeating_idents(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtWhile(w) => {
                a = astwalk.collect_idents_expr(w.cond, a);
                a = grow_ident_census(w.body, a);
            },
            ast.StmtFor(f) => {
                a = astwalk.collect_idents_expr(f.iter, a);
                a = grow_ident_census(f.body, a);
            },
            ast.StmtIf(iff) => {
                a = grow_repeating_idents(iff.then_body, a);
                a = grow_repeating_idents(iff.else_body, a);
            },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = grow_repeating_idents(arm.body, a); }
            },
            _ => {},
        }
        // A lambda anywhere in the statement repeats on every call of the closure.
        a = grow_lambda_idents_stmt(stmt, a);
    }
    return a;
}

function grow_lambda_idents_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => { return grow_lambda_idents_expr(v.init, acc); },
        ast.StmtAssign(a2) => { return grow_lambda_idents_expr(a2.value, acc); },
        ast.StmtReturn(r) => { return grow_lambda_idents_expr(r.value, acc); },
        ast.StmtExpr(e) => { return grow_lambda_idents_expr(e.value, acc); },
        _ => { return acc; },
    }
    return acc;
}

function grow_lambda_idents_expr(e: ast.Expr, acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprLambda(_) => { return astwalk.collect_idents_expr(e, a); },
        ast.ExprCall(c) => {
            a = grow_lambda_idents_expr(c.callee, a);
            for arg in c.args { a = grow_lambda_idents_expr(arg, a); }
            return a;
        },
        ast.ExprBinary(b) => { a = grow_lambda_idents_expr(b.left, a); return grow_lambda_idents_expr(b.right, a); },
        ast.ExprUnary(u) => { return grow_lambda_idents_expr(u.operand, a); },
        ast.ExprFieldAccess(fa) => { return grow_lambda_idents_expr(fa.obj, a); },
        ast.ExprIndex(ix) => { a = grow_lambda_idents_expr(ix.array, a); return grow_lambda_idents_expr(ix.index, a); },
        ast.ExprArray(ar) => {
            var j: i32 = 0;
            while (j < ar.elements.len()) { a = grow_lambda_idents_expr(ar.elements[j], a); j = j + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = grow_lambda_idents_expr(el, a); }
            return a;
        },
        _ => { return a; },
    }
    return a;
}

pub function grow_sole_exempt_names_of(fn: parser.FuncDecl): string[] {
    var all: string[] = grow_ident_census(fn.body, []);
    var rep: string[] = grow_repeating_idents(fn.body, []);
    var out: string[] = [];
    var p: i32 = 0;
    while (p < fn.params.len()) {
        var nm: string = fn.params[p].name;
        if (grow_count_in(all, nm) == 1 && util.index_of_str(rep, nm) < 0) { out = push_str_unique(out, nm); }
        p = p + 1;
    }
    return out;
}

pub function grow_exempt_names_of_stmt(st: ast.Stmt): string[] {
    var out: string[] = [];
    match (st) {
        ast.StmtAssign(a) => {
            match (a.value) {
                ast.ExprCall(c) => {
                    for arg in c.args {
                        match (arg) {
                            ast.ExprIdent(aid) => {
                                if (aid.name == a.target && grow_ident_count(a.value, aid.name) == 1) {
                                    out = out.append(aid.name);
                                }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
        },
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprCall(c2) => {
                    var ai2: i32 = 0;
                    while (ai2 < c2.args.len()) {
                        match (c2.args[ai2]) {
                            ast.ExprIdent(aid2) => {
                                if (grow_ident_count(r.value, aid2.name) == 1) {
                                    out = out.append(aid2.name);
                                }
                            },
                            _ => {}
                        }
                        ai2 = ai2 + 1;
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return out;
}

pub function (s: LowerState) with_grow_exempt(names: string[]): LowerState {
    return LowerState { ...s, grow_exempt: names };
}

function struct_ty_from_arr_alias(se: LowerState, v: ast.StmtVar, struct_ty: string): string {
if (struct_ty == "") {
    match (v.init) {
        ast.ExprIdent(aid) => {
            var asl: i32 = se.slot_of(aid.name);
            if (se.is_arr_slot(asl)) { struct_ty = se.struct_type_of_slot(asl); }
        },
        _ => {}
    }
}

    return struct_ty;
}

function opt_ty_from_array_literal(se: LowerState, v: ast.StmtVar, opt_ty: string): string {
if (opt_ty == "") {
    match (v.init) {
        ast.ExprArray(oalit) => {
            var oali: i32 = 0;
            while (oali < oalit.elements.len()) {
                var oaet: string = some_opt_type(oalit.elements[oali], se);
                if (oaet != "") { opt_ty = oaet + "[]"; oali = oalit.elements.len(); }
                else {
                    // A 2D Option literal (`[[Some(1)], …]`): the element
                    // is itself an array — recurse for the innermost
                    // Option type and append "[][]" (the depth-2 sibling;
                    // the annotated `Option[T][][]` form already works via
                    // the array-foreach opt propagation). #3073.
                    match (oalit.elements[oali]) {
                        ast.ExprArray(oinner) => {
                            var ioi: i32 = 0;
                            while (ioi < oinner.elements.len()) {
                                var ioet: string = some_opt_type(oinner.elements[ioi], se);
                                if (ioet != "") { opt_ty = ioet + "[][]"; ioi = oinner.elements.len(); }
                                else { ioi = ioi + 1; }
                            }
                        },
                        _ => {}
                    }
                    if (opt_ty != "") { oali = oalit.elements.len(); } else { oali = oali + 1; }
                }
            }
        },
        _ => {}
    }
}

    return opt_ty;
}

function opt_ty_from_iife_result(se: LowerState, v: ast.StmtVar, opt_ty: string): string {
if (opt_ty == "") {
    match (v.init) {
        ast.ExprCall(oic) => {
            match (oic.callee) {
                ast.ExprLambda(oilam) => {
                    if (oilam.body.len() > 0) {
                        match (iife_leaf_value(v.init)) {
                            ast.ExprArray(obra) => {
                                var obi: i32 = 0;
                                while (obi < obra.elements.len()) {
                                    var obaet: string = some_opt_type(obra.elements[obi], se);
                                    if (obaet != "") { opt_ty = obaet + "[]"; obi = obra.elements.len(); }
                                    else { obi = obi + 1; }
                                }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

    return opt_ty;
}

function opt_ty_from_index_alias(se: LowerState, v: ast.StmtVar, opt_ty: string): string {
if (opt_ty == "") {
    match (v.init) {
        ast.ExprIndex(oix) => {
            match (oix.array) {
                ast.ExprIdent(oaid) => {
                    var oaot: string = se.opt_type_of_slot(se.slot_of(oaid.name));
                    if (oaot.len() >= 2 && slice_unchecked(oaot, oaot.len() - 2, oaot.len()) == "[]") {
                        var oelt: str = slice_unchecked(oaot, 0, oaot.len() - 2);
                        if (oelt.len() >= 8 && (slice_unchecked(oelt, 0, 7) == "Option[" || slice_unchecked(oelt, 0, 7) == "Result[")) { opt_ty = oelt + ""; }
                    }
                },
                _ => {}
            }
        },
        ast.ExprIdent(oaid2) => {
            var oasl: i32 = se.slot_of(oaid2.name);
            if (se.is_arr_slot(oasl)) {
                var oaot2: string = se.opt_type_of_slot(oasl);
                if (oaot2.len() >= 2 && slice_unchecked(oaot2, oaot2.len() - 2, oaot2.len()) == "[]") { opt_ty = oaot2; }
            }
        },
        _ => {}
    }
}

    return opt_ty;
}

function closurearr_of_init(is_arr: boolean, s: LowerState, se: LowerState, v: ast.StmtVar): boolean {
var is_closurearr: boolean = false;
match (v.init) {
    ast.ExprArray(carr) => {
        if (carr.elements.len() > 0 && arr_elem_is_closure_box(carr.elements[0], se)) { is_closurearr = true; }
        // An EMPTY annotated `fn[]` literal grown by `name = name.append(<box>)`
        // (#4354). An empty literal has no element to classify, so the flag used
        // to arrive only AT the first append — and every element read lowered
        // before it (a nested `var g = fns[0]` guarded to run from iteration 2,
        // say) bound a plain scalar and CALLED the box pointer as code: SIGSEGV,
        // where native runs the same program. lower_func stamps "CLOAPPEND:" on
        // the declarations a body proves grow by closure box, so the flag holds
        // from the declaration and every read in the body dispatches env-first.
        if (carr.elements.len() == 0 && v.type_name == "fn[]"
            && reclaim_has(se.reclaimable_names, "CLOAPPEND:", reclaim_site_key_of(v.name, v.line, v.col))) { is_closurearr = true; }
    },
    // `var arr = mk()` where mk returns a closure-array (`((T) => R)[]`):
    // arr's elements are closure boxes, so mark it is_closurearr for the
    // env-first `arr[i](args)` dispatch. Without this, `arr[i]()` bare-calls
    // the box pointer as code — SIGSEGV. The `is_arr` mark comes from the
    // arr-returning-call branch above.
    ast.ExprCall(cac) => {
        match (cac.callee) {
            ast.ExprIdent(cacid) => { if (se.is_closurearr_ret_fn(cacid.name)) { is_closurearr = true; } },
            // A value-position if/match (an IIFE) whose every arm yields a
            // closure ARRAY. Same argument as the closure-returning call
            // above, one container out: leaving it unclassified made
            // `xs[i](args)` bare-call the box pointer as code.
            ast.ExprLambda(_) => { if (cac.args.len() == 0 && iife_callee_closurearr_arms(cac.callee, se)) { is_closurearr = true; } },
            // `var w = fns.with(i, f)` / `fns.append(f)`: the clone those
            // produce carries the RECEIVER's element ABI, so it inherits the
            // receiver's closure-array mark. Without it `w[i](args)`
            // bare-calls a box pointer as code — SIGSEGV, the same failure
            // the closure-returning-call arm above answers one construction
            // site over.
            ast.ExprFieldAccess(cwfa) => {
                if ((cwfa.field == "with" && cac.args.len() == 2) || (cwfa.field == "append" && cac.args.len() == 1)) {
                    match (cwfa.obj) {
                        ast.ExprIdent(cwid) => { if (se.is_closurearr_slot(se.slot_of(cwid.name))) { is_closurearr = true; } },
                        _ => { if (field_access_is_closurearr(cwfa.obj, se) || expr_is_closure_array(cwfa.obj, se)) { is_closurearr = true; } }
                    }
                }
            },
            _ => { }
        }
    },
    // `var d = arr` aliasing an existing closure-array local.
    ast.ExprIdent(caaid) => { if (se.is_closurearr_slot(se.slot_of(caaid.name))) { is_closurearr = true; } },
    _ => { }
}

    return is_closurearr;
}

function arrarr_from_init_shape(s: LowerState, se: LowerState, v: ast.StmtVar, is_arrarr: boolean): boolean {
match (v.init) {
    ast.ExprArray(aarr) => {
        // Type-driven (#5326): the first element is an array by ANY
        // classification expr_is_arr_src knows — a nested literal, an
        // array-marked local (`var m = [inner, …]`), or a registered
        // T[]-returning call (`var m = [mk(), …]`). The literal-shape-only
        // match this replaces silently left `m` un-arr-arr-marked for the
        // call/ident shapes, so nested reads m[i][j] took the 4-byte
        // default stride — a wrong-value miscompile for f64/string inner
        // elements (caught differentially vs the interp oracle).
        // A closure LOCAL is an is_arr slot (its env box is an array), but
        // `[c, …]` is a closure array, not an array of rows: marking it
        // arr-of-arr made `for f in fns` bind f as an OWNED array, and its
        // exit dec released a box the array still held (#4354).
        if (aarr.elements.len() > 0 && expr_is_arr_src(aarr.elements[0], se) && !arr_elem_is_closure_box(aarr.elements[0], se)) { is_arrarr = true; }
    },
    ast.ExprIdent(aaid) => { if (se.is_arrarr_slot(se.slot_of(aaid.name))) { is_arrarr = true; } },
    // A `T[][]` struct FIELD read (`var rows = a.xs`): no slot records that
    // level, but the field's declaration does (#7208).
    ast.ExprFieldAccess(_) => { if (nested_arr_field_read_type(v.init, se) != "") { is_arrarr = true; } },
    _ => {}
}

    return is_arrarr;
}

function arrarr_elem_kind_of_init(is_arrarr: boolean, se: LowerState, v: ast.StmtVar): string {
var arrarr_e: string = "";
if (is_arrarr) {
    arrarr_e = arrarr_elem_kind_of_type(v.type_name);
    match (v.init) {
        ast.ExprArray(aarr2) => {
            if (aarr2.elements.len() > 0) {
                // Don't let the literal-first-element i64 probe DOWNGRADE a
                // u64[][] annotation to "i64": a bare wide literal element
                // (`[big, 1]`) reads i64arr but the annotation already
                // recorded the unsigned sign (#5206).
                if (arrarr_e != "u64" && expr_is_i64arr(aarr2.elements[0], se)) { arrarr_e = "i64"; }
                if (expr_is_f64arr(aarr2.elements[0], se)) { arrarr_e = "f64"; }
                if (expr_is_strarr(aarr2.elements[0], se)) { arrarr_e = "string"; }
            }
        },
        ast.ExprIdent(aaid2) => { arrarr_e = se.arrarr_elem_of_slot(se.slot_of(aaid2.name)); },
        // A `T[][]` field read: the field declaration names the inner kind an
        // unannotated binding has nowhere else to get. It never DOWNGRADES an
        // annotation — a "" answer leaves what the spelling recorded.
        ast.ExprFieldAccess(_) => {
            var nfk: string = arrarr_elem_kind_of_type(nested_arr_field_read_type(v.init, se));
            if (nfk != "") { arrarr_e = nfk; }
        },
        _ => {}
    }
}

    return arrarr_e;
}

function arrtup_elem_tag_of_init(is_arr: boolean, is_arrarr: boolean, se: LowerState, v: ast.StmtVar, arrarr_e: string): string {
if (is_arr && !is_arrarr && arrarr_e == "") {
    match (v.init) {
        ast.ExprArray(atl2) => {
            if (atl2.elements.len() > 0) {
                match (atl2.elements[0]) {
                    ast.ExprTuple(_) => {
                        var att2: string = elem_type_tag(atl2.elements[0], se);
                        if (util.is_tuple_type_name(att2)) { arrarr_e = att2; }
                    },
                    _ => {}
                }
            }
        },
        // UNANNOTATED array-of-tuples from a CALL (`var ps = mk()` where
        // `mk(): (i32, f64)[]`). The literal arm above covers the inline
        // form; this is the same gap one step out, and it is the SOURCE of
        // the missing tag rather than another place to paper over it —
        // populating arrarr_e here serves every consumer that reads a tuple
        // tag off the slot, including `for p in ps`, which has no
        // ExprIndex node and so cannot use the per-consumer `.ty` fallback
        // that `ps[0].N` and `var (a, b) = ps[0]` rely on.
        ast.ExprCall(atc) => {
            match (atc.callee) {
                ast.ExprIdent(atcid) => { arrarr_e = se.arrtup_ret_type(atcid.name); },
                ast.ExprFieldAccess(atcfa) => {
                    var atcrty: string = expr_struct_type(atcfa.obj, se);
                    if (atcrty != "") { arrarr_e = se.arrtup_ret_type(atcrty + "." + atcfa.field); }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

    return arrarr_e;
}

function reclaim_env_capture_params(fn: parser.FuncDecl, reclaim: string[]): string[] {
if (fn.params.len() > 0 && fn.params[0].name == "__env") {
    var evi: i32 = 0;
    while (evi < fn.body.len()) {
        match (fn.body[evi]) {
            ast.StmtVar(ev) => {
                match (ev.init) {
                    ast.ExprIndex(evix) => {
                        match (evix.array) {
                            ast.ExprIdent(evid) => {
                                if (evid.name == "__env") { reclaim = reclaim.append("ENVCAP:" + reclaim_site_key_of(ev.name, ev.line, ev.col)); }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        evi = evi + 1;
    }
}

    return reclaim;
}

function reclaim_snapshot_locals(fn: parser.FuncDecl, sg: FnSigs, structs: parser.StructDecl[], reclaim: string[]): string[] {
var snap_locals: string[] = snapshot_local_names_of(fn, structs, sg.borrowable_params, sg.fresh_struct_ret_fns, sg.consume_safe_params, sg.return_fresh_struct_ret_fns);
var sli: i32 = 0;
while (sli < snap_locals.len()) {
    var row: string = snap_locals[sli];
    var key: string = row;
    // "SNAPSRC:<site>|<name>" rides along for seed_snapshot_local; the site it
    // names still takes the rebind-release marker below.
    var is_src: boolean = row.len() > 8 && slice_unchecked(row, 0, 8) == "SNAPSRC:";
    // "LASTUSE:<site>|<name>" rides along for release_last_use_source; the
    // site it names is the consumer's, not a credit.
    if (row.len() > 8 && slice_unchecked(row, 0, 8) == "LASTUSE:") {
        if (util.index_of_str(reclaim, row) < 0) { reclaim = reclaim.append(row); }
        sli = sli + 1;
        continue;
    }
    if (is_src) {
        var bar: i32 = 8;
        while (bar < row.len() && row[bar] != b'|') { bar = bar + 1; }
        key = slice_unchecked(row, 8, bar) + "";
        if (util.index_of_str(reclaim, row) < 0) { reclaim = reclaim.append(row); }
    } else if (util.index_of_str(reclaim, key) < 0) {
        // Key-to-key against the credits reclaimable_names_of already published,
        // and the comparison gets SHARPER for it: two same-named bindings no
        // longer collapse into one another.
        reclaim = reclaim.append(key);
        // Same "NODEEP:" marking reclaimable_names_of applies to its own
        // bare credits (#3425 residual): a snapshot-LOCAL used as a method
        // receiver / bare call arg with the result bound ELSEWHERE (e.g.
        // `return vsb.emit(op)` — receiver moved into the RETURN value, not
        // rebound to vsb) may have its rc fields shared with that other
        // live value, so the sweeps must keep its free BOX-ONLY. The classic
        // chain (`var st = se.emit(op); st = st.emit(..); return st`) stays
        // unmarked — self-rebinds are exempt and a bare `return st` is a
        // read — so its rebind field-reclaim and deep sweep both survive.
        // A bare ARGUMENT derives too: the callee may hand back a box sharing
        // the local's fields (a spread copy retains none of its arrays), and
        // moves_fields_expr flags only a receiver. `return emit_arr_store(apf, …)`
        // left `apf` deep-swept under the very box it had just been copied into.
        if (moves_fields_stmts(fn.body, reclaim_site_name(key), [], false) || derived_anywhere(fn, reclaim_site_name(key), structs)) { reclaim = reclaim.append("NODEEP:" + key); }
    }
    // "NOFLD:" keeps the REBIND release box-only where a value derived from the
    // local may outlive a later rebind and still share the fields that rebind
    // releases (derived_outlives_rebind). NODEEP, which decides the exit sweep,
    // stays the coarser mark: at exit every derived value is live at once.
    if (derived_outlives_rebind(fn, reclaim_site_name(key), structs)) { reclaim = push_str_unique(reclaim, "NOFLD:" + key); }
    sli = sli + 1;
}

    return reclaim;
}

function reclaim_lit_arg_callees(fn: parser.FuncDecl, sg: FnSigs, reclaim: string[]): string[] {
var lacs: string[] = [];
var laci: i32 = 0;
while (laci < fn.body.len()) { lacs = lit_arg_callees_stmt(fn.body[laci], lacs); laci = laci + 1; }
var li: i32 = 0;
while (li < lacs.len()) {
    // The census only knows the bare method name, so the rows come from the
    // bare-name index rather than the registry: one bucket per callee, not
    // every row of the whole program per function lowered (#8177).
    var name: string = lacs[li];
    var buck: string = sg.borrow_bare[util.hash_bucket(name, sg.borrow_bare.len())];
    var bl: i32 = 0;
    while (bl < buck.len()) {
        var ble: i32 = bl;
        while (ble < buck.len() && buck[ble] != b'\n') { ble = ble + 1; }
        var bpbar: i32 = bl;
        while (bpbar < ble && buck[bpbar] != b'|') { bpbar = bpbar + 1; }
        if (bpbar < ble) {
            var bpdot: i32 = bpbar;
            while (bpdot > bl && buck[bpdot - 1] != b'.') { bpdot = bpdot - 1; }
            if (slice_unchecked(buck, bpdot, bpbar) == name) {
                reclaim = reclaim.append("BORROW:" + slice_unchecked(buck, bl, ble));
            }
        }
        bl = ble + 1;
    }
    li = li + 1;
}

    return reclaim;
}

function reclaim_discarded_call_callees(fn: parser.FuncDecl, sg: FnSigs, reclaim: string[]): string[] {
var dccs: string[] = [];
var dcci: i32 = 0;
while (dcci < fn.body.len()) { dccs = discarded_call_callees_stmt(fn.body[dcci], dccs); dcci = dcci + 1; }
if (dccs.len() > 0) {
    var tfk: i32 = 0;
    while (tfk < sg.tuple_fresh_ret_fns.len()) {
        var tfe: string = sg.tuple_fresh_ret_fns[tfk];
        if (tfe.len() > 6 && slice_unchecked(tfe, 0, 5) == "ARRF:") {
            var tfbar: i32 = 5;
            while (tfbar < tfe.len() && tfe[tfbar] != b'|') { tfbar = tfbar + 1; }
            if (util.index_of_str(dccs, slice_unchecked(tfe, 5, tfbar)) >= 0) { reclaim = reclaim.append("TUPRET:" + slice_unchecked(tfe, 5, tfe.len())); }
        } else if (tfe.len() > 5 && slice_unchecked(tfe, 0, 5) == "MAPF:") {
            if (util.index_of_str(dccs, slice_unchecked(tfe, 5, tfe.len())) >= 0) { reclaim = reclaim.append("MAPRET:" + slice_unchecked(tfe, 5, tfe.len())); }
        }
        tfk = tfk + 1;
    }
}

    return reclaim;
}

function tail_cleanup_stmts_of(fn: parser.FuncDecl): ast.Stmt[] {
var tclean: ast.Stmt[] = [];
var tci: i32 = 0;
while (tci < fn.body.len()) {
    match (fn.body[tci]) {
        ast.StmtIf(tcf) => {
            match (tcf.cond) {
                ast.ExprIdent(tcid) => {
                    if (tcid.name == "__dfa_tryall" || tcid.name == "__dfa_tryerr") { tclean = tclean.append(fn.body[tci]); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    tci = tci + 1;
}

    return tclean;
}

// seed_snapshot_slots is the SECOND consumer of snapshot_param_slots_of's rows,
// in a different function from slot_is_snapshot_param — a key change has to move
// both, and the emit-hash sweep is what says whether it did (#7292: a writer, or
// a reader, need not be a caller of the thing being changed).
//
// The hidden local is named by the param's SLOT rather than its spelling, so
// snapshot_slot_name is the one place either half spells it.
function seed_snapshot_slots(snaps: string[], s: LowerState): LowerState {
var sni: i32 = 0;
while (sni < snaps.len()) {
    var psl: i32 = util.digits_to_i32(snaps[sni]);
    if (psl >= 0 && psl < s.locals.len() && s.struct_type_of_slot(psl).len() > 0) {
        s = s.add_local(snapshot_slot_name(psl));
        s = s.emit(ir.op_load_local(psl));
        s = s.emit(ir.op_store_local(s.slot_of(snapshot_slot_name(psl))));
    }
    sni = sni + 1;
}

    return s;
}

// snapshot_slot_name names the hidden entry-snapshot local for param slot `i`.
// Slot-keyed for the same reason the "SNAP:" rows are: a name would have to be
// the param's spelling, which is a second key that can drift from the first.
function snapshot_slot_name(i: i32): string {
    return "$snap$" + util.i32_to_string(i);
}

// seed_snapshot_local: a struct local whose binding recorded the variable its
// value derives from ("SNAPSRC:<site>|<name>", snapshot_local_names_of) gets a
// hidden copy of that variable's box, `$snap$<slot>`, right after the binding.
// lower_stmt_assign hands it to the rebind release as the snapshot a snapshot
// PARAM gets at entry: a field the rebound box still carries from the source
// compares equal to it and is left alone.
function seed_snapshot_local(v: ast.StmtVar, sv: LowerState): LowerState {
    if (!sv.ok) { return sv; }
    var src: string = site_row_value(sv.reclaimable_names, "SNAPSRC:", reclaim_site_key_of(v.name, v.line, v.col));
    if (src.len() == 0) { return sv; }
    var slot: i32 = sv.slot_of(v.name);
    var srcslot: i32 = sv.slot_of(src);
    if (slot < 0 || srcslot < 0 || sv.struct_type_of_slot(slot).len() == 0) { return sv; }
    var st: LowerState = sv.add_local(snapshot_slot_name(slot));
    if (last_use_release_slot(v, st) == srcslot) {
        // The source's box goes at this statement (release_last_use_source),
        // so the derived local inherits the source's own snapshot, or none.
        var ss: i32 = st.slot_of(snapshot_slot_name(srcslot));
        if (ss >= 0) { st = st.emit(ir.op_load_local(ss)); } else { st = st.emit(ir.op_const_i32(0)); }
    } else {
        st = st.emit(ir.op_load_local(srcslot));
    }
    return st.emit(ir.op_store_local(st.slot_of(snapshot_slot_name(slot))));
}

// last_use_release_slot: the slot of the local whose last use `var q2: T =
// g(.., name, ..)` at `v` is — a "LASTUSE:" row names it, and it is a local of
// q2's own struct type — else -1.
function last_use_release_slot(v: ast.StmtVar, s: LowerState): i32 {
    var name: string = site_row_value(s.reclaimable_names, "LASTUSE:", reclaim_site_key_of(v.name, v.line, v.col));
    if (name.len() == 0) { return 0 - 1; }
    var slot: i32 = s.slot_of(name);
    var q2: i32 = s.slot_of(v.name);
    if (slot < s.n_params || q2 < 0 || s.is_arr_slot(slot)) { return 0 - 1; }
    var sty: string = s.struct_type_of_slot(slot);
    if (sty.len() == 0 || sty != s.struct_type_of_slot(q2)) { return 0 - 1; }
    return slot;
}

// release_last_use_source: `var q2: T = g(.., name, ..)` bound the last value
// derived from name, so name's box is dead. Release it the way a rebind would,
// with q2 standing in for the new value: a field q2 carries on is kept, the
// replaced ones and the box go, a shared box gives up this slot's count. When g
// handed name's own box back, q2 holds its own count on it and name's is
// released. At an `own` position the callee took the box — reused in place or
// freed — and nothing here may read it. The slot is zeroed either way, so the
// exit sweep of a credited local finds nothing.
function release_last_use_source(v: ast.StmtVar, sv: LowerState): LowerState {
    if (!sv.ok) { return sv; }
    var slot: i32 = last_use_release_slot(v, sv);
    if (slot < 0) { return sv; }
    var st: LowerState = sv;
    if (!arg_moved_into_callee(v.init, site_row_value(sv.reclaimable_names, "LASTUSE:", reclaim_site_key_of(v.name, v.line, v.col)), sv)) {
        var q2: i32 = st.slot_of(v.name);
        var sty: string = st.struct_type_of_slot(slot);
        var snls: i32 = st.slot_of(snapshot_slot_name(slot));
        var scratch: string = "$lu" + util.i32_to_string(st.locals.len());
        st = st.add_local(scratch);
        var os: i32 = st.slot_of(scratch);
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_store_local(os));                      // old
        st = st.emit(ir.op_load_local(q2));                       // new
        if (!reclaim_has(st.reclaimable_names, "NOFLD:", st.reclaim_site_key(slot)) && st.struct_routes_field_reclaim(sty)) {
            st = emit_field_reclaim_store(st, slot, sty, snls);
        } else {
            st = st.emit(ir.op_load_local(slot));                 // old (arg1)
            if (snls >= 0) { st = st.emit(ir.op_load_local(snls)); } else { st = st.emit(ir.op_const_i32(0)); }
            st = st.emit(ir.op_call_direct("__fern_snapshot_dec", 3));   // frees old unless new or snap; returns new
            st = st.emit(ir.op_store_local(slot));
        }
        st = st.emit(ir.op_load_local(os));
        st = st.emit(ir.op_load_local(q2));
        st = st.emit(ir.op_bin("eq", 0, false));
        if (snls >= 0) {
            st = st.emit(ir.op_load_local(os));
            st = st.emit(ir.op_load_local(snls));
            st = st.emit(ir.op_bin("ne", 0, false));
            st = st.emit(ir.op_bin("and", 0, false));
        }
        st = st.emit(ir.op_if(0));
        st = st.emit(ir.op_load_local(os));
        st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
        st = st.emit(ir.op_drop());
        st = st.emit(ir.op_end());
    }
    st = st.emit(ir.op_const_i32(0));
    return st.emit(ir.op_store_local(slot));
}

// arg_moved_into_callee: `name` sits at a declared `own` position of e's callee
// — or at an argument position of a method, which the registry cannot see. The
// receiver of a method call is a borrow.
function arg_moved_into_callee(e: ast.Expr, name: string, s: LowerState): boolean {
    if (call_recv_ident(e) == name) { return false; }
    return !rebind_call_same_dec(e, name, s);
}

// last_use_consumer_in: the site key of the `var q2: ty = g(.., name, ..)` /
// `var q2: ty = name.m(…)` in `stmts` after which name is never mentioned
// again, else "". `name` is declared at the top level of this list, so no
// statement outside it can read it either.
function last_use_consumer_in(stmts: ast.Stmt[], name: string, ty: string, borrowable: string[], consume_safe: string[]): string {
    if (ty.len() == 0) { return ""; }
    var j: i32 = 0;
    while (j < stmts.len()) {
        match (stmts[j]) {
            ast.StmtVar(v) => {
                if (v.name != name && v.type_name == ty
                    && init_derives_from(v.init, name, borrowable, consume_safe)
                    && !stmts_mention_from(stmts, j + 1, name)) { return reclaim_site_key_of(v.name, v.line, v.col); }
            },
            _ => {}
        }
        j = j + 1;
    }
    return "";
}
function var_annot_at_top(stmts: ast.Stmt[], name: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return v.type_name; } },
            _ => {}
        }
    }
    return "";
}
function stmts_mention_from(stmts: ast.Stmt[], from: i32, name: string): boolean {
    var seen: string[] = [];
    var j: i32 = from;
    while (j < stmts.len()) { seen = astwalk.collect_idents_stmt(stmts[j], seen); j = j + 1; }
    return util.index_of_str(seen, name) >= 0;
}

// tail_release_snapshot_locals: `return q.m(…)` / `return g(.., q, ..)` where q
// is a snapshot local with no struct credit (the alias `var q: T = p`): the
// result is the last value derived from q's box, and that box is dead once the
// result exists. Release it the way a rebind would, with the result standing in
// for the new value — a field it carries on compares equal and is kept, the
// replaced ones and the box go — then put the result back on the stack. A
// credited local is left to its exit sweep.
function tail_release_snapshot_locals(v: ast.Expr, s: LowerState): LowerState {
    var st: LowerState = s;
    for an in call_operand_idents(v) { st = tail_release_one(an, st); }
    return st;
}

// call_operand_idents: a call's operands by name — element 0 the receiver of a
// method call `x.m(…)` ("!" when computed, "" for a free call), then each
// argument in position order, "" where it is not a bare ident. Empty for
// anything that is not a call.
function call_operand_idents(e: ast.Expr): string[] {
    var out: string[] = [];
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    var rn: string = ident_name_or_empty(fa.obj);
                    if (rn.len() == 0) { rn = "!"; }
                    out = out.append(rn);
                },
                _ => { out = out.append(""); }
            }
            for arg in c.args { out = out.append(ident_name_or_empty(arg)); }
        },
        _ => {}
    }
    return out;
}
function call_recv_ident(e: ast.Expr): string {
    var ops: string[] = call_operand_idents(e);
    if (ops.len() == 0) { return ""; }
    return ops[0];
}
function tail_release_one(name: string, s: LowerState): LowerState {
    if (name.len() == 0) { return s; }
    var slot: i32 = s.slot_of(name);
    if (slot < s.n_params || s.is_arr_slot(slot) || slot_is_reclaimable_struct(s, slot)) { return s; }
    var sty: string = s.struct_type_of_slot(slot);
    if (sty.len() == 0) { return s; }
    var snls: i32 = s.slot_of(snapshot_slot_name(slot));
    if (snls < 0) { return s; }
    var st: LowerState = s;
    if (!reclaim_has(s.reclaimable_names, "NOFLD:", s.reclaim_site_key(slot)) && s.struct_routes_field_reclaim(sty)) {
        st = emit_field_reclaim_store(st, slot, sty, snls);
    } else {
        st = emit_snapshot_store(st, slot, snls);
    }
    return st.emit(ir.op_load_local(slot));
}

// site_row_value: the name a "<tag><site>|<name>" row carries for `site`, else "".
function site_row_value(names: string[], tag: string, site: string): string {
    var pfx: string = tag + site + "|";
    var i: i32 = 0;
    while (i < names.len()) {
        var e: string = names[i];
        if (e.len() > pfx.len() && bytes_at(e, 0, pfx)) { return slice_unchecked(e, pfx.len(), e.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// init_derives_from: `e` is a call that may hand back `src`'s box or one built
// from it — `src.m(…)` (the receiver is a borrow the method may spread), or
// `g(.., src, ..)` with src at a consume-safe position.
function init_derives_from(e: ast.Expr, src: string, borrowable: string[], consume_safe: string[]): boolean {
    if (call_recv_ident(e) == src) { return true; }
    return is_consume_rebind_call(e, src, borrowable, consume_safe, []);
}

// derived_outlives_rebind: some value derived from `name` — bound under another
// name whose type can carry name's fields — may still be live when a later
// rebind of name releases the fields the two share. A derivation is any
// mention of name in the bound value: as a receiver, as an argument at any
// position (a borrowable callee may still spread-copy it into its result), or
// as a spread base. Program order decides: a derivation followed by a rebind,
// or a derivation inside a loop that also rebinds. A binding of scalar or
// string type carries no field; the handback pair `var q: R = g(.., name, ..);
// name = q.f;` makes q's box name's own; a return-position use is never
// followed by a rebind.
struct DorScan { seen: boolean, hazard: boolean }
function derived_outlives_rebind(fn: parser.FuncDecl, name: string, structs: parser.StructDecl[]): boolean {
    return dor_scan(fn.body, name, fn, structs, false, false).hazard;
}
function dor_scan(stmts: ast.Stmt[], name: string, fn: parser.FuncDecl, structs: parser.StructDecl[], seen0: boolean, rebinding_loop: boolean): DorScan {
    var seen: boolean = seen0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: ast.Stmt = stmts[i];
        match (st) {
            ast.StmtAssign(a) => {
                if (a.target == name) {
                    if (seen) { return DorScan { seen: true, hazard: true }; }
                } else if (expr_mentions_name(a.value, name) && dor_type_can_hold(decl_type_in_fn(fn, a.target), structs)) {
                    if (rebinding_loop) { return DorScan { seen: true, hazard: true }; }
                    seen = true;
                }
            },
            ast.StmtVar(v) => {
                if (expr_mentions_name(v.init, name) && dor_type_can_hold(v.type_name, structs)) {
                    if (i + 1 < stmts.len() && ident_name_or_empty(v_init_field_obj(stmts[i + 1], name)) == v.name) {
                        if (seen) { return DorScan { seen: true, hazard: true }; }
                        i = i + 1;
                    } else {
                        if (rebinding_loop) { return DorScan { seen: true, hazard: true }; }
                        seen = true;
                    }
                }
            },
            ast.StmtIf(f) => {
                var r1: DorScan = dor_scan(f.then_body, name, fn, structs, seen, rebinding_loop);
                if (r1.hazard) { return r1; }
                var r2: DorScan = dor_scan(f.else_body, name, fn, structs, seen, rebinding_loop);
                if (r2.hazard) { return r2; }
                seen = r1.seen || r2.seen;
            },
            ast.StmtWhile(w) => {
                var rw: DorScan = dor_scan(w.body, name, fn, structs, seen, rebinding_loop || util.index_of_str(body_assign_targets(w.body), name) >= 0);
                if (rw.hazard) { return rw; }
                seen = rw.seen;
            },
            ast.StmtFor(fo) => {
                var rf: DorScan = dor_scan(fo.body, name, fn, structs, seen, rebinding_loop || util.index_of_str(body_assign_targets(fo.body), name) >= 0);
                if (rf.hazard) { return rf; }
                seen = rf.seen;
            },
            ast.StmtMatch(m) => {
                var any_seen: boolean = seen;
                for arm in m.arms {
                    var ra: DorScan = dor_scan(arm.body, name, fn, structs, seen, rebinding_loop);
                    if (ra.hazard) { return ra; }
                    if (ra.seen) { any_seen = true; }
                }
                seen = any_seen;
            },
            _ => {}
        }
        i = i + 1;
    }
    return DorScan { seen: seen, hazard: false };
}
// derived_anywhere: the exit-sweep form of the same question — some value
// derived from `name` is bound under another name, or returned other than as
// the bare local, so at exit it may still share the fields a deep drop of
// name's box would free. Order is irrelevant at exit: every such value is live
// then.
function derived_anywhere(fn: parser.FuncDecl, name: string, structs: parser.StructDecl[]): boolean {
    return derived_scan(fn.body, name, fn, structs);
}
function derived_scan(stmts: ast.Stmt[], name: string, fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (expr_mentions_name(v.init, name) && dor_type_can_hold(v.type_name, structs)) { return true; } },
            ast.StmtAssign(a) => { if (a.target != name && expr_mentions_name(a.value, name) && dor_type_can_hold(decl_type_in_fn(fn, a.target), structs)) { return true; } },
            ast.StmtReturn(r) => { if (ident_name_or_empty(r.value) != name && expr_mentions_name(r.value, name)) { return true; } },
            ast.StmtIf(f) => { if (derived_scan(f.then_body, name, fn, structs) || derived_scan(f.else_body, name, fn, structs)) { return true; } },
            ast.StmtWhile(w) => { if (derived_scan(w.body, name, fn, structs)) { return true; } },
            ast.StmtFor(fo) => { if (derived_scan(fo.body, name, fn, structs)) { return true; } },
            ast.StmtMatch(m) => { for arm in m.arms { if (derived_scan(arm.body, name, fn, structs)) { return true; } } },
            _ => {}
        }
    }
    return false;
}

// dor_type_can_hold: a value of declared type `t` can carry a struct's fields —
// a struct, an array or Option/Result of one, a tuple, or an unstated type.
function dor_type_can_hold(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() == 0) { return true; }
    var b: string = t;
    while (b.len() > 2 && slice_unchecked(b, b.len() - 2, b.len()) == "[]") { b = slice_unchecked(b, 0, b.len() - 2) + ""; }
    if (b.len() > 0 && b[0] == b'(') { return true; }
    var base: string = util.base_type_name(b);
    if (base == "Option" || base == "Result" || base == "fn") { return true; }
    return decl_is_struct(structs, base);
}

// snapshot_source_of_init: the variable whose box `v`'s init is DERIVED from —
// the alias `var q: T = p` names p; a call names its receiver, or the one
// bare-ident argument declared at v's type, since a fresh-ret producer's result
// carries the fields of the same-typed value it was built from. "" when the
// init derives from no variable (a producer building from scratch, or one whose
// same-typed operand this AST-side lookup cannot type); "!" when it cannot be
// told — a computed receiver, or two candidate sources.
function snapshot_source_of_init(v: ast.StmtVar, fn: parser.FuncDecl): string {
    var iname: string = ident_name_or_empty(v.init);
    if (iname.len() > 0) { return iname; }
    var src: string = "";
    var ops: string[] = call_operand_idents(v.init);
    if (ops.len() > 0 && ops[0] == "!") { return "!"; }
    for an in ops {
        if (an.len() == 0 || an == "!" || decl_type_in_fn(fn, an) != v.type_name) { continue; }
        if (src.len() > 0 && src != an) { return "!"; }
        src = an;
    }
    return src;
}

// decl_type_in_fn: the declared type of `name` in `fn` — receiver, parameter,
// or the annotation of its `var` — "" when it has none the AST states.
function decl_type_in_fn(fn: parser.FuncDecl, name: string): string {
    if (fn.receiver_name.len() > 0 && fn.receiver_name == name) { return util.base_type_name(fn.receiver_type); }
    for pd in fn.params { if (pd.name == name) { return pd.type_name; } }
    return var_annot_in_stmts(fn.body, name);
}
function var_annot_in_stmts(stmts: ast.Stmt[], name: string): string {
    for stmt in stmts {
        var t: string = "";
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return v.type_name; } },
            ast.StmtIf(f) => { t = var_annot_in_stmts(f.then_body, name); if (t.len() == 0) { t = var_annot_in_stmts(f.else_body, name); } },
            ast.StmtWhile(w) => { t = var_annot_in_stmts(w.body, name); },
            ast.StmtFor(fo) => { t = var_annot_in_stmts(fo.body, name); },
            ast.StmtMatch(m) => { for arm in m.arms { if (t.len() == 0) { t = var_annot_in_stmts(arm.body, name); } } },
            _ => {}
        }
        if (t.len() > 0) { return t; }
    }
    return "";
}

function reclaimable_scalar_tuple(body: ast.Stmt[], borrowable: string[], reassigned: string[], recv_borrow: string[], structs: parser.StructDecl[], tretn: string[], str_fresh_ret: string[], tups: string[], out: string[]): string[] {
var ti: i32 = 0;
while (ti < tups.len()) {
    // tups holds BINDING-SITE keys (#7272); every gate below asks about the
    // variable, so each takes the bare name back out of the key.
    var tnm: string = reclaim_site_name(tups[ti]);
    // #7282: a plain `var v = t` alias shares the box, so it shares the
    // credit. The bind retained it (lower_stmt_var's ExprIdent arm), both
    // slots sweep, and the refcount arbitrates.
    var tal: string[] = [];
    tal = alias_chain_sites_of(body, tnm, borrowable, recv_borrow, body, tal);
    if (!body_unsafe_for_alias_ret_ok(body, tnm, borrowable, recv_borrow, tal, util.index_of_str(tretn, tnm) >= 0)) {
        out = out.append("TUP:" + tups[ti]);
        out = credit_alias_sites(out, "TUP:", tal);
        // A REBOUND scalar tuple additionally earns "TUPREBIND:" when every
        // assignment builds a fresh tuple (#6127), which lets lower_stmt_assign
        // release the box the rebind orphans. "TUP:" alone only frees the FINAL
        // value at scope exit, so a loop rebind leaked one box per iteration.
        // A separate credit rather than a widened "TUP:" because the two answer
        // different questions — "TUP:" that the box is non-escaping and freeable
        // at exit, this that the SUPERSEDED box is freeable at the assignment.
        if (util.index_of_str(reassigned, tnm) >= 0
            && all_assigns_fresh_scalar_tuple(body, tnm,
                    rctuple_type_of_decl(body, tnm))) {
            out = out.append("TUPREBIND:" + tups[ti]);
        }
        // The bare-ident element release (#7226) needs the owned-pointer-element
        // extraction gate the "TUPRC:" class below applies, for exactly the reason
        // its comment gives: `return t.1` / `var u = t.1` hands the element's
        // reference to a NEW owner, so releasing it here over-releases it (witnessed
        // as exit 99 on the escaping form). A scalar read `t.0`, an indexed read
        // `t.1[j]` and their `.len()` stay borrows and keep the credit.
        //
        // The annotation is REQUIRED rather than skipped-when-absent: without a
        // tuple type there is no way to tell a scalar element copy from a pointer
        // extraction, and the wrong guess here is an over-release. An un-annotated
        // tuple keeps "TUP:" and simply does not earn the element release.
        var tupelemty: string = rctuple_type_of_decl(body, tnm);
        if (tupelemty != "" && !rctuple_payload_escapes_alias(body, tnm, tupelemty, structs, borrowable, tal, [], true)) {
            out = out.append("TUPELEMOK:" + tups[ti]);
        }
        // The STRING limb of that release needs one fact the array limb does
        // not: every writer of the slot must agree the position holds a counted
        // owned string (assigns_str_pos_owned). The kinds are recorded from the
        // var site alone but replayed against whatever box is in the slot, so
        // without agreement a rebind could leave a VIEW there for the release to
        // free out from under the view's own sweep. Vacuous for a tuple that is
        // never rebound, which is why an un-reassigned string element keeps
        // exactly the release it had.
        if (tupelemty != ""
                && assigns_str_pos_owned(body, tnm, tupelemty, body, str_fresh_ret, reassigned)) {
            out = out.append("TUPSTRW:" + tups[ti]);
        }
    }
    ti = ti + 1;
}

    return out;
}

function reclaimable_rc_tuple(body: ast.Stmt[], borrowable: string[], rctups: string[], reassigned: string[], recv_borrow: string[], structs: parser.StructDecl[], sweeprc: string[], tretn: string[], str_fresh_ret: string[], msites: string[], out: string[]): string[] {
var rti: i32 = 0;
while (rti < rctups.len()) {
    // Binding-SITE keys here too (#7272); the gates take the bare name.
    var rnm: string = reclaim_site_name(rctups[rti]);
    var ral: string[] = [];
    ral = alias_chain_sites_of(body, rnm, borrowable, recv_borrow, body, ral);
    // Struct literals that took a COUNTED share of this tuple (the field retain
    // + emit_struct_tuple_field_drops pair). Not escapes: both owners release.
    var rcnt: string[] = rctuple_counted_store_sites(body, rnm, structs, msites, []);
    if (!body_unsafe_for_alias_ret_counted(body, rnm, borrowable, recv_borrow, ral, util.index_of_str(tretn, rnm) >= 0, rcnt)) {
        var rctty: string = rctuple_type_of_decl(body, rnm);
        // Element binds the frame keeps are not escapes (#7766): refusing them
        // cost the tuple its whole credit, box included, where native is flat.
        var relem: string[] = tuple_elem_bind_sites_of(body, rnm, borrowable);
        if (rctty == "" || !rctuple_payload_escapes_alias_ret_ok(body, rnm, rctty, structs, borrowable, ral, relem, util.index_of_str(tretn, rnm) >= 0, true)) {
            out = out.append("TUPRC:" + rctups[rti]);
            // THE ALIAS TAKES THE BOX-ONLY RELEASE, NEVER THE DEEP ONE, and
            // this is the general rule the struct case taught: only the BOX
            // was retained at the bind, so only the box may be released
            // twice. "TUPRC:" / "TUPRCS:" drive a type-driven DEEP free
            // (emit_rctuple_deep_free — every rc position, then the box), so
            // duplicating them frees each element twice: measured as exit 99
            // on `var t: (i32, i32[]) = (i, [i, i+1]); var v = t;` with
            // allocs == frees at live_bytes 0, the census silent as always.
            //
            // "TUP:" is the shallow box dec, and the alias has no recorded
            // element kinds (its init is an ident, not a literal), so
            // emit_tup_elem_releases emits nothing for it. The source keeps
            // the one deep free; the alias spends the one extra box
            // reference. The two classes are documented as disjoint per SLOT,
            // and these are different slots.
            out = credit_alias_sites(out, "TUP:", ral);
            // "TUPRCS:" additionally lets the scope-exit sweep deep-free the FINAL
            // value (#6127). "TUPRC:" alone is consumed only by the StmtVar rebind
            // path, so a SINGLE-BIND rc-tuple was credited, entry-zeroed, and then
            // never released — allocs=200 frees=0 live_bytes=8000 per 100 rounds
            // with no reassignment anywhere. Three extra conditions on top of
            // "TUPRC:", each load-bearing:
            //   - a tuple ANNOTATION, since the sweep frees by TYPE (it has no
            //     init literal at exit);
            //   - tuple_arg_payload_retained, so the tuple holds a counted
            //     reference to every rc-typed position the blind type-driven drop
            //     dec's: a fresh literal it sole-owns, or a bare ident the
            //     construction retained (#7281);
            //   - not reassigned, because the assign path emits no release for
            //     this class, so the final value's shape cannot be judged from
            //     the declaration alone.
            //   - not reassigned, OR every assignment rebuilds a fresh rc-tuple
            //     of the SAME type (all_assigns_fresh_rc_tuple, #6127). #6251
            //     excluded reassigned names outright because the assign path
            //     emitted no release, which left a REBOUND rc-tuple freeing
            //     nothing at all; lower_stmt_assign now deep-drops the superseded
            //     chain, and proving every assignment rebuilds the same shape is
            //     what makes the declaration's type a sound description of the
            //     final value the sweep frees by.
            var rc_rebind_ok: boolean = util.index_of_str(reassigned, rnm) < 0
                || all_assigns_fresh_rc_tuple(body, rnm, rctty, structs, str_fresh_ret);
            if (rctty != "" && rc_rebind_ok
                    && util.index_of_str(sweeprc, rctups[rti]) >= 0) {
                out = out.append("TUPRCS:" + rctups[rti]);
            }
        }
    }
    rti = rti + 1;
}

    return out;
}

function reclaimable_rcenum(rcenums: string[], out: string[]): string[] {
var rei: i32 = 0;
while (rei < rcenums.len()) {
    // collect_fresh_rcenum_names already proved single-owner + consumed-by-one-
    // match + dead-after + non-escaping (name_escapes_outside_stmt skipping the
    // match) + no moved arm payload, per block — so credit directly.
    //
    // An "S:" marker means the name has NO consuming match, so its final value
    // reaches function exit unreleased and earns the extra "RCENUMS:" sweep
    // credit beside the rebind one. Both are emitted for that half; the
    // match-consumed half gets "RCENUM:" alone.
    var rname: string = rcenums[rei];
    if (rname.len() > 2 && rname[0] == b'S' && rname[1] == b':') {
        var bare: string = slice_unchecked(rname, 2, rname.len()) + "";
        out = out.append("RCENUM:" + bare);
        out = out.append("RCENUMS:" + bare);
    } else {
        out = out.append("RCENUM:" + rname);
    }
    rei = rei + 1;
}

    return out;
}

function reclaimable_scenum(scenums: string[], out: string[]): string[] {
var sei: i32 = 0;
while (sei < scenums.len()) {
    out = out.append("SCENUMS:" + scenums[sei]);
    sei = sei + 1;
}

    return out;
}

function reclaimable_string(body: ast.Stmt[], borrowable: string[], tup_ok: string[], msites: string[], reassigned: string[], recv_borrow: string[], sfok: string[], str_cands: string[], strs: string[], structs: parser.StructDecl[], out: string[]): string[] {
var si: i32 = 0;
while (si < strs.len()) {
    // The lists now hold BINDING-SITE keys (#7292 / #7253 step 1); the gates
    // all ask about the variable, so each takes the bare name back out. The
    // cross-list `strs` dedupes below compare key-to-key and get sharper for
    // it: two same-named bindings no longer collapse into one another.
    var snm: string = reclaim_site_name(strs[si]);
    // #7282 string limb: a plain `var v = s` alias shares the box, so it
    // shares the credit. The bind retained it (lower_stmt_var's ExprIdent
    // arm), both slots sweep, and the refcount arbitrates.
    //
    // The two halves are one decision, not two that happen to agree. Without
    // the forgiveness the alias is a bare-ident escape and `s` earns nothing,
    // which is the leak this closes (200 allocs / 0 frees per 100 rounds).
    // With the forgiveness but no alias credit, `s` is swept once while two
    // slots hold the box — a leak of the alias' retain. Granting both is what
    // makes inc and dec co-extensive.
    //
    // A string is a single box with no field or element walk, so the alias
    // takes the SAME "STR:" class rather than a shallow variant: there is no
    // deep release here to withhold from it, which is what makes this simpler
    // than the struct and rc-tuple cases rather than merely different.
    var sal: string[] = [];
    sal = alias_chain_sites_of(body, snm, borrowable, recv_borrow, body, sal);
    // The alias REASSIGN (`t = s`) joins the alias BIND, on the same terms: the
    // assignment now RETAINS (keyed on the "STRALIASSRC:" row below), so `t`
    // holds a counted share rather than a borrow. Its site goes into `sal` so
    // the escape walker reads the source's use there as the share it is, and
    // takes the "STR:" credit alongside — the same "granting both is what makes
    // inc and dec co-extensive" this block already states for the bind.
    var sra: string[] = str_alias_reassign_target_sites(body, snm, str_cands, body, []);
    var sal_all: string[] = sal;
    var sri: i32 = 0;
    while (sri < sra.len()) { sal_all = push_str_unique(sal_all, sra[sri]); sri = sri + 1; }
    // A struct-literal string FIELD is the third counted share this credit
    // survives, alongside the alias bind and the alias reassign: the
    // construction retains the box and the holder's field drop decs it, so
    // the source keeps the claim its own release balances. Tagged per
    // candidate rather than seeded into tup_ok once, because the move gate
    // inside is a question about THIS name's use at THIS literal.
    var sfsites: string[] = rc_counted_field_sites(body, snm, structs, sfok, msites, out, "string", []);
    var str_tup_ok: string[] = tup_ok;
    var sfi: i32 = 0;
    while (sfi < sfsites.len()) { str_tup_ok = str_tup_ok.append("SFLD:" + sfsites[sfi]); sfi = sfi + 1; }
    if (util.index_of_str(reassigned, snm) < 0
        && !body_unsafe_for_tup_alias(body, snm, borrowable, str_tup_ok, recv_borrow, sal_all)) {
        out = out.append("STR:" + strs[si]);
        out = credit_alias_sites(out, "STR:", sal_all);
        if (sra.len() > 0) {
            // The source is handing its box on at an assignment, so the retain
            // has to fire there. lower_stmt_assign keys on this row.
            out = out.append("STRALIASSRC:" + strs[si]);
        }
    }
    si = si + 1;
}

    return out;
}

function reclaimable_litstr_local(body: ast.Stmt[], borrowable: string[], tup_ok: string[], lits: string[], reassigned: string[], recv_borrow: string[], str_cands: string[], strs: string[], out: string[]): string[] {
var li2: i32 = 0;
while (li2 < lits.len()) {
    var lnm: string = reclaim_site_name(lits[li2]);
    var lal: string[] = alias_bind_sites_of(body, lnm, borrowable, recv_borrow, body, []);
    var lra: string[] = str_alias_reassign_target_sites(body, lnm, str_cands, body, []);
    var lri: i32 = 0;
    while (lri < lra.len()) { lal = push_str_unique(lal, lra[lri]); lri = lri + 1; }
    if (util.index_of_str(strs, lits[li2]) < 0
        && util.index_of_str(reassigned, lnm) < 0
        && !litstr_tostring_recv_body(body, lnm)
        && !body_unsafe_for_tup_alias(body, lnm, borrowable, tup_ok, recv_borrow, lal)) {
        out = out.append("STR:" + lits[li2]);
        out = credit_alias_sites(out, "STR:", lal);
        if (lra.len() > 0) { out = out.append("STRALIASSRC:" + lits[li2]); }
    }
    li2 = li2 + 1;
}

    return out;
}

