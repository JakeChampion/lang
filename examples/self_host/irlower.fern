pub function (s: LowerState) map_type_of(i: i32): string {
    if (i < 0 || i >= s.local_map_type.len()) { return ""; }
    return s.local_map_type[i];
}

// expr_map_kind reports a map EXPRESSION's key kind — 1 for i32 keys, 0 for
// string keys, -1 if `e` is not a map. Unlike map_type_of (which only types a
// map LOCAL slot), this recognises the chained map-construction expressions a
// `Map { k: v, … }` literal desugars to: `map_new[_i32](n).insert(k0,v0)
// .insert(k1,v1)…`. `map_new` fixes the key kind (string), `map_new_i32` (i32),
// and an `.insert` / `.set` / `.delete` mutator returns the same map — so the
// kind propagates up the chain. Lets `.insert` on a map-typed call result lower
// through the IR (#2884 follow-up: Map literals), not just on a bare local.
pub function expr_map_kind(e: parser.Expr, s: LowerState): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            var mt: string = s.map_type_of(s.slot_of(id.name));
            if (mt != "") { return map_key_kind_of(mt); }
            return 0 - 1;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "map_new" && c.args.len() == 1) { return 0; }
                    if (cid.name == "map_new_i32" && c.args.len() == 1) { return 1; }
                    return 0 - 1;
                },
                parser.ExprFieldAccess(cfa) => {
                    if (cfa.field == "insert" || cfa.field == "set" || cfa.field == "delete") {
                        return expr_map_kind(cfa.obj, s);
                    }
                    return 0 - 1;
                },
                _ => { return 0 - 1; }
            }
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

