            // store, so it is not a credited slot.
            if (sl.has_base && !arrparam_use_ok(sl.base, pn, false, reg, pfx, structs, sfok)) { return false; }
            // The construction-side string retain is gated on slit_reclaim, so a
            // STRING slot in a literal whose type does not route field reclaim is
            // stored UNCOUNTED — crediting it would make the caller's post-call
            // free an over-release. Array slots are unconditional and unaffected.
            var scnt: boolean = true;
            if (pfx == "SCNT:" && !struct_routes_field_reclaim_at(structs, sfok, sl.type_name)) { scnt = false; }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { if (!arrparam_use_ok(sl.field_values[i], pn, scnt, reg, pfx, structs, sfok)) { return false; } i = i + 1; }
            return true;
