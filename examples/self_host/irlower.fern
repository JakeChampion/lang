    // builtins, so neither shadows a user function; std/tcp's
    // tcp_serve_supervised is the stdlib caller.
    if (cid.name == "proc_fork" && c.args.len() == 0) {
        return s.emit(ir.op_proc_fork());
    }
    if (cid.name == "proc_waitpid" && c.args.len() == 1) {
        var pws: LowerState = lower_expr(c.args[0], s);
        if (!pws.ok) { return pws; }
        return pws.emit(ir.op_proc_waitpid());
