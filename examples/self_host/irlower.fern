        parser.ExprSlice(sl) => { return param_consumed_expr(sl.array, name) || param_consumed_expr(sl.start, name) || param_consumed_expr(sl.end, name); },
        parser.ExprFieldAccess(fa) => { return param_consumed_expr(fa.obj, name); },
