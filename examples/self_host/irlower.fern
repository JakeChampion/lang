    if (cid.name == "remove_dir_all" && c.args.len() == 1) {
        var rdas: LowerState = lower_expr(c.args[0], s);
        if (!rdas.ok) { return rdas; }
        return rdas.emit(ir.op_remove_dir_all());
    }
