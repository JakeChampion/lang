// SigReg is a module-wide signature registry: the "<name>" / "<name>|<value>"
// rows, plus a bucket index over each row's KEY — the text before its first
// '|'. A probe walks one bucket instead of the whole registry, which matters
// because these are whole-module lists (the compiler's own largest is ~4,900
// rows) consulted per call argument and per local slot.
//
// head[b] is the first row index in bucket b (-1 when empty) and next[i] chains
// to the next row in the same bucket, ASCENDING — so a bucket walk visits rows
// in registration order and a duplicated name still resolves to its first row,
// as the linear scan did.
pub struct SigReg {
    rows: string[],
    head: i32[],
    next: i32[],
}

// FnSigs is the module-wide signature registry lowering and emit consult to
// resolve what a call RETURNS and how its params are passed. Every field is
// derived once per module (fn_sigs_of) and threaded read-only.
//
// These were 26 parallel `string[]` parameters threaded through lower_func,
// emit_function_via_ir and emit_module_funcs — a 28-to-32-argument call at
// every site, re-spelled identically in four backends. As one value, a new
// registry is a field here plus a line in fn_sigs_of, instead of an edit to
// ~15 signatures and call sites across irlower / asm_ir / asm_arm64_ir /
// wasm_ir. It also unpins LowerState's field count, which had grown tight
// enough to force booleans into the ret_arrdyn bit word.
pub struct FnSigs {
    // arr_ret_fns: functions whose return type is an array, so a `var x = f()`
    // is a move (owned, no inc) and x is array-tracked.
    arr_ret_fns: SigReg,
    // str_ret_fns: functions returning `string`, so `var s = f()` (and
    // `f().len()`) tracks the result as a string for op dispatch. Strings are
    // not RC'd, so this is type tracking only.
    str_ret_fns: SigReg,
    // bool_ret_fns: functions returning `boolean`, so a CALL result dispatches
    // "boolean.<m>" rather than falling to expr_scalar_type's "i32" default —
    // which rendered `f().to_string()` as 1/0. Keyed like str_ret_fns (bare
    // for a free function, "<BaseType>.<method>" for a method) for the same
    // reason: a method name collides across receiver types.
    bool_ret_fns: SigReg,
    // strarr_ret_fns: functions returning `string[]` — the string-element
    // overlay on arr_ret_fns, which still drives the array's RC.
    strarr_ret_fns: SigReg,
    // arr_method_fns: std/array's `__method_Array_<m>` helper free functions
    // (possibly `<mod>__`-mangled), so `arr.<m>(args)` lowers as a free call.
    arr_method_fns: string[],
    // opt_ret_fns: "name|rettype" for functions returning Option[T]/Result[T, E],
    // so a match on `f()` recovers the bound payload's type (T for Some/Ok, E
    // for Err) and binds it correctly.
    opt_ret_fns: SigReg,
    // i64_ret_fns: functions returning i64, so a call to one is recognised as an
    // i64 value (infer_expr_width / lower_i64).
    i64_ret_fns: SigReg,
    // tuple_ret_fns: "name|rettype" for functions returning a tuple, so
    // `var x = f()` / `var (a, b) = f()` recovers each element's type tag.
    tuple_ret_fns: SigReg,
    // arrtup_ret_fns: "name|(elem tuple)" for functions returning an ARRAY OF
    // tuples (`mk(): (i32, f64)[]`). Distinct from tuple_ret_fns, whose entries
    // are the tuple's own element tags: here the value is the ELEMENT TUPLE's
    // full spelling, which is what an array slot's arrarr_elem holds.
    //
    // Without it, `var ps = mk();` recorded no arrarr_elem — that is only
    // derived from an ANNOTATION or an array LITERAL — so every consumer that
    // reads a tuple tag off the slot fell through to an untyped 4-byte read.
    // On wasm32 an f64 element then came back wrong while a string element (a
    // 4-byte pointer) survived, so it read as a width bug rather than a missing
    // tag. Populating the slot fixes all four readers at once, including
    // `for p in ps`, which has no ExprIndex node to fall back on.
    arrtup_ret_fns: SigReg,
    // struct_ret_fns: "name|StructType" for functions returning a (leaf-safe,
    // scalar-field) struct, so `var p = f()` tracks p's type for `p.x`.
    struct_ret_fns: SigReg,
    map_ret_fns: SigReg,
    // f64_ret_fns: functions returning f64 (expr_is_f64). Without it an
    // unannotated `f(a) * g(b)` of two f64-returning calls would mis-select
    // integer mul on the float bits.
    f64_ret_fns: SigReg,
    // f64arr_ret_fns: functions returning f64[], so `var x = f()` element-width-
    // tracks x and a later x[i] reads an 8-byte f64 rather than 4.
    f64arr_ret_fns: SigReg,
    // i64arr_ret_fns: functions returning i64[]; like f64arr_ret_fns, but x[i]
    // reads an 8-byte i64 and types as i64.
    i64arr_ret_fns: SigReg,
    // erased_elem_ret_fns: functions returning an array of a bare typevar (`U[]`),
    // whose element width the callee never fixes — see erased_elem_ret_fns_of.
    erased_elem_ret_fns: SigReg,
    // fn_param_sigs: "callee|<flags>" rows, flag i '1' when the callee's param i
    // is a function type. Drives type-directed function-VALUE detection: a bare
    // function-name ARGUMENT at a "fn" param lowers to const_func, not a call.
    fn_param_sigs: SigReg,
    // ret_type_fns: "name|ret_type" rows for every non-generic function, in
    // declaration order — the rc-plan cluster's call-return typing
    // (rc_fe_call_ret_type) reads it instead of scanning the funcs list per
    // binding (#6074: derive module-scale facts once per module).
    ret_type_fns: SigReg,
    // ret_fn_sigs: "name|<tag>" rows for every non-generic function that RETURNS
    // a fn value, the tag being the funcref signature a call THROUGH that result
    // dispatches on (`mk()(4.5)`). Built from the FuncDecl sidecars through the
    // same fn_sig_of rules a parameter, field, tuple element and array element
    // go through, so none of the five can disagree (#5986). A function whose
    // returned signature is all-i32 records no row: `$fn<N>` already names it.
    ret_fn_sigs: SigReg,
    // noesc_ret_fns: "name|" rows for the returns-no-param-escape subset
    // oracle (noesc_ret_fns_of) — rc_fe_rhs_tainted's user-call arm untaints
    // a qualified callee's result regardless of argument taint.
    noesc_ret_fns: SigReg,
    // closure_fns: functions whose body returns a closure box (a hoisted
    // escaping lambda). `var f = <call to one>` marks f a closure local.
    closure_fns: string[],
    // closurearr_ret_fns: functions returning an ARRAY of closure boxes, so
    // `arr[i](args)` dispatches env-first instead of bare-calling the box
    // pointer as code (a SIGSEGV otherwise).
    closurearr_ret_fns: string[],
    // const_fns: zero-arg, receiver-less functions (a `const` desugars to one).
    // A bare ident reference to one — not a local — is a CALL to it.
    const_fns: string[],
    // borrowable_params: params a callee only reads, so the caller need not
    // retain across the call. The emit paths pass an inter-procedural fixpoint
    // here rather than borrowable_params_of's single pass.
    borrowable_params: string[],
    // borrow_bare: the same rows as borrowable_params, bucketed by the bare
    // name after the key's last '.', for the one query that only knows a
    // method's name (reclaim_lit_arg_callees).
    borrow_bare: string[],
    // fn_names: every free function in the module. A bare-ident call whose name
    // is in here resolves to that user function and must NOT be intercepted as
    // a same-named builtin (`len` / `exit` / `chr` / …).
    fn_names: SigReg,
    // fresh_struct_ret_fns: functions returning a fresh struct box. Looser than
    // return_fresh_struct_ret_fns — inner element buffers may alias live locals.
    fresh_struct_ret_fns: string[],
    // consume_safe_params: params safe to consume in place, from the
    // inter-procedural pass. Empty on the analysis-only lowering paths.
    consume_safe_params: string[],
    // return_fresh_struct_ret_fns: functions whose EVERY return is a strict-fresh
    // struct literal, so the returned box is the unambiguous sole owner of every
    // field buffer. Lets the ExprStructLit construction-inc skip retaining a
    // nested-struct field bound from such a call.
    return_fresh_struct_ret_fns: string[],
    // recv_borrow_fns: "<Type>.<method>" keys whose RECEIVER is a pure borrow,
    // so a caller's struct local keeps its deep drop across the call
    // (recv_borrow_fns_of).
    recv_borrow_fns: string[],
    // str_fresh_ret_fns: functions returning a fresh, sole-owned string box
    // (see str_producer_ownership).
    str_fresh_ret_fns: string[],
    // opt_fresh_ret_fns: functions returning a fresh, sole-owned Option/Result box.
    opt_fresh_ret_fns: SigReg,
    // strfld_ok_types: struct types whose `string` fields are reclaim-safe at
    // field-drop (strfld_reclaim_ok_types_of).
    strfld_ok_types: string[],
    // tuple_fresh_ret_fns: functions returning a fresh, sole-owned tuple box.
    tuple_fresh_ret_fns: string[],
    // own_positions: "fn|idx" for every declared `own` parameter of a free
    // function — the argument there was MOVED in, so a callee handing it straight
    // back returns it uncounted (rebind_call_same_dec).
    own_positions: string[],
    // consumed_arr_positions: "fn|idx" for every consumed-threaded array
    // parameter of a free function (reassigned, not `own` — the ownflag_name
    // protocol): the callee never releases the incoming buffer, so a temp the
    // caller hands there has no owner but the caller, once the call returns.
    consumed_arr_positions: string[],
    // trmc_consume_fns: "fn|param" entries for TRMC functions whose loop CONSUMES
    // its scrutinee, freeing each cell as it walks past (#5333). Both halves of
    // that bargain read this one registry — the loop's release and the call
    // site's retain — because they are only sound together: the loop's
    // uniqueness check is a guard only if an aliased argument arrives already
    // retained. Recomputing either half locally lets a path that has the verdict
    // free a cell a path that lacks it never retained.
    // param_counted: "ACNT:<key>|<flags>" for array params and
    // "SCNT:<key>|<flags>" for string ones — parameters every appearance of
    // which is a counted store or a non-retaining read, so a fresh argument
    // passed there is released by one post-call dec (param_counted_of).
    param_counted: string[],
    trmc_consume_fns: string[],
    // handback_params: "fn|idx" for parameters the callee RETURNS BARE
    // (`function keepit(s: S): S { return s; }`) — the argument's box flows
    // back to the caller with no counted reference on the self-host, so the
    // struct plan gate refuses a credited name passed at such a position
    // (native retains at the return instead — paramCountedRetain's channel).
    handback_params: string[],
}

pub struct LowerState {
    ops: ir.Op[],
    locals: LocalInfo[],
    // (per-local-slot info lives in the LocalInfo[] above; field docs are on LocalInfo)
    ctrl: i32,
    loop_blk: i32[],
    // ret_is_i64: this function returns i64, so `return <i64expr>` lowers via
    // lower_i64.
    ret_is_i64: boolean,
    // ret_arrdyn: a flag word folding what would otherwise be four booleans:
    //   bit 0 (ret_arrdyn % 2 == 1): this function returns i64[] (so
    //     `return [literal]` lowers its elements as i64 via arr_make_i64,
    //     not the generic i32 path).
    //   bit 1 ((ret_arrdyn / 2) % 2 == 1): this function returns a SCALAR
    //     `dyn Trait` (NOT a `dyn Trait[]` array). When set, `return <expr>`
    //     coerces the value to `dyn Trait` via lower_dyn_arg — a
    //     primitive/string is heap-boxed via op_dyn_box so it carries a shape
    //     pointer, a struct/enum flows unboxed (docs/DYN-TRAITS.md §4.3).
    // Set in lower_func from fn.ret_type and threaded read-only; read via the
    // ret_i64arr() / ret_dyn() accessor methods.
    ret_arrdyn: i32,
    // sigs: the module-wide signature registry (see FnSigs). Threaded read-only
    // except for the two call-site-augmented views lower_func installs.
    sigs: FnSigs,
    // clo_base: the receiver-qualified name (clo_owner_name) every closure /
    // wrapper hoisted out of this function is named under.
    clo_base: string,
    // cur_fn: the name of the function being lowered. An escaping capturing
    // ExprLambda in it is hoisted to `<cur_fn>$clo(__env, params…)`; lowering
    // the lambda emits const_func(<cur_fn>$clo) + the captures into a tuple box.
    cur_fn: string,
    // cur_ret: the enclosing function's return-type spelling (e.g.
    // "Result[i32, AppErr]"). Threaded read-only like cur_fn; used by lower_try
    // to recover the enclosing return's error type E2 for the From-converting
    // `?` desugar (#2697) — when a propagated `Result[_, E1]` must be widened to
    // `Result[_, E2]` via `Err(E2.from(e))`.
    cur_ret: string,
    // closure_locals: names of locals currently holding a closure BOX (tuple
    // [funcval, caps…]) rather than a Slice-1 bare function value — so a call
    // `f(args)` dispatches to the env-passing closure-call form instead of the
    // plain call_indirect. A small list (grown only at closure bindings), not a
    // per-slot array.
    closure_locals: string[],
    // tup_elem_kinds: the "TUP:" tuple locals' per-element rc kinds (#7226) —
    // "<slot>|<kinds>" rows, SLOT-keyed (see add_tup_elem_kinds). A dedicated
    // field per #7253 step 2, formerly "TUPELEM:"-multiplexed into
    // reclaimable_names.
    tup_elem_kinds: string[],
    // alias_incs: dump-only record of the var-bind alias retains this
    // function's lowering decided (`line:col=name` per bind whose
    // VarTypes.alias_inc fired). Exported through LowerResult/LoweredFn for
    // the `-rc-plan` aliasBindIncs table (#4482); nothing on the emit path
    // reads it.
    alias_incs: string[],
    // dead_alias_ok: the dead-alias-cancelled bind-site keys (#4402 opt 1,
    // dead_alias_of) — arr_dead_alias_bind's pure half. Threaded read-only.
    dead_alias_ok: string[],
    // spread_sites: this function's base-spread rows (spread_sites_of). A
    // `T { ...base }` copies every field pointer into a fresh box with NO inc, so a
    // counted field share of a type it copies would sit behind one release too many.
    // Seeded once per function because the share is decided mid-expression, with no
    // body in reach.
    spread_sites: string[],
    // fnval_seed: the fn-VALUE sidecars lower_func's pre-pass computed for
    // fn-typed top-level LOCALS, as "<binding site>|<dyn>|<sig>|<ret>" rows,
    // consumed by bind_var_slot and stamped onto the slot it creates. The facts
    // themselves live on LocalInfo (see its fn_dyn / fn_sig / fn_ret /
    // fn_opt_ret); this is only the hand-off across the one boundary where a
    // slot does not exist yet, because the pre-pass runs before any body
    // lowering. Params need no hand-off — their slots are the frame layout
    // lower_func just built, so they are stamped into locals0 directly.
    fnval_seed: string[],
    // structs: the module's struct decls, for field-index / field-order lookup
    // (constant across the lowering; threaded read-only).
    structs: parser.StructDecl[],
    // reclaimable_names: the set of local names that ESCAPE this function — appear
    // in a return value, a call argument, a method receiver, a struct-literal
    // field value, an array element, or any assignment/binding RHS. Computed
    // once per function (collect_reclaimable_names) and threaded read-only. A struct
    // local whose name is NOT here, and which was bound from a fresh literal /
    // struct-returning call (a sole-owner rc=1 value), is reclaim-safe: freeing
    // its box cannot dangle another reference. Drives the struct rc-dec.
    reclaimable_names: string[],
    // aliased_names: the set of ARRAY local names that acquire a lasting
    // LOCAL alias inside this function — a name bound to a second local
    // (`var b = a` / `b = a`) or stored as a bare ident into a container literal
    // (`H { xs: a }`, `[a]`, `(a, …)`). Computed once per function
    // (aliased_array_names_of) and threaded read-only. The in-place self-reassign
    // `a = a.with(i, v)` (an arr_set on the assumption `a` is the sole owner) is
    // UNSOUND when `a` is aliased — the in-place write mutates the buffer the
    // alias still reads (#3599). When the target is in this set we instead lower
    // the `.with` as a value-producing CLONE (lower_arr_with_value) and store it
    // back, leaving the aliased buffer untouched (correct, if leak-y, ahead of
    // the full Perceus refcount-guarded reuse). Return-position aliases
    // (`return EvalOut { heap: heap }`) are deliberately NOT counted: the value
    // moves out at function exit, after all in-place mutations, so it creates no
    // observable shared-buffer hazard — and counting it would wrongly disable the
    // hot VM `stack/heap/locals = …​.with(…)` in-place stores.
    aliased_names: string[],
    // map_clone_sites: the site keys (target@line:col) of the map self-reassigns
    // `m = m.insert(k, v)` at which an alias of m may be live, so the store
    // clones instead of mutating in place (map_clone_insert_sites_of, #7235).
    map_clone_sites: string[],
    // borrowed_names: the ARRAY/MAP names this function does not OWN — a
    // param that is neither `own`, inferred-moved, nor a `$cell$` capture cell,
    // or a local bound from a field read whose source is still live (#6158).
    // ONLY the `.with` self-reassign consults it; see borrowed_names_of for why
    // it is not folded into aliased_names.
    borrowed_names: string[],
    // xblock_pending: cross-block reuse pairings available to a construction
    // NESTED in the statement currently being lowered — encoded
    // "recip-site|donor" (the recipient's binding SITE key | the dead block-top
    // donor local name; the site because xblock_donor_for takes the first
    // matching row and sibling if-arms deliberately restart from the same
    // consumed set, so two arms can mint rows under one spelling). lower_block sets
    // these before lowering a nested if/while/block whose body contains a
    // cross-block reuse recipient, and clears them after; the recursive lower_block
    // of that body consumes a matching entry when it constructs the recipient.
    xblock_pending: string[],
    // try_cleanup: the parse-level defer pass's `?`-edge cleanup markers
    // (#4334) — the `if (__dfa_tryall) {…}` / `if (__dfa_tryerr) {…}` StmtIf
    // blocks lower_defers_func appends to a defer-using function's body.
    // Extracted once in lower_func and threaded read-only; lower_try replays
    // the guarded statements (all-defers marker first, then the errdefer one)
    // at the `?` failure edge, before the exit dec-sweep — mirroring native's
    // emitDeferCleanup + emitErrDeferCleanup at the TryOp failure edge.
    // Empty for functions without defers, making lower_try byte-identical
    // to the pre-#4334 lowering there.
    try_cleanup: ast.Stmt[],
    // defer_slots / defer_guard let a REPLAYED defer action name a BLOCK-scoped
    // local. lower_defers_func replays each action wherever the function can
    // exit, including the tail, and by then the declaring block has retired its
    // locals out of name resolution (retire_locals). Each block exit records its
    // own live slots here as "<flag>|<name>|<slot>" (retire_locals_for_scope) —
    // one entry per `__dfa<i>` flag the block's subtree ARMS — and defer_guard
    // names the flag whose `if (__dfa<i>)` replay is currently being lowered, so
    // slot_of resolves through the record.
    // A record WINS over an outer same-named local, which is
    // what makes a shadowed block local resolve to its own slot; the flag key is
    // what keeps two sibling blocks declaring one name on two slots. #6821.
    defer_slots: string[],
    defer_guard: string,
    // grow_exempt (#4873 port): the ident args of the CURRENT statement's
    // direct call whose old value dies at the statement (the strict
    // self-reassign / return-position occurs-once shapes) — the call-site
    // grow bracket skips them so the in-place accumulator fast paths stay
    // O(n). Set/cleared around each statement by lower_stmt's wrapper.
    grow_exempt: string[],
    // append_inplace: the receiver names whose EXPRESSION-position `.append`
    // may stay on the consume-form in-place grow (#6891). Computed ONCE per
    // function by append_inplace_names_of; every other receiver is bracketed
    // at its push so the grow helper copies and the receiver keeps value
    // semantics. See that function for the two sound shapes.
    append_inplace: string[],
    // grow_sole: the #6043 sole-occurrence deaths, computed ONCE per function
    // (grow_sole_exempt_names_of) because the per-statement hook cannot see the
    // whole body. A name here occurs exactly once in the entire body, so the one
    // statement carrying that occurrence is the only one a bracket can consult it
    // from — which is why lower_stmt_grow_exempt can union it in unconditionally.
    grow_sole: string[],
    // own_params: the names of THIS function's `own` (consuming) parameters.
    // An `own` param was TRANSFERRED by the caller, so — unlike the borrowed
    // params the n_params boundary otherwise assumes — handing it back out of
    // a `return` transfers it on rather than aliasing it, and needs no
    // return-transfer retain. See the return path's use for why that retain is
    // what made accumulator threading quadratic.
    own_params: string[],
    // optret_pending: consumed-match candidates whose arms are CURRENTLY being
    // lowered — "slot#s" (Option/Result string payload) / "slot#a"
    // (Option/Result leak-safe-array payload) / "slot#b" (scalar-enum or
    // scalar-Option box, shallow dec) / "slot#e<enum>;<moved…>" (rc-payload
    // enum, runtime variant dispatch) entries. A `return` inside such an arm
    // would make the post-match drop site dead code (the #4353 p1/p3 and #6219
    // leaks), so emit_dec_sweep_except_list (which every return form runs)
    // drops the pending payload + box before op_return; the drop zeroes the
    // slot, and fallthrough paths keep the post-match drop — each dynamic path
    // frees the box exactly once. Set/restored around the candidate's match
    // statement by the fn-body loop and lower_block; empty at fn end.
    optret_pending: string[],
    n_params: i32,
    ok: boolean,
    // fail_why: a one-line description of the INNERMOST AST node that refused to
    // lower, stamped by lower_expr / lower_stmt on the way back out of a failed
    // lowering. Empty while ok.
    //
    // The 133 `s.fail()` sites are spread across lower_expr's arms and a long
    // tail of helpers, and none of them knew where they were: a bailed function
    // reported only its own NAME, so a third of the fernsmith corpus (135 of 512
    // seeds, measured 2026-08-06) bailed with no groupable reason at all and the
    // only way to learn anything was to bisect each body by hand. Stamping at the
    // two dispatchers costs one field and two wrappers instead of 133 hand-written
    // tags, and lands on the innermost node because the inner frame unwinds first
    // and later frames only fill an EMPTY slot.
    fail_why: string,
    // selfrebind: the local being reassigned from a struct literal, while that
    // literal's own lowering is in flight — `o` during `o = S { …, ys: o.ys, … }`
    // — and empty everywhere else. It lets the struct-literal override path see
    // that a field value aliasing `o` is going into the box THIS slot is about
    // to hold, which is what makes the retain unnecessary (#6653).
    //
    // Set for one expression only. The ExprStructLit arm clears it before
    // lowering any field value, so a nested literal inside one (`S { inner: T {
    // ys: o.ys } }`) sees "" and keeps its retain.
    selfrebind: string,
    // moved_names: locals this function MOVES into a construction at their last
    // use (moved_locals_toplevel_of — native's computeMovedLocals). A move means
    // the constructed box takes over the local's reference, so the construction
    // needs no retain and the exit sweep must not release it. #6726: the verdict
    // was computed and printed by -rc-plan and read by nothing, so both halves
    // were emitted and cancelled — correct, and two memory round-trips per
    // construction on the hottest shape the compiler's own sources have.
    moved_names: string[],
    // moved_elided: the slots whose construction retain was ACTUALLY elided.
    // The sweep skips exactly these rather than everything in moved_names: a
    // move site whose emitter does not yet consult the verdict still emits its
    // inc, and dropping that local's dec would turn a balanced pair into a leak.
    // Recorded by the emitter that elides, so the two halves cannot drift.
    moved_elided: i32[],
    // move_sites: the "line:col" keys of the IDENT nodes the construction-move
    // analysis actually marked (move_sites_toplevel_of). moved_names says WHICH
    // local moves; only this says WHERE, and the retain may be elided at that
    // one site alone.
    move_sites: string[],
}

// moves_local_at: does the construction at THIS ident node take over `name`'s
// reference? The construction then owns it, so the retain is redundant with the
// sweep dec that cancels it (#6726).
//
// Keyed on the SITE, not just the name: a local is moved at its LAST use only,
// and every other construction consuming it still needs its retain. Answering
// by name alone elided the retain at all of them, which released the same
// buffer once per literal (#6545). An unstamped ident (0:0) declines — the
// retain stands and note_moved_elided never fires, so the pair stays balanced.
pub function (s: LowerState) moves_local_at(name: string, line: i32, col: i32): boolean {
    if (util.index_of_str(s.moved_names, name) < 0) { return false; }
    if (line == 0 && col == 0) { return false; }
    return util.index_of_str(s.move_sites, util.i32_to_string(line) + ":" + util.i32_to_string(col)) >= 0;
}

// note_moved_elided records that the retain for `slot` was actually skipped, so
// emit_dec_sweep_except_list skips its dec too. Recorded by the eliding emitter
// rather than derived from moved_names: a site that still emits its retain must
// keep its dec.
pub function (s: LowerState) note_moved_elided(slot: i32): LowerState {
    if (slot < 0 || slot_list_has(s.moved_elided, slot)) { return s; }
    return LowerState { ...s, moved_elided: s.moved_elided.append(slot) };
}

// drop_reclaim_row removes one exact credit row. Used by the move-on-alias
// struct clause: a move transfers the SOURCE's whole release role to the
// alias, so the alias's box-only "NODEEP:" marker is dropped and its exit
// drop takes the deep field walk the source would have run.
pub function (s: LowerState) drop_reclaim_row(row: string): LowerState {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        if (s.reclaimable_names[i] != row) { out = out.append(s.reclaimable_names[i]); }
        i = i + 1;
    }
    return LowerState { ...s, reclaimable_names: out };
}

// add_reclaim_row appends one credit row. The inverse of drop_reclaim_row, for a
// lowering decision that flips a pre-pass verdict rather than merely revoking it:
// "NODEEP:" and "FLDCHECKED:" are the two arms of one either/or, so replacing the
// first with the second is what turning a box-only slot back into a deep-dropping
// one takes.
pub function (s: LowerState) add_reclaim_row(row: string): LowerState {
    if (util.index_of_str(s.reclaimable_names, row) >= 0) { return s; }
    return LowerState { ...s, reclaimable_names: s.reclaimable_names.append(row) };
}

// with_selfrebind marks (or clears, with "") the local whose self-rebind literal
// is being lowered. See the field's comment on LowerState.
pub function (s: LowerState) with_selfrebind(name: string): LowerState {
    return LowerState { ...s, selfrebind: name };
}

pub function (s: LowerState) emit(op: ir.Op): LowerState {
    // Auto-maintain ctrl: a block/loop/if opens a new structured-control level;
    // an end closes one. else/br/br_if leave the level unchanged. This keeps the
    // br-depth bookkeeping correct across every emit site with no per-site code.
    var nctrl: i32 = s.ctrl;
    if (op.kind_tag == 152 || op.kind_tag == 153 || op.kind_tag == 154) { nctrl = s.ctrl + 1; }  // block, loop, if
    if (op.kind_tag == 156) { nctrl = s.ctrl - 1; }  // end
    return LowerState { ...s, ops: s.ops.append(op), ctrl: nctrl };
}

// enter_loop / exit_loop push and pop the loop_blk stack. enter_loop is called
// right after a loop's exit-block opener is emitted (so s.ctrl is the block's
// level); exit_loop after both of the loop's `end`s. cur_loop_blk returns the
// innermost loop's recorded block level, or -1 outside any loop.
pub function (s: LowerState) enter_loop(): LowerState {
    return LowerState { ...s, loop_blk: s.loop_blk.append(s.ctrl) };
}
pub function (s: LowerState) exit_loop(): LowerState {
    var trimmed: i32[] = [];
    var k: i32 = 0;
    while (k + 1 < s.loop_blk.len()) { trimmed = trimmed.append(s.loop_blk[k]); k = k + 1; }
    return LowerState { ...s, loop_blk: trimmed };
}
pub function (s: LowerState) cur_loop_blk(): i32 {
    if (s.loop_blk.len() == 0) { return 0 - 1; }
    return s.loop_blk[s.loop_blk.len() - 1];
}
// loop_blk_at_depth returns the exit-block ctrl level of the loop `n` levels out
// from the innermost (n = 0 → innermost, n = 1 → its enclosing loop, …), or -1 if
// out of range. Drives labeled break/continue: a labeled break's relative depth is
// pre-resolved into StmtBreak.tag by the parser's resolve_labels pass, so n = 0
// (unlabeled / innermost) reproduces cur_loop_blk exactly.
pub function (s: LowerState) loop_blk_at_depth(n: i32): i32 {
    var idx: i32 = s.loop_blk.len() - 1 - n;
    if (idx < 0 || idx >= s.loop_blk.len()) { return 0 - 1; }
    return s.loop_blk[idx];
}

// ret_i64arr / ret_dyn / for_wasm decode the ret_arrdyn flag word (bit 0 =
// returns i64[], bit 1 = returns a scalar `dyn Trait`, bit 2 = the wasm
// backend is lowering, so erased-generic slots are typed i64 — #5464). The
// folding predates the deleted legacy backends' 33-field LowerState pin and
// is kept as-is; new facts need no such folding.
pub function (s: LowerState) ret_i64arr(): boolean { return s.ret_arrdyn % 2 == 1; }
pub function (s: LowerState) ret_dyn(): boolean { return (s.ret_arrdyn / 2) % 2 == 1; }
pub function (s: LowerState) for_wasm(): boolean { return (s.ret_arrdyn / 4) % 2 == 1; }
// bit 3: this fn is a wasm-widenable erased pass-through (#5464), so its
// bare-typevar return lowers via the uniform-i64 path in StmtReturn.
pub function (s: LowerState) erased_passthrough(): boolean { return (s.ret_arrdyn / 8) % 2 == 1; }

pub function (s: LowerState) fail(): LowerState {
    return LowerState { ...s, ok: false };
}

// note_fail records `why` as the bail description, but only when none is set
// yet. First writer wins, and the first writer is the innermost frame: an
// unwinding lowering passes through lower_expr / lower_stmt from the failing
// node outwards, so the deepest node describes the bail and every enclosing one
// leaves it alone. Reporting the outermost instead would name the function's
// top-level statement on every bail, which is what the bare function name
// already said.
pub function (s: LowerState) note_fail(why: string): LowerState {
    if (s.fail_why.len() > 0) { return s; }
    return LowerState { ...s, fail_why: why };
}

// expr_bail_tag names an expression for the strict-IR bail diagnostic. Beyond
// the node kind it carries the one detail that distinguishes same-kind bails
// from each other — a binary/unary operator, a callee or field name, a struct
// type — because "call" alone groups every unlowerable call in the corpus into
// one indistinguishable bucket.
function expr_bail_tag(e: ast.Expr): string {
    match (e) {
        ast.ExprNumber(_) => { return "number literal"; },
        ast.ExprIdent(id) => { return "ident `" + id.name + "`"; },
        ast.ExprString(_) => { return "string literal"; },
        ast.ExprBool(_) => { return "bool literal"; },
        ast.ExprBinary(b) => { return "binary `" + b.op + "`"; },
        ast.ExprUnary(u) => { return "unary `" + u.op + "`"; },
        ast.ExprCall(c) => { return call_bail_tag(c); },
        ast.ExprArray(_) => { return "array literal"; },
        ast.ExprTuple(_) => { return "tuple literal"; },
        ast.ExprIndex(_) => { return "index"; },
        ast.ExprSlice(_) => { return "slice"; },
        ast.ExprStructLit(sl) => { return "struct literal `" + sl.type_name + "`"; },
        ast.ExprFieldAccess(fa) => { return "field access `." + fa.field + "`"; },
        ast.ExprLambda(_) => { return "lambda"; },
        ast.ExprUnknown(uk) => { return "unparsed `" + uk.kind + "`"; },
        // Printer-only nodes: the parser desugars every other parse of these
        // into the form the compile path is written against, so reaching here
        // means the desugar was skipped, not that the feature is unlowerable.
        ast.ExprMapLit(_) => { return "un-desugared map literal"; },
        ast.ExprFString(_) => { return "un-desugared f-string"; },
        // Every member of ast.Expr is named above, so this arm is reachable
        // only when the discriminant is not a valid tag at all — i.e. the node
        // has been freed and its storage reused (#7948). Keep the two cases
        // distinguishable: an unhandled variant must never read as corruption.
        _ => { return "unknown expression (corrupt node tag)"; }
    }
}

// call_bail_tag spells a call's target for expr_bail_tag: a named function, a
// `.method`, or the shape of whatever else is in callee position (a call
// through a computed function value is a different problem from an unlowerable
// builtin, and the tag has to say which).
//
// The zero-arg inline lambda gets its own wording because it is almost never
// something anyone wrote: `if` and `match` in VALUE position parse into an
// immediately-invoked zero-param lambda (parse_primary's `if` / `match` arms),
// as do the array- and map-comprehension desugars. Calling that "a lambda"
// sends the reader looking for a lambda in a source file that has none.
function call_bail_tag(c: ast.ExprCall): string {
    match (c.callee) {
        ast.ExprIdent(id) => { return "call `" + id.name + "`"; },
        ast.ExprFieldAccess(fa) => { return "call `." + fa.field + "`"; },
        ast.ExprLambda(lam) => {
            if (lam.params.len() == 0 && c.args.len() == 0) {
                if (lam.origin != parser.ORIGIN_IIFE_SCOPED) {
                    return "immediately-invoked value block (an if-/match-expression or comprehension desugar)";
                }
                return "immediately-invoked lambda written in the source, carrying a defer";
            }
            return "call of an inline lambda";
        },
        ast.ExprIndex(_) => { return "call of an indexed element"; },
        _ => { return "call of a computed value"; }
    }
}

// stmt_bail_tag is expr_bail_tag's statement half. Reached only when a bail
// happens in a statement's own lowering rather than inside one of its
// expressions — the expression frames stamp first.
//
// The value-carrying statements name their value's SHAPE as well as their own
// kind. Reaching this arm means no lower_expr frame ran, i.e. the statement's
// own type-directed path (a return coerced to i64 / dyn / Option, a var binding
// choosing a slot kind) refused the value before dispatching on it — so the
// shape it refused is the whole diagnostic. Without it, half of these bails
// report the bare word "return".
function stmt_bail_tag(st: ast.Stmt): string {
    match (st) {
        ast.StmtVar(v) => { return "`var " + v.name + "` bound from " + expr_bail_tag(v.init); },
        ast.StmtReturn(r) => { return "`return` of " + expr_bail_tag(r.value); },
        ast.StmtExpr(x) => { return "expression statement " + expr_bail_tag(x.value); },
        ast.StmtIf(_) => { return "`if`"; },
        ast.StmtWhile(_) => { return "`while`"; },
        ast.StmtAssign(a) => { return "assignment to `" + a.target + "` from " + expr_bail_tag(a.value); },
        ast.StmtMatch(_) => { return "`match`"; },
        ast.StmtFor(f) => { return "`for " + f.var_name + "`"; },
        ast.StmtBreak(_) => { return "`break`"; },
        ast.StmtContinue(_) => { return "`continue`"; },
        ast.StmtDefer(_) => { return "`defer`"; },
        _ => { return "unknown statement"; }
    }
}

// is_arr_ret_fn reports whether `name` is a function returning an array.
pub function (s: LowerState) is_arr_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.arr_ret_fns, name);
}

// is_strarr_ret_fn reports whether `name` is a function returning `string[]`.
pub function (s: LowerState) is_strarr_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.strarr_ret_fns, name);
}

// slot_of returns the local slot for `name`, or -1 if unbound.
pub function (s: LowerState) slot_of(name: string): i32 {
    // Scan from the END so a name resolves to its MOST-RECENT binding — the
    // innermost lexical scope. A nested-block `var x` shadow appends a fresh
    // slot (add_local), which a sibling/outer reference must NOT see, but the
    // block body must (and the `add_local`-then-`slot_of` pattern wants the
    // just-added slot, not an older same-named one). `lower_block` prefixes the
    // inner names with `!retired!` on exit, so after the block the outer `x` is
    // found again — the match here is exact, and no source identifier can start
    // with `!`. First-match here clobbered the outer slot on shadow (#3726).
    // Inside a replayed defer action the declaring block's local has been
    // retired, so the record retire_locals_for_scope left takes PRIORITY over the
    // scan: an outer local of the same name is still findable and is not the one
    // the action was written against (#6821).
    if (s.defer_guard.len() > 0) {
        var da: i32 = s.defer_alias_slot(name);
        if (da >= 0) { return da; }
    }
    var i: i32 = s.locals.len() - 1;
    while (i >= 0) {
        if (s.locals[i].slot_name == name) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// is_aliased_name reports whether `name` acquires a lasting local alias in this
// function (aliased_array_names_of, computed once in lower_func). Drives the
// in-place-vs-clone choice for the `a = a.with(i, v)` self-reassign (#3599).
pub function (s: LowerState) is_aliased_name(name: string): boolean {
    return util.index_of_str(s.aliased_names, name) >= 0;
}

// is_borrowed_name reports whether `name` names a buffer this function does not
// own (#6158). Consulted ONLY by the `.with` self-reassign's in-place gate.
pub function (s: LowerState) is_borrowed_name(name: string): boolean {
    return util.index_of_str(s.borrowed_names, name) >= 0;
}

// is_self_assign_reuse_name reports whether `name` is a local whose every record
// update `name = T { ...name, … }` may reuse its own box in place (#6134).
// Seeded once per function by lower_func as "SAREUSE:<name>".
pub function (s: LowerState) is_self_assign_reuse_name(name: string): boolean {
    return reclaim_has(s.reclaimable_names, "SAREUSE:", name);
}

// trmc_consume_param returns the parameter index a consume-safe TRMC callee
// frees cell-by-cell, or -1 when `name` is not one (#5333). Read by BOTH the
// loop's release and the call site's retain, so the two can never disagree
// about which functions consume.
pub function (s: LowerState) is_trmc_consume_arg(name: string, idx: i32): boolean {
    // The empty-registry early-out keeps the key concat off every call-argument
    // of every module that has no consuming TRMC function at all, which is most
    // of them.
    if (s.sigs.trmc_consume_fns.len() == 0) { return false; }
    return util.index_of_str(s.sigs.trmc_consume_fns, name + "|" + util.i32_to_string(idx)) >= 0;
}

// is_view_frame_name reports whether `name` is a local whose string-slice VIEW
// box may be taken from the frame rather than the heap (#6713) — every use of it
// borrows it and none outlives the frame. Seeded once per function by lower_func
// as "VIEWFRAME:<name>" (see view_frame_names_of for the rule).
pub function (s: LowerState) is_view_frame_name(name: string): boolean {
    return reclaim_has(s.reclaimable_names, "VIEWFRAME:", name);
}

// mark_enum_field_alias records that local `name` was bound from a DIRECT enum
// struct field read (`var tmp: N = first.node`), so the local is an UNCOUNTED
// alias of the source struct's enum box (#6121). Storing it into a container
// then needs the same Perceus dup the direct read gets, because
// __struct_drop_<T>'s k_enum arm decs that box when the source struct is
// reclaimed. Appended rather than pre-scanned: the bind always precedes the
// store, and enum_field_read_type needs the slot types the scan does not have.
pub function (s: LowerState) mark_enum_field_alias(name: string): LowerState {
    return LowerState { ...s, reclaimable_names: s.reclaimable_names.append("ENUMALIAS:" + name) };
}

// is_enum_field_alias reports whether `name` carries the mark above. Rebinding
// the name to a non-alias value does not clear it — a stale mark costs one
// retain too many, which leaks and never over-frees.
pub function (s: LowerState) is_enum_field_alias(name: string): boolean {
    return reclaim_has(s.reclaimable_names, "ENUMALIAS:", name);
}

// ident_name_or_empty is `e`'s name when it is a BARE ident, and "" otherwise.
// Three predicates here open-coded the same one-arm match to ask it.
pub function ident_name_or_empty(e: ast.Expr): string {
    match (e) {
        ast.ExprIdent(id) => { return id.name; },
        _ => { return ""; }
    }
    return "";
}

// enum_alias_ident_escapes reports whether `e` is a bare ident on a local bound
// from an enum field read — the routed-through-a-local form of the direct
// `enum_field_read_type` container store, and retained at the same three sites.
pub function enum_alias_ident_escapes(e: ast.Expr, s: LowerState): boolean {
    var nm: string = ident_name_or_empty(e);
    if (nm.len() == 0) { return false; }
    return s.is_enum_field_alias(nm);
}

// struct_alias_ident_escapes reports whether `e` is a bare ident naming a
// BORROWED STRUCT PARAMETER. That box belongs to the caller, which releases it
// itself, so a container storing it takes a second owner and the store has to
// be COUNTED — the struct sibling of enum_alias_ident_escapes above.
//
// A LOCAL is deliberately excluded: one that escapes into a container has
// already lost its reclaim credit to the escape walk, so nothing releases it
// and the container holds the only reference; retaining there leaks instead of
// balancing. An `own` parameter is excluded from the other side — the caller
// transferred its reference rather than keeping one (#7853).
pub function struct_alias_ident_escapes(e: ast.Expr, s: LowerState): boolean {
    var nm: string = ident_name_or_empty(e);
    if (nm.len() == 0 || s.is_own_param(nm)) { return false; }
    var sl: i32 = s.slot_of(nm);
    if (sl < 0 || sl >= s.n_params) { return false; }
    return decl_is_struct(s.structs, s.struct_type_of_slot(sl));
}

// strarr_param_slot_of returns the slot when `e` is a bare ident naming a
// string[] PARAMETER, else -1.
function strarr_param_slot_of(e: ast.Expr, s: LowerState): i32 {
    var nm: string = ident_name_or_empty(e);
    if (nm.len() == 0) { return 0 - 1; }
    var sl: i32 = s.slot_of(nm);
    if (sl < 0 || sl >= s.n_params || !s.is_strarr_slot(sl)) { return 0 - 1; }
    return sl;
}

// str_param_elem_escapes reports whether `e` evaluates to a string ELEMENT of
// a caller-owned string[]: a parameter indexed directly (`p[i]`), or a local
// such a read bound (LocalInfo.str_caller_elem — `var e = p[i]`, `for e in p`,
// an alias of either). The caller frees that array deep at its own exit, so a
// container storing the element takes a second owner and the store must be
// COUNTED — the string sibling of struct_alias_ident_escapes. A LOCAL array's
// element is deliberately not here: sharing one withdraws the local's deep
// free (strarr_unsafe_for), so the container holds the only release.
pub function str_param_elem_escapes(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprIndex(ix) => { return strarr_param_slot_of(ix.array, s) >= 0; },
        ast.ExprIdent(id) => { return s.is_str_caller_elem_slot(s.slot_of(id.name)); },
        _ => { return false; }
    }
    return false;
}

// is_own_param reports whether `name` is an `own` (consuming) parameter of the
// function being lowered.
pub function (s: LowerState) is_own_param(name: string): boolean {
    return util.index_of_str(s.own_params, name) >= 0;
}

// A consumed-threaded array parameter is a borrowed array param the body
// reassigns (`acc = f(acc)`, `acc = acc.append(v)`). Its slot holds the caller's
// buffer until the first rebind replaces it, and a value this frame owns after;
// which one is a runtime fact, kept in the hidden "$ownflag_<name>" local (0:
// the caller's borrow, 1: ours). An entry retain would encode the same bit in
// the refcount, but rc == 1 is the gate of __fern_arr_push's in-place path, so
// it would turn every append the buffer sees into a whole-buffer copy.
function ownflag_name(name: string): string { return "$ownflag_" + name; }

// borrowed_arr_param_slot returns the slot of a bare identifier naming a
// borrowed array parameter (or a borrowed match binding), else -1.
function borrowed_arr_param_slot(e: ast.Expr, s: LowerState): i32 {
    var nm: string = ident_name_or_empty(e);
    if (nm.len() == 0) { return 0 - 1; }
    var sl: i32 = s.slot_of(nm);
    if (sl < 0 || !s.is_arr_slot(sl)) { return 0 - 1; }
    if (sl < s.n_params) {
        if (s.is_own_param(nm)) { return 0 - 1; }
        return sl;
    }
    if (s.is_borrowed_arr_slot(sl)) { return sl; }
    return 0 - 1;
}

// rebind_call_same_dec: at `x = f(…)`, does a result that is the SAME pointer as
// x's old value carry a count of its own that the store must release? A call
// result does: a bare-parameter return retains, and an in-place append on a
// borrowed param retains on identity (lower_call_append), so the old reference
// is superseded by the counted one. The exception is a declared `own` position
// holding x — the caller moved its reference in and gets it back uncounted. A
// callee reached through a function value cannot declare `own`.
function rebind_call_same_dec(value: ast.Expr, target: string, s: LowerState): boolean {
    match (value) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (ident_name_or_empty(c.args[i]) == target
                            && util.index_of_str(s.sigs.own_positions, cid.name + "|" + util.i32_to_string(i)) >= 0) { return false; }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// ownflag_slot_of returns the ownership-flag slot of parameter slot `slot`, or
// -1 when it is not a consumed-threaded array parameter.
pub function (s: LowerState) ownflag_slot_of(slot: i32): i32 {
    if (slot < 0 || slot >= s.n_params) { return 0 - 1; }
    return s.slot_of(ownflag_name(s.locals[slot].slot_name));
}

// add_local binds `name` to a fresh slot (its index = the old slot count),
// not-an-array by default.
pub function (s: LowerState) add_local(name: string): LowerState {
    return LowerState { ...s, locals: s.locals.append(li_new(name)) };
}

// is_arr_slot / mark_arr query and set the array-ness of slot i.
pub function (s: LowerState) is_arr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_arr;
}

// retire_locals prefixes every local at index >= `from` with the unfindable
// sentinel "!retired!" (which no real identifier or "$"-temp can start with),
// removing it from name resolution while LEAVING the slot in place. Fern is
// block-scoped (a `var` in an if / match-arm body is not visible after it — the
// checker rejects it), but the IR lowerer allocates slots by name function-wide,
// so a same-named local in a SIBLING scope would otherwise collapse onto one
// slot and inherit conflicting type metadata (the scope-blind-locals bail). A
// block retires the locals it introduced on exit, so a sibling re-declares a
// fresh slot. The slot index space stays MONOTONIC (rename, never truncate), so
// the frame size (n_locals), the exit dec-sweep (which keys off the per-index
// type columns, not names), and the `$tmp + local_names.len()` unique-temp
// scheme are all unaffected. For valid (non-colliding) programs this is a no-op:
// nothing resolves a block-scoped name after its block — except a REPLAYED defer
// action, which lower_defers_func emits at every function exit and which was
// written against the name inside the block. Reach this through
// retire_locals_for_scope, which records the slots for that one reader first.
//
// The original name is KEPT after the sentinel rather than replaced (#6127).
// The reclaim credits were name-keyed then, so a flat "!retired!" made
// every block-scoped local miss its own credit at the function-exit sweep — the
// loop's re-declaration freed the PRIOR iteration's value and the final one
// leaked, n-1 of n freed per round on every class. `emit_dec_sweep_except_list`
// already noted the mechanism in passing ("loop-scoped candidates dodged it only
// because their retired slot names miss the credit lookup"), from the other side:
// there it was shielding them from a double free that has since been fixed.
pub function (s: LowerState) retire_locals(from: i32): LowerState {
    // Rename slots [from, len) one at a time via set_local_name (the `.with`
    // pattern mark_arr uses) rather than rebuilding local_names as a fresh array
    // inside the big struct literal — the legacy AST backend miscompiled the
    // latter's RC, and `.with` on an existing column is the shape every other
    // marker on this struct uses.
    var st: LowerState = s;
    var i: i32 = from;
    while (i < st.locals.len()) {
        // Prefix ONCE. Nested blocks retire the same slot repeatedly — an inner
        // `if` inside a `while` body retires it, then the while body retires it
        // again — and stacking sentinels would leave the recovered name as
        // "!retired!t" instead of "t", so a doubly-nested local would still miss
        // its credit while the credits were name-keyed. Measured: exactly half of
        // a sibling-branch corpus stayed unreclaimed until this guard. #6127.
        // The credits are site-keyed now (#7253) and no longer depend on this,
        // but `slot_name_retired` still gates the two predicates that must refuse
        // a retired slot, so the sentinel must stay exactly one deep.
        if (!slot_name_retired(st.locals[i].slot_name)) {
            st = st.set_local_name(i, "!retired!" + st.locals[i].slot_name);
        }
        i = i + 1;
    }
    return st;
}

// slot_name_retired: `n` already carries the retire sentinel.
function slot_name_retired(n: string): boolean {
    return n.len() > 9 && slice_unchecked(n, 0, 9) == "!retired!";
}

// is_defer_flag_name: `n` is one of lower_defers_func's per-defer arming flags
// (`__dfa0`, `__dfa1`, …). The two `?`-edge markers `__dfa_tryall` /
// `__dfa_tryerr` are deliberately excluded — they wrap the per-flag guards, so
// the inner `if (__dfa<i>)` is what identifies which defer is being replayed.
function is_defer_flag_name(n: string): boolean {
    if (n.len() <= 5) { return false; }
    if (slice_unchecked(n, 0, 5) != "__dfa") { return false; }
    var c: u8 = n[5];
    return c >= b'0' && c <= b'9';
}

// defer_replay_flag returns the defer flag an `if` condition guards a replay
// with, or "" when the `if` is ordinary user code.
function defer_replay_flag(cond: ast.Expr): string {
    match (cond) {
        ast.ExprIdent(id) => {
            if (is_defer_flag_name(id.name)) { return id.name; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// disarms_defer_flag: the assignment is a `__dfa<i> = 0` — the clear a loop
// body's per-iteration cleanup writes after replaying its action, not an
// arming `= 1`. It leaves nothing pending, so no block has to record slots
// for it, and counting it would let a block holding only a `break` claim a
// flag armed elsewhere.
function disarms_defer_flag(v: ast.Expr): boolean {
    match (v) {
        ast.ExprNumber(n) => { return n.text == "0"; },
        _ => { return false; }
    }
    return false;
}

// armed_defer_flags collects every defer flag `stmts` ARMS anywhere in its
// subtree, so a block closing its scope knows which replays can still name the
// locals it is about to retire. A flag is armed at exactly one `defer`
// statement, hence in exactly one block, so every block that reports a flag is
// an ancestor of that defer.
function armed_defer_flags(stmts: ast.Stmt[], acc: string[]): string[] {
    var out: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (is_defer_flag_name(a.target) && !disarms_defer_flag(a.value) && util.index_of_str(out, a.target) < 0) { out = out.append(a.target); }
            },
            ast.StmtIf(f) => {
                out = armed_defer_flags(f.then_body, out);
                out = armed_defer_flags(f.else_body, out);
            },
            ast.StmtWhile(w) => { out = armed_defer_flags(w.body, out); },
            ast.StmtFor(fr) => { out = armed_defer_flags(fr.body, out); },
            ast.StmtMatch(m) => {
                for arm in m.arms { out = armed_defer_flags(arm.body, out); }
            },
            _ => {},
        }
    }
    return out;
}

// retire_locals_for_scope records what the defers in `scope` will need, then
// retires slots [from, len). The two steps are ONE method because the recording
// is only correct immediately before the retirement: two rules keep each entry
// pointing at the binding that was in scope at the defer, and both read the
// still-unretired names.
//
//   - a slot already carrying the retire sentinel is SKIPPED, so a sibling inner
//     block's same-named local (out of scope at the defer) is not recorded;
//   - the FIRST entry for a "<flag>|<name>" key wins, so when the recording
//     blocks nest — every one of them an ancestor of the defer, innermost
//     first — the innermost declaration of the name is the one kept.
//
// A function with no defers skips the subtree walk entirely (try_cleanup is
// lower_defers_func's always-appended `?`-edge marker pair, so it is empty
// exactly when the function registered no action) and retires as before.
function (s: LowerState) retire_locals_for_scope(from: i32, scope: ast.Stmt[]): LowerState {
    if (s.try_cleanup.len() == 0) { return s.retire_locals(from); }
    var flags: string[] = armed_defer_flags(scope, []);
    if (flags.len() == 0) { return s.retire_locals(from); }
    var acc: string[] = s.defer_slots;
    var i: i32 = from;
    while (i < s.locals.len()) {
        var nm: string = s.locals[i].slot_name;
        if (!slot_name_retired(nm)) {
            var f: i32 = 0;
            while (f < flags.len()) {
                var key: string = flags[f] + "|" + nm + "|";
                if (defer_alias_find(acc, key) < 0) { acc = acc.append(key + util.i32_to_string(i)); }
                f = f + 1;
            }
        }
        i = i + 1;
    }
    return LowerState { ...s, defer_slots: acc }.retire_locals(from);
}

// defer_alias_find returns the index of the entry binding the "<flag>|<name>|"
// prefix `key`, or -1.
function defer_alias_find(entries: string[], key: string): i32 {
    var i: i32 = 0;
    while (i < entries.len()) {
        var e: string = entries[i];
        if (e.len() > key.len() && slice_unchecked(e, 0, key.len()) == key) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// with_defer_guard names the defer flag whose replay is being lowered ("" once
// the replay is left again).
function (s: LowerState) with_defer_guard(flag: string): LowerState {
    return LowerState { ...s, defer_guard: flag };
}

// defer_alias_slot resolves `name` for the replay currently being lowered, or
// -1 when this replay's block recorded no such local.
function (s: LowerState) defer_alias_slot(name: string): i32 {
    var key: string = s.defer_guard + "|" + name + "|";
    var at: i32 = defer_alias_find(s.defer_slots, key);
    if (at < 0) { return 0 - 1; }
    var e: string = s.defer_slots[at];
    return util.digits_to_i32(slice_unchecked(e, key.len(), e.len()) + "");
}

// RECLAIM CREDITS ARE KEYED ON THE BINDING SITE, NOT THE NAME (#7253).
//
// There used to be a `reclaim_slot_name` here: a slot's source name with any
// "!retired!" prefix stripped, so a credit collected from the AST could be
// looked up per slot. Every family now resolves `reclaim_site_key` instead
// (`slot_credit_at`), the key being "name@line:col" recorded on the slot by
// whichever path bound it, so it survives retire_locals' rename by itself and
// two same-named bindings never share a verdict. The function is gone because
// nothing reads it.
//
// Why the name key had to go, since the answer is not tidiness. It handed a
// credited local's verdict to any same-named sibling — and, because a lookup
// only compares spellings, to any BINDER that shared the spelling without being
// a declaration at all (a for-in element, a match payload, a destructure key).
// The severity of that is not a property of the class: it depends on whether the
// aliased source has another owner. Where the class also LEAKS, the stray
// release lands on a box nothing else claimed, no counter dissents, and the
// census reads better than the correct program's — so the class looks benign
// and becomes a double free the moment someone fixes the leak. Where the source
// is released elsewhere it faults immediately. Both halves were measured across
// the struct (#7349) and Option (#7356) families.
//
// What that history is worth keeping. Each class was admitted to the sweep on
// its own probe rather than by a blanket flip, because switching one on turns on
// an exit-sweep release that had never run for those slots; the byte counts each
// flip closed were ARRARR / ARRARRS 7200, OPTAARR 12000, TUPRC / TUPRCS 8000,
// SARR 4800, STRUCTARR(A) 9600. "TUPRC:" needed BOTH its credits switched —
// "TUPRC:" drives the rebind and "TUPRCS:" (#6251) the exit sweep — and flipping
// only the first left the shape at exactly its unfixed 8000.
//
// Three disjointness rules outlived the migration and are enforced at the
// predicates rather than here:
//
//   - "OPTARR:"'s consuming-match analysis is per-block (#4357) and frees the
//     value before the block ends, so a sweep claim on that half would be a
//     second release. The no-match half is what carries the sweep credit.
//   - "RCENUM:" is the same story one type over: the match-consumed half must
//     not be swept, so #6606 credited the no-match half separately as
//     "RCENUMS:" instead of widening "RCENUM:". The two are appended against ONE
//     entry, so they cannot end up keyed differently; the exact-vs-retired
//     distinction between them is written out in slot_is_reclaimable_rcenum.
//   - "SCENUMS:" is held disjoint from the dyn credit at the predicate, because
//     `var d: dyn Show = Add(41)` satisfies both classifiers and letting both
//     claim it was an over-release rather than a leak.
//
// One warning survives in full. The bare-name struct credit
// (slot_is_reclaimable_struct) feeds the deep field drop, the precise drop and
// the reuse-donor paths, not just the exit sweep, and granting it for
// block-scoped slots SEGFAULTS the gen1 self-compile — a failure
// `internal/e2eselfhost` cannot reach and the per-module fixpoint can. That is
// why its retirement refusal is spelled out explicitly rather than inherited
// from a lookup that happened to miss.

// mark_reclaim_site / reclaim_site_key record and read slot i's binding-SITE key
// (#7272). Empty for a slot no `var` bound, which is why every tuple predicate
// below treats "" as "no credit" rather than falling back to the name: the tuple
// class credits are only ever produced from a StmtVar, so a slot without a site
// key never had one to lose.
pub function (s: LowerState) mark_reclaim_site(i: i32, k: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_reclaim_site(s.locals[i], k)) };
}

pub function (s: LowerState) reclaim_site_key(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].reclaim_site;
}

// slot_of_site is slot_of's site-keyed twin: the slot the binding SITE key names,
// or -1. slot_of answers with the innermost binding of a SPELLING, so a shadow
// redirects it; a site key belongs to exactly one binding, so this cannot be
// redirected and it survives retire_locals' block-exit rename. Scans backward for
// the same reason slot_of does — a loop body re-entering its own declaration
// rebinds the name to a fresh slot, and the latest one is the live binding.
pub function (s: LowerState) slot_of_site(key: string): i32 {
    if (key.len() == 0) { return 0 - 1; }
    var i: i32 = s.locals.len() - 1;
    while (i >= 0) {
        if (s.locals[i].reclaim_site == key) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// set_local_name rewrites slot i's NAME (used by retire_locals). Mirrors mark_arr
// exactly — a single `.with` on local_names, every other field carried through.
pub function (s: LowerState) set_local_name(i: i32, name: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_names(s.locals[i], name)) };
}

pub function (s: LowerState) mark_arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_arr(s.locals[i], v)) };
}

// is_borrowed_arr_slot / mark_borrowed_arr query and set the borrowed-buffer flag
// of slot i (LocalInfo.borrowed_arr) — the exit dec-sweep's opt-out for an array
// binding that only borrows a live owner's buffer.
pub function (s: LowerState) is_borrowed_arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].borrowed_arr;
}

pub function (s: LowerState) mark_borrowed_arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_borrowed_arr(s.locals[i], v)) };
}

// is_moved_claim_slot / mark_moved_claim query and set LocalInfo.moved_claim —
// whether a borrowed_arr binding was handed the box's own counted reference by
// the consuming match's moved-payload skip.
pub function (s: LowerState) is_moved_claim_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].moved_claim;
}

pub function (s: LowerState) mark_moved_claim(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_moved_claim(s.locals[i], v)) };
}

// is_u32_slot / mark_u32 query and set the u32-ness of slot i (a u32 scalar or
// u32[] array). Drives u32 wrapping (32-bit mask after arithmetic; logical `>>`).
pub function (s: LowerState) is_u32_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_u32;
}
pub function (s: LowerState) mark_u32(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_u32(s.locals[i], v)) };
}
// is_u64_slot / mark_u64 query and set the u64-ness of slot i — drives UNSIGNED
// compare / shift-right / div-rem in the i64 domain (#2904).
pub function (s: LowerState) is_u64_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_u64;
}
pub function (s: LowerState) mark_u64(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_u64(s.locals[i], v)) };
}
// subword_kind_of_slot returns slot i's sub-word int kind ("u8")
// or "". mark_subword sets it. For an array slot the kind is the ELEMENT
// kind (so `a[i]` on a u8[] reads a u8); local_is_arr disambiguates.
pub function (s: LowerState) subword_kind_of_slot(i: i32): string {
    if (i < 0) { return ""; }
    if (i >= s.locals.len()) { return ""; }
    return s.locals[i].subword;
}
pub function (s: LowerState) mark_subword(i: i32, k: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_subword(s.locals[i], k)) };
}

// is_const_fn reports whether `name` is a zero-arg, receiver-less module
// function (a `const`) — so a bare reference to it lowers to a call (#2954).
pub function (s: LowerState) is_const_fn(name: string): boolean {
    return util.index_of_str(s.sigs.const_fns, name) >= 0;
}

// is_closure_local / mark_closure_local query and set whether a named local
// holds a closure BOX (i32[] [funcval, caps…]) — so a call `f(args)` through it
// uses the env-passing closure-call form (closures slice 3a).
pub function (s: LowerState) is_closure_local(name: string): boolean {
    return util.index_of_str(s.closure_locals, name) >= 0;
}
// closure_opt_ret returns the Option/Result return type recorded for the
// closure / fn-typed value in slot `i` (from ParamDecl.fn_ret), or "". Drives
// Option-type recovery for a DIRECT closure-call match scrutinee in try_opt_type.
pub function (s: LowerState) closure_opt_ret(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].fn_opt_ret;
}

// split_type_list splits a comma-separated list of type spellings at DEPTH-ZERO
// commas only, so a tuple or generic argument list keeps its own — `(i32,i32),T`
// is two types, not three. split_commas next door is the flat version and would
// count a tuple parameter twice, which for a funcref signature means emitting
// one type char too many and dispatching through a type of the wrong arity.
function split_type_list(csv: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i <= csv.len()) {
        if (i == csv.len() || (csv[i] == b',' && depth == 0)) {
            out = out.append(slice_unchecked(csv, start, i));
            start = i + 1;
        } else if (csv[i] == b'(' || csv[i] == b'[') {
            depth = depth + 1;
        } else if (csv[i] == b')' || csv[i] == b']') {
            depth = depth - 1;
        }
        i = i + 1;
    }
    return out;
}

// wasm_width_char maps a type SPELLING to the wasm value type a value of that
// type occupies: 'l' for the 8-byte integers, 'd' for the floats, 'w' for
// everything else — every pointer-shaped type (string, array, struct, enum,
// tuple, Option, fn) is an i32 on wasm32. "" when the spelling is a bare type
// VARIABLE of the enclosing function, which has no width until it is
// instantiated; a type var NESTED in a container (`T[]`, `Option[T]`) is still a
// pointer and so still 'w'.
//
// f32 is 'd': the wasm backend carries every float in an f64, so an f32 param
// is emitted `(param f64)`. A funcref type naming it f32 would not match the
// function it dispatches to.
pub function wasm_width_char(ty: string, tps: string[]): string {
    if (ty.len() == 0) { return ""; }
    if (util.index_of_str(tps, ty) >= 0) { return ""; }
    if (ty == "i64" || ty == "u64") { return "l"; }
    if (ty == "f64" || ty == "f32") { return "d"; }
    return "w";
}

// fn_sig_of builds the funcref signature tag for a fn-typed param: one width
// char per declared parameter, then "_", then the result char — `(i64) =>
// boolean` is "l_w", `(i32) => i64` is "w_l". "" when ANY position is a bare
// type variable, because an erased generic's width is not known until the
// instantiation, and "" for an all-i32 signature, which is what the arity-keyed
// `$fn<N>` type already describes. Both cases fall back to today's emission, so
// only the shapes that were actually wrong move.
pub function fn_sig_of(p: ast.ParamDecl, tps: string[]): string {
    var rc: string = wasm_width_char(p.fn_ret, tps);
    if (rc.len() == 0) { return ""; }
    var params: string = "";
    var wide: boolean = rc != "w";
    if (p.fn_param_types.len() > 0) {
        var parts: string[] = split_type_list(p.fn_param_types);
        var i: i32 = 0;
        while (i < parts.len()) {
            var pc: string = wasm_width_char(parts[i], tps);
            if (pc.len() == 0) { return ""; }
            if (pc != "w") { wide = true; }
            params = params + pc;
            i = i + 1;
        }
    }
    if (!wide) { return ""; }
    return params + "_" + rc;
}

// callee_fn_sig is the funcref signature tag for a call through a fn VALUE that
// no local slot describes — a struct field, a tuple or array element, or
// another call's result. `fn_value_sig` answers for a fn-typed local or param
// by reading the sidecars lower_func seeded onto its slot; these callees have
// no slot, so the RESULT comes from the checker's stamp on the call itself
// (#5986: the annotate pass already resolved this type, and re-deriving it is
// what the carriers exist to stop).
//
// Only a ZERO-ARGUMENT call is tagged. The tag must name the funcref's whole
// signature, and the parameter spellings of these callees are recorded nowhere
// — a StructFieldDecl carries no param list, and an array's element spelling
// does not survive the coarse `fn[]` tag. With no arguments the parameter list
// is empty by construction rather than by re-derivation, so the tag is exact.
// Every other call keeps the arity-keyed `$fn<N>` form it has today, as does an
// unannotated build (`asm_ir_run`, the native compiler) where the stamp is ""
// — which is what keeps this byte-identity-safe.
//
// An all-i32 signature declines for the same reason fn_sig_of declines one:
// `$fn<N>` already describes it.
// callee_fn_sig_declared prefers a signature the DECLARATION recorded, which is
// exact at any arity, and falls back to the stamp-derived zero-argument tag.
// `with_env` prepends the 'w' for the env box a closure dispatch passes as the
// hidden first argument, exactly as fn_value_sig does.
function callee_fn_sig_declared(declared: string, c: ast.ExprCall, with_env: boolean): string {
    if (declared.len() > 0) {
        if (with_env) { return "w" + declared; }
        return declared;
    }
    return callee_fn_sig(c, with_env);
}

function callee_fn_sig(c: ast.ExprCall, with_env: boolean): string {
    if (c.args.len() != 0) { return ""; }
    var rc: string = wasm_width_char(c.ty, []);
    if (rc.len() == 0 || rc == "w") { return ""; }
    if (with_env) { return "w_" + rc; }
    return "_" + rc;
}

// fn_params_sidecars joins a fn value's parameter type list into the
// comma-separated `fn_param_types` spelling plus the `fn_param_dyn` position
// list, or an EMPTY array when a position is unannotated.
function fn_params_sidecars(tys: string[]): string[] {
    var ptys: string = "";
    var dyns: string = "";
    var i: i32 = 0;
    while (i < tys.len()) {
        if (tys[i].len() == 0) { return []; }
        if (i > 0) { ptys = ptys + ","; }
        ptys = ptys + tys[i];
        if (tys[i].len() > 4 && slice_unchecked(tys[i], 0, 4) == "dyn ") {
            if (dyns.len() > 0) { dyns = dyns + ","; }
            dyns = dyns + util.i32_to_string(i);
        }
        i = i + 1;
    }
    return [ptys, dyns];
}

// fn_param_decl builds the fn-typed ParamDecl `name` from an already-split
// signature, or declines (type_name "") when a position or the return is
// unannotated. The one place the sidecars parse_param records for a fn-typed
// PARAM are reconstructed, so the three recovery routes below cannot drift.
function fn_param_decl(name: string, tys: string[], ret: string): ast.ParamDecl {
    var declined: ast.ParamDecl = ast.ParamDecl { name: name, type_name: "", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" };
    if (ret.len() == 0) { return declined; }
    var sc: string[] = fn_params_sidecars(tys);
    if (sc.len() == 0) { return declined; }
    return ast.ParamDecl { name: name, type_name: "fn", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: ret, fn_param_dyn: sc[1], fn_param_types: sc[0] };
}

// fn_param_from_lambda recovers a fn value's signature from the lambda LITERAL
// it was bound from: the lambda carries its own annotated params, and the parser
// stamps a binding's annotated return onto it (stamp_lambda_ret).
pub function fn_param_from_lambda(name: string, lam: ast.ExprLambda): ast.ParamDecl {
    var tys: string[] = [];
    var i: i32 = 0;
    while (i < lam.params.len()) { tys = tys.append(lam.params[i].type_name); i = i + 1; }
    return fn_param_decl(name, tys, lam.ret_type);
}

// fn_param_from_func recovers a fn value's signature from the FuncDecl it
// targets, skipping `skip` leading params — 1 for a hoisted closure body, whose
// first param is the env box.
pub function fn_param_from_func(name: string, f: parser.FuncDecl, skip: i32): ast.ParamDecl {
    var tys: string[] = [];
    var i: i32 = skip;
    while (i < f.params.len()) { tys = tys.append(f.params[i].type_name); i = i + 1; }
    return fn_param_decl(name, tys, f.ret_type);
}

// fn_spelling_of renders a fn-typed ParamDecl's signature as the source
// spelling `(P0,P1) => R` — the inverse of fn_param_from_spelling, and the form
// a fn-typed LOCAL carries in its `type_name` (the flat "fn" tag is a PARAM
// spelling only, with the signature held in the sidecars).
pub function fn_spelling_of(p: ast.ParamDecl): string {
    return "(" + p.fn_param_types + ") => " + p.fn_ret;
}

// fn_local_spelling_for names the `(P) => R` type of a fn-valued local whose
// initialiser the lift has replaced with a `__mkclo$<target>` env-box
// constructor. The box carries no signature, so an UNANNOTATED binding — which
// is what a nested `function lf(x: i64): boolean { … }` declaration desugars to
// — would otherwise lose it, and lower_func's FNSIG seeding has nothing to read
// (#6862). "" when the binding is not that shape or already spells its type out.
//
// The hoisted target's params are `__env` followed by the lambda's own, so its
// signature after that first param is the fn value's.
function fn_local_spelling_for(v: ast.StmtVar, funcs: parser.FuncDecl[]): string {
    if (fn_param_from_spelling("", v.type_name).type_name == "fn") { return ""; }
    match (v.init) {
        ast.ExprCall(mk) => {
            match (mk.callee) {
                ast.ExprIdent(mkid) => {
                    if (mkid.name.len() <= 8 || slice_unchecked(mkid.name, 0, 8) != "__mkclo$") { return ""; }
                    var tgt: string = slice_unchecked(mkid.name, 8, mkid.name.len()) + "";
                    for fn in funcs {
                        if (fn.name == tgt) {
                            var p: ast.ParamDecl = fn_param_from_func(v.name, fn, 1);
                            if (p.type_name != "fn") { return ""; }
                            return fn_spelling_of(p);
                        }
                    }
                    return "";
                },
                _ => { return ""; }
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// stamp_fn_local_types writes that spelling onto every such binding across the
// lifted module.
//
// It runs AFTER the whole lift, and that ordering is the point rather than a
// detail: cap_type answers "what type is this capture" from exactly this field,
// and several lift consumers test its answer against the flat "fn" tag
// (try_lift_binding's injected param, iife_arms_hold_fn_value). Stamping while
// the lift is still running turns those tests false and a captured closure stops
// being dispatched env-first — a raw box pointer used as a table index.
function stamp_fn_local_types(funcs: parser.FuncDecl[]): parser.FuncDecl[] {
    var out: parser.FuncDecl[] = [];
    for fn in funcs {
        out = out.append(parser.FuncDecl { ...fn, body: stamp_fn_local_types_stmts(fn.body, funcs) });
    }
    return out;
}

function stamp_fn_local_types_stmts(body: ast.Stmt[], funcs: parser.FuncDecl[]): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                var sp: string = fn_local_spelling_for(v, funcs);
                if (sp.len() > 0) { out = out.append(ast.StmtVar { ...v, type_name: sp }); }
                else { out = out.append(body[i]); }
            },
            ast.StmtIf(f) => { out = out.append(ast.StmtIf { ...f, then_body: stamp_fn_local_types_stmts(f.then_body, funcs), else_body: stamp_fn_local_types_stmts(f.else_body, funcs) }); },
            ast.StmtWhile(w) => { out = out.append(ast.StmtWhile { ...w, body: stamp_fn_local_types_stmts(w.body, funcs) }); },
            ast.StmtFor(fr) => { out = out.append(ast.StmtFor { ...fr, body: stamp_fn_local_types_stmts(fr.body, funcs) }); },
            ast.StmtMatch(m) => {
                var na: ast.MatchArm[] = [];
                for arm in m.arms { na = na.append(ast.MatchArm { ...arm, body: stamp_fn_local_types_stmts(arm.body, funcs) }); }
                out = out.append(ast.StmtMatch { ...m, arms: na });
            },
            _ => { out = out.append(body[i]); }
        }
        i = i + 1;
    }
    return out;
}

// fn_param_from_spelling rebuilds the fn-signature sidecars parse_param records
// for a fn-typed PARAM (fn_param_types / fn_ret / fn_param_dyn) out of a
// `(P0,P1) => R` type spelling, so a fn-typed LOCAL seeds the same funcref facts
// a param does. Returns a ParamDecl whose type_name is "" when `sp` is not a fn
// spelling — a multi-element tuple `(A, B)` has no top-level `=>` and so
// declines here.
pub function fn_param_from_spelling(name: string, sp: string): ast.ParamDecl {
    var declined: ast.ParamDecl = ast.ParamDecl { name: name, type_name: "", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" };
    var n: i32 = sp.len();
    if (n < 5) { return declined; }
    if (sp[0] != b'(') { return declined; }
    var depth: i32 = 0;
    var close: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < n && close < 0) {
        var ch: u8 = sp[i];
        if (ch == b'(' || ch == b'[') { depth = depth + 1; }
        else if (ch == b')' || ch == b']') {
            depth = depth - 1;
            if (depth == 0 && ch == b')') { close = i; }
        }
        i = i + 1;
    }
    if (close < 0) { return declined; }
    var j: i32 = close + 1;
    while (j < n && sp[j] == b' ') { j = j + 1; }
    if (j + 1 >= n) { return declined; }
    if (sp[j] != b'=' || sp[j + 1] != b'>') { return declined; }
    // Re-split the parameter list without the source's spaces: fn_sig_of splits
    // it on bare commas and matches each part against a type spelling, so a
    // leading space would read `(i64, i32)`'s second position as a pointer.
    var tys: string[] = [];
    var inner: string = trim_spaces(slice_unchecked(sp, 1, close));
    if (inner.len() > 0) {
        var parts: string[] = split_type_list(inner);
        var k: i32 = 0;
        while (k < parts.len()) { tys = tys.append(trim_spaces(parts[k])); k = k + 1; }
    }
    return fn_param_decl(name, tys, trim_spaces(slice_unchecked(sp, j + 2, n)));
}

// bytes_at: `e` carries the bytes of `s` starting at index `at`.
function bytes_at(e: string, at: i32, s: string): boolean {
    var n: i32 = s.len();
    if (at + n > e.len()) { return false; }
    var k: i32 = 0;
    while (k < n) {
        if (e[at + k] != s[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// tagged_value_start: for a registry entry `e` shaped "<pfx><name>|<value>",
// the index at which <value> begins; -1 for any other entry. An entry whose
// value is EMPTY still matches, at `e.len()` — the sig registries record a name
// with no payload, and callers that read an empty value as "absent" test for it.
//
// Byte compares only. These scans run inside the per-function emit, whose bump
// arena never frees, so slicing a candidate to compare it allocated once or
// twice for every entry of every probe — and the probes run per local slot or
// per call argument, over registries that are module-wide.
function tagged_value_start(e: string, pfx: string, name: string): i32 {
    var pl: i32 = pfx.len();
    var nl: i32 = name.len();
    if (e.len() < pl + nl + 1) { return 0 - 1; }
    // Prefix first: it discriminates on the first byte for most of the list,
    // where the bar test reads a far offset the entry usually does not reach.
    if (!bytes_at(e, 0, pfx)) { return 0 - 1; }
    if (e[pl + nl] != b'|') { return 0 - 1; }
    var k: i32 = 0;
    while (k < nl) {
        // A '|' inside `name` would put the entry's first bar before the one
        // tested above, which is a miss — as it was for the decoders that
        // located the bar by scanning.
        if (name[k] == b'|') { return 0 - 1; }
        if (e[pl + k] != name[k]) { return 0 - 1; }
        k = k + 1;
    }
    return pl + nl + 1;
}

// tagged_value_of: the <value> of the first "<pfx><name>|<value>" entry in
// `names` that carries a non-empty one. Every reclaim caller reads "" as "not
// registered", which is what an empty value would mean too, so the scan passes
// those by rather than stopping on them.
function tagged_value_of(names: string[], pfx: string, name: string): string {
    var i: i32 = 0;
    while (i < names.len()) {
        var e: string = names[i];
        var st: i32 = tagged_value_start(e, pfx, name);
        if (st >= 0 && st < e.len()) { return slice_unchecked(e, st, e.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// reclaim_has: the registry holds the exact entry "<pfx><name>". Byte compares
// against each candidate, where `index_of_str(names, pfx + name)` had to build
// the key string first — one allocation per probe, and the sweep runs a dozen
// of these probes per local slot.
function reclaim_has(names: string[], pfx: string, name: string): boolean {
    var want: i32 = pfx.len() + name.len();
    var i: i32 = 0;
    while (i < names.len()) {
        var e: string = names[i];
        if (e.len() == want && bytes_at(e, 0, pfx) && bytes_at(e, pfx.len(), name)) { return true; }
        i = i + 1;
    }
    return false;
}

// sig_bucket_count is the bucket count for an `n`-row registry: a prime above
// n, so a registry averages about one row per bucket and unrelated hash
// strides do not alias onto one bucket.
function sig_bucket_count(n: i32): i32 {
    if (n == 0) { return 1; }
    if (n <= 8) { return 13; }
    if (n <= 40) { return 61; }
    if (n <= 160) { return 251; }
    if (n <= 640) { return 1021; }
    if (n <= 2560) { return 4093; }
    return 16381;
}

// sig_key_bucket hashes the KEY of `a` followed by `b` — their concatenation
// truncated at the first '|', which is the registries' key/value separator.
// The two pieces fold in order so a probe for "<pfx><name>" never builds the
// joined string. Folded by the modulus at every step, so the accumulator stays
// small and the hash needs no wrapping arithmetic.
function sig_key_bucket(a: string, b: string, nb: i32): i32 {
    var h: i32 = 0;
    var i: i32 = 0;
    while (i < a.len()) {
        if (a[i] == b'|') { return h; }
        h = ((h * 131) + (a[i] as i32)) % nb;
        i = i + 1;
    }
    var j: i32 = 0;
    while (j < b.len()) {
        if (b[j] == b'|') { return h; }
        h = ((h * 131) + (b[j] as i32)) % nb;
        j = j + 1;
    }
    return h;
}

// sig_reg_of indexes `rows`. The chain is built by walking BACKWARD and pushing
// each row onto the front of its bucket, which leaves every chain in ascending
// row order without needing a per-bucket tail.
pub function sig_reg_of(rows: string[]): SigReg {
    var nb: i32 = sig_bucket_count(rows.len());
    var head: i32[] = [];
    var b: i32 = 0;
    while (b < nb) { head = head.append(0 - 1); b = b + 1; }
    var next: i32[] = [];
    var j: i32 = 0;
    while (j < rows.len()) { next = next.append(0 - 1); j = j + 1; }
    var k: i32 = rows.len() - 1;
    while (k >= 0) {
        var bk: i32 = sig_key_bucket(rows[k], "", nb);
        next = next.with(k, head[bk]);
        head = head.with(bk, k);
        k = k - 1;
    }
    return SigReg { rows: rows, head: head, next: next };
}

pub function sig_reg_empty(): SigReg {
    var no_rows: string[] = [];
    return sig_reg_of(no_rows);
}

// sig_reg_append adds one row, chaining it at the END of its bucket so the
// chain stays in ascending row order. The bucket count does not grow with it:
// the callers add a handful of rows to a registry already sized for its
// module-wide body.
pub function sig_reg_append(r: SigReg, row: string): SigReg {
    var rows: string[] = r.rows.append(row);
    var head: i32[] = r.head;
    var next: i32[] = r.next.append(0 - 1);
    var k: i32 = rows.len() - 1;
    var bk: i32 = sig_key_bucket(row, "", head.len());
    if (head[bk] < 0) {
        head = head.with(bk, k);
    } else {
        var t: i32 = head[bk];
        while (next[t] >= 0) { t = next[t]; }
        next = next.with(t, k);
    }
    return SigReg { rows: rows, head: head, next: next };
}

// sig_reg_value_of: the <value> of the first "<name>|<value>" row in a sig
// registry, or "" when the name is absent. A row with an empty value ENDS the
// walk rather than being passed over — a registry records one row per function,
// so a matching name is the answer whether or not it carries a payload.
pub function sig_reg_value_of(r: SigReg, name: string): string {
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        var st: i32 = tagged_value_start(e, "", name);
        if (st >= 0) { return slice_unchecked(e, st, e.len()) + ""; }
        i = r.next[i];
    }
    return "";
}

// sig_reg_value_last is sig_reg_value_of resolved to the LAST matching row.
pub function sig_reg_value_last(r: SigReg, name: string): string {
    var out: string = "";
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        var st: i32 = tagged_value_start(e, "", name);
        if (st >= 0) { out = slice_unchecked(e, st, e.len()) + ""; }
        i = r.next[i];
    }
    return out;
}

// sig_reg_has_name: a "<name>|<value>" row for `name` is present. The
// registries this asks about are keyed by the text before the first '|', so a
// row tagged with its own prefix ("RCE:" / "AAC:" / "ERRFRESH:") has a head no
// bare callee name can equal, and answers no by construction.
pub function sig_reg_has_name(r: SigReg, name: string): boolean {
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        if (tagged_value_start(r.rows[i], "", name) >= 0) { return true; }
        i = r.next[i];
    }
    return false;
}

// sig_reg_has_exact: the registry holds `name` as a whole row. The bucket key
// stops at the first '|' on both sides, so a "<name>|<value>" row shares the
// bucket of the bare name and the exact compare here still rejects it.
pub function sig_reg_has_exact(r: SigReg, name: string): boolean {
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        if (r.rows[i] == name) { return true; }
        i = r.next[i];
    }
    return false;
}

// sig_reg_tagged_value_of: the <value> of the first "<pfx><name>|<value>" row
// that carries a non-empty one. A row whose value is empty means the same as
// an absent one to every caller, so the walk passes it by rather than stopping.
pub function sig_reg_tagged_value_of(r: SigReg, pfx: string, name: string): string {
    var i: i32 = r.head[sig_key_bucket(pfx, name, r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        var st: i32 = tagged_value_start(e, pfx, name);
        if (st >= 0 && st < e.len()) { return slice_unchecked(e, st, e.len()) + ""; }
        i = r.next[i];
    }
    return "";
}

// sig_reg_has_row: the registry holds the exact row "<pfx><name>", compared
// byte-wise so the key is never built.
pub function sig_reg_has_row(r: SigReg, pfx: string, name: string): boolean {
    var want: i32 = pfx.len() + name.len();
    var i: i32 = r.head[sig_key_bucket(pfx, name, r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        if (e.len() == want && bytes_at(e, 0, pfx) && bytes_at(e, pfx.len(), name)) { return true; }
        i = r.next[i];
    }
    return false;
}

// sig_reg_argref: the argument index an erased-generic fn's return mirrors —
// the row "<name>|$arg<i>" — or -1. The caller re-types the call by the ACTUAL
// argument at that position.
pub function sig_reg_argref(r: SigReg, name: string): i32 {
    var nl: i32 = name.len();
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        if (e.len() > nl + 5 && bytes_at(e, 0, name) && bytes_at(e, nl, "|$arg")) {
            return util.digits_to_i32(slice_unchecked(e, nl + 5, e.len()));
        }
        i = r.next[i];
    }
    return 0 - 1;
}

// opt_err_fresh_producer: the registry carries `name` under its ERR-side tag —
// every Err payload the producer returns is a fresh string.
function opt_err_fresh_producer(r: SigReg, name: string): boolean {
    return sig_reg_has_row(r, "ERRFRESH:", name);
}

// sig_reg_flag_at: the flag character recorded for parameter `idx` of `name` in
// a "<name>|<flags>" registry — one character per parameter position — or 0
// when the name is absent, or records no flag that far out.
pub function sig_reg_flag_at(r: SigReg, name: string, idx: i32): i32 {
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        var st: i32 = tagged_value_start(e, "", name);
        if (st >= 0) {
            var pos: i32 = st + idx;
            if (pos < e.len()) { return e[pos] as i32; }
            return 0;
        }
        i = r.next[i];
    }
    return 0;
}

// sig_reg_opt_payload_fresh: `name`'s row in the opt-fresh registry also
// carries the "f" flag — every success payload is a static literal or a fresh
// string producer, which is what licenses freeing a string payload rather than
// only the box.
function sig_reg_opt_payload_fresh(r: SigReg, name: string): boolean {
    var i: i32 = r.head[sig_key_bucket(name, "", r.head.len())];
    while (i >= 0) {
        var e: string = r.rows[i];
        if (tagged_value_start(e, "", name) >= 0 && optfresh_entry_payload_is_fresh(e)) { return true; }
        i = r.next[i];
    }
    return false;
}

// fn_value_sig returns the funcref signature tag seeded for the fn-value named
// `name` ("l_w", "w_l", …), or "" when the value has no usable declared
// signature — an erased generic, an all-i32 one, or a fn value that did not come
// in as a parameter. `with_env` prepends the 'w' for the env box that a closure
// dispatch passes as the hidden first argument, so the tag always describes the
// signature the funcref ACTUALLY has, which is what wasm validates against.
pub function (s: LowerState) fn_value_sig(i: i32, with_env: boolean): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    var tag: string = s.locals[i].fn_sig;
    if (tag.len() == 0) { return ""; }
    if (with_env) { return "w" + tag; }
    return tag;
}

// fn_value_ret returns the DECLARED return-type spelling of the fn-value named
// `name`, or "" when it has none recorded. The width half of the same seed
// fn_value_sig reads: lower_i64 needs it to tell an indirect call that genuinely
// yields an i64 from one whose i32 result it must sign-extend.
pub function (s: LowerState) fn_value_ret(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].fn_ret;
}

// fn_arg_width_char returns the wasm_width_char of parameter `ai` of the
// fn-value named `name` ('l' / 'd' / 'f'), or "" when the value has no seeded
// signature or the position is i32-shaped. An indirect call reads it to lower
// each argument at the width the funcref DECLARES: the funcref type the call
// dispatches through comes from the same tag, so pushing an i32 literal at an
// i64 position is a module wasm will not even load.
pub function (s: LowerState) fn_arg_width_char(i: i32, ai: i32): string {
    return sig_arg_width_char(s.fn_value_sig(i, false), ai);
}

// sig_arg_width_char reads argument `ai`'s width char out of a funcref signature
// TAG (the un-prefixed form: parameters, "_", result). "" when the position is
// past the parameter list or is plain i32-shaped, which both mean "lower it the
// ordinary way". The slot-keyed and declaration-keyed callers share this so a
// call cannot lower its arguments at one width and name another in its funcref
// type — the two halves the wasm validator compares.
pub function sig_arg_width_char(tag: string, ai: i32): string {
    if (ai < 0) { return ""; }
    var us: i32 = 0;
    while (us < tag.len() && tag[us] != b'_') { us = us + 1; }
    if (ai >= us) { return ""; }
    var c: string = slice_unchecked(tag, ai, ai + 1) + "";
    if (c == "w") { return ""; }
    return c;
}

// fn_arg_is_dyn reports whether argument index `ai` of an indirect call through
// the fn-value named `name` targets a `dyn Trait` parameter — so the arg must be
// lowered via lower_dyn_arg (dyn-boxed), not plain lower_expr. Reads the
// "<name>|<comma-separated positions>" fn_dyn seed lower_func plants for each
// fn-typed param carrying dyn positions (parser's fn_param_dyn). #5276.
pub function (s: LowerState) fn_arg_is_dyn(i: i32, ai: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    var e: string = s.locals[i].fn_dyn;
    if (e.len() == 0) { return false; }
    // A comma-separated list of dyn positions ("0" / "0,2"). Parse each number
    // numerically and test membership of `ai`.
    var cur: i32 = 0;
    var started: boolean = false;
    var pj: i32 = 0;
    while (pj < e.len()) {
        var ch: u8 = e[pj];
        if (ch == b',') {
            if (started && cur == ai) { return true; }
            cur = 0;
            started = false;
        } else if (ch >= b'0' && ch <= b'9') {
            cur = cur * 10 + ((ch - b'0') as i32);
            started = true;
        }
        pj = pj + 1;
    }
    return started && cur == ai;
}
pub function (s: LowerState) mark_closure_local(name: string): LowerState {
    return LowerState { ...s, closure_locals: s.closure_locals.append(name) };
}

// mark_closure_opt_ret records an Option/Result return type on a closure LOCAL's
// slot, the sibling of the fn-typed PARAM seeding (ParamDecl.fn_ret). Without it
// `var f: () => Option[i32] = <lambda>; match (f()) { … }` had no way to name its
// scrutinee type and bailed the enclosing function — while the same shape through
// a param, or through a NAMED function (which opt_ret_type resolves), lowered fine.
pub function (s: LowerState) mark_closure_opt_ret(i: i32, ty: string): LowerState {
    if (i < 0 || i >= s.locals.len()) { return s; }
    return LowerState { ...s, locals: s.locals.with(i, li_set_fn_opt_ret(s.locals[i], ty)) };
}

// mark_fn_value_sidecars stamps a slot's fn-VALUE facts in one call. One setter
// rather than three because fn_sig and fn_ret are seeded from the same
// `fn_sig_of` verdict and must not drift apart — the "RCENUM:"/"RCENUMS:" twin
// lesson (#7358), where converting half of one value tagged twice produced two
// keys off one string.
// stamp_fn_value_facts applies BOTH fn-VALUE facts to the slot a `var` bind has
// just created: the signature sidecars lower_func's pre-pass filed under this
// binding's site, and the Option/Result return read off the init.
//
// THREE paths in lower_stmt_var bind a fn-typed `var`, and each has to call this:
// bind_var_slot, lower_stmt_var_closure (a lambda / closure init, which does not
// route through bind_var_slot and calls the two halves itself because its init
// carries no fn-type ANNOTATION to gate on), and the const-fn VALUE branch
// (`var g: () => T = f`, #3574), which binds its own slot and returns early.
// Missing that third one took `match (f())` off the IR path outright: the local
// had no recorded Option return, so lower_stmt_match could not name the
// scrutinee's payload type and bailed the whole function.
pub function (s: LowerState) stamp_fn_value_facts(v: ast.StmtVar, slot: i32, pre: LowerState): LowerState {
    var out: LowerState = s.stamp_fnval_seed(slot, reclaim_site_key_of(v.name, v.line, v.col));
    // An ANNOTATED fn-typed local bound to a named opt-returning fn
    // (`var f: () => Option[i32] = g`), so a later `match (f())` names its
    // scrutinee type instead of bailing (#3457 slice 3). Gated on the fn-type
    // ANNOTATION: the bare unannotated `var f = g` form has no fn-type slot
    // metadata, so its `f()` call miscompiles on the IR path (a raw-pointer
    // dispatch, SIGSEGV) — leaving it unstamped keeps that shape out of the IR
    // path, so it bails rather than miscompiles.
    if (is_fn_payload_spelling(v.type_name) || v.type_name == "fn") {
        var optret: string = closure_init_opt_ret(v.init, pre);
        if (optret.len() > 0) { out = out.mark_closure_opt_ret(slot, optret); }
    }
    return out;
}

// stamp_fnval_seed applies the "<site>|<dyn>|<sig>|<ret>" row lower_func's
// pre-pass filed for `site`, if any, to slot `i`. The one place the seed is
// read; the facts live on the slot from here on.
pub function (s: LowerState) stamp_fnval_seed(i: i32, site: string): LowerState {
    if (site.len() == 0) { return s; }
    var row: string = tagged_value_of(s.fnval_seed, "", site);
    if (row.len() == 0) { return s; }
    var b1: i32 = 0;
    while (b1 < row.len() && row[b1] != b'|') { b1 = b1 + 1; }
    if (b1 >= row.len()) { return s; }
    var b2: i32 = b1 + 1;
    while (b2 < row.len() && row[b2] != b'|') { b2 = b2 + 1; }
    if (b2 >= row.len()) { return s; }
    return s.mark_fn_value_sidecars(i,
        slice_unchecked(row, 0, b1) + "",
        slice_unchecked(row, b1 + 1, b2) + "",
        slice_unchecked(row, b2 + 1, row.len()) + "");
}

pub function (s: LowerState) mark_fn_value_sidecars(i: i32, dyn_positions: string, sig: string, ret: string): LowerState {
    if (i < 0 || i >= s.locals.len()) { return s; }
    var li: LocalInfo = s.locals[i];
    if (dyn_positions.len() > 0) { li = li_set_fn_dyn(li, dyn_positions); }
    if (sig.len() > 0) {
        li = li_set_fn_sig(li, sig);
        li = li_set_fn_ret(li, ret);
    }
    return LowerState { ...s, locals: s.locals.with(i, li) };
}

// closure_init_opt_ret is the Option/Result return type of a closure-valued
// initialiser, or "".
//
// The load-bearing case is the `__mkclo$<cloname>` env-box constructor, because
// the lift runs BEFORE lowering: by the time a `var f = <lambda>` reaches here
// its init is no longer an ExprLambda but that marker call, whose callee ident
// is NOT a module function — `<cloname>` after the 8-char prefix is. Reading the
// callee name directly yields "" and the whole helper goes inert, which is
// exactly the dead end recorded in docs/SELFHOST-AST-RETIREMENT.md.
//
// An array-element init (`var f = fns[i]`) is still not covered: the element's
// fn type is not tracked anywhere to recover a return type from.
function closure_init_opt_ret(init: ast.Expr, s: LowerState): string {
    match (init) {
        ast.ExprLambda(lam) => {
            if (lam.ret_type.len() >= 8 && (slice_unchecked(lam.ret_type, 0, 7) == "Option[" || slice_unchecked(lam.ret_type, 0, 7) == "Result[")) { return lam.ret_type + ""; }
            return "";
        },
        ast.ExprIdent(iid) => {
            var viaclo: string = s.closure_opt_ret(s.slot_of(iid.name));
            if (viaclo != "") { return viaclo; }
            return s.opt_ret_type(iid.name);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") {
                        return s.opt_ret_type(slice_unchecked(cid.name, 8, cid.name.len()) + "");
                    }
                    return s.opt_ret_type(cid.name);
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}

// add_tup_elem_kinds (#7226): record a "TUP:" tuple local's per-element rc kinds
// ("<slot>|<kinds>", one char per position: '.' nothing to release, 'a' an rc
// container the construction retain inc'd). Written by bind_var_slot from the
// SAME slot_is_rc_container test that decides the retain, on the same slots, so
// the retain and the release it owes cannot drift apart.
//
// Keyed on the SLOT, not the name. tagged_value_of
// returns the FIRST entry matching a key, and two same-named tuple locals in
// sibling blocks are two slots under one name — so a name key hands one block's
// kinds to the other block's slot, and a position the second tuple never retained
// gets released. Witnessed as exit 99 on sibling blocks binding `t` to
// `(i, xs)` and `(i, [i+7, i+9])`, in either order. Slot indices are assigned by
// add_local and never renumbered, and unlike a name they survive retire_locals'
// block-exit rename.
pub function (s: LowerState) add_tup_elem_kinds(entry: string): LowerState {
    return LowerState { ...s, tup_elem_kinds: s.tup_elem_kinds.append(entry) };
}

// tup_elem_kinds_of returns the registered element-kinds string for the tuple in
// slot `i` ("" when that tuple retained nothing).
pub function (s: LowerState) tup_elem_kinds_of(i: i32): string {
    return tagged_value_of(s.tup_elem_kinds, "", util.i32_to_string(i));
}

// is_str_slot / mark_str query and set the string-ness of slot i.
// slot_is_rc_container reports whether slot i holds an rc-tracked heap value that
// a CONTAINER store aliases: an array buffer, a string box, or a tuple box.
//
// It is the admission for the construction-store retain at the three container
// constructors (array literal, tuple literal, Option/Result payload). Each already
// had the retain for ARRAY slots only, so a string or tuple local stored into a
// container kept rc 1 and __fern_rc_is_unique called it unique while the container
// still pointed at it — the same degradation of the constructor-reuse guard the
// array case was fixed for (#4350), two slot kinds over. Keeping the three sites on
// ONE predicate is what stops them drifting apart again.
// slot_is_tuple_box reports whether slot i holds a TUPLE box. Bounds-guarded
// like its sibling below, which matters: slot_of returns -1 for an ident that is
// not a local at all — a module function name, an enum variant, `None` — and an
// unguarded `s.locals[i]` on that crashes the COMPILER rather than miscompiling
// the program. Thirteen fixtures died at "array index out of range" before this
// guard, none of them containing a tuple.
pub function (s: LowerState) slot_is_tuple_box(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].tuple_elems.len() > 0;
}

pub function (s: LowerState) slot_is_rc_container(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.is_arr_slot(i) || s.is_str_slot(i) || s.locals[i].tuple_elems.len() > 0;
}

pub function (s: LowerState) is_str_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_str;
}

pub function (s: LowerState) mark_str(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_str(s.locals[i], v)) };
}

pub function (s: LowerState) is_strarr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_strarr;
}

// is_cell_slot / cell_elem_of_slot query a Cell[T] slot (#5510).
pub function (s: LowerState) is_cell_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_cell;
}
pub function (s: LowerState) cell_elem_of_slot(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].cell_elem;
}

pub function (s: LowerState) mark_strarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_strarr(s.locals[i], v)) };
}

pub function (s: LowerState) mark_strarr_builtin(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_strarr_builtin(s.locals[i], v)) };
}

pub function (s: LowerState) mark_str_view_local(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_str_view_local(s.locals[i], v)) };
}

pub function (s: LowerState) is_str_view_local_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].str_view_local;
}

pub function (s: LowerState) mark_str_identity_src(i: i32, v: i32): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_str_identity_src(s.locals[i], v)) };
}

pub function (s: LowerState) str_identity_src_slot(i: i32): i32 {
    if (i < 0) { return 0 - 1; }
    if (i >= s.locals.len()) { return 0 - 1; }
    return s.locals[i].str_identity_src;
}

// replace_src_slot_of: the RECEIVER's slot for `<string ident>.replace(a, b)`,
// or -1. Only a bare ident receiver qualifies — the guard has to compare the
// result against something the frame still holds, and a temporary receiver has
// no slot to compare with (and could not be the identity anyway, since nothing
// else names it).
function replace_src_slot_of(e: ast.Expr, s: LowerState): i32 {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 2) { return 0 - 1; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "replace") { return 0 - 1; }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            if (!expr_is_str(fa.obj, s)) { return 0 - 1; }
                            var si: i32 = s.slot_of(rid.name);
                            if (si < 0) { return 0 - 1; }
                            if (!s.is_str_slot(si)) { return 0 - 1; }
                            return si;
                        },
                        _ => { return 0 - 1; }
                    }
                },
                _ => { return 0 - 1; }
            }
        },
        _ => {}
    }
    return 0 - 1;
}

pub function (s: LowerState) is_strarr_builtin_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].strarr_builtin;
}

// init_is_builtin_strarr_producer: `<string>.split(sep)` / `<string>.lines()`,
// the two builtin methods that build a string[] the runtime fills itself. On the
// IR path a string receiver routes these to lower_str_method's ops — the stdlib's
// own `(s: string) split` declaration is shadowed, which the emitted call
// (__fn___fern_str_split) confirms — so the elements are made by the runtime and
// stored into that array and nowhere else.
//
// `chars` is deliberately absent: it is not a builtin — it resolves to
// std/string's codepoint decoder, which returns char[].
function init_is_builtin_strarr_producer(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprCall(bc) => {
            match (bc.callee) {
                ast.ExprFieldAccess(bfa) => {
                    if (bfa.field != "split" && bfa.field != "lines") { return false; }
                    return expr_is_str(bfa.obj, s);
                },
                _ => { return false; }
            }
        },
        _ => {}
    }
    return false;
}

pub function (s: LowerState) is_bool_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_bool;
}

pub function (s: LowerState) mark_bool(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_bool(s.locals[i], v)) };
}

pub function (s: LowerState) is_boolarr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_boolarr;
}

pub function (s: LowerState) mark_boolarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_boolarr(s.locals[i], v)) };
}

// str_own_slot / mark_str_own query and set the slot-carried string
// OWNERSHIP class (#4297 CS4; see LocalInfo.str_own for the code table).
// An out-of-range slot reads 1 (Borrowed) -- the conservative never-free
// default every unproven binding keeps.
pub function (s: LowerState) str_own_slot(i: i32): i32 {
    if (i < 0) { return 1; }
    if (i >= s.locals.len()) { return 1; }
    return s.locals[i].str_own;
}

pub function (s: LowerState) mark_str_own(i: i32, v: i32): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_str_own(s.locals[i], v)) };
}

// is_str_caller_elem_slot / mark_str_caller_elem query and set LocalInfo.str_caller_elem.
pub function (s: LowerState) is_str_caller_elem_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].str_caller_elem;
}
pub function (s: LowerState) mark_str_caller_elem(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_str_caller_elem(s.locals[i], v)) };
}

// struct_type_of_slot / mark_struct_type query and set slot i's struct type
// ("" = neither a struct nor a struct array). An ARRAY slot records its ELEMENT
// type here, so a non-empty answer means "struct box OR struct-array buffer" —
// is_arr_slot is what tells the two apart, and any release keyed on this type
// needs it (a struct-shaped helper reading a buffer walks off its end).
pub function (s: LowerState) struct_type_of_slot(i: i32): string {
    if (i < 0) { return ""; }
    if (i >= s.locals.len()) { return ""; }
    return s.locals[i].struct_type;
}

pub function (s: LowerState) mark_struct_type(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_struct_type(s.locals[i], t)) };
}

// mark_opt_type records slot i's Option[T]/Result[T,E] type string, so a later
// `match` on that local can recover the bound payload type.
pub function (s: LowerState) mark_opt_type(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_opt_type(s.locals[i], t)) };
}

// opt_type_of_slot returns slot i's recorded Option/Result type, or "".
pub function (s: LowerState) opt_type_of_slot(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].opt_type;
}

// mark_tuple_elems records slot i's comma-joined tuple element-type tags.
// mark_tuple_type records the slot's DECLARED tuple spelling alongside the
// element tags derived from it. The tags answer "what kind is element N";
// only the spelling can answer "what signature does a call through element N
// dispatch on", because a fn element's tag is the coarse "clo" (#5986).
pub function (s: LowerState) mark_tuple_type(i: i32, t: string): LowerState {
    if (i < 0 || i >= s.locals.len()) { return s; }
    return LowerState { ...s, locals: s.locals.with(i, li_set_tuple_type(s.locals[i], t)) };
}

// mark_fnarr_elem records slot i's declared fn-ARRAY element spelling — the
// array sibling of mark_tuple_type, and recorded for the same reason.
pub function (s: LowerState) mark_fnarr_elem(i: i32, t: string): LowerState {
    if (i < 0 || i >= s.locals.len()) { return s; }
    return LowerState { ...s, locals: s.locals.with(i, li_set_fnarr_elem(s.locals[i], t)) };
}

pub function (s: LowerState) mark_tuple_elems(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_tuple_elems(s.locals[i], t)) };
}

// tuple_elem_tag returns slot i's Nth tuple element-type tag, or "". The split is
// depth-aware (counting `(`/`[` … `)`/`]`) so a nested tuple element whose own tag
// contains commas — `i32,(i32,i32)` → element 1 is `(i32,i32)` — is recovered
// whole rather than mis-split. A flat encoding never goes above depth 0, so its
// behaviour is unchanged.
pub function (s: LowerState) tuple_elem_tag(i: i32, n: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    var enc: string = s.locals[i].tuple_elems;
    if (enc.len() == 0) { return ""; }
    var depth: i32 = 0;
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || (depth == 0 && enc[k] == b',')) {   // end, or top-level ','
            if (idx == n) { return slice_unchecked(enc, start, k) + ""; }
            idx = idx + 1;
            start = k + 1;
        } else {
            var ch: u8 = enc[k];
            if (ch == b'[' || ch == b'(') { depth = depth + 1; }
            else if (ch == b']' || ch == b')') { depth = depth - 1; }
        }
        k = k + 1;
    }
    return "";
}

// csv_nth returns the Nth comma-separated field of `enc` (0-based), or "". The
// split is depth-aware (counting `(`/`[` … `)`/`]`) so a nested tuple element tag
// — `(i32,i32),i64` → field 0 is `(i32,i32)`, field 1 is `i64` — is recovered
// whole. A flat encoding never exceeds depth 0, so its behaviour is unchanged.
pub function csv_nth(enc: string, n: i32): string {
    if (enc.len() == 0) { return ""; }
    var depth: i32 = 0;
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || (depth == 0 && enc[k] == b',')) {   // end, or top-level ','
            if (idx == n) { return slice_unchecked(enc, start, k) + ""; }
            idx = idx + 1;
            start = k + 1;
        } else {
            var ch: u8 = enc[k];
            if (ch == b'[' || ch == b'(') { depth = depth + 1; }
            else if (ch == b']' || ch == b')') { depth = depth - 1; }
        }
        k = k + 1;
    }
    return "";
}

// expr_tuple_elem_tag returns the type tag of element N of a tuple expression
// (`t` an ident with tracked element types), or "".
pub function expr_tuple_elem_tag(e: ast.Expr, n: i32, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), n); },
        ast.ExprFieldAccess(fa) => {
            // `t.K.N` where `t.K` is itself a (nested) tuple element: recover the
            // outer element K's tuple-type tag, then read element N out of it.
            // Walk first; when it cannot type `fa`, the checker-stamped fa.ty
            // carries this node's own "(t0, t1, …)" spelling (#5986).
            if (util.is_all_digits(fa.field)) {
                var ot: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                var ett: string = tuple_type_elem_tag(ot, n);
                if (ett != "") { return ett; }
                return tuple_type_elem_tag(fa.ty, n);
            }
            // `p.t.N` where `t` is a tuple struct field — element n's tag from the
            // field's tuple type string.
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty != "") {
                var dtt: string = tuple_type_elem_tag(decl_field_type(s.structs, oty, fa.field), n);
                if (dtt != "") { return dtt; }
            }
            return tuple_type_elem_tag(fa.ty, n);
        },
        ast.ExprIndex(ix) => {
            // `arr[i].N` where arr is a `(tuple)[]` array-of-tuples local: the element
            // TUPLE TYPE is recorded on the (is_arr) slot's arrarr_elem (set at binding
            // for a reclaim-eligible tuple array, #4365). Read element n's tag out of it,
            // so `arr[i].N.field` (struct field of a tuple element) and a wide `arr[i].N`
            // read resolve on the IR path instead of bailing (the bail fired because
            // expr_struct_type(arr[i].N) had no tag here → lower_expr fail).
            match (ix.array) {
                ast.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (asl >= 0 && s.is_arr_slot(asl)) {
                        var et: string = s.arrarr_elem_of_slot(asl);
                        if (util.is_tuple_type_name(et)) { return tuple_type_elem_tag(et, n); }
                    }
                },
                _ => {}
            }
            // The slot walk above only reaches a NAMED (tuple)[] local. When the
            // array is a call result or a nested chain — `mk()[i].N` — there is no
            // slot to read, and returning "" here made the tuple-element read
            // lower as a 4-byte i32: an f64 element then failed the wasm
            // validator ("expected f64, found i32"). ExprIndex.ty (#6165) already
            // carries the checker's type for this very node, and a tuple stamps
            // its canonical "(f64, i32)" spelling, so the same tuple_type_elem_tag
            // decoder reads element n out of it. Walk first, tag fills the hole.
            if (util.is_tuple_type_name(ix.ty)) { return tuple_type_elem_tag(ix.ty, n); }
            return "";
        },
        ast.ExprCall(tc) => {
            // typed-IR (#5531): a tuple-returning call carries its full
            // "(t0, t1, …)" tag on c.ty (the checker resolved any generic
            // element to a concrete type), so read element n directly. Without
            // it a `f().N` tuple-element read whose element is a struct / nested
            // tuple has no tag here, so `f().N.field` bails the enclosing function.
            // Unannotated (asm_ir_run / native) leaves c.ty "" →
            // tuple_type_elem_tag("", n) is "" → unchanged, so the read still bails.
            return tuple_type_elem_tag(tc.ty, n);
        },
        _ => { return ""; }
    }
    return "";
}

// expr_is_tuple reports whether `e` evaluates to a tuple value: a tuple literal,
// a tuple-tracked local/param, or a tuple-typed element of an enclosing tuple
// (`t.N` whose element tag is itself `(…)`). Drives admitting a nested tuple as a
// (leak-only, one-pointer) element of another tuple.
pub function expr_is_tuple(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprTuple(_) => { return true; },
        ast.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), 0) != ""; },
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var ot: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                return util.is_tuple_type_name(ot);
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_result reports whether `e` evaluates to a Result value: a bare `Ok(x)`
// / `Err(x)` construction, or a Result-typed local/param. Drives admitting a
// Result as a (leak-only, one-pointer) tuple element. The full `Result[T, E]`
// tag is recovered from the binding's annotation (a bare `Ok(x)` cannot name E),
// so this only gates ADMISSION, not the tag.
pub function expr_is_result(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return (cid.name == "Ok" || cid.name == "Err") && c.args.len() == 1; },
                _ => { return false; }
            }
        },
        ast.ExprIdent(id) => {
            var ot: string = s.opt_type_of_slot(s.slot_of(id.name));
            return ot.len() >= 7 && slice_unchecked(ot, 0, 7) == "Result[";
        },
        _ => { return false; }
    }
    return false;
}

// literal_is_i64 reports whether a non-negative integer literal text is too big
// for i32 (so it is an i64 value): >10 digits always, exactly 10 digits if it
// exceeds i32-max "2147483647". (Negative literals are unary minus over a
// positive literal, so the sign is handled separately.)
// lit_has_i64_suffix reports whether `e` is a number literal carrying an
// EXPLICIT `i64` / `u64` suffix. literal_is_i64 classifies by MAGNITUDE only,
// so a small suffixed literal (`7i64`) reads as i32 — fine for a scalar, which
// lower_i64 widens from its context, but wrong for an ARRAY LITERAL, whose
// element width has to be decided before any context applies. Without this
// `[7i64, 9i64]` missed the arr_make_i64 path and was built at 4-byte stride
// with i32 stores while every read used stride 8 and an i64 load: element 0
// returned the low half of the packed pair (accidentally right) and element 1
// read past the allocation (#6188).
//
// Deliberately NOT folded into infer_expr_width: that is consulted for every
// expression, and widening a suffixed literal there makes a lifted `__lam_`
// if/match expression infer a 64-bit body against its default i32 ret_type,
// which bails the module off the IR path (measured on fernsmith seeds 265 and
// 502). The array-literal element is the one place that needs the suffix.
pub function lit_has_i64_suffix(e: ast.Expr): boolean {
    match (e) {
        ast.ExprNumber(num) => {
            if (num.is_float) { return false; }
            return num.suffix == "i64" || num.suffix == "u64";
        },
        _ => { return false; }
    }
    return false;
}

// lit_is_i32_min_magnitude reports whether `e` is the bare literal 2147483648 —
// i32::MIN's magnitude, the one value literal_is_i64 calls too big for i32 that
// a leading `-` brings back into range. A suffixed literal is excluded: the
// suffix is the declared width and outranks the magnitude.
pub function lit_is_i32_min_magnitude(e: ast.Expr): boolean {
    match (e) {
        ast.ExprNumber(num) => {
            if (num.is_float) { return false; }
            if (num.suffix.len() > 0) { return false; }
            return num.text == "2147483648";
        },
        _ => { return false; }
    }
    return false;
}

pub function literal_is_i64(text: string): boolean {
    var n: i32 = text.len();
    if (n > 10) { return true; }
    if (n < 10) { return false; }
    var m: string = "2147483647";
    var i: i32 = 0;
    while (i < 10) {
        if (text[i] > m[i]) { return true; }
        if (text[i] < m[i]) { return false; }
        i = i + 1;
    }
    return false;
}

// fn_value_arg_name returns the function name if `e` is a bare identifier that
// names no local (so it refers to a top-level function — a function-value
// candidate), else "". The caller pairs this with callee_param_is_fn to confirm
// the argument position actually expects a function value.
pub function fn_value_arg_name(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return id.name; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// fn_value_array_lit reports whether `e` is an `(() => T)[]` (spelled "fn[]")
// field/binding value that is an all-fn-VALUE array literal: an ExprArray whose
// EVERY element is a bare identifier naming a top-level function (a fn pointer),
// never a local, a capturing-lambda box, or a `__mkclo$` closure marker. The
// lift pass turns a NON-capturing lambda element into a hoisted `__lam_N` fn-name
// (lift_expr_walk's ExprArray arm), so `[() => 7]` reaches here as `[__lam_0]` —
// the SAME shape as `[inc, dbl]`. A capturing lambda stays a `__mkclo$` marker
// (fn_value_arg_name declines it), keeping the whole literal off this path so it
// stays a closure array. The construction (ExprStructLit) lowering emits
// op_const_func per element + op_arr_make, storing a plain fn-pointer array; the
// whole-program registry (fnptr_arr_fields_of) records the field so the read side
// dispatches it as a fn pointer, not a closure box.
pub function fn_value_array_lit(e: ast.Expr, field_type: string, s: LowerState): boolean {
    if (field_type != "fn[]") { return false; }
    match (e) {
        ast.ExprArray(a) => {
            if (a.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (fn_value_arg_name(a.elements[i], s) == "") { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// ident_is_fn_value reports whether a bare ident lowers to a function VALUE
// (op_const_func) rather than a local load / `None` / unit-variant box / const
// call — i.e. it names a top-level function WITH params. Mirrors the ExprIdent
// lowering's const_func fall-through (so a tuple-element tag matches what the
// element actually emits): not a local slot, not `None`, not a struct / unit
// variant name, and not a const (a 0-arg receiver-less fn). const_funcs_only_known
// still backstops a bogus name — if the tag says "fn" the element emits a
// const_func, and an unknown function bails the whole module either way.
pub function ident_is_fn_value(name: string, s: LowerState): boolean {
    if (s.slot_of(name) >= 0) { return false; }
    if (name == "None") { return false; }
    if (decl_is_struct(s.structs, name)) { return false; }
    if (s.is_const_fn(name)) { return false; }
    return true;
}

// elem_type_tag computes the type tag of an expression for tuple-element typing:
// expr_opt_elem_tag returns the COMMA-FREE Option type spelling of a tuple
// element that is an Option value (`Some(7)` → "Option[i32]", `Some("x")` →
// "Option[string]"), or "" otherwise. Comma-free is required because the tuple-
// element tag encoding (mark_tuple_elems / tuple_elem_tag) splits on commas, so
// `Result[T, E]` (which has one) is deliberately NOT recovered here — a Result
// element gets no tag, so the lowering bails on it (#3018). Only a `Some(<scalar/string>)`
// construction or an Option-typed local/param is admitted (a leak-only box, one
// pointer slot, like a struct element); a `None` with no statically-known
// payload, or a nested Option, falls through to "".
pub function expr_opt_elem_tag(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        var pt: string = elem_type_tag(c.args[0], s);
                        // "clo": a closure-BOX payload (`Some(<lambda>)` — the
                        // lift wrapped it into a `__mkclo$…` env box). One
                        // pointer slot; the match arm marks the binding a
                        // closure local so `f(args)` dispatches env-first.
                        // elem_ty_is_f64slot, not `== "f64"`: an f32 payload
                        // rides the same 8-byte slot, and spelling it literally
                        // dropped the tag for one — which loses the payload type
                        // rather than widening it (#7756).
                        if (pt == "i32" || pt == "string" || pt == "i64" || elem_ty_is_f64slot(pt) || pt == "boolean" || pt == "clo") {
                            return "Option[" + pt + "]";
                        }
                        return "";
                    }
                    var rt: string = resolve_argref_opt_type(s.opt_ret_type(cid.name), c.args, s);
                    if (rt.len() >= 8 && slice_unchecked(rt, 0, 7) == "Option[") { return rt; }
                    return opt_elem_tag_from_ty(c.ty);
                },
                // typed-IR (#5986): an Option-returning METHOD call (`st.find(x)`)
                // has no registry key here; the checker's stamped tag answers.
                _ => { return opt_elem_tag_from_ty(c.ty); }
            }
        },
        ast.ExprIdent(id) => {
            var ot: string = s.opt_type_of_slot(s.slot_of(id.name));
            if (ot.len() >= 8 && slice_unchecked(ot, 0, 7) == "Option[") { return ot; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// opt_elem_tag_from_ty admits a checker-stamped "Option[T]" for tuple-element
// typing under the same payload constraint the Some-construction walk
// enforces: the element machinery handles exactly these payload kinds, and a
// wider tag (Option[u64], a struct payload) admitted here routes the element
// into lowering the walk's rejection deliberately kept it out of.
function opt_elem_tag_from_ty(ty: string): string {
    if (ty.len() < 8 || slice_unchecked(ty, 0, 7) != "Option[") { return ""; }
    var pt: string = opt_payload_type(ty, "Some");
    if (pt == "i32" || pt == "string" || pt == "i64" || elem_ty_is_f64slot(pt) || pt == "boolean") { return ty; }
    return "";
}

// some_opt_type returns the "Option[T]" type of a DIRECT `Some(x)` construction
// whose payload type T is statically recoverable (scalar / string / struct), or
// "" otherwise. Lets a `var o = Some(7)` local record its opt_type and a direct
// `match (Some(7))` scrutinee recover the payload — the construction analogue of
// the call-returns-Option path (opt_ret_fns). `Ok`/`Err` are NOT handled: a
// direct `Ok(x)` can't determine the Result's `E` arm (it needs an annotation,
// handled separately). A nested-OPTION payload (`Some(Some(5))` →
// "Option[Option[i32]]") IS recovered — the StmtMatch payload binding marks the
// inner Option type (mark_opt_type) so a nested `match (b)` resolves it. A
// nested-RESULT payload (whose type spelling carries a comma) and a fn payload
// are deferred ("").
//
// A bare `None` payload is NOT recoverable, and is not reported as such: `None`
// is an ExprIdent with no slot, so elem_type_tag falls to its "i32" default and
// `Some(None)` answers "Option[i32]" for a payload it never read. An ANNOTATED
// binding replaces exactly that answer with its declared type (#7217); an
// unannotated one keeps it, its payload being a type var the checker resolves
// nowhere and accepts only while it goes unread.
pub function some_opt_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        // A Some whose payload is itself an Ok/Err (Result)
                        // construction can't be fully typed here: a bare `Ok(x)`
                        // doesn't name the Result's E arm, and elem_type_tag
                        // defaults such a payload to "i32" — which would mis-record
                        // `Option[Result[T, E]]` as `Option[i32]`. Return "" so the
                        // binding's annotation (the authoritative full type) wins.
                        if (expr_is_result(c.args[0], s)) { return ""; }
                        // A NESTED Some payload (`Some(Some(P))`): recurse so the
                        // inner Option type is recovered — elem_type_tag defaults a
                        // nested Some to "i32", collapsing `Option[Option[P]]` to
                        // `Option[i32]`, which then mis-binds the outer match's
                        // payload as i32 and bailed `match (inner)`.
                        var innr: string = some_opt_type(c.args[0], s);
                        if (innr.len() > 0) { return "Option[" + innr + "]"; }
                        var pt: string = elem_type_tag(c.args[0], s);
                        if (pt == "fn") { return ""; }
                        if (pt.len() >= 7 && slice_unchecked(pt, 0, 7) == "Result[") { return ""; }
                        // An ARRAY payload tagged as a single MAP (`Some(ms)`
                        // where ms: Map[K, V][]): a map-array slot records the
                        // ELEMENT map type in the map column so `ms[i].get(k)`
                        // resolves, so elem_type_tag answers the bare `Map[K, V]`
                        // for the array itself. Recording that claims the payload
                        // IS one map, and the claim beats the binding's own
                        // annotation, so `match` binds an array box as a map.
                        // Decline for the same reason as the two cases above.
                        //
                        // Only the map spelling: a scalar array deliberately keeps
                        // the bare "i32" tag (elem_type_tag's typed-array arm), and
                        // Option[i32[][]] depends on it.
                        if (is_map_type_name(pt) && !is_array_type_name(pt) && expr_is_arr_src(c.args[0], s)) { return ""; }
                        return "Option[" + pt + "]";
                    }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// some_payload_is_bare_none reports whether `e` is a direct `Some(None)`. That
// is the one construction some_opt_type cannot type: `None` is an ExprIdent
// with no slot, so elem_type_tag falls to its "i32" default and the walk
// answers "Option[i32]" for a payload it never read.
function some_payload_is_bare_none(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name != "Some" || c.args.len() != 1) { return false; }
                    match (c.args[0]) {
                        ast.ExprIdent(aid) => { return aid.name == "None"; },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// opt_recv_base_type returns "Option" / "Result" if `e` is an Option/Result
// VALUE — an opt-typed local/param, a direct `Some(x)`, or an Option/Result-
// returning free call — else "". It's the dispatch base for an Option/Result-
// RECEIVER method (`Some(5).map(...)` / `r.map(...)`): the method is keyed
// "Option.<m>" / "Result.<m>" (base_type_name of the receiver type), so a
// `var x = <opt>.m()` binding or a `match (<opt>.m())` scrutinee recovers the
// result's Option/Result type via opt_ret_type. #3049.
pub function opt_recv_base_type(e: ast.Expr, s: LowerState): string {
    var t: string = "";
    match (e) {
        ast.ExprIdent(id) => { t = s.opt_type_of_slot(s.slot_of(id.name)); },
        // `s[a:b].unwrap_or("")` — the checked string slice (#5634) is an
        // Option VALUE, so its methods key "Option.<m>".
        ast.ExprSlice(osl) => { if (expr_is_str(osl.array, s)) { t = "Option[string]"; } },
        // `b.v` where `v` is an Option/Result struct field, or `t.N` where the
        // tuple element is an Option/Result — lets `b.v.uo(...)` / `match (b.v)`
        // dispatch on the field value (#3069).
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (tt.len() >= 8 && (slice_unchecked(tt, 0, 7) == "Option[" || slice_unchecked(tt, 0, 7) == "Result[")) { t = tt; }
            } else {
                var foty: string = expr_struct_type(fa.obj, s);
                if (foty != "") {
                    var fft: string = decl_field_type(s.structs, foty, fa.field);
                    if (fft.len() >= 8 && (slice_unchecked(fft, 0, 7) == "Option[" || slice_unchecked(fft, 0, 7) == "Result[")) { t = fft; }
                }
            }
        },
        ast.ExprCall(c) => {
            t = some_opt_type(e, s);
            if (t == "") {
                match (c.callee) {
                    ast.ExprIdent(cid) => { t = resolve_argref_opt_type(s.opt_ret_type(cid.name), c.args, s); },
                    // `b.find()` where b's method returns Option/Result — keyed
                    // "<Type>.<method>" (struct receiver) or "Option.<m>" /
                    // "Result.<m>" (an Option/Result-receiver method, recursively).
                    // Lets a chained `b.find().map(...)` recover the inner result
                    // (#3066).
                    ast.ExprFieldAccess(cfa) => {
                        // A built-in array method returning Option (`xs.min()`) —
                        // helper-backed, so its return type comes from the registry
                        // rather than the module's own funcs.
                        var aok: boolean = false;
                        t = builtin_arr_opt_ret_type(cfa.field, cfa.obj, s);
                        if (t != "") { aok = true; }
                        // Associated call `Type.method()` returning Option/Result
                        // — the object is a bare TYPE name (not a slot), so key
                        // opt_ret_type by "<Type>.<method>" directly (mirrors
                        // expr_struct_type's associated arm). Recovers an
                        // unannotated `match (User.from_json(s))`'s Result[User,
                        // string] payload types — the @derive(Json) deserialiser.
                        match (cfa.obj) {
                            ast.ExprIdent(tid) => {
                                if (s.slot_of(tid.name) < 0) {
                                    var art: string = s.opt_ret_type(tid.name + "." + cfa.field);
                                    if (art != "") { t = art; aok = true; }
                                }
                            },
                            _ => {}
                        }
                        if (!aok) {
                            var mrty: string = expr_struct_type(cfa.obj, s);
                            if (mrty != "") { t = s.opt_ret_type(mrty + "." + cfa.field); }
                            else {
                                var mrb: string = opt_recv_base_type(cfa.obj, s);
                                if (mrb != "") { t = s.opt_ret_type(mrb + "." + cfa.field); }
                                // An ENUM-receiver method returning Option/Result, called
                                // on a fresh variant (`V(7).get()`) — key "<Enum>.<m>"
                                // via the variant's enum_owner (#3076).
                                else {
                                    var men: string = expr_enum_type(cfa.obj, s);
                                    if (men != "") { t = s.opt_ret_type(men + "." + cfa.field); }
                                }
                            }
                        }
                    },
                    _ => {}
                }
            }
            // typed-IR (#5986): an Option/Result-returning call no registry can
            // key (a fn-typed local, an IIFE) answers from the checker's stamp;
            // the prefix classification below rejects everything else. Never a
            // direct Some/Ok/Err construction: some_opt_type's "" for those is a
            // deliberate payload-kind rejection, not a hole to fill.
            if (t == "") {
                match (c.callee) {
                    ast.ExprIdent(fbid) => {
                        if (fbid.name != "Some" && fbid.name != "Ok" && fbid.name != "Err") { t = c.ty; }
                    },
                    _ => { t = c.ty; }
                }
            }
        },
        _ => {}
    }
    if (t.len() >= 7 && slice_unchecked(t, 0, 7) == "Option[") { return "Option"; }
    if (t.len() >= 7 && slice_unchecked(t, 0, 7) == "Result[") { return "Result"; }
    return "";
}

// "string" for a string, a struct type name for a struct, "fn" for a function
// value, "Option[T]" for an Option value, "i64"/"f64" for an 8-byte scalar, else
// "i32" (scalar). The 8-byte tags drive the wasm tuple's per-element
// i64.store/load vs f64.store/load (and route i64 through lower_i64); "fn" lets
// `t.N(args)` recover the element's callability; "Option[T]" lets `match (t.N)`
// recover the payload.
pub function elem_type_tag(e: ast.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    // A Cell element carries its DECLARED spelling, `Cell[T]`, so a tuple built
    // from a literal tags its slot the same way the `: (i32, Cell[i32])`
    // annotation does. That agreement is what lets `t.N.get()` recognise the
    // element as a cell; tagging it by the element's own width instead made the
    // read key on `i32.get`, an unknown symbol, and bail the module. One
    // pointer slot either way — a cell IS a one-element array box.
    var celt: string = cell_new_elem_tag(e, s);
    if (celt == "") { celt = cell_elem_type(e, s); }
    if (celt != "") { return "Cell[" + celt + "]"; }
    // A map READ method's result (`m.len()` / `m.has(k)` / `m.get(k)` /
    // `m.get_or(k, d)`): named from the receiver's Map[K, V] rather than left to
    // the walks below, which key on the RESULT expression and so answer "i32" for
    // every non-string value column — a `Map[K, i64]` read stored 32-bit wide.
    // Ahead of the width predicates for the same reason expr_is_str is: they
    // reach a get_or only through the receiver shapes they each re-walk, and this
    // resolves all of them once. #7213.
    var mmtag: string = map_method_elem_tag(e, s);
    if (mmtag != "") { return mmtag; }
    // A closure-BOX element: a `__mkclo$…` env-box constructor (what the lift
    // pass rewrites every lambda / bare-fn tuple element to), a call to a
    // closure-returning fn, or an ident bound to a closure local. Tagged
    // "clo" — one pointer slot holding the box — so `t.N(args)` dispatches
    // env-first (push the box as __env, the args, then box[0] as the target),
    // NOT the bare call_indirect the plain "fn" pointer tag gets. Matches the
    // DECLARED-type tag (tuple_elem_tags maps an "fn" segment to "clo"), so a
    // factory-returned tuple and a local literal agree.
    match (e) {
        ast.ExprCall(cloc) => {
            match (cloc.callee) {
                ast.ExprIdent(clocid) => {
                    if (clocid.name.len() > 8 && slice_unchecked(clocid.name, 0, 8) == "__mkclo$") { return "clo"; }
                    if (util.index_of_str(s.sigs.closure_fns, clocid.name) >= 0) { return "clo"; }
                },
                _ => {}
            }
        },
        ast.ExprIdent(cloid) => { if (s.is_closure_local(cloid.name)) { return "clo"; } },
        _ => {}
    }
    // A bare fn-name element (`(inc, 5)`): a function VALUE (a plain fn pointer,
    // one slot), tagged "fn" so `t.N(args)` lowers to tuple_get + call_indirect.
    // (Rare post-lift: the lift pass wraps unshadowed module-fn idents in tuple
    // literals into `__mkclo$` boxes, which the "clo" arm above catches.)
    match (e) {
        ast.ExprIdent(fid) => { if (ident_is_fn_value(fid.name, s)) { return "fn"; } },
        _ => {}
    }
    // An Option element (`(Some(7), 3)`): tag "Option[T]" so a later
    // `match (t.N)` recovers the payload type (a leak-only pointer slot).
    var optag: string = expr_opt_elem_tag(e, s);
    if (optag != "") { return optag; }
    // A Map element (`(Map { … }, x)`): tag it with its full `Map[K, V]` type so
    // a later `t.N.get_or(…)` dispatches as a map op (the map sibling of the
    // struct / Option element tags). The element is a heap-map POINTER — one
    // slot, leak-only like a struct element — so only the tag carries it. #3317.
    var maptag: string = expr_map_type_tag(e, s);
    if (maptag != "") { return maptag; }
    var st: string = expr_struct_type(e, s);
    if (st != "") { return st; }
    // A typed-ARRAY element (`(["a","b"], x)` / `([P{..}], x)` / `([x as i64], y)`):
    // tag it with the element-typed array spelling so a later `t.N[i]` reads at
    // the right type/width — `string[]` for the string-pointer element reads,
    // `f64[]`/`i64[]` for the 8-byte f64/i64 element reads, `P[]` to recover the
    // element struct type for `t.N[i].field`. Scalar i32[]/u32[]/boolean[]
    // arrays keep the bare "i32" tag — they need no element typing (`t.N[i]` is
    // a 4-byte scalar read) and broadening them would disturb the shared
    // destructure / kind-string consumers. The array element itself is a
    // POINTER stored in one slot (#3353), so only the tag carries the element
    // type; the width-aware `t.N[i]` read is in arr_index_is_f64 /
    // arr_index_is_i64's tuple-element cases.
    if (expr_is_strarr(e, s)) { return "string[]"; }
    if (expr_is_f64arr(e, s)) { return "f64[]"; }
    if (expr_is_i64arr(e, s)) { return "i64[]"; }
    match (e) {
        ast.ExprArray(sae) => {
            if (sae.elements.len() > 0) {
                var sel: string = expr_struct_type(iife_leaf_value(sae.elements[0]), s);
                if (sel != "" && decl_is_struct(s.structs, sel)) { return sel + "[]"; }
            }
        },
        _ => {}
    }
    // f32 BEFORE f64, for expr_scalar_type's reason: an f32 value is also
    // is_f64 (both ride the 8-byte slot), so without this an inferred f32
    // element is tagged "f64" and loses the width its method dispatch keys on
    // — the value stored is right, only `to_string` renders at f64 precision
    // (#7756).
    if (expr_is_f32(e, s)) { return "f32"; }
    if (expr_is_f64(e, s)) { return "f64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    // A bare integer literal too big for i32 is an i64 (an i64-typed local /
    // expr is already caught by infer_expr_width above).
    match (e) {
        ast.ExprNumber(num) => { if (!num.is_float && literal_is_i64(num.text)) { return "i64"; } },
        _ => {}
    }
    // A NESTED tuple element (`(1, (2, 3))`): tag it with its own tuple type
    // spelling `(t0,t1,…)` (no spaces) built recursively, so the element reads
    // back as a tuple for `t.N.M`. The element itself is a heap-tuple POINTER —
    // one slot, like a struct/array/Option element — so it needs no new op; only
    // the tag carries the nesting. The comma-joined slot encoding is decoded
    // depth-aware (tuple_elem_tag / tuple_type_elem_tag), so the inner commas
    // don't split the outer tag.
    match (e) {
        ast.ExprTuple(tl) => {
            var nt: string = "(";
            var ni: i32 = 0;
            while (ni < tl.elements.len()) {
                if (ni > 0) { nt = nt + ","; }
                nt = nt + elem_type_tag(tl.elements[ni], s);
                ni = ni + 1;
            }
            return nt + ")";
        },
        _ => {}
    }
    return "i32";
}

pub function (s: LowerState) mark_map_type(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_map_type(s.locals[i], t)) };
}
// is_cell_type_name reports whether a declared type SPELLING is a `Cell[T]`.
// The tuple-element tags and the struct-field table both hold the spelling
// verbatim, so this one test answers for either.
pub function is_cell_type_name(t: string): boolean {
    return t.len() > 5 && slice_unchecked(t, 0, 5) == "Cell[";
}

// cell_elem_of_type_name returns T for a `Cell[T]` type spelling, "" otherwise —
// the shared reader behind both the local-annotation marking and the param
// column, so a Cell PARAM tracks exactly like a Cell local.
pub function cell_elem_of_type_name(t: string): string {
    if (t.len() > 6 && slice_unchecked(t, 0, 5) == "Cell[" && slice_unchecked(t, t.len() - 1, t.len()) == "]") {
        return slice_unchecked(t, 5, t.len() - 1) + "";
    }
    return "";
}

pub function (s: LowerState) mark_cell(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_cell(s.locals[i], t)) };
}

// mark_cell_elem marks a slot as a `Cell[elem]`: mark_cell records is_cell
// (+is_arr) and the element kind, and the element-typed array column beside it
// is what makes the 1-element index read at the right WIDTH. Without is_strarr
// a `Cell[string]` element loads as an i32; without is_f64arr a wide element
// reads its low half.
//
// Every site that learns a cell's element — an annotation, a `cell_new(x)`
// initialiser, an enum / Option / Result payload — routes here rather than
// repeating the ladder. Three copies had already drifted on the float
// spellings, and the payload one was reachable: a `Cell[f32]` payload read its
// low half. Spelling it once is what is_float_array_type_name (#6175) does for
// the array-name form, for the same reason.
pub function (s: LowerState) mark_cell_elem(slot: i32, elem: string): LowerState {
    var out: LowerState = s.mark_cell(slot, elem);
    if (elem == "string") { return out.mark_strarr(slot, true); }
    if (elem == "i64" || elem == "u64") { return out.mark_i64arr(slot, true); }
    // A scalar `f32` lowers to a wasm f64, so both float spellings ride the
    // 8-byte-stride column. is_f64arr is the WIDTH driver; is_f32arr is a
    // dispatch-only overlay no cell path sets.
    if (elem == "f64" || elem == "f32" || elem == "float") { return out.mark_f64arr(slot, true); }
    return out;
}

// mark_cell_slot_from_type marks a slot bound to a `Cell[T]` value whose type is
// known only as a SPELLING — a tuple element, an enum variant payload, an
// Option/Result payload. Without this the bound name stayed plain and `c.get()`
// dispatched as a method on the ELEMENT type ("call to unknown symbol i32.get"),
// bailing the module — the payload sibling of the unannotated
// `var c = cell_new(0)` binding.
pub function (s: LowerState) mark_cell_slot_from_type(slot: i32, ty: string): LowerState {
    var elem: string = cell_elem_of_type_name(ty);
    if (elem == "") { return s; }
    return s.mark_cell_elem(slot, elem);
}

pub function (s: LowerState) map_type_of(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].map_type;
}

// slot_map_type: the `Map[K, V]` a NAME denotes, or "" when it denotes no map.
//
// An ARRAY of maps records its ELEMENT map type in the same column, so that
// `ms[i].get(k)` can resolve K/V — which means map_type_of answers a Map tag
// for `ms` itself, and reading it unguarded types the ARRAY as one map. That
// mis-dispatched `ms.len()` to op_map_len over array memory (a segfault, not a
// bail). Every reader that asks "is this name a map" wants this, not the raw
// column; the array-ELEMENT readers pair map_type_of with is_arr_slot instead.
pub function (s: LowerState) slot_map_type(name: string): string {
    var sl: i32 = s.slot_of(name);
    if (sl < 0 || s.is_arr_slot(sl)) { return ""; }
    var t: string = s.map_type_of(sl);
    if (is_map_type_name(t)) { return t; }
    return "";
}

// expr_map_kind reports a map EXPRESSION's key kind — 1 for i32 keys, 0 for
// string keys, -1 if `e` is not a map. Unlike map_type_of (which only types a
// map LOCAL slot), this recognises the chained map-construction expressions a
// `Map { k: v, … }` literal desugars to: `map_new[_i32](n).insert(k0,v0)
// .insert(k1,v1)…`. `map_new` fixes the key kind (string), `map_new_i32` (i32),
// and an `.insert` / `.set` / `.delete` mutator returns the same map — so the
// kind propagates up the chain. Lets `.insert` on a map-typed call result lower
// through the IR (#2884 follow-up: Map literals), not just on a bare local.
pub function expr_map_kind(e: ast.Expr, s: LowerState): i32 {
    match (e) {
        ast.ExprIdent(id) => {
            var mt: string = s.map_type_of(s.slot_of(id.name));
            if (mt != "") { return map_key_kind_of(mt); }
            return 0 - 1;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "map_new" && c.args.len() == 1) { return 0; }
                    if (cid.name == "map_new_i32" && c.args.len() == 1) { return 1; }
                    return 0 - 1;
                },
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "insert" || cfa.field == "set" || cfa.field == "delete") {
                        var base: i32 = expr_map_kind(cfa.obj, s);
                        // `map_new` is BOTH the string constructor and what the
                        // parser falls back to when it cannot classify the keys,
                        // so a 0 off a literal's chain is only a guess. The key
                        // argument is the typed answer it could not give.
                        if (base == 0 && map_lit_ctor_root(cfa.obj) && c.args.len() >= 1
                                && map_key_int_evidence(c.args[0], s)) {
                            return 1;
                        }
                        return base;
                    }
                    return 0 - 1;
                },
                _ => { return 0 - 1; }
            }
        },
        // A map ELEMENT of a map-array (`ms[i]`) — the kind sibling of
        // expr_map_type_tag's ExprIndex arm (#5986): slot walk first, the
        // checker-stamped ix.ty filling its holes.
        ast.ExprIndex(kix) => {
            match (kix.array) {
                ast.ExprIdent(kaid) => {
                    var kasl: i32 = s.slot_of(kaid.name);
                    if (kasl >= 0 && s.is_arr_slot(kasl)) {
                        var kmt: string = s.map_type_of(kasl);
                        if (kmt != "") { return map_key_kind_of(kmt); }
                    }
                },
                _ => {}
            }
            if (is_map_type_name(kix.ty)) { return map_key_kind_of(kix.ty); }
            return 0 - 1;
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

// map_lit_ctor_root reports whether `e` is a `Map { … }` literal's desugared
// constructor chain: a bare `map_new` / `map_new_i32` call, or an `.insert` /
// `.set` / `.delete` on one. A map LOCAL's chain roots at an IDENT instead, and
// its declared `Map[K, V]` is authoritative, so that answers false.
function map_lit_ctor_root(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    return (cid.name == "map_new" || cid.name == "map_new_i32") && c.args.len() == 1;
                },
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "insert" || cfa.field == "set" || cfa.field == "delete") {
                        return map_lit_ctor_root(cfa.obj);
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => {}
    }
    return false;
}

// map_key_int_evidence reports POSITIVE evidence that a `Map { … }` literal's
// KEY is an integer rather than a string.
//
// The parser desugars the literal to `map_new[_i32](n).insert(k, v)…` and picks
// the constructor — which is what carries the key kind through every backend —
// from the key expressions' SYNTAX, because it has no types. A key set of bare
// identifiers is unclassifiable there and falls back to `map_new`, the STRING
// constructor; the integer keys then reach __fern_map_set's string compare,
// which dereferences each as a pointer. That is a SIGSEGV at construction with
// no read of the map anywhere (#6207's residue, #7438).
//
// EVIDENCE only, never a default: an unresolvable key keeps whatever the
// constructor spelled, so a string key this cannot type is never flipped to
// integer. A composite (struct / enum) key answers false too — its own override
// respells the tag and selects kind 2.
function map_key_int_evidence(k: ast.Expr, s: LowerState): boolean {
    if (expr_is_str(k, s)) { return false; }
    if (expr_struct_type(k, s) != "") { return false; }
    match (k) {
        ast.ExprNumber(_) => { return true; },
        ast.ExprIdent(kid) => {
            var ksl: i32 = s.slot_of(kid.name);
            if (ksl < 0) { return false; }
            if (s.is_i64_slot(ksl) || s.is_u32_slot(ksl) || s.is_u64_slot(ksl)) { return true; }
            return s.is_i32_scalar_slot(ksl);
        },
        // A CALL key resolves off the checker's stamped result type (#5531)
        // where the annotate pass ran; "" (the asm / wasm drivers) is no
        // evidence and keeps the constructor's kind.
        ast.ExprCall(kc) => { return is_int_irtag(kc.ty); },
        // An ELEMENT key `xs[i]`. Written by hand it is rare, but the lift pass
        // makes it the common shape: a mutable local a closure captures is boxed
        // into a one-element cell and every read rewritten to `$cell$x[0]`, so an
        // integer key SPELLED as a bare ident reaches here as an index (#8090).
        ast.ExprIndex(kix) => {
            if (is_int_irtag(kix.ty)) { return true; }
            return arr_elem_is_int(kix.array, s);
        },
        _ => { return false; }
    }
    return false;
}

// arr_elem_is_int reports POSITIVE evidence that indexing `a` reads an INTEGER
// element — the element-axis counterpart of is_i32_scalar_slot, which answers
// the same question about a slot's own value.
//
// Positive only, for map_key_int_evidence's reason: an array this cannot type
// answers false, so a string[] element is never flipped to an integer key.
function arr_elem_is_int(a: ast.Expr, s: LowerState): boolean {
    match (a) {
        ast.ExprIdent(aid) => {
            var asl: i32 = s.slot_of(aid.name);
            if (asl < 0 || asl >= s.locals.len()) { return false; }
            if (!s.is_arr_slot(asl) && !s.is_i64arr_slot(asl)) { return false; }
            if (s.is_strarr_slot(asl)) { return false; }
            if (s.is_f64arr_slot(asl)) { return false; }
            if (s.is_closurearr_slot(asl)) { return false; }
            if (s.is_fnarr_slot(asl)) { return false; }
            if (s.is_arrarr_slot(asl)) { return false; }
            // An array of structs / enums records its ELEMENT type here, a map
            // array its element Map[K, V], a tuple array its element tags — each
            // a pointer element, none of them an integer.
            if (s.struct_type_of_slot(asl).len() > 0) { return false; }
            if (s.opt_type_of_slot(asl).len() > 0) { return false; }
            if (s.map_type_of(asl).len() > 0) { return false; }
            if (s.locals[asl].tuple_elems.len() > 0) { return false; }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// is_int_irtag reports whether an irlower type tag names an integer scalar.
function is_int_irtag(t: string): boolean {
    return t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "u8" || t == "boolean";
}

// expr_map_type_tag returns the full "Map[K, V]" type of a map EXPRESSION — a
// `Map { … }` literal's `map_new[_i32](n).insert(…)` desugar chain, or a map-
// typed local that already carries a full tag — or "" if `e` is not a map. K
// comes from expr_map_kind (1 = i32, 0 = string); V from the outermost
// `.insert`'s value arg (string if that arg is a string, else i32). Mirrors the
// unannotated map-binding inference in lower_stmt so a map in a NON-local
// position (a tuple element) recovers a tag is_map_type_name / map_key_kind_of /
// map_value_of accept. #3317.
pub function expr_map_type_tag(e: ast.Expr, s: LowerState): string {
    // typed-IR (#5531): a map-returning call carries its full "Map[K, V]" tag on
    // c.ty, so read it instead of re-deriving via the map_ret_fns registry.
    // Guarded to a well-formed Map[…] tag; anything else falls through to the
    // structural walk below (which also covers map locals and struct fields).
    match (e) {
        ast.ExprCall(mc0) => { if (is_map_type_name(mc0.ty)) { return mc0.ty; } },
        _ => {}
    }
    // A map-typed local already carries its full tag — reuse it directly.
    match (e) {
        ast.ExprIdent(mid) => {
            var lt: string = s.slot_map_type(mid.name);
            if (lt != "") { return lt; }
        },
        // A Map-typed struct FIELD (`r.caps` where `caps: Map[K, V]`) or tuple
        // element: recover the declared Map[K, V], so a map op on it
        // (`r.caps.get(k)` / `.len()` / …) resolves its K/V instead of falling
        // through to the scalar tag. fa_type_tag backs the declaration walk with
        // the checker-stamped tag (#5986), which is itself the canonical
        // "Map[K, V]" spelling this reads.
        ast.ExprFieldAccess(mfa) => {
            var fmt: string = fa_type_tag(mfa, s);
            if (is_map_type_name(fmt)) { return fmt; }
        },
        // A map ELEMENT of a map-array (`ms[i]`): the (is_arr) slot's map
        // column records the ELEMENT map type; the checker-stamped ix.ty fills
        // the walk's holes (a call-result array, an IIFE) with the same
        // canonical "Map[K, V]" spelling (#5986).
        ast.ExprIndex(mix) => {
            match (mix.array) {
                ast.ExprIdent(mixid) => {
                    var mixsl: i32 = s.slot_of(mixid.name);
                    if (mixsl >= 0 && s.is_arr_slot(mixsl)) {
                        var mixt: string = s.map_type_of(mixsl);
                        if (is_map_type_name(mixt)) { return mixt; }
                    }
                },
                _ => {}
            }
            if (is_map_type_name(mix.ty)) { return mix.ty; }
        },
        _ => {}
    }
    // A call to a map-RETURNING function (`(mk(), 3)` / `(f.mk(), 3)` — the
    // tuple-element sibling of the unannotated `var m = f()` inference):
    // recover the full Map[K, V] from the map_ret_fns registry
    // ("name|Map[K,V]" for free fns, "<BaseType>.<method>|Map[K,V]" for
    // methods, the receiver type resolved via expr_struct_type). This was
    // #3317's missing arm — without it a call-built map element fell through
    // to the scalar "i32" tag and a later `t.N.get_or(…)` / `t.N.len()`
    // mis-dispatched (silently returning the -1 unknown-method shim).
    var mrkey: string = "";
    match (e) {
        ast.ExprCall(mrc) => {
            match (mrc.callee) {
                ast.ExprIdent(mrcid) => { mrkey = mrcid.name; },
                ast.ExprFieldAccess(mrfa) => {
                    var mrrt: string = expr_struct_type(mrfa.obj, s);
                    if (mrrt != "") { mrkey = mrrt + "." + mrfa.field; }
                },
                _ => {}
            }
        },
        _ => {}
    }
    if (mrkey != "" && sig_reg_has_name(s.sigs.map_ret_fns, mrkey)) {
        return sig_reg_value_of(s.sigs.map_ret_fns, mrkey);
    }
    var kk: i32 = expr_map_kind(e, s);
    if (kk < 0) { return ""; }
    var ktag: string = "string";
    if (kk == 1) { ktag = "i32"; }
    var vtag: string = "i32";
    match (e) {
        ast.ExprCall(vc) => {
            match (vc.callee) {
                ast.ExprFieldAccess(vfa) => {
                    if (vfa.field == "insert" && vc.args.len() == 2) {
                        if (expr_is_str(vc.args[1], s)) { vtag = "string"; }
                        // A 64-bit insert value (a u64/i64 cast, a wide literal,
                        // a 64-bit local) makes the inferred V 64-bit, so an
                        // UNANNOTATED `var m = Map { 1: big }` binding records a
                        // 64-bit value tag and the get_or read side width/sign-
                        // tracks it — without this the slot recorded
                        // `Map[K, i32]` and a chained `m.get_or(...) >> 58`
                        // lowered 32-bit signed on the IR path (#5253 follow-up).
                        else if (expr_is_u64(vc.args[1], s)) { vtag = "u64"; }
                        else if (expr_is_f64(vc.args[1], s)) { vtag = "f64"; }
                        else if (infer_expr_width(vc.args[1], s) == 64) { vtag = "i64"; }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "Map[" + ktag + ", " + vtag + "]";
}

// insert_value_is_ptr: does the map-insert VALUE expr `e` produce a heap POINTER
// (string / struct / string-array)? It drives the wasm `vis` flag —
// $__fern_map_set retains a pointer value and $__fern_map_release deep-releases
// it. Mirrors the wasm AST path's `is_string_expr || struct || array` check. Used
// at the insert-lowering sites IN ADDITION to the receiver-derived map value
// type, because the FIRST insert of a chain (`map_new_i32().insert(k, v)`) has a
// receiver whose value type isn't inferred yet (bare map_new → defaults to i32),
// so a string value there would otherwise emit vis=0 and leak — its box is then
// never freed by $__fern_map_release (the #4353 wasm-IR value-release gap).
// map_value_wide (#5253): the map's VALUE column is an 8-byte scalar, so its
// values() column elements read with the 8-byte arr_get forms and the
// op_map_values op carries the valwide flag (which keeps such modules off the
// i32-celled wasm map runtime — wasm_ir_deferrals_ok).
function map_value_wide(vt: string): boolean {
    return vt == "i64" || vt == "u64" || vt == "f64";
}

// map_value_widekind (#5253): 8-byte VALUE-column discriminator for the map ops
// that the wasm IR path handles differently per width — 0 narrow (i32/pointer),
// 1 i64/u64 (wasm boxes an 8-byte cell into the i32 column), 2 f64 (wasm defers
// to AST). The register backends store 8-byte regardless and ignore it.
function map_value_widekind(vt: string): i32 {
    if (vt == "i64" || vt == "u64") { return 1; }
    if (vt == "f64") { return 2; }
    return 0;
}

// get_or_recv_map_type (#5253 follow-up): resolve the Map[K, V] type of a
// `.get_or(k, d)` RECEIVER for the width/sign predicates (infer_expr_width /
// expr_is_u64 / lower_i64), mirroring the receiver shapes the map-op LOWERING
// itself dispatches on. expr_map_type_tag covers a map-typed local, a
// map-returning call, and a literal chain — but NOT a Map struct field
// (`c.m.get_or(...)`), a map tuple element, or a map array element, so a
// 64-bit-valued read through those receivers width-tracked 32 and a chained
// shift picked the SIGNED form even though the lowering site stored/read the
// column full-width (a silent on-IR miscompile). Returns "" when the receiver
// isn't a map.
function get_or_recv_map_type(obj: ast.Expr, s: LowerState): string {
    var mt: string = expr_map_type_tag(obj, s);
    if (is_map_type_name(mt)) { return mt; }
    match (obj) {
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (is_map_type_name(tt)) { return tt; }
            } else {
                var oty: string = expr_struct_type(fa.obj, s);
                if (oty != "") {
                    var ft: string = decl_field_type(s.structs, oty, fa.field);
                    if (is_map_type_name(ft)) { return ft; }
                }
            }
        },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (asl >= 0 && s.is_arr_slot(asl) && is_map_type_name(s.map_type_of(asl))) { return s.map_type_of(asl); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "";
}

// map_value_slot_tag maps a map's declared VALUE type onto the tuple-element tag
// vocabulary, with the same normalisation elem_type_tag's own arms perform: u64
// rides the "i64" slot, boolean / u8 / u32 the "i32" one, and f32 keeps its own
// tag so its method dispatch does not render at f64 precision. "" for a V the
// element machinery cannot carry in one tagged slot — an array, a struct, a
// nested map, an unparseable or generic column.
function map_value_slot_tag(v: string): string {
    if (v == "string") { return "string"; }
    if (v == "f32") { return "f32"; }
    if (elem_ty_is_f64slot(v)) { return "f64"; }
    if (elem_ty_is_i64slot(v)) { return "i64"; }
    if (v == "i32" || v == "u32" || v == "u8" || v == "boolean" || v == "bool") { return "i32"; }
    return "";
}

// map_method_elem_tag names the tuple-element tag of a map READ method's result —
// "i32" for `len` and `has`, the value column's slot tag for `get_or`, and
// "Option[V]" for `get` — or "" when `e` is not one of those calls, the receiver
// is not a map, or V has no tag the element machinery can carry.
//
// `keys` / `values` answer through the array predicates already, and `iter` stays
// out: its MapIter box holds a raw pointer into the mapbox, which a tuple slot
// would outlive. `get`'s payload set is opt_elem_tag_from_ty's, so an admitted
// Option element is one a later `match (t.N)` can unwrap.
//
// elem_type_tag (what the slot is stored as) and tuple_elem_ctor_eligible
// (whether the element is admitted at all) share it, so an admitted map method
// always has a tag naming its result — the two cannot drift into storing a
// `Map[K, string]` read in an "i32" slot. #7213.
function map_method_elem_tag(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    var mt: string = get_or_recv_map_type(fa.obj, s);
                    if (mt == "") { return ""; }
                    if (fa.field == "len" && c.args.len() == 0) { return "i32"; }
                    if (fa.field == "has" && c.args.len() == 1) { return "i32"; }
                    var vt: string = map_value_slot_tag(map_value_of(mt));
                    if (vt == "") { return ""; }
                    if (fa.field == "get_or" && c.args.len() == 2) { return vt; }
                    if (fa.field == "get" && c.args.len() == 1) { return "Option[" + vt + "]"; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

function insert_value_is_ptr(e: ast.Expr, s: LowerState): boolean {
    if (expr_is_str(e, s)) { return true; }
    if (expr_struct_type(e, s).len() > 0) { return true; }
    if (expr_is_strarr(e, s)) { return true; }
    // Any ARRAY literal (#4353 item 3). Without this a `Map { k: [a, b] }` chain —
    // whose FIRST insert has the bare map_new receiver, so map_value_is_ptr sees
    // the i32 default — emitted vis=0 and $__fern_map_release never released the
    // value column at all. The string / struct arms above are the same hole,
    // already patched; a scalar-element array was the one value form left out.
    match (e) { ast.ExprArray(_) => { return true; }, _ => {} }
    return false;
}

// map_read_aliases_arr_value: `<recv>.get(k)` / `<recv>.get_or(k, d)` where the
// receiver is a map whose VALUE column is an array type — the read the comment at
// the alias_inc site describes. `get_or`'s DEFAULT operand is irrelevant here: the
// slot is retained either way, and a fresh default literal handed back instead
// simply carries one extra count (a leak at worst, never a dangle).
function map_read_aliases_arr_value(fa: ast.ExprFieldAccess, nargs: i32, s: LowerState): boolean {
    if (fa.field == "get" && nargs != 1) { return false; }
    if (fa.field == "get_or" && nargs != 2) { return false; }
    if (fa.field != "get" && fa.field != "get_or") { return false; }
    return map_value_type_is_arr(map_value_of(expr_map_type_tag(fa.obj, s)));
}

// map_insert_value_consumed (#4353 item 3): the map-insert VALUE is a FRESH
// pointer temp this frame solely owns, so the wasm $__fern_map_set must TAKE its
// single ref (vconsume) rather than retaining it — the retain would be unbalanced
// and the box leaks by one. Strings answer through is_fresh_str_temp; an ARRAY or
// STRUCT literal is the box-shaped twin (nothing else can name an anonymous
// literal). The register backends ignore vconsume; their column reclaim is the
// MAPVS: / MAPVA: credit instead.
function map_insert_value_consumed(e: ast.Expr, s: LowerState): boolean {
    if (is_fresh_str_temp(e, s)) { return true; }
    match (e) {
        ast.ExprArray(_) => { return true; },
        ast.ExprStructLit(sl) => { return !sl.has_base; },
        _ => {}
    }
    return false;
}

// map_insert_value_retains (#6880): the map-insert VALUE is an ALIASED array,
// so the register __fern_map_set — which stores the value pointer with no
// rc-inc of its own — owes it a retain. The frame keeps a counted reference to
// every array LOCAL and releases it in the exit dec-sweep unconditionally
// (emit_dec_sweep_except_list decs every is_arr_slot), so an unretained store
// leaves the map's value column pointing at a buffer the sweep frees, and the
// next allocation of that size class hands the block out again underneath it.
// A `Map[string, string[]]` built by a helper — `var a = [v]; return
// m.insert(k, a);` — is the shape that reads back as an empty value array with
// no over-release reported: the map's alias was never counted, so the rc
// machinery cannot see it.
//
// Alias shapes only: a literal or a call result is a FRESH sole-owned value
// that transfers its rc=1 to the map, and retaining one would leak. The shapes
// and the array-only restriction mirror the native oracle's
// emitMapSetValueRetain (needsRcIncOnAlias plus mapValKindTag >= 2).
function map_insert_value_retains(e: ast.Expr, vtype: string, s: LowerState): boolean {
    match (e) {
        ast.ExprIdent(id) => {
            if (map_value_type_is_arr(vtype)) { return true; }
            var vsl: i32 = s.slot_of(id.name);
            return vsl >= 0 && s.is_arr_slot(vsl);
        },
        ast.ExprFieldAccess(_) => { return map_value_type_is_arr(vtype); },
        ast.ExprIndex(_) => { return map_value_type_is_arr(vtype); },
        _ => { return false; }
    }
    return false;
}

// map_value_type_is_arr: the "Map[K, V]" value type V names an ARRAY. An
// unparsed / generic column ("" or a bare type var) reads false, which keeps
// its inserts on the historical unretained store.
function map_value_type_is_arr(vtype: string): boolean {
    if (vtype.len() < 2) { return false; }
    return slice_unchecked(vtype, vtype.len() - 2, vtype.len()) == "[]";
}

// map_insert_val_is_i64: should a map insert/set VALUE (or a get_or DEFAULT) be
// lowered as an 8-byte i64/u64? The map's declared value type (map_value_of)
// answers when the receiver's tag is known, but the FIRST insert of a `Map { … }`
// literal chain has a receiver whose value type isn't inferred yet (bare
// map_new → i32 default — see insert_value_is_ptr's note), so also treat a
// 64-bit-width value EXPRESSION (`5000000007`, an i64/u64 local) as i64. Without
// this the value lowered as op_const_i32 and TRUNCATED to 32 bits before the
// 8-byte store (#5253 symptom 1). f64 values ride their own path, not this one.
function map_insert_val_is_i64(mtype: string, e: ast.Expr, s: LowerState): boolean {
    var vt: string = map_value_of(mtype);
    if (vt == "i64" || vt == "u64") { return true; }
    return infer_expr_width(e, s) == 64 && !expr_is_f64(e, s);
}

pub function (s: LowerState) mark_i64(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_i64(s.locals[i], v)) };
}
pub function (s: LowerState) is_i64_slot(i: i32): boolean {
    if (i < 0) { return false; }
    // u64 lives in the i64 64-bit domain: a u64 SCALAR slot is i64-wide (its
    // unsigned ops are selected separately via is_u64_slot / expr_is_u64). So a
    // slot is "i64" for width/lowering purposes if it's marked i64 OR u64 — but
    // NOT when it is an ARRAY slot: a u64[] slot holds an array POINTER (i32 on
    // wasm32), not a 64-bit scalar, and its u64-ness is about its ELEMENTS (read
    // 8-byte via is_i64arr, unsigned via is_arr && is_u64). Declaring such a slot
    // a 64-bit local would type the pointer as i64 and the wasm verifier rejects
    // the array-make (i32 pointer into an i64 local). The element width/signedness
    // is handled at the element read, independent of the slot's own width.
    if (i < s.locals.len() && s.locals[i].is_arr) { return false; }
    if (i < s.locals.len() && s.locals[i].is_u64) { return true; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_i64;
}
// is_i32_scalar_slot reports whether slot i holds a 32-bit (or sub-32) INTEGER
// scalar — a plain i32, a u32, or a subword (bool/u8) — but NOT
// i64/u64, NOT a float, and NOT any heap/pointer type (string, array of any
// kind, struct, Option/Result, tuple, map). It gates the implicit i32->i64
// widening in lower_i64's ExprIdent leaf: such a leaf can be sign/zero-extended
// into an i64 context (`s64 + i`, a for-range loop var accumulated into an i64)
// instead of bailing the whole module. The extend's signedness
// is chosen by the caller (is_u32_slot -> zero-extend; otherwise sign-extend,
// which is also correct for a subword already loaded sign-correct in 32 bits).
pub function (s: LowerState) is_i32_scalar_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (s.is_i64_slot(i)) { return false; }
    if (s.is_f64_slot(i)) { return false; }
    if (s.is_f32_slot(i)) { return false; }
    if (s.is_str_slot(i)) { return false; }
    if (s.is_strarr_slot(i)) { return false; }
    if (s.is_arr_slot(i)) { return false; }
    if (s.is_f64arr_slot(i)) { return false; }
    if (s.is_i64arr_slot(i)) { return false; }
    if (s.is_closurearr_slot(i)) { return false; }
    if (s.is_fnarr_slot(i)) { return false; }
    if (s.is_arrarr_slot(i)) { return false; }
    // A u32 SCALAR slot (arrays already excluded above) is a 32-bit integer
    // scalar even though some var-decl paths spuriously record its type tag in
    // local_struct_type ("u32"); is_u32_slot is the authoritative signal, so
    // admit it before the struct/opt/tuple/map heap-type exclusions below — those
    // would otherwise reject it on the bogus "u32" struct tag, bailing `u64 + u32`
    // (the only context an unsigned 32-bit leaf can appear; the checker forbids
    // i64 + u32).
    if (s.is_u32_slot(i)) { return true; }
    if (s.struct_type_of_slot(i).len() > 0) { return false; }
    if (s.opt_type_of_slot(i).len() > 0) { return false; }
    if (i < s.locals.len() && s.locals[i].tuple_elems.len() > 0) { return false; }
    if (i < s.locals.len() && s.locals[i].map_type.len() > 0) { return false; }
    return true;
}
pub function (s: LowerState) mark_f64(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f64(s.locals[i], v)) };
}
pub function (s: LowerState) is_f64_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f64;
}
// mark_f32 / is_f32_slot query and set whether slot i holds an f32 value (a
// strict overlay on is_f64: an f32 slot is ALSO is_f64 for storage/arith, but
// carries the f32 type tag for "f32.<method>" dispatch). Mirrors mark_f64.
pub function (s: LowerState) mark_f32(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f32(s.locals[i], v)) };
}
pub function (s: LowerState) is_f32_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f32;
}
// is_f64arr_slot / mark_f64arr query and set whether slot i holds an f64[]
// array (8-byte element width on wasm). The element-width driver for a[i].
// mark_f32arr / is_f32arr_slot: the f32[] dispatch overlay — see LocalInfo.
pub function (s: LowerState) mark_f32arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f32arr(s.locals[i], v)) };
}
pub function (s: LowerState) is_f32arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f32arr;
}

pub function (s: LowerState) is_f64arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f64arr;
}
pub function (s: LowerState) mark_f64arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f64arr(s.locals[i], v)) };
}
// is_i64arr_slot / mark_i64arr query and set whether slot i holds an i64[]
// array (8-byte i64 elements). The driver for a[i] -> arr_get_i64.
pub function (s: LowerState) is_i64arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_i64arr;
}
pub function (s: LowerState) mark_i64arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_i64arr(s.locals[i], v)) };
}

// is_closurearr_slot / mark_closurearr query and set whether slot i holds a
// closure[] (array of function values). Drives the closure-typing of a local
// bound from such an array's element so `c()` unpacks the closure box.
pub function (s: LowerState) is_closurearr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_closurearr;
}
pub function (s: LowerState) mark_closurearr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_closurearr(s.locals[i], v)) };
}
// is_fnarr_slot / mark_fnarr query and set whether slot i holds a PLAIN-fn-pointer
// array (`(() => T)[]` of bare named-fn values). Parallels is_closurearr_slot but
// drives PLAIN call_indirect dispatch (not env-first): a `.append(f)` of a bare
// 0-arg fn name onto such a slot emits const_func (the pointer) instead of
// const-calling f. (#3574)
pub function (s: LowerState) is_fnarr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_fnarr;
}
pub function (s: LowerState) mark_fnarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_fnarr(s.locals[i], v)) };
}
// is_arrarr_slot / mark_arrarr query and set whether slot i holds an array-of-
// arrays (`T[][]`), so a local bound from its element a[i] is typed is_arr.
pub function (s: LowerState) is_arrarr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_arrarr;
}
pub function (s: LowerState) mark_arrarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_arrarr(s.locals[i], v)) };
}
// arrarr_elem_of_slot / mark_arrarr_elem query and set the INNER element kind of a
// T[][] slot ("i64"/"f64"/""), so a nested read a[i][j] can pick the 8-byte load
// for an i64/f64 inner element instead of truncating to 32 bits (#2691).
pub function (s: LowerState) arrarr_elem_of_slot(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].arrarr_elem;
}
pub function (s: LowerState) mark_arrarr_elem(i: i32, kind: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_arrarr_elem(s.locals[i], kind)) };
}

// variant_enum_owner returns the enum a variant struct belongs to
// (StructDecl.enum_owner, set when the parser desugars an enum's variants),
// or "" if `name` isn't a known enum variant. Lets the IR path recover a
// freshly-constructed variant's enum type for `<Enum>.<method>` dispatch.
//
// FIRST match wins, and variant decls are keyed by the BARE name, so this
// cannot answer for a name two enums both declare. Anywhere the enum is
// already known — a qualified `Enum.Variant` — use variant_decl_index.
pub function variant_enum_owner(structs: parser.StructDecl[], name: string): string {
    for sd in structs {
        if (sd.name == name) { return sd.enum_owner; }
    }
    return "";
}

// variant_decl_index returns the index in `structs` of the variant `name`
// declared by enum `owner`, or -1. Two enums may declare the same variant
// name, so a qualified `Enum.Variant` has to ask whether such a decl EXISTS
// rather than whether the first decl of that name happens to be the right
// one — the flat, bare-keyed table cannot answer the latter correctly. The
// index is what callers then read fields through, since the by-name
// accessors are first-match too.
pub function variant_decl_index(structs: parser.StructDecl[], name: string, owner: string): i32 {
    var vi: i32 = 0;
    while (vi < structs.len()) {
        if (structs[vi].name == name && structs[vi].enum_owner == owner) { return vi; }
        vi = vi + 1;
    }
    return 0 - 1;
}

// expr_enum_type returns the enum type an expression evaluates to when it is a
// variant CONSTRUCTION (`Has(x)` — a call to a variant name) or a bare unit
// variant (`A`, not a local), else "". Used to dispatch a method called
// directly on a freshly-constructed variant (`Has(5).eq(…)`) to
// `<Enum>.<method>`; an enum value held in a LOCAL is already typed via the
// slot's struct_type, so this only covers the fresh-construction receiver.
pub function expr_enum_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => { return variant_enum_owner(s.structs, id.name); },
                // Qualified payload construction `Enum.Variant(args)` — the
                // variant is the field, confirmed against the bare enum name.
                ast.ExprFieldAccess(cfa) => { return qualified_variant_enum(cfa, s); },
                // An enum-valued if-/match-EXPRESSION (`var c = if (b) {
                // Circle(2) } else { Square(3) }`) stays an inline 0-arg IIFE —
                // its variant constructors read as captures, so lift_lambdas
                // leaves it as ExprLambda. Its enum type is the leaf branch's
                // variant owner (iife_leaf_value unwraps any nesting), so the
                // bound local types as the enum and `c.method()` dispatches.
                ast.ExprLambda(_) => { return expr_enum_type(iife_leaf_value(e), s); },
                _ => { return ""; }
            }
        },
        ast.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return variant_enum_owner(s.structs, id.name); }
            return "";
        },
        // Qualified UNIT variant `Enum.Variant` (no call) — e.g. `Dir.N`. Without
        // this an unannotated `var d = Dir.N` left d untyped, so `d.method()` and
        // `Dir.N.method()` couldn't dispatch to `<Enum>.<method>` and bailed to AST.
        ast.ExprFieldAccess(fa) => { return qualified_variant_enum(fa, s); },
        _ => { return ""; }
    }
    return "";
}

// qualified_variant_enum resolves `Enum.Variant` (a field access whose field is
// a variant and whose object is the bare owning enum name, not a local) to the
// enum name, else "".
function qualified_variant_enum(fa: ast.ExprFieldAccess, s: LowerState): string {
    var owner: string = variant_enum_owner(s.structs, fa.field);
    if (owner == "") { return ""; }
    match (fa.obj) {
        ast.ExprIdent(eid) => {
            if (eid.name == owner && s.slot_of(eid.name) < 0) { return owner; }
        },
        _ => {}
    }
    return "";
}

// ---- struct decl helpers -----------------------------------------------
// The core lookups take the decl array directly (so lower_func can use them
// while building its initial state); the LowerState methods delegate.
// decl_field_index returns a field's position in DECL order (-1 if absent);
// decl_is_struct reports whether `name` is a declared struct.
pub function decl_is_struct(structs: parser.StructDecl[], name: string): boolean {
    for sd in structs {
        if (sd.name == name) { return true; }
    }
    return false;
}

// dyn_arm_matches decodes an op_dyn_dispatch `tag` into the trait set and
// method it carries and asks parser.dyn_arm_matches — the shared reading of
// claim_method_name's namespace — whether `fd` is the definition this dispatch
// must call for fd's OWN receiver type.
pub function dyn_arm_matches(fd: parser.FuncDecl, tag: string, funcs: parser.FuncDecl[]): boolean {
    return parser.dyn_arm_matches(fd, ir.dyn_dispatch_traits(tag), ir.dyn_dispatch_method(tag), funcs);
}

// display_arg wraps a `print` / `write` / `eprint` argument in `.to_string()`
// when it is a STRUCT value — the lowering half of native's Display spine
// (#2696), whose checker rewrites the same three builtins' sole argument.
//
// The test is "positively a struct", NOT "not provably a string". expr_is_str
// is a conservative prover: it says false for a string it cannot trace, such as
// a `m.get_or(k, d)` result or a call through a closure. Rewriting on its
// negative answer wrapped those in `.to_string()`, which has an i32 fallback,
// so the string's POINTER was formatted as a decimal — `write(g())` printed
// "40" for "hi". A struct type recovered by expr_struct_type is the positive
// signal, and every other shape lowers exactly as it did before.
function display_arg(e: ast.Expr, line: i32, col: i32, s: LowerState): ast.Expr {
    if (expr_struct_type(e, s).len() == 0) { return e; }
    return ast.ExprCall {
        callee: ast.ExprFieldAccess { obj: e, field: "to_string", line: line, col: col, ty: "" },
        args: [],
        line: line,
        col: col,
        type_argc: 0,
        ty: "string"
    };
}

// decl_is_enum reports whether `name` is a declared enum — i.e. some decl records
// it as its enum_owner (the variants of `name` are stored in `structs` with
// enum_owner == name). Precise (unlike the loose syntactic is_enum_like_name): it
// cannot misfire on a primitive / struct / generic, and a bracketed Option[T] /
// Result[T] field spelling never equals a bare enum_owner. False in the standalone
// bootstrap where imported enums aren't loaded → the field is treated leak-only
// (no construction inc, no drop) → balanced/sound. #4297 A2: drives the direct
// enum-field exit-reclaim (gate + construction inc + the k_enum struct-drop arm).
pub function decl_is_enum(structs: parser.StructDecl[], name: string): boolean {
    if (name.len() == 0) { return false; }
    for sd in structs {
        if (sd.enum_owner == name) { return true; }
    }
    return false;
}

pub function decl_field_index(structs: parser.StructDecl[], struct_name: string, field: string): i32 {
    for sd in structs {
        if (sd.name == struct_name) {
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == field) { return fi; }
                fi = fi + 1;
            }
            return 0 - 1;
        }
    }
    return 0 - 1;
}

// decl_is_leaksafe reports whether every field is an i32/boolean OR a string.
// These are all leak-only types in the IR path — strings are never freed, so a
// struct holding one keeps a valid reference for the program's life — so such a
// struct needs NO reference counting (matching the AST path's exit codes; the
// boxes leak). Array / nested-struct / tuple fields would be RC-tracked (freed),
// so a struct holding one needs construction retains + drop release — deferred.
// is_scalar_array_type reports whether `t` is a scalar-element array (i32[] /
// boolean[]) — leak-only-safe as a struct field: indexing yields an i32, and the
// array (a fresh literal at construction) leaks with the struct (never freed),
// so no reference counting is needed. String / struct element arrays need
// element tracking (their elements are heap values), so they stay deferred.
pub function is_scalar_array_type(t: string): boolean {
    return t == "i32[]" || t == "boolean[]";
}

// is_leaksafe_array_field reports whether `t` is an array type that is leak-safe
// AS A STRUCT FIELD: the scalar-element arrays (i32[]/boolean[]), the 4-byte
// u32[], the sub-word u8[] (is_subword_array_type), and the
// 8-byte-element f64[]/i64[]. All store a pointer in the field slot, are owned
// by the struct (a fresh array literal at construction — is_scalar_arr_field_
// access bails the aliasing forms), and are deep-dropped on the struct's
// reclamation. u32[] / the sub-word array ride the i32[] 4-byte element read
// unchanged (each element lives in a full 32-bit slot, pre-wrapped by the `as
// u8` cast at the producing site); their narrowness only affects arithmetic ON
// a read element, not the field round-trip. NOT here: u64[] (its 8-byte element
// read needs the i64-width dispatch routed through the "u64[]" field tag — like
// the u64 tuple element slice — a separate increment). NOT used for enum
// payloads (those need the element-width mark, not a plain mark_arr).
pub function is_leaksafe_array_field(t: string): boolean {
    return is_scalar_array_type(t) || is_float_array_type_name(t) || t == "i64[]" || t == "u32[]"
        || is_subword_array_type(t);
}

// is_float_array_type_name reports whether the declared type name `t` is a
// FLOAT array — one whose elements ride the 8-byte-stride f64 layout that
// mark_f64arr tracks. Both `f64[]` and `f32[]` do: a scalar `f32` lowers to a
// wasm f64, and the array-literal / Cell element paths already fold `f32` in
// with `f64` (`celt == "f64" || celt == "f32"`). Spelling the pair once keeps
// the declaration-driven sites from drifting apart, which is how `f32[]` came
// to be classified as no array kind at all (#6175).
pub function is_float_array_type_name(t: string): boolean {
    return t == "f64[]" || t == "f32[]";
}

// is_subword_array_type reports whether `t` is a sub-32-bit integer-element
// array (u8[]). This rides the SAME 4-byte-slot element
// representation as i32[]: the self-host IR (like the AST emitter) stores each
// element in a full 32-bit slot — op_arr_push / op_arr_get(32) round-trip the
// value at 32-bit width, and the sub-word value is wrapped to its range by the
// cast at the producing site BEFORE the push (the `b as u8` idiom), so the
// stored slot already holds the in-range value. A read yields that same i32
// (the consumer `data[i] as i32` is a no-op zero-extend). So as a struct field
// it is leak-safe exactly like i32[] / u32[] — the buffer is a pointer in
// the field slot, owned by the struct, deep-dropped on reclamation. This admits
// byte-buffer structs (BytesWriter, Stream readers) onto the IR path.
pub function is_subword_array_type(t: string): boolean {
    return t == "u8[]";
}

// is_map_type_name reports whether `t` is a Map[K, V] type. Maps are leak-only
// on the IR path (the exit sweep tracks local_is_arr, not local_map_type — a map
// box is never freed), so a Map-typed struct field leaks with the struct like a
// string / Option / tuple / enum field: no RC, no aliasing bail. Reading the
// field into a `var m: Map[K, V] = c.m` local re-marks the map type from the
// annotation, so the map's get/insert/has/... dispatch keeps working.
pub function is_map_type_name(t: string): boolean {
    return t.len() >= 5 && slice_unchecked(t, 0, 4) == "Map[";
}

// map_elem_of_array_type: the `Map[K, V]` element of a `Map[K, V][]` spelling,
// or "" for anything else — including a bare `Map[K, V]`, which is not an array
// and so has no element.
pub function map_elem_of_array_type(t: string): string {
    if (!is_array_type_name(t)) { return ""; }
    var el: str = slice_unchecked(t, 0, t.len() - 2);
    if (is_map_type_name(el) && !is_array_type_name(el)) { return el + ""; }
    return "";
}

// is_scalar_arr_field_access reports whether `e` reads a scalar-array struct
// field (`v.items` where items: i32[]). Such an array lives inside the struct
// (which leaks), so binding/returning/assigning it would create an alias the
// IR path can't retain (leak-only). Those alias-creating uses therefore bail;
// only direct reads (`v.items[i]`, `v.items.len()`) lower.
// is_struct_array_field_type: a `X[]` where X is a leaf-safe struct (array-of-
// struct field). Admitted to the IR path (construction + `f[i].field` read) but
// NOT deep-dropped yet — the array and its struct elements leak with the struct (a
// recursive-drop follow-up); aliasing it (bind / return / assign) bails, like the
// scalar-array fields, so the leak-only IR never creates a dangling second owner.
pub function is_struct_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 3) { return false; }
    if (slice_unchecked(t, n - 2, n) != "[]") { return false; }
    // Element leaf-safety is guaranteed by the leaksafe gate (decl_is_leaksafe_d,
    // depth-bounded) before any struct admitting this field reaches the IR path, so
    // this only needs to recognise the struct-array shape (no recursion → no cycle).
    return decl_is_struct(structs, slice_unchecked(t, 0, n - 2));
}

// is_enum_array_field_type: a `C[]` where C is a (nominal) enum (array-of-enum
// field). Like the array-of-struct field it is admitted to the IR path in leak
// mode (the array + its enum boxes leak with the struct) and bailed in the
// alias-creating positions (bind / return / assign), so the leak-only IR never
// creates a dangling second owner.
pub function is_enum_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 3) { return false; }
    if (slice_unchecked(t, n - 2, n) != "[]") { return false; }
    return is_enum_like_name(slice_unchecked(t, 0, n - 2), structs);
}

// is_nested_array_field_type: a `T[][]` whose ELEMENT `T[]` is itself an
// admitted array field type (scalar / struct / enum element). Its elements are
// array POINTERS, so the outer buffer rides the same 4-byte-slot layout as an
// i32[] and needs no element-width dispatch. Nothing ever frees it:
// __struct_drop_<T> classifies no arm for a `T[][]` field, so both the outer
// buffer and every row leak with the struct — which is what makes a shallow
// clone of the outer buffer (the `.append` / `.with` value form) sound, since
// the rows it shares with the source are released by neither owner.
//
// ONE level of nesting, matching decl_is_leaksafe_at_d's own admission (which
// calls this): a `T[][][]` field keeps its whole struct off the IR path, so
// recognising it here would classify a receiver that can never be reached.
pub function is_nested_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 5) { return false; }
    if (slice_unchecked(t, n - 2, n) != "[]") { return false; }
    var elt: str = slice_unchecked(t, 0, n - 2);
    return is_leaksafe_array_field(elt) || is_struct_array_field_type(structs, elt)
        || is_enum_array_field_type(structs, elt);
}

// arrarr_elem_kind_of_type: the inner element KIND a `T[][]` spelling records on
// its slot — "i64" / "u64" / "f64" / "string", "arr" for a deeper nesting, or ""
// when the element rides the 4-byte default (i32 and friends). "u64" stays
// DISTINCT from "i64" so a nested read `m[i][j]` chained in an unsigned op picks
// shr_u / lt_u (#5206). Anything that is not a depth-2 array spelling answers "".
pub function arrarr_elem_kind_of_type(t: string): string {
    if (!is_array_type_name(t) || t.len() < 4) { return ""; }
    if (!is_array_type_name(slice_unchecked(t, 0, t.len() - 2))) { return ""; }
    var innr: str = slice_unchecked(t, 0, t.len() - 4);
    if (innr == "i64") { return "i64"; }
    if (innr == "u64") { return "u64"; }
    if (innr == "f64") { return "f64"; }
    if (innr == "string") { return "string"; }
    // A THREE-deep array (`i32[][][]`): the inner element is itself an array,
    // which the scalar kinds above cannot say. "arr" records it so a foreach
    // marking can re-mark the loop var as an array-of-arrays.
    if (is_array_type_name(innr)) { return "arr"; }
    return "";
}

// arrarr_index_elem_kind returns the element KIND that indexing `arr` yields
// when `arr` is ITSELF the index of an array-of-arrays — the recorded slot tag
// for an array-of-array LOCAL (`m[i]`), and the field declaration's for an
// array-of-array struct FIELD (`h.m[i]`), a level no slot records. "" when `arr`
// is not such an index.
//
// The width classifiers read the nesting through this one leaf so the local and
// the field answer identically: while the field half was missing, `h.m[0][0]`
// over an `f64[][]` field read four bytes of a double and every consumer of the
// result then treated it as an integer.
// index_read_is_arr reports whether index expression `e` (`xs[i]`) yields an
// ARRAY value — its container is an array-of-arrays: a T[][] local/param slot,
// a nested-array struct field (`h.m[i]`), or an element of a 3-deep array
// (`m[i][j]` over T[][][], whose recorded inner kind is "arr"). The element
// KIND is irrelevant here (arrarr_elem records "" for the flat scalar kinds);
// this asks only whether the read hands back an rc-counted array pointer.
// ret_is_tuple_elem_dup: the EMISSION entry point of tuple_elem_ret_dup —
// resolves the tuple type off the source slot's tuple_elems (params carry the
// declared type, annotated locals the annotation — the same declarations the
// scans read, so the two entries see one fact). The sibling of
// index_read_is_arr, asked in the same place for the same reason.
function ret_is_tuple_elem_dup(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(id) => {
                    var sl: i32 = s.slot_of(id.name);
                    if (sl < 0 || s.locals[sl].tuple_elems.len() == 0) { return false; }
                    return tuple_elem_ret_dup(e, id.name, "(" + s.locals[sl].tuple_elems + ")");
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function index_read_is_arr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => { return s.is_arrarr_slot(s.slot_of(aid.name)); },
                ast.ExprFieldAccess(_) => { return nested_arr_field_read_type(ix.array, s) != ""; },
                ast.ExprIndex(_) => { return arrarr_index_elem_kind(ix.array, s) == "arr"; },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function arrarr_index_elem_kind(arr: ast.Expr, s: LowerState): string {
    match (arr) {
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => { return s.arrarr_elem_of_slot(s.slot_of(aid.name)); },
                ast.ExprFieldAccess(_) => { return arrarr_elem_kind_of_type(nested_arr_field_read_type(ix.array, s)); },
                _ => { return ""; }
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// is_leaksafe_payload reports whether a payload type is a leak-safe scalar/string.
// u32 rides one full i32 slot exactly like i32 (no narrowing on read), so an
// Option/Result box carrying a u32 stores / reads at the default 32-bit width
// (op_opt_make / op_opt_payload) and the match binding marks the bound slot u32
// so its `>>` is logical and its arithmetic wraps at 2^32. u64 rides the i64
// 8-byte slot: construction already tags a u64 arg "i64" (elem_type_tag's
// infer_expr_width==64 path) so the box stores 8 bytes, and the match binding
// reads via op_opt_payload_w(64) + marks the slot u64 (unsigned, 8-byte). The
// sub-word int (u8) is NOT here: its payload-box read needs
// zero-extension that currently differs across backends (a u8 read
// mis-extends on wasm), so an Option/Result-of-it field is excluded here.
function is_leaksafe_payload(p: string): boolean {
    // f32 / `float` ride the f64 slot (elem_ty_is_f64slot) and are inline
    // scalars in the box with nothing to free, so they are leak-safe on the
    // same reasoning f64 is.
    return p == "i32" || p == "boolean" || p == "string" || p == "i64" || elem_ty_is_f64slot(p)
        || p == "u32" || p == "u64";
}

// is_leaksafe_opt_field: an Option[T] / Result[T, E] field whose payload type(s)
// are leak-safe scalars/strings. Options/Results are leak-only on the IR path (the
// exit sweep never frees them), so such a field needs no RC / aliasing bail — it
// leaks with the struct, like a string field. Struct / nested-generic payloads are
// deferred (they would need payload-type recovery through the field).
pub function is_leaksafe_opt_field(t: string): boolean {
    var n: i32 = t.len();
    if (n < 9) { return false; }
    if (slice_unchecked(t, 0, 7) == "Option[") { return is_leaksafe_payload(opt_payload_type(t, "Some")); }
    if (slice_unchecked(t, 0, 7) == "Result[") {
        return is_leaksafe_payload(opt_payload_type(t, "Ok")) && is_leaksafe_payload(opt_payload_type(t, "Err"));
    }
    return false;
}

// opt_payload_ok_d: an Option/Result payload type is admissible for a leak-safe
// struct field when it is a leak-safe scalar/string OR a leak-safe STRUCT (a
// leak-only pointer in one slot, offset 8 — exactly what the match lowering's
// ptag_is_struct branch reads). Enum payloads are deliberately excluded, held
// out by a negative pin whose rationale no longer holds — see the tail of
// opt_payload_ok_dv.
function opt_payload_ok_d(structs: parser.StructDecl[], p: string): boolean {
    var seen: string[] = [];
    return opt_payload_ok_dv(structs, p, 0, seen);
}

// opt_payload_ok_dv threads the leak-safe proof's depth + visiting set (the
// struct names on the current path) so a struct payload re-enters
// decl_is_leaksafe_d WITH that context, not the fresh decl_is_leaksafe wrapper.
// Without this a self-referential field — `next: Option[Node]` on
// `struct Node` — recursed decl_is_leaksafe_d -> is_leaksafe_opt_field_d ->
// opt_payload_ok_d -> decl_is_leaksafe (fresh, visiting reset) -> … forever,
// SIGSEGV-ing the compiler on a valid linked list / tree. Threading the set lets
// decl_is_leaksafe_d's back-edge check short-circuit the cycle (leak-only, safe),
// admitting recursive structs to the IR path — the intent decl_is_leaksafe_d's
// header already states for the struct-array back-edge.
function opt_payload_ok_dv(structs: parser.StructDecl[], p: string, depth: i32, visiting: string[]): boolean {
    if (is_leaksafe_payload(p)) { return true; }
    if (decl_is_struct(structs, p) && decl_is_leaksafe_d(structs, p, depth + 1, visiting)) { return true; }
    // A leak-safe TUPLE payload (`Option[(i32, i32)]` as a struct field): the
    // Option box holds one tuple pointer, leak-only like a struct payload. The
    // local-position path already admits it; this is the struct-field twin. A
    // nested Option payload (`Option[Option[P]]`) recurses through the same
    // predicate. (visiting-threaded for recursion safety.)
    if (is_leaksafe_tuple_field_dv(structs, p, depth, visiting)) { return true; }
    // A leak-safe ARRAY payload (`Option[i32[]]` / `Option[string[]]` as a struct
    // field): the Option box holds one array pointer, leak-only exactly like the
    // struct and tuple payloads above. Same step the tuple clause took — the
    // LOCAL position already admits it (`var o: Option[i32[]] = Some([..])`
    // lowers and matches today), so this is the struct-field twin, and without
    // it `struct H { o: Option[i32[]] }` refused the whole module the moment it
    // was CONSTRUCTED — `H { o: None }` was enough (#7745).
    if (is_leaksafe_array_field(p) || p == "string[]") { return true; }
    if (p.len() >= 8 && (slice_unchecked(p, 0, 7) == "Option[" || slice_unchecked(p, 0, 7) == "Result[") && is_leaksafe_opt_field_dv(structs, p, depth, visiting)) { return true; }
    // An `Option[<enum>]` payload is NOT admitted here, deliberately. The shape
    // looks exactly like the struct payload above — one enum-variant pointer in
    // the box, leak-only, and decl_is_leaksafe_d admits a bare `c: Color` FIELD on
    // that reasoning — but `opt-enum-field-stays-ast` in
    // self_host_opt_struct_payload_field_ir_test.go is a deliberate NEGATIVE pin
    // requiring the module to come out IR-INELIGIBLE. Admitting it (tried,
    // reverted) turns that test red. The pin's stated rationale was that the
    // legacy AST backend miscompiled an Option[enum] field — an argument FOR the
    // IR path, and moot now that no AST backend exists — so whoever revisits this
    // has to re-derive what actually mishandles the shape before moving the pin.
    // On the wasm IR path all four probe shapes (Some / None / payload matched /
    // read into a local) already agree with the interpreter; the x86 IR runtime
    // answer is the unverified part.
    return false;
}

// is_leaksafe_opt_field_d is the structs-aware variant of is_leaksafe_opt_field:
// it additionally admits an Option[Struct] / Result[Struct, …] field whose struct
// payload is itself leak-safe (the construction + match lowering already handle
// it on every backend; only this eligibility predicate forced such fields to AST).
pub function is_leaksafe_opt_field_d(structs: parser.StructDecl[], t: string): boolean {
    var seen: string[] = [];
    return is_leaksafe_opt_field_dv(structs, t, 0, seen);
}

// Depth/visiting-threaded variant — see opt_payload_ok_dv.
pub function is_leaksafe_opt_field_dv(structs: parser.StructDecl[], t: string, depth: i32, visiting: string[]): boolean {
    var n: i32 = t.len();
    if (n < 9) { return false; }
    if (slice_unchecked(t, 0, 7) == "Option[") { return opt_payload_ok_dv(structs, opt_payload_type(t, "Some"), depth, visiting); }
    if (slice_unchecked(t, 0, 7) == "Result[") {
        return opt_payload_ok_dv(structs, opt_payload_type(t, "Ok"), depth, visiting) && opt_payload_ok_dv(structs, opt_payload_type(t, "Err"), depth, visiting);
    }
    return false;
}

// tuple_type_elem_tag parses a tuple type string "(t0, t1, …)" → element n's tag,
// or "" if not a tuple / n is out of range. Decodes via the structured TypeRef
// (SH-021, docs/SELF-HOST-AUDIT.md T2) instead of a hand-rolled depth-tracking
// top-level-comma scan; parse_type_ref already splits the elements without letting
// a nested generic's or tuple's inner commas confuse the split. A tuple-ARRAY
// ("(a, b)[]", array_depth > 0) is a value of array type, not a tuple, so it
// returns "" — matching the former scan, whose ")"-suffix test failed on the
// trailing "]".
pub function tuple_type_elem_tag(t: string, n: i32): string {
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.array_depth != 0 || !r.is_tuple) { return ""; }
    if (n < 0 || n >= r.args.len()) { return ""; }
    var rt: string = parser.render_type_ref(r.args[n]);
    // A declared fn-typed element holds a closure BOX at runtime (the lift
    // pass wraps every fn-valued tuple element into a `__mkclo$…` env box),
    // so tag it "clo" for the env-first `t.N(args)` dispatch — mirroring
    // tuple_elem_tags' declared-side mapping.
    //
    // The element keeps its SIGNATURE now (#7961: coarsening it to the bare tag
    // threw away the result type the checker needs to type `t.N()`), so the
    // arrow form is what arrives here. The bare tag still can — a type
    // parameter substituted with `fn` spells one — so both answer "clo".
    if (rt == "fn" || parser.ref_is_fn_value(r.args[n])) { return "clo"; }
    return rt;
}

// is_leaksafe_tuple_field: a tuple field "(t0, …)" whose elements are each a
// leak-safe scalar / string, an Option[T] / Result[T,E] (leak-only box), a
// leak-safe ARRAY (a heap pointer in one tuple slot), or a NESTED tuple of such
// elements. Tuples are leak-only on the IR path (the exit sweep never frees
// them), so such a field leaks with the struct — no RC, no aliasing bail.
// tuple_field_reclaim_ok reports whether a STRUCT-LITERAL tuple field may be
// routed through the field-reclaim block. It is deliberately a conjunction of
// the field TYPE and the value SHAPE, because that block bails the whole
// lowering (`if (!fav_ok) { return s.fail(); }`) for anything it cannot
// validate: admitting a tuple field type on the type alone turned an ordinary
// `Hold { t: (7, [7, 8]) }` from a leak into a compile failure.
//
// Two shapes are admitted, both owned by the new box with no second owner: a
// fresh tuple literal, and a bare ident naming a tuple-box local — for the
// latter, a tuple reaching a struct literal is an escape, so rctuple_esc_expr
// refuses the local its "TUPRCS:" exit sweep and the struct's field drop is
// the only free. Anything else stays outside the block and keeps the prior
// (leaking, sound) behaviour.
pub function tuple_field_reclaim_ok(cfft: string, fav: ast.Expr, s: LowerState): boolean {
    if (!util.is_tuple_type_name(cfft) || !is_leaksafe_tuple_field(cfft)) { return false; }
    match (fav) {
        ast.ExprTuple(_) => { return true; },
        ast.ExprIdent(tid) => { return s.slot_is_tuple_box(s.slot_of(tid.name)); },
        _ => { return false; }
    }
    return false;
}

pub function is_leaksafe_tuple_field(t: string): boolean {
    var len: i32 = t.len();
    if (len < 3 || slice_unchecked(t, 0, 1) != "(" || slice_unchecked(t, len - 1, len) != ")") { return false; }
    var any: boolean = false;
    var i: i32 = 0;
    while (i < 64) {
        var tag: string = tuple_type_elem_tag(t, i);
        if (tag == "") { return any; }
        var elem_ok: boolean = is_leaksafe_payload(tag);
        // An Option[T]/Result[T,E] element is a leak-only box (one pointer slot).
        if (!elem_ok) { elem_ok = is_leaksafe_opt_field(tag); }
        // A leak-safe ARRAY element — a scalar / string / 8-byte array — is a
        // heap pointer in one tuple slot, leaking with the (leak-only) tuple
        // field, exactly the set tuple_elems_lowerable already admits for tuple
        // construction / return. (Struct- / enum-array elements need the
        // `structs` view to classify, so a tuple field carrying one still
        // bails — rarer, a later increment.)
        if (!elem_ok && (tag == "string[]" || tag == "f64[]" || tag == "i64[]" || is_leaksafe_array_field(tag))) { elem_ok = true; }
        // A NESTED tuple element is itself a leak-only heap-tuple pointer; recurse.
        if (!elem_ok && util.is_tuple_type_name(tag)) { elem_ok = is_leaksafe_tuple_field(tag); }
        if (!elem_ok) { return false; }
        any = true;
        i = i + 1;
    }
    return any;
}

// is_leaksafe_tuple_field_d widens is_leaksafe_tuple_field with the `structs`
// view: a STRUCT-array (`Inner[]`) or ENUM-array (`Color[]`) tuple element is
// also a leak-only heap pointer in one tuple slot — the set tuple_elems_lowerable
// already admits for tuple construction / return, where the `.N` read binds the
// slot mark_arr + the element struct/enum name so `t.N[i].field` / `match (t.N[i])`
// resolve. Only decl_is_leaksafe_d (which holds the struct view) uses this; the
// reuse-analysis callers keep the narrower structs-free predicate, so a struct
// with such a tuple field is admitted to the IR path but conservatively skips
// constructor reuse (alloc path — sound, just unoptimised).
pub function is_leaksafe_tuple_field_d(structs: parser.StructDecl[], t: string): boolean {
    var seen: string[] = [];
    return is_leaksafe_tuple_field_dv(structs, t, 0, seen);
}

// Depth/visiting-threaded variant — see opt_payload_ok_dv. Threads the set into
// its Option-element and nested-tuple recursion so a tuple field carrying a
// self-referential Option / tuple element does not spin the same cycle.
pub function is_leaksafe_tuple_field_dv(structs: parser.StructDecl[], t: string, depth: i32, visiting: string[]): boolean {
    var len: i32 = t.len();
    if (len < 3 || slice_unchecked(t, 0, 1) != "(" || slice_unchecked(t, len - 1, len) != ")") { return false; }
    var any: boolean = false;
    var i: i32 = 0;
    while (i < 64) {
        var tag: string = tuple_type_elem_tag(t, i);
        if (tag == "") { return any; }
        var elem_ok: boolean = is_leaksafe_payload(tag);
        if (!elem_ok) { elem_ok = is_leaksafe_opt_field_dv(structs, tag, depth, visiting); }
        if (!elem_ok && (tag == "string[]" || tag == "f64[]" || tag == "i64[]" || is_leaksafe_array_field(tag))) { elem_ok = true; }
        // The struct-view additions over the plain gate: a struct-array / enum-
        // array element.
        if (!elem_ok && (is_struct_array_field_type(structs, tag) || is_enum_array_field_type(structs, tag))) { elem_ok = true; }
        // A fn-typed element (tuple_type_elem_tag maps "fn" -> "clo") holds a
        // `__mkclo$` closure BOX at runtime — one leak-only pointer slot, like an
        // Option box — so a struct field carrying it is IR-eligible. Reading the
        // slot (`s.p.N`) and calling it (`s.p.N(args)`, the "clo" env-first
        // dispatch) already lower; only this gate rejected the field. Admitted in
        // the wide (`_d`) predicate ONLY, so the struct routes IR but conservatively
        // skips constructor reuse (the narrow predicate the reuse pass consults
        // still declines) — sound, just unoptimised, exactly like the struct-array
        // element case above.
        if (!elem_ok && tag == "clo") { elem_ok = true; }
        // A bare STRUCT element (`(A, i32)` — element A) is a leak-only pointer
        // slot like a struct-array / Option element: the tuple stores the struct
        // box, `t.N.field` reads it (expr_tuple_elem_tag tags element N with the
        // struct name). Admitted when the element struct is itself leak-safe;
        // decl_is_leaksafe_d is threaded with depth + visiting so a self-
        // referential element short-circuits instead of recursing forever.
        if (!elem_ok && decl_is_struct(structs, tag) && decl_is_leaksafe_d(structs, tag, depth + 1, visiting)) { elem_ok = true; }
        // A bare nominal-ENUM element is leak-only on the IR path (the exit sweep
        // never frees an enum box), like an enum-array / Option element.
        if (!elem_ok && is_enum_like_name(tag, structs)) { elem_ok = true; }
        // A NESTED tuple element recurses through THIS predicate so an inner
        // struct-/enum-array element is admitted at any depth.
        if (!elem_ok && util.is_tuple_type_name(tag)) { elem_ok = is_leaksafe_tuple_field_dv(structs, tag, depth, visiting); }
        if (!elem_ok) { return false; }
        any = true;
        i = i + 1;
    }
    return any;
}

pub function is_scalar_arr_field_access(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            // Any owned array field — scalar (i32[]/f64[]/i64[]) or struct (P[]) —
            // is bailed in the alias-creating positions (bind/return/assign): the
            // leak-only IR can't retain the second reference, and the field's array
            // is the struct's sole-owned value.
            return is_leaksafe_array_field(ft) || is_struct_array_field_type(s.structs, ft) || is_enum_array_field_type(s.structs, ft);
        },
        _ => { return false; }
    }
    return false;
}

// scalar_arr_field_type returns the field type of a SCALAR-element array struct
// field read (`v.items` where items: i32[] / f64[] / i64[]) — the subset of
// is_scalar_arr_field_access that is_leaksafe_array_field admits. Struct-array
// (P[]) / enum-array (C[]) field reads return "" (they still bail in the
// alias-creating positions — deep-drop recursion is a later slice). The RC
// frontier slice 2 lowers these (bind / return / assign) via the IR by emitting
// a Perceus dup (__fern_rc_inc) so the new owner holds a counted reference; the
// struct's own field-drop and the local exit-sweep then each balance against the
// inc (rc 1 →inc 2 →sweep/escape 1 →field-drop 0). Returns "" for anything that
// is NOT such a field read.
pub function scalar_arr_field_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_leaksafe_array_field(ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// enum_arr_field_share_read: `fv` is a bare-ident FIELD READ that aliases an
// array buffer into a struct-literal field of declared type `cfft`, for the
// element kinds the construction admission gate above does not name — an
// enum-array (or union-array) `P { f: q.f }`. Returns the source holder's local
// name, or "" when the shape does not qualify.
//
// ONE predicate, consulted by three sites that must agree exactly: the retain in
// the ExprStructLit lowering, and the two marker flips in bind_var_slot. They
// agree by construction because they ask this, not because three separate
// conditions happen to line up — which matters because the two markers exist for
// good reasons and flipping either without the retain is a double free.
function enum_arr_field_share_read(fv: ast.Expr, cfft: string, s: LowerState): string {
    if (!is_array_type_name(cfft)) { return ""; }
    // The gate above already retains these two kinds; this is only for what it
    // leaves out, so it must not double-fire on them.
    if (is_leaksafe_array_field(cfft)) { return ""; }
    if (is_struct_array_field_type(s.structs, cfft)) { return ""; }
    // A `T { ...base }` anywhere in this function that copies a field of this very
    // type mints a THIRD owner with no inc, and both this share's rc-gated walks
    // then run against a count of two. The census reads that as a flat 700 allocs /
    // 700 frees while __rc_underflow_count fires — the same precondition the
    // arrstruct and arrenum credits gate on, asked by field type because the base
    // may name a local with no slot yet.
    if (util.index_of_str(s.spread_sites, "FT:" + cfft) >= 0) { return ""; }
    match (fv) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    var ost: string = s.struct_type_of_slot(s.slot_of(oid.name));
                    if (ost.len() == 0) { return ""; }
                    if (decl_field_type(s.structs, ost, fa.field) != cfft) { return ""; }
                    return oid.name;
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// str_field_share_read: the STRING limb of the counted-share question
// enum_arr_field_share_read answers for arrays — `P { f: q.f }`, a bare-ident
// field read handed straight into a struct-literal string field. Returns the
// source holder's local name, or "" when the shape does not qualify.
//
// The read lowers through struct_get to the SOURCE box's buffer, so the new box
// co-owns it. Both holders are marked box-only while that share is uncounted —
// the source because a field read in a struct-literal field is a positive MOVE
// position, the target because its literal borrows a string it did not retain —
// and those markers are what withhold __struct_drop_<T> from each, so neither
// holder frees the string at all. Neither marker may be flipped without the
// construction retain: one box under two rc-aware k_str decs frees on the first
// and dangles on the second.
//
// Hoisting the same read to a local (`var t = q.f; P { f: t }`) is already clean —
// strfld_safe_operand forgives a direct field-read init and the #4768 read-side
// retain counts it. This is that spelling written inline.
//
// That equivalence is a STRING fact and does not carry to `string[]`. The array
// flavour measures identically hoisted and inline (800 allocs / 300 frees against
// native's 600/600), because strarrfld_scan's field-access arm marks
// `<T>.<field>` for any read that is not a `.len()` receiver or a registered
// forwarder — so the READ, however spelled, refuses the holder's field reclaim
// before any share position is reached. `str_arr__fieldread` is that cell and is
// #5338, not this predicate's limb.
//
// BOTH holders' types must route field reclaim: the flip only grants a drop the
// backend will emit, and a source whose type does not route would keep leaking
// while the target released a box it now co-owns.
function str_field_share_read(fv: ast.Expr, cfft: string, lit_type: string, s: LowerState): string {
    if (cfft != "string") { return ""; }
    // The same verdict the construction-side retain is gated on (slit_reclaim), so
    // the retained set and the flipped set cannot drift apart (#7253).
    if (!s.struct_routes_field_reclaim(lit_type)) { return ""; }
    // A `T { ...base }` copying a field of this type mints a THIRD owner with no
    // inc, and both rc-gated walks then run against a count of two. Asked by FIELD
    // TYPE because the base may name a local with no slot yet.
    if (util.index_of_str(s.spread_sites, "FT:" + cfft) >= 0) { return ""; }
    match (fv) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    var ost: string = s.struct_type_of_slot(s.slot_of(oid.name));
                    if (ost.len() == 0) { return ""; }
                    if (decl_field_type(s.structs, ost, fa.field) != cfft) { return ""; }
                    if (!s.struct_routes_field_reclaim(ost)) { return ""; }
                    return oid.name;
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// struct_arr_field_read_type returns the field type of an ARRAY-OF-STRUCT struct
// field read (`v.params` where params: P[], P a struct) — the struct-array twin
// of scalar_arr_field_type. Returns "" for scalar-array / enum-array fields and
// for anything that is NOT such a field read. Used to admit `var ps: P[] =
// obj.params` BINDS onto the IR path: aliasing a struct-array field needs only a
// Perceus dup (__fern_rc_inc) on the buffer POINTER — element-type-agnostic,
// since the dup and the local exit-sweep's shallow arr_dec both act on the
// buffer, never on its (source-struct-owned) elements. No deep-drop recursion is
// involved for the bind: `ps` borrows + counts the buffer; the source struct
// still owns and (later) reclaims the elements. Balance mirrors the scalar bind:
// field rc N →dup N+1 →exit-sweep(ps) N, leaving the struct's reference intact.
pub function struct_arr_field_read_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_struct_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// enum_arr_field_read_type is the enum-array twin of struct_arr_field_read_type:
// it returns the field type of an ARRAY-OF-ENUM struct field read (`v.args` where
// args: Expr[], Expr an enum), else "". Aliasing an enum-array field is sound by
// the same reasoning as the struct-array case — the Perceus dup (__fern_rc_inc)
// is on the buffer POINTER, element-type-agnostic; the buffer's enum-box elements
// are owned by the source struct and never deep-dropped (the safe-leak
// invariant), so the dup can only ever leak, never over-free. The bound slot is
// marked with the element ENUM name (mark_struct_type doubles as the element-type
// slot for both struct and enum element arrays) so a later `match (es[i])`
// recovers the variant. `Expr[]` / `Stmt[]` / `Token[]` field reads — pervasive
// in the parser's AST walkers — are exactly this shape.
pub function enum_arr_field_read_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_enum_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// nested_arr_field_read_type is the ARRAY-OF-ARRAY twin of the three classifiers
// above: it returns the field type of a `T[][]` struct field read (`a.rows`
// where rows: i32[][]), else "". Without it such a receiver was the ONE array
// field shape no classifier claimed, so `a.rows.append(r)` fell through the
// array-method intercepts to the primitive-receiver cascade, which answers "i32"
// for anything it cannot type — dispatching `i32.append` and refusing the whole
// module (#7208). The level the receiver lost is recoverable from the field
// declaration, which is all this reads.
//
// The read is a BORROW of a buffer the struct still owns, exactly like the
// scalar / struct / enum array field reads, so the `.append` / `.with` value
// forms clone it rather than growing it in place.
pub function nested_arr_field_read_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_nested_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// enum_field_read_type is the DIRECT-enum twin of enum_arr_field_read_type: it
// returns the field type of a plain ENUM struct field read (`p.node` where
// `node: RNode` and RNode is an enum), else "". Storing such a read into a
// CONTAINER makes the container a second owner of the field's enum box while the
// source struct still holds the first, so it needs the same Perceus dup
// (__fern_rc_inc) the struct-literal path already applies to a direct enum field
// value: __struct_drop_<T>'s k_enum arm decs the field when the struct is
// reclaimed, and without the dup that dec frees a box the container still points
// at. Balance: field rc 1 →dup 2 →__struct_drop_<T> 1 →container's own release 0.
// A borrowed source whose struct is never dropped simply leaks (sound).
//
// #6049: std/regex's `__rx_alt` is exactly this shape — `[first.node]` and
// `branches.append(nxt.node)` over an `RParse.node`. The RSeq box the branches
// array pointed at was freed by `first`'s __struct_drop_RParse, and the freelist
// handed the same block back for the enclosing RGroup — a self-referential parse
// tree that made `__rx_match` alternate between its RGroup and RAlt arms until
// the stack ran out (six regex fixtures, on both the x86-64 and arm64 legs).
pub function enum_field_read_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (decl_is_enum(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// strarr_field_read_type is the string[] twin of scalar_arr_field_type /
// struct_arr_field_read_type / enum_arr_field_read_type: it returns the field
// type of a `string[]` struct field read (`s.local_names` where local_names:
// string[]), else "". A string[] is NOT covered by is_leaksafe_array_field (a
// string element is a heap pointer, not a scalar), so without this the
// `field.append(v)` dispatch fell through to the move/consume form (op_arr_push
// in place). That consume form reuses the receiver buffer — UNSOUND when the
// receiver is a borrowed, possibly-shared struct field: aliasing the enclosing
// struct (`var b = a` over a struct holding the string[]) then appending in one
// alias silently mutates the buffer the other alias still reads. That is exactly
// the checker self-build crash (asmcore.EmitState.local_names is a string[] field;
// check_stmt's `var actx = ctx` aliases the EmitState across a match arm, and the
// arm-body bind_local_typed's `s.local_names.append(name)` corrupted the shared
// buffer — leaking the arm's bindings into the restored local_names so it desynced
// from the clone-form local_types). Routing string[] field appends through the
// CLONE form (lower_arr_append_value) — element-kind-agnostic, the same sound shape
// the scalar/struct/enum-array fields use — fixes it: the receiver buffer is never
// reused, only the sole-owned clone.
pub function strarr_field_read_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (ft == "string[]") { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// field_access_arr_field_type returns the field type of an array-field struct
// field read (`s.xs` where xs: i32[]/f64[]/i64[]/boolean[] — a scalar-element
// array — OR xs: P[] — an array-of-struct — OR xs: E[] — an array-of-enum), for
// use as a struct-literal field VALUE (`State { xs: s.xs }`, `DeferAcc { actions:
// er.actions }` over a `Stmt[]` — parser.dl_collect_stmt). This is the bare-
// field-copy admission for the `ExprStructLit` array-field path (RC-frontier
// slice 3, following the array-ident-into-field #3292 + the array-out-of-field
// #3308 reads): the field read lowers via op_struct_get (a real value), aliasing
// the SOURCE struct's array, so the consuming struct_make stores a SECOND owner —
// balanced by a Perceus dup (__fern_rc_inc), exactly the #3292 alias-inc idiom.
// Enum-array fields take the same is_unique-gated deep-drop as struct-array
// fields (emit_struct_field_drops' k_box walk), so the alias-inc balances both
// sides identically. Returns "" for anything that is NOT such a bare array-field
// read (e.g. a string[] field, or a non-field expression).
pub function field_access_arr_field_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_leaksafe_array_field(ft) || is_struct_array_field_type(s.structs, ft) || is_enum_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// selfrebind_field_alias reports whether `e` is exactly `srb.<f>` — a field read
// off the local whose own self-rebind literal is being lowered (#6653). `srb` is
// "" everywhere else, so this is false unless LowerState.selfrebind was set for
// this expression. Only a DIRECT `srb.<f>`: a deeper chain `srb.a.b` reaches a
// box the successor does not supersede, so that one keeps its retain.
pub function selfrebind_field_alias(e: ast.Expr, srb: string): boolean {
    if (srb.len() == 0) { return false; }
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => { return oid.name == srb; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// ctor_selfrebind_payload reports whether `e` is exactly the local `srb` — the
// one a variant constructor is being rebound INTO (`srb = Cons(1, srb)`). `srb`
// is "" everywhere else. The payload field then takes over the slot's reference
// rather than adding an owner, so the construction needs no retain.
pub function ctor_selfrebind_payload(e: ast.Expr, srb: string): boolean {
    if (srb.len() == 0) { return false; }
    match (e) {
        ast.ExprIdent(id) => { return id.name == srb; },
        _ => { return false; }
    }
    return false;
}

pub function decl_is_leaksafe(structs: parser.StructDecl[], struct_name: string): boolean {
    var seen: string[] = [];
    return decl_is_leaksafe_d(structs, struct_name, 0, seen);
}

// decl_at_is_leaksafe is the same question asked of an already-resolved decl —
// what a variant pattern needs, since two enums may declare one variant name and
// only one of the two decls is this arm's. The recursion below stays by-name:
// every type it descends into is a struct or enum TYPE name, which is unique.
pub function decl_at_is_leaksafe(structs: parser.StructDecl[], decl_index: i32): boolean {
    if (decl_index < 0 || decl_index >= structs.len()) { return false; }
    var seen: string[] = [];
    return decl_is_leaksafe_at_d(structs, decl_index, 0, seen);
}

// decl_is_leaksafe_d is the recursion: a struct is leak-safe if every field is a
// scalar (i32/boolean/string/scalar-array) OR a struct that is itself leak-safe
// (composite struct fields, leak mode — the pointer is stored in one slot, no
// RC). `visiting` is the set of struct names on the current proof path: a field
// whose (element) type is already being proven is a leak-only BACK-EDGE in the
// type graph — a self-referential `next: Node[]` or a mutually-recursive
// `A.b: B[]` / `B.a: A[]` — and in leak mode that back-pointer is just a slot
// that leaks with the struct (no RC), so the cycle introduces no unsafe field.
// We short-circuit such an edge as leak-safe (the OUTER struct's own fields are
// still each validated), which admits linked lists / trees / ASTs onto the IR
// path. The depth cap stays as a backstop for pathological non-cyclic graphs.
function decl_is_leaksafe_d(structs: parser.StructDecl[], struct_name: string, depth: i32, visiting: string[]): boolean {
    if (depth > 16) { return false; }
    // Back-edge to a struct already on the proof path: leak-only, so safe.
    // Checked before the lookup so a name with no decl at all still bails.
    if (util.has_str(visiting, struct_name)) { return true; }
    return decl_is_leaksafe_at_d(structs, decl_index_of(structs, struct_name), depth, visiting);
}

function decl_is_leaksafe_at_d(structs: parser.StructDecl[], decl_index: i32, depth: i32, visiting: string[]): boolean {
    if (depth > 16) { return false; }
    if (decl_index < 0 || decl_index >= structs.len()) { return false; }
    var struct_name: string = structs[decl_index].name;
    if (util.has_str(visiting, struct_name)) { return true; }
    var nv: string[] = visiting.append(struct_name);
    var fi: i32 = 0;
    while (fi < structs[decl_index].fields.len()) {
        var t: string = structs[decl_index].fields[fi].type_name;
        // The ≤32-bit integer scalars (u32 + the sub-word u8)
        // are leak-only and ride one i32 slot exactly like i32, so a struct
        // carrying them is leaf-safe and lowers (construction stores / field
        // read loads at the default 32-bit width; a sub-word cast wraps the
        // value before the store). The 64-bit-slot scalars (i64 / u64 / f64 /
        // f32 / float) are here too, on the same leak-only reasoning.
        // `string[][]` is spelled out because is_leaksafe_array_field bottoms
        // out in the scalar-element arrays, so neither it nor
        // is_nested_array_field_type reaches a nested STRING array — the same
        // reason the match-arm payload admission spells the pair out.
        // Thread this proof's depth + visiting set (`nv`) into the Option /
        // tuple field predicates so a self-referential `Option[Node]` /
        // `(Node, …)` field re-enters decl_is_leaksafe_d WITH the path — its
        // back-edge check then short-circuits the cycle instead of recursing
        // forever (was a SIGSEGV on any linked list / tree).
        if (t == "i32" || t == "boolean" || t == "string" || t == "string[]" || t == "f64" || t == "i64" || t == "u32" || t == "u8" || t == "f32" || t == "float" || t == "u64" || is_leaksafe_array_field(t) || t == "string[][]" || is_leaksafe_opt_field_dv(structs, t, depth, nv) || is_leaksafe_tuple_field_dv(structs, t, depth, nv) || is_map_type_name(t) || (t.len() > 5 && slice_unchecked(t, 0, 5) == "Cell[")) {
            fi = fi + 1;
            continue;
        }
        // A struct-typed field is allowed if its struct is leak-safe too.
        if (decl_is_struct(structs, t) && decl_is_leaksafe_d(structs, t, depth + 1, nv)) {
            fi = fi + 1;
            continue;
        }
        // A nominal-enum field (Color, Expr, …) is leak-only on the IR
        // path — the exit sweep never frees an enum box — so it leaks
        // with the struct like a string / Option / tuple field: no RC, no
        // aliasing bail. is_enum_like_name can over-match a bare nominal
        // that is not really an enum, but the only consequence is an AST
        // fallback at the construction / match site (never a miscompile),
        // and the stage-2 fixpoint guards byte-stability.
        if (is_enum_like_name(t, structs)) {
            fi = fi + 1;
            continue;
        }
        // An array-of-struct field `X[]` (X a leak-safe struct): admitted
        // in leak mode (the array + its elements leak with the struct; a
        // recursive-drop follow-up frees them). The element's leaf-safety
        // rides the SAME depth-bounded recursion so a cyclic `X[]` graph
        // hits the cap and bails.
        if (t.len() >= 3 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
            var elt: str = slice_unchecked(t, 0, t.len() - 2);
            if (decl_is_struct(structs, elt) && decl_is_leaksafe_d(structs, elt, depth + 1, nv)) {
                fi = fi + 1;
                continue;
            }
            // An array-of-ENUM field `C[]` — enum boxes leak with the
            // struct like the struct-element arrays above (and the
            // nominal-enum field case), so admit it in leak mode.
            if (is_enum_like_name(elt, structs)) {
                fi = fi + 1;
                continue;
            }
            // An array-of-ARRAY field `T[][]`, an array-of-Option/Result
            // field `Option[T][]` whose element `Option[T]` is a leak-safe
            // Option/Result, or an array-of-TUPLE field `(i32, string)[]`
            // whose element tuple is a leak-safe tuple: the whole nested
            // structure leaks with the struct. Covers the common 2-D field;
            // deeper nesting still bails.
            if (is_nested_array_field_type(structs, t) || is_leaksafe_opt_field_d(structs, elt) || is_leaksafe_tuple_field_d(structs, elt)) {
                fi = fi + 1;
                continue;
            }
        }
        return false;
    }
    return true;
}

// is_enum_like_name reports whether type name `t` denotes a (nominal) enum:
// not a primitive, struct, array, or bracketed/tuple generic. Mirrors the AST
// emitter's is_enum_recv heuristic (asmcore.is_enum_recv) — a bare nominal that
// isn't anything else is an enum. Used to carry an enum-typed local / param /
// receiver's type name in local_struct_type, so `x.method()` on an enum value
// dispatches to `<Enum>.<method>` (the enum-receiver-method path). A name that
// is really a scalar type alias would be mis-marked, but the only consequence
// is a method-dispatch label that calls_only_known finds absent → the module
// bails; never a miscompile.
pub function is_enum_like_name(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() == 0) { return false; }
    if (t == "i32" || t == "boolean" || t == "bool" || t == "string"
        || t == "i64" || t == "f64" || t == "f32" || t == "float" || t == "void") { return false; }
    // "clo" is the compiler's closure-BOX tag spelling (a boxed fn-valued
    // tuple element / Option payload) — never a user enum name. Without this
    // exclusion an Option[clo] payload's match bind was claimed by the enum
    // branch (mark_struct_type("clo")) before the closure-local mark could
    // fire, so `f(args)` bare-called the box pointer → SIGSEGV. ("fn" is NOT
    // excluded: existing struct-field / enum-payload machinery relies on the
    // coarse "fn" spelling reading as enum-like in its dispatch gates.)
    if (t == "clo") { return false; }
    if (decl_is_struct(structs, t)) { return false; }
    if (is_array_type_name(t)) { return false; }
    // A bracketed generic (Option[..]/Result[..]/Map[..]/Box[..]) or a tuple
    // "(..)" is not a bare enum.
    var ci: i32 = 0;
    while (ci < t.len()) {
        if (t[ci] == b'[') { return false; }
        ci = ci + 1;
    }
    if (slice_unchecked(t, 0, 1) == "(") { return false; }
    return true;
}

// decl_is_prim_recv reports whether a method-receiver type spelling names a
// PRIMITIVE / `string` type (i32/i64/u32/u64/usize/f64/f32/boolean/string) —
// the receivers `impl Trait for <prim>` can name, whose `dyn` values are
// heap-boxed at coercion (docs/DYN-TRAITS.md §4.2.3). Not a struct, not an
// enum, not an array. Mirrors asmcore.is_prim_recv_name for the wasm backend,
// which works on (structs) inputs rather than EmitState.
pub function decl_is_prim_recv(structs: parser.StructDecl[], name: string): boolean {
    if (name.len() == 0) { return false; }
    if (is_array_type_name(name)) { return false; }
    if (decl_is_struct(structs, name)) { return false; }
    if (is_enum_like_name(name, structs)) { return false; }
    if (name == "i32" || name == "i64" || name == "u32" || name == "u64" || name == "usize"
        || name == "f64" || name == "f32" || name == "float"
        || name == "boolean" || name == "bool" || name == "string") { return true; }
    return false;
}

// prim_type_ids is the canonical ordered list of primitive receiver type names
// used to assign a dyn-box shape id on wasm (the natives use the interned
// type-name string). The id is structs.len() + index, so it never collides with
// a struct's type id (its index in `structs`). The order is fixed for
// deterministic codegen (docs/DYN-TRAITS.md §4.2.3 — fixpoint determinism).
pub function prim_type_ids(): string[] {
    return ["i32", "boolean", "bool", "i64", "u32", "u64", "usize", "f64", "f32", "float", "string"];
}

// prim_type_id maps a primitive receiver type name to its wasm dyn-box shape id
// (structs.len() + its index in prim_type_ids), or -1 if not a primitive. Both
// op_dyn_box (store @0) and op_dyn_dispatch (compare) key off this, so a boxed
// value's offset-0 id matches the dispatch arm. bool/boolean and f32/f64/float
// share spellings but each maps to its own slot; that is harmless (an impl names
// exactly one spelling, used at both box and dispatch).
pub function prim_type_id(structs: parser.StructDecl[], name: string): i32 {
    var names: string[] = prim_type_ids();
    var i: i32 = 0;
    while (i < names.len()) {
        if (names[i] == name) { return structs.len() + i; }
        i = i + 1;
    }
    return 0 - 1;
}

// decl_has_scalar_array reports whether a struct has any scalar-array field.
pub function decl_has_scalar_array(structs: parser.StructDecl[], struct_name: string): boolean {
    for sd in structs {
        if (sd.name == struct_name) {
            for fld in sd.fields {
                if (is_scalar_array_type(fld.type_name)) { return true; }
            }
            return false;
        }
    }
    return false;
}

// decl_field_type returns the declared type name of `field` in `struct_name`
// ("" if absent) — used to track a string-typed field's reads as strings.
pub function decl_field_type(structs: parser.StructDecl[], struct_name: string, field: string): string {
    for sd in structs {
        if (sd.name == struct_name) {
            for fld in sd.fields {
                if (fld.name == field) { return fld.type_name; }
            }
            return "";
        }
    }
    return "";
}

// decl_field_fn_ret returns the recorded fn RETURN tag of struct_name.field
// (StructFieldDecl.fn_ret — set by the parser for an fn-typed field whose
// `(…) => R` return is a struct/nominal/string spelling), or "". The string
// case drives expr_is_str's fn-field-call arm (#5306 gap 2).
pub function decl_field_fn_ret(structs: parser.StructDecl[], struct_name: string, field: string): string {
    for sd in structs {
        if (sd.name == struct_name) {
            for fld in sd.fields {
                if (fld.name == field) { return fld.fn_ret; }
            }
            return "";
        }
    }
    return "";
}

// decl_field_fn_param_types returns the recorded PARAMETER spellings of the
// fn-typed field struct_name.field (StructFieldDecl.fn_param_types), or "".
// The sibling of decl_field_fn_ret; "" means either a zero-parameter fn type or
// a field that is not one, which decl_field_fn_sig separates by asking fn_ret.
pub function decl_field_fn_param_types(structs: parser.StructDecl[], struct_name: string, field: string): string {
    for sd in structs {
        if (sd.name == struct_name) {
            for fld in sd.fields {
                if (fld.name == field) { return fld.fn_param_types; }
            }
            return "";
        }
    }
    return "";
}

// decl_type_params returns the declaring struct's own type parameters, the list
// wasm_width_char must decline against: a field spelled `() => T` has no width
// until the struct is instantiated.
pub function decl_type_params(structs: parser.StructDecl[], struct_name: string): string[] {
    for sd in structs {
        if (sd.name == struct_name) { return sd.type_params; }
    }
    return [];
}

// call_fn_field_ret is the DECLARED return-type spelling of a call through a
// fn-typed struct FIELD (`h.f(args)`), or "". The field's own type coarsens to
// the flat "fn" tag with the result in its fn_ret sidecar, so no walk over the
// callee can answer — and neither can the checker's stamp where the struct is
// GENERIC, because annotation runs on the erased form and a `(T) => T` field
// stamps nothing for the clone to inherit.
//
// One leaf, because each predicate used to learn this separately: expr_is_str
// grew the string case (#5306 gap 2) and the width predicates never grew theirs,
// so a `Box[i64]`'s `b.f(x) as i32` lowered without its i32.wrap_i64 and the
// wasm validator refused the module (#5986).
pub function call_fn_field_ret(c: ast.ExprCall, s: LowerState): string {
    match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
            var rty: string = expr_struct_type(cfa.obj, s);
            if (rty == "") { return ""; }
            if (decl_field_type(s.structs, rty, cfa.field) != "fn") { return ""; }
            return decl_field_fn_ret(s.structs, rty, cfa.field);
        },
        _ => {}
    }
    return "";
}

// fn_sig_of_ref is fn_sig_of asked of a structured fn TYPE rather than a
// ParamDecl's sidecars — the same width rules, reached from a spelling that was
// never coarsened. "" when `r` is not a fn value, when a position is a bare type
// parameter, or when the signature is all-i32 and `$fn<N>` already names it.
pub function fn_sig_of_ref(r: parser.TypeRef, tps: string[]): string {
    if (!parser.ref_is_fn_value(r)) { return ""; }
    var ret: string = parser.render_type_ref(parser.ref_fn_result(r));
    if (ret.len() == 0) { return ""; }
    var ptys: string = parser.ref_fn_param_spellings(r);
    var tys: string[] = [];
    if (ptys.len() > 0) { tys = split_type_list(ptys); }
    var pd: ast.ParamDecl = fn_param_decl("$elem", tys, ret);
    if (pd.type_name.len() == 0) { return ""; }
    return fn_sig_of(pd, tps);
}

// tuple_elem_fn_sig is the funcref signature tag for a call through element `n`
// of the tuple `e` — the tuple sibling of decl_field_fn_sig. The element's tag
// is the coarse "clo"/"fn" dispatch marker, so the signature has to come from
// the DECLARED tuple spelling: the slot's tuple_type for a local, the field's
// declared type for a tuple struct field, or the array's element spelling for
// an array of tuples. "" when none of those recorded one, which leaves the call
// on the arity-keyed form it has today.
pub function tuple_elem_fn_sig(e: ast.Expr, n: i32, s: LowerState): string {
    var t: string = tuple_decl_type(e, s);
    if (t.len() == 0) { return ""; }
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.array_depth != 0 || !r.is_tuple) { return ""; }
    if (n < 0 || n >= r.args.len()) { return ""; }
    return fn_sig_of_ref(r.args[n], []);
}

// tuple_decl_type is the declared tuple SPELLING behind a tuple expression, or
// "". The routes mirror expr_tuple_elem_tag's, minus the ones that only ever
// held coarsened tags.
function tuple_decl_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0 || sl >= s.locals.len()) { return ""; }
            return s.locals[sl].tuple_type;
        },
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            return decl_field_type(s.structs, oty, fa.field);
        },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (asl >= 0 && s.is_arr_slot(asl)) { return s.arrarr_elem_of_slot(asl); }
                },
                _ => {}
            }
            return "";
        },
        _ => {}
    }
    return "";
}

// fnarr_elem_of_var rebuilds the declared ELEMENT spelling of an `((P) => R)[]`
// binding from the two sidecars the parser records for it, or "" when the
// binding is not a fn array or recorded no return. The array sibling of a
// tuple binding's `v.type_name`, which needed no rebuilding because a tuple
// spelling is never coarsened.
function fnarr_elem_of_var(v: ast.StmtVar): string {
    if (v.type_name != "fn[]") { return ""; }
    if (v.fn_ret.len() == 0) { return ""; }
    return "(" + v.fn_param_types + ") => " + v.fn_ret;
}

// array_elem_fn_sig is the funcref signature tag for a call through an ELEMENT
// of the fn array `e` — the array sibling of tuple_elem_fn_sig. The element's
// dispatch flag (is_fnarr / is_closurearr) says how to call it, never what
// signature to call it on, because parse_type_name coarsened `((f64) => f64)[]`
// to the flat "fn[]" tag. So the signature comes from the DECLARATION: the
// slot's fnarr_elem for a local, the field's own two sidecars for a struct
// field. "" when neither recorded one, which leaves the call on the arity-keyed
// `$fn<N>` form it has today.
pub function array_elem_fn_sig(e: ast.Expr, s: LowerState): string {
    var el: string = fnarr_decl_elem(e, s);
    if (el.len() == 0) { return ""; }
    return fn_sig_of_ref(parser.parse_type_ref(el), []);
}

// fnarr_decl_elem is the declared ELEMENT spelling behind a fn-array
// expression, or "". A GENERIC struct's field declines: its spelling can name a
// bare type parameter, which only the monomorphised instance resolves, and
// `fn_sig_of_ref` has no type-parameter list to answer with here.
function fnarr_decl_elem(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0 || sl >= s.locals.len()) { return ""; }
            return s.locals[sl].fnarr_elem;
        },
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            if (decl_field_type(s.structs, oty, fa.field) != "fn[]") { return ""; }
            if (decl_type_params(s.structs, oty).len() > 0) { return ""; }
            var fr: string = decl_field_fn_ret(s.structs, oty, fa.field);
            if (fr.len() == 0) { return ""; }
            return "(" + decl_field_fn_param_types(s.structs, oty, fa.field) + ") => " + fr;
        },
        _ => {}
    }
    return "";
}

// binding_fnarr_elem is the element spelling a fn-array binding carries: its own
// annotation when it has one, else the spelling the aliased source already
// carries (`var xs = fs`, `var xs = r.hs`).
function binding_fnarr_elem(v: ast.StmtVar, s: LowerState): string {
    var own: string = fnarr_elem_of_var(v);
    if (own.len() > 0) { return own; }
    return fnarr_decl_elem(v.init, s);
}

// decl_field_fn_sig is the funcref signature tag of the fn-typed field
// struct_name.field, built from the two sidecars the parser records for it
// through the same fn_sig_of rules a fn-typed PARAM goes through — so a field
// call and a parameter call cannot disagree about the signature they dispatch
// on. "" when the field records no return, when a position is a bare type
// parameter, or when the signature is all-i32 and `$fn<N>` already names it.
pub function decl_field_fn_sig(structs: parser.StructDecl[], struct_name: string, field: string): string {
    var ret: string = decl_field_fn_ret(structs, struct_name, field);
    if (ret.len() == 0) { return ""; }
    var ptys: string = decl_field_fn_param_types(structs, struct_name, field);
    var tys: string[] = [];
    if (ptys.len() > 0) { tys = split_type_list(ptys); }
    var pd: ast.ParamDecl = fn_param_decl(field, tys, ret);
    if (pd.type_name.len() == 0) { return ""; }
    return fn_sig_of(pd, decl_type_params(structs, struct_name));
}

// field_access_is_closurearr returns true when `e` is a struct-field read
// `obj.field` whose field is a closure/fn ARRAY — spelled "fn[]"
// (parse_type_name coarsens `(() => T)[]` to "fn[]"). Its element is a closure
// box, so a local bound from the whole array (`var fns = r.hs`) or from one
// element (`var f = r.hs[0]`) must dispatch env-first — mirroring the
// is_closurearr LOCAL. Without it those calls invoke the box pointer as raw
// code and SIGSEGV (#5160 defect #2). A struct-field array of BARE named fns
// (`Reg { hs: [inc] }`) is already miscompiled at construction (a separate
// pre-existing gap), so this never regresses a working shape.
pub function field_access_is_closurearr(e: ast.Expr, s: LowerState): boolean {
    // A registered fn-POINTER array field (`hs: [inc, dbl]`) shares the "fn[]"
    // spelling with a closure array but its elements are RAW fn pointers, not env
    // boxes — the fn-pointer read paths (element bind / whole-array alias / direct
    // inline call) must win, so decline the closure classification for it. The
    // registry is threaded on s.sigs.closure_fns (fnptr_arr_fields_of markers).
    if (field_access_is_fnarr(e, s)) { return false; }
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty.len() == 0) { return false; }
            if (decl_field_type(s.structs, oty, fa.field) != "fn[]") { return false; }
            // POSITIVE evidence (#3457): the field must be PROVEN to hold env
            // boxes — an all-`__mkclo$` array literal, or a local bound to one,
            // at every construction site program-wide. The former test was
            // "fn[]" AND not-FNPTR, i.e. closure-by-elimination, which claimed
            // every field the pointer scan could not prove: a param-built or
            // loop-built POINTER array then dispatched env-first on a raw code
            // address. A field with neither marker is unproven and declines
            // here, so the dispatch falls through instead of guessing.
            return util.has_str(s.sigs.closure_fns, "CLOARR:" + oty + "." + fa.field);
        },
        _ => { return false; }
    }
}

// field_access_is_fnarr returns true when `e` is a struct-field read `obj.field`
// whose field is a registered PLAIN-fn-pointer array — spelled "fn[]" (like a
// closure array) but constructed ONLY from all-fn-value array literals
// program-wide, so its elements are raw function pointers, not `__mkclo$` env
// boxes. The registry is the whole-program fnptr_arr_fields_of scan, threaded
// through s.sigs.closure_fns as "FNPTR:<sty>.<field>" markers (which can never collide
// with a real function name, so existing closure_fns consumers are unaffected). A
// pure-type test cannot distinguish the two shapes — both are "fn[]" — hence the
// registry. Drives the raw-fn-pointer bind / alias / inline-call dispatch (plain
// call_indirect, NOT env-first) at the read sites (#5235).
pub function field_access_is_fnarr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty.len() == 0) { return false; }
            return util.has_str(s.sigs.closure_fns, "FNPTR:" + oty + "." + fa.field);
        },
        _ => { return false; }
    }
}

// decl_index_of returns the index in `structs` of the FIRST decl named `name`,
// or -1. Struct names are unique, so first-wins is exact for them; enum VARIANT
// decls are keyed by their bare name, so two enums declaring one variant name
// give two decls this cannot tell apart — resolve those through
// variant_pattern_decl_index instead.
pub function decl_index_of(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// variant_pattern_decl_index resolves the decl a variant PATTERN reads its
// payload through. `owner` is the arm's enum when it is known — the pattern's
// `Enum.` qualifier, else the scrutinee's type. Falls back to the first decl of
// that name when the owner names no such variant: a module-qualified pattern, a
// union member (`type X = A | B`, whose members are ordinary uniquely-named
// structs), or a scrutinee whose type the lowering could not recover.
pub function variant_pattern_decl_index(structs: parser.StructDecl[], name: string, owner: string): i32 {
    if (owner != "") {
        var oi: i32 = variant_decl_index(structs, name, owner);
        if (oi >= 0) { return oi; }
    }
    return decl_index_of(structs, name);
}

// variant_pattern_bare_name strips a pattern's `Enum.` / `mod.` qualifier —
// variant decls are keyed by the bare variant name. variant_pattern_qualifier
// returns the stripped qualifier, or "" for an unqualified pattern. Both take
// the LAST dot.
pub function variant_pattern_bare_name(type_name: string): string {
    var bare: string = type_name;
    var i: i32 = 0;
    while (i < type_name.len()) {
        if (type_name[i] == b'.') { bare = slice_unchecked(type_name, i + 1, type_name.len()) + ""; }
        i = i + 1;
    }
    return bare;
}

pub function variant_pattern_qualifier(type_name: string): string {
    var q: string = "";
    var i: i32 = 0;
    while (i < type_name.len()) {
        if (type_name[i] == b'.') { q = slice_unchecked(type_name, 0, i) + ""; }
        i = i + 1;
    }
    return q;
}

// variant_arm_decl_index resolves the decl a variant ARM reads its payload
// through, given the scrutinee's struct/enum type name (expr_struct_type of the
// match's scrutinee, "" when unrecoverable). The pattern's own qualifier wins
// when it names the variant's enum — a `mod.` qualifier does not, and falls
// through to the scrutinee.
pub function variant_arm_decl_index(pv: ast.PatVariant, scrut_enum: string, s: LowerState): i32 {
    var bare: string = variant_pattern_bare_name(pv.type_name);
    var owner: string = variant_pattern_qualifier(pv.type_name);
    if (variant_decl_index(s.structs, bare, owner) < 0) { owner = scrut_enum; }
    return variant_pattern_decl_index(s.structs, bare, owner);
}

// The decl accessors come in pairs: an `_at` form taking an already-resolved
// decl index, and a by-name form that resolves first-wins and delegates. A
// variant name two enums share has two decls, so anywhere the owning enum is
// known the `_at` form is the correct one — the by-name form silently answers
// for whichever enum was declared first.

// decl_at_field_type returns the type of field `index` (decl order) of the decl
// at `decl_index`, or "".
pub function decl_at_field_type(structs: parser.StructDecl[], decl_index: i32, index: i32): string {
    if (decl_index < 0 || decl_index >= structs.len()) { return ""; }
    if (index < 0 || index >= structs[decl_index].fields.len()) { return ""; }
    return structs[decl_index].fields[index].type_name;
}

// decl_field_type_at returns the type of field `index` (decl order) in struct
// `struct_name`, or "".
pub function decl_field_type_at(structs: parser.StructDecl[], struct_name: string, index: i32): string {
    return decl_at_field_type(structs, decl_index_of(structs, struct_name), index);
}

// decl_at_field_name returns the NAME of field `index` (decl order) of the decl
// at `decl_index`, or "".
pub function decl_at_field_name(structs: parser.StructDecl[], decl_index: i32, index: i32): string {
    if (decl_index < 0 || decl_index >= structs.len()) { return ""; }
    if (index < 0 || index >= structs[decl_index].fields.len()) { return ""; }
    return structs[decl_index].fields[index].name;
}

// decl_field_name_at returns the NAME of field `index` (decl order) in struct
// `struct_name`, or "". The name-side twin of decl_field_type_at — used by the
// per-backend struct-drop generators to key a field against the fn-pointer-array
// registry ("FNPTR:<sty>.<field>") so a plain-fn-pointer array field leaks instead
// of being walked as a box array (its elements are raw code addresses).
pub function decl_field_name_at(structs: parser.StructDecl[], struct_name: string, index: i32): string {
    return decl_at_field_name(structs, decl_index_of(structs, struct_name), index);
}

// decl_at_payload_type returns the type of an enum variant decl's payload field
// `index` — the parser desugars a variant's payloads to fields `__ev`, `__ev1`,
// … in order. "" when the decl is not an enum variant: a union member
// (`type X = A | B`) is an ordinary struct whose fields have real names.
pub function decl_at_payload_type(structs: parser.StructDecl[], decl_index: i32, index: i32): string {
    if (decl_at_field_name(structs, decl_index, 0) != "__ev") { return ""; }
    return decl_at_field_type(structs, decl_index, index);
}

// decl_at_field_count returns the field count of the decl at `decl_index`.
pub function decl_at_field_count(structs: parser.StructDecl[], decl_index: i32): i32 {
    if (decl_index < 0 || decl_index >= structs.len()) { return 0; }
    return structs[decl_index].fields.len();
}

// field_type_width classifies a field's declared type as a load/store width for
// op_struct_get / op_struct_set: 64 for the 8-byte types, else 0 (i32-shaped).
// Drives wasm's f64.load/store vs i32.load/store selection (register backends
// ignore it).
function field_type_width(t: string): i32 {
    if (t == "f64" || t == "f32" || t == "float" || t == "i64" || t == "u64") { return 64; }
    return 0;
}

// struct_field_at_width is struct_field_width asked of an already-resolved decl.
pub function struct_field_at_width(structs: parser.StructDecl[], decl_index: i32, index: i32): i32 {
    return field_type_width(decl_at_field_type(structs, decl_index, index));
}

pub function struct_field_width(structs: parser.StructDecl[], struct_name: string, index: i32): i32 {
    return field_type_width(decl_field_type_at(structs, struct_name, index));
}

// struct_field_is_i64 reports whether field `index` of `struct_name` is i64 (an
// 8-byte INTEGER field — i64.load/store on wasm, vs f64.load/store for f64).
pub function struct_field_is_i64(structs: parser.StructDecl[], struct_name: string, index: i32): boolean {
    var ft64: string = decl_field_type_at(structs, struct_name, index);
    return ft64 == "i64" || ft64 == "u64";
}

// struct_field_at_is_i64 is the same question asked of an already-resolved decl.
pub function struct_field_at_is_i64(structs: parser.StructDecl[], decl_index: i32, index: i32): boolean {
    var fw: string = decl_at_field_type(structs, decl_index, index);
    return fw == "i64" || fw == "u64";
}

pub function (s: LowerState) field_index_in(struct_name: string, field: string): i32 {
    return decl_field_index(s.structs, struct_name, field);
}

// is_builtin_pattern reports whether a match pattern names a built-in Option /
// Result / bool variant — these discriminate on an i32 tag at offset 0 (not the
// user-enum struct shape). The StmtMatch lowering uses this to route them to the
// tag-test arm shape (true/false test the 0/1 scrutinee directly; Some/Ok/Err
// bind their payload via opt_payload once the scrutinee's Option/Result type is
// recovered) instead of the variant_is path it uses for user enums. Only a
// payload whose type can't be recovered, or a non-scalar/-string payload, still
// bails from there.
pub function is_builtin_pattern(name: string): boolean {
    return name == "Some" || name == "None" || name == "Ok" || name == "Err"
        || name == "true" || name == "false";
}

// is_builtin_variant_pattern answers the question the match lowering actually
// has: does this arm name a BUILT-IN variant, or a user enum's variant that
// merely shares the name? A user enum may declare `Ok` / `Some` / `Err` /
// `None`, and the name alone cannot tell them apart.
//
// Ownership alone cannot either, and getting that wrong is worse than the bug
// it fixes: once ANY enum in the program declares `Some`, a name-owned test
// sends every `Some` arm down the user path — including one matching a genuine
// `Option`, which then silently answers wrong.
//
// So it takes the SCRUTINEE. `scrut_struct` is the scrutinee's struct/enum type
// (`expr_struct_type`), which is empty for a real Option/Result — those locals
// carry an `opt_type` instead. A shadowing user variant is preferred only when
// the value being matched is a struct-typed enum value; anything else keeps the
// builtin tag-test shape.
pub function is_builtin_variant_pattern(structs: parser.StructDecl[], name: string, scrut_struct: string): boolean {
    if (!is_builtin_pattern(name)) { return false; }
    if (variant_enum_owner(structs, name) == "") { return true; }
    return scrut_struct == "";
}

pub function decl_field_count(structs: parser.StructDecl[], struct_name: string): i32 {
    for sd in structs {
        if (sd.name == struct_name) { return sd.fields.len(); }
    }
    return 0;
}

// iife_lambda_composite_struct_type recovers the STRUCT / NOMINAL-ENUM result type
// name of a match-EXPRESSION IIFE lambda whose body is a single StmtMatch — for an
// UNANNOTATED `var p = match (e) { V(q) => q, .. }` where the leaf is a bare bound
// payload (q not in scope at the binding site, so the leaf-based recovery returns
// ""). Returns "" for a tuple result (the tuple path types `p` via mark_tuple_elems)
// or any non-match / non-composite body. Defined ahead of expr_struct_type; the
// composite-result scan it delegates to lives later in the file (forward reference).
function iife_lambda_composite_struct_type(lam: ast.ExprLambda, s: LowerState): string {
    if (lam.body.len() != 1) { return ""; }
    match (lam.body[0]) {
        ast.StmtMatch(mm) => {
            var ct: string = iife_match_composite_result_type(mm, s);
            if (ct == "") { return ""; }
            // Only a struct / nominal-enum NAME types via expr_struct_type's result;
            // a tuple tag list is handled by the mark_tuple_elems slot path.
            if (decl_is_struct(s.structs, ct) || is_enum_like_name(ct, s.structs)) { return ct; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// iife_lambda_composite_tuple_tags recovers the comma-joined TUPLE element TAGS
// (mark_tuple_elems form) of a match-EXPRESSION IIFE lambda whose result is a tuple
// returned whole — the tuple sibling of iife_lambda_composite_struct_type, for an
// UNANNOTATED `var t = match (e) { V(p) => p, .. }`. Returns "" for a struct / enum
// result (typed via mark_struct_type) or a non-match / non-composite body.
function iife_lambda_composite_tuple_tags(lam: ast.ExprLambda, s: LowerState): string {
    if (lam.body.len() != 1) { return ""; }
    match (lam.body[0]) {
        ast.StmtMatch(mm) => {
            var ct: string = iife_match_composite_result_type(mm, s);
            if (ct == "") { return ""; }
            if (iife_result_is_tuple(ct, s)) { return ct; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// expr_struct_type returns the struct type name an expression evaluates to, or
// "" — a struct literal's type, or a struct-tracked local/param slot.
// struct_tag_from_ty admits a checker-stamped tag when it names a known struct
// or nominal enum — the same guard every structural case of expr_struct_type
// applies. The scalar tag vocabulary is rejected FIRST: is_enum_like_name's
// exclusion list holds only the spellings declarations use, so a checker tag
// like "u64" (which no declaration walk ever produced here) would read as
// enum-like and type a cast/overload result as a struct (#5986).
function struct_tag_from_ty(ty: string, s: LowerState): string {
    if (ty == "" || is_int_irtag(ty) || ty == "char" || ty == "f64" || ty == "string") { return ""; }
    if (decl_is_struct(s.structs, ty) || is_enum_like_name(ty, s.structs)) { return ty; }
    return "";
}

pub function expr_struct_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprStructLit(sl) => { return sl.type_name; },
        ast.ExprIdent(id) => {
            var idsl: i32 = s.slot_of(id.name);
            // An ARRAY slot's local_struct_type holds its ELEMENT struct type
            // (for `arr[i]` recovery below), NOT the slot's own type — the array
            // value itself is not a struct, so report "".
            if (s.is_arr_slot(idsl)) { return ""; }
            return s.struct_type_of_slot(idsl);
        },
        ast.ExprIndex(ix) => {
            // Indexing a struct ARRAY `arr[i]` evaluates to the element struct
            // type, carried in the (is_arr) array slot's local_struct_type. Lets
            // `arr[i].field` / `arr[i].method()` resolve without an intermediate
            // typed local. i32[]/string[] arrays carry "" → not a struct.
            match (ix.array) {
                ast.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (s.is_arr_slot(asl)) { return s.struct_type_of_slot(asl); }
                },
                // `p.items[i]` where p's field `items` is a `P[]` struct-array or
                // `C[]` enum-array field → the element type (so `p.items[i].field`
                // / `p.items[i].method()` resolve; an enum element dispatches to
                // `<Enum>.<method>`, the field analog of the local enum-array case).
                ast.ExprFieldAccess(fa) => {
                    // `t.N[i]` where `t.N` is a struct-ARRAY tuple element
                    // (`([P { .. }], x)`): the element's recorded tuple tag is
                    // `P[]`, so `t.N[i].field` recovers the element struct type —
                    // the tuple-element sibling of the struct-field-array case
                    // below. #3353.
                    if (util.is_all_digits(fa.field)) {
                        var ttag: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                        if (ttag.len() >= 3 && slice_unchecked(ttag, ttag.len() - 2, ttag.len()) == "[]") {
                            var telt: str = slice_unchecked(ttag, 0, ttag.len() - 2);
                            if (decl_is_struct(s.structs, telt) || is_enum_like_name(telt, s.structs)) { return telt + ""; }
                        }
                        return struct_tag_from_ty(ix.ty, s);
                    }
                    var oty: string = expr_struct_type(fa.obj, s);
                    if (oty != "") {
                        var ft: string = decl_field_type(s.structs, oty, fa.field);
                        if (ft.len() >= 3 && slice_unchecked(ft, ft.len() - 2, ft.len()) == "[]") {
                            var elt: str = slice_unchecked(ft, 0, ft.len() - 2);
                            if (decl_is_struct(s.structs, elt) || is_enum_like_name(elt, s.structs)) { return elt + ""; }
                        }
                    }
                },
                // `a[i][j]` where `a` is a `T[][]` of structs/enums → the innermost
                // element type, so `a[i][j].field` / `a[i][j].method()` resolve
                // without an intermediate typed local (the depth-2 sibling of the
                // `arr[i]` ExprIdent case above). The element struct/enum name is
                // recorded on the T[][] slot's local_struct_type at declaration; a
                // plain i32[][]/f64[][] element carries "" → unaffected.
                ast.ExprIndex(inner) => {
                    match (inner.array) {
                        ast.ExprIdent(aaid) => {
                            var aasl: i32 = s.slot_of(aaid.name);
                            if (s.is_arrarr_slot(aasl)) {
                                var aaty: string = s.struct_type_of_slot(aasl);
                                if (aaty != "" && (decl_is_struct(s.structs, aaty) || is_enum_like_name(aaty, s.structs))) { return aaty; }
                            }
                        },
                        // `h.g[i][j].field` where `g` is a `T[][]` struct FIELD (the
                        // field sibling of the local-arrarr case above): resolve the
                        // field's declared type, strip BOTH `[]` to the element struct/
                        // enum name so `.field` resolves. Without it the second index of
                        // a struct-array-of-arrays field had no element type and bailed.
                        ast.ExprFieldAccess(ffa) => {
                            if (!util.is_all_digits(ffa.field)) {
                                var foty: string = expr_struct_type(ffa.obj, s);
                                if (foty != "") {
                                    var fft: string = decl_field_type(s.structs, foty, ffa.field);
                                    if (fft.len() >= 4 && slice_unchecked(fft, fft.len() - 2, fft.len()) == "[]") {
                                        var inner1: str = slice_unchecked(fft, 0, fft.len() - 2);
                                        if (inner1.len() >= 3 && slice_unchecked(inner1, inner1.len() - 2, inner1.len()) == "[]") {
                                            var elt2: str = slice_unchecked(inner1, 0, inner1.len() - 2);
                                            if (decl_is_struct(s.structs, elt2) || is_enum_like_name(elt2, s.structs)) { return elt2 + ""; }
                                        }
                                    }
                                }
                            }
                        },
                        _ => {}
                    }
                },
                // `mk()[i].field` — field on a struct ELEMENT indexed directly from a
                // function that returns a struct ARRAY (`P[]`). struct_ret_type for a
                // P[]-returning free fn already records the ELEMENT type "P" (the
                // registry strips "[]", #3035), so recover it for `mk()[i]` — the
                // call sibling of the `arr[i]` ExprIdent case above. A METHOD callee
                // (`h.get()[i].field`) keys the same registry by the qualified
                // "<Type>.<method>", the spelling the method arm below already uses.
                ast.ExprCall(cc) => {
                    match (cc.callee) {
                        ast.ExprIdent(ccid) => {
                            var crt: string = s.struct_ret_type(ccid.name);
                            if (crt != "" && (decl_is_struct(s.structs, crt) || is_enum_like_name(crt, s.structs))) { return crt; }
                        },
                        ast.ExprFieldAccess(ccfa) => {
                            var ccrt: string = expr_struct_type(ccfa.obj, s);
                            if (ccrt != "") {
                                var cmrt: string = s.struct_ret_type(ccrt + "." + ccfa.field);
                                if (cmrt != "" && (decl_is_struct(s.structs, cmrt) || is_enum_like_name(cmrt, s.structs))) { return cmrt; }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            // typed-IR (#5986): a struct element indexed out of an array no walk
            // case reaches (a sliced base, an IIFE array) answers from the
            // checker-stamped element tag.
            return struct_tag_from_ty(ix.ty, s);
        },
        ast.ExprFieldAccess(fa) => {
            // A struct-typed tuple element `t.N`, or a struct-typed field read
            // `obj.f` (which is what enables nested access `b.p.x`). "" when
            // neither names a known struct. typed-IR (#5986): fa_type_tag falls
            // back to the checker-stamped tag when the declaration walk cannot
            // recover obj's own struct type, so a field read off a call / map /
            // generic receiver resolves instead of silently yielding "".
            var ft: string = fa_type_tag(fa, s);
            if (decl_is_struct(s.structs, ft)) { return ft; }
            return "";
        },
        ast.ExprCall(c) => {
            // typed-IR (#5531): the annotate pass stamps c.ty with the checker's
            // inferred result type; for a struct-returning call that is the struct
            // NAME. Trust it when it names a known struct, retiring the
            // struct_ret_type re-derivation below for annotated calls. Guarded to a
            // known struct so a scalar/"" tag (or an enum, not covered here) falls
            // through to the structural walk unchanged.
            if (c.ty != "" && decl_is_struct(s.structs, c.ty)) { return c.ty; }
            // A call to a struct-returning function evaluates to that struct type
            // (so `var p = make()` / `var p = obj.make()` then `p.x` resolves).
            match (c.callee) {
                ast.ExprIdent(id) => {
                    // Built-in `subprocess(cmd, args, stdin)` returns a bare
                    // ProcessResult struct (no Result wrapper), so type it directly
                    // here — the analog of stat's opt_ret_type, for a struct-valued
                    // builtin: `var r = subprocess(..)` marks r ProcessResult so
                    // `r.stdout` / `r.exit_code` resolve.
                    if (id.name == "subprocess" && c.args.len() == 3) { return "ProcessResult"; }
                    // An erased-generic `T[]` return (`idf[T](arr: T[]): T[]`):
                    // the result's ELEMENT type is the ELEMENT type of argument i.
                    // arr_elem_index_expr asks that question the same way the
                    // ExprIndex arm above answers it, so a struct / enum / dyn
                    // element all resolve identically to a concrete `P[]` return.
                    // Without it an UNANNOTATED `var s = idf(xs)` lost `s[i]`'s
                    // type and bailed the caller.
                    var gsa: i32 = struct_ret_argref(s, id.name);
                    if (gsa >= 0 && gsa < c.args.len()) {
                        return expr_struct_type(arr_elem_index_expr(c.args[gsa]), s);
                    }
                    return s.struct_ret_type(id.name);
                },
                ast.ExprFieldAccess(fa) => {
                    // `ps.first()` / `.last()` on a struct/enum ARRAY evaluates to
                    // the element type, exactly as `ps[0]` does — so
                    // `ps.last().field` / `ps.last().method()` resolve.
                    if (arr_firstlast_call(fa.field, fa.obj, c.args.len(), s)) {
                        return expr_struct_type(arr_elem_index_expr(fa.obj), s);
                    }
                    // Associated-function call `Type.make()` / `Enum.default()` —
                    // the object is a bare TYPE name (struct or enum), not a local
                    // slot. Key the return type by "<Type>.<method>" directly via
                    // the registry (struct_ret_fns now records enum returns too).
                    // A non-empty result both recovers the constructed type — so
                    // `Type.make(..).x` and an inferred `var p = Type.make(..)` /
                    // `var e = Enum.default()` resolve — AND distinguishes the
                    // associated call from a module call `mod.func()` (whose key
                    // is the bare `func`, never `mod.func`, so it returns "").
                    match (fa.obj) {
                        ast.ExprIdent(tid) => {
                            if (s.slot_of(tid.name) < 0) {
                                var art: string = s.struct_ret_type(tid.name + "." + fa.field);
                                if (art != "") { return art; }
                            }
                        },
                        _ => {}
                    }
                    // `m.get_or(k, d)` on a `Map[K, V]` whose VALUE is a struct
                    // evaluates to V, so an UNANNOTATED `var p = m.get_or(…)` types
                    // `p` and `p.field` resolves. get_or_recv_map_type is the same
                    // receiver resolver the map-op lowering itself dispatches on, so
                    // the two cannot disagree about what the receiver is. Without
                    // this the read had no struct type and bailed the function to the
                    // AST emitter — annotating `p` was the only way through (#3457).
                    if (fa.field == "get_or" && c.args.len() == 2) {
                        var mvt: string = map_value_of(get_or_recv_map_type(fa.obj, s));
                        if (decl_is_struct(s.structs, mvt)) { return mvt; }
                    }
                    // `it.value()` / `it.key()` on a `MapIter[K, V]` evaluates to V
                    // / K, so `it.value().field` and `it.key().field` resolve a
                    // struct's fields — the iterator siblings of the get_or
                    // recovery just above. All three read a map's K or V through
                    // different receivers, and only get_or had it: an
                    // `it.value().n` over a Map[K, Struct] had no struct type here
                    // and bailed the function, even with the MapIter ANNOTATED
                    // (#6007, #6119).
                    if ((fa.field == "value" || fa.field == "key") && c.args.len() == 0) {
                        match (fa.obj) {
                            ast.ExprIdent(mvid) => {
                                var mvsl: i32 = s.slot_of(mvid.name);
                                if (mvsl >= 0) {
                                    var mvit: string = s.map_type_of(mvsl);
                                    if (is_mapiter_type_name(mvit)) {
                                        var mvkv: string = mapiter_value_of(mvit);
                                        if (fa.field == "key") { mvkv = mapiter_key_of(mvit); }
                                        if (decl_is_struct(s.structs, mvkv)) { return mvkv; }
                                    }
                                }
                            },
                            _ => {}
                        }
                    }
                    // Method call `obj.make()` → key by "<Type>.<method>".
                    var rty: string = expr_struct_type(fa.obj, s);
                    if (rty == "") { return ""; }
                    return s.struct_ret_type(rty + "." + fa.field);
                },
                // An if-/match-EXPRESSION value (`(if (c) { P{..} } else { .. }).x`)
                // — a 0-arg IIFE; its struct type is the leaf branch's struct type
                // (iife_leaf_value unwraps any nesting), so a direct `.field` /
                // `.method()` on it resolves. When the leaf is a BARE bound payload
                // (`match (e) { V(q) => q, .. }`, q not in scope at this site), fall
                // back to the match's composite result type (struct / enum NAME) so an
                // UNANNOTATED `var p = match … { V(q) => q, N => P {..} }` still types
                // `p` for `p.field` / `match (p)`.
                ast.ExprLambda(ilam) => {
                    var lst: string = expr_struct_type(iife_leaf_value(e), s);
                    if (lst != "") { return lst; }
                    return iife_lambda_composite_struct_type(ilam, s);
                },
                _ => { return ""; }
            }
        },
        ast.ExprBinary(opb) => {
            // Composite operator overload result (#2706): `a <op> b` evaluates to
            // the overload method's return struct type, so `var c = a + b` /
            // `(a + b).x` type `c` / the field read as a struct. The method's
            // declared return (`struct_ret_type("<T>.<method>")`) is authoritative;
            // for the Num-style Self-returning overloads it equals the left
            // operand's struct type, the fallback when the registry has no entry.
            if (binop_overload_method(opb.op) != "") {
                var olt: string = expr_struct_type(opb.left, s);
                if (decl_is_struct(s.structs, olt)) {
                    // A struct result only when the type actually defines the
                    // overload method (struct-returning). No method ⇒ "" — an
                    // invalid program the lowering bails on, kept consistent
                    // here so a consumer never types the result as a struct.
                    return s.struct_ret_type(olt + "." + binop_overload_method(opb.op));
                }
            }
            // typed-IR (#5986): a struct-returning overload whose LEFT operand's
            // struct type is not walk-recoverable answers from the stamp; the
            // known-struct guard keeps every scalar-overload result out.
            return struct_tag_from_ty(opb.ty, s);
        },
        ast.ExprUnary(opu) => {
            // Composite unary minus result: `-a` evaluates to `a.neg()`'s return
            // struct type, the unary sibling of the binary-overload result type
            // above (again "" when the type has no `neg`).
            if (opu.op == "-") {
                var out0: string = expr_struct_type(opu.operand, s);
                if (decl_is_struct(s.structs, out0)) {
                    return s.struct_ret_type(out0 + ".neg");
                }
            }
            // The unary sibling of the binary-overload tag fallback above (#5986).
            return struct_tag_from_ty(opu.ty, s);
        },
        _ => { return ""; }
    }
    return "";
}

// arr_tag_of recovers the ARRAY-type spelling of an expression used as the base
// of an index (`<base>[i]`): a local, a struct field, a tuple element, or
// another index — `aoa[i][j]`'s base `aoa[i]` is one `[]` off `aoa`'s own tag.
// "" when it cannot.
//
// It exists because the two Option/Result scrutinee resolvers each enumerated
// only `ExprIdent` and a named-field `ExprFieldAccess` here, so `aoa[i][j]` and
// `t.N[i]` resolved to "" and bailed the enclosing function (found by auditing
// under FERN_STRICT_IR — #5646 option 3). The struct-element
// sibling of this walk already lives in expr_struct_type, which is why
// `t.N[i].field` resolved while `match (t.N[i])` on an Option element did not.
function arr_tag_of(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprIdent(aid) => { return s.opt_type_of_slot(s.slot_of(aid.name)); },
        ast.ExprFieldAccess(afa) => {
            if (util.is_all_digits(afa.field)) { return expr_tuple_elem_tag(afa.obj, util.digits_to_i32(afa.field), s); }
            var oty: string = expr_struct_type(afa.obj, s);
            if (oty == "") { return ""; }
            return decl_field_type(s.structs, oty, afa.field);
        },
        ast.ExprIndex(aix) => { return strip_arr_suffix(arr_tag_of(aix.array, s)); },
        // A sliced base (`a[lo:hi][i]`): slicing preserves the array type, and
        // ExprSlice.ty is the one carrier with a dedicated array spelling —
        // type_to_arrtag stamps the SOURCE array's tag, exactly what this walk
        // wants. Walk first, tag fills the hole (#5986).
        ast.ExprSlice(asl) => {
            var slt: string = arr_tag_of(asl.array, s);
            if (slt != "") { return slt; }
            return asl.ty;
        },
        _ => { return ""; }
    }
}

// strip_arr_suffix removes one trailing "[]" from a type tag; "" when the tag
// is not an array type.
function strip_arr_suffix(tag: string): string {
    if (tag.len() >= 2 && slice_unchecked(tag, tag.len() - 2, tag.len()) == "[]") { return slice_unchecked(tag, 0, tag.len() - 2) + ""; }
    return "";
}

// opt_elem_of is an array tag's element type when that element is an
// Option/Result, else "".
function opt_elem_of(tag: string): string {
    var elt: string = strip_arr_suffix(tag);
    if (elt.len() >= 8 && (slice_unchecked(elt, 0, 7) == "Option[" || slice_unchecked(elt, 0, 7) == "Result[")) { return elt + ""; }
    return "";
}

// unary_opt_type is the Option/Result type a cast's unary tag denotes. The
// parser emits two disjoint spellings (parser.fern, the `as` branch):
//
//   `e as? T`          -> `as?_T`            — the dyn-Trait downcast, Option[T]
//   `e as Option[T]`   -> `as_Option[T]`     — a plain ascription, the tag IS the type
//
// Only the downcast was enumerated, so `match (None as Option[i32])` resolved
// to "" and bailed the enclosing function (#5646 option 3).
// The sibling ascription shapes already lowered because they bind or return
// through an annotation that carries the payload type; this one is the
// value-position match, where the cast is the only place the type is written.
function unary_opt_type(op: string): string {
    if (op.len() > 4 && slice_unchecked(op, 0, 4) == "as?_") { return "Option[" + slice_unchecked(op, 4, op.len()) + "]"; }
    if (op.len() > 3 && slice_unchecked(op, 0, 3) == "as_") {
        var at: str = slice_unchecked(op, 3, op.len());
        if (at.len() >= 8 && (slice_unchecked(at, 0, 7) == "Option[" || slice_unchecked(at, 0, 7) == "Result[")) { return at + ""; }
    }
    return "";
}

// expr_is_boolarr reports whether `e` is a `boolean[]`. The dispatch-only
// sibling of expr_is_strarr / expr_is_f64arr / expr_is_i64arr — see
// LocalInfo.is_boolarr for why it steers nothing but the element's method key.
//
// A boolean array LITERAL is recognised structurally rather than through the
// slot, so `[true, false].to_json()` and the `var bs = [true, false]` binding
// that seeds the slot both resolve. An empty literal is not one: it carries no
// element evidence, and i32 is the safe default. #6117.
pub function expr_is_boolarr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprIdent(id) => { return s.is_boolarr_slot(s.slot_of(id.name)); },
        ast.ExprArray(a) => {
            if (a.elements.len() == 0) { return false; }
            return expr_is_bool(a.elements[0], s);
        },
        ast.ExprFieldAccess(_) => { return scalar_arr_field_type(e, s) == "boolean[]"; },
        _ => { return false; }
    }
    return false;
}

// expr_is_bool reports whether `e` is a statically-boolean value, so a method
// call on it dispatches "boolean.<m>" (its own Display / Json impl) instead of
// falling through to "i32.<m>" — which renders a bool as 1/0 (a `@derive(Json)`
// struct's boolean field serialised `"ok":1` instead of `"ok":true`). Covers a
// boolean literal, a boolean-typed struct field (the derived `self.field.to_json()`
// path), an ELEMENT of a boolean[] (#6117, see the ExprIndex arm), a boolean
// LOCAL or PARAM (#6305, the ExprIdent arm — including a `for` loop variable
// over a boolean[] and an enum payload binding, both of which mark their slot),
// a comparison / logical result, and a `!` negation.
//
function expr_is_bool(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprBool(_) => { return true; },
        // A local / param declared or inferred boolean carries the fact on its
        // slot flag (LocalInfo.is_bool, #6305); a bare `const` has no slot at
        // all and reads its type from the annotation instead (id_type_tag).
        ast.ExprIdent(id) => { return s.is_bool_slot(s.slot_of(id.name)) || id_type_tag(id, s) == "boolean"; },
        // A boolean-RETURNING call, free or method. Without this the receiver
        // takes expr_scalar_type's "i32" default and `.to_string()` renders
        // 1/0 — the struct-field case this function's doc already describes,
        // one expression kind over. A method is keyed by its receiver's base
        // type, so a name shared across receivers cannot answer for another.
        ast.ExprCall(bc) => {
            // typed-IR (#5986): the checker's stamped result type answers where
            // the registry cannot key the callee (a closure-typed local, an IIFE).
            match (bc.callee) {
                ast.ExprIdent(bcid) => {
                    return sig_reg_has_exact(s.sigs.bool_ret_fns, bcid.name) || bc.ty == "boolean";
                },
                ast.ExprFieldAccess(bcfa) => {
                    var brecv: string = expr_struct_type(bcfa.obj, s);
                    if (brecv.len() == 0) { return bc.ty == "boolean"; }
                    return sig_reg_has_exact(s.sigs.bool_ret_fns, brecv + "." + bcfa.field) || bc.ty == "boolean";
                },
                _ => { return bc.ty == "boolean"; }
            }
        },
        // A composite `neg` overload can return boolean; only the checker's tag
        // can see it (#5986) — the unary sibling of the ExprBinary arm below.
        ast.ExprUnary(u) => { return u.op == "!" || u.ty == "boolean"; },
        // An element of a boolean[] is a boolean, so `bs[i].to_json()` keys
        // "boolean.to_json" instead of rendering 1/0 through i32's impl. The
        // structural walk runs first and the checker's stamped tag fills its
        // holes — the same ordering rule, for the same reason, as ix_type_tag
        // (which this deliberately does NOT go through: that helper resolves
        // element WIDTH, and boolean-ness is not a width). #6117.
        ast.ExprIndex(ix) => { return expr_is_boolarr(ix.array, s) || ix.ty == "boolean"; },
        ast.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||") { return true; }
            // An arithmetic operator overload can return boolean too (#5986).
            return b.ty == "boolean";
        },
        // A boolean tuple element `t.N` or struct field `p.b`, resolved through
        // the same shared leaf as the numeric-kind predicates (#5520): the
        // declaration walk first, the checker-stamped fa.ty filling its holes.
        ast.ExprFieldAccess(fa) => { return fa_type_tag(fa, s) == "boolean"; },
        _ => { return false; }
    }
    return false;
}

// expr_recv_prim_type returns the PRIMITIVE receiver type name of a method
// call's receiver `e` (for `impl Trait for i32/string/i64/f64/boolean`
// dispatch), or "" if `e` is a struct (handled by expr_struct_type) or
// otherwise not a dispatchable primitive receiver. Strings / i64 / f64 / a
// statically-boolean value are detected precisely via the existing predicates;
// any other scalar defaults to "i32". This only drives the call-site label: a
// label naming a non-existent method bails the whole module
// (calls_only_known), so an over-broad "i32" guess is safe, never a miscompile.
// expr_scalar_type returns the scalar/string type of `e` — the single
// classifier the per-type predicates (expr_is_str / expr_is_f64 / …) fold into.
// This is the first seam of the typed-IR migration (fragility #3): today it is
// the cascade lifted verbatim from expr_recv_prim_type, so callers stop chaining
// the individual predicates; later slices can cache/annotate its result instead
// of re-deriving. It assumes `e` is not a struct/enum receiver (the caller
// excludes those — see expr_recv_prim_type); a non-scalar falls through to "i32".
pub function expr_scalar_type(e: ast.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    // f32 BEFORE f64: an f32 value is also is_f64 (stored 8-byte), but its
    // method dispatch must key "f32.<m>" (distinct from f64 for to_string/etc.).
    if (expr_is_f32(e, s)) { return "f32"; }
    if (expr_is_f64(e, s)) { return "f64"; }
    // u64 BEFORE the i64 width fallback: a u64 value is also width-64, but its
    // method dispatch must key "u64.<m>" (std/u64's methods are recorded under
    // their u64 base type) — without this a u64 receiver dispatched to the
    // nonexistent "i64.<m>" and bailed the whole module to AST. Mirrors
    // method_recv_tyname's u64 branch.
    if (expr_is_u64(e, s)) { return "u64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    // u32 BEFORE the "i32" fallback: a u32 value is width-32 (so it escapes the
    // width-64 checks above), but its method dispatch must key "u32.<m>" — std/u32's
    // methods are recorded under their u32 base type. Without this a u32 receiver
    // silently dispatched to the SIGNED "i32.<m>" (which std/i32 also defines, so
    // calls_only_known passed and the module did NOT bail — a real miscompile, not
    // a refused lowering): abs_diff used a signed compare, midpoint a sign-extending
    // (arithmetic) `>>`. Both diverge from the unsigned answer once bit 31 is set.
    // Mirrors the expr_is_u64 branch just above.
    if (expr_is_u32(e, s)) { return "u32"; }
    // A boolean value dispatches "boolean.<m>" (its Display / Json impl), not
    // the "i32.<m>" fallback that would render it as 1/0. Placed last: the
    // width/unsigned checks above never match a boolean, and "boolean.<m>"
    // resolves for the methods a bool actually has (to_string / to_json /
    // to_debug / eq) — any other keys an absent label and bails, safe.
    if (expr_is_bool(e, s)) { return "boolean"; }
    if (expr_is_char(e, s)) { return "char"; }
    return "i32";
}

// expr_is_char reports whether `e` is a statically-`char` value, so a method on
// it dispatches "char.<m>" (std/unicode's to_upper / to_lower / …) rather than
// falling through to expr_scalar_type's "i32" default — which keys the absent
// `i32.to_upper` and refuses the module. DISPATCH-ONLY, exactly like
// expr_is_bool: a char is an i32 value in an i32 slot, and nothing about its
// storage, width or rc differs.
function expr_is_char(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        // `97 as char` — an ascription cast, ExprUnary with an `as_<T>` op.
        ast.ExprUnary(u) => { return u.op == "as_char"; },
        _ => { return false; }
    }
    return false;
}

pub function expr_recv_prim_type(e: ast.Expr, s: LowerState): string {
    // A struct receiver is NOT a primitive — let the struct path handle it.
    if (expr_struct_type(e, s) != "") { return ""; }
    // An enum value is not a primitive either: a variant construction `V(x)`
    // (call to a variant-struct name) or a unit variant `V` (bare ident naming
    // one). Returning "" bails the module rather than mis-dispatching to
    // `i32.<method>` — its `<Enum>.<method>` dispatch needs the variant->enum
    // map (a later slice). An enum value held in a LOCAL is dispatched earlier
    // via expr_struct_type (the local carries the enum name).
    match (e) {
        ast.ExprCall(vc) => {
            match (vc.callee) {
                ast.ExprIdent(vci) => { if (decl_is_struct(s.structs, vci.name)) { return ""; } },
                _ => {}
            }
        },
        ast.ExprIdent(uvi) => { if (decl_is_struct(s.structs, uvi.name)) { return ""; } },
        _ => {}
    }
    // A BYTE receiver keys "u8.<m>", not the "i32.<m>" expr_scalar_type falls
    // through to. Same reason the u32 / u64 branches exist there: std/i32's 21
    // ascii classifiers are declared on `u8` now (#5629), so an i32 key misses
    // and bails the module. expr_subword_kind sees through an `as u8`
    // cast as well as a tracked slot, so `(b as u8).is_ascii_digit()` — the
    // shape a byte pulled out of i32 arithmetic takes — resolves too.
    if (expr_subword_kind(e, s) == "u8") { return "u8"; }
    // `s[i].is_ascii_alnum()` — indexing a STRING yields a byte (#5629), but
    // expr_subword_kind's index arm reads the ARRAY's slot kind, and a string
    // slot carries none. Resolved here rather than there so the byte-ness of a
    // string index stays a dispatch fact and does not start driving
    // expr_subword_kind's arithmetic width-wrap.
    match (e) {
        ast.ExprIndex(bix) => {
            if (expr_is_str(bix.array, s)) { return "u8"; }
            // `a[i]` over an f32[] keys "f32.<m>". Resolved here for exactly the
            // reason the string-index byte above is: it has to stay a DISPATCH
            // fact. Teaching expr_is_f32 or ix_type_tag about f32[] elements
            // instead reached real codegen — f32 arithmetic rounds through a
            // demote/promote pair, and expr_is_f64 reads ix_type_tag for the
            // RETURN width — which emitted an invalid wasm module ("expected
            // f64, found i32") for `at(a: f32[], i: i32): f32 { return a[i]; }`.
            if (expr_is_f32arr_src(bix.array, s)) { return "f32"; }
        },
        _ => {}
    }
    // Arrays / tuples / maps aren't primitive receivers either; their builtin
    // methods (.len / .append / map ops) are intercepted before this fallback.
    //
    // An ARRAY receiver that gets this far has NOT been intercepted, which
    // means the monomorphiser failed to rewrite the call into its folded
    // `__arrm_<m>` form (a method carrying a bounded EXTRA type param is
    // excluded from the fold, for instance). Falling through would answer
    // "i32" for it — expr_scalar_type's last resort — and dispatch
    // `i32.<m>`. When std/i32 happens to own that verb the call SILENTLY
    // lands on the integer routine with an array pointer as its receiver:
    // strict-IR is satisfied because a symbol of that name resolved, so
    // nothing reports it and only an oracle comparison sees the wrong
    // answer. Refusing bails the module with a diagnostic naming the site
    // instead. Same failure this function's u8 / expr_scalar_type's u32 and
    // u64 branches exist to prevent, one receiver kind further out.
    //
    // An array-of-array struct FIELD read is the same hazard reached by a
    // different route: the ownership-carrying predicates above all report false
    // for a field read by design, so a `T[][]` field receiver whose method the
    // intercepts did not claim would take the "i32" fallback too. `rotate_left`
    // / `rotate_right` are declared on BOTH std/array and std/i32, so that is a
    // live silent mis-dispatch rather than a hypothetical one.
    if (expr_is_arr_src(e, s) || expr_is_strarr(e, s)
        || expr_is_f64arr(e, s) || expr_is_i64arr(e, s)
        || nested_arr_field_read_type(e, s) != "") {
        return "";
    }
    return expr_scalar_type(e, s);
}

// emit_i32_minmax_slots emits the branchless i32 min/max of two values already
// stored in locals `aslot` / `bslot`, leaving the result on the stack. No
// helper call, no need/globls plumbing — pure ops every backend has:
//   mask = 0 - (a < b)   (0 or all-ones)
//   min  = b ^ ((a ^ b) & mask)    max = a ^ ((a ^ b) & mask)
// When a < b the mask is all-ones so `b ^ (a^b)` = a (min) / `a ^ (a^b)` = b
// (max); otherwise the mask is 0 and the "keep" operand passes through. Uses a
// signed compare (not `(a-b) >> 31`) so it is overflow-safe for i32 MIN/MAX,
// matching the AST emitter's cmov.
// emit_ascii_range emits `(b - lo) <=u span` for the byte in `bslot` — the ONE
// primitive every ASCII classifier is built from, and exactly what the AST
// emitter open-codes as `subq lo; cmpq span; setbe` (asm.fern:1691 onward). The
// compare is UNSIGNED, which is what makes a single compare enough: a byte below
// `lo` wraps to a huge value and fails the upper bound in the same instruction.
function emit_ascii_range(p: LowerState, bslot: i32, lo: i32, span: i32): LowerState {
    p = p.emit(ir.op_load_local(bslot));
    p = p.emit(ir.op_const_i32(lo));
    p = p.emit(ir.op_bin("sub", 0, false));
    p = p.emit(ir.op_const_i32(span));
    return p.emit(ir.op_bin("le_u", 0, false));
}

// emit_ascii_case emits the case conversion for the byte in `bslot`: add 32 when
// it is uppercase (to_ascii_lower), subtract 32 when it is lowercase
// (to_ascii_upper). Branchless via the mask idiom emit_i32_minmax_slots uses —
// `0 - in_range` is all-ones or zero — rather than the AST emitter's `cmovbe`,
// which has no IR equivalent. `delta & mask` is 32 or 0, so one add/sub covers
// both the convert and the leave-alone case with no branch to lower.
function emit_ascii_case(p: LowerState, bslot: i32, to_lower: boolean): LowerState {
    p = p.emit(ir.op_load_local(bslot));
    p = p.emit(ir.op_const_i32(32));
    p = p.emit(ir.op_const_i32(0));
    if (to_lower) { p = emit_ascii_range(p, bslot, 65, 25); }
    else { p = emit_ascii_range(p, bslot, 97, 25); }
    p = p.emit(ir.op_bin("sub", 0, false));     // 0 - in_range = mask
    p = p.emit(ir.op_bin("and", 0, false));     // 32 & mask
    if (to_lower) { return p.emit(ir.op_bin("add", 0, false)); }
    return p.emit(ir.op_bin("sub", 0, false));
}

// ascii_byte_receiver reports whether `e` is a BYTE receiver for the ASCII
// family: a u8-tracked slot or an `as u8` cast (expr_subword_kind sees both), or
// a string INDEX, which yields a byte since #5629.
//
// Deliberately NOT expr_recv_prim_type, even though that is what every other
// scalar-method dispatch here uses. Its first line bails on
// `expr_struct_type != ""`, and a `var c: u8 = 65` slot records "u8" as its
// declared type there — so expr_struct_type answers "u8", the receiver reads as a
// STRUCT, and the commonest byte receiver of all never reaches the dispatch. That
// is why the AST emitter's own gate, on the same expr_recv_prim_type sibling,
// admitted `ty_is_i32` alongside `ty_is_u8`: it worked around the same thing
// from the other side.
function ascii_byte_receiver(e: ast.Expr, s: LowerState): boolean {
    if (expr_subword_kind(e, s) == "u8") { return true; }
    match (e) {
        ast.ExprIndex(bix) => { if (expr_is_str(bix.array, s)) { return true; } },
        // A CHAINED case conversion (`b.to_ascii_lower().to_ascii_string()`):
        // to_ascii_lower / _upper return a byte, so their result is a byte
        // receiver too. expr_subword_kind cannot see this — it reads slots and
        // casts, not call results — and without it the chain declines while each
        // half lowers on its own.
        ast.ExprCall(bc) => {
            match (bc.callee) {
                ast.ExprFieldAccess(bcf) => {
                    if ((bcf.field == "to_ascii_lower" || bcf.field == "to_ascii_upper") && bc.args.len() == 0) {
                        return ascii_byte_receiver(bcf.obj, s);
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

// ascii_byte_method reports whether `field` is one of the builtin ASCII
// byte methods lowered by lower_ascii_byte_method below.
function ascii_byte_method(field: string): boolean {
    return field == "is_ascii_digit" || field == "is_ascii_lower" || field == "is_ascii_upper"
        || field == "is_ascii_alpha" || field == "is_ascii_letter"
        || field == "is_ascii_alnum" || field == "is_ascii_hex_digit"
        || field == "to_ascii_lower" || field == "to_ascii_upper";
}

// lower_ascii_byte_method lowers the ASCII classifier / case family on a byte
// receiver (#3457 slice 5). Until this existed every one of them bailed the
// module: they had only the AST emitter's hand-written `setbe` / `cmovbe`
// sequences, none of which the IR path could express, though the pieces (an
// unsigned compare, a mask) were all already there.
//
// The receiver goes through a temp local because every method reads it at least
// twice (the alnum / hex forms three times) — the #5661 abs/sign pattern — so a
// side-effecting receiver like `next_byte().is_ascii_digit()` is evaluated once.
function lower_ascii_byte_method(field: string, recv: ast.Expr, s: LowerState): LowerState {
    var bname: string = "$asc" + util.i32_to_string(s.locals.len());
    var p: LowerState = s.add_local(bname);
    var bslot: i32 = p.slot_of(bname);
    p = lower_expr(recv, p);
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(bslot));
    if (field == "is_ascii_digit") { return emit_ascii_range(p, bslot, 48, 9); }
    if (field == "is_ascii_lower") { return emit_ascii_range(p, bslot, 97, 25); }
    if (field == "is_ascii_upper") { return emit_ascii_range(p, bslot, 65, 25); }
    if (field == "to_ascii_lower") { return emit_ascii_case(p, bslot, true); }
    if (field == "to_ascii_upper") { return emit_ascii_case(p, bslot, false); }
    if (field == "is_ascii_alpha" || field == "is_ascii_letter") {
        p = emit_ascii_range(p, bslot, 65, 25);
        p = emit_ascii_range(p, bslot, 97, 25);
        return p.emit(ir.op_bin("or", 0, false));
    }
    // alnum and hex_digit are three ranges OR'd; they differ only in the two
    // letter spans (A-Z / a-z vs A-F / a-f).
    var lspan: i32 = 25;
    if (field == "is_ascii_hex_digit") { lspan = 5; }
    p = emit_ascii_range(p, bslot, 48, 9);
    p = emit_ascii_range(p, bslot, 65, lspan);
    p = p.emit(ir.op_bin("or", 0, false));
    p = emit_ascii_range(p, bslot, 97, lspan);
    return p.emit(ir.op_bin("or", 0, false));
}

function emit_i32_minmax_slots(p: LowerState, aslot: i32, bslot: i32, is_max: boolean): LowerState {
    if (is_max) { p = p.emit(ir.op_load_local(aslot)); }
    else { p = p.emit(ir.op_load_local(bslot)); }
    p = p.emit(ir.op_load_local(aslot));
    p = p.emit(ir.op_load_local(bslot));
    p = p.emit(ir.op_bin("xor", 0, false));         // a ^ b
    p = p.emit(ir.op_const_i32(0));
    p = p.emit(ir.op_load_local(aslot));
    p = p.emit(ir.op_load_local(bslot));
    p = p.emit(ir.op_bin("lt_s", 0, false));        // a < b (0/1)
    p = p.emit(ir.op_bin("sub", 0, false));         // 0 - (a<b) = mask
    p = p.emit(ir.op_bin("and", 0, false));         // (a^b) & mask
    return p.emit(ir.op_bin("xor", 0, false));      // keep ^ ((a^b) & mask)
}

// lower_dyn_arg lowers an expression that flows into a `dyn Trait` slot
// (docs/DYN-TRAITS.md §4.2.3). A struct/enum value already carries its shape at
// offset 0 (a struct its type's shape; an enum its VARIANT's shape — the
// identity op_variant_is reads, which the backends' per-variant enum dispatch
// arms match, #4785), so it is the `dyn` pointer directly — lowered unchanged.
// A primitive/string value (expr_recv_prim_type != "") has no shape pointer, so
// it is heap-boxed into a cell [shape@0, value@8] via op_dyn_box, keyed by the
// primitive type name; the box pointer becomes the `dyn` value. op_dyn_dispatch
// then reads offset 0 and, on a primitive arm, reloads the value from offset 8.
pub function lower_dyn_arg(e: ast.Expr, s: LowerState): LowerState {
    var prim: string = expr_recv_prim_type(e, s);
    if (prim == "") {
        // Struct / enum concrete — already shape-carrying, no box.
        return lower_expr(e, s);
    }
    var ls: LowerState = lower_expr(e, s);
    if (!ls.ok) { return ls; }
    return ls.emit(ir.op_dyn_box(prim));
}

// lower_dyn_array_lit lowers an array LITERAL every element of which coerces to
// `dyn Trait` — lower_dyn_arg per element, then the buffer — leaving the array
// on the stack. The two positions such a literal can appear in share it: the
// `var xs: dyn Trait[] = […]` binding and an argument at a `dyn Trait[]` param
// (#6906). Without the second, a primitive/string element flowed in RAW and the
// callee's op_dyn_dispatch read a shape pointer out of a scalar — a segfault on
// the register backends, a validation failure on wasm.
pub function lower_dyn_array_lit(a: ast.ExprArray, s: LowerState): LowerState {
    var das: LowerState = s;
    var i: i32 = 0;
    while (i < a.elements.len()) {
        das = lower_dyn_arg(a.elements[i], das);
        if (!das.ok) { return das; }
        i = i + 1;
    }
    return das.emit(ir.op_arr_make(a.elements.len(), 32));
}

// expr_is_nonscalar conservatively reports whether `e` evaluates to a non-scalar
// (heap) value — a string, array, struct, tuple, variant box, or anything that
// might (a call). Used to keep tuple elements (and other scalar-only contexts)
// to i32/boolean: a tuple with a heap element bails, since its rc would need
// tracking.
pub function expr_is_nonscalar(e: ast.Expr, s: LowerState): boolean {
    if (expr_is_str(e, s)) { return true; }
    if (expr_struct_type(e, s) != "") { return true; }
    match (e) {
        ast.ExprArray(_) => { return true; },
        ast.ExprTuple(_) => { return true; },
        ast.ExprStructLit(_) => { return true; },
        ast.ExprCall(_) => { return true; },
        ast.ExprIdent(id) => { return s.is_arr_slot(s.slot_of(id.name)); },
        _ => { return false; }
    }
    return false;
}

// expr_is_str reports whether expression `e` evaluates to a string, by the
// structural cues irlower can see without a full type checker: a string
// literal, a string-marked local/param slot, or a `+` whose operands are
// strings (nested concat). Drives string-op dispatch in ExprBinary / `.len()`.
pub function (s: LowerState) is_str_ret_fn(name: string): boolean {
    return sig_reg_has_exact(s.sigs.str_ret_fns, name);
}

// expr_is_strarr reports whether `e` evaluates to a string[] array — a string-
// element array literal, or a string[]-marked local/param slot. Drives the
// element typing of `arr[i]` (a string).
// map_kv_elem_tag classifies a map `.keys()` / `.values()` METHOD call (argc 0)
// by the element type its result array yields — "i32" or "string" — or "" when
// `obj` isn't a map OR the element type isn't one the unannotated
// `var x = m.keys()/values()` array path handles. Keys are i32 (an i32-keyed
// map) or string; an i32 / string VALUE likewise. Anything else (i64 / f64 /
// u64 / u32 / struct / nested-array values) is refused: the 8-byte
// i64/f64 cases hit a SEPARATE pre-existing wasm bug in op_map_values (the
// annotated `var x: i64[] = m.values()` form mis-sums on wasm too), so routing
// them to IR would expose that, and the unsigned/heap cases need extra marking.
// The two array-source predicates (expr_is_arr_src / expr_is_strarr) and the
// StmtVar is_arr inference all gate on this ONE helper so a slot's array-ness
// and element width stay consistent. #2691.
function map_kv_elem_tag(obj: ast.Expr, field: string, argc: i32, s: LowerState): string {
    if (argc != 0) { return ""; }
    if (field != "keys" && field != "values") { return ""; }
    var mty: string = expr_map_type_tag(obj, s);
    if (mty == "") { return ""; }
    if (field == "keys") {
        if (map_key_kind_of(mty) == 1) { return "i32"; }
        return "string";
    }
    var vt: string = map_value_of(mty);
    if (vt == "i32" || vt == "string") { return vt; }
    return "";
}

// cell_elem_type returns the element type spelling of a Cell expression `e`
// (a cell local or a struct field typed Cell[T]), or "" if `e` is not a cell.
// Drives result-type propagation for c.get() (#5510).
pub function cell_elem_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (s.is_cell_slot(sl)) { return s.cell_elem_of_slot(sl); }
            return "";
        },
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return cell_elem_of_type_name(expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s));
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            return cell_elem_of_type_name(decl_field_type(s.structs, oty, fa.field));
        },
        _ => { return ""; }
    }
}

// arr_spelling_of_type_name renders a declared type SPELLING the way the ARRAY
// classifiers need to read it: `Cell[T]` becomes `T[]`, everything else is
// unchanged. A Cell[T] is a 1-element array of T (#5510) and `c.get()` desugars
// to `c[0]`, so by the time a classifier is asked about the receiver the cell IS
// that array — but the spelling still reads `Cell[f64]`, and every classifier
// matches on the array form. Without it a `Cell[f64]` indexes 4-byte where the
// same cell in a LOCAL indexes 8 (mark_cell records the element kind on the
// slot): invalid wasm on a struct field, and on a tuple element a silent read of
// the low half. The Cell sibling of the #6093 field cases.
pub function arr_spelling_of_type_name(t: string): string {
    var elem: string = cell_elem_of_type_name(t);
    if (elem != "") { return elem + "[]"; }
    return t;
}

// field_arr_decl_type and tuple_elem_arr_tag are that map applied to the two
// places a classifier reads a declared type from: a struct field's table entry
// and a tuple's recorded element tags.
pub function field_arr_decl_type(structs: parser.StructDecl[], struct_name: string, field: string): string {
    return arr_spelling_of_type_name(decl_field_type(structs, struct_name, field));
}

pub function tuple_elem_arr_tag(obj: ast.Expr, n: i32, s: LowerState): string {
    return arr_spelling_of_type_name(expr_tuple_elem_tag(obj, n, s));
}

// cell_new_elem_tag returns the element-type spelling for a `cell_new(x)`
// initialiser (so an UNANNOTATED `var c = cell_new(x)` binding can record the
// same is_cell / element-kind columns the `: Cell[T]` spelling gives it), or ""
// when `e` is not a cell_new call. Scalars + string only: a Cell over a
// composite is rejected upstream by E057.
function cell_new_elem_tag(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(ci) => {
                    if (ci.name != "cell_new" || c.args.len() != 1) { return ""; }
                    var a: ast.Expr = c.args[0];
                    if (expr_is_str(a, s)) { return "string"; }
                    if (expr_is_f64(a, s)) { return "f64"; }
                    if (expr_is_u64(a, s)) { return "u64"; }
                    if (infer_expr_width(a, s) == 64) { return "i64"; }
                    return "i32";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}

// cell_get_elem returns the element type of a `X.get()` call where X is a cell,
// or "" otherwise — the result type c.get() produces (#5510). Used by the type
// predicates (expr_is_str etc.), which run on the ORIGINAL `c.get()` AST before
// the get->c[0] desugar, so they need this to know its type.
pub function cell_get_elem(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return ""; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "get") { return ""; }
                    return cell_elem_type(fa.obj, s);
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}

// expr_is_cell reports whether `e` denotes a Cell[T] (#5510) — a cell_new(...)
// call or a slot marked is_cell at its binding. Drives the get/set desugar to
// 1-element-array index ops.
pub function expr_is_cell(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprIdent(id) => { return s.is_cell_slot(s.slot_of(id.name)); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(ci) => { return ci.name == "cell_new" && c.args.len() == 1; },
                _ => { return false; }
            }
        },
        // A struct FIELD typed Cell[T] — `cx.lam_ctr` where lam_ctr: Cell[i32].
        // The self-host compiler holds its cells this way, so this arm is what
        // the whole-compiler wasm path needs (locals alone don't cover it).
        // A numeric field is a TUPLE element instead (`t.1` where the tuple is
        // `(i32, Cell[i32])`): its declared spelling survives verbatim in the
        // element tags, so the same `Cell[` test answers for it. Without this
        // `t.1.get()` never desugared to the index and bailed as a call to the
        // unknown symbol `i32.get`.
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return is_cell_type_name(expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s));
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return is_cell_type_name(decl_field_type(s.structs, oty, fa.field));
        },
        _ => { return false; }
    }
}

pub function expr_is_strarr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return expr_is_str(arr.elements[0], s);
        },
        ast.ExprIdent(id) => { return s.is_strarr_slot(s.slot_of(id.name)); },
        // `m[i]` over a string[][] slot is itself a string[] (so `m[i][j]` reads
        // as a string and `m[i][j].len()` dispatches to str_len, #4081). Mirrors
        // the ExprIndex case in expr_is_f64arr; the slot's inner element kind is
        // recorded "string" at the `var m: string[][] = …` binding.
        ast.ExprIndex(_) => { return arrarr_index_elem_kind(e, s) == "string"; },
        ast.ExprCall(c) => {
            // A call to a string[]-returning user function (strarr_ret_fns), the
            // `str_split(s, sep)` builtin (string→string[]), or the `s.split(sep)`
            // method form — all yield a string[] whose elements are string boxes.
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "str_split" && c.args.len() == 2) { return true; }
                    // `args()` returns a string[] of the command-line arguments, so
                    // `var a = args()` str-array-tracks (`a.len()` / `a[i]` dispatch
                    // as string[] ops, just like str_split's result).
                    if (cid.name == "args" && c.args.len() == 0) { return true; }
                    // An erased-generic `T[]` return mirroring argument i
                    // (`dup[T](x: T): T[]`): a string[] exactly when THAT
                    // argument is a string.
                    var gsa: i32 = strarr_ret_argref(s, cid.name);
                    if (gsa >= 0 && gsa < c.args.len()) { return expr_is_str(c.args[gsa], s); }
                    return s.is_strarr_ret_fn(s.mod_fn_name(cid.name));
                },
                ast.ExprFieldAccess(cfa) => {
                    // `xss.first()` / `.last()` on a string[][] yields a string[]
                    // element, exactly as `xss[0]` does.
                    if (arr_firstlast_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_strarr(arr_elem_index_expr(cfa.obj), s);
                    }
                    // `.reverse()` / `.concat(ys)` on a string[] yield a string[].
                    if (arr_samekind_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_strarr(cfa.obj, s);
                    }
                    // `a.with(...)` / `a.append(...)` preserve the receiver's element
                    // kind: a string[] receiver yields a fresh string[]. The f64 and
                    // i64 limbs have carried this since they were written; without it
                    // here a CHAINED `xs.append(a).append(b)` resolved the outer
                    // receiver as i32 and refused the module (#7754).
                    if (((cfa.field == "with" && c.args.len() == 2) || (cfa.field == "append" && c.args.len() == 1))
                        && expr_is_strarr(cfa.obj, s)) { return true; }
                    if (cfa.field == "split" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "lines" && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    // `m.keys()` on a string-keyed map / `m.values()` on a
                    // string-valued map yields a string[].
                    if (map_kv_elem_tag(cfa.obj, cfa.field, c.args.len(), s) == "string") { return true; }
                    // A string[]-returning user METHOD (`f.mks()` — the #5101
                    // sibling): resolve the receiver's struct type and look up
                    // the qualified "<BaseType>.<method>" registry entry.
                    // Without this the tuple-element tag fell to scalar and
                    // `t.N[i].len()` dispatched to a nonexistent i32 method
                    // (link failure / miscompile).
                    var mrrt: string = expr_struct_type(cfa.obj, s);
                    if (mrrt != "" && s.is_strarr_ret_fn(mrrt + "." + cfa.field)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        ast.ExprFieldAccess(fa) => {
            // A `string[]` TUPLE element `t.N` (`(["a","b"], x)`): the element's
            // recorded tuple tag is `string[]`, so `t.N[i]` reads as a string. #3353.
            if (util.is_all_digits(fa.field)) {
                return tuple_elem_arr_tag(fa.obj, util.digits_to_i32(fa.field), s) == "string[]";
            }
            // A string[]-typed struct field read `p.items` is a string[].
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "string[]";
        },
        ast.ExprSlice(sl) => { return expr_is_strarr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// arr_lit_is_f64 / arr_lit_is_i64 answer which slot an array LITERAL's elements
// occupy. The element TYPE answers first — `ast.ExprArray.elem_ty`, stamped
// by the settle pass from the destination the literal stands in, the same fact
// native sizes elements from (ast.ElemSizeBytesFor on ast.ArrayLit.ElemType).
// Reading the width off the first element's expression shape alone mis-sized
// `[1, 2]` in an i64[] or f64[] destination to a 4-byte stride on wasm (#4366).
//
// The type only ever WIDENS the verdict: an elem_ty naming no 8-byte slot — an
// unreached destination (""), or a type PARAMETER (`f(xs: T[])` stamps "T"),
// where the concrete element is not knowable here — falls through to the
// expression probe rather than forcing the 4-byte answer over it.
//
// f32 shares the f64 slot: the self-host carries every float 8-byte wide
// (ir.fern's `f64` immediate), so an `f32[]` strides 8 here where native strides
// 4 — the slot-width divergence #4366 tracks separately.
pub function elem_ty_is_f64slot(t: string): boolean {
    return t == "f64" || t == "f32" || t == "float";
}

pub function elem_ty_is_i64slot(t: string): boolean {
    return t == "i64" || t == "u64";
}

// arr_lit_is_f32 is arr_lit_is_f64's dispatch twin: an array LITERAL whose
// declared element spelling or first element is an f32.
pub function arr_lit_is_f32(arr: ast.ExprArray, s: LowerState): boolean {
    if (arr.elem_ty == "f32") { return true; }
    return arr.elements.len() > 0 && expr_is_f32(arr.elements[0], s);
}

pub function arr_lit_is_f64(arr: ast.ExprArray, s: LowerState): boolean {
    if (elem_ty_is_f64slot(arr.elem_ty)) { return true; }
    return arr.elements.len() > 0 && expr_is_f64(arr.elements[0], s);
}

pub function arr_lit_is_i64(arr: ast.ExprArray, s: LowerState): boolean {
    if (elem_ty_is_i64slot(arr.elem_ty)) { return true; }
    return arr.elements.len() > 0 && !expr_is_f64(arr.elements[0], s)
        && infer_expr_width(arr.elements[0], s) == 64;
}

// expr_is_f64arr reports whether `e` is an f64[] array — an array literal whose
// element type (or, unstamped, whose first element) is f64, or an
// f64-array-tracked local/param. Drives the slot's element-width tracking at a
// `var a = …` binding (mirrors expr_is_strarr).
// f64[]-returning calls and slices aren't tracked (those uses bail), so they
// fall to the default — keeping a stray width-32 a[i] off an f64 buffer out of
// the eligible set via the whole-module gate.
// expr_is_f32arr_src reports whether `e` PRODUCES an f32[]: a literal whose
// elements are f32, or an alias of a slot already carrying the overlay. The
// unannotated `var a = [x as f32]` / `var b = a` spellings, which have no
// `f32[]` type name to read it from.
pub function expr_is_f32arr_src(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(al) => { return arr_lit_is_f32(al, s); },
        ast.ExprIdent(aid) => { return s.is_f32arr_slot(s.slot_of(aid.name)); },
        _ => { return false; }
    }
    return false;
}

pub function expr_is_f64arr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(arr) => {
            return arr_lit_is_f64(arr, s);
        },
        ast.ExprIdent(id) => { return s.is_f64arr_slot(s.slot_of(id.name)); },
        // `m[i]` over an f64[][] slot is itself an f64[] (so `var r = m[i]` tracks
        // r as f64[] and its `r[j]` reads 8-byte). #2691.
        ast.ExprIndex(_) => { return arrarr_index_elem_kind(e, s) == "f64"; },
        ast.ExprCall(c) => {
            // A call to an f64[]-returning free function OR method (f64arr_ret_fns,
            // methods keyed "<Type>.<method>").
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // An erased-generic `T[]` return mirroring argument i
                    // (`dup[T](x: T): T[]`, the shared "name|$arg<i>" entry in
                    // strarr_ret_fns): an f64[] exactly when THAT argument is f64.
                    var gf: i32 = strarr_ret_argref(s, cid.name);
                    if (gf >= 0 && gf < c.args.len()) { return expr_is_f64(c.args[gf], s); }
                    return s.is_f64arr_ret_fn(s.mod_fn_name(cid.name));
                },
                ast.ExprFieldAccess(cfa) => {
                    // `xss.first()` / `.last()` on an f64[][] yields an f64[]
                    // element, so the following `[j]` reads 8-byte.
                    if (arr_firstlast_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_f64arr(arr_elem_index_expr(cfa.obj), s);
                    }
                    if (arr_samekind_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_f64arr(cfa.obj, s);
                    }
                    // `a.with(...)` / `a.append(...)` preserve the receiver's element
                    // kind: an f64[] receiver yields a fresh f64[].
                    if (((cfa.field == "with" && c.args.len() == 2) || (cfa.field == "append" && c.args.len() == 1))
                        && expr_is_f64arr(cfa.obj, s)) { return true; }
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_f64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        ast.ExprSlice(sl) => { return expr_is_f64arr(sl.array, s); },
        // An `f64[]` TUPLE element `t.N` (`([1.5], x)`): its recorded tuple tag
        // is `f64[]`, so `t.N` is an f64[] (drives a `var xs = t.N` rebind). #3353.
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return is_float_array_type_name(tuple_elem_arr_tag(fa.obj, util.digits_to_i32(fa.field), s));
            }
            // A NAMED struct field declared f64[] — the f64 twin of the i64[]
            // case in expr_is_i64arr, and broken the same way for the same
            // reason: only the tuple form was handled. #6093.
            var foty: string = expr_struct_type(fa.obj, s);
            if (foty == "") { return false; }
            return is_float_array_type_name(field_arr_decl_type(s.structs, foty, fa.field));
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_arr_src reports whether `e` is an ARRAY (an array literal, an
// array-marked local/param, an array-returning call, or a slice of one) — used
// to route `e[start:end]` to arr_slice vs str_slice.
// arr_elem_index_expr builds the `xs[0]` node that `xs.first()` / `xs.last()`
// lower to. The result-type classifiers below use it to answer "what does this
// call yield?" by asking what an INDEX of the receiver yields, so the desugar
// and the classifiers cannot drift — a string[] element reads as a string, an
// f64[][] element as an f64[], and so on, with no per-classifier restatement of
// the element-kind table.
function arr_elem_index_expr(recv: ast.Expr): ast.Expr {
    return ast.ExprIndex {
        array: recv,
        index: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 },
        unchecked: false,
        ty: "",
    };
}

// arr_firstlast_call reports whether `recv.field(args)` is the builtin
// `.first()` / `.last()` element read — the shape whose result type is the
// receiver's element type. The ARRAY-receiver test is part of the question, not
// an optimisation: a struct or enum with a user method of the same name keeps
// its own return type, so the classifiers must not claim it.
function arr_firstlast_call(field: string, recv: ast.Expr, argc: i32, s: LowerState): boolean {
    if (argc != 0) { return false; }
    if (field != "first" && field != "last") { return false; }
    return expr_is_arr_src(recv, s) || expr_is_strarr(recv, s)
        || expr_is_f64arr(recv, s) || expr_is_i64arr(recv, s);
}

// arr_samekind_call reports whether `recv.field(args)` is the builtin
// `.reverse()` / `.concat(ys)` — the array builtins whose result is an array of
// the SAME element type as the receiver, so every classifier answers for them by
// asking about the receiver. Like arr_firstlast_call, the ARRAY-receiver test is
// part of the question: a struct with a user `reverse` method keeps its own
// return type. std/array's own helpers are NOT excluded here — a classifier
// answering "array of the receiver's element type" is right either way; it is the
// LOWERING that defers to them.
//
// NOT recovered: the element STRUCT type. `expr_struct_type` reports "" for an
// array value by design, and a struct-array reverse would need the result slot
// marked with the element type at its binding. `ps.reverse()[0].n` therefore
// bails rather than mis-resolving — safe, and left open.
function arr_samekind_call(field: string, recv: ast.Expr, argc: i32, s: LowerState): boolean {
    if (!((field == "reverse" && argc == 0) || (field == "concat" && argc == 1))) { return false; }
    return expr_is_arr_src(recv, s) || expr_is_strarr(recv, s)
        || expr_is_f64arr(recv, s) || expr_is_i64arr(recv, s);
}

pub function expr_is_arr_src(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(_) => { return true; },
        ast.ExprIdent(id) => { return s.is_arr_slot(s.slot_of(id.name)); },
        // `a[i]` where `a` is an array-of-arrays yields an array (its element).
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => { return s.is_arrarr_slot(s.slot_of(aid.name)); },
                _ => { return false; }
            }
        },
        ast.ExprSlice(sl) => { return expr_is_arr_src(sl.array, s); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // `__alloc_u8(n)` yields a fresh n-element byte array.
                    if (cid.name == "__alloc_u8") { return true; }
                    // `random_bytes(n)` yields a fresh n-element u8[] (op_random_bytes).
                    if (cid.name == "random_bytes" && c.args.len() == 1) { return true; }
                    // `tcp_recv(fd, max)` yields a fresh u8[] (op_tcp_recv).
                    if (cid.name == "tcp_recv" && c.args.len() == 2) { return true; }
                    // `str_split(s, sep)` yields a fresh string[] (op_str_split).
                    if (cid.name == "str_split" && c.args.len() == 2) { return true; }
                    return s.is_arr_ret_fn(s.mod_fn_name(cid.name));
                },
                // `s.bytes()` / `s.as_bytes()` on a string receiver yields a
                // fresh u8[] (op_str_bytes), and `s.split(sep)` a fresh string[]
                // (op_str_split) — both rc-tracked array sources.
                ast.ExprFieldAccess(cfa) => {
                    // `xss.first()` / `.last()` on an array-of-arrays yields an
                    // array element, so it is an array source exactly as `xss[0]`
                    // is. Checked before the std/array find_arr_method arm below,
                    // matching the lowering's builtin-before-helper precedence.
                    if (arr_firstlast_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_arr_src(arr_elem_index_expr(cfa.obj), s);
                    }
                    // `.reverse()` / `.concat(ys)` yield an array of the receiver's
                    // element type, so they are array sources exactly as it is.
                    if (arr_samekind_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_arr_src(cfa.obj, s);
                    }
                    // `a.with(...)` / `a.append(...)` preserve the receiver's element
                    // kind — the scalar-array limb of the clause expr_is_f64arr and
                    // expr_is_i64arr already carry. Its absence here is what made a
                    // CHAINED `xs.append(a).append(b)` resolve its outer receiver as
                    // i32 and refuse the module, while the same chain on an f64[]
                    // lowered (#7754).
                    if (((cfa.field == "with" && c.args.len() == 2) || (cfa.field == "append" && c.args.len() == 1))
                        && expr_is_arr_src(cfa.obj, s)) { return true; }
                    if ((cfa.field == "bytes" || cfa.field == "as_bytes") && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "split" && c.args.len() == 1) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "lines" && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    // An array-receiver method `arr.m()` whose std/array helper
                    // __method_Array_m RETURNS an array (reverse / sorted_asc /
                    // distinct / …) is itself an array source — so a chained
                    // `arr.reverse().join(...)` (reverse_words) recognises the
                    // inner array and dispatches the outer array method.
                    if (expr_is_arr_src(cfa.obj, s) || expr_is_strarr(cfa.obj, s) || expr_is_f64arr(cfa.obj, s) || expr_is_i64arr(cfa.obj, s)) {
                        var amn: string = s.find_arr_method(cfa.field);
                        if (amn.len() > 0 && s.is_arr_ret_fn(amn)) { return true; }
                    }
                    // `m.keys()` / `m.values()` is a fresh owned array source (drives
                    // slicing / re-binding); element width is gated identically.
                    if (map_kv_elem_tag(cfa.obj, cfa.field, c.args.len(), s) != "") { return true; }
                    // An array-returning user METHOD (`h.get()` where
                    // `function (h: Holder) get(): Inner[]`), keyed by the
                    // qualified "<BaseType>.<method>" entry — the limb
                    // expr_is_strarr / expr_is_f64arr / expr_is_i64arr each
                    // already carry. Without it the `.len()` dispatch gate fell
                    // to its last disjunct, "the receiver is not a struct", and
                    // expr_struct_type reports a `P[]`-returning call as the
                    // ELEMENT type P — so a STRUCT-element result was denied an
                    // array it could not otherwise see and `.len()` resolved
                    // against P (#7627). The other element kinds report "" there,
                    // which is what that fallback was admitting them on.
                    var amrt: string = expr_struct_type(cfa.obj, s);
                    if (amrt != "" && s.is_arr_ret_fn(amrt + "." + cfa.field)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// arr_i32_recv reports whether `e` is a receiver the i32-element array helpers
// (__fern_arr_i32_sum / _product / _index_of / _min_opt / _max_opt) accept: any
// 4-byte-element array, either an owned array SOURCE or a borrowed array struct
// FIELD read (`h.xs` where xs: i32[]/boolean[]/u32[]/u8[] — each stores its
// element in a full 32-bit slot). The helpers take the array borrowed and return
// a scalar, so the field read needs no rc traffic; expr_is_arr_src stays narrow
// (it means a fresh/owned array and drives rc decisions).
//
// One predicate rather than the guard restated per builtin: the result-type
// classifier (builtin_arr_opt_ret_type) has to agree with the lowering exactly,
// or `match (h.xs.min())` reports no payload type while the call it describes is
// emitted anyway.
function arr_i32_recv(e: ast.Expr, s: LowerState): boolean {
    if (expr_is_strarr(e, s) || expr_is_f64arr(e, s) || expr_is_i64arr(e, s)) { return false; }
    return expr_is_arr_src(e, s) || scalar_arr_field_type(e, s) != "";
}

pub function expr_is_str(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprString(_) => { return true; },
        ast.ExprIdent(id) => {
            var isl: i32 = s.slot_of(id.name);
            if (isl >= 0) { return s.is_str_slot(isl); }
            // A bare const-string reference (`NAME`, a zero-arg string-returning
            // const fn) has no local slot but reads as a string, so `NAME.len()` /
            // `NAME + x` dispatch as string ops instead of falling through to the
            // array path (which read a string box as an array header — str_len vs
            // arr_len read different length fields, a silent miscompile). The const
            // ref itself lowers to a call of the const fn (op_call_direct, 0 args).
            return id_type_tag(id, s) == "string";
        },
        ast.ExprBinary(b) => {
            if (b.op == "+" && (expr_is_str(b.left, s) || expr_is_str(b.right, s))) { return true; }
            // A composite operator overload returning string (#5986): the
            // operand walk cannot see it — both operands are structs — so the
            // checker's tag for the whole binary is the only carrier.
            return b.ty == "string";
        },
        ast.ExprCall(c) => {
            // typed-IR (#5531): the annotate pass stamps c.ty with the checker's
            // inferred result type; when present it is authoritative, retiring the
            // str_ret_fns / string-builtin re-derivation below for annotated calls.
            // "" (unannotated: asm_ir_run / native, or an unresolved call) falls
            // through to the structural walk unchanged.
            if (c.ty != "") { return c.ty == "string"; }
            // c.get() on a Cell[string] yields a string (#5510) — classified
            // here because this runs on the original `c.get()` before the
            // get->c[0] desugar, so `c.get()[0]` / `.len()` see a string.
            if (cell_get_elem(e, s) == "string") { return true; }
            // A string-valued if/match-EXPRESSION desugars to a 0-arg IIFE
            // `(function(): string { if (c) { return "a"; } … })()`. Classify it
            // by its first branch's returned value, so `var s = if (…) { … }`
            // tracks s as a string (and `lower_iife` admits the string temp).
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_str(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to a string-returning user function (str_ret_fns), or a
            // string-returning builtin.
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // read_all_stdin() reads fd 0 to EOF into ONE string box, so
                    // its result str-tracks (`s.len()` dispatches to str_len, the
                    // binding takes the string reclaim path). Unlike read_line it
                    // is a bare string, not an Option[string].
                    if (cid.name == "read_all_stdin" && c.args.len() == 0) { return true; }
                    // arg_at(i) boxes argv[i] into a fresh string, so it str-tracks
                    // the same way — the element of the string[] that args() builds.
                    if (cid.name == "arg_at" && c.args.len() == 1) { return true; }
                    // string_from_bytes_unchecked(arr) packs bytes into a fresh string box.
                    if (cid.name == "string_from_bytes_unchecked") { return true; }
                    // slice_unchecked(s, a, b) yields the string slice s[a:b]
                    // (the ExprSlice string arm as a builtin, #5634).
                    if (cid.name == "slice_unchecked" && c.args.len() == 3) { return true; }
                    // read_line() returns Option[string] now (#4369), opt-tracked via
                    // the asmcore Option type + opt_ret_type, not str-tracked here.
                    // The string-returning str_* free builtins (transform family) —
                    // the free-function spelling of `.to_upper()` / `.trim()` /
                    // `.repeat()` / `.replace()`, each yielding a fresh string box.
                    // (str_contains/index_of/starts_with/ends_with return bool/i32;
                    // str_split is string[], tracked in expr_is_strarr.)
                    if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
                            || cid.name == "str_trim" || cid.name == "str_repeat"
                            || cid.name == "str_replace") { return true; }
                    // i32_to_string(n) yields a fresh decimal-text string box (the
                    // free-function spelling of `n.to_string()`).
                    if (cid.name == "i32_to_string") { return true; }
                    // chr(n) yields a fresh 1-char string box.
                    if (cid.name == "chr") { return true; }
                    // __raw_string(data, len) is the Tier-2 intrinsic that boxes raw
                    // bytes back into a string (#2649 — docs/RUNTIME-INTRINSICS.md).
                    if (cid.name == "__raw_string" && c.args.len() == 2) { return true; }
                    // strbuf_take() snapshots the global string-builder into a fresh
                    // string box (so `return strbuf_take()` str-tracks the result).
                    if (cid.name == "strbuf_take" && c.args.len() == 0) { return true; }
                    // An erased-generic fn whose return mirrors argument i
                    // (`idg[T](x: T): T`, the "name|$arg<i>" registry entry):
                    // the call is a string exactly when THAT argument is.
                    var gra: i32 = str_ret_argref(s, cid.name);
                    if (gra >= 0 && gra < c.args.len()) { return expr_is_str(c.args[gra], s); }
                    return s.is_str_ret_fn(s.mod_fn_name(cid.name));
                },
                // `X.to_string()` yields a string box (the i32 runtime helper or
                // the string-identity case); a struct's generated `to_string`
                // (@derive(Display)) is likewise string-typed. `to_debug`
                // (@derive(Debug)) is the same shape — always string-returning,
                // including on an ENUM receiver (whose expr_struct_type is "",
                // so the str_ret_fn path below can't reach it). Either way the
                // result feeds `+` concat / `.len()` as a string.
                ast.ExprFieldAccess(cfa) => {
                    // `xs.first()` / `xs.last()` on a string[] yields a string
                    // element — the same answer as `xs[0]`, which is what the
                    // lowering reads them as.
                    if (arr_firstlast_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_str(arr_elem_index_expr(cfa.obj), s);
                    }
                    // `b.to_ascii_string()` on a byte receiver yields a fresh
                    // 1-char string (it desugars to chr(b)), so the result feeds
                    // `[0]` / `.len()` / concat as a string.
                    if (cfa.field == "to_ascii_string" && c.args.len() == 0 && ascii_byte_receiver(cfa.obj, s)) { return true; }
                    if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) { return true; }
                    // `s.to_upper()` / `s.to_lower()` on a string receiver yield a
                    // fresh string (op_str_to_upper / _to_lower), so the result
                    // feeds `.len()` / concat as a string.
                    if ((cfa.field == "to_ascii_upper" || cfa.field == "to_ascii_lower" || cfa.field == "trim" || cfa.field == "reverse") && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    // `s.repeat(n)` on a string receiver yields a fresh string.
                    if (cfa.field == "repeat" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "replace" && c.args.len() == 2 && expr_is_str(cfa.obj, s)) { return true; }
                    // `xs.join(sep)` on a string[] receiver yields a fresh joined
                    // string (the __fern_arr_str_join runtime helper), so the result
                    // feeds `.len()` / concat as a string. #5328.
                    if (cfa.field == "join" && c.args.len() == 1 && expr_is_strarr(cfa.obj, s)) { return true; }
                    // `m.get_or(k, d)` on a string-VALUE map (`Map[K, string]`)
                    // returns the stored string value, so the result feeds
                    // `.len()` / concat as a string. Without this the result is
                    // mis-tracked as i32 and `.len()` reads the box's data-ptr
                    // slot as a length (garbage). get_or_recv_map_type resolves
                    // the receiver the same way the map-op LOWERING does — a map
                    // local, a struct field, a tuple element, an array element,
                    // a map-returning call — so the string tracking and the
                    // dispatch cannot disagree about what a receiver is (#3317).
                    if (cfa.field == "get_or" && c.args.len() == 2
                            && map_value_of(get_or_recv_map_type(cfa.obj, s)) == "string") { return true; }
                    // A call THROUGH a string-returning fn-typed struct FIELD
                    // (`h.f(1)` where H.f: (i32) => string): the field's declared
                    // type coarsens to "fn" but its fn_ret keeps the string
                    // return, so the call result feeds `.len()` / concat as a
                    // string. Without this the chained `h.f(1).len()` mis-
                    // dispatched and read 0 even though the closure returned the
                    // string correctly (#5306 gap 2 — an annotated rebind
                    // `var r: string = h.f(1)` already worked).
                    if (call_fn_field_ret(c, s) == "string") { return true; }
                    // `it.key()` / `it.value()` on a `MapIter[K, V]` receiver returns
                    // the key / value box; when that side is `string` the result
                    // feeds `.len()` / concat as a string. Without this `.len()`
                    // mis-dispatches to arr_len, reading the string box's data-ptr
                    // slot as a length (garbage) — the keys()/values() + get_or
                    // siblings above type the same way off the slot's recorded type.
                    if (cfa.field == "key" && c.args.len() == 0) {
                        match (cfa.obj) {
                            ast.ExprIdent(ikid) => {
                                var ikt: string = s.map_type_of(s.slot_of(ikid.name));
                                if (is_mapiter_type_name(ikt) && mapiter_key_kind_of(ikt) == 0) { return true; }
                            },
                            _ => {}
                        }
                    }
                    if (cfa.field == "value" && c.args.len() == 0) {
                        match (cfa.obj) {
                            ast.ExprIdent(ivid) => {
                                if (mapiter_value_of(s.map_type_of(s.slot_of(ivid.name))) == "string") { return true; }
                            },
                            _ => {}
                        }
                    }
                    // A string-returning METHOD call `recv.m(...)`. Methods store
                    // their bare name (`receiver_type` is separate), so str_ret_fns
                    // records `m` by bare name — same as the free-call lookup above.
                    // Lets `recv.m().len()` / `recv.m() + x` track as string instead
                    // of mis-dispatching `.len()` to arr_len. Guarded by a non-empty
                    // receiver type so only genuine method calls match.
                    var mrty: string = expr_struct_type(cfa.obj, s);
                    if (mrty == "") { mrty = expr_recv_prim_type(cfa.obj, s); }
                    // A `dyn Trait` receiver (#5142) falls through to the
                    // QUALIFIED lookup below: append_dyn_str_ret_fns seeds a
                    // "dyn <Trait>.<method>" entry per string-returning REQUIRED
                    // trait method, so the dispatch result tracks as a string
                    // precisely. (An earlier name-based fallback here — "any
                    // qualified entry with this method name" — let an UNRELATED
                    // type's same-named string method poison an i32 trait
                    // dispatch: `d.bar() + sv.bar().len()` lowered the `+` as
                    // str_concat over the integer result and SIGSEGV'd — the
                    // dyn-i32-vs-unrelated-string case.)
                    // Qualified lookup "<recvType>.<method>" (str_ret_fns_of keys
                    // methods that way) so a string-returning method on THIS
                    // receiver type is recognised — without colliding with a
                    // same-named method on another type that returns non-string
                    // (e.g. i32.to_lower vs string.to_lower).
                    if (mrty != "" && s.is_str_ret_fn(mrty + "." + cfa.field)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        // A string tuple element `t.N` or struct field `p.name`, via the shared
        // leaf (#5520): the declaration walk first, fa.ty filling its holes.
        ast.ExprFieldAccess(fa) => { return fa_type_tag(fa, s) == "string"; },
        ast.ExprIndex(ix) => {
            // Indexing a string[] array yields a string element. The stamped
            // ix.ty answers where the array walk cannot (a call result, an
            // IIFE) — read directly, not via ix_type_tag, which resolves
            // element WIDTH; string-ness is not a width (#5986).
            return expr_is_strarr(ix.array, s) || ix.ty == "string";
        },
        ast.ExprSlice(_) => {
            // `s[a:b]` on a string is `Option[str]`, not a string (#5634) — an
            // Option box, whose `.len()` must NOT dispatch to str_len. The raw
            // string view is `slice_unchecked(s, a, b)`, tracked below.
            return false;
        },
        // `inner?` unwraps an Option[string]/Result[string, E] to its string
        // payload, so `var s = f()?` str-tracks `s` (else `s.len()` mis-
        // dispatches to arr_len, reading 0). The payload type comes from the
        // same try_opt_type the width / lowering paths use — including the
        // erased-generic "Option[$arg<i>]" resolution — so a generic
        // `some1[T](x: T): Option[T]` unwrapped at a string argument tracks too.
        ast.ExprUnary(tu) => {
            if (tu.op == "try_") {
                var tot: string = try_opt_type(tu.operand, s);
                if (tot.len() >= 8 && slice_unchecked(tot, 0, 7) == "Option[") { return opt_payload_type(tot, "Some") == "string"; }
                if (tot.len() >= 8 && slice_unchecked(tot, 0, 7) == "Result[") { return opt_payload_type(tot, "Ok") == "string"; }
            }
            // A composite `neg` overload returning string — only the checker's
            // tag can see it (#5986), matching the ExprBinary arm above.
            return tu.ty == "string";
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_fresh_str reports whether `e` evaluates to a FRESH, sole-owned heap
// string box whose DATA buffer is exclusively owned — no aliasing of any live
// string's data. It is the string analogue of expr_is_arr_src (the move-source
// classifier): only such a value may be MOVED into a struct's `string` field
// and FREED by the field-drop (emit_struct_field_drops) with no alias-inc.
//
// The admitted forms each allocate a fresh data buffer AND box via __fern_alloc
// with NO identity / view fast-path (verified against the asm_ir.fern emitters):
//   - `a + b` concat            (op_str_concat — fresh data + box)
//   - `s.to_upper()` / `.to_lower()` / `.reverse()`  (always copy into a fresh
//     buffer, min 1 byte; no already-cased identity short-circuit)
//   - `s.repeat(n)`             (always a fresh buffer; n <= 0 → fresh empty box)
//   - the free-function spellings `str_to_upper` / `str_to_lower` / `str_repeat`
//   - the alloc BUILTINS `chr(n)` (fresh 1-char box) and `string_from_bytes_unchecked(arr)`
//     (packs into a fresh box) — fixed fresh-allocating semantics, no user override
//     (unlike `.to_string()`, whose derived/hand-written body may return an aliased
//     field, so it stays excluded).
// NOTE `i32_to_string(n)` is deliberately NOT here: its emitter returns a box whose
// `data` points into the MIDDLE of a 32-byte scratch buffer (digits written
// backwards), not at an allocation boundary, so the box cannot be cleanly reclaimed
// (the over-release detector fires). Freeing it would need an emitter fix (copy the
// digits to a tight fresh buffer) across all backends — a separate slice.
//
// DELIBERATELY EXCLUDED — these alias live data and would OVER-RELEASE if freed:
//   - `s.replace(a, b)` / `str_replace`  (returns the receiver box UNCHANGED on
//     an empty `old` / no match — an alias of the receiver)
//   - `.to_string()` / `.to_debug()`     (the string-identity case returns the
//     receiver box)
//   - a bare ident / field-read / slice (each aliases a live box the IR path
//     never sweeps). A string LITERAL is NOT in this list: its box is freshly
//     allocated per evaluation (#2649 Option A), so it aliases nothing — see the
//     Static note in str_producer_ownership.
// Every excluded form stays inc'd at construction → the field-drop only decs the
// dup (sound, leaks, never an over-release).
// str_producer_ownership classifies the OWNERSHIP a value-producing string
// expression yields — the self-host counterpart of native ast.ExprResultOwnership
// (issue #4297 Option C, slice CS1). It names, as one classification, the
// scattered freshness heuristics: which producers hand back a FRESH owned box,
// which a borrowed alias, which a zero-copy VIEW, which an immortal literal.
// Codes mirror native ast.Ownership: 0 = Owned, 1 = Borrowed, 2 = View, 3 = Static.
//   - a fresh producer — a concat `a + b`, the alloc builtins chr /
//     string_from_bytes_unchecked / __raw_string, the str_to_upper / str_to_lower /
//     str_repeat free-fns, and the .to_upper / .to_lower / .reverse / .repeat
//     methods — is OWNED: a fresh rc=1 box the field-drop reclaims;
//   - a view `slice_unchecked(s, a, b)` / `.trim()` is a VIEW: a zero-copy
//     immortal box (rc=-1, #4294) sharing the source buffer, never freed;
//   - a string LITERAL is STATIC — its DATA is interned .rodata, but since #2649
//     Option A the BOX around it is freshly __fern_str_box'd at rc=1 on every
//     evaluation, so a Static value is as sole-owned as an Owned one. Callers
//     deciding whether to FREE must treat the two alike (__fern_str_free's
//     heap-range guard on the data pointer frees the box and leaves the static
//     bytes); only callers reasoning about the BUFFER may separate them;
//   - everything else — a bare ident / field-read / general call — is BORROWED:
//     it aliases a live box a live owner still holds.
// The View / Static / Borrowed distinctions are consumed by later slices (CS2)
// where the old boolean was lossy; expr_is_fresh_str below is exactly `== Owned`,
// so every existing caller is byte-for-byte unchanged.
pub function str_producer_ownership(e: ast.Expr, s: LowerState): i32 {
    match (e) {
        ast.ExprString(_) => { return 3; },   // static / immortal literal
        ast.ExprBinary(b) => {
            if (b.op == "+") { if (expr_is_str(b.left, s) || expr_is_str(b.right, s)) { return 0; } }
            return 1;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
                            || cid.name == "str_repeat") { return 0; }
                    if (cid.name == "chr" || cid.name == "string_from_bytes_unchecked") { return 0; }
                    // slice_unchecked is the builtin spelling of `s[a:b]` —
                    // the same zero-copy view as the ExprSlice arm above.
                    if (cid.name == "slice_unchecked" && c.args.len() == 3) { return 2; }
                    // __raw_string boxes a freshly-__raw_alloc'd buffer → a fresh
                    // owned string (#2649 Tier-2 floor).
                    if (cid.name == "__raw_string" && c.args.len() == 2) { return 0; }
                    // i32_to_string is Owned on THIS path (#4355 — the exclusion
                    // note's resolution): the historical exclusion guarded the
                    // NATIVE emitter's mid-buffer boxing, but everything irlower
                    // emits calls the self-host __fern_i32_to_string, which
                    // __raw_alloc(len)s a tight buffer and boxes it at the base —
                    // an alloc boundary __fern_str_free reclaims cleanly (the
                    // same rationale that already admits it in
                    // str_free_producer_ident). Without this a replaced
                    // `name: i32_to_string(n)` struct field was construction-
                    // retained (Borrowed) and leaked one count per rebind.
                    if (cid.name == "i32_to_string" && c.args.len() == 1) { return 0; }
                    // A whole-program str-fresh-ret free function (every return
                    // freshly allocated) is Owned for the same reason the builtin
                    // producers above are. Without it a user producer read as
                    // Borrowed, so a `name: wide(n)` struct field took the
                    // construction retain meant for a possible alias — an inc
                    // nothing ever decs, since the callee's own reference was
                    // moved out and dropped. The registry is the one the
                    // caller-side binding reclaim already trusts to FREE such a
                    // result at scope exit, a strictly stronger claim than this.
                    if (util.index_of_str(s.sigs.str_fresh_ret_fns, cid.name) >= 0 && s.slot_of(cid.name) < 0) { return 0; }
                    return 1;
                },
                ast.ExprFieldAccess(cfa) => {
                    // trim copies since #7393, but only a STRING receiver's trim
                    // is the builtin — a user method of the same name may alias.
                    if (cfa.field == "trim" && c.args.len() == 0) {
                        if (expr_is_str(cfa.obj, s)) { return 0; }
                        return 1;
                    }
                    if ((cfa.field == "to_ascii_upper" || cfa.field == "to_ascii_lower" || cfa.field == "reverse")
                            && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return 0; }
                    if (cfa.field == "repeat" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return 0; }
                    return 1;
                },
                _ => { return 1; }
            }
        },
        _ => { return 1; }
    }
    return 1;
}

// expr_is_fresh_str reports whether `e` produces a FRESH, sole-owned heap string
// — the retain gate for a struct string field / reclaim temp. Derived from
// str_producer_ownership (Owned == fresh); see the classifier for the
// per-producer rationale and the excluded (aliasing / view / literal) forms.
pub function expr_is_fresh_str(e: ast.Expr, s: LowerState): boolean {
    return str_producer_ownership(e, s) == 0;
}

// field_ownerships precomputes str_producer_ownership for EVERY override value of
// a struct literal, ONCE per struct-lit, returning an i32[] parallel to
// slit.field_values (indexed by the override position `found`). This is the
// #4297 A2 unblock (see docs/OWNERSHIP-TYPES-PLAN.md): the freshness/ownership
// classification reads each field-value EXPRESSION — an aliasing read that the
// native Perceus taint model turns into a leak. Confining those reads to this
// COLD helper (called once per struct-lit) instead of the HOT lower_expr path
// (millions of calls emitting a large module) keeps lower_expr's locals
// taint-free: it consults the precomputed SCALAR i32[] (a scalar-array element
// read does not taint), while its single lower_expr(field_value) read still
// MOVES the value. Bounded per-struct-lit leak instead of the emit runaway.
pub function field_ownerships(slit: ast.ExprStructLit, s: LowerState): i32[] {
    var out: i32[] = [];
    var j: i32 = 0;
    while (j < slit.field_values.len()) {
        out = out.append(str_producer_ownership(slit.field_values[j], s));
        j = j + 1;
    }
    return out;
}

// str_binding_ownership classifies the ownership a NEW BINDING acquires from
// its init expression `e` -- the seeding-side companion of
// str_producer_ownership (#4297 CS4, the self-host mirror of native
// ast.ExprResultOwnershipWith's binding refinement; the result lands in the
// slot's str_own via mark_str_own). Producer forms classify by syntax
// (str_producer_ownership); a bare IDENT init consults the SOURCE slot's
// carried fact: a View / Static source propagates (the alias references the
// same immortal box, so the new binding is exactly as unfreeable), while an
// Owned or Borrowed source yields Borrowed -- an alias never ACQUIRES
// ownership; the original binding keeps the owning reference (freeing both
// would be the #4294 over-release).
pub function str_binding_ownership(e: ast.Expr, s: LowerState): i32 {
    match (e) {
        ast.ExprIdent(id) => {
            var si: i32 = s.slot_of(id.name);
            if (si >= 0 && s.is_str_slot(si)) {
                var so: i32 = s.str_own_slot(si);
                if (so == 2 || so == 3) { return so; }
            }
            return 1;
        },
        _ => { return str_producer_ownership(e, s); }
    }
    return 1;
}

// str_expr_ownership classifies the ownership class of the box a string
// expression EVALUATES TO -- the read-side classifier (#4297 CS4, mirroring
// native ast.ExprResultOwnershipWith): producer forms classify by syntax; a
// bare ident reflects its binding's slot-carried str_own VERBATIM (an Owned
// local reads as Owned -- whether the READER must retain before storing the
// alias is the RC pass's separate question, exactly as the native doc
// draws the line). An unknown / non-string ident falls back to 1 (Borrowed),
// the conservative never-free class. No codegen decision consults this yet;
// it is the query surface CS3 (#4355) and the reuse-analysis slice read
// instead of re-deriving ownership from the syntactic freshness heuristics.
pub function str_expr_ownership(e: ast.Expr, s: LowerState): i32 {
    match (e) {
        ast.ExprIdent(id) => {
            var si: i32 = s.slot_of(id.name);
            if (si >= 0 && s.is_str_slot(si)) { return s.str_own_slot(si); }
            return 1;
        },
        _ => { return str_producer_ownership(e, s); }
    }
    return 1;
}

// str_free_producer_ident reports whether an UNAMBIGUOUS named fresh-string
// producer — a builtin / free-function that ALWAYS returns a freshly-allocated,
// sole-owned heap string boxed at an allocation boundary — is being called. Each
// is unambiguous by NAME (no operand-type inference needed), so it is admitted
// regardless of the binding annotation (the un-annotated widening, mirroring the
// tuple `(i, 1)` arc):
//   - chr(n) / string_from_bytes_unchecked(a)           — alloc builtins, fresh box
//   - str_to_upper/str_to_lower/str_repeat(s) — free-fn spellings, fresh copy
//   - i32_to_string(n)                         — decimal-text builtin. Also Owned
//     in str_producer_ownership / expr_is_fresh_str since #4355 (the historical
//     exclusion guarded the NATIVE emitter's mid-buffer boxing; everything
//     irlower emits calls the self-host __fern_i32_to_string, which
//     __raw_alloc(len)s a tight buffer and boxes it at the base, so its data
//     pointer IS an alloc boundary and __fern_str_free (class = ceil(len/8))
//     reclaims it cleanly). (u32_to_string is left out — expr_is_str doesn't
//     str-track it, so its slot never marks is_str.)
//   - __raw_string(p, n)                       — the Tier-2 raw box constructor
// EXCLUDED here (need the `: string` disambiguation, handled in the caller): a
// bare `a + b` (could be int add) and the `.<m>()` methods (`.reverse()` /
// `.repeat()` also exist on arrays). `.to_string()` stays excluded entirely — it
// is the identity/alias case on a string receiver and may return a struct field.
function str_free_producer_ident(c: ast.ExprCall): boolean {
    match (c.callee) {
        ast.ExprIdent(cid) => {
            if (cid.name == "chr" || cid.name == "string_from_bytes_unchecked") { return true; }
            if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
                    || cid.name == "str_repeat" || cid.name == "str_trim") { return true; }
            if (cid.name == "i32_to_string" && c.args.len() == 1) { return true; }
            if (cid.name == "__raw_string" && c.args.len() == 2) { return true; }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

// str_local_binding_is_fresh reports (purely SYNTACTICALLY) whether `var <name> =
// init` binds a value shaped like a FRESH, sole-owned HEAP string — the string
// analogue of tuple_lit_is_fresh_scalar. It is the FRESH gate only; the TYPE gate
// is applied separately by slot_is_reclaimable_str (the slot's `is_str`, set from
// the type-aware expr_is_str at the StmtVar lowering). That two-gate split is why
// NO `: string` annotation is needed here: an un-annotated `a + b` or `x.reverse()`
// that is actually int-add / an array method has is_str == false, so it is never
// reclaimed even though it matches syntactically. The admitted shapes each allocate
// a fresh buffer + box when they ARE strings:
//   - an UNAMBIGUOUS named producer (str_free_producer_ident) — chr /
//     string_from_bytes_unchecked / str_to_upper / str_to_lower / str_repeat /
//     str_trim (copies since #7393) / i32_to_string / __raw_string;
//   - an `a + b` CONCAT (fresh buffer + box when either side is a string);
//   - a `.to_ascii_upper()` / `.to_ascii_lower()` / `.reverse()` / `.repeat(n)`
//     method (str_fresh_alloc_method: each copies into a fresh buffer on a string
//     receiver; expr_is_str only marks the slot is_str for a STRING receiver, so
//     an array `.reverse()`/`.repeat()` is never reclaimed). The `.trim()` METHOD
//     is not among them — only the `str_trim` free-function spelling is.
// DELIBERATELY EXCLUDED (each may ALIAS a live box → freeing would over-release,
// and each is is_str yet NOT fresh, so the type gate alone would not stop them):
// a string LITERAL (static, not heap), a bare ident / field / index / slice
// (aliases a live string), `.replace()` / `.to_string()` (receiver-identity
// fast-paths), and a general call (may return a borrowed param).
function str_local_binding_is_fresh(init: ast.Expr): boolean {
    match (init) {
        ast.ExprCall(c) => {
            if (str_free_producer_ident(c)) { return true; }
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (!str_fresh_alloc_method(cfa.field)) { return false; }
                    if (cfa.field == "repeat") { return c.args.len() == 1; }
                    return c.args.len() == 0;
                },
                _ => { return false; },
            }
        },
        ast.ExprBinary(b) => {
            // A CONCAT (fresh when it is a string; int-add is filtered by is_str).
            return b.op == "+";
        },
        _ => { return false; },
    }
    return false;
}

// is_fresh_str_temp reports whether the string expression `e`, when lowered as a
// concat OPERAND, produces a FRESH, ANONYMOUS box that this frame solely owns and
// that is dead the instant the concat has read it — so it can be freed right after
// (#2649 anonymous-temporary reclaim). An anonymous sub-expression has no name, so
// it is referenced nowhere else and cannot alias a live value:
//   - a string LITERAL ("x"): const_str allocates a fresh 16-byte box (its .rodata
//     data is skipped by __fern_str_free's heap-base guard; the box is reclaimed on
//     asm, and on wasm the whole literal is data-section so arr_dec is a guarded
//     no-op) — this is the `s + "x"` per-iteration box leak;
//   - a fresh producer (str_local_binding_is_fresh: a nested concat, a string
//     method, or a named producer) — the intermediate of `a + b + c` / `x + f(y)`.
// A bare ident / field / index (an ALIAS of a live string) is excluded — freeing it
// would dangle the aliased value. The expr_is_str gate confirms it is a string (so
// an int `+` operand or an array `.reverse()` never matches).
function is_fresh_str_temp(e: ast.Expr, s: LowerState): boolean {
    if (!expr_is_str(e, s)) { return false; }
    match (e) { ast.ExprString(_) => { return true; }, _ => {} }
    // `n.to_string()` on a SCALAR receiver is the builtin decimal-text
    // producer (i32_to_string and its wide-int / f64 siblings) — always a
    // fresh box, so the concat may free it (#4353 concat-temp finding: this
    // was the one fresh producer str_local_binding_is_fresh missed, leaking
    // the temp per `"x" + n.to_string()` evaluation). A struct / enum / dyn
    // receiver's to_string (user-written or @derive) may return an ALIAS of
    // a live field, so only a provably-scalar receiver admits.
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprFieldAccess(fa) => {
                        if (fa.field == "to_string" && tostring_recv_is_scalar(fa.obj, s)) { return true; }
                        // …and on a receiver that is itself a fresh anonymous temp:
                        // the identity result is that temp, which nothing else names.
                        if (fa.field == "to_string" && is_fresh_str_temp(fa.obj, s)) { return true; }
                    },
                    _ => {}
                }
            }
            // A direct call to a proven fresh-string PRODUCER (`size(mks(i))`).
            // str_fresh_ret_fns is the same registry every other owner of a
            // returned box consults: every return is a fresh, sole-owned box,
            // so the temp is this frame's and nothing else names it. A local
            // of the callee's name shadows the declaration and is refused —
            // the registry is keyed by declaration.
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (util.index_of_str(s.sigs.str_fresh_ret_fns, cid.name) >= 0 && s.slot_of(cid.name) < 0) { return true; }
                },
                // A fresh-ALLOCATING string builtin on a string receiver. Their
                // runtime bodies allocate unconditionally and return the new box
                // — `__fern_str_to_upper` is `__raw_alloc(n)` … `__raw_string(p, n)`
                // with no identity path at all, and `__fern_str_repeat` forces a
                // 1-byte cap so even a zero-length result allocates. Nothing else
                // names the box, so a consuming site may release it exactly as it
                // releases a concat temp.
                ast.ExprFieldAccess(mfa) => {
                    if (str_fresh_alloc_method(mfa.field) && expr_is_str(mfa.obj, s)) { return true; }
                    // `xs.join(sep)` as a concat operand — same always-fresh
                    // accumulator, on an ARRAY receiver rather than a string one.
                    if (mfa.field == "join" && c.args.len() == 1 && expr_is_strarr(mfa.obj, s)) { return true; }
                    // A SOURCE-DECLARED method whose every return is a freshly
                    // allocated box ("SFRFRESHNAME:", the strict class the
                    // binding credit reads). It cannot be handing its receiver
                    // or a view of one back, so the result is a temp nobody else
                    // names — which is the whole question here. Without it a
                    // chain of such methods released only its ROOT receiver and
                    // stranded every intermediate.
                    if (util.index_of_str(s.sigs.str_fresh_ret_fns, "SFRFRESHNAME:" + mfa.field) >= 0) { return true; }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return str_local_binding_is_fresh(e);
}

// str_fresh_alloc_method: a string builtin whose result is ALWAYS a newly
// allocated box. Strictly smaller than str_borrowing_method, which also admits
// the predicates (scalar results, no box at all) and is about what a method does
// to its RECEIVER; this is about what it returns. `trim` copies since #7393
// but stays OUT of this state-free set: a user method named `trim` on a
// non-string receiver may return a field alias, and admitting it by name
// alone frees the field under its owner (the str-trim-user-method pin) — its
// credit comes from the receiver-TYPE-gated trim collector instead. `replace`
// returns the receiver unchanged when the needle is absent, so it stays out —
// and `lines` / `split` return arrays, not strings.
function str_fresh_alloc_method(field: string): boolean {
    return field == "to_ascii_upper" || field == "to_ascii_lower"
        || field == "reverse" || field == "repeat";
}

// tostring_recv_is_scalar: the receiver of a `.to_string()` is provably a
// scalar — a number literal, a scalar cast (`x as u32` — any as_* except the
// pointer-shaped string/array hops), an ARITHMETIC combination of scalars, or
// a local/param slot carrying NO pointer-shape marker (not string / array /
// struct / enum / dyn / map / tuple / Option — params mark all of these at
// entry, so an unmarked slot is an i32/i64/u32/u64/f64/f32/bool/subword
// scalar). Scalar to_string always allocates fresh; anything else may be a
// user method returning an alias.
function tostring_recv_is_scalar(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprNumber(_) => { return true; },
        ast.ExprUnary(u) => {
            if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
                var tgt: string = slice_unchecked(u.op, 3, u.op.len()) + "";
                return tgt == "i32" || tgt == "i64" || tgt == "u32" || tgt == "u64"
                    || tgt == "f64" || tgt == "f32" || tgt == "u8" || tgt == "usize";
            }
            // Negation / bitwise-not of a scalar is a scalar. `!` is excluded:
            // it yields a boolean, whose `to_string` is a source-declared method
            // this predicate makes no claim about.
            if (u.op == "-" || u.op == "~") { return tostring_recv_is_scalar(u.operand, s); }
            return false;
        },
        // `(i % 8).to_string()` — an arithmetic operator over operands this
        // predicate already proves scalar yields a scalar, so the receiver is
        // the builtin producer's just as a bare slot is. Only the plain
        // operators: `+?` / `+|` and the comparisons produce an Option resp. a
        // boolean, neither of which this claim covers. A string `+` cannot slip
        // through — a string operand is a slot or an ExprString, and neither
        // arm admits one.
        ast.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%"
                    || b.op == "&" || b.op == "|" || b.op == "^" || b.op == "<<" || b.op == ">>") {
                return tostring_recv_is_scalar(b.left, s) && tostring_recv_is_scalar(b.right, s);
            }
            return false;
        },
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0) { return false; }
            if (s.is_str_slot(sl) || s.is_arr_slot(sl)) { return false; }
            if (s.struct_type_of_slot(sl).len() > 0) { return false; }
            if (s.map_type_of(sl).len() > 0) { return false; }
            if (s.locals[sl].tuple_elems.len() > 0) { return false; }
            if (s.locals[sl].opt_type.len() > 0) { return false; }
            if (s.locals[sl].is_strarr || s.locals[sl].is_arrarr || s.locals[sl].is_f64arr
                    || s.locals[sl].is_i64arr || s.locals[sl].is_closurearr || s.locals[sl].is_fnarr) { return false; }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// is_sat_op reports whether `op` is one of the saturating arithmetic operators
// (`+|` / `-|` / `*|` / `<<|`, #5542): integer-only, clamping to the operand
// type's [MIN, MAX] instead of wrapping.
pub function is_sat_op(op: string): boolean {
    return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

// lower_sat_binary lowers a saturating integer binary (`+|` / `-|` / `*|`).
//
// The tests are formulated as PRE-checks against the type's MIN / MAX rather
// than as post-hoc overflow-flag reconstruction, so one shape works at every
// width — including sub-i32 `u8`, whose wrapping mask never has to run because
// a saturated result is in range by construction. Every intermediate
// (`MAX - r` for `r > 0`, `MIN - r` for `r < 0`, …) is provably in range.
//
//     signed   a +| b →  b > 0 && a > MAX - b ? MAX
//                      : b < 0 && a < MIN - b ? MIN : a + b
//     signed   a -| b →  b < 0 && a > MAX + b ? MAX
//                      : b > 0 && a < MIN + b ? MIN : a - b
//     unsigned a +| b →  a > MAX - b ? MAX : a + b
//     unsigned a -| b →  a < b ? 0 : a - b
//     unsigned a *| b →  a != 0 && b > MAX / a ? MAX : a * b
//
// Signed `*|` is the one shape a pre-check can't express cheaply (four sign
// quadrants), so it post-checks the WRAPPED product with a division:
// `a != 0 && (s / a != b || (a == -1 && b == MIN))`. The second term is needed
// because Fern's division is total — `MIN / -1` yields `MIN`, so the round-trip
// spuriously agrees on exactly that pair. The clamp direction is the sign of
// the true product, `(a < 0) ^ (b < 0)`. Division by zero in the guarded
// operand is harmless for the same total-division reason (`x / 0 == 0`,
// docs/INTEGER-SEMANTICS.md) — the `a != 0` conjunct discards it.
//
// `<<|` is the odd one out: it post-checks with a round-trip (`(a << c) >> c ==
// a ?`) rather than a pre-check, because the negative-side pre-check bound is
// `ceil(MIN / 2^c)` and an arithmetic shift only yields the floor — `-1 <<| 31`
// must clamp to MIN, yet `MIN >> 31` is `-1`. The shift back uses the SAME
// masked count, and is arithmetic for signed / logical for unsigned, which is
// what makes it value-preserving exactly when the shift did not overflow.
//
// Branches are the self-host's void-`if` + store-to-temp shape (lower_value_if),
// not typed block results, so every backend lowers it unchanged. Mirrors
// `internal/ir.(*builder).satBinary` — keep the two in step.
function lower_sat_binary(b: ast.ExprBinary, e: ast.Expr, s: LowerState): LowerState {
    var wide: boolean = infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64;
    var kind: string = "i32";
    if (wide) {
        if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) { kind = "u64"; } else { kind = "i64"; }
    } else if (expr_is_u32(b.left, s) || expr_is_u32(b.right, s)) {
        kind = "u32";
    } else if (expr_subword_kind(e, s) == "u8") {
        kind = "u8";
    }
    var uns: boolean = kind == "u8" || kind == "u32" || kind == "u64";
    var w: i32 = 0;
    if (wide) { w = 64; }

    // Spill both operands: every shape below reads each of them twice or more.
    var p: LowerState = s;
    var lname: string = "$satl" + util.i32_to_string(p.locals.len());
    p = p.add_local(lname);
    var lslot: i32 = p.slot_of(lname);
    if (wide) { p = p.mark_i64(lslot, true); }
    if (wide) { p = lower_i64(b.left, p); } else { p = lower_expr(b.left, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(lslot));
    var rname: string = "$satr" + util.i32_to_string(p.locals.len());
    p = p.add_local(rname);
    var rslot: i32 = p.slot_of(rname);
    if (wide) { p = p.mark_i64(rslot, true); }
    if (wide) { p = lower_i64(b.right, p); } else { p = lower_expr(b.right, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(rslot));
    var oname: string = "$sato" + util.i32_to_string(p.locals.len());
    p = p.add_local(oname);
    var oslot: i32 = p.slot_of(oname);
    if (wide) { p = p.mark_i64(oslot, true); }

    if (b.op == "<<|") {
        var hname: string = "$sats" + util.i32_to_string(p.locals.len());
        p = p.add_local(hname);
        var hslot: i32 = p.slot_of(hname);
        if (wide) { p = p.mark_i64(hslot, true); }
        var back: string = "shr_s";
        if (uns) { back = "shr_u"; }
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith("shl", kind, w, p);
        p = p.emit(ir.op_store_local(hslot));
        p = sat_load(hslot, p);
        p = sat_load(rslot, p);
        p = p.emit(ir.op_bin(back, w, false));
        p = sat_load(lslot, p);
        p = p.emit(ir.op_bin("eq", w, false));
        p = p.emit(ir.op_if(0));
        p = sat_load(hslot, p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        if (uns) {
            p = sat_const(kind, "max", p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_end());
            return sat_load(oslot, p);
        }
        p = sat_load(lslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("lt_s", w, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "min", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_const(kind, "max", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_end());
        p = p.emit(ir.op_end());
        return sat_load(oslot, p);
    }

    if (uns) {
        if (b.op == "+|") {
            p = sat_load(lslot, p);
            p = sat_const(kind, "max", p);
            p = sat_load(rslot, p);
            p = sat_arith("sub", kind, w, p);
            p = p.emit(ir.op_bin("gt_u", w, false));
            p = p.emit(ir.op_if(0));
            p = sat_const(kind, "max", p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_else());
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            p = sat_arith("add", kind, w, p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_end());
            return sat_load(oslot, p);
        }
        if (b.op == "-|") {
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            p = p.emit(ir.op_bin("lt_u", w, false));
            p = p.emit(ir.op_if(0));
            p = sat_const(kind, "zero", p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_else());
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            p = sat_arith("sub", kind, w, p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_end());
            return sat_load(oslot, p);
        }
        p = sat_load(lslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("ne", w, false));
        p = sat_load(rslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(lslot, p);
        p = sat_arith("div_u", kind, w, p);
        p = p.emit(ir.op_bin("gt_u", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "max", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith("mul", kind, w, p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_end());
        return sat_load(oslot, p);
    }

    if (b.op == "+|" || b.op == "-|") {
        // `adj` reaches the guard bound (MAX ∓ b) — the inverse of the
        // arithmetic; `act` is the arithmetic itself. The sign test on b
        // that selects the clamp direction flips with the operator too.
        var act: string = "add";
        var adj: string = "sub";
        var hicmp: string = "gt_s";
        var locmp: string = "lt_s";
        if (b.op == "-|") {
            act = "sub";
            adj = "add";
            hicmp = "lt_s";
            locmp = "gt_s";
        }
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(hicmp, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("gt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "max", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(locmp, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "min", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("lt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "min", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith(act, kind, w, p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_end());
        p = p.emit(ir.op_end());
        return sat_load(oslot, p);
    }

    // Signed `*|`: stash the wrapped product, then the division round-trip.
    var sname: string = "$satp" + util.i32_to_string(p.locals.len());
    p = p.add_local(sname);
    var sslot: i32 = p.slot_of(sname);
    if (wide) { p = p.mark_i64(sslot, true); }
    p = sat_load(lslot, p);
    p = sat_load(rslot, p);
    p = sat_arith("mul", kind, w, p);
    p = p.emit(ir.op_store_local(sslot));
    p = sat_load(lslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(sslot, p);
    p = sat_load(lslot, p);
    p = sat_arith("div_s", kind, w, p);
    p = sat_load(rslot, p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(lslot, p);
    p = sat_const(kind, "negone", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = sat_load(rslot, p);
    p = sat_const(kind, "min", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_bin("or", 0, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_if(0));
    p = sat_load(lslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("lt_s", w, false));
    p = sat_load(rslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("lt_s", w, false));
    p = p.emit(ir.op_bin("xor", 0, false));
    p = p.emit(ir.op_if(0));
    p = sat_const(kind, "min", p);
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_else());
    p = sat_const(kind, "max", p);
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_end());
    p = p.emit(ir.op_else());
    p = sat_load(sslot, p);
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_end());
    return sat_load(oslot, p);
}

// sat_load / sat_const / sat_arith are the width-aware emit primitives the
// saturating lowering is written against.
//
// `sat_const` pushes one of the four constants the lowering needs ("min" /
// "max" / "zero" / "negone") at the operand type's width. A 64-bit constant
// goes through op_const_i64_TEXT: every IR backend splices the literal text
// into its 64-bit immediate (movabsq / ldr =N / i64.const) and never reads
// op_const_i64's parsed i64_imm. An unsigned MAX rides its all-ones bit
// pattern (-1), which the operand-width unsigned compares read back as 2^W-1;
// a u32 one is re-zero-extended so the register backends hold it as 0xFFFFFFFF
// rather than a sign-extended -1.
//
// `sat_arith` re-applies the width normalisation the ordinary binary path
// applies after add/sub/mul/shl: the register backends hold a u32 zero-extended and
// an i32 sign-extended in a 64-bit register, so a 32-bit product must be
// narrowed before the signed `*|` division round-trip can detect its overflow.
function sat_load(slot: i32, s: LowerState): LowerState {
    return s.emit(ir.op_load_local(slot));
}
function sat_const(kind: string, which: string, s: LowerState): LowerState {
    if (kind == "i64" || kind == "u64") {
        var t: string = "0";
        if (which == "negone") { t = "-1"; }
        if (which == "max") {
            if (kind == "u64") { t = "-1"; } else { t = "9223372036854775807"; }
        }
        if (which == "min" && kind == "i64") { t = "-9223372036854775808"; }
        return s.emit(ir.op_const_i64_text(t));
    }
    var v: i32 = 0;
    if (which == "negone") { v = 0 - 1; }
    if (which == "max") {
        if (kind == "u8") { v = 255; } else if (kind == "u32") { v = 0 - 1; } else { v = 2147483647; }
    }
    if (which == "min" && kind == "i32") { v = 0 - 2147483647 - 1; }
    var p: LowerState = s.emit(ir.op_const_i32(v));
    if (kind == "u32") { return p.emit(ir.op_u32_wrap()); }
    return p;
}
function sat_arith(k: string, kind: string, w: i32, s: LowerState): LowerState {
    var p: LowerState = s.emit(ir.op_bin(k, w, false));
    if (k != "add" && k != "sub" && k != "mul" && k != "shl") { return p; }
    if (kind == "u32") { return p.emit(ir.op_u32_wrap()); }
    if (kind == "i32") { return p.emit(ir.op_int_cast("i32")); }
    if (kind == "u8") { return p.emit(ir.op_int_cast("u8")); }
    return p;
}

// is_chk_op reports whether `op` is a checked arithmetic operator (`+?` /
// `-?` / `*?`, #5542): integer-only, yielding `Some(result)` when it fits the
// operand type and `None` on overflow.
pub function is_chk_op(op: string): boolean {
    return op == "+?" || op == "-?" || op == "*?" || op == "/?" || op == "%?" || op == "<<?" || op == ">>?";
}

// chk_opt_type_tag is the "Option[T]" tag a checked binary (`+?` / `-?` / `*?`)
// evaluates to, T being the operand width. Option-consuming positions (a
// `match` scrutinee, a `?`) resolve the scrutinee's Option type by walking the
// expression; without this a `match (a +? b)` can't recover the Some payload's
// type and bails. The width detection mirrors
// lower_checked_binary's `kind`.
pub function chk_opt_type_tag(b: ast.ExprBinary, s: LowerState): string {
    if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) {
        if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) { return "Option[u64]"; }
        return "Option[i64]";
    }
    if (expr_is_u32(b.left, s) || expr_is_u32(b.right, s)) { return "Option[u32]"; }
    // u8 has no distinct Option payload representation — it rides an i32 slot
    // (op_opt_make stores the 4-byte wrapped value), so the Some(v) arm binds v
    // as i32; "Option[u8]" isn't a payload tag the arm reader recognises.
    return "Option[i32]";
}

// chk_overflow pushes the overflow boolean for a checked binary. It is the
// SAME clamp condition lower_sat_binary tests (so it inherits that shape's
// per-backend proof), OR'd across the two saturation directions for
// signed add / sub because a checked op only cares that it overflowed at
// all, not which way:
//
//     unsigned +?  l > MAX - r
//     unsigned -?  l < r
//     unsigned *?  l != 0 && r > MAX / l
//     signed   +?  (r > 0 && l > MAX - r) || (r < 0 && l < MIN - r)
//     signed   -?  (r < 0 && l > MAX + r) || (r > 0 && l < MIN + r)
//     signed   *?  l != 0 && (s / l != r || (l == -1 && r == MIN))   (s = l * r wrapped)
// chk_norm masks a value to the operand width — the same normalisation
// sat_arith applies after add/sub/mul, reused for the `<<?` result (which
// sat_arith leaves un-masked).
function chk_norm(kind: string, s: LowerState): LowerState {
    if (kind == "u32") { return s.emit(ir.op_u32_wrap()); }
    if (kind == "i32") { return s.emit(ir.op_int_cast("i32")); }
    if (kind == "u8") { return s.emit(ir.op_int_cast("u8")); }
    return s;
}

function chk_overflow(op: string, kind: string, uns: boolean, w: i32, lslot: i32, rslot: i32, sslot: i32, s: LowerState): LowerState {
    var p: LowerState = s;
    // Checked shift: fail on an out-of-range count — `>= width` (spelled
    // `> width-1` so gt_u / gt_s suffice) and, for signed operands, `< 0`.
    if (op == "<<?" || op == ">>?") {
        var wm1: i32 = 31;
        if (kind == "u8") { wm1 = 7; } else if (w == 64) { wm1 = 63; }
        p = sat_load(rslot, p);
        if (w == 64) { p = p.emit(ir.op_const_i64_text("63")); } else { p = p.emit(ir.op_const_i32(wm1)); }
        if (uns) { return p.emit(ir.op_bin("gt_u", w, false)); }
        p = p.emit(ir.op_bin("gt_s", w, false));   // r > width-1
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("lt_s", w, false));    // r < 0
        return p.emit(ir.op_bin("or", 0, false));
    }
    // Checked divide / remainder: fail on a zero divisor, and for signed
    // operands also on `MIN / -1` (the one overflowing division). Same
    // condition for `/?` and `%?`.
    if (op == "/?" || op == "%?") {
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("eq", w, false));   // r == 0
        if (uns) { return p; }
        p = sat_load(lslot, p);
        p = sat_const(kind, "min", p);
        p = p.emit(ir.op_bin("eq", w, false));    // l == MIN
        p = sat_load(rslot, p);
        p = sat_const(kind, "negone", p);
        p = p.emit(ir.op_bin("eq", w, false));    // r == -1
        p = p.emit(ir.op_bin("and", 0, false));
        return p.emit(ir.op_bin("or", 0, false)); // (r==0) || (l==MIN && r==-1)
    }
    if (uns) {
        if (op == "+?") {
            p = sat_load(lslot, p);
            p = sat_const(kind, "max", p);
            p = sat_load(rslot, p);
            p = sat_arith("sub", kind, w, p);
            return p.emit(ir.op_bin("gt_u", w, false));
        }
        if (op == "-?") {
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            return p.emit(ir.op_bin("lt_u", w, false));
        }
        // *?  l != 0 && r > MAX / l
        p = sat_load(lslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("ne", w, false));
        p = sat_load(rslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(lslot, p);
        p = sat_arith("div_u", kind, w, p);
        p = p.emit(ir.op_bin("gt_u", w, false));
        return p.emit(ir.op_bin("and", 0, false));
    }
    if (op == "+?" || op == "-?") {
        var rsign_hi: string = "gt_s";
        var rsign_lo: string = "lt_s";
        var adj: string = "sub";
        if (op == "-?") {
            rsign_hi = "lt_s";
            rsign_lo = "gt_s";
            adj = "add";
        }
        // hi = (r <rsign_hi> 0) && (l > MAX <adj> r)
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(rsign_hi, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("gt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        // lo = (r <rsign_lo> 0) && (l < MIN <adj> r)
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(rsign_lo, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "min", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("lt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        return p.emit(ir.op_bin("or", 0, false));
    }
    // signed *?  l != 0 && (s / l != r || (l == -1 && r == MIN))
    p = sat_load(lslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(sslot, p);
    p = sat_load(lslot, p);
    p = sat_arith("div_s", kind, w, p);
    p = sat_load(rslot, p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(lslot, p);
    p = sat_const(kind, "negone", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = sat_load(rslot, p);
    p = sat_const(kind, "min", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_bin("or", 0, false));
    return p.emit(ir.op_bin("and", 0, false));
}

// lower_checked_binary lowers a checked integer binary (`+?` / `-?` / `*?`,
// #5542): `Some(a <op> b)` when the exact result fits the operand type,
// `None` on overflow. The overflow predicate is chk_overflow (the SAME
// condition lower_sat_binary clamps on); the difference is only the
// outcome — None vs Some(wrapped) instead of MIN/MAX/clamp.
//
// void-`if` + store-to-temp (the Option value rides oslot, a default,
// un-i64-marked slot: a pointer, i32 on wasm and 64-bit on the register
// backends). Mirrors the native desugar Binary.CheckedLowered — keep the
// two in step.
function lower_checked_binary(b: ast.ExprBinary, e: ast.Expr, s: LowerState): LowerState {
    var wide: boolean = infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64;
    var kind: string = "i32";
    if (wide) {
        if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) { kind = "u64"; } else { kind = "i64"; }
    } else if (expr_is_u32(b.left, s) || expr_is_u32(b.right, s)) {
        kind = "u32";
    } else if (expr_subword_kind(e, s) == "u8") {
        kind = "u8";
    }
    var uns: boolean = kind == "u8" || kind == "u32" || kind == "u64";
    var w: i32 = 0;
    if (wide) { w = 64; }

    var p: LowerState = s;
    var lname: string = "$chkl" + util.i32_to_string(p.locals.len());
    p = p.add_local(lname);
    var lslot: i32 = p.slot_of(lname);
    if (wide) { p = p.mark_i64(lslot, true); }
    if (wide) { p = lower_i64(b.left, p); } else { p = lower_expr(b.left, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(lslot));
    var rname: string = "$chkr" + util.i32_to_string(p.locals.len());
    p = p.add_local(rname);
    var rslot: i32 = p.slot_of(rname);
    if (wide) { p = p.mark_i64(rslot, true); }
    if (wide) { p = lower_i64(b.right, p); } else { p = lower_expr(b.right, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(rslot));
    var basek: string = "add";
    if (b.op == "-?") { basek = "sub"; }
    if (b.op == "*?") { basek = "mul"; }
    if (b.op == "/?") { if (uns) { basek = "div_u"; } else { basek = "div_s"; } }
    if (b.op == "%?") { if (uns) { basek = "rem_u"; } else { basek = "rem_s"; } }
    if (b.op == "<<?") { basek = "shl"; }
    if (b.op == ">>?") { if (uns) { basek = "shr_u"; } else { basek = "shr_s"; } }
    // The wrapped result `s`. `+?` / `-?` / `*?` compute it UP FRONT — signed
    // `*?`'s overflow check divides it back. `/?` / `%?` must NOT: a `84 /? 0`
    // would divide by zero here, which traps on the wasm IR path (op_bin div is
    // the raw, un-guarded division). Their overflow check needs only l / r, so
    // the division is deferred into the Some branch below, where the divisor is
    // provably non-zero (and not the signed `MIN / -1`) and so can't trap.
    var is_divrem: boolean = b.op == "/?" || b.op == "%?";
    var sname: string = "$chks" + util.i32_to_string(p.locals.len());
    p = p.add_local(sname);
    var sslot: i32 = p.slot_of(sname);
    if (wide) { p = p.mark_i64(sslot, true); }
    if (!is_divrem) {
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith(basek, kind, w, p);
        // `<<?`'s value can exceed the type width (`255u8 <<? 1 == 254`);
        // sat_arith doesn't mask a `shl` result (only add/sub/mul), so wrap
        // it to the operand width here — matching Fern's ordinary `<<` and
        // the native desugar. `>>?` never grows the value, so it needs none.
        if (b.op == "<<?") { p = chk_norm(kind, p); }
        p = p.emit(ir.op_store_local(sslot));
    }
    // The Option result rides a default (un-i64-marked) pointer slot.
    var oname: string = "$chko" + util.i32_to_string(p.locals.len());
    p = p.add_local(oname);
    var oslot: i32 = p.slot_of(oname);

    p = chk_overflow(b.op, kind, uns, w, lslot, rslot, sslot, p);
    p = p.emit(ir.op_if(0));
    p = p.emit(ir.op_opt_none());
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_else());
    if (is_divrem) {
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith(basek, kind, w, p);
    } else {
        p = sat_load(sslot, p);
    }
    if (wide) { p = p.emit(ir.op_opt_make_w(0, 64, true)); } else { p = p.emit(ir.op_opt_make(0)); }
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_end());
    return sat_load(oslot, p);
}

// emit_str_concat_reclaim lowers a string concat `b.left + b.right`, and frees any
// operand that is_fresh_str_temp classifies as a dead anonymous temp right after
// the concat consumes it. Each fresh operand is captured into a scratch slot before
// the concat (a store-then-reload that leaves the operand on the stack in place),
// the result is parked in its own scratch, the captured temps are freed, then the
// result is reloaded. A concat with NO fresh operand takes the plain fast path
// (bare op_str_concat), so non-reclaiming concats are byte-unchanged.
function emit_str_concat_reclaim(b: ast.ExprBinary, s: LowerState): LowerState {
    var lf: boolean = is_fresh_str_temp(b.left, s);
    var rf: boolean = is_fresh_str_temp(b.right, s);
    var lst: ArgStash = lower_view_borrowed_parked(b.left, s);
    var sl: LowerState = lst.state;
    if (!sl.ok) { return sl; }
    // A slice operand parks instead of taking the lf path: is_fresh_str_temp
    // refuses a slice (it aliases its source), so the two are exclusive and
    // nothing is released twice.
    var lv: i32 = lst.slot;
    var lt: i32 = 0 - 1;
    if (lf) {
        var lname: string = "$cclt" + util.i32_to_string(sl.locals.len());
        sl = sl.add_local(lname);
        lt = sl.slot_of(lname);
        sl = sl.emit(ir.op_store_local(lt));
        sl = sl.emit(ir.op_load_local(lt));
    }
    var rst: ArgStash = lower_view_borrowed_parked(b.right, sl);
    var sr: LowerState = rst.state;
    if (!sr.ok) { return sr; }
    var rv: i32 = rst.slot;
    var rt: i32 = 0 - 1;
    if (rf) {
        var rname: string = "$ccrt" + util.i32_to_string(sr.locals.len());
        sr = sr.add_local(rname);
        rt = sr.slot_of(rname);
        sr = sr.emit(ir.op_store_local(rt));
        sr = sr.emit(ir.op_load_local(rt));
    }
    sr = sr.emit(ir.op_str_concat());
    if (!lf && !rf && lv < 0 && rv < 0) { return sr; }
    var resname: string = "$ccres" + util.i32_to_string(sr.locals.len());
    sr = sr.add_local(resname);
    var res: i32 = sr.slot_of(resname);
    sr = sr.emit(ir.op_store_local(res));
    if (lf) {
        sr = sr.release(lt, "__fern_str_free", "concat-operand");
    }
    if (rf) {
        sr = sr.release(rt, "__fern_str_free", "concat-operand");
    }
    var ccv: i32[] = [];
    if (lv >= 0) { ccv = ccv.append(lv); }
    if (rv >= 0) { ccv = ccv.append(rv); }
    sr = free_parked_views(sr, ccv);
    return sr.emit(ir.op_load_local(res));
}

// to_unsigned_kind maps a signed IR op kind to its unsigned variant, for u64
// operands (#2904): comparisons, shift-right, and div/rem. Sign-agnostic kinds
// (add/sub/mul/and/or/xor/shl/eq/ne) pass through unchanged.
pub function to_unsigned_kind(kind: string): string {
    if (kind == "lt_s") { return "lt_u"; }
    if (kind == "gt_s") { return "gt_u"; }
    if (kind == "le_s") { return "le_u"; }
    if (kind == "ge_s") { return "ge_u"; }
    if (kind == "shr_s") { return "shr_u"; }
    if (kind == "div_s") { return "div_u"; }
    if (kind == "rem_s") { return "rem_u"; }
    return kind;
}

// map_binop maps a source binary operator to its IR opcode kind (the i32 /
// signed subset). Unknown ops return "" -> caller bails.
pub function map_binop(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div_s"; }
    if (op == "%") { return "rem_s"; }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    if (op == "<<") { return "shl"; }
    if (op == ">>") { return "shr_s"; }
    if (op == "==") { return "eq"; }
    if (op == "!=") { return "ne"; }
    if (op == "<") { return "lt_s"; }
    if (op == "<=") { return "le_s"; }
    if (op == ">") { return "gt_s"; }
    if (op == ">=") { return "ge_s"; }
    return "";
}

// binop_overload_method maps an arithmetic operator to the conventionally-
// named method that overloads it on a composite (struct / enum) operand —
// `a + b` → `a.add(b)`, etc. (#2706, mirroring the native checker desugar at
// checker.go:9723). Comparison / logical / bitwise ops are intentionally not
// here: arithmetic is the Num-trait surface this covers, and `==`/`<` composite
// overloads ride their own eq/cmp path. Returns "" for a non-arithmetic op.
pub function binop_overload_method(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div"; }
    if (op == "%") { return "rem"; }
    return "";
}

// binop_cmp_method maps a comparison operator to the method that gives it
// STRUCTURAL meaning on a composite operand: `==` / `!=` go through `Eq`'s
// `eq`, the four ordering ops through `Ord`'s `cmp` (which returns -1/0/1).
// Returns "" for any other operator.
pub function binop_cmp_method(op: string): string {
    if (op == "==" || op == "!=") { return "eq"; }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") { return "cmp"; }
    return "";
}

// composite_cmp_type returns the type name a structural `==` / `<` on `e`
// dispatches its `eq` / `cmp` under — the struct's own name, or the OWNING
// enum for an enum value (methods are keyed "<Enum>.<m>", never
// "<Variant>.<m>"). Returns "" for everything the numeric / string / f64
// dispatch handles itself: a typed scalar (expr_struct_type also reports a
// `u8` local's name, which is not a decl), a string, an array, a tuple.
// decl_is_enum, not the syntactic is_enum_like_name, is what keeps a sized
// scalar like `u8` out.
pub function composite_cmp_type(e: ast.Expr, s: LowerState): string {
    var t: string = expr_struct_type(e, s);
    if (t != "") {
        // A local bound from a variant construction records the ENUM name
        // (`var p = A(5)` → "E"); one bound from a unit variant records the
        // VARIANT ("Dot"), which redirects to its owner.
        var owner: string = variant_enum_owner(s.structs, t);
        if (owner != "") { return owner; }
        if (decl_is_struct(s.structs, t) || decl_is_enum(s.structs, t)) { return t; }
        return "";
    }
    // A fresh variant construction (`Line(7)`) or a bare unit variant (`Dot`)
    // is not a local, so expr_struct_type does not type it.
    return expr_enum_type(e, s);
}

// for_iter_is_range reports whether a for-loop iter is the synthetic
// `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call the parser emits
// for `for i in LOW..HIGH` / `for i in LOW..=HIGH`. Mirrors the checker's
// for_iter_is_range (which binds the loop var to i32).
pub function for_iter_is_range(iter: ast.Expr): boolean {
    match (iter) {
        ast.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                ast.ExprIdent(id) => { return id.name == "__range" || id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// for_iter_is_range_incl reports whether the for-loop iter is the
// inclusive `__range_incl(LOW, HIGH)` form (closed interval [LOW, HIGH]),
// so lower_range_for emits a `<=` rather than `<` loop condition.
pub function for_iter_is_range_incl(iter: ast.Expr): boolean {
    match (iter) {
        ast.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                ast.ExprIdent(id) => { return id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// is_numeric_cast_op reports whether an `as_<T>` unary op is a numeric
// CONVERSION (truncate / sign-extend / float-round) rather than a
// zero-cost type ascription. The conversions change the runtime value;
// everything else (`as i32[]`, `as string`, `as Option`) is an ascription.
//
// Keyed on the TARGET TYPE NAME rather than spelled as a list of `as_<T>`
// literals, because the op is built as `"as_" + tyname` (parse_unary) — so a
// list silently misclassifies whatever it omits, and omitting one is not a
// missing optimisation but a WRONG ANSWER: ascription_rebind rewrites
// `var x: T = E as T` to `var x: T = E`, discarding the conversion. `as_u8`
// was missing exactly that way, so `var w8: u8 = v8 as u8` dropped its 8-bit
// mask and 260 as u8 stayed 260 instead of wrapping to 4 (#6010 —
// audit_numeric_types' `FAIL u8-wrap`, exit 13). Expression position was
// unaffected, which is why it survived: `(v8 as u8) as i32` masks correctly.
// `usize` is deliberately NOT here: `x as usize` is an identity ascription used
// to sever escape analysis (`return __fern_rc_inc(out as usize)` in
// core/map.fern), not a width conversion. Classifying it as numeric stops
// ascription_rebind firing and the module stops lowering at all — measured:
// every std/map-importing fixture went IR-ineligible.
pub function is_numeric_cast_op(op: string): boolean {
    if (op.len() <= 3 || slice_unchecked(op, 0, 3) != "as_") { return false; }
    var t: string = slice_unchecked(op, 3, op.len()) + "";
    return t == "i32" || t == "u32" || t == "u8" || t == "i64" || t == "u64"
        || t == "f64" || t == "f32" || t == "float";
}

// ascription_target returns the target type name of an ascription cast
// `E as T` (init = the `as_<T>` unary), or "" if `init` isn't an ascription.
// A numeric conversion (`as i32`, `as f64`, …) returns "" — it is a real
// value conversion, not an identity ascription.
pub function ascription_target(init: ast.Expr): string {
    match (init) {
        ast.ExprUnary(u) => {
            if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_" && !is_numeric_cast_op(u.op)) {
                return slice_unchecked(u.op, 3, u.op.len()) + "";
            }
            return "";
        },
        _ => { return ""; }
    }
}

// ascription_rebind rewrites `var x = E as T` to the equivalent annotated
// binding `var x: T = E` (the `as` ascription is identity). Caller guards
// with `ascription_target(v.init) != ""`, so v.init is always an ascription
// unary here; the `_` arm returns v unchanged for exhaustiveness.
pub function ascription_rebind(v: ast.StmtVar): ast.Stmt {
    match (v.init) {
        ast.ExprUnary(au) => {
            return ast.StmtVar { name: v.name, type_name: ascription_target(v.init), init: au.operand, line: v.line, col: v.col, is_str: v.is_str, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
        },
        _ => { return v; }
    }
}

// lower_range_for lowers `for i in LOW..HIGH { body }` (iter = the synthetic
// `__range(LOW, HIGH)` call) to a counted loop over the half-open interval —
// or the closed interval `[LOW, HIGH]` for the inclusive `__range_incl` form
// (`for i in LOW..=HIGH`), which only changes the loop condition to `i <= hi`.
// HIGH is bound once into a hidden local (so `for i in 0..f()` calls f()
// once), i = LOW, then `while (i < hi) { body; i = i + 1 }`. The caller has
// already bailed bodies containing break/continue (a `continue` would skip
// the increment), so the counted shape is safe. LOW / HIGH are i32 exprs.
// Split out of lower_stmt's StmtFor arm so that arm stays small (oversized
// functions miscompile on the native backend — cf. #2720).
pub function lower_range_for(var_name: string, iter: ast.Expr, body: ast.Stmt[], s: LowerState): LowerState {
    var r_lo: ast.Expr = iter;
    var r_hi: ast.Expr = iter;
    match (iter) {
        ast.ExprCall(rc) => {
            r_lo = rc.args[0];
            r_hi = rc.args[1];
        },
        _ => {}
    }
    // Closed interval `[LOW, HIGH]` (`for i in LOW..=HIGH`) exits on `i <= hi`;
    // the half-open `[LOW, HIGH)` default exits on `i < hi`.
    var cond_kind: string = "lt_s";
    if (for_iter_is_range_incl(iter)) { cond_kind = "le_s"; }
    // hidden HIGH bound (evaluated once)
    var hin: string = "$forhi" + util.i32_to_string(s.locals.len());
    var rs: LowerState = s.add_local(hin);
    var hislot: i32 = rs.slot_of(hin);
    rs = lower_expr(r_hi, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_store_local(hislot));
    // loop var i = LOW - 1 (user-visible i32 binding). The increment runs at
    // the TOP of the loop (after the header, before the condition) rather than
    // the bottom, so a `continue` — which branches to the loop header — re-runs
    // the increment instead of skipping it (#2788). Starting at LOW-1 means the
    // first top-advance lands i on LOW, so the body still observes LOW, LOW+1, …
    rs = rs.add_local(var_name);
    var islot: i32 = rs.slot_of(var_name);
    rs = lower_expr(r_lo, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_const_i32(1));
    rs = rs.emit(ir.op_bin("sub", 0, false));   // i = LOW - 1
    rs = rs.emit(ir.op_store_local(islot));
    rs = rs.emit(ir.op_block(0)).enter_loop();  // depth 1 = break/exit target
    rs = rs.emit(ir.op_loop(0));                // depth 0 = continue/header
    // advance: i = i + 1 (runs on every header entry, incl. after `continue`).
    rs = rs.emit(ir.op_load_local(islot));
    rs = rs.emit(ir.op_const_i32(1));
    rs = rs.emit(ir.op_bin("add", 0, false));
    rs = rs.emit(ir.op_store_local(islot));
    // cond: i < hi (or i <= hi for the inclusive form) ; exit when NOT.
    rs = rs.emit(ir.op_load_local(islot));
    rs = rs.emit(ir.op_load_local(hislot));
    rs = rs.emit(ir.op_bin(cond_kind, 0, false));
    rs = rs.emit(ir.op_bin("not", 0, false));
    rs = rs.emit(ir.op_brif(1));
    rs = lower_block(body, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_br(0));   // back-edge to header (re-advances)
    rs = rs.emit(ir.op_end());
    return rs.emit(ir.op_end()).exit_loop();
}

// lower_foreach_snapshot lowers `for x in <EXPR>` where the iterable is not a
// bare local — an array literal (`for x in [1, 2, 3]`) or a call returning an
// array (`for x in mk()`). It binds the iterable to a hidden local through the
// normal `var` lowering (which marks the slot's array / element-type flags and
// RC-owns the value — a fresh literal or a move-on-return result is owned, so
// the exit-sweep frees it), then re-lowers the loop over that local via the
// ident-foreach path. The caller guards that fr.iter is not an ident and the
// loop var has no comma (the `for k, v in m` map form needs a map local). Kept
// in its own function so the already-large StmtFor arm doesn't grow (oversized
// functions miscompile on the native backend — cf. #2720).
pub function lower_foreach_snapshot(var_name: string, iter: ast.Expr, body: ast.Stmt[], s: LowerState): LowerState {
    var itn: string = "$forit" + util.i32_to_string(s.locals.len());
    var sv: ast.Stmt = ast.StmtVar { name: itn, type_name: "", init: iter, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    var s2: LowerState = lower_stmt(sv, s);
    if (!s2.ok) { return s2; }
    var nf: ast.Stmt = ast.StmtFor { var_name: var_name, iter: ast.ExprIdent { name: itn, line: 0, col: 0, ty: "" }, body: body, label: "", line: 0 };
    return lower_stmt(nf, s2);
}

// lower_array_to_json lowers `arr.to_json()` (the element-poly array serialiser
// `(xs: T[]) to_json[T: Json]()` from std/json) as an INLINE loop, so the
// per-element `arr[i].to_json()` is lowered where the element type is statically
// known and dispatches to the right impl. Desugars to:
//   var $tjout = "[";
//   var $tji = 0;
//   while ($tji < arr.len()) {
//       if ($tji > 0) { $tjout = $tjout + ","; }
//       $tjout = $tjout + arr[$tji].to_json();
//       $tji = $tji + 1;
//   }
//   $tjout + "]"          // result expression left on the stack
// A non-ident receiver is snapshotted into a hidden local first (evaluated
// once; ident receivers are loaded per use, which is free). The generic body
// `__fn_T__to_json` is still emitted but dead — call sites all route here. #2766.
// `$out = $out.append(BYTE as u8)` as a synthetic assign — the u8[]-buffer
// append driving the O(n) array serialiser (#4379). `byte` is any Expr; it is
// cast with the `as_u8` unary (how the parser desugars `x as u8`).
function to_json_append_stmt(on: string, byte: ast.Expr): ast.Stmt {
    var oref: ast.Expr = ast.ExprIdent { name: on, line: 0, col: 0, ty: "" };
    var casted: ast.Expr = ast.ExprUnary { op: "as_u8", operand: byte, line: 0, col: 0, ty: "" };
    var app: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: oref, field: "append", line: 0, col: 0, ty: "" }, args: [casted], line: 0, col: 0, type_argc: 0, ty: "" };
    return ast.StmtAssign { target: on, value: app, line: 0, col: 0, target_line: 0, target_col: 0 };
}

// The inner byte-copy loop `while ($k < $s.len()) { $out = $out.append($s[$k] as
// u8); $k = $k+1 }` — appends every byte of a per-element to_json() result to the
// output buffer. Split out to keep the loop builders small (large functions
// miscompile on the native backend, #2720).
function to_json_bytecopy_stmt(on: string, sn: string, kn: string): ast.Stmt {
    var sref: ast.Expr = ast.ExprIdent { name: sn, line: 0, col: 0, ty: "" };
    var kref: ast.Expr = ast.ExprIdent { name: kn, line: 0, col: 0, ty: "" };
    var one: ast.Expr = ast.ExprNumber { text: "1", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
    var lenc: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: sref, field: "len", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var cond: ast.Expr = ast.ExprBinary { op: "<", left: kref, right: lenc, line: 0, col: 0, ty: "" };
    var elem: ast.Expr = ast.ExprIndex { array: sref, index: kref, unchecked: false, ty: "" };
    var app: ast.Stmt = to_json_append_stmt(on, elem);
    var inc: ast.Stmt = ast.StmtAssign { target: kn, value: ast.ExprBinary { op: "+", left: kref, right: one, line: 0, col: 0, ty: "" }, line: 0, col: 0, target_line: 0, target_col: 0 };
    return ast.StmtWhile { cond: cond, body: [app, inc], label: "", line: 0, is_loop: false };
}

// to_json_loop_stmt builds the synthetic outer loop driving the array serialiser
// (#4379 — the u8[]-buffer form, so appends grow in place instead of the old
// O(n²) `out = out + …` concat):
//   while ($i < aref.len()) {
//       if ($i > 0) { $out = $out.append(44 as u8); }   // ','
//       var $s = aref[$i].to_json();
//       var $k = 0;
//       while ($k < $s.len()) { $out = $out.append($s[$k] as u8); $k = $k+1; }
//       $i = $i + 1;
//   }
// Split out of lower_array_to_json so neither function is oversized (#2720).
function to_json_loop_stmt(on: string, inm: string, sn: string, kn: string, aref: ast.Expr): ast.Stmt {
    var iref: ast.Expr = ast.ExprIdent { name: inm, line: 0, col: 0, ty: "" };
    var zero: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
    var one: ast.Expr = ast.ExprNumber { text: "1", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
    var comma: ast.Expr = ast.ExprNumber { text: "44", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
    var lenc: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: aref, field: "len", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var cond: ast.Expr = ast.ExprBinary { op: "<", left: iref, right: lenc, line: 0, col: 0, ty: "" };
    var igt: ast.Expr = ast.ExprBinary { op: ">", left: iref, right: zero, line: 0, col: 0, ty: "" };
    var noelse: ast.Stmt[] = [];
    var ifc: ast.Stmt = ast.StmtIf { cond: igt, then_body: [to_json_append_stmt(on, comma)], else_body: noelse, line: 0, else_chained: false, sugar: parser.no_match_sugar(), origin: "" };
    // var $s = aref[$i].to_json();
    var elem: ast.Expr = ast.ExprIndex { array: aref, index: iref, unchecked: false, ty: "" };
    var elemj: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: elem, field: "to_json", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var dvs: ast.Stmt = ast.StmtVar { name: sn, type_name: "", init: elemj, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    // var $k = 0;
    var dk: ast.Stmt = ast.StmtVar { name: kn, type_name: "", init: zero, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    var copyl: ast.Stmt = to_json_bytecopy_stmt(on, sn, kn);
    var inc: ast.Stmt = ast.StmtAssign { target: inm, value: ast.ExprBinary { op: "+", left: iref, right: one, line: 0, col: 0, ty: "" }, line: 0, col: 0, target_line: 0, target_col: 0 };
    var body: ast.Stmt[] = [ifc, dvs, dk, copyl, inc];
    return ast.StmtWhile { cond: cond, body: body, label: "", line: 0, is_loop: false };
}

pub function lower_array_to_json(arr: ast.Expr, s: LowerState): LowerState {
    var n: i32 = s.locals.len();
    var on: string = "$tjout" + util.i32_to_string(n);
    var inm: string = "$tji" + util.i32_to_string(n);
    var sn: string = "$tjs" + util.i32_to_string(n);
    var kn: string = "$tjk" + util.i32_to_string(n);
    var s2: LowerState = s;
    var aref: ast.Expr = arr;
    // Snapshot a non-ident receiver so `.len()` and each `arr[i]` reference the
    // same once-evaluated value (an ident is just a local load, so reuse it).
    var is_ident: boolean = false;
    match (arr) {
        ast.ExprIdent(_) => { is_ident = true; },
        _ => {}
    }
    if (!is_ident) {
        var an: string = "$tjarr" + util.i32_to_string(n);
        var snap: ast.Stmt = ast.StmtVar { name: an, type_name: "", init: arr, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
        s2 = lower_stmt(snap, s);
        if (!s2.ok) { return s2; }
        aref = ast.ExprIdent { name: an, line: 0, col: 0, ty: "" };
    }
    // var $tjout: u8[] = [];  — the growable output buffer (#4379)
    var dout: ast.Stmt = ast.StmtVar { name: on, type_name: "u8[]", init: ast.ExprArray { elements: [], elem_ty: "u8", line: 0, col: 0 }, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    s2 = lower_stmt(dout, s2);
    if (!s2.ok) { return s2; }
    // $tjout = $tjout.append(91 as u8);  — '['
    s2 = lower_stmt(to_json_append_stmt(on, ast.ExprNumber { text: "91", suffix: "", raw: "", is_float: false, line: 0, col: 0 }), s2);
    if (!s2.ok) { return s2; }
    // var $tji = 0;
    var di: ast.Stmt = ast.StmtVar { name: inm, type_name: "", init: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 }, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    s2 = lower_stmt(di, s2);
    if (!s2.ok) { return s2; }
    // the serialising loop (built in helpers to keep this function small)
    s2 = lower_stmt(to_json_loop_stmt(on, inm, sn, kn, aref), s2);
    if (!s2.ok) { return s2; }
    // $tjout = $tjout.append(93 as u8);  — ']'
    s2 = lower_stmt(to_json_append_stmt(on, ast.ExprNumber { text: "93", suffix: "", raw: "", is_float: false, line: 0, col: 0 }), s2);
    if (!s2.ok) { return s2; }
    // result expression: string_from_bytes_unchecked($tjout)
    var result: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "string_from_bytes_unchecked", line: 0, col: 0, ty: "" }, args: [ast.ExprIdent { name: on, line: 0, col: 0, ty: "" }], line: 0, col: 0, type_argc: 0, ty: "" };
    return lower_expr(result, s2);
}

// lower_string_foreach lowers `for b in STR` (iterate a string's bytes). The
// array foreach assumes an array layout — length @0, elements @ base+idx*8+8 —
// but a string is { data_ptr @0, len @8 } with byte elements, so the array
// path reads the data pointer as the length and 8-byte-indexes the header
// (#2822). Desugar to a counted loop over STR.len() with a byte-index bind,
// reusing the range-for (`__range`) and string-index (byte load) paths, both
// of which are already correct in isolation. The string is snapshotted into a
// hidden local so it is evaluated once.
function lower_string_foreach(var_name: string, iter: ast.Expr, body: ast.Stmt[], s: LowerState): LowerState {
    var n: i32 = s.locals.len();
    var sn: string = "$fostr" + util.i32_to_string(n);
    var idx: string = "$fosi" + util.i32_to_string(n);
    var snv: ast.Stmt = ast.StmtVar { name: sn, type_name: "", init: iter, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    var s2: LowerState = lower_stmt(snv, s);
    if (!s2.ok) { return s2; }
    var sref: ast.Expr = ast.ExprIdent { name: sn, line: 0, col: 0, ty: "" };
    var iref: ast.Expr = ast.ExprIdent { name: idx, line: 0, col: 0, ty: "" };
    var zero: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
    var lenc: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: sref, field: "len", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var rargs: ast.Expr[] = [zero, lenc];
    var range_iter: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__range", line: 0, col: 0, ty: "" }, args: rargs, line: 0, col: 0, type_argc: 0, ty: "" };
    var bind: ast.Stmt = ast.StmtVar { name: var_name, type_name: "", init: ast.ExprIndex { array: sref, index: iref, unchecked: false, ty: "" }, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
    var nbody: ast.Stmt[] = [bind];
    var bi: i32 = 0;
    while (bi < body.len()) { nbody = nbody.append(body[bi]); bi = bi + 1; }
    var forc: ast.Stmt = ast.StmtFor { var_name: idx, iter: range_iter, body: nbody, label: "", line: 0 };
    return lower_stmt(forc, s2);
}

// is_cmp_kind reports whether an IR bin-op kind produces an i32 boolean (a
// comparison / equality) rather than a value of the operand width.
pub function is_cmp_kind(kind: string): boolean {
    return kind == "eq" || kind == "ne" || kind == "lt_s" || kind == "le_s" || kind == "gt_s" || kind == "ge_s";
}

// map_fbinop maps a source operator to its f64 IR opcode (arithmetic yields an
// f64; a compare yields an i32 0/1). "" for operators with no float form (`%`,
// bitwise, shifts — those bail on float operands).
pub function map_fbinop(op: string): string {
    if (op == "+") { return "fadd"; }
    if (op == "-") { return "fsub"; }
    if (op == "*") { return "fmul"; }
    if (op == "/") { return "fdiv"; }
    if (op == "==") { return "feq"; }
    if (op == "!=") { return "fne"; }
    if (op == "<") { return "flt"; }
    if (op == "<=") { return "fle"; }
    if (op == ">") { return "fgt"; }
    if (op == ">=") { return "fge"; }
    return "";
}
pub function is_fcmp_kind(kind: string): boolean {
    return kind == "feq" || kind == "fne" || kind == "flt" || kind == "fle" || kind == "fgt" || kind == "fge";
}

// f64_math_builtin_kind maps a std/float math builtin name to its op_funary
// opcode, or "" if `name` is not one. Most are a single hardware instruction:
// __sqrt_f64 (sqrtsd / fsqrt / f64.sqrt), __floor_f64 / __ceil_f64 / __trunc_f64
// (roundsd $1/$2/$3 / frintm/p/z / f64.floor/ceil/trunc), and __abs_f64 (sign-bit
// mask / fabs / f64.abs). __round_f64 (round-half-away, Go's math.Round) is one
// instruction on arm64 (frinta) but on x86 (roundsd has no ties-away mode) and
// wasm (f64.nearest is ties-to-even, not -away) it is emulated as trunc plus an
// exact fractional-part test — see ir_fround / emit_wasm_fround.
// The libm transcendentals log/exp/sin/cos lower here too; `pow`, the only
// two-argument one, lowers as an `fpow` fbin instead (the __pow_f64 call case).
pub function f64_math_builtin_kind(name: string): string {
    if (name == "__sqrt_f64") { return "fsqrt"; }
    if (name == "__floor_f64") { return "ffloor"; }
    if (name == "__ceil_f64") { return "fceil"; }
    if (name == "__trunc_f64") { return "ftrunc"; }
    if (name == "__abs_f64") { return "fabs"; }
    if (name == "__round_f64") { return "fround"; }
    // The libm transcendentals. No target has an instruction for these, so every
    // backend calls the same-named runtime helper its emitter emits —
    // `__fern_<op>_f64` on the two register backends, `$__fern_<op>_f64` on wasm.
    if (name == "__sin_f64") { return "fsin"; }
    if (name == "__cos_f64") { return "fcos"; }
    if (name == "__exp_f64") { return "fexp"; }
    if (name == "__log_f64") { return "flog"; }
    return "";
}

// arr_index_is_f64 reports whether indexing `arr` (the array operand of `a[i]`)
// yields an f64 — i.e. `arr` names an f64[] slot. Only a tracked ident source
// qualifies (literals / function-return arrays aren't f64-element-tracked);
// anything else is the i32 default.
pub function arr_index_is_f64(arr: ast.Expr, s: LowerState): boolean {
    match (arr) {
        ast.ExprIdent(id) => { return s.is_f64arr_slot(s.slot_of(id.name)); },
        // Nested read `m[i][j]` over an f64[][] slot or field — 8-byte (f64)
        // element. #2691.
        ast.ExprIndex(_) => { return arrarr_index_elem_kind(arr, s) == "f64"; },
        ast.ExprCall(c) => {
            // Direct index of an f64[]-returning call: `f()[i]` or `obj.m()[i]`.
            match (c.callee) {
                ast.ExprIdent(cid) => { return s.is_f64arr_ret_fn(s.mod_fn_name(cid.name)); },
                ast.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_f64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        // `t.N[i]` where `t.N` is an f64[] TUPLE element (`([1.5], x)`): the
        // element's recorded tuple tag is `f64[]`, so the read uses 8-byte
        // (f64) width — the tuple-element sibling of the struct-field case. #3353.
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return is_float_array_type_name(tuple_elem_arr_tag(fa.obj, util.digits_to_i32(fa.field), s));
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return is_float_array_type_name(field_arr_decl_type(s.structs, oty, fa.field));
        },
        // Direct index of a slice expression `a[lo:hi][i]`: an f64[] slice is
        // itself an f64[], so recurse into the sliced array — mirroring
        // expr_is_f64arr's ExprSlice case. Without this the index defaulted to
        // the 4-byte i32 path, so on wasm `a[lo:hi][i]` loaded at a 4-byte
        // stride instead of f64's 8-byte stride (#2908).
        ast.ExprSlice(sl) => { return expr_is_f64arr(sl.array, s); },
        // Direct index of an f64 array LITERAL `[1.0, 2.0][i]`: the ExprArray
        // construction builds it at an 8-byte f64 stride, so the read must ask
        // the same question. Without this the read defaulted to the 4-byte i32
        // path and mis-strode the f64 literal on wasm (the ExprArray sibling of
        // the #2908 ExprSlice gap; register backends use 8-byte slots so only
        // wasm was affected).
        ast.ExprArray(al) => { return arr_lit_is_f64(al, s); },
        _ => { return false; }
    }
    return false;
}

// arr_index_is_i64 reports whether indexing `arr` yields an i64 — `arr` names an
// i64[] slot. Drives a[i] -> arr_get_i64 (i64.load). (i64[] returns / slices are
// a later slice; only a tracked ident source qualifies here.)
//
// u64[] qualifies too: u64 lives in the i64 64-bit domain (#2904), so a u64[]
// element is read 8-byte with the SAME arr_get_i64 (identical bytes). This
// function answers "is this an 8-byte-element array index" (width only); the
// element's UNSIGNED-ness is tracked separately by expr_is_u64, which drives the
// signed-vs-unsigned op selection at the use site — so reading a u64[] element
// here and comparing it unsigned there stays correct for values >= 2^63.
pub function arr_index_is_i64(arr: ast.Expr, s: LowerState): boolean {
    match (arr) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            // i64[] (is_i64arr) or u64[] (an array slot also marked u64) — both
            // 8-byte elements. is_u64_slot is set for scalar u64 too, so the
            // is_arr_slot guard keeps this to u64[] arrays.
            return s.is_i64arr_slot(sl) || (s.is_arr_slot(sl) && s.is_u64_slot(sl));
        },
        // Nested read `m[i][j]`: the outer array here is `m[i]` (an ExprIndex over
        // a T[][] slot or field). Its element width is the recorded inner kind —
        // "i64" or "u64" both select the 8-byte arr_get_i64 (the unsigned-ness is
        // recovered separately by expr_is_u64). #2691 / #5206.
        ast.ExprIndex(_) => {
            var ae: string = arrarr_index_elem_kind(arr, s);
            return ae == "i64" || ae == "u64";
        },
        ast.ExprCall(c) => {
            // Direct index of an i64[]-returning call: `f()[i]` or `obj.m()[i]`.
            match (c.callee) {
                ast.ExprIdent(cid) => { return s.is_i64arr_ret_fn(s.mod_fn_name(cid.name)); },
                ast.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_i64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        // `t.N[i]` where `t.N` is an i64[] TUPLE element (`([x as i64], y)`): the
        // element's recorded tuple tag is `i64[]`, so the read uses 8-byte (i64)
        // width — the tuple sibling of the struct-field case below, mirroring
        // arr_index_is_f64's tuple-element branch. #3353.
        // `p.vals[i]` where p's field `vals` is an i64[] struct field.
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return tuple_elem_arr_tag(fa.obj, util.digits_to_i32(fa.field), s) == "i64[]";
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            var fdt: string = field_arr_decl_type(s.structs, oty, fa.field);
            // u64[] as well as i64[]: both are 8-byte elements, and the
            // ExprIdent arm above has always accepted both (is_u64_slot). This
            // one is belt-and-braces rather than a fix — a `u64[]` field index
            // already reads correctly, because ix_type_tag falls back to the
            // typed-IR `ix.ty` when this walk declines. Stating it here means
            // the answer no longer DEPENDS on that fallback holding.
            //
            // And `Cell[i64]` / `Cell[u64]`, because a Cell IS a 1-element array
            // of its element type — `c.get()` desugars to `c[0]`, so a wide Cell
            // field reaches this classifier as an index over a field whose
            // declared type is `Cell[…]`. Without it `h.r.get()` bailed the whole
            // module off the IR path, which is what made std/sim uncompilable by
            // the self-host compiler (#6190). `.set` was unaffected at any width
            // — it reads the element type from cell_elem_type directly — and so
            // was `Cell[i32]`, whose 4-byte stride is the default this returns
            // false for. Only the wide READ needed the stride named here.
            return fdt == "i64[]" || fdt == "u64[]" || fdt == "Cell[i64]" || fdt == "Cell[u64]";
        },
        // Direct index of a slice expression `a[lo:hi][i]`: an i64[] slice is
        // itself an i64[], so recurse into the sliced array — mirroring
        // expr_is_i64arr's ExprSlice case (the same latent stride gap #2908
        // fixed for f64[]).
        ast.ExprSlice(sl) => { return expr_is_i64arr(sl.array, s); },
        // Direct index of an i64/u64 array LITERAL `[x as i64, …][i]`: the
        // ExprArray construction emits arr_make_i64 (8-byte stride) for the same
        // literals, so the read must ask the same question (the i64 sibling of
        // the f64 ExprArray arm above; wasm-only, register backends unaffected).
        ast.ExprArray(al) => { return arr_lit_is_i64(al, s); },
        _ => { return false; }
    }
    return false;
}

// arr_index_is_i32_scalar reports whether `arr` is a plain 32-bit-element array
// IDENT slot — an i32[] (or u32[]) — so `arr[i]` reads a 32-bit integer element.
// It deliberately EXCLUDES every wider/typed array overlay (i64[]/u64[], f64[],
// string[], T[][], closure[]/fn[]); arr_index_is_i64 covers the 8-byte case in
// lower_i64 directly. Drives the i32-element widening of `s64 + a[i]` in
// lower_i64's ExprIndex arm (the checker forbids i64 + u32, so such an element
// reaching an i64 context is a signed i32). #2691.
pub function arr_index_is_i32_scalar(arr: ast.Expr, s: LowerState): boolean {
    match (arr) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (!s.is_arr_slot(sl)) { return false; }
            if (s.is_i64arr_slot(sl)) { return false; }
            if (s.is_f64arr_slot(sl)) { return false; }
            if (s.is_strarr_slot(sl)) { return false; }
            if (s.is_arrarr_slot(sl)) { return false; }
            if (s.is_closurearr_slot(sl)) { return false; }
            if (s.is_fnarr_slot(sl)) { return false; }
            if (s.is_u64_slot(sl)) { return false; }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_i64arr reports whether `e` is an i64[] — an i64-array-tracked
// local/param (aliasing), an i64[]-returning call, an i64[] slice, OR a literal
// arr_lit_is_i64 sizes 8-byte. An UNSTAMPED literal of bare integer literals
// (`[10, 20]`) stays i32: without a destination only an explicitly-64-bit first
// element (an `as i64`/`as u64` cast or an i64-typed operand) marks it i64[],
// mirroring the StmtVar i64[]-literal binding detection (#3353). This lets an
// i64[] tuple element / array literal in a non-binding position carry its
// 8-byte element width through elem_type_tag.
pub function expr_is_i64arr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(lit) => { return arr_lit_is_i64(lit, s); },
        ast.ExprIdent(id) => { return s.is_i64arr_slot(s.slot_of(id.name)); },
        // `m[i]` over an i64[][] or u64[][] slot is itself an 8-byte-element
        // array (so `var r = m[i]` tracks r for 8-byte `r[j]` reads). #2691 /
        // #5206 — the width is shared; expr_is_u64 recovers the u64 sign.
        ast.ExprIndex(_) => {
            var ae: string = arrarr_index_elem_kind(e, s);
            return ae == "i64" || ae == "u64";
        },
        ast.ExprSlice(sl) => { return expr_is_i64arr(sl.array, s); },
        // An `i64[]` TUPLE element `t.N` (`([x as i64], y)`): its recorded tuple
        // tag is `i64[]`, so `t.N` is an i64[] (drives a `var xs = t.N` rebind so
        // the new slot reads 8-byte elements — the i64 sibling of the f64[] case
        // above). #3353.
        ast.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return tuple_elem_arr_tag(fa.obj, util.digits_to_i32(fa.field), s) == "i64[]";
            }
            // A NAMED struct field declared i64[] / u64[]. Only the tuple case
            // above was handled, so `p.vals.append(v)` on an `i64[]` field
            // picked the 4-byte arr_push while lowering an i64 value — invalid
            // wasm ("expected i32, found i64"), and a silent width error
            // elsewhere. #6093.
            var foty: string = expr_struct_type(fa.obj, s);
            if (foty == "") { return false; }
            var fft: string = field_arr_decl_type(s.structs, foty, fa.field);
            return fft == "i64[]" || fft == "u64[]";
        },
        ast.ExprCall(c) => {
            // A call to an i64[]-returning free function OR method (i64arr_ret_fns,
            // methods keyed "<Type>.<method>").
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // Erased-generic `T[]` return mirroring argument i: an i64[]
                    // exactly when THAT argument is a (non-f64) 64-bit value.
                    var gi: i32 = strarr_ret_argref(s, cid.name);
                    if (gi >= 0 && gi < c.args.len()) { return !expr_is_f64(c.args[gi], s) && infer_expr_width(c.args[gi], s) == 64; }
                    return s.is_i64arr_ret_fn(s.mod_fn_name(cid.name));
                },
                ast.ExprFieldAccess(cfa) => {
                    // `xss.first()` / `.last()` on an i64[][] / u64[][] yields an
                    // 8-byte-element array, so the following `[j]` reads 8-byte.
                    if (arr_firstlast_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_i64arr(arr_elem_index_expr(cfa.obj), s);
                    }
                    if (arr_samekind_call(cfa.field, cfa.obj, c.args.len(), s)) {
                        return expr_is_i64arr(cfa.obj, s);
                    }
                    // `a.with(...)` / `a.append(...)` preserve the receiver's element
                    // kind: an i64[] receiver yields a fresh i64[].
                    if (((cfa.field == "with" && c.args.len() == 2) || (cfa.field == "append" && c.args.len() == 1))
                        && expr_is_i64arr(cfa.obj, s)) { return true; }
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_i64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// slice_elem_is_wide reports whether `a[i:j]` copies 8-byte elements — an f64[]
// or i64[]/u64[] source, which arr_slice lowers at width 64 (the wasm
// $__fern_arr_slice8 raw 8-byte move). Structural walk FIRST, for the same
// reason as ix_type_tag / fa_type_tag: it reads the slot's recorded element
// kind, which the checker's Type erases. The annotate-stamped `slc.ty` fills
// its HOLES — a slice of a call result or of an if-expression, where the source
// array is not structurally recoverable and both `expr_is_*arr` walks silently
// answer false, so the slice copied 4-byte elements out of an 8-byte array.
function slice_elem_is_wide(slc: ast.ExprSlice, s: LowerState): boolean {
    if (expr_is_f64arr(slc.array, s) || expr_is_i64arr(slc.array, s)) { return true; }
    return slc.ty == "f64[]" || slc.ty == "i64[]" || slc.ty == "u64[]";
}

// ix_type_tag returns the canonical scalar type string of an index read `a[i]`
// — the ELEMENT type the read yields — or "" when neither the structural walk
// nor the checker can name it. It is the shared leaf the ExprIndex arms of
// expr_is_f64 and infer_expr_width test, so an element's width is resolved ONE
// way across them (the index sibling of fa_type_tag, #5986).
//
// Same ordering rule as fa_type_tag, for the same reason: the structural walk
// runs first and wins where it resolves, because it reads the slot's recorded
// element KIND (`is_f64arr_slot` and friends), which distinguishes widths the
// checker's Type erases. The annotate-stamped `ix.ty` (#5531's third carrier)
// fills the walk's HOLES — an index of a call result, a map read, or a generic
// chain, where the array expression is not structurally recoverable and the
// walk silently returns false for an element the checker typed all along.
// id_type_tag returns the canonical scalar type of a bare name that reads a
// value NO local slot carries — today exactly a module `const`, whose read is
// really a call to its zero-argument accessor (#2954). "" for a tracked
// local/param, and for a name that resolves to no value type at all (a function
// used as a value, a unit enum variant).
//
// It answers only the NON-slot half deliberately: where a slot exists, the
// slot's recorded kind is the declaration walk and wins for the same reason it
// does in fa_type_tag — it distinguishes widths the checker's Type erases (f32
// from f64) and it is what every slot-marking rule maintains. So each of the
// six callers (expr_is_str / _bool / _f64 / _u32 / _u64 and infer_expr_width)
// keeps its own slot query and reaches here for the hole beside it. That hole is the
// missing-arm class this issue is about: expr_is_str, expr_is_f64 and
// infer_expr_width each grew a const case of their own (#2954, #4801) and
// expr_is_u32 / expr_is_u64 never did, so `const M: u32` read bare selected the
// SIGNED `>>` on wasm and dispatched "i32.<method>" for its methods (#5986).
//
// The annotate-stamped `id.ty` (#5531's carrier family) leads here rather than
// trailing, because for a const it names the DECLARED return type, while the
// ret-flag registries below re-derive it and are keyed by bare name. They stay
// as the unannotated build's answer (asm_ir_run, the native compiler), which is
// what keeps the field byte-identity-safe.
function id_type_tag(id: ast.ExprIdent, s: LowerState): string {
    if (s.slot_of(id.name) >= 0) { return ""; }
    if (id.ty != "") { return id.ty; }
    if (!s.is_const_fn(id.name)) { return ""; }
    if (s.is_str_ret_fn(id.name)) { return "string"; }
    if (sig_reg_has_exact(s.sigs.bool_ret_fns, id.name)) { return "boolean"; }
    if (s.is_f64_ret_fn(id.name)) { return "f64"; }
    // u64 before i64: is_i64_ret_fn accepts the u64 flag too (both are 64-wide).
    if (s.is_u64_ret_fn(id.name)) { return "u64"; }
    if (s.is_u32_ret_fn(id.name)) { return "u32"; }
    if (s.is_i64_ret_fn(id.name)) { return "i64"; }
    return "";
}

function ix_type_tag(ix: ast.ExprIndex, s: LowerState): string {
    if (arr_index_is_f64(ix.array, s)) { return "f64"; }
    if (arr_index_is_i64(ix.array, s)) { return "i64"; }
    return ix.ty;
}

// fa_type_tag returns the canonical scalar type string of a struct-field or
// tuple-element access `obj.field` — the tuple element's annotated tag (`t.N`,
// N all-digits) or the struct field's declared type (`p.x`) — or "" when neither
// the declaration walk nor the checker can name it. It is the shared leaf the
// four numeric-kind predicates (expr_is_f64/f32/u32/u64) and infer_expr_width
// test for membership, so their field arms resolve the type ONE way and can't
// drift apart (#5520).
//
// The DECLARATION walk runs first and wins when it resolves, because it returns
// the field's declared SPELLING: it distinguishes `f32` from `f64`, a
// distinction the checker's Type erases (TypeFloat carries no width), so the
// stamped tag would report a genuine f32 field as "f64" and take expr_is_f32's
// dispatch off the f32 path. The typed-IR tag (#5986, the ExprCall.ty sibling
// from #5531) fills the walk's HOLES instead: when `obj`'s struct type is not
// structurally recoverable — a call, a map read, a generic chain — the walk
// returns "" for a field the checker typed all along. That silent "" is the
// missing-arm class behind #5982 / #5983 / #5985.
function fa_type_tag(fa: ast.ExprFieldAccess, s: LowerState): string {
    if (util.is_all_digits(fa.field)) {
        var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
        if (tt != "") { return tt; }
        return fa.ty;
    }
    var oty: string = expr_struct_type(fa.obj, s);
    if (oty == "") { return fa.ty; }
    var ft: string = decl_field_type(s.structs, oty, fa.field);
    if (ft == "") { return fa.ty; }
    return ft;
}

// method_recv_prim_key builds the "<RecvType>.<method>" registry key for a
// method-call receiver `obj.field`, resolving the receiver's type from
// expr_struct_type and falling back to the primitive receiver type
// (expr_recv_prim_type) for a scalar VALUE receiver like `(3.5).m()`. Returns ""
// when neither resolves. Shared by the f64/u32/u64 method-return-kind arms so the
// receiver resolution can't drift across them (#5520). expr_is_str's method arm
// keeps its own copy — it has a `dyn Trait` fallthrough after this resolution.
function method_recv_prim_key(obj: ast.Expr, field: string, s: LowerState): string {
    var crty: string = expr_struct_type(obj, s);
    if (crty == "") { crty = expr_recv_prim_type(obj, s); }
    if (crty == "") { return ""; }
    return crty + "." + field;
}

// expr_is_f64 reports whether `e` evaluates to an f64 value — a float literal, an
// f64-tracked local/param, an arithmetic combination of f64 operands, or an
// f64-array element read `a[i]`. (A comparison is NOT f64 — it yields an i32
// bool — so only the arithmetic ops propagate float-ness here.)
pub function expr_is_f64(e: ast.Expr, s: LowerState): boolean {
    // A Cell[f64/float] get() is f64 (#5510).
    var cf64e: string = cell_get_elem(e, s);
    if (cf64e == "f64" || cf64e == "float") { return true; }
    // f32 is f64-SHAPED (stored 8-byte), so every f32 value is also f64 — made
    // explicit here (was implicit, and independently re-derived below). This is
    // the load-bearing invariant the f32/f64 split rests on; keeping it a single
    // delegation removes the risk of the two walks drifting (typed-IR migration,
    // #5520). Byte-identity guards that it was already true.
    if (expr_is_f32(e, s)) { return true; }
    match (e) {
        ast.ExprNumber(n) => { return n.is_float; },
        ast.ExprIdent(id) => {
            if (s.is_f64_slot(s.slot_of(id.name))) { return true; }
            return id_type_tag(id, s) == "f64";
        },
        ast.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                if (expr_is_f64(b.left, s) || expr_is_f64(b.right, s)) { return true; }
            }
            // A composite operator overload returning f64 — a dot product
            // `function (a: V) mul(b: V): f64` (#5986). Both operands are
            // structs, so the walk above answers false and only the binary's
            // own tag names the result.
            return b.ty == "f64";
        },
        ast.ExprUnary(u) => {
            if (u.op == "-") { return expr_is_f64(u.operand, s) || u.ty == "f64"; }
            // `x as f64` evaluates to f64 (a float→int cast yields i32, so only
            // the to-float casts propagate float-ness).
            if (u.op == "as_f64" || u.op == "as_f32" || u.op == "as_float") { return true; }
            return false;
        },
        ast.ExprCall(c) => {
            // typed-IR (#5531): the annotate pass (checker.annotate_module) stamps
            // c.ty with the checker's inferred result type. When present it is
            // authoritative for the float question, retiring the is_f64_ret_fn /
            // f64-builtin re-derivation below for annotated calls. "" — an
            // unannotated call (the asm_ir_run harness / native cmd/fern never run
            // annotate, or the checker left this call's type unresolved) — falls
            // through to the structural walk, so behaviour is unchanged there.
            if (c.ty != "") { return c.ty == "f64"; }
            // An f64-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // — classify by its first branch's returned value, so `var f = if (…)
            // { 1.5 } else { 2.5 }` tracks f as an f64.
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_f64(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to an f64-returning free function OR method is an f64 value.
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // The std/float single-instruction math builtins return f64.
                    if (f64_math_builtin_kind(cid.name) != "") { return true; }
                    // __pow_f64 is f64-returning too — it lowers as the fpow fbin
                    // (not an op_funary), so it isn't in f64_math_builtin_kind, but
                    // its result must still cast via f64_to_i32 (not an i32 mask).
                    if (cid.name == "__pow_f64") { return true; }
                    // f64_from_bits / f32_from_bits reinterpret an integer bit
                    // pattern back into an f64 value.
                    if (cid.name == "f64_from_bits" || cid.name == "f32_from_bits") { return true; }
                    if (s.is_f64_ret_fn(s.mod_fn_name(cid.name))) { return true; }
                    // An erased-generic fn whose return mirrors argument i
                    // (`id[T](x: T): T`, the "name|$arg<i>" registry entry — kind-
                    // agnostic, recorded in str_ret_fns): the call is f64 exactly
                    // when THAT argument is. Mirrors infer_expr_width's width use of
                    // the same registry, so `id(2.5) + 0.5` lowers as float add
                    // instead of an integer op on the double's bits.
                    var gfi: i32 = str_ret_argref(s, cid.name);
                    if (gfi >= 0 && gfi < c.args.len() && expr_is_f64(c.args[gfi], s)) { return true; }
                    return false;
                },
                ast.ExprFieldAccess(cfa) => {
                    // `m.get_or(k, d)` on an f64-VALUED map (Map[K, f64]) is an
                    // f64 value — the column stores 8-byte doubles and get_or
                    // returns them bit-intact — so a chained `* 2.0` lowers as a
                    // float op instead of an integer op on the double's bits
                    // (#5253, the f64 sibling of expr_is_u64's get_or arm).
                    if (cfa.field == "get_or" && c.args.len() == 2
                        && map_value_of(get_or_recv_map_type(cfa.obj, s)) == "f64") { return true; }
                    // A scalar VALUE receiver (`(3.5).m()`) resolves via
                    // expr_recv_prim_type, so an f64-returning method `<f64>.m` is
                    // recognised — else `a.m() as i32` masked the double's low 32
                    // bits instead of truncating via f64_to_i32.
                    var fk: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    return fk != "" && s.is_f64_ret_fn(fk);
                },
                _ => { return false; }
            }
        },
        ast.ExprFieldAccess(fa) => {
            // An f64-typed struct field read `p.x`, or an f64 tuple element.
            var ft: string = fa_type_tag(fa, s);
            return ft == "f64" || ft == "f32" || ft == "float";
        },
        ast.ExprIndex(ix) => { return ix_type_tag(ix, s) == "f64"; },
        _ => { return false; }
    }
    return false;
}

// expr_is_f32 reports whether `e` evaluates to an f32 value (STRICTLY — false
// for a genuine f64). f32 is stored as an 8-byte f64, so expr_is_f64 also
// returns true for it; this strict view drives "f32.<method>" dispatch
// (expr_recv_prim_type) which must NOT collide with f64 (their to_string /
// to_json differ by precision). Sources: an f32-tracked local/param/receiver,
// an `as f32` cast, f32 arithmetic, an f32 struct field / tuple element. A bare
// float literal is f64 by default (becomes f32 only via `as f32`). A method-
// CALL result is conservatively not classified f32 here (no f32-ret registry):
// such a chained receiver falls back to the f64-twin dispatch, which is
// behavior-identical for the value ops and only the (unused-in-practice)
// chained-`to_string` would differ.
pub function expr_is_f32(e: ast.Expr, s: LowerState): boolean {
    if (cell_get_elem(e, s) == "f32") { return true; }
    match (e) {
        ast.ExprIdent(id) => { return s.is_f32_slot(s.slot_of(id.name)); },
        ast.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return expr_is_f32(b.left, s) || expr_is_f32(b.right, s);
            }
            return false;
        },
        ast.ExprUnary(u) => {
            if (u.op == "-") { return expr_is_f32(u.operand, s); }
            // Only `as f32` yields f32; `as f64` / `as float` are f64.
            if (u.op == "as_f32") { return true; }
            return false;
        },
        ast.ExprFieldAccess(fa) => {
            return fa_type_tag(fa, s) == "f32";
        },
        // An erased-generic fn whose return mirrors argument i (`id[T](x: T): T`)
        // is f32 exactly when that argument is — the f32 sibling of expr_is_f64's
        // argref arm, so `id(x as f32) + y` keeps the f32-twin dispatch.
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var gfi: i32 = str_ret_argref(s, cid.name);
                    if (gfi >= 0 && gfi < c.args.len() && expr_is_f32(c.args[gfi], s)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_u32arr reports whether `e` is a u32[] array value — a u32[] ident slot
// (is_arr + is_u32), a u32-element literal, or a slice of either. The u32 sibling
// of expr_is_u64arr; drives element-index u32 tracking in expr_is_u32's ExprIndex
// arm. (u32-ness matters on wasm, whose i32 shr/div/rem select signed vs unsigned
// — an x86 64-bit register zero-extends, hiding the divergence.)
pub function expr_is_u32arr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(lit) => { return lit.elements.len() > 0 && expr_is_u32(lit.elements[0], s); },
        ast.ExprIdent(id) => { var sl: i32 = s.slot_of(id.name); return s.is_arr_slot(sl) && s.is_u32_slot(sl); },
        ast.ExprSlice(sl) => { return expr_is_u32arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_u32 reports whether `e` evaluates to a u32 value — a u32-tracked
// local/param, a u32[] element read `a[i]`, a u32 struct field / tuple element,
// an `as u32` cast, or an arithmetic / bitwise / shift combination of u32
// operands (a comparison is a bool, not u32). It drives u32 WRAPPING (a u32
// arithmetic result is masked to 32 bits on the register backends) and unsigned
// op selection (a u32 `>>` / `/` / `%` / ordering-compare lowers to the logical
// / unsigned form). A u32-returning CALL is treated as u32 for SIGNEDNESS only
// (via the is_u32_ret_fn registry) — the callee already wraps its own u32 result
// internally so value WRAPPING stays off, but a clean u32 with bit 31 set still
// reads signed-negative in the i32 slot, so a chained `>>` / `/` / compare must
// select the unsigned form (#5245).
pub function expr_is_u32(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        // A bare literal carrying a `u32` SUFFIX is unsigned — the u32 sibling of
        // expr_is_u64's arm, and the same omission: with no ExprNumber arm at all,
        // `2147484527u32 % 861u32` selected the SIGNED remainder and answered -677
        // where the unsigned one gives 713. Silent, like its u64 twin, and hidden
        // for the same reason: the same values through locals take the ExprIdent
        // arm below, where the slot carries u32.
        ast.ExprNumber(num) => {
            if (num.is_float) { return false; }
            return num.suffix == "u32";
        },
        ast.ExprIdent(id) => { return s.is_u32_slot(s.slot_of(id.name)) || id_type_tag(id, s) == "u32"; },
        ast.ExprIndex(ix) => {
            // a[i] on a u32[] is a u32 element. The array is an ident slot
            // marked u32 (a u32-array); a u32[] literal / slice element likewise —
            // so `[big, …][0] >> 1` / `a[lo:hi][0] >> 1` selects shr_u on wasm.
            match (ix.array) {
                ast.ExprIdent(aid) => { if (s.is_u32_slot(s.slot_of(aid.name))) { return true; } },
                ast.ExprArray(al) => { if (al.elements.len() > 0 && expr_is_u32(al.elements[0], s)) { return true; } },
                ast.ExprSlice(sl2) => { if (expr_is_u32arr(sl2.array, s)) { return true; } },
                _ => {}
            }
            // A u32 element of an array the walk cannot classify (a call
            // result, an IIFE) answers from the checker's stamp (#5986).
            return ix.ty == "u32";
        },
        // A u32 TUPLE element `t.N` or u32 STRUCT field `p.n`: the value is u32, so
        // a chained `>> 1` / `/ x` selects the unsigned form. The u32 sibling of
        // expr_is_u64's ExprFieldAccess arm — on wasm a signed shr/div on a
        // bit-31-set u32 field/element diverges (x86 zero-extension hides it).
        ast.ExprFieldAccess(fa) => {
            return fa_type_tag(fa, s) == "u32";
        },
        ast.ExprUnary(u) => {
            if (u.op == "as_u32") { return true; }
            // A composite `neg` overload returning u32 — only the tag sees it (#5986).
            return u.ty == "u32";
        },
        ast.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return false; }
            // A shift's result type follows the LEFT (shifted) operand; arithmetic
            // / bitwise is u32 if either side is. A composite overload returning
            // u32 is reachable only through the binary's own tag (#5986).
            if (b.op == "<<" || b.op == ">>") { return expr_is_u32(b.left, s) || b.ty == "u32"; }
            return expr_is_u32(b.left, s) || expr_is_u32(b.right, s) || b.ty == "u32";
        },
        // A u32-returning CALL directly chained in an unsigned-sensitive op
        // (`f(a) >> 1`, `p.get() / 7`, `q.w() > x`) is a u32 value: a clean u32 in
        // [0, 2^32) with bit 31 set still reads signed-negative in the i32 slot, so
        // wasm's shr_s / div_s / gt_s diverge from the unsigned answer. The u32
        // sibling of expr_is_u64's ExprCall arm — it consults the u32-return
        // registry (ret flag '3' in i64_ret_fns, is_u32_ret_fn). This tracks only
        // SIGNEDNESS; value WRAPPING is unchanged (the callee already masked its
        // result into [0, 2^32), so calls stay non-wrapping — #5245). Free
        // functions key by bare name; methods by "<BaseType>.<method>" (a dyn
        // receiver keys "dyn <Trait>.<method>", populated by
        // append_dyn_i64_ret_fns). Beyond the concrete free-fn / method cases,
        // this arm also covers an erased-GENERIC return that mirrors a u32
        // argument (`idg[T](x: T): T`) and a u32-valued if/match IIFE (#5245).
        ast.ExprCall(c) => {
            // typed-IR (#5531): trust the checker-stamped result type when present,
            // retiring the is_u32_ret_fn re-derivation for annotated calls. ""
            // (unannotated) falls through to the structural walk.
            if (c.ty != "") { return c.ty == "u32"; }
            // A u32-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits):
            // `(if (c) { big_u32 } else { 0 }) >> 1` selects the UNSIGNED shift.
            // Classify by its first branch's returned value — the u32 sibling of
            // expr_is_u64's IIFE arm.
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_u32(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (s.is_u32_ret_fn(s.mod_fn_name(cid.name))) { return true; }
                    // An erased-generic fn whose return mirrors argument i
                    // (`id[T](x: T): T`) is u32 exactly when that argument is —
                    // the same "name|$arg<i>" argref registry the u64 arm uses.
                    var gui: i32 = str_ret_argref(s, cid.name);
                    if (gui >= 0 && gui < c.args.len() && expr_is_u32(c.args[gui], s)) { return true; }
                    return false;
                },
                ast.ExprFieldAccess(cfa) => {
                    var uk: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    return uk != "" && s.is_u32_ret_fn(uk);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_u64 mirrors expr_is_u32 for the i64 (64-bit) domain: a u64-tracked
// local/param, a u64[] element read, an `as u64` cast, or an arithmetic /
// bitwise / shift combination of u64 operands. It selects the UNSIGNED i64 ops
// (lt_u / shr_u / div_u / …) — there is no wrap step (i64 ops are full-width).
// expr_is_u64arr reports whether `e` is a u64[] ARRAY value — a u64[] ident slot
// (is_arr + is_u64), a u64-element array LITERAL, or a slice of either. Drives the
// element-index unsigned tracking in expr_is_u64's ExprIndex arm (the u64 sibling
// of expr_is_i64arr). A u64[][] inner element is tracked separately at the arrarr
// layer (arrarr_elem == "u64"), which expr_is_u64's nested-index arm checks (#5206).
pub function expr_is_u64arr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprArray(lit) => { return lit.elements.len() > 0 && expr_is_u64(lit.elements[0], s); },
        ast.ExprIdent(id) => { var sl: i32 = s.slot_of(id.name); return s.is_arr_slot(sl) && s.is_u64_slot(sl); },
        ast.ExprSlice(sl) => { return expr_is_u64arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

pub function expr_is_u64(e: ast.Expr, s: LowerState): boolean {
    if (cell_get_elem(e, s) == "u64") { return true; }
    match (e) {
        // A bare literal carrying a `u64` SUFFIX is unsigned. There was no
        // ExprNumber arm at all, so a comparison of two literals fell through to
        // the signed instruction: `191u64 < 9223372036854776520u64` read the RHS
        // as a negative i64 and answered FALSE. Silent — no trap, no diagnostic.
        //
        // Only bare literals were affected. The same values through locals are
        // fine, because the slot carries u64 (the ExprIdent arm above), which is
        // why this survived: almost everything reaches a compare through a slot.
        ast.ExprNumber(num) => {
            if (num.is_float) { return false; }
            return num.suffix == "u64";
        },
        ast.ExprIdent(id) => { return s.is_u64_slot(s.slot_of(id.name)) || id_type_tag(id, s) == "u64"; },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => { if (s.is_u64_slot(s.slot_of(aid.name))) { return true; } },
                // Nested index of a u64[][] (`m[i][j]`): the inner array `m[i]`
                // names a u64[][] slot or field whose arrarr layer records "u64",
                // so a chained `>> 1` / `> x` selects shr_u / gt_u. #5206.
                ast.ExprIndex(_) => { if (arrarr_index_elem_kind(ix.array, s) == "u64") { return true; } },
                // Direct index of a u64[] LITERAL (`[big, …][i]`) or a u64[] SLICE
                // (`a[lo:hi][i]`): the element is u64, so a chained `>> 1` / `> x`
                // selects shr_u / gt_u. Mirrors arr_index_is_i64's width arms.
                ast.ExprArray(al) => { if (al.elements.len() > 0 && expr_is_u64(al.elements[0], s)) { return true; } },
                ast.ExprSlice(sl2) => { if (expr_is_u64arr(sl2.array, s)) { return true; } },
                _ => {}
            }
            // A u64 element of an array the walk cannot classify answers from
            // the checker's stamp (#5986) — the u64 sibling of the u32 arm.
            return ix.ty == "u64";
        },
        ast.ExprFieldAccess(fa) => {
            // A u64 tuple element `t.N` (tag from the tuple's annotated `(u64, …)`
            // type) or a u64 STRUCT field read `p.n` (the field carries u64 in the
            // decl) is a u64 value, so a chained `>> 1` / `> x` selects shr_u / gt_u.
            // The 64-bit WIDTH is already tracked by infer_expr_width; this recovers
            // the unsigned-ness.
            return fa_type_tag(fa, s) == "u64";
        },
        ast.ExprUnary(u) => {
            if (u.op == "as_u64") { return true; }
            // A composite `neg` overload returning u64 — only the tag sees it (#5986).
            return u.ty == "u64";
        },
        ast.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return false; }
            if (b.op == "<<" || b.op == ">>") { return expr_is_u64(b.left, s) || b.ty == "u64"; }
            return expr_is_u64(b.left, s) || expr_is_u64(b.right, s) || b.ty == "u64";
        },
        // An erased-generic fn whose return mirrors argument i (`id[T](x: T): T`)
        // is u64 exactly when that argument is. infer_expr_width already tracks
        // its 64-bit WIDTH via the same "name|$arg<i>" registry, so the result
        // routes through lower_i64; this recovers its UNSIGNED-ness so a shift /
        // compare on it selects shr_u / lt_u — without it `id(big_u64) >> 1`
        // used a signed (arithmetic) shift and diverged once bit 63 was set.
        ast.ExprCall(c) => {
            // typed-IR (#5531): trust the checker-stamped result type when present,
            // retiring the is_u64_ret_fn re-derivation for annotated calls. ""
            // (unannotated) falls through to the structural walk.
            if (c.ty != "") { return c.ty == "u64"; }
            // A u64-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // is a u64 value, so `(if (c) { big_u64 } else { 0 }) >> 1` selects the
            // UNSIGNED shift — the u64 sibling of expr_is_f64's IIFE arm and of
            // infer_expr_width's iife_any_return_i64 width check (which already
            // routes the result through lower_i64). Classify by its first branch's
            // returned value, matching expr_is_f64.
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_u64(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // A concrete u64-returning free function (`f(a) >> 1`): its
                    // result is unsigned, so the chained op selects shr_u / lt_u.
                    if (s.is_u64_ret_fn(s.mod_fn_name(cid.name))) { return true; }
                    var gui: i32 = str_ret_argref(s, cid.name);
                    if (gui >= 0 && gui < c.args.len() && expr_is_u64(c.args[gui], s)) { return true; }
                    return false;
                },
                // A u64-returning METHOD call `recv.m()` chained in an unsigned op
                // (`p.big() >> 1`) — the u64 sibling of expr_is_f64's method arm.
                // Methods are keyed "<BaseType>.<method>" in i64_ret_fns, so
                // resolve the receiver's struct / primitive type and look up the
                // qualified key; the '2' return flag marks it u64 (is_u64_ret_fn).
                ast.ExprFieldAccess(cfa) => {
                    // `m.get_or(k, d)` on a u64-VALUED map is an unsigned 64-bit
                    // value, so a chained `m.get_or(...) >> 1` selects shr_u (#5253).
                    if (cfa.field == "get_or" && c.args.len() == 2 && map_value_of(get_or_recv_map_type(cfa.obj, s)) == "u64") { return true; }
                    // `it.value()` on a MapIter[K, u64] is likewise unsigned (#5253).
                    if (cfa.field == "value" && c.args.len() == 0) {
                        match (cfa.obj) {
                            ast.ExprIdent(uvid) => {
                                if (mapiter_value_of(s.map_type_of(s.slot_of(uvid.name))) == "u64") { return true; }
                            },
                            _ => {}
                        }
                    }
                    var u64k: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    return u64k != "" && s.is_u64_ret_fn(u64k);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_subword_kind returns the sub-32-bit integer kind ("u8")
// an expression evaluates to, or "". It mirrors expr_is_u32 for the
// sub-word domain: a sub-word-tracked local/param, a sub-word array element
// read, an `as u8` cast, or an arithmetic/bitwise/
// shift combination of sub-word operands (a shift follows the LEFT operand;
// other binaries take whichever side is sub-word). Comparisons yield a plain
// i32 bool. Drives the post-arithmetic width wrap in the binary lowering.
pub function expr_subword_kind(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => { return s.subword_kind_of_slot(s.slot_of(id.name)); },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => { return s.subword_kind_of_slot(s.slot_of(aid.name)); },
                _ => { return ""; }
            }
        },
        ast.ExprUnary(u) => {
            if (u.op == "as_u8") { return "u8"; }
            return "";
        },
        // A CALL to a u8-returning function. Keyed like every other *_ret_fn
        // registry: free functions by bare name (through mod_fn_name, so a
        // local slot shadowing the name answers ""), methods by
        // "<BaseType>.<method>".
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (s.is_u8_ret_fn(s.mod_fn_name(cid.name))) { return "u8"; }
                    return "";
                },
                ast.ExprFieldAccess(cfa) => {
                    var uk: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    if (uk != "" && s.is_u8_ret_fn(uk)) { return "u8"; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        // A u8-suffixed literal (`250u8`). Without this a bare
        // `250u8 +| 10u8` — no call, no variable — also missed the clamp.
        ast.ExprNumber(n) => {
            if (n.suffix == "u8") { return "u8"; }
            return "";
        },
        ast.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return ""; }
            if (b.op == "<<" || b.op == ">>") { return expr_subword_kind(b.left, s); }
            var lk: string = expr_subword_kind(b.left, s);
            if (lk != "") { return lk; }
            return expr_subword_kind(b.right, s);
        },
        _ => { return ""; }
    }
    return "";
}

// is_eager_safe reports whether evaluating `e` is observably free of side
// effects AND cannot trap, so eagerly evaluating it (as the RHS of a
// short-circuit && / ||) is indistinguishable from skipping it. Excludes calls
// (side effects), indexing / slicing (bounds traps), division / remainder
// (the x86/arm div traps on /0), and — conservatively — every composite form.
// Operands are checker-guaranteed boolean, so `&` / `|` of the two 0/1 values
// equals `&&` / `||` once both are evaluated.
pub function is_eager_safe(e: ast.Expr): boolean {
    match (e) {
        ast.ExprNumber(_) => { return true; },
        ast.ExprBool(_) => { return true; },
        ast.ExprString(_) => { return true; },
        ast.ExprIdent(_) => { return true; },
        ast.ExprUnary(u) => { return is_eager_safe(u.operand); },
        ast.ExprBinary(b) => {
            if (b.op == "/" || b.op == "%") { return false; }
            return is_eager_safe(b.left) && is_eager_safe(b.right);
        },
        _ => { return false; }
    }
}

// infer_expr_width returns 64 if `e` evaluates to an i64 value, else 32.
// Comparisons / equality / logical-not yield an i32 bool regardless of operand
// width; arithmetic widens to i64 if either operand is i64. Bare literals are
// i32 here — they only become i64 from an i64 context (see lower_i64), which is
// what makes `var x: i64 = 5000000000` work without value-based parsing.
pub function infer_expr_width(e: ast.Expr, s: LowerState): i32 {
    // A Cell[i64/u64] get() is width 64 (#5510).
    var cwe: string = cell_get_elem(e, s);
    if (cwe == "i64" || cwe == "u64") { return 64; }
    match (e) {
        ast.ExprNumber(num) => {
            // A bare integer literal whose value exceeds i32-max is unambiguously
            // an i64 value (the checker forbids it in any i32 context, E047), so
            // width inference must report 64. Smaller literals stay i32 and only
            // become i64 from an i64 context (see lower_i64) — but a too-big one
            // has no valid i32 reading, so classifying it by value is sound. Without
            // this an i64[] LITERAL element (`[5000000000]`, incl. the inner array of
            // an i64[][]) skipped the arr_make_i64 path and emitted `i32.const`
            // with an out-of-range constant on the wasm backend (module won't parse).
            if (num.is_float) { return 32; }
            // An explicit suffix is the literal's DECLARED width, and it outranks
            // its magnitude. `2147484197u32` is past i32-max but well inside
            // u32-max, so reading it by value alone called it 64 and the enclosing
            // function bailed off the IR path — the `return` guard below refuses a
            // width-64 value from a 32-bit return type. Only `f` suffixes are
            // absent here: the lexer sets is_float for those (#6261).
            if (num.suffix == "i64" || num.suffix == "u64") { return 64; }
            if (num.suffix.len() > 0) { return 32; }
            if (literal_is_i64(num.text)) { return 64; }
            return 32;
        },
        ast.ExprIdent(id) => {
            if (s.is_i64_slot(s.slot_of(id.name))) { return 64; }
            // A bare ident naming a `const` is a CALL to its zero-arg accessor
            // (the ExprIdent lowering rule emits op_call_direct for it), so its
            // width is the accessor's RETURN width. Without this a `const B: i64`
            // read as `B + 1` inferred 32, so the lowering emitted i32.add over
            // a value the accessor returns as i64 and wasmtime rejected the
            // module with "type mismatch: expected i32, found i64" (#4801).
            var idt: string = id_type_tag(id, s);
            if (idt == "i64" || idt == "u64") { return 64; }
            return 32;
        },
        ast.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return 32; }
            if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) { return 64; }
            // A composite overload returning i64 / u64 (#5986). Additive only:
            // the operand walk decides width wherever it resolves, so an
            // unsuffixed literal the checker types i32 cannot NARROW a binary
            // the walk already widened.
            if (b.ty == "i64" || b.ty == "u64") { return 64; }
            return 32;
        },
        ast.ExprUnary(u) => {
            // `-2147483648` is i32::MIN, not a 64-bit value: literal_is_i64
            // judges the operand's MAGNITUDE, and 2147483648 exceeds i32-max
            // only because the sign has not been applied yet. Without this the
            // negation infers 64, StmtVar i64-backs the slot despite an
            // explicit `: i32`, and the arithmetic runs unwrapped — `0 - a`
            // answered 2147483648 rather than i32::MIN (#6396). An `: i64`
            // binding is unaffected: StmtVar tests the annotation first.
            if (u.op == "-" && lit_is_i32_min_magnitude(u.operand)) { return 32; }
            if (u.op == "-") {
                if (infer_expr_width(u.operand, s) == 64) { return 64; }
                // A composite `neg` overload returning i64 / u64 (#5986) — the
                // operand is a struct, so the recursion above cannot see it.
                if (u.ty == "i64" || u.ty == "u64") { return 64; }
                return 32;
            }
            if (u.op == "as_i64" || u.op == "as_u64") { return 64; }
            // `inner?` is i64-width when the Option/Result payload is i64/u64, so an
            // unannotated `var x = inner?` width-tracks i64 (StmtVar routes width-64
            // inits through lower_i64, where try_ now lowers).
            if (u.op == "try_") {
                var ot: string = try_opt_type(u.operand, s);
                var pt: string = opt_payload_type(ot, "Ok");
                if (pt == "i64" || pt == "u64") { return 64; }
                return 32;
            }
            return 32;
        },
        ast.ExprCall(c) => {
            // typed-IR (#5531): a checker-typed i64/u64 call is a 64-bit value, so
            // it routes through lower_i64 (is_i64_ret_fn accepts both '1'/i64 and
            // '2'/u64). Positive fast-path ONLY — a non-64 or unresolved ("") tag
            // falls through to the structural walk below, which still handles the
            // i64-returning builtins (clock / __load_i64 / f64_bits), argref
            // generics and i64/u64-map get_or the checker may not model.
            if (c.ty == "i64" || c.ty == "u64") { return 64; }
            // An i64-width if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // is an i64 value, so an unannotated `var x = if (c) { 5000000000 }
            // else { 1 }` width-tracks i64. (iife_any_return_i64 inspects every
            // branch — see lower_iife.)
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1 && iife_any_return_i64(lam.body[0], s)) { return 64; }
                    },
                    _ => {}
                }
            }
            // A call through a fn-typed struct FIELD declared to return i64/u64
            // is a 64-bit value. Paired with lower_i64's arm below: split across
            // two derivations, a disagreement is a module the wasm validator
            // rejects.
            var ffw: string = call_fn_field_ret(c, s);
            if (ffw == "i64" || ffw == "u64") { return 64; }
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // An indirect call through a fn value declared to return
                    // i64/u64 is a 64-bit value — the mirror of the arm lower_i64
                    // grew for the same seed (#6282). Without it `var v = g(5)`
                    // through a `(i32) => i64` param width-tracks i32 and the
                    // binding truncates.
                    var fvrw: string = s.fn_value_ret(s.slot_of(cid.name));
                    if (fvrw == "i64" || fvrw == "u64") { return 64; }
                    // The clock builtins return an i64 timespec reading, so a
                    // binding `var a = monotonic_ns()` width-tracks i64.
                    if (cid.name == "monotonic_ns" || cid.name == "now_unix_ms" || cid.name == "now_ns") { return 64; }
                    if (cid.name == "__load_i64") { return 64; }
                    // The bump high-water mark is i64 (the arena is 16 GiB, so
                    // it passes 2^31 on a long run). Width-tracking it matters
                    // most for `__heap_bump_bytes() as i32` — the shape every
                    // rc probe uses — which routes through lower_i64 + int_wrap
                    // only when the operand reads 64 here.
                    if (cid.name == "__heap_bump_bytes") { return 64; }
                    // Same for the cliff WEIGHT: bytes copied, arena-scale, so
                    // i64 — and read through `as i32` by the same probe shape.
                    if (cid.name == "__arr_push_shared_bytes") { return 64; }
                    // f64_bits reinterprets an f64 as its i64 bit pattern.
                    if (cid.name == "f64_bits") { return 64; }
                    // Both registries below are keyed by BARE NAME, so they only
                    // answer for a callee that really is a module function. A
                    // local slot of the same name shadows it — `map(xs, f)` calls
                    // its PARAMETER `f`, not some module `f` — and without this
                    // guard a user function named `f` returning i64 made every
                    // `f(x)` inside std/array's map / flat_map read 64-bit
                    // (#6283). The sibling ExprIdent arm above already tests
                    // slot_of the same way; these two did not.
                    if (s.slot_of(cid.name) < 0) {
                        if (s.is_i64_ret_fn(cid.name)) { return 64; }
                        // An erased-generic fn whose return mirrors argument i
                        // ("name|$arg<i>" from str_ret_fns_of — kind-agnostic): the
                        // call is 64-bit exactly when THAT argument is a (non-f64)
                        // 64-bit value (`ident[i64](big)`).
                        var gwi: i32 = str_ret_argref(s, cid.name);
                        if (gwi >= 0 && gwi < c.args.len()
                            && !expr_is_f64(c.args[gwi], s) && infer_expr_width(c.args[gwi], s) == 64) { return 64; }
                    }
                },
                ast.ExprFieldAccess(cfa) => {
                    var crty: string = method_recv_tyname(cfa.obj, s);
                    if (crty != "" && s.is_i64_ret_fn(crty + "." + cfa.field)) { return 64; }
                    // `m.get_or(k, d)` on an i64/u64-valued map is a 64-bit value —
                    // the map stores its values 8-byte and the get returns full
                    // width, so an unannotated `var g = m.get_or(...)` (and any
                    // chained arithmetic) must width-track i64 (#5253).
                    if (cfa.field == "get_or" && c.args.len() == 2) {
                        var gvt: string = map_value_of(get_or_recv_map_type(cfa.obj, s));
                        if (gvt == "i64" || gvt == "u64") { return 64; }
                    }
                    // `it.value()` on a MapIter[K, i64/u64] is a 64-bit value (the
                    // iterator's value snapshot is an i64[]), so an unannotated
                    // `var v = it.value()` and any chained arithmetic width-track
                    // i64 — the mapiter sibling of the get_or rule above. #5253.
                    if (cfa.field == "value" && c.args.len() == 0) {
                        match (cfa.obj) {
                            ast.ExprIdent(wvid) => {
                                var wvt: string = mapiter_value_of(s.map_type_of(s.slot_of(wvid.name)));
                                if (wvt == "i64" || wvt == "u64") { return 64; }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            return 32;
        },
        ast.ExprIndex(ix) => {
            // a[i] on an i64[] / u64[] is an i64 value (so it routes through
            // lower_i64). f64 is deliberately NOT width-64 here: expr_scalar_type
            // asks expr_is_f64 first, and widening it at this leaf would route a
            // float element through the integer path.
            var ixt: string = ix_type_tag(ix, s);
            if (ixt == "i64" || ixt == "u64") { return 64; }
            return 32;
        },
        ast.ExprFieldAccess(fa) => {
            // An i64/u64 tuple element `t.N` or i64 struct field `p.x` is 64-bit.
            // Shares fa_type_tag with the four numeric-kind predicates rather
            // than re-walking obj → struct → field itself: struct_field_is_i64
            // is exactly `decl_field_type in {i64, u64}` by index, so the two
            // walks answered the same question and could drift (#5986).
            var wt: string = fa_type_tag(fa, s);
            if (wt == "i64" || wt == "u64") { return 64; }
            return 32;
        },
        _ => { return 32; }
    }
}

// method_recv_tyname returns the base type name to use when forming a
// "<Type>.<method>" key for a method-call receiver. A struct/enum receiver
// uses its declared type; a PRIMITIVE receiver has none, so recover the
// scalar type name — i64_ret_fns_of keys those methods as "<prim>.<m>"
// (base_type_name of the receiver type), and without this the lookup misses,
// so a WIDE return goes untracked and the result is truncated to 32 bits.
//
// The primitive half delegates to expr_recv_prim_type (which itself returns ""
// for struct / enum / array / tuple / map receivers, and the scalar type name
// otherwise). That subsumes the u64 and width-64 arms this used to carry
// open-coded — expr_scalar_type behind it applies the SAME u64-before-i64
// ordering, and its comment already noted it mirrored them — and additionally
// resolves string / f64 / f32 / u32 / boolean / i32 receivers, which returned
// "" here. That gap silently truncated an i64 returned from a method on any of
// those: `(n: f64) m(): i64` called as `a.m()` yielded only the low 32 bits,
// while the same body as a free function was correct, and a struct receiver was
// correct too (it resolved via expr_struct_type).
pub function method_recv_tyname(obj: ast.Expr, s: LowerState): string {
    var st: string = expr_struct_type(obj, s);
    if (st != "") { return st; }
    // An associated call's receiver is the bare TYPE name (`Counter.start()`):
    // not a value, so expr_struct_type reports "", but the name itself is the
    // "<Type>.<method>" registry key spelling — the same resolution
    // expr_struct_type's associated-call arm applies. Without it an impl
    // method's declared i64 return was invisible to the width registries and
    // `var t: i64 = Counter.start()` truncated (#5986). A name that is not a
    // real type cannot false-positive: every consumer keys a registry, and
    // only real types register.
    match (obj) {
        ast.ExprIdent(tid) => {
            if (s.slot_of(tid.name) < 0 && (decl_is_struct(s.structs, tid.name) || is_enum_like_name(tid.name, s.structs))) { return tid.name; }
        },
        _ => {}
    }
    return expr_recv_prim_type(obj, s);
}

// sfrrecv_chain_root_slot: the slot of the bare string LOCAL that a chain of
// SFRRECV-proven string methods is rooted at, or -1 when `e` is anything else.
// `base.drop(2)` roots at `base`, and so does `base.tail(4).to_owned()`.
//
// The root is the one pointer a consuming site has to guard against. Every link
// returns a fresh box, its own receiver, or a slice of it — and a slice is an
// allocation, so it is never equal to a box that already existed. Inductively
// the chain's result is therefore either the ROOT's box (every link took its
// identity path) or a box the chain itself allocated, which no live name holds.
// Depth is bounded because a wrong answer here is a use-after-free, not a
// missed reclaim, and no real chain is deep.
pub function sfrrecv_chain_root_slot(e: ast.Expr, s: LowerState, depth: i32): i32 {
    if (depth > 8) { return 0 - 1; }
    match (e) {
        ast.ExprIdent(cid) => {
            var csl: i32 = s.slot_of(cid.name);
            if (csl >= 0 && s.is_str_slot(csl)) { return csl; }
            return 0 - 1;
        },
        ast.ExprCall(cc) => {
            match (cc.callee) {
                ast.ExprFieldAccess(cfa) => {
                    var cty: string = method_recv_tyname(cfa.obj, s);
                    if (cty == "") { return 0 - 1; }
                    if (util.index_of_str(s.sigs.str_fresh_ret_fns, "SFRRECV:" + cty + "." + cfa.field) < 0) { return 0 - 1; }
                    return sfrrecv_chain_root_slot(cfa.obj, s, depth + 1);
                },
                ast.ExprIdent(ccid) => {
                    // `slice_unchecked(X, a, b)` is the `X[a:b]` link as a
                    // builtin (#5634): a view over X's bytes, never X's box.
                    if (ccid.name == "slice_unchecked" && cc.args.len() == 3) {
                        return sfrrecv_chain_root_slot(cc.args[0], s, depth + 1);
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return 0 - 1;
}

// lower_i64 lowers `e` as an i64 VALUE (pushing an i64). Integer literals become
// const_i64 (carrying source text), i64 locals load directly, and unary `-` /
// the non-comparison arithmetic + bitwise ops recurse on i64 operands. Anything
// that isn't a pure-i64 value here — an i32 variable (mixed width), a call, a
// comparison, i64 division/remainder — fails, bailing the module.
pub function lower_i64(e: ast.Expr, s: LowerState): LowerState {
    // c.get() on a Cell[i64/u64] -> c[0], lowered as an 8-byte i64 load (#5510).
    // Without this, c.get() in an i64 context (e.g. `c.get() + 1i64`) reaches
    // lower_i64 as a bare call it cannot lower, truncating the function.
    var i64ce: string = cell_get_elem(e, s);
    if (i64ce == "i64" || i64ce == "u64") {
        match (e) {
            ast.ExprCall(i64cc) => {
                match (i64cc.callee) {
                    ast.ExprFieldAccess(i64cfa) => {
                        var i64cz: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
                        return lower_i64(ast.ExprIndex { array: i64cfa.obj, index: i64cz, unchecked: true, ty: "" }, s);
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    match (e) {
        ast.ExprNumber(n) => {
            if (n.is_float) { return s.fail(); }
            return s.emit(ir.op_const_i64_text(n.text));
        },
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl >= 0 && s.is_i64_slot(sl)) { return s.emit(ir.op_load_local(sl)); }
            // An i32-width scalar leaf consumed in an i64 context — `s64 + i`, a
            // mixed-width param/local, or a for-range loop var accumulated into an
            // i64 — widens to i64 instead of bailing the module.
            // lower_expr pushes the i32 value; op_int_extend widens it (zero-extend
            // for u32, sign-extend for a signed i32 / subword). Because the
            // ExprBinary arm recurses through lower_i64, this also lifts the i32
            // leaves of nested sub-expressions (`s64 + (i + 1)`) for free.
            if (sl >= 0 && s.is_i32_scalar_slot(sl)) {
                var iw: LowerState = lower_expr(e, s);
                if (!iw.ok) { return iw; }
                return iw.emit(ir.op_int_extend(s.is_u32_slot(sl)));
            }
            // A `const B: i64` read. A const desugars to a zero-arg accessor
            // function (parser: `const NAME: T = E;` → `function NAME(): T`), so
            // the bare ident is a CALL returning i64 — which infer_expr_width
            // already knew (#4801) while this arm did not, so every USE of an
            // i64 const bailed the module to the AST emitter. An i32-returning
            // const still falls to the widening path above via lower_expr, and a
            // u64 one rides the same 8-byte call.
            //
            // It routes through id_type_tag for the same reason ix_type_tag
            // reaches lower_i64's ExprIndex arm: this is the LOAD site, and a
            // width decision the value predicates make on one leaf and the load
            // makes on another is the two-halves-disagree bug (#6165). Here
            // disagreement would emit a 4-byte read for a value infer_expr_width
            // widened to 64, which the wasm validator rejects outright.
            var cidt: string = id_type_tag(id, s);
            if (cidt == "i64" || cidt == "u64") {
                return s.emit(ir.op_call_direct(id.name, 0));
            }
            return s.fail();
        },
        ast.ExprUnary(u) => {
            if (u.op == "-") {
                // A composite `neg` returning i64 / u64 — the binary arm's
                // sibling, and lower_expr holds that desugar too.
                if ((u.ty == "i64" || u.ty == "u64") && decl_is_struct(s.structs, expr_struct_type(u.operand, s))) {
                    return lower_expr(e, s);
                }
                var sz: LowerState = s.emit(ir.op_const_i64_text("0"));
                var sx: LowerState = lower_i64(u.operand, sz);
                if (!sx.ok) { return sx; }
                return sx.emit(ir.op_bin("sub", 64, false));
            }
            // `n as i64` / `n as u64`. Three operand cases:
            //  - an f64 operand: truncate toward zero to i64 (f64_to_i64);
            //    op_int_extend would mis-extend the f64's bit pattern as i32.
            //  - a non-float numeric LITERAL: already a 64-bit value, so emit an
            //    i64 const directly — lowering via the 32-bit lower_expr would
            //    make it an `i32.const`, truncating (and invalid on wasm for a
            //    literal above the i32 range). #2928.
            //  - otherwise: widen the i32 operand to i64.
            if (u.op == "as_i64" || u.op == "as_u64") {
                if (expr_is_f64(u.operand, s)) {
                    var fw: LowerState = lower_expr(u.operand, s);
                    if (!fw.ok) { return fw; }
                    // `f64 as u64` truncates UNSIGNED (#4332): the signed
                    // f64_to_i64 clamps at INT64_MAX, so 1e19 as u64 read as
                    // 9223372036854775807 instead of 10^19.
                    if (u.op == "as_u64") { return fw.emit(ir.op_f64_to_u64()); }
                    return fw.emit(ir.op_f64_to_i64());
                }
                match (u.operand) {
                    ast.ExprNumber(n) => { if (!n.is_float) { return s.emit(ir.op_const_i64_text(n.text)); } },
                    _ => {}
                }
                // A 64-bit operand (an i64/u64 var, an i64 arithmetic expr, …) is
                // already full-width: `i64 as u64` / `u64 as i64` is a pure
                // reinterpret (same bit pattern), so lower it via the 64-bit path
                // and DON'T op_int_extend — extending would first truncate to 32
                // bits via lower_expr (the 32-bit path) and then re-widen, losing
                // the high half. Only a genuinely 32-bit operand needs widening.
                if (infer_expr_width(u.operand, s) == 64) {
                    return lower_i64(u.operand, s);
                }
                var sw: LowerState = lower_expr(u.operand, s);
                if (!sw.ok) { return sw; }
                // The extension's signedness is the SOURCE's, not the
                // destination's (internal/ir keys it on `srcInt.IsSigned()`):
                // `u32 as i64` zero-extends, so 4294967295 stays positive, and
                // `i32 as u64` sign-extends, so -1 becomes 0xFFFF_FFFF_FFFF_FFFF.
                return sw.emit(ir.op_int_extend(expr_is_u32(u.operand, s) || expr_subword_kind(u.operand, s) != ""));
            }
            // `inner?` with an i64/u64 payload: lower_try emits the width-64 payload
            // read, so the unwrapped value is a true i64 here (the `var x: i64 =
            // inner?` binding lands in lower_i64). lower_try bails for non-i64/u64
            // payloads, so this stays sound for the i64 domain.
            if (u.op == "try_") { return lower_try(u.operand, s); }
            return s.fail();
        },
        ast.ExprBinary(b) => {
            // Saturating arithmetic (#5542) carries its own width-aware
            // lowering (clamped, not wrapped) at every width. When its OPERANDS
            // are 32-bit-or-narrower it produces a 32-bit value, so an i64
            // context — e.g. `(p +| q) == 4294967295`, whose literal is an i64
            // and drags the whole compare to width 64 — has to widen it, the
            // same way the ExprIdent arm below widens a narrow local. Without
            // that the wasm module fails to validate (i32 where i64 expected).
            if (is_sat_op(b.op)) {
                var satw: LowerState = lower_sat_binary(b, e, s);
                if (!satw.ok) { return satw; }
                if (infer_expr_width(e, s) == 64) { return satw; }
                return satw.emit(ir.op_int_extend(expr_is_u32(e, s) || expr_subword_kind(e, s) != ""));
            }
            // A composite operator overload (#2706) whose method returns i64 /
            // u64 is an i64 VALUE: the desugar to `a.<m>(b)` lives in
            // lower_expr, and that call pushes a full-width result. Without
            // this the arithmetic path below recursed into the STRUCT operands
            // and bailed. This is the load-site half of ExprBinary.ty, the rule
            // ExprIndex.ty needed too (#6165): infer_expr_width already reports
            // 64 here off the same tag, so the load has to agree or the two
            // halves disagree and the module fails to validate.
            if ((b.ty == "i64" || b.ty == "u64")
                && binop_overload_method(b.op) != ""
                && decl_is_struct(s.structs, expr_struct_type(b.left, s))) {
                return lower_expr(e, s);
            }
            var kind: string = map_binop(b.op);
            if (kind == "") { return s.fail(); }
            // Comparisons aren't i64 values (they yield an i32 bool). i64
            // division/remainder ARE lowered (width 64): x86 drops the i32
            // movslq truncation, arm64's sdiv is already 64-bit, wasm calls the
            // $__fern_idiv64 / $__fern_irem64 non-trapping helpers.
            if (is_cmp_kind(kind)) { return s.fail(); }
            var l: LowerState = lower_i64(b.left, s);
            if (!l.ok) { return l; }
            var r: LowerState = lower_i64(b.right, l);
            if (!r.ok) { return r; }
            // u64 operands select the UNSIGNED i64 ops (>> / div / rem) — signed
            // are wrong once bit 63 is set (#2904). A shift's signedness follows
            // the left (shifted) operand; div/rem use either side. The other ops
            // (add/sub/mul/and/or/xor/shl) are sign-agnostic. (Compares already
            // bailed above — they yield an i32 bool, lowered in lower_expr.)
            var i64k: string = kind;
            if (b.op == ">>" || b.op == "<<") {
                if (expr_is_u64(b.left, s)) { i64k = to_unsigned_kind(kind); }
            } else if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) {
                i64k = to_unsigned_kind(kind);
            }
            return r.emit(ir.op_bin(i64k, 64, false));
        },
        ast.ExprCall(c) => {
            // An i64-valued if/match-EXPRESSION (the 0-arg IIFE) — delegate to
            // lower_iife, which marks the inline temp i64 and widens each branch
            // value.
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        // The 0-arg IIFE the if/match-EXPRESSION desugar emits, in an
                        // i64/u64 binding context: delegate with force_i64=true so the
                        // inline temp is i64 even when i64-ness comes ONLY from the
                        // annotation (`var x: i64 = if (c) { 5 } else { 9 }`, all small
                        // literals). lower_iife widens each branch value into the i64
                        // temp; a non-if/match body still fails through to s.fail().
                        //
                        // A MULTI-statement body belongs here too (#6267). lower_iife
                        // routes it to lower_value_block, which lowers the leading
                        // statements and hands the tail to the same lower_value_stmt
                        // the single-statement form uses. Restricting this arm to one
                        // statement did not refuse the program — it fell through to
                        // the caller's i32 path plus an op_int_extend, which TRUNCATES
                        // the value to 32 bits first: `return { var t: i64 = p + 1i64;
                        // if (t > 4i64) { t * 3i64 } else { 7i64 } }` answered wrongly
                        // above 2^31 on x86-64 and emitted wasm the validator rejects
                        // ("expected i32, found i64").
                        if (lam.params.len() == 0 && lam.origin != parser.ORIGIN_IIFE_SCOPED) {
                            return lower_iife(c, lam, s, true);
                        }
                    },
                    _ => {}
                }
            }
            // typed-IR (#5986): the width half (infer_expr_width's ExprCall arm)
            // is tag-first, so the LOAD site reads the same tag — split across
            // two derivations, a call 64-bit only by the checker's stamp typed
            // wide downstream while lowering through the width-32 sign-extend
            // below, a widen of an already-wide operand the wasm validator
            // rejects.
            if (c.ty == "i64" || c.ty == "u64") { return lower_expr(e, s); }
            // A call to an i64-returning free function OR method IS an i64 value:
            // lower it via the normal call path (which pushes the result).
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // The clock builtins return an i64 value: lower via the
                    // normal call path (which emits the op + pushes the result).
                    if (cid.name == "monotonic_ns" || cid.name == "now_unix_ms" || cid.name == "now_ns") { return lower_expr(e, s); }
                    if (cid.name == "__load_i64") { return lower_expr(e, s); }
                    // The bump high-water mark is an i64 value: the normal call
                    // path emits op_heap_bump_bytes and pushes the full-width
                    // result, where the width-32 sign-extend below would drop it
                    // back to the truncating read this widening removed.
                    if (cid.name == "__heap_bump_bytes") { return lower_expr(e, s); }
                    // Likewise the cliff weight: an i64 value whose full width
                    // the normal call path pushes.
                    if (cid.name == "__arr_push_shared_bytes") { return lower_expr(e, s); }
                    // f64_bits returns an i64 bit pattern: lower via the normal
                    // call path (lower_expr emits op_f64_bits + pushes the result).
                    if (cid.name == "f64_bits") { return lower_expr(e, s); }
                    // An INDIRECT call through a fn value declared to return
                    // i64/u64 already pushes a full-width result, so it is an i64
                    // value and the sign-extend below would be a widen of an
                    // already-wide operand — `i64.extend_i32_s` applied to an i64,
                    // which wasm rejects inside the caller ("expected i32, found
                    // i64") even once the funcref type itself is right. #6282.
                    var fvr: string = s.fn_value_ret(s.slot_of(cid.name));
                    if (fvr == "i64" || fvr == "u64") { return lower_expr(e, s); }
                    // Module-function registries only — a local slot of the same
                    // name shadows them. See the matching guard in
                    // infer_expr_width; #6283.
                    if (s.slot_of(cid.name) < 0) {
                        if (s.is_i64_ret_fn(cid.name)) { return lower_expr(e, s); }
                        // An erased-generic call whose return mirrors a 64-bit
                        // argument IS an i64 value: the callee passes the 8-byte
                        // slot through untouched, so the normal call path (which
                        // pushes the full-width result) is the correct lowering —
                        // the width-32 sign-extend below would truncate it.
                        var gli: i32 = str_ret_argref(s, cid.name);
                        if (gli >= 0 && gli < c.args.len()
                            && !expr_is_f64(c.args[gli], s) && infer_expr_width(c.args[gli], s) == 64) { return lower_expr(e, s); }
                    }
                },
                ast.ExprFieldAccess(cfa) => {
                    // The fn-FIELD call load site, paired with infer_expr_width's
                    // reading of the same leaf: the call already yields its 8-byte
                    // result, so the width-32 sign-extend below would truncate it.
                    var lffr: string = call_fn_field_ret(c, s);
                    if (lffr == "i64" || lffr == "u64") { return lower_expr(e, s); }
                    var crty: string = method_recv_tyname(cfa.obj, s);
                    if (crty != "" && s.is_i64_ret_fn(crty + "." + cfa.field)) { return lower_expr(e, s); }
                    // `m.get_or(k, d)` on an i64/u64 map IS an i64 value: the get
                    // returns the 8-byte value full-width in the pushed word, so the
                    // normal call path is correct (the width-32 extend below would be
                    // a no-op-then-truncate). #5253.
                    if (cfa.field == "get_or" && c.args.len() == 2) {
                        var glvt: string = map_value_of(get_or_recv_map_type(cfa.obj, s));
                        if (glvt == "i64" || glvt == "u64") { return lower_expr(e, s); }
                    }
                },
                _ => {}
            }
            // An i32-returning call consumed in an i64 context (`s64 + g()`): lower
            // the i32 result (lower_expr, the normal call path) and sign-extend to
            // i64 instead of bailing the module to AST. The checker forbids i64 +
            // f64/string/u32 and rejects binding a bare i32 call to an i64 (it needs
            // an explicit `as i64`), so a call reaching this point in a valid program
            // — width 32, not i64-returning, not the 0-arg if/match IIFE handled
            // above — necessarily returns a signed i32. infer_expr_width gates the
            // widen; expr_is_u32 (false for calls) leaves it sign-extended.
            if (infer_expr_width(e, s) == 32) {
                var cw: LowerState = lower_expr(e, s);
                if (!cw.ok) { return cw; }
                return cw.emit(ir.op_int_extend(expr_is_u32(e, s)));
            }
            return s.fail();
        },
        ast.ExprFieldAccess(fa) => {
            // An i64 tuple element `t.N` is an 8-byte i64 value: lower the tuple
            // then tuple_get_w(..i64). An i64 struct field `p.x` likewise reads
            // via struct_get_i64. Non-i64 reads bail (their i32/f64 path lives in
            // lower_expr).
            if (util.is_all_digits(fa.field)) {
                var tn: i32 = util.digits_to_i32(fa.field);
                var tnt: string = expr_tuple_elem_tag(fa.obj, tn, s);
                if (tnt == "i64" || tnt == "u64") {
                    var ts: LowerState = lower_expr(fa.obj, s);
                    if (!ts.ok) { return ts; }
                    return ts.emit(ir.op_tuple_get_w(tn, 64, true));
                }
                // An i32 tuple element `t.N` consumed in an i64 context: read the
                // i32 element (lower_expr) and widen instead of bailing to AST.
                if (tnt == "i32" || tnt == "u32") {
                    var tw: LowerState = lower_expr(e, s);
                    if (!tw.ok) { return tw; }
                    return tw.emit(ir.op_int_extend(tnt == "u32"));
                }
                return s.fail();
            }
            var fty: string = expr_struct_type(fa.obj, s);
            if (fty == "") { return s.fail(); }
            var fidx: i32 = s.field_index_in(fty, fa.field);
            if (fidx < 0) { return s.fail(); }
            if (struct_field_is_i64(s.structs, fty, fidx)) {
                var fs: LowerState = lower_expr(fa.obj, s);
                if (!fs.ok) { return fs; }
                return fs.emit(ir.op_struct_get_i64(fidx));
            }
            // An i32 struct field `p.x` consumed in an i64 context (`s64 + p.x`):
            // read the i32 field (lower_expr) and sign/zero-extend to i64 instead
            // of bailing the module to AST. The checker forbids i64 + u32, so a
            // plain i32 field here is signed; the u32 flag stays defensive.
            var ffty: string = decl_field_type(s.structs, fty, fa.field);
            if (ffty == "i32" || ffty == "u32") {
                var fw: LowerState = lower_expr(e, s);
                if (!fw.ok) { return fw; }
                return fw.emit(ir.op_int_extend(ffty == "u32"));
            }
            return s.fail();
        },
        ast.ExprIndex(ix) => {
            // a[i] on an i64[] / u64[] is an 8-byte i64 element: lower base +
            // index (i32 values) then arr_get_i64 (i64.load on wasm). Shares
            // ix_type_tag with infer_expr_width's ExprIndex arm, so the read
            // width and the inferred width answer from one place.
            var ixt64: string = ix_type_tag(ix, s);
            if (ixt64 == "i64" || ixt64 == "u64") {
                var bs: LowerState = lower_expr(ix.array, s);
                if (!bs.ok) { return bs; }
                bs = lower_expr(ix.index, bs);
                if (!bs.ok) { return bs; }
                // #4380 lever 3: drop the bounds check on a proven-in-bounds read.
                if (ix.unchecked) { return bs.emit(ir.op_arr_get_i64_nc()); }
                return bs.emit(ir.op_arr_get_i64());
            }
            // An i32-element array indexed in an i64 context (`s64 + a[i]`, a
            // numeric reduction): lower the i32 element via lower_expr (arr_get)
            // and widen to i64 instead of bailing the module to AST. The checker
            // forbids i64 + u32, so a plain i32[] element here is signed;
            // expr_is_u32 still selects zero-extend for the defensive u32[] case.
            if (arr_index_is_i32_scalar(ix.array, s)) {
                var ws: LowerState = lower_expr(e, s);
                if (!ws.ok) { return ws; }
                return ws.emit(ir.op_int_extend(expr_is_u32(e, s)));
            }
            return s.fail();
        },
        _ => { return s.fail(); }
    }
}

// str_free_call_field maps a two-arg string builtin FREE-function name to the
// method `field` lower_str_method expects (`str_split`→`split`, etc.), or "" if
// the name isn't one. Lets the free-call and method-call forms share one lowerer.
pub function str_free_call_field(name: string): string {
    if (name == "str_split") { return "split"; }
    if (name == "str_starts_with") { return "starts_with"; }
    if (name == "str_ends_with") { return "ends_with"; }
    if (name == "str_index_of") { return "index_of"; }
    // The transform + remaining-predicate free-function spellings: the same
    // ops as the `.<field>()` method forms (lower_str_method), differing only
    // in that the receiver is the first positional arg. Arity is recovered via
    // str_method_argc(field) at the call site, so a 0-method-arg transform
    // (`str_to_upper(s)`), a 1-arg form (`str_repeat(s, n)`) and the 2-arg
    // `str_replace(s, old, new)` all route through one generalised lowerer.
    if (name == "str_to_upper") { return "to_ascii_upper"; }
    if (name == "str_to_lower") { return "to_ascii_lower"; }
    if (name == "str_trim") { return "trim"; }
    if (name == "str_repeat") { return "repeat"; }
    if (name == "str_replace") { return "replace"; }
    if (name == "str_contains") { return "contains"; }
    return "";
}

// is_str_builtin_method reports whether `field` names a string builtin method the
// IR path lowers directly: the 0-arg transforms `to_upper` / `to_lower` (→ fresh
// string), `split` (→ string[]), and the scalar predicates starts_with /
// ends_with / index_of / contains. The caller checks arity (str_method_argc) +
// that the receiver is a string before dispatching to lower_str_method.
pub function is_str_builtin_method(field: string): boolean {
    return field == "to_ascii_upper" || field == "to_ascii_lower" || field == "trim"
        || field == "reverse" || field == "repeat" || field == "replace"
        || field == "lines"
        || field == "split"
        || field == "starts_with" || field == "ends_with" || field == "index_of"
        || field == "contains";
}

// str_method_argc gives the argument count of a string builtin method: the case
// transforms are 0-arg; everything else (split + predicates) is 1-arg.
pub function str_method_argc(field: string): i32 {
    if (field == "to_ascii_upper" || field == "to_ascii_lower" || field == "trim" || field == "reverse" || field == "lines") { return 0; }
    if (field == "replace") { return 2; }
    return 1;
}

// lower_str_method lowers a string builtin method `recv.<field>(args…)`: it
// lowers the receiver, then (for the 1-arg forms) the argument, then emits the
// field's op. `to_upper` / `to_lower` → a fresh cased string; `split` → string[];
// the search predicates → scalar (`contains` is `index_of(...) >= 0`). Kept out
// of lower_expr's giant FieldAccess arm to stay under the self-host backend's
// oversized-function threshold (#2720).
pub function lower_str_method(field: string, recv: ast.Expr, args: ast.Expr[], s: LowerState): LowerState {
    var p: LowerState = lower_expr(recv, s);
    if (!p.ok) { return p; }
    // A fresh anonymous RECEIVER (`mkfresh(i).to_ascii_upper()`) is dead the
    // moment the op has read it, exactly as a fresh ARGUMENT is dead after the
    // call — but nothing released it, so the temp leaked at every string method
    // except `.len()`, which has its own path. Stash it and drain after the op,
    // reusing the argument side's park/drain pair.
    //
    // str_borrowing_method is the warrant: those methods read the receiver's
    // bytes or allocate a new buffer and hand neither the receiver's box nor a
    // view of it back. `trim` and `replace` are outside it because both can
    // return the receiver, and `lines` / `split` were never in it
    // because their results carry views into the receiver's bytes — all three
    // still lower here, and all three keep the leak rather than risk the alias.
    var rslots: i32[] = [];
    // A `slice_unchecked(base, a, b)` receiver is a box nobody names either —
    // `slice_unchecked(base, a, b).starts_with(..)` materialises one and the op is
    // done with it once it returns. is_fresh_str_temp refuses it (a view aliases
    // its source's bytes, which is the question it answers), but
    // str_borrowing_method is the warrant that matters here: every method in that
    // set reads the receiver's bytes and hands back a scalar or a freshly
    // allocated string, never the receiver or a view of it. `trim` / `replace` /
    // `lines` / `split` are outside it precisely because they can alias, and they
    // keep the leak. The `s[a:b]` spelling is not here: it yields an `Option[str]`
    // box (#5634), which has no string-method surface at all.
    var rview: boolean = false;
    var rtake: boolean = false;
    if (str_borrowing_method(field)) {
        rtake = is_fresh_str_temp(recv, s);
        if (!rtake) {
            match (recv) {
                ast.ExprCall(_) => { if (slice_unchecked_call(recv)) { rtake = true; rview = true; } },
                _ => {}
            }
        }
    }
    if (rtake) {
        var rn: string = "$srcv" + util.i32_to_string(p.locals.len());
        p = p.add_local(rn);
        var rslot: i32 = p.slot_of(rn);
        p = p.emit(ir.op_store_local(rslot));
        p = p.emit(ir.op_load_local(rslot));
        rslots = rslots.append(rslot);
    }
    if (field == "to_ascii_upper") { return free_stashed_recv(p.emit(ir.op_str_to_upper()), rslots, rview); }
    if (field == "to_ascii_lower") { return free_stashed_recv(p.emit(ir.op_str_to_lower()), rslots, rview); }
    if (field == "trim") { return free_stashed_recv(p.emit(ir.op_str_trim()), rslots, rview); }
    if (field == "reverse") { return free_stashed_recv(p.emit(ir.op_str_reverse()), rslots, rview); }
    if (field == "lines") { return p.emit(ir.op_str_lines()); }
    p = lower_expr(args[0], p);
    if (!p.ok) { return p; }
    if (field == "replace") {
        p = lower_expr(args[1], p);
        if (!p.ok) { return p; }
        return p.emit(ir.op_str_replace());
    }
    if (field == "repeat") { return free_stashed_recv(p.emit(ir.op_str_repeat()), rslots, rview); }
    if (field == "split") { return p.emit(ir.op_str_split()); }
    if (field == "starts_with") { return free_stashed_recv(p.emit(ir.op_str_starts_with()), rslots, rview); }
    if (field == "ends_with") { return free_stashed_recv(p.emit(ir.op_str_ends_with()), rslots, rview); }
    if (field == "index_of") { return free_stashed_recv(p.emit(ir.op_str_index_of()), rslots, rview); }
    // contains: index_of(sub) >= 0
    p = p.emit(ir.op_str_index_of());
    p = p.emit(ir.op_const_i32(0));
    return free_stashed_recv(p.emit(ir.op_bin("ge_s", 0, false)), rslots, rview);
}

// lower_arr_str_join lowers `xs.join(sep)` on a string[] receiver to a call of the
// __fern_arr_str_join runtime helper (asmcore.rt_src_arr_str_join — a real Fern
// function the AST emitters call the same way). It takes the __fn_ stack ABI
// (param0=xs on TOP, param1=sep below): xs is evaluated FIRST (receiver-before-arg,
// matching the AST path + native) but must be pushed LAST so it lands on top, so
// both operands spill to scratch locals and reload in ABI order. The helper is in
// is_fern_helper, so the call_direct routes through the emitters' runtime-helper
// arm, which marks the arr_str_join / str_concat / heap needs and cleans the two
// stack args. Result is a fresh owned string (expr_is_str recognises `.join`). #5328.
pub function lower_arr_str_join(recv: ast.Expr, sep: ast.Expr, s: LowerState): LowerState {
    var xtmp: string = "$jxs" + util.i32_to_string(s.locals.len());
    var p: LowerState = s.add_local(xtmp);
    var xslot: i32 = p.slot_of(xtmp);
    p = lower_expr(recv, p);
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(xslot));
    var stmp: string = "$jsep" + util.i32_to_string(p.locals.len());
    p = p.add_local(stmp);
    var sslot: i32 = p.slot_of(stmp);
    p = lower_expr(sep, p);
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(sslot));
    p = p.emit(ir.op_load_local(sslot));   // param1 = sep (pushed first, sits below)
    p = p.emit(ir.op_load_local(xslot));   // param0 = xs  (pushed last, on top)
    return p.emit(ir.op_call_direct("__fern_arr_str_join", 2));
}

// lower_variant_ctor_args lowers a variant/struct construction's arguments and
// emits the Perceus alias-inc each payload kind needs, for BOTH ctor spellings.
//
// `Variant(args)` and `Enum.Variant(args)` build the same box through the same
// op_struct_make, and reach lower_expr on different arms — an ident callee and a
// field-access callee. The qualified arm was added to keep a module IR-eligible
// and lowered its args with NO retain at all, so `E.A(items)` handed the caller a
// box over memory the source local's exit sweep had already freed: 100 of 100
// rounds read back the next allocation's contents where the bare `A(items)` read
// the right value. That is #3720's bug, live on the spelling its fix never
// reached. Reading the field types through the resolved decl INDEX also settles
// the ambiguity the qualified arm documents — two enums may declare the same
// variant name, and the by-name lookups answer for whichever was declared first.
//
// `selfrebind` is the consume-rebind name (`acc = Cons(1, acc)`), where the
// slot's own reference TRANSFERS into the payload field; "" when there is none.
function lower_variant_ctor_args(args: ast.Expr[], decl_idx: i32, selfrebind: string, s: LowerState): LowerState {
    var st: LowerState = s;
    var i: i32 = 0;
    while (i < args.len()) {
        // An i64 payload field is an 8-byte i64 value (a bare integer literal
        // isn't self-evidently i64), so lower it via lower_i64; struct_make
        // 64-bit-stores it. f64 / i32 / string / struct payloads ride lower_expr.
        if (struct_field_at_is_i64(st.structs, decl_idx, i)) { st = lower_i64(args[i], st); }
        else { st = lower_expr(args[i], st); }
        if (!st.ok) { return st; }
        var fty: string = decl_at_field_type(st.structs, decl_idx, i);
        // An ARRAY payload that aliases a local array: the variant box references
        // the buffer, so retain it with the pointer on top of the stack. Without
        // this the exit dec-sweep frees the source local out from under the
        // returned box (#3720). Only a bare ident on an array slot: a fresh
        // literal isn't a local, so the sweep never frees it (it leaks — the
        // safe-leak invariant for nested payloads). The inc pops + re-pushes the
        // same pointer, leaving struct_make's arg order intact.
        // A FIELD READ (`Leaf(v.tail)`) aliases a buffer the holder's box owns,
        // and a rebind of the holder releases that buffer through
        // __field_reclaim_<T>'s array arm — std/pvec's level-grow lost its first
        // leaf that way — so the variant takes a count of its own. Only for a
        // scalar-element field: that is the payload kind
        // emit_enum_variant_payload_drops releases with one dec, so the count
        // has a release; a struct-array field has none there and the count
        // would strand the buffer.
        if (is_array_type_name(fty)) {
            match (args[i]) {
                ast.ExprIdent(paid) => {
                    if (st.is_arr_slot(st.slot_of(paid.name))) {
                        st = st.retain_tos("variant-arr-payload");
                    }
                },
                ast.ExprFieldAccess(_) => {
                    if (scalar_arr_field_type(args[i], st).len() > 0) {
                        st = st.retain_tos("variant-arr-payload");
                    }
                },
                _ => {}
            }
        }
        // A STRUCT-BOX payload is a second owner of the box just as an array
        // payload is of its buffer, and was excluded for no reason beyond the array
        // predicate above naming only arrays — the same array-only gating
        // lower_opt_make_payload had before #7528, one container over. SKIPPED at a
        // move site: the construction takes over the local's reference there, so the
        // inc would be paid against an elided sweep dec and the box would leak.
        // That pairing is native's `needsRcIncOnAlias && !moveSites`.
        if (variant_counted_struct_payload(args[i], fty, st.structs)) {
            match (args[i]) {
                ast.ExprIdent(psid) => {
                    if (!st.moves_local_at(psid.name, psid.line, psid.col)) {
                        st = st.retain_tos("variant-struct-payload");
                    }
                },
                _ => {}
            }
        }
        // An ENUM payload (`Cons(n, xs)`) is a second owner of whatever box it
        // stores, so it takes the same dup — with the same exemption: a FRESH
        // variant ctor is sole-owned at rc 1 and needs none. Without it a bare
        // enum local stored into a variant box is an UNCOUNTED alias, and that
        // count is the one every consume path reads to decide whether it may free
        // (#6720): a consuming walk over `Cons(x, borrowed)` was told each cell
        // was uniquely owned and reclaimed the caller's list from under it. A
        // non-fresh payload that is genuinely sole-owned then LEAKS rather than
        // double-frees.
        //
        // EXCEPT a consume-rebind: the slot is superseded by the box being built,
        // so its reference TRANSFERS into the payload field and the owner count is
        // unchanged — a move, which is what native's last-use analysis makes of it
        // too. Retaining there pins every cell of an accumulator loop at rc 2, and
        // a consuming walk then reads a non-unique cell and declines to recycle
        // it: `inc_all(build(2000))` reallocates its whole input instead of
        // reusing it (187 KiB against 93 KiB), which `trmc-consume-halves-peak`
        // gates. The loop rebind is exactly the shape moved_locals_toplevel_of
        // leaves out, so the move verdict cannot supply this one.
        if (decl_is_enum(st.structs, fty)
            && variant_ctor_enum_owner(args[i], st.structs).len() == 0
            && !ctor_selfrebind_payload(args[i], selfrebind)) {
            st = st.emit(ir.op_call_direct("__fern_rc_inc", 1));
        }
        i = i + 1;
    }
    return st;
}

// variant_counted_struct_payload: `arg` is a bare ident stored into a variant
// payload field of type `fty`, and that field is one emit_enum_variant_payload_drops
// actually RELEASES (its deep-drop-ok and scalar-only arms). Both the construction
// retain and the counted credit ask exactly this, in those words, because a credit
// the retain does not honour is an over-release rather than a missed optimisation —
// the same rule struct_routes_field_reclaim_at states for the string-field store.
//
// A bare ident of struct type always names a box (local or param). If the credit
// then declines the name on one of its escape gates, the retain is unmatched and
// the box LEAKS — the safe-leak side of the invariant, never a dangle.
function variant_counted_struct_payload(arg: ast.Expr, fty: string, structs: parser.StructDecl[]): boolean {
    if (!decl_is_struct(structs, fty)) { return false; }
    if (!nested_field_deep_drop_ok(structs, fty) && !struct_lit_all_scalar(structs, fty)) { return false; }
    match (arg) {
        ast.ExprIdent(_) => { return true; },
        _ => {}
    }
    return false;
}

// opt_payload_struct_slot: slot `i` holds a STRUCT box whose type routes a field
// reclaim — the payload kind whose release is a field walk PLUS a box dec, so the
// option's co-ownership has to be counted like any other rc payload's.
function opt_payload_struct_slot(s: LowerState, i: i32): boolean {
    var sty: string = s.struct_type_of_slot(i);
    if (sty.len() == 0) { return false; }
    return s.struct_routes_field_reclaim(sty);
}

// lower_opt_make_payload lowers `arg` (widening an i64 / f64 payload to its full
// 8 bytes) and emits the Option/Result box op for `tag` (0 = Some/Ok, 1 = Err).
// The box is [tag@0, payload@8], type-agnostic. Shared by the bare construction
// forms (`Ok(x)`) and the qualified ones (`Result.Ok(x)`).
function lower_opt_make_payload(tag: i32, arg: ast.Expr, s: LowerState): LowerState {
    var ptag: string = elem_type_tag(arg, s);
    var so: LowerState = s;
    if (ptag == "i64") { so = lower_i64(arg, so); } else { so = lower_expr(arg, so); }
    if (!so.ok) { return so; }
    // Perceus alias-inc for a payload that aliases a local: the Option/Result box
    // references the payload, so retain it (rc_inc) so the exit dec-sweep doesn't
    // free the source local out from under the box. Without it `Ok(names)` /
    // `Some(items)` over-releases — a UAF that only bites once a later allocation
    // reuses the freed cell (the match-arm that extracts the payload already
    // reclaims it at arm exit, so construction must balance that with an inc).
    // Mirrors the enum-variant construction's alias-inc (#3720); only a bare ident
    // on a local slot (a fresh-literal payload isn't a local, so the sweep never
    // frees it). The inc pops + re-pushes the same pointer, leaving op_opt_make's
    // operand on top. i64/f64 payloads aren't such slots, so this never fires
    // before the op_opt_make_w paths.
    //
    // A STRUCT-BOX payload takes the same retain. It was excluded while the
    // predicate was slot_is_rc_container, and `Some(p)` over-released p's box for
    // exactly the reason the array case was fixed: a RETURNED option outlived p's
    // exit sweep and the next allocation reused the cell, so the payload read back
    // a clobbered struct.
    match (arg) {
        ast.ExprIdent(paid) => {
            var pasl: i32 = so.slot_of(paid.name);
            if (so.slot_is_rc_container(pasl) || opt_payload_struct_slot(so, pasl)) {
                so = so.retain_tos("opt-make-payload");
            }
        },
        _ => {}
    }
    if (ptag == "i64") { return so.emit(ir.op_opt_make_w(tag, 64, true)); }
    // elem_ty_is_f64slot, not `== "f64"`: an f32 payload rides the same 8-byte
    // slot, and the READ side already asks the helper — so spelling it literally
    // here stored the narrow 4-byte form under a wide read. On the register
    // backends that is invisible; wasm validates it and refuses the module
    // (`expected i32, found f64`). #7756.
    if (elem_ty_is_f64slot(ptag)) { return so.emit(ir.op_opt_make_w(tag, 64, false)); }
    return so.emit(ir.op_opt_make(tag));
}

// lower_opt_make_payload_exp is the expected-type-aware variant: when the
// DECLARED payload type (`exp_tag`, recovered from the enclosing function's
// Option/Result return type or an annotated binding) is i64/u64 but the argument
// only infers i32 width (a bare literal `Ok(40)` or an i32 variable), the box must
// still use the 8-byte/offset-8 layout every consumer reads via
// op_opt_payload_w(64, true) — otherwise the construction stores a 4-byte payload
// at offset 4 that the match-arm / try-operator read misinterprets (a silent
// miscompile). An i64-spelled literal/cast/expr lowers via lower_i64; a plain i32
// value is widened with op_int_extend. exp_tag "" (or any non-i64/u64 tag) is
// byte-identical to lower_opt_make_payload.
function lower_opt_make_payload_exp(tag: i32, arg: ast.Expr, exp_tag: string, s: LowerState): LowerState {
    var ptag: string = elem_type_tag(arg, s);
    var want_i64: boolean = (exp_tag == "i64" || exp_tag == "u64") && ptag != "i64" && !elem_ty_is_f64slot(ptag);
    if (!want_i64) { return lower_opt_make_payload(tag, arg, s); }
    // lower_i64 handles a numeric literal (const_i64_text), an `as i64`/`as u64`
    // cast, an i64 slot, and i64 arithmetic; it bails (ok=false) on a bare i32
    // value, in which case re-lower from the ORIGINAL state and widen to 8 bytes.
    var a64: LowerState = lower_i64(arg, s);
    if (a64.ok) { return a64.emit(ir.op_opt_make_w(tag, 64, true)); }
    var aw: LowerState = lower_expr(arg, s);
    if (!aw.ok) { return aw; }
    aw = aw.emit(ir.op_int_extend(exp_tag == "u64"));
    return aw.emit(ir.op_opt_make_w(tag, 64, true));
}

// lower_wide_to_string_recv lowers the RECEIVER of an i64/u64 `.to_string()`.
//
// lower_expr has no `as_i64` / `as_u64` arm — the same hole the i64[]-literal
// path documents — so an INLINE `(1234567890123 as i64).to_string()` bailed the
// whole module, while the bound form (`var v: i64 = … as i64; v.to_string()`)
// lowered. lower_i64 has that arm but bails on a CALL, which lower_expr takes,
// so neither alone covers the receiver domain.
//
// lower_expr goes FIRST, not lower_i64: for every receiver that lowers today
// (an i64 slot, an i64-returning call) both paths succeed but emit different
// ops, and this is on the byte-identical self-compile path. Trying the working
// path first keeps those programs' output identical and rescues only the shapes
// that bailed. Re-lowering from the ORIGINAL state on failure is the same
// speculative shape lower_opt_make_payload_exp uses.
function lower_wide_to_string_recv(e: ast.Expr, s: LowerState): LowerState {
    var n32: LowerState = lower_expr(e, s);
    if (n32.ok) { return n32; }
    return lower_i64(e, s);
}

// lower_subprocess_call lowers `subprocess(cmd, args, stdin)` — the three args
// (cmd / args / stdin, so the dispatch pops stdin from TOS) then op_subprocess,
// which pushes a fresh ProcessResult struct. Kept OUT of lower_expr's body: that
// function is so large that any added block carrying LowerState locals + recursive
// lower_expr calls inflates its arm64 codegen super-linearly (see the call site).
pub function lower_subprocess_call(c: ast.ExprCall, s: LowerState): LowerState {
    var sp: LowerState = lower_expr(c.args[0], s);
    if (!sp.ok) { return sp; }
    sp = lower_expr(c.args[1], sp);
    if (!sp.ok) { return sp; }
    sp = lower_expr(c.args[2], sp);
    if (!sp.ok) { return sp; }
    return sp.emit(ir.op_subprocess());
}

// lower_fn_value_arg lowers argument `ai` of an indirect call through the
// fn-value named `fname` at the width that value's DECLARED signature gives the
// position — the indirect sibling of the param_is_i64 / param_is_f64 arms a
// DIRECT call already takes. Without it a `(i64) => boolean` value called as
// `lf(4i64)` pushes an i32 while the call dispatches through a funcref type
// declaring i64: the register backends read half a word and wasm refuses to
// load the module at all.
function lower_fn_value_arg(a: ast.Expr, fslot: i32, ai: i32, s: LowerState): LowerState {
    return lower_fn_value_arg_wc(a, s.fn_arg_width_char(fslot, ai), s);
}

// lower_fn_value_arg_wc is lower_fn_value_arg with the width char already
// resolved, for a callee whose signature comes from a DECLARATION rather than
// from a slot.
function lower_fn_value_arg_wc(a: ast.Expr, wc: string, s: LowerState): LowerState {
    if (wc == "l") { return lower_i64(a, s); }
    if (wc == "d" && !expr_is_f64(a, s) && infer_expr_width(a, s) == 32) {
        var fvs: LowerState = lower_expr(a, s);
        if (!fvs.ok) { return fvs; }
        return fvs.emit(ir.op_i32_to_f64());
    }
    return lower_expr(a, s);
}

// lower_expr emits ops that leave the value of `e` on the operand stack.
// lower_call_named lowers a call whose callee is a bare NAME — a user
// function, a `const`, a builtin, or one of the closure / marker forms.
// `e` is this same call as an Expr, for the two type queries that take one.
// fern-lint: allow cyclomatic-complexity
// 278 guards over 1192 lines — one per intercepted builtin. Splitting the
// table would spread the same list over more functions, not shorten it.
function lower_call_named(e: ast.Expr, c: ast.ExprCall, cid: ast.ExprIdent, s: LowerState): LowerState {
    // Closure-box constructor marker (#2994): lift_inline_closures
    // rewrites a CAPTURING inline lambda in array-element / struct-
    // field-value position to `__mkclo$<cloname>(caps…)`, having
    // hoisted the lambda body to a top-level `<cloname>(__env, …)`.
    // Lower it to the escaping-closure env box — an i32[] [funcval,
    // caps…] — exactly like the `return <lambda>` ExprLambda arm,
    // but with the UNIQUE hoisted name carried in the marker (so a
    // function may host several distinct inline closures, each in
    // its own `$cloN`). `<cloname>` exists in the module (appended
    // by the lift), so const_funcs_only_known keeps the module IR-
    // eligible. The capture args are plain idents → load_local.
    if (cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") {
        var clonm: str = slice_unchecked(cid.name, 8, cid.name.len());
        var mks: LowerState = s.emit(ir.op_const_func(0, clonm));
        for arg in c.args {
            mks = lower_expr(arg, mks);
            if (!mks.ok) { return mks; }
        }
        return mks.emit(ir.op_arr_make(c.args.len() + 1, 32));
    }
    // Indirect call through a function VALUE: `f(args)` where `f`
    // names a local/param slot (a "fn"-typed value), not a
    // top-level function. A local shadows any same-named function,
    // so a resolvable slot means the callee is the value held
    // there. Lower the args, push the function value, then
    // call_indirect (the backend pops the fn pointer from TOS and
    // the args beneath it).
    // Closure-call (slice 3a): the callee is a closure LOCAL — an
    // i32[] env box [funcval, caps…]. Env-first: push the box (the
    // __env first arg), the declared args, then the funcval
    // (box[0]) as the call target, and call_indirect with arity+1
    // to the hoisted `<fn>$clo(__env, params…)`.
    if (s.is_closure_local(cid.name)) {
        var clslot: i32 = s.slot_of(cid.name);
        var cls: LowerState = s.emit(ir.op_load_local(clslot));
        var cla: i32 = 0;
        while (cla < c.args.len()) {
            // A `dyn Trait` param position dyn-boxes its arg (#5276).
            if (s.fn_arg_is_dyn(clslot, cla)) { cls = lower_dyn_arg(c.args[cla], cls); }
            else { cls = lower_fn_value_arg(c.args[cla], clslot, cla, cls); }
            if (!cls.ok) { return cls; }
            cla = cla + 1;
        }
        cls = cls.emit(ir.op_load_local(clslot));
        cls = cls.emit(ir.op_const_i32(0));
        cls = cls.emit(ir.op_arr_get(32));
        return cls.emit(ir.op_call_indirect_sig(c.args.len() + 1, s.fn_value_sig(clslot, true)));
    }
    var icslot: i32 = s.slot_of(cid.name);
    if (icslot >= 0) {
        var ics: LowerState = s;
        var ica: i32 = 0;
        while (ica < c.args.len()) {
            // A `dyn Trait` param position dyn-boxes its arg so the
            // callee's op_dyn_dispatch reads a real shape pointer,
            // not a raw primitive (SIGSEGV otherwise) — #5276.
            if (s.fn_arg_is_dyn(icslot, ica)) { ics = lower_dyn_arg(c.args[ica], ics); }
            else { ics = lower_fn_value_arg(c.args[ica], icslot, ica, ics); }
            if (!ics.ok) { return ics; }
            ica = ica + 1;
        }
        ics = ics.emit(ir.op_load_local(icslot));
        return ics.emit(ir.op_call_indirect_sig(c.args.len(), s.fn_value_sig(icslot, false)));
    }
    // A user-defined free function shadows any same-named
    // builtin: native + interp resolve `name(args)` to the user
    // function when one is declared, so the IR path must too — a
    // user `len` / `exit` / `chr` / … is a real call, not the
    // builtin op (#3710). Gate every builtin-name intercept below
    // on the name NOT being a module function; otherwise fall
    // through to the ordinary direct-call lowering. (When
    // compiling the compiler this is dead — its builtin calls use
    // qualified/mangled names like `util__i32_to_string` — so the
    // byte-identical self-host fixpoint is preserved.)
    if (!s.is_user_fn(cid.name)) {
    // __rc(arr): read the refcount header at base-4 (an RC
    // observation hook for tests; not a real callee).
    if (cid.name == "__rc") {
        if (c.args.len() != 1) { return s.fail(); }
        var sr: LowerState = lower_expr(c.args[0], s);
        if (!sr.ok) { return sr; }
        return sr.emit(ir.op_arr_rc());
    }
    // The RC test hooks come in TWO source spellings: the short
    // one below, and the RUNTIME SYMBOL's own name. The RC test
    // corpus uses the second — the AST emitters accepted it
    // because the helper they emitted happened to be called that —
    // and the IR path knew only the short form, so ~140 uses across
    // the self-host RC tests declined. Two thirds of the entire
    // mode-0 decline set, for a NAME rather than a construct.
    // Neither spelling is natively valid (E001), so these are
    // self-host dialect programs either way; accepting both is what
    // let the AST emitters retire without rewriting the corpus.
    //
    // __rc_dec(a) / __fern_rc_dec(a) / __fern_arr_dec(a): manual
    // release (a hook for exercising the underflow detector);
    // returns the pointer. All three lower to the IR's ONE array
    // release helper — ir_helper_symbol maps __fern_rc_dec to
    // __fn___fern_arr_dec, so `__fern_arr_dec` is a symbol name,
    // not an IR callee name, and emitting it verbatim would fail
    // calls_only_known (which admits only is_fern_helper names).
    if (cid.name == "__rc_dec" || cid.name == "__fern_rc_dec" || (cid.name == "__fern_arr_dec" && c.args.len() == 1)) {
        if (c.args.len() != 1) { return s.fail(); }
        var sd: LowerState = lower_expr(c.args[0], s);
        if (!sd.ok) { return sd; }
        return sd.emit(ir.op_call_direct("__fern_rc_dec", 1));
    }
    // __rc_inc(a) / __fern_rc_inc(a): manual retain; returns the
    // pointer.
    if (cid.name == "__rc_inc" || cid.name == "__fern_rc_inc") {
        if (c.args.len() != 1) { return s.fail(); }
        var si: LowerState = lower_expr(c.args[0], s);
        if (!si.ok) { return si; }
        return si.emit(ir.op_call_direct("__fern_rc_inc", 1));
    }
    // __fern_str_eq(a, b): compare two string BOXES by value, given as raw
    // pointers. The surface `a == b` on two `string`s already lowers to
    // op_str_eq, but a runtime helper written on the raw floor holds its
    // strings as i32 box pointers, where `==` is an integer compare — so
    // there is no other spelling that reaches the comparison. Same shape as
    // the RC hooks above: a RUNTIME SYMBOL accepted as surface syntax, for
    // sources only the self-host compiles.
    //
    // Both operands lower plainly rather than through
    // lower_view_borrowed_parked: that path exists to release borrowed string
    // TEMPORARIES, and a raw pointer is not RC-tracked, so there is nothing
    // parked to free.
    if (cid.name == "__fern_str_eq" && c.args.len() == 2) {
        var seqL: LowerState = lower_expr(c.args[0], s);
        if (!seqL.ok) { return seqL; }
        var seqR: LowerState = lower_expr(c.args[1], seqL);
        if (!seqR.ok) { return seqR; }
        return seqR.emit(ir.op_str_eq());
    }
    // __fern_map_find(keys, key, keykind, eqfn): the map runtime's shared key
    // search, called from __fern_map_delete's body. Same shape as the RC hooks
    // and __fern_str_eq above — a RUNTIME SYMBOL accepted as surface syntax,
    // for sources only the self-host compiles.
    //
    // Unlike those it is a plain call_direct rather than an IR op of its own:
    // is_fern_helper claims the name, so both register backends route it
    // through their helper-call emit and ir_helper_symbol resolves it to the
    // __fn___fern_map_find that asmcore.rt_src_map_find's body defines. The
    // arguments lower in REVERSE, which is what leaves arg0 on top of the
    // operand stack where the stack ABI wants it — the same order n.gcd(m)
    // uses, and the reason this is not written as a left-to-right loop.
    if (cid.name == "__fern_map_find" && c.args.len() == 4) {
        var mf: LowerState = s;
        var ai: i32 = 3;
        while (ai >= 0) {
            mf = lower_expr(c.args[ai], mf);
            if (!mf.ok) { return mf; }
            ai = ai - 1;
        }
        return mf.emit(ir.op_call_direct("__fern_map_find", 4));
    }
    // __rc_underflow_count() / __rc_underflow(): read the
    // over-release counter. `__rc_underflow_count` is the
    // NATIVE spelling (internal/checker/checker.go registers
    // only that one), so it is what a source compiled by both
    // compilers must use — the self-host drivers' own guard
    // does. `__rc_underflow` is the older self-host-only alias
    // that ~730 call sites in internal/e2eselfhost still use;
    // it stays until those migrate. A third spelling,
    // `__fern_rc_underflow_count`, was the RUNTIME symbol
    // leaking into surface syntax; its 187 call sites moved to
    // the native spelling and it is gone.
    if (cid.name == "__rc_underflow_count" || cid.name == "__rc_underflow") {
        if (c.args.len() != 0) { return s.fail(); }
        return s.emit(ir.op_call_direct("__fern_rc_underflow_get", 0));
    }
    // __alloc_u8(n): a fresh n-element byte array (8-byte slots,
    // len = n; contents NOT zeroed). string_from_bytes_unchecked(arr) packs
    // each slot's low byte into a string box. Both lower to a
    // dedicated op the IR backends emit as the same __fern_* call
    // the AST path uses.
    if (cid.name == "__alloc_u8" && c.args.len() == 1) {
        var au: LowerState = lower_expr(c.args[0], s);
        if (!au.ok) { return au; }
        return au.emit(ir.op_alloc_u8());
    }
    // __alloc(n): bump-alloc n raw bytes, push the usize pointer (the
    // core/map runtime's allocator). op_alloc is the bare-pointer
    // sibling of op_alloc_u8 (which builds an array box) — both call
    // the backend's __fern_alloc.
    if (cid.name == "__alloc" && c.args.len() == 1) {
        var al: LowerState = lower_expr(c.args[0], s);
        if (!al.ok) { return al; }
        return al.emit(ir.op_alloc());
    }
    // __ptr_width(): the target's heap-pointer width in bytes (8 on
    // x86-64 / arm64, 4 on wasm32). Backend-resolved so wasm32's
    // pointer arithmetic uses 4, not a baked-in 8.
    if (cid.name == "__ptr_width" && c.args.len() == 0) {
        return s.emit(ir.op_ptr_width());
    }
    // __memset(dst, byte, n): fill n bytes at dst with `byte`'s low
    // byte (core/map's bucket init). Lower dst, byte, n then emit
    // op_memset (rep stosb / byte loop / memory.fill); pushes dummy 0.
    if (cid.name == "__memset" && c.args.len() == 3) {
        var ms3: LowerState = lower_expr(c.args[0], s);
        if (!ms3.ok) { return ms3; }
        ms3 = lower_expr(c.args[1], ms3);
        if (!ms3.ok) { return ms3; }
        ms3 = lower_expr(c.args[2], ms3);
        if (!ms3.ok) { return ms3; }
        return ms3.emit(ir.op_memset());
    }
    // __free(ptr, size): a no-op under the bump/leak heap (core/map's
    // grow path). Lower both args (no side effects), emit op_free,
    // which discards them and pushes dummy 0 (statement-position).
    if (cid.name == "__free" && c.args.len() == 2) {
        var fr: LowerState = lower_expr(c.args[0], s);
        if (!fr.ok) { return fr; }
        fr = lower_expr(c.args[1], fr);
        if (!fr.ok) { return fr; }
        return fr.emit(ir.op_free());
    }
    // __fern_arr_dec(v, stride) / __fern_drop_arr_ptr(v, stride):
    // core/map's value-release helpers. The self-host backends keep
    // these NO-OPS (safe-leak mode — the array rc-header layout
    // migration that would wire in real frees isn't done; the native
    // backend does real RC, goal #2 ports it). Lower as a no-op that
    // consumes both args and pushes a dummy 0 (reusing op_free's
