// examples/self_host/irlower.fern — AST -> stack-IR lowering for the
// self-hosted compiler (see docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md), plus a
// stack-machine interpreter that evaluates the lowered Op[] so lowering is
// checkable end-to-end WITHOUT a backend (mirrors how ssa.fern validates its
// builder with an SSA interpreter).
//
// The lowering is a textbook stack-machine emit: an expression lowers to ops
// that PUSH its value (operands first, then the operator), a `var` binds the
// next local slot and stores into it, `return` lowers its value then emits
// `return`. Params occupy slots 0..n_params-1.
//
// Coverage is the whole language — control flow, calls, closures, strings,
// floats, composites, generics, traits. `lower_func` returning ok=false is a
// BUG REPORT, not a routine fallback: there is no AST emitter left behind it
// (all three were deleted; see docs/SELFHOST-AST-RETIREMENT.md), so every
// backend routes IR-or-error and a bail is a diagnostic naming the bail site
// under FERN_STRICT_IR=1.
//
// Three concerns are threaded through the lowering, and knowing which one you
// are looking at is most of reading this file:
//   - TYPE tracking — LocalInfo per slot and FnSigs per module, together
//     deciding which opcode a value's operations select (str_len vs arr_len,
//     8-byte vs 4-byte element loads, env-first vs direct call dispatch);
//   - OWNERSHIP — the Perceus refcounting: where inc/dec land, which values
//     are fresh and sole-owned (so a drop may reclaim them) versus borrowed
//     or a zero-copy view (where a drop would over-release);
//   - CONTROL — the structured block/loop/if nesting that br-depths index.

import "./ast";
import "./ir";
import "./irverify";
import "./parser";
import "./util";
import "./astwalk";

// LocalInfo is the per-local-slot type record — one entry per slot, indexed by
// slot number. Everything here answers "what does this slot hold?", which is
// what selects the opcode a use of the slot lowers to.
pub struct LocalInfo {
    slot_name: string,
    // is_arr: an array value. The one flag here that drives RC as well as
    // dispatch — a new reference to an array must retain it (the Perceus
    // alias-inc).
    is_arr: boolean,
    // is_str: a string value. Dispatch only (str_len vs arr_len, str_concat vs
    // add, str_eq vs eq) — strings are not reference-counted.
    is_str: boolean,
    // is_strarr: a string[] — the element-typing overlay on is_arr, which still
    // drives the array's RC. Makes arr[i] type as a string.
    is_strarr: boolean,
    // strarr_builtin: this string[] slot was bound from a BUILTIN string
    // producer (`s.split(sep)` / `s.lines()`), whose elements the runtime
    // creates and stores nowhere else. Set at the binding site, the only place
    // that knows the receiver is a string — the reclaim collector sees names,
    // not types, and a user method named `split` on another type would
    // otherwise answer for this one.
    strarr_builtin: boolean,
    // str_view_local: this string slot may hold a fresh BOX over ANOTHER
    // string's bytes — `<string>.trim()`, or a chain of SFRRECV string methods
    // that can return a `slice_unchecked` view. The box is this frame's; the
    // data is not. Picks
    // __fern_str_view_free over __fern_str_free at the release sites, which
    // frees the box alone when the rc is the immortal view sentinel and takes
    // the ordinary path otherwise (wasm's slices copy).
    str_view_local: boolean,
    // str_identity_src: the slot this binding's box may turn out to BE, or -1
    // when the binding always owns a box of its own. Two producers record it:
    // `<string>.replace(old, new)`, whose identity fast-path hands the receiver's
    // own box back when the needle is absent (measured at zero bytes allocated),
    // and an SFRRECV method chain, whose every link may return its receiver
    // (sfrrecv_chain_root_slot resolves the root). Such a result is releasable
    // only behind a guard that the two are different pointers.
    str_identity_src: i32,
    // reclaim_site: the BINDING-SITE key ("name@line:col") of the `var` that
    // created this slot, or "" for a slot no StmtVar bound (a param, a temporary,
    // a loop variable). The tuple class credits are keyed on it rather than on the
    // name, so two same-named tuple locals in sibling blocks resolve to their own
    // credit instead of sharing one — #7272, where sharing handed one slot both
    // the "TUP:" shallow dec and the "TUPRCS:" deep free and released its box
    // twice. Unlike the name it also survives retire_locals' block-exit rename.
    reclaim_site: string,
    // struct_type: the slot's struct type name ("" = not a struct), so `p.x`
    // resolves x's field index in p's decl.
    struct_type: string,
    // opt_type: the slot's Option[T] / Result[T, E] spelling ("" = neither), so
    // a `match (r)` on a local recovers the bound payload type the same way a
    // direct-call scrutinee uses FnSigs.opt_ret_fns.
    opt_type: string,
    // tuple_elems: the slot's tuple element-type tags, comma-joined (e.g.
    // "string,i32,Point"), "" if not a tuple. Lets `t.N` and tuple destructuring
    // recover each element's type.
    tuple_elems: string,
    // tuple_type: the slot's DECLARED tuple spelling ("((f64) => f64, i32)"),
    // "" when the binding had none to record. tuple_elems is derived from this
    // and is lossy on purpose — a fn element coarsens to the "clo" dispatch tag,
    // which is what every element consumer wants and is not enough to name the
    // funcref a call through that element dispatches on. Keeping the
    // declaration is what lets `t.N(args)` build a real signature instead of
    // re-deriving one (#5986).
    tuple_type: string,
    // fnarr_elem: for a slot bound to an ARRAY of fn values, the DECLARED
    // ELEMENT spelling ("(f64) => f64"), "" when the binding recorded none.
    // The tuple_type of arrays: parse_type_name coarsens the annotation to the
    // flat "fn[]" tag, so an element's dispatch tag cannot name the funcref a
    // call through `fs[0](x)` goes out on. Rebuilt from StmtVar's fn_ret /
    // fn_param_types sidecars rather than re-derived from the initializer
    // (#5986).
    fnarr_elem: string,
    map_type: string,
    // is_i64: an i64 value — drives i64 instruction selection and wasm i64 local
    // typing. i32 is the default.
    is_i64: boolean,
    // is_f64: an f64 value — arithmetic and comparison use the float registers.
    // The slot is an 8-byte bit pattern like any other; only the ops differ.
    is_f64: boolean,
    // is_f32: an f32 value. STORED as an 8-byte f64 (so is_f64 is set too, and
    // storage/arith/compare are the f64 ops), but tracked distinctly because
    // method dispatch keys "f32.<m>" — `to_string` / `to_json` differ in
    // precision. expr_recv_prim_type returns "f32" when this is set.
    is_f32: boolean,
    // is_f64arr: an f64[] — an element-WIDTH overlay on is_arr. a[i] reads an
    // 8-byte f64 and an f64 array literal allocates an 8-byte stride. Only the
    // wasm backend needs steering; the register backends already use 8-byte
    // element slots.
    is_f64arr: boolean,
    // is_f32arr: an f32[]. DISPATCH-ONLY, like is_bool / is_boolarr: an f32[]
    // rides the SAME 8-byte slot and stride as an f64[] here (is_f64arr is set
    // too, and is_float_array_type_name deliberately maps both spellings onto
    // it), so no width, stride or rc decision reads this. What it buys is that
    // `a[i]` types as an f32 rather than an f64, so a method on the element
    // keys "f32.<m>": without it `a[0].to_string()` on an f32[] rendered at
    // f64 precision (19.634937286376953 for a value native prints 19.634937),
    // while the same value in a SCALAR f32 local rendered correctly — two
    // spellings of one value disagreeing. The stored element is already
    // f32-rounded; only the rendering was wrong. The 8-byte stride itself is
    // a separate, deliberate divergence from native (#4366).
    is_f32arr: boolean,
    // is_i64arr: an i64[]. Like is_f64arr an 8-byte stride, but a[i] reads an
    // i64 and types as i64 (flowing through lower_i64).
    is_i64arr: boolean,
    // is_bool: a boolean SCALAR. Like is_boolarr below, DISPATCH-ONLY — a
    // boolean is an i32 value in an i32 slot, and nothing about its storage,
    // width or rc differs. It exists so a method on a boolean local keys
    // "boolean.<m>": without it `var ok = true; ok.to_json()` rendered `1`,
    // and so did the `for b in bs` loop variable over a boolean[], which
    // disagreed with the `bs[i]` spelling of the same read (#6305).
    is_bool: boolean,
    // is_boolarr: a boolean[]. Unlike its is_strarr / is_f64arr / is_i64arr
    // siblings this is DISPATCH-ONLY — a boolean rides the same i32 slot and the
    // same 4-byte element stride, so no width, stride or rc decision reads it.
    // What it buys is that `a[i]` types as a boolean rather than i32, so a
    // method on it keys "boolean.<m>": without it `bs.to_json()` rendered
    // `[1,0]` instead of `[true,false]`, because the per-element `arr[i].to_json()`
    // the array serialiser desugars to dispatched i32's impl (#6117).
    is_boolarr: boolean,
    // is_closurearr: an array of closure BOXES. a[i] yields a box, so a local
    // bound from such an element is marked a closure local and `c()` unpacks the
    // box instead of calling the raw pointer as a table index (which traps).
    is_closurearr: boolean,
    // is_fnarr: an array of BARE named-function values (`(() => T)[]`), as
    // opposed to is_closurearr's boxes — deliberately separate, because these
    // call through the plain call_indirect path, not env-first. The distinction
    // bites at `.append(f)`: a bare 0-arg fn name appended to such a slot is a
    // fn POINTER (const_func), not a `const`-style call. Without the flag the
    // appended `f` const-calls and stores its RESULT, so `fns[i]()` segfaults.
    is_fnarr: boolean,
    // is_arrarr: an array-of-arrays (`i32[][]`, `string[][]`, …), one nesting
    // level. Its element is itself an array, so a local bound from `a[i]` — or
    // the loop var of `for row in a` — is marked is_arr. A plain `row[i]` /
    // `row.len()` works without the flag; only ITERATING or re-binding the inner
    // array needs it.
    is_arrarr: boolean,
    // arrarr_elem: the INNER element kind of a T[][] slot — "i64" / "f64" (the
    // 8-byte kinds) or "" (i32/string). is_arrarr records only THAT a slot is
    // array-of-arrays, so without this a nested read a[i][j] could not recover
    // the inner width and truncated an i64/f64 element to 32 bits.
    arrarr_elem: string,
    // is_u32: a u32 scalar OR a u32[] (disambiguated by is_arr). Drives u32
    // WRAPPING — arithmetic masks to 32 bits on the register backends and `>>`
    // lowers to a LOGICAL shift. Native wraps every u32 op at 2^32; without this
    // the self-host kept 64-bit results, so u32-heavy code (the SHA-256 schedule,
    // __rotr's `x << (32-n)`) accumulated stray high bits.
    is_u32: boolean,
    // is_u64: a u64 scalar OR a u64[]. Lives in the i64 64-bit domain (is_i64 is
    // set too) but UNSIGNED: compares, `>>`, `/` and `%` select the unsigned ops,
    // which the signed ones get wrong once bit 63 is set. No wrap step — i64
    // ops are already full-width, only signedness differs.
    is_u64: boolean,
    // subword: the sub-32-bit integer kind ("u8"), or "" if not one; for a u8[]
    // slot it holds the ELEMENT kind (disambiguated by is_arr). Drives the
    // post-arithmetic WIDTH WRAP — a u8 `+`/`-`/`*`/`<<` whose result can exceed
    // the width is masked back via an int_cast, matching the interpreter's
    // per-width wrap (`255u8 + 1 == 0`). The u32 sibling is is_u32.
    subword: string,
    // is_cell / cell_elem: a Cell[T] slot (#5510). A Cell is lowered as a
    // 1-element array of T, so cell_new(v) -> [v], c.get() -> c[0], c.set(x)
    // -> c[0]=x — reusing the array machinery on every backend. cell_elem is
    // T (the element type spelling), for the array element width.
    is_cell: boolean,
    cell_elem: string,
    // str_own: the OWNERSHIP class of the string box an is_str slot holds --
    // the slot-carried fact of #4297 CS4 (the self-host mirror of native
    // ast.Ownership; docs/OWNERSHIP-TYPES-PLAN.md). Codes mirror
    // str_producer_ownership: 0 = Owned (this slot holds the owning
    // reference to a fresh rc box), 1 = Borrowed (an owner elsewhere -- a
    // caller, a container, another local -- holds it), 2 = View (an immortal
    // rc=-1 box sharing another buffer, #4294), 3 = Static (interned
    // .rodata literal). Seeded at the binding (lower_var / if-let / match
    // payload) from str_binding_ownership; every unproven slot -- params,
    // container-element binders, non-string slots -- stays at the DEFAULT 1
    // (Borrowed), the conservative never-free class, matching the
    // `i >= n_params` params-are-borrowed rule the reclaim heuristics
    // already assume. Read via str_expr_ownership / str_own_slot; no
    // codegen decision consults it yet (CS4 is behaviour-identical -- the
    // consumers are CS3/#4355 and the reuse-analysis slice). Meaningless
    // (inert 1) on a non-string slot.
    // fn_dyn / fn_sig / fn_ret / fn_opt_ret: the fn-VALUE sidecars (#5276/#6282/
    // #6862/#3457) for a slot holding a function value — the dyn-boxed argument
    // positions, the funcref width tag wasm validates against, the declared
    // return spelling lower_i64 widens by, and the Option/Result return a
    // `match (f(x))` scrutinee recovers its payload type from. All "" for a slot
    // that is not a fn value.
    //
    // On the SLOT rather than in a name-keyed side table (#7253). The read sites
    // resolve the callee with slot_of, which scans backward and answers with the
    // innermost binding of a spelling; the side tables were scanned forward and
    // answered with the outermost. The two were used in ONE expression — the
    // operand came from the inner binding and the funcref type from the outer —
    // so under any shadow they were guaranteed to disagree. That is #6191 /
    // #6283's defect class, which each got a hand-guard at its own site.
    fn_dyn: string,
    fn_sig: string,
    fn_ret: string,
    fn_opt_ret: string,
    str_own: i32,
    // str_caller_elem: an is_str slot holding an ELEMENT of a caller-owned
    // string[] — a parameter's element read directly (`var e = p[i]`, `for e
    // in p`) or through another such local. The caller frees that array deep,
    // so a container storing the element takes a second owner and the store
    // has to be counted; the reclaim walkers cannot see across the call to
    // withhold the caller's free the way they withhold a local array's.
    str_caller_elem: boolean,
    // borrowed_arr: an is_arr slot that holds a BORROWED buffer whose owner is
    // some other live value, so the exit dec-sweep must not release it. Set at
    // the only binding form that reads a buffer straight out of a live box
    // without a Perceus dup: a match arm's ENUM-PAYLOAD array binding
    // (`RSeq(xs) => …`, `Items(ps) => …`). The enum box owns that buffer and is
    // itself never swept (the IR leak-mode invariant), so the binding is a pure
    // borrow: sweeping it decs a live buffer once per call, and the box's own
    // payload pointer dangles as soon as the count reaches 0. #6049: std/regex's
    // `__rx_match` binds `RSeq(xs)` / `RAlt(xs)` and is re-entered once per scan
    // position, so the second call freed the parse tree's child array and the
    // freelist handed the block straight back to the next allocation.
    // A CONSUMING match still reclaims the payload — it reads it back out of the
    // box's own slot (emit_enum_variant_drops_gated), never through this binding.
    borrowed_arr: boolean,
    // moved_claim: a borrowed_arr binding that IS the box's counted reference
    // rather than a borrow of it, because the box is one this frame built and
    // no owner of the buffer outlives the call (scrutinee_owns_no_surviving_claim).
    // borrowed_arr still holds — the slot stays out of the exit sweep — but the
    // premise it is usually read with, "the box keeps its reference", does not:
    // whether by the consuming match's moved-payload skip or by there being no
    // release at all, no dec of that field survives this frame. A return of such
    // a binding therefore takes NO transfer retain; retaining it leaves a second
    // claim with nothing to release it (#8070).
    moved_claim: boolean,
}

// li_new(name) — a fresh local slot (defaults: every flag false, every type "").
pub function li_new(name: string): LocalInfo {
    return LocalInfo { slot_name: name, is_arr: false, is_str: false, is_strarr: false, strarr_builtin: false, str_view_local: false, str_identity_src: 0 - 1, reclaim_site: "", struct_type: "", opt_type: "", tuple_elems: "", tuple_type: "", fnarr_elem: "", map_type: "", is_i64: false, is_f64: false, is_f32: false, is_f64arr: false, is_f32arr: false, is_i64arr: false, is_bool: false, is_boolarr: false, is_closurearr: false, is_fnarr: false, is_arrarr: false, arrarr_elem: "", is_u32: false, is_u64: false, subword: "", is_cell: false, cell_elem: "", fn_dyn: "", fn_sig: "", fn_ret: "", fn_opt_ret: "", str_own: 1, str_caller_elem: false, borrowed_arr: false, moved_claim: false };
}

pub function li_set_str_caller_elem(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, str_caller_elem: v };
}

