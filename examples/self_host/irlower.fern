        var ra: LowerState = lower_expr(c.args[0], s);
        if (!ra.ok) { return ra; }
        return ra.emit(ir.op_raw_alloc());
    }
    if (cid.name == "__raw_store8" && c.args.len() == 3) {
        var rs0: LowerState = lower_expr(c.args[0], s);
        if (!rs0.ok) { return rs0; }
        var rs1: LowerState = lower_expr(c.args[1], rs0);
        if (!rs1.ok) { return rs1; }
        var rs2: LowerState = lower_expr(c.args[2], rs1);
        if (!rs2.ok) { return rs2; }
        return rs2.emit(ir.op_raw_store8());
    }
    if (cid.name == "__raw_load8" && c.args.len() == 2) {
        var rl0: LowerState = lower_expr(c.args[0], s);
        if (!rl0.ok) { return rl0; }
        var rl1: LowerState = lower_expr(c.args[1], rl0);
        if (!rl1.ok) { return rl1; }
        return rl1.emit(ir.op_raw_load8());
    }
    if (cid.name == "__raw_store_ptr" && c.args.len() == 3) {
        var rps0: LowerState = lower_expr(c.args[0], s);
        if (!rps0.ok) { return rps0; }
        var rps1: LowerState = lower_expr(c.args[1], rps0);
        if (!rps1.ok) { return rps1; }
        var rps2: LowerState = lower_expr(c.args[2], rps1);
        if (!rps2.ok) { return rps2; }
        return rps2.emit(ir.op_raw_store_ptr());
    }
    if (cid.name == "__raw_load_ptr" && c.args.len() == 2) {
        var rlp0: LowerState = lower_expr(c.args[0], s);
        if (!rlp0.ok) { return rlp0; }
        var rlp1: LowerState = lower_expr(c.args[1], rlp0);
        if (!rlp1.ok) { return rlp1; }
        return rlp1.emit(ir.op_raw_load_ptr());
    }
    if (cid.name == "__raw_string" && c.args.len() == 2) {
        var rst0: LowerState = lower_expr(c.args[0], s);
        if (!rst0.ok) { return rst0; }
        var rst1: LowerState = lower_expr(c.args[1], rst0);
        if (!rst1.ok) { return rst1; }
        return rst1.emit(ir.op_raw_string());
    }
    // __syscall3(nr, a1, a2, a3) — the syscall sub-floor (#2649).
    // Lower the four args left-to-right, then the single-instruction
    // syscall op. Only the audited syscall-leaf helpers use it.
    if (cid.name == "__syscall3" && c.args.len() == 4) {
        var sc0: LowerState = lower_expr(c.args[0], s);
        if (!sc0.ok) { return sc0; }
        var sc1: LowerState = lower_expr(c.args[1], sc0);
        if (!sc1.ok) { return sc1; }
        var sc2: LowerState = lower_expr(c.args[2], sc1);
        if (!sc2.ok) { return sc2; }
        var sc3: LowerState = lower_expr(c.args[3], sc2);
        if (!sc3.ok) { return sc3; }
        return sc3.emit(ir.op_syscall3());
    }
    // __raw_environ() — the process envp pointer (#2649 env slice).
    if (cid.name == "__raw_environ" && c.args.len() == 0) {
        return s.emit(ir.op_raw_environ());
    }
    // __raw_arr_box(n) — a fresh n-element array box's data pointer (#2649).
    // The rc header, length and capacity are written by __fern_arr_box; the
    // caller fills element i with __raw_store_ptr(p, i + 1, v).
    if (cid.name == "__raw_arr_box" && c.args.len() == 1) {
        var ab0: LowerState = lower_expr(c.args[0], s);
        if (!ab0.ok) { return ab0; }
        return ab0.emit(ir.op_raw_arr_box());
    }
    // __raw_data(s) — a live string's DATA pointer (#2649), the inverse of
    // __raw_string and the last thing blocking tcp_send. It needs no op of its
    // own: a string value already IS its box pointer, and the data word is slot
    // 0 of that box, so this is raw_load_ptr(s, 0) — the same read __raw_string
    // wrote. Only the checker had to be convinced the string is addressable.
    if (cid.name == "__raw_data" && c.args.len() == 1) {
        var rd0: LowerState = lower_expr(c.args[0], s);
        if (!rd0.ok) { return rd0; }
        var rd1: LowerState = rd0.emit(ir.op_const_i32(0));
        return rd1.emit(ir.op_raw_load_ptr());
    }
    // __raw_array(ptr) — the type-only bridge back to a typed array (#2649),
    // the array sibling of __raw_string. It emits NOTHING: the data pointer
    // already IS the array value, so only the checker needed convincing.
    if (cid.name == "__raw_array" && c.args.len() == 1) {
        return lower_expr(c.args[0], s);
    }
    // __raw_addr(ptr, off) — pointer + offset at full machine width (#2649).
    // Written as `p + off` this would be i32 arithmetic, which arm64 narrows
    // back to 32 bits; the op keeps the whole address.
    if (cid.name == "__raw_addr" && c.args.len() == 2) {
        var ra0: LowerState = lower_expr(c.args[0], s);
        if (!ra0.ok) { return ra0; }
        var ra1: LowerState = lower_expr(c.args[1], ra0);
        if (!ra1.ok) { return ra1; }
        return ra1.emit(ir.op_raw_addr());
    }
    // __syscall4(nr, a1, a2, a3, a4) — the 4-arg sub-floor sibling.
    if (cid.name == "__syscall4" && c.args.len() == 5) {
        var s40: LowerState = lower_expr(c.args[0], s);
        if (!s40.ok) { return s40; }
        var s41: LowerState = lower_expr(c.args[1], s40);
        if (!s41.ok) { return s41; }
        var s42: LowerState = lower_expr(c.args[2], s41);
        if (!s42.ok) { return s42; }
        var s43: LowerState = lower_expr(c.args[3], s42);
        if (!s43.ok) { return s43; }
        var s44: LowerState = lower_expr(c.args[4], s43);
        if (!s44.ok) { return s44; }
        return s44.emit(ir.op_syscall4());
    }
    // __syscall5(nr, a1, a2, a3, a4, a5) — the 5-arg sub-floor sibling.
    if (cid.name == "__syscall5" && c.args.len() == 6) {
        var s50: LowerState = lower_expr(c.args[0], s);
        if (!s50.ok) { return s50; }
        var s51: LowerState = lower_expr(c.args[1], s50);
        if (!s51.ok) { return s51; }
        var s52: LowerState = lower_expr(c.args[2], s51);
        if (!s52.ok) { return s52; }
        var s53: LowerState = lower_expr(c.args[3], s52);
        if (!s53.ok) { return s53; }
        var s54: LowerState = lower_expr(c.args[4], s53);
        if (!s54.ok) { return s54; }
        var s55: LowerState = lower_expr(c.args[5], s54);
        if (!s55.ok) { return s55; }
        return s55.emit(ir.op_syscall5());
    }
    // __raw_scratch(n) — fixed static scratch buffer ptr (#2649).
    if (cid.name == "__raw_scratch" && c.args.len() == 1) {
        var rsc: LowerState = lower_expr(c.args[0], s);
        if (!rsc.ok) { return rsc; }
        return rsc.emit(ir.op_raw_scratch());
    }
    // Built-in `exit(n)` — terminate the process with exit code n
    // (an inline sys_exit / proc_exit per backend).
    if (cid.name == "exit" && c.args.len() == 1) {
        var xs: LowerState = lower_expr(c.args[0], s);
        if (!xs.ok) { return xs; }
        return xs.emit(ir.op_exit());
    }
    // Built-in `len(x)` — the free-function spelling of `.len()`:
    // a string reads the box's length field (str_len), an array
    // the header (arr_len). Mirrors the `.len()` method dispatch
    // below; `len` is a reserved builtin (handled by name like
    // map_new / Some / Ok), so this never shadows a user function.
    if (cid.name == "len" && c.args.len() == 1) {
        var lstr: boolean = expr_is_str(c.args[0], s);
        var lvst: ArgStash = lower_view_borrowed_parked(c.args[0], s);
        var ls: LowerState = lvst.state;
        if (!ls.ok) { return ls; }
        if (lstr) { return free_parked_view_after(ls.emit(ir.op_str_len()), lvst.slot); }
        return ls.emit(ir.op_arr_len());
    }
    // String builtin free calls — `str_split(s, sep)` and the
    // predicates `str_starts_with` / `str_ends_with` /
    // `str_index_of(s, x)` — are the same ops as the `.split` /
    // `.starts_with` / … method forms, so they route through
    // lower_str_method (field = the name minus its `str_` prefix).
    var sfreef: string = str_free_call_field(cid.name);
    if (sfreef != "" && c.args.len() == str_method_argc(sfreef) + 1) {
        // Free-call form: receiver is the first positional arg, the
        // rest are the method args. Hand both to the shared
        // lower_str_method (the `.<field>()` method-form lowerer).
        var mfargs: ast.Expr[] = [];
        var mfi: i32 = 1;
        while (mfi < c.args.len()) { mfargs = mfargs.append(c.args[mfi]); mfi = mfi + 1; }
        return lower_str_method(sfreef, c.args[0], mfargs, s);
    }
    } // end builtin-name intercepts (skipped when cid.name is a user function)
    // No arity cap: the call ABI is fully stack-based on every
    // backend (x86-64/arm64 push the args on the runtime stack and
    // the callee reads param[i] from a fixed frame offset; wasm
    // passes them on the operand stack), and the function-entry
    // param copy is a count-agnostic loop. So a call of any arity
    // lowers exactly as the retired AST path did.
    return lower_call_named_generic(e, c, cid, s);
}

// The generic direct-call lowering: everything reached once the builtin-name
// intercepts above have declined the callee. Lowers the arguments, brackets the
// ones a callee may grow or free, emits the call, and releases what it retained.
function lower_call_named_generic(e: ast.Expr, c: ast.ExprCall, cid: ast.ExprIdent, s: LowerState): LowerState {
    var sc: LowerState = s;
    var ai: i32 = 0;
    var lat_slots: i32[] = [];
    var laa_slots: i32[] = [];
    var lca_slots: i32[] = [];
    var lsl_slots: i32[] = [];
    while (ai < c.args.len()) {
        // A bare function-name argument at a "fn"-typed param
        // position is a function VALUE (a function pointer):
        // const_func, not a call. Type-directed — distinguishes a
        // function value from a `const` reference (both are bare
        // idents naming a zero-arg-shaped function).
        var fvn: string = fn_value_arg_name(c.args[ai], sc);
        // An array LITERAL at a `dyn Trait[]` param — the third coercion site
        // (#6906). Only the literal form: every other argument is an
        // already-built array whose elements were coerced where it was built.
        var dynlit: boolean = false;
        if (sc.callee_param_is_dyn_arr(cid.name, ai)) {
            match (c.args[ai]) { ast.ExprArray(_) => { dynlit = true; }, _ => {} }
        }
        if (fvn.len() > 0 && sc.callee_param_is_fn(cid.name, ai)) {
            sc = sc.emit(ir.op_const_func(0, fvn));
        } else if (dynlit) {
            match (c.args[ai]) {
                ast.ExprArray(dla) => { sc = lower_dyn_array_lit(dla, sc); },
                _ => {}
            }
        } else if (sc.callee_param_is_dyn(cid.name, ai)) {
            // A primitive/string arg coerced into a `dyn Trait`
            // param: lower the value, then heap-box it into a `dyn`
            // cell [shape@0, value@8] so the receiver carries a
            // shape pointer (docs/DYN-TRAITS.md §4.2.3). A struct/
            // enum value already carries its shape (prim type ""),
            // so it flows unboxed as the `dyn` pointer directly.
            sc = lower_dyn_arg(c.args[ai], sc);
        } else if (sc.param_is_i64(cid.name, ai)) {
            // An argument bound to an i64 param must be lowered as
            // an i64 value (so an i64 literal / i32 source widens).
            sc = lower_i64(c.args[ai], sc);
        } else if (sc.param_is_f64(cid.name, ai)
                   && !expr_is_f64(c.args[ai], sc)
                   && infer_expr_width(c.args[ai], sc) == 32) {
            // An INTEGER argument bound to an f64 param: lower it
            // as i32 then convert. `addhalf(3)` at
            // `addhalf(x: f64)` previously pushed a raw i32 and
            // wasm rejected the module ("type mismatch: expected
            // f64, found i32"); the register backends took the
            // same untyped path. Guarded on width 32 so an i64
            // argument (which would need a different conversion)
            // is left to the existing path rather than silently
            // narrowed. #4801.
            sc = lower_expr(c.args[ai], sc);
            if (!sc.ok) { return sc; }
            sc = sc.emit(ir.op_i32_to_f64());
        } else if (sc.callee_param_is_typevar(cid.name, ai)
                   && !expr_is_f64(c.args[ai], sc) && infer_expr_width(c.args[ai], sc) == 64) {
            // A 64-bit (i64/u64) argument at a BARE-TYPEVAR
            // (erased-generic) param: lower as an i64 value — the
            // erased slot is a full 8-byte cell on the register
            // backends and the value only ever MOVES through it
            // (no arithmetic can touch an opaque T), so the width
            // survives pass-through. On wasm the erased param is
            // typed i64 too (#5464), so the i64 value matches directly.
            sc = lower_i64(c.args[ai], sc);
        } else if (sc.for_wasm() && sc.callee_param_is_erased_widened(cid.name, ai)
                   && expr_is_f64(c.args[ai], sc)) {
            // An f64 argument at a wasm erased (i64) param of a
            // WIDENED pass-through fn (flag '6'): reinterpret the f64
            // bit pattern as i64 so it rides the uniform 8-byte slot
            // (op_f64_bits — a no-op on the register backends, which
            // never reach here). #5464.
            sc = lower_expr(c.args[ai], sc);
            if (!sc.ok) { return sc; }
            sc = sc.emit(ir.op_f64_bits());
        } else if (sc.for_wasm() && sc.callee_param_is_erased_widened(cid.name, ai)) {
            // An i32 / pointer (string/array/struct) argument at a
            // wasm erased (i64) param of a WIDENED pass-through fn:
            // zero-extend to i64. wasm32 pointers are 32-bit, so the
            // low 32 bits round-trip losslessly; the caller wraps the
            // i64 result back. A non-widened erased param (flag '5' —
            // fold-style body, container return) keeps its i32 arg
            // via the else below. #5464.
            sc = lower_expr(c.args[ai], sc);
            if (!sc.ok) { return sc; }
            sc = sc.emit(ir.op_int_extend(true));
        } else {
            sc = lower_expr(c.args[ai], sc);
            // #4355 slices 6+7: a string-LITERAL arg allocates a
            // fresh 16-byte rc-headered box per evaluation
            // (const_str; the .rodata data is heap-guard-skipped),
            // and a fresh ANONYMOUS string temp arg — a concat
            // `f(a + "x")`, a producer `f(chr(n))`, a copying
            // method `f(s.to_upper())` (is_fresh_str_temp, which
            // type-gates via expr_is_str and excludes aliasing
            // shapes: bare idents / fields / slices) —
            // allocates a fresh buffer + box nothing frees. At a
            // BORROWABLE param position of a known free function
            // the callee cannot retain or return it, so the box is
            // dead the moment the call returns: stash it
            // (store+reload keeps the arg in place) and free it
            // right after the call — the call-arg sibling of the
            // #2649 concat-operand anonymous-temp reclaim.
            var lst: ArgStash = stash_fresh_str_arg(sc, c.args[ai], cid.name, ai);
            sc = lst.state;
            if (lst.slot >= 0) { lat_slots = lat_slots.append(lst.slot); }
            // #4365 stage (b): a fresh SCALAR-element array-literal
            // arg (`f([i, i+1])`, discardable_scalar_arr_lit — a
            // rc=1 sole-owned single-level buffer, never bound or
            // aliased) at a BORROWABLE param position is dead the
            // moment the call returns, exactly like the string
            // temps above: stash it and __fern_rc_dec (the
            // rc-guarded array release — __fn___fern_arr_dec /
            // $__fern_arr_dec per backend, freelist-returning at
            // rc==1) right after the call. Pointer-element
            // literals (string / nested-array / struct elements)
            // stay excluded — a shallow buffer free would leak
            // their element boxes; they keep today's safe leak.
            var arrlit_arg: boolean = false;
            if (sc.ok) {
                match (c.args[ai]) {
                    // An EMPTY literal holds nothing a shallow dec could strand,
                    // whatever its element type: `fold(items, [])`'s seed.
                    ast.ExprArray(laa) => { arrlit_arg = laa.elements.len() == 0 || discardable_scalar_arr_lit(laa, sc); },
                    // A scalar-array PRODUCER CALL (`size(mk(i))`) is the same
                    // temp one step removed: the "ARR:" registry proves every
                    // return is a sole-owned buffer this frame allocated, and
                    // "ARROWN:" (#7259) that every return leaves the caller
                    // owning one reference — an accumulator handed back
                    // (`has(targets(xs, []), v)`), which no slot ever sweeps.
                    // Both are scalar-element by admission, so the shallow dec
                    // below is complete. A local shadowing the callee's name is
                    // refused: the registries are keyed by declaration.
                    ast.ExprCall(lac) => {
                        match (lac.callee) {
                            ast.ExprIdent(lacid) => {
                                arrlit_arg = (util.index_of_str(sc.sigs.return_fresh_struct_ret_fns, "ARR:" + lacid.name) >= 0
                                        || (util.index_of_str(sc.sigs.return_fresh_struct_ret_fns, "ARROWN:" + lacid.name) >= 0
                                            && is_leaksafe_array_field(sig_reg_value_of(sc.sigs.ret_type_fns, lacid.name))))
                                    && sc.slot_of(lacid.name) < 0;
                                // A "STRARR:" producer — a POINTER-element array
                                // — is stashable only at a COUNTED-RETAIN
                                // position. The release here is a shallow buffer
                                // dec, which at a borrowable position would
                                // strand the element boxes (the exclusion above);
                                // at a counted-retain one the callee's
                                // construction has retained the array, so the dec
                                // takes rc 2 -> 1 and the callee's own drop
                                // deep-frees the elements it now owns.
                                if (!arrlit_arg
                                    && util.index_of_str(sc.sigs.return_fresh_struct_ret_fns, "STRARR:" + lacid.name) >= 0
                                    && sc.slot_of(lacid.name) < 0
                                    && arr_param_counted_at(sc.sigs.param_counted, cid.name, ai)) { arrlit_arg = true; }
                            },
                            // `sink(path.append(i))` — the consumed-append temp
                            // (#6501). Not a literal and not a registry producer,
                            // so neither arm above reaches it.
                            ast.ExprFieldAccess(_) => { arrlit_arg = append_temp_is_scalar_arr(c.args[ai], sc); },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            }
            // A COUNTED-RETAIN position admits the same temp where
            // borrowability cannot: the callee stores the argument, but every
            // appearance of its parameter is a counted store or a non-retaining
            // read, so the temp is rc 2 on the escaping path and rc 1 otherwise
            // and this one dec nets it to a single owner either way (#6522).
            // The counted-retain admission additionally requires a result that
            // cannot BE the argument (native's resultCannotAliasArg) — a
            // concrete scalar, or a struct whose drop routes field reclaim, so
            // the returned struct owns the reference the dec leaves behind.
            // param_counted_of carries that test; the dec fires immediately
            // after the call, so an array-returning callee would hand the caller
            // freed memory.
            var arg_releasable: boolean = call_arg_borrowable(sc, cid.name, ai)
                || arr_param_counted_at(sc.sigs.param_counted, cid.name, ai);
            // A CONSUMED-THREADED position (consumed_arr_positions) admits the
            // same temp on different grounds: the callee's ownership flag
            // starts clear, so it never releases the buffer it was handed,
            // and a fresh temp there has no owner once the call returns —
            // `fold(items, [])`'s literal, once per call. The callee can hand
            // the buffer straight back when nothing rebinds the parameter, so
            // this release is guarded on the result differing from the temp.
            var arg_consumed: boolean = !arg_releasable
                && util.index_of_str(sc.sigs.consumed_arr_positions, cid.name + "|" + util.i32_to_string(ai)) >= 0;
            if (arrlit_arg && sc.ok && (arg_releasable || arg_consumed)) {
                var laan: string = "$laa" + util.i32_to_string(sc.locals.len());
                sc = sc.add_local(laan);
                var laas: i32 = sc.slot_of(laan);
                sc = sc.emit(ir.op_store_local(laas));
                sc = sc.emit(ir.op_load_local(laas));
                if (arg_consumed) { lca_slots = lca_slots.append(laas); }
                else { laa_slots = laa_slots.append(laas); }
            }
            // A fresh STRUCT argument — a literal or a strict-fresh producer
            // call. Both stash and free on the same terms as the array arm
            // above; stash_fresh_struct_arg holds the reasoning.
            var sst: StructArgStash = stash_fresh_struct_arg(sc, c.args[ai], cid.name, ai);
            sc = sst.state;
            if (sst.slot >= 0) { lsl_slots = lsl_slots.append(sst.slot); }
        }
        if (!sc.ok) { return sc; }
        ai = ai + 1;
    }
    // #4873 containment: bracket each SURVIVING ident arg at a
    // may-grow ('4') param position with rc-inc before / rc-dec
    // after, so the callee's in-place uniqueness gate takes the
    // copy path and this function's binding keeps interpreter
    // (copy-on-shared) semantics. grow_exempt (the statement's
    // dying self-reassign / return-position args) skips the
    // bracket, keeping accumulator chains O(n).
    var gbr_slots: i32[] = [];
    var gba: i32 = 0;
    while (gba < c.args.len()) {
        if (sc.callee_param_may_grow(cid.name, gba)) {
            match (c.args[gba]) {
                ast.ExprIdent(gbid) => {
                    var gbs: i32 = sc.slot_of(gbid.name);
                    if (gbs >= 0 && util.index_of_str(sc.grow_exempt, gbid.name) < 0) {
                        gbr_slots = gbr_slots.append(gbs);
                    }
                },
                _ => {}
            }
        }
        gba = gba + 1;
    }
    var gbi: i32 = 0;
    while (gbi < gbr_slots.len()) {
        sc = emit_arr_share(sc, gbr_slots[gbi], "__fern_arr_share_inc");
        gbi = gbi + 1;
    }
    // #5333: a consume-safe TRMC callee frees its scrutinee cell by cell. Retain
    // the argument when the caller still holds it — a bare IDENT is exactly that
    // case — so the callee's uniqueness check sees rc >= 2 on the first cell,
    // decs once and stops, leaving the caller's list intact. There is no matching
    // dec after the call: the callee CONSUMES this reference, which is the whole
    // borrowed-to-owned flip. A non-ident argument (`inc_all(build(n))`) is a
    // fresh temp nobody else holds, so it is handed over uncounted and the loop
    // reclaims all of it. Stack-neutral, like the may-grow bracket above.
    var tca: i32 = 0;
    while (tca < c.args.len()) {
        if (sc.is_trmc_consume_arg(cid.name, tca)) {
            match (c.args[tca]) {
                ast.ExprIdent(tcid) => {
                    var tcs: i32 = sc.slot_of(tcid.name);
                    if (tcs >= 0) {
                        sc = sc.retain(tcs, "trmc-consume-arg");
                    }
                },
                _ => {}
            }
        }
        tca = tca + 1;
    }
    var scr: LowerState = sc.emit(ir.op_call_direct(cid.name, c.args.len()));
    // #4873: restore the bracketed args' rc — the callee's copy
    // path left each buffer untouched (never frees; the inc
    // preceded it).
    var gbj: i32 = 0;
    while (gbj < gbr_slots.len()) {
        scr = emit_arr_share(scr, gbr_slots[gbj], "__fern_arr_share_dec");
        gbj = gbj + 1;
    }
    // Free the stashed literal-arg boxes. Net-zero on the operand
    // stack (load → free → drop), so the call's result — live
    // beneath — is untouched; __fern_str_free is rc-aware and
    // is_unique-gated, so a retained box (impossible at a
    // borrowable position, but belt-and-braces) only decs.
    var lfi: i32 = 0;
    while (lfi < lat_slots.len()) {
        scr = scr.release(lat_slots[lfi], "__fern_str_free", "stashed-str-arg");
        lfi = lfi + 1;
    }
    // The array-literal arg temps: same net-zero stack shape, the
    // rc-guarded array release instead of the string free.
    var lfa: i32 = 0;
    while (lfa < laa_slots.len()) {
        scr = scr.release(laa_slots[lfa], "__fern_rc_dec", "stashed-arr-arg");
        lfa = lfa + 1;
    }
    scr = release_consumed_arg_temps(scr, lca_slots, cid.name);
    scr = free_stashed_struct_args(scr, lsl_slots);
    // #5464: a bare-typevar-RETURN pass-through fn (`id[T](x:T):T`,
    // str_ret_argref >= 0) returns i64 on wasm — the uniform 8-byte
    // slot the register backends give every value. Narrow the result
    // to the call's CONCRETE type (resolved from the mirrored
    // argument by expr_is_f64 / infer_expr_width) so it carries the
    // wasm type the consumer expects: f64 -> reinterpret the bits,
    // i64/u64 -> leave full-width, else (i32 / pointer) -> wrap to
    // i32 (wasm32 pointers are 32-bit; the low half round-trips). The
    // register backends never reach here (for_wasm gate) — their
    // 8-byte operand stack needs no narrowing.
    var ewri: i32 = str_ret_argref(scr, cid.name);
    if (scr.for_wasm() && ewri >= 0 && scr.callee_param_is_erased_widened(cid.name, ewri)) {
        if (expr_is_f64(e, scr)) { scr = scr.emit(ir.op_f64_from_bits()); }
        else if (infer_expr_width(e, scr) == 64) { }
        else { scr = scr.emit(ir.op_int_wrap(true)); }
    }
    return scr;
}

// release_consumed_arg_temps frees the temps handed to consumed-threaded
// positions (lca_slots) after the call, each behind a pointer-changed test
// against the call's result when the callee returns an array — the callee
// hands the temp itself back when nothing rebinds its parameter. A result
// that cannot be a pointer takes no test. The result stays on the operand
// stack.
function release_consumed_arg_temps(se: LowerState, slots: i32[], callee: string): LowerState {
    if (slots.len() == 0) { return se; }
    if (!sig_reg_has_name(se.sigs.arr_ret_fns, callee)) {
        var sp: LowerState = se;
        var pi: i32 = 0;
        while (pi < slots.len()) { sp = sp.release(slots[pi], "__fern_rc_dec", "consumed-arg-temp"); pi = pi + 1; }
        return sp;
    }
    var rname: string = "$lcr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(rname);
    var rs: i32 = st.slot_of(rname);
    st = st.emit(ir.op_store_local(rs));
    var i: i32 = 0;
    while (i < slots.len()) {
        st = st.emit(ir.op_load_local(rs));
        st = st.emit(ir.op_load_local(slots[i]));
        st = st.emit(ir.op_bin("ne", 0, false));
        st = st.emit(ir.op_if(0));
        st = st.release(slots[i], "__fern_rc_dec", "consumed-arg-temp");
        st = st.emit(ir.op_end());
        i = i + 1;
    }
    return st.emit(ir.op_load_local(rs));
}

// lower_call_prim_method dispatches `recv.m(args)` where the receiver is a
// PRIMITIVE whose tracked type is pty — a source-declared method keyed
// "<pty>.<method>", not a builtin.
function lower_call_prim_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, pty: string, s: LowerState): LowerState {
    var pm: LowerState = s;
    // i64 AND u64 receivers are 64-bit: lower full-width so the
    // receiver arg isn't truncated to 32 bits by lower_expr.
    if (pty == "i64" || pty == "u64") { pm = lower_i64(fa.obj, s); }
    else { pm = lower_expr(fa.obj, s); }
    if (!pm.ok) { return pm; }
    var pm_lat: i32[] = [];
    var pm_lsl: i32[] = [];
    // A fresh anonymous RECEIVER at a SOURCE-DECLARED method, the twin of the
    // builtin-method release. The warrant is the callee-side proof
    // recv_borrow_fns_of already computes: the plain "<Type>.<method>" key
    // says body_unsafe_for found no escape of the receiver, which refuses a
    // bare `return s` and a `return slice_unchecked(s, a, b)` view alike
    // because both are escapes for it. So the box is dead once the call
    // returns, and the
    // argument machinery below drains it.
    var recv_ok: boolean = util.index_of_str(s.sigs.recv_borrow_fns, pty + "." + fa.field) >= 0;
    if (is_fresh_str_temp(fa.obj, s) && recv_ok) {
        var rvn: string = "$precv" + util.i32_to_string(pm.locals.len());
        pm = pm.add_local(rvn);
        var rvslot: i32 = pm.slot_of(rvn);
        pm = pm.emit(ir.op_store_local(rvslot));
        pm = pm.emit(ir.op_load_local(rvslot));
        pm_lat = pm_lat.append(rvslot);
    }
    // A FRESH-OR-RECEIVER chain in receiver position — `base.tail(4).to_owned()`,
    // where every link returns a fresh box, its own receiver, or a view of one.
    // is_fresh_str_temp refuses it and must: on the identity path the
    // "intermediate" IS the root's box, and freeing it unconditionally is a
    // double free. What settles it is the same runtime discriminator the
    // `.len()` site uses — a fresh box is never the root's pointer — so release
    // only when the two differ. The outer callee still has to be recv_borrow
    // proven, which is what says the CALL did not carry the receiver into its
    // own result.
    var prroot: i32 = 0 - 1;
    if (recv_ok && !is_fresh_str_temp(fa.obj, s)) {
        match (fa.obj) {
            ast.ExprCall(_) => { prroot = sfrrecv_chain_root_slot(fa.obj, s, 0); },
            _ => {}
        }
    }
    var prslot: i32 = 0 - 1;
    if (prroot >= 0) {
        var prn: string = "$prcv" + util.i32_to_string(pm.locals.len());
        pm = pm.add_local(prn);
        prslot = pm.slot_of(prn);
        pm = pm.emit(ir.op_store_local(prslot));
        pm = pm.emit(ir.op_load_local(prslot));
    }
    var pai: i32 = 0;
    while (pai < c.args.len()) {
        // fn-value arg (const_func) before general lowering —
        // see the struct-method loop above (#2954 follow-up).
        var pfvn: string = fn_value_arg_name(c.args[pai], pm);
        if (pfvn.len() > 0 && pm.callee_param_is_fn(pty + "." + fa.field, pai)) { pm = pm.emit(ir.op_const_func(0, pfvn)); }
        else if (pm.param_is_i64(pty + "." + fa.field, pai)) { pm = lower_i64(c.args[pai], pm); }
        else {
            pm = lower_expr(c.args[pai], pm);
            var pmst: ArgStash = stash_fresh_str_arg(pm, c.args[pai], pty + "." + fa.field, pai);
            pm = pmst.state;
            if (pmst.slot >= 0) { pm_lat = pm_lat.append(pmst.slot); }
            var pmss: StructArgStash = stash_fresh_struct_arg(pm, c.args[pai], pty + "." + fa.field, pai);
            pm = pmss.state;
            if (pmss.slot >= 0) { pm_lsl = pm_lsl.append(pmss.slot); }
        }
        if (!pm.ok) { return pm; }
        pai = pai + 1;
    }
    pm = pm.emit(ir.op_call_direct(pty + "." + fa.field, 1 + c.args.len()));
    pm = free_stashed_str_args(pm, pm_lat);
    pm = free_stashed_struct_args(pm, pm_lsl);
    if (prslot >= 0) {
        pm = pm.emit(ir.op_load_local(prslot));
        pm = pm.emit(ir.op_load_local(prroot));
        pm = pm.emit(ir.op_bin("ne", 0, false));
        pm = pm.emit(ir.op_if(0));
        pm = pm.emit(ir.op_load_local(prslot));
        pm = pm.emit(ir.op_call_direct("__fern_str_view_free", 1));
        pm = pm.emit(ir.op_drop());
        pm = pm.emit(ir.op_end());
    }
    return pm;
}

// lower_call_struct_method dispatches `recv.m(args)` on a receiver whose tracked
// struct type is rty, redirecting an enum VARIANT receiver to the enum its
// methods are actually declared on.
function lower_call_struct_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, rty: string, s: LowerState): LowerState {
    // A receiver whose tracked type is an enum VARIANT (a
    // struct with an enum_owner — e.g. a local `var c = Green`
    // typed "Green") dispatches its methods under the ENUM
    // name: methods are declared on the enum (`function (c:
    // Color) m()`), keyed "<Enum>.<m>", never the variant. So
    // redirect variant -> enum_owner; otherwise the call_direct
    // names "<Variant>.<m>", which module_has_func can't find,
    // bailing the module to AST (#2947).
    var disp_ty: string = rty;
    var rvo: string = variant_enum_owner(s.structs, rty);
    if (rvo != "") { disp_ty = rvo; }
    // No arity cap (see the free-call note above): the
    // receiver lowers as arg 0 and the rest follow on the
    // stack, count-agnostic on every backend.
    var sm: LowerState = lower_expr(fa.obj, s);
    if (!sm.ok) { return sm; }
    var sm_lat: i32[] = [];
    var sm_lsl: i32[] = [];
    var ai: i32 = 0;
    while (ai < c.args.len()) {
        // A bare fn-name arg at a "fn"-typed method param is a
        // function VALUE (const_func), not a call — the same
        // const-vs-fn-value disambiguation the free-call loop
        // does. Must run BEFORE general lowering, else a
        // zero-arg fn-value (`m.f(noop)`) hits the const-call
        // path and is wrongly invoked (#2954 follow-up).
        var mfvn: string = fn_value_arg_name(c.args[ai], sm);
        if (mfvn.len() > 0 && sm.callee_param_is_fn(disp_ty + "." + fa.field, ai)) {
            sm = sm.emit(ir.op_const_func(0, mfvn));
        } else if (sm.param_is_i64(disp_ty + "." + fa.field, ai)) {
            // An i64 method param: the arg is an 8-byte i64
            // value, lowered via lower_i64.
            sm = lower_i64(c.args[ai], sm);
        } else {
            sm = lower_expr(c.args[ai], sm);
            var smst: ArgStash = stash_fresh_str_arg(sm, c.args[ai], disp_ty + "." + fa.field, ai);
            sm = smst.state;
            if (smst.slot >= 0) { sm_lat = sm_lat.append(smst.slot); }
            var smss: StructArgStash = stash_fresh_struct_arg(sm, c.args[ai], disp_ty + "." + fa.field, ai);
            sm = smss.state;
            if (smss.slot >= 0) { sm_lsl = sm_lsl.append(smss.slot); }
        }
        if (!sm.ok) { return sm; }
        ai = ai + 1;
    }
    sm = sm.emit(ir.op_call_direct(disp_ty + "." + fa.field, 1 + c.args.len()));
    sm = free_stashed_str_args(sm, sm_lat);
    return free_stashed_struct_args(sm, sm_lsl);
}

// lower_call_fn_field lowers a call through a CLOSURE-VALUED struct field —
// `recv.f(args)` where f is declared `fn` on rty — so the call goes indirect
// through the field's value rather than through method dispatch.
function lower_call_fn_field(c: ast.ExprCall, fa: ast.ExprFieldAccess, rty: string, s: LowerState): LowerState {
    var ffidx: i32 = s.field_index_in(rty, fa.field);
    if (ffidx < 0) { return s.fail(); }
    // Evaluate the receiver, read the field box, stash it.
    var ffs: LowerState = lower_expr(fa.obj, s);
    if (!ffs.ok) { return ffs; }
    ffs = ffs.emit(ir.op_struct_get(ffidx, struct_field_width(s.structs, rty, ffidx)));
    var fbtmp: string = "$fnfield" + util.i32_to_string(ffs.locals.len());
    ffs = ffs.add_local(fbtmp);
    var fbslot: i32 = ffs.slot_of(fbtmp);
    ffs = ffs.emit(ir.op_store_local(fbslot));
    ffs = ffs.emit(ir.op_load_local(fbslot));   // __env (the box)
    // One declared signature drives both halves: the width each argument is
    // lowered at, and the funcref type the call names. Split across two
    // derivations they disagree, and a disagreement is a module the wasm
    // validator rejects (#5986).
    var fsig: string = decl_field_fn_sig(s.structs, rty, fa.field);
    var fai: i32 = 0;
    while (fai < c.args.len()) {
        ffs = lower_fn_value_arg_wc(c.args[fai], sig_arg_width_char(fsig, fai), ffs);
        if (!ffs.ok) { return ffs; }
        fai = fai + 1;
    }
    ffs = ffs.emit(ir.op_load_local(fbslot));
    ffs = ffs.emit(ir.op_const_i32(0));
    ffs = ffs.emit(ir.op_arr_get(32));   // box[0] -> funcval
    return ffs.emit(ir.op_call_indirect_sig(c.args.len() + 1, callee_fn_sig_declared(fsig, c, true)));
}

// lower_call_dyn_method dispatches `recv.m(args)` on a `dyn Trait` receiver,
// through the shape pointer the box carries (docs/DYN-TRAITS.md).
function lower_call_dyn_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, rty: string, s: LowerState): LowerState {
    var dbase: i32 = s.locals.len();
    var dargc: i32 = 1 + c.args.len();
    var dm: LowerState = s;
    var dti: i32 = 0;
    while (dti < dargc) { dm = dm.add_local("$dyn" + util.i32_to_string(dbase) + "_" + util.i32_to_string(dti)); dti = dti + 1; }
    dm = lower_expr(fa.obj, dm);
    if (!dm.ok) { return dm; }
    dm = dm.emit(ir.op_store_local(dbase));
    var dai: i32 = 0;
    while (dai < c.args.len()) {
        dm = lower_expr(c.args[dai], dm);
        if (!dm.ok) { return dm; }
        dm = dm.emit(ir.op_store_local(dbase + 1 + dai));
        dai = dai + 1;
    }
    return dm.emit(ir.op_dyn_dispatch(fa.field, parser.dyn_trait_set(rty), dbase, dargc));
}

// lower_call_clamp lowers the i32 `.clamp(lo, hi)` builtin, which stashes both
// bounds in slots so each is evaluated once across the two comparisons.
function lower_call_clamp(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    var cnn: string = "$i32clN" + util.i32_to_string(s.locals.len());
    var pcl: LowerState = s.add_local(cnn);
    var cnslot: i32 = pcl.slot_of(cnn);
    var cln: string = "$i32clL" + util.i32_to_string(pcl.locals.len());
    pcl = pcl.add_local(cln);
    var clslot: i32 = pcl.slot_of(cln);
    var chn: string = "$i32clH" + util.i32_to_string(pcl.locals.len());
    pcl = pcl.add_local(chn);
    var chslot: i32 = pcl.slot_of(chn);
    var ctn: string = "$i32clT" + util.i32_to_string(pcl.locals.len());
    pcl = pcl.add_local(ctn);
    var ctslot: i32 = pcl.slot_of(ctn);
    pcl = lower_expr(fa.obj, pcl);
    if (!pcl.ok) { return pcl; }
    pcl = pcl.emit(ir.op_store_local(cnslot));
    pcl = lower_expr(c.args[0], pcl);
    if (!pcl.ok) { return pcl; }
    pcl = pcl.emit(ir.op_store_local(clslot));
    pcl = lower_expr(c.args[1], pcl);
    if (!pcl.ok) { return pcl; }
    pcl = pcl.emit(ir.op_store_local(chslot));
    // t = max(n, lo)
    pcl = emit_i32_minmax_slots(pcl, cnslot, clslot, true);
    pcl = pcl.emit(ir.op_store_local(ctslot));
    // clamp = min(t, hi)
    return emit_i32_minmax_slots(pcl, ctslot, chslot, false);
}

// lower_call_append lowers `arr.append(e)` in EXPRESSION position (a return, a
// var-init, an argument): the receiver and element are lowered, then grown
// through the width-matched arr_push, leaving the array on the stack.
function lower_call_append(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    // Value semantics for a receiver this push may not mutate: bracket it so
    // the grow helper's rc==1 in-place path cannot fire (append_copy_recv_slot).
    var apcs: i32 = append_copy_recv_slot(fa.obj, s);
    var aps0: LowerState = s;
    if (apcs >= 0) { aps0 = emit_arr_share(aps0, apcs, "__fern_arr_share_inc"); }
    if (expr_is_f64arr(fa.obj, s)) {
        var apf: LowerState = lower_expr(fa.obj, aps0);
        if (!apf.ok) { return apf; }
        apf = lower_expr(c.args[0], apf);
        if (!apf.ok) { return apf; }
        apf = apf.emit(ir.op_arr_push_f64());
        if (apcs >= 0) { apf = emit_arr_share(apf, apcs, "__fern_arr_share_dec"); }
        return apf;
    }
    if (expr_is_i64arr(fa.obj, s) || (expr_is_arr_src(fa.obj, s) && expr_is_u64(fa.obj, s))) {
        var ap8: LowerState = lower_expr(fa.obj, aps0);
        if (!ap8.ok) { return ap8; }
        ap8 = lower_i64(c.args[0], ap8);
        if (!ap8.ok) { return ap8; }
        ap8 = ap8.emit(ir.op_arr_push_i64());
        if (apcs >= 0) { ap8 = emit_arr_share(ap8, apcs, "__fern_arr_share_dec"); }
        return ap8;
    }
    var aps: LowerState = lower_expr(fa.obj, aps0);
    if (!aps.ok) { return aps; }
    aps = lower_expr(c.args[0], aps);
    if (!aps.ok) { return aps; }
    // An element of a caller-owned string[] is a second owner once stored
    // (str_param_elem_escapes), here as in the self-append and clone forms.
    if (str_param_elem_escapes(c.args[0], aps)) { aps = aps.retain_tos("append-param-str-elem"); }
    aps = aps.emit(ir.op_arr_push());
    if (apcs >= 0) { aps = emit_arr_share(aps, apcs, "__fern_arr_share_dec"); }
    // An in-place push on a BORROWED param's buffer hands that same buffer out
    // as a second reference — the caller's slot still holds the first — so the
    // result is counted exactly as a bare `return p` is (the return-transfer
    // retain). Guarded on identity: a grow or a shared-receiver copy hands back
    // a fresh rc 1 buffer that already is the one reference. A declared `own`
    // param is the callee's to give back uncounted, as in the bare return.
    var iprs: i32 = borrowed_arr_param_slot(fa.obj, aps);
    if (apcs < 0 && iprs >= 0) {
        var ipscratch: string = "$ipa" + util.i32_to_string(aps.locals.len());
        aps = aps.add_local(ipscratch);
        var iptmp: i32 = aps.slot_of(ipscratch);
        aps = aps.emit(ir.op_store_local(iptmp));
        aps = aps.emit(ir.op_load_local(iptmp));
        aps = aps.emit(ir.op_load_local(iprs));
        aps = aps.emit(ir.op_bin("eq", 0, false));
        aps = aps.emit(ir.op_if(0));
        aps = aps.retain(iptmp, "append-inplace-borrowed");
        aps = aps.emit(ir.op_end());
        aps = aps.emit(ir.op_load_local(iptmp));
    }
    return aps;
}

// lower_call_len lowers the builtin `.len()`, dispatching on the receiver's
// tracked type: a string box's length field, an array header, a map's count.
// Split out of lower_call_method; the guard selecting it stays there.
function lower_call_len(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    // String `.len()` reads the string box's length field;
    // array `.len()` reads the array header. Dispatch on the
    // receiver's tracked type.
    //
    // Guard: only intercept the builtin `.len()` when the
    // receiver is NOT a declared struct VALUE. A struct has no
    // builtin `.len()`, so `b.len()` on a struct must be a
    // user-defined receiver method (`(b: T) len()`) — which
    // shadows the builtin, matching the native compiler.
    // Without this guard the receiver fell through to
    // `op_arr_len`, reading the struct box as an array header
    // (returning garbage) instead of dispatching the method
    // (#3478). `decl_is_struct` keys on the DECLARED struct
    // name, so it's false for arrays / strings (whose
    // `expr_struct_type` is "") AND for a generic `T[]`
    // param (whose tracked element type "T" isn't a declared
    // struct) — the latter keeps `xs.len()` in the generic
    // array serialiser on the builtin path. The sibling
    // `append` intercepts below are already array-guarded;
    // `len` was the only unguarded one.
    //
    // The leading array-source check handles a STRUCT-ARRAY
    // receiver that is a function-call result (`mkS().len()`,
    // `regex_find_all(p, t).len()`): expr_struct_type of a
    // `P[]`-returning call reports the ELEMENT type "P" (for
    // `mk()[i].field` recovery, #3035), which would otherwise
    // make decl_is_struct true and mis-route `.len()` to a
    // (nonexistent) `P.len` method. A struct-array LOCAL already
    // reports "" (arr slot), so only the direct-call form needed
    // this; an array source is always the builtin array length.
    var str_recv: boolean = expr_is_str(fa.obj, s);
    // A FRESH string-concat receiver (`(a + b).len()`) allocates
    // a temp box the read would otherwise strand — the receiver-
    // position sibling of the discarded-statement concat reclaim
    // (#4365; native's value-consuming-op arc bounds this shape).
    // Stash the box in an unmarked scratch (the exit sweep is
    // is_arr_slot-gated, so it never double-frees it), read the
    // length, then release the temp with the rc-aware
    // __fern_str_free — operands stay owned by their locals.
    if (str_recv) {
        // is_fresh_str_temp is the general answer to "is this receiver a box
        // nobody else names": a concat, a scalar `.to_string()`, a proven
        // fresh-ret call, or a fresh-allocating string builtin. The arms
        // below add the shapes it does not cover — a box extracted from an
        // owned container, which is not a temp but dies here all the same.
        var lfresh: boolean = is_fresh_str_temp(fa.obj, s);
        match (fa.obj) {
            ast.ExprBinary(lrb) => { if (lrb.op == "+") { lfresh = true; } },
            // A CALL receiver (`f(i).len()`) whose callee is
            // SFRLEN:-seeded (str-fresh-ret registry + this
            // body's len-receiver walker) hands over a fresh
            // box that is equally dead after the read — the
            // native #5141 twin. Unproven callees keep the
            // safe-leak (no return-transfer inc on this path).
            ast.ExprCall(lrc) => {
                match (lrc.callee) {
                    ast.ExprIdent(lrcid) => {
                        if (reclaim_has(s.reclaimable_names, "SFRLEN:", lrcid.name)) { lfresh = true; }
                    },
                    _ => {}
                }
            },
            // An owned-container READ in receiver position — `strs(i)[0].len()`
            // / `boxed(i).name.len()` (#6491). The read below releases the
            // container and hands this frame the extracted box; with no
            // destination to own it, the borrowing read is where it dies. This
            // is the binding credit's twin: between them every position that
            // consumes such a read reclaims it.
            ast.ExprIndex(lri) => {
                if (owned_fresh_call_callee(lri.array, "STRARR:", s) != "") { lfresh = true; }
            },
            ast.ExprFieldAccess(lrfa) => {
                var lrfty: string = expr_struct_type(lrfa.obj, s);
                if (lrfty != "" && decl_field_type(s.structs, lrfty, lrfa.field) == "string"
                        && owned_fresh_call_callee(lrfa.obj, "STRFLDF:", s) != "") { lfresh = true; }
            },
            _ => {}
        }
        if (lfresh) {
            var lr: LowerState = lower_expr(fa.obj, s);
            if (!lr.ok) { return lr; }
            var lscr: string = "$lenr" + util.i32_to_string(lr.locals.len());
            lr = lr.add_local(lscr);
            var lslot: i32 = lr.slot_of(lscr);
            lr = lr.emit(ir.op_store_local(lslot));
            lr = lr.emit(ir.op_load_local(lslot));
            lr = lr.emit(ir.op_str_len());
            lr = lr.release(lslot, "__fern_str_free", "len-fresh-str");
            return lr;
        }
        // `b.relabel(t).tag.len()` — a string field read off a MIXED-path
        // method result ("FRESHSELF:"). The STRING is borrowed on both
        // paths; what dies here is the temp BOX, and only when the fresh
        // path produced it. Read the length while the box is still alive,
        // then release under the pointer compare. The string-fresh cases
        // above never match this shape: their release frees the string, and
        // here the string belongs to whoever the literal took it from.
        match (fa.obj) {
            ast.ExprFieldAccess(fsfa) => {
                // Shape first: freshself_call_recv_slot rejects on the callee's
                // form before any type walk, and this arm sits on the path every
                // `<expr>.len()` takes.
                var fsbrecv: i32 = freshself_call_recv_slot(fsfa.obj, s);
                if (fsbrecv >= 0) {
                    var fsbty: string = expr_struct_type(fsfa.obj, s);
                    var fsbfld: i32 = 0 - 1;
                    if (fsbty != "" && decl_field_type(s.structs, fsbty, fsfa.field) == "string") {
                        fsbfld = s.field_index_in(fsbty, fsfa.field);
                    }
                    if (fsbfld >= 0) {
                        var fsb: LowerState = lower_expr(fsfa.obj, s);
                        if (!fsb.ok) { return fsb; }
                        var bscr: string = "$fslb" + util.i32_to_string(fsb.locals.len());
                        fsb = fsb.add_local(bscr);
                        var bslot: i32 = fsb.slot_of(bscr);
                        fsb = fsb.mark_struct_type(bslot, fsbty);
                        fsb = fsb.emit(ir.op_store_local(bslot));
                        var nscr2: string = "$fsln" + util.i32_to_string(fsb.locals.len());
                        fsb = fsb.add_local(nscr2);
                        var nslot2: i32 = fsb.slot_of(nscr2);
                        fsb = fsb.emit(ir.op_load_local(bslot));
                        fsb = fsb.emit(ir.op_struct_get(fsbfld, struct_field_width(s.structs, fsbty, fsbfld)));
                        fsb = fsb.emit(ir.op_str_len());
                        fsb = fsb.emit(ir.op_store_local(nslot2));
                        fsb = emit_freshself_release(fsb, bslot, fsbrecv);
                        return fsb.emit(ir.op_load_local(nslot2));
                    }
                }
            },
            _ => {}
        }
        // A fresh-or-RECEIVER method result (`base.drop(2).len()`,
        // `base.tail(4).to_owned().len()`, SFRRECV:) — the receiver-position
        // half of #6544. Every link on the chain is proven to return a fresh
        // box, its own receiver, or a view of it, so the only pointer the
        // chain's result can carry without being the chain's own allocation
        // is the ROOT's — a slice allocates a box like any other producer.
        // The pointer therefore decides at runtime which arrived: release
        // the result only when it differs from the root's. No
        // return-transfer inc is involved, which is what makes this safe
        // without the whole-surface drop coverage that inc would require
        // (§9). __fern_str_view_free is __fern_str_free plus the view case:
        // a fresh box frees data + box, a heap view box frees the box
        // alone.
        //
        // INTERMEDIATE links still leak — freeing one needs the outer callee
        // proven both borrowing and never-a-view, which is a separate slice.
        // Nothing here can double-free them: the result is released once,
        // whether it is the chain's last allocation or an earlier link
        // handed through.
        //
        // The chain must be rooted at a bare string LOCAL, so the pointer it
        // is compared against is a slot load with no re-evaluation and no
        // second allocation to confuse the compare.
        var frslot: i32 = 0 - 1;
        match (fa.obj) {
            ast.ExprCall(_) => { frslot = sfrrecv_chain_root_slot(fa.obj, s, 0); },
            _ => {}
        }
        if (frslot >= 0) {
            var fr: LowerState = lower_expr(fa.obj, s);
            if (!fr.ok) { return fr; }
            var rscr: string = "$frr" + util.i32_to_string(fr.locals.len());
            fr = fr.add_local(rscr);
            var rslot: i32 = fr.slot_of(rscr);
            fr = fr.emit(ir.op_store_local(rslot));
            // Park the length too: the release below opens a block, and a
            // value left on the stack under it is not something every
            // backend's verifier accepts.
            var nscr: string = "$frn" + util.i32_to_string(fr.locals.len());
            fr = fr.add_local(nscr);
            var nslot: i32 = fr.slot_of(nscr);
            fr = fr.emit(ir.op_load_local(rslot));
            fr = fr.emit(ir.op_str_len());
            fr = fr.emit(ir.op_store_local(nslot));
            fr = fr.emit(ir.op_load_local(rslot));
            fr = fr.emit(ir.op_load_local(frslot));
            fr = fr.emit(ir.op_bin("ne", 0, false));
            fr = fr.emit(ir.op_if(0));
            fr = fr.emit(ir.op_load_local(rslot));
            fr = fr.emit(ir.op_call_direct("__fern_str_view_free", 1));
            fr = fr.emit(ir.op_drop());
            fr = fr.emit(ir.op_end());
            return fr.emit(ir.op_load_local(nslot));
        }
    }
    var lnst: ArgStash = lower_view_borrowed_parked(fa.obj, s);
    var sl: LowerState = lnst.state;
    if (!sl.ok) { return sl; }
    if (str_recv) { return free_parked_view_after(sl.emit(ir.op_str_len()), lnst.slot); }
    // An ARRAY-returning call receiver (`mk(i).len()` / `h.mk().len()`)
    // whose callee leaves this frame owning one reference: a strict-fresh
    // "ARR:" producer hands back an rc=1 buffer, an "ARROWN:" one a
    // reference it retained or moved out (#7259). The receiver has no slot
    // to sweep it, and it is dead once the length is read. Stash, read, then
    // release with the rc-guarded __fern_rc_dec — the discarded-statement
    // reclaim's shape, in receiver position.
    //
    // The dec is element-blind, which each admission makes sound its own
    // way: "ARR:" is scalar elements only, and an "ARROWN:" buffer either
    // has scalar elements too or belongs to whoever the callee borrowed from.
    //
    // owned_fresh_call_callee resolves BOTH registry key forms — a bare name
    // for a free function and "<Base>.<method>" for a method — so this site
    // reads the same admission the #6491 read reclaim does instead of
    // re-deriving it.
    var alfresh: boolean = owned_fresh_call_callee(fa.obj, "ARR:", s) != ""
        || owned_fresh_call_callee(fa.obj, "ARROWN:", s) != "";
    // A "STRARR:" producer takes the DEEP free instead: its elements are string
    // boxes this frame allocated, so the element-blind dec above would give back
    // the buffer and strand every one of them. That is the same split the
    // `mk()[i]` read reclaim makes (#6491) — this site carried only the shallow
    // half, so `mks().len()` stranded the whole container, 144 B/round and
    // unbounded (#7259). The two admissions are disjoint: "ARROWN:" refuses a
    // returned string[] LITERAL (is_leaksafe_array_field is false for it) and
    // "STRARR:" refuses a returned field, which is not frame-fresh.
    var alstrdeep: boolean = !alfresh && owned_fresh_call_callee(fa.obj, "STRARR:", s) != "";
    // The STRUCT-element producers (#7445's registries) take the release the
    // exit sweep gives a credited slot of the same class: the element boxes are
    // this frame's, so the element-blind dec would strand every one. A
    // scalar-field element ("STRUCTARRF:") frees box-per-element via
    // __fern_arrarr_free; one that routes field reclaim, or carries an rc-array
    // field ("ARRSTRUCTF:"), walks each element through __struct_drop_<T>
    // first. The element type comes from struct_ret_fns, which records it for
    // every struct-array return (#3035).
    var alsarr: string = "";
    if (!alfresh && !alstrdeep) {
        alsarr = owned_fresh_call_callee(fa.obj, "STRUCTARRF:", s);
        if (alsarr == "") { alsarr = owned_fresh_call_callee(fa.obj, "ARRSTRUCTF:", s); }
    }
    var alsty: string = "";
    if (alsarr != "") { alsty = s.struct_ret_type(alsarr); }
    if (alsarr != "" && !decl_is_struct(s.structs, alsty)) { alsarr = ""; }
    if (alfresh || alstrdeep || alsarr != "") {
        var ascr: string = "$lenra" + util.i32_to_string(sl.locals.len());
        sl = sl.add_local(ascr);
        var aslot: i32 = sl.slot_of(ascr);
        sl = sl.emit(ir.op_store_local(aslot));
        sl = sl.emit(ir.op_load_local(aslot));
        sl = sl.emit(ir.op_arr_len());
        if (alstrdeep) { sl = sl.release(aslot, "__fern_str_arr_free", "len-fresh-strarr"); }
        else if (alsarr != "") {
            if (struct_has_reclaim_array_field(sl.structs, alsty) || sl.struct_routes_field_reclaim(alsty)) {
                sl = emit_arrstruct_deep_free(sl, aslot, alsty);
            } else {
                sl = sl.release(aslot, "__fern_arrarr_free", "len-fresh-structarr");
            }
        }
        else { sl = sl.release(aslot, "__fern_rc_dec", "len-fresh-arr"); }
        return sl;
    }
    return sl.emit(ir.op_arr_len());
}

// lower_call_first_byte lowers the string `.first_byte()` / `.last_byte()`
// builtins to a bounds-known index into the receiver's bytes.
function lower_call_first_byte(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    if (fa.field == "first_byte") {
        var pfb: LowerState = lower_expr(fa.obj, s);
        if (!pfb.ok) { return pfb; }
        pfb = pfb.emit(ir.op_const_i32(0));
        return pfb.emit(ir.op_str_index());
    }
    var sname: string = "$lbs" + util.i32_to_string(s.locals.len());
    var plb: LowerState = s.add_local(sname);
    var sslot: i32 = plb.slot_of(sname);
    plb = lower_expr(fa.obj, plb);
    if (!plb.ok) { return plb; }
    plb = plb.emit(ir.op_store_local(sslot));
    plb = plb.emit(ir.op_load_local(sslot));    // string (operand 1)
    plb = plb.emit(ir.op_load_local(sslot));
    plb = plb.emit(ir.op_str_len());
    plb = plb.emit(ir.op_const_i32(1));
    plb = plb.emit(ir.op_bin("sub", 0, false)); // len - 1 (operand 2)
    return plb.emit(ir.op_str_index());
}

// lower_call_arr_firstlast lowers the array `.first()` / `.last()` builtins,
// stashing the receiver so the length test and the element read share one
// evaluation of it.
function lower_call_arr_firstlast(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    if (fa.field == "first") { return lower_expr(arr_elem_index_expr(fa.obj), s); }
    // `last` reads the receiver TWICE (once for the length, once
    // as the indexed array), so it goes through a temp local —
    // the last_byte pattern just below — rather than duplicating
    // the subtree, which would evaluate a call receiver
    // (`build().last()`) twice. The temp is synthetic, so it is
    // absent from reclaimable_names and never swept: a borrowed
    // receiver cannot be freed under its owner.
    var alname: string = "$alast" + util.i32_to_string(s.locals.len());
    var pal: LowerState = s.add_local(alname);
    var alslot: i32 = pal.slot_of(alname);
    pal = lower_expr(fa.obj, pal);
    if (!pal.ok) { return pal; }
    pal = pal.emit(ir.op_store_local(alslot));
    pal = pal.emit(ir.op_load_local(alslot));    // array (operand 1)
    pal = pal.emit(ir.op_load_local(alslot));
    pal = pal.emit(ir.op_arr_len());
    pal = pal.emit(ir.op_const_i32(1));
    pal = pal.emit(ir.op_bin("sub", 0, false)); // len - 1 (operand 2)
    return pal.emit(ir.op_arr_get(32));
}

// lower_call_map_method lowers the Map method desugars — insert/set, get, has,
// delete, clear, keys, values and iteration — for a receiver whose tracked type
// is the map type mtype. Split out of lower_call_method; the guard selecting it
// stays there.
function lower_call_map_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, mtype: string, s: LowerState): LowerState {
    var mkk2: i32 = map_key_kind_of(mtype);
    var meqfn: string = map_key_eqfn(mtype);
    // #7001: a COMPOSITE (struct / enum) key is kind 2, dispatched by its
    // derived hash/eq. map_key_kind_of only separates `Map[i32,` from
    // everything else, so it answers 0 — STRING — for one, and a
    // `Map { … }` literal built itself string-keyed: __fern_str_eq then read
    // each key box as a string, taking its first field as a length, and keys
    // differing only past that field collapsed. meqfn was already right here;
    // only the kind was wrong.
    // The KEY EXPRESSION overrides a scalar/string key tag. `map_new` and
    // `map_new_i32` are the only two constructor spellings, so a COMPOSITE
    // (struct / enum) key has none and a `Map { … }` literal's desugared
    // chain bases itself on `map_new` — the STRING one — which is what the
    // tag is recovered from here. A struct / enum literal names its own
    // type, so it answers what the constructor cannot. Read from the
    // expression rather than a stamped type tag because only the CLI runs
    // checker.annotate_module; the asm / wasm drivers do not, and a fix that
    // needed the tag would leave them miscompiling (#7001).
    if (meqfn == "" && (fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
        var kexp: string = expr_struct_type(c.args[0], s);
        // A payload-free enum variant is a bare ident that names no local,
        // so expr_struct_type cannot type it; its enum is its declaration's
        // owner.
        if (kexp == "") {
            match (c.args[0]) {
                ast.ExprIdent(kid) => {
                    if (s.slot_of(kid.name) < 0) { kexp = variant_enum_owner(s.structs, kid.name); }
                },
                _ => {}
            }
        }
        if (kexp != "") {
            mtype = map_with_key(mtype, kexp);
            meqfn = map_key_eqfn(mtype);
        } else if (mkk2 == 0 && map_lit_ctor_root(fa.obj) && map_key_int_evidence(c.args[0], s)) {
            // The literal's FIRST entry: its receiver is the bare
            // constructor, which carries no key of its own for
            // expr_map_kind to read, so the string tag recovered from it is
            // the parser's fallback. This key argument answers it (#7438).
            mtype = map_with_key(mtype, "i32");
            mkk2 = map_key_kind_of(mtype);
        }
    }
    if (meqfn != "") { mkk2 = 2; }
    if ((fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
        var mset: LowerState = lower_expr_map_base(fa.obj, mtype, s);
        if (!mset.ok) { return mset; }
        mset = lower_expr(c.args[0], mset);
        if (!mset.ok) { return mset; }
        // An i64/u64 VALUE must reach the 8-byte store full-width
        // (lower_i64) — a plain lower_expr emits op_const_i32 and
        // truncates a > 2^31 value to 32 bits (#5253 symptom 1).
        var msvw: boolean = map_insert_val_is_i64(mtype, c.args[1], s);
        if (msvw) { mset = lower_i64(c.args[1], mset); }
        else { mset = lower_expr(c.args[1], mset); }
        if (!mset.ok) { return mset; }
        // f64 values lower via lower_expr (bit-intact 8-byte
        // push); the widekind OP flag distinguishes i64/u64
        // (wasm boxes an 8-byte cell) from f64 (wasm defers) (#5253).
        var mswk: i32 = 0;
        if (msvw) { mswk = 1; }
        else if (map_value_of(mtype) == "f64" || expr_is_f64(c.args[1], s)) { mswk = 2; }
        return mset.emit(ir.op_map_set(mkk2, map_value_is_ptr(map_value_of(mtype)) || insert_value_is_ptr(c.args[1], s), map_insert_value_consumed(c.args[1], s), is_fresh_str_temp(c.args[0], s), map_owncols(mtype) || map_site_owncols(fa.obj, s), map_insert_value_retains(c.args[1], map_value_of(mtype), s), meqfn, mswk));
    }
    if (fa.field == "len" && c.args.len() == 0) {
        var mlen: LowerState = lower_expr(fa.obj, s);
        if (!mlen.ok) { return mlen; }
        return mlen.emit(ir.op_map_len());
    }
    if (fa.field == "get" && c.args.len() == 1) {
        var mget: LowerState = lower_expr(fa.obj, s);
        if (!mget.ok) { return mget; }
        mget = lower_expr(c.args[0], mget);
        if (!mget.ok) { return mget; }
        var mgk: i32 = 0 - 1;
        if (mkk2 == 0 && is_fresh_str_temp(c.args[0], s)) {
            var mgkn: string = "$mgkey" + util.i32_to_string(mget.locals.len());
            mget = mget.add_local(mgkn);
            mgk = mget.slot_of(mgkn);
            mget = mget.emit(ir.op_tee_local(mgk));
        }
        mget = mget.emit(ir.op_map_get(mkk2, meqfn, map_value_widekind(map_value_of(mtype))));
        if (mgk >= 0) {
            mget = mget.release(mgk, "__fern_str_free", "map-get-key-temp");
        }
        return mget;
    }
    if (fa.field == "has" && c.args.len() == 1) {
        var mhas: LowerState = lower_expr(fa.obj, s);
        if (!mhas.ok) { return mhas; }
        mhas = lower_expr(c.args[0], mhas);
        if (!mhas.ok) { return mhas; }
        return mhas.emit(ir.op_map_has(mkk2, meqfn));
    }
    if (fa.field == "get_or" && c.args.len() == 2) {
        var mgo: LowerState = lower_expr(fa.obj, s);
        if (!mgo.ok) { return mgo; }
        mgo = lower_expr(c.args[0], mgo);
        if (!mgo.ok) { return mgo; }
        // The DEFAULT must match the value width: an i64/u64 map's
        // default lowers 8-byte too, else a > 2^31 default (or an
        // i64 default local) truncates on the miss path (#5253).
        var govw: boolean = map_insert_val_is_i64(mtype, c.args[1], s);
        if (govw) { mgo = lower_i64(c.args[1], mgo); }
        else { mgo = lower_expr(c.args[1], mgo); }
        if (!mgo.ok) { return mgo; }
        // f64 column: widekind 2 (wasm defers); i64/u64 is
        // widekind 1 (wasm dereferences the boxed cell). The
        // default lowered via lower_i64/lower_expr above (#5253).
        var gowk: i32 = 0;
        if (govw) { gowk = 1; }
        else if (map_value_of(mtype) == "f64" || expr_is_f64(c.args[1], s)) { gowk = 2; }
        return mgo.emit(ir.op_map_get_or(mkk2, meqfn, gowk));
    }
    if (fa.field == "without" && c.args.len() == 1) {
        // Functional delete: `m.without(k)` -> the map with k
        // removed (reuses __fern_map_delete, like the AST path).
        var mdel: LowerState = lower_expr(fa.obj, s);
        if (!mdel.ok) { return mdel; }
        mdel = lower_expr(c.args[0], mdel);
        if (!mdel.ok) { return mdel; }
        return mdel.emit(ir.op_map_delete(mkk2, meqfn));
    }
    if (fa.field == "cleared" && c.args.len() == 0) {
        // Functional clear: `m.cleared()` -> a fresh empty map
        // of the same key kind. Construction, not a clear op:
        // this runtime's map box IS [keys, values] with no
        // capacity field, and __fern_map_new's argument is a
        // HINT every backend discards (x86 pops it into %rdi
        // unused, the arm64 emitter says "capacity (ignored)",
        // wasm calls it a hint) — so an empty box of the right
        // key kind is exactly what clearing produces here.
        // Native cow-then-clears because its map keeps capacity
        // AND identity; ours keeps neither, so a value-returning
        // `cleared` needs no IR op, no runtime helper and no
        // backend work. The key kind is rebuilt the way the
        // map_new site does it (kind 2 + "K.hash|K.eq" for a
        // struct/enum key), not from mkk2, which only
        // distinguishes i32 from string.
        //
        // Only a plain map LOCAL is admitted. The receiver is
        // deliberately not lowered — there is nothing to read
        // from it — so a receiver that had to be evaluated for
        // its side effects (`f().cleared()`) would lose them;
        // that shape bails instead. Its buffers are released by
        // whatever binding owned the old value, as for any
        // superseded map.
        var clr_local: boolean = false;
        match (fa.obj) {
            ast.ExprIdent(clrid) => { if (s.slot_of(clrid.name) >= 0) { clr_local = true; } },
            _ => {}
        }
        if (!clr_local) { return s.fail(); }
        var clr_kk: i32 = map_key_kind_of(mtype);
        var clr_fns: string = "";
        if (meqfn != "") {
            var clr_kt: string = map_key_of(mtype);
            clr_kk = 2;
            clr_fns = clr_kt + ".hash|" + clr_kt + ".eq";
        }
        var clrs: LowerState = s.emit(ir.op_const_i32(8));
        return clrs.emit(ir.op_map_new(clr_kk, clr_fns));
    }
    if (fa.field == "keys" && c.args.len() == 0) {
        // Element-kind flag (#4353): 0 = scalar i32 column →
        // the register backends snapshot-copy (the `var ks =
        // m.keys()` binding is is_arr-marked and exit-swept,
        // which reclaims the fresh copy — NOT the map's live
        // buffer, as the historical alias made it). 2 =
        // string column → retaining snapshot
        // (__fern_map_snapshot_col_str), emitted at THIS
        // expression position too since #5335: map_owncols
        // now owns string-column maps, whose grow path frees
        // the superseded buffer — a raw-buffer alias here
        // (the historical clamp to flag 1) would dangle the
        // moment a later insert grows the map. The snapshot
        // copy + its per-element incs leak at this position
        // until a SARR-credited release lands (bounded per
        // read — strictly better than the old alias, which
        // was also native-divergent: native keys()/values()
        // are snapshots). 1 = i64/f64/struct/generic column
        // → raw-buffer alias (owncols stays clear).
        var mks: LowerState = lower_expr(fa.obj, s);
        if (!mks.ok) { return mks; }
        return mks.emit(ir.op_map_keys(map_kv_elem_flag(mtype, "keys")));
    }
    if (fa.field == "values" && c.args.len() == 0) {
        var mvs: LowerState = lower_expr(fa.obj, s);
        if (!mvs.ok) { return mvs; }
        return mvs.emit(ir.op_map_values(map_kv_elem_flag(mtype, "values"), map_value_widekind(map_value_of(mtype))));
    }
    if (fa.field == "iter" && c.args.len() == 0) {
        // m.iter() -> a fresh MapIter box [map_ptr@0, cursor@8].
        // The result's MapIter[K,V] type is recorded at the
        // annotated var-decl (so it.has_next()/key()/... dispatch);
        // here we just emit the box-building op.
        var mit: LowerState = lower_expr(fa.obj, s);
        if (!mit.ok) { return mit; }
        return mit.emit(ir.op_map_iter(map_value_widekind(map_value_of(mtype))));
    }
    // Not a built-in map op — a USER method on Map[K, V]
    // (`m.merge(other)`, `m.extend(...)`). Dispatch to the
    // "Map.<method>" label like a nominal-receiver method: the
    // receiver as arg 0, then the args (i64 / fn-value args
    // lowered specially, mirroring the prim-receiver path).
    // calls_only_known verifies the label resolves; otherwise
    // the module bails. Without this, map-tracking the receiver
    // (so built-in ops dispatch) would regress the user methods.
    var umm: LowerState = lower_expr(fa.obj, s);
    if (!umm.ok) { return umm; }
    var ummkey: string = "Map." + fa.field;
    var ummi: i32 = 0;
    while (ummi < c.args.len()) {
        var umfvn: string = fn_value_arg_name(c.args[ummi], umm);
        if (umfvn.len() > 0 && umm.callee_param_is_fn(ummkey, ummi)) { umm = umm.emit(ir.op_const_func(0, umfvn)); }
        else if (umm.param_is_i64(ummkey, ummi)) { umm = lower_i64(c.args[ummi], umm); }
        else { umm = lower_expr(c.args[ummi], umm); }
        if (!umm.ok) { return umm; }
        ummi = ummi + 1;
    }
    return umm.emit(ir.op_call_direct(ummkey, 1 + c.args.len()));
}

// lower_call_method lowers a call whose callee is a FIELD ACCESS: a receiver
// method call `recv.m(args)`, a call through a closure-valued field, and the
// Map / Cell method desugars.
function lower_call_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    // Reader.read_chunk(n) / Reader.close() — built-in resource
    // intrinsics. A Reader is just its fd (an i32; see stdin()), so
    // the receiver lowers as a plain i32 and the result is a fresh
    // Option box: read_chunk → Option[string] (Some(chunk) / None at
    // EOF), close and write → Option[IoError]. Mirrors the retired x86 AST
    // emitter's emit_method_call, but gated to a non-struct / non-enum /
    // non-string / non-array receiver so a user `.close()` on a real
    // struct still routes to struct-method dispatch below (the AST
    // backend intercepts unconditionally; this is strictly safer). No
    // wasm stdin, so wasm_eligible rejects read_chunk/reader_close.
    if ((fa.field == "read_chunk" || fa.field == "close" || fa.field == "write" || fa.field == "read_line")
        && !decl_is_struct(s.structs, expr_struct_type(fa.obj, s)) && expr_enum_type(fa.obj, s) == ""
        && !expr_is_str(fa.obj, s) && !expr_is_arr_src(fa.obj, s)) {
        // Reader.read_line() (#4369) -> Option[string] (Some(line incl.
        // '\n')/None@EOF). A Reader IS its fd, so the receiver lowers
        // as the fd op_read_line reads — reading fd 0 unconditionally
        // made `open_reader(p)` + `r.read_line()` count stdin's lines
        // for a file (#7758).
        if (fa.field == "read_line" && c.args.len() == 0) {
            var rls: LowerState = lower_expr(fa.obj, s);
            if (!rls.ok) { return rls; }
            return rls.emit(ir.op_read_line());
        }
        if (fa.field == "read_chunk" && c.args.len() == 1) {
            var rcs: LowerState = lower_expr(fa.obj, s);
            if (!rcs.ok) { return rcs; }
            rcs = lower_expr(c.args[0], rcs);
            if (!rcs.ok) { return rcs; }
            return rcs.emit(ir.op_read_chunk());
        }
        if (fa.field == "close" && c.args.len() == 0) {
            var rcl: LowerState = lower_expr(fa.obj, s);
            if (!rcl.ok) { return rcl; }
            return rcl.emit(ir.op_reader_close());
        }
        // Writer.write(s) (#4372): a Writer is a bare fd; lower the
        // receiver (fd) then the string arg (box), then write(2) the
        // box's bytes to the fd -> a fresh Option[IoError], None once
        // every byte is out (#7926). Gated to a non-struct/enum/str/
        // array receiver so a user `.write(x)` on a real type still
        // routes to struct-method dispatch below.
        if (fa.field == "write" && c.args.len() == 1) {
            var wws: LowerState = lower_expr(fa.obj, s);
            if (!wws.ok) { return wws; }
            wws = lower_expr(c.args[0], wws);
            if (!wws.ok) { return wws; }
            return wws.emit(ir.op_writer_write());
        }
    }
    // A function-VALUE tuple element call `t.N(args)` — `t.N` is a
    // numeric tuple index whose element is a fn value (tagged "fn"
    // at construction by elem_type_tag). Lower the args, then the
    // tuple element (tuple_get → the fn pointer on TOS), and
    // call_indirect — the same shape the "fn"-typed struct field
    // uses (#3016). Gated on the element tag being "fn", so a normal
    // numeric tuple read falls through.
    if (util.is_all_digits(fa.field)) {
        var tfn: i32 = util.digits_to_i32(fa.field);
        if (expr_tuple_elem_tag(fa.obj, tfn, s) == "fn") {
            var tfs: LowerState = s;
            for arg in c.args {
                tfs = lower_expr(arg, tfs);
                if (!tfs.ok) { return tfs; }
            }
            tfs = lower_expr(fa.obj, tfs);
            if (!tfs.ok) { return tfs; }
            tfs = tfs.emit(ir.op_tuple_get(tfn));
            return tfs.emit(ir.op_call_indirect_sig(c.args.len(),
                callee_fn_sig_declared(tuple_elem_fn_sig(fa.obj, tfn, s), c, false)));
        }
        // A closure-BOX tuple element call ("clo" — a lambda /
        // wrapped fn the lift boxed, or a declared fn-typed
        // element of a factory-returned tuple): env-first, the
        // same shape as a closure-array element call. Stash the
        // box (tuple_get) in a temp, push it as the hidden
        // __env first arg, the declared args, then box[0] as
        // the target, call_indirect(arity+1).
        if (expr_tuple_elem_tag(fa.obj, tfn, s) == "clo") {
            var tcs: LowerState = lower_expr(fa.obj, s);
            if (!tcs.ok) { return tcs; }
            tcs = tcs.emit(ir.op_tuple_get(tfn));
            var tctmp: string = "$tupclo" + util.i32_to_string(tcs.locals.len());
            tcs = tcs.add_local(tctmp);
            var tcslot: i32 = tcs.slot_of(tctmp);
            tcs = tcs.emit(ir.op_store_local(tcslot));
            tcs = tcs.emit(ir.op_load_local(tcslot));   // __env (the box)
            // One signature drives the width each argument is lowered at and
            // the funcref type the call names, as the fn-FIELD call does.
            var tsig: string = tuple_elem_fn_sig(fa.obj, tfn, s);
            var tai: i32 = 0;
            while (tai < c.args.len()) {
                tcs = lower_fn_value_arg_wc(c.args[tai], sig_arg_width_char(tsig, tai), tcs);
                if (!tcs.ok) { return tcs; }
                tai = tai + 1;
            }
            tcs = tcs.emit(ir.op_load_local(tcslot));
            tcs = tcs.emit(ir.op_const_i32(0));
            tcs = tcs.emit(ir.op_arr_get(32));
            return tcs.emit(ir.op_call_indirect_sig(c.args.len() + 1, callee_fn_sig_declared(tsig, c, true)));
        }
    }
    // A MapIter[K, V] receiver (`it.has_next()` / `.key()` /
    // `.value()` / `.advance()` on a `var it: MapIter[..]` local):
    // the four methods are compiler builtins with no body, lowered
    // inline to the mapiter ops (mirroring the AST emitter). Resolved
    // BEFORE the map-method block below so the MapIter type string
    // (stored in the same per-slot column as Map[K,V]) never enters
    // the map dispatch and bails at its user-method fallthrough.
    var itype: string = "";
    match (fa.obj) {
        ast.ExprIdent(itid) => {
            var itsl: i32 = s.slot_of(itid.name);
            if (itsl >= 0 && is_mapiter_type_name(s.map_type_of(itsl))) { itype = s.map_type_of(itsl); }
        },
        _ => {}
    }
    if (itype != "") {
        if (fa.field == "has_next" && c.args.len() == 0) {
            var ihn: LowerState = lower_expr(fa.obj, s);
            if (!ihn.ok) { return ihn; }
            return ihn.emit(ir.op_mapiter_has_next());
        }
        if (fa.field == "key" && c.args.len() == 0) {
            var ik: LowerState = lower_expr(fa.obj, s);
            if (!ik.ok) { return ik; }
            return ik.emit(ir.op_mapiter_key());
        }
        if (fa.field == "value" && c.args.len() == 0) {
            var iv2: LowerState = lower_expr(fa.obj, s);
            if (!iv2.ok) { return iv2; }
            return iv2.emit(ir.op_mapiter_value(map_value_wide(mapiter_value_of(itype))));
        }
        if (fa.field == "advance" && c.args.len() == 0) {
            var iadv: LowerState = lower_expr(fa.obj, s);
            if (!iadv.ok) { return iadv; }
            return iadv.emit(ir.op_mapiter_advance());
        }
    }
    var mrslot: i32 = 0 - 1;
    var mtype: string = "";
    match (fa.obj) {
        ast.ExprIdent(mrid) => {
            mrslot = s.slot_of(mrid.name);
            mtype = s.slot_map_type(mrid.name);
        },
        // A Map-typed struct FIELD receiver (`c.m.get_or(k, d)`):
        // resolve the map type from the field's declaration so the
        // map op dispatches (the field read lowers fa.obj to push
        // the map pointer, same as a local). #map-struct-field.
        ast.ExprFieldAccess(mrfa) => {
            if (!util.is_all_digits(mrfa.field)) {
                var moty: string = expr_struct_type(mrfa.obj, s);
                if (moty != "") {
                    var mft: string = decl_field_type(s.structs, moty, mrfa.field);
                    // is_map_type_name is a bare `Map[` prefix test, so a
                    // `Map[K, V][]` FIELD passes it — and typing that array as a
                    // map sends `r.rows.len()` to op_map_len over array memory.
                    // Same trap as the ident arms (slot_map_type); the element
                    // read is the ExprIndex arm's job, not this one.
                    if (is_map_type_name(mft) && !is_array_type_name(mft)) { mtype = mft; }
                }
            } else {
                // A map TUPLE element receiver (`t.0.get_or(k, d)`):
                // the element's recorded tuple tag is its Map[K,V]
                // type, so the map op dispatches. lower_expr(fa.obj)
                // reads the element (tuple_get pushes the map ptr),
                // same as a struct field. #3317.
                var mtt: string = expr_tuple_elem_tag(mrfa.obj, util.digits_to_i32(mrfa.field), s);
                if (is_map_type_name(mtt) && !is_array_type_name(mtt)) { mtype = mtt; }
            }
        },
        // A map ARRAY element receiver (`ms[i].get_or(k, d)`): the
        // array slot's recorded element map type drives dispatch;
        // lower_expr(fa.obj) reads the element (arr_get pushes the
        // map ptr), same as a struct-array element. #3317.
        ast.ExprIndex(mrix) => {
            match (mrix.array) {
                ast.ExprIdent(maid) => {
                    var maslot: i32 = s.slot_of(maid.name);
                    if (maslot >= 0 && s.is_arr_slot(maslot) && is_map_type_name(s.map_type_of(maslot))) { mtype = s.map_type_of(maslot); }
                },
                // The same element read off a TUPLE element (`t.0[i].get(k)`)
                // or a STRUCT FIELD (`r.rows[i].get(k)`). Neither has a slot to
                // carry the element map type, but both spell their own type as
                // `Map[K, V][]`, so the element type is that with the array
                // suffix dropped.
                ast.ExprFieldAccess(mafa) => {
                    var mabase: string = "";
                    if (util.is_all_digits(mafa.field)) {
                        mabase = expr_tuple_elem_tag(mafa.obj, util.digits_to_i32(mafa.field), s);
                    } else {
                        var maoty: string = expr_struct_type(mafa.obj, s);
                        if (maoty != "") { mabase = decl_field_type(s.structs, maoty, mafa.field); }
                    }
                    mtype = map_elem_of_array_type(mabase);
                },
                _ => {}
            }
        },
        // A map-returning CALL receiver (`a.merge(b).get_or(k, d)` —
        // after register_map_method_generics this is
        // `__mapm_merge(a, b).get_or(k, d)`, an ExprIdent callee; or a
        // map-returning free fn / a still-method form): recover the
        // map type from the callee's registered map return type
        // (map_ret_fns), so a map op chained directly onto the result
        // dispatches instead of mis-dispatching `i32.<op>`. The bound-
        // var form already works via the annotation / map_ret recovery;
        // this is the un-bound chained sibling. lower_expr(fa.obj) emits
        // the call and leaves the map ptr on the stack, same as a local.
        ast.ExprCall(mrcall) => {
            match (mrcall.callee) {
                ast.ExprIdent(mrcid) => {
                    var mrtf: string = s.map_ret_type(mrcid.name);
                    if (is_map_type_name(mrtf)) { mtype = mrtf; }
                },
                ast.ExprFieldAccess(mrcfa) => {
                    if (!util.is_all_digits(mrcfa.field)) {
                        var rbase: string = expr_struct_type(mrcfa.obj, s);
                        if (rbase == "") {
                            match (mrcfa.obj) {
                                ast.ExprIdent(mrcrid) => {
                                    if (is_map_type_name(s.map_type_of(s.slot_of(mrcrid.name)))) { rbase = "Map"; }
                                },
                                _ => {}
                            }
                        }
                        if (rbase != "") {
                            var mrtm: string = s.map_ret_type(rbase + "." + mrcfa.field);
                            if (is_map_type_name(mrtm)) { mtype = mrtm; }
                        }
                    }
                },
                _ => {}
            }
            // Fallback for a chained BUILTIN map method
            // (`m.insert(k,v).len()` / `.set(..).get_or(..)`): the
            // registry above only knows the generic verbs
            // (merge/extend/...), and a nested-call receiver can't
            // resolve `rbase`, so recover the result's Map[K,V]
            // structurally via expr_map_type_tag (which recurses
            // through insert/set/delete). Without this the chained
            // op mis-dispatched to op_arr_len (read the map box's
            // keys[] ptr as a length → garbage).
            if (mtype == "") {
                var mctag: string = expr_map_type_tag(fa.obj, s);
                if (is_map_type_name(mctag)) { mtype = mctag; }
            }
        },
        _ => {}
    }
    if (mtype != "") {
        return lower_call_map_method(c, fa, mtype, s);
    }
    // `.insert(k, v)` on a map-typed EXPRESSION (not a local) — the
    // chained construction a `Map { k: v, … }` literal desugars to:
    // `map_new[_i32](n).insert(k0,v0).insert(k1,v1)…`. The receiver
    // lowers (recursively, so the inner inserts lower the same way)
    // to a map on the stack; op_map_set consumes [map, key, value]
    // and returns the map. The key kind comes from expr_map_kind
    // (map_new vs map_new_i32 at the chain's base). Read methods on
    // a map-literal expression aren't needed — the literal binds to
    // a typed local, and reads go through the map-local path above.
    if ((fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
        var emk: i32 = expr_map_kind(fa.obj, s);
        if (emk >= 0) {
            var emset: LowerState = lower_expr(fa.obj, s);
            if (!emset.ok) { return emset; }
            emset = lower_expr(c.args[0], emset);
            if (!emset.ok) { return emset; }
            var emtt: string = expr_map_type_tag(fa.obj, s);
            // Same 8-byte i64/u64 value handling as the map-local
            // insert path above (#5253) — the map-LITERAL chain
            // (`Map { … }` → map_new.insert…) lowers here.
            var emvw: boolean = map_insert_val_is_i64(emtt, c.args[1], s);
            if (emvw) { emset = lower_i64(c.args[1], emset); }
            else { emset = lower_expr(c.args[1], emset); }
            if (!emset.ok) { return emset; }
            // f64 values: widekind 2 (wasm defers); i64/u64 is
            // widekind 1 (wasm boxes an 8-byte cell) — lowering of
            // f64 stays on lower_expr (#5253).
            var emwk: i32 = 0;
            if (emvw) { emwk = 1; }
            else if (map_value_of(emtt) == "f64" || expr_is_f64(c.args[1], s)) { emwk = 2; }
            return emset.emit(ir.op_map_set(emk, map_value_is_ptr(map_value_of(emtt)) || insert_value_is_ptr(c.args[1], s), map_insert_value_consumed(c.args[1], s), is_fresh_str_temp(c.args[0], s), map_owncols(emtt), map_insert_value_retains(c.args[1], map_value_of(emtt), s), map_key_eqfn(emtt), emwk));
        }
    }
    // Qualified built-in Option/Result construction:
    // `Option.Some(x)` / `Result.Ok(x)` / `Result.Err(x)` lower
    // identically to the bare Some/Ok/Err forms (op_opt_make). The
    // native compiler accepts both spellings; without this the
    // qualified form bailed the module to AST. The checker has
    // already validated the owner/variant pairing, so the field
    // name alone selects the tag (Some/Ok -> 0, Err -> 1).
    match (fa.obj) {
        ast.ExprIdent(qoid) => {
            if ((qoid.name == "Option" || qoid.name == "Result") && s.slot_of(qoid.name) < 0) {
                if ((fa.field == "Some" || fa.field == "Ok") && c.args.len() == 1) {
                    return lower_opt_make_payload(0, c.args[0], s);
                }
                if (fa.field == "Err" && c.args.len() == 1) {
                    return lower_opt_make_payload(1, c.args[0], s);
                }
            }
        },
        _ => {}
    }
    // Qualified payload-variant construction `Enum.Variant(args)`
    // — the same value as the bare `Variant(args)` (both build the
    // variant's shape-named struct box via struct_make). The native
    // compiler accepts both spellings; the self-host IR path only
    // handled the bare form, so a qualified construction made the
    // module IR-ineligible. Recognise it
    // here: `fa.field` is a variant DECLARED BY the bare type name in
    // `fa.obj` (not a local), so `Enum.Variant` is variant construction,
    // not a method/assoc call. Asked of that enum rather than of the
    // variant name alone — two enums may declare the same name, and the
    // by-name lookups answer for whichever was declared first. The arity
    // and field widths are read through the resolved INDEX for the same
    // reason.
    match (fa.obj) {
        ast.ExprIdent(qvid) => {
            var qvi: i32 = variant_decl_index(s.structs, fa.field, qvid.name);
            if (qvi >= 0 && s.slot_of(qvid.name) < 0) {
                if (!decl_is_leaksafe(s.structs, fa.field)) { return s.fail(); }
                if (c.args.len() != s.structs[qvi].fields.len()) { return s.fail(); }
                var qv: LowerState = lower_variant_ctor_args(c.args, qvi, s.selfrebind, s.with_selfrebind(""));
                if (!qv.ok) { return qv; }
                return qv.emit(ir.op_struct_make(fa.field, c.args.len(), qvi));
            }
        },
        _ => {}
    }
    // xs.sum() / xs.product() on an i32[] — receiver-only builtins
    // backed by Fern helpers (asmcore.fern's __fern_arr_i32_sum /
    // _product). Receiver-only is the shape that already works through
    // op_call_direct (cf. __fern_i32_to_string); the argument-taking
    // builtins use dedicated ops instead. Also needs the helper in
    // ircore.is_fern_helper (else calls_only_known bails the module to
    // AST) and the symbol in emit_runtime_globls (else a library unit
    // dangles at the per-module link).
    //
    // The receiver guard mirrors the `.len()` dispatch just below:
    // an array source that is NOT string[] / f64[] / i64[]. Those
    // exclusions are load-bearing — the helper reads 8-byte i32 slots,
    // so admitting an f64[] would sum float bit patterns as integers.
    // xs.index_of(x) / xs.contains(x) on an i32[] — helper-backed like
    // sum/product, but with an ARGUMENT, so the operand order rule from
    // #5666 applies: the callee binds params in reverse push order, so
    // the target is pushed first and the array (param[0]) second.
    // asm.fern's own comment at this intercept says the same — "push
    // args right-to-left (target then array) so the array is param[0]".
    // `contains` reads the raw scan as `>= 0`; `index_of` returns Option[i32]
    // and so calls the Option-boxing helper instead of the sentinel one — the
    // min/max shape, with the box built inside the Fern helper rather than
    // hand-emitted here. Same receiver guard as below.
    if ((fa.field == "index_of" || fa.field == "contains") && c.args.len() == 1
        && arr_i32_recv(fa.obj, s)) {
        var pidx: LowerState = lower_expr(c.args[0], s);
        if (!pidx.ok) { return pidx; }
        pidx = lower_expr(fa.obj, pidx);
        if (!pidx.ok) { return pidx; }
        if (fa.field == "index_of") {
            return pidx.emit(ir.op_call_direct("__fern_arr_i32_index_of_opt", 2));
        }
        pidx = pidx.emit(ir.op_call_direct("__fern_arr_i32_index_of", 2));
        pidx = pidx.emit(ir.op_const_i32(0));
        return pidx.emit(ir.op_bin("ge_s", 0, false));
    }
    if ((fa.field == "sum" || fa.field == "product") && c.args.len() == 0
        && arr_i32_recv(fa.obj, s)) {
        var parr: LowerState = lower_expr(fa.obj, s);
        if (!parr.ok) { return parr; }
        if (fa.field == "sum") { return parr.emit(ir.op_call_direct("__fern_arr_i32_sum", 1)); }
        return parr.emit(ir.op_call_direct("__fern_arr_i32_product", 1));
    }
    // xs.min() / xs.max() on an i32[] — receiver-only like
    // sum/product, but the first helper-backed builtin with a
    // COMPOSITE return: Option[i32], Some(extremum) on a non-empty
    // array and None on an empty one. The AST emitter open-coded the
    // `len == 0` branch and both 16-byte boxes around a raw-extremum
    // helper; here the guard and the box live INSIDE the Fern helper
    // (asmcore.rt_src_arr_i32_min_max_opt), so the call site is an
    // unconditional call and no Option construction is hand-emitted
    // as IR ops. The composite return needs one thing the scalar
    // helpers did not: the helper is not in the module's funcs, so
    // opt_ret_fns_of cannot see its return type and `match (xs.min())`
    // would bail — builtin_arr_opt_ret_type is what the scrutinee
    // resolvers consult instead. Same receiver guard as sum/product.
    if ((fa.field == "min" || fa.field == "max") && c.args.len() == 0
        && arr_i32_recv(fa.obj, s)) {
        var pmm: LowerState = lower_expr(fa.obj, s);
        if (!pmm.ok) { return pmm; }
        if (fa.field == "min") { return pmm.emit(ir.op_call_direct("__fern_arr_i32_min_opt", 1)); }
        return pmm.emit(ir.op_call_direct("__fern_arr_i32_max_opt", 1));
    }
    // xs.first() / xs.last() — O(1) element reads the AST emitter
    // open-coded as raw loads off the array header. Lowered as the
    // equivalent INDEX read, so the element width, the bounds check
    // and the element rc handling all come from the one ExprIndex
    // arm instead of a second copy. That makes `.first()`
    // bounds-CHECKED where the AST emitter read the header word as
    // an element — a UB program aborts instead of returning
    // garbage, which is the safer disagreement.
    //
    // f64[] / i64[] receivers are excluded, like the sum / index_of
    // / min / max intercepts above: their element reads lower in the
    // WIDE contexts (lower_i64 / the f64 path), which do not route
    // through this ExprCall arm, so `var v: i64 = xs.last()` would
    // read a 4-byte slot. An f64[][] / i64[][] receiver is fine —
    // the ELEMENT is a pointer, and the classifiers below recover
    // its width for the following `[j]`.
    if (arr_firstlast_call(fa.field, fa.obj, c.args.len(), s)
        && !expr_is_f64arr(fa.obj, s) && !expr_is_i64arr(fa.obj, s)) {
        return lower_call_arr_firstlast(c, fa, s);
    }
    // s.first_byte() / s.last_byte() — inline byte reads in the AST
    // emitter (asm.fern:2057/2065), i.e. exactly s[0] and s[len-1], so
    // they reuse the existing string-index op rather than emitting raw
    // loads. NOTE the operand order is NATURAL here (string then index):
    // that is the op_* convention, unlike op_call_direct to a Fern
    // helper, which binds params in REVERSE push order (#5666).
    //
    // last_byte reads the receiver TWICE (once for the length, once as
    // the indexed string), so it goes through a temp local — the #5661
    // abs/sign pattern — instead of lowering the subtree again, which
    // would evaluate a side-effecting receiver twice.
    if ((fa.field == "first_byte" || fa.field == "last_byte") && c.args.len() == 0
            && expr_is_str(fa.obj, s)) {
        return lower_call_first_byte(c, fa, s);
    }
    // x.is_empty() desugars to `x.len() == 0` and re-lowers, rather
    // than emitting its own len op. The `.len()` arm below carries real
    // machinery a duplicate would have to clone — notably the fresh
    // string-concat receiver reclaim (`(a + b).is_empty()` strands a temp
    // box otherwise, #4365) — and it already dispatches str vs arr length.
    // Reusing it also means is_empty covers every receiver `.len()` does
    // (string, i32[]/f64[]/i64[] arrays, string[]), matching the AST
    // emitter's guard, which spans all of them rather than strings alone.
    if (fa.field == "is_empty" && c.args.len() == 0
        && (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s) || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s)
            || !decl_is_struct(s.structs, expr_struct_type(fa.obj, s)))) {
        var lenc: ast.Expr = ast.ExprCall {
            callee: ast.ExprFieldAccess { obj: fa.obj, field: "len", line: fa.line, col: fa.col, ty: "" },
            args: [], line: c.line, col: c.col, type_argc: 0, ty: "",
        };
        var iszero: ast.Expr = ast.ExprBinary {
            op: "==", left: lenc,
            right: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: c.line, col: c.col },
            line: c.line, col: c.col, ty: "",
        };
        return lower_expr(iszero, s);
    }
    if (fa.field == "len" && c.args.len() == 0
        && (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s) || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s)
            || !decl_is_struct(s.structs, expr_struct_type(fa.obj, s)))) {
        return lower_call_len(c, fa, s);
    }
    // `arr.append(e)` as a general EXPRESSION (return position,
    // var-init, an argument): lower the array receiver + the
    // element, then grow via the width-matched arr_push, leaving
    // the grown array on the stack. (The `out = out.append(e)`
    // reassign-self form is lowered in StmtAssign; this is the
    // non-self form — e.g. std/string split/splitn/chunks end with
    // `return out.append(s[start:n])`.) The element width follows
    // the receiver's element kind, mirroring the reassign path.
    // RC: arr_push consumes the receiver array and yields the grown
    // one; StmtReturn excludes a moved receiver ident from its exit
    // dec-sweep so the consumed buffer isn't also freed.
    // `s.xs.append(v)` on a scalar-element array struct FIELD read:
    // the field is a borrowed, possibly-shared array (it does NOT
    // match expr_is_arr_src — a bare field access isn't an array
    // source), so the consume-form arr_push below would corrupt
    // `s.xs`. Use the CLONE form (clone then grow the sole-owned
    // clone), the same sound shape as the value-producing `.with`.
    // This is what admits the immutable-update idiom
    // `State { xs: s.xs.append(v), … }` as a struct-field value.
    // An ARRAY-OF-ARRAY field (`xs: i32[][]`) takes the same clone form: its
    // elements are row POINTERS in the 4-byte slots arr_slice / arr_push
    // already copy, and the field is leak-only (no drop arm classifies it), so
    // the rows the clone shares with the source outlive both (#7208).
    if (fa.field == "append" && c.args.len() == 1
        && (scalar_arr_field_type(fa.obj, s) != ""
            || strarr_field_read_type(fa.obj, s) != ""
            || struct_arr_field_read_type(fa.obj, s) != ""
            || enum_arr_field_read_type(fa.obj, s) != ""
            || nested_arr_field_read_type(fa.obj, s) != "")) {
        return lower_arr_append_value(fa.obj, c.args[0], s);
    }
    if (fa.field == "append" && c.args.len() == 1
        && (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s) || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s))) {
        return lower_call_append(c, fa, s);
    }
    // `arr.with(i, v)` as a general VALUE-PRODUCING EXPRESSION (a
    // var-init `var b = a.with(i, v)`, an argument, a struct-field
    // value `State { xs: s.xs.with(i, v), … }`): evaluates to a FRESH
    // array = a clone of the receiver with element i replaced by v,
    // leaving the receiver UNMUTATED. This is the sound counterpart
    // to the in-place self-reassign form `a = a.with(i, v)` (handled
    // in StmtAssign): there the slot is the sole owner so the store
    // is in place; here the receiver may be shared (an ident the
    // caller still holds, or a borrowed `s.xs` field read), so we
    // CLONE then set into the clone (lower_arr_with_value). Fires for
    // any leak-safe scalar / string-element array source — an array
    // local / fresh array / slice (expr_is_arr_src & friends) — or an
    // array struct-field read of any element kind the field classifiers
    // recognise: scalar, array-of-struct, array-of-enum, or array-of-array
    // (#7208). Every one of those clones the buffer SHALLOW, which is what
    // keeps the pointer-element kinds sound: their elements are owned by the
    // source struct and freed by neither copy.
    if (fa.field == "with" && c.args.len() == 2
        && (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s)
            || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s)
            || scalar_arr_field_type(fa.obj, s) != ""
            || struct_arr_field_read_type(fa.obj, s) != ""
            || enum_arr_field_read_type(fa.obj, s) != ""
            || nested_arr_field_read_type(fa.obj, s) != "")) {
        return lower_arr_with_value(fa.obj, c.args[0], c.args[1], s);
    }
    // `arr.to_json()` on an ARRAY receiver — the element-poly
    // `(xs: T[]) to_json[T: Json]()` serialiser from std/json.
    // The self-host emits the generic body ONCE by erasure, so it
    // can't dispatch the per-element `xs[i].to_json()` on `T`
    // (it bakes in the i32 impl). But at THIS call site the array's
    // element type is known, so desugar to an inline loop that
    // builds `[e0,e1,…]` where each `arr[i].to_json()` lowers with
    // the element type in hand — dispatching to the right impl
    // (i32 / string / a derived struct's `to_json`). #2766.
    // A scalar-array FIELD read (`self.items` where items: i32[]) is admitted
    // the same way the `.with` arm above admits it. expr_is_arr_src is
    // deliberately NOT widened for this: it means array SOURCE — a fresh/owned
    // array — and drives rc decisions, whereas a field read is a borrow.
    // Without the field case here a derived `to_json` fell past this guard to
    // the primitive-receiver path and serialised the array POINTER
    // (`{"items":268435472}`); the string[] field was already fine because
    // expr_is_strarr covers a field read (#6009).
    if (fa.field == "to_json" && c.args.len() == 0
        && (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s) || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s)
            || scalar_arr_field_type(fa.obj, s) != "")) {
        return lower_array_to_json(fa.obj, s);
    }
    // `s.bytes()` / `s.as_bytes()` on a string receiver → a fresh
    // u8[] (one i32 slot per byte). The self-host slot-array model
    // has no zero-copy slice view, so as_bytes returns the same
    // fresh array as bytes (matches the AST path). Result is an
    // array — see expr_is_arr / lower_arr's mirror cases.
    if ((fa.field == "bytes" || fa.field == "as_bytes") && c.args.len() == 0 && expr_is_str(fa.obj, s)) {
        var sb: LowerState = lower_expr(fa.obj, s);
        if (!sb.ok) { return sb; }
        return sb.emit(ir.op_str_bytes());
    }
    // `xs.join(sep)` on a string[] receiver → a fresh joined
    // string, via the __fern_arr_str_join runtime helper (the same
    // Fern function the AST emitters call — asmcore.rt_src_arr_str_join).
    // Kept out of line (lower_arr_str_join) so this arm stays under
    // the self-host oversized-function threshold (#2720). #5328.
    if (fa.field == "join" && c.args.len() == 1 && expr_is_strarr(fa.obj, s)) {
        return lower_arr_str_join(fa.obj, c.args[0], s);
    }
    // String builtin methods on a string receiver: the 0-arg
    // transforms `to_upper` / `to_lower` (→ fresh string),
    // `s.split(sep)` (→ string[]), and the scalar predicates
    // `starts_with` / `ends_with` / `index_of` / `contains`. The
    // per-field emission lives in lower_str_method, kept out of line
    // so this already-enormous lower_expr arm doesn't grow past the
    // self-host backend's oversized-function miscompile threshold
    // (#2720 — folding it in here crashed the stage-2 self-compile).
    if (is_str_builtin_method(fa.field) && c.args.len() == str_method_argc(fa.field) && expr_is_str(fa.obj, s)) {
        return lower_str_method(fa.field, fa.obj, c.args, s);
    }
    // Builtin `.to_string()` on a PRIMITIVE receiver — distinct
    // from a struct's generated `to_string` (a @derive(Display)
    // method), which the struct-method path below dispatches via
    // its `<Struct>.to_string` label. A string receiver returns
    // unchanged (`"x".to_string() == "x"`); an i32 routes to the
    // __fern_i32_to_string runtime helper (decimal-text box). Only
    // fires when the receiver is a string or i32 primitive; struct /
    // enum / f64 / i64 receivers fall through (expr_recv_prim_type
    // returns "" for struct+enum, so those reach the method paths).
    if (fa.field == "to_string" && c.args.len() == 0) {
        if (expr_is_str(fa.obj, s)) { return lower_expr(fa.obj, s); }
        // A u32 VALUE expression — an `as u32` cast or u32
        // arithmetic/shift (expr_is_u32 is deliberately FALSE for a
        // u32-RETURNING call, which already resolves to the u32
        // to_string method via struct_ret_type/expr_struct_type).
        // Format it UNSIGNED via the __fern_u32_to_string runtime
        // helper: the signed __fern_i32_to_string mis-renders a value
        // with bit 31 set (e.g. `(0 as u32) - (1 as u32)` = 4294967295
        // → "/"), reading the low 32 bits as a negative i32 in its
        // digit loop. Must come BEFORE the i32 fallback. (#2649 —
        // exposed when i32_to_string moved from the tolerant 64-bit
        // hand-asm to the strict-i32 Fern helper.)
        if (expr_is_u32(fa.obj, s)) {
            var u2s: LowerState = lower_expr(fa.obj, s);
            if (!u2s.ok) { return u2s; }
            // Route to the UNSIGNED __fern_u32_to_string runtime
            // helper (an is_fern_helper, so calls_only_known keeps the
            // module IR-eligible; ir_helper_symbol targets
            // __fn___fern_u32_to_string). NOT std/u32's method — this
            // works without `import "std/u32"`, like the i32 builtin.
            return u2s.emit(ir.op_call_direct("__fern_u32_to_string", 1));
        }
        if (expr_recv_prim_type(fa.obj, s) == "i32") {
            var t2s: LowerState = lower_expr(fa.obj, s);
            if (!t2s.ok) { return t2s; }
            return t2s.emit(ir.op_call_direct("__fern_i32_to_string", 1));
        }
        // The WIDE receivers (#5826). Without these an i64/u64
        // `.to_string()` falls through to the method paths, which
        // resolve an `i64.to_string` label that only exists with
        // `import "std/i64"` — so the call matches nothing and the
        // whole MODULE bails. f-strings desugar to `.to_string()`,
        // so `f"{n}"` over any wide value bailed too, which is what
        // made this one of the broader remaining subset holes.
        //
        // u64 first, for the same reason u32 precedes i32 above: a
        // u64 is also width-64, and the SIGNED formatter renders a
        // value with bit 63 set as negative. expr_recv_prim_type
        // already orders its own u64-before-i64 check, so reading it
        // once and comparing is enough.
        var wrt: string = expr_recv_prim_type(fa.obj, s);
        if (wrt == "u64") {
            var u6s: LowerState = lower_wide_to_string_recv(fa.obj, s);
            if (!u6s.ok) { return u6s; }
            return u6s.emit(ir.op_call_direct("__fern_u64_to_string", 1));
        }
        if (wrt == "i64") {
            var i6s: LowerState = lower_wide_to_string_recv(fa.obj, s);
            if (!i6s.ok) { return i6s; }
            return i6s.emit(ir.op_call_direct("__fern_i64_to_string", 1));
        }
    }
    // Built-in zero-arg i32 predicates. The AST emitter lowered these
    // inline (asm.fern's ty_is_i32 block) and the IR path did not, which
    // made every program calling one bail the whole module to the AST
    // emitter — the largest per-function category keeping asm.fern alive
    // (#3457). They need no new opcode and no runtime helper: each is the
    // equivalent expression over ops the IR already has.
    //
    // Every case lowers its receiver EXACTLY ONCE, so a side-effecting
    // receiver (`next().is_odd()`) still evaluates once. That is also why
    // `abs` / `sign` are NOT here: both need the value twice, so they want
    // a temp slot rather than a second lower_expr of the same subtree.
    //
    // The ASCII classifier / case family on a BYTE receiver
    // (#3457 slice 5). The AST emitter admitted both scalar tags at
    // its own gate because the checker has already rejected the
    // wrong pairing, so this mirrors that rather than re-splitting
    // them: `s[i]` is a u8 now (#5629), and every
    // classifier call site reads one. Each of these needs the
    // receiver at least twice, so lower_ascii_byte_method binds it
    // to a temp local (the abs/sign pattern).
    if (ascii_byte_method(fa.field) && c.args.len() == 0
        && ascii_byte_receiver(fa.obj, s)) {
        return lower_ascii_byte_method(fa.field, fa.obj, s);
    }
    // b.to_ascii_string() — a fresh 1-char string from the byte.
    // That is exactly `chr(b)`, which already lowers to the
    // __fern_chr runtime helper on every backend, so it desugars
    // rather than hand-emitting the two allocations the AST
    // emitter open-codes (asm.fern:1804). Re-lowering also picks up
    // chr's heap need and its string result typing for free.
    if (fa.field == "to_ascii_string" && c.args.len() == 0
        && ascii_byte_receiver(fa.obj, s)) {
        var tas: ast.Expr = ast.ExprCall {
            callee: ast.ExprIdent { name: "chr", line: fa.line, col: fa.col, ty: "" },
            args: [fa.obj], line: c.line, col: c.col, type_argc: 0, ty: "",
        };
        return lower_expr(tas, s);
    }
    // n.pow(k) — helper-backed like xs.sum() (#5664), but with a
    // scalar receiver and ONE argument, so it sits outside the zero-arg
    // block below. Same five-part requirement: lowering + is_fern_helper
    // + need mapping + emit_ir_runtime_fern_fn gate + globls export.
    // (An earlier hypothesis that arg-taking builtins need a dedicated
    // IR op was wrong — the missing piece was the need, not the op.)
    if (fa.field == "pow" && c.args.len() == 1 && expr_recv_prim_type(fa.obj, s) == "i32") {
        // Argument order: the callee binds params in REVERSE push
        // order, so the exponent is pushed first and the receiver
        // (base) second. Pushing receiver-then-arg gives pow(exp,
        // base) — which the symmetric cases (3.pow(3)) hide, so the
        // tests below use asymmetric ones.
        var ppow: LowerState = lower_expr(c.args[0], s);
        if (!ppow.ok) { return ppow; }
        ppow = lower_expr(fa.obj, ppow);
        if (!ppow.ok) { return ppow; }
        return ppow.emit(ir.op_call_direct("__fern_i32_pow", 2));
    }
    // n.gcd(m) / n.lcm(m) — the same helper-backed shape as pow,
    // and the same argument order (arg pushed first, receiver
    // second). Both are symmetric in their operands, so an order
    // slip would not show in a test; the pattern is copied from
    // pow rather than re-derived.
    //
    // Until this existed, `.gcd()` / `.lcm()` bailed the whole
    // module — but worse, the arm64 per-module
    // UNIT path emits __fern_i32_lcm unconditionally (i32_lcm is in
    // ircore.all_runtime_need_roots) and its body calls `.gcd()`,
    // so the generic primitive-receiver dispatch below lowered it as
    // a USER method to `i32.gcd` → an undefined `__fn_i32__gcd`.
    // That dangling reference is what blocked the arm64 over-budget
    // per-module rescue (#5940, #3457 slice 5).
    if ((fa.field == "gcd" || fa.field == "lcm") && c.args.len() == 1
            && expr_recv_prim_type(fa.obj, s) == "i32") {
        var pgl: LowerState = lower_expr(c.args[0], s);
        if (!pgl.ok) { return pgl; }
        pgl = lower_expr(fa.obj, pgl);
        if (!pgl.ok) { return pgl; }
        if (fa.field == "gcd") { return pgl.emit(ir.op_call_direct("__fern_i32_gcd", 2)); }
        return pgl.emit(ir.op_call_direct("__fern_i32_lcm", 2));
    }
    // n.min(m) / n.max(m) — branchless (emit_i32_minmax_slots),
    // so no runtime helper. Store receiver + arg in temps (each
    // value is read several times) then compute; a side-effecting
    // receiver/arg is evaluated exactly once. Until this existed
    // they bailed the module (#3457 slice 5).
    if ((fa.field == "min" || fa.field == "max") && c.args.len() == 1
            && expr_recv_prim_type(fa.obj, s) == "i32"
            && !expr_is_u32(c.args[0], s) && !expr_is_u64(c.args[0], s)) {
        var amn: string = "$i32mmA" + util.i32_to_string(s.locals.len());
        var pmm: LowerState = s.add_local(amn);
        var amslot: i32 = pmm.slot_of(amn);
        var bmn: string = "$i32mmB" + util.i32_to_string(pmm.locals.len());
        pmm = pmm.add_local(bmn);
        var bmslot: i32 = pmm.slot_of(bmn);
        pmm = lower_expr(fa.obj, pmm);
        if (!pmm.ok) { return pmm; }
        pmm = pmm.emit(ir.op_store_local(amslot));
        pmm = lower_expr(c.args[0], pmm);
        if (!pmm.ok) { return pmm; }
        pmm = pmm.emit(ir.op_store_local(bmslot));
        return emit_i32_minmax_slots(pmm, amslot, bmslot, fa.field == "max");
    }
    // n.clamp(lo, hi) = min(max(n, lo), hi), composed from the
    // same branchless primitive over three temps.
    if (fa.field == "clamp" && c.args.len() == 2
            && expr_recv_prim_type(fa.obj, s) == "i32"
            && !expr_is_u32(c.args[0], s) && !expr_is_u64(c.args[0], s)
            && !expr_is_u32(c.args[1], s) && !expr_is_u64(c.args[1], s)) {
        return lower_call_clamp(c, fa, s);
    }
    if (c.args.len() == 0 && expr_recv_prim_type(fa.obj, s) == "i32") {
        if (fa.field == "is_zero" || fa.field == "is_positive" || fa.field == "is_negative") {
            var pcmp: LowerState = lower_expr(fa.obj, s);
            if (!pcmp.ok) { return pcmp; }
            pcmp = pcmp.emit(ir.op_const_i32(0));
            if (fa.field == "is_zero") { return pcmp.emit(ir.op_bin("eq", 0, false)); }
            if (fa.field == "is_positive") { return pcmp.emit(ir.op_bin("gt_s", 0, false)); }
            return pcmp.emit(ir.op_bin("lt_s", 0, false));
        }
        // Parity via `n & 1`, NOT `n % 2`: two's-complement AND yields 1
        // for a NEGATIVE odd n, where rem_s yields -1 and an `== 1` test
        // would call -3 even. Matches the AST emitter's `andq $1`.
        if (fa.field == "is_even" || fa.field == "is_odd") {
            var ppar: LowerState = lower_expr(fa.obj, s);
            if (!ppar.ok) { return ppar; }
            ppar = ppar.emit(ir.op_const_i32(1));
            ppar = ppar.emit(ir.op_bin("and", 0, false));
            if (fa.field == "is_even") { ppar = ppar.emit(ir.op_const_i32(0)); }
            else { ppar = ppar.emit(ir.op_const_i32(1)); }
            return ppar.emit(ir.op_bin("eq", 0, false));
        }
        // abs / sign need the receiver value TWICE. Store it into a
        // temp local once and re-load it, rather than lowering the
        // receiver subtree a second time — that would evaluate a
        // side-effecting receiver (`next().abs()`) twice. Slot naming
        // follows the saturating-arith temps ($sat*) above.
        if (fa.field == "abs" || fa.field == "sign") {
            var nname: string = "$i32n" + util.i32_to_string(s.locals.len());
            var pv: LowerState = s.add_local(nname);
            var nslot: i32 = pv.slot_of(nname);
            pv = lower_expr(fa.obj, pv);
            if (!pv.ok) { return pv; }
            pv = pv.emit(ir.op_store_local(nslot));
            if (fa.field == "sign") {
                // sign(n) = (n > 0) - (n < 0): 1, -1 or 0.
                pv = pv.emit(ir.op_load_local(nslot));
                pv = pv.emit(ir.op_const_i32(0));
                pv = pv.emit(ir.op_bin("gt_s", 0, false));
                pv = pv.emit(ir.op_load_local(nslot));
                pv = pv.emit(ir.op_const_i32(0));
                pv = pv.emit(ir.op_bin("lt_s", 0, false));
                return pv.emit(ir.op_bin("sub", 0, false));
            }
            // abs(n) = (n ^ m) - m where m = n >> 31 — all-ones for a
            // negative n, zero otherwise. Branchless, so it needs no
            // if/else scope, and it agrees with the AST emitter's
            // cmov-based negate-or-keep on every input including
            // i32 MIN (which both leave unchanged, wrapping).
            var mname: string = "$i32m" + util.i32_to_string(pv.locals.len());
            pv = pv.add_local(mname);
            var mslot: i32 = pv.slot_of(mname);
            pv = pv.emit(ir.op_load_local(nslot));
            pv = pv.emit(ir.op_const_i32(31));
            pv = pv.emit(ir.op_bin("shr_s", 0, false));
            pv = pv.emit(ir.op_store_local(mslot));
            pv = pv.emit(ir.op_load_local(nslot));
            pv = pv.emit(ir.op_load_local(mslot));
            pv = pv.emit(ir.op_bin("xor", 0, false));
            pv = pv.emit(ir.op_load_local(mslot));
            return pv.emit(ir.op_bin("sub", 0, false));
        }
    }
    // Associated-function call `Type.f(args)` — a receiver-less
    // impl method (e.g. a constructor `Point.make(x, y)` or a
    // derived `Enum.default()`). The callee object is a bare TYPE
    // name that is NOT a local slot (a same-named local would be a
    // value receiver, handled by the struct-method path below).
    // Lower the args with NO receiver and dispatch to the
    // "<Type>.<f>" label (the associated FuncDecl is keyed there by
    // module_has_func). The target is recognised as a STRUCT name
    // (decl_is_struct) or, for an enum / type-returning associated
    // fn, by a registered "<Type>.<f>" return type — never via
    // is_enum_like_name, which also matches MODULE names
    // (util/parser) and would hijack every `mod.func()` call. A
    // UNIT VARIANT is excluded (variant_enum_owner != "") — `Nil.m()`
    // is a receiver-method call on a variant value, not an
    // associated call on a type, so it falls through to the
    // enum-method dispatch below.
    match (fa.obj) {
        ast.ExprIdent(tid) => {
            if (s.slot_of(tid.name) < 0 && variant_enum_owner(s.structs, tid.name) == "" && (decl_is_struct(s.structs, tid.name) || s.struct_ret_type(tid.name + "." + fa.field) != "")) {
                var asf: LowerState = s;
                var afi: i32 = 0;
                while (afi < c.args.len()) {
                    if (asf.param_is_i64(tid.name + "." + fa.field, afi)) { asf = lower_i64(c.args[afi], asf); }
                    else { asf = lower_expr(c.args[afi], asf); }
                    if (!asf.ok) { return asf; }
                    afi = afi + 1;
                }
                return asf.emit(ir.op_call_direct(tid.name + "." + fa.field, c.args.len()));
            }
        },
        _ => {}
    }
    // Struct method call `p.method(args)` — static dispatch on the
    // receiver's tracked struct type to `call_direct("<Type>.<m>")`
    // with the receiver as arg 0 (matching the method's
    // `__fn_<Type>.<m>` label). calls_only_known verifies the method
    // exists, else the module bails.
    var rty: string = expr_struct_type(fa.obj, s);
    // Option/Result-receiver method call `o.method(args)` (impl on
    // Option[T] / Result[T, E]). expr_struct_type is "" for an
    // Option, so recover the receiver's opt-type (a local's tracked
    // type, a direct `Some(x)`, or an Option-returning call), then
    // dispatch call_direct("Option.<method>") — base_type_name
    // strips the payload, matching the emitted label — with the
    // receiver as arg 0, mirroring the struct-method path (#3031).
    var odt: string = opt_recv_base_type(fa.obj, s);
    if (odt != "") {
        var om: LowerState = lower_expr(fa.obj, s);
        if (!om.ok) { return om; }
        var oai: i32 = 0;
        while (oai < c.args.len()) {
            var ofvn: string = fn_value_arg_name(c.args[oai], om);
            if (ofvn.len() > 0 && om.callee_param_is_fn(odt + "." + fa.field, oai)) { om = om.emit(ir.op_const_func(0, ofvn)); }
            else if (om.param_is_i64(odt + "." + fa.field, oai)) { om = lower_i64(c.args[oai], om); }
            else { om = lower_expr(c.args[oai], om); }
            if (!om.ok) { return om; }
            oai = oai + 1;
        }
        return om.emit(ir.op_call_direct(odt + "." + fa.field, 1 + c.args.len()));
    }
    // `dyn Trait` method call: the receiver's concrete type is
    // known only at runtime. Spill the receiver (arg 0) + args
    // into argc consecutive temp locals, then op_dyn_dispatch —
    // the backend reads the receiver's shape pointer (from its
    // local) and dispatches to `<ConcreteType>.<method>`,
    // reloading the argc locals per arm. Spilling to locals (vs
    // leaving them on the stack) lets wasm — which can't index a
    // deep operand-stack slot — reload them.
    if (rty.len() > 4 && slice_unchecked(rty, 0, 4) == "dyn ") {
        return lower_call_dyn_method(c, fa, rty, s);
    }
    // A function-VALUE struct field call `h.f(args)` — `f` is a
    // "fn"-typed field, NOT a method. The lift pass (#3445) stores
    // EVERY fn-typed field as an env BOX `[funcval, caps…]`: a
    // capturing inline lambda → [$cloN, caps…], a no-capture lambda
    // / bare fn-name → a [$wrapN] env-taking trampoline (slot 0
    // only). So the call is UNIFORMLY env-first — the same sequence
    // a closure local / closure-array element uses: stash the field
    // box in a temp, push it as the `__env` first arg, lower the
    // declared args, push box[0] as the call target, and
    // call_indirect(arity+1). Without this the `<Type>.method`
    // dispatch below names a nonexistent "H.f" and the module bails.
    if (rty != "" && decl_field_type(s.structs, rty, fa.field) == "fn") {
        return lower_call_fn_field(c, fa, rty, s);
    }
    if (rty != "") {
        return lower_call_struct_method(c, fa, rty, s);
    }
    // Enum method called directly on a FRESH variant construction
    // (`Has(5).eq(other)`) or a bare unit variant (`A.method()`).
    // expr_struct_type doesn't type a fresh variant (it isn't a
    // local), so recover the enum from the variant's enum_owner and
    // dispatch to `<Enum>.<method>` with the constructed variant as
    // arg 0 — the same shape-pointer box `match`'s variant_is reads.
    var ety: string = expr_enum_type(fa.obj, s);
    if (ety != "") {
        var em: LowerState = lower_expr(fa.obj, s);
        if (!em.ok) { return em; }
        var em_lat: i32[] = [];
        var eai: i32 = 0;
        while (eai < c.args.len()) {
            // fn-value arg (const_func) before general lowering —
            // see the struct-method loop above (#2954 follow-up).
            var efvn: string = fn_value_arg_name(c.args[eai], em);
            if (efvn.len() > 0 && em.callee_param_is_fn(ety + "." + fa.field, eai)) { em = em.emit(ir.op_const_func(0, efvn)); }
            else if (em.param_is_i64(ety + "." + fa.field, eai)) { em = lower_i64(c.args[eai], em); }
            else {
                em = lower_expr(c.args[eai], em);
                var emst: ArgStash = stash_fresh_str_arg(em, c.args[eai], ety + "." + fa.field, eai);
                em = emst.state;
                if (emst.slot >= 0) { em_lat = em_lat.append(emst.slot); }
            }
            if (!em.ok) { return em; }
            eai = eai + 1;
        }
        em = em.emit(ir.op_call_direct(ety + "." + fa.field, 1 + c.args.len()));
        return free_stashed_str_args(em, em_lat);
    }
    // Array-receiver method `arr.<field>(args)` — the std/array
    // auto-discovered helper `__method_Array_<field>(arr, args)`.
    // The AST backend rewrote this at emit time (via
    // find_array_method_func); the IR sibling resolves the in-scope
    // helper name (find_arr_method) and lowers a free call with the
    // array as arg 0. Checked BEFORE the prim path — an array
    // receiver has no struct/enum type and expr_recv_prim_type would
    // otherwise fall back to "i32" and mis-dispatch `i32.<field>`.
    // Builtin array methods (.len / .append / .to_json / map ops)
    // are intercepted earlier, so only user/std array methods reach
    // here; a field with no __method_Array_ helper falls through to
    // the prim path (which bails via calls_only_known). Unblocks
    // std/array distinct / distinct_count / mode.
    if (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s) || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s)) {
        var amn: string = s.find_arr_method(fa.field);
        if (amn.len() > 0) {
            var ams: LowerState = lower_expr(fa.obj, s);
            if (!ams.ok) { return ams; }
            for arg in c.args {
                ams = lower_expr(arg, ams);
                if (!ams.ok) { return ams; }
            }
            return ams.emit(ir.op_call_direct(amn, 1 + c.args.len()));
        }
    }
    // Primitive-receiver method call `n.method(args)` (impl Trait
    // for i32/string/i64/f64) — derive the receiver's primitive
    // type and dispatch `call_direct("<Prim>.<method>")` with the
    // receiver as arg 0, mirroring the struct path. A label naming
    // a non-method `.field()` form (or absent method) bails the
    // module via calls_only_known, so this is safe to attempt.
    // Cell[T] method desugar (#5510): c.get() -> c[0],
    // c.set(x) -> c[0] = x (__set_index). Checked before the prim
    // path, which would otherwise mis-dispatch to "<T>.get".
    if (expr_is_cell(fa.obj, s)) {
        var czero: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
        if (fa.field == "get" && c.args.len() == 0) {
            return lower_expr(ast.ExprIndex { array: fa.obj, index: czero, unchecked: true, ty: "" }, s);
        }
        if (fa.field == "set" && c.args.len() == 1) {
            // c.set(x): store x into c[0] and leave the cell on the
            // stack (AST cell_set returns the cell, so value-position
            // use works and a statement drops it). A scratch local
            // holds the cell across the store. The store WIDTH follows
            // the element type: an i64/u64 cell stores 8 bytes via
            // lower_i64 + arr_set_i64, an f64/f32 cell via arr_set(64),
            // else the 32-bit path (i32 / string pointer) — mirroring
            // __set_index so a Cell[i64]/Cell[f64] is not truncated.
            var celt: string = cell_elem_type(fa.obj, s);
            var cscr: string = "$cellset" + util.i32_to_string(s.locals.len());
            var cst: LowerState = s.add_local(cscr);
            var ctmp: i32 = cst.slot_of(cscr);
            cst = lower_expr(fa.obj, cst);
            if (!cst.ok) { return cst; }
            cst = cst.emit(ir.op_store_local(ctmp));
            cst = cst.emit(ir.op_load_local(ctmp));
            cst = cst.emit(ir.op_const_i32(0));
            if (celt == "i64" || celt == "u64") {
                cst = lower_i64(c.args[0], cst);
                if (!cst.ok) { return cst; }
                cst = cst.emit(ir.op_arr_set_i64());
            } else if (celt == "f64" || celt == "f32" || celt == "float") {
                cst = lower_expr(c.args[0], cst);
                if (!cst.ok) { return cst; }
                cst = cst.emit(ir.op_arr_set(64));
            } else {
                cst = lower_expr(c.args[0], cst);
                if (!cst.ok) { return cst; }
                cst = cst.emit(ir.op_arr_set(32));
            }
            return cst.emit(ir.op_load_local(ctmp));
        }
    }
    var pty: string = expr_recv_prim_type(fa.obj, s);
    if (pty != "") {
        return lower_call_prim_method(c, fa, pty, s);
    }
    return s.fail();
}

// ── the fresh-owned-container READ reclaim (#6491) ───────────────────────────
//
// `mk()[i]` / `mk().f` read a value out of a container NOTHING NAMES, so the
// read is the only place that container can be reclaimed — there is no slot for
// the exit sweep to find. Native bounds both shapes; the self-host leaked the
// whole container per evaluation (measured 184 B a round on the three-read
// probe, exactly x2 per doubling, against 0 on all three native backends).
//
// This is the discarded-`mk(i);` statement reclaim one expression position over,
// and it deliberately borrows that site's admission rather than inventing one:
// the callee must be in the STRICT-fresh registry, so the returned box is the
// unambiguous sole owner (rc == 1) of itself and of every field buffer. The
// releases are the same rc-guarded helpers, so a shared box degrades to today's
// leak instead of dangling.
//
// SCALAR reads only. A pointer element/field ALIASES the container about to be
// freed, so it needs the retain-and-deep-drop pair plus a binding site that
// takes the read as a move — three sites that have to agree, and none of them
// is here. A scalar is copied out of the buffer, so nothing survives the release
// to dangle.

// owned_scalar_field_type reports whether a declared field type names a value
// that is COPIED out of its container rather than pointing back into it. Every
// scalar width plus `boolean`; `string` / arrays / structs / enums are pointers
// and are excluded. The index read needs no such test — its "ARR:" admission
// already restricts the container to a scalar-element array.
function owned_scalar_field_type(t: string): boolean {
    return is_scalar_type_name(t) || t == "boolean" || t == "f32"
        || t == "u8" || t == "i8" || t == "u16" || t == "i16" || t == "char";
}

// owned_fresh_call_callee: the callee NAME when `e` is a direct call to a
// function in the strict-fresh registry (`kind` "" for the struct entries,
// "ARR:" for the scalar-array ones), else "". A LOCAL callee is refused — the
// registry is keyed by declaration name and a same-named local holds an unknown
// closure body.
//
// A METHOD producer (`b.bump().tag`) answers under its "<Base>.<method>" key,
// the same one every other consumer of this registry reads. The receiver must
// be a bare LOCAL: expr_struct_type reports a struct-ARRAY-returning call's
// ELEMENT type (the `mk()[i].field` recovery), so a call receiver could name a
// method of a type the value is only an array OF, and a slot lookup cannot.
// A struct FIELD of the method's name is a fn-typed field call and names no
// method at all.
function owned_fresh_call_callee(e: ast.Expr, kind: string, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (s.slot_of(cid.name) >= 0) { return ""; }
                    if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, kind + cid.name) < 0) { return ""; }
                    return cid.name;
                },
                ast.ExprFieldAccess(cfa) => {
                    var rty: string = "";
                    match (cfa.obj) {
                        ast.ExprIdent(_) => { rty = expr_struct_type(cfa.obj, s); },
                        _ => { return ""; }
                    }
                    if (rty == "") { return ""; }
                    if (decl_field_type(s.structs, rty, cfa.field) != "") { return ""; }
                    var mkey: string = rty + "." + cfa.field;
                    if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, kind + mkey) < 0) { return ""; }
                    return mkey;
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// emit_freshself_release: release the temp box parked in `boxslot` unless it is
// the same pointer as the receiver parked in `recvslot`. A "FRESHSELF:" producer
// hands back a fresh box on one path and its receiver on the other, so only the
// runtime knows which arrived — the compare is the whole admission. The dec is
// SHALLOW: a fresh literal's field values are not proven owned here, so what the
// box does own leaks with it rather than being freed out from under a caller.
function emit_freshself_release(st: LowerState, boxslot: i32, recvslot: i32): LowerState {
    var r: LowerState = st.emit(ir.op_load_local(boxslot));
    r = r.emit(ir.op_load_local(recvslot));
    r = r.emit(ir.op_bin("ne", 0, false));
    r = r.emit(ir.op_if(0));
    r = r.emit(ir.op_load_local(boxslot));
    r = r.emit(ir.op_call_direct("__fern_rc_dec", 1));
    r = r.emit(ir.op_drop());
    return r.emit(ir.op_end());
}

// freshself_call_recv_slot: the RECEIVER's slot when `e` is a method call whose
// callee is in the "FRESHSELF:" registry — every return either a strict-fresh
// struct literal or the receiver itself — else -1. The result is then one of
// two boxes and only the runtime knows which, so the caller releases it under a
// pointer compare against this slot. The receiver must be a bare LOCAL for that
// compare to reload it without re-evaluating anything, which is the same
// restriction owned_fresh_call_callee's method arm carries.
function freshself_call_recv_slot(e: ast.Expr, s: LowerState): i32 {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    var rslot: i32 = 0 - 1;
                    match (cfa.obj) {
                        ast.ExprIdent(rid) => { rslot = s.slot_of(rid.name); },
                        _ => { return 0 - 1; }
                    }
                    if (rslot < 0) { return 0 - 1; }
                    var rty: string = expr_struct_type(cfa.obj, s);
                    if (rty == "") { return 0 - 1; }
                    if (decl_field_type(s.structs, rty, cfa.field) != "") { return 0 - 1; }
                    if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "FRESHSELF:" + rty + "." + cfa.field) < 0) { return 0 - 1; }
                    return rslot;
                },
                _ => { return 0 - 1; }
            }
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

// lower_expr lowers one expression, stamping the bail description on the way
// out of a failure (see LowerState.fail_why). The dispatch itself is
// lower_expr_dispatch; this wrapper is the only place the tag is computed, and
// it computes it only on the failing path, so the hot path pays one call.
pub function lower_expr(e: ast.Expr, s: LowerState): LowerState {
    if (!s.ok) { return s; }
    var r: LowerState = lower_expr_dispatch(e, s);
    if (r.ok) { return r; }
    return r.note_fail(expr_bail_tag(e));
}

// lower_expr_lambda lowers a lambda, hoisting a capturing one to its `$clo` form.
function lower_expr_lambda(lam: ast.ExprLambda, s: LowerState): LowerState {
    // First-class (escaping) closure (slice 3a): build the env box —
    // an i32[] [funcval, caps…]. The body was hoisted to `<cur_fn>$clo`
    // by lift_lambdas; const_func names it, the captures (free vars that
    // are local slots, in the SAME first-seen order hoist_escaping_closure
    // read them) follow, and arr_make wraps them.
    //
    // Naming a `$clo` no lift hoisted emits a reference with no definition
    // behind it, which a whole-program build silently swallows and every
    // per-unit link fails on, far from the source line (#7215). Refuse
    // here instead, so the gap is a bail naming this expression.
    var clo: string = s.clo_base + "$clo";
    if (!s.is_user_fn(clo)) {
        return s.note_fail("lambda: no lifted `" + clo + "` for the escaping closure").fail();
    }
    var caps: string[] = closure_captures(lam, s);
    var cs: LowerState = s.emit(ir.op_const_func(0, clo));
    var ci: i32 = 0;
    while (ci < caps.len()) {
        var slot: i32 = cs.slot_of(caps[ci]);
        if (slot < 0) { return s.fail(); }
        cs = cs.emit(ir.op_load_local(slot));
        ci = ci + 1;
    }
    return cs.emit(ir.op_arr_make(caps.len() + 1, 32));
}

// lower_expr_call lowers a call expression, routing to the named / method / closure paths.
function lower_expr_call(c: ast.ExprCall, e: ast.Expr, s: LowerState): LowerState {
    // Direct call (bare-name callee, up to 6 args), or the `.len()`
    // receiver method (field-access callee), which reads the array's
    // length header at base.
    match (c.callee) {
        ast.ExprIdent(cid) => { return lower_call_named(e, c, cid, s); },
        // `fns[i](args)` — calling an element of a function-value ARRAY
        // inline. A CLOSURE array (`is_closurearr`, elements are env boxes
        // [funcval, caps…]) uses the env-first form (stash the box, push it
        // as the __env first arg, the declared args, then box[0] as the
        // target, call_indirect(arity+1)) — the same as a closure LOCAL.
        // A plain fn-POINTER array (`[inc, dbl]`, elements are bare
        // function pointers) just lowers the args, then the element (the
        // fn pointer on TOS), and call_indirect(arity) — like calling a
        // fn-value LOCAL. (`var f = fns[i]; f(args)` already lowers via the
        // local paths; this handles the inline form.)
        ast.ExprIndex(cidx) => {
            var is_clo_arr: boolean = false;
            var idx_is_arr: boolean = false;
            match (cidx.array) {
                ast.ExprIdent(caid) => {
                    var caslot: i32 = s.slot_of(caid.name);
                    is_clo_arr = s.is_closurearr_slot(caslot);
                    idx_is_arr = s.is_arr_slot(caslot);
                },
                // `mk()[i](args)` — indexing a CALL's result directly,
                // no binding. A closurearr-returning callee makes the
                // element an env box (env-first dispatch below), same
                // as an is_closurearr LOCAL. Before this arm the shape
                // fell to s.fail() and the module took the legacy AST
                // path, which miscompiles it.
                ast.ExprCall(cacall) => {
                    match (cacall.callee) {
                        ast.ExprIdent(cacid) => {
                            if (s.is_closurearr_ret_fn(cacid.name)) {
                                is_clo_arr = true;
                                idx_is_arr = true;
                            }
                        },
                        _ => {}
                    }
                },
                // `r.hs[i](args)` — a registered fn-POINTER array struct
                // field indexed + called inline, no binding (#5235). Treat
                // it as a plain fn-pointer array: the idx_is_arr branch below
                // lowers c.callee (`r.hs[i]` — struct_get then arr_get to the
                // fn pointer) and call_indirect(arity). Without this arm the
                // field-access array fell to `_` → s.fail(), so the whole
                // module refused to lower.
                ast.ExprFieldAccess(_) => {
                    if (field_access_is_fnarr(cidx.array, s)) { idx_is_arr = true; }
                    // …and the CLOSURE-box sibling (`R { hs: [() => n] }`,
                    // then `r.hs[0]()`): same "fn[]" field spelling, but the
                    // elements are `__mkclo$` env boxes, so it needs the
                    // env-first form above, not the raw-pointer one. Without
                    // this arm the shape matched NEITHER flag and fell to `_`
                    // → s.fail(), even though construction, `.len()`, and the
                    // same call through a LOCAL clo-array all lowered fine
                    // (#3457).
                    //
                    // field_access_is_closurearr already declines a registered
                    // fn-POINTER field, so the pointer arm above keeps
                    // precedence and this cannot claim a raw-pointer array —
                    // the same precedence the bind / whole-array-alias read
                    // sites use (#5160 defect #2, #5235).
                    else if (field_access_is_closurearr(cidx.array, s)) { is_clo_arr = true; }
                },
                _ => {}
            }
            if (is_clo_arr) {
                var bxs: LowerState = lower_expr(c.callee, s);   // the box (fns[i])
                if (!bxs.ok) { return bxs; }
                var btmp: string = "$cloelem" + util.i32_to_string(bxs.locals.len());
                bxs = bxs.add_local(btmp);
                var btslot: i32 = bxs.slot_of(btmp);
                bxs = bxs.emit(ir.op_store_local(btslot));
                bxs = bxs.emit(ir.op_load_local(btslot));   // __env (the box)
                // One declared signature drives both halves — the width each
                // argument is lowered at and the funcref type the call names.
                // Split across two derivations they disagree, and a
                // disagreement is a module the wasm validator rejects (#5986).
                var bxsig: string = array_elem_fn_sig(cidx.array, s);
                var bxai: i32 = 0;
                while (bxai < c.args.len()) {
                    bxs = lower_fn_value_arg_wc(c.args[bxai], sig_arg_width_char(bxsig, bxai), bxs);
                    if (!bxs.ok) { return bxs; }
                    bxai = bxai + 1;
                }
                bxs = bxs.emit(ir.op_load_local(btslot));
                bxs = bxs.emit(ir.op_const_i32(0));
                bxs = bxs.emit(ir.op_arr_get(32));
                return bxs.emit(ir.op_call_indirect_sig(c.args.len() + 1,
                    callee_fn_sig_declared(bxsig, c, true)));
            }
            if (idx_is_arr) {
                // Plain fn-pointer array element: args, then the element
                // (the fn pointer), then call_indirect(arity). The checker
                // guarantees the element is callable (a non-fn array indexed
                // in call position wouldn't type-check).
                var pfs: LowerState = s;
                // Same rule as the closure-element arm above: one signature
                // for the argument widths and the funcref type alike.
                var pfsig: string = array_elem_fn_sig(cidx.array, s);
                var pfai: i32 = 0;
                while (pfai < c.args.len()) {
                    pfs = lower_fn_value_arg_wc(c.args[pfai], sig_arg_width_char(pfsig, pfai), pfs);
                    if (!pfs.ok) { return pfs; }
                    pfai = pfai + 1;
                }
                pfs = lower_expr(c.callee, pfs);   // fns[i] -> fn pointer on TOS
                if (!pfs.ok) { return pfs; }
                return pfs.emit(ir.op_call_indirect_sig(c.args.len(),
                    callee_fn_sig_declared(pfsig, c, false)));
            }
            return s.fail();
        },
        ast.ExprFieldAccess(fa) => { return lower_call_method(c, fa, s); },
        // Inline 0-arg IIFE — the shape parse_if_chain emits for an
        // if-EXPRESSION in value position: `(function(): i32 { if (c) {
        // return E1; } else { return E2; } })()`. Lower it INLINE (no
        // closure box / function call) as a value-producing void `if`
        // that stores each branch's result into a temp (#2938). Bails to
        // AST for anything other than the i32 if-expression shape.
        ast.ExprLambda(lam) => {
            // Only a MARKED value block is inlined. A hand-written IIFE
            // has the same shape but is a call with a scope of its own,
            // so lift_iife_lambdas rewrote it to a call of a lifted
            // function before this ran; reaching here with an unmarked
            // one means that rewrite declined, and inlining it would
            // hoist its defers to the enclosing function (#7192).
            if (lam.origin != parser.ORIGIN_IIFE_SCOPED) {
                return lower_iife(c, lam, s, false);
            }
            return s.fail();
        },
        // `mk()(args)` — the callee is itself a CALL returning a plain
        // function value (a bare fn pointer; e.g. mk returns a no-capture
        // lambda, lifted to a const_func by lift_lambdas). Lower the args,
        // then the callee call (its returned fn pointer on TOS), then
        // call_indirect — the same shape as a fn-pointer array element /
        // tuple element call.
        ast.ExprCall(cocall) => {
            var coc_is_closure: boolean = false;
            match (cocall.callee) {
                ast.ExprIdent(cocid) => {
                    // `mk()(args)` — inner call to a closure-returning
                    // module fn — OR `g()(args)` where g is a RETCLO
                    // closure LOCAL (g() returns a closure box), #5281.
                    if (util.index_of_str(s.sigs.closure_fns, cocid.name) >= 0) { coc_is_closure = true; }
                    else if (s.is_closure_local("RETCLO$" + cocid.name)) { coc_is_closure = true; }
                },
                // `pick(9)()(args)` — the inner callee is ITSELF a call to a
                // RETCLO2 factory (its result's OWN call returns a closure),
                // so `pick(9)()` returns a closure box; dispatch env-first (#5281).
                ast.ExprCall(cocinner) => {
                    match (cocinner.callee) {
                        ast.ExprIdent(cociid) => {
                            if (util.index_of_str(s.sigs.closure_fns, "RETCLO2:" + cociid.name) >= 0) { coc_is_closure = true; }
                        },
                        _ => {}
                    }
                },
                // `m.make()(args)` — the inner call is a METHOD returning
                // a closure, invoked immediately without ever binding to a
                // local. The sibling of the `var f = m.make()` case in the
                // closure-local binding match: both call sites only ever
                // inspected a bare-ident callee, so a method-returned
                // closure was dispatched as a bare fn pointer and wasm
                // trapped with `undefined element: out of bounds table
                // access`. Keyed by bare method name, matching how
                // closure_ret_fns_of registers methods. #4801.
                ast.ExprFieldAccess(cocfa) => {
                    if (util.index_of_str(s.sigs.closure_fns, cocfa.field) >= 0) { coc_is_closure = true; }
                },
                _ => {}
            }
            // A callee that returns a CLOSURE box [funcval, caps…] (a
            // capturing-lambda-returning fn, tracked in closure_fns):
            // dispatch env-FIRST, the same shape a closure LOCAL uses
            // (the `is_closure_local` arm above). The box is needed twice
            // — as the `__env` first arg and to read `box[0]` as the call
            // target — so the inner call is evaluated into a fresh temp.
            // Mirrors `var f = mk(…); f(args)`: the temp is marked an array
            // so the exit dec-sweep releases the box, exactly as the bound
            // closure local is. (#3551)
            if (coc_is_closure) {
                var bs: LowerState = lower_expr(c.callee, s);   // inner call -> box on TOS
                if (!bs.ok) { return bs; }
                var btmp: string = "$coc" + util.i32_to_string(bs.locals.len());
                bs = bs.add_local(btmp);
                var bslot: i32 = bs.slot_of(btmp);
                bs = bs.mark_arr(bslot, true);
                bs = bs.emit(ir.op_store_local(bslot));
                bs = bs.emit(ir.op_load_local(bslot));          // __env (the box)
                // One declared signature drives both halves — the width each
                // argument is lowered at and the funcref type the call names.
                // The tag describes the REAL parameters, so it is indexed from
                // argument 0; the env box's leading 'w' is added by
                // callee_fn_sig_declared, after the widths are read (#5986).
                var bxsig: string = call_ret_fn_sig(cocall, s);
                var bxai: i32 = 0;
                while (bxai < c.args.len()) {
                    bs = lower_fn_value_arg_wc(c.args[bxai], sig_arg_width_char(bxsig, bxai), bs);
                    if (!bs.ok) { return bs; }
                    bxai = bxai + 1;
                }
                bs = bs.emit(ir.op_load_local(bslot));          // box again
                bs = bs.emit(ir.op_const_i32(0));
                bs = bs.emit(ir.op_arr_get(32));                // box[0] = funcval
                return bs.emit(ir.op_call_indirect_sig(c.args.len() + 1,
                    callee_fn_sig_declared(bxsig, c, true)));
            }
            var cocs: LowerState = s;
            // One declared signature drives both halves — the width each argument
            // is lowered at and the funcref type the call names (#5986).
            var cocsig: string = call_ret_fn_sig(cocall, s);
            var cocai: i32 = 0;
            while (cocai < c.args.len()) {
                cocs = lower_fn_value_arg_wc(c.args[cocai], sig_arg_width_char(cocsig, cocai), cocs);
                if (!cocs.ok) { return cocs; }
                cocai = cocai + 1;
            }
            var coce: LowerState = lower_expr(c.callee, cocs);
            if (!coce.ok) { return coce; }
            return coce.emit(ir.op_call_indirect_sig(c.args.len(),
                callee_fn_sig_declared(cocsig, c, false)));
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// call_ret_fn_sig is the funcref signature tag for a call THROUGH the result of
// another call — `mk()(4.5)`, whose callee is itself a call returning a fn value.
// The result has no slot and no declared spelling at the call site; what names it
// is the CALLEE's own declaration, recorded on FuncDecl and registered by
// ret_fn_sigs_of. "" for a method or an indirect inner callee, and for a
// signature `$fn<N>` already describes, both of which keep today's emission.
function call_ret_fn_sig(inner: ast.ExprCall, s: LowerState): string {
    match (inner.callee) {
        ast.ExprIdent(id) => { return sig_reg_value_last(s.sigs.ret_fn_sigs, s.mod_fn_name(id.name)); },
        _ => {}
    }
    return "";
}

// lower_expr_slice lowers a slice expression `a[lo:hi]`.
function lower_expr_slice(slc: ast.ExprSlice, s: LowerState): LowerState {
    // `a[start:end]` on an ARRAY lowers [src, start, end] then `arr_slice`
    // (a fresh array). On a STRING it is the CHECKED slice (#5634) and goes
    // to lower_str_slice_checked, which yields `Option[str]`. A non-string,
    // non-array source bails. (The binding is `slc`, not `sl`: other arms
    // bind `var sl: LowerState`, and the compiler's scope-blind locals
    // collapse same-named locals of different types.)
    var slc_is_str: boolean = expr_is_str(slc.array, s);
    // The typed-IR tag is proof of array-ness the walk cannot reach:
    // slc.ty is non-empty exactly when the checker typed slc.array as an
    // array, so a slice of an if-expression or of a call-result struct
    // field lowers instead of bailing. expr_is_arr_src takes a bare Expr
    // and so cannot see the tag itself — it is applied here, at the one
    // site that holds the ExprSlice node.
    if (!slc_is_str && !expr_is_arr_src(slc.array, s) && slc.ty == "") { return s.fail(); }
    if (slc_is_str) { return lower_str_slice_checked(slc, s); }
    // An f64[] or i64[] slice copies 8-byte elements (arr_slice width 64
    // → the wasm $__fern_arr_slice8 helper, a raw 8-byte move that serves
    // both); i32[] / string[] copy 4-byte elements. The result is a fresh
    // f64[]/i64[], marked at the var binding via expr_is_f64arr /
    // expr_is_i64arr's ExprSlice cases.
    var slc_w: i32 = 32;
    if (slice_elem_is_wide(slc, s)) { slc_w = 64; }
    var slvst: ArgStash = lower_view_borrowed_parked(slc.array, s);
    var ssl: LowerState = slvst.state;
    if (!ssl.ok) { return ssl; }
    if (slc.open_end) {
        // `a[lo:]` — the upper bound is the source's own length and
        // slc.end is an unevaluated placeholder. Spill the source so
        // arr_len reads the same value arr_slice will, instead of
        // lowering the base a second time.
        var aon: string = "$aopen" + util.i32_to_string(ssl.locals.len());
        ssl = ssl.add_local(aon);
        var aoslot: i32 = ssl.slot_of(aon);
        ssl = ssl.emit(ir.op_store_local(aoslot));
        ssl = ssl.emit(ir.op_load_local(aoslot));
        ssl = lower_expr(slc.start, ssl);
        if (!ssl.ok) { return ssl; }
        ssl = ssl.emit(ir.op_load_local(aoslot));
        ssl = ssl.emit(ir.op_arr_len());
        return ssl.emit(ir.op_arr_slice(slc_w));
    }
    ssl = lower_expr(slc.start, ssl);
    if (!ssl.ok) { return ssl; }
    ssl = lower_expr(slc.end, ssl);
    if (!ssl.ok) { return ssl; }
    return ssl.emit(ir.op_arr_slice(slc_w));
}

// lower_expr_index lowers an index read `a[i]`, with the bounds check the receiver's type implies.
function lower_expr_index(ix: ast.ExprIndex, s: LowerState): LowerState {
    // arr[idx] → lower the array (base) then the index, then `arr_get`
    // (the backend computes the element address for its layout). String
    // indexing `s[i]` reads a byte → `str_index` (an i32 byte value);
    // it shares the lower-array-then-index shape, just a different op.
    // A SCALAR element read out of a fresh owned container — `mk()[i]`,
    // mk an "ARR:"-registered producer — reclaims that container here
    // (#6491; see the section comment above lower_expr). The buffer is
    // spilled so the index expression can be lowered between the two
    // reads of it, then released element-blind: every element rides the
    // freed buffer and the loaded scalar is a copy.
    // The element is scalar BY CONSTRUCTION: an "ARR:" entry is only
    // issued for a callee whose return type is is_leaksafe_array_field,
    // which excludes string[] and every struct/enum array. Asking the
    // element TAG instead would be both redundant and wrong — `ix.ty` is
    // checker-stamped, and the emit-only drivers do not stamp it, so the
    // reclaim fired under `fern.fern` and silently declined under
    // `asm_run.fern`.
    // The POINTER-element half rides the same spill, with a different
    // release: the loaded element ALIASES the buffer, so retain it and
    // then DEEP-free the container ("STRARR:", #6491). The retain is what
    // nets the extracted string to the one reference its destination
    // owns; without it __fern_str_arr_free would free it out from under
    // the read, and without the deep free the three elements it did not
    // extract would strand.
    // The "ARROWN:" half (#7259) takes the shallow release with no
    // retain on the element: the dec gives back the reference the callee
    // handed over, and the elements are either scalars or owned by
    // whoever the callee borrowed the buffer from. Retaining the element
    // as the "STRARR:" arm does would strand it.
    var ixtag: string = ix_type_tag(ix, s);
    var ixown: string = "";
    var ixdeep: boolean = false;
    if (!expr_is_str(ix.array, s)) {
        ixown = owned_fresh_call_callee(ix.array, "ARR:", s);
        if (ixown == "") { ixown = owned_fresh_call_callee(ix.array, "ARROWN:", s); }
        if (ixown == "") {
            ixown = owned_fresh_call_callee(ix.array, "STRARR:", s);
            if (ixown != "") { ixdeep = true; }
        }
    }
    var ixvst: ArgStash = lower_view_borrowed_parked(ix.array, s);
    var sidx: LowerState = ixvst.state;
    if (!sidx.ok) { return sidx; }
    var ixslot: i32 = 0 - 1;
    if (ixown != "") {
        var ixn: string = "$ocidx" + util.i32_to_string(sidx.locals.len());
        sidx = sidx.add_local(ixn);
        ixslot = sidx.slot_of(ixn);
        sidx = sidx.emit(ir.op_store_local(ixslot));
        sidx = sidx.emit(ir.op_load_local(ixslot));
    }
    sidx = lower_expr(ix.index, sidx);
    if (!sidx.ok) { return sidx; }
    if (expr_is_str(ix.array, s)) { return free_parked_view_after(sidx.emit(ir.op_str_index()), ixvst.slot); }
    if (ixslot >= 0) {
        var ixw: i32 = 32;
        if (ixtag == "f64") { ixw = 64; }
        if (ix.unchecked) { sidx = sidx.emit(ir.op_arr_get_nc(ixw)); }
        else { sidx = sidx.emit(ir.op_arr_get(ixw)); }
        if (ixdeep) {
            sidx = sidx.emit(ir.op_call_direct("__fern_rc_inc", 1));   // the element outlives the buffer
            sidx = sidx.emit(ir.op_load_local(ixslot));
            sidx = sidx.emit(ir.op_call_direct("__fern_str_arr_free", 1));
            return sidx.emit(ir.op_drop());
        }
        sidx = sidx.emit(ir.op_load_local(ixslot));
        sidx = sidx.emit(ir.op_call_direct("__fern_rc_dec", 1));
        return sidx.emit(ir.op_drop());
    }
    // Element width from ix_type_tag: an f64[] reads an 8-byte f64
    // (arr_get width 64 → f64.load on wasm); i32[] / string[] the 4-byte
    // i32 path. This is the SAME leaf expr_is_f64's ExprIndex case reads,
    // which is what keeps the load width and the result's downstream type
    // from disagreeing — a mismatch the wasm validator rejects outright
    // ("expected f64, found i32") rather than miscompiling silently.
    var gw: i32 = 32;
    if (ix_type_tag(ix, s) == "f64") { gw = 64; }
    // #4380 lever 3: a read the elide pass proved in-bounds (an enclosing
    // `while (i < arr.len())` guard) drops the per-iteration bounds check.
    if (ix.unchecked) { return sidx.emit(ir.op_arr_get_nc(gw)); }
    return sidx.emit(ir.op_arr_get(gw));
}

// lower_expr_tuple lowers a tuple literal into its boxed representation.
function lower_expr_tuple(tup: ast.ExprTuple, s: LowerState): LowerState {
    // Tuple literal `(a, b, …)` → tuple_make. Scalar elements only
    // (leak-only); a heap element bails. Elements lower
    // in source order (element 0 deepest), then tuple_make boxes them.
    var tn: i32 = tup.elements.len();
    if (tn == 0) { return s.fail(); }
    // Scalar, string, struct, and i32[] array elements are allowed (leak
    // mode: each is one pointer-or-scalar slot, stored pointer-safely).
    // An i32[] element rides one slot as its data pointer; `t.N` recovers
    // it via tuple_get, and array ops only need that pointer (no extra
    // element-tag plumbing — deliberately NOT broadening the shared
    // elem_type_tag, which feeds tuple destructure / arg sites too).
    // string[] / f64[] / i64[] arrays, nested tuples, and other heap
    // elements still bail.
    var tei: i32 = 0;
    while (tei < tn) {
        // Each element must be a single leak-mode slot (scalar / string /
        // struct / array-pointer / Option / nested-tuple / Result / Map /
        // enum); tuple_elem_ctor_eligible is the shared admission (also
        // gating tuple cross-reuse), classifying an if-/match-EXPRESSION
        // element by its IIFE leaf branch value. A heap element outside the
        // set bails.
        if (!tuple_elem_ctor_eligible(iife_leaf_value(tup.elements[tei]), s)) { return s.fail(); }
        tei = tei + 1;
    }
    // Build the per-element KIND string (i32 / i64 / f64 / string / <struct>)
    // so the wasm backend stores each at the right width, and lower an
    // i64 element via lower_i64 (8-byte i64 value); f64 / i32 / string /
    // struct elements ride lower_expr.
    var tkinds: string = "";
    var ts: LowerState = s;
    var tj: i32 = 0;
    while (tj < tn) {
        // Classify by the leaf branch for an IIFE element (no-op otherwise),
        // so the kind tag matches what lower_expr (lower_iife) produces.
        var tek: string = elem_type_tag(iife_leaf_value(tup.elements[tj]), ts);
        if (tj > 0) { tkinds = tkinds + ","; }
        tkinds = tkinds + tek;
        if (tek == "i64") { ts = lower_i64(tup.elements[tj], ts); }
        else { ts = lower_expr(tup.elements[tj], ts); }
        if (!ts.ok) { return ts; }
        // Construction-store retain, the tuple sibling of the struct
        // literal's fav_alias_inc: an element that is a bare ident naming
        // an rc-tracked ARRAY or STRING local is a SECOND owner once
        // boxed, so the
        // tuple must hold a counted reference. Without it
        // __fern_rc_is_unique reports the source local unique while the
        // tuple still points at its buffer — an answer a reuse decision
        // may key on. rc_inc returns its argument, so the operand stack
        // tuple_make_k expects is unchanged.
        match (tup.elements[tj]) {
            ast.ExprIdent(teid) => {
                if (ts.slot_is_rc_container(ts.slot_of(teid.name))) {
                    ts = ts.retain_tos("tuplit-elem");
                }
                // A STRUCT box is not in slot_is_rc_container — its release
                // is a field walk plus a box dec, not a box dec — so it
                // needs its own clause, the same one the array literal and
                // the variant ctor grew. SKIPPED at a move site: there the
                // tuple takes over the local's reference and its walk is the
                // one release, which is what makes tuple__moved clean.
                else if (decl_is_struct(ts.structs, tek)
                    && ts.struct_type_of_slot(ts.slot_of(teid.name)).len() > 0
                    && !ts.moves_local_at(teid.name, teid.line, teid.col)) {
                    ts = ts.retain_tos("tuplit-struct-elem");
                }
            },
            _ => {}
        }
        tj = tj + 1;
    }
    return ts.emit(ir.op_tuple_make_k(tn, tkinds));
}

// lower_expr_array lowers an array literal, choosing the element width from the tracked type.
function lower_expr_array(arr: ast.ExprArray, s: LowerState): LowerState {
    // i32 array literal → the high-level `arr_make n` op. Each element
    // expr is lowered (pushing its i32 value, element 0 deepest), then
    // `arr_make` allocates the array, initialises its rc/len header and
    // fills the elements, and leaves the data pointer on the stack. The
    // BYTE layout (slot width, header shape, rc offset) is the
    // backend's choice — irlower commits only to the semantics. (Fresh
    // literal: owned at rc=1, no alias-inc.) Elements must be i32 or the
    // element lowering bails.
    var n: i32 = arr.elements.len();
    // An i64[]/u64[] literal: lower each element via lower_i64 (8-byte
    // value) and emit arr_make_i64 — mirroring the StmtVar i64[]-literal
    // binding path. The generic i32/f64 path below lowers elements via
    // lower_expr, which BAILS on an `as i64` element (as_i64 has no
    // lower_expr arm), so without this an i64[] literal in a non-binding
    // position (e.g. a tuple element `([x as i64], y)`) bailed the module
    // to AST. #3353.
    if (n > 0 && (arr_lit_is_i64(arr, s) || lit_has_i64_suffix(arr.elements[0]))) {
        var ia64: LowerState = s;
        var iae: i32 = 0;
        while (iae < n) {
            ia64 = lower_i64(arr.elements[iae], ia64);
            if (!ia64.ok) { return ia64; }
            iae = iae + 1;
        }
        return ia64.emit(ir.op_arr_make_i64(n));
    }
    // Element WIDTH selects the array stride: an f64 element array uses
    // an 8-byte stride (arr_make width 64; the wasm backend allocates
    // n*8 and f64.stores each element), everything else the 4-byte i32 /
    // wasm32-pointer path. (The register backends use 8-byte slots
    // regardless — width only steers wasm.) The slot binding tracks
    // f64-array-ness (local_is_f64arr) so a[i] reads an 8-byte f64.
    var ewidth: i32 = 32;
    if (n > 0 && arr_lit_is_f64(arr, s)) { ewidth = 64; }
    // i32[] / string[] / f64[] literals are all supported: an i32 element
    // lowers to its value, a string element to its box pointer (const_str
    // etc.), an f64 element to its 8-byte bit pattern. The slot binding
    // tracks string[]- / f64[]-ness so a[i] types correctly; the array is
    // rc-tracked like any array and its string elements leak.
    var sa: LowerState = s;
    var i: i32 = 0;
    while (i < n) {
        sa = lower_expr(arr.elements[i], sa);
        if (!sa.ok) { return sa; }
        // Perceus alias-inc, mirroring lower_opt_make_payload: an element
        // that is a bare ident on an rc-tracked ARRAY or STRING slot is a
        // NEW reference to that buffer, so retain it. (The string half was
        // missing: a `string[]` literal built from string LOCALS left each
        // element's rc at 1, so is_unique called a container-retained string
        // unique — the same degradation this comment describes for arrays,
        // one slot kind over.) Without it `var both = [a, b]` left a's rc
        // at 1, and __fern_rc_is_unique reported a container-retained array
        // as UNIQUE on both IR backends where both AST emitters reported it
        // shared — silently degrading the constructor-reuse guard (#4350),
        // whose whole job is to answer "sole owner?" before an in-place
        // write. A fresh-literal element is not a local, so this never
        // fires for it and the fresh-arrarr deep-free paths
        // (discardable_scalar_arrarr_lit et al) are unaffected.
        match (arr.elements[i]) {
            ast.ExprIdent(eid) => {
                if (sa.slot_is_rc_container(sa.slot_of(eid.name))
                    || sa.is_enum_field_alias(eid.name)) {
                    sa = sa.retain_tos("arrlit-elem");
                }
                // A bare STRUCT ident element of a container whose ELEMENT
                // WALK is credited — the literal sibling of the self-append
                // arm, reading the same "APOWNED:" stamps and deferring to
                // the same move analysis. A struct box is not in
                // slot_is_rc_container (its release is a field walk, not a
                // box dec), so it needs its own clause.
                else if (reclaim_has(sa.reclaimable_names, "APOWNED:",
                    util.i32_to_string(eid.line) + ":" + util.i32_to_string(eid.col))) {
                    if (sa.moves_local_at(eid.name, eid.line, eid.col)) { sa = sa.note_moved_elided(sa.slot_of(eid.name)); }
                    else { sa = sa.retain_tos("arrlit-arrstruct-elem"); }
                }
            },
            // A DIRECT ENUM field read (`[first.node]`) aliases the source
            // struct's enum box, which __struct_drop_<T>'s k_enum arm decs on
            // reclamation — retain it so that dec only releases the dup (#6049).
            _ => {
                if (enum_field_read_type(arr.elements[i], sa) != "") {
                    sa = sa.retain_tos("arrlit-enum-field");
                }
                // `[p[i]]` over a string[] PARAMETER (str_param_elem_escapes);
                // the local-routed form is an ident and takes the
                // slot_is_rc_container retain above.
                else if (str_param_elem_escapes(arr.elements[i], sa)) {
                    sa = sa.retain_tos("arrlit-param-str-elem");
                }
            }
        }
        i = i + 1;
    }
    return sa.emit(ir.op_arr_make(n, ewidth));
}

// lower_expr_unary lowers a unary operator.
function lower_expr_unary(u: ast.ExprUnary, s: LowerState): LowerState {
    // Try-operator `inner?` (parser desugar: unary "try_"). Unwrap the
    // Some/Ok payload as the expression's value, or early-return the
    // None/Err box from the enclosing Option/Result-returning function.
    if (u.op == "try_") { return lower_try(u.operand, s); }
    if (u.op == "-") {
        if (expr_is_f64(u.operand, s)) {
            // -x flips the f64 sign bit (op_funary "fneg"). The old
            // `0.0 - x` lowering flushed -0.0 to +0.0 (IEEE 0-0 = +0),
            // so `1.0 / -(0.0)` gave +inf instead of -inf (#4333). A
            // sign-bit flip preserves signed zero, matching native.
            var fx: LowerState = lower_expr(u.operand, s);
            if (!fx.ok) { return fx; }
            return fx.emit(ir.op_funary("fneg"));
        }
        // Composite unary minus (#2706): `-a` on a struct/enum lowers
        // to `a.neg()`, mirroring the native checker's NegCall desugar.
        // As with the binary overloads, a type without `neg` bails
        // rather than negating a struct pointer as a scalar.
        var ust: string = expr_struct_type(u.operand, s);
        if (decl_is_struct(s.structs, ust)) {
            // Both registries, for the binary arm's reason: struct_ret_fns
            // records only STRUCT returns, so a scalar-returning `neg`
            // read "" there and was refused as though the type had none.
            if (s.struct_ret_type(ust + ".neg") == "" && u.ty == "") { return s.fail(); }
            var negcall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: u.operand, field: "neg", line: u.line, col: u.col, ty: "" }, args: [], line: u.line, col: u.col, type_argc: 0, ty: u.ty };
            return lower_expr(negcall, s);
        }
        // -x  ==  0 - x  : push 0, push x, sub.
        var sz: LowerState = s.emit(ir.op_const_i32(0));
        var sx: LowerState = lower_expr(u.operand, sz);
        if (!sx.ok) { return sx; }
        return sx.emit(ir.op_bin("sub", 0, false));
    }
    if (u.op == "!") {
        var so: LowerState = lower_expr(u.operand, s);
        if (!so.ok) { return so; }
        return so.emit(ir.op_bin("not", 0, false));
    }
    // `x as f64`: int -> float widen (cvtsi2sd). An already-f64 operand
    // is a no-op for `as f64`/`as float`. `as f32`, however, must ROUND
    // the value to single precision — f32 shares the 8-byte f64 slot
    // here, but native gives f32 a true 4-byte slot, so a value that is
    // not f32-representable (e.g. 16777217.0, or a large int) differs
    // unless we round. The f32_bits/f32_from_bits pair round-trips
    // through f32 (demote then promote), applying single-precision
    // rounding while leaving an f64 on the stack. (#4366)
    if (u.op == "as_f64" || u.op == "as_f32" || u.op == "as_float") {
        var fv: LowerState = s;
        if (expr_is_f64(u.operand, s)) {
            fv = lower_expr(u.operand, s);
            if (!fv.ok) { return fv; }
        } else {
            fv = lower_expr(u.operand, s);
            if (!fv.ok) { return fv; }
            // Carry the operand's width + signedness (#5992). wasm needs
            // both to pick among f64.convert_i{32,64}_{s,u}; the register
            // backends need them too, for the one source a signed convert
            // cannot express — a u64 >= 2^63, which cvtsi2sd / scvtf read
            // as negative (#6051). Unsigned is asked BEFORE width because
            // a u64 is both.
            var cw: i32 = infer_expr_width(u.operand, s);
            var cu: boolean = expr_is_u64(u.operand, s) || expr_is_u32(u.operand, s);
            fv = fv.emit(ir.op_int_to_f64(cw, cu));
        }
        if (u.op == "as_f32") {
            fv = fv.emit(ir.op_f32_bits());
            fv = fv.emit(ir.op_f32_from_bits());
        }
        return fv;
    }
    // Int→int width cast `x as <ty>` for a 32-bit-or-narrower target
    // (i32 / u32 / u8). The masking/extension matches
    // asm.fern's `as_<ty>` exactly (int_cast op). The operand may be an
    // f64 (truncate toward zero via f64_to_i32, THEN mask), an i64
    // (narrow via int_wrap, THEN mask), or a 32-bit int (mask directly).
    if (u.op == "as_i32" || u.op == "as_u32" || u.op == "as_u8") {
        var cty: str = slice_unchecked(u.op, 3, u.op.len());
        if (expr_is_f64(u.operand, s)) {
            var fc: LowerState = lower_expr(u.operand, s);
            if (!fc.ok) { return fc; }
            // `f64 as u32` truncates UNSIGNED (#4332): the signed
            // f64_to_i32 clamps at INT32_MAX, so 3e9 as u32 read as
            // 2147483647 instead of 3000000000. Native saturates over
            // the full u32 range (fcvtzu / trunc_sat_f64_u).
            if (cty == "u32") { fc = fc.emit(ir.op_f64_to_u32()); }
            else { fc = fc.emit(ir.op_f64_to_i32()); }
            return fc.emit(ir.op_int_cast(cty));
        }
        if (infer_expr_width(u.operand, s) == 64) {
            var i64c: LowerState = lower_i64(u.operand, s);
            if (!i64c.ok) { return i64c; }
            i64c = i64c.emit(ir.op_int_wrap(true));
            return i64c.emit(ir.op_int_cast(cty));
        }
        var sn: LowerState = lower_expr(u.operand, s);
        if (!sn.ok) { return sn; }
        return sn.emit(ir.op_int_cast(cty));
    }
    // `E as T` type ascription (#2669) in a non-binding position
    // (return / argument / nested expr): the `as` is a zero-cost
    // identity annotation, so the value of `E as T` is exactly the
    // value of `E`. The binding form `var x = E as T` is intercepted
    // earlier in lower_stmt (rewritten to a `var x: T = E` rebind, so
    // the slot keeps its typed alias-inc); here there is no slot store,
    // so lowering the operand directly is RC-sound — it yields the same
    // value with the same ownership `E` alone would. Numeric
    // conversions (as_i32 / as_f64 / …) are handled above and keep
    // their value-converting path; an unsupported operand (e.g. a bare
    // `None` to an Option target) makes lower_expr bail.
    // `e as? T` fallible downcast (docs/DYN-TRAITS.md §9): the parser
    // tags this `as?_<T>`. `e` is a `dyn Trait` value (a heap pointer
    // carrying its concrete shape at offset 0); lower it, then
    // op_dyn_downcast reads that shape, compares to T's interned shape,
    // and yields Some(e) on an exact match / None otherwise — an
    // ordinary Option box a downstream `match` reads normally. The
    // self-host checker is permissive here (the Go checker is the strict
    // §9 gate), so we don't re-validate the dyn/impl relationship.
    if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
        var dcs: LowerState = lower_expr(u.operand, s);
        if (!dcs.ok) { return dcs; }
        return dcs.emit(ir.op_dyn_downcast(slice_unchecked(u.op, 4, u.op.len())));
    }
    if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_" && !is_numeric_cast_op(u.op)) {
        return lower_expr(u.operand, s);
    }
    return s.fail();
}

// lower_expr_binary lowers a binary operator — the short-circuiting pair, and the width- and
// signedness-directed integer and float forms.
function lower_expr_binary(b: ast.ExprBinary, e: ast.Expr, s: LowerState): LowerState {
    // Saturating arithmetic (#5542) is integer-only — no string concat,
    // no float form, no composite overload — so it precedes every other
    // dispatch and carries its own width-aware clamp lowering.
    if (is_sat_op(b.op)) { return lower_sat_binary(b, e, s); }
    // Checked arithmetic (#5542) yields `Option[T]` — integer-only,
    // no composite overload — so it too precedes every other dispatch.
    if (is_chk_op(b.op)) { return lower_checked_binary(b, e, s); }
    // Composite operator overload (#2706): `a <op> b` where the left
    // operand is a struct lowers to `a.<method>(b)` (`+`→add, …),
    // mirroring the native checker desugar. Rewriting to a method call
    // reuses the struct-returning-method path (#3640); if the type has
    // no such method, that path bails rather than mis-lowering the
    // struct pointers as scalar arithmetic. Scalars /
    // strings / f64 return "" from expr_struct_type, so they're
    // untouched and fall through to the numeric/string dispatch below.
    if (binop_overload_method(b.op) != "") {
        var blt: string = expr_struct_type(b.left, s);
        // Only a real struct/enum operand is an overload — expr_struct_type
        // also reports a typed scalar's name (e.g. a `u8` local returns
        // "u8"), which must fall through to the normal numeric/sub-word
        // lowering below, NOT be treated as a composite (#2706 regression).
        if (decl_is_struct(s.structs, blt)) {
            var ovm: string = binop_overload_method(b.op);
            // The method must exist — without one this is an invalid
            // program (native rejects it E009), so bail rather than
            // mis-lower the struct pointers as scalar arithmetic.
            //
            // Two registries answer that, because neither alone covers
            // it: struct_ret_fns records only STRUCT returns, so a
            // scalar-returning overload (a dot product
            // `function (a: V) mul(b: V): f64`) reads "" there and was
            // refused as though no method existed — a valid program
            // native compiles and the interpreter runs. The typed-IR
            // tag names the checker's result type for the whole binary
            // (#5986), which is non-empty exactly when the checker
            // resolved the overload, so it covers the non-struct
            // returns the registry cannot record.
            if (s.struct_ret_type(blt + "." + ovm) == "" && b.ty == "") { return s.fail(); }
            // The desugared call inherits the binary's tag: `a * b` and
            // `a.mul(b)` are the same value, and ExprCall.ty is what the
            // method-call lowering below reads to type its result.
            var ovcall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: b.left, field: ovm, line: b.line, col: b.col, ty: "" }, args: [b.right], line: b.line, col: b.col, type_argc: 0, ty: b.ty };
            return lower_expr(ovcall, s);
        }
    }
    // Composite structural comparison, the same desugar the native
    // checker applies: `a == b` on a struct or enum is `a.eq(b)`
    // (`!a.eq(b)` for `!=`), and `a < b` is `a.cmp(b) < 0` — NOT the
    // heap-pointer compare the integer dispatch below would emit.
    // Without it two structurally-equal boxes compared unequal and
    // ordering compared allocation ADDRESSES, silently: the operands
    // are pointers, so the i32 compare is well-formed and nothing
    // downstream could notice. Rewriting to a method call reuses the
    // whole method-dispatch path, including the variant -> enum_owner
    // redirect a `Line(7) == Line(7)` needs.
    if (binop_cmp_method(b.op) != "") {
        var cty: string = composite_cmp_type(b.left, s);
        if (cty != "") {
            var cm: string = binop_cmp_method(b.op);
            var cmcall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: b.left, field: cm, line: b.line, col: b.col, ty: "" }, args: [b.right], line: b.line, col: b.col, type_argc: 0, ty: "" };
            var cms: LowerState = lower_expr(cmcall, s);
            if (!cms.ok) { return cms; }
            // `eq` yields the boolean directly; `!=` negates it.
            if (cm == "eq") {
                if (b.op == "!=") { return cms.emit(ir.op_bin("not", 0, false)); }
                return cms;
            }
            // `cmp` yields -1/0/1; the operator applies against 0.
            cms = cms.emit(ir.op_const_i32(0));
            return cms.emit(ir.op_bin(map_binop(b.op), 0, false));
        }
    }
    // Short-circuit `&&` / `||`. When the RIGHT operand is trap-free and
    // side-effect-free, eagerly evaluating it is unobservable, so the
    // logical op is just a bitwise `&` / `|` of the two boolean (0/1)
    // values — no value-producing `if` needed. The left operand is always
    // evaluated, so it may be anything lowerable. A right operand with a
    // call / index / division (where skipping it matters) bails to the AST
    // path, which does proper control-flow short-circuiting.
    if (b.op == "&&" || b.op == "||") {
        var scop: string = "and";
        if (b.op == "||") { scop = "or"; }
        // Fast path: a trap-free, side-effect-free RHS is just `&` / `|`
        // of the two boolean (0/1) values — no control flow needed.
        if (is_eager_safe(b.right)) {
            var lsc: LowerState = lower_expr(b.left, s);
            if (!lsc.ok) { return lsc; }
            var rsc: LowerState = lower_expr(b.right, lsc);
            if (!rsc.ok) { return rsc; }
            return rsc.emit(ir.op_bin(scop, 0, false));
        }
        // Short-circuit: the RHS may call / index / divide (where NOT
        // evaluating it matters), so guard it behind the LHS via a temp
        // local + a block (the proven match-arm control shape):
        //   tmp = L
        //   block { load tmp; [&& only: not]; br_if 0; tmp = R }
        //   load tmp          // result = L ? R : L  (&&) / L ? L : R (||)
        // For `&&` we skip R when L is FALSE (load L, not, br_if); for
        // `||` we skip R when L is TRUE (load L, br_if). tmp then holds
        // L on the skip path (the short-circuit value) and R otherwise.
        var sl0: LowerState = lower_expr(b.left, s);
        if (!sl0.ok) { return sl0; }
        var scn: string = "$sc" + util.i32_to_string(sl0.locals.len());
        sl0 = sl0.add_local(scn);
        var scslot: i32 = sl0.slot_of(scn);
        sl0 = sl0.emit(ir.op_store_local(scslot));
        sl0 = sl0.emit(ir.op_block(0));
        sl0 = sl0.emit(ir.op_load_local(scslot));
        if (b.op == "&&") { sl0 = sl0.emit(ir.op_bin("not", 0, false)); }
        sl0 = sl0.emit(ir.op_brif(0));
        var sr0: LowerState = lower_expr(b.right, sl0);
        if (!sr0.ok) { return sr0; }
        sr0 = sr0.emit(ir.op_store_local(scslot));
        sr0 = sr0.emit(ir.op_end());
        return sr0.emit(ir.op_load_local(scslot));
    }
    // String dispatch: on string operands, `+` is concat and `==`/`!=`
    // are byte-equality (str_eq, then `not` for `!=`). Ordering compares
    // (`<` `>` `<=` `>=`) lower to str_cmp (signed -/0/+) followed by the
    // relational op against 0.
    if (expr_is_str(b.left, s) || expr_is_str(b.right, s)) {
        // `+` concat frees any fresh anonymous OPERAND temp right after the
        // concat reads it (`s + "x"` box, `a + b + c` intermediates) — see
        // emit_str_concat_reclaim; a non-fresh-operand concat takes its plain
        // fast path. `==` / `!=` keep the bare lower (operands are read, not
        // moved; the temp's own scope-exit / accumulator reclaim handles it).
        if (b.op == "+") { return emit_str_concat_reclaim(b, s); }
        if (b.op == "==" || b.op == "!=") {
            var eqL: ArgStash = lower_view_borrowed_parked(b.left, s);
            var sl: LowerState = eqL.state;
            if (!sl.ok) { return sl; }
            var eqR: ArgStash = lower_view_borrowed_parked(b.right, sl);
            var sr: LowerState = eqR.state;
            if (!sr.ok) { return sr; }
            var se: LowerState = sr.emit(ir.op_str_eq());
            se = free_parked_view_after(se, eqL.slot);
            se = free_parked_view_after(se, eqR.slot);
            if (b.op == "!=") { return se.emit(ir.op_bin("not", 0, false)); }
            return se;
        }
        if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
            var cmpL: ArgStash = lower_view_borrowed_parked(b.left, s);
            var cl: LowerState = cmpL.state;
            if (!cl.ok) { return cl; }
            var cmpR: ArgStash = lower_view_borrowed_parked(b.right, cl);
            var cr: LowerState = cmpR.state;
            if (!cr.ok) { return cr; }
            // str_cmp(a,b) <rel> 0
            var cc: LowerState = cr.emit(ir.op_str_cmp());
            cc = free_parked_view_after(cc, cmpL.slot);
            cc = free_parked_view_after(cc, cmpR.slot);
            cc = cc.emit(ir.op_const_i32(0));
            return cc.emit(ir.op_bin(map_binop(b.op), 0, false));
        }
        return s.fail();
    }
    // f64 dispatch: float operands lower as f64 (their bit pattern flows
    // on the rt-stack) and use the float ops. Arithmetic (+ - * /) yields
    // f64; a comparison yields an i32 bool. `%` / bitwise / shifts have no
    // float form (map_fbinop = "") and bail.
    if (expr_is_f64(b.left, s) || expr_is_f64(b.right, s)) {
        var fk: string = map_fbinop(b.op);
        if (fk == "") { return s.fail(); }
        var fl: LowerState = lower_expr(b.left, s);
        if (!fl.ok) { return fl; }
        // An i32 operand mixed with an f64 (e.g. `3.5 + 2`) must be
        // widened to f64 first — otherwise op_fbin sees an i32 on the
        // stack and the wasm module fails to validate (f64.add expects
        // two f64s). i32_to_f64 is f64.convert_i32_s. Only a 32-bit
        // non-f64 operand is converted; an i64 in f64 context is left
        // alone (unsupported, bails like before).
        if (!expr_is_f64(b.left, s) && infer_expr_width(b.left, s) != 64) {
            fl = fl.emit(ir.op_i32_to_f64());
        }
        var fr: LowerState = lower_expr(b.right, fl);
        if (!fr.ok) { return fr; }
        if (!expr_is_f64(b.right, s) && infer_expr_width(b.right, s) != 64) {
            fr = fr.emit(ir.op_i32_to_f64());
        }
        fr = fr.emit(ir.op_fbin(fk));
        // f32 arithmetic rounds its result to single precision: f32
        // shares the 8-byte f64 slot, so fadd/fsub/fmul/fdiv compute at
        // DOUBLE precision, but native gives f32 a true 4-byte slot and
        // rounds after every op (`fadd s`-class). Round via the
        // f32_bits/f32_from_bits round-trip (demote → promote) when the
        // op is arithmetic — a comparison (is_fcmp_kind) yields an i32
        // bool that must NOT be rounded — and at least one operand is
        // f32. Idempotent with a later `as f32` cast. (#4366 — the
        // arithmetic sibling of the `as f32` cast rounding.)
        if (!is_fcmp_kind(fk) && (expr_is_f32(b.left, s) || expr_is_f32(b.right, s))) {
            fr = fr.emit(ir.op_f32_bits());
            fr = fr.emit(ir.op_f32_from_bits());
        }
        return fr;
    }
    var kind: string = map_binop(b.op);
    if (kind == "") { return s.fail(); }
    // i64 dispatch: if either operand is an i64 value, the operands are
    // lowered as i64 and the op runs at 64-bit width. Arithmetic
    // (including div/rem) yields i64; a comparison yields an i32 bool (the
    // backend knows from the kind).
    if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) {
        var li: LowerState = lower_i64(b.left, s);
        if (!li.ok) { return li; }
        var ri: LowerState = lower_i64(b.right, li);
        if (!ri.ok) { return ri; }
        // u64 operands take the UNSIGNED i64 ops (compare / >> / div / rem)
        // — signed versions are wrong once bit 63 is set (#2904). A shift's
        // signedness follows the left (shifted) operand; compare/div use
        // either side. add/sub/mul/and/or/xor/shl/eq/ne are sign-agnostic.
        var i64k: string = kind;
        var lu: boolean = expr_is_u64(b.left, s);
        if (b.op == ">>" || b.op == "<<") {
            if (lu) { i64k = to_unsigned_kind(kind); }
        } else if (lu || expr_is_u64(b.right, s)) {
            i64k = to_unsigned_kind(kind);
        }
        return ri.emit(ir.op_bin(i64k, 64, false));
    }
    var s1: LowerState = lower_expr(b.left, s);
    if (!s1.ok) { return s1; }
    var s2: LowerState = lower_expr(b.right, s1);
    if (!s2.ok) { return s2; }
    // u32 wrapping: a u32 `>>` is a LOGICAL shift (shr_u); a u32
    // arithmetic op whose value can exceed 32 bits (+ - * <<) is masked
    // back to 32 bits on the register backends (no-op on wasm's native
    // i32). Native wraps every u32 op at 2^32; without this u32-heavy
    // code (the SHA-256 schedule / __rotr) kept stray high bits.
    var ek: string = kind;
    var left_u32: boolean = expr_is_u32(b.left, s);
    var right_u32: boolean = expr_is_u32(b.right, s);
    if (b.op == ">>" && left_u32) { ek = "shr_u"; }
    // u32 ORDERING compares need the UNSIGNED IR kind (lt_u/le_u/gt_u/
    // ge_u): a u32 value ≥ 2^31 is signed-negative in a 32-bit slot, so a
    // signed compare gives the wrong answer on wasm. Remap via the same
    // to_unsigned_kind path u64 uses (#2904); the wasm backend then emits
    // i32.*_u and asm_ir emits setb/seta — both correct for a u32. eq/ne
    // are sign-agnostic and pass through. (#2917)
    if ((left_u32 || right_u32) && (kind == "lt_s" || kind == "le_s" || kind == "gt_s" || kind == "ge_s")) {
        ek = to_unsigned_kind(kind);
    }
    // u32 DIVISION / REMAINDER must be unsigned too: a u32 numerator >=
    // 2^31 reads as signed-negative in a 32-bit slot, so signed div/rem
    // give the wrong quotient (x86/wasm computed it signed — arm happened
    // to be right because its 64-bit reg held the value zero-extended).
    // Remap div_s/rem_s -> div_u/rem_u when either operand is u32, the
    // same way u64 does (#2904); add/sub/mul stay sign-agnostic. (#3204+)
    if ((left_u32 || right_u32) && (kind == "div_s" || kind == "rem_s")) {
        ek = to_unsigned_kind(kind);
    }
    var res: LowerState = s2.emit(ir.op_bin(ek, 0, false));
    var res_u32: boolean = left_u32 || right_u32;
    if (res_u32 && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
        res = res.emit(ir.op_u32_wrap());
    }
    // Sub-32-bit wrap: a u8 `+`/`-`/`*`/`<<` whose result can
    // exceed the width is masked back (int_cast),
    // matching the interpreter's per-width wrap (`255u8 + 1 == 0`). The
    // operands are themselves kept in range by this same step, so each
    // op masks its own result. u32/u64 are disjoint (res_u32 is false
    // here), so this never double-wraps.
    var sub_kind: string = expr_subword_kind(e, s);
    if (sub_kind != "" && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
        res = res.emit(ir.op_int_cast(sub_kind));
    }
    // Plain-i32 wrap: a default-int (i32) +/-/*/<< whose result can
    // exceed 32 bits is sign-extended back to 32 bits so it wraps
    // exactly like the native backend's 32-bit register and the AST
    // interpreter's width-32 arithmetic (#3581): `2147483647 + 1` ==
    // -2147483648, not the wide 2147483648. u32 (op_u32_wrap) and
    // sub-word (op_int_cast above) are disjoint from this case
    // (res_u32 false, sub_kind ""), and the i64 / f64 dispatches
    // returned earlier, so this fires only for a true i32 op.
    // op_int_cast("i32") is the signed sibling of op_u32_wrap.
    if (!res_u32 && sub_kind == "" && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
        res = res.emit(ir.op_int_cast("i32"));
    }
    return res;
}

// lower_expr_ident lowers an identifier read — a local slot, a capture, or a const.
function lower_expr_ident(id: ast.ExprIdent, s: LowerState): LowerState {
    var slot: i32 = s.slot_of(id.name);
    if (slot >= 0) { return s.emit(ir.op_load_local(slot)); }
    // A bare struct name that isn't a local is a no-payload enum variant
    // value (e.g. `Red`, `Empty`): a 0-field variant box via struct_make.
    // Checked BEFORE the builtin `None` below, the way the call arm
    // checks decl_is_struct before `Some` / `Ok`: a user enum may
    // declare `None`, and only the user's variant is a declared struct,
    // so ownership is what separates them. The other order built an
    // Option box for `enum E { …, None }`, which then matched no
    // variant index at all.
    if (decl_is_struct(s.structs, id.name) && decl_field_count(s.structs, id.name) == 0) {
        return s.emit(ir.op_struct_make(id.name, 0, decl_index_of(s.structs, id.name)));
    }
    // The empty Option `None` → a payloadless box with tag 1.
    if (id.name == "None") { return s.emit(ir.op_opt_none()); }
    // A bare identifier that is not a local naming a ZERO-ARG,
    // receiver-less function (a `const`, desugared to such a function) is
    // a CALL to it — its value. Mirrors the retired x86 AST emitter's ExprIdent rule
    // (zero-arg receiver-less -> call).
    if (s.is_const_fn(id.name)) { return s.emit(ir.op_call_direct(id.name, 0)); }
    // A bare ident naming a module function WITH params is a function
    // VALUE — a plain (capture-free) function pointer (`var f = dbl;
    // f(21)`, `return namedfn`). Emit const_func; const_funcs_only_known
    // bails the module if the name isn't a known function, so an
    // unknown / non-function ident (which the checker would already have
    // rejected) never miscompiles. Mirrors the retired x86 AST emitter's ExprIdent rule
    // (zero-arg receiver-less -> call; >0-arg -> boxed fn-value). A call
    // through the resulting fn-value local rides the existing
    // call_indirect path (the same one a "fn"-typed param uses).
    return s.emit(ir.op_const_func(0, id.name));
}

// lower_expr_field_access lowers a field read, including a tuple index and an enum payload projection.
function lower_expr_field_access(fa: ast.ExprFieldAccess, s: LowerState): LowerState {
    // Numeric field `t.0` / `t.1` → tuple element access (no shape slot,
    // element i at slot i). The receiver must be a tuple; a non-tuple
    // numeric access can't type-check, so this is unambiguous.
    if (util.is_all_digits(fa.field)) {
        var tgi: i32 = util.digits_to_i32(fa.field);
        var so0: LowerState = lower_expr(fa.obj, s);
        if (!so0.ok) { return so0; }
        // An 8-byte element (i64 / f64) reads with the matching load; an
        // i64 element in an i32 context is a checker error (the valid i64
        // read routes through lower_i64). i32 / string / struct elements
        // keep the 4-byte read.
        var tgt: string = expr_tuple_elem_tag(fa.obj, tgi, s);
        if (tgt == "i64" || tgt == "u64") { return so0.emit(ir.op_tuple_get_w(tgi, 64, true)); }
        if (tgt == "f64" || tgt == "f32" || tgt == "float") { return so0.emit(ir.op_tuple_get_w(tgi, 64, false)); }
        return so0.emit(ir.op_tuple_get(tgi));
    }
    // Qualified built-in `Option.None` (no call) — the same value as the
    // bare `None`: the canonical none box (op_opt_none). The native
    // compiler accepts both spellings; without this the qualified form
    // bailed the module to AST.
    match (fa.obj) {
        ast.ExprIdent(noid) => {
            if (noid.name == "Option" && fa.field == "None" && s.slot_of(noid.name) < 0) {
                return s.emit(ir.op_opt_none());
            }
        },
        _ => {}
    }
    // Qualified UNIT-variant value `Enum.Variant` (no call) — the same
    // value as the bare unit variant `Variant`: a 0-field variant box via
    // struct_make. (The payload form `Enum.Variant(args)` is handled in
    // ExprCall.) `fa.field` must be a variant DECLARED BY the bare type
    // name in `fa.obj` (not a local) — asked of that enum, because two
    // enums may declare the same variant name and the by-name lookup
    // answers for whichever was declared first.
    match (fa.obj) {
        ast.ExprIdent(uvid) => {
            var uvi: i32 = variant_decl_index(s.structs, fa.field, uvid.name);
            if (uvi >= 0 && s.slot_of(uvid.name) < 0
                && s.structs[uvi].fields.len() == 0) {
                return s.emit(ir.op_struct_make(fa.field, 0, uvi));
            }
        },
        _ => {}
    }
    // Bare struct field read `p.x` → struct_get at x's decl index. (As a
    // call receiver — `p.len()` — field access is handled in ExprCall; a
    // bare field access reaching here is a value.)
    var sty: string = expr_struct_type(fa.obj, s);
    if (sty == "") { return s.fail(); }
    var idx: i32 = s.field_index_in(sty, fa.field);
    if (idx < 0) { return s.fail(); }
    // A SCALAR field read off a fresh owned struct — `mk().k`, mk in the
    // strict-fresh registry — reclaims that box here, the index read's
    // sibling (#6491). The deep field drop rides the same admission the
    // discarded-`mk(i);` reclaim uses: the strict-fresh registry proves
    // the box sole-owns every field buffer, so __struct_drop_<T> cannot
    // double-free one. A type with no reclaimable field skips straight
    // to the box dec.
    // A `string` field takes the MOVE form instead ("STRFLDF:", #6491):
    // the registry proves the box sole-owns that field's box, so the read
    // hands the reference on unchanged and the box dec below is the whole
    // release. No retain and no field drop — the struct carries no
    // rc-array field on this admission, so nothing else touches it.
    var faown: string = "";
    if (owned_scalar_field_type(decl_field_type(s.structs, sty, fa.field))) {
        faown = owned_fresh_call_callee(fa.obj, "", s);
    } else if (decl_field_type(s.structs, sty, fa.field) == "string") {
        faown = owned_fresh_call_callee(fa.obj, "STRFLDF:", s);
        // A BORROWED string field. The producer is strict-fresh, so the
        // BOX is this frame's own allocation and nothing names it — but
        // its string arrived from a parameter (or any source this frame
        // did not allocate), which is precisely what "STRFLDF:" refuses.
        // Refusing the MOVE is right; refusing the box was not, and the
        // whole box leaked per evaluation.
        //
        // Reclaim the box alone. The dec below is shallow — the deep
        // __struct_drop_<T> above it is separately gated — so the
        // moved-out pointer stays owned by whoever allocated it and this
        // can never over-release. Every consumer that would treat the
        // read as owning its string ("STRFLDF:" at the .len() receiver
        // site, and the binding credit) keys on that entry, so none of
        // them is reached from here.
        //
        // No rc-array field: skipping __struct_drop_<T> would strand one,
        // which is safe but pointless, and admitting it would need the
        // deep drop this read cannot prove.
        if (faown == "" && !struct_has_reclaim_array_field(s.structs, sty)) {
            faown = owned_fresh_call_callee(fa.obj, "", s);
        }
    }
    // A MIXED-path method producer (`b.relabel(t).tag`, "FRESHSELF:"):
    // every return is either a strict-fresh literal or the receiver
    // itself, so which box arrived is a runtime fact and the pointer
    // decides it — the struct twin of the SFRRECV chain release. The
    // release is the BARE box dec: the fresh path's field values are
    // not proven owned (`Box { tag: t, … }` takes a parameter's box),
    // so the field read stays a borrow and everything the box does own
    // leaks with it, which is the established safe floor.
    var fsrecv: i32 = 0 - 1;
    if (faown == "" && !struct_field_is_i64(s.structs, sty, idx)
            && (owned_scalar_field_type(decl_field_type(s.structs, sty, fa.field))
                || decl_field_type(s.structs, sty, fa.field) == "string")) {
        fsrecv = freshself_call_recv_slot(fa.obj, s);
    }
    // A SCALAR field read off an ELEMENT of a fresh struct-array producer —
    // `mk()[i].k`, mk in the "STRUCTARRF:" / "ARRSTRUCTF:" registries
    // (#7259). The index site's own reclaim cannot fire on these classes:
    // releasing the container there frees the element box the field read is
    // about to enter. So the release moves up to this node — park the
    // container, index into it, read the field, THEN release with the exit
    // sweep's class split. Scalar non-i64 reads only: an rc-field result
    // would alias a box the release frees.
    if (faown == "" && owned_scalar_field_type(decl_field_type(s.structs, sty, fa.field))
            && !struct_field_is_i64(s.structs, sty, idx)) {
        match (fa.obj) {
            ast.ExprIndex(fia) => {
                var fiac: string = owned_fresh_call_callee(fia.array, "STRUCTARRF:", s);
                if (fiac == "") { fiac = owned_fresh_call_callee(fia.array, "ARRSTRUCTF:", s); }
                if (fiac != "" && decl_is_struct(s.structs, s.struct_ret_type(fiac))) {
                    var fxs: LowerState = lower_expr(fia.array, s);
                    if (!fxs.ok) { return fxs; }
                    var fxn: string = "$fxarr" + util.i32_to_string(fxs.locals.len());
                    fxs = fxs.add_local(fxn);
                    var fxslot: i32 = fxs.slot_of(fxn);
                    fxs = fxs.emit(ir.op_store_local(fxslot));
                    fxs = fxs.emit(ir.op_load_local(fxslot));
                    fxs = lower_expr(fia.index, fxs);
                    if (!fxs.ok) { return fxs; }
                    fxs = fxs.emit(ir.op_arr_get(32));
                    fxs = fxs.emit(ir.op_struct_get(idx, struct_field_width(s.structs, sty, idx)));
                    var fxv: string = "$fxval" + util.i32_to_string(fxs.locals.len());
                    fxs = fxs.add_local(fxv);
                    var fxvslot: i32 = fxs.slot_of(fxv);
                    fxs = fxs.emit(ir.op_store_local(fxvslot));
                    if (struct_has_reclaim_array_field(fxs.structs, sty) || fxs.struct_routes_field_reclaim(sty)) {
                        fxs = emit_arrstruct_deep_free(fxs, fxslot, sty);
                    } else {
                        fxs = fxs.release(fxslot, "__fern_arrarr_free", "fldread-fresh-structarr");
                    }
                    return fxs.emit(ir.op_load_local(fxvslot));
                }
            },
            _ => {}
        }
    }
    // A fresh struct LITERAL receiver — `(P { … }).k`. The box is a
    // temporary nothing else can reach, exactly like the strict-fresh
    // producer call above, so the same release applies: read the field,
    // deep-drop the rc fields while the box still owns them, then dec it.
    //
    // Gated on the field READ being a SCALAR, which is a different
    // question from the producer arm's. There is no callee here to ask
    // about borrowing; the hazard is that the read RESULT could alias a
    // field the drop frees. A scalar result cannot, so the drop is
    // unconditionally safe. An rc-field read (`(A { … }).xs`) stays
    // refused — admitting it needs a retain this read cannot prove.
    var falit: boolean = false;
    if (faown == "" && fsrecv < 0
            && owned_scalar_field_type(decl_field_type(s.structs, sty, fa.field))) {
        match (fa.obj) {
            ast.ExprStructLit(fsl) => {
                if (!fsl.has_base
                    && (struct_lit_all_scalar(s.structs, fsl.type_name)
                        || struct_fields_reusable(s.structs, fsl.type_name))) { falit = true; }
            },
            _ => {}
        }
    }
    var so: LowerState = lower_expr(fa.obj, s);
    if (!so.ok) { return so; }
    if (fsrecv >= 0) {
        var fsn: string = "$fsfld" + util.i32_to_string(so.locals.len());
        so = so.add_local(fsn);
        var fsslot: i32 = so.slot_of(fsn);
        so = so.mark_struct_type(fsslot, sty);
        so = so.emit(ir.op_store_local(fsslot));
        // Park the field value: the release opens a block, and the read
        // has to happen while the box is still alive either way.
        var fsv: string = "$fsval" + util.i32_to_string(so.locals.len());
        so = so.add_local(fsv);
        var fsvslot: i32 = so.slot_of(fsv);
        so = so.emit(ir.op_load_local(fsslot));
        so = so.emit(ir.op_struct_get(idx, struct_field_width(s.structs, sty, idx)));
        so = so.emit(ir.op_store_local(fsvslot));
        so = emit_freshself_release(so, fsslot, fsrecv);
        return so.emit(ir.op_load_local(fsvslot));
    }
    if (faown != "" || falit) {
        var fan: string = "$ocfld" + util.i32_to_string(so.locals.len());
        so = so.add_local(fan);
        var faslot: i32 = so.slot_of(fan);
        so = so.mark_struct_type(faslot, sty);
        so = so.emit(ir.op_store_local(faslot));
        so = so.emit(ir.op_load_local(faslot));
        if (struct_field_is_i64(s.structs, sty, idx)) { so = so.emit(ir.op_struct_get_i64(idx)); }
        else { so = so.emit(ir.op_struct_get(idx, struct_field_width(s.structs, sty, idx))); }
        if (struct_fields_reusable(s.structs, sty) && struct_has_reclaim_array_field(s.structs, sty)) {
            so = so.emit(ir.op_load_local(faslot));
            so = so.emit(ir.op_call_direct("__struct_drop_" + sty, 1));   // deep-drop the rc fields
            so = so.emit(ir.op_drop());                                   // discard the clobbered return
        }
        so = so.emit(ir.op_load_local(faslot));
        so = so.emit(ir.op_call_direct("__fern_rc_dec", 1));              // free the box
        return so.emit(ir.op_drop());
    }
    // An i64 field reads an 8-byte integer (i64.load); f64 an 8-byte
    // float; i32 the 4-byte path. (An i64 field in an i32 context is a
    // checker error; a valid i64 read routes through lower_i64 below.)
    if (struct_field_is_i64(s.structs, sty, idx)) { return so.emit(ir.op_struct_get_i64(idx)); }
    return so.emit(ir.op_struct_get(idx, struct_field_width(s.structs, sty, idx)));
}

// lower_expr_struct_lit lowers a struct literal `P { a: .., b: .. }` and its functional-update form.
function lower_expr_struct_lit(slit: ast.ExprStructLit, s: LowerState): LowerState {
    // Struct literal `P { a: .., b: .. }` and functional update
    // `P { ...base, b: v }` → struct_make. Only scalar-field (i32/boolean)
    // structs are lowered (leak-only). Every DECL field is produced in
    // decl order: an overridden field lowers its literal value; otherwise
    // (update only) it is copied from the base via struct_get. The base
    // may be an ident (re-read per copied field, side-effect-free) or any
    // struct-typed expression of the same type — a non-ident base is
    // evaluated once into a scratch local and re-loaded per copied field.
    if (!decl_is_struct(s.structs, slit.type_name)) { return s.fail(); }
    if (!decl_is_leaksafe(s.structs, slit.type_name)) { return s.fail(); }
    // Every field a compile-time scalar literal (#6149): the whole box is
    // a constant, so place it in static data instead of allocating and
    // storing one per evaluation. Tested before any lowering below so the
    // op replaces the entire struct_make sequence, field pushes included.
    var cagg: ConstAgg = const_agg_of(slit, s.structs);
    if (cagg.ok) {
        return s.emit(ir.op_const_struct(slit.type_name, decl_field_count(s.structs, slit.type_name), cagg.values));
    }
    if (slit.has_base) {
        // The base may be an ident OR any struct-typed expression whose
        // type resolves (a struct-returning call `mk()`, a struct field
        // read `o.inner`, a struct-array element `arr[i]`). A non-ident
        // base is spilled into a scratch local once below so each copied
        // field re-reads the SAME evaluated value — never re-evaluating a
        // side-effecting base (e.g. a call) per field.
        if (expr_struct_type(slit.base, s) != slit.type_name) { return s.fail(); }
    }
    // base_is_ident: an ident base re-reads its own slot per copied field
    // (free, side-effect-free), so its lowering stays byte-identical — only
    // a non-ident base needs the scratch-local spill.
    var base_is_ident: boolean = false;
    if (slit.has_base) {
        match (slit.base) {
            ast.ExprIdent(_) => { base_is_ident = true; },
            _ => {}
        }
    }
    var ndecl: i32 = decl_field_count(s.structs, slit.type_name);
    // #4297 A2: per-struct-lit ownership precompute (COLD — once per lit) so
    // the hot per-field path below reads only scalars, never re-reading a
    // field-value expression (which would taint lower_expr's locals → the
    // documented emit runaway). slit_own[found] is the field's ownership;
    // slit_reclaim gates the string-field retain on the struct routing
    // through the field-reclaim/struct-drop path at all (rc-array /
    // nested-struct / enum field, or a STRFLDOK-admitted string-fielded
    // type — the same struct_routes_field_reclaim predicate the
    // consume-rebind AND the exit sweep's emit_struct_field_drops use,
    // so the k_str decs those emit stay balanced with this retain).
    var slit_own: i32[] = field_ownerships(slit, s);
    // #4355 slice 3: the retain widens in lockstep with the reclaim
    // routing — a STRFLDOK-admitted string-only struct now retains
    // its non-fresh string fields exactly like an array-carrying
    // one, balancing the __field_reclaim / __struct_drop k_str decs.
    var slit_reclaim: boolean = s.struct_routes_field_reclaim(slit.type_name);
    // #6653: `o = S { …, ys: o.ys, … }`. The successor box is going into
    // the slot `o` names, and __field_reclaim_'s ARRAY arm cow-SKIPS a
    // field that is pointer-equal in old and new — so nothing ever decs
    // a retain taken here, and one buffer per call is stranded. The
    // `...o` spelling has always been exactly balanced for the same
    // reason read the other way: its base-copy path emits no inc for an
    // array field either. Consumed below, then cleared off `sm` at once
    // so a NESTED literal in a field value keeps its own retain.
    var slit_selfrebind: string = s.selfrebind;
    var sm: LowerState = s.with_selfrebind("");
    // COMPACT functional-update lowering (#4650): when the struct's fields all
    // copy with no per-field rc-inc (struct_copy_eligible), the N unchanged
    // fields are copied by ONE op_struct_copy(base) instead of N inline
    // struct_get/store pairs per update site — the fresh box is stashed in a
    // result temp, each overridden field is written with op_struct_set, and the
    // temp is the result. This collapses the ~1.75x working-set blow-up the
    // per-field fan-out costs across the encoders' ~90 update sites. Only the
    // BASE COPY changes; each override still lowers through the identical
    // value/alias-inc path below.
    var compact: boolean = false;
    var result_slot: i32 = 0 - 1;
    // Spill a non-ident functional-update base into a scratch local once
    // (composed of existing store/load_local ops, so every backend +
    // eval_ops handle it for free — the same pattern as emit_arr_store).
    var base_tmp: i32 = 0 - 1;
    if (slit.has_base && struct_copy_eligible(s.structs, slit.type_name)) {
        compact = true;
        var rscratch: string = "$scp" + util.i32_to_string(sm.locals.len());
        sm = sm.add_local(rscratch);
        result_slot = sm.slot_of(rscratch);
        sm = lower_expr(slit.base, sm);
        if (!sm.ok) { return sm; }
        sm = sm.emit(ir.op_struct_copy(ndecl));
        sm = sm.emit(ir.op_store_local(result_slot));
    } else if (slit.has_base && !base_is_ident) {
        var bscratch: string = "$fub" + util.i32_to_string(sm.locals.len());
        sm = sm.add_local(bscratch);
        base_tmp = sm.slot_of(bscratch);
        sm = lower_expr(slit.base, sm);
        if (!sm.ok) { return sm; }
        sm = sm.emit(ir.op_store_local(base_tmp));
    }
    var di: i32 = 0;
    while (di < ndecl) {
        // find the literal field whose decl index is di (an override)
        var jj: i32 = 0;
        var found: i32 = 0 - 1;
        while (jj < slit.field_names.len()) {
            if (s.field_index_in(slit.type_name, slit.field_names[jj]) == di) { found = jj; }
            jj = jj + 1;
        }
        if (found >= 0) {
            // A scalar-array field must be set from a FRESH array literal,
            // OR from a bare ident naming an rc-tracked scalar-array local
            // (the alias-into-construction case). A fresh literal is owned
            // by the struct and never enters the local exit-sweep, so it
            // leaks with the struct (no dangling). For an aliased local we
            // emit a Perceus dup (rc_inc) below, so the struct's field owns
            // a counted reference: the source local's slot is still swept
            // (dec) at exit, and the struct's field is deep-dropped (dec) on
            // the box's reclamation — the inc balances both decs (rc 1 →inc
            // 2 →sweep(local) 1 →field-drop 0). Anything else (a call, an
            // IIFE with a non-literal branch, an array-OF-struct/enum alias)
            // could alias a swept local with no counted handle → bail.
            var cfft: string = decl_field_type(s.structs, slit.type_name, slit.field_names[found]);
            var fav_alias_inc: boolean = false;
            if (is_leaksafe_array_field(cfft) || is_struct_array_field_type(s.structs, cfft)
                || tuple_field_reclaim_ok(cfft, slit.field_values[found], s)) {
                // A fresh array LITERAL, or an if-/match-expression whose
                // every branch returns a fresh array literal (#3175) — both
                // are owned by the struct (no aliasing). A bare ident naming
                // an array-tracked scalar-element local is admitted via the
                // dup (alias-inc), but ONLY for the scalar-element field
                // (is_leaksafe_array_field); array-of-struct / array-of-enum
                // field aliasing (deep-drop recursion) is a later slice.
                var fav: ast.Expr = slit.field_values[found];
                var fav_ok: boolean = iife_returns_fresh_array(fav);
                match (fav) {
                    ast.ExprArray(_) => { fav_ok = true; },
                    // A fresh tuple LITERAL (`Hold { t: (7, [7, 8]) }`) is owned by
                    // the struct outright, the tuple analogue of the array-literal
                    // arm above.
                    ast.ExprTuple(_) => { if (tuple_field_reclaim_ok(cfft, fav, s)) { fav_ok = true; } },
                    ast.ExprIdent(faid) => {
                        // A bare ident naming an rc-tracked array local/param,
                        // SCALAR-element (is_leaksafe_array_field), array-of-
                        // struct (is_struct_array_field_type), OR array-of-enum
                        // (is_enum_array_field_type): the field aliases the
                        // local's buffer, so retain it with a Perceus dup
                        // (alias-inc) — the dup is on the buffer POINTER, element-
                        // type-agnostic, exactly like the field-access arm below
                        // (`S { xs: s.xs }`) and the struct-array bind/return/
                        // assign positions. Enum-array fields take the IDENTICAL
                        // is_unique-gated deep-drop as struct-array fields
                        // (emit_struct_field_drops' k_box path), so the same
                        // alias-inc keeps the source's and the new box's field
                        // drops balanced — `DeferAcc { stmts: one }` over a
                        // `Stmt[]` local (parser.dl_collect_stmt).
                        if ((is_leaksafe_array_field(cfft) || is_struct_array_field_type(s.structs, cfft) || is_enum_array_field_type(s.structs, cfft))
                            && s.is_arr_slot(s.slot_of(faid.name))) {
                            fav_ok = true;
                            fav_alias_inc = true;
                        }
                        // A TUPLE field set from a tuple-box local (`Hold { t: k }`);
                        // the tuple-LITERAL spelling is admitted by the ExprTuple
                        // arm below. Both are pre-cleared by tuple_field_reclaim_ok,
                        // which is what keeps an unadmitted shape out of this block
                        // and away from its s.fail().
                        // The retain half of the pair emit_struct_tuple_field_drops
                        // documents: its child walk is __fern_rc_is_unique-gated and
                        // that gate is only sound if a SHARED tuple field was
                        // alias-inc'd here, so two owners cannot each read unique.
                        // fav_alias_inc also routes the move analysis, which elides
                        // both the inc and the sweep dec when the store is a last use.
                        if (tuple_field_reclaim_ok(cfft, fav, s)) {
                            fav_ok = true;
                            fav_alias_inc = true;
                        }
                    },
                    // A BARE array-field COPY (`State { xs: s.xs }`, or
                    // array-of-struct `S { ops: s.ops }`): the field read
                    // lowers via struct_get (a real array pointer), aliasing
                    // the SOURCE struct's array — so the new box co-owns it.
                    // Retain it with the same Perceus dup (fav_alias_inc) as
                    // the ident case: rc 1 →inc 2 →source-struct field-drop 1
                    // →new-struct field-drop 0, both deep-drops balanced by
                    // the one inc (#3292 idiom, on a field-read source —
                    // RC-frontier slice 3). field_access_arr_field_type only
                    // admits a scalar-element OR array-of-struct field read
                    // (NOT enum-array), matching the outer struct-lit gate.
                    ast.ExprFieldAccess(_) => {
                        if (field_access_arr_field_type(fav, s) != "") {
                            fav_ok = true;
                            fav_alias_inc = !selfrebind_field_alias(fav, slit_selfrebind);
                        }
                    },
                    // A ROW of a nested array (`G { lines: placed[0] }` over
                    // `placed: i32[][]`) — the index spelling of the aliasing
                    // the ident and field-read arms above admit. The row is
                    // BORROWED: the outer array still owns it, and its reclaim
                    // (__fern_arrarr_free) rc-decs every element pointer, so
                    // the field's buffer-only drop is a SECOND dec of one
                    // buffer. The Perceus dup balances both, exactly as it
                    // does for a bare local: rc 1 →inc 2 →field-drop 1
                    // →arrarr_free 0, freed once.
                    // expr_is_arr_src is true for an ExprIndex only when the
                    // indexed expression names an is_arrarr_slot local, so
                    // this admits the row read and nothing else.
                    ast.ExprIndex(_) => {
                        if (is_leaksafe_array_field(cfft) && expr_is_arr_src(fav, s)) {
                            fav_ok = true;
                            fav_alias_inc = true;
                        }
                    },
                    // The immutable-update idiom `State { xs: s.xs.with(i, v), … }`
                    // / `State { xs: s.xs.append(v), … }`. The `.with` / `.append`
                    // on a scalar-element array field read produces a FRESH,
                    // sole-owned array (lower_arr_with_value / _append_value clone
                    // the receiver — the base field is borrowed for the copy, NOT
                    // aliased into the result), so it is owned by the struct with
                    // NO alias-inc — exactly like the `[…]` literal case. Only the
                    // scalar-element field (is_leaksafe_array_field); array-of-
                    // struct / array-of-enum fields stay bailing (deep copy later).
                    ast.ExprCall(favc) => {
                        if (is_leaksafe_array_field(cfft)) {
                            match (favc.callee) {
                                ast.ExprFieldAccess(favfa) => {
                                    if ((favfa.field == "with" && favc.args.len() == 2)
                                        || (favfa.field == "append" && favc.args.len() == 1)) {
                                        if (scalar_arr_field_type(favfa.obj, s) != "") {
                                            fav_ok = true;
                                        } else {
                                            // A bare-ident scalar-array LOCAL / PARAM receiver
                                            // (`DeferAcc { flags: flags.append(d.on_error) }`
                                            // over an i32[] — parser.dl_collect_stmt). Like the
                                            // field-read receiver above (and the `[…]` literal),
                                            // lower_arr_with_value / _append_value clone the
                                            // receiver into a FRESH sole-owned array, so the
                                            // struct owns it with NO alias-inc (the receiver is
                                            // borrowed for the copy, not aliased into the result).
                                            // Inside is_leaksafe_array_field(cfft) the field — and
                                            // hence this receiver, by the call's result type — is a
                                            // scalar-element array, so is_arr_slot is the only gate.
                                            match (favfa.obj) {
                                                ast.ExprIdent(rid) => {
                                                    if (s.is_arr_slot(s.slot_of(rid.name))) { fav_ok = true; }
                                                },
                                                _ => {}
                                            }
                                        }
                                    }
                                },
                                _ => {}
                            }
                            // A FRESH/owned scalar-array-returning CALL as the
                            // field value — `S { data: s.bytes() }`, `S { xs:
                            // gen() }`, `S { xs: arr.reverse() }`. expr_is_arr_src
                            // (and the f64/i64 twins) classify exactly the
                            // move sources: a string `.bytes()`/`.split()`, an
                            // array-returning user fn (arr_ret_fns), __alloc_u8,
                            // or an array-method result — each a fresh, sole-
                            // owned buffer moved into the struct's field. Owned
                            // by the struct with NO alias-inc, exactly like the
                            // `[…]` literal: the callee moves the buffer out, so
                            // nothing else holds a counted handle to dec. Mirrors
                            // the unrestricted string[]-field-value path (string[]
                            // skips this gate entirely). Bails (fav_ok stays
                            // false) for any call the predicates don't recognise.
                            if (!fav_ok) {
                                if (is_float_array_type_name(cfft)) {
                                    if (expr_is_f64arr(fav, s)) { fav_ok = true; }
                                } else if (cfft == "i64[]") {
                                    if (expr_is_i64arr(fav, s)) { fav_ok = true; }
                                } else if (expr_is_arr_src(fav, s)) {
                                    fav_ok = true;
                                }
                            }
                        } else if (is_struct_array_field_type(s.structs, cfft) || is_enum_array_field_type(s.structs, cfft)) {
                            // A CALL returning an array-of-struct OR array-of-enum as
                            // the field value (`Module { structs: inject_builtin_enums(
                            // mono.structs) }`, or `DeferAcc { actions: actions.append(
                            // d.action) }` over a `Stmt[]` — parser.dl_collect_stmt):
                            // the call's result is an array VALUE on the operand stack,
                            // stored straight into the field with NO alias-inc. Both
                            // struct- and enum-array fields take the IDENTICAL is_unique-
                            // gated deep-drop (emit_struct_field_drops' k_box walk), and
                            // that gate is what makes the missing inc safe: a callee that
                            // returned an ALIASED buffer leaves it rc>1 (e.g. arr_push's
                            // in-place fast path bumps rc to 2, or a shared receiver took
                            // the copy path), so is_unique is false and the walk is
                            // skipped — it only leaks, never over-frees. A genuinely
                            // fresh sole-owned result is rc==1 and reclaimed. (A SCALAR-
                            // array field's drop is buffer-only, not is_unique-gated, so
                            // it stays restricted to the fresh-guaranteed .with/.append +
                            // expr_is_arr_src forms above.) Mirrors the array-literal case.
                            fav_ok = true;
                        }
                    },
                    _ => {}
                }
                if (!fav_ok) { return s.fail(); }
            }
            // Array fields whose ELEMENT type skips the admission gate above
            // (`string[]`, or an enum-array like `Ty[]` — neither
            // is_leaksafe_array_field nor is_struct_array_field_type) still
            // ALIAS a bare array-LOCAL/param ident's buffer when set from one,
            // e.g. `EmitState { ...s, local_names: ln, local_types: lts }` over
            // `var ln: string[] = []` / `var lts: Ty[] = []`. The scalar-array /
            // struct-array gate already alias-incs its own bare idents; without
            // the same retain here the local is BOTH stored into the field AND
            // freed by the function-exit dec-sweep, double-freeing the buffer the
            // (returned / escaping) struct now owns — the reset_locals
            // use-after-free that broke the per-module self-build. Retain it with
            // the same Perceus dup so the sweep dec is balanced (the struct keeps
            // a counted reference; a borrowed-param source simply leaks, never
            // over-frees). The inc is on the ARRAY buffer — a real rc-headered
            // box (__fern_arr_box) — never a header-less string box, so it is
            // sound (cf. the scalar-string-field warning below).
            if (!fav_alias_inc && is_array_type_name(cfft)) {
                match (slit.field_values[found]) {
                    ast.ExprIdent(aaid) => {
                        if (s.is_arr_slot(s.slot_of(aaid.name))) { fav_alias_inc = true; }
                    },
                    // The FIELD-READ spelling of the same aliasing, for an
                    // enum- or union-array field. The read lowers via
                    // struct_get to the SOURCE box's buffer, so the new box
                    // co-owns it. Retained here rather than by widening the
                    // admission gate above: this arm sets only fav_alias_inc,
                    // never fav_ok, so it cannot reach that gate's s.fail().
                    // That matters because is_enum_array_field_type bottoms out
                    // in a negative test a `type A | B` union passes, putting
                    // ast.Stmt[] — and so every statement block in the
                    // compiler — inside the same class.
                    _ => {
                        if (enum_arr_field_share_read(slit.field_values[found], cfft, s).len() > 0) { fav_alias_inc = true; }
                    }
                }
            }
            // A DIRECT nested-struct field (`inner: Inner`, decl_is_struct,
            // not an array): now SHALLOW-dropped on the struct's reclamation
            // (emit_ir_struct_drop_one's k_struct → arr_dec of the inner box,
            // one level). To balance that dec, retain the field whenever its
            // source could ALIAS a box another owner also drops. ONLY a fresh
            // struct LITERAL `Inner { … }` is provably sole-owned (rc 1) and
            // reclaimed with no inc; EVERY other source (a bare struct ident, a
            // field copy `o.inner`, a struct-returning call) is inc'd —
            // conservative and SOUND: a genuinely-fresh non-literal source then
            // just LEAKS (rc never reaches 0), never double-frees. (Tightening
            // the fresh set to fresh-returning calls is a follow-up.) The inc is
            // on a real rc-headered struct box (never a header-less string), so
            // it is sound — cf. the string-field skip below.
            if (!fav_alias_inc && decl_is_struct(s.structs, cfft)) {
                var nfv_fresh: boolean = false;
                match (slit.field_values[found]) {
                    ast.ExprStructLit(_) => { nfv_fresh = true; },
                    // A CALL to a STRICT-fresh-struct-returning fn
                    // (`Outer { inner: mk_inner() }`): the callee handed back
                    // a fresh box that SOLE-owns every field buffer
                    // (return_fresh_struct_ret_fns), so the new struct owns it
                    // outright — NO alias-inc, and the deep-drop (is_unique-
                    // gated) reclaims the inner box AND its rc-array fields
                    // instead of leaking the rc-2 alias-inc'd box. recv_type is
                    // approximated by the field type cfft (== the call's return
                    // type); a method whose receiver type differs just misses
                    // the key (conservative, re-inc'd). Only the STRICT subset
                    // is admitted — the looser fresh_struct_ret_fns may alias
                    // inner element buffers, which the deep-drop would double-
                    // free (the slice-3 deep-drop follow-up).
                    ast.ExprCall(_) => {
                        if (is_fresh_ret_binding(slit.field_values[found], cfft, s.sigs.return_fresh_struct_ret_fns)) { nfv_fresh = true; }
                    },
                    _ => {}
                }
                if (!nfv_fresh) { fav_alias_inc = true; }
            }
            // A DIRECT enum field (`e: MyEnum`, decl_is_enum): now SHALLOW
            // box-dropped on the struct's reclamation (the k_enum arm of
            // __struct_drop → arr_dec of the enum box, one level). To balance
            // that dec, retain UNLESS the value is a FRESH variant ctor
            // (`V(args)` / bare `V`, variant_ctor_enum_owner != "") or a call
            // to a strict-fresh enum producer ("ENUM:" registry — every return
            // a fresh ctor), both sole-owned rc=1 and freed with no inc; every
            // other source (a bare enum local/param, a field copy, an
            // unregistered enum-returning call) is inc'd — conservative and
            // SOUND: a genuinely-fresh non-ctor source then just LEAKS (rc
            // never 0), never double-frees. Enum boxes are rc-headered
            // (op_struct_make), so the inc is sound (unlike a header-less string).
            if (!fav_alias_inc && decl_is_enum(s.structs, cfft)) {
                if (variant_ctor_enum_owner(slit.field_values[found], s.structs).len() == 0
                        && !enum_fresh_ret_call(slit.field_values[found], s.sigs.return_fresh_struct_ret_fns)) {
                    fav_alias_inc = true;
                }
            }
            // A direct TUPLE field, now released by emit_struct_tuple_field_drops
            // (child walk under is_unique, one box dec per owner). The retain is
            // that dec's other half and is gated on the SAME routing predicate,
            // so widening one widens the other by construction (#7253).
            //
            // Retain UNLESS the value is a fresh tuple LITERAL — `(a, [b])` builds
            // a sole-owned rc=1 box per evaluation, so the struct owns it outright
            // and the field drop reclaims it with no inc to balance. Every other
            // source (a bare tuple local/param, a `.f` read, a tuple-returning
            // call) may alias a box someone else still sweeps, so the store is
            // COUNTED: rc 1 -> inc 2 -> source's sweep 1 -> field drop 0. An
            // over-conservative inc on a genuinely-fresh non-literal source leaks,
            // never dangles.
            if (!fav_alias_inc && slit_reclaim && tuple_field_deep_droppable(cfft, s.structs)) {
                var tup_fresh: boolean = false;
                match (slit.field_values[found]) {
                    ast.ExprTuple(_) => { tup_fresh = true; },
                    _ => {}
                }
                if (!tup_fresh) { fav_alias_inc = true; }
            }
            // A `string` field is rc-headered and deep-dropped on the
            // struct's reclamation (emit_struct_field_drops). The values safe
            // to FREE are exactly the fresh, sole-owned HEAP strings whose data
            // buffer is exclusively owned — expr_is_fresh_str: a direct inline
            // concat `a + b`, the case/shape transforms `.to_upper()` /
            // `.to_lower()` / `.reverse()` / `.repeat(n)` (and their str_*
            // free-fn spellings), and the alloc builtins `chr` /
            // `string_from_bytes_unchecked` — each allocating a fresh buffer + rc=1 box
            // used only for this field. Owned by the struct with no inc, so the
            // field-drop reclaims it — the actual heap-leak win.
            // A string LITERAL (Static) is reclaimed the same way, and is the
            // one non-Owned class handed over with no inc: since #2649 Option A
            // const_str builds a FRESH rc=1 box per evaluation (__fern_str_box
            // over the interned .rodata bytes), so the struct sole-owns it, and
            // __fern_str_free's heap-range guard on the DATA pointer frees only
            // that box, never the static bytes. Retaining it pinned the box at
            // rc=2 for the program's life — 24 leaked bytes per bind, on a plain
            // single bind, not just a loop rebind (#6127).
            // EVERY other value is inc'd so the field-drop only decs the dup:
            //   - a string local / param / field read may alias a live string
            //     the IR path never sweeps;
            //   - `.replace()` / `.to_string()` have receiver-identity fast-paths,
            //     so each may alias a live box — retained conservatively.
            // Each non-fresh case leaks (sound), never over-releases.
            // #4297 A2: retain (rc_inc) a NON-fresh string field of a
            // reclaimable struct so the k_str field-drop's rc-aware dec is
            // balanced; an Owned (fresh producer) or Static (literal) field is
            // handed over with no inc and reclaimed by the drop. Ownership comes
            // from the per-lit precompute (slit_own[found]) — a scalar read, so
            // it does NOT re-taint lower_expr. (Owned=0; Static=3; Borrowed=1 /
            // View=2 → retain: a real aliased box's dec is balanced, an immortal
            // view's inc is an rc-sentinel no-op.)
            // Soundness rests on the SAME whole-program read scan that already
            // gates the k_str dec: slit_reclaim is only true for a
            // STRFLDOK-admitted type, i.e. one whose string-field reads are all
            // provable transient borrows. A literal therefore joins the Owned
            // class the drop has always freed, rather than opening a new one.
            if (!fav_alias_inc && cfft == "string" && slit_reclaim
                    && found < slit_own.len() && slit_own[found] != 0
                    && slit_own[found] != 3) {
                fav_alias_inc = true;
            }
            // The counted-share read `P { f: q.f }`. Already retained by the
            // ownership test above (a field read is Borrowed, never Owned or
            // Static), but asked HERE through the same predicate the marker
            // flips use, so the retained set and the flipped set stay identical
            // by construction rather than by two conditions agreeing (#7253).
            if (!fav_alias_inc
                    && str_field_share_read(slit.field_values[found], cfft, slit.type_name, s).len() > 0) {
                fav_alias_inc = true;
            }
            // COMPACT: load the copied result box UNDER the value so struct_set
            // (pops [box, value]) can write this overridden field in place. The
            // struct_copy above already seeded every field from the base; only
            // the overrides are re-stored. struct_copy_eligible excludes i64/f64
            // fields, so an override is always a 4-byte / pointer store.
            if (compact) {
                sm = sm.emit(ir.op_load_local(result_slot));
            }
            // An i64 field value is an 8-byte i64 (a bare integer literal
            // isn't self-evidently i64), so lower it via lower_i64.
            if (struct_field_is_i64(s.structs, slit.type_name, di)) {
                sm = lower_i64(slit.field_values[found], sm);
            } else if (fn_value_array_lit(slit.field_values[found], cfft, sm)) {
                // A plain-fn-pointer array field value (`hs: [inc, dbl]`,
                // or `[() => 7]` after the lift hoists it to `[__lam_0]`).
                // The generic lower_expr would const-CALL each 0-arg fn
                // ident (storing f()'s result), so `r.hs[i]()` would then
                // call that integer as code and segfault. Emit a fn POINTER
                // per element (op_const_func) + op_arr_make — the array
                // sibling of the local `var fns: (() => T)[] = [f, g]` path,
                // leaving exactly ONE array pointer on the stack (identical
                // shape to lower_expr of a normal array). No alias-inc: a
                // fresh literal is struct-owned at rc=1 (#5235).
                match (slit.field_values[found]) {
                    ast.ExprArray(fva) => {
                        var fvi: i32 = 0;
                        while (fvi < fva.elements.len()) {
                            sm = sm.emit(ir.op_const_func(0, fn_value_arg_name(fva.elements[fvi], sm)));
                            fvi = fvi + 1;
                        }
                        sm = sm.emit(ir.op_arr_make(fva.elements.len(), 32));
                    },
                    _ => {}
                }
            } else {
                sm = lower_expr(slit.field_values[found], sm);
            }
            if (!sm.ok) { return sm; }
            // Perceus dup: the field value (an array pointer) is now on the
            // operand stack and about to be stored into the struct box. When
            // it ALIASES an rc-tracked local, retain it (rc_inc) so the
            // struct owns a counted reference. The inc reads the pointer off
            // the stack and pushes it back (the helper returns its arg), so
            // the net stack effect is unchanged for struct_make — the same
            // alias-inc idiom as emit_arr_store, without the cow/store wrap.
            // #6726: unless the analysis says this construction MOVES the
            // local. Then the box takes over the local's reference — the
            // retain and the sweep dec that cancels it are both redundant,
            // and both are dropped (note_moved_elided pairs them).
            var fav_moved: i32 = 0 - 1;
            if (fav_alias_inc) {
                match (slit.field_values[found]) {
                    ast.ExprIdent(mvid) => {
                        if (sm.moves_local_at(mvid.name, mvid.line, mvid.col)) { fav_moved = sm.slot_of(mvid.name); }
                    },
                    _ => {}
                }
            }
            if (fav_alias_inc && fav_moved < 0) {
                sm = sm.emit(ir.op_call_direct("__fern_rc_inc", 1));
            } else if (fav_moved >= 0) {
                sm = sm.note_moved_elided(fav_moved);
            }
            // COMPACT: [box, value] on the stack -> store the override in place.
            if (compact) {
                sm = sm.emit(ir.op_struct_set(di, struct_field_width(s.structs, slit.type_name, di)));
            }
        } else if (slit.has_base && !compact) {
            // copy decl field di from the base: base then struct_get(di).
            // An ident base re-reads its slot; a non-ident base loads the
            // scratch local it was spilled into. An i64 field copies 8
            // bytes (struct_get_i64).
            if (base_is_ident) {
                sm = lower_expr(slit.base, sm);
                if (!sm.ok) { return sm; }
            } else {
                sm = sm.emit(ir.op_load_local(base_tmp));
            }
            if (struct_field_is_i64(s.structs, slit.type_name, di)) { sm = sm.emit(ir.op_struct_get_i64(di)); }
            else { sm = sm.emit(ir.op_struct_get(di, struct_field_width(s.structs, slit.type_name, di))); }
            // A nested-struct field COPIED from the base (`Outer { ...base, … }`)
            // ALIASES base.<field> — both the new struct and the base now point
            // at the same inner box, and BOTH shallow-drop it on reclamation. So
            // retain it (the inner box read by struct_get is on the stack) with
            // the same Perceus dup as the field-override alias case, or the new
            // struct's drop would double-free base's inner. Array fields copied
            // from a base alias-inc via the array gates above (override path); a
            // base-copied ARRAY field is left as-is here (its prior behaviour),
            // only the newly-reclaimed nested-struct kind needs the retain.
            var cpft: string = decl_field_type_at(s.structs, slit.type_name, di);
            if (decl_is_struct(s.structs, cpft)) {
                sm = sm.retain_tos("base-copy-struct-field");
            }
            // A DIRECT enum field COPIED from the base (`R { ...base, other: v }`,
            // enum field un-overridden) ALIASES base.<enum> — both boxes point at
            // the same enum box, and BOTH shallow-drop it. Retain it (#4297 A2) so
            // the new struct's k_enum drop only decs the dup, exactly like the
            // nested-struct copy above. No slit_reclaim gate: a struct with a direct
            // enum field is always reclaimable (struct_has_reclaim_array_field), so
            // the __struct_drop and this inc always pair.
            if (decl_is_enum(s.structs, cpft)) {
                sm = sm.retain_tos("base-copy-enum-field");
            }
            // A `string` field COPIED from the base (`R { ...base, other: v }`,
            // `name` un-overridden) ALIASES base.name — both boxes now point at
            // the same rc string, and the new struct's k_str field-drop would
            // free it out from under the base. Retain it (#4297 A2) so the drop
            // only decs the dup, exactly like the nested-struct copy above. Gated
            // on slit_reclaim: an unreclaimable (string-only) struct emits no
            // __struct_drop, so incing would only inflate the shared rc and leak —
            // leave it as-is there (no drop, no over-release either way).
            if (cpft == "string" && slit_reclaim) {
                sm = sm.retain_tos("base-copy-str-field");
            }
        } else if (!slit.has_base) {
            // a non-update literal must set every field
            return s.fail();
        }
        // else (compact + un-overridden field): op_struct_copy already seeded
        // it from the base — nothing to emit.
        di = di + 1;
    }
    // COMPACT: the result box is the struct_copy'd temp, mutated in place by the
    // per-override struct_sets — push it. Otherwise build the box from the N
    // field values now on the operand stack.
    if (compact) {
        return sm.emit(ir.op_load_local(result_slot));
    }
    return sm.emit(ir.op_struct_make(slit.type_name, ndecl, decl_index_of(sm.structs, slit.type_name)));
}

function lower_expr_dispatch(e: ast.Expr, s: LowerState): LowerState {
    if (!s.ok) { return s; }
    match (e) {
        ast.ExprNumber(n) => {
            // A float literal pushes its IEEE bit pattern (the backend assembles
            // the source text via `.double` / `f64.const`); an integer literal is
            // a 32-bit const.
            if (n.is_float) { return s.emit(ir.op_const_f64_text(n.text)); }
            // Splice the literal TEXT (handles hex `0x..` and the full u32 range,
            // like the AST path); a Fern-side decimal parse zeroes a hex literal
            // and can't represent values >= 0x80000000 as a signed i32.
            return s.emit(ir.op_const_i32_text(n.text));
        },
        ast.ExprBool(b) => {
            var v: i32 = 0;
            if (b.value) { v = 1; }
            return s.emit(ir.op_const_i32(v));
        },
        ast.ExprString(sv) => {
            // String literal → const_str (the backend interns the bytes and
            // builds its string box). Not reference-counted.
            return s.emit(ir.op_const_str(sv.value));
        },
        ast.ExprStructLit(slit) => { return lower_expr_struct_lit(slit, s); },
        ast.ExprFieldAccess(fa) => { return lower_expr_field_access(fa, s); },
        ast.ExprIdent(id) => { return lower_expr_ident(id, s); },
        ast.ExprBinary(b) => { return lower_expr_binary(b, e, s); },
        ast.ExprUnary(u) => { return lower_expr_unary(u, s); },
        ast.ExprArray(arr) => { return lower_expr_array(arr, s); },
        ast.ExprTuple(tup) => { return lower_expr_tuple(tup, s); },
        ast.ExprIndex(ix) => { return lower_expr_index(ix, s); },
        ast.ExprSlice(slc) => { return lower_expr_slice(slc, s); },
        ast.ExprCall(c) => { return lower_expr_call(c, e, s); },
        ast.ExprLambda(lam) => { return lower_expr_lambda(lam, s); },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_try lowers the try-operator `inner?` (parser desugar: unary "try_").
// `inner` evaluates to an Option[T] / Result[T, E] box; `?` unwraps the success
// payload (Some/Ok) as the expression's value, or early-returns the failure box
// from the enclosing (Option/Result-returning) function. The failure path is:
// Option -> return a fresh None (payloadless tag box); Result -> forward the
// source Err box unchanged (its tag=Err + E payload already satisfy the
// enclosing return, checker-verified), or `Err(E2.from(e))` when the error type
// converts. Before that early return it runs the SAME exit RC dec-sweep as a
// normal StmtReturn (emit_dec_sweep_except below) so owned locals live at the
// `?` are released, not leaked — mirroring native's ir.go `*ast.TryOp` cleanup.
// It also replays the parse-level defer pass's cleanup markers at that edge
// (#4334, see try_cleanup below), so defer / errdefer fire on `?` exactly as
// they do on an explicit return. Out of line so the ExprUnary arm stays small
// (#2720 guard).
function lower_try(inner: ast.Expr, s: LowerState): LowerState {
    var ot: string = try_opt_type(inner, s);
    if (ot.len() < 8) { return s.fail(); }
    var is_result: boolean = slice_unchecked(ot, 0, 7) == "Result[";
    var is_option: boolean = slice_unchecked(ot, 0, 7) == "Option[";
    if (!is_result && !is_option) { return s.fail(); }
    // Success payload type. Every payload shape now lowers; what varies is HOW
    // the value is read out of the box, and what types the `var x = inner?`
    // binding's slot so a later `x.field` / `x.len()` / `x.N` / `match (x)`
    // resolves. This whitelist is a SOUNDNESS gate, not a capability list —
    // admitting a payload type whose binding side cannot type the slot does not
    // bail, it MISCOMPILES. Add both halves or neither.
    //
    //   i32 / boolean          4-byte read; the slot's default width-32 typing.
    //   i64 / u64              8-byte op_opt_payload_w(64, true). The
    //                          `var x: i64 = inner?` binding routes through
    //                          lower_i64, which dispatches back here, so the
    //                          value is left a true 8-byte i64 on the stack.
    //   f64                    the same 8-byte read with is_i64=false: wasm keys
    //                          i64.load vs f64.load off that flag (a typed-stack
    //                          load) and the value must land as an f64 to match
    //                          the f64-typed slot. x86/arm64 ignore it (a raw
    //                          movq), so the tweak is wasm-only and harmless.
    //   string                 pointer-width read; the slot is is_str.
    //   struct (leaf-safe)     pointer-width read; struct_ty from the annotation.
    //   enum                   pointer-width read; is_enum_like_name → struct_ty.
    //   tuple                  pointer-width read; mark_tuple_elems from the
    //                          annotation (StmtVar's ExprUnary arm).
    //   Option[…] / Result[…]  pointer-width read; mark_opt_type from the
    //                          annotation, or — unannotated — from try_opt_type
    //                          in that same ExprUnary arm. Needs its own gate
    //                          because is_enum_like_name declines any type
    //                          containing `[`, so the enum row does not reach a
    //                          bracketed generic.
    //
    // Every pointer-width row is the identical default op_opt_payload read: the
    // match-arm Some/Ok binding already reads these payloads the same way. Only
    // the payload's OUTER shape matters — the value read is the inner box
    // POINTER whatever its own payload width, so `Option[i64]` needs no width
    // tweak. (#3802 struct, #3810 string + enum, #3824 tuple, #3457-endgame
    // Option/Result.)
    var pt: string = opt_payload_type(ot, "Ok");
    var pt_is_i64: boolean = pt == "i64" || pt == "u64";
    var pt_is_struct: boolean = decl_is_struct(s.structs, pt) && decl_is_leaksafe(s.structs, pt);
    var pt_is_enum: boolean = is_enum_like_name(pt, s.structs);
    var pt_is_tuple: boolean = pt.len() > 1 && pt[0] == b'(' && tuple_elems_lowerable(pt, s.structs);
    var pt_is_optgen: boolean = pt.len() >= 8 && (slice_unchecked(pt, 0, 7) == "Option[" || slice_unchecked(pt, 0, 7) == "Result[");
    if (pt != "i32" && pt != "boolean" && !pt_is_i64 && !pt_is_struct && pt != "string" && !pt_is_enum && pt != "f64" && !pt_is_tuple && !pt_is_optgen) { return s.fail(); }
    // Evaluate inner into a fresh temp slot (the box pointer).
    var tmp: string = "$try" + util.i32_to_string(s.locals.len());
    var ts: LowerState = s.add_local(tmp);
    var tslot: i32 = ts.slot_of(tmp);
    ts = lower_expr(inner, ts);
    if (!ts.ok) { return ts; }
    ts = ts.emit(ir.op_store_local(tslot));
    // if (tag == failure) { early-return the failure box }
    ts = ts.emit(ir.op_load_local(tslot));
    ts = ts.emit(ir.op_opt_tag());
    ts = ts.emit(ir.op_const_i32(1));            // failure variant idx = 1 (both Option + Result)
    ts = ts.emit(ir.op_bin("eq", 0, false));
    ts = ts.emit(ir.op_if(0));
    // #4334: the `?` failure path is an early return, so — exactly like a
    // rewritten StmtReturn — it must run the parse-level defer pass's cleanup
    // before leaving. try_cleanup holds that pass's body-tail markers:
    // `if (__dfa_tryall) {…}` (every registered plain defer, LIFO) and
    // `if (__dfa_tryerr) {…}` (the errdefers). The `?` failure edge IS the
    // error path, so BOTH replay here, all-defers first — the same order the
    // pass emits on an explicit `return Err(…)` and native emits at TryOp
    // (emitDeferCleanup then emitErrDeferCleanup). Each replayed statement is
    // itself `__dfa<i>`-guarded, so only defers whose registration point
    // actually executed fire. Runs BEFORE the failure box is built and the
    // dec-sweep below, matching both native's ordering and the pass's
    // value-capture-before-cleanup contract (the source box is already safe
    // in the $try temp). Empty when the function has no defers.
    var tcm: i32 = 0;
    while (tcm < ts.try_cleanup.len()) {
        match (ts.try_cleanup[tcm]) {
            ast.StmtIf(tcmf) => {
                var tcs: i32 = 0;
                while (tcs < tcmf.then_body.len()) {
                    ts = lower_stmt(tcmf.then_body[tcs], ts);
                    if (!ts.ok) { return ts; }
                    tcs = tcs + 1;
                }
            },
            _ => {}
        }
        tcm = tcm + 1;
    }
    // #4355: is the source box a FRESH producer's (every callee return a direct
    // Ok/Err/Some/None ctor — the opt-fresh registry)? Then the $try
    // box is sole-owned and dead once consumed, so both consume edges free it:
    // the success path after the payload read (below), and the Option failure
    // path here (its box is a real rc-headered op_opt_none allocation on this
    // path — NOT a static sentinel — and a fresh None replaces it). The Result
    // failure path FORWARDS the box to the caller, so it is never freed there.
    var try_box_fresh: boolean = false;
    match (inner) {
        ast.ExprCall(tfc) => {
            match (tfc.callee) {
                ast.ExprIdent(tfid) => {
                    // A LOCAL slot by the callee's name shadows the top-level
                    // producer (a function-typed local / closure whose return
                    // ownership is unknown) — the registry verdict doesn't
                    // apply, so the free is skipped (sound leak).
                    if (ts.slot_of(tfid.name) < 0
                        && sig_reg_has_name(ts.sigs.opt_fresh_ret_fns, tfid.name)) { try_box_fresh = true; }
                },
                _ => {}
            }
        },
        _ => {}
    }
    if (is_result) {
        // From-converting `?` (#2697): when the source error type E1 differs
        // from the enclosing function's return error type E2, the failure path
        // can't forward the source Err box unchanged — it carries an E1 payload
        // where the caller expects E2. Emit `Err(E2.from(e))` instead: load the
        // source Err payload (E1), call the associated `E2.from`, and rebuild an
        // Err box around the converted value. Mirrors the native checker's
        // tryConvertErrViaFrom desugar. Gated to a leaf-safe struct E2 with a
        // `from` (the whole-module IR-eligibility scan bails if `E2.from`
        // is absent) and an i32-/pointer-width E1 payload (op_opt_payload's
        // default read — i32 / boolean / struct / enum / string); an i64 / u64 /
        // f64 / f32 E1, which would need a width-64 read, bails. When
        // E1 == E2 (or the return error type can't be recovered) the box is
        // forwarded unchanged, exactly as before.
        var src_err: string = opt_payload_type(ot, "Err");
        var ret_err: string = opt_payload_type(s.cur_ret, "Err");
        // A `dyn Trait` return error type is NOT a `From` target: a concrete
        // error box (`Err(NotFound{..})`) upcasts to `dyn Error` directly —
        // the concrete struct/enum pointer's layout is already a valid dyn
        // pointer — so the source Err box is forwarded UNCHANGED, exactly as
        // when E1 == E2. Without this guard `src_err != ret_err` ("NotFound"
        // != "dyn Error") wrongly entered the From branch and bailed the whole
        // module to AST at the struct gate below (dyn Error isn't a struct),
        // regressing the `Result[_, dyn Error]` propagation pattern off IR.
        var ret_err_is_dyn: boolean = ret_err.len() > 4 && slice_unchecked(ret_err, 0, 4) == "dyn ";
        if (ret_err != "" && src_err != ret_err && !ret_err_is_dyn) {
            if (!decl_is_struct(s.structs, ret_err) || !decl_is_leaksafe(s.structs, ret_err)) { return s.fail(); }
            if (src_err == "i64" || src_err == "u64" || src_err == "f64" || src_err == "f32") { return s.fail(); }
            ts = ts.emit(ir.op_load_local(tslot));
            ts = ts.emit(ir.op_opt_payload());                       // E1 value (scalar or pointer)
            ts = ts.emit(ir.op_call_direct(ret_err + ".from", 1));   // E2.from(e) -> E2
            ts = ts.emit(ir.op_opt_make(1));                         // Err(E2)
        } else {
            ts = ts.emit(ir.op_load_local(tslot));   // forward the source Err box
        }
    } else {
        // #4355: the fresh source None box is dead — free it before building
        // the propagated None (rc_dec is the established option-box free; its
        // guards no-op on anything non-heap).
        if (try_box_fresh) {
            ts = ts.release(tslot, "__fern_rc_dec", "try-fresh-none");
        }
        ts = ts.emit(ir.op_opt_none());          // fresh None
    }
    // Release owned locals live at this early exit. The `?` failure path is an
    // early return and must run the SAME exit dec-sweep as StmtReturn, otherwise
    // every owned array / struct / string / tuple / map local live at the `?`
    // leaks — this was the only uncleaned return on the IR path (the stale
    // comment above predated the RC arc). The failure box built just above sits
    // on the operand stack; the sweep is net-zero on the stack (a load / dec /
    // drop triple per swept slot), so the box stays on top for op_return. The
    // `$try` temp holds the Option/Result box (forwarded unchanged on the Result
    // path) but is not a swept slot type, so keep=-1 (sweep everything) never
    // frees the value being returned. Mirrors native's emitRcDecLocalsAtExit at
    // the TryOp failure edge (ir.go ~11486). Deferred / errdefer
    // actions replayed above (try_cleanup) run BEFORE this sweep, mirroring
    // native's cleanup-then-sweep order at the TryOp edge.
    ts = emit_consumed_param_exit(ts, inner, false);
    ts = emit_dec_sweep_except(ts, 0 - 1);
    ts = ts.emit(ir.op_return());
    ts = ts.emit(ir.op_end());
    // Success path: load the payload (offset abstracted by op_opt_payload). An
    // i64/u64 payload uses the 8-byte width-64 read (mirrors the match path's
    // op_opt_payload_w(64, true)).
    ts = ts.emit(ir.op_load_local(tslot));
    if (pt_is_i64) { ts = ts.emit(ir.op_opt_payload_w(64, true)); }
    // An f64 payload is also an 8-byte width-64 read, but the wasm backend keys
    // i64.load vs f64.load off the is_i64 flag (a typed-stack load), so pass
    // false: the success value must land on the stack as an f64 to match the
    // `var x: f64` slot. x86/arm64 asm_ir ignore the flag (a raw 8-byte movq),
    // so this is wasm-only and harmless there.
    else if (pt == "f64") { ts = ts.emit(ir.op_opt_payload_w(64, false)); }
    else { ts = ts.emit(ir.op_opt_payload()); }
    // #4355: free the consumed fresh source box — the payload (a scalar copy,
    // or a pointer whose sole reference just MOVED to the extracted value)
    // sits on the operand stack; the load/dec/drop triple beneath is net-zero,
    // so it stays on top for the consumer. rc_dec frees the rc==1 op_opt_make
    // box exactly like the consumed-by-match option free
    // (emit_opt_payload_drop's box dec). A string payload's new owner is the
    // `var s: string = ...?` binding, credited "STR:" by reclaimable_names_of
    // (collect_try_str_binding_names) when the producer's payloads are fresh.
    if (try_box_fresh) {
        ts = ts.release(tslot, "__fern_rc_dec", "try-fresh-box");
    }
    return ts;
}

// resource_method_opt_ret_type returns the Option type of a built-in Reader /
// Writer resource method — read_line / read_chunk / write / close — or "" when
// the receiver is not one. The five methods lower to ops that push a fresh
// Option box (op_read_line / op_read_chunk / op_writer_write / op_reader_close),
// so no module signature carries their return type and every scrutinee-type
// resolver would otherwise bail the module.
//
// The receiver gate is lower_call_method's, so the type reported here cannot
// drift from the call that is actually emitted: a user `.close()` on a declared
// struct, an enum, a string or an array is somebody else's method. The types
// come from opt_ret_type, keyed as native keys its Methods table, so the two
// halves of the signature live in one place.
function resource_method_opt_ret_type(field: string, obj: ast.Expr, s: LowerState): string {
    if (decl_is_struct(s.structs, expr_struct_type(obj, s)) || expr_enum_type(obj, s) != ""
        || expr_is_str(obj, s) || expr_is_arr_src(obj, s)) { return ""; }
    if (field == "read_line" || field == "read_chunk" || field == "close") {
        return s.opt_ret_type("Reader." + field);
    }
    if (field == "write") { return s.opt_ret_type("Writer.write"); }
    return "";
}

// builtin_arr_opt_ret_type returns the Option type of a built-in array method
// whose result is an Option — `xs.min()` / `xs.max()` / `xs.index_of(x)` on an
// i32 array, which lower to the Option-returning Fern helpers
// __fern_arr_i32_min_opt / _max_opt (#3457) / _index_of_opt (#4387). Those helpers are RUNTIME functions, not module functions,
// so opt_ret_fns_of never sees their signature and every scrutinee-type resolver
// (`match (xs.min())`, `xs.min()?`, `var o = xs.min()`) would fail to recover
// Option[i32] and bail the module. This is the composite-
// return analogue of is_fern_helper: the registry for a helper's shape that the
// module-derived side-tables cannot supply. It shares the lowering's receiver
// predicate (arr_i32_recv) so the type reported here cannot drift from the call
// that is actually emitted.
function builtin_arr_opt_ret_type(field: string, obj: ast.Expr, s: LowerState): string {
    if ((field == "min" || field == "max" || field == "index_of") && arr_i32_recv(obj, s)) {
        return "Option[i32]";
    }
    return arr_method_opt_ret_type(field, obj, s);
}

// arr_method_opt_ret_type recovers the Option/Result type of a USER array-method
// call (`xs.gcd_all()` → std/array's `__method_Array_gcd_all(arr): Option[i32]`).
// The call lowers through the find_arr_method dispatch, but the scrutinee-type
// resolvers only knew the BUILTIN array methods above, so an INLINE
// `match (xs.gcd_all())` had no payload type and bailed the module — while
// binding it first (`var o: Option[i32] = xs.gcd_all(); match (o)`) lowered,
// the by-now-familiar tell that the gap is a missing result-type recovery
// rather than missing lowering.
//
// Keyed off the resolved helper NAME so it works for any array method the module
// actually has, and array-receiver-gated so a same-named struct method keeps its
// own registry entry.
function arr_method_opt_ret_type(field: string, obj: ast.Expr, s: LowerState): string {
    if (!(expr_is_arr_src(obj, s) || expr_is_strarr(obj, s) || expr_is_f64arr(obj, s) || expr_is_i64arr(obj, s))) { return ""; }
    var amn: string = s.find_arr_method(field);
    if (amn.len() == 0) { return ""; }
    return s.opt_ret_type(amn);
}

// try_opt_type recovers the Option/Result type spelling of a try-operator's
// inner expression, mirroring the match-scrutinee resolution: a direct-call
// `f()` via opt_ret_fns, a direct `Some(x)` construction via some_opt_type, a
// map `.get()` (Option[V]), a local/param via its tracked Option/Result type, or
// an Option/Result struct field. "" when it can't (lower_try then bails).
function try_opt_type(inner: ast.Expr, s: LowerState): string {
    // typed-IR (#5531): an Option/Result-returning call carries its full
    // "Option[T]" / "Result[T, E]" tag on c.ty (the checker resolved any generic
    // args). Read it instead of re-deriving via opt_ret_type + argref/closure
    // resolution. Guarded to a well-formed Option[…] / Result[…] tag; anything
    // else (an unresolved "" tag, or a non-call scrutinee) falls through to the
    // structural walk below.
    match (inner) {
        ast.ExprCall(oc0) => {
            if (oc0.ty.len() >= 7 && (slice_unchecked(oc0.ty, 0, 7) == "Option[" || slice_unchecked(oc0.ty, 0, 7) == "Result[")) { return oc0.ty; }
        },
        // `(a +? b)?` — a checked arithmetic operand (#5542) is Option[T].
        ast.ExprBinary(ob) => {
            if (is_chk_op(ob.op)) { return chk_opt_type_tag(ob, s); }
        },
        // `s[a:b]?` / `match (s[a:b])` — the checked string slice (#5634) is
        // Option[str], which the self-host spells "string" after the parse-time
        // str erasure. An ARRAY slice is not an Option and falls through.
        ast.ExprSlice(osl) => {
            if (expr_is_str(osl.array, s)) { return "Option[string]"; }
        },
        _ => {}
    }
    match (inner) {
        ast.ExprCall(scl) => {
            match (scl.callee) {
                ast.ExprIdent(scid) => {
                    var rt: string = resolve_argref_opt_type(s.opt_ret_type(scid.name), scl.args, s);
                    // A direct `Some(x)` construction scrutinee — recover its
                    // Option[T] type (mirrors the main StmtMatch path's
                    // some_opt_type fallback), so `match (Some(6)) { … }` in value
                    // position lowers instead of bailing.
                    if (rt == "") { rt = some_opt_type(inner, s); }
                    // A DIRECT closure-call scrutinee (`match (f(x))` where f is a
                    // closure/fn param returning Option/Result): opt_ret_type is
                    // keyed by function name and misses the param, so recover the
                    // type from its recorded signature return (closure_opt_rets).
                    if (rt == "") { rt = s.closure_opt_ret(s.slot_of(scid.name)); }
                    return rt;
                },
                ast.ExprFieldAccess(scfa) => {
                    // A built-in array method returning Option (`xs.min()?`) —
                    // helper-backed, so its type comes from the registry rather
                    // than the module's own funcs.
                    var bmt: string = builtin_arr_opt_ret_type(scfa.field, scfa.obj, s);
                    if (bmt != "") { return bmt; }
                    // A built-in Reader/Writer resource method (read_line /
                    // read_chunk / write / close) — gated like lower_expr's
                    // interception, so the scrutinee type agrees with the op that
                    // actually lowers.
                    var rmt: string = resource_method_opt_ret_type(scfa.field, scfa.obj, s);
                    if (rmt != "") { return rmt; }
                    if (scfa.field == "get") {
                        // `m.get(k)` on a map local OR a Map-typed struct field
                        // (`r.caps.get(k)`) — expr_map_type_tag covers both.
                        var gvt: string = map_value_of(expr_map_type_tag(scfa.obj, s));
                        if (gvt != "") { return "Option[" + gvt + "]"; }
                    }
                    // Associated call `Type.method()?` returning Option/Result —
                    // the object is a bare TYPE name (not a slot), so key by
                    // "<Type>.<method>" (mirrors opt_recv_base_type's associated
                    // arm). Lets `User.from_json(s)?` propagate its Result error.
                    match (scfa.obj) {
                        ast.ExprIdent(tid) => {
                            if (s.slot_of(tid.name) < 0) {
                                var art: string = s.opt_ret_type(tid.name + "." + scfa.field);
                                if (art != "") { return art; }
                            }
                        },
                        _ => {}
                    }
                    // `x.method()` where x's method returns Option/Result —
                    // key by "<Type>.<method>".
                    var mrty: string = expr_struct_type(scfa.obj, s);
                    if (mrty != "") { return s.opt_ret_type(mrty + "." + scfa.field); }
                    // An Option/Result-RECEIVER method (`r.map()`) — key
                    // "Option.<m>" / "Result.<m>" (#3049).
                    var mrb: string = opt_recv_base_type(scfa.obj, s);
                    if (mrb != "") { return s.opt_ret_type(mrb + "." + scfa.field); }
                    // An enum-receiver method returning Option/Result on a fresh
                    // variant (`V(7).get()`) — key "<Enum>.<m>" (#3076).
                    var men: string = expr_enum_type(scfa.obj, s);
                    if (men != "") { return s.opt_ret_type(men + "." + scfa.field); }
                    // A NUMERIC-primitive / string receiver method returning
                    // Option/Result (`(3 as i64).checked_add(4)?`) — key
                    // "<prim>.<method>". Mirrors lower_stmt_match's inline resolver.
                    var mprim: string = expr_recv_prim_type(scfa.obj, s);
                    if (mprim != "") { return s.opt_ret_type(mprim + "." + scfa.field); }
                    return "";
                },
                // An if-/match-EXPRESSION scrutinee (`match (if (c) { Some(7) }
                // else { None }) { … }`) — a 0-arg IIFE. Recover the Option type
                // from the leaf branch's Some(...) via iife_leaf_value (unwrapping
                // any nesting), so the value-position match lowers.
                ast.ExprLambda(_) => { return some_opt_type(iife_leaf_value(inner), s); },
                _ => { return ""; }
            }
        },
        ast.ExprIdent(sid) => { return s.opt_type_of_slot(s.slot_of(sid.name)); },
        // A cast: the `as? T` downcast (docs/DYN-TRAITS.md §9) or a plain
        // `as Option[T]` / `as Result[T, E]` ascription.
        ast.ExprUnary(sun) => { return unary_opt_type(sun.op); },
        ast.ExprFieldAccess(sfa) => {
            // `t.N` where the tuple element is an Option/Result — recover from the
            // element's tracked tag (a numeric field; mirrors the main StmtMatch
            // path so `match (t.0) { … }` in value position lowers).
            if (util.is_all_digits(sfa.field)) {
                var ttg: string = expr_tuple_elem_tag(sfa.obj, util.digits_to_i32(sfa.field), s);
                if (ttg.len() >= 8 && (slice_unchecked(ttg, 0, 7) == "Option[" || slice_unchecked(ttg, 0, 7) == "Result[")) { return ttg; }
                return "";
            }
            var foty: string = expr_struct_type(sfa.obj, s);
            if (foty != "") {
                var fft: string = decl_field_type(s.structs, foty, sfa.field);
                if (fft.len() >= 8 && (slice_unchecked(fft, 0, 7) == "Option[" || slice_unchecked(fft, 0, 7) == "Result[")) { return fft; }
            }
            return "";
        },
        // `<base>[i]` where the element is an Option/Result — a local
        // (`a[i]`), a struct field (`b.o[i]`), a tuple element (`t.N[i]`), or a
        // nested index (`aoa[i][j]`). Mirrors the main StmtMatch path so the same
        // shapes lower in value position.
        ast.ExprIndex(six) => { return opt_elem_of(arr_tag_of(six.array, s)); },
        _ => { return ""; }
    }
    return "";
}

// lower_iife lowers the 0-arg IIFE the if-expression desugar (parse_if_chain)
// emits — `(function(): i32 { if (c) { return E1; } else { return E2; } })()`
// — INLINE, with no closure box or function call: a value-producing void `if`
// whose branches store their result into a fresh temp local, then a load of
// that temp leaves the if-expression's value on the rt-stack (the same
// temp-local-through-a-void-block shape the `&&`/`||` short-circuit uses). The
// lambda's inner `return E` becomes `store tmp = E`. Restricted to exactly
// what the desugar produces for an i32 if-expression: 0 params, 0 args, a body
// that is a single StmtIf with an else, and i32-valued branches. Any other
// shape — a match-expression IIFE (StmtMatch body), an f64 / string / i64
// result, or a multi-statement body that isn't a value tail — bails to the AST
// emitter, exactly as before (#2938).
// iife_first_return_expr returns the value expression of the FIRST `return`
// reachable in an if-expression / match-expression IIFE body — the then-branch
// tail of a StmtIf (recursing nested else-ifs) or the first arm's tail of a
// StmtMatch. All branches share the if/match result type, so the first return
// classifies the whole expression's value (string vs i32). Returns ExprUnknown
// for any other shape.
pub function iife_first_return_expr(st: ast.Stmt): ast.Expr {
    match (st) {
        ast.StmtReturn(r) => { return r.value; },
        ast.StmtIf(iff) => {
            if (iff.then_body.len() > 0) { return iife_first_return_expr(iff.then_body[iff.then_body.len() - 1]); }
            return parser.e_unknown("");
        },
        ast.StmtMatch(mm) => {
            if (mm.arms.len() > 0 && mm.arms[0].body.len() > 0) { return iife_first_return_expr(mm.arms[0].body[mm.arms[0].body.len() - 1]); }
            return parser.e_unknown("");
        },
        _ => { return parser.e_unknown(""); }
    }
    return parser.e_unknown("");
}

// iife_leaf_value unwraps a (possibly nested) if-/match-expression IIFE
// (`ExprCall{callee: ExprLambda}`) to the innermost first-branch returned value
// — e.g. a NESTED if-expression `if (a) { if (b) { P{..} } else { .. } } else
// { .. }` resolves to the `P{..}` literal. Returns `e` unchanged when it isn't an
// IIFE. Lets the StmtVar value-type inference (opt / struct / array) see through a
// nested IIFE binding to the leaf struct/Some/array literal. Bounded to avoid a
// pathological loop.
function iife_leaf_value(e: ast.Expr): ast.Expr {
    var cur: ast.Expr = e;
    var guard: i32 = 0;
    while (guard < 64) {
        var stop: boolean = true;
        match (cur) {
            ast.ExprCall(c) => {
                match (c.callee) {
                    ast.ExprLambda(lam) => {
                        if (lam.body.len() > 0) { cur = iife_first_return_expr(lam.body[0]); stop = false; }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        if (stop) { return cur; }
        guard = guard + 1;
    }
    return cur;
}

// iife_any_nonarray_return reports whether ANY `return` reachable in an
// if-/match-expression IIFE body yields a value that is NOT a fresh array
// LITERAL (`[..]`). Used to admit a struct array FIELD set from an if-/match-
// expression (`B { xs: if (c) { [1,2,3] } else { [4] } }`) only when EVERY branch
// is a fresh owned array — so the field leaks with the struct, never aliasing a
// swept local (the safety invariant the direct-`ExprArray` field check enforces).
function iife_any_nonarray_return(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprArray(_) => { return false; },
                _ => { return true; }
            }
        },
        ast.StmtIf(iff) => {
            var k: i32 = 0;
            while (k < iff.then_body.len()) { if (iife_any_nonarray_return(iff.then_body[k])) { return true; } k = k + 1; }
            var j: i32 = 0;
            while (j < iff.else_body.len()) { if (iife_any_nonarray_return(iff.else_body[j])) { return true; } j = j + 1; }
            return false;
        },
        ast.StmtMatch(mm) => {
            var a: i32 = 0;
            while (a < mm.arms.len()) {
                var b: i32 = 0;
                while (b < mm.arms[a].body.len()) { if (iife_any_nonarray_return(mm.arms[a].body[b])) { return true; } b = b + 1; }
                a = a + 1;
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// iife_returns_fresh_array reports whether `e` is an if-/match-expression IIFE
// whose every branch returns a fresh array literal (so it's a safe owned value
// for a struct array field). False for a non-IIFE expression.
function iife_returns_fresh_array(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprLambda(lam) => {
                    if (lam.body.len() == 0) { return false; }
                    var i: i32 = 0;
                    while (i < lam.body.len()) { if (iife_any_nonarray_return(lam.body[i])) { return false; } i = i + 1; }
                    return true;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// or an i64-sized integer literal. Unlike f64 / string (where the first branch
// classifies the whole expression), an i64 if-expression can mix an i64-sized
// branch with a small-literal branch (`{ 5000000000 } else { 1 }`), so every
// return is checked. A fully-small-literal i64 expression (whose i64-ness comes
// only from the binding annotation) isn't caught here.
//
// Width comes from infer_expr_width alone. It reads a literal's SUFFIX ahead of
// its magnitude, which a second magnitude-only test cannot do: `2147484571u32`
// is past i32-max and still 32 bits wide.
function iife_any_return_i64(st: ast.Stmt, s: LowerState): boolean {
    match (st) {
        ast.StmtReturn(r) => { return infer_expr_width(r.value, s) == 64; },
        ast.StmtIf(iff) => {
            var k: i32 = 0;
            while (k < iff.then_body.len()) { if (iife_any_return_i64(iff.then_body[k], s)) { return true; } k = k + 1; }
            var j: i32 = 0;
            while (j < iff.else_body.len()) { if (iife_any_return_i64(iff.else_body[j], s)) { return true; } j = j + 1; }
            return false;
        },
        ast.StmtMatch(mm) => {
            var a: i32 = 0;
            while (a < mm.arms.len()) {
                var b: i32 = 0;
                while (b < mm.arms[a].body.len()) { if (iife_any_return_i64(mm.arms[a].body[b], s)) { return true; } b = b + 1; }
                a = a + 1;
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function lower_iife(c: ast.ExprCall, lam: ast.ExprLambda, s: LowerState, force_i64: boolean): LowerState {
    if (c.args.len() != 0) { return s.fail(); }
    if (lam.params.len() != 0) { return s.fail(); }
    // A MULTI-statement IIFE body is a value-position BLOCK: general
    // block-expressions (#4521, `{ var k = …; tail }`) and control-flow blocks
    // (#4522, `{ if (early) { return 0; } tail }`). Lower it INLINE — the
    // leading statements run in the current function (so a user
    // return/break/continue escapes to the function/loop, exactly like the
    // native *ast.BlockExpr arm) and only the FINAL statement becomes the
    // block's value. See lower_value_block.
    if (lam.body.len() != 1) { return lower_value_block(lam.body, s, force_i64); }
    return lower_value_stmt(lam.body[0], s, force_i64);
}

// lower_value_stmt lowers the ONE statement that produces a value-position
// body's value. It is reached from two places, and they are the same problem:
// lower_iife with a single-statement body (the if / match-EXPRESSION desugars,
// whose arm returns ARE the value), and lower_value_block's tail after the
// leading statements have run. Keeping them one function is what closed #6268 —
// lower_value_block understood only a `return` tail, so the identical if /
// match it already handled one call up bailed the enclosing function to the AST
// emitter as soon as anything preceded it.
function lower_value_stmt(st: ast.Stmt, s: LowerState, force_i64: boolean): LowerState {
    match (st) {
        ast.StmtIf(iff) => {
            var tmp: string = "$ife" + util.i32_to_string(s.locals.len());
            var ts: LowerState = s.add_local(tmp);
            var tslot: i32 = ts.slot_of(tmp);
            // Type the inline temp from the if-expression's result (the first
            // branch's returned value classifies it, since all branches share a
            // type): an f64 temp (8-byte) for a float result, an i64 temp for an
            // i64-width result (any branch — see iife_any_return_i64; or force_i64
            // when the BINDING context is i64/u64, so a fully-small-literal i64
            // expression `var x: i64 = if (c) { 5 } else { 9 }` lowers instead of
            // bailing), else a string temp (pointer) for a string result, else the
            // default i32 temp. The temp type steers branch-tail value lowering.
            var ifre: ast.Expr = iife_first_return_expr(st);
            if (expr_is_f64(ifre, ts)) { ts = ts.mark_f64(tslot, true); }
            else if (force_i64 || iife_any_return_i64(st, ts)) { ts = ts.mark_i64(tslot, true); }
            else if (expr_is_str(ifre, ts)) { ts = ts.mark_str(tslot, true); }
            var rs: LowerState = lower_value_if(iff, tslot, ts);
            if (!rs.ok) { return rs; }
            return rs.emit(ir.op_load_local(tslot));
        },
        // match-EXPRESSION in value position (parse_match_expr emits the same
        // IIFE shape with a StmtMatch body). Inline it by rewriting each arm's
        // `return E` to `tmp = E` and lowering the resulting statement-match
        // (the full variant dispatch), then loading tmp — see lower_iife_match.
        ast.StmtMatch(mm) => {
            return lower_iife_match(mm, s, force_i64);
        },
        // A single `return E` body is the DIRECT, hand-written IIFE —
        // `(function (): i32 { return 7; })()` — as opposed to the if/match
        // desugars above, which is why it reached the catch-all and bailed the
        // whole module (#3457 slice 5). Its value simply IS
        // E, evaluated here: the lambda is invoked immediately in this scope, so
        // a capture reads the enclosing local. No temp and no branch structure —
        // this is lower_value_block's inline treatment with zero leading
        // statements, hence also no user return / break / continue that could
        // escape.
        //
        // Only reachable when the lift left the lambda inline. In most positions
        // (`var a = (…)()`, an operand, an argument) it hoists to __lam_N and the
        // call never gets here, which is why the gap survived: the failing shapes
        // were exactly `return (…)();` and the RETURN-position operand.
        ast.StmtReturn(dr) => {
            if (force_i64) { return lower_i64(dr.value, s); }
            return lower_expr(dr.value, s);
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_value_block lowers a MULTI-statement value-position block IIFE body —
// `[leading…, s_return(tail)]` — INLINE, the self-host analogue of the native
// *ast.BlockExpr arm (#4521 general value blocks + #4522 control flow inside
// them). The leading statements lower via lower_stmt in the CURRENT function,
// so a user `return`/`break`/`continue` among them emits op_return / op_br and
// escapes to the enclosing function/loop (NOT captured as the block's value);
// the final synthetic `return tail` is rewritten to `tmp = tail` (a store into
// a fresh value temp, exactly as lower_iife_match rewrites its arm tails), and
// the temp is loaded as the block's value. A tail that is not a value-return
// goes to lower_value_stmt, which is the same treatment lower_iife gives a
// single-statement body; only a divergent no-tail block (parse_branch_body
// appends an s_unknown there) still bails.
function lower_value_block(body: ast.Stmt[], s: LowerState, force_i64: boolean): LowerState {
    var n: i32 = body.len();
    if (n == 0) { return s.fail(); }
    var last: ast.Stmt = body[n - 1];
    match (last) {
        ast.StmtReturn(r) => {
            // Fresh value temp, classified from the tail expression's width —
            // f64 (8-byte), i64 (force_i64 when the binding context is i64/u64,
            // else inferred), string (pointer), else the default i32. The slot
            // type steers the rewritten `tmp = tail` store, mirroring lower_iife.
            var tmp: string = "$vbi" + util.i32_to_string(s.locals.len());
            var ts: LowerState = s.add_local(tmp);
            var tslot: i32 = ts.slot_of(tmp);
            if (expr_is_f64(r.value, ts)) { ts = ts.mark_f64(tslot, true); }
            else if (force_i64 || infer_expr_width(r.value, ts) == 64) { ts = ts.mark_i64(tslot, true); }
            else if (expr_is_str(r.value, ts)) { ts = ts.mark_str(tslot, true); }
            // Leading statements run inline — user control flow escapes here.
            var i: i32 = 0;
            while (i < n - 1) {
                ts = lower_stmt(body[i], ts);
                if (!ts.ok) { return ts; }
                i = i + 1;
            }
            // Final `return tail` -> `tmp = tail`, then load the temp.
            var assign: ast.Stmt = ast.StmtAssign { target: tmp, value: r.value, line: 0, col: 0, target_line: 0, target_col: 0 };
            ts = lower_stmt(assign, ts);
            if (!ts.ok) { return ts; }
            return ts.emit(ir.op_load_local(tslot));
        },
        // Any OTHER tail — an if / match-EXPRESSION whose arm returns are
        // themselves the value. Run the leading statements inline exactly as the
        // `return` arm does, then hand the tail to lower_value_stmt, the same
        // code lower_iife uses when that if / match is the body's only
        // statement. There is nothing block-specific about the tail; what makes
        // it arrive here is that something PRECEDES it (#6268), which the lift
        // routinely arranges by prepending a capture rebinding.
        _ => {
            // A 64-bit tail lowers here like any other (#6267). It used to be
            // refused, on the reading that wasm miscompiled it — and wasm did,
            // but the refusal never protected anything: the shape that actually
            // miscompiled never reached this arm, because lower_i64 declined a
            // multi-statement IIFE and the caller fell back to the i32 path with
            // a widening extend. That is fixed at the lower_i64 arm, and this
            // arm is where the corrected width now lands.
            var bs: LowerState = s;
            var bi: i32 = 0;
            while (bi < n - 1) {
                bs = lower_stmt(body[bi], bs);
                if (!bs.ok) { return bs; }
                bi = bi + 1;
            }
            return lower_value_stmt(last, bs, force_i64);
        }
    }
    return s.fail();
}

// lower_iife_match inlines an enum / bool match-EXPRESSION in value position.
// It rewrites every arm's single `return E` into `tmp = E` and lowers the
// rewritten statement-match through the existing variant-dispatch path, then
// loads tmp. Conservatively scoped so the i32 temp is always the right width:
// arms must have NO payload binding (a unit variant, `_`, or `true`/`false`)
// and an i32 result. A payload-binding arm (`Some(n) => n`) or an f64 / string
// / i64 result bails (#2938 follow-up).
// iife_payload_bindable reports whether a payload-binding match arm's payload can
// be bound for the inlined match-expression. The payload type is resolved from the
// scrutinee's tracked opt type (Option/Result Some/Ok/Err) or, for a user-enum
// variant, its single payload field (`__ev`).
//
// An i32 payload is always bindable (the rewritten `tmp = E` is an i32 store). A
// nested OPTION payload (`Some(b)` where b: Option[T]) is bindable when the result
// temp is i32 AND the match scrutinee is a plain local (`scrut_is_ident`): every arm
// then returns i32 (arms share a result type in valid Fern), so the bound Option is
// only consumed to compute an i32 — typically a nested `match (b)` — never stored
// into the i32 temp as the result. The underlying StmtMatch path binds it via
// mark_opt_type, so the inner match recovers b's type. The ident-scrutinee
// restriction is deliberate: a CALL scrutinee returning a nested Option
// (`match (f()) { Some(b) => match (b) … }`) is not admitted. A non-i32
// result temp keeps the strict i32-only rule (a payload returned directly would
// need its type at gate-classify time, before the binding is in scope). A
// string / Result / fn payload is not admitted here either.
// iife_arm_returns_ident reports whether the arm's TAIL `return E` is exactly the
// bare ident `name` (so a payload bound to `name` would be stored DIRECTLY into the
// result temp). Used to reject a leak-safe array payload returned bare (it would
// need an array-typed temp, which the IIFE doesn't classify) while still admitting
// a borrow read of it (`xs[0]` / `xs.len()` produce an i32 result).
function iife_arm_returns_ident(arm: ast.MatchArm, name: string): boolean {
    if (arm.body.len() == 0) { return false; }
    var last: ast.Stmt = arm.body[arm.body.len() - 1];
    match (last) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprIdent(rid) => { return rid.name == name; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// iife_arm_returns_narrowed_payload reports whether the arm's TAIL is
// `return (name as <i32-width>)` — a narrowing cast of the BARE bound i64/f64
// payload to an i32-width integer type (i32/u32/u8), which yields an i32 result.
// The i64/f64 payload slot is marked at width by the StmtMatch path (so the cast
// reads the wide value and narrows, exactly as a statement-position `return (n as
// i32)` does), but the RESULT temp stays i32 — letting an i64/f64-payload match-
// EXPRESSION whose arms narrow the payload ride the i32 temp instead of bailing.
function iife_arm_returns_narrowed_payload(arm: ast.MatchArm, name: string): boolean {
    var t: ast.Expr = iife_arm_tail_expr(arm);
    match (t) {
        ast.ExprUnary(u) => {
            if (u.op == "as_i32" || u.op == "as_u32" || u.op == "as_u8") {
                match (u.operand) {
                    ast.ExprIdent(id) => { return id.name == name; },
                    _ => { return false; }
                }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// iife_arm_returns_narrowed_payload_arith is the ARITHMETIC sibling of
// iife_arm_returns_narrowed_payload: it admits `(arith-over-payload) as i32`
// (`Some(x) => (x + 2) as i32`, `Some(v) => (v * 4.0) as i32`), where the arm
// computes a wide i64/f64 intermediate over the bound payload and then narrows
// the whole thing to an i32-width result. The result temp stays i32 (the cast
// narrows), exactly like the bare-payload narrow case; the wide intermediate is
// lowered by the statement-match arm body (the same iife_payload_arith_kind tree
// the wide-result admit at the call site uses), which already lowers
// `return (n + 2) as i32` / `return (v * 4.0) as i32` correctly on every backend.
// kind = ft so an f64 payload routes the f64 arith leaf/op path (#2691 follows up
// on the earlier i64-only #3585).
function iife_arm_returns_narrowed_payload_arith(arm: ast.MatchArm, name: string, ft: string, s: LowerState): boolean {
    if (ft != "i64" && ft != "f64") { return false; }
    var t: ast.Expr = iife_arm_tail_expr(arm);
    match (t) {
        ast.ExprUnary(u) => {
            if (u.op == "as_i32" || u.op == "as_u32" || u.op == "as_u8") {
                return iife_payload_arith_kind(u.operand, name, ft, ft, s);
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// iife_arm_tail_expr returns the arm's TAIL `return E` value expression, or an
// e_unknown when the arm's last statement is not a return. Used to classify the
// arm's RESULT for the borrow-only payload gate below.
function iife_arm_tail_expr(arm: ast.MatchArm): ast.Expr {
    if (arm.body.len() == 0) { return parser.e_unknown(""); }
    var last: ast.Stmt = arm.body[arm.body.len() - 1];
    match (last) {
        ast.StmtReturn(r) => { return r.value; },
        _ => { return parser.e_unknown(""); }
    }
    return parser.e_unknown("");
}

// iife_expr_mentions_ident reports whether `name` appears anywhere in `e`. Used to
// route a sub-expression that does NOT reference the bound payload through the
// ordinary `s`-based i32 classifier (the binding is irrelevant to it), and one that
// DOES through the payload-aware borrow check.
function iife_expr_mentions_ident(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprBinary(b) => { return iife_expr_mentions_ident(b.left, name) || iife_expr_mentions_ident(b.right, name); },
        ast.ExprUnary(u) => { return iife_expr_mentions_ident(u.operand, name); },
        ast.ExprFieldAccess(fa) => { return iife_expr_mentions_ident(fa.obj, name); },
        ast.ExprIndex(ix) => { return iife_expr_mentions_ident(ix.array, name) || iife_expr_mentions_ident(ix.index, name); },
        ast.ExprCall(c) => {
            if (iife_expr_mentions_ident(c.callee, name)) { return true; }
            for arg in c.args { if (iife_expr_mentions_ident(arg, name)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// iife_method_ret_i32 reports whether method `method` on a receiver of type `recv`
// (a struct / enum) provably returns an i32 (or boolean — both ride the i32 temp).
// Sound by EXCLUSION: a method registered as returning string / i64 / f64 / an array
// / a tuple / a struct / an Option is rejected; anything else (an i32 / boolean
// return) is admitted. The qualified key "<recv>.<method>" is how every *_ret
// registry stores receiver methods (mirroring expr_is_str / infer_expr_width).
function iife_method_ret_i32(recv: string, method: string, s: LowerState): boolean {
    var key: string = recv + "." + method;
    if (s.is_str_ret_fn(key)) { return false; }
    if (s.is_i64_ret_fn(key)) { return false; }
    if (s.is_f64_ret_fn(key)) { return false; }
    if (s.is_arr_ret_fn(key) || s.is_strarr_ret_fn(key) || s.is_f64arr_ret_fn(key) || s.is_i64arr_ret_fn(key)) { return false; }
    if (s.struct_ret_type(key) != "") { return false; }
    if (s.tuple_ret_type(key) != "") { return false; }
    if (s.opt_ret_type(key) != "") { return false; }
    return true;
}

// iife_method_ret_kind reports the WIDE result kind ("i64" / "f64") of method
// `method` on a struct / enum receiver `recv`, or "" if it isn't registered as
// returning that width. The qualified "<recv>.<method>" key mirrors iife_method_
// ret_i32; this is its wide sibling, for a value-position match-EXPRESSION arm whose
// tail is `V(p) => p.get()` (get(): i64/f64) — the wide method result types the temp.
function iife_method_ret_kind(recv: string, method: string, s: LowerState): string {
    var key: string = recv + "." + method;
    if (s.is_i64_ret_fn(key)) { return "i64"; }
    if (s.is_f64_ret_fn(key)) { return "f64"; }
    return "";
}

// iife_borrow_leaf_i32 reports whether `e` — a borrow READ of the bound payload
// `name` (declared type `ft`) — provably yields an i32 value, WITHOUT constructing a
// trial scope (the type is recovered directly from `ft`). The admitted shapes:
//   - `name.<field>`  : struct / enum payload, the field's type is i32.
//   - `name.<digit>`  : tuple payload, that element's tag is i32 / boolean.
//   - `name.len()`    : string OR array payload → i32 length.
//   - `name[idx]`     : string payload (a char code) or i32[]/boolean[] element.
// A BARE `name` (the payload itself) is NOT i32 — it is rejected so the arm bails
// (it would need a payload-typed result temp). Any other read is rejected.
// iife_payload_chain_type resolves the TYPE of a field / tuple-access CHAIN rooted
// at the bound payload `name` (declared type `ft`): `name` → ft, `name.f` → field
// f's type, `name.f.g` → the nested field's type, `name.0` → tuple element 0's tag,
// recursing through each struct / enum / tuple step. "" when the chain isn't rooted
// at `name` or any step isn't a resolvable struct/enum field or tuple element. This
// is what lets a NESTED borrow read (`q.p.x`) classify, where the old single-level
// `match (fa.obj) { ExprIdent }` check bailed.
function iife_payload_chain_type(e: ast.Expr, name: string, ft: string, s: LowerState): string {
    match (e) {
        ast.ExprIdent(id) => { if (id.name == name) { return ft; } return ""; },
        ast.ExprFieldAccess(fa) => {
            var base: string = iife_payload_chain_type(fa.obj, name, ft, s);
            if (base == "") { return ""; }
            if (util.is_all_digits(fa.field)) { return tuple_type_elem_tag(base, util.digits_to_i32(fa.field)); }
            if (decl_is_struct(s.structs, base) || is_enum_like_name(base, s.structs)) {
                return decl_field_type(s.structs, base, fa.field);
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// iife_payload_arith_leaf_kind reports whether a LEAF expression `e` (one that is NOT
// an arithmetic `+,-,*,/,%` composition) provably yields a value of the wide kind
// `kind` ("i64" or "f64") given the bound payload `name` (declared type `ft`) is in
// scope. A leaf that MENTIONS the payload must be a wide READ of it: the BARE payload
// (`name`, ft == kind) or a struct-field / tuple-element chain whose terminal type is
// `kind` (iife_payload_chain_type). A leaf that does NOT mention the payload must be
// provably `kind` by the ordinary `s`-based classifiers (infer_expr_width == 64 for
// i64 / expr_is_f64 for f64) or — for i64 only — an integer literal (a bare numeric
// literal participating in i64 arithmetic). Anything else returns false (the whole
// tree then bails — correctness preserved).
function iife_payload_arith_leaf_kind(e: ast.Expr, name: string, ft: string, kind: string, s: LowerState): boolean {
    if (iife_expr_mentions_ident(e, name)) {
        // A wide READ of the payload — the bare payload itself, or a field / element
        // chain rooted at it whose terminal type is the wanted kind.
        match (e) {
            ast.ExprIdent(id) => { return id.name == name && ft == kind; },
            ast.ExprFieldAccess(_) => { return iife_payload_chain_type(e, name, ft, s) == kind; },
            _ => { return false; }
        }
        return false;
    }
    // Independent of the payload — classify with the ordinary wide predicates.
    if (kind == "f64") { return expr_is_f64(e, s); }
    // i64: a provably-i64 sub-expression, or an integer literal (a bare numeric
    // literal contributes a constant to i64 arithmetic).
    match (e) {
        ast.ExprNumber(n) => { return !n.is_float; },
        _ => {}
    }
    return infer_expr_width(e, s) == 64;
}

// iife_payload_arith_kind reports whether `e` is an ARITHMETIC composition (only
// `+,-,*,/,%` compose) whose value is the wide kind `kind` ("i64" or "f64"), where
// every leaf that MENTIONS the bound payload `name` is a wide READ of it (the bare
// payload of type `kind`, or a struct-field / tuple-element chain whose terminal type
// is `kind`) and every leaf that does NOT mention the payload is itself provably `kind`
// (or an integer literal, for i64). This lets a value-position match-EXPRESSION arm
// whose tail computes `n + 1`, `p.v * 2`, `n + 1.5`, etc. over a bound i64/f64 payload
// lower through the IR path: the StmtMatch arm-body store routes the wide arithmetic
// RHS through lower_i64 / the f64 path (it already does — statement-position works),
// so this gate only certifies the value-position result temp is the wide width. Any
// non-arithmetic shape, or a leaf that isn't a provable wide read / value, returns
// false so the arm bails (conservative — correctness preserved).
function iife_payload_arith_kind(e: ast.Expr, name: string, ft: string, kind: string, s: LowerState): boolean {
    if (kind != "i64" && kind != "f64") { return false; }
    match (e) {
        ast.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
                return iife_payload_arith_kind(b.left, name, ft, kind, s) && iife_payload_arith_kind(b.right, name, ft, kind, s);
            }
            return false;
        },
        ast.ExprUnary(u) => {
            // Unary negation preserves the wide kind; any other unary (a cast, `!`)
            // is rejected so the value-position temp stays the wanted width.
            if (u.op == "-") { return iife_payload_arith_kind(u.operand, name, ft, kind, s); }
            return iife_payload_arith_leaf_kind(e, name, ft, kind, s);
        },
        _ => { return iife_payload_arith_leaf_kind(e, name, ft, kind, s); }
    }
    return false;
}

// iife_free_fn_ret_i32 reports whether free function `name` provably returns an
// i32 (or boolean — both ride the i32 result temp). Sound by EXCLUSION, the
// free-function sibling of iife_method_ret_i32: a function registered as
// returning string / i64 / f64 / an array / a tuple / a struct / an Option is
// rejected; anything else (an i32 / boolean return) is admitted. Over-admission
// is safe — the actual lowering of the rewritten `tmp = g(args)` is the truth, so
// a non-i32 / non-lowerable callee bails the function.
function iife_free_fn_ret_i32(name: string, s: LowerState): boolean {
    if (s.is_str_ret_fn(name)) { return false; }
    if (s.is_i64_ret_fn(name)) { return false; }
    if (s.is_f64_ret_fn(name)) { return false; }
    if (s.is_arr_ret_fn(name) || s.is_strarr_ret_fn(name) || s.is_f64arr_ret_fn(name) || s.is_i64arr_ret_fn(name)) { return false; }
    if (s.struct_ret_type(name) != "") { return false; }
    if (s.tuple_ret_type(name) != "") { return false; }
    if (s.opt_ret_type(name) != "") { return false; }
    return true;
}

// iife_arg_is_payload_borrow reports whether `arg` is a BORROW read of the bound
// payload `name` — the bare payload itself, or a field- / tuple- / index-access
// chain rooted at it (`name`, `name.f`, `name.0.x`, `name[i]`). Such an argument
// passes the payload (or a sub-part) to a callee by pointer; since the payload is
// borrowed from the leak-safe enum box (never reclaimed by the match), the callee
// reading — or even retaining — it can never double-free.
function iife_arg_is_payload_borrow(arg: ast.Expr, name: string): boolean {
    match (arg) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprFieldAccess(fa) => { return iife_arg_is_payload_borrow(fa.obj, name); },
        ast.ExprIndex(ix) => { return iife_arg_is_payload_borrow(ix.array, name); },
        // A CALL that borrows the payload and returns a FRESH value (`id(t)`,
        // `s.trim()`): the payload flows only into the call's operands (its method
        // receiver + every argument), each of which must itself be independent of
        // the payload OR a borrow read. The call reads the payload and produces a
        // NEW value, so the payload is never the result identity — borrow-safe by
        // the same leak-safe reasoning as a direct read. This lets a nested-call
        // argument (`sum(id(t))`) and a `.len()` over a payload string-method
        // result (`s.trim().len()`) ride the i32 result temp (#3498 follow-up).
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (iife_expr_mentions_ident(cfa.obj, name) && !iife_arg_is_payload_borrow(cfa.obj, name)) { return false; }
                },
                ast.ExprIdent(_) => {},
                _ => { return false; }
            }
            for each_arg in c.args {
                if (iife_expr_mentions_ident(each_arg, name) && !iife_arg_is_payload_borrow(each_arg, name)) { return false; }
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// iife_call_arg_borrow_safe reports whether call argument `arg` is safe w.r.t. the
// bound payload `name`: either it does NOT mention the payload (an independent
// argument the rewritten StmtMatch lowers normally), or it IS a borrow read of the
// payload (iife_arg_is_payload_borrow). Anything else that mentions the payload (a
// non-borrow composition that could retain it in a non-leak-safe way) is rejected.
function iife_call_arg_borrow_safe(arg: ast.Expr, name: string, ft: string, s: LowerState): boolean {
    if (!iife_expr_mentions_ident(arg, name)) { return true; }
    return iife_arg_is_payload_borrow(arg, name);
}

// iife_call_is_i32_borrow reports whether `c` is a FREE-function call (`g(args)`)
// that provably returns i32 and whose arguments are each borrow-safe w.r.t. the
// bound payload — so the match-EXPRESSION arm `V(p) => g(p)` / `Cons(h, t) => h +
// sum(t)` (passing the bound payload as a borrow argument) yields an i32 result
// and lowers exactly as its statement-position form already does (#3498).
function iife_call_is_i32_borrow(c: ast.ExprCall, name: string, ft: string, s: LowerState): boolean {
    match (c.callee) {
        ast.ExprIdent(cid) => { if (!iife_free_fn_ret_i32(cid.name, s)) { return false; } },
        // A METHOD call on ANOTHER receiver (`w.take(p)` — `w` is not the bound
        // payload): the method must provably return i32 (by exclusion on the
        // receiver's struct/enum type, iife_method_ret_i32) and the receiver
        // itself must be borrow-safe w.r.t. the payload (independent of it, or a
        // borrow read). The method-on-the-PAYLOAD case (`p.m()`) is handled
        // separately in iife_borrow_leaf_i32 and never reaches here. #3498.
        ast.ExprFieldAccess(cfa) => {
            var rty: string = expr_struct_type(cfa.obj, s);
            if (rty == "") { return false; }
            if (!iife_method_ret_i32(rty, cfa.field, s)) { return false; }
            if (!iife_call_arg_borrow_safe(cfa.obj, name, ft, s)) { return false; }
        },
        _ => { return false; }
    }
    for arg in c.args {
        if (!iife_call_arg_borrow_safe(arg, name, ft, s)) { return false; }
    }
    return true;
}

function iife_borrow_leaf_i32(e: ast.Expr, name: string, ft: string, s: LowerState): boolean {    match (e) {
        ast.ExprIdent(id) => { return false; },   // bare payload — not i32
        ast.ExprFieldAccess(fa) => {
            // A field / tuple-access CHAIN rooted at the bound payload — `name.f`,
            // `name.0`, or a NESTED `name.f.g` / `name.0.x` — is an i32 borrow read
            // iff the terminal type resolves to i32 / boolean. iife_payload_chain_type
            // walks each struct-field / tuple-element step from the payload type `ft`.
            var ct: string = iife_payload_chain_type(e, name, ft, s);
            return ct == "i32" || ct == "boolean";
        },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => {
                    if (aid.name != name) { return false; }
                    // `name[idx]` — a string char code (i32) or a scalar-array element (i32).
                    if (ft == "string" || is_scalar_array_type(ft)) { return iife_borrow_subexpr_i32(ix.index, name, ft, s); }
                    return false;
                },
                _ => { return false; }
            }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    // `<borrow-derived>.len()` → i32 (string / array length). The
                    // receiver may be the bare payload (`name.len()`) OR any
                    // borrow-derived value off it (`name.trim().len()` — a string
                    // method on the payload whose fresh result is measured). #3498.
                    if (cfa.field == "len" && c.args.len() == 0 && iife_arg_is_payload_borrow(cfa.obj, name)) { return true; }
                    // Method on the PAYLOAD itself: `name.method()` on a struct /
                    // enum payload whose return is provably i32 (NOT in any wider-
                    // result registry — a boolean return also rides the i32 temp).
                    // Args are not re-checked here: a non-borrow / non-lowerable arg
                    // bails the function in lowering.
                    match (cfa.obj) {
                        ast.ExprIdent(rid) => {
                            if (rid.name == name) {
                                if (decl_is_struct(s.structs, ft) || is_enum_like_name(ft, s.structs)) {
                                    return iife_method_ret_i32(ft, cfa.field, s);
                                }
                                return false;
                            }
                        },
                        _ => {}
                    }
                    // Method on ANOTHER receiver passing the payload as a borrow arg
                    // (`w.take(p)`): the method sibling of the free-function case
                    // below, handled by iife_call_is_i32_borrow (#3498 follow-up).
                    return iife_call_is_i32_borrow(c, name, ft, s);
                },
                // `g(name)` / `sum(t)` — a FREE-function call passing the bound
                // payload as a borrow argument, returning i32. The statement-form
                // match already lowers this; admitting it lets the value-position
                // match-EXPRESSION arm (`V(p) => g(p)`, recursive `Cons(h, t) => h +
                // sum(t)`) ride the i32 result temp instead of bailing to AST (#3498).
                ast.ExprIdent(_) => { return iife_call_is_i32_borrow(c, name, ft, s); },
                _ => {}
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// iife_borrow_subexpr_i32 reports whether `e` provably yields an i32 value given the
// bound payload `name` (type `ft`) is in scope. A sub-expression that does NOT
// mention `name` is classified by the ordinary i32 predicates over `s` (the binding
// is irrelevant); one that DOES is either an arithmetic / comparison / logical
// COMPOSITION of i32 sub-results, or a direct borrow LEAF (iife_borrow_leaf_i32).
// This is the trial-scope-free classifier the borrow gate uses (it avoids adding a
// local to the lowering state purely to classify).
function iife_borrow_subexpr_i32(e: ast.Expr, name: string, ft: string, s: LowerState): boolean {
    if (!iife_expr_mentions_ident(e, name)) {
        // The bound payload is irrelevant here — classify with the existing rules.
        if (expr_is_str(e, s)) { return false; }
        if (expr_is_f64(e, s)) { return false; }
        if (infer_expr_width(e, s) == 64) { return false; }
        if (expr_is_tuple(e, s)) { return false; }
        if (expr_is_result(e, s)) { return false; }
        if (expr_is_arr_src(e, s) || expr_is_strarr(e, s) || expr_is_f64arr(e, s) || expr_is_i64arr(e, s)) { return false; }
        if (expr_struct_type(e, s) != "") { return false; }
        return true;
    }
    match (e) {
        ast.ExprBinary(b) => {
            // Comparison / logical ops yield an i32 boolean regardless of operand
            // width (booleans ride the i32 slot). Arithmetic / bitwise ops are i32
            // only when BOTH operands are provably i32 (an i64 operand widens the op).
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=" || b.op == "&&" || b.op == "||") { return true; }
            return iife_borrow_subexpr_i32(b.left, name, ft, s) && iife_borrow_subexpr_i32(b.right, name, ft, s);
        },
        ast.ExprUnary(u) => {
            if (u.op == "!") { return true; }                  // boolean → i32
            if (u.op == "as_i64" || u.op == "as_u64") { return false; }
            return iife_borrow_subexpr_i32(u.operand, name, ft, s);
        },
        _ => { return iife_borrow_leaf_i32(e, name, ft, s); }
    }
    return false;
}

// iife_payload_borrow_i32 admits a STRUCT / STRING / TUPLE / ENUM payload binding
// for the inlined match-EXPRESSION when the arm's tail reads it as a BORROW that
// produces a provably-i32 result (`p.x` of an i32 field, `s.len()`, `t.0` of an i32
// element, an i32 composition of these). The underlying StmtMatch path already
// binds + deep-drops / leaks these payloads correctly; this gate only needs to
// guarantee the i32 result temp is the right width. A BARE return (`V(p) => p`)
// would need a payload-typed temp the IIFE can't classify, so it is rejected (like
// the array case). A non-i32 borrow result (string / i64 / f64 / tuple / array /
// struct field read) is rejected too — its temp would be mis-classified at the
// width inferred before the binding is in scope. Leak-safe struct payloads only.
function iife_payload_borrow_i32(ft: string, name: string, arm: ast.MatchArm, s: LowerState): boolean {
    // A struct payload must be leak-safe (no aliasing array fields needing RC) — it
    // is borrowed from the enum box, never reclaimable, so it must leak cleanly.
    if (decl_is_struct(s.structs, ft) && !is_enum_like_name(ft, s.structs) && !decl_is_leaksafe(s.structs, ft)) { return false; }
    // Bare return of the payload is rejected (needs a payload-typed temp).
    if (iife_arm_returns_ident(arm, name)) { return false; }
    var tail: ast.Expr = iife_arm_tail_expr(arm);
    return iife_borrow_subexpr_i32(tail, name, ft, s);
}

// iife_payload_field_bindable reports whether a payload of field TYPE `ft`, bound to
// `name` in `arm`, is admissible for the inlined match-EXPRESSION:
//   - i32: always (an i32 store / borrow).
//   - i64 / f64: only when RETURNED DIRECTLY (`V(a) => a`) — the result temp was
//     classified to the matching width by iife_payload_result_width. (A non-direct
//     i64/f64 use, e.g. `a + 1`, would need width-aware arm-body lowering this gate
//     doesn't provide, so it bails.)
//   - scalar-element array (i32[]/boolean[]): only when NOT returned bare — the
//     array is bound + deep-dropped by the underlying StmtMatch path and read as a
//     borrow (`xs[0]` / `xs.len()`), producing an i32 result. The 8-byte-element
//     arrays (i64[]/f64[]) are NOT admitted: the StmtMatch payload-binding mark
//     (is_scalar_array_type only) doesn't carry the i64/f64 element width, so an
//     element read would default to i32 width and read garbage — they stay gated to
//     AST (the same limitation applies to the statement-match path itself).
//   - struct / string / tuple / nominal-enum payload: only when read as a BORROW
//     whose result is provably i32 (`p.x` of an i32 field, `s.len()`, `t.0` of an
//     i32 element, an enum method returning i32) — NOT returned bare. The result
//     temp stays the (default) i32 width, so the value lands correctly; a non-i32
//     borrow result (string / i64 / f64 / tuple / array / struct field) is rejected
//     because its temp would be mis-classified at the i32 width inferred before the
//     binding is in scope (iife_payload_borrow_i32 / iife_expr_result_is_i32).
function iife_payload_field_bindable(ft: string, name: string, arm: ast.MatchArm, res_kind: string, s: LowerState): boolean {
    if (ft == "i32") { return true; }
    // u32 rides the same 32-bit payload slot as i32 — op_opt_make stores a 4-byte
    // wrapped value and the underlying StmtMatch path binds it at width, which is
    // why the STATEMENT form of the same match already lowers. Only this gate
    // named the width, so `match (a -? b) { Some(c) => c, … }` on u32 operands
    // refused where the i32 spelling lowered (#6400).
    if (ft == "u32") { return true; }
    // u64 is i64-WIDE — only the signedness of its own ops differs, and that is
    // selected at the producing expression, not here (the same reading
    // i64_ret_fns_of states for the 64-bit signature path). The StmtMatch binder
    // carries the unsignedness on the slot, which is why the STATEMENT form of
    // this match already lowers. Normalise before the wide arm rather than adding
    // a `|| ft == "u64"` to it: the arm forwards `ft` into the payload-arith
    // shape tests, which compare against "i64", so threading the raw "u64" would
    // widen the admission while silently stopping those tests matching — failing
    // toward a wrong answer instead of a bail (#6647).
    var wft: string = ft;
    if (wft == "u64") { wft = "i64"; }
    if (wft == "i64" || wft == "f64") {
        if (iife_arm_returns_ident(arm, name) || iife_arm_returns_narrowed_payload(arm, name)) { return true; }
        // `(arith-over-payload) as i32` (`Some(x) => (x + 2) as i32`, `Some(v) =>
        // (v * 4.0) as i32`): a wide i64/f64 intermediate over the payload, narrowed
        // to an i32 result temp. The cast narrows, so the result temp is i32 either
        // way; iife_arm_returns_narrowed_payload_arith certifies the wide-arith shape.
        if (iife_arm_returns_narrowed_payload_arith(arm, name, wft, s)) { return true; }
        // An i64/f64 ARITHMETIC composition over the BARE wide payload (`V(n) => n + 1`,
        // `V(n) => n + 1.5`): the result temp was classified i64/f64 by the matching
        // iife_payload_arith_kind shape (iife_arm_payload_result_kind), and the
        // StmtMatch arm-body store routes the wide RHS through lower_i64 / the f64 path
        // (statement-position already lowers `return n + 1`). res_kind names the wide
        // width; admit when the arm tail is that wide-arith shape over the payload.
        if ((res_kind == "i64" || res_kind == "f64") && iife_payload_arith_kind(iife_arm_tail_expr(arm), name, wft, res_kind, s)) { return true; }
        // The binding is DEAD — the arm body never references `name` (`Some(x) => 1`,
        // an i64/f64 payload bound to a name the arm doesn't read). The payload width
        // is then irrelevant to the result temp (driven solely by the arm's actual
        // return value), and the StmtMatch binder already produces the correct
        // width-typed slot. This is the wide-payload analog of the unconditional i32
        // admit above and of the wildcard `Some(_)` path, which already lower.
        if (!parser.stmts_mention(arm.body, name)) { return true; }
        return false;
    }
    if (is_scalar_array_type(ft)) { return !iife_arm_returns_ident(arm, name); }
    // STRING result temp (res_kind == "string"): admit a string read of the bound
    // payload — a BARE string payload (`V(x) => x`, ft string) or a string FIELD /
    // ELEMENT read of a struct / tuple payload (`V(p) => p.name`, `V(t) => t.0`).
    // The temp was classified str by iife_payload_result_kind, so the StmtMatch
    // store/load is a string pointer (matching the value the binding loads).
    if (res_kind == "string" && iife_payload_string_bindable(ft, name, arm, s)) { return true; }
    // i64 / f64 result temp (res_kind == "i64" / "f64"): admit a wide FIELD / ELEMENT
    // read of the bound payload — a struct/enum field (`V(p) => p.v`, v:i64/f64) or a
    // tuple element (`V(t) => t.0`, element tag i64/f64). The temp was classified
    // i64/f64 by iife_payload_result_kind, and the rewritten `tmp = p.v` store routes
    // the RHS through lower_i64 / the f64 path (StmtAssign's is_i64_slot / is_f64_slot
    // branch) so the width round-trips (the field read is op_struct_get_i64 /
    // struct_get width-64, stored into the matching-width slot). The BARE i64/f64
    // payload (`V(a) => a`) is admitted above via iife_arm_returns_ident.
    if ((res_kind == "i64" || res_kind == "f64") && iife_payload_wide_bindable(ft, name, arm, res_kind, s)) { return true; }
    if (ft == "string" || decl_is_struct(s.structs, ft) || is_enum_like_name(ft, s.structs) || tuple_elems_lowerable(ft, s.structs)) {
        return iife_payload_borrow_i32(ft, name, arm, s);
    }
    return false;
}

// iife_string_borrow_leaf reports whether `e` — a leaf that MENTIONS the bound
// payload `name` (declared type `ft`) — is a BORROW-ONLY string read of the payload:
// the bare string payload itself (`name`, ft string), a string struct/enum field read
// (`name.field`, field type string), or a string tuple element read (`name.<i>`,
// element tag string). These all READ the payload (a borrow from the enum box) and
// yield a string value; they never store / alias the payload past the match. Any other
// shape that mentions `name` is rejected (it could retain the payload).
function iife_string_borrow_leaf(e: ast.Expr, name: string, ft: string, s: LowerState): boolean {
    match (e) {
        ast.ExprIdent(id) => {
            // The bare payload string itself — only when the payload IS a string.
            return id.name == name && ft == "string";
        },
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name != name) { return false; }
                    if (util.is_all_digits(fa.field)) {
                        return tuple_type_elem_tag(ft, util.digits_to_i32(fa.field)) == "string";
                    }
                    if (decl_is_struct(s.structs, ft) || is_enum_like_name(ft, s.structs)) {
                        return decl_field_type(s.structs, ft, fa.field) == "string";
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// iife_string_concat_operand classifies one operand of a borrow-only string concat:
// a nested `+` concat (recurse), a borrow-only string read of the payload (the leaf),
// or — when it does NOT mention `name` — any string-valued expression (a fresh string
// to concat, irrelevant to the payload borrow). The non-payload string check reuses
// expr_is_str (so a string literal, a string-returning call, etc. all pass) without
// needing the binding in scope, since the expression doesn't reference it.
function iife_string_concat_operand(e: ast.Expr, name: string, ft: string, s: LowerState): boolean {
    match (e) {
        ast.ExprBinary(b) => {
            if (b.op == "+") {
                return iife_string_concat_operand(b.left, name, ft, s) && iife_string_concat_operand(b.right, name, ft, s);
            }
            return false;
        },
        _ => {}
    }
    if (iife_expr_mentions_ident(e, name)) {
        return iife_string_borrow_leaf(e, name, ft, s);
    }
    // The operand is independent of the payload — admit any string value (it
    // contributes a fresh string the concat reads, no payload aliasing).
    return expr_is_str(e, s);
}

// iife_string_concat_borrow_only reports whether `e` is a STRING-CONCAT expression
// (`+` tree) whose result is a FRESH string and whose only contact with the bound
// payload `name` is BORROW-ONLY reads. Each `+` operand is a borrow-only string read of
// the payload (iife_string_borrow_leaf — the payload string, or a string field /
// tuple-element of it), a nested string concat of such operands, or a sub-expression
// that does NOT mention `name` and is a string value (a literal / a string-returning
// call over non-payload data — a fresh string to concat in). Concat reads both operands
// and allocates a NEW string box, so the payload is never retained / aliased past the
// match: the borrow is sound, exactly like iife_payload_borrow_i32's i32 reads but with
// a string result. To avoid admitting a degenerate single-leaf (no concat allocation,
// already covered by the bare / field / element cases below), `e` must itself be a `+`.
function iife_string_concat_borrow_only(e: ast.Expr, name: string, ft: string, s: LowerState): boolean {
    match (e) {
        ast.ExprBinary(b) => {
            if (b.op != "+") { return false; }
            return iife_string_concat_operand(b.left, name, ft, s) && iife_string_concat_operand(b.right, name, ft, s);
        },
        _ => { return false; }
    }
    return false;
}

// iife_payload_string_bindable admits a STRING-result arm reading the bound payload
// `name` of field type `ft`: a bare string payload returned (`ft == "string"` and the
// arm returns `name`), a string struct/enum field read (`name.field`, field type
// string), a string tuple element read (`name.<i>`, element tag string), or a
// BORROW-ONLY string CONCAT over those reads (`name + "!"`, `"k=" + name.field`, …) —
// the concat allocates a fresh string and only READS the payload, so the borrow is
// sound (iife_string_concat_borrow_only). A struct payload must be leak-safe (borrowed
// from the enum box, never reclaimed — see iife_payload_borrow_i32). The temp is a
// string slot (classified above), so the StmtMatch path's string-pointer store/load
// lands correctly.
function iife_payload_string_bindable(ft: string, name: string, arm: ast.MatchArm, s: LowerState): boolean {
    var tail: ast.Expr = iife_arm_tail_expr(arm);
    // A struct payload field / tuple element read — struct must be leak-safe.
    if (decl_is_struct(s.structs, ft) && !is_enum_like_name(ft, s.structs) && !decl_is_leaksafe(s.structs, ft)) { return false; }
    // A BORROW-ONLY string concat over the payload (`name + "!"`, `"k=" + name`,
    // `name.field + suffix`, …) — admitted for any payload type whose borrow leaves
    // are string (string payload, string struct field, string tuple element).
    if (iife_string_concat_borrow_only(tail, name, ft, s)) { return true; }
    // Bare string payload returned: `V(x) => x`, x : string.
    if (ft == "string") { return iife_arm_returns_ident(arm, name); }
    match (tail) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name != name) { return false; }
                    if (util.is_all_digits(fa.field)) {
                        return tuple_type_elem_tag(ft, util.digits_to_i32(fa.field)) == "string";
                    }
                    if (decl_is_struct(s.structs, ft) || is_enum_like_name(ft, s.structs)) {
                        return decl_field_type(s.structs, ft, fa.field) == "string";
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// iife_payload_wide_bindable admits an i64/f64-result arm reading the bound payload
// `name` of field type `ft` via a struct/enum FIELD read (`V(p) => p.v`, v an i64/f64
// field) or a tuple ELEMENT read (`V(t) => t.0`, element tag i64/f64). `want` is the
// result kind ("i64" or "f64") classified for the temp. A struct payload must be
// leak-safe (borrowed from the enum box, never reclaimed — see iife_payload_borrow_i32);
// the read is a borrow that yields a fresh scalar, so the payload is never retained past
// the match. The temp was marked i64/f64 (iife_payload_result_kind), and the rewritten
// `tmp = p.v` store routes the RHS through lower_i64 / the f64 path (StmtAssign's
// is_i64_slot / is_f64_slot branch), so the width round-trips: an i64 field reads via
// op_struct_get_i64 and stores into the i64 slot; an f64 field reads via struct_get
// width-64 and stores into the f64 slot. The BARE wide payload (`V(a) => a`) is handled
// by iife_arm_returns_ident in the caller; this is the FIELD/ELEMENT shape only.
function iife_payload_wide_bindable(ft: string, name: string, arm: ast.MatchArm, want: string, s: LowerState): boolean {
    // A struct payload field read — struct must be leak-safe.
    if (decl_is_struct(s.structs, ft) && !is_enum_like_name(ft, s.structs) && !decl_is_leaksafe(s.structs, ft)) { return false; }
    var tail: ast.Expr = iife_arm_tail_expr(arm);
    // An i64/f64 ARITHMETIC composition over the bound payload (`V(n) => n + 1`,
    // `V(p) => p.v * 2`, `V(n) => n + 1.5`): every payload-mentioning leaf is a wide
    // read of the payload (the bare wide payload, or an i64/f64 field / element chain)
    // and the tree's value is the wanted kind. The result-kind recovery classified the
    // temp i64/f64 via the same iife_payload_arith_kind shape; the StmtMatch arm-body
    // store routes the wide RHS through lower_i64 / the f64 path (statement-position
    // already lowers this), so the width round-trips. This subsumes the bare wide
    // payload (a degenerate single-leaf arith), so it is tried first.
    if (iife_payload_arith_kind(tail, name, ft, want, s)) { return true; }
    match (tail) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name != name) { return false; }
                    // Tuple element `t.<digit>`: the element tag must be the wanted width.
                    if (util.is_all_digits(fa.field)) {
                        return tuple_type_elem_tag(ft, util.digits_to_i32(fa.field)) == want;
                    }
                    // Struct / enum field `p.field`: the field type must be the wanted width.
                    if (decl_is_struct(s.structs, ft) || is_enum_like_name(ft, s.structs)) {
                        return decl_field_type(s.structs, ft, fa.field) == want;
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        // Method call on a struct / enum payload returning the wanted wide kind
        // (`V(p) => p.get()`, get(): i64/f64). The result-kind recovery classified the
        // temp via the same iife_method_ret_kind lookup; the StmtMatch arm-body store
        // routes the wide method result through lower_i64 / the f64 path.
        ast.ExprCall(mc) => {
            match (mc.callee) {
                ast.ExprFieldAccess(mcf) => {
                    match (mcf.obj) {
                        ast.ExprIdent(rcv) => {
                            if (rcv.name != name) { return false; }
                            // i64 only (see iife_arm_payload_result_kind): the f64
                            // method-result path mis-lowers in value position.
                            if ((decl_is_struct(s.structs, ft) || is_enum_like_name(ft, s.structs)) && want == "i64") {
                                return iife_method_ret_kind(ft, mcf.field, s) == "i64";
                            }
                            return false;
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function iife_payload_bindable(pv: ast.PatVariant, arm: ast.MatchArm, opt_srt: string, scrut_enum: string, temp_is_i32: boolean, scrut_is_ident: boolean, res_kind: string, s: LowerState): boolean {
    if (opt_srt != "") {
        var pt: string = opt_payload_type(opt_srt, pv.type_name);
        if (pt == "i32") { return true; }
        // A `dyn Trait` error payload (`Err(e)` where e: dyn Error) is admitted
        // into an i32-result temp: the underlying StmtMatch path marks the slot
        // with the dyn type so `e.method()` dispatches via op_dyn_dispatch.
        if (temp_is_i32 && pt.len() > 4 && slice_unchecked(pt, 0, 4) == "dyn ") { return true; }
        // A nested Option / RESULT payload (`Some(b)` where b: Option[T] or
        // Result[T, E]) into an i32 temp from an IDENT scrutinee. The argument is
        // the one the Option half already rested on: arms share a result type in
        // valid Fern, so an i32 temp means every arm computes an i32 and the bound
        // box is only ever CONSUMED to do that — typically by a nested
        // `match (b)`, or by a nested PATTERN (`Some(Ok(n))`), which the underlying
        // StmtMatch path lowers. It is never stored into the i32 temp as the
        // result; an arm returning the box whole would not have an i32 temp.
        // Result was simply missing from the spelling test, so `Some(r)` /
        // `Some(Ok(n))` over an Option[Result[…]] bailed the module while the
        // identical STATEMENT-form match lowered.
        if (temp_is_i32 && scrut_is_ident && pt.len() >= 8 && (slice_unchecked(pt, 0, 7) == "Option[" || slice_unchecked(pt, 0, 7) == "Result[")) { return true; }
        // A STRING / STRUCT / TUPLE / ENUM Some/Ok/Err payload BORROW-read into the
        // result (`Some(s) => s.len()`, `Some(p) => p.x`, `Err(s) => s.len()`):
        // admit via the SAME leak-safe borrow machinery the user-enum branch below
        // uses (iife_payload_field_bindable → iife_payload_borrow_i32 /
        // iife_payload_string_bindable). The underlying StmtMatch Option/Result
        // lowering already binds the payload at its type (statement-position
        // string/struct payload matches lower), so the borrow reads resolve; the
        // payload is borrowed from the box (leak-safe, never reclaimed). A bare
        // payload returned whole still bails inside field_bindable (no i32/typed
        // temp for it), and an unrecoverable pt ("") keeps the strict reject.
        if (pt != "") { return iife_payload_field_bindable(pt, pv.binding, arm, res_kind, s); }
        return false;
    }
    // User-enum variant: read its single payload field type, then admit i32 / i64 /
    // f64 / leak-safe scalar array per iife_payload_field_bindable.
    var ft: string = iife_user_enum_payload_type(pv, scrut_enum, s);
    if (ft == "") { return false; }
    return iife_payload_field_bindable(ft, pv.binding, arm, res_kind, s);
}

// iife_enum_payloads_bindable reports whether a MULTI-payload user-enum variant arm
// (`Pair(a, b)`) binds only admissible payloads — the main binding (`__ev`) and
// every extra binding (`__ev1`, `__ev2`, …), each admitted by
// iife_payload_field_bindable (i32 / directly-returned i64-f64 / borrow-only
// leak-safe array). The underlying StmtMatch path binds the payload fields at
// width. A `_` binding is skipped.
function iife_enum_payloads_bindable(pv: ast.PatVariant, arm: ast.MatchArm, scrut_enum: string, s: LowerState): boolean {
    var vdecl: i32 = variant_arm_decl_index(pv, scrut_enum, s);
    if (vdecl < 0) { return false; }
    // Multi-payload arms keep the existing i32 / direct-i64-f64 / borrow-only
    // admission — a string result from a multi-binding arm isn't in scope here, so
    // res_kind is left "" (no string admit for this shape).
    if (pv.binding.len() > 0 && pv.binding != "_") {
        var ft0: string = decl_at_payload_type(s.structs, vdecl, 0);
        if (!iife_payload_field_bindable(ft0, pv.binding, arm, "", s)) { return false; }
    }
    var k: i32 = 0;
    while (k < pv.extra_bindings.len()) {
        var eb: string = pv.extra_bindings[k];
        if (eb.len() > 0 && eb != "_") {
            var ftk: string = decl_at_payload_type(s.structs, vdecl, k + 1);
            if (!iife_payload_field_bindable(ftk, eb, arm, "", s)) { return false; }
        }
        k = k + 1;
    }
    return true;
}

// iife_variant_payload_field returns the variant struct's payload FIELD TYPE for a
// binding name within a PatVariant arm: `__ev` for the main binding, `__ev<k+1>`
// for the k-th extra binding. Returns "" when the name doesn't bind a payload of
// this variant (so a bare-ident return that isn't a payload is left unclassified).
function iife_variant_payload_field(pv: ast.PatVariant, name: string, scrut_enum: string, s: LowerState): string {
    var vdecl: i32 = variant_arm_decl_index(pv, scrut_enum, s);
    if (vdecl < 0) { return ""; }
    var pvb: string = pv.binding;
    if (pvb.len() > 0 && pvb != "_" && pvb == name) { return decl_at_payload_type(s.structs, vdecl, 0); }
    var k: i32 = 0;
    while (k < pv.extra_bindings.len()) {
        var eb: string = pv.extra_bindings[k];
        if (eb.len() > 0 && eb != "_" && eb == name) { return decl_at_payload_type(s.structs, vdecl, k + 1); }
        k = k + 1;
    }
    return "";
}

// iife_bound_payload_type resolves the payload TYPE bound by `name` in a PatVariant
// arm, covering BOTH a user-enum variant (the `__ev` / `__ev<k>` struct field, via
// iife_variant_payload_field) AND an Option/Result Some/Ok/Err variant whose payload
// type isn't a user struct (recovered from the scrutinee's Option/Result spelling
// `opt_srt` via opt_payload_type). When the user-enum lookup succeeds it is returned
// unchanged, so user-enum behaviour is byte-identical; the Option/Result fall-through
// only fires for the single MAIN binding (`Some(v)` / `Ok(v)` / `Err(v)` are single-
// payload variants), keeping multi-binding arms on the user-enum field path. "" when
// neither resolves (an unannotated scrutinee, a `_` binding, or a name that doesn't
// bind this variant's payload).
function iife_bound_payload_type(pv: ast.PatVariant, name: string, opt_srt: string, scrut_enum: string, s: LowerState): string {
    var ft: string = iife_variant_payload_field(pv, name, scrut_enum, s);
    if (ft != "") { return ft; }
    if (opt_srt != "" && pv.binding.len() > 0 && pv.binding != "_" && pv.binding == name) {
        return opt_payload_type(opt_srt, pv.type_name);
    }
    return "";
}

// iife_payload_result_width classifies a match-EXPRESSION's RESULT temp when an arm
// directly returns a BOUND enum payload (`V(a) => a`). The width can't be inferred
// from the bare ident at classify time (the binding isn't in scope yet), so it is
// recovered from the variant's payload FIELD TYPE: "i64" / "f64" when any arm's tail
// `return E` is a bare ident bound as an i64 / f64 payload of THAT arm's variant,
// else "". Mirrors the underlying StmtMatch path's struct_get_i64 / width-64 read
// of the same field — so the temp width lines up with the value the binding loads.
function iife_payload_result_width(m: ast.StmtMatch, s: LowerState): string {
    var scrut_enum: string = expr_struct_type(m.scrutinee, s);
    for arm in m.arms {
        if (arm.body.len() > 0) {
            var last: ast.Stmt = arm.body[arm.body.len() - 1];
            match (last) {
                ast.StmtReturn(r) => {
                    match (arm.pattern) {
                        ast.PatVariant(pv) => {
                            match (r.value) {
                                ast.ExprIdent(rid) => {
                                    var ft: string = iife_variant_payload_field(pv, rid.name, scrut_enum, s);
                                    // u64 classifies as the i64-wide temp — the temp
                                    // records WIDTH, and the slot carries the payload's
                                    // own signedness (#6647).
                                    if (ft == "i64" || ft == "u64") { return "i64"; }
                                    if (ft == "f64") { return "f64"; }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        }
    }
    return "";
}

// iife_match_returns_i64_payload reports whether `st` is a match-EXPRESSION whose
// result is a directly-returned BOUND i64 enum payload (`V(a) => a`, a:i64). Lets
// lower_i64 admit such a match-EXPRESSION (the bare ident isn't in scope to infer
// width, so it's recovered from the payload field via iife_payload_result_width).
function iife_match_returns_i64_payload(st: ast.Stmt, s: LowerState): boolean {
    match (st) {
        // iife_payload_result_kind covers the bare payload (`V(a) => a`) AND the
        // struct/enum-FIELD / tuple-ELEMENT read (`V(p) => p.v` / `V(t) => t.0`,
        // an i64 field/element) — the binding isn't in scope to infer the width
        // from the bare read, so the kind is recovered from the payload field type.
        ast.StmtMatch(mm) => { return iife_payload_result_kind(mm, s) == "i64"; },
        _ => { return false; }
    }
    return false;
}

// iife_payload_kind_of_type maps a payload field type to the IIFE result KIND the
// temp can carry ("string" / "i64" / "f64"), else "" (i32 / boolean / composite —
// handled by the i32 temp / the existing classifiers).
function iife_payload_kind_of_type(ft: string, s: LowerState): string {
    if (ft == "string") { return "string"; }
    if (ft == "i64") { return "i64"; }
    if (ft == "f64") { return "f64"; }
    return "";
}

// iife_arm_payload_result_kind recovers the RESULT KIND of a single arm whose tail
// reads the BOUND enum payload — when that read can't be classified by the ordinary
// `s`-based predicates because the binding isn't in scope. Shapes recovered (all
// purely from the variant's payload FIELD TYPE, recorded in `s.structs`):
//   - bare payload returned (`V(x) => x`)        → the payload field type's kind.
//   - struct/enum field read (`V(p) => p.name`)  → that field's type's kind, when p
//                                                   is a struct/enum payload.
//   - tuple element read (`V(t) => t.0`)         → that element tag's kind, when t
//                                                   is a tuple payload.
// "string" / "i64" / "f64" only (the scalar payload-derived kinds the IIFE temp can
// carry); "" for an i32 / boolean / unrecoverable result (handled by the i32 temp /
// the existing classifiers). The kind names the temp width the StmtMatch arm-body
// lowering already produces for the same field read, so the temp lines up.
function iife_arm_payload_result_kind(arm: ast.MatchArm, opt_srt: string, scrut_enum: string, s: LowerState): string {
    if (arm.body.len() == 0) { return ""; }
    var last: ast.Stmt = arm.body[arm.body.len() - 1];
    var rval: ast.Expr = parser.e_unknown("");
    var have: boolean = false;
    match (last) {
        ast.StmtReturn(r) => { rval = r.value; have = true; },
        _ => {}
    }
    if (!have) { return ""; }
    match (arm.pattern) {
        ast.PatVariant(pv) => {
            match (rval) {
                // Bare payload `V(x) => x` — kind is the payload field type's kind.
                ast.ExprIdent(rid) => {
                    var ft: string = iife_bound_payload_type(pv, rid.name, opt_srt, scrut_enum, s);
                    return iife_payload_kind_of_type(ft, s);
                },
                // `name.<field>` / `name.<digit>` — a field / tuple-element read of
                // the bound payload `name` of field type `ft0`.
                ast.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ast.ExprIdent(oid) => {
                            var ft0: string = iife_bound_payload_type(pv, oid.name, opt_srt, scrut_enum, s);
                            if (ft0 == "") { return ""; }
                            // Tuple element `t.0`: recover the element tag's kind.
                            if (util.is_all_digits(fa.field)) {
                                var et: string = tuple_type_elem_tag(ft0, util.digits_to_i32(fa.field));
                                return iife_payload_kind_of_type(et, s);
                            }
                            // Struct / enum field `p.name`: recover the field type's kind.
                            if (decl_is_struct(s.structs, ft0) || is_enum_like_name(ft0, s.structs)) {
                                var fdt: string = decl_field_type(s.structs, ft0, fa.field);
                                return iife_payload_kind_of_type(fdt, s);
                            }
                            return "";
                        },
                        _ => { return ""; }
                    }
                },
                // String CONCAT over the bound payload (`V(x) => x + "!"`,
                // `"k=" + x`, `V(p) => p.name + "!"`): a `+` tree that reads the
                // payload `pv.binding` (type `ftc`) borrow-only and yields a fresh
                // string. The binding isn't in scope to classify by expr_is_str over a
                // BARE payload ident, so recover "string" from the borrow-only concat
                // shape (iife_string_concat_borrow_only). The StmtMatch arm-body
                // lowering binds the payload at width and lowers the concat to a fresh
                // string, matching the string temp this kind selects.
                ast.ExprBinary(bc) => {
                    if (bc.op != "+") { return ""; }
                    if (pv.binding.len() == 0 || pv.binding == "_") { return ""; }
                    var ftc: string = iife_bound_payload_type(pv, pv.binding, opt_srt, scrut_enum, s);
                    if (ftc == "") { return ""; }
                    if (iife_string_concat_borrow_only(rval, pv.binding, ftc, s)) { return "string"; }
                    // i64 / f64 ARITHMETIC over the bound wide payload (`V(n) => n + 1`,
                    // `V(p) => p.v * 2`, `V(n) => n + 1.5`): a `+,-,*,/,%` tree whose
                    // every payload-mentioning leaf is a wide READ of the payload (the
                    // bare i64/f64 payload itself, or an i64/f64 struct-field / tuple-
                    // element chain rooted at it) and whose value is that wide kind. The
                    // binding isn't in scope to infer the width from the bare read, so the
                    // kind is recovered from the payload field type (`ftc`) + the
                    // arithmetic shape (iife_payload_arith_kind). For a BARE i64/f64
                    // payload (`ftc` == i64/f64) the leaf reads the payload itself; for a
                    // STRUCT/TUPLE payload (`ftc` a struct/tuple) the wide kind comes from
                    // a field/element read (`p.v`), so try both wide kinds. The StmtMatch
                    // arm-body store routes the wide RHS through lower_i64 / the f64 path,
                    // matching the wide temp this kind selects.
                    if (iife_payload_arith_kind(rval, pv.binding, ftc, "i64", s)) { return "i64"; }
                    if (iife_payload_arith_kind(rval, pv.binding, ftc, "f64", s)) { return "f64"; }
                    return "";
                },
                // Method call on a STRUCT / ENUM payload returning i64/f64
                // (`V(p) => p.get()`, get(): i64): recover the wide kind from the
                // method's registered return type. The StmtMatch arm-body store routes
                // the wide method result through lower_i64 / the f64 path (statement-
                // position `return p.get()` already lowers).
                ast.ExprCall(mc) => {
                    match (mc.callee) {
                        ast.ExprFieldAccess(mcf) => {
                            match (mcf.obj) {
                                ast.ExprIdent(rcv) => {
                                    var ft0: string = iife_bound_payload_type(pv, rcv.name, opt_srt, scrut_enum, s);
                                    if (ft0 == "") { return ""; }
                                    // i64 only: a wide i64-returning payload method
                                    // round-trips through the value-position temp; the
                                    // f64 method result does NOT (it mis-lowers to 0),
                                    // so an f64-returning method is rejected here.
                                    if (decl_is_struct(s.structs, ft0) || is_enum_like_name(ft0, s.structs)) {
                                        if (iife_method_ret_kind(ft0, mcf.field, s) == "i64") { return "i64"; }
                                    }
                                    return "";
                                },
                                _ => { return ""; }
                            }
                        },
                        _ => { return ""; }
                    }
                },
                _ => { return ""; }
            }
        },
        _ => {}
    }
    return "";
}

// iife_payload_result_kind scans the whole match for a payload-derived non-i32 RESULT
// kind ("string" / "i64" / "f64"), returning the first arm's recovered kind. Only the
// payload-binding arms contribute a kind; the i32 / non-payload arms return "" and are
// skipped. Arms must not disagree — if two arms recover DIFFERENT non-"" kinds the
// match is not uniformly typed, so "" is returned (the match bails). i64 / f64 are
// already covered by iife_payload_result_width for the bare case; this adds string and
// the struct-field / tuple-element shapes for all three kinds.
function iife_payload_result_kind(m: ast.StmtMatch, s: LowerState): string {
    var opt_srt: string = try_opt_type(m.scrutinee, s);
    var scrut_enum: string = expr_struct_type(m.scrutinee, s);
    var found: string = "";
    for arm in m.arms {
        var k: string = iife_arm_payload_result_kind(arm, opt_srt, scrut_enum, s);
        if (k != "") {
            if (found != "" && found != k) { return ""; }
            found = k;
        }
    }
    return found;
}

// iife_type_is_composite reports whether `t` names a COMPOSITE result type the
// IIFE temp can carry as a single pointer slot: a leak-safe struct, a nominal
// enum, a lowerable tuple, or a leak-safe SCALAR ARRAY. A non-leak-safe struct
// (RC'd array fields) is excluded — a payload borrowed from the enum box must
// leak cleanly, and a constructed-then-returned struct of that shape needs reuse
// analysis the IIFE path doesn't model. Scalars / strings / Option are NOT
// composite here (they have their own kind-recovery / slot-typing paths).
//
// The array admission (#7686) takes the same leak-cleanly bargain the struct arm
// takes, and needs it more: an arm may hand back a BORROWED payload
// (`E.A(xs) => xs`, a buffer the enum box still owns) while a sibling arm builds
// a FRESH one (`E.B => [i]`), and one temp carries both. The temp is therefore
// marked BORROWED at the classification site, so the exit sweep never decs it —
// releasing it would be the double-free the ELB tier fences. The fresh arm leaks
// instead, which is the polarity this whole gate is built on. Scoped to
// is_leaksafe_array_field: a string[] / struct-array element needs a deep walk
// the borrowed temp cannot describe.
// iife_borrowable_array_result reports whether `t` is an array type the IIFE
// temp can carry BORROWED. The temp is never swept (mark_borrowed_arr), so the
// question is only whether the slot can be typed correctly — not whether its
// release is describable, which is why the deeper-release kinds qualify too:
// their walk never runs from here. `string[]` needs mark_strarr and a struct /
// enum array needs its element name, both stamped at the marking site.
function iife_borrowable_array_result(t: string, s: LowerState): boolean {
    if (is_leaksafe_array_field(t)) { return true; }
    if (t == "string[]") { return true; }
    return is_struct_array_field_type(s.structs, t) || is_enum_array_field_type(s.structs, t);
}

function iife_type_is_composite(t: string, s: LowerState): boolean {
    if (t == "") { return false; }
    if (decl_is_struct(s.structs, t) && !is_enum_like_name(t, s.structs)) { return decl_is_leaksafe(s.structs, t); }
    if (is_enum_like_name(t, s.structs)) { return true; }
    if (iife_borrowable_array_result(t, s)) { return true; }
    if (tuple_elems_lowerable(t, s.structs)) { return true; }
    return false;
}

// iife_tuple_lit_tags builds the comma-joined element TAGS (mark_tuple_elems form)
// for a tuple LITERAL `(e0, e1, ...)`, classifying each element with elem_type_tag —
// the same encoding the `var t = (..)` binding path records. "" for a non-tuple.
function iife_tuple_lit_tags(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprTuple(tlit) => {
            var enc: string = "";
            var ti: i32 = 0;
            while (ti < tlit.elements.len()) {
                if (ti > 0) { enc = enc + ","; }
                enc = enc + elem_type_tag(tlit.elements[ti], s);
                ti = ti + 1;
            }
            return enc;
        },
        _ => { return ""; }
    }
    return "";
}

// iife_arm_composite_result_type recovers the COMPOSITE RESULT TYPE of a single
// arm of a match-EXPRESSION, when the arm's tail yields a struct / nominal-enum /
// tuple value as a WHOLE (not a scalar borrow). Two shapes are recovered:
//   - a BARE bound payload returned (`V(q) => q`): the type is the variant's
//     payload FIELD TYPE (`__ev`), recovered from `s.structs` without the binding
//     in scope — mirrors iife_arm_payload_result_kind's bare case, but for the
//     composite kinds (struct / enum / tuple) instead of the scalar ones. The
//     underlying StmtMatch arm-body lowering binds the payload and stores its
//     pointer into the temp; the type names the slot for a later `p.field` /
//     `match (p)` / `p.0`.
//   - a fresh COMPOSITE construction (`N => P { x: 0 }`, `_ => Pt(1, 2)`,
//     `_ => (a, b)`): a struct literal (expr_struct_type), an enum-variant
//     construction (expr_enum_type), or a tuple literal — its type is named at the
//     constructor, so it can be read directly from the tail expression.
// iife_arr_lit_result_type names the leak-safe scalar-array type an ARRAY LITERAL
// arm tail produces (`[i]` -> "i32[]"), or "" when it is not one this temp can
// carry. Read off the first element's tag: the array literal has no declaration to
// consult, and elem_type_tag is the same recovery the tuple-element path uses. An
// EMPTY literal answers "" — there is no element to read a width from, and the
// borrowed temp must not guess one.
function iife_arr_lit_result_type(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprArray(al) => {
            if (al.elements.len() == 0) { return ""; }
            var et: string = elem_type_tag(al.elements[0], s);
            if (et == "") { return ""; }
            var at: string = et + "[]";
            if (!iife_borrowable_array_result(at, s)) { return ""; }
            return at;
        },
        _ => {}
    }
    return "";
}

// Only a composite (iife_type_is_composite) is returned; "" for a scalar / string /
// Option result, an unrecoverable shape, or a tail that isn't a return.
// Tuple results carry the comma-joined element TAGS (mark_tuple_elems form); struct
// / enum results carry the type NAME (mark_struct_type form).
function iife_arm_composite_result_type(arm: ast.MatchArm, opt_srt: string, scrut_enum: string, s: LowerState): string {
    if (arm.body.len() == 0) { return ""; }
    var last: ast.Stmt = arm.body[arm.body.len() - 1];
    var rval: ast.Expr = parser.e_unknown("");
    var have: boolean = false;
    match (last) {
        ast.StmtReturn(r) => { rval = r.value; have = true; },
        _ => {}
    }
    if (!have) { return ""; }
    // Bare bound payload returned whole: `V(q) => q`.
    match (arm.pattern) {
        ast.PatVariant(pv) => {
            match (rval) {
                ast.ExprIdent(rid) => {
                    var ft: string = iife_bound_payload_type(pv, rid.name, opt_srt, scrut_enum, s);
                    if (iife_type_is_composite(ft, s)) {
                        if (tuple_elems_lowerable(ft, s.structs) && !decl_is_struct(s.structs, ft) && !is_enum_like_name(ft, s.structs)) { return tuple_elem_tags(ft); }
                        return ft;
                    }
                    return "";
                },
                _ => {}
            }
        },
        _ => {}
    }
    // Fresh composite construction in the arm tail: a struct literal, an enum
    // variant construction, a tuple literal, or an ARRAY literal. The type is
    // named at the constructor, so it's recoverable WITHOUT any payload binding
    // in scope.
    match (rval) {
        ast.ExprTuple(_) => {
            var tt: string = iife_tuple_lit_tags(rval, s);
            if (tt != "" && tuple_elems_lowerable("(" + tt + ")", s.structs)) { return tt; }
            return "";
        },
        // `E.B => [i]` (#7686): the fresh sibling of a borrowed array payload
        // arm. Recovered from the ELEMENT tag rather than a declaration, so a
        // mis-tag cannot miscompile — the consensus check in
        // iife_match_composite_result_type requires every arm to agree, and a
        // wrong spelling simply fails to match the payload arm's declared type
        // and bails, which is where this shape already was.
        ast.ExprArray(_) => { return iife_arr_lit_result_type(rval, s); },
        _ => {}
    }
    var st: string = expr_struct_type(rval, s);
    if (st != "" && iife_type_is_composite(st, s)) { return st; }
    var et: string = expr_enum_type(rval, s);
    if (et != "" && iife_type_is_composite(et, s)) { return et; }
    return "";
}

// iife_match_composite_result_type scans every arm of a match-EXPRESSION for a
// COMPOSITE result type and returns the consensus type — or "" if no arm yields a
// composite, or if two arms recover DIFFERENT composite types (the match isn't
// uniformly typed, so it bails). EVERY arm must agree: a struct payload from
// one arm and a constructed struct of the SAME type from the `N => P { x: 0 }` arm
// is the admitted shape; an arm that can't be classified as the consensus composite
// (a scalar tail, or a different composite) makes the whole match bail. The result is
// the mark_struct_type type name (struct / enum) or the mark_tuple_elems comma-joined
// tags (tuple); iife_result_is_tuple distinguishes the two.
function iife_match_composite_result_type(m: ast.StmtMatch, s: LowerState): string {
    var opt_srt: string = try_opt_type(m.scrutinee, s);
    var scrut_enum: string = expr_struct_type(m.scrutinee, s);
    var found: string = "";
    for arm in m.arms {
        var t: string = iife_arm_composite_result_type(arm, opt_srt, scrut_enum, s);
        if (t == "") {
            // An arm with no recoverable composite result — if ANY other arm DID
            // recover one, the match isn't uniformly composite-typed, so bail.
            if (found != "") { return ""; }
        } else {
            if (found != "" && found != t) { return ""; }
            found = t;
        }
    }
    return found;
}

// iife_result_is_tuple reports whether a recovered composite result type `t` is a
// TUPLE (comma-joined element tags from iife_match_composite_result_type) rather
// than a struct / enum NAME. Used to pick mark_tuple_elems vs mark_struct_type.
function iife_result_is_tuple(t: string, s: LowerState): boolean {
    if (t == "") { return false; }
    if (decl_is_struct(s.structs, t) || is_enum_like_name(t, s.structs)) { return false; }
    // An ARRAY result (#7686) is not a tuple: `"(" + "i32[]" + ")"` is a
    // perfectly lowerable ONE-element tuple spelling, so without this the array
    // temp would take mark_tuple_elems and every later read would resolve
    // against the wrong shape.
    if (iife_borrowable_array_result(t, s)) { return false; }
    return tuple_elems_lowerable("(" + t + ")", s.structs);
}

// iife_user_enum_payload_type returns a user-enum variant's single payload field
// type (`__ev`), stripping any `Enum.` qualifier. "" when the variant isn't a
// known struct (so a non-user-enum / Option scrutinee is handled elsewhere).
function iife_user_enum_payload_type(pv: ast.PatVariant, scrut_enum: string, s: LowerState): string {
    return decl_at_payload_type(s.structs, variant_arm_decl_index(pv, scrut_enum, s), 0);
}

// iife_rewrite_arm_body rewrites one match-EXPRESSION arm body so it STORES the
// arm's value into `tmp` instead of returning it: leading statements are kept
// verbatim and the TERMINAL statement is rewritten. Two terminal shapes are
// accepted:
//
//   `return E`      -> `tmp = E`
//   a nested MATCH  -> the same match with every one of ITS arm bodies rewritten
//                      by this function, recursively
//
// The nested-match case is what a NESTED PATTERN needs. The parser desugars
// `Some(Ok(n)) => n + 100` into a flat `Some($p)` arm whose body re-matches the
// payload (see ast.PatVariant's `nested` note), so the arm's terminal is a
// StmtMatch, not a return — and before this the whole match-expression bailed
// even though the identical STATEMENT-form match lowered.
//
// Returns an empty array to mean "not rewritable", which the caller turns into a
// bail. The f64 / string / i64 result guards live here so they apply at every
// depth: an arm tail whose value does not fit the temp's width must bail wherever
// it sits, not only at the top level.
function iife_rewrite_arm_body(body: ast.Stmt[], tmp: string, tslot: i32, ts: LowerState): ast.Stmt[] {
    var none: ast.Stmt[] = [];
    if (body.len() == 0) { return none; }
    var last: ast.Stmt = body[body.len() - 1];
    var tail: ast.Stmt[] = [];
    match (last) {
        ast.StmtReturn(r) => {
            if (expr_is_f64(r.value, ts) && !ts.is_f64_slot(tslot)) { return none; }
            if (expr_is_str(r.value, ts) && !ts.is_str_slot(tslot)) { return none; }
            if (infer_expr_width(r.value, ts) == 64 && !ts.is_i64_slot(tslot)) { return none; }
            tail = tail.append(ast.StmtAssign { target: tmp, value: r.value, line: 0, col: 0, target_line: 0, target_col: 0 });
        },
        ast.StmtMatch(im) => {
            var iarms: ast.MatchArm[] = [];
            var ii: i32 = 0;
            while (ii < im.arms.len()) {
                var ib: ast.Stmt[] = iife_rewrite_arm_body(im.arms[ii].body, tmp, tslot, ts);
                if (ib.len() == 0) { return none; }
                iarms = iarms.append(ast.MatchArm { pattern: im.arms[ii].pattern, body: ib, line: im.arms[ii].line, col: im.arms[ii].col, guard: im.arms[ii].guard, has_guard: im.arms[ii].has_guard, alt_cont: false });
                ii = ii + 1;
            }
            tail = tail.append(ast.StmtMatch { ...im, scrutinee: im.scrutinee, arms: iarms });
        },
        _ => { return none; }
    }
    var nb: ast.Stmt[] = [];
    var bj: i32 = 0;
    while (bj < body.len() - 1) { nb = nb.append(body[bj]); bj = bj + 1; }
    var tj: i32 = 0;
    while (tj < tail.len()) { nb = nb.append(tail[tj]); tj = tj + 1; }
    return nb;
}

function lower_iife_match(m: ast.StmtMatch, s: LowerState, force_i64: boolean): LowerState {
    var tmp: string = "$ife" + util.i32_to_string(s.locals.len());
    var ts: LowerState = s.add_local(tmp);
    var tslot: i32 = ts.slot_of(tmp);
    // A STRING-valued match-expression stores a string pointer in the temp (same
    // slot mechanics as i32); mark the temp a string so the arm tails admit
    // string results and the loaded value dispatches as a string. The first
    // arm's returned value classifies the whole match (all arms share the result
    // type). The payload-width gate below is orthogonal — a string result from
    // an i32-payload arm (`A(n) => n.to_string()`) still binds n as i32.
    if (m.arms.len() > 0 && m.arms[0].body.len() > 0) {
        // Classify by the first arm's TAIL statement (the value-producing
        // terminal) — a multi-statement arm body (block-expressions slice 1)
        // has leading statements before it, so body[0] may not be the return.
        var mfre: ast.Expr = iife_first_return_expr(m.arms[0].body[m.arms[0].body.len() - 1]);
        var many_i64: boolean = false;
        for each_arm in m.arms {
            var mj: i32 = 0;
            while (mj < each_arm.body.len()) { if (iife_any_return_i64(each_arm.body[mj], ts)) { many_i64 = true; } mj = mj + 1; }
        }
        // A BOUND enum payload read (`V(a) => a` bare, or `V(p) => p.name` /
        // `V(t) => t.0` field/element) can't be classified by expr_is_f64 /
        // iife_any_return_i64 / expr_is_str — the binding isn't in scope at classify
        // time, so the read infers as i32. Recover the result KIND from the variant's
        // payload field type (iife_payload_result_kind) so a string / i64 / f64
        // payload-derived result returns into a matching-width temp instead of
        // bailing. The bare i64/f64 case stays covered by iife_payload_result_width
        // (a subset of the kind recovery); they agree, so this is purely additive.
        var pay_w: string = iife_payload_result_width(m, ts);
        var pay_k: string = iife_payload_result_kind(m, ts);
        // A COMPOSITE result — a struct / nominal-enum / tuple value returned WHOLE
        // by every arm (a bare bound payload `V(q) => q`, q a leak-safe struct /
        // enum / tuple, and/or a fresh same-type construction `N => P { x: 0 }`).
        // The result rides one pointer slot (store_local / load_local are pointer-
        // width on every IR backend), so the i32 temp already round-trips it; the
        // type tag here only NAMES the slot so a later `p.field` / `match (p)` /
        // `p.0` resolves. Recovered from the variant payload field / constructor
        // type (iife_match_composite_result_type), not from the bare ident — the
        // binding isn't in scope yet, exactly like the scalar kind recovery above.
        var comp_ty0: string = iife_match_composite_result_type(m, ts);
        if (expr_is_f64(mfre, ts)) { ts = ts.mark_f64(tslot, true); }
        else if (many_i64 || force_i64) { ts = ts.mark_i64(tslot, true); }
        else if (pay_w == "f64" || pay_k == "f64") { ts = ts.mark_f64(tslot, true); }
        else if (pay_w == "i64" || pay_k == "i64") { ts = ts.mark_i64(tslot, true); }
        else if (expr_is_str(mfre, ts)) { ts = ts.mark_str(tslot, true); }
        else if (pay_k == "string") { ts = ts.mark_str(tslot, true); }
        else if (comp_ty0 != "") {
            // An ARRAY result (#7686) is marked BORROWED as well as typed: the
            // temp must carry the array-ness so a later `.len()` / `v[i]`
            // resolves, but one arm may hand back a payload the enum box still
            // owns while another builds a fresh buffer, and the exit sweep
            // cannot tell them apart at one slot. Borrowed opts it out of that
            // sweep, so the borrowed arm is safe and the fresh arm leaks —
            // the bargain iife_type_is_composite is built on. The element-kind
            // marks ride along so an 8-byte element reads at its own width.
            if (iife_borrowable_array_result(comp_ty0, ts)) {
                ts = ts.mark_arr(tslot, true);
                ts = ts.mark_borrowed_arr(tslot, true);
                if (is_float_array_type_name(comp_ty0)) { ts = ts.mark_f64arr(tslot, true); }
                else if (comp_ty0 == "i64[]") { ts = ts.mark_i64arr(tslot, true); }
                else if (comp_ty0 == "u32[]") { ts = ts.mark_u32(tslot, true); }
                else if (comp_ty0 == "string[]") { ts = ts.mark_strarr(tslot, true); }
                else if (is_struct_array_field_type(ts.structs, comp_ty0) || is_enum_array_field_type(ts.structs, comp_ty0)) {
                    ts = ts.mark_struct_type(tslot, slice_unchecked(comp_ty0, 0, comp_ty0.len() - 2));
                }
            }
            else if (iife_result_is_tuple(comp_ty0, ts)) { ts = ts.mark_tuple_elems(tslot, comp_ty0); }
            else { ts = ts.mark_struct_type(tslot, comp_ty0); }
        }
    }
    // A payload-binding arm (`Some(n) => n`) is admitted only when the bound
    // payload is i32, so the i32 temp stays the right width. An Option/Result
    // scrutinee's type is recovered via try_opt_type — a local/param, a
    // direct-call `f()` (opt_ret_fns), a map `.get()`, a struct field, or an
    // Option/Result-/enum-receiver method — the same resolution the underlying
    // StmtMatch path uses, so `return match (f(5)) { Ok(v) => v, Err(e) => e }`
    // (a call scrutinee) lowers instead of bailing. A user-enum payload is read
    // from the variant's `__ev` field. A non-i32 (or unresolvable) payload bails.
    var opt_srt: string = try_opt_type(m.scrutinee, ts);
    var scrut_enum: string = expr_struct_type(m.scrutinee, ts);
    // The temp is i32 unless classified f64 / i64 / string above. A nested-Option
    // payload binding is admitted only into an i32 temp, and only for an ident
    // scrutinee (see iife_payload_bindable).
    var temp_is_i32: boolean = !ts.is_f64_slot(tslot) && !ts.is_i64_slot(tslot) && !ts.is_str_slot(tslot);
    // The payload-derived result KIND ("string" / "i64" / "f64" / "") drives whether a
    // string-payload read is admissible (only into the matching string temp). Recovered
    // identically to the classification above so the gate agrees with the temp width.
    var res_kind: string = iife_payload_result_kind(m, ts);
    // The COMPOSITE result type (struct / enum tags or tuple tags, "" otherwise) —
    // recovered identically to the temp marking above. When non-"", a BARE bound
    // composite payload arm (`V(q) => q`) is admitted (its pointer stores into the
    // composite-typed temp); the underlying StmtMatch path already binds the payload
    // and produces the pointer. Constructor arms (`N => P { x: 0 }`) pass the scalar
    // guards below unchanged.
    var comp_ty: string = iife_match_composite_result_type(m, ts);
    var scrut_is_ident: boolean = false;
    match (m.scrutinee) {
        ast.ExprIdent(sidc) => { scrut_is_ident = true; },
        _ => {}
    }
    var newarms: ast.MatchArm[] = [];
    for arm in m.arms {
        match (arm.pattern) {
            ast.PatVariant(pv) => {
                if (pv.extra_bindings.len() > 0) {
                    // A MULTI-payload user-enum variant arm (`Pair(a, b) => a + b`):
                    // admit when every bound payload is admissible (i32, or a leak-safe
                    // scalar array bound borrow-only) and — for an i32-result temp —
                    // the result is i32. An i64 / f64 payload returned DIRECTLY
                    // (`Pair(a, b) => a`, a i64) is admitted into the matching-width
                    // temp classified above. The underlying StmtMatch path binds
                    // __ev / __ev1… at width (#3193).
                    if (!iife_enum_payloads_bindable(pv, arm, scrut_enum, ts)) { return s.fail(); }
                } else if (pv.binding.len() > 0 && pv.binding != "_") {
                    // Single payload binding: an i32 payload (`tmp = n` is an i32
                    // store), a nested-Option payload into an i32 temp (bound via the
                    // underlying StmtMatch path, consumed by an inner match), an i64 /
                    // f64 payload returned directly into the matching-width temp, or a
                    // leak-safe scalar array payload bound and read as a BORROW
                    // (`V(xs) => xs[0]` / `.len()`) — never the array returned bare.
                    // A BARE COMPOSITE payload returned whole (`V(q) => q`, q a leak-
                    // safe struct / nominal enum / tuple) is admitted when the match's
                    // composite result type is recovered (comp_ty) and THIS arm's bare
                    // payload IS that composite — its pointer stores into the composite-
                    // typed temp. The underlying StmtMatch path binds the payload and
                    // produces the pointer; the iife_payload_bindable gate (which only
                    // admits a BORROW read of a struct/enum payload, not a bare return)
                    // would otherwise reject it.
                    if (!iife_payload_bindable(pv, arm, opt_srt, scrut_enum, temp_is_i32, scrut_is_ident, res_kind, ts)
                        && !(comp_ty != "" && iife_arm_composite_result_type(arm, opt_srt, scrut_enum, ts) == comp_ty)) { return s.fail(); }
                }
            },
            _ => {}
        }
        // A multi-statement arm body (block-expressions slice 1: leading
        // statements before a value-producing terminal) is admitted — the
        // leading statements lower unchanged in the rewritten arm; only the
        // FINAL `return E` becomes `tmp = E`. A single-expr arm is the
        // len()==1 case of this (no leading statements). An empty body bails.
        // The terminal-statement rewrite (`return E` -> `tmp = E`, or a nested
        // match rewritten one level down) plus its width guards live in
        // iife_rewrite_arm_body, so they apply at every nesting depth. An empty
        // result means the shape is not rewritable.
        var nbody: ast.Stmt[] = iife_rewrite_arm_body(arm.body, tmp, tslot, ts);
        if (nbody.len() == 0) { return s.fail(); }
        newarms = newarms.append(ast.MatchArm { ...arm, body: nbody });
    }
    var newmatch: ast.Stmt = ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: newarms };
    var ls: LowerState = lower_stmt(newmatch, ts);
    if (!ls.ok) { return ls; }
    return ls.emit(ir.op_load_local(tslot));
}

// lower_value_if lowers an if-expression's desugared StmtIf as a void `if` that
// STORES each branch's value into tslot (instead of returning it from the
// enclosing function). Both branches are value tails (lower_value_tail); the
// else is required (an if-expression always has one).
function lower_value_if(iff: ast.StmtIf, tslot: i32, s: LowerState): LowerState {
    if (iff.else_body.len() == 0) { return s.fail(); }
    var cs: LowerState = lower_expr(iff.cond, s);
    if (!cs.ok) { return cs; }
    cs = cs.emit(ir.op_if(0));
    cs = lower_value_tail(iff.then_body, tslot, cs);
    if (!cs.ok) { return cs; }
    cs = cs.emit(ir.op_else());
    cs = lower_value_tail(iff.else_body, tslot, cs);
    if (!cs.ok) { return cs; }
    return cs.emit(ir.op_end());
}

// lower_value_tail lowers an if-expression branch whose last statement produces
// the value: any leading statements lower normally, then the terminal
// `return E` becomes `store tslot = E`, or a nested `else if` recurses through
// lower_value_if. Only an i32 result inlines into the i32 temp — an f64 /
// string / i64-width value bails.
function lower_value_tail(body: ast.Stmt[], tslot: i32, s: LowerState): LowerState {
    if (body.len() == 0) { return s.fail(); }
    var cs: LowerState = s;
    var i: i32 = 0;
    while (i < body.len() - 1) {
        cs = lower_stmt(body[i], cs);
        if (!cs.ok) { return cs; }
        i = i + 1;
    }
    var last: ast.Stmt = body[body.len() - 1];
    match (last) {
        ast.StmtReturn(r) => {
            // An f64 result is admitted into an f64 temp (an f64-valued if-expr —
            // lower_iife marked the temp); the 8-byte store/load is steered by the
            // temp's f64 slot type. An f64 into a non-f64 temp still bails.
            if (expr_is_f64(r.value, cs)) {
                if (!cs.is_f64_slot(tslot)) { return s.fail(); }
                cs = lower_expr(r.value, cs);
                if (!cs.ok) { return cs; }
                return cs.emit(ir.op_store_local(tslot));
            }
            // An i64 result is admitted into an i64 temp (lower_iife marked it for
            // an i64-width if-expr); lower_i64 widens each branch value (so a small
            // literal branch becomes a full i64) and the 8-byte store is steered by
            // the temp's i64 slot type.
            if (cs.is_i64_slot(tslot)) {
                cs = lower_i64(r.value, cs);
                if (!cs.ok) { return cs; }
                return cs.emit(ir.op_store_local(tslot));
            }
            // A string result is admitted only when the temp is a STRING temp
            // (a string-valued if/match-expression — lower_iife marked it); the
            // pointer store/load is otherwise identical to the i32 path. A string
            // value into an i32 temp (a type error / unexpected shape) still bails.
            if (expr_is_str(r.value, cs) && !cs.is_str_slot(tslot)) { return s.fail(); }
            if (infer_expr_width(r.value, cs) == 64) { return s.fail(); }
            cs = lower_expr(r.value, cs);
            if (!cs.ok) { return cs; }
            return cs.emit(ir.op_store_local(tslot));
        },
        ast.StmtIf(nested) => {
            return lower_value_if(nested, tslot, cs);
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// discardable_scalar_arr_lit reports whether an array literal is a fresh
// SCALAR-element buffer (i32 / i64 / f64 / boolean elements — no string /
// string-array / nested-array / struct element), so a bare discarded
// `[e0, e1, …];` statement can release its box in place: the literal is a
// rc=1 sole owner (never bound / aliased), its buffer is single-level (scalar
// elements need no deep-drop), and __fern_rc_dec is rc-guarded, so this frees
// exactly the freshly-allocated buffer. Excludes pointer-element arrays (their
// buffers hold rc payloads a shallow box dec would leak — a later cut) to keep
// the discarded-temp reclaim (statement-temporary reclamation, stage a) a
// COMPLETE, no-leak reclaim. String / struct / enum elements bail to the plain
// leak-on-drop, exactly as before.
function discardable_scalar_arr_lit(arr: ast.ExprArray, s: LowerState): boolean {
    if (arr.elements.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < arr.elements.len()) {
        if (!expr_scalar_leaf(arr.elements[i], s)) { return false; }
        i = i + 1;
    }
    return true;
}

// append_temp_is_scalar_arr reports whether a call ARGUMENT is `recv.append(v)`
// with a flat SCALAR element — the #6501 "consumed by a borrowing call" shape,
// where nothing outlives the statement to own the appended array and the only
// place it can be released is the call site.
//
// One post-call __fern_rc_dec is right for BOTH of __fern_arr_push_grow's
// outcomes, which is why this needs no is_unique test of its own: the copy path
// hands back a fresh buffer at rc 1, which the dec frees, and the in-place path
// bumps the receiver to rc 2 before handing it back, which the dec nets down to
// the one reference the receiver already had.
//
// SCALAR elements only, exactly as the literal arm above. The grow's copy path
// memcpys elements WITHOUT retaining them, so a pointer-element copy's elements
// alias the original's and the deep per-element release such a buffer earns
// would free them out from under the receiver. Those keep today's safe leak.
function append_temp_is_scalar_arr(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "append" || c.args.len() != 1) { return false; }
                    if (!expr_is_arr_src(fa.obj, s)) { return false; }
                    if (expr_is_strarr(fa.obj, s)) { return false; }
                    return expr_scalar_leaf(c.args[0], s);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// discardable_fresh_strarr_lit reports whether a discarded `["a"+x, "b"+y, …];`
// is a FRESH string[] literal whose every element is a fresh, sole-owned heap
// string (a concat / fresh-producer call — expr_is_fresh_str). A discarded bare
// scalar-element array releases only its buffer (discardable_scalar_arr_lit); a
// pointer-element array needs a DEEP free that also releases every element box,
// or it leaks the element buffers every loop iteration (unbounded). Because each
// element is proven fresh the buffer sole-owns it at rc=1, so the element-walking
// __fern_str_arr_free (rc==1-gated per-element __fern_str_free, then the buffer —
// the exact release the exit sweep gives a reclaimable string[] LOCAL, #4355) is
// a COMPLETE, no-leak, no-double-free reclaim. A BORROWED element (bare ident /
// field / index read) is excluded — it aliases an owner the exit sweep also
// frees, so a deep free here would double-free; such a literal keeps leaking on
// the plain drop (safe-leak floor). Pure `.rodata` string literals are excluded
// too (expr_is_fresh_str is false for them): their element boxes are immortal, so
// only the buffer would need reclaim — a later cut.
function discardable_fresh_strarr_lit(arr: ast.ExprArray, s: LowerState): boolean {
    if (arr.elements.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < arr.elements.len()) {
        if (!expr_is_fresh_str(arr.elements[i], s)) { return false; }
        i = i + 1;
    }
    return true;
}

// discardable_scalar_arrarr_lit reports whether a discarded `[[e..], [e..], …];`
// is a FRESH array-of-arrays literal whose every element is itself a DIRECT
// scalar-element array LITERAL (`[i, i+1]` — each inner buffer sole-owned at
// rc=1, its elements value-copied scalars). Such a shape (the outer buffer
// holds rc-headered inner buffers) leaks the inner buffers AND the outer on a
// plain drop — the shallow scalar path frees only the outer box, orphaning
// every inner (unbounded in a hot loop; native bounds it). __fern_arrarr_free
// releases it whole: one rc-guarded arr_dec per inner buffer (scalar inners are
// fully reclaimed by a single dec — elements ride the freed buffer), then the
// outer buffer. A bare-ident inner (`[[9], row]`) is EXCLUDED — it aliases a
// live local the exit sweep also frees, so a deep free here would double-free;
// such a literal keeps leaking-safe on the plain drop. String / struct / nested
// deeper inners are excluded too (a first cut to scalar-element inners) — the
// discarded-statement sibling of the ARRARR: loop-local reclaim.
function discardable_scalar_arrarr_lit(arr: ast.ExprArray, s: LowerState): boolean {
    if (arr.elements.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < arr.elements.len()) {
        match (arr.elements[i]) {
            ast.ExprArray(inner) => {
                if (!discardable_scalar_arr_lit(inner, s)) { return false; }
            },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// expr_scalar_leaf reports whether `e` produces a flat SCALAR value (i32 / i64 /
// f64 / boolean) rather than a heap pointer — not a string, string-array, array,
// or struct. Gates a discarded array / tuple literal's in-place box release: a
// scalar-only box is single-level, so a shallow __fern_rc_dec fully reclaims it.
function expr_scalar_leaf(e: ast.Expr, s: LowerState): boolean {
    // A TUPLE is a heap pointer (an rc-headered box), not a flat scalar — its
    // box + any pointer elements need a deep drop, so it must NOT ride the
    // shallow scalar-tuple / scalar-array discard (which would leak the inner
    // box). expr_is_arr_src / expr_is_str already exclude arrays / strings;
    // tuples slipped through because none of those match (#4365 nested-tuple).
    return !expr_is_str(e, s) && !expr_is_strarr(e, s) && !expr_is_arr_src(e, s) && !expr_is_tuple(e, s) && expr_struct_type(e, s) == "";
}

// discardable_scalar_tuple_lit is the tuple analogue of discardable_scalar_arr_lit:
// a discarded `(e0, e1, …);` whose elements are all scalar. A tuple box is a rc=1
// sole owner with a single-level scalar payload, so the shallow __fern_rc_dec
// fully reclaims it.
function discardable_scalar_tuple_lit(tup: ast.ExprTuple, s: LowerState): boolean {
    if (tup.elements.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < tup.elements.len()) {
        if (!expr_scalar_leaf(tup.elements[i], s)) { return false; }
        i = i + 1;
    }
    return true;
}

// struct_lit_all_scalar reports whether every field of struct `name` is a flat
// scalar — so a discarded fresh `T { … };` box is single-level and a shallow
// __fern_rc_dec fully reclaims it (no rc-field deep-drop needed). Structs with
// array / string / nested-struct fields bail (their box dec would leave the
// field payloads on the safe-leak floor — a later cut using __struct_drop).
function struct_lit_all_scalar(structs: parser.StructDecl[], name: string): boolean {
    var nf: i32 = decl_field_count(structs, name);
    if (nf == 0) { return false; }
    var fi: i32 = 0;
    while (fi < nf) {
        if (!reuse_field_is_scalar(decl_field_type_at(structs, name, fi))) { return false; }
        fi = fi + 1;
    }
    return true;
}

// --- static aggregate constants (#6149) --------------------------------------
//
// `TypeI32 { is_char: false, width: 32, unsigned: false }` is a compile-time
// constant, and the checker's nullary type constructors return one per call —
// ~21% of every allocation the compiler makes, each box leaked (the run frees
// 2,228 of 5,947). Recognised here and lowered to op_const_struct, which the
// backends place in static data instead of allocating.
//
// Slice 1's admission is deliberately narrow: a NO-BASE literal of a declared
// struct / variant whose every DECLARED field is an i32-width scalar and whose
// value is a literal of that kind. Wider fields (i64 / f64), strings and nested
// aggregates need more than the one word per field the backends emit for this
// op, so they stay on struct_make.

// const_agg_scalar_field reports whether a DECLARED field type is one this slice
// can place statically: an i32-width scalar. `struct_field_width` returns 64 for
// exactly the wide kinds, which is the same classifier struct_make's field
// stores use, so admitting `width == 0` cannot disagree with the box layout.
function const_agg_scalar_field(structs: parser.StructDecl[], name: string, idx: i32): boolean {
    if (struct_field_width(structs, name, idx) != 0) { return false; }
    var t: string = decl_field_type_at(structs, name, idx);
    return t == "i32" || t == "u32" || t == "boolean" || t == "char" || t == "u8";
}

// const_agg_lit_value renders a scalar-literal expression as the word text the
// backends splice into their data directive, or returns ok=false when the
// expression is not one. The literal's SOURCE TEXT is carried, not a parsed
// integer — the same contract op_const_i32_text keeps, so a hex literal reaches
// the assembler intact instead of being zeroed by a decimal-only parse.
// Booleans render as the 1/0 words struct_make would have stored; a unary minus
// over a number literal is admitted so a negative field constant is not pushed
// off the path.
struct ConstAggWord { ok: boolean, text: string }

function const_agg_lit_value(e: ast.Expr): ConstAggWord {
    var bad: ConstAggWord = ConstAggWord { ok: false, text: "" };
    match (e) {
        ast.ExprNumber(n) => {
            if (n.is_float || n.suffix.len() > 0) { return bad; }
            return ConstAggWord { ok: true, text: n.text };
        },
        ast.ExprBool(b) => {
            if (b.value) { return ConstAggWord { ok: true, text: "1" }; }
            return ConstAggWord { ok: true, text: "0" };
        },
        ast.ExprUnary(u) => {
            if (u.op != "-") { return bad; }
            var inner: ConstAggWord = const_agg_lit_value(u.operand);
            if (!inner.ok) { return bad; }
            return ConstAggWord { ok: true, text: "-" + inner.text };
        },
        _ => { return bad; },
    }
    return bad;
}

// const_agg_of packs a struct literal's decl-ordered field words when every one
// of them is a compile-time scalar literal. ok=false leaves the literal on the
// ordinary struct_make path.
struct ConstAgg { ok: boolean, values: string }

function const_agg_of(slit: ast.ExprStructLit, structs: parser.StructDecl[]): ConstAgg {
    var bad: ConstAgg = ConstAgg { ok: false, values: "" };
    if (slit.has_base) { return bad; }
    if (!decl_is_struct(structs, slit.type_name)) { return bad; }
    var ndecl: i32 = decl_field_count(structs, slit.type_name);
    var out: string = "";
    var di: i32 = 0;
    while (di < ndecl) {
        if (!const_agg_scalar_field(structs, slit.type_name, di)) { return bad; }
        var fname: string = decl_field_name_at(structs, slit.type_name, di);
        var found: i32 = 0 - 1;
        var fj: i32 = 0;
        while (fj < slit.field_names.len()) {
            if (slit.field_names[fj] == fname) { found = fj; }
            fj = fj + 1;
        }
        if (found < 0) { return bad; }   // a no-base literal must set every field
        var w: ConstAggWord = const_agg_lit_value(slit.field_values[found]);
        if (!w.ok) { return bad; }
        if (di > 0) { out = out + ","; }
        out = out + w.text;
        di = di + 1;
    }
    return ConstAgg { ok: true, values: out };
}

// lower_stmt lowers one top-level statement of the i32 subset.
// lower_stmt wraps lower_stmt_inner with the #4873 grow-exempt window: the
// statement's dying call args (grow_exempt_names_of_stmt) are visible to the
// call-site bracket only while THIS statement lowers.
pub function lower_stmt(st: ast.Stmt, s: LowerState): LowerState {
    var r: LowerState = lower_stmt_grow_exempt(st, s);
    if (r.ok) { return r; }
    return r.note_fail(stmt_bail_tag(st));
}

function lower_stmt_grow_exempt(st: ast.Stmt, s: LowerState): LowerState {
    var gex: string[] = grow_exempt_names_of_stmt(st);
    // #6048: fold in the per-function sole-occurrence deaths. Safe to add to every
    // statement — the name occurs exactly once in the whole body, so only the
    // statement holding that occurrence has a call bracket that can read it.
    var gi: i32 = 0;
    while (gi < s.grow_sole.len()) { gex = push_str_unique(gex, s.grow_sole[gi]); gi = gi + 1; }
    if (gex.len() == 0) { return lower_stmt_inner(st, s); }
    var gr: LowerState = lower_stmt_inner(st, s.with_grow_exempt(gex));
    var gnone: string[] = [];
    return gr.with_grow_exempt(gnone);
}

function lower_stmt_inner(st: ast.Stmt, s: LowerState): LowerState {
    if (!s.ok) { return s; }
    match (st) {
        ast.StmtVar(v) =>{
            var sv: LowerState = lower_stmt_var(v, s);
            sv = seed_snapshot_local(v, sv);
            return release_last_use_source(v, sv);
        },
        ast.StmtAssign(a) =>{ return lower_stmt_assign(a, s); },
        ast.StmtReturn(r) => {
            // A bare `return;` in a VOID function — parse_expr yields an
            // ExprUnknown for the missing value, which lower_expr can't lower (so
            // the whole module bailed to AST; every void helper with an early
            // `return;` was affected). op_return pops a result into the result reg,
            // so emit a dummy 0 (harmless — a void caller ignores it) after the exit
            // dec-sweep, mirroring `return 0`. Only reachable in a void function
            // (the checker rejects a value-less return where a value is required).
            var ret_is_bare: boolean = false;
            match (r.value) {
                ast.ExprUnknown(_) => { ret_is_bare = true; },
                _ => {}
            }
            if (ret_is_bare) {
                var bs: LowerState = s.emit(ir.op_const_i32(0));
                bs = emit_consumed_param_exit(bs, r.value, false);
                bs = emit_dec_sweep_except(bs, 0 - 1);
                return bs.emit(ir.op_return());
            }
            // `return T { ...p, f: v }` over an `own` struct param admitted for
            // in-place update (own_update_params_of): reuse p's box through the
            // same emitter as the self-assign form, binding the result to a
            // hidden local the sweep keeps, then hand it back.
            match (r.value) {
                ast.ExprStructLit(rsl) => {
                    if (rsl.has_base) {
                        var rbn: string = ident_name_or_empty(rsl.base);
                        if (rbn.len() > 0 && s.is_own_param(rbn) && s.is_self_assign_reuse_name(rbn)
                            && sa_is_self_update(r.value, rbn, rsl.type_name)) {
                            var rname: string = "$ownret" + util.i32_to_string(s.locals.len());
                            var ro: LowerState = emit_self_overwrite_reuse(rname, "", r.value, rbn, false, s, true);
                            if (!ro.ok) { return ro; }
                            var rslot: i32 = ro.slot_of(rname);
                            ro = ro.emit(ir.op_load_local(rslot));
                            ro = emit_dec_sweep_except(ro, rslot);
                            return ro.emit(ir.op_return());
                        }
                    }
                },
                _ => {}
            }
            // i64-returning function: lower the value as an i64, run the exit
            // dec-sweep over array locals (no moved array — i64 isn't one), then
            // return. The wasm sig declares (result i64); x86/arm64 are unchanged.
            if (s.ret_is_i64) {
                var ri: LowerState = lower_i64(r.value, s);
                if (!ri.ok) { return ri; }
                ri = emit_dec_sweep_except(ri, 0 - 1);
                return ri.emit(ir.op_return());
            }
            // i64[]-returning function returning a bare array LITERAL: the
            // elements aren't self-evidently i64, so lower each via lower_i64 and
            // build the array with arr_make_i64 (8-byte i64 stride). The fresh
            // array is returned (moved to the caller); it isn't a local, so the
            // exit dec-sweep over array locals doesn't touch it. `return a` (an
            // i64-array local) falls through to the generic move-on-return path.
            if (s.ret_i64arr()) {
                var rlit: boolean = false;
                match (r.value) {
                    ast.ExprArray(_) => { rlit = true; },
                    _ => {}
                }
                if (rlit) {
                    match (r.value) {
                        ast.ExprArray(rarr) => {
                            var ra: LowerState = s;
                            var rae: i32 = 0;
                            while (rae < rarr.elements.len()) {
                                ra = lower_i64(rarr.elements[rae], ra);
                                if (!ra.ok) { return ra; }
                                rae = rae + 1;
                            }
                            ra = ra.emit(ir.op_arr_make_i64(rarr.elements.len()));
                            ra = emit_dec_sweep_except(ra, 0 - 1);
                            return ra.emit(ir.op_return());
                        },
                        _ => {}
                    }
                }
            }
            // `return <expr>` from a SCALAR `dyn Trait`-returning function: the
            // value coerces to `dyn Trait` via lower_dyn_arg — a primitive/string
            // is heap-boxed via op_dyn_box (so it carries a shape pointer the
            // caller's dispatch can read), a struct/enum flows unboxed
            // (docs/DYN-TRAITS.md §4.3). The returned value is not a local array,
            // so the exit dec-sweep over array locals leaves it alone.
            if (s.ret_dyn()) {
                var rds: LowerState = lower_dyn_arg(r.value, s);
                if (!rds.ok) { return rds; }
                rds = emit_dec_sweep_except(rds, 0 - 1);
                return rds.emit(ir.op_return());
            }
            // #5464: a bare-typevar-RETURN pass-through fn returns i64 on wasm —
            // the uniform 8-byte slot the register backends give every value (the
            // wasm sig declares (result i64), see emit_function_ir). The returned
            // value is an erased (i64-typed) local or another erased call's result,
            // so lower it full-width and return it; the caller narrows the i64
            // result to the concrete type. Without this the i64-width guard below
            // would bail the erased return (its ret_type isn't literally "i64").
            // Register backends never set for_wasm — their 8-byte return slot needs
            // no widening, so they take the generic path below unchanged.
            if (s.for_wasm() && s.erased_passthrough() && is_erased_typevar(s.cur_ret, s.structs)) {
                var rerw: LowerState = lower_i64(r.value, s);
                if (!rerw.ok) { return rerw; }
                rerw = emit_dec_sweep_except(rerw, 0 - 1);
                return rerw.emit(ir.op_return());
            }
            // An i64 value returned from a non-i64 function is a width mismatch
            // the checker rejects; guard anyway so a stray i64 never lands in an
            // i32 return slot. A u64[] ARRAY ident reports width 64 via the
            // overloaded is_u64 flag (scalar u64 and u64[] share it), but an array
            // return is a pointer MOVE, not a scalar — exclude array values so
            // `return <u64[]>` (e.g. a u64[]-returning sort) reaches the move-on-return path
            // instead of bailing. (i64[] uses the separate is_i64arr flag, so it
            // already reports width 32 here.)
            var ret_val_is_arr: boolean = false;
            match (r.value) {
                ast.ExprIdent(rvid) => { ret_val_is_arr = s.is_arr_slot(s.slot_of(rvid.name)); },
                _ => {}
            }
            if (!ret_val_is_arr && infer_expr_width(r.value, s) == 64) { return s.fail(); }
            // `return Ok(x)/Some(x)/Err(x)` with an i64/u64 DECLARED payload: build
            // the 8-byte box the consumers read, even when the argument only infers
            // i32 (a bare literal `Ok(40)` or i32 var). The expected payload type
            // comes from THIS function's Option/Result return type (cur_fn), so it
            // is sound here (unlike a bare construction in an unknown context). Other
            // payloads fall through to the generic lower_expr below unchanged.
            match (r.value) {
                ast.ExprCall(rc) => {
                    match (rc.callee) {
                        ast.ExprIdent(rcid) => {
                            if (rc.args.len() == 1 && (rcid.name == "Ok" || rcid.name == "Some" || rcid.name == "Err")) {
                                var rrt: string = s.opt_ret_type(s.cur_fn);
                                if (rrt.len() >= 8 && (slice_unchecked(rrt, 0, 7) == "Result[" || slice_unchecked(rrt, 0, 7) == "Option[")) {
                                    var rvar: string = "Ok";
                                    var rtag: i32 = 0;
                                    if (rcid.name == "Err") { rvar = "Err"; rtag = 1; }
                                    var rexp: string = opt_payload_type(rrt, rvar);
                                    if (rexp == "i64" || rexp == "u64") {
                                        var rcs: LowerState = lower_opt_make_payload_exp(rtag, rc.args[0], rexp, s);
                                        if (!rcs.ok) { return rcs; }
                                        rcs = emit_dec_sweep_except(rcs, 0 - 1);
                                        return rcs.emit(ir.op_return());
                                    }
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            // Returning a SCALAR-element array struct field (`return h.items`)
            // aliases it out to the caller, who will own it. Lower it via the IR
            // with a Perceus dup (RC-frontier slice 2): lower_expr emits struct_get
            // (the array pointer on the operand stack); __fern_rc_inc retains it so
            // the ESCAPING return is a counted reference (the helper pops + re-pushes
            // the same pointer, so it stays on top for op_return). We do NOT move-out
            // the field (`moved` stays -1): the struct still owns its field. Balance
            // — if `h` is a BORROWED param, its box/field are never swept, the inc
            // simply hands the caller its own counted ref (field rc N →inc N+1
            // →caller decs N); if `h` is a fresh RECLAIMABLE local, the exit sweep's
            // struct field-drop decs the field (array rc 1 →inc 2 →field-drop 1
            // →caller decs 0). Sound either way (never under-frees).
            var rfft: string = scalar_arr_field_type(r.value, s);
            if (rfft != "") {
                var rfs: LowerState = lower_expr(r.value, s);   // struct_get -> array ptr on stack
                if (!rfs.ok) { return rfs; }
                rfs = rfs.retain_tos("ret-field");
                rfs = emit_dec_sweep_except(rfs, 0 - 1);   // field NOT moved out; struct keeps its ref
                return rfs.emit(ir.op_return());
            }
            // Returning an ARRAY-OF-STRUCT field (`return h.params`), an ARRAY-OF-
            // ENUM field (`return h.args`, args: Expr[]) or a STRING-ARRAY field
            // (`return h.xs`, xs: string[]) aliases it out to the caller exactly like
            // the scalar case above — the Perceus dup is on the buffer POINTER
            // (element-type-agnostic), and NO deep-drop recursion is involved: the
            // struct keeps owning the elements, the caller receives a counted
            // reference to the buffer. Same balance as the scalar field return
            // (borrowed param: caller decs; reclaimable local: field-drop + caller
            // dec).
            var rsaft: string = struct_arr_field_read_type(r.value, s);
            if (rsaft == "") { rsaft = enum_arr_field_read_type(r.value, s); }
            if (rsaft == "") { rsaft = strarr_field_read_type(r.value, s); }
            if (rsaft != "") {
                var rss: LowerState = lower_expr(r.value, s);   // struct_get -> array ptr on stack
                if (!rss.ok) { return rss; }
                rss = rss.retain_tos("ret-field");
                rss = emit_dec_sweep_except(rss, 0 - 1);   // field NOT moved out; struct keeps its ref
                return rss.emit(ir.op_return());
            }
            // An enum-array field still bails: aliasing it out needs deep-drop
            // recursion (a later slice).
            if (is_scalar_arr_field_access(r.value, s)) { return s.fail(); }
            // Returning an ELEMENT of an array-of-arrays (`return seeds[i]`)
            // aliases the element out to the caller while the container keeps
            // its reference — the same escape as the struct-field returns
            // above, so it takes the same Perceus dup (native:
            // needsRcIncOnAlias's Index arm). Without the retain the caller's
            // exit sweep decs a count the container still owns, freeing the
            // element under the live container.
            if (index_read_is_arr(r.value, s)) {
                var ris: LowerState = lower_expr(r.value, s);   // element ptr on stack
                if (!ris.ok) { return ris; }
                ris = ris.emit(ir.op_call_direct("__fern_rc_inc", 1));   // return-transfer retain
                ris = emit_dec_sweep_except(ris, 0 - 1);   // element NOT moved out of the container
                return ris.emit(ir.op_return());
            }
            // Returning a TUPLE ELEMENT (`return src.1`) — native's
            // dup-at-extract (needsRcIncOnAlias's FieldAccess arm): the
            // element leaves the box to a NEW owner, so retain it before the
            // sweep. A borrowed tuple param's caller now holds the deep claim
            // TUPB admits (element rc: construction 1 -> retain 2 -> caller's
            // deep free 1 -> final owner's sweep 0); a TUPRCS local of THIS
            // frame settles its own claim in the sweep below the retain.
            // Retain-only or grant-only is measurably wrong in opposite
            // directions (rc-log 2026-08-28 elemret scoping pin) — this arm
            // and the scans' tuple_elem_ret_dup admission are one predicate
            // and MUST move together.
            if (ret_is_tuple_elem_dup(r.value, s)) {
                var rts: LowerState = lower_expr(r.value, s);   // element ptr on stack
                if (!rts.ok) { return rts; }
                rts = rts.retain_tos("ret-tuple-elem");
                rts = emit_dec_sweep_except(rts, 0 - 1);   // element NOT moved out of the container
                return rts.emit(ir.op_return());
            }
            // Returning a bare PARAM array (`return a`, a a borrowed param) —
            // the native return-transfer inc, ported (#4357 probe). The CALLER
            // binds the result as an owned move (its slot is exit-swept), but
            // the param's buffer belongs to the caller's caller: without a
            // retain the callee hands out an UNCOUNTED alias, and the two
            // sweeps over-release it (rc 1 -> 0 while the owner still holds
            // it — a use-after-free surfaced by the underflow detector on the
            // identity-return probe). Mirror the struct-field Perceus dup
            // above: retain the buffer so the escaping return is a counted
            // reference (owner's later dec frees it exactly once). Params are
            // never exit-swept, so no move-out bookkeeping is needed; a bare
            // LOCAL return stays on the move-on-return path below (its slot
            // is kept from the sweep instead).
            var rpid: string = "";
            match (r.value) {
                ast.ExprIdent(rid2) => { rpid = rid2.name; },
                _ => {}
            }
            if (rpid.len() > 0) {
                var rps: i32 = s.slot_of(rpid);
                // An `own` param is EXCLUDED: the caller moved its reference in,
                // so returning it moves that same reference back out and there is
                // no second owner to count. Retaining it anyway ratcheted the
                // buffer's rc to 2 permanently, which disabled __fern_arr_push's
                // in-place fast path (it requires rc == 1) — so every push copied
                // the whole array AND the pre-grow buffer never reached rc 0.
                // A threaded accumulator (`buf = le32(buf, w)`, the shape every
                // emitter is written in) cost O(n^2) time and unbounded memory:
                // measured 7 GB and arena exhaustion for 40k appends, against
                // 1 MB for the same appends written inline. The caller's
                // overwrite release is already pointer-guarded (`if old != new
                // then arr_dec(old)`), so dropping the retain leaves the buffer
                // freed exactly once on the grow path and untouched in place.
                if (rps >= 0 && rps < s.n_params && s.is_arr_slot(rps)) {
                    var rpl: LowerState = lower_expr(r.value, s);
                    if (!rpl.ok) { return rpl; }
                    var rpfl: i32 = s.ownflag_slot_of(rps);
                    if (!s.is_own_param(rpid)) {
                        if (rpfl >= 0) {
                            // A consumed-threaded param (ownflag_name) is the
                            // caller's only while its flag is 0; a buffer this
                            // frame owns is handed over as it stands.
                            rpl = rpl.emit(ir.op_load_local(rpfl));
                            rpl = rpl.emit(ir.op_const_i32(0));
                            rpl = rpl.emit(ir.op_bin("eq", 0, false));
                            rpl = rpl.emit(ir.op_if(0));
                            rpl = rpl.retain(rps, "ret-borrowed-param");
                            rpl = rpl.emit(ir.op_end());
                        } else {
                            rpl = rpl.retain_tos("ret-borrowed-param");
                        }
                    }
                    rpl = emit_consumed_param_exit(rpl, r.value, true);
                    rpl = emit_dec_sweep_except(rpl, 0 - 1);
                    return rpl.emit(ir.op_return());
                }
                // A match-arm binding of an ARRAY payload borrows the enum
                // box's buffer (mark_borrowed_arr): the box keeps its
                // reference and the binding is never swept, so the escaping
                // return takes the same transfer retain as a borrowed param.
                //
                // EXCEPT when the binding already IS that reference (moved_claim,
                // #8070): the box is one this frame built, so there is no claim
                // left to count against — the consuming match's moved-payload
                // skip hands this field over and the pending deep drop
                // emit_dec_sweep_except runs omits its dec. The skip and this
                // retain are one pairing, alternatives and never both; retaining
                // on top strands the buffer, since the caller's dec then lands on
                // the extra claim instead of on zero. Such a return falls through
                // to the move-on-return path below.
                if (rps >= s.n_params && s.is_borrowed_arr_slot(rps) && !s.is_moved_claim_slot(rps)) {
                    var rbl: LowerState = lower_expr(r.value, s);
                    if (!rbl.ok) { return rbl; }
                    rbl = rbl.retain_tos("ret-borrowed-binding");
                    rbl = emit_dec_sweep_except(rbl, 0 - 1);
                    return rbl.emit(ir.op_return());
                }
            }
            var se: LowerState = lower_expr(r.value, s);
            if (!se.ok) { return se; }
            se = tail_release_snapshot_locals(r.value, se);
            // Perceus move-on-return: any array local the returned value MOVES out
            // (a bare array local, an `.append` receiver, or an array under a
            // returned enum / struct-enum-field — see returned_moved_arr_slots) is
            // excluded from the exit dec-sweep so it isn't freed (the return-inc the
            // caller would owe and this dec cancel; here there is no return-inc, so
            // eliding the dec is the whole move). #3720: a `return Many(a)` over a
            // local array `a` previously freed `a` here while the returned box still
            // referenced it. Everything else is released as usual.
            var moved_slots: i32[] = returned_moved_arr_slots(r.value, se, []);
            se = emit_consumed_param_exit(se, r.value, true);
            se = emit_dec_sweep_except_list(se, moved_slots);
            return se.emit(ir.op_return());
        },
        ast.StmtIf(iff) => {
            // Structured control flow, wasm-style: <cond> if <then> [else
            // <else>] end. The operand stack is empty at block boundaries
            // (statements balance it; `if` consumes the cond), so branches
            // never carry operand-stack values — the backend lowering stays
            // clean. NOTE: locals declared inside a branch keep their slots
            // (no block-scoped reuse yet); a later slice can pop them.
            // An i64 condition (truthiness on an i64) isn't lowered — bail. A
            // comparison of i64 operands infers i32, so `if (a < b)` is fine.
            if (infer_expr_width(iff.cond, s) == 64) { return s.fail(); }
            var sc: LowerState = lower_expr(iff.cond, s);
            if (!sc.ok) { return sc; }
            var s1: LowerState = sc.emit(ir.op_if(0));
            // `if (__dfa<i>)` is lower_defers_func's replay of one defer action.
            // Name it while the then-body lowers, so a reference to a local whose
            // block has since been retired resolves through the recorded alias
            // (#6821). The cond itself lowered above, under the outer guard.
            var dfg: string = defer_replay_flag(iff.cond);
            var dfg_prev: string = s1.defer_guard;
            if (dfg.len() > 0) { s1 = s1.with_defer_guard(dfg); }
            var s2: LowerState = lower_block(iff.then_body, s1);
            if (!s2.ok) { return s2; }
            // Restore only when it was set — an ordinary `if` must not pay a
            // LowerState rebuild for a field it never touched.
            if (dfg.len() > 0) { s2 = s2.with_defer_guard(dfg_prev); }
            if (iff.else_body.len() > 0) {
                var s3: LowerState = s2.emit(ir.op_else());
                var s4: LowerState = lower_block(iff.else_body, s3);
                if (!s4.ok) { return s4; }
                return s4.emit(ir.op_end());
            }
            return s2.emit(ir.op_end());
        },
        ast.StmtWhile(wh) => {
            // Canonical wasm loop shape:
            //   block              ; depth 1 = exit target
            //     loop             ; depth 0 = continue (header)
            //       <cond> not     ; !cond
            //       br_if 1        ; exit the block when !cond
            //       <body>
            //       br 0           ; back to the loop header
            //     end
            //   end
            if (infer_expr_width(wh.cond, s) == 64) { return s.fail(); }
            var w1: LowerState = s.emit(ir.op_block(0)).enter_loop();
            var w2: LowerState = w1.emit(ir.op_loop(0));
            var w3: LowerState = lower_expr(wh.cond, w2);
            if (!w3.ok) { return w3; }
            var w4: LowerState = w3.emit(ir.op_bin("not", 0, false));
            var w5: LowerState = w4.emit(ir.op_brif(1));
            var w6: LowerState = lower_block(wh.body, w5);
            if (!w6.ok) { return w6; }
            var w7: LowerState = w6.emit(ir.op_br(0));
            var w8: LowerState = w7.emit(ir.op_end());
            return w8.emit(ir.op_end()).exit_loop();
        },
        ast.StmtFor(fr) =>{ return lower_stmt_for(fr, s); },
        ast.StmtExpr(es) => {
            // Index-assignment `arr[i] = v` desugars to
            // __set_index(arr, idx, val) → lower base, index, value, then the
            // high-level `arr_set` op (the backend stores at its layout's
            // element address), leaving nothing on the stack.
            match (es.value) {
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprIdent(cid) => {
                            if (cid.name == "__set_index") {
                                if (c.args.len() != 3) { return s.fail(); }
                                // `a[i] = v` on an i64[]: base + index are i32, but
                                // the value is an 8-byte i64 — lower it via lower_i64
                                // and store with arr_set_i64 (i64.store on wasm).
                                if (arr_index_is_i64(c.args[0], s)) {
                                    var is64: LowerState = lower_expr(c.args[0], s);
                                    if (!is64.ok) { return is64; }
                                    is64 = lower_expr(c.args[1], is64);
                                    if (!is64.ok) { return is64; }
                                    is64 = lower_i64(c.args[2], is64);
                                    if (!is64.ok) { return is64; }
                                    return is64.emit(ir.op_arr_set_i64());
                                }
                                var ss: LowerState = lower_expr(c.args[0], s);
                                if (!ss.ok) { return ss; }
                                ss = lower_expr(c.args[1], ss);
                                if (!ss.ok) { return ss; }
                                ss = lower_expr(c.args[2], ss);
                                if (!ss.ok) { return ss; }
                                // Element width from the array slot: `a[i] = v`
                                // on an f64[] stores an 8-byte f64 (arr_set width
                                // 64 → f64.store on wasm); i32[] the 4-byte path.
                                var sw: i32 = 32;
                                if (arr_index_is_f64(c.args[0], s)) { sw = 64; }
                                return ss.emit(ir.op_arr_set(sw));
                            }
                            // Field mutation `p.x = v` desugars to
                            // __set_field(obj, "x", v). Resolve x's index in obj's
                            // tracked scalar-struct type, lower obj + val, struct_set.
                            if (cid.name == "__set_field") {
                                if (c.args.len() != 3) { return s.fail(); }
                                var fname: string = "";
                                match (c.args[1]) {
                                    ast.ExprString(fs) => { fname = fs.value; },
                                    _ => { return s.fail(); }
                                }
                                var fsty: string = expr_struct_type(c.args[0], s);
                                if (fsty == "") { return s.fail(); }
                                if (!decl_is_leaksafe(s.structs, fsty)) { return s.fail(); }
                                // An ARRAY field (scalar-element or struct-element) is
                                // mutable here, with the ownership rules the struct
                                // LITERAL path already uses for the same store:
                                //
                                //   - the new value is RETAINED when it aliases an
                                //     rc-tracked array local (`s.code = other`), so the
                                //     field's reference is counted and the exit
                                //     dec-sweep on `other` cannot free a buffer the
                                //     struct still points at. Without the retain that
                                //     is a use-after-free, which is what the AST
                                //     emitter does today — it stores bare, no inc;
                                //   - the REPLACED buffer is not released: the store
                                //     orphans it. That is the safe-leak floor this
                                //     codebase already stands on for a struct carrying
                                //     an unreclaimable field, and it is what the AST
                                //     emitter does too, so nothing regresses by
                                //     lowering here. Reclaiming it needs the
                                //     whole-program read-safety analysis #4355 built
                                //     for REPLACED STRING fields
                                //     (strfld_reclaim_ok_types_of) generalised to
                                //     arrays — a separate step, tracked in
                                //     docs/SELFHOST-AST-RETIREMENT.md.
                                //
                                // This is what used to bail, and is
                                // the first mode-0 wasm decliner: `a.code = enc(…)` in
                                // x86_native.fern.
                                var fmft: string = decl_field_type(s.structs, fsty, fname);
                                var fm_is_arr: boolean = is_leaksafe_array_field(fmft) || is_struct_array_field_type(s.structs, fmft);
                                var fidx: i32 = s.field_index_in(fsty, fname);
                                if (fidx < 0) { return s.fail(); }
                                var sf: LowerState = lower_expr(c.args[0], s);
                                if (!sf.ok) { return sf; }
                                // An i64 field stores an 8-byte i64: lower the
                                // value via lower_i64 and store with struct_set_i64
                                // (i64.store on wasm). f64 / i32 fields keep the
                                // existing struct_set(width) path.
                                if (struct_field_is_i64(s.structs, fsty, fidx)) {
                                    sf = lower_i64(c.args[2], sf);
                                    if (!sf.ok) { return sf; }
                                    return sf.emit(ir.op_struct_set_i64(fidx));
                                }
                                sf = lower_expr(c.args[2], sf);
                                if (!sf.ok) { return sf; }
                                // Array-field alias retain, mirroring the struct-lit
                                // construction inc (see the fav_alias_inc arm): a bare
                                // ident naming an rc-tracked array slot is a SECOND
                                // owner once stored. rc_inc returns its argument, so
                                // the stack shape struct_set expects is unchanged.
                                if (fm_is_arr) {
                                    match (c.args[2]) {
                                        ast.ExprIdent(svid) => {
                                            if (sf.is_arr_slot(sf.slot_of(svid.name))) {
                                                sf = sf.retain_tos("struct-set-value");
                                            }
                                        },
                                        _ => {}
                                    }
                                }
                                return sf.emit(ir.op_struct_set(fidx, struct_field_width(s.structs, fsty, fidx)));
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            // General expression statement: lower the value, drop the result.
            // Statement-temporary reclamation, stage (a): a discarded bare
            // `[e0, e1, …];` whose value is a FRESH scalar-element array literal
            // is a rc=1 sole owner that leaks every iteration if merely dropped
            // (unbounded in a hot loop). Release its buffer with the rc-guarded
            // __fern_rc_dec before the drop — the self-host sibling of native's
            // emitOwnedTempStackDrop (docs/RC-PERCEUS-PLAN.md). Ident / field /
            // index reads are borrowed views (an upstream owner / the exit sweep
            // accounts for them) and never match discardable_scalar_arr_lit, so
            // they keep leaking-safe on the plain drop.
            var se: LowerState = lower_expr(es.value, s);
            if (!se.ok) { return se; }
            match (es.value) {
                ast.ExprArray(dae) => {
                    if (discardable_scalar_arr_lit(dae, s)) {
                        se = se.release_tos("__fern_rc_dec", "discard-arr-lit");
                    } else if (discardable_scalar_arrarr_lit(dae, s)) {
                        // A discarded fresh scalar-inner array-of-arrays literal
                        // (`[[i, i+1], [i]];`, #4365): __fern_arrarr_free frees
                        // each inner buffer (one rc-guarded arr_dec — scalar
                        // inners fully reclaim) then the outer buffer, the same
                        // whole release the exit sweep gives a reclaimable ARRARR:
                        // LOCAL. Every inner is a fresh sole-owned literal, so the
                        // deep free is complete and double-free-free.
                        se = se.release_tos("__fern_arrarr_free", "discard-arrarr-lit");
                    } else if (discardable_fresh_strarr_lit(dae, s)) {
                        // A discarded fresh string[] literal deep-frees its element
                        // boxes and buffer via __fern_str_arr_free — the same release
                        // the exit sweep gives a reclaimable string[] LOCAL (#4355).
                        // Every element is proven fresh (expr_is_fresh_str), so the box
                        // sole-owns each element at rc=1: the rc==1-gated element walk
                        // frees exactly the fresh boxes, then returns the buffer to its
                        // freelist — a COMPLETE, no-double-free reclaim.
                        se = se.release_tos("__fern_str_arr_free", "discard-strarr-lit");
                    }
                },
                // A discarded fresh scalar TUPLE / STRUCT literal box is likewise a
                // rc=1 sole owner — reclaim it with the shallow rc-guarded dec.
                ast.ExprTuple(dte) => {
                    if (discardable_scalar_tuple_lit(dte, s)) { se = se.emit(ir.op_call_direct("__fern_rc_dec", 1)); }
                    else if (tuple_lit_rc_reclaimable(es.value, "", s.structs, s.sigs.str_fresh_ret_fns)) {
                        // A discarded rc-FIELD tuple literal (`(w, [w, w+1]);` or
                        // the nested `((w, [w, w+1]), w);` — #4365): every element
                        // scalar-shaped, a DIRECT array literal, or a nested tuple
                        // LITERAL — the box sole-owns each fresh array buffer and
                        // nested box, so deep-drop exactly like the loop-rebind
                        // sibling (emit_tuple_child_drops: free array buffers +
                        // nested boxes depth-first, then the box). A bare-ident
                        // pointer element gives back the retain the construction
                        // took (tuple_union_arg_freefn), same admission as the
                        // TUPRC: class. The scratch is never mark_arr'd, so the
                        // exit sweep skips it.
                        var dtt: string = "$tldrop" + util.i32_to_string(se.locals.len());
                        se = se.add_local(dtt);
                        var dtslot: i32 = se.slot_of(dtt);
                        se = se.emit(ir.op_store_local(dtslot));                     // stash box
                        var dt_path: i32[] = [];
                        se = emit_tuple_child_drops(se, dtslot, dt_path, dte);       // free array/nested children
                        se = se.emit(ir.op_load_local(dtslot));                      // box again
                        se = se.release_tos("__fern_rc_dec", "discard-tuple-box");         // free the box
                    }
                },
                ast.ExprStructLit(dse) => {
                    if (!dse.has_base && struct_lit_all_scalar(s.structs, dse.type_name)) {
                        se = se.release_tos("__fern_rc_dec", "discard-struct-lit");
                    } else if (!dse.has_base && struct_fields_reusable(s.structs, dse.type_name)) {
                        // A discarded fresh rc-FIELD struct literal (`H { id, xs: [..] };`)
                        // is reclaimed the same way the exit sweep drops a struct LOCAL
                        // (emit_struct_field_drops): when the type carries rc-array /
                        // nested-struct fields, __struct_drop_<T> releases those field
                        // buffers one level (auto-materialized by the asm_ir op scan on
                        // seeing the call_direct), THEN __fern_rc_dec frees the box. The
                        // construction alias-inc in this same lowering (the ExprStructLit
                        // field arms) balances every NON-fresh field source — a borrowed
                        // array/local was inc'd on construction so this dec just returns
                        // it to its owner, a fresh sole-owned literal field decs to 0 and
                        // frees — so the deep-drop is exactly paired, never a UAF. String
                        // / enum / map / tuple / option fields keep struct_fields_reusable
                        // false, so a struct carrying one still leaks whole (safe-leak
                        // floor).
                        //
                        // __struct_drop_<T> returns the box in its return register (the
                        // x86/arm64 bodies reload it from the stack arg before ret — the
                        // inner field-release calls clobber the register copies; #4355
                        // slice 5 fixed the reload). This site predates that fix and
                        // threads the box through a scratch local instead of the return —
                        // still correct, kept as-is: stash the box in a fresh scratch
                        // local and re-load it for each step — the scratch is never
                        // mark_arr'd, so the exit dec-sweep (is_arr_slot-gated) skips it
                        // (no double-free).
                        if (struct_has_reclaim_array_field(s.structs, dse.type_name)) {
                            var sdtmp: string = "$sdrop" + util.i32_to_string(se.locals.len());
                            se = se.add_local(sdtmp);
                            var sdslot: i32 = se.slot_of(sdtmp);
                            se = se.emit(ir.op_store_local(sdslot));                              // stash box
                            se = se.emit(ir.op_load_local(sdslot));                               // box (arg0)
                            se = se.release_tos("__struct_drop_" + dse.type_name, "discard-struct-deep"); // deep-drop rc fields
                            se = se.emit(ir.op_drop());                                           // discard clobbered return
                            se = se.emit(ir.op_load_local(sdslot));                               // box again
                        }
                        se = se.release_tos("__fern_rc_dec", "discard-struct-box");                      // free the box
                    }
                },
                // A discarded fresh STRING CONCAT (`a + b;`) allocates a new owned
                // buffer that leaks if merely dropped — release it with the rc-aware
                // __fern_str_free (box + heap data at rc==1; .rodata-guarded; a shared
                // box just decs). The operands stay owned by their locals (concat
                // reads them, produces a fresh buffer), so this frees only the temp.
                ast.ExprBinary(dbe) => {
                    if (dbe.op == "+" && expr_is_str(es.value, s)) { se = se.emit(ir.op_call_direct("__fern_str_free", 1)); }
                },
                // A discarded call to a STRICT fresh-struct-returning free function
                // (`mk(i);`, callee in return_fresh_struct_ret_fns) hands back a rc=1
                // sole-owner box (every such return is a no-base literal — #4356
                // slice 2 / is_fresh_ret_binding), which leaks if merely dropped.
                // Release the box with the shallow rc-guarded __fern_rc_dec (the
                // native ownedCallResultType reclaim). A scalar-only result is fully
                // reclaimed; a result whose return struct carries rc-array / nested-
                // struct fields is DEEP-dropped — because the STRICT-fresh registry
                // guarantees the returned box SOLE-owns every field buffer (no aliased
                // inner buffers, unlike the looser fresh_struct_ret_fns), so
                // __struct_drop_<RetT> reclaims those buffers with no double-free, then
                // __fern_rc_dec frees the box (same composition as the ExprStructLit
                // arm; box stashed in a scratch local because __struct_drop_<T>'s inner
                // arr_dec clobbers the box return register). Method / builtin / variant-
                // constructor callees are excluded — not in the strict-fresh registry.
                ast.ExprCall(dce) => {
                    match (dce.callee) {
                        ast.ExprIdent(dcid) => {
                            if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, dcid.name) >= 0) {
                                var crt: string = s.struct_ret_type(dcid.name);
                                if (crt.len() > 0 && struct_fields_reusable(s.structs, crt) && struct_has_reclaim_array_field(s.structs, crt)) {
                                    var fcd: string = "$fcdrop" + util.i32_to_string(se.locals.len());
                                    se = se.add_local(fcd);
                                    var fcslot: i32 = se.slot_of(fcd);
                                    se = se.emit(ir.op_store_local(fcslot));                          // stash box
                                    se = se.emit(ir.op_load_local(fcslot));                           // box (arg0)
                                    se = se.release_tos("__struct_drop_" + crt, "discard-call-struct-deep");       // deep-drop rc fields
                                    se = se.emit(ir.op_drop());                                       // discard clobbered return
                                    se = se.emit(ir.op_load_local(fcslot));                           // box again
                                    se = se.release_tos("__fern_rc_dec", "discard-call-struct-box");              // free the box
                                } else {
                                    se = se.release_tos("__fern_rc_dec", "discard-call-struct-box");
                                }
                            } else if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "ARR:" + dcid.name) >= 0
                                    || util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "ARROWN:" + dcid.name) >= 0) {
                                // A discarded call to an ARRAY-returning free function
                                // that leaves this frame owning one reference: an "ARR:"
                                // producer (every return a direct scalar-element array
                                // literal — #4365) hands back an rc=1 buffer, an
                                // "ARROWN:" one (#7259) a reference it retained or moved
                                // out. Both leak if merely dropped. Release with the
                                // shallow rc-guarded __fern_rc_dec — element-blind,
                                // which the "ARR:" scalar-element contract makes sound
                                // one way and the surviving owner the other.
                                se = se.release_tos("__fern_rc_dec", "discard-arr-ret");
                            } else if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "STRARR:" + dcid.name) >= 0) {
                                // A discarded call to a "STRARR:" producer: every
                                // element is a string box this frame allocated, so the
                                // shallow dec above would return the buffer and strand
                                // all of them. __fern_str_arr_free is the deep sibling
                                // the read reclaim already uses (#6491, #7259).
                                se = se.release_tos("__fern_str_arr_free", "discard-strarr-ret");
                            } else if ((util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "STRUCTARRF:" + dcid.name) >= 0
                                    || util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "ARRSTRUCTF:" + dcid.name) >= 0)
                                    && decl_is_struct(s.structs, se.struct_ret_type(dcid.name))) {
                                // A discarded call to a STRUCT-element array producer
                                // (#7445's registries): same split the exit sweep gives
                                // a credited slot of the class — a field-routing or
                                // rc-array-field element walks __struct_drop_<T> per
                                // element, a scalar-field one frees box-per-element via
                                // __fern_arrarr_free. Nothing released either before:
                                // frees=0 outright, ~200 B/round and unbounded.
                                var dsty: string = se.struct_ret_type(dcid.name);
                                if (struct_has_reclaim_array_field(se.structs, dsty) || se.struct_routes_field_reclaim(dsty)) {
                                    var dscr: string = "$dsar" + util.i32_to_string(se.locals.len());
                                    se = se.add_local(dscr);
                                    var dslot: i32 = se.slot_of(dscr);
                                    se = se.emit(ir.op_store_local(dslot));
                                    se = emit_arrstruct_deep_free(se, dslot, dsty);
                                    se = se.emit(ir.op_load_local(dslot));   // the shared tail drop consumes this
                                } else {
                                    se = se.release_tos("__fern_arrarr_free", "discard-structarr-ret");
                                }
                            } else if (reclaim_has(s.reclaimable_names, "MAPRET:", dcid.name)) {
                                // A discarded call to a MAPF-registered map builder
                                // (`mk(i);`, #4357): the result is a fresh sole-owner
                                // scalar-column map that leaks whole if merely dropped.
                                // __fern_map_free frees both column buffers and returns
                                // the mapbox to the freelist (the same helper the slot
                                // reclaim uses — deep on wasm via $__fern_map_release);
                                // the shared tail drop discards the helper's return.
                                se = se.release_tos("__fern_map_free", "discard-map-ret");
                            } else if (util.index_of_str(s.sigs.str_fresh_ret_fns, dcid.name) >= 0) {
                                // A discarded call to a STRING-fresh-ret free function
                                // (`mk(a);`): the result is a freshly-allocated string
                                // nothing else will ever hold, so the shared tail drop
                                // leaks it once per evaluation. Measured on a 200-round
                                // churn: allocs=601 frees=200 live_bytes=9624, growing
                                // x2 per doubling, where native is 200/200/0. Release it
                                // with the rc-aware __fern_str_free (box + heap data at
                                // rc==1; .rodata-guarded), the same helper the discarded
                                // concat arm above uses; the shared tail drop discards
                                // the helper's return.
                                //
                                // str_fresh_ret_fns, not the looser str_ret_fns, for the
                                // reason it is the gate everywhere else: it means EVERY
                                // return of this callee is freshly allocated, never an
                                // alias of a borrowed arg / field / literal — freeing
                                // one of those drops a box a live local still holds.
                                // Unlike the concat-OPERAND position (#6171), a discard
                                // has no reader to outlive: the statement is the value's
                                // whole lifetime.
                                se = se.release_tos("__fern_str_free", "discard-str-ret");
                            } else {
                                // A discarded call to a TUPLE-fresh-ret free function
                                // ("TUPRET:<name>|<flags>", #4365 discarded rc-field
                                // tuple temps): every return is a direct tuple literal,
                                // so the result is a fresh sole-owner box. Deep-drop
                                // the '1'-flagged positions (a fresh scalar-element
                                // array buffer in EVERY return — tuple_ret_arrfree_
                                // flags) then free the box; '0' positions (scalars,
                                // aliased idents, pointer elements) are left to their
                                // owners / the safe-leak floor.
                                var dtrf: string = discarded_tuple_ret_flags(s, dcid.name);
                                if (dtrf.len() > 0) {
                                    var tcd: string = "$tcdrop" + util.i32_to_string(se.locals.len());
                                    se = se.add_local(tcd);
                                    var tcslot: i32 = se.slot_of(tcd);
                                    se = se.emit(ir.op_store_local(tcslot));                     // stash box
                                    var tck: i32 = 0;
                                    while (tck < dtrf.len()) {
                                        if (dtrf[tck] == b'1') {
                                            se = se.emit(ir.op_load_local(tcslot));              // box
                                            se = se.emit(ir.op_tuple_get(tck));                  // element (array ptr)
                                            se = se.release_tos("__fern_rc_dec", "discard-tupret-elem"); // free the fresh buffer
                                            se = se.emit(ir.op_drop());
                                        }
                                        tck = tck + 1;
                                    }
                                    se = se.emit(ir.op_load_local(tcslot));                      // box again
                                    se = se.release_tos("__fern_rc_dec", "discard-tupret-box");         // free the box
                                }
                            }
                        },
                        // A discarded call to an ARRAY-returning METHOD (`h.mk();` /
                        // `h.get();`). The free-function arm above reads
                        // "ARR:<name>" / "ARROWN:<name>"; a method keys
                        // "<Base>.<method>", which is what owned_fresh_call_callee
                        // already resolves for the READ reclaim one expression
                        // position over (#6491). Same shallow rc-guarded
                        // __fern_rc_dec, same element-blind argument as the free
                        // function.
                        //
                        // The receiver must be a bare LOCAL naming a struct, for
                        // owned_fresh_call_callee's reason: expr_struct_type reports a
                        // struct-ARRAY-returning call's ELEMENT type, so a call
                        // receiver could name a method of a type the value is only an
                        // array OF. A struct FIELD of the method's name is a fn-typed
                        // field call and names no method at all.
                        ast.ExprFieldAccess(dcfa) => {
                            var drty: string = "";
                            match (dcfa.obj) {
                                ast.ExprIdent(_) => { drty = expr_struct_type(dcfa.obj, s); },
                                _ => {}
                            }
                            if (drty != "" && decl_field_type(s.structs, drty, dcfa.field) == ""
                                && (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "ARR:" + drty + "." + dcfa.field) >= 0
                                    || util.index_of_str(s.sigs.return_fresh_struct_ret_fns, "ARROWN:" + drty + "." + dcfa.field) >= 0)) {
                                se = se.release_tos("__fern_rc_dec", "discard-field-arr-ret");
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return se.emit(ir.op_drop());
        },
        ast.StmtMatch(m) =>{ return lower_stmt_match(m, s); },
        ast.StmtBreak(b) => {
            // br out to the target loop's exit block. b.tag is the relative loop
            // depth (0 = innermost; a labeled `break outer` was resolved to its
            // depth by resolve_labels). blk is that loop's exit-block ctrl level;
            // from depth s.ctrl the relative br is the difference. -1 (no such
            // enclosing loop) bails.
            var bblk: i32 = s.loop_blk_at_depth(b.tag);
            if (bblk < 0) { return s.fail(); }
            return s.emit(ir.op_br(s.ctrl - bblk));
        },
        ast.StmtContinue(c) => {
            // br to the target loop's header, which sits one level deeper than its
            // exit block (block then loop). c.tag is the relative loop depth.
            var cblk: i32 = s.loop_blk_at_depth(c.tag);
            if (cblk < 0) { return s.fail(); }
            return s.emit(ir.op_br(s.ctrl - cblk - 1));
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_struct_destructure expands `let Point { x, y } = E;` (encoded by
// parse_struct_destructure as a StmtVar with type_name "@sd:<Struct>:<fields>"
// and name = comma-joined bindings). It lowers E once into a struct-typed temp,
// then synthesises `var <bind> = <tmp>.<field>;` for each field and lowers each
// through the ordinary StmtVar path — so all the field-read typing + RC dup-on-
// projection (a pointer field's binding co-owns the box alongside the temp,
// balanced by the temp's scope-exit deep-drop) is reused, not re-implemented.
function lower_struct_destructure(v: ast.StmtVar, s: LowerState): LowerState {
    // Decode "@sd:<StructName>:<f0,f1,…>" — the struct name runs to the first
    // ':' after the "@sd:" prefix, the rest is the comma-joined field list.
    var sd_dm: parser.DestrMarker = parser.destr_marker_split(v.type_name);
    var at_name: string = sd_dm.at;
    var sd_marker: string = sd_dm.tag;
    var rest: str = slice_unchecked(sd_marker, 4, sd_marker.len());
    var colon: i32 = 0 - 1;
    var ri: i32 = 0;
    while (ri < rest.len()) {
        if (rest[ri] == b':' && colon < 0) { colon = ri; }
        ri = ri + 1;
    }
    if (colon < 0) { return s.fail(); }
    var struct_name: str = slice_unchecked(rest, 0, colon);
    var fields_csv: str = slice_unchecked(rest, colon + 1, rest.len());
    var fields: string[] = split_commas(fields_csv);
    var bindings: string[] = split_commas(v.name);
    // Lower E once into a fresh struct-typed temp, so a call-valued init isn't
    // re-evaluated per field and the box is owned/reclaimed like any struct local.
    // An `@` binding NAMES that temp — it is the whole value the pattern
    // destructures — so the source reads it under the name it wrote, and the
    // local is owned and reclaimed exactly as the hidden one was.
    var dt: LowerState = lower_expr(v.init, s);
    if (!dt.ok) { return dt; }
    var tmp: string = at_name;
    if (tmp.len() == 0) { tmp = "$sdst" + util.i32_to_string(dt.locals.len()); }
    dt = dt.add_local(tmp);
    var tmp_slot: i32 = dt.slot_of(tmp);
    dt = dt.mark_struct_type(tmp_slot, struct_name);
    dt = dt.emit(ir.op_store_local(tmp_slot));
    var i: i32 = 0;
    while (i < bindings.len()) {
        var fa: ast.Expr = ast.ExprFieldAccess { obj: ast.ExprIdent { name: tmp, line: 0, col: 0, ty: "" }, field: fields[i], line: 0, col: 0, ty: "" };
        var sv: ast.Stmt = ast.StmtVar { name: bindings[i], type_name: "", init: fa, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
        dt = lower_stmt(sv, dt);
        if (!dt.ok) { return dt; }
        i = i + 1;
    }
    return dt;
}

// split_commas splits `csv` on top-level commas into its fields (no nesting
// awareness — struct destructure field/binding names never contain commas).
function split_commas(csv: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= csv.len()) {
        if (i == csv.len() || csv[i] == b',') {
            out = out.append(slice_unchecked(csv, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// lower_stmt_var: the ast.StmtVar arm of lower_stmt, split out so no single
// function's per-function emit accumulation can exhaust the fixed bump
// arena on the whole-compiler per-module emits (a ~3,000-line lower_stmt
// tripped the exit-137 alloc trap on its own; oversized functions also
// miscompile — cf. #2720). Body moved verbatim; the trailing s.fail()
// preserves lower_stmt's own post-match fallback for any fall-through.
// VarTypes is what lower_stmt_var's classification half concludes about a
// `var`'s initialiser: the slot type-facts the new local will carry. It
// exists so the binding half can be its own function — the two otherwise
// shared eleven separate locals across a 2,000-line body.
pub struct VarTypes {
    is_arr: boolean,
    alias_inc: boolean,
    is_str: boolean,
    is_strarr: boolean,
    is_f64arr: boolean,
    // f32[] dispatch overlay, riding is_f64arr's slot — see LocalInfo.is_f32arr.
    is_f32arr: boolean,
    is_i64arr: boolean,
    is_bool: boolean,
    is_boolarr: boolean,
    is_closurearr: boolean,
    is_arrarr: boolean,
    arrarr_e: string,
    struct_ty: string,
    opt_ty: string,
}

// slice_unchecked_call reports whether `e` is the builtin call
// `slice_unchecked(src, a, b)` — the raw byte slice under its honest name
// (#5634), source/start/end in args[0]/[1]/[2]. It is the ONLY spelling the
// frame path and the borrow scans admit: `s[a:b]` is the checked form and
// yields an `Option[str]` box that escapes the expression.
pub function slice_unchecked_call(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return cid.name == "slice_unchecked" && c.args.len() == 3; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// view_frame_binding_ok decides whether `var <name> = <expr>` may take the
// frame-allocated form of the string view its initialiser builds (#6713):
// a `slice_unchecked` STRING view (an array slice copies, so it has no view
// box), a name the per-function borrow scan approved, and a register backend —
// wasm's str_slice copies into a fresh inline block, so there is no box to place
// in a frame. `s[a:b]` is NOT a candidate: it yields an `Option[str]` heap box
// (#5634), and putting one in the three reserved 24-byte slots is corruption.
function view_frame_binding_ok(v: ast.StmtVar, s: LowerState): boolean {
    if (s.for_wasm()) { return false; }
    if (!s.is_view_frame_name(v.name)) { return false; }
    match (v.init) {
        ast.ExprCall(c) => {
            if (slice_unchecked_call(v.init)) { return expr_is_str(c.args[0], s); }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// view_frame_temp_ok decides whether an ANONYMOUS string-view temporary may
// take the frame form. #6713 placed the box of a NAMED
// `var t = slice_unchecked(s, a, b)` whose every use borrows it; a temp consumed
// inside the expression that built it — `"x" + slice_unchecked(o.name, 0, 1)`,
// `slice_unchecked(s, a, b).len()` — has no name at all, so neither hazard the
// named scan filters for can arise: nothing can carry it out of the frame, and
// the enclosing operator has finished reading it before the site can run again.
// Callers are the borrow positions themselves, which is what makes the whitelist
// a property of the CALL SITE rather than of a scan. The `s[a:b]` spelling never
// qualifies: it builds an `Option[str]` heap box, not a view box (#5634).
function view_frame_temp_ok(e: ast.Expr, s: LowerState): boolean {
    if (s.for_wasm()) { return false; }
    match (e) {
        ast.ExprCall(c) => {
            if (slice_unchecked_call(e)) { return expr_is_str(c.args[0], s); }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// lower_view_borrowed lowers `e` in a position that only borrows a string for
// the duration of one expression: a `slice_unchecked` view temp takes its box
// from the frame, everything else lowers normally.
function lower_view_borrowed(e: ast.Expr, s: LowerState): LowerState {
    if (view_frame_temp_ok(e, s)) { return lower_str_slice_frame(e, s); }
    return lower_expr(e, s);
}

// lower_view_borrowed_parked is lower_view_borrowed plus the WASM half of the
// same idea, and the two are alternatives rather than additions: a borrow-
// position slice temp has to stop costing anything, and the backends get there
// differently.
//
// On the register backends view_frame_temp_ok routes the slice to
// lower_str_slice_frame, whose 24-byte box lives in three reserved frame slots
// and never reaches the heap — nothing to release, which is why that predicate
// bails on wasm rather than pretending otherwise. wasm has no such storage
// (op_str_slice_frame's own note: it "ignores it, its str_slice copies into a
// fresh inline block"), so the copy is a real heap block and every borrow
// position stranded one: 48000 B over 400 rounds, payload-sized, at each of the
// six positions measured.
//
// So park it and let the caller drain after the consuming op, the same park/
// drain pair stash_fresh_str_arg uses. The warrant is the one lower_view_borrowed
// already asserts in its name — the value is borrowed for the duration of ONE
// EXPRESSION — which is exactly the proof the frame form relies on to reuse its
// slots. A slot of `0 - 1` means nothing was parked, so a caller can drain
// unconditionally.
function lower_view_borrowed_parked(e: ast.Expr, s: LowerState): ArgStash {
    var p: LowerState = lower_view_borrowed(e, s);
    if (!p.ok || !s.for_wasm()) { return ArgStash { state: p, slot: 0 - 1 }; }
    var is_str_slice: boolean = false;
    match (e) {
        ast.ExprCall(vc) => { if (slice_unchecked_call(e)) { is_str_slice = expr_is_str(vc.args[0], s); } },
        _ => {}
    }
    if (!is_str_slice) { return ArgStash { state: p, slot: 0 - 1 }; }
    var vn: string = "$vwb" + util.i32_to_string(p.locals.len());
    p = p.add_local(vn);
    var vslot: i32 = p.slot_of(vn);
    p = p.emit(ir.op_store_local(vslot));
    p = p.emit(ir.op_load_local(vslot));
    return ArgStash { state: p, slot: vslot };
}

// free_parked_views drains what lower_view_borrowed_parked parked. Slots are
// released through __fern_str_view_free, which on wasm is the rc dec that frees
// the copy and on the register backends skips a box outside the arena — so a
// caller that parks nothing, or runs on a backend that parked nothing, emits
// nothing.
function free_parked_views(s: LowerState, slots: i32[]): LowerState {
    if (slots.len() == 0) { return s; }
    return free_stashed_recv(s, slots, true);
}

// free_parked_view_after drains one parked view AFTER the op that consumed it,
// which is where every single-operand borrow position wants it. The three
// emitted ops are stack-neutral — load pushes the box, the call replaces it,
// drop removes the result — so whatever the consuming op left on top stays on
// top. A slot of `0 - 1` emits nothing, which is the register backends and every
// non-slice operand.
function free_parked_view_after(s: LowerState, slot: i32): LowerState {
    if (slot < 0) { return s; }
    var one: i32[] = [];
    one = one.append(slot);
    return free_stashed_recv(s, one, true);
}

// view_frame_slot_name is the name the reserved box slots carry. No source
// identifier can start with `!` (the same reservation lower_block's `!retired!`
// shadow-prefix relies on), so the three slots are unreachable by slot_of and
// are never swept — they hold a box the RC layer already treats as immortal.
function view_frame_slot_name(): string { return "!view!"; }

// lower_str_slice_frame lowers `slice_unchecked(src, a, b)` with its box in the
// frame: the same [src, start, end] operands as the heap form, then three
// reserved local slots (24 bytes, the box) named in the op's immediate.
function lower_str_slice_frame(e: ast.Expr, s: LowerState): LowerState {
    match (e) {
        ast.ExprCall(fc) => {
            if (!slice_unchecked_call(e)) { return s.fail(); }
            var fcs: LowerState = lower_view_borrowed(fc.args[0], s);
            if (!fcs.ok) { return fcs; }
            fcs = lower_expr(fc.args[1], fcs);
            if (!fcs.ok) { return fcs; }
            fcs = lower_expr(fc.args[2], fcs);
            if (!fcs.ok) { return fcs; }
            var fcbase: i32 = fcs.locals.len();
            fcs = fcs.add_local(view_frame_slot_name());
            fcs = fcs.add_local(view_frame_slot_name());
            fcs = fcs.add_local(view_frame_slot_name());
            return fcs.emit(ir.op_str_slice_frame(fcbase));
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_str_slice_checked lowers `s[a:b]` on a STRING source. The expression is
// bounds- AND UTF-8-boundary-checked and yields `Option[str]` (#5634):
// `Some(view)` when `0 <= a <= b <= len(s)` and both bounds land on a code-point
// start, `None` otherwise. `slice_unchecked(s, a, b)` is the raw view that keeps
// the trap, and it is the form every frame-view / borrow path still admits.
//
// A bound is a boundary by definition at 0 and at len(s), so the byte probe runs
// only for an interior bound — str_index has no bounds check of its own, so that
// guard is correctness, not an optimisation. Both probes sit inside the
// bounds-OK branch for the same reason.
//
// Every scratch slot is allocated BEFORE the first `if` opens: a value pushed
// outside a block and consumed inside it is rejected by the wasm validator, and
// the result rides its own slot so all three arms join on an empty stack. This
// is emit_str_reclaim_store's void-if-plus-scratch shape, one level deeper.
function lower_str_slice_checked(slc: ast.ExprSlice, s: LowerState): LowerState {
    var slvst: ArgStash = lower_view_borrowed_parked(slc.array, s);
    var cs: LowerState = slvst.state;
    if (!cs.ok) { return cs; }
    var srcn: string = "$slcsrc" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(srcn);
    var srcslot: i32 = cs.slot_of(srcn);
    cs = cs.emit(ir.op_store_local(srcslot));
    var lenn: string = "$slclen" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(lenn);
    var lenslot: i32 = cs.slot_of(lenn);
    var lon: string = "$slclo" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(lon);
    var loslot: i32 = cs.slot_of(lon);
    var hin: string = "$slchi" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(hin);
    var hislot: i32 = cs.slot_of(hin);
    var bokn: string = "$slcbok" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(bokn);
    var bokslot: i32 = cs.slot_of(bokn);
    var byten: string = "$slcbyte" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(byten);
    var byteslot: i32 = cs.slot_of(byten);
    var resn: string = "$slcres" + util.i32_to_string(cs.locals.len());
    cs = cs.add_local(resn);
    var resslot: i32 = cs.slot_of(resn);

    // len(s) — read once; the source is never re-evaluated.
    cs = cs.emit(ir.op_load_local(srcslot));
    cs = cs.emit(ir.op_str_len());
    cs = cs.emit(ir.op_store_local(lenslot));
    // The bounds evaluate exactly once each, in source order.
    cs = lower_expr(slc.start, cs);
    if (!cs.ok) { return cs; }
    cs = cs.emit(ir.op_store_local(loslot));
    if (slc.open_end) {
        // `s[lo:]` — the bound is len(s), already in $slclen; slc.end is a
        // placeholder that must not be lowered.
        cs = cs.emit(ir.op_load_local(lenslot));
    } else {
        cs = lower_expr(slc.end, cs);
        if (!cs.ok) { return cs; }
    }
    cs = cs.emit(ir.op_store_local(hislot));

    // 0 <= lo && lo <= hi && hi <= len
    cs = cs.emit(ir.op_const_i32(0));
    cs = cs.emit(ir.op_load_local(loslot));
    cs = cs.emit(ir.op_bin("le_s", 0, false));
    cs = cs.emit(ir.op_load_local(loslot));
    cs = cs.emit(ir.op_load_local(hislot));
    cs = cs.emit(ir.op_bin("le_s", 0, false));
    cs = cs.emit(ir.op_bin("and", 0, false));
    cs = cs.emit(ir.op_load_local(hislot));
    cs = cs.emit(ir.op_load_local(lenslot));
    cs = cs.emit(ir.op_bin("le_s", 0, false));
    cs = cs.emit(ir.op_bin("and", 0, false));
    cs = cs.emit(ir.op_if(0));
    cs = cs.emit(ir.op_const_i32(1));
    cs = cs.emit(ir.op_store_local(bokslot));
    cs = emit_slice_boundary_probe(cs, srcslot, loslot, lenslot, byteslot, bokslot);
    cs = emit_slice_boundary_probe(cs, srcslot, hislot, lenslot, byteslot, bokslot);
    cs = cs.emit(ir.op_load_local(bokslot));
    cs = cs.emit(ir.op_if(0));
    cs = cs.emit(ir.op_load_local(srcslot));
    cs = cs.emit(ir.op_load_local(loslot));
    cs = cs.emit(ir.op_load_local(hislot));
    cs = cs.emit(ir.op_str_slice());
    cs = cs.emit(ir.op_opt_make(0));
    cs = cs.emit(ir.op_store_local(resslot));
    cs = cs.emit(ir.op_else());
    cs = cs.emit(ir.op_opt_none());          // a bound splits a code point
    cs = cs.emit(ir.op_store_local(resslot));
    cs = cs.emit(ir.op_end());
    cs = cs.emit(ir.op_else());
    cs = cs.emit(ir.op_opt_none());          // a bound is out of range
    cs = cs.emit(ir.op_store_local(resslot));
    cs = cs.emit(ir.op_end());
    // The parked wasm copy of the source is dead once str_slice has read it, and
    // the drain is stack-neutral — so it goes after the join, where it runs on
    // the None paths too rather than leaking there.
    cs = free_parked_view_after(cs, slvst.slot);
    return cs.emit(ir.op_load_local(resslot));
}

// emit_slice_boundary_probe folds `is_char_boundary(src, at)` into `bok`, for an
// INTERIOR `at` only: 0 and len(src) are boundaries by definition and str_index
// would read out of bounds there. A UTF-8 continuation byte is 0b10xxxxxx, so
// the byte at a boundary is < 128 or >= 192.
function emit_slice_boundary_probe(s: LowerState, srcslot: i32, atslot: i32, lenslot: i32, byteslot: i32, bokslot: i32): LowerState {
    var p: LowerState = s;
    p = p.emit(ir.op_load_local(atslot));
    p = p.emit(ir.op_const_i32(0));
    p = p.emit(ir.op_bin("gt_s", 0, false));
    p = p.emit(ir.op_load_local(atslot));
    p = p.emit(ir.op_load_local(lenslot));
    p = p.emit(ir.op_bin("lt_s", 0, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_if(0));
    p = p.emit(ir.op_load_local(srcslot));
    p = p.emit(ir.op_load_local(atslot));
    p = p.emit(ir.op_str_index());
    p = p.emit(ir.op_store_local(byteslot));
    p = p.emit(ir.op_load_local(byteslot));
    p = p.emit(ir.op_const_i32(128));
    p = p.emit(ir.op_bin("lt_s", 0, false));
    p = p.emit(ir.op_load_local(byteslot));
    p = p.emit(ir.op_const_i32(192));
    p = p.emit(ir.op_bin("ge_s", 0, false));
    p = p.emit(ir.op_bin("or", 0, false));
    p = p.emit(ir.op_load_local(bokslot));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_store_local(bokslot));
    return p.emit(ir.op_end());
}

// bind_var_slot is lower_stmt_var's second half: allocate the local's slot,
// stamp the classified type facts onto it, and emit the initialising store.
// `s` is the state on entry to the statement, `se` the state after the
// initialiser was lowered — both are needed, and they differ.
function bind_var_slot(v: ast.StmtVar, s: LowerState, se: LowerState, vt: VarTypes): LowerState {
    var opt_ty: string = vt.opt_ty;
    var sb: LowerState = se.add_local(v.name);
    var slot: i32 = sb.slot_of(v.name);
    // Retain-plan record (#4482 aliasBindIncs): the classification decided this
    // bind takes the transfer inc. Dump-only — the store emitters below read
    // vt.alias_inc themselves.
    if (vt.alias_inc) {
        sb = LowerState { ...sb, alias_incs: sb.alias_incs.append(util.i32_to_string(v.line) + ":" + util.i32_to_string(v.col) + "=" + v.name) };
    }
    // Dead-alias cancellation, second half (#4402 opt 1): the retain was
    // skipped at this bind (the same per-kind predicate the ladder
    // consulted), so the ALIAS slot's exit dec is elided with it.
    if (arr_dead_alias_bind(v, se) || str_dead_alias_bind(v, se) || struct_dead_alias_bind(v, se) || tuple_dead_alias_bind(v, se)) { sb = sb.note_moved_elided(slot); }
    // A tuple MOVE-alias transfers the source's release role to this slot
    // (the ladder's tuple clause swapped the credit class), so the slot facts
    // that release reads move with it: the element type tags the "TUPRCS:"
    // deep free walks, and the construction-retain kinds the "TUP:" sweep
    // gives back (both are SLOT-keyed on the source today). Same predicate
    // as the ladder — the two sites cannot disagree.
    match (v.init) {
        ast.ExprIdent(mvid) => {
            var mvsrc: i32 = se.slot_of(mvid.name);
            if (mvsrc >= 0 && se.slot_is_tuple_box(mvsrc) && se.moves_local_at(mvid.name, v.line, v.col)) {
                if (se.locals[mvsrc].tuple_elems.len() > 0) { sb = sb.mark_tuple_elems(slot, se.locals[mvsrc].tuple_elems); }
                var mvkinds: string = se.tup_elem_kinds_of(mvsrc);
                if (mvkinds.len() > 0) { sb = sb.add_tup_elem_kinds(util.i32_to_string(slot) + "|" + mvkinds); }
            }
        },
        _ => {}
    }
    // The binding-SITE key, recorded before anything reads a credit off this slot
    // (#7272). Two `var t` in sibling blocks are two slots under one name; the
    // tuple class credits are keyed on this instead, so each resolves its own.
    sb = sb.mark_reclaim_site(slot, reclaim_site_key_of(v.name, v.line, v.col));
    // The fn-VALUE facts, on the slot this bind just created (#7253) — see
    // stamp_fn_value_facts for the other two paths that must do the same.
    sb = sb.stamp_fn_value_facts(v, slot, se);
    // A COUNTED enum-array field share (`var p: P = P { f: q.f, … }`) hands both
    // holders a claim on one buffer, and the credit pass marks BOTH box-only for
    // it — `p` because its field value reads as an un-retained borrow
    // (struct_lit_unretained_borrow_field, whose exclusion list has no enum-array
    // entry), and `q` because a field read in a struct-literal field is a positive
    // MOVE position (optstruct_body_moves_field). Both verdicts are right while the
    // read is uncounted, and both are wrong once it is retained: the whole structure
    // then leaks from both ends, which is the enum_arr__fieldread cell (600 allocs /
    // 300 frees).
    //
    // The verdicts are flipped HERE rather than by teaching those two predicates
    // about the retain, because they run pre-lowering and cannot see the slot types
    // the retain turns on: an exclusion wider than the retain flips a marker with no
    // inc behind it, which is a double free in a class where the census, the
    // underflow counter and the arm64 stage-2 leg are all blind. Flipping at the
    // bind that emitted the retain makes the two sets identical by construction.
    //
    // FLIPPING means writing "FLDCHECKED:" as well as dropping "NODEEP:" — the two
    // are arms of one either/or, and a BLOCK-SCOPED slot deep-drops only on the
    // second witness (#6127). Revoking the marker alone leaves such a slot with
    // neither, and it then leaks its whole payload while the identical top-level
    // binding is clean.
    //
    // Both walks are already buffer-is_unique-gated (__enum_arr_elems_drop on the
    // field side, emit_arrenum_deep_free on the local side), so with rc 2 the first
    // sweep declines and decs, and the second finds rc 1 and frees. Exactly the
    // counted-share protocol the struct sibling uses.
    sb = mark_enum_arr_share(v, se, sb);
    // A tuple-fresh-ret CALL binding whose callee carries "ARRF:" flags:
    // record the flagged positions as element kinds, so the "TUP:" sweep's
    // give-back (and the loop-rebind reclaim store) frees the arrays the
    // returned box sole-owns before the box dec — the bound-result half of
    // the #4365 discarded-call deep drop. Flag '1' is a fresh scalar-element
    // array on every return path, the arr-box __fern_rc_dec shape ('a');
    // everything else stays '.' (leak-mode floor).
    //
    // Gated on "TUPELEMOK:" exactly like the literal-init kinds below: an
    // element extracted to a NEW owner in THIS body (`return r.1`,
    // `var u = r.1`) makes the release here an over-release of a reference
    // someone else now holds — witnessed as a sanitizer use-after-free on
    // `return r.1` with the census silent. No credit, no kinds: the box-only
    // leak floor, never a second free.
    sb = mark_tuple_elem_binding(v, slot, sb);
    sb = sb.mark_arr(slot, vt.is_arr);
    sb = sb.mark_str(slot, vt.is_str);
    // #4297 CS4: record the ownership class this BINDING acquires on the
    // slot (li.str_own), so a later reader (str_expr_ownership -- the CS3 /
    // reuse consumers) gets the fact off the slot instead of re-deriving it
    // syntactically. Classified against `se` (the pre-binding state) so an
    // ident init resolves the SOURCE slot. IIFE temps and container-element
    // binders stay at the Borrowed default (a representative-branch expr
    // can't classify all branches; an element read aliases a container-owned
    // box) -- both are the conservative never-free class. No consumer yet;
    // behaviour-identical.
    if (vt.is_str) { sb = sb.mark_str_own(slot, str_binding_ownership(v.init, se)); }
    if (vt.is_str) { sb = sb.mark_str_caller_elem(slot, str_param_elem_escapes(v.init, se)); }
    sb = sb.mark_strarr(slot, vt.is_strarr);
    // The type gate the reclaim collector cannot make: confirm here, where the
    // receiver's type is known, that a `SARRB:` candidate really is the builtin.
    if (vt.is_strarr) { sb = sb.mark_strarr_builtin(slot, init_is_builtin_strarr_producer(v.init, se)); }
    // An SFRRECV method chain (`base.drop(2)`) that reclaimable_names_of admitted
    // as a candidate, and whose root the SLOT walk agrees on. Resolved against
    // `se`, so the root ident answers with the slot it had BEFORE this binding
    // shadowed it. The candidate becomes a real "STR:" credit only here, because
    // the release it earns is only sound behind the guard this slot carries.
    var sfroot: i32 = 0 - 1;
    if (vt.is_str && reclaim_has(sb.reclaimable_names, "SFRCAND:", reclaim_site_key_of(v.name, v.line, v.col))) { sfroot = sfrrecv_chain_root_slot(v.init, se, 0); }
    // Same shape for the trim class: the receiver's type is known here, and the
    // flag is what makes the release site pick the view-aware free. A chain link
    // can return a `slice_unchecked` view too, so its result gets the same
    // view-aware release.
    if (vt.is_str) { sb = sb.mark_str_view_local(slot, sfroot >= 0); }
    // …and the slot the result may BE, for the identity guard the release needs:
    // replace's receiver, or the chain's root.
    if (vt.is_str) {
        var idsrc: i32 = replace_src_slot_of(v.init, se);
        if (idsrc < 0) { idsrc = sfroot; }
        sb = sb.mark_str_identity_src(slot, idsrc);
    }
    if (sfroot >= 0) { sb = LowerState { ...sb, reclaimable_names: sb.reclaimable_names.append("STR:" + reclaim_site_key_of(v.name, v.line, v.col)) }; }
    sb = sb.mark_f64arr(slot, vt.is_f64arr);
    sb = sb.mark_f32arr(slot, vt.is_f32arr);
    sb = sb.mark_bool(slot, vt.is_bool);
    sb = sb.mark_boolarr(slot, vt.is_boolarr);
    sb = sb.mark_i64arr(slot, vt.is_i64arr);
    sb = sb.mark_closurearr(slot, vt.is_closurearr);
    // A `(() => T)[]`-typed slot that is NOT a closure array is a plain
    // fn-pointer array — flag it is_fnarr so a later `.append(f)` of a
    // bare named fn emits const_func (the pointer) rather than const-
    // calling f. The empty-literal decl `var fns: (() => T)[] = []` is the
    // common shape; a closure-element literal stays is_closurearr (its
    // appends ride the closure path), so the two flags don't overlap. The
    // all-named-fn literal `[f, g]` is handled by the early-return above
    // (which also marks is_fnarr). (#3574)
    sb = sb.mark_fnarr(slot, v.type_name == "fn[]" && !vt.is_closurearr);
    sb = sb.mark_fnarr_elem(slot, binding_fnarr_elem(v, se));
    sb = sb.mark_arrarr(slot, vt.is_arrarr);
    sb = sb.mark_arrarr_elem(slot, vt.arrarr_e);
    sb = sb.mark_struct_type(slot, vt.struct_ty);
    // #4365: an explicit `Option[<tuple-with-array>]` annotation is authoritative
    // over the inferred opt_ty (some_opt_type collapses a tuple payload's element
    // type), so the slot carries the full tuple type the OPTTUP deep-drop needs at
    // the loop-rebind and exit sweep. Only overrides an opttup-shaped annotation;
    // every other option binding keeps the inferred opt_ty.
    if (opttup_ann_is(v.type_name, se.structs)) { opt_ty = v.type_name; }
    sb = sb.mark_opt_type(slot, opt_ty);
    // An array-of-maps binding (`var ms = [Map { … }, …]`, an annotated
    // `Map[K,V][]`, or an alias `var qs = ms`): record the ELEMENT map type
    // on the (is_arr) slot — the map sibling of the element-struct-type
    // overload — so `ms[i].get_or(…)` dispatches as a map op. The slot
    // stays is_arr (dropped as an array box; its element maps leak, like
    // struct-array elements). #3317.
    sb = mark_map_elem_array(v, vt, se, slot, sb);
    // A `var m: Map[K, V] = <expr>` annotation records the slot's full
    // Map type so a later `m.get/insert/has/...` dispatches as a map op.
    // The `= map_new(n)` form is handled by the early-return path above;
    // this catches the other map-typed inits, e.g. binding a map struct
    // field (`var m: Map[K, V] = c.m`). An ARRAY-of-maps type
    // (`Map[K,V][]`) also prefix-matches is_map_type_name but is handled
    // by the element-type overload above — exclude it here.
    // A `var it: MapIter[K, V] = m.iter()` annotation records the slot's
    // MapIter type (in the same local_map_type column as Map[K,V], but
    // prefix-disjoint) so a later it.has_next()/key()/value()/advance()
    // dispatches as a mapiter op instead of bailing on a Map.<method> call.
    if (is_mapiter_type_name(v.type_name)) { sb = sb.mark_map_type(slot, v.type_name); }
    else if (is_map_type_name(v.type_name) && !is_array_type_name(v.type_name)) { sb = sb.mark_map_type(slot, v.type_name); }
    // UNANNOTATED `var it = m.iter()` — recover MapIter[K, V] from the
    // RECEIVER's map type so the slot is typed exactly as the annotated form
    // types it. The annotation was load-bearing before this: without it the
    // slot stayed untyped and the first it.has_next() bailed the module, at
    // any value type (a Map[i32, i32] included).
    else if (v.type_name.len() == 0 && mapiter_type_of_iter_call(v.init, sb).len() > 0) {
        sb = sb.mark_map_type(slot, mapiter_type_of_iter_call(v.init, sb));
    }
    else if (v.type_name.len() > 5 && slice_unchecked(v.type_name, 0, 5) == "Cell[") {
        // Cell[T] is a 1-element array of T; mark_cell_elem records is_cell
        // (+is_arr) and the element-KIND array column that gives c[0] (the get
        // desugar) its width.
        var celt: string = slice_unchecked(v.type_name, 5, v.type_name.len() - 1) + "";
        sb = sb.mark_cell_elem(slot, celt);
    }
    else {
        // UNANNOTATED map binding — `var m = Map { k: v, … }` (no
        // `: Map[K,V]`). The literal desugars to a
        // `map_new[_i32](n).insert(…)` chain whose key kind expr_map_kind
        // recovers (1 = i32, 0 = string). Without this, local_map_type
        // stays "" and a later `m.insert / .get_or / .has` emits key-kind
        // 0 (string) for an i32-key map — the i32 key is then dereferenced
        // as a string pointer and segfaults. Store the FULL `Map[K, V]`
        // form map_key_kind_of expects (it keys on the `Map[i32,` prefix);
        // form map_key_kind_of / map_value_of expect (the `Map[i32,`
        // prefix drives the key dispatch, the `, V]` suffix the value).
        var umk: i32 = expr_map_kind(v.init, sb);
        if (umk >= 0) {
            var uktag: string = "string";
            if (umk == 1) { uktag = "i32"; }
            // Value tag from the outermost `.insert`'s value arg (the
            // literal's last entry; the map is homogeneous). A string
            // value records `Map[K, string]` so `m.get_or(k, d)` /
            // `.values()` track the result as a string; else default i32.
            // An empty literal (`Map {}`, no insert) keeps i32.
            var uvtag: string = "i32";
            match (v.init) {
                ast.ExprCall(uvc) => {
                    match (uvc.callee) {
                        ast.ExprFieldAccess(uvfa) => {
                            if (uvfa.field == "insert" && uvc.args.len() == 2) {
                                if (expr_is_str(uvc.args[1], sb)) { uvtag = "string"; }
                                // A 64-bit value (u64/i64 cast, wide literal,
                                // 64-bit local) records a 64-bit value tag, so
                                // the get_or read side width/sign-tracks it —
                                // the binding-site twin of expr_map_type_tag's
                                // value inference (#5253 follow-up).
                                else if (expr_is_u64(uvc.args[1], sb)) { uvtag = "u64"; }
                                else if (expr_is_f64(uvc.args[1], sb)) { uvtag = "f64"; }
                                else if (infer_expr_width(uvc.args[1], sb) == 64) { uvtag = "i64"; }
                                // A STRUCT value records `Map[K, P]`, so the get_or
                                // read side recovers P and `p.field` resolves without
                                // an annotation. Pointer-shaped like the string case
                                // above (widekind 0), so no op selection changes.
                                else if (decl_is_struct(sb.structs, expr_struct_type(uvc.args[1], sb))) { uvtag = expr_struct_type(uvc.args[1], sb); }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            sb = sb.mark_map_type(slot, "Map[" + uktag + ", " + uvtag + "]");
        }
    }
    // UNANNOTATED cell binding — `var c = cell_new(0)` (no `: Cell[i32]`).
    // The annotated form above records is_cell from the type spelling, but
    // without it the slot stayed plain and `c.get()` dispatched as a method on
    // the ELEMENT type ("call to unknown symbol i32.get") — the whole module
    // bailed. Recover the cell-ness (and the element kind) from the
    // `cell_new(x)` initialiser instead. #3457 slice 5.
    if (!sb.is_cell_slot(slot)) {
        var ucelt: string = cell_new_elem_tag(v.init, sb);
        if (ucelt.len() > 0) {
            sb = sb.mark_cell_elem(slot, ucelt);
        }
    }
    // UNANNOTATED binding from a map-RETURNING call (`var m = build()`,
    // `var m = c.make()`): recover the slot's map type from the callee's
    // registered return type (map_ret_fns), so `m.get_or(...)` dispatches
    // without a `: Map[K,V]` annotation. #3317.
    sb = mark_map_type_from_callee(v, slot, sb);
    // Binding from a closure BOX — a tuple element (`var f = t.0`, element
    // tagged "clo") or an fn-typed struct field (`var g = h.f`): mark the
    // binding a closure LOCAL so `f(args)` dispatches env-first against the
    // box — the closure sibling of the map-from-tuple-element bind above.
    // A NESTED-tuple element (`var inner = t.0` where t.0's tag is itself a
    // "(…)" tuple spelling) transfers the inner element tags onto the binding
    // (mark_tuple_elems) so `inner.N` reads — and an `inner.N(args)` closure
    // element call — resolve instead of bailing the module.
    sb = mark_nested_tuple_elems(v, slot, sb);
    // Record tuple element type tags for `var t = (e0, e1, ...)` so a
    // later `t.N` recovers each element's type.
    sb = mark_tuple_literal_elems(v, se, slot, sb);
    // TUPLE ANNOTATION as the last resort. Each initialiser arm above recovers
    // the element tags from the INITIALISER, and each covers only the shapes it
    // knows: the method arm keys `tuple_ret_type("<Struct>.<m>")`, so a method on
    // an Option/Result receiver (`var sa: (Option[i32], Option[string]) =
    // some.unzip()`) recorded nothing and `sa.0.unwrap_or(0)` dispatched as
    // `i32.unwrap_or` — an unknown symbol, bailing the module. The annotation
    // names every element authoritatively, so use it whenever nothing else did.
    //
    // Placed AFTER the match, and gated on the slot still being untagged, so
    // every binding that types itself today keeps its exact tags: this only
    // fills a hole, never overrides an inference.
    if (util.is_tuple_type_name(v.type_name) && sb.tuple_elem_tag(slot, 0).len() == 0) {
        sb = sb.mark_tuple_elems(slot, tuple_elem_tags(v.type_name)).mark_tuple_type(slot, v.type_name);
    }
    // Per-element rc kinds for a tuple built from bare idents (#7226). The
    // construction retain in lower_expr's ExprTuple arm incs an element naming an
    // rc-container local, so the tuple is a second owner; recording which
    // positions took one lets every site that frees the box give exactly those
    // back. The predicate here is the SAME slot_is_rc_container the retain uses,
    // on the same slots, so a position the construction declined is never in the
    // list and the two cannot drift.
    //
    // A `.trim()`-style VIEW slot is recorded "." — no release — even though the
    // construction retained it. Its own sweep frees it with __fern_str_view_free,
    // which frees the view BOX rather than decrementing a shared buffer, so a
    // second claim here would free a box the local still owns.
    //
    // "TUPSTRW:" is the other half of that guard, and it is about the OTHER
    // writers: this list is recorded from the var site's literal but replayed
    // against whatever box the slot holds, so an 's' is only sound when every
    // assign-form rebind agrees the position holds a counted owned string too
    // (assigns_str_pos_owned). Without the credit the position records "." and
    // the tuple's reference to the string leaks — the safe direction.
    if (sb.tuple_elem_tag(slot, 0).len() > 0
        && reclaim_has(sb.reclaimable_names, "TUPELEMOK:", sb.reclaim_site_key(slot))) {
        match (v.init) {
            ast.ExprTuple(tinit) => {
                var tk: string = "";
                var tki: i32 = 0;
                var tkany: boolean = false;
                var strw: boolean = reclaim_has(sb.reclaimable_names, "TUPSTRW:", sb.reclaim_site_key(slot));
                while (tki < tinit.elements.len()) {
                    var kc: string = ".";
                    match (tinit.elements[tki]) {
                        ast.ExprIdent(kid) => {
                            var kslot: i32 = sb.slot_of(kid.name);
                            if (sb.is_str_slot(kslot)) {
                                if (strw && !sb.is_str_view_local_slot(kslot)) { kc = "s"; tkany = true; }
                            } else if (sb.slot_is_rc_container(kslot)) {
                                kc = "a";
                                tkany = true;
                            }
                            // A STRUCT box the store MOVES — the source's last
                            // mention, so the tuple becomes its sole owner and this
                            // walk is the one release. Its own kind rather than
                            // "a"'s box-only dec, because a struct's release is a
                            // deep FIELD drop plus the box dec; the element type
                            // comes from the slot's tuple tags, so the kinds string
                            // stays one char per position.
                            //
                            // A LIVE source is recorded too, now that the tuple
                            // literal RETAINS a struct element: the tuple holds a
                            // counted reference, so this release is balanced whether
                            // or not the source outlives the store. Both walks run
                            // under __fern_rc_is_unique (emit_tup_struct_elem_release
                            // passes shared=true, and the source's own sweep is
                            // SINKSHARE-gated), so whichever owner finds rc 1 does
                            // the deep work and the order stops mattering.
                            else if (kslot >= 0 && decl_is_struct(sb.structs, sb.tuple_elem_tag(slot, tki))) {
                                kc = "t";
                                tkany = true;
                            }
                        },
                        _ => {}
                    }
                    tk = tk + kc;
                    tki = tki + 1;
                }
                if (tkany) { sb = sb.add_tup_elem_kinds(util.i32_to_string(slot) + "|" + tk); }
            },
            _ => {}
        }
    }
    // A u32 / u32[] binding marks the slot u32 so its arithmetic wraps at
    // 2^32 and its `>>` is logical (expr_is_u32 / the binary-op masking).
    // An un-annotated binding has an empty type_name, so also infer the
    // u32 / u64-ness from the INITIALIZER (`var a = X as u32`) — otherwise
    // a later `a > b` emits a SIGNED compare, wrong once bit 31/63 is set
    // (visible on wasm's true-32-bit `i32.gt_s`; #3537).
    if (is_u32_type_name(v.type_name) || (v.type_name == "" && expr_is_u32(v.init, s))) { sb = sb.mark_u32(slot, true); }
    if (is_u64_type_name(v.type_name) || (v.type_name == "" && expr_is_u64(v.init, s))) { sb = sb.mark_u64(slot, true); }
    // A u8 (or array thereof) binding records the sub-word
    // kind so the slot's arithmetic wraps back to width (mark_subword /
    // expr_subword_kind / the binary-op masking) — the sub-32-bit
    // sibling of the u32 wrap above.
    if (subword_kind_of_name(v.type_name) != "") { sb = sb.mark_subword(slot, subword_kind_of_name(v.type_name)); }
    // Retain (alias) + cow-guarded dec-on-overwrite of the slot's prior
    // value (the loop-rebind reclamation; null on the first binding, so
    // a no-op there). An owned array slot drives the release; a fresh,
    // non-escaping struct local (slot_is_reclaimable_struct) OR tuple local
    // (slot_is_reclaimable_tuple) drives the same release so a loop-allocated
    // struct / tuple temporary is freed each iteration instead of leaking
    // (native reclaims it; the self-host must too). The dec is SHALLOW
    // (__fern_rc_dec → box release), so a tuple's pointer elements stay
    // leak-mode — only the box is reclaimed, matching the exit sweep. No
    // alias_inc for structs / tuples — an aliased one is never reclaimable
    // (its name escapes via the RHS), so it is left to leak.
    // A fresh, non-escaping heap-STRING local (slot_is_reclaimable_str)
    // takes the string-specific reclaim store instead: it must free through
    // __fern_str_free, which releases the data buffer as well as the box,
    // where emit_arr_store's __fern_rc_dec would reclaim the box alone. It
    // carries alias_inc across, so an aliasing bind retains the shared box
    // (#7282). Loop-body re-binds free the prior iteration's box; the final
    // value is freed by the exit string sweep.
    // Dead-alias-cancelled bind (#4402 opt 1): a plain store is the whole
    // bind. No retain was taken, so the dec-on-overwrite must not fire
    // either — on a loop's second iteration the slot holds the source's
    // PRIOR box, which the source's own rebind already freed at rc 1, and
    // the cow-guarded free below would free it again (native skips
    // emitVarReinitDropOld at borrowed-alias sites for the same reason).
    // Only the cancellation elide above marks the BIND slot moved_elided
    // (every other caller marks a pre-existing SOURCE slot, whose index is
    // lower), so membership here means exactly "this bind is cancelled".
    if (slot_list_has(sb.moved_elided, slot)) { return sb.emit(ir.op_store_local(slot)); }
    if (slot_is_reclaimable_str(sb, slot)) { return emit_str_reclaim_store(sb, slot, vt.alias_inc); }
    // A reclaimable rc-TUPLE loop-local (`while { var t = (i, [i, i+1]); }`): the
    // loop-rebind must DEEP-drop the prior tuple's fresh array element(s) before the
    // box, else the array leaks each iteration (the shallow emit_arr_store dec below
    // frees only the box; #4357). emit_tuple_deep_reinit_store frees only the
    // ExprArray element positions (a bare-ident pointer element aliases a live local
    // → left leak-safe), so it is gated on the init being a tuple literal.
    // A reclaimable rc-payload ENUM loop-local (`while { var b = Full([i, i+1]);
    // match (b) { Full(xs) => xs[0], … } }`): the loop-rebind must DEEP-drop the
    // prior enum's payload + box (emit_enum_deep_reinit_store → emit_enum_variant_
    // drops), else the payload leaks each iteration — the consuming-match reclaim is
    // top-level-only, so it never covers a loop-local (#4357).
    if (slot_is_reclaimable_rcenum(sb, slot)) {
        return emit_enum_deep_reinit_store(sb, slot, sb.struct_type_of_slot(slot));
    }
    // A reclaimable ALL-SCALAR enum loop-local (`while { var m: M = A(i); }`):
    // the re-declaration must release the box it supersedes. A shallow dec is the
    // whole release — every payload is a scalar — so emit_arr_store's cow-guarded
    // do_dec branch is exactly right, the same one a scalar-tuple rebind takes.
    if (slot_is_reclaimable_scenum(sb, slot)) {
        return emit_arr_store(sb, slot, false, true);
    }
    match (v.init) {
        ast.ExprTuple(dtl) => {
            if (slot_is_reclaimable_rctuple(sb, slot)) {
                return emit_tuple_deep_reinit_store(sb, slot, dtl);
            }
        },
        _ => {}
    }
    // A reclaimable Option[<tuple-with-array>] LOOP-LOCAL (#4365): the loop-rebind
    // must deep-drop the prior iteration's Some payload tuple (array buffers +
    // nested boxes) + the option box before the store, else all levels leak per
    // iteration. emit_opttup_reclaim_store inlines the tag-check + type-driven
    // tuple deep-drop.
    if (slot_is_reclaimable_opttup(sb, slot)) {
        return emit_opttup_reclaim_store(sb, slot, opttup_inner_type(sb.locals[slot].opt_type));
    }
    // A reclaimable Option[<struct-with-array>] LOOP-LOCAL (#4365): the struct sibling —
    // deep-drop the prior iteration's Some payload struct (rc fields via __struct_drop_<P>)
    // + the option box before the store.
    if (slot_is_reclaimable_optstruct(sb, slot)) {
        return emit_optstruct_reclaim_store(sb, slot, opt_payload_type(sb.locals[slot].opt_type, "Some"));
    }
    // A reclaimable Option[<scalar-arr-of-arr>] LOOP-LOCAL (#4365): the arr-of-arr sibling —
    // deep-drop the prior iteration's Some payload (inner buffers + outer via
    // __fern_arrarr_free) + the option box before the store.
    // Both gated on !slot_nodeep: a "NODEEP:"-qualified Option slot is an ALIAS
    // (#7687). It owns no payload to deep-drop, and these helpers take no
    // alias_inc — routing the bind through one drops the retain on the floor and
    // leaves two slots decing a box with one count, which the census reads as a
    // clean 200/200 and only __rc_underflow() dissents on. It falls through to
    // emit_arr_store below, which emits the retain and a shallow dec of the
    // superseded box.
    if (slot_is_reclaimable_optarr(sb, slot) && !slot_nodeep(sb, slot)) {
        return emit_optarr_reclaim_store(sb, slot);
    }
    if (slot_is_reclaimable_optstr(sb, slot) && !slot_nodeep(sb, slot)) {
        return emit_optstr_reclaim_store(sb, slot);
    }
    if (slot_is_reclaimable_optarrarr(sb, slot)) {
        return emit_optarrarr_reclaim_store(sb, slot);
    }
    // A reclaimable struct LOOP-LOCAL whose init is a FRESH no-base literal with a
    // `string` field set from a FRESH string (`while { var t = S { x: i, name: pre
    // + "x" }; }`): the loop-rebind must DEEP-drop the prior box's STRING too, else
    // the string box leaks every iteration (the array-only __field_reclaim path
    // below skips strings; #4357). Route through __struct_drop + box dec
    // (emit_struct_deep_reinit_store), which frees the k_str field. Gated on
    // struct_lit_all_string_fields_fresh so old's string is provably sole-owned
    // (rc=1) — an ALIASED string field would over-release (strdrop-two-alias), so
    // it falls through to the array-only path (string leak-safe). The exit sweep is
    // NOT widened (it can't see the construction site), so a non-fresh string still
    // rides its existing balanced path; only this per-iteration reclaim is added.
    match (v.init) {
        ast.ExprStructLit(dsl) => {
            if (!dsl.has_base && slot_is_reclaimable_struct(sb, slot) && !slot_nodeep(sb, slot)
                && struct_has_string_field(sb.structs, vt.struct_ty)
                && struct_lit_all_string_fields_fresh(sb.structs, dsl, sb)) {
                return emit_struct_deep_reinit_store(sb, slot, vt.struct_ty);
            }
        },
        _ => {}
    }
    // A reclaimable struct LOOP-LOCAL carrying a DIRECT enum field
    // (`while { var t = Tagged { e: Poly([i, i+1]), n: i }; }`): the loop-rebind
    // must DEEP-drop the prior box's enum-field VARIANT PAYLOAD, else it leaks every
    // iteration — the array-only __field_reclaim path below skips enum fields
    // entirely, and the exit sweep's k_enum arm is a shallow box-only dec (#4357,
    // #4297 A2 follow-up). Route through emit_struct_enum_deep_reinit_store, which
    // runs emit_enum_variant_drops on each enum field's box (runtime variant dispatch
    // → drop the payload, free the enum box) then frees the struct box. Gated on
    // struct_enum_deep_reinit_eligible (scalar + droppable-enum fields only) AND
    // struct_lit_all_enum_fields_fresh (every enum field a FRESH variant ctor, so
    // old's payload is provably sole-owned — an ALIASED enum field would over-release,
    // so it falls through to the leak-safe array/shallow path). The exit sweep is NOT
    // widened (it can't see the construction site); only this per-iteration reclaim
    // is added, so the once-off final-box payload leak stays bounded.
    match (v.init) {
        ast.ExprStructLit(desl) => {
            if (!desl.has_base && slot_is_reclaimable_struct(sb, slot) && !slot_nodeep(sb, slot)
                && struct_enum_deep_reinit_eligible(sb.structs, vt.struct_ty)
                && struct_lit_all_enum_fields_fresh(sb.structs, desl)) {
                return emit_struct_enum_deep_reinit_store(sb, slot, vt.struct_ty);
            }
        },
        _ => {}
    }
    // A reclaimable struct LOOP-LOCAL with rc-array fields (`while { var t = f(i)
    // / P { .., xs: [..] }; … }`): the loop-rebind must DEEP-drop the prior
    // iteration's box — free its rc-array field buffers before freeing the box —
    // else those buffers leak every iteration (the shallow emit_arr_store dec
    // below frees only the box; #4357). Route through the same per-type
    // __field_reclaim_<T> the StmtAssign consume-rebind uses (emit_field_reclaim_
    // store, snap=-1): the helper null-guards the first-iteration null `old` and
    // cow-guards a self-store, so it is safe both here and on the initial bind
    // (which is a plain store of `new` — no prior box to free). A once-bound
    // (non-loop) local is unaffected: old is null, so only the store happens, and
    // the exit sweep still frees the final value.
    if (slot_is_reclaimable_struct(sb, slot) && !slot_nodeep(sb, slot) && sb.struct_routes_field_reclaim(vt.struct_ty)) {
        return emit_field_reclaim_store(sb, slot, vt.struct_ty, 0 - 1);
    }
    // Reclaimable arr-of-arr LOOP-LOCAL (#4355 slice 9): the re-declaration
    // must free the prior iteration's whole two-level structure before the
    // store — the shallow emit_arr_store dec (were is_arr even set) would
    // free only the outer buffer and leak every inner per iteration.
    if (slot_is_reclaimable_arrarr(sb, slot)) {
        return emit_arrarr_reclaim_store(sb, slot);
    }
    // Reclaimable closure-ARRAY LOOP-LOCAL (#4354): free the prior iteration's
    // element boxes with the buffer. The credit, not the is_closurearr flag,
    // routes it: an annotated empty literal grown by `.append` earns the flag
    // only at the append, which lowers after this bind.
    if (slot_is_reclaimable_cloarr(sb, slot)) {
        return emit_arrarr_reclaim_store(sb, slot);
    }
    // Reclaimable Option[<arr>][] LOOP-LOCAL (#4365): same shape as the
    // arr-of-arr rebind above — free the prior iteration's payload buffers +
    // option boxes + outer buffer before the store, else all three levels
    // leak per iteration (the shallow emit_arr_store dec frees only the
    // outer buffer).
    if (slot_is_reclaimable_optaarr(sb, slot)) {
        return emit_optaarr_reclaim_store(sb, slot);
    }
    // Reclaimable (<tuple-with-array>)[] LOOP-LOCAL (#4365): free the prior
    // iteration's whole structure — each element tuple's array fields + tuple box,
    // then the outer buffer — before the store, else all levels leak per iteration
    // (the shallow emit_arr_store dec frees only the outer buffer).
    if (slot_is_reclaimable_arrtup(sb, slot)) {
        return emit_arrtup_reclaim_store(sb, slot, sb.locals[slot].arrarr_elem);
    }
    // Reclaimable `MyEnum[]` LOOP-LOCAL (#5474): free the prior iteration's element
    // enum boxes (payload + box, via the runtime variant dispatch) and the outer
    // buffer. The shallow emit_arr_store dec below frees only the buffer, which is
    // why every element box leaked per iteration.
    if (slot_is_reclaimable_arrenum(sb, slot)) {
        return emit_arrenum_reclaim_store(sb, slot, arrenum_enum_of_slot(sb, slot));
    }
    // Reclaimable (<struct-with-array>)[] LOOP-LOCAL (#4365): free the prior iteration's
    // whole structure — each element struct's rc fields + struct box, then the outer
    // buffer — before the store (the shallow emit_arr_store dec frees only the buffer).
    if (slot_is_reclaimable_arrstruct(sb, slot)) {
        return emit_arrstruct_reclaim_store(sb, slot, sb.struct_type_of_slot(slot));
    }
    // Reclaimable SCALAR-FIELD struct-array LOOP-LOCAL (#4355): a struct[] whose
    // element struct has no rc field — the deep arrstruct path above skips it, so
    // free the prior iteration's element boxes + outer buffer here (shallow box dec
    // per element via __fern_arrarr_free), else every element struct box leaks per
    // iteration. Disjoint from arrstruct (slot_is_reclaimable_structarr excludes
    // field-routing structs), so at most one of these two branches fires per slot.
    // A STRUCTARR element struct that ROUTES FIELD RECLAIM takes the DEEP walk
    // instead (#6127): slot_is_reclaimable_structarr excludes rc-array-field
    // structs, so this can only be a STRFLDOK-admitted string / string[] / fn
    // -fielded element, whose field the shallow per-element box dec never reaches.
    // A bare local of the same struct already reclaims its string through
    // __field_reclaim_<T>'s STRFLDOK arm; it was only the ELEMENT walk that did
    // not, so the array form leaked one string box per element per iteration.
    if (slot_is_reclaimable_structarr(sb, slot) && sb.struct_routes_field_reclaim(sb.struct_type_of_slot(slot))) {
        return emit_arrstruct_reclaim_store(sb, slot, sb.struct_type_of_slot(slot));
    }
    if (slot_is_reclaimable_structarr(sb, slot)) {
        return emit_structarr_reclaim_store(sb, slot);
    }
    // A reclaimable string[] LOOP-LOCAL (`while { var xs: string[] = [pre + "x",
    // pre + "y"]; … }`, #4353 item 4 / #4355 loop-rebind follow-up): the
    // re-declaration must free the prior iteration's ELEMENT strings AND buffer
    // via __fern_str_arr_free before the store, else every element box leaks per
    // iteration — the shallow emit_arr_store dec below frees only the buffer. The
    // exit sweep already frees the FINAL value with the same helper (16565); this
    // is the missing per-iteration sibling (str reinit at 12958 covers a scalar
    // string, structarr above covers struct elements — string elements had no
    // reinit branch). Cow-guarded + null-guarded like every store above.
    if (slot_is_reclaimable_strarr(sb, slot)) {
        return emit_strarr_reclaim_store(sb, slot, vt.alias_inc);
    }
    // A reclaimable MAP loop-local (`while { var m = map_new(8); m =
    // m.insert(..); … }`, #4357): free the prior iteration's keys/values
    // buffers + mapbox BEFORE the store, else one box leaks per iteration —
    // precise_drop_names is top-level-only so a loop-declared map never gets
    // an early drop, and the exit sweep only sees the final iteration's box.
    // emit_map_buffers_free is stack-neutral (the reinit RHS underneath is
    // untouched), null-guards the first binding (slots are zero-initialized
    // at entry), zeroes the slot (the store below then overwrites it), and
    // internally selects the MAPVS/MAPKS deep-column variants — the same
    // coexistence contract the precise drop and exit sweep already use. The
    // store itself is the unchanged shared tail.
    if (slot_is_reclaimable_map(sb, slot)) {
        sb = emit_map_buffers_free(sb, slot);
    }
    // A reclaimable tuple that retained a bare-ident element takes the tuple
    // reclaim store, so the rebind gives those retains back with the box it
    // supersedes (#7226). alias_inc never co-occurs — the credit is for a fresh
    // tuple literal, which is a move, not an alias.
    var vtek: string = sb.tup_elem_kinds_of(slot);
    if (vtek.len() > 0 && !vt.alias_inc && slot_is_reclaimable_tuple(sb, slot)) {
        return emit_tup_elem_reclaim_store(sb, slot, vtek);
    }
    return emit_arr_store(sb, slot, vt.alias_inc, vt.is_arr || slot_is_reclaimable_struct(sb, slot) || slot_is_reclaimable_tuple(sb, slot) || opt_alias_slot_boxonly(sb, slot));
    return s.fail();
}

function mark_enum_arr_share(v: ast.StmtVar, se: LowerState, sb: LowerState): LowerState {
match (v.init) {
    ast.ExprStructLit(nsl) => {
        var nfi: i32 = 0;
        while (nfi < nsl.field_values.len()) {
            if (nfi < nsl.field_names.len()) {
                var nft: string = decl_field_type(sb.structs, nsl.type_name, nsl.field_names[nfi]);
                var nsrc: string = enum_arr_field_share_read(nsl.field_values[nfi], nft, se);
                // The string limb of the same share. Kept as a separate
                // predicate rather than widened into the array one: that one
                // bottoms out in array-ness tests a `type A | B` union passes.
                if (nsrc.len() == 0) {
                    nsrc = str_field_share_read(nsl.field_values[nfi], nft, nsl.type_name, se);
                }
                if (nsrc.len() > 0) {
                    var nkey: string = reclaim_site_key_of(v.name, v.line, v.col);
                    sb = sb.drop_reclaim_row("NODEEP:" + nkey);
                    sb = sb.add_reclaim_row("FLDCHECKED:" + nkey);
                    var nssl: i32 = se.slot_of(nsrc);
                    if (nssl >= 0) {
                        sb = sb.drop_reclaim_row("NODEEP:" + se.reclaim_site_key(nssl));
                        sb = sb.add_reclaim_row("FLDCHECKED:" + se.reclaim_site_key(nssl));
                    }
                }
            }
            nfi = nfi + 1;
        }
    },
    _ => {}
}

    return sb;
}

function mark_tuple_elem_binding(v: ast.StmtVar, slot: i32, sb: LowerState): LowerState {
match (v.init) {
    ast.ExprCall(tfc) => {
        match (tfc.callee) {
            ast.ExprIdent(tfcid) => {
                var tff: string = tuple_ret_flags_of(sb.sigs.tuple_fresh_ret_fns, tfcid.name);
                if (util.contains(tff, "1")
                    && reclaim_has(sb.reclaimable_names, "TUPELEMOK:", sb.reclaim_site_key(slot))) {
                    var tfk: string = "";
                    var tfi: i32 = 0;
                    while (tfi < tff.len()) {
                        if (tff[tfi] == b'1') { tfk = tfk + "a"; } else { tfk = tfk + "."; }
                        tfi = tfi + 1;
                    }
                    sb = sb.add_tup_elem_kinds(util.i32_to_string(slot) + "|" + tfk);
                }
            },
            _ => {}
        }
    },
    _ => {}
}

    return sb;
}

function mark_map_elem_array(v: ast.StmtVar, vt: VarTypes, se: LowerState, slot: i32, sb: LowerState): LowerState {
if (vt.is_arr) {
    var map_elem_ty: string = "";
    if (is_array_type_name(v.type_name) && is_map_type_name(slice_unchecked(v.type_name, 0, v.type_name.len() - 2))) {
        map_elem_ty = slice_unchecked(v.type_name, 0, v.type_name.len() - 2) + "";
    } else {
        match (v.init) {
            ast.ExprArray(marr) => {
                if (marr.elements.len() > 0) { map_elem_ty = expr_map_type_tag(iife_leaf_value(marr.elements[0]), se); }
            },
            ast.ExprIdent(amid) => {
                var amsl: i32 = se.slot_of(amid.name);
                if (amsl >= 0 && se.is_arr_slot(amsl) && is_map_type_name(se.map_type_of(amsl))) { map_elem_ty = se.map_type_of(amsl); }
            },
            _ => {}
        }
    }
    if (is_map_type_name(map_elem_ty)) { sb = sb.mark_map_type(slot, map_elem_ty); }
}

    return sb;
}

function mark_map_type_from_callee(v: ast.StmtVar, slot: i32, sb: LowerState): LowerState {
if (!is_map_type_name(v.type_name) && sb.map_type_of(slot) == "") {
    match (v.init) {
        ast.ExprCall(mrc) => {
            match (mrc.callee) {
                ast.ExprIdent(mrcid) => {
                    var mrt0: string = sb.map_ret_type(mrcid.name);
                    if (mrt0 != "") { sb = sb.mark_map_type(slot, mrt0); }
                },
                ast.ExprFieldAccess(mrcfa) => {
                    var mroty: string = expr_struct_type(mrcfa.obj, sb);
                    if (mroty != "") {
                        var mrt1: string = sb.map_ret_type(mroty + "." + mrcfa.field);
                        if (mrt1 != "") { sb = sb.mark_map_type(slot, mrt1); }
                    }
                },
                _ => {}
            }
            // typed-IR (#5986): a map-returning call no registry keys (a
            // fn-typed local, an IIFE) answers from the checker's stamp.
            if (sb.map_type_of(slot) == "" && is_map_type_name(mrc.ty)) { sb = sb.mark_map_type(slot, mrc.ty); }
        },
        // UNANNOTATED binding from a map TUPLE element (`var m = t.0`):
        // recover the slot's map type from the element's recorded tuple
        // tag, so `m.get_or(...)` dispatches — the map sibling of the
        // struct-from-tuple-element binding. #3317.
        ast.ExprFieldAccess(mtfa) => {
            if (util.is_all_digits(mtfa.field)) {
                var mtet: string = expr_tuple_elem_tag(mtfa.obj, util.digits_to_i32(mtfa.field), sb);
                if (is_map_type_name(mtet)) { sb = sb.mark_map_type(slot, mtet); }
            }
        },
        // UNANNOTATED binding from a map ARRAY element (`var m = ms[i]`):
        // recover the slot's map type from the array slot's element map
        // type — the map sibling of the struct-from-array-element
        // binding. #3317.
        ast.ExprIndex(maix) => {
            match (maix.array) {
                ast.ExprIdent(maeid) => {
                    var maesl: i32 = sb.slot_of(maeid.name);
                    if (maesl >= 0 && sb.is_arr_slot(maesl) && is_map_type_name(sb.map_type_of(maesl))) { sb = sb.mark_map_type(slot, sb.map_type_of(maesl)); }
                },
                _ => {}
            }
            // A map element of an array the walk cannot classify: the stamped
            // element tag carries the same canonical spelling (#5986).
            if (sb.map_type_of(slot) == "" && is_map_type_name(maix.ty)) { sb = sb.mark_map_type(slot, maix.ty); }
        },
        _ => {}
    }
}

    return sb;
}

function mark_nested_tuple_elems(v: ast.StmtVar, slot: i32, sb: LowerState): LowerState {
match (v.init) {
    ast.ExprFieldAccess(ctfa) => {
        if (util.is_all_digits(ctfa.field)) {
            var ctet: string = expr_tuple_elem_tag(ctfa.obj, util.digits_to_i32(ctfa.field), sb);
            if (ctet == "clo") { sb = sb.mark_closure_local(v.name); }
            else if (util.is_tuple_type_name(ctet)) { sb = sb.mark_tuple_elems(slot, tuple_elem_tags(ctet)).mark_tuple_type(slot, ctet); }
        } else {
            // `var t = s.p` where struct field `p` is a TUPLE type: transfer the
            // field's tuple element tags onto t (the struct-field sibling of the
            // digit-field and array-element binds above), so `t.N` reads and a
            // `t.N(args)` closure-element call resolve. Without it t was untyped
            // and `t.1()` on an fn (`clo`) element bailed the module on `call`.
            var sfoty: string = expr_struct_type(ctfa.obj, sb);
            if (sfoty != "") {
                var sfft: string = decl_field_type(sb.structs, sfoty, ctfa.field);
                if (util.is_tuple_type_name(sfft)) { sb = sb.mark_tuple_elems(slot, tuple_elem_tags(sfft)).mark_tuple_type(slot, sfft); }
                // `var g = h.f` where struct field `f` is fn-typed: the field
                // holds a closure BOX, so g is a closure local and `g(args)`
                // must dispatch env-first. Without this g looked like a bare
                // code pointer and the call jumped to the box address (#7862).
                else if (is_fn_payload_spelling(sfft) || sfft == "fn" || sfft == "clo") { sb = sb.mark_closure_local(v.name); }
            }
        }
    },
    // A tuple ELEMENT of an array-of-tuples (`var t = a[0]` where a's
    // arrarr_elem carries the "(…)" element tuple tag): transfer the
    // element tags onto the binding, the Index sibling of the nested-
    // tuple transfer above — so `t.N` reads and a `t.N(args)` closure
    // element call resolve (before, the module bailed and the legacy AST
    // path miscompiled the call into a nonexistent `i32.0` method).
    ast.ExprIndex(ctix) => {
        match (ctix.array) {
            ast.ExprIdent(ctaid) => {
                var ctasl: i32 = sb.slot_of(ctaid.name);
                if (ctasl >= 0 && sb.is_arr_slot(ctasl)) {
                    var ctaet: string = sb.arrarr_elem_of_slot(ctasl);
                    if (util.is_tuple_type_name(ctaet)) { return sb.mark_tuple_elems(slot, tuple_elem_tags(ctaet)).mark_tuple_type(slot, ctaet); }
                }
            },
            // `var p = r.pairs[0]` — indexing a tuple-ARRAY struct FIELD
            // (`pairs: (i32, string)[]`). The field access has no slot to read
            // arrarr_elem from, so resolve the element tuple type from the
            // field's declared type and transfer its tags onto p, so `p.N`
            // reads (the struct-field sibling of the ExprIdent arm above).
            ast.ExprFieldAccess(ctafa) => {
                if (!util.is_all_digits(ctafa.field)) {
                    var ctaoty: string = expr_struct_type(ctafa.obj, sb);
                    if (ctaoty != "") {
                        var ctaft: string = decl_field_type(sb.structs, ctaoty, ctafa.field);
                        if (ctaft.len() >= 4 && slice_unchecked(ctaft, ctaft.len() - 2, ctaft.len()) == "[]") {
                            var ctael: str = slice_unchecked(ctaft, 0, ctaft.len() - 2);
                            if (util.is_tuple_type_name(ctael)) { return sb.mark_tuple_elems(slot, tuple_elem_tags(ctael)).mark_tuple_type(slot, ctael); }
                        }
                    }
                }
            },
            _ => {}
        }
        // typed-IR (#5986): `var t = mk()[0]` — a tuple element of an array
        // neither walk case reaches. The third reader of the arrarr_elem
        // walk, and the one that never got the ix.ty fallback its two
        // siblings (expr_tuple_elem_tag, the destructure) did.
        if (util.is_tuple_type_name(ctix.ty)) { sb = sb.mark_tuple_elems(slot, tuple_elem_tags(ctix.ty)).mark_tuple_type(slot, ctix.ty); }
    },
    _ => {}
}

    return sb;
}

function mark_tuple_literal_elems(v: ast.StmtVar, se: LowerState, slot: i32, sb: LowerState): LowerState {
match (v.init) {
    ast.ExprCall(mc) => {
        match (mc.callee) {
            ast.ExprIdent(mcid) => {
                if ((mcid.name == "map_new" || mcid.name == "map_new_i32") && v.type_name.len() >= 5 && slice_unchecked(v.type_name, 0, 4) == "Map[") {
                    var inner: str = slice_unchecked(v.type_name, 4, v.type_name.len());
                    if (inner.len() >= 4 && slice_unchecked(inner, 0, 4) == "i32,") { sb = sb.mark_map_type(slot, "i32"); }
                    else if (inner.len() >= 7 && slice_unchecked(inner, 0, 7) == "string,") { sb = sb.mark_map_type(slot, "string"); }
                }
                // `var t = f()` where f returns a tuple: record its
                // element tags so a later `t.N` recovers each type. An
                // erased-generic callee's "$arg<i>" segments resolve to
                // the actual arguments' inferred tags here.
                var mctt: string = sb.tuple_ret_type(mcid.name);
                if (mctt.len() > 0) { return sb.mark_tuple_elems(slot, resolve_argref_tuple_tags(mctt, mc.args, sb)); }
            },
            ast.ExprFieldAccess(mfa) => {
                // `var t = obj.f()` where the method returns a tuple:
                // key by "<Type>.<method>".
                var mrty: string = expr_struct_type(mfa.obj, sb);
                if (mrty != "") {
                    var mmtt: string = sb.tuple_ret_type(mrty + "." + mfa.field);
                    if (mmtt.len() > 0) { return sb.mark_tuple_elems(slot, resolve_argref_tuple_tags(mmtt, mc.args, sb)); }
                }
            },
            // `var t = match (e) { V(p) => p, .. }` where the result is a
            // TUPLE payload returned whole (an IIFE: ExprCall{callee:
            // ExprLambda}). The leaf is a bare bound payload not in scope at
            // this site, so recover the element tags from the match's
            // composite result type. Prefer a tuple TYPE annotation
            // (`var t: (i32, string) = …`) when present — it names a
            // Result[T,E] element's E that a bare construction can't.
            ast.ExprLambda(mlam) => {
                if (util.is_tuple_type_name(v.type_name)) {
                    return sb.mark_tuple_elems(slot, tuple_elem_tags(v.type_name)).mark_tuple_type(slot, v.type_name);
                }
                var mltt: string = iife_lambda_composite_tuple_tags(mlam, sb);
                if (mltt != "") { return sb.mark_tuple_elems(slot, mltt); }
            },
            _ => {}
        }
        // typed-IR (#5986): a tuple-returning call no registry keys (a
        // fn-typed local, a method on an unresolvable receiver) answers
        // from the checker's stamped "(t0, t1, …)" spelling.
        if (util.is_tuple_type_name(mc.ty)) { sb = sb.mark_tuple_elems(slot, tuple_elem_tags(mc.ty)).mark_tuple_type(slot, mc.ty); }
    },
    ast.ExprTuple(tlit) => {
        var enc: string = "";
        // A tuple TYPE annotation carries each element's full type — in
        // particular a Result[T, E] element's E, which a bare `Ok(x)`
        // construction cannot name. Prefer it so `match (t.N)` recovers
        // each element's payload; fall back to the construction's
        // inferred tags for an un-annotated binding. (For scalar /
        // struct / Option / nested-tuple elements the two agree, so
        // this is strictly more accurate.)
        if (util.is_tuple_type_name(v.type_name)) {
            var tti: i32 = 0;
            while (tti < tlit.elements.len()) {
                if (tti > 0) { enc = enc + ","; }
                enc = enc + tuple_type_elem_tag(v.type_name, tti);
                tti = tti + 1;
            }
        } else {
            var ti: i32 = 0;
            while (ti < tlit.elements.len()) {
                if (ti > 0) { enc = enc + ","; }
                enc = enc + elem_type_tag(tlit.elements[ti], se);
                ti = ti + 1;
            }
        }
        sb = sb.mark_tuple_elems(slot, enc);
        if (util.is_tuple_type_name(v.type_name)) { sb = sb.mark_tuple_type(slot, v.type_name); }
    },
    // `var t: (i32, string) = f()?` — a try-operator init (parsed as a
    // `try_` unary). lower_try now admits a tuple success payload (read
    // as the pointer-width box, like a struct), but the leaf is the
    // unwrapped value not in scope here, so type the slot from the
    // tuple TYPE annotation (authoritative — it names each element,
    // including a Result[T,E] element's E) so a later `t.N` resolves.
    ast.ExprUnary(tuv) => {
        if (util.is_tuple_type_name(v.type_name)) {
            sb = sb.mark_tuple_elems(slot, tuple_elem_tags(v.type_name)).mark_tuple_type(slot, v.type_name);
        } else if (tuv.op == "try_") {
            // UNANNOTATED `var t = f()?` whose success payload is a tuple
            // (`f(): Option[(T, i32)]` / `Result[(T, i32), E]`): recover the
            // payload via try_opt_type (which resolves the erased-generic
            // "$arg<i>" refs from the call args) and tag the slot's element
            // types, so `t.0` / `t.1` read the right width / kind. Without
            // it an unannotated try-of-tuple left t untyped and a string
            // element's `.len()` read 0.
            var tuot: string = try_opt_type(tuv.operand, sb);
            var tupay: string = "";
            if (tuot.len() >= 8 && slice_unchecked(tuot, 0, 7) == "Option[") { tupay = opt_payload_type(tuot, "Some"); }
            else if (tuot.len() >= 8 && slice_unchecked(tuot, 0, 7) == "Result[") { tupay = opt_payload_type(tuot, "Ok"); }
            if (util.is_tuple_type_name(tupay)) { sb = sb.mark_tuple_elems(slot, tuple_elem_tags(tupay)).mark_tuple_type(slot, tupay); }
            // A STRUCT (or nominal ENUM) success payload: `var u = f()?` where
            // f returns `Result[User, E]` / `Option[User]`. Without the type
            // annotation the slot was left untyped, so `u.field` / `u.method()`
            // / `match (u)` in the body failed to lower and the module dropped
            // to AST. Carry the payload's struct/enum name (mark_struct_type) —
            // exactly what an explicit `var u: User = f()?` annotation does.
            else if (decl_is_struct(sb.structs, tupay) || is_enum_like_name(tupay, sb.structs)) { sb = sb.mark_struct_type(slot, tupay); }
            // An Option/Result success payload: `var o = f()?` where f returns
            // `Result[Option[i32], E]` / `Option[Option[i32]]`. The bracketed
            // spelling is neither struct nor enum-like, so carry it as the
            // slot's OPTION type — what an explicit `var o: Option[i32] = f()?`
            // annotation records at the mark_opt_type above. Without it the
            // slot is untyped and the following `match (o)` bails the module
            // to AST (never a miscompile, but off the IR path).
            else if (tupay.len() >= 8 && (slice_unchecked(tupay, 0, 7) == "Option[" || slice_unchecked(tupay, 0, 7) == "Result[")) { sb = sb.mark_opt_type(slot, tupay); }
        }
    },
    _ => {}
}

    return sb;
}

function lower_stmt_var(v: ast.StmtVar, s: LowerState): LowerState {
    // Type ascription `var x = E as T` (#2669): the `as` is a zero-cost
    // annotation, so this is `var x: T = E`. ascription_rebind returns
    // that rewritten binding (operand as init, T as the annotation) so
    // the existing array / string / struct slot-marking + RC accounting
    // run off the real value — leaving the slot untyped dropped the
    // alias-inc and broke `__rc`. Kept out of line so this huge arm
    // doesn't grow (oversized functions miscompile — cf. #2720).
    if (ascription_target(v.init) != "") { return lower_stmt(ascription_rebind(v), s); }
    // Struct destructure `let Point { x, y } = E;` — parse_struct_destructure
    // encodes it as a StmtVar whose type_name is "@sd:<Struct>:<fields>" and
    // whose name is the comma-joined bindings. Expand it into per-field binds.
    if (parser.is_struct_destr_marker(v.type_name)) {
        return lower_struct_destructure(v, s);
    }
    // Binding a SCALAR-element array struct field (`var y = h.items`,
    // items: i32[]/f64[]/i64[]) aliases the array: `y` becomes a second
    // owner of the field's buffer. Lower it via the IR with a Perceus dup
    // (RC-frontier slice 2): read the field (struct_get pushes the array
    // pointer), retain it (__fern_rc_inc — a BARE inc, the pointer stays on
    // the operand stack for the store, the slice-1 idiom), then bind `y` as
    // an rc-tracked array local. Balance: the field's array is rc N; the inc
    // makes it N+1; the exit-sweep decs y back to N; the struct's own
    // field-drop decs the field on the box's reclamation → 0. Sound (the inc
    // matches both later decs; no move detection, never under-frees). Only
    // the scalar-element field (scalar_arr_field_type != ""); array-of-
    // struct / array-of-enum fields still bail (deep-drop recursion is a
    // later slice).
    // `var tmp: N = first.node` (node: N, N an enum) binds an UNCOUNTED alias of
    // the source struct's enum box (#6121). No dup here — an alias that never
    // escapes must not outlive the struct — only the mark, so a later container
    // store of `tmp` retains exactly as the direct `[first.node]` read does.
    if (enum_field_read_type(v.init, s) != "") { s = s.mark_enum_field_alias(v.name); }
    var vfft: string = scalar_arr_field_type(v.init, s);
    if (vfft != "") {
        var vfs: LowerState = lower_expr(v.init, s);   // struct_get -> array ptr on stack
        if (!vfs.ok) { return vfs; }
        vfs = vfs.retain_tos(reclaim_site_key_of(v.name, v.line, v.col));   // Perceus dup (bare inc)
        var vfb: LowerState = vfs.add_local(v.name);
        vfb = vfb.mark_reclaim_site(vfb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
        var vfslot: i32 = vfb.slot_of(v.name);
        vfb = vfb.mark_arr(vfslot, true);
        if (is_float_array_type_name(vfft)) { vfb = vfb.mark_f64arr(vfslot, true); if (vfft == "f32[]") { vfb = vfb.mark_f32arr(vfslot, true); } }
        else if (vfft == "i64[]") { vfb = vfb.mark_i64arr(vfslot, true); }
        // The dispatch-only boolean[] overlay (#6117). This branch RETURNS
        // before the VarTypes classification, so the element kind has to be
        // stamped here too — and it is the branch that matters for a field
        // receiver, because `b.flags.to_json()` snapshots into exactly this
        // shape of hidden `var` before the serialiser's loop indexes it.
        else if (vfft == "boolean[]") { vfb = vfb.mark_boolarr(vfslot, true); }
        return vfb.emit(ir.op_store_local(vfslot));
    }
    // Binding an ARRAY-OF-STRUCT field (`var ps: P[] = obj.params`,
    // params: P[]) OR an ARRAY-OF-ENUM field (`var es: E[] = obj.es`, E an
    // enum) aliases the array exactly like the scalar case above — the
    // Perceus dup is on the buffer POINTER, element-type-agnostic, and the
    // exit-sweep's shallow arr_dec balances it without touching the (source-
    // struct-owned) elements. So it lowers via the same dup-then-bind. The
    // slot is marked with the element struct/enum NAME (mark_struct_type
    // doubles as the element-type slot for both) so a later `ps[i].field` /
    // `match (es[i])` resolves the element shape. No deep-drop recursion is
    // needed for the bind: it borrows + counts the buffer; the source struct
    // still owns and reclaims the elements.
    var vsaft: string = struct_arr_field_read_type(v.init, s);
    if (vsaft == "") { vsaft = enum_arr_field_read_type(v.init, s); }
    if (vsaft != "") {
        var sas: LowerState = lower_expr(v.init, s);   // struct_get -> array ptr on stack
        if (!sas.ok) { return sas; }
        sas = sas.retain_tos(reclaim_site_key_of(v.name, v.line, v.col));   // Perceus dup (bare inc)
        var sab: LowerState = sas.add_local(v.name);
        sab = sab.mark_reclaim_site(sab.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
        var saslot: i32 = sab.slot_of(v.name);
        sab = sab.mark_arr(saslot, true);
        // A closure/fn ARRAY field (`hs: (() => T)[]`, spelled "fn[]") aliased
        // whole (`var fns = r.hs`): its elements are closure boxes, so mark the
        // slot is_closurearr for env-first `fns[i]()` / `for f in fns` dispatch
        // (#5160 defect #2). "fn" reads as enum-like (is_enum_like_name), so the
        // enum-array-field arm above — not the closurearr classification further
        // down — claims this bind; do the closure mark HERE. Also fixes
        // `for f in r.hs { f() }`, which lowers via lower_foreach_snapshot's
        // hidden `var $forit = r.hs`.
        // A registered fn-POINTER array field aliased whole (`var xs = r.hs`,
        // #5235): its elements are RAW fn pointers, so mark the slot is_fnarr (NOT
        // is_closurearr) — the slot is already mark_arr(true) above, so `xs[i]()`
        // dispatches via the plain fn-pointer-array call_indirect path, and a later
        // `xs.append(g)` of a bare named fn emits const_func. Checked before the
        // closure-array spelling so a fn-pointer field wins.
        if (field_access_is_fnarr(v.init, s)) { sab = sab.mark_fnarr(saslot, true); }
        else if (vsaft == "fn[]") { sab = sab.mark_closurearr(saslot, true); }
        else { sab = sab.mark_struct_type(saslot, slice_unchecked(vsaft, 0, vsaft.len() - 2)); }   // element struct/enum name (strip "[]")
        return sab.emit(ir.op_store_local(saslot));
    }
    if (is_scalar_arr_field_access(v.init, s)) { return s.fail(); }
    // `var xs: dyn Trait[] = [ ... ]` — a `dyn Trait` ARRAY literal. Each
    // element coerces to `dyn Trait`: a struct/enum element flows unboxed
    // (it carries its shape), a primitive/string element is heap-boxed via
    // op_dyn_box so it carries a shape pointer (docs/DYN-TRAITS.md
    // §4.2.3). lower_dyn_arg makes that per-element box/no-box choice; the
    // boxed pointers then ride one array slot each, and the slot is bound
    // is_arr with NO element struct type so `for x in xs` reads the loop
    // var as "unknown" → runtime shape dispatch (the §4.3 array tag fix).
    if (v.type_name.len() > 6 && slice_unchecked(v.type_name, 0, 4) == "dyn " && is_array_type_name(v.type_name)) {
        var dab_ok: boolean = false;
        match (v.init) { ast.ExprArray(_) => { dab_ok = true; }, _ => {} }
        if (dab_ok) {
            match (v.init) {
                ast.ExprArray(darr) => {
                    var das: LowerState = lower_dyn_array_lit(darr, s);
                    if (!das.ok) { return das; }
                    var dab: LowerState = das.add_local(v.name);
                    dab = dab.mark_reclaim_site(dab.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                    var daslot: i32 = dab.slot_of(v.name);
                    dab = dab.mark_arr(daslot, true);
                    // Record the coarse element type `"dyn <Trait>"` (strip
                    // the `[]`) on the slot — exactly as a `dyn Trait[]`
                    // PARAM does — so `xs[i]`, `var e = xs[i]`, and
                    // `for x in xs` over this LOCAL recover the receiver as
                    // `dyn Trait` and dispatch through op_dyn_dispatch.
                    // Without it the local lost its trait and every element
                    // method call bailed.
                    dab = dab.mark_struct_type(daslot, slice_unchecked(v.type_name, 0, v.type_name.len() - 2));
                    return dab.emit(ir.op_store_local(daslot));
                },
                _ => {}
            }
        }
    }
    // `var d: dyn Trait = <expr>` — a SCALAR `dyn Trait` binding (NOT a
    // `dyn Trait[]` array, handled above). The init coerces to `dyn Trait`
    // via lower_dyn_arg: a struct/enum value flows UNBOXED (it carries its
    // shape pointer), a primitive/string is heap-boxed via op_dyn_box so it
    // carries a shape pointer (docs/DYN-TRAITS.md §4.2.3). The slot's
    // local_struct_type is set to the coarse `"dyn <Trait>"` string (NOT
    // the concrete type) so a later `d.m()` reads the receiver's
    // expr_struct_type as `"dyn …"` and routes through op_dyn_dispatch
    // (runtime shape dispatch) — matching the interpreter — rather than
    // static-dispatching to the concrete impl.
    if (v.type_name.len() > 4 && slice_unchecked(v.type_name, 0, 4) == "dyn " && !is_array_type_name(v.type_name)) {
        var dvprim: string = expr_recv_prim_type(v.init, s);
        var dvs: LowerState = lower_dyn_arg(v.init, s);
        if (!dvs.ok) { return dvs; }
        var dvb: LowerState = dvs.add_local(v.name);
        dvb = dvb.mark_reclaim_site(dvb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
        var dvslot: i32 = dvb.slot_of(v.name);
        dvb = dvb.mark_struct_type(dvslot, v.type_name);
        // op_dyn_box COPIES a non-string primitive into a fresh rc-headered
        // cell, so the local owns that cell however the value was produced —
        // `k * 2` and a `var n: i32` alias alike. The escape verdict is the
        // whole admission, and reclaimable_names_of left it under "DYNCAND:"
        // because typing the init is this site's knowledge, not the AST scan's.
        // A "string" payload is excluded: its cell holds a POINTER whose box may
        // be borrowed, and the sweep's string tag frees that box too. A string
        // LITERAL init keeps the analysis-time credit that proves it fresh.
        if (dvprim.len() > 0 && dvprim != "string" && reclaim_has(dvb.reclaimable_names, "DYNCAND:", reclaim_site_key_of(v.name, v.line, v.col))) {
            dvb = LowerState { ...dvb, reclaimable_names: dvb.reclaimable_names.append("DYN:" + reclaim_site_key_of(v.name, v.line, v.col) + "|" + dvprim) };
        }
        return dvb.emit(ir.op_store_local(dvslot));
    }
    // `var f = r.hs[0]` where hs is a struct closure-array FIELD (#5160): f
    // aliases the element's closure box, which is OWNED by the struct (its
    // field reclaim frees it). Bind f a closure local for env-first `f()`
    // dispatch, but do NOT mark it is_arr — the exit-sweep must not dec the
    // BORROWED box (a second dec beyond the struct's own reclaim underflows its
    // rc). Distinct from the LOCAL element bind (`var c = fns[i]`, fns a
    // closure-array LOCAL) in the clo_init block below, which stays is_arr: a
    // local array is only shallow-dec'd at exit (its element boxes leak), so
    // that bind's dec is a sound partial free, not a double free. RC-soundness
    // follow-up to #5183.
    match (v.init) {
        ast.ExprIndex(cfe) => {
            match (cfe.array) {
                ast.ExprFieldAccess(_) => {
                    // `var f = r.hs[0]` where hs is a plain fn-POINTER array field
                    // (#5235): f aliases a RAW fn pointer element, OWNED by the
                    // struct (its field reclaim frees the buffer). Bind f a plain
                    // slot — do NOT mark_closure_local (so `f()` hits the ordinary
                    // ident indirect-call path, not env-first) and do NOT mark_arr
                    // (the exit sweep must not dec the struct-owned buffer). Checked
                    // before the closure-array arm; field_access_is_closurearr also
                    // declines a registered fnarr, so this ordering is belt-and-braces.
                    if (field_access_is_fnarr(cfe.array, s)) {
                        var fes: LowerState = lower_expr(v.init, s);   // arr_get -> fn pointer
                        if (!fes.ok) { return fes; }
                        var feb: LowerState = fes.add_local(v.name);
                        feb = feb.mark_reclaim_site(feb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                        var feslot: i32 = feb.slot_of(v.name);
                        return feb.emit(ir.op_store_local(feslot));
                    }
                    if (field_access_is_closurearr(cfe.array, s)) {
                        var ces: LowerState = lower_expr(v.init, s);   // arr_get -> element box ptr
                        if (!ces.ok) { return ces; }
                        var ceb: LowerState = ces.add_local(v.name);
                        ceb = ceb.mark_reclaim_site(ceb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                        var ceslot: i32 = ceb.slot_of(v.name);
                        ceb = ceb.mark_closure_local(v.name);
                        return ceb.emit(ir.op_store_local(ceslot));
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    // First-class closure binding (slice 3a): `var f = <lambda>` or
    // `var f = <call to a closure-returning fn>` — the init lowers to an
    // i32[] env box; bind f as an array slot AND mark it a closure local
    // so a later `f(args)` uses the env-passing closure-call form.
    var clo_init: boolean = false;
    // #5281: set when the init is a call producing a closure whose OWN call
    // returns another closure (`var g = pick()`, pick a `() => (() => T)`
    // factory) — mark the binding a RETCLO local below so a later `var h = g()`
    // binds h a closure local.
    var init_retclo: boolean = false;
    match (v.init) {
        ast.ExprLambda(_) => { clo_init = true; },
        ast.ExprCall(cc) => {
            // `var w: (i32) => i32 = (if (c) { f } else { g })` — a value-position
            // if/match parses as an IIFE, and its arms can yield closure BOXES.
            // Every other init form here says so and gets marked; this one did
            // not, so the slot stayed a plain scalar and `w(3)` bare-called the
            // box pointer as code — a SIGSEGV with no bail and no diagnostic,
            // which is why bail-counting never saw it (#6323).
            //
            // Marked only when EVERY arm yields a box (iife_arms_all_boxed): a
            // bare fn-name arm is a plain fn pointer, and box-dispatching that
            // is the same crash in the other direction.
            if (cc.args.len() == 0 && iife_callee_boxed_arms(cc.callee, s)) { clo_init = true; }
            match (cc.callee) {
                // A `__mkclo$<wrapN>()` env-box constructor marker — the
                // lift pass's boxed fn-value local binding `var g = dbl`
                // (slice #3445 follow-up). Its lowering (the ExprCall →
                // __mkclo$ arm) builds the env box, so bind g a closure
                // local: `g(args)` / passing g dispatch env-first.
                ast.ExprIdent(cid) => {
                    if ((cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") || util.index_of_str(s.sigs.closure_fns, cid.name) >= 0) { clo_init = true; }
                    // `var inner = outer()` where `outer` is itself a closure
                    // LOCAL whose return type is a fn (a closure factory
                    // returning a closure): the returned value is a closure BOX,
                    // so inner must dispatch env-first. Handles the ANNOTATED form
                    // (`var inner: fn = outer()`); the unannotated `var h = g()`
                    // rides the RETCLO markers below.
                    else if (s.is_closure_local(cid.name) && (v.type_name == "fn" || is_fn_payload_spelling(v.type_name))) { clo_init = true; }
                    // `var g = pick()` where pick returns a closure that ITSELF
                    // returns a closure (RETCLO2) — g is a closure local AND a
                    // RETCLO local (#5281). Covers the UNANNOTATED `var h = g()`
                    // case the fn-typed rule above misses (no type annotation).
                    if (util.index_of_str(s.sigs.closure_fns, "RETCLO2:" + cid.name) >= 0) { clo_init = true; init_retclo = true; }
                    // `var h = g()` where g is a RETCLO closure local — g()'s
                    // result is a closure box, so bind h a closure local; else
                    // `h()` bare-calls the box pointer as code (SIGSEGV).
                    if (s.is_closure_local("RETCLO$" + cid.name)) { clo_init = true; }
                },
                _ => { }
            }
            // A fn-typed binding whose init call carries an env BOX as an
            // argument (`var v: (i32) => i32 = id(<boxed lambda>)`): an erased
            // generic returns its argument, so what lands here is that box. Bind
            // it a closure local — otherwise `v(1)` bare-calls the box pointer as
            // code, which is the segfault #6466 records against widening the
            // lift alone. Keyed on the ARGUMENT rather than the callee, so it
            // holds for any passthrough that returns the boxed argument.
            if (v.type_name == "fn" || is_fn_payload_spelling(v.type_name)) {
                var mka: i32 = 0;
                while (mka < cc.args.len()) {
                    if (expr_is_closure_box(cc.args[mka], s)) { clo_init = true; }
                    mka = mka + 1;
                }
            }
            match (cc.callee) {
                // `var f = m.make()` where the METHOD returns a closure. The
                // arm above only ever saw a bare-ident callee (a free
                // function), so a method-returned closure fell through here
                // unbound: `f` stayed a plain fn-value local, and `f(21)`
                // lowered as a direct call_indirect passing the BOX POINTER as
                // the table index instead of unpacking the box (load the fn
                // index, push the env first). wasm trapped with
                // `undefined element: out of bounds table access`; the register
                // backends jumped through the box pointer. #4801.
                //
                // closure_ret_fns_of registers methods under their BARE name
                // (it appends each func's name without receiver qualification), so
                // the method name is the key here — matching how the registry
                // already stores it, and introducing no collision it does not
                // already have.
                ast.ExprFieldAccess(mfa) => {
                    if (util.index_of_str(s.sigs.closure_fns, mfa.field) >= 0) { clo_init = true; }
                    if (util.index_of_str(s.sigs.closure_fns, "RETCLO2:" + mfa.field) >= 0) { clo_init = true; init_retclo = true; }
                },
                _ => { }
            }
        },
        // `var c = fns[i]` where fns is a closure[]: the element is a
        // closure box, so bind c as a closure local (its call unpacks the
        // box). Without this, `c()` would call the raw box pointer as a
        // table index and trap.
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => {
                    if (s.is_closurearr_slot(s.slot_of(aid.name))) { clo_init = true; }
                    // A fn-typed capture read `var cap: (i32) => i32 = __env[i]`
                    // that make_clo_func synthesizes at the top of an escaping
                    // closure body when the closure captured a fn-VALUE: the
                    // captured value is itself a closure BOX, so `cap(args)`
                    // inside the body must dispatch env-first, not bare-call
                    // the box pointer as code (a SIGSEGV otherwise). fn-typed
                    // params already get this treatment; this is the
                    // capture-read sibling.
                    else if (aid.name == "__env" && fn_param_from_spelling(v.name, v.type_name).type_name == "fn") { clo_init = true; }
                },
                // (`var f = r.hs[0]` over a struct closure-array field is
                // handled by the dedicated borrow branch above — it binds a
                // closure-local BORROW, not the is_arr owner this clo_init path
                // would produce.)
                _ => { }
            }
        },
        // `var d = c` where c is already a closure local (#4557): d
        // ALIASES the env box. Without this arm d stayed a plain
        // scalar slot and `d()` called the raw box pointer as a
        // table index — SIGSEGV. d is marked a closure local below
        // (env-first dispatch) and the box is alias-inc'd after the
        // store, so the exit sweep's two shallow decs balance — the
        // rc==1 gate hands the capture release to the LAST owner
        // (whose kinds are empty for the alias name, so captures
        // keep the documented aliased-env leak).
        ast.ExprIdent(iid) => { if (s.is_closure_local(iid.name)) { clo_init = true; } },
        _ => { }
    }
    if (clo_init) {
        return lower_stmt_var_closure(v, init_retclo, s);
    }
    // 2-element tuple destructure `var (a, b) = E` — the parser encodes
    // the name as "a,b". Eval the tuple box into a fresh temp, then bind
    // a = tuple_get(0), b = tuple_get(1). Scalar elements only; >2
    // elements (another comma in the tail) or a non-tuple init bail.
    var comma: i32 = 0 - 1;
    var ci: i32 = 0;
    while (ci < v.name.len()) {
        if (v.name[ci] == b',' && comma < 0) { comma = ci; }
        ci = ci + 1;
    }
    // i64 binding: `var x: i64 = E`, or an init that infers to i64
    // (`var z = a + 1` with a:i64, `var y = a`). Mark the slot i64, lower
    // the init as an i64 value, store. Scalar locals only — i64 arrays /
    // params / returns still bail (lower_func bails on an i64 param/return;
    // lower_i64 bails on anything non-i64-value).
    // A u32 var holds a 32-bit value, so even a large literal init
    // (`var x: u32 = 4000000000`, whose value exceeds i32-max and thus
    // infers width 64) must NOT take the i64 path — that would i64-back
    // the slot and route its arithmetic through the full-width i64 ops,
    // skipping the u32 wrap (op_const_i32_text below stores the literal's
    // 32-bit pattern, and the slot is marked u32 so `x + y` wraps at
    // 2^32). u32 is the only ≤32-bit type that can carry a (2^31, 2^32)
    // literal — i32 / u8 reject one at E047.
    if (comma < 0 && (v.type_name == "i64" || v.type_name == "u64" || (infer_expr_width(v.init, s) == 64 && !is_u32_type_name(v.type_name)))) {
        var iv: LowerState = lower_i64(v.init, s);
        if (!iv.ok) { return iv; }
        var ivb: LowerState = iv.add_local(v.name);
        ivb = ivb.mark_reclaim_site(ivb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
        var islot: i32 = ivb.slot_of(v.name);
        ivb = ivb.mark_i64(islot, true);
        // A `u64` binding (annotated, or an init that is itself u64) marks
        // the slot u64 so its compares / `>>` / `/` / `%` select the
        // UNSIGNED i64 ops (#2904).
        if (v.type_name == "u64" || expr_is_u64(v.init, s)) { ivb = ivb.mark_u64(islot, true); }
        return ivb.emit(ir.op_store_local(islot));
    }
    // f64 binding: `var x: f64 = E`, or an init that infers to f64
    // (`var c = a + b` with a/b:f64). lower_expr already routes float
    // literals/arithmetic through const_f64 / the float ops, pushing the
    // 8-byte bit pattern; mark the slot f64 so later uses pick the float
    // ops. Scalar locals only — f64 params / returns / arrays / fields
    // still bail (lower_func bails an f64 signature).
    if (comma < 0 && (is_f64_scalar_type_name(v.type_name) || expr_is_f64(v.init, s))) {
        var fv: LowerState = lower_expr(v.init, s);
        if (!fv.ok) { return fv; }
        var fvb: LowerState = fv.add_local(v.name);
        fvb = fvb.mark_reclaim_site(fvb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
        var fslot: i32 = fvb.slot_of(v.name);
        fvb = fvb.mark_f64(fslot, true);
        // An f32 local is ALSO f32-tagged (overlay on f64) so its method
        // calls dispatch "f32.<m>" — by annotation (`var x: f32`) or an
        // f32-valued init (`var x = y as f32` / another f32 value).
        // `float` is NOT one of them: it is the f64 alias (parser builds
        // FloatType{Width:64} for it, #5363), and expr_is_f32 below already
        // states the rule — "Only `as f32` yields f32; `as f64` / `as float`
        // are f64". Tagging it f32 made `var x: float` compute at f32
        // precision, since f32 arithmetic rounds through a demote/promote
        // pair, and the tag propagated into any f64 local assigned from it
        // (#5882).
        if (v.type_name == "f32" || expr_is_f32(v.init, s)) {
            fvb = fvb.mark_f32(fslot, true);
        }
        return fvb.emit(ir.op_store_local(fslot));
    }
    // i64 array LITERAL: `var a: i64[] = [e0, e1, …]`. Elements aren't
    // self-evidently i64 (a bare integer literal could be i32), so the
    // `i64[]` annotation drives it: lower each element via lower_i64
    // (8-byte i64 values), emit arr_make_i64 (8-byte stride + i64.store
    // on wasm), and mark the slot as an i64 array (is_arr for RC, is_i64arr
    // for element typing). Aliasing / params go through the generic array
    // path below (which now also marks is_i64arr).
    // An UNANNOTATED `var a = [e0, …]` whose first element is i64-WIDE but
    // not f64 (e.g. `[10 as i64, 20 as i64]`) is an i64[] too — infer it so
    // the unannotated form lowers the same as the annotated one (without
    // this it bailed to AST). #3353.
    var i64arr_unannot: boolean = false;
    if (v.type_name == "") {
        match (v.init) {
            ast.ExprArray(i64lit0) => {
                if (i64lit0.elements.len() > 0 && infer_expr_width(i64lit0.elements[0], s) == 64 && !expr_is_f64(i64lit0.elements[0], s)) { i64arr_unannot = true; }
            },
            _ => {}
        }
    }
    if (comma < 0 && (v.type_name == "i64[]" || i64arr_unannot || v.type_name == "u64[]")) {
        var i64lit: boolean = false;
        match (v.init) {
            ast.ExprArray(_) => { i64lit = true; },
            _ => {}
        }
        if (i64lit) {
            match (v.init) {
                ast.ExprArray(iarr) => {
                    var ia: LowerState = s;
                    var iae: i32 = 0;
                    while (iae < iarr.elements.len()) {
                        ia = lower_i64(iarr.elements[iae], ia);
                        if (!ia.ok) { return ia; }
                        iae = iae + 1;
                    }
                    ia = ia.emit(ir.op_arr_make_i64(iarr.elements.len()));
                    var iab: LowerState = ia.add_local(v.name);
                    iab = iab.mark_reclaim_site(iab.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                    var iaslot: i32 = iab.slot_of(v.name);
                    iab = iab.mark_arr(iaslot, true);
                    iab = iab.mark_i64arr(iaslot, true);
                    // u64[] rides the i64[] 8-byte storage/read path; the
                    // extra u64 mark drives UNSIGNED arithmetic on a read
                    // element (is_arr && is_u64) — is_i64_slot excludes the
                    // (pointer) array slot, so the local stays i32-wide.
                    if (v.type_name == "u64[]") { iab = iab.mark_u64(iaslot, true); }
                    return iab.emit(ir.op_store_local(iaslot));
                },
                _ => {}
            }
        }
    }
    if (comma >= 0) {
        return lower_stmt_var_destructure(v, s);
    }
    // Map construction `var m: Map[K, V] = map_new(n)`: the callee
    // `map_new` is generic, so the KEY KIND comes from the annotation, not
    // the callee name. Emit op_map_new with the annotated key kind here so
    // the wasm backend selects the right constructor (i32 vs string keys).
    match (v.init) {
        ast.ExprCall(mnc) => {
            match (mnc.callee) {
                ast.ExprIdent(mnid) => {
                    if ((mnid.name == "map_new" || mnid.name == "map_new_i32") && mnc.args.len() == 1 && v.type_name.len() >= 5 && slice_unchecked(v.type_name, 0, 4) == "Map[") {
                        var inner2: str = slice_unchecked(v.type_name, 4, v.type_name.len());
                        var kkind: i32 = 0 - 1;
                        var ktag: string = "";
                        if (inner2.len() >= 4 && slice_unchecked(inner2, 0, 4) == "i32,") { kkind = 1; ktag = "i32"; }
                        else if (inner2.len() >= 7 && slice_unchecked(inner2, 0, 7) == "string,") { kkind = 0; ktag = "string"; }
                        else if (map_key_eqfn(v.type_name) != "") {
                            // Struct/enum key: kind 2, dispatched by the key's
                            // derived hash/eq (the wasm hash map threads their
                            // funcref indices in; x86 ignores them). #2671.
                            kkind = 2; ktag = map_key_of(v.type_name);
                        }
                        if (kkind >= 0) {
                            var mns: LowerState = lower_expr(mnc.args[0], s);
                            if (!mns.ok) { return mns; }
                            var mnfns: string = "";
                            if (kkind == 2) { mnfns = ktag + ".hash|" + ktag + ".eq"; }
                            mns = mns.emit(ir.op_map_new(kkind, mnfns));
                            var mnsb: LowerState = mns.add_local(v.name);
                            mnsb = mnsb.mark_reclaim_site(mnsb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                            var mnslot: i32 = mnsb.slot_of(v.name);
                            mnsb = mnsb.mark_map_type(mnslot, v.type_name);
                            // Loop-reinit reclaim (#4357): a re-declared reclaimable
                            // map local reuses its slot, so free the PRIOR
                            // iteration's keys/values buffers + mapbox before the
                            // store — else one box leaks per iteration (the precise
                            // drop is top-level-only and the exit sweep only sees
                            // the final box). emit_map_buffers_free is stack-neutral
                            // (the fresh op_map_new box underneath is untouched),
                            // null-guards the zero-initialized first binding, and
                            // zeroes the slot the store below overwrites.
                            if (slot_is_reclaimable_map(mnsb, mnslot)) {
                                mnsb = emit_map_buffers_free(mnsb, mnslot);
                            }
                            return mnsb.emit(ir.op_store_local(mnslot));
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    // `var x: Option[T]/Result[T,E] = Ok/Some/Err(arg)` with an i64/u64
    // DECLARED payload: build the 8-byte box (payload at offset 8) every
    // consumer reads via op_opt_payload_w(64), even when `arg` only infers
    // i32 (a bare literal `Ok(40)` or i32 var). The expected payload comes
    // from the annotation, and the slot records the ANNOTATION as its
    // opt_type so the later `match (x)` reads the matching 8-byte payload —
    // both sides must agree on offset 8 or the read truncates. Mirrors the
    // StmtReturn i64-construction path (#3566). Early-return (like map_new):
    // an Option/Result box is a leak-only pointer needing no array/string/
    // struct slot marking beyond mark_opt_type.
    match (v.init) {
        ast.ExprCall(vc) => {
            match (vc.callee) {
                ast.ExprIdent(vcid) => {
                    if (vc.args.len() == 1 && (vcid.name == "Ok" || vcid.name == "Some" || vcid.name == "Err") && v.type_name.len() >= 8 && (slice_unchecked(v.type_name, 0, 7) == "Result[" || slice_unchecked(v.type_name, 0, 7) == "Option[")) {
                        var vvar: string = "Ok";
                        var vtag: i32 = 0;
                        if (vcid.name == "Err") { vvar = "Err"; vtag = 1; }
                        var vexp: string = opt_payload_type(v.type_name, vvar);
                        if (vexp == "i64" || vexp == "u64") {
                            var vcs: LowerState = lower_opt_make_payload_exp(vtag, vc.args[0], vexp, s);
                            if (!vcs.ok) { return vcs; }
                            var vsb: LowerState = vcs.add_local(v.name);
                            vsb = vsb.mark_reclaim_site(vsb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                            var vslot: i32 = vsb.slot_of(v.name);
                            vsb = vsb.mark_opt_type(vslot, v.type_name);
                            return vsb.emit(ir.op_store_local(vslot));
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    // A bare ZERO-ARG fn name bound to a `fn`-typed local is a function
    // VALUE (pointer), not a `const`-style call: `var g: () => T = f`.
    // The generic lower_expr below would read `f` (a 0-arg receiver-less
    // fn, indistinguishable from a `const` without context) as a const and
    // CALL it, storing f()'s result; `g()` then calls that integer as a
    // code pointer and segfaults. The `fn`-typed target disambiguates it
    // as a value → emit const_func (the same pointer a >=1-arg fn-name
    // already lowers to). g stays a plain fn-pointer slot, so `g()`
    // dispatches via the plain call_indirect path. (#3574)
    if (v.type_name == "fn") {
        match (v.init) {
            ast.ExprIdent(fvid) => {
                if (s.slot_of(fvid.name) < 0 && s.is_const_fn(fvid.name)) {
                    var fvs: LowerState = s.emit(ir.op_const_func(0, fvid.name));
                    var fvb: LowerState = fvs.add_local(v.name);
                    fvb = fvb.mark_reclaim_site(fvb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                    var fvslot: i32 = fvb.slot_of(v.name);
                    fvb = fvb.stamp_fn_value_facts(v, fvslot, s);
                    return fvb.emit(ir.op_store_local(fvslot));
                }
            },
            _ => {}
        }
    }
    // A fn-VALUE ARRAY literal of bare named-function values —
    // `var fns: (() => T)[] = [f, g]` — is the array sibling of the
    // scalar fn-value binding above. Each bare 0-arg fn-name element
    // would otherwise const-CALL through the generic ExprArray lowering
    // (storing f()'s result), so `fns[i]()` then calls that integer as a
    // code pointer and segfaults. The `fn[]` target type disambiguates
    // every element as a VALUE → emit const_func (a plain fn pointer).
    // The slot is a plain fn-pointer array (is_arr, NOT is_closurearr):
    // `fns[i]()` dispatches via the plain call_indirect path, exactly as
    // the single-element non-capturing `fs[0](4)` case already does. Only
    // a HOMOGENEOUS bare-fn-name literal takes this path; any lambda /
    // closure element leaves all_fnval false so the literal keeps the
    // generic closure-array path (which marks is_closurearr for env-first
    // dispatch), and a bare LOCAL element (`[g]` where g is a local) is
    // excluded too — fn_value_arg_name returns "" for a local. (#3574)
    if (v.type_name == "fn[]") {
        match (v.init) {
            ast.ExprArray(fva) => {
                var all_fnval: boolean = fva.elements.len() > 0;
                var fci: i32 = 0;
                while (fci < fva.elements.len()) {
                    if (fn_value_arg_name(fva.elements[fci], s) == "") { all_fnval = false; }
                    fci = fci + 1;
                }
                if (all_fnval) {
                    var fcs: LowerState = s;
                    var fcj: i32 = 0;
                    while (fcj < fva.elements.len()) {
                        fcs = fcs.emit(ir.op_const_func(0, fn_value_arg_name(fva.elements[fcj], s)));
                        fcj = fcj + 1;
                    }
                    fcs = fcs.emit(ir.op_arr_make(fva.elements.len(), 32));
                    var fcb: LowerState = fcs.add_local(v.name);
                    fcb = fcb.mark_reclaim_site(fcb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
                    var fcslot: i32 = fcb.slot_of(v.name);
                    fcb = fcb.mark_arr(fcslot, true);
                    // Plain-fn-pointer array: a later `fns = fns.append(g)`
                    // of a bare named fn must also emit const_func, so flag
                    // the slot is_fnarr (the append site reads it). (#3574)
                    fcb = fcb.mark_fnarr(fcslot, true);
                    fcb = fcb.mark_fnarr_elem(fcslot, fnarr_elem_of_var(v));
                    return emit_arr_store(fcb, fcslot, false, true);
                }
            },
            _ => {}
        }
    }
    var se: LowerState = s;
    // #6713: `var t = slice_unchecked(s, a, b)` where every use of `t` borrows
    // the view takes the 24-byte box from the frame instead of the heap. `s[a:b]`
    // is not a candidate — it builds an `Option[str]` box (#5634). Only the
    // storage changes —
    // same layout, same rc=-1 immortal sentinel — so the binding's own slot
    // marking below is untouched.
    if (view_frame_binding_ok(v, s)) { se = lower_str_slice_frame(v.init, s); }
    else { se = lower_expr(v.init, s); }
    if (!se.ok) { return se; }
    // Perceus alias-inc + array tracking: a fresh array literal is
    // owned at rc=1 (no inc); binding a new name to an EXISTING array
    // local creates a second reference, which must retain (inc) the
    // buffer. Mark the new slot's array-ness either way.
    var is_arr: boolean = false;
    var alias_inc: boolean = false;
    match (v.init) {
        ast.ExprArray(_) => { is_arr = true; },
        ast.ExprIdent(id) => {
            // Binding a new name to an EXISTING rc container creates a second
            // reference → retain (alias_inc). Both slots then own a counted
            // reference and both release it; the refcount arbitrates.
            //
            // DUPLICATION, not transfer, and the conditional alias is why: under
            // a transfer model `if (c) { var v: T = t; }` leaves the source
            // un-swept on the path where no transfer happened, so a leak becomes
            // branch-dependent. The inc and the dec here are emitted on the same
            // path by construction.
            //
            // This is the FOURTH site asking slot_is_rc_container's question. The
            // predicate exists (#4350) precisely so the three container
            // CONSTRUCTORS could not drift apart; the alias bind has been asking
            // it in hand-rolled form as `is_arr_slot` ever since, which is why an
            // aliased tuple, struct or string bound nothing while an aliased
            // array was correct (#7282).
            // THE INVARIANT FOR THIS WHOLE PAIRING, and the one to read before
            // touching either side: ONLY THE BOX IS RETAINED HERE, SO ONLY THE
            // BOX MAY BE RELEASED TWICE. The alias therefore takes the BOX-ONLY
            // release and the source keeps the deep one — "NODEEP:" for a struct
            // (whose release is a field walk plus a box dec) and the shallow
            // "TUP:" for an rc-tuple (whose "TUPRCS:" release is a type-driven
            // deep free). Giving the alias the source's deep credit frees every
            // field or element twice; both were measured as exit 99 with
            // allocs == frees at live_bytes 0, so only __rc_underflow_count()
            // dissented. See credit_alias_sites' callers in reclaimable_names_of.
            var aid_slot: i32 = se.slot_of(id.name);
            if (se.is_arr_slot(aid_slot)) {
                is_arr = true;
                // Move-on-alias: `var b = a` at a's last top-level mention
                // TRANSFERS the reference — the retain is elided and a's exit
                // dec is elided with it (note_moved_elided), the same net-zero
                // pair native cancels at this site. moves_local_at keys on the
                // Var's own position, which is what move_sites_toplevel_of
                // records and the rcplan moveSites diff pins against native.
                if (se.moves_local_at(id.name, v.line, v.col)) { se = se.note_moved_elided(aid_slot); }
                // Dead-alias cancellation (#4402 opt 1): a proven borrowed
                // VIEW skips the retain; bind_var_slot elides the alias
                // slot's sweep dec under the same predicate, and the
                // source's precise drop is withheld (pd_filter_names) so it
                // releases only at the exit sweep.
                else if (!arr_dead_alias_bind(v, se)) { alias_inc = true; }
            }
            // A struct slot is not in slot_is_rc_container — its release is a
            // deep field drop rather than a box dec, so it carries its own
            // clause rather than widening that predicate under three other
            // callers who mean "box".
            // Tuple and string, each with its own clause — NOT slot_is_rc_container,
            // which answers "is this a box" and not "is this box credited". The
            // retain and the credit have to land together: a retain whose source
            // has no alias credit is an unbalanced inc. An unconditional `is_str`
            // was exactly that, and gave `var sp: string = sep;` inside std/array's
            // join_with_last a retain nothing gives back, on every program that
            // reaches it — `sep` is a PARAMETER, which owns nothing to share.
            // Asking slot_is_reclaimable_str instead excludes parameters at its
            // own first line, which is what makes the pair co-extensive rather
            // than merely adjacent.
            //
            // The struct clause that was here keyed on struct_type_of_slot, which
            // is ALSO set for enum names and dyn tags, so it retained values that
            // are not box pointers at all — six integer fixtures and both
            // differential shards segfaulted. Adding structs needs a predicate
            // that identifies a struct BOX slot; struct_type_of_slot is not one.
            // THE RETAIN AND THE CREDIT MUST BE CO-EXTENSIVE. The credit is only
            // ever granted when the SOURCE is a credited tuple local, so retaining
            // a source that is not one produces an inc nothing gives back. That is
            // not hypothetical: `w @ (A(x), y) => …` desugars to a bare-ident bind
            // of the match scrutinee, and when the scrutinee is a PARAMETER the
            // retain fired while the credit could not — +1 rc_inc and 0 extra
            // releases in two conformance fixtures, with a byte-identical leak
            // census either side, because an unbalanced retain allocates nothing
            // and frees nothing.
            //
            // Asking slot_is_credited_tuple here is what keeps the two halves
            // exactly the same set: no credited source, no retain, status quo.
            // ALL THREE tuple classes, because each is a state a credited source
            // can be in: a scalar tuple is "TUP:", an rc tuple "TUPRC:"/"TUPRCS:",
            // and an alias this very clause MOVED into holds "TUPRCS:" ALONE —
            // the surgery below drops its "TUP:" row. Gating on fewer desynced
            // the pair both ways: without "TUPRC:" the rc-tuple alias kept its
            // credit while the retain stopped firing (exit 99 on `var t: (i32,
            // i32[]) = (i, [i, i+1]); var v = t;`); without "TUPRCS:" the second
            // link of a chain `var v = t; var u = v;` found its source
            // uncredited, so `u` kept the "TUP:" row the credit pass granted
            // while `v` was neither retained against nor elided — two exit decs
            // on a box of rc 1 (#7750). Both with allocs == frees at
            // live_bytes 0, as always for this family.
            else if (slot_is_credited_tuple(se, aid_slot)) {
                // Move-on-alias, tuple limb: at the source's last top-level
                // mention the bind transfers the reference. A scalar tuple's
                // "TUP:" alias copy already IS the whole release (a box dec);
                // an rc-tuple's deep sweep class ("TUPRCS:") moves to the
                // alias site so the one type-driven deep free runs there —
                // the same release-role inheritance as the struct limb, with
                // the slot facts it reads (tuple_elems / tup_elem_kinds)
                // copied across in bind_var_slot under the same predicate.
                if (se.moves_local_at(id.name, v.line, v.col)) {
                    if (reclaim_has(se.reclaimable_names, "TUPRCS:", se.reclaim_site_key(aid_slot))) {
                        se = se.drop_reclaim_row("TUP:" + reclaim_site_key_of(v.name, v.line, v.col));
                        se = LowerState { ...se, reclaimable_names: se.reclaimable_names.append("TUPRCS:" + reclaim_site_key_of(v.name, v.line, v.col)) };
                    }
                    se = se.note_moved_elided(aid_slot);
                }
                // Dead-alias cancellation, tuple limb (#4402 opt 1): a proven
                // borrowed VIEW skips the retain, and bind_var_slot elides
                // the alias slot's shallow "TUP:" box dec under the same
                // predicate. No credit surgery: the source keeps its deep
                // release at the exit sweep.
                else if (!tuple_dead_alias_bind(v, se)) { alias_inc = true; }
            }
            // A string box, on the one class that grants the alias a credit.
            // slot_is_reclaimable_str asks about the box AND the credit on its own
            // (`locals[i].is_str` plus the "STR:" lookup), so unlike the tuple
            // clause above there is no separate box predicate to pair it with.
            //
            // A string's release is a single box free, never a walk, so the alias
            // takes the SAME "STR:" class the source holds rather than a shallow
            // variant — the box-only invariant above is already what "STR:" means.
            //
            // A str-VIEW local cannot reach here holding a FRAME box, which is what
            // would make this retain an inc of a frame word: view_frame_binding_ok
            // defers to view_frame_names_of, whose expr_view_borrow_only refuses a
            // bare ident in binding position outright. An aliased view is heap-boxed
            // like every other string.
            else if (slot_is_reclaimable_str(se, aid_slot)) {
                // Move-on-alias, string limb: at the source's last top-level
                // mention the bind transfers the reference — elide the retain
                // and the source's exit release with it (note_moved_elided;
                // the string sweep loop skips elided slots), the same
                // cancellation the array clause above performs.
                if (se.moves_local_at(id.name, v.line, v.col)) { se = se.note_moved_elided(aid_slot); }
                // Dead-alias cancellation, string limb (#4402 opt 1): a proven
                // borrowed VIEW skips the retain, and bind_var_slot elides the
                // alias slot's sweep dec under the same predicate.
                else if (!str_dead_alias_bind(v, se)) { alias_inc = true; }
            }
            // A struct box. The gate is the CREDIT predicate, not a type test, and
            // the difference is the whole of #7368: struct_type_of_slot is a
            // type-NAME carrier, set for enum names, dyn tags, "clo", and the
            // ELEMENT type of a struct/enum array — and, as the crash showed, left
            // on slots holding plain scalars. `__fern_i32_to_string` binds the
            // negated input, so for INT_MIN the slot held 0x80000000: non-zero,
            // even, and above 0x10000, so it passed every __fern_rc_inc guard and
            // dereferenced 0x7FFFFFF8.
            //
            // slot_is_reclaimable_struct answers the operational question instead —
            // was this slot bound from a struct producer proven fresh and
            // non-escaping — which no integer, enum or struct-array slot can earn,
            // and which refuses a parameter and a "dyn " tag outright. That makes
            // the retain and the credit the same set by construction, exactly as
            // the string limb's slot_is_reclaimable_str does.
            //
            // DO NOT "HARDEN" __fern_rc_inc WITH A HEAP-BASE GUARD. It has only a
            // null, tagged-immediate and <0x10000 check where __fern_str_free also
            // compares against __fern_heap_base, and that asymmetry looks like an
            // oversight. It is load-bearing: a scalar reaching rc_inc is a compiler
            // bug, and the missing guard is what turns it into an immediate SIGSEGV
            // instead of a silent no-op that corrupts eight bytes and returns. The
            // guard would not have prevented #7368 either — it would have hidden it,
            // and the class of defect that cannot make an instrument go red is
            // exactly the one that costs the most to find later. Constants are
            // already safe by a different mechanism: a static box carries a
            // NEGATIVE rc sentinel, which rc_inc's `js` test declines.
            else if (slot_is_reclaimable_struct(se, aid_slot)) {
                // Move-on-alias, struct limb: at the source's last top-level
                // mention the bind transfers the reference. Structs are the
                // class whose release is NOT just the box dec — under
                // duplication the alias holds box-only "NODEEP:" and the
                // source keeps the deep field walk. A move elides the
                // source's release entirely (note_moved_elided; the struct
                // sweep loop skips it), so the alias INHERITS the source's
                // release role: its "NODEEP:" row is dropped and its exit
                // drop runs the one field walk — unless the source itself
                // was box-only (its fields moved out), in which case the
                // alias stays box-only too.
                if (se.moves_local_at(id.name, v.line, v.col)) {
                    if (!reclaim_has(se.reclaimable_names, "NODEEP:", se.reclaim_site_key(aid_slot))) {
                        se = se.drop_reclaim_row("NODEEP:" + reclaim_site_key_of(v.name, v.line, v.col));
                    }
                    se = se.note_moved_elided(aid_slot);
                }
                // Dead-alias cancellation, struct limb (#4402 opt 1): a
                // proven borrowed VIEW skips the retain, and bind_var_slot
                // elides the alias slot's box-only sweep dec under the same
                // predicate. No credit surgery: the source keeps its one
                // deep field walk at the exit sweep.
                else if (!struct_dead_alias_bind(v, se)) { alias_inc = true; }
            }
            // An Option/Result box on the three UNMATCHED classes that grant the
            // alias a credit (#7687). Gated on the CREDIT predicates for the same
            // reason every limb above is: an inc whose source carries no alias
            // credit is one nothing gives back.
            //
            // These releases are a payload release plus a box dec, so the alias
            // takes the box-only "NODEEP:" role the struct limb takes, not the
            // source's deep one — credit_opt_alias_sites grants exactly that
            // pair. Sharing the deep credit decs the payload twice, which for
            // `Option[i32[]]` frees the element buffer under the surviving owner.
            //
            // No move-on-alias and no dead-alias cancellation here: both are
            // credit surgery on classes whose release roles this pairing has
            // measured, and neither is needed to close the leak. The bind
            // retains and the alias's box-only sweep gives it back on the same
            // path, which is the duplication contract this ladder is built on.
            else if (slot_is_reclaimable_optarr(se, aid_slot)
                     || slot_is_reclaimable_optstr(se, aid_slot)
                     || slot_is_reclaimable_optopt_rc(se, aid_slot)) {
                alias_inc = true;
            }
        },
        ast.ExprFieldAccess(sfa) => {
            // An ARRAY-OF-ARRAY field read (`var rows = a.xs`, xs: i32[][]): the
            // scalar / struct / enum array field reads take their own early-return
            // binds above, and this is the one array field shape left to the
            // general path. Tracking it is_arr is what a later `for row in rows`
            // requires (it reads is_arr_slot), and the alias-inc block below
            // retains the buffer so the slot's exit-sweep dec balances (#7208).
            if (nested_arr_field_read_type(v.init, se) != "") { is_arr = true; }
            // #4355: `var t = s.name` — a STRING field read of a local whose
            // consume-rebind routes through the string-widened
            // __field_reclaim_<T>. The read is UNCOUNTED (strings have no
            // read-side alias-inc discipline yet), so the next rebind's
            // replaced-field free would release the string out from under t.
            // Retain it (alias_inc → __fern_rc_inc on the rc-headered string
            // box): the reclaim's rc-aware __fern_str_free then only decs,
            // and t's copy stays valid — one count leaks (sound), mirroring
            // the construction-side base-copy retain family. Gated on the
            // source slot actually being reclaimable / snapshot-routed and
            // its type routing through __field_reclaim (array field present).
            match (sfa.obj) {
                ast.ExprIdent(sfid) => {
                    var sfsl: i32 = se.slot_of(sfid.name);
                    if (sfsl >= 0 && (slot_is_reclaimable_struct(se, sfsl) || slot_is_snapshot_param(se, sfsl))) {
                        var sfst: string = se.struct_type_of_slot(sfsl);
                        if (sfst != "" && decl_field_type(se.structs, sfst, sfa.field) == "string"
                            && se.struct_routes_field_reclaim(sfst)) {
                            alias_inc = true;
                        }
                    }
                },
                _ => {}
            }
        },
        ast.ExprCall(cc) => {
            // `var x = f()` where f returns an array: a MOVE — x takes
            // ownership of the callee's already-owned buffer (rc=1), so
            // no inc; just track x as an array.
            match (cc.callee) {
                ast.ExprIdent(fid) => {
                    // `__alloc_u8(n)` yields a fresh owned byte array (a
                    // move, like an arr-returning call).
                    if (fid.name == "__alloc_u8") { is_arr = true; }
                    // `random_bytes(n)` yields a fresh owned u8[] — same move.
                    else if (fid.name == "random_bytes" && cc.args.len() == 1) { is_arr = true; }
                    // `tcp_recv(fd, max)` yields a fresh owned u8[] — same move.
                    else if (fid.name == "tcp_recv" && cc.args.len() == 2) { is_arr = true; }
                    // `str_split(s, sep)` yields a fresh owned string[] — a
                    // move, track as array (is_strarr comes from expr_is_strarr).
                    else if (fid.name == "str_split" && cc.args.len() == 2) { is_arr = true; }
                    // `args()` likewise yields a fresh owned string[]. expr_is_strarr
                    // has known this since the builtin landed, so an unannotated
                    // `var a = args()` was strarr-tracked but NOT array-tracked, and
                    // `for s in a` then bailed the function while `a[i]` / `a.len()`
                    // lowered fine. The two predicates have to agree (#3457).
                    else if (fid.name == "args" && cc.args.len() == 0) { is_arr = true; }
                    else if (se.is_arr_ret_fn(fid.name)) { is_arr = true; }
                },
                // `var b = s.bytes()` / `= s.as_bytes()`: op_str_bytes
                // returns a fresh owned u8[] (rc=1) — a move, track as array.
                // `var parts = s.split(sep)`: op_str_split likewise returns a
                // fresh owned string[].
                ast.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "bytes" || cfa.field == "as_bytes") && cc.args.len() == 0 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                    else if (cfa.field == "split" && cc.args.len() == 1 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                    else if (cfa.field == "lines" && cc.args.len() == 0 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                    // `var a = obj.m()` where obj is a struct and method `m`
                    // returns an array (e.g. a struct-array `P[]`) — a MOVE,
                    // track a as an array so `a[i].field` / `for x in a`
                    // recover the element type (struct_ret_type carries the
                    // element struct type, keyed "<Type>.m"). The struct
                    // receiver gate keeps this to a genuine method call (#3040).
                    else if (se.is_arr_ret_fn(cfa.field) && expr_struct_type(cfa.obj, se) != "") { is_arr = true; }
                    // The same for a PRIMITIVE receiver — `s.chars()`, `s.codes()`,
                    // `(n as i64).digits()`. array_ret_fn_names registers EVERY
                    // method under the qualified "<BaseType>.<method>" key (the
                    // receiver's base_type_name, so "string.chars"), but the
                    // struct clause above only fires when expr_struct_type is
                    // non-empty, which a string / i64 / f64 receiver never is. So
                    // the slot went un-array-marked while expr-level recovery kept
                    // working: `a.len()` and `a[i]` lowered and `for x in a` bailed
                    // on !is_arr_slot. That is the two-predicates-disagree shape
                    // #3457 fixed for `args()` a few lines up, one receiver kind
                    // over. Keyed qualified, so it cannot claim an unrelated
                    // free function that happens to share the method's name.
                    else if (expr_recv_prim_type(cfa.obj, se) != ""
                        && se.is_arr_ret_fn(expr_recv_prim_type(cfa.obj, se) + "." + cfa.field)) { is_arr = true; }
                    // `var b = a.with(i, v)` / `var b = a.append(v)` — the
                    // value-producing builders return a FRESH owned array
                    // (lower_arr_with_value / _append_value clone the
                    // receiver), so the slot is a MOVE (rc=1, no alias_inc).
                    // The receiver is any leak-safe scalar / string-element
                    // array source OR a scalar-array struct-field read.
                    else if ((cfa.field == "with" && cc.args.len() == 2) || (cfa.field == "append" && cc.args.len() == 1)) {
                        if (expr_is_arr_src(cfa.obj, se) || expr_is_strarr(cfa.obj, se)
                            || expr_is_f64arr(cfa.obj, se) || expr_is_i64arr(cfa.obj, se)
                            || scalar_arr_field_type(cfa.obj, se) != "") { is_arr = true; }
                    }
                    // `var r = xs.reverse()` / `var c = xs.concat(ys)` — a FRESH
                    // owned array (rc=1, a move, no alias_inc), same as with /
                    // append above. This list is what marks the SLOT, and it is
                    // separate from the expression classifiers: without an entry
                    // here an UNANNOTATED binding leaves the slot untyped, which
                    // `for v in r` rejects outright (it requires is_arr_slot) even
                    // though `r.len()` happens to work. The annotated form is
                    // covered by is_array_type_name(v.type_name) further down —
                    // which is exactly why the two `arr-string-{reverse,concat}`
                    // corpus cases, the only unannotated-plus-for-in ones, were
                    // the last two of 313 still routing AST.
                    else if (arr_samekind_call(cfa.field, cfa.obj, cc.args.len(), se)) { is_arr = true; }
                    // `var ks = m.keys()` / `var vs = m.values()` — op_map_keys
                    // / op_map_values return a FRESH owned array (rc=1, a move,
                    // no alias_inc). The element flags (is_strarr / is_i64arr /
                    // is_f64arr) flow from the same map_kv_elem_tag gate via the
                    // predicates below, so the slot's width stays consistent.
                    else if (map_kv_elem_tag(cfa.obj, cfa.field, cc.args.len(), se) != "") { is_arr = true; }
                    // `var v: i32[] = m.get_or(k, d)` / `= m.get(k)` on an
                    // ARRAY-valued map: the register map read hands back the
                    // column's raw pointer, an UNCOUNTED alias of a buffer the map
                    // still owns. Binding it to an array slot makes it a COUNTED
                    // reference — the exit dec-sweep releases every is_arr_slot
                    // unconditionally — so without a retain the sweep frees the
                    // map's live value and the next same-size-class allocation
                    // recycles it underneath the map. The read-side twin of #6880's
                    // insert-side vretain, and the reason a value read back after
                    // the alias died returned another local's contents.
                    else if (map_read_aliases_arr_value(cfa, cc.args.len(), se)) { is_arr = true; alias_inc = true; }
                },
                // `var a = if (c) { [..] } else { [..] }` — an if-/match-
                // EXPRESSION desugars to a 0-arg IIFE (callee is ExprLambda).
                // If the first branch returns an array literal, the slot
                // holds a fresh owned array (rc=1, a move — no alias_inc), so
                // track is_arr; `for x in a` / `a.len()` then resolve.
                ast.ExprLambda(clam) => {
                    if (clam.body.len() > 0) {
                        match (iife_leaf_value(v.init)) {
                            ast.ExprArray(_) => { is_arr = true; },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
        },
        ast.ExprSlice(sl) => {
            // `var x = arr[a:b]`: arr_slice returns a FRESH owned array
            // (rc=1) — a move, no alias_inc. (A string slice isn't an
            // array.)
            if (expr_is_arr_src(sl.array, se)) { is_arr = true; }
        },
        // `var row = a[i]` where `a` is an array-of-arrays: the element is
        // itself an array, so the binding is an array source (lets a later
        // `for x in row` / `row` flow as an array). The element box is the
        // source array's own buffer (a borrow), so no alias_inc here.
        ast.ExprIndex(ixx) => {
            match (ixx.array) {
                ast.ExprIdent(aid) => { if (se.is_arrarr_slot(se.slot_of(aid.name))) { is_arr = true; } },
                // The same row read out of an array-of-array FIELD (`var row =
                // g.rows[i]`), whose level the field declaration carries (#7208).
                ast.ExprFieldAccess(_) => { if (nested_arr_field_read_type(ixx.array, se) != "") { is_arr = true; } },
                _ => {}
            }
        },
        _ => {}
    }
    // String tracking: a `var s = <string expr>` marks the slot as a
    // string (for later `.len()` / concat / eq dispatch). Strings aren't
    // RC'd, so this never sets alias_inc / is_arr — a plain store. The
    // declared type annotation (`var s: string = …`) is authoritative too:
    // it catches a string flowing through an erased generic call
    // (`var s: string = id("hi")`), where the init expr isn't structurally
    // a string but the checker has proven the slot's type.
    var is_str: boolean = expr_is_str(v.init, se) || v.type_name == "string";
    // Struct tracking: `var p = P { .. }` (or `= other_struct_local`, or a
    // `var p: P = …` annotation) records the slot's struct type so `p.x`
    // resolves the field index. Leak-only scalar structs — no RC.
    var struct_ty: string = expr_struct_type(v.init, se);
    if (struct_ty == "" && decl_is_struct(se.structs, v.type_name)) { struct_ty = v.type_name; }
    // An enum-typed annotation (`var a: Shape = Circle(3)`) carries the
    // enum name in local_struct_type too, so `a.method()` dispatches to
    // `<Enum>.<method>` (enum-receiver methods).
    else if (struct_ty == "" && is_enum_like_name(v.type_name, se.structs)) { struct_ty = v.type_name; }
    // A struct- or enum-ARRAY annotation (`var ps: P[]` / `var cs: C[]`)
    // carries the ELEMENT type (the slot is is_arr, so it reads as the
    // element type for `ps[i]` / `for x in ps`, not the slot's own type).
    // An enum element type lets `cs[i].method()` dispatch to
    // `<Enum>.<method>` (the array-element analog of #2947, #2954 item 2).
    else if (struct_ty == "" && is_array_type_name(v.type_name)
             && (decl_is_struct(se.structs, slice_unchecked(v.type_name, 0, v.type_name.len() - 2))
                 || is_enum_like_name(slice_unchecked(v.type_name, 0, v.type_name.len() - 2), se.structs))) {
        struct_ty = slice_unchecked(v.type_name, 0, v.type_name.len() - 2) + "";
    }
    // A 2D struct-/enum-ARRAY annotation (`var a: P[][]`): the INNERMOST
    // element is the struct/enum (strip both `[]`). The slot is is_arrarr;
    // the array-foreach propagates this element type through `row` (the
    // inner array) to its struct element, so `for row in a { for p in row
    // { p.field } }` resolves (#3059, the depth-2 sibling of the P[] case).
    else if (struct_ty == "" && is_array_type_name(v.type_name)
             && v.type_name.len() >= 4 && is_array_type_name(slice_unchecked(v.type_name, 0, v.type_name.len() - 2))
             && (decl_is_struct(se.structs, slice_unchecked(v.type_name, 0, v.type_name.len() - 4))
                 || is_enum_like_name(slice_unchecked(v.type_name, 0, v.type_name.len() - 4), se.structs))) {
        struct_ty = slice_unchecked(v.type_name, 0, v.type_name.len() - 4) + "";
    }
    // A struct-array LITERAL without annotation (`var ps = [P { .. }, ..]`):
    // infer the ELEMENT struct type from the first element, matching the
    // `var ps: P[]` annotation path above, so `ps[i].field` / `for x in ps`
    // recover it instead of bailing (#2793 sibling).
    else if (struct_ty == "") {
        match (v.init) {
            ast.ExprArray(arrl) => {
                if (arrl.elements.len() > 0) {
                    // Classify the first element by its leaf branch for an
                    // if-/match-EXPRESSION element (iife_leaf_value is a no-op
                    // otherwise), so `var a = [if (c) { P { .. } } else { … }]`
                    // records the element struct type for `a[i].field` (#3183).
                    var est: string = expr_struct_type(iife_leaf_value(arrl.elements[0]), se);
                    if (est != "" && decl_is_struct(se.structs, est)) { struct_ty = est; }
                    else {
                        // An enum-array literal (`var a = [R, G]`): the
                        // element type is the variants' enum owner, so
                        // `a[i].method()` dispatches to `<Enum>.<method>`
                        // (#2954 item 2).
                        var eet: string = expr_enum_type(iife_leaf_value(arrl.elements[0]), se);
                        if (eet != "") { struct_ty = eet; }
                        // A 2D struct/enum array LITERAL (`[[P { .. }], …]`):
                        // the first element is itself an array — recurse into
                        // ITS first element for the innermost struct/enum
                        // type (the unannotated-literal sibling of #3058; the
                        // depth-2 array literal sets is_arrarr below, and the
                        // array-foreach propagates this element type through
                        // `row` to its element).
                        else {
                            match (arrl.elements[0]) {
                                ast.ExprArray(inner) => {
                                    if (inner.elements.len() > 0) {
                                        var iest: string = expr_struct_type(inner.elements[0], se);
                                        if (iest != "" && decl_is_struct(se.structs, iest)) { struct_ty = iest; }
                                        else {
                                            var ieet: string = expr_enum_type(inner.elements[0], se);
                                            if (ieet != "") { struct_ty = ieet; }
                                        }
                                    }
                                },
                                _ => {}
                            }
                        }
                    }
                }
            },
            _ => {}
        }
    }
    // An UNANNOTATED `T[][]` FIELD read (`var rows = g.rows`, rows: P[][]): the
    // innermost element type comes from the field declaration, exactly as the
    // `var a: P[][]` annotation above takes it from the spelling — so `for row in
    // g.rows { for p in row { p.field } }`, whose hidden iteration binding has no
    // annotation at all, resolves the element (#7208).
    if (struct_ty == "") {
        var nfrt: string = nested_arr_field_read_type(v.init, se);
        if (nfrt != "") {
            var nfel: str = slice_unchecked(nfrt, 0, nfrt.len() - 4);
            if (decl_is_struct(se.structs, nfel) || is_enum_like_name(nfel, se.structs)) { struct_ty = nfel + ""; }
        }
    }
    // LAST resort: an UNANNOTATED binding to an enum VALUE (`var c = Green`,
    // `var e = A(9)`) records the slot's ENUM type — recovered from the
    // variant via its enum_owner — so `c.method()` dispatches to
    // `<Enum>.<method>`. Without this the slot stays untyped and the
    // enum-receiver method call bails the whole module (#2947).
    // A standalone `if` (NOT chained off the struct-array-literal `else
    // if (struct_ty == "")` above, which is entered for ANY untyped init
    // and would otherwise swallow this clause for a non-array enum init —
    // e.g. `var e = A(9)`): it runs whenever the slot is still untyped,
    // and expr_enum_type is "" for the struct / struct-array branches, so
    // it never pre-empts them.
    if (struct_ty == "") {
        var enum_init: string = expr_enum_type(v.init, se);
        if (enum_init != "") { struct_ty = enum_init; }
    }
    // A struct-valued if-/match-EXPRESSION (`var p = if (c) { P { .. } }
    // else { .. }`) desugars to a 0-arg IIFE (ExprCall{callee: ExprLambda}).
    // Recover p's struct type from the first branch's returned struct
    // literal, so `p.field` resolves (the struct sibling of the Option
    // if-expression binding #3124; lower_iife already lowers the
    // struct-valued if-expression itself, as it does for tuple/enum).
    if (struct_ty == "") {
        match (v.init) {
            ast.ExprCall(ic) => {
                match (ic.callee) {
                    ast.ExprLambda(ilam) => {
                        if (ilam.body.len() > 0) {
                            var bre: ast.Expr = iife_leaf_value(v.init);
                            var bst: string = expr_struct_type(bre, se);
                            if (bst != "" && decl_is_struct(se.structs, bst)) { struct_ty = bst; }
                            else {
                                // A struct-ARRAY-valued if-/match-expression
                                // (`var ps = if (c) { [P { .. }] } else { … }`):
                                // record the ELEMENT struct type and mark the
                                // slot is_arr (a fresh owned move, rc=1, no
                                // alias_inc), so `ps[i].field` resolves.
                                match (bre) {
                                    ast.ExprArray(bra) => {
                                        if (bra.elements.len() > 0) {
                                            var est: string = expr_struct_type(bra.elements[0], se);
                                            if (est != "" && decl_is_struct(se.structs, est)) { struct_ty = est; is_arr = true; }
                                        }
                                    },
                                    _ => {}
                                }
                            }
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    // Aliasing an array local (`var qs = ps`) — expr_struct_type returns
    // "" for an array (the value itself isn't a struct), so the ELEMENT
    // struct/enum type the source array carries (which drives
    // `qs[i].field` / `qs[i].method()` dispatch) would be lost. Copy it
    // from the source slot. (is_arr / alias_inc are already set by the
    // ExprIdent arm above.)
    struct_ty = struct_ty_from_arr_alias(se, v, struct_ty);
    // string[] tracking (element typing for a[i]); the annotation is
    // authoritative too. The array itself is already is_arr (RC-tracked).
    var is_strarr: boolean = expr_is_strarr(v.init, se) || v.type_name == "string[]";
    // f64[] tracking (element WIDTH for a[i]); the annotation is
    // authoritative too. The array itself is already is_arr (RC-tracked).
    var is_f64arr: boolean = expr_is_f64arr(v.init, se) || is_float_array_type_name(v.type_name);
    // f32[] rides is_f64arr's slot and stride; this only keys `a[i]`'s method
    // dispatch (LocalInfo.is_f32arr). From the annotation, or from a literal
    // whose first element is statically f32 when there is none.
    var is_f32arr: boolean = is_f64arr && (v.type_name == "f32[]" || expr_is_f32arr_src(v.init, se));
    // i64[] tracking (element WIDTH + i64 value typing for a[i]). The
    // literal form is handled by a dedicated branch above; here this
    // catches aliasing (`var b = a`) and the `i64[]` annotation.
    var is_i64arr: boolean = expr_is_i64arr(v.init, se) || v.type_name == "i64[]" || v.type_name == "u64[]";
    // boolean[] tracking (element DISPATCH for a[i] — no width or stride
    // implication, see LocalInfo.is_boolarr). The annotation is authoritative;
    // the init predicate catches an alias (`var b = bs`) and a bool literal
    // array (`var bs = [true, false]`). #6117.
    var is_boolarr: boolean = expr_is_boolarr(v.init, se) || v.type_name == "boolean[]";
    // boolean SCALAR tracking (#6305) — the same dispatch-only fact one level
    // down, so `var ok = true; ok.to_json()` keys "boolean.to_json". The init
    // predicate covers the unannotated binding and an alias of another boolean
    // local; the annotation covers a value expr_is_bool cannot see through.
    var is_bool: boolean = expr_is_bool(v.init, se) || v.type_name == "boolean";
    // INVARIANT: an INIT the element-kind predicates recognise as a typed array
    // is an array.
    //
    // Each of the three comments above asserts "the array itself is already
    // is_arr". That was an assumption, not a derivation, and it was wrong. The
    // `is_arr` decision a few hundred lines up enumerates callee names by hand
    // (`__alloc_u8`, `str_split`, `args`, is_arr_ret_fn) and so does
    // expr_is_strarr (`str_split`, `args`, strarr_ret_argref, is_strarr_ret_fn)
    // — two independent hand-maintained lists answering the same question about
    // the same expression. `args()` sat in one and not the other for as long as
    // the builtin has existed, so `var a = args()` came out string-array-tracked
    // and NOT array-tracked: `a[i]` and `a.len()` lowered fine while `for s in a`
    // bailed the whole function. #5983 patched
    // the missing entry; this removes the way for the next one to hide.
    //
    // Deliberately keyed on the INIT predicates only, not on the is_strarr /
    // is_f64arr / is_i64arr flags above — those also take the ANNOTATION
    // (`v.type_name == "string[]"`), and `is_arr` has never consulted an
    // annotation. Folding that in would newly array-track
    // `var xs: string[] = <init the walker does not recognise>`, and is_arr
    // drives the exit dec-sweep, so it is an RC change rather than a typing one.
    // An init a kind-predicate positively identifies as a typed array, on the
    // other hand, IS an array by construction (#3457).
    if (expr_is_strarr(v.init, se) || expr_is_f64arr(v.init, se) || expr_is_i64arr(v.init, se)) { is_arr = true; }
    // bind AFTER lowering the init (the init can't see the new name)
    // Option/Result tracking: `var r = f()` of an Option/Result-returning
    // call (or a `var r: Option[T] = …` annotation) records the slot's
    // Option type, so a later `match (r)` recovers the payload type.
    var opt_ty: string = "";
    match (v.init) {
        ast.ExprCall(ic) => {
            match (ic.callee) {
                ast.ExprIdent(icid) => {
                    opt_ty = resolve_argref_opt_type(se.opt_ret_type(icid.name), ic.args, se);
                    // `var o = Some(7)` — a direct Option construction
                    // records o's opt_type so a later `match (o)`
                    // recovers the payload (the construction analogue of
                    // the Option-returning call above).
                    if (opt_ty == "") {
                        opt_ty = some_opt_type(v.init, se);
                        // `Some(None)` is the one payload the walk cannot type
                        // at all: `None` is an ExprIdent with no slot, so
                        // elem_type_tag falls to its "i32" default and the
                        // construction answers a FABRICATED "Option[i32]".
                        // That beat the declared type of `var o:
                        // Option[Option[i32]] = Some(None)`, binding the
                        // `Some(inner)` arm's payload as a scalar and bailing
                        // the nested `match (inner)` (#7217).
                        //
                        // Only here does the annotation win. This column is a
                        // lowering TAG, not the declared type — a scalar-array
                        // payload deliberately keeps a bare "i32" where the
                        // annotation spells `Option[i32[]]` — so substituting
                        // the annotation wholesale silently drops the payload's
                        // reclaim.
                        if (opt_ty != "" && some_payload_is_bare_none(v.init)
                                && v.type_name.len() >= 8
                                && (slice_unchecked(v.type_name, 0, 7) == "Option[" || slice_unchecked(v.type_name, 0, 7) == "Result[")) {
                            opt_ty = v.type_name;
                        }
                    }
                },
                ast.ExprFieldAccess(ifa) => {
                    // A built-in array method returning Option (`var o = xs.min()`)
                    // — helper-backed, so its return type comes from the registry
                    // rather than the module's own funcs.
                    opt_ty = builtin_arr_opt_ret_type(ifa.field, ifa.obj, se);
                    // A built-in Reader/Writer resource method (`var e = w.write(s)`)
                    // — also helper-backed, so the same registry answers, under
                    // lower_call_method's bare-fd receiver gate.
                    if (opt_ty == "") { opt_ty = resource_method_opt_ret_type(ifa.field, ifa.obj, se); }
                    // Associated call `Type.method()` returning Option/Result
                    // — bare TYPE-name object (not a slot); key by
                    // "<Type>.<method>" so `var r = User.from_json(s)` records
                    // r's Result[User, string] type for a later `match (r)`.
                    if (opt_ty == "") {
                        match (ifa.obj) {
                            ast.ExprIdent(tid) => {
                                if (se.slot_of(tid.name) < 0) { opt_ty = se.opt_ret_type(tid.name + "." + ifa.field); }
                            },
                            _ => {}
                        }
                    }
                    // `var o = x.get()` where x's method returns
                    // Option/Result — key by "<Type>.<method>" so a
                    // later `match (o)` recovers the payload type.
                    if (opt_ty == "") {
                    var irty: string = expr_struct_type(ifa.obj, se);
                    if (irty != "") { opt_ty = se.opt_ret_type(irty + "." + ifa.field); }
                    // An Option/Result-RECEIVER method (`Some(5).map()` /
                    // `r.map()`) keyed "Option.<m>" / "Result.<m>" (#3049).
                    else {
                        var irb: string = opt_recv_base_type(ifa.obj, se);
                        if (irb != "") { opt_ty = se.opt_ret_type(irb + "." + ifa.field); }
                        // An enum-receiver method returning Option/Result on
                        // a fresh variant (`var o = V(7).get()`) (#3076).
                        else {
                            var ien: string = expr_enum_type(ifa.obj, se);
                            if (ien != "") { opt_ty = se.opt_ret_type(ien + "." + ifa.field); }
                        }
                    }
                    }
                },
                // `var o = if (c) { Some(7) } else { None }` — an
                // if-/match-EXPRESSION desugars to a 0-arg IIFE
                // (ExprCall{callee: ExprLambda}). Recover o's Option type
                // from the leaf branch's returned Some(...) via some_opt_type,
                // so a later `match (o)` lowers (lower_iife already lowers the
                // Option-valued if-expression itself). When the leaf branch
                // returns an Option/Result-typed LOCAL instead of a fresh
                // `Some(..)` (`if (c) { someOpt } else { None }`), recover from
                // that slot's tracked opt_type.
                ast.ExprLambda(ilam) => {
                    if (ilam.body.len() > 0) {
                        var oleaf: ast.Expr = iife_leaf_value(v.init);
                        opt_ty = some_opt_type(oleaf, se);
                        if (opt_ty == "") {
                            match (oleaf) {
                                ast.ExprIdent(olid) => { opt_ty = se.opt_type_of_slot(se.slot_of(olid.name)); },
                                // The leaf branch returns the result of an
                                // Option/Result-returning function call
                                // (`if (c) { mkO(7) } else { None }`): recover
                                // from the callee's registered opt return type
                                // so a later `match (o)` lowers.
                                ast.ExprCall(olc) => {
                                    match (olc.callee) {
                                        ast.ExprIdent(olcid) => { opt_ty = se.opt_ret_type(olcid.name); },
                                        _ => {}
                                    }
                                },
                                _ => {}
                            }
                        }
                    }
                },
                _ => {}
            }
        },
        // `var u = o` where o is an Option/Result LOCAL — an un-annotated alias.
        // The IIFE-leaf arm above already recovers an opt_type from an ident this
        // way; the plain alias did not, so `var o = Some(20); var u = o;` left u
        // untyped and the later `match (u)` could not recover the payload, bailing
        // the module. (Annotating u worked, which is what made
        // this look like a match gap rather than a propagation one.)
        ast.ExprIdent(oaid) => { opt_ty = se.opt_type_of_slot(se.slot_of(oaid.name)); },
        // `var t = s[a:b]` — the checked string slice (#5634) binds an
        // Option[str], so a later `match (t)` recovers the payload.
        ast.ExprSlice(osl) => { if (expr_is_str(osl.array, se)) { opt_ty = "Option[string]"; } },
        _ => {}
    }
    if (opt_ty == "" && v.type_name.len() >= 8 && (slice_unchecked(v.type_name, 0, 7) == "Option[" || slice_unchecked(v.type_name, 0, 7) == "Result[")) { opt_ty = v.type_name; }
    // An UNANNOTATED array literal of Option values (`var a = [Some(1),
    // Some(2), None]`): infer the element opt-type from the first Some
    // element and record the slot's "Option[T][]" (the array form — the
    // foreach / index element path strips the trailing `[]`). The
    // construction analogue of the `var a: Option[T][] = …` annotation
    // above (#3024 array sibling). `None`-only literals stay untyped.
    opt_ty = opt_ty_from_array_literal(se, v, opt_ty);
    // `var a = if (c) { [Some(1)] } else { … }` — an Option-array bound
    // from an if-/match-EXPRESSION (IIFE: ExprCall{callee: ExprLambda}).
    // Recover the slot's "Option[T][]" from the first branch's array literal
    // (the IIFE sibling of the array-literal case above), so `match (a[i])`
    // / `for o in a` recover the element payload. The slot is already marked
    // is_arr for an IIFE-array result (#3141).
    opt_ty = opt_ty_from_iife_result(se, v, opt_ty);
    // `var o = a[i]` where `a` is an Option/Result ARRAY — the element is
    // an Option/Result value, so record o's opt_type (strip the array's
    // `[]`) so a later `match (o)` recovers the payload. This also drives
    // the desugared `for o in a` (its iter-hoist binds `var o =
    // __foreach_iter[idx]`). The ExprIdent arm preserves the array's
    // opt_type across the foreach's `var __foreach_iter = a` alias so the
    // element recovery still fires (mirrors the struct-element alias above).
    opt_ty = opt_ty_from_index_alias(se, v, opt_ty);
    // An explicitly array-typed binding (`var w: u32[] = f()`) is an
    // array regardless of how the init was classified — the init-based
    // checks above miss an array-returning call when the array-return
    // registry isn't threaded (the eligibility probe), so fold in the
    // DECLARED type. Keeps a reassign-self `w = w.with(...)` eligible
    // without threading arr_ret_fns through the probe.
    if (is_array_type_name(v.type_name)) { is_arr = true; }
    // Perceus alias-inc for a CONTAINER READ (#3457): an is_arr binding whose
    // init reads the buffer out of a container it does not own —
    // `var vn: string[] = mod.enums[en].variant_names;` (struct field),
    // `var xs: i32[] = t.0;` (tuple element), `var row: i32[] = grid[i];`
    // (array-of-array element) — is a second reference to a LIVE buffer the
    // container still points at. The slot is swept at function exit
    // (emit_dec_sweep_except_list decs every is_arr slot), so without a retain
    // that dec frees the field out from under its owner: the enum table's
    // variant_names buffer was released while the checker still read it, so a
    // later allocation recycled it and unit-variant lookups started failing
    // (a bogus E001 on `return (A, 1)`, a missing E030 on a guarded-only
    // match). Retain it with the same Perceus dup the bare-ident alias uses so
    // the sweep dec is balanced; a borrowed source simply leaks one count
    // (sound), never over-frees. Fresh producers (array literal, slice,
    // array-returning call) are moves and stay un-inc'd, and a hoisted-closure
    // capture extract (`var <cap> = __env[1+i]`, registered "ENVCAP:" by
    // lower_func) is excluded: the sweep already skips it as a BORROW, so a
    // retain here would have no matching dec and leak one count per call.
    if (is_arr && !alias_inc && !reclaim_has(se.reclaimable_names, "ENVCAP:", reclaim_site_key_of(v.name, v.line, v.col))) {
        match (v.init) {
            ast.ExprFieldAccess(_) => { alias_inc = true; },
            ast.ExprIndex(_) => { alias_inc = true; },
            _ => {}
        }
    }
    // Closure-array: `var fns = [<closure>, ...]` — an array literal whose
    // elements are function VALUES (lambdas or calls to closure-returning
    // fns). Mark the slot so a later `var c = fns[i]` / `for f in fns`
    // types the element as a closure (its call unpacks the env box).
    var is_closurearr: boolean = closurearr_of_init(is_arr, s, se, v);
    // Array-of-arrays (`i32[][]`, `string[][]`, …): set from a depth-2
    // array ANNOTATION, an array-of-array LITERAL (first element is itself
    // an array), or ALIASING an existing array-of-arrays local. Lets a
    // later `var row = a[i]` / `for row in a` type the inner element as an
    // array (so `for x in row` flows). One nesting level (depth 2).
    var is_arrarr: boolean = false;
    if (is_array_type_name(v.type_name) && v.type_name.len() >= 4 && is_array_type_name(slice_unchecked(v.type_name, 0, v.type_name.len() - 2))) { is_arrarr = true; }
    is_arrarr = arrarr_from_init_shape(s, se, v, is_arrarr);
    // Inner element kind of a T[][] binding ("i64"/"f64"/"string"/"") so a
    // nested read m[i][j] picks the right load (8-byte instead of
    // truncating, #2691) AND `.len()` on a nested string element dispatches
    // to str_len not arr_len (#4081 — a string box's length is at offset 8,
    // but arr_len reads offset 0, the data pointer, giving a layout-
    // dependent garbage length). expr_is_strarr's ExprIndex case keys off
    // the "string" tag to recognise `m[i]` of a string[][] as a string[].
    var arrarr_e: string = arrarr_elem_kind_of_init(is_arrarr, se, v);
    // #4365 ARRTUP: an `(<tuple-with-array>)[]` array-of-tuples slot stays plain
    // is_arr (its elements are tuple boxes, not arrays, so is_arrarr is false) but
    // records its ELEMENT TUPLE TYPE in arrarr_elem so slot_is_reclaimable_arrtup's
    // release can type-drive each element's deep-drop.
    if (is_arr && !is_arrarr) {
        var atet: string = arrtup_elem_tuple_type(v.type_name, se.structs);
        if (atet != "") { arrarr_e = atet; }
    }
    // An all-scalar `(u64, i32)[]` tuple-array is NOT deep-droppable, so
    // arrtup_elem_tuple_type returned "" above — but the READ side still needs the
    // element tuple type so `xs[i].N` recovers a u64 element's SIGN (the #5206
    // sibling: elem_type_tag coarsens a u64 tuple element to "i64", losing the
    // unsigned-ness so a chained `xs[i].N >> 1` / `> x` used shr_s / gt_s). Record
    // the ANNOTATION's tuple string here — it preserves "u64" — for the read side
    // only. Reclaim-inert: collect_fresh_arrtup_names gates on deep-droppability, so
    // an all-scalar tuple array never earns the ARRTUP credit slot_is_reclaimable_
    // arrtup also requires, and the array stays leak-only.
    if (is_arr && !is_arrarr && arrarr_e == "") {
        var tan: string = v.type_name;
        if (tan.len() >= 4 && slice_unchecked(tan, tan.len() - 2, tan.len()) == "[]") {
            var tin: str = slice_unchecked(tan, 0, tan.len() - 2);
            if (util.is_tuple_type_name(tin)) { arrarr_e = tin + ""; }
        }
    }
    // UNANNOTATED array-of-tuples literal (`var a = [(e0, e1), …]`): infer the
    // element tuple tag from the FIRST literal element (elem_type_tag — post-lift,
    // so a lambda element reads "clo"), so `a[j].N` reads and the `a[j].N(args)`
    // closure-element dispatch resolve via expr_tuple_elem_tag's Index arm instead
    // of falling through to bogus method dispatch and bailing the module.
    // Reclaim-inert: ARRTUP crediting requires an annotated decl, so this tag only
    // feeds the read/dispatch side (the array stays leak-only).
    arrarr_e = arrtup_elem_tag_of_init(is_arr, is_arrarr, se, v, arrarr_e);
    var vt: VarTypes = VarTypes {
        is_arr: is_arr,
        alias_inc: alias_inc,
        is_str: is_str,
        is_strarr: is_strarr,
        is_f64arr: is_f64arr,
        is_f32arr: is_f32arr,
        is_i64arr: is_i64arr,
        is_bool: is_bool,
        is_boolarr: is_boolarr,
        is_closurearr: is_closurearr,
        is_arrarr: is_arrarr,
        arrarr_e: arrarr_e,
        struct_ty: struct_ty,
        opt_ty: opt_ty,
    };
    return bind_var_slot(v, s, se, vt);
}

// The tuple/struct destructuring bind: `var (a, b) = …`, reached when the
// name carries a comma. Splits the pattern, lowers the initialiser once, and
// binds each component to its own slot.
function lower_stmt_var_destructure(v: ast.StmtVar, s: LowerState): LowerState {
    // N-element destructure `var (a, b, c, …) = E`: the parser encodes
    // the name as "a,b,c,…". Eval the tuple box into a fresh temp, then
    // bind name[i] = tuple_get(i). Scalar / string / struct elements
    // (the same set the tuple LITERAL admits — a heap element bails the
    // init lowering, so it never reaches here).
    // Split on TOP-LEVEL commas: a NESTED position rides as its own
    // parenthesised list (`"a,(b,c)"`), and its commas belong to that
    // level, not this one.
    var dnames: string[] = [];
    var dstart: i32 = 0;
    var dp: i32 = 0;
    var ddepth: i32 = 0;
    while (dp <= v.name.len()) {
        if (dp == v.name.len() || (v.name[dp] == b',' && ddepth == 0)) {
            dnames = dnames.append(slice_unchecked(v.name, dstart, dp));
            dstart = dp + 1;
        } else if (v.name[dp] == b'(') { ddepth = ddepth + 1; }
        else if (v.name[dp] == b')') { ddepth = ddepth - 1; }
        dp = dp + 1;
    }
    var dn: i32 = dnames.len();
    var td_at: string = parser.destr_marker_split(v.type_name).at;
    var dt: LowerState = lower_expr(v.init, s);
    if (!dt.ok) { return dt; }
    // An `@` binding names the temp holding the whole tuple, as it does
    // for the struct form.
    var tmp: string = td_at;
    if (tmp.len() == 0) { tmp = "$tdst" + util.i32_to_string(dt.locals.len()); }
    dt = dt.add_local(tmp);
    var tmp_slot: i32 = dt.slot_of(tmp);
    dt = dt.emit(ir.op_store_local(tmp_slot));
    var dk: i32 = 0;
    while (dk < dn) {
        // A NESTED position `(b,c)` is not a name: bind the inner tuple to
        // a temp here and destructure that temp again below, which is the
        // shape the second level already had to work for (`var (s, b) = p`
        // over a tuple-tagged local).
        var dbind: string = dnames[dk];
        var dnest: string = "";
        if (util.is_tuple_type_name(dbind)) {
            dnest = slice_unchecked(dbind, 1, dbind.len() - 1) + "";
            dbind = "$dnest" + util.i32_to_string(dt.locals.len());
        }
        dt = dt.add_local(dbind);
        var dkslot: i32 = dt.slot_of(dbind);
        // Type the binding from the source tuple's element tag: an
        // inline `(e0, e1, …)` literal from the element exprs, a tuple
        // local/param from its tracked tags. (Tags read from `s`, the
        // pre-destructure scope, where the source elements live.)
        var dtag: string = "";
        match (v.init) {
            ast.ExprTuple(dl) => {
                if (dl.elements.len() == dn) { dtag = elem_type_tag(dl.elements[dk], s); }
            },
            ast.ExprIdent(did) => { dtag = s.tuple_elem_tag(s.slot_of(did.name), dk); },
            ast.ExprIndex(dix) => {
                // `var (a, b, …) = arr[i]` over a `(tuple)[]` array-of-tuples
                // local: the element TUPLE TYPE is recorded on the (is_arr)
                // slot's arrarr_elem (#4365). Read element dk's tag out of it —
                // the destructure sibling of expr_tuple_elem_tag's ExprIndex arm,
                // so a struct / nested-tuple element binds typed instead of
                // untyped (which read `p.x` off an unmarked slot and bailed).
                match (dix.array) {
                    ast.ExprIdent(daid) => {
                        var dasl: i32 = s.slot_of(daid.name);
                        if (dasl >= 0 && s.is_arr_slot(dasl)) {
                            var det: string = s.arrarr_elem_of_slot(dasl);
                            if (util.is_tuple_type_name(det)) { dtag = tuple_type_elem_tag(det, dk); }
                        }
                    },
                    _ => {}
                }
                // arrarr_elem is only recorded for an ANNOTATED `(tuple)[]`
                // local, so `var ps = mk();` (or a bare `mk()[0]`) leaves the
                // walk empty and every element read as a 4-byte i32 — an f64
                // element then came back garbage with no diagnostic. ExprIndex.ty
                // (#6165) already carries the checker's type for this node; this
                // is the same walk-first/tag-fills-the-hole fallback
                // expr_tuple_elem_tag's ExprIndex arm has, which is why
                // `ps[0].1` was right while `var (i, v) = ps[0]` was not.
                if (dtag == "" && util.is_tuple_type_name(dix.ty)) { dtag = tuple_type_elem_tag(dix.ty, dk); }
            },
            ast.ExprCall(dcl) => {
                // `var (a, b, …) = f()` / `= obj.f()` — recover element
                // dk's tag from the tuple-returning function's registry
                // entry (free fn by bare name, method by "Type.method").
                match (dcl.callee) {
                    ast.ExprIdent(dcid) => { dtag = csv_nth(resolve_argref_tuple_tags(s.tuple_ret_type(dcid.name), dcl.args, s), dk); },
                    ast.ExprFieldAccess(dfa) => {
                        var drty: string = expr_struct_type(dfa.obj, s);
                        if (drty != "") { dtag = csv_nth(resolve_argref_tuple_tags(s.tuple_ret_type(drty + "." + dfa.field), dcl.args, s), dk); }
                        else if (dfa.field == "without") {
                            // `m.without(k)` yields (Map[K,V], boolean):
                            // element 0 is the receiver's map type, 1 is
                            // the existed flag. Tag elem 0 with the map
                            // type so the bound local re-marks as a map
                            // (else `m2.len()` etc. miscompile) (#2926).
                            var dwmt: string = "";
                            match (dfa.obj) {
                                ast.ExprIdent(dwid) => { dwmt = s.map_type_of(s.slot_of(dwid.name)); },
                                _ => {}
                            }
                            if (dwmt != "") {
                                if (dk == 0) { dtag = dwmt; } else { dtag = "boolean"; }
                            }
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        // Emit the element read at its width (8-byte i64/f64 use the
        // matching load), then store + type the binding. An i64
        // element marks the slot i64 (so later uses route through
        // lower_i64); an f64 element marks it f64.
        dt = dt.emit(ir.op_load_local(tmp_slot));
        if (dtag == "i64" || dtag == "u64") { dt = dt.emit(ir.op_tuple_get_w(dk, 64, true)); }
        else if (dtag == "f64" || dtag == "f32" || dtag == "float") { dt = dt.emit(ir.op_tuple_get_w(dk, 64, false)); }
        else { dt = dt.emit(ir.op_tuple_get(dk)); }
        dt = dt.emit(ir.op_store_local(dkslot));
        if (dtag == "string") { dt = dt.mark_str(dkslot, true); }
        // A closure-BOX element ("clo") binds a closure local so
        // `f(args)` on the binding dispatches env-first against the box.
        else if (dtag == "clo") { dt = dt.mark_closure_local(dbind); }
        else if (dtag == "i64") { dt = dt.mark_i64(dkslot, true); }
        else if (dtag == "u64") { dt = dt.mark_u64(dkslot, true); }
        else if (dtag == "f64" || dtag == "f32" || dtag == "float") { dt = dt.mark_f64(dkslot, true); }
        else if (is_map_type_name(dtag)) { dt = dt.mark_map_type(dkslot, dtag); }
        else if (dtag.len() >= 8 && (slice_unchecked(dtag, 0, 7) == "Option[" || slice_unchecked(dtag, 0, 7) == "Result[")) { dt = dt.mark_opt_type(dkslot, dtag); }
        // A TUPLE element (`var (p, c) = t` over ((string, i32), i32): p's
        // tag is the nested tuple's spelling): record p's element tags so a
        // SECOND-level destructure `var (s, b) = p` (and `p.N` reads)
        // resolve their element types. Without this the nested tuple bound
        // untyped and its STRING element read as an unmarked i32 — empty
        // (#5306 gap 1; the all-i32 shape only worked because the untyped
        // fallback happens to be i32).
        else if (util.is_tuple_type_name(dtag)) { dt = dt.mark_tuple_elems(dkslot, tuple_elem_tags(dtag)).mark_tuple_type(dkslot, dtag); }
        // A 4-byte scalar-array element (i32[]/boolean[]/u32[]) binds the
        // slot as an array (the op_tuple_get above read its pointer) so
        // `arr[i]` rides the 4-byte arr_get; a u32[] also marks u32 so a
        // read element's arithmetic wraps.
        else if (dtag == "i32[]" || dtag == "boolean[]" || dtag == "u32[]" || is_subword_array_type(dtag)) {
            dt = dt.mark_arr(dkslot, true);
            if (dtag == "u32[]") { dt = dt.mark_u32(dkslot, true); }
        }
        // An 8-byte-element (f64[]/i64[]) or string[] array element
        // binds the slot as an array AND marks its element kind so a
        // later `arr[i]` rides the width-marked arr_get(64) / arr_get_i64
        // (f64/i64) or the string read (string[]) — the read-side twin
        // of the f64[]/i64[]/string[] admission in tuple_elems_lowerable.
        else if (is_float_array_type_name(dtag)) { dt = dt.mark_arr(dkslot, true); dt = dt.mark_f64arr(dkslot, true); }
        else if (dtag == "i64[]") { dt = dt.mark_arr(dkslot, true); dt = dt.mark_i64arr(dkslot, true); }
        else if (dtag == "string[]") { dt = dt.mark_arr(dkslot, true); dt = dt.mark_strarr(dkslot, true); }
        // A struct-array (X[]) or enum-array (E[]) element binds the slot
        // as an array AND carries the element struct/enum name (strip the
        // "[]") so `xs[i].field` / `match (xs[i])` resolve the element
        // shape — the read-side twin of the struct/enum-array admission
        // in tuple_elems_lowerable, mirroring the #3292 field-read bind.
        else if (is_struct_array_field_type(dt.structs, dtag) || is_enum_array_field_type(dt.structs, dtag)) {
            dt = dt.mark_arr(dkslot, true);
            dt = dt.mark_struct_type(dkslot, slice_unchecked(dtag, 0, dtag.len() - 2));
        }
        else if (decl_is_struct(dt.structs, dtag)) { dt = dt.mark_struct_type(dkslot, dtag); }
        // A nominal-enum element carries its enum name in local_struct_
        // type (like an enum local/param) so `match (c)` / `c.method()`
        // on the bound slot dispatches to `<Enum>.<variant/method>`.
        else if (is_enum_like_name(dtag, dt.structs)) { dt = dt.mark_struct_type(dkslot, dtag); }
        // Dup-at-extract (#7682). `op_tuple_get` hands out the element POINTER,
        // but the marks above make this slot one the scope-exit sweep RELEASES
        // — so without a retain the binding gives back a reference it never
        // took, and wherever the source tuple also carries a reclaim credit the
        // same buffer was decremented twice: the first dec frees it, the second
        // underflows into the quarantined block (a use-after-free the balanced
        // census cannot see). The dup pairs them: rc 1 →inc 2 →this binding's
        // sweep 1 →the tuple's own drop 0.
        //
        // is_leaksafe_array_field is exactly the set the sweep releases with a
        // shallow `__fern_rc_dec`, and exactly the set measured to over-release.
        // The deeper-release kinds are deliberately NOT here — a `string[]`
        // (__fern_str_arr_free) and a struct / enum array (element walk) LEAK
        // rather than over-release, so retaining one would deepen a leak instead
        // of closing a double-dec; each is its own measured increment.
        if (is_leaksafe_array_field(dtag)) {
            dt = dt.emit(ir.op_load_local(dkslot));
            dt = dt.emit(ir.op_call_direct("__fern_rc_inc", 1));
            dt = dt.emit(ir.op_drop());
        }
        // The temp is bound and its element tags are marked, so the inner
        // level lowers as an ordinary destructure of that temp — the same
        // recursion the source spelling describes.
        if (dnest.len() > 0) {
            dt = lower_stmt_var(ast.StmtVar { name: dnest, type_name: "", init: ast.ExprIdent { name: dbind, line: v.line, col: v.col, ty: "" }, line: v.line, col: v.col, is_str: false, fn_ret: "", fn_param_types: "" }, dt);
            if (!dt.ok) { return dt; }
        }
        dk = dk + 1;
    }
    return dt;
}

// The closure-valued bind: `var f = |x| …` and the fn-typed initialisers that
// produce a closure BOX rather than a bare function value.
function lower_stmt_var_closure(v: ast.StmtVar, init_retclo: boolean, s: LowerState): LowerState {
    var cv: LowerState = lower_expr(v.init, s);
    if (!cv.ok) { return cv; }
    var cvb: LowerState = cv.add_local(v.name);
    cvb = cvb.mark_reclaim_site(cvb.slot_of(v.name), reclaim_site_key_of(v.name, v.line, v.col));
    var cslot: i32 = cvb.slot_of(v.name);
    cvb = cvb.mark_arr(cslot, true);
    cvb = cvb.mark_closure_local(v.name);
    // The fn-VALUE signature sidecars. This bind does not route through
    // bind_var_slot, so it applies the seed itself — an annotated
    // `var f: (i64) => boolean = |x| …` is a top-level fn-typed local like any
    // other and lower_func's pre-pass filed a row for it.
    cvb = cvb.stamp_fnval_seed(cslot, reclaim_site_key_of(v.name, v.line, v.col));
    // Record an Option/Result return so a later `match (f())` can name its
    // scrutinee type — the closure-LOCAL sibling of the fn-param stamping.
    // (The annotated named-fn-bound form is stamped in bind_var_slot; this
    // covers unannotated lambda / closure inits.)
    var cv_optret: string = closure_init_opt_ret(v.init, cvb);
    if (cv_optret != "") { cvb = cvb.mark_closure_opt_ret(cslot, cv_optret); }
    // #5281: carry the RETCLO fact forward so `var h = g()` (g bound here from
    // a RETCLO2 factory call) recognises g()'s result as a closure.
    if (init_retclo) { cvb = cvb.mark_closure_local("RETCLO$" + v.name); }
    // A bare-ident alias (#4557) or a closure-ARRAY element read (`var d =
    // fns[i]`, #4354) shares a box another owner holds, so the slot takes a
    // counted reference: retain the new value and release whatever the slot
    // held before (a loop-local's previous iteration; null on the first
    // bind). Without the element retain the slot's exit dec freed the box out
    // of the array that still pointed at it. A fresh lambda / `__mkclo$` /
    // closure-returning-call init is already owned at rc=1 and stores bare.
    // An `__env[i]` capture read is not a closure-array read — its slot is an
    // "ENVCAP:" borrow the sweep skips, so it takes no retain here either.
    var clo_alias: boolean = ident_name_or_empty(v.init).len() > 0;
    if let ast.ExprIndex(cix) = v.init {
        var cixn: string = ident_name_or_empty(cix.array);
        if (cixn.len() > 0 && s.is_closurearr_slot(s.slot_of(cixn))) { clo_alias = true; }
    }
    if (clo_alias) { return emit_arr_store(cvb, cslot, true, true); }
    return cvb.emit(ir.op_store_local(cslot));
}

// refine_map_struct_val upgrades a map slot's VALUE tag from the default "i32" to
// a struct name on `m = m.insert(k, P { … })` / `.set(…)`. The unannotated binding
// `var m = map_new_i32(n)` has no insert to read a value type from, so it records
// `Map[K, i32]`; when the first insert arrives as a separate assignment the slot
// would keep that tag forever and a later `var p = m.get_or(…)` could not recover
// P — the read bailed the function. Fact-only: both tags are
// pointer-shaped for op selection (map_value_widekind 0, map_insert_val_is_i64
// false), so no emitted op changes; only the read side's type recovery does.
function refine_map_struct_val(a: ast.StmtAssign, slot: i32, s: LowerState): LowerState {
    var mt: string = s.map_type_of(slot);
    if (!is_map_type_name(mt)) { return s; }
    if (decl_is_struct(s.structs, map_value_of(mt))) { return s; }
    match (a.value) {
        ast.ExprCall(ic) => {
            match (ic.callee) {
                ast.ExprFieldAccess(ifa) => {
                    if ((ifa.field != "insert" && ifa.field != "set") || ic.args.len() != 2) { return s; }
                    var self_recv: boolean = false;
                    match (ifa.obj) {
                        ast.ExprIdent(iid) => { self_recv = iid.name == a.target; },
                        _ => {}
                    }
                    if (!self_recv) { return s; }
                    var vt: string = expr_struct_type(ic.args[1], s);
                    if (!decl_is_struct(s.structs, vt)) { return s; }
                    return s.mark_map_type(slot, "Map[" + map_key_of(mt) + ", " + vt + "]");
                },
                _ => {}
            }
        },
        _ => {}
    }
    return s;
}

// lower_stmt_assign: the ast.StmtAssign arm of lower_stmt, split out so no single
// function's per-function emit accumulation can exhaust the fixed bump
// arena on the whole-compiler per-module emits (a ~3,000-line lower_stmt
// tripped the exit-137 alloc trap on its own; oversized functions also
// miscompile — cf. #2720). Body moved verbatim; the trailing s.fail()
// preserves lower_stmt's own post-match fallback for any fall-through.
function lower_stmt_assign(a: ast.StmtAssign, s: LowerState): LowerState {
    var slot: i32 = s.slot_of(a.target);
    if (slot < 0) { return s.fail(); }
    // SCENRB (#6127): rebinding an admitted all-scalar enum / scalar Option local
    // orphans the box it currently holds, so release it before the new value is
    // stored. Safe to emit ahead of the RHS: admission requires the name never
    // escape outside its consuming match, and walk_stmt_escapes reads assignment
    // RHSs, so `e = f(e)` — the one shape where the old box is still needed here —
    // is excluded. Params are never candidates (the local is fn-declared), but the
    // slot check mirrors the enumfrees emission rather than relying on that.
    if (slot >= s.n_params && reclaim_has(s.reclaimable_names, "SCENRB:", s.reclaim_site_key(slot))) {
        s = s.release(slot, "__fern_rc_dec", "scenrb-old-box");
    }
    s = refine_map_struct_val(a, slot, s);
    // #4297 CS4: a REASSIGNMENT re-binds the slot's string box, so the
    // slot-carried ownership fact becomes the MEET of the old and new
    // bindings' classes -- the sound flow-insensitive summary (a branch-
    // conditional reassign means either box may be live at a later read /
    // drop). Equal classes keep the fact (`x = x + y` on an Owned slot
    // stays Owned -- the fresh-rebind shape); differing classes demote to
    // 1 (Borrowed, never-free -- sound for every mix: freeing is only
    // sound when EVERY binding was Owned). Fact-only; no lowering
    // decision reads it yet (CS4 is behaviour-identical).
    if (s.is_str_slot(slot)) {
        if (str_binding_ownership(a.value, s) != s.str_own_slot(slot)) { s = s.mark_str_own(slot, 1); }
        // Flow-insensitive: once any binding is a caller-owned element, every
        // later store of the slot is counted (retaining is the safe direction).
        if (str_param_elem_escapes(a.value, s)) { s = s.mark_str_caller_elem(slot, true); }
    }
    // `d = <expr>` where `d` is a SCALAR `dyn Trait` local (its
    // local_struct_type starts with "dyn "): the RHS coerces to `dyn
    // Trait` like the `var d: dyn = …` init — a struct/enum value flows
    // unboxed, a primitive/string is heap-boxed via op_dyn_box
    // (lower_dyn_arg makes that choice). Without this a primitive RHS
    // would land in the dyn slot unboxed and mis-dispatch
    // (docs/DYN-TRAITS.md §4.3). Non-dyn assignments fall through to the
    // generic paths below.
    // A dyn ARRAY slot (`var ds: (dyn Trait)[]`) is marked struct_type with
    // the ELEMENT type "dyn Trait" (the `[]` stripped at its init/param bind),
    // so it is indistinguishable from a SCALAR dyn slot by the string alone —
    // but it is ALSO is_arr. Gate on !is_arr so a dyn-array reassign
    // (`ds = ds.append(x)`) falls through to the array append path below
    // instead of coercing the whole grown ARRAY into a single dyn cell
    // [shape, array] and storing THAT into ds (which mis-typed ds and made
    // every later `ds[i].method()` read a garbage self → 0 / SIGSEGV).
    var asg_dty: string = s.struct_type_of_slot(slot);
    if (asg_dty.len() > 4 && slice_unchecked(asg_dty, 0, 4) == "dyn " && !is_array_type_name(asg_dty) && !s.is_arr_slot(slot)) {
        var das: LowerState = lower_dyn_arg(a.value, s);
        if (!das.ok) { return das; }
        return das.emit(ir.op_store_local(slot));
    }
    // Reassign-self builder mutation `a = a.with(i, v)` / `a = a.append(v)`
    // on an OWNED array slot. The single-owner / leak model makes `.with`
    // an in-place element store (arr_set: same layout + bytes as the AST
    // path's in-place .with) and `.append` a grow via __fern_arr_push
    // (arr_push, whose result re-binds the slot). Only fires when the
    // receiver names the assignment target; the aliasing form
    // `b = a.with(...)` is not this and falls through / bails.
    if (s.is_arr_slot(slot)) {
        match (a.value) {
            ast.ExprCall(wc) => {
                match (wc.callee) {
                    ast.ExprFieldAccess(wfa) => {
                        var self_recv: boolean = false;
                        match (wfa.obj) {
                            ast.ExprIdent(wid) => { self_recv = wid.name == a.target; },
                            _ => {}
                        }
                        if (self_recv && wfa.field == "with" && wc.args.len() == 2) {
                            // ALIASED target (#3599): `a` has a lasting local
                            // alias (`var b = a`, `H { xs: a }`, …), so an
                            // in-place arr_set would mutate the buffer the
                            // alias still reads. Lower as a value-producing
                            // CLONE (lower_arr_with_value: copy then arr_set
                            // into the sole-owned clone) and store it back —
                            // the aliased buffer is left untouched. Sole-owner
                            // (unaliased) slots keep the in-place arr_set below.
                            if (s.is_aliased_name(a.target) || s.is_borrowed_name(a.target)) {
                                var wcl: LowerState = lower_arr_with_value(wfa.obj, wc.args[0], wc.args[1], s);
                                if (!wcl.ok) { return wcl; }
                                return emit_arr_store(wcl, slot, false, false);
                            }
                            // A reclaimable string[] (#6407): the slot owns
                            // every element box, so overwriting one must
                            // release it — the bare arr_set below drops the old
                            // pointer on the floor, and the exit sweep's
                            // element walk then never sees it. The stored value
                            // takes a reference of its own unless it is a fresh
                            // temp this frame already owns, so `a.with(3, a[5])`
                            // leaves both slots counted rather than two slots
                            // sharing one reference for the walk to free twice.
                            if (slot_is_reclaimable_strarr(s, slot)) {
                                return lower_strarr_with_store(wc.args[0], wc.args[1], slot, s);
                            }
                            // A reclaimable (<struct-with-rc-field>)[]: the same
                            // superseded-element problem one element kind over, and
                            // the element's release is a field walk plus a box dec
                            // rather than one free helper.
                            if (slot_is_reclaimable_arrstruct(s, slot)) {
                                var awsty: string = s.struct_type_of_slot(slot);
                                if (awsty.len() > 0) {
                                    return emit_arrstruct_with_store(wc.args[0], wc.args[1], slot, awsty, s);
                                }
                            }
                            var ws: LowerState = s.emit(ir.op_load_local(slot));
                            ws = lower_expr(wc.args[0], ws);
                            if (!ws.ok) { return ws; }
                            // i64[] / u64[]: 8-byte element store (u64 rides
                            // the i64 width; the raw store is signedness-
                            // agnostic). arr_set is 8-byte-slot on the register
                            // backends and arr_set_i64 picks i64.store on wasm.
                            if (s.is_i64arr_slot(slot) || (s.is_arr_slot(slot) && s.is_u64_slot(slot))) {
                                ws = lower_i64(wc.args[1], ws);
                                if (!ws.ok) { return ws; }
                                return ws.emit(ir.op_arr_set_i64());
                            }
                            if (s.is_f64arr_slot(slot)) {
                                ws = lower_expr(wc.args[1], ws);
                                if (!ws.ok) { return ws; }
                                return ws.emit(ir.op_arr_set(64));
                            }
                            ws = lower_expr(wc.args[1], ws);
                            if (!ws.ok) { return ws; }
                            return ws.emit(ir.op_arr_set(32));
                        }
                        if (self_recv && wfa.field == "append" && wc.args.len() == 1) {
                            // f64[] (8-byte float element): lower the value as an
                            // f64 expression and grow via the 8-byte arr_push_f64.
                            // Parallels the i64[] path below; on the register
                            // backends both reuse __fern_arr_push, wasm uses its
                            // f64-typed $__fern_arr_push_f64.
                            if (s.is_f64arr_slot(slot)) {
                                var apf: LowerState = s.emit(ir.op_load_local(slot));
                                apf = lower_expr(wc.args[0], apf);
                                if (!apf.ok) { return apf; }
                                apf = apf.emit(ir.op_arr_push_f64());
                                return emit_arr_store(apf, slot, false, false);
                            }
                            // i64[] / u64[] (8-byte element): lower the value as
                            // an i64 and grow via the 8-byte arr_push_i64. u64
                            // rides the i64 width here — its unsigned-ness only
                            // matters at scalar ops, not the raw 8-byte store.
                            if (s.is_i64arr_slot(slot) || (s.is_arr_slot(slot) && s.is_u64_slot(slot))) {
                                var ap8: LowerState = s.emit(ir.op_load_local(slot));
                                ap8 = lower_i64(wc.args[0], ap8);
                                if (!ap8.ok) { return ap8; }
                                ap8 = ap8.emit(ir.op_arr_push_i64());
                                return emit_arr_store(ap8, slot, false, false);
                            }
                            var aps: LowerState = s.emit(ir.op_load_local(slot));
                            // A bare named-fn VALUE appended to a plain-fn-
                            // pointer array (is_fnarr, NOT a closure array) is
                            // a fn POINTER, not a `const`-style call: emit
                            // const_func, mirroring the fn[]-literal element
                            // lowering. Without it the bare 0-arg fn name
                            // const-CALLS and the pushed integer segfaults when
                            // `fns[i]()` calls it as a code pointer. A lambda /
                            // closure value is not a bare top-level ident, so it
                            // stays on lower_expr (and marks closurearr below);
                            // the !is_closurearr guard keeps a pathological mixed
                            // append off this path. (#3574)
                            var apfvn: string = fn_value_arg_name(wc.args[0], s);
                            if (apfvn != "" && s.is_fnarr_slot(slot) && !s.is_closurearr_slot(slot)) {
                                aps = aps.emit(ir.op_const_func(0, apfvn));
                            } else {
                                aps = lower_expr(wc.args[0], aps);
                                if (!aps.ok) { return aps; }
                            }
                            // #4702: a bare OWNED pointer-array ELEMENT
                            // (`out.append(grp)`, grp an `i32[]` local) ESCAPES
                            // into the container — arr_push[_owned] stores its
                            // buffer pointer with no counted reference, so grp's
                            // loop-rebind reinit-drop (emit_arr_store's cow-guarded
                            // dec) / exit sweep would free a buffer `out` still
                            // holds, and the next `var grp = []` reuses it — every
                            // appended group then aliases the last. Retain it here
                            // (the same Perceus dup the struct-field construction
                            // applies to a bare array-ident field, #3292/4579): the
                            // container now holds a counted reference, so grp's dec
                            // just returns it (rc 2→1, out keeps 1), never frees it
                            // early. A borrowed param simply leaks (never over-
                            // frees); a fresh literal / call element is not an ident,
                            // so it is not inc'd. The inc is on a real rc-headered
                            // array box (is_arr_slot), never a header-less string.
                            match (wc.args[0]) {
                                ast.ExprIdent(apel) => {
                                    var apelslot: i32 = s.slot_of(apel.name);
                                    if (apelslot >= 0 && s.is_arr_slot(apelslot)) {
                                        aps = aps.retain(apelslot, "append-owned-arg");
                                    }
                                    // The enum-field alias routed through a local
                                    // (#6121) — same escape, same dup as the direct
                                    // `xs.append(nxt.node)` read below.
                                    else if (apelslot >= 0 && s.is_enum_field_alias(apel.name)) {
                                        aps = aps.retain(apelslot, "append-enum-alias-arg");
                                    }
                                    // A SCENUMS-credited scalar-enum local appended:
                                    // the plan's counted-sink forgiveness grants the
                                    // rebind/sweep release for a container-stored
                                    // enum, so the store must hold a counted
                                    // reference or the rebind frees a box the array
                                    // still reads (#6127's hazard, re-armed by the
                                    // step-2 routing). Gated on the slot's CREDIT,
                                    // never its type — retain and release stay
                                    // co-extensive in both switch positions.
                                    else if (apelslot >= 0 && slot_credit_at(s, apelslot, "SCENUMS:")) {
                                        aps = aps.retain(apelslot, "append-scenum-arg");
                                    }
                                    // A bare struct ident appended to a container whose
                                    // ELEMENT WALK is credited. The walk decs every
                                    // element once and deep-drops its fields under
                                    // __fern_rc_is_unique, so a source that outlives the
                                    // push needs the container to hold a count of its
                                    // own. "APOWNED:" is stamped by the same pass that
                                    // grants the walk, which is what keeps the inc and
                                    // the dec the same set of sites.
                                    //
                                    // At the source's LAST USE the push TRANSFERS that
                                    // reference instead: no inc, and the source's own
                                    // release is elided with it, so the walk is the one
                                    // release. The stamp says who OWNS the element; the
                                    // move analysis says whether this store had to pay
                                    // for it.
                                    else if (apelslot >= 0
                                        && reclaim_has(s.reclaimable_names, "APOWNED:",
                                            util.i32_to_string(apel.line) + ":" + util.i32_to_string(apel.col))) {
                                        if (s.moves_local_at(apel.name, apel.line, apel.col)) { aps = aps.note_moved_elided(apelslot); }
                                        else { aps = aps.retain(apelslot, "append-arrstruct-elem"); }
                                    }
                                    // A string ELEMENT of a caller-owned array, routed
                                    // through a local: the caller's deep free is the
                                    // element's release, so this store is a second owner.
                                    else if (apelslot >= 0 && s.is_str_caller_elem_slot(apelslot)) {
                                        aps = aps.retain(apelslot, "append-param-str-elem");
                                    }
                                },
                                // A DIRECT ENUM field read (`branches.append(nxt.node)`)
                                // escapes the same way, against the k_enum dec of the
                                // source struct's __struct_drop_<T> (#6049). The inc is
                                // emitted INLINE on the value already on the operand
                                // stack (__fern_rc_inc returns its arg), so no reload.
                                _ => {
                                    if (enum_field_read_type(wc.args[0], aps) != "") {
                                        aps = aps.retain_tos("append-enum-field");
                                    }
                                    // `xs.append(p[i])` over a string[] PARAMETER: the
                                    // element belongs to the caller's array (see
                                    // str_param_elem_escapes).
                                    else if (str_param_elem_escapes(wc.args[0], aps)) {
                                        aps = aps.retain_tos("append-param-str-elem");
                                    }
                                }
                            }
                            // Sole-owner (unaliased) `a = a.append(v)`: the old
                            // buffer has no surviving reference, so on a grow-
                            // realloc reclaim it (arr_push_owned) instead of
                            // leaking — the dominant per-module self-compile leak
                            // (#3452 / #3425). An ALIASED target keeps the plain
                            // arr_push (leaky but sound), mirroring the `.with`
                            // aliased gate above (#3599).
                            //
                            // A PARAM target is never a sole owner (#3457): its
                            // buffer belongs to the CALLER, which sweeps it at its
                            // own exit, so reclaiming it here is a double free.
                            // `is_aliased_name` only sees aliases created INSIDE
                            // this function, so it cannot catch the caller's
                            // reference — hence the explicit slot < n_params gate.
                            // Found via `slice_escape_diags`/`e065_diags`, which
                            // pass a fresh `string[]` local into a walker that does
                            // `xs = xs.append(name)`: the walker reclaimed the
                            // caller's buffer, the caller's exit sweep dec'd the
                            // freed block, and the recycled 16-byte block was
                            // handed to the next `__fern_str_box` — so the "E063" /
                            // "E065" diagnostic code boxes came back with a data
                            // pointer one byte low (" E06" / ")E06"). Only the
                            // FIRST append can see the caller's buffer, but that is
                            // not statically knowable, so the whole reassign takes
                            // the plain push; the store below frees the superseded
                            // buffer once the param's ownership flag says this
                            // frame owns it (emit_consumed_param_store).
                            if (s.is_aliased_name(a.target) || slot < s.n_params) {
                                aps = aps.emit(ir.op_arr_push());
                            } else {
                                aps = aps.emit(ir.op_arr_push_owned());
                            }
                            aps = emit_arr_store(aps, slot, false, false);
                            // If the appended value is a closure BOX — a
                            // `__mkclo$…` env-box marker (capturing `$clo` or
                            // wrapped no-capture `$wrap`), a closure-returning
                            // call, or a closure local — mark the slot a
                            // closure array so a later `fns[i]()` dispatches
                            // env-first. An EMPTY `(() => T)[] = []` can't be
                            // inferred a closure array at its decl (no elements
                            // to read), so the FIRST closure append is where it
                            // is discovered (#3556). The element STORE is the
                            // same `arr_push` either way (the box is a pointer);
                            // only the call dispatch depends on this flag. A bare
                            // named-fn value (an Ident, not a `__mkclo$` box) was
                            // already lowered as a plain fn pointer (const_func)
                            // above when the slot is is_fnarr, so it dispatches
                            // via plain call_indirect — not marked closurearr.
                            var ap_clo: boolean = false;
                            match (wc.args[0]) {
                                ast.ExprCall(apc) => {
                                    match (apc.callee) {
                                        ast.ExprIdent(apcid) => {
                                            if (apcid.name.len() > 8 && slice_unchecked(apcid.name, 0, 8) == "__mkclo$") { ap_clo = true; }
                                            if (util.index_of_str(s.sigs.closure_fns, apcid.name) >= 0) { ap_clo = true; }
                                        },
                                        _ => {}
                                    }
                                },
                                ast.ExprIdent(apid) => { if (s.is_closure_local(apid.name)) { ap_clo = true; } },
                                _ => {}
                            }
                            if (ap_clo) { aps = aps.mark_closurearr(slot, true); }
                            return aps;
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    // ALIASED map self-reassign `m = m.insert(k, v)` / `m = m.set(k, v)`
    // (#3633): the builtin op_map_set mutates the map's keys[]/values[] in
    // place, which is unsound when `m` has a live alias (`var n = m`) — `n`
    // would observe the change. Clone-on-write: build a fresh copy of the
    // map, mutate the sole-owned clone, then bind it back. A store no alias
    // can be live at (map_clone_sites, #7235) falls through to the in-place
    // op_map_set on the generic insert path below. The array sibling is the
    // .with handler above (#3599).
    if (is_map_type_name(s.map_type_of(slot)) && util.index_of_str(s.map_clone_sites, reclaim_site_key_of(a.target, a.line, a.col)) >= 0) {
        match (a.value) {
            ast.ExprCall(mic) => {
                match (mic.callee) {
                    ast.ExprFieldAccess(mifa) => {
                        var mi_self: boolean = false;
                        match (mifa.obj) {
                            ast.ExprIdent(miid) => { mi_self = miid.name == a.target; },
                            _ => {}
                        }
                        if (mi_self && (mifa.field == "insert" || mifa.field == "set") && mic.args.len() == 2) {
                            return lower_map_clone_insert(a.target, mifa.obj, mic.args[0], mic.args[1], s.map_type_of(slot), s);
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    // i64 reassignment: lower the value as an i64 and store. (i64 locals
    // aren't rc-tracked, so no alias-inc / old-value release.) Storing an
    // i64 value into a non-i64 slot would be a width mismatch — bail.
    if (s.is_i64_slot(slot)) {
        var iva: LowerState = lower_i64(a.value, s);
        if (!iva.ok) { return iva; }
        return iva.emit(ir.op_store_local(slot));
    }
    if (infer_expr_width(a.value, s) == 64) { return s.fail(); }
    // Assigning a SCALAR-element array struct field (`x = h.items`) aliases
    // it: `x` becomes a second owner of the field's buffer. Lower via the IR
    // (RC-frontier slice 2) through the generic reassignment path below —
    // set reassign_inc so the new field read is retained (Perceus dup), and
    // emit_arr_store's cow-guarded do_dec releases the OLD array `x` held
    // first (the assign analogue of the bind case). Balance: dec-old frees
    // x's prior buffer; inc-new counts the field's array for x; the struct's
    // own field-drop + the exit-sweep then each dec it. Sound (the dec-old +
    // inc-new never under-free). Only the scalar-element field; array-of-
    // struct / array-of-enum fields still bail (deep-drop is a later slice).
    // Assigning an ARRAY-OF-STRUCT field (`x = h.params`) aliases it like
    // the scalar case: the Perceus dup is on the buffer POINTER (element-
    // type-agnostic) and emit_arr_store's cow-guarded do_dec releases the
    // OLD array x held first. No deep-drop recursion for the bind — the
    // source struct keeps owning the elements; the dec-old shallow-frees
    // only x's prior buffer (leaking its old elements, the safe-leak
    // invariant), never under-freeing a shared buffer (cow-guarded).
    var afft: string = scalar_arr_field_type(a.value, s);
    var asaft: string = struct_arr_field_read_type(a.value, s);
    if (asaft == "") { asaft = enum_arr_field_read_type(a.value, s); }   // array-of-enum field too
    if (afft == "" && asaft == "" && is_scalar_arr_field_access(a.value, s)) { return s.fail(); }
    // Perceus reassignment `y = x`: retain the new ref if it aliases an
    // rc-tracked array, and release the OLD value the slot held
    // (cow-guarded). A reassigned BORROWED array param (slot <
    // n_params) must NOT release its old value — the caller owns it.
    var reassign_inc: boolean = false;
    match (a.value) {
        ast.ExprIdent(id) => {
            if (s.is_arr_slot(s.slot_of(id.name))) { reassign_inc = true; }
        },
        // `x = h.items` / `x = h.params` / `x = h.args` — the field read is
        // an rc-tracked array (scalar, array-of-struct, OR array-of-enum);
        // the new owner `x` retains it (the dup), mirroring the ident alias.
        ast.ExprFieldAccess(_) => {
            if (afft != "" || asaft != "") { reassign_inc = true; }
        },
        _ => {}
    }
    // Container-READ alias on REASSIGN (#3457) — the assign sibling of the
    // bind-side retain in lower_stmt_var. `xs = h.names` over a `string[]`
    // field (neither scalar_arr_field_type nor struct/enum_arr_field_read_type
    // claims it), `xs = t.0` (tuple element), and `xs = g[i]` (array-of-array
    // element) each make the slot a second reference to a buffer the container
    // still points at. The slot is swept at function exit, so without the
    // Perceus dup that dec frees the container's buffer. A borrowed source
    // leaks one count (sound), never over-frees. An "ENVCAP:" capture extract
    // is excluded for the same reason as the bind: the sweep skips it as a
    // borrow, so a retain would leak.
    if (!reassign_inc && s.is_arr_slot(slot) && (slot >= s.n_params || s.ownflag_slot_of(slot) >= 0)
            && !reclaim_has(s.reclaimable_names, "ENVCAP:", s.reclaim_site_key(slot))) {
        match (a.value) {
            ast.ExprFieldAccess(_) => { reassign_inc = true; },
            ast.ExprIndex(_) => { reassign_inc = true; },
            _ => {}
        }
    }
    // A reclaimable REASSIGNED array-payload ENUM local (`b = V([..])`, ENUMRE)
    // whose enum has UNIFORM variant layout: reuse b's existing box IN PLACE —
    // release the old payload arrays, re-shape to V, write V's fresh payloads into
    // the SAME box (emit_enum_inplace_reassign) — the native-parity FBIP form that
    // avoids the free+alloc churn. Must run BEFORE the RHS is lowered: lowering
    // `V([..])` would allocate a fresh box, defeating the reuse. A ragged enum
    // (differing variant box sizes) or any non-`V(args)` RHS falls through to the
    // free+alloc emit_enum_reclaim_store below (still leak-free).
    // Gated with the reuse layer (#4350 §6.5): native's
    // tryEnumReuseOverwrite sits behind RcReuseEnabled the same way;
    // reuse-off falls through to emit_enum_reclaim_store's free+alloc
    // (still leak-free), trading only the churn.
    var ere_ip: string = slot_enum_reassign_reclaim(s, slot);
    if (ere_ip.len() > 0 && enum_all_variants_same_field_count(s.structs, ere_ip) && !reuse_layer_disabled()) {
        var ip: LowerState = emit_enum_inplace_reassign(a.value, slot, ere_ip, s);
        if (ip.ok) { return ip; }
    }
    // Whole-literal REBIND of a fn-POINTER array local (#3457):
    // `var a: (() => i32)[] = [seven]; a = [nine]; a[0]()` SIGSEGV'd. A bare fn
    // NAME reached the generic expression path, which const-CALLS it and stores
    // the RESULT — so the buffer held integers where code addresses belong, and
    // the plain `call_indirect` the is_fnarr slot dispatches through jumped to 9.
    // Emit const_func per element, exactly as the DECLARATION and the `.append`
    // path already do; this is the third construction site for the same array and
    // the only one that was missing it.
    //
    // Representation-preserving on purpose: the slot is already is_fnarr and stays
    // so, which is what makes this safe inside a branch or a loop body. A rebind
    // that CHANGES the representation (`[seven]` <-> `[() => n]` in either
    // direction) is a separate, still-open defect — the slot's flag is set at the
    // declaration and the lowering here cannot tell whether the assignment
    // dominates the reads. See docs/SELFHOST-AST-RETIREMENT.md.
    if (s.is_fnarr_slot(slot) && !s.is_closurearr_slot(slot) && slot >= s.n_params) {
        match (a.value) {
            ast.ExprArray(fra) => {
                var fr_allfn: boolean = fra.elements.len() > 0;
                var fri: i32 = 0;
                while (fri < fra.elements.len()) {
                    if (fn_value_arg_name(fra.elements[fri], s) == "") { fr_allfn = false; }
                    fri = fri + 1;
                }
                if (fr_allfn) {
                    var frs: LowerState = s;
                    var frj: i32 = 0;
                    while (frj < fra.elements.len()) {
                        frs = frs.emit(ir.op_const_func(0, fn_value_arg_name(fra.elements[frj], s)));
                        frj = frj + 1;
                    }
                    frs = frs.emit(ir.op_arr_make(fra.elements.len(), 32));
                    return emit_arr_store(frs, slot, false, true);
                }
            },
            _ => {}
        }
    }
    var target_is_arr: boolean = s.is_arr_slot(slot) && slot >= s.n_params;
    var aas: LowerState = s;
    // Mark a struct-literal self-rebind (`o = S { … }`) for the duration of the
    // RHS, so its override path can drop the retain on a field aliased off `o`
    // (#6653). Only a DIRECT literal — anything else (a call, an if-expression)
    // does not hand this slot the box it built.
    //
    // A DIRECT variant constructor (`acc = Cons(1, acc)`) hands it the box just
    // as a literal does, so it is marked the same way — there the payload that
    // names this slot is a move, not a second owner (ctor_selfrebind_payload).
    match (a.value) {
        ast.ExprStructLit(_) => { aas = aas.with_selfrebind(a.target); },
        ast.ExprCall(sbc) => {
            match (sbc.callee) {
                ast.ExprIdent(sbid) => {
                    if (decl_is_struct(s.structs, sbid.name)) { aas = aas.with_selfrebind(a.target); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    var se: LowerState = lower_expr(a.value, aas);
    se = se.with_selfrebind("");
    if (!se.ok) { return se; }
    // The COUNTED struct alias reassign (`keep = p`) retains HERE rather than via
    // emit_arr_store's alias_inc, because the struct classes return earlier —
    // emit_field_reclaim_store and the snapshot/deep paths take no alias_inc
    // parameter at all. Emitting it on the operand stack right after the RHS is
    // lowered is the one point every return path passes through, so the credit
    // this retain pays for can never be granted without it. (__fern_rc_inc returns
    // its argument, so the value stays on the stack.) The ARRAY path is untouched
    // and still takes its retain inside emit_arr_store.
    var alias_reassign_inc: boolean = false;
    match (a.value) {
        ast.ExprIdent(aid2) => {
            if (!s.is_arr_slot(s.slot_of(aid2.name))
                    && reclaim_has(s.reclaimable_names, "ALIASSRC:", s.reclaim_site_key(s.slot_of(aid2.name)))) {
                alias_reassign_inc = true;
            }
        },
        _ => {}
    }
    // The STRING alias reassign takes the same hoisted retain, and for the same
    // reason: emit_str_reclaim_store returns before emit_arr_store is reached and
    // takes no alias_inc, so routing it there would drop the retain while the
    // credit is still granted.
    if (!alias_reassign_inc) {
        match (a.value) {
            ast.ExprIdent(sid3) => {
                if (!s.is_arr_slot(s.slot_of(sid3.name))
                        && reclaim_has(s.reclaimable_names, "STRALIASSRC:", s.reclaim_site_key(s.slot_of(sid3.name)))) {
                    alias_reassign_inc = true;
                }
            },
            _ => {}
        }
    }
    if (alias_reassign_inc) { se = se.emit(ir.op_call_direct("__fern_rc_inc", 1)); }
    // A reclaimable REASSIGNED array-payload ENUM local (`b = V([..])`, credited
    // "ENUMRE:<E>"): DEEP-DROP the superseded box (payload arrays + box) before
    // storing the fresh one — closes the register-backend per-reassign payload leak
    // (a rc-guarded no-op on wasm, which already reclaims). Sound only because b's
    // payload is never aliased (enum_only_wildcard_used_rec gate).
    var ere_enum: string = slot_enum_reassign_reclaim(s, slot);
    if (ere_enum.len() > 0) { return emit_enum_reclaim_store(se, slot, ere_enum); }
    // A reclaimable string-builder ACCUMULATOR reassign (`s = s + part`):
    // free the SUPERSEDED box via __fern_str_free (box + data buffer),
    // cow-guarded, then store the fresh value — the string sibling of the
    // struct consume-rebind below. The RHS was lowered ABOVE (it borrow-read
    // the old s to build the fresh result), so freeing old s now is sound.
    // No rc-word inc (header-less asm box); heap-base-guarded so the initial
    // "" literal's .rodata data is skipped. Closes the O(n) accumulator leak.
    // No alias_inc: a consume-rebind REPLACES the slot's value with a fresh box
    // rather than sharing an existing one, so there is no second reference to
    // count. The alias bind is a `var`, and takes the flag at the site above.
    if (slot_is_reclaimable_str(s, slot)) { return emit_str_reclaim_store(se, slot, false); }
    // A reclaimable REBOUND string[] (`xs = [mk("y"), mk("z")]` / `xs = mkarr(i)`,
    // credited "SARR:"): free the superseded buffer AND its element boxes before
    // storing. Without this branch the rebind fell through to emit_arr_store's
    // SHALLOW arr_dec, which drops the element pointers on the floor — the same
    // gap the rc-tuple and rc-enum rebinds below were opened for, one element
    // kind over. The `var` re-declaration has driven the deep helper all along;
    // only the assign path was missing.
    //
    // The self-`append` / self-`.with` rebinds do not reach here — they are
    // lowered above as in-place element stores — so the cow guard inside the
    // helper is a backstop rather than the mechanism that keeps them safe.
    // No alias_inc, for the reason the string case one line up gives: a rebuild
    // replaces the slot's value rather than sharing one. No `target_is_arr`
    // exclusion either: the target IS an array here, which is what makes this
    // the branch the array classes below could not cover.
    if (slot_is_reclaimable_strarr(s, slot)) { return emit_strarr_reclaim_store(se, slot, false); }
    // A reclaimable REBOUND Option (`o = Some(..)`, credited "OPTARR:" /
    // "OPTARRARR:" / "OPTSTRUCT:" / "OPTTUP:"): free the superseded payload + option
    // box before storing the fresh one, at the depth that payload kind needs. This
    // is the ASSIGN path — before #6127 the whole family reclaimed only at a `var`
    // re-declaration, so an `o = Some(..)` rebind leaked every prior box. The RHS
    // was lowered above and never aliases the old box: each rebind is a fresh
    // literal (opt_rebinds_all_fresh), which is what the credits require.
    if (slot_is_reclaimable_optarr(s, slot)) { return emit_optarr_reclaim_store(se, slot); }
    if (slot_is_reclaimable_optstr(s, slot)) { return emit_optstr_reclaim_store(se, slot); }
    if (slot_is_reclaimable_optopt_rc(s, slot)) { return emit_optopt_rc_deep_free(se, slot, nested_opt_inner_freefn(opttup_inner_type(s.locals[slot].opt_type) + "")); }
    // The superseded box of a match-consumed, reassigned nested Option (#7716).
    // A scalar inner owns no pointer, so one guarded flat dec is its whole
    // release — emit_optarr_deep_free's shape, which the exit sweep does not
    // reach here because the match drop zeroes the slot.
    if (slot_is_reclaimable_optopt_rebind(s, slot)) { return emit_optarr_reclaim_store(se, slot); }
    if (slot_is_reclaimable_optarrarr(s, slot)) { return emit_optarrarr_reclaim_store(se, slot); }
    if (slot_is_reclaimable_optstruct(s, slot)) {
        return emit_optstruct_reclaim_store(se, slot, opt_payload_type(s.locals[slot].opt_type, "Some"));
    }
    if (slot_is_reclaimable_opttup(s, slot)) {
        return emit_opttup_reclaim_store(se, slot, opttup_inner_type(s.locals[slot].opt_type));
    }
    // A reclaimable struct REASSIGN (`s = bump(s)` / `s = s.emit(op)`, the
    // builder consume-rebind) releases the OLD box the same way the StmtVar
    // branch does: emit_arr_store's cow-guarded, rc-guarded SHALLOW arr_dec
    // frees the previous box (box-only, so a builder's shared field
    // pointers are untouched and freed once at the final box's death). The
    // fresh call result never aliases the old box (cow guard skips an
    // identity return), so this reclaims the per-iteration builder leak
    // (#3456 — escaping-struct reclaim). reassign_inc stays false for a
    // call result (already owned).
    // A SNAPSHOT struct PARAM reassign (the builder `s = s.write(x)`,
    // #3456 slice 2) frees the old box via the snapshot-guarded shallow
    // free — never the caller's original (the entry snapshot). When the
    // struct has rc-tracked ARRAY fields (#3457 field-level move tracking),
    // route to the per-type __field_reclaim_<T> helper instead, which also
    // frees the REPLACED field buffers (the dominant clone-form leak —
    // `LowerState { ops: s.ops.append(op), … }`) before freeing the box,
    // guarded so neither the new value nor the caller's snapshot is freed.
    // An ARRAY slot records its ELEMENT type in struct_type_of_slot, so `snty`
    // there names a struct the slot does NOT hold: __field_reclaim_<T> would
    // read a BUFFER at struct-field offsets and release whatever lies past its
    // end. A struct-array param's buffer is released by emit_snapshot_store.
    if (slot_is_snapshot_param(s, slot)) {
        var snsl: i32 = s.slot_of(snapshot_slot_name(slot));
        var snty: string = s.struct_type_of_slot(slot);
        if (!s.is_arr_slot(slot) && s.struct_routes_field_reclaim(snty)) {
            return emit_field_reclaim_store(se, slot, snty, snsl);
        }
        return emit_snapshot_store(se, slot, snsl);
    }
    // A reclaimable struct LOCAL consume-rebind (`c = bump(c)`) with
    // rc-tracked ARRAY fields — or STRFLDOK-admitted string fields (#4355
    // slice 3) — likewise routes to __field_reclaim_<T> (snap = 0 — no
    // caller's original to protect), freeing the old box's replaced fields
    // before the box. A scalar-only reclaimable struct keeps the plain box
    // free via emit_arr_store's do_dec.
    var asty: string = s.struct_type_of_slot(slot);
    // A snapshot LOCAL: a struct local whose binding recorded the box it was
    // derived from (seed_snapshot_local). Its rebind releases the superseded
    // box's replaced fields under the snapshot guard a snapshot PARAM gets, so a
    // field still carried from that source box is never freed from under it —
    // a fresh-ret local bound from a borrowed param is exactly that shape, and
    // the alias `var sc: T = s` threaded through consume-rebinds has no other
    // credit. "NOFLD:" keeps the release box-only where a value derived from the
    // local was bound elsewhere and may outlive the rebind.
    var snls: i32 = 0 - 1;
    if (!target_is_arr && slot >= s.n_params && asty.len() > 0) { snls = s.slot_of(snapshot_slot_name(slot)); }
    var nofld: boolean = reclaim_has(s.reclaimable_names, "NOFLD:", s.reclaim_site_key(slot));
    if (snls >= 0 && !slot_is_reclaimable_struct(s, slot)) {
        if (!nofld && s.struct_routes_field_reclaim(asty)) { return emit_field_reclaim_store(se, slot, asty, snls); }
        return emit_snapshot_store(se, slot, snls);
    }
    if (!target_is_arr && slot_is_reclaimable_struct(s, slot) && !nofld && s.struct_routes_field_reclaim(asty)) {
        return emit_field_reclaim_store(se, slot, asty, snls);
    }
    // A reclaimable rc-TUPLE local REBIND (`p = (i, "hi")` / `p = (i, [i, i+1])`,
    // #6127): deep-drop the superseded chain — the fresh rc children then the box —
    // before storing. This is the ASSIGN sibling of the StmtVar re-declaration path,
    // which has driven emit_tuple_deep_reinit_store all along; the assign path had
    // no branch for the class at all, so a rebound rc-tuple fell through to
    // emit_arr_store's shallow store and freed NOTHING (allocs=1000 frees=0 over 100
    // rounds). The drop is driven by the NEW literal's shape, which describes the
    // old box because the credit now requires every assignment to rebuild the same
    // fresh rc-tuple type (all_assigns_fresh_rc_tuple).
    match (a.value) {
        ast.ExprTuple(atl) => {
            if (slot_is_reclaimable_rctuple(s, slot)) {
                return emit_tuple_deep_reinit_store(se, slot, atl);
            }
        },
        _ => {}
    }
    // A reclaimable rc-payload ENUM local REBIND (`e = Text("hi")`, #6127): deep-drop
    // the prior chain (payload + box) before storing, the same release the re-declared
    // loop-local gets on the StmtVar path above. Without this the assign fell through
    // to emit_arr_store's SHALLOW box dec, which for an rc-payload enum would leak the
    // payload even once the credit was granted.
    if (slot_is_reclaimable_rcenum(s, slot)) {
        return emit_enum_deep_reinit_store(se, slot, s.struct_type_of_slot(slot));
    }
    // The same release on the REBIND path (`m = B(i)`), for the same reason the
    // rc half needs one: without it the assign fell through to a store with no
    // dec and every superseded box leaked.
    if (slot_is_reclaimable_scenum(s, slot)) {
        return emit_arr_store(se, slot, reassign_inc, true);
    }
    // A "TUP:" tuple rebind whose box RETAINED bare-ident ARRAY or STRING
    // elements (#7226): give those retains back with the superseded box, via the
    // same emit_tup_elem_reclaim_store the StmtVar re-declaration drives. Without
    // this branch the shallow store below freed the box and stranded every
    // retained element.
    var atek: string = s.tup_elem_kinds_of(slot);
    if (atek.len() > 0 && !reassign_inc && tup_kinds_rebind_safe(atek)
        && slot_is_reclaimable_tuple_rebind(s, slot)) {
        return emit_tup_elem_reclaim_store(se, slot, atek);
    }
    // A reclaimable SCALAR-TUPLE rebind (`p = (i, i + 1)`, credited "TUPREBIND:"):
    // release the box this store supersedes. emit_arr_store's do_dec branch is
    // exactly the right release — cow-guarded so a self-store never frees the live
    // box, and a SHALLOW __fern_rc_dec, which is all a scalar tuple needs (no
    // element walk, nothing inside to dangle). Without it "TUP:" freed only the
    // final value at scope exit and every rebind's box leaked (#6127).
    return emit_arr_store_from(se, slot, reassign_inc,
        target_is_arr || slot_is_reclaimable_struct(s, slot) || slot_is_reclaimable_tuple_rebind(s, slot),
        s.is_arr_slot(slot) && rebind_call_same_dec(a.value, a.target, s));
    return s.fail();
}

// for_iter_is_map_local reports whether a foreach iterand is a map LOCAL — the
// one iterable whose destructuring form walks key/value columns rather than
// binding a pattern against each element.
function for_iter_is_map_local(iter: ast.Expr, s: LowerState): boolean {
    match (iter) {
        ast.ExprIdent(mlid) => {
            var mlslot: i32 = s.slot_of(mlid.name);
            return mlslot >= 0 && s.map_type_of(mlslot) != "";
        },
        _ => {}
    }
    return false;
}

// lower_stmt_for: the ast.StmtFor arm of lower_stmt, split out so no single
// function's per-function emit accumulation can exhaust the fixed bump
// arena on the whole-compiler per-module emits (a ~3,000-line lower_stmt
// tripped the exit-137 alloc trap on its own; oversized functions also
// miscompile — cf. #2720). Body moved verbatim; the trailing s.fail()
// preserves lower_stmt's own post-match fallback for any fall-through.
function lower_stmt_for(fr: ast.StmtFor, s: LowerState): LowerState {
    // break / continue inside a for-loop ARE supported (#2788): each
    // counted form below advances its index at the TOP of the loop
    // (after the header) and calls enter_loop/exit_loop, so a `continue`
    // br-to-header re-runs the advance instead of skipping it and a
    // `break` exits the loop's outer block — mirroring the while-loop
    // shape. (Earlier this whole arm bailed any break/continue body,
    // its bottom-increment shape being one `continue` would skip.)
    // Range form `for i in LOW..HIGH` — the parser encodes the
    // half-open interval as a synthetic `__range(LOW, HIGH)` call.
    // lower_range_for emits the counted loop. Kept in its own function
    // so this already-large match arm doesn't grow further (oversized
    // functions miscompile on the native backend — cf. #2720).
    if (for_iter_is_range(fr.iter)) {
        return lower_range_for(fr.var_name, fr.iter, fr.body, s);
    }
    // `for x in <EXPR>` over a non-ident iterable (array literal or a
    // call returning an array): snapshot it into a hidden local, then
    // iterate that local (lower_foreach_snapshot). The bare-ident forms
    // — array foreach and the `for (k, v) in m` map foreach below — read
    // the slot directly, so they stay on their own paths.
    var for_iter_ident: boolean = false;
    match (fr.iter) { ast.ExprIdent(_) => { for_iter_ident = true; }, _ => {} }
    var for_var_comma: boolean = rc_fe_is_destructure(fr.var_name);
    // A destructuring header over anything but a map local binds the pattern
    // against each ELEMENT: bind the element to a hidden local and let the
    // ordinary destructure lowering read it, which is the source spelling
    // `for e in xs { var (a, b) = e; … }` and so reuses every iterable path
    // below (array local, snapshot, string) unchanged. The map form is the
    // one that walks key/value columns instead, so it stays on its own path.
    if (for_var_comma && !for_iter_is_map_local(fr.iter, s)) {
        var fdelem: string = "$fordes" + util.i32_to_string(s.locals.len());
        var fdbind: ast.Stmt = ast.StmtVar { name: fr.var_name, type_name: "",
            init: ast.ExprIdent { name: fdelem, line: fr.line, col: 0, ty: "" },
            line: fr.line, col: 0, is_str: false, fn_ret: "", fn_param_types: "" };
        var fdbody: ast.Stmt[] = [fdbind];
        var fdi: i32 = 0;
        while (fdi < fr.body.len()) { fdbody = fdbody.append(fr.body[fdi]); fdi = fdi + 1; }
        return lower_stmt_for(ast.StmtFor { ...fr, var_name: fdelem, body: fdbody }, s);
    }
    // `for b in STR` over a string iterable: iterate the bytes via a
    // counted loop, not the array layout (#2822). Checked before the
    // snapshot / array-ident paths, which both assume an array.
    if (!for_var_comma && expr_is_str(fr.iter, s)) {
        return lower_string_foreach(fr.var_name, fr.iter, fr.body, s);
    }
    // `for k in m.keys()` / `for v in m.values()` over a map LOCAL —
    // single-var map iteration. The hidden column local is NOT array-marked
    // (the exit-sweep never decs it) and the arr_len / arr_get are emitted
    // explicitly — exactly as the 2-var `for k, v in m` form below does.
    // Checked before the generic lower_foreach_snapshot, which would
    // (wrongly) treat the result as an OWNED array and free it. Column
    // ownership follows op_map_keys/op_map_values' element flag (#4353):
    // a scalar i32 column (flag 0) is a fresh SNAPSHOT on every backend, so
    // it is explicitly released (__fern_rc_dec) right after the loop — flat,
    // and a body that mutates the map iterates the entry-time snapshot
    // (matching native) instead of a buffer the map may grow-free from under
    // it. A string/other column (flag 1) stays a register-backend BORROW of
    // the map's internal array (no inc, no post-loop free — slice 3).
    // `mki_method` is "" unless fr.iter is a keys()/values() call on a map
    // local.
    if (!for_var_comma) {
        var mki_method: string = "";
        var mki_mtype: string = "";
        var mki_recv: ast.Expr = parser.e_unknown("");
        match (fr.iter) {
            ast.ExprCall(mkic) => {
                if (mkic.args.len() == 0) {
                    match (mkic.callee) {
                        ast.ExprFieldAccess(mkifa) => {
                            if (mkifa.field == "keys" || mkifa.field == "values") {
                                match (mkifa.obj) {
                                    // A map LOCAL (`for k in m.keys()`).
                                    ast.ExprIdent(mkid) => {
                                        var mkimt0: string = s.map_type_of(s.slot_of(mkid.name));
                                        if (mkimt0 != "") { mki_method = mkifa.field; mki_mtype = mkimt0; mki_recv = mkifa.obj; }
                                    },
                                    // A Map-typed struct FIELD (`for k in c.m.keys()`):
                                    // resolve the map type from the field decl, like
                                    // the map-method dispatch. #map-struct-field-iter.
                                    ast.ExprFieldAccess(mkffa) => {
                                        if (!util.is_all_digits(mkffa.field)) {
                                            var mkoty: string = expr_struct_type(mkffa.obj, s);
                                            if (mkoty != "") {
                                                var mkft: string = decl_field_type(s.structs, mkoty, mkffa.field);
                                                if (is_map_type_name(mkft)) { mki_method = mkifa.field; mki_mtype = mkft; mki_recv = mkifa.obj; }
                                            }
                                        }
                                    },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                }
            },
            _ => {}
        }
        if (mki_method != "") {
            var mkimty: string = mki_mtype;
            // element type tag: keys -> key kind; values -> value type.
            var mki_elem_str: boolean = false;
            if (mki_method == "keys") { if (map_key_kind_of(mkimty) == 0) { mki_elem_str = true; } }
            else { if (map_value_of(mkimty) == "string") { mki_elem_str = true; } }
            // snapshot keys()/values() -> hidden borrow local (NOT marked).
            // The map receiver (a local or a struct field) lowers via
            // lower_expr, which pushes the map pointer either way.
            var mkisn: string = "$formk" + util.i32_to_string(s.locals.len());
            var mkf: LowerState = s.add_local(mkisn);
            var mkisslot: i32 = mkf.slot_of(mkisn);
            mkf = lower_expr(mki_recv, mkf);
            if (!mkf.ok) { return mkf; }
            var mki_flag: i32 = map_kv_elem_flag(mkimty, mki_method);
            if (mki_method == "keys") { mkf = mkf.emit(ir.op_map_keys(mki_flag)); }
            else { mkf = mkf.emit(ir.op_map_values(mki_flag, map_value_widekind(map_value_of(mkimty)))); }
            mkf = mkf.emit(ir.op_store_local(mkisslot));
            // hidden index
            var mkidxn: string = "$formki" + util.i32_to_string(mkf.locals.len());
            mkf = mkf.add_local(mkidxn);
            var mkidxslot: i32 = mkf.slot_of(mkidxn);
            mkf = mkf.emit(ir.op_const_i32(0 - 1));
            mkf = mkf.emit(ir.op_store_local(mkidxslot));
            // the single binding (string element marks the slot str; a
            // 64-bit values() element width/sign-marks it — #5253, the
            // single-var twin of the `for k, v in m` value binding)
            var mki_vw: string = "";
            if (mki_method == "values") { mki_vw = map_value_of(mkimty); }
            mkf = mkf.add_local(fr.var_name);
            var mkivslot: i32 = mkf.slot_of(fr.var_name);
            if (mki_elem_str) { mkf = mkf.mark_str(mkivslot, true); }
            else if (mki_vw == "i64") { mkf = mkf.mark_i64(mkivslot, true); }
            else if (mki_vw == "u64") { mkf = mkf.mark_u64(mkivslot, true); }
            else if (mki_vw == "f64") { mkf = mkf.mark_f64(mkivslot, true); }
            // counted loop, advance-at-top so `continue` re-advances.
            mkf = mkf.emit(ir.op_block(0)).enter_loop();
            mkf = mkf.emit(ir.op_loop(0));
            mkf = mkf.emit(ir.op_load_local(mkidxslot));
            mkf = mkf.emit(ir.op_const_i32(1));
            mkf = mkf.emit(ir.op_bin("add", 0, false));
            mkf = mkf.emit(ir.op_store_local(mkidxslot));
            mkf = mkf.emit(ir.op_load_local(mkidxslot));
            mkf = mkf.emit(ir.op_load_local(mkisslot));
            mkf = mkf.emit(ir.op_arr_len());
            mkf = mkf.emit(ir.op_bin("lt_s", 0, false));
            mkf = mkf.emit(ir.op_bin("not", 0, false));
            mkf = mkf.emit(ir.op_brif(1));
            mkf = mkf.emit(ir.op_load_local(mkisslot));
            mkf = mkf.emit(ir.op_load_local(mkidxslot));
            // 64-bit values() column: full 8-byte element read (#5253) —
            // arr_get_i64 for i64/u64, arr_get width 64 (f64.load) for f64.
            // idx < arr_len guard ran above → unchecked reads (#4380 lever 3).
            if (mki_vw == "i64" || mki_vw == "u64") { mkf = mkf.emit(ir.op_arr_get_i64_nc()); }
            else if (mki_vw == "f64") { mkf = mkf.emit(ir.op_arr_get_nc(64)); }
            else { mkf = mkf.emit(ir.op_arr_get_nc(32)); }
            mkf = mkf.emit(ir.op_store_local(mkivslot));
            mkf = lower_block(fr.body, mkf);
            if (!mkf.ok) { return mkf; }
            mkf = mkf.emit(ir.op_br(0));
            mkf = mkf.emit(ir.op_end());
            mkf = mkf.emit(ir.op_end()).exit_loop();
            // Scalar column (flag 0): the hidden local holds a fresh rc=1
            // SNAPSHOT (every backend), released here — `break` exits land
            // after the block end, so they release too; an early `return`
            // inside the body skips it (a bounded, sound leak, like every
            // non-swept hidden temp). Zero the slot afterwards for hygiene.
            if (mki_flag == 0) {
                mkf = mkf.release_zero(mkisslot, "__fern_rc_dec", "map-iter-snapshot");
            }
            // String column (flag 2, #4353 slice 3): the hidden local holds a
            // fresh snapshot whose elements were rc-inc'd on copy, so the
            // release is the DEEP __fern_str_arr_free (rc-aware per-element
            // __fern_str_free — dec each element, free at rc==1 — then the
            // buffer), the exact inverse of __fern_map_snapshot_col_str. Same
            // break/early-return caveats as the scalar arm above.
            if (mki_flag == 2) {
                mkf = mkf.release_zero(mkisslot, "__fern_str_arr_free", "map-iter-snapshot");
            }
            return mkf;
        }
    }
    // `for h in r.hs` over a closure/fn ARRAY field (hs: (() => T)[], spelled
    // "fn[]"): "fn" reads as enum-like, so without this it would take the
    // enum-array field-foreach below and bind h as a struct-typed local — `h()`
    // then bare-calls the box pointer and SIGSEGVs (#5160 defect #2). Route
    // through the snapshot: `var $forit = r.hs` marks the hidden local
    // is_closurearr (the enum-array-field bind arm), so the ident-foreach binds
    // h a closure local (env-first dispatch).
    if (!for_var_comma && field_access_is_closurearr(fr.iter, s)) {
        return lower_foreach_snapshot(fr.var_name, fr.iter, fr.body, s);
    }
    // `for c in r.cells` over a leak-safe array-typed STRUCT FIELD
    // (string[] / struct[] / enum[] — element types that aren't
    // reclaimed). The field access is snapshotted into a hidden BORROW
    // local (NOT array-marked, so the exit-sweep never decs it: the
    // field buffer's lifetime stays with the owning struct, which leaks
    // these element types — emit_struct_field_drops only frees the
    // reclaimable scalar fields — so the borrow can't double-free / UAF).
    // Then a counted loop with explicit arr_len/arr_get + element typing
    // (mirroring the map keys()/values() borrow path). The reclaimed
    // scalar fields (i32[]/boolean[]/f64[]/i64[]) are deliberately NOT
    // handled here — aliasing them needs the reclamation analysis to
    // borrow-track the field, left to the Perceus self-host port (#3003).
    if (!for_var_comma) {
        var fld_elem_kind: i32 = 0;   // 0 none, 1 string[], 2 struct[]/enum[], 3 Option/Result[], 4 tuple[]
        var fld_elem_ty: string = "";
        // The iterable's array-TYPE string, when it is a borrowable array we don't
        // own — either a struct FIELD (`r.cells`) or a leak-only tuple ELEMENT
        // (`t.1` / `r.pair.1`, where the tuple leaks with its owner). Both are
        // leak-only pointer-element arrays iterated read-only, so the same borrow +
        // counted-loop (below) handles them; only the type SOURCE differs.
        var fft: string = "";
        match (fr.iter) {
            ast.ExprFieldAccess(ffa) => {
                // A numeric field is a tuple-element access (`t.N`): resolve the
                // element type from the tuple, not a struct field decl. The tuple
                // is leak-only (never freed), so its array element is a safe borrow.
                if (util.is_all_digits(ffa.field)) {
                    fft = expr_tuple_elem_tag(ffa.obj, util.digits_to_i32(ffa.field), s);
                } else {
                    var foty: string = expr_struct_type(ffa.obj, s);
                    if (foty != "") { fft = decl_field_type(s.structs, foty, ffa.field); }
                }
            },
            _ => {}
        }
        if (fft != "") {
            if (fft == "string[]") { fld_elem_kind = 1; }
            else if (is_struct_array_field_type(s.structs, fft) || is_enum_array_field_type(s.structs, fft)) {
                fld_elem_kind = 2;
                fld_elem_ty = slice_unchecked(fft, 0, fft.len() - 2) + "";
            }
            // An Option/Result-array field (`xs: Option[i32][]`): the element is a
            // leak-only opt box — carry its Option/Result type so `match (o)` in
            // the body recovers the payload (#3054, the field-foreach analog of the
            // Option-array local case).
            else if (fft.len() >= 5 && slice_unchecked(fft, fft.len() - 2, fft.len()) == "[]") {
                var fel: str = slice_unchecked(fft, 0, fft.len() - 2);
                if (fel.len() >= 8 && (slice_unchecked(fel, 0, 7) == "Option[" || slice_unchecked(fel, 0, 7) == "Result[")) {
                    fld_elem_kind = 3;
                    fld_elem_ty = fel + "";
                }
                // A tuple-array field (`pairs: (i32, string)[]`): each element is a
                // tuple box — carry its element tuple type so `p.N` resolves in the
                // loop body. The field-foreach analog of the #5305 local-array case;
                // without it a pointer element (`p.1` of a `(i32, string)`) has no
                // tag, so the body's `p.1.len()` fails to lower and the whole module
                // bails.
                else if (util.is_tuple_type_name(fel)) {
                    fld_elem_kind = 4;
                    fld_elem_ty = fel + "";
                }
            }
        }
        if (fld_elem_kind != 0) {
            // snapshot field access -> hidden borrow local (NOT array-marked)
            var fldsn: string = "$forfld" + util.i32_to_string(s.locals.len());
            var lf: LowerState = s.add_local(fldsn);
            var fldslot: i32 = lf.slot_of(fldsn);
            lf = lower_expr(fr.iter, lf);
            if (!lf.ok) { return lf; }
            lf = lf.emit(ir.op_store_local(fldslot));
            // hidden index (advance-at-top, #2788)
            var fldidxn: string = "$forfldi" + util.i32_to_string(lf.locals.len());
            lf = lf.add_local(fldidxn);
            var fldidxslot: i32 = lf.slot_of(fldidxn);
            lf = lf.emit(ir.op_const_i32(0 - 1));
            lf = lf.emit(ir.op_store_local(fldidxslot));
            // element binding: string element marks the slot str; a
            // struct/enum element carries the element type so `c.field`
            // / `c.method()` / `match (c)` in the body resolve.
            lf = lf.add_local(fr.var_name);
            var fldvslot: i32 = lf.slot_of(fr.var_name);
            if (fld_elem_kind == 1) { lf = lf.mark_str(fldvslot, true); }
            else if (fld_elem_kind == 3) { lf = lf.mark_opt_type(fldvslot, fld_elem_ty); }
            else if (fld_elem_kind == 4) { lf = lf.mark_tuple_elems(fldvslot, tuple_elem_tags(fld_elem_ty)).mark_tuple_type(fldvslot, fld_elem_ty); }
            else { lf = lf.mark_struct_type(fldvslot, fld_elem_ty); }
            // counted loop using explicit arr_len/arr_get on the borrow.
            lf = lf.emit(ir.op_block(0)).enter_loop();
            lf = lf.emit(ir.op_loop(0));
            lf = lf.emit(ir.op_load_local(fldidxslot));
            lf = lf.emit(ir.op_const_i32(1));
            lf = lf.emit(ir.op_bin("add", 0, false));
            lf = lf.emit(ir.op_store_local(fldidxslot));
            lf = lf.emit(ir.op_load_local(fldidxslot));
            lf = lf.emit(ir.op_load_local(fldslot));
            lf = lf.emit(ir.op_arr_len());
            lf = lf.emit(ir.op_bin("lt_s", 0, false));
            lf = lf.emit(ir.op_bin("not", 0, false));
            lf = lf.emit(ir.op_brif(1));
            lf = lf.emit(ir.op_load_local(fldslot));
            lf = lf.emit(ir.op_load_local(fldidxslot));
            lf = lf.emit(ir.op_arr_get_nc(32));   // idx < arr_len guard ran above (#4380 lever 3)
            lf = lf.emit(ir.op_store_local(fldvslot));
            lf = lower_block(fr.body, lf);
            if (!lf.ok) { return lf; }
            lf = lf.emit(ir.op_br(0));
            lf = lf.emit(ir.op_end());
            return lf.emit(ir.op_end()).exit_loop();
        }
    }
    if (!for_iter_ident && !for_var_comma) {
        return lower_foreach_snapshot(fr.var_name, fr.iter, fr.body, s);
    }
    // `for k, v in m` over a map LOCAL → snapshot keys()/values() into
    // two hidden locals, then a counted loop binding k = keys[i],
    // v = values[i]. The two column reads share iteration order on every
    // backend (the parallel arrays on x86-64/arm64; the probe-order
    // snapshot on wasm, where map_keys/map_values walk the same slots),
    // so keys[i] pairs with values[i]. The hidden locals are deliberately
    // NOT array-marked (the exit-sweep never decs them); arr_len/arr_get
    // are emitted explicitly so they don't need the mark. Per column
    // (#4353): a scalar i32 column (elem flag 0) is a fresh rc=1 SNAPSHOT
    // on every backend and is explicitly released right after the loop;
    // a string/other column (flag 1) stays a register-backend BORROW of
    // the map's internal array (no inc, no post-loop free — slice 3).
    var mslot: i32 = 0 - 1;
    match (fr.iter) {
        ast.ExprIdent(mid0) => { mslot = s.slot_of(mid0.name); },
        _ => {}
    }
    // Split at TOP-LEVEL commas: a nested value position (`for (k, (lo, hi))
    // in m`) carries its own commas inside parens.
    var kvparts: string[] = rc_fe_split_csv(fr.var_name);
    if (mslot >= 0 && s.map_type_of(mslot) != "" && kvparts.len() == 2) {
        var mty: string = s.map_type_of(mslot);
        var kkind: i32 = map_key_kind_of(mty);   // 1 = i32 keys, 0 = string
        var vty: string = map_value_of(mty);
        var kname: string = kvparts[0];
        var vname: string = kvparts[1];
        // A map key is never a tuple, so only the VALUE position can nest. It
        // binds a hidden temp the destructure reads, the same shape the
        // element path takes.
        var vdes: string = "";
        if (vname.len() > 2 && slice_unchecked(vname, 0, 1) == "(") {
            vdes = "" + slice_unchecked(vname, 1, vname.len() - 1);
            vname = "$forvd" + util.i32_to_string(s.locals.len());
        }
        if (kname.len() > 0 && slice_unchecked(kname, 0, 1) == "(") { return s.fail(); }
        // keys column -> hidden local
        var mkv_kflag: i32 = map_kv_elem_flag(mty, "keys");
        var mkv_vflag: i32 = map_kv_elem_flag(mty, "values");
        var ksn: string = "$forks" + util.i32_to_string(s.locals.len());
        var fm: LowerState = s.add_local(ksn);
        var ksslot: i32 = fm.slot_of(ksn);
        fm = fm.emit(ir.op_load_local(mslot));
        fm = fm.emit(ir.op_map_keys(mkv_kflag));
        fm = fm.emit(ir.op_store_local(ksslot));
        // values column -> hidden local
        var vsn: string = "$forvs" + util.i32_to_string(fm.locals.len());
        fm = fm.add_local(vsn);
        var vsslot: i32 = fm.slot_of(vsn);
        fm = fm.emit(ir.op_load_local(mslot));
        fm = fm.emit(ir.op_map_values(mkv_vflag, map_value_widekind(vty)));
        fm = fm.emit(ir.op_store_local(vsslot));
        // hidden index
        var idxn: string = "$foridx" + util.i32_to_string(fm.locals.len());
        fm = fm.add_local(idxn);
        var idxslot2: i32 = fm.slot_of(idxn);
        fm = fm.emit(ir.op_const_i32(0 - 1));   // idx = -1 (advance-at-top, #2788)
        fm = fm.emit(ir.op_store_local(idxslot2));
        // k, v bindings (carry string-ness / 64-bit width+sign for downstream
        // dispatch — a Map[K, i64/u64] value column stores 8-byte elements, so
        // `v` must width-track i64 (and sign-track u64: `v >> 58` in the body
        // selects shr_u) or the body reads a truncated/signed i32 (#5253).
        fm = fm.add_local(kname);
        var kslot: i32 = fm.slot_of(kname);
        if (kkind == 0) { fm = fm.mark_str(kslot, true); }
        fm = fm.add_local(vname);
        var vslot: i32 = fm.slot_of(vname);
        if (vty == "string") { fm = fm.mark_str(vslot, true); }
        else if (vty == "i64") { fm = fm.mark_i64(vslot, true); }
        else if (vty == "u64") { fm = fm.mark_u64(vslot, true); }
        else if (vty == "f64") { fm = fm.mark_f64(vslot, true); }
        // A tuple value carries its element tags so a `v.N` read — and the
        // nested destructure below — resolve the element types.
        else if (util.is_tuple_type_name(vty)) { fm = fm.mark_tuple_elems(vslot, tuple_elem_tags(vty)).mark_tuple_type(vslot, vty); }
        // loop: idx++ (top) ; idx < keys.len() ; bind k/v ; body ; back-edge.
        // The increment is at the top so a `continue` (br-to-header)
        // re-runs it instead of skipping it (#2788).
        fm = fm.emit(ir.op_block(0)).enter_loop();
        fm = fm.emit(ir.op_loop(0));
        fm = fm.emit(ir.op_load_local(idxslot2));
        fm = fm.emit(ir.op_const_i32(1));
        fm = fm.emit(ir.op_bin("add", 0, false));
        fm = fm.emit(ir.op_store_local(idxslot2));
        fm = fm.emit(ir.op_load_local(idxslot2));
        fm = fm.emit(ir.op_load_local(ksslot));
        fm = fm.emit(ir.op_arr_len());
        fm = fm.emit(ir.op_bin("lt_s", 0, false));
        fm = fm.emit(ir.op_bin("not", 0, false));
        fm = fm.emit(ir.op_brif(1));
        fm = fm.emit(ir.op_load_local(ksslot));
        fm = fm.emit(ir.op_load_local(idxslot2));
        fm = fm.emit(ir.op_arr_get_nc(32));   // key: idx < ks_len guard ran above (#4380 lever 3)
        fm = fm.emit(ir.op_store_local(kslot));
        fm = fm.emit(ir.op_load_local(vsslot));
        fm = fm.emit(ir.op_load_local(idxslot2));
        // 64-bit value column: read the full 8-byte element — arr_get_i64
        // (i64.load) for i64/u64, arr_get width 64 (f64.load) for f64 —
        // not a 32-bit slice of it (#5253).
        if (vty == "i64" || vty == "u64") { fm = fm.emit(ir.op_arr_get_i64_nc()); }
        else if (vty == "f64") { fm = fm.emit(ir.op_arr_get_nc(64)); }
        else { fm = fm.emit(ir.op_arr_get_nc(32)); }
        fm = fm.emit(ir.op_store_local(vslot));
        if (vdes.len() > 0) {
            fm = lower_stmt_var(ast.StmtVar { name: vdes, type_name: "",
                init: ast.ExprIdent { name: vname, line: fr.line, col: 0, ty: "" },
                line: fr.line, col: 0, is_str: false, fn_ret: "", fn_param_types: "" }, fm);
            if (!fm.ok) { return fm; }
        }
        fm = lower_block(fr.body, fm);
        if (!fm.ok) { return fm; }
        fm = fm.emit(ir.op_br(0));
        fm = fm.emit(ir.op_end());
        fm = fm.emit(ir.op_end()).exit_loop();
        // Release the SNAPSHOT columns (flag 0 — scalar i32, a fresh rc=1
        // copy on every backend) right after the loop; `break` exits land
        // here too. Borrowed columns (flag 1) are the map's own buffers and
        // must NOT be dec'd. An early `return` in the body skips this — a
        // bounded, sound leak, like every non-swept hidden temp.
        if (mkv_kflag == 0) {
            fm = fm.release_zero(ksslot, "__fern_rc_dec", "map-iter-snapshot");
        }
        // String KEY column (flag 2, #4353 slice 3): deep-release the retaining
        // snapshot (__fern_str_arr_free — per-element rc-aware free + buffer).
        if (mkv_kflag == 2) {
            fm = fm.release_zero(ksslot, "__fern_str_arr_free", "map-iter-snapshot");
        }
        if (mkv_vflag == 0) {
            fm = fm.release_zero(vsslot, "__fern_rc_dec", "map-iter-snapshot");
        }
        // String VALUE column (flag 2): same deep-release.
        if (mkv_vflag == 2) {
            fm = fm.release_zero(vsslot, "__fern_str_arr_free", "map-iter-snapshot");
        }
        return fm;
    }
    // `for x in <arr>` over an array LOCAL/PARAM (i32[] or string[]) →
    // a counted loop using existing ops. Other iter forms (calls,
    // literals, maps) bail. break/continue in the body DO lower:
    // the loop is emitted advance-at-top (#2788, same as the range form),
    // so the StmtBreak / StmtContinue handlers' br-to-exit / br-to-header
    // land correctly (continue re-runs the increment). The array is an
    // ident, so re-loading it each iteration is side-effect-free.
    var aslot: i32 = 0 - 1;
    match (fr.iter) {
        ast.ExprIdent(iid) => { aslot = s.slot_of(iid.name); },
        _ => {}
    }
    if (aslot < 0) { return s.fail(); }
    if (!s.is_arr_slot(aslot)) { return s.fail(); }
    var elem_is_str: boolean = s.is_strarr_slot(aslot);
    // `for x in <f64[]>`: the element binding x is an f64, loaded with an
    // 8-byte arr_get (width 64 → f64.load on wasm). Marked f64 so the
    // loop body's uses of x pick the float ops and x declares as a wasm
    // (local f64). i32 / string[] elements use the 4-byte path.
    // `for x in <i64[]>`: the element binding x is an i64 (8-byte), read
    // with arr_get_i64 (i64.load) and marked i64 so the loop body's uses
    // of x route through lower_i64 and x declares as a wasm (local i64).
    var elem_is_i64: boolean = s.is_i64arr_slot(aslot);
    // `for b in <boolean[]>`: the element binding is a boolean. Dispatch only —
    // the read is the same 4-byte arr_get an i32 element takes — but without it
    // `for b in bs { b.to_json() }` rendered 1/0 while `bs[i].to_json()` on the
    // same array rendered true/false, two spellings of one read disagreeing
    // (#6305).
    var elem_is_bool: boolean = s.is_boolarr_slot(aslot);
    var elem_is_f64: boolean = s.is_f64arr_slot(aslot);
    // `for x in <u64[]>`: u64 rides the i64 64-bit domain (#2904), so the
    // element is read 8-byte (arr_get_i64, identical bytes to i64) but
    // the binding is marked u64 — mark_u64 makes is_i64_slot(x) true (so
    // x is i64-wide) AND is_u64_slot(x) true (so the body's compares /
    // shifts on x select the UNSIGNED ops; a signed compare would
    // mis-order a value >= 2^63, e.g. in cmp.max_of over a u64[]). The slot passed the
    // is_arr_slot guard above, so is_u64_slot here means u64[], not a
    // scalar u64.
    var elem_is_u64: boolean = s.is_u64_slot(aslot);
    var elem_w: i32 = 32;
    if (elem_is_f64) { elem_w = 64; }
    // Fresh hidden index local + the user-visible element binding.
    var idxname: string = "$foridx" + util.i32_to_string(s.locals.len());
    var ff: LowerState = s.add_local(idxname);
    var idxslot: i32 = ff.slot_of(idxname);
    ff = ff.emit(ir.op_const_i32(0 - 1));   // idx = -1 (advance-at-top, #2788)
    ff = ff.emit(ir.op_store_local(idxslot));
    ff = ff.add_local(fr.var_name);
    var xslot: i32 = ff.slot_of(fr.var_name);
    if (elem_is_str) {
        ff = ff.mark_str(xslot, true);
        if (aslot < ff.n_params) { ff = ff.mark_str_caller_elem(xslot, true); }
    }
    if (elem_is_bool) { ff = ff.mark_bool(xslot, true); }
    if (elem_is_f64) { ff = ff.mark_f64(xslot, true); }
    // `for v in <f32[]>`: the element is an f32. Dispatch-only, exactly as the
    // boolean case below — the read is the same 8-byte arr_get an f64 element
    // takes — but without it `for v in a { v.to_string() }` rendered at f64
    // precision while `a[i].to_string()` on the same array rendered at f32,
    // two spellings of one read disagreeing (the shape #6305 fixed for bool).
    if (s.is_f32arr_slot(aslot)) { ff = ff.mark_f32(xslot, true); }
    if (elem_is_i64) { ff = ff.mark_i64(xslot, true); }
    if (elem_is_u64) { ff = ff.mark_u64(xslot, true); }
    // `for f in <closure[]>`: each element is a closure box, so bind the
    // loop var a closure local (its call unpacks the env box rather than
    // calling the raw pointer as a table index). The loop var is a BORROW of
    // the array's element boxes — it never owns them, so it is deliberately
    // NOT is_arr: the exit-sweep must not dec a borrowed closure box (closures
    // are leak-only; when the array is a struct field the struct's own field
    // reclaim frees the boxes, so a second dec here underflows their rc — the
    // whole-field-alias foreach `var fns = r.hs; for h in fns` and the
    // snapshot-routed `for h in r.hs`). #5160 RC-soundness follow-up.
    if (s.is_closurearr_slot(aslot)) { ff = ff.mark_closure_local(fr.var_name); }
    // `for row in <T[][]>`: each element is itself an array, so bind the
    // loop var as an array source — lets `for x in row` / `row` flow as an
    // array. The element loads via the default 4-byte/slot arr_get (the
    // inner array's data pointer), same as a struct/string element.
    if (s.is_arrarr_slot(aslot)) {
        ff = ff.mark_arr(xslot, true);
        // Carry the inner element kind so `for x in row` reads 8-byte
        // i64/f64 elements instead of truncating to 32 bits. #2691.
        if (s.arrarr_elem_of_slot(aslot) == "i64") { ff = ff.mark_i64arr(xslot, true); }
        if (s.arrarr_elem_of_slot(aslot) == "f64") { ff = ff.mark_f64arr(xslot, true); }
        // A 3-deep source (`for plane in <T[][][]>`): the element is ITSELF an
        // array-of-arrays, so carry that too or the next `for` level sees a
        // scalar. See the "arr" kind in the arrarr_e derivation.
        if (s.arrarr_elem_of_slot(aslot) == "arr") { ff = ff.mark_arrarr(xslot, true); }
    }
    // `for x in <struct[]>`: x is a struct (pointer) element — carry the
    // element struct type (from the array slot's local_struct_type) so
    // `x.field` / `x.method()` in the body resolve. The element loads
    // via the default 4-byte/slot arr_get like a string element.
    var elem_struct: string = s.struct_type_of_slot(aslot);
    if (elem_struct != "") { ff = ff.mark_struct_type(xslot, elem_struct); }
    // `for o in <Option[T][]>` / `<Result[…][]>`: each element is an
    // Option/Result value — carry the element type (from the array slot's
    // opt_type, stripping the array `[]`) so a `match (o)` in the body
    // recovers the payload. The foreach binds the element here directly
    // (not via StmtVar), so it needs its own opt-type marking.
    var elem_opt: string = s.opt_type_of_slot(aslot);
    if (elem_opt.len() >= 2 && slice_unchecked(elem_opt, elem_opt.len() - 2, elem_opt.len()) == "[]") {
        var eopt: str = slice_unchecked(elem_opt, 0, elem_opt.len() - 2);
        if (eopt.len() >= 8 && (slice_unchecked(eopt, 0, 7) == "Option[" || slice_unchecked(eopt, 0, 7) == "Result[")) { ff = ff.mark_opt_type(xslot, eopt); }
    }
    // `for p in <(tuple)[]>`: each element is a tuple, so carry the element
    // tuple's tags on the loop var (mark_tuple_elems) so `p.N` resolves its
    // element type in the body. The element tuple type sits on the array
    // slot's arrarr_elem (#4365 — the same place the direct-index `ps[i].N`
    // reads it); the loop var needs its own mark. Without it a pointer
    // element (`p.1` of a `(i32, string)`) had no tag, so an INFERRED `var s
    // = p.1` typed it wrong and `s.len()` mis-read the string — a silent
    // miscompile (`p.1` printed fine, but its length came out wrong).
    var elem_tup: string = s.arrarr_elem_of_slot(aslot);
    if (util.is_tuple_type_name(elem_tup)) { ff = ff.mark_tuple_elems(xslot, tuple_elem_tags(elem_tup)).mark_tuple_type(xslot, elem_tup); }
    // `for m in <Map[K, V][]>`: each element is a map, so carry the element
    // Map[K, V] on the loop var (mark_map_type) or a map op in the body has no
    // receiver type and mis-dispatches as `i32.<op>`. It reads the array slot's
    // map column directly — the raw map_type_of, not slot_map_type: that column
    // holds the ELEMENT type for a map-array slot, which is exactly what an
    // element binding wants, and is where the direct-index `ms[i].get(k)` reads
    // it too. The tuple case above needs its own mark for the same reason.
    var elem_map: string = s.map_type_of(aslot);
    if (is_map_type_name(elem_map)) { ff = ff.mark_map_type(xslot, elem_map); }
    ff = ff.emit(ir.op_block(0)).enter_loop();  // depth 1 = break/exit target
    ff = ff.emit(ir.op_loop(0));                // depth 0 = continue/header
    // advance: idx = idx + 1 at the top, so a `continue` (br-to-header)
    // re-runs it instead of skipping it (#2788).
    ff = ff.emit(ir.op_load_local(idxslot));
    ff = ff.emit(ir.op_const_i32(1));
    ff = ff.emit(ir.op_bin("add", 0, false));
    ff = ff.emit(ir.op_store_local(idxslot));
    // cond: idx < arr.len(); exit when NOT.
    ff = ff.emit(ir.op_load_local(idxslot));
    ff = ff.emit(ir.op_load_local(aslot));
    ff = ff.emit(ir.op_arr_len());
    ff = ff.emit(ir.op_bin("lt_s", 0, false));
    ff = ff.emit(ir.op_bin("not", 0, false));
    ff = ff.emit(ir.op_brif(1));
    // x = arr[idx]  (8-byte i64 / f64 element, or 4-byte i32 / string[])
    ff = ff.emit(ir.op_load_local(aslot));
    ff = ff.emit(ir.op_load_local(idxslot));
    // Unchecked reads (#4380 lever 3): the `idx < arr.len()` guard ran at the top
    // of this iteration, so the element read is provably in bounds — drop the
    // per-iteration bounds check (x86 honours the flag; arm64/wasm keep theirs).
    if (elem_is_i64 || elem_is_u64) { ff = ff.emit(ir.op_arr_get_i64_nc()); }
    else { ff = ff.emit(ir.op_arr_get_nc(elem_w)); }
    ff = ff.emit(ir.op_store_local(xslot));
    ff = lower_block(fr.body, ff);
    if (!ff.ok) { return ff; }
    ff = ff.emit(ir.op_br(0));   // back-edge to header (re-advances)
    ff = ff.emit(ir.op_end());
    return ff.emit(ir.op_end()).exit_loop();
    return s.fail();
}

// lower_stmt_match: the ast.StmtMatch arm of lower_stmt, split out so no single
// function's per-function emit accumulation can exhaust the fixed bump
// arena on the whole-compiler per-module emits (a ~3,000-line lower_stmt
// tripped the exit-137 alloc trap on its own; oversized functions also
// miscompile — cf. #2720). Body moved verbatim; the trailing s.fail()
// preserves lower_stmt's own post-match fallback for any fall-through.
function lower_stmt_match(m: ast.StmtMatch, s: LowerState): LowerState {
    // Enum `match`: lower the scrutinee into a fresh slot, then a chain of
    // arms inside an outer block. Each variant arm is its own block: it
    // tests the scrutinee with variant_is and `br`s out of the arm block on
    // mismatch (falling to the next arm); on a match it binds the single
    // scalar payload (struct_get 0), runs the body, and `br`s out of the
    // OUTER block (exiting the match). A wildcard arm runs unconditionally
    // and exits. Only scalar-payload enum-variant arms + a trailing
    // wildcard are lowered; guards, multi-bindings, Option/Result/bool
    // patterns, and non-scalar payloads bail.
    var ms: LowerState = lower_expr(m.scrutinee, s);
    if (!ms.ok) { return ms; }
    var scrut: string = "$mscrut" + util.i32_to_string(ms.locals.len());
    ms = ms.add_local(scrut);
    var scrut_slot: i32 = ms.slot_of(scrut);
    ms = ms.emit(ir.op_store_local(scrut_slot));
    ms = ms.emit(ir.op_block(0));     // outer block: arm bodies br out of it
    for each_arm in m.arms {
        var arm: ast.MatchArm = each_arm;
        // `@` binding `n @ Variant(...)`: bind the whole matched value. The
        // scrutinee was cached in `scrut` above, so prepend `var n = scrut;`
        // to the arm body (the ordinary var-binding path handles the enum-
        // typed alias + its RC), and rewrite any guard reference to `n` to
        // `scrut` — the guard is lowered before the body-prepended bind, so it
        // reads the cached scrutinee directly.
        match (arm.pattern) {
            ast.PatVariant(pv_at) => {
                if (pv_at.at_binding.len() > 0) {
                    var at_init: ast.Expr = ast.ExprIdent { name: scrut, line: 0, col: 0, ty: "" };
                    var at_body: ast.Stmt[] = [ast.StmtVar { name: pv_at.at_binding, type_name: "", init: at_init, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" }];
                    var at_bi: i32 = 0;
                    while (at_bi < arm.body.len()) { at_body = at_body.append(arm.body[at_bi]); at_bi = at_bi + 1; }
                    var at_guard: ast.Expr = arm.guard;
                    if (arm.has_guard) { at_guard = astwalk.subst_ident_expr(arm.guard, pv_at.at_binding, scrut); }
                    arm = ast.MatchArm { ...arm, body: at_body, guard: at_guard };
                }
            },
            _ => {}
        }
        match (arm.pattern) {
            ast.PatVariant(pv) => {
                if (is_builtin_variant_pattern(ms.structs, pv.type_name, expr_struct_type(m.scrutinee, ms))) {
                    // A `true`/`false` boolean pattern: the scrutinee is
                    // already a 0/1 value in scrut_slot (no tag to extract),
                    // so the arm tests it directly — skip on mismatch, run the
                    // body, exit the match. Mirrors the Option-tag arm shape.
                    if (pv.type_name == "true" || pv.type_name == "false") {
                        var bwant: i32 = 0;
                        if (pv.type_name == "true") { bwant = 1; }
                        ms = ms.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                        ms = ms.emit(ir.op_load_local(scrut_slot));
                        ms = ms.emit(ir.op_const_i32(bwant));
                        ms = ms.emit(ir.op_bin("ne", 0, false));   // 1 if scrut != want
                        ms = ms.emit(ir.op_brif(0));               // -> skip arm on mismatch
                        if (arm.has_guard) {
                            ms = lower_expr(arm.guard, ms);
                            if (!ms.ok) { return ms; }
                            ms = ms.emit(ir.op_bin("not", 0, false));
                            ms = ms.emit(ir.op_brif(0));
                        }
                        ms = lower_block(arm.body, ms);
                        if (!ms.ok) { return ms; }
                        ms = ms.emit(ir.op_br(1));      // matched -> exit the match
                        ms = ms.emit(ir.op_end());      // end arm block
                        continue;
                    }
                    var hb: boolean = pv.binding.len() > 0 && pv.binding != "_";
                    // A payload binding needs the payload's type. Only a
                    // direct-call scrutinee `f()` whose ret_type is recorded
                    // (opt_ret_fns) lets us recover it: T for Some/Ok, E for
                    // Err. Scalar (i32/boolean) binds plain; string via
                    // mark_str; anything else (composite/unknown/non-call
                    // scrutinee) bails.
                    var ptag: string = "";
                    if (hb) {
                        // Recover the scrutinee's Option/Result type: a
                        // direct-call `f()` via opt_ret_fns, or a local/param
                        // var via its tracked local_opt_type.
                        var srt: string = "";
                        match (m.scrutinee) {
                            ast.ExprCall(scl) => {
                                match (scl.callee) {
                                    ast.ExprIdent(scid) => {
                                        // resolve_argref_opt_type substitutes an
                                        // erased-generic "$arg<i>" payload (incl.
                                        // a tuple payload `Option[($arg0, i32)]`)
                                        // from the call arguments, so `match
                                        // (mk("x")) { Some(t) => t.0.len() }`
                                        // types t.0 from the string argument
                                        // instead of the raw type-var tag.
                                        srt = resolve_argref_opt_type(ms.opt_ret_type(scid.name), scl.args, ms);
                                        // `match (Some(7))` — a direct Option
                                        // construction recovers the payload from
                                        // the scrutinee (no local needed).
                                        if (srt == "") { srt = some_opt_type(m.scrutinee, ms); }
                                        // A DIRECT closure-call scrutinee (`match
                                        // (f(x))`, f a closure/fn param returning
                                        // Option/Result): opt_ret_type is keyed by
                                        // function name and misses the param, so
                                        // recover from its signature return type
                                        // (closure_opt_rets — find_map-shaped).
                                        if (srt == "") { srt = ms.closure_opt_ret(ms.slot_of(scid.name)); }
                                    },
                                    ast.ExprFieldAccess(scfa) => {
                                        // A built-in array method returning Option
                                        // (`match (xs.min())`) — helper-backed, so its
                                        // return type comes from the registry, not the
                                        // module's funcs.
                                        srt = builtin_arr_opt_ret_type(scfa.field, scfa.obj, ms);
                                        // Associated call `Type.method()` returning
                                        // Option/Result — the object is a bare TYPE
                                        // name (not a slot), so key opt_ret_type by
                                        // "<Type>.<method>" directly. Recovers an
                                        // unannotated `match (User.from_json(s))`'s
                                        // Result[User, string] payload types (the
                                        // @derive(Json) deserialiser).
                                        if (srt == "") {
                                            match (scfa.obj) {
                                                ast.ExprIdent(tid) => {
                                                    if (ms.slot_of(tid.name) < 0) {
                                                        srt = ms.opt_ret_type(tid.name + "." + scfa.field);
                                                    }
                                                },
                                                _ => {}
                                            }
                                        }
                                        // A built-in Reader/Writer resource method
                                        // (read_line / read_chunk / write / close), gated
                                        // like lower_expr's interception. A read_line /
                                        // read_chunk Some payload binds as a string (mark_str).
                                        if (srt == "") {
                                            srt = resource_method_opt_ret_type(scfa.field, scfa.obj, ms);
                                        }
                                        // `m.get(k)` evaluates to Option[V] (V = the map's value type)
                                        // — a map local OR a Map-typed struct field (`r.caps.get(k)`),
                                        // both resolved by expr_map_type_tag.
                                        if (srt == "" && scfa.field == "get") {
                                            var gvt: string = map_value_of(expr_map_type_tag(scfa.obj, ms));
                                            if (gvt != "") { srt = "Option[" + gvt + "]"; }
                                        }
                                        // `x.method()` where x's method returns Option/Result —
                                        // key by "<Type>.<method>".
                                        if (srt == "") {
                                            var mrty: string = expr_struct_type(scfa.obj, ms);
                                            if (mrty != "") {
                                                srt = ms.opt_ret_type(mrty + "." + scfa.field);
                                                // A closure-typed FIELD (`st.run(c)` where
                                                // `run: (C) => Result[C, E]`) is not a method, so the
                                                // registry keyed "<Type>.<method>" above misses it. The
                                                // field's declared RETURN spelling is recorded on
                                                // StructFieldDecl.fn_ret, so read that instead — the
                                                // struct-field twin of the ParamDecl.fn_ret that seeds
                                                // closure_opt_rets for a closure PARAM (consulted for a
                                                // bare-ident callee a few arms up). Covers the array
                                                // spelling `sts[i].run(c)` too: expr_struct_type resolves
                                                // an indexed struct array to its ELEMENT type.
                                                if (srt == "") {
                                                    var ffr: string = decl_field_fn_ret(ms.structs, mrty, scfa.field);
                                                    if (ffr.len() >= 8 && (slice_unchecked(ffr, 0, 7) == "Option[" || slice_unchecked(ffr, 0, 7) == "Result[")) { srt = ffr; }
                                                }
                                            }
                                            // An Option/Result-RECEIVER method
                                            // (`match (r.map())`) — key
                                            // "Option.<m>" / "Result.<m>" (#3049).
                                            else {
                                                var mrb: string = opt_recv_base_type(scfa.obj, ms);
                                                if (mrb != "") { srt = ms.opt_ret_type(mrb + "." + scfa.field); }
                                                // An enum-receiver method returning
                                                // Option/Result on a fresh variant
                                                // (`match (V(7).get())`) (#3076).
                                                else {
                                                    var men: string = expr_enum_type(scfa.obj, ms);
                                                    if (men != "") { srt = ms.opt_ret_type(men + "." + scfa.field); }
                                                    // A string-receiver method returning
                                                    // Option/Result (`match (s.parse_int())`)
                                                    // — key "string.<method>" (string methods
                                                    // register under base_type "string").
                                                    else if (expr_is_str(scfa.obj, ms)) {
                                                        srt = ms.opt_ret_type("string." + scfa.field);
                                                    }
                                                    // A NUMERIC-primitive receiver
                                                    // method returning Option/Result
                                                    // (`match ((3 as i64).checked_add(4))`)
                                                    // — key "<prim>.<method>" (i64 /
                                                    // u64 / f64 / … methods register
                                                    // under their base scalar type).
                                                    else {
                                                        var mprim: string = expr_recv_prim_type(scfa.obj, ms);
                                                        if (mprim != "") { srt = ms.opt_ret_type(mprim + "." + scfa.field); }
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    // An if-/match-EXPRESSION scrutinee
                                    // (`match (if (c) { Some(7) } else { None })`)
                                    // — a 0-arg IIFE. Recover the Option type from
                                    // the leaf branch's Some(...) via iife_leaf_value
                                    // (unwrapping any nesting).
                                    ast.ExprLambda(_) => { srt = some_opt_type(iife_leaf_value(m.scrutinee), ms); },
                                    _ => {}
                                }
                            },
                            ast.ExprIdent(sid) => { srt = ms.opt_type_of_slot(ms.slot_of(sid.name)); },
                            // `match (e as? T)` — the downcast scrutinee
                            // (docs/DYN-TRAITS.md §9) yields Option[T], so the
                            // Some-arm payload binds as a T (struct) value —
                            // or `match (e as Option[T])`, a plain ascription.
                            ast.ExprUnary(sun) => { srt = unary_opt_type(sun.op); },
                            // `match (p.opt)` where `opt` is an Option/Result
                            // struct field — recover its type from the field.
                            // `match (t.N)` where the tuple element is an
                            // Option — recover from the element's tracked tag
                            // (a numeric field; #3018).
                            ast.ExprFieldAccess(sfa) => {
                                if (util.is_all_digits(sfa.field)) {
                                    var ttg: string = expr_tuple_elem_tag(sfa.obj, util.digits_to_i32(sfa.field), ms);
                                    if (ttg.len() >= 8 && (slice_unchecked(ttg, 0, 7) == "Option[" || slice_unchecked(ttg, 0, 7) == "Result[")) { srt = ttg; }
                                } else {
                                    var foty: string = expr_struct_type(sfa.obj, ms);
                                    if (foty != "") {
                                        var fft: string = decl_field_type(ms.structs, foty, sfa.field);
                                        if (fft.len() >= 8 && (slice_unchecked(fft, 0, 7) == "Option[" || slice_unchecked(fft, 0, 7) == "Result[")) { srt = fft; }
                                    }
                                }
                            },
                            // `match (<base>[i])` where the element is an
                            // Option/Result — a local (`a[i]`), a struct field
                            // (`b.o[i]`), a tuple element (`t.N[i]`), or a
                            // nested index (`aoa[i][j]`).
                            ast.ExprIndex(six) => { srt = opt_elem_of(arr_tag_of(six.array, ms)); },
                            // `match (a +? b)` — a checked arithmetic scrutinee
                            // (#5542) evaluates to Option[T] (T the operand
                            // width). Recover it so the Some(v) arm binds v.
                            ast.ExprBinary(scb) => {
                                if (is_chk_op(scb.op)) { srt = chk_opt_type_tag(scb, ms); }
                            },
                            // `match (s[a:b])` — the checked string slice (#5634)
                            // evaluates to Option[str]. An ARRAY slice is not an
                            // Option and leaves srt empty, which bails.
                            ast.ExprSlice(scsl) => {
                                if (expr_is_str(scsl.array, ms)) { srt = "Option[string]"; }
                            },
                            _ => {}
                        }
                        if (srt == "") { return s.fail(); }
                        ptag = opt_payload_type(srt, pv.type_name);
                        // A leaf-safe struct payload (Some(p) / Ok(p) /
                        // Err(p) where p is a scalar-field struct) is stored
                        // by pointer at offset 8 — identical to the string
                        // case — so it reads via op_opt_payload and binds as
                        // a struct slot (its type tagged below for `p.field`).
                        var ptag_is_struct: boolean = decl_is_struct(ms.structs, ptag) && decl_is_leaksafe(ms.structs, ptag);
                        // An ENUM payload (`Some(c)` where c: Color, or an
                        // Ok/Err enum) is likewise stored by pointer at
                        // offset 8 — read via op_opt_payload and bound with
                        // its enum name so `match (c)` / `c.method()` resolve.
                        var ptag_is_enum: boolean = is_enum_like_name(ptag, ms.structs);
                        // A NESTED Option/Result payload (`Some(inner)` where
                        // inner: Option[T]) is stored by pointer at offset 8
                        // too — read via op_opt_payload and bound with its
                        // Option/Result type so the inner `match (inner)`
                        // recovers the payload via opt_type_of_slot.
                        var ptag_is_opt: boolean = ptag.len() >= 8 && (slice_unchecked(ptag, 0, 7) == "Option[" || slice_unchecked(ptag, 0, 7) == "Result[");
                        // A leak-safe tuple payload (`Some(p)` where p is a
                        // tuple of scalar/string/leaf-safe-struct/Option
                        // elements — e.g. split_once's (string, string)) is a
                        // pointer at offset 8 like a struct: read via
                        // op_opt_payload and bound with its element tags so
                        // `p.0` / `p.1` resolve. Tuples carry no RC (leak-only),
                        // so binding one borrowed from the Option box can't
                        // double-free. tuple_elems_lowerable is false for
                        // non-tuples and for array/i64-element tuples (deferred).
                        // A fn-typed payload spelling (`() => i32` /
                        // `(i32) => i32`) starts with `(` and so is also
                        // accepted by tuple_elems_lowerable — but it is a
                        // function, NOT a tuple. Detect it first so the
                        // tuple path doesn't claim it (the marks below
                        // mirror this order).
                        var ptag_is_fn: boolean = is_fn_payload_spelling(ptag) || ptag == "clo" || ptag == "fn";
                        var ptag_is_tuple: boolean = !ptag_is_fn && tuple_elems_lowerable(ptag, ms.structs);
                        // An ARRAY payload (`Some(xs)` where the Option's T is
                        // an array — `m.get(k)` on a Map[K, V[]], the url query
                        // shape) is a leak-only heap pointer at offset 8 like a
                        // struct/tuple payload: read via op_opt_payload, bound
                        // is_arr + element kind below so `xs[i]` / `xs.append(v)`
                        // (clone) / `xs.len()` resolve. The 8-byte-element and
                        // string/struct/enum-element arrays all ride one slot.
                        var ptag_is_array: boolean = ptag == "i32[]" || ptag == "boolean[]" || ptag == "u32[]" || is_subword_array_type(ptag)
                            || is_float_array_type_name(ptag) || ptag == "i64[]" || ptag == "string[]"
                            || is_struct_array_field_type(ms.structs, ptag) || is_enum_array_field_type(ms.structs, ptag);
                        // A NESTED-array payload (`Ok(seeds)` where the payload
                        // is a `T[][]` — the fuzz-corpus shape). The outer
                        // buffer is a heap pointer at offset 8 exactly like the
                        // flat array payloads (its elements are array POINTERS,
                        // riding the 4-byte-slot layout — see
                        // is_nested_array_field_type); the bound slot
                        // additionally carries is_arrarr + the inner element
                        // kind so a nested read `seeds[i][j]` / `var row =
                        // seeds[i]` types the inner level like a var binding.
                        // Borrowed from the box like every array payload
                        // (mark_borrowed_arr below keeps it out of the exit
                        // dec-sweep), and nothing frees rows the box shares.
                        var ptag_is_arrarr: boolean = is_nested_array_field_type(ms.structs, ptag) || ptag == "string[][]";
                        // A `dyn Trait` error payload (`Err(e)` where e: dyn Error):
                        // stored by pointer at offset 8 (same as a struct), read via
                        // op_opt_payload and marked with the dyn type so `e.method()`
                        // routes through op_dyn_dispatch at the call site.
                        var ptag_is_dyn: boolean = ptag.len() > 4 && slice_unchecked(ptag, 0, 4) == "dyn ";
                        // A fn-typed payload (`Some(f)` where the Option's
                        // T is `() => i32` / `(i32) => i32`, slice #3445
                        // match-fn): stored by pointer at offset 8 — the
                        // env box the constructor side wrapped — so it
                        // reads via the default 8-byte op_opt_payload and
                        // the bound slot is marked a closure local below so
                        // `f(args)` dispatches env-first. ptag_is_fn is
                        // computed above (before ptag_is_tuple, which it
                        // pre-empts). The "clo" spelling is the
                        // construction-derived sibling: an UNANNOTATED
                        // `var o = Some(<lambda>)` records "Option[clo]"
                        // (the lift wrapped the payload into a `__mkclo$`
                        // box, elem_type_tag tags it "clo") — same box,
                        // same env-first dispatch.
                        // A VOID payload (`Ok(u)` on a `Result[void, E]` — every
                        // fallible filesystem builtin: write_file, remove_file,
                        // create_dir_all, remove_dir_all). There is nothing at
                        // offset 8 to read, so it is accepted here and bound
                        // below without a payload load.
                        var ptag_is_void: boolean = ptag == "void";
                        // A MAP payload (`Some(m)` / `Ok(m)` / `Err(m)` where the
                        // payload is a Map[K, V]): a heap box pointer at offset 8,
                        // read via op_opt_payload like the struct / tuple / array
                        // payloads. is_map_type_name is a bare `Map[` prefix test,
                        // so it also matches `Map[K, V][]` — the array branch owns
                        // that spelling.
                        var ptag_is_map: boolean = is_map_type_name(ptag) && !is_array_type_name(ptag);
                        if (ptag != "i32" && ptag != "boolean" && ptag != "string" && ptag != "i64" && !elem_ty_is_f64slot(ptag) && !ptag_is_struct && !ptag_is_enum && !ptag_is_opt && !ptag_is_tuple && !ptag_is_array && !ptag_is_arrarr && !ptag_is_dyn && !ptag_is_fn && !ptag_is_void && !ptag_is_map) { return s.fail(); }
                    }
                    var want: i32 = 0;
                    if (pv.type_name == "None" || pv.type_name == "Err") { want = 1; }
                    ms = ms.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                    ms = ms.emit(ir.op_load_local(scrut_slot));
                    ms = ms.emit(ir.op_opt_tag());
                    ms = ms.emit(ir.op_const_i32(want));
                    ms = ms.emit(ir.op_bin("ne", 0, false));   // 1 if tag != want
                    ms = ms.emit(ir.op_brif(0));               // -> skip arm on mismatch
                    // A void payload has no value at offset 8 — `Ok(u)` on a
                    // `Result[void, E]` binds the unit. Give the name a slot
                    // holding 0 so a body reference resolves, and read nothing.
                    if (hb && ptag == "void") {
                        ms = ms.add_local(pv.binding);
                        ms = ms.emit(ir.op_const_i32(0));
                        ms = ms.emit(ir.op_store_local(ms.slot_of(pv.binding)));
                    } else if (hb) {
                        // Bind the payload (offset 8) BEFORE the guard, so the
                        // guard may reference it (`Some(x) when x > 0`).
                        ms = ms.add_local(pv.binding);
                        var pbslot: i32 = ms.slot_of(pv.binding);
                        ms = ms.emit(ir.op_load_local(scrut_slot));
                        // Read the payload at its width (an i64/u64/f64
                        // payload uses the matching 8-byte load) and type the
                        // bound name so later uses route correctly (i64/u64 ->
                        // lower_i64 / the i64 domain; f64 -> the float ops).
                        if (ptag == "i64" || ptag == "u64") { ms = ms.emit(ir.op_opt_payload_w(64, true)); }
                        else if (elem_ty_is_f64slot(ptag)) { ms = ms.emit(ir.op_opt_payload_w(64, false)); }
                        else { ms = ms.emit(ir.op_opt_payload()); }
                        ms = ms.emit(ir.op_store_local(pbslot));
                        if (ptag == "string") { ms = ms.mark_str(pbslot, true); }
                        else if (ptag == "i64") { ms = ms.mark_i64(pbslot, true); }
                        // A u64 payload rode the 8-byte op_opt_payload_w(64)
                        // load above; mark the slot u64 (its own 8-byte domain,
                        // like the u64 tuple destructure) so its compare / `>>`
                        // / div-rem are UNSIGNED in the i64 domain.
                        else if (ptag == "u64") { ms = ms.mark_u64(pbslot, true); }
                        // f32 / `float` ride the same 8-byte slot as f64
                        // (elem_ty_is_f64slot), so all three mark_f64. Only `f32`
                        // additionally marks f32, keying "f32.<m>" dispatch:
                        // `float` is the f64 alias, and tagging it f32 would round
                        // its arithmetic through a demote/promote pair (#5882).
                        else if (elem_ty_is_f64slot(ptag)) {
                            ms = ms.mark_f64(pbslot, true);
                            if (ptag == "f32") { ms = ms.mark_f32(pbslot, true); }
                        }
                        // A u32 payload rode the default 32-bit op_opt_payload
                        // load above (a full i32 slot, no narrowing); mark the
                        // bound slot so its `>>` is logical and its arithmetic
                        // wraps at 2^32 (the sibling of the StmtVar mark_u32 at
                        // the binding site). Sub-word payloads are not
                        // leak-safe payloads (see is_leaksafe_payload).
                        else if (ptag == "u32") { ms = ms.mark_u32(pbslot, true); }
                        // A fn-typed payload (`Some(f)` / `Ok(g)` where T is
                        // `() => i32` / `(i32) => i32`, slice #3445 match-fn):
                        // the payload read above is the env box the constructor
                        // side wrapped, BORROWED from the Option/Result box.
                        // Mark the bound NAME a closure local so `f(args)` /
                        // passing `f` dispatch env-first against the box.
                        // Checked BEFORE the struct/enum branch (the coarse
                        // "fn" spelling reads as enum-like) AND before the
                        // tuple branch (a fn spelling also starts with `(` and
                        // tuple_elems_lowerable would otherwise claim it as a
                        // tuple). "clo" is the construction-derived
                        // unannotated sibling.
                        else if (is_fn_payload_spelling(ptag) || ptag == "clo" || ptag == "fn") { ms = ms.mark_closure_local(pv.binding); }
                        // A struct payload: tag the bound slot's struct type so
                        // `p.field` resolves. It is BORROWED from the enum box
                        // (not a fresh `var p = P{...}`), so it is never in
                        // reclaimable_names — correctly left to leak, no double-free.
                        else if (is_cell_type_name(ptag)) { ms = ms.mark_cell_slot_from_type(pbslot, ptag); }
                        else if ((decl_is_struct(ms.structs, ptag) && decl_is_leaksafe(ms.structs, ptag)) || is_enum_like_name(ptag, ms.structs)) { ms = ms.mark_struct_type(pbslot, ptag); }
                        // A nested Option/Result payload: record the bound
                        // slot's Option/Result type so the inner match (or a
                        // `?`) recovers its payload.
                        else if (ptag.len() >= 8 && (slice_unchecked(ptag, 0, 7) == "Option[" || slice_unchecked(ptag, 0, 7) == "Result[")) { ms = ms.mark_opt_type(pbslot, ptag); }
                        // A tuple payload: tag the bound slot's element types
                        // so `p.0` / `p.1` read the right element width / type.
                        else if (tuple_elems_lowerable(ptag, ms.structs)) { ms = ms.mark_tuple_elems(pbslot, tuple_elem_tags(ptag)).mark_tuple_type(pbslot, ptag); }
                        // An ARRAY payload (`Some(existing)` where the Option's
                        // V is an array — e.g. `m.get(k)` on a Map[K, V[]], the
                        // url_decode query-param shape). The array is BORROWED
                        // from the Option box (leak-only, like the struct
                        // payload above), so mark the slot is_arr + its element
                        // kind so `existing[i]` / `existing.append(v)` (clone
                        // form) / `existing.len()` resolve — mirroring the
                        // tuple-destructure / user-enum payload array marks.
                        else if (ptag == "i32[]" || ptag == "boolean[]" || ptag == "u32[]" || is_subword_array_type(ptag)) {
                            ms = ms.mark_arr(pbslot, true);
                            if (ptag == "u32[]") { ms = ms.mark_u32(pbslot, true); }
                        }
                        else if (is_float_array_type_name(ptag)) { ms = ms.mark_arr(pbslot, true); ms = ms.mark_f64arr(pbslot, true); if (ptag == "f32[]") { ms = ms.mark_f32arr(pbslot, true); } }
                        else if (ptag == "i64[]") { ms = ms.mark_arr(pbslot, true); ms = ms.mark_i64arr(pbslot, true); }
                        else if (ptag == "string[]") { ms = ms.mark_arr(pbslot, true); ms = ms.mark_strarr(pbslot, true); }
                        else if (is_struct_array_field_type(ms.structs, ptag) || is_enum_array_field_type(ms.structs, ptag)) {
                            ms = ms.mark_arr(pbslot, true);
                            ms = ms.mark_struct_type(pbslot, slice_unchecked(ptag, 0, ptag.len() - 2));
                        }
                        // A NESTED-array payload: mark is_arr like the flat
                        // arrays plus is_arrarr + the inner element kind, the
                        // same marks a `var m: T[][]` binding records.
                        else if (is_nested_array_field_type(ms.structs, ptag) || ptag == "string[][]") {
                            ms = ms.mark_arr(pbslot, true);
                            ms = ms.mark_arrarr(pbslot, true);
                            ms = ms.mark_arrarr_elem(pbslot, arrarr_elem_kind_of_type(ptag));
                        }
                        // A `dyn Trait` payload: tag the bound slot with the dyn
                        // type so `e.method()` at the call site is recognised as
                        // a dyn receiver and routes through op_dyn_dispatch.
                        else if (ptag.len() > 4 && slice_unchecked(ptag, 0, 4) == "dyn ") { ms = ms.mark_struct_type(pbslot, ptag); }
                        // A MAP payload: carry the full Map[K, V] so `v.get(k)` /
                        // `v.len()` / `v.iter()` dispatch as map ops (v.get recovers
                        // Option[V] from map_type_of). BORROWED from the
                        // Option/Result box like the struct payload above, and
                        // mark_map_type sets no is_arr, so it stays out of the exit
                        // dec-sweep without needing the array branches' opt-out.
                        else if (is_map_type_name(ptag) && !is_array_type_name(ptag)) { ms = ms.mark_map_type(pbslot, ptag); }
                        // The array-payload branches above call the binding
                        // BORROWED and "leak-only", but is_arr alone put it in the
                        // exit dec-sweep, which released the Option/Result box's
                        // own buffer once per entry — the box is never swept, so
                        // nothing ever balanced that. Same defect as the user-enum
                        // arm binding, same opt-out (#6049; LocalInfo.borrowed_arr).
                        if (ms.is_arr_slot(pbslot)) { ms = ms.mark_borrowed_arr(pbslot, true); }
                    }
                    if (arm.has_guard) {
                        ms = lower_expr(arm.guard, ms);
                        if (!ms.ok) { return ms; }
                        ms = ms.emit(ir.op_bin("not", 0, false));
                        ms = ms.emit(ir.op_brif(0));
                    }
                    ms = lower_block(arm.body, ms);
                    if (!ms.ok) { return ms; }
                    ms = ms.emit(ir.op_br(1));      // matched -> exit the match
                    ms = ms.emit(ir.op_end());      // end arm block
                    continue;
                }
                // Qualified variant pattern `Enum.Variant` / `mod.Variant`
                // -> the bare variant name (the parser desugars an enum's
                // variants to structs named by the bare variant). The
                // builtin/Option patterns handled above have no '.', so
                // this is identity for them; a stripped name that isn't a
                // local variant struct still bails just below (cross-module
                // enums are not resolvable here).
                var vname: string = pv.type_name;
                var vdot: i32 = 0 - 1;
                var vld: i32 = 0;
                while (vld < pv.type_name.len()) {
                    if (pv.type_name[vld] == b'.') { vname = slice_unchecked(pv.type_name, vld + 1, pv.type_name.len()) + ""; vdot = vld; }
                    vld = vld + 1;
                }
                // A QUALIFIED pattern on an imported UNION member
                // (`mod.Struct`) — whose flattened decl is the MANGLED
                // `mod__Struct` (flatten's rewrite_pattern leaves the pattern's
                // type_name qualified, unlike ctor / field refs which it
                // mangles) — bare-strips to `Struct`, which only matches a
                // same-module ENUM variant (`E.V` → struct `V`). Only when the
                // bare name is NOT a declared struct, try the '.'→'__' mangled
                // form (built in two concatenations, NOT char-by-char, since
                // each `+` leaks in the un-reclaimed runtime and this runs per
                // arm). A hit lets the member lower through the IR path AND
                // binds `pv` typed `mod__Struct` (so a later `pv.field` read
                // dispatches correctly instead of mis-inferring i32). This
                // flips the self-host's own many `parser.*` matches from AST to
                // IR; that extra codegen once OOM'd the whole-compiler module-9
                // per-module emit (#3425), now bounded by the function-window
                // sharding (asm_modload_run -func-range). Enum variants are
                // unaffected: their mangled candidate is not a declared struct.
                if (!decl_is_struct(ms.structs, vname) && vdot >= 0) {
                    var vmangled: string = slice_unchecked(pv.type_name, 0, vdot) + "__" + slice_unchecked(pv.type_name, vdot + 1, pv.type_name.len());
                    if (decl_is_struct(ms.structs, vmangled)) { vname = vmangled; }
                }
                // Resolve WHICH decl named `vname` this arm is about. Variant
                // decls are keyed by the bare variant name, so two enums
                // declaring one variant name give two decls, and the by-name
                // accessors answer for whichever was declared first — reading
                // the other enum's payload type and width. The arm's enum is
                // the pattern's `Enum.` qualifier when it has one, else the
                // scrutinee's type; everything below reads through the decl
                // that names.
                var vowner: string = variant_pattern_qualifier(pv.type_name);
                if (variant_decl_index(ms.structs, vname, vowner) < 0) { vowner = expr_struct_type(m.scrutinee, ms); }
                var vdecl: i32 = variant_pattern_decl_index(ms.structs, vname, vowner);
                if (vdecl < 0) { return s.fail(); }
                if (!decl_at_is_leaksafe(ms.structs, vdecl)) { return s.fail(); }
                var has_bind: boolean = pv.binding.len() > 0 && pv.binding != "_";
                if (has_bind && decl_at_field_count(ms.structs, vdecl) < 1) { return s.fail(); }
                ms = ms.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                ms = ms.emit(ir.op_load_local(scrut_slot));
                ms = ms.emit(ir.op_variant_is(vname));
                ms = ms.emit(ir.op_bin("not", 0, false));   // 1 if NOT this variant
                ms = ms.emit(ir.op_brif(0));                // -> skip arm on mismatch
                // Bind each payload field. Field 0 -> pv.binding, field k>=1
                // -> pv.extra_bindings[k-1] (a multi-payload variant
                // `Pt(x, y)` desugars to struct fields __ev, __ev1, …). Each
                // reads via struct_get at its field index — offset
                // (idx+1)*8, past the shape ptr — at the field's width, and
                // types the bound name from the variant struct's field type
                // so downstream dispatch routes correctly. A `_` / empty
                // binding skips that field.
                // Discriminate an enum variant (`enum E { V(T) }`, whose
                // desugaring gives a synthetic `__ev` payload field at
                // offset 8) from a union member (`type X = A | B`, where
                // `A`/`B` are pre-existing structs with their REAL fields
                // and NO `__ev`). For a union member the variant box ptr
                // IS the value, so bind the WHOLE scrutinee pointer typed
                // with the variant's struct name — a later field read
                // (`Num(x) => x.value`) then resolves. This mirrors the
                // legacy AST emitter's `is_enum_variant` split
                // (asm.fern:3677-3693): enum variant -> offset-8 payload,
                // union member -> bind the box ptr itself.
                var union_member: boolean = decl_at_field_name(ms.structs, vdecl, 0) != "__ev";
                if (union_member) {
                    // Union member: a single binding bound to the box ptr,
                    // typed `vname` so `x.field` resolves. No struct_get /
                    // offset — the variant box pointer is the value.
                    if (pv.binding.len() > 0 && pv.binding != "_") {
                        ms = ms.add_local(pv.binding);
                        var umslot: i32 = ms.slot_of(pv.binding);
                        ms = ms.emit(ir.op_load_local(scrut_slot));
                        ms = ms.emit(ir.op_store_local(umslot));
                        ms = ms.mark_struct_type(umslot, vname);
                    }
                } else {
                var nbinds: i32 = 1 + pv.extra_bindings.len();
                var bidx: i32 = 0;
                while (bidx < nbinds) {
                    var bname: string = pv.binding;
                    if (bidx > 0) { bname = pv.extra_bindings[bidx - 1]; }
                    if (bname.len() > 0 && bname != "_") {
                        // Payload fields are `__ev`, `__ev1`, … in decl order,
                        // so the binding index IS the field index.
                        var ev_ty: string = decl_at_field_type(ms.structs, vdecl, bidx);
                        ms = ms.add_local(bname);
                        var bslot: i32 = ms.slot_of(bname);
                        // Read the payload at its width: an i64/u64 payload uses
                        // struct_get_i64 (i64.load — u64 rides the i64 8-byte
                        // domain), everything else struct_get at the width
                        // struct_field_at_width gives the field. The u64 read MUST
                        // match the binding's mark_u64 below (is_i64_slot →
                        // 64-bit) or the wasm backend, which has true 32/64
                        // widths, sees the i32 read feed an i64 use and fails to
                        // validate (type mismatch).
                        //
                        // Deferring to struct_field_at_width rather than testing
                        // "f64" here is what makes an **f32** payload read
                        // correctly: the construction side widens an f32 field to
                        // an 8-byte f64 (op_struct_new's f64.store, and the AST
                        // emitter's box likewise), so an i32.load of it returned
                        // the low half of a double — `x == 2.5` on an f32 arm was
                        // simply false. Found via the WIT f32-arm variant extern.
                        ms = ms.emit(ir.op_load_local(scrut_slot));
                        if (ev_ty == "i64" || ev_ty == "u64") { ms = ms.emit(ir.op_struct_get_i64(bidx)); }
                        else { ms = ms.emit(ir.op_struct_get(bidx, struct_field_at_width(ms.structs, vdecl, bidx))); }
                        ms = ms.emit(ir.op_store_local(bslot));
                        // Type the bound payload for downstream dispatch: a
                        // string payload (`Word(string)`) as a string; a
                        // struct payload (`Binary(BinExpr)`) with its struct
                        // type so `p.field` resolves (the compiler's own AST
                        // shape — enums of structs); an ENUM payload
                        // (`Node(Tree, Tree)`) with its enum name so a method
                        // call on the bound value (`l.sum()`) dispatches to
                        // `<Enum>.<method>` (enum-receiver, mirroring the
                        // `var a: Enum` marking); an i64 / f64 payload so
                        // later uses route through lower_i64 / the float ops.
                        if (ev_ty == "string") {
                            ms = ms.mark_str(bslot, true);
                        } else if (ev_ty == "i64") {
                            ms = ms.mark_i64(bslot, true);
                        } else if (ev_ty == "u64") {
                            // A u64 payload (`U(u64) => x`): mark_u64 sets both the
                            // 64-bit width (is_i64_slot reads is_u64 too) AND the
                            // unsigned flag, so a chained `x >> 1` / `x > y` on the
                            // bound value selects shr_u / gt_u instead of the signed
                            // form (which diverges once bit 63 is set).
                            ms = ms.mark_u64(bslot, true);
                        } else if (ev_ty == "u32") {
                            // A u32 payload (`U(u32) => x`): 4-byte (i32 width, no
                            // read-width change), but mark_u32 so a chained `x >> 1`
                            // / `x / y` selects the unsigned form — on wasm a signed
                            // shr/div on a bit-31-set u32 diverges (x86 hides it).
                            ms = ms.mark_u32(bslot, true);
                        } else if (ev_ty == "f64" || ev_ty == "f32" || ev_ty == "float") {
                            // f32 / float ride the f64 domain, matching the
                            // 8-byte widened field the read above now recovers.
                            ms = ms.mark_f64(bslot, true);
                        } else if (ev_ty == "boolean") {
                            // A boolean payload (`Yes(boolean) => v`): the read is
                            // the same 4-byte i32 one, so this is dispatch only —
                            // it makes `v.to_json()` key "boolean.to_json" rather
                            // than render 1/0 through i32's impl (#6305).
                            ms = ms.mark_bool(bslot, true);
                        } else if (ev_ty == "fn" || is_fn_payload_spelling(ev_ty) || ev_ty == "clo") {
                            // A function-typed payload (`Pending(i32,
                            // (i32) => Future)`): the i32 read above is the
                            // closure ENV box the constructor side wrapped
                            // (try_fn_field_value), borrowed from the enum
                            // box. Mark the bound name a closure local so
                            // `k(args)` dispatches env-first against the box
                            // — the same machinery Option/Result fn payloads
                            // use (Blocker 2 / 5b; Future[T]). MUST precede
                            // the enum/struct branch below: is_enum_like_name
                            // ("fn") is true, so it would otherwise claim the
                            // payload as a struct type and emit a bare call.
                            // A monomorphised GENERIC enum (`Opt[(i32) => i32]`,
                            // #5298) keeps the payload's FULL fn spelling
                            // `(i32) => i32` rather than the coarse "fn", so
                            // accept is_fn_payload_spelling here too (the
                            // built-in Option/Result fn-payload arm's sibling).
                            ms = ms.mark_closure_local(bname);
                        } else if (is_cell_type_name(ev_ty)) {
                            ms = ms.mark_cell_slot_from_type(bslot, ev_ty);
                        } else if (decl_is_struct(ms.structs, ev_ty) || is_enum_like_name(ev_ty, ms.structs)) {
                            ms = ms.mark_struct_type(bslot, ev_ty);
                        } else if (is_map_type_name(ev_ty)) {
                            // A Map payload (`JObject(Map[string, JsonValue])`):
                            // the box pointer reads via struct_get like a
                            // struct; carry the full Map[K, V] type so
                            // `m.get(k)` / `m.len()` / `m.iter()` dispatch as
                            // map ops (m.get recovers Option[V] from map_type_of).
                            ms = ms.mark_map_type(bslot, ev_ty);
                        } else if (ev_ty.len() >= 8 && (slice_unchecked(ev_ty, 0, 7) == "Option[" || slice_unchecked(ev_ty, 0, 7) == "Result[")) {
                            // An Option/Result payload (`Maybe(Option[i32])`): the box
                            // pointer reads via struct_get like a struct; carry the
                            // Option/Result type so a nested `match (o)` on the bound
                            // value recovers its payload (the enum-payload sibling of
                            // the tuple-element / struct-field opt-type marking).
                            ms = ms.mark_opt_type(bslot, ev_ty);
                        } else if (is_scalar_array_type(ev_ty)) {
                            ms = ms.mark_arr(bslot, true);
                        } else if (ev_ty == "string[]") {
                            ms = ms.mark_arr(bslot, true);
                            ms = ms.mark_strarr(bslot, true);
                        } else if (ev_ty.len() >= 3 && slice_unchecked(ev_ty, ev_ty.len() - 2, ev_ty.len()) == "[]"
                                   && (decl_is_struct(ms.structs, slice_unchecked(ev_ty, 0, ev_ty.len() - 2)) || is_enum_like_name(slice_unchecked(ev_ty, 0, ev_ty.len() - 2), ms.structs))) {
                            // A struct- / enum-array payload (`Items(P[])`):
                            // mark the slot is_arr and carry the ELEMENT type
                            // so `ps[i].field` / `for p in ps` resolve (the
                            // array-element analog of the struct payload case).
                            ms = ms.mark_arr(bslot, true);
                            ms = ms.mark_struct_type(bslot, slice_unchecked(ev_ty, 0, ev_ty.len() - 2));
                        }
                        // The binding BORROWS the enum box's buffer — the box owns
                        // it and is never swept — so keep the exit dec-sweep off it
                        // (#6049; see LocalInfo.borrowed_arr). Applied after the
                        // branch chain so every array-payload spelling is covered.
                        if (ms.is_arr_slot(bslot)) { ms = ms.mark_borrowed_arr(bslot, true); }
                        // …and when the box is one THIS FRAME built, the binding
                        // additionally carries the box's own claim (#8070): no
                        // other owner survives the call, so an escaping return
                        // hands that single reference on rather than counting a
                        // second one. See LocalInfo.moved_claim.
                        if (ms.is_arr_slot(bslot) && scrutinee_owns_no_surviving_claim(m.scrutinee, ms)) {
                            ms = ms.mark_moved_claim(bslot, true);
                        }
                    }
                    bidx = bidx + 1;
                }
                }
                // Guard: `Variant(x) if <cond> =>` runs the body only when
                // the guard is true; the binding is in scope, so the guard
                // may reference it. A false guard `br`s out of the arm (the
                // same target as a pattern mismatch), falling through to the
                // next arm — matching asm.fern's guard semantics.
                if (arm.has_guard) {
                    ms = lower_expr(arm.guard, ms);
                    if (!ms.ok) { return ms; }
                    ms = ms.emit(ir.op_bin("not", 0, false));
                    ms = ms.emit(ir.op_brif(0));            // guard false -> skip arm
                }
                ms = lower_block(arm.body, ms);
                if (!ms.ok) { return ms; }
                ms = ms.emit(ir.op_br(1));      // matched -> exit the match
                ms = ms.emit(ir.op_end());      // end arm block
            },
            ast.PatWildcard(_) => {
                if (arm.has_guard) {
                    // A guarded wildcard `_ if <cond> =>` falls through to
                    // the next arm when the guard is false, so it needs its
                    // own block (the bare wildcard below runs unconditionally).
                    ms = ms.emit(ir.op_block(0));
                    ms = lower_expr(arm.guard, ms);
                    if (!ms.ok) { return ms; }
                    ms = ms.emit(ir.op_bin("not", 0, false));
                    ms = ms.emit(ir.op_brif(0));            // guard false -> fall through
                    ms = lower_block(arm.body, ms);
                    if (!ms.ok) { return ms; }
                    ms = ms.emit(ir.op_br(1));              // matched -> exit the match
                    ms = ms.emit(ir.op_end());
                } else {
                    ms = lower_block(arm.body, ms);
                    if (!ms.ok) { return ms; }
                    ms = ms.emit(ir.op_br(0));      // exit the match
                }
            }
        }
    }
    ms = ms.emit(ir.op_end());   // end outer block
    if (match_scrut_is_map_get(m, ms)) { ms = emit_scalar_enum_box_free(ms, scrut_slot); }
    return ms;
    return s.fail();
}

function match_scrut_is_map_get(m: ast.StmtMatch, s: LowerState): boolean {
    for arm in m.arms {
        match (arm.pattern) {
            ast.PatVariant(pv) => { if (pv.at_binding.len() > 0) { return false; } },
            _ => {}
        }
    }
    match (m.scrutinee) {
        ast.ExprCall(c) => {
            if (c.args.len() == 1) {
                match (c.callee) {
                    ast.ExprFieldAccess(fa) => {
                        if (fa.field == "get") { return is_map_type_name(expr_map_type_tag(fa.obj, s)); }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return false;
}


// arr_elem_kind classifies an array RECEIVER expression's element width for the
// value-producing `.with` / `.append` clone helpers: "i64" (i64[]/u64[], 8-byte
// integer store), "f64" (f64[], 8-byte float store), or "i32" (i32[]/string[]/
// boolean[]/u32[]/…, the 4-byte-slot default — strings and structs ride the
// pointer slot like an i32). The caller has already confirmed the receiver IS a
// leak-safe scalar / string-element array (so no array-of-struct/enum here).
function arr_elem_kind(obj: ast.Expr, s: LowerState): string {
    if (expr_is_f64arr(obj, s)) { return "f64"; }
    if (expr_is_i64arr(obj, s) || (expr_is_arr_src(obj, s) && expr_is_u64(obj, s))) { return "i64"; }
    return "i32";
}

// lower_arr_with_value lowers `obj.with(idx, val)` as a VALUE-PRODUCING
// expression: it evaluates to a FRESH array equal to `obj` with element `idx`
// replaced by `val`, leaving `obj` UNMUTATED. This is the sound counterpart to
// the in-place StmtAssign self-reassign form (`a = a.with(i, v)`): there the
// slot is the sole owner so an in-place arr_set is safe, but in expression /
// struct-field position the receiver (e.g. a borrowed `s.xs` field read) may be
// shared, so we must NOT mutate it. We CLONE the base first (arr_slice over its
// whole length — a fresh `__fern_arr_box` with rc=1, the same full-copy helper
// `a[0:a.len()]` already uses on every backend) and arr_set into the CLONE,
// which is sole-owned. The base array is read twice (slice src + length) so it
// is spilled to a scratch local; the clone is read twice (the set target, then
// re-loaded to leave it on the stack) so it too is spilled. Composed entirely of
// existing ops — every backend + eval_ops lower it for free. The element width
// follows the receiver's element kind (mirrors the reassign-self path).
pub function lower_arr_with_value(obj: ast.Expr, idx: ast.Expr, val: ast.Expr, s: LowerState): LowerState {
    var kind: string = arr_elem_kind(obj, s);
    var sw: i32 = 32;
    if (kind != "i32") { sw = 64; }
    // Spill the base once: it is the slice source AND the .len() argument.
    var bscratch: string = "$wcb" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(bscratch);
    var btmp: i32 = st.slot_of(bscratch);
    st = lower_expr(obj, st);
    if (!st.ok) { return st; }
    st = st.emit(ir.op_store_local(btmp));
    // clone = base[0 : base.len()] — a fresh, sole-owned full copy.
    st = st.emit(ir.op_load_local(btmp));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_load_local(btmp));
    st = st.emit(ir.op_arr_len());
    st = st.emit(ir.op_arr_slice(sw));
    // Spill the clone: it is the arr_set target AND the value left on the stack.
    var cscratch: string = "$wcc" + util.i32_to_string(st.locals.len());
    st = st.add_local(cscratch);
    var ctmp: i32 = st.slot_of(cscratch);
    st = st.emit(ir.op_store_local(ctmp));
    // arr_set into the CLONE (sole-owned: an in-place store is sound). Pops
    // [clone, idx, val] and pushes nothing.
    st = st.emit(ir.op_load_local(ctmp));
    st = lower_expr(idx, st);
    if (!st.ok) { return st; }
    if (kind == "i64") {
        st = lower_i64(val, st);
        if (!st.ok) { return st; }
        st = st.emit(ir.op_arr_set_i64());
    } else if (kind == "f64") {
        st = lower_expr(val, st);
        if (!st.ok) { return st; }
        st = st.emit(ir.op_arr_set(64));
    } else {
        st = lower_expr(val, st);
        if (!st.ok) { return st; }
        st = st.emit(ir.op_arr_set(32));
    }
    // Leave the fresh clone on the operand stack.
    return st.emit(ir.op_load_local(ctmp));
}

// lower_map_clone_insert lowers an ALIASED map self-reassign
// `m = m.insert(k, v)` / `m = m.set(k, v)` (#3633) as a copy-on-write. The
// builtin op_map_set mutates the map's keys[]/values[] in place; with a live
// alias (`var n = m`) that corrupts what `n` reads. So clone the map first,
// mutate the sole-owned clone, then bind it back to `m`. The clone is composed
// from existing ops — a fresh `map_new` of the same type + a copy loop over
// `m.keys()` / `m.values()` — so it is backend-agnostic and needs no new
// runtime helper (maps are i32/string K/V only, so each key/value slot is a
// uniform pointer-or-i32 width that copies correctly regardless of K/V type;
// `map_new`'s key kind comes from the annotation, not the callee). The fresh
// clone local is never aliased, so its own copy-loop inserts (and the final
// real insert) take the sound in-place path. Mirrors lower_arr_with_value
// (the array `.with` sibling, #3599); map_clone_sites decides when this runs.
function lower_map_clone_insert(target: string, recv: ast.Expr, key: ast.Expr, val: ast.Expr, maptype: string, s: LowerState): LowerState {
    var n: i32 = s.locals.len();
    var mc: string = "$mc" + util.i32_to_string(n);
    var mck: string = "$mck" + util.i32_to_string(n);
    var mcv: string = "$mcv" + util.i32_to_string(n);
    var mci: string = "$mci" + util.i32_to_string(n);
    var zero: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
    // The receiver's box before the rebind: released at the end against the
    // holders of m's alias group (#7235) when the group owns its releases.
    var mslot: i32 = s.slot_of(target);
    var moldslot: i32 = 0 - 1;
    var st: LowerState = s;
    if (mslot >= 0 && slot_is_reclaimable_map(s, mslot) && map_group_has_rows(s, s.reclaim_site_key(mslot))) {
        var mold: string = "$mold" + util.i32_to_string(n);
        st = st.add_local(mold);
        moldslot = st.slot_of(mold);
        st = st.emit(ir.op_load_local(mslot));
        st = st.emit(ir.op_store_local(moldslot));
    }
    // var $mc: <maptype> = map_new(0);  (key kind from the annotation)
    var newcall: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "map_new", line: 0, col: 0, ty: "" }, args: [zero], line: 0, col: 0, type_argc: 0, ty: "" };
    st = lower_stmt(ast.StmtVar { name: mc, type_name: maptype, init: newcall, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" }, st);
    if (!st.ok) { return st; }
    // var $mck = recv.keys();  var $mcv = recv.values();
    var keyscall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: recv, field: "keys", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    st = lower_stmt(ast.StmtVar { name: mck, type_name: "", init: keyscall, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" }, st);
    if (!st.ok) { return st; }
    var valscall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: recv, field: "values", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    st = lower_stmt(ast.StmtVar { name: mcv, type_name: "", init: valscall, line: 0, col: 0, is_str: false, fn_ret: "", fn_param_types: "" }, st);
    if (!st.ok) { return st; }
    // for $mci in 0 .. $mck.len() { $mc = $mc.insert($mck[$mci], $mcv[$mci]); }
    var mckref: ast.Expr = ast.ExprIdent { name: mck, line: 0, col: 0, ty: "" };
    var mcvref: ast.Expr = ast.ExprIdent { name: mcv, line: 0, col: 0, ty: "" };
    var mciref: ast.Expr = ast.ExprIdent { name: mci, line: 0, col: 0, ty: "" };
    var mcref: ast.Expr = ast.ExprIdent { name: mc, line: 0, col: 0, ty: "" };
    var lencall: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: mckref, field: "len", line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var range: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__range", line: 0, col: 0, ty: "" }, args: [zero, lencall], line: 0, col: 0, type_argc: 0, ty: "" };
    var insargs: ast.Expr[] = [ast.ExprIndex { array: mckref, index: mciref, unchecked: false, ty: "" }, ast.ExprIndex { array: mcvref, index: mciref, unchecked: false, ty: "" }];
    var insexpr: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: mcref, field: "insert", line: 0, col: 0, ty: "" }, args: insargs, line: 0, col: 0, type_argc: 0, ty: "" };
    var loopbody: ast.Stmt[] = [ast.StmtAssign { target: mc, value: insexpr, line: 0, col: 0, target_line: 0, target_col: 0 }];
    st = lower_stmt(ast.StmtFor { var_name: mci, iter: range, body: loopbody, label: "", line: 0 }, st);
    if (!st.ok) { return st; }
    // target = $mc.insert(key, val);  ($mc != target → generic assign; $mc is
    // unaliased so its in-place insert is sound, and the fresh clone binds to m).
    var finalins: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: mcref, field: "insert", line: 0, col: 0, ty: "" }, args: [key, val], line: 0, col: 0, type_argc: 0, ty: "" };
    st = lower_stmt(ast.StmtAssign { target: target, value: finalins, line: 0, col: 0, target_line: 0, target_col: 0 }, st);
    if (!st.ok || moldslot < 0) { return st; }
    var msite: string = st.reclaim_site_key(mslot);
    return emit_map_release_unless_held(st, moldslot, map_group_alias_slots(st, msite), map_group_tuple_holders(st, msite));
}

// lower_arr_append_value lowers `obj.append(val)` as a VALUE-PRODUCING
// expression that does NOT consume / mutate `obj`: it clones `obj` first (the
// same arr_slice full-copy as `.with`) then grows the CLONE via arr_push. Unlike
// the existing move-form `.append` (which consumes a fresh / owned receiver via
// arr_push in place), this clone form is sound when `obj` is a borrowed,
// possibly-shared array (e.g. a struct field read `s.xs`): the receiver buffer
// is never reused, only the sole-owned clone. The element width follows the
// receiver's element kind.
pub function lower_arr_append_value(obj: ast.Expr, val: ast.Expr, s: LowerState): LowerState {
    var kind: string = arr_elem_kind(obj, s);
    var sw: i32 = 32;
    if (kind != "i32") { sw = 64; }
    var bscratch: string = "$acb" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(bscratch);
    var btmp: i32 = st.slot_of(bscratch);
    st = lower_expr(obj, st);
    if (!st.ok) { return st; }
    st = st.emit(ir.op_store_local(btmp));
    // clone = base[0 : base.len()]
    st = st.emit(ir.op_load_local(btmp));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_load_local(btmp));
    st = st.emit(ir.op_arr_len());
    st = st.emit(ir.op_arr_slice(sw));
    // grow the CLONE in place (sole-owned: arr_push reuse is sound). Pops
    // [clone, val] and pushes the grown array.
    if (kind == "i64") {
        st = lower_i64(val, st);
        if (!st.ok) { return st; }
        return st.emit(ir.op_arr_push_i64());
    }
    if (kind == "f64") {
        st = lower_expr(val, st);
        if (!st.ok) { return st; }
        return st.emit(ir.op_arr_push_f64());
    }
    st = lower_append_elem_value(val, st);
    if (!st.ok) { return st; }
    // The clone (a fresh slice, cap == len) is grown immediately, so this
    // arr_push ALWAYS reallocs — and the clone is sole-owned (just sliced, no
    // alias), so reclaim the pre-grow clone instead of leaking it. This is the
    // dominant per-module self-compile leak: every `Builder { xs: s.xs.append(v) }`
    // immutable-update (the EmitState/LowerState threading) flows through here
    // (#3452 / #3425).
    return st.emit(ir.op_arr_push_owned());
}

// lower_append_elem_value lowers a pointer-width element about to be pushed
// onto an array the frame owns, with the retains a stored reference owes: a
// direct enum field read or enum alias (the source struct's __struct_drop_<T>
// decs it, #6049), a struct element that is a borrowed parameter (the caller
// still releases it, #7853), and a string element of a caller-owned string[]
// (#6644). Shared by the clone-form append and the in-place field append of an
// `own` base's reuse arm, so the two store the same reference.
function lower_append_elem_value(val: ast.Expr, s: LowerState): LowerState {
    var st: LowerState = lower_expr(val, s);
    if (!st.ok) { return st; }
    if (enum_field_read_type(val, st) != "" || enum_alias_ident_escapes(val, st)) {
        st = st.retain_tos("clone-append-elem");
    }
    if (struct_alias_ident_escapes(val, st)) {
        st = st.retain_tos("clone-append-struct-elem");
    }
    if (str_param_elem_escapes(val, st)) {
        st = st.retain_tos("clone-append-param-str-elem");
    }
    return st;
}

// emit_arr_share emits one side of an array share bracket: load `slot`, call
// the share helper, drop. Net-zero on the operand stack, so it composes either
// side of a value-producing sequence without disturbing what sits beneath. The
// bracket goes through the dedicated __fern_arr_share_inc/dec names rather than
// the plain rc pair so each backend can pick its own symbols; all three map them
// to a real retain / release (ircore.ir_helper_symbol for the register pair,
// wasm_ir's own arm for $__fern_rc_inc / $__fern_arr_dec).
pub function emit_arr_share(se: LowerState, slot: i32, helper: string): LowerState {
    var st: LowerState = se.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct(helper, 1));
    return st.emit(ir.op_drop());
}

// append_copy_recv_slot returns the receiver's slot when an EXPRESSION-position
// `xs.append(v)` must leave `xs` untouched, and -1 when it may mutate in place.
//
// arr_push CONSUMES its receiver: on the in-place fast path (sole owner, spare
// capacity) it appends into the receiver's own buffer and returns that same
// pointer. Two things then go wrong for a bare array IDENT receiver:
//
//   - VALUE (#6891). `sink(roomy.append(20))` grew `roomy` itself, so the
//     `sink(roomy)` under it read four elements where the interpreter and
//     native read three. rc==1 is not the test the fast path needs: `roomy` is
//     uniquely referenced and still READ AGAIN, and rc counts references, not
//     uses.
//   - ALIASING (#6008). Binding a NEW name to the result is two names for one
//     buffer, each carrying its own release obligation — the reassign-dec and
//     the exit sweep — so the second release frees a buffer the first name
//     still holds. `var pg: RInst[] = prog.append(ISave(…))` in std/regex's
//     __rx_emit bound the caller frame's own buffer; the freed cell was handed
//     to the next `caps.with(slot, ti)`, so the Pike VM read an ISplit's
//     targets out of a capture-slot array and branched to prog[-1].
//
// Both are closed by bracketing the receiver with a retain/release around the
// push, which raises its rc and sends arr_push down its copy path — the callers
// emit `emit_arr_share` either side. A struct-FIELD receiver dodges the whole
// question by routing to the clone form (lower_arr_append_value).
//
// The exemption is s.append_inplace (append_inplace_names_of), so the two sound
// in-place shapes keep the O(n) fast path.
function append_copy_recv_slot(recv: ast.Expr, s: LowerState): i32 {
    match (recv) {
        ast.ExprIdent(id) => {
            if (util.index_of_str(s.append_inplace, id.name) >= 0) { return 0 - 1; }
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0) { return 0 - 1; }
            if (expr_is_arr_src(recv, s) || expr_is_strarr(recv, s)
                || expr_is_f64arr(recv, s) || expr_is_i64arr(recv, s)) { return sl; }
            return 0 - 1;
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

// append_inplace_names_of returns the receiver names whose expression-position
// `.append` may stay on the in-place grow — the shapes no later intra-function
// read can observe, mirroring native's inPlacePushes (#4838):
//
//   - the self-reassign `x = x.append(v)`, whose every later read of `x` sees
//     the appended value either way (and which StmtAssign lowers itself);
//   - the accumulator tail `return acc.append(v)`, where `acc` occurs exactly
//     once in the returned expression and is not read from a lambda — after the
//     return only a closure could still see the buffer.
//
// Name-keyed for the whole function, so one occurrence in any other position
// withdraws the exemption for all of them. The return half is load-bearing:
// without it the compiler's own AST walkers (`return acc.append(id.name)` once
// per visited node) copy the whole accumulated array per append — O(n²) bytes
// in an arena that never reclaims them, which is what OOM-killed native's CI
// runners before #4838 carved the same exemption.
pub function append_inplace_names_of(fn: parser.FuncDecl): string[] {
    var total: string[] = [];
    var ti: i32 = 0;
    while (ti < fn.body.len()) { total = collect_append_recvs_stmt(fn.body[ti], total); ti = ti + 1; }
    if (total.len() == 0) { return []; }
    var esc: string[] = append_lambda_idents(fn.body, []);
    var okc: string[] = append_inplace_recvs(fn.body, esc, []);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < total.len()) {
        if (util.index_of_str(out, total[i]) < 0
            && grow_count_in(total, total[i]) == grow_count_in(okc, total[i])) {
            out = out.append(total[i]);
        }
        i = i + 1;
    }
    return out;
}

// append_lambda_idents: every ident read from inside a lambda body. A closure
// can run after the enclosing function returns, so a name it captured is still
// readable past a `return acc.append(v)`.
function append_lambda_idents(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        a = grow_lambda_idents_stmt(stmt, a);
        match (stmt) {
            ast.StmtIf(f) => {
                a = append_lambda_idents(f.then_body, a);
                a = append_lambda_idents(f.else_body, a);
            },
            ast.StmtWhile(w) => { a = append_lambda_idents(w.body, a); },
            ast.StmtFor(f2) => { a = append_lambda_idents(f2.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = append_lambda_idents(arm.body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// append_inplace_recvs collects the receiver OCCURRENCES of the two sound
// shapes, one entry per site so append_inplace_names_of can compare the count
// against collect_append_recvs_stmt's total for the same name.
function append_inplace_recvs(stmts: ast.Stmt[], esc: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var recvs: string[] = collect_append_recvs_expr(r.value, []);
                var j: i32 = 0;
                while (j < recvs.len()) {
                    if (grow_ident_count(r.value, recvs[j]) == 1
                        && util.index_of_str(esc, recvs[j]) < 0) {
                        a = a.append(recvs[j]);
                    }
                    j = j + 1;
                }
            },
            ast.StmtAssign(asg) => {
                match (asg.value) {
                    ast.ExprCall(c) => {
                        match (c.callee) {
                            ast.ExprFieldAccess(fa) => {
                                if (fa.field == "append" && c.args.len() == 1) {
                                    match (fa.obj) {
                                        ast.ExprIdent(id) => {
                                            if (id.name == asg.target) { a = a.append(id.name); }
                                        },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                a = append_inplace_recvs(f.then_body, esc, a);
                a = append_inplace_recvs(f.else_body, esc, a);
            },
            ast.StmtWhile(w) => { a = append_inplace_recvs(w.body, esc, a); },
            ast.StmtFor(f2) => { a = append_inplace_recvs(f2.body, esc, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = append_inplace_recvs(arm.body, esc, a); }
            },
            _ => {}
        }
    }
    return a;
}

// THE retain choke points (SELFHOST-RC-PLAN-PROMOTION step 1): every Perceus
// alias/escape retain lowers through one of these two, so the emission step 2
// must gate on the plan lives in one place. `site` names the producer — a
// binding's reclaim_site_key or a class tag — required and never derived
// inside, so adding a producer is a visible signature decision (#7349); the
// emitters do not read it yet. retain covers the slot idiom (load / inc /
// drop, stack-neutral); retain_tos covers the stack-top idiom (__fern_rc_inc
// returns its argument, so the operand the consuming op expects stays on
// top). Deliberately NOT routed here: the manual __rc_inc passthrough, the
// reuse emitters' runtime-conditional and donor-field retains, the enum
// ctor-payload dup and its move exemptions, the struct-lit field-override
// retain paired with move-elision bookkeeping, the closure-env capture loop,
// the element-outlives-buffer interleave, and the per-backend map_set
// vretain — each is entangled with its surrounding emission and moves in a
// later slice.
pub function (s: LowerState) retain(slot: i32, site: string): LowerState {
    var st: LowerState = s.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_inc", 1));
    return st.emit(ir.op_drop());
}

pub function (s: LowerState) retain_tos(site: string): LowerState {
    return s.emit(ir.op_call_direct("__fern_rc_inc", 1));
}

// The release choke points, same contract as retain/retain_tos: `freefn` is
// the release symbol — the memory-layout-semantic choice (__fern_rc_dec
// frees an array at data-16 where a string box's block starts at value-8;
// picking wrong is heap corruption, not a leak) — and stays a decision of
// the SITE, which knows the type. release covers the slot triple
// (load / free / drop, net-zero on the operand stack); release_zero adds
// the slot-zeroing that keeps this release site disjoint from the exit
// sweep; release_tos frees the value already on the stack top (the
// consumer or the statement's own drop follows). Guard structure —
// cow / null / is_unique / tag dispatch — is never owned here: a guarded
// site keeps its guards and routes only the emission.
pub function (s: LowerState) release(slot: i32, freefn: string, site: string): LowerState {
    var st: LowerState = s.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct(freefn, 1));
    return st.emit(ir.op_drop());
}

pub function (s: LowerState) release_zero(slot: i32, freefn: string, site: string): LowerState {
    var st: LowerState = s.release(slot, freefn, site);
    st = st.emit(ir.op_const_i32(0));
    return st.emit(ir.op_store_local(slot));
}

pub function (s: LowerState) release_tos(freefn: string, site: string): LowerState {
    return s.emit(ir.op_call_direct(freefn, 1));
}



// emit_arr_store stores the new value (on top of the operand stack) into
// `slot` with Perceus accounting, mirroring asm.fern's StmtVar / StmtAssign:
//   1. retain the new reference (rc_inc) when it ALIASES an rc-tracked array
//      (alias_inc) — a fresh literal / move-from-call is already owned;
//   2. when the slot is an OWNED array (do_dec), release the OLD value the
//      slot held — the loop-rebind reclamation. Whether that release needs the
//      cow guard depends on WHO created the count, which is what alias_inc
//      says (native states the same rule on its Map twin):
//        - alias_inc: step 1 retained the new reference, so a release is owed
//          even when old == new. `b = a` run twice is the same pointer both
//          times, and guarding the release there retains without releasing —
//          one buffer stranded per repeat (#7814). Unconditional, which also
//          subsumes the old != new arm.
//        - otherwise: cow-guarded, `if (old != new) arr_dec(old)`. An in-place
//          mutator that returned the SAME buffer created no second count, so
//          dec'ing it would free the live value.
//   3. store the new value.
// The new value is stashed in a scratch local because it is read up to three
// times (retain arg, cow compare, final store). Composed of existing ops, so
// every backend + eval_ops lower it for free.
// emit_consumed_param_store stores the value on the operand stack into a
// consumed-threaded array parameter's slot (ownflag_name), releasing what the
// slot held when this frame owned it:
//
//     if (new != old) { if (flag) rc_dec(old); flag = 1; }
//     else if (same_dec) { rc_dec(old); }
//
// A different pointer means the RHS handed the slot an owned reference — a
// grown push buffer, a fresh call result, or a retained alias — and the old one
// lost this binding: the caller's borrow while the flag is 0 (its owner still
// releases it), a superseded buffer of ours once it is 1. The same pointer from
// a self-append changes nothing; from a call it carries the callee's retain
// (rebind_call_same_dec), which the release cancels whatever the flag says. The
// release is the buffer-only __fern_rc_dec: a grown copy shares the old buffer's
// elements without retains, so an element walk here would free what the new
// buffer still holds.
function emit_consumed_param_store(se: LowerState, slot: i32, alias_inc: boolean, flag: i32, same_dec: boolean): LowerState {
    var scratch: string = "$ocp" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    if (alias_inc) { st = st.retain(tmp, "arr-store-alias"); }
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(tmp));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(flag));
    st = st.emit(ir.op_if(0));
    st = st.release(slot, "__fern_rc_dec", "consumed-param-old");
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_const_i32(1));
    st = st.emit(ir.op_store_local(flag));
    if (same_dec) {
        st = st.emit(ir.op_else());
        st = st.release(slot, "__fern_rc_dec", "consumed-param-same");
    }
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// emit_consumed_param_exit releases, at a return, every consumed-threaded array
// parameter's buffer this frame owns (flag 1) and is not handing back: a param
// named anywhere in the returned value is left alone, since the value may be
// that buffer or alias it. Net-zero on the operand stack.
//
// Being named in a RETURNED CALL is not that case. `return f(p, …)` hands back a
// result that carries its own count (rebind_call_same_dec — the same rule the
// rebind store applies one statement earlier), so the reference this frame owns
// is superseded rather than handed back, exactly as it is at `p = f(p, …)`.
// Skipping it there leaves the buffer at rc 2 with one owner, and the caller's
// next in-place append reads it as shared and copies the whole thing.
function emit_consumed_param_exit(s: LowerState, ret: ast.Expr, has_ret: boolean): LowerState {
    var st: LowerState = s;
    var ret_names: string[] = [];
    var named: boolean = false;
    var i: i32 = 0;
    while (i < st.n_params) {
        var fl: i32 = st.ownflag_slot_of(i);
        if (fl >= 0 && has_ret && !named) { ret_names = astwalk.collect_idents_expr(ret, []); named = true; }
        if (fl >= 0 && (util.index_of_str(ret_names, st.locals[i].slot_name) < 0
            || (has_ret && rebind_call_same_dec(ret, st.locals[i].slot_name, st)))) {
            st = st.emit(ir.op_load_local(fl));
            st = st.emit(ir.op_if(0));
            st = st.release(i, "__fern_rc_dec", "consumed-param-exit");
            st = st.emit(ir.op_end());
        }
        i = i + 1;
    }
    return st;
}

pub function emit_arr_store(se: LowerState, slot: i32, alias_inc: boolean, do_dec: boolean): LowerState {
    return emit_arr_store_from(se, slot, alias_inc, do_dec, false);
}

// emit_arr_store_from is emit_arr_store with the right-hand side's identity
// accounting made explicit: `same_dec` says a result equal to the slot's old
// value carries its own count (rebind_call_same_dec), so the old reference is
// released either way instead of only when the pointer changed.
pub function emit_arr_store_from(se: LowerState, slot: i32, alias_inc: boolean, do_dec: boolean, same_dec: boolean): LowerState {
    var ofl: i32 = se.ownflag_slot_of(slot);
    if (ofl >= 0) { return emit_consumed_param_store(se, slot, alias_inc, ofl, same_dec); }
    if (same_dec && do_dec && !alias_inc) {
        var sscratch: string = "$rea" + util.i32_to_string(se.locals.len());
        var sst: LowerState = se.add_local(sscratch);
        var stmp: i32 = sst.slot_of(sscratch);
        sst = sst.emit(ir.op_store_local(stmp));
        sst = sst.release(slot, "__fern_rc_dec", "arr-store-old");
        sst = sst.emit(ir.op_load_local(stmp));
        return sst.emit(ir.op_store_local(slot));
    }
    if (!alias_inc && !do_dec) {
        // No RC bookkeeping: a bare store (the common non-array case).
        return se.emit(ir.op_store_local(slot));
    }
    var scratch: string = "$rea" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    if (alias_inc) {
        st = st.retain(tmp, "arr-store-alias");
    }
    if (do_dec && alias_inc) {
        st = st.emit(ir.op_load_local(slot));      // OLD value the slot holds
        st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
        st = st.emit(ir.op_drop());
    } else if (do_dec) {
        st = st.emit(ir.op_load_local(slot));      // OLD value the slot holds
        st = st.emit(ir.op_load_local(tmp));       // new value
        st = st.emit(ir.op_bin("ne", 0, false));   // old != new (cow guard)
        st = st.emit(ir.op_if(0));
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
        st = st.emit(ir.op_drop());
        st = st.emit(ir.op_end());
    }
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// emit_str_reclaim_store stores `new` (already on the operand stack) into a
// reclaimable fresh-string slot and frees the slot's PRIOR value (the loop-rebind
// reclamation) via __fern_str_free, cow-guarded (`if old != new`) so a self-store
// never frees the live box. The string sibling of emit_arr_store, including its
// alias_inc: an aliasing bind (`var v = s`) retains the box so both slots may
// release it, and the refcount arbitrates (#7282). The first binding sees old =
// the zero-initialised slot → __fern_str_free's null guard makes it a no-op.
//
// A string box IS rc-headered on every backend, which is what licenses the
// retain. __fern_str_box allocates 24 bytes, writes rc=1 at offset 0 and hands
// back the pointer PAST it, so the count lives at -8 — the same word
// __fern_rc_inc increments and __fern_str_free reads, decrementing when it is
// above 1 and freeing only at 1. On wasm __fern_str_free maps to $__fern_arr_dec,
// which rc-guards the free the same way.
pub function emit_str_reclaim_store(se: LowerState, slot: i32, alias_inc: boolean): LowerState {
    var scratch: string = "$srea" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    if (alias_inc) {
        st = st.retain(tmp, "str-store-alias");
    }
    st = st.emit(ir.op_load_local(slot));       // OLD value the slot holds
    st = st.emit(ir.op_load_local(tmp));         // new value
    st = st.emit(ir.op_bin("ne", 0, false));     // old != new (cow guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct(str_free_helper(st, slot), 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// emit_tup_elem_releases emits a null-guarded release of each element position
// `kinds` marks (#7226) — the give-back for the construction retain in
// lower_expr's ExprTuple arm. A zeroed slot (untaken branch, or the first pass of
// a loop rebind) must skip the walk entirely: the release helpers null-guard, but
// the op_tuple_get that reaches the element dereferences the box. Emits nothing
// at all when the tuple retained no element, so a tuple of pure scalars is
// byte-identical to before.
//
// The kind picks the helper and the two are NOT interchangeable. `a` (an array /
// tuple-box element) takes __fern_rc_dec, which frees at data-16 — the arr-box
// layout. `s` (a string element) takes __fern_str_free: a string box is
// {rc@base, data@base+8, len@base+16} with the VALUE at base+8, so rc is at
// value-8 for both layouts (which is why one __fern_rc_inc retains either) but
// the block starts at value-8, not value-16. An rc_dec of a string element frees
// eight bytes below the block — heap corruption, not a leak. `.` is a position
// the construction did not retain.
function emit_tup_elem_releases(se: LowerState, slot: i32, kinds: string): LowerState {
    if (kinds.len() == 0) { return se; }
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));     // slot != 0 (null guard)
    st = st.emit(ir.op_if(0));
    var ki: i32 = 0;
    while (ki < kinds.len()) {
        if (kinds[ki] == b't') {
            st = emit_tup_struct_elem_release(st, slot, ki);
        }
        else if (kinds[ki] != b'.') {
            var helper: string = "__fern_rc_dec";
            if (kinds[ki] == b's') { helper = "__fern_str_free"; }
            st = emit_load_tuple_path(st, slot, [ki]);
            st = st.emit(ir.op_call_direct(helper, 1));
            st = st.emit(ir.op_drop());
        }
        ki = ki + 1;
    }
    return st.emit(ir.op_end());
}

// emit_tup_struct_elem_release: a struct-box element's release — the deep FIELD
// drop under __fern_rc_is_unique, then the box dec, which is the protocol the
// array family's element walk uses. The walk belongs to whichever owner finds
// rc 1; for the moved element this class records, the tuple is the only one.
// A scalar-field struct routes no field reclaim, so the gate emits nothing and
// the box dec is the whole release.
function emit_tup_struct_elem_release(se: LowerState, slot: i32, n: i32): LowerState {
    var scratch: string = "$tse" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var eslot: i32 = st.slot_of(scratch);
    st = st.mark_struct_type(eslot, st.tuple_elem_tag(slot, n));
    st = emit_load_tuple_path(st, slot, [n]);
    st = st.emit(ir.op_store_local(eslot));
    st = emit_struct_field_drops_gated(st, eslot, true);
    st = st.emit(ir.op_load_local(eslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    return st.emit(ir.op_drop());
}

// tup_kinds_rebind_safe: every retained position in `kinds` is one the
// ASSIGN-form rebind may replay against a box a DIFFERENT writer filled, with at
// least one such position.
//
// 'a' qualifies unconditionally — an array element's release is one type-fixed
// rc_dec whichever writer stored it. 's' qualifies because it is only ever
// recorded under the "TUPSTRW:" writer agreement (assigns_str_pos_owned), which
// is exactly the proof that every writer left a counted owned string there. 't'
// does not: a struct position's release is a deep field drop keyed on the var
// site's MOVE of the source, which no rebind repeats.
function tup_kinds_rebind_safe(kinds: string): boolean {
    var any: boolean = false;
    var i: i32 = 0;
    while (i < kinds.len()) {
        if (kinds[i] == b'a' || kinds[i] == b's') { any = true; }
        else if (kinds[i] != b'.') { return false; }
        i = i + 1;
    }
    return any;
}

// emit_tup_elem_reclaim_store stores `new` (already on the operand stack) into a
// reclaimable tuple slot, releasing the element retains of the box this store
// SUPERSEDES before the box itself (#7226). The tuple sibling of
// emit_str_reclaim_store, and the rebind half of the scope-exit release: a
// loop-body `var t = (i, xs)` re-binds one slot every iteration, so without this
// only the final tuple's retains are ever given back and the rest strand — the
// n-1-of-n signature. Cow-guarded (`old != new`) so a self-store never releases
// the live box, and the element walk carries its own null guard for the first
// pass, when the slot still holds its entry zero.
function emit_tup_elem_reclaim_store(se: LowerState, slot: i32, kinds: string): LowerState {
    var scratch: string = "$trea" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    st = st.emit(ir.op_load_local(slot));        // OLD value the slot holds
    st = st.emit(ir.op_load_local(tmp));         // new value
    st = st.emit(ir.op_bin("ne", 0, false));     // old != new (cow guard)
    st = st.emit(ir.op_if(0));
    st = emit_tup_elem_releases(st, slot, kinds);
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// emit_arrarr_reclaim_store stores `new` (on the operand stack) into a
// reclaimable arr-of-arr slot (#4355 slice 9) and frees the slot's PRIOR
// two-level structure (the loop-rebind reclamation) via the kind-picked
// helper (arrarr_free_helper_of), cow-guarded so a self-store never frees
// the live value. The arr-of-arr sibling of emit_str_reclaim_store; the
// first binding sees old = the zero-initialised slot → the helper's null
// guard no-ops.
function emit_arrarr_reclaim_store(se: LowerState, slot: i32): LowerState {
    var scratch: string = "$aarea" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    st = st.emit(ir.op_load_local(slot));        // OLD value the slot holds
    st = st.emit(ir.op_load_local(tmp));         // new value
    st = st.emit(ir.op_bin("ne", 0, false));     // old != new (cow guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct(arrarr_free_helper_of(st, slot), 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// emit_strarr_reclaim_store stores `new` (on the operand stack) into a
// reclaimable string[] LOOP-LOCAL (#4353 item 4) and frees the slot's PRIOR
// value — the ELEMENT strings AND the buffer — via the slot's element-walking
// helper (strarr_free_helper) before the store (the loop-rebind reclamation),
// cow-guarded so a self-store never frees the live value. The string[] sibling
// of emit_arrarr_reclaim_store, and the per-iteration counterpart of the exit
// sweep's string[] reclaim (16565, same helper); the first binding sees old =
// the zero-initialised slot → the null guard no-ops. Without this a re-declared
// `var xs: string[]` per iteration took the shallow emit_arr_store dec (buffer
// only) and leaked every element string.
//
// alias_inc: an aliasing bind (`var v: string[] = xs`) retains the shared
// buffer so both slots may release it and the refcount arbitrates (#7391),
// exactly as emit_str_reclaim_store does for a string box. Without it a
// credited alias routes here instead of emit_arr_store and the retain the
// bind computed is dropped on the floor.
function emit_strarr_reclaim_store(se: LowerState, slot: i32, alias_inc: boolean): LowerState {
    var scratch: string = "$sarea" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    if (alias_inc) {
        st = st.retain(tmp, "strarr-store-alias");
    }
    st = st.emit(ir.op_load_local(slot));        // OLD value the slot holds
    st = st.emit(ir.op_load_local(tmp));         // new value
    st = st.emit(ir.op_bin("ne", 0, false));     // old != new (cow guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct(strarr_free_helper(st, slot), 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// lower_strarr_with_store lowers the self-rebind `a = a.with(i, v)` on a
// reclaimable string[] slot as a REFERENCE-CORRECT in-place element store:
// retain `v` (unless it is a fresh temp the frame already owns), release the
// element `i` currently holds unless it IS `v`, then arr_set. Without the
// release the overwritten box leaks; without the retain a `v` that aliases
// another element leaves two slots sharing one reference and the exit sweep's
// element walk frees it twice.
function lower_strarr_with_store(idx: ast.Expr, val: ast.Expr, slot: i32, s: LowerState): LowerState {
    var iname: string = "$swi" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(iname);
    var islot: i32 = st.slot_of(iname);
    var vname: string = "$swv" + util.i32_to_string(st.locals.len());
    st = st.add_local(vname);
    var vslot: i32 = st.slot_of(vname);

    st = lower_expr(idx, st);
    if (!st.ok) { return st; }
    st = st.emit(ir.op_store_local(islot));

    var val_fresh: boolean = is_fresh_str_temp(val, st);
    st = lower_expr(val, st);
    if (!st.ok) { return st; }
    if (!val_fresh) { st = st.retain_tos("strarr-with-elem"); }
    st = st.emit(ir.op_store_local(vslot));

    // release the superseded element unless the store is a self-store
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(islot));
    st = st.emit(ir.op_arr_get(32));
    st = st.emit(ir.op_load_local(vslot));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(islot));
    st = st.emit(ir.op_arr_get(32));
    st = st.emit(ir.op_call_direct(strarr_elem_free_helper(st, slot), 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());

    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(islot));
    st = st.emit(ir.op_load_local(vslot));
    return st.emit(ir.op_arr_set(32));
}

// emit_arrstruct_with_store lowers `ps = ps.with(i, v)` for a slot whose ELEMENT
// WALK is credited (slot_is_reclaimable_arrstruct). The struct sibling of
// lower_strarr_with_store, and it exists for the same reason: `with` REPLACES, so
// the bare arr_set drops the superseded element pointer on the floor and the exit
// sweep's walk never sees it again.
//
// Three steps, in this order:
//   - retain the stored element when the container OWNS it and the store does not
//     MOVE it, exactly as the self-append arm does — the stamp says who owns the
//     element, the move analysis says whether this store had to pay for it;
//   - release the superseded element, guarded on `old != new` so `ps.with(3, ps[5])`
//     does not free a live one, and on `old != 0` for a never-written slot. Its
//     field walk is rc-GATED: with the stored element counted, two owners can reach
//     a walk, and two static walks free every field buffer twice (allocs == frees at
//     live_bytes 0, only __rc_underflow_count() dissenting);
//   - store the new element.
//
// NOT reached on the cow path: an aliased or borrowed receiver routes to
// lower_arr_with_value ABOVE this, which clones into a sole-owned buffer and leaves
// the aliased one holding the old element — releasing it there would free a value
// the original array still reads.
function emit_arrstruct_with_store(idx: ast.Expr, val: ast.Expr, slot: i32, sty: string, s: LowerState): LowerState {
    var iname: string = "$awi" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(iname);
    var islot: i32 = st.slot_of(iname);
    var vname: string = "$awv" + util.i32_to_string(st.locals.len());
    st = st.add_local(vname);
    var vslot: i32 = st.slot_of(vname);
    var oname: string = "$awo" + util.i32_to_string(st.locals.len());
    st = st.add_local(oname);
    var oslot: i32 = st.slot_of(oname);
    st = st.mark_struct_type(oslot, sty);            // so the gated walk routes __struct_drop_<sty>

    st = lower_expr(idx, st);
    if (!st.ok) { return st; }
    st = st.emit(ir.op_store_local(islot));

    st = lower_expr(val, st);
    if (!st.ok) { return st; }
    match (val) {
        ast.ExprIdent(vid) => {
            var velslot: i32 = st.slot_of(vid.name);
            if (velslot >= 0
                && reclaim_has(st.reclaimable_names, "APOWNED:",
                    util.i32_to_string(vid.line) + ":" + util.i32_to_string(vid.col))) {
                if (st.moves_local_at(vid.name, vid.line, vid.col)) { st = st.note_moved_elided(velslot); }
                else { st = st.retain_tos("arrstruct-with-elem"); }
            }
        },
        _ => {}
    }
    st = st.emit(ir.op_store_local(vslot));

    // old = ps[i]
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(islot));
    st = st.emit(ir.op_arr_get(32));
    st = st.emit(ir.op_store_local(oslot));
    // if (old != 0 && old != new) { <gated field walk>; dec old }
    st = st.emit(ir.op_load_local(oslot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(oslot));
    st = st.emit(ir.op_load_local(vslot));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = emit_struct_field_drops_gated(st, oslot, true);
    st = st.emit(ir.op_load_local(oslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_end());

    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(islot));
    st = st.emit(ir.op_load_local(vslot));
    return st.emit(ir.op_arr_set(32));
}

// emit_snapshot_store stores `new` (on the operand stack) into a SNAPSHOT param
// slot (#3456 slice 2) and frees the OLD box only when it differs from BOTH the
// new value (cow) AND the entry snapshot at `snap_slot` (the caller's original).
// The conditional free lives in the runtime helper __fern_snapshot_dec(new, old,
// snap) -> new (rc-guarded SHALLOW box release, pass-through of `new`) — keeping
// it a 4-op call site instead of ~16 inline ops, because a builder has hundreds
// of rebinds and the inline ops (each rebuilding LowerState) OOM the native
// driver's emit of large modules. `new` is already on the stack (arg0, deepest).
function emit_snapshot_store(se: LowerState, slot: i32, snap_slot: i32): LowerState {
    var st: LowerState = se.emit(ir.op_load_local(slot));        // old (arg1)
    st = st.emit(ir.op_load_local(snap_slot));                   // snap (arg2)
    st = st.emit(ir.op_call_direct("__fern_snapshot_dec", 3));   // frees old; returns new
    return st.emit(ir.op_store_local(slot));
}

// struct_has_reclaim_array_field reports whether struct type `sty` has at least
// one rc-tracked ARRAY field — a scalar-element array (i32[]/u32[]/f64[]/…), an
// array-of-struct, or an array-of-enum field. These are exactly the fields whose
// BUFFER the per-type field-reclaim helper shallow-frees on a consume-rebind, so
// this is the gate that picks `__field_reclaim_<T>` over the scalar-only
// `__fern_snapshot_dec` / the plain box `__fern_rc_dec`. Also admits a struct
// carrying a DIRECT nested-struct field or (since #4297 A2) a DIRECT enum field,
// each SHALLOW-reclaimed one level by __struct_drop's k_struct / k_enum arm.
// (string / map / option / tuple fields are still NOT reclaimed — they leak with
// the struct, sound.)
pub function struct_has_reclaim_array_field(structs: parser.StructDecl[], sty: string): boolean {
    if (sty.len() == 0) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var fdt: string = decl_field_type_at(structs, sty, fi);
        if (is_leaksafe_array_field(fdt)) { return true; }
        if (is_struct_array_field_type(structs, fdt)) { return true; }
        if (is_enum_array_field_type(structs, fdt)) { return true; }
        // A DIRECT nested-struct field (`inner: Inner`) is now SHALLOW-reclaimed
        // (emit_ir_struct_drop_one's k_struct), so a struct carrying one needs its
        // exit drop emitted too — admit it to the reclaim set (the construction
        // alias-inc in the ExprStructLit lowering keeps it balanced).
        if (decl_is_struct(structs, fdt)) { return true; }
        // A DIRECT enum field (`e: MyEnum`) is now SHALLOW-reclaimed too
        // (emit_ir_struct_drop_one's k_enum → arr_dec of the enum box, one level —
        // the variant payload leaks, matching the k_struct gap). Admit it so the
        // struct's __struct_drop is emitted; the construction alias-inc balances the
        // dec. #4297 A2.
        if (decl_is_enum(structs, fdt)) { return true; }
        fi = fi + 1;
    }
    return false;
}

// struct_has_droppable_enum_field reports whether struct `sty` has ≥1 DIRECT enum
// field (`e: MyEnum`) whose every variant is rc-droppable (enum_all_variants_rc_
// droppable — the deep-drop of the variant payload is well-defined: each rc field
// is a leak-safe array / string / deep-drop-ok leaf struct, no cycle-risk payload).
// This is the eligibility signal for the enum-field DEEP loop-rebind reclaim
// (emit_struct_enum_deep_reinit_store) — it deep-drops the enum field's variant
// payload (not just the shallow enum-box dec the exit sweep's k_enum arm emits).
pub function struct_has_droppable_enum_field(structs: parser.StructDecl[], sty: string): boolean {
    if (sty.len() == 0) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(structs, sty, fi);
        if (decl_is_enum(structs, ft) && enum_all_variants_rc_droppable(structs, ft)) { return true; }
        fi = fi + 1;
    }
    return false;
}

// struct_enum_deep_reinit_eligible reports whether struct `sty` is admissible for the
// enum-field DEEP loop-rebind reclaim: it carries ≥1 droppable enum field AND EVERY
// other field is a flat SCALAR (reuse_field_is_scalar). Keeping the first cut to
// scalar + enum fields means the rebind emitter deep-drops only the enum payload(s)
// and frees the box — no array / string / nested-struct field to also reclaim (a
// struct mixing an enum field with an array field falls through to the array-only
// __field_reclaim path, which leaks the enum payload but never over-releases). A
// pure-scalar struct (no enum field) returns false via struct_has_droppable_enum_field.
function struct_enum_deep_reinit_eligible(structs: parser.StructDecl[], sty: string): boolean {
    if (!struct_has_droppable_enum_field(structs, sty)) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(structs, sty, fi);
        var ok: boolean = reuse_field_is_scalar(ft) || (decl_is_enum(structs, ft) && enum_all_variants_rc_droppable(structs, ft));
        if (!ok) { return false; }
        fi = fi + 1;
    }
    return true;
}

// struct_lit_all_enum_fields_fresh reports whether EVERY enum-typed field of the
// struct literal `slit` is set from a FULLY-FRESH sole-owner variant constructor of
// that exact enum — fresh_rcpayload_enum_init: a `V(args)` / bare `V` of the field's
// declared enum whose array payloads ride the construction alias-inc AND whose
// deep-drop-ok STRUCT payloads are fresh struct literals AND whose STRING payloads are
// fresh literals/producers (variant_struct_payloads_fresh). Only then is the enum
// field's box AND every rc payload one level down provably SOLE-OWNED by this struct
// (rc=1, no construction alias-inc — see the ExprStructLit lowering's fresh-variant-
// ctor hand-over), so deep-dropping it at the loop-rebind is balanced. A NON-fresh enum
// field (a bare enum local/param, a field copy, an enum-returning call) — OR a fresh
// ctor whose struct/string payload ALIASES a live local — is rejected here and falls
// through to the leak-safe shallow path (freeing an aliased payload would double-free,
// the exact hazard variant_struct_payloads_fresh guards). Non-enum field positions are
// skipped.
function struct_lit_all_enum_fields_fresh(structs: parser.StructDecl[], slit: ast.ExprStructLit): boolean {
    var i: i32 = 0;
    while (i < slit.field_names.len()) {
        var ft: string = decl_field_type(structs, slit.type_name, slit.field_names[i]);
        if (decl_is_enum(structs, ft)) {
            if (fresh_rcpayload_enum_init(slit.field_values[i], structs, [], [], false) != ft) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// struct_has_string_field reports whether struct `sty` has a bare `string` field.
// __struct_drop's k_str arm frees such a field (rc-aware __fern_str_free), but only
// when the field's constructed value is provably FRESH (sole-owned) — an ALIASED
// bare-ident string field is retained by the caller, so freeing it double-releases
// (the two-alias case). struct_lit_all_string_fields_fresh proves that per-site.
pub function struct_has_string_field(structs: parser.StructDecl[], sty: string): boolean {
    if (sty.len() == 0) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        if (decl_field_type_at(structs, sty, fi) == "string") { return true; }
        fi = fi + 1;
    }
    return false;
}

// struct_lit_all_string_fields_fresh reports whether EVERY `string`-typed field of
// a struct literal is set from a FRESH, sole-owned heap string (expr_is_fresh_str
// — a concat / fresh-producer call, NOT a bare ident / field copy / view). Only
// then is deep-dropping the string field balanced (rc=1 → freed once), so the
// literal's box can ride emit_struct_deep_reinit_store's __struct_drop. A non-fresh
// string field would be retained by an aliasing owner, so freeing it over-releases
// (the strdrop-two-alias case). Missing / non-string field positions are skipped;
// a struct with no string field returns true (vacuous — the caller pairs this with
// struct_has_string_field).
function struct_lit_all_string_fields_fresh(structs: parser.StructDecl[], slit: ast.ExprStructLit, s: LowerState): boolean {
    var i: i32 = 0;
    while (i < slit.field_names.len()) {
        if (decl_field_type(structs, slit.type_name, slit.field_names[i]) == "string") {
            if (!expr_is_fresh_str(slit.field_values[i], s)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// struct_copy_eligible reports whether a functional update `T { ...base, f: v }`
// of struct `sty` may lower its BASE COPY through the compact op_struct_copy path
// (one `call __fn___fern_struct_copy` per site) instead of the inline per-field
// struct_get/store fan-out (#4650 — the self-host compiler's working set on the
// x86_encode/x86_gas encoders otherwise OOMs the wasm driver). struct_copy is a
// SHALLOW word-for-word box copy: it shares every field pointer with no rc-inc,
// exactly like the inline base-copy path leaves array fields "as-is". So it is
// admissible ONLY when the inline path would ALSO emit no per-field retain on the
// copied fields — i.e. the struct carries no field that the base-copy arm inc's:
//   - a DIRECT nested-struct field (retained, k_struct drop) — excluded,
//   - a DIRECT enum field (retained, k_enum drop) — excluded,
//   - a bare `string` field (retained on a reclaimable struct) — excluded.
// Array / string[] / map / option / tuple / scalar fields are copied with no inc
// on both paths, so they are fine. 8-byte SCALAR fields (i64 / u64 / f64) are two
// 4-byte slots on wasm, whereas the copy helper is slot-count driven off the field
// COUNT; keep the first cut to fields that occupy exactly one slot per backend so
// the word/slot copy is unambiguous (the encoders are all i32 + array fields). An
// override on any admitted field lowers to op_struct_set (4-byte / pointer store).
pub function struct_copy_eligible(structs: parser.StructDecl[], sty: string): boolean {
    if (!decl_is_struct(structs, sty)) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    if (n == 0) { return false; }
    var fi: i32 = 0;
    while (fi < n) {
        var t: string = decl_field_type_at(structs, sty, fi);
        if (decl_is_struct(structs, t)) { return false; }
        if (decl_is_enum(structs, t)) { return false; }
        if (t == "string") { return false; }
        if (t == "i64" || t == "u64" || t == "f64") { return false; }
        fi = fi + 1;
    }
    return true;
}

// struct_is_scalar_only reports whether struct type `sty` has ONLY flat scalar
// fields (i32 / boolean / i64 / f64 / u32 / u64) — no rc-tracked field of any
// kind (no array, string, nested struct, enum, map, option, tuple). Such a
// struct's box carries no pointer to walk, so its reclamation is a single shallow
// box free (__fern_rc_dec) with no deep-drop helper. This is the precise-drop
// admission set for a fresh scalar-only struct LOCAL: freeing the box early
// cannot dangle any field reference (there are none). Empty / unknown structs
// return false (nothing to admit).
function struct_is_scalar_only(structs: parser.StructDecl[], sty: string): boolean {
    if (sty.len() == 0) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    if (n == 0) { return false; }
    var fi: i32 = 0;
    while (fi < n) {
        if (!reuse_field_is_scalar(decl_field_type_at(structs, sty, fi))) { return false; }
        fi = fi + 1;
    }
    return true;
}

// nested_field_deep_drop_ok reports whether a DIRECT nested-struct field of type
// `sty` is safe to DEEP-drop — i.e. its drop site may recursively release `sty`'s
// OWN rc fields (via __struct_drop_<sty>) before freeing the inner box, instead of
// the shallow box-only free. True iff `sty`'s nested-struct-field closure is
// ACYCLIC and reaches at least one rc-ARRAY field to reclaim.
//
// ACYCLICITY is the CYCLE-SAFETY guarantee: __struct_drop_<sty>'s emitted body
// recurses `call __struct_drop_<fdt>` for each nested-struct field fdt admitted by
// THIS predicate, so the emitted call graph edge sty→fdt exists iff fdt is itself
// deep-drop-ok. If every type's nested-struct closure is acyclic, that call graph
// is a DAG and the runtime recursion terminates (bounded by the number of distinct
// struct types — a type cannot recur on the chain without a cycle). A back-edge
// (sty reachable from fdt) poisons the whole ancestor chain: nddo_reach returns the
// CYCLIC sentinel, so the field stays SHALLOW — a self-referential / mutually-
// recursive struct (tree / linked list, admitted leak-safe by decl_is_leaksafe's
// back-edge rule) keeps the existing one-level box-only reclaim, leak-safe.
//
// This generalises the former LEAF-only rule (depth-1, no nested-struct field) to
// arbitrary acyclic depth: `A { b: B }` / `B { c: C }` / `C { xs: i32[] }` now
// deep-drops all the way down (A's drop releases B's box AND, transitively, C's xs
// buffer), reusing the per-level rc_is_unique guard the leaf case already applied.
// Strings / enum / Option / tuple inner fields are still not reclaimed (decl_is_struct
// is false for them), so a struct reaching only those (no array) returns false.
pub function nested_field_deep_drop_ok(structs: parser.StructDecl[], sty: string): boolean {
    if (sty.len() == 0) { return false; }
    var visiting: string[] = [];
    return nddo_reach(structs, sty, visiting) == 1;
}

// nddo_reach is the cycle-detecting DFS behind nested_field_deep_drop_ok. It returns
//   -1  a cycle is reachable from `sty` (a back-edge to a struct on the current path,
//       or the depth backstop) — UNSAFE to deep-drop, and poisons every ancestor;
//    1  `sty`'s closure is acyclic AND reaches a RECLAIMABLE field — an rc-ARRAY or,
//       since #4297 A2, a `string` field (deep-drop-worthy);
//    0  `sty`'s closure is acyclic but reaches nothing reclaimable.
// `visiting` is the set of struct types on the current recursion path (the same
// back-edge mechanism as decl_is_leaksafe_d). A direct rc-array / string field sets
// the reclaimable flag; a nested-struct field recurses (its cycle poisons via -1,
// its reclaimable content propagates up). Deep-dropping a nested string-only struct
// is sound: the deep-drop is rc_is_unique-gated, so a SHARED nested struct skips it
// (no over-release), and a uniquely-owned one runs its own __struct_drop whose k_str
// arm reclaims the string exactly as at top level (the construction alias-inc
// balances a non-fresh field; a fresh field is freed).
function nddo_reach(structs: parser.StructDecl[], sty: string, visiting: string[]): i32 {
    if (util.has_str(visiting, sty)) { return 0 - 1; }   // back-edge → cycle → unsafe
    if (visiting.len() > 16) { return 0 - 1; }            // depth backstop → treat as unsafe
    var nv: string[] = visiting.append(sty);
    var n: i32 = decl_field_count(structs, sty);
    var has_arr: boolean = false;
    var fi: i32 = 0;
    while (fi < n) {
        var fdt: string = decl_field_type_at(structs, sty, fi);
        if (decl_is_struct(structs, fdt)) {
            var r: i32 = nddo_reach(structs, fdt, nv);
            if (r < 0) { return 0 - 1; }   // a cycle below poisons this struct too
            if (r == 1) { has_arr = true; }
        } else if (is_leaksafe_array_field(fdt) || is_struct_array_field_type(structs, fdt) || is_enum_array_field_type(structs, fdt)) {
            has_arr = true;
        } else if (fdt == "string") {
            has_arr = true;   // #4297 A2: a string field is reclaimable (k_str drop)
        }
        fi = fi + 1;
    }
    if (has_arr) { return 1; }
    return 0;
}

// emit_field_reclaim_store stores `new` (already on the operand stack) into a
// reclaimable struct slot (#3457 field-level move tracking) AND frees the REPLACED
// array-field buffers of the OLD box before shallow-freeing the old box itself.
// The conditional per-field free + box free live in the per-type runtime helper
// __field_reclaim_<T>(new, old, snap) -> new: for each array field i it frees
// old.field[i] iff it differs from BOTH new.field[i] (cow — the field new still
// owns) AND snap.field[i] (the caller's original, when snap != 0), then frees the
// old box (the __fern_snapshot_dec tail). A per-type helper, never inline: a
// builder has hundreds of rebinds and inlining ~16 ops × the field count at each
// would OOM the native driver's emit of the large modules (#3452). `snap_slot`
// >= 0 names the snapshot slot — a snapshot PARAM's entry copy, or the box a
// snapshot LOCAL was derived from (seed_snapshot_local) — and a field or box
// equal to it is left alone; < 0 is a local with no source (the helper is passed
// snap=0, so only the != new guard applies).
//
// rc-GATED on the OLD BOX. The helper's per-field guards compare against `new`
// and `snap`; neither says whether a SECOND OWNER holds the old box, and freeing
// a shared box's field buffers is a use-after-free rather than a leak — an
// element appended into a container and then rebound (`ps = ps.append(p);
// p = P { … }`) had the container reading buffers this store had freed. So the
// whole reclaim runs only for the sole owner; a shared old box takes the
// box-only path: this slot gives up its counted reference (__fern_rc_dec) so
// the surviving owner reaches rc 1 and does the deep work — unless the old box
// IS the snapshot, held uncounted, which gets neither.
function emit_field_reclaim_store(se: LowerState, slot: i32, sty: string, snap_slot: i32): LowerState {
    var scratch: string = "$frs" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));                        // stash new
    st = st.emit(ir.op_load_local(slot));                        // old
    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));   // sole owner (and null-safe)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(tmp));                         // new (arg0)
    st = st.emit(ir.op_load_local(slot));                        // old (arg1)
    if (snap_slot >= 0) {
        st = st.emit(ir.op_load_local(snap_slot));              // snap (arg2)
    } else {
        st = st.emit(ir.op_const_i32(0));                       // snap = null (local reclaim)
    }
    st = st.emit(ir.op_call_direct("__field_reclaim_" + sty, 3));   // frees replaced fields + box; returns new
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_else());
    // Shared, and this slot is about to stop pointing at it: hand back the
    // count. Cow-guarded, because a self-store (`p = f(p)` returning the same
    // box) must keep it, and never the snapshot — the caller's box is held
    // uncounted. Shallow — the fields belong to whoever finds rc 1.
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(tmp));
    st = st.emit(ir.op_bin("ne", 0, false));
    if (snap_slot >= 0) {
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_load_local(snap_slot));
        st = st.emit(ir.op_bin("ne", 0, false));
        st = st.emit(ir.op_bin("and", 0, false));
    }
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));                         // new
    return st.emit(ir.op_store_local(slot));
}

// emit_struct_deep_reinit_store stores `new` (on the operand stack) into a
// reclaimable struct slot and DEEP-drops the OLD box first — __struct_drop_<T>
// releases ALL of old's rc fields (arrays via the is_unique-gated k_arr/k_box
// walk, STRINGS via k_str's rc-aware __fern_str_free, nested via k_struct), then
// __fern_rc_dec frees the old box. Unlike emit_field_reclaim_store (arrays only,
// per-field cow-walk) this reclaims the STRING field too. Used only when the caller
// proves the init is a fresh no-base struct literal whose string fields are all
// FRESH (struct_lit_all_string_fields_fresh) — so old's string is sole-owned
// (rc=1) and freeing it is balanced (no aliasing owner). __struct_drop and
// __fern_rc_dec both null-guard, so the first-iteration null `old` is a no-op; the
// whole-box cow guard (`old != new`) skips a self-store. The scratch stashes `new`.
function emit_struct_deep_reinit_store(se: LowerState, slot: i32, sty: string): LowerState {
    var scratch: string = "$sdr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = st.emit(ir.op_load_local(slot));            // old
    st = st.emit(ir.op_load_local(tmp));             // new
    st = st.emit(ir.op_bin("ne", 0, false));         // old != new (cow guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));            // old
    st = st.emit(ir.op_call_direct("__struct_drop_" + sty, 1));   // deep-drop old's rc fields (null-guarded); returns box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_load_local(slot));            // old
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));          // free old box (null-guarded)
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// emit_struct_enum_deep_reinit_store stores `new` (on the stack) into a reclaimable
// struct slot whose only rc-tracked fields are DIRECT enum fields (struct_enum_deep_
// reinit_eligible: scalar + droppable-enum fields only) and DEEP-drops the OLD box:
// for each enum field it extracts the field's enum box into a scratch local and runs
// emit_enum_variant_drops on it (runtime variant dispatch → drop the variant's rc
// payload, then free the enum box), THEN __fern_rc_dec frees the struct box itself.
// Unlike the array-only __field_reclaim path (emit_field_reclaim_store), this reclaims
// the enum field's VARIANT PAYLOAD — the leak the shallow k_enum exit-drop leaves.
//
// SOUNDNESS: fires ONLY when the init is a fresh no-base struct literal whose enum
// fields are all FRESH variant ctors (struct_lit_all_enum_fields_fresh), so each
// enum box + its payload is the struct box's sole owner (rc=1, no construction alias-
// inc). A non-fresh (aliased) enum field is rejected at the gate and rides the leak-
// safe shallow path. Null-guarded (`old != 0`) for the first-iteration zeroed slot;
// the fresh literal makes old != new implicit, so no separate cow guard is needed.
// The enum field box is itself null-guarded (op_variant_is reads the tag, so it would
// fault on a null box) — a fresh literal always sets it, but the guard is defensive.
// The once-per-program EXIT sweep still shallow-drops the FINAL box's enum field
// (payload leaks once, bounded — the fixpoint stays flat across N). #4357.
function emit_struct_enum_deep_reinit_store(se: LowerState, slot: i32, sty: string): LowerState {
    var scratch: string = "$sedr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = st.emit(ir.op_load_local(slot));            // old struct box
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    var n: i32 = decl_field_count(st.structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(st.structs, sty, fi);
        if (decl_is_enum(st.structs, ft) && enum_all_variants_rc_droppable(st.structs, ft)) {
            var esc: string = "$edf" + util.i32_to_string(st.locals.len());
            st = st.add_local(esc);
            var etmp: i32 = st.slot_of(esc);
            st = st.emit(ir.op_load_local(slot));                                       // old struct box
            st = st.emit(ir.op_struct_get(fi, struct_field_width(st.structs, sty, fi))); // enum box
            st = st.emit(ir.op_store_local(etmp));                                      // stash enum box
            st = st.emit(ir.op_load_local(etmp));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_bin("ne", 0, false));                                    // enum box != 0
            st = st.emit(ir.op_if(0));
            st = emit_enum_variant_drops(st, etmp, ft);                                 // deep-drop payload + free enum box (zeroes etmp)
            st = st.emit(ir.op_end());
        }
        fi = fi + 1;
    }
    st = st.emit(ir.op_load_local(slot));            // old struct box
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));   // free the struct box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// path_child returns a FRESH array = a copy of `path` with `k` appended. It never
// mutates `path`. This matters because the tuple deep-drop recursions call the
// child-path builder TWICE per nested element (once to recurse, once to reload the
// box), and Perceus REUSE makes a plain `path.append(k)` on a uniquely-owned array
// mutate the buffer IN PLACE on the compiled backends — so two `path.append(k)`
// calls on the same `path`, plus the recursion's own appends, aliased and corrupted
// the deep path (a leak on 3+-level nesting that the AST interpreter — which appends
// functionally — never exhibited; #4810 nested-tuple-deep). Copying into a fresh
// `out` each call removes the aliasing: `path` is only read, never appended to.
function path_child(path: i32[], k: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < path.len()) { out = out.append(path[i]); i = i + 1; }
    return out.append(k);
}

// emit_load_tuple_path loads the tuple box in `slot` and chains op_tuple_get
// for each index in `path`, leaving the value reached by that path on the
// stack (a pointer for an array / nested-tuple element, since tuple elements
// are pointer-width slots). An empty path leaves the box itself. Reads `path`
// only (no mutation).
function emit_load_tuple_path(st: LowerState, slot: i32, path: i32[]): LowerState {
    var s: LowerState = st.emit(ir.op_load_local(slot));
    var i: i32 = 0;
    while (i < path.len()) { s = s.emit(ir.op_tuple_get(path[i])); i = i + 1; }
    return s;
}

// emit_tuple_child_drops recursively frees the rc children of the tuple literal
// `tup` reached from `slot` by `path` (a chain of op_tuple_get indices): a
// direct ExprArray child's buffer is arr_dec'd, and a NESTED tuple-literal child
// has its own children freed CHILDREN-FIRST then its box arr_dec'd (a fresh
// nested tuple box is sole-owned, so freeing it is balanced). A scalar child is
// skipped — it carries no pointer. A BARE-IDENT child is released through
// tuple_union_arg_freefn, the same resolver the union-payload site uses and for
// the same reason: lower_expr's ExprTuple arm rc_inc's an element naming an
// rc-container local, so this dec spends the BOX's reference and the local's own
// sweep still finds a valid buffer. The resolver answers "" for the ident shapes
// whose release needs more than the slot's array-ness (a string[] element, a
// string local with no "STR:" credit), which keeps those on the leak side rather
// than the over-release side. The depth-first order means an inner array is freed
// before its enclosing box, so no read chases through an already-freed box.
function emit_tuple_child_drops(st: LowerState, slot: i32, path: i32[], tup: ast.ExprTuple): LowerState {
    var s: LowerState = st;
    var k: i32 = 0;
    while (k < tup.elements.len()) {
        match (tup.elements[k]) {
            ast.ExprArray(_) => {
                // A string-ARRAY position whose every element is fresh
                // (tuple_strarr_elem_fresh) owns its element boxes too, so it takes
                // the element-walking free; any other array position keeps the
                // shallow buffer dec, which leaves an aliased element untouched.
                var afree: string = "__fern_rc_dec";
                if (tuple_strarr_elem_fresh(tup.elements[k])) { afree = "__fern_str_arr_free"; }
                s = emit_load_tuple_path(s, slot, path_child(path, k));   // array ptr
                s = s.emit(ir.op_call_direct(afree, 1));
                s = s.emit(ir.op_drop());
            },
            // A string element (#4353 item 1): tuple construction str_box's
            // every string element into a FRESH copy — literal or produced —
            // so the tuple box sole-owns it and the rc-aware __fern_str_free
            // (immortal skips, shared decs, unique frees) is exactly balanced.
            ast.ExprString(_) => {
                s = emit_load_tuple_path(s, slot, path_child(path, k));   // string ptr
                s = s.emit(ir.op_call_direct("__fern_str_free", 1));     // rc-aware free
                s = s.emit(ir.op_drop());
            },
            ast.ExprBinary(_) => {
                if (tuple_str_elem_fresh_reg(tup.elements[k], s.sigs.str_fresh_ret_fns)) {
                    s = emit_load_tuple_path(s, slot, path_child(path, k));   // string ptr
                    s = s.emit(ir.op_call_direct("__fern_str_free", 1));     // rc-aware free
                    s = s.emit(ir.op_drop());
                }
            },
            ast.ExprCall(_) => {
                if (tuple_str_elem_fresh_reg(tup.elements[k], s.sigs.str_fresh_ret_fns)) {
                    s = emit_load_tuple_path(s, slot, path_child(path, k));   // string ptr
                    s = s.emit(ir.op_call_direct("__fern_str_free", 1));     // rc-aware free
                    s = s.emit(ir.op_drop());
                } else if (tuple_union_elem_fresh(tup.elements[k], s)) {
                    // A freshly CONSTRUCTED tagged union at an element position —
                    // a built-in Some/Ok/Err box or a user-enum variant. The box
                    // is [tag, payload], allocated by this construction and
                    // aliased nowhere, so the shallow dec is balanced.
                    s = emit_tuple_union_elem_drop(s, slot, path_child(path, k), tup.elements[k]);
                }
            },
            ast.ExprIdent(_) => {
                var ifree: string = tuple_union_arg_freefn(tup.elements[k], s);
                if (ifree != "") {
                    s = emit_load_tuple_path(s, slot, path_child(path, k));
                    s = s.emit(ir.op_call_direct(ifree, 1));
                    s = s.emit(ir.op_drop());
                }
            },
            ast.ExprTuple(inner) => {
                var cp: i32[] = path_child(path, k);
                s = emit_tuple_child_drops(s, slot, cp, inner);          // free inner's children first
                s = emit_load_tuple_path(s, slot, cp);                   // inner box ptr
                s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));       // free the inner tuple box
                s = s.emit(ir.op_drop());
            },
            ast.ExprStructLit(slit) => {
                // A fresh STRUCT-literal element (`(i, P { xs: [..] })`, #4365): the struct box
                // sole-owns its rc-array field buffers. Deep-drop the struct's fields
                // (__struct_drop_<P>, balanced by the construction alias-inc) then free the box.
                // Inert on existing rc-tuples (they carry no struct-lit element); admission
                // (tuple_lit_rc_reclaimable) only credits a tuple whose struct element routes
                // field-reclaim.
                var cps: i32[] = path_child(path, k);
                var hn: string = "$tsx" + util.i32_to_string(s.locals.len());
                s = s.add_local(hn);
                var hslot: i32 = s.slot_of(hn);
                s = s.mark_struct_type(hslot, slit.type_name);
                s = emit_load_tuple_path(s, slot, cps);                  // struct box ptr
                s = s.emit(ir.op_store_local(hslot));
                s = emit_struct_field_drops(s, hslot);                   // free the struct's rc fields
                s = s.emit(ir.op_load_local(hslot));
                s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));       // free the struct box
                s = s.emit(ir.op_drop());
            },
            _ => {}
        }
        k = k + 1;
    }
    return s;
}

// tuple_union_elem_fresh reports whether `e` CONSTRUCTS a tagged union here — a
// built-in `Some(x)` / `Ok(x)` / `Err(x)`, or a user-enum variant ctor — rather
// than merely having union type. Construction is what makes the box fresh and
// sole-owned; a bare ident of the same type aliases a live local and must keep
// its leak-safe skip.
//
// expr_enum_type resolves the callee against the program's declared variants;
// the other two cover the built-in Option and Result constructions.
function tuple_union_elem_fresh(e: ast.Expr, s: LowerState): boolean {
    if (expr_enum_type(e, s) != "") { return true; }
    if (expr_opt_elem_tag(e, s) != "") { return true; }
    return expr_builtin_result_ctor(e, s);
}

// expr_builtin_result_ctor reports whether `e` is a direct `Ok(x)` / `Err(x)`
// constructing a built-in Result box here — the Result-side twin of
// expr_opt_elem_tag's `Some` arm.
//
// It answers a boolean where expr_opt_elem_tag answers a TAG, and that is the
// whole reason it exists: a bare `Ok(x)` cannot name the Result's E arm, so no
// `Result[T, E]` is recoverable from the expression. Freshness does not depend
// on the tag — the box is [tag, payload], allocated by this construction and
// aliased nowhere. The PAYLOAD is left alone; releasing that needs the
// variant's own drop plan.
//
// A same-named FREE FUNCTION resolves first and hands back a box this call did
// not allocate, so is_user_fn takes the element back out of the credit. A
// same-named user-enum VARIANT never reaches here — expr_enum_type resolves it
// one line above, and its box is fresh in exactly the same way.
function expr_builtin_result_ctor(e: ast.Expr, s: LowerState): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (c.args.len() != 1) { return false; }
                    if (cid.name != "Ok" && cid.name != "Err") { return false; }
                    return !s.is_user_fn(cid.name);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// emit_tuple_union_elem_drop releases the tagged-union element at `cp`, and where
// the construction proves its PAYLOAD sole-owned, that payload first. The box is
// always freed; what varies is how much of what it points at goes with it.
//
//   - A USER enum takes the same runtime variant dispatch a consumed-by-match
//     enum local gets: read the tag, release that variant's rc payload fields,
//     then free the box. It needs no enum_all_variants_rc_droppable gate — that
//     predicate admits the LOCAL consume path, and the emitter simply releases
//     nothing for a field whose type it cannot name, which leaks rather than
//     corrupts. Dispatching on the resolved enum TYPE is also what keeps a user
//     variant spelled `Some` off the built-in path below, where the Option
//     payload offset would only fit it by coincidence.
//   - A built-in Some/Ok/Err whose payload is FRESH by the same rule the sibling
//     element arms use (tuple_union_payload_freefn) takes that payload's release
//     through op_opt_payload.
//   - Anything else keeps the shallow dec, leaking the payload as before. A leak
//     is what an unproven payload is owed: freeing an aliased one is unrecoverable
//     where leaking it is merely wasteful.
//
// The payload is released BEFORE the box in every case, so no read chases through
// an already-freed box.
function emit_tuple_union_elem_drop(st: LowerState, slot: i32, cp: i32[], e: ast.Expr): LowerState {
    var s: LowerState = st;
    var ename: string = expr_enum_type(e, s);
    var pf: string = "";
    if (ename == "") { pf = tuple_union_payload_freefn(e, s); }
    if (ename == "" && pf == "") {
        s = emit_load_tuple_path(s, slot, cp);          // union box ptr
        s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));
        s = s.emit(ir.op_drop());
        return s;
    }
    // Both deep releases read the box through a SLOT, so hoist the element
    // pointer into a temp; each zeroes it after freeing, leaving any later
    // sweep a null to dec.
    var hn: string = "$tue" + util.i32_to_string(s.locals.len());
    s = s.add_local(hn);
    var h: i32 = s.slot_of(hn);
    s = emit_load_tuple_path(s, slot, cp);              // union box ptr
    s = s.emit(ir.op_store_local(h));
    if (ename != "") { return emit_enum_variant_drops(s, h, ename); }
    return emit_opt_payload_drop_via(s, h, pf);
}

// tuple_union_payload_freefn names the runtime helper that fully releases the
// payload of a built-in `Some(x)` / `Ok(x)` / `Err(x)` at a tuple element, or ""
// when this site cannot prove the payload sole-owned. Only reached for an
// element that is NOT a user enum, so the ctor names below cannot be a user
// variant that merely shares the spelling.
//
// It asks the payload expression exactly what emit_tuple_child_drops asks an
// ELEMENT expression one level up — the freshness question is the same question
// about the same kind of expression, so `(i, [a, b])` and `(i, Some([a, b]))`
// admit the same array. A bare ident answers "", keeping its leak: it aliases a
// live local the site never inc'd. An element that is not a construction at all
// (a call returning an Option) answers "" for want of a payload expression.
function tuple_union_payload_freefn(e: ast.Expr, s: LowerState): string {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1 || !builtin_union_ctor(c.callee)) { return ""; }
            return tuple_union_arg_freefn(c.args[0], s);
        },
        _ => {}
    }
    return "";
}

// builtin_union_ctor reports whether `callee` names a built-in Option/Result
// constructor, bare (`Some`) or qualified (`Option.Some`). A NAME test is enough
// only because admission ran first: tuple_union_elem_fresh resolves a user
// variant through expr_enum_type and a shadowing free function through
// expr_builtin_result_ctor's is_user_fn, so neither reaches this far.
function builtin_union_ctor(callee: ast.Expr): boolean {
    match (callee) {
        ast.ExprIdent(id) => { return id.name == "Some" || id.name == "Ok" || id.name == "Err"; },
        ast.ExprFieldAccess(fa) => { return fa.field == "Some" || fa.field == "Ok" || fa.field == "Err"; },
        _ => {}
    }
    return false;
}

// union_ctor_ident_arg names the LOCAL a built-in union construction takes as its
// sole payload (`Some(sv)` -> "sv"), or "" when the element is not that shape.
function union_ctor_ident_arg(e: ast.Expr): string {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1 || !builtin_union_ctor(c.callee)) { return ""; }
            match (c.args[0]) {
                ast.ExprIdent(id) => { return id.name; },
                _ => {}
            }
        },
        _ => {}
    }
    return "";
}

// tuple_union_payload_sole_use: `init` is a tuple literal in which `name` appears
// ONLY as the sole payload of a built-in union construction. A tuple that also
// mentions the name anywhere else answers false, so the interlock below never
// hides a second, genuinely escaping use.
function tuple_union_payload_sole_use(init: ast.Expr, name: string): boolean {
    match (init) {
        ast.ExprTuple(tl) => {
            var found: boolean = false;
            var k: i32 = 0;
            while (k < tl.elements.len()) {
                if (union_ctor_ident_arg(tl.elements[k]) == name) { found = true; }
                else if (expr_mentions_name(tl.elements[k], name)) { return false; }
                k = k + 1;
            }
            return found;
        },
        _ => {}
    }
    return false;
}

// tuple_bare_ident_sole_use: `init` is a tuple literal in which `name` appears
// ONLY as a bare-ident ELEMENT. The bare-ident twin of
// tuple_union_payload_sole_use, and refusing on any other mention is the same
// interlock: a tuple that also reads `name` elsewhere (`(s, s.len())`) answers
// false, so a second, genuinely escaping use is never hidden by this.
function tuple_bare_ident_sole_use(init: ast.Expr, name: string): boolean {
    match (init) {
        ast.ExprTuple(tl) => {
            var found: boolean = false;
            var k: i32 = 0;
            while (k < tl.elements.len()) {
                var bare: boolean = false;
                match (tl.elements[k]) {
                    ast.ExprIdent(eid) => { if (eid.name == name) { bare = true; } },
                    _ => {}
                }
                if (bare) { found = true; }
                else if (expr_mentions_name(tl.elements[k], name)) { return false; }
                k = k + 1;
            }
            return found;
        },
        _ => {}
    }
    return false;
}

// tuple_union_arg_freefn is the payload half: the release for a construction
// argument, or "" for one this site cannot prove sole-owned.
function tuple_union_arg_freefn(arg: ast.Expr, s: LowerState): string {
    match (arg) {
        ast.ExprArray(_) => {
            if (tuple_strarr_elem_fresh(arg)) { return "__fern_str_arr_free"; }
            return "__fern_rc_dec";
        },
        ast.ExprString(_) => { return "__fern_str_free"; },
        // A bare-ident ARRAY payload (`Some(xs)`). It aliases a live local, but
        // the construction alias-incs it, so the element's dec spends the box's
        // own reference and the local's sweep still finds a valid buffer — the
        // same balance the carried-out arm binding relies on. A string ARRAY is
        // is_arr too, and a flat dec there would free the buffer and strand
        // every element box, so it keeps its leak until the walking free is
        // credited. Any other bare ident (a string, a struct) answers "" as
        // before: naming its release needs more than the slot's array-ness.
        ast.ExprIdent(id) => {
            if (s.is_strarr_slot(s.slot_of(id.name))) { return ""; }
            // A bare-ident STRING payload is released only when the LOCAL is
            // itself credited "STR:", which is the other half of the tuple-element
            // interlock: the construction retains (rc 2), the local's own
            // rebind/exit sweep spends one reference and this spends the other.
            // Without the credit the local's sweep never runs, one dec cannot
            // reach zero, and the shape leaks either way — so the two halves
            // hang off the same condition rather than being able to drift apart.
            if (s.is_str_slot(s.slot_of(id.name))) {
                if (slot_is_reclaimable_str(s, s.slot_of(id.name))) { return str_free_helper(s, s.slot_of(id.name)); }
                return "";
            }
            if (s.is_arr_slot(s.slot_of(id.name))) { return "__fern_rc_dec"; }
            return "";
        },
        _ => {
            if (tuple_str_elem_fresh_reg(arg, s.sigs.str_fresh_ret_fns)) { return "__fern_str_free"; }
        }
    }
    return "";
}

// emit_tuple_type_child_drops is the TYPE-driven sibling of emit_tuple_child_drops:
// when the drop site has no construction LITERAL (an Option's tuple payload — the
// reclaim works from the type annotation, not the `Some((..))` args), the array /
// nested-tuple positions are read from the tuple TYPE `ttype` instead. A leak-safe
// scalar-array position is arr_dec'd; a nested tuple-type position is recursed then
// its box arr_dec'd; scalar positions are skipped. SOUND only when the tuple holds a
// counted reference to every position it dec's, which is what admission proves: a
// direct array literal the tuple sole-owns, or — where the drop frees the tuple's own
// box in the same breath (tuple_arg_payload_retained) — a bare ident the construction
// retained. It cannot skip a position the way the literal-driven helper does, so a
// position holding an UNRETAINED alias must never reach it.
function emit_tuple_type_child_drops(st: LowerState, slot: i32, path: i32[], ttype: string): LowerState {
    var s: LowerState = st;
    var k: i32 = 0;
    while (k < 64) {
        var tag: string = tuple_type_elem_tag(ttype, k);
        if (tag == "") { return s; }
        if (is_leaksafe_array_field(tag)) {
            s = emit_load_tuple_path(s, slot, path_child(path, k));   // array ptr
            s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));       // free the buffer
            s = s.emit(ir.op_drop());
        } else if (tag == "string[]") {
            // A string-ARRAY element position: admission (tuple_arg_payload_fresh)
            // proved the position is an array literal of fresh strings, so the
            // element-walking free releases every element box and the buffer.
            s = emit_load_tuple_path(s, slot, path_child(path, k));   // array ptr
            s = s.emit(ir.op_call_direct("__fern_str_arr_free", 1));
            s = s.emit(ir.op_drop());
        } else if (tag == "string") {
            // A STRING element position (#4353 item 2, probe p4): construction
            // str_box's every string element into a fresh sole-owned copy
            // (#5443), and admission (tuple_arg_payload_fresh) only credits a
            // literal / fresh-producer element, so the rc-aware __fern_str_free
            // (immortal skips, shared decs, unique frees) is exactly balanced.
            s = emit_load_tuple_path(s, slot, path_child(path, k));   // string ptr
            s = s.emit(ir.op_call_direct("__fern_str_free", 1));     // rc-aware free
            s = s.emit(ir.op_drop());
        } else if (util.is_tuple_type_name(tag)) {
            var cpt: i32[] = path_child(path, k);
            s = emit_tuple_type_child_drops(s, slot, cpt, tag);      // inner children first
            s = emit_load_tuple_path(s, slot, cpt);                  // inner box ptr
            s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));       // free the inner tuple box
            s = s.emit(ir.op_drop());
        } else if (decl_is_struct(s.structs, tag) && struct_has_reclaim_array_field(s.structs, tag)) {
            // A reclaim-STRUCT element position (`(i32, P)` where P sole-owns an rc-array
            // field, #4365): deep-drop the struct's fields (__struct_drop_<P>, balanced by
            // the construction alias-inc) then free the struct box. The TYPE-driven sibling
            // of emit_tuple_child_drops' struct arm; admission (tuple_field_deep_droppable +
            // tuple_arg_payload_fresh) only credits a fresh struct-literal position, so the
            // box is sole-owned and the deep-drop is balanced.
            var cps: i32[] = path_child(path, k);
            var hn: string = "$ttsx" + util.i32_to_string(s.locals.len());
            s = s.add_local(hn);
            var hslot: i32 = s.slot_of(hn);
            s = s.mark_struct_type(hslot, tag);
            s = emit_load_tuple_path(s, slot, cps);                  // struct box ptr
            s = s.emit(ir.op_store_local(hslot));
            s = emit_struct_field_drops(s, hslot);                   // free the struct's rc fields
            s = s.emit(ir.op_load_local(hslot));
            s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));       // free the struct box
            s = s.emit(ir.op_drop());
        }
        k = k + 1;
    }
    return s;
}

// tuple_field_deep_droppable: `t` is a tuple TYPE whose every element is a flat
// scalar, a leak-safe scalar array, or a nested deep-droppable tuple — with AT
// LEAST ONE array somewhere (else nothing rc to reclaim). Released by
// emit_tuple_type_child_drops + a box dec. String / struct / enum / option / map
// elements are excluded (first cut).
function tuple_field_deep_droppable(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() < 2 || slice_unchecked(t, 0, 1) != "(") { return false; }
    var any_arr: boolean = false;
    var k: i32 = 0;
    while (k < 64) {
        var tag: string = tuple_type_elem_tag(t, k);
        if (tag == "") { break; }
        if (is_leaksafe_array_field(tag)) { any_arr = true; }
        else if (util.is_tuple_type_name(tag)) {
            if (!tuple_field_deep_droppable(tag, structs)) { return false; }
            any_arr = true;
        } else if (decl_is_struct(structs, tag)) {
            // A reclaim-STRUCT element (P with an rc-array field, #4365): deep-droppable
            // via emit_tuple_type_child_drops' struct arm. A plain struct (no rc field)
            // stays un-admitted (leak-safe) — the drop only handles field-reclaim structs.
            if (!struct_has_reclaim_array_field(structs, tag)) { return false; }
            any_arr = true;
        } else if (tag == "string") {
            // A STRING element (#4353 item 2, probe p4): construction str_box's
            // every string element into a fresh sole-owned copy (#5443), so the
            // type-driven drop's rc-aware __fern_str_free is deep-droppable —
            // gated at admission (tuple_arg_payload_fresh) on a literal / fresh
            // producer element expression.
            any_arr = true;
        } else if (tag == "string[]") {
            // A string-ARRAY element: released by __fern_str_arr_free, gated at
            // admission on an array literal of provably fresh strings.
            any_arr = true;
        } else if (!is_scalar_type_name(tag)) { return false; }
        k = k + 1;
    }
    return any_arr;
}

// tuple_arg_payload_fresh: the construction's tuple payload `arg` is a FRESH tuple
// literal whose every ARRAY-typed position (per the field TYPE `ttype`) is a DIRECT
// array literal and every nested-tuple position a nested tuple literal (recursively
// fresh). The SOLE-OWNER gate: every rc position's box belongs to this tuple alone,
// so a site that frees the payload without also freeing the tuple's own box is
// balanced. Scalar positions accept any expression (value-copied, never rc-tracked).
function tuple_arg_payload_fresh(ttype: string, arg: ast.Expr, structs: parser.StructDecl[]): boolean {
    // The sole-owner flavour keeps the SYNTACTIC string admission (empty
    // registry): its consumers (an Option's Some payload, an array-of-tuples
    // element) free the payload without freeing a box the same statement
    // built, and widening each is its own measured increment — #7374 records
    // the scope split. Only the retained flavour below learns the registry.
    var no_reg: string[] = [];
    return tuple_arg_payload_droppable(ttype, arg, structs, false, no_reg);
}

// tuple_arg_payload_retained is the same admission widened by one position form: a
// leak-safe ARRAY position may also be a BARE IDENT. Where the strict predicate
// above asks "does the tuple SOLE-OWN this position", this asks the weaker question
// the type-driven drop actually needs — "does the tuple hold a counted reference to
// it" — and a bare ident does, because lower_expr's ExprTuple arm rc_inc's an
// element naming an rc-container local, making the tuple a second owner. The drop's
// dec gives that retain back; the local's own sweep spends its own reference.
//
// Use it only where the drop frees the tuple's OWN box in the same breath (the
// scope-exit sweep). The strict form stays the gate everywhere the payload outlives
// the box or is reached without one — an Option's Some payload, an array-of-tuples
// element — since there a mere counted reference is not enough to free by.
function tuple_arg_payload_retained(ttype: string, arg: ast.Expr, structs: parser.StructDecl[], str_fresh_ret: string[]): boolean {
    return tuple_arg_payload_droppable(ttype, arg, structs, true, str_fresh_ret);
}

function tuple_arg_payload_droppable(ttype: string, arg: ast.Expr, structs: parser.StructDecl[], ident_arr_ok: boolean, str_fresh_ret: string[]): boolean {
    match (arg) {
        ast.ExprTuple(tl) => {
            var k: i32 = 0;
            while (k < tl.elements.len()) {
                var tag: string = tuple_type_elem_tag(ttype, k);
                if (tag == "") { return false; }
                if (is_leaksafe_array_field(tag)) {
                    var isarr: boolean = false;
                    match (tl.elements[k]) {
                        ast.ExprArray(_) => { isarr = true; },
                        // A bare ident is admitted only for the retained flavour: the
                        // construction retain is what the drop's dec gives back, and
                        // nothing else at this position takes one.
                        ast.ExprIdent(_) => { isarr = ident_arr_ok; },
                        _ => {}
                    }
                    if (!isarr) { return false; }
                } else if (tag == "string[]") {
                    // A string-ARRAY position must be an array literal of fresh
                    // strings — the type-driven drop element-walks it blind, so an
                    // ident element would put a live local's box under str_free.
                    if (!tuple_strarr_elem_fresh(tl.elements[k])) { return false; }
                } else if (tag == "string") {
                    // A string position must be a LITERAL (construction copies it
                    // fresh) or a fresh producer (concat / .to_string() / a
                    // registered fresh-string function, tuple_str_elem_fresh_reg)
                    // — a bare-ident element would put a live local's box under
                    // the blind type-driven str_free.
                    var isfs: boolean = false;
                    match (tl.elements[k]) {
                        ast.ExprString(_) => { isfs = true; },
                        _ => { isfs = tuple_str_elem_fresh_reg(tl.elements[k], str_fresh_ret); }
                    }
                    if (!isfs) { return false; }
                } else if (util.is_tuple_type_name(tag)) {
                    if (!tuple_arg_payload_droppable(tag, tl.elements[k], structs, ident_arr_ok, str_fresh_ret)) { return false; }
                } else if (decl_is_struct(structs, tag)) {
                    // A reclaim-STRUCT position must be a FRESH struct literal so the
                    // type-driven drop dec's a sole-owned box (an ident alias would
                    // double-release). #4365.
                    if (!struct_has_reclaim_array_field(structs, tag)) { return false; }
                    var isslit: boolean = false;
                    match (tl.elements[k]) { ast.ExprStructLit(_) => { isslit = true; }, _ => {} }
                    if (!isslit) { return false; }
                } else if (!is_scalar_type_name(tag)) {
                    return false;
                }
                k = k + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// emit_tuple_deep_reinit_store stores `new` (on the stack) into a reclaimable
// rc-tuple slot and DEEP-drops the OLD tuple box: emit_tuple_child_drops frees
// every fresh array buffer and nested tuple box the init literal `dtl` builds
// (depth-first), then __fern_rc_dec the outer box. Only ExprArray / nested-tuple-
// literal positions are freed — a scalar / bare-ident element is left untouched
// (a pointer ident aliases a live local, so freeing it would double-release; a
// scalar carries no pointer). old's children were built by the SAME statement, so
// they are the same fresh sole-owned shape → freeing them is balanced. Null-
// guarded (`old != 0`) so the first-iteration null old is a no-op; a fresh tuple
// literal makes old != new implicit, so no separate cow guard is needed. The
// scratch stashes `new` (read for the guard compare and final store).
function emit_tuple_deep_reinit_store(se: LowerState, slot: i32, dtl: ast.ExprTuple): LowerState {
    var scratch: string = "$tdr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = st.emit(ir.op_load_local(slot));            // old
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    var empty_path: i32[] = [];
    st = emit_tuple_child_drops(st, slot, empty_path, dtl);   // free fresh array/nested-tuple children
    st = st.emit(ir.op_load_local(slot));            // old box
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));   // free the tuple box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// emit_enum_deep_reinit_store stores `new` (on the stack) into a reclaimable
// rc-payload enum slot and DEEP-drops the OLD box first via emit_enum_variant_drops
// (runtime variant dispatch: for each variant carrying an rc payload, drop the
// payload field(s), then the box; the slot is zeroed). emit_enum_variant_drops
// null-guards (variant_is is false for a null box), so the first-iteration null old
// is a no-op; and it consumes NO stack operand, so `new` is stashed in a scratch
// and restored after. The arm-payload-non-escape gate (enum_body_binds_rc_payload,
// applied at collection) keeps old's payload the box's sole owner, so dropping it
// is balanced. #4357 — the enum sibling of the struct / tuple loop-rebind reclaim.
function emit_enum_deep_reinit_store(se: LowerState, slot: i32, enum_name: string): LowerState {
    var scratch: string = "$edr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));                     // stash new
    // NULL-guard the deep-drop: op_variant_is reads the box's tag, so it faults on a
    // genuinely null box (the first-iteration zeroed slot). The existing callers
    // (consumed_rcpayload_enum_frees / precise-drop) never pass null; here `old` is
    // null on iteration 0, so guard explicitly. A fresh enum makes old != new
    // implicit, so no separate cow guard is needed.
    st = st.emit(ir.op_load_local(slot));                    // old
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));                 // old != 0
    st = st.emit(ir.op_if(0));
    var no_moved: string[] = [];
    st = emit_enum_variant_drops_gated(st, slot, enum_name, no_moved, true);   // deep-drop old payload + box (zeroes slot)
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));                     // new
    return st.emit(ir.op_store_local(slot));
}

// emit_dec_sweep_except releases (decs) every OWNED array local currently in
// scope except `keep` (the move-on-return slot, or -1 for none), leaving the
// operand stack unchanged. Array params (slots < n_params) are BORROWED — the
// caller retains ownership, so the callee never decs them (the n_params borrow
// boundary). Used at each return.
// emit_struct_field_drops releases the rc-array FIELDS of a reclaimable struct
// before its box is freed — Perceus deep-drop, one level. Covers scalar-element
// arrays (i32[] / boolean[] / …) AND array-of-struct / array-of-enum fields: a
// scalar field's BUFFER is shallow-dec'd; a struct/enum-array field's buffer is
// walked (each element box dec'd) when uniquely owned, then the buffer dec'd.
// This BALANCES the Perceus dup (__fern_rc_inc) the struct-lit / bind / return /
// assign paths add when a struct/enum-array field aliases a local: rc 1 →inc 2
// →source-owner dec 1 →this field-drop 0 (freed once). A fresh-literal field is
// the sole owner (rc 1) → freed directly. A `string` field is NEVER dec'd: no
// path incs a string on alias, so a field drop would be an unpaired release.
//
// Emitted as a per-type runtime helper __struct_drop_<T>(box) -> box, NEVER
// inline: a single function can sweep many reclaimable struct locals at exit, and
// a struct/enum-array field's deep-walk is a ~30-op loop — inlining it at every
// sweep site exploded the native driver's per-function op arrays past the #3452
// heap on the large modules. A per-type helper (the body emitted once, the call
// site ~3 ops) keeps the broad struct reclaim within the emit budget, exactly as
// __field_reclaim_<T> already does for the consume-rebind path. All three backends
// emit a real per-type body (x86 emit_ir_struct_drop_one, arm64
// emit_arm64_struct_drop_one, wasm emit_wasm_struct_drop_body), each deep-dropping
// rc-array fields plus acyclic nested-struct fields (nested_field_deep_drop_ok).
// Guarded on a non-null box inside the helper. Emits nothing when the struct has no
// rc-array field.
// slot_nodeep: local `i` carries a "NODEEP:" marker (reclaimable_names_of) — a
// method-receiver / bare call-arg / struct-base use may have MOVED its rc
// fields into another live value with no counted reference, so every reclaim
// of the slot's OLD value must stay BOX-ONLY (the #3456 shallow contract):
// the sweeps withhold __struct_drop_<T> and the reinit/rebind stores fall
// back to emit_arr_store's shallow dec. See the marker computation in
// reclaimable_names_of for the full soundness argument (#3425 residual).
// The lookup is by slot_name and NOT the retirement-aware form, which looks like
// an oversight and is not one (#6127). Every consumer emits while the name is still
// live — the four reinit/rebind stores run inside the declaring block, and the
// exit sweep's scoped path withholds the deep drop outright — so a "!retired!"
// name never reaches this predicate, and reading through the prefix was measured
// to change nothing. It was tried as the explanation for #6375's gen1 segfault
// (the theory: a NODEEP-marked block-scoped local silently losing its guard) and
// DISPROVEN — with the marker visible, granting the deep drop still segfaults.
// opt_alias_slot_boxonly: slot i is an ALIAS of a credited unmatched-Option
// local — it carries one of the three class tags qualified by "NODEEP:", so its
// whole release is a box dec (#7687). The bind store and the exit sweep both ask
// this so the retain, the superseded-box dec and the sweep dec stay one set.
function opt_alias_slot_boxonly(s: LowerState, i: i32): boolean {
    if (!slot_nodeep(s, i)) { return false; }
    return slot_is_reclaimable_optarr(s, i) || slot_is_reclaimable_optstr(s, i) || slot_is_reclaimable_optopt_rc(s, i);
}

function slot_nodeep(s: LowerState, i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    // Keyed on the binding SITE, like the credit it qualifies (#7253): the marker
    // is derived from the same entry, so the two move together. A slot with no
    // recorded site answers false — which for THIS marker is the unsafe
    // direction (it withholds a deep drop), so the producers that bind a struct
    // slot outside bind_var_slot record their site rather than relying on it.
    return reclaim_has(s.reclaimable_names, "NODEEP:", s.reclaim_site_key(i));
}

// emit_struct_field_drops_gated is emit_struct_field_drops with the release
// optionally guarded by __fern_rc_is_unique — the struct twin of
// emit_enum_variant_drops_gated. `shared` is true wherever the swept box may
// carry a second counted claim; the guard then takes the shallow path and
// leaves the fields to the owner that finds rc 1. Sound in either order, and
// a sole-owned box (rc 1) is unaffected, which is why passing true at a sweep
// costs nothing on the shapes that were already balanced.
function emit_struct_field_drops_gated(s: LowerState, slot: i32, shared: boolean): LowerState {
    if (!shared) { return emit_struct_field_drops(s, slot); }
    var sty: string = s.struct_type_of_slot(slot);
    if (sty.len() == 0) { return s; }
    if (!s.struct_routes_field_reclaim(sty)) { return s; }
    if (slot_nodeep(s, slot)) { return s; }
    var st: LowerState = s.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));   // sole owner (and null-safe)
    st = st.emit(ir.op_if(0));
    st = emit_struct_field_drops(st, slot);
    return st.emit(ir.op_end());
}

function emit_struct_field_drops(s: LowerState, slot: i32): LowerState {
    var sty: string = s.struct_type_of_slot(slot);
    if (sty.len() == 0) { return s; }
    // Route on the SAME predicate the construction-side retain (slit_reclaim in
    // the ExprStructLit lowering) uses: rc-array / nested-struct / enum field,
    // OR a STRFLDOK-admitted string-fielded type (#4355 slice 3). Before this,
    // a string-ONLY struct local (`P { s: string, n: i32 }`) fell through to the
    // box-only dec at scope exit and its fresh string field leaked per bind —
    // even though __struct_drop_<T>'s k_str arm (all three backends) frees it
    // rc-aware, and the retain already inc'd non-fresh string fields under this
    // exact predicate (so the k_str dec is balanced by construction). Native
    // reclaims this shape; the sweep was the last unwidened consumer.
    if (!s.struct_routes_field_reclaim(sty)) { return s; }
    // "NODEEP:"-marked local (#3425 residual): a method-receiver / call-arg /
    // struct-base use may have MOVED this box's rc fields into another live
    // value (an in-place `self.ops.append(op)` hands the same rc==1 buffer to
    // the callee's result), so the deep walk would free buffers and element
    // boxes that other value still holds — the exact corruption the IR-built
    // compiler hit on its own Op streams. Withhold the deep drop; the caller's
    // box-only dec still runs (the #3456 shallow contract). Scratch slots
    // ($tsx/$optst/...) never carry the marker, so the tuple-child / option-
    // payload / array-element walks are unaffected.
    if (slot_nodeep(s, slot)) { return s; }
    // __struct_drop_<T>'s k_enum arm is a box-only dec, so a direct enum field's
    // variant payload survives the sweep. Release it here first, while the box is
    // still readable.
    var st: LowerState = emit_struct_enum_field_payload_drops(s, slot, sty);
    // Direct tuple fields, for the same reason the enum payloads above need
    // their own arm: no k_* arm of __struct_drop_<sty> matches a "(…)" type.
    st = emit_struct_tuple_field_drops(st, slot, sty);
    st = st.emit(ir.op_load_local(slot));    // box (arg0)
    st = st.emit(ir.op_call_direct("__struct_drop_" + sty, 1));   // deep-drops the rc-array fields; returns box
    return st.emit(ir.op_drop());
}

// emit_struct_enum_field_payload_drops releases the VARIANT PAYLOAD of every direct
// enum field of struct `sty` whose enum type is array-payload-only, leaving the enum
// BOX itself to the k_enum arm of the __struct_drop_<sty> call that follows (a dec
// here too would over-release it). Without this the payload array leaks once per
// construction — the residual #6691 left, and the gap between a struct's enum FIELD
// and the same enum spelled as a LOCAL, which lowering already deep-drops via
// emit_enum_variant_drops.
//
// ADMISSION, two halves:
//   - the enum TYPE: enum_all_variants_array_payload — every rc payload is a leaf
//     scalar ARRAY that a single rc_dec fully releases. String / nested-struct
//     payloads are excluded because releasing one needs the per-construction
//     freshness proof (variant_struct_payloads_fresh) the sweep cannot see, whereas
//     an array payload rides the construction alias-inc, so a bare-ident payload is
//     retained and the dec only releases the dup.
//   - the box at RUNTIME: __fern_rc_is_unique, which doubles as the null guard. A
//     non-fresh enum field (bound from a live enum local, copied from a struct-lit
//     base) was alias-inc'd at construction, so the box is shared and its payload is
//     still reachable through the other owner — deep-dropping it there would free a
//     live value, and the other owner's own sweep would double-release. Shared boxes
//     take today's shallow path: leaks, never dangles.
//
// The struct box is null-guarded because op_struct_get faults on a zeroed slot (an
// unreached local), which __struct_drop_'s own low-address check would have absorbed.
function emit_struct_enum_field_payload_drops(se: LowerState, slot: i32, sty: string): LowerState {
    var st: LowerState = se;
    var n: i32 = decl_field_count(st.structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(st.structs, sty, fi);
        if (decl_is_enum(st.structs, ft) && enum_all_variants_array_payload(st.structs, ft)) {
            var esc: string = "$sefp" + util.i32_to_string(st.locals.len());
            st = st.add_local(esc);
            var etmp: i32 = st.slot_of(esc);
            st = st.emit(ir.op_load_local(slot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_bin("ne", 0, false));                                     // struct box != 0
            st = st.emit(ir.op_if(0));
            st = st.emit(ir.op_load_local(slot));
            st = st.emit(ir.op_struct_get(fi, struct_field_width(st.structs, sty, fi)));  // enum box
            st = st.emit(ir.op_store_local(etmp));
            st = st.emit(ir.op_load_local(etmp));
            st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));                    // sole owner (and null-safe)
            st = st.emit(ir.op_if(0));
            var no_moved: string[] = [];
            st = emit_enum_variant_payload_drops(st, etmp, ft, no_moved);
            st = st.emit(ir.op_end());
            st = st.emit(ir.op_end());
        }
        fi = fi + 1;
    }
    return st;
}

// struct_has_deep_tuple_field: `sty` has a direct tuple field whose shape
// tuple_field_deep_droppable admits. The tuple sibling of
// struct_has_reclaim_array_field, and the routing predicate both the
// construction retain and emit_struct_tuple_field_drops read.
function struct_has_deep_tuple_field(structs: parser.StructDecl[], sty: string): boolean {
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(structs, sty, fi);
        if (tuple_field_deep_droppable(ft, structs)) { return true; }
        fi = fi + 1;
    }
    return false;
}

// emit_struct_tuple_field_drops releases every direct deep-droppable TUPLE
// field of struct `sty` — its rc children and then its box. The tuple sibling
// of emit_struct_enum_field_payload_drops, and it exists for the same reason
// that one does: the asm __struct_drop_<sty> ladder has no arm that matches a
// "(…)" field type, so without this the tuple box and everything it owns
// survives the sweep. Runs BEFORE the __struct_drop_ call, while the box is
// still readable.
//
// Two guards, both the enum sibling's:
//   - the struct box is null-guarded (op_struct_get faults on a zeroed slot);
//   - the CHILD WALK is __fern_rc_is_unique-gated. A non-fresh tuple field was
//     alias-inc'd at construction (the ExprStructLit tuple arm, gated on this
//     same routing predicate), so a shared box is still reachable through the
//     other owner: deep-dropping it here would free a live value and the other
//     owner's sweep would double-release.
//
// The BOX dec is outside that gate — one per owner, unconditionally, the way
// __struct_drop_'s k_enum arm decs an enum field box while the payload walk
// above it stays is_unique-gated. Gating the dec too would leave the box at the
// shared count forever: every owner would find it non-unique and none would
// free it. __fern_rc_dec is null- and low-address-safe, so the struct-box guard
// is the only one it needs.
function emit_struct_tuple_field_drops(se: LowerState, slot: i32, sty: string): LowerState {
    var st: LowerState = se;
    var n: i32 = decl_field_count(st.structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(st.structs, sty, fi);
        if (tuple_field_deep_droppable(ft, st.structs)) {
            var tsc: string = "$stfd" + util.i32_to_string(st.locals.len());
            st = st.add_local(tsc);
            var ttmp: i32 = st.slot_of(tsc);
            st = st.mark_tuple_elems(ttmp, slice_unchecked(ft, 1, ft.len() - 1));
            st = st.emit(ir.op_load_local(slot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_bin("ne", 0, false));                                      // struct box != 0
            st = st.emit(ir.op_if(0));
            st = st.emit(ir.op_load_local(slot));
            st = st.emit(ir.op_struct_get(fi, struct_field_width(st.structs, sty, fi)));   // tuple box
            st = st.emit(ir.op_store_local(ttmp));
            st = st.emit(ir.op_load_local(ttmp));
            st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));                     // last owner (and null-safe)
            st = st.emit(ir.op_if(0));
            var tpath: i32[] = [];
            st = emit_tuple_type_child_drops(st, ttmp, tpath, ft);
            st = st.emit(ir.op_end());
            st = st.emit(ir.op_load_local(ttmp));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));                           // this owner's share of the box
            st = st.emit(ir.op_drop());
            st = st.emit(ir.op_end());
        }
        fi = fi + 1;
    }
    return st;
}

// --- Perceus precise drops (drop-on-last-use) for arrays -----------------
//
// Native's computePreciseDrops (ir.go ~3294) releases a value right after its
// last use instead of at function exit, bounding the live set. This is the
// conservative self-host first cut: it fires ONLY for a provably linear, owned
// array literal local — `var v = [ ... ]` declared once, never reassigned, and
// used ONLY as a borrow read (`v[i]`, `v.method()`, `for x in v`). Such a v is
// the sole owner of a fresh rc=1 buffer that never escapes, so releasing it
// right after its last top-level use is sound. Anything uncertain is omitted and
// falls back to the function-exit dec-sweep (the safe-leak invariant). The drop
// is emitted as dec + ZERO the slot, so the later exit-sweep harmlessly decs a
// null on that slot (no LowerState threading needed).

// str_borrowing_method reports whether a string method neither hands its
// receiver's box out nor returns a view of it: `len` plus the predicates and the
// fresh-copy transforms, each of which either reads the receiver's bytes or
// allocates a new buffer. A receiver at one of these is BORROWED for the call
// and nothing survives it. `.trim()` and `.replace()` are absent on purpose —
// both can return a VIEW of the receiver, which is a lasting alias.
function str_borrowing_method(field: string): boolean {
    return field == "len" || field == "to_ascii_upper" || field == "to_ascii_lower"
        || field == "reverse" || field == "repeat"
        || field == "starts_with" || field == "ends_with"
        || field == "contains" || field == "index_of";
}

// str_method_recv_borrows extends str_borrowing_method's carve-out from the
// fixed builtin set to any SOURCE-DECLARED method the callee-side proof already
// clears, so `slice_unchecked(base, a, b).to_owned()` reads `base` instead of
// aliasing it.
//
// The proof is the plain recv_borrow key, which body_unsafe_for grants only when
// nothing carries the receiver out — so `to_owned` (`return s + ""`) qualifies
// and `trim` (`return slice_unchecked(s, low, high)`, a view of the receiver)
// does not. That is the same warrant the receiver RELEASE sites use; here it
// decides whether the SOURCE keeps its reclaim credit.
//
// The key can only be spelled `string.<method>`: this scan runs on bare AST with
// no types, so a same-named method on another type answers to it. That is sound
// only because admitting a receiver is what routes it to
// expr_unsafe_for_view_pos, which DIFFERS from expr_unsafe_for on a
// `slice_unchecked` call alone and delegates straight to it for every other
// shape — so any other receiver reaches the same verdict either way, and a view
// of a string is a string. A type check here would be dead code, not a guard.
function str_method_recv_borrows(field: string, recv_borrow: string[]): boolean {
    if (recv_borrow.len() == 0) { return false; }
    return util.index_of_str(recv_borrow, "string." + field) >= 0;
}

// binop_operand_unsafe_for is expr_unsafe_for at a string binary operator's
// operand. A BARE IDENT there is a borrow, for the same reason the index base
// and the method receiver already are: concat copies both operands' bytes into a
// new box and the comparisons read them, so neither retains. Flagging it cost
// every `return s + ""` its param's borrowability, so a caller could not release
// the temp it had just passed in.
function binop_operand_unsafe_for(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[]): boolean {
    return binop_operand_unsafe_for_vb(e, name, borrowable, recv_borrow, false);
}
function binop_operand_unsafe_for_vb(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[], vb_borrow: boolean): boolean {
    match (e) {
        ast.ExprIdent(_) => { return false; },
        _ => { return expr_unsafe_for_view_pos_vb(e, name, borrowable, recv_borrow, vb_borrow); }
    }
    return expr_unsafe_for_view_pos_vb(e, name, borrowable, recv_borrow, vb_borrow);
}

// expr_unsafe_for_view_pos is expr_unsafe_for at a position that only BORROWS a
// string for the duration of one expression: the escape-scan twin of
// lower_view_borrowed, called from the same positions the lowerer treats as
// view-borrowing. A `slice_unchecked` of `name` there is a view that dies inside
// the expression — lower_str_slice_frame puts its box in reserved frame slots no
// slot_of can name — so the source is READ, not aliased out, and keeps its
// reclaim credit. Counting it as an escape cost
// `slice_unchecked(base, a, b).len()` the whole reclaim of `base`. The bounds
// are ordinary positions and scan unchanged.
//
// `s[a:b]` is deliberately absent: it wraps the view in an `Option[str]` box
// (#5634) that leaves the expression, and on the register backends that view
// still points into the SOURCE buffer (ir.fern's str_slice is zero-copy), so the
// source is aliased out and must fall through to expr_unsafe_for's escaping arm.
function expr_unsafe_for_view_pos(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[]): boolean {
    return expr_unsafe_for_view_pos_vb(e, name, borrowable, recv_borrow, false);
}
function expr_unsafe_for_view_pos_vb(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[], vb_borrow: boolean): boolean {
    match (e) {
        ast.ExprCall(c) => {
            // slice_unchecked(src, a, b) (#5634): the ExprSlice arm's builtin
            // spelling — the same frame-boxed view, so an ident source there
            // is the same borrow read.
            if (slice_unchecked_call(e)) {
                var su_unsafe: boolean = false;
                match (c.args[0]) {
                    ast.ExprIdent(_) => {},
                    _ => { su_unsafe = expr_unsafe_for_view_pos_vb(c.args[0], name, borrowable, recv_borrow, vb_borrow); }
                }
                return su_unsafe || expr_unsafe_for_vb(c.args[1], name, borrowable, recv_borrow, vb_borrow)
                    || expr_unsafe_for_vb(c.args[2], name, borrowable, recv_borrow, vb_borrow);
            }
            return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, vb_borrow);
        },
        _ => { return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, vb_borrow); }
    }
    return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, vb_borrow);
}

// expr_unsafe_for reports whether `name` appears anywhere in `e` in a position
// that could create a reference outliving a precise drop — i.e. ANY occurrence
// except a borrow read: the base of an index (`name[i]`), the receiver of a
// method/field access (`name.m(...)` / `name.f`), or a slice at one of the
// view-borrowing positions expr_unsafe_for_view_pos names. A bare ident, a
// slice anywhere else (the view aliases the buffer and can be carried out), a
// container-literal element, or a lambda capture all escape. A CALL ARGUMENT
// normally escapes too (the callee might retain it),
// EXCEPT a direct bare-ident `name` passed at a *borrowable* param position of a
// known free function (`borrowable` registry, "callee|flags") — a provably
// read-only callee cannot retain the arg, so passing it there is a BORROW. The
// registry is "" for Level-1 borrowability computation itself (every call arg
// escapes), avoiding circularity.
// expr_unsafe_for is the STRICT entry point: a value block inside `e` is walked
// with the strict walker too. expr_unsafe_for_vb is the same walk with the
// match-borrow reading carried into value blocks — see its ExprLambda arm.
function expr_unsafe_for(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[]): boolean {
    return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, false);
}
function expr_unsafe_for_vb(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[], vb_borrow: boolean): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprBinary(b) => {
            // The string binary ops — concat and the comparisons — read their
            // operands' bytes and move nothing, which is what lower_expr's
            // lower_view_borrowed calls at each of them say. Every other op is
            // arithmetic on scalars, where a slice operand cannot arise.
            if (b.op == "+" || b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                return binop_operand_unsafe_for_vb(b.left, name, borrowable, recv_borrow, vb_borrow)
                    || binop_operand_unsafe_for_vb(b.right, name, borrowable, recv_borrow, vb_borrow);
            }
            return expr_unsafe_for_vb(b.left, name, borrowable, recv_borrow, vb_borrow) || expr_unsafe_for_vb(b.right, name, borrowable, recv_borrow, vb_borrow);
        },
        ast.ExprUnary(u) => { return expr_unsafe_for_vb(u.operand, name, borrowable, recv_borrow, vb_borrow); },
        ast.ExprIndex(ix) => {
            var base_unsafe: boolean = false;
            match (ix.array) {
                ast.ExprIdent(_) => { base_unsafe = false; },   // name[i] / other[i]: base read is a borrow
                _ => { base_unsafe = expr_unsafe_for_view_pos(ix.array, name, borrowable, recv_borrow); }
            }
            return base_unsafe || expr_unsafe_for_vb(ix.index, name, borrowable, recv_borrow, vb_borrow);
        },
        ast.ExprSlice(sl) => {
            // a slice creates a VIEW that aliases the source buffer → escapes.
            return expr_unsafe_for_vb(sl.array, name, borrowable, recv_borrow, vb_borrow) || expr_unsafe_for_vb(sl.start, name, borrowable, recv_borrow, vb_borrow) || expr_unsafe_for_vb(sl.end, name, borrowable, recv_borrow, vb_borrow);
        },
        ast.ExprCall(c) => {
            var callee_unsafe: boolean = false;
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    callee_name = cid.name;   // free call: record callee for the borrow check below
                    if (cid.name == name) { callee_unsafe = true; }   // a value used AS the callee escapes (preserve prior behaviour)
                },
                ast.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ast.ExprIdent(_) => { callee_unsafe = false; },   // name.method(): receiver is a borrow
                        // `name[a:b].len()`: a view receiver at a method that
                        // cannot retain it borrows the source, exactly as the
                        // bare-ident receiver above does.
                        _ => {
                            if (str_borrowing_method(fa.field) || str_method_recv_borrows(fa.field, recv_borrow)) { callee_unsafe = expr_unsafe_for_view_pos(fa.obj, name, borrowable, recv_borrow); }
                            else { callee_unsafe = expr_unsafe_for_vb(fa.obj, name, borrowable, recv_borrow, vb_borrow); }
                        }
                    }
                    // method args stay escapes: method-param borrowability isn't in
                    // the (free-function-keyed) registry (callee_name left "").
                },
                _ => { callee_unsafe = expr_unsafe_for_vb(c.callee, name, borrowable, recv_borrow, vb_borrow); }
            }
            if (callee_unsafe) { return true; }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                // Level 2: a DIRECT bare-ident `name` at a borrowable param position
                // of a known free function is a BORROW, not an escape.
                //
                // The "CNT:" tier admits a second position, and it is the only
                // tier on this registry that admits where the box flag REFUSES
                // ("TUPB:" / "ELB:" both narrow it). The two ask different
                // questions. The box flag asks whether the callee keeps a
                // reference at all; "CNT:" asks whether every reference it does
                // keep was RETAINED (param_counted_of). A retained one leaves
                // the caller's own claim intact and the callee's drop gives the
                // retain back, so exactly one release still belongs to the
                // caller — withholding it is the leak, not the safety.
                var arg_is_borrow: boolean = false;
                match (c.args[ai]) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == name && callee_name.len() > 0
                            && (param_is_borrowable(borrowable, callee_name, ai)
                                || param_is_borrowable(borrowable, "CNT:" + callee_name, ai))) { arg_is_borrow = true; }
                    },
                    _ => {}
                }
                // The `len(x)` builtin is the free spelling of `.len()` and
                // lowers through lower_view_borrowed, so a slice argument there
                // borrows its source too.
                if (callee_name == "len" && c.args.len() == 1) {
                    if (expr_unsafe_for_view_pos(c.args[ai], name, borrowable, recv_borrow)) { return true; }
                } else if (!arg_is_borrow && expr_unsafe_for_vb(c.args[ai], name, borrowable, recv_borrow, vb_borrow)) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(_) => { return false; },   // name.field: base read is a borrow
                _ => { return expr_unsafe_for_vb(fa.obj, name, borrowable, recv_borrow, vb_borrow); }
            }
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (expr_unsafe_for_vb(a.elements[i], name, borrowable, recv_borrow, vb_borrow)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (expr_unsafe_for_vb(el, name, borrowable, recv_borrow, vb_borrow)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            // A BARE-IDENT functional-update base (`T { ...name, … }`) reads
            // name's fields with struct_get and copies them out. That is a
            // BORROW of the box, the same as a method receiver — counting it as
            // an escape left every `d = T { ...d, … }` self-update with no
            // reclaim credit at all, so neither the box a rebind superseded nor
            // the final one was ever released. What the field copy does hazard
            // is the DEEP drop, because the copies carry no inc;
            // moves_fields_expr marks the name for that instead.
            if (sl.has_base) {
                match (sl.base) {
                    ast.ExprIdent(_) => {},
                    _ => { if (expr_unsafe_for_vb(sl.base, name, borrowable, recv_borrow, vb_borrow)) { return true; } }
                }
            }
            for fv in sl.field_values { if (expr_unsafe_for_vb(fv, name, borrowable, recv_borrow, vb_borrow)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => {
            // A VALUE BLOCK (`match`/`if`/block/comprehension expression, which
            // parser.fern desugars to a zero-arg IIFE) is not a closure: irlower
            // INLINES it, so nothing outlives the expression and a name read
            // inside it is an ordinary in-scope read. Walk it with the same rules
            // as the surrounding code — the strict walker's own StmtReturn arm
            // still flags the block's VALUE, which is the one way a name really
            // does leave (`var y = match (k) { A => p, … }`).
            //
            // The blanket capture test below is for a REAL lambda, whose body may
            // run after this frame. Applying it to a value block cost every struct
            // local read through a match expression its reclaim credit: the
            // apparent capture refused the alias-bind site, which withdrew the
            // source's credit too (#7282's two uses must agree), so neither box
            // was released — 0 frees where the same code without the match
            // expression is flat.
            if (parser.is_value_block_origin(lm.origin)) {
                // Walked by the caller's OWN walker, because the block is inlined:
                // a name read inside it is a read in the enclosing function, under
                // whatever reading that function's walker applies. `vb_borrow` is
                // the match-borrow walkers saying so — for them a bare-ident
                // `match (name)` scrutinee is a borrow, and recursing strictly here
                // threw that away, so a name read through a match EXPRESSION still
                // escaped. That cost the enum local its release AND the
                // borrowability of any param read that way, which cost every CALLER
                // its release too: 200 allocs / 0 frees against native's 200/200 on
                // `var v: E = E.A([..]); consume(v);`, where the same helper written
                // with a match STATEMENT was already flat.
                //
                // The strict walker keeps recursing strictly. precise_drop_names
                // reads it and widens to the match-borrow reading for ONE class at a
                // time on purpose; making the value block borrow-aware for everyone
                // silently widened the enum class too, and the plan then claimed a
                // precise drop of a box its own consuming-match reuse still owned.
                if (vb_borrow) {
                    return body_unsafe_for_match_borrow(lm.body, name, borrowable, recv_borrow, []);
                }
                return body_unsafe_for(lm.body, name, borrowable, recv_borrow);
            }
            var used: string[] = [];
            var i: i32 = 0;
            while (i < lm.body.len()) { used = astwalk.collect_idents_stmt(lm.body[i], used); i = i + 1; }
            return util.index_of_str(used, name) >= 0;
        },
        _ => { return false; }
    }
    return false;
}

// param_is_borrowable reports whether param `idx` of free function `name` is
// borrowable per a borrowability registry (see borrow_reg_new for the layout).
// Defaults false (unknown callee / out-of-range index → conservative escape).
//
// One bucket is scanned, not the whole registry. This runs for every call-arg on
// every body walk of every pass of both interproc fixpoints, over a table with
// an entry per function in the module — 1,359 of them for irlower.fern itself —
// so the probe length is what this costs, and bucketing is what bounds it.
//
// Keys are matched by byte comparison, NOT by slicing out `e[p:bar]` and
// comparing strings: the slice allocated a fresh string per record examined, and
// that churn was ~800 MB of the whole-program emit floor (#3457 step 2). The
// length guard rejects a mismatched record before looking at any byte.
function param_is_borrowable(borrowable: string[], name: string, idx: i32): boolean {
    var nb: i32 = borrowable.len();
    // An empty registry is the conservative caller (`none`): nothing borrowable.
    if (nb == 0) { return false; }
    var e: string = borrowable[util.hash_bucket(name, nb)];
    var nl: i32 = name.len();
    var n: i32 = e.len();
    var p: i32 = 0;
    while (p < n) {
        var bar: i32 = p;
        while (bar < n && e[bar] != b'|') { bar = bar + 1; }
        var end: i32 = bar;
        while (end < n && e[end] != b'\n') { end = end + 1; }
        if (bar < n && bar - p == nl) {
            var eq: boolean = true;
            var k: i32 = 0;
            while (eq && k < nl) { if (e[p + k] != name[k]) { eq = false; } k = k + 1; }
            if (eq) {
                var pos: i32 = bar + 1 + idx;
                return pos < end && e[pos] == b'1';
            }
        }
        p = end + 1;
    }
    return false;
}

// struct_lit_rc_field_retained: `src` occurs in `sl` exactly once, at a field
// of declared type `fty`, as a bare ident the construction RETAINS.
//
// The retain is what the forgiveness is buying, so the move site is the gate
// that matters: a store the move analysis claims takes over `src`'s reference
// outright and emits no inc (moves_local_at at the lowering site), which makes
// a release of `src` as well an over-release rather than a leak. Any second
// occurrence anywhere in the literal — another field, the base — refuses: that
// one is some other use the retain does not cover.
function struct_lit_rc_field_retained(sl: ast.ExprStructLit, src: string, structs: parser.StructDecl[], msites: string[], fty: string): boolean {
    var ok: boolean = false;
    var hits: i32 = 0;
    var other: boolean = false;
    var i: i32 = 0;
    while (i < sl.field_values.len()) {
        match (sl.field_values[i]) {
            ast.ExprIdent(fid) => {
                if (fid.name == src) {
                    hits = hits + 1;
                    if (i < sl.field_names.len()
                        && decl_field_type(structs, sl.type_name, sl.field_names[i]) == fty
                        && util.index_of_str(msites, util.i32_to_string(fid.line) + ":" + util.i32_to_string(fid.col)) < 0) { ok = true; }
                }
            },
            _ => { if (expr_mentions_name(sl.field_values[i], src)) { other = true; } }
        }
        i = i + 1;
    }
    if (sl.has_base && expr_mentions_name(sl.base, src)) { other = true; }
    return ok && hits == 1 && !other;
}

// rc_counted_field_sites: the binding SITES of every `var p: T = T { .., f: src, .. }`
// where the field store is a COUNTED share of `src`'s box, for a field of declared
// type `fty`. Handed to the escape walker so the source's bare-ident use there is
// read as the share it is rather than as a store into a container — under "SFLD:"
// in tup_ok for the `string` family, and as the `sfld_ok` list for `string[]`.
//
// The two differ in WHAT the source keeps, not in when it may. A string's release
// is its box, so the share costs nothing extra; a `string[]`'s release is an
// ELEMENT WALK, and the source has to keep the deep class or a path that skips the
// construction walks nothing at all. __fern_str_arr_free's rc gate is what makes
// granting both owners the walk safe: only the one that finds rc 1 performs it.
//
// Three conditions, one per way the pair could come apart. `p` must have earned
// its own struct credit (`credited`), or nothing runs the field drop that gives
// the retain back. T must route field reclaim, or __struct_drop_T carries no
// arm of the right type to reach the field with. And the store must retain rather
// than move (struct_lit_rc_field_retained).
function rc_counted_field_sites(stmts: ast.Stmt[], src: string, structs: parser.StructDecl[], sfok: string[], msites: string[], credited: string[], fty: string, acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprStructLit(sl) => {
                        var vs: string = reclaim_site_key_of(v.name, v.line, v.col);
                        if (util.index_of_str(credited, vs) >= 0
                            && struct_routes_field_reclaim_at(structs, sfok, sl.type_name)
                            && struct_lit_rc_field_retained(sl, src, structs, msites, fty)) {
                            a = push_str_unique(a, vs);
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                a = rc_counted_field_sites(f.then_body, src, structs, sfok, msites, credited, fty, a);
                a = rc_counted_field_sites(f.else_body, src, structs, sfok, msites, credited, fty, a);
            },
            ast.StmtWhile(w) => { a = rc_counted_field_sites(w.body, src, structs, sfok, msites, credited, fty, a); },
            ast.StmtFor(fo) => { a = rc_counted_field_sites(fo.body, src, structs, sfok, msites, credited, fty, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = rc_counted_field_sites(arm.body, src, structs, sfok, msites, credited, fty, a); }
            },
            _ => {}
        }
    }
    return a;
}

// stmt_unsafe_for / body_unsafe_for lift expr_unsafe_for over statements,
// special-casing `for x in name` (a borrow iteration, safe) and recursing into
// nested control-flow bodies. A reassignment of `name` is handled separately by
// the body_assign_targets bail, so StmtAssign only checks the RHS here.
// body_unsafe_for_tup (#4353): body_unsafe_for, except a `var t = (…, name, …)`
// init crediting an rc-tuple this pass already admitted does NOT flag `name` —
// the tuple's element release gives the construction retain back, so the local's
// own box still reaches 0. Every other statement defers to the plain walker.
function body_unsafe_for_tup(stmts: ast.Stmt[], name: string, borrowable: string[], tup_ok: string[], recv_borrow: string[]): boolean {
    var no_alias: string[] = [];
    return body_unsafe_for_tup_alias(stmts, name, borrowable, tup_ok, recv_borrow, no_alias);
}

// body_unsafe_for_tup_alias is body_unsafe_for_tup carrying body_unsafe_for_alias'
// forgiveness: a plain `var v: T = name` bind whose own site key is in `alias_ok`
// does not flag `name`. The parameter rather than a second walker because the two
// forgivenesses are independent and compose — a name may be both a credited
// tuple element and aliased — and a copy of this walker would have to be kept
// in step with the tuple interlock above forever.
function body_unsafe_for_tup_alias(stmts: ast.Stmt[], name: string, borrowable: string[], tup_ok: string[], recv_borrow: string[], alias_ok: string[]): boolean {
    for stmt in stmts {
        var skip: boolean = false;
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    // The construction retains the payload
                    // (rc 2), this sweep's string loop decs the local's ref, and
                    // the element release decs the box's — freed exactly once.
                    // "TUP:" is credited only for a tuple this pass already
                    // credited "TUPRC:", so the element release is emitted; and
                    // tuple_union_payload_sole_use refuses a tuple that mentions
                    // the name anywhere but that one payload position, so a
                    // second, genuinely escaping use is never skipped with it.
                    ast.ExprTuple(_) => {
                        // tup_ok's tuple entries are seeded from the credits, which
                        // carry BINDING-SITE keys (#7272) — so the lookup is keyed on
                        // this `var`'s own site, not on its name.
                        var vsite: string = reclaim_site_key_of(v.name, v.line, v.col);
                        if (util.index_of_str(tup_ok, "TUP:" + vsite) >= 0
                            && tuple_union_payload_sole_use(v.init, name)) { skip = true; }
                        // The BARE-IDENT element twin (#7226's string limb), same
                        // arithmetic one construction shape over: the tuple literal
                        // retains the element (rc 2), this sweep's string loop decs
                        // the local's ref, and the element release decs the box's.
                        // "TUPE:" is credited only for a tuple that earned
                        // "TUPELEMOK:" — so it is non-escaping, annotated, and past
                        // the owned-pointer-extraction gate, which means the element
                        // release IS emitted and the pair balances.
                        //
                        // Ordering makes a classifier mismatch a sound leak rather
                        // than a double free, exactly as it does for the closure
                        // interlock: the exit sweep's tuple loop runs BEFORE its
                        // string loop, so the tuple's dec always precedes the
                        // local's free.
                        if (util.index_of_str(tup_ok, "TUPE:" + vsite) >= 0
                            && tuple_bare_ident_sole_use(v.init, name)) { skip = true; }
                    },
                    // The struct-lit FIELD twin of the two interlocks above, one
                    // construction shape over and the same arithmetic: the literal
                    // retains the string field (rc 2), the struct's field drop decs
                    // the box's reference and this sweep's string loop decs the
                    // local's. "SFLD:" is credited only for a `var p: T = T { .. }`
                    // that earned its own struct credit, whose T routes field
                    // reclaim, and whose store is not a move — so __struct_drop_T
                    // reaches the string arm and the retain has something to give it
                    // back (rc_counted_field_sites).
                    //
                    // Ordering makes a classifier mismatch a sound leak rather than a
                    // double free, as it does for the closure and tuple interlocks:
                    // the exit sweep's struct loop runs BEFORE its string loop, so
                    // the field drop always precedes the local's free.
                    ast.ExprStructLit(_) => {
                        var svsite: string = reclaim_site_key_of(v.name, v.line, v.col);
                        if (util.index_of_str(tup_ok, "SFLD:" + svsite) >= 0) { skip = true; }
                    },
                    _ => {}
                }
            },
            // The ASSIGN-form twin of the bare-ident interlock above (#7226):
            // `t = (k, name)` supersedes a credited tuple's box, and the rebind
            // store's element release gives the construction retain back exactly
            // as the var form's scope-exit sweep does — so this mention is not an
            // escape either. Without it the rebind's element local earned no
            // "STR:" credit, its box was never swept, and the assign-path release
            // gave back only half of what the round owed (80 B/round of 160).
            //
            // Both credits are required because between them they say every
            // position of this tuple releases: "TUPE:" that the element walk is
            // emitted at all, "TUPSW:" that no STRING position of it is left
            // unproven (vacuously true of a tuple with no string position, whose
            // array positions release whichever writer filled them).
            //
            // The credits are BINDING-SITE keyed and an assignment carries no
            // binding site, so the target is matched on the NAME its key holds.
            // A wrong match can only leave the element's reference outstanding —
            // the construction retain is unconditional for a string element, so
            // the local's own free decs a count the tuple's release owed anyway.
            ast.StmtAssign(asg) => {
                if (tup_ok_site_named(tup_ok, "TUPE:", asg.target)
                    && tup_ok_site_named(tup_ok, "TUPSW:", asg.target)
                    && tuple_bare_ident_sole_use(asg.value, name)) { skip = true; }
            },
            ast.StmtIf(iff) => {
                if (!expr_unsafe_for(iff.cond, name, borrowable, recv_borrow)
                    && !body_unsafe_for_tup_alias(iff.then_body, name, borrowable, tup_ok, recv_borrow, alias_ok)
                    && !body_unsafe_for_tup_alias(iff.else_body, name, borrowable, tup_ok, recv_borrow, alias_ok)) { skip = true; }
            },
            ast.StmtWhile(w) => {
                if (!expr_unsafe_for(w.cond, name, borrowable, recv_borrow)
                    && !body_unsafe_for_tup_alias(w.body, name, borrowable, tup_ok, recv_borrow, alias_ok)) { skip = true; }
            },
            _ => {}
        }
        if (!skip && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) { return true; }
    }
    return false;
}

// tup_ok_site_named: `tup_ok` holds an entry `<pfx><site>` whose site key names
// the variable `name`. The site-keyed lookup every other consumer makes is not
// open to an assignment, which carries no binding site of its own; this is the
// name-keyed fallback the assign-form interlock uses instead, and it is sound
// there only because a wrong match leaks rather than over-releases.
function tup_ok_site_named(tup_ok: string[], pfx: string, name: string): boolean {
    var i: i32 = 0;
    while (i < tup_ok.len()) {
        var e: string = tup_ok[i];
        if (e.len() > pfx.len() && bytes_at(e, 0, pfx)
            && reclaim_site_name(slice_unchecked(e, pfx.len(), e.len()) + "") == name) { return true; }
        i = i + 1;
    }
    return false;
}

// alias_bind_sites_of returns the BINDING-SITE keys of every plain
// `var v: T = src` in `body` that may share `src`'s reclaim credit (#7282).
//
// Three conditions, and each rules out a way the shared box could outlive the
// pair. The bind must be a BARE IDENT of `src` — a field read or an index is a
// different value. The alias must not be REASSIGNED, or its final value is not
// the box the credit describes. And the alias must not itself ESCAPE, because
// nothing downstream would account for a third reference.
//
// The result is used two ways at once and they must agree: it forgives `src`'s
// escape (body_unsafe_for_alias) and it copies `src`'s class credit onto each
// alias site. Granting one without the other is the double free — forgiving
// alone leaves two slots sweeping one box at rc 1; copying alone leaves the
// source uncredited and the box unreleased.
//
// This asks the three conditions of ONE bind. alias_chain_sites_of below asks
// them of a whole CHAIN, which is a different question: `var t = p; var u = t;`
// shares one box across three names, and asking them one at a time refuses all
// of them, because the middle link's bare-ident use in the next bind reads as an
// escape (#7386).
// alias_ok_holds_name: any site key in `alias_ok` is for the variable `name`. Used
// by the alias-REASSIGN forgiveness, which has only the target's name to key on.
function alias_ok_holds_name(alias_ok: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < alias_ok.len()) {
        if (reclaim_site_name(alias_ok[i]) == name) { return true; }
        i = i + 1;
    }
    return false;
}

// str_alias_reassign_target_sites: the binding SITES of string locals `t` that are
// reassigned from `src` (`t = src`) and from nothing else uncounted. Handed to the
// escape walker as extra alias_ok entries so the source's bare-ident use at that
// assignment is read as the counted share it now is, and credited alongside it so
// inc and dec stay co-extensive.
//
// Every reassign of `t` must be a bare ident: a field or element read (`t = x.f`,
// `t = xs[i]`) is a borrow of a container's memory that no retain covers, and a
// fresh producer (`t = a + b`) is the consume-rebind that emit_str_reclaim_store
// already owns and which deliberately takes no inc.
function str_alias_reassign_target_sites(stmts: ast.Stmt[], src: string, cands: string[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(asg) => {
                match (asg.value) {
                    ast.ExprIdent(rid) => {
                        if (rid.name == src && asg.target != src
                                && str_all_reassigns_bare_ident(body, asg.target)) {
                            var tsite: string = str_cand_site_of(cands, asg.target);
                            if (tsite.len() > 0) { a = push_str_unique(a, tsite); }
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                a = str_alias_reassign_target_sites(f.then_body, src, cands, body, a);
                a = str_alias_reassign_target_sites(f.else_body, src, cands, body, a);
            },
            ast.StmtWhile(w) => { a = str_alias_reassign_target_sites(w.body, src, cands, body, a); },
            ast.StmtFor(fo) => { a = str_alias_reassign_target_sites(fo.body, src, cands, body, a); },
            ast.StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) { a = str_alias_reassign_target_sites(m.arms[ai].body, src, cands, body, a); ai = ai + 1; }
            },
            _ => {}
        }
    }
    return a;
}

// str_all_reassigns_bare_ident: every assignment to `name` has a bare-ident RHS.
function str_all_reassigns_bare_ident(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (!str_reassign_bare_ok(stmt, name)) { return false; } }
    return true;
}

function str_reassign_bare_ok(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target != name) { return true; }
            match (a.value) {
                ast.ExprIdent(_) => { return true; },
                _ => { return false; }
            }
        },
        ast.StmtIf(f) => { return str_all_reassigns_bare_ident(f.then_body, name) && str_all_reassigns_bare_ident(f.else_body, name); },
        ast.StmtWhile(w) => { return str_all_reassigns_bare_ident(w.body, name); },
        ast.StmtFor(fo) => { return str_all_reassigns_bare_ident(fo.body, name); },
        ast.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) { if (!str_all_reassigns_bare_ident(m.arms[ai].body, name)) { return false; } ai = ai + 1; }
            return true;
        },
        ast.StmtDefer(d) => { return str_reassign_bare_ok(d.action, name); },
        _ => { return true; }
    }
}

// str_cand_site_of: the binding-site key in `cands` for the variable `name`, or "".
function str_cand_site_of(cands: string[], name: string): string {
    var i: i32 = 0;
    while (i < cands.len()) {
        if (reclaim_site_name(cands[i]) == name) { return cands[i]; }
        i = i + 1;
    }
    return "";
}

function alias_bind_sites_of(stmts: ast.Stmt[], src: string, borrowable: string[], recv_borrow: string[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var found: string[] = bare_alias_bind_sites_of(stmts, src, false, []);
    var reasg: string[] = body_assign_targets(body);
    var fi: i32 = 0;
    while (fi < found.len()) {
        var nm: string = reclaim_site_name(found[fi]);
        if (util.index_of_str(reasg, nm) < 0
            && !body_unsafe_for(body, nm, borrowable, recv_borrow)) {
            a = push_str_unique(a, found[fi]);
        }
        fi = fi + 1;
    }
    return a;
}

// alias_chain_sites_of is alias_bind_sites_of over the whole CHAIN — `src` -> `v`
// -> `u` -> … — for the limbs where a chain is measured safe to credit (#7386).
//
// The closure has to be walked RAW, because a link cannot be vetted before the
// links below it are known: `var u = t` is exactly the bare-ident use of `t` that
// the escape scan reads as an escape, so vetting each site on its own refuses
// every chain and, with it, the source. The set is then vetted at once with the
// chain's own binds forgiven.
//
// ALL-OR-NOTHING on purpose: one box is shared by every link, so a link that
// escapes leaves a reference nothing accounts for and taints every release in the
// set. Crediting the ones that happen to check out would release the box under
// that escapee. Only the LINKS are checked here; the source's own escape gate
// belongs to the caller, which passes this result back in as its alias_ok.
//
// The tuple limbs are wired here too (#7750). Their move-on-alias credit
// SURGERY — the "TUPRCS:" deep class migrates to the alias row at a move and
// the alias's "TUP:" row is dropped — leaves a moved-into link holding
// "TUPRCS:" alone, so the retain gate at the NEXT link has to recognise that
// state as a credited source (slot_is_credited_tuple); it did not, which is
// why this credit measured an over-release on the tuple pair before the gate
// was completed.
function alias_chain_sites_of(stmts: ast.Stmt[], src: string, borrowable: string[], recv_borrow: string[], body: ast.Stmt[], acc: string[]): string[] {
    var sites: string[] = [];
    var names: string[] = [src];
    var ni: i32 = 0;
    while (ni < names.len()) {
        var found: string[] = bare_alias_bind_sites_of(stmts, names[ni], false, []);
        var fi: i32 = 0;
        while (fi < found.len()) {
            if (util.index_of_str(sites, found[fi]) < 0) {
                sites = sites.append(found[fi]);
                names = names.append(reclaim_site_name(found[fi]));
            }
            fi = fi + 1;
        }
        ni = ni + 1;
    }
    if (sites.len() == 0) { return acc; }
    var reasg: string[] = body_assign_targets(body);
    var vi: i32 = 1;
    while (vi < names.len()) {
        if (util.index_of_str(reasg, names[vi]) >= 0) { return acc; }
        if (body_unsafe_for_alias(body, names[vi], borrowable, recv_borrow, sites)) { return acc; }
        vi = vi + 1;
    }
    var out: string[] = acc;
    var si: i32 = 0;
    while (si < sites.len()) { out = push_str_unique(out, sites[si]); si = si + 1; }
    return out;
}

// strarr_alias_bind_sites_of is alias_bind_sites_of for the "SARR:" class,
// with one substitution: the alias vets through the strarr gate rather than
// body_unsafe_for, because a string[]'s release WALKS THE ELEMENTS — an
// element escaping from the alias (`var e = x[0]`, `return x[0]`) is invisible
// to the plain walker and would dangle under the deep free.
function strarr_alias_bind_sites_of(stmts: ast.Stmt[], src: string, borrowable: string[], str_fresh: string[], strarr_producers: string[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == src
                            && util.index_of_str(body_assign_targets(body), v.name) < 0
                            && !strarr_unsafe_for(body, v.name, borrowable, str_fresh, strarr_producers)) {
                            a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                a = strarr_alias_bind_sites_of(f.then_body, src, borrowable, str_fresh, strarr_producers, body, a);
                a = strarr_alias_bind_sites_of(f.else_body, src, borrowable, str_fresh, strarr_producers, body, a);
            },
            ast.StmtWhile(w) => { a = strarr_alias_bind_sites_of(w.body, src, borrowable, str_fresh, strarr_producers, body, a); },
            ast.StmtFor(fo) => { a = strarr_alias_bind_sites_of(fo.body, src, borrowable, str_fresh, strarr_producers, body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = strarr_alias_bind_sites_of(arm.body, src, borrowable, str_fresh, strarr_producers, body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// strarr_alias_chain_sites_of is alias_chain_sites_of with strarr's own gate —
// the closure walked raw, then the whole set vetted at once with the chain's own
// binds forgiven (#7750). The substitution is the same one
// strarr_alias_bind_sites_of makes for the single link: a string[]'s release
// WALKS THE ELEMENTS, so an element escaping from any link is invisible to the
// plain walker and would dangle under the deep free.
//
// All-or-nothing, for alias_chain_sites_of's reason: one buffer is shared by
// every link, so a link that escapes taints every release in the set.
function strarr_alias_chain_sites_of(stmts: ast.Stmt[], src: string, borrowable: string[], str_fresh: string[], strarr_producers: string[], body: ast.Stmt[], acc: string[]): string[] {
    var sites: string[] = [];
    var names: string[] = [src];
    var ni: i32 = 0;
    while (ni < names.len()) {
        var found: string[] = bare_alias_bind_sites_of(stmts, names[ni], false, []);
        var fi: i32 = 0;
        while (fi < found.len()) {
            if (util.index_of_str(sites, found[fi]) < 0) {
                sites = sites.append(found[fi]);
                names = names.append(reclaim_site_name(found[fi]));
            }
            fi = fi + 1;
        }
        ni = ni + 1;
    }
    if (sites.len() == 0) { return acc; }
    var reasg: string[] = body_assign_targets(body);
    var vi: i32 = 1;
    while (vi < names.len()) {
        if (util.index_of_str(reasg, names[vi]) >= 0) { return acc; }
        if (strarr_unsafe_for_alias(body, names[vi], borrowable, str_fresh, strarr_producers, sites, [])) { return acc; }
        vi = vi + 1;
    }
    var out: string[] = acc;
    var si: i32 = 0;
    while (si < sites.len()) { out = push_str_unique(out, sites[si]); si = si + 1; }
    return out;
}

// rcenum_alias_bind_sites_of is alias_bind_sites_of for the rc-enum classes,
// with the substitution strarr_alias_bind_sites_of makes for "SARR:": the alias
// vets through the ENUM gate rather than body_unsafe_for, because an rc-enum's
// release DEEP-DROPS THE PAYLOAD — a payload extracted from the alias is
// invisible to the plain walker and would dangle under it (#7687).
function rcenum_alias_bind_sites_of(stmts: ast.Stmt[], src: string, borrowable: string[], structs: parser.StructDecl[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == src
                            && util.index_of_str(body_assign_targets(body), v.name) < 0
                            && !body_unsafe_for_enumfield(body, v.name, borrowable, structs)
                            // …AND the alias must not hand its PAYLOAD out. The
                            // escape scan above reads a bare-ident match scrutinee
                            // as a borrow, which it is for the BOX — but an arm
                            // that binds and returns the rc payload
                            // (`match (x) { Full(xs) => xs }`) moves the payload
                            // out from under the source's deep release. Measured:
                            // without this the shape over-releases
                            // (`__rc_underflow` fires) where stock merely leaks.
                            // This is the same condition the source's own
                            // match-consumed branch applies to itself.
                            && !enum_body_binds_rc_payload(body, v.name, structs)) {
                            a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                a = rcenum_alias_bind_sites_of(f.then_body, src, borrowable, structs, body, a);
                a = rcenum_alias_bind_sites_of(f.else_body, src, borrowable, structs, body, a);
            },
            ast.StmtWhile(w) => { a = rcenum_alias_bind_sites_of(w.body, src, borrowable, structs, body, a); },
            ast.StmtFor(fo) => { a = rcenum_alias_bind_sites_of(fo.body, src, borrowable, structs, body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = rcenum_alias_bind_sites_of(arm.body, src, borrowable, structs, body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// bare_alias_bind_sites_of returns the binding-site key of EVERY plain
// `var v = src` bare-ident bind in `body`, vetted or not — the raw shape both
// alias questions are asked about.
//
// The unmatched-Option gate uses it so "which aliases may share the credit" and
// "was any alias left out" come from one traversal and cannot disagree.
// alias_bind_sites_of uses it to walk the CHAIN: a link is only discoverable
// before it has been vetted, because vetting a link depends on the links below
// it (#7386).
function bare_alias_bind_sites_of(stmts: ast.Stmt[], src: string, want_elem: boolean, acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprIdent(aid) => {
                        if (!want_elem && aid.name == src) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                    },
                    // `var e = src.<i>` — an ELEMENT bind, which is a different
                    // relation from an alias and so a different question (#7766).
                    // Same walk because the two differ only in the init they match,
                    // and one traversal cannot disagree with itself.
                    ast.ExprFieldAccess(efa) => {
                        if (want_elem) {
                            match (efa.obj) {
                                ast.ExprIdent(eoid) => {
                                    if (eoid.name == src && util.is_all_digits(efa.field)) {
                                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                                    }
                                },
                                _ => {}
                            }
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                a = bare_alias_bind_sites_of(f.then_body, src, want_elem, a);
                a = bare_alias_bind_sites_of(f.else_body, src, want_elem, a);
            },
            ast.StmtWhile(w) => { a = bare_alias_bind_sites_of(w.body, src, want_elem, a); },
            ast.StmtFor(fo) => { a = bare_alias_bind_sites_of(fo.body, src, want_elem, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = bare_alias_bind_sites_of(arm.body, src, want_elem, a); }
            },
            _ => {}
        }
    }
    return a;
}

// opt_alias_chain_closure is the transitive closure of bare-ident binds from
// `src` — `src` -> `v` -> `u` -> … — walked RAW. Both Option questions need it
// and must agree: which binds may share the credit, and whether any bind in the
// chain was left unvetted (#7750).
function opt_alias_chain_closure(stmts: ast.Stmt[], src: string): string[] {
    var sites: string[] = [];
    var names: string[] = [src];
    var ni: i32 = 0;
    while (ni < names.len()) {
        var found: string[] = bare_alias_bind_sites_of(stmts, names[ni], false, []);
        var fi: i32 = 0;
        while (fi < found.len()) {
            if (util.index_of_str(sites, found[fi]) < 0) {
                sites = sites.append(found[fi]);
                names = names.append(reclaim_site_name(found[fi]));
            }
            fi = fi + 1;
        }
        ni = ni + 1;
    }
    return sites;
}

// opt_alias_bind_sites_of keeps the CHAIN of binds that may share `src`'s credit
// — alias_bind_sites_of's job for the UNMATCHED Option classes ("OPTARR:" /
// "OPTSTR:" / "OPTOPTRC:"), with the substitution rcenum_alias_bind_sites_of
// makes for enums: no link may hand the PAYLOAD out. Every one of those releases
// is a payload release plus a box dec, and only the box is retained at each bind,
// so an arm that binds and returns the payload moves it out from under the
// source's deep release (#7687).
//
// body_unsafe_for_match_borrow, not body_unsafe_for: the plain walker reads a
// bare-ident match scrutinee as an escape, which would refuse every alias that is
// itself matched — the commonest use of one. That read is right for the payload
// and wrong for the box, and the payload half is the conjunct after it. Same
// pairing opt_match_alias_escape_ok makes.
//
// ALL-OR-NOTHING over the chain (#7750): one box is shared by every link, so a
// link that escapes leaves a reference nothing accounts for and taints every
// release in the set. Each link retains at its bind and releases BOX-ONLY
// ("NODEEP:", see credit_opt_alias_sites) while the source keeps the one deep
// release, so N links mean N extra retains and N extra box decs — the same
// arithmetic the single-link case rests on, with more owners.
function opt_alias_bind_sites_of(body: ast.Stmt[], src: string): string[] {
    var all: string[] = opt_alias_chain_closure(body, src);
    if (all.len() == 0) { return []; }
    var reasg: string[] = body_assign_targets(body);
    var i: i32 = 0;
    while (i < all.len()) {
        var nm: string = reclaim_site_name(all[i]);
        if (util.index_of_str(reasg, nm) >= 0) { return []; }
        if (body_unsafe_for_match_borrow(body, nm, [], [], all)) { return []; }
        if (opt_body_binds_rc_payload(body, nm)) { return []; }
        i = i + 1;
    }
    return all;
}

// credit_opt_alias_sites gives every vetted alias of an admitted unmatched-Option
// local the SAME class credit as its source, qualified by "NODEEP:" so the alias
// releases the BOX ONLY. Each of these classes releases a payload and then the
// box, and the bind retains the box alone — two deep releases would dec the
// payload twice, which for `Option[i32[]]` frees the element buffer under the
// surviving owner. The struct family took the same shape for the same reason.
function credit_opt_alias_sites(body: ast.Stmt[], keys: string[], pfx: string, out: string[]): string[] {
    var o: string[] = out;
    var i: i32 = 0;
    while (i < keys.len()) {
        var sites: string[] = opt_alias_bind_sites_of(body, reclaim_site_name(keys[i]));
        o = credit_alias_sites(o, pfx, sites);
        o = credit_alias_sites(o, "NODEEP:", sites);
        i = i + 1;
    }
    return o;
}

// rcenum_alias_chain_sites_of is rcenum_alias_bind_sites_of over the whole CHAIN
// (#7750) — the closure walked raw, then the set vetted at once with the chain's
// own binds forgiven, exactly as alias_chain_sites_of does for the string and
// struct limbs.
//
// The enum family uses these sites for ESCAPE FORGIVENESS only: a confined alias
// takes no release, so the source stays the sole releaser and the box is freed
// once however long the chain is. That is what makes the widening cheap here —
// no link gains a dec, so the arithmetic the string limb has to reason about
// does not arise. The vetting is still the enum one, because the release
// deep-drops the payload and a payload extracted from ANY link is invisible to
// the plain walker.
function rcenum_alias_chain_sites_of(stmts: ast.Stmt[], src: string, borrowable: string[], structs: parser.StructDecl[], body: ast.Stmt[], acc: string[]): string[] {
    var sites: string[] = [];
    var names: string[] = [src];
    var ni: i32 = 0;
    while (ni < names.len()) {
        var found: string[] = bare_alias_bind_sites_of(stmts, names[ni], false, []);
        var fi: i32 = 0;
        while (fi < found.len()) {
            if (util.index_of_str(sites, found[fi]) < 0) {
                sites = sites.append(found[fi]);
                names = names.append(reclaim_site_name(found[fi]));
            }
            fi = fi + 1;
        }
        ni = ni + 1;
    }
    if (sites.len() == 0) { return acc; }
    var reasg: string[] = body_assign_targets(body);
    var vi: i32 = 1;
    while (vi < names.len()) {
        if (util.index_of_str(reasg, names[vi]) >= 0) { return acc; }
        if (body_unsafe_for_enumfield_alias(body, names[vi], borrowable, structs, sites)) { return acc; }
        if (enum_body_binds_rc_payload(body, names[vi], structs)) { return acc; }
        vi = vi + 1;
    }
    var out: string[] = acc;
    var si: i32 = 0;
    while (si < sites.len()) { out = push_str_unique(out, sites[si]); si = si + 1; }
    return out;
}

// tuple_elem_bind_sites_of returns the binding-site keys of every `var e = src.<i>`
// whose target is a LOCAL that neither is reassigned nor escapes the frame (#7766).
//
// Extracting an rc element hands its reference to a new owner, which is why the
// escape scan refuses the whole tuple credit for it — right for `return src.1`,
// where the element outlives the frame and the deep free would release it under
// the caller. It is wrong for a bind the frame keeps: at the exit sweep `e` is
// dead, so the deep free is releasing memory nothing reads again, and refusing
// costs the tuple BOX its release as well as the element's.
//
// The escape test is the ordinary one on the TARGET, so a bind that is returned,
// stored or handed to a non-borrowable callee is not in this set and the refusal
// stands.
function tuple_elem_bind_sites_of(body: ast.Stmt[], src: string, borrowable: string[]): string[] {
    var all: string[] = bare_alias_bind_sites_of(body, src, true, []);
    var reasg: string[] = body_assign_targets(body);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < all.len()) {
        var nm: string = reclaim_site_name(all[i]);
        if (util.index_of_str(reasg, nm) < 0 && !body_unsafe_for(body, nm, borrowable, [])) {
            out = out.append(all[i]);
        }
        i = i + 1;
    }
    return out;
}

// credit_alias_sites appends `pfx` for every alias site in `sites`, so a shared
// box is released by whichever slot's sweep runs — both hold a counted
// reference and the refcount arbitrates.
function credit_alias_sites(out: string[], pfx: string, sites: string[]): string[] {
    var o: string[] = out;
    var i: i32 = 0;
    while (i < sites.len()) { o = o.append(pfx + sites[i]); i = i + 1; }
    return o;
}

function body_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[]): boolean {
    var no_alias: string[] = [];
    return body_unsafe_for_alias(stmts, name, borrowable, recv_borrow, no_alias);
}

// body_unsafe_for_alias is body_unsafe_for with one forgiveness: a plain
// `var v: T = name` bind whose own site key is listed in `alias_ok` does NOT
// flag `name` (#7282).
//
// The arithmetic that licenses it is DUPLICATION, not transfer. lower_stmt_var's
// ExprIdent arm retains an rc-container source at the bind, so both slots hold a
// counted reference; the alias is credited the source's own class, so both
// sweep, and the box reaches zero exactly once. Forgiving the escape without
// both halves would leave two slots sweeping one box at rc 1 — which is why the
// retain lands first and this gate is keyed on the alias's site rather than on
// its name.
//
// Only a BARE-IDENT init is forgiven, and only at a `var`. Every other mention
// of `name` — a container element, a call argument, a return, a lambda capture,
// a reassignment — still flags, because none of those takes the bind's retain.
function body_unsafe_for_alias(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
    return body_unsafe_for_alias_vb(stmts, name, borrowable, recv_borrow, alias_ok, false);
}
function body_unsafe_for_alias_vb(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], vb_borrow: boolean): boolean {
    for stmt in stmts { if (stmt_unsafe_for_alias_vb(stmt, name, borrowable, recv_borrow, alias_ok, vb_borrow)) { return true; } }
    return false;
}

// body_unsafe_for_alias_ret_ok: body_unsafe_for_alias with the one exemption
// the tuple owned-return admission needs — a bare top-level `return <name>`
// is the move-out the local exists for, not an escape (the ret_ok family's
// rule, alias-aware). Compound statements recurse HERE so a nested return in
// an if-arm is forgiven too; every other statement delegates to the strict
// walker.
function body_unsafe_for_alias_ret_ok(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], bare_ret_ok: boolean): boolean {
    var no_counted: string[] = [];
    return body_unsafe_for_alias_ret_counted(stmts, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, no_counted);
}

// body_unsafe_for_alias_ret_counted is that gate with the counted-store
// forgiveness: a struct literal at a site in `counted_ok` took a COUNTED share
// of `name` (rctuple_counted_field_share), so storing into it is not an escape
// — both owners release, and the box reaches zero exactly once. Keyed by site,
// so the forgiveness cannot outrun the retain that pays for it (#7253).
function body_unsafe_for_alias_ret_counted(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], bare_ret_ok: boolean, counted_ok: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var bare: boolean = false;
                match (r.value) {
                    ast.ExprIdent(rid) => { bare = bare_ret_ok && rid.name == name; },
                    _ => {}
                }
                if (rctuple_counted_store_at(r.value, counted_ok)) { bare = true; }
                if (!bare && expr_unsafe_for(r.value, name, borrowable, recv_borrow)) { return true; }
            },
            ast.StmtVar(v) => {
                if (!rctuple_counted_store_at(v.init, counted_ok)
                        && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) { return true; }
            },
            ast.StmtExpr(e) => {
                if (!rctuple_counted_store_at(e.value, counted_ok)
                        && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) { return true; }
            },
            ast.StmtAssign(asg) => {
                if (!(asg.target != name && rctuple_counted_store_at(asg.value, counted_ok))
                        && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) { return true; }
            },
            ast.StmtIf(f) => {
                if (expr_unsafe_for(f.cond, name, borrowable, recv_borrow)) { return true; }
                if (body_unsafe_for_alias_ret_counted(f.then_body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) { return true; }
                if (body_unsafe_for_alias_ret_counted(f.else_body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (expr_unsafe_for(w.cond, name, borrowable, recv_borrow)) { return true; }
                if (body_unsafe_for_alias_ret_counted(w.body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) { return true; }
            },
            ast.StmtFor(fo) => {
                var fiter: boolean = true;
                match (fo.iter) {
                    ast.ExprIdent(_) => { fiter = false; },
                    _ => { fiter = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow); }
                }
                if (fiter) { return true; }
                if (body_unsafe_for_alias_ret_counted(fo.body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow)) { return true; }
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (m.arms[mi].has_guard && expr_unsafe_for(m.arms[mi].guard, name, borrowable, recv_borrow)) { return true; }
                    if (body_unsafe_for_alias_ret_counted(m.arms[mi].body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) { return true; }
                    mi = mi + 1;
                }
            },
            _ => { if (stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) { return true; } }
        }
    }
    return false;
}
function stmt_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[]): boolean {
    var no_alias: string[] = [];
    return stmt_unsafe_for_alias(st, name, borrowable, recv_borrow, no_alias);
}
function stmt_unsafe_for_alias(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
    return stmt_unsafe_for_alias_vb(st, name, borrowable, recv_borrow, alias_ok, false);
}
function stmt_unsafe_for_alias_vb(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], vb_borrow: boolean): boolean {
    match (st) {
        ast.StmtVar(v) => {
            if (alias_ok.len() > 0) {
                match (v.init) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == name
                            && util.index_of_str(alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0) { return false; }
                    },
                    _ => {}
                }
            }
            return expr_unsafe_for_vb(v.init, name, borrowable, recv_borrow, vb_borrow);
        },
        ast.StmtReturn(r) => { return expr_unsafe_for_vb(r.value, name, borrowable, recv_borrow, vb_borrow); },
        ast.StmtExpr(e) => { return expr_unsafe_for_vb(e.value, name, borrowable, recv_borrow, vb_borrow); },
        ast.StmtAssign(a) => {
            // The REASSIGN twin of the StmtVar alias forgiveness above: `t = name`
            // hands the box to a slot that RETAINS it, so it is a counted share
            // rather than an escape. Only reached when the caller put t's site in
            // alias_ok, which it does only for a target it is about to credit.
            //
            // Matched by NAME rather than by site key, because an assignment
            // carries only the target's name — there is no line/col to key on. The
            // precision loss is bounded and lands in the safe direction: two
            // same-named string locals in sibling blocks share a verdict, and for
            // the STRING class sharing a verdict leaks rather than frees (the
            // struct class, where it would free a live box, is the one #7253 calls
            // out and is not this).
            if (alias_ok.len() > 0) {
                match (a.value) {
                    ast.ExprIdent(rid) => {
                        if (rid.name == name && alias_ok_holds_name(alias_ok, a.target)) { return false; }
                    },
                    _ => {}
                }
            }
            return expr_unsafe_for_vb(a.value, name, borrowable, recv_borrow, vb_borrow);
        },
        ast.StmtIf(f) => {
            if (expr_unsafe_for_vb(f.cond, name, borrowable, recv_borrow, vb_borrow)) { return true; }
            return body_unsafe_for_alias_vb(f.then_body, name, borrowable, recv_borrow, alias_ok, vb_borrow) || body_unsafe_for_alias_vb(f.else_body, name, borrowable, recv_borrow, alias_ok, vb_borrow);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for_vb(w.cond, name, borrowable, recv_borrow, vb_borrow)) { return true; }
            return body_unsafe_for_alias_vb(w.body, name, borrowable, recv_borrow, alias_ok, vb_borrow);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                _ => { iter_unsafe = expr_unsafe_for_vb(fo.iter, name, borrowable, recv_borrow, vb_borrow); }
            }
            if (iter_unsafe) { return true; }
            return body_unsafe_for_alias_vb(fo.body, name, borrowable, recv_borrow, alias_ok, vb_borrow);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for_vb(m.scrutinee, name, borrowable, recv_borrow, vb_borrow)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for_vb(arm.guard, name, borrowable, recv_borrow, vb_borrow)) { return true; }
                if (body_unsafe_for_alias_vb(arm.body, name, borrowable, recv_borrow, alias_ok, vb_borrow)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// body_unsafe_for_match_borrow / stmt_unsafe_for_match_borrow: body_unsafe_for,
// except the SCRUTINEE of a `match (name)` is a BORROW rather than an escape
// (#6127). expr_unsafe_for flags any bare ident, so the consuming match of an
// Option is itself read as an escape — which is right for a value that could be
// retained, and wrong for a match, which reads the tag and the payload and
// retains neither.
//
// consumed_rcpayload_option_frees has always made that argument, via
// name_escapes_outside_stmt skipping the consuming match by INDEX. That works
// only while the match is a top-level statement. precise_drop_names covers the
// case where it is not — the match sits in an `if` or a `while` body — and it
// gates on the coarse body_unsafe_for, so the nested form was refused outright
// and the whole box leaked. Measured over 100 rounds with the nesting as the only
// variable: top-level 0, inside an `if` 8000, inside a `while` 8000.
//
// Only an EXACT bare-ident scrutinee is exempted. `match (f(o))` and a scrutinee
// that merely mentions the name stay escapes, and arm guards and arm bodies are
// still walked in full — as is every other use of the name anywhere in the
// function, so an alias, a return or a call argument still refuses the candidate.
function body_unsafe_for_match_borrow(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
    for stmt in stmts { if (stmt_unsafe_for_match_borrow(stmt, name, borrowable, recv_borrow, alias_ok)) { return true; } }
    return false;
}
function stmt_unsafe_for_match_borrow(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
    match (st) {
        ast.StmtIf(f) => {
            if (expr_unsafe_for_vb(f.cond, name, borrowable, recv_borrow, true)) { return true; }
            return body_unsafe_for_match_borrow(f.then_body, name, borrowable, recv_borrow, alias_ok)
                || body_unsafe_for_match_borrow(f.else_body, name, borrowable, recv_borrow, alias_ok);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for_vb(w.cond, name, borrowable, recv_borrow, true)) { return true; }
            return body_unsafe_for_match_borrow(w.body, name, borrowable, recv_borrow, alias_ok);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },
                _ => { iter_unsafe = expr_unsafe_for_vb(fo.iter, name, borrowable, recv_borrow, true); }
            }
            if (iter_unsafe) { return true; }
            return body_unsafe_for_match_borrow(fo.body, name, borrowable, recv_borrow, alias_ok);
        },
        ast.StmtMatch(m) => {
            var scrut_borrow: boolean = false;
            match (m.scrutinee) {
                ast.ExprIdent(sid) => { if (sid.name == name) { scrut_borrow = true; } },
                _ => {}
            }
            if (!scrut_borrow && expr_unsafe_for_vb(m.scrutinee, name, borrowable, recv_borrow, true)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for_vb(arm.guard, name, borrowable, recv_borrow, true)) { return true; }
                if (body_unsafe_for_match_borrow(arm.body, name, borrowable, recv_borrow, alias_ok)) { return true; }
            }
            return false;
        },
        // The mode rides through the fallback too: a `var t = match (name) { … }`
        // is a StmtVar, so it lands here, and dropping to the strict walker is
        // exactly how the match-EXPRESSION read lost its borrow reading.
        _ => { return stmt_unsafe_for_alias_vb(st, name, borrowable, recv_borrow, alias_ok, true); }
    }
}

// body_unsafe_for_allow_ret / stmt_unsafe_for_allow_ret: the borrow check for the
// SNAPSHOT-param reclaim (#3456 slice 2) — identical to body_unsafe_for except a
// bare `return name` is SAFE (the builder param's final value is MOVED OUT to the
// caller, not retained). Every other unsafe use — an alias `var c = name`, a
// store into a container, a non-borrowable call arg, a slice — is still flagged.
function body_unsafe_for_allow_ret(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[]): boolean {
    for stmt in stmts { if (stmt_unsafe_for_allow_ret(stmt, name, borrowable, recv_borrow)) { return true; } }
    return false;
}
function stmt_unsafe_for_allow_ret(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return expr_unsafe_for(v.init, name, borrowable, recv_borrow); },
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprIdent(_) => { return false; },   // `return name`: move-out, safe
                _ => { return expr_unsafe_for(r.value, name, borrowable, recv_borrow); }
            }
        },
        ast.StmtExpr(e) => { return expr_unsafe_for(e.value, name, borrowable, recv_borrow); },
        ast.StmtAssign(a) => { return expr_unsafe_for(a.value, name, borrowable, recv_borrow); },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, recv_borrow)) { return true; }
            return body_unsafe_for_allow_ret(f.then_body, name, borrowable, recv_borrow) || body_unsafe_for_allow_ret(f.else_body, name, borrowable, recv_borrow);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, recv_borrow)) { return true; }
            return body_unsafe_for_allow_ret(w.body, name, borrowable, recv_borrow);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow); }
            }
            if (iter_unsafe) { return true; }
            return body_unsafe_for_allow_ret(fo.body, name, borrowable, recv_borrow);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, recv_borrow)) { return true; }
                if (body_unsafe_for_allow_ret(arm.body, name, borrowable, recv_borrow)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// --- consume-safe (escape) analysis for consume-rebinds (#3457) ---------------
//
// `infer_param_escapes` port: a free-call CONSUME-REBIND `s = g(.., s, ..)` is a
// safe move (the caller may reclaim the old box after) IFF g neither RETAINS nor
// FREES s's box at that position — it may read / thread / return a value derived
// from it, but never store it into a container / global / longer-lived struct.
// This is the relaxation `body_unsafe_for_allow_ret` lacks (it flags any non-
// borrowable call arg as an escape), and it admits the `s = lower_X(.., s)`
// chains the snapshot-param / snapshot-local reclaim otherwise excludes.

// is_consume_rebind_call: `e` is a free call `g(.., name, ..)` where every direct
// `name` argument sits at a CONSUME-SAFE or BORROWABLE position of g, and no other
// argument lets `name` escape. (Method calls are already safe via the receiver-
// borrow rule, so only free-call rebinds need this.)
function is_consume_rebind_call(e: ast.Expr, name: string, borrowable: string[], consume_safe: string[], recv_borrow: string[]): boolean {
    return consume_rebind_kind(e, name, borrowable, consume_safe, recv_borrow) > 0;
}
// consume_rebind_kind: 0 when `e` is not a consume-rebind call for name; 2 when
// it is and every `name` argument sits at a BORROWABLE position, so the callee
// can neither return nor keep the box; 1 when some position is consume-safe
// only, so the result may carry it.
function consume_rebind_kind(e: ast.Expr, name: string, borrowable: string[], consume_safe: string[], recv_borrow: string[]): i32 {
    match (e) {
        ast.ExprCall(c) => {
            var callee_name: string = "";
            var method: string = "";
            var all_borrow: boolean = true;
            match (c.callee) {
                ast.ExprIdent(cid) => { if (cid.name == name) { return 0; } callee_name = cid.name; },
                // `x.m(.., name, ..)`: the receiver's type is not known here, so a
                // position is consume-safe only when every method of that name
                // agrees (method_param_borrowable_all over the consume-safe
                // registry). The receiver itself is a borrow, as in the strict walk.
                ast.ExprFieldAccess(fa) => {
                    if (ident_name_or_empty(fa.obj).len() == 0) { return 0; }
                    method = fa.field;
                },
                _ => { return 0; }
            }
            var saw_name: boolean = false;
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                var arg_is_name: boolean = false;
                match (c.args[ai]) {
                    ast.ExprIdent(aid) => { if (aid.name == name) { arg_is_name = true; } },
                    _ => {}
                }
                if (arg_is_name) {
                    saw_name = true;
                    if (method.len() > 0) {
                        if (!method_param_borrowable_all(consume_safe, method, ai)) { return 0; }
                        all_borrow = false;
                    } else if (!(param_is_borrowable(consume_safe, callee_name, ai) || param_is_borrowable(borrowable, callee_name, ai))) { return 0; }
                    else if (!(param_is_borrowable(borrowable, callee_name, ai) || param_is_borrowable(borrowable, "CNT:" + callee_name, ai))) { all_borrow = false; }
                } else {
                    if (expr_unsafe_for(c.args[ai], name, borrowable, recv_borrow)) { return 0; }
                }
                ai = ai + 1;
            }
            if (!saw_name) { return 0; }
            if (all_borrow) { return 2; }
            return 1;
        },
        _ => { return 0; }
    }
    return 0;
}

// body_consume_unsafe_for: body_unsafe_for_allow_ret PLUS the consume-rebind
// relaxation — a `name = g(.., name, ..)` whose callee is consume-safe at name's
// position(s) is NOT an escape — and two more:
//
//   - `var q: T = name`, and `var q: R = g(.., name, ..)` with name at a
//     consume-safe position, bind a second name over name's box or over one the
//     callee derived from it. Not an escape when q's own uses all pass this
//     scan, PROVIDED name's own rebinds release nothing (`own_rebinds` false):
//     that is the question the consume-safe registry asks, where the box is the
//     caller's and only the caller releases it. Asked for a snapshot param or
//     local (`own_rebinds` true), whose rebinds do release, the alias stays an
//     escape — a later rebind could free the generation q still names — except
//     as the handback pair `var q: R = g(.., name, ..); name = q.f;`.
//   - `return g(.., name, ..)` with name at a consume-safe position, and
//     `return T { f: name, … }`: the box goes back to the caller inside the
//     result, the move-out a bare `return name` already is.
function body_consume_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], consume_safe: string[], recv_borrow: string[], own_rebinds: boolean): boolean {
    return body_consume_unsafe_seen(stmts, name, borrowable, consume_safe, recv_borrow, own_rebinds, [name]);
}
// body_consume_unsafe_seen carries the names whose uses this scan has already
// walked. A derived local is walked once per scan, not once per path the alias
// graph reaches it by: with every parameter presumed safe on the registry's
// first pass, each `var x: T = f(.., name, ..)` is a candidate, and the paths
// through a function with dozens of them are exponential — the self-host's own
// build went from 80 s to never finishing. A name already walked was either
// found safe or is an ancestor still being walked, and a real escape aborts the
// whole scan at the statement that has it whichever walk meets it first.
function body_consume_unsafe_seen(stmts: ast.Stmt[], name: string, borrowable: string[], consume_safe: string[], recv_borrow: string[], own_rebinds: boolean, seen: string[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        var stmt: ast.Stmt = stmts[i];
        var q: string = consume_alias_bound_by(stmt, name, borrowable, consume_safe, recv_borrow);
        if (q.len() > 0) {
            if (q == name) { return true; }
            if (util.index_of_str(seen, q) < 0
                && body_consume_unsafe_seen(stmts, q, borrowable, consume_safe, recv_borrow, false, seen.append(q))) { return true; }
            // The handback: `var st: R = g(.., name, ..); name = st.f;` — the callee
            // returned name's box, or one derived from it, inside a fresh result the
            // very next statement unpacks back into name. No rebind of name lies
            // between the two, so nothing st shares with name's box is released
            // before name holds it again; from then on the two are one lineage.
            var handback: boolean = i + 1 < stmts.len() && ident_name_or_empty(v_init_field_obj(stmts[i + 1], name)) == q;
            // The last use: `var q: T = g(.., name, ..)` binds the last value
            // derived from name's box, and the lowering releases that box at the
            // same statement (release_last_use_source) — a move-out, as a bare
            // `return name` is.
            var lastuse: boolean = own_rebinds && !handback
                && reclaim_site_name(last_use_consumer_in(stmts, name, var_annot_at_top(stmts, name), borrowable, consume_safe)) == q;
            if (!own_rebinds || handback || lastuse) { i = i + 1; continue; }
            return true;
        }
        if (stmt_consume_unsafe_for(stmt, name, borrowable, consume_safe, recv_borrow, own_rebinds, seen)) { return true; }
        i = i + 1;
    }
    return false;
}

// v_init_field_obj: the object of a field read `name = obj.f` at `st`, else an
// empty-named ident.
function v_init_field_obj(st: ast.Stmt, name: string): ast.Expr {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target == name) {
                match (a.value) {
                    ast.ExprFieldAccess(fa) => { return fa.obj; },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return ast.ExprIdent { name: "", line: 0, col: 0, ty: "" };
}

// consume_alias_bound_by: the local a `var q: T = name` / `var q: R = g(.., name, ..)`
// binds over name's box, else "". The call form counts only where g may hand
// the box back — name at a consume-safe position that is NOT borrowable
// (consume_rebind_kind 1); at a borrowable one the callee can neither return
// nor keep it, so q holds nothing of name's and the binding is the plain borrow
// the strict walk already admits.
function consume_alias_bound_by(st: ast.Stmt, name: string, borrowable: string[], consume_safe: string[], recv_borrow: string[]): string {
    match (st) {
        ast.StmtVar(v) => {
            if (v.type_name.len() == 0) { return ""; }
            if (ident_name_or_empty(v.init) == name) { return v.name; }
            if (consume_rebind_kind(v.init, name, borrowable, consume_safe, recv_borrow) == 1) { return v.name; }
            return "";
        },
        // `q = g(.., name, ..)` into ANOTHER local is the same binding one
        // statement later than its declaration.
        ast.StmtAssign(a) => {
            if (a.target == name) { return ""; }
            if (consume_rebind_kind(a.value, name, borrowable, consume_safe, recv_borrow) == 1) { return a.target; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

function stmt_consume_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], consume_safe: string[], recv_borrow: string[], own_rebinds: boolean, seen: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return expr_unsafe_for(v.init, name, borrowable, recv_borrow); },
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprIdent(_) => { return false; },   // `return name`: move-out, safe
                ast.ExprStructLit(rsl) => {
                    if (rsl.has_base && ident_name_or_empty(rsl.base).len() == 0 && expr_unsafe_for(rsl.base, name, borrowable, recv_borrow)) { return true; }
                    for fv in rsl.field_values {
                        if (ident_name_or_empty(fv) != name && expr_unsafe_for(fv, name, borrowable, recv_borrow)) { return true; }
                    }
                    return false;
                },
                _ => {
                    if (is_consume_rebind_call(r.value, name, borrowable, consume_safe, recv_borrow)) { return false; }
                    return expr_unsafe_for(r.value, name, borrowable, recv_borrow);
                }
            }
        },
        ast.StmtExpr(e) => { return expr_unsafe_for(e.value, name, borrowable, recv_borrow); },
        ast.StmtAssign(a) => {
            if (a.target == name && is_consume_rebind_call(a.value, name, borrowable, consume_safe, recv_borrow)) { return false; }
            return expr_unsafe_for(a.value, name, borrowable, recv_borrow);
        },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, recv_borrow)) { return true; }
            return body_consume_unsafe_seen(f.then_body, name, borrowable, consume_safe, recv_borrow, own_rebinds, seen) || body_consume_unsafe_seen(f.else_body, name, borrowable, consume_safe, recv_borrow, own_rebinds, seen);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, recv_borrow)) { return true; }
            return body_consume_unsafe_seen(w.body, name, borrowable, consume_safe, recv_borrow, own_rebinds, seen);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow); }
            }
            if (iter_unsafe) { return true; }
            return body_consume_unsafe_seen(fo.body, name, borrowable, consume_safe, recv_borrow, own_rebinds, seen);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, recv_borrow)) { return true; }
                if (body_consume_unsafe_seen(arm.body, name, borrowable, consume_safe, recv_borrow, own_rebinds, seen)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// all_i32_number_elems reports whether every element of an array literal is a
// non-float number literal — i.e. the literal is a pure i32[] (the only element
// type precise drops handle: scalar values whose buffer free needs no element
// walk and whose methods don't keep the buffer live).
// all_fresh_string_elems reports whether every element of an array literal is a
// FRESH string — a literal (const_str allocs a fresh box per construction) or a
// fresh producer (concat / named producer / string-method copy), the same rule
// rcpayload_option_cand applies to a bare `string` payload, one level down.
// Freshness has to hold PER ELEMENT because __fern_str_arr_free releases each
// element box: one aliased element would be freed out from under its owner,
// where the scalar-array case only ever frees the one buffer it was handed.
// An empty literal is refused — nothing to reclaim, and admitting it would put
// the drop on a shape whose element type is unknowable from the literal.
function all_fresh_string_elems(elems: ast.Expr[]): boolean {
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        var fresh: boolean = false;
        match (elems[i]) {
            ast.ExprString(_) => { fresh = true; },
            _ => { fresh = str_local_binding_is_fresh(elems[i]); }
        }
        if (!fresh) { return false; }
        i = i + 1;
    }
    return true;
}

function all_i32_number_elems(elems: ast.Expr[]): boolean {
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        match (elems[i]) {
            ast.ExprNumber(num) => { if (num.is_float) { return false; } },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// all_f64_number_elems reports whether every element of an array literal is a
// FLOAT number literal — i.e. the literal is a pure f64[]. Like i32[]/i64[], an
// f64[] buffer holds only scalars (no nested pointers), so a sole-owner early
// free is sound and needs no element walk. (i64[] literals are written with the
// same non-float syntax as i32[] and are already caught by all_i32_number_elems;
// the slot's is_i64arr flag distinguishes them at emission.)
function all_f64_number_elems(elems: ast.Expr[]): boolean {
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        match (elems[i]) {
            ast.ExprNumber(num) => { if (!num.is_float) { return false; } },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// all_scalar_literal_args reports whether every argument of a call is a scalar
// LITERAL (number / boolean / string) — so the call passes NO array, hence its
// result cannot be an alias/view of a caller-live array (it is a fresh owned
// buffer). Used to admit `var v = build(100)` array-returning free calls as
// precise-drop candidates.
function all_scalar_literal_args(args: ast.Expr[]): boolean {
    var i: i32 = 0;
    while (i < args.len()) {
        match (args[i]) {
            ast.ExprNumber(_) => {},
            ast.ExprBool(_) => {},
            ast.ExprString(_) => {},
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// call_returns_scalar_array reports whether a free function `name` returns a
// SCALAR-element array (i32[] / i64[] / f64[]) — in the array-returning registry
// but NOT in the string[] one. Such a call's fresh result is a precise-drop
// candidate (a flat scalar buffer, sole owner, freeable shallowly). string[] is
// excluded HERE, at candidacy, because admitting it crashed the self-host (its
// element-pointer buffer + view-returning methods); a NESTED-array return is in
// `arr` and admitted here but rejected by the emission-site is_arrarr guard (its
// buffer holds array pointers needing an element walk), so no nested drop is
// emitted.
function call_returns_scalar_array(name: string, arr: SigReg, strarr: SigReg): boolean {
    return sig_reg_has_exact(arr, name) && !sig_reg_has_exact(strarr, name);
}

// struct_lit_precise_ok reports whether `slit` is a FRESH struct literal that a
// precise drop can reclaim exactly like the exit sweep (emit_struct_field_drops +
// a shallow box dec): every declared field is present and is either a flat SCALAR
// (is_scalar_type_name) initialised by a scalar literal, OR a leak-safe ARRAY field
// (is_leaksafe_array_field) initialised by a FRESH scalar-number array literal. The
// literal-only field values keep the box the SOLE owner (rc==1) of each array — an
// aliased field would need the construction alias-inc/field-drop balance the exit
// sweep relies on, so it is excluded here (conservative). String / nested-struct /
// enum / map / option / tuple fields are excluded (their precise deep-drop is a
// separate concern). Field order is resolved by name (field_names), so a reordered
// `Buf { n: 3, xs: [..] }` maps correctly. A struct-update base (`{ ...d }`) is
// rejected by the caller (has_base). Subsumes the scalar-only case (a struct with
// only scalar fields + scalar-literal values passes).
function struct_lit_precise_ok(structs: parser.StructDecl[], slit: ast.ExprStructLit): boolean {
    var sty: string = slit.type_name;
    if (!decl_is_struct(structs, sty)) { return false; }
    if (slit.field_names.len() != slit.field_values.len()) { return false; }
    if (slit.field_values.len() != decl_field_count(structs, sty)) { return false; }
    var i: i32 = 0;
    while (i < slit.field_values.len()) {
        var ft: string = decl_field_type(structs, sty, slit.field_names[i]);
        if (is_leaksafe_array_field(ft)) {
            var okarr: boolean = false;
            match (slit.field_values[i]) {
                ast.ExprArray(arrl) => { okarr = all_i32_number_elems(arrl.elements) || all_f64_number_elems(arrl.elements); },
                _ => {}
            }
            if (!okarr) { return false; }
        } else if (is_scalar_type_name(ft)) {
            var oksc: boolean = false;
            match (slit.field_values[i]) {
                ast.ExprNumber(_) => { oksc = true; },
                ast.ExprBool(_) => { oksc = true; },
                _ => {}
            }
            if (!oksc) { return false; }
        } else {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// PreciseDrops is the result of precise_drop_names: two PARALLEL arrays — for
// each precise drop, the top-level body-statement index AFTER which to release
// the array, and the local name to release. (A flat pair, not a `string[][]`,
// because the self-host compiler can't yet compile a nested string-array
// `.append` on itself — the fixpoint link gate caught it.)
// `kinds[i]` selects the emission-site free for drop i: "" = the type-based branches
// (array / scalar struct / tuple, dispatched by slot flags); "box-shallow" = a scalar
// Option/Result/enum box (a plain __fern_rc_dec — the scalar payload is an inline
// value, so no field/element walk); "opt-rcpayload" = an rc-payload Option/Result
// (emit_opt_payload_drop: op_opt_payload → payload dec → box dec);
// "opt-structpayload:<P>" = an Option/Result whose payload is a struct with
// rc-array fields (#6127 — emit_opt_struct_payload_drop: op_opt_payload →
// __struct_drop_<P> → payload dec → box dec, the struct name riding in the kind);
// "opt-payloadfree:<helper>"
// = an Option/Result whose payload needs a release a plain rc-dec does not give
// (#4355 string, #6495 string[] — emit_opt_payload_drop_via: op_opt_payload →
// <helper> → box dec, the helper name riding in the kind); "enum-rcpayload:<E>"
// = an rc-payload user enum (emit_enum_variant_drops: runtime variant-dispatch deep-
// drop of enum <E>, whose name rides in the kind). Carrying the kind lets the emission
// free a box whose type the slot alone can't classify — a Result box (Ok-vs-Err
// payload ambiguous), an un-annotated enum box (no struct_type), or the enum name for
// the variant deep-drop.
struct PreciseDrops { idxs: i32[], names: string[], kinds: string[] }

// precise_drop_names computes the array-literal LOCAL drop-on-last-use points: a
// name qualifies only if its init is a fresh `[ ... ]` literal, it is declared
// exactly once (not shadowed), never reassigned anywhere, and never used
// unsafely (body_unsafe_for is false — i.e. only borrow reads). Its drop point
// is its LAST top-level statement reference; releasing after that whole
// statement completes is sound even when the last reference sits inside a
// nested block.
function precise_drop_names(body: ast.Stmt[], structs: parser.StructDecl[], arr_ret: SigReg, strarr_ret: SigReg, borrowable: string[], opt_fresh_reg: SigReg, str_fresh: string[], msites: string[]): PreciseDrops {
    var idxs: i32[] = [];
    var names: string[] = [];
    var kinds: string[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var seen: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                // Candidate inits — both produce a FRESH OWNED scalar-element
                // buffer that is not an alias/view of a live value (so a sole-owner
                // early free is sound): a pure SCALAR-NUMBER array literal (i32[] /
                // i64[] via all_i32_number_elems, f64[] via all_f64_number_elems —
                // all flat scalar buffers, no nested pointers), or a FREE call (not
                // a method — a method like `.slice()` could return a view of its
                // receiver) that returns a scalar-element array
                // (call_returns_scalar_array: i32[]/i64[]/f64[]) with all-scalar-
                // literal args (so it passes no array to alias). string[] / nested-
                // array inits stay excluded (their buffers hold pointers needing an
                // element walk, and a string[] init crashed the self-host); the
                // emission-site slot guard enforces this.
                var is_lit: boolean = false;
                match (v.init) {
                    // A `dyn T[]` binding is EXCLUDED even when every element is
                    // a number literal (#4351 slice 3): each element lowers
                    // through op_dyn_box, so the buffer holds CELL POINTERS —
                    // the shallow early dec here would strand the cells the
                    // exit sweep's DARR element walk is supposed to release
                    // (the drop zeroes the slot, so the walk never runs).
                    ast.ExprArray(arrl) => {
                        is_lit = (all_i32_number_elems(arrl.elements) || all_f64_number_elems(arrl.elements))
                            && !(v.type_name.len() > 4 && slice_unchecked(v.type_name, 0, 4) == "dyn ");
                    },
                    ast.ExprCall(c) => {
                        match (c.callee) {
                            ast.ExprIdent(cid) => {
                                if (call_returns_scalar_array(cid.name, arr_ret, strarr_ret) && all_scalar_literal_args(c.args)) { is_lit = true; }
                            },
                            _ => {}
                        }
                    },
                    // A FRESH struct literal (`var p = P { x: 1, y: 2 }` /
                    // `var b = Buf { xs: [1,2,3], n: 3 }`) is a precise-drop candidate:
                    // struct_lit_precise_ok admits a scalar-only struct AND one whose
                    // fields are flat scalars + leak-safe arrays initialised by fresh
                    // literals (sole owner). The precise drop then deep-drops the array
                    // fields (emit_struct_field_drops) + shallow-frees the box, EXACTLY
                    // like the exit sweep but earlier — bounding peak heap (the struct
                    // sibling of the array / tuple precise drops). A struct-update base
                    // (`{ ...d, .. }`) is excluded (its box may alias d). The emission
                    // re-checks slot_is_reclaimable_struct + the reuse-donor guards.
                    ast.ExprStructLit(slit) => {
                        if (!slit.has_base && struct_lit_precise_ok(structs, slit)) { is_lit = true; }
                    },
                    // A FRESH scalar tuple literal (`var t = (3, 4)`, all scalar-
                    // literal elements) is a precise-drop candidate too — same as the
                    // scalar-only struct: the rc-headered box (tuple_make → arr_box)
                    // owns no pointer, so freeing it right after its last borrow-read
                    // is a single shallow __fern_rc_dec that dangles nothing. The
                    // emission-site slot guard (slot_is_reclaimable_tuple) re-checks.
                    ast.ExprTuple(_) => {
                        if (tuple_lit_is_fresh_scalar(v.init)) { is_lit = true; }
                    },
                    _ => {}
                }
                // Four more precise-drop candidate kinds follow, one per fresh
                // Option/enum shape. All four share the no-top-level-match
                // disjointness rule that body_has_top_level_match documents; the
                // comment on each records only what is particular to it.
                //
                // A fresh SCALAR Option/Result (`var o = Some(5)` / `None`): the
                // rc-headered box (opt_make / opt_none) is shallow-freed after the
                // statement holding its last use. The emission re-checks the slot
                // (opt_type_of_slot + type_is_scalar_option) before freeing.
                // A call to an OPTFRESH-proven producer counts as fresh here on the
                // same footing as an inline ctor, which is what consumed_scalar_enum_frees
                // already does for its own (FLAT-match) half of this shape.
                var is_opt: boolean = false;
                if (!is_lit && (fresh_scalar_option_init(v) || fresh_scalar_option_call_init(v, opt_fresh_reg))) {
                    is_opt = !body_has_top_level_match(body, v.name);
                }
                // A fresh rc-PAYLOAD Option/Result (`var o = Some([..])` / `Ok(P{..})`).
                // Additionally the nested consuming match must BORROW, not escape, the
                // constructed variant's payload binding (opt_body_binding_escapes):
                // body_unsafe_for proves only that the OPTION does not escape, not its
                // bound payload. Result is admitted alongside Option because
                // emit_opt_payload_drop reads offset-8 — the constructed variant's
                // pointer payload either way — and the "opt-rcpayload" kind tells the
                // emission it is a pointer, which the slot type Result[T, E] alone
                // cannot (an Ok-array box and an Err-scalar box spell the same).
                var is_rcopt: boolean = false;
                var rcopt_pfree: string = "__fern_rc_dec";
                var rcopt_sty: string = "";
                if (!is_lit && !is_opt) {
                    var rcc: OptRcCand = rcpayload_option_cand(v, structs);
                    if (rcc.variant != "") {
                        if (!body_has_top_level_match(body, v.name)
                                && !opt_body_binding_escapes(body, v.name, rcc.variant, type_is_scalar_union(rcc.ptype))) {
                            is_rcopt = true;
                            rcopt_pfree = opt_payload_freefn(rcc.ptype);
                            rcopt_sty = opt_payload_deep_sty(rcc.ptype, structs);
                            if (rcopt_sty.len() > 0 && opt_body_field_moved(body, v.name, rcc.variant, rcopt_sty, structs)) { rcopt_sty = ""; }
                        }
                    }
                }
                // A fresh SCALAR user-enum (`var x = Circle(7)` of an all-scalar-variant
                // enum). Because the top-level-match case belongs to
                // consumed_scalar_enum_frees, which also feeds the donor/reuse paths, a
                // candidate admitted here is NEVER a reuse donor — so no donor guard is
                // needed. Its box is shallow-freed under kind "box-shallow", and that
                // kind IS the witness, so the slot needs no struct_type: an unannotated
                // `var x = Circle(7)` is reclaimed too.
                var is_enum: boolean = false;
                if (!is_lit && !is_opt && !is_rcopt && fresh_scalar_enum_init(v.init, structs) != "") {
                    is_enum = !body_has_top_level_match(body, v.name);
                }
                // A fresh rc-PAYLOAD user-enum (`var x = Poly([..])` — a variant carrying
                // a leak-safe array or deep-drop-ok struct payload). Additionally no arm
                // may bind an rc payload that escapes (enum_body_binds_rc_payload). The
                // enum NAME rides in the kind ("enum-rcpayload:<Enum>") so
                // emit_enum_variant_drops can dispatch the right variant deep-drop.
                var rcenum_owner: string = "";
                if (!is_lit && !is_opt && !is_rcopt && !is_enum) {
                    var eo: string = fresh_rcpayload_enum_init(v.init, structs, str_fresh, msites, false);
                    if (eo != "") {
                        if (!body_has_top_level_match(body, v.name) && !enum_body_binds_rc_payload(body, v.name, structs)) { rcenum_owner = eo; }
                    }
                }
                var is_rcenum: boolean = rcenum_owner != "";
                // A fresh MAP local (`var m = Map { … }` / `map_new()`) last-used in a
                // nested block, non-escaping + non-iterated, is a precise-drop candidate
                // too — the map sibling of the exit-sweep reclaim (which frees the same
                // keys/values buffers, just at function exit). emit_map_buffers_free
                // null-guards + zeroes the slot, so the precise drop here and the exit
                // sweep's re-call coexist (the second sees null and skips). Same gates
                // as the "MAP:" exit set: fresh init, not aliased, not iterated (the
                // outer `if` adds not-reassigned + non-escaping).
                var is_map: boolean = false;
                if (!is_lit && !is_opt && !is_rcopt && !is_enum && !is_rcenum && is_fresh_map_init(v.init)) {
                    if (util.index_of_str(aliased_array_names_of(body), v.name) < 0 && !map_has_explicit_iter(body, v.name)
                        && !map_identity_escape(body, v.name)) { is_map = true; }
                }
                var shadowed: boolean = util.index_of_str(seen, v.name) >= 0;
                seen = seen.append(v.name);
                // The reassigned gate: maps admit the sanctioned COW self-reassign
                // (`m = m.insert(k, v)` — map_nonself_reassigned, the same carve-out
                // as the "MAP:" exit set / #4357): insert mutates the SAME box in
                // place, so the slot value is unchanged and the precise drop after
                // the last use still frees exactly one live box. Every other
                // candidate kind keeps the blanket not-reassigned gate.
                var reassign_ok: boolean = util.index_of_str(reassigned, v.name) < 0;
                if (!reassign_ok && is_map && !map_nonself_reassigned(body, v.name)) { reassign_ok = true; }
                // An rc-payload Option/Result gets the match-scrutinee-is-a-borrow
                // reading (#6127); every other candidate kind keeps the coarse walker,
                // so this widens exactly one class at a time.
                var borrow_ok: boolean = !body_unsafe_for(body, v.name, borrowable, []);
                if (!borrow_ok && (is_rcopt || is_opt)) { borrow_ok = !body_unsafe_for_match_borrow(body, v.name, borrowable, [], []); }
                if ((is_lit || is_opt || is_rcopt || is_enum || is_rcenum || is_map) && !shadowed && reassign_ok && borrow_ok) {
                    var last: i32 = 0 - 1;
                    var k: i32 = i + 1;
                    var none: string[] = [];
                    while (k < body.len()) {
                        if (util.index_of_str(astwalk.collect_idents_stmt(body[k], none), v.name) >= 0) { last = k; }
                        k = k + 1;
                    }
                    if (last > i) {
                        var kind: string = "";
                        if (is_rcopt && rcopt_pfree != "__fern_rc_dec") { kind = "opt-payloadfree:" + rcopt_pfree; }
                        else if (is_rcopt && rcopt_sty.len() > 0) { kind = "opt-structpayload:" + rcopt_sty; }
                        else if (is_rcopt) { kind = "opt-rcpayload"; }
                        else if (is_opt || is_enum) { kind = "box-shallow"; }
                        else if (is_rcenum) { kind = "enum-rcpayload:" + rcenum_owner; }
                        else if (is_map) { kind = "map-buffers"; }
                        idxs = idxs.append(last);
                        names = names.append(v.name);
                        kinds = kinds.append(kind);
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return PreciseDrops { idxs: idxs, names: names, kinds: kinds };
}

// emit_scalar_enum_box_free releases a consumed scalar-enum / scalar-Option
// local's box: a shallow dec (every payload is a scalar, so there is nothing to
// walk) then zero the slot.
//
// Zeroing is what keeps the three emission sites disjoint. The post-match site,
// its lower_block mirror, and the return-path sweep each claim the same
// candidate, and on any one dynamic path at most one of them is reached; a
// zeroed slot makes a second dec a no-op, since __fern_rc_dec is null-safe.
function emit_scalar_enum_box_free(s: LowerState, slot: i32): LowerState {
    var st: LowerState = s.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_const_i32(0));
    return st.emit(ir.op_store_local(slot));
}

// rcenum_pending_entry encodes an rc-payload enum's return-path release as one
// optret_pending entry: "<slot>#e<enum>;<moved…>". The deep-drop needs the enum
// NAME (to walk its variants) and the MOVED set (fields an escaping arm binding
// now owns), and both are only in hand at the match statement, not at the
// `return` that has to emit the release. ';' is a safe separator: an enum name
// and a "<Variant>#<index>" moved entry are both identifier-and-digit text.
function rcenum_pending_entry(slot: i32, enum_name: string, moved: string[]): string {
    var ent: string = util.i32_to_string(slot) + "#e" + enum_name;
    var mi: i32 = 0;
    while (mi < moved.len()) {
        ent = ent + ";" + moved[mi];
        mi = mi + 1;
    }
    return ent;
}

// split_semi is rcenum_pending_entry's inverse: the enum name first, then each
// moved entry.
function split_semi(s: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == b';') {
            out = out.append(slice_unchecked(s, start, i) + "");
            start = i + 1;
        }
        i = i + 1;
    }
    return out.append(slice_unchecked(s, start, s.len()) + "");
}

// scrutinee_owns_no_surviving_claim reports whether the enum box a match arm
// binds its payload out of has NO owner that outlives the call — the question
// the escaping return of that binding turns on (#8070). Two shapes qualify:
//
//   * a box THIS FRAME BUILT, carrying the "FRESHBOX:" credit
//     frame_constructed_enum_names_of leaves. The consuming match's
//     moved-payload skip hands the field over and the box is dropped on the way
//     out, so the buffer's single claim leaves with the returned value.
//     EXCEPT one: a box the exit sweep will deep-free (credited "RCENUMS:", the
//     no-consuming-match half) does dec the payload on the return path, so its
//     escaping value still needs a count of its own.
//
//   * a NON-BORROWABLE parameter. Returning an arm binding out of `match (p)`
//     is itself what param_match_binding_escapes refuses borrowability for, so
//     the caller cannot release that argument and strands the box — its claim
//     on the payload is never dec'd by anyone, which makes the returned value
//     the only live owner. Retaining on top strands the buffer as well, which
//     is one extra unfreed allocation per call.
//
// Everything else answers false and keeps the retain: a BORROWABLE param, whose
// caller does release the box; a local that merely aliases one (`var cur = root`
// descending a trie), where the owner outside is untouched; a field read; any
// shape the scan cannot resolve. That is the safe side — a needless retain
// leaks, a missing one is a use-after-free.
function scrutinee_owns_no_surviving_claim(scrut: ast.Expr, s: LowerState): boolean {
    match (scrut) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0) { return false; }
            if (sl < s.n_params) {
                return !param_is_borrowable(s.sigs.borrowable_params, s.cur_fn, sl);
            }
            if (slot_is_reclaimable_rcenum_sweep(s, sl)) { return false; }
            return reclaim_has(s.reclaimable_names, "FRESHBOX:", s.reclaim_site_key(sl));
        },
        _ => { return false; }
    }
}

// slot_list_has reports whether slot index `v` is in `xs` — the keep-set
// membership test for emit_dec_sweep_except_list.
function slot_list_has(xs: i32[], v: i32): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == v) { return true; }
        i = i + 1;
    }
    return false;
}

// emit_dec_sweep_except is the single-keep wrapper retained for its many call
// sites: keep < 0 means "sweep everything", keep >= 0 keeps exactly that slot.
pub function emit_dec_sweep_except(s: LowerState, keep: i32): LowerState {
    var keeps: i32[] = [];
    if (keep >= 0) { keeps = keeps.append(keep); }
    return emit_dec_sweep_except_list(s, keeps);
}

// emit_dec_sweep_except_list is the move-on-return sweep generalised to a SET of
// kept slots: a returned value can MOVE more than one array local out (e.g.
// `return Many(items)` moves `items` into the leaking enum box; a struct literal
// `S { a: Many(x), b: Many(y) }` moves both). Each kept slot's buffer now backs
// an escaping value, so decing it here would free it out from under the caller —
// #3720: a function returning an array-payload enum built from a LOCAL array
// (`var a = [...]; return Many(a)`) freed `a` in the exit sweep while the
// returned box still pointed at it, so a later allocation that recycled the
// buffer corrupted the box (a use-after-free that surfaced as a SIGSEGV only once
// the freed memory was reused — e.g. a second `append` that grew the holding
// array). Excluding the moved slots leaves the buffer alive: it leaks WITH the
// enum box, consistent with the IR leak-mode invariant that an enum box and its
// payload are never swept.
pub function emit_dec_sweep_except_list(s: LowerState, keeps: i32[]): LowerState {
    var st: LowerState = s;
    // Pending consumed-match drops (#4353 p1/p3, #6219): a `return` inside a
    // candidate's match arm runs this sweep, so drop the pending payload + box
    // here — the post-match drop site is dead code on this path. The drop
    // zeroes the slot; entries are "slot#b" (scalar-enum or scalar-Option box,
    // shallow dec) / "slot#e<enum>;<moved…>" (rc-payload enum, runtime variant
    // dispatch — rcenum_pending_entry) / the five Option/Result forms
    // optret_opt_entry writes. Empty outside candidate arms (set/restored
    // around the match), so the fn-end sweep and every unrelated return are
    // byte-unchanged.
    //
    // The Option/Result branches below mirror the post-match dispatch in
    // lower_func / lower_block ARM FOR ARM. They have to: the two sites are
    // alternatives on disjoint paths, so a release the return path spells more
    // shallowly is a leak nothing else picks up (#7725).
    var opi: i32 = 0;
    while (opi < st.optret_pending.len()) {
        var ope: string = st.optret_pending[opi];
        var oph: i32 = 0;
        while (oph < ope.len() && ope[oph] != b'#') { oph = oph + 1; }
        var opslot: i32 = util.digits_to_i32(slice_unchecked(ope, 0, oph) + "");
        if (opslot >= st.n_params) {
            if (oph + 1 < ope.len() && ope[oph + 1] == b'b') {
                st = emit_scalar_enum_box_free(st, opslot);
            } else if (oph + 1 < ope.len() && ope[oph + 1] == b'e') {
                var eparts: string[] = split_semi(slice_unchecked(ope, oph + 2, ope.len()) + "");
                var emoved: string[] = [];
                var emi: i32 = 1;
                while (emi < eparts.len()) { emoved = emoved.append(eparts[emi]); emi = emi + 1; }
                st = emit_enum_variant_drops_gated(st, opslot, eparts[0], emoved, true);
            } else if (oph + 1 < ope.len() && ope[oph + 1] == b't') {
                var tparts: string[] = split_semi(slice_unchecked(ope, oph + 2, ope.len()) + "");
                st = emit_opt_tagged_payload_drop(st, opslot, tparts[0], tparts[1]);
            } else if (oph + 1 < ope.len() && ope[oph + 1] == b'n') {
                st = emit_optopt_rc_deep_free(st, opslot, slice_unchecked(ope, oph + 2, ope.len()) + "");
            } else if (oph + 1 < ope.len() && ope[oph + 1] == b'v') {
                st = emit_opt_payload_drop_via(st, opslot, slice_unchecked(ope, oph + 2, ope.len()) + "");
            } else if (oph + 1 < ope.len() && ope[oph + 1] == b'p') {
                st = emit_opt_struct_payload_drop(st, opslot, slice_unchecked(ope, oph + 2, ope.len()) + "");
            } else {
                st = emit_opt_payload_drop(st, opslot);
            }
        }
        opi = opi + 1;
    }
    // A tuple holding a map-group box at an element releases it before the
    // array sweep below frees the tuple box it is read through (#7235).
    if (map_groups_present(st)) { st = emit_map_group_tuple_releases(st, keeps); }
    // `own` struct params this frame still owns (own_struct_param_release_rows_of).
    // A donating reuse site zeroed the slot, and both releases are null-safe.
    var opi2: i32 = 0;
    while (opi2 < st.n_params) {
        if (!slot_list_has(keeps, opi2)) {
            var opnm: string = st.locals[opi2].slot_name;
            if (reclaim_has(st.reclaimable_names, "OWNREL:", opnm)) {
                st = emit_struct_field_drops_gated(st, opi2, true);
                st = st.release(opi2, "__fern_rc_dec", "own-param-exit");
            } else if (reclaim_has(st.reclaimable_names, "OWNRELB:", opnm)) {
                st = st.release(opi2, "__fern_rc_dec", "own-param-exit-box");
            }
        }
        opi2 = opi2 + 1;
    }
    var i: i32 = st.n_params;
    while (i < st.locals.len()) {
        if (!slot_list_has(keeps, i) && !slot_list_has(st.moved_elided, i) && st.is_arr_slot(i) && !st.is_borrowed_arr_slot(i) && !slot_is_reclaimable_arrtup(st, i) && !slot_is_reclaimable_arrstruct(st, i) && !slot_is_reclaimable_arrenum(st, i) && !reclaim_has(st.reclaimable_names, "ENVCAP:", st.reclaim_site_key(i))) {
            // dyn Trait[] ELEMENT reclaim (#4351 slice 3): a credited literal
            // dyn array releases each element box (per-index, kinds recorded
            // at the credit) BEFORE the buffer dec below. rc==1-gated on the
            // buffer via __fern_rc_is_unique — which doubles as the null
            // guard (slots are zeroed at entry) — so an untaken-branch or
            // shared buffer skips the walk. 'p' decs the rc-headered element
            // box (prim op_dyn_box cell or scalar-only struct box); 's'
            // first frees the sole-owned inner string box at cell@8 (its own
            // rc==1 gate), then decs the cell.
            var dak: string = darr_kinds_of(st, st.reclaim_site_key(i));
            if (dak.len() > 0) {
                st = st.emit(ir.op_load_local(i));
                st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
                st = st.emit(ir.op_if(0));
                var dakj: i32 = 0;
                while (dakj < dak.len()) {
                    if (dak[dakj] == b's') {   // string-payload dyn cell
                        st = st.emit(ir.op_load_local(i));
                        st = st.emit(ir.op_const_i32(dakj));
                        st = st.emit(ir.op_arr_get(32));
                        st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
                        st = st.emit(ir.op_if(0));
                        st = st.emit(ir.op_load_local(i));
                        st = st.emit(ir.op_const_i32(dakj));
                        st = st.emit(ir.op_arr_get(32));
                        st = st.emit(ir.op_struct_get(0, 0));
                        st = st.emit(ir.op_call_direct("__fern_str_free", 1));
                        st = st.emit(ir.op_drop());
                        st = st.emit(ir.op_end());
                    }
                    st = st.emit(ir.op_load_local(i));
                    st = st.emit(ir.op_const_i32(dakj));
                    st = st.emit(ir.op_arr_get(32));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                    dakj = dakj + 1;
                }
                st = st.emit(ir.op_end());
            }
            st = st.emit(ir.op_load_local(i));
            if (slot_is_reclaimable_arrarr(st, i)) {
                // arr-of-arr WHOLE-structure reclaim (#4355 slice 9/10): the
                // kind-picked helper frees inner buffers/strings then the outer.
                // Handled HERE — inside the is_arr sweep, like strarr below —
                // because an arrarr slot is ALSO is_arr: a separate arrarr loop
                // used to run AFTER this one, so the slot was freed twice (a
                // shallow arr_dec here zeroed the rc, then the helper saw rc==0,
                // ticked the underflow detector, and skipped its element walk —
                // inner strings leaked at function scope and the detector noise
                // could mask real over-releases; loop-scoped candidates dodged
                // it only because their retired slot names miss the credit
                // lookup). One slot, one free.
                st = st.emit(ir.op_call_direct(arrarr_free_helper_of(st, i), 1));
            } else if (slot_is_reclaimable_optaarr(st, i)) {
                // Option[<arr>][] WHOLE-structure reclaim (#4365): payload
                // buffers (uniqueness-gated) + option boxes + outer buffer, all
                // inside the helper. Same one-slot-one-free placement rationale
                // as the arrarr branch above.
                st = st.emit(ir.op_call_direct("__fern_optarrarr_free", 1));
            } else if (slot_is_reclaimable_cloarr(st, i)) {
                // Closure-ARRAY element reclaim (#4354): each element is a
                // lambda's own env box — an rc-headered array holding only
                // borrowed captures — so the arr-of-arr helper's rc-guarded
                // per-element arr_dec is exactly its drop, then the buffer.
                st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1));
            } else if (slot_is_reclaimable_structarr(st, i) && st.struct_routes_field_reclaim(st.struct_type_of_slot(i))) {
                // The element struct ROUTES FIELD RECLAIM (#6127) — since the
                // structarr credit excludes rc-array-field structs, that means a
                // STRFLDOK-admitted string / string[] / fn field. The shallow
                // per-element box dec below frees the box without looking inside,
                // so the field leaked once per element per round (measured 9600
                // over 100 rounds on a 4-element `N { name: string, v: i32 }[]`,
                // exactly 4 x one 24-byte string box, against 0 on native) — while
                // a BARE local of the same struct reclaimed cleanly through
                // __field_reclaim_<T>'s STRFLDOK arm. Same counted element walk
                // ARRSTRUCT uses: per element __struct_drop_<T> then the box, then
                // the outer buffer. It does its own loads and pushes nothing, so
                // the slot value loaded above is consumed by the shared trailing
                // drop exactly as the call branches' return value would be.
                st = emit_arrstruct_deep_free(st, i, st.struct_type_of_slot(i));
            } else if (slot_is_reclaimable_structarr(st, i)) {
                // SCALAR-FIELD struct-array element-box reclaim (#4355): a fresh,
                // non-escaping `[P { .. }, P { .. }]` where P has no rc field frees
                // each element STRUCT BOX (one rc-guarded arr_dec — __fern_rc_dec's
                // mapping — per element pointer) then the outer buffer, via the SAME
                // __fern_arrarr_free helper the scalar arr-of-arr class uses (an
                // element pointer and an inner array buffer are both freed by
                // arr_dec). Inside the is_arr sweep like the arrarr branch — a
                // struct-array slot is is_arr, so a separate loop would double-free
                // it. DISJOINT from ARRSTRUCT (whose deep-free loop handles
                // field-routing structs); the detector's struct_has_reclaim_array_
                // field guard keeps a slot in at most one class, so nothing leaks
                // here (a scalar-field struct owns no rc field).
                st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1));
            } else {
                if (slot_is_reclaimable_strarr(st, i)) {
                    // string[] ELEMENT reclaim (#4355): a proven fresh-element string
                    // array frees its element boxes too — the helper walks the
                    // elements (rc==1-gated, each via the rc-aware string free) and then
                    // frees the buffer. Every other array slot keeps the shallow
                    // buffer-only dec (elements leak — sound).
                    st = st.emit(ir.op_call_direct(strarr_free_helper(st, i), 1));
                } else {
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                }
            }
            st = st.emit(ir.op_drop());
        }
        i = i + 1;
    }
    // Reclaimable struct locals are freed the same way — a shallow rc-dec of the
    // box at scope exit. Only fresh, proven-non-escaping struct locals qualify
    // (slot_is_reclaimable_struct), so the box is the sole reference and freeing
    // it cannot dangle a caller's / container's reference: a RETURNED struct is
    // escaping → never reclaimable → never swept (no move-on-return keep needed
    // for structs). Slots are zeroed at entry, so an untaken-branch slot decs a
    // null (guarded no-op).
    var j: i32 = st.n_params;
    while (j < st.locals.len()) {
        var live_credit: boolean = slot_is_reclaimable_struct(st, j);
        var scoped_credit: boolean = !live_credit && slot_is_reclaimable_struct_scoped(st, j);
        // A scoped slot deep-drops only when the move scan could type-check it.
        var scoped_deep_ok: boolean = scoped_credit
            && reclaim_has(st.reclaimable_names, "FLDCHECKED:", st.reclaim_site_key(j));
        if (!slot_list_has(keeps, j) && !slot_list_has(st.moved_elided, j) && (live_credit || scoped_credit)) {
            // Deep-drop the struct's scalar-array fields (sole-owned literals), then
            // free the box. Order matters: read the fields before freeing the box.
            // A BLOCK-SCOPED slot (credit reached only through the retired name) takes
            // the BOX-ONLY form — the #3456 shallow contract, as for a "NODEEP:" slot.
            //
            // WHY, precisely (#6127; #6375 left this open and it is now answered by a
            // stack trace rather than a guess). Granting the deep drop here segfaults
            // the gen1 self-compile at asmcore.EmitState.has_need → __fern_str_eq,
            // reading a freed string out of `needed`. The shape that does it, in
            // asm_ir.emit_function_via_ir_pre:
            //
            //     var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            //     s = lo.state;
            //
            // `StringLitOut { state: EmitState, idx: i32 }` — `lo` is block-scoped and
            // its EmitState field is MOVED into the function's live threaded `s`. The
            // deep drop then walks `lo` and frees that EmitState's arrays out from
            // under `s`. ShapeRefOut / ConstAggOut have the identical shape.
            //
            // The escape analysis misses it because expr_unsafe_for's ExprFieldAccess
            // arm returns false for `name.field` ("base read is a borrow") — true for a
            // SCALAR field, wrong for a nested-struct / array / string one, which is a
            // move. moves_fields_expr (the "NODEEP:" detector, the natural place to
            // catch this) has the same hole: its ExprFieldAccess arm only recurses into
            // the object, and a bare `ExprIdent` object matches no arm at all.
            //
            // So closing this needs the move detector to know the FIELD TYPE — it
            // currently takes no `structs` — and marking every bare field read
            // conservatively would withhold deep drops far beyond this class. That is
            // the shape of the fix, and it is why it is not a one-liner.
            //
            // Reproduce in seconds rather than via the 211s fixpoint: grant the drop,
            // `make selfhost-cli`, then build gen1 the way runEmitAllFixpoint does and
            // run it under gdb —
            //   ./gen1 asm_modload_run.fern -per-module-emit-all -assume-eligible \
            //       -out-dir OUT -func-budget 100 -unit-range 0:8
            // The field drops run under __fern_rc_is_unique, the gate the holder
            // side (__struct_drop_<T>'s k_struct arm) already applies: this box may
            // be a COUNTED SHARE — an alias bind, or a bare ident handed to a
            // struct-literal field — and its fields are then still reachable through
            // the other owner. Whichever owner sweeps last finds rc 1 and does the
            // deep work; the box dec below is unconditional, since it is the claim
            // this slot owns and it is what lets the survivor reach 1.
            if (!scoped_credit || scoped_deep_ok) { st = emit_struct_field_drops_gated(st, j, slot_credit_at(st, j, "SINKSHARE:")); }
            st = st.emit(ir.op_load_local(j));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
        }
        j = j + 1;
    }
    // Reclaimable dyn-Trait STRUCT-payload locals (#4351) — the dyn local holds
    // the concrete's rc-headered struct box (structs flow unboxed behind dyn),
    // so release it exactly like the struct loop above: deep-drop the
    // concrete's rc fields via __struct_drop_<Concrete> (auto-materialized by
    // each backend on seeing the call; only emitted when the concrete carries a
    // reclaimable field), then shallow-dec the box. Slots are zeroed at entry, so
    // an untaken-branch slot routes a null through the null-guarded helpers.
    var dj: i32 = st.n_params;
    while (dj < st.locals.len()) {
        if (!slot_list_has(keeps, dj) && slot_is_reclaimable_dyn(st, dj)) {
            var dconc: string = dyn_reclaim_concrete_of(st, st.reclaim_site_key(dj));
            if (dconc == "string") {
                // Prim dyn cell with a STRING payload (#4351 slice 2): free the
                // sole-owned inner string box (value@8 — read as "field 0", the
                // same offset on all three backends) BEFORE the cell dec below.
                // Gated on __fern_rc_is_unique, which doubles as the null guard
                // (an untaken-branch slot is zeroed at entry): a null or shared
                // cell skips the inner free; the null-guarded dec handles it.
                st = st.emit(ir.op_load_local(dj));
                st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
                st = st.emit(ir.op_if(0));
                st = st.emit(ir.op_load_local(dj));
                st = st.emit(ir.op_struct_get(0, 0));
                st = st.emit(ir.op_call_direct("__fern_str_free", 1));
                st = st.emit(ir.op_drop());
                st = st.emit(ir.op_end());
            }
            // Deep-drop is STRUCT concretes only: an ENUM tag (#4351 slice 4)
            // must never route through __struct_drop_<T> (enum boxes have a
            // variant layout the struct field walk would misread — and
            // struct_has_reclaim_array_field reads an enum decl's variant
            // payloads as "fields"). Enum tags take the shallow dec below;
            // their pointer payloads leak with the box (safe-leak).
            if (decl_is_struct(st.structs, dconc) && struct_has_reclaim_array_field(st.structs, dconc)) {
                st = st.emit(ir.op_load_local(dj));
                st = st.emit(ir.op_call_direct("__struct_drop_" + dconc, 1));
                st = st.emit(ir.op_drop());
            }
            st = st.emit(ir.op_load_local(dj));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
        }
        dj = dj + 1;
    }
    // Reclaimable scalar-tuple locals — a shallow rc-dec of the (now rc-headered)
    // box at scope exit, the tuple sibling of the struct loop above. Only fresh,
    // proven-non-escaping, scalar-literal tuple locals qualify (slot_is_reclaimable
    // _tuple), so the box is the sole reference and carries no rc element to walk.
    // Slots are zeroed at entry, so an untaken-branch slot decs a guarded null.
    var tj: i32 = st.n_params;
    while (tj < st.locals.len()) {
        if (!slot_list_has(keeps, tj) && !slot_list_has(st.moved_elided, tj) && slot_is_reclaimable_tuple(st, tj)) {
            // Give back the construction retains first (#7226): an element that
            // named an rc-container local made the tuple a second owner, and the
            // is_arr sweep above only ever decs the LOCAL's own reference. The
            // positions come from the same predicate that took the retain.
            // Under a null guard: the box dec below tolerates a zeroed
            // (untaken-branch) slot because __fern_rc_dec null-guards, but
            // tuple_get dereferences.
            st = emit_tup_elem_releases(st, tj, st.tup_elem_kinds_of(tj));
            st = st.emit(ir.op_load_local(tj));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
        }
        tj = tj + 1;
    }
    // ORDER MATTERS: the struct loop above must stay ahead of this one. This deep
    // free is NOT is_unique-gated, so it walks the children whatever the box's
    // count; a struct holding a counted share of the same tuple relies on running
    // first, finding the box non-unique, and taking the box-only dec. Swap the two
    // loops and this walk frees children the struct's drop then walks again.
    // Sweepable rc-TUPLE locals (`var t: (i32, i32[]) = (i, [i, i+1])`, "TUPRCS:"):
    // deep-free the final value's rc children then its box (#6127). "TUPRC:" on its
    // own is consumed only by the StmtVar rebind path, so this class was credited
    // and entry-zeroed but never released — a single bind leaked buffer AND box every
    // round. Disjoint from the scalar-tuple loop above (a slot is one class or the
    // other) and from the rebind path (that frees SUPERSEDED boxes, this the last
    // one), so no box is dec'd twice.
    var rtj: i32 = st.n_params;
    while (rtj < st.locals.len()) {
        if (!slot_list_has(keeps, rtj) && !slot_list_has(st.moved_elided, rtj) && slot_is_reclaimable_rctuple_sweep(st, rtj)) {
            st = emit_rctuple_deep_free(st, rtj);
        }
        rtj = rtj + 1;
    }
    // Sweepable rc-payload ENUM locals ("RCENUMS:", the no-consuming-match half):
    // deep-free the final value's payload then its box by runtime variant dispatch,
    // the same release the loop rebind runs on each SUPERSEDED box. Without this the
    // last value of every such block leaked — 396 of 400 freed on #6608's probe,
    // the n-1-of-n signature of a retired slot missing its credit. The drop zeroes
    // the slot, so a second sweep on another return edge routes here to the null
    // guard — which is load-bearing (#7360): op_variant_is DEREFERENCES the box for
    // its tag, so an entry-zeroed slot whose branch never ran faults without it.
    //
    // moved_elided is excluded for the reason the rc-tuple sweep above excludes
    // it: a construction that MOVED this local (#6726) took over its reference
    // and dropped the retain, so the box carries one claim and the destination's
    // own release is it. Sweeping here too would dec a claim that was never
    // taken. Nothing reached this loop while the enum credits refused every
    // name a construction could move; the counted-field carve-out admits
    // exactly those names, which is what made the missing conjunct reachable.
    var rej: i32 = st.n_params;
    while (rej < st.locals.len()) {
        if (!slot_list_has(keeps, rej) && !slot_list_has(st.moved_elided, rej) && slot_is_reclaimable_rcenum_sweep(st, rej)) {
            st = st.emit(ir.op_load_local(rej));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_bin("ne", 0, false));
            st = st.emit(ir.op_if(0));
            var rej_moved: string[] = [];
            st = emit_enum_variant_drops_gated(st, rej, st.struct_type_of_slot(rej), rej_moved, true);
            st = st.emit(ir.op_end());
        }
        rej = rej + 1;
    }
    // Sweepable ALL-SCALAR enum locals ("SCENUMS:"): the final value's box, freed
    // with the same shallow dec the rebind uses. emit_scalar_enum_box_free zeroes
    // the slot afterwards, so a second sweep on another return edge is a no-op.
    var sej: i32 = st.n_params;
    while (sej < st.locals.len()) {
        if (!slot_list_has(keeps, sej) && slot_is_reclaimable_scenum(st, sej)) {
            st = emit_scalar_enum_box_free(st, sej);
        }
        sej = sej + 1;
    }
    // Reclaimable Option[<tuple-with-array>] locals (#4365): deep-free the final
    // live box (Some payload tuple + option box) via the same inline path the
    // loop-rebind uses. An opt_type slot is NOT is_arr, so it takes a dedicated
    // loop here like the scalar-tuple sweep above. Slots are entry-zeroed, so an
    // untaken-branch slot routes a null through the guard.
    var otj: i32 = st.n_params;
    while (otj < st.locals.len()) {
        if (!slot_list_has(keeps, otj) && slot_is_reclaimable_opttup(st, otj)) {
            st = emit_opttup_deep_free(st, otj, opttup_inner_type(st.locals[otj].opt_type));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(otj));
        }
        otj = otj + 1;
    }
    // Reclaimable Option[<struct-with-array>] locals (#4365): deep-free the final live box
    // (Some payload struct via __struct_drop_<P> + option box) via the same inline path the
    // loop-rebind uses. An opt_type slot is NOT is_arr, so it takes this dedicated loop.
    // Entry-zeroed, so an untaken-branch slot routes a null through the guard.
    var osj: i32 = st.n_params;
    while (osj < st.locals.len()) {
        if (!slot_list_has(keeps, osj) && slot_is_reclaimable_optstruct(st, osj)) {
            st = emit_optstruct_deep_free(st, osj, opt_payload_type(st.locals[osj].opt_type, "Some"));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(osj));
        }
        osj = osj + 1;
    }
    // Reclaimable Option[<scalar-arr-of-arr>] locals (#4365): deep-free the final live box
    // (Some payload via __fern_arrarr_free + option box) via the same inline path the
    // loop-rebind uses. Entry-zeroed, so an untaken-branch slot routes a guarded null.
    // Reclaimable REBOUND Option[<flat scalar array>] locals (#6127): free the final
    // live value's payload buffer + option box, the same inline path the rebind uses.
    // Entry-zeroed, so an untaken-branch slot routes a guarded null.
    var ofj: i32 = st.n_params;
    while (ofj < st.locals.len()) {
        if (!slot_list_has(keeps, ofj) && slot_is_reclaimable_optarr(st, ofj)) {
            // A "NODEEP:"-qualified slot is an ALIAS: it retained the box and
            // nothing else, so it decs the box and leaves the payload to the
            // source's one deep release (#7687).
            if (slot_nodeep(st, ofj)) { st = emit_opt_box_only_free(st, ofj); }
            else {
                st = emit_optarr_deep_free_err(st, ofj, slot_is_reclaimable_optarr_errstr(st, ofj));
                st = st.emit(ir.op_const_i32(0));
                st = st.emit(ir.op_store_local(ofj));
            }
        }
        ofj = ofj + 1;
    }
    // Unmatched Option[string] / Result[string, _] (#6360) — same sweep, string
    // release. Disjoint from the OPTARR pass above by annotation.
    var ostrj: i32 = st.n_params;
    while (ostrj < st.locals.len()) {
        if (!slot_list_has(keeps, ostrj) && slot_is_reclaimable_optstr(st, ostrj)) {
            if (slot_nodeep(st, ostrj)) { st = emit_opt_box_only_free(st, ostrj); }
            else {
                st = emit_optstr_deep_free(st, ostrj);
                st = st.emit(ir.op_const_i32(0));
                st = st.emit(ir.op_store_local(ostrj));
            }
        }
        ostrj = ostrj + 1;
    }
    // `Option[Option[<rc payload>]]` (#7718) — the two-level guarded release.
    // Disjoint from the OPTARR pass above by annotation, so no box is freed twice.
    var onrj: i32 = st.n_params;
    while (onrj < st.locals.len()) {
        if (!slot_list_has(keeps, onrj) && slot_is_reclaimable_optopt_rc(st, onrj)) {
            if (slot_nodeep(st, onrj)) { st = emit_opt_box_only_free(st, onrj); }
            else { st = emit_optopt_rc_deep_free(st, onrj, nested_opt_inner_freefn(opttup_inner_type(st.locals[onrj].opt_type) + "")); }
        }
        onrj = onrj + 1;
    }
    var oaj: i32 = st.n_params;
    while (oaj < st.locals.len()) {
        if (!slot_list_has(keeps, oaj) && slot_is_reclaimable_optarrarr(st, oaj)) {
            st = emit_optarrarr_deep_free(st, oaj);
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(oaj));
        }
        oaj = oaj + 1;
    }
    // Reclaimable (<tuple-with-array>)[] locals (#4365): deep-free the final live
    // structure (per-element tuple deep-drop + tuple box, then the outer buffer) via
    // the same inline element-walk the loop-rebind uses. An arrtup slot is is_arr but
    // EXCLUDED from the plain is_arr sweep above, so it takes this dedicated loop.
    // Slots are entry-zeroed, so an untaken-branch slot routes a null through the
    // guard.
    var atj: i32 = st.n_params;
    while (atj < st.locals.len()) {
        if (!slot_list_has(keeps, atj) && slot_is_reclaimable_arrtup(st, atj)) {
            st = emit_arrtup_deep_free(st, atj, st.locals[atj].arrarr_elem);
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(atj));
        }
        atj = atj + 1;
    }
    // Reclaimable (<struct-with-array>)[] locals (#4365): deep-free the final live
    // structure (per-element struct deep-drop + struct box, then the outer buffer) via
    // the same inline element-walk the loop-rebind uses. Excluded from the plain is_arr
    // sweep above; entry-zeroed like every body slot.
    var asj: i32 = st.n_params;
    while (asj < st.locals.len()) {
        if (!slot_list_has(keeps, asj) && slot_is_reclaimable_arrstruct(st, asj)) {
            st = emit_arrstruct_deep_free(st, asj, st.struct_type_of_slot(asj));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(asj));
        }
        asj = asj + 1;
    }
    // Reclaimable `MyEnum[]` locals (#5474): deep-free the final live structure (per
    // element the runtime variant dispatch, which drops the payload AND frees the box,
    // then the outer buffer). Excluded from the plain is_arr sweep above; entry-zeroed
    // like every body slot.
    var aej: i32 = st.n_params;
    while (aej < st.locals.len()) {
        if (!slot_list_has(keeps, aej) && slot_is_reclaimable_arrenum(st, aej)) {
            st = emit_arrenum_deep_free(st, aej, arrenum_enum_of_slot(st, aej));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(aej));
        }
        aej = aej + 1;
    }
    // (Reclaimable arr-of-arr locals are freed INSIDE the is_arr sweep above —
    // an arrarr slot is also is_arr, so a separate loop here double-freed;
    // see the slot_is_reclaimable_arrarr branch.)
    // Reclaimable fresh heap-string locals — free the box + data buffer via
    // __fern_str_free at scope exit (the sibling of the struct/tuple loops above).
    // Only fresh, proven-non-escaping, non-reassigned string locals qualify
    // (slot_is_reclaimable_str): a returned / stored string is escaping → never
    // in the set → never swept (no move-on-return keep needed). An aliased
    // source stays in the set (the alias site earns the same "STR:" class and
    // the refcount arbitrates); a dead-alias-cancelled alias slot is skipped
    // here via moved_elided. Slots are zeroed at entry, so an untaken-branch
    // slot frees a guarded null. A loop-body string local's per-iteration boxes
    // were already freed at the rebind; this frees the final live one.
    var sj: i32 = st.n_params;
    while (sj < st.locals.len()) {
        if (!slot_list_has(keeps, sj) && !slot_list_has(st.moved_elided, sj) && slot_is_reclaimable_str(st, sj)) {
            st = emit_str_slot_release(st, sj);
        }
        sj = sj + 1;
    }
    // Reclaimable MAP locals — free the keys + values buffers (arr-boxed, rc-guarded
    // __fern_rc_dec) and the mapbox at scope exit. Only fresh, non-escaping,
    // non-iterated, non-aliased map locals qualify (slot_is_reclaimable_map via the
    // "MAP:" reclaim set), so the buffers are sole-owned (rc==1) and freed exactly
    // once. A returned/escaping map is never reclaimable → never swept (no
    // move-on-return keep needed). Block-scoped slots are swept like any other: the
    // credit is keyed on the binding site, which survives retire_locals' rename, and
    // a slot whose block never ran holds the prologue's zero, which the helper
    // null-guards.
    var mj: i32 = st.n_params;
    while (mj < st.locals.len()) {
        if (!slot_list_has(keeps, mj) && slot_is_reclaimable_map(st, mj)) {
            st = emit_map_group_release(st, mj);
        }
        mj = mj + 1;
    }
    return st;
}

// field_type_is_reclaimable_ptr reports whether a struct field's declared type
// is a POINTER-shaped (heap) value that __struct_drop_<T> would deep-free — a
// string, any array, a struct / enum, a tuple, or a map. Everything else is a
// bare scalar (i32 / i64 / u32 / u64 / u8 / f64 / f32 / float / boolean), copied
// by value and never freed. Used by the struct-FIELD move-on-return keep (#4801):
// returning such a field aliases it out to the caller, so its parent struct local
// must be excluded from the exit sweep.
function field_type_is_reclaimable_ptr(t: string): boolean {
    if (t.len() == 0) { return false; }
    if (t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "u8"
        || t == "f64" || t == "f32" || t == "float" || t == "boolean") { return false; }
    return true;
}

// returned_moved_arr_slots collects every array-LOCAL slot that the returned
// expression `e` MOVES out of this frame, so the exit dec-sweep can keep them
// (their buffers now back an escaping value). It covers, recursively:
//   - a bare array-local return (`return a`)              — the buffer is moved;
//   - `return <arr-local>.append(e)`                      — receiver moved;
//   - an enum-variant construction `return V(a, …)`       — each bare array-local
//     payload arg is moved into the (leaking) enum box (#3720);
//   - a struct literal whose enum-typed field is built from such a construction
//     (`return S { node: Many(items), … }`) — the array under the enum payload.
// Struct ARRAY fields (`S { xs: a }`) are deliberately NOT collected: those take
// an alias-inc at the struct-lit lowering, so the sweep dec is balanced and must
// still run. A fresh array literal payload (`Many([…])`) names no slot, so it is
// naturally excluded. Mirrors the single-slot `moved` logic it replaces.
function returned_moved_arr_slots(e: ast.Expr, s: LowerState, acc: i32[]): i32[] {
    var out: i32[] = acc;
    match (e) {
        ast.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (s.is_arr_slot(sl) && !slot_list_has(out, sl)) { out = out.append(sl); }
            // Struct move-on-return (#3457): a returned reclaimable struct LOCAL
            // (the snapshot-local moved out) must be KEPT from the exit sweep —
            // otherwise the box just handed to the caller is double-freed. The
            // sweep's struct loop skips slots in this keeps list.
            if (slot_is_reclaimable_struct(s, sl) && !slot_list_has(out, sl)) { out = out.append(sl); }
            // String move-on-return (#2649): a returned reclaimable-string LOCAL
            // (an accumulator whose intermediates were freed by the consume-rebind)
            // is MOVED OUT to the caller — keep it from the exit string sweep so the
            // final box just handed back is not freed. slot_is_reclaimable_str is
            // true only for an admitted accumulator (str_accum_unsafe_for now allows
            // the bare `return name` move), so a non-accumulator string is untouched.
            if (slot_is_reclaimable_str(s, sl) && !slot_list_has(out, sl)) { out = out.append(sl); }
            // Tuple move-on-return (the owned-return admission): a returned
            // credited tuple LOCAL — shallow "TUP:" or deep "TUPRCS:" — is
            // moved out to the caller; keep it from this return path's tuple
            // sweeps, which would otherwise free the box just handed back.
            // A credit exists for a returned tuple name only via the
            // ret-forgiving gate, so a non-admitted tuple is untouched. The
            // caller's fresh-ret credit releases what it received.
            if ((slot_is_reclaimable_tuple(s, sl) || slot_is_reclaimable_rctuple_sweep(s, sl)) && !slot_list_has(out, sl)) { out = out.append(sl); }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    // Enum-variant construction: bare array-local payload args move
                    // into the box (recurse to also catch nested `V(W(a))`).
                    if (variant_enum_owner(s.structs, cid.name) != "") {
                        for arg in c.args {
                            out = returned_moved_arr_slots(arg, s, out);
                        }
                    }
                    // Built-in payload constructors `Ok(a)/Err(a)/Some(a)`: the
                    // Result/Option box stores the payload pointer with NO alias-inc
                    // and is leak-mode (never deep-dropped), exactly like a user enum
                    // variant — so `return Ok(names)` over a local array MOVES `names`
                    // into the box and must keep it from the exit sweep. Without this
                    // the sweep frees the array while the returned box still holds it;
                    // harmless for a grown array (its buffer sits in a different
                    // freelist size-class) but a use-after-free for an EMPTY array
                    // (`var names: string[] = []` — freelist class 3), which the
                    // caller's next 24-byte string box recycles. Surfaced by the
                    // read_dir→Fern migration (#2649/#5290): `__fern_read_dir` on an
                    // empty directory returns `Ok([])`, whose block the caller's next
                    // string allocation aliased.
                    if ((cid.name == "Ok" || cid.name == "Err" || cid.name == "Some") && c.args.len() == 1) {
                        out = returned_moved_arr_slots(c.args[0], s, out);
                    }
                },
                ast.ExprFieldAccess(fa) => {
                    // `arr.append(e)`: the receiver array is consumed and its buffer
                    // backs the returned (grown) array.
                    if (fa.field == "append" && c.args.len() == 1) {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => {
                                var rs: i32 = s.slot_of(rid.name);
                                if (s.is_arr_slot(rs) && !slot_list_has(out, rs)) { out = out.append(rs); }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
        },
        ast.ExprFieldAccess(fa) => {
            // Struct-FIELD move-on-return (#4801): `return r.node` where `r` is a
            // reclaimable struct LOCAL and the returned field is POINTER-shaped
            // (struct / enum / array / string / tuple / map). The returned field
            // aliases OUT to the caller, but `r` itself is not the returned value,
            // so the exit sweep's struct loop would reclaim `r` —
            // emit_struct_field_drops' __struct_drop_<T> then DEEP-frees the
            // returned field out from under the caller (a use-after-free that only
            // SIGSEGVs once a later allocation recycles the freed block; the watbin
            // `wat_parse` `return r.node` tree corruption). Keep `r` from the sweep
            // so the returned field survives; the box + any un-returned heap sibling
            // fields LEAK (sound, never over-free) — the struct-field sibling of the
            // bare-local / enum / tuple moves above. Scalar fields (i32/…) are copied
            // out, so their parent stays swept (no keep).
            match (fa.obj) {
                ast.ExprIdent(fid) => {
                    var fsl: i32 = s.slot_of(fid.name);
                    if (fsl >= s.n_params && slot_is_reclaimable_struct(s, fsl) && !slot_list_has(out, fsl)) {
                        var fsty: string = s.struct_type_of_slot(fsl);
                        if (fsty.len() > 0 && field_type_is_reclaimable_ptr(decl_field_type(s.structs, fsty, fa.field))) {
                            out = out.append(fsl);
                        }
                    }
                },
                _ => {}
            }
        },
        ast.ExprStructLit(sl) => {
            // Only descend into enum-payload fields (ExprCall constructors): a bare
            // array-field value gets its own alias-inc, so it must stay swept.
            for fv in sl.field_values {
                match (fv) {
                    ast.ExprCall(_) => { out = returned_moved_arr_slots(fv, s, out); },
                    _ => {}
                }
            }
        },
        ast.ExprTuple(tl) => {
            // `return (…, a, …)` — every bare array-local element MOVES into the
            // returned tuple box, exactly like an enum payload (#3720): tuple
            // construction (op_tuple_make_k) stores the buffer pointer with NO
            // alias-inc and the box is leak-mode (never deep-dropped), so sweeping
            // the element here frees the buffer out from under the caller — the
            // #4598 UAF (surfaced by the frontend bundle once a later allocation
            // recycled the freed block). Recurse per element so the ident /
            // `.append` / enum-ctor / reclaimable-struct/-string shapes are all
            // kept from their sweeps, matching the single-value return paths.
            var tli: i32 = 0;
            while (tli < tl.elements.len()) {
                out = returned_moved_arr_slots(tl.elements[tli], s, out);
                tli = tli + 1;
            }
        },
        _ => {}
    }
    return out;
}

// lower_block lowers a sequence of statements (a then/else body), bailing
// on the first out-of-subset statement.
// stmt_scopes_bindings reports whether a statement introduces a binding that is
// scoped to the statement itself rather than to the enclosing block: a `for`
// loop variable, or a `match` arm's payload binding(s) + scrutinee temp. Those
// are added OUTSIDE the body block (so lower_block's own retire doesn't reach
// them), so lower_block retires them right after the statement — otherwise the
// loop var / arm binding leaks past the statement and shadows / clobbers a
// same-named outer local (the loop/match sibling of #3726). A plain `var` must
// persist through the rest of the block, so it is NOT included.
function stmt_scopes_bindings(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtFor(_) => { return true; },
        ast.StmtMatch(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// lower_block lowers a nested block (loop body, if / match arm, bare block) with
// same-block cross-reuse (FBIP) enabled: a fresh struct / tuple construction that
// reuses an earlier dead SAME-BLOCK donor's box is lowered IN PLACE (zero-alloc)
// instead of allocating a fresh box. This is native's same-block reuse pass over
// EVERY block. Its highest-value instance is the loop-churn case — a `var a = …;
// …; var b = …` in a loop body where a is dead by b reuses a's box each iteration
// — but it also fires in if / match arm bodies (which, when nested in a loop,
// churn too).
//
// Memory safety: the recipient slot is block-carried (re-used across executions of
// the block at runtime — every iteration of an enclosing loop), so the reuse
// emitter releases its prior box (release_prior); the donor's zeroed slot is
// re-bound next execution (emit_arr_store prior-release for the normal binding),
// and the final box rides the exit sweep — one alloc + one free per execution,
// balanced. The analyses are block-scoped (self_overwrite / cross_reuse /
// cross_tuple sites over `stmts`, dead-from-k within the block), so only
// intra-block donors pair and no cross-execution read is stranded. The function
// body itself is lowered by lower_func (with release_prior false — its recipient
// slots are entry-zeroed, executed once), so this covers exactly the NESTED
// blocks. Block-scoped slots are retired on exit so a SIBLING block (the other
// match arm, the else branch) re-uses a fresh slot rather than colliding.
// with_xblock_pending replaces the cross-block pending-pairings list (see the
// LowerState field). Threaded like set_local_name — a single field swap, every
// other column carried through.
pub function (s: LowerState) with_xblock_pending(v: string[]): LowerState {
    return LowerState { ...s, xblock_pending: v };
}

pub function (s: LowerState) with_optret_pending(v: string[]): LowerState {
    return LowerState { ...s, optret_pending: v };
}

// --- cross-block reuse (FBIP): a block-top donor reused by a construction nested
// --- in a LATER if-arm of that block ------------------------------------------
//
// The complement to same-block reuse: a `var d = T{…}` at block B's top level,
// dead by the time control reaches a later statement k, whose box is reused by a
// `var c = T{…}` at the TOP LEVEL of an IF-arm at statement k. Restricted to
// IF-arms (then/else) so the recipient runs at most ONCE per run of B — a while /
// for body would reuse the once-allocated donor repeatedly (2nd turn: donor slot
// already zeroed → write to null). When B is itself a loop body, D is re-declared
// each iteration, so the pattern "loop { var a = …; if (c) { var b = … /*reuse a*/ } }"
// fires every iteration. The pairing is carried to the nested lower_block via
// LowerState.xblock_pending (recip|donor); the recursive lower_block consumes it
// when it constructs the recipient. Donor selection excludes any donor a
// same-block site already consumed (so the two passes never double-free a box).

// cross_recipient_fields_fresh is the RECIPIENT field-value freshness gate the
// cross-statement (cross_reuse_sites) and cross-block (xblock_scan_body)
// families share: every leak-safe array field VALUE must be a fresh array
// literal (the reused box then owns it); likewise a nested-struct field value
// must be a fresh (no-base) struct literal, so the reused box solely owns the
// new inner box (rc=1, no alias-inc) once the old inner is full-freeing-dropped
// in emit_cross_struct_reuse; an ENUM field value (#4356 divergence 1) must be
// a fresh variant-constructor call of that enum, so the reused box solely owns
// the new payload box (a payloadless ctor yields a guard-skipped sentinel —
// also safe); a STRING field value must be a literal or a fresh producer
// (#4355's rule) so the reused box solely owns the new buffer. Map / tuple /
// Option fields are ungated — leak-only boxes with no release arm (see
// struct_fields_reusable_cross).
function cross_recipient_fields_fresh(slit: ast.ExprStructLit, structs: parser.StructDecl[]): boolean {
    var fk: i32 = 0;
    while (fk < slit.field_names.len()) {
        var fkt: string = decl_field_type(structs, slit.type_name, slit.field_names[fk]);
        if (is_leaksafe_array_field(fkt)) {
            match (slit.field_values[fk]) {
                ast.ExprArray(_) => {},
                _ => { return false; }
            }
        } else if (decl_is_struct(structs, fkt)) {
            match (slit.field_values[fk]) {
                ast.ExprStructLit(isl) => { if (isl.has_base) { return false; } },
                _ => { return false; }
            }
        } else if (fkt == "fn") {
            // Fresh lambda / __mkclo$ env box only (a bare closure ident may
            // alias a live box the donor-release side would free). MUST be
            // tested BEFORE is_enum_like_name: the coarse "fn" spelling reads
            // as enum-like (see is_enum_like_name's header), and the enum
            // arm's variant-ctor demand would reject every closure value.
            if (!fn_field_value_is_fresh(slit.field_values[fk])) { return false; }
        } else if (is_enum_like_name(fkt, structs)) {
            if (variant_ctor_enum_owner(slit.field_values[fk], structs) != fkt) { return false; }
        } else if (fkt == "string") {
            var csf: boolean = false;
            match (slit.field_values[fk]) {
                ast.ExprString(_) => { csf = true; },
                _ => { csf = str_local_binding_is_fresh(slit.field_values[fk]); }
            }
            if (!csf) { return false; }
        } else if (fkt == "string[]") {
            // Element-fresh array literal only (a bare-ident / call value may
            // alias a live buffer the donor-release side would deep-free).
            if (!strarr_lit_all_elems_fresh(slit.field_values[fk])) { return false; }
        } else if (is_struct_array_field_type(structs, fkt)) {
            if (!boxarr_lit_all_elems_fresh(slit.field_values[fk], structs, slice_unchecked(fkt, 0, fkt.len() - 2), false)) { return false; }
        } else if (is_enum_array_field_type(structs, fkt)) {
            if (!boxarr_lit_all_elems_fresh(slit.field_values[fk], structs, slice_unchecked(fkt, 0, fkt.len() - 2), true)) { return false; }
        }
        fk = fk + 1;
    }
    return true;
}

// reuse_recipient_ok is the whole RECIPIENT admission the cross-statement
// (cross_reuse_sites), cross-block (xblock_scan_body) and enum-donor
// (enum_donor_reuse_sites) families share: a full no-base construction of a
// reusable struct type whose field values are all fresh, and which is not
// itself a compile-time constant.
//
// That last clause is what stops constructor reuse and static aggregate
// placement (#6149) from cancelling each other. These scanners run per
// STATEMENT in lower_block, BEFORE the literal reaches lower_expr where
// const_agg_of recognises it — so claiming a constant recipient costs it its
// static placement and buys nothing in return, since its __fern_alloc_reuse
// degrades to a fresh box the moment the donor is itself a constant (immortal
// rc, so is_unique answers 0). Leaving the literal alone places it in .data and
// releases the donor to the freelist, which the next allocation of that size
// class pops anyway.
function reuse_recipient_ok(slit: ast.ExprStructLit, structs: parser.StructDecl[]): boolean {
    if (slit.has_base) { return false; }
    if (!struct_fields_reusable_cross(structs, slit.type_name)) { return false; }
    if (!cross_recipient_fields_fresh(slit, structs)) { return false; }
    return !const_agg_of(slit, structs).ok;
}

struct XbScan { pairs: string[], cons: string[] }

// xblock_scan_body pairs every top-level reusable struct construction in `body`
// (an if-arm) with a dead-from-k, non-escaping same-type donor drawn from block
// `b_stmts` before k (cross_construction_donor — its dead-from-k check walks into
// the nested statement k, so a donor mentioned anywhere in k, including this arm,
// is excluded). Each donor is consumed at most once (threaded via `cons`).
function xblock_scan_body(body: ast.Stmt[], b_stmts: ast.Stmt[], k: i32, structs: parser.StructDecl[], so_bases: string[], acc: XbScan, fresh_ret: string[]): XbScan {
    var pairs: string[] = acc.pairs;
    var cons: string[] = acc.cons;
    var si: i32 = 0;
    while (si < body.len()) {
        match (body[si]) {
            ast.StmtVar(rv) => {
                match (rv.init) {
                    ast.ExprStructLit(slit) => {
                        // #4356 Delta B follow-through: the cross-block recipient now
                        // takes the same WIDENED field-kind predicate + fresh-value
                        // gate as the cross-statement family — enum / string / Map /
                        // tuple / Option fields are admitted (emit_cross_struct_reuse
                        // already carries every release arm, and the shared
                        // cross_construction_donor carries the donor-side freshness
                        // gates), where this scan previously required the narrow
                        // scalar/array/nested-struct predicate.
                        if (reuse_recipient_ok(slit, structs)) {
                            var donor: string = cross_construction_donor(b_stmts, structs, k, slit.type_name, rv.name, so_bases, cons, fresh_ret);
                            if (donor.len() > 0) {
                                // "dname|dtype" — keep the pair 3-part, consume the bare name.
                                var xbar: i32 = 0;
                                while (xbar < donor.len() && donor[xbar] != b'|') { xbar = xbar + 1; }
                                pairs = pairs.append(reclaim_site_key_of(rv.name, rv.line, rv.col) + "|" + donor);
                                cons = cons.append(slice_unchecked(donor, 0, xbar));
                            }
                        }
                    },
                    // A tuple recipient pairs with a dead-from-k same-arity donor tuple
                    // (element-eligibility is checked at consumption, where the lowering
                    // state exists, like the same-block tuple path). Now that scalar
                    // tuple loop temporaries are reclaimed (not leaked), the reused box
                    // is freed each turn — no leak.
                    ast.ExprTuple(tl) => {
                        var tdonor: string = cross_tuple_construction_donor(b_stmts, k, tl.elements.len(), rv.name, cons);
                        if (tdonor.len() > 0) {
                            pairs = pairs.append(reclaim_site_key_of(rv.name, rv.line, rv.col) + "|" + tdonor + "|");
                            cons = cons.append(tdonor);
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        si = si + 1;
    }
    return XbScan { pairs: pairs, cons: cons };
}

// xblock_pairings_for returns the "recip|donor" cross-block pairings for statement
// k of block `b_stmts` — only when k is an IF (then / else arms scanned). `consumed`
// is the set of donors a same-block reuse already claimed, so the two never collide.
//
// The two arms each start from THAT entry set rather than from the other arm's
// result, so one dead donor feeds a construction in BOTH arms (#4402 opt 3, the
// self-host twin of native's cross-branch sharing). Only one arm runs per pass,
// so the token is claimed at most once. Safety does not rest on that: the
// consumer zeroes the donor's slot (emit_cross_struct_reuse), so a second claim
// on one pass would read a null token and __fern_alloc_reuse would allocate
// fresh. Exclusivity is what makes the second token sequence worth its code.
// Sequential recipients WITHIN one arm still share nothing — xblock_scan_body
// threads `cons` across the arm's own statements.
function xblock_pairings_for(b_stmts: ast.Stmt[], structs: parser.StructDecl[], k: i32, so_bases: string[], consumed: string[], fresh_ret: string[]): string[] {
    var acc: XbScan = XbScan { pairs: [], cons: consumed };
    match (b_stmts[k]) {
        ast.StmtIf(iff) => {
            var t: XbScan = xblock_scan_body(iff.then_body, b_stmts, k, structs, so_bases, acc, fresh_ret);
            acc = xblock_scan_body(iff.else_body, b_stmts, k, structs, so_bases, XbScan { pairs: t.pairs, cons: consumed }, fresh_ret);
        },
        _ => {}
    }
    return acc.pairs;
}

// xblock_donor_for returns the donor paired with the recipient bound at site
// `recip` in `pending`, or "" (the "recip-site|donor" entries split on '|', 124).
function xblock_donor_for(pending: string[], recip: string): string {
    var i: i32 = 0;
    while (i < pending.len()) {
        var e: string = pending[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != b'|') { bar = bar + 1; }
        if (bar < e.len() && slice_unchecked(e, 0, bar) == recip) { return slice_unchecked(e, bar + 1, e.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// reuse_layer_disabled: the #4350 §6.5 differential switch. When the
// FERN_SELFHOST_NO_REUSE env var is "1" in the COMPILER's environment, every
// donor-based box-reuse pairing (self-overwrite / cross-struct / cross-tuple /
// enum-donor / enum-cross / in-arm) and the ENUMRE in-place reassign upgrade
// are suppressed: constructions allocate fresh boxes, donors take their normal
// frees (nothing is suppressed on their behalf), and the ENUMRE reassign falls
// back to emit_enum_reclaim_store's free+alloc — mirroring native
// ast.RcReuseEnabled=false. Reuse-on vs reuse-off must be OBSERVATIONALLY
// IDENTICAL (the differential gate in self_host_reuse_differential_test.go
// asserts it); OFF trades only alloc count / peak heap. Read per lower_block /
// lower_func entry (an env scan — no allocation on the None path).
pub function reuse_layer_disabled(): boolean {
    match (env("FERN_SELFHOST_NO_REUSE")) {
        Some(v) => { return v == "1"; },
        None => { return false; }
    }
    return false;
}

// rc_plan_disabled: FERN_SELFHOST_RC_PLAN=0 reverts the routed release
// families to their credit-table escape gates (SELFHOST-RC-PLAN-PROMOTION
// step 2). Unset = the plan's free_eligible_of verdict drives them. Unlike
// the reuse switch, on-vs-off changes which frees are emitted, so the
// fallback is a migration aid gated by the leak matrix + underflow trap,
// never a byte-identity contract.
pub function rc_plan_disabled(): boolean {
    match (env("FERN_SELFHOST_RC_PLAN")) {
        Some(v) => { return v == "0"; },
        None => { return false; }
    }
    return false;
}

// xblock_without returns `pending` with any entry for the recipient bound at
// site `recip` removed.
function xblock_without(pending: string[], recip: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < pending.len()) {
        var e: string = pending[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != b'|') { bar = bar + 1; }
        if (!(bar < e.len() && slice_unchecked(e, 0, bar) == recip)) { out = out.append(e); }
        i = i + 1;
    }
    return out;
}

pub function lower_block(stmts: ast.Stmt[], s: LowerState): LowerState {
    var base: i32 = s.locals.len();
    var so: ReuseSites = ReuseSites { idxs: [], bases: [] };
    var xreuse: CrossReuseSites = CrossReuseSites { idxs: [], donors: [], dtypes: [] };
    var xtuple: CrossTupleReuseSites = CrossTupleReuseSites { idxs: [], donors: [] };
    if (!reuse_layer_disabled()) {
        so = self_overwrite_reuse_sites(stmts, s.structs, s.sigs.return_fresh_struct_ret_fns);
        xreuse = cross_reuse_sites(stmts, s.structs, s.sigs.return_fresh_struct_ret_fns);
        xtuple = cross_tuple_reuse_sites(stmts);
    }
    // Consumed rc-payload Option/Result frees, PER-BLOCK (#4353 item 2): the
    // fn-level pass scans only top-level fn-body statements, so a LOOP-LOCAL
    // `var o = Some(<rc payload>)` consumed by exactly one match in the same
    // nested block leaked payload + box on every iteration. Same classifier
    // and gates (single match, dead-after, non-escaping, borrowing arms),
    // applied to THIS block's own statement list. A var matched in a
    // DIFFERENT block never qualifies (candidate requires var + match in one
    // list), lower_block is called for nested bodies only (the fn body has
    // its own loop), and block-level reuse donors are struct/tuple boxes
    // (never Option locals) — so each box is freed at most once.
    var rcopt: OptRcFrees = consumed_rcpayload_option_frees(stmts, s.structs, s.sigs.opt_fresh_ret_fns, true);
    // Consumed ALL-SCALAR enum free, per block (#6127). lower_func runs
    // consumed_scalar_enum_frees over the fn's TOP-LEVEL statements only, so a
    // scalar-payload enum declared inside a loop or an if — `while { var e =
    // Box(k, 2); match (e) { … } }` — was reclaimed NOWHERE and leaked its box
    // per iteration. This is the same top-level-only gap #4357 closed for
    // rc-payload OPTIONS with the rcopt line above and for rc-payload ENUMS with
    // collect_fresh_rcenum_names; the scalar-enum half was never mirrored.
    // Measured 19200 bytes over 100 rounds where the byte-identical shape at fn
    // top level is flat at 0.
    //
    // Same classifier and gates as the fn-level pass, applied to THIS block's
    // statement list, and each box is freed at most once:
    //   - lower_block runs for NESTED bodies only (the fn body has its own loop),
    //     so a top-level candidate is never also claimed here;
    //   - a candidate requires its `var` and its consuming `match` in ONE
    //     statement list, so a var matched in a different block never qualifies;
    //   - enum_donor_reuse_sites takes the fn-level EnumFrees and scans fn.body
    //     flat, so a nested-block box can never have been donated to a reuse site
    //     (which is what the fn-level emission's edon check guards against).
    var scenfrees: EnumFrees = consumed_scalar_enum_frees(stmts, s.structs, s.sigs.opt_fresh_ret_fns, true);
    // Consumed RC-PAYLOAD enum free, per block (#6127) — the last member of this
    // family to get a block-level sibling. lower_func runs
    // consumed_rcpayload_enum_frees over fn.body only, so `while { var t =
    // Text("a" + "b"); match (t) { … } }` freed its box on every iteration except
    // the LAST, whose value no analysis reclaimed: measured 7200 bytes over 100
    // rounds where the byte-identical shape at fn top level is flat at 0. Unlike
    // the scalar sibling this one already emitted SOME releases (the loop-rebind
    // reclaim via the RCENUM credit), which is why it leaked partially rather
    // than completely.
    //
    // Freed at most once, by the same three facts as the scalar sibling above,
    // plus a fourth specific to this class: ecross (enum_cross_reuse_sites) is
    // computed over fn.body FLAT, exactly like edon, so a nested-block box can
    // never have been donated to a cross-reuse recipient — which is what the
    // fn-level emission's ecross.donors suppression guards against.
    var rcenfrees: RcEnumFrees = consumed_rcpayload_enum_frees(stmts, s.structs, s.sigs.opt_fresh_ret_fns, s.sigs.str_fresh_ret_fns, s.move_sites, s.sigs.borrowable_params);
    var st: LowerState = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var sbase: i32 = st.locals.len();
        // Statement i is inside a block-level candidate's LIVE RANGE — after its
        // `var`, up to and including its consuming match — so set the pending
        // return-drop entries (#4353 p1/p3, #7742). A `return` from any of those
        // statements returns from the FUNCTION and jumps the post-match drop, so
        // the return-path sweep must free the payload + box itself.
        //
        // The window is the live range and not the match statement alone, which
        // is what #7742 measured: an `if (…) { return 5; }` between the `var` and
        // the match left the local released by nothing at all. Excluding i ==
        // vidxs is deliberate — the slot is not bound until that statement
        // finishes, and nothing can strand a value that does not exist yet.
        // Blockable kinds only; restored after the statement lowers.
        var optret_prev: string[] = st.optret_pending;
        var opj: i32 = 0;
        while (opj < rcopt.idxs.len()) {
            if (rcopt.vidxs[opj] < i && i <= rcopt.idxs[opj] && rcopt.blockable[opj]) {
                var opslot2: i32 = st.slot_of(rcopt.names[opj]);
                if (opslot2 >= st.n_params) {
                    st = st.with_optret_pending(st.optret_pending.append(optret_opt_entry(opslot2, rcopt, opj)));
                }
            }
            opj = opj + 1;
        }
        // Same, for the block-local scalar-enum / scalar-Option box (#6219).
        var sej: i32 = 0;
        while (sej < scenfrees.idxs.len()) {
            if (scenfrees.vidxs[sej] < i && i <= scenfrees.idxs[sej]) {
                var seslot2: i32 = st.slot_of(scenfrees.names[sej]);
                if (seslot2 >= st.n_params) {
                    st = st.with_optret_pending(st.optret_pending.append(util.i32_to_string(seslot2) + "#b"));
                }
            }
            sej = sej + 1;
        }
        // Same, for the block-local rc-PAYLOAD enum box.
        var rej: i32 = 0;
        while (rej < rcenfrees.idxs.len()) {
            // match_moved_rc_payloads reads the CURRENT statement, which is what
            // makes the widened window right rather than merely wider: before the
            // match no arm has bound anything, so it answers "nothing moved" and
            // the entry carries the full deep drop; at the match it answers with
            // the arm's own moved set. Passing the match's set on a pre-match
            // return would withhold drops for fields that path never moved.
            if (rcenfrees.vidxs[rej] < i && i <= rcenfrees.idxs[rej]) {
                var reslot2: i32 = st.slot_of(rcenfrees.names[rej]);
                if (reslot2 >= st.n_params) {
                    st = st.with_optret_pending(st.optret_pending.append(rcenum_pending_entry(reslot2, rcenfrees.enums[rej], match_moved_rc_payloads(stmts[i], st.structs))));
                }
            }
            rej = rej + 1;
        }
        // Is statement i a self-overwrite (functional-update) reuse site?
        var soi: i32 = 0 - 1;
        var c: i32 = 0;
        while (c < so.idxs.len()) {
            if (so.idxs[c] == i) { soi = c; }
            c = c + 1;
        }
        // Is statement i a cross-struct reuse site?
        var xri: i32 = 0 - 1;
        var a: i32 = 0;
        while (a < xreuse.idxs.len()) {
            if (xreuse.idxs[a] == i) { xri = a; }
            a = a + 1;
        }
        // Is statement i a cross-tuple reuse site?
        var xti: i32 = 0 - 1;
        var b: i32 = 0;
        while (b < xtuple.idxs.len()) {
            if (xtuple.idxs[b] == i) { xti = b; }
            b = b + 1;
        }
        if (soi >= 0) {
            match (stmts[i]) {
                ast.StmtVar(rv) => { st = emit_self_overwrite_reuse(rv.name, reclaim_site_key_of(rv.name, rv.line, rv.col), rv.init, so.bases[soi], true, st, false); },
                _ => { st = lower_stmt(stmts[i], st); },
            }
        } else if (xri >= 0) {
            match (stmts[i]) {
                ast.StmtVar(rv) => { st = emit_cross_struct_reuse(rv.name, reclaim_site_key_of(rv.name, rv.line, rv.col), rv.init, xreuse.donors[xri], xreuse.dtypes[xri], true, st); },
                _ => { st = lower_stmt(stmts[i], st); },
            }
        } else if (xti >= 0) {
            match (stmts[i]) {
                ast.StmtVar(rv) => {
                    match (rv.init) {
                        ast.ExprTuple(tup) => {
                            if (tuple_lit_ctor_eligible(tup, st)) { st = emit_cross_tuple_reuse(rv.name, rv.type_name, reclaim_site_key_of(rv.name, rv.line, rv.col), rv.init, xtuple.donors[xti], true, st); }
                            else { st = lower_stmt(stmts[i], st); }
                        },
                        _ => { st = lower_stmt(stmts[i], st); },
                    }
                },
                _ => { st = lower_stmt(stmts[i], st); },
            }
        } else {
            // Inherited CROSS-BLOCK recipient? A `var c = T{…}` whose name an
            // enclosing block paired (xblock_pending) with a dead block-top donor —
            // reuse that donor's box in place (release_prior, reclaimable-gated
            // inside emit_cross_struct_reuse), then drop the consumed pairing.
            // Keyed on the recipient's binding SITE, not its name (#7253):
            // xblock_donor_for takes the FIRST row whose key matches, and
            // xblock_pairings_for deliberately restarts the else arm from the same
            // consumed set, so two sibling arms can mint rows under one spelling.
            // A name key then hands one arm's donor to the other arm's recipient,
            // and the emitters write through that donor's box in place.
            var xbname: string = "";
            var xb_kind: i32 = 0;   // 1 = struct construction, 2 = tuple construction
            match (stmts[i]) {
                ast.StmtVar(rv) => {
                    xbname = reclaim_site_key_of(rv.name, rv.line, rv.col);
                    match (rv.init) {
                        ast.ExprStructLit(_) => { xb_kind = 1; },
                        ast.ExprTuple(_) => { xb_kind = 2; },
                        _ => {}
                    }
                },
                _ => {}
            }
            var xbd: string = "";
            if (xb_kind > 0) { xbd = xblock_donor_for(st.xblock_pending, xbname); }
            if (xbd.len() > 0) {
                // xbd is "dname|dtype" (struct donor; dtype = the donor's own
                // layout type for the old-field release, #4356 divergence 2)
                // or "dname|" (tuple donor). Split before dispatching.
                var xdbar: i32 = 0;
                while (xdbar < xbd.len() && xbd[xdbar] != b'|') { xdbar = xdbar + 1; }
                var xbd_name: str = slice_unchecked(xbd, 0, xdbar);
                var xbd_type: string = "";
                if (xdbar < xbd.len()) { xbd_type = slice_unchecked(xbd, xdbar + 1, xbd.len()) + ""; }
                // Reuse the donor's box in place (release_prior, reclaimable-gated in
                // the emitter). Dispatch by the recipient's construction kind; a tuple
                // whose elements aren't ctor-eligible falls back to normal lowering.
                match (stmts[i]) {
                    ast.StmtVar(rv) => {
                        match (rv.init) {
                            ast.ExprStructLit(_) => { st = emit_cross_struct_reuse(rv.name, reclaim_site_key_of(rv.name, rv.line, rv.col), rv.init, xbd_name, xbd_type, true, st); },
                            ast.ExprTuple(tup) => {
                                if (tuple_lit_ctor_eligible(tup, st)) { st = emit_cross_tuple_reuse(rv.name, rv.type_name, reclaim_site_key_of(rv.name, rv.line, rv.col), rv.init, xbd_name, true, st); }
                                else { st = lower_stmt(stmts[i], st); }
                            },
                            _ => { st = lower_stmt(stmts[i], st); },
                        }
                    },
                    _ => {},
                }
                st = st.with_xblock_pending(xblock_without(st.xblock_pending, xbname));
            } else {
                // Lowering a NESTED block: set the cross-block pairings for THIS
                // statement's if-arms (empty otherwise) so the recursive lower_block
                // sees only its own donors, then restore the enclosing pending. The
                // donor exclusion (same-block struct + tuple donors) keeps cross- and
                // same-block reuse from claiming the same box.
                var xbcons: string[] = xreuse.donors;
                var xtc: i32 = 0;
                while (xtc < xtuple.donors.len()) { xbcons = xbcons.append(xtuple.donors[xtc]); xtc = xtc + 1; }
                var pairings: string[] = xblock_pairings_for(stmts, st.structs, i, so.bases, xbcons, st.sigs.return_fresh_struct_ret_fns);
                var prev: string[] = st.xblock_pending;
                st = st.with_xblock_pending(pairings);
                st = lower_stmt_or_self_assign_reuse(stmts[i], st);
                st = st.with_xblock_pending(prev);
            }
        }
        if (!st.ok) { return st; }
        st = st.with_optret_pending(optret_prev);
        // Consumed rc-payload option/result free: if statement i is the consuming
        // match of a block-local candidate, deep-drop its payload then free the
        // box now (string payloads via the rc-aware str_free) — the block-level
        // mirror of the fn-body loop's rcoptfrees emission.
        var rk: i32 = 0;
        while (rk < rcopt.idxs.len()) {
            // blockable-only: a struct-literal payload's shallow drop relies on
            // the fn-level OPTSTRUCT machinery for its array FIELDS — claiming
            // it here zeroes the slot and starves that machinery (leak).
            if (rcopt.idxs[rk] == i && rcopt.blockable[rk]) {
                var rslot: i32 = st.slot_of(rcopt.names[rk]);
                if (rslot >= st.n_params) {
                    if (rcopt.tagged[rk]) { st = emit_opt_tagged_payload_drop(st, rslot, rcopt.pfrees[rk], tagged_errfreefn(rcopt.errstrs[rk])); }
                    else if (rcopt.inners[rk].len() > 0) { st = emit_optopt_rc_deep_free(st, rslot, rcopt.inners[rk]); }
                    else if (rcopt.pfrees[rk] != "__fern_rc_dec") { st = emit_opt_payload_drop_via(st, rslot, rcopt.pfrees[rk]); }
                    else if (rcopt.stys[rk].len() > 0) { st = emit_opt_struct_payload_drop(st, rslot, rcopt.stys[rk]); }
                    else { st = emit_opt_payload_drop(st, rslot); }
                }
            }
            rk = rk + 1;
        }
        // Consumed scalar-enum free: if statement i is the consuming match of a
        // block-local candidate, dec its box and zero the slot now — the
        // block-level mirror of lower_func's enumfrees emission. Zeroing matters
        // for a LOOP body: the slot is re-declared next iteration, and a stale
        // pointer there would be dec'd twice. Emitted BEFORE retire_locals, while
        // the name still resolves — after retirement the slot is unfindable, which
        // is why the function-exit sweep cannot claim this on its own. It claims
        // the `return`-out-of-an-arm paths only, off the "#b" pending entry set
        // above, which records the SLOT while the name still resolves.
        var sef: i32 = 0;
        while (sef < scenfrees.idxs.len()) {
            if (scenfrees.idxs[sef] == i) {
                var sslot: i32 = st.slot_of(scenfrees.names[sef]);
                if (sslot >= st.n_params) { st = emit_scalar_enum_box_free(st, sslot); }
            }
            sef = sef + 1;
        }
        // Consumed rc-payload enum free: same placement and the same reason as the
        // scalar loop above, but the release is emit_enum_variant_drops_gated —
        // a runtime variant_is dispatch that decs the live variant's rc payload and
        // then frees the box, skipping any field whose arm binding escaped
        // (match_moved_rc_payloads, #4400). The slot-zero inside that helper is
        // what keeps this disjoint from the RCENUM loop-rebind reclaim: on the
        // next iteration emit_enum_deep_reinit_store would otherwise deep-drop
        // the box this just freed.
        var ref2: i32 = 0;
        while (ref2 < rcenfrees.idxs.len()) {
            if (rcenfrees.idxs[ref2] == i) {
                var rslot2: i32 = st.slot_of(rcenfrees.names[ref2]);
                // moved_elided: a construction took over this local's reference and
                // dropped the retain, so its release belongs to the destination —
                // see the RCENUMS sweep's note.
                if (rslot2 >= st.n_params && !slot_list_has(st.moved_elided, rslot2)) {
                    st = emit_enum_variant_drops_gated(st, rslot2, rcenfrees.enums[ref2], match_moved_rc_payloads(stmts[i], st.structs), true);
                }
            }
            ref2 = ref2 + 1;
        }
        if (stmt_scopes_bindings(stmts[i])) { st = st.retire_locals_for_scope(sbase, [stmts[i]]); }
        i = i + 1;
    }
    return st.retire_locals_for_scope(base, stmts);
}

// LowerResult is lower_func's output: the lowered op stream, the local-slot
// count (operand-frame size for the interpreter / a backend), and ok.
pub struct LowerResult {
    ok: boolean,
    ops: ir.Op[],
    n_locals: i32,
    n_params: i32,
    // erased_wide: the body passes a 64-bit or f64 value to a BARE-TYPEVAR
    // (erased-generic) param, or consumes such a call's mirrored 64-bit
    // return. The register backends lower it (8-byte slots); the wasm
    // backend types erased param locals i32, so wasm_ir_deferrals_ok refuses
    // the module (an f64 through an erased param previously emitted
    // type-INVALID WAT the wasmtime loader rejects).
    erased_wide: boolean,
    // arr_slots: the local slots holding arrays. Read only by irlower_run's
    // `-slots` dump; entry-zeroing covers the whole body range regardless.
    arr_slots: i32[],
    // i64_slots: the local slots holding i64 values — the wasm backend declares
    // these (local i64); the register backends ignore it (i64 shares the 64-bit
    // slot with i32).
    i64_slots: i32[],
    // f64_slots: the local slots holding f64 values; the wasm backend declares
    // these (local f64). The register backends ignore it (f64 shares the slot).
    f64_slots: i32[],
    // str_slots: the local slots holding strings. Carried for the verifier
    // (#6639), not for emission — a string is one operand slot on the
    // registers and two on wasm32, so a stack model needs the distinction.
    str_slots: i32[],
    // why: why this function did not lower — either a SIGNATURE refusal raised
    // in lower_func itself (an unlowerable return / receiver / param type) or
    // the body's innermost failing node, carried out of LowerState.fail_why.
    // Empty when ok. The strict-IR diagnostic prints it; nothing on the emit
    // path reads it.
    why: string,
    // alias_incs: the var-bind alias retains this lowering decided
    // (`line:col=name`), carried out of LowerState for the `-rc-plan`
    // aliasBindIncs table (#4482). Nothing on the emit path reads it.
    alias_incs: string[],
}

// lower_failed builds a signature-refusal LowerResult carrying `why`. The
// signature gates run before any lowering, so the ops / slot lists are all empty
// and only the reason varies — five near-identical 8-field literals that said
// nothing about which gate refused.
function lower_failed(fn: parser.FuncDecl, why: string): LowerResult {
    var noops: ir.Op[] = [];
    var noslots: i32[] = [];
    return LowerResult { ok: false, ops: noops, n_locals: 0, n_params: fn.params.len(), erased_wide: false, arr_slots: noslots, i64_slots: noslots, f64_slots: noslots, str_slots: noslots, why: why, alias_incs: [] };
}

// fail_why_or_unknown reads a failed state's bail description, naming the gap
// rather than printing an empty reason when a bail bypassed both dispatchers
// (a helper called straight from lower_func's body loop).
function fail_why_or_unknown(s: LowerState): string {
    if (s.fail_why.len() == 0) { return "unattributed bail (no lower_expr / lower_stmt frame stamped it)"; }
    return s.fail_why;
}

// arr_slots_of lists the local slots holding ARRAY values — params included,
// like the other three classifiers. A slot's class answers what the slot
// HOLDS, so borrowedness (a param) and reclaimability (whether the exit sweep
// owns it) are not part of it: both are properties of the binding, and the
// sweep derives them itself from the slot_is_reclaimable_* predicates.
function arr_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.locals.len()) {
        if (s.is_arr_slot(i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// i64_slots_of lists the i64-holding local slots (params included — though
// eligible functions have no i64 params, lower_func bails on those).
function i64_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.locals.len()) {
        if (s.is_i64_slot(i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}
// f64_slots_of: the local slots holding f64 values, so the wasm backend
// declares them (local f64). The register backends ignore it (f64 shares the
// 8-byte slot; only the ops differ).
function f64_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.locals.len()) {
        if (s.is_f64_slot(i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// str_slots_of: the local slots holding STRING values. A string is one
// operand slot on the register backends and TWO on wasm32 (ptr + len, per
// ir.UseTwoWordStrings), so a pass that models the operand stack cannot get a
// function's height right without knowing which slots are strings — #6639
// slice 2 is the consumer. Nothing on the emit path reads it: the backends
// already carry the same fact through LowerState.
function str_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.locals.len()) {
        if (s.is_str_slot(i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// is_array_type_name reports whether a type string denotes an array (ends
// with "[]", e.g. "i32[]").
function is_array_type_name(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return slice_unchecked(t, n - 2, n) == "[]";
}

// is_u32_type_name reports whether a declared type is u32 (scalar) or u32[]
// (array) — the slots that drive u32 wrapping (local_is_u32). u8 is
// excluded: its values are read in-range and explicitly cast, so it needs no
// post-arithmetic wrap.
function is_u32_type_name(t: string): boolean {
    return t == "u32" || t == "u32[]";
}

// is_u64_type_name reports whether a declared type is u64 (scalar) or u64[] —
// the slots that drive UNSIGNED i64-domain ops (local_is_u64, #2904).
function is_u64_type_name(t: string): boolean {
    return t == "u64" || t == "u64[]";
}

// subword_kind_of_name maps a declared type to its sub-32-bit integer kind
// ("u8") or "" (not a sub-word int). A trailing `[]` is
// stripped first so a u8[] array slot records its ELEMENT kind
// (the element a[i] reads), exactly as is_u32_type_name treats u32[]. This
// is the only width whose arithmetic can exceed the slot and must wrap.
function subword_kind_of_name(t: string): string {
    var b: string = t;
    if (b.len() >= 2 && slice_unchecked(b, b.len() - 2, b.len()) == "[]") { b = slice_unchecked(b, 0, b.len() - 2) + ""; }
    if (b == "u8") { return "u8"; }
    return "";
}

// is_f64_scalar_type_name reports whether a declared SCALAR type is an 8-byte
// IEEE float — f64 or f32 (Fern represents f32 as an f64 internally: f32<->f64
// casts are no-ops and every float op runs at double width). The two spell the
// same runtime value, so a slot of either is marked local_is_f64 and a function
// returning either is registered f64-returning. (Arrays f64[]/f32[] are tracked
// separately via local_is_f64arr; this is the scalar classifier only.)
pub function is_f64_scalar_type_name(t: string): boolean {
    return t == "f64" || t == "f32" || t == "float";
}

// --- struct reclamation: conservative intra-procedural escape analysis ---
//
// reclaimable_names_of computes the struct-local names that are SAFE to free at
// scope exit / loop-rebind: names bound from a FRESH struct literal (a sole-owner
// rc=1 box) that never ESCAPE the function. A name escapes if it appears anywhere
// as a value — a return value, a call argument, a method receiver, a struct-lit
// field value, an array/tuple element, an operand, or the RHS of any binding /
// assignment — i.e. anything but a pure field READ (p.x, even `return p.x`,
// copies a scalar out and leaves p local). Anything uncertain is treated as
// escaping and left to leak: freeing only proven sole-owner non-escaping boxes
// cannot dangle another live reference (the safety property the earlier shallow-RC
// slice lacked — it freed escaping boxes and use-after-free'd the self-compile).
// Later slices widen this toward the native inter-procedural borrow inference.

// push_str_unique appends s to xs unless already present.
function push_str_unique(xs: string[], s: string): string[] {
    if (util.index_of_str(xs, s) >= 0) { return xs; }
    return xs.append(s);
}

// --- Binding-SITE keys for the tuple class credits (#7272 / #7253 step 1) ---
//
// The class credits are collected from the AST, before any slot exists, so their
// key has always been the variable NAME — and a name has no scope. Two `var t`
// in sibling blocks are two slots under one key, and when they are not the same
// class the table hands each slot BOTH credits: the box takes the "TUP:" shallow
// dec AND the "TUPRCS:" deep free, and is released twice. Measured as exit 99
// (rc underflow) against 10 on native and interp, with `live_bytes=0` throughout
// — only the underflow counter dissents. Renaming one of the two locals, and
// nothing else, made it correct.
//
// A `StmtVar` carries line and col, so `name@line:col` names the BINDING rather
// than the name, and the two blocks stop colliding. bind_var_slot records it on
// the slot, so every consumer resolves the credit its own binding earned.
//
// The families converted so far: tuple (#7272), "STR:" (#7292), "SARR:" /
// "SARRB:" and "ARRARR:" / "ARRARRS:" (#7253, #7335), the bare-name struct
// credit and its "NODEEP:" / "FLDCHECKED:" markers (#7349), and the whole
// Option family. The rest of the ~70 namespaces multiplexed into
// reclaimable_names are keyed on the site too as of the final-eight conversion,
// which retired `reclaim_slot_name` outright — this is the only credit key now.
function reclaim_site_key_of(name: string, line: i32, col: i32): string {
    return name + "@" + util.i32_to_string(line) + ":" + util.i32_to_string(col);
}

// reclaim_site_name recovers the bare variable name from a site key, for the
// escape gates and declaration lookups, which all take a name.
function reclaim_site_name(key: string): string {
    var i: i32 = 0;
    while (i < key.len() && key[i] != b'@') { i = i + 1; }
    return slice_unchecked(key, 0, i) + "";
}

// walk_fieldread_obj walks the OBJECT of a field-read chain (p.x, p.a.b): a bare
// ident object is NOT an escape (a scalar field is copied out, p stays local); a
// computed object (f().x, arr[i].x) escapes through its producer.
function walk_fieldread_obj(obj: ast.Expr, acc: string[]): string[] {
    match (obj) {
        ast.ExprIdent(_) => { return acc; },
        ast.ExprFieldAccess(fa) => { return walk_fieldread_obj(fa.obj, acc); },
        _ => { return walk_expr_escapes(obj, acc); },
    }
}

// walk_call_callee marks a method call's RECEIVER (obj.method(...)) as escaping
// (it is passed to the callee); a bare free-function name is not a local value.
function walk_call_callee(callee: ast.Expr, acc: string[]): string[] {
    match (callee) {
        ast.ExprIdent(_) => { return acc; },
        ast.ExprFieldAccess(fa) => { return walk_expr_escapes(fa.obj, acc); },
        _ => { return walk_expr_escapes(callee, acc); },
    }
}

// walk_expr_escapes adds to acc every local name that escapes through e.
function walk_expr_escapes(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprIdent(id) => { return push_str_unique(acc, id.name); },
        ast.ExprFieldAccess(fa) => { return walk_fieldread_obj(fa.obj, acc); },
        ast.ExprCall(c) => {
            var a: string[] = walk_call_callee(c.callee, acc);
            for arg in c.args { a = walk_expr_escapes(arg, a); }
            return a;
        },
        ast.ExprBinary(b) => { return walk_expr_escapes(b.right, walk_expr_escapes(b.left, acc)); },
        ast.ExprUnary(u) => { return walk_expr_escapes(u.operand, acc); },
        ast.ExprIndex(ix) => { return walk_expr_escapes(ix.index, walk_expr_escapes(ix.array, acc)); },
        ast.ExprSlice(sl) => { return walk_expr_escapes(sl.end, walk_expr_escapes(sl.start, walk_expr_escapes(sl.array, acc))); },
        ast.ExprArray(arr) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < arr.elements.len()) { a = walk_expr_escapes(arr.elements[i], a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(tu) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < tu.elements.len()) { a = walk_expr_escapes(tu.elements[i], a); i = i + 1; }
            return a;
        },
        ast.ExprStructLit(slit) => {
            var a: string[] = acc;
            if (slit.has_base) { a = walk_expr_escapes(slit.base, a); }
            var i: i32 = 0;
            while (i < slit.field_values.len()) { a = walk_expr_escapes(slit.field_values[i], a); i = i + 1; }
            return a;
        },
        ast.ExprLambda(lm) => { return walk_stmts_escapes(lm.body, acc); },
        _ => { return acc; },
    }
}

// walk_stmts_escapes / walk_stmt_escapes walk a statement list for escapes.
function walk_stmts_escapes(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = walk_stmt_escapes(stmt, a); }
    return a;
}

function walk_stmt_escapes(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => { return walk_expr_escapes(v.init, acc); },
        ast.StmtReturn(r) => { return walk_expr_escapes(r.value, acc); },
        ast.StmtExpr(ex) => { return walk_expr_escapes(ex.value, acc); },
        ast.StmtAssign(asn) => { return walk_expr_escapes(asn.value, acc); },
        ast.StmtIf(iff) => {
            var a: string[] = walk_expr_escapes(iff.cond, acc);
            a = walk_stmts_escapes(iff.then_body, a);
            return walk_stmts_escapes(iff.else_body, a);
        },
        ast.StmtWhile(w) => {
            var a: string[] = walk_expr_escapes(w.cond, acc);
            return walk_stmts_escapes(w.body, a);
        },
        ast.StmtFor(f) => {
            var a: string[] = walk_expr_escapes(f.iter, acc);
            return walk_stmts_escapes(f.body, a);
        },
        ast.StmtMatch(m) => {
            var a: string[] = walk_expr_escapes(m.scrutinee, acc);
            for arm in m.arms {
                if (arm.has_guard) { a = walk_expr_escapes(arm.guard, a); }
                a = walk_stmts_escapes(arm.body, a);
            }
            return a;
        },
        ast.StmtDefer(d) => { return walk_stmt_escapes(d.action, acc); },
        _ => { return acc; },
    }
}

// --- frame-allocated string views (#6713) ------------------------------------
//
// A string view `slice_unchecked(s, a, b)` is zero-copy: a 24-byte box
// [rc=-1, data = src.data + start, len] sharing the source buffer. Sharing is
// why it is born IMMORTAL (rc=-1, #4294) — freeing it would attack the middle
// of the source's allocation — and immortal is why it is never reclaimed, so a
// slice in a loop costs one unreclaimable box per EVALUATION where native, which
// has no box at all, allocates nothing.
//
// view_frame_names_of returns the local names whose box may live in the FRAME
// instead of the heap: names bound from a slice and used ONLY where the box is
// borrowed for the duration of one expression — the `.len()` receiver, a byte
// index `t[i]`, a comparison or concat operand, and the source of a further
// slice (whose own data pointer aims at the SOURCE buffer, not at this box, so
// it outlives it safely).
//
// Everything else is refused, and the whitelist has to be that narrow because
// there are two distinct hazards, not one. A reference that outlives the FRAME
// dangles. A reference that outlives the next execution of the same SITE reads
// the newer view instead — one frame slot serves a site, so a loop rewrites it
// once per iteration. Copying the name into a second local (`var u = t`,
// `prev = cur`)
// is the second hazard's classic shape, which is why a bare ident in a binding
// position is refused even though the frame is still very much alive.
function ident_named_is(e: ast.Expr, name: string): boolean {
    return ident_name_or_empty(e) == name && name.len() > 0;
}

// expr_mentions_name: does `name` appear anywhere in `e`? The fallback for an
// expression shape the borrow whitelist does not model — mentioned there at all
// means refused.
function expr_mentions_name(e: ast.Expr, name: string): boolean {
    return util.index_of_str(astwalk.collect_idents_expr(e, []), name) >= 0;
}

// view_borrow_binop reports whether a binary operator merely READS its string
// operands: the bytes are consumed by the operator itself, and whatever it
// produces is a fresh value that does not point into either operand's box.
function view_borrow_binop(op: string): boolean {
    return op == "+" || op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=";
}

// expr_view_borrow_only: every occurrence of `name` in `e` borrows it.
function expr_view_borrow_only(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name != name; },
        ast.ExprNumber(_) => { return true; },
        ast.ExprString(_) => { return true; },
        ast.ExprBool(_) => { return true; },
        ast.ExprUnary(u) => { return expr_view_borrow_only(u.operand, name); },
        ast.ExprIndex(ix) => {
            if (ident_named_is(ix.array, name)) { return expr_view_borrow_only(ix.index, name); }
            return expr_view_borrow_only(ix.array, name) && expr_view_borrow_only(ix.index, name);
        },
        // `s[a:b]` is NOT borrow-only: the `Option[str]` box it builds (#5634)
        // carries a view of `name`'s bytes out of the expression. It falls to the
        // catch-all, which refuses. `slice_unchecked` stays borrow-only below.
        ast.ExprBinary(b) => {
            if (view_borrow_binop(b.op)) {
                var l_ok: boolean = ident_named_is(b.left, name) || expr_view_borrow_only(b.left, name);
                var r_ok: boolean = ident_named_is(b.right, name) || expr_view_borrow_only(b.right, name);
                return l_ok && r_ok;
            }
            return expr_view_borrow_only(b.left, name) && expr_view_borrow_only(b.right, name);
        },
        ast.ExprCall(c) => {
            // slice_unchecked(src, a, b) (#5634): like the ExprSlice arm, the
            // source may be the view name itself — a further slice's data
            // pointer aims at the SOURCE buffer, not at this box.
            if (slice_unchecked_call(e)) {
                var su_ok: boolean = ident_named_is(c.args[0], name) || expr_view_borrow_only(c.args[0], name);
                return su_ok && expr_view_borrow_only(c.args[1], name) && expr_view_borrow_only(c.args[2], name);
            }
            var args_ok: boolean = true;
            for arg in c.args {
                if (!expr_view_borrow_only(arg, name)) { args_ok = false; }
            }
            if (!args_ok) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    // `t.len()` reads the box's length word and keeps nothing.
                    if (c.args.len() == 0 && fa.field == "len" && ident_named_is(fa.obj, name)) { return true; }
                    return expr_view_borrow_only(fa.obj, name);
                },
                _ => { return expr_view_borrow_only(c.callee, name); }
            }
        },
        ast.ExprFieldAccess(fa) => { return expr_view_borrow_only(fa.obj, name); },
        // A capture outlives the frame in the closure's env box.
        ast.ExprLambda(lm) => { return !body_mentions_name(lm.body, name); },
        _ => { return !expr_mentions_name(e, name); }
    }
    return false;
}

function stmts_view_borrow_only(stmts: ast.Stmt[], name: string): boolean {
    var ok: boolean = true;
    for stmt in stmts {
        if (!stmt_view_borrow_only(stmt, name)) { ok = false; }
    }
    return ok;
}

function stmt_view_borrow_only(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return expr_view_borrow_only(v.init, name); },
        ast.StmtReturn(r) => { return expr_view_borrow_only(r.value, name); },
        ast.StmtExpr(ex) => { return expr_view_borrow_only(ex.value, name); },
        ast.StmtAssign(asn) => {
            // Rebinding the name itself just overwrites the slot; a target that
            // merely STARTS with it is a write through the view, which the
            // whitelist has no model for.
            if (asn.target != name && asn.target.len() > name.len()
                    && slice_unchecked(asn.target, 0, name.len()) == name) { return false; }
            return expr_view_borrow_only(asn.value, name);
        },
        ast.StmtIf(iff) => {
            return expr_view_borrow_only(iff.cond, name)
                && stmts_view_borrow_only(iff.then_body, name)
                && stmts_view_borrow_only(iff.else_body, name);
        },
        ast.StmtWhile(w) => {
            return expr_view_borrow_only(w.cond, name) && stmts_view_borrow_only(w.body, name);
        },
        ast.StmtFor(f) => {
            return expr_view_borrow_only(f.iter, name) && stmts_view_borrow_only(f.body, name);
        },
        ast.StmtMatch(m) => {
            var mok: boolean = expr_view_borrow_only(m.scrutinee, name);
            for arm in m.arms {
                if (arm.has_guard && !expr_view_borrow_only(arm.guard, name)) { mok = false; }
                if (!stmts_view_borrow_only(arm.body, name)) { mok = false; }
            }
            return mok;
        },
        ast.StmtDefer(d) => { return stmt_view_borrow_only(d.action, name); },
        _ => { return true; }
    }
    return true;
}

// view_slice_binding_names collects every name bound from a `slice_unchecked`
// view — the candidates the borrow scan then filters. `s[a:b]` binds an
// `Option[str]` box, not a view, so it is not a candidate (#5634).
function view_slice_binding_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        a = view_slice_binding_names_stmt(stmt, a);
    }
    return a;
}

function view_slice_binding_names_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprCall(_) => {
                    if (slice_unchecked_call(v.init)) { return push_str_unique(acc, v.name); }
                    return acc;
                },
                _ => { return acc; }
            }
        },
        ast.StmtIf(iff) => {
            return view_slice_binding_names(iff.else_body, view_slice_binding_names(iff.then_body, acc));
        },
        ast.StmtWhile(w) => { return view_slice_binding_names(w.body, acc); },
        ast.StmtFor(f) => { return view_slice_binding_names(f.body, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = view_slice_binding_names(arm.body, a); }
            return a;
        },
        ast.StmtDefer(d) => { return view_slice_binding_names_stmt(d.action, acc); },
        _ => { return acc; }
    }
    return acc;
}

// view_frame_names_of: the slice-bound names of `body` that only ever borrow
// their view. Seeded once per function by lower_func as "VIEWFRAME:<name>".
pub function view_frame_names_of(body: ast.Stmt[]): string[] {
    var cands: string[] = view_slice_binding_names(body, []);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < cands.len()) {
        if (stmts_view_borrow_only(body, cands[i])) { out = out.append(cands[i]); }
        i = i + 1;
    }
    return out;
}

// --- in-place self-reassign alias guard (#3599) ------------------------------
//
// aliased_array_names_of returns the local names that acquire a lasting LOCAL
// alias somewhere in `body` — a name bound to a second local (`var b = a` /
// `b = a`) or stored as a bare ident into a container literal that outlives the
// binding (`H { xs: a }`, `[a, …]`, `(a, …)`). These are exactly the positions
// where the in-place `a = a.with(i, v)` self-reassign (an arr_set assuming sole
// ownership) would silently mutate a buffer another live name still reads.
//
// PRECISION (vs walk_expr_escapes, which is the coarse leak/escape notion): this
// scan only credits a bare ident sitting in a BINDING or CONTAINER-element
// position. Call arguments are treated as BORROWS (not aliases) — matching the
// issue's `bump(a)` row that is sound — so they are not scanned. RETURN values
// are skipped too: a returned alias moves out at function exit, AFTER every
// in-place mutation, so it is no hazard — and scanning it would wrongly flag the
// hot VM `stack/heap/locals = …​.with(…)` whose only "alias" is the move-out
// `return EvalOut { heap: heap }`.
function alias_idents_in_value(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        // A bare ident in a binding/container position IS a new alias.
        ast.ExprIdent(id) => { return push_str_unique(acc, id.name); },
        // Container literals carry their bare-ident elements through as aliases
        // (the element's buffer is now also owned by the container). Recurse so a
        // nested literal (`[H { xs: a }]`) is covered; non-ident, non-literal
        // elements (calls, field reads, arithmetic) produce fresh/borrowed values
        // and create no lasting alias, so they are not credited.
        ast.ExprStructLit(slit) => {
            var a: string[] = acc;
            if (slit.has_base) { a = alias_idents_in_value(slit.base, a); }
            var i: i32 = 0;
            while (i < slit.field_values.len()) { a = alias_idents_in_value(slit.field_values[i], a); i = i + 1; }
            return a;
        },
        ast.ExprArray(arr) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < arr.elements.len()) { a = alias_idents_in_value(arr.elements[i], a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(tu) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < tu.elements.len()) { a = alias_idents_in_value(tu.elements[i], a); i = i + 1; }
            return a;
        },
        _ => { return acc; },
    }
}

function alias_names_in_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        // `var b = a` / `b = a` (or a container literal whose element is a bare
        // ident) creates the alias; recurse into the value's container literals.
        ast.StmtVar(v) => { return alias_idents_in_value(v.init, acc); },
        ast.StmtAssign(a) => { return alias_idents_in_value(a.value, acc); },
        // Nested blocks may introduce aliases too.
        ast.StmtIf(iff) => {
            var a: string[] = alias_names_in_stmts(iff.then_body, acc);
            return alias_names_in_stmts(iff.else_body, a);
        },
        ast.StmtWhile(w) => { return alias_names_in_stmts(w.body, acc); },
        ast.StmtFor(f) => { return alias_names_in_stmts(f.body, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = alias_names_in_stmts(arm.body, a); }
            return a;
        },
        ast.StmtDefer(d) => { return alias_names_in_stmt(d.action, acc); },
        // StmtReturn / StmtExpr deliberately not scanned (see the header note).
        _ => { return acc; },
    }
}

function alias_names_in_stmts(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = alias_names_in_stmt(stmt, a); }
    return a;
}

// --- borrowed-value guard (#6158) --------------------------------------------
//
// The alias scan above answers "does another LOCAL name reach this buffer",
// which is only half of what the in-place self-reassign needs. The other half
// is OWNERSHIP: `x = x.with(i, v)` overwrites in place on the assumption that
// `x` is a sole owner, and a BORROWED value is not one no matter how few local
// aliases it has. Three shapes reached the in-place path while the caller still
// owned the buffer, so the write landed in the caller's array:
//
//   * a borrowed ARRAY PARAM self-reassigned directly
//     (`function patch(buf: i32[], …) { buf = buf.with(at, v); }`);
//   * a local bound from an array FIELD of a borrowed struct param
//     (`var sn = st.seen; sn = sn.with(pc, g);` — std/regex's __rx_addthread);
//   * the same off a LOCAL struct that is still read afterwards.
//
// The language already models the sound version, and the hot paths already use
// it: `arm64_write_word(own buf: i32[], …)` consumes its buffer precisely so
// the rc check sees a unique owner, and E051 makes that annotation trustworthy
// at every call site. So the rule is ownership, not syntax — an `own` param
// keeps the fast path, a borrowed one clones.
//
// The `own`-param + field-clear idiom (`var code = a.code; a = A { ...a, code:
// [] };` — arm64_asm_resolve's three quadratic patch loops, #6011) stays
// in-place: the source field is emptied before the mutation, so the local IS
// the only reference. That exemption is why this keys on a positional scan
// rather than flagging every field-read binding.

// field_read_base returns the base object name of a `OBJ.field` init, or "" —
// the source whose buffer such a binding borrows.
function field_read_base(e: ast.Expr): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(id) => { return id.name; },
                _ => { return ""; },
            }
        },
        _ => { return ""; },
    }
    return "";
}

// stmt_assigns_name reports whether `st` is a direct `NAME = …` assignment.
function stmt_assigns_name(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtAssign(a) => { return a.target == name; },
        _ => { return false; },
    }
    return false;
}

// borrowed_field_bindings walks a statement LIST and credits every
// `var X = OBJ.field` binding whose source is not cleared before X is next
// assigned — i.e. every binding that still shares OBJ's buffer at the point
// the in-place write would happen. A binding whose OBJ is reassigned first
// (the field-clear idiom) is exempt and keeps the fast path. Nested blocks are
// scanned for their own bindings; a binding whose mutation happens in a nested
// block is credited (conservative — it clones), since this positional scan
// cannot see the clear across the block boundary.
function borrowed_field_bindings(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                var base: string = field_read_base(v.init);
                if (base.len() > 0) {
                    var cleared: boolean = false;
                    var j: i32 = i + 1;
                    while (j < stmts.len()) {
                        if (stmt_assigns_name(stmts[j], base)) { cleared = true; j = stmts.len(); }
                        else if (stmt_assigns_name(stmts[j], v.name)) { j = stmts.len(); }
                        else { j = j + 1; }
                    }
                    if (!cleared) { a = push_str_unique(a, v.name); }
                }
            },
            ast.StmtIf(iff) => {
                a = borrowed_field_bindings(iff.then_body, a);
                a = borrowed_field_bindings(iff.else_body, a);
            },
            ast.StmtWhile(w) => { a = borrowed_field_bindings(w.body, a); },
            ast.StmtFor(f) => { a = borrowed_field_bindings(f.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = borrowed_field_bindings(arm.body, a); }
            },
            _ => {},
        }
        i = i + 1;
    }
    return a;
}

function aliased_array_names_of(body: ast.Stmt[]): string[] {
    return alias_names_in_stmts(body, []);
}

// --- map alias liveness at a self-reassign (#7235) ---------------------------
//
// map_clone_insert_sites_of returns the site keys (target@line:col) of every map
// self-reassign `m = m.insert(k, v)` / `m = m.set(k, v)` at which an alias of
// `m` may be LIVE, so the store must clone the map (lower_map_clone_insert)
// rather than mutate the box the alias still reads. An alias is live at the
// insert when it is created earlier in lowering order, anywhere inside a loop
// enclosing the insert (the back edge carries an alias bound textually AFTER the
// insert into the next iteration's insert), or inside a defer. An insert with no
// alias live at it mutates in place; a `var q = m` bound afterwards shares the
// mutated box, which is what the alias reads on native too.
//
// Alias positions are alias_idents_in_value's: a bare-ident bind or assignment
// value, or a container-literal element. An alias inside an `if` arm counts for
// everything after the `if`, whichever way the branch went.
struct MapCloneScan { seen: string[], sites: string[] }

function map_clone_insert_sites_of(body: ast.Stmt[]): string[] {
    var none: string[] = [];
    return mcis_stmts(body, none, MapCloneScan { seen: [], sites: [] }).sites;
}

function mcis_stmts(stmts: ast.Stmt[], loop_aliases: string[], sc: MapCloneScan): MapCloneScan {
    var acc: MapCloneScan = sc;
    var i: i32 = 0;
    while (i < stmts.len()) { acc = mcis_stmt(stmts[i], loop_aliases, acc); i = i + 1; }
    return acc;
}

function mcis_stmt(st: ast.Stmt, loop_aliases: string[], sc: MapCloneScan): MapCloneScan {
    match (st) {
        ast.StmtAssign(a) => {
            var acc: MapCloneScan = sc;
            if (assign_is_self_two_arg_method(a) && (util.index_of_str(sc.seen, a.target) >= 0 || util.index_of_str(loop_aliases, a.target) >= 0)) {
                acc = MapCloneScan { ...acc, sites: acc.sites.append(reclaim_site_key_of(a.target, a.line, a.col)) };
            }
            return MapCloneScan { ...acc, seen: alias_idents_in_value(a.value, acc.seen) };
        },
        ast.StmtVar(v) => { return MapCloneScan { ...sc, seen: alias_idents_in_value(v.init, sc.seen) }; },
        ast.StmtIf(iff) => {
            var acc: MapCloneScan = mcis_stmts(iff.then_body, loop_aliases, sc);
            return mcis_stmts(iff.else_body, loop_aliases, acc);
        },
        ast.StmtWhile(w) => { return mcis_stmts(w.body, alias_names_in_stmts(w.body, loop_aliases), sc); },
        ast.StmtFor(f) => { return mcis_stmts(f.body, alias_names_in_stmts(f.body, loop_aliases), sc); },
        ast.StmtMatch(m) => {
            var acc: MapCloneScan = sc;
            var k: i32 = 0;
            while (k < m.arms.len()) { acc = mcis_stmts(m.arms[k].body, loop_aliases, acc); k = k + 1; }
            return acc;
        },
        ast.StmtDefer(d) => {
            var acc: MapCloneScan = MapCloneScan { ...sc, seen: alias_names_in_stmt(d.action, sc.seen) };
            return mcis_stmt(d.action, loop_aliases, acc);
        },
        // Spelled out rather than wildcarded: a statement kind with a body this
        // walk skipped would leave an insert inside it mutating in place.
        ast.StmtReturn(_) => { return sc; },
        ast.StmtExpr(_) => { return sc; },
        ast.StmtBreak(_) => { return sc; },
        ast.StmtContinue(_) => { return sc; },
        ast.StmtUnknown(_) => { return sc; },
    }
}

// assign_is_self_two_arg_method: `a` is `m = m.<method>(x, y)` — the shape
// the StmtAssign lowering inspects for the map self-reassign (`insert` / `set`)
// it routes to the clone when an alias is live. The method name is that site's
// question: a site listed for another method falls through there unchanged.
function assign_is_self_two_arg_method(a: ast.StmtAssign): boolean {
    var ops: string[] = call_operand_idents(a.value);
    return ops.len() == 3 && ops[0] == a.target;
}

// --- map alias groups (#7235) ------------------------------------------------
//
// A mapbox carries no rc word, so a second name for it is an UNCOUNTED share and
// the ownership of every box a set of names reaches is decided here: the map
// local `m`, its plain aliases `var q: Map[..] = m` and the local tuples holding
// it at an element (#7212) form a GROUP, credited "MAPAL:<qsite>|<msite>" and
// "MAPTUP:<tsite>|<k>|<msite>" beside m's "MAP:". The group holds one box until
// a self-reassign clones (lower_map_clone_insert), after which the holders bound
// before it keep the OLD box and m the clone. Which holder holds which box is a
// runtime fact, so every release in the group is guarded by identity
// (emit_map_release_unless_held): a holder frees its box only when no holder
// released after it still holds it, and the clone site frees the superseded box
// only when no holder at all does. That is what makes a conditional clone and a
// clone inside a loop both exact.
//
// Two rules keep the guard complete. Every holder slot must EXIST when a release
// is emitted, so neither m nor a plain alias may be declared inside a loop body:
// its re-declaration would run a guard the holders declared after it are absent
// from, and a stale holder still naming the box would free it a second time at
// its own rebind. And a name bound at two sites makes the rows name-ambiguous,
// so m must be bound exactly once. A tuple host keeps the override's own terms
// (it may sit in a loop): a host bound after the insert holds either the current
// box or a box only its superseded tuple names.
//
// A clone copies the column POINTERS uncounted, so the elements of a
// superseded box are shared with the clone. Only m's own sweep takes the
// column deep-releases ("MAPVS:" / "MAPKS:" / "MAPVA:"); a holder's release
// and the clone site's are the shallow free, which is what frees a shared
// element exactly once — by m, after every holder is dead. An element only a
// superseded box still names (a value the clone overwrote) leaks one level.

// map_alias_holder_sites: the binding sites of every plain alias `var q = m` in
// `body` when ALL of them qualify as holders — each not reassigned, not
// escaping, not explicitly iterated, carrying no identity use, and neither it
// nor m declared inside a loop. Empty when any alias fails, since forgiving a
// subset would leave m escaping through the rest.
function map_alias_holder_sites(body: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], reassigned: string[]): string[] {
    var none: string[] = [];
    if (var_decl_scan(body, name, false) != 1) { return none; }
    var found: string[] = bare_alias_bind_sites_of(body, name, false, []);
    var i: i32 = 0;
    while (i < found.len()) {
        var qn: string = reclaim_site_name(found[i]);
        if (util.index_of_str(reassigned, qn) >= 0
            || body_unsafe_for(body, qn, borrowable, recv_borrow)
            || map_has_explicit_iter(body, qn)
            || map_identity_escape(body, qn)
            || var_decl_scan(body, qn, false) >= 1000) { return none; }
        i = i + 1;
    }
    return found;
}

// map_tuple_holder_rows appends a "MAPTUP:<tsite>|<k>|<msite>" row for every bare
// position at which a local tuple binding holds `name` — the hosts
// map_tuple_elem_borrow_only admitted, one row per element. No rows when `name`
// is bound more than once: the override still admits the map, and a group
// without rows keeps the plain release pattern.
function map_tuple_holder_rows(stmts: ast.Stmt[], name: string, msite: string, acc: string[]): string[] {
    if (var_decl_scan(stmts, name, false) % 1000 != 1) { return acc; }
    // The fold's visitor captures nothing (#7215), so it reads `name` and
    // `msite` from the head of the accumulator it threads.
    var seeded: string[] = [name, msite];
    var i: i32 = 0;
    while (i < stmts.len()) {
        seeded = astwalk.fold_stmt_nodes(stmts[i], seeded, maptup_row_at, no_expr_strs, astwalk.descend_none);
        i = i + 1;
    }
    var out: string[] = acc;
    var r: i32 = 2;
    while (r < seeded.len()) { out = out.append(seeded[r]); r = r + 1; }
    return out;
}

function maptup_row_at(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            var pos: i32[] = tuple_bare_elem_positions(v.init, acc[0]);
            var a: string[] = acc;
            var k: i32 = 0;
            while (k < pos.len()) {
                a = a.append("MAPTUP:" + reclaim_site_key_of(v.name, v.line, v.col) + "|" + util.i32_to_string(pos[k]) + "|" + acc[1]);
                k = k + 1;
            }
            return a;
        },
        ast.StmtReturn(_) => { return acc; },
        ast.StmtExpr(_) => { return acc; },
        ast.StmtIf(_) => { return acc; },
        ast.StmtWhile(_) => { return acc; },
        ast.StmtAssign(_) => { return acc; },
        ast.StmtMatch(_) => { return acc; },
        ast.StmtFor(_) => { return acc; },
        ast.StmtBreak(_) => { return acc; },
        ast.StmtContinue(_) => { return acc; },
        ast.StmtUnknown(_) => { return acc; },
        ast.StmtDefer(_) => { return acc; },
    }
}

// var_decl_scan: how many `var name` bindings `stmts` holds, nested blocks and
// defers included, plus 1000 for each of them inside a loop body — or a defer,
// whose replay is as far from its lowering point as a back edge is. Exactly 1
// therefore says "bound once, outside every loop". Every statement kind is
// spelled out: one with a body this walk skipped would hide a binding.
function var_decl_scan(stmts: ast.Stmt[], name: string, in_loop: boolean): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => { if (v.name == name) { n = n + 1; if (in_loop) { n = n + 1000; } } },
            ast.StmtIf(f) => { n = n + var_decl_scan(f.then_body, name, in_loop) + var_decl_scan(f.else_body, name, in_loop); },
            ast.StmtWhile(w) => { n = n + var_decl_scan(w.body, name, true); },
            ast.StmtFor(fo) => { n = n + var_decl_scan(fo.body, name, true); },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) { n = n + var_decl_scan(m.arms[mi].body, name, in_loop); mi = mi + 1; }
            },
            ast.StmtDefer(d) => { n = n + var_decl_scan([d.action], name, true); },
            ast.StmtAssign(_) => {},
            ast.StmtReturn(_) => {},
            ast.StmtExpr(_) => {},
            ast.StmtBreak(_) => {},
            ast.StmtContinue(_) => {},
            ast.StmtUnknown(_) => {},
        }
        i = i + 1;
    }
    return n;
}

// --- map locals borrowed by a tuple element (#7212) --------------------------
//
// `var t: (i32, Map[K, V]) = (i, m)` mentions `m` at a container-element
// position, so both map-reclaim gates refuse it: alias_idents_in_value credits
// the alias and expr_unsafe_for calls the element an escape. Nothing on the
// TUPLE side takes over — tuple construction emits no rc_inc for a map slot, and
// emit_tuple_child_drops skips a bare-ident element, and emit_tuple_type_child_drops
// never sees a Map-typed one — both payload predicates refuse that position outright,
// which is what keeps the ident widening for ARRAY positions (#7281) clear of this
// case. So the map box ends up with no owner at all and leaks every round, where
// native is flat.
//
// Exactly ONE release is owed, and the local is the one that owes it: with no
// retain at construction the tuple holds a BARE pointer, so `m` and `t.1` are one
// box at rc 1. Freeing from both sides would double-release, which is why the
// element side stays untouched here.
//
// The relaxation is sound only while the tuple cannot be read after the map's
// sweep point. Scope exit is after every read of a local tuple, so the "MAP:"
// exit set may take it; the PRECISE drop fires at the map's last TOP-LEVEL use —
// which is the tuple binding itself — so that gate keeps refusing.

// tuple_bare_elem_sole_use: `init` is a tuple literal in which `name` appears
// ONLY as a direct bare-ident element. A tuple mentioning the name anywhere else
// answers false, so the borrow reading below cannot hide a second, genuinely
// escaping use. The sibling of tuple_union_payload_sole_use, one position out.
function tuple_bare_elem_sole_use(init: ast.Expr, name: string): boolean {
    return tuple_bare_elem_positions(init, name).len() > 0;
}

// tuple_bare_elem_positions: the element positions at which the tuple literal
// `init` holds `name` as a direct bare ident — empty when `init` is not a tuple
// or mentions `name` anywhere else. The group's holder rows are one per position.
function tuple_bare_elem_positions(init: ast.Expr, name: string): i32[] {
    var none: i32[] = [];
    match (init) {
        ast.ExprTuple(tl) => {
            var found: i32[] = [];
            var k: i32 = 0;
            while (k < tl.elements.len()) {
                if (ident_name_or_empty(tl.elements[k]) == name) { found = found.append(k); }
                else if (expr_mentions_name(tl.elements[k], name)) { return none; }
                k = k + 1;
            }
            return found;
        },
        _ => { return none; }
    }
    return none;
}

// tuple_elem_host_names collects the LOCAL names bound by
// `var t = ( …, name, … )` — the tuples that hold `name` at a bare-ident element
// and mention it nowhere else. An ASSIGNMENT `t = (…, name, …)` is deliberately
// not collected: its target may be declared in an enclosing scope and so outlive
// the map's sweep, which is the one ordering the relaxation cannot survive.
function tuple_elem_host_names(stmts: ast.Stmt[], name: string, acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (tuple_bare_elem_sole_use(v.init, name)) { a = push_str_unique(a, v.name); } },
            ast.StmtIf(f) => {
                a = tuple_elem_host_names(f.then_body, name, a);
                a = tuple_elem_host_names(f.else_body, name, a);
            },
            ast.StmtWhile(w) => { a = tuple_elem_host_names(w.body, name, a); },
            ast.StmtFor(fo) => { a = tuple_elem_host_names(fo.body, name, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = tuple_elem_host_names(arm.body, name, a); }
            },
            _ => {}
        }
    }
    return a;
}

// used_only_as_tuple_elem answers BOTH reclaim gates at once: every ALIASING and
// every ESCAPING use of `name` in `stmts` is a bare-ident element of a tuple
// bound to one of `hosts`. One walker rather than two because the two questions
// share a skip rule — a host's init mentions `name` only at that element, so
// dropping the whole statement from either scan loses nothing else.
//
// The nested arms mirror stmt_unsafe_for's, and each recurses before it skips:
// the sub-scan covers exactly the positions alias_names_in_stmt would have
// looked at, and the condition / iterator / scrutinee / guard positions it does
// not cover are checked here.
function used_only_as_tuple_elem(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], hosts: string[]): boolean {
    for stmt in stmts {
        var skip: boolean = false;
        match (stmt) {
            ast.StmtVar(v) => {
                if (util.index_of_str(hosts, v.name) >= 0 && tuple_bare_elem_sole_use(v.init, name)) { skip = true; }
            },
            ast.StmtIf(f) => {
                if (!expr_unsafe_for(f.cond, name, borrowable, recv_borrow)
                    && used_only_as_tuple_elem(f.then_body, name, borrowable, recv_borrow, hosts)
                    && used_only_as_tuple_elem(f.else_body, name, borrowable, recv_borrow, hosts)) { skip = true; }
            },
            ast.StmtWhile(w) => {
                if (!expr_unsafe_for(w.cond, name, borrowable, recv_borrow)
                    && used_only_as_tuple_elem(w.body, name, borrowable, recv_borrow, hosts)) { skip = true; }
            },
            ast.StmtFor(fo) => {
                var iter_unsafe: boolean = true;
                match (fo.iter) {
                    ast.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                    _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow); }
                }
                if (!iter_unsafe && used_only_as_tuple_elem(fo.body, name, borrowable, recv_borrow, hosts)) { skip = true; }
            },
            ast.StmtMatch(m) => {
                var mok: boolean = !expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow);
                var k: i32 = 0;
                while (mok && k < m.arms.len()) {
                    if (m.arms[k].has_guard && expr_unsafe_for(m.arms[k].guard, name, borrowable, recv_borrow)) { mok = false; }
                    else if (!used_only_as_tuple_elem(m.arms[k].body, name, borrowable, recv_borrow, hosts)) { mok = false; }
                    k = k + 1;
                }
                if (mok) { skip = true; }
            },
            _ => {}
        }
        if (!skip) {
            if (stmt_unsafe_for(stmt, name, borrowable, recv_borrow)) { return false; }
            var none: string[] = [];
            if (util.index_of_str(alias_names_in_stmt(stmt, none), name) >= 0) { return false; }
        }
    }
    return true;
}

// map_recv_borrows names the map methods that hand back neither the receiver's
// box nor a view of it. A WHITELIST because the complement is the dangerous
// half — `set`/`insert`, `delete`/`without` and `clear`/`cleared` all return the
// receiver's own mapbox and `iter` holds a raw pointer into it — so a map method
// added later refuses until it is classified here, which leaks rather than
// over-releases.
function map_recv_borrows(field: string): boolean {
    return field == "len" || field == "has" || field == "get" || field == "get_or"
        || field == "keys" || field == "values";
}

// tuple_pos_read reports whether `e` is exactly `host.<idx>` — the positional
// read of one tuple element, and nothing wrapping it.
function tuple_pos_read(e: ast.Expr, host: string, idx: i32): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            if (!util.is_all_digits(fa.field)) { return false; }
            if (util.digits_to_i32(fa.field) != idx) { return false; }
            match (fa.obj) {
                ast.ExprIdent(id) => { return id.name == host; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// tuple_pos_esc_expr reports whether `e` reads `host.<idx>` anywhere except as
// the RECEIVER of a borrowing map method. A bare read binds the mapbox to a
// second name that the local's sweep would then free underneath — a
// use-after-free, which is what `return t.1` and `var keep = t.1;` both are.
//
// A LAMBDA needs no arm: any lambda mentioning `host` is already an escape by
// expr_unsafe_for's own lambda arm, so the caller's host gate has refused before
// this walk runs. Hand-written rather than folded over astwalk because a
// capturing lambda in argument position lowers to a `$clo` the per-unit link
// cannot resolve (#7215) — and because the sibling escape walks either side of
// this one are shaped the same way.
function tuple_pos_esc_expr(e: ast.Expr, host: string, idx: i32): boolean {
    if (tuple_pos_read(e, host, idx)) { return true; }
    match (e) {
        ast.ExprFieldAccess(fa) => { return tuple_pos_esc_expr(fa.obj, host, idx); },
        ast.ExprCall(c) => {
            var callee_esc: boolean = true;
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (map_recv_borrows(cfa.field) && tuple_pos_read(cfa.obj, host, idx)) { callee_esc = false; }
                    else { callee_esc = tuple_pos_esc_expr(c.callee, host, idx); }
                },
                _ => { callee_esc = tuple_pos_esc_expr(c.callee, host, idx); }
            }
            if (callee_esc) { return true; }
            for arg in c.args { if (tuple_pos_esc_expr(arg, host, idx)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return tuple_pos_esc_expr(b.left, host, idx) || tuple_pos_esc_expr(b.right, host, idx); },
        ast.ExprUnary(u) => { return tuple_pos_esc_expr(u.operand, host, idx); },
        ast.ExprIndex(ix) => { return tuple_pos_esc_expr(ix.array, host, idx) || tuple_pos_esc_expr(ix.index, host, idx); },
        ast.ExprSlice(sl) => {
            return tuple_pos_esc_expr(sl.array, host, idx) || tuple_pos_esc_expr(sl.start, host, idx)
                || tuple_pos_esc_expr(sl.end, host, idx);
        },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { if (tuple_pos_esc_expr(ar.elements[i], host, idx)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(tl) => {
            var i: i32 = 0;
            while (i < tl.elements.len()) { if (tuple_pos_esc_expr(tl.elements[i], host, idx)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && tuple_pos_esc_expr(sl.base, host, idx)) { return true; }
            for fv in sl.field_values { if (tuple_pos_esc_expr(fv, host, idx)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function tuple_pos_esc_stmt(st: ast.Stmt, host: string, idx: i32): boolean {
    match (st) {
        ast.StmtVar(v) => { return tuple_pos_esc_expr(v.init, host, idx); },
        ast.StmtAssign(a) => { return tuple_pos_esc_expr(a.value, host, idx); },
        ast.StmtReturn(r) => { return tuple_pos_esc_expr(r.value, host, idx); },
        ast.StmtExpr(e) => { return tuple_pos_esc_expr(e.value, host, idx); },
        ast.StmtDefer(d) => { return tuple_pos_esc_stmt(d.action, host, idx); },
        ast.StmtIf(f) => {
            return tuple_pos_esc_expr(f.cond, host, idx)
                || tuple_pos_esc_stmts(f.then_body, host, idx) || tuple_pos_esc_stmts(f.else_body, host, idx);
        },
        ast.StmtWhile(w) => { return tuple_pos_esc_expr(w.cond, host, idx) || tuple_pos_esc_stmts(w.body, host, idx); },
        ast.StmtFor(fo) => { return tuple_pos_esc_expr(fo.iter, host, idx) || tuple_pos_esc_stmts(fo.body, host, idx); },
        ast.StmtMatch(m) => {
            if (tuple_pos_esc_expr(m.scrutinee, host, idx)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && tuple_pos_esc_expr(arm.guard, host, idx)) { return true; }
                if (tuple_pos_esc_stmts(arm.body, host, idx)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function tuple_pos_esc_stmts(stmts: ast.Stmt[], host: string, idx: i32): boolean {
    for stmt in stmts { if (tuple_pos_esc_stmt(stmt, host, idx)) { return true; } }
    return false;
}

// map_tuple_elem_borrow_only is the gate override itself: `name` is aliased and
// escape-flagged ONLY by tuple-element positions, and every tuple holding one is
// a local that neither escapes, nor is rebound, nor lets a map element back OUT
// — so the tuple box dies inside the frame with the map, and no second name
// reaches either.
//
// The host's declared TUPLE TYPE is required, and every NON-SCALAR position of
// it is checked, not just the one this call is about. Keying on
// is_map_type_name instead would miss a map reached through a type parameter or
// an alias, where the tag is not spelled `Map[`; a scalar position carries no
// pointer to extract, so excluding those is the whole relaxation needed to keep
// `t.0` readable.
function map_tuple_elem_borrow_only(body: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], reassigned: string[]): boolean {
    var hosts: string[] = tuple_elem_host_names(body, name, []);
    if (hosts.len() == 0) { return false; }
    var h: i32 = 0;
    while (h < hosts.len()) {
        if (util.index_of_str(reassigned, hosts[h]) >= 0) { return false; }
        if (body_unsafe_for(body, hosts[h], borrowable, recv_borrow)) { return false; }
        var htype: string = rctuple_type_of_decl(body, hosts[h]);
        if (htype == "") { return false; }
        var k: i32 = 0;
        while (k < 64) {
            var tag: string = tuple_type_elem_tag(htype, k);
            if (tag == "") { k = 64; }
            else {
                if (!is_scalar_type_name(tag) && tuple_pos_esc_stmts(body, hosts[h], k)) { return false; }
                k = k + 1;
            }
        }
        h = h + 1;
    }
    return used_only_as_tuple_elem(body, name, borrowable, recv_borrow, hosts);
}

// borrowed_rebind_closure credits the `var X = Y` bare-ident rebinds whose X
// still shares a buffer someone else reaches. Run to a fixpoint so a chain
// `var b = a; var c = b;` reaches c.
//
// X is credited when ANY of these holds:
//
//   - Y is itself borrowed — the transitive case, which covers a non-`own` array
//     PARAM because borrowed_names_of seeds those as members. Y being dead in
//     THIS body proves nothing there, because the other reader is the caller.
//   - Y is used again after the binding — the aliasing case, `var b = a` with a
//     live `a`. `alias_idents_in_value` credits only the source, the name that
//     ACQUIRED an alias, so nothing marked `b` and `b = b.with(…)` wrote
//     through into `a`.
//
// Neither holding means the rebind is the buffer's only remaining name and the
// in-place store is sound — which is what keeps `own heap_in` fast: the caller
// transferred the buffer, and after `var heap = heap_in;` nothing reads
// `heap_in` again, so a const-eval-VM-shaped loop keeps its stores in place.
//
// A rebind inside a nested block is credited unconditionally: the liveness test
// is positional within one statement list and cannot see uses in the enclosing
// tail. Conservative, so it clones rather than mis-stores.
function borrowed_rebind_closure(body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var grew: boolean = true;
    while (grew) {
        var before: i32 = a.len();
        a = borrowed_rebinds(body, a, true);
        grew = a.len() > before;
    }
    return a;
}

function borrowed_rebinds(stmts: ast.Stmt[], acc: string[], top: boolean): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprIdent(id) => {
                        if (!top || util.index_of_str(a, id.name) >= 0
                                || name_used_after(stmts, id.name, i)) {
                            a = push_str_unique(a, v.name);
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(iff) => {
                a = borrowed_rebinds(iff.then_body, a, false);
                a = borrowed_rebinds(iff.else_body, a, false);
            },
            ast.StmtWhile(w) => { a = borrowed_rebinds(w.body, a, false); },
            ast.StmtFor(f) => { a = borrowed_rebinds(f.body, a, false); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = borrowed_rebinds(arm.body, a, false); }
            },
            _ => {},
        }
        i = i + 1;
    }
    return a;
}

// borrowed_names_of is the OWNERSHIP set (#6158/#6170), deliberately SEPARATE
// from the aliasing set above. Only the `.with` self-reassign consults it.
//
// Merging the two looked tempting and is wrong: `aliased_names` also drives the
// `.append` self-reassign's arr_push-vs-arr_push_owned choice, and widening it
// there changed how closure ENV BOXES appended to
// an array are retained — mutable captures then read a stale by-value snapshot
// (#5301), which is a wrong ANSWER, not a leak. Ownership and aliasing are
// different questions; they get different sets.
//
// Three kinds of binding are members, and each is a buffer some OTHER name still
// reaches at the point the in-place store would happen:
//
//   - a non-`own` ARRAY PARAM — the caller holds the buffer and reads it after
//     the call returns, so `.with` on it must produce a value, not a store;
//   - a `var X = OBJ.field` binding whose OBJ is not cleared first;
//   - a `var X = Y` bare-ident rebind that borrowed_rebind_closure credits.
//
// `own` params are excluded: the caller TRANSFERRED the buffer, so the in-place
// store is the point of the annotation.
//
// A `$cell$` param is excluded too, and is the one param that is neither owned
// nor borrowed: it is a mutable capture's shared cell, handed to the lifted body
// as a plain array param (#5301), and writing THROUGH it is the by-reference
// capture semantics. Nothing in ParamDecl distinguishes it from a caller's
// array, so box_rewrite_stmt names it (#6185).
function borrowed_names_of(fn: parser.FuncDecl, own_names: string[]): string[] {
    var a: string[] = borrowed_field_bindings(fn.body, []);
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (is_array_type_name(fn.params[i].type_name)
            && util.index_of_str(own_names, fn.params[i].name) < 0
            && !is_mcap_cell_name(fn.params[i].name)) {
            a = push_str_unique(a, fn.params[i].name);
        }
        i = i + 1;
    }
    return borrowed_rebind_closure(fn.body, a);
}

// is_fresh_struct_init: an init producing a SOLE-OWNER (rc=1) struct value — a
// direct struct literal of a known struct type. (A struct-returning call is a
// move too, but this slice reclaims only directly-constructed structs; an aliased
// or call-bound struct is simply left to leak.)
function is_fresh_struct_init(e: ast.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprStructLit(slit) => { return decl_is_struct(structs, slit.type_name); },
        _ => { return false; },
    }
}

// collect_fresh_struct_names gathers every local bound from a fresh struct
// literal, recursing through nested blocks. Entries are BINDING-SITE keys
// ("name@line:col", #7253 step 1) — two `var s` in sibling blocks are two slots
// under one name, and the struct credit is the one class where letting them
// share a verdict frees a live box rather than merely leaking.
function collect_fresh_struct_names(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_fresh_in_stmt(stmt, structs, a); }
    return a;
}

function collect_fresh_in_stmt(st: ast.Stmt, structs: parser.StructDecl[], acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (is_fresh_struct_init(v.init, structs)) { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_fresh_struct_names(iff.then_body, structs, acc);
            return collect_fresh_struct_names(iff.else_body, structs, a);
        },
        ast.StmtWhile(w) => { return collect_fresh_struct_names(w.body, structs, acc); },
        ast.StmtFor(f) => { return collect_fresh_struct_names(f.body, structs, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_fresh_struct_names(arm.body, structs, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_fresh_in_stmt(d.action, structs, acc); },
        _ => { return acc; },
    }
}

// tuple_lit_is_fresh_scalar reports whether `e` is a NON-EMPTY tuple literal whose
// every element is a flat scalar LITERAL (number / boolean) or a bare IDENT. Such
// a `(3, 4)` / `(i, 1)` builds a fresh, sole-owner tuple box; freeing it is a
// SHALLOW __fern_rc_dec (the box release helper __fern_arr_dec, NOT the deep
// element-walking __fern_arr_dec_ptr), so it never touches the elements — an ident
// that happens to be a pointer (a string / struct / array local) simply stays
// leak-mode, and freeing the box cannot dangle or double-free it (whatever else
// references it is untouched). This makes the ubiquitous un-annotated `(i, 1)` loop
// temporary reclaimable, not just all-literal tuples. Non-ident heap elements
// (field access / call / nested literal) stay excluded — a conservative bound, not
// a safety requirement. The escape gate (body_unsafe_for, in the callers) proves
// the box is a sole owner before any of this fires.
function tuple_lit_is_fresh_scalar(e: ast.Expr): boolean {
    match (e) {
        ast.ExprTuple(tl) => {
            if (tl.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < tl.elements.len()) {
                match (tl.elements[i]) {
                    ast.ExprNumber(_) => {},
                    ast.ExprBool(_) => {},
                    ast.ExprIdent(_) => {},
                    _ => { return false; }
                }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// tuple_str_elem_fresh reports whether a tuple element expression PRODUCES a
// provably fresh string box: a `+` concat with a string-literal (or itself
// fresh-string) operand — concat always allocates a new box whatever its
// operands' ownership — or a 0-arg `.to_string()` call. The tuple box sole-owns
// the result, so the deep-drop's rc-aware __fern_str_free is exactly balanced
// (#4353 item 1, the string sibling of the fresh-array-literal element). A bare
// string IDENT element aliases a live local and is NOT fresh (the caller rejects
// the tuple, leak-safe — same as the array arm's ident exclusion); a plain
// `a + b` ident concat is excluded too (indistinguishable from numeric add
// without type info).
function tuple_str_elem_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprBinary(b) => {
            if (b.op != "+") { return false; }
            var lok: boolean = false;
            match (b.left) {
                ast.ExprString(_) => { lok = true; },
                _ => { lok = tuple_str_elem_fresh(b.left); }
            }
            if (lok) { return true; }
            match (b.right) {
                ast.ExprString(_) => { return true; },
                _ => { return tuple_str_elem_fresh(b.right); }
            }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "to_string" && c.args.len() == 0) { return true; }
                },
                _ => {}
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// tuple_str_elem_fresh_reg widens tuple_str_elem_fresh by the whole-program
// fresh-string registry (#7374): a direct call to a registered producer
// (str_fresh_ret_fns' bare-name entries) hands back a fresh sole-owned box by
// the registry's own fixpoint — the same admission the syntactic form already
// gives `.to_string()`. A separate named predicate so every gate that widens
// says so at its call site (the #7553/OPTSTR lesson); concat operands recurse
// through the widened form, so `w("p") + q` counts too (the registry proves
// the `+` is a string concat, and a concat always allocates).
function tuple_str_elem_fresh_reg(e: ast.Expr, str_fresh_ret: string[]): boolean {
    if (tuple_str_elem_fresh(e)) { return true; }
    match (e) {
        ast.ExprBinary(b) => {
            if (b.op != "+") { return false; }
            if (tuple_str_elem_fresh_reg(b.left, str_fresh_ret)) { return true; }
            return tuple_str_elem_fresh_reg(b.right, str_fresh_ret);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    return util.index_of_str(str_fresh_ret, cid.name) >= 0;
                },
                _ => {}
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// tuple_strarr_elem_fresh reports whether `e` is a non-empty string-ARRAY literal
// whose every element is a provably fresh string box (a literal, or a
// tuple_str_elem_fresh producer). Such a position sole-owns the buffer AND every
// element box, so __fern_str_arr_free releases it exactly; one bare-ident element
// aliases a live local and keeps the position on the shallow buffer-only dec.
function tuple_strarr_elem_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(al) => {
            if (al.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < al.elements.len()) {
                var ok: boolean = false;
                match (al.elements[i]) {
                    ast.ExprString(_) => { ok = true; },
                    _ => { ok = tuple_str_elem_fresh(al.elements[i]); }
                }
                if (!ok) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// tuple_lit_rc_reclaimable reports whether `e` is a tuple literal the DEEP
// loop-rebind reclaim can take. Two independent conditions: every element is one
// emit_tuple_child_drops handles (tuple_lit_elems_admissible), and at least one
// of them is an rc child worth freeing (tuple_lit_has_rc_child). Such a
// `(i, [i, i+1])` / `(i, "x" + s)` / `((i, [i]), j)` builds a fresh sole-owner
// box whose rc children are themselves sole-owned (rc=1, aliased nowhere), so
// the deep reclaim — free each fresh child, then the box — is exactly balanced
// (#4357). A tuple with nothing to free stays on the SHALLOW scalar-tuple path.
function tuple_lit_rc_reclaimable(e: ast.Expr, ttype: string, structs: parser.StructDecl[], str_fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprTuple(tl) => {
            if (tl.elements.len() == 0) { return false; }
            return tuple_lit_elems_admissible(tl, structs) && tuple_lit_has_rc_child(tl, ttype, structs, str_fresh_ret);
        },
        _ => { return false; }
    }
    return false;
}

// tuple_lit_elems_admissible reports whether every element of `tup` is one the
// deep walk can handle — either FREED (array literal, string literal or fresh
// producer, nested tuple literal, reclaim-routing struct literal) or safely
// SKIPPED (scalar, bare ident, any other binary or call: a pointer the walk
// never touches, so a live local's box is never released under it).
//
// "I will not free this element" is not "I cannot free this tuple": only a
// shape emit_tuple_child_drops would MIS-handle disqualifies the tuple. A
// struct-literal element is the one such shape — the emitter emits
// __struct_drop_<T> for it unconditionally, so a type that does not route
// field reclaim has no such helper and must refuse here.
function tuple_lit_elems_admissible(tup: ast.ExprTuple, structs: parser.StructDecl[]): boolean {
    var i: i32 = 0;
    while (i < tup.elements.len()) {
        match (tup.elements[i]) {
            ast.ExprNumber(_) => {},
            ast.ExprBool(_) => {},
            ast.ExprIdent(_) => {},
            ast.ExprString(_) => {},
            ast.ExprBinary(_) => {},
            ast.ExprCall(_) => {},
            ast.ExprArray(_) => {},
            ast.ExprStructLit(slit) => {
                if (!decl_is_struct(structs, slit.type_name)) { return false; }
                if (!struct_has_reclaim_array_field(structs, slit.type_name)) { return false; }
            },
            ast.ExprTuple(inner) => { if (!tuple_lit_elems_admissible(inner, structs)) { return false; } },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// tuple_lit_has_rc_child reports whether a tuple literal carries at least one
// element the deep walk actually frees: an array literal, a fresh string, a
// reclaim-routing struct literal, or a NESTED TUPLE LITERAL.
//
// A nested tuple counts whatever it contains. Its box is an allocation in its
// own right, so `(i, (i, j))` — every leaf a scalar — still has a child to free;
// requiring the INNER to carry an array is what left that shape, and any outer
// tuple holding one, with no reclaim at all. The shallow scalar-tuple path does
// not cover it either: expr_scalar_leaf excludes a tuple element by design.
function tuple_lit_has_rc_child(tup: ast.ExprTuple, ttype: string, structs: parser.StructDecl[], str_fresh_ret: string[]): boolean {
    var i: i32 = 0;
    while (i < tup.elements.len()) {
        match (tup.elements[i]) {
            ast.ExprArray(_) => { return true; },
            ast.ExprTuple(_) => { return true; },
            ast.ExprString(_) => { return true; },
            ast.ExprStructLit(slit) => { if (decl_is_struct(structs, slit.type_name) && struct_has_reclaim_array_field(structs, slit.type_name)) { return true; } },
            ast.ExprBinary(_) => { if (tuple_str_elem_fresh_reg(tup.elements[i], str_fresh_ret)) { return true; } },
            // A CALL at a union-typed position: emit_tuple_child_drops releases
            // the box there, so the tuple has a child worth freeing. The declared
            // TAG is what makes this countable, and it is also what keeps the
            // credit disjoint from the shallow scalar-tuple path — a tuple
            // carrying a union position is never all-scalar, so the two can
            // never both credit the same local and double-free its box.
            ast.ExprCall(_) => {
                if (tuple_str_elem_fresh_reg(tup.elements[i], str_fresh_ret)) { return true; }
                if (tuple_elem_tag_is_union(tuple_type_elem_tag(ttype, i), structs)) { return true; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// tuple_elem_tag_is_union reports whether a tuple element's declared TAG names a
// tagged union — built-in `Option[..]` / `Result[..]`, or a declared enum. An
// empty tag (an un-annotated binding, or a discarded expression statement with
// no declaration at all) answers false, so those sites keep their prior
// admission unchanged.
function tuple_elem_tag_is_union(tag: string, structs: parser.StructDecl[]): boolean {
    if (tag.len() >= 7 && slice_unchecked(tag, 0, 7) == "Option[") { return true; }
    if (tag.len() >= 7 && slice_unchecked(tag, 0, 7) == "Result[") { return true; }
    if (tag == "") { return false; }
    return decl_is_enum(structs, tag);
}

// tuple_type_is_all_scalar reports whether `t` is a tuple TYPE annotation
// `(t0, t1, …)` (≥1 element) whose every element is a primitive scalar (i32 / i64
// / f64 / u32 / u64 / boolean). Such a tuple holds only by-value scalars — no
// pointer that could alias a live local — so its box is a sole-owner and a SHALLOW
// free (there is nothing to walk) is safe even when the elements are VARIABLES
// (`(i, 1)`), not just literals. This lets a fresh, non-escaping annotated scalar
// tuple be reclaimed per loop iteration like the native backend does, instead of
// leaking (the literals-only tuple_lit_is_fresh_scalar was too conservative — it
// left the common `(i, 1)` loop temporary to leak).
function tuple_type_is_all_scalar(t: string): boolean {
    if (t.len() < 3 || slice_unchecked(t, 0, 1) != "(") { return false; }
    var n: i32 = 0;
    var any: boolean = false;
    while (n < 64) {
        var tag: string = tuple_type_elem_tag(t, n);
        if (tag == "") { return any; }
        if (!is_scalar_type_name(tag)) { return false; }
        any = true;
        n = n + 1;
    }
    return any;
}

// tuple_ann_admits_fresh_mixed reports whether the tuple literal `init` is
// admissible to the fresh-scalar-tuple ("TUP:") class under the binding's tuple
// TYPE annotation `t`: a SCALAR-annotated position may hold ANY expression (the
// type proves the element references nothing), and every non-scalar position
// must hold a bare IDENT — the shape whose construction retain the
// element-kinds walk gives back. A non-ident rc element (an array literal, a
// fresh concat, a union-typed call) belongs to the deep "TUPRC:"/"TUPRCS:"
// classes, and admitting it here would put one slot in BOTH classes — the
// double box dec the recorded #7226 negative result measured — so that refusal
// is the class boundary, not conservatism. Annotation and literal must agree
// on length; an un-annotated binding answers false and keeps its prior
// admission.
function tuple_ann_admits_fresh_mixed(t: string, init: ast.Expr): boolean {
    if (t.len() < 3 || slice_unchecked(t, 0, 1) != "(") { return false; }
    match (init) {
        ast.ExprTuple(tl) => {
            if (tl.elements.len() == 0) { return false; }
            var n: i32 = 0;
            while (n < tl.elements.len()) {
                var tag: string = tuple_type_elem_tag(t, n);
                if (tag == "") { return false; }
                if (!is_scalar_type_name(tag)) {
                    var okid: boolean = false;
                    match (tl.elements[n]) { ast.ExprIdent(_) => { okid = true; }, _ => {} }
                    if (!okid) { return false; }
                }
                n = n + 1;
            }
            return tuple_type_elem_tag(t, tl.elements.len()) == "";
        },
        _ => { return false; }
    }
    return false;
}

// collect_fresh_scalar_tuple_names collects the LOCAL names bound from a fresh
// scalar tuple literal (`var t = (3, 4)`), recursing into nested control flow the
// same way collect_fresh_struct_names does. The escape gate (body_unsafe_for) is
// applied by reclaimable_names_of before any is credited, so a returned / stored /
// escaping tuple local is excluded (never freed here — moved to its new owner).
function collect_fresh_scalar_tuple_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_fresh_tuple_in_stmt(stmt, a); }
    return a;
}
function collect_fresh_tuple_in_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            // A fresh tuple local is reclaimable when its literal is all-scalar
            // (tuple_lit_is_fresh_scalar) OR its binding annotation admits it
            // per-position (tuple_ann_admits_fresh_mixed): scalar positions may
            // hold any expression — `(i, 1): (i32, i32)`, and `(i + 1, ys):
            // (i32, i32[])` alike — with bare idents required at rc positions.
            var tfresh: boolean = tuple_lit_is_fresh_scalar(v.init);
            if (!tfresh) { tfresh = tuple_ann_admits_fresh_mixed(v.type_name, v.init); }
            if (tfresh) { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_fresh_scalar_tuple_names(iff.then_body, acc);
            return collect_fresh_scalar_tuple_names(iff.else_body, a);
        },
        ast.StmtWhile(w) => { return collect_fresh_scalar_tuple_names(w.body, acc); },
        ast.StmtFor(f) => { return collect_fresh_scalar_tuple_names(f.body, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_fresh_scalar_tuple_names(arm.body, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_fresh_tuple_in_stmt(d.action, acc); },
        _ => { return acc; },
    }
}

// all_assigns_fresh_scalar_tuple: EVERY assignment to `name` (recursively) builds a
// FRESH scalar tuple — an all-scalar-element literal, or a tuple literal the
// declaration's ANNOTATION `ann` admits per-position (tuple_ann_admits_fresh_mixed,
// which is what admits the ubiquitous `p = (i, i + 1)` whose elements are
// expressions rather than leaves). An assignment carries no type of its own, so
// the declaring slot's annotation is the one place its elements can be judged.
//
// This is the gate on the "TUPREBIND:" credit (#6127). The plain "TUP:" credit is
// already granted to a rebound name — its escape gate never looked at reassignment —
// so the scope-exit sweep frees the FINAL box while every box the rebinds orphaned
// leaks (measured allocs=500 frees=100 live_bytes=16000 over 100 rounds against 0
// on native, where the same tuple bound ONCE is flat at 0). What was missing is a
// release at the assignment, not a credit.
//
// Requiring every assignment to be fresh is what makes releasing the OLD box sound.
// A single `p = q` rebind would leave the slot holding q's box, and the next
// assignment's release would free a box `q` still owns — so one non-fresh
// assignment anywhere disqualifies the name and it keeps its current leak. The
// SARR: discipline: validate each rebind rather than refuse the name for being
// rebound at all.
function all_assigns_fresh_scalar_tuple(stmts: ast.Stmt[], name: string, ann: string): boolean {
    for stmt in stmts {
        if (!stmt_assigns_fresh_scalar_tuple(stmt, name, ann)) { return false; }
    }
    return true;
}

function stmt_assigns_fresh_scalar_tuple(st: ast.Stmt, name: string, ann: string): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target != name) { return true; }
            if (tuple_lit_is_fresh_scalar(a.value)) { return true; }
            return tuple_ann_admits_fresh_mixed(ann, a.value);
        },
        ast.StmtIf(f) => {
            return all_assigns_fresh_scalar_tuple(f.then_body, name, ann)
                && all_assigns_fresh_scalar_tuple(f.else_body, name, ann);
        },
        ast.StmtWhile(w) => { return all_assigns_fresh_scalar_tuple(w.body, name, ann); },
        ast.StmtFor(fo) => { return all_assigns_fresh_scalar_tuple(fo.body, name, ann); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (!all_assigns_fresh_scalar_tuple(arm.body, name, ann)) { return false; }
            }
            return true;
        },
        ast.StmtDefer(d) => { return stmt_assigns_fresh_scalar_tuple(d.action, name, ann); },
        _ => { return true; }
    }
}

// tup_str_writer_owned: the value a writer stores at a STRING position of a
// "TUP:" tuple is one whose box the element release may claim — a counted owned
// string, never a VIEW and never a borrowed alias. Either directly fresh
// (strarr_value_is_fresh: a literal, a concat, a string-method producer, a
// whole-program fresh-ret call), or a bare ident whose SOLE binding in the body
// is one of those and which is never reassigned.
//
// A view is the shape that must not pass: its box is released by its own
// __fern_str_view_free, so a __fern_str_free from the tuple would claim it a
// second time. Views are refused rather than detected — this pass runs before
// lowering, so it has no slot facts (is_str_view_local_slot) to ask, and the
// positive proof is the one that survives that.
function tup_str_writer_owned(e: ast.Expr, body: ast.Stmt[], str_fresh: string[], reassigned: string[]): boolean {
    if (strarr_value_is_fresh(e, str_fresh)) { return true; }
    if let ast.ExprIdent(sid) = e {
        if (util.index_of_str(reassigned, sid.name) >= 0) { return false; }
        if (grow_count_in(body_var_decl_names(body), sid.name) != 1) { return false; }
        return strarr_value_is_fresh(cap_local_init(body, sid.name), str_fresh);
    }
    return false;
}

// assigns_str_pos_owned: EVERY assign-form rebind of `name` stores an owned
// counted string (tup_str_writer_owned) at each STRING position of the
// declaration's tuple annotation `ann` — the WRITER AGREEMENT the "TUPSTRW:"
// credit carries (#7226).
//
// The element-kinds string is recorded ONCE, from the var site's literal, and
// replayed by every site that frees the box: the rebind store, the scope-exit
// sweep, the precise drop. Those sites therefore replay it against a box some
// OTHER writer filled, so an 's' position is sound only when the writers agree
// about what lives there. The array limb needs no such agreement — an array
// element's release is one type-fixed rc_dec whichever writer stored it.
//
// A name with no assignment agrees vacuously, so a tuple that is never rebound
// keeps exactly the kinds it had. An assignment whose value is not a tuple
// literal disagrees: it leaves the slot holding a box this pass cannot describe.
function assigns_str_pos_owned(stmts: ast.Stmt[], name: string, ann: string, body: ast.Stmt[], str_fresh: string[], reassigned: string[]): boolean {
    for stmt in stmts {
        if (!stmt_assigns_str_pos_owned(stmt, name, ann, body, str_fresh, reassigned)) { return false; }
    }
    return true;
}

function stmt_assigns_str_pos_owned(st: ast.Stmt, name: string, ann: string, body: ast.Stmt[], str_fresh: string[], reassigned: string[]): boolean {
    if let ast.StmtAssign(a) = st {
        if (a.target != name) { return true; }
        if let ast.ExprTuple(tl) = a.value {
            var n: i32 = 0;
            while (n < tl.elements.len()) {
                var tag: string = tuple_type_elem_tag(ann, n);
                if (tag == "string" || tag == "str") {
                    if (!tup_str_writer_owned(tl.elements[n], body, str_fresh, reassigned)) { return false; }
                }
                n = n + 1;
            }
            return true;
        }
        return false;
    }
    if let ast.StmtIf(f) = st {
        return assigns_str_pos_owned(f.then_body, name, ann, body, str_fresh, reassigned)
            && assigns_str_pos_owned(f.else_body, name, ann, body, str_fresh, reassigned);
    }
    if let ast.StmtWhile(w) = st { return assigns_str_pos_owned(w.body, name, ann, body, str_fresh, reassigned); }
    if let ast.StmtFor(fo) = st { return assigns_str_pos_owned(fo.body, name, ann, body, str_fresh, reassigned); }
    if let ast.StmtMatch(m) = st {
        for arm in m.arms {
            if (!assigns_str_pos_owned(arm.body, name, ann, body, str_fresh, reassigned)) { return false; }
        }
        return true;
    }
    if let ast.StmtDefer(d) = st { return stmt_assigns_str_pos_owned(d.action, name, ann, body, str_fresh, reassigned); }
    return true;
}

// collect_fresh_rc_tuple_names gathers LOCAL names bound from a fresh tuple literal
// carrying a fresh ARRAY-literal element (`var t = (i, [i, i+1])`,
// tuple_lit_rc_reclaimable) — the rc sibling of collect_fresh_scalar_tuple_names.
// Credited under a "TUPRC:" prefix (slot_is_reclaimable_rctuple) so the DEEP
// loop-rebind reclaim (emit_tuple_deep_reinit_store: arr_dec each fresh array
// element, then the box) fires, instead of the scalar-tuple shallow box dec that
// leaks the array element. The escape gate (body_unsafe_for) is applied by
// reclaimable_names_of before crediting, so an escaping tuple is never freed.
function collect_fresh_rc_tuple_names(stmts: ast.Stmt[], structs: parser.StructDecl[], str_fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_fresh_rc_tuple_in_stmt(stmt, structs, str_fresh_ret, a); }
    return a;
}
function collect_fresh_rc_tuple_in_stmt(st: ast.Stmt, structs: parser.StructDecl[], str_fresh_ret: string[], acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (tuple_lit_rc_reclaimable(v.init, v.type_name, structs, str_fresh_ret)) { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_fresh_rc_tuple_names(iff.then_body, structs, str_fresh_ret, acc);
            return collect_fresh_rc_tuple_names(iff.else_body, structs, str_fresh_ret, a);
        },
        ast.StmtWhile(w) => { return collect_fresh_rc_tuple_names(w.body, structs, str_fresh_ret, acc); },
        ast.StmtFor(f) => { return collect_fresh_rc_tuple_names(f.body, structs, str_fresh_ret, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_fresh_rc_tuple_names(arm.body, structs, str_fresh_ret, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_fresh_rc_tuple_in_stmt(d.action, structs, str_fresh_ret, acc); },
        _ => { return acc; },
    }
}

// collect_sweepable_rc_tuple_names gathers the rc-tuple locals whose FINAL value the
// scope-exit sweep may deep-free — the "TUPRCS:" candidates (#6127).
//
// "TUPRC:" is credited by collect_fresh_rc_tuple_names but consumed in only two
// places: emit_tuple_deep_reinit_store on the StmtVar path, and the entry-zeroing
// list. Nothing frees the local's LAST value, so a single-bind `var t: (i32, i32[]) =
// (i, [i, i+1])` leaked its buffer AND its box on every round — allocs=200 frees=0
// live_bytes=8000 over 100 rounds against 0 on native, with no reassignment anywhere.
//
// The sweep has no init literal to consult, so it must free by TYPE
// (emit_tuple_type_child_drops), and that helper dec's every rc-typed position
// blind. tuple_arg_payload_retained is the gate that makes blind sound, and it is
// why this is a separate, stricter credit rather than a reuse of "TUPRC:".
//
// The question that gate asks is whether the tuple holds a COUNTED REFERENCE to
// every rc position, not whether it sole-owns one. A bare-ident element qualifies:
// lower_expr's ExprTuple arm rc_inc's an element naming an rc-container local, so
// `var t: (i32[], i32[]) = (xs, [i, i+2])` has the tuple as a second owner of `xs`'s
// buffer and the type-driven dec gives exactly that retain back — `xs`'s own sweep
// still spends the local's reference. Refusing the mixed form left it in neither
// class and so released NOTHING, box included: 120 B/round unbounded (#7281).
// OPTTUP and the array-of-tuples element keep the strict tuple_arg_payload_fresh,
// where the payload is freed without its own box in the same breath.
//
// Requires the declaration's tuple ANNOTATION: the type is what the sweep frees by,
// and an un-annotated binding gives it nothing to judge positions with.
// all_assigns_fresh_rc_tuple: EVERY assignment to `name` (recursively) rebuilds a
// fresh rc-tuple of the SAME annotated type `ttype` — a tuple literal that is both
// rc-reclaimable and payload-fresh, the two conditions the declaration itself had
// to satisfy to reach collect_sweepable_rc_tuple_names.
//
// This is what lets the "TUPRCS:" sweep credit drop its `reassigned` exclusion
// (#6127). #6251 left that exclusion deliberately, noting the assign path emitted
// no release for this class so the final value's shape could not be judged from
// the declaration alone — a rebound rc-tuple therefore freed NOTHING, not the
// superseded chains and not the last one (measured allocs=1000 frees=0
// live_bytes=32000 over 100 rounds on `(i32, string)` against 0 on native).
// Proving every assignment rebuilds the same shape is exactly what makes the
// declaration's type a sound description of the final value.
//
// Both halves are needed and #6232 is the worked example of why: the assign-site
// release alone still leaks the LAST chain, and this credit alone still leaks
// every superseded one.
function all_assigns_fresh_rc_tuple(stmts: ast.Stmt[], name: string, ttype: string, structs: parser.StructDecl[], str_fresh_ret: string[]): boolean {
    for stmt in stmts {
        if (!stmt_assigns_fresh_rc_tuple(stmt, name, ttype, structs, str_fresh_ret)) { return false; }
    }
    return true;
}

function stmt_assigns_fresh_rc_tuple(st: ast.Stmt, name: string, ttype: string, structs: parser.StructDecl[], str_fresh_ret: string[]): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target != name) { return true; }
            return tuple_lit_rc_reclaimable(a.value, ttype, structs, str_fresh_ret)
                && tuple_arg_payload_retained(ttype, a.value, structs, str_fresh_ret);
        },
        ast.StmtIf(f) => {
            return all_assigns_fresh_rc_tuple(f.then_body, name, ttype, structs, str_fresh_ret)
                && all_assigns_fresh_rc_tuple(f.else_body, name, ttype, structs, str_fresh_ret);
        },
        ast.StmtWhile(w) => { return all_assigns_fresh_rc_tuple(w.body, name, ttype, structs, str_fresh_ret); },
        ast.StmtFor(fo) => { return all_assigns_fresh_rc_tuple(fo.body, name, ttype, structs, str_fresh_ret); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (!all_assigns_fresh_rc_tuple(arm.body, name, ttype, structs, str_fresh_ret)) { return false; }
            }
            return true;
        },
        ast.StmtDefer(d) => { return stmt_assigns_fresh_rc_tuple(d.action, name, ttype, structs, str_fresh_ret); },
        _ => { return true; }
    }
}

function collect_sweepable_rc_tuple_names(stmts: ast.Stmt[], structs: parser.StructDecl[], str_fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_sweepable_rc_tuple_in_stmt(stmt, structs, str_fresh_ret, a); }
    return a;
}
function collect_sweepable_rc_tuple_in_stmt(st: ast.Stmt, structs: parser.StructDecl[], str_fresh_ret: string[], acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (v.type_name.len() < 2 || slice_unchecked(v.type_name, 0, 1) != "(") { return acc; }
            if (!tuple_lit_rc_reclaimable(v.init, v.type_name, structs, str_fresh_ret)) { return acc; }
            if (!tuple_arg_payload_retained(v.type_name, v.init, structs, str_fresh_ret)) { return acc; }
            return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col));
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_sweepable_rc_tuple_names(iff.then_body, structs, str_fresh_ret, acc);
            return collect_sweepable_rc_tuple_names(iff.else_body, structs, str_fresh_ret, a);
        },
        ast.StmtWhile(w) => { return collect_sweepable_rc_tuple_names(w.body, structs, str_fresh_ret, acc); },
        ast.StmtFor(f) => { return collect_sweepable_rc_tuple_names(f.body, structs, str_fresh_ret, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_sweepable_rc_tuple_names(arm.body, structs, str_fresh_ret, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_sweepable_rc_tuple_in_stmt(d.action, structs, str_fresh_ret, acc); },
        _ => { return acc; },
    }
}

// rctuple_type_of_decl returns the declared TUPLE type of a fresh rc-tuple local
// `name` (`var t: (i32, P) = …`), or "" when the binding is un-annotated / not found.
// Used by the rc-tuple escape gate: with the tuple type in hand it can tell a scalar
// element read (`t.0`, safe copy) from a whole POINTER-element extraction (`keep = t.1`,
// an owned array / struct box the deep-drop would free — an escape).
function rctuple_type_of_decl(stmts: ast.Stmt[], name: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name && util.is_tuple_type_name(v.type_name)) { return v.type_name; }
            },
            ast.StmtIf(f) => {
                var t1: string = rctuple_type_of_decl(f.then_body, name);
                if (t1 != "") { return t1; }
                var t2: string = rctuple_type_of_decl(f.else_body, name);
                if (t2 != "") { return t2; }
            },
            ast.StmtWhile(w) => { var t: string = rctuple_type_of_decl(w.body, name); if (t != "") { return t; } },
            ast.StmtFor(fo) => { var t: string = rctuple_type_of_decl(fo.body, name); if (t != "") { return t; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { var t: string = rctuple_type_of_decl(arm.body, name); if (t != "") { return t; } }
            },
            _ => {}
        }
    }
    return "";
}

// rctuple_counted_field_share: `e` is a struct literal that mentions the
// rc-tuple local `name` ONLY as the bare-ident value of a direct tuple field
// that takes the construction retain — the tuple sibling of
// arrstruct_counted_field_share, and it exists for the same reason. The field
// holds a COUNTED share (the ExprStructLit tuple arm inc'd the box), so reading
// the store as an escape sinks the source's whole reclaim and the box is pinned
// at the shared count forever: nobody reaches zero.
//
// Both releases are rc-aware, which is what makes granting this safe rather than
// a double free. The source's is emit_rctuple_deep_free; the holder's is
// emit_struct_tuple_field_drops, whose child walk is __fern_rc_is_unique-gated
// and whose box dec is not. Whichever owner finds rc 1 walks the children; every
// owner decs the box exactly once.
//
// Refused, each for the reason its array sibling refuses it:
//   - a `{ ...base }` update, whose copied fields carry no inc;
//   - a MOVED share (moved_ident_at), where the retain is elided and the box
//     takes over the local's reference — crediting the source there frees a box
//     whose ownership left the frame. `return T { t: src, … }` is that shape.
// The credit therefore asks exactly the question the retain asks.
function rctuple_counted_field_share(e: ast.Expr, name: string, structs: parser.StructDecl[], msites: string[]): boolean {
    match (e) {
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { return false; }
            if (!struct_has_deep_tuple_field(structs, sl.type_name)) { return false; }
            var seen: boolean = false;
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                match (sl.field_values[i]) {
                    ast.ExprIdent(fid) => {
                        if (fid.name == name) {
                            if (!tuple_field_deep_droppable(decl_field_type(structs, sl.type_name, sl.field_names[i]), structs)) { return false; }
                            if (moved_ident_at(sl.field_values[i], msites)) { return false; }
                            seen = true;
                        }
                    },
                    _ => { if (expr_unsafe_for(sl.field_values[i], name, [], [])) { return false; } }
                }
                i = i + 1;
            }
            return seen;
        },
        _ => { return false; }
    }
    return false;
}

// rctuple_counted_store_sites: the line:col of every struct literal in `stmts`
// that takes a counted share of `name`. Keyed by SITE so the escape gate's
// forgiveness covers exactly the literals the retain fired for, the way
// alias_ok keys the #7282 bind forgiveness.
function rctuple_counted_store_sites(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { a = rctuple_counted_store_site_of(v.init, name, structs, msites, a); },
            ast.StmtReturn(r) => { a = rctuple_counted_store_site_of(r.value, name, structs, msites, a); },
            ast.StmtExpr(e) => { a = rctuple_counted_store_site_of(e.value, name, structs, msites, a); },
            ast.StmtAssign(asg) => {
                if (asg.target != name) { a = rctuple_counted_store_site_of(asg.value, name, structs, msites, a); }
            },
            ast.StmtIf(f) => {
                a = rctuple_counted_store_sites(f.then_body, name, structs, msites, a);
                a = rctuple_counted_store_sites(f.else_body, name, structs, msites, a);
            },
            ast.StmtWhile(w) => { a = rctuple_counted_store_sites(w.body, name, structs, msites, a); },
            ast.StmtFor(fo) => { a = rctuple_counted_store_sites(fo.body, name, structs, msites, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = rctuple_counted_store_sites(arm.body, name, structs, msites, a); }
            },
            ast.StmtDefer(d) => { a = rctuple_counted_store_sites([d.action], name, structs, msites, a); },
            _ => {}
        }
    }
    return a;
}
function rctuple_counted_store_site_of(e: ast.Expr, name: string, structs: parser.StructDecl[], msites: string[], acc: string[]): string[] {
    if (!rctuple_counted_field_share(e, name, structs, msites)) { return acc; }
    match (e) {
        ast.ExprStructLit(sl) => { return push_str_unique(acc, util.i32_to_string(sl.line) + ":" + util.i32_to_string(sl.col)); },
        _ => { return acc; }
    }
    return acc;
}

// rctuple_counted_store_at reports whether `e` is a struct literal whose site is
// in the counted-store list.
function rctuple_counted_store_at(e: ast.Expr, counted_ok: string[]): boolean {
    if (counted_ok.len() == 0) { return false; }
    match (e) {
        ast.ExprStructLit(sl) => {
            return util.index_of_str(counted_ok, util.i32_to_string(sl.line) + ":" + util.i32_to_string(sl.col)) >= 0;
        },
        _ => { return false; }
    }
    return false;
}

// rctuple_esc_expr_is_ident reports whether `e` is exactly the bare ident
// `name` — the only field-value spelling the counted-store forgiveness admits.
function rctuple_esc_expr_is_ident(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        _ => { return false; }
    }
    return false;
}

// rctuple_struct_field_counted_store: field `fi` of literal `sl` is a direct
// tuple field whose store the construction arm RETAINS and
// emit_struct_tuple_field_drops releases. struct_has_deep_tuple_field is the
// narrower half of the retain's slit_reclaim gate, so this implies the retain
// fired; the field's own type must be deep-droppable too, or the drop emits no
// arm for it.
function rctuple_struct_field_counted_store(sl: ast.ExprStructLit, fi: i32, name: string, structs: parser.StructDecl[]): boolean {
    if (!struct_has_deep_tuple_field(structs, sl.type_name)) { return false; }
    if (fi < 0 || fi >= sl.field_names.len()) { return false; }
    var di: i32 = decl_field_index(structs, sl.type_name, sl.field_names[fi]);
    if (di < 0) { return false; }
    return tuple_field_deep_droppable(decl_field_type_at(structs, sl.type_name, di), structs);
}

// esc_tuple_field_of: `e` is a field read directly off the bare local `root`
// (`root.<f>`) — returns `<f>`; "" otherwise.
function esc_tuple_field_of(e: ast.Expr, root: string): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            if (ident_name_or_empty(fa.obj) == root) { return fa.field; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// rctuple_esc_shape classifies one node for the rc-tuple escape scan
// (rctuple_esc_expr below has the scan's contract). It is the single source of
// truth BOTH fold closures consult: `descend` walks a node's children exactly
// when it answers 0, and rctuple_esc_at maps every other answer to a verdict
// or a re-scan of the shape's chosen children. The codes, shared by all three
// element-escape scanners (this one, arrtup, arrstruct):
//   0 — generic: no verdict at this node; the spine walks the children.
//   1 — settled false: an opaque node (lambda / map-literal / f-string, which
//       the scan treats as no-use rather than walking into) or a whitelisted
//       borrow with nothing left to check.
//   2 — escape.
//   3 — borrow chain: the access chain itself is safe; every index expression
//       along it and every call argument still needs its own scan (the
//       family's chain_esc).
//   4 — free-function call with per-argument borrow forgiveness.
//   5 — a sanctioned counted store: forgiven slots are skipped, the rest scanned.
function rctuple_esc_shape(e: ast.Expr, name: string, ttype: string, structs: parser.StructDecl[]): i32 {
    match (e) {
        ast.ExprIdent(id) => { if (id.name == name) { return 2; } return 1; },   // bare whole tuple escapes
        ast.ExprNumber(_) => { return 1; },
        ast.ExprString(_) => { return 1; },
        ast.ExprBool(_) => { return 1; },
        ast.ExprFieldAccess(fa) => {
            var tf: string = esc_tuple_field_of(e, name);
            if (tf.len() > 0) {
                // name.<i> : a pointer element extracted bare escapes; a scalar
                // element (or a non-positional field) is a by-value copy.
                if (util.is_all_digits(tf)
                    && !is_scalar_type_name(tuple_type_elem_tag(ttype, util.digits_to_i32(tf)))) { return 2; }
                return 1;
            }
            var pf: string = esc_tuple_field_of(fa.obj, name);
            if (pf.len() > 0 && util.is_all_digits(pf)) {
                // name.<i>.<f> : a struct-element field read.
                var ety: string = tuple_type_elem_tag(ttype, util.digits_to_i32(pf));
                // A NESTED TUPLE element indexes BY POSITION, not by struct
                // field name: `t.2.0` copies a scalar out of t's tuple element,
                // a borrow exactly like the struct scalar-field read below.
                // decl_field_type finds no struct for a `(..)` tag and the ""
                // it returns is not scalar, so such a read counted as a bare
                // pointer extraction and cost the whole tuple its reclaim.
                if (util.is_tuple_type_name(ety) && util.is_all_digits(fa.field)) {
                    if (is_scalar_type_name(tuple_type_elem_tag(ety, util.digits_to_i32(fa.field)))) { return 1; }
                    return 2;
                }
                if (is_scalar_type_name(decl_field_type(structs, ety, fa.field))) { return 1; }   // scalar struct-field copy
                return 2;   // struct array/pointer field extracted bare
            }
            return 0;
        },
        ast.ExprIndex(ix) => {
            if (ident_name_or_empty(ix.array) == name) { return 2; }   // bare name[..]
            var bf: string = esc_tuple_field_of(ix.array, name);
            if (bf.len() > 0 && util.is_all_digits(bf)) { return 3; }   // name.<i>[j] : indexed array-element read
            match (ix.array) {
                ast.ExprFieldAccess(bfa) => {
                    var pbf: string = esc_tuple_field_of(bfa.obj, name);
                    if (pbf.len() > 0 && util.is_all_digits(pbf)) { return 3; }   // name.<i>.<f>[j] : indexed struct array-field read
                    return 0;
                },
                _ => { return 0; }
            }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(_) => { return 4; },
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        var rf: string = esc_tuple_field_of(cfa.obj, name);
                        if (rf.len() > 0 && util.is_all_digits(rf)) { return 3; }   // name.<i>.len() : array-element length borrow
                        match (cfa.obj) {
                            ast.ExprFieldAccess(ofa) => {
                                var orf: string = esc_tuple_field_of(ofa.obj, name);
                                if (orf.len() > 0 && util.is_all_digits(orf)) { return 3; }   // name.<i>.<f>.len() : struct array-field length borrow
                            },
                            _ => {}
                        }
                    }
                    return 0;
                },
                _ => { return 0; }
            }
        },
        ast.ExprBinary(_) => { return 0; },
        ast.ExprUnary(_) => { return 0; },
        ast.ExprSlice(_) => { return 0; },
        ast.ExprArray(_) => { return 0; },
        ast.ExprTuple(_) => { return 0; },
        ast.ExprStructLit(sl) => {
            var sfi: i32 = 0;
            for fv in sl.field_values {
                if (rctuple_struct_field_counted_store(sl, sfi, name, structs)
                    && rctuple_esc_expr_is_ident(fv, name)) { return 5; }
                sfi = sfi + 1;
            }
            return 0;
        },
        ast.ExprLambda(_) => { return 1; },
        ast.ExprMapLit(_) => { return 1; },
        ast.ExprFString(_) => { return 1; },
        ast.ExprUnknown(_) => { return 1; }
    }
    return 0;
}

// rctuple_chain_esc re-scans the parts of a code-3 borrow chain the shape did
// not settle: every index expression along it and every call argument. The
// chain links themselves (field reads, the indexed reads' arrays, a `.len()`
// callee) were classified safe as one shape, and the root ident is the
// borrowed local; a link the classifier did not admit errs toward escape.
function rctuple_chain_esc(x: ast.Expr, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    match (x) {
        ast.ExprCall(c) => {
            if (rctuple_chain_esc(c.callee, name, ttype, structs, borrowable)) { return true; }
            for arg in c.args { if (rctuple_esc_expr(arg, name, ttype, structs, borrowable)) { return true; } }
            return false;
        },
        ast.ExprFieldAccess(fa) => { return rctuple_chain_esc(fa.obj, name, ttype, structs, borrowable); },
        ast.ExprIndex(ix) => {
            if (rctuple_chain_esc(ix.array, name, ttype, structs, borrowable)) { return true; }
            return rctuple_esc_expr(ix.index, name, ttype, structs, borrowable);
        },
        ast.ExprIdent(_) => { return false; },
        _ => { return true; }
    }
    return false;
}

// rctuple_esc_at is the fold visitor: `esc` latches true, and each node
// answers per its rctuple_esc_shape code.
function rctuple_esc_at(x: ast.Expr, esc: boolean, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    if (esc) { return true; }
    var code: i32 = rctuple_esc_shape(x, name, ttype, structs);
    if (code == 2) { return true; }
    if (code == 3) { return rctuple_chain_esc(x, name, ttype, structs, borrowable); }
    if (code == 4) {
        match (x) {
            ast.ExprCall(c) => {
                var callee: string = ident_name_or_empty(c.callee);
                if (callee == name) { return true; }
                // A DIRECT bare-ident `name` at a PAYLOAD-borrowable param
                // position of a known free function is a BORROW, not a payload
                // escape. The key is the "TUPB:" tier, NOT the plain box flag:
                // box borrowability only proves the callee never keeps the box,
                // and a callee returning src.1 keys box-borrowable while this
                // scan's deep reclaim would free the handed-out element under it
                // (sanitizer-confirmed UAF). TUPB additionally proves no payload
                // of the param escapes the callee — the question a TUPRCS deep
                // free actually asks. Without any forgiveness, `round(keep, i)`
                // with a purely-reading callee cost the caller's rc-tuple its
                // whole deep reclaim.
                //
                // "CNT:" is the second admission: the callee does not merely
                // borrow, it stores the tuple into a struct literal that RETAINS
                // it, so the caller's deep free and the holder's field drop net
                // to one owner. The shared key ORs every counted tier, but only
                // "TCNT:" can have flagged a position whose param type is a
                // tuple — the array, string, enum and array-of-boxes tiers each
                // test a type this argument does not have — so reading the
                // merged flag cannot borrow another tier's verdict.
                var rai: i32 = 0;
                while (rai < c.args.len()) {
                    var rarg_borrow: boolean = ident_name_or_empty(c.args[rai]) == name
                        && (param_is_borrowable(borrowable, "TUPB:" + callee, rai)
                            || param_is_borrowable(borrowable, "CNT:" + callee, rai));
                    if (!rarg_borrow && rctuple_esc_expr(c.args[rai], name, ttype, structs, borrowable)) { return true; }
                    rai = rai + 1;
                }
                return false;
            },
            _ => { return true; }
        }
    }
    if (code == 5) {
        match (x) {
            ast.ExprStructLit(sl) => {
                if (sl.has_base && rctuple_esc_expr(sl.base, name, ttype, structs, borrowable)) { return true; }
                var sfi: i32 = 0;
                for fv in sl.field_values {
                    // `S { t: name, ... }` into a deep-droppable tuple field of a
                    // type that routes tuple field reclaim is a COUNTED store, not
                    // an escape: the construction arm inc'd the box and
                    // emit_struct_tuple_field_drops decs it once per owner, so the
                    // source keeps its own release (rc 1 -> inc 2 -> this sweep 1 ->
                    // the struct's field drop 0). Forgiven on the same predicate
                    // that gates the retain, so the two cannot come apart (#7253) —
                    // and on the narrower half of it, so a forgiven store is always
                    // one the retain actually fired for.
                    if (!(rctuple_struct_field_counted_store(sl, sfi, name, structs)
                            && rctuple_esc_expr_is_ident(fv, name))) {
                        if (rctuple_esc_expr(fv, name, ttype, structs, borrowable)) { return true; }
                    }
                    sfi = sfi + 1;
                }
                return false;
            },
            _ => { return true; }
        }
    }
    return false;
}

// rctuple_esc_expr: does `e` use the fresh rc-tuple local `name` (declared tuple type
// `ttype`) in a way that ESCAPES an owned pointer the whole-tuple deep-drop would free?
// The tuple carries at least one owned pointer element (an array / a reclaim-struct box);
// the deep-drop frees those, so a WHOLE element extracted bare would then be over-released.
// Borrows (safe): a scalar element read `name.<i>` (by-value copy); an indexed array-element
// read `name.<i>[j]`; a struct-element scalar-field read `name.<i>.<f>`; an indexed struct
// array-field read `name.<i>.<f>[j]`; and the `.len()` of either. ESCAPES (true): a bare
// `name`; a bare POINTER element `name.<i>` (array / struct box); a bare struct array-field
// `name.<i>.<f>`. Erring toward escape is a safe leak, never an over-release. Mirrors
// arrtup_elem_esc_expr, rooted at a bare-local tuple (`name.<i>`) instead of `name[k].<i>`.
function rctuple_esc_expr(e: ast.Expr, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    function visit(x: ast.Expr, esc: boolean): boolean { return rctuple_esc_at(x, esc, name, ttype, structs, borrowable); }
    function descend(x: ast.Expr): boolean { return rctuple_esc_shape(x, name, ttype, structs) == 0; }
    return astwalk.fold_expr_pruned(e, false, visit, descend);
}
// rctuple_scrutinee_is_elem_read reports whether `e` is exactly `name.<i>` — a
// positional read of one element of the candidate tuple local, and nothing more.
// Anything wrapping it (a call, an index, the bare local) is not this shape.
function rctuple_scrutinee_is_elem_read(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            if (!util.is_all_digits(fa.field)) { return false; }
            match (fa.obj) {
                ast.ExprIdent(id) => { return id.name == name; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// tuple_elem_ret_dup: THE dup-at-extract admission — `e` is exactly
// `name.<i>` and element <i> of `ttype` is an rc ARRAY. This one predicate
// has two entry points and no near-copy (the 08-22 struct-producer rule):
// the return lowering's ret_is_tuple_elem_dup gates the retain for
// exactly this shape, and the rc-tuple escape scans forgive exactly this
// shape — so "the escape stops being an escape" is true by construction,
// never by two conditions happening to line up. String / struct / nested
// tuple elements are refused here ON BOTH SIDES (their retain protocol is
// a separate port), which keeps unretained shapes refused.
pub function tuple_elem_ret_dup(e: ast.Expr, name: string, ttype: string): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            if (!util.is_all_digits(fa.field)) { return false; }
            match (fa.obj) {
                ast.ExprIdent(id) => {
                    if (id.name != name) { return false; }
                    return is_array_type_name(tuple_type_elem_tag(ttype, util.digits_to_i32(fa.field)));
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// rctuple_esc_stmt_alias carries the #7282 alias forgiveness THROUGH the
// recursion, which is the whole point: a first version checked the forgiven
// bind only at the top level of the statement list and fell into the plain
// walker for anything nested, so a block-scoped `{ var v = t; }` still denied
// the credit. The function-scope sibling measured clean while the block-scoped
// one sat at exactly its unfixed number — two dec sites missing from the emitted
// asm, and nothing else to see.
function rctuple_esc_stmt_alias(st: ast.Stmt, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[], alias_ok: string[], elem_ok: string[], ret_dup_ok: boolean): boolean {
    match (st) {
        ast.StmtVar(v) => {
            if (alias_ok.len() > 0) {
                match (v.init) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == name
                            && util.index_of_str(alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0) { return false; }
                    },
                    _ => {}
                }
            }
            // A vetted ELEMENT bind is not an escape (#7766): the target is a
            // local the frame keeps, so it is dead by the exit sweep and the deep
            // free releases memory nothing reads again. tuple_elem_bind_sites_of
            // admits only targets that are neither reassigned nor escaping, so
            // `return name.1` and a stored element still land below.
            if (elem_ok.len() > 0
                && util.index_of_str(elem_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0) { return false; }
            return rctuple_esc_expr(v.init, name, ttype, structs, borrowable);
        },
        ast.StmtReturn(r) => {
            if (ret_dup_ok && tuple_elem_ret_dup(r.value, name, ttype)) { return false; }
            return rctuple_esc_expr(r.value, name, ttype, structs, borrowable);
        },
        ast.StmtExpr(e) => { return rctuple_esc_expr(e.value, name, ttype, structs, borrowable); },
        ast.StmtAssign(a) => { return rctuple_esc_expr(a.value, name, ttype, structs, borrowable); },
        ast.StmtIf(f) => {
            if (rctuple_esc_expr(f.cond, name, ttype, structs, borrowable)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (rctuple_esc_stmt_alias(f.then_body[ti], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (rctuple_esc_stmt_alias(f.else_body[ei], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (rctuple_esc_expr(w.cond, name, ttype, structs, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (rctuple_esc_stmt_alias(w.body[i], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (rctuple_esc_expr(fo.iter, name, ttype, structs, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (rctuple_esc_stmt_alias(fo.body[i], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            // A scrutinee that is EXACTLY `name.<i>` reads that element's tag and
            // copies its payload into the arm binding; it stores the box nowhere,
            // so it is a BORROW rather than the bare pointer extraction
            // rctuple_esc_expr sees in a non-scalar element read. The reclaim
            // frees the tuple's own children and its box but never a union
            // element's PAYLOAD, so a binding taken from one stays valid.
            //
            // Only that exact shape. `match (t)` on the whole tuple, or an
            // element handed through a call, still walks as an escape — those
            // hand the pointer somewhere the reclaim cannot see.
            if (!rctuple_scrutinee_is_elem_read(m.scrutinee, name)
                    && rctuple_esc_expr(m.scrutinee, name, ttype, structs, borrowable)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && rctuple_esc_expr(arm.guard, name, ttype, structs, borrowable)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (rctuple_esc_stmt_alias(arm.body[bi], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return rctuple_esc_stmt_alias(d.action, name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok); },
        _ => { return false; }
    }
    return false;
}
// rctuple_payload_escapes_alias is the same scan with the #7282 forgiveness: a
// plain `var v = name` bind listed in `alias_ok` is not a payload escape,
// because the bind retained the box and the alias carries the source's own
// credit, so both slots release it.
//
// A CLASS CONSULTS MORE THAN ONE ESCAPE SCAN, and every one of them has to be
// told. body_unsafe_for is the shared gate; this is the rc-tuple class's second,
// and forgiving only the first left "TUPRC:" denied and the shape measuring
// exactly its unfixed 8000 while the scalar-tuple sibling went to 0. Enumerate
// the scans a class consults, not just the shared one.
function rctuple_payload_escapes_alias(stmts: ast.Stmt[], name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[], alias_ok: string[], elem_ok: string[], ret_dup_ok: boolean): boolean {
    for stmt in stmts {
        if (rctuple_esc_stmt_alias(stmt, name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; }
    }
    return false;
}

// rctuple_payload_escapes_alias_ret_ok: the same scan with the owned-return
// admission's one exemption — a bare top-level `return <name>` of the WHOLE
// tuple is the move-out, not a payload escape. An ELEMENT return, `return
// name.1`, hands the element's reference to a new owner; under ret_dup_ok it
// is forgiven exactly when the return lowering RETAINS that hand-off
// (tuple_elem_ret_dup — one predicate, two entry points), and stays refused
// otherwise.
// This is the rc-tuple class's second escape scan being told what the shared
// gate (body_unsafe_for_alias_ret_ok) already learned — the trap the comment
// above names. Compound statements recurse HERE so a nested return in an
// if-arm is forgiven too.
function rctuple_payload_escapes_alias_ret_ok(stmts: ast.Stmt[], name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[], alias_ok: string[], elem_ok: string[], bare_ret_ok: boolean, ret_dup_ok: boolean): boolean {
    if (!bare_ret_ok) { return rctuple_payload_escapes_alias(stmts, name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok); }
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var bare: boolean = false;
                match (r.value) {
                    ast.ExprIdent(rid) => { bare = rid.name == name; },
                    _ => {}
                }
                if (!bare && !(ret_dup_ok && tuple_elem_ret_dup(r.value, name, ttype))
                    && rctuple_esc_expr(r.value, name, ttype, structs, borrowable)) { return true; }
            },
            ast.StmtIf(f) => {
                if (rctuple_esc_expr(f.cond, name, ttype, structs, borrowable)) { return true; }
                if (rctuple_payload_escapes_alias_ret_ok(f.then_body, name, ttype, structs, borrowable, alias_ok, elem_ok, true, ret_dup_ok)) { return true; }
                if (rctuple_payload_escapes_alias_ret_ok(f.else_body, name, ttype, structs, borrowable, alias_ok, elem_ok, true, ret_dup_ok)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (rctuple_esc_expr(w.cond, name, ttype, structs, borrowable)) { return true; }
                if (rctuple_payload_escapes_alias_ret_ok(w.body, name, ttype, structs, borrowable, alias_ok, elem_ok, true, ret_dup_ok)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (rctuple_esc_expr(fo.iter, name, ttype, structs, borrowable)) { return true; }
                if (rctuple_payload_escapes_alias_ret_ok(fo.body, name, ttype, structs, borrowable, alias_ok, elem_ok, true, ret_dup_ok)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (rctuple_esc_expr(m.scrutinee, name, ttype, structs, borrowable)) { return true; }
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (rctuple_payload_escapes_alias_ret_ok(m.arms[mi].body, name, ttype, structs, borrowable, alias_ok, elem_ok, true, ret_dup_ok)) { return true; }
                    mi = mi + 1;
                }
            },
            _ => { if (rctuple_esc_stmt_alias(stmt, name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) { return true; } }
        }
    }
    return false;
}

// collect_fresh_rcenum_names gathers LOCAL names bound from a FRESH rc-payload
// enum variant ctor (`var b = Full([i, i+1])`, fresh_rcpayload_enum_init) that is
// SINGLE-OWNER and either consumed by exactly one `match (b)` IN THE SAME BLOCK —
// dead after, with no arm moving out an rc payload — or consumed by no match at
// all, in which case non-escape is the whole condition — the per-block, recursive
// analogue of
// consumed_rcpayload_enum_frees (which scans only the TOP-LEVEL fn body and so
// never covers a LOOP-LOCAL; the loop-local enum was reclaimed nowhere and leaked
// per iteration, #4357). Credited "RCENUM:" for the DEEP loop-rebind reclaim
// (emit_enum_deep_reinit_store → emit_enum_variant_drops on the prior box). The
// escape gate here is name_escapes_outside_stmt with the MATCH statement skipped —
// so the match scrutinee `b` (the consuming read) is NOT counted as an escape,
// unlike the coarse body_unsafe_for which flags any bare-ident use.
// all_assigns_fresh_rcenum reports whether EVERY assignment to `name` anywhere in
// `stmts` (recursively) constructs a FRESH rc-payload enum of the SAME enum
// `owner` — either an inline variant ctor or a call to a whole-program-proven
// fresh rc-enum ctor fn.
//
// This is what lets collect_fresh_rcenum_names drop its blunt `reassigned`
// exclusion (#6127), the rc-payload sibling of the scalar-enum rebind. A rebound
// local orphans its previous chain on every assignment, and refusing the
// candidate outright meant NOTHING was freed — not the intermediates, not the
// final value (measured allocs=900 frees=0 over 100 rounds where the same enum
// re-DECLARED in the loop body is flat at 0, because only the StmtVar path
// reaches emit_enum_deep_reinit_store).
//
// Requiring the same `owner` is what keeps the deep drop well-typed: the release
// dispatches on the slot's enum type, so a rebind to a different enum would walk
// the wrong variant table. The caller's escape gate is unchanged, so a value
// aliased out before being overwritten still disqualifies the name — for a
// DEEP drop that matters more than it did for the scalar box, since the payload
// is released too.
function all_assigns_fresh_rcenum(stmts: ast.Stmt[], name: string, owner: string, structs: parser.StructDecl[], opt_fresh_ret: SigReg, str_fresh: string[]): boolean {
    for stmt in stmts {
        if (!stmt_assigns_fresh_rcenum(stmt, name, owner, structs, opt_fresh_ret, str_fresh)) { return false; }
    }
    return true;
}

function stmt_assigns_fresh_rcenum(st: ast.Stmt, name: string, owner: string, structs: parser.StructDecl[], opt_fresh_ret: SigReg, str_fresh: string[]): boolean {
    match (st) {
        ast.StmtAssign(asn) => {
            if (asn.target != name) { return true; }
            var o: string = fresh_rcpayload_enum_init(asn.value, structs, str_fresh, [], false);
            if (o == "") { o = rcenum_call_init_owner(asn.value, opt_fresh_ret); }
            return o != "" && o == owner;
        },
        ast.StmtIf(iff) => {
            return all_assigns_fresh_rcenum(iff.then_body, name, owner, structs, opt_fresh_ret, str_fresh)
                && all_assigns_fresh_rcenum(iff.else_body, name, owner, structs, opt_fresh_ret, str_fresh);
        },
        ast.StmtWhile(w) => { return all_assigns_fresh_rcenum(w.body, name, owner, structs, opt_fresh_ret, str_fresh); },
        ast.StmtFor(f) => { return all_assigns_fresh_rcenum(f.body, name, owner, structs, opt_fresh_ret, str_fresh); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (!all_assigns_fresh_rcenum(arm.body, name, owner, structs, opt_fresh_ret, str_fresh)) { return false; }
            }
            return true;
        },
        ast.StmtDefer(d) => { return stmt_assigns_fresh_rcenum(d.action, name, owner, structs, opt_fresh_ret, str_fresh); },
        _ => { return true; }
    }
}

// collect_fresh_scenum_names: all-scalar ENUM locals with NO consuming match in
// their block — the scalar sibling of collect_fresh_rcenum_names' "S:" half
// (#6606). consumed_scalar_enum_frees only ever covers a name its own statement
// list also MATCHES, so `while (i < k) { var m: M = A(i); … }` on an enum whose
// every payload is scalar was reclaimed nowhere and leaked its 40-byte box per
// iteration where native is flat.
//
// The release is a SHALLOW dec: every payload is a scalar, so there is nothing
// under the box to walk and nothing to dangle. That makes this the easiest
// member of the family to admit — the rc half needs a runtime variant dispatch
// to know what to deep-drop, and this one needs none.
//
// Gates: a fresh sole-owner construction (fresh_scalar_enum_init), no consuming
// match in the block (a matched name is consumed_scalar_enum_frees' candidate,
// and crediting it here would be a second claim on a released box), a rebind
// that always rebuilds a fresh all-scalar enum, and body_unsafe_for to prove the
// name never escapes.
function collect_fresh_scenum_names(stmts: ast.Stmt[], structs: parser.StructDecl[], borrowable: string[], plan_on: boolean, plan_fe: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                var owner: string = fresh_scalar_enum_init(v.init, structs);
                var rebind_ok: boolean = util.index_of_str(reassigned, v.name) < 0
                    || all_assigns_fresh_scalar_enum(stmts, v.name, structs);
                // The escape gate is the routed half (promotion step 2): the
                // plan's free_eligible_sites_of verdict replaces body_unsafe_for.
                // The other three conjuncts stay family knowledge the
                // name-level plan cannot supply: the fresh-ctor init
                // identifies the kind, the rebind check keeps a non-fresh
                // reassign out, and the no-consuming-match check keeps this
                // credit disjoint from consumed_scalar_enum_frees' release.
                // The plan is deliberately no stricter than native here: like
                // native's computeFreeEligible, it does not taint a plain
                // call arg — a callee that KEEPS its arg retains it through
                // its own counted construction stores, so the caller's sweep
                // stays balanced (leak-at-worst on the shapes native also
                // leaks; the enum_scalar__callarg matrix cells pin all
                // three).
                var esc_ok: boolean = false;
                if (plan_on) { esc_ok = util.index_of_str(plan_fe, reclaim_site_key_of(v.name, v.line, v.col)) >= 0; }
                else { esc_ok = !body_unsafe_for(stmts, v.name, borrowable, []); }
                if (owner != "" && rebind_ok && sole_top_level_match_idx(stmts, v.name) < 0 && esc_ok) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(iff) => { a = collect_fresh_scenum_names(iff.then_body, structs, borrowable, plan_on, plan_fe, a); a = collect_fresh_scenum_names(iff.else_body, structs, borrowable, plan_on, plan_fe, a); },
            ast.StmtWhile(w) => { a = collect_fresh_scenum_names(w.body, structs, borrowable, plan_on, plan_fe, a); },
            ast.StmtFor(fo) => { a = collect_fresh_scenum_names(fo.body, structs, borrowable, plan_on, plan_fe, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_scenum_names(arm.body, structs, borrowable, plan_on, plan_fe, a); }
            },
            _ => {}
        }
    }
    return a;
}

function collect_fresh_rcenum_names(stmts: ast.Stmt[], structs: parser.StructDecl[], opt_fresh_ret: SigReg, borrowable: string[], str_fresh: string[], msites: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                // Direct/qualified variant-ctor init, OR (#4355 slice 5) a CALL to
                // a whole-program-proven fresh rc-enum ctor fn ("RCE:<name>|<Enum>"
                // in opt_fresh_ret — every return a fresh direct construction, so
                // the call result is a sole-owned chain exactly like an inline ctor).
                var rceo: string = fresh_rcpayload_enum_init(v.init, structs, str_fresh, msites, true);
                if (rceo == "") { rceo = rcenum_call_init_owner(v.init, opt_fresh_ret); }
                // A REBOUND name is admitted when every assignment constructs a
                // fresh chain of the SAME enum (#6127) — the rebind then routes
                // through emit_enum_deep_reinit_store like the re-declared
                // loop-local already did.
                var rce_rebind_ok: boolean = util.index_of_str(reassigned, v.name) < 0
                    || all_assigns_fresh_rcenum(stmts, v.name, rceo, structs, opt_fresh_ret, str_fresh);
                if (rceo != "" && rce_rebind_ok) {
                    var match_idx: i32 = sole_top_level_match_idx(stmts, v.name);
                    if (match_idx > vi
                        && !match_arms_use_name(stmts[match_idx], v.name)
                        && !match_arm_binds_rc_payload(stmts[match_idx], structs)
                        && !name_used_after(stmts, v.name, match_idx)
                        && !name_escapes_outside_stmt_enumfield(stmts, v.name, match_idx, structs)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    } else if (match_idx < 0 && !body_unsafe_for_enumfield_alias(stmts, v.name, borrowable, structs, rcenum_alias_chain_sites_of(stmts, v.name, borrowable, structs, stmts, []))) {
                        // NO consuming match in this block. Every gate above exists to
                        // prove the match neither retains the box nor hands out its
                        // payload; with no match there is nothing to prove but that
                        // the name never escapes, which is exactly body_unsafe_for —
                        // and it reads a borrowable call argument as a borrow, so
                        // `head(b)` qualifies while a callee that returns the payload
                        // is not borrowable and refuses the name here.
                        //
                        // Requiring a match was leaving this whole shape uncredited:
                        // an rc-enum loop-local passed to a helper, and one never used
                        // at all, both grew 2.00x per doubling where the inline match
                        // was flat (#6606).
                        //
                        // Marked "S:" because this half is ALSO sweepable at scope
                        // exit, and the match-consumed half above is not: the
                        // consuming match frees the value inside the block on every
                        // iteration including the last, so sweeping it would be a
                        // second claim on a released box. With no match nothing frees
                        // the FINAL value — the loop rebind only ever releases the
                        // PRIOR one — so it survives to function exit. The caller
                        // splits this marker into the "RCENUM:" and "RCENUMS:"
                        // credits; the marker keeps the split to a single walk of the
                        // body, which matters because this runs per lower_func inside
                        // the fixed bump arena.
                        a = push_str_unique(a, "S:" + reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(iff) => { a = collect_fresh_rcenum_names(iff.then_body, structs, opt_fresh_ret, borrowable, str_fresh, msites, a); a = collect_fresh_rcenum_names(iff.else_body, structs, opt_fresh_ret, borrowable, str_fresh, msites, a); },
            ast.StmtWhile(w) => { a = collect_fresh_rcenum_names(w.body, structs, opt_fresh_ret, borrowable, str_fresh, msites, a); },
            ast.StmtFor(f) => { a = collect_fresh_rcenum_names(f.body, structs, opt_fresh_ret, borrowable, str_fresh, msites, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_rcenum_names(arm.body, structs, opt_fresh_ret, borrowable, str_fresh, msites, a); }
            },
            ast.StmtDefer(d) => {
                match (d.action) {
                    ast.StmtWhile(dw) => { a = collect_fresh_rcenum_names(dw.body, structs, opt_fresh_ret, borrowable, str_fresh, msites, a); },
                    _ => {}
                }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

// call_arg_borrowable: the callee's param `ai` is BORROWABLE — provably only
// borrow-read and never escaping (the borrowable_params_of verdict, seeded
// into reclaimable_names as "BORROW:<name>|<flags>" by lower_func — ONLY for
// callees that appear with a literal string arg in this function's body, so
// the list stays tiny; the expr-lowering consults it without a LowerState
// field, which is pinned at 33). A borrowable position cannot retain,
// return, or alias its argument, so a fresh anonymous temp passed there is
// dead after the call.
function call_arg_borrowable(s: LowerState, callee: string, ai: i32): boolean {
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        var ent: string = s.reclaimable_names[i];
        var st: i32 = tagged_value_start(ent, "BORROW:", callee);
        if (st >= 0 && st < ent.len()) {
            if (st + ai < ent.len()) { return ent[st + ai] == b'1'; }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// ArgStash is stash_fresh_str_arg's result: the state with the park emitted,
// and the scratch slot holding the box (-1 when the arg earned no stash).
struct ArgStash { state: LowerState, slot: i32 }

// stash_fresh_str_arg parks a fresh string ARGUMENT — a literal, or one of the
// anonymous temps is_fresh_str_temp admits (a concat, a producer, a copying
// method) — in a scratch and reloads it, so the caller can free the box after
// the call. The store+reload leaves the arg in place on the operand stack.
//
// Gated on call_arg_borrowable: at a borrowable position the callee can neither
// retain nor return the argument, so the box is dead the moment the call
// returns. `relabel(t)` moving `t` into a struct field is NOT borrowable and is
// correctly refused here.
function stash_fresh_str_arg(s: LowerState, arg: ast.Expr, callee: string, ai: i32): ArgStash {
    if (!s.ok) { return ArgStash { state: s, slot: 0 - 1 }; }
    var fresh: boolean = false;
    match (arg) { ast.ExprString(_) => { fresh = true; }, _ => {} }
    if (!fresh) { fresh = is_fresh_str_temp(arg, s); }
    // A COUNTED-RETAIN position admits the same temp where borrowability cannot:
    // the callee STORES the argument — `mkq(t, k) { return Q { tag: t, k: k }; }`
    // is not borrowable by construction — but every appearance of its parameter
    // is a counted store or a non-retaining read, so the temp is rc 2 on the
    // escaping path and rc 1 otherwise and this one post-call free nets it to a
    // single owner either way (#6544). Without it the caller's argument box was
    // released by nothing at all.
    if (!fresh) { return ArgStash { state: s, slot: 0 - 1 }; }
    if (!call_arg_borrowable(s, callee, ai)
        && !str_param_counted_at(s.sigs.param_counted, callee, ai)) { return ArgStash { state: s, slot: 0 - 1 }; }
    var latn: string = "$lat" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(latn);
    var lats: i32 = st.slot_of(latn);
    st = st.emit(ir.op_store_local(lats));
    st = st.emit(ir.op_load_local(lats));
    return ArgStash { state: st, slot: lats };
}

// free_stashed_str_args drains stash_fresh_str_arg's slots after the call.
// Net-zero on the operand stack (load -> free -> drop), so the call's result —
// live beneath — is untouched; __fern_str_free is rc-aware, so a box that
// turned out to be retained only decs.
// free_stashed_recv drains the RECEIVER stash. A view box needs
// __fern_str_view_free, not __fern_str_free: the latter skips an immortal rc by
// design, so draining a slice receiver through it strands the box it was meant
// to release. On wasm the same slot holds a payload-sized COPY with an ordinary
// rc, and both helpers free it — the distinction only bites on the backends
// where a slice is zero-copy.
function free_stashed_recv(s: LowerState, slots: i32[], view: boolean): LowerState {
    if (!view) { return free_stashed_str_args(s, slots); }
    var st: LowerState = s;
    var i: i32 = 0;
    while (i < slots.len()) {
        st = st.emit(ir.op_load_local(slots[i]));
        st = st.emit(ir.op_call_direct("__fern_str_view_free", 1));
        st = st.emit(ir.op_drop());
        i = i + 1;
    }
    return st;
}

function free_stashed_str_args(s: LowerState, slots: i32[]): LowerState {
    var st: LowerState = s;
    var i: i32 = 0;
    while (i < slots.len()) {
        st = st.emit(ir.op_load_local(slots[i]));
        st = st.emit(ir.op_call_direct("__fern_str_free", 1));
        st = st.emit(ir.op_drop());
        i = i + 1;
    }
    return st;
}

// StructArgStash is stash_fresh_struct_arg's result: the state with the park
// emitted and the scratch slot holding the box (marked with the struct type,
// so the post-call release routes like a swept local). slot is -1 when the arg
// earned no stash.
struct StructArgStash { state: LowerState, slot: i32 }

// stash_fresh_struct_arg parks a fresh STRUCT argument in a scratch and reloads
// it, so the caller can free the box after the call. The string sibling is
// stash_fresh_str_arg; both the ident-callee and the method-callee lowering
// call this one.
//
// Two shapes qualify. A no-base struct LITERAL (`take(P { … })`) — the ladder
// that reclaims a DISCARDED struct literal lives in lower_stmt_inner's StmtExpr
// arm and has no expression-position counterpart, so the argument temp leaked
// its box and every rc field it owns, even a scalar-only struct whose release
// there is a single dec. And a call to a strict-fresh struct PRODUCER
// (`take(mk(i))`), which no literal arm can reach: every return of such a
// callee is a no-base literal this frame allocated, so the returned box
// sole-owns its fields and the same two release shapes apply. A local shadowing
// the producer's name is refused — the registry is keyed by declaration.
//
// Gated like the string sibling: at a borrowable position the callee can
// neither retain nor return the argument, so the box is dead the moment the
// call returns, and a counted-retain position admits the same temp because the
// callee's store leaves it rc 2 on the escaping path and rc 1 otherwise.
function stash_fresh_struct_arg(s: LowerState, arg: ast.Expr, callee: string, ai: i32): StructArgStash {
    if (!s.ok) { return StructArgStash { state: s, slot: 0 - 1 }; }
    if (!call_arg_borrowable(s, callee, ai)
        && !arr_param_counted_at(s.sigs.param_counted, callee, ai)
        && !struct_param_counted_at(s.sigs.param_counted, callee, ai)) {
        return StructArgStash { state: s, slot: 0 - 1 };
    }
    var ty: string = "";
    match (arg) {
        ast.ExprStructLit(lsl) => {
            if (!lsl.has_base) { ty = lsl.type_name; }
        },
        ast.ExprCall(lac) => {
            match (lac.callee) {
                ast.ExprIdent(lacid) => {
                    if (util.index_of_str(s.sigs.return_fresh_struct_ret_fns, lacid.name) >= 0
                        && s.slot_of(lacid.name) < 0) { ty = s.struct_ret_type(lacid.name); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    if (ty.len() == 0) { return StructArgStash { state: s, slot: 0 - 1 }; }
    // Scalar-only (a box dec) or the leak-safe-array / nested-struct set. NOT
    // widened to every type that routes field reclaim, which is what a
    // string-fielded argument temp would need: the borrowability flag proves
    // the callee keeps no reference to the BOX, and says nothing about a
    // FIELD it hands out — `get(x: P): string { return x.s; }` is refused
    // here only because it is not borrowable at all, and a callee that
    // returns a field while otherwise qualifying would have its string freed
    // under the value it handed back. Admitting the wider set segfaults gen1
    // of the per-module emit-all fixpoint while every small-program gate
    // stays green (docs/rc-log/2026-09-03-own-param-donor-and-release.md has
    // the bisect); closing it needs a callee-side "hands out no field" proof
    // the self-host does not compute yet, so a string-fielded literal
    // argument keeps its leak rather than trading it for a use-after-free.
    if (!struct_lit_all_scalar(s.structs, ty) && !struct_fields_reusable(s.structs, ty)) {
        return StructArgStash { state: s, slot: 0 - 1 };
    }
    var lsln: string = "$lsl" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(lsln);
    var lsls: i32 = st.slot_of(lsln);
    st = st.mark_struct_type(lsls, ty);
    st = st.emit(ir.op_store_local(lsls));
    st = st.emit(ir.op_load_local(lsls));
    return StructArgStash { state: st, slot: lsls };
}

// free_stashed_struct_args drains stash_fresh_struct_arg's slots after the
// call, the way the exit sweep releases a struct local: the field walk first,
// while the box still OWNS its fields, then the box dec. The walk is gated on
// the box being sole-owned (emit_struct_field_drops_gated): at a borrowable
// position it is, and at a counted-retain position the callee's store left it
// shared, so the fields stay with the owner that finds rc 1. A scalar-only
// struct routes no walk and takes the dec alone. Net-zero on the operand stack,
// so the call's result — live beneath — is untouched.
function free_stashed_struct_args(s: LowerState, slots: i32[]): LowerState {
    var st: LowerState = s;
    var i: i32 = 0;
    while (i < slots.len()) {
        st = emit_struct_field_drops_gated(st, slots[i], true);
        st = st.release(slots[i], "__fern_rc_dec", "stashed-struct-arg");
        i = i + 1;
    }
    return st;
}

// discarded_call_callees_stmt collects the bare-ident CALLEE names of DISCARDED
// call statements (`mk(i);` — a StmtExpr whose value is a direct free call),
// recursing into control-flow bodies. Only these callees need a "TUPRET:" seed.
function discarded_call_callees_stmt(st: ast.Stmt, acc: string[]): string[] {
    var a: string[] = acc;
    match (st) {
        ast.StmtExpr(e) => {
            match (e.value) {
                ast.ExprCall(c) => {
                    match (c.callee) { ast.ExprIdent(cid) => { a = push_str_unique(a, cid.name); }, _ => {} }
                },
                _ => {}
            }
        },
        ast.StmtDefer(d) => { return discarded_call_callees_stmt(d.action, a); },
        ast.StmtIf(f) => {
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { a = discarded_call_callees_stmt(f.then_body[ti], a); ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { a = discarded_call_callees_stmt(f.else_body[ei], a); ei = ei + 1; }
        },
        ast.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) { a = discarded_call_callees_stmt(w.body[i], a); i = i + 1; }
        },
        ast.StmtFor(fo) => {
            var i: i32 = 0;
            while (i < fo.body.len()) { a = discarded_call_callees_stmt(fo.body[i], a); i = i + 1; }
        },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                var bi: i32 = 0;
                while (bi < arm.body.len()) { a = discarded_call_callees_stmt(arm.body[bi], a); bi = bi + 1; }
            }
        },
        _ => {}
    }
    return a;
}

// len_recv_callees_expr / _stmt collect the bare-ident CALLEE names of
// `f(..).len()` shapes — a call result consumed as a len RECEIVER — recursing
// through every expression position (the collect_idents_expr recursion). Only
// these callees need an "SFRLEN:" seed (the same narrow-seeding rule as
// BORROW:/TUPRET:/MAPRET:, so the arena stays flat). A form the walker
// doesn't model just misses its credit — never unsound.
function len_recv_callees_expr(e: ast.Expr, acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprBinary(b) => {
            a = len_recv_callees_expr(b.left, a);
            return len_recv_callees_expr(b.right, a);
        },
        ast.ExprUnary(u) => { return len_recv_callees_expr(u.operand, a); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len" && c.args.len() == 0) {
                        match (cfa.obj) {
                            ast.ExprCall(rc) => {
                                match (rc.callee) { ast.ExprIdent(rcid) => { a = push_str_unique(a, rcid.name); }, _ => {} }
                            },
                            _ => {}
                        }
                    }
                    a = len_recv_callees_expr(cfa.obj, a);
                },
                _ => { a = len_recv_callees_expr(c.callee, a); }
            }
            for arg in c.args { a = len_recv_callees_expr(arg, a); }
            return a;
        },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { a = len_recv_callees_expr(ar.elements[i], a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = len_recv_callees_expr(el, a); }
            return a;
        },
        ast.ExprIndex(x) => {
            a = len_recv_callees_expr(x.array, a);
            return len_recv_callees_expr(x.index, a);
        },
        ast.ExprSlice(sl) => {
            a = len_recv_callees_expr(sl.array, a);
            a = len_recv_callees_expr(sl.start, a);
            return len_recv_callees_expr(sl.end, a);
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { a = len_recv_callees_expr(sl.base, a); }
            for fv in sl.field_values { a = len_recv_callees_expr(fv, a); }
            return a;
        },
        ast.ExprFieldAccess(fa) => { return len_recv_callees_expr(fa.obj, a); },
        _ => {}
    }
    return a;
}

function len_recv_callees_stmt(st: ast.Stmt, acc: string[]): string[] {
    var a: string[] = acc;
    match (st) {
        ast.StmtExpr(e) => { return len_recv_callees_expr(e.value, a); },
        ast.StmtVar(v) => { return len_recv_callees_expr(v.init, a); },
        ast.StmtAssign(asn) => { return len_recv_callees_expr(asn.value, a); },
        ast.StmtReturn(r) => { return len_recv_callees_expr(r.value, a); },
        ast.StmtDefer(d) => { return len_recv_callees_stmt(d.action, a); },
        ast.StmtIf(f) => {
            a = len_recv_callees_expr(f.cond, a);
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { a = len_recv_callees_stmt(f.then_body[ti], a); ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { a = len_recv_callees_stmt(f.else_body[ei], a); ei = ei + 1; }
        },
        ast.StmtWhile(w) => {
            a = len_recv_callees_expr(w.cond, a);
            var i: i32 = 0;
            while (i < w.body.len()) { a = len_recv_callees_stmt(w.body[i], a); i = i + 1; }
        },
        ast.StmtFor(fo) => {
            a = len_recv_callees_expr(fo.iter, a);
            var i: i32 = 0;
            while (i < fo.body.len()) { a = len_recv_callees_stmt(fo.body[i], a); i = i + 1; }
        },
        ast.StmtMatch(m) => {
            a = len_recv_callees_expr(m.scrutinee, a);
            for arm in m.arms {
                var bi: i32 = 0;
                while (bi < arm.body.len()) { a = len_recv_callees_stmt(arm.body[bi], a); bi = bi + 1; }
            }
        },
        _ => {}
    }
    return a;
}

// discarded_tuple_ret_flags: the "TUPRET:<callee>|<flags>" entry's flags for a
// discarded call to `callee`, "" when none. Flag k = '1' means tuple element k
// is a fresh scalar-element array buffer the StmtExpr deep-drop releases before
// the box.
function discarded_tuple_ret_flags(s: LowerState, callee: string): string {
    return tagged_value_of(s.reclaimable_names, "TUPRET:", callee);
}

// lit_arg_callees_expr / _stmt collect the bare-ident CALLEE names of calls
// carrying at least one argument whose box the caller may have to free after
// the call: a string LITERAL, an array or struct LITERAL, a producer CALL, or a
// fresh-anonymous-temp-shaped argument (a concat / producer / copying method —
// the syntactic half of is_fresh_str_temp; the type gate runs at the lowering).
// These are the only callees whose "BORROW:" entry lower_func needs to seed for
// the fresh-arg box reclaim. Mirrors astwalk.collect_idents_expr's shape coverage; lambda
// bodies recurse directly (over-collection just seeds a harmless extra
// entry).
function lit_arg_callees_expr(e: ast.Expr, acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var has_lit: boolean = false;
                    for arg in c.args {
                        // ExprArray: the #4365 stage-(b) fresh array-literal arg
                        // (the scalar-element gate runs at the lowering with type
                        // info; over-collection here just seeds a harmless entry).
                        // A direct CALL argument is the producer-temp shape
                        // (`size(mk(i))`): a fresh box handed straight to a
                        // borrowed position, which nothing releases. The
                        // lowering re-tests freshness and borrowability with
                        // type info, so a non-producing call only seeds a
                        // spare entry — the same over-collection the method
                        // arm below already documents.
                        // ExprStructLit: the struct-literal arg temp, whose
                        // reclaim has the same shape — the ladder that frees a
                        // DISCARDED struct literal has no expression-position
                        // counterpart, so without a "BORROW:" row here the
                        // lowering's stash arm can never fire.
                        match (arg) { ast.ExprString(_) => { has_lit = true; }, ast.ExprArray(_) => { has_lit = true; }, ast.ExprCall(_) => { has_lit = true; }, ast.ExprStructLit(_) => { has_lit = true; }, _ => {
                            if (str_local_binding_is_fresh(arg)) { has_lit = true; }
                        } }
                    }
                    if (has_lit) { a = push_str_unique(a, cid.name); }
                },
                // A METHOD callee. Its borrowable key is "<Type>.<method>",
                // which needs the receiver's type — not resolvable here (no
                // LowerState), so collect the bare method NAME and let the
                // seeding loop match a key by its part after the last '.'.
                // The lowering looks the entry up by the full key, so a
                // same-named method on another type only seeds a spare entry.
                ast.ExprFieldAccess(mfa) => {
                    var mhas: boolean = false;
                    for arg in c.args {
                        // The same shapes the ident arm collects, minus the
                        // array literal: this seeds what a METHOD callee's
                        // lowering can consume, and that path stashes the
                        // string and struct tiers only.
                        match (arg) { ast.ExprString(_) => { mhas = true; }, ast.ExprStructLit(_) => { mhas = true; }, ast.ExprCall(_) => { mhas = true; }, _ => {
                            if (str_local_binding_is_fresh(arg)) { mhas = true; }
                        } }
                    }
                    if (mhas) { a = push_str_unique(a, mfa.field); }
                    a = lit_arg_callees_expr(c.callee, a);
                },
                _ => { a = lit_arg_callees_expr(c.callee, a); }
            }
            for arg in c.args { a = lit_arg_callees_expr(arg, a); }
            return a;
        },
        ast.ExprBinary(b) => { a = lit_arg_callees_expr(b.left, a); return lit_arg_callees_expr(b.right, a); },
        ast.ExprUnary(u) => { return lit_arg_callees_expr(u.operand, a); },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { a = lit_arg_callees_expr(ar.elements[i], a); i = i + 1; }
            return a;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { a = lit_arg_callees_expr(el, a); }
            return a;
        },
        ast.ExprIndex(x) => { a = lit_arg_callees_expr(x.array, a); return lit_arg_callees_expr(x.index, a); },
        ast.ExprSlice(sl) => { a = lit_arg_callees_expr(sl.array, a); a = lit_arg_callees_expr(sl.start, a); return lit_arg_callees_expr(sl.end, a); },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { a = lit_arg_callees_expr(sl.base, a); }
            for fv in sl.field_values { a = lit_arg_callees_expr(fv, a); }
            return a;
        },
        ast.ExprFieldAccess(fa) => { return lit_arg_callees_expr(fa.obj, a); },
        ast.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) { a = lit_arg_callees_stmt(lm.body[i], a); i = i + 1; }
            return a;
        },
        _ => { return a; }
    }
    return a;
}
function lit_arg_callees_stmt(st: ast.Stmt, acc: string[]): string[] {
    var a: string[] = acc;
    match (st) {
        ast.StmtDefer(d) => { return lit_arg_callees_stmt(d.action, a); },
        ast.StmtVar(v) => { return lit_arg_callees_expr(v.init, a); },
        ast.StmtReturn(r) => { return lit_arg_callees_expr(r.value, a); },
        ast.StmtExpr(e) => { return lit_arg_callees_expr(e.value, a); },
        ast.StmtAssign(asg) => { return lit_arg_callees_expr(asg.value, a); },
        ast.StmtIf(f) => {
            a = lit_arg_callees_expr(f.cond, a);
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { a = lit_arg_callees_stmt(f.then_body[ti], a); ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { a = lit_arg_callees_stmt(f.else_body[ei], a); ei = ei + 1; }
            return a;
        },
        ast.StmtWhile(w) => {
            a = lit_arg_callees_expr(w.cond, a);
            var i: i32 = 0;
            while (i < w.body.len()) { a = lit_arg_callees_stmt(w.body[i], a); i = i + 1; }
            return a;
        },
        ast.StmtFor(f) => {
            a = lit_arg_callees_expr(f.iter, a);
            var i: i32 = 0;
            while (i < f.body.len()) { a = lit_arg_callees_stmt(f.body[i], a); i = i + 1; }
            return a;
        },
        ast.StmtMatch(m) => {
            a = lit_arg_callees_expr(m.scrutinee, a);
            for arm in m.arms {
                var bi: i32 = 0;
                while (bi < arm.body.len()) { a = lit_arg_callees_stmt(arm.body[bi], a); bi = bi + 1; }
            }
            return a;
        },
        _ => { return a; }
    }
    return a;
}

// rcenum_call_init_owner: `e` is a direct call `mk(args...)` to a fn the
// whole-program scan proved a fresh rc-enum ctor ("RCE:<name>|<Enum>" in
// opt_fresh_ret — see opt_fresh_ret_fns_of). Returns the enum name, else "".
function rcenum_call_init_owner(e: ast.Expr, opt_fresh_ret: SigReg): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return sig_reg_tagged_value_of(opt_fresh_ret, "RCE:", cid.name); },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}

// collect_fresh_string_names / collect_fresh_string_in_stmt gather the LOCAL
// names bound via `var s: string = <fresh producer>` (str_local_binding_is_fresh)
// anywhere in the body — the string sibling of collect_fresh_scalar_tuple_names.
// The escape gate (body_unsafe_for) and the not-reassigned gate are applied by
// reclaimable_names_of before any name is credited "STR:", so a returned /
// stored / aliased / reassigned string is never freed (only leaked, sound).
// --- literal-init string locals (#6582) --------------------------------------
//
// `var pre: string = "ab"` earned no "STR:" credit and leaked one box per evaluation
// on the asm backends: str_local_binding_is_fresh admits a concat and the producer
// methods but not a bare literal. const_str allocates a FRESH box per evaluation —
// the DATA is .rodata, but the box is not, and __fern_str_free's heap-base guard
// already skips the data and reclaims the box, which is why is_fresh_str_temp admits
// the identical shape as a concat OPERAND. Flat on wasm, where the whole literal is
// data-section and arr_dec is a guarded no-op.
//
// Kept OUT of str_local_binding_is_fresh, whose twenty-odd other callers drive the
// accumulator consume-rebind and concat-temp analyses: widening it there makes
// `s = "reset"` read as a fresh rebind, admitting an accumulator TestSelfHostStrAccum
// pins as un-reclaimable. Both that and the exclusion below are over-release
// contracts, so this stays local to the STR credit.

// litstr_tostring_receiver: `name` is the receiver of a `.to_string()` call. On a
// STRING receiver that call is the IDENTITY — its result aliases the receiver's box,
// and the concat-temp machinery frees that result as an inline-consumed temp. Adding
// an exit-sweep free of the local would then release the same box twice, which is what
// TestSelfHostStrConcatTemp's `tostring-string-recv-alias-safe` pins at exactly two
// sites. Freeing the alias rather than the source is the pre-existing shape here; this
// exclusion keeps the literal credit from turning it into a double release.
function litstr_tostring_receiver(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "to_string") {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => { if (rid.name == name) { return true; } },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            if (litstr_tostring_receiver(c.callee, name)) { return true; }
            for arg in c.args { if (litstr_tostring_receiver(arg, name)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return litstr_tostring_receiver(b.left, name) || litstr_tostring_receiver(b.right, name); },
        ast.ExprUnary(u) => { return litstr_tostring_receiver(u.operand, name); },
        ast.ExprFieldAccess(fa2) => { return litstr_tostring_receiver(fa2.obj, name); },
        ast.ExprIndex(ix) => { return litstr_tostring_receiver(ix.array, name) || litstr_tostring_receiver(ix.index, name); },
        ast.ExprArray(a) => {
            var ai: i32 = 0;
            while (ai < a.elements.len()) { if (litstr_tostring_receiver(a.elements[ai], name)) { return true; } ai = ai + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (litstr_tostring_receiver(el, name)) { return true; } }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function litstr_tostring_recv_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return litstr_tostring_receiver(v.init, name); },
        ast.StmtAssign(a) => { return litstr_tostring_receiver(a.value, name); },
        ast.StmtReturn(r) => { return litstr_tostring_receiver(r.value, name); },
        ast.StmtExpr(e) => { return litstr_tostring_receiver(e.value, name); },
        ast.StmtIf(f) => {
            if (litstr_tostring_receiver(f.cond, name)) { return true; }
            return litstr_tostring_recv_body(f.then_body, name) || litstr_tostring_recv_body(f.else_body, name);
        },
        ast.StmtWhile(w) => {
            if (litstr_tostring_receiver(w.cond, name)) { return true; }
            return litstr_tostring_recv_body(w.body, name);
        },
        ast.StmtFor(fo) => {
            if (litstr_tostring_receiver(fo.iter, name)) { return true; }
            return litstr_tostring_recv_body(fo.body, name);
        },
        ast.StmtMatch(m) => {
            if (litstr_tostring_receiver(m.scrutinee, name)) { return true; }
            for arm in m.arms { if (litstr_tostring_recv_body(arm.body, name)) { return true; } }
            return false;
        },
        ast.StmtDefer(d) => { return litstr_tostring_recv_stmt(d.action, name); },
        _ => { return false; },
    }
    return false;
}

function litstr_tostring_recv_body(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (litstr_tostring_recv_stmt(stmt, name)) { return true; } }
    return false;
}

// --- `<scalar>.to_string()` string locals (#6599) -----------------------------
//
// `var s: string = i.to_string()` leaked its box on every backend: the method form
// is excluded from str_free_producer_ident / str_local_binding_is_fresh, whose
// comments give the reason — `.to_string()` is a "receiver-identity fast-path". That
// is true on a STRING receiver, where the call returns the receiver itself, so
// freeing the result would release a box the source still owns. On a SCALAR receiver
// it is the decimal-text builtin returning a fresh sole-owned box, which is the same
// value str_free_producer_ident already admits under the free-function spelling
// `i32_to_string(n)`. Measured, 200 iterations, self-host x86-64:
//
//   var s = i32_to_string(i)   400 allocs / 398 frees /   32 bytes   bounded
//   var s = i.to_string()      400 allocs /   0 frees / 6400 bytes   LEAK
//
// Identical alloc counts, so int_to_string's own buffer and string_from_bytes_unchecked
// are not involved — the whole difference is this credit. It matters out of proportion
// to the shape, because every `f"{x}"` desugars to `x.to_string()`.
//
// The test has to live HERE rather than in str_local_binding_is_fresh, and the reason
// is structural: that predicate is deliberately PURELY SYNTACTIC (no LowerState, no
// types) with the type gate applied separately via the slot's is_str — and is_str is
// true for BOTH cases, because the RESULT is a string either way. What must be tested
// is the RECEIVER's type. Its ~20 callers also drive the accumulator and concat-temp
// analyses, where widening it broke two over-release contracts in #6590.
//
// An UNKNOWN receiver type is refused, not assumed scalar: unresolvable must fall to
// leak-safe, since the wrong answer here is an over-release rather than a leak.

// tostr_scalar_type_name: the receiver types whose `.to_string()` is the decimal-text
// builtin. Deliberately NOT `string` (the identity case) and not a struct/array.
function tostr_scalar_type_name(t: string): boolean {
    return t == "i32" || t == "i64" || t == "u32" || t == "u64";
}

// tostr_decl_names / tostr_decl_vals collect `name` and `declared type` for every
// annotated `var` in the
// body, the way rc_fe_collect_types does. Bindings with no annotation are simply absent,
// which reads as "unknown" and refuses the credit.
// The names and the types are collected by two INDEPENDENT walks in the same order,
// which is what keeps the two lists index-aligned: each visits the same StmtVar nodes
// in the same sequence and appends exactly when the binding carries an annotation.
// param_decl_names / param_decl_types extend the declared-name / declared-type
// pair with the function's PARAMETERS. A parameter is a declaration like any
// other — it just does not appear as a `var` in the body — and without it the
// receiver-type tests that read this pair (join_strarr_init, tostr_scalar_init)
// refuse every `function f(xs: string[]) { var s = xs.join(sep); }`.
function param_decl_names(params: ast.ParamDecl[], ns: string[]): string[] {
    var out_n: string[] = ns;
    var i: i32 = 0;
    while (i < params.len()) { out_n = out_n.append(params[i].name); i = i + 1; }
    return out_n;
}
function param_decl_types(params: ast.ParamDecl[], ts: string[]): string[] {
    var out_t: string[] = ts;
    var i: i32 = 0;
    while (i < params.len()) { out_t = out_t.append(params[i].type_name); i = i + 1; }
    return out_t;
}

function tostr_decl_names(stmts: ast.Stmt[], ns: string[]): string[] {
    var out_n: string[] = ns;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.type_name.len() > 0) { out_n = out_n.append(v.name); } },
            ast.StmtIf(f) => { out_n = tostr_decl_names(f.then_body, out_n); out_n = tostr_decl_names(f.else_body, out_n); },
            ast.StmtWhile(w) => { out_n = tostr_decl_names(w.body, out_n); },
            ast.StmtFor(fo) => { out_n = tostr_decl_names(fo.body, out_n); },
            ast.StmtMatch(m) => {
                for arm in m.arms { out_n = tostr_decl_names(arm.body, out_n); }
            },
            _ => {},
        }
    }
    return out_n;
}

function tostr_decl_vals(stmts: ast.Stmt[], ts: string[]): string[] {
    var out_t: string[] = ts;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.type_name.len() > 0) { out_t = out_t.append(v.type_name); } },
            ast.StmtIf(f) => { out_t = tostr_decl_vals(f.then_body, out_t); out_t = tostr_decl_vals(f.else_body, out_t); },
            ast.StmtWhile(w) => { out_t = tostr_decl_vals(w.body, out_t); },
            ast.StmtFor(fo) => { out_t = tostr_decl_vals(fo.body, out_t); },
            ast.StmtMatch(m) => {
                for arm in m.arms { out_t = tostr_decl_vals(arm.body, out_t); }
            },
            _ => {},
        }
    }
    return out_t;
}

// tostr_scalar_init: `init` is `<ident>.to_string()` whose receiver is a local declared
// with a scalar int type. Returns the bound name's eligibility.
function tostr_scalar_init(init: ast.Expr, ns: string[], ts: string[]): boolean {
    match (init) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "to_string") { return false; }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            var at: i32 = util.index_of_str(ns, rid.name);
                            if (at < 0) { return false; }          // unknown type -> refuse
                            if (at >= ts.len()) { return false; }
                            return tostr_scalar_type_name(ts[at]);
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// join_strarr_init: `init` is `<ident>.join(<sep>)` whose receiver is a local
// declared `string[]`. The receiver-type test is what makes the credit safe, and
// it cannot live in str_local_binding_is_fresh for the same reason the
// `.to_string()` one cannot: that function is state-free and purely syntactic, so
// a bare `field == "join"` arm there also admits a user-declared
// `(h: Holder) join(sep)` whose result ALIASES a field the receiver still owns —
// measured as a live-box free (exit 97 on x86-64, a trap on wasm), which is why
// the shape is pinned by a test rather than only described here.
//
// __fern_arr_str_join on a real string[] cannot alias: the register body is Fern
// source built as `var r = ""` then concat, and wasm's copies bytes into a fresh
// box.
function join_strarr_init(init: ast.Expr, ns: string[], ts: string[]): boolean {
    match (init) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "join") { return false; }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            var at: i32 = util.index_of_str(ns, rid.name);
                            if (at < 0) { return false; }          // unknown type -> refuse
                            if (at >= ts.len()) { return false; }
                            return ts[at] == "string[]";
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// trim_str_init: `init` is `<ident>.trim()` whose receiver is declared `string`.
// The receiver-type test lives here for the same reason join_strarr_init's does —
// str_local_binding_is_fresh is state-free, and a user-declared `.trim()` on
// another type would otherwise be admitted by name alone (the
// str-trim-user-method pin is what fails when it is). Since #7393 the builtin
// trim returns an OWNED copy, so a credited binding takes the ordinary full
// __fern_str_free — no view-aware release, no box-only carve-out.
function trim_str_init(init: ast.Expr, ns: string[], ts: string[]): boolean {
    match (init) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "trim") { return false; }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            var at: i32 = util.index_of_str(ns, rid.name);
                            if (at < 0) { return false; }          // unknown type -> refuse
                            if (at >= ts.len()) { return false; }
                            return ts[at] == "string";
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// collect_trim_local_names gathers every `var t: string = s.trim()` binding,
// recursing through nested blocks like its siblings.
function collect_trim_local_names(stmts: ast.Stmt[], ns: string[], ts: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (trim_str_init(v.init, ns, ts)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); } },
            ast.StmtIf(f) => { a = collect_trim_local_names(f.then_body, ns, ts, a); a = collect_trim_local_names(f.else_body, ns, ts, a); },
            ast.StmtWhile(w) => { a = collect_trim_local_names(w.body, ns, ts, a); },
            ast.StmtFor(fo) => { a = collect_trim_local_names(fo.body, ns, ts, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_trim_local_names(arm.body, ns, ts, a); }
            },
            _ => {}
        }
    }
    return a;
}


// replace_str_init: `init` is `<ident>.replace(old, new)` whose receiver is
// declared `string`. Fourth consumer of the declared-name/type pair, for the same
// reason as the other three.
//
// Unlike trim, the result here is NOT unconditionally a fresh box: with the
// needle absent replace hands the receiver straight back, measured at zero bytes
// allocated. The credit is therefore paired with the identity guard
// emit_str_slot_release emits — the analysis says "this box MAY be ours", and the
// guard settles it at run time, which is the only place the answer exists.
function replace_str_init(init: ast.Expr, ns: string[], ts: string[]): boolean {
    match (init) {
        ast.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "replace") { return false; }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            var at: i32 = util.index_of_str(ns, rid.name);
                            if (at < 0) { return false; }          // unknown type -> refuse
                            if (at >= ts.len()) { return false; }
                            return ts[at] == "string";
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// sfrrecv_str_init: `init` is a chain of SFRRECV-proven string METHODS rooted at
// an ident declared `string` — `base.drop(2)`, `base.tail(4).to_owned()`. Fifth
// consumer of the declared-name/type pair, and the BINDING half of #6544.
//
// SFRRECV admits a method whose every return is fresh, the RECEIVER, or a view of
// it, so no static answer says which one arrived. That is replace's situation
// exactly, and it takes replace's answer: credit the binding and let the release
// site settle it at run time against the chain ROOT's pointer. A fresh box is
// never a box that already existed, and a view is an allocation like any other,
// so pointer equality with the root means — and only means — that every link took
// its identity path.
//
// Only a BARE IDENT root qualifies, for the reason replace_src_slot_of gives: the
// guard has to reload a slot the frame still holds, with nothing re-evaluated and
// no second allocation to confuse the compare.
function sfrrecv_str_init(init: ast.Expr, ns: string[], ts: string[], str_fresh_ret: string[]): boolean {
    match (init) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (util.index_of_str(str_fresh_ret, "SFRRECV:string." + fa.field) < 0) { return false; }
                    return sfrrecv_str_chain_rooted(fa.obj, ns, ts, str_fresh_ret, 0);
                },
                _ => { return false; }
            }
        },
        _ => {}
    }
    return false;
}

// sfrrecv_str_chain_rooted: `e` is another proven link, or the bare ident declared
// `string` the chain roots at. The syntactic twin of sfrrecv_chain_root_slot,
// which answers the same question with SLOTS once lowering reaches the binding —
// and the two must agree, which is why the credit this feeds is only a CANDIDATE
// until bind_var_slot's slot walk confirms it. Every link is keyed
// `SFRRECV:string.<m>` because an SFRRECV method returns `string`, so a chain that
// starts on a string stays on one.
function sfrrecv_str_chain_rooted(e: ast.Expr, ns: string[], ts: string[], str_fresh_ret: string[], depth: i32): boolean {
    if (depth > 8) { return false; }
    match (e) {
        ast.ExprIdent(rid) => {
            var at: i32 = util.index_of_str(ns, rid.name);
            if (at < 0) { return false; }          // unknown type -> refuse
            if (at >= ts.len()) { return false; }
            return ts[at] == "string";
        },
        ast.ExprCall(cc) => {
            match (cc.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (util.index_of_str(str_fresh_ret, "SFRRECV:string." + cfa.field) < 0) { return false; }
                    return sfrrecv_str_chain_rooted(cfa.obj, ns, ts, str_fresh_ret, depth + 1);
                },
                _ => { return false; }
            }
        },
        _ => {}
    }
    return false;
}

// collect_sfrrecv_local_names gathers every `var v: str = base.drop(2)` binding,
// recursing through nested blocks like its siblings.
function collect_sfrrecv_local_names(stmts: ast.Stmt[], ns: string[], ts: string[], str_fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (sfrrecv_str_init(v.init, ns, ts, str_fresh_ret)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); } },
            ast.StmtIf(f) => { a = collect_sfrrecv_local_names(f.then_body, ns, ts, str_fresh_ret, a); a = collect_sfrrecv_local_names(f.else_body, ns, ts, str_fresh_ret, a); },
            ast.StmtWhile(w) => { a = collect_sfrrecv_local_names(w.body, ns, ts, str_fresh_ret, a); },
            ast.StmtFor(fo) => { a = collect_sfrrecv_local_names(fo.body, ns, ts, str_fresh_ret, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_sfrrecv_local_names(arm.body, ns, ts, str_fresh_ret, a); }
            },
            _ => {}
        }
    }
    return a;
}

// collect_replace_local_names gathers every `var r: string = s.replace(a, b)`
// binding, recursing through nested blocks like its siblings.
function collect_replace_local_names(stmts: ast.Stmt[], ns: string[], ts: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (replace_str_init(v.init, ns, ts)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); } },
            ast.StmtIf(f) => { a = collect_replace_local_names(f.then_body, ns, ts, a); a = collect_replace_local_names(f.else_body, ns, ts, a); },
            ast.StmtWhile(w) => { a = collect_replace_local_names(w.body, ns, ts, a); },
            ast.StmtFor(fo) => { a = collect_replace_local_names(fo.body, ns, ts, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_replace_local_names(arm.body, ns, ts, a); }
            },
            _ => {}
        }
    }
    return a;
}


// collect_join_strarr_names gathers every `var s: string = xs.join(sep)` binding,
// recursing through nested blocks like its siblings. An UNANNOTATED receiver is
// simply absent from ns/ts and so refused — the same conservative limit the
// `.to_string()` collector accepts, and the reason a `string[]` PARAM receiver is
// not credited (params carry no `var` declaration in the body).
function collect_join_strarr_names(stmts: ast.Stmt[], ns: string[], ts: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (join_strarr_init(v.init, ns, ts)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); } },
            ast.StmtIf(f) => { a = collect_join_strarr_names(f.then_body, ns, ts, a); a = collect_join_strarr_names(f.else_body, ns, ts, a); },
            ast.StmtWhile(w) => { a = collect_join_strarr_names(w.body, ns, ts, a); },
            ast.StmtFor(fo) => { a = collect_join_strarr_names(fo.body, ns, ts, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_join_strarr_names(arm.body, ns, ts, a); }
            },
            _ => {}
        }
    }
    return a;
}

// collect_tostr_scalar_names gathers every `var s: string = <scalar>.to_string()`
// binding, recursing through nested blocks like its siblings.
function collect_tostr_scalar_names(stmts: ast.Stmt[], ns: string[], ts: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (tostr_scalar_init(v.init, ns, ts)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
            },
            ast.StmtIf(f) => { a = collect_tostr_scalar_names(f.then_body, ns, ts, a); a = collect_tostr_scalar_names(f.else_body, ns, ts, a); },
            ast.StmtWhile(w) => { a = collect_tostr_scalar_names(w.body, ns, ts, a); },
            ast.StmtFor(fo) => { a = collect_tostr_scalar_names(fo.body, ns, ts, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_tostr_scalar_names(arm.body, ns, ts, a); }
            },
            _ => {},
        }
    }
    return a;
}

// collect_litstr_local_names gathers every `var s: string = "lit"` binding, recursing
// through nested blocks exactly as collect_fresh_string_names does.
function collect_litstr_local_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprString(_) => { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { a = collect_litstr_local_names(f.then_body, a); a = collect_litstr_local_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = collect_litstr_local_names(w.body, a); },
            ast.StmtFor(fo) => { a = collect_litstr_local_names(fo.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_litstr_local_names(arm.body, a); }
            },
            _ => {},
        }
    }
    return a;
}

function collect_fresh_string_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_fresh_string_in_stmt(stmt, a); }
    return a;
}
function collect_fresh_string_in_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (str_local_binding_is_fresh(v.init)) { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_fresh_string_names(iff.then_body, acc);
            return collect_fresh_string_names(iff.else_body, a);
        },
        ast.StmtWhile(w) => { return collect_fresh_string_names(w.body, acc); },
        ast.StmtFor(f) => { return collect_fresh_string_names(f.body, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_fresh_string_names(arm.body, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_fresh_string_in_stmt(d.action, acc); },
        _ => { return acc; },
    }
}

// collect_str_fresh_ret_call_names: `var t: string = f(i)` where `f` is proven to
// return a fresh, sole-owned box (str_fresh_ret_fns_of). The string sibling of
// collect_fresh_ret_call_names, and the reason it was needed: the binding-side
// freshness test is str_local_binding_is_fresh, which admits a call ONLY via
// str_free_producer_ident — a hardcoded list of BUILTINS (chr, str_to_upper,
// i32_to_string, …). A user-defined `function suffix(n: i32): string` is not in
// it, so its result earned no "STR:" credit and leaked one box per evaluation,
// unbounded in a loop (#6606). The whole-program proof that closes that gap
// already existed and was simply never consulted here.
//
// No new soundness argument: the caller-side release is the same __fern_str_free
// the fresh-producer credit emits, and reclaimable_names_of applies the SAME two
// gates to these names as to str_local_binding_is_fresh's (not reassigned, and
// body_unsafe_for_tup proves non-escape). The freshness half is what
// str_fresh_ret_fns_of proves whole-program: every return is fresh, so the
// result can alias no parameter, field or live local of the callee.
function collect_str_fresh_ret_call_names(stmts: ast.Stmt[], str_fresh_ret: string[], reassigned: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (util.index_of_str(reassigned, v.name) < 0
                    && (is_fresh_ret_binding(v.init, "", str_fresh_ret)
                        || str_method_ret_is_fresh(v.init, str_fresh_ret)
                        || tostring_on_fresh_ret(v.init, str_fresh_ret))) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_str_fresh_ret_call_names(f.then_body, str_fresh_ret, reassigned, a); a = collect_str_fresh_ret_call_names(f.else_body, str_fresh_ret, reassigned, a); },
            ast.StmtWhile(w) => { a = collect_str_fresh_ret_call_names(w.body, str_fresh_ret, reassigned, a); },
            ast.StmtFor(fo) => { a = collect_str_fresh_ret_call_names(fo.body, str_fresh_ret, reassigned, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_str_fresh_ret_call_names(m.arms[ai].body, str_fresh_ret, reassigned, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// --- string-builder accumulator reclaim (#2649 consume-rebind) ----------------
//
// The canonical string leak is the accumulator `var s: string = ""; while (…) {
// s = s + part; } … use(s)`: each `s = s + part` allocates a fresh box + buffer
// and orphans the previous one, so the whole growth chain leaks (native's Perceus
// frees the superseded box on each consume-rebind). This admits the NON-escaping
// accumulator — the returned/moved-out builder needs move-on-return and is a
// follow-up. Two analyses:
//   - str_accum_reassign_ok proves a reassignment RHS BORROW-consumes `name` (as a
//     `+` concat operand or a method receiver) and lets it escape nowhere else;
//   - str_accum_unsafe_for is the whole-body escape gate: a `name = <fresh RHS
//     that str_accum_reassign_ok admits>` is a safe consume-rebind (not an escape),
//     ANY OTHER reassignment of `name` (a non-fresh alias, or one that leaks name)
//     is unsafe, and a bare `return name` is unsafe (non-escaping only, for now).
// Combined with the init being a literal or a fresh producer, `name` owns a fresh
// (or static-literal) box at every point, so freeing the superseded box on each
// reassignment (emit_str_reclaim_store, heap-base-guarded so the initial "" literal
// is a no-op on its .rodata data) and the final at scope exit is sound.

// str_accum_value_is_fresh: the accumulator class's freshness test for a
// binding or a rebind RHS. str_local_binding_is_fresh answers from the
// expression alone — a concat, a string method, a known producer — and the
// whole-program registry answers for a user function proven to return a fresh
// box on every path (str_fresh_ret_fns_of). Without the registry half a
// `var x = mk(..); x = mk(..)` fell between two collectors: this one could not
// see mk was fresh, and collect_str_fresh_ret_call_names, which can, skips
// every reassigned name.
function str_accum_value_is_fresh(e: ast.Expr, str_fresh_ret: string[]): boolean {
    return str_local_binding_is_fresh(e) || str_call_ret_is_fresh_reg(e, str_fresh_ret);
}

// str_accum_reassign_ok: `e` (a reassignment RHS already known to be a fresh
// producer) references `name` ONLY in borrow-consume positions — a `+` concat
// operand or (via expr_unsafe_for's receiver/borrow rules) a method receiver — and
// lets it escape nowhere (no retaining call arg, no container store).
function str_accum_reassign_ok(e: ast.Expr, name: string, borrowable: string[]): boolean {
    match (e) {
        ast.ExprBinary(b) => {
            // A concat: each operand is a borrow-read (a bare ident operand — `name`
            // or another string — is consumed to build the fresh result, not
            // retained). Recurse so nested `a + name + b` is covered.
            if (b.op == "+") { return str_accum_reassign_ok(b.left, name, borrowable) && str_accum_reassign_ok(b.right, name, borrowable); }
            return !expr_unsafe_for(e, name, borrowable, []);
        },
        ast.ExprIdent(_) => { return true; },   // a concat-operand ident is a borrow-read
        _ => { return !expr_unsafe_for(e, name, borrowable, []); },
    }
    return false;
}

// str_accum_unsafe_for / stmt_accum_unsafe_for: the accumulator escape gate — like
// body_unsafe_for, but a `name = <fresh consume-rebind of name>` StmtAssign is
// SAFE (not the crude expr_unsafe_for escape), while any other reassignment of
// `name` is unsafe (a non-fresh RHS would alias a live box; freeing name later
// would then be a UAF). `return name` stays unsafe (non-escaping accumulators
// only; the move-out builder is a follow-up).
function str_accum_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], str_fresh_ret: string[]): boolean {
    for stmt in stmts { if (stmt_accum_unsafe_for(stmt, name, borrowable, str_fresh_ret)) { return true; } }
    return false;
}
function stmt_accum_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], str_fresh_ret: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return expr_unsafe_for(v.init, name, borrowable, []); },
        ast.StmtReturn(r) => {
            // A bare `return name` MOVES the final builder value out to the caller —
            // safe, and kept from the exit sweep by returned_moved_arr_slots (the
            // intermediates were already freed by each consume-rebind). Any other
            // returned expression must not otherwise leak name.
            match (r.value) {
                ast.ExprIdent(_) => { return false; },
                _ => { return expr_unsafe_for(r.value, name, borrowable, []); }
            }
        },
        ast.StmtExpr(e) => { return expr_unsafe_for(e.value, name, borrowable, []); },
        ast.StmtAssign(a) => {
            if (a.target == name) {
                // A consume-rebind of the accumulator: safe iff the new value is a
                // FRESH producer (so `name` owns a fresh box afterwards, never an
                // alias) that borrow-consumes `name`. Any other reassignment of
                // `name` is unsafe (excludes the accumulator).
                if (str_accum_value_is_fresh(a.value, str_fresh_ret) && str_accum_reassign_ok(a.value, name, borrowable)) { return false; }
                return true;
            }
            return expr_unsafe_for(a.value, name, borrowable, []);
        },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, [])) { return true; }
            return str_accum_unsafe_for(f.then_body, name, borrowable, str_fresh_ret) || str_accum_unsafe_for(f.else_body, name, borrowable, str_fresh_ret);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, [])) { return true; }
            return str_accum_unsafe_for(w.body, name, borrowable, str_fresh_ret);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, []); }
            }
            if (iter_unsafe) { return true; }
            return str_accum_unsafe_for(fo.body, name, borrowable, str_fresh_ret);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, [])) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) { return true; }
                if (str_accum_unsafe_for(arm.body, name, borrowable, str_fresh_ret)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// collect_str_accumulator_names: locals initialised `var s [: string] =
// <literal or fresh>` that ARE reassigned (candidate accumulators). No `: string`
// annotation is required — the TYPE gate is applied by slot_is_reclaimable_str's
// `is_str` at the reclaim site (set from the type-aware expr_is_str), so an
// un-annotated int accumulator `var n = a + b; n = n + i` (whose init matches the
// concat SHAPE but is not is_str) is credited yet never reclaimed. That the init is
// a literal or fresh producer, and every reassignment is a valid consume-rebind of
// s that never escapes, is proven by str_accum_unsafe_for at the crediting site.
function collect_str_accumulator_names(stmts: ast.Stmt[], reassigned: string[], str_fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (util.index_of_str(reassigned, v.name) >= 0) {
                    var init_ok: boolean = str_accum_value_is_fresh(v.init, str_fresh_ret);
                    match (v.init) { ast.ExprString(_) => { init_ok = true; }, _ => {} }
                    if (init_ok) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                }
            },
            ast.StmtIf(f) => { a = collect_str_accumulator_names(f.then_body, reassigned, str_fresh_ret, a); a = collect_str_accumulator_names(f.else_body, reassigned, str_fresh_ret, a); },
            ast.StmtWhile(w) => { a = collect_str_accumulator_names(w.body, reassigned, str_fresh_ret, a); },
            ast.StmtFor(fo) => { a = collect_str_accumulator_names(fo.body, reassigned, str_fresh_ret, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_str_accumulator_names(m.arms[ai].body, reassigned, str_fresh_ret, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// --- fresh-string-return-call reclaim (#2649) ---------------------------------
//
// A `var r = f(..)` whose callee f ALWAYS returns a freshly-allocated string: r
// solely owns the box the callee moved out, so reclaiming r at scope exit (and per
// loop-rebind) closes the caller-side leak that survives the returned-builder
// move-on-return (whose freed intermediates live inside f; its final was moved to
// the caller and leaked here until now).

// body_has_nonfresh_str_return_reg: any return whose value is NOT a fresh string
// producer (str_local_binding_is_fresh — a concat, a string method, or a named
// producer). A bare `return ident` (an accumulator move-out) is conservatively
// NOT admitted: proving that ident is a sole-owned local needs the per-callee
// accumulator analysis, a follow-up. A `return param` / `return field` / `return
// "lit"` is likewise not fresh (may alias / is static).
// str_return_is_fresh: the RETURN-position freshness test, which is
// str_local_binding_is_fresh plus a bare string LITERAL.
//
// A literal belongs here for the reason #6582/#6590 established for a
// literal-INITIALISED local: `const_str` allocates a fresh box per evaluation
// (the DATA is .rodata, which __fern_str_free's heap-base guard skips; the box
// is not), so `return "even"` hands the caller a box it solely owns — exactly
// what str_fresh_ret_fns_of needs to prove.
//
// It is a SEPARATE predicate rather than a widening of
// str_local_binding_is_fresh for the reason #6590 records: that one has ~20
// callers driving the accumulator consume-rebind and concat-temp analyses, and
// folding the literal in there made `s = "reset"` read as a fresh rebind and
// credited an accumulator its own gate pins as un-reclaimable. Return position
// has no such consumer — a return value is never rebound.
// str_call_ret_is_fresh_reg: `f(..)` where `f` is already proven to return a
// freshly-allocated string on every path. `reg` is str_fresh_ret_fns_of's own
// accumulator, so this is the transitive step its fixpoint is for: a stdlib
// wrapper like `(s: string) to_upper() { return unicode.to_upper(s); }` returns
// nothing but a fresh string, and refusing it cost the consuming site its
// reclaim (43 B/round on `base.to_upper().len()`). Names are the MANGLED
// whole-program ones on both sides — the registry stores each func's name and the
// callee reaches here as a plain ident (`unicode__to_upper`), the same spelling
// the emitted `__fn_` symbol carries.
function str_call_ret_is_fresh_reg(e: ast.Expr, reg: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(reg, cid.name) >= 0; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// str_local_is_fresh_ret: `return out` where `out` is a LOCAL this body built
// out of nothing but fresh pieces. That is the shape every string builder in the
// stdlib ends with — `var out = ""` then `out = out + …` in a loop — and
// refusing it is what stopped the transitive chase at the leaf:
// `string.to_upper` -> `unicode.to_upper` -> `_map_upper`, which returns exactly
// this.
//
// Positive evidence only, and the local must be INVISIBLE outside its own
// construction: a declaration whose init is fresh, assignments whose values are
// fresh (`out + x` is a concat, so the self-reference is fine), and NO other
// appearance anywhere in the body. That last clause is what keeps the caller's
// release sound — a local also stored into a struct, passed to a call, or
// captured has another owner, and the returned pointer would be an alias rather
// than a handover. A parameter never qualifies: it has no declaration here.
function str_local_is_fresh_ret(stmts: ast.Stmt[], name: string, reg: string[], params: ast.ParamDecl[]): boolean {
    if (name.len() == 0) { return false; }
    if (!strloc_declared_fresh(stmts, name, reg, stmts, params)) { return false; }
    return !strloc_escapes(stmts, name, reg, stmts, params);
}

function strloc_declared_fresh(stmts: ast.Stmt[], name: string, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return str_return_is_fresh_reg(v.init, reg, body, params); } },
            _ => {}
        }
    }
    return false;
}

// strloc_escapes: `name` appears somewhere other than its own declaration, an
// assignment TO it whose value is fresh, and a bare `return name`.
function strloc_escapes(stmts: ast.Stmt[], name: string, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name != name && expr_mentions_name(v.init, name)) { return true; }
            },
            ast.StmtAssign(a) => {
                // `target` is a NAME, so a compound target (`o.f`, `xs[i]`) spells
                // the base name here too — any of those touching `name` is an
                // escape, and only the plain self-assign is credited.
                if (a.target == name) {
                    if (!str_return_is_fresh_reg(a.value, reg, body, params)) { return true; }
                } else if (expr_mentions_name(a.value, name)) { return true; }
            },
            ast.StmtReturn(r) => {
                var bare: boolean = false;
                match (r.value) { ast.ExprIdent(rid) => { bare = rid.name == name; }, _ => {} }
                if (!bare && expr_mentions_name(r.value, name)) { return true; }
            },
            ast.StmtExpr(e) => { if (expr_mentions_name(e.value, name)) { return true; } },
            ast.StmtIf(f) => {
                if (expr_mentions_name(f.cond, name)) { return true; }
                if (strloc_escapes(f.then_body, name, reg, body, params) || strloc_escapes(f.else_body, name, reg, body, params)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (expr_mentions_name(w.cond, name)) { return true; }
                if (strloc_escapes(w.body, name, reg, body, params)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (expr_mentions_name(fo.iter, name)) { return true; }
                if (strloc_escapes(fo.body, name, reg, body, params)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (expr_mentions_name(m.scrutinee, name)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && expr_mentions_name(arm.guard, name)) { return true; }
                    if (strloc_escapes(arm.body, name, reg, body, params)) { return true; }
                }
            },
            _ => {}
        }
    }
    return false;
}

// tostring_recv_is_scalar_param is the state-free twin of tostring_recv_is_scalar,
// for the whole-program fresh-ret registry: str_fresh_ret_fns_of walks FuncDecls
// with no LowerState, so a receiver is resolved against the callee's DECLARED
// params instead of its slots. Only a provably scalar receiver admits — a struct
// / enum / dyn `to_string` (user-written or @derive) may return an ALIAS of a
// live field, which is the same reason tostring_recv_is_scalar gates on it.
// A receiver that is not one of the callee's params answers false: its type is
// not in the signature, and an unregistered function merely leaks.
// trim_recv_is_string_param: the receiver of a `.trim()` is provably a STRING
// — a param annotated `string`, or a callee local declared `var s: string = …`
// with exactly one declaration. The return-side twin of trim_str_init's
// receiver-type test: a user method named `trim` on another type may return a
// field alias, so a return `x.trim()` is the fresh builtin copy (#7393) only
// when the receiver's string-ness is proven, not assumed from the name.
function trim_recv_is_string_param(e: ast.Expr, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    match (e) {
        ast.ExprIdent(id) => {
            var i: i32 = 0;
            while (i < params.len()) {
                if (params[i].name == id.name) { return params[i].type_name == "string"; }
                i = i + 1;
            }
            if (local_decl_count(body, id.name) != 1) { return false; }
            return decl_string_local(body, id.name);
        },
        _ => {}
    }
    return false;
}

function tostring_recv_is_scalar_param(e: ast.Expr, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    match (e) {
        ast.ExprNumber(_) => { return true; },
        ast.ExprIdent(id) => {
            var i: i32 = 0;
            while (i < params.len()) {
                if (params[i].name == id.name) { return is_scalar_type_name(params[i].type_name); }
                i = i + 1;
            }
            // Not a param: a callee LOCAL declared `var v: <scalar> = …` proves
            // the same thing the param's annotation does. Without this a helper
            // that computes before formatting — `var v: i32 = n * 2; return
            // v.to_string();` — never entered the registry, where the
            // param-receiver spelling of the same helper did, and every caller's
            // binding leaked its result at frees=0.
            return decl_scalar_local(body, id.name);
        },
        _ => {}
    }
    return false;
}

// decl_scalar_local: `name` is declared in `body` and EVERY declaration of it
// annotates a flat scalar type. Every one, because a nested block may shadow the
// name with a pointer-shaped local, and this scan has no scopes; requiring all of
// them keeps a shadow from licensing the outer name. An un-annotated `var`
// answers false — the type is what carries the proof here, and refusing costs a
// leak where guessing would cost an over-release.
// decl_string_local: the single `var <name>: string = …` declaration test the
// trim return arm pairs with local_decl_count == 1 — one declaration anywhere,
// annotated string. The count gate is what makes the flat verdict safe: with
// exactly one declaration there is no shadowed sibling to mis-attribute.
function decl_string_local(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return v.type_name == "string"; } },
            ast.StmtIf(f) => {
                if (decl_string_local(f.then_body, name)) { return true; }
                if (decl_string_local(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (decl_string_local(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (decl_string_local(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (decl_string_local(arm.body, name)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

function decl_scalar_local(stmts: ast.Stmt[], name: string): boolean {
    var found: boolean = false;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (!is_scalar_type_name(v.type_name)) { return false; }
                    found = true;
                }
            },
            ast.StmtIf(f) => {
                if (decl_scalar_local_bad(f.then_body, name) || decl_scalar_local_bad(f.else_body, name)) { return false; }
                if (decl_scalar_local(f.then_body, name) || decl_scalar_local(f.else_body, name)) { found = true; }
            },
            ast.StmtWhile(w) => {
                if (decl_scalar_local_bad(w.body, name)) { return false; }
                if (decl_scalar_local(w.body, name)) { found = true; }
            },
            ast.StmtFor(fo) => {
                // A `for NAME in …` binder is not a `var` and carries no
                // annotation, so it cannot be proved scalar here.
                if (fo.var_name == name) { return false; }
                if (decl_scalar_local_bad(fo.body, name)) { return false; }
                if (decl_scalar_local(fo.body, name)) { found = true; }
            },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (match_arm_binds_name(arm, name)) { return false; }
                    if (decl_scalar_local_bad(arm.body, name)) { return false; }
                    if (decl_scalar_local(arm.body, name)) { found = true; }
                }
            },
            _ => {}
        }
    }
    return found;
}

// decl_scalar_local_bad: `name` is declared somewhere in `stmts` with a
// NON-scalar annotation. The refusing half of the pair — decl_scalar_local
// answers "every declaration is scalar", which needs both a witness and the
// absence of a counter-example, and the two recursions cannot be folded into one
// boolean without losing which of the two it is reporting.
function decl_scalar_local_bad(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name && !is_scalar_type_name(v.type_name)) { return true; } },
            ast.StmtIf(f) => { if (decl_scalar_local_bad(f.then_body, name) || decl_scalar_local_bad(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (decl_scalar_local_bad(w.body, name)) { return true; } },
            ast.StmtFor(fo) => {
                if (fo.var_name == name) { return true; }
                if (decl_scalar_local_bad(fo.body, name)) { return true; }
            },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (match_arm_binds_name(arm, name)) { return true; }
                    if (decl_scalar_local_bad(arm.body, name)) { return true; }
                }
            },
            _ => {}
        }
    }
    return false;
}

// match_arm_binds_name: the arm's pattern binds `name`. Such a binding has no
// annotation to read, so it can never be proved scalar and must refuse.
function match_arm_binds_name(arm: ast.MatchArm, name: string): boolean {
    match (arm.pattern) {
        ast.PatVariant(pv) => { return pv.binding == name; },
        _ => { return false; }
    }
    return false;
}

function str_return_is_fresh_reg_in(e: ast.Expr, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    if (str_return_is_fresh_reg(e, reg, body, params)) { return true; }
    match (e) {
        ast.ExprIdent(id) => { return str_local_is_fresh_ret(body, id.name, reg, params); },
        _ => {}
    }
    return false;
}

function str_return_is_fresh_reg(e: ast.Expr, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    if (str_return_is_fresh(e, body, params)) { return true; }
    return str_call_ret_is_fresh_reg(e, reg);
}

function body_has_nonfresh_str_return_reg(stmts: ast.Stmt[], reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!str_return_is_fresh_reg_in(r.value, reg, body, params)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonfresh_str_return_reg(f.then_body, reg, body, params) || body_has_nonfresh_str_return_reg(f.else_body, reg, body, params)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_str_return_reg(w.body, reg, body, params)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_str_return_reg(fo.body, reg, body, params)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_str_return_reg(m.arms[a].body, reg, body, params)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

function body_has_nonfreshrecv_str_return_reg(stmts: ast.Stmt[], recv: string, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var ok: boolean = str_return_is_fresh_reg_in(r.value, reg, body, params);
                if (!ok) {
                    match (r.value) {
                        ast.ExprIdent(rid) => { ok = rid.name == recv; },
                        // `slice_unchecked(recv, a, b)` is a kind-102 view box
                        // over the receiver's bytes, released the same way by the
                        // consuming site. `recv[a:b]` cannot appear here: it is an
                        // `Option[str]`, which no `string`-returning function can
                        // return (#5634).
                        ast.ExprCall(rcall) => {
                            match (rcall.callee) {
                                ast.ExprIdent(rcid) => {
                                    if (rcid.name == "slice_unchecked" && rcall.args.len() == 3) {
                                        match (rcall.args[0]) {
                                            ast.ExprIdent(raid) => { ok = raid.name == recv; },
                                            _ => {}
                                        }
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
                if (!ok) { return true; }
            },
            ast.StmtIf(f) => { if (body_has_nonfreshrecv_str_return_reg(f.then_body, recv, reg, body, params) || body_has_nonfreshrecv_str_return_reg(f.else_body, recv, reg, body, params)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfreshrecv_str_return_reg(w.body, recv, reg, body, params)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfreshrecv_str_return_reg(fo.body, recv, reg, body, params)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfreshrecv_str_return_reg(m.arms[a].body, recv, reg, body, params)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

function str_return_is_fresh(e: ast.Expr, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
    match (e) {
        ast.ExprString(_) => { return true; },
        // `n.to_string()` on a provably SCALAR receiver is the builtin
        // decimal-text producer — always a fresh box. is_fresh_str_temp has
        // credited it since #4353 and its comment names this predicate as the
        // one that missed it; the miss is why a `f(i) { return i.to_string(); }`
        // helper never entered the fresh-ret registry and every caller's binding
        // leaked its result.
        ast.ExprCall(c) => {
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprFieldAccess(fa) => {
                        if (fa.field == "to_string" && tostring_recv_is_scalar_param(fa.obj, body, params)) { return true; }
                        // `.trim()` on a proven-string receiver is the builtin
                        // owned copy (#7393); a name-only admission would reach
                        // user methods that alias (the str-trim-user-method pin).
                        if (fa.field == "trim" && trim_recv_is_string_param(fa.obj, body, params)) { return true; }
                    },
                    _ => {}
                }
            }
            return str_local_binding_is_fresh(e);
        },
        _ => { return str_local_binding_is_fresh(e); }
    }
    return false;
}
// str_fresh_ret_fns_of: bare NAMES of FREE functions (no receiver) whose return is
// ALWAYS a freshly-allocated string — so `var r = f(..)` owns a fresh box, never an
// alias of a borrowed arg / field / literal. Only free functions: a method key
// would need the receiver type the string binding can't supply (is_fresh_ret_binding
// keys a method on recv_type, empty here).
// body_has_nonfreshrecv_str_return_reg: any return whose value is none of a fresh
// string producer, the bare RECEIVER ident, or a direct SLICE OF THE RECEIVER.
// It is body_has_nonfresh_str_return_reg widened by the two shapes a borrowing
// string method is built from: the identity path `if (n <= 0) { return s; }`
// and the view path `return s[n:sLen]`.
//
// A slice is not fresh — on the register backends it is a 24-byte rc-IMMORTAL
// box over the receiver's own bytes — so it earns no place in
// str_return_is_fresh. What makes it admissible HERE is that the consuming site
// releases such a result through __fern_str_view_free, which returns the view
// BOX to the freelist and never touches the shared data. The slice must be a
// direct return expression over the receiver ident: a slice of a callee LOCAL
// is a view of a buffer that local's own sweep frees, and a slice bound to a
// name first could have been stored somewhere else on the way out.

// The walk is a LEAST FIXPOINT over the bare-name half, for the same reason
// param_counted_of's is: a function whose returns are all calls cannot be judged
// until those callees are, and the stdlib stacks them three deep
// (`string.to_upper` -> `unicode.to_upper` -> `_ascii_fold` / `_map_upper`).
// Starting empty and only ever ADDING keeps it monotone, so it settles on the
// grounded fixpoint and an ungrounded mutual-recursion cycle stays OUT, which is
// the conservative direction: a missing name costs a leak, never an
// over-release. Rounds are bounded — the chains are shallow and the bound is a
// backstop, not the operating point.
pub function str_fresh_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var reg: string[] = [];
    var round: i32 = 0;
    while (round < 8) {
        var next: string[] = str_fresh_ret_fns_round(funcs, reg);
        if (next.len() == reg.len()) { return next; }
        reg = next;
        round = round + 1;
    }
    return reg;
}

function str_fresh_ret_fns_round(funcs: parser.FuncDecl[], reg: string[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type == "string" && fn.receiver_type.len() == 0
                && body_has_return(fn.body) && !body_has_nonfresh_str_return_reg(fn.body, reg, fn.body, fn.params)) {
            out = out.append(fn.name);
        }
        // "SFRRECV:<Recv>.<method>" — a string-shaped METHOD whose every return
        // is fresh, the RECEIVER itself, or a view of the receiver (#6544). That
        // is the shape a borrowing string method actually has:
        // `(s: string) drop(n): str` returns `""`, `s` unchanged, or the slice
        // `s[n:sLen]`.
        //
        // Freshness alone cannot admit these, and native's route is not open
        // either: it reclaims an identity return through an is_unique gate that
        // rests on a return-transfer inc the self-host emits for array params
        // only — and adding that inc UNPAIRED measures strictly worse (§9,
        // 2026-08-17). What this key buys instead is a runtime discriminator
        // that needs no inc at all: a fresh box is never the receiver's pointer
        // and an identity return always is, so the consuming site frees only
        // when the two differ.
        //
        // A bare `str` return spelling never reaches here: parse_type_name
        // erases it to "string" outside `-fmt`, so both spellings key the same.
        // Rides the str_fresh_ret_fns list under a prefix (the "ARRF:"
        // convention — ':' can never appear in an identifier), so the bare-name
        // membership checks cannot match it and no registry field is added.
        if (fn.receiver_type.len() > 0 && fn.receiver_name.len() > 0
                && fn.ret_type == "string"
                && body_has_return(fn.body)
                && !body_has_nonfreshrecv_str_return_reg(fn.body, fn.receiver_name, reg, fn.body, fn.params)) {
            out = out.append("SFRRECV:" + util.base_type_name(fn.receiver_type) + "." + fn.name);
        }
    }
    return sfrfresh_names_of(funcs, reg, out);
}

// "SFRFRESHNAME:<method>" — the STRICT half of SFRRECV. SFRRECV admits a method
// that returns its RECEIVER or a view of it, which a consuming site sorts out
// with a pointer compare against the chain root — in binding position as well as
// receiver position (sfrrecv_str_init). This key is for the consumers that have
// no root to compare against, so they may only take ownership of a result that is
// nobody's box but its own. It says every return is a freshly allocated one:
// `(s: string) to_owned(): string { return s + ""; }` qualifies, and `trim` /
// `replace` — both able to hand the receiver straight back — do not.
//
// Keyed by METHOD NAME rather than `<Recv>.<method>` because the consumer is an
// AST scan with no types: a `var t: string = <expr>.m()` cannot say what `<expr>`
// is. A name is therefore admitted only when every STRING-RETURNING declaration
// of it is strictly fresh, so no receiver can reach a weaker one. A name that
// also spells a string BUILTIN is refused outright — `trim` and `replace` lower
// to ops these declarations never see, and a user type declaring a fresh `trim`
// must not license the builtin's view.
function sfrfresh_names_of(funcs: parser.FuncDecl[], reg: string[], acc: string[]): string[] {
    var cand: string[] = [];
    var bad: string[] = [];
    for fn in funcs {
        // A declaration that does not return `string` is not a hazard: the
        // binding this key serves is string-typed, so the checker cannot have
        // resolved it to one. `(c: char) to_upper(): char` sits beside
        // `(s: string) to_upper(): string` in the stdlib, and counting it would
        // cost the string method its credit for a call it can never receive.
        if (fn.receiver_type.len() > 0 && fn.receiver_name.len() > 0
                && fn.ret_type == "string") {
            if (body_has_return(fn.body)
                    && !body_has_nonfresh_str_return_reg(fn.body, reg, fn.body, fn.params)
                    && !is_str_builtin_method(fn.name)) {
                cand = push_str_unique(cand, fn.name);
            } else {
                bad = push_str_unique(bad, fn.name);
            }
        }
    }
    var out: string[] = acc;
    var c: i32 = 0;
    while (c < cand.len()) {
        if (util.index_of_str(bad, cand[c]) < 0) { out = out.append("SFRFRESHNAME:" + cand[c]); }
        c = c + 1;
    }
    return out;
}
// tuple_return_is_fresh: the return value is a DIRECT, non-empty tuple
// LITERAL — `return (k, k + 1)` — so the box is constructed in return
// position (tuple_make → fresh rc-headered __fern_arr_box, never bound in
// the callee, so its sweep can't touch it). Element SHAPES don't matter
// here: the caller-side reclaim is the "TUP:" class's SHALLOW box dec,
// which never reads elements — an element that computed to a heap pointer
// (a string ident, a nested literal) simply stays leak-mode, exactly the
// scalar-tuple-literal local contract. (Unlike tuple_lit_is_fresh_scalar,
// whose Number/Bool/Ident element bound exists to keep the LITERAL-local
// collector conservative, box freshness is the only requirement here.)
function tuple_return_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprTuple(tl) => { return tl.elements.len() > 0; },
        _ => { return false; }
    }
    return false;
}

// body_has_nonfresh_tuple_return: any return whose value is NOT a direct
// tuple literal (tuple_return_is_fresh) or a bare `return t` of a
// FRAME-FRESH tuple local (tuple_ret_local_is_frame_fresh — declared once
// from a direct tuple literal, never reassigned, escaping only through the
// return itself, so the caller receives the sole reference exactly as it
// would from a return-position literal). Any other return declines the
// whole function.
function body_has_nonfresh_tuple_return(stmts: ast.Stmt[], body: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (!tuple_return_is_fresh(r.value)) {
                    var lret_ok: boolean = false;
                    match (r.value) {
                        ast.ExprIdent(rid) => { lret_ok = tuple_ret_local_is_frame_fresh(body, rid.name); },
                        _ => {}
                    }
                    if (!lret_ok) { return true; }
                }
            },
            ast.StmtIf(f) => { if (body_has_nonfresh_tuple_return(f.then_body, body) || body_has_nonfresh_tuple_return(f.else_body, body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_tuple_return(w.body, body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_tuple_return(fo.body, body)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_tuple_return(m.arms[a].body, body)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// tuple_ret_local_is_frame_fresh: `name` is a tuple local the function may
// hand to the caller as an owned box — declared exactly once, from a DIRECT
// tuple literal (the same fresh-box proof as a return-position literal),
// never reassigned, and touched by nothing but reads, payload-confined
// alias binds, and the bare return itself. The alias forgiveness is the
// #7667 idiom one mechanism over: rctuple_param_alias_bind_sites vets each
// `var a = name` through the rc-tuple payload scan on the ALIAS's own name
// (empty registries — any call-arg use refuses), so a dead-ended reader
// alias no longer sinks the admission while an alias that hands a payload
// out, chains, or is itself returned still does. The frame's second
// reference dies with the frame; every admitted return path leaves the
// caller owning exactly one reference either way. The tuple sibling of
// struct_ret_local_is_frame_fresh (#7343) and of "ARROWN:"'s moved-literal
// arm.
function tuple_ret_local_is_frame_fresh(body: ast.Stmt[], name: string): boolean {
    if (local_decl_count(body, name) != 1) { return false; }
    if (util.index_of_str(body_assign_targets(body), name) >= 0) { return false; }
    if (tuple_ret_local_init_shape(body, name) == "") { return false; }
    var no_structs: parser.StructDecl[] = [];
    var no_strs: string[] = [];
    var tal: string[] = no_strs;
    var tty: string = rctuple_type_of_decl(body, name);
    if (tty != "") { tal = rctuple_param_alias_bind_sites(body, name, tty, no_structs, body, no_strs); }
    return !body_unsafe_for_alias_ret_ok(body, name, no_strs, no_strs, tal, true);
}

// tuple_ret_local_names_of: the frame-fresh tuple locals this body hands to
// the caller through a bare return — the names the credit gates treat with
// the ret-forgiving walker.
pub function tuple_ret_local_names_of(body: ast.Stmt[]): string[] {
    return tuple_ret_local_scan(body, body, []);
}
function tuple_ret_local_scan(stmts: ast.Stmt[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprIdent(rid) => {
                        if (tuple_ret_local_is_frame_fresh(body, rid.name)) { a = push_str_unique(a, rid.name); }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { a = tuple_ret_local_scan(f.then_body, body, a); a = tuple_ret_local_scan(f.else_body, body, a); },
            ast.StmtWhile(w) => { a = tuple_ret_local_scan(w.body, body, a); },
            ast.StmtFor(fo) => { a = tuple_ret_local_scan(fo.body, body, a); },
            ast.StmtMatch(m) => { var mi: i32 = 0; while (mi < m.arms.len()) { a = tuple_ret_local_scan(m.arms[mi].body, body, a); mi = mi + 1; } },
            _ => {}
        }
    }
    return a;
}

// tuple_ret_flags_of: the "ARRF:<name>|<flags>" entry's flags for `name` in
// the shared fresh-ret registry — "" when absent.
pub function tuple_ret_flags_of(entries: string[], name: string): string {
    var want: string = "ARRF:" + name + "|";
    var i: i32 = 0;
    while (i < entries.len()) {
        var e: string = entries[i];
        if (e.len() > want.len() && slice_unchecked(e, 0, want.len()) == want) { return slice_unchecked(e, want.len(), e.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// tuple_ret_local_init_shape: the collect_tuple_ret_shapes-style shape string
// of `name`'s declaration literal ('a' for a direct array element, 's'
// otherwise) — "" when the declaration is missing or not a direct tuple
// literal. Feeds both the frame-fresh admission and the ARRF: flags for a
// `return t` path.
function tuple_ret_local_init_shape(stmts: ast.Stmt[], name: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprTuple(tl) => {
                            var sh: string = "";
                            var k: i32 = 0;
                            while (k < tl.elements.len()) {
                                match (tl.elements[k]) {
                                    ast.ExprArray(_) => { sh = sh + "a"; },
                                    _ => { sh = sh + "s"; }
                                }
                                k = k + 1;
                            }
                            return sh;
                        },
                        _ => { return ""; }
                    }
                }
            },
            ast.StmtIf(f) => {
                var t1: string = tuple_ret_local_init_shape(f.then_body, name);
                if (t1 != "") { return t1; }
                var t2: string = tuple_ret_local_init_shape(f.else_body, name);
                if (t2 != "") { return t2; }
            },
            ast.StmtWhile(w) => { var tw: string = tuple_ret_local_init_shape(w.body, name); if (tw != "") { return tw; } },
            ast.StmtFor(fo) => { var tf: string = tuple_ret_local_init_shape(fo.body, name); if (tf != "") { return tf; } },
            ast.StmtMatch(m) => {
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    var tm: string = tuple_ret_local_init_shape(m.arms[mi].body, name);
                    if (tm != "") { return tm; }
                    mi = mi + 1;
                }
            },
            _ => {}
        }
    }
    return "";
}

// tuple_fresh_ret_fns_of: bare NAMES of FREE functions whose return type is a
// tuple and whose EVERY return is a direct scalar-literal tuple (`return (k,
// k + 1)`) — so `var t = f(..)` owns a fresh, sole-owner rc-headered box
// (tuple_make constructs it in return position; the callee never binds it, so
// its sweep can't touch it). The caller-side reclaim is the SHALLOW box dec
// the "TUP:" class already emits, which never reads elements — an ident
// element that happens to be a pointer stays leak-mode, exactly the
// scalar-tuple LITERAL local contract (tuple_lit_is_fresh_scalar's header).
// The tuple sibling of str_fresh_ret_fns_of; closes the #4357 tuple-returning
// dead-intermediate leak (`var t = mk(k); … t.0 …` leaked one box per call —
// native reclaims the shape).
//
// The list is really the shared FRESH-RET registry: it also carries the
// "ARRF:<name>|<flags>" tuple deep-drop entries and the "MAPF:<name>"
// map-builder entries (map_fresh_ret_fns_of) — ':' can't appear in an
// identifier, so prefixed entries never collide with the bare-name
// membership checks, and every backend that threads this one list into
// lower_func gets all three credits.
pub function tuple_fresh_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.ret_type.len() > 0 && fn.ret_type[0] == b'('
                && fn.receiver_type.len() == 0
                && body_has_return(fn.body) && !body_has_nonfresh_tuple_return(fn.body, fn.body)) {
            out = out.append(fn.name);
            // #4365 (discarded rc-field tuple temps): also record the per-position
            // deep-drop flags as an "ARRF:<name>|<flags>" entry riding the same
            // list (a ':' can't appear in an identifier, so these never collide
            // with the bare-name membership checks above). lower_func re-seeds
            // them as "TUPRET:" reclaim entries for callees the body DISCARDS,
            // and the StmtExpr lowering deep-drops flagged positions.
            var arrf: string = tuple_ret_arrfree_flags(fn);
            if (arrf.len() > 0) { out = out.append("ARRF:" + fn.name + "|" + arrf); }
        }
    }
    var mf: string[] = map_fresh_ret_fns_of(funcs);
    var mi: i32 = 0;
    while (mi < mf.len()) { out = out.append(mf[mi]); mi = mi + 1; }
    return out;
}

// map_builder_scalar_kind: `t` is a by-value scalar Map key/value type a
// shallow __fern_map_free covers completely (the column buffers hold no
// pointers, so freeing them frees everything). i64/u64/f64 are excluded —
// wide keys ride cell-pointer boxing on some paths — as is everything
// pointer-shaped.
function map_builder_scalar_kind(t: string): boolean {
    return t == "i32" || t == "u32" || t == "boolean";
}

// map_builder_body_ok: `fn`'s body is the STRICT cow-threaded map builder —
// exactly one annotated `var <m>: Map[..] = map_new(..)` declaration, and
// every other statement is either a sanctioned self-cow reassign of <m>
// (is_map_selfcow_assign), a bare `return <m>;`, or mentions <m> nowhere at
// all AND contains no nested return (astwalk.collect_idents_stmt +
// body_has_return — so ANY other read, alias, call-arg, control-flow-nested
// use, hidden `return p;`, or a param named <m> rejects). This is what makes
// the caller-side fresh credit sound: the returned box was map_new'd inside
// fn, only ever cow-mutated in place, and handed out exactly once.
function map_builder_body_ok(fn: parser.FuncDecl): boolean {
    // The single returned name: every return must be a bare ident, all the
    // same name.
    var m: string = "";
    var ri: i32 = 0;
    while (ri < fn.body.len()) {
        match (fn.body[ri]) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprIdent(rid) => {
                        if (m == "") { m = rid.name; }
                        else if (m != rid.name) { return false; }
                    },
                    _ => { return false; }
                }
            },
            _ => {}
        }
        ri = ri + 1;
    }
    if (m == "") { return false; }
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        if (fn.params[pi].name == m) { return false; }
        pi = pi + 1;
    }
    var decls: i32 = 0;
    var i: i32 = 0;
    while (i < fn.body.len()) {
        var st: ast.Stmt = fn.body[i];
        var handled: boolean = false;
        match (st) {
            ast.StmtVar(v) => {
                if (v.name == m) {
                    if (v.type_name.len() < 5 || slice_unchecked(v.type_name, 0, 4) != "Map[") { return false; }
                    if (!is_fresh_map_init(v.init)) { return false; }
                    decls = decls + 1;
                    if (decls > 1) { return false; }
                    handled = true;
                }
            },
            ast.StmtReturn(_) => { handled = true; },
            _ => {}
        }
        if (!handled && is_map_selfcow_assign(st, m)) { handled = true; }
        if (!handled) {
            // A NESTED return hides from the top-level return scan above and
            // could hand out a non-fresh box (`if (..) { return p; }`), so any
            // statement containing one disqualifies outright.
            var one: ast.Stmt[] = [st];
            if (body_has_return(one)) { return false; }
            var none: string[] = [];
            if (util.index_of_str(astwalk.collect_idents_stmt(st, none), m) >= 0) { return false; }
        }
        i = i + 1;
    }
    return decls == 1;
}

// map_fresh_ret_fns_of: "MAPF:<name>" entries for FREE functions returning a
// scalar-K/V Map whose body is the strict cow-threaded builder
// (map_builder_body_ok) — the map sibling of tuple_fresh_ret_fns_of, and the
// self-host twin of #5096's returnsNoParamEscape map admission. A caller's
// `var m: Map[..] = mk(i)` binding then earns the "MAP:" reclaim: the box is
// provably fresh + sole-owned, the columns hold only scalars, so the shallow
// __fern_map_free covers everything. Rides the tuple_fresh_ret_fns list (the
// "ARRF:" precedent — ':' never appears in an identifier, so the entries
// can't collide with bare-name membership checks); tuple_fresh_ret_fns_of
// appends these itself so every backend's one threaded list carries them.
function map_fresh_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() == 0
                && fn.ret_type.len() >= 5 && slice_unchecked(fn.ret_type, 0, 4) == "Map["
                && map_builder_scalar_kind(map_key_of(fn.ret_type))
                && map_builder_scalar_kind(map_value_of(fn.ret_type))
                && map_builder_body_ok(fn)) {
            out = out.append("MAPF:" + fn.name);
        }
    }
    return out;
}

// collect_tuple_ret_shapes: one shape string per admitted return in the body
// — 'a' at position k for a direct ExprArray element (a fresh buffer the
// returned box sole-owns), 's' for anything else. A bare `return t` of a
// frame-fresh local contributes the shape of t's DECLARATION literal (the
// same freshness proof, one binding removed). Feeds the ARRF: flags.
function collect_tuple_ret_shapes(stmts: ast.Stmt[], body: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprTuple(tl) => {
                        var sh: string = "";
                        var k: i32 = 0;
                        while (k < tl.elements.len()) {
                            match (tl.elements[k]) {
                                ast.ExprArray(_) => { sh = sh + "a"; },
                                _ => { sh = sh + "s"; }
                            }
                            k = k + 1;
                        }
                        a = a.append(sh);
                    },
                    ast.ExprIdent(rid) => {
                        if (tuple_ret_local_is_frame_fresh(body, rid.name)) {
                            a = a.append(tuple_ret_local_init_shape(body, rid.name));
                        }
                    },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { a = collect_tuple_ret_shapes(f.then_body, body, a); a = collect_tuple_ret_shapes(f.else_body, body, a); },
            ast.StmtWhile(w) => { a = collect_tuple_ret_shapes(w.body, body, a); },
            ast.StmtFor(fo) => { a = collect_tuple_ret_shapes(fo.body, body, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_tuple_ret_shapes(m.arms[ai].body, body, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// tag_is_scalar_elem_array: a single-level array of by-value scalars
// ("i32[]" / "u32[]" / "boolean[]" / "i64[]" / "u64[]" / "f64[]") — a buffer
// one rc-guarded dec fully reclaims (elements ride the freed buffer). A
// nested "[][]" or pointer-element array (string[]) is NOT (its elements
// would leak on a shallow free — those positions stay '0' / leak-mode).
function tag_is_scalar_elem_array(tag: string): boolean {
    var n: i32 = tag.len();
    if (n < 4 || slice_unchecked(tag, n - 2, n) != "[]") { return false; }
    var base: str = slice_unchecked(tag, 0, n - 2);
    return base == "i32" || base == "u32" || base == "boolean" || base == "i64" || base == "u64" || base == "f64";
}

// tuple_ret_arrfree_flags: the ARRF: per-position flags for a tuple-fresh-ret
// function — flag k is '1' iff EVERY return literal has a direct array literal
// at k (fresh, so the discarded box sole-owns it — an IDENT there in any
// return aliases a live local and keeps the position '0') AND the return-type
// annotation types k a scalar-element array. Any 8-byte SCALAR element (i64 /
// u64 / f64) declines the whole entry: op_tuple_get is offset-uniform, and a
// wide scalar would shift the later positions on wasm's 4-byte slots. Pointer
// elements (string / struct / nested tuple / Option) ride uniform slots, so
// they are safe as '0' (leak-mode) positions — only their own boxes leak,
// exactly today's floor.
function tuple_ret_arrfree_flags(fn: parser.FuncDecl): string {
    var shapes: string[] = collect_tuple_ret_shapes(fn.body, fn.body, []);
    if (shapes.len() == 0) { return ""; }
    var n: i32 = shapes[0].len();
    var si: i32 = 1;
    while (si < shapes.len()) { if (shapes[si].len() != n) { return ""; } si = si + 1; }
    if (n == 0) { return ""; }
    var flags: string = "";
    var k: i32 = 0;
    while (k < n) {
        var tag: string = tuple_type_elem_tag(fn.ret_type, k);
        if (tag == "" || tag == "i64" || tag == "u64" || tag == "f64" || tag == "f32") { return ""; }
        var all_arr: boolean = true;
        var sj: i32 = 0;
        while (sj < shapes.len()) { if (shapes[sj][k] != b'a') { all_arr = false; } sj = sj + 1; }
        if (all_arr && tag_is_scalar_elem_array(tag)) { flags = flags + "1"; }
        else { flags = flags + "0"; }
        k = k + 1;
    }
    return flags;
}

// body_declares_name: `name` is declared as a LOCAL anywhere in the body. The
// read reclaim refuses a call whose callee NAME is a local (it holds an unknown
// closure body, not the registered producer), and this credit has to refuse the
// same shape — otherwise the sweep would free a string no read ever retained.
// Over astwalk's binder walk rather than a hand-rolled one (#7253): that is the
// single definition of "what does this statement bind", it splits the
// comma-joined destructure and `for (k, v)` forms, and it reads match patterns —
// including `at_binding` and `extra_bindings`. The copy this replaces saw a
// `var` and a `for` binder only, so a payload binder or a destructure was a
// declaration it reported as absent, and every caller here uses it to VETO a
// name-keyed registry hit. A veto that does not fire credits a local that is not
// the registered producer, and the sweep then frees what no read retained.
function body_declares_name(stmts: ast.Stmt[], name: string): boolean {
    var bound: string[] = astwalk.collect_bound_stmts(stmts, []);
    return util.index_of_str(bound, name) >= 0;
}

// local_recv_method_key: "<Type>.<method>" for a `recv.m(..)` callee whose
// receiver is a LOCAL of `body`, else "". The LowerState-free twin of the key
// owned_fresh_call_callee builds with expr_struct_type, and the two have to
// agree: a key only this side accepts credits the binding a free the read never
// performed. So it makes that function's two refusals from the AST — the
// receiver is a bare local, and the callee names no declared FIELD of its type
// (a fn-typed field call names no method) — plus the one this side needs on its
// own: the local carries a type ANNOTATION and is declared exactly once, so
// that annotation IS the receiver's type rather than a shadowed sibling's. A
// param receiver resolves to neither and keeps today's leak.
function local_recv_method_key(callee: ast.Expr, body: ast.Stmt[], structs: parser.StructDecl[]): string {
    match (callee) {
        ast.ExprFieldAccess(mfa) => {
            match (mfa.obj) {
                ast.ExprIdent(rid) => {
                    if (local_decl_count(body, rid.name) != 1) { return ""; }
                    var rt: string = util.base_type_name(body_local_decl_type(body, rid.name));
                    if (rt.len() == 0) { return ""; }
                    if (decl_field_type(structs, rt, mfa.field) != "") { return ""; }
                    return rt + "." + mfa.field;
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// owned_container_read_str_binding: `init` reads a `string` OUT of a container
// the read reclaim releases at the read — `strs(i)[1]` (a "STRARR:" producer),
// `boxed(i).name` or `b.bump(t).name` (a "STRFLDF:" one, free function or
// method). Either way the destination receives the
// container's own single reference to that box, so it owns it: this is the third
// site of the pointer-half triple (#6491), and without it the read's retain / move
// would strand the extracted string exactly as the container used to strand.
function owned_container_read_str_binding(init: ast.Expr, body: ast.Stmt[], fresh_ret: string[], structs: parser.StructDecl[]): boolean {
    var callee: string = "";
    var kind: string = "";
    match (init) {
        ast.ExprIndex(ix) => { kind = "STRARR:"; match (ix.array) { ast.ExprCall(c) => { match (c.callee) { ast.ExprIdent(cid) => { callee = cid.name; }, _ => {} } }, _ => {} } },
        ast.ExprFieldAccess(fa) => { kind = "STRFLDF:"; match (fa.obj) { ast.ExprCall(c) => { match (c.callee) { ast.ExprIdent(cid) => { callee = cid.name; }, _ => { callee = local_recv_method_key(c.callee, body, structs); } } }, _ => {} } },
        _ => {}
    }
    if (callee.len() == 0) { return false; }
    if (body_declares_name(body, callee)) { return false; }
    return util.index_of_str(fresh_ret, kind + callee) >= 0;
}

// collect_owned_container_read_str_names: the `var s: string = <owned container
// read>` destinations. The `string` ANNOTATION is required — an unannotated
// binding leaves the slot's type to inference the analysis cannot see, and a
// mis-credit here frees a box the read never handed over.
function collect_owned_container_read_str_names(stmts: ast.Stmt[], body: ast.Stmt[], fresh_ret: string[], reassigned: string[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.type_name == "string" && util.index_of_str(reassigned, v.name) < 0
                        && owned_container_read_str_binding(v.init, body, fresh_ret, structs)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_owned_container_read_str_names(f.then_body, body, fresh_ret, reassigned, structs, a); a = collect_owned_container_read_str_names(f.else_body, body, fresh_ret, reassigned, structs, a); },
            ast.StmtWhile(w) => { a = collect_owned_container_read_str_names(w.body, body, fresh_ret, reassigned, structs, a); },
            ast.StmtFor(fo) => { a = collect_owned_container_read_str_names(fo.body, body, fresh_ret, reassigned, structs, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_owned_container_read_str_names(m.arms[ai].body, body, fresh_ret, reassigned, structs, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// collect_fresh_tuple_ret_call_names: tuple LOCALS bound from a tuple-fresh-ret
// free CALL (`var t = f(..)`, f in tup_fresh_ret) that are NOT reassigned. The
// escape gate (body_unsafe_for) is applied by reclaimable_names_of before
// crediting "TUP:" — the same shallow-box-free class as a scalar-tuple literal.
function collect_fresh_tuple_ret_call_names(stmts: ast.Stmt[], tup_fresh_ret: string[], reassigned: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (util.index_of_str(reassigned, v.name) < 0 && is_fresh_ret_binding(v.init, "", tup_fresh_ret)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_tuple_ret_call_names(f.then_body, tup_fresh_ret, reassigned, a); a = collect_fresh_tuple_ret_call_names(f.else_body, tup_fresh_ret, reassigned, a); },
            ast.StmtWhile(w) => { a = collect_fresh_tuple_ret_call_names(w.body, tup_fresh_ret, reassigned, a); },
            ast.StmtFor(fo) => { a = collect_fresh_tuple_ret_call_names(fo.body, tup_fresh_ret, reassigned, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_fresh_tuple_ret_call_names(m.arms[ai].body, tup_fresh_ret, reassigned, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// collect_fresh_str_ret_call_names: string LOCALS bound from a str-fresh-ret free
// CALL (`var r = f(..)`, f in str_fresh_ret) that are NOT reassigned. The escape
// gate (body_unsafe_for) is applied by reclaimable_names_of before crediting "STR:".
function collect_fresh_str_ret_call_names(stmts: ast.Stmt[], str_fresh_ret: string[], reassigned: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (util.index_of_str(reassigned, v.name) < 0 && is_fresh_ret_binding(v.init, "", str_fresh_ret)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_str_ret_call_names(f.then_body, str_fresh_ret, reassigned, a); a = collect_fresh_str_ret_call_names(f.else_body, str_fresh_ret, reassigned, a); },
            ast.StmtWhile(w) => { a = collect_fresh_str_ret_call_names(w.body, str_fresh_ret, reassigned, a); },
            ast.StmtFor(fo) => { a = collect_fresh_str_ret_call_names(fo.body, str_fresh_ret, reassigned, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_fresh_str_ret_call_names(m.arms[ai].body, str_fresh_ret, reassigned, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// collect_fresh_ret_call_names credits a struct LOCAL bound from a fresh-ret
// CALL (`var r: T = f(..)` / `var r: T = obj.m(..)`, f/m in fresh_ret) that is
// NOT reassigned — the DISCARDED fresh-ret-call local (#3457 follow-up). A
// reassigned fresh-ret local is the snapshot-LOCAL path's job (it move-rebinds
// + moves out via `return`); this is the orthogonal case where the result is
// READ (a field copy, `r.ops`) and then goes dead without escaping. Sound for
// the same reason the snapshot-LOCAL path is: an IR-lowered fresh-struct-return
// has every rc-array field properly counted — each is either a fresh literal
// (rc=1, owned) or an alias retained by the callee's struct-lit Perceus dup
// (rc≥2) — so a scope-end deep-drop (__struct_drop) is balanced, never a UAF.
// The escape gate (body_unsafe_for, applied by reclaimable_names_of) still
// rejects any r that is returned / stored / passed to a non-borrowable param.
function collect_fresh_ret_call_names(stmts: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], reassigned: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                // A fresh-ret-CALL struct local (`var t: P = f(i)`, f strict-fresh)
                // is reclaim-safe whether or not it carries an rc-array field: a
                // SCALAR-only struct box is freed by a shallow rc-dec (emit_arr_store
                // at loop-rebind / the exit sweep), an rc-field one by the deep
                // __field_reclaim / __struct_drop path. The former was previously
                // excluded by the struct_has_reclaim_array_field gate, so a scalar
                // `var t = mk(i)` LEAKED its box every iteration (#4357 follow-up).
                // The body_unsafe_for escape gate (applied by reclaimable_names_of)
                // still proves non-escape before any box is freed.
                if (v.type_name.len() > 0
                    && util.index_of_str(reassigned, v.name) < 0
                    && is_fresh_ret_binding(v.init, v.type_name, fresh_ret)
                    && decl_is_struct(structs, v.type_name) && decl_is_leaksafe(structs, v.type_name)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_ret_call_names(f.then_body, structs, fresh_ret, reassigned, a); a = collect_fresh_ret_call_names(f.else_body, structs, fresh_ret, reassigned, a); },
            ast.StmtWhile(w) => { a = collect_fresh_ret_call_names(w.body, structs, fresh_ret, reassigned, a); },
            ast.StmtFor(fo) => { a = collect_fresh_ret_call_names(fo.body, structs, fresh_ret, reassigned, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_fresh_ret_call_names(m.arms[ai].body, structs, fresh_ret, reassigned, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// reclaimable_names_of = fresh-bound struct names that never escape.
// is_fresh_map_init: an init producing a FRESH map value — a `map_new()` /
// `map_new_i32()` call, or a `Map { … }` literal (which desugars to
// `map_new[_i32](n).insert(k0,v0).insert(…)`, a `.insert()` method chain whose root
// is the map_new call). A bare-ident (`var m2 = m1`) or a map-returning call is NOT
// fresh here (an alias / an un-owned move), so it is left to leak — conservative.
function is_fresh_map_init(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return cid.name == "map_new" || cid.name == "map_new_i32"; },
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "insert") { return is_fresh_map_init(fa.obj); }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// collect_mapf_call_names: the BINDING-SITE keys of every `var m: Map[..] = mk(..)`
// where mk is in the "MAPF:" registry (map_fresh_ret_fns_of, riding the
// tuple_fresh_ret list) — the callee provably returns a fresh sole-owned
// scalar-column map, so the binding is as fresh as a local map_new. The
// annotation is required (it is what marks the slot's map type for get_or
// dispatch and the reclaim's key-kind selection). Recurses through nested
// blocks like collect_fresh_map_names.
function collect_mapf_call_names(stmts: ast.Stmt[], registry: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.type_name.len() >= 5 && slice_unchecked(v.type_name, 0, 4) == "Map[") {
                    match (v.init) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprIdent(cid) => {
                                    if (util.index_of_str(registry, "MAPF:" + cid.name) >= 0) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(iff) => { a = collect_mapf_call_names(iff.then_body, registry, a); a = collect_mapf_call_names(iff.else_body, registry, a); },
            ast.StmtWhile(w) => { a = collect_mapf_call_names(w.body, registry, a); },
            ast.StmtFor(f) => { a = collect_mapf_call_names(f.body, registry, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_mapf_call_names(arm.body, registry, a); }
            },
            _ => {}
        }
    }
    return a;
}

// collect_fresh_map_names gathers the BINDING-SITE key of every local bound from
// a fresh map init, recursing through nested blocks (the map sibling of
// collect_fresh_struct_names).
function collect_fresh_map_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_fresh_map_in_stmt(stmt, a); }
    return a;
}
function collect_fresh_map_in_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (is_fresh_map_init(v.init)) { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_fresh_map_names(iff.then_body, acc);
            return collect_fresh_map_names(iff.else_body, a);
        },
        ast.StmtWhile(w) => { return collect_fresh_map_names(w.body, acc); },
        ast.StmtFor(f) => { return collect_fresh_map_names(f.body, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_fresh_map_names(arm.body, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_fresh_map_in_stmt(d.action, acc); },
        _ => { return acc; },
    }
}

// --- #4353: string-VALUE column deep-release for a reclaimable map ------------
// A reclaimable map (fresh, non-escaping, non-aliased, non-iterated) declared
// `Map[K, string]` whose EVERY value is a fresh string is credited "MAPVS:", so
// emit_map_buffers_free routes it to __fern_map_free_vs (register backends free
// the vals column via __fern_str_arr_free — a rc==1-gated per-element string free
// — instead of the shallow arr_dec; wasm already deep-releases). SOUNDNESS: the
// register __fern_map_set stores a STRING value pointer with no rc-inc (only an
// aliased ARRAY value takes one — map_insert_value_retains), so the map owns no
// counted ref to this column — freeing a value is safe ONLY when the map is its
// sole owner, i.e. the value was FRESH at the set site (nothing else references it).
// The freshness predicate (str_local_binding_is_fresh) is purely SYNTACTIC (an
// int `a+b` matches too), so the declared `Map[K, string]` type gate is required
// to confirm the column really holds strings before freeing them as such. Keys
// deep-release the same way via "MAPKS:" / __fern_map_free_ks; non-fresh-column
// or unannotated maps stay on the shallow free (sound). The map's separate
// arr_push grow-leak is closed for snapshot-kind columns by map_owncols (#5335
// layer 0: i32/string K/V route grows through __fern_arr_push_owned); only
// flag-1 alias columns (i64/f64/struct/generic) keep the LOAD-BEARING leak.

// map_decl_type: the K or the V of the `var name: Map[K, V] = …` declaration of
// the map local `name`, found anywhere in `stmts` (nested if / while / for /
// match bodies included); "" if unannotated or not found. `want_key` picks the
// side — this was two functions differing only in which of map_key_of /
// map_value_of they called, recursion skeleton and all.
function map_decl_type(stmts: ast.Stmt[], name: string, want_key: boolean): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (want_key) { return map_key_of(v.type_name); }
                    return map_value_of(v.type_name);
                }
            },
            ast.StmtIf(f) => {
                var t1: string = map_decl_type(f.then_body, name, want_key);
                if (t1 != "") { return t1; }
                var t2: string = map_decl_type(f.else_body, name, want_key);
                if (t2 != "") { return t2; }
            },
            ast.StmtWhile(w) => { var t: string = map_decl_type(w.body, name, want_key); if (t != "") { return t; } },
            ast.StmtFor(fo) => { var t: string = map_decl_type(fo.body, name, want_key); if (t != "") { return t; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { var t: string = map_decl_type(arm.body, name, want_key); if (t != "") { return t; } }
            },
            _ => {}
        }
    }
    return "";
}

// map_insert_chain_arg_fresh: `e` is a `map_new[_i32]().insert(k,v)…` chain (the
// Map{…} literal desugar); every insert's arg at `argidx` (0=key, 1=value) must be
// a fresh string. The root map_new() carries no entry.
// map_arg_binding_is_fresh: the freshness test for a map column's inserted arg.
// `boxfresh` selects WHICH column kind is being proven. False asks the string
// question (str_local_binding_is_fresh: a concat / a fresh-allocating method /
// a registered producer). True asks the BOX question (#4353 item 3): an ARRAY
// or STRUCT literal, the only value forms that allocate a box nothing else
// names — a call result is refused because a callee may hand back a field or a
// param alias, and this predicate is purely syntactic.
function map_arg_binding_is_fresh(e: ast.Expr, boxfresh: boolean): boolean {
    if (!boxfresh) { return str_local_binding_is_fresh(e); }
    match (e) {
        ast.ExprArray(_) => { return true; },
        ast.ExprStructLit(sl) => { return !sl.has_base; },
        _ => { return false; },
    }
    return false;
}

function map_insert_chain_arg_fresh(e: ast.Expr, argidx: i32, boxfresh: boolean): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return cid.name == "map_new" || cid.name == "map_new_i32"; },
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "insert") {
                        if (c.args.len() < 2) { return false; }
                        if (!map_arg_binding_is_fresh(c.args[argidx], boxfresh)) { return false; }
                        return map_insert_chain_arg_fresh(fa.obj, argidx, boxfresh);
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// map_expr_root_ident: the base receiver ident of a `.set(…)/.insert(…)` chain
// (e.g. `m` for `m.set(a,b).set(c,d)`), or "" if the root isn't a bare ident.
function map_expr_root_ident(e: ast.Expr): string {
    match (e) {
        ast.ExprIdent(id) => { return id.name; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => { return map_expr_root_ident(fa.obj); },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// map_expr_sets_unfresh_arg: does `e` contain a `name.set(k,v)` / `name.insert(k,v)`
// (receiver-chain rooted at `name`) whose arg at `argidx` is NOT a fresh string?
function map_expr_sets_unfresh_arg(e: ast.Expr, name: string, argidx: i32, boxfresh: boolean): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if ((fa.field == "set" || fa.field == "insert") && map_expr_root_ident(fa.obj) == name) {
                        if (c.args.len() >= 2 && !map_arg_binding_is_fresh(c.args[argidx], boxfresh)) { return true; }
                    }
                    return map_expr_sets_unfresh_arg(fa.obj, name, argidx, boxfresh);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// map_no_unfresh_set_arg: no statement in `stmts` sets a non-fresh string at
// `argidx` on map `name` (recursing nested blocks). Reads (m.get/has/len) ignored.
function map_no_unfresh_set_arg(stmts: ast.Stmt[], name: string, argidx: i32, boxfresh: boolean): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtExpr(e) => { if (map_expr_sets_unfresh_arg(e.value, name, argidx, boxfresh)) { return false; } },
            ast.StmtVar(v) => { if (map_expr_sets_unfresh_arg(v.init, name, argidx, boxfresh)) { return false; } },
            ast.StmtAssign(a) => { if (map_expr_sets_unfresh_arg(a.value, name, argidx, boxfresh)) { return false; } },
            ast.StmtIf(f) => { if (!map_no_unfresh_set_arg(f.then_body, name, argidx, boxfresh) || !map_no_unfresh_set_arg(f.else_body, name, argidx, boxfresh)) { return false; } },
            ast.StmtWhile(w) => { if (!map_no_unfresh_set_arg(w.body, name, argidx, boxfresh)) { return false; } },
            ast.StmtFor(fo) => { if (!map_no_unfresh_set_arg(fo.body, name, argidx, boxfresh)) { return false; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (!map_no_unfresh_set_arg(arm.body, name, argidx, boxfresh)) { return false; } }
            },
            _ => {}
        }
    }
    return true;
}

// map_str_value_reclaimable / map_str_key_reclaimable: `name` is declared with a
// `string` value (resp. key), its init insert-chain values (resp. keys) are all
// fresh strings, AND no later set/insert on it uses a non-fresh value (resp. key)
// — so the map is the sole rc=1 owner of every value (resp. key) box and that
// column can be deep-freed. argidx 1 = value column, 0 = key column.
function map_str_value_reclaimable(stmts: ast.Stmt[], name: string): boolean {
    if (map_decl_type(stmts, name, false) != "string") { return false; }
    if (!map_no_unfresh_set_arg(stmts, name, 1, false)) { return false; }
    return map_init_chain_arg_ok(stmts, name, 1, false);
}
function map_str_key_reclaimable(stmts: ast.Stmt[], name: string): boolean {
    if (map_decl_type(stmts, name, true) != "string") { return false; }
    if (!map_no_unfresh_set_arg(stmts, name, 0, false)) { return false; }
    return map_init_chain_arg_ok(stmts, name, 0, false);
}

// --- #4353 item 3: BOX-VALUE column deep-release for a reclaimable map --------
// The string column (MAPVS: above) was the only value kind the reclaim ever
// released; an ARRAY-valued or STRUCT-valued column kept the shallow buffer-only
// free, so every element box leaked. `Map[i32, i32[]]` churn measured 86 B/round
// and `Map[i32, Q]` 94 B/round on x86-64 against a flat native oracle.
//
// map_val_box_column_ok: the map free reclaims a `vt` column in FULL — one
// __fern_arr_dec per element releases a SCALAR-element array (`i32[]`, `f64[]`,
// …) whose buffer is the whole allocation, or an all-scalar struct box; a struct
// with rc fields first walks each box through __map_vals_struct_drop_<vt>
// (map_val_struct_deep_type). A `string[]` / `Q[]` column (pointer elements)
// needs a per-element-kind walk the map free does not have, so it stays on the
// shallow free: what this credit claims, it reclaims in full.
function map_val_box_column_ok(vt: string, structs: parser.StructDecl[]): boolean {
    if (map_value_type_is_arr(vt)) { return !map_value_is_ptr(slice_unchecked(vt, 0, vt.len() - 2)); }
    return struct_fields_all_scalar(structs, vt) || map_val_struct_deep_type(vt, structs) != "";
}

// map_val_struct_deep_type: `vt` names a declared struct with rc fields that
// __struct_drop_<vt> can release (acyclic, deep-drop-ok), so a value column of
// it walks each box through __map_vals_struct_drop_<vt> before the one-dec free.
// "" for an all-scalar struct (one dec is its whole release) or a shape the deep
// drop declines.
function map_val_struct_deep_type(vt: string, structs: parser.StructDecl[]): string {
    if (!decl_is_struct(structs, vt)) { return ""; }
    if (struct_fields_all_scalar(structs, vt)) { return ""; }
    if (!nested_field_deep_drop_ok(structs, vt)) { return ""; }
    return vt;
}

// struct_fields_all_scalar: `sty` names a declared struct whose every field is a
// non-pointer scalar. An unknown / generic name reads false (the safe direction —
// it keeps the shallow free).
function struct_fields_all_scalar(structs: parser.StructDecl[], sty: string): boolean {
    for sd in structs {
        if (sd.name == sty) {
            if (sd.type_params.len() > 0) { return false; }
            for fld in sd.fields {
                if (map_value_is_ptr(fld.type_name)) { return false; }
            }
            return true;
        }
    }
    return false;
}

// map_box_value_reclaimable: `name` is declared with a one-dec box VALUE type and
// its init insert-chain values — plus every later set/insert value — are FRESH
// literals, so the map is the sole rc=1 owner of every value box and the column
// can be element-freed. SOUNDNESS mirrors MAPVS: the register __fern_map_set
// stores a value pointer with no rc-inc of its own, and map_insert_value_retains
// only retains an ALIASED array, so a literal transfers its single ref to the map
// and nothing else names the box. The declared-type gate is required because the
// freshness predicate is purely syntactic.
function map_box_value_reclaimable(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    if (!map_val_box_column_ok(map_decl_type(stmts, name, false), structs)) { return false; }
    if (!map_no_unfresh_set_arg(stmts, name, 1, true)) { return false; }
    return map_init_chain_arg_ok(stmts, name, 1, true);
}
function map_init_chain_arg_ok(stmts: ast.Stmt[], name: string, argidx: i32, boxfresh: boolean): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return map_insert_chain_arg_fresh(v.init, argidx, boxfresh); } },
            ast.StmtIf(f) => {
                if (stmts_declare(f.then_body, name)) { return map_init_chain_arg_ok(f.then_body, name, argidx, boxfresh); }
                if (stmts_declare(f.else_body, name)) { return map_init_chain_arg_ok(f.else_body, name, argidx, boxfresh); }
            },
            ast.StmtWhile(w) => { if (stmts_declare(w.body, name)) { return map_init_chain_arg_ok(w.body, name, argidx, boxfresh); } },
            ast.StmtFor(fo) => { if (stmts_declare(fo.body, name)) { return map_init_chain_arg_ok(fo.body, name, argidx, boxfresh); } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (stmts_declare(arm.body, name)) { return map_init_chain_arg_ok(arm.body, name, argidx, boxfresh); } }
            },
            _ => {}
        }
    }
    return false;
}
// stmts_declare: does a `var name = …` appear directly in `stmts`?
function stmts_declare(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { return true; } },
            _ => {}
        }
    }
    return false;
}

// expr_calls_map_method: does `e` call `name.<m>()` for any `m` in `methods`?
function expr_calls_map_method(e: ast.Expr, name: string, methods: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ast.ExprIdent(id) => { if (id.name == name && util.index_of_str(methods, fa.field) >= 0) { return true; } },
                        _ => {}
                    }
                    if (expr_calls_map_method(fa.obj, name, methods)) { return true; }
                },
                _ => { if (expr_calls_map_method(c.callee, name, methods)) { return true; } }
            }
            for arg in c.args { if (expr_calls_map_method(arg, name, methods)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return expr_calls_map_method(b.left, name, methods) || expr_calls_map_method(b.right, name, methods); },
        ast.ExprUnary(u) => { return expr_calls_map_method(u.operand, name, methods); },
        ast.ExprIndex(ix) => { return expr_calls_map_method(ix.array, name, methods) || expr_calls_map_method(ix.index, name, methods); },
        ast.ExprFieldAccess(fa) => { return expr_calls_map_method(fa.obj, name, methods); },
        _ => { return false; }
    }
}

// map_has_col_alias_read: does the body read `name`'s column BUFFERS — a
// keys() / values() (a raw alias on a flag-1 column, map_kv_elem_flag), an
// iter(), or a for-in over the map? A map with none is its buffers' sole
// holder, so a grow may free the superseded buffer (the "MAPOWN:" credit).
function map_has_col_alias_read(stmts: ast.Stmt[], name: string): boolean {
    return map_stmts_call_method(stmts, name, ["iter", "keys", "values"], true);
}

// map_has_explicit_iter: does the body call `name.iter()` EXPLICITLY anywhere? Such an
// iter binds a MapIter box holding a raw pointer to the mapbox / its buffers, and if
// that box escapes (returned / stored), freeing the buffers is a UAF — so any explicit
// iter conservatively excludes the map from reclaim. A `for (k, v) in name` is NOT
// excluded: its iter is a scoped loop temp (dead by the free), and k/v are copies of
// scalars or of pointers to SEPARATELY-allocated (leaked) elements, so freeing the
// keys/values BUFFERS never dangles them — the reclaim runs after the loop completes.
// Recurses through nested blocks and statement expressions.
function map_has_explicit_iter(stmts: ast.Stmt[], name: string): boolean {
    return map_stmts_call_method(stmts, name, ["iter"], false);
}
// map_stmts_call_method: does any statement call `name.<m>()` for an `m` in
// `methods`? `forin` also counts a `for (k, v) in name` — a bare-ident
// iteration, which map_has_explicit_iter admits (its iter is a scoped loop
// temp, dead by the free) and map_has_col_alias_read does not.
function map_stmts_call_method(stmts: ast.Stmt[], name: string, methods: string[], forin: boolean): boolean {
    for stmt in stmts {
        if (map_stmt_calls_method(stmt, name, methods, forin)) { return true; }
    }
    return false;
}
function map_stmt_calls_method(st: ast.Stmt, name: string, methods: string[], forin: boolean): boolean {
    match (st) {
        ast.StmtFor(f) => {
            if (forin) {
                match (f.iter) {
                    ast.ExprIdent(fid) => { if (fid.name == name) { return true; } },
                    _ => {}
                }
            }
            if (expr_calls_map_method(f.iter, name, methods)) { return true; }
            return map_stmts_call_method(f.body, name, methods, forin);
        },
        ast.StmtVar(v) => { return expr_calls_map_method(v.init, name, methods); },
        ast.StmtAssign(a) => { return expr_calls_map_method(a.value, name, methods); },
        ast.StmtExpr(ex) => { return expr_calls_map_method(ex.value, name, methods); },
        ast.StmtReturn(r) => { return expr_calls_map_method(r.value, name, methods); },
        ast.StmtIf(iff) => { return map_stmts_call_method(iff.then_body, name, methods, forin) || map_stmts_call_method(iff.else_body, name, methods, forin); },
        ast.StmtWhile(w) => { return expr_calls_map_method(w.cond, name, methods) || map_stmts_call_method(w.body, name, methods, forin); },
        ast.StmtMatch(m) => {
            if (expr_calls_map_method(m.scrutinee, name, methods)) { return true; }
            for arm in m.arms { if (map_stmts_call_method(arm.body, name, methods, forin)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
}

// expr_map_identity_use reports whether expr `e` contains `name.insert(...)` or
// `name.without(...)` anywhere — the map reclaim's soundness gate for the
// IDENTITY-CARRYING method hole. Both return the receiver's OWN mapbox (insert
// mutates in place and hands the same box back; without returns a
// [map, existed] tuple wrapping it), so their RESULT flowing into any position
// (a struct-lit field value, a tuple element, a call arg, a fresh bind) can
// smuggle the box past the borrow-only escape walk — expr_unsafe_for treats a
// method RECEIVER as a borrow, so `C { m: mm.insert(1, 1) }` looked
// non-escaping and the reclaim freed a mapbox the program still reads (the
// map-call-as-struct-field UAF). Distinguishing an escaping result from a
// discarded one cheaply is not worth it: ANY identity-carrying use
// conservatively excludes the map from reclaim (it just leaks — the
// pre-reclaim default). The self-reassign form `m = m.insert(k, v)` is caught
// too, but such a name is already excluded by the not-reassigned gate.
// Unlike expr_iters_map this walker recurses into struct-lit / array / tuple
// positions — exactly where the escaping results hide.
function expr_map_identity_use(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ast.ExprIdent(id) => { if (id.name == name && (fa.field == "insert" || fa.field == "without")) { return true; } },
                        _ => {}
                    }
                    if (expr_map_identity_use(fa.obj, name)) { return true; }
                },
                _ => { if (expr_map_identity_use(c.callee, name)) { return true; } }
            }
            for arg in c.args { if (expr_map_identity_use(arg, name)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return expr_map_identity_use(b.left, name) || expr_map_identity_use(b.right, name); },
        ast.ExprUnary(u) => { return expr_map_identity_use(u.operand, name); },
        ast.ExprIndex(ix) => { return expr_map_identity_use(ix.array, name) || expr_map_identity_use(ix.index, name); },
        ast.ExprSlice(sl) => { return expr_map_identity_use(sl.array, name) || expr_map_identity_use(sl.start, name) || expr_map_identity_use(sl.end, name); },
        ast.ExprFieldAccess(fa) => { return expr_map_identity_use(fa.obj, name); },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && expr_map_identity_use(sl.base, name)) { return true; }
            for fv in sl.field_values { if (expr_map_identity_use(fv, name)) { return true; } }
            return false;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (expr_map_identity_use(a.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (expr_map_identity_use(el, name)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
}

// map_expr_mentions_name: does `e` mention the bare ident `name` anywhere?
// FAIL-CLOSED: an expression variant this walker doesn't model returns true
// (treated as a mention), because its caller (is_map_selfcow_assign) uses
// absence-of-mention as a soundness guarantee — a missed mention could
// smuggle the reclaimed mapbox into a live structure (UAF), while a false
// positive merely declines the reclaim (the pre-#4357 leak default).
function map_expr_mentions_name(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprBinary(b) => { return map_expr_mentions_name(b.left, name) || map_expr_mentions_name(b.right, name); },
        ast.ExprUnary(u) => { return map_expr_mentions_name(u.operand, name); },
        ast.ExprFieldAccess(fa) => { return map_expr_mentions_name(fa.obj, name); },
        ast.ExprIndex(ix) => { return map_expr_mentions_name(ix.array, name) || map_expr_mentions_name(ix.index, name); },
        ast.ExprSlice(sl) => { return map_expr_mentions_name(sl.array, name) || map_expr_mentions_name(sl.start, name) || map_expr_mentions_name(sl.end, name); },
        ast.ExprCall(c) => {
            if (map_expr_mentions_name(c.callee, name)) { return true; }
            for arg in c.args { if (map_expr_mentions_name(arg, name)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && map_expr_mentions_name(sl.base, name)) { return true; }
            for fv in sl.field_values { if (map_expr_mentions_name(fv, name)) { return true; } }
            return false;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (map_expr_mentions_name(a.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (map_expr_mentions_name(el, name)) { return true; } }
            return false;
        },
        _ => { return true; }
    }
    return true;
}

// is_map_selfcow_assign: `st` is the sanctioned COW self-reassign
// `name = name.insert(k, v)` — target `name`, RHS a direct insert call whose
// receiver is the bare ident `name`, and `name` appearing NOWHERE in the call
// arguments (an arg occurrence could smuggle the box). The identity-carrying
// result lands back in the SAME slot, so unlike every other identity use it
// cannot leak the box past the escape walk — the native twin is
// isSelfMapMutation + the computeFreshLocals cow carve-out (#5096).
// `without` is excluded (it returns a [map, existed] tuple, never a bare
// reassign RHS); `insert` at rc==1 mutates in place and returns the same box,
// so the slot's value is unchanged and the exit / precise reclaim still frees
// exactly one live box.
function is_map_selfcow_assign(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target != name) { return false; }
            match (a.value) {
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprFieldAccess(fa) => {
                            if (fa.field != "insert") { return false; }
                            match (fa.obj) {
                                ast.ExprIdent(id) => {
                                    if (id.name != name) { return false; }
                                },
                                _ => { return false; }
                            }
                            for arg in c.args {
                                if (map_expr_mentions_name(arg, name)) { return false; }
                            }
                            return true;
                        },
                        _ => { return false; }
                    }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// map_nonself_reassigned: any reassignment of `name` that is NOT the
// sanctioned self-cow form (is_map_selfcow_assign). The "MAP:" reclaim gate
// uses this instead of the blanket reassigned list, so a cow-threaded
// builder loop (`var m = map_new(8); m = m.insert(..)`) keeps its reclaim —
// the self-host half of #4357's map-intermediate leak (the box stays THE
// same rc==1 box through in-place inserts, so the per-iteration / exit free
// still releases exactly one live box). Any other rebind (a fresh literal, a
// different call, an alias) disqualifies exactly as before.
function map_nonself_reassigned(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name && !is_map_selfcow_assign(stmt, name)) { return true; }
            },
            ast.StmtIf(iff) => { if (map_nonself_reassigned(iff.then_body, name) || map_nonself_reassigned(iff.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (map_nonself_reassigned(w.body, name)) { return true; } },
            ast.StmtFor(f) => { if (map_nonself_reassigned(f.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (map_nonself_reassigned(arm.body, name)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

// map_identity_escape: does the body contain an identity-carrying method call
// on `name` (see expr_map_identity_use) anywhere? Shared soundness gate for
// BOTH map reclaim sites — the "MAP:" exit set and the precise-drop candidate.
function map_identity_escape(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        if (map_identity_escape_stmt(stmt, name)) { return true; }
    }
    return false;
}
function map_identity_escape_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return expr_map_identity_use(v.init, name); },
        ast.StmtAssign(a) => {
            // The sanctioned self-cow reassign (`name = name.insert(k, v)`,
            // is_map_selfcow_assign) is exempt: its identity-carrying result
            // lands back in the same slot, so no box escapes. The arg walk
            // inside is_map_selfcow_assign already rejected any occurrence of
            // `name` in the arguments, so nothing here is smuggled either.
            if (is_map_selfcow_assign(st, name)) { return false; }
            return expr_map_identity_use(a.value, name);
        },
        ast.StmtExpr(ex) => { return expr_map_identity_use(ex.value, name); },
        ast.StmtReturn(r) => { return expr_map_identity_use(r.value, name); },
        ast.StmtFor(f) => { return expr_map_identity_use(f.iter, name) || map_identity_escape(f.body, name); },
        ast.StmtIf(iff) => { return expr_map_identity_use(iff.cond, name) || map_identity_escape(iff.then_body, name) || map_identity_escape(iff.else_body, name); },
        ast.StmtWhile(w) => { return expr_map_identity_use(w.cond, name) || map_identity_escape(w.body, name); },
        ast.StmtMatch(m) => {
            if (expr_map_identity_use(m.scrutinee, name)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_map_identity_use(arm.guard, name)) { return true; }
                if (map_identity_escape(arm.body, name)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
}

// --- string[] ELEMENT reclaim (#4355: string RC, string-array slice) ---------
//
// A fresh string[] local whose EVERY stored element is provably fresh (a concat /
// named producer / string method copy) or a static literal box owns each element
// box at rc==1 for its whole life: array stores are MOVES (op_arr_push copies no
// rc), the sanctioned self-append rebind `xs = xs.append(e)` transfers elements
// buffer-to-buffer (the push helper never frees; the assign's cow-guarded shallow
// dec releases only the superseded buffer), and the element-hazard walk below
// proves no element pointer ever outlives the frame. Such a local is credited
// "SARR:<name>" so the exit sweep frees it with __fern_str_arr_free — the
// element-walking sibling of the shallow __fern_rc_dec: at rc==1 it
// __fern_str_free's every element box (rc-aware: a shared element decs, a static
// literal's .rodata data is heap-guard-skipped, an immortal view is skipped) and
// then frees the buffer. Anything the analyses cannot prove stays on the shallow
// buffer-only dec (elements leak — sound, never an over-release).

// strarr_elem_store_ok: strarr_value_is_fresh asked WITHOUT the whole-program
// registry — the answer available to an admission that holds no FnSigs. A call
// to a proven `str_fresh_ret_fns` producer is refused here and admitted at the
// sites that do have the registry (the "SARR:" local credit).
function strarr_elem_store_ok(e: ast.Expr): boolean {
    return strarr_value_is_fresh(e, []);
}

// fn_field_value_is_fresh: `e` is a FRESH closure value for an fn-typed
// struct field — a lambda literal (pre-lift AST) or its lifted spelling, a
// `__mkclo$…` env-box constructor call (the reuse-site walkers run on the
// LIFTED module, where every fn-field lambda is already wrapped). Both build
// a sole-owned rc=1 env box at the construction site, so the reuse arm's
// shallow arr_dec of the OLD box can never free a live alias. The same dual
// accept as the clofld admission scan (see clofld_scan's struct-lit arm).
function fn_field_value_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprLambda(_) => { return true; },
        ast.ExprCall(cv) => {
            match (cv.callee) {
                ast.ExprIdent(cvid) => {
                    if (cvid.name.len() > 8 && slice_unchecked(cvid.name, 0, 8) == "__mkclo$") { return true; }
                },
                _ => {}
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// strarr_lit_all_elems_fresh: `e` is a string[] ARRAY LITERAL whose every
// element is strarr_elem_store_ok (a string literal or a fresh producer; an
// empty `[]` qualifies). The value-freshness proof the reuse admission uses
// for string[] fields on both the donor and recipient sides: such a literal
// builds a sole-owned buffer of sole-owned element boxes, so the reuse-arm
// __fern_str_arr_free of the OLD value can never free a live alias.
function strarr_lit_all_elems_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(al) => {
            var i: i32 = 0;
            while (i < al.elements.len()) {
                if (!strarr_elem_store_ok(al.elements[i])) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// boxarr_lit_all_elems_fresh: `e` is an ARRAY LITERAL for a struct[] / enum[]
// field whose every element is FRESH — a no-base struct literal of the element
// type, resp. a variant ctor of the element enum (an empty `[]` qualifies).
// The value-freshness proof the reuse admission uses for box-element-array
// fields: such a literal builds a sole-owned buffer of sole-owned rc=1
// element boxes, so the reuse-arm __fern_arrarr_free (element boxes + buffer,
// each rc-guarded) can never free a live alias.
function boxarr_lit_all_elems_fresh(e: ast.Expr, structs: parser.StructDecl[], elem_ty: string, is_enum: boolean): boolean {
    match (e) {
        ast.ExprArray(al) => {
            var i: i32 = 0;
            while (i < al.elements.len()) {
                if (is_enum) {
                    if (variant_ctor_enum_owner(al.elements[i], structs) != elem_ty) { return false; }
                } else {
                    var el_ok: boolean = false;
                    match (al.elements[i]) {
                        ast.ExprStructLit(esl) => {
                            if (!esl.has_base && esl.type_name == elem_ty) { el_ok = true; }
                        },
                        _ => {}
                    }
                    if (!el_ok) { return false; }
                }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// collect_fresh_strarr_names: locals whose initialiser hands the frame a string[]
// it solely owns, element boxes included. Two shapes:
//   - `var xs [: string[]] = [e0, ...]` — every element strarr_value_is_fresh (an
//     empty `[]` qualifies), the accumulator seed for the self-append rebind;
//   - `var xs [: string[]] = producer(...)` — a "STRARR:" registry function, whose
//     admission already proved whole-program that every element of the returned
//     array is a box the callee allocated and handed out at rc=1. `body` is the
//     frame being scanned, so a LOCAL of the callee's name shadows the
//     declaration and holds an unknown closure body: refused.
// Purely syntactic, like collect_fresh_string_names — the TYPE gate is the slot's
// is_strarr at the reclaim site (slot_is_reclaimable_strarr), so an i32[] literal
// collected here is never element-walked.
// collect_builtin_strarr_names gathers `var xs = <recv>.split(sep) / .lines()`
// bindings — CANDIDATES only. It matches the method NAME, which is all a
// name-level pass can do; the binding site confirms the receiver is a string
// before the credit means anything (is_strarr_builtin_slot). Both are required
// at the reclaim gate, so a user method named `split` on another type never
// reaches it.
//
// Separate from collect_fresh_strarr_names because the element contract differs:
// there the elements are values the FUNCTION produced and the collector checks
// each one; here they are produced by the runtime helper, which stores them
// nowhere else.
function collect_builtin_strarr_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_builtin_strarr_in_stmt(stmt, a); }
    return a;
}
function collect_builtin_strarr_in_stmt(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprFieldAccess(fa) => {
                            if (fa.field == "split" || fa.field == "lines") { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
                        },
                        _ => {}
                    }
                    return acc;
                },
                _ => { return acc; }
            }
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_builtin_strarr_names(iff.then_body, acc);
            return collect_builtin_strarr_names(iff.else_body, a);
        },
        ast.StmtWhile(w) => { return collect_builtin_strarr_names(w.body, acc); },
        ast.StmtFor(f) => { return collect_builtin_strarr_names(f.body, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_builtin_strarr_names(arm.body, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_builtin_strarr_in_stmt(d.action, acc); },
        _ => {}
    }
    return acc;
}

function collect_fresh_strarr_names(stmts: ast.Stmt[], body: ast.Stmt[], fresh_ret: string[], str_fresh: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_fresh_strarr_in_stmt(stmt, body, fresh_ret, str_fresh, a); }
    return a;
}
function collect_fresh_strarr_in_stmt(st: ast.Stmt, body: ast.Stmt[], fresh_ret: string[], str_fresh: string[], acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprArray(al) => {
                    var i: i32 = 0;
                    while (i < al.elements.len()) {
                        if (!strarr_value_is_fresh(al.elements[i], str_fresh)) { return acc; }
                        i = i + 1;
                    }
                    return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col));
                },
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprIdent(cid) => {
                            if (util.index_of_str(fresh_ret, "STRARR:" + cid.name) >= 0
                                    && !body_declares_name(body, cid.name)) {
                                return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col));
                            }
                        },
                        _ => {}
                    }
                    return acc;
                },
                _ => { return acc; }
            }
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_fresh_strarr_names(iff.then_body, body, fresh_ret, str_fresh, acc);
            return collect_fresh_strarr_names(iff.else_body, body, fresh_ret, str_fresh, a);
        },
        ast.StmtWhile(w) => { return collect_fresh_strarr_names(w.body, body, fresh_ret, str_fresh, acc); },
        ast.StmtFor(f) => { return collect_fresh_strarr_names(f.body, body, fresh_ret, str_fresh, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_fresh_strarr_names(arm.body, body, fresh_ret, str_fresh, a); }
            return a;
        },
        ast.StmtDefer(d) => { return collect_fresh_strarr_in_stmt(d.action, body, fresh_ret, str_fresh, acc); },
        _ => { return acc; },
    }
}

// strarr_elem_read: `e` is a DIRECT element read `name[i]` of the candidate array.
function strarr_elem_read(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(id) => { return id.name == name; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// strarr_expr_unsafe: the element-hazard sibling of expr_unsafe_for. TRUE when
// `e` uses `name` (the candidate string[] local) or an ELEMENT of it in a way
// that could let a pointer outlive the frame's exit sweep — in which case the
// element walk would free a box someone still holds. expr_unsafe_for alone is
// NOT enough here: it deliberately treats `name[i]` as a borrow (safe for the
// buffer-only dec), but for ELEMENT reclaim a `var t = xs[i]` binding, a
// `return xs[i]`, or an `ys.append(xs[i])` store is a lasting element alias.
// SAFE element-read positions (the element is read transiently, before the
// sweep): a binary operand (`xs[i] + y` copies bytes, `xs[i] == y` compares),
// a read-only / fresh-copy method receiver (`xs[i].len()` / `.to_upper()` /
// `.to_lower()` / `.reverse()` / `.repeat(n)` / `.starts_with(p)` /
// `.ends_with(p)` / `.contains(p)` / `.index_of(p)`), a byte read `xs[i][j]`,
// a match scrutinee (string match compares), and a DIRECT arg to a free
// function whose param is borrowable. Everything else — bare binding, return,
// container/struct/tuple store, method arg, non-borrowable call arg, a slice
// or `.trim()` VIEW of an element (shares the element's buffer), an unknown
// method — is a hazard. The array ITSELF follows expr_unsafe_for's rules,
// tightened: a method receiver `name.m()` is only `.len()`-safe (`.append` is
// sanctioned only as the `name = name.append(e)` rebind, handled at the
// StmtAssign arm; `.with()` / slices alias the buffer AND its elements).
// strarr_borrowing_method: a string[] builtin that only READS its receiver — it
// keeps no reference to the array or to any element, so calling it on a
// reclaimable local is not an escape. `len` reads the length word; `join`
// (__fern_arr_str_join) walks the elements building a fresh accumulator with
// `+`, storing nothing. The array-method sibling of str_borrowing_method.
//
// Everything else stays an escape by default, which is the right way round: a
// method that returns an element, a slice, or the array itself hands out a
// lasting alias, and the reclaim would free it out from under the caller.
function strarr_borrowing_method(field: string): boolean {
    return field == "len" || field == "join";
}

function strarr_expr_unsafe(e: ast.Expr, name: string, borrowable: string[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprBinary(b) => {
            var lu: boolean = false;
            if (!strarr_elem_read(b.left, name)) { lu = strarr_expr_unsafe(b.left, name, borrowable); }
            if (lu) { return true; }
            if (!strarr_elem_read(b.right, name)) { return strarr_expr_unsafe(b.right, name, borrowable); }
            return false;
        },
        ast.ExprUnary(u) => { return strarr_expr_unsafe(u.operand, name, borrowable); },
        ast.ExprIndex(ix) => {
            // `name[i]` reaching here is a general VALUE position (binding /
            // container element / index-store value / ...): a lasting alias.
            if (strarr_elem_read(e, name)) { return true; }
            // `xs[i][j]` byte read: the inner element read is transient.
            var base_u: boolean = false;
            if (!strarr_elem_read(ix.array, name)) {
                match (ix.array) {
                    ast.ExprIdent(_) => { base_u = false; },
                    _ => { base_u = strarr_expr_unsafe(ix.array, name, borrowable); }
                }
            }
            if (base_u) { return true; }
            return strarr_expr_unsafe(ix.index, name, borrowable);
        },
        ast.ExprSlice(sl) => {
            // a slice of an ELEMENT is a zero-copy view of its buffer; a slice of
            // the ARRAY aliases buffer + elements. Both are hazards.
            if (strarr_elem_read(sl.array, name)) { return true; }
            if (strarr_expr_unsafe(sl.array, name, borrowable)) { return true; }
            if (strarr_expr_unsafe(sl.start, name, borrowable)) { return true; }
            return strarr_expr_unsafe(sl.end, name, borrowable);
        },
        ast.ExprCall(c) => {
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    callee_name = cid.name;
                    if (cid.name == name) { return true; }
                },
                ast.ExprFieldAccess(fa) => {
                    if (strarr_elem_read(fa.obj, name)) {
                        if (!str_borrowing_method(fa.field)) { return true; }
                    } else {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => {
                                if (rid.name == name && !strarr_borrowing_method(fa.field)) { return true; }
                            },
                            _ => { if (strarr_expr_unsafe(fa.obj, name, borrowable)) { return true; } }
                        }
                    }
                },
                _ => { if (strarr_expr_unsafe(c.callee, name, borrowable)) { return true; } }
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                var arg_ok: boolean = false;
                match (c.args[ai]) {
                    ast.ExprIdent(aid) => {
                        // The "CNT:" tier admits the whole array at a position the
                        // callee only STORES counted. The deep walk survives it:
                        // the store retains the BUFFER, so __fern_str_arr_free's rc
                        // gate leaves the elements to whichever owner reaches rc 1
                        // — and the tier's own rule refuses an element read, so the
                        // callee can hand no element out uncounted.
                        if (aid.name == name && callee_name.len() > 0
                            && (param_is_borrowable(borrowable, callee_name, ai)
                                || param_is_borrowable(borrowable, "CNT:" + callee_name, ai))) { arg_ok = true; }
                    },
                    _ => {
                        // a DIRECT `name[i]` arg to a free fn at a borrowable param
                        // is a transient read (the callee provably retains nothing).
                        if (strarr_elem_read(c.args[ai], name) && callee_name.len() > 0
                                && param_is_borrowable(borrowable, callee_name, ai)) { arg_ok = true; }
                    }
                }
                if (!arg_ok && strarr_expr_unsafe(c.args[ai], name, borrowable)) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        ast.ExprFieldAccess(fa) => {
            if (strarr_elem_read(fa.obj, name)) { return true; }
            match (fa.obj) {
                ast.ExprIdent(_) => { return false; },
                _ => { return strarr_expr_unsafe(fa.obj, name, borrowable); }
            }
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (strarr_expr_unsafe(a.elements[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (strarr_expr_unsafe(el, name, borrowable)) { return true; } }
            return false;
        },
        ast.ExprStructLit(slz) => {
            if (slz.has_base && strarr_expr_unsafe(slz.base, name, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < slz.field_values.len()) { if (strarr_expr_unsafe(slz.field_values[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprLambda(lm) => {
            // A VALUE BLOCK is not a closure — see expr_unsafe_for's arm. Same
            // bug, same shape, one kind over: `xs[0].len()` read through a match
            // expression left a string[] local uncredited, so its elements and
            // buffer stranded where the identical plain read is flat.
            //
            // The empty str_fresh is a deliberate conservative bound: it only
            // disables the self-`append` / self-`.with` rebind forgiveness inside
            // the block, which can refuse a credit but never grant one.
            if (parser.is_value_block_origin(lm.origin)) {
                var no_str_fresh: string[] = [];
                var no_producers: string[] = [];
                return strarr_unsafe_for(lm.body, name, borrowable, no_str_fresh, no_producers);
            }
            var used: string[] = [];
            var i: i32 = 0;
            while (i < lm.body.len()) { used = astwalk.collect_idents_stmt(lm.body[i], used); i = i + 1; }
            return util.index_of_str(used, name) >= 0;
        },
        _ => { return false; }
    }
    return false;
}

// strarr_unsafe_for / stmt_strarr_unsafe_for: the whole-body gate for string[]
// ELEMENT reclaim. Like body_unsafe_for plus the element hazards, with exactly
// one sanctioned reassignment form — the self-append rebind
// `name = name.append(e)` where `e` is itself a fresh/static element store
// (strarr_value_is_fresh, the same question the credit's declaration arm asks)
// that doesn't otherwise leak `name`. `for x in name` binds an element per
// iteration (a lasting alias the walker can't see through) — conservatively
// unsafe.
// strarr_producer_names_of: the whole-program `"STRARR:"` producers this frame
// can actually see — registered as returning a freshly-built string[] on every
// path, and not shadowed by a local or a parameter of the same name here. The
// declaration collector asks the registry and `body_declares_name` separately;
// the rebind gate below is inside a walker that carries neither, so the list is
// filtered once at the entry point instead, as the string[]-field admission
// filters its own producers.
function strarr_producer_names_of(fresh_ret: string[], body: ast.Stmt[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < fresh_ret.len()) {
        if (fresh_ret[i].len() > 7 && slice_unchecked(fresh_ret[i], 0, 7) == "STRARR:") {
            var nm: string = slice_unchecked(fresh_ret[i], 7, fresh_ret[i].len()) + "";
            if (!body_declares_name(body, nm)) { out = push_str_unique(out, nm); }
        }
        i = i + 1;
    }
    return out;
}

// strarr_rebind_is_fresh: `name = <e>` rebuilds the local from a value it can
// solely own, so the store may release what the slot held. It is the SAME
// freshness proof collect_fresh_strarr_in_stmt applies to the declaration — an
// array literal whose every element is element-fresh (`[]` included), or a call
// to a visible whole-program string[] producer — asked at the rebind instead.
//
// The release itself already exists: emit_strarr_reclaim_store frees the old
// buffer and its element boxes before the store, under a cow guard, which is
// why the self-`append` and self-`.with` rebinds beside this one are safe. This
// form differs only in that the new value shares nothing with the old, so the
// guard never fires and the old value is always freed.
//
// `name` must not appear in the value: an element read would be a lasting alias
// into the buffer the store is about to free.
function strarr_rebind_is_fresh(e: ast.Expr, name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[]): boolean {
    if (strarr_expr_unsafe(e, name, borrowable)) { return false; }
    match (e) {
        ast.ExprArray(al) => {
            var i: i32 = 0;
            while (i < al.elements.len()) {
                if (!strarr_value_is_fresh(al.elements[i], str_fresh)) { return false; }
                i = i + 1;
            }
            return true;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(strarr_producers, cid.name) >= 0; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function strarr_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[]): boolean {
    var no_alias: string[] = [];
    var no_sfld: string[] = [];
    return strarr_unsafe_for_alias(stmts, name, borrowable, str_fresh, strarr_producers, no_alias, no_sfld);
}
// strarr_unsafe_for_alias is strarr_unsafe_for carrying the #7282 alias
// forgiveness: a plain `var v: string[] = name` bind whose own site key is in
// `alias_ok` does not flag `name` — the bind retains the shared buffer and the
// alias site is granted the same "SARR:" credit, so both slots release and
// __fern_str_arr_free arbitrates (elements walk only at the last owner's
// rc==1). The parameter rather than a second walker, as body_unsafe_for_tup_alias.
function strarr_unsafe_for_alias(stmts: ast.Stmt[], name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[], alias_ok: string[], sfld_ok: string[]): boolean {
    for stmt in stmts { if (stmt_strarr_unsafe_for(stmt, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok)) { return true; } }
    return false;
}
function stmt_strarr_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[], alias_ok: string[], sfld_ok: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprIdent(aid) => {
                    if (aid.name == name
                        && util.index_of_str(alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0) { return false; }
                },
                // The struct-literal FIELD share. `var p: T = T { .., f: name, .. }`
                // over a `string[]` field retains the buffer, and T's field drop
                // releases it through the same rc-gated __fern_str_arr_free the
                // alias bind above relies on — so `name` keeps its own DEEP credit
                // and the walk still runs exactly once, at whichever owner finds
                // rc 1. Without it the element walk lives ONLY in the holder's
                // field drop, which is correct until a path skips the construction
                // and nothing walks at all.
                ast.ExprStructLit(_) => {
                    if (util.index_of_str(sfld_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0) { return false; }
                },
                _ => {}
            }
            return strarr_expr_unsafe(v.init, name, borrowable);
        },
        ast.StmtReturn(r) => { return strarr_expr_unsafe(r.value, name, borrowable); },
        ast.StmtExpr(e) => { return strarr_expr_unsafe(e.value, name, borrowable); },
        ast.StmtAssign(a) => {
            if (a.target == name) {
                match (a.value) {
                    ast.ExprCall(c) => {
                        var is_self_append: boolean = false;
                        match (c.callee) {
                            ast.ExprFieldAccess(fa) => {
                                if (fa.field == "append") {
                                    match (fa.obj) {
                                        ast.ExprIdent(rid) => { is_self_append = rid.name == name; },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                        if (is_self_append && c.args.len() == 1
                                && strarr_value_is_fresh(c.args[0], str_fresh)
                                && !strarr_expr_unsafe(c.args[0], name, borrowable)) { return false; }
                        // The self-`.with` rebind `name = name.with(i, v)`
                        // (#6407). lower_strarr_with_store makes it a
                        // reference-correct element store — the superseded box
                        // is released and `v` is retained — so an ELEMENT of
                        // `name` is admissible as the value here even though it
                        // is a lasting alias everywhere else.
                        var is_self_with: boolean = false;
                        match (c.callee) {
                            ast.ExprFieldAccess(wfa) => {
                                if (wfa.field == "with") {
                                    match (wfa.obj) {
                                        ast.ExprIdent(wid) => { is_self_with = wid.name == name; },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                        if (is_self_with && c.args.len() == 2
                                && !strarr_expr_unsafe(c.args[0], name, borrowable)
                                && (strarr_elem_read(c.args[1], name)
                                    || !strarr_expr_unsafe(c.args[1], name, borrowable))) { return false; }
                    },
                    _ => {}
                }
                // The REBUILD rebind: a value the local can solely own, sharing
                // nothing with what the slot holds. Unlike the two self-rebinds
                // above it is not a call shape, so it is tested after the match.
                if (strarr_rebind_is_fresh(a.value, name, borrowable, str_fresh, strarr_producers)) { return false; }
                return true;   // any other reassignment of the candidate
            }
            return strarr_expr_unsafe(a.value, name, borrowable);
        },
        ast.StmtIf(f) => {
            if (strarr_expr_unsafe(f.cond, name, borrowable)) { return true; }
            return strarr_unsafe_for_alias(f.then_body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok) || strarr_unsafe_for_alias(f.else_body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
        },
        ast.StmtWhile(w) => {
            if (strarr_expr_unsafe(w.cond, name, borrowable)) { return true; }
            return strarr_unsafe_for_alias(w.body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(fid) => {
                    // `for s in name` binds an ELEMENT per iteration, which is
                    // a LASTING alias only if the binder is one. A body that
                    // does nothing but read it — `s.len()`, a comparison, a
                    // borrowable call argument — leaves nothing behind for the
                    // deep free to dangle, which is the same transient line
                    // strarr_expr_unsafe already draws for `name[i]` in those
                    // positions. body_unsafe_for asks it of the binder: a bind,
                    // a return, a container or struct store, or a retaining
                    // call argument all make the loop unsafe again.
                    //
                    // A binder that SHADOWS `name` is refused outright: the
                    // walk below would then be reading a different value under
                    // the same spelling.
                    if (fid.name == name) {
                        iter_unsafe = fo.var_name == name || body_unsafe_for(fo.body, fo.var_name, borrowable, []);
                    } else {
                        iter_unsafe = false;
                    }
                },
                _ => { iter_unsafe = strarr_expr_unsafe(fo.iter, name, borrowable); }
            }
            if (iter_unsafe) { return true; }
            return strarr_unsafe_for_alias(fo.body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
        },
        ast.StmtMatch(m) => {
            // a string scrutinee only compares (transient); an element read there is safe.
            if (!strarr_elem_read(m.scrutinee, name) && strarr_expr_unsafe(m.scrutinee, name, borrowable)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && strarr_expr_unsafe(arm.guard, name, borrowable)) { return true; }
                if (strarr_unsafe_for_alias(arm.body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_strarr_unsafe_for(d.action, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok); },
        _ => { return false; }
    }
    return false;
}

// collect_dyn_struct_names (#4351): every `var <n>: dyn <T> = <init>` binding,
// as "<name>|<tag>" entries (recursing through nested blocks), where the tag
// names the statically reclaimable payload and is EMPTY when this scan cannot
// classify the init. The tag is either the concrete STRUCT
// type name (a leak-safe, scalar-only / deep-drop-ok struct literal — the
// struct flows unboxed behind the coercion, so the local holds its rc-headered
// box) or a PRIMITIVE type name for a prim/string LITERAL init (#4351 slice 2
// — op_dyn_box's cell is rc-headered via __fern_arr_box, so the exit sweep can
// dec it; the "string" tag additionally frees the sole-owned inner string box
// at cell@8), or the concrete STRUCT type a STRICT-FRESH call hands back
// (`var d: dyn T = mk(k)` — `fresh_ret` proves every return of the callee is a
// fresh literal, so the result is this frame's own rc==1 box exactly as a
// literal init is; `struct_ret_fns` names the concrete). A bare-ident init
// gets no tag: for a struct payload it aliases a longer-lived value, and for a
// primitive it is the coercion's own copy that makes the cell reclaimable, not
// anything this scan can see. A name bound twice is
// blanked (shadow — the payloads may differ). `body` is the WHOLE function
// body, carried unchanged through the recursion so a method callee's receiver
// type resolves against every declaration in scope.
function collect_dyn_struct_names(stmts: ast.Stmt[], body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], struct_ret_fns: SigReg, acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_dyn_struct_in_stmt(stmt, body, structs, fresh_ret, struct_ret_fns, a); }
    return a;
}
function collect_dyn_struct_in_stmt(st: ast.Stmt, body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], struct_ret_fns: SigReg, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (v.type_name.len() > 4 && slice_unchecked(v.type_name, 0, 4) == "dyn ") {
                var cty: string = "";
                match (v.init) {
                    ast.ExprStructLit(slz) => {
                        if (!slz.has_base && decl_is_struct(structs, slz.type_name) && decl_is_leaksafe(structs, slz.type_name)
                            && (struct_is_scalar_only(structs, slz.type_name) || nested_field_deep_drop_ok(structs, slz.type_name))) {
                            cty = slz.type_name;
                        }
                    },
                    // A scalar literal's exact prim name doesn't matter to the
                    // sweep (any non-"string" tag is a plain cell dec) — it only
                    // needs to be a name no struct decl can carry. An i64/u64-
                    // suffixed or f64 literal decs the same rc-headered cell.
                    ast.ExprNumber(nl) => { if (nl.is_float) { cty = "f64"; } else { cty = "i32"; } },
                    ast.ExprBool(_) => { cty = "boolean"; },
                    ast.ExprString(_) => { cty = "string"; },
                    // A variant CONSTRUCTION init (`var d: dyn T = V(args)`,
                    // #4351 slice 4): the enum box is a fresh rc-headered
                    // allocation per construction, so the sweep's shallow dec is
                    // unconditionally sound — scalar payloads ride inside the
                    // box; pointer payloads leak with it (safe-leak, same as the
                    // enum sweep elsewhere). The tag is the ENUM name (the sweep
                    // decs any non-struct, non-"string" tag). Unit variants
                    // (bare idents) are NOT credited: they may be static
                    // sentinels, and a bare ident is otherwise a local alias.
                    // A STRICT-FRESH call result (`var d: dyn T = mk(k)` /
                    // `var d: dyn T = obj.mk(k)`): every return of the callee is
                    // a fresh struct literal, so the result is a rc==1 box this
                    // frame owns — the same standing a literal init has, and the
                    // same admission collect_fresh_ret_call_names makes for a
                    // plainly-typed local. The concrete comes from
                    // struct_ret_fns (the annotation only says `dyn T`), and
                    // carries the literal arm's leak-safe / deep-drop-ok gate so
                    // the sweep's __struct_drop_<C> reaches every rc field.
                    ast.ExprCall(dc) => {
                        var ven: string = variant_ctor_enum_owner(v.init, structs);
                        if (ven.len() > 0) { cty = ven; }
                        else {
                            var ckey: string = "";
                            match (dc.callee) {
                                ast.ExprIdent(cid) => { ckey = cid.name; },
                                // A method key needs the RECEIVER's type, which
                                // the `dyn T` annotation cannot supply; a
                                // once-declared annotated local resolves it, a
                                // param receiver keeps today's leak.
                                _ => { ckey = local_recv_method_key(dc.callee, body, structs); },
                            }
                            if (ckey.len() > 0 && util.index_of_str(fresh_ret, ckey) >= 0) {
                                var rty: string = sig_reg_value_of(struct_ret_fns, ckey);
                                if (decl_is_struct(structs, rty) && decl_is_leaksafe(structs, rty)
                                    && (struct_is_scalar_only(structs, rty) || nested_field_deep_drop_ok(structs, rty))) {
                                    cty = rty;
                                }
                            }
                        }
                    },
                    _ => {}
                }
                // An UNCLASSIFIED payload records `<site>|` with an empty tag
                // rather than nothing: the escape gates still apply to it and the
                // coercion decides the rest (the "DYNCAND:" arm in
                // reclaimable_names_of).
                return acc.append(reclaim_site_key_of(v.name, v.line, v.col) + "|" + cty);
            }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_dyn_struct_names(iff.then_body, body, structs, fresh_ret, struct_ret_fns, acc);
            return collect_dyn_struct_names(iff.else_body, body, structs, fresh_ret, struct_ret_fns, a);
        },
        ast.StmtWhile(w) => { return collect_dyn_struct_names(w.body, body, structs, fresh_ret, struct_ret_fns, acc); },
        ast.StmtFor(f) => { return collect_dyn_struct_names(f.body, body, structs, fresh_ret, struct_ret_fns, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_dyn_struct_names(arm.body, body, structs, fresh_ret, struct_ret_fns, a); }
            return a;
        },
        _ => { return acc; },
    }
}

// --- dyn Trait[] ELEMENT reclaim (#4351 slice 3) ------------------------------
//
// A fresh `var xs: dyn T[] = [<literals>]` local owns every element box at
// rc==1 for its whole life: a prim/string literal element is an rc-headered
// op_dyn_box cell (slice 2), a scalar-only leak-safe struct literal element is
// its rc-headered struct box, and array stores are moves (no rc traffic). If
// no element pointer ever outlives the frame, the exit sweep can release each
// element (per-index, kinds recorded at the credit) before the buffer dec —
// the self-host analog of native's __drop_arr_dyn_<set> walk. Kinds: 'p' = a
// plain cell/box dec (prim cell or scalar-only struct box); 's' = a string
// cell (free the sole-owned inner string box at cell@8 first, then dec the
// cell). Any element that doesn't classify uncredits the whole array (sound
// leak, exactly today's behaviour).

// collect_dyn_arr_names: every `var <n>: dyn <T>[] = [<literal>...]` binding
// whose EVERY element is a prim/string literal or a leak-safe scalar-only
// struct literal, as "<binding site>|<kinds>" entries (kinds[i] = 'p'/'s' for
// element i). Keyed on the site rather than the name (#7253), like its scalar
// "DYN:" twin: this collector recurses into nested blocks, so two same-named dyn
// arrays in sibling blocks are two entries with different element lists, and the
// sweep's first-match read handed one block's kinds to the other block's slot.
// The site also survives retire_locals' block-exit rename, which the name does
// not — a block-scoped dyn array was looked up as "!retired!xs", missed, and
// leaked every element box.
function collect_dyn_arr_names(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = collect_dyn_arr_in_stmt(stmt, structs, a); }
    return a;
}
function collect_dyn_arr_in_stmt(st: ast.Stmt, structs: parser.StructDecl[], acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => {
            if (v.type_name.len() > 6 && slice_unchecked(v.type_name, 0, 4) == "dyn " && is_array_type_name(v.type_name)) {
                var kinds: string = "";
                var ok: boolean = false;
                match (v.init) {
                    ast.ExprArray(darr) => {
                        ok = darr.elements.len() > 0;
                        var ei: i32 = 0;
                        while (ok && ei < darr.elements.len()) {
                            match (darr.elements[ei]) {
                                ast.ExprNumber(_) => { kinds = kinds + "p"; },
                                ast.ExprBool(_) => { kinds = kinds + "p"; },
                                ast.ExprString(_) => { kinds = kinds + "s"; },
                                ast.ExprStructLit(slz) => {
                                    if (!slz.has_base && decl_is_struct(structs, slz.type_name)
                                        && decl_is_leaksafe(structs, slz.type_name)
                                        && struct_is_scalar_only(structs, slz.type_name)) { kinds = kinds + "p"; }
                                    else { ok = false; }
                                },
                                // A variant CONSTRUCTION element (#4351 slice 4):
                                // a fresh rc-headered enum box per element — the
                                // plain 'p' dec frees it (pointer payloads leak
                                // with it, safe). Unit variants (bare idents) are
                                // not literals here and fall to the exclusion arm.
                                ast.ExprCall(_) => {
                                    if (variant_ctor_enum_owner(darr.elements[ei], structs).len() > 0) { kinds = kinds + "p"; }
                                    else { ok = false; }
                                },
                                _ => { ok = false; }
                            }
                            ei = ei + 1;
                        }
                    },
                    _ => {}
                }
                if (!ok) { return acc; }
                return acc.append(reclaim_site_key_of(v.name, v.line, v.col) + "|" + kinds);
            }
            return acc;
        },
        ast.StmtIf(iff) => {
            var a: string[] = collect_dyn_arr_names(iff.then_body, structs, acc);
            return collect_dyn_arr_names(iff.else_body, structs, a);
        },
        ast.StmtWhile(w) => { return collect_dyn_arr_names(w.body, structs, acc); },
        ast.StmtFor(f) => { return collect_dyn_arr_names(f.body, structs, acc); },
        ast.StmtMatch(m) => {
            var a: string[] = acc;
            for arm in m.arms { a = collect_dyn_arr_names(arm.body, structs, a); }
            return a;
        },
        _ => { return acc; },
    }
}

// darr_elem_read: `e` is exactly `name[i]` — an element read of the candidate.
function darr_elem_read(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(id) => { return id.name == name; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// darr_elem_dispatch: `e` is exactly `name[i].m(args)` — a trait dispatch on
// an element. The receiver read is a borrow, but the RESULT could alias the
// element (a method may `return self`), so a dispatch is only admitted in
// TRANSIENT positions (statement-expression discard, binary operand) — the
// callers below make that positional choice; this just recognises the shape.
function darr_elem_dispatch(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => { return darr_elem_read(fa.obj, name); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// darr_dispatch_args_unsafe: the args of an admitted element dispatch still
// walk the general hazard check (an element or the array itself passed AS an
// argument escapes).
function darr_dispatch_args_unsafe(e: ast.Expr, name: string, borrowable: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            for arg in c.args {
                if (darr_expr_unsafe(arg, name, borrowable)) { return true; }
            }
            return false;
        },
        _ => { return true; }
    }
    return true;
}

// darr_expr_unsafe: the element-hazard walk for a dyn-array candidate — the
// dyn sibling of strarr_expr_unsafe, tightened because trait methods are
// user-defined (no read-only whitelist is possible): an element read is only
// ever admitted as the receiver of a dispatch in a transient position; the
// array itself only as `name.len()`'s receiver, an index base, or a
// borrowable direct call arg. Everything else that touches `name` — a bare
// alias, a return, a container store, an element binding, a slice, an
// `append`, an element store (`__set_index`'s bare-ident arg) — is a hazard.
function darr_expr_unsafe(e: ast.Expr, name: string, borrowable: string[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprBinary(b) => {
            var lu: boolean = true;
            if (darr_elem_dispatch(b.left, name)) { lu = darr_dispatch_args_unsafe(b.left, name, borrowable); }
            else { lu = darr_expr_unsafe(b.left, name, borrowable); }
            if (lu) { return true; }
            if (darr_elem_dispatch(b.right, name)) { return darr_dispatch_args_unsafe(b.right, name, borrowable); }
            return darr_expr_unsafe(b.right, name, borrowable);
        },
        ast.ExprUnary(u) => { return darr_expr_unsafe(u.operand, name, borrowable); },
        ast.ExprIndex(ix) => {
            // a bare `name[i]` in a general value position is a lasting alias.
            if (darr_elem_read(e, name)) { return true; }
            var base_u: boolean = false;
            match (ix.array) {
                ast.ExprIdent(_) => { base_u = false; },
                _ => { base_u = darr_expr_unsafe(ix.array, name, borrowable); }
            }
            if (base_u) { return true; }
            return darr_expr_unsafe(ix.index, name, borrowable);
        },
        ast.ExprSlice(sl) => {
            if (darr_elem_read(sl.array, name)) { return true; }
            if (darr_expr_unsafe(sl.array, name, borrowable)) { return true; }
            if (darr_expr_unsafe(sl.start, name, borrowable)) { return true; }
            return darr_expr_unsafe(sl.end, name, borrowable);
        },
        ast.ExprCall(c) => {
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    callee_name = cid.name;
                    if (cid.name == name) { return true; }
                },
                ast.ExprFieldAccess(fa) => {
                    if (darr_elem_read(fa.obj, name)) {
                        // element dispatch reaching here is NOT in a transient
                        // position (those were intercepted by the callers) —
                        // its result could alias the element. Hazard.
                        return true;
                    }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            if (rid.name == name && fa.field != "len") { return true; }
                        },
                        _ => { if (darr_expr_unsafe(fa.obj, name, borrowable)) { return true; } }
                    }
                },
                _ => { if (darr_expr_unsafe(c.callee, name, borrowable)) { return true; } }
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                var arg_ok: boolean = false;
                match (c.args[ai]) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == name && callee_name.len() > 0 && param_is_borrowable(borrowable, callee_name, ai)) { arg_ok = true; }
                    },
                    _ => {}
                }
                if (!arg_ok && darr_expr_unsafe(c.args[ai], name, borrowable)) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        ast.ExprFieldAccess(fa) => {
            if (darr_elem_read(fa.obj, name)) { return true; }
            match (fa.obj) {
                ast.ExprIdent(_) => { return false; },
                _ => { return darr_expr_unsafe(fa.obj, name, borrowable); }
            }
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (darr_expr_unsafe(a.elements[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (darr_expr_unsafe(el, name, borrowable)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && darr_expr_unsafe(sl.base, name, borrowable)) { return true; }
            for fv in sl.field_values { if (darr_expr_unsafe(fv, name, borrowable)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => {
            // A VALUE BLOCK is not a closure — see expr_unsafe_for's arm. The
            // dyn-array twin of the string[] case beside it.
            if (parser.is_value_block_origin(lm.origin)) {
                return darr_unsafe_for(lm.body, name, borrowable);
            }
            var used: string[] = [];
            var i: i32 = 0;
            while (i < lm.body.len()) { used = astwalk.collect_idents_stmt(lm.body[i], used); i = i + 1; }
            return util.index_of_str(used, name) >= 0;
        },
        _ => { return true; }
    }
    return true;
}

// darr_unsafe_for: the statement walk over darr_expr_unsafe. A `for x in
// name` is a hazard (the loop var is a lasting element binding this slice
// doesn't track); an element dispatch as a bare statement expression is
// transient-safe (its result is discarded before the sweep).
function darr_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
    for stmt in stmts { if (stmt_darr_unsafe_for(stmt, name, borrowable)) { return true; } }
    return false;
}
function stmt_darr_unsafe_for(st: ast.Stmt, name: string, borrowable: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return darr_expr_unsafe(v.init, name, borrowable); },
        ast.StmtReturn(r) => { return darr_expr_unsafe(r.value, name, borrowable); },
        ast.StmtExpr(e) => {
            if (darr_elem_dispatch(e.value, name)) { return darr_dispatch_args_unsafe(e.value, name, borrowable); }
            return darr_expr_unsafe(e.value, name, borrowable);
        },
        ast.StmtAssign(a) => {
            if (a.target == name) { return true; }   // any reassignment (incl. self-append)
            if (darr_elem_dispatch(a.value, name)) { return darr_dispatch_args_unsafe(a.value, name, borrowable); }
            return darr_expr_unsafe(a.value, name, borrowable);
        },
        ast.StmtIf(f) => {
            if (darr_expr_unsafe(f.cond, name, borrowable)) { return true; }
            return darr_unsafe_for(f.then_body, name, borrowable) || darr_unsafe_for(f.else_body, name, borrowable);
        },
        ast.StmtWhile(w) => {
            if (darr_expr_unsafe(w.cond, name, borrowable)) { return true; }
            return darr_unsafe_for(w.body, name, borrowable);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(fid) => { iter_unsafe = fid.name == name; },   // `for x in name`: element binding
                _ => { iter_unsafe = darr_expr_unsafe(fo.iter, name, borrowable); }
            }
            if (iter_unsafe) { return true; }
            return darr_unsafe_for(fo.body, name, borrowable);
        },
        ast.StmtMatch(m) => {
            if (darr_expr_unsafe(m.scrutinee, name, borrowable)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && darr_expr_unsafe(arm.guard, name, borrowable)) { return true; }
                if (darr_unsafe_for(arm.body, name, borrowable)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_darr_unsafe_for(d.action, name, borrowable); },
        _ => { return false; }
    }
    return false;
}

// moves_fields_expr: does `name` appear in `e` as a method RECEIVER —
// `name.m(...)` — anywhere in the expression tree? That is the ONE position
// where a use can carry `name`'s rc FIELD values into a surviving value with
// no counted reference: the method body can return a struct built from
// `self`'s fields (`ops: self.ops.append(op)`, the builder shape), and when
// the `.append` is in place it hands the receiver's rc==1 buffer straight to
// its result. The escape analysis that credits a reclaimable struct treats a
// method receiver as a BORROW (so the builder chain stays reclaimable), which
// is exactly why the sweep would otherwise deep-drop a receiver whose field
// has escaped — the #3425 residual.
//
// Deliberately NOT flagged (they are borrows / balanced for any CREDITED
// struct, so flagging them only strands the field — the string-only-struct
// reclaim leak):
//   - a bare call ARGUMENT `f(name)` — a credited struct only ever reaches a
//     BORROWABLE param (a non-borrowable/own arg escapes, so body_unsafe_for
//     would not credit it), and a borrowable param is read-only;
//   - a struct-update BASE `T { ...name, .. }` when `spread_counted` says every
//     field of name's type copies COUNTED (a scalar, or a string / enum /
//     nested-struct field the base copy retains — spread_copy_counted), so the
//     deep drop is balanced (dec, not free). A type with an array, tuple, map,
//     option or closure field copies that field uncounted, and such a base IS
//     flagged: the caller passes false when it cannot vouch for the type;
//   - a closure CAPTURE that merely READS `name`'s fields — a borrow;
//   - a field / index READ (`name.f`, `name[i]`).
// So a read-only / borrow-only local keeps its deep drop and its string field
// reclaims. The recursion is exhaustive over every Expr variant (leaves return
// false), so a receiver buried in a nested sub-expression / lambda body is
// still found.
// `nomove` lists the call names in `name.<f>(...)` position that provably move
// nothing, so the receiver hazard does not apply to them. Two sources feed it,
// both computed at the call site from `name`'s struct type:
//
//   - the fn-typed FIELD names (clo_field_names_of): `name.f(args)` where f is
//     such a field is a FIELD-CLOSURE CALL, not a user method — the closure sees
//     only its args + captures (built before `name` existed), so it cannot move
//     `name`'s fields into its result;
//   - the METHOD names whose receiver recv_borrow_fns_of proved a pure borrow.
//
// Pass [] when the receiver's type is unknown (every method receiver marks).
function moves_fields_expr(e: ast.Expr, name: string, nomove: string[], spread_counted: boolean): boolean {
    match (e) {
        ast.ExprBinary(b) => { return moves_fields_expr(b.left, name, nomove, spread_counted) || moves_fields_expr(b.right, name, nomove, spread_counted); },
        ast.ExprUnary(u) => { return moves_fields_expr(u.operand, name, nomove, spread_counted); },
        ast.ExprIndex(ix) => { return moves_fields_expr(ix.array, name, nomove, spread_counted) || moves_fields_expr(ix.index, name, nomove, spread_counted); },
        ast.ExprSlice(sl) => { return moves_fields_expr(sl.array, name, nomove, spread_counted) || moves_fields_expr(sl.start, name, nomove, spread_counted) || moves_fields_expr(sl.end, name, nomove, spread_counted); },
        ast.ExprFieldAccess(fa) => { return moves_fields_expr(fa.obj, name, nomove, spread_counted); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            // method receiver — the hazard (except a field-closure call)
                            if (rid.name == name && util.index_of_str(nomove, fa.field) < 0) { return true; }
                        },
                        _ => { if (moves_fields_expr(fa.obj, name, nomove, spread_counted)) { return true; } }
                    }
                },
                _ => { if (moves_fields_expr(c.callee, name, nomove, spread_counted)) { return true; } }
            }
            for arg in c.args {
                if (moves_fields_expr(arg, name, nomove, spread_counted)) { return true; }   // a receiver nested inside an arg
            }
            return false;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (moves_fields_expr(a.elements[i], name, nomove, spread_counted)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (moves_fields_expr(el, name, nomove, spread_counted)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            // A BARE-IDENT base copies name's fields into the new box, and an
            // array / tuple / map / option / closure field goes with no inc
            // (op_struct_copy, and the per-field path's array copy), so the
            // new value and name alias the same buffers. Deep-dropping name
            // would free them out from under it — the NODEEP hazard, in the
            // same class as a method receiver. `spread_counted` is the
            // caller's word that every field of name's type copies counted,
            // which makes the base a borrow. The SELF-update
            // `name = T { ...name, … }` is exempted by moves_fields_stmt: there
            // the two boxes are the same slot's before and after, so ownership
            // moves forward rather than being shared.
            if (sl.has_base) {
                match (sl.base) {
                    ast.ExprIdent(bid) => { if (bid.name == name && !spread_counted) { return true; } },
                    _ => { if (moves_fields_expr(sl.base, name, nomove, spread_counted)) { return true; } }
                }
            }
            for fv in sl.field_values { if (moves_fields_expr(fv, name, nomove, spread_counted)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => { return moves_fields_stmts(lm.body, name, nomove, spread_counted); },   // a receiver used inside the closure body
        _ => { return false; }   // ExprIdent / ExprNumber / ExprString / ExprBool / ExprUnknown — leaves, no move
    }
    return false;
}

function moves_fields_stmts(stmts: ast.Stmt[], name: string, nomove: string[], spread_counted: boolean): boolean {
    for stmt in stmts { if (moves_fields_stmt(stmt, name, nomove, spread_counted)) { return true; } }
    return false;
}

// struct_box_sink_stored: `name`'s WHOLE BOX appears as a CONTAINER counted-sink
// element — an append/with arg, an array or tuple element, or a variant-ctor
// payload. The routed struct gate refuses such a name, and the refusal is exactly
// as wide as the retain is narrow.
//
// The plan's counted-sink forgiveness assumes the store retains. A struct-literal
// FIELD does, unconditionally, at the nested-struct / enum arms of the
// ExprStructLit lowering — so that position is NOT a sink here and the gate takes
// the forgiveness for it (that is what makes struct__local clean). A SELF-APPEND
// does too, and so does an ARRAY-LITERAL element — but only at the sites the
// ARRSTRUCT pass stamped "APOWNED:", which is why those stamps are threaded in: a
// stamp is issued exactly where the container earned its element walk, and it is
// keyed on the SITE, so a retired slot cannot fall through it the way
// `slot_is_reclaimable_struct` did.
//
// Every other container sink still refuses, and must. An append or array literal
// whose container is UNCREDITED stores an element pointer nothing retained and can
// carry it past the source's scope through a return; `with`, a tuple element, and
// a variant payload have no retain at all.
//
// The field-move detectors (moves_fields_* / optstruct_body_moves_field) cannot
// see this shape — a bare ident is a leaf there. A struct-lit BASE
// (`T { ...name, … }`) is not a sink either — see the StructLit arm.
function struct_box_sink_stored_expr(e: ast.Expr, name: string, structs: parser.StructDecl[], apretain: string[], msites: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var sink: boolean = false;
            // The variant being constructed, "" if this is not a ctor call: its
            // payload FIELD TYPES are what decide whether an argument was retained.
            var vsink: string = "";
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if ((fa.field == "append" && c.args.len() == 1) || (fa.field == "with" && c.args.len() == 2)) { sink = true; }
                    // The QUALIFIED variant ctor `E.A(p)` is the same sink as the
                    // unqualified `A(p)` the ident arm below catches, and it reaches
                    // here instead because its callee is a field access.
                    // fresh_rcpayload_enum_init has carried both spellings all along;
                    // this arm had only append / with, so `p` kept its struct credit
                    // on one spelling and lost it on the other. Measured: 300/200 for
                    // `E.A(p)` against 300/0 for `A(p)`, same program otherwise. That
                    // is also a latent OVER-release rather than a mere inconsistency —
                    // the moment the enum earns a payload drop, the credited `p` and
                    // the enum both release the same box.
                    if (variant_enum_owner(structs, fa.field).len() > 0) { sink = true; vsink = fa.field; }
                    if (struct_box_sink_stored_expr(fa.obj, name, structs, apretain, msites)) { return true; }
                },
                ast.ExprIdent(cid) => {
                    if (variant_enum_owner(structs, cid.name).len() > 0) { sink = true; vsink = cid.name; }
                },
                _ => {}
            }
            var ci: i32 = 0;
            while (ci < c.args.len()) {
                var arg: ast.Expr = c.args[ci];
                if (sink) {
                    match (arg) {
                        ast.ExprIdent(aid) => {
                            // A self-append the ARRSTRUCT pass STAMPED is a counted
                            // share, not an uncounted sink: the container earned its
                            // element walk and the append retains at this exact site,
                            // so the source keeps a claim of its own to release. Both
                            // walks are rc-gated, so whichever owner reaches rc 1 does
                            // the deep work once. Every unstamped sink — an append into
                            // an uncredited container, `with`, an array or tuple
                            // element, a variant payload — still refuses.
                            // A variant-ctor payload the construction RETAINED is
                            // the same counted share: lower_variant_ctor_args incs a
                            // bare-ident struct payload of a releasable field type,
                            // skipping only a MOVE site — and at a move site the enum
                            // is sole owner, so the source must still be refused. Both
                            // releases are rc-gated (emit_enum_variant_payload_drops
                            // walks the payload under __fern_rc_is_unique), so the two
                            // owners cannot both do the deep work.
                            var vcounted: boolean = vsink.len() > 0
                                && variant_counted_struct_payload(arg, decl_field_type_at(structs, vsink, ci), structs)
                                && !moved_ident_at(arg, msites);
                            if (aid.name == name
                                && !vcounted
                                && !reclaim_has(apretain, "APOWNED:", util.i32_to_string(aid.line) + ":" + util.i32_to_string(aid.col))) {
                                return true;
                            }
                        },
                        _ => {}
                    }
                }
                if (struct_box_sink_stored_expr(arg, name, structs, apretain, msites)) { return true; }
                ci = ci + 1;
            }
            return false;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                match (a.elements[i]) {
                    // An element of a literal the ARRSTRUCT pass stamped is a
                    // counted share, not an uncounted sink — same rule, same
                    // stamps, as the self-append arg above.
                    ast.ExprIdent(eid) => {
                        if (eid.name == name
                            && !reclaim_has(apretain, "APOWNED:", util.i32_to_string(eid.line) + ":" + util.i32_to_string(eid.col))) { return true; }
                    },
                    _ => { if (struct_box_sink_stored_expr(a.elements[i], name, structs, apretain, msites)) { return true; } }
                }
                i = i + 1;
            }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements {
                match (el) {
                    // A tuple element the literal RETAINED is a counted share, not
                    // an uncounted sink — the same rule as the array literal's
                    // element and the variant ctor's payload. A MOVED element still
                    // refuses: there the tuple is sole owner and its walk is the one
                    // release, which is what tuple__moved measures.
                    ast.ExprIdent(eid) => {
                        if (eid.name == name && moved_ident_at(el, msites)) { return true; }
                    },
                    _ => { if (struct_box_sink_stored_expr(el, name, structs, apretain, msites)) { return true; } }
                }
            }
            return false;
        },
        ast.ExprStructLit(sl) => {
            // A bare-ident BASE is a field-COPY — a borrow of the box, not a
            // store of it — so it is NOT a sink: the box stays the local's to
            // free (box-only via the moves_fields NODEEP marking; the
            // alloc_flat_struct_self_update fork_base shape). Only nested
            // sinks inside the base expression walk.
            if (sl.has_base) {
                match (sl.base) {
                    ast.ExprIdent(_) => {},
                    _ => { if (struct_box_sink_stored_expr(sl.base, name, structs, apretain, msites)) { return true; } }
                }
            }
            // A bare-ident FIELD VALUE is a COUNTED share: the nested-struct and
            // enum arms of the ExprStructLit lowering retain it unconditionally,
            // so the source keeps a claim its own release balances. Not a sink —
            // only nested sinks inside a field value walk.
            for fv in sl.field_values {
                match (fv) {
                    ast.ExprIdent(_) => {},
                    _ => { if (struct_box_sink_stored_expr(fv, name, structs, apretain, msites)) { return true; } }
                }
            }
            return false;
        },
        ast.ExprBinary(b) => { return struct_box_sink_stored_expr(b.left, name, structs, apretain, msites) || struct_box_sink_stored_expr(b.right, name, structs, apretain, msites); },
        ast.ExprUnary(u) => { return struct_box_sink_stored_expr(u.operand, name, structs, apretain, msites); },
        ast.ExprIndex(ix) => { return struct_box_sink_stored_expr(ix.array, name, structs, apretain, msites) || struct_box_sink_stored_expr(ix.index, name, structs, apretain, msites); },
        ast.ExprFieldAccess(fa2) => { return struct_box_sink_stored_expr(fa2.obj, name, structs, apretain, msites); },
        ast.ExprLambda(lm) => { return struct_box_sink_stored_stmts(lm.body, name, structs, apretain, msites); },
        _ => { return false; }
    }
    return false;
}

function struct_box_sink_stored_stmts(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], apretain: string[], msites: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (struct_box_sink_stored_expr(v.init, name, structs, apretain, msites)) { return true; } },
            ast.StmtAssign(a) => { if (struct_box_sink_stored_expr(a.value, name, structs, apretain, msites)) { return true; } },
            ast.StmtReturn(r) => { if (struct_box_sink_stored_expr(r.value, name, structs, apretain, msites)) { return true; } },
            ast.StmtExpr(e) => { if (struct_box_sink_stored_expr(e.value, name, structs, apretain, msites)) { return true; } },
            ast.StmtIf(f) => {
                if (struct_box_sink_stored_expr(f.cond, name, structs, apretain, msites)) { return true; }
                if (struct_box_sink_stored_stmts(f.then_body, name, structs, apretain, msites)) { return true; }
                if (struct_box_sink_stored_stmts(f.else_body, name, structs, apretain, msites)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (struct_box_sink_stored_expr(w.cond, name, structs, apretain, msites)) { return true; }
                if (struct_box_sink_stored_stmts(w.body, name, structs, apretain, msites)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (struct_box_sink_stored_expr(fo.iter, name, structs, apretain, msites)) { return true; }
                if (struct_box_sink_stored_stmts(fo.body, name, structs, apretain, msites)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (struct_box_sink_stored_expr(m.scrutinee, name, structs, apretain, msites)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && struct_box_sink_stored_expr(arm.guard, name, structs, apretain, msites)) { return true; }
                    if (struct_box_sink_stored_stmts(arm.body, name, structs, apretain, msites)) { return true; }
                }
            },
            ast.StmtDefer(d) => {
                var one: ast.Stmt[] = [d.action];
                if (struct_box_sink_stored_stmts(one, name, structs, apretain, msites)) { return true; }
            },
            _ => {}
        }
    }
    return false;
}

// struct_counted_share_stmts: `name`'s whole box appears as a bare-ident value in
// a position that RETAINS it — a struct-literal FIELD (the nested-struct / enum
// arms of the ExprStructLit lowering retain unconditionally), or a self-append or
// ARRAY-LITERAL element of a container whose element walk is credited. Either way the source keeps a
// claim its own release must balance, and both owners then run their deep field
// walk under __fern_rc_is_unique so whichever reaches rc 1 does it once. The
// marker it feeds ("SINKSHARE:") is what narrows the rc-gated field walk to
// exactly these names.
function struct_counted_share_expr(e: ast.Expr, name: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprStructLit(sl) => {
            for fv in sl.field_values {
                match (fv) {
                    ast.ExprIdent(fid) => { if (fid.name == name) { return true; } },
                    _ => { if (struct_counted_share_expr(fv, name, structs)) { return true; } }
                }
            }
            if (sl.has_base) { return struct_counted_share_expr(sl.base, name, structs); }
            return false;
        },
        ast.ExprCall(c) => {
            // `xs.append(name)` — the container sink. The bare ident is not a
            // struct-literal field, so it only reaches here. No stamp check: this
            // walk runs only for names the sink gate already admitted, and that
            // gate admits an appended name only when every one of its appends is
            // stamped.
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "append" && c.args.len() == 1) {
                        match (c.args[0]) {
                            ast.ExprIdent(aid) => { if (aid.name == name) { return true; } },
                            _ => {}
                        }
                    }
                    // `ps = ps.with(i, name)` stores the box under the same counted
                    // retain the self-append takes (emit_arrstruct_with_store), so
                    // the source keeps a claim and its sweep must be rc-gated too.
                    // Without this the source walks its fields STATICALLY while the
                    // container's element walk is gated, and both free every buffer:
                    // 500/500 with allocs == frees at live_bytes 0, and only
                    // __rc_underflow_count() dissenting.
                    if (cfa.field == "with" && c.args.len() == 2) {
                        match (c.args[1]) {
                            ast.ExprIdent(wid) => { if (wid.name == name) { return true; } },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            // `Some(name)` / `Ok(name)` / `Err(name)` — lower_opt_make_payload retains
            // the box here, so the option co-owns it and both releases are live.
            if (builtin_union_ctor(c.callee) && c.args.len() == 1) {
                match (c.args[0]) {
                    ast.ExprIdent(uid) => { if (uid.name == name) { return true; } },
                    _ => {}
                }
            }
            // `A(name)` / `E.A(name)` — a variant payload lower_variant_ctor_args
            // retained. Without this the source's sweep walks its fields STATICALLY
            // while the enum's walk is rc-gated, so which of the two frees the
            // buffers depends on which sweep runs first: measured as exit 99 on a
            // live payload, with allocs == frees at live_bytes 0 and only
            // __rc_underflow_count() dissenting. Gating both makes the order
            // irrelevant. No move test: a MOVED payload never reaches here, because
            // struct_box_sink_stored refuses that name its credit outright.
            var csv: string = "";
            match (c.callee) {
                ast.ExprIdent(cvid) => { if (variant_enum_owner(structs, cvid.name).len() > 0) { csv = cvid.name; } },
                ast.ExprFieldAccess(cvfa) => { if (variant_enum_owner(structs, cvfa.field).len() > 0) { csv = cvfa.field; } },
                _ => {}
            }
            if (csv.len() > 0) {
                var cvi: i32 = 0;
                while (cvi < c.args.len()) {
                    match (c.args[cvi]) {
                        ast.ExprIdent(cvaid) => {
                            if (cvaid.name == name
                                && variant_counted_struct_payload(c.args[cvi], decl_field_type_at(structs, csv, cvi), structs)) { return true; }
                        },
                        _ => {}
                    }
                    cvi = cvi + 1;
                }
            }
            for arg in c.args { if (struct_counted_share_expr(arg, name, structs)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return struct_counted_share_expr(b.left, name, structs) || struct_counted_share_expr(b.right, name, structs); },
        ast.ExprUnary(u) => { return struct_counted_share_expr(u.operand, name, structs); },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                // `var ps: P[] = [name]` — the literal sibling of the append arm
                // above, and the same reasoning about stamps: the sink gate only
                // admitted this name if the literal's element sites were stamped.
                match (a.elements[i]) {
                    ast.ExprIdent(eid) => { if (eid.name == name) { return true; } },
                    _ => { if (struct_counted_share_expr(a.elements[i], name, structs)) { return true; } }
                }
                i = i + 1;
            }
            return false;
        },
        ast.ExprTuple(t) => {
            // `var tp: (i32, P) = (i, name)` — the tuple literal retains a struct
            // element, so the source keeps a claim of its own and both walks have to
            // be rc-gated. Recursing past a BARE ident (as this arm did) reaches only
            // nested containers, and a bare ident is the whole shape here.
            for el in t.elements {
                match (el) {
                    ast.ExprIdent(tid) => { if (tid.name == name) { return true; } },
                    _ => { if (struct_counted_share_expr(el, name, structs)) { return true; } }
                }
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function struct_counted_share_stmts(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (struct_counted_share_expr(v.init, name, structs)) { return true; } },
            ast.StmtAssign(a) => { if (struct_counted_share_expr(a.value, name, structs)) { return true; } },
            ast.StmtReturn(r) => { if (struct_counted_share_expr(r.value, name, structs)) { return true; } },
            ast.StmtExpr(e) => { if (struct_counted_share_expr(e.value, name, structs)) { return true; } },
            ast.StmtIf(f) => {
                if (struct_counted_share_expr(f.cond, name, structs)) { return true; }
                if (struct_counted_share_stmts(f.then_body, name, structs)) { return true; }
                if (struct_counted_share_stmts(f.else_body, name, structs)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (struct_counted_share_expr(w.cond, name, structs)) { return true; }
                if (struct_counted_share_stmts(w.body, name, structs)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (struct_counted_share_expr(fo.iter, name, structs)) { return true; }
                if (struct_counted_share_stmts(fo.body, name, structs)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (struct_counted_share_expr(m.scrutinee, name, structs)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && struct_counted_share_expr(arm.guard, name, structs)) { return true; }
                    if (struct_counted_share_stmts(arm.body, name, structs)) { return true; }
                }
            },
            ast.StmtDefer(d) => {
                var one: ast.Stmt[] = [d.action];
                if (struct_counted_share_stmts(one, name, structs)) { return true; }
            },
            _ => {}
        }
    }
    return false;
}

// struct_lit_unretained_borrow_field: the credited candidate's own struct
// literal (found by its binding-site key) carries a BORROW-shaped value —
// a bare ident, field access, index or slice — in an rc field kind the
// construction does NOT retain. The retain arms cover nested-struct, enum,
// leak-safe scalar-array and struct-array fields (the
// fieldmove_counted_field_alias qualification list); string, string[],
// enum-array and every other rc kind reach the new box UNCOUNTED, so the
// deep field walk frees a buffer the SOURCE still owns — the
// flatten__RewriteCtx wasm fault: `RewriteCtx { ivar_names: ctx.ivar_names,
// … }` rebuilt per loop iteration deep-dropped ctx's arrays out from under
// the caller. Box-only is the sound release role for such a box; a fresh
// value (literal / ctor / call) transfers ownership and keeps the deep drop.
function struct_lit_unretained_borrow_field(stmts: ast.Stmt[], key: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (reclaim_site_key_of(v.name, v.line, v.col) == key) {
                    match (v.init) {
                        ast.ExprStructLit(sl) => {
                            var i: i32 = 0;
                            while (i < sl.field_values.len()) {
                                // A bare IDENT value is NOT marked: the
                                // construction's fallback retain admits bare
                                // idents (the strfld admission — the
                                // BorrowedFieldRetain contract), so the deep
                                // drop stays balanced there. Only the READ
                                // shapes reach the box uncounted.
                                var borrow: boolean = false;
                                match (sl.field_values[i]) {
                                    ast.ExprFieldAccess(_) => { borrow = true; },
                                    ast.ExprIndex(_) => { borrow = true; },
                                    ast.ExprSlice(_) => { borrow = true; },
                                    _ => {}
                                }
                                if (borrow && i < sl.field_names.len()) {
                                    var ft: string = decl_field_type(structs, sl.type_name, sl.field_names[i]);
                                    if (!is_scalar_type_name(ft) && !decl_is_struct(structs, ft) && !decl_is_enum(structs, ft)
                                        && !is_leaksafe_array_field(ft) && !is_struct_array_field_type(structs, ft)) {
                                        return true;
                                    }
                                }
                                i = i + 1;
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                if (struct_lit_unretained_borrow_field(f.then_body, key, structs)) { return true; }
                if (struct_lit_unretained_borrow_field(f.else_body, key, structs)) { return true; }
            },
            ast.StmtWhile(w) => { if (struct_lit_unretained_borrow_field(w.body, key, structs)) { return true; } },
            ast.StmtFor(fo) => { if (struct_lit_unretained_borrow_field(fo.body, key, structs)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (struct_lit_unretained_borrow_field(arm.body, key, structs)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

function moves_fields_stmt(st: ast.Stmt, name: string, nomove: string[], spread_counted: boolean): boolean {
    match (st) {
        ast.StmtVar(v) => { return moves_fields_expr(v.init, name, nomove, spread_counted); },
        ast.StmtReturn(r) => { return moves_fields_expr(r.value, name, nomove, spread_counted); },
        ast.StmtExpr(e) => { return moves_fields_expr(e.value, name, nomove, spread_counted); },
        ast.StmtAssign(a) => {
            // SELF-rebind exemption: `name = name.emit(op)` / `name = f(name)`
            // (the #3456 builder chain) keeps its per-rebind reclaim — the cow
            // guard is sound for a self-derived result: a field carried into
            // the new value compares EQUAL (skip), a field it dropped is the
            // dead old box's sole reference (free OK). Only the TOP-LEVEL
            // receiver/arg position is exempt; `name` moved anywhere deeper in
            // the RHS still marks.
            if (a.target == name) {
                match (a.value) {
                    ast.ExprCall(sc) => {
                        var deep_move: boolean = false;
                        match (sc.callee) {
                            ast.ExprFieldAccess(sfa) => {
                                match (sfa.obj) {
                                    ast.ExprIdent(_) => {},
                                    _ => { if (moves_fields_expr(sfa.obj, name, nomove, spread_counted)) { deep_move = true; } }
                                }
                            },
                            _ => { if (moves_fields_expr(sc.callee, name, nomove, spread_counted)) { deep_move = true; } }
                        }
                        var sai: i32 = 0;
                        while (sai < sc.args.len()) {
                            match (sc.args[sai]) {
                                ast.ExprIdent(_) => {},
                                _ => { if (moves_fields_expr(sc.args[sai], name, nomove, spread_counted)) { deep_move = true; } }
                            }
                            sai = sai + 1;
                        }
                        return deep_move;
                    },
                    // `name = T { ...name, … }` — the same exemption for the
                    // functional-update form. The copied fields land in the box
                    // this very slot is about to hold, so ownership moves
                    // forward instead of being shared with a second live value,
                    // and the superseded box's deep drop stays sound. Only the
                    // TOP-LEVEL base is exempt; `name` anywhere in an override
                    // value still marks.
                    ast.ExprStructLit(ssl) => {
                        var base_self: boolean = false;
                        if (ssl.has_base) {
                            match (ssl.base) {
                                ast.ExprIdent(sbid) => { base_self = sbid.name == name; },
                                _ => {}
                            }
                        }
                        if (!base_self) { return moves_fields_expr(a.value, name, nomove, spread_counted); }
                        var sfi: i32 = 0;
                        while (sfi < ssl.field_values.len()) {
                            if (moves_fields_expr(ssl.field_values[sfi], name, nomove, spread_counted)) { return true; }
                            sfi = sfi + 1;
                        }
                        return false;
                    },
                    _ => { return moves_fields_expr(a.value, name, nomove, spread_counted); }
                }
            }
            return moves_fields_expr(a.value, name, nomove, spread_counted);
        },
        ast.StmtIf(f) => {
            if (moves_fields_expr(f.cond, name, nomove, spread_counted)) { return true; }
            return moves_fields_stmts(f.then_body, name, nomove, spread_counted) || moves_fields_stmts(f.else_body, name, nomove, spread_counted);
        },
        ast.StmtWhile(w) => {
            if (moves_fields_expr(w.cond, name, nomove, spread_counted)) { return true; }
            return moves_fields_stmts(w.body, name, nomove, spread_counted);
        },
        ast.StmtFor(fo) => {
            if (moves_fields_expr(fo.iter, name, nomove, spread_counted)) { return true; }
            return moves_fields_stmts(fo.body, name, nomove, spread_counted);
        },
        ast.StmtMatch(m) => {
            if (moves_fields_expr(m.scrutinee, name, nomove, spread_counted)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && moves_fields_expr(arm.guard, name, nomove, spread_counted)) { return true; }
                if (moves_fields_stmts(arm.body, name, nomove, spread_counted)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return moves_fields_stmt(d.action, name, nomove, spread_counted); },
        _ => { return false; }
    }
    return false;
}

// recv_borrow_fns_of: the "<Type>.<method>" keys whose RECEIVER is a pure
// BORROW — the callee-side answer to the hazard moves_fields_expr guards
// against caller-side.
//
// `b.score()` costs `b` its DEEP drop today: moves_fields_expr marks every
// method receiver, because a method body CAN carry a receiver field into its
// result with no counted reference. Most cannot, and each one that cannot
// strands the receiver's rc fields for the whole scope — 22 bytes per round on
// a one-string struct, and the shared cost under every method row in
// docs/RC-PERCEUS-SELF-HOST-PORT.md §9.
//
// A method qualifies when its receiver behaves exactly like a deep-drop-worthy
// LOCAL, proven by the same three predicates reclaimable_names_of runs over one:
//
//   - body_unsafe_for — the box itself does not escape (`return self`, a
//     container store, an alias, a non-borrowable arg);
//   - moves_fields_stmts — no receiver-POSITION hazard inside, i.e. `self.m2()`
//     disqualifies. That is what keeps this non-circular: no method that calls
//     through its own receiver enters the registry, so no entry rests on
//     another;
//   - optstruct_body_moves_field — no field of `self` reaches a bind / assign /
//     return value, a non-borrowable call argument, or a container element.
//
// A method whose ONLY escape is a bare `return self` — the `if (t.len() == 0)
// { return b; }` shape every builder-ish method opens with — earns the weaker
// "RECVIDENT:" key instead. Its result MAY be the receiver's own box, so the
// deep drop is sound only where nothing that outlives the receiver holds that
// result. That is a call-site question and recv_ident_methods_of answers it;
// the key carries the callee half.
//
// Struct receivers only: the marker it feeds is the struct deep drop.
pub function recv_borrow_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[], borrowable: string[]): string[] {
    var out: string[] = [];
    var none: string[] = [];
    for fn in funcs {
        if (fn.receiver_type.len() > 0 && fn.receiver_name.len() > 0) {
            var rty: string = util.base_type_name(fn.receiver_type);
            // A STRING receiver earns the plain key on body_unsafe_for alone:
            // the two field-hazard predicates below are about carrying a FIELD
            // of the receiver out, and a string has none. What is left is the
            // question that matters at a caller-side release — does the box
            // escape — and body_unsafe_for already answers it, refusing a bare
            // `return s` (an identity return) and `return slice_unchecked(s, a, b)`
            // (a view of the receiver) alike, since both are escapes for it.
            if (rty == "string") {
                if (body_returns_bare_ident(fn.body, fn.receiver_name)) {
                    out = out.append("RECVRET:" + rty + "." + fn.name);
                }
                if (!body_unsafe_for(fn.body, fn.receiver_name, borrowable, [])) {
                    out = out.append(rty + "." + fn.name);
                }
            }
            if (decl_is_struct(structs, rty)) {
                // "RECVRET:" is the widest and the only UNCONDITIONAL class: the
                // body returns the bare receiver somewhere, so the result MAY be
                // the receiver's own box. Independent of the other two
                // predicates — a method that also moves a field can still hand
                // its receiver back, and the caller's credit gate has to know.
                if (body_returns_bare_ident(fn.body, fn.receiver_name)) {
                    out = out.append("RECVRET:" + rty + "." + fn.name);
                }
                if (!moves_fields_stmts(fn.body, fn.receiver_name, none, false)
                    && !optstruct_body_moves_field(fn.body, fn.receiver_name, rty, structs, borrowable)) {
                    if (!body_unsafe_for(fn.body, fn.receiver_name, borrowable, [])) {
                        out = out.append(rty + "." + fn.name);
                    }
                    // Second tier: the ONLY escape is that bare `return self`.
                    // Sound for the caller wherever nothing outliving the
                    // receiver holds the result, which is a call-site question —
                    // the key carries the callee half and recv_ident_methods_of
                    // decides the rest.
                    else if (!body_unsafe_for_allow_ret(fn.body, fn.receiver_name, borrowable, [])) {
                        out = out.append("RECVIDENT:" + rty + "." + fn.name);
                    }
                }
            }
        }
    }
    return out;
}

// body_returns_bare_ident: some `return name;` in `stmts` hands `name` itself
// back, rather than a value derived from it.
function body_returns_bare_ident(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (stmt_returns_bare_ident(stmt, name)) { return true; } }
    return false;
}
function stmt_returns_bare_ident(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprIdent(rid) => { return rid.name == name; },
                _ => { return false; }
            }
        },
        ast.StmtIf(f) => {
            return body_returns_bare_ident(f.then_body, name) || body_returns_bare_ident(f.else_body, name);
        },
        ast.StmtWhile(w) => { return body_returns_bare_ident(w.body, name); },
        ast.StmtFor(fo) => { return body_returns_bare_ident(fo.body, name); },
        ast.StmtMatch(m) => {
            for arm in m.arms { if (body_returns_bare_ident(arm.body, name)) { return true; } }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_returns_bare_ident(d.action, name); },
        _ => { return false; }
    }
    return false;
}

// recv_borrow_escapes_via_result: `name` is credited on the strength of a
// method RECEIVER being a borrow, but a method that hands its receiver BACK
// turns that call into a move — `keep = b.me()` leaves `keep` holding b's own
// box, and b's per-rebind reclaim then frees memory `keep` still reads
// (measured: __rc_underflow() ticks, over-release not leak).
//
// So the borrow reading is only good while no "RECVRET:" method's result on
// `name` reaches a move position. This is the CREDIT gate; the NODEEP
// exemption asks the narrower recv_ident_methods_of question separately.
function recv_borrow_escapes_via_result(recv_borrow: string[], sty: string, body: ast.Stmt[], name: string, borrowable: string[]): boolean {
    if (sty.len() == 0) { return false; }
    var pfx: string = "RECVRET:" + sty + ".";
    var i: i32 = 0;
    while (i < recv_borrow.len()) {
        if (recv_borrow[i].len() > pfx.len() && slice_unchecked(recv_borrow[i], 0, pfx.len()) == pfx) {
            var m: string = slice_unchecked(recv_borrow[i], pfx.len(), recv_borrow[i].len()) + "";
            if (method_result_moved_stmts(body, name, m, borrowable)) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// recv_borrow_methods_of names the methods in `recv_borrow` declared on struct
// type `sty`, as the bare method names moves_fields_expr compares a
// `name.<f>(...)` call against.
function recv_borrow_methods_of(recv_borrow: string[], sty: string): string[] {
    var out: string[] = [];
    if (sty.len() == 0) { return out; }
    var pfx: string = sty + ".";
    var i: i32 = 0;
    while (i < recv_borrow.len()) {
        if (recv_borrow[i].len() > pfx.len() && slice_unchecked(recv_borrow[i], 0, pfx.len()) == pfx) {
            out = out.append(slice_unchecked(recv_borrow[i], pfx.len(), recv_borrow[i].len()) + "");
        }
        i = i + 1;
    }
    return out;
}

// recv_ident_methods_of is recv_borrow_methods_of for the "RECVIDENT:" tier,
// filtered by the CALL-SITE half those keys are missing: an identity-returning
// method's result may be the receiver's own box, so `name` keeps its deep drop
// only while no call of that method in `body` hands the result to something
// that outlives `name`.
//
// `t = t + b.relabel("x").tag.len()` is the admitted shape — the result is read
// through and dies. `var c = b.relabel("x")` is not: `c` outlives nothing here
// but IS a live alias of b's box at b's death, and relabel is in no fresh-ret
// registry so `c` is never separately credited, which makes the deep drop a
// dangle rather than a leak.
//
// The refused positions are exactly fieldmove's move vocabulary — a bind /
// assign / return value, a call argument, a container element — asked of the
// CALL expression rather than of a field chain.
function recv_ident_methods_of(recv_borrow: string[], sty: string, body: ast.Stmt[], name: string, borrowable: string[]): string[] {
    var out: string[] = [];
    if (sty.len() == 0) { return out; }
    var pfx: string = "RECVIDENT:" + sty + ".";
    var i: i32 = 0;
    while (i < recv_borrow.len()) {
        if (recv_borrow[i].len() > pfx.len() && slice_unchecked(recv_borrow[i], 0, pfx.len()) == pfx) {
            var m: string = slice_unchecked(recv_borrow[i], pfx.len(), recv_borrow[i].len()) + "";
            if (!method_result_moved_stmts(body, name, m, borrowable)) { out = out.append(m); }
        }
        i = i + 1;
    }
    return out;
}

// method_result_moved_expr: does the RESULT of `name.<method>(...)` reach a
// move position anywhere in `e`? `is_val` says whether `e` itself sits in one,
// so the call is checked against its own position and the recursion re-answers
// it per sub-expression.
function method_result_moved_expr(e: ast.Expr, name: string, method: string, is_val: boolean, borrowable: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var is_target: boolean = false;
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ast.ExprIdent(rid) => { is_target = rid.name == name && fa.field == method; },
                        _ => {}
                    }
                },
                ast.ExprIdent(cid) => { callee_name = cid.name; },
                _ => {}
            }
            if (is_target && is_val) { return true; }
            if (!is_target && method_result_moved_expr(c.callee, name, method, false, borrowable)) { return true; }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                // An ARGUMENT is a move position unless the callee's param is
                // BORROWABLE — the same registry and the same reading
                // fieldmove_expr applies, and for the same reason: a borrowable
                // param provably never returns, stores, slices or captures its
                // argument, so the result still dies in this expression. Free
                // calls only; a method param is not in the free-function-keyed
                // half of the registry, so a method arg keeps marking.
                var arg_moves: boolean = callee_name.len() == 0 || !param_is_borrowable(borrowable, callee_name, ai);
                if (method_result_moved_expr(c.args[ai], name, method, arg_moves, borrowable)) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        // Read-through positions: the result dies in the expression.
        ast.ExprFieldAccess(fa2) => { return method_result_moved_expr(fa2.obj, name, method, false, borrowable); },
        ast.ExprBinary(b) => {
            return method_result_moved_expr(b.left, name, method, false, borrowable)
                || method_result_moved_expr(b.right, name, method, false, borrowable);
        },
        ast.ExprUnary(u) => { return method_result_moved_expr(u.operand, name, method, false, borrowable); },
        ast.ExprIndex(ix) => {
            return method_result_moved_expr(ix.array, name, method, false, borrowable)
                || method_result_moved_expr(ix.index, name, method, false, borrowable);
        },
        ast.ExprSlice(sl) => {
            return method_result_moved_expr(sl.array, name, method, false, borrowable)
                || method_result_moved_expr(sl.start, name, method, false, borrowable)
                || method_result_moved_expr(sl.end, name, method, false, borrowable);
        },
        // Container positions: every element is a move.
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (method_result_moved_expr(a.elements[i], name, method, true, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (method_result_moved_expr(el, name, method, true, borrowable)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl2) => {
            if (sl2.has_base && method_result_moved_expr(sl2.base, name, method, true, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < sl2.field_values.len()) { if (method_result_moved_expr(sl2.field_values[i], name, method, true, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprLambda(lm) => { return method_result_moved_stmts(lm.body, name, method, borrowable); },
        _ => { return false; }
    }
    return false;
}

function method_result_moved_stmts(stmts: ast.Stmt[], name: string, method: string, borrowable: string[]): boolean {
    for stmt in stmts { if (method_result_moved_stmt(stmt, name, method, borrowable)) { return true; } }
    return false;
}
function method_result_moved_stmt(st: ast.Stmt, name: string, method: string, borrowable: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return method_result_moved_expr(v.init, name, method, true, borrowable); },
        ast.StmtAssign(a) => { return method_result_moved_expr(a.value, name, method, true, borrowable); },
        ast.StmtReturn(r) => { return method_result_moved_expr(r.value, name, method, true, borrowable); },
        ast.StmtExpr(e) => { return method_result_moved_expr(e.value, name, method, false, borrowable); },
        ast.StmtIf(f) => {
            if (method_result_moved_expr(f.cond, name, method, false, borrowable)) { return true; }
            return method_result_moved_stmts(f.then_body, name, method, borrowable)
                || method_result_moved_stmts(f.else_body, name, method, borrowable);
        },
        ast.StmtWhile(w) => {
            if (method_result_moved_expr(w.cond, name, method, false, borrowable)) { return true; }
            return method_result_moved_stmts(w.body, name, method, borrowable);
        },
        ast.StmtFor(fo) => {
            if (method_result_moved_expr(fo.iter, name, method, true, borrowable)) { return true; }
            return method_result_moved_stmts(fo.body, name, method, borrowable);
        },
        ast.StmtMatch(m) => {
            if (method_result_moved_expr(m.scrutinee, name, method, false, borrowable)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && method_result_moved_expr(arm.guard, name, method, false, borrowable)) { return true; }
                if (method_result_moved_stmts(arm.body, name, method, borrowable)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return method_result_moved_stmt(d.action, name, method, borrowable); },
        _ => { return false; }
    }
    return false;
}

// bare_assign_targets_all_fresh: every `other = name` in `body` assigns into a
// local that is itself a fresh struct candidate (a site key in `fresh`). Those are
// exactly the assignments lower_stmt_assign retains, so the source's box stays
// counted; an assign into anything else retains nothing and keeps the refusal.
function bare_assign_targets_all_fresh(stmts: ast.Stmt[], name: string, fresh: string[]): boolean {
    for stmt in stmts { if (!bare_assign_tgt_ok(stmt, name, fresh)) { return false; } }
    return true;
}

function bare_assign_tgt_ok(st: ast.Stmt, name: string, fresh: string[]): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            match (a.value) {
                ast.ExprIdent(rid) => {
                    if (rid.name == name && a.target != name) { return credited_holds_name(fresh, a.target); }
                },
                _ => {}
            }
            return true;
        },
        ast.StmtIf(f) => { return bare_assign_targets_all_fresh(f.then_body, name, fresh) && bare_assign_targets_all_fresh(f.else_body, name, fresh); },
        ast.StmtWhile(w) => { return bare_assign_targets_all_fresh(w.body, name, fresh); },
        ast.StmtFor(fo) => { return bare_assign_targets_all_fresh(fo.body, name, fresh); },
        ast.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                if (!bare_assign_targets_all_fresh(m.arms[ai].body, name, fresh)) { return false; }
                ai = ai + 1;
            }
            return true;
        },
        ast.StmtDefer(d) => { return bare_assign_tgt_ok(d.action, name, fresh); },
        _ => { return true; }
    }
}

// alias_reassign_sources_counted: every ALIAS reassign of `name` has a bare-ident
// RHS naming a local that is itself struct-CREDITED (site key in `credited`). Field
// reads (`name = x.f`) and element reads (`name = xs[i]`) are counted by no retain
// and stay refused. Asking about the CREDITED set rather than the candidate set is
// what keeps this co-extensive with the retain: a candidate the escape gate rejects
// earns no "ALIASSRC:" row, so forgiving off it would release an uncounted box.
function alias_reassign_sources_counted(stmts: ast.Stmt[], name: string, credited: string[]): boolean {
    var t: i32 = alias_reassign_sources_tri(stmts, name, credited);
    return t > 0;
}

// alias_reassign_src_ok: -1 = an alias reassign this cannot count, 1 = a counted
// one, 0 = no alias reassign of `name` here.
function alias_reassign_src_ok(st: ast.Stmt, name: string, credited: string[]): i32 {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target != name) { return 0; }
            match (a.value) {
                ast.ExprIdent(rid) => {
                    if (rid.name == name) { return 0; }
                    if (credited_holds_name(credited, rid.name)) { return 1; }
                    return 0 - 1;
                },
                ast.ExprFieldAccess(_) => { return 0 - 1; },
                ast.ExprIndex(_) => { return 0 - 1; },
                _ => { return 0; }
            }
        },
        ast.StmtIf(f) => {
            var tt: i32 = alias_reassign_sources_tri(f.then_body, name, credited);
            var ee: i32 = alias_reassign_sources_tri(f.else_body, name, credited);
            if (tt < 0 || ee < 0) { return 0 - 1; }
            if (tt > 0 || ee > 0) { return 1; }
            return 0;
        },
        ast.StmtWhile(w) => { return alias_reassign_sources_tri(w.body, name, credited); },
        ast.StmtFor(fo) => { return alias_reassign_sources_tri(fo.body, name, credited); },
        ast.StmtMatch(m) => {
            var acc: i32 = 0;
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var r: i32 = alias_reassign_sources_tri(m.arms[ai].body, name, credited);
                if (r < 0) { return 0 - 1; }
                if (r > 0) { acc = 1; }
                ai = ai + 1;
            }
            return acc;
        },
        ast.StmtDefer(d) => { return alias_reassign_src_ok(d.action, name, credited); },
        _ => { return 0; }
    }
}

function alias_reassign_sources_tri(stmts: ast.Stmt[], name: string, credited: string[]): i32 {
    var acc: i32 = 0;
    for stmt in stmts {
        var r: i32 = alias_reassign_src_ok(stmt, name, credited);
        if (r < 0) { return 0 - 1; }
        if (r > 0) { acc = 1; }
    }
    return acc;
}

// credited_holds_name: `credited` holds binding-SITE keys ("name@line:col"); this
// asks whether any of them is for the variable `name`.
function credited_holds_name(credited: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < credited.len()) {
        if (reclaim_site_name(credited[i]) == name) { return true; }
        i = i + 1;
    }
    return false;
}

// reassigned_from_alias reports whether `name` is ever the TARGET of an
// assignment whose RHS ALIASES existing owned memory — a bare local read
// (`lam = l`), a field read (`lam = x.f`), or an element read (`lam = xs[i]`).
// After such an assignment `name` no longer owns a fresh box: its rc fields are
// BORROWS of whatever the RHS points into (a match-arm payload binding, a struct
// field, an array element — all still owned by their container). Reclaiming such
// a local (the re-init emit_field_reclaim_store or the end-of-scope deep sweep)
// would free the container's live fields out from under it — a double-free /
// use-after-free. The classic bug: `box_mutated_scalar_captures`'s
// `var lam = ExprLambda{...}; match (v.init) { ExprLambda(l) => { lam = l; } }`,
// where the loop's next-iteration `var lam = ...` re-init reclaims the aliased
// old `lam` and frees fd's own lambda body (#3425 stage-2). A fresh-struct-lit
// or fresh-ret-CALL rebind (`s = mk()`, `s = s.emit(op)`) is NOT an alias — it
// stays reclaimable — so only the three borrow-shaped RHS forms are flagged.
// Such a local is left to LEAK, exactly like the borrowed match-payload struct
// bindings already are (see the k_enum struct-payload note in lower_stmt_match).
function reassigned_from_alias(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts { if (stmt_reassigns_alias(stmt, name)) { return true; } }
    return false;
}
function stmt_reassigns_alias(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target == name) {
                match (a.value) {
                    ast.ExprIdent(rid) => { if (rid.name != name) { return true; } },   // `name = other` — alias
                    ast.ExprFieldAccess(_) => { return true; },                          // `name = x.f` — field borrow
                    ast.ExprIndex(_) => { return true; },                                // `name = xs[i]` — element borrow
                    _ => {}
                }
            }
            return false;
        },
        ast.StmtIf(f) => { return reassigned_from_alias(f.then_body, name) || reassigned_from_alias(f.else_body, name); },
        ast.StmtWhile(w) => { return reassigned_from_alias(w.body, name); },
        ast.StmtFor(fo) => { return reassigned_from_alias(fo.body, name); },
        ast.StmtMatch(m) => {
            for arm in m.arms { if (reassigned_from_alias(arm.body, name)) { return true; } }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_reassigns_alias(d.action, name); },
        _ => { return false; }
    }
    return false;
}

// struct_bare_assigned_src: `name` appears as the bare RHS of an assignment
// to ANOTHER name (`held = s`). The plan's alias forgiveness is sound only
// where the alias BIND retains; a plain assignment retains nothing on the
// self-host, so the assignee holds the box uncounted and the source's
// release frees it underneath (the BlockScopedStructBox aliased-to-outer
// probe: want frees exactly 0). Family knowledge until assignments carry
// the co-extensive retain.
function struct_bare_assigned_src(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                match (a.value) {
                    ast.ExprIdent(rid) => { if (rid.name == name && a.target != name) { return true; } },
                    _ => {}
                }
            },
            ast.StmtIf(f) => {
                if (struct_bare_assigned_src(f.then_body, name)) { return true; }
                if (struct_bare_assigned_src(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (struct_bare_assigned_src(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (struct_bare_assigned_src(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (struct_bare_assigned_src(arm.body, name)) { return true; } }
            },
            ast.StmtDefer(d) => {
                var one: ast.Stmt[] = [d.action];
                if (struct_bare_assigned_src(one, name)) { return true; }
            },
            _ => {}
        }
    }
    return false;
}

// struct_returned_bare: some `return name` exists. The self-host has no
// return-transfer retain for structs, so the caller's fresh-ret release and
// this slot's release are two claims on one box — refused, exactly as the
// credit gate always refused a returned name.
function struct_returned_bare(stmts: ast.Stmt[], name: string): boolean {
    var rets: ast.Expr[] = noesc_collect_rets(stmts, []);
    for r in rets {
        match (r) {
            ast.ExprIdent(rid) => { if (rid.name == name) { return true; } },
            _ => {}
        }
    }
    return false;
}

// struct_arg_to_handback: `name` is a bare argument at a position the callee
// returns bare (handback_params_of) — `held = keepit(s)` hands s's box back
// uncounted, so granting s frees it under the result (measured as underflow
// 244 on the callee-keeps probe). A callee that stores the arg into a
// returned CONSTRUCTION is not refused: the construction's retain counts it.
function struct_arg_to_handback_expr(e: ast.Expr, name: string, handback: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    var ai: i32 = 0;
                    while (ai < c.args.len()) {
                        match (c.args[ai]) {
                            ast.ExprIdent(aid) => {
                                if (aid.name == name
                                    && util.index_of_str(handback, cid.name + "|" + util.i32_to_string(ai)) >= 0) { return true; }
                            },
                            _ => {}
                        }
                        ai = ai + 1;
                    }
                },
                _ => {}
            }
            for arg in c.args { if (struct_arg_to_handback_expr(arg, name, handback)) { return true; } }
            return struct_arg_to_handback_expr(c.callee, name, handback);
        },
        ast.ExprBinary(b) => { return struct_arg_to_handback_expr(b.left, name, handback) || struct_arg_to_handback_expr(b.right, name, handback); },
        ast.ExprUnary(u) => { return struct_arg_to_handback_expr(u.operand, name, handback); },
        ast.ExprIndex(ix) => { return struct_arg_to_handback_expr(ix.array, name, handback) || struct_arg_to_handback_expr(ix.index, name, handback); },
        ast.ExprFieldAccess(fa) => { return struct_arg_to_handback_expr(fa.obj, name, handback); },
        ast.ExprArray(ar) => {
            for el in ar.elements { if (struct_arg_to_handback_expr(el, name, handback)) { return true; } }
            return false;
        },
        ast.ExprTuple(tu) => {
            for el in tu.elements { if (struct_arg_to_handback_expr(el, name, handback)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && struct_arg_to_handback_expr(sl.base, name, handback)) { return true; }
            for fv in sl.field_values { if (struct_arg_to_handback_expr(fv, name, handback)) { return true; } }
            return false;
        },
        ast.ExprLambda(lm) => { return struct_arg_to_handback(lm.body, name, handback); },
        _ => { return false; }
    }
    return false;
}

function struct_arg_to_handback(stmts: ast.Stmt[], name: string, handback: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (struct_arg_to_handback_expr(v.init, name, handback)) { return true; } },
            ast.StmtAssign(a) => { if (struct_arg_to_handback_expr(a.value, name, handback)) { return true; } },
            ast.StmtReturn(r) => { if (struct_arg_to_handback_expr(r.value, name, handback)) { return true; } },
            ast.StmtExpr(e) => { if (struct_arg_to_handback_expr(e.value, name, handback)) { return true; } },
            ast.StmtIf(f) => {
                if (struct_arg_to_handback_expr(f.cond, name, handback)) { return true; }
                if (struct_arg_to_handback(f.then_body, name, handback)) { return true; }
                if (struct_arg_to_handback(f.else_body, name, handback)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (struct_arg_to_handback_expr(w.cond, name, handback)) { return true; }
                if (struct_arg_to_handback(w.body, name, handback)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (struct_arg_to_handback_expr(fo.iter, name, handback)) { return true; }
                if (struct_arg_to_handback(fo.body, name, handback)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (struct_arg_to_handback_expr(m.scrutinee, name, handback)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && struct_arg_to_handback_expr(arm.guard, name, handback)) { return true; }
                    if (struct_arg_to_handback(arm.body, name, handback)) { return true; }
                }
            },
            ast.StmtDefer(d) => {
                var one: ast.Stmt[] = [d.action];
                if (struct_arg_to_handback(one, name, handback)) { return true; }
            },
            _ => {}
        }
    }
    return false;
}

// arrstruct_credit_rows: the ARRSTRUCT / ARRSTRUCTA credit rows and their
// "APOWNED:" site stamps. Computed as one unit and BEFORE the struct family's
// gate, which reads the stamps: whether a self-append is a counted share or an
// uncounted sink depends on whether the CONTAINER earned its element walk, so
// the two gates cannot be decided independently.
function arrstruct_credit_rows(body: ast.Stmt[], structs: parser.StructDecl[], borrowable: string[], fresh_ret: string[], msites: string[]): string[] {
    var out: string[] = [];
    // Fresh (<struct-with-array-field>)[] locals (#4365): `var ps: P[] = [P { xs: [..] },
    // ...]` (P routes field-reclaim) — the struct sibling of ARRTUP. Credited
    // "ARRSTRUCT:" so slot_is_reclaimable_arrstruct routes the loop-rebind + exit sweep
    // through emit_arrstruct_deep_free (counted element walk: per element the struct-field
    // deep-drop __struct_drop_<P> + struct box dec, then the outer buffer). Same gates as
    // ARRTUP: no escape of ps itself, not reassigned, no ELEMENT alias (arrarr_row_escapes),
    // and no element-field-payload escape (arrstruct_elem_payload_escapes — a bare
    // `keep = ps[i].xs` array-field extraction; a scalar read `ps[i].n`, indexed read
    // `ps[i].xs[j]` and `ps[i].xs.len()` are borrows).
    var asts: string[] = collect_fresh_arrstruct_names(body, body, structs, fresh_ret, [], msites);
    var asti: i32 = 0;
    while (asti < asts.len()) {
        // "A|" rows are append-BUILT markers, not candidates.
        // Site keys here too; the "A|" marker rows are "A|" + the SAME key, so the
        // self-lookup below stays key-to-key and gets sharper for it — two
        // same-named bindings no longer share an append-built verdict.
        var asnm: string = reclaim_site_name(asts[asti]);
        if (!(asts[asti].len() > 2 && asts[asti][0] == b'A' && asts[asti][1] == b'|')
            && !arrstruct_unsafe_for(body, asnm, borrowable, structs, msites)
            && !arrarr_row_escapes(body, asnm)
            && !arrstruct_share_holder_respread(body, asnm, structs, msites)
            && !arrstruct_elem_payload_escapes(body, asnm, arrstruct_elem_type_of_decl(body, asnm, structs), structs, msites, borrowable)) {
            // arrstruct_unsafe_for subsumes the former body_unsafe_for + the
            // blunt not-reassigned exclusion, validating each rebind
            // individually (#6535) — the self-append is sanctioned, any other
            // reassignment still sinks the credit outright.
            if (util.index_of_str(asts, "A|" + asts[asti]) >= 0) {
                out = out.append("ARRSTRUCTA:" + asts[asti]);
            } else {
                out = out.append("ARRSTRUCT:" + asts[asti]);
            }
            var apr: string[] = arrstruct_owned_elem_sites(body, asnm, structs, msites, []);
            var apri: i32 = 0;
            while (apri < apr.len()) { out = out.append("APOWNED:" + apr[apri]); apri = apri + 1; }
        }
        asti = asti + 1;
    }
    return out;
}

function reclaimable_names_of(body: ast.Stmt[], structs: parser.StructDecl[], borrowable: string[], fresh_ret: string[], str_fresh_ret: string[], opt_fresh_ret: SigReg, tup_fresh_ret: string[], msites: string[], recv_borrow: string[], struct_ret_fns: SigReg, params: ast.ParamDecl[], plan_on: boolean, plan_fe: string[], handback: string[], sfok: string[]): string[] {
    var fresh: string[] = collect_fresh_struct_names(body, structs, []);
    // Widen with the DISCARDED fresh-ret-call locals (#3457 follow-up): a
    // `var r = f(..)` whose result is read-then-dead. Excludes reassigned names
    // (the snapshot-LOCAL path handles those); the shared body_unsafe_for gate
    // below still proves non-escape before any is freed.
    var reassigned: string[] = body_assign_targets(body);
    fresh = collect_fresh_ret_call_names(body, structs, fresh_ret, reassigned, fresh);
    // The array-of-structs rows come FIRST: their "APOWNED:" stamps say which
    // self-appends are counted shares, which is what decides whether the struct
    // gate below reads an append as a sink.
    var asrows: string[] = arrstruct_credit_rows(body, structs, borrowable, fresh_ret, msites);
    var out: string[] = [];
    out = reclaimable_fresh_struct(asrows, body, borrowable, fresh, handback, msites, plan_fe, plan_on, recv_borrow, structs, out);
    // SECOND PASS — the counted alias reassign TARGET. reassigned_from_alias refuses
    // every such name because the slot would hold a BORROW; the retain above makes it
    // a counted share instead, so the premise no longer holds. It runs second because
    // the forgiveness asks whether the SOURCE ended up credited, which is only known
    // once the first pass finishes — and that ordering is the co-extensivity
    // guarantee.
    out = reclaimable_alias_sink_share(body, borrowable, fresh, recv_borrow, out);
    // "NODEEP:" markers (#3425 residual miscompile): the exit/return/precise
    // sweeps' DEEP field drop (emit_struct_field_drops → __struct_drop_<T>) is
    // sound only while the dead box still OWNS its rc fields. A method-RECEIVER
    // use (`ms.emit(op)`) or a bare call-ARG use (`f(ms)`) can MOVE a field into
    // the callee's result with no counted reference (`ops: self.ops.append(op)`
    // — an in-place append hands the SAME rc==1 buffer to the result), so
    // deep-dropping the dead receiver would walk-free buffers/elements the
    // result still holds. That is exactly how the IR-built compiler corrupted
    // its own Op streams once the merged bundle first compiled irlower through
    // the IR path. Such locals KEEP the #3456 credit (the rebind's cow-guarded
    // reclaim and the sweep's box-only dec are both still sound) but are marked
    // "NODEEP:" so emit_struct_field_drops withholds the deep drop — restoring
    // the box-only contract the #3456 comment above states. Struct-lit BASES
    // (`T { ...ms, .. }`) are flagged for the same reason (fields copied out).
    var mvn: i32 = out.len();
    var mvi: i32 = 0;
    while (mvi < mvn) {
        // Exempt calls through the local's own fn-typed FIELDS from the
        // method-receiver hazard (the clofld slice): `h.f(10)` on a field
        // closure moves nothing — see moves_fields_expr's header. The DEEP
        // lookup reaches loop/if-nested declarations (the top-level-only
        // fresh_struct_lit_type returned "" for those, so a loop-local
        // fn-field struct was wrongly NODEEP'd and its per-iteration
        // reinit stayed box-only — the env box leaked every rebind).
        //
        // Exempt METHODS whose receiver recv_borrow_fns_of proved a pure borrow
        // too — `b.score()` reading only scalars moves nothing, so the receiver
        // keeps the deep drop that releases its string / array fields. Keyed on
        // the declared type as well as the literal one, since a local bound from
        // a call has no struct-literal init to read a type off.
        // The markers are keyed on whatever `out[mvi]` is — a binding-SITE key
        // since #7253 — so they follow the credit they qualify. The body walks
        // below all take a NAME.
        var mvnmk: string = reclaim_site_name(out[mvi]);
        var mvty: string = fresh_struct_lit_type_deep(body, mvnmk);
        var mvsty: string = mvty;
        if (mvsty == "") { mvsty = declared_struct_type_of(body, mvnmk, structs); }
        var mvnm: string[] = recv_borrow_methods_of(recv_borrow, mvsty);
        mvnm = append_all(mvnm, recv_ident_methods_of(recv_borrow, mvsty, body, mvnmk, borrowable));
        if (mvty != "") { mvnm = append_all(mvnm, clo_field_names_of(structs, mvty)); }
        var mv_moves: boolean = moves_fields_stmts(body, mvnmk, mvnm, false);
        // A BARE NON-SCALAR FIELD READ moves the field out just as surely as a
        // receiver use does, and moves_fields_expr cannot see it: its
        // ExprFieldAccess arm only recurses into the object, and a bare ExprIdent
        // object matches no arm at all. That blind spot is what made the deep drop
        // unsafe for a block-scoped slot (#6127) — `var lo: StringLitOut =
        // add_string_lit(s, ..); s = lo.state;` hands lo's EmitState to the live
        // threaded `s`, and the deep walk then freed that state's arrays out from
        // under it (gen1 faulted in EmitState.has_need → __fern_str_eq).
        //
        // optstruct_body_moves_field names the MOVE positions positively (a bind /
        // assign / return value, a call argument, a container element) rather than
        // reporting every field read and exempting borrows — see its header for why
        // that polarity matters. Only when the local's struct type is known, so an
        // untyped local keeps its prior verdict exactly.
        if (!mv_moves && mvsty != "" && optstruct_body_moves_field(body, mvnmk, mvsty, structs, borrowable)) { mv_moves = true; }
        // A literal whose rc fields BORROW un-retained kinds (string /
        // string[] / enum-array reads of another value): the deep walk would
        // free the source's buffers — see struct_lit_unretained_borrow_field.
        if (!mv_moves && struct_lit_unretained_borrow_field(body, out[mvi], structs)) { mv_moves = true; }
        if (mv_moves) { out = out.append("NODEEP:" + out[mvi]); }
        // "FLDCHECKED:" — the field-move scan actually RAN for this name, i.e. its
        // struct type was resolvable. A BLOCK-SCOPED slot only earns the deep drop
        // with this witness: without a type there is no move check, and granting the
        // drop anyway trapped the wasm-hosted compiler in
        // __struct_drop_irlower__LowerState (an un-annotated call-bound LowerState
        // local, dec'ing a moved-out field). Live-credit slots are unaffected — they
        // keep exactly the verdict they had before any of this.
        else if (mvsty != "") { out = out.append("FLDCHECKED:" + out[mvi]); }
        mvi = mvi + 1;
    }
    // Fresh scalar-tuple locals (`var t = (3, 4)`): credited under a "TUP:" prefix
    // so the struct/snapshot consumers of reclaimable_names (which look up a bare
    // name or "SNAP:<name>") never match them — only slot_is_reclaimable_tuple
    // does. The same body_unsafe_for escape gate proves non-escape before the
    // shallow box free is emitted at scope exit.
    // Frame-fresh RETURNED tuple locals (the owned-return admission): for
    // these names a bare `return <name>` is the move-out, not an escape, so
    // the credit gates below consult the ret-forgiving walker — the returned
    // slot is KEPT from that return path's sweep (returned_moved_arr_slots)
    // and swept on every other path, and the caller's fresh-ret credit
    // releases the box it received.
    var tretn: string[] = tuple_ret_local_names_of(body);
    var tups: string[] = collect_fresh_scalar_tuple_names(body, []);
    // Widen with tuple-fresh-ret CALL locals (`var t = mk(k)`, mk returning a
    // direct scalar tuple literal on every path — tuple_fresh_ret_fns_of): the
    // #4357 tuple-returning dead intermediate. Same "TUP:" class → the same
    // shallow box free (elements untouched), same escape gate below.
    tups = collect_fresh_tuple_ret_call_names(body, tup_fresh_ret, reassigned, tups);
    out = reclaimable_scalar_tuple(body, borrowable, reassigned, recv_borrow, structs, tretn, str_fresh_ret, tups, out);
    // Fresh rc-tuple locals (`var t = (i, [i, i+1])`): a tuple literal carrying a
    // fresh ARRAY-literal element — credited "TUPRC:" so slot_is_reclaimable_rctuple
    // drives the DEEP loop-rebind reclaim (emit_tuple_deep_reinit_store: arr_dec each
    // fresh array element, then the box), instead of the scalar-tuple shallow box dec
    // that leaks the array (#4357). Two non-escape gates: body_unsafe_for (no bare-tuple
    // escape) AND — when a tuple type annotation is available — rctuple_payload_escapes,
    // which rejects a WHOLE owned-pointer-element extraction (`keep = t.1`, an array or
    // reclaim-struct box the deep-drop would free, leaving a live alias to over-release).
    // A scalar read `t.0`, an indexed array read `t.1[j]`, a struct scalar-field read
    // `t.1.y`, and their `.len()` stay borrows and still reclaim. Un-annotated bindings
    // (no type) skip the second gate, preserving prior behaviour. #4365.
    var rctups: string[] = collect_fresh_rc_tuple_names(body, structs, str_fresh_ret, []);
    var sweeprc: string[] = collect_sweepable_rc_tuple_names(body, structs, str_fresh_ret, []);
    out = reclaimable_rc_tuple(body, borrowable, rctups, reassigned, recv_borrow, structs, sweeprc, tretn, str_fresh_ret, msites, out);
    // Fresh rc-payload ENUM locals (`var b = Full([i, i+1])` consumed by a match in
    // the same block): credited "RCENUM:" so slot_is_reclaimable_rcenum drives the
    // DEEP loop-rebind reclaim (emit_enum_deep_reinit_store → emit_enum_variant_drops
    // on the prior box). Non-escape gate (body_unsafe_for) AND arm-payload-non-escape
    // gate (enum_body_binds_rc_payload — a borrow-only `Full(xs) => xs[0]` is fine, a
    // moved-out payload is rejected) before crediting. The consuming-match reclaim
    // (consumed_rcpayload_enum_frees) is top-level-only, so it never covers a
    // loop-local; this closes that gap (#4357) with no overlap.
    var rcenums: string[] = collect_fresh_rcenum_names(body, structs, opt_fresh_ret, borrowable, str_fresh_ret, msites, []);
    out = reclaimable_rcenum(rcenums, out);
    // All-scalar ENUM locals with no consuming match ("SCENUMS:"): the shallow
    // sibling of the "RCENUMS:" credit above. Both the loop rebind and the
    // scope-exit sweep release the box with a plain rc-dec.
    var scenums: string[] = collect_fresh_scenum_names(body, structs, borrowable, plan_on, plan_fe, []);
    out = reclaimable_scenum(scenums, out);
    // Fresh heap-string locals (`var s: string = a + b` / `.to_upper()` / chr(..)
    // / …): credited under a "STR:" prefix so only slot_is_reclaimable_str matches
    // (the struct / tuple / snapshot consumers never do). Two gates before a name
    // is freed: (1) body_unsafe_for proves non-escape (no `return s`, no store into
    // a container, no bare-ident alias `x = s`, no non-borrowable call arg), and
    // (2) NOT reassigned — a `s = <non-fresh>` rebind could leave a live alias in
    // the slot at exit, so only single-bind (incl. loop-body re-declared) string
    // locals qualify. The reclaim frees the box + data buffer via __fern_str_free
    // (asm) / $__fern_arr_dec (wasm) at the loop-rebind and at scope exit.
    var strs: string[] = collect_fresh_string_names(body, []);
    // …plus the calls a whole-program proof says return a fresh box (#6606).
    strs = collect_str_fresh_ret_call_names(body, str_fresh_ret, reassigned, strs);
    // #4353: a fresh string handed to a union element of an rc-tuple this pass
    // already credited "TUPRC:" is no longer an escape — see the ExprTuple arm of
    // body_unsafe_for_tup. Tagged into the same list rather than threaded as a
    // seventh parameter, the way every other credit in this function is carried.
    var tup_ok: string[] = tup_ok_from_tuple_credits(out, []);
    // The candidate pool an alias-reassign TARGET must come from: a string local
    // bound by a fresh producer or a literal. A target outside it is some other
    // class and earns nothing here.
    var str_cands: string[] = [];
    var sc0: i32 = 0;
    while (sc0 < strs.len()) { str_cands = push_str_unique(str_cands, strs[sc0]); sc0 = sc0 + 1; }
    var lits_pre: string[] = collect_litstr_local_names(body, []);
    var sc1: i32 = 0;
    while (sc1 < lits_pre.len()) { str_cands = push_str_unique(str_cands, lits_pre[sc1]); sc1 = sc1 + 1; }
    out = reclaimable_string(body, borrowable, tup_ok, msites, reassigned, recv_borrow, sfok, str_cands, strs, structs, out);
    // Literal-init string locals (#6582) — same two gates as the fresh producers
    // above, plus the `.to_string()` identity-alias exclusion. See the
    // collect_litstr_local_names block for why this is not folded into
    // str_local_binding_is_fresh.
    var lits: string[] = collect_litstr_local_names(body, []);
    out = reclaimable_litstr_local(body, borrowable, tup_ok, lits, reassigned, recv_borrow, str_cands, strs, out);
    // `<scalar>.to_string()` string locals (#6599) — same gates as the producers
    // above. See the collect_tostr_scalar_names block for why the receiver-type test
    // cannot live in str_local_binding_is_fresh.
    // Body declarations FIRST, parameters after: the lookups take the first
    // match, so a local shadowing a parameter still answers with its own type.
    var tsn: string[] = param_decl_names(params, tostr_decl_names(body, []));
    var tst: string[] = param_decl_types(params, tostr_decl_vals(body, []));
    var tss: string[] = collect_tostr_scalar_names(body, tsn, tst, []);
    out = reclaimable_tostr_scalar(body, borrowable, tup_ok, reassigned, recv_borrow, strs, tss, out);
    // `xs.join(sep)` string locals — same gates again, and the receiver-type test
    // lives here for the same reason the `.to_string()` one does (join_strarr_init).
    var jss: string[] = collect_join_strarr_names(body, tsn, tst, []);
    out = reclaimable_join_strarr(body, borrowable, tup_ok, jss, reassigned, recv_borrow, strs, out);
    // `<string>.trim()` locals — same gates again. Since #7393 the builtin trim
    // returns an owned copy, so the credit is an ordinary "STR:" name with the
    // ordinary full release; the collector's receiver-TYPE test is what keeps a
    // user method named `trim` (which may return a field alias) uncredited.
    var tms: string[] = collect_trim_local_names(body, tsn, tst, []);
    out = reclaimable_trim_local(body, borrowable, tup_ok, reassigned, recv_borrow, strs, tms, out);
    // `<string>.replace(old, new)` locals — same gates, released behind the
    // identity guard (the slot's str_identity_src is what carries the receiver to
    // compare against).
    var rps: string[] = collect_replace_local_names(body, tsn, tst, []);
    out = reclaimable_replace_local(body, borrowable, tup_ok, reassigned, recv_borrow, rps, strs, out);
    // `var v: str = base.drop(2)` — an SFRRECV method chain in BINDING position
    // (#6544), released behind the same identity guard, pointed at the chain root.
    // Same two gates as its siblings, but credited "SFRCAND:" rather than "STR:":
    // the guard needs the root's SLOT and only the binding site can resolve one,
    // so bind_var_slot promotes a candidate whose root walk agrees and leaves the
    // rest uncredited. That is what makes a credit without a guard impossible —
    // an unguarded release here would free the receiver's own box on the identity
    // path.
    //
    // No alias credit: the release is behind an IDENTITY guard pointed at the
    // chain root's slot, and only the binding site can resolve one. An alias has
    // no root walk of its own, so it could not carry the guard the credit assumes.
    var sfrs: string[] = collect_sfrrecv_local_names(body, tsn, tst, str_fresh_ret, []);
    out = reclaimable_sfrrecv_local(body, borrowable, tup_ok, reassigned, recv_borrow, sfrs, strs, out);
    // String-builder ACCUMULATORS (#2649 consume-rebind): a reassigned
    // `var s: string = ""; while (…) { s = s + part; }` whose every reassignment is
    // a fresh consume-rebind of s and that never escapes (str_accum_unsafe_for —
    // which forbids `return s` for now, so a non-escaping accumulator only). Also
    // credited "STR:", so slot_is_reclaimable_str drives both the per-reassignment
    // free (emit_str_reclaim_store on the StmtAssign) and the scope-exit free. The
    // superseded box freed each rebind is what closes the O(n) growth-chain leak;
    // __fern_str_free's heap-base guard makes freeing the initial "" literal a
    // no-op on its .rodata data (its 16-byte box is still reclaimed).
    //
    // NO alias credit here, and it is a property of the class rather than an
    // omission: an accumulator is REASSIGNED by definition, and each rebind frees
    // the box it supersedes. An alias bound before a rebind would still point at
    // that freed box, so crediting it would sweep memory already on the freelist.
    // The wired families all carry `index_of_str(reassigned, …) < 0`, so none of
    // them can hand an accumulator a credit by another route.
    var accs: string[] = collect_str_accumulator_names(body, reassigned, str_fresh_ret, []);
    out = reclaimable_str_accumulator(accs, body, borrowable, str_fresh_ret, out);
    // Fresh-string-return-call locals (`var r = f(..)`, f a str-fresh-ret free
    // function): r solely owns the fresh string the callee moved out, so — when r
    // is not reassigned and never escapes (body_unsafe_for) — it is freed at scope
    // exit / per loop-rebind, closing the caller-side leak the returned builder left.
    var frets: string[] = collect_fresh_str_ret_call_names(body, str_fresh_ret, reassigned, []);
    out = reclaimable_str_ret_call(body, borrowable, frets, recv_borrow, out);
    // Owned-container READ destinations (#6491 pointer half): `var s: string =
    // mk()[i]` / `= mk().f`. The read releases the container and hands over its
    // single reference to the extracted box, so s owns it exactly as a
    // fresh-producer binding does — same two gates, same "STR:" class.
    var ocrs: string[] = collect_owned_container_read_str_names(body, body, fresh_ret, reassigned, structs, []);
    out = reclaimable_owned_container_read_str(body, borrowable, ocrs, recv_borrow, out);
    // `?`-bound string payloads (#4355): `var s: string = mk(pre)?` where mk is
    // an opt-fresh producer whose success payloads are all fresh (flag "f") —
    // the `?` edge frees the source box (lower_try) and MOVES the payload's
    // sole reference to s, so s is credited "STR:" exactly like a fresh
    // producer-call binding. Same two gates as frets: non-escape
    // (body_unsafe_for) and not reassigned (enforced by the collector).
    var tstrs: string[] = collect_try_str_binding_names(body, opt_fresh_ret, reassigned, []);
    out = reclaimable_try_str_binding(body, borrowable, recv_borrow, tstrs, out);
    // Fresh MAP locals (`var m = Map { … }` / `map_new()`): credited under a "MAP:"
    // prefix so only slot_is_reclaimable_map matches. __fern_map_free frees the keys
    // + values buffers AND returns the 16-byte RAW mapbox to the freelist (x86/arm64
    // asm), and $__fern_map_release does the same + deep-releases string K/V on wasm.
    // Gates: fresh map init,
    // NOT reassigned (a rebind could leave a live alias in the slot), non-escaping
    // (body_unsafe_for — receiver-borrow method calls m.get/m.set/m.has/m.len are
    // fine; passed / stored / returned is an escape), not aliased, and no EXPLICIT
    // `m.iter()` (map_has_explicit_iter — its MapIter box can escape; `for (k,v) in m`
    // is fine, its iter is a scoped loop temp dead by the free).
    var maps: string[] = collect_fresh_map_names(body, []);
    // Also collect annotated bindings from REGISTERED map builders
    // (`var m: Map[..] = mk(i)`, mk in the "MAPF:" registry riding
    // tup_fresh_ret — map_fresh_ret_fns_of): the callee provably returns a
    // fresh, sole-owned, scalar-column map, so the binding earns the same
    // "MAP:" credit as a local map_new — subject to every gate below
    // (non-self-cow reassigns, aliasing, escapes, iteration, identity all
    // still exclude). The self-host twin of #5096's bound-intermediate
    // reclaim; #4357.
    maps = collect_mapf_call_names(body, tup_fresh_ret, maps);
    var aliased_m: string[] = aliased_array_names_of(body);
    out = reclaimable_map(aliased_m, body, borrowable, maps, reassigned, recv_borrow, structs, out);
    // Fresh string[] locals with provably-fresh/static ELEMENTS (#4355): credited
    // under an "SARR:" prefix so only slot_is_reclaimable_strarr matches. The
    // strarr_unsafe_for gate proves non-escape of the array AND of every element
    // pointer (no element binding / return / store / view; only the sanctioned
    // `xs = xs.append(<fresh|literal>)` rebind), so the exit sweep's
    // __fern_str_arr_free walk frees each element box exactly once. NOT excluded
    // on `reassigned` — the self-append rebind IS a reassignment; the gate
    // validates each one individually.
    var sarr_producers: string[] = strarr_producer_names_of(fresh_ret, body);
    var sarrs: string[] = collect_fresh_strarr_names(body, body, fresh_ret, str_fresh_ret, []);
    out = reclaimable_strarr(body, borrowable, msites, sarrs, sfok, str_fresh_ret, sarr_producers, structs, out);
    // The builtin string[] producers (`s.split(sep)` / `s.lines()`), under their
    // own prefix so the binding-site type confirmation is required alongside.
    // Same strarr_unsafe_for gate: it is the non-escape half of the proof, and
    // it is name-level, so it applies here unchanged.
    var bsarrs: string[] = collect_builtin_strarr_names(body, []);
    out = reclaimable_builtin_strarr(body, borrowable, bsarrs, str_fresh_ret, sarr_producers, out);
    // Fresh arr-of-arr locals (#4355 slice 9): `var g = [[..], [..]]` where
    // every element is an ARRAY LITERAL of scalar literals / fresh strings —
    // credited "ARRARR:<name>" so only slot_is_reclaimable_arrarr matches.
    // The exit sweep / loop-rebind frees the whole two-level structure via
    // __fern_arrarr_free (scalar inners: one rc-guarded arr_dec each) or
    // __fern_strarrarr_free (string inners: __fern_str_arr_free each), chosen
    // from the slot's arrarr_elem kind. Three gates: body_unsafe_for (no
    // return / store / call-arg escape of g itself), NOT reassigned (only the
    // loop re-declaration rebind is handled), and no ROW alias
    // (arrarr_row_escapes_iter: an index row read takes the is_arr retain so it
    // is a counted reference the walk's rc-guarded dec cannot free, and `for row
    // in g` is a transient borrow the loop outlives — only a body that lets the
    // loop var escape dangles. A `g[i][j]` / `g[i].len()` borrow binds nothing).
    var aarrs: string[] = collect_fresh_arrarr_names(body, opt_fresh_ret, []);
    out = reclaimable_arrarr(aarrs, body, borrowable, opt_fresh_ret, out);
    // Fresh Option[<scalar-arr>][] locals (#4365): `var xs: Option[i32[]][] =
    // [Some([..]), None]` — credited "OPTAARR:" so slot_is_reclaimable_optaarr
    // routes the exit sweep / loop-rebind through __fern_optarrarr_free
    // (uniqueness-gated payload dec + rc-guarded option-box dec per element,
    // then the outer buffer). Same three gates as the arr-of-arr class: no
    // escape of xs itself, not reassigned, and no ELEMENT alias
    // (arrarr_row_escapes_boxiter — a bound `var o = xs[i]` holds an option box
    // whose payload the free would dangle; a transient `match (xs[i])` payload
    // borrow is fine, and so is `for o in xs` whose loop var stays confined to
    // the loop).
    var oaas: string[] = collect_fresh_optaarr_names(body, []);
    out = reclaimable_optaarr(body, borrowable, oaas, plan_fe, plan_on, reassigned, recv_borrow, out);
    // Fresh Option[<tuple-with-array>] locals (#4365): `var o: Option[(i32, i32[])]
    // = Some((i, [i, i+1]))` consumed by a borrow-only match — credited "OPTTUP:"
    // so slot_is_reclaimable_opttup routes the loop-rebind + exit sweep through the
    // inline emit_opttup_deep_free (tag-check → type-driven tuple deep-drop → box
    // dec). Gates: no escape of o itself (body_unsafe_for), not reassigned, and no
    // Some-arm payload escape (opt_body_binding_escapes on "Some" — a `match (o) {
    // Some(p) => <p stored/returned/aliased> }` binds the payload out of the arm;
    // a borrow-only read is fine, dropped after the match).
    // collect_fresh_opttup_names is self-gating (block-level consuming-match
    // analysis), so the names it returns are already escape-checked — credit
    // them directly (a body_unsafe_for gate here would reject the consuming
    // match scrutinee, exactly what the block-level analysis handles instead).
    var ots: string[] = collect_fresh_opttup_names(body, structs, []);
    out = reclaimable_opttup(ots, out);
    // Fresh Option[<struct-with-array-field>] locals (#4365): `var o: Option[P] =
    // Some(P { xs: [..] })` (P routes field-reclaim) consumed by a borrow-only match —
    // the struct sibling of OPTTUP. Credited "OPTSTRUCT:" so slot_is_reclaimable_optstruct
    // routes the loop-rebind + exit sweep through emit_optstruct_deep_free (tag-check ->
    // struct-field deep-drop __struct_drop_<P> -> struct box dec -> option box dec).
    // collect_fresh_optstruct_names is self-gating (block-level consuming-match analysis),
    // so credit the names it returns directly.
    var oss: string[] = collect_fresh_optstruct_names(body, structs, []);
    out = reclaimable_optstruct(oss, out);
    // Fresh Option[<scalar-arr-of-arr>] locals (#4365): `var o: Option[i32[][]] =
    // Some([[i, i+1], ...])` consumed by a borrow-only match — the arr-of-arr sibling of
    // OPTSTRUCT. Credited "OPTARRARR:" so slot_is_reclaimable_optarrarr routes the loop-rebind
    // + exit sweep through emit_optarrarr_deep_free (tag-check -> __fern_arrarr_free payload ->
    // option box dec). collect_fresh_optarrarr_names is self-gating (block-level consuming-match
    // analysis), so credit its names directly.
    var oas: string[] = collect_fresh_optarrarr_names(body, []);
    out = reclaimable_optarrarr(oas, out);
    // REBOUND Option[<flat scalar array>] locals (#6127): `var o: Option[i32[]] =
    // Some([..]); while { o = Some([..]) }`. The simplest payload kind in this
    // family and the only one with no rebind class — every consuming-match
    // analysis refuses a reassigned name, so this shape was reclaimed nowhere.
    // Credited "OPTARR:" so slot_is_reclaimable_optarr routes the loop-rebind +
    // exit sweep through emit_optarr_deep_free. collect_fresh_optarr_names
    // REQUIRES the name to be reassigned, the exact complement of those analyses'
    // gate, so the two sets are disjoint and no box is freed twice. It covers
    // the rebound local whether or not a match consumes it — see
    // optarr_rebound_credit_ok for the two proofs.
    var ofa: string[] = collect_fresh_optarr_names(body, plan_on, plan_fe, []);
    out = reclaimable_optarr(ofa, out);
    // The non-reassigned, non-match-consumed sibling (#6360) — same tag, same
    // exit sweep; see collect_unmatched_optarr_names for why the two sets
    // cannot overlap.
    var ufa: string[] = collect_unmatched_optarr_names(body, opt_fresh_ret, plan_on, plan_fe, []);
    out = reclaimable_unmatched_optarr(body, opt_fresh_ret, ufa, out);
    // A vetted alias of one of these shares the box and releases it BOX-ONLY
    // (#7687). Granted here rather than inside reclaimable_unmatched_optarr
    // because the "OPTARR:" tag is shared with the rebound and match-consumed
    // classes, whose aliases are the other gates' business.
    out = credit_opt_alias_sites(body, ufa, "OPTARR:", out);
    // Same quadrant, STRING payload (#6360) — its own tag because the release is
    // __fern_str_free, not the flat dec, and the call form needs the registry's
    // "f" flag rather than bare membership.
    var ufs: string[] = collect_unmatched_optstr_names(body, opt_fresh_ret, str_fresh_ret, plan_on, plan_fe, []);
    out = reclaimable_optstr(ufs, out);
    out = credit_opt_alias_sites(body, ufs, "OPTSTR:", out);
    // `Option[Option[<rc payload>]]` (#7718) — the two-level release, which the
    // scalar-inner nested sibling's flat dec would strand the inner payload of.
    var uor: string[] = collect_unmatched_optopt_rc_names(body, plan_on, plan_fe, []);
    out = reclaimable_optopt_rc(uor, out);
    out = credit_opt_alias_sites(body, uor, "OPTOPTRC:", out);
    // The superseded boxes of a MATCH-CONSUMED, reassigned nested Option (#7716)
    // — assign-path only; see collect_optopt_rebind_names for why this cannot
    // collide with the consuming-match family's own release.
    var orb: string[] = collect_optopt_rebind_names(body, []);
    out = reclaimable_optopt_rebind(orb, out);
    // The MATCH-CONSUMED quadrant of the same family (#7710). The array payload
    // kinds are reclaimed whether or not a match consumes them; the string one was
    // reclaimed only when NEVER matched, so `var o: Option[string] = Some(w("ab"));
    // match (o) { .. }` freed nothing at all — 72 B/round, unbounded, against 0 on
    // native. Same tag and same exit sweep; see collect_fresh_optstr_names for why
    // the two collectors cannot overlap.
    var mfs: string[] = collect_fresh_optstr_names(body, opt_fresh_ret, str_fresh_ret, []);
    out = reclaimable_optstr(mfs, out);
    // Fresh (<tuple-with-array>)[] locals (#4365): `var xs: (i32, i32[])[] =
    // [(i, [i, i+1]), ...]` — an array whose elements are fresh tuples carrying fresh
    // arrays. Credited "ARRTUP:" so slot_is_reclaimable_arrtup routes the loop-rebind
    // + exit sweep through emit_arrtup_deep_free (counted element walk: per element
    // type-driven tuple deep-drop + tuple box dec, then the outer buffer). Gates: no
    // escape of xs itself (body_unsafe_for), not reassigned, no ELEMENT alias
    // (arrarr_row_escapes — a bound `var t = xs[i]` / `for t in xs` holds a tuple box
    // the free would dangle), and no element-payload escape (arrtup_elem_payload_
    // escapes — a bare `keep = xs[i].1` array-field extraction; a scalar read
    // `xs[i].0`, indexed read `xs[i].1[j]` and `xs[i].1.len()` are borrows).
    var ats: string[] = collect_fresh_arrtup_names(body, body, structs, fresh_ret, str_fresh_ret, []);
    out = reclaimable_arrtup(ats, body, borrowable, reassigned, recv_borrow, structs, out);
    out = reclaimable_credit(asrows, out);
    // Fresh `MyEnum[]` locals (#5474): `var xs: E[] = [E.A(..), E.B, ..]` — the enum
    // sibling of ARRTUP/ARRSTRUCT, and the last array-of-X element kind that had no
    // element walk at all. Credited "ARRENUM:<local>#<Enum>", the enum riding the
    // entry because an `E[]` slot records its element type nowhere (see the ARRENUM
    // block). The escape gate is deliberately much tighter than its siblings' — only
    // `xs.len()` — because an element extraction here risks a double-free rather than
    // a leak; arrenum_esc_expr says why.
    var aens: string[] = collect_fresh_arrenum_names(body, body, structs, fresh_ret, []);
    out = reclaimable_arrenum(aens, body, borrowable, msites, recv_borrow, structs, out);
    // Fresh SCALAR-FIELD struct-array locals (#4355): `var g = [P { .. }, P { .. }]`
    // — every element fresh (a no-base struct literal, or a call to a strict-fresh
    // struct-returning function — structarr_elem_store_ok), and P has no rc-array field
    // (the deep ARRSTRUCT path above only credits field-routing structs). Credited
    // "STRUCTARR:" so slot_is_reclaimable_structarr routes the exit sweep /
    // loop-rebind through __fern_arrarr_free (a rc-guarded box dec per element
    // pointer, then the outer buffer). Before this, a scalar-field struct-array slot
    // took the generic is_arr shallow __fern_rc_dec, freeing only the OUTER buffer
    // and leaking every element struct box per iteration. Three gates: no escape of g
    // itself (body_unsafe_for), not reassigned, and no ELEMENT escape
    // (structarr_elem_escapes — a bound `var q = g[i]` element, or a `for p in g`
    // whose body lets `p` escape, holds a box the free would dangle; transient
    // `for p in g { … p.field … }` iteration and `g[i].field` reads are fine). The
    // detector's struct_has_reclaim_array_field guard keeps this DISJOINT from
    // ARRSTRUCT — field structs deep-drop there, scalar structs shallow-free here.
    var sarrs2: string[] = collect_fresh_structarr_names(body, body, structs, fresh_ret, []);
    out = reclaimable_structarr(body, borrowable, fresh_ret, sarrs2, out);
    // dyn-Trait payload locals (#4351): `var d: dyn T = <literal>`. A STRUCT
    // literal flows UNBOXED behind the dyn coercion (the local holds the
    // concrete's rc-headered box) — credited "DYN:<name>|<Concrete>" so the
    // exit sweep deep-drops the concrete's rc fields (__struct_drop_<Concrete>)
    // and frees the box. A PRIMITIVE/STRING literal is heap-boxed into an
    // op_dyn_box cell — now rc-headered via __fern_arr_box (#4351 slice 2) —
    // credited "DYN:<name>|<prim>" so the sweep decs the cell (and for a
    // "string" tag first frees the sole-owned inner string box at cell@8).
    // A STRICT-FRESH CALL result (`var d: dyn T = mk(k)`) earns the struct
    // credit on the same terms as the literal: the callee returns only fresh
    // literals, so the box is this frame's at rc==1.
    // Gates mirror the enum struct-payload path: a FRESH init (sole owner,
    // rc==1), single-bind, never reassigned, non-escaping (body_unsafe_for — a
    // `d.show()` dispatch is a receiver borrow, safe; a bare-ident alias, call
    // arg, return, or `as?` downcast excludes).
    //
    // A payload this AST scan cannot type (`var d: dyn T = k * 2` — whether it
    // boxes at all is a question about the init's TYPE) carries the escape
    // verdict alone, as "DYNCAND:<name>". The coercion site completes it: only
    // there is the op_dyn_box primitive known, and a non-string primitive cell
    // is fresh by construction, so the escape gates are the whole admission.
    var dyns: string[] = collect_dyn_struct_names(body, body, structs, fresh_ret, struct_ret_fns, []);
    out = reclaimable_dyn_struct(body, borrowable, dyns, reassigned, recv_borrow, out);
    // dyn-Trait ARRAY locals (#4351 slice 3): `var xs: dyn T[] = [<literals>]`
    // — every element is an rc-headered box (prim/string op_dyn_box cell or
    // scalar-only struct box), sole-owned by the buffer when no element
    // pointer outlives the frame (darr_unsafe_for — dispatch only in
    // transient positions, no element bindings / for-in / append / stores).
    // Credited "DARR:<name>|<kinds>" so the exit sweep releases each element
    // by kind ('s' frees the inner string box first) before the buffer dec.
    var darrs: string[] = collect_dyn_arr_names(body, structs, []);
    out = reclaimable_dyn_arr(body, borrowable, darrs, reassigned, out);
    // Reassigned array-payload ENUM locals: credited "ENUMRE:<E>:<name>" so the StmtAssign
    // deep-drops each superseded box's payload (emit_enum_reclaim_store) instead of the
    // box-only shallow free that leaked it on the register backends. Gated
    // (enum_only_wildcard_used_rec + array-payload-only) so b's payload is never aliased;
    // DISJOINT from the consume-by-match enum frees (those require b NOT reassigned).
    out = enum_reassign_reclaim_names(body, structs, out);
    // Enum locals this frame CONSTRUCTED, credited "FRESHBOX:<name>" — the
    // ownership question a match-arm payload return has to answer (#8070). See
    // frame_constructed_enum_names_of.
    out = frame_constructed_enum_names_of(body, structs, opt_fresh_ret, str_fresh_ret, msites, out);
    return out;
}

// frame_constructed_enum_names_of credits "FRESHBOX:<name>" for every enum local
// whose value THIS FRAME built — a direct variant construction, a call to a
// proven fresh rc-enum ctor, or a bare-ident bind of a name already credited.
// Declaration order makes one pass a fixpoint: an alias's source is declared
// before it.
//
// It answers one question, for the return of a match-arm array-payload binding:
// does an owner of that buffer survive the call? A frame-constructed box is the
// buffer's only owner and this frame is on its way out, so the escaping return
// carries the box's own reference and must take NO transfer retain — the value
// leaves at the rc it already has. A box reached through a PARAMETER is the
// caller's, which keeps its claim, so that return does owe the retain.
//
// Deliberately conservative: only top-level `var`s are read and anything
// unresolved goes uncredited, which leaves the retain in place. That is the
// safe default — a needless retain leaks, a missing one is a use-after-free.
function frame_constructed_enum_names_of(body: ast.Stmt[], structs: parser.StructDecl[], opt_fresh_ret: SigReg, str_fresh: string[], msites: string[], acc: string[]): string[] {
    var out: string[] = acc;
    var owned: string[] = [];
    var vi: i32 = 0;
    while (vi < body.len()) {
        match (body[vi]) {
            ast.StmtVar(v) => {
                var built: boolean = fresh_rcpayload_enum_init(v.init, structs, str_fresh, msites, true) != ""
                    || rcenum_call_init_owner(v.init, opt_fresh_ret) != "";
                if (!built) {
                    match (v.init) {
                        ast.ExprIdent(src) => { built = util.index_of_str(owned, src.name) >= 0; },
                        _ => {}
                    }
                }
                if (built && util.index_of_str(owned, v.name) < 0) {
                    owned = owned.append(v.name);
                    out = out.append("FRESHBOX:" + reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return out;
}

// snapshot_param_slots_of: the struct PARAMS / RECEIVER that are SNAPSHOT-
// reclaimable (#3456 slice 2) — the builder pattern
// `function f(s: EmitState): EmitState { s = s.write(x); ...; return s; }`, where
// `s` is a param/receiver REASSIGNED through a consume-rebind and moved back out
// via `return s`. Such a param cannot use the normal reclaim path (its box would
// be deep-dropped at scope exit, and its final value shares the CALLER's field
// buffers); instead lower_func snapshots it at entry and each reassign frees the
// old box only when it differs from BOTH the new value and the snapshot (the
// caller's original). Eligibility: reassigned + only-safe-uses-plus-return. The
// struct-slot check is applied at the emit site (struct_type_of_slot), so a
// scalar param — flagged unsafe by its arithmetic — never reaches here.
function snapshot_param_slots_of(fn: parser.FuncDecl, borrowable: string[], consume_safe: string[]): string[] {
    var out: string[] = [];
    var reassigned: string[] = body_assign_targets(fn.body);
    // Slot numbers, not names (#7253). lower_func lays the frame out receiver-
    // first then parameters, in this order, so the slot is known here without a
    // LowerState — and unlike the name it cannot be answered by a body local of
    // the same spelling, which is what kept these rows behind a "SNAP:" prefix
    // to hide them from the bare-name struct-credit lookup.
    var base: i32 = 0;
    if (fn.receiver_name.len() > 0) {
        base = 1;
        if (util.index_of_str(reassigned, fn.receiver_name) >= 0 && !body_consume_unsafe_for(fn.body, fn.receiver_name, borrowable, consume_safe, [], true)) {
            out = out.append(util.i32_to_string(0));
        }
    }
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        var pn: string = fn.params[pi].name;
        if (util.index_of_str(reassigned, pn) >= 0 && !body_consume_unsafe_for(fn.body, pn, borrowable, consume_safe, [], true)) {
            out = out.append(util.i32_to_string(base + pi));
        }
        pi = pi + 1;
    }
    return out;
}

// --- fresh-struct-return classification + snapshot-LOCAL reclaim (#3457) ------
//
// The dominant self-host builder is a LOCAL that is threaded and MOVED OUT:
//   var st: LowerState = se.emit(op);   // bound from a fresh-RET method
//   st = st.emit(op2);                  // threaded via own methods (safe)
//   return st;                          // moved out
// `reclaimable_names_of` excludes it (`return st` is an escape under
// body_unsafe_for), so its intermediate rebind clones leak. The snapshot-LOCAL
// path reclaims each REBIND via emit_field_reclaim_store and KEEPS the final via
// struct move-on-return. The rebind release is guarded by a snapshot of the box
// the binding DERIVED from (`se` here): a fresh box copies the borrowed
// receiver's fields uncounted, so without it the first rebind released a field
// buffer the caller still owned. The same snapshot admits the alias `var sc = s`
// and the call-derived `var sl = lower_expr(x, s)`, whose box may BE the
// source's; those two earn no struct credit and reclaim by their rebinds only.

// is_fresh_struct_ret_value reports whether a return value is a freshly
// CONSTRUCTED struct — a literal or struct-update of a leaf-safe struct. A bare
// ident / call / anything else is NOT fresh (it may alias a borrowed param).
function is_fresh_struct_ret_value(e: ast.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprStructLit(slit) => { return decl_is_struct(structs, slit.type_name) && decl_is_leaksafe(structs, slit.type_name); },
        _ => { return false; }
    }
    return false;
}
// body_has_return / body_has_nonfresh_return: recursive return scans (nested
// control flow included). A function is fresh-returning iff it has at least one
// return AND every return value is a fresh struct construction.
function body_has_return(stmts: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(_) => { return true; },
            ast.StmtIf(f) => { if (body_has_return(f.then_body) || body_has_return(f.else_body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_return(w.body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_return(fo.body)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_return(m.arms[a].body)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}
function body_has_nonfresh_return(stmts: ast.Stmt[], structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!is_fresh_struct_ret_value(r.value, structs)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonfresh_return(f.then_body, structs) || body_has_nonfresh_return(f.else_body, structs)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_return(w.body, structs)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_return(fo.body, structs)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_return(m.arms[a].body, structs)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}
// fresh_struct_ret_fns_of: keys (bare name / "<BaseType>.<method>") of functions
// whose return is ALWAYS a freshly-constructed leaf-safe struct — so a binding
// `var st = f(..)` / `var st = obj.m(..)` owns a fresh box (never an alias of a
// borrowed arg). Threaded into lower_func like struct_ret_fns; consumed only by
// snapshot_local_names_of.
pub function fresh_struct_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        var rt: string = fn.ret_type;
        if (decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt) && body_has_return(fn.body) && !body_has_nonfresh_return(fn.body, structs)) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
    }
    return out;
}
// --- strict-fresh struct return (discarded-local reclaim guard) --------------
//
// return_fresh_struct_ret_fns_of is the STRICT subset of fresh_struct_ret_fns:
// functions whose every return is a struct literal (no base) whose every array-
// typed field is set from a FRESH array LITERAL of a SCALAR or STRING element
// type. Such a returned box is unambiguously the SOLE owner of every field
// buffer (no alias anywhere, scalar/string elements carry no shared inner
// pointers), so a CALLER that binds it to a DISCARDED local can deep-drop it at
// scope exit with no use-after-free. The looser fresh_struct_ret_fns is NOT
// sufficient for that: it admits alias-inc'd fields and struct[]/enum[] fields
// whose elements alias live locals — the outer-pointer alias-inc does not guard
// the inner element buffers, so a discarded-local deep-drop double-frees them
// (observed as a per-module whole-compiler self-compile segfault). Consumed by
// reclaimable_names_of (collect_fresh_ret_call_names). #3457 follow-up.
function field_type_is_array(t: string): boolean {
    return t.len() >= 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]";
}
// struct_lit_field_ident_count: how many of `slit`'s field values are the bare
// ident `name`. One is a move-out; TWO would give the returned box two owning
// references to one buffer under a single rc, so __struct_drop_<T> would free it
// twice. The array-LITERAL form cannot express that (two literals are two
// buffers), so the check arrives with the ident form.
function struct_lit_field_ident_count(slit: ast.ExprStructLit, name: string): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < slit.field_values.len()) {
        match (slit.field_values[i]) {
            ast.ExprIdent(fid) => { if (fid.name == name) { n = n + 1; } },
            _ => {}
        }
        i = i + 1;
    }
    return n;
}

// local_decl_count: how many `var name` declarations `stmts` contains, nested
// blocks included.
// Over astwalk's binder walk, for the reason body_declares_name is — and here it
// was a live miscompile rather than a latent one. The copy this replaces counted
// `var` declarations only: it did not read `for` binders, match payload binders,
// or the comma-joined destructure form. try_lift_binding uses the count to
// refuse the lambda lift when a name means two things, and subst_fcall_expr
// rewrites `f(…)` inside `for` and `match` bodies — so a `for f in fns` over a
// lifted `f` counted 1, the lift proceeded, and every element's call was
// rewritten to the hoisted body. Measured 35 against the interpreter's 99.
function local_decl_count(stmts: ast.Stmt[], name: string): i32 {
    var bound: string[] = astwalk.collect_bound_stmts(stmts, []);
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < bound.len()) {
        if (bound[i] == name) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// arr_field_ident_is_frame_built: `name` is an array LOCAL this frame owns from
// its declaration, only ever self-appended to, and never escaped except into the
// returned struct literal — so the returned box reaches the caller as the sole
// owner of that buffer, exactly as a direct array literal in the field would.
// The three predicates are the ones "ARR:" already uses for the same proof one
// container out; the difference is only which single escape is forgiven.
function arr_field_ident_is_frame_built(name: string, fnbody: ast.Stmt[], arr_fresh: string[]): boolean {
    // Exactly one declaration, so the init witness below cannot be a shadowed
    // sibling of a `var xs = param` in another block — arr_local_init_is_frame_
    // fresh answers on the first declaration it meets, and the two escape scans
    // are name-keyed, so neither would see the second one.
    if (local_decl_count(fnbody, name) != 1) { return false; }
    if (!arr_local_init_is_frame_fresh(fnbody, name, arr_fresh, fnbody)) { return false; }
    if (arr_reassigned_other_than_selfappend(fnbody, name)) { return false; }
    var no_borrow: string[] = [];
    return !body_unsafe_for_allow_structret(fnbody, name, no_borrow);
}

// strarr_share_read_holder_type: `fv` is the counted-share read `q.f` of a
// `string[]` field off a bare-ident holder this frame can type — a parameter,
// or a local declared exactly once by annotation or by a no-base literal — and
// the answer is that holder's struct type; "" for any other shape. A name bound
// both as a parameter and a local, or declared twice, is refused: every scan
// here is name-keyed and would answer for the wrong binding.
//
// Why the returned literal may hold such a read and still be strict-fresh: the
// ExprStructLit lowering retains the read (enum_arr_field_share_read's arm), so
// the box leaves with a counted reference of its own. The source holder's drop
// releases only the count the source held, and the caller's deep drop decs the
// one the literal took; __fern_str_arr_free walks elements only at rc 1, so a
// second reader that outlives this frame — a holder that was a parameter, a
// second literal, a holder that escaped and was never dropped — leaves the
// count above 1 and costs a leak, never a free. The same terms as the bare
// ident the caller admits one branch up, whose retain is is_arr_slot's.
function strarr_share_read_holder_type(fv: ast.Expr, fnbody: ast.Stmt[], fnparams: ast.ParamDecl[], structs: parser.StructDecl[]): string {
    if let ast.ExprFieldAccess(fa) = fv {
        if let ast.ExprIdent(hid) = fa.obj {
            var hty: string = "";
            var pi: i32 = 0;
            while (pi < fnparams.len()) {
                if (fnparams[pi].name == hid.name) { hty = fnparams[pi].type_name; }
                pi = pi + 1;
            }
            var decls: i32 = local_decl_count(fnbody, hid.name);
            if (decls > 1 || (decls > 0 && hty.len() > 0)) { return ""; }
            if (hty.len() == 0) { hty = declared_struct_type_of(fnbody, hid.name, structs); }
            if (hty.len() == 0) { hty = fresh_struct_lit_type_deep(fnbody, hid.name); }
            if (!decl_is_struct(structs, hty)) { return ""; }
            if (decl_field_type(structs, hty, fa.field) != "string[]") { return ""; }
            return hty;
        }
    }
    return "";
}

// body_unsafe_for_allow_structret / stmt_unsafe_for_allow_structret: body_unsafe_for
// with one use forgiven — `name` appearing as a bare field value of a
// RETURN-POSITION struct literal, which is the move-out being proved. Every other
// unsafe use, including a non-bare field value in that same literal, still flags.
function body_unsafe_for_allow_structret(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
    return body_unsafe_for_ret_ok(stmts, name, borrowable, false);
}

// body_unsafe_for_allow_bare_ret is the same gate with ONE more forgiveness: a
// top-level `return <name>`. The struct-literal variant above forgives the name
// only at a FIELD of a returned literal (`return P { xs: p }`), so a bare
// `return p` still reads as an escape there — correct for its caller, which asks
// about an array field moved INTO a returned struct, and wrong for a local that
// IS the returned struct (#7343).
//
// Everything else stays flagged: an alias bind, a container store, a moved-out
// field, a non-borrowable call argument. Only the one escape that is the point of
// the shape is forgiven, and only in return position.
function body_unsafe_for_allow_bare_ret(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
    return body_unsafe_for_ret_ok(stmts, name, borrowable, true);
}

function body_unsafe_for_ret_ok(stmts: ast.Stmt[], name: string, borrowable: string[], bare_ret_ok: boolean): boolean {
    for stmt in stmts { if (stmt_unsafe_for_ret_ok(stmt, name, borrowable, bare_ret_ok)) { return true; } }
    return false;
}
function stmt_unsafe_for_ret_ok(st: ast.Stmt, name: string, borrowable: string[], bare_ret_ok: boolean): boolean {
    match (st) {
        ast.StmtVar(v) => { return expr_unsafe_for(v.init, name, borrowable, []); },
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprStructLit(rlit) => {
                    var fi: i32 = 0;
                    while (fi < rlit.field_values.len()) {
                        var bare: boolean = false;
                        match (rlit.field_values[fi]) {
                            ast.ExprIdent(fid) => { bare = fid.name == name; },
                            _ => {}
                        }
                        if (!bare && expr_unsafe_for(rlit.field_values[fi], name, borrowable, [])) { return true; }
                        fi = fi + 1;
                    }
                    return false;
                },
                // A bare `return <name>` — the move-out this local exists for, and
                // an escape for every other caller of this gate.
                ast.ExprIdent(rid) => {
                    if (bare_ret_ok && rid.name == name) { return false; }
                    return expr_unsafe_for(r.value, name, borrowable, []);
                },
                _ => { return expr_unsafe_for(r.value, name, borrowable, []); }
            }
        },
        ast.StmtExpr(e) => { return expr_unsafe_for(e.value, name, borrowable, []); },
        ast.StmtAssign(a) => { return expr_unsafe_for(a.value, name, borrowable, []); },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, [])) { return true; }
            return body_unsafe_for_ret_ok(f.then_body, name, borrowable, bare_ret_ok) || body_unsafe_for_ret_ok(f.else_body, name, borrowable, bare_ret_ok);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, [])) { return true; }
            return body_unsafe_for_ret_ok(w.body, name, borrowable, bare_ret_ok);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, []); }
            }
            if (iter_unsafe) { return true; }
            return body_unsafe_for_ret_ok(fo.body, name, borrowable, bare_ret_ok);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, [])) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) { return true; }
                if (body_unsafe_for_ret_ok(arm.body, name, borrowable, bare_ret_ok)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// spread_copy_field_counted: a field of type `t` of struct `sty`, CARRIED
// through a `T { ...base, … }` spread, reaches the new box as a COUNTED
// reference. The base-copy path of lower_expr_struct_lit retains a
// nested-struct or enum field unconditionally and a STRING field only under
// `slit_reclaim` — the routing verdict — so the string case asks the very same
// predicate rather than assuming it. A scalar carries no reference at all.
// Every other kind — arrays, tuples, maps, options, closures — is copied
// uncounted.
//
// The string clause is not a detail: an unrouted string-fielded type spread as
// a base mints an uncounted co-owner, and treating that as counted hands two
// owners one buffer. Claiming it segfaulted gen1 of the per-module emit-all
// fixpoint while every small-program gate stayed green.
function spread_copy_field_counted(structs: parser.StructDecl[], sfok: string[], sty: string, t: string): boolean {
    if (reuse_field_is_scalar(t) || decl_is_enum(structs, t) || decl_is_struct(structs, t)) { return true; }
    return t == "string" && struct_routes_field_reclaim_at(structs, sfok, sty);
}

// spread_copy_counted: every field of struct `sty` is spread_copy_field_counted,
// so a `T { ...base, … }` over it mints no uncounted co-owner of base's fields.
function spread_copy_counted(structs: parser.StructDecl[], sfok: string[], sty: string): boolean {
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        if (!spread_copy_field_counted(structs, sfok, sty, decl_field_type_at(structs, sty, fi))) { return false; }
        fi = fi + 1;
    }
    return n > 0;
}

// spread_carried_fields_counted: the fields `slit` CARRIES from its base — every
// declared field it does not override — all copy counted, so the box it builds
// sole-owns a reference to each, exactly as a no-base literal's fields do. The
// overrides take the caller's per-field walk like any literal's.
function spread_carried_fields_counted(structs: parser.StructDecl[], sfok: string[], slit: ast.ExprStructLit): boolean {
    var n: i32 = decl_field_count(structs, slit.type_name);
    var fi: i32 = 0;
    while (fi < n) {
        if (util.index_of_str(slit.field_names, decl_field_name_at(structs, slit.type_name, fi)) < 0
            && !spread_copy_field_counted(structs, sfok, slit.type_name, decl_field_type_at(structs, slit.type_name, fi))) { return false; }
        fi = fi + 1;
    }
    return true;
}

// own_param_ret_is_frame_fresh: `return name` where name is an `own` struct
// PARAMETER hands the caller the box it moved in — sole-owned by the own
// contract, its fields counted by the caller's construction — provided this
// frame took no second reference to it: never redeclared, reassigned, aliased,
// stored or passed on (body_unsafe_for_allow_bare_ret with an empty borrow
// registry, so any call argument refuses), and no field copied out uncounted
// (a spread over counted kinds is forgiven).
function own_param_ret_is_frame_fresh(name: string, structs: parser.StructDecl[], sfok: string[], fnbody: ast.Stmt[], fnparams: ast.ParamDecl[]): boolean {
    var ty: string = "";
    var pi: i32 = 0;
    while (pi < fnparams.len()) {
        if (fnparams[pi].name == name && fnparams[pi].own) { ty = fnparams[pi].type_name; }
        pi = pi + 1;
    }
    if (ty.len() == 0 || !decl_is_struct(structs, ty) || !decl_is_leaksafe(structs, ty)) { return false; }
    if (local_decl_count(fnbody, name) != 0) { return false; }
    if (util.index_of_str(body_assign_targets(fnbody), name) >= 0) { return false; }
    var no_borrow: string[] = [];
    if (body_unsafe_for_allow_bare_ret(fnbody, name, no_borrow)) { return false; }
    var no_nomove: string[] = [];
    if (moves_fields_stmts(fnbody, name, no_nomove, spread_copy_counted(structs, sfok, ty))) { return false; }
    return !optstruct_body_moves_field(fnbody, name, ty, structs, no_borrow);
}

function return_value_is_strictfresh_struct(e: ast.Expr, structs: parser.StructDecl[], fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
    match (e) {
        ast.ExprStructLit(slit) => {
            if (!(decl_is_struct(structs, slit.type_name) && decl_is_leaksafe(structs, slit.type_name))) { return false; }
            // A functional update `T { ...base, … }` qualifies when every
            // CARRIED field copies counted; its overrides take the walk below.
            if (slit.has_base && !spread_carried_fields_counted(structs, sfok, slit)) { return false; }
            var i: i32 = 0;
            while (i < slit.field_names.len()) {
                var ft: string = decl_field_type(structs, slit.type_name, slit.field_names[i]);
                if (field_type_is_array(ft)) {
                    // Only scalar-element / string arrays — a struct[]/enum[] field
                    // (deep-drop recursion into possibly-aliased elements) bails.
                    if (!(is_leaksafe_array_field(ft) || ft == "string[]")) { return false; }
                    var v: ast.Expr = slit.field_values[i];
                    var ok: boolean = iife_returns_fresh_array(v);
                    match (v) { ast.ExprArray(_) => { ok = true; }, _ => {} }
                    // `Q { xs: mk(i) }` — a PRODUCER call. The registries have
                    // already proven whole-program that such a callee hands back
                    // an array box it allocated, elements included for a
                    // string[], so the literal moves that sole reference into
                    // the struct exactly as it moves a literal's. Declining it
                    // cost the CALLER's binding its whole reclaim — box, buffer
                    // and elements — on the ordinary way a producer is written.
                    // `arr_fresh` carries the scalar-element registry under bare
                    // names and the string[] one under an "SA:" prefix, inert
                    // for every bare lookup (the reclaimable_names convention).
                    // A local or parameter of the callee's name holds an unknown
                    // body: refused, exactly as the forwarding arm below does.
                    match (v) {
                        ast.ExprCall(vc) => {
                            match (vc.callee) {
                                ast.ExprIdent(vcid) => {
                                    var known: boolean = false;
                                    if (ft == "string[]") { known = util.index_of_str(arr_fresh, "SA:" + vcid.name) >= 0; }
                                    else { known = util.index_of_str(arr_fresh, vcid.name) >= 0; }
                                    if (known && !body_declares_name(fnbody, vcid.name)) {
                                        var vp: i32 = 0;
                                        var shadowed: boolean = false;
                                        while (vp < fnparams.len()) {
                                            if (fnparams[vp].name == vcid.name) { shadowed = true; }
                                            vp = vp + 1;
                                        }
                                        if (!shadowed) { ok = true; }
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    // `var xs = [ … ]; return Q { xs: xs, … }` — how a producer is
                    // actually written, and the literal-only rule declined it, so
                    // every caller's `var q = mk(i)` earned no reclaim credit and
                    // leaked box + buffer per call (#6758).
                    match (v) {
                        ast.ExprIdent(vid) => {
                            if (!ok && struct_lit_field_ident_count(slit, vid.name) == 1
                                && arr_field_ident_is_frame_built(vid.name, fnbody, arr_fresh)) { ok = true; }
                        },
                        _ => {}
                    }
                    // A bare IDENT — a parameter or a live local. Admitted only
                    // when this struct's type ROUTES field reclaim, because that
                    // is the same predicate the construction retain is gated on
                    // (irlower.fern's struct-lit `slit_reclaim`): routed means the
                    // literal took a reference, so the caller's drop decs a count
                    // it owns instead of freeing the caller's array. Unrouted, the
                    // field is an uncounted alias and crediting the caller would
                    // hand the struct freed memory (#6703's class).
                    if (!ok) {
                        match (v) {
                            ast.ExprIdent(_) => {
                                if (struct_routes_field_reclaim_at(structs, sfok, slit.type_name)) { ok = true; }
                            },
                            _ => {}
                        }
                    }
                    // `Q { f: q.f }` over a `string[]` field — the counted-share
                    // READ (#5338), admitted on the same terms as the bare ident
                    // above: the construction retains it, so the returned box
                    // holds a count of its own that the caller's drop decs.
                    if (!ok && ft == "string[]"
                        && strarr_share_read_holder_type(v, fnbody, fnparams, structs).len() > 0
                        && struct_routes_field_reclaim_at(structs, sfok, slit.type_name)) { ok = true; }
                    if (!ok) { return false; }
                }
                i = i + 1;
            }
            return true;
        },
        // `return mkp(a, b)` — a FORWARDING frame. The callee is already proven
        // to hand back a box it allocated, and this frame neither binds nor
        // aliases it, so what reaches the caller is that same sole reference.
        // Without this the caller's binding earned no reclaim credit at all and
        // the box leaked whole: 48 B a round on a scalar-only struct, where the
        // direct call to the same producer is flat (#7062).
        //
        // Refused when the name is not the DECLARATION the registry is keyed by
        // — a local or a parameter of that name holds an unknown closure body,
        // the same refusal owned_fresh_call_callee makes at the call site.
        ast.ExprCall(fc) => {
            match (fc.callee) {
                ast.ExprIdent(fcid) => {
                    if (util.index_of_str(fwd, fcid.name) < 0) { return false; }
                    if (body_declares_name(fnbody, fcid.name)) { return false; }
                    var pi: i32 = 0;
                    while (pi < fnparams.len()) {
                        if (fnparams[pi].name == fcid.name) { return false; }
                        pi = pi + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        // `return p` — a LOCAL this frame built and hands straight back. The form
        // real code has: anything that assembles a struct's fields before
        // returning it cannot use the literal-return form, so refusing this cost
        // every caller of such a producer its whole reclaim (#7343).
        //
        // The proof is struct_ret_local_is_frame_fresh, the struct-level sibling
        // of the arr_field_ident_is_frame_built check this same function already
        // runs one level down for an ARRAY field.
        ast.ExprIdent(rid) => {
            if (own_param_ret_is_frame_fresh(rid.name, structs, sfok, fnbody, fnparams)) { return true; }
            return struct_ret_local_is_frame_fresh(rid.name, structs, fnbody, arr_fresh, fwd, fnparams, sfok);
        },
        _ => { return false; }
    }
    return false;
}

// struct_ret_local_is_frame_fresh: `name` is a LOCAL this frame built from a
// strict-fresh struct value and then returned, so what reaches the caller is the
// same sole reference the literal-return form would have handed it.
//
// Four conditions, each ruling out a different way the box could already be
// shared when it leaves:
//
//   - EXACTLY ONE declaration of the name in the body, so the init witness below
//     cannot be a shadowed sibling in another block — the scans here are
//     name-keyed and would not see the second one. Same first line, same reason,
//     as arr_field_ident_is_frame_built.
//   - not a PARAMETER: the caller owns that box, and handing it back is the
//     `return self` shape this whole registry exists to refuse.
//   - never REASSIGNED, which is what makes the declaration's init the whole
//     story rather than one of several possible final values.
//   - its init is itself strict-fresh, recursively — a literal, a forwarding
//     call, or another such local. Fern requires declaration before use, so the
//     chain walks strictly backwards and terminates.
//
// Then the escape gate, and the ALLOW_STRUCTRET variant is the load-bearing
// choice: it forgives exactly one escape, the `return` that is the point of the
// shape, and still flags an alias bind, a container store, a moved-out field or
// a non-borrowable call argument. A second reference taken anywhere before the
// return sinks the credit.
function struct_ret_local_is_frame_fresh(name: string, structs: parser.StructDecl[], fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
    if (local_decl_count(fnbody, name) != 1) { return false; }
    var pi: i32 = 0;
    while (pi < fnparams.len()) {
        if (fnparams[pi].name == name) { return false; }
        pi = pi + 1;
    }
    // A REASSIGNED local is admitted only when every assignment carries a
    // strict-fresh struct value itself: the box the return hands out is then
    // frame-fresh whichever write produced it, and the escape gates below
    // still sink the credit if any reference was taken along the way. One
    // write outside the classifier keeps the refusal — the final value's
    // provenance is unknowable to a flow-free scan. Without this arm the
    // ordinary rebuild-and-return producer freed nothing at all: the caller's
    // binding earned no credit, and 240 B leaked per call (#7357's
    // struct_producer_returns_local decomposition).
    if (util.index_of_str(body_assign_targets(fnbody), name) >= 0
        && !struct_local_assigns_all_strictfresh(fnbody, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
    if (!struct_ret_local_init_strictfresh(fnbody, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
    // A FIELD read out of the local is refused as well, and this is the one
    // condition the escape gate above does not cover: `var stolen = p.xs;` is
    // not an escape OF p — expr_unsafe_for sees a borrow — but it takes a second
    // reference to the very buffer the caller's deep drop will free. The shape
    // measures balanced today (200/200, underflow 0, all three oracles agreeing)
    // because the reader dies at this frame's exit, so this refusal costs a leak
    // rather than fixing a fault. It is the safe direction and it is deliberate:
    // admitting it would rest on "no reader outlives the frame", which is a
    // liveness claim this predicate does not make and moves_fields_stmts does.
    var no_nomove: string[] = [];
    if (moves_fields_stmts(fnbody, name, no_nomove, false)) { return false; }
    var mvsty: string = declared_struct_type_of(fnbody, name, structs);
    var no_mv_borrow: string[] = [];
    if (mvsty != "" && optstruct_body_moves_field(fnbody, name, mvsty, structs, no_mv_borrow)) { return false; }
    var no_borrow: string[] = [];
    return !body_unsafe_for_allow_bare_ret(fnbody, name, no_borrow);
}

// struct_local_assigns_all_strictfresh: every `name = …` assignment anywhere in
// the subtree (nested blocks and defer actions included) carries a value the
// strict-fresh classifier admits. Vacuously true for an unassigned name; the
// caller pairs it with body_assign_targets so it is only consulted when at
// least one assignment exists.
function struct_local_assigns_all_strictfresh(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name && !return_value_is_strictfresh_struct(a.value, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
            },
            ast.StmtIf(f) => {
                if (!struct_local_assigns_all_strictfresh(f.then_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
                if (!struct_local_assigns_all_strictfresh(f.else_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
            },
            ast.StmtWhile(w) => { if (!struct_local_assigns_all_strictfresh(w.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; } },
            ast.StmtFor(fo) => { if (!struct_local_assigns_all_strictfresh(fo.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (!struct_local_assigns_all_strictfresh(arm.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
                }
            },
            ast.StmtDefer(d) => {
                var one: ast.Stmt[] = [d.action];
                if (!struct_local_assigns_all_strictfresh(one, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
            },
            _ => {}
        }
    }
    return true;
}

// struct_ret_local_init_strictfresh finds `name`'s single declaration anywhere in
// `stmts` (nested blocks included) and asks whether its initialiser is a
// strict-fresh struct value. Answers false when no declaration is found, which is
// the conservative direction: an undeclared name is a parameter or a shadow the
// caller already refused.
function struct_ret_local_init_strictfresh(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    return return_value_is_strictfresh_struct(v.init, structs, fnbody, arr_fresh, fwd, fnparams, sfok);
                }
            },
            ast.StmtIf(f) => {
                if (struct_ret_local_init_strictfresh(f.then_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; }
                if (struct_ret_local_init_strictfresh(f.else_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; }
            },
            ast.StmtWhile(w) => { if (struct_ret_local_init_strictfresh(w.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } },
            ast.StmtFor(fo) => { if (struct_ret_local_init_strictfresh(fo.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (struct_ret_local_init_strictfresh(arm.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; }
                }
            },
            _ => {}
        }
    }
    return false;
}
// body_returns_fresh_or_self_struct: every return in `stmts` hands back either a
// strict-fresh struct literal or the RECEIVER itself (`return b`). The mixed
// shape every builder-ish method opens with — `if (t.len() == 0) { return b; }`
// — which no all-fresh registry can admit, and which the caller can still
// release under a pointer compare because those are the only two boxes it can
// be. A body with no return at all answers false via the caller's
// body_has_return check.
function body_returns_fresh_or_self_struct(stmts: ast.Stmt[], structs: parser.StructDecl[], fnbody: ast.Stmt[], recv: string, arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var self_ret: boolean = false;
                match (r.value) {
                    ast.ExprIdent(rid) => { if (rid.name == recv) { self_ret = true; } },
                    _ => {}
                }
                if (!self_ret && !return_value_is_strictfresh_struct(r.value, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return false; }
            },
            ast.StmtIf(f) => { if (!body_returns_fresh_or_self_struct(f.then_body, structs, fnbody, recv, arr_fresh, fwd, fnparams, sfok) || !body_returns_fresh_or_self_struct(f.else_body, structs, fnbody, recv, arr_fresh, fwd, fnparams, sfok)) { return false; } },
            ast.StmtWhile(w) => { if (!body_returns_fresh_or_self_struct(w.body, structs, fnbody, recv, arr_fresh, fwd, fnparams, sfok)) { return false; } },
            ast.StmtFor(fo) => { if (!body_returns_fresh_or_self_struct(fo.body, structs, fnbody, recv, arr_fresh, fwd, fnparams, sfok)) { return false; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (!body_returns_fresh_or_self_struct(m.arms[a].body, structs, fnbody, recv, arr_fresh, fwd, fnparams, sfok)) { return false; } a = a + 1; } },
            _ => {}
        }
    }
    return true;
}
function body_has_nonstrictfresh_return(stmts: ast.Stmt[], structs: parser.StructDecl[], fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!return_value_is_strictfresh_struct(r.value, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonstrictfresh_return(f.then_body, structs, fnbody, arr_fresh, fwd, fnparams, sfok) || body_has_nonstrictfresh_return(f.else_body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonstrictfresh_return(w.body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonstrictfresh_return(fo.body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonstrictfresh_return(m.arms[a].body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}
// body_has_nonfresh_arrlit_return: any return whose value is NOT a direct,
// non-empty array LITERAL. The array sibling of body_has_nonstrictfresh_return
// / body_has_nonfresh_tuple_return: a literal in return position constructs a
// fresh rc-headered box the callee never binds, so the CALLER'S shallow box
// dec (which never reads elements) is balanced against it. A bare `return out`
// of a local declines (could alias / be swept by the callee).
function body_has_nonfresh_arrlit_return(stmts: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var fresh: boolean = false;
                match (r.value) {
                    ast.ExprArray(ae) => { fresh = ae.elements.len() > 0; },
                    _ => {}
                }
                if (!fresh) { return true; }
            },
            ast.StmtIf(f) => { if (body_has_nonfresh_arrlit_return(f.then_body) || body_has_nonfresh_arrlit_return(f.else_body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_arrlit_return(w.body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_arrlit_return(fo.body)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_arrlit_return(m.arms[a].body)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}
// ── the LOCAL-built scalar-array producer (#6491 follow-up) ──────────────────
//
// `var out: i32[] = []; … out = out.append(v); … return out;` is how a producer
// is actually written, and the literal-return rule above declines it — so the
// caller's reclaims (the discarded `mk(i);` statement and the `mk()[i]` read)
// both left the buffer to leak, 2824 B over 50 rounds where native is flat.
//
// The three predicates below admit it. Together they prove the returned buffer
// is built ENTIRELY in this frame and reaches the caller as its sole rc == 1
// reference: the init is a literal (so it cannot start as a param's buffer), the
// only rebind is the self-append (so it cannot become one later), and nothing
// else escapes it. Element freshness needs no proof at all here — the ret type
// is is_leaksafe_array_field, so every element is a SCALAR, and the shallow
// element-blind `__fern_rc_dec` both consumers emit has no pointer to dangle.

// arr_returned_ident_names collects the name of every `return <ident>` in
// `stmts`. Paired with body_has_nonident_arr_return, which refuses the function
// outright if any return is some other shape.
function arr_returned_ident_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprIdent(rid) => { a = push_str_unique(a, rid.name); },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { a = arr_returned_ident_names(f.then_body, a); a = arr_returned_ident_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = arr_returned_ident_names(w.body, a); },
            ast.StmtFor(fo) => { a = arr_returned_ident_names(fo.body, a); },
            ast.StmtMatch(m) => { var k: i32 = 0; while (k < m.arms.len()) { a = arr_returned_ident_names(m.arms[k].body, a); k = k + 1; } },
            _ => {}
        }
    }
    return a;
}
function body_has_nonident_arr_return(stmts: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var ok: boolean = false;
                match (r.value) { ast.ExprIdent(_) => { ok = true; }, _ => {} }
                if (!ok) { return true; }
            },
            ast.StmtIf(f) => { if (body_has_nonident_arr_return(f.then_body) || body_has_nonident_arr_return(f.else_body)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonident_arr_return(w.body)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonident_arr_return(fo.body)) { return true; } },
            ast.StmtMatch(m) => { var k: i32 = 0; while (k < m.arms.len()) { if (body_has_nonident_arr_return(m.arms[k].body)) { return true; } k = k + 1; } },
            _ => {}
        }
    }
    return false;
}

// arr_local_init_is_frame_fresh: `name` is declared in `stmts` as `var name = [ … ]`
// (an empty `[]` qualifies — that is the accumulator idiom) or as a call to a
// producer in `arr_fresh`. Without this the name could be seeded from a
// parameter and the caller would free the caller's caller's buffer.
function arr_local_init_is_frame_fresh(stmts: ast.Stmt[], name: string, arr_fresh: string[], fnbody: ast.Stmt[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprArray(_) => { return true; },
                        // A call to an "ARR:" producer proves the same thing the
                        // literal does — the returned buffer is a sole-owned rc=1
                        // box this frame allocated — one call out. A LOCAL
                        // shadowing the callee's name is refused: the registry is
                        // keyed by declaration, so the name would resolve to
                        // something the proof never saw.
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprIdent(cid) => {
                                    return util.index_of_str(arr_fresh, cid.name) >= 0
                                        && local_decl_count(fnbody, cid.name) == 0;
                                },
                                _ => { return false; }
                            }
                        },
                        _ => { return false; }
                    }
                }
            },
            ast.StmtIf(f) => { if (arr_local_init_is_frame_fresh(f.then_body, name, arr_fresh, fnbody) || arr_local_init_is_frame_fresh(f.else_body, name, arr_fresh, fnbody)) { return true; } },
            ast.StmtWhile(w) => { if (arr_local_init_is_frame_fresh(w.body, name, arr_fresh, fnbody)) { return true; } },
            ast.StmtFor(fo) => { if (arr_local_init_is_frame_fresh(fo.body, name, arr_fresh, fnbody)) { return true; } },
            ast.StmtMatch(m) => { var k: i32 = 0; while (k < m.arms.len()) { if (arr_local_init_is_frame_fresh(m.arms[k].body, name, arr_fresh, fnbody)) { return true; } k = k + 1; } },
            _ => {}
        }
    }
    return false;
}

// arr_reassigned_other_than_selfappend: `name` is rebound by anything other than
// the sanctioned `name = name.append(v)`. body_unsafe_for_allow_ret cannot see
// this — its StmtAssign arm inspects only the assigned VALUE, so `out = param`
// reads as safe there while it is exactly what would alias a buffer this frame
// does not own.
function arr_reassigned_other_than_selfappend(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name) {
                    var self_append: boolean = false;
                    match (a.value) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprFieldAccess(fa) => {
                                    if (fa.field == "append" && c.args.len() == 1) {
                                        match (fa.obj) {
                                            ast.ExprIdent(rid) => { self_append = rid.name == name; },
                                            _ => {}
                                        }
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    if (!self_append) { return true; }
                }
            },
            ast.StmtIf(f) => { if (arr_reassigned_other_than_selfappend(f.then_body, name) || arr_reassigned_other_than_selfappend(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (arr_reassigned_other_than_selfappend(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (arr_reassigned_other_than_selfappend(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => { var k: i32 = 0; while (k < m.arms.len()) { if (arr_reassigned_other_than_selfappend(m.arms[k].body, name)) { return true; } k = k + 1; } },
            ast.StmtDefer(d) => { if (arr_reassigned_other_than_selfappend([d.action], name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// body_returns_local_built_arr: every return hands back a local this frame built
// from a literal and only ever self-appended to, and nothing else escapes it.
function body_returns_local_built_arr(stmts: ast.Stmt[]): boolean {
    if (body_has_nonident_arr_return(stmts)) { return false; }
    var names: string[] = arr_returned_ident_names(stmts, []);
    if (names.len() == 0) { return false; }
    var no_borrow: string[] = [];
    // Literal inits only here: this predicate is what arr_fresh_ret_fns_of asks,
    // so consulting that registry from inside it would be circular. A producer
    // returning a local built from ANOTHER producer's result is a widening of
    // its own, not this one.
    var no_producers: string[] = [];
    var i: i32 = 0;
    while (i < names.len()) {
        if (!arr_local_init_is_frame_fresh(stmts, names[i], no_producers, stmts)) { return false; }
        if (arr_reassigned_other_than_selfappend(stmts, names[i])) { return false; }
        if (body_unsafe_for_allow_ret(stmts, names[i], no_borrow, [])) { return false; }
        i = i + 1;
    }
    return true;
}

// ── the POINTER half of the fresh-owned-container read (#6491) ───────────────
//
// The scalar half above copies the value out of the container, so releasing the
// container cannot dangle it. A `string` element / field POINTS BACK INTO what
// is being freed, so admitting one needs a stronger property than "the container
// is sole-owned": the extracted reference must be one the container SOLE-OWNS
// too, else the read hands the destination a reference someone else still
// releases. The predicates below prove exactly that, per producer.

// strarr_value_is_fresh: `e` produces a string box this frame constructs and
// nothing else names — a literal (const_str builds a fresh rc=1 box per
// evaluation), a concat / string-method producer (str_local_binding_is_fresh),
// or a call to a whole-program str-fresh-ret free function. A bare ident /
// param / field read is refused: it may alias a live box, and transferring it
// out of the container would leave two owners of one reference.
function strarr_value_is_fresh(e: ast.Expr, str_fresh: string[]): boolean {
    match (e) {
        ast.ExprString(_) => { return true; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (util.index_of_str(str_fresh, cid.name) >= 0) { return true; }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return str_local_binding_is_fresh(e);
}

// body_has_nonfresh_strarr_lit_return: any return whose value is NOT a direct,
// non-empty string-array LITERAL of fresh elements. The `string[]` sibling of
// body_has_nonfresh_arrlit_return, with the element proof that one does not need
// (its elements are scalars).
function body_has_nonfresh_strarr_lit_return(stmts: ast.Stmt[], str_fresh: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                var fresh: boolean = false;
                match (r.value) {
                    ast.ExprArray(ae) => {
                        fresh = ae.elements.len() > 0;
                        var ei: i32 = 0;
                        while (ei < ae.elements.len()) {
                            if (!strarr_value_is_fresh(ae.elements[ei], str_fresh)) { fresh = false; }
                            ei = ei + 1;
                        }
                    },
                    _ => {}
                }
                if (!fresh) { return true; }
            },
            ast.StmtIf(f) => { if (body_has_nonfresh_strarr_lit_return(f.then_body, str_fresh) || body_has_nonfresh_strarr_lit_return(f.else_body, str_fresh)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_strarr_lit_return(w.body, str_fresh)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_strarr_lit_return(fo.body, str_fresh)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_strarr_lit_return(m.arms[a].body, str_fresh)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// strarr_local_stores_nonfresh: `name` is initialised or self-appended with a
// value that is not provably fresh. Paired with arr_local_has_literal_init /
// arr_reassigned_other_than_selfappend (which prove the BUFFER is this frame's),
// it proves every ELEMENT is this frame's too.
function strarr_local_stores_nonfresh(stmts: ast.Stmt[], name: string, str_fresh: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprArray(ae) => {
                            var ei: i32 = 0;
                            while (ei < ae.elements.len()) {
                                if (!strarr_value_is_fresh(ae.elements[ei], str_fresh)) { return true; }
                                ei = ei + 1;
                            }
                        },
                        _ => { return true; }
                    }
                }
            },
            ast.StmtAssign(a) => {
                if (a.target == name) {
                    var ok: boolean = false;
                    match (a.value) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprFieldAccess(fa) => {
                                    if (fa.field == "append" && c.args.len() == 1) { ok = strarr_value_is_fresh(c.args[0], str_fresh); }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    if (!ok) { return true; }
                }
            },
            ast.StmtIf(f) => { if (strarr_local_stores_nonfresh(f.then_body, name, str_fresh) || strarr_local_stores_nonfresh(f.else_body, name, str_fresh)) { return true; } },
            ast.StmtWhile(w) => { if (strarr_local_stores_nonfresh(w.body, name, str_fresh)) { return true; } },
            ast.StmtFor(fo) => { if (strarr_local_stores_nonfresh(fo.body, name, str_fresh)) { return true; } },
            ast.StmtMatch(m) => { var k: i32 = 0; while (k < m.arms.len()) { if (strarr_local_stores_nonfresh(m.arms[k].body, name, str_fresh)) { return true; } k = k + 1; } },
            ast.StmtDefer(d) => { if (strarr_local_stores_nonfresh([d.action], name, str_fresh)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// fn_returns_fresh_strarr: `fn` is a FREE function every return of which hands
// back a `string[]` whose buffer AND every element box this frame allocated —
// a direct element-fresh literal, or a local built from one and only ever
// self-appended to. The "STRARR:" registry's admission rule, named so the
// string[]-FIELD store gate can ask the same question the registry asks rather
// than keeping a second, narrower answer.
function fn_returns_fresh_strarr(fn: parser.FuncDecl, str_fresh: string[]): boolean {
    if (fn.receiver_type.len() > 0 || fn.ret_type != "string[]") { return false; }
    if (!body_has_return(fn.body)) { return false; }
    return !body_has_nonfresh_strarr_lit_return(fn.body, str_fresh)
        || body_returns_local_built_strarr(fn.body, str_fresh);
}

// body_returns_local_built_strarr: the accumulator idiom for a `string[]` —
// body_returns_local_built_arr plus the per-element freshness proof.
function body_returns_local_built_strarr(stmts: ast.Stmt[], str_fresh: string[]): boolean {
    if (!body_returns_local_built_arr(stmts)) { return false; }
    var names: string[] = arr_returned_ident_names(stmts, []);
    var i: i32 = 0;
    while (i < names.len()) {
        if (strarr_local_stores_nonfresh(stmts, names[i], str_fresh)) { return false; }
        i = i + 1;
    }
    return true;
}

// body_strfields_all_fresh: every return is a struct literal whose every
// `string`-typed DECL field is set from a fresh producer. Applied on top of the
// strict-fresh admission, this is what lets the field read MOVE the string out
// of the box: the box holds the value's only reference (a fresh field takes no
// construction alias-inc), so handing it to the destination and freeing the box
// is one owner in, one owner out.
function body_strfields_all_fresh(stmts: ast.Stmt[], structs: parser.StructDecl[], str_fresh: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprStructLit(slit) => {
                        var fi: i32 = 0;
                        while (fi < slit.field_names.len()) {
                            if (decl_field_type(structs, slit.type_name, slit.field_names[fi]) == "string"
                                    && !strarr_value_is_fresh(slit.field_values[fi], str_fresh)) { return false; }
                            fi = fi + 1;
                        }
                    },
                    _ => { return false; }
                }
            },
            ast.StmtIf(f) => { if (!body_strfields_all_fresh(f.then_body, structs, str_fresh) || !body_strfields_all_fresh(f.else_body, structs, str_fresh)) { return false; } },
            ast.StmtWhile(w) => { if (!body_strfields_all_fresh(w.body, structs, str_fresh)) { return false; } },
            ast.StmtFor(fo) => { if (!body_strfields_all_fresh(fo.body, structs, str_fresh)) { return false; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (!body_strfields_all_fresh(m.arms[a].body, structs, str_fresh)) { return false; } a = a + 1; } },
            _ => {}
        }
    }
    return true;
}

// decl_has_string_field: `sty` declares at least one `string` field.
function decl_has_string_field(structs: parser.StructDecl[], sty: string): boolean {
    var n: i32 = decl_field_count(structs, sty);
    var fi: i32 = 0;
    while (fi < n) {
        if (decl_field_type_at(structs, sty, fi) == "string") { return true; }
        fi = fi + 1;
    }
    return false;
}

// arr_fresh_ret_fns_of: NAMES of functions whose every return hands back a
// SCALAR-element array box THIS frame allocated — a direct array literal, or a
// local built from a literal and only ever self-appended to
// (body_returns_local_built_arr). That is the "ARR:" registry's own admission
// rule, lifted out so the strict-fresh struct walk can ask the same question
// about a field value's producer instead of re-deriving it.
//
// A METHOD is admitted under the "<Base>.<method>" key the struct entries of
// this registry already use, and a free function under its bare name. The two
// key spaces cannot collide (a method key contains a '.', an identifier cannot),
// which is what lets the struct walk keep asking bare-name questions of the same
// list and get its prior answers exactly.
//
// Methods were excluded until #7259, and the whole reclaim went with them: a
// method returning a fresh array had its result released by nobody, in every
// consumption form, at 40 B/round UNBOUNDED (4000 / 8000 / 16000 at 100 / 200 /
// 400 rounds, frees=0) where the identical free function is flat. The consumers
// were already method-aware — owned_fresh_call_callee resolves "<Base>.<method>"
// — so they were looking up a key this producer never wrote.
pub function arr_fresh_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    for fn in funcs {
        if (is_leaksafe_array_field(fn.ret_type)
                && body_has_return(fn.body)
                && (!body_has_nonfresh_arrlit_return(fn.body)
                    || body_returns_local_built_arr(fn.body))) {
            out = out.append(arr_fresh_ret_key(fn));
        }
    }
    return out;
}

// arr_fresh_ret_key: the registry key for `fn` — "<Base>.<method>" for a method,
// the bare name for a free function. The one place the two forms are spelled, so
// producer and consumer cannot drift.
pub function arr_fresh_ret_key(fn: parser.FuncDecl): string {
    if (fn.receiver_type.len() > 0) { return util.base_type_name(fn.receiver_type) + "." + fn.name; }
    return fn.name;
}

// --- owned-array-returning callees ("ARROWN:", #7259) -----------------------
//
// The general form of "ARR:", which asks the same question of a narrower body.
// The question is: does a call to this function leave THIS frame owning one
// reference to the result? Three return shapes say yes, by two mechanisms:
//
//   - `return h.xs` (an rc-array field of the receiver or a struct param) and
//     `return a` (a bare BORROWED array param) are RETAINED on the way out —
//     the return-transfer Perceus dup — so the caller holds a counted alias;
//   - `return [x, y]` MOVES a fresh reference out of the callee's frame.
//
// An `own` param returned bare is NOT admitted. It moves the caller's own
// reference back out, so the caller would hold two names for one reference and
// the release under-flows — measured on the `id(own a) { return a; }` shape,
// which the checker rejects at the call site but the self-host still lowers.
//
// A caller that BINDS the result pays the dec from the binding slot's exit
// sweep. A caller that consumes it in place — `h.get().len()`, `grab(h)[0]`,
// a discarded `h.get();` — has no slot, so nothing paid it and the rc ratcheted
// up once per call: 48 B/round on `i32[]`, unbounded, where native is flat at
// zero. These entries are what the in-place consumers release against.
//
// The release is the SHALLOW rc-guarded `__fern_rc_dec`. For a retained alias
// that is right at any element kind — the dup was on the buffer POINTER and the
// elements belong to whoever the callee borrowed from. For a moved LITERAL the
// elements come with it, so that shape is admitted only at a scalar element
// type, where shallow and complete are the same thing. That is also what
// separates this from "STRARR:", whose deep free needs a fresh buffer.

// arrown_ret_type: `t` is one of the four rc-array types the StmtReturn dup arms
// classify — scalar-element, array-of-struct, array-of-enum, `string[]`. A
// `T[][]` field is deliberately absent: no return arm claims it, so it reaches
// the generic move-on-return path with no dup to release.
function arrown_ret_type(structs: parser.StructDecl[], t: string): boolean {
    return is_leaksafe_array_field(t) || is_struct_array_field_type(structs, t)
        || is_enum_array_field_type(structs, t) || t == "string[]";
}

// arrown_obj_struct_type: the DECLARED struct type of `name` inside `fn` when it
// is the receiver or a struct-typed parameter, else "". Those are the two
// receivers whose `expr_struct_type` the lowering resolves from the signature
// alone, which is what keeps this AST-side answer and the lowering's agreeing.
function arrown_obj_struct_type(fn: parser.FuncDecl, name: string, structs: parser.StructDecl[]): string {
    if (fn.receiver_name.len() > 0 && fn.receiver_name == name) {
        var rty: string = util.base_type_name(fn.receiver_type);
        if (decl_is_struct(structs, rty)) { return rty; }
        return "";
    }
    var i: i32 = 0;
    while (i < fn.params.len()) {
        if (fn.params[i].name == name) {
            if (decl_is_struct(structs, fn.params[i].type_name)) { return fn.params[i].type_name; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// arrown_ret_value: `e` is a return value that leaves the caller owning one
// reference — the three shapes in the section comment. An array LITERAL moves
// rather than retains, so it carries its elements with it and is admitted only
// at a scalar element type.
function arrown_ret_value(e: ast.Expr, fn: parser.FuncDecl, structs: parser.StructDecl[], acc: string[]): boolean {
    match (e) {
        // A forwarding call to a free function already admitted: its result is
        // the caller's on every path, so it is this function's caller's too.
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(acc, "ARROWN:" + cid.name) >= 0; },
                _ => { return false; }
            }
        },
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    var oty: string = arrown_obj_struct_type(fn, oid.name, structs);
                    if (oty.len() == 0) { return false; }
                    return arrown_ret_type(structs, decl_field_type(structs, oty, fa.field));
                },
                _ => { return false; }
            }
        },
        ast.ExprIdent(id) => {
            var i: i32 = 0;
            while (i < fn.params.len()) {
                if (fn.params[i].name == id.name) {
                    if (fn.params[i].own) { return false; }
                    return arrown_ret_type(structs, fn.params[i].type_name);
                }
                i = i + 1;
            }
            return false;
        },
        ast.ExprArray(_) => { return is_leaksafe_array_field(fn.ret_type); },
        _ => { return false; }
    }
    return false;
}

// body_has_non_arrown_return: some return in `stmts` hands back something the
// caller does not own, so it cannot be told it owns one on every path.
function body_has_non_arrown_return(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: parser.StructDecl[], acc: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!arrown_ret_value(r.value, fn, structs, acc)) { return true; } },
            ast.StmtIf(f) => { if (body_has_non_arrown_return(f.then_body, fn, structs, acc) || body_has_non_arrown_return(f.else_body, fn, structs, acc)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_non_arrown_return(w.body, fn, structs, acc)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_non_arrown_return(fo.body, fn, structs, acc)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_non_arrown_return(m.arms[a].body, fn, structs, acc)) { return true; } a = a + 1; } },
            ast.StmtDefer(_) => {},
            _ => {}
        }
    }
    return false;
}

// fn_returns_owned_arr: EVERY return of `fn` leaves the caller owning one
// reference to the result. All-or-nothing — the consumers release
// unconditionally, so one path that hands back a borrow refuses the whole
// function.
pub function fn_returns_owned_arr(fn: parser.FuncDecl, structs: parser.StructDecl[], acc: string[]): boolean {
    return arrown_ret_type(structs, fn.ret_type)
        && body_has_return(fn.body)
        && !body_has_non_arrown_return(fn.body, fn, structs, acc);
}

// fresh_enum_ret_value: `e` is a return value of an enum-returning fn that the
// caller owns outright: a fresh variant ctor (the ctor's own payload counting
// is position-independent — a bare-ident array payload is dup'd, a literal is
// owned — so the box hands over sole-owned exactly like a ctor written at the
// use site), or a forwarding call to a free function already credited in `acc`.
function fresh_enum_ret_value(e: ast.Expr, structs: parser.StructDecl[], acc: string[]): boolean {
    if (variant_ctor_enum_owner(e, structs).len() > 0) { return true; }
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(acc, cid.name) >= 0; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// body_has_nonfreshenum_return: some return in `stmts` hands back an enum value
// the caller cannot be told it owns — anything but a fresh variant ctor or an
// admitted forwarding call. All-or-nothing, like the struct walk beneath.
function body_has_nonfreshenum_return(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!fresh_enum_ret_value(r.value, structs, acc)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonfreshenum_return(f.then_body, structs, acc) || body_has_nonfreshenum_return(f.else_body, structs, acc)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfreshenum_return(w.body, structs, acc)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfreshenum_return(fo.body, structs, acc)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfreshenum_return(m.arms[a].body, structs, acc)) { return true; } a = a + 1; } },
            ast.StmtDefer(_) => {},
            _ => {}
        }
    }
    return false;
}

// fresh_enum_fwd_fixpoint: the bare names of FREE functions whose every return
// is a fresh variant ctor or a forwarding call to another member — the "ENUM:"
// half of the strict-fresh registry, iterated like the struct fixpoint below so
// forwarding chains ground out; mutual recursion with no grounding stays
// uncredited (conservative).
function fresh_enum_fwd_fixpoint(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var pending: i32[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (funcs[k].receiver_type.len() == 0 && decl_is_enum(structs, funcs[k].ret_type)
                && body_has_return(funcs[k].body)) {
            pending = pending.append(k);
        }
        k = k + 1;
    }
    var acc: string[] = [];
    var round: i32 = 0;
    while (round < 8) {
        var still: i32[] = [];
        var added: boolean = false;
        var p: i32 = 0;
        while (p < pending.len()) {
            var fi: i32 = pending[p];
            if (!body_has_nonfreshenum_return(funcs[fi].body, structs, acc)) {
                acc = acc.append(funcs[fi].name);
                added = true;
            } else {
                still = still.append(fi);
            }
            p = p + 1;
        }
        pending = still;
        if (!added || pending.len() == 0) { return acc; }
        round = round + 1;
    }
    return acc;
}

// enum_fresh_ret_call: `e` is a call to a free function in the "ENUM:" half of
// the strict-fresh registry, so its result is an rc=1 variant box this caller
// owns outright.
pub function enum_fresh_ret_call(e: ast.Expr, reg: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(reg, "ENUM:" + cid.name) >= 0; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// fresh_struct_fwd_fixpoint: the bare NAMES of free functions whose every return
// is a strict-fresh struct — the set the forwarding arm of
// return_value_is_strictfresh_struct resolves a callee against. Iterated to a
// fixpoint so a chain of forwarding frames is admitted end to end; the round cap
// bounds the chain length rather than the call graph, and a longer one simply
// stays uncredited.
function fresh_struct_fwd_fixpoint(funcs: parser.FuncDecl[], structs: parser.StructDecl[], arr_fresh: string[], sfok: string[]): string[] {
    // Candidates are fixed by their signature, so the type tests are done once.
    var pending: i32[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        var rt: string = funcs[k].ret_type;
        if (funcs[k].receiver_type.len() == 0 && decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)
                && body_has_return(funcs[k].body)) {
            pending = pending.append(k);
        }
        k = k + 1;
    }
    // Later rounds re-walk only what is still UNCREDITED. The classifier is
    // monotone — a credited name never loses its entry when the set grows — so
    // re-asking about one that already qualified can only produce the same
    // answer, and the body walk is the expensive part of this pass.
    var acc: string[] = [];
    var round: i32 = 0;
    while (round < 8) {
        var still: i32[] = [];
        var added: boolean = false;
        var p: i32 = 0;
        while (p < pending.len()) {
            var fi: i32 = pending[p];
            if (!body_has_nonstrictfresh_return(funcs[fi].body, structs, funcs[fi].body, arr_fresh, acc, funcs[fi].params, sfok)) {
                acc = acc.append(funcs[fi].name);
                added = true;
            } else {
                still = still.append(fi);
            }
            p = p + 1;
        }
        pending = still;
        if (!added || pending.len() == 0) { return acc; }
        round = round + 1;
    }
    return acc;
}

pub function return_fresh_struct_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[], sfok: string[]): string[] {
    var out: string[] = [];
    // The whole-program str-fresh-ret registry, needed to prove a `string`
    // element / field value is this frame's own box. Computed once, and only
    // when some function can actually produce a pointer-bearing container —
    // the walk is linear in every body, so a module with no such producer must
    // not pay for it.
    var str_fresh: string[] = [];
    var pk: i32 = 0;
    var want_str_fresh: boolean = false;
    for fn in funcs {
        if (fn.ret_type == "string[]") { want_str_fresh = true; }
        else if (decl_is_struct(structs, fn.ret_type) && decl_has_string_field(structs, fn.ret_type)) { want_str_fresh = true; }
    }
    if (want_str_fresh) { str_fresh = str_fresh_ret_fns_of(funcs); }
    var arr_fresh: string[] = arr_fresh_ret_fns_of(funcs);
    // The string[] producers ride the same list under "SA:" so the strict-fresh
    // walk can ask about either element kind without a second parameter; every
    // other consumer of this list looks up a bare name, which the prefix cannot
    // match. Only walked when the string-fresh registry was worth computing.
    for fn in funcs {
        if (fn_returns_fresh_strarr(fn, str_fresh)) { arr_fresh = arr_fresh.append("SA:" + fn.name); }
    }
    // The bare-name half is a LEAST FIXPOINT, because a return may now forward
    // to another producer (`return mkp(a, b)`) and so depends on that one's
    // verdict. Starts empty and only ever adds — a use is credited on a literal
    // or on a callee already proven — so the iteration is monotone; a mutual
    // recursion with no grounding stays uncredited, the conservative direction.
    // Free functions only: the forwarding arm resolves a bare-ident callee, so a
    // method key could never be the thing it looks up.
    var fwd: string[] = fresh_struct_fwd_fixpoint(funcs, structs, arr_fresh, sfok);
    // "ENUM:<name>" — FREE functions whose every return is a fresh variant ctor
    // (or a forwarding call to another member). A call result from one is an
    // rc=1 variant box the caller owns outright, so the ExprStructLit enum arm
    // hands it over with no alias-inc, the same class as a ctor written at the
    // field position.
    var enum_fresh: string[] = fresh_enum_fwd_fixpoint(funcs, structs);
    var efi: i32 = 0;
    while (efi < enum_fresh.len()) {
        out = out.append("ENUM:" + enum_fresh[efi]);
        efi = efi + 1;
    }
    for fn in funcs {
        var rt: string = fn.ret_type;
        // A FREE function's verdict is exactly its membership in the fixpoint
        // above, which asked this question with the same arguments; only a
        // METHOD (never a forwarding-arm callee, so never in that set) still
        // needs the walk here.
        var strict_fresh_ret: boolean = decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt) && body_has_return(fn.body);
        if (strict_fresh_ret) {
            if (fn.receiver_type.len() == 0) { strict_fresh_ret = util.index_of_str(fwd, fn.name) >= 0; }
            else { strict_fresh_ret = !body_has_nonstrictfresh_return(fn.body, structs, fn.body, arr_fresh, fwd, fn.params, sfok); }
        }
        if (strict_fresh_ret) {
            var key: string = fn.name;
            if (fn.receiver_type.len() > 0) { key = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append(key);
        }
        // "ARR:<name>" entries (#4365): FREE functions returning a SCALAR-element
        // array box this frame allocated. Rides this registry (prefix-multiplexed, the reclaimable_
        // names convention) so the discarded-call reclaim in lower_stmt reads it
        // off LowerState with no new threading; every other consumer looks up bare
        // names / "<Base>.<method>" keys, which an "ARR:"-prefixed entry can never
        // match. Consumed by the discarded `mk(i);` statement reclaim and by the
        // `mk()[i]` read reclaim (#6491) — both the caller-side shallow
        // __fern_rc_dec of the returned rc=1 buffer (native's
        // ownedCallResultType arc; the box is fresh-by-construction in return
        // position, so the dec is balanced and element-blind).
        //
        // Which functions qualify is arr_fresh_ret_fns_of's question, asked once
        // above so the strict-fresh struct walk can ask the same one.
        var arrkey: string = arr_fresh_ret_key(fn);
        if (util.index_of_str(arr_fresh, arrkey) >= 0) {
            out = out.append("ARR:" + arrkey);
        }
        // "ARROWN:<key>" — the general sibling of "ARR:" (#7259): every return
        // leaves the caller owning one reference, whether the callee retained a
        // borrowed buffer or moved a fresh one out. Consumed by the same
        // in-place release sites; the two overlap where a body is all fresh
        // literals, and both spell the same shallow dec there.
        if (fn_returns_owned_arr(fn, structs, out)) {
            out = out.append("ARROWN:" + arrkey);
        }
        // "STRARR:<name>" — the POINTER-element sibling of "ARR:" (#6491): a FREE
        // function returning a `string[]` every element of which this frame
        // allocated. The read reclaim retains the extracted element and then
        // DEEP-frees the container (__fern_str_arr_free), so the other elements
        // and the buffer go back and the extracted one arrives at the destination
        // holding its own single reference. "ARR:" cannot carry this: its
        // consumers release the buffer element-blind, which for a string[] would
        // strand every element it did not extract.
        if (fn_returns_fresh_strarr(fn, str_fresh)) {
            out = out.append("STRARR:" + fn.name);
        }
        // "ARRTUPF:<name>" / "ARRSTRUCTF:<name>" — the array-of-BOXES producers
        // (#4353): a FREE function whose every return is a fresh array literal of
        // fresh tuple (resp. struct) literals. A binding from one earns the same
        // ARRTUP: / ARRSTRUCT: credit an array literal earns, so the caller's
        // deep free reaches every element box; the callee's returned value
        // escapes its own frame and keeps the shallow dec.
        if (fn_returns_fresh_arrtup(fn, structs, str_fresh)) {
            out = out.append("ARRTUPF:" + fn.name);
        }
        if (fn_returns_fresh_arrstruct(fn, structs)) {
            out = out.append("ARRSTRUCTF:" + fn.name);
        }
        // "STRUCTARRF:<name>" — the same for the SCALAR-FIELD struct arrays the
        // row above does not claim (#7445). It was the one element kind whose
        // producer had no registry: a `var v: P[] = mk()` binding earned no
        // credit at all, so its exit sweep took the generic shallow buffer dec
        // and stranded every element box — 160 B per round, unbounded, where the
        // byte-identical literal init was flat.
        if (fn_returns_fresh_structarr(fn, structs)) {
            out = out.append("STRUCTARRF:" + fn.name);
        }
        // "ARENUMF:<name>|<Enum>" — the array-of-ENUM sibling of the rows above.
        // The enum rides the row because an `E[]` slot records its element type
        // nowhere, the same reason the "ARRENUM:" credit carries it.
        var aef: string = arrenum_producer_enum(fn, structs);
        if (aef.len() > 0) {
            out = out.append("ARENUMF:" + fn.name + "|" + aef);
        }
        // "STRFLDF:<name>" / "STRFLDF:<Base>.<method>" — the field-read half: a
        // strict-fresh struct producer whose every `string` field is fresh, and
        // whose return type carries no rc-ARRAY field (so the read's release is
        // the bare box dec, with no __struct_drop_<T> to also touch the field
        // being moved out). The read then MOVES the string: no retain, no field
        // dec, one owner in and one owner out. Every OTHER string field of the
        // box leaks with it — the established safe floor, never an over-release.
        //
        // A METHOD earns the entry on the same terms. The receiver is not a
        // special case for it: every return being a strict-fresh LITERAL
        // already refuses `return b`, and body_strfields_all_fresh refuses a
        // literal built out of `b.tag` — the two shapes in which the result
        // could carry the receiver's own box.
        if (decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)
                && decl_has_string_field(structs, rt) && !struct_has_reclaim_array_field(structs, rt)
                && strict_fresh_ret
                && body_strfields_all_fresh(fn.body, structs, str_fresh)) {
            var skey: string = fn.name;
            if (fn.receiver_type.len() > 0) { skey = util.base_type_name(fn.receiver_type) + "." + fn.name; }
            out = out.append("STRFLDF:" + skey);
        }
        // "FRESHSELF:<Base>.<method>" — the MIXED-path producer: SOME return hands
        // back the receiver and every other is a strict-fresh struct literal. The
        // bare-receiver return is required, not merely allowed: an all-fresh body
        // is what the plain entry above already admits, with no runtime compare to
        // pay for, and a second entry for it would only lengthen a registry every
        // call site scans (#6911 §4d.4). Neither
        // the bare entry nor "STRFLDF:" can hold it (both demand every path be
        // fresh), and refusing it strands the fresh path's box at every call —
        // the shape `if (t.len() == 0) { return b; }` gives every builder-ish
        // method. The caller releases under a pointer compare against the
        // receiver, so the identity path costs nothing and the fresh path is
        // freed; the release is the BARE box dec, since a fresh literal's field
        // values are not proven owned here (`Box { tag: t, … }` takes a
        // parameter's box) and only the box itself is provably this frame's.
        if (fn.receiver_type.len() > 0 && decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)
                && body_has_return(fn.body)
                && body_returns_bare_ident(fn.body, fn.receiver_name)
                && body_returns_fresh_or_self_struct(fn.body, structs, fn.body, fn.receiver_name, arr_fresh, fwd, fn.params, sfok)) {
            out = out.append("FRESHSELF:" + util.base_type_name(fn.receiver_type) + "." + fn.name);
        }
    }
    return out;
}

// is_fresh_ret_binding: `init` is a call/method whose callee is fresh-returning.
// For a method `obj.m(..)` the receiver type is approximated by the binding's
// declared type `recv_type` (the var annotation) — sound because for a builder
// method receiver type == return type == the local's type; a mismatch just fails
// to find the key (conservative, no admission).
// str_method_ret_is_fresh: `<expr>.m()` where every declaration of `m` in the
// program returns a freshly allocated string ("SFRFRESHNAME:", which is also
// what makes the untyped receiver safe here). is_fresh_ret_binding covers the
// free-call spelling of the same fact; its method arm needs a receiver type this
// caller has no way to compute, so a source-declared method result went
// uncredited while the BUILTIN spelling beside it was reclaimed —
// `var t = b.to_owned()` leaked 47 B/round where `var t = b.to_ascii_upper()`
// was flat.
function str_method_ret_is_fresh(e: ast.Expr, fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => { return util.index_of_str(fresh_ret, "SFRFRESHNAME:" + fa.field) >= 0; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// tostring_on_fresh_ret: `<fresh-string-producing call>.to_string()`.
//
// `.to_string()` on a STRING receiver is the receiver-identity fast-path, which
// is why str_local_binding_is_fresh excludes it: the result is the receiver, so
// freeing it would release a box the source still owns. That reasoning holds for
// a NAMED receiver and inverts for an anonymous one — when the receiver is a call
// the whole-program proof says returns a fresh sole-owned box, the identity
// result IS that box, this frame is the only thing holding it, and NOT freeing it
// is the leak.
//
// This is the shape `f"{f(x)}"` desugars to. parser.fern turns every interpolant
// into `(<expr>).to_string()`, so an interpolated call stranded its box while the
// same call written as an explicit concat operand did not.
function tostring_on_fresh_ret(e: ast.Expr, fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "to_string") { return false; }
                    return is_fresh_ret_binding(fa.obj, "", fresh_ret)
                        || str_method_ret_is_fresh(fa.obj, fresh_ret);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function is_fresh_ret_binding(e: ast.Expr, recv_type: string, fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(fresh_ret, cid.name) >= 0; },
                ast.ExprFieldAccess(fa) => {
                    if (recv_type.len() == 0) { return false; }
                    return util.index_of_str(fresh_ret, recv_type + "." + fa.field) >= 0;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}
// snapshot_local_names_of: the struct LOCALS that are threaded (reassigned) and
// only-safe-uses-plus-return — the local analogue of snapshot_param_slots_of.
// Three bindings qualify (collect_snap_locals): a fresh-ret call, which earns
// the struct credit; the alias `var q: T = p`; and a call derived from a
// same-typed variable. Each row is the binding-site key, and a "SNAPSRC:<site>|
// <name>" row names the variable whose box seed_snapshot_local copies as the
// rebind release's snapshot; the moved-out final is kept by struct
// move-on-return.
function snapshot_local_names_of(fn: parser.FuncDecl, structs: parser.StructDecl[], borrowable: string[], fresh_ret: string[], consume_safe: string[], ret_fresh: string[]): string[] {
    var reassigned: string[] = body_assign_targets(fn.body);
    return collect_snap_locals(fn.body, fn, structs, borrowable, fresh_ret, consume_safe, reassigned, ret_fresh, []);
}
function collect_snap_locals(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: parser.StructDecl[], borrowable: string[], fresh_ret: string[], consume_safe: string[], reassigned: string[], ret_fresh: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                // Order the predicates cheapest + most-selective first: the
                // annotation, the (small-list) reassigned scan and the
                // fresh-ret-call test reject almost every var WITHOUT touching the
                // allocating field walk (struct_has_reclaim_array_field) or the
                // O(body) borrow check — keeping this per-function pass affordable
                // on the large modules (the native-emit heap is at its limit, #3452).
                var snap_init_ok: boolean = is_fresh_ret_binding(v.init, v.type_name, fresh_ret);
                // A strict-fresh LITERAL init rides the same rebind reclaim when
                // this function's own bare row in the strict-fresh registry
                // proves the whole rebuild-and-return shape: the row exists only
                // if every return is strict-fresh, and a `return <name>` return
                // required this local's init and every assignment to be
                // strict-fresh with no second reference taken. Without this arm
                // the superseded literal leaked at every rebind — the callee
                // half of #7357's producer decomposition, 112 B per call.
                if (!snap_init_ok && v.type_name.len() > 0
                    && util.index_of_str(ret_fresh, fn.name) >= 0
                    && body_returns_bare_name(fn.body, v.name)) {
                    match (v.init) {
                        ast.ExprStructLit(snsl) => { if (snsl.type_name == v.type_name && !snsl.has_base) { snap_init_ok = true; } },
                        _ => {}
                    }
                }
                // The variable the binding is DERIVED from (snapshot_source_of_init):
                // the alias `var q: T = p` names p; a fresh-ret init names its
                // receiver or the one same-typed argument whose fields the result
                // carries. seed_snapshot_local copies that box right after the
                // binding, and every rebind's field release is guarded against it,
                // so a field the superseded box still shares with the source is
                // left alone. Without the guard `var st = se.add_local(1);
                // st = st.emit(2)` released se.ops, the CALLER's buffer, at the
                // first rebind. "!" — a computed receiver, two candidate sources —
                // refuses the credit outright.
                //
                // The alias earns no struct credit of its own: its final box may
                // still be p's, which no sweep may touch. Its rebinds alone reclaim.
                var src: string = snapshot_source_of_init(v, fn);
                var alias_init: boolean = src.len() > 0 && src == ident_name_or_empty(v.init);
                // The call-derived local, `var q: T = g(.., p, ..)` / `var q: T =
                // p.m(…)` from a producer that is NOT fresh-ret (it may hand p's
                // own box back): the snapshot of p's box guards exactly that case,
                // and a derived box is q's alone, so it joins the alias in
                // reclaiming by its rebinds only. p's position has to be
                // consume-safe, so the callee kept no second reference.
                var call_alias: boolean = !snap_init_ok && !alias_init && src.len() > 0 && src != "!"
                    && init_derives_from(v.init, src, borrowable, consume_safe);
                var rebinds_only: boolean = alias_init || call_alias;
                // A local never rebound still has a generation to release when
                // its last use binds another local over it (last_use_consumer_in).
                var lu: string = "";
                if (v.type_name.len() > 0 && (snap_init_ok || rebinds_only) && src != "!" && decl_is_struct(structs, v.type_name)) {
                    lu = last_use_consumer_in(stmts, v.name, v.type_name, borrowable, consume_safe);
                }
                if (v.type_name.len() > 0
                    && (util.index_of_str(reassigned, v.name) >= 0 || lu.len() > 0)
                    && (snap_init_ok || rebinds_only)
                    && src != "!"
                    && decl_is_struct(structs, v.type_name) && decl_is_leaksafe(structs, v.type_name)
                    && (rebinds_only || struct_has_reclaim_array_field(structs, v.type_name))
                    && !body_consume_unsafe_for(fn.body, v.name, borrowable, consume_safe, [], true)) {
                    var key: string = reclaim_site_key_of(v.name, v.line, v.col);
                    if (!rebinds_only) { a = push_str_unique(a, key); }
                    if (src.len() > 0) { a = push_str_unique(a, "SNAPSRC:" + key + "|" + src); }
                    if (lu.len() > 0) { a = push_str_unique(a, "LASTUSE:" + lu + "|" + v.name); }
                }
            },
            ast.StmtIf(f) => { a = collect_snap_locals(f.then_body, fn, structs, borrowable, fresh_ret, consume_safe, reassigned, ret_fresh, a); a = collect_snap_locals(f.else_body, fn, structs, borrowable, fresh_ret, consume_safe, reassigned, ret_fresh, a); },
            ast.StmtWhile(w) => { a = collect_snap_locals(w.body, fn, structs, borrowable, fresh_ret, consume_safe, reassigned, ret_fresh, a); },
            ast.StmtFor(fo) => { a = collect_snap_locals(fo.body, fn, structs, borrowable, fresh_ret, consume_safe, reassigned, ret_fresh, a); },
            ast.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = collect_snap_locals(m.arms[ai].body, fn, structs, borrowable, fresh_ret, consume_safe, reassigned, ret_fresh, a); ai = ai + 1; } },
            _ => {}
        }
    }
    return a;
}

// body_returns_bare_name: some `return <name>;` occurs in the subtree — the
// read the snapshot-local literal arm keys on, since the strict-fresh registry
// row only vouches for locals a bare return actually hands out.
function body_returns_bare_name(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                match (r.value) {
                    ast.ExprIdent(rid) => { if (rid.name == name) { return true; } },
                    _ => {}
                }
            },
            ast.StmtIf(f) => { if (body_returns_bare_name(f.then_body, name) || body_returns_bare_name(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (body_returns_bare_name(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (body_returns_bare_name(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (body_returns_bare_name(arm.body, name)) { return true; }
                }
            },
            _ => {}
        }
    }
    return false;
}

// --- consumed scalar-payload enum scrutinee free (Perceus) -------------------
//
// The simplest SOUND enum-box reclamation: a function-local `var x = V(args...)`
// of an enum ALL of whose variants carry ONLY scalar payloads (no array/string/
// struct/nested/option/tuple/map field → the box needs NO per-variant deep-drop)
// that is CONSUMED by exactly one `match (x) { ... }` where x is single-owner and
// DEAD after the match. The match reads the scalar payloads as BORROWS (struct_get
// copies them into their own slots) BEFORE the bodies run, and never decs the box,
// so after the match statement the box is the sole reference in x's slot and can be
// freed: dec + zero the slot (mirrors the array precise-drop), SOUND now that
// op_struct_make gives the box an rc header. Anything not provably this shape is
// left to leak (sound). Conservative + deterministic — a mis-classified free is a
// use-after-free that breaks the byte-identical fixpoint.

// enum_variant_scalar_payload: every payload field of variant struct `vname` is a
// flat scalar (i32/boolean/i64/f64/u32/u64). A no-payload (0-field) variant
// trivially qualifies. The shape-ptr is at slot 0; payload fields are __ev, __ev1…
function enum_variant_scalar_payload(structs: parser.StructDecl[], vname: string): boolean {
    var n: i32 = decl_field_count(structs, vname);
    var fi: i32 = 0;
    while (fi < n) {
        if (!reuse_field_is_scalar(decl_field_type_at(structs, vname, fi))) { return false; }
        fi = fi + 1;
    }
    return true;
}

// enum_variant_reuse_payload_ok: every payload field of variant `vname` is either a
// flat scalar (reuse_field_is_scalar — no rc, copied/reused with the box) or a
// leak-safe scalar array (is_leaksafe_array_field — i32[]/i64[]/f64[]/boolean[],
// a single rc-headered box released by one __fern_rc_dec). String / nested-struct /
// struct-array / map / option / tuple payloads bail. The widened in-arm match-reuse
// admits these payloads: scalar fields ride the existing struct_get/struct_set
// path, array fields are written via a cow-guarded drop (mirroring emit_arr_store /
// emit_cross_struct_reuse) so an old donor array is released on replace and reused
// in place on a same-slot move.
function enum_variant_reuse_payload_ok(structs: parser.StructDecl[], vname: string): boolean {
    var n: i32 = decl_field_count(structs, vname);
    var fi: i32 = 0;
    while (fi < n) {
        var t: string = decl_field_type_at(structs, vname, fi);
        if (!reuse_field_is_scalar(t) && !is_leaksafe_array_field(t)) { return false; }
        fi = fi + 1;
    }
    return true;
}

// enum_all_variants_reuse_ok: every variant of enum `enum_name` has only
// scalar-or-leak-safe-array payloads (enum_variant_reuse_payload_ok). False if the
// enum has no variants. The widened donor-init gate for in-arm match reuse.
function enum_all_variants_reuse_ok(structs: parser.StructDecl[], enum_name: string): boolean {
    var any: boolean = false;
    for sd in structs {
        if (sd.enum_owner == enum_name) {
            any = true;
            if (!enum_variant_reuse_payload_ok(structs, sd.name)) { return false; }
        }
    }
    return any;
}

// fresh_reuse_enum_init: like fresh_scalar_enum_init but admits a donor enum whose
// variants carry scalar-or-leak-safe-array payloads (enum_all_variants_reuse_ok).
// Returns the enum's name, or "". Used only by the in-arm match-reuse analysis,
// which separately verifies the donor's array payload args are fresh array literals
// (so the box solely owns each donor array — the cow-guard dec can't double-free).
function fresh_reuse_enum_init(e: ast.Expr, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    var owner: string = variant_enum_owner(structs, id.name);
                    if (owner != "" && enum_all_variants_reuse_ok(structs, owner)) { return owner; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        ast.ExprIdent(id) => {
            var owner2: string = variant_enum_owner(structs, id.name);
            if (owner2 != "" && enum_all_variants_reuse_ok(structs, owner2)) { return owner2; }
            return "";
        },
        _ => { return ""; }
    }
}

// inarm_donor_arrays_are_fresh: x's init `var x = V(args)` has every leak-safe-array
// payload arg a FRESH array literal (ExprArray) — so the donor box is the sole owner
// of each such array and the cow-guard dec at reuse can't double-free a value still
// aliased elsewhere. Scalar args are unconstrained. Returns true also for a unit
// variant (no args). Mirrors the okv check in enum_donor_reuse_sites / cross_reuse.
function inarm_donor_arrays_are_fresh(body: ast.Stmt[], structs: parser.StructDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprCall(c) => {
                            var vn: string = "";
                            match (c.callee) {
                                ast.ExprIdent(id) => { vn = id.name; },
                                _ => { return false; }
                            }
                            var ai: i32 = 0;
                            while (ai < c.args.len()) {
                                if (is_leaksafe_array_field(decl_field_type_at(structs, vn, ai))) {
                                    match (c.args[ai]) {
                                        ast.ExprArray(_) => {},
                                        _ => { return false; }
                                    }
                                }
                                ai = ai + 1;
                            }
                            return true;
                        },
                        ast.ExprIdent(_) => { return true; },
                        _ => { return false; }
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// enum_all_variants_scalar: every variant of enum `enum_name` (every struct whose
// enum_owner == enum_name) has only scalar payloads. False if the enum has no
// variants (defensive — never a free candidate then).
function enum_all_variants_scalar(structs: parser.StructDecl[], enum_name: string): boolean {
    var any: boolean = false;
    for sd in structs {
        if (sd.enum_owner == enum_name) {
            any = true;
            if (!enum_variant_scalar_payload(structs, sd.name)) { return false; }
        }
    }
    return any;
}

// fresh_scalar_enum_init: `e` is a sole-owner construction of an all-scalar enum —
// a call `V(args...)` whose callee V is a variant ctor of such an enum, OR a bare
// unit variant `V` (an ExprIdent resolving to a 0-field variant struct). Returns
// the enum's name, or "" if not.
function fresh_scalar_enum_init(e: ast.Expr, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    var owner: string = variant_enum_owner(structs, id.name);
                    if (owner != "" && enum_all_variants_scalar(structs, owner)) { return owner; }
                    return "";
                },
                // Qualified ctor `Enum.Variant(args...)` — resolve by field name.
                ast.ExprFieldAccess(fa) => {
                    var ownerq: string = variant_enum_owner(structs, fa.field);
                    if (ownerq != "" && enum_all_variants_scalar(structs, ownerq)) { return ownerq; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        ast.ExprIdent(id) => {
            var owner2: string = variant_enum_owner(structs, id.name);
            if (owner2 != "" && enum_all_variants_scalar(structs, owner2)) { return owner2; }
            return "";
        },
        // Qualified bare UNIT variant `Enum.Variant` (no call).
        ast.ExprFieldAccess(fa) => {
            var owner3: string = variant_enum_owner(structs, fa.field);
            if (owner3 != "" && enum_all_variants_scalar(structs, owner3)) { return owner3; }
            return "";
        },
        _ => { return ""; }
    }
}

// is_scalar_type_name reports whether `t` names a flat scalar type
// (i32 / i64 / f64 / boolean / u32 / u64) — a value that is COPIED, not
// rc-tracked, so a shallow box free needs no element walk and never entangles a
// bound payload's lifetime.
function is_scalar_type_name(t: string): boolean {
    return t == "i32" || t == "i64" || t == "f64" || t == "boolean" || t == "u32" || t == "u64";
}

// type_is_scalar_option reports whether a type annotation is `Option[<scalar>]`.
function type_is_scalar_option(tn: string): boolean {
    if (tn.len() < 9) { return false; }
    if (slice_unchecked(tn, 0, 7) != "Option[") { return false; }
    return is_scalar_type_name(slice_unchecked(tn, 7, tn.len() - 1));
}

// type_is_scalar_union widens that to any tagged union whose payload is a
// by-value scalar in EVERY arm: `Option[<scalar>]`, or `Result[<scalar>,
// <scalar>]`. Such a box owns no pointer at all, so ONE __fern_rc_dec is its
// complete release whichever variant it happens to hold — which is what lets a
// nested one ride the plain payload dec.
//
// Result needs BOTH arms proved. The drop runs after the match and does not read
// the tag, so an Err arm carrying a pointer would be stranded by the very same
// dec that fully releases a scalar one.
function type_is_scalar_union(tn: string): boolean {
    if (type_is_scalar_option(tn)) { return true; }
    if (tn.len() < 10 || slice_unchecked(tn, 0, 7) != "Result[") { return false; }
    return is_scalar_type_name(opt_payload_type(tn, "Ok"))
        && is_scalar_type_name(opt_payload_type(tn, "Err"));
}

// fresh_scalar_option_init reports whether `v` binds a FRESH scalar Option OR
// Result local — `var o = None`, `var o = Some(p)`, `var r = Ok(p)`, or
// `var r = Err(p)` whose constructed-variant payload is provably scalar (the
// binding annotates `Option[<scalar>]` / `Result[<scalar>, _]` (Ok) /
// `Result[_, <scalar>]` (Err), or the payload is a bare number/boolean literal).
// Some/Ok/Err all share the rc-headered opt_make box (→ __fern_arr_box) and None
// the opt_none box, so the local is a single-owner box holding no rc pointer and a
// shallow __fern_rc_dec is the whole free — the Option/Result sibling of
// fresh_scalar_enum_init. The constructor tags are matched both bare and qualified
// (`Option.Some(..)` / `Result.Ok(..)`). Only the CONSTRUCTED variant's payload
// scalar-ness matters (a `var r = Ok(x)` box always holds Ok's payload; Err's
// annotated type is irrelevant to this box). An rc-payload construction
// (Some([..]) / Ok("x") / Err(struct)) is NOT admitted here (its payload would
// leak — a deep-drop follow-up), and neither is a non-literal un-annotated payload
// (the scalar-ness can't be proven without types in this classifier).
function fresh_scalar_option_init(v: ast.StmtVar): boolean {
    var kind: string = "";
    match (v.init) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    if (id.name == "Some" || id.name == "Ok" || id.name == "Err") { kind = id.name; }
                },
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "Some" || fa.field == "Ok" || fa.field == "Err") { kind = fa.field; }
                },
                _ => {}
            }
        },
        ast.ExprIdent(id) => { if (id.name == "None") { kind = "None"; } },
        ast.ExprFieldAccess(fa) => { if (fa.field == "None") { kind = "None"; } },
        _ => {}
    }
    if (kind == "") { return false; }
    if (kind == "None") { return true; }   // no payload — trivially scalar
    // Annotated: prove the CONSTRUCTED variant's payload is scalar. For Option this
    // is Option[<scalar>]; for Result Ok reads T, Err reads E (opt_payload_type
    // parses both, variant-aware).
    if (is_scalar_type_name(opt_payload_type(v.type_name, kind))) { return true; }
    // Un-annotated: admit only a bare scalar-literal payload (`Some(5)`/`Ok(true)`).
    match (v.init) {
        ast.ExprCall(c) => {
            if (c.args.len() == 1) {
                match (c.args[0]) {
                    ast.ExprNumber(_) => { return true; },
                    ast.ExprBool(_) => { return true; },
                    _ => { return false; }
                }
            }
        },
        _ => {}
    }
    return false;
}

// fresh_scalar_option_call_init: `var v: Option[i32] = mk(i)`, where the
// OPTFRESH registry (opt_fresh_ret_fns_of) proved every return of `mk` is a
// direct constructor, so the box is fresh and sole-owned exactly as an inline
// ctor would be.
//
// Checks the SUCCESS payload only. The free is one __fern_rc_dec on the box and
// never reads offset 8, so a non-scalar Err strands its payload rather than
// dangling it — and refusing the binding would strand the box too.
//
// A non-scalar success payload stays refused: its common path would strand a
// buffer, which needs the runtime variant a deep drop dispatches on (#6360).
function fresh_scalar_option_call_init(v: ast.StmtVar, opt_fresh_reg: SigReg): boolean {
    var callee: string = "";
    match (v.init) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => { callee = id.name; },
                _ => {}
            }
        },
        _ => {}
    }
    if (callee == "") { return false; }
    if (!sig_reg_has_name(opt_fresh_reg, callee)) { return false; }
    // Annotation-only: the payload spelling is what proves scalar-ness, and an
    // un-annotated call init has none to read (the direct sibling can fall back
    // on a bare literal argument; there is no such fallback through a call).
    var ann: string = v.type_name;
    var n: i32 = ann.len();
    if (n >= 8 && slice_unchecked(ann, 0, 7) == "Option[") {
        // None carries no payload, so the success payload is the only one.
        return is_scalar_type_name(opt_payload_type(ann, "Ok"));
    }
    if (n >= 8 && slice_unchecked(ann, 0, 7) == "Result[") {
        // Err is deliberately unconstrained — see the header. A non-scalar Err
        // strands its payload on the Err path only, which is what already
        // happened, and the box is reclaimed on every path either way.
        return is_scalar_type_name(opt_payload_type(ann, "Ok"));
    }
    return false;
}

// optfresh_entry_payload_is_fresh: does a raw registry row ("name|ptype|flag")
// carry the "f" flag — every success payload a static literal or a fresh string
// producer? Tagged rows ("RCE:" / "AAC:") have no flag field and are refused.
function optfresh_entry_payload_is_fresh(e: string): boolean {
    if (e.len() > 4 && (bytes_at(e, 0, "RCE:") || bytes_at(e, 0, "AAC:"))) { return false; }
    if (e.len() > 9 && bytes_at(e, 0, "ERRFRESH:")) { return false; }
    var i: i32 = e.len() - 2;
    if (i < 0) { return false; }
    return e[i] == b'|' && slice_unchecked(e, i + 1, e.len()) == "f";
}

// match_scrutinee_ident: if top-level body statement `st` is a `match (x) { ... }`
// whose scrutinee is the bare ident `name`, returns true.
function match_scrutinee_is(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            match (m.scrutinee) {
                ast.ExprIdent(id) => { return id.name == name; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// body_has_top_level_match reports whether any TOP-LEVEL statement of `stmts`
// is a match whose scrutinee is the bare ident `name`.
//
// A `var` whose body has one is NOT a precise-drop candidate: the consuming
// match owns its reclamation (consumed_scalar_option_frees and its rc-payload /
// enum siblings), so admitting it here too would free the box twice. Every
// precise-drop candidate kind below asks this same question, which is why it is
// one function rather than the four copies it used to be.
function body_has_top_level_match(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        if (match_scrutinee_is(stmt, name)) { return true; }
    }
    return false;
}

// sole_top_level_match_idx returns the index of the ONLY top-level match on
// `name`, or -1 when there is none or more than one. The consuming-match
// reclamation paths need the unique site, not merely its existence.
// name_is_match_scrutinee: some match in `stmts` (any nesting) scrutinises the
// bare local `name`. The plan-routed "unmatched" Option families keep this as
// an explicit conjunct: body_unsafe_for refused EVERY bare mention, so the
// match-refusal was implicit there; the plan verdict does not model the
// consuming-match release channel, and granting a matched local would put a
// second claim on the payload the match machinery may free.
function name_is_match_scrutinee(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                match (m.scrutinee) {
                    ast.ExprIdent(id) => { if (id.name == name) { return true; } },
                    _ => {}
                }
                for arm in m.arms { if (name_is_match_scrutinee(arm.body, name)) { return true; } }
            },
            ast.StmtIf(f) => { if (name_is_match_scrutinee(f.then_body, name) || name_is_match_scrutinee(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (name_is_match_scrutinee(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (name_is_match_scrutinee(fo.body, name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// name_is_alias_bound: some `var other = name` bare-ident bind (any nesting)
// aliases the local `name`. The plan's fixpoint deliberately forgives a
// bare-ident alias whose own binding is untainted (#7282's arithmetic — the
// alias bind RETAINS for the arr/str/struct/tuple kinds), but the Option
// families have no alias-bind retain, so an aliased source must not carry
// their deep credit: the plan-routed gates keep this as an explicit conjunct
// (the optaarr_collide suite measures the over-release otherwise).
function name_is_alias_bound(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprIdent(id) => { if (id.name == name) { return true; } },
                    _ => {}
                }
            },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (name_is_alias_bound(arm.body, name)) { return true; } }
            },
            ast.StmtIf(f) => { if (name_is_alias_bound(f.then_body, name) || name_is_alias_bound(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (name_is_alias_bound(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (name_is_alias_bound(fo.body, name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

function sole_top_level_match_idx(stmts: ast.Stmt[], name: string): i32 {
    var idx: i32 = 0 - 1;
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        if (match_scrutinee_is(stmts[i], name)) { idx = i; n = n + 1; }
        i = i + 1;
    }
    if (n == 1) { return idx; }
    return 0 - 1;
}

// body_mentions_name: does `name` appear anywhere in `stmts`, at any depth?
function body_mentions_name(stmts: ast.Stmt[], name: string): boolean {
    var seen: string[] = [];
    for stmt in stmts { seen = astwalk.collect_idents_stmt(stmt, seen); }
    return util.index_of_str(seen, name) >= 0;
}

// sole_match_only_use_of: the one top-level `match (name)` in `stmts`, as a
// 0-or-1 element array, and only when no OTHER statement in `stmts` mentions
// `name` at all.
function sole_match_only_use_of(stmts: ast.Stmt[], name: string): ast.Stmt[] {
    var at: i32 = 0 - 1;
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        if (match_scrutinee_is(stmts[i], name)) { at = i; n = n + 1; }
        i = i + 1;
    }
    if (n != 1) { return []; }
    var j: i32 = 0;
    while (j < stmts.len()) {
        if (j != at) {
            var seen: string[] = [];
            seen = astwalk.collect_idents_stmt(stmts[j], seen);
            if (util.index_of_str(seen, name) >= 0) { return []; }
        }
        j = j + 1;
    }
    return [stmts[at]];
}

// consuming_match_of: the `match (name)` that statement `st` is, or contains one
// block deeper — inside an `if` branch or a `while` body (#6319). Returned as a
// 0-or-1 element array so a miss needs no invented Stmt: handing back `st` would
// make the arm analyses read an `if`, and both answer "no escape" for a
// statement they cannot parse, which reads as a proof when it is a blind spot.
//
// A nested match is admitted only when the scrutinee is `name`'s ONLY mention
// inside `st`. The caller places the free after the whole of `st` and skips the
// whole of `st` in its escape check, so a second mention — in the `if` cond, the
// sibling branch, or a later statement of the same branch — is invisible to it.
function consuming_match_of(st: ast.Stmt, name: string): ast.Stmt[] {
    if (match_scrutinee_is(st, name)) { return [st]; }
    match (st) {
        ast.StmtIf(f) => {
            var cs: string[] = [];
            cs = astwalk.collect_idents_expr(f.cond, cs);
            if (util.index_of_str(cs, name) >= 0) { return []; }
            var a: ast.Stmt[] = sole_match_only_use_of(f.then_body, name);
            if (a.len() == 1 && !body_mentions_name(f.else_body, name)) { return a; }
            var b: ast.Stmt[] = sole_match_only_use_of(f.else_body, name);
            if (b.len() == 1 && !body_mentions_name(f.then_body, name)) { return b; }
            return [];
        },
        ast.StmtWhile(w) => {
            var ws: string[] = [];
            ws = astwalk.collect_idents_expr(w.cond, ws);
            if (util.index_of_str(ws, name) >= 0) { return []; }
            return sole_match_only_use_of(w.body, name);
        },
        // `return (match (name) { .. })` — a match EXPRESSION, which the parser
        // desugars to a zero-arg IIFE. lower_iife lowers that INLINE
        // (lower_value_stmt for the single-statement body the match desugar
        // produces), so `name` is read in THIS frame and the return-path sweep
        // already runs after the value is computed: the free needs no new
        // placement, only this arm to see the match at all.
        //
        // Returned as the inner StmtMatch, like the two arms above, so the arm
        // analyses read the match rather than the return — the blind spot this
        // function's header warns about, and the reason a version that handed back
        // the RETURN left a box per round unreleased.
        ast.StmtReturn(r) => {
            // `name` must appear ONCE in the whole returned expression, and the
            // match below accounts for it. The IIFE is often only part of the
            // value — `return (match (o) { .. }) + p.xs[0]` is an ExprBinary — so
            // the search descends, and without this count a second mention in a
            // sibling operand (`(match (o) { .. }) + o.k`) would read the box after
            // the free the caller places at the end of this statement.
            if (rc_ml_count_in_expr(r.value, name) != 1) { return []; }
            return iife_consuming_match_of(r.value, name);
        },
        _ => { return []; }
    }
}

// iife_consuming_match_of: the `match (name)` inside a value-position IIFE
// anywhere in `e`, or []. A zero-arg call of a zero-param lambda is the match
// EXPRESSION desugar's shape; sole_match_only_use_of applies the same
// only-mention rule the nested arms use, so a lambda body that touches `name`
// anywhere but the scrutinee declines.
//
// The descent covers the operand shapes a returned value takes. Anything else
// answers [] — a miss costs the credit, which is a leak, where a false hit would
// free a box the rest of the expression still reads.
function iife_consuming_match_of(e: ast.Expr, name: string): ast.Stmt[] {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() == 0) {
                match (c.callee) {
                    ast.ExprLambda(lm) => {
                        if (lm.params.len() == 0) { return sole_match_only_use_of(lm.body, name); }
                    },
                    _ => {}
                }
            }
            for a in c.args {
                var ca: ast.Stmt[] = iife_consuming_match_of(a, name);
                if (ca.len() == 1) { return ca; }
            }
            return [];
        },
        ast.ExprBinary(b) => {
            var bl: ast.Stmt[] = iife_consuming_match_of(b.left, name);
            if (bl.len() == 1) { return bl; }
            return iife_consuming_match_of(b.right, name);
        },
        ast.ExprUnary(u) => { return iife_consuming_match_of(u.operand, name); },
        ast.ExprIndex(ix) => {
            var ia: ast.Stmt[] = iife_consuming_match_of(ix.array, name);
            if (ia.len() == 1) { return ia; }
            return iife_consuming_match_of(ix.index, name);
        },
        ast.ExprFieldAccess(fa) => { return iife_consuming_match_of(fa.obj, name); },
        _ => {}
    }
    return [];
}

// sole_consuming_match_idx: sole_top_level_match_idx widened to the nested
// spelling — the top-level index of the statement that IS, or uniquely contains,
// the consuming match. That index is what the free is placed after and what the
// liveness/escape checks skip; consuming_match_of re-derives the match itself for
// the arm analyses.
//
// Counting statements that CONTAIN a match as well as those that are one is what
// keeps this sound: a name matched both flat and nested now yields two hits and
// is refused, where counting only flat matches would place the free after the
// first and leave the second reading a released box.
function sole_consuming_match_idx(stmts: ast.Stmt[], name: string): i32 {
    var idx: i32 = 0 - 1;
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        if (consuming_match_of(stmts[i], name).len() == 1) { idx = i; n = n + 1; }
        i = i + 1;
    }
    if (n == 1) { return idx; }
    return 0 - 1;
}

// arm_bodies_use_name: does `name` appear (read) in any arm body OR guard of the
// match statement `st`? (The scrutinee itself is excluded — the caller handles it.)
// A use inside a body is a real use, so x is NOT dead-after / single-mention.
function match_arms_use_name(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            var used: string[] = [];
            for arm in m.arms {
                if (arm.has_guard) { used = astwalk.collect_idents_expr(arm.guard, used); }
                var j: i32 = 0;
                while (j < arm.body.len()) { used = astwalk.collect_idents_stmt(arm.body[j], used); j = j + 1; }
            }
            return util.index_of_str(used, name) >= 0;
        },
        _ => { return false; }
    }
}

// name_used_after collects every ident read in body statements with index > after,
// and reports whether `name` appears — i.e. is `name` live past statement `after`.
function name_used_after(body: ast.Stmt[], name: string, after: i32): boolean {
    var used: string[] = [];
    var i: i32 = after + 1;
    while (i < body.len()) { used = astwalk.collect_idents_stmt(body[i], used); i = i + 1; }
    return util.index_of_str(used, name) >= 0;
}

// EnumFrees: parallel arrays — for each consumed scalar-enum free, the top-level
// body-statement index of the consuming `match` (after which the box is freed) and
// the local name x whose box is freed. Flat (not nested) for the same self-host
// limitation as PreciseDrops / ReuseSites.
// `vidxs[i]` is the candidate's DECLARING statement index, `idxs[i]` its
// consuming match's. The pair is the local's live range, which is the window the
// return-path drop has to be armed over: a `return` anywhere between the two
// jumps the post-match drop just as an arm's own `return` does (#7742).
// EnumFrees columns are parallel: idxs[k] is the consuming match's statement
// index, vidxs[k] the construction's, names[k] the local's spelling and sites[k]
// its binding-SITE key. The site is what a credit keys on — a name answers for
// whichever binding of that spelling is innermost at the read, which is a
// different binding whenever the body re-declares it (#7253).
struct EnumFrees { idxs: i32[], vidxs: i32[], names: string[], sites: string[] }

// consumed_scalar_enum_frees finds every function-local `var x = V(scalar...)` of
// an all-scalar enum consumed by exactly one `match (x)` where x is single-owner
// (only uses: the construction + that one scrutinee mention) and DEAD after the
// match. Each such x's box is freed right after its match statement. Conservative:
// any deviation (reassigned, escapes outside the scrutinee, used in an arm body,
// matched/used after, no match or more than one match mention) drops the candidate.
// all_assigns_fresh_scalar_enum reports whether EVERY assignment to `name`
// anywhere in `body` (recursively — the interesting ones sit inside a loop or an
// `if`) has a freshly-constructed all-scalar enum / scalar Option on its right.
//
// This is what lets consumed_scalar_enum_frees drop its blunt `reassigned`
// exclusion for this shape (#6127). A rebound local orphans its previous box on
// every assignment, so `var e = Nil; while (…) { e = Box(i, i); }` leaked one box
// per iteration and freed nothing at all — the candidate was refused outright, so
// not even the FINAL value was released.
//
// Refusing was the safe direction, and widening it is only safe because the
// escape gate is unchanged: the caller still requires that `name` never appears
// anywhere but the LHS of these assignments and the scrutinee of its one
// consuming match. walk_stmt_escapes reads an assignment's RHS only, so a rebind
// from the name itself (`e = wrap(e)`) escapes and is excluded, as is a value
// that was aliased out (`keep.append(e)`, `sink(e)`, `var k = e`) before being
// overwritten — the shapes where releasing the old box would be a use-after-free
// rather than a reclaim.
function all_assigns_fresh_scalar_enum(body: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        if (!stmt_assigns_fresh_scalar_enum(body[i], name, structs)) { return false; }
        i = i + 1;
    }
    return true;
}

function stmt_assigns_fresh_scalar_enum(st: ast.Stmt, name: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtAssign(asn) => {
            if (asn.target != name) { return true; }
            return fresh_scalar_enum_init(asn.value, structs) != "" || expr_is_scalar_option_ctor(asn.value);
        },
        ast.StmtIf(iff) => {
            return all_assigns_fresh_scalar_enum(iff.then_body, name, structs)
                && all_assigns_fresh_scalar_enum(iff.else_body, name, structs);
        },
        ast.StmtWhile(w) => { return all_assigns_fresh_scalar_enum(w.body, name, structs); },
        ast.StmtFor(f) => { return all_assigns_fresh_scalar_enum(f.body, name, structs); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (!all_assigns_fresh_scalar_enum(arm.body, name, structs)) { return false; }
            }
            return true;
        },
        ast.StmtDefer(d) => { return stmt_assigns_fresh_scalar_enum(d.action, name, structs); },
        _ => { return true; }
    }
}

// expr_is_scalar_option_ctor mirrors fresh_scalar_option_init for an ASSIGNMENT
// right-hand side (that helper reads a StmtVar's annotation, which a rebind has
// no equivalent of): `Some(<scalar literal-ish>)` or `None`.
function expr_is_scalar_option_ctor(e: ast.Expr): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == "None"; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name != "Some" || c.args.len() != 1) { return false; }
                    return expr_is_scalarish(c.args[0]);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// expr_is_scalarish accepts the operand forms a scalar Option payload can take
// without the box carrying anything rc-tracked: a numeric/boolean literal, a
// bare local, or arithmetic over them.
function expr_is_scalarish(e: ast.Expr): boolean {
    match (e) {
        ast.ExprNumber(_) => { return true; },
        ast.ExprBool(_) => { return true; },
        ast.ExprIdent(_) => { return true; },
        ast.ExprBinary(b) => { return expr_is_scalarish(b.left) && expr_is_scalarish(b.right); },
        _ => { return false; }
    }
}

// `nested_ok` admits a consuming match one block deeper (#6319). TRUE only from
// lower_block, which is where it is NEEDED: precise_drop_names is only ever called
// with fn.body, so it already claims the nested spelling at function scope and can
// never reach a loop-declared local.
//
// Keeping the fn-scope call sites on the flat lookup is a territory boundary, not a
// double-free guard — measured, because the obvious guess is wrong. Passing true
// there as well does NOT over-release: the precise drop zeroes the slot, so the
// second credit loads 0 and decs null. The boundary is kept because two analyses
// silently claiming one local is how a real over-release gets built later, and
// because the redundant credit buys nothing precise-drop has not already done.
function consumed_scalar_enum_frees(body: ast.Stmt[], structs: parser.StructDecl[], opt_fresh_reg: SigReg, nested_ok: boolean): EnumFrees {
    var idxs: i32[] = [];
    var vidxs: i32[] = [];
    var names: string[] = [];
    var sites: string[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var vi: i32 = 0;
    while (vi < body.len()) {
        match (body[vi]) {
            ast.StmtVar(v) => {
                // An all-scalar user enum (`var x = Circle(r)`) OR a fresh scalar
                // Option (`var o = Some(5)` / `None`) — both are single-owner rc-boxed
                // values whose box is shallow-freed after their consuming match. The
                // Option box gained its rc header from opt_make → __fern_arr_box.
                var owner: string = fresh_scalar_enum_init(v.init, structs);
                // #6360: a call to an OPTFRESH-proven producer is admitted on the
                // same footing as an inline ctor — see fresh_scalar_option_call_init
                // for why its payload gate is the stricter of the two.
                var is_opt: boolean = fresh_scalar_option_init(v)
                    || fresh_scalar_option_call_init(v, opt_fresh_reg);
                // A REBOUND name is admitted when every one of its assignments
                // constructs a fresh all-scalar enum / scalar Option (#6127): the
                // old box is then dead at each rebind and the escape gate below
                // still proves nothing else can be holding it. Refusing outright
                // leaked every intermediate AND the final value.
                var rebind_ok: boolean = util.index_of_str(reassigned, v.name) < 0
                    || all_assigns_fresh_scalar_enum(body, v.name, structs);
                if ((owner != "" || is_opt) && rebind_ok) {
                    // Find the single consuming match: exactly one top-level
                    // statement whose scrutinee is the bare ident `v.name` — or,
                    // under `nested_ok`, the top-level statement uniquely CONTAINING
                    // it, which is where the free then lands.
                    var match_idx: i32 = 0 - 1;
                    var msv: ast.Stmt[] = [];
                    if (nested_ok) {
                        match_idx = sole_consuming_match_idx(body, v.name);
                        if (match_idx > vi) { msv = consuming_match_of(body[match_idx], v.name); }
                    } else {
                        match_idx = sole_top_level_match_idx(body, v.name);
                        if (match_idx > vi) { msv = [body[match_idx]]; }
                    }
                    if (match_idx > vi && msv.len() == 1) {
                        // x must not be used in the match's arm bodies/guards (those
                        // uses would be a real escape/re-reference), must not be dead
                        // after the match (no later use), and must not escape anywhere
                        // outside the scrutinee mention. name_escapes_outside_stmt skips
                        // the WHOLE enclosing statement, so it ignores the scrutinee
                        // escape; we separately reject any arm-body use of x. Every
                        // other statement (incl. the construction's own init — a ctor
                        // call does not push x) is walked for escapes.
                        var arms_use: boolean = match_arms_use_name(msv[0], v.name);
                        var dead_after: boolean = !name_used_after(body, v.name, match_idx);
                        var escapes: boolean = name_escapes_outside_stmt(body, v.name, match_idx);
                        if (!arms_use && dead_after && !escapes) {
                            idxs = idxs.append(match_idx);
                            vidxs = vidxs.append(vi);
                            names = names.append(v.name);
                            sites = sites.append(reclaim_site_key_of(v.name, v.line, v.col));
                        }
                    }
                }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return EnumFrees { idxs: idxs, vidxs: vidxs, names: names, sites: sites };
}

// --- consumed RC-PAYLOAD enum free (deep-drop at the free site) -------------
//
// The scalar-enum free above only admits enums whose variant payloads are all
// flat scalars: a single __fern_rc_dec on the box buffer is the whole free. This
// widens that to enums whose variants carry an RC-TRACKED payload that a SINGLE
// __fern_rc_dec fully releases — a leak-safe scalar array
// (i32[]/i64[]/f64[]/boolean[]; a flat rc-headered element buffer, exactly the
// types emit_struct_field_drops already deep-drops on a struct's reclamation).
//
// A `string` payload IS eligible, and a nested struct is too — see
// enum_field_rc_droppable, which admits `t == "string"` (#4355) and a
// deep-drop-ok or scalar-only nested struct. String boxes have been rc-HEADERED
// since #4294 and are released by the rc-aware __fern_str_free (box + separate
// data buffer on asm, one inline block on wasm), with
// variant_struct_payloads_fresh keeping the payload the box's sole owner. This
// paragraph used to say the opposite at length — that a string was a raw
// __fern_alloc(16) fat pointer with no rc header, so decing one would mis-free —
// which was true before #4294 and has been wrong ever since.
//
// Still EXCLUDED: string[] / enum / map / option / tuple payloads, whose buffers
// hold pointers needing an element walk a shallow dec does not perform. At the free the
// runtime variant of x is unknown, so per variant V with an rc payload we emit a
// `variant_is(box, V)` guard that struct_gets + decs exactly V's rc fields, then
// the box dec — a runtime variant-dispatch deep-drop (emit_enum_variant_drops).
//
// SOUNDNESS GATE (problem-2, the trivial-and-sound starting point): the candidate
// is REJECTED if ANY arm BINDS an rc-typed payload variable (a non-`_` binding at
// an rc payload field position). When no arm names the rc payload, the payload can
// never escape the arm — the box still solely owns it — so deep-dropping it at the
// free is sound (no use-after-free / double-free). Borrow-only escape analysis is
// deliberately sidestepped. Scalar payloads may be bound freely (they are copied,
// not rc-tracked); only the rc payload binding is forbidden.
//
// DISJOINTNESS: this set is kept entirely SEPARATE from consumed_scalar_enum_frees
// and is NOT passed to enum_donor_reuse_sites, so an rc-payload box can never be
// donated (the donor path overwrites fields without dropping old values — sound
// only for scalar donors) and is freed by exactly one deep-drop here.

// enum_field_rc_droppable: a payload field type whose value is an rc-headered box
// the match-consume reclaim can release — a leak-safe scalar array
// (i32[]/i64[]/f64[]/boolean[], freed by one __fern_rc_dec), a deep-drop-ok
// nested struct (Perceus enum-payload slice: an rc-array-carrying LEAF struct,
// released by __struct_drop_<T> + a box dec, the same depth-1 recursion the
// struct-field deep-drop uses — see emit_enum_variant_drops), OR a STRING (#4355:
// string boxes are rc-HEADERED since #4294, released by the rc-aware
// __fern_str_free — box + separate data buffer on asm, one inline block on wasm;
// the freshness gate in variant_struct_payloads_fresh keeps the payload the box's
// sole owner). NOT a scalar (no rc — released with the box), NOT string[] / enum /
// map / opt / tuple, and NOT a non-leaf (cycle-risk) struct.
function enum_field_rc_droppable(structs: parser.StructDecl[], t: string): boolean {
    // An ENUM-array payload (`Seq(N[])`, including the self-referential shape a
    // tree enum is built from): `__fern_arrarr_free` rc-guards the buffer, decs
    // each element BOX, then frees the buffer. That is the one-level model the
    // struct-array path already uses — an element's own payload survives one
    // level down, which leaks rather than dangles (#6758).
    //
    // Admitting it is what unblocks the whole enum: enum_all_variants_rc_droppable
    // bails on the first non-droppable variant, so `Seq(N[])` was taking the
    // scalar `Leaf(i32)` variant down with it and neither was reclaimed.
    return is_enum_array_field_type(structs, t) || is_leaksafe_array_field(t) || t == "string"
        || (decl_is_struct(structs, t) && nested_field_deep_drop_ok(structs, t))
        // #4355 slice 8: a SCALAR-ONLY struct payload (`S { m: i32, n: i32 }`)
        // is one flat rc-headered box with no inner rc fields — released by a
        // single __fern_rc_dec, exactly like a leak-safe array. Fresh-gated at
        // admission (variant_struct_payloads_fresh requires a fresh struct
        // LITERAL for this arm too), so the box is the sole owner.
        || (decl_is_struct(structs, t) && struct_lit_all_scalar(structs, t));
}

// enum_variant_rc_droppable: every payload field of variant `vname` is either a
// flat scalar (reuse_field_is_scalar — no rc, dropped by box free) or rc-droppable
// (enum_field_rc_droppable). A field outside both bails the whole enum.
function enum_variant_rc_droppable(structs: parser.StructDecl[], vname: string): boolean {
    var n: i32 = decl_field_count(structs, vname);
    var fi: i32 = 0;
    while (fi < n) {
        var t: string = decl_field_type_at(structs, vname, fi);
        if (!reuse_field_is_scalar(t) && !enum_field_rc_droppable(structs, t)) { return false; }
        fi = fi + 1;
    }
    return true;
}

// enum_variant_has_rc_payload: variant `vname` has at least one rc-droppable
// payload field (string / leak-safe array) — the field(s) the deep-drop releases.
function enum_variant_has_rc_payload(structs: parser.StructDecl[], vname: string): boolean {
    var n: i32 = decl_field_count(structs, vname);
    var fi: i32 = 0;
    while (fi < n) {
        if (enum_field_rc_droppable(structs, decl_field_type_at(structs, vname, fi))) { return true; }
        fi = fi + 1;
    }
    return false;
}

// enum_arr_elems_walk_ok: the enum-ARRAY element walk (__enum_arr_elems_drop_<E>)
// may release payloads for enum E — every variant's payload fields are scalars
// or LEAK-SAFE scalar arrays, and some variant actually carries one. Only that
// payload kind's counting is guaranteed at construction (the variant ctor incs
// a bare-ident array payload — the #3720 dup — and a fresh literal is owned),
// so the walk's rc-guarded arr_dec balances either way; a string / nested-box
// payload can reach the box uncounted and keeps the enum outside the walk.
pub function enum_arr_elems_walk_ok(structs: parser.StructDecl[], ename: string): boolean {
    if (!decl_is_enum(structs, ename)) { return false; }
    var any_arr: boolean = false;
    for sd in structs {
        if (sd.enum_owner == ename) {
            var n: i32 = decl_field_count(structs, sd.name);
            var fi: i32 = 0;
            while (fi < n) {
                var ft: string = decl_field_type_at(structs, sd.name, fi);
                if (is_leaksafe_array_field(ft)) { any_arr = true; }
                else if (!is_scalar_type_name(ft)) { return false; }
                fi = fi + 1;
            }
        }
    }
    return any_arr;
}

// enum_arr_release_walk_ok: the enum-array element release may run for E —
// either the payload walk is provably balanced (enum_arr_elems_walk_ok), or
// every variant's payloads are scalar, where the release degenerates to a
// box-only free per element with no payload dec to protect (#7678: without
// it an all-scalar enum array stranded every element box). A wrapper on
// purpose: enum_arr_elems_walk_ok keeps its meaning, so the field-walk
// emitters keyed on it emit no empty-dispatch helper for the scalar case.
pub function enum_arr_release_walk_ok(structs: parser.StructDecl[], ename: string): boolean {
    if (enum_arr_elems_walk_ok(structs, ename)) { return true; }
    return decl_is_enum(structs, ename) && enum_all_variants_scalar(structs, ename);
}

// enum_walk_payload_offsets: for one variant, the byte offsets of its
// leak-safe-array payload fields ((k+1)*8 — shape@0, fields@8+), for the
// element-walk emitters.
pub function enum_walk_payload_offsets(structs: parser.StructDecl[], vname: string): i32[] {
    var out: i32[] = [];
    var n: i32 = decl_field_count(structs, vname);
    var fi: i32 = 0;
    while (fi < n) {
        if (is_leaksafe_array_field(decl_field_type_at(structs, vname, fi))) {
            out = out.append((fi + 1) * 8);
        }
        fi = fi + 1;
    }
    return out;
}

// enum_all_variants_rc_droppable: every variant of `enum_name` is rc-droppable AND
// at least one variant actually carries an rc payload. The second clause keeps this
// set DISJOINT from the all-scalar set (enum_all_variants_scalar) — a pure-scalar
// enum is handled by consumed_scalar_enum_frees, not here.
function enum_all_variants_rc_droppable(structs: parser.StructDecl[], enum_name: string): boolean {
    var any: boolean = false;
    var rc: boolean = false;
    for sd in structs {
        if (sd.enum_owner == enum_name) {
            any = true;
            if (!enum_variant_rc_droppable(structs, sd.name)) { return false; }
            if (enum_variant_has_rc_payload(structs, sd.name)) { rc = true; }
        }
    }
    return any && rc;
}

// variant_struct_payloads_fresh: every deep-drop-ok STRUCT payload arg of this
// variant construction `V(args...)` is a fresh struct LITERAL (sole-owned). The
// enum reclaim deep-drops such a payload at the consuming match; a bare-ident / call
// payload would alias a local whose own exit-sweep ALSO deep-drops it → a double-free
// of the payload's inner buffers (the variant-construction alias-inc protects only
// the box pointer, not the rc fields one level down — the exact hazard the struct-
// field deep-drop guards with the same fresh-literal rule). Array payloads are exempt
// here: their bare-ident aliasing IS balanced by the construction array alias-inc, so
// they stay admissible. A non-struct / non-deep-drop-ok field imposes no constraint.
// `str_fresh` is str_fresh_ret_fns (whole-program fresh-string producers, #7364) —
// pass [] where the registry is out of reach and only the syntactic set applies.
function variant_struct_payloads_fresh(args: ast.Expr[], variant_name: string, structs: parser.StructDecl[], str_fresh: string[], msites: string[], counted: boolean): boolean {
    var n: i32 = decl_field_count(structs, variant_name);
    var i: i32 = 0;
    while (i < n && i < args.len()) {
        var ft: string = decl_field_type_at(structs, variant_name, i);
        // Deep-drop-ok OR scalar-only struct payloads (#4355 slice 8) both get
        // released at the consuming match, so both must be FRESH struct
        // literals — a bare-ident payload aliases a local whose own sweep
        // would double-free the box.
        if (decl_is_struct(structs, ft)
            && (nested_field_deep_drop_ok(structs, ft) || struct_lit_all_scalar(structs, ft))) {
            var fresh: boolean = false;
            match (args[i]) {
                ast.ExprStructLit(_) => { fresh = true; },
                _ => {}
            }
            // A bare ident the store MOVES qualifies too, and NOT for the reason
            // the fresh-literal rule above states. There is no sweep to double-free:
            // struct_box_sink_stored_expr already refuses a variant-ctor argument its
            // struct credit, so the source releases nothing. What a move adds is that
            // the source's VALUE is dead after this store, which is what makes the
            // enum the only reader and its payload drop the one release.
            if (!fresh && moved_ident_at(args[i], msites)) { fresh = true; }
            // A COUNTED payload: the construction retained this box
            // (lower_variant_ctor_args, same predicate), so the enum holds a claim
            // of its own and its release is balanced whether or not the source
            // stays live. Admissible ONLY to callers whose release is rc-gated —
            // emit_enum_variant_payload_drops walks the payload under
            // __fern_rc_is_unique — which is what `counted` asserts. The
            // sole-ownership consumers (struct_lit_all_enum_fields_fresh and the
            // two registry scans) pass false: their premise is rc == 1 and no
            // construction alias-inc, which a retained payload contradicts by
            // definition.
            if (!fresh && counted && variant_counted_struct_payload(args[i], ft, structs)) { fresh = true; }
            if (!fresh) { return false; }
        }
        // A STRING payload (#4355) must be FRESH too — a literal (const_str allocs
        // a fresh box per construction; its .rodata data is heap-guard-skipped by
        // __fern_str_free) or a fresh producer (concat / named producer / string
        // method copy). A bare ident / field read / general call would alias a
        // live box the match-site __fern_str_free would free out from under it.
        if (ft == "string") {
            var sfresh: boolean = false;
            match (args[i]) {
                ast.ExprString(_) => { sfresh = true; },
                // A CALL to a whole-program-proven fresh-string producer
                // (str_fresh_ret_fns — every return a fresh sole-owned box)
                // hands the variant its only reference, exactly like a concat
                // (#7364). Bare rows only: the "SFR*:"-tagged method rows can
                // never equal a bare callee name.
                ast.ExprCall(c2) => {
                    match (c2.callee) {
                        ast.ExprIdent(cid2) => { sfresh = util.index_of_str(str_fresh, cid2.name) >= 0; },
                        _ => {}
                    }
                    if (!sfresh) { sfresh = str_local_binding_is_fresh(args[i]); }
                },
                _ => { sfresh = str_local_binding_is_fresh(args[i]); }
            }
            if (!sfresh) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// fresh_rcpayload_enum_init: `e` is a sole-owner construction of an rc-payload
// (deep-droppable) enum — `V(args...)` or a bare unit variant `V`. Returns the
// enum's name, or "". Mirrors fresh_scalar_enum_init for the widened set. A
// deep-drop-ok STRUCT payload must be a fresh struct literal and a STRING payload a
// fresh literal/producer (variant_struct_payloads_fresh) so the match-site drop
// can't double-free a local the payload aliases; array payloads ride the
// construction alias-inc and need no such gate.
function fresh_rcpayload_enum_init(e: ast.Expr, structs: parser.StructDecl[], str_fresh: string[], msites: string[], counted: boolean): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    var owner: string = variant_enum_owner(structs, id.name);
                    if (owner != "" && enum_all_variants_rc_droppable(structs, owner)
                        && variant_struct_payloads_fresh(c.args, id.name, structs, str_fresh, msites, counted)) { return owner; }
                    return "";
                },
                // Qualified ctor `Enum.Variant(args...)` — the callee is a field
                // access (obj=Enum, field=Variant), not a bare ident. Resolve the
                // variant by its field name, same gates. Without this a qualified-style
                // construction never reaches the consume-by-match reclaim (the box +
                // payload leak), unlike the unqualified form.
                ast.ExprFieldAccess(fa) => {
                    var ownerq: string = variant_enum_owner(structs, fa.field);
                    if (ownerq != "" && enum_all_variants_rc_droppable(structs, ownerq)
                        && variant_struct_payloads_fresh(c.args, fa.field, structs, str_fresh, msites, counted)) { return ownerq; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        ast.ExprIdent(id) => {
            var owner2: string = variant_enum_owner(structs, id.name);
            if (owner2 != "" && enum_all_variants_rc_droppable(structs, owner2)) { return owner2; }
            return "";
        },
        // Qualified bare UNIT variant `Enum.Variant` (no call) — a payload-free init,
        // admitted for parity with the unqualified unit case (the reclaim is a runtime
        // variant_is no-op for a unit box, but keeps the analysis uniform).
        ast.ExprFieldAccess(fa) => {
            var owner3: string = variant_enum_owner(structs, fa.field);
            if (owner3 != "" && enum_all_variants_rc_droppable(structs, owner3)) { return owner3; }
            return "";
        },
        _ => { return ""; }
    }
}

// match_arm_binds_rc_payload: does any arm of match `st` BIND (name, non-`_`) an
// rc-typed payload variable that ESCAPES its arm body? Field 0 of variant V binds
// `pv.binding`; field k>=1 binds `pv.extra_bindings[k-1]`. A binding is an rc
// payload iff its field's type is rc-droppable (string / leak-safe array); scalar
// bindings are always allowed (the scalar is copied, not rc-tracked).
//
// WIDENED (bind-but-no-escape): an arm MAY bind an rc payload variable as long as
// that bound name is used ONLY as a BORROW (a read: indexing `a[i]`, `a.len()`,
// arithmetic over reads) within its arm body. The bound name `a` aliases the box's
// array field; the box is deep-dropped + freed AFTER the whole match runs, so a
// borrow whose last use is inside the arm is sound. We REJECT (return true) only
// when a bound rc payload escapes its arm — i.e. body_unsafe_for finds it stored
// to an outer var, returned, sliced/aliased, captured, or passed to any call (the
// empty `[]` borrowable registry treats every call arg as a retain). A guard read
// is a borrow; a guard escape is rejected via expr_unsafe_for. True => the
// candidate enum is NOT admitted; it falls back to the normal exit sweep.
function match_arm_binds_rc_payload(st: ast.Stmt, structs: parser.StructDecl[]): boolean {
    var none: string[] = [];
    match (st) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        // strip a qualified `Enum.Variant` to the bare variant name.
                        var vname: string = pv.type_name;
                        var vc: i32 = 0;
                        while (vc < pv.type_name.len()) {
                            if (pv.type_name[vc] == b'.') { vname = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; }
                            vc = vc + 1;
                        }
                        // field 0 binding. (Compare against "" / "_" rather than
                        // calling .len() on the binding: a non-empty, non-`_` name is
                        // a real binding. Bind each extra to a typed local first — a
                        // .len()/method call directly on the index expression
                        // `extra_bindings[eb]` mis-infers the receiver on the
                        // self-host path, emitting an undefined __fn_i32__len.)
                        if (pv.binding != "" && pv.binding != "_") {
                            if (enum_field_rc_droppable(structs, decl_field_type_at(structs, vname, 0))) {
                                if (binding_escapes_arm(arm, pv.binding, none)) { return true; }
                            }
                        }
                        // extra bindings (fields 1..).
                        var eb: i32 = 0;
                        while (eb < pv.extra_bindings.len()) {
                            var ebn: string = pv.extra_bindings[eb];
                            if (ebn != "" && ebn != "_") {
                                if (enum_field_rc_droppable(structs, decl_field_type_at(structs, vname, eb + 1))) {
                                    if (binding_escapes_arm(arm, ebn, none)) { return true; }
                                }
                            }
                            eb = eb + 1;
                        }
                    },
                    _ => {}
                }
            }
            return false;
        },
        _ => { return false; }
    }
}

// enum_body_binds_rc_payload: recursively scan `stmts` (through nested if/while/for/
// match blocks) for a `match (name)` whose arms bind an rc payload that ESCAPES its
// arm (match_arm_binds_rc_payload). The rc-payload-ENUM analogue of
// opt_body_binding_escapes — used by the rc-payload enum precise-drop path, where the
// consuming match sits in a NESTED block. A true result rejects the candidate.
function enum_body_binds_rc_payload(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        if (enum_stmt_binds_rc_payload(stmt, name, structs)) { return true; }
    }
    return false;
}
function enum_stmt_binds_rc_payload(st: ast.Stmt, name: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            match (m.scrutinee) {
                ast.ExprIdent(id) => {
                    if (id.name == name && match_arm_binds_rc_payload(st, structs)) { return true; }
                },
                _ => {}
            }
            for arm in m.arms {
                if (enum_body_binds_rc_payload(arm.body, name, structs)) { return true; }
            }
            return false;
        },
        ast.StmtIf(iff) => {
            return enum_body_binds_rc_payload(iff.then_body, name, structs)
                || enum_body_binds_rc_payload(iff.else_body, name, structs);
        },
        ast.StmtWhile(w) => { return enum_body_binds_rc_payload(w.body, name, structs); },
        ast.StmtFor(f) => { return enum_body_binds_rc_payload(f.body, name, structs); },
        _ => { return false; }
    }
}

// binding_escapes_arm reports whether the arm-bound rc payload `name` escapes its
// arm: it is used anywhere in the arm body or guard in a position other than a
// borrow read. Reuses the precise-drop escape family (body_unsafe_for /
// expr_unsafe_for) with an EMPTY borrowable registry, so every call argument is
// conservatively a retain (escape). A borrow-only binding (indexing, `.len()`,
// arithmetic over reads) returns false and is admitted.
function binding_escapes_arm(arm: ast.MatchArm, name: string, borrowable: string[]): boolean {
    if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) { return true; }
    return body_unsafe_for(arm.body, name, borrowable, []);
}

// binding_escapes_arm_scrut is binding_escapes_arm with the MATCH-SCRUTINEE
// reading #6127 gave the option LOCAL, applied to the arm BINDING instead: a
// nested `match (binding)` consumes it by reading its tag and payload and
// retains nothing, so it is a borrow. Any other mention of the binding still
// escapes, because body_unsafe_for_match_borrow relaxes that one position and
// nothing else.
//
// Only the nested-OPTION payload asks for it, and only there is it sound: the
// inner box's own payload is scalar, so the nested match's own binding is a
// COPY that cannot outlive the arm either. An rc inner payload would need its
// own proof and does not get this reading.
function binding_escapes_arm_scrut(arm: ast.MatchArm, name: string): boolean {
    var none: string[] = [];
    if (arm.has_guard && expr_unsafe_for(arm.guard, name, none, [])) { return true; }
    return body_unsafe_for_match_borrow(arm.body, name, none, [], []);
}

// binding_returns_from_arm: the arm-bound payload `name` reaches a `return` inside
// the arm. That is the one escape that HANDS OVER the box's reference — the self-host
// IR path has no return-transfer inc, so the value leaves owning the payload and the
// post-match drop must not dec it. Every other escape (a store to an outer local, a
// call argument) leaves the payload's ownership decided by the destination's own
// counted claim, not by this binding.
function binding_returns_from_arm(body: ast.Stmt[], name: string): boolean {
    for stmt in body {
        match (stmt) {
            ast.StmtReturn(r) => { if (expr_mentions_name(r.value, name)) { return true; } },
            ast.StmtIf(f) => { if (binding_returns_from_arm(f.then_body, name) || binding_returns_from_arm(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (binding_returns_from_arm(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (binding_returns_from_arm(fo.body, name)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (binding_returns_from_arm(m.arms[a].body, name)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// store_out_takes_counted_claim: storing an arm-bound payload of type `ft` to an
// outer local RETAINS it, so the payload gains a second counted owner and the
// post-match dec lands on that claim rather than on zero.
//
// Only a plain scalar-element ARRAY payload does. Measured on the emitted asm: an
// `i32[]` payload's store emits one __fern_rc_inc, a `string` payload's and a
// nested struct's emit none — those aliases are UNCOUNTED, so the box stays sole
// owner and a dec at the match frees a value the alias still reads. (The drop
// helpers are not the reason: __fern_str_free reads rc at box-8 and only decs when
// rc>1. The missing retain is, and it is its own bug — closing it is what would let
// these payloads give up the skip too.)
function store_out_takes_counted_claim(structs: parser.StructDecl[], ft: string): boolean {
    return is_leaksafe_array_field(ft) && !is_enum_array_field_type(structs, ft);
}

// moved_skip_applies: given that the arm binding `name` escapes, does the post-match
// drop have to SKIP this payload's dec? Only when nothing else will hold a counted
// claim on the payload once the arm is done — either because the escape HANDS THE
// REFERENCE OVER (a return: no return-transfer inc, so the value leaves owning it),
// or because the payload's escaping store is UNCOUNTED (store_out_takes_counted_claim).
//
// An array payload stored to an outer local or handed to a call keeps its dec: the
// store's own retain means the dec lands on that claim, and skipping strands it.
function moved_skip_applies(arm: ast.MatchArm, name: string, ft: string, structs: parser.StructDecl[]): boolean {
    if (!store_out_takes_counted_claim(structs, ft)) { return true; }
    return binding_returns_from_arm(arm.body, name);
}

// match_moved_rc_payloads: the Koka consuming-match MOVED-payload set (#4400)
// for the consuming rc-payload enum match `st`: every "<Variant>#<field k>"
// whose rc-droppable payload field is BOUND (non-`_`) by an arm to a name whose
// escape means the post-match deep-drop must SKIP that field's dec
// (emit_enum_variant_drops_gated). Borrow-only bindings stay OUT: their arm is
// done with the payload by the time the free runs. Scalar payloads impose
// nothing (copied, not rc-tracked).
//
// Escaping is necessary but NOT sufficient — moved_skip_applies decides. An
// rc-guarded ARRAY payload escaping by a store or a call argument keeps its dec:
// the destination takes its own counted claim, so the dec lands on that claim
// rather than on zero, and skipping it strands one. Measured: such a store was
// 300 allocs / 200 frees over 100 rounds against native's 300/300, and a
// borrow-only call argument 200/100 against 200/200.
//
// The skip is exact only when the escaping arm ALWAYS runs for its variant — a
// guard could divert execution to a different arm that did NOT move the
// payload, turning the skip into a per-call leak. consumed_rcpayload_enum_frees
// therefore REJECTS any candidate that mixes a non-empty moved set with a
// guarded arm (match_has_guarded_arm); by emission time a non-empty moved set
// implies every arm is unguarded, so exactly the escaping arm ran.
function match_moved_rc_payloads(st: ast.Stmt, structs: parser.StructDecl[]): string[] {
    var moved: string[] = [];
    var none: string[] = [];
    match (st) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        // strip a qualified `Enum.Variant` to the bare variant name
                        // (same walk as match_arm_binds_rc_payload).
                        var vname: string = pv.type_name;
                        var vc: i32 = 0;
                        while (vc < pv.type_name.len()) {
                            if (pv.type_name[vc] == b'.') { vname = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; }
                            vc = vc + 1;
                        }
                        if (pv.binding != "" && pv.binding != "_") {
                            var ft0: string = decl_field_type_at(structs, vname, 0);
                            if (enum_field_rc_droppable(structs, ft0)) {
                                if (binding_escapes_arm(arm, pv.binding, none)
                                        && moved_skip_applies(arm, pv.binding, ft0, structs)) { moved = moved.append(vname + "#0"); }
                            }
                        }
                        var eb: i32 = 0;
                        while (eb < pv.extra_bindings.len()) {
                            var ebn: string = pv.extra_bindings[eb];
                            if (ebn != "" && ebn != "_") {
                                var ftk: string = decl_field_type_at(structs, vname, eb + 1);
                                if (enum_field_rc_droppable(structs, ftk)) {
                                    if (binding_escapes_arm(arm, ebn, none)
                                            && moved_skip_applies(arm, ebn, ftk, structs)) { moved = moved.append(vname + "#" + util.i32_to_string(eb + 1)); }
                                }
                            }
                            eb = eb + 1;
                        }
                    },
                    _ => {}
                }
            }
            return moved;
        },
        _ => { return moved; }
    }
}

// match_has_guarded_arm: any arm of match `st` carries a guard — the
// diversion that would make a moved-payload skip inexact (see
// match_moved_rc_payloads).
function match_has_guarded_arm(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (arm.has_guard) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
}

// RcEnumFrees: parallel arrays for the rc-payload enum free — the consuming match
// index, the freed local name x, and x's ENUM name (so the deep-drop can iterate
// the enum's variants at the free site).
struct RcEnumFrees { idxs: i32[], vidxs: i32[], names: string[], enums: string[] }

// consumed_rcpayload_enum_frees: the rc-payload analogue of
// consumed_scalar_enum_frees. Finds every function-local `var x = V(payload...)`
// of an rc-droppable enum consumed by exactly one `match (x)`, single-owner,
// dead-after, non-escaping. Arm bindings impose NO gate anymore (#4400): a
// borrow-only rc binding keeps its dec (the free runs after the whole match),
// and an ESCAPING rc binding puts its (variant, field) into the MOVED set
// (match_moved_rc_payloads) so the free site skips that field's dec —
// ownership transferred to the escapee. Each such x's box is deep-dropped +
// freed right after its match (emit_enum_variant_drops_gated). Same shape as
// the scalar pass.
//
// The init is resolved exactly as collect_fresh_rcenum_names resolves it — a
// direct/qualified ctor OR a call to an "RCE:"-registered fresh rc-enum ctor fn.
// The two must agree: collect grants the credit, which is what SUPPRESSES the
// exit sweep, and this pass emits the free the credit assumes. Admitting the
// call form there and not here left `var v: E = mkv(i)` with a sole consuming
// match reclaiming nothing at all.
function consumed_rcpayload_enum_frees(body: ast.Stmt[], structs: parser.StructDecl[], opt_fresh_ret: SigReg, str_fresh: string[], msites: string[], borrowable: string[]): RcEnumFrees {
    var idxs: i32[] = [];
    var vidxs: i32[] = [];
    var names: string[] = [];
    var enums: string[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var vi: i32 = 0;
    while (vi < body.len()) {
        match (body[vi]) {
            ast.StmtVar(v) => {
                var owner: string = fresh_rcpayload_enum_init(v.init, structs, str_fresh, msites, true);
                if (owner == "") { owner = rcenum_call_init_owner(v.init, opt_fresh_ret); }
                // A REBOUND name is admitted when every assignment builds a fresh
                // chain of the same enum (#6127). The rebinds release the orphaned
                // chains via emit_enum_deep_reinit_store; this free is what releases
                // the LAST one, and without it the final value's box + payload leaked
                // (2 blocks per round) even with the rebind release in place.
                var cre_rebind_ok: boolean = util.index_of_str(reassigned, v.name) < 0
                    || all_assigns_fresh_rcenum(body, v.name, owner, structs, opt_fresh_ret, str_fresh);
                if (owner != "" && cre_rebind_ok) {
                    var match_idx: i32 = sole_top_level_match_idx(body, v.name);
                    if (match_idx > vi) {
                        var arms_use: boolean = match_arms_use_name(body[match_idx], v.name);
                        var dead_after: boolean = !name_used_after(body, v.name, match_idx);
                        // The counted-enum-field carve-out (ef_escape_names): a bare
                        // `name` handed to an enum-typed struct-literal field is
                        // retained there, and this release is is_unique-gated, so the
                        // share is safe — see emit_enum_variant_drops_gated.
                        // A CONFINED alias bind is not an escape (#7687's proof,
                        // reaching this second scan): it takes no release, so the
                        // source stays the sole releaser.
                        var escapes: boolean = name_escapes_outside_stmt_enumfield_alias(body, v.name, match_idx, structs,
                            rcenum_alias_chain_sites_of(body, v.name, borrowable, structs, body, []));
                        // An arm binding an ESCAPING rc payload no longer rejects
                        // the candidate (#4400): the free site skips the dec of
                        // each moved (variant, field) pair instead — see
                        // match_moved_rc_payloads / emit_enum_variant_drops_gated.
                        // (The nested precise-drop path keeps its reject via
                        // enum_body_binds_rc_payload.) EXCEPT when the match also
                        // has a GUARDED arm: a guard could divert execution to an
                        // arm that did not move the payload, making the skip a
                        // per-call leak — such mixes fall back to the exit sweep.
                        var guarded_move: boolean = match_has_guarded_arm(body[match_idx])
                            && match_moved_rc_payloads(body[match_idx], structs).len() > 0;
                        if (!arms_use && dead_after && !escapes && !guarded_move) {
                            idxs = idxs.append(match_idx);
                            vidxs = vidxs.append(vi);
                            names = names.append(v.name);
                            enums = enums.append(owner);
                        }
                    }
                }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return RcEnumFrees { idxs: idxs, vidxs: vidxs, names: names, enums: enums };
}

// emit_enum_variant_drops deep-drops the rc payload of the box in `slot` (an
// rc-payload enum value), then frees the box and zeroes the slot. The runtime
// variant is unknown, so for each variant V of `enum_name` that carries an rc
// payload we emit a guarded block:
//     if (box != null && variant_is(box, V)) { drop V's rc payload fields }
// (variant_is is false for a null/mismatched box, so the guard also covers null).
// Each rc field is struct_get + __fern_rc_dec (the same single-dec full release
// emit_struct_field_drops uses for a leak-safe array); a STRING payload (#4355)
// is struct_get + the rc-aware __fern_str_free (box + separate data buffer on
// asm; one inline block on wasm), fresh-gated at admission
// (variant_struct_payloads_fresh) so the box is its sole owner.
// After the per-variant drops, the box itself
// is dec'd (__fern_rc_dec frees the box buffer) and the slot zeroed so the exit
// sweep harmlessly decs a null. The payload is therefore dropped BEFORE the box
// and exactly once.
function emit_enum_variant_drops(s: LowerState, slot: i32, enum_name: string): LowerState {
    var no_moved: string[] = [];
    return emit_enum_variant_drops_gated(s, slot, enum_name, no_moved, false);
}

// emit_enum_variant_drops_gated is the release above with two additions.
//
// `moved` is the MOVED-field set (#4400, the Koka consuming-match dup/dec
// cancellation): each entry is "<Variant>#<field index>" for an rc payload
// field whose arm binding ESCAPES its arm (match_moved_rc_payloads). Ownership
// of that payload moved to the escapee (the binding was the box's counted
// reference, handed on), so the deep-drop SKIPS its dec — dropping it would
// free a value the escapee still holds; the box itself is still freed either
// way. The skip is exact: admission rejects guard/move mixes
// (consumed_rcpayload_enum_frees' guarded_move gate), so a non-empty set
// implies every arm is unguarded and exactly the escaping arm ran.
//
// `shared` guards the payload walk with __fern_rc_is_unique — the local-side
// twin of the gate emit_struct_enum_field_payload_drops already applies from
// the struct side.
//
// `shared` is true wherever the released name may be a COUNTED SHARE: a bare
// enum ident handed to a struct-literal field is retained there, so at this
// release the box carries two claims and its payload is still reachable
// through the struct. Deep-dropping under that dup would free a live payload;
// the guard takes the shallow path instead (box dec only), and the OTHER
// owner — itself is_unique-gated — finds rc 1 and does the deep work. Whichever
// of the two releases runs last frees the payload, in either order, and neither
// order double-frees.
//
// The box dec stays unconditional: it is the claim this release owns, rc-guarded
// in the runtime, and it is what lets the surviving owner reach 1.
function emit_enum_variant_drops_gated(s: LowerState, slot: i32, enum_name: string, moved: string[], shared: boolean): LowerState {
    var st: LowerState = s;
    if (shared) {
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));   // sole owner (and null-safe)
        st = st.emit(ir.op_if(0));
        st = emit_enum_variant_payload_drops(st, slot, enum_name, moved);
        st = st.emit(ir.op_end());
    } else {
        st = emit_enum_variant_payload_drops(st, slot, enum_name, moved);
    }
    // free the box itself and zero the slot.
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    return st;
}

// emit_enum_variant_payload_drops is emit_enum_variant_drops MINUS the box free + slot
// zero: it runtime-dispatches on the box's current variant and releases each variant's
// rc payload fields, but LEAVES the box allocated and the slot pointing at it. Three
// callers need exactly that split:
//   - emit_enum_inplace_reassign / emit_enum_donor_reuse, which re-shape the SAME box
//     to the new variant rather than freeing it;
//   - emit_struct_enum_field_payload_drops, where __struct_drop_<T>'s k_enum arm frees
//     the box afterwards and a second dec here would over-release it;
//   - emit_enum_variant_drops_gated, which appends the free itself.
function emit_enum_variant_payload_drops(s: LowerState, slot: i32, enum_name: string, moved: string[]): LowerState {
    var st: LowerState = s;
    var vi: i32 = 0;
    while (vi < st.structs.len()) {
        if (st.structs[vi].enum_owner == enum_name && enum_variant_has_rc_payload(st.structs, st.structs[vi].name)) {
            var vname: string = st.structs[vi].name;
            // if (box != null && variant_is(box, V)) { ... }
            st = st.emit(ir.op_block(0));
            st = st.emit(ir.op_load_local(slot));
            st = st.emit(ir.op_variant_is(vname));
            st = st.emit(ir.op_bin("not", 0, false));   // 1 if NOT this variant
            st = st.emit(ir.op_brif(0));                // -> skip on mismatch / null
            var n: i32 = decl_field_count(st.structs, vname);
            var fk: i32 = 0;
            while (fk < n) {
                var eft: string = decl_field_type_at(st.structs, vname, fk);
                if (util.index_of_str(moved, vname + "#" + util.i32_to_string(fk)) >= 0) {
                    // moved-out payload: the arm's escaping binding owns it now.
                } else if (is_enum_array_field_type(st.structs, eft)) {
                    // ENUM-array payload: the elements are rc-headered boxes, so a
                    // single dec of the buffer would strand every one of them.
                    // __fern_arrarr_free decs each element first (rc-guarded, so a
                    // shared element only decs) and then frees the buffer.
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1));
                    st = st.emit(ir.op_drop());
                } else if (is_leaksafe_array_field(eft)) {
                    // scalar-element array payload: one dec frees the buffer (scalar
                    // elements carry no inner pointers to release).
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (eft == "string") {
                    // STRING payload (#4355): the rc-aware __fern_str_free releases
                    // the box + its separate data buffer on asm (one inline block on
                    // wasm, where it maps to $__fern_arr_dec). Fresh-gated at
                    // admission (variant_struct_payloads_fresh: literal / fresh
                    // producer only), so the box is the sole owner — a literal's
                    // .rodata data is heap-guard-skipped, an immortal view (never
                    // admitted) would be sentinel-skipped, and a double free ticks
                    // the underflow detector instead of corrupting the heap.
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__fern_str_free", 1));
                    st = st.emit(ir.op_drop());
                } else if (decl_is_struct(st.structs, eft) && nested_field_deep_drop_ok(st.structs, eft)) {
                    // deep-drop-ok nested-struct payload (Perceus enum-payload slice):
                    // __struct_drop_<T> releases the payload's rc-array fields (depth-1,
                    // leaf — nested_field_deep_drop_ok), then __fern_rc_dec frees the
                    // payload box. The backend auto-emits __struct_drop_<T> on seeing the
                    // call_direct (asm_ir op scan / wasm struct_drop_types).
                    //
                    // The WALK runs under __fern_rc_is_unique, the dec unconditionally.
                    // At rc 1 — a fresh struct literal, or a payload the construction
                    // MOVED — the guard passes and this is the release it always was.
                    // It earns its keep on a COUNTED payload, where the source local
                    // still holds a claim: two static walks free every field buffer
                    // twice, and the census cannot see it (allocs == frees at
                    // live_bytes 0, only __rc_underflow_count() dissenting). Gated, the
                    // walk belongs to whichever owner finds rc 1 and the dec hands the
                    // last one its turn, so sweep ORDER stops mattering.
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
                    st = st.emit(ir.op_if(0));
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__struct_drop_" + eft, 1));   // release payload's rc fields; returns box
                    st = st.emit(ir.op_drop());
                    st = st.emit(ir.op_end());
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));          // free the payload box
                    st = st.emit(ir.op_drop());
                } else if (decl_is_struct(st.structs, eft) && struct_lit_all_scalar(st.structs, eft)) {
                    // SCALAR-ONLY struct payload (#4355 slice 8): no inner rc
                    // fields, so a single __fern_rc_dec frees the payload box —
                    // the struct sibling of the leak-safe array arm. Same
                    // fresh-literal admission gate as the deep-drop-ok arm, so
                    // the box is the sole owner.
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_get(fk, struct_field_width(st.structs, vname, fk)));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                }
                fk = fk + 1;
            }
            st = st.emit(ir.op_end());
        }
        vi = vi + 1;
    }
    return st;
}

// --- enum self-reassign deep-drop (Perceus: close the reassigned-enum payload leak) ---
//
// A loop-carried enum with a scalar-ARRAY payload — `var b: E = V0([..]); while (..) {
// b = V1([..]); b = V2([..]); }` — leaks the superseded variant's payload array on the
// register backends (box-only shallow free; a 50M-iter churn OOMs on x86). This routes
// such a reassign through a variant-dispatch DEEP-DROP of the OLD box before storing the
// new one. On WASM this pattern is already reclaimed (verified flat), so the extra dec is
// a rc-GUARDED no-op there (arr_dec on an already-released buffer bumps the underflow
// detector without re-freeing). SOUND only when b's payload is never aliased AND every
// variant payload is a leak-safe SCALAR ARRAY (single arr_dec fully releases it — NOT a
// nested struct, whose __struct_drop would double-free a shared payload). The reassign
// RHS is always a FRESH variant ctor, so the new box never equals the old — no cow guard.

// enum_variant_array_payload_only: every field of variant `vname` is a flat scalar or a
// leak-safe SCALAR ARRAY. String / nested-struct / enum / map / option / tuple payloads
// bail — the deep-drop must be a single arr_dec per rc field, never a __struct_drop.
function enum_variant_array_payload_only(structs: parser.StructDecl[], vname: string): boolean {
    var n: i32 = decl_field_count(structs, vname);
    var fi: i32 = 0;
    while (fi < n) {
        var t: string = decl_field_type_at(structs, vname, fi);
        if (!reuse_field_is_scalar(t) && !is_leaksafe_array_field(t)) { return false; }
        fi = fi + 1;
    }
    return true;
}

// enum_all_variants_array_payload: every variant of `enum_name` is array-payload-only AND
// at least one variant carries an array (so there is a payload to reclaim).
// enum_payloads_counted_at_ctor: every rc payload of `enum_name` is one the
// construction takes a counted reference to — an array payload
// (enum_all_variants_array_payload, the original shape) or a struct payload
// lower_variant_ctor_args now retains (variant_counted_struct_payload's field
// test). The rc plan uses it to decide escape_owned (counted) against a full
// escape: a payload the ctor counts does not take the source's whole box with
// it, so the source stays free-eligible.
function enum_payloads_counted_at_ctor(structs: parser.StructDecl[], enum_name: string): boolean {
    if (enum_all_variants_array_payload(structs, enum_name)) { return true; }
    var any: boolean = false;
    var rc: boolean = false;
    for sd in structs {
        if (sd.enum_owner == enum_name) {
            any = true;
            var n: i32 = decl_field_count(structs, sd.name);
            var fi: i32 = 0;
            while (fi < n) {
                var ft: string = decl_field_type_at(structs, sd.name, fi);
                if (decl_is_struct(structs, ft)
                    && (nested_field_deep_drop_ok(structs, ft) || struct_lit_all_scalar(structs, ft))) { rc = true; }
                else if (!reuse_field_is_scalar(ft)) { return false; }
                fi = fi + 1;
            }
        }
    }
    return any && rc;
}

function enum_all_variants_array_payload(structs: parser.StructDecl[], enum_name: string): boolean {
    var any: boolean = false;
    var arr: boolean = false;
    for sd in structs {
        if (sd.enum_owner == enum_name) {
            any = true;
            if (!enum_variant_array_payload_only(structs, sd.name)) { return false; }
            if (enum_variant_has_rc_payload(structs, sd.name)) { arr = true; }
        }
    }
    return any && arr;
}

// enum_all_variants_same_field_count: every variant of `enum_name` has the SAME decl
// field count (so every variant's box — `op_struct_make(V, field_count)`, a per-variant
// size — is byte-identical in layout). This is the size-safety gate for IN-PLACE enum
// self-reassign reuse: b's box, allocated for whatever variant it currently holds, can
// only be re-shaped to a different variant in place when that variant's box is the same
// size. Array-payload-only variants (enum_all_variants_array_payload) already have
// pointer-width fields throughout, so equal field COUNT ⇒ identical box size ⇒ same
// freelist class. A ragged enum (`Keep(i32[])` vs `Swap(i32[], i32[])`) fails here and
// keeps the safe free+alloc reclaim (emit_enum_reclaim_store).
function enum_all_variants_same_field_count(structs: parser.StructDecl[], enum_name: string): boolean {
    var seen: boolean = false;
    var want: i32 = 0;
    for sd in structs {
        if (sd.enum_owner == enum_name) {
            var fc: i32 = sd.fields.len();
            if (!seen) { want = fc; seen = true; }
            else if (fc != want) { return false; }
        }
    }
    return seen;
}

// variant_ctor_qualified_name: the VARIANT a qualified construction `E.V(args)`
// / bare `E.V` names, or "". The structs-only sibling of qualified_variant_enum
// (which needs a LowerState for its shadowing check): the field must be a
// variant and the object the bare name of the enum that owns it, so a method
// call `o.v(…)` cannot pass by naming a receiver after its own enum.
function variant_ctor_qualified_name(fa: ast.ExprFieldAccess, structs: parser.StructDecl[]): string {
    var owner: string = variant_enum_owner(structs, fa.field);
    if (owner == "") { return ""; }
    match (fa.obj) {
        ast.ExprIdent(eid) => { if (eid.name == owner) { return fa.field; } },
        _ => {}
    }
    return "";
}

// variant_ctor_enum_owner: the enum E a variant-constructor expr `V(args)` /
// bare `V` — or the qualified `E.V(args)` / `E.V` spelling of either — belongs
// to, or "". Both spellings build the same fresh rc=1 box, so every gate that
// asks "is this a fresh variant construction?" must read them the same way; the
// qualified one going unrecognised left a struct literal's enum field retained
// as if it aliased, leaking one box per construction (#6681).
function variant_ctor_enum_owner(e: ast.Expr, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => { return variant_enum_owner(structs, id.name); },
                ast.ExprFieldAccess(cfa) => { return variant_enum_owner(structs, variant_ctor_qualified_name(cfa, structs)); },
                _ => { return ""; }
            }
        },
        ast.ExprIdent(id) => { return variant_enum_owner(structs, id.name); },
        ast.ExprFieldAccess(fa) => { return variant_enum_owner(structs, variant_ctor_qualified_name(fa, structs)); },
        _ => { return ""; }
    }
}

// variant_ctor_array_payloads_fresh: every leak-safe-array-typed payload arg of the
// variant ctor is a FRESH array LITERAL (so the constructed box solely owns each array).
function variant_ctor_array_payloads_fresh(e: ast.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var vname: string = "";
            match (c.callee) {
                ast.ExprIdent(id) => { vname = id.name; },
                ast.ExprFieldAccess(cfa) => { vname = variant_ctor_qualified_name(cfa, structs); },
                _ => {}
            }
            if (vname.len() == 0) { return false; }
            var n: i32 = decl_field_count(structs, vname);
            var i: i32 = 0;
            while (i < n && i < c.args.len()) {
                var ft: string = decl_field_type_at(structs, vname, i);
                if (is_leaksafe_array_field(ft)) {
                    var fresh: boolean = false;
                    match (c.args[i]) { ast.ExprArray(_) => { fresh = true; }, _ => {} }
                    if (!fresh) { return false; }
                }
                i = i + 1;
            }
            return true;
        },
        ast.ExprIdent(_) => { return true; },
        ast.ExprFieldAccess(fa) => { return variant_ctor_qualified_name(fa, structs).len() > 0; },
        _ => { return false; }
    }
}

// enum_only_wildcard_used_rec: every mention of `name` in `stmts` (recursively) is a SAFE
// use for the enum self-reassign deep-drop — its decl, a reassignment to a fresh
// `enum_name` variant ctor (no self-reference), or a match scrutinee whose arms bind no
// payload and never re-reference name. ANY other mention disqualifies (the payload could
// then be aliased/escape).
function enum_only_wildcard_used_rec(stmts: ast.Stmt[], name: string, enum_name: string, structs: parser.StructDecl[]): boolean {
    var none: string[] = [];
    for stmt in stmts {
        var st: ast.Stmt = stmt;
        if (util.index_of_str(astwalk.collect_idents_stmt(st, none), name) >= 0) {
            match (st) {
                ast.StmtVar(v) => {
                    if (v.name != name) { return false; }
                    if (parser.expr_mentions(v.init, name)) { return false; }
                },
                ast.StmtAssign(a) => {
                    if (a.target != name) { return false; }
                    if (parser.expr_mentions(a.value, name)) { return false; }
                    if (variant_ctor_enum_owner(a.value, structs) != enum_name) { return false; }
                    if (!variant_ctor_array_payloads_fresh(a.value, structs)) { return false; }
                },
                ast.StmtMatch(m) => {
                    var scrut_ok: boolean = false;
                    match (m.scrutinee) {
                        ast.ExprIdent(sid) => { if (sid.name == name) { scrut_ok = true; } },
                        _ => {}
                    }
                    if (!scrut_ok) { return false; }
                    for arm in m.arms {
                        match (arm.pattern) {
                            ast.PatVariant(pv) => {
                                // Compare against "" via explicitly-typed string locals
                                // rather than calling `.len()`: this function is itself a
                                // module in the self-host BOOTSTRAP, where each file is
                                // compiled STANDALONE (imported modules' struct decls are
                                // not loaded). So the `ast.PatVariant(pv)` match here
                                // does not lower. The AST emitter it once fell to had no
                                // PatVariant field info, mis-inferred the `string[]`-element
                                // receiver `pv.extra_bindings[ei]` as i32 and emitted an
                                // undefined `__fn_i32__len` (a link error). A typed `string` local +
                                // `!= ""` sidesteps the `.len()` dispatch entirely and
                                // compares as strings. (Typing the payload properly means
                                // lowering the qualified imported-union match through the
                                // IR path, which is blocked on the #3425 per-module-emit
                                // memory frontier — see the NOTE in lower_stmt's match
                                // handler and docs/RC-PERCEUS-SELF-HOST-PORT.md.)
                                var pvb: string = pv.binding;
                                if (pvb != "" && pvb != "_") { return false; }
                                var ei: i32 = 0;
                                while (ei < pv.extra_bindings.len()) {
                                    var eb: string = pv.extra_bindings[ei];
                                    if (eb != "" && eb != "_") { return false; }
                                    ei = ei + 1;
                                }
                            },
                            _ => {}
                        }
                        if (arm.has_guard && parser.expr_mentions(arm.guard, name)) { return false; }
                        var bi: i32 = 0;
                        while (bi < arm.body.len()) {
                            if (util.index_of_str(astwalk.collect_idents_stmt(arm.body[bi], none), name) >= 0) { return false; }
                            bi = bi + 1;
                        }
                    }
                },
                ast.StmtWhile(w) => {
                    if (parser.expr_mentions(w.cond, name)) { return false; }
                    if (!enum_only_wildcard_used_rec(w.body, name, enum_name, structs)) { return false; }
                },
                ast.StmtIf(f) => {
                    if (parser.expr_mentions(f.cond, name)) { return false; }
                    if (!enum_only_wildcard_used_rec(f.then_body, name, enum_name, structs)) { return false; }
                    if (!enum_only_wildcard_used_rec(f.else_body, name, enum_name, structs)) { return false; }
                },
                ast.StmtFor(fr) => {
                    if (parser.expr_mentions(fr.iter, name)) { return false; }
                    if (!enum_only_wildcard_used_rec(fr.body, name, enum_name, structs)) { return false; }
                },
                _ => { return false; }
            }
        }
    }
    return true;
}

// enum_reassign_reclaim_names: enum locals safe for the per-reassign deep-drop, credited
// "ENUMRE:<E>:<binding site>". Array-payload-only enum E, fresh array payloads, b IS reassigned
// (DISJOINT from the consume-by-match frees, which require NOT reassigned), and
// enum_only_wildcard_used_rec proves the payload is never aliased.
function enum_reassign_reclaim_names(body: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var out: string[] = acc;
    var reassigned: string[] = body_assign_targets(body);
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                var e0: string = variant_ctor_enum_owner(v.init, structs);
                if (e0.len() > 0 && enum_all_variants_array_payload(structs, e0)
                        && variant_ctor_array_payloads_fresh(v.init, structs)
                        && util.index_of_str(reassigned, v.name) >= 0
                        && enum_only_wildcard_used_rec(body, v.name, e0, structs)) {
                    out = out.append("ENUMRE:" + e0 + ":" + reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return out;
}

// slot_enum_reassign_reclaim: the enum E credited "ENUMRE:<E>:<binding site>" for
// a non-param slot, or "". Drives emit_enum_reclaim_store on the StmtAssign.
//
// Keyed on the binding SITE, not the name. Two same-named enum locals of
// DIFFERENT enums both mint a row, and this scan takes the first — after which
// emit_enum_variant_drops walks the wrong enum's variant layout over the box.
// The collector has no shadow-blanking rule to stop that, and the name would
// also answer differently for a block-scoped local, whose slot retire_locals
// renames before a replayed defer action reads it (#7253).
function slot_enum_reassign_reclaim(s: LowerState, i: i32): string {
    if (i < s.n_params) { return ""; }
    if (i >= s.locals.len()) { return ""; }
    var nm: string = s.reclaim_site_key(i);
    if (nm.len() == 0) { return ""; }
    var j: i32 = 0;
    while (j < s.reclaimable_names.len()) {
        var r: string = s.reclaimable_names[j];
        if (bytes_at(r, 0, "ENUMRE:")) {
            var k: i32 = 7;
            while (k < r.len() && r[k] != b':') { k = k + 1; }
            if (k < r.len() && k + 1 + nm.len() == r.len() && bytes_at(r, k + 1, nm)) {
                return slice_unchecked(r, 7, k) + "";
            }
        }
        j = j + 1;
    }
    return "";
}

// emit_enum_reclaim_store stores the NEW box (on the operand stack) into `slot`, first
// DEEP-DROPPING the superseded old box (payload arrays + box, runtime variant-dispatch
// via emit_enum_variant_drops, which reads the slot and zeroes it). NO cow guard: the
// reassign RHS is always a fresh variant ctor, so the new value never equals the old box.
// The new box is parked in a scratch across the drop (emit_enum_variant_drops touches only
// `slot`).
function emit_enum_reclaim_store(se: LowerState, slot: i32, enum_name: string): LowerState {
    var scratch: string = "$erea" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));        // park the new box
    st = emit_enum_variant_drops(st, slot, enum_name);   // deep-drop old payload + box, zeroes slot
    st = st.emit(ir.op_load_local(tmp));         // new box
    return st.emit(ir.op_store_local(slot));     // slot = new
}

// emit_enum_inplace_reassign lowers `b = V(args)` (b a reclaimable array-payload enum
// local, credited ENUMRE) as an IN-PLACE reuse of b's existing box — the native-parity
// optimisation over emit_enum_reclaim_store's free+alloc churn. It (1) releases b's OLD
// variant payload arrays via emit_enum_variant_payload_drops (box kept), (2) re-shapes
// the box to V (op_struct_set_shape, mirroring emit_enum_donor_reuse), and (3) writes V's
// fresh array-literal payloads into the SAME box (op_struct_set). The slot is untouched:
// b keeps pointing at its box, now the V variant, so the exit sweep still frees it once.
// SIZE-SAFE only under enum_all_variants_same_field_count (every variant's box is the
// same layout) — a ragged enum keeps the free+alloc path. Payloads are guaranteed FRESH
// array literals by the ENUMRE gate (variant_ctor_array_payloads_fresh), so the reused
// box solely owns each new array; b's payload is never aliased (enum_only_wildcard_used_rec),
// so releasing the old arrays is sound. Falls back to fail() on any non-`V(args)` shape.
function emit_enum_inplace_reassign(value: ast.Expr, slot: i32, enum_name: string, s: LowerState): LowerState {
    match (value) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(vid) => {
                    var vname: string = vid.name;
                    if (variant_enum_owner(s.structs, vname) != enum_name) { return s.fail(); }
                    if (decl_field_count(s.structs, vname) != c.args.len()) { return s.fail(); }
                    // 1. release b's old variant payload arrays (box kept).
                    var no_moved: string[] = [];
                    var st: LowerState = emit_enum_variant_payload_drops(s, slot, enum_name, no_moved);
                    // 2. re-shape the box to V.
                    st = st.emit(ir.op_load_local(slot));
                    st = st.emit(ir.op_struct_set_shape(vname));
                    st = st.emit(ir.op_drop());
                    // 3. write V's fresh payloads into the same box, in decl order.
                    var di: i32 = 0;
                    while (di < c.args.len()) {
                        if (struct_field_is_i64(st.structs, vname, di)) {
                            st = st.emit(ir.op_load_local(slot));
                            st = lower_i64(c.args[di], st);
                            if (!st.ok) { return st; }
                            st = st.emit(ir.op_struct_set_i64(di));
                        } else {
                            st = st.emit(ir.op_load_local(slot));
                            st = lower_expr(c.args[di], st);
                            if (!st.ok) { return st; }
                            st = st.emit(ir.op_struct_set(di, struct_field_width(st.structs, vname, di)));
                        }
                        di = di + 1;
                    }
                    // slot already holds the (reused) box — no store needed.
                    return st;
                },
                _ => { return s.fail(); }
            }
        },
        _ => { return s.fail(); }
    }
}

// --- consumed RC-PAYLOAD option/result deep-drop free -----------------------
//
// The Option/Result analogue of consumed_rcpayload_enum_frees. The scalar
// Option/Result free (consumed_scalar_enum_frees via fresh_scalar_option_init)
// only admits a SCALAR payload — a `var o = Some([1,2,3])` / `var r = Ok([..])`
// with a leak-safe scalar-ARRAY payload still leaked both the box AND its array.
// This widens the consume-by-match free to those: the constructed variant is
// statically known, so the box's payload (offset 8 / 4 via op_opt_payload) is a
// flat rc-headered scalar buffer a single __fern_rc_dec fully releases, then the
// box itself is freed. DISJOINT from the scalar option set (that admits only
// scalar payloads; this only array payloads), so an option is freed by at most
// one path — never double-freed.

// OptRcCand: a candidate rc-payload option — the constructed variant ("Some"/"Ok"/
// "Err") and the payload TYPE (an array type like "i32[]", or a struct type like
// "P"). An empty `variant` means "not admitted".
struct OptRcCand { variant: string, ptype: string }

// rcpayload_option_cand: `v` binds a FRESH single-owner Option/Result local whose
// CONSTRUCTED variant carries an rc payload a bounded deep-drop fully releases —
// `var o = Some([..])` / `Ok([..])` / `Err([..])` (leak-safe scalar ARRAY), or
// `Some(P{..})` / `Ok(P{..})` (a FRESH leak-safe STRUCT literal — scalar-only or
// array-field-bearing). Returns the variant + payload type, or an empty variant.
//   - ARRAY payload: a flat rc-headered scalar buffer (i32[]/boolean[]/i64[]/f64[]/
//     u32[]/subword — is_leaksafe_array_field) a single __fern_rc_dec releases with
//     no inner walk. Admitted by annotation (opt_payload_type, variant-aware: T for
//     Some/Ok, E for Err) or a fresh scalar-number array literal (`Some([1,2,3])`).
//   - STRUCT payload: a FRESH struct LITERAL (`Some(P{..})`) whose struct is
//     leak-safe and either scalar-only (shallow box free) or deep-drop-ok (array
//     fields released via __struct_drop_<P> then box free). The fresh-literal rule
//     makes the payload box the sole owner (rc==1) — a bare-ident struct payload
//     aliasing a swept local is rejected (it would double-free), mirroring the enum
//     path's variant_struct_payloads_fresh gate.
// An un-annotated Ok/Err isn't native-valid (Result's other param stays free), so
// only annotated Results fire; None / a non-fresh / a non-leak-safe payload aren't
// admitted.
// opt_arg_is_some_ctor is opt_arg_is_direct_ctor narrowed to a SUCCESS
// construction carrying a payload — `Some(x)` / `Ok(x)`, never `None`. The
// nested rc drop reads the inner box at offset 8 unconditionally, so a `None`
// inner would hand it a payload that was never stored.
function opt_arg_is_some_ctor(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1) { return false; }
            match (c.callee) {
                ast.ExprIdent(id) => { return id.name == "Some" || id.name == "Ok"; },
                ast.ExprFieldAccess(fa) => { return fa.field == "Some" || fa.field == "Ok"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// opt_arg_is_direct_ctor reports whether `e` CONSTRUCTS a built-in tagged union
// here — a bare or qualified `Some(x)` / `Ok(x)` / `Err(x)` / `None` — rather
// than merely having that type. Construction is what makes the box fresh and
// sole-owned; a bare ident of the same type aliases a local whose own reclaim
// would free it a second time.
function opt_arg_is_direct_ctor(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1) { return false; }
            match (c.callee) {
                ast.ExprIdent(id) => { return id.name == "Some" || id.name == "Ok" || id.name == "Err"; },
                ast.ExprFieldAccess(fa) => { return fa.field == "Some" || fa.field == "Ok" || fa.field == "Err"; },
                _ => { return false; }
            }
        },
        ast.ExprIdent(id) => { return id.name == "None"; },
        ast.ExprFieldAccess(fa) => { return fa.field == "None"; },
        _ => { return false; }
    }
    return false;
}

function rcpayload_option_cand(v: ast.StmtVar, structs: parser.StructDecl[]): OptRcCand {
    var kind: string = "";
    var arg0: ast.Expr = v.init;
    var has_arg: boolean = false;
    match (v.init) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    if (id.name == "Some" || id.name == "Ok" || id.name == "Err") { kind = id.name; }
                },
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "Some" || fa.field == "Ok" || fa.field == "Err") { kind = fa.field; }
                },
                _ => {}
            }
            if (c.args.len() == 1) { arg0 = c.args[0]; has_arg = true; }
        },
        _ => {}
    }
    if (kind == "" || !has_arg) { return OptRcCand { variant: "", ptype: "" }; }
    // Annotated array payload.
    var pt: string = opt_payload_type(v.type_name, kind);
    if (is_leaksafe_array_field(pt)) { return OptRcCand { variant: kind, ptype: pt }; }
    // Annotated NESTED UNION payload whose own payload is SCALAR in every arm
    // (#7218) — a
    // `var o: Option[Option[i32]] = Some(Some(i))` / `Some(None)` /
    // `Some(Ok(i))` of `Option[Result[i32, i32]]`. The box at
    // offset 8 is another rc-headered box holding a by-value scalar and nothing
    // else, so one __fern_rc_dec releases it whole with no inner walk, exactly
    // as is_leaksafe_array_field buys for a flat buffer — and exactly what
    // opt_payload_freefn already answers for this ptype.
    //
    // Admitted only for a DIRECT inner construction: `Some(inner)` off a live
    // local aliases a box that local's own scalar-Option reclaim already frees,
    // and this drop would be the second.
    if (type_is_scalar_union(pt) && opt_arg_is_direct_ctor(arg0)) {
        return OptRcCand { variant: kind, ptype: pt };
    }
    // The rc-INNER sibling: `Option[Option[i32[]]]` / `Option[Option[string]]`,
    // whose inner box owns a payload of its own. Released two levels deep by
    // emit_optopt_rc_deep_free, whose tag guard is what admits `Some(None)` here
    // (#7718): the release this used to take read offset 8 unconditionally, so a
    // None inner would have handed the free fn whatever that word held, and the
    // gate excluded it for that reason rather than because the box needs no
    // release — it leaked both boxes instead. A live local is still refused: its
    // own reclaim already frees the box this drop would.
    if (nested_opt_inner_freefn(pt) != "" && opt_arg_is_direct_ctor(arg0)) {
        return OptRcCand { variant: kind, ptype: pt };
    }
    // Annotated STRING payload (#4355) — admitted only when FRESH: a literal
    // (const_str allocs a fresh box per construction; its .rodata data is
    // heap-guard-skipped by __fern_str_free) or a fresh producer (concat / named
    // producer / string-method copy). A bare ident / field read / general call
    // would alias a live box the match-site __fern_str_free frees out from under
    // it — rejected, keeping today's sound leak.
    if (pt == "string") {
        var sfresh: boolean = false;
        match (arg0) {
            ast.ExprString(_) => { sfresh = true; },
            _ => { sfresh = str_local_binding_is_fresh(arg0); }
        }
        if (sfresh) { return OptRcCand { variant: kind, ptype: "string" }; }
        return OptRcCand { variant: "", ptype: "" };
    }
    // Annotated STRING[] payload (#6495) — the per-ELEMENT sibling of the
    // `string` case above. is_leaksafe_array_field refuses `string[]` because a
    // single __fern_rc_dec leaves every element box behind, which is exactly
    // what left this shape at frees=0; __fern_str_arr_free is the release that
    // walks them, and it already exists for the string[] LOCAL sweep. Admitted
    // only for a literal whose every element is fresh, so the array and each
    // element box are sole-owned.
    if (pt == "string[]") {
        match (arg0) {
            ast.ExprArray(sarr) => {
                if (all_fresh_string_elems(sarr.elements)) { return OptRcCand { variant: kind, ptype: "string[]" }; }
            },
            _ => {}
        }
        return OptRcCand { variant: "", ptype: "" };
    }
    // Un-annotated array literal (Option infers its single param) — the exact
    // element type is immaterial to a shallow buffer dec, so tag it i32[]/f64[].
    match (arg0) {
        ast.ExprArray(arrl) => {
            if (all_i32_number_elems(arrl.elements)) { return OptRcCand { variant: kind, ptype: "i32[]" }; }
            if (all_f64_number_elems(arrl.elements)) { return OptRcCand { variant: kind, ptype: "f64[]" }; }
            if (all_fresh_string_elems(arrl.elements)) { return OptRcCand { variant: kind, ptype: "string[]" }; }
        },
        // Un-annotated STRING literal payload (`var o = Some("x")`) — unambiguous
        // by shape (a fresh box per construction), unlike a bare `a + b` producer
        // whose un-annotated form could be an int add. #4355.
        ast.ExprString(_) => { return OptRcCand { variant: kind, ptype: "string" }; },
        // FRESH leak-safe struct literal payload — sole owner (rc==1). The two
        // admitted shapes need DIFFERENT frees, which is what opt_payload_deep_sty
        // decides: a scalar-only struct box holds only inline scalars, so the
        // shallow __fern_rc_dec of emit_opt_payload_drop is complete; a struct with
        // rc-ARRAY fields needs __struct_drop_<T> first (emit_opt_struct_payload_drop),
        // because the construction alias-incs those fields and nothing else releases
        // them — the drop zeroes the slot, so the exit sweep's own deep free never
        // runs. This comment used to claim the opposite (that a deep drop here would
        // over-release, the fields being reclaimed by "surrounding machinery"); that
        // was measured false in #6127 — the field buffer leaked once per bind, and the
        // REBOUND sibling has deep-dropped the same shape since #6252 without an
        // underflow. The literal's own type_name names the struct.
        // The third disjunct is a DIRECT `string[]` field (#6127). nddo_reach
        // credits an rc-array, a struct/enum-array, a nested struct and a bare
        // `string` — but not a `string[]` — so `P { xs: string[], n: i32 }` reached
        // neither of the first two and the candidate was refused outright: 500
        // allocs and ZERO frees over 100 rounds, where the same struct bound as a
        // BARE local is flat at 0. Adding an i32[] beside the string[] already
        // admits the identical type and reclaims BOTH arrays (600/600, with
        // __struct_drop_P emitted), so the drop side was complete and only the
        // admission was short.
        //
        // It reuses struct_has_strarr_field rather than adding an arm to
        // nddo_reach, because that function also decides deep-vs-shallow for
        // NESTED-STRUCT fields in all three backends' __struct_drop emission — the
        // surface #6148's use-after-free came from — and only the Option-payload
        // admission should move. Whether the deep drop actually fires is still
        // decided at EMIT time by struct_routes_field_reclaim, whose strarrfld
        // verdict is whole-program: if it refuses the type, emit_struct_field_drops
        // emits nothing and the payload box plus the option box are still freed.
        ast.ExprStructLit(slit) => {
            var sty: string = slit.type_name;
            if (!slit.has_base && decl_is_struct(structs, sty) && decl_is_leaksafe(structs, sty)
                && (struct_is_scalar_only(structs, sty) || nested_field_deep_drop_ok(structs, sty)
                    || struct_has_strarr_field(structs, sty))) {
                return OptRcCand { variant: kind, ptype: sty };
            }
        },
        _ => {}
    }
    return OptRcCand { variant: "", ptype: "" };
}

// opt_body_binds_rc_payload: does any match on `name` in `stmts` bind its rc
// payload to a name that ESCAPES the arm? The Option sibling of
// enum_body_binds_rc_payload, and the fourth condition
// opt_match_alias_escape_ok needs.
//
// body_unsafe_for_match_borrow reads `match (x)` as a borrow, which is true of
// the BOX and false of the PAYLOAD: `match (x) { Some(xs) => { out = xs; } }`
// carries the element out of the frame, and the source's consuming-match free
// then releases a buffer `out` still holds. Measured as __rc_underflow_count()
// firing (exit 99) while both oracles exit 68 — and the leak checker cannot see
// it, because the over-releasing build's census BALANCES.
//
// "Ok|Some" is the spelling for a caller that does not know the constructed
// variant; naming one spelling on a runtime-variant box silently checks
// nothing. scrut_borrow is false: nothing here proves a nested scrutinee is a
// borrow, and over-refusing costs a leak while under-refusing dangles.
function opt_body_binds_rc_payload(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var hit: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { if (sid.name == name) { hit = true; } },
                    _ => {}
                }
                if (hit && opt_arm_binding_escapes(stmt, "Ok|Some", false)) { return true; }
                for arm in m.arms { if (opt_body_binds_rc_payload(arm.body, name)) { return true; } }
            },
            ast.StmtIf(f) => {
                if (opt_body_binds_rc_payload(f.then_body, name)) { return true; }
                if (opt_body_binds_rc_payload(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (opt_body_binds_rc_payload(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (opt_body_binds_rc_payload(fo.body, name)) { return true; } },
            ast.StmtDefer(d) => { if (opt_body_binds_rc_payload([d.action], name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// opt_arm_binding_escapes: for the consuming match `st` of an rc-payload option
// whose constructed variant is `variant` (Some/Ok/Err), does that variant's arm
// BIND its array payload to a name that ESCAPES the arm (stored / returned /
// passed / aliased)? A borrow-only binding (indexing, `.len()`, arithmetic over
// reads) is admitted — the box is deep-dropped AFTER the whole match runs, so a
// borrow whose last use is inside the arm is sound. Reuses binding_escapes_arm
// (the enum path's borrow-only gate, empty borrowable registry). Only the named
// variant's arm is checked: the box always holds that variant's payload, so the
// sibling arm never runs and binds nothing we free.
//
// Arms are matched by SPELLING, so a caller that does NOT know the constructed
// variant passes `variant = "Ok|Some"` to check whichever of the two the SUCCESS
// arm is written as. Naming one spelling on a runtime-variant box silently checks
// NOTHING — `"Ok"` never matches a `Some(s)` arm — while reading as if it ran.
// Checking every arm instead over-refuses: a scalar `Err(e)` binding used in
// arithmetic is not a payload this drop can release.
function opt_arm_binding_escapes(st: ast.Stmt, variant: string, scrut_borrow: boolean): boolean {
    var none: string[] = [];
    match (st) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        // strip a qualified `Option.Some` to the bare variant name.
                        var vname: string = pv.type_name;
                        var vc: i32 = 0;
                        while (vc < pv.type_name.len()) {
                            if (pv.type_name[vc] == b'.') { vname = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; }
                            vc = vc + 1;
                        }
                        var is_target: boolean = vname == variant;
                        if (variant == "Ok|Some") { is_target = vname == "Ok" || vname == "Some"; }
                        if (is_target && pv.binding != "" && pv.binding != "_") {
                            if (scrut_borrow) {
                                if (binding_escapes_arm_scrut(arm, pv.binding)) { return true; }
                            } else if (binding_escapes_arm(arm, pv.binding, none)) { return true; }
                        }
                    },
                    _ => {}
                }
            }
            return false;
        },
        _ => { return false; }
    }
}

// nested_opt_payload_arm_escapes: the second half of the rc-INNER proof. The
// outer arm binds the INNER Option box, and binding_escapes_arm_scrut admits a
// `match (inner)` there — but says nothing about what that nested match itself
// BINDS. For an rc inner payload that binding is a POINTER which can outlive its
// arm, where a scalar one is a copy that cannot; the two-level drop would then
// free a buffer the escapee still names.
//
// Reuses opt_body_binding_escapes on the arm body with the PLAIN reading, so a
// doubly-nested option is refused rather than admitted by recursion. Option only
// — nested_opt_inner_freefn admits no Result inner, so "Some" is the only
// success spelling that can reach here.
function nested_opt_payload_arm_escapes(st: ast.Stmt, variant: string): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        // strip a qualified `Option.Some` to the bare variant name.
                        var vname: string = pv.type_name;
                        var vc: i32 = 0;
                        while (vc < pv.type_name.len()) {
                            if (pv.type_name[vc] == b'.') { vname = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; }
                            vc = vc + 1;
                        }
                        if (vname == variant && pv.binding != "" && pv.binding != "_") {
                            if (opt_body_binding_escapes(arm.body, pv.binding, "Some", false)) { return true; }
                        }
                    },
                    _ => {}
                }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// opt_body_binding_escapes: recursively scan `stmts` (through nested if/while/for/
// match blocks) for a `match (name)` whose constructed-variant (`variant`) arm binds
// its payload to a name that ESCAPES the arm. Used by the rc-payload OPTION precise-
// drop path, where the consuming match sits in a NESTED block (an if-body) rather
// than at function top level — opt_arm_binding_escapes only inspects one match, so
// this lifts it over the whole body. A true result rejects the precise-drop
// candidate (its payload could be aliased past the box free).
function opt_body_binding_escapes(stmts: ast.Stmt[], name: string, variant: string, scrut_borrow: boolean): boolean {
    for stmt in stmts {
        if (opt_stmt_binding_escapes(stmt, name, variant, scrut_borrow)) { return true; }
    }
    return false;
}
function opt_stmt_binding_escapes(st: ast.Stmt, name: string, variant: string, scrut_borrow: boolean): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            match (m.scrutinee) {
                ast.ExprIdent(id) => {
                    if (id.name == name && opt_arm_binding_escapes(st, variant, scrut_borrow)) { return true; }
                },
                _ => {}
            }
            for arm in m.arms {
                if (opt_body_binding_escapes(arm.body, name, variant, scrut_borrow)) { return true; }
            }
            return false;
        },
        ast.StmtIf(iff) => {
            return opt_body_binding_escapes(iff.then_body, name, variant, scrut_borrow)
                || opt_body_binding_escapes(iff.else_body, name, variant, scrut_borrow);
        },
        ast.StmtWhile(w) => { return opt_body_binding_escapes(w.body, name, variant, scrut_borrow); },
        ast.StmtFor(f) => { return opt_body_binding_escapes(f.body, name, variant, scrut_borrow); },
        _ => { return false; }
    }
}

// ── The arm binding may MOVE a field out, and only the DEEP drop cares (#6127) ──
//
// `binding_escapes_arm` proves the arm does not let the payload STRUCT BOX
// outlive the match, which is all the shallow box dec needs. The deep drop frees
// the box's rc FIELDS as well, so it needs the stronger property: no field of the
// binding is extracted whole. `match (o) { Some(p) => { held = p.xs; } … }` passes
// the box-level gate — `p` itself never escapes — while handing `held` the buffer
// the deep drop would free, a use-after-free the freelist happily hides.
//
// So this walker gates ONLY the deep-drop upgrade: a moved field downgrades the
// drop back to the shallow box dec (today's sound leak), it never withdraws the
// candidate. Same borrow vocabulary as rctuple_esc_expr, rooted one level up at a
// bare local's field (`name.<f>`) instead of a tuple element (`name.<i>`).
// SAFE: a scalar field read `name.<f>` (value copy), an indexed array-field read
// `name.<f>[j]`, and `name.<f>.len()`. ESCAPES: a bare `name`, and a bare
// non-scalar field `name.<f>`. Erring toward escape leaks; erring the other way
// dangles, so unknown shapes fall to the generic recursion and escape.
// optstruct_chain_leaf_type: the field TYPE `e` reads when it is a pure field-
// access CHAIN rooted at the bare local `name` of struct type `sty` —
// `name.<f>` gives f's type, `name.<f>.<g>` gives g's type (f borrowed as the
// receiver), to any depth. Returns "" when `e` is not such a chain, and "?" when
// it IS one but a link could not be resolved (an unknown field, or a non-struct
// intermediate), which the caller must treat as an escape.
//
// The one-level version of this refused `p.inner.ys.len()`: the chain fell
// through to the generic call tail, which reached the bare-ident arm through
// `p.inner` and reported the non-scalar field `inner` extracted. Reaching `ys`
// THROUGH `inner` retains only ys's box, so `inner` is borrowed — the same
// distinction structfld_safe_operand draws for the whole-program scan, and the
// reason that scan could not reuse the string walker either (#6274).
function optstruct_chain_leaf_type(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name != name) { return ""; }
                    var t0: string = decl_field_type(structs, sty, fa.field);
                    if (t0.len() == 0) { return "?"; }
                    return t0;
                },
                _ => {
                    var mid: string = optstruct_chain_leaf_type(fa.obj, name, sty, structs);
                    if (mid.len() == 0) { return ""; }
                    if (mid == "?") { return "?"; }
                    if (!decl_is_struct(structs, mid)) { return "?"; }
                    var t1: string = decl_field_type(structs, mid, fa.field);
                    if (t1.len() == 0) { return "?"; }
                    return t1;
                }
            }
        },
        _ => { return ""; }
    }
}

function optstruct_bind_esc_expr(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },   // bare payload box escapes
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprFieldAccess(fa) => {
            var lt: string = optstruct_chain_leaf_type(e, name, sty, structs);
            if (lt.len() > 0) {
                if (is_scalar_type_name(lt)) { return false; }   // scalar field copy
                return true;                                     // rc field extracted bare
            }
            return optstruct_bind_esc_expr(fa.obj, name, sty, structs);
        },
        ast.ExprIndex(ix) => {
            // name.<f>[j] / name.<f>.<g>[j] : indexed array-field read — safe; check
            // the index. An UNRESOLVED chain ("?") is an escape, not a borrow.
            var at: string = optstruct_chain_leaf_type(ix.array, name, sty, structs);
            if (at == "?") { return true; }
            if (at.len() > 0) { return optstruct_bind_esc_expr(ix.index, name, sty, structs); }
            match (ix.array) {
                ast.ExprIdent(aid) => { if (aid.name == name) { return true; } },
                _ => {}
            }
            return optstruct_bind_esc_expr(ix.array, name, sty, structs) || optstruct_bind_esc_expr(ix.index, name, sty, structs);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    // name.<f>.len() / name.<f>.<g>.len() : length borrow — safe
                    // receiver, check args. An unresolved chain is an escape.
                    var rt: string = optstruct_chain_leaf_type(cfa.obj, name, sty, structs);
                    if (cfa.field == "len" && rt == "?") { return true; }
                    if (cfa.field == "len" && rt.len() > 0) {
                        for arg in c.args { if (optstruct_bind_esc_expr(arg, name, sty, structs)) { return true; } }
                        return false;
                    }
                },
                _ => {}
            }
            if (optstruct_bind_esc_expr(c.callee, name, sty, structs)) { return true; }
            for arg in c.args { if (optstruct_bind_esc_expr(arg, name, sty, structs)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return optstruct_bind_esc_expr(b.left, name, sty, structs) || optstruct_bind_esc_expr(b.right, name, sty, structs); },
        ast.ExprUnary(u) => { return optstruct_bind_esc_expr(u.operand, name, sty, structs); },
        ast.ExprSlice(sl) => { return optstruct_bind_esc_expr(sl.array, name, sty, structs) || optstruct_bind_esc_expr(sl.start, name, sty, structs) || optstruct_bind_esc_expr(sl.end, name, sty, structs); },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { if (optstruct_bind_esc_expr(ar.elements[i], name, sty, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (optstruct_bind_esc_expr(el, name, sty, structs)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && optstruct_bind_esc_expr(sl.base, name, sty, structs)) { return true; }
            for fv in sl.field_values { if (optstruct_bind_esc_expr(fv, name, sty, structs)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
    return false;
}
function optstruct_bind_esc_stmt(st: ast.Stmt, name: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return optstruct_bind_esc_expr(v.init, name, sty, structs); },
        ast.StmtReturn(r) => { return optstruct_bind_esc_expr(r.value, name, sty, structs); },
        ast.StmtExpr(e) => { return optstruct_bind_esc_expr(e.value, name, sty, structs); },
        ast.StmtAssign(a) => { return optstruct_bind_esc_expr(a.value, name, sty, structs); },
        ast.StmtIf(f) => {
            if (optstruct_bind_esc_expr(f.cond, name, sty, structs)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (optstruct_bind_esc_stmt(f.then_body[ti], name, sty, structs)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (optstruct_bind_esc_stmt(f.else_body[ei], name, sty, structs)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (optstruct_bind_esc_expr(w.cond, name, sty, structs)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (optstruct_bind_esc_stmt(w.body[i], name, sty, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (optstruct_bind_esc_expr(fo.iter, name, sty, structs)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (optstruct_bind_esc_stmt(fo.body[i], name, sty, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (optstruct_bind_esc_expr(m.scrutinee, name, sty, structs)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && optstruct_bind_esc_expr(arm.guard, name, sty, structs)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (optstruct_bind_esc_stmt(arm.body[bi], name, sty, structs)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return optstruct_bind_esc_stmt(d.action, name, sty, structs); },
        _ => { return false; }
    }
    return false;
}

// declared_struct_type_of: the DECLARED struct type of local `name` — the type
// fresh_struct_lit_type_deep cannot supply, because it reads the type off a struct
// LITERAL init and the shapes that matter here are bound from a CALL
// (`var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, ..)`). Resolves the
// qualified spelling too: `a.B` is tried as written, then as the mangled `a__B`,
// then as the bare tail `B`. "" when the name is not a struct-annotated local.
function declared_struct_type_of(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name && v.type_name.len() > 0) {
                    if (decl_is_struct(structs, v.type_name)) { return v.type_name; }
                    var dot: i32 = 0 - 1;
                    var c: i32 = 0;
                    while (c < v.type_name.len()) {
                        if (v.type_name[c] == b'.') { dot = c; }
                        c = c + 1;
                    }
                    if (dot > 0) {
                        var head: string = slice_unchecked(v.type_name, 0, dot) + "";
                        var tail: string = slice_unchecked(v.type_name, dot + 1, v.type_name.len()) + "";
                        var mangled: string = head + "__" + tail;
                        if (decl_is_struct(structs, mangled)) { return mangled; }
                        if (decl_is_struct(structs, tail)) { return tail; }
                    }
                }
            },
            ast.StmtIf(f) => {
                var t1: string = declared_struct_type_of(f.then_body, name, structs);
                if (t1 != "") { return t1; }
                var t2: string = declared_struct_type_of(f.else_body, name, structs);
                if (t2 != "") { return t2; }
            },
            ast.StmtWhile(w) => { var t: string = declared_struct_type_of(w.body, name, structs); if (t != "") { return t; } },
            ast.StmtFor(fo) => { var t: string = declared_struct_type_of(fo.body, name, structs); if (t != "") { return t; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { var t: string = declared_struct_type_of(arm.body, name, structs); if (t != "") { return t; } }
            },
            _ => {}
        }
    }
    return "";
}

// --- fieldmove: which POSITIONS actually move a field out (#6127) -----------
//
// The "NODEEP:" marker needs to know when a local's NON-SCALAR field is handed to
// something longer-lived — `var lo: StringLitOut = add_string_lit(s, ..); s =
// lo.state;`, where the deep drop would then free that EmitState's arrays out
// from under the live `s`.
//
// This is deliberately a POSITIVE list of move positions, not a general escape
// walker with borrow exemptions. The first cut reused optstruct_bind_esc_expr
// (#6336), which reports every bare non-scalar field read and admits a whitelist
// of borrows — and that polarity is wrong for a WHOLE-FUNCTION scan: it fired on
// `match (t.e)` (withholding #4357's per-iteration struct-enum reclaim, an 80
// bytes/iteration leak) and on `h.f(10)` (withholding the k_clo drop for every
// called fn-field struct), and each fix added another exemption. The borrow
// positions are open-ended; the MOVE positions are not.
//
// A move is a chain rooted at `name` whose leaf field is non-scalar, appearing as
// the WHOLE value of a bind / assign / return, as a direct call ARGUMENT, or as a
// container element. Every other position — a match scrutinee, a call callee, an
// index base, a `.len()` receiver, an operand — reads through and is a borrow.
function fieldmove_is_move_value(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    var lt: string = optstruct_chain_leaf_type(e, name, sty, structs);
    if (lt.len() == 0) { return false; }
    if (lt == "?") { return true; }              // unresolved chain — assume the worst
    return !is_scalar_type_name(lt);
}

// fieldmove_expr: the move positions reachable inside an expression — a call
// argument the callee may retain, or an element of an array / tuple / struct
// literal (including a functional-update base, which copies every field pointer
// into the new box).
//
// A BORROWABLE param position is not a move: `borrowable_params_of` admits a
// param only when the callee provably never returns, stores, slices or captures
// it, so `f(o.inner)` there leaves the field owned by `o` alone and the deep
// drop stays sound. Same registry and same Level-2 rule expr_unsafe_for already
// applies to a bare-ident argument — which it trusts for caller-side FREES, a
// strictly stronger action than keeping a deep drop. Without it a single
// `tag(o.v)` cost the local its whole reclaim credit, so every superseded box
// AND its array buffers leaked per iteration, where native is flat (#6691).
function fieldmove_expr(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            // Free calls only: method-param borrowability is not in the
            // (free-function-keyed) registry, so a method arg keeps marking.
            var callee_name: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => { callee_name = cid.name; },
                _ => {}
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                if (callee_name.len() == 0 || !param_is_borrowable(borrowable, callee_name, ai)) {
                    if (fieldmove_is_move_value(c.args[ai], name, sty, structs, borrowable)) { return true; }
                }
                if (fieldmove_expr(c.args[ai], name, sty, structs, borrowable)) { return true; }
                ai = ai + 1;
            }
            return fieldmove_expr(c.callee, name, sty, structs, borrowable);
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (fieldmove_is_move_value(a.elements[i], name, sty, structs, borrowable)) { return true; }
                if (fieldmove_expr(a.elements[i], name, sty, structs, borrowable)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements {
                if (fieldmove_is_move_value(el, name, sty, structs, borrowable)) { return true; }
                if (fieldmove_expr(el, name, sty, structs, borrowable)) { return true; }
            }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) {
                if (fieldmove_is_move_value(sl.base, name, sty, structs, borrowable)) { return true; }
                if (fieldmove_expr(sl.base, name, sty, structs, borrowable)) { return true; }
            }
            for fv in sl.field_values {
                // A `name.<f>` value of a kind whose construction retain is
                // GUARANTEED (fieldmove_counted_field_alias's list — nested
                // struct, enum, leak-safe scalar array, struct array) is a
                // COUNTED share: the literal incs it, so the source keeps its
                // deep drop and both decs balance. Marking it a move withheld
                // the source's drop while the retained claim stood — the arr
                // buffer leaked at rc 1 (the construction-retain matrix's
                // fieldread column, i32[]/struct/struct[] flavors). Call args
                // and returns keep marking: no retain is guaranteed there.
                if (!fieldmove_counted_field_alias(fv, name, sty, structs)
                    && fieldmove_is_move_value(fv, name, sty, structs, borrowable)) { return true; }
                if (fieldmove_expr(fv, name, sty, structs, borrowable)) { return true; }
            }
            return false;
        },
        ast.ExprBinary(b) => { return fieldmove_expr(b.left, name, sty, structs, borrowable) || fieldmove_expr(b.right, name, sty, structs, borrowable); },
        ast.ExprUnary(u) => { return fieldmove_expr(u.operand, name, sty, structs, borrowable); },
        ast.ExprIndex(ix) => { return fieldmove_expr(ix.array, name, sty, structs, borrowable) || fieldmove_expr(ix.index, name, sty, structs, borrowable); },
        ast.ExprSlice(sl2) => { return fieldmove_expr(sl2.array, name, sty, structs, borrowable) || fieldmove_expr(sl2.start, name, sty, structs, borrowable) || fieldmove_expr(sl2.end, name, sty, structs, borrowable); },
        ast.ExprFieldAccess(fa) => { return fieldmove_expr(fa.obj, name, sty, structs, borrowable); },
        _ => { return false; }
    }
    return false;
}

// fieldmove_counted_field_alias: `e` is exactly `name.<f>`, where f is a field
// whose struct-literal retain is GUARANTEED — so a read of it into ANY struct
// literal is a COUNTED share: the literal incs the value, the source keeps its
// deep drop, and both decs balance against the one inc. Treating such a read
// as a move costs `name` its whole reclaim credit (#6623) — and, generalized
// past the self-rebind (`name = T { …, f: name.f, … }`) to every literal
// position, withheld the SOURCE's drop while the retained claim stood, so the
// shared buffer leaked at rc 1 (the construction-retain matrix's fieldread
// column). Call-arg and return positions keep marking: no retain is
// guaranteed there.
//
// Three field kinds qualify, each because its arm of the override path incs a field
// READ with no further condition:
//
//   - a nested-struct or enum field, whose arms inc anything that is not a fresh
//     literal / ctor — which a field read never is;
//   - a scalar-element or array-of-struct field, whose ExprFieldAccess arm incs on
//     `field_access_arr_field_type` resolving. It cannot silently decline: an
//     unresolved receiver leaves `fav_ok` false and BAILS the whole lowering rather
//     than emitting an uncounted store, so there is no third outcome to guard (#6628).
//
// STRING and `string[]` fields stay marked (the retain is gated on slit_reclaim plus
// a freshness test), and so does an array-of-ENUM field: `Ty[]` enters neither array
// gate, and the fallback retain below them admits only a bare IDENT, so a field read
// there really can reach the successor box uncounted.
function fieldmove_counted_field_alias(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name != name) { return false; }
                    var ft: string = decl_field_type(structs, sty, fa.field);
                    return decl_is_struct(structs, ft) || decl_is_enum(structs, ft)
                        || is_leaksafe_array_field(ft) || is_struct_array_field_type(structs, ft);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// fieldmove_counted_arr_return: `e` is exactly `name.<f>` where f is one of the
// rc-ARRAY field kinds StmtReturn hands back WITH the return-transfer dup
// (arrown_ret_type). The escape is therefore COUNTED, and every arm that
// reclaims such a field is rc-guarded — `__fern_arr_dec` and
// `__fern_str_arr_free` both dec a shared buffer instead of freeing it — so the
// deep drop cannot take the buffer out from under the caller.
//
// Marking it a move costs `name` its whole reclaim credit, which is all-or-
// nothing: one field-returning method left every rc field of the struct
// stranded, including fields that method never names (#7259).
function fieldmove_counted_arr_return(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name != name) { return false; }
                    return arrown_ret_type(structs, decl_field_type(structs, sty, fa.field));
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function fieldmove_stmt(st: ast.Stmt, name: string, sty: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    match (st) {
        // A direct `var t = x.f` init is a BORROW, not a move — the same split
        // structfld_collect_unsafe_stmts (#6274) already draws for the whole-program
        // scan, and for the same reason: the fresh binding dies with the scope, while
        // a REASSIGN `t = x.f` hands the field to a name that outlives it. That is
        // exactly the `s = lo.state` hazard, and dropping this case is what keeps
        // `var xs = r.hs; xs[1]()` deep-drop-worthy.
        ast.StmtVar(v) => { return fieldmove_expr(v.init, name, sty, structs, borrowable); },
        ast.StmtAssign(a) => {
            // The self-rebind literal keeps its retained field aliases (see
            // fieldmove_counted_field_alias); every other value in it still marks.
            if (a.target == name) {
                match (a.value) {
                    ast.ExprStructLit(asl) => {
                        if (asl.has_base) {
                            if (fieldmove_is_move_value(asl.base, name, sty, structs, borrowable)) { return true; }
                            if (fieldmove_expr(asl.base, name, sty, structs, borrowable)) { return true; }
                        }
                        var fi: i32 = 0;
                        while (fi < asl.field_values.len()) {
                            if (!fieldmove_counted_field_alias(asl.field_values[fi], name, sty, structs)
                                && fieldmove_is_move_value(asl.field_values[fi], name, sty, structs, borrowable)) { return true; }
                            if (fieldmove_expr(asl.field_values[fi], name, sty, structs, borrowable)) { return true; }
                            fi = fi + 1;
                        }
                        return false;
                    },
                    _ => {}
                }
            }
            return fieldmove_is_move_value(a.value, name, sty, structs, borrowable) || fieldmove_expr(a.value, name, sty, structs, borrowable);
        },
        ast.StmtReturn(r) => {
            if (fieldmove_counted_arr_return(r.value, name, sty, structs)) { return false; }
            return fieldmove_is_move_value(r.value, name, sty, structs, borrowable) || fieldmove_expr(r.value, name, sty, structs, borrowable);
        },
        ast.StmtExpr(e) => { return fieldmove_expr(e.value, name, sty, structs, borrowable); },
        ast.StmtIf(f) => {
            if (fieldmove_expr(f.cond, name, sty, structs, borrowable)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (fieldmove_stmt(f.then_body[ti], name, sty, structs, borrowable)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (fieldmove_stmt(f.else_body[ei], name, sty, structs, borrowable)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (fieldmove_expr(w.cond, name, sty, structs, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (fieldmove_stmt(w.body[i], name, sty, structs, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (fieldmove_expr(fo.iter, name, sty, structs, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (fieldmove_stmt(fo.body[i], name, sty, structs, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (fieldmove_expr(m.scrutinee, name, sty, structs, borrowable)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && fieldmove_expr(arm.guard, name, sty, structs, borrowable)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (fieldmove_stmt(arm.body[bi], name, sty, structs, borrowable)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return fieldmove_stmt(d.action, name, sty, structs, borrowable); },
        _ => { return false; }
    }
    return false;
}

// optstruct_body_moves_field: any statement in `stmts` moves a NON-SCALAR field of
// the struct local `name` (declared type `sty`) into something longer-lived.
function optstruct_body_moves_field(stmts: ast.Stmt[], name: string, sty: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    for stmt in stmts {
        if (fieldmove_stmt(stmt, name, sty, structs, borrowable)) { return true; }
    }
    return false;
}

// opt_arm_field_moved: for the consuming match `st` of an option whose constructed
// variant is `variant` and whose payload is the struct `sty`, does that variant's
// arm move one of the payload's rc fields out? The field-level sibling of
// opt_arm_binding_escapes, and read the same way: only the CONSTRUCTED variant's
// arm can run, so only its binding is checked.
function opt_arm_field_moved(st: ast.Stmt, variant: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        var vname: string = pv.type_name;
                        var vc: i32 = 0;
                        while (vc < pv.type_name.len()) {
                            if (pv.type_name[vc] == b'.') { vname = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; }
                            vc = vc + 1;
                        }
                        if (vname == variant && pv.binding != "" && pv.binding != "_") {
                            if (arm.has_guard && optstruct_bind_esc_expr(arm.guard, pv.binding, sty, structs)) { return true; }
                            var bi: i32 = 0;
                            while (bi < arm.body.len()) {
                                if (optstruct_bind_esc_stmt(arm.body[bi], pv.binding, sty, structs)) { return true; }
                                bi = bi + 1;
                            }
                        }
                    },
                    _ => {}
                }
            }
            return false;
        },
        _ => { return false; }
    }
}

// opt_body_field_moved: opt_arm_field_moved lifted over a whole body, for the
// precise-drop path whose consuming match sits in a NESTED block — the field-level
// sibling of opt_body_binding_escapes, and the same recursion.
function opt_body_field_moved(stmts: ast.Stmt[], name: string, variant: string, sty: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        if (opt_stmt_field_moved(stmt, name, variant, sty, structs)) { return true; }
    }
    return false;
}
function opt_stmt_field_moved(st: ast.Stmt, name: string, variant: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            match (m.scrutinee) {
                ast.ExprIdent(id) => {
                    if (id.name == name && opt_arm_field_moved(st, variant, sty, structs)) { return true; }
                },
                _ => {}
            }
            for arm in m.arms {
                if (opt_body_field_moved(arm.body, name, variant, sty, structs)) { return true; }
            }
            return false;
        },
        ast.StmtIf(iff) => {
            return opt_body_field_moved(iff.then_body, name, variant, sty, structs)
                || opt_body_field_moved(iff.else_body, name, variant, sty, structs);
        },
        ast.StmtWhile(w) => { return opt_body_field_moved(w.body, name, variant, sty, structs); },
        ast.StmtFor(f) => { return opt_body_field_moved(f.body, name, variant, sty, structs); },
        _ => { return false; }
    }
}

// opt_payload_deep_sty: the payload struct type whose rc-ARRAY fields the drop
// must deep-release before freeing the payload box — "" when the shallow box dec
// is complete (a flat scalar-array buffer, a string, or a scalar-only struct).
// rcpayload_option_cand admits a struct payload under
// `struct_is_scalar_only || nested_field_deep_drop_ok`, so a non-scalar-only one
// is exactly the deep-drop-ok case, and __struct_drop_<T> is emitted for it.
function opt_payload_deep_sty(ptype: string, structs: parser.StructDecl[]): string {
    if (!decl_is_struct(structs, ptype)) { return ""; }
    if (struct_is_scalar_only(structs, ptype)) { return ""; }
    return ptype;
}

// OptRcFrees: parallel arrays for the rc-payload option/result free — the
// consuming match index, the freed local name, and whether the payload is a
// STRING (#4355: released via __fern_str_free instead of the shallow
// __fern_rc_dec — on asm a string box's data buffer is separate and its
// 24-byte block class differs from the array layout, so the array dec would
// free it wrongly). `stys[i]` is opt_payload_deep_sty's verdict: non-empty
// names a struct payload whose rc-array fields need __struct_drop_<T> before
// the box dec (#6127 — a `Some(P { xs: [..], n: .. })` bound ONCE leaked its
// `xs` buffer every round, where the same value REBOUND in a loop has been
// deep-freed since #6252). blockable marks payloads whose drop is COMPLETE on its
// own (string / leak-safe scalar-array) — the only kinds lower_block's
// per-nested-block pass may claim. A struct-literal payload's shallow box
// dec relies on the surrounding OPTSTRUCT machinery to release its array
// FIELDS; a block-level drop zeroes the slot and starves that machinery,
// leaking the field buffers (the #5453 CI regression) — so struct payloads
// stay fn-level-only, where the pass and the machinery agree.
// `inners[i]` is nested_opt_inner_freefn's verdict: non-empty names the release
// for a NESTED Option payload's OWN payload, routing the drop through
// emit_optopt_rc_deep_free instead of the one-level helper. Its own field
// rather than a marker inside `pfrees` or `stys`, because both of those are read
// as a single helper name / struct type and a prefixed value would reach
// op_call_direct or __struct_drop_ as if it were one.
struct OptRcFrees { idxs: i32[], vidxs: i32[], names: string[], pfrees: string[], blockable: boolean[], stys: string[], tagged: boolean[], errstrs: boolean[], inners: string[] }

// consumed_rcpayload_option_frees: finds every function-local `var o = Some([..])`
// / `Ok([..])` / `Err([..])` (leak-safe scalar-array payload) or `Some(P{..})` /
// `Ok(P{..})` (fresh scalar-only struct-literal payload) consumed by exactly one
// `match (o)`, single-owner, dead-after, non-escaping, and whose constructed-
// variant arm binds the payload only as a borrow (opt_arm_binding_escapes false).
// Each such box's payload is freed then the box freed right after its match
// (emit_opt_payload_drop). Same shape / gates as consumed_rcpayload_enum_frees;
// DISJOINT from consumed_scalar_enum_frees (that's scalar-payload options).
// rcpayload_option_call_ptype: `var o: Option[i32[]] = mk(i)` — an rc-payload
// Option/Result bound from a call the OPTFRESH registry proved always returns a
// direct constructor, so the box is fresh and sole-owned exactly as an inline
// ctor would be. Returns the SUCCESS payload type, or "" to refuse.
//
// The call-init sibling of rcpayload_option_cand (#6360). That one reads the
// CONSTRUCTED variant off the init and can therefore drop the payload
// unconditionally; here the variant is not known until run time, so the free is
// tag-guarded (emit_opt_tagged_payload_drop) and admission must prove that
// EVERY variant the box can hold is safe to leave to that drop:
//
//   - success payload: a leak-safe scalar array, released by one __fern_rc_dec
//     with no inner walk.
//   - success payload: OR a `string`, released by __fern_str_free, admitted only
//     when the producer is in `fresh_str` — the OPTFRESH "f" flag, i.e. every
//     success payload is a literal or a fresh string producer. Without that the
//     payload aliases a live local (op_opt_make stores it uncounted) and freeing
//     it would DANGLE rather than leak, which is why the box-only "a" flag
//     stays refused here.
//   - Err payload: unconstrained (#6463). The tag guard's else-branch is empty,
//     so a non-scalar Err payload is never reached — stranded, not dangled.
//     Which is also why the "f" flag not covering Err costs nothing here: it
//     proves the SUCCESS payload fresh, and the success payload is the only one
//     this drop touches.
//
// Annotation-only, like fresh_scalar_option_call_init: the payload spelling is
// what proves the shape, and a call init has no literal to fall back on.
function rcpayload_option_call_ptype(v: ast.StmtVar, opt_fresh_reg: SigReg): string {
    var callee: string = "";
    match (v.init) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => { callee = id.name; },
                _ => {}
            }
        },
        _ => {}
    }
    if (callee == "") { return ""; }
    if (!sig_reg_has_name(opt_fresh_reg, callee)) { return ""; }
    var ann: string = v.type_name;
    var n: i32 = ann.len();
    var str_ok: boolean = sig_reg_opt_payload_fresh(opt_fresh_reg, callee);
    if (n >= 8 && slice_unchecked(ann, 0, 7) == "Option[") {
        // None carries no payload, so the success payload is the only one.
        var pt: string = opt_payload_type(ann, "Ok");
        if (is_leaksafe_array_field(pt)) { return pt; }
        if (pt == "string" && str_ok) { return pt; }
        return "";
    }
    if (n >= 8 && slice_unchecked(ann, 0, 7) == "Result[") {
        // Err is deliberately unconstrained. emit_opt_tagged_payload_drop
        // frees the payload only under `tag == 0`, so a non-scalar Err payload
        // is never reached: it is stranded, not dangled. Requiring a scalar Err
        // refused `Result[T[], string]` — the idiomatic error type — and
        // leaked the BOX as well as the payload, which is strictly worse on
        // every count. Same reasoning #6416 used to drop this gate from
        // fresh_scalar_option_call_init.
        var okt: string = opt_payload_type(ann, "Ok");
        if (!is_leaksafe_array_field(okt) && !(okt == "string" && str_ok)) { return ""; }
        return okt;
    }
    return "";
}

// call_init_callee_in: `e` is a direct call to a bare-ident callee listed in
// `names`. The membership test the call-init admissions all share (#6360).
function call_init_callee_err_fresh(e: ast.Expr, reg: SigReg): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => { return opt_err_fresh_producer(reg, id.name); },
                _ => { return false; }
            }
        },
        _ => {}
    }
    return false;
}

// `nested_ok` is TRUE only from lower_block, and it is what lets a DIRECT ctor
// take the nested-match lookup. See the comment at the lookup itself for why that
// is safe there and unsafe at function scope.
function consumed_rcpayload_option_frees(body: ast.Stmt[], structs: parser.StructDecl[], opt_fresh_reg: SigReg, nested_ok: boolean): OptRcFrees {
    var idxs: i32[] = [];
    var vidxs: i32[] = [];
    var names: string[] = [];
    var pfrees: string[] = [];
    var blockable: boolean[] = [];
    var inners: string[] = [];
    var stys: string[] = [];
    var tagged: boolean[] = [];
    var errstrs: boolean[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var vi: i32 = 0;
    while (vi < body.len()) {
        match (body[vi]) {
            ast.StmtVar(v) => {
                var cand: OptRcCand = rcpayload_option_cand(v, structs);
                // Not a direct ctor? Try the OPTFRESH call-init form; the variant
                // is unknown, so the candidate is marked tag-guarded.
                //
                // A STRING payload passes "Ok|Some" to the escape gate below, so
                // the SUCCESS arm is checked under either spelling. Naming one
                // variant on a runtime-variant box checks nothing at all, which is
                // only survivable for an ARRAY payload: there an escaping arm
                // binding RETAINS (`held = xs` incs the buffer), so the drop's dec
                // is balanced and refusing the shape would cost real reclaim
                // (measured, 1600/1600 to 800/1600). A string assignment is a
                // BORROW, so the same escape leaves __fern_str_free releasing a
                // live box.
                var call_pt: string = "";
                if (cand.variant == "") {
                    call_pt = rcpayload_option_call_ptype(v, opt_fresh_reg);
                    if (call_pt != "") {
                        var cvar: string = "Ok";
                        if (call_pt == "string") { cvar = "Ok|Some"; }
                        cand = OptRcCand { variant: cvar, ptype: call_pt };
                    }
                }
                // A nested-Option candidate may be REASSIGNED when every rebind is
                // itself fresh (#7716). This family releases the box the match
                // CONSUMES; each superseded box is released at its own rebind by
                // the "OPTOPTRB:" credit below. The two act on DISJOINT values —
                // the old box at the assignment, the current one at the match —
                // so neither can release what the other does.
                var cand_reassign_ok: boolean = util.index_of_str(reassigned, v.name) < 0
                    || (type_is_scalar_union(cand.ptype)
                        && opt_rebinds_all_fresh(body, v.name, "optopt", "", [], sig_reg_empty(), []));
                if (cand.variant != "" && cand_reassign_ok) {
                    // The consuming match may sit one block deeper than `body`
                    // (#6319), so the two kinds of check read different things:
                    // liveness and escape take the ENCLOSING top-level statement,
                    // which is also where the free lands, while the arm analyses
                    // take the match itself.
                    //
                    // A call init always gets the nested lookup; a DIRECT ctor
                    // gets it only under `nested_ok`, i.e. only from lower_block.
                    //
                    // The asymmetry is real and was measured both ways. At FUNCTION
                    // scope precise_drop_names' is_rcopt kind already reclaims the
                    // direct ctor with a nested match — it admits exactly
                    // `rcpayload_option_cand != ""` and defers here only on a FLAT
                    // match — and letting this analysis take it too is not a
                    // harmless duplicate: it segfaults, and shows up as
                    // __rc_underflow_count() == -1 in
                    // TestSelfHostNestedMatchBorrowNoUnderflowX86_64. A BLOCK-scoped
                    // local has no such owner, because precise_drop_names is only
                    // ever called with fn.body and never sees one.
                    var match_idx: i32 = 0 - 1;
                    var msv: ast.Stmt[] = [];
                    if (call_pt != "" || nested_ok) {
                        match_idx = sole_consuming_match_idx(body, v.name);
                        if (match_idx > vi) { msv = consuming_match_of(body[match_idx], v.name); }
                    } else {
                        match_idx = sole_top_level_match_idx(body, v.name);
                        if (match_idx > vi) { msv = [body[match_idx]]; }
                    }
                    if (match_idx > vi && msv.len() == 1) {
                        var arms_use: boolean = match_arms_use_name(msv[0], v.name);
                        var dead_after: boolean = !name_used_after(body, v.name, match_idx);
                        var escapes: boolean = name_escapes_outside_stmt(body, v.name, match_idx)
                            && !opt_match_alias_escape_ok(body, v.name, match_idx, [], []);
                        // A nested payload reads its arm's `match (binding)` as a
                        // BORROW (binding_escapes_arm_scrut); every other payload
                        // kind keeps the coarse walker, so this widens exactly one
                        // class. An rc INNER pays for that reading with a second
                        // proof: its nested match binds a POINTER, which a scalar
                        // inner's copy could never be.
                        var innerfree: string = nested_opt_inner_freefn(cand.ptype);
                        var binds_esc: boolean = opt_arm_binding_escapes(msv[0], cand.variant,
                            type_is_scalar_union(cand.ptype) || innerfree.len() > 0);
                        if (!binds_esc && innerfree.len() > 0) {
                            binds_esc = nested_opt_payload_arm_escapes(msv[0], cand.variant);
                        }
                        if (!arms_use && dead_after && !escapes && !binds_esc) {
                            idxs = idxs.append(match_idx);
                            vidxs = vidxs.append(vi);
                            names = names.append(v.name);
                            pfrees = pfrees.append(opt_payload_freefn(cand.ptype));
                            var dsty: string = opt_payload_deep_sty(cand.ptype, structs);
                            // The MATCH, not body[match_idx] — under a nested lookup the
                            // latter is the enclosing `if`, which this predicate cannot
                            // parse and so reads as "no field moved", granting a deep drop
                            // over a field the arm moved out. Masked until now by the
                            // arm-escape gate refusing those shapes first; making a struct
                            // payload blockable below puts real weight on it.
                            if (dsty.len() > 0 && opt_arm_field_moved(msv[0], cand.variant, dsty, structs)) { dsty = ""; }
                            stys = stys.append(dsty);
                            // A TAG-GUARDED (call-bound) candidate never takes the
                            // nested route: its variant is unknown at the drop, and
                            // the two-level walk has no tag guard of its own.
                            var innerf: string = "";
                            if (call_pt == "") { innerf = nested_opt_inner_freefn(cand.ptype); }
                            inners = inners.append(innerf);
                            // A struct payload IS blockable once the block-level emission
                            // performs the same deep field drop the fn-level one does —
                            // `dsty` non-empty is exactly "the deep drop is available and
                            // no arm moved a field out of it". Without that branch the
                            // block pass would emit a shallow dec and strand the field
                            // buffers, which is the #5453 regression this gate was added
                            // for.
                            // A nested-OPTION payload is blockable for the same
                            // reason a leak-safe array is: the inner box holds a
                            // by-value scalar and nothing else, so one
                            // __fern_rc_dec is its COMPLETE drop and no
                            // surrounding machinery is starved by the slot zero.
                            blockable = blockable.append(cand.ptype == "string" || cand.ptype == "string[]"
                                || is_leaksafe_array_field(cand.ptype) || type_is_scalar_union(cand.ptype)
                                || innerf.len() > 0 || dsty.len() > 0);
                            tagged = tagged.append(call_pt != "");
                            // #6360: the Err arm's string may be released too, but
                            // only for a call-bound candidate whose producer is
                            // ERRFRESH-proven. A direct ctor names one variant, so
                            // its drop never reaches the other arm's payload.
                            errstrs = errstrs.append(call_pt != ""
                                && opt_payload_type(v.type_name, "Err") == "string"
                                && call_init_callee_err_fresh(v.init, opt_fresh_reg));
                        }
                    }
                }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return OptRcFrees { idxs: idxs, vidxs: vidxs, names: names, pfrees: pfrees, blockable: blockable, stys: stys, tagged: tagged, errstrs: errstrs, inners: inners };
}

// emit_opt_payload_drop frees the rc payload of the option box in `slot`, then
// frees the box and zeroes the slot. The constructed variant is statically known
// (the classifier admitted a specific Some/Ok/Err), so — unlike the enum path —
// this needs NO runtime variant_is guard: the payload is always at offset 8 / 4
// (op_opt_payload) and is either a flat scalar-array buffer OR a scalar-only struct
// box, so a single __fern_rc_dec releases it with no inner walk. The option box is
// then dec'd and the slot zeroed so the exit sweep decs a null. Payload dropped
// BEFORE the box, each freed exactly once.
// emit_opt_payload_drop_via is that shape with the payload's release helper
// spelled out, because the three admitted payloads need three different ones and
// differ in NOTHING else. __fern_rc_dec releases a flat scalar-array buffer or a
// scalar-only struct box. __fern_str_free releases a string box (box + separate
// data buffer on asm; one inline block on wasm, where it maps to $__fern_arr_dec)
// — a plain rc-dec would free the 24-byte string block by the ARRAY layout's size
// class on asm, the wrong class. __fern_str_arr_free walks a string[]'s ELEMENT
// boxes before freeing the buffer (#6495); a plain rc-dec frees the buffer and
// strands every element. The classifier admitted only FRESH payloads (literal /
// fresh producer, per element for a string[]), so each box is sole-owned; a
// literal's .rodata data is heap-guard-skipped and a double free ticks the
// underflow detector.
// Which runtime helper releases a tag-guarded payload whole: a string box needs
// __fern_str_free (separate data buffer, different block class), everything
// rcpayload_option_call_ptype otherwise admits is a flat scalar array.
// tagged_errfreefn: "" leaves the tag guard's else-branch empty (an Err payload
// stranded, the pre-#6360 behaviour); __fern_str_free fills it for a producer
// whose every Err payload is a proven-fresh string.
function tagged_errfreefn(err_str: boolean): string {
    if (err_str) { return "__fern_str_free"; }
    return "";
}

// optret_opt_entry encodes one OptRcFrees row as an optret_pending entry, so a
// `return` out of the row's match arm emits the SAME release the post-match
// drop does. It carries the whole selection — free fn, nested inner free fn,
// struct payload type — rather than a tag derived from `pfrees` alone, because
// the choice among the five releases is not a function of `pfrees`: a nested
// Option payload and a struct payload both free through __fern_rc_dec, so both
// used to encode as the shallow drop and the return path stranded the inner
// string / the struct's rc-array fields (#7725, measured 6400 and 8000 live
// bytes over 200 rounds against a native backend flat at 0).
//
// Every arm of the dispatch in emit_dec_sweep_except_list decodes one of these,
// in the same order the post-match emissions test them.
function optret_opt_entry(slot: i32, r: OptRcFrees, i: i32): string {
    var head: string = util.i32_to_string(slot);
    if (r.tagged[i]) { return head + "#t" + r.pfrees[i] + ";" + tagged_errfreefn(r.errstrs[i]); }
    if (r.inners[i].len() > 0) { return head + "#n" + r.inners[i]; }
    if (r.pfrees[i] != "__fern_rc_dec") { return head + "#v" + r.pfrees[i]; }
    if (r.stys[i].len() > 0) { return head + "#p" + r.stys[i]; }
    return head + "#a";
}

// opt_payload_freefn maps an admitted payload TYPE to the runtime helper that
// releases it whole. The single place the mapping lives, so the untagged, the
// tagged and the optret-pending paths cannot disagree about what frees a
// payload — they used to carry a boolean apiece, which had no room for a third
// payload kind.
function opt_payload_freefn(ptype: string): string {
    if (ptype == "string") { return "__fern_str_free"; }
    if (ptype == "string[]") { return "__fern_str_arr_free"; }
    return "__fern_rc_dec";
}

function emit_opt_payload_drop_via(s: LowerState, slot: i32, freefn: string): LowerState {
    var st: LowerState = s;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());
    st = st.emit(ir.op_call_direct(freefn, 1));
    st = st.emit(ir.op_drop());
    // free the option box itself and zero the slot.
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    return st;
}

// nested_opt_inner_freefn names the release for the payload of a NESTED OPTION
// payload type — the inner box's own payload — or "" when this drop cannot
// reach it.
//
// OPTION only, never Result. The drop runs after the match and never reads the
// inner tag, so one blind release has to serve every arm the inner box can
// hold; `None` carries no payload, which makes Option's success payload the
// only one, where a `Result[i32[], string]` would need two different helpers at
// one site. Same reasoning rcpayload_option_call_ptype already applies to the
// OUTER box.
//
// A SCALAR inner is deliberately absent: that box owns no pointer, so it takes
// the one-level path (opt_payload_freefn's plain dec of the inner box) and must
// not be walked a second time.
function nested_opt_inner_freefn(pt: string): string {
    if (pt.len() < 8 || slice_unchecked(pt, 0, 7) != "Option[") { return ""; }
    var inner: string = opt_payload_type(pt, "Some");
    if (is_leaksafe_array_field(inner)) { return "__fern_rc_dec"; }
    if (inner == "string") { return "__fern_str_free"; }
    if (inner == "string[]") { return "__fern_str_arr_free"; }
    return "";
}

function emit_opt_payload_drop(s: LowerState, slot: i32): LowerState {
    return emit_opt_payload_drop_via(s, slot, "__fern_rc_dec");
}

// emit_opt_struct_payload_drop — the STRUCT-payload sibling of
// emit_opt_payload_drop (#6127). Same shape, one step longer: the payload at
// offset 8 is a struct box whose rc-ARRAY fields the construction alias-inc'd,
// so they are deep-released via __struct_drop_<sty> (emit_struct_field_drops,
// routed by marking a scratch slot with the type) BEFORE the box dec. Without
// it the box was freed and its field buffers were not — and because this drop
// zeroes the slot, the exit sweep's own OPTSTRUCT deep free saw a null and
// never picked them up.
//
// No null / tag guard, matching emit_opt_payload_drop: rcpayload_option_cand
// admitted a specific CONSTRUCTED variant (`Some(P { .. })`), and the name is
// neither reassigned nor escaping, so the box is live and carries that
// variant's payload at the point of the drop.
// emit_opt_tagged_payload_drop — the CALL-INIT sibling of emit_opt_payload_drop
// (#6360). Same job, one guard longer, and the guard is the whole point.
//
// emit_opt_payload_drop reads offset 8 unconditionally, which is sound only
// because its classifier saw the CONSTRUCTED variant (`Some([..])`). A local
// bound from a producer call has no statically-known variant: the same slot may
// hold `Some`/`Ok` with an array payload or `None`/`Err` with none, so an
// unconditional dec would either free a scalar as a pointer or dec a null.
//
// Admission (rcpayload_option_call_ptype) has already proved the only payload
// needing release is the SUCCESS one and that one call releases it whole, so the
// else-branch is empty and `freefn` is the entire payload free:
//
//     if (box != 0) { if (tag == 0) { freefn(payload) } rc_dec(box) } slot = 0
//
// `freefn` comes from opt_payload_freefn, the same mapping the untagged
// emit_opt_payload_drop_via reads.
//
// Tag 0 is Some/Ok, matching emit_optstruct_deep_free, whose null-then-tag shape
// this follows exactly. The slot is zeroed so the exit sweep decs a null rather
// than the box a second time.
function emit_opt_tagged_payload_drop(se: LowerState, slot: i32, freefn: string, errfreefn: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // box != 0
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // tag == 0 (Some / Ok)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());
    st = st.emit(ir.op_call_direct(freefn, 1));
    st = st.emit(ir.op_drop());
    // `errfreefn` non-empty fills the else-branch that was empty until #6360, so
    // an Err payload is released rather than stranded. It stays empty unless the
    // producer's every Err payload is proven fresh (ERRFRESH), because this arm
    // has no other owner to fall back on.
    if (errfreefn != "") {
        st = st.emit(ir.op_else());
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_opt_payload());
        st = st.emit(ir.op_call_direct(errfreefn, 1));
        st = st.emit(ir.op_drop());
    }
    st = st.emit(ir.op_end());                       // end if-success
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));   // free the box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    return st;
}

function emit_opt_struct_payload_drop(s: LowerState, slot: i32, sty: string): LowerState {
    var scratch: string = "$optsp" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(scratch);
    var pslot: i32 = st.slot_of(scratch);
    st = st.mark_struct_type(pslot, sty);
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());
    st = st.emit(ir.op_store_local(pslot));
    st = emit_struct_field_drops(st, pslot);
    st = st.emit(ir.op_load_local(pslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    // free the option box itself and zero the slot.
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    return st;
}

// slot_is_reclaimable_struct: slot i holds a reclaimable struct — a non-param
// struct slot whose BINDING was proven fresh + non-escaping. Such a box is the
// sole reference (rc=1) and outlives nothing, so a shallow rc-dec at scope exit /
// loop-rebind frees it safely. Scalar/leak-safe fields mean no rc-tracked field
// dangles (strings / inner arrays leak, as everywhere on this path).
//
// Keyed on the binding SITE (#7253 step 1), not the name. This class is the one
// where a shared verdict is not a leak: two `var v` in sibling blocks, one bound
// from a fresh producer and one aliasing a param, are two slots under one name,
// and the name lookup hands the alias the fresh one's credit — freeing the
// caller's box under a live reference. Witnessed as a SIGSEGV rather than an rc
// underflow, and the same program with the second local renamed is correct.
function slot_is_reclaimable_struct(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    var sty: string = s.struct_type_of_slot(i);
    if (sty.len() == 0) { return false; }
    // a dyn-Trait slot carries the coarse "dyn <T>" tag, not a struct decl —
    // it is released by the dedicated DYN sweep loop (#4351), never here
    // (double-firing both loops over-released the concrete's box).
    if (sty.len() > 4 && slice_unchecked(sty, 0, 4) == "dyn ") { return false; }
    // A RETIRED slot stays refused here, and that refusal has to be written out
    // now that the key is not the name. The old lookup was an exact `slot_name`
    // compare, so retire_locals' block-exit rename hid a block-scoped slot from
    // it for free; a site key survives that rename, so resolving it alone would
    // newly credit those slots. That is not a re-key, it is the flip the credit-key
    // note records as segfaulting the gen1 self-compile — the scoped sibling below
    // is where the retirement-aware answer is asked for.
    if (slot_name_retired(s.locals[i].slot_name)) { return false; }
    return slot_struct_credit_at(s, i);
}

// slot_struct_credit_at: the credit lookup both struct predicates share. A slot
// with NO recorded site resolves nothing — deliberately, and this is the half a
// missed producer lands on: it denies the credit (a leak) rather than matching
// an empty entry, which is the safe direction and the one the emit-hash gate
// makes loud.
// slot_credit_at: the reclaim-credit lookup for every site-keyed tag family
// (#7253 step 1) — keyed on the BINDING SITE rather than the variable name. One
// helper for all of them so they cannot drift apart, and so the "no recorded
// site" refusal is written once.
//
// A slot with no site resolves NOTHING, deliberately. Every producer of these
// credits walks `StmtVar`, and every `StmtVar` binding records its site — so a
// siteless slot is one bound by a for-in element, a match payload, a destructure
// key or a reuse recipient, which no collector ever credited and which only ever
// matched by NAME COLLISION with a credited local. Refusing it is the point of
// the change, not a side effect of it.
function slot_credit_at(s: LowerState, i: i32, pfx: string): boolean {
    var site: string = s.reclaim_site_key(i);
    if (site.len() == 0) { return false; }
    return reclaim_has(s.reclaimable_names, pfx, site);
}

function slot_struct_credit_at(s: LowerState, i: i32): boolean {
    var site: string = s.reclaim_site_key(i);
    if (site.len() == 0) { return false; }
    return util.index_of_str(s.reclaimable_names, site) >= 0;
}

// slot_is_reclaimable_struct_scoped: slot_is_reclaimable_struct WITHOUT its
// retirement refusal (#6127). retire_locals renames a block-scoped local on block
// exit, and the sibling above still declines a renamed slot, so a struct declared
// inside a `while` body is never swept by it. Measured 8800 bytes over 100 rounds
// on a `S { xs: i32[], n: i32 }` declared in a loop, against 0 on native.
//
// The two differ only in that refusal now. Before #7253 the credit was keyed on
// the NAME and this variant reached a retired slot by stripping the prefix; the
// site key is carried on the SLOT and survives the rename by itself, so what used
// to be an extra lookup step is now the plain lookup and the strictness lives in
// the sibling.
//
// #6285 gave nine other classes this lookup by switching it inside their shared
// predicate. That is exactly what must NOT happen here: slot_is_reclaimable_struct
// has fourteen consumers, and it drives the loop-rebind stores, the reuse donor and
// recipient releases and the precise drop as well as the sweep. Flipping it
// wholesale SEGFAULTS the gen1 self-compile, because those other releases are not
// all sole-owner for a block-scoped slot.
//
// So this variant is used at exactly TWO sites, which have to agree with each
// other and with nothing else:
//   - the function-exit sweep's struct loop, which frees the box. The slot needs
//     no per-class zeroing: the prologue zeroes the whole body range, so the
//     sweep cannot dec stack garbage in a function whose block never ran.
// The two move-on-return keeps sets deliberately keep the exact-match lookup: they
// resolve a slot from a live AST name reference (`return r` / `return r.f`), and
// slot_of matches exactly, so a retired slot can never appear in them — a returned
// value's name is still live at the return.
function slot_is_reclaimable_struct_scoped(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    var sty: string = s.struct_type_of_slot(i);
    if (sty.len() == 0) { return false; }
    if (sty.len() > 4 && slice_unchecked(sty, 0, 4) == "dyn ") { return false; }
    return slot_struct_credit_at(s, i);
}

// slot_is_reclaimable_tuple: slot `i` is a fresh, non-escaping SCALAR-tuple local
// (`var t = (3, 4)`) credited under the "TUP:" prefix by reclaimable_names_of. A
// non-param TUPLE slot whose name is in the reclaim set. Its box (now rc-headered
// via tuple_make → __fern_arr_box) is shallow-freed at scope exit like a
// scalar-only struct — no element walk (the collection gate admitted only scalar
// literals, so no rc element to dangle).
function slot_is_reclaimable_tuple(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].tuple_elems.len() == 0) { return false; }
    return reclaim_has(s.reclaimable_names, "TUP:", s.reclaim_site_key(i));
}

// slot_is_reclaimable_tuple_rebind: slot `i` is a "TUP:" tuple whose every
// assignment was proven to build a fresh scalar tuple, so the box the assignment
// SUPERSEDES can be released as well as the final one (#6127). Implies
// slot_is_reclaimable_tuple — the credit is only ever appended alongside "TUP:".
function slot_is_reclaimable_tuple_rebind(s: LowerState, i: i32): boolean {
    if (!slot_is_reclaimable_tuple(s, i)) { return false; }
    return reclaim_has(s.reclaimable_names, "TUPREBIND:", s.reclaim_site_key(i));
}

// slot_is_reclaimable_rctuple: a fresh, non-escaping tuple local carrying a fresh
// ARRAY-literal element (`var t = (i, [i, i+1])`), credited "TUPRC:" by
// reclaimable_names_of. Its loop-rebind takes the DEEP emit_tuple_deep_reinit_store
// (arr_dec each fresh array element + box) instead of the scalar-tuple shallow box
// dec. #4357.
function slot_is_reclaimable_rctuple(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].tuple_elems.len() == 0) { return false; }
    return reclaim_has(s.reclaimable_names, "TUPRC:", s.reclaim_site_key(i));
}

// slot_is_reclaimable_rctuple_sweep: a "TUPRC:" slot whose FINAL value the scope-exit
// sweep may deep-free too — credited "TUPRCS:" (#6127), which additionally requires a
// tuple annotation, tuple_arg_payload_retained (every rc position either a fresh
// literal the tuple sole-owns or a bare ident the construction retained, so the
// type-driven drop's dec is balanced either way), and no reassignment. Narrower than
// slot_is_reclaimable_rctuple, so the rebind path's set is unchanged.
function slot_is_reclaimable_rctuple_sweep(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].tuple_elems.len() == 0) { return false; }
    return reclaim_has(s.reclaimable_names, "TUPRCS:", s.reclaim_site_key(i));
}

// slot_is_credited_tuple: slot `i` holds ANY tuple credit — the question the
// alias bind asks of its SOURCE, so the retain lands exactly when the credit
// pass gave the alias a row to spend it on. The three classes are the three
// states a credited tuple source can be in: "TUP:" (scalar), "TUPRC:" (rc,
// possibly with "TUPRCS:"), and "TUPRCS:" alone, which is what a MOVE-alias
// holds after lower_stmt_var's ExprIdent arm migrates the deep class onto it
// and drops its "TUP:" row. A chain reaches the third state at its second
// link; asking only the first two there produced a credited alias with no
// retain behind it (#7750).
function slot_is_credited_tuple(s: LowerState, i: i32): boolean {
    return slot_is_reclaimable_tuple(s, i) || slot_is_reclaimable_rctuple(s, i) || slot_is_reclaimable_rctuple_sweep(s, i);
}

// emit_rctuple_deep_free frees a sweepable rc-tuple slot's fresh rc children
// (array buffers, string boxes, nested tuple boxes, reclaim-struct boxes — all
// type-driven via emit_tuple_type_child_drops) and then its own box, leaving the
// slot zeroed. Null-guarded: body slots are entry-zeroed by the prologue, and
// emit_tuple_type_child_drops DEREFERENCES the box to reach each position, so an
// untaken-branch slot must skip the whole body rather than rely on __fern_rc_dec's
// own null guard. The rc-tuple sibling of emit_opttup_deep_free's inner Some arm.
function emit_rctuple_deep_free(se: LowerState, slot: i32): LowerState {
    var st: LowerState = se;
    var ttype: string = "(" + st.locals[slot].tuple_elems + ")";
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // slot != 0 (null guard)
    st = st.emit(ir.op_if(0));
    var rtp: i32[] = [];
    st = emit_tuple_type_child_drops(st, slot, rtp, ttype);
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));   // free the tuple box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_const_i32(0));
    return st.emit(ir.op_store_local(slot));
}

// slot_is_reclaimable_rcenum: a fresh, non-escaping rc-payload enum loop-local
// (`var b = Full([i, i+1])`), credited "RCENUM:" by reclaimable_names_of. Its
// loop-rebind takes the DEEP emit_enum_deep_reinit_store (emit_enum_variant_drops
// on the prior box) instead of leaking. The slot's struct_type carries the enum
// name (mark_struct_type for an enum-typed binding), used by the emission to
// dispatch the runtime variant deep-drop. #4357.
function slot_is_reclaimable_rcenum(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.struct_type_of_slot(i).len() == 0) { return false; }
    // The RETIRED refusal, explicit now that the key is not the name. This
    // predicate used an exact `slot_name` compare, so retire_locals' block-exit
    // rename hid a block-scoped slot from it for free; a site key survives that
    // rename, so resolving it alone would newly credit those slots. Its sweep
    // sibling below is where the retirement-aware answer is asked for, and the two
    // read the SAME entry — collect_fresh_rcenum_names emits one key that both
    // tags are appended against, so they cannot end up keyed differently.
    if (slot_name_retired(s.locals[i].slot_name)) { return false; }
    return slot_credit_at(s, i, "RCENUM:");
}

// slot_is_reclaimable_rcenum_sweep: an rc-payload enum slot whose FINAL value the
// scope-exit sweep may deep-free — credited "RCENUMS:" (#6606 follow-up), which is
// the strictly narrower half with NO consuming match in its block.
//
// Accepts a RETIRED slot, unlike slot_is_reclaimable_rcenum above, and that is the
// whole point: retire_locals renames a block-scoped local on block exit, and a
// lookup that refuses those skips the slot at the sweep. That is the "n-1 of n
// freed per round" signature retire_locals' own note describes — the loop rebind
// releases each PRIOR value and the last one survives. Both predicates read the
// SAME site-keyed entry (#7253); only the refusal differs.
//
// The match-consumed half deliberately has no sweep credit. Its consuming match
// frees the value inside the block on every iteration including the last, so
// sweeping it would be a second claim on a released box — which is exactly what
// the credit-key note records when it lists "RCENUM:" among the classes that must
// NOT be swept. That note was right for the whole class
// until the no-match half was admitted; it is now right for only one half.
function slot_is_reclaimable_rcenum_sweep(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.struct_type_of_slot(i).len() == 0) { return false; }
    return slot_credit_at(s, i, "RCENUMS:");
}

// slot_is_reclaimable_scenum: an all-scalar ENUM local with no consuming match,
// credited "SCENUMS:" (#6758 follow-up). Accepts a RETIRED slot for the same
// reason slot_is_reclaimable_rcenum_sweep does: retire_locals renames a
// block-scoped local on block exit, and a lookup that refuses those would miss
// the slot at the sweep and free n-1 of n.
//
// One predicate serves both the rebind and the sweep here, unlike the rc half,
// because the release is the same shallow dec either way — there is no deep drop
// whose double-claim would have to be kept apart.
function slot_is_reclaimable_scenum(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    // A `var d: dyn Show = Add(41)` is a fresh all-scalar enum construction AND a
    // dyn local, so it satisfies both classifiers. The dyn credit already frees
    // that box with a shallow dec; claiming it here too is a second dec on a
    // released box, which is an over-release the rc detector reports rather than
    // a leak. Disjointness is enforced HERE, at the one predicate every emission
    // site consults, rather than in the collector — the collector sees the
    // declared type, but a future overlap need not come through one.
    if (slot_is_reclaimable_dyn(s, i)) { return false; }
    return slot_credit_at(s, i, "SCENUMS:");
}

// slot_is_reclaimable_map: slot `i` is a fresh, non-escaping, non-iterated MAP local
// (`var m = Map { … }` / `map_new()`) credited under the "MAP:" prefix by
// reclaimable_names_of. A non-param MAP slot (map_type set) whose BINDING SITE is
// in the reclaim set. Its keys + values buffers (arr-boxed) and the mapbox itself
// are freed by emit_map_buffers_free at scope exit and at each loop rebind.
//
// Keyed on the binding SITE (#7253 step 1), not the name. The name lookup read
// `slot_name`, which retire_locals renames on block exit — so a map declared
// inside an `if` or a loop body resolved NO credit at the exit sweep and was
// never freed at all, while the same map one indentation level out was flat
// (measured 62 pages over a 2000-round steady window against 0 on native, for a
// `Map[i32, i32]` moved into an `if` body and nothing else changed). All three
// consumers take the site key together: the sweep, and the two loop-rebind
// reinits that free the prior iteration's box before the store — which is the
// same block-scoped slot, so a split verdict there would free a box the sweep
// then frees again.
function slot_is_reclaimable_map(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].map_type.len() == 0) { return false; }
    return slot_credit_at(s, i, "MAP:");
}

// --- map alias group releases (#7235; the group model is at map_alias_holder_sites)

struct MapTupHolders { slots: i32[], idxs: i32[] }

// map_groups_present: the registry holds an alias-group row at all — the cheap
// gate in front of the per-slot scans, so a function without a group emits
// byte-identical sweeps.
function map_groups_present(s: LowerState): boolean {
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        var e: string = s.reclaimable_names[i];
        if (e.len() > 7 && (bytes_at(e, 0, "MAPAL:") || bytes_at(e, 0, "MAPTUP:"))) { return true; }
        i = i + 1;
    }
    return false;
}

// map_group_has_rows: the group keyed by m's site `msite` has holder rows, so
// the clone site may release the superseded box against them. A group the
// analysis admitted without rows (map_tuple_holder_rows' refusal) keeps the box.
function map_group_has_rows(s: LowerState, msite: string): boolean {
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        var e: string = s.reclaimable_names[i];
        if (e.len() > msite.len() + 8 && (bytes_at(e, 0, "MAPAL:") || bytes_at(e, 0, "MAPTUP:"))
            && bytes_at(e, e.len() - msite.len() - 1, "|" + msite)) { return true; }
        i = i + 1;
    }
    return false;
}

// map_group_alias_slots: the slots of the plain aliases in the group keyed by
// `msite`, in slot order.
function map_group_alias_slots(s: LowerState, msite: string): i32[] {
    var out: i32[] = [];
    if (!map_groups_present(s)) { return out; }
    var i: i32 = s.n_params;
    while (i < s.locals.len()) {
        var site: string = s.reclaim_site_key(i);
        if (site.len() > 0 && reclaim_has(s.reclaimable_names, "MAPAL:", site + "|" + msite)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// map_group_tuple_holders: the (tuple slot, element index) holders of the group
// keyed by `msite` whose tuple binding has been lowered. One not yet bound is
// not in scope at the site asking, so nothing that site could read names the
// box through it.
function map_group_tuple_holders(s: LowerState, msite: string): MapTupHolders {
    var slots: i32[] = [];
    var idxs: i32[] = [];
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        var e: string = s.reclaimable_names[i];
        if (e.len() > 7 && bytes_at(e, 0, "MAPTUP:")) {
            var parts: string[] = split_bar(slice_unchecked(e, 7, e.len()) + "");
            if (parts.len() == 3 && parts[2] == msite) {
                var ts: i32 = s.slot_of_site(parts[0]);
                if (ts >= 0) { slots = slots.append(ts); idxs = idxs.append(util.digits_to_i32(parts[1])); }
            }
        }
        i = i + 1;
    }
    return MapTupHolders { slots: slots, idxs: idxs };
}

function maptup_holders_after(h: MapTupHolders, from: i32): MapTupHolders {
    var slots: i32[] = [];
    var idxs: i32[] = [];
    var i: i32 = from + 1;
    while (i < h.slots.len()) { slots = slots.append(h.slots[i]); idxs = idxs.append(h.idxs[i]); i = i + 1; }
    return MapTupHolders { slots: slots, idxs: idxs };
}

function split_bar(s: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == b'|') {
            out = out.append(slice_unchecked(s, start, i) + "");
            start = i + 1;
        }
        i = i + 1;
    }
    return out.append(slice_unchecked(s, start, s.len()) + "");
}

// emit_map_release_unless_held frees the mapbox `slot` holds unless another
// holder of its group still holds it: one of `others` (holder slots) or a tuple
// element `tups.slots[i].tups.idxs[i]`. Null-safe on both sides: a zeroed slot
// compares unequal and frees a null the helper ignores, and a zeroed tuple slot
// is skipped before its element is read.
function emit_map_release_unless_held(s: LowerState, slot: i32, others: i32[], tups: MapTupHolders): LowerState {
    if (others.len() == 0 && tups.slots.len() == 0) { return emit_map_buffers_free(s, slot); }
    var flag: string = "$mgf" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(flag);
    var f: i32 = st.slot_of(flag);
    st = st.emit(ir.op_const_i32(1));
    st = st.emit(ir.op_store_local(f));
    var i: i32 = 0;
    while (i < others.len()) {
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_load_local(others[i]));
        st = st.emit(ir.op_bin("eq", 0, false));
        st = st.emit(ir.op_if(0));
        st = st.emit(ir.op_const_i32(0));
        st = st.emit(ir.op_store_local(f));
        st = st.emit(ir.op_end());
        i = i + 1;
    }
    var t: i32 = 0;
    while (t < tups.slots.len()) {
        st = st.emit(ir.op_load_local(tups.slots[t]));
        st = st.emit(ir.op_const_i32(0));
        st = st.emit(ir.op_bin("ne", 0, false));
        st = st.emit(ir.op_if(0));
        st = emit_load_tuple_path(st, tups.slots[t], [tups.idxs[t]]);
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_bin("eq", 0, false));
        st = st.emit(ir.op_if(0));
        st = st.emit(ir.op_const_i32(0));
        st = st.emit(ir.op_store_local(f));
        st = st.emit(ir.op_end());
        st = st.emit(ir.op_end());
        t = t + 1;
    }
    st = st.emit(ir.op_load_local(f));
    st = st.emit(ir.op_if(0));
    st = emit_map_buffers_free(st, slot);
    return st.emit(ir.op_end());
}

// emit_map_group_release: the exit release of the map local in `mslot` and of
// its plain aliases. The aliases go first, each guarded against the holders
// after it and against m, so m — released last — frees its box unconditionally,
// with whichever deep column credit it carries. A map with no aliases is the
// plain free.
//
// An alias guard names only the LATER aliases and m, never the group's tuple
// holders: emit_map_group_tuple_releases has already run in this sweep and each
// tuple release deferred TO these aliases, so deferring back would leave that
// box unfreed. The two are ordered, not symmetric.
function emit_map_group_release(s: LowerState, mslot: i32): LowerState {
    var aliases: i32[] = map_group_alias_slots(s, s.reclaim_site_key(mslot));
    if (aliases.len() == 0) { return emit_map_buffers_free(s, mslot); }
    var st: LowerState = s;
    var none: MapTupHolders = MapTupHolders { slots: [], idxs: [] };
    var i: i32 = 0;
    while (i < aliases.len()) {
        var later: i32[] = [];
        var j: i32 = i + 1;
        while (j < aliases.len()) { later = later.append(aliases[j]); j = j + 1; }
        later = later.append(mslot);
        st = emit_map_release_unless_held(st, aliases[i], later, none);
        i = i + 1;
    }
    return emit_map_buffers_free(st, mslot);
}

// emit_map_group_tuple_releases: for every credited map local with tuple
// holders, release each tuple-held box unless a holder after it — the later
// tuple holders, the plain aliases, or m — still holds it. Runs before the
// array sweep frees the tuple boxes the elements are read through, and before
// the map sweep's emit_map_group_release, whose alias guards are written for a
// tuple release that has already deferred to them. Moving this after that sweep
// turns an alias free into a use-after-free of a box a live tuple still reads.
function emit_map_group_tuple_releases(s: LowerState, keeps: i32[]): LowerState {
    var st: LowerState = s;
    var mj: i32 = st.n_params;
    while (mj < st.locals.len()) {
        if (!slot_list_has(keeps, mj) && slot_is_reclaimable_map(st, mj)) {
            var msite: string = st.reclaim_site_key(mj);
            var tups: MapTupHolders = map_group_tuple_holders(st, msite);
            if (tups.slots.len() > 0) {
                var later: i32[] = map_group_alias_slots(st, msite);
                later = later.append(mj);
                var t: i32 = 0;
                while (t < tups.slots.len()) {
                    st = emit_map_tuple_holder_release(st, tups.slots[t], tups.idxs[t], later, maptup_holders_after(tups, t));
                    t = t + 1;
                }
            }
        }
        mj = mj + 1;
    }
    return st;
}

// emit_map_tuple_holder_release: the release of the group box held at element
// `k` of the tuple in `tslot`, skipped whole when the tuple slot is zero (an
// untaken branch). The element is copied into a scratch slot so the guarded
// release reads it like any holder.
function emit_map_tuple_holder_release(s: LowerState, tslot: i32, k: i32, others: i32[], tups: MapTupHolders): LowerState {
    var scratch: string = "$mth" + util.i32_to_string(s.locals.len());
    var st: LowerState = s.add_local(scratch);
    var e: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_load_local(tslot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = emit_load_tuple_path(st, tslot, [k]);
    st = st.emit(ir.op_store_local(e));
    st = emit_map_release_unless_held(st, e, others, tups);
    return st.emit(ir.op_end());
}

// emit_map_buffers_free frees the map in `slot` via the per-backend
// __fern_map_free helper: on the register backends it frees the keys + values
// buffers (rc-headered __fern_arr_box arrays) AND returns the raw 16-byte mapbox
// to the freelist; on wasm __fern_map_free routes to $__fern_map_release (which
// additionally deep-drops string K/V). Routing through a helper — rather than an
// inline raw_load_ptr read of mapbox words — is REQUIRED for wasm: the wasm map
// box is a 40-byte rc-headered layout (keys@8/vals@12), NOT asm's raw 16-byte
// {keys@0,vals@8}, so word offsets read off the wrong fields there.
// The helper is null-safe on every backend, so the precise-drop /
// exit-sweep double-call is a safe no-op (the slot is zeroed after the free, so a
// second call loads null); no outer null guard is needed. call_direct pushes the
// helper's return (the box / count) which is dropped.
function emit_map_buffers_free(s: LowerState, slot: i32): LowerState {
    var st: LowerState = s;
    st = st.emit(ir.op_load_local(slot));
    // #4353: a reclaimable map with a fresh-string VALUE column ("MAPVS:"), a
    // fresh-string KEY column ("MAPKS:") and/or a fresh one-dec-BOX value column
    // ("MAPVA:" — a scalar-element array or an all-scalar struct) routes to the
    // matching deep-release variant. The register backends free a string column via
    // __fern_str_arr_free and a box column via __fern_arrarr_free;
    // wasm_helper_symbol maps every variant to the already-deep $__fern_map_release.
    // MAPVS: and MAPVA: are mutually exclusive (they gate on the declared value
    // type), so the value column takes at most one of the two frees. A map with
    // none keeps the shallow __fern_map_free (boxes in the non-credited column leak
    // one level — sound).
    // Site-keyed with the "MAP:" credit they qualify (#7253) — the three columns
    // are derived from the same collector entry, so a column left on the name key
    // would resolve nothing for a block-scoped map whose base credit resolves, and
    // silently downgrade its deep release to the shallow free.
    var mvs: boolean = slot_credit_at(s, slot, "MAPVS:");
    var mks: boolean = slot_credit_at(s, slot, "MAPKS:");
    var mva: boolean = slot_credit_at(s, slot, "MAPVA:");
    // A struct column with rc fields walks each value box's own fields first;
    // the one-dec free below then takes the boxes.
    if (mva) {
        var vdt: string = map_val_struct_deep_type(map_value_of(s.map_type_of(slot)), s.structs);
        if (vdt != "") { st = st.emit(ir.op_call_direct("__map_vals_struct_drop_" + vdt, 1)); }
    }
    if (mks && mvs) {
        st = st.emit(ir.op_call_direct("__fern_map_free_kvs", 1));
    } else if (mks && mva) {
        st = st.emit(ir.op_call_direct("__fern_map_free_ksva", 1));
    } else if (mks) {
        st = st.emit(ir.op_call_direct("__fern_map_free_ks", 1));
    } else if (mvs) {
        st = st.emit(ir.op_call_direct("__fern_map_free_vs", 1));
    } else if (mva) {
        st = st.emit(ir.op_call_direct("__fern_map_free_va", 1));
    } else {
        st = st.emit(ir.op_call_direct("__fern_map_free", 1));
    }
    st = st.emit(ir.op_drop());
    // zero the slot (a precise drop uses this so the exit-sweep re-call skips).
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    return st;
}

// slot_is_reclaimable_str: slot `i` is a fresh, non-escaping, non-reassigned
// heap-STRING local (`var s: string = a + b`), credited "STR:" by
// reclaimable_names_of. A non-param string slot whose name is in the reclaim
// set. Its box + data buffer are freed via __fern_str_free (asm: box + separate
// buffer; wasm: the rc-headered inline block through $__fern_arr_dec) at the
// loop-rebind (emit_str_reclaim_store) and at scope exit (the string sweep).
// String literals / aliasing forms never reach here (str_local_binding_is_fresh
// admits only fresh producers), so a freed box is always this frame's sole own.
// str_free_helper: which release a reclaimable string slot gets. A trim or
// SFRRECV-chain result can be a fresh box over ANOTHER string's bytes, so freeing
// it as an ordinary string would free data that string still owns;
// __fern_str_view_free frees the box alone when the rc is the immortal view
// sentinel and takes __fern_str_free's path otherwise, which is both what a
// chain link that really allocated needs and what wasm needs (its slices copy, so
// the result is an ordinary owned block).
// emit_str_slot_release emits the release for a reclaimable string slot: the
// plain call, or — when the slot records a slot its box may BE — the same call
// under a guard that the two differ. `replace`'s identity fast-path returns the
// receiver when the needle is absent (measured: zero bytes allocated), and every
// link of an SFRRECV chain may hand its receiver back, so an unguarded free would
// release a box that source still owns. The guard is the `old != new` cow test
// emit_str_reclaim_store already uses, pointed at the recorded source slot
// instead.
//
// Comparing against a slot the sweep may have freed already is safe: the guard
// only compares the pointers, never dereferences, and either order gives the
// right answer — identical means skip, different means this box is ours.
function emit_str_slot_release(s: LowerState, i: i32): LowerState {
    var src: i32 = s.str_identity_src_slot(i);
    if (src < 0) {
        var d: LowerState = s.emit(ir.op_load_local(i));
        d = d.emit(ir.op_call_direct(str_free_helper(d, i), 1));
        return d.emit(ir.op_drop());
    }
    var g: LowerState = s.emit(ir.op_load_local(i));
    g = g.emit(ir.op_load_local(src));
    g = g.emit(ir.op_bin("ne", 0, false));
    g = g.emit(ir.op_if(0));
    g = g.emit(ir.op_load_local(i));
    g = g.emit(ir.op_call_direct(str_free_helper(g, i), 1));
    g = g.emit(ir.op_drop());
    return g.emit(ir.op_end());
}

function str_free_helper(s: LowerState, i: i32): string {
    if (s.is_str_view_local_slot(i)) { return "__fern_str_view_free"; }
    return "__fern_str_free";
}

function slot_is_reclaimable_str(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_str) { return false; }
    // Keyed on the BINDING SITE, not the name (#7292 / #7253 step 1). Two things
    // fall out, and the second is why the name key could not simply be made
    // retirement-aware:
    //
    //   - the key lives ON the slot, so retire_locals' block-exit rename cannot
    //     hide it. A block-scoped string local is swept like any other, closing
    //     the `{ var s = w("ab"); … }` leak (200 allocs / 0 frees per 100 rounds).
    //   - two same-named bindings resolve to their OWN credit. Switching the old
    //     lookup to a retirement-aware NAME instead would have swept a slot holding a
    //     bare alias under a sibling block's credit — measured as exit 99 on
    //     str-bind-sfrrecv-same-name-alias-liveness, an over-release of a live
    //     struct field. The exact-match miss was accidentally shielding that.
    return reclaim_has(s.reclaimable_names, "STR:", s.reclaim_site_key(i));
}

// slot_is_reclaimable_strarr: slot `i` is a fresh, non-escaping string[] local
// whose every stored element is provably fresh/static and whose element pointers
// never outlive the frame (#4355) — credited "SARR:" by reclaimable_names_of. A
// non-param string-array slot whose name is in the reclaim set. The exit sweep
// frees it with __fern_str_arr_free (rc==1-gated element walk via the rc-aware
// per-element string free, then the buffer) instead of the shallow buffer-only
// __fern_rc_dec every other array slot gets.
// optaarr_ann_is (#4365): the annotation spells an array of Options of a
// leak-safe scalar-element array — "Option[i32[]][]" and siblings. Textual,
// like the dyn passes: strip the outer "[]", require "Option[<inner>]" with a
// leak-safe scalar array inner.
function optaarr_ann_is(type_name: string): boolean {
    if (type_name.len() < 12) { return false; }
    if (slice_unchecked(type_name, type_name.len() - 2, type_name.len()) != "[]") { return false; }
    var elem: str = slice_unchecked(type_name, 0, type_name.len() - 2);
    if (elem.len() < 10 || slice_unchecked(elem, 0, 7) != "Option[") { return false; }
    if (elem[elem.len() - 1] != b']') { return false; }
    return is_leaksafe_array_field(slice_unchecked(elem, 7, elem.len() - 1));
}

// optaarr_lit_is_fresh (#4365): a non-empty array literal whose every element
// is `None` or `Some(<array literal>)` — the option boxes AND the payload
// buffers are all constructed fresh at the binding, so the three-level
// structure is sole-owned. Payload element exprs are unconstrained (scalar
// elements value-copy, like arrarr_lit_is_fresh's rows).
function optaarr_lit_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < arr.elements.len()) {
                var ok: boolean = false;
                match (arr.elements[i]) {
                    ast.ExprIdent(nid) => { if (nid.name == "None") { ok = true; } },
                    ast.ExprCall(sc) => {
                        match (sc.callee) {
                            ast.ExprIdent(scid) => {
                                if (scid.name == "Some" && sc.args.len() == 1) {
                                    match (sc.args[0]) {
                                        ast.ExprArray(_) => { ok = true; },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
                if (!ok) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// optaarr_elem_payload_escapes (#4365): any `match (xs[i])` in the body whose
// Some-arm BINDING escapes the arm (returned / stored / aliased —
// binding_escapes_arm via opt_arm_binding_escapes). A borrow-only bind
// (`Some(p) => p[0]`) is fine: its reads precede the rebind/exit free. The
// index-scrutinee sibling of opt_body_binding_escapes (which keys on ident
// scrutinees).
function optaarr_elem_payload_escapes(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var is_elem: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIndex(ix) => {
                        match (ix.array) {
                            ast.ExprIdent(aid) => { if (aid.name == name) { is_elem = true; } },
                            _ => {}
                        }
                    },
                    _ => {}
                }
                if (is_elem && opt_arm_binding_escapes(stmt, "Some", false)) { return true; }
                for arm in m.arms {
                    if (optaarr_elem_payload_escapes(arm.body, name)) { return true; }
                }
            },
            ast.StmtIf(f) => { if (optaarr_elem_payload_escapes(f.then_body, name) || optaarr_elem_payload_escapes(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (optaarr_elem_payload_escapes(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (optaarr_elem_payload_escapes(fo.body, name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// opttup_inner_type: for a type string `Option[<inner>]`, return `<inner>` (the
// payload type), or "". Comma-preserving — the inner may itself be a tuple type.
function opttup_inner_type(type_name: string): string {
    if (type_name.len() < 9) { return ""; }
    if (slice_unchecked(type_name, 0, 7) != "Option[") { return ""; }
    if (type_name[type_name.len() - 1] != b']') { return ""; }
    return slice_unchecked(type_name, 7, type_name.len() - 1) + "";
}

// opttup_ann_is (#4365): the local's type annotation is `Option[<tuple-with-array>]`
// — a single Option box whose Some payload is a deep-droppable tuple (carries a
// fresh scalar array at some depth). The single-box sibling of optaarr_ann_is.
function opttup_ann_is(type_name: string, structs: parser.StructDecl[]): boolean {
    var inner: string = opttup_inner_type(type_name);
    if (inner == "") { return false; }
    return tuple_field_deep_droppable(inner, structs);
}

// opttup_init_is_fresh (#4365): the binding init is `Some(<fresh tuple literal>)`
// (tuple_arg_payload_fresh — every array position a direct literal, so the
// type-driven drop sole-owns each buffer) or `None` (nothing to reclaim, admitted
// for uniformity). Anything else (a bare-ident/call Some payload aliasing a live
// value) declines — freeing the payload would double-release.
function opttup_init_is_fresh(inner: string, e: ast.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) { return tuple_arg_payload_fresh(inner, c.args[0], structs); }
                    return false;
                },
                _ => { return false; }
            }
        },
        ast.ExprIdent(nid) => { return nid.name == "None"; },
        _ => { return false; }
    }
    return false;
}

// opttup_arm_expr_escapes: does expression `e` use the Some-payload binding `p`
// (a tuple, type `inner`) in a way that lets an owned ARRAY sub-field (or the
// whole tuple) outlive the arm? The existing binding_escapes_arm treats `p.N` as
// a borrow (its "name.field is a borrow" rule is right for an ARRAY payload but
// WRONG for a tuple — `p.1` EXTRACTS an owned array), so OPTTUP needs this
// stricter, type-aware walker. Borrow-only reads that are SAFE:
//   - `p.N` where field N is a SCALAR (a value copy),
//   - `p.N[i]` (an array-element read — the array field is only indexed),
//   - `p.N.len()` (the one whitelisted read method on an array field).
// Anything else touching `p` — a bare `p`, a bare `p.<arrayfield>` (stored /
// returned / passed / aliased / sliced), a non-`len` method on an array field, a
// nested-tuple sub-field — is an ESCAPE (rejected). Erring toward rejection is a
// safe LEAK, never an over-release.
function opttup_arm_expr_escapes(e: ast.Expr, p: string, inner: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == p; },   // bare tuple escapes
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprFieldAccess(fa) => {
            // `p.N` bare: a scalar field is a safe value copy; an array / nested /
            // struct field extracted bare escapes.
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name == p && util.is_all_digits(fa.field)) {
                        var tag: string = tuple_type_elem_tag(inner, util.digits_to_i32(fa.field));
                        return !is_scalar_type_name(tag);
                    }
                    return false;
                },
                ast.ExprFieldAccess(ofa) => {
                    // `p.N.field`: struct-field read of a struct tuple element. A SCALAR
                    // field is a borrow (safe); a struct ARRAY/pointer field extracted bare
                    // escapes (its buffer the reclaim would free). #4365.
                    match (ofa.obj) {
                        ast.ExprIdent(oid2) => {
                            if (oid2.name == p && util.is_all_digits(ofa.field)) {
                                var stag: string = tuple_type_elem_tag(inner, util.digits_to_i32(ofa.field));
                                if (decl_is_struct(structs, stag)) {
                                    var sft: string = decl_field_type(structs, stag, fa.field);
                                    return !is_scalar_type_name(sft);
                                }
                            }
                        },
                        _ => {}
                    }
                    return opttup_arm_expr_escapes(fa.obj, p, inner, structs);
                },
                _ => { return opttup_arm_expr_escapes(fa.obj, p, inner, structs); }
            }
        },
        ast.ExprIndex(ix) => {
            // `p.N[i]`: the array field is only indexed (a safe element read) — check
            // just the index expression. Any other base recurses normally.
            match (ix.array) {
                ast.ExprFieldAccess(bfa) => {
                    match (bfa.obj) {
                        ast.ExprIdent(bid) => {
                            if (bid.name == p && util.is_all_digits(bfa.field)) { return opttup_arm_expr_escapes(ix.index, p, inner, structs); }
                        },
                        // `p.N.field[i]`: indexed struct ARRAY-field read — safe; check the index.
                        ast.ExprFieldAccess(bofa) => {
                            match (bofa.obj) {
                                ast.ExprIdent(bid2) => {
                                    if (bid2.name == p && util.is_all_digits(bofa.field)) { return opttup_arm_expr_escapes(ix.index, p, inner, structs); }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return opttup_arm_expr_escapes(ix.array, p, inner, structs) || opttup_arm_expr_escapes(ix.index, p, inner, structs);
        },
        ast.ExprCall(c) => {
            // `p.N.len()` and `p.N.field.len()`: whitelisted borrow methods on an array
            // field — safe receiver, check the args. Any other call touching p escapes.
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        match (cfa.obj) {
                            ast.ExprFieldAccess(pfa) => {
                                match (pfa.obj) {
                                    // `p.N.len()`: array tuple-element length.
                                    ast.ExprIdent(pid) => {
                                        if (pid.name == p && util.is_all_digits(pfa.field)) {
                                            for arg in c.args { if (opttup_arm_expr_escapes(arg, p, inner, structs)) { return true; } }
                                            return false;
                                        }
                                    },
                                    // `p.N.field.len()`: struct array-field length.
                                    ast.ExprFieldAccess(ppfa) => {
                                        match (ppfa.obj) {
                                            ast.ExprIdent(ppid) => {
                                                if (ppid.name == p && util.is_all_digits(ppfa.field)) {
                                                    for arg in c.args { if (opttup_arm_expr_escapes(arg, p, inner, structs)) { return true; } }
                                                    return false;
                                                }
                                            },
                                            _ => {}
                                        }
                                    },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            if (opttup_arm_expr_escapes(c.callee, p, inner, structs)) { return true; }
            for arg in c.args { if (opttup_arm_expr_escapes(arg, p, inner, structs)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return opttup_arm_expr_escapes(b.left, p, inner, structs) || opttup_arm_expr_escapes(b.right, p, inner, structs); },
        ast.ExprUnary(u) => { return opttup_arm_expr_escapes(u.operand, p, inner, structs); },
        ast.ExprSlice(sl) => { return opttup_arm_expr_escapes(sl.array, p, inner, structs) || opttup_arm_expr_escapes(sl.start, p, inner, structs) || opttup_arm_expr_escapes(sl.end, p, inner, structs); },
        ast.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { if (opttup_arm_expr_escapes(ar.elements[i], p, inner, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (opttup_arm_expr_escapes(el, p, inner, structs)) { return true; } }
            return false;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base && opttup_arm_expr_escapes(sl.base, p, inner, structs)) { return true; }
            for fv in sl.field_values { if (opttup_arm_expr_escapes(fv, p, inner, structs)) { return true; } }
            return false;
        },
        _ => { return false; }
    }
    return false;
}
function opttup_arm_stmt_escapes(st: ast.Stmt, p: string, inner: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return opttup_arm_expr_escapes(v.init, p, inner, structs); },
        ast.StmtReturn(r) => { return opttup_arm_expr_escapes(r.value, p, inner, structs); },
        ast.StmtExpr(e) => { return opttup_arm_expr_escapes(e.value, p, inner, structs); },
        ast.StmtAssign(a) => { return opttup_arm_expr_escapes(a.value, p, inner, structs); },
        ast.StmtIf(f) => {
            if (opttup_arm_expr_escapes(f.cond, p, inner, structs)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (opttup_arm_stmt_escapes(f.then_body[ti], p, inner, structs)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (opttup_arm_stmt_escapes(f.else_body[ei], p, inner, structs)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (opttup_arm_expr_escapes(w.cond, p, inner, structs)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (opttup_arm_stmt_escapes(w.body[i], p, inner, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (opttup_arm_expr_escapes(fo.iter, p, inner, structs)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (opttup_arm_stmt_escapes(fo.body[i], p, inner, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (opttup_arm_expr_escapes(m.scrutinee, p, inner, structs)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && opttup_arm_expr_escapes(arm.guard, p, inner, structs)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (opttup_arm_stmt_escapes(arm.body[bi], p, inner, structs)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return opttup_arm_stmt_escapes(d.action, p, inner, structs); },
        _ => { return false; }
    }
    return false;
}

// opttup_payload_escapes: for the option local `name` (payload tuple type `inner`),
// does the consuming `match (name)`'s Some-arm use its bound payload in an escaping
// way (opttup_arm_expr/stmt_escapes)? The tuple-aware replacement for
// opt_body_binding_escapes in the OPTTUP admission. Scans nested blocks for the
// `match (name)`; a `Some(_)` (no binding) never escapes.
function opttup_payload_escapes(stmts: ast.Stmt[], name: string, inner: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var is_scrut: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { if (sid.name == name) { is_scrut = true; } },
                    _ => {}
                }
                if (is_scrut) {
                    for arm in m.arms {
                        match (arm.pattern) {
                            ast.PatVariant(pv) => {
                                var vn: string = pv.type_name;
                                var vc: i32 = 0;
                                while (vc < pv.type_name.len()) { if (pv.type_name[vc] == b'.') { vn = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; } vc = vc + 1; }
                                if (vn == "Some" && pv.binding != "" && pv.binding != "_") {
                                    if (arm.has_guard && opttup_arm_expr_escapes(arm.guard, pv.binding, inner, structs)) { return true; }
                                    var bi: i32 = 0;
                                    while (bi < arm.body.len()) { if (opttup_arm_stmt_escapes(arm.body[bi], pv.binding, inner, structs)) { return true; } bi = bi + 1; }
                                }
                            },
                            _ => {}
                        }
                    }
                }
                for arm in m.arms { if (opttup_payload_escapes(arm.body, name, inner, structs)) { return true; } }
            },
            ast.StmtIf(f) => { if (opttup_payload_escapes(f.then_body, name, inner, structs) || opttup_payload_escapes(f.else_body, name, inner, structs)) { return true; } },
            ast.StmtWhile(w) => { if (opttup_payload_escapes(w.body, name, inner, structs)) { return true; } },
            ast.StmtFor(fo) => { if (opttup_payload_escapes(fo.body, name, inner, structs)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// collect_fresh_opttup_names: `var o: Option[(i32, i32[])] = Some((i, [i, i+1]))`
// bindings consumed by exactly one borrow-only `match (o)` in the SAME block —
// the single-Option-box analogue of collect_fresh_rcenum_names. Block-level
// gating (NOT body_unsafe_for, which flags the consuming match scrutinee as an
// escape): the match must be the sole consumer (n_match == 1, after the binding),
// its arms must not re-reference o (match_arms_use_name), its Some-arm must bind
// the payload only as a borrow (opt_body_binding_escapes false), and o must not be
// used or escape anywhere outside that match (name_used_after /
// name_escapes_outside_stmt with the match skipped). Recurses nested blocks.
//
// A REASSIGNED name is admitted when every rebind is itself fresh
// (opt_rebinds_all_fresh, #6127). It used to be refused outright, which left a
// loop-rebound Option credited nowhere at all and leaking every box it built —
// 60000 bytes over 100 rounds with ZERO releases emitted. #6225 established the
// per-rebind discipline for the flat-array kind; this is the same relaxation for
// the tuple payload.
function collect_fresh_opttup_names(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                if (opttup_ann_is(v.type_name, structs)
                    && opttup_init_is_fresh(opttup_inner_type(v.type_name), v.init, structs)
                    && (util.index_of_str(reassigned, v.name) < 0
                        || opt_rebinds_all_fresh(stmts, v.name, "tup", opttup_inner_type(v.type_name), structs, sig_reg_empty(), []))) {
                    // The consuming match may sit one block deeper (#6319). No
                    // nested_ok flag is needed here, unlike the scalar and rc-payload
                    // collectors: NOTHING else claims this shape at either scope —
                    // both nested cells leaked (12000 fn-scoped, 48000 block-scoped)
                    // while both flat cells were 0 — so there is no territory to
                    // divide. Liveness and escape take the enclosing statement; the
                    // arm check takes the match itself.
                    var match_idx: i32 = sole_consuming_match_idx(stmts, v.name);
                    var msv: ast.Stmt[] = [];
                    if (match_idx > vi) { msv = consuming_match_of(stmts[match_idx], v.name); }
                    if (match_idx > vi && msv.len() == 1
                        && !match_arms_use_name(msv[0], v.name)
                        && !opttup_payload_escapes(stmts, v.name, opttup_inner_type(v.type_name), structs)
                        && !name_used_after(stmts, v.name, match_idx)
                        && !name_escapes_outside_stmt(stmts, v.name, match_idx)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_opttup_names(f.then_body, structs, a); a = collect_fresh_opttup_names(f.else_body, structs, a); },
            ast.StmtWhile(w) => { a = collect_fresh_opttup_names(w.body, structs, a); },
            ast.StmtFor(fo) => { a = collect_fresh_opttup_names(fo.body, structs, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_opttup_names(arm.body, structs, a); }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

// collect_fresh_optaarr_names: `var xs: Option[i32[]][] = [Some([..]), None]`
// bindings, recursing nested blocks. Escape gates applied by
// reclaimable_names_of (body_unsafe_for + not-reassigned + no element alias
// via arrarr_row_escapes_boxiter — a bound `var o = xs[i]` element holds an
// option box the free would dangle).
function collect_fresh_optaarr_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (optaarr_ann_is(v.type_name) && optaarr_lit_is_fresh(v.init)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
            },
            ast.StmtIf(f) => { a = collect_fresh_optaarr_names(f.then_body, a); a = collect_fresh_optaarr_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = collect_fresh_optaarr_names(w.body, a); },
            ast.StmtFor(fo) => { a = collect_fresh_optaarr_names(fo.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_optaarr_names(arm.body, a); }
            },
            _ => {}
        }
    }
    return a;
}

// structarr_lit_is_fresh: `e` is a non-empty array literal whose EVERY element
// is a fresh, no-base struct LITERAL (`[P { .. }, P { .. }]`). Each element box
// is freshly allocated (rc=1) and solely owned by the outer buffer, so the
// SHALLOW per-element box dec the reclaim performs (via __fern_arrarr_free,
// which arr_dec's each element pointer then frees the outer buffer) frees each
// element exactly once and can never dangle a caller's reference. A `{ ...base }`
// update or a call/ident element is excluded — the box might alias a live value
// whose owner also frees it. NB: the elements' own rc-array / string FIELDS are
// NOT deep-dropped (they leak, sound) — that is the type-specialised follow-up;
// this slice reclaims the currently-leaked element BOXES + outer buffer.
function structarr_lit_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(outer) => {
            if (outer.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < outer.elements.len()) {
                match (outer.elements[i]) {
                    ast.ExprStructLit(sl) => { if (sl.has_base) { return false; } },
                    _ => { return false; }
                }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// structarr_elem_store_ok: `e` is an element safe to APPEND to a struct-array
// candidate that will later have its element boxes freed — a fresh, no-base
// struct LITERAL, the same per-element rule structarr_lit_is_fresh applies to an
// initializer. An ident element would alias a live local whose box the reclaim
// would dangle; a `...base` copy shares the base's field pointers.
//
// A CALL to a strict-fresh struct-returning function (`fresh_ret` — every return
// a no-base literal whose array fields come from fresh array literals) is the
// same freshness one call frame out: the returned box is rc=1 and unaliased, so
// the array is its sole owner exactly as for an inline literal. The looser
// fresh_struct_ret_fns is NOT enough — it admits alias-inc'd field buffers. A
// METHOD call declines: the receiver type is not known here, so `<Base>.<m>`
// keys cannot be looked up (conservative, no admission).
function structarr_elem_store_ok(e: ast.Expr, fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprStructLit(sl) => { return !sl.has_base; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { return util.index_of_str(fresh_ret, cid.name) >= 0; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// structarr_self_append_elem: `e` is the sanctioned self-append rebind of
// `name` — `name.append(<fresh element>)`, per structarr_elem_store_ok.
function structarr_self_append_elem(e: ast.Expr, name: string, fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var is_self_append: boolean = false;
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "append") {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => { is_self_append = rid.name == name; },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            if (!is_self_append) { return false; }
            if (c.args.len() != 1) { return false; }
            return structarr_elem_store_ok(c.args[0], fresh_ret);
        },
        _ => { return false; }
    }
    return false;
}

// structarr_name_is_appended: `name` takes at least one sanctioned self-append,
// which is what admits an empty-literal init as an append-built candidate.
function structarr_name_is_appended(stmts: ast.Stmt[], name: string, fresh_ret: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => { if (a.target == name && structarr_self_append_elem(a.value, name, fresh_ret)) { return true; } },
            ast.StmtIf(f) => {
                if (structarr_name_is_appended(f.then_body, name, fresh_ret)) { return true; }
                if (structarr_name_is_appended(f.else_body, name, fresh_ret)) { return true; }
            },
            ast.StmtWhile(w) => { if (structarr_name_is_appended(w.body, name, fresh_ret)) { return true; } },
            ast.StmtFor(fo) => { if (structarr_name_is_appended(fo.body, name, fresh_ret)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (structarr_name_is_appended(arm.body, name, fresh_ret)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

// structarr_unsafe_for / stmt_structarr_unsafe_for: body_unsafe_for with exactly
// one sanctioned reassignment — the self-append rebind (#6127). The same shape
// arrarr_unsafe_for takes for the two-level class, and for the same reason: the
// STRUCTARR credit refused any reassigned name, so an append-built struct array
// never qualified and leaked an element box per append.
//
// Only the assign case differs from stmt_unsafe_for; everything else delegates,
// which is sound because this class's own element hazard — a bound element box
// — is checked separately by structarr_elem_escapes, applied alongside this gate.
function structarr_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], fresh_ret: string[]): boolean {
    for stmt in stmts { if (stmt_structarr_unsafe_for(stmt, name, borrowable, fresh_ret)) { return true; } }
    return false;
}
function stmt_structarr_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], fresh_ret: string[]): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target == name) {
                if (structarr_self_append_elem(a.value, name, fresh_ret)) { return false; }
                return true;   // any other reassignment of the candidate
            }
            return expr_unsafe_for(a.value, name, borrowable, []);
        },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, [])) { return true; }
            return structarr_unsafe_for(f.then_body, name, borrowable, fresh_ret) || structarr_unsafe_for(f.else_body, name, borrowable, fresh_ret);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, [])) { return true; }
            return structarr_unsafe_for(w.body, name, borrowable, fresh_ret);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, []); }
            }
            if (iter_unsafe) { return true; }
            return structarr_unsafe_for(fo.body, name, borrowable, fresh_ret);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, [])) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) { return true; }
                if (structarr_unsafe_for(arm.body, name, borrowable, fresh_ret)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_structarr_unsafe_for(d.action, name, borrowable, fresh_ret); },
        _ => { return stmt_unsafe_for(st, name, borrowable, []); }
    }
    return false;
}

// collect_fresh_structarr_names: `var g = [P { .. }, P { .. }]` bindings whose
// init is a fresh struct-literal array (structarr_lit_is_fresh), or a call to a
// "STRUCTARRF:" producer, recursing nested blocks. Escape gates (body_unsafe_for
// + not-reassigned + structarr_elem_escapes) are applied by reclaimable_names_of.
// The literal arms need no annotation check — an all-struct-literal init both
// proves freshness AND makes the declaration path mark the slot is_arr with its
// element struct type, which slot_is_reclaimable_structarr consults; a call init
// carries no such evidence, so the producer arm reads the annotation instead.
function collect_fresh_structarr_names(stmts: ast.Stmt[], body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (structarr_lit_is_fresh(v.init)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                // APPEND-BUILT candidate (#6127): `var g: P[] = []` grown by
                // `g = g.append(P { .. })`. structarr_lit_is_fresh rejects `[]`
                // (no elements to prove fresh) — right for a literal-only
                // credit, but it left every append-built struct array
                // uncredited, leaking one element box per append. Measured on
                // the leakcheck differential at 38400 bytes over 100 rounds,
                // scaling linearly, where native leaks nothing.
                else if (arrarr_lit_is_empty(v.init) && structarr_name_is_appended(stmts, v.name, fresh_ret)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    // "A|" marks it append-BUILT so the crediting loop can grant
                    // the separate, stricter STRUCTARRA: credit — same marker
                    // trick collect_fresh_arrarr_names uses for its "S|" rows.
                    a = push_str_unique(a, "A|" + reclaim_site_key_of(v.name, v.line, v.col));
                }
                // A producer CALL, the "STRUCTARRF:" sibling of the arrstruct arm
                // (#7445): the annotation supplies the element struct type and the
                // registry proves every returned element box is the callee's own,
                // so the binding earns exactly the credit the literal it returns
                // would have earned one frame in.
                else if (structarr_elem_struct_type(v.type_name, structs) != ""
                    && struct_arr_call_producer(v.init, body, fresh_ret, "STRUCTARRF:")) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_structarr_names(f.then_body, body, structs, fresh_ret, a); a = collect_fresh_structarr_names(f.else_body, body, structs, fresh_ret, a); },
            ast.StmtWhile(w) => { a = collect_fresh_structarr_names(w.body, body, structs, fresh_ret, a); },
            ast.StmtFor(fo) => { a = collect_fresh_structarr_names(fo.body, body, structs, fresh_ret, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_structarr_names(arm.body, body, structs, fresh_ret, a); }
            },
            _ => {}
        }
    }
    return a;
}

// collect_fresh_arrarr_names gathers LOCAL names bound from a fresh
// arr-of-arr literal (`var g = [[..], [..]]`, arrarr_lit_is_fresh) anywhere in
// the body (#4355 slice 9), or — slice 10 — from a CALL to a function in the
// "AAC:" registry (opt_fresh_ret_fns_of proved every return of the callee is a
// fresh arrarr literal, so the call result is rc=1 and solely owned here; the
// self-host IR path has no return-transfer inc). `ofr` is the opt_fresh_ret
// registry list the AAC:/AACS-flag entries ride in. Escape gates applied by
// reclaimable_names_of.
function collect_fresh_arrarr_names(stmts: ast.Stmt[], ofr: SigReg, acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            ast.StmtVar(v) => {
                if (arrarr_lit_is_fresh(v.init, stmts, i)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    // strings-fresh marker: lets the crediting loop grant the
                    // STRICT "ARRARRS:" credit a string-kind slot requires.
                    if (arrarr_lit_strings_fresh(v.init, stmts, i)) { a = push_str_unique(a, "S|" + reclaim_site_key_of(v.name, v.line, v.col)); }
                } else if (arrarr_lit_is_empty(v.init) && arrarr_name_is_appended(stmts, v.name, ofr)) {
                    // APPEND-BUILT candidate (#6092): `var g: T[][] = []` grown by
                    // `g = g.append(<row literal>)`. arrarr_lit_is_fresh rejects
                    // `[]` (no rows to prove fresh), which is right for a
                    // literal-only credit but left the append shape uncredited and
                    // leaking its rows. Every rebind's row is validated by
                    // arrarr_self_append_row here and again by the arrarr_unsafe_for
                    // gate at the crediting site; the strict string marker needs
                    // EVERY appended row strings-fresh.
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    if (arrarr_appends_strings_fresh(stmts, v.name, ofr)) { a = push_str_unique(a, "S|" + reclaim_site_key_of(v.name, v.line, v.col)); }
                } else {
                    // Call init `var g: T[][] = mk(..)` of an AAC-registered
                    // producer: same credits the literal it returns would earn.
                    // flag "s" = every return also strings-fresh (strict marker);
                    // "p" = rows-are-literals only (lax credit — enough for
                    // scalar-kind slots; a string-kind slot stays excluded).
                    match (v.init) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprIdent(cid) => {
                                    if (sig_reg_has_exact(ofr, "AAC:" + cid.name + "|s")) {
                                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                                        a = push_str_unique(a, "S|" + reclaim_site_key_of(v.name, v.line, v.col));
                                    } else {
                                        if (sig_reg_has_exact(ofr, "AAC:" + cid.name + "|p")) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_arrarr_names(f.then_body, ofr, a); a = collect_fresh_arrarr_names(f.else_body, ofr, a); },
            ast.StmtWhile(w) => { a = collect_fresh_arrarr_names(w.body, ofr, a); },
            ast.StmtFor(fo) => { a = collect_fresh_arrarr_names(fo.body, ofr, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_arrarr_names(arm.body, ofr, a); }
            },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

// arrarr_lit_is_fresh: `e` is a non-empty array literal whose EVERY element is
// itself an array LITERAL — every row buffer is freshly constructed, so the
// two-level structure is sole-owned at the outer level. Inner ELEMENT
// freshness is kind-dependent: scalar elements (numbers / idents / binaries)
// are VALUE-copied into the row buffer, so any expression is safe; string
// elements are POINTER-stored, so the STRICT sibling below must also pass
// before a string-kind slot is freed (the slot's type-aware arrarr_elem
// picks which credit slot_is_reclaimable_arrarr consults).
function arrarr_lit_is_fresh(e: ast.Expr, stmts: ast.Stmt[], k: i32): boolean {
    match (e) {
        ast.ExprArray(outer) => {
            if (outer.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < outer.elements.len()) {
                if (!arrarr_row_is_fresh(outer.elements[i], stmts, k)) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// arrarr_row_effective: the array literal a ROW's contents can be read from —
// the row itself when it is written inline, or the initializer of the local it
// names when this construction is that local's last use. Anything else comes
// back unchanged, and every test below then fails it.
//
// A local row is admitted only when it is declared earlier in THIS statement
// list from an array LITERAL, is mentioned nowhere between that declaration and
// `k`, appears exactly once in `k`, and is never read afterwards. Together those
// say the arr-of-arr construction consumes the local, which is the invariant a
// literal row gets for free: its buffer is born in the slot, so the deep reclaim
// frees nothing anything else still reads.
function arrarr_row_effective(e: ast.Expr, stmts: ast.Stmt[], k: i32): ast.Expr {
    match (e) {
        ast.ExprIdent(id) => {
            if (k < 0 || k >= stmts.len()) { return e; }
            var decl: i32 = 0 - 1;
            var j: i32 = 0;
            while (j < k) {
                match (stmts[j]) {
                    ast.StmtVar(v) => {
                        if (v.name == id.name) {
                            decl = 0 - 1;
                            match (v.init) {
                                ast.ExprArray(_) => { decl = j; },
                                _ => {}
                            }
                        }
                    },
                    _ => {}
                }
                j = j + 1;
            }
            if (decl < 0) { return e; }
            var b: i32 = decl + 1;
            while (b < k) {
                if (rc_ml_count_in_stmt(stmts[b], id.name) != 0) { return e; }
                b = b + 1;
            }
            if (!rc_ml_last_use(stmts, id.name, k)) { return e; }
            match (stmts[decl]) {
                ast.StmtVar(dv) => { return dv.init; },
                _ => { return e; }
            }
        },
        _ => { return e; }
    }
    return e;
}

// arrarr_row_is_fresh: one ROW of an arr-of-arr literal owns its own buffer.
function arrarr_row_is_fresh(e: ast.Expr, stmts: ast.Stmt[], k: i32): boolean {
    match (arrarr_row_effective(e, stmts, k)) {
        ast.ExprArray(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// arrarr_row_elems_strings_fresh: every element of one ROW is a string LITERAL
// or a fresh producer — the per-row half of arrarr_lit_strings_fresh.
function arrarr_row_elems_strings_fresh(row: ast.Expr): boolean {
    match (row) {
        ast.ExprArray(r) => {
            var j: i32 = 0;
            while (j < r.elements.len()) {
                var ok: boolean = false;
                match (r.elements[j]) {
                    ast.ExprString(_) => { ok = true; },
                    _ => { ok = str_local_binding_is_fresh(r.elements[j]); }
                }
                if (!ok) { return false; }
                j = j + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// arrarr_lit_strings_fresh: every inner element of every row is a string
// LITERAL or a fresh producer (concat / string method / named producer) —
// the strict gate for string-kind inners, whose pointers the reclaim frees
// (an ident element would alias a live local the free would dangle). A row
// that names a local is read through arrarr_row_effective, so its elements are
// proved off the declaration's literal — and only when that local is this
// statement's to consume.
function arrarr_lit_strings_fresh(e: ast.Expr, stmts: ast.Stmt[], k: i32): boolean {
    match (e) {
        ast.ExprArray(outer) => {
            var i: i32 = 0;
            while (i < outer.elements.len()) {
                if (!arrarr_row_elems_strings_fresh(arrarr_row_effective(outer.elements[i], stmts, k))) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// arrarr_row_store_ok: `e` is a row safe to APPEND to an arr-of-arr candidate
// that will later be deep-freed — a fresh array LITERAL. An ident row would
// alias a live local whose buffer the reclaim would dangle. The initializer
// rule (arrarr_row_effective) also admits an ident whose local this statement
// consumes; a rebind's row is not reached by that proof, so it is not taken
// here.
function arrarr_row_store_ok(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// arrarr_row_store_strings_fresh: the STRICT sibling for string-kind inners —
// every element of the appended row is a string literal or a fresh producer,
// mirroring arrarr_lit_strings_fresh's inner-element rule. A string-kind slot
// frees element POINTERS, so an ident element would dangle a live local.
function arrarr_row_store_strings_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(row) => {
            var j: i32 = 0;
            while (j < row.elements.len()) {
                var ok: boolean = false;
                match (row.elements[j]) {
                    ast.ExprString(_) => { ok = true; },
                    _ => { ok = str_local_binding_is_fresh(row.elements[j]); }
                }
                if (!ok) { return false; }
                j = j + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// arrarr_unsafe_for / stmt_arrarr_unsafe_for: body_unsafe_for with exactly one
// sanctioned reassignment — the self-append rebind `g = g.append(<row literal>)`
// (#6092). The string[] class has had this since #4355 ("the self-append rebind
// IS a reassignment; the gate validates each one individually"); the arr-of-arr
// class took the blunt `reassigned` exclusion instead, so an append-BUILT
// `T[][]` fell out of the credit and its rows leaked — sound, but unbounded in
// a loop: 200 rounds x 3 rows leaked 33600 bytes where native freed everything.
//
// Only the assign case differs from stmt_unsafe_for, so every other hazard
// still routes through expr_unsafe_for / body_unsafe_for. That is sound here
// because the arr-of-arr class's own element hazard — a bound ROW pointer — is
// checked separately by arrarr_row_escapes, which the credit applies alongside
// this gate. The sanctioned form never descends into its own receiver, so
// `g` appearing as the append receiver is not read as an escape.
function arrarr_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], ofr: SigReg): boolean {
    for stmt in stmts { if (stmt_arrarr_unsafe_for(stmt, name, borrowable, ofr)) { return true; } }
    return false;
}
function stmt_arrarr_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], ofr: SigReg): boolean {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target == name) {
                if (arrarr_self_append_row(a.value, name, ofr) >= 0) { return false; }
                return true;   // any other reassignment of the candidate
            }
            return expr_unsafe_for(a.value, name, borrowable, []);
        },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, [])) { return true; }
            return arrarr_unsafe_for(f.then_body, name, borrowable, ofr) || arrarr_unsafe_for(f.else_body, name, borrowable, ofr);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, [])) { return true; }
            return arrarr_unsafe_for(w.body, name, borrowable, ofr);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, []); }
            }
            if (iter_unsafe) { return true; }
            return arrarr_unsafe_for(fo.body, name, borrowable, ofr);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, [])) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) { return true; }
                if (arrarr_unsafe_for(arm.body, name, borrowable, ofr)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_arrarr_unsafe_for(d.action, name, borrowable, ofr); },
        _ => { return stmt_unsafe_for(st, name, borrowable, []); }
    }
    return false;
}

// arrarr_self_append_row classifies `e` as the sanctioned self-append rebind of
// `name`: -1 = not the form (or an unsafe row), 0 = a fresh row whose elements
// are NOT all proven strings-fresh (lax — enough for a scalar-kind slot), 1 =
// also strings-fresh (the strict credit a string-kind slot needs). Splitting the
// two here keeps the caller from re-walking the row.
function arrarr_self_append_row(e: ast.Expr, name: string, ofr: SigReg): i32 {
    match (e) {
        ast.ExprCall(c) => {
            var is_self_append: boolean = false;
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field == "append") {
                        match (fa.obj) {
                            ast.ExprIdent(rid) => { is_self_append = rid.name == name; },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            if (!is_self_append) { return -1; }
            if (c.args.len() != 1) { return -1; }
            if (arrarr_row_store_ok(c.args[0])) {
                if (arrarr_row_store_strings_fresh(c.args[0])) { return 1; }
                return 0;
            }
            // A CALL to a registered fresh-ROW producer (#6102): the callee's
            // every return hands back a freshly-allocated, solely-owned buffer,
            // so the appended row is as safe to deep-free as a literal. Without
            // this the row leaked one buffer per append — the residue #6092
            // left behind, and the shape its own repro used.
            return arrarr_row_call_kind(c.args[0], ofr);
        },
        _ => { return -1; }
    }
    return -1;
}

// arrarr_row_call_kind: `e` is a direct call to a function carrying an "ARC:"
// entry — 1 when the entry is strict ("s": every element of every returned row
// is a fresh string, which a string-kind consumer needs before it frees element
// pointers), 0 when lax ("p": the buffer is fresh, enough for a scalar-kind
// consumer), -1 when the callee is not registered.
//
// Only a BARE call qualifies. A method call, or a call wrapped in any other
// expression, is not a proof of freshness and stays out.
function arrarr_row_call_kind(e: ast.Expr, ofr: SigReg): i32 {
    match (e) {
        ast.ExprCall(rc) => {
            match (rc.callee) {
                ast.ExprIdent(rid) => {
                    if (sig_reg_has_exact(ofr, "ARC:" + rid.name + "|s")) { return 1; }
                    if (sig_reg_has_exact(ofr, "ARC:" + rid.name + "|p")) { return 0; }
                    return -1;
                },
                _ => { return -1; }
            }
            return -1;
        },
        _ => { return -1; }
    }
    return -1;
}

// arrarr_appends_strings_fresh: every self-append rebind of `name` in the body
// carried a strings-fresh row. Consulted only for the STRICT "ARRARRS:" credit;
// a body with no rebinds at all trivially passes (the initializer's own strict
// marker still governs).
function arrarr_appends_strings_fresh(stmts: ast.Stmt[], name: string, ofr: SigReg): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name && arrarr_self_append_row(a.value, name, ofr) == 0) { return false; }
            },
            ast.StmtIf(f) => {
                if (!arrarr_appends_strings_fresh(f.then_body, name, ofr)) { return false; }
                if (!arrarr_appends_strings_fresh(f.else_body, name, ofr)) { return false; }
            },
            ast.StmtWhile(w) => { if (!arrarr_appends_strings_fresh(w.body, name, ofr)) { return false; } },
            ast.StmtFor(fo) => { if (!arrarr_appends_strings_fresh(fo.body, name, ofr)) { return false; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (!arrarr_appends_strings_fresh(arm.body, name, ofr)) { return false; }
                }
            },
            _ => {}
        }
    }
    return true;
}

// arrarr_name_is_appended: `name` takes at least one self-append rebind. Used to
// admit an EMPTY-literal init (`var g: i32[][] = []`) as an append-BUILT
// candidate — arrarr_lit_is_fresh rejects `[]` outright (len == 0), which is
// correct for a literal-only credit but excludes the shape this fix is about.
function arrarr_name_is_appended(stmts: ast.Stmt[], name: string, ofr: SigReg): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => { if (a.target == name && arrarr_self_append_row(a.value, name, ofr) >= 0) { return true; } },
            ast.StmtIf(f) => {
                if (arrarr_name_is_appended(f.then_body, name, ofr)) { return true; }
                if (arrarr_name_is_appended(f.else_body, name, ofr)) { return true; }
            },
            ast.StmtWhile(w) => { if (arrarr_name_is_appended(w.body, name, ofr)) { return true; } },
            ast.StmtFor(fo) => { if (arrarr_name_is_appended(fo.body, name, ofr)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (arrarr_name_is_appended(arm.body, name, ofr)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

// arrarr_lit_is_empty: `e` is the empty array literal `[]` — the initializer of
// an append-built candidate.
function arrarr_lit_is_empty(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(outer) => { return outer.elements.len() == 0; },
        _ => { return false; }
    }
    return false;
}

// arrarr_row_escapes: a bare single-index ELEMENT read (`var o = xs[i]` /
// `o = xs[i]`) or a `for o in xs` iteration binds an INNER pointer that would
// dangle when the reclaim frees the whole structure — such a use rejects the
// candidate. Transient double-index / method-receiver borrows (`g[i][j]`,
// `g[i].len()`) don't bind the element and stay admissible (they're inside
// larger expressions, not a bare ExprIndex RHS).
//
// This is the STRICT form, for the class whose element is a tuple BOX (ARRTUP):
// the is_arr retain in lower_stmt_var fires on ARRAY-typed binds, so a box bind
// takes no counted retain and an index read really is a bare borrow there. The
// arr-of-arr class, whose elements ARE array buffers, takes
// arrarr_row_escapes_iter; the option-element class takes
// arrarr_row_escapes_boxiter — see the two below.
function arrarr_row_escapes(stmts: ast.Stmt[], name: string): boolean {
    return arrarr_row_escapes_ex(stmts, name, false, [], false);
}

// arrarr_row_escapes_boxiter: the strict form with `for o in xs` readmitted on a
// confinement proof (#7414). The element bind still takes no dup, so an index
// bind `var o = xs[i]` is refused exactly as above; the ITERATION is separable
// from it, because the loop var's borrow is transient — the loop completes
// before the exit sweep frees the structure — and that is the same argument
// arrarr_row_escapes_iter already makes for an arr-of-arr row. What differs is
// the confinement proof an option BOX admits: it is consumed by `match (o)`,
// which the ordinary escape walk reads as an escape, so the body check is
// body_unsafe_for_match_borrow plus a vet of the arm bindings that reading hands
// out (elem_box_iter_bind_escapes).
//
// Before this, `for e in keep { match (e) { Some(p) => …, None => {} } }` cost
// the WHOLE credit for its array and leaked the option boxes and their payloads
// — 160 B/round, unbounded, against native's 0 — while `match (keep[i])` next to
// it balanced. Only the iteration was ever the difference.
function arrarr_row_escapes_boxiter(stmts: ast.Stmt[], name: string): boolean {
    return arrarr_row_escapes_ex(stmts, name, false, [], true);
}

// arrarr_row_escapes_iter: the ARR-OF-ARR form. A row read — `var row = g[i]` or
// `row = g[i]` — takes a Perceus dup at the bind (the is_arr/ExprIndex retain in
// lower_stmt_var and its assign twin), so the row is a counted reference and the
// walk's rc-guarded dec lands on 2, not 1. Rejecting them cost the WHOLE credit
// and stranded every row — including ones nothing else touched — while the outer
// buffer alone was reclaimed (#7805: 88 B/round, unbounded, against native's 0).
// The dup is also what makes a rebound candidate safe: a row bound in an earlier
// iteration holds a count the self-append reclaim cannot free.
//
// `for row in g` emits NO such dup (measured: zero rc_inc against one for each
// index form), so it is a real borrow — but a TRANSIENT one: the loop completes
// before the exit reclaim, so the rows are dead by the time the walk runs. It is
// therefore admitted on the same terms structarr_elem_escapes admits its own
// iteration, and refused only when the body lets the loop var escape.
function arrarr_row_escapes_iter(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
    return arrarr_row_escapes_ex(stmts, name, true, borrowable, false);
}

// One walker behind all three, rather than a near-copy per class (the 08-22
// struct-producer rule). `dup_at_index` says whether this class's element bind
// takes the counted retain that turns an index read from an escape into a
// borrow the reclaim can outlive; `box_iter_ok` says whether its `for` iteration
// — transient in every class, since the loop ends before the reclaim — has a
// confinement proof for a BOX loop var, which is a separate question from the
// index bind and answered by a different walk.
function arrarr_row_escapes_ex(stmts: ast.Stmt[], name: string, dup_at_index: boolean, borrowable: string[], box_iter_ok: boolean): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (!dup_at_index && expr_is_bare_row_read(v.init, name)) { return true; } },
            ast.StmtAssign(asg) => { if (!dup_at_index && expr_is_bare_row_read(asg.value, name)) { return true; } },
            ast.StmtFor(fo) => {
                if (ident_named_is(fo.iter, name)) {
                    // The loop var is an unretained borrow of each element, and
                    // the bind is transient — the loop ends before the exit
                    // reclaim. What differs per class is the confinement proof
                    // the element kind admits: an arr-of-arr ROW is an array the
                    // ordinary escape walk vets, an option BOX is consumed by a
                    // `match` that walk reads as an escape and needs the
                    // scrutinee reading plus an arm-binding vet, and a class with
                    // neither proof refuses outright.
                    if (dup_at_index) {
                        if (body_unsafe_for(fo.body, fo.var_name, borrowable, [])) { return true; }
                    } else if (box_iter_ok) {
                        var none: string[] = [];
                        if (body_unsafe_for_match_borrow(fo.body, fo.var_name, none, none, none)) { return true; }
                        if (elem_box_iter_bind_escapes(fo.body, fo.var_name)) { return true; }
                    } else {
                        return true;
                    }
                }
                if (arrarr_row_escapes_ex(fo.body, name, dup_at_index, borrowable, box_iter_ok)) { return true; }
            },
            ast.StmtIf(f) => { if (arrarr_row_escapes_ex(f.then_body, name, dup_at_index, borrowable, box_iter_ok) || arrarr_row_escapes_ex(f.else_body, name, dup_at_index, borrowable, box_iter_ok)) { return true; } },
            ast.StmtWhile(w) => { if (arrarr_row_escapes_ex(w.body, name, dup_at_index, borrowable, box_iter_ok)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (arrarr_row_escapes_ex(arm.body, name, dup_at_index, borrowable, box_iter_ok)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

// elem_box_iter_bind_escapes: the loop variable of `for o in xs` over an array of
// option boxes, checked for anything that could outlive the loop.
//
// The box itself is handled by the caller's body_unsafe_for_match_borrow, which
// admits `o` in exactly one position — the bare scrutinee of a `match (o)` — and
// refuses every alias, call argument, store and return. This walk covers what
// that reading opens up: the arm BINDINGS such a match hands out. Each one
// (payload, extra payloads, and the at-binding, which is the element box itself)
// must stay inside its arm, vetted by elem_arm_bindings_confined and so by the
// STRICT binding_escapes_arm. binding_escapes_arm_scrut, which reads a nested
// `match (binding)` as a borrow, is deliberately NOT used: it is sound only
// where the inner payload is scalar, and this class's payload is an rc array.
//
// A GUARDED arm on the admitted match refuses outright. binding_escapes_arm does
// check the guard, so this is a narrowing rather than a soundness requirement —
// the same one consumed_rcpayload_enum_frees makes for the neighbouring consuming
// match, and for the same reason: under a guard which arm ran is not syntactic,
// and this admission's proof is per-arm.
function elem_box_iter_bind_escapes(stmts: ast.Stmt[], bnd: string): boolean {
    for stmt in stmts {
        if (elem_box_iter_bind_escapes_stmt(stmt, bnd)) { return true; }
    }
    return false;
}
function elem_box_iter_bind_escapes_stmt(st: ast.Stmt, bnd: string): boolean {
    match (st) {
        ast.StmtMatch(m) => {
            var scrut_is_bnd: boolean = ident_named_is(m.scrutinee, bnd);
            for arm in m.arms {
                if (scrut_is_bnd) {
                    if (arm.has_guard) { return true; }
                    if (!elem_arm_bindings_confined(arm)) { return true; }
                }
                if (elem_box_iter_bind_escapes(arm.body, bnd)) { return true; }
            }
            return false;
        },
        ast.StmtIf(f) => {
            return elem_box_iter_bind_escapes(f.then_body, bnd)
                || elem_box_iter_bind_escapes(f.else_body, bnd);
        },
        ast.StmtWhile(w) => { return elem_box_iter_bind_escapes(w.body, bnd); },
        ast.StmtFor(fo) => { return elem_box_iter_bind_escapes(fo.body, bnd); },
        ast.StmtDefer(d) => { return elem_box_iter_bind_escapes_stmt(d.action, bnd); },
        _ => { return false; }
    }
    return false;
}

function expr_is_bare_row_read(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(iid) => { return iid.name == name; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// structarr_elem_escapes: reports whether an ELEMENT pointer of the struct-array
// `name` could outlive the reclaim (function exit / loop rebind), which would
// dangle the freed element box. Unlike arrarr_row_escapes (which rejects ALL
// `for row in g` because an arr-of-arr row is an inner buffer that may be
// retained), a struct-array admits transient iteration: `for p in g { … p.field
// … }` binds each element box only for the loop, which completes before the free
// — so it is safe UNLESS the loop body lets `p` escape (stores / returns / binds
// it). A bare element bind `var q = g[i]` / `q = g[i]` is rejected conservatively
// (q could outlive) — the arr-of-arr class admits those, but only because an
// ARRAY-typed bind takes the is_arr retain, which an element BOX bind does not;
// a transient `g[i].field` read (not a bind) is fine. Field aliasing (`var s = p.name`) is always safe
// here — the reclaim is a SHALLOW box dec that never frees a field pointer.
function structarr_elem_escapes(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (expr_is_bare_row_read(v.init, name)) { return true; } },
            ast.StmtAssign(asg) => { if (expr_is_bare_row_read(asg.value, name)) { return true; } },
            ast.StmtFor(fo) => {
                var iterates_name: boolean = false;
                match (fo.iter) {
                    ast.ExprIdent(fid) => { if (fid.name == name) { iterates_name = true; } },
                    _ => {}
                }
                // `for p in name`: the element box `p` is bound per iteration.
                // Safe iff it does not escape the loop body (only borrow reads).
                if (iterates_name && body_unsafe_for(fo.body, fo.var_name, borrowable, [])) { return true; }
                if (structarr_elem_escapes(fo.body, name, borrowable)) { return true; }
            },
            ast.StmtIf(f) => { if (structarr_elem_escapes(f.then_body, name, borrowable) || structarr_elem_escapes(f.else_body, name, borrowable)) { return true; } },
            ast.StmtWhile(w) => { if (structarr_elem_escapes(w.body, name, borrowable)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (structarr_elem_escapes(arm.body, name, borrowable)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

// slot_is_reclaimable_arrarr: slot i holds a fresh, non-escaping arr-of-arr
// local credited "ARRARR:" by reclaimable_names_of (#4355 slice 9). Freed
// whole (inner buffers/strings + outer) by arrarr_free_helper_of's helper.
function slot_is_reclaimable_arrarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_arrarr) { return false; }
    // String-kind inners (type-aware arrarr_elem) need the STRICT credit —
    // every inner element proved a fresh string, so freeing their pointers
    // can't dangle a live local. Scalar-kind inners value-copy their
    // elements, so the lax rows-are-literals credit suffices.
    if (s.arrarr_elem_of_slot(i) == "string") {
        return reclaim_has(s.reclaimable_names, "ARRARRS:", s.reclaim_site_key(i));
    }
    return reclaim_has(s.reclaimable_names, "ARRARR:", s.reclaim_site_key(i));
}

// arrarr_free_helper_of picks the release helper from the slot's INNER element
// kind: string inners need the per-element __fern_str_arr_free walk; scalar
// inners are fully freed by one arr_dec each.
function arrarr_free_helper_of(s: LowerState, i: i32): string {
    if (s.arrarr_elem_of_slot(i) == "string") { return "__fern_strarrarr_free"; }
    return "__fern_arrarr_free";
}

// ── CLOARR: closure-array element reclaim (#4354) ───────────────────────────
//
// A closure ARRAY local (`var fns: (() => i32)[] = [() => n, …]`) is an is_arr
// slot whose elements are env boxes — rc-headered arrays `[fn, caps…]` whose
// captures are borrowed, never counted. The shallow buffer dec every other
// array slot takes leaked every box (measured 40 B per element per round on
// x86-64 against 0 on native). Credited "CLOARR:<site>", the slot is released
// whole by __fern_arrarr_free: one rc-guarded arr_dec per element, then the
// buffer — the arr-of-arr helper, because an env box IS an inner array to it.
//
// The credit is the whole safety argument, since the walk frees any box the
// buffer holds at rc==1. Two conditions: every element that ever enters the
// buffer is OWNED by it — a fresh box (a lambda or its `__mkclo$` marker) or a
// closure local the literal / self-append retains as an is_arr ident — at the
// literal, at a self-append, or in every return of a "CAC:" producer; and
// every read of the array is one of: `fns[i](args)` (dispatched, never
// stored), `var d = fns[i]` (lower_stmt_var_closure retains the element, so d
// is a counted owner), `for f in fns` with f only ever called, `fns.len()`, or
// a bare argument at a borrowable position. `.with` / `.append` bound
// elsewhere clone the buffer and share its boxes uncounted, so any other
// method refuses.

// slot_is_reclaimable_cloarr: slot i holds a "CLOARR:"-credited closure-array
// local. The credit rather than the is_closurearr flag: an annotated empty
// literal grown by `.append` earns the flag at the append, which lowers after
// the bind whose loop-rebind release needs the verdict. is_arrarr is not a
// refusal — a literal whose first element is a closure LOCAL reads as an
// array-of-arrays to arrarr_from_init_shape (the local's slot is is_arr) —
// and the "ARRARR:" branches, which precede this one at both release sites,
// never claim it: their credit needs array-literal rows.
function slot_is_reclaimable_cloarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_arr || s.locals[i].is_strarr) { return false; }
    return reclaim_has(s.reclaimable_names, "CLOARR:", s.reclaim_site_key(i));
}

// cloarr_elem_is_owned: storing `e` leaves the buffer holding a counted
// reference to the box. A lambda literal or its `__mkclo$<name>(caps…)` marker
// builds a fresh rc=1 box; a closure LOCAL (bound once, by a lambda / marker /
// closure-returning call — every form lower_stmt_var_closure marks is_arr) is
// retained by the literal and by the self-append, so the buffer owns a count
// alongside the local's own. A closure-returning CALL is not admitted: the
// callee may hand back a param's or a field's box uncounted
// (handback_params), and the walk would free it.
function cloarr_elem_is_owned(e: ast.Expr, body: ast.Stmt[], closureset: string[]): boolean {
    if let ast.ExprLambda(_) = e { return true; }
    var idn: string = ident_name_or_empty(e);
    if (idn.len() > 0) { return local_decl_count(body, idn) == 1 && body_binds_closure_local(body, idn, closureset); }
    return clo_elem_is_box(e);
}

// cloarr_lit_is_fresh: an array literal of owned env boxes (empty included —
// the caller decides whether an empty literal's type is known).
function cloarr_lit_is_fresh(e: ast.Expr, body: ast.Stmt[], closureset: string[]): boolean {
    if let ast.ExprArray(a) = e {
        for el in a.elements { if (!cloarr_elem_is_owned(el, body, closureset)) { return false; } }
        return true;
    }
    return false;
}

// cloarr_self_append_fresh: `name.append(<owned box>)` — the one reassignment
// of a credited closure array the walker admits (as the arr-of-arr class
// admits `g = g.append(<row literal>)`).
function cloarr_self_append_fresh(e: ast.Expr, name: string, body: ast.Stmt[], closureset: string[]): boolean {
    if let ast.ExprCall(c) = e {
        if (c.args.len() != 1 || !cloarr_elem_is_owned(c.args[0], body, closureset)) { return false; }
        if let ast.ExprFieldAccess(fa) = c.callee { return fa.field == "append" && ident_named_is(fa.obj, name); }
    }
    return false;
}

// cloarr_expr_unsafe: does `e` let the array or one of its element boxes
// outlive the slot uncounted? Every `name[i]` outside a callee position is an
// uncounted element read (a container element, a return, an argument), and
// every method on `name` but `len` may clone the buffer. A bare `name` at a
// free call is expr_unsafe_for's question — borrowable positions borrow.
function cloarr_expr_unsafe(e: ast.Expr, name: string, borrowable: string[]): boolean {
    var idn: string = ident_name_or_empty(e);
    if (idn.len() > 0) { return idn == name; }
    if let ast.ExprBinary(b) = e { return cloarr_expr_unsafe(b.left, name, borrowable) || cloarr_expr_unsafe(b.right, name, borrowable); }
    if let ast.ExprUnary(u) = e { return cloarr_expr_unsafe(u.operand, name, borrowable); }
    if let ast.ExprIndex(ix) = e { return rc_ml_count_in_expr(ix.array, name) > 0 || cloarr_expr_unsafe(ix.index, name, borrowable); }
    if let ast.ExprCall(c) = e { return cloarr_call_unsafe(c, e, name, borrowable); }
    if let ast.ExprFieldAccess(fa) = e { return cloarr_expr_unsafe(fa.obj, name, borrowable); }
    // A lambda mentioning the array captures it — the box outlives the slot.
    // expr_mentions_name prunes lambda bodies, so the fallback cannot see it.
    if let ast.ExprLambda(lm) = e { return rc_ml_count_in_stmts(lm.body, name) > 0; }
    // Any mention inside a container literal or anything else is an escape.
    return expr_mentions_name(e, name);
}

// cloarr_call_unsafe is cloarr_expr_unsafe's call arm. The callee decides how
// a bare-ident argument is judged: a free function's borrowable registry
// admits a borrow position, every other callee has no such registry, so a
// bare `name` argument there escapes.
function cloarr_call_unsafe(c: ast.ExprCall, e: ast.Expr, name: string, borrowable: string[]): boolean {
    // A free-function call: expr_unsafe_for judges the bare-ident arguments.
    if (ident_name_or_empty(c.callee).len() > 0) {
        if (expr_unsafe_for(e, name, borrowable, [])) { return true; }
        return cloarr_call_args_unsafe(c.args, name, borrowable, true);
    }
    var callee_unsafe: boolean = false;
    var judged: boolean = false;
    // `name[i](args)`: the element is dispatched through, never stored.
    if let ast.ExprIndex(cix) = c.callee {
        judged = true;
        if (ident_named_is(cix.array, name)) { callee_unsafe = cloarr_expr_unsafe(cix.index, name, borrowable); }
        else { callee_unsafe = cloarr_expr_unsafe(c.callee, name, borrowable); }
    }
    // `name.len()` borrows the header; every other method may clone the
    // buffer into a binding that shares the boxes uncounted.
    if let ast.ExprFieldAccess(fa) = c.callee {
        judged = true;
        if (ident_named_is(fa.obj, name)) { callee_unsafe = fa.field != "len" || c.args.len() != 0; }
        else { callee_unsafe = cloarr_expr_unsafe(fa.obj, name, borrowable); }
    }
    if (!judged) { callee_unsafe = cloarr_expr_unsafe(c.callee, name, borrowable); }
    if (callee_unsafe) { return true; }
    return cloarr_call_args_unsafe(c.args, name, borrowable, false);
}

// cloarr_call_args_unsafe: a bare `name` argument was judged with the callee
// when it is a free function (`judged`); anything else recurses.
function cloarr_call_args_unsafe(args: ast.Expr[], name: string, borrowable: string[], judged: boolean): boolean {
    for arg in args {
        var an: string = ident_name_or_empty(arg);
        if (an.len() > 0) { if (an == name && !judged) { return true; } }
        else if (cloarr_expr_unsafe(arg, name, borrowable)) { return true; }
    }
    return false;
}

// cloarr_unsafe_for: the statement walk behind the "CLOARR:" credit. `ret_ok`
// forgives a bare `return name` — the move-out a "CAC:" producer's local
// exists for — and is false for a consumer's own credit. `body` is the whole
// function body, which the element-ownership test reads bindings from.
function cloarr_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], ret_ok: boolean, body: ast.Stmt[], closureset: string[]): boolean {
    for stmt in stmts { if (cloarr_stmt_unsafe(stmt, name, borrowable, ret_ok, body, closureset)) { return true; } }
    return false;
}

function cloarr_stmt_unsafe(st: ast.Stmt, name: string, borrowable: string[], ret_ok: boolean, body: ast.Stmt[], closureset: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return cloarr_var_unsafe(v, name, borrowable); },
        ast.StmtAssign(a) => {
            if (a.target == name) { return !cloarr_self_append_fresh(a.value, name, body, closureset); }
            return cloarr_expr_unsafe(a.value, name, borrowable);
        },
        ast.StmtReturn(r) => {
            if (ret_ok && ident_named_is(r.value, name)) { return false; }
            return cloarr_expr_unsafe(r.value, name, borrowable);
        },
        ast.StmtExpr(x) => { return cloarr_expr_unsafe(x.value, name, borrowable); },
        ast.StmtIf(f) => {
            if (cloarr_expr_unsafe(f.cond, name, borrowable)) { return true; }
            return cloarr_unsafe_for(f.then_body, name, borrowable, ret_ok, body, closureset) || cloarr_unsafe_for(f.else_body, name, borrowable, ret_ok, body, closureset);
        },
        ast.StmtWhile(w) => {
            if (cloarr_expr_unsafe(w.cond, name, borrowable)) { return true; }
            return cloarr_unsafe_for(w.body, name, borrowable, ret_ok, body, closureset);
        },
        ast.StmtFor(fo) => {
            if (cloarr_for_iter_unsafe(fo, name, borrowable)) { return true; }
            return cloarr_unsafe_for(fo.body, name, borrowable, ret_ok, body, closureset);
        },
        ast.StmtMatch(m) => { return cloarr_match_unsafe(m, name, borrowable, ret_ok, body, closureset); },
        ast.StmtDefer(d) => { return cloarr_stmt_unsafe(d.action, name, borrowable, ret_ok, body, closureset); },
        ast.StmtBreak(_) => { return false; },
        ast.StmtContinue(_) => { return false; },
        ast.StmtUnknown(_) => { return false; }
    }
    return false;
}

function cloarr_match_unsafe(m: ast.StmtMatch, name: string, borrowable: string[], ret_ok: boolean, body: ast.Stmt[], closureset: string[]): boolean {
    if (cloarr_expr_unsafe(m.scrutinee, name, borrowable)) { return true; }
    for arm in m.arms {
        if (arm.has_guard && cloarr_expr_unsafe(arm.guard, name, borrowable)) { return true; }
        if (cloarr_unsafe_for(arm.body, name, borrowable, ret_ok, body, closureset)) { return true; }
    }
    return false;
}

// cloarr_var_unsafe: `var d = name[i]` is a counted bind (lower_stmt_var_closure
// retains the element, so d owns a count); any other init is an expression read.
//
// The credit is a whole-function scan and the retain is decided per bind, so
// the two agreeing is worth stating. They read ONE predicate: clo_init's
// ExprIndex arm routes the bind into lower_stmt_var_closure only when
// `s.is_closurearr_slot` holds, and the retain there re-asks it on the same
// pre-bind state — a bind the flag refuses never reaches the retain site at
// all, so "credited without a retain" is not a state that exists. With the
// flag off the bind is a plain uncounted borrow that is never released, so the
// walk's free stays the single release either way (measured: the shape below,
// 600 allocs / 600 frees / 0 live bytes, sanitizer clean, underflow 0).
// closurearr_append_decl_sites then removes the window that raised the
// question — the flag now holds from an empty `fn[]` declaration the body
// grows with boxes, which is also the fix for the SIGSEGV that shape used to
// emit.
function cloarr_var_unsafe(v: ast.StmtVar, name: string, borrowable: string[]): boolean {
    if (expr_is_bare_row_read(v.init, name)) {
        if let ast.ExprIndex(ix) = v.init { return cloarr_expr_unsafe(ix.index, name, borrowable); }
    }
    return cloarr_expr_unsafe(v.init, name, borrowable);
}

// cloarr_for_iter_unsafe: `for f in name` makes f an unretained borrow of each
// box, so the body may only CALL it; a destructuring loop var is refused. Any
// other iterable is an expression read.
function cloarr_for_iter_unsafe(fo: ast.StmtFor, name: string, borrowable: string[]): boolean {
    var itn: string = ident_name_or_empty(fo.iter);
    if (itn.len() == 0) { return cloarr_expr_unsafe(fo.iter, name, borrowable); }
    if (itn != name) { return false; }
    var vi: i32 = 0;
    while (vi < fo.var_name.len()) { if (fo.var_name[vi] == b',') { return true; } vi = vi + 1; }
    return ident_used_as_value_stmts(fo.body, fo.var_name);
}

// collect_fresh_cloarr_names: the binding sites (at any nesting depth) that may
// take the credit — a literal of owned boxes (an EMPTY literal only when
// annotated a fn array, or the slot could be any array at all), or a call to a
// "CAC:" producer. A statement-only walk: a lambda body's bindings are its own.
function collect_fresh_cloarr_names(body: ast.Stmt[], caset: string[], closureset: string[]): string[] {
    function cand_site_of(st: ast.Stmt, acc: string[]): string[] {
        if let ast.StmtVar(v) = st {
            var cand: boolean = false;
            if let ast.ExprArray(arr) = v.init { cand = cloarr_lit_is_fresh(v.init, body, closureset) && (arr.elements.len() > 0 || v.type_name == "fn[]"); }
            if let ast.ExprCall(c) = v.init {
                var cn: string = ident_name_or_empty(c.callee);
                if (cn.len() > 0 && util.index_of_str(caset, "CAC:" + cn) >= 0) { cand = true; }
            }
            if (cand) { return push_str_unique(acc, reclaim_site_key_of(v.name, v.line, v.col)); }
        }
        return acc;
    }
    var out: string[] = [];
    for st in body {
        out = astwalk.fold_stmt_nodes(st, out, cand_site_of, no_expr_strs, astwalk.descend_none);
    }
    return out;
}

// closurearr_append_decl_sites: the binding sites of EMPTY annotated `fn[]`
// literals the body grows with a closure BOX (`fns = fns.append(() => n)`).
// Stamped "CLOAPPEND:" so closurearr_of_init can mark the slot is_closurearr at
// the DECLARATION rather than at the first append — see the comment there for
// the SIGSEGV that motivates it.
//
// Independent of the "CLOARR:" credit and computed unconditionally: the
// mis-dispatch it fixes happens whether or not the array earns the reclaim
// walk (an aliased, uncredited array segfaults identically). Marking the flag
// here is also what makes the credit's forgiveness of `var g = fns[i]`
// co-extensive with the retain that pays for it by CONSTRUCTION rather than by
// argument: with no window in which the flag is off, there is no state in which
// the credit could forgive a bind the retain did not reach.
function closurearr_append_decl_sites(body: ast.Stmt[], closureset: string[]): string[] {
    function box_appended_names(st: ast.Stmt, acc: string[]): string[] {
        if let ast.StmtAssign(a) = st {
            if (cloarr_self_append_fresh(a.value, a.target, body, closureset)) { return push_str_unique(acc, a.target); }
        }
        return acc;
    }
    var grown: string[] = [];
    for st in body {
        grown = astwalk.fold_stmt_nodes(st, grown, box_appended_names, no_expr_strs, astwalk.descend_none);
    }
    if (grown.len() == 0) { return grown; }
    function empty_fnarr_decl(st: ast.Stmt, acc: string[]): string[] {
        if let ast.StmtVar(v) = st {
            if (v.type_name == "fn[]" && util.index_of_str(grown, v.name) >= 0) {
                if let ast.ExprArray(a) = v.init {
                    if (a.elements.len() == 0) { return acc.append("CLOAPPEND:" + reclaim_site_key_of(v.name, v.line, v.col)); }
                }
            }
        }
        return acc;
    }
    var out: string[] = [];
    for st in body {
        out = astwalk.fold_stmt_nodes(st, out, empty_fnarr_decl, no_expr_strs, astwalk.descend_none);
    }
    return out;
}

// reclaim_closure_arrays credits the function's closure-array locals "CLOARR:".
function reclaim_closure_arrays(fn: parser.FuncDecl, sg: FnSigs, reclaim: string[]): string[] {
    var cands: string[] = collect_fresh_cloarr_names(fn.body, sg.closurearr_ret_fns, sg.closure_fns);
    var ci: i32 = 0;
    while (ci < cands.len()) {
        if (!cloarr_unsafe_for(fn.body, reclaim_site_name(cands[ci]), sg.borrowable_params, false, fn.body, sg.closure_fns)) { reclaim = reclaim.append("CLOARR:" + cands[ci]); }
        ci = ci + 1;
    }
    return reclaim;
}

// body_binds_fresh_cloarr: `name` is bound (anywhere in `stmts`) from a
// closure-array literal of owned boxes. Paired with local_decl_count == 1 by
// the "CAC:" scan.
function body_binds_fresh_cloarr(body: ast.Stmt[], name: string, closureset: string[]): boolean {
    function binds_fresh_at(st: ast.Stmt, acc: boolean): boolean {
        if (acc) { return true; }
        if let ast.StmtVar(v) = st { return v.name == name && cloarr_lit_is_fresh(v.init, body, closureset); }
        return acc;
    }
    var found: boolean = false;
    for st in body {
        found = astwalk.fold_stmt_nodes(st, found, binds_fresh_at, no_expr_bool, astwalk.descend_none);
        if (found) { return true; }
    }
    return false;
}

// body_has_nonfresh_cloarr_return: some return of the function hands back a
// closure array that is not provably a fresh one — anything but a literal of
// owned boxes or a once-bound local of one that the walk admits (the bare
// return forgiven). No borrowable registry exists at the registry pass, so a
// call-argument use of the local refuses the producer.
function body_has_nonfresh_cloarr_return(body: ast.Stmt[], closureset: string[]): boolean {
    var rets: ast.Expr[] = collect_returns(body, []);
    for r in rets {
        var fresh: boolean = cloarr_lit_is_fresh(r, body, closureset);
        var rn: string = ident_name_or_empty(r);
        if (rn.len() > 0 && local_decl_count(body, rn) == 1 && body_binds_fresh_cloarr(body, rn, closureset)
            && !cloarr_unsafe_for(body, rn, [], true, body, closureset)) { fresh = true; }
        if (!fresh) { return true; }
    }
    return false;
}

// slot_is_reclaimable_optaarr (#4365): slot i holds a fresh, non-escaping
// Option[<scalar-arr>][] local (`var xs: Option[i32[]][] = [Some([..]), None]`)
// credited "OPTAARR:" by reclaimable_names_of. Deliberately NOT is_arrarr —
// that flag drives row-indexing dispatch for T[][] shapes; an option-element
// array stays a plain is_arr slot whose elements are option boxes. The release
// helper __fern_optarrarr_free walks elements (uniqueness-gated payload dec,
// rc-guarded box dec) then frees the buffer.
function slot_is_reclaimable_optaarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_arr) { return false; }
    if (s.locals[i].is_arrarr || s.locals[i].is_strarr) { return false; }
    return slot_credit_at(s, i, "OPTAARR:");
}

// emit_optaarr_reclaim_store: the option-element twin of
// emit_arrarr_reclaim_store — stores `new` into a reclaimable
// Option[<arr>][] slot, cow-guarded, freeing the PRIOR three-level structure
// (payload buffers + option boxes + outer buffer) via __fern_optarrarr_free.
function emit_optaarr_reclaim_store(se: LowerState, slot: i32): LowerState {
    var scratch: string = "$oaar" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(tmp));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_optarrarr_free", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// slot_is_reclaimable_opttup (#4365): slot i holds a fresh, non-escaping
// `Option[<tuple-with-array>]` local, credited "OPTTUP:" by reclaimable_names_of.
// Gated on the opt_type mark (an option-box slot) + the credit. Reclaimed inline
// (no runtime helper): a Some box first deep-drops its tuple payload, then the box
// itself is freed.
function slot_is_reclaimable_opttup(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].opt_type.len() == 0) { return false; }
    return slot_credit_at(s, i, "OPTTUP:");
}

// emit_opttup_deep_free frees the option box in `slot`: null-guarded, if the box
// is Some (op_opt_tag == 0) it extracts the tuple payload (op_opt_payload — the
// pointer at [payload@8 asm / @4 wasm]), TYPE-drives its deep-drop
// (emit_tuple_type_child_drops on the inner tuple type), and frees the tuple box;
// then the option box itself is dec'd. A None box (tag 1) skips straight to the
// box dec. Consumes no operand; the slot is left dangling (callers store new / zero
// it). Admission (opttup_init_is_fresh) guarantees the payload tuple is fresh, so
// every array position sole-owns its buffer.
function emit_opttup_deep_free(se: LowerState, slot: i32, inner: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    // if Some (tag 0): deep-drop the payload tuple.
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // tag == 0 (Some)
    st = st.emit(ir.op_if(0));
    var etn: string = "$optup" + util.i32_to_string(st.locals.len());
    st = st.add_local(etn);
    var etslot: i32 = st.slot_of(etn);
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());               // tuple box ptr
    st = st.emit(ir.op_store_local(etslot));
    var et_path: i32[] = [];
    st = emit_tuple_type_child_drops(st, etslot, et_path, inner);   // free array/nested children
    st = st.emit(ir.op_load_local(etslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the tuple box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-Some
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the option box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_opttup_reclaim_store: the loop-rebind. Stash `new` (on stack), deep-free the
// OLD option box (emit_opttup_deep_free), then store new. A fresh Some/None init
// makes old != new implicit, so no cow guard beyond the null guard inside deep_free.
function emit_opttup_reclaim_store(se: LowerState, slot: i32, inner: string): LowerState {
    var scratch: string = "$otr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = emit_opttup_deep_free(st, slot, inner);     // free old box + payload
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// ── OPTSTRUCT: reclaim `Option[<struct-with-rc-field>]` locals (#4365) ──
// The struct sibling of OPTTUP: the Some payload is a STRUCT box (not a tuple), so the
// inline deep-free drops it via the struct-field deep-drop (emit_struct_field_drops ->
// __struct_drop_<P>) instead of the tuple deep-drop. some_opt_type records the full
// Option[P] for a struct payload (no tuple-style element collapse), so no opt_ty override
// is needed at the binding.

// optstruct_payload_reclaimable: the Some payload struct `sty` is one this class can
// release. Three disjuncts, in descending amount of work at the drop:
//   - an rc-array / nested-struct / enum field: __struct_drop_<P> walks it, then the
//     two box decs (the original class).
//   - a bare `string` field: __struct_drop_<P>'s k_str arm frees it, then the box decs.
//     Gated a SECOND time at emit by struct_routes_field_reclaim's whole-program STRFLDOK
//     verdict — a type that scan refuses emits no __struct_drop_<P> call, so the boxes are
//     still freed and only the string is stranded, never over-released. The
//     construction-side retain (slit_reclaim) consults the same verdict, so the k_str dec
//     is balanced on an aliased field as well as a fresh one.
//   - SCALAR-ONLY: nothing to walk, so the drop is the two box decs alone. It was excluded
//     while this was "the deep-drop class" and nothing else claimed a block-scoped one, so
//     both boxes leaked per bind.
// A payload reaching NONE of the three (map / option / tuple fields only) stays refused:
// its box free would be sound, but no probe measures it, so it keeps today's leak.
function optstruct_payload_reclaimable(structs: parser.StructDecl[], sty: string): boolean {
    return struct_has_reclaim_array_field(structs, sty)
        || struct_has_string_field(structs, sty)
        || struct_is_scalar_only(structs, sty);
}

// optstruct_ann_is: `type_name` is `Option[<struct with a reclaimable field>]` or
// `Result[<same>, E]` — opt_payload_type reads the Some/Ok payload out of either
// spelling. The two must measure identically: `Ok(p)` and `Some(p)` build the same
// box through the same lowering, so crediting one and not the other leaves the
// other's payload stranded for no reason a reader could name.
function optstruct_ann_is(type_name: string, structs: parser.StructDecl[]): boolean {
    var inner: string = opt_payload_type(type_name, "Some");
    if (inner == "") { return false; }
    if (!decl_is_struct(structs, inner)) { return false; }
    return optstruct_payload_reclaimable(structs, inner);
}

// optstruct_init_is_fresh: the init is `Some(<fresh struct literal>)` (is_fresh_struct_init
// — an ExprStructLit of a struct decl; the construction alias-inc balances the per-field
// __struct_drop), `Some(<struct local>)` — lower_opt_make_payload retains that box, so the
// option is a counted co-owner and its release is balanced whether the source stays live or
// not — or `None`. `Ok` is the same construction under the Result spelling, and both reach
// here bare or qualified. The declaration's own annotation fixes the payload type, so the
// ident needs no further test. `Err` declines: its payload is E, which this class does not
// release, so a name whose every binding is not a Some/Ok stays uncredited and leaks.
function optstruct_init_is_fresh(e: ast.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var ctor: string = "";
            match (c.callee) {
                ast.ExprIdent(cid) => { ctor = cid.name; },
                ast.ExprFieldAccess(cfa) => { ctor = cfa.field; },
                _ => {}
            }
            if ((ctor == "Some" || ctor == "Ok") && c.args.len() == 1) {
                match (c.args[0]) {
                    ast.ExprIdent(_) => { return true; },
                    _ => {}
                }
                return is_fresh_struct_init(c.args[0], structs);
            }
            return false;
        },
        ast.ExprIdent(nid) => { return nid.name == "None"; },
        _ => { return false; }
    }
    return false;
}

// optstruct_arm_expr_escapes: does `e` use the Some-payload struct binding `p` (struct type
// `sty`) in an escaping way? A scalar field read (p.n), an indexed array-field read
// (p.xs[i]) and p.xs.len() are borrows; a bare `p`, a bare `p.<arrayfield>` extraction, or
// any other touch of p escapes. Erring toward rejection is a safe leak, never over-release.
function optstruct_arm_expr_escapes(e: ast.Expr, p: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == p; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(oid) => {
                    if (oid.name == p) {
                        var ft: string = decl_field_type(structs, sty, fa.field);
                        return ft != "" && !is_scalar_type_name(ft);   // bare non-scalar field extract escapes
                    }
                    return false;
                },
                _ => { return optstruct_arm_expr_escapes(fa.obj, p, sty, structs); }
            }
        },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprFieldAccess(bfa) => {
                    match (bfa.obj) {
                        ast.ExprIdent(bid) => {
                            if (bid.name == p) { return optstruct_arm_expr_escapes(ix.index, p, sty, structs); }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return optstruct_arm_expr_escapes(ix.array, p, sty, structs) || optstruct_arm_expr_escapes(ix.index, p, sty, structs);
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    match (cfa.obj) {
                        ast.ExprFieldAccess(pfa) => {
                            match (pfa.obj) {
                                ast.ExprIdent(pid) => {
                                    if (pid.name == p && cfa.field == "len") {
                                        for arg in c.args { if (optstruct_arm_expr_escapes(arg, p, sty, structs)) { return true; } }
                                        return false;
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            if (optstruct_arm_expr_escapes(c.callee, p, sty, structs)) { return true; }
            for arg in c.args { if (optstruct_arm_expr_escapes(arg, p, sty, structs)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return optstruct_arm_expr_escapes(b.left, p, sty, structs) || optstruct_arm_expr_escapes(b.right, p, sty, structs); },
        ast.ExprUnary(u) => { return optstruct_arm_expr_escapes(u.operand, p, sty, structs); },
        ast.ExprSlice(sl) => { return optstruct_arm_expr_escapes(sl.array, p, sty, structs) || optstruct_arm_expr_escapes(sl.start, p, sty, structs) || optstruct_arm_expr_escapes(sl.end, p, sty, structs); },
        ast.ExprArray(ar) => { var i: i32 = 0; while (i < ar.elements.len()) { if (optstruct_arm_expr_escapes(ar.elements[i], p, sty, structs)) { return true; } i = i + 1; } return false; },
        ast.ExprTuple(t) => { for el in t.elements { if (optstruct_arm_expr_escapes(el, p, sty, structs)) { return true; } } return false; },
        ast.ExprStructLit(slb) => {
            if (slb.has_base && optstruct_arm_expr_escapes(slb.base, p, sty, structs)) { return true; }
            var i: i32 = 0;
            while (i < slb.field_values.len()) { if (optstruct_arm_expr_escapes(slb.field_values[i], p, sty, structs)) { return true; } i = i + 1; }
            return false;
        },
        _ => { return false; }
    }
    return false;
}
function optstruct_arm_stmt_escapes(st: ast.Stmt, p: string, sty: string, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return optstruct_arm_expr_escapes(v.init, p, sty, structs); },
        ast.StmtReturn(r) => { return optstruct_arm_expr_escapes(r.value, p, sty, structs); },
        ast.StmtExpr(e) => { return optstruct_arm_expr_escapes(e.value, p, sty, structs); },
        ast.StmtAssign(a) => { return optstruct_arm_expr_escapes(a.value, p, sty, structs); },
        ast.StmtIf(f) => {
            if (optstruct_arm_expr_escapes(f.cond, p, sty, structs)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (optstruct_arm_stmt_escapes(f.then_body[ti], p, sty, structs)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (optstruct_arm_stmt_escapes(f.else_body[ei], p, sty, structs)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (optstruct_arm_expr_escapes(w.cond, p, sty, structs)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (optstruct_arm_stmt_escapes(w.body[i], p, sty, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (optstruct_arm_expr_escapes(fo.iter, p, sty, structs)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (optstruct_arm_stmt_escapes(fo.body[i], p, sty, structs)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (optstruct_arm_expr_escapes(m.scrutinee, p, sty, structs)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && optstruct_arm_expr_escapes(arm.guard, p, sty, structs)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (optstruct_arm_stmt_escapes(arm.body[bi], p, sty, structs)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return optstruct_arm_stmt_escapes(d.action, p, sty, structs); },
        _ => { return false; }
    }
    return false;
}
// optstruct_payload_escapes: for the option local `name` (payload struct type `sty`), does
// the consuming `match (name)`'s Some-arm use its bound payload in an escaping way? The
// struct-aware sibling of opttup_payload_escapes.
function optstruct_payload_escapes(stmts: ast.Stmt[], name: string, sty: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var is_scrut: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { if (sid.name == name) { is_scrut = true; } },
                    _ => {}
                }
                if (is_scrut) {
                    for arm in m.arms {
                        match (arm.pattern) {
                            ast.PatVariant(pv) => {
                                var vn: string = pv.type_name;
                                var vc: i32 = 0;
                                while (vc < pv.type_name.len()) { if (pv.type_name[vc] == b'.') { vn = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; } vc = vc + 1; }
                                if (vn == "Some" && pv.binding != "" && pv.binding != "_") {
                                    if (arm.has_guard && optstruct_arm_expr_escapes(arm.guard, pv.binding, sty, structs)) { return true; }
                                    var bi: i32 = 0;
                                    while (bi < arm.body.len()) { if (optstruct_arm_stmt_escapes(arm.body[bi], pv.binding, sty, structs)) { return true; } bi = bi + 1; }
                                }
                            },
                            _ => {}
                        }
                    }
                }
                for arm in m.arms { if (optstruct_payload_escapes(arm.body, name, sty, structs)) { return true; } }
            },
            ast.StmtIf(f) => { if (optstruct_payload_escapes(f.then_body, name, sty, structs) || optstruct_payload_escapes(f.else_body, name, sty, structs)) { return true; } },
            ast.StmtWhile(w) => { if (optstruct_payload_escapes(w.body, name, sty, structs)) { return true; } },
            ast.StmtFor(fo) => { if (optstruct_payload_escapes(fo.body, name, sty, structs)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// collect_fresh_optstruct_names: the struct sibling of collect_fresh_opttup_names — a fresh
// Some(<struct lit>)/None under an Option[<struct-with-array>] annotation, consumed by
// exactly one borrow-only match in the same block, not escaping. A reassigned name is
// admitted when every rebind is itself fresh (opt_rebinds_all_fresh, #6127).
function collect_fresh_optstruct_names(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                if (optstruct_ann_is(v.type_name, structs)
                    && optstruct_init_is_fresh(v.init, structs)
                    && (util.index_of_str(reassigned, v.name) < 0
                        || opt_rebinds_all_fresh(stmts, v.name, "struct", "", structs, sig_reg_empty(), []))) {
                    // The consuming match may sit one block deeper, or be a match
                    // EXPRESSION in a `return` (#6319 + the IIFE arm) — the same
                    // reader the OPTTUP sibling already uses, which OPTSTRUCT was
                    // left behind by. Liveness and escape take the enclosing
                    // statement; the arm check takes the match itself, because
                    // match_arms_use_name answers "no use" for a statement it
                    // cannot parse and that reads as a proof.
                    var match_idx: i32 = sole_consuming_match_idx(stmts, v.name);
                    var msv: ast.Stmt[] = [];
                    if (match_idx > vi) { msv = consuming_match_of(stmts[match_idx], v.name); }
                    if (match_idx > vi && msv.len() == 1
                        && !match_arms_use_name(msv[0], v.name)
                        && !optstruct_payload_escapes(stmts, v.name, opt_payload_type(v.type_name, "Some"), structs)
                        && !name_used_after(stmts, v.name, match_idx)
                        && !name_escapes_outside_stmt(stmts, v.name, match_idx)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_optstruct_names(f.then_body, structs, a); a = collect_fresh_optstruct_names(f.else_body, structs, a); },
            ast.StmtWhile(w) => { a = collect_fresh_optstruct_names(w.body, structs, a); },
            ast.StmtFor(fo) => { a = collect_fresh_optstruct_names(fo.body, structs, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_optstruct_names(arm.body, structs, a); }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

// slot_is_reclaimable_optstruct: slot i holds a fresh, non-escaping
// `Option[<struct-with-rc-field>]` local, credited "OPTSTRUCT:" by reclaimable_names_of.
// Gated on the opt_type mark (an option-box slot whose inner is such a struct) + credit —
// the same optstruct_payload_reclaimable predicate the credit itself used.
function slot_is_reclaimable_optstruct(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].opt_type.len() == 0) { return false; }
    var inner: string = opt_payload_type(s.locals[i].opt_type, "Some");
    if (!decl_is_struct(s.structs, inner)) { return false; }
    if (!optstruct_payload_reclaimable(s.structs, inner)) { return false; }
    return slot_credit_at(s, i, "OPTSTRUCT:");
}

// emit_optstruct_deep_free frees the option box in `slot`: null-guarded, if Some
// (op_opt_tag == 0) it extracts the struct-box payload, deep-drops the struct's rc fields
// (emit_struct_field_drops -> __struct_drop_<sty>, balanced by the construction alias-inc),
// frees the struct box, then the option box. A None box skips to the box dec. Leaves the
// slot dangling.
function emit_optstruct_deep_free(se: LowerState, slot: i32, sty: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // tag == 0 (Some)
    st = st.emit(ir.op_if(0));
    var etn: string = "$optst" + util.i32_to_string(st.locals.len());
    st = st.add_local(etn);
    var etslot: i32 = st.slot_of(etn);
    st = st.mark_struct_type(etslot, sty);           // so emit_struct_field_drops routes __struct_drop_<sty>
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());               // struct box ptr
    st = st.emit(ir.op_store_local(etslot));
    // rc-GATED: with a counted payload (`Some(p)`, p's own sweep still pending) two
    // static walks free every field buffer twice — allocs == frees at live_bytes 0,
    // and only __rc_underflow_count() dissents. The walk belongs to whichever owner
    // finds rc 1; the dec below hands the last one its turn, so sweep order stops
    // mattering.
    st = emit_struct_field_drops_gated(st, etslot, true);
    st = st.emit(ir.op_load_local(etslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the struct box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-Some
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the option box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_optstruct_reclaim_store: the loop-rebind. Stash `new`, deep-free the OLD option box
// (emit_optstruct_deep_free), then store new. The null guard inside deep_free suffices.
function emit_optstruct_reclaim_store(se: LowerState, slot: i32, sty: string): LowerState {
    var scratch: string = "$osr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = emit_optstruct_deep_free(st, slot, sty);    // free old box + payload
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// ── OPTARR: reclaim REBOUND `Option[<flat scalar array>]` locals (#6127) ──
//
// The simplest payload kind in the Option family, and the one it never had a
// loop-rebind class for: OPTAARR covers `Option[<arr>][]`, OPTARRARR
// `Option[i32[][]]`, OPTSTRUCT `Option[<struct-with-array>]`, OPTTUP
// `Option[<tuple-with-array>]` — and nothing covered a plain `Option[i32[]]`.
//
// A SINGLE-BIND one needs no class: consumed_rcpayload_option_frees frees it at
// its consuming match, at fn level and (since #4357) per block. What leaked was
// the REBOUND form — `var o: Option[i32[]] = Some([..]); while { o = Some([..]) }`
// — because every one of those consuming-match analyses refuses a reassigned
// name outright, and no rebind class existed to pick it up. Measured 40000 bytes
// over 100 rounds with ZERO releases emitted, where the same value bound once is
// flat at 0.
//
// That blunt `reassigned` exclusion is shared by all three Option siblings, so
// the rebound arr-of-arr / struct / tuple forms leak for the same reason; this
// class fixes only the flat-scalar-array kind, which is the one the #6127 sweep
// measures and the only one with no class at all.
//
// DISJOINTNESS is structural and load-bearing: this class credits ONLY names
// that ARE reassigned, which is the exact complement of the gate every
// consuming-match analysis applies. A name is therefore claimed by this class or
// by those, never both, so no box is freed twice.

// optarr_ann_is: `type_name` is `Option[<leak-safe scalar array>]` — Option of a
// flat i32[]/i64[]/f64[]/boolean[] buffer, whose whole release is one rc-dec.
function optarr_ann_is(type_name: string): boolean {
    var inner: string = opttup_inner_type(type_name);
    return is_leaksafe_array_field(inner);
}

// unmatched_optarr_ann_is: optarr_ann_is widened to Result (#6360). Kept
// SEPARATE from optarr_ann_is so the reassigned+match class it gates is
// untouched — this predicate is read only by collect_unmatched_optarr_names.
//
// `Result[<leak-safe scalar array>, _]` is admissible for the same reason the
// Option spelling is: emit_optarr_deep_free dispatches on the RUNTIME tag, and
// tag 0 is Some AND Ok (lower_match: `want = 1` for None and Err alike,
// irlower.fern), so the Ok buffer is released on the Ok path and the box on
// every path. A non-scalar Err payload is stranded, not dangled — the same
// trade cbeMixedErrPathSrc already pins, and strictly better than leaking the
// box as well.
function unmatched_optarr_ann_is(type_name: string): boolean {
    if (optarr_ann_is(type_name)) { return true; }
    if (type_name.len() < 9) { return false; }
    if (slice_unchecked(type_name, 0, 7) != "Result[") { return false; }
    if (type_name[type_name.len() - 1] != b']') { return false; }
    return is_leaksafe_array_field(opt_payload_type(type_name, "Ok"));
}

// unmatched_optstr_ann_is / unmatched_optstr_init_is_fresh: the STRING-payload
// siblings of the two predicates below (#6360). `Option[string]` and
// `Result[string, _]` reach the same uncovered quadrant — never reassigned, never
// matched — and leak both box and payload there (22400 over 100 rounds on the
// Option spelling, x2.0 per doubling, where the array spelling is flat at 0).
//
// The payload release is __fern_str_free rather than the flat rc-dec, which is
// the whole reason these need their own tag: a string box carries a separate data
// buffer and a different block class, so the array dec would free it wrongly.
//
// Freshness is REQUIRED here in a way the array siblings do not need it. The array
// admission leans on the caller-side escape analysis reading an argument as an
// escape, so an aliased buffer carries no second credit. A string does not get
// that: op_opt_make stores its payload uncounted and a string assignment is a
// borrow, so an aliased payload would be released under a live reference. Hence a
// literal or a syntactically-fresh producer for the inline form, and the registry's
// "f" flag — the same proof rcpayload_option_call_ptype uses — for the call form.
function unmatched_optstr_ann_is(type_name: string): boolean {
    if (opttup_inner_type(type_name) == "string") { return true; }
    if (type_name.len() < 9) { return false; }
    if (slice_unchecked(type_name, 0, 7) != "Result[") { return false; }
    if (type_name[type_name.len() - 1] != b']') { return false; }
    return opt_payload_type(type_name, "Ok") == "string";
}

// unmatched_optstr_payload_is_fresh: the Some/Ok payload proof — a
// syntactically fresh string, or a call to a str_fresh_ret_fns_of-registered
// producer (every return a fresh string, aliased returns refused by the
// registry's own fixpoint). The same disjunction the RCENUM string-payload arm
// already makes; OPTSTR was the one rc family still asking only the syntactic
// half, which is what kept `Some(mk("abc"))` off its credit.
function unmatched_optstr_payload_is_fresh(e: ast.Expr, str_fresh_ret: string[]): boolean {
    if (str_call_ret_is_fresh_reg(e, str_fresh_ret)) { return true; }
    return str_local_binding_is_fresh(e);
}

function unmatched_optstr_init_is_fresh(e: ast.Expr, opt_fresh_reg: SigReg, str_fresh_ret: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Some" || cid.name == "Ok") {
                        if (c.args.len() != 1) { return false; }
                        match (c.args[0]) {
                            ast.ExprString(_) => { return true; },
                            _ => { return unmatched_optstr_payload_is_fresh(c.args[0], str_fresh_ret); }
                        }
                    }
                    // `Err(<anything>)` on a Result[string, _]: the Ok-only payload
                    // free cannot reach an Err payload, so the box still qualifies.
                    if (cid.name == "Err") { return c.args.len() == 1; }
                    return sig_reg_opt_payload_fresh(opt_fresh_reg, cid.name);
                },
                _ => { return false; }
            }
        },
        ast.ExprIdent(id) => { return id.name == "None"; },
        _ => {}
    }
    return false;
}

// unmatched_optarr_init_is_fresh: optarr_init_is_fresh plus the Result
// spellings, plus a call to an OPTFRESH-registered producer. `Err(<anything>)`
// is admitted because the box still needs releasing and the Ok-only payload
// free cannot reach an Err payload.
//
// The call form is the same admission rcpayload_option_call_ptype makes on the
// match-consumed side: registry membership (opt_fresh_ret_fns_of) proves every
// return of the callee is a direct constructor, so the box is rc=1 and sole-
// owned exactly as an inline ctor would be. An `Ok(<param array>)` producer
// registers too and the payload dec then lands on a buffer the caller also
// holds — but only via an argument, which the caller-side escape analysis
// already reads as an escape, so that buffer carries no second credit to
// collide with. Measured on `Result[i32[], string]`: 800 allocs / 800 frees.
function unmatched_optarr_init_is_fresh(e: ast.Expr, opt_fresh_reg: SigReg): boolean {
    if (optarr_init_is_fresh(e)) { return true; }
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Ok" && c.args.len() == 1) {
                        match (c.args[0]) {
                            ast.ExprArray(_) => { return true; },
                            _ => { return false; }
                        }
                    }
                    if (cid.name == "Err" && c.args.len() == 1) { return true; }
                    return sig_reg_has_name(opt_fresh_reg, cid.name);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// optarr_init_is_fresh: `Some(<fresh scalar array literal>)` or `None`. A bare
// ident payload would alias a live local whose own sweep also frees the buffer.
function optarr_init_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        match (c.args[0]) {
                            ast.ExprArray(_) => { return true; },
                            _ => { return false; }
                        }
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        ast.ExprIdent(nid) => { return nid.name == "None"; },
        _ => { return false; }
    }
    return false;
}

// opt_assign_is_fresh: does `e` build a FRESH Option box of the given payload
// `kind` — the same predicate each class already applies to its DECLARATION,
// dispatched by kind so one rebind walker serves all four.
//   "arr"     Option[<flat scalar array>]        (OPTARR:)
//   "arrarr"  Option[<scalar arr-of-arr>]        (OPTARRARR:)
//   "struct"  Option[<struct-with-array>]        (OPTSTRUCT:)
//   "tup"     Option[<tuple-with-array>]         (OPTTUP:)
function opt_assign_is_fresh(e: ast.Expr, kind: string, inner: string, structs: parser.StructDecl[], opt_fresh_reg: SigReg, str_fresh_ret: string[]): boolean {
    if (kind == "tup") { return opttup_init_is_fresh(inner, e, structs); }
    if (kind == "struct") { return optstruct_init_is_fresh(e, structs); }
    if (kind == "arrarr") { return optarrarr_init_is_fresh(e); }
    // A STRING payload's freshness is not a purely syntactic test — a producer
    // call qualifies only through the registry's "f" flag — so this kind is the
    // reason the walker carries the two registries at all (#7712).
    if (kind == "str") { return unmatched_optstr_init_is_fresh(e, opt_fresh_reg, str_fresh_ret); }
    if (kind == "optopt") { return unmatched_optopt_init_is_fresh(e); }
    return optarr_init_is_fresh(e);
}

// opt_rebinds_all_fresh: EVERY assignment to `name` in this statement list (and
// nested blocks) itself builds a fresh Option box. This is the SARR: discipline —
// validate each rebind individually rather than refusing the name for being
// reassigned at all, which is what left every rebound Option uncredited.
//
// One walker for the whole family (#6127). The four collectors are structurally
// identical and differ only in which freshness predicate they apply, so the
// recursion belongs in one place; opt_assign_is_fresh carries the difference.
function opt_rebinds_all_fresh(stmts: ast.Stmt[], name: string, kind: string, inner: string, structs: parser.StructDecl[], opt_fresh_reg: SigReg, str_fresh_ret: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name && !opt_assign_is_fresh(a.value, kind, inner, structs, opt_fresh_reg, str_fresh_ret)) { return false; }
            },
            ast.StmtIf(f) => {
                if (!opt_rebinds_all_fresh(f.then_body, name, kind, inner, structs, opt_fresh_reg, str_fresh_ret)) { return false; }
                if (!opt_rebinds_all_fresh(f.else_body, name, kind, inner, structs, opt_fresh_reg, str_fresh_ret)) { return false; }
            },
            ast.StmtWhile(w) => { if (!opt_rebinds_all_fresh(w.body, name, kind, inner, structs, opt_fresh_reg, str_fresh_ret)) { return false; } },
            ast.StmtFor(fo) => { if (!opt_rebinds_all_fresh(fo.body, name, kind, inner, structs, opt_fresh_reg, str_fresh_ret)) { return false; } },
            ast.StmtMatch(m) => {
                for arm in m.arms {
                    if (!opt_rebinds_all_fresh(arm.body, name, kind, inner, structs, opt_fresh_reg, str_fresh_ret)) { return false; }
                }
            },
            _ => {}
        }
    }
    return true;
}

// optarr_arm_expr_escapes: does `e` use the Some-payload FLAT-ARRAY binding `a` in
// an escaping way? `a[i]` reads a SCALAR out of the buffer and `a.len()` reads its
// header, so both are borrows; a bare `a` (call arg, container element, return)
// takes the buffer pointer and escapes.
//
// This is where the arr-of-arr walker cannot be reused: there `g[i]` extracts a
// ROW POINTER and is rightly an escape, while here the same syntax yields an i32.
// Borrowing that walker would refuse every ordinary `a[0]` read.
function optarr_arm_expr_escapes(e: ast.Expr, a: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == a; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprIndex(ix) => {
            var base_is_a: boolean = false;
            match (ix.array) {
                ast.ExprIdent(bid) => { if (bid.name == a) { base_is_a = true; } },
                _ => {}
            }
            if (base_is_a) { return optarr_arm_expr_escapes(ix.index, a); }   // a[i]: scalar read
            return optarr_arm_expr_escapes(ix.array, a) || optarr_arm_expr_escapes(ix.index, a);
        },
        ast.ExprBinary(b) => { return optarr_arm_expr_escapes(b.left, a) || optarr_arm_expr_escapes(b.right, a); },
        ast.ExprUnary(u) => { return optarr_arm_expr_escapes(u.operand, a); },
        ast.ExprFieldAccess(fa) => { return optarr_arm_expr_escapes(fa.obj, a); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    var recv_borrow: boolean = false;
                    if (cfa.field == "len") {
                        match (cfa.obj) {
                            ast.ExprIdent(rid) => { if (rid.name == a) { recv_borrow = true; } },
                            _ => {}
                        }
                    }
                    if (!recv_borrow && optarr_arm_expr_escapes(cfa.obj, a)) { return true; }
                },
                _ => { if (optarr_arm_expr_escapes(c.callee, a)) { return true; } }
            }
            for arg in c.args { if (optarr_arm_expr_escapes(arg, a)) { return true; } }
            return false;
        },
        _ => { return true; }
    }
    return true;
}

// optarr_arm_stmt_escapes: lift optarr_arm_expr_escapes over one statement.
function optarr_arm_stmt_escapes(st: ast.Stmt, a: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return optarr_arm_expr_escapes(v.init, a); },
        ast.StmtAssign(asg) => { return optarr_arm_expr_escapes(asg.value, a); },
        ast.StmtExpr(ex) => { return optarr_arm_expr_escapes(ex.value, a); },
        ast.StmtReturn(r) => { return optarr_arm_expr_escapes(r.value, a); },
        ast.StmtIf(f) => {
            if (optarr_arm_expr_escapes(f.cond, a)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (optarr_arm_stmt_escapes(f.then_body[ti], a)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (optarr_arm_stmt_escapes(f.else_body[ei], a)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (optarr_arm_expr_escapes(w.cond, a)) { return true; }
            var wi: i32 = 0;
            while (wi < w.body.len()) { if (optarr_arm_stmt_escapes(w.body[wi], a)) { return true; } wi = wi + 1; }
            return false;
        },
        _ => { return true; }
    }
    return true;
}

// optarr_payload_escapes: does the Some-arm payload binding of `name` escape
// anywhere? Mirrors optarrarr_payload_escapes with the flat-array borrow rules.
function optarr_payload_escapes(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var is_scrut: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { if (sid.name == name) { is_scrut = true; } },
                    _ => {}
                }
                if (is_scrut) {
                    for arm in m.arms {
                        match (arm.pattern) {
                            ast.PatVariant(pv) => {
                                var vn: string = pv.type_name;
                                var vc: i32 = 0;
                                while (vc < pv.type_name.len()) { if (pv.type_name[vc] == b'.') { vn = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; } vc = vc + 1; }
                                if (vn == "Some" && pv.binding != "" && pv.binding != "_") {
                                    if (arm.has_guard && optarr_arm_expr_escapes(arm.guard, pv.binding)) { return true; }
                                    var bi: i32 = 0;
                                    while (bi < arm.body.len()) { if (optarr_arm_stmt_escapes(arm.body[bi], pv.binding)) { return true; } bi = bi + 1; }
                                }
                            },
                            _ => {}
                        }
                    }
                }
                for arm in m.arms { if (optarr_payload_escapes(arm.body, name)) { return true; } }
            },
            ast.StmtIf(f) => {
                if (optarr_payload_escapes(f.then_body, name)) { return true; }
                if (optarr_payload_escapes(f.else_body, name)) { return true; }
            },
            ast.StmtWhile(w) => { if (optarr_payload_escapes(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (optarr_payload_escapes(fo.body, name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// collect_fresh_optarr_names: REBOUND `Option[<flat scalar array>]` locals whose
// every binding and rebinding is a fresh Some([..]) / None, consumed by exactly one
// match in this statement list, dead after it, non-escaping, and whose Some arm
// binds the payload only as a borrow. Reassignment is REQUIRED here (see the
// disjointness note above), so a single-bind local is left to
// consumed_rcpayload_option_frees.
//
// The escape gate is name_escapes_outside_stmt with the consuming match SKIPPED,
// exactly as the sibling collectors use it — body_unsafe_for cannot be substituted
// here, because it reads a bare-ident match SCRUTINEE as an escape and so refuses
// every match-consumed Option outright.
// collect_unmatched_optarr_names: the OTHER uncovered quadrant of the
// rc-payload Option family (#6360) — a `Option[<flat scalar array>]` local that
// is NEITHER reassigned NOR consumed by a match, so neither
// collect_fresh_optarr_names (which requires reassignment) nor
// consumed_rcpayload_option_frees (which requires a sole consuming match) ever
// looks at it. Measured: `var v: Option[i32[]] = Some([..])` with no match
// leaks 35200 over 100 rounds at frees=0, while the byte-identical shape WITH a
// match is flat at 0 — the match was the entire reclaim.
//
// Credited under the SAME "OPTARR:" tag, so the exit sweep and
// slot_is_reclaimable_optarr both pick it up unchanged. The
// loop-rebind consumer cannot fire for these names because they are never
// reassigned, which is exactly what makes sharing the tag safe.
//
// body_unsafe_for is the right escape gate HERE, and is the one the sibling
// collector cannot use: it reads a bare-ident match scrutinee as an escape, so
// it refuses every match-consumed Option outright — which is precisely the set
// this collector must exclude. Disjointness from both match analyses is
// therefore a property of the gate, not a separate check that could drift.
// collect_unmatched_optstr_names: the STRING-payload sibling of the collector
// below (#6360). Same quadrant, same gates; only the annotation and the freshness
// test differ, and the credit is tagged "OPTSTR:" so the sweep picks the
// __fern_str_free release rather than the flat dec.
// unmatched_optarr_err_str_fresh: this local's declared Err payload is a string
// AND the value it was bound from proves every Err payload fresh — an inline
// `Err(<literal / fresh producer>)`, or a call to an ERRFRESH-registered producer
// (#6360). Per-LOCAL rather than per-slot-class because the OPTARR credit is
// shared with the reassigned+match class.
function unmatched_optarr_err_str_fresh(stmts: ast.Stmt[], name: string, opt_fresh_reg: SigReg): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (opt_payload_type(v.type_name, "Err") != "string") { return false; }
                    if (call_init_callee_err_fresh(v.init, opt_fresh_reg)) { return true; }
                    match (v.init) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprIdent(cid) => {
                                    if (cid.name == "Err" && c.args.len() == 1) {
                                        match (c.args[0]) {
                                            ast.ExprString(_) => { return true; },
                                            _ => { return str_local_binding_is_fresh(c.args[0]); }
                                        }
                                    }
                                    // `Ok(..)` inline: this binding can never hold an
                                    // Err payload, so there is nothing to release.
                                    return false;
                                },
                                _ => { return false; }
                            }
                        },
                        _ => {}
                    }
                    return false;
                }
            },
            ast.StmtIf(f) => { if (unmatched_optarr_err_str_fresh(f.then_body, name, opt_fresh_reg) || unmatched_optarr_err_str_fresh(f.else_body, name, opt_fresh_reg)) { return true; } },
            ast.StmtWhile(w) => { if (unmatched_optarr_err_str_fresh(w.body, name, opt_fresh_reg)) { return true; } },
            ast.StmtFor(fo) => { if (unmatched_optarr_err_str_fresh(fo.body, name, opt_fresh_reg)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (unmatched_optarr_err_str_fresh(m.arms[a].body, name, opt_fresh_reg)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

function collect_unmatched_optstr_names(stmts: ast.Stmt[], opt_fresh_reg: SigReg, str_fresh_ret: string[], plan_on: boolean, plan_fe: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                // Union of the two sound grants (see the OPTAARR: note): the
                // credit proof keeps call-provenance shapes the plan cannot
                // yet type through returnsNoParamEscape; the plan adds the
                // call-arg grants, still refusing any matched local.
                var os_esc_ok: boolean = opt_unmatched_esc_ok(stmts, v.name, reclaim_site_key_of(v.name, v.line, v.col), plan_on, plan_fe, opt_alias_bind_sites_of(stmts, v.name));
                if (unmatched_optstr_ann_is(v.type_name)
                    && unmatched_optstr_init_is_fresh(v.init, opt_fresh_reg, str_fresh_ret)
                    && util.index_of_str(reassigned, v.name) < 0
                    && os_esc_ok) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_unmatched_optstr_names(f.then_body, opt_fresh_reg, str_fresh_ret, plan_on, plan_fe, a); a = collect_unmatched_optstr_names(f.else_body, opt_fresh_reg, str_fresh_ret, plan_on, plan_fe, a); },
            ast.StmtWhile(w) => { a = collect_unmatched_optstr_names(w.body, opt_fresh_reg, str_fresh_ret, plan_on, plan_fe, a); },
            ast.StmtFor(fo) => { a = collect_unmatched_optstr_names(fo.body, opt_fresh_reg, str_fresh_ret, plan_on, plan_fe, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_unmatched_optstr_names(arm.body, opt_fresh_reg, str_fresh_ret, plan_on, plan_fe, a); }
            },
            _ => {}
        }
    }
    return a;
}

// opt_unmatched_esc_ok: the escape gate the Option classes with no consuming
// match share. Off-plan it is the ordinary non-escape proof; on-plan the
// frame-escape analysis grants it and the two extra clauses re-impose what that
// analysis does not model — a matched local and an alias bind.
//
// `alias_ok` is opt_alias_bind_sites_of's verdict for this name (#7687). A
// vetted alias now carries a retain and a box-only credit of its own, so it is
// forgiven on both paths; an alias the vetting rejected still refuses the credit
// outright, because nothing accounts for the reference it takes — which on the
// plan path is what the count comparison says: every bind vetted, or none of it.
function opt_unmatched_esc_ok(stmts: ast.Stmt[], name: string, key: string, plan_on: boolean, plan_fe: string[], alias_ok: string[]): boolean {
    if (!plan_on) { return !body_unsafe_for_alias(stmts, name, [], [], alias_ok); }
    return util.index_of_str(plan_fe, key) >= 0 && !name_is_match_scrutinee(stmts, name)
        && opt_alias_chain_closure(stmts, name).len() == alias_ok.len();
}

// unmatched_optopt_ann_is / unmatched_optopt_init_is_fresh: the NESTED-OPTION
// members of the set emit_optarr_deep_free can release with a flat dec (#7714).
// The payload of an `Option[Option[<scalar>]]` IS the inner option box — an
// rc-headered block owning no pointer — so the emitter's existing payload dec is
// its complete release. No new emitter and no deep walk; the credit was the only
// missing piece, exactly as the Result widening above rides the same emitter.
//
// type_is_scalar_union is the gate for the same reason it is elsewhere: a flat
// dec frees the inner box but nothing the box owns, so an rc inner payload
// (`Option[Option[string]]`) would be stranded. Those want the deep release and
// stay uncredited here.
function unmatched_optopt_ann_is(type_name: string): boolean {
    return type_is_scalar_union(opttup_inner_type(type_name));
}

// The construction must ALLOCATE the inner box here rather than alias one the
// caller owns: `Some(Some(x))`, `Some(None)`, or a bare `None`. A `Some(inner)`
// of an existing local is refused — the family's usual freshness requirement,
// and load-bearing for the same reason (the payload is stored uncounted).
function unmatched_optopt_init_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprIdent(nid) => { return nid.name == "None"; },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name != "Some" || c.args.len() != 1) { return false; }
                    match (c.args[0]) {
                        ast.ExprIdent(aid) => { return aid.name == "None"; },
                        ast.ExprCall(ic) => {
                            match (ic.callee) {
                                ast.ExprIdent(icid) => { return (icid.name == "Some" || icid.name == "Ok" || icid.name == "Err") && ic.args.len() == 1; },
                                _ => { return false; }
                            }
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// collect_unmatched_optopt_rc_names: the rc-INNER nested-Option sibling of the
// collector below (#7718). Same quadrant and the same gates; only the payload
// kind and the release differ, so it carries its own "OPTOPTRC:" tag routing to
// emit_optopt_rc_deep_free instead of the flat dec.
//
// Disjoint from that collector by annotation: nested_opt_inner_freefn answers
// non-empty exactly where unmatched_optopt_ann_is (type_is_scalar_union) answers
// false, so no slot can be credited under both tags and no box is freed twice.
// collect_optopt_rebind_names: a nested-Option local that IS consumed by a sole
// top-level match AND is reassigned with every rebind fresh (#7716). Credited
// "OPTOPTRB:", which only the assign path reads, so each superseded box is
// released at its rebind while the consuming-match family releases the one the
// match consumes.
//
// Deliberately NOT disjoint from that family by construction — the two are
// computed separately and could in principle disagree — because they cannot
// collide even so: this releases the OLD value at an assignment and that
// releases the CURRENT value at the match. A disagreement costs a leak in one
// direction or the other, never a double release.
function collect_optopt_rebind_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                if (unmatched_optopt_ann_is(v.type_name)
                    && unmatched_optopt_init_is_fresh(v.init)
                    && util.index_of_str(reassigned, v.name) >= 0
                    && opt_rebinds_all_fresh(stmts, v.name, "optopt", "", [], sig_reg_empty(), [])) {
                    var mi: i32 = sole_top_level_match_idx(stmts, v.name);
                    if (mi > vi && !match_arms_use_name(stmts[mi], v.name)
                        && !name_used_after(stmts, v.name, mi)
                        && !name_escapes_outside_stmt(stmts, v.name, mi)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_optopt_rebind_names(f.then_body, a); a = collect_optopt_rebind_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = collect_optopt_rebind_names(w.body, a); },
            ast.StmtFor(fo) => { a = collect_optopt_rebind_names(fo.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_optopt_rebind_names(arm.body, a); }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

function reclaimable_optopt_rebind(ns: string[], out: string[]): string[] {
    var ri: i32 = 0;
    while (ri < ns.len()) {
        out = out.append("OPTOPTRB:" + ns[ri]);
        ri = ri + 1;
    }
    return out;
}

function collect_unmatched_optopt_rc_names(stmts: ast.Stmt[], plan_on: boolean, plan_fe: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (nested_opt_inner_freefn(opttup_inner_type(v.type_name) + "") != ""
                    && unmatched_optopt_init_is_fresh(v.init)
                    && (util.index_of_str(reassigned, v.name) < 0
                        || opt_rebinds_all_fresh(stmts, v.name, "optopt", "", [], sig_reg_empty(), []))
                    && opt_unmatched_esc_ok(stmts, v.name, reclaim_site_key_of(v.name, v.line, v.col), plan_on, plan_fe, opt_alias_bind_sites_of(stmts, v.name))) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_unmatched_optopt_rc_names(f.then_body, plan_on, plan_fe, a); a = collect_unmatched_optopt_rc_names(f.else_body, plan_on, plan_fe, a); },
            ast.StmtWhile(w) => { a = collect_unmatched_optopt_rc_names(w.body, plan_on, plan_fe, a); },
            ast.StmtFor(fo) => { a = collect_unmatched_optopt_rc_names(fo.body, plan_on, plan_fe, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_unmatched_optopt_rc_names(arm.body, plan_on, plan_fe, a); }
            },
            _ => {}
        }
    }
    return a;
}

function reclaimable_optopt_rc(ns: string[], out: string[]): string[] {
    var oi: i32 = 0;
    while (oi < ns.len()) {
        out = out.append("OPTOPTRC:" + ns[oi]);
        oi = oi + 1;
    }
    return out;
}

function collect_unmatched_optarr_names(stmts: ast.Stmt[], opt_fresh_reg: SigReg, plan_on: boolean, plan_fe: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                var oa_esc_ok: boolean = opt_unmatched_esc_ok(stmts, v.name, reclaim_site_key_of(v.name, v.line, v.col), plan_on, plan_fe, opt_alias_bind_sites_of(stmts, v.name));
                var oa_arr_ok: boolean = unmatched_optarr_ann_is(v.type_name)
                    && unmatched_optarr_init_is_fresh(v.init, opt_fresh_reg)
                    && util.index_of_str(reassigned, v.name) < 0;
                // The nested-Option spelling may be REASSIGNED provided every
                // rebind allocates its own inner box. The array spelling may not
                // here: collect_fresh_optarr_names owns its reassigned class, and
                // admitting one in both places would credit the same box twice.
                // A nested-Option local has no such sibling, so this is the only
                // credit it can earn.
                var oa_opt_ok: boolean = unmatched_optopt_ann_is(v.type_name)
                    && unmatched_optopt_init_is_fresh(v.init)
                    && (util.index_of_str(reassigned, v.name) < 0
                        || opt_rebinds_all_fresh(stmts, v.name, "optopt", "", [], sig_reg_empty(), []));
                if ((oa_arr_ok || oa_opt_ok) && oa_esc_ok) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_unmatched_optarr_names(f.then_body, opt_fresh_reg, plan_on, plan_fe, a); a = collect_unmatched_optarr_names(f.else_body, opt_fresh_reg, plan_on, plan_fe, a); },
            ast.StmtWhile(w) => { a = collect_unmatched_optarr_names(w.body, opt_fresh_reg, plan_on, plan_fe, a); },
            ast.StmtFor(fo) => { a = collect_unmatched_optarr_names(fo.body, opt_fresh_reg, plan_on, plan_fe, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_unmatched_optarr_names(arm.body, opt_fresh_reg, plan_on, plan_fe, a); }
            },
            _ => {}
        }
    }
    return a;
}

// optarr_rebound_credit_ok: a REASSIGNED Option[flat scalar array] local whose
// every rebind rebuilds it fresh earns the exit sweep + loop-rebind release
// under one of two proofs, by whether a consuming match ends its life.
//
//   - CONSUMED: a sole top-level `match (name)` after the declaration, whose
//     arms neither bind the name nor let the payload out, and after which the
//     name is dead.
//   - NOT CONSUMED: no match on it at all, and the same escape gate the
//     never-reassigned sibling class uses.
//
// The second is the quadrant that was empty. `collect_fresh_optarr_names`
// covered reassigned-and-matched and `collect_unmatched_optarr_names` covers
// neither-of-the-two, so a rebound local with nothing consuming it was credited
// by no one and swept by no one — 400 allocs, 0 frees. The disjointness the two
// classes rely on is unaffected: it rests on `reassigned`, which this does not
// touch.
function optarr_rebound_credit_ok(stmts: ast.Stmt[], v: ast.StmtVar, vi: i32, plan_on: boolean, plan_fe: string[]): boolean {
    if (optarr_payload_escapes(stmts, v.name)) { return false; }
    var match_idx: i32 = sole_top_level_match_idx(stmts, v.name);
    if (match_idx > vi) {
        return !match_arms_use_name(stmts[match_idx], v.name)
            && !name_used_after(stmts, v.name, match_idx)
            && !name_escapes_outside_stmt(stmts, v.name, match_idx);
    }
    // sole_top_level_match_idx answers -1 for NO match and for more than one
    // alike, so the scrutinee test is what separates them; two matches stay
    // refused.
    //
    // The non-escape proof is asked DIRECTLY rather than through
    // opt_unmatched_esc_ok, which the never-reassigned sibling uses. That one
    // may lean on the plan's frame-escape verdict because its locals are bound
    // once; a REBOUND local is a different question and the plan grants it
    // regardless of a `return name`, which measured as a WRONG ANSWER — 25
    // against native's 42 — rather than a leak. The matched branch above has
    // name_escapes_outside_stmt for the same reason.
    return !name_is_match_scrutinee(stmts, v.name)
        && !body_unsafe_for(stmts, v.name, [], []);
}

function collect_fresh_optarr_names(stmts: ast.Stmt[], plan_on: boolean, plan_fe: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                if (optarr_ann_is(v.type_name)
                    && optarr_init_is_fresh(v.init)
                    && util.index_of_str(reassigned, v.name) >= 0
                    && opt_rebinds_all_fresh(stmts, v.name, "arr", "", [], sig_reg_empty(), [])
                    && optarr_rebound_credit_ok(stmts, v, vi, plan_on, plan_fe)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_optarr_names(f.then_body, plan_on, plan_fe, a); a = collect_fresh_optarr_names(f.else_body, plan_on, plan_fe, a); },
            ast.StmtWhile(w) => { a = collect_fresh_optarr_names(w.body, plan_on, plan_fe, a); },
            ast.StmtFor(fo) => { a = collect_fresh_optarr_names(fo.body, plan_on, plan_fe, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_optarr_names(arm.body, plan_on, plan_fe, a); }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

// emit_optarr_deep_free: null-guard, then on the Some tag free the payload BUFFER
// with one __fern_rc_dec (a flat scalar array is a single rc-headered block — no
// element walk, which is what makes this the shallowest member of the family),
// then free the option box. Mirrors emit_optarrarr_deep_free with
// __fern_arrarr_free replaced by the flat dec.
function emit_optarr_deep_free(se: LowerState, slot: i32): LowerState {
    return emit_optarr_deep_free_err(se, slot, false);
}

// emit_optarr_deep_free_err: the same free with the tag guard's else-branch
// optionally releasing an Err STRING payload (#6360). `err_str` comes from the
// per-slot "OPTARRERR:" credit and is false for every slot the shared "OPTARR:"
// tag covers on its own, whose Err payload carries no freshness proof.
function emit_optarr_deep_free_err(se: LowerState, slot: i32, err_str: boolean): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // tag == 0 (Some)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());               // flat scalar-array buffer
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    if (err_str) {
        st = st.emit(ir.op_else());
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_opt_payload());
        st = st.emit(ir.op_call_direct("__fern_str_free", 1));
        st = st.emit(ir.op_drop());
    }
    st = st.emit(ir.op_end());                       // end if-Some
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the option box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_opt_box_only_free: the BOX-ONLY release for an Option/Result local whose
// credit is qualified by "NODEEP:" — an ALIAS bind, which retained the box and
// nothing else (#7687). No tag guard and no payload read: the payload belongs to
// the source's deep release, which runs exactly once whichever sweep is last.
// Null-guarded because slots are entry-zeroed and a conditional alias leaves one
// null; the slot is zeroed so a later pass decs a null rather than a freed box.
function emit_opt_box_only_free(se: LowerState, slot: i32): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    return st;
}

// emit_optopt_rc_deep_free: the EXIT-SWEEP release for an
// `Option[Option[<rc payload>]]` local (#7718) — two levels, fully guarded.
//
// This is the release for BOTH paths — the exit sweep and the
// consuming-match drop. The unguarded emitter it replaced delegated to
// emit_opt_payload_drop_via, which carries "no null / tag guard" by design
// because it ran only where the box was known live and the inner variant known.
// Neither holds at an exit sweep — an untaken branch leaves the slot null, the
// outer box may be None — and the missing INNER tag guard is what kept
// `Some(None)` out of the consuming-match candidate set too (#7718), where it
// leaked both boxes rather than needing no release. Guards could not simply
// wrap that helper: it frees the OUTER box itself, which must be freed on every
// path, not only the Some one.
//
// Depth-first, and the slot is zeroed at the end so a later pass over it decs a
// null rather than a freed box.
function emit_optopt_rc_deep_free(se: LowerState, slot: i32, inner_freefn: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // outer != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // outer tag == 0 (Some)
    st = st.emit(ir.op_if(0));
    var hn: string = "$noptsw" + util.i32_to_string(st.locals.len());
    st = st.add_local(hn);
    var h: i32 = st.slot_of(hn);
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());               // the INNER option box
    st = st.emit(ir.op_store_local(h));
    st = st.emit(ir.op_load_local(h));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // inner != 0
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(h));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // inner tag == 0 (Some)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(h));
    st = st.emit(ir.op_opt_payload());               // the inner box's rc payload
    st = st.emit(ir.op_call_direct(inner_freefn, 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-inner-Some
    st = st.emit(ir.op_load_local(h));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));   // the inner box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-inner-not-null
    st = st.emit(ir.op_end());                       // end if-outer-Some
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));   // the outer box, every path
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(slot));
    st = st.emit(ir.op_end());                       // end if-outer-not-null
    return st;
}

// emit_optstr_deep_free: emit_optarr_deep_free with __fern_str_free on the
// payload (#6360). Same null-then-tag shape; the difference is the release, and
// it is not interchangeable — a string box's data buffer is separate and its
// block class differs from the array layout.
function emit_optstr_deep_free(se: LowerState, slot: i32): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // tag == 0 (Some / Ok)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());
    st = st.emit(ir.op_call_direct("__fern_str_free", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-success
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the option box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_optstr_reclaim_store: the string sibling of emit_optarr_reclaim_store.
// Without it the exit sweep frees only the FINAL value left in the slot and every
// earlier iteration's box leaks — a loop-declared `var v` re-stores to the same
// slot, so the store is where the previous one has to go.
function emit_optstr_reclaim_store(se: LowerState, slot: i32): LowerState {
    var scratch: string = "$osf" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = emit_optstr_deep_free(st, slot);            // free old payload + box
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// emit_optarr_reclaim_store: the loop-rebind. Stash `new`, deep-free the OLD box, store new.
function emit_optarr_reclaim_store(se: LowerState, slot: i32): LowerState {
    var scratch: string = "$oaf" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = emit_optarr_deep_free_err(st, slot, slot_is_reclaimable_optarr_errstr(st, slot));   // free old payload + box
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// ── OPTARRARR: reclaim `Option[<scalar-arr-of-arr>]` locals (#4365) ──
// The arr-of-arr sibling of OPTSTRUCT: the Some payload is an arr-of-arr box, freed whole by
// the backend-complete __fern_arrarr_free (inner scalar buffers + outer). Scalar-inner only
// (i32[][]/boolean[][]/…); a string-inner arr-of-arr would need __fern_strarrarr_free
// (deferred). opt_type carries the full Option[T[][]] for this annotated binding.

// optarrarr_ann_is: `type_name` is `Option[<scalar-arr>[]]` — Option of an arr-of-arr whose
// inner element is a leak-safe scalar array.
function optarrarr_ann_is(type_name: string): boolean {
    var inner: string = opttup_inner_type(type_name);
    var n: i32 = inner.len();
    if (n < 4) { return false; }
    if (slice_unchecked(inner, n - 2, n) != "[]") { return false; }
    return is_leaksafe_array_field(slice_unchecked(inner, 0, n - 2));   // inner-inner is a scalar array (i32[]/…)
}

// optarrarr_init_is_fresh: `Some(<fresh arr-of-arr literal>)` (arrarr_lit_is_fresh) or None.
function optarrarr_init_is_fresh(e: ast.Expr): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) { return arrarr_lit_is_fresh(c.args[0], [], 0 - 1); }
                    return false;
                },
                _ => { return false; }
            }
        },
        ast.ExprIdent(nid) => { return nid.name == "None"; },
        _ => { return false; }
    }
    return false;
}

// optarrarr_arm_expr_escapes: does `e` use the Some-payload arr-of-arr binding `g` in an
// escaping way? g[i][j] (scalar read), g.len() and g[i].len() are borrows; a bare `g`
// (outer buffer) or a bare `g[i]` (an inner row buffer) extracted escapes. Erring toward
// rejection is a safe leak, never an over-release.
function optarrarr_arm_expr_escapes(e: ast.Expr, g: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == g; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIndex(inner) => {
                    match (inner.array) {
                        ast.ExprIdent(iid) => {
                            if (iid.name == g) { return optarrarr_arm_expr_escapes(inner.index, g) || optarrarr_arm_expr_escapes(ix.index, g); }
                        },
                        _ => {}
                    }
                },
                ast.ExprIdent(aid) => { if (aid.name == g) { return true; } },   // bare g[i] row escapes
                _ => {}
            }
            return optarrarr_arm_expr_escapes(ix.array, g) || optarrarr_arm_expr_escapes(ix.index, g);
        },
        ast.ExprFieldAccess(fa) => { return optarrarr_arm_expr_escapes(fa.obj, g); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        var recv_ok: boolean = false;
                        match (cfa.obj) {
                            ast.ExprIdent(rid) => { if (rid.name == g) { recv_ok = true; } },
                            ast.ExprIndex(rix) => {
                                match (rix.array) {
                                    ast.ExprIdent(riid) => { if (riid.name == g) { recv_ok = true; } },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                        if (recv_ok) {
                            match (cfa.obj) {
                                ast.ExprIndex(rix2) => { if (optarrarr_arm_expr_escapes(rix2.index, g)) { return true; } },
                                _ => {}
                            }
                            for arg in c.args { if (optarrarr_arm_expr_escapes(arg, g)) { return true; } }
                            return false;
                        }
                    }
                },
                _ => {}
            }
            if (optarrarr_arm_expr_escapes(c.callee, g)) { return true; }
            for arg in c.args { if (optarrarr_arm_expr_escapes(arg, g)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return optarrarr_arm_expr_escapes(b.left, g) || optarrarr_arm_expr_escapes(b.right, g); },
        ast.ExprUnary(u) => { return optarrarr_arm_expr_escapes(u.operand, g); },
        ast.ExprSlice(sl) => { return optarrarr_arm_expr_escapes(sl.array, g) || optarrarr_arm_expr_escapes(sl.start, g) || optarrarr_arm_expr_escapes(sl.end, g); },
        ast.ExprArray(ar) => { var i: i32 = 0; while (i < ar.elements.len()) { if (optarrarr_arm_expr_escapes(ar.elements[i], g)) { return true; } i = i + 1; } return false; },
        ast.ExprTuple(t) => { for el in t.elements { if (optarrarr_arm_expr_escapes(el, g)) { return true; } } return false; },
        ast.ExprStructLit(slb) => {
            if (slb.has_base && optarrarr_arm_expr_escapes(slb.base, g)) { return true; }
            var i: i32 = 0;
            while (i < slb.field_values.len()) { if (optarrarr_arm_expr_escapes(slb.field_values[i], g)) { return true; } i = i + 1; }
            return false;
        },
        _ => { return false; }
    }
    return false;
}
function optarrarr_arm_stmt_escapes(st: ast.Stmt, g: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return optarrarr_arm_expr_escapes(v.init, g); },
        ast.StmtReturn(r) => { return optarrarr_arm_expr_escapes(r.value, g); },
        ast.StmtExpr(e) => { return optarrarr_arm_expr_escapes(e.value, g); },
        ast.StmtAssign(a) => { return optarrarr_arm_expr_escapes(a.value, g); },
        ast.StmtIf(f) => {
            if (optarrarr_arm_expr_escapes(f.cond, g)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (optarrarr_arm_stmt_escapes(f.then_body[ti], g)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (optarrarr_arm_stmt_escapes(f.else_body[ei], g)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (optarrarr_arm_expr_escapes(w.cond, g)) { return true; }
            var i: i32 = 0;
            while (i < w.body.len()) { if (optarrarr_arm_stmt_escapes(w.body[i], g)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (optarrarr_arm_expr_escapes(fo.iter, g)) { return true; }
            var i: i32 = 0;
            while (i < fo.body.len()) { if (optarrarr_arm_stmt_escapes(fo.body[i], g)) { return true; } i = i + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (optarrarr_arm_expr_escapes(m.scrutinee, g)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && optarrarr_arm_expr_escapes(arm.guard, g)) { return true; }
                var bi: i32 = 0;
                while (bi < arm.body.len()) { if (optarrarr_arm_stmt_escapes(arm.body[bi], g)) { return true; } bi = bi + 1; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return optarrarr_arm_stmt_escapes(d.action, g); },
        _ => { return false; }
    }
    return false;
}
function optarrarr_payload_escapes(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var is_scrut: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { if (sid.name == name) { is_scrut = true; } },
                    _ => {}
                }
                if (is_scrut) {
                    for arm in m.arms {
                        match (arm.pattern) {
                            ast.PatVariant(pv) => {
                                var vn: string = pv.type_name;
                                var vc: i32 = 0;
                                while (vc < pv.type_name.len()) { if (pv.type_name[vc] == b'.') { vn = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; } vc = vc + 1; }
                                if (vn == "Some" && pv.binding != "" && pv.binding != "_") {
                                    if (arm.has_guard && optarrarr_arm_expr_escapes(arm.guard, pv.binding)) { return true; }
                                    var bi: i32 = 0;
                                    while (bi < arm.body.len()) { if (optarrarr_arm_stmt_escapes(arm.body[bi], pv.binding)) { return true; } bi = bi + 1; }
                                }
                            },
                            _ => {}
                        }
                    }
                }
                for arm in m.arms { if (optarrarr_payload_escapes(arm.body, name)) { return true; } }
            },
            ast.StmtIf(f) => { if (optarrarr_payload_escapes(f.then_body, name) || optarrarr_payload_escapes(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (optarrarr_payload_escapes(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (optarrarr_payload_escapes(fo.body, name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// collect_fresh_optarrarr_names: the arr-of-arr sibling of collect_fresh_opttup_names — a
// fresh Some(<arr-of-arr lit>)/None under an Option[<scalar-arr-of-arr>] annotation, consumed
// by exactly one borrow-only match in the same block, not escaping. A reassigned name is
// admitted when every rebind is itself fresh (opt_rebinds_all_fresh, #6127).
function collect_fresh_optarrarr_names(stmts: ast.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                if (optarrarr_ann_is(v.type_name)
                    && optarrarr_init_is_fresh(v.init)
                    && (util.index_of_str(reassigned, v.name) < 0
                        || opt_rebinds_all_fresh(stmts, v.name, "arrarr", "", [], sig_reg_empty(), []))) {
                    var match_idx: i32 = sole_top_level_match_idx(stmts, v.name);
                    if (match_idx > vi
                        && !match_arms_use_name(stmts[match_idx], v.name)
                        && !optarrarr_payload_escapes(stmts, v.name)
                        && !name_used_after(stmts, v.name, match_idx)
                        && !name_escapes_outside_stmt(stmts, v.name, match_idx)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_optarrarr_names(f.then_body, a); a = collect_fresh_optarrarr_names(f.else_body, a); },
            ast.StmtWhile(w) => { a = collect_fresh_optarrarr_names(w.body, a); },
            ast.StmtFor(fo) => { a = collect_fresh_optarrarr_names(fo.body, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_optarrarr_names(arm.body, a); }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

// optstr_arm_expr_escapes / optstr_arm_stmt_escapes: the STRING-payload sibling
// of optarrarr_arm_expr_escapes (#7710). A matched `Option[string]`'s arm binding
// is a BORROW — op_opt_make stores the payload uncounted and a string assignment
// does not retain — so the exit sweep may free that payload only if the arm never
// lets it outlive the match.
//
// Allow-list rather than deny-list: a bare mention of the binding escapes unless
// it is one of the scalar-producing reads below, so a use this does not recognise
// denies the credit (the shape keeps leaking) instead of releasing a live
// reference. `len()` is the only method admitted — a string method returning a
// VIEW of the receiver would hand the payload out, and none is worth admitting
// without its own proof.
function optstr_arm_expr_escapes(e: ast.Expr, g: string): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == g; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        // `g[i]` — a byte read, a scalar, so the payload does not leave.
        ast.ExprIndex(ix) => {
            match (ix.array) {
                ast.ExprIdent(aid) => { if (aid.name == g) { return optstr_arm_expr_escapes(ix.index, g); } },
                _ => {}
            }
            return optstr_arm_expr_escapes(ix.array, g) || optstr_arm_expr_escapes(ix.index, g);
        },
        ast.ExprFieldAccess(fa) => { return optstr_arm_expr_escapes(fa.obj, g); },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        var recv_is_g: boolean = false;
                        match (cfa.obj) {
                            ast.ExprIdent(rid) => { if (rid.name == g) { recv_is_g = true; } },
                            _ => {}
                        }
                        if (recv_is_g) {
                            for arg in c.args { if (optstr_arm_expr_escapes(arg, g)) { return true; } }
                            return false;
                        }
                    }
                },
                _ => {}
            }
            if (optstr_arm_expr_escapes(c.callee, g)) { return true; }
            for arg in c.args { if (optstr_arm_expr_escapes(arg, g)) { return true; } }
            return false;
        },
        ast.ExprBinary(b) => { return optstr_arm_expr_escapes(b.left, g) || optstr_arm_expr_escapes(b.right, g); },
        ast.ExprUnary(u) => { return optstr_arm_expr_escapes(u.operand, g); },
        ast.ExprSlice(sl) => { return optstr_arm_expr_escapes(sl.array, g) || optstr_arm_expr_escapes(sl.start, g) || optstr_arm_expr_escapes(sl.end, g); },
        ast.ExprArray(ar) => { var ai: i32 = 0; while (ai < ar.elements.len()) { if (optstr_arm_expr_escapes(ar.elements[ai], g)) { return true; } ai = ai + 1; } return false; },
        ast.ExprTuple(t) => { for el in t.elements { if (optstr_arm_expr_escapes(el, g)) { return true; } } return false; },
        ast.ExprStructLit(slb) => {
            if (slb.has_base && optstr_arm_expr_escapes(slb.base, g)) { return true; }
            var si: i32 = 0;
            while (si < slb.field_values.len()) { if (optstr_arm_expr_escapes(slb.field_values[si], g)) { return true; } si = si + 1; }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function optstr_arm_stmt_escapes(st: ast.Stmt, g: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return optstr_arm_expr_escapes(v.init, g); },
        ast.StmtReturn(r) => { return optstr_arm_expr_escapes(r.value, g); },
        ast.StmtExpr(e) => { return optstr_arm_expr_escapes(e.value, g); },
        ast.StmtAssign(a) => { return optstr_arm_expr_escapes(a.value, g); },
        ast.StmtIf(f) => {
            if (optstr_arm_expr_escapes(f.cond, g)) { return true; }
            var ti: i32 = 0;
            while (ti < f.then_body.len()) { if (optstr_arm_stmt_escapes(f.then_body[ti], g)) { return true; } ti = ti + 1; }
            var ei: i32 = 0;
            while (ei < f.else_body.len()) { if (optstr_arm_stmt_escapes(f.else_body[ei], g)) { return true; } ei = ei + 1; }
            return false;
        },
        ast.StmtWhile(w) => {
            if (optstr_arm_expr_escapes(w.cond, g)) { return true; }
            var wi: i32 = 0;
            while (wi < w.body.len()) { if (optstr_arm_stmt_escapes(w.body[wi], g)) { return true; } wi = wi + 1; }
            return false;
        },
        ast.StmtFor(fo) => {
            if (optstr_arm_expr_escapes(fo.iter, g)) { return true; }
            var fi: i32 = 0;
            while (fi < fo.body.len()) { if (optstr_arm_stmt_escapes(fo.body[fi], g)) { return true; } fi = fi + 1; }
            return false;
        },
        ast.StmtMatch(m) => {
            if (optstr_arm_expr_escapes(m.scrutinee, g)) { return true; }
            for arm in m.arms {
                var mi: i32 = 0;
                while (mi < arm.body.len()) { if (optstr_arm_stmt_escapes(arm.body[mi], g)) { return true; } mi = mi + 1; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// optstr_payload_escapes: does the `match (name)` arm binding outlive the match?
// The string sibling of optarrarr_payload_escapes.
function optstr_payload_escapes(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtMatch(m) => {
                var is_scrut: boolean = false;
                match (m.scrutinee) {
                    ast.ExprIdent(sid) => { if (sid.name == name) { is_scrut = true; } },
                    _ => {}
                }
                if (is_scrut) {
                    for arm in m.arms {
                        match (arm.pattern) {
                            ast.PatVariant(pv) => {
                                var vn: string = pv.type_name;
                                var vc: i32 = 0;
                                while (vc < pv.type_name.len()) { if (pv.type_name[vc] == b'.') { vn = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + ""; } vc = vc + 1; }
                                if ((vn == "Some" || vn == "Ok") && pv.binding != "" && pv.binding != "_") {
                                    if (arm.has_guard && optstr_arm_expr_escapes(arm.guard, pv.binding)) { return true; }
                                    var bi: i32 = 0;
                                    while (bi < arm.body.len()) { if (optstr_arm_stmt_escapes(arm.body[bi], pv.binding)) { return true; } bi = bi + 1; }
                                }
                            },
                            _ => {}
                        }
                    }
                }
                for arm in m.arms { if (optstr_payload_escapes(arm.body, name)) { return true; } }
            },
            ast.StmtIf(f) => { if (optstr_payload_escapes(f.then_body, name) || optstr_payload_escapes(f.else_body, name)) { return true; } },
            ast.StmtWhile(w) => { if (optstr_payload_escapes(w.body, name)) { return true; } },
            ast.StmtFor(fo) => { if (optstr_payload_escapes(fo.body, name)) { return true; } },
            _ => {}
        }
    }
    return false;
}

// collect_fresh_optstr_names: the MATCH-CONSUMED quadrant of the OPTSTR family
// (#7710) — a fresh `Some(<fresh string>)` / None under an `Option[string]` /
// `Result[string, _]` annotation, consumed by exactly one borrow-only match in
// the same block, not escaping. The string sibling of
// collect_fresh_optarrarr_names, and the complement of
// collect_unmatched_optstr_names: that collector's escape gate reads a bare-ident
// match scrutinee as an escape, so it refuses every match-consumed Option
// outright, which is precisely the set this one admits. The two are therefore
// disjoint by construction and no box is credited twice.
//
// Freshness is required for the same reason the unmatched sibling requires it: a
// string payload is stored uncounted and assignment borrows it, so an aliased
// payload would be released under a live reference.
function collect_fresh_optstr_names(stmts: ast.Stmt[], opt_fresh_reg: SigReg, str_fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    var vi: i32 = 0;
    while (vi < stmts.len()) {
        match (stmts[vi]) {
            ast.StmtVar(v) => {
                if (unmatched_optstr_ann_is(v.type_name)
                    && unmatched_optstr_init_is_fresh(v.init, opt_fresh_reg, str_fresh_ret)
                    && (util.index_of_str(reassigned, v.name) < 0
                        || opt_rebinds_all_fresh(stmts, v.name, "str", "", [], opt_fresh_reg, str_fresh_ret))) {
                    var match_idx: i32 = sole_top_level_match_idx(stmts, v.name);
                    if (match_idx > vi
                        && !match_arms_use_name(stmts[match_idx], v.name)
                        && !optstr_payload_escapes(stmts, v.name)
                        && !name_used_after(stmts, v.name, match_idx)
                        && !name_escapes_outside_stmt(stmts, v.name, match_idx)) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_optstr_names(f.then_body, opt_fresh_reg, str_fresh_ret, a); a = collect_fresh_optstr_names(f.else_body, opt_fresh_reg, str_fresh_ret, a); },
            ast.StmtWhile(w) => { a = collect_fresh_optstr_names(w.body, opt_fresh_reg, str_fresh_ret, a); },
            ast.StmtFor(fo) => { a = collect_fresh_optstr_names(fo.body, opt_fresh_reg, str_fresh_ret, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_optstr_names(arm.body, opt_fresh_reg, str_fresh_ret, a); }
            },
            _ => {}
        }
        vi = vi + 1;
    }
    return a;
}

// slot_is_reclaimable_optstr: slot i holds an unmatched, never-reassigned,
// fresh-payload `Option[string]` / `Result[string, _]` credited "OPTSTR:" — the
// exit sweep frees it via emit_optstr_deep_free. No loop-rebind consumer: these
// names are never reassigned, which is what the credit requires.
// slot_is_reclaimable_optarr_errstr: the OPTARR slot additionally credited
// "OPTARRERR:" — its Err payload is a proven-fresh string, so the deep free may
// release it instead of stranding it (#6360).
function slot_is_reclaimable_optarr_errstr(s: LowerState, i: i32): boolean {
    return slot_credit_at(s, i, "OPTARRERR:");
}

// slot_is_reclaimable_optopt_rc: an `Option[Option[<rc payload>]]` local
// credited "OPTOPTRC:" — released by emit_optopt_rc_deep_free rather than the
// flat dec its scalar-inner sibling rides (#7718). Disjoint from "OPTARR:" by
// annotation: nested_opt_inner_freefn answers non-empty exactly where
// type_is_scalar_union answers false.
// slot_is_reclaimable_optopt_rebind: a MATCH-CONSUMED, reassigned nested-Option
// local credited "OPTOPTRB:" (#7716). Read by the ASSIGN path only — never by
// the exit sweep — because the consuming-match family already releases the box
// the match consumes, and this credit exists solely to release each SUPERSEDED
// box at its own rebind. The two therefore act on disjoint values.
function slot_is_reclaimable_optopt_rebind(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].opt_type.len() == 0) { return false; }
    return slot_credit_at(s, i, "OPTOPTRB:");
}

function slot_is_reclaimable_optopt_rc(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].opt_type.len() == 0) { return false; }
    return slot_credit_at(s, i, "OPTOPTRC:");
}

function slot_is_reclaimable_optstr(s: LowerState, i: i32): boolean {
    return slot_credit_at(s, i, "OPTSTR:");
}

// slot_is_reclaimable_optarr: slot i holds a REBOUND, fresh, non-escaping
// Option[<flat scalar array>] local credited "OPTARR:" by reclaimable_names_of.
// Its payload is one rc-headered buffer, so the release is a flat dec of the
// payload then the option box (emit_optarr_deep_free). #6127.
function slot_is_reclaimable_optarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.locals[i].opt_type.len() == 0) { return false; }
    return slot_credit_at(s, i, "OPTARR:");
}

// slot_is_reclaimable_optarrarr: slot i holds a fresh, non-escaping
// `Option[<scalar-arr-of-arr>]` local, credited "OPTARRARR:" by reclaimable_names_of.
function slot_is_reclaimable_optarrarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    // An option-box slot (opt_type set — inference may collapse the arr-of-arr payload a
    // level, so match on the CREDIT, not the opt_type shape). The credit is granted only by
    // collect_fresh_optarrarr_names on the authoritative Option[<scalar-arr-of-arr>]
    // annotation, so it uniquely identifies genuine arr-of-arr option slots.
    if (s.locals[i].opt_type.len() == 0) { return false; }
    return slot_credit_at(s, i, "OPTARRARR:");
}

// emit_optarrarr_deep_free frees the option box in `slot`: null-guarded, if Some
// (op_opt_tag == 0) it extracts the arr-of-arr payload and frees it whole via
// __fern_arrarr_free (inner buffers + outer), then decs the option box. A None box skips to
// the box dec. Leaves the slot dangling.
function emit_optarrarr_deep_free(se: LowerState, slot: i32): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // old != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_tag());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));         // tag == 0 (Some)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_opt_payload());               // arr-of-arr box ptr
    st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1));       // free inner buffers + outer
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-Some
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));            // free the option box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_optarrarr_reclaim_store: the loop-rebind. Stash `new`, deep-free the OLD box, store new.
function emit_optarrarr_reclaim_store(se: LowerState, slot: i32): LowerState {
    var scratch: string = "$oar" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = emit_optarrarr_deep_free(st, slot);         // free old box + payload
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// ── ARRTUP: reclaim `(<tuple-with-array>)[]` array-of-tuples locals (#4365) ──
// arrtup_elem_tuple_type: for an array type `(<tuple>)[]`, return the element tuple
// type `(<tuple>)` when it is deep-droppable (>=1 array, all scalar / leaf array /
// nested tuple), else "". The element boxes are tuples carrying fresh arrays; the
// release walks the buffer element-by-element and type-drives each tuple's drop.
function arrtup_elem_tuple_type(type_name: string, structs: parser.StructDecl[]): string {
    var n: i32 = type_name.len();
    if (n < 4) { return ""; }
    if (slice_unchecked(type_name, n - 2, n) != "[]") { return ""; }
    var elem: str = slice_unchecked(type_name, 0, n - 2);
    if (!tuple_field_deep_droppable(elem, structs)) { return ""; }
    return elem + "";
}

// arrtup_ann_is: `type_name` is `(<tuple-with-array>)[]` (arrtup_elem_tuple_type
// parses + validates; this is the boolean gate).
function arrtup_ann_is(type_name: string, structs: parser.StructDecl[]): boolean {
    return arrtup_elem_tuple_type(type_name, structs) != "";
}

// arrtup_lit_is_fresh: `e` is a non-empty array literal whose EVERY element is a
// FRESH tuple literal for the element type `ttype` — every array position a direct
// array literal (tuple_arg_payload_fresh), so each element tuple box AND its arrays
// are sole-owned at the binding. A scalar position accepts any expression.
function arrtup_lit_is_fresh(e: ast.Expr, ttype: string, structs: parser.StructDecl[], str_fresh: string[]): boolean {
    match (e) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < arr.elements.len()) {
                if (!tuple_arg_payload_droppable(ttype, arr.elements[i], structs, false, str_fresh)) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// body_has_nonfresh_arrtup_return: any return whose value is NOT a fresh
// `(<tuple-with-array>)[]` literal for element type `elem`. The array-of-tuples
// sibling of body_has_nonfresh_arrlit_return, which needs no per-element proof
// because its elements are scalars.
function body_has_nonfresh_arrtup_return(stmts: ast.Stmt[], elem: string, structs: parser.StructDecl[], str_fresh: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => { if (!arrtup_lit_is_fresh(r.value, elem, structs, str_fresh)) { return true; } },
            ast.StmtIf(f) => { if (body_has_nonfresh_arrtup_return(f.then_body, elem, structs, str_fresh) || body_has_nonfresh_arrtup_return(f.else_body, elem, structs, str_fresh)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_arrtup_return(w.body, elem, structs, str_fresh)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_arrtup_return(fo.body, elem, structs, str_fresh)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_arrtup_return(m.arms[a].body, elem, structs, str_fresh)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// fn_returns_fresh_arrtup: `fn` is a free function whose declared return is a
// deep-droppable `(<tuple-with-array>)[]` and whose every return hands back a
// fresh array literal of fresh tuple literals — so the caller's binding sole-owns
// the buffer, every element tuple box and the arrays inside them. Registered
// "ARRTUPF:<name>" so a call-bound local earns the ARRTUP credit.
function fn_returns_fresh_arrtup(fn: parser.FuncDecl, structs: parser.StructDecl[], str_fresh: string[]): boolean {
    if (fn.receiver_type.len() > 0) { return false; }
    var elem: string = arrtup_elem_tuple_type(fn.ret_type, structs);
    if (elem == "") { return false; }
    if (!body_has_return(fn.body)) { return false; }
    return !body_has_nonfresh_arrtup_return(fn.body, elem, structs, str_fresh);
}

// collect_fresh_arrtup_names: LOCAL names bound from a fresh `(<tuple-with-array>)[]`
// literal (arrtup_ann_is + arrtup_lit_is_fresh), or from a call to an "ARRTUPF:"
// producer, anywhere in the body. Escape gates applied by reclaimable_names_of.
function collect_fresh_arrtup_names(stmts: ast.Stmt[], body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], str_fresh: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (arrtup_ann_is(v.type_name, structs) && arrtup_lit_is_fresh(v.init, arrtup_elem_tuple_type(v.type_name, structs), structs, str_fresh)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                // A producer CALL: the annotation supplies the element type the
                // deep free walks, and the "ARRTUPF:" registry proves every
                // returned buffer, element box and inner array is the callee's
                // own. The callee's returned local escapes by return and so keeps
                // its shallow dec — the elements are freed exactly once, here.
                else if (arrtup_ann_is(v.type_name, structs)) {
                    match (v.init) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprIdent(cid) => {
                                    if (util.index_of_str(fresh_ret, "ARRTUPF:" + cid.name) >= 0
                                            && !body_declares_name(body, cid.name)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_arrtup_names(f.then_body, body, structs, fresh_ret, str_fresh, a); a = collect_fresh_arrtup_names(f.else_body, body, structs, fresh_ret, str_fresh, a); },
            ast.StmtWhile(w) => { a = collect_fresh_arrtup_names(w.body, body, structs, fresh_ret, str_fresh, a); },
            ast.StmtFor(fo) => { a = collect_fresh_arrtup_names(fo.body, body, structs, fresh_ret, str_fresh, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_arrtup_names(arm.body, body, structs, fresh_ret, str_fresh, a); }
            },
            _ => {}
        }
    }
    return a;
}

// arrtup_elem_type_of_decl: find the element tuple type of the `(<tuple>)[]` local
// `name` from its declaration anywhere in the body (for the escape checker). "" if
// not an arrtup declaration.
function arrtup_elem_type_of_decl(stmts: ast.Stmt[], structs: parser.StructDecl[], name: string): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name && arrtup_ann_is(v.type_name, structs)) { return arrtup_elem_tuple_type(v.type_name, structs); } },
            ast.StmtIf(f) => {
                var t1: string = arrtup_elem_type_of_decl(f.then_body, structs, name);
                if (t1 != "") { return t1; }
                var t2: string = arrtup_elem_type_of_decl(f.else_body, structs, name);
                if (t2 != "") { return t2; }
            },
            ast.StmtWhile(w) => { var t: string = arrtup_elem_type_of_decl(w.body, structs, name); if (t != "") { return t; } },
            ast.StmtFor(fo) => { var t: string = arrtup_elem_type_of_decl(fo.body, structs, name); if (t != "") { return t; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { var t: string = arrtup_elem_type_of_decl(arm.body, structs, name); if (t != "") { return t; } }
            },
            _ => {}
        }
    }
    return "";
}

// esc_elem_field_of: `e` is a field read off an indexed element of the bare
// local `root` (`root[i].<f>`) — returns `<f>`; "" otherwise. The element
// index is not inspected here; a code-3 chain re-scan picks it up.
function esc_elem_field_of(e: ast.Expr, root: string): string {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIndex(ix) => {
                    if (ident_name_or_empty(ix.array) == root) { return fa.field; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// arrtup_elem_esc_shape classifies one node for the array-of-tuples element
// escape scan (arrtup_elem_esc_expr below has the scan's contract); codes as
// rctuple_esc_shape's.
function arrtup_elem_esc_shape(e: ast.Expr, name: string, ttype: string, structs: parser.StructDecl[]): i32 {
    match (e) {
        ast.ExprIdent(id) => { if (id.name == name) { return 2; } return 1; },   // bare array escapes
        ast.ExprNumber(_) => { return 1; },
        ast.ExprString(_) => { return 1; },
        ast.ExprBool(_) => { return 1; },
        ast.ExprFieldAccess(fa) => {
            var ef: string = esc_elem_field_of(e, name);
            if (ef.len() > 0 && util.is_all_digits(ef)) {
                // name[i].N : a bare array/nested/struct element extract escapes; a
                // scalar element is a value copy with only the index left to check.
                if (is_scalar_type_name(tuple_type_elem_tag(ttype, util.digits_to_i32(ef)))) { return 3; }
                return 2;
            }
            var pf: string = esc_elem_field_of(fa.obj, name);
            if (pf.len() > 0 && util.is_all_digits(pf)) {
                // `name[i].N.field`: struct-field read of a struct tuple element. A SCALAR
                // field is a borrow (safe, check the index); a struct ARRAY/pointer field
                // extracted bare escapes (its buffer the reclaim would free). #4365.
                var stag: string = tuple_type_elem_tag(ttype, util.digits_to_i32(pf));
                if (decl_is_struct(structs, stag)) {
                    if (is_scalar_type_name(decl_field_type(structs, stag, fa.field))) { return 3; }
                    return 2;
                }
            }
            return 0;
        },
        ast.ExprIndex(ix) => {
            if (ident_name_or_empty(ix.array) == name) { return 2; }   // bare name[i] tuple box
            var bf: string = esc_elem_field_of(ix.array, name);
            if (bf.len() > 0 && util.is_all_digits(bf)) { return 3; }   // name[i].N[j] : indexed array-field read
            match (ix.array) {
                ast.ExprFieldAccess(bfa) => {
                    var pbf: string = esc_elem_field_of(bfa.obj, name);
                    if (pbf.len() > 0 && util.is_all_digits(pbf)) { return 3; }   // name[i].N.field[j] : indexed struct array-field read
                    return 0;
                },
                _ => { return 0; }
            }
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(_) => { return 4; },
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        // `name.len()` on the ARRAY ITSELF — the tuple sibling of the
                        // arrstruct case: a header read, no element touched, so it is a
                        // borrow. Without it any `.len()` on the local recursed into the
                        // callee, hit the bare-ident arm and refused the whole credit. #6127.
                        if (ident_name_or_empty(cfa.obj) == name) { return 3; }
                        var rf: string = esc_elem_field_of(cfa.obj, name);
                        if (rf.len() > 0 && util.is_all_digits(rf)) { return 3; }   // name[i].N.len() : array tuple-element length borrow
                        match (cfa.obj) {
                            ast.ExprFieldAccess(pfa) => {
                                var prf: string = esc_elem_field_of(pfa.obj, name);
                                if (prf.len() > 0 && util.is_all_digits(prf)) { return 3; }   // name[i].N.field.len() : struct array-field length borrow
                            },
                            _ => {}
                        }
                    }
                    return 0;
                },
                _ => { return 0; }
            }
        },
        ast.ExprBinary(_) => { return 0; },
        ast.ExprUnary(_) => { return 0; },
        ast.ExprSlice(_) => { return 0; },
        ast.ExprArray(_) => { return 0; },
        ast.ExprTuple(_) => { return 0; },
        ast.ExprStructLit(_) => { return 0; },
        ast.ExprLambda(_) => { return 1; },
        ast.ExprMapLit(_) => { return 1; },
        ast.ExprFString(_) => { return 1; },
        ast.ExprUnknown(_) => { return 1; }
    }
    return 0;
}

// arrtup_chain_esc: rctuple_chain_esc's array-of-tuples sibling — re-scans a
// code-3 chain's index expressions and call arguments.
function arrtup_chain_esc(x: ast.Expr, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    match (x) {
        ast.ExprCall(c) => {
            if (arrtup_chain_esc(c.callee, name, ttype, structs, borrowable)) { return true; }
            for arg in c.args { if (arrtup_elem_esc_expr(arg, name, ttype, structs, borrowable)) { return true; } }
            return false;
        },
        ast.ExprFieldAccess(fa) => { return arrtup_chain_esc(fa.obj, name, ttype, structs, borrowable); },
        ast.ExprIndex(ix) => {
            if (arrtup_chain_esc(ix.array, name, ttype, structs, borrowable)) { return true; }
            return arrtup_elem_esc_expr(ix.index, name, ttype, structs, borrowable);
        },
        ast.ExprIdent(_) => { return false; },
        _ => { return true; }
    }
    return false;
}

// arrtup_elem_esc_at is the fold visitor: `esc` latches true, and each node
// answers per its arrtup_elem_esc_shape code.
function arrtup_elem_esc_at(x: ast.Expr, esc: boolean, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    if (esc) { return true; }
    var code: i32 = arrtup_elem_esc_shape(x, name, ttype, structs);
    if (code == 2) { return true; }
    if (code == 3) { return arrtup_chain_esc(x, name, ttype, structs, borrowable); }
    if (code == 4) {
        // A bare-ident ARGUMENT is a borrow at a param proven to touch no
        // element of it ("ELB:") or to keep it only COUNTED ("CNT:") — the
        // arrstruct twin's rule; the box-only flag is not enough for a release
        // that walks the elements. Any other argument position escapes.
        match (x) {
            ast.ExprCall(c) => {
                var callee: string = ident_name_or_empty(c.callee);
                if (callee == name) { return true; }
                var eai: i32 = 0;
                while (eai < c.args.len()) {
                    if (ident_name_or_empty(c.args[eai]) == name) {
                        if (!(param_is_borrowable(borrowable, "ELB:" + callee, eai)
                              || param_is_borrowable(borrowable, "CNT:" + callee, eai))) { return true; }
                    } else if (arrtup_elem_esc_expr(c.args[eai], name, ttype, structs, borrowable)) { return true; }
                    eai = eai + 1;
                }
                return false;
            },
            _ => { return true; }
        }
    }
    return false;
}

// arrtup_elem_esc_expr: does `e` use the array-of-tuples local `name` (element tuple
// type `ttype`) in a way that ESCAPES an owned pointer the whole-structure reclaim
// would free? The leaf is an ELEMENT field access `name[i].N`: a scalar field is a
// safe value copy; an ARRAY / nested-tuple field extracted bare escapes. `name[i].N[j]`
// (indexed array-field read) and `name[i].N.len()` are borrows; a BARE `name[i]`
// element (the tuple box) or a bare `name` escapes. Erring toward escape is a safe
// leak, never an over-release.
function arrtup_elem_esc_expr(e: ast.Expr, name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    function visit(x: ast.Expr, esc: boolean): boolean { return arrtup_elem_esc_at(x, esc, name, ttype, structs, borrowable); }
    function descend(x: ast.Expr): boolean { return arrtup_elem_esc_shape(x, name, ttype, structs) == 0; }
    return astwalk.fold_expr_pruned(e, false, visit, descend);
}

// arrtup_elem_payload_escapes: any statement in the body uses `name` (element tuple
// type `ttype`) in an escaping way per the scan above. A struct tuple-element
// SCALAR-field read / indexed array-field read / .len() is a borrow (reclaim proceeds);
// a whole struct element or a bare struct array-field extraction escapes. #4365.
function arrtup_elem_payload_escapes(stmts: ast.Stmt[], name: string, ttype: string, structs: parser.StructDecl[], borrowable: string[]): boolean {
    function visit(x: ast.Expr, esc: boolean): boolean { return arrtup_elem_esc_at(x, esc, name, ttype, structs, borrowable); }
    function descend(x: ast.Expr): boolean { return arrtup_elem_esc_shape(x, name, ttype, structs) == 0; }
    for stmt in stmts {
        if (astwalk.fold_stmt_pruned(stmt, false, visit, descend)) { return true; }
    }
    return false;
}

// slot_is_reclaimable_arrtup: slot i holds a fresh, non-escaping
// `(<tuple-with-array>)[]` local, credited "ARRTUP:" by reclaimable_names_of. The
// slot stays plain is_arr (elements are tuple boxes, not arrays, so NOT is_arrarr);
// its arrarr_elem carries the element TUPLE TYPE (stored at binding) that drives the
// per-element deep-drop.
function slot_is_reclaimable_arrtup(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_arr) { return false; }
    if (s.locals[i].is_arrarr || s.locals[i].is_strarr) { return false; }
    var et: string = s.locals[i].arrarr_elem;
    if (et.len() < 2 || slice_unchecked(et, 0, 1) != "(") { return false; }
    return slot_credit_at(s, i, "ARRTUP:");
}

// emit_arrtup_deep_free frees the array-of-tuples buffer in `slot`: null-guarded, a
// counted loop walks each element (a tuple box ptr), TYPE-drives its deep-drop
// (emit_tuple_type_child_drops on `ttype`: dec each array field, recurse nested
// tuples) then frees the tuple box, and finally decs the outer buffer. Consumes no
// operand; leaves the slot dangling (callers store new / zero it). Admission proves
// every element tuple + its arrays fresh, so each buffer is sole-owned.
function emit_arrtup_deep_free(se: LowerState, slot: i32, ttype: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // arr != 0 (null guard)
    st = st.emit(ir.op_if(0));
    var idxn: string = "$atupi" + util.i32_to_string(st.locals.len());
    st = st.add_local(idxn);
    var idxslot: i32 = st.slot_of(idxn);
    var eln: string = "$atupe" + util.i32_to_string(st.locals.len());
    st = st.add_local(eln);
    var elslot: i32 = st.slot_of(eln);
    st = st.emit(ir.op_const_i32(0 - 1));            // index starts at -1 (advance-at-top)
    st = st.emit(ir.op_store_local(idxslot));
    st = st.emit(ir.op_block(0)).enter_loop();
    st = st.emit(ir.op_loop(0));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_const_i32(1));
    st = st.emit(ir.op_bin("add", 0, false));
    st = st.emit(ir.op_store_local(idxslot));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_arr_len());
    st = st.emit(ir.op_bin("lt_s", 0, false));
    st = st.emit(ir.op_bin("not", 0, false));
    st = st.emit(ir.op_brif(1));                     // exit when idx >= len
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_arr_get(32));                 // elem = arr[idx] (tuple box ptr)
    st = st.emit(ir.op_store_local(elslot));
    var etp: i32[] = [];
    st = emit_tuple_type_child_drops(st, elslot, etp, ttype);   // free array/nested children
    st = st.emit(ir.op_load_local(elslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));        // free the tuple box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_br(0));                       // back-edge
    st = st.emit(ir.op_end());                       // end loop
    st = st.emit(ir.op_end()).exit_loop();           // end block
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));        // free the outer buffer box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_arrtup_reclaim_store: the loop-rebind. Stash `new` (on stack), deep-free the
// OLD array-of-tuples (emit_arrtup_deep_free), then store new. A fresh literal init
// makes old != new implicit, so the null guard inside deep_free suffices.
function emit_arrtup_reclaim_store(se: LowerState, slot: i32, ttype: string): LowerState {
    var scratch: string = "$atr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = emit_arrtup_deep_free(st, slot, ttype);     // free old structure
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// ── ARRSTRUCT: reclaim `(<struct-with-array-field>)[]` array-of-structs locals (#4365) ──
// The struct sibling of ARRTUP: an array whose elements are struct boxes each carrying
// an rc-array field. The element struct type is already recorded on the (is_arr) slot
// as struct_type (the array-of-structs binding sets struct_ty = <elem>[]-stripped), so
// no extra marking is needed. Release reuses the ARRTUP counted element-walk but drops
// each element via the struct-field deep-drop (__struct_drop_<T>, backend-complete)
// instead of the tuple deep-drop.

// arrstruct_elem_struct_type: for an array type `T[]` whose element T is a struct decl
// that routes field-reclaim (has an rc-array / nested-struct / enum field), return T,
// else "". `structs` is the decl table.
function arrstruct_elem_struct_type(type_name: string, structs: parser.StructDecl[]): string {
    var n: i32 = type_name.len();
    if (n < 3) { return ""; }
    if (slice_unchecked(type_name, n - 2, n) != "[]") { return ""; }
    var elem: str = slice_unchecked(type_name, 0, n - 2);
    if (!decl_is_struct(structs, elem)) { return ""; }
    if (!struct_has_reclaim_array_field(structs, elem)) { return ""; }
    return elem + "";
}

// structarr_elem_struct_type: the element struct of a SCALAR-FIELD struct array,
// the DISJOINT sibling of the above — arrstruct owns the rc-array-field structs,
// this class the rest. `dyn T[]` answers "" through decl_is_struct, which is what
// keeps the dyn sweep's slots out.
function structarr_elem_struct_type(type_name: string, structs: parser.StructDecl[]): string {
    var n: i32 = type_name.len();
    if (n < 3) { return ""; }
    if (slice_unchecked(type_name, n - 2, n) != "[]") { return ""; }
    var elem: str = slice_unchecked(type_name, 0, n - 2);
    if (!decl_is_struct(structs, elem)) { return ""; }
    if (struct_has_reclaim_array_field(structs, elem)) { return ""; }
    return elem + "";
}

// arrstruct_lit_is_fresh: `e` is a non-empty array literal whose EVERY element the
// array may own — a fresh struct literal (is_fresh_struct_init), or, when
// `bare_ok`, a bare IDENT. The literal RETAINS a bare ident exactly as the
// self-append does, so the element is a counted share and both owners run their
// field walk under __fern_rc_is_unique; the sites that retain are the ones
// arrstruct_owned_elem_sites stamps.
//
// `bare_ok` is false for the ARRSTRUCTF producer registry, whose question is the
// stricter one: a RETURNED literal's counted co-owner is a local of the frame
// being left, so "every element box is the callee's own" needs the fresh-literal
// evidence rather than a count.
function arrstruct_lit_is_fresh(e: ast.Expr, structs: parser.StructDecl[], bare_ok: boolean): boolean {
    match (e) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < arr.elements.len()) {
                if (!is_fresh_struct_init(arr.elements[i], structs)) {
                    if (!bare_ok) { return false; }
                    match (arr.elements[i]) {
                        ast.ExprIdent(_) => {},
                        _ => { return false; }
                    }
                }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// arrstruct_self_store_elem / arrstruct_name_is_appended / arrstruct_unsafe_for:
// the append-built half of this class (#6535), transcribed from the shallow
// STRUCTARR siblings #6127 introduced. The literal-built credit refused any
// REASSIGNED name, and `vals = vals.append(Val { .. })` is a reassignment — so
// an append-built array-of-structs earned no credit at all and leaked its whole
// structure per round, where the literal-built form of the identical value was
// flat. Measured 35200 bytes over 100 rounds on a 4-element `Val { kind: i32,
// kids: i32[] }[]`, doubling with the round count, against 0 for the literal.
//
// Two element shapes qualify. A fresh struct LITERAL is the rule
// arrstruct_lit_is_fresh applies per element — the box is sole-owned exactly as
// in the literal-built form the deep walk already frees. A BARE IDENT qualifies
// because the append RETAINS it: the container holds a counted reference, and
// the element walk deep-drops the fields only under __fern_rc_is_unique, so a
// source that outlives the push keeps its own claim and its own field walk.
// The retain is gated on this very credit (slot_is_reclaimable_arrstruct at the
// append), which is what keeps the inc and the dec the same set.

// moved_ident_at: `e` is a bare ident the move analysis recorded at this source
// position. Keyed on line:col, not the name, so a local that is moved at one store
// and merely read at another admits only the store that moved it.
//
// The question is not specific to any container: wherever a store would take over
// a local's only reference, this is what says the store may.
function moved_ident_at(e: ast.Expr, msites: string[]): boolean {
    match (e) {
        ast.ExprIdent(id) => {
            return util.index_of_str(msites, util.i32_to_string(id.line) + ":" + util.i32_to_string(id.col)) >= 0;
        },
        _ => {}
    }
    return false;
}
// arrstruct_self_store_elem_index: the ARGUMENT index of the element in a
// self-store `name = name.append(x)` (0) or `name = name.with(i, x)` (1), or -1
// when `e` is neither. One reader for both shapes, so the credit gate, the stamping
// pass and the lowering cannot disagree about which operand is the element.
function arrstruct_self_store_elem_index(e: ast.Expr, name: string): i32 {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    var self_recv: boolean = false;
                    match (fa.obj) {
                        ast.ExprIdent(rid) => { self_recv = rid.name == name; },
                        _ => {}
                    }
                    if (!self_recv) { return 0 - 1; }
                    if (fa.field == "append" && c.args.len() == 1) { return 0; }
                    if (fa.field == "with" && c.args.len() == 2) { return 1; }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return 0 - 1;
}

// arrstruct_self_store_elem: `e` is a sanctioned self-store rebind of the credited
// container `name`, whose element is one the container may own.
//
// `with` joins `append` here because both store an element the container's walk
// then releases. It differs in one way that costs a release rather than a credit:
// `with` REPLACES, so the superseded element has to be freed at the store
// (emit_arrstruct_with_store) — `append` displaces nothing.
function arrstruct_self_store_elem(e: ast.Expr, name: string, structs: parser.StructDecl[], msites: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var eidx: i32 = arrstruct_self_store_elem_index(e, name);
            if (eidx < 0) { return false; }
            if (moved_ident_at(c.args[eidx], msites)) { return true; }
            // ANY bare ident. The credit no longer needs the element to be dead
            // after the push, because the append RETAINS it and both owners run
            // their field walk under __fern_rc_is_unique: whichever reaches rc 1
            // does the deep work, the other takes the box dec. Requiring a MOVE
            // cost the CONTAINER its element walk on every shape where the source
            // outlives the push — `ps = ps.append(p); p = P { … }` reads as
            // neither a move nor a literal, and the whole array then leaked.
            match (c.args[eidx]) {
                ast.ExprIdent(_) => { return true; },
                _ => {}
            }
            return is_fresh_struct_init(c.args[eidx], structs);
        },
        _ => { return false; }
    }
    return false;
}
// arrstruct_owned_elem_sites: the "line:col" keys of every bare-ident element the
// credited container `name` takes ownership of — a self-append argument, or an
// element of the LITERAL `name` is bound from. The container's element walk decs
// each element once and deep-drops its fields under __fern_rc_is_unique, so what
// a stamp says is "this element is the array's to release".
//
// It deliberately does NOT ask about moves. The site says who owns the element;
// whether the store RETAINS or TRANSFERS is the move analysis's answer, read at
// the lowering site, which has it. Encoding both here left the two questions
// entangled: a source appended once and then rebound was refused the credit at
// its second, MOVED push, so its first — retained — box was never released
// (`ps.append(p); p = P { … }; ps.append(p)`, 600/400 against native's 600/600).
//
// Computed HERE, beside the credit it belongs to, and read by site key: the walk
// and the inc then cannot disagree about which elements are shared. Deriving the
// inc from the ELEMENT's own credit instead was the bug this replaced — a source
// with no credit got no inc while the container still dec'd once per push, so a
// box appended four times was released four times.
function arrstruct_owned_elem_sites(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                // The literal `name` is bound from: `var ps: P[] = [p, q];`.
                if (v.name == name) { a = arrstruct_lit_elem_sites(v.init, a); }
            },
            ast.StmtAssign(as1) => {
                if (as1.target == name && arrstruct_self_store_elem(as1.value, name, structs, msites)) {
                    match (as1.value) {
                        ast.ExprCall(c) => {
                            match (c.args[arrstruct_self_store_elem_index(as1.value, name)]) {
                                ast.ExprIdent(eid) => {
                                    a = push_str_unique(a, util.i32_to_string(eid.line) + ":" + util.i32_to_string(eid.col));
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                a = arrstruct_owned_elem_sites(f.then_body, name, structs, msites, a);
                a = arrstruct_owned_elem_sites(f.else_body, name, structs, msites, a);
            },
            ast.StmtWhile(w) => { a = arrstruct_owned_elem_sites(w.body, name, structs, msites, a); },
            ast.StmtFor(fo) => { a = arrstruct_owned_elem_sites(fo.body, name, structs, msites, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = arrstruct_owned_elem_sites(arm.body, name, structs, msites, a); }
            },
            _ => {}
        }
    }
    return a;
}

// arrstruct_lit_elem_sites: the bare-ident element sites of an array literal.
function arrstruct_lit_elem_sites(e: ast.Expr, acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprArray(arr) => {
            var i: i32 = 0;
            while (i < arr.elements.len()) {
                match (arr.elements[i]) {
                    ast.ExprIdent(eid) => { a = push_str_unique(a, util.i32_to_string(eid.line) + ":" + util.i32_to_string(eid.col)); },
                    _ => {}
                }
                i = i + 1;
            }
        },
        _ => {}
    }
    return a;
}
function arrstruct_name_is_appended(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => { if (a.target == name && arrstruct_self_store_elem(a.value, name, structs, msites)) { return true; } },
            ast.StmtIf(f) => {
                if (arrstruct_name_is_appended(f.then_body, name, structs, msites)) { return true; }
                if (arrstruct_name_is_appended(f.else_body, name, structs, msites)) { return true; }
            },
            ast.StmtWhile(w) => { if (arrstruct_name_is_appended(w.body, name, structs, msites)) { return true; } },
            ast.StmtFor(fo) => { if (arrstruct_name_is_appended(fo.body, name, structs, msites)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (arrstruct_name_is_appended(arm.body, name, structs, msites)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}
// arrstruct_counted_field_share: `e` is a struct literal that mentions `name`
// ONLY as the bare-ident value of a field whose declared type takes the
// construction alias-inc — the ExprStructLit ident arm in lower_expr, which
// retains an array-of-struct field source unconditionally. The field therefore
// holds a COUNTED share, and reading it as an escape sank the source's whole
// reclaim: `var p: P = P { f: src, … }` left `src` with the generic buffer dec,
// freeing the outer array while every element box and element array field
// stranded. Measured 88 bytes per round on a one-element `Inner[]`, and only on
// the path where the share did NOT run — with the share live the holder's
// rc-gated field walk did the work and the census was flat.
//
// Both releases are rc-gated, which is what makes granting this safe rather than
// a double free: the holder's walk is __struct_arr_elems_drop_<E>, which
// is_unique-gates the buffer, and the source's is emit_arrstruct_deep_free,
// gated the same way. Whichever finds rc 1 walks; the other takes the buffer dec.
//
// A `{ ...base }` update is refused: the copied fields carry no inc, so the new
// box would co-own the buffer with no count behind it.
//
// A MOVED share is refused for the same reason, one step further on. The retain
// is move-gated (#6726): where the analysis says the construction moves the
// local, the box takes over its reference and BOTH the inc and the sweep dec
// that cancels it are dropped (note_moved_elided pairs them). This credit does
// not route that plain sweep dec — it routes emit_arrstruct_deep_free — so
// granting it at a moved site frees a buffer whose ownership left the frame. It
// is the shape `return T { f: src, … }` has, because the return is src's last
// use: measured as gen2 segfaulting under qemu on the arm64 stage-2 fixpoint,
// with every x86-64 gate, both matrices and all three x86-64 fixpoints green.
// The credit therefore asks exactly the question the retain asks.
function arrstruct_counted_field_share(e: ast.Expr, name: string, structs: parser.StructDecl[], msites: string[]): boolean {
    match (e) {
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { return false; }
            var seen: boolean = false;
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                match (sl.field_values[i]) {
                    ast.ExprIdent(fid) => {
                        if (fid.name == name) {
                            if (!is_struct_array_field_type(structs, decl_field_type(structs, sl.type_name, sl.field_names[i]))) { return false; }
                            if (moved_ident_at(sl.field_values[i], msites)) { return false; }
                            seen = true;
                        }
                    },
                    _ => { if (expr_unsafe_for(sl.field_values[i], name, [], [])) { return false; } }
                }
                i = i + 1;
            }
            return seen;
        },
        _ => { return false; }
    }
    return false;
}

// arrstruct_counted_share_holders: the locals bound from a struct literal that
// took a counted share of `name` (arrstruct_counted_field_share).
function arrstruct_counted_share_holders(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (arrstruct_counted_field_share(v.init, name, structs, msites)) { a = push_str_unique(a, v.name); } },
            ast.StmtAssign(asg) => { if (arrstruct_counted_field_share(asg.value, name, structs, msites)) { a = push_str_unique(a, asg.target); } },
            ast.StmtIf(f) => { a = arrstruct_counted_share_holders(f.then_body, name, structs, msites, a); a = arrstruct_counted_share_holders(f.else_body, name, structs, msites, a); },
            ast.StmtWhile(w) => { a = arrstruct_counted_share_holders(w.body, name, structs, msites, a); },
            ast.StmtFor(fo) => { a = arrstruct_counted_share_holders(fo.body, name, structs, msites, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = arrstruct_counted_share_holders(arm.body, name, structs, msites, a); }
            },
            _ => {}
        }
    }
    return a;
}

// arrstruct_share_holder_respread: a holder that took a counted share of `name`
// is itself used as a struct-literal BASE (`P { ...q, … }`). That copy carries
// the buffer pointer into a third box with NO inc — the design point
// expr_unsafe_for's ExprStructLit arm records — so the buffer has three owners
// at rc 2 and the first two sweeps to run free it between them.
//
// The share count being complete is the precondition of granting `name` its
// rc-gated walk at all, so this is a gate on the credit rather than a
// hazard the walk could guard against. Measured as exit 99 at a perfectly flat
// census: 600 allocs, 600 frees, live_bytes 0, and only __rc_underflow_count()
// dissenting.
function arrstruct_share_holder_respread(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[]): boolean {
    var holders: string[] = arrstruct_counted_share_holders(stmts, name, structs, msites, []);
    if (holders.len() == 0) { return false; }
    return body_spreads_any(stmts, structs, holders);
}

// spread_sites_of / expr_spread_sites: every `T { ...base, … }` in a body, recorded
// twice — "N:<base>" when the base is a bare ident, and one "FT:<type>" per field
// `T` declares. A base spread copies each field pointer into a fresh box with NO
// inc, so it mints an uncounted co-owner, and every counted-share credit has to
// refuse in its presence. The two rows answer the two shapes of that question:
//
//   - by NAME, for a credit that knows which locals hold the share
//     (arrstruct/arrenum_share_holder_respread).
//   - by FIELD TYPE, for one that does not — enum_arr_field_share_read decides
//     mid-expression, when the dangerous spread may name a local with no slot yet
//     (`var p: P = P { f: q.f }; var z: P = P { ...p }`).
function spread_sites_of(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { a = expr_spread_sites(v.init, structs, a); },
            ast.StmtAssign(asg) => { a = expr_spread_sites(asg.value, structs, a); },
            ast.StmtReturn(r) => { a = expr_spread_sites(r.value, structs, a); },
            ast.StmtExpr(e) => { a = expr_spread_sites(e.value, structs, a); },
            ast.StmtIf(f) => {
                a = expr_spread_sites(f.cond, structs, a);
                a = spread_sites_of(f.then_body, structs, a);
                a = spread_sites_of(f.else_body, structs, a);
            },
            ast.StmtWhile(w) => {
                a = expr_spread_sites(w.cond, structs, a);
                a = spread_sites_of(w.body, structs, a);
            },
            ast.StmtFor(fo) => {
                a = expr_spread_sites(fo.iter, structs, a);
                a = spread_sites_of(fo.body, structs, a);
            },
            ast.StmtMatch(m) => {
                a = expr_spread_sites(m.scrutinee, structs, a);
                for arm in m.arms { a = spread_sites_of(arm.body, structs, a); }
            },
            ast.StmtDefer(d) => { a = spread_sites_of([d.action], structs, a); },
            _ => {}
        }
    }
    return a;
}
function expr_spread_sites(e: ast.Expr, structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    match (e) {
        ast.ExprStructLit(sl) => {
            if (sl.has_base) {
                for sd in structs {
                    if (sd.name == sl.type_name) {
                        for fld in sd.fields { a = push_str_unique(a, "FT:" + fld.type_name); }
                    }
                }
                match (sl.base) {
                    ast.ExprIdent(bid) => { a = push_str_unique(a, "N:" + bid.name); },
                    _ => { a = expr_spread_sites(sl.base, structs, a); }
                }
            }
            for fv in sl.field_values { a = expr_spread_sites(fv, structs, a); }
        },
        ast.ExprCall(c) => {
            a = expr_spread_sites(c.callee, structs, a);
            for ar in c.args { a = expr_spread_sites(ar, structs, a); }
        },
        ast.ExprArray(arr) => { for el in arr.elements { a = expr_spread_sites(el, structs, a); } },
        ast.ExprTuple(tp) => { for el in tp.elements { a = expr_spread_sites(el, structs, a); } },
        ast.ExprMapLit(ml) => {
            for k in ml.keys { a = expr_spread_sites(k, structs, a); }
            for mv in ml.vals { a = expr_spread_sites(mv, structs, a); }
        },
        ast.ExprFString(fs) => { for fe in fs.exprs { a = expr_spread_sites(fe, structs, a); } },
        ast.ExprBinary(b) => {
            a = expr_spread_sites(b.left, structs, a);
            a = expr_spread_sites(b.right, structs, a);
        },
        ast.ExprUnary(u) => { a = expr_spread_sites(u.operand, structs, a); },
        ast.ExprIndex(ix) => {
            a = expr_spread_sites(ix.array, structs, a);
            a = expr_spread_sites(ix.index, structs, a);
        },
        ast.ExprSlice(sx) => {
            a = expr_spread_sites(sx.array, structs, a);
            a = expr_spread_sites(sx.start, structs, a);
            a = expr_spread_sites(sx.end, structs, a);
        },
        ast.ExprFieldAccess(fa) => { a = expr_spread_sites(fa.obj, structs, a); },
        ast.ExprLambda(lm) => { a = spread_sites_of(lm.body, structs, a); },
        _ => {}
    }
    return a;
}

// body_spreads_any: any struct literal in the body whose functional-update base
// is a bare ident naming one of `names`.
function body_spreads_any(stmts: ast.Stmt[], structs: parser.StructDecl[], names: string[]): boolean {
    var sites: string[] = spread_sites_of(stmts, structs, []);
    for n in names { if (util.index_of_str(sites, "N:" + n) >= 0) { return true; } }
    return false;
}

// body_unsafe_for with exactly one sanctioned reassignment — the self-append
// rebind, and one sanctioned escape — the counted struct-literal field share.
// Only the assign and var cases differ; everything else delegates, which is
// sound because this class's own element hazards (an element alias, an element
// field-payload extraction) are checked separately by arrarr_row_escapes and
// arrstruct_elem_payload_escapes, applied alongside this gate.
function arrstruct_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], structs: parser.StructDecl[], msites: string[]): boolean {
    for stmt in stmts { if (stmt_arrstruct_unsafe_for(stmt, name, borrowable, structs, msites)) { return true; } }
    return false;
}
function stmt_arrstruct_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], structs: parser.StructDecl[], msites: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => {
            if (arrstruct_counted_field_share(v.init, name, structs, msites)) { return false; }
            return expr_unsafe_for(v.init, name, borrowable, []);
        },
        ast.StmtReturn(r) => {
            if (arrstruct_counted_field_share(r.value, name, structs, msites)) { return false; }
            return expr_unsafe_for(r.value, name, borrowable, []);
        },
        ast.StmtExpr(e) => {
            if (arrstruct_counted_field_share(e.value, name, structs, msites)) { return false; }
            return expr_unsafe_for(e.value, name, borrowable, []);
        },
        ast.StmtAssign(a) => {
            if (a.target == name) {
                if (arrstruct_self_store_elem(a.value, name, structs, msites)) { return false; }
                return true;   // any other reassignment of the candidate
            }
            if (arrstruct_counted_field_share(a.value, name, structs, msites)) { return false; }
            return expr_unsafe_for(a.value, name, borrowable, []);
        },
        ast.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable, [])) { return true; }
            return arrstruct_unsafe_for(f.then_body, name, borrowable, structs, msites) || arrstruct_unsafe_for(f.else_body, name, borrowable, structs, msites);
        },
        ast.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable, [])) { return true; }
            return arrstruct_unsafe_for(w.body, name, borrowable, structs, msites);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, []); }
            }
            if (iter_unsafe) { return true; }
            return arrstruct_unsafe_for(fo.body, name, borrowable, structs, msites);
        },
        ast.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable, [])) { return true; }
            for arm in m.arms {
                if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) { return true; }
                if (arrstruct_unsafe_for(arm.body, name, borrowable, structs, msites)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return stmt_arrstruct_unsafe_for(d.action, name, borrowable, structs, msites); },
        _ => { return stmt_unsafe_for(st, name, borrowable, []); }
    }
    return false;
}

// body_has_nonfresh_arrstruct_return: any return whose value is NOT a fresh
// array-of-structs the callee owns outright — a fresh literal, or a local this
// body built by self-append (arrstruct_producer_ret_local). `fnbody` stays the
// whole function body so a return nested in a block can still find that local's
// declaration and its rebinds.
function body_has_nonfresh_arrstruct_return(stmts: ast.Stmt[], fnbody: ast.Stmt[], structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtReturn(r) => {
                if (!arrstruct_lit_is_fresh(r.value, structs, false)) {
                    match (r.value) {
                        ast.ExprIdent(rid) => { if (!arrstruct_producer_ret_local(fnbody, rid.name, structs)) { return true; } },
                        _ => { return true; }
                    }
                }
            },
            ast.StmtIf(f) => { if (body_has_nonfresh_arrstruct_return(f.then_body, fnbody, structs) || body_has_nonfresh_arrstruct_return(f.else_body, fnbody, structs)) { return true; } },
            ast.StmtWhile(w) => { if (body_has_nonfresh_arrstruct_return(w.body, fnbody, structs)) { return true; } },
            ast.StmtFor(fo) => { if (body_has_nonfresh_arrstruct_return(fo.body, fnbody, structs)) { return true; } },
            ast.StmtMatch(m) => { var a: i32 = 0; while (a < m.arms.len()) { if (body_has_nonfresh_arrstruct_return(m.arms[a].body, fnbody, structs)) { return true; } a = a + 1; } },
            _ => {}
        }
    }
    return false;
}

// arrstruct_producer_ret_local: `name` is a local this body builds by self-append
// and hands back — `var vals: Val[] = []; vals = vals.append(Val { .. }); return vals;`,
// the shape the literal-only rule above refused even though the local-credit arm
// (ARRSTRUCTA:) already trusts it inside a single frame. A producer written this
// way registered nothing, so every consumer of it — `var g: Val[] = mk(..)` —
// took the shallow buffer dec and stranded each element box and its array fields.
//
// Strictness matches the registry's question, not the local credit's: every
// appended element must be a fresh struct LITERAL. A bare ident would leave the
// container's counted co-owner in the frame being left, which is the same reason
// arrstruct_lit_is_fresh takes bare_ok=false here.
function arrstruct_producer_ret_local(fnbody: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    if (!arrstruct_local_fresh_init(fnbody, name, structs)) { return false; }
    if (arrstruct_local_foreign_rebind(fnbody, name, structs)) { return false; }
    return !body_unsafe_for_allow_ret(fnbody, name, [], []);
}

// arrstruct_local_fresh_init: `name` is declared IN this body with an array
// literal every element of which is a fresh struct literal. `[]` qualifies
// vacuously — that is what an append-built producer starts from. Requiring the
// declaration to be here is what keeps the soleness proof local: a param, or a
// name from an enclosing scope, is already owned by someone else.
function arrstruct_local_fresh_init(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprArray(lit) => {
                            var j: i32 = 0;
                            while (j < lit.elements.len()) {
                                if (!is_fresh_struct_init(lit.elements[j], structs)) { return false; }
                                j = j + 1;
                            }
                            return true;
                        },
                        _ => { return false; }
                    }
                }
            },
            ast.StmtIf(f) => {
                if (arrstruct_local_fresh_init(f.then_body, name, structs)) { return true; }
                if (arrstruct_local_fresh_init(f.else_body, name, structs)) { return true; }
            },
            ast.StmtWhile(w) => { if (arrstruct_local_fresh_init(w.body, name, structs)) { return true; } },
            ast.StmtFor(fo) => { if (arrstruct_local_fresh_init(fo.body, name, structs)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (arrstruct_local_fresh_init(arm.body, name, structs)) { return true; } }
            },
            _ => {}
        }
    }
    return false;
}

// arrstruct_local_foreign_rebind: any reassignment of `name` that is NOT
// `name.append(<fresh struct literal>)` / `name.with(i, <fresh struct literal>)`.
// The store INDEX comes from arrstruct_self_store_elem_index so the two spellings
// stay one question; the element rule is the strict one above.
function arrstruct_local_foreign_rebind(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => {
                if (a.target == name && !arrstruct_fresh_store_elem(a.value, name, structs)) { return true; }
            },
            ast.StmtIf(f) => {
                if (arrstruct_local_foreign_rebind(f.then_body, name, structs)) { return true; }
                if (arrstruct_local_foreign_rebind(f.else_body, name, structs)) { return true; }
            },
            ast.StmtWhile(w) => { if (arrstruct_local_foreign_rebind(w.body, name, structs)) { return true; } },
            ast.StmtFor(fo) => { if (arrstruct_local_foreign_rebind(fo.body, name, structs)) { return true; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { if (arrstruct_local_foreign_rebind(arm.body, name, structs)) { return true; } }
            },
            ast.StmtDefer(d) => { return arrstruct_local_foreign_rebind([d.action], name, structs); },
            _ => {}
        }
    }
    return false;
}

// arrstruct_fresh_store_elem: the strict half of arrstruct_self_store_elem — the
// self-store spellings it recognises, with a fresh struct LITERAL element only.
function arrstruct_fresh_store_elem(e: ast.Expr, name: string, structs: parser.StructDecl[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            var eidx: i32 = arrstruct_self_store_elem_index(e, name);
            if (eidx < 0) { return false; }
            return is_fresh_struct_init(c.args[eidx], structs);
        },
        _ => { return false; }
    }
    return false;
}

// struct_arr_call_producer: `e` is a direct call to a producer registered under
// `tag` ("ARRSTRUCTF:" for the deep class, "STRUCTARRF:" for the scalar-field
// one) that the body does not shadow with a local of the same name.
function struct_arr_call_producer(e: ast.Expr, body: ast.Stmt[], fresh_ret: string[], tag: string): boolean {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    return util.index_of_str(fresh_ret, tag + cid.name) >= 0
                        && !body_declares_name(body, cid.name);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// fn_returns_fresh_arrstruct: the array-of-structs sibling of
// fn_returns_fresh_arrtup, registered "ARRSTRUCTF:<name>".
function fn_returns_fresh_arrstruct(fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    if (fn.receiver_type.len() > 0) { return false; }
    if (arrstruct_elem_struct_type(fn.ret_type, structs) == "") { return false; }
    if (!body_has_return(fn.body)) { return false; }
    return !body_has_nonfresh_arrstruct_return(fn.body, fn.body, structs);
}

// fn_returns_fresh_structarr: the SCALAR-FIELD sibling of the above, registered
// "STRUCTARRF:<name>" (#7445). The body proof is the SAME — every return either a
// fresh struct-literal array or a local built by self-append and handed back — and
// only the element-struct test differs, so the two registries are as disjoint as
// the credits they feed and a function is claimed by exactly one.
function fn_returns_fresh_structarr(fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    if (fn.receiver_type.len() > 0) { return false; }
    if (structarr_elem_struct_type(fn.ret_type, structs) == "") { return false; }
    if (!body_has_return(fn.body)) { return false; }
    return !body_has_nonfresh_arrstruct_return(fn.body, fn.body, structs);
}

// collect_fresh_arrstruct_names: LOCAL names bound from a fresh `(<struct-with-array>)[]`
// literal (arrstruct_elem_struct_type + arrstruct_lit_is_fresh) anywhere in the body,
// from an "ARRSTRUCTF:" producer call, or — #6535 — from an EMPTY literal the body
// then grows by self-append. Escape gates applied by reclaimable_names_of.
function collect_fresh_arrstruct_names(stmts: ast.Stmt[], body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], acc: string[], msites: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (arrstruct_elem_struct_type(v.type_name, structs) != "" && arrstruct_lit_is_fresh(v.init, structs, true)) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                // A producer CALL, the "ARRSTRUCTF:" sibling of the ARRTUP arm:
                // the annotation supplies the element struct type and the registry
                // proves every returned element box is the callee's own.
                else if (arrstruct_elem_struct_type(v.type_name, structs) != "" && struct_arr_call_producer(v.init, body, fresh_ret, "ARRSTRUCTF:")) { a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col)); }
                // APPEND-BUILT candidate (#6535): `var vals: Val[] = []` grown by
                // `vals = vals.append(Val { .. })`. arrstruct_lit_is_fresh rejects
                // `[]` (no elements to prove fresh), which left every append-built
                // array-of-structs uncredited. "A|" marks it append-BUILT so the
                // crediting loop can grant the separate ARRSTRUCTA: credit, the
                // same marker trick the STRUCTARR side uses.
                else if (arrstruct_elem_struct_type(v.type_name, structs) != ""
                    && arrarr_lit_is_empty(v.init)
                    && arrstruct_name_is_appended(stmts, v.name, structs, msites)) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col));
                    a = push_str_unique(a, "A|" + reclaim_site_key_of(v.name, v.line, v.col));
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_arrstruct_names(f.then_body, body, structs, fresh_ret, a, msites); a = collect_fresh_arrstruct_names(f.else_body, body, structs, fresh_ret, a, msites); },
            ast.StmtWhile(w) => { a = collect_fresh_arrstruct_names(w.body, body, structs, fresh_ret, a, msites); },
            ast.StmtFor(fo) => { a = collect_fresh_arrstruct_names(fo.body, body, structs, fresh_ret, a, msites); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_arrstruct_names(arm.body, body, structs, fresh_ret, a, msites); }
            },
            _ => {}
        }
    }
    return a;
}

// arrstruct_elem_type_of_decl: find the element struct type of the `T[]` local `name`
// from its declaration anywhere in the body (for the escape checker). "" if not an
// array-of-structs declaration.
function arrstruct_elem_type_of_decl(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[]): string {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (v.name == name) { var t: string = arrstruct_elem_struct_type(v.type_name, structs); if (t != "") { return t; } } },
            ast.StmtIf(f) => {
                var t1: string = arrstruct_elem_type_of_decl(f.then_body, name, structs);
                if (t1 != "") { return t1; }
                var t2: string = arrstruct_elem_type_of_decl(f.else_body, name, structs);
                if (t2 != "") { return t2; }
            },
            ast.StmtWhile(w) => { var t: string = arrstruct_elem_type_of_decl(w.body, name, structs); if (t != "") { return t; } },
            ast.StmtFor(fo) => { var t: string = arrstruct_elem_type_of_decl(fo.body, name, structs); if (t != "") { return t; } },
            ast.StmtMatch(m) => {
                for arm in m.arms { var t: string = arrstruct_elem_type_of_decl(arm.body, name, structs); if (t != "") { return t; } }
            },
            _ => {}
        }
    }
    return "";
}

// arrstruct_elem_esc_shape classifies one node for the array-of-structs
// element escape scan (arrstruct_elem_esc_expr below has the scan's contract);
// codes as rctuple_esc_shape's.
function arrstruct_elem_esc_shape(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[], msites: string[]): i32 {
    match (e) {
        ast.ExprIdent(id) => { if (id.name == name) { return 2; } return 1; },   // bare array escapes
        ast.ExprNumber(_) => { return 1; },
        ast.ExprString(_) => { return 1; },
        ast.ExprBool(_) => { return 1; },
        ast.ExprFieldAccess(fa) => {
            var ef: string = esc_elem_field_of(e, name);
            if (ef.len() > 0) {
                // name[i].f : a bare non-scalar field extract escapes; a scalar
                // (or unknown) field is a value copy with only the index to check.
                var ft: string = decl_field_type(structs, sty, ef);
                if (ft != "" && !is_scalar_type_name(ft)) { return 2; }
                return 3;
            }
            return 0;
        },
        ast.ExprIndex(ix) => {
            if (ident_name_or_empty(ix.array) == name) { return 2; }   // bare name[i] struct box
            var bf: string = esc_elem_field_of(ix.array, name);
            if (bf.len() > 0) { return 3; }   // name[i].f[j] : indexed array-field read — safe; check both indices
            return 0;
        },
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(_) => { return 4; },
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        // `name.len()` on the ARRAY ITSELF — a header read, no element
                        // touched, so it is a borrow exactly like the element-field
                        // `.len()`. Left generic it recurses into the callee and hits
                        // the bare-ident arm, so ANY `.len()` on the local refused the
                        // whole credit. Measured: the identical array leaked 8000 over
                        // 100 rounds with `ps.len()` and reclaimed cleanly with
                        // `ps[0].xs[0]` — reading LESS made it leak, and one `.len()`
                        // poisoned the credit even alongside an element read. #6127.
                        if (ident_name_or_empty(cfa.obj) == name) { return 3; }
                        var rf: string = esc_elem_field_of(cfa.obj, name);
                        if (rf.len() > 0) { return 3; }   // name[i].f.len() : the whitelisted borrow method
                    }
                    // `name.append(<elem>)` / `name.with(i, <elem>)` — the sanctioned
                    // self-store rebind (#6535). The receiver is READ to copy the
                    // buffer, and the element stored is one the container may own per
                    // arrstruct_self_store_elem, so nothing here binds an element
                    // pointer or extracts a field payload. The shape is checked, not
                    // assumed: a non-store method or an unsanctioned element falls to
                    // the generic tail and still escapes through the bare receiver.
                    if (ident_name_or_empty(cfa.obj) == name
                        && arrstruct_self_store_elem(e, name, structs, msites)) { return 5; }
                    return 0;
                },
                _ => { return 0; }
            }
        },
        ast.ExprBinary(_) => { return 0; },
        ast.ExprUnary(_) => { return 0; },
        ast.ExprSlice(_) => { return 0; },
        ast.ExprArray(_) => { return 0; },
        ast.ExprTuple(_) => { return 0; },
        ast.ExprStructLit(_) => {
            // The counted field share is not an element-payload escape either:
            // the field holds a counted reference to the SAME buffer, so the
            // elements' owned fields are reachable from exactly the two owners
            // whose walks are both is_unique-gated. Refusing it here sank the
            // credit even once arrstruct_unsafe_for admitted the share.
            if (arrstruct_counted_field_share(e, name, structs, msites)) { return 1; }
            return 0;
        },
        ast.ExprLambda(_) => { return 1; },
        ast.ExprMapLit(_) => { return 1; },
        ast.ExprFString(_) => { return 1; },
        ast.ExprUnknown(_) => { return 1; }
    }
    return 0;
}

// arrstruct_chain_esc: rctuple_chain_esc's array-of-structs sibling — re-scans
// a code-3 chain's index expressions and call arguments.
function arrstruct_chain_esc(x: ast.Expr, name: string, sty: string, structs: parser.StructDecl[], msites: string[], borrowable: string[]): boolean {
    match (x) {
        ast.ExprCall(c) => {
            if (arrstruct_chain_esc(c.callee, name, sty, structs, msites, borrowable)) { return true; }
            for arg in c.args { if (arrstruct_elem_esc_expr(arg, name, sty, structs, msites, borrowable)) { return true; } }
            return false;
        },
        ast.ExprFieldAccess(fa) => { return arrstruct_chain_esc(fa.obj, name, sty, structs, msites, borrowable); },
        ast.ExprIndex(ix) => {
            if (arrstruct_chain_esc(ix.array, name, sty, structs, msites, borrowable)) { return true; }
            return arrstruct_elem_esc_expr(ix.index, name, sty, structs, msites, borrowable);
        },
        ast.ExprIdent(_) => { return false; },
        _ => { return true; }
    }
    return false;
}

// arrstruct_elem_esc_at is the fold visitor: `esc` latches true, and each node
// answers per its arrstruct_elem_esc_shape code.
function arrstruct_elem_esc_at(x: ast.Expr, esc: boolean, name: string, sty: string, structs: parser.StructDecl[], msites: string[], borrowable: string[]): boolean {
    if (esc) { return true; }
    var code: i32 = arrstruct_elem_esc_shape(x, name, sty, structs, msites);
    if (code == 2) { return true; }
    if (code == 3) { return arrstruct_chain_esc(x, name, sty, structs, msites, borrowable); }
    if (code == 4) {
        match (x) {
            ast.ExprCall(c) => {
                var callee: string = ident_name_or_empty(c.callee);
                if (callee == name) { return true; }
                // A bare-ident ARGUMENT at a param proven to touch no ELEMENT of it
                // ("ELB:") is a borrow, not an escape. Reading it as one cost the
                // array its whole element walk: `rd(keep, r)` over a callee that only
                // reads `src.len()` measured 4 allocs / 2 frees against native's 4/4,
                // the payload stranded — the argument position alone, independent of
                // the binding source and of any loop.
                //
                // The plain box flag is NOT enough, the same as the arrenum twin. It
                // proves the callee never keeps the BOX, which licenses a box-only
                // release; this class's release walks the ELEMENTS. Reading
                // emit_arrstruct_deep_free suggests otherwise — its per-element step
                // is an rc-GATED field drop plus a plain __fern_rc_dec, and a dec
                // cannot over-free a box a second owner holds a COUNTED reference to.
                // That last word is the gap: an element handed out UNCOUNTED has no
                // such reference, and the box flag says nothing about it. Every
                // handout probe that could be written by hand reads clean on the box
                // flag; the compiler's own sources segfault gen2 in three fixpoint
                // programs. Ask the element question.
                //
                // "CNT:" admits a SECOND position, where "ELB:" refuses — the
                // arrenum twin's reasoning verbatim. A callee that STORES the array
                // in a struct literal keeps a reference, so the element flag says
                // no, but that store is COUNTED: the construction incs the array and
                // the holder's field drop decs it, leaving the caller's own claim
                // intact and its element walk still owed. Withholding it is the leak
                // (`struct_arr__param`, a constant 2 objects), not the safety.
                // param_counted_of's "DCNT:" tier proves the store counted, and
                // admits only where the element walk exists and no `p[i]` hands one
                // out.
                //
                // Free functions only — a method's receiver is a second borrow
                // question the tier does not answer.
                var eai: i32 = 0;
                while (eai < c.args.len()) {
                    if (ident_name_or_empty(c.args[eai]) == name) {
                        if (!(param_is_borrowable(borrowable, "ELB:" + callee, eai)
                              || param_is_borrowable(borrowable, "CNT:" + callee, eai))) { return true; }
                    } else if (arrstruct_elem_esc_expr(c.args[eai], name, sty, structs, msites, borrowable)) { return true; }
                    eai = eai + 1;
                }
                return false;
            },
            _ => { return true; }
        }
    }
    if (code == 5) {
        // The sanctioned self-store scans only the FIRST argument — `append`'s
        // element, `with`'s index. `with`'s element argument was vetted by
        // arrstruct_self_store_elem (a bare ident or a fresh literal) and the
        // hand scan never walked it; preserved exactly.
        match (x) {
            ast.ExprCall(c) => { return arrstruct_elem_esc_expr(c.args[0], name, sty, structs, msites, borrowable); },
            _ => { return true; }
        }
    }
    return false;
}

// arrstruct_elem_esc_expr: does `e` use the array-of-structs local `name` (element
// struct type `sty`) in a way that ESCAPES an owned field the reclaim would free? The
// leaf is an ELEMENT field access `name[i].f`: a scalar field is a safe value copy; an
// ARRAY / nested-struct / enum field extracted bare escapes. `name[i].f[j]` (indexed
// array-field read) and `name[i].f.len()` are borrows; a BARE `name[i]` element (the
// struct box) or a bare `name` escapes — except as an ARGUMENT at an "ELB:"-flagged
// param, where the callee is proven to touch no element.
function arrstruct_elem_esc_expr(e: ast.Expr, name: string, sty: string, structs: parser.StructDecl[], msites: string[], borrowable: string[]): boolean {
    function visit(x: ast.Expr, esc: boolean): boolean { return arrstruct_elem_esc_at(x, esc, name, sty, structs, msites, borrowable); }
    function descend(x: ast.Expr): boolean { return arrstruct_elem_esc_shape(x, name, sty, structs, msites) == 0; }
    return astwalk.fold_expr_pruned(e, false, visit, descend);
}

function arrstruct_elem_payload_escapes(stmts: ast.Stmt[], name: string, sty: string, structs: parser.StructDecl[], msites: string[], borrowable: string[]): boolean {
    function visit(x: ast.Expr, esc: boolean): boolean { return arrstruct_elem_esc_at(x, esc, name, sty, structs, msites, borrowable); }
    function descend(x: ast.Expr): boolean { return arrstruct_elem_esc_shape(x, name, sty, structs, msites) == 0; }
    for stmt in stmts {
        if (astwalk.fold_stmt_pruned(stmt, false, visit, descend)) { return true; }
    }
    return false;
}

// ── ARRENUM: reclaim `MyEnum[]` array-of-enums locals (#5474 / #4353 item 4) ──
// The last missing array-of-X element kind. `string[]` (#5471), `struct[]`
// (ARRSTRUCT) and `(…)[]` (ARRTUP) all reclaim their elements; an enum array was
// left on a buffer-only dec, so the outer buffer was freed and every element enum
// box — and any rc payload it carried — leaked.
//
// Two things make this class its own machinery rather than another ARRSTRUCT:
//
//   - The per-element drop DISPATCHES on the variant at runtime, so it routes
//     emit_enum_variant_drops rather than a type-directed __struct_drop_<T>.
//   - emit_enum_variant_drops frees the element box ITSELF and zeroes the slot,
//     so this walk must NOT copy ARRTUP/ARRSTRUCT's trailing __fern_rc_dec on the
//     element. Copying it double-frees every element.
//
// The element enum name reaches the release side through the CREDIT
// ("ARRENUM:<local>#<Enum>"), not through the slot: an `E[]` slot records its
// element enum in neither `arrarr_elem` (populated only for `T[][]`, and only for
// four scalar tags) nor `struct_type`, and adding a slot column for one class is
// more surface than parsing a credit that is already per-name.

// arrenum_lit_enum: `e` is a non-empty array literal whose EVERY element is a fresh
// construction of the SAME enum (fresh_rcpayload_enum_init — the ctor forms the
// scalar-enum reclaim already admits, qualified and unqualified, call and unit).
// Returns that enum's name, else "". A bare-ident element would alias a live enum
// box the free could dangle, so only constructions qualify.
function arrenum_lit_enum(e: ast.Expr, structs: parser.StructDecl[]): string {
    match (e) {
        ast.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return ""; }
            var owner: string = "";
            var i: i32 = 0;
            while (i < arr.elements.len()) {
                var o: string = fresh_rcpayload_enum_init(arr.elements[i], structs, [], [], false);
                // An all-scalar enum's fresh ctor qualifies too (#7678): its
                // element release is a box-only free, so the same sole-owner
                // argument holds with no payload counting to prove.
                if (o.len() == 0) { o = fresh_scalar_enum_init(arr.elements[i], structs); }
                if (o.len() == 0) { return ""; }
                if (owner.len() == 0) { owner = o; }
                if (o != owner) { return ""; }
                i = i + 1;
            }
            return owner;
        },
        _ => { return ""; }
    }
    return "";
}

// arrenum_esc_expr reports whether `e` uses `name` in ANY way other than as the
// receiver of `name.len()`.
//
// This is the maximally-conservative first cut the issue asks for, and the reason
// is that the hazard here is a double-free rather than a leak: `match (xs[i])` reads
// an element box as a borrowed indexed value and an arm may bind its payload, so
// freeing that element while a binding aliases it corrupts the self-compile. Every
// extraction — `xs[i]` bare, as a match subject, or a payload binding — therefore
// falls back to the existing leak-safe shallow dec. Widening this to admit indexed
// reads is the follow-up, and it needs the arm-binding escape analysis ARRTUP grew.
function arrenum_esc_expr(e: ast.Expr, name: string, borrowable: string[]): boolean {
    match (e) {
        ast.ExprIdent(id) => { return id.name == name; },
        ast.ExprNumber(_) => { return false; },
        ast.ExprString(_) => { return false; },
        ast.ExprBool(_) => { return false; },
        ast.ExprUnknown(_) => { return false; },
        ast.ExprMapLit(ml) => {
            var mi: i32 = 0;
            while (mi < ml.keys.len()) {
                if (arrenum_esc_expr(ml.keys[mi], name, borrowable) || arrenum_esc_expr(ml.vals[mi], name, borrowable)) { return true; }
                mi = mi + 1;
            }
            return false;
        },
        ast.ExprFString(fs) => {
            var fi: i32 = 0;
            while (fi < fs.exprs.len()) {
                if (fs.is_expr[fi] && arrenum_esc_expr(fs.exprs[fi], name, borrowable)) { return true; }
                fi = fi + 1;
            }
            return false;
        },
        ast.ExprBinary(b) => { return arrenum_esc_expr(b.left, name, borrowable) || arrenum_esc_expr(b.right, name, borrowable); },
        ast.ExprUnary(u) => { return arrenum_esc_expr(u.operand, name, borrowable); },
        ast.ExprCall(c) => {
            // `name.len()` — a header read that touches no element, so a borrow.
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field == "len") {
                        match (cfa.obj) {
                            ast.ExprIdent(rid) => {
                                if (rid.name == name) {
                                    for arg in c.args { if (arrenum_esc_expr(arg, name, borrowable)) { return true; } }
                                    return false;
                                }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            if (arrenum_esc_expr(c.callee, name, borrowable)) { return true; }
            // A bare-ident ARGUMENT whose callee position is proven to touch no
            // ELEMENT of it ("ELB:") is a borrow, not an escape. The plain box
            // flag is NOT enough here and asking it would be a double free: it
            // says the callee never keeps the BOX, while this class's release
            // WALKS the element boxes and frees them, so a callee that merely
            // hands one out would leave the caller's walk dangling it. Free
            // functions only — a method's receiver is a second borrow question
            // this tier does not answer.
            var eb_callee: string = "";
            match (c.callee) {
                ast.ExprIdent(ecid) => { eb_callee = ecid.name; },
                _ => {}
            }
            var eai: i32 = 0;
            while (eai < c.args.len()) {
                var eb_bare: boolean = false;
                match (c.args[eai]) {
                    ast.ExprIdent(eaid) => { if (eaid.name == name) { eb_bare = true; } },
                    _ => {}
                }
                if (eb_bare) {
                    // "CNT:" admits a SECOND position, where "ELB:" refuses: a
                    // callee that STORES the array in a struct literal keeps a
                    // reference, so the element flag says no, but that store is
                    // a counted one — the construction incs the array and the
                    // holder's field drop decs it — so the caller's own claim
                    // is untouched and its walk is still owed. Withholding it
                    // is the leak (`enum_arr__param`, a constant 2 objects),
                    // not the safety. param_counted_of's "DCNT:" tier is what
                    // proves the store counted, and it admits only where the
                    // element walk exists and no `p[i]` hands one out.
                    if (eb_callee.len() == 0
                        || !(param_is_borrowable(borrowable, "ELB:" + eb_callee, eai)
                            || param_is_borrowable(borrowable, "CNT:" + eb_callee, eai))) { return true; }
                } else if (arrenum_esc_expr(c.args[eai], name, borrowable)) { return true; }
                eai = eai + 1;
            }
            return false;
        },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (arrenum_esc_expr(a.elements[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { if (arrenum_esc_expr(el, name, borrowable)) { return true; } }
            return false;
        },
        ast.ExprIndex(x) => { return arrenum_esc_expr(x.array, name, borrowable) || arrenum_esc_expr(x.index, name, borrowable); },
        ast.ExprSlice(sl) => { return arrenum_esc_expr(sl.array, name, borrowable) || arrenum_esc_expr(sl.start, name, borrowable) || arrenum_esc_expr(sl.end, name, borrowable); },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { if (arrenum_esc_expr(sl.base, name, borrowable)) { return true; } }
            for fv in sl.field_values { if (arrenum_esc_expr(fv, name, borrowable)) { return true; } }
            return false;
        },
        ast.ExprFieldAccess(fa) => { return arrenum_esc_expr(fa.obj, name, borrowable); },
        // A lambda capturing the name carries it out of the frame entirely.
        ast.ExprLambda(lm) => {
            var used: string[] = astwalk.collect_idents_expr(e, []);
            return util.index_of_str(used, name) >= 0;
        },
    }
    return true;
}

function arrenum_esc_stmt(st: ast.Stmt, name: string, borrowable: string[]): boolean {
    match (st) {
        ast.StmtVar(v) => { return arrenum_esc_expr(v.init, name, borrowable); },
        ast.StmtAssign(a) => {
            // A reassignment of the name itself is not a read of it, but the value
            // is; the credit separately refuses reassigned names.
            if (a.target == name) { return true; }
            return arrenum_esc_expr(a.value, name, borrowable);
        },
        ast.StmtReturn(r) => { return arrenum_esc_expr(r.value, name, borrowable); },
        ast.StmtExpr(e) => { return arrenum_esc_expr(e.value, name, borrowable); },
        ast.StmtIf(f) => {
            if (arrenum_esc_expr(f.cond, name, borrowable)) { return true; }
            return arrenum_escapes(f.then_body, name, borrowable) || arrenum_escapes(f.else_body, name, borrowable);
        },
        ast.StmtWhile(w) => {
            if (arrenum_esc_expr(w.cond, name, borrowable)) { return true; }
            return arrenum_escapes(w.body, name, borrowable);
        },
        ast.StmtFor(fo) => {
            if (arrenum_esc_expr(fo.iter, name, borrowable)) { return true; }
            return arrenum_escapes(fo.body, name, borrowable);
        },
        ast.StmtMatch(m) => {
            // Any match over the name (or over anything mentioning it) extracts.
            if (arrenum_esc_expr(m.scrutinee, name, borrowable)) { return true; }
            for arm in m.arms {
                if (arm.has_guard) { if (arrenum_esc_expr(arm.guard, name, borrowable)) { return true; } }
                if (arrenum_escapes(arm.body, name, borrowable)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return arrenum_esc_stmt(d.action, name, borrowable); },
        _ => { return false; },
    }
    return false;
}

function arrenum_escapes(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
    for stmt in stmts {
        if (arrenum_esc_stmt(stmt, name, borrowable)) { return true; }
    }
    return false;
}

// arrenum_elem_read_of: `e` is exactly an indexed read `name[i]` whose index
// does not itself mention `name`; the admissible-extraction shape the two
// arms below share.
function arrenum_elem_read_of(e: ast.Expr, name: string): boolean {
    var no_reg: string[] = [];
    match (e) {
        ast.ExprIndex(x) => {
            match (x.array) {
                ast.ExprIdent(aid) => {
                    if (aid.name == name) { return !arrenum_esc_expr(x.index, name, no_reg); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return false;
}

// elem_arm_bindings_confined: every binding a match arm takes from an admitted
// element read stays confined to its arm — vetted by binding_escapes_arm,
// the strict form (a bare re-bind or bare assign of the binding refuses;
// `.len()`, indexing, arithmetic over reads admit). The at-binding holds the
// ELEMENT BOX itself and gets the same vet: confined-to-the-arm means it dies
// before the caller's walk frees the box.
function elem_arm_bindings_confined(arm: ast.MatchArm): boolean {
    var no_reg: string[] = [];
    match (arm.pattern) {
        ast.PatVariant(pv) => {
            if (pv.binding.len() > 0 && pv.binding != "_" && binding_escapes_arm(arm, pv.binding, no_reg)) { return false; }
            var bi: i32 = 0;
            while (bi < pv.extra_bindings.len()) {
                var bn: string = pv.extra_bindings[bi];
                if (bn.len() > 0 && bn != "_" && binding_escapes_arm(arm, bn, no_reg)) { return false; }
                bi = bi + 1;
            }
            if (pv.at_binding.len() > 0 && pv.at_binding != "_" && binding_escapes_arm(arm, pv.at_binding, no_reg)) { return false; }
        },
        _ => {}
    }
    return true;
}

// arrenum_param_esc_expr: the expression half of arrenum_param_escapes. It
// widens arrenum_esc_expr in exactly ONE place — a zero-param IIFE, the shape
// the parser builds for an `if` / `match` in VALUE position. lower_iife lowers
// such a body INLINE in the enclosing frame and builds no env box
// (is_iife_callee's own argument), so an element read inside it is the same
// read the statement form makes and earns the same admissions. Without it the
// lambda-capture arm reads the param as carried out of the frame entirely and
// refuses, which is why `return (match (src[0]) { … })` leaked where its
// statement sibling balanced. Every other form delegates to the stricter
// walker, so the widening cannot reach past this shape.
function arrenum_param_esc_expr(e: ast.Expr, name: string, body: ast.Stmt[]): boolean {
    var no_reg: string[] = [];
    match (e) {
        ast.ExprCall(c) => {
            if (is_iife_callee(c)) {
                match (c.callee) {
                    ast.ExprLambda(lm) => { return arrenum_param_escapes(lm.body, name, body); },
                    _ => {}
                }
            }
            return arrenum_esc_expr(e, name, no_reg);
        },
        ast.ExprBinary(b) => { return arrenum_param_esc_expr(b.left, name, body) || arrenum_param_esc_expr(b.right, name, body); },
        ast.ExprUnary(u) => { return arrenum_param_esc_expr(u.operand, name, body); },
        _ => { return arrenum_esc_expr(e, name, no_reg); }
    }
    return arrenum_esc_expr(e, name, no_reg);
}

// arrenum_param_escapes: arrenum_escapes for the "ELB:" flag question only —
// the callee-side walk of a borrowed array-of-boxes PARAM, widened with the
// extract-then-die admissions the borrowed-arg suites' callee_extracts_element
// rows name. Two shapes of an element read `name[i]` are admitted:
//
//   - the exact scrutinee of a `match`, when every arm binding (payloads and
//     the at-binding) is confined to its arm (elem_arm_bindings_confined);
//   - the whole init of `var e = name[i]`, when the local is confined by the
//     same proof pair the box flag trusts for a param name —
//     body_unsafe_for_match_borrow (a bare-ident `match (e)` is a borrow) and
//     param_match_binding_escapes (its arms' bindings stay confined).
//
// In both, the extracted box dies inside the callee before the CALLER's
// element walk frees it. Every other position of `name[i]` — a struct-literal
// slot, an append or call argument, a return value — stays an escape: that
// boundary is what keeps element_handed_out refused, and weakening it was a
// measured rc underflow (exit 99) with a perfect-looking census. All inner
// proofs run under empty registries, so the flag this feeds stays
// registry-independent and the interproc fixpoint cannot oscillate.
function arrenum_param_escapes(stmts: ast.Stmt[], name: string, body: ast.Stmt[]): boolean {
    var no_reg: string[] = [];
    for stmt in stmts {
        var st_esc: boolean = true;
        match (stmt) {
            ast.StmtVar(v) => {
                var whole_alias: boolean = false;
                match (v.init) {
                    ast.ExprIdent(vaid) => { if (vaid.name == name) { whole_alias = true; } },
                    _ => {}
                }
                if (arrenum_elem_read_of(v.init, name)
                    && !body_unsafe_for_match_borrow(body, v.name, no_reg, no_reg, [])
                    && !param_match_binding_escapes(body, v.name)) {
                    st_esc = false;
                } else if (whole_alias && !arrenum_param_escapes(body, v.name, body)) {
                    // A whole-array alias (`var x = src`) is admissible when the
                    // alias itself passes this same walk — its element reads get
                    // the admissions above, its bare uses (a return, a store, an
                    // append) refuse. Recursion is bounded by the def chain: the
                    // alias's own walk asks about x, and only another
                    // `var y = x` recurses further down it.
                    st_esc = false;
                } else {
                    st_esc = arrenum_param_esc_expr(v.init, name, body);
                }
            },
            ast.StmtAssign(a) => {
                if (a.target == name) { st_esc = true; }
                else { st_esc = arrenum_param_esc_expr(a.value, name, body); }
            },
            ast.StmtReturn(r) => { st_esc = arrenum_param_esc_expr(r.value, name, body); },
            ast.StmtExpr(e) => { st_esc = arrenum_param_esc_expr(e.value, name, body); },
            ast.StmtIf(f) => {
                st_esc = arrenum_esc_expr(f.cond, name, no_reg)
                    || arrenum_param_escapes(f.then_body, name, body)
                    || arrenum_param_escapes(f.else_body, name, body);
            },
            ast.StmtWhile(w) => {
                st_esc = arrenum_esc_expr(w.cond, name, no_reg) || arrenum_param_escapes(w.body, name, body);
            },
            ast.StmtFor(fo) => {
                st_esc = arrenum_esc_expr(fo.iter, name, no_reg) || arrenum_param_escapes(fo.body, name, body);
            },
            ast.StmtMatch(m) => {
                var m_esc: boolean = false;
                if (arrenum_elem_read_of(m.scrutinee, name)) {
                    for arm in m.arms {
                        if (!elem_arm_bindings_confined(arm)) { m_esc = true; }
                        if (arm.has_guard && arrenum_esc_expr(arm.guard, name, no_reg)) { m_esc = true; }
                        if (arrenum_param_escapes(arm.body, name, body)) { m_esc = true; }
                    }
                } else {
                    m_esc = arrenum_esc_expr(m.scrutinee, name, no_reg);
                    if (!m_esc) {
                        for arm in m.arms {
                            if (arm.has_guard && arrenum_esc_expr(arm.guard, name, no_reg)) { m_esc = true; }
                            if (arrenum_param_escapes(arm.body, name, body)) { m_esc = true; }
                        }
                    }
                }
                st_esc = m_esc;
            },
            ast.StmtDefer(d) => {
                var dl: ast.Stmt[] = [d.action];
                st_esc = arrenum_param_escapes(dl, name, body);
            },
            _ => { st_esc = false; },
        }
        if (st_esc) { return true; }
    }
    return false;
}

// ── the APPEND-BUILT half of the arrenum class ───────────────────────────────
//
// `var xs: E[] = []` grown by `xs = xs.append(E.A(..))`. arrenum_lit_enum rejects
// `[]` (no elements to prove fresh), which was right for a literal-only credit
// but left every append-built enum array uncredited and leaking its whole
// structure — the shape any code that computes its elements has to use.
//
// The per-element rule is the SAME one the literal applies
// (fresh_rcpayload_enum_init): a bare ident element would alias a live enum box
// the element walk could dangle, and this class's walk frees the element box
// itself. So the credit granted is the same "ARRENUM:" — there is no extra
// condition on the append form the way slot_is_reclaimable_structarr has one, and
// emit_arrenum_reclaim_store is already cow-guarded (old != new), which is the
// piece that makes a self-append rebind safe.
//
// `with` is NOT admitted here, unlike arrstruct's: it REPLACES, so the superseded
// element has to be released at the store, and this class's element release is a
// variant dispatch that frees the box rather than a dec. That is its own slice.

// arrenum_lit_is_empty: `e` is the `[]` an append-built array starts from.
function arrenum_lit_is_empty(e: ast.Expr): boolean {
    match (e) {
        ast.ExprArray(arr) => { return arr.elements.len() == 0; },
        _ => { return false; }
    }
    return false;
}

// arrenum_self_append_elem: `e` is `name.append(<fresh ctor of ename>)`, and the
// appended element mentions `name` nowhere (so `xs.append(E.A(xs[0]))` is refused
// by the same walk the escape gate uses).
function arrenum_self_append_elem(e: ast.Expr, name: string, structs: parser.StructDecl[], ename: string, borrowable: string[]): boolean {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "append") { return false; }
                    match (fa.obj) {
                        ast.ExprIdent(rid) => {
                            if (rid.name != name) { return false; }
                            if (arrenum_esc_expr(c.args[0], name, borrowable)) { return false; }
                            if (fresh_rcpayload_enum_init(c.args[0], structs, [], [], false) == ename) { return true; }
                            // The all-scalar sibling of the line above (#7678).
                            return fresh_scalar_enum_init(c.args[0], structs) == ename;
                        },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// arrenum_name_is_appended: at least one sanctioned self-append of `name`.
function arrenum_name_is_appended(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], ename: string, borrowable: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtAssign(a) => { if (a.target == name && arrenum_self_append_elem(a.value, name, structs, ename, borrowable)) { return true; } },
            ast.StmtIf(f) => {
                if (arrenum_name_is_appended(f.then_body, name, structs, ename, borrowable)) { return true; }
                if (arrenum_name_is_appended(f.else_body, name, structs, ename, borrowable)) { return true; }
            },
            ast.StmtWhile(w) => { if (arrenum_name_is_appended(w.body, name, structs, ename, borrowable)) { return true; } },
            ast.StmtFor(fo) => { if (arrenum_name_is_appended(fo.body, name, structs, ename, borrowable)) { return true; } },
            ast.StmtMatch(m) => { for arm in m.arms { if (arrenum_name_is_appended(arm.body, name, structs, ename, borrowable)) { return true; } } },
            _ => {}
        }
    }
    return false;
}

// arrenum_counted_field_share: `e` is a struct literal that mentions `name` ONLY
// as the bare-ident value of a field whose declared type is an ARRAY OF ENUMS.
// The construction retains such a field — `is_array_type_name` covers `E[]` in the
// ExprStructLit fallback arm, so the alias-inc fires even though the gate above it
// names only scalar- and struct-arrays — so the field holds a COUNTED share, and
// reading it as an escape sank the source's whole reclaim.
//
// Both releases are rc-gated, which is what makes granting this safe rather than a
// double free: the holder's walk is __enum_arr_elems_drop_<E>, which is_unique-gates
// the buffer, and the source's is emit_arrenum_deep_free, now gated the same way.
// The stakes are higher than the struct sibling's — this walk FREES each element
// box — so both halves are a hard requirement, not an optimisation.
//
// Refused for a `{ ...base }` update (the copied fields carry no inc) and for a
// MOVED share. The move refusal is the one the struct sibling learned from a gen2
// segfault: the retain is move-gated (#6726), so at a move site the box takes over
// the local's reference and both the inc and the sweep dec are dropped — and this
// credit routes emit_arrenum_deep_free rather than that plain dec, so granting it
// there frees a buffer whose ownership left the frame. `return T { f: xs, … }` is
// that shape, because the return is the source's last use.
function arrenum_counted_field_share(e: ast.Expr, name: string, structs: parser.StructDecl[], msites: string[], borrowable: string[]): boolean {
    match (e) {
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { return false; }
            var seen: boolean = false;
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                match (sl.field_values[i]) {
                    ast.ExprIdent(fid) => {
                        if (fid.name == name) {
                            if (!is_enum_array_field_type(structs, decl_field_type(structs, sl.type_name, sl.field_names[i]))) { return false; }
                            if (moved_ident_at(sl.field_values[i], msites)) { return false; }
                            seen = true;
                        }
                    },
                    _ => { if (arrenum_esc_expr(sl.field_values[i], name, borrowable)) { return false; } }
                }
                i = i + 1;
            }
            return seen;
        },
        _ => { return false; }
    }
    return false;
}

// arrenum_counted_share_holders / arrenum_share_holder_respread: the same
// precondition the struct sibling needs. A holder that took a counted share and is
// then used as a struct-literal BASE copies the buffer pointer into a third box
// with NO inc, so three owners sit at rc 2 and the first two sweeps free it between
// them. The share count being complete is what the credit rests on, so this is a
// gate on the credit rather than something the walk could guard against.
function arrenum_counted_share_holders(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[], acc: string[], borrowable: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => { if (arrenum_counted_field_share(v.init, name, structs, msites, borrowable)) { a = push_str_unique(a, v.name); } },
            ast.StmtAssign(asg) => { if (arrenum_counted_field_share(asg.value, name, structs, msites, borrowable)) { a = push_str_unique(a, asg.target); } },
            ast.StmtIf(f) => { a = arrenum_counted_share_holders(f.then_body, name, structs, msites, a, borrowable); a = arrenum_counted_share_holders(f.else_body, name, structs, msites, a, borrowable); },
            ast.StmtWhile(w) => { a = arrenum_counted_share_holders(w.body, name, structs, msites, a, borrowable); },
            ast.StmtFor(fo) => { a = arrenum_counted_share_holders(fo.body, name, structs, msites, a, borrowable); },
            ast.StmtMatch(m) => { for arm in m.arms { a = arrenum_counted_share_holders(arm.body, name, structs, msites, a, borrowable); } },
            _ => {}
        }
    }
    return a;
}
function arrenum_share_holder_respread(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], msites: string[], borrowable: string[]): boolean {
    var holders: string[] = arrenum_counted_share_holders(stmts, name, structs, msites, [], borrowable);
    if (holders.len() == 0) { return false; }
    return body_spreads_any(stmts, structs, holders);
}

// arrenum_append_escapes: arrenum_escapes with exactly one sanctioned use — the
// self-append rebind. Only the assign case differs; everything else delegates, so
// the class keeps its deliberately tight "only xs.len()" rule everywhere else.
function arrenum_append_escapes(stmts: ast.Stmt[], name: string, structs: parser.StructDecl[], ename: string, msites: string[], allow_ret: boolean, borrowable: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (!arrenum_counted_field_share(v.init, name, structs, msites, borrowable)) {
                    if (arrenum_esc_expr(v.init, name, borrowable)) { return true; }
                }
            },
            ast.StmtReturn(r) => {
                // `return name` is a move-out, safe when the caller is asking the
                // PRODUCER question (arrenum_producer_ret_local). For the local
                // credit it is an escape like any other and delegates below.
                var ret_ok: boolean = false;
                match (r.value) {
                    ast.ExprIdent(rid) => { ret_ok = allow_ret && rid.name == name; },
                    _ => {}
                }
                if (!ret_ok && !arrenum_counted_field_share(r.value, name, structs, msites, borrowable)
                    && arrenum_esc_expr(r.value, name, borrowable)) { return true; }
            },
            ast.StmtExpr(e) => {
                if (!arrenum_counted_field_share(e.value, name, structs, msites, borrowable)
                    && arrenum_esc_expr(e.value, name, borrowable)) { return true; }
            },
            ast.StmtAssign(a) => {
                if (a.target == name) {
                    if (!arrenum_self_append_elem(a.value, name, structs, ename, borrowable)) { return true; }
                }
                else if (!arrenum_counted_field_share(a.value, name, structs, msites, borrowable)
                    && arrenum_esc_expr(a.value, name, borrowable)) { return true; }
            },
            ast.StmtIf(f) => {
                if (arrenum_esc_expr(f.cond, name, borrowable)) { return true; }
                if (arrenum_append_escapes(f.then_body, name, structs, ename, msites, allow_ret, borrowable)) { return true; }
                if (arrenum_append_escapes(f.else_body, name, structs, ename, msites, allow_ret, borrowable)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (arrenum_esc_expr(w.cond, name, borrowable)) { return true; }
                if (arrenum_append_escapes(w.body, name, structs, ename, msites, allow_ret, borrowable)) { return true; }
            },
            ast.StmtFor(fo) => {
                if (arrenum_esc_expr(fo.iter, name, borrowable)) { return true; }
                if (arrenum_append_escapes(fo.body, name, structs, ename, msites, allow_ret, borrowable)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (arrenum_esc_expr(m.scrutinee, name, borrowable)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && arrenum_esc_expr(arm.guard, name, borrowable)) { return true; }
                    if (arrenum_append_escapes(arm.body, name, structs, ename, msites, allow_ret, borrowable)) { return true; }
                }
            },
            _ => { if (arrenum_esc_stmt(stmt, name, borrowable)) { return true; } }
        }
    }
    return false;
}

// arrenum_append_unsafe_for: body_unsafe_for with the same one exception. The
// blunt gate flags any reassignment of the candidate, and the self-append IS a
// reassignment.
function arrenum_append_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], structs: parser.StructDecl[], ename: string, msites: string[]): boolean {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (!arrenum_counted_field_share(v.init, name, structs, msites, borrowable)
                    && expr_unsafe_for(v.init, name, borrowable, recv_borrow)) { return true; }
            },
            ast.StmtReturn(r) => {
                if (!arrenum_counted_field_share(r.value, name, structs, msites, borrowable)
                    && expr_unsafe_for(r.value, name, borrowable, recv_borrow)) { return true; }
            },
            ast.StmtExpr(e) => {
                if (!arrenum_counted_field_share(e.value, name, structs, msites, borrowable)
                    && expr_unsafe_for(e.value, name, borrowable, recv_borrow)) { return true; }
            },
            ast.StmtAssign(a) => {
                if (a.target == name) {
                    if (!arrenum_self_append_elem(a.value, name, structs, ename, borrowable)) { return true; }
                }
                else if (!arrenum_counted_field_share(a.value, name, structs, msites, borrowable)
                    && expr_unsafe_for(a.value, name, borrowable, recv_borrow)) { return true; }
            },
            ast.StmtIf(f) => {
                if (expr_unsafe_for(f.cond, name, borrowable, recv_borrow)) { return true; }
                if (arrenum_append_unsafe_for(f.then_body, name, borrowable, recv_borrow, structs, ename, msites)) { return true; }
                if (arrenum_append_unsafe_for(f.else_body, name, borrowable, recv_borrow, structs, ename, msites)) { return true; }
            },
            ast.StmtWhile(w) => {
                if (expr_unsafe_for(w.cond, name, borrowable, recv_borrow)) { return true; }
                if (arrenum_append_unsafe_for(w.body, name, borrowable, recv_borrow, structs, ename, msites)) { return true; }
            },
            ast.StmtFor(fo) => {
                var iter_unsafe: boolean = true;
                match (fo.iter) {
                    ast.ExprIdent(_) => { iter_unsafe = false; },
                    _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow); }
                }
                if (iter_unsafe) { return true; }
                if (arrenum_append_unsafe_for(fo.body, name, borrowable, recv_borrow, structs, ename, msites)) { return true; }
            },
            ast.StmtMatch(m) => {
                if (expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow)) { return true; }
                for arm in m.arms {
                    if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, recv_borrow)) { return true; }
                    if (arrenum_append_unsafe_for(arm.body, name, borrowable, recv_borrow, structs, ename, msites)) { return true; }
                }
            },
            _ => { if (stmt_unsafe_for(stmt, name, borrowable, recv_borrow)) { return true; } }
        }
    }
    return false;
}

// arrenum_append_built_enum: the element enum of an append-built candidate `name`
// declared in `stmts` — `var name: E[] = []` grown by sanctioned self-appends and
// by nothing else. "" when it is not that shape.
function arrenum_append_built_enum(stmts: ast.Stmt[], name: string, tname: string, structs: parser.StructDecl[]): string {
    if (tname.len() < 3) { return ""; }
    if (slice_unchecked(tname, tname.len() - 2, tname.len()) != "[]") { return ""; }
    var ename: string = slice_unchecked(tname, 0, tname.len() - 2) + "";
    if (!enum_arr_release_walk_ok(structs, ename)) { return ""; }
    if (!arrenum_name_is_appended(stmts, name, structs, ename, [])) { return ""; }
    return ename;
}

// collect_fresh_arrenum_names returns "<local>#<Enum>" for every `var xs: E[] = [ctor, …]`
// binding whose name is never reassigned. The enum rides the entry so the release side
// gets it without a slot column; the escape gate is applied by the caller, which owns
// the whole function body (a nested binding's uses can sit in the enclosing tail).
function collect_fresh_arrenum_names(stmts: ast.Stmt[], body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[], acc: string[]): string[] {
    var a: string[] = acc;
    var reassigned: string[] = body_assign_targets(stmts);
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                var owner: string = arrenum_lit_enum(v.init, structs);
                // A producer CALL earns the same credit the literal it returns
                // would: the "ARENUMF:" registry proved every returned element
                // box is the callee's own, and the ANNOTATION supplies the
                // element enum, which an `E[]` slot records nowhere.
                if (owner.len() == 0) { owner = arrenum_call_producer_enum(v.init, v.type_name, body, fresh_ret); }
                if (owner.len() > 0 && util.index_of_str(reassigned, v.name) < 0) {
                    a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col) + "#" + owner);
                }
                // APPEND-BUILT: `var xs: E[] = []` grown by self-append. The
                // `reassigned` exclusion above cannot apply — the self-append IS
                // the reassignment — so this arm brings its own gates, marked
                // "A|" so the crediting loop knows to use them.
                else if (owner.len() == 0 && arrenum_lit_is_empty(v.init)) {
                    var aeb: string = arrenum_append_built_enum(stmts, v.name, v.type_name, structs);
                    if (aeb.len() > 0) {
                        a = push_str_unique(a, reclaim_site_key_of(v.name, v.line, v.col) + "#" + aeb);
                        a = push_str_unique(a, "A|" + reclaim_site_key_of(v.name, v.line, v.col) + "#" + aeb);
                    }
                }
            },
            ast.StmtIf(f) => { a = collect_fresh_arrenum_names(f.then_body, body, structs, fresh_ret, a); a = collect_fresh_arrenum_names(f.else_body, body, structs, fresh_ret, a); },
            ast.StmtWhile(w) => { a = collect_fresh_arrenum_names(w.body, body, structs, fresh_ret, a); },
            ast.StmtFor(fo) => { a = collect_fresh_arrenum_names(fo.body, body, structs, fresh_ret, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = collect_fresh_arrenum_names(arm.body, body, structs, fresh_ret, a); }
            },
            _ => {},
        }
    }
    return a;
}

// arrenum_call_producer_enum: `e` is a direct call to an "ARENUMF:" producer that
// the body does not shadow with a local of the same name, and `tname` annotates
// the binding as that producer's `E[]`. Returns the element enum, else "".
//
// The annotation is required, not a convenience: the credit carries the element
// enum in its own entry because an `E[]` slot records it in neither arrarr_elem
// nor struct_type, and an unannotated binding leaves nothing to carry.
function arrenum_call_producer_enum(e: ast.Expr, tname: string, body: ast.Stmt[], fresh_ret: string[]): string {
    if (tname.len() < 3) { return ""; }
    if (slice_unchecked(tname, tname.len() - 2, tname.len()) != "[]") { return ""; }
    var ename: string = slice_unchecked(tname, 0, tname.len() - 2) + "";
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => {
                    if (util.index_of_str(fresh_ret, "ARENUMF:" + cid.name + "|" + ename) >= 0
                        && !body_declares_name(body, cid.name)) { return ename; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// arrenum_entry_enum returns the "<Enum>" half of a "<local>#<Enum>" entry, or "".
function arrenum_entry_enum(entry: string): string {
    var i: i32 = 0;
    while (i < entry.len()) {
        if (entry[i] == b'#') { return slice_unchecked(entry, i + 1, entry.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// arrenum_entry_name returns the "<local>" half of a "<local>#<Enum>" entry, or "".
function arrenum_entry_name(entry: string): string {
    var i: i32 = 0;
    while (i < entry.len()) {
        if (entry[i] == b'#') { return slice_unchecked(entry, 0, i) + ""; }
        i = i + 1;
    }
    return "";
}

// arrenum_enum_of_slot returns the element enum recorded in slot i's "ARRENUM:" credit,
// or "" when the slot carries none.
function arrenum_enum_of_slot(s: LowerState, i: i32): string {
    if (i < s.n_params) { return ""; }
    if (i >= s.locals.len()) { return ""; }
    if (!s.locals[i].is_arr) { return ""; }
    if (s.locals[i].is_arrarr || s.locals[i].is_strarr) { return ""; }
    // Keyed on the binding SITE like every other converted class; the '#' still
    // separates the key from the element enum, and a site key contains none.
    var site: string = s.reclaim_site_key(i);
    if (site.len() == 0) { return ""; }
    var pre: string = "ARRENUM:" + site + "#";
    var k: i32 = 0;
    while (k < s.reclaimable_names.len()) {
        var e: string = s.reclaimable_names[k];
        if (e.len() > pre.len() && slice_unchecked(e, 0, pre.len()) == pre) { return slice_unchecked(e, pre.len(), e.len()) + ""; }
        k = k + 1;
    }
    return "";
}

function slot_is_reclaimable_arrenum(s: LowerState, i: i32): boolean {
    return arrenum_enum_of_slot(s, i).len() > 0;
}

// emit_arrenum_deep_free frees the array-of-enums buffer in `slot`: null-guarded, a
// counted loop walks each element (an enum box ptr) and runs the runtime variant
// dispatch on it, then decs the outer buffer. Consumes no operand; leaves the slot
// dangling.
//
// NO per-element __fern_rc_dec: emit_enum_variant_drops already frees the box and
// zeroes the slot. That is the one place this differs from its ARRTUP/ARRSTRUCT
// siblings, and copying their trailing dec double-frees every element.
//
// The element loop is rc-gated on the BUFFER, not just per element: a buffer this
// frame shares with a co-owner still holds elements at rc 1, so nothing inside the
// loop can see the sharing. __enum_arr_elems_drop_<E>, the walk a struct FIELD of
// the same type takes, is_unique-gates the buffer for exactly that reason; this is
// the local-slot side of the same rule. It matters more here than it does for the
// struct sibling because this walk FREES each element box rather than deccing it,
// so two owners both walking is a double free rather than a double dec. Only the
// buffer dec stays unconditional — it is the release every owner must perform.
function emit_arrenum_deep_free(se: LowerState, slot: i32, ename: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // arr != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
    st = st.emit(ir.op_if(0));
    var idxn: string = "$aeni" + util.i32_to_string(st.locals.len());
    st = st.add_local(idxn);
    var idxslot: i32 = st.slot_of(idxn);
    var eln: string = "$aene" + util.i32_to_string(st.locals.len());
    st = st.add_local(eln);
    var elslot: i32 = st.slot_of(eln);
    st = st.emit(ir.op_const_i32(0 - 1));            // index starts at -1 (advance-at-top)
    st = st.emit(ir.op_store_local(idxslot));
    st = st.emit(ir.op_block(0)).enter_loop();
    st = st.emit(ir.op_loop(0));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_const_i32(1));
    st = st.emit(ir.op_bin("add", 0, false));
    st = st.emit(ir.op_store_local(idxslot));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_arr_len());
    st = st.emit(ir.op_bin("lt_s", 0, false));
    st = st.emit(ir.op_bin("not", 0, false));
    st = st.emit(ir.op_brif(1));                     // exit when idx >= len
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_arr_get(32));                 // elem = arr[idx] (enum box ptr)
    st = st.emit(ir.op_store_local(elslot));
    st = emit_enum_variant_drops(st, elslot, ename); // drop payload AND free the box
    st = st.emit(ir.op_br(0));                       // back-edge
    st = st.emit(ir.op_end());                       // end loop
    st = st.emit(ir.op_end()).exit_loop();           // end block
    st = st.emit(ir.op_end());                       // end if-buffer-unique
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));        // free the outer buffer box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_arrenum_reclaim_store: the loop-rebind. Stash `new`, deep-free the OLD
// structure, store new. The null guard inside deep_free covers the first iteration.
// COW-guarded (old != new) for the same reason as its siblings — a rebind that hands
// back the same buffer must not destroy the elements the stored value still points at.
function emit_arrenum_reclaim_store(se: LowerState, slot: i32, ename: string): LowerState {
    var scratch: string = "$aer" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = st.emit(ir.op_load_local(slot));            // old
    st = st.emit(ir.op_load_local(tmp));             // new
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = emit_arrenum_deep_free(st, slot, ename);    // free old structure
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// slot_is_reclaimable_arrstruct: slot i holds a fresh, non-escaping
// `(<struct-with-array>)[]` local, credited "ARRSTRUCT:" by reclaimable_names_of. The
// slot is plain is_arr with its struct_type set to the ELEMENT struct type (recorded at
// the array-of-structs binding) that routes field-reclaim.
function slot_is_reclaimable_arrstruct(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_arr) { return false; }
    if (s.locals[i].is_arrarr || s.locals[i].is_strarr) { return false; }
    var sty: string = s.struct_type_of_slot(i);
    if (sty.len() == 0) { return false; }
    if (!struct_has_reclaim_array_field(s.structs, sty)) { return false; }
    if (slot_credit_at(s, i, "ARRSTRUCT:")) { return true; }
    // APPEND-BUILT (#6535) carries a separate credit so the literal-built rule
    // is not widened by accident — the two reach the same deep walk, and the
    // rebind that distinguishes them is cow-guarded in
    // emit_arrstruct_reclaim_store.
    return slot_credit_at(s, i, "ARRSTRUCTA:");
}

// emit_arrstruct_deep_free frees the array-of-structs buffer in `slot`: null-guarded, a
// counted loop walks each element (a struct box ptr), deep-drops its rc fields
// (emit_struct_field_drops -> __struct_drop_<sty>, balanced by the construction
// alias-inc) then frees the struct box, and finally decs the outer buffer. Consumes no
// operand; leaves the slot dangling. The element hidden local is marked struct_type=sty
// so emit_struct_field_drops routes the per-type drop.
//
// The element loop is rc-gated on the BUFFER, not just per element: a buffer this
// frame shares with a co-owner still holds elements at rc 1, so the per-element
// gate inside the loop cannot see the sharing and every element box would be
// freed under the co-owner. __struct_arr_elems_drop_<E>, the walk a struct FIELD
// of the same type takes, is_unique-gates the buffer for exactly that reason;
// this is the local-slot side of the same rule. Only the buffer dec stays
// unconditional — it is the release that must happen for every owner.
function emit_arrstruct_deep_free(se: LowerState, slot: i32, sty: string): LowerState {
    var st: LowerState = se;
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("ne", 0, false));         // arr != 0 (null guard)
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
    st = st.emit(ir.op_if(0));
    var idxn: string = "$astri" + util.i32_to_string(st.locals.len());
    st = st.add_local(idxn);
    var idxslot: i32 = st.slot_of(idxn);
    var eln: string = "$astre" + util.i32_to_string(st.locals.len());
    st = st.add_local(eln);
    var elslot: i32 = st.slot_of(eln);
    st = st.mark_struct_type(elslot, sty);           // so emit_struct_field_drops routes __struct_drop_<sty>
    st = st.emit(ir.op_const_i32(0 - 1));            // index starts at -1 (advance-at-top)
    st = st.emit(ir.op_store_local(idxslot));
    st = st.emit(ir.op_block(0)).enter_loop();
    st = st.emit(ir.op_loop(0));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_const_i32(1));
    st = st.emit(ir.op_bin("add", 0, false));
    st = st.emit(ir.op_store_local(idxslot));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_arr_len());
    st = st.emit(ir.op_bin("lt_s", 0, false));
    st = st.emit(ir.op_bin("not", 0, false));
    st = st.emit(ir.op_brif(1));                     // exit when idx >= len
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(idxslot));
    st = st.emit(ir.op_arr_get(32));                 // elem = arr[idx] (struct box ptr)
    st = st.emit(ir.op_store_local(elslot));
    // rc-GATED: an element the append RETAINED is shared with a live source, and
    // only the owner that finds rc 1 may walk its fields. A sole-owned element
    // (the fresh-literal append, the literal-built array) is rc 1 here, so the
    // guard costs a branch and changes nothing for them.
    st = emit_struct_field_drops_gated(st, elslot, true);
    st = st.emit(ir.op_load_local(elslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));        // free the struct box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_br(0));                       // back-edge
    st = st.emit(ir.op_end());                       // end loop
    st = st.emit(ir.op_end()).exit_loop();           // end block
    st = st.emit(ir.op_end());                       // end if-buffer-unique
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));        // free the outer buffer box
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());                       // end if-not-null
    return st;
}

// emit_arrstruct_reclaim_store: the loop-rebind. Stash `new`, deep-free the OLD
// structure, store new. The null guard inside deep_free covers the first-iteration null.
//
// COW-GUARDED (old != new), like emit_structarr_reclaim_store. A self-append
// (`vals = vals.append(v)`) hands back the SAME buffer whenever the rc==1 grow
// happened in place, and the deep free would then destroy the elements the
// stored value still points at — a use-after-free, not a leak. The guard is
// what admits the append-built class at all; a genuine rebind to a different
// array still frees, so the literal-built path is unchanged.
function emit_arrstruct_reclaim_store(se: LowerState, slot: i32, sty: string): LowerState {
    var scratch: string = "$asr" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));            // stash new
    st = st.emit(ir.op_load_local(slot));            // old
    st = st.emit(ir.op_load_local(tmp));             // new
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = emit_arrstruct_deep_free(st, slot, sty);    // free old structure
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));             // new
    return st.emit(ir.op_store_local(slot));
}

// slot_is_reclaimable_structarr: the SCALAR-FIELD sibling of arrstruct. Slot i
// holds a fresh, non-escaping array of fresh struct literals
// (`var g = [P { .. }, P { .. }]`) whose element struct has NO rc-array field
// (struct_has_reclaim_array_field false — so the deep arrstruct path skips it and
// its element boxes would otherwise leak). Credited "STRUCTARR:" by
// reclaimable_names_of. The outer buffer's element pointers are each a sole-owned
// (rc=1) struct box, freed by the SAME __fern_arrarr_free helper the scalar
// arr-of-arr reclaim uses (one rc-guarded arr_dec per element pointer — exactly a
// struct-box free, __fern_rc_dec maps to __fn___fern_arr_dec — then the outer
// buffer). Deliberately NOT is_arrarr / is_strarr (T[][] / string[] have their own
// helpers). DISJOINT from slot_is_reclaimable_arrstruct: field-routing structs go
// there (deep drop of each element's fields), scalar-only structs here (shallow
// box — no field to drop). A "dyn <T>" element array is excluded (dyn sweep).
function slot_is_reclaimable_structarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_arr) { return false; }
    if (s.locals[i].is_arrarr || s.locals[i].is_strarr) { return false; }
    var sty: string = s.struct_type_of_slot(i);
    if (sty.len() == 0) { return false; }
    if (sty.len() > 4 && slice_unchecked(sty, 0, 4) == "dyn ") { return false; }
    if (struct_has_reclaim_array_field(s.structs, sty)) { return false; }
    if (slot_credit_at(s, i, "STRUCTARR:")) { return true; }
    // APPEND-BUILT candidates (#6127) carry a SEPARATE credit and a STRICTER
    // rule: the element struct's fields must be scalar or `string`.
    //
    // struct_has_reclaim_array_field above deliberately lets string / map /
    // option / tuple fields through — they "leak with the struct, sound" — so
    // the shallow box free this class performs releases everything an
    // all-scalar element owns, and everything but the string box for a
    // string-fielded one. Literal-built arrays have relied on the fully loose
    // rule for a long time and keep it (their behaviour is unchanged, byte for
    // byte); the append path does not inherit it, because widening it wholesale
    // across the ~112 append-built sites in the compiler's own sources is what
    // broke self-compilation the first time this was attempted (#6129:
    // gen0/gen1 diverged on unit 2_s83).
    //
    // `string` and `fn` specifically are safe to admit, which the map / option /
    // tuple kinds are not: the element BOX is provably fresh — structarr_elem_store_ok
    // admits only a no-base struct LITERAL or a strict-fresh-returning call,
    // rejecting the bare-ident element that would alias a live local (965 such
    // sites in the compiler's own sources, including every `s.ops.append(op)`)
    // — so the shallow free
    // releases a box this array solely owns. Its string field then leaks
    // EXACTLY as it already does on the literal-built path for the same type,
    // which is the sound direction and measurably the same code. Without this,
    // an append-built `N[]` leaked its element boxes too: 28800 bytes over 100
    // rounds against the literal-built form's 9600 (the strings alone).
    if (slot_credit_at(s, i, "STRUCTARRA:")) {
        return struct_all_scalar_string_or_fn_fields(s.structs, sty);
    }
    return false;
}

// struct_all_scalar_string_or_fn_fields: every field of `sty` is a plain scalar,
// a `string`, or an `fn` (closure), so a SHALLOW free of the struct's box
// releases the box itself and leaks at most its string / closure boxes. The
// append-built struct-array class admits this because its elements are provably
// fresh no-base literals (structarr_elem_store_ok), making the box sole-owned;
// the string leak is the same one the literal-built class has always accepted
// for the same type. Deliberately an allowlist rather than a denylist — a field
// type this does not recognise keeps the struct out, which is the safe
// direction and stays safe as the type system grows.
//
// `fn` rides the same argument as `string`: neither is a rc-ARRAY field (so
// struct_has_reclaim_array_field still keeps this class disjoint from
// ARRSTRUCT), and both are recovered rather than leaked when the type ALSO
// routes field reclaim — the deep branch then walks each element through
// __struct_drop_<T>, whose k_str / k_clo arms carry their own whole-program
// admissions. Without `fn` here a single closure field took the entire array
// out of the reclaim class, so its element boxes, strings AND closures all
// leaked (#6461: 320 B/round for an 8-record table).
function struct_all_scalar_string_or_fn_fields(structs: parser.StructDecl[], sty: string): boolean {
    if (sty.len() == 0) { return false; }
    var n: i32 = decl_field_count(structs, sty);
    if (n == 0) { return false; }
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = decl_field_type_at(structs, sty, fi);
        if (!is_scalar_field_type(ft) && ft != "string" && ft != "fn") { return false; }
        fi = fi + 1;
    }
    return true;
}

// is_scalar_field_type: the field is a by-value primitive — no heap box, no rc.
function is_scalar_field_type(ft: string): boolean {
    if (ft == "i32") { return true; }
    if (ft == "i64") { return true; }
    if (ft == "u8") { return true; }
    if (ft == "u32") { return true; }
    if (ft == "u64") { return true; }
    if (ft == "f32") { return true; }
    if (ft == "f64") { return true; }
    if (ft == "usize") { return true; }
    if (ft == "boolean") { return true; }
    return false;
}

// emit_structarr_reclaim_store: the struct-element twin of
// emit_optaarr_reclaim_store — stores `new` into a reclaimable struct-array
// slot, cow-guarded (a self-store never frees), freeing the PRIOR array's
// element boxes + outer buffer via __fern_arrarr_free.
function emit_structarr_reclaim_store(se: LowerState, slot: i32): LowerState {
    var scratch: string = "$saar" + util.i32_to_string(se.locals.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_load_local(tmp));
    st = st.emit(ir.op_bin("ne", 0, false));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// strarr_free_helper / strarr_elem_free_helper: the element-walking release a
// reclaimable string[] slot gets. One route since #7230: split/lines segments
// are OWNED COPIES now (rt_src_str_split / rt_src_str_lines append
// `slice + ""`), so the SARRB class takes the same rc-aware full free as every
// other string[] — a box-only free would strand each element's data buffer.
// The strarr_builtin flag still gates the SARRB credit
// (slot_is_reclaimable_strarr): it is the binding-site type confirmation, no
// longer a release selector.
function strarr_free_helper(s: LowerState, i: i32): string {
    return "__fern_str_arr_free";
}
function strarr_elem_free_helper(s: LowerState, i: i32): string {
    return "__fern_str_free";
}

function slot_is_reclaimable_strarr(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (!s.locals[i].is_strarr) { return false; }
    if (reclaim_has(s.reclaimable_names, "SARR:", s.reclaim_site_key(i))) { return true; }
    // The builtin-producer class needs BOTH halves: the "SARRB:" credit carries
    // the non-escape proof, the slot flag carries the type confirmation the
    // name-level collector could not make.
    return s.is_strarr_builtin_slot(i)
        && reclaim_has(s.reclaimable_names, "SARRB:", s.reclaim_site_key(i));
}

// dyn_reclaim_concrete_of (#4351): the payload tag registered for dyn local
// `name` under the "DYN:<name>|<tag>" reclaim entry, or "". The tag is the
// concrete STRUCT type name for an unboxed struct payload, or a primitive
// type name ("i32"/"f64"/"boolean"/"string") for an op_dyn_box'd cell.
function dyn_reclaim_concrete_of(s: LowerState, name: string): string {
    return tagged_value_of(s.reclaimable_names, "DYN:", name);
}

// darr_kinds_of (#4351 slice 3): the element-kind string registered for the dyn
// ARRAY local bound at site `site`, under the "DARR:<site>|<kinds>" reclaim
// entry, or "". kinds[i] = 'p' (plain cell/box dec) or 's' (string cell: inner
// box free then dec) for element i of the credited literal.
function darr_kinds_of(s: LowerState, site: string): string {
    if (site.len() == 0) { return ""; }
    return tagged_value_of(s.reclaimable_names, "DARR:", site);
}

// slot_is_reclaimable_dyn: slot `i` is a fresh, non-escaping dyn-Trait local
// holding a statically-known payload (#4351) — credited "DYN:" by
// reclaimable_names_of, or by the coercion site for a non-string primitive
// (which owns its cell unconditionally). A STRUCT payload is the concrete's
// rc-headered struct box (structs flow unboxed behind dyn), released by the
// exit sweep like a reclaimable struct: deep-drop the concrete's rc fields,
// then dec the box.
// A PRIM/STRING payload is an rc-headered op_dyn_box cell: the sweep decs it
// ("string" first frees the sole-owned inner string box at cell@8).
//
// Accepts a RETIRED slot, like the rcenum / scenum sweeps: retire_locals renames
// a BLOCK-SCOPED local on block exit, so a lookup that refuses those would miss
// every dyn local declared inside an if / while / for / match body and neither
// zero nor sweep its slot. Site-keyed since #7253, so the rename is irrelevant to
// the lookup and only the refusal would have been.
function slot_is_reclaimable_dyn(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    return dyn_reclaim_concrete_of(s, s.reclaim_site_key(i)) != "";
}

// slot_is_snapshot_param: slot `i` is a struct PARAM / receiver lower_func
// snapshotted at entry for the builder consume-rebind reclaim (#3456 slice 2,
// piggybacked as "SNAP:<slot>" on reclaimable_names). Only the param slot itself
// (i < n_params) and struct slots qualify; its reassign emits the snapshot-
// guarded shallow free (emit_snapshot_store) — freeing the function's own
// intermediate boxes, never the caller's original.
function slot_is_snapshot_param(s: LowerState, i: i32): boolean {
    if (i >= s.n_params) { return false; }
    if (i >= s.locals.len()) { return false; }
    if (s.struct_type_of_slot(i).len() == 0) { return false; }
    return reclaim_has(s.reclaimable_names, "SNAP:", util.i32_to_string(i));
}

// --- struct in-place reuse (FBIP): functional-update self-overwrite ---------
//
// Native's struct_reuse / computeReuseSources (ir.go ~3661): pair a freed box
// with a same-shape construction so the construction REUSES the box instead of
// free-then-alloc. This is the first, most contained slice — the
// functional-update self-overwrite: for `var c = T { ...d, f: v }` where `d` is
// a struct local of the SAME type T that is fresh, non-escaping (reclaimable),
// and DEAD after this statement (its last use is this update), reuse d's box in
// place: write only the overridden fields into d's box, leave the rest (already
// correct in d's box), make c be d's box, and zero d's slot so the exit sweep
// frees the box once (through c), never twice.
//
// Restricted to a SOUND case: T's fields are each either a flat scalar (i32 /
// boolean / i64 / f64 / u32 / u64 — leak-only, no rc) OR a leak-safe array field
// (i32[] / boolean[] / i64[] / f64[] — rc-tracked, deep-dropped on the struct's
// reclamation by emit_struct_field_drops). The base is a bare ident of a
// reclaimable same-type local, the override values do not themselves reference d,
// every override that targets an array field is a FRESH array literal, and d is
// referenced nowhere in the rest of the body. Anything else (string / nested-
// struct / struct-array / map / option / tuple fields, or an array-field override
// that isn't a fresh literal) falls back to the existing alloc-a-new-box path
// (unchanged behaviour). Soundness is gated by the byte-identical self-compile
// fixpoint.
//
// The one extra correctness rule vs the scalar-only slice: an OVERRIDDEN array
// field's OLD value in d's box must be released (dec) before the new value is
// written, or it leaks. Non-overridden array fields stay in d's box and move to c
// (deep-dropped at c's reclamation). See emit_self_overwrite_reuse.

// reuse_field_is_scalar: a flat leak-only scalar field (no rc) — i32 / boolean /
// the 8-byte i64 / f64 and the u32 / u64 widths.
function reuse_field_is_scalar(t: string): boolean {
    return t == "i32" || t == "boolean" || t == "i64" || t == "f64" || t == "u32" || t == "u64";
}

// structs_reuse_compatible: may a dead donor of type `dt` have its box reused by
// a construction of type `rt`? Same type is always compatible (the existing
// self-/cross-reuse case). CROSS-TYPE reuse (native's general-reuse
// same-box-class, e.g. dead Point{x,y} → Pair{a,b}, or Holder{id,items} →
// Bag{tag,data}) is admitted under a layout-identity subset: the two structs
// have the SAME field count and, per position, either
//   - both a leak-only SCALAR of the SAME slot width (a pure overwrite), OR
//   - both a leak-safe ARRAY field (i32[]/i64[]/f64[]/boolean[] — a pointer slot):
//     emit_cross_struct_reuse rc-dec's the donor's OLD array at that offset before
//     writing the recipient's fresh one. The dec is rc-GUARDED (frees only at
//     rc==1, else decrements), so a donor array co-owned elsewhere is never
//     double-freed; the recipient's array is separately required to be a FRESH
//     literal (cross_reuse_sites' `ok` gate / xblock_struct_arrays_fresh), so the
//     reused box solely owns it going forward.
// The per-position KIND must match (array↔array, scalar↔scalar): the emit chooses
// scalar-overwrite vs array-dec by the RECIPIENT's field kind, so a scalar donor
// slot under an array recipient position would be dec'd as a bogus pointer (and an
// array donor slot under a scalar recipient position would leak). Identical
// widths + kinds in order ⇒ byte-identical box layout ⇒ identical freelist size
// class, so the reused box is exactly the right size and lands in the same class
// the recipient would have allocated. emit_cross_struct_reuse writes every field
// with the RECIPIENT's type/offsets (the donor box is only loaded as a raw
// pointer), so no emit change is needed. String / nested-struct / map / option /
// tuple fields (needing a deep element walk on release) are still excluded.
function structs_reuse_compatible(structs: parser.StructDecl[], dt: string, rt: string): boolean {
    if (dt == rt) { return dt.len() > 0; }
    if (!decl_is_struct(structs, dt) || !decl_is_struct(structs, rt)) { return false; }
    // Class pairing (#4356 divergence 2): boxes are slot-uniform — every
    // field occupies one 8-byte slot and the box is (nfields+1) words — so
    // SAME FIELD COUNT means same allocation class (native's freelist-class
    // rule specialised to this allocator). Position-wise kind/width identity
    // is no longer needed: the reuse arm releases the donor's old fields by
    // walking the DONOR's OWN field types at the donor's slots
    // (emit_cross_struct_reuse), and the recipient's writes use the
    // recipient's types as always. Each side independently needs reusable
    // field kinds (struct_fields_reusable_cross); the donor's enum values
    // are separately freshness-gated in cross_construction_donor.
    var dn: i32 = decl_field_count(structs, dt);
    var rn: i32 = decl_field_count(structs, rt);
    if (dn != rn || dn == 0) { return false; }
    return struct_fields_reusable_cross(structs, dt) && struct_fields_reusable_cross(structs, rt);
}

// inarm_reuse_payload_type_ok: a payload field type the in-arm match-reuse lowering
// can read into a temp and write back at the right width. Admits the i32-shaped
// scalars (i32 / u32 / boolean — plain struct_get/struct_set) plus the 8-byte i64,
// u64, and f64 (struct_get_i64 / struct_get width-64 on read; lower_i64+struct_set_i64
// / lower_expr+struct_set width-64 on write, mirroring emit_enum_donor_reuse). u64
// rides the i64 8-byte path: struct_field_width classifies a u64 field as 64-bit and
// struct_field_is_i64 reports it i64, so the value round-trips at full width (no
// truncation).
function inarm_reuse_payload_type_ok(t: string): boolean {
    return t == "i32" || t == "u32" || t == "boolean" || t == "i64" || t == "u64" || t == "f64";
}

// struct_fields_reusable: every field of `struct_name` is a flat scalar
// (reuse_field_is_scalar), a leak-safe rc-tracked array field
// (is_leaksafe_array_field — i32[]/boolean[]/i64[]/f64[]), or a DIRECT
// nested-struct pointer field (`inner: Inner`, decl_is_struct). Both the
// cross-statement (emit_cross_struct_reuse) and functional-update self-overwrite
// (emit_self_overwrite_reuse) paths use this predicate; each RELEASES an
// overwritten nested-struct field's OLD inner box with a FULL freeing drop
// (__struct_drop_<FT> deep-drops its rc fields when it has any, then a box dec —
// native's emitFieldDropOnStack) and requires the new value be a FRESH struct
// literal, so the reused box solely owns it. On the self-overwrite path a CARRIED
// (non-overridden) nested-struct field simply moves with the reused box (ownership
// d→c) and is freed once at exit via __struct_drop_<T>; override values may not
// reference d (self_overwrite_reuse_sites), so there is no read-after-overwrite
// hazard. String / enum / map / option / tuple pointer fields are still excluded
// (no full-drop wired for them here), so they bail to the alloc path.
function struct_fields_reusable(structs: parser.StructDecl[], struct_name: string): boolean {
    for sd in structs {
        if (sd.name == struct_name) {
            if (sd.fields.len() == 0) { return false; }
            for fld in sd.fields {
                var t: string = fld.type_name;
                if (!reuse_field_is_scalar(t) && !is_leaksafe_array_field(t) && !decl_is_struct(structs, t)) { return false; }
            }
            return true;
        }
    }
    return false;
}

// struct_fields_reusable_param widens struct_fields_reusable for the OWN-PARAM
// reuse families (own_param_reuse_sites / own_param_self_overwrite_sites, via
// struct_fields_reusable_ownparam below): Map / leak-safe tuple / leak-safe
// Option fields are additionally admitted. All three are leak-only boxes on
// the IR path (never released anywhere), so overwriting or carrying one in a
// reused param box leaks it exactly like the normal drop path would have, and
// a copied pointer can never dangle — the emitters' release / carried-copy
// walks are per-type allowlists that already skip them (same reasoning as the
// _cross widening below).
function struct_fields_reusable_param(structs: parser.StructDecl[], struct_name: string): boolean {
    if (struct_fields_reusable(structs, struct_name)) { return true; }
    for sd in structs {
        if (sd.name == struct_name) {
            if (sd.fields.len() == 0) { return false; }
            for fld in sd.fields {
                var t: string = fld.type_name;
                if (!reuse_field_is_scalar(t) && !is_leaksafe_array_field(t) && !decl_is_struct(structs, t) && !is_map_type_name(t) && !is_leaksafe_tuple_field(t) && !is_leaksafe_opt_field_d(structs, t)) { return false; }
            }
            return true;
        }
    }
    return false;
}

// struct_fields_reusable_ownparam is the OWN-PARAM families' predicate:
// struct_fields_reusable_param plus ENUM and STRING fields. The donor is a
// parameter, so the alias-free proof the local families read off the donor's
// bind literal (donor_enum_fields_fresh) is unavailable — and unnecessary. An
// `own` param's box is sole-owned (the caller moved it in; the runtime
// __fern_rc_is_unique guard backstops), and its FIELD values carry whatever
// count the caller's construction gave them: every non-fresh enum field store
// and every base copy retains, so an old enum box's rc counts every live
// holder and the reuse arm's flat rc-gated dec never frees under one. A
// string field is retained on the same terms only for a type that ROUTES
// field reclaim (slit_reclaim), so string-fielded types are admitted only when
// routed — otherwise the caller's share is uncounted and the rc-aware
// __fern_str_free at the override would free it under a live holder.
function struct_fields_reusable_ownparam(structs: parser.StructDecl[], sfok: string[], struct_name: string): boolean {
    if (struct_fields_reusable_param(structs, struct_name)) { return true; }
    if (struct_has_string_field(structs, struct_name) && !struct_routes_field_reclaim_at(structs, sfok, struct_name)) { return false; }
    for sd in structs {
        if (sd.name == struct_name) {
            if (sd.fields.len() == 0) { return false; }
            for fld in sd.fields {
                var t: string = fld.type_name;
                if (!reuse_field_is_scalar(t) && !is_leaksafe_array_field(t) && !decl_is_struct(structs, t) && !is_map_type_name(t)
                    && !is_leaksafe_tuple_field(t) && !is_leaksafe_opt_field_d(structs, t)
                    && !decl_is_enum(structs, t) && t != "string") { return false; }
            }
            return true;
        }
    }
    return false;
}

// struct_fields_reusable_cross widens struct_fields_reusable for the
// CROSS-STATEMENT reuse family only (#4356 divergence 1): ENUM-typed fields
// are additionally admitted. Sound there because the donor is DEAD and every
// field is rewritten — the reuse arm releases the OLD enum field with a flat
// rc-gated `__fern_rc_dec` (a payloadless sentinel is guard-skipped, an
// aliased box just decs, a sole-owned box frees — payloads leak, the same
// safe-leak model the exit sweep applies to non-reclaimable enum slots), and
// the recipient's enum field VALUES are gated FRESH variant-constructor
// calls (cross_reuse_sites), so the reused box solely owns the new payload
// box. The self-overwrite family keeps the narrower predicate (carried
// fields would need per-field retain/release balancing — a later slice).
function struct_fields_reusable_cross(structs: parser.StructDecl[], struct_name: string): boolean {
    if (struct_fields_reusable(structs, struct_name)) { return true; }
    for sd in structs {
        if (sd.name == struct_name) {
            if (sd.fields.len() == 0) { return false; }
            for fld in sd.fields {
                var t: string = fld.type_name;
                // Map[K,V] / tuple / Option-Result fields (#4356 divergence 1)
                // are admitted with NO release, NO carried-copy inc, and NO
                // freshness gate: all three are leak-only boxes on the IR path
                // (a map or Option box is never freed anywhere; a tuple box is
                // exit-swept ONLY as a fresh scalar-literal local that never
                // escapes, and binding one into a struct-lit field IS an
                // escape), so overwriting one in a reused box leaks it exactly
                // like the normal drop path would have, and a copied pointer
                // can never dangle. Both emitters' release / carried-copy walks
                // are per-type allowlists, so these fields already take their
                // skip branch. (is_enum_like_name excludes bracketed generics
                // and "(...)" spellings, so none of the three ever routes into
                // the enum flat-dec release by accident.)
                // string[] (#4356 Delta B, rc-element arrays): admitted with a
                // DEEP __fern_str_arr_free release arm in emit_cross_struct_reuse
                // and value-freshness gates on BOTH sides (donor_enum_fields_fresh
                // / cross_recipient_fields_fresh require an element-fresh array
                // literal), so the freed elements + buffer are provably sole-owned.
                // fn (closure) fields (#4356 Delta B, native's FuncType kind):
                // admitted via the enum-like read of the coarse "fn" spelling
                // (is_enum_like_name("fn") is true — see its header), with the
                // enum arm's shallow rc-guarded dec as the env-box release (the
                // k_clo model, captures leak) and fresh-lambda value gates on
                // BOTH sides (fn_field_value_is_fresh in donor_enum_fields_fresh
                // / cross_recipient_fields_fresh, each tested BEFORE their enum
                // arm), so the freed box is provably sole-owned.
                // struct[] / enum[] box-element arrays (#4356 Delta B, the
                // last rc-element-array kind): admitted with a shallow
                // per-element release (__fern_arrarr_free — element boxes +
                // buffer, rc-guarded) and element-fresh array-literal value
                // gates on BOTH sides (boxarr_lit_all_elems_fresh). A struct[]
                // is restricted to SCALAR-field element types so the shallow
                // element free leaks nothing; an enum[] element's variant
                // payload stays on the k_enum shallow-leak model.
                var bx_ok: boolean = false;
                if (is_struct_array_field_type(structs, t)) {
                    if (struct_lit_all_scalar(structs, slice_unchecked(t, 0, t.len() - 2))) { bx_ok = true; }
                } else if (is_enum_array_field_type(structs, t)) { bx_ok = true; }
                if (!bx_ok && !reuse_field_is_scalar(t) && !is_leaksafe_array_field(t) && !decl_is_struct(structs, t) && !is_enum_like_name(t, structs) && t != "string" && t != "string[]" && !is_map_type_name(t) && !is_leaksafe_tuple_field(t) && !is_leaksafe_opt_field_d(structs, t)) { return false; }
            }
            return true;
        }
    }
    return false;
}

// ReuseSites: parallel arrays — for each self-overwrite reuse site, the
// top-level body-statement index and the base local name d whose box is reused
// in place. A flat pair (not string[][]) for the same self-host nested-array
// limitation as PreciseDrops.
struct ReuseSites { idxs: i32[], bases: string[] }

// fresh_struct_lit_type returns the struct type a name was bound from when its
// init is a direct `T { ... }` literal (no base), else "" — used to confirm the
// base d's box is a same-type T box that this update can overwrite in place.
function fresh_struct_lit_type(body: ast.Stmt[], name: string): string {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprStructLit(sl) => { if (!sl.has_base) { return sl.type_name; } return ""; },
                        _ => { return ""; },
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return "";
}

// fresh_struct_lit_type_deep: the nesting-aware sibling — finds `name`'s
// declaration(s) anywhere in the body (loop / if / match / defer bodies
// included) and returns the no-base struct-lit type they were bound from,
// or "" when any binding is a different shape or a different type (a
// shadowed / branch-divergent name stays conservatively untyped). Used by
// the NODEEP exemption in reclaimable_names_of, whose candidates include
// loop-nested locals the top-level-only lookup above can't see.
function fresh_struct_lit_type_deep(stmts: ast.Stmt[], name: string): string {
    var tys: string[] = fresh_struct_lit_types_acc(stmts, name, []);
    if (tys.len() == 0) { return ""; }
    var t0: string = tys[0];
    var i: i32 = 1;
    while (i < tys.len()) {
        if (tys[i] != t0) { return ""; }
        i = i + 1;
    }
    return t0;
}
function fresh_struct_lit_types_acc(stmts: ast.Stmt[], name: string, acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprStructLit(sl) => {
                            if (sl.has_base) { a = a.append(""); } else { a = a.append(sl.type_name); }
                        },
                        _ => { a = a.append(""); }
                    }
                }
            },
            ast.StmtIf(iff) => {
                a = fresh_struct_lit_types_acc(iff.then_body, name, a);
                a = fresh_struct_lit_types_acc(iff.else_body, name, a);
            },
            ast.StmtWhile(w) => { a = fresh_struct_lit_types_acc(w.body, name, a); },
            ast.StmtFor(fo) => { a = fresh_struct_lit_types_acc(fo.body, name, a); },
            ast.StmtMatch(m) => {
                for arm in m.arms { a = fresh_struct_lit_types_acc(arm.body, name, a); }
            },
            ast.StmtDefer(d) => { a = fresh_struct_lit_types_acc([d.action], name, a); },
            _ => {}
        }
    }
    return a;
}

// donor_bind_type: the struct type a reuse-donor candidate `name` was bound
// from — a direct fresh `T { ... }` literal (fresh_struct_lit_type), OR
// (#4356 divergence 3) a call to a STRICT fresh-returning function
// (`var d: T = mk(..)`, is_fresh_ret_binding against
// return_fresh_struct_ret_fns). A strict-fresh call result is the unambiguous
// SOLE owner of its box and every field buffer (every return is a no-base
// literal whose array fields are fresh scalar/string literals), so the reuse
// paths may deep-drop its old fields and hand its box on exactly like a
// literal-bound donor; the other donor gates (never reassigned, never
// escaping, dead after the reuse) are checked by the callers and carry the
// rest of the soundness unchanged. The call form requires the var's explicit
// `: T` annotation — it is both the donor-type source and the receiver-type
// approximation is_fresh_ret_binding's method key needs. Returns "" when the
// binding is neither form.
// struct_has_enum_field: struct `name` declares at least one enum- or
// string-typed field — the field kinds whose old-value release at a reuse
// site is a flat/rc-aware free that admission must keep alias-free by
// gating the DONOR's original values fresh (donor_enum_fields_fresh).
function struct_has_enum_field(structs: parser.StructDecl[], name: string): boolean {
    for sd in structs {
        if (sd.name == name) {
            for fld in sd.fields {
                if (is_enum_like_name(fld.type_name, structs)) { return true; }
                if (fld.type_name == "string") { return true; }
                if (fld.type_name == "string[]") { return true; }
                if (fld.type_name == "fn") { return true; }
                if (is_struct_array_field_type(structs, fld.type_name)) { return true; }
                if (is_enum_array_field_type(structs, fld.type_name)) { return true; }
            }
            return false;
        }
    }
    return false;
}

// donor_enum_fields_fresh: the donor's LITERAL bind sets every enum-typed
// field from a fresh variant-constructor call of that enum — so the donor's
// box solely owns each enum payload box and the reuse arm's flat dec can
// never free a box a live alias still holds (#4356 divergence 1). A donor
// bound from a call (strict-fresh registry constrains only array fields) or
// a literal with an aliased / non-ctor enum value is REJECTED when the type
// carries enum fields. True when the type has no enum fields at all.
function donor_enum_fields_fresh(body: ast.Stmt[], name: string, structs: parser.StructDecl[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprStructLit(sl) => {
                            if (sl.has_base) { return false; }
                            var fk: i32 = 0;
                            while (fk < sl.field_names.len()) {
                                var fkt: string = decl_field_type(structs, sl.type_name, sl.field_names[fk]);
                                if (fkt != "fn" && is_enum_like_name(fkt, structs)) {
                                    // "fn" reads as enum-like (see is_enum_like_name's
                                    // header) but is gated by its own fresh-closure arm
                                    // below, not the variant-ctor demand.
                                    if (variant_ctor_enum_owner(sl.field_values[fk], structs) != fkt) { return false; }
                                }
                                if (fkt == "string") {
                                    // A string field must be a literal or a fresh
                                    // producer (#4355's rule), so the box solely owns
                                    // it and the reuse-site __fern_str_free is
                                    // alias-free.
                                    var sfresh: boolean = false;
                                    match (sl.field_values[fk]) {
                                        ast.ExprString(_) => { sfresh = true; },
                                        _ => { sfresh = str_local_binding_is_fresh(sl.field_values[fk]); }
                                    }
                                    if (!sfresh) { return false; }
                                }
                                if (fkt == "string[]") {
                                    // A string[] field must be an element-fresh array
                                    // literal, so the reuse-site __fern_str_arr_free
                                    // (elements + buffer) is alias-free.
                                    if (!strarr_lit_all_elems_fresh(sl.field_values[fk])) { return false; }
                                }
                                if (fkt == "fn") {
                                    // An fn field must be a fresh lambda / __mkclo$
                                    // box, so the reuse-site arr_dec is alias-free.
                                    if (!fn_field_value_is_fresh(sl.field_values[fk])) { return false; }
                                }
                                if (is_struct_array_field_type(structs, fkt)) {
                                    // A struct[] field must be an element-fresh array
                                    // literal, so the reuse-site __fern_arrarr_free is
                                    // alias-free.
                                    if (!boxarr_lit_all_elems_fresh(sl.field_values[fk], structs, slice_unchecked(fkt, 0, fkt.len() - 2), false)) { return false; }
                                }
                                if (is_enum_array_field_type(structs, fkt)) {
                                    if (!boxarr_lit_all_elems_fresh(sl.field_values[fk], structs, slice_unchecked(fkt, 0, fkt.len() - 2), true)) { return false; }
                                }
                                fk = fk + 1;
                            }
                            return true;
                        },
                        _ => { return false; }
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

function donor_bind_type(body: ast.Stmt[], name: string, structs: parser.StructDecl[], fresh_ret: string[]): string {
    var lit: string = fresh_struct_lit_type(body, name);
    if (lit != "") { return lit; }
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    if (decl_is_struct(structs, v.type_name) && is_fresh_ret_binding(v.init, v.type_name, fresh_ret)) { return v.type_name; }
                    return "";
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return "";
}

// name_escapes_outside_stmt reports whether `name` escapes anywhere in `body`
// except statement `skip` — used to confirm d's ONLY escaping use is the
// struct-update base at the reuse statement (which is the consuming use the
// reuse optimises, not a real escape). reclaimable_names_of treats a
// struct-update base as an escape, so d would never be in `reclaim`; this is the
// reuse-specific reclaimability check that excludes that one base occurrence.
// opt_match_alias_escape_ok: every escape of `name` outside its consuming match
// is an ALIAS BIND (`var a = name`) that is safe to read as a borrow — each
// alias is never reassigned, never escapes on its own, and is never read after
// the match that frees the box.
//
// Without this the alias bind alone refuses the whole class: name_escapes_
// outside_stmt sees `var x = src` as an escape of src, the per-block free is
// declined, and NOTHING else picks the value up — Option[<flat scalar array>]
// has only the reassigned class (collect_fresh_optarr_names) and the
// non-match-consumed one (collect_unmatched_optarr_names), and an aliased,
// matched, non-reassigned local falls between them. The enum sibling has
// carried the equivalent reading since #6606, which is why the same shape over
// an enum was already clean while this one leaked every round.
//
// It cannot double-free. The alias's init is an IDENT, never a fresh
// `Some(..)`, so no candidate scan admits the alias itself — the source is the
// only name that can hold the credit, and it frees the one box once. The
// not-read-after-the-match proof is what keeps the surviving alias from
// reaching a freed box.
//
// The alias is cleared by body_unsafe_for_match_borrow rather than the coarse
// body_unsafe_for: an alias consumed by its own `match (x)` is reading the box
// as a BORROW — that match frees nothing, because the alias is not a candidate
// — and the coarse walker counts it as an escape, which refused the very shape
// this exists for. Everything else it refuses still refuses: a second alias, a
// return, a call argument.
function opt_match_alias_escape_ok(body: ast.Stmt[], name: string, skip: i32, borrowable: string[], recv_borrow: string[]): boolean {
    var esc: string[] = [];
    var saw_alias: boolean = false;
    var i: i32 = 0;
    while (i < body.len()) {
        if (i != skip) {
            var is_alias: boolean = false;
            match (body[i]) {
                ast.StmtVar(v) => {
                    match (v.init) {
                        ast.ExprIdent(aid) => {
                            if (aid.name == name
                                && util.index_of_str(body_assign_targets(body), v.name) < 0
                                && !body_unsafe_for_match_borrow(body, v.name, borrowable, recv_borrow, [])
                                // …and the alias must not carry the PAYLOAD out.
                                // The scan above reads `match (x)` as a borrow,
                                // which holds for the box and not for what its
                                // arm binds.
                                && !opt_body_binds_rc_payload(body, v.name)
                                && !name_used_after(body, v.name, skip)) {
                                is_alias = true;
                                saw_alias = true;
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            if (!is_alias) { esc = walk_stmt_escapes(body[i], esc); }
        }
        i = i + 1;
    }
    if (!saw_alias) { return false; }
    return util.index_of_str(esc, name) < 0;
}

function name_escapes_outside_stmt(body: ast.Stmt[], name: string, skip: i32): boolean {
    var esc: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        if (i != skip) { esc = walk_stmt_escapes(body[i], esc); }
        i = i + 1;
    }
    return util.index_of_str(esc, name) >= 0;
}

// self_overwrite_reuse_sites computes the functional-update self-overwrite reuse
// points. A statement i qualifies when it is `var c = T { ...d, f: v, ... }`
// (a struct-lit with a bare-ident base d) where:
//   - T's fields are each a flat scalar or a leak-safe array (struct_fields_reusable),
//   - d was bound from a fresh `T { ... }` literal of the SAME type T,
//   - d does not escape anywhere outside this statement (its only escaping use is
//     the update base here — the consuming use the reuse takes ownership of),
//   - none of the override VALUES reference d (so reading d's box while writing
//     it is order-safe; the overrides are evaluated against d's current fields),
//   - every override that targets a leak-safe array field is a FRESH array
//     literal (ExprArray) — so the box owns the new array, mirroring the normal
//     struct_make has-base constraint; an aliased array override bails,
//   - d is referenced nowhere in statements i+1.., i.e. dead after this update.
// d is never reassigned (a fresh single binding; a reassignment of d before i
// would make it escape via the RHS walk, caught by name_escapes_outside_stmt).
function self_overwrite_reuse_sites(body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[]): ReuseSites {
    var idxs: i32[] = [];
    var bases: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprStructLit(slit) => {
                        if (slit.has_base) {
                            match (slit.base) {
                                ast.ExprIdent(bid) => {
                                    var ok: boolean = struct_fields_reusable_cross(structs, slit.type_name)
                                        && donor_bind_type(body, bid.name, structs, fresh_ret) == slit.type_name
                                        && v.name != bid.name
                                        && util.index_of_str(body_assign_targets(body), bid.name) < 0
                                        && !name_escapes_outside_stmt(body, bid.name, i);
                                    // Enum-field types (#4356 divergence 1): the base's
                                    // enum values must be fresh ctors so the override
                                    // release's flat dec is alias-free (rejects call-
                                    // bound bases too — the strict-fresh registry does
                                    // not constrain enum fields).
                                    if (ok && struct_has_enum_field(structs, slit.type_name)) {
                                        if (!donor_enum_fields_fresh(body, bid.name, structs)) { ok = false; }
                                    }
                                    // No override value may reference d.
                                    if (ok) {
                                        var fj: i32 = 0;
                                        while (fj < slit.field_values.len()) {
                                            var none: string[] = [];
                                            if (util.index_of_str(astwalk.collect_idents_expr(slit.field_values[fj], none), bid.name) >= 0) { ok = false; }
                                            fj = fj + 1;
                                        }
                                    }
                                    // Per-kind override-value freshness — the same gate the
                                    // cross families apply to their recipient, so the reused
                                    // box solely owns every replaced pointer field once
                                    // emit_self_overwrite_reuse releases the old one.
                                    if (ok && !cross_recipient_fields_fresh(slit, structs)) { ok = false; }
                                    // d must be dead after this statement: no use
                                    // in any later top-level statement.
                                    if (ok) {
                                        var k: i32 = i + 1;
                                        while (k < body.len()) {
                                            var none2: string[] = [];
                                            if (util.index_of_str(astwalk.collect_idents_stmt(body[k], none2), bid.name) >= 0) { ok = false; }
                                            k = k + 1;
                                        }
                                    }
                                    if (ok) {
                                        idxs = idxs.append(i);
                                        bases = bases.append(bid.name);
                                    }
                                },
                                _ => {}
                            }
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return ReuseSites { idxs: idxs, bases: bases };
}

// --- struct in-place reuse (FBIP): the SELF-ASSIGN record update ------------
//
// `p = T { ...p, f: v }` — Fern's record-update idiom (E048 forbids field
// assignment, so every mutation is written this way). The rebind families above
// cannot see it: they match StmtVar with `v.name != base`, and here the
// assignment TARGET is the base. #6134, the self-host port of native's
// tryStructReuseOverwrite spread admission (#6124).
//
// The EMITTER needed no port. emit_self_overwrite_reuse already evaluates every
// override value into a temp before any box surgery (its step 1), which is what
// makes an override that reads the base (`n: p.n + 1`) order-safe; the rebind
// family's extra "no override value may reference d" gate is a property of how
// its DONOR is proved dead, not of the emitter. What this family adds is the
// admission set — computed over the WHOLE function body, because the update sits
// inside a loop while p is bound outside it, a pairing the index-keyed site
// lists cannot express.

// sa_is_self_update reports whether `e` is exactly `T { ...name, … }` — a struct
// literal of type `tyname` spreading `name` itself.
function sa_is_self_update(e: ast.Expr, name: string, tyname: string): boolean {
    match (e) {
        ast.ExprStructLit(slit) => {
            if (!slit.has_base || slit.type_name != tyname) { return false; }
            match (slit.base) {
                ast.ExprIdent(bid) => { return bid.name == name; },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// sa_assigns_ok counts the admitted self-updates of `name` in `stmts` (nested
// blocks included), returning -1 as soon as an assignment to `name` is anything
// else — a plain rebind, a different type, or a self-update whose override
// values are not all fresh (cross_recipient_fields_fresh, so no override can
// alias the field value the reuse arm releases). Every assignment has to
// qualify: one that does not would leave p's box holding a value the next
// update's release arm cannot reason about.
function sa_assigns_ok(stmts: ast.Stmt[], name: string, tyname: string, structs: parser.StructDecl[], acc: i32): i32 {
    var n: i32 = acc;
    var i: i32 = 0;
    while (i < stmts.len() && n >= 0) {
        n = sa_assigns_ok_stmt(stmts[i], name, tyname, structs, n);
        i = i + 1;
    }
    return n;
}

function sa_assigns_ok_stmt(st: ast.Stmt, name: string, tyname: string, structs: parser.StructDecl[], acc: i32): i32 {
    match (st) {
        ast.StmtAssign(a) => {
            if (a.target != name) { return acc; }
            if (!sa_is_self_update(a.value, name, tyname)) { return 0 - 1; }
            match (a.value) {
                ast.ExprStructLit(slit) => {
                    if (!cross_recipient_fields_fresh(slit, structs)) { return 0 - 1; }
                    return acc + 1;
                },
                _ => { return 0 - 1; },
            }
        },
        ast.StmtIf(f) => { return sa_assigns_ok(f.else_body, name, tyname, structs, sa_assigns_ok(f.then_body, name, tyname, structs, acc)); },
        ast.StmtWhile(w) => { return sa_assigns_ok(w.body, name, tyname, structs, acc); },
        ast.StmtFor(fr) => { return sa_assigns_ok(fr.body, name, tyname, structs, acc); },
        ast.StmtMatch(m) => {
            var n: i32 = acc;
            for arm in m.arms { n = sa_assigns_ok(arm.body, name, tyname, structs, n); }
            return n;
        },
        ast.StmtDefer(d) => { return sa_assigns_ok_stmt(d.action, name, tyname, structs, acc); },
        _ => { return acc; },
    }
}

// sa_escape_names is walk_stmts_escapes with ONE carve-out: the spread base of a
// self-update of `name` is the consuming use the reuse takes over, not a real
// escape. (name_escapes_outside_stmt makes the same carve-out by statement
// index; here the updates are nested inside loops, so it has to be structural.)
// A bare `name` anywhere else — a call argument, a container element, another
// literal's base, a `return`, a lambda capture — still escapes and disqualifies
// p, which is what proves p is the box's sole owner.
function sa_escape_names(stmts: ast.Stmt[], name: string, tyname: string, acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts {
        a = sa_escape_stmt(stmt, name, tyname, a);
    }
    return a;
}

function sa_escape_stmt(st: ast.Stmt, name: string, tyname: string, acc: string[]): string[] {
    match (st) {
        ast.StmtAssign(asn) => {
            if (asn.target == name && sa_is_self_update(asn.value, name, tyname)) {
                match (asn.value) {
                    ast.ExprStructLit(slit) => {
                        var a: string[] = acc;
                        var fi: i32 = 0;
                        while (fi < slit.field_values.len()) { a = walk_expr_escapes(slit.field_values[fi], a); fi = fi + 1; }
                        return a;
                    },
                    _ => {}
                }
            }
            return walk_expr_escapes(asn.value, acc);
        },
        ast.StmtIf(iff) => {
            var a: string[] = walk_expr_escapes(iff.cond, acc);
            a = sa_escape_names(iff.then_body, name, tyname, a);
            return sa_escape_names(iff.else_body, name, tyname, a);
        },
        ast.StmtWhile(w) => { return sa_escape_names(w.body, name, tyname, walk_expr_escapes(w.cond, acc)); },
        ast.StmtFor(f) => { return sa_escape_names(f.body, name, tyname, walk_expr_escapes(f.iter, acc)); },
        ast.StmtMatch(m) => {
            var a: string[] = walk_expr_escapes(m.scrutinee, acc);
            for arm in m.arms {
                if (arm.has_guard) { a = walk_expr_escapes(arm.guard, a); }
                a = sa_escape_names(arm.body, name, tyname, a);
            }
            return a;
        },
        ast.StmtDefer(d) => { return sa_escape_stmt(d.action, name, tyname, acc); },
        _ => { return walk_stmt_escapes(st, acc); },
    }
}

// ef_escape_names is walk_stmts_escapes with ONE carve-out: a bare enum-typed
// value at a struct-literal FIELD position is a COUNTED share, not an escape.
// The ExprStructLit lowering retains such a value (the k_enum arm's dec is what
// it balances), so the field holds its own claim and the source still owns the
// one it was bound with — the #7282 alias-bind arithmetic, one kind over.
// Refusing the name left NOTHING releasing the source's claim, so the box and
// its payload stranded once per construction.
//
// Both owners release under __fern_rc_is_unique (emit_enum_variant_drops_gated
// here, emit_struct_enum_field_payload_drops on the struct side), so whichever
// runs last finds rc 1 and does the deep drop; neither order double-frees.
// That gate is what licenses this carve-out, and only the credits that take
// the gated release may use this walk.
//
// A bare `name` anywhere else — a call argument, a container element, a return,
// a lambda capture, a literal's spread base — still escapes: none of those
// takes the field retain.
function ef_escape_names(stmts: ast.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    for stmt in stmts { a = ef_escape_stmt(stmt, structs, a); }
    return a;
}

// ef_counted_enum_field: override `i` of `slit` is a bare ident at a field whose
// DECLARED type is an enum — the position the construction retain covers.
function ef_counted_enum_field(slit: ast.ExprStructLit, i: i32, structs: parser.StructDecl[]): boolean {
    if (i >= slit.field_names.len()) { return false; }
    match (slit.field_values[i]) {
        ast.ExprIdent(_) => {},
        _ => { return false; }
    }
    return decl_is_enum(structs, decl_field_type(structs, slit.type_name, slit.field_names[i]));
}

function ef_escape_expr(e: ast.Expr, structs: parser.StructDecl[], acc: string[]): string[] {
    match (e) {
        ast.ExprStructLit(slit) => {
            var a: string[] = acc;
            if (slit.has_base) { a = walk_expr_escapes(slit.base, a); }
            var i: i32 = 0;
            while (i < slit.field_values.len()) {
                if (!ef_counted_enum_field(slit, i, structs)) { a = ef_escape_expr(slit.field_values[i], structs, a); }
                i = i + 1;
            }
            return a;
        },
        _ => { return walk_expr_escapes(e, acc); },
    }
    return acc;
}

function ef_escape_stmt(st: ast.Stmt, structs: parser.StructDecl[], acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => { return ef_escape_expr(v.init, structs, acc); },
        ast.StmtReturn(r) => { return ef_escape_expr(r.value, structs, acc); },
        ast.StmtExpr(ex) => { return ef_escape_expr(ex.value, structs, acc); },
        ast.StmtAssign(asn) => { return ef_escape_expr(asn.value, structs, acc); },
        ast.StmtIf(iff) => {
            var a: string[] = ef_escape_expr(iff.cond, structs, acc);
            a = ef_escape_names(iff.then_body, structs, a);
            return ef_escape_names(iff.else_body, structs, a);
        },
        ast.StmtWhile(w) => { return ef_escape_names(w.body, structs, ef_escape_expr(w.cond, structs, acc)); },
        ast.StmtFor(f) => { return ef_escape_names(f.body, structs, ef_escape_expr(f.iter, structs, acc)); },
        ast.StmtMatch(m) => {
            var a: string[] = ef_escape_expr(m.scrutinee, structs, acc);
            for arm in m.arms {
                if (arm.has_guard) { a = ef_escape_expr(arm.guard, structs, a); }
                a = ef_escape_names(arm.body, structs, a);
            }
            return a;
        },
        ast.StmtDefer(d) => { return ef_escape_stmt(d.action, structs, acc); },
        _ => { return walk_stmt_escapes(st, acc); },
    }
}

// name_escapes_outside_stmt_enumfield: name_escapes_outside_stmt under the
// counted-enum-field carve-out above.
function name_escapes_outside_stmt_enumfield(body: ast.Stmt[], name: string, skip: i32, structs: parser.StructDecl[]): boolean {
    var no_alias: string[] = [];
    return name_escapes_outside_stmt_enumfield_alias(body, name, skip, structs, no_alias);
}

// …with the #7687 confinement forgiveness, which that change gave to the
// EXIT-SWEEP credit's scan (body_unsafe_for_enumfield_alias) and not to this
// one. Both decide the same question for the same source, so a class that
// consults two escape scans needs both told: `var src = E.Full([…]); var x =
// src; match (src) { … }` was refused here and leaked 200/0 against native's
// 200/200, while the very same program with the match on the ALIAS was already
// clean. Bisected: two matches on the source with no alias are clean, and the
// dead alias alone is what denies the source, so the match is not the cause.
//
// A CONFINED alias (rcenum_alias_bind_sites_of: it does not escape the frame
// and does not hand the payload out) needs no release of its own and takes
// none, so skipping its bind leaves the source the sole releaser — the same
// "one releaser, not two" reasoning, reaching the source's other credit path.
// Only the bind statement is skipped, and its whole init IS the bare ident, so
// nothing else in it goes unscanned.
function name_escapes_outside_stmt_enumfield_alias(body: ast.Stmt[], name: string, skip: i32, structs: parser.StructDecl[], alias_ok: string[]): boolean {
    var esc: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        if (i != skip && !stmt_is_confined_enum_alias_bind(body[i], name, alias_ok)) {
            esc = ef_escape_stmt(body[i], structs, esc);
        }
        i = i + 1;
    }
    return util.index_of_str(esc, name) >= 0;
}

// stmt_is_confined_enum_alias_bind: `st` is `var v = name` whose own site key
// rcenum_alias_bind_sites_of vetted as confined.
function stmt_is_confined_enum_alias_bind(st: ast.Stmt, name: string, alias_ok: string[]): boolean {
    if (alias_ok.len() == 0) { return false; }
    match (st) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprIdent(aid) => {
                    if (aid.name != name) { return false; }
                    return util.index_of_str(alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// body_unsafe_for_enumfield / ef_unsafe_stmt / ef_unsafe_expr: body_unsafe_for
// under the same carve-out. Only the struct-literal arm forks; every other
// expression delegates to the strict walker, so each of its refusals still
// stands and an admitted name is one whose every OTHER use was already safe.
function body_unsafe_for_enumfield(stmts: ast.Stmt[], name: string, borrowable: string[], structs: parser.StructDecl[]): boolean {
    var no_alias: string[] = [];
    return body_unsafe_for_enumfield_alias(stmts, name, borrowable, structs, no_alias);
}

// body_unsafe_for_enumfield_alias is the scan above with the #7282 forgiveness
// the enum flavour never grew (#7687): a plain `var v: E = name` bind whose own
// site key is listed in `alias_ok` does NOT flag `name`. A dead alias bind used
// to deny the source its entire reclaim credit — 200 allocs / 0 frees against
// native's 200/200, with the alias never read.
//
// ONE releaser, not two. The tuple / string / strarr families pair their
// forgiveness with a retain and a credit for the alias, because there the alias
// is allowed to outlive or share. Here the alias is admitted ONLY when
// rcenum_alias_bind_sites_of proves it confined — it does not escape the frame
// and it does not hand the payload out — so it needs no release of its own and
// takes none: the source keeps its credit and remains the sole releaser. That
// is why no ExprIdent retain limb and no alias credit appear in this change;
// both were built, measured to change nothing, and dropped.
//
// The confinement proof is the whole safety argument, and its second half is
// load-bearing: without the payload-escape check an alias that returns its
// match payload makes the source's deep release free a buffer the caller still
// holds — measured as `__rc_underflow` firing where stock merely leaks, with a
// perfectly balanced census either way.
function body_unsafe_for_enumfield_alias(stmts: ast.Stmt[], name: string, borrowable: string[], structs: parser.StructDecl[], alias_ok: string[]): boolean {
    for stmt in stmts { if (ef_unsafe_stmt_alias(stmt, name, borrowable, structs, alias_ok)) { return true; } }
    return false;
}

function ef_unsafe_expr(e: ast.Expr, name: string, borrowable: string[], structs: parser.StructDecl[]): boolean {
    var none: string[] = [];
    match (e) {
        ast.ExprStructLit(sl) => {
            if (sl.has_base) {
                match (sl.base) {
                    ast.ExprIdent(_) => {},
                    _ => { if (expr_unsafe_for_vb(sl.base, name, borrowable, none, true)) { return true; } }
                }
            }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (!ef_counted_enum_field(sl, i, structs)
                        && ef_unsafe_expr(sl.field_values[i], name, borrowable, structs)) { return true; }
                i = i + 1;
            }
            return false;
        },
        // vb_borrow: a value block reached from here is walked with the
        // match-borrow reading, which is what a `var t = match (name) { … }`
        // needs. The enum-FIELD forgiveness above does not ride into the block —
        // that direction is conservative, so a field share written inside a value
        // block simply keeps the old refusal rather than gaining a wrong credit.
        _ => { return expr_unsafe_for_vb(e, name, borrowable, none, true); }
    }
    return false;
}

function ef_unsafe_stmt(st: ast.Stmt, name: string, borrowable: string[], structs: parser.StructDecl[]): boolean {
    var no_alias: string[] = [];
    return ef_unsafe_stmt_alias(st, name, borrowable, structs, no_alias);
}

function ef_unsafe_stmt_alias(st: ast.Stmt, name: string, borrowable: string[], structs: parser.StructDecl[], alias_ok: string[]): boolean {
    var none: string[] = [];
    match (st) {
        ast.StmtVar(v) => {
            // The forgiven alias bind (#7687): only a BARE-IDENT init, only at a
            // `var`, and only when this exact site earned the matching credit.
            if (alias_ok.len() > 0) {
                match (v.init) {
                    ast.ExprIdent(aid) => {
                        if (aid.name == name
                            && util.index_of_str(alias_ok, reclaim_site_key_of(v.name, v.line, v.col)) >= 0) { return false; }
                    },
                    _ => {}
                }
            }
            return ef_unsafe_expr(v.init, name, borrowable, structs);
        },
        ast.StmtReturn(r) => { return ef_unsafe_expr(r.value, name, borrowable, structs); },
        ast.StmtExpr(e) => { return ef_unsafe_expr(e.value, name, borrowable, structs); },
        ast.StmtAssign(a) => { return ef_unsafe_expr(a.value, name, borrowable, structs); },
        ast.StmtIf(f) => {
            if (ef_unsafe_expr(f.cond, name, borrowable, structs)) { return true; }
            return body_unsafe_for_enumfield_alias(f.then_body, name, borrowable, structs, alias_ok)
                || body_unsafe_for_enumfield_alias(f.else_body, name, borrowable, structs, alias_ok);
        },
        ast.StmtWhile(w) => {
            if (ef_unsafe_expr(w.cond, name, borrowable, structs)) { return true; }
            return body_unsafe_for_enumfield_alias(w.body, name, borrowable, structs, alias_ok);
        },
        ast.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                ast.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                _ => { iter_unsafe = ef_unsafe_expr(fo.iter, name, borrowable, structs); }
            }
            if (iter_unsafe) { return true; }
            return body_unsafe_for_enumfield_alias(fo.body, name, borrowable, structs, alias_ok);
        },
        ast.StmtMatch(m) => {
            // A bare-ident scrutinee is a BORROW, the reading
            // stmt_unsafe_for_match_borrow has always applied and this fork never
            // did. It matters because collect_fresh_rcenum_names only takes its
            // match-consumed branch when sole_top_level_match_idx finds exactly ONE
            // top-level match; everything else — matched twice, matched inside an
            // `if`, matched inside a loop — falls to this walk, and every one of
            // them reclaimed nothing (200 allocs / 0 frees against native's
            // 200/200 on all three).
            var ef_scrut_borrow: boolean = false;
            match (m.scrutinee) {
                ast.ExprIdent(sid) => { if (sid.name == name) { ef_scrut_borrow = true; } },
                _ => {}
            }
            if (!ef_scrut_borrow && ef_unsafe_expr(m.scrutinee, name, borrowable, structs)) { return true; }
            for arm in m.arms {
                if (arm.has_guard && ef_unsafe_expr(arm.guard, name, borrowable, structs)) { return true; }
                if (body_unsafe_for_enumfield(arm.body, name, borrowable, structs)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// sa_rebound_below reports whether `name` is bound a SECOND time anywhere under
// `stmts` — a nested `var name`, a `for name in …` element binding, or a
// match-arm pattern binder. A shadowing binding is not covered by the top-level
// donor gates, so its box may hold aliased pointer fields (`for p in ps` binds
// an element of ps outright) that the reuse arm would then free out from under
// the container. slot_of resolves to the shadowing slot, so admitting the name
// at all would fire the reuse there; the whole name is refused instead.
function sa_rebound_below(stmts: ast.Stmt[], name: string): boolean {
    for stmt in stmts {
        if (sa_rebound_stmt(stmt, name)) { return true; }
    }
    return false;
}

function sa_rebound_stmt(st: ast.Stmt, name: string): boolean {
    match (st) {
        ast.StmtVar(v) => { return v.name == name; },
        ast.StmtIf(f) => { return sa_rebound_below(f.then_body, name) || sa_rebound_below(f.else_body, name); },
        ast.StmtWhile(w) => { return sa_rebound_below(w.body, name); },
        ast.StmtFor(fr) => { return fr.var_name == name || sa_rebound_below(fr.body, name); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (sa_pat_binds(arm.pattern, name) || sa_rebound_below(arm.body, name)) { return true; }
            }
            return false;
        },
        ast.StmtDefer(d) => { return sa_rebound_stmt(d.action, name); },
        _ => { return false; },
    }
}

function sa_pat_binds(p: ast.Pattern, name: string): boolean {
    match (p) {
        ast.PatVariant(pv) => {
            if (pv.binding == name || pv.at_binding == name) { return true; }
            var i: i32 = 0;
            while (i < pv.extra_bindings.len()) {
                if (pv.extra_bindings[i] == name) { return true; }
                i = i + 1;
            }
            var n: i32 = 0;
            while (n < pv.nested.len()) {
                if (sa_pat_binds(pv.nested[n], name)) { return true; }
                n = n + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

// self_assign_update_names returns the local names whose every record update
// `p = T { ...p, … }` may reuse p's own box in place. `p` qualifies when:
//   - it is bound at fn-body top level by `var p = T { … }`, a fresh no-base
//     literal of a reuse-eligible struct type whose own pointer-kinded field
//     values are all fresh (donor_bind_type + donor_enum_fields_fresh — the
//     donor-side gates the rebind families apply, here proving the FIRST
//     update's release arm is alias-free),
//   - nothing else in the body binds its name — no parameter, and no shadowing
//     `var` / `for` / match binder (sa_rebound_stmt); slot_of resolves to the
//     nearest binding, and only the top-level one carries the donor gates,
//   - it is assigned at least once and every assignment qualifies
//     (sa_assigns_ok),
//   - it never escapes (sa_escape_names). p is then provably the box's sole
//     owner, so the __fern_rc_is_unique guard always takes the reuse arm and
//     emit_self_overwrite_reuse's fresh arm is the degradation path only.
function self_assign_update_names(body: ast.Stmt[], params: ast.ParamDecl[], structs: parser.StructDecl[], fresh_ret: string[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                var shadowed: boolean = false;
                var si: i32 = 0;
                while (si < body.len()) {
                    if (si != i && sa_rebound_stmt(body[si], v.name)) { shadowed = true; }
                    si = si + 1;
                }
                if (!shadowed && util.index_of_str(out, v.name) < 0 && !sa_param_named(params, v.name)) {
                    var ty: string = donor_bind_type(body, v.name, structs, fresh_ret);
                    if (ty.len() > 0 && struct_fields_reusable_cross(structs, ty)
                        && donor_enum_fields_fresh(body, v.name, structs)
                        && sa_assigns_ok(body, v.name, ty, structs, 0) > 0) {
                        var esc: string[] = [];
                        if (util.index_of_str(sa_escape_names(body, v.name, ty, esc), v.name) < 0) {
                            out = out.append(v.name);
                        }
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return out;
}

function sa_param_named(params: ast.ParamDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < params.len()) {
        if (params[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

// struct_fields_reusable_own widens struct_fields_reusable_param for the OWN-BASE
// update: string, string[], struct[], enum[] and enum fields are admitted too,
// because the emitter releases each of those override kinds (rc-gated; the
// arrays buffer-only here) and retains each carried copy on its fresh arm. An
// enum field's old value is provably counted wherever it came from — the
// ExprStructLit enum arm and the base copy both retain a non-fresh value — so
// the flat rc-gated dec never frees under a live holder; a string field's is
// counted only for a routed type, which own_update_params_of requires.
function struct_fields_reusable_own(structs: parser.StructDecl[], struct_name: string): boolean {
    if (struct_fields_reusable_param(structs, struct_name)) { return true; }
    for sd in structs {
        if (sd.name == struct_name) {
            if (sd.fields.len() == 0) { return false; }
            for fld in sd.fields {
                var t: string = fld.type_name;
                if (!reuse_field_is_scalar(t) && !is_leaksafe_array_field(t) && !decl_is_struct(structs, t) && !is_map_type_name(t)
                    && !is_leaksafe_tuple_field(t) && !is_leaksafe_opt_field_d(structs, t) && !decl_is_enum(structs, t)
                    && t != "string" && t != "string[]" && !is_struct_array_field_type(structs, t) && !is_enum_array_field_type(structs, t)) { return false; }
            }
            return true;
        }
    }
    return false;
}
// own_field_inplace_append: is override value `v` for field `fname` of type
// `fty` exactly `base.fname.append(x)` over a pointer-width-element array? That
// is the override an `own` base's reuse arm may perform in place on the field it
// already owns (emit_self_overwrite_reuse), storing the element exactly as the
// clone form does (lower_append_elem_value). Wide-element arrays (i64 / f64)
// keep the clone form, whose push op carries the element width.
function own_field_inplace_append(v: ast.Expr, base: string, fname: string, fty: string, structs: parser.StructDecl[]): boolean {
    var narrow: boolean = is_leaksafe_array_field(fty) && fty != "i64[]" && fty != "u64[]" && !is_float_array_type_name(fty);
    if (!narrow && fty != "string[]" && !is_struct_array_field_type(structs, fty) && !is_enum_array_field_type(structs, fty)) { return false; }
    match (v) {
        ast.ExprCall(c) => {
            if (c.args.len() != 1) { return false; }
            match (c.callee) {
                ast.ExprFieldAccess(cfa) => {
                    if (cfa.field != "append") { return false; }
                    match (cfa.obj) {
                        ast.ExprFieldAccess(ofa) => { return ofa.field == fname && ident_name_or_empty(ofa.obj) == base; },
                        _ => { return false; }
                    }
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// own_field_append_arg is the appended element of a value own_field_inplace_append
// admitted.
function own_field_append_arg(v: ast.Expr): ast.Expr {
    match (v) {
        ast.ExprCall(c) => { return c.args[0]; },
        _ => { return v; }
    }
    return v;
}

// own_update_params_of names the declared `own` struct parameters of a free
// function whose functional updates (`p = T { ...p, f: v }`, `return T { ...p,
// f: v }`) may reuse p's box in place. The caller MOVED its reference in, so the
// box is this frame's to overwrite; the runtime __fern_rc_is_unique guard in
// emit_self_overwrite_reuse degrades a counted alias to a fresh copy. What the
// scan has to establish is the part no guard covers: every override of a
// pointer field hands the box an OWNED value — a literal, a clone-form append
// or `.with` on the field itself, or a call result (owned by the identity
// convention) — never a bare local or another struct's field, which the box
// would then share uncounted with the local's sweep; and p itself is only ever
// read (`p.f`), passed on, or spread as a base.
function own_update_params_of(fn: parser.FuncDecl, structs: parser.StructDecl[], sfok: string[]): string[] {
    var out: string[] = [];
    if (fn.receiver_name.len() > 0) { return out; }
    for pd in fn.params {
        if (!pd.own || !decl_is_struct(structs, pd.type_name) || !struct_fields_reusable_own(structs, pd.type_name)) { continue; }
        // The reuse arm frees an overridden STRING field's old value rc-aware,
        // and the caller's construction retained its share of that value only
        // for a type that ROUTES field reclaim (slit_reclaim). Unrouted, the
        // share is uncounted and the free lands under a live holder.
        if (struct_has_string_field(structs, pd.type_name) && !struct_routes_field_reclaim_at(structs, sfok, pd.type_name)) { continue; }
        var sc: OwnUpdScan = OwnUpdScan { name: pd.name, tyname: pd.type_name, structs: structs, bare: 0, ok_uses: 0, updates: 0, bad: false };
        for st in fn.body { sc = astwalk.fold_stmt_nodes(st, sc, own_upd_scan_stmt, own_upd_scan_expr, astwalk.descend_all); }
        if (!sc.bad && sc.updates > 0 && sc.bare == sc.ok_uses) { out = out.append(pd.name); }
    }
    return out;
}

struct OwnUpdScan { name: string, tyname: string, structs: parser.StructDecl[], bare: i32, ok_uses: i32, updates: i32, bad: boolean }

function own_upd_scan_stmt(st: ast.Stmt, acc: OwnUpdScan): OwnUpdScan {
    match (st) {
        ast.StmtVar(v) => {
            // `var q = p` aliases the box under a second, swept name.
            if (ident_name_or_empty(v.init) == acc.name) { return OwnUpdScan { ...acc, bad: true }; }
            return acc;
        },
        // A rebind of p is a self-update, or `p = f(.., p, ..)` — the callee took
        // the box and handed one back, so p again holds a box this frame owns.
        ast.StmtAssign(a) => {
            if (a.target != acc.name || sa_is_self_update(a.value, acc.name, acc.tyname)) { return acc; }
            match (a.value) {
                ast.ExprCall(c) => {
                    for arg in c.args { if (ident_name_or_empty(arg) == acc.name) { return acc; } }
                    return OwnUpdScan { ...acc, bad: true };
                },
                _ => { return OwnUpdScan { ...acc, bad: true }; }
            }
        },
        // `return p` hands the box back whole — the move the `own` contract
        // already makes uncounted.
        ast.StmtReturn(r) => {
            if (ident_name_or_empty(r.value) == acc.name) { return OwnUpdScan { ...acc, ok_uses: acc.ok_uses + 1 }; }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

function own_upd_scan_expr(e: ast.Expr, acc: OwnUpdScan): OwnUpdScan {
    match (e) {
        ast.ExprIdent(id) => {
            if (id.name == acc.name) { return OwnUpdScan { ...acc, bare: acc.bare + 1 }; }
            return acc;
        },
        ast.ExprFieldAccess(fa) => {
            if (ident_name_or_empty(fa.obj) == acc.name) { return OwnUpdScan { ...acc, ok_uses: acc.ok_uses + 1 }; }
            return acc;
        },
        ast.ExprCall(c) => {
            var a: OwnUpdScan = acc;
            for arg in c.args {
                if (ident_name_or_empty(arg) == acc.name) { a = OwnUpdScan { ...a, ok_uses: a.ok_uses + 1 }; }
            }
            return a;
        },
        ast.ExprStructLit(sl) => {
            if (!sl.has_base || ident_name_or_empty(sl.base) != acc.name) { return acc; }
            if (sl.type_name != acc.tyname) { return OwnUpdScan { ...acc, bad: true }; }
            var fi: i32 = 0;
            while (fi < sl.field_names.len()) {
                var fty: string = decl_field_type(acc.structs, sl.type_name, sl.field_names[fi]);
                if (!own_override_owned(fty, sl.field_values[fi], acc.name, acc.structs)) { return OwnUpdScan { ...acc, bad: true }; }
                fi = fi + 1;
            }
            return OwnUpdScan { ...acc, ok_uses: acc.ok_uses + 1, updates: acc.updates + 1 };
        },
        _ => { return acc; }
    }
    return acc;
}

// own_override_owned: does override value `v` for a field of type `fty` hand the
// box an owned reference? Scalars always; an array from a literal, a call, or an
// `.append` / `.with` on the base's own field; a nested struct from a base-less
// literal; an enum from a fresh variant constructor; a string from a literal or
// a concatenation. A bare identifier or a field read of anything else is an
// uncounted alias and refuses the function.
function own_override_owned(fty: string, v: ast.Expr, base: string, structs: parser.StructDecl[]): boolean {
    if (reuse_field_is_scalar(fty)) { return true; }
    if (decl_is_enum(structs, fty)) { return variant_ctor_enum_owner(v, structs) == fty; }
    if (is_leaksafe_array_field(fty) || fty == "string[]" || is_struct_array_field_type(structs, fty) || is_enum_array_field_type(structs, fty)) {
        match (v) {
            ast.ExprArray(_) => { return true; },
            ast.ExprCall(c) => {
                match (c.callee) {
                    ast.ExprIdent(_) => { return true; },
                    ast.ExprFieldAccess(cfa) => {
                        if (cfa.field != "append" && cfa.field != "with") { return false; }
                        match (cfa.obj) {
                            ast.ExprFieldAccess(ofa) => { return ident_name_or_empty(ofa.obj) == base; },
                            _ => { return false; }
                        }
                    },
                    _ => { return false; }
                }
            },
            _ => { return false; }
        }
    }
    if (decl_is_struct(structs, fty)) {
        match (v) {
            ast.ExprStructLit(isl) => { return !isl.has_base; },
            _ => { return false; }
        }
    }
    if (fty == "string") {
        match (v) {
            ast.ExprString(_) => { return true; },
            ast.ExprBinary(_) => { return true; },
            _ => { return false; }
        }
    }
    return false;
}

// lower_stmt_or_self_assign_reuse routes an admitted self-assign record update
// (self_assign_update_names, seeded as "SAREUSE:<name>") to the in-place reuse
// emitter; everything else lowers normally.
function lower_stmt_or_self_assign_reuse(st: ast.Stmt, s: LowerState): LowerState {
    match (st) {
        ast.StmtAssign(a) => {
            if (s.is_self_assign_reuse_name(a.target)) {
                match (a.value) {
                    ast.ExprStructLit(slit) => {
                        if (sa_is_self_update(a.value, a.target, slit.type_name)) {
                            return emit_self_overwrite_reuse(a.target, "", a.value, a.target, false, s, s.is_own_param(a.target));
                        }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return lower_stmt(st, s);
}

// emit_self_overwrite_reuse lowers `var c = T { ...d, f: v, ... }` as a
// RUNTIME-GUARDED in-place reuse of d's box (#4350, native's token shape;
// the reuse site found by self_overwrite_reuse_sites). `c_name` is the new
// local; `slit` the struct-update literal; `base_name` is d.
//
// The static escape walk proves d is sole-owner; the __fern_rc_is_unique
// guard makes any FUTURE hole in that walk degrade instead of corrupting:
//   1. every override value is evaluated into a temp (reads of d's old
//      fields complete before any box surgery, on both branches);
//   2. reused = __fern_rc_is_unique(d); token = reused ? d : 0;
//   3. box = __fern_alloc_reuse(token, nfields+1 slots) — the SAME block on the
//      reuse path (same type -> the cap always fits), a fresh rc=1 arr-box
//      otherwise;
//   4. reuse arm: release each OVERRIDDEN field's old value (it is about to
//      be overwritten — or it leaks). Fresh arm: copy the shape word and
//      every NON-overridden field from d's still-live box (the aliases hold
//      it), rc-inc'ing pointer-kinded copies, then dec d's own reference
//      (rc >= 2 here, so the dec never frees);
//   5. store the override temps, bind c to the box, and ZERO d's slot so
//      the exit dec-sweep frees the box exactly once (through c) and
//      harmlessly decs a null for d.
// The `slit` is passed as the wrapped ast.Expr (not the unwrapped variant
// struct) and re-matched here — passing a large unwrapped AST struct by
// value is avoided.
//
// `c_name == base_name` is the SELF-ASSIGN record update `p = T { ...p, … }`
// (#6134, the site found by self_assign_update_names): one slot plays both
// roles, so c binds no new local and step 5's donor zeroing is skipped. Step 1
// is what makes it work at all — an override that reads p (`n: p.n + 1`) has
// already been evaluated into its temp before the box is touched.
function emit_self_overwrite_reuse(c_name: string, c_site: string, init: ast.Expr, base_name: string, release_prior: boolean, s: LowerState, shallow: boolean): LowerState {
    var dslot: i32 = s.slot_of(base_name);
    if (dslot < 0) { return s.fail(); }
    match (init) {
        ast.ExprStructLit(slit) => {
            var nf: i32 = decl_field_count(s.structs, slit.type_name);
            // 1. Evaluate every OVERRIDE value into a temp local FIRST (native
            //    tryStructReuseOverwrite step 1): the reads of d's old fields all
            //    complete before any box surgery, on both branches.
            //    An `own` base's `f: d.f.append(x)` over a scalar-element array
            //    field is the exception (inplace[j]): on the reuse arm it pushes
            //    onto the field the box already owns, so it is evaluated PER ARM
            //    below — in place where the box is unique, the clone form where
            //    it is shared and the buffer must stay untouched for the alias.
            var st: LowerState = s;
            var tslots: i32[] = [];
            var fidxs: i32[] = [];
            var inplace: boolean[] = [];
            var fj: i32 = 0;
            while (fj < slit.field_names.len()) {
                var fidx: i32 = st.field_index_in(slit.type_name, slit.field_names[fj]);
                if (fidx < 0) { return st.fail(); }
                var tname: string = "$sor" + util.i32_to_string(dslot) + "_" + util.i32_to_string(fj);
                st = st.add_local(tname);
                var tslot: i32 = st.slot_of(tname);
                var ip: boolean = shallow && own_field_inplace_append(slit.field_values[fj], base_name, slit.field_names[fj], decl_field_type(st.structs, slit.type_name, slit.field_names[fj]), st.structs);
                if (ip) {
                    st = st.emit(ir.op_const_i32(0));
                } else if (struct_field_is_i64(st.structs, slit.type_name, fidx)) {
                    st = lower_i64(slit.field_values[fj], st);
                } else {
                    st = lower_expr(slit.field_values[fj], st);
                }
                if (!st.ok) { return st; }
                st = st.emit(ir.op_store_local(tslot));
                tslots = tslots.append(tslot);
                fidxs = fidxs.append(fidx);
                inplace = inplace.append(ip);
                fj = fj + 1;
            }
            // Bind c's slot up front — both branches store the result box there.
            // A SELF-ASSIGN update (`p = T { ...p, … }`, #6134) names the same
            // local on both sides: c IS d, so it already has a slot and the
            // step-7 donor zeroing must not run (it would null p).
            var self_assign: boolean = c_name == base_name;
            if (!self_assign) { st = st.add_local(c_name); }
            var cslot: i32 = st.slot_of(c_name);
            // As in emit_cross_struct_reuse: this path binds the recipient without
            // bind_var_slot, so it records the binding-SITE key itself (#7253). A
            // self-assign reuses the EXISTING slot, which already carries its own
            // site — hence the empty key there, and the guard that keeps it.
            if (c_site.len() > 0) { st = st.mark_reclaim_site(cslot, c_site); }
            st = st.mark_struct_type(cslot, slit.type_name);
            // Loop body: free the recipient's prior (previous-iteration) box first —
            // only when the recipient is a RECLAIMABLE (non-escaping) local (an
            // escaping recipient's box is owned by the container it moved into; a
            // prior-release would be a UAF). Runs before the branch: it reads only
            // c's old slot + d's slot, both still untouched.
            if (release_prior && slot_is_reclaimable_struct(st, cslot)) { st = emit_reuse_recip_prior_release(st, cslot, dslot); }
            // 2. Runtime uniqueness guard (#4350, native's token shape): the
            //    static escape walk proves d is sole-owner, and this guard makes a
            //    future hole in that walk DEGRADE (fresh box) instead of corrupting
            //    (in-place write over a shared box). reused = __fern_rc_is_unique(d).
            var uname: string = "$sor_uniq" + util.i32_to_string(dslot);
            st = st.add_local(uname);
            var uslot: i32 = st.slot_of(uname);
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
            st = st.emit(ir.op_store_local(uslot));
            // 3. token = reused ? d : 0. (The not-unique branch's release of d's
            //    own reference happens at the END of the fresh arm below, after
            //    the carried-field copies read d's box.)
            var kname: string = "$sor_tok" + util.i32_to_string(dslot);
            st = st.add_local(kname);
            var kslot: i32 = st.slot_of(kname);
            st = st.emit(ir.op_load_local(uslot));
            st = st.emit(ir.op_if(0));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_else());
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_end());
            // 4. box = __fern_alloc_reuse(token, nfields): the token's block when
            //    it fits (same type -> always, on the reuse path), else a fresh
            //    rc=1 arr-box of the same shape struct_make allocates.
            var bname: string = "$sor_box" + util.i32_to_string(dslot);
            st = st.add_local(bname);
            var bslot: i32 = st.slot_of(bname);
            st = st.emit(ir.op_load_local(kslot));
            st = st.emit(ir.op_const_i32(nf + 1));
            st = st.emit(ir.op_call_direct("__fern_alloc_reuse", 2));
            st = st.emit(ir.op_store_local(bslot));
            // 5. Branch-specific box preparation.
            st = st.emit(ir.op_load_local(uslot));
            st = st.emit(ir.op_if(0));
            // REUSE arm (box == d's box): release each OVERRIDDEN field's OLD
            // value before the store below overwrites it (or it leaks). Same
            // per-kind logic the pre-guard emitter applied unconditionally.
            var rj: i32 = 0;
            while (rj < fidxs.len()) {
                var rfty: string = decl_field_type(st.structs, slit.type_name, slit.field_names[rj]);
                if (inplace[rj]) {
                    // The field's own buffer grows in place (the box is unique,
                    // so nothing else reads it); a grow frees the superseded
                    // buffer itself (arr_push_owned), so there is no old value
                    // to release here.
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    st = lower_append_elem_value(own_field_append_arg(slit.field_values[rj]), st);
                    if (!st.ok) { return st; }
                    st = st.emit(ir.op_arr_push_owned());
                    st = st.emit(ir.op_store_local(tslots[rj]));
                } else if (is_leaksafe_array_field(rfty)) {
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (decl_is_struct(st.structs, rfty)) {
                    // Nested-struct override: FULL freeing drop of the OLD inner box
                    // (deep-drop its rc fields first when it owns any — each self-
                    // guarded on rc==1 — then free the inner box header). A
                    // `shallow` caller (an `own` base, whose override values are
                    // owned but may share the old value's children) releases the
                    // box only.
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    if (!shallow && struct_has_reclaim_array_field(st.structs, rfty)) {
                        st = st.emit(ir.op_call_direct("__struct_drop_" + rfty, 1));
                    }
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (is_enum_like_name(rfty, st.structs)) {
                    // ENUM override (#4356 divergence 1, self-overwrite family):
                    // flat rc-gated box dec of the OLD value — sentinel guard-
                    // skipped, sole-owned box frees (payloads leak, the exit
                    // sweep's safe-leak model), aliased box just decs. The base's
                    // enum values are fresh-ctor gated (donor_enum_fields_fresh),
                    // so the freed box can never be a still-live alias.
                    // "fn" overrides ALSO land here (enum-like spelling): the
                    // shallow dec IS the k_clo env-box release; the base's fn
                    // values are fresh-lambda gated (donor_enum_fields_fresh).
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (rfty == "string") {
                    // STRING override (#4356): rc-aware __fern_str_free of the
                    // OLD value; the base's string values are fresh-gated
                    // (donor_enum_fields_fresh), so never a live alias.
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    st = st.emit(ir.op_call_direct("__fern_str_free", 1));
                    st = st.emit(ir.op_drop());
                } else if (rfty == "string[]") {
                    // STRING[] override: DEEP rc-guarded __fern_str_arr_free of
                    // the OLD value (elements + buffer); the base's string[]
                    // values are element-fresh gated (donor_enum_fields_fresh),
                    // so never a live alias. `shallow`: the new value may be a
                    // clone of the old one sharing its elements uncounted
                    // (`names: a.names.append(x)`), so the buffer alone goes.
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    if (shallow) { st = st.emit(ir.op_call_direct("__fern_rc_dec", 1)); }
                    else { st = st.emit(ir.op_call_direct("__fern_str_arr_free", 1)); }
                    st = st.emit(ir.op_drop());
                } else if (is_struct_array_field_type(st.structs, rfty) || is_enum_array_field_type(st.structs, rfty)) {
                    // struct[]/enum[] override: per-element shallow free of the
                    // OLD value via __fern_arrarr_free; the base's values are
                    // element-fresh gated (donor_enum_fields_fresh), so never a
                    // live alias. `shallow`: buffer only, as for string[].
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(fidxs[rj], struct_field_width(st.structs, slit.type_name, fidxs[rj])));
                    if (shallow) { st = st.emit(ir.op_call_direct("__fern_rc_dec", 1)); }
                    else { st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1)); }
                    st = st.emit(ir.op_drop());
                }
                rj = rj + 1;
            }
            st = st.emit(ir.op_else());
            // The in-place overrides take the clone form here: d's box is shared,
            // so its buffer must stay as the alias reads it.
            var ipj: i32 = 0;
            while (ipj < fidxs.len()) {
                if (inplace[ipj]) {
                    st = lower_expr(slit.field_values[ipj], st);
                    if (!st.ok) { return st; }
                    st = st.emit(ir.op_store_local(tslots[ipj]));
                }
                ipj = ipj + 1;
            }
            // FRESH arm (d's box is SHARED; box is a new rc=1 block): the spread's
            // carried fields don't come along for free — copy the shape word and
            // every NON-overridden field from d's still-live box (the aliases hold
            // it), rc-inc'ing pointer-kinded copies (array / nested struct) so the
            // alias's eventual deep-drop and this box's own release stay balanced.
            // Then release d's reference: rc >= 2 here, so the dec never frees.
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_raw_load_ptr());
            st = st.emit(ir.op_raw_store_ptr());
            st = st.emit(ir.op_drop());
            var di: i32 = 0;
            while (di < nf) {
                var over: boolean = false;
                var oj: i32 = 0;
                while (oj < fidxs.len()) {
                    if (fidxs[oj] == di) { over = true; }
                    oj = oj + 1;
                }
                if (!over) {
                    var cfty: string = decl_field_type_at(st.structs, slit.type_name, di);
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_load_local(dslot));
                    st = st.emit(ir.op_struct_get(di, struct_field_width(st.structs, slit.type_name, di)));
                    if (is_leaksafe_array_field(cfty) || decl_is_struct(st.structs, cfty) || is_enum_like_name(cfty, st.structs) || cfty == "string" || cfty == "string[]" || is_struct_array_field_type(st.structs, cfty) || is_enum_array_field_type(st.structs, cfty)) {
                        st = st.emit(ir.op_call_direct("__fern_rc_inc", 1));
                    }
                    st = st.emit(ir.op_struct_set(di, struct_field_width(st.structs, slit.type_name, di)));
                }
                di = di + 1;
            }
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
            st = st.emit(ir.op_end());
            // 6. Store the override temps into the box (both branches).
            var wj: i32 = 0;
            while (wj < fidxs.len()) {
                st = st.emit(ir.op_load_local(bslot));
                st = st.emit(ir.op_load_local(tslots[wj]));
                if (struct_field_is_i64(st.structs, slit.type_name, fidxs[wj])) {
                    st = st.emit(ir.op_struct_set_i64(fidxs[wj]));
                } else {
                    st = st.emit(ir.op_struct_set(fidxs[wj], struct_field_width(st.structs, slit.type_name, fidxs[wj])));
                }
                wj = wj + 1;
            }
            // 7. Bind c to the result box and zero d's slot: on the reuse arm the
            //    exit sweep frees the box once (via c) and decs a null for d; on
            //    the fresh arm d's reference was released above and the aliases
            //    own the old box. (c stays an alias binding outside the
            //    reclaimable set — the same shallow-leak policy as the pre-guard
            //    path and the plain fresh construction.) A self-assign update has
            //    no separate d to zero — the single slot now holds the result box.
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_store_local(cslot));
            if (!self_assign) {
                st = st.emit(ir.op_const_i32(0));
                st = st.emit(ir.op_store_local(dslot));
            }
            return st;
        },
        _ => { return s.fail(); },
    }
}

// --- struct in-place reuse (FBIP): cross-statement full-construction pairing ---
//
// A SECOND reuse shape, complementing the functional-update self-overwrite above.
// Pair a FULL struct construction `var c = T { a:.., b:.., .. }` (NO `...base` —
// every field set explicitly) at statement k with the heap box of an EARLIER
// local d of the SAME type T that is provably DEAD by the time control reaches k.
// Instead of allocating a fresh box for c, REUSE d's box: release each overwritten
// array field's OLD value, write every field of c into d's box, bind c to d's box,
// and zero d's slot so the exit dec-sweep frees the box once (through c).
//
// The donor d must be:
//   - bound from a fresh `T { ... }` literal of the SAME type T (no base),
//   - never reassigned (not in body_assign_targets),
//   - never escaping anywhere in the body (a bare-ident mention is an escape;
//     `d.field` reads are fine) — so nothing else can alias the box,
//   - DEAD from statement k onward: NO textual mention of d (incl. `d.field`) in
//     statement k or any later statement (collect_idents_stmt). This single gate
//     also guarantees c's own field values (at index k) do not reference d, so
//     reading-while-writing is a non-issue.
// The construction c must be:
//   - a full `T { ... }` literal (no base), T struct_fields_reusable,
//   - NOT itself a self-overwrite reuse site (those are consumed by the path above),
//   - every leak-safe ARRAY field value a FRESH array literal (ExprArray) — the
//     reused box then owns the new array, mirroring the struct_make constraint.
//
// Determinism (the byte-identical fixpoint demands the pairing be a deterministic
// function of the AST): self-overwrite donors / sites are computed first and never
// reused here. Constructions are scanned in increasing index order; for each, the
// FIRST (nearest-from-the-front) eligible, not-yet-consumed donor at a strictly
// earlier index is chosen, and each donor is consumed at most once.

// CrossReuseSites: parallel arrays — for each cross-statement reuse site, the
// construction's body-statement index and the donor local name d whose box it
// reuses. A flat pair (not string[][]) for the self-host nested-array limitation.
struct CrossReuseSites { idxs: i32[], donors: string[], dtypes: string[] }

// stmt_is_full_struct_lit reports whether statement i is `var c = T { ... }` with
// a full (no-base) struct literal of a struct type, returning the bound name and
// type via out-params encoded as the literal itself; here we only need a boolean
// plus the type name, computed by callers re-matching the StmtVar.

// cross_construction_donor finds the donor name for a full-construction at index k
// given the already-computed self-overwrite reuse sites and the set of donors
// already consumed by earlier cross pairings. Returns "" if none is eligible.
function cross_construction_donor(body: ast.Stmt[], structs: parser.StructDecl[], k: i32, c_type: string, c_name: string, so_bases: string[], consumed: string[], fresh_ret: string[]): string {
    // The full-body assign-target and escape walks are body-invariant, but
    // whether any candidate needs them depends on the earlier cheap gates —
    // compute each AT MOST once per call, lazily. (Recomputing them per donor
    // candidate made whole-compiler emits quadratic in body size once string-
    // bearing structs became reuse-eligible, spiking the self-compile's peak
    // memory — the shard-OOM signature on the per-module modload test.)
    var tgts: string[] = [];
    var tgts_done: boolean = false;
    var allesc: string[] = [];
    var allesc_done: boolean = false;
    var sfx: string[] = [];
    var sfx_done: boolean = false;
    var i: i32 = 0;
    while (i < k) {
        match (body[i]) {
            ast.StmtVar(dv) => {
                var dname: string = dv.name;
                // donor must differ from c, be bound from a fresh full T{...}
                // literal OR a strict-fresh-returning call (donor_bind_type,
                // #4356 divergence 3) whose box is reuse-compatible with c's
                // type (same type, OR — cross-type — an all-scalar struct of
                // the same box class; structs_reuse_compatible), not a
                // self-overwrite donor, and not already consumed here.
                var elig: boolean = dname != c_name
                    && util.index_of_str(so_bases, dname) < 0
                    && util.index_of_str(consumed, dname) < 0;
                var dtype: string = "";
                if (elig) {
                    // donor_bind_type is an O(body) scan — run it only for
                    // candidates that pass the constant-time checks above.
                    dtype = donor_bind_type(body, dname, structs, fresh_ret);
                    elig = structs_reuse_compatible(structs, dtype, c_type);
                }
                if (elig) {
                    // never reassigned, never escapes anywhere in the body.
                    if (!tgts_done) { tgts = body_assign_targets(body); tgts_done = true; }
                    if (util.index_of_str(tgts, dname) >= 0) { elig = false; }
                }
                if (elig && struct_has_enum_field(structs, dtype)) {
                    // The DONOR's enum values must be fresh ctors for the reuse
                    // arm's flat dec of its old enum boxes to be alias-free
                    // (keyed on the donor type — with class pairing, #4356
                    // divergence 2, donor and recipient types may differ).
                    if (!donor_enum_fields_fresh(body, dname, structs)) { elig = false; }
                }
                if (elig) {
                    if (!allesc_done) { allesc = walk_stmts_escapes(body, []); allesc_done = true; }
                    if (util.index_of_str(allesc, dname) >= 0) { elig = false; }
                }
                if (elig) {
                    // dead from statement k onward: no mention (incl. d.field) at
                    // index >= k. Covers c's own field values referencing d too.
                    // The suffix ident set depends only on k (fixed per call) —
                    // collect it once, on the first candidate that reaches this
                    // gate, instead of re-collecting per statement per candidate.
                    if (!sfx_done) {
                        var m: i32 = k;
                        while (m < body.len()) { sfx = astwalk.collect_idents_stmt(body[m], sfx); m = m + 1; }
                        sfx_done = true;
                    }
                    if (util.index_of_str(sfx, dname) >= 0) { elig = false; }
                }
                if (elig) { return dname + "|" + dtype; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return "";
}

// own_param_reuse_sites finds function-body top-level full-construction reuse
// points whose donor is an `own` struct PARAMETER (#4356 divergence 3 — native's
// computeReuseSources admits any freeEligible dead-after donor; the self-host had
// only fresh-literal / strict-fresh-call LOCAL donors). An `own` param is moved
// in (sole-owned; the caller relinquished it — under move semantics it is dead at
// the call site), and a param is never exit-swept, so donating its box to a dead-
// after construction is sound and the runtime __fern_rc_is_unique gate in
// emit_cross_struct_reuse backstops it (a would-be-aliased box reads rc>=2 → fresh
// alloc). Donor and recipient are struct_fields_reusable_ownparam types; the
// recipient's field values are gated fresh (cross_recipient_fields_fresh) so
// the reused box solely owns each new one once the reuse arm releases the
// donor's old. Pairing rules mirror cross_construction_donor: donor differs from the
// recipient, box-class compatible (structs_reuse_compatible), never reassigned,
// never escaping, dead from the construction onward, each own param consumed at
// most once. A construction already owned by a self-overwrite / cross-local /
// enum-donor site is skipped (checked against `reuse`/`xreuse`/`edon`).
function own_param_reuse_sites(fn: parser.FuncDecl, structs: parser.StructDecl[], sfok: string[], reuse: ReuseSites, xreuse: CrossReuseSites, edon: EnumDonorSites): CrossReuseSites {
    var idxs: i32[] = [];
    var donors: string[] = [];
    var dtypes: string[] = [];
    // Own struct params that are all-scalar and never reassigned / never
    // escaping across the whole body — the donor candidate pool.
    var reassigned: string[] = body_assign_targets(fn.body);
    var allesc: string[] = walk_stmts_escapes(fn.body, []);
    var consumed: string[] = [];
    var k: i32 = 0;
    while (k < fn.body.len()) {
        // Skip statements already claimed by another struct-construction reuse site.
        var claimed: boolean = false;
        var ci: i32 = 0;
        while (ci < reuse.idxs.len()) { if (reuse.idxs[ci] == k) { claimed = true; } ci = ci + 1; }
        var cj: i32 = 0;
        while (cj < xreuse.idxs.len()) { if (xreuse.idxs[cj] == k) { claimed = true; } cj = cj + 1; }
        var cl: i32 = 0;
        while (cl < edon.idxs.len()) { if (edon.idxs[cl] == k) { claimed = true; } cl = cl + 1; }
        if (!claimed) {
            match (fn.body[k]) {
                ast.StmtVar(v) => {
                    match (v.init) {
                        ast.ExprStructLit(slit) => {
                            // Recipient must be a struct_fields_reusable_ownparam
                            // box (Map / tuple / Option are leak-only, released
                            // nowhere, so they need neither release nor gate). For
                            // the released kinds the reuse arm's old-field release
                            // is rc-GUARDED (__fern_rc_dec / __fern_str_free /
                            // __struct_drop free only at rc==1), so a sole-owned
                            // `own` param's counted fields release soundly with no
                            // donor-freshness gate — the predicate's header holds
                            // the argument.
                            if (!slit.has_base && struct_fields_reusable_ownparam(structs, sfok, slit.type_name)) {
                                // RECIPIENT freshness, the gate every cross family
                                // shares: each new field value is a fresh literal /
                                // variant ctor / fresh string producer, so the reused
                                // box solely owns it once the donor's old is released.
                                var ok: boolean = cross_recipient_fields_fresh(slit, structs);
                                // Suffix ident set from k onward — the donor must be
                                // dead here (covers c's own field values too).
                                var sfx: string[] = [];
                                var m: i32 = k;
                                while (m < fn.body.len()) { sfx = astwalk.collect_idents_stmt(fn.body[m], sfx); m = m + 1; }
                                // First eligible own param, in param order.
                                var pi: i32 = 0;
                                while (ok && pi < fn.params.len()) {
                                    var p: ast.ParamDecl = fn.params[pi];
                                    if (p.own
                                        && p.name != v.name
                                        && struct_fields_reusable_ownparam(structs, sfok, p.type_name)
                                        && structs_reuse_compatible(structs, p.type_name, slit.type_name)
                                        && util.index_of_str(consumed, p.name) < 0
                                        && util.index_of_str(reassigned, p.name) < 0
                                        && util.index_of_str(allesc, p.name) < 0
                                        && util.index_of_str(sfx, p.name) < 0) {
                                        idxs = idxs.append(k);
                                        donors = donors.append(p.name);
                                        dtypes = dtypes.append(p.type_name);
                                        consumed = consumed.append(p.name);
                                        pi = fn.params.len();
                                    } else {
                                        pi = pi + 1;
                                    }
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        }
        k = k + 1;
    }
    return CrossReuseSites { idxs: idxs, donors: donors, dtypes: dtypes };
}

// own_param_self_overwrite_sites finds function-body top-level FUNCTIONAL-UPDATE
// reuse points whose base is an `own` struct PARAMETER (#4356 slice 12 — the
// self-overwrite sibling of own_param_reuse_sites). `var c = T { ...own_d, f: v }`
// where own_d is a dead-after `own` param reuses own_d's box in place. Same
// soundness basis as the cross own-param donor: an `own` param is moved in / sole-
// owned and never exit-swept, and emit_self_overwrite_reuse's __fern_rc_is_unique
// guard backstops. Restricted to struct_fields_reusable_ownparam (its header
// holds the argument for the enum / string old-value releases), so no
// donor-side freshness gate is required. The override / carried gates mirror
// self_overwrite_reuse_sites exactly: same-type base, override values fresh
// (cross_recipient_fields_fresh), no override value references d, d dead after
// the statement, never reassigned, and escaping nowhere but the update base
// here. A statement already claimed by a self-overwrite-local / cross-local /
// cross-own-param / enum-donor site is skipped.
function own_param_self_overwrite_sites(fn: parser.FuncDecl, structs: parser.StructDecl[], sfok: string[], reuse: ReuseSites, xreuse: CrossReuseSites, ownxr: CrossReuseSites, edon: EnumDonorSites): ReuseSites {
    var idxs: i32[] = [];
    var bases: string[] = [];
    var reassigned: string[] = body_assign_targets(fn.body);
    var i: i32 = 0;
    while (i < fn.body.len()) {
        // Skip statements already claimed by another reuse site.
        var claimed: boolean = false;
        var ci: i32 = 0;
        while (ci < reuse.idxs.len()) { if (reuse.idxs[ci] == i) { claimed = true; } ci = ci + 1; }
        var cj: i32 = 0;
        while (cj < xreuse.idxs.len()) { if (xreuse.idxs[cj] == i) { claimed = true; } cj = cj + 1; }
        var co: i32 = 0;
        while (co < ownxr.idxs.len()) { if (ownxr.idxs[co] == i) { claimed = true; } co = co + 1; }
        var cl: i32 = 0;
        while (cl < edon.idxs.len()) { if (edon.idxs[cl] == i) { claimed = true; } cl = cl + 1; }
        if (!claimed) {
            match (fn.body[i]) {
                ast.StmtVar(v) => {
                    match (v.init) {
                        ast.ExprStructLit(slit) => {
                            if (slit.has_base) {
                                match (slit.base) {
                                    ast.ExprIdent(bid) => {
                                        // Base must be an `own` struct param of the SAME
                                        // type T, T being scalar/array/nested-reusable.
                                        var is_own_p: boolean = false;
                                        var pi: i32 = 0;
                                        while (pi < fn.params.len()) {
                                            var p: ast.ParamDecl = fn.params[pi];
                                            if (p.name == bid.name && p.own && p.type_name == slit.type_name) { is_own_p = true; }
                                            pi = pi + 1;
                                        }
                                        var ok: boolean = is_own_p
                                            && struct_fields_reusable_ownparam(structs, sfok, slit.type_name)
                                            && v.name != bid.name
                                            && util.index_of_str(reassigned, bid.name) < 0
                                            && !name_escapes_outside_stmt(fn.body, bid.name, i);
                                        // No override value may reference d.
                                        if (ok) {
                                            var fj: i32 = 0;
                                            while (fj < slit.field_values.len()) {
                                                var none: string[] = [];
                                                if (util.index_of_str(astwalk.collect_idents_expr(slit.field_values[fj], none), bid.name) >= 0) { ok = false; }
                                                fj = fj + 1;
                                            }
                                        }
                                        // Every override value must be fresh — the gate
                                        // every cross family shares — so the reused box
                                        // solely owns the new value once the old is released.
                                        if (ok && !cross_recipient_fields_fresh(slit, structs)) { ok = false; }
                                        // d dead after this statement.
                                        if (ok) {
                                            var k: i32 = i + 1;
                                            while (k < fn.body.len()) {
                                                var none2: string[] = [];
                                                if (util.index_of_str(astwalk.collect_idents_stmt(fn.body[k], none2), bid.name) >= 0) { ok = false; }
                                                k = k + 1;
                                            }
                                        }
                                        if (ok) {
                                            idxs = idxs.append(i);
                                            bases = bases.append(bid.name);
                                        }
                                    },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        }
        i = i + 1;
    }
    return ReuseSites { idxs: idxs, bases: bases };
}

// cross_reuse_sites computes the cross-statement full-construction reuse points.
// It first computes the self-overwrite sites (so it never consumes a donor or a
// construction those already own), then scans full no-base constructions of a
// reusable struct type in index order, pairing each with the nearest eligible
// earlier dead donor of the same type. Each donor is consumed at most once.
function cross_reuse_sites(body: ast.Stmt[], structs: parser.StructDecl[], fresh_ret: string[]): CrossReuseSites {
    var so: ReuseSites = self_overwrite_reuse_sites(body, structs, fresh_ret);
    var idxs: i32[] = [];
    var donors: string[] = [];
    var dtypes: string[] = [];
    var k: i32 = 0;
    while (k < body.len()) {
        // skip a statement that is itself a self-overwrite reuse site.
        var is_so: boolean = false;
        var si: i32 = 0;
        while (si < so.idxs.len()) { if (so.idxs[si] == k) { is_so = true; } si = si + 1; }
        if (!is_so) {
            match (body[k]) {
                ast.StmtVar(v) => {
                    match (v.init) {
                        ast.ExprStructLit(slit) => {
                            if (reuse_recipient_ok(slit, structs)) {
                                var donor: string = cross_construction_donor(body, structs, k, slit.type_name, v.name, so.bases, donors, fresh_ret);
                                if (donor.len() > 0) {
                                    var dbar: i32 = 0;
                                    while (dbar < donor.len() && donor[dbar] != b'|') { dbar = dbar + 1; }
                                    idxs = idxs.append(k);
                                    donors = donors.append(slice_unchecked(donor, 0, dbar));
                                    dtypes = dtypes.append(slice_unchecked(donor, dbar + 1, donor.len()));
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        }
        k = k + 1;
    }
    return CrossReuseSites { idxs: idxs, donors: donors, dtypes: dtypes };
}

// emit_cross_struct_reuse lowers a full `var c = T { ... }` construction as an
// emit_reuse_recip_prior_release releases the recipient slot's PRIOR box before it
// is overwritten with the donor's box, so a LOOP-BODY reuse frees the previous
// iteration's carried box instead of leaking it (the recipient slot is loop-carried
// — re-used across iterations at runtime). Cow-guarded (old != donor box) and
// __fern_rc_dec null-guards, so at function-body top level — where the recipient
// slot is freshly zeroed and this is not emitted — it would be a harmless null dec;
// it is emitted ONLY on the loop-body path (release_prior). Mirrors emit_arr_store's
// prior-value release (the mechanism a normal loop-rebind binding already uses).
//
// A shallow box dec is the whole release only when the box owns nothing, which is
// the fifth site on the #7275 enumeration: a loop-carried recipient tuple carrying
// a fresh array literal strands one buffer AND one box per iteration. Whatever the
// prior box owns therefore goes back first (emit_tup_box_child_releases — nothing
// at all for a struct recipient, the other caller).
function emit_reuse_recip_prior_release(s: LowerState, cslot: i32, dslot: i32): LowerState {
    var st: LowerState = s.emit(ir.op_load_local(cslot));   // OLD box the recipient holds
    st = st.emit(ir.op_load_local(dslot));                  // the donor box about to be stored
    st = st.emit(ir.op_bin("ne", 0, false));                // old != donor (cow guard)
    st = st.emit(ir.op_if(0));
    st = emit_tup_box_child_releases(st, cslot);
    st = st.emit(ir.op_load_local(cslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    return st;
}

// RUNTIME-GUARDED in-place reuse of donor d's (dead) box (#4350 slice 2; the
// site found by cross_reuse_sites; the emit_self_overwrite_reuse token shape).
// `c_name` is the new local; `init` the full no-base struct literal;
// `donor_name` is d. reused = __fern_rc_is_unique(d); box =
// __fern_alloc_reuse(reused ? d : 0, nfields+1 slots). The reuse arm releases each
// pointer-kinded OLD field (c overwrites every field, so the donor's old
// values would otherwise leak); the fresh arm copies the shape word from d's
// still-live box and decs d's reference (a future escape-walk hole thereby
// degrades instead of corrupting). Every field of c is then written into the
// result box (in decl order), c is bound to it, and d's slot is ZEROED so the
// exit sweep frees the reused box exactly once (via c) and harmlessly decs a
// null for d. When `release_prior` (the loop-body path), the recipient's
// prior loop-carried box is released before any of this
// (emit_reuse_recip_prior_release).
function emit_cross_struct_reuse(c_name: string, c_site: string, init: ast.Expr, donor_name: string, donor_type: string, release_prior: boolean, s: LowerState): LowerState {
    var dslot: i32 = s.slot_of(donor_name);
    if (dslot < 0) { return s.fail(); }
    match (init) {
        ast.ExprStructLit(slit) => {
            var st: LowerState = s;
            var ndecl: i32 = decl_field_count(st.structs, slit.type_name);
            // Bind c's slot up front — both guard arms store the result box there.
            // The binding-SITE key goes on before anything reads a class credit off
            // the slot (#7253): this path binds the recipient itself rather than
            // going through bind_var_slot, and a siteless slot resolves no credit —
            // silently, as a leak. The same gap #7272 hit on the tuple sibling.
            st = st.add_local(c_name);
            var cslot: i32 = st.slot_of(c_name);
            if (c_site.len() > 0) { st = st.mark_reclaim_site(cslot, c_site); }
            st = st.mark_struct_type(cslot, slit.type_name);
            // Loop body: free the recipient's prior (previous-iteration) box first —
            // only when the recipient is a RECLAIMABLE (non-escaping) local (an
            // escaping recipient's box is owned by the container it moved into; a
            // prior-release would be a UAF). Runs before the guard: it reads only
            // c's old slot + d's slot, both still untouched.
            if (release_prior && slot_is_reclaimable_struct(st, cslot)) { st = emit_reuse_recip_prior_release(st, cslot, dslot); }
            // Runtime uniqueness guard (#4350 slice 2, the emit_self_overwrite_reuse
            // token shape): the static walk proves d is sole-owner and DEAD here
            // (cross_reuse_sites), so no field value below can reference d — the
            // guard exists so a future hole in the walk degrades (fresh box)
            // instead of corrupting (in-place write over a shared box).
            var uname: string = "$sxr_uniq" + util.i32_to_string(dslot);
            st = st.add_local(uname);
            var uslot: i32 = st.slot_of(uname);
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
            st = st.emit(ir.op_store_local(uslot));
            var kname: string = "$sxr_tok" + util.i32_to_string(dslot);
            st = st.add_local(kname);
            var kslot: i32 = st.slot_of(kname);
            st = st.emit(ir.op_load_local(uslot));
            st = st.emit(ir.op_if(0));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_else());
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_end());
            var bname: string = "$sxr_box" + util.i32_to_string(dslot);
            st = st.add_local(bname);
            var bslot: i32 = st.slot_of(bname);
            st = st.emit(ir.op_load_local(kslot));
            st = st.emit(ir.op_const_i32(ndecl + 1));
            st = st.emit(ir.op_call_direct("__fern_alloc_reuse", 2));
            st = st.emit(ir.op_store_local(bslot));
            // Branch-specific box preparation. REUSE arm (box == d's box): release
            // each pointer-kinded OLD field before the full overwrite below (or it
            // leaks) — the same per-kind logic the pre-guard emitter interleaved.
            // FRESH arm (d's box is SHARED; box is a new rc=1 block): copy the
            // shape word from d's still-live box, then release d's reference
            // (rc >= 2 here, so the dec never frees). Every field is written
            // below, so no carried-field copies exist in this family.
            st = st.emit(ir.op_load_local(uslot));
            st = st.emit(ir.op_if(0));
            // The release walks the DONOR's OWN field types at the donor's
            // slots (#4356 divergence 2): with class pairing the donor's
            // layout may differ from the recipient's, and the old values in
            // the box are the donor's. Slot count is identical (same class).
            var nrel: i32 = decl_field_count(st.structs, donor_type);
            var ri: i32 = 0;
            while (ri < nrel) {
                var rty: string = decl_field_type_at(st.structs, donor_type, ri);
                if (is_leaksafe_array_field(rty)) {
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(ri, struct_field_width(st.structs, donor_type, ri)));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (decl_is_struct(st.structs, rty)) {
                    // Nested-struct pointer field: FULL freeing drop of the OLD
                    // inner box (deep-drop its rc fields first when it owns any —
                    // each self-guarded on rc==1 — then free the inner box header).
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(ri, struct_field_width(st.structs, donor_type, ri)));
                    if (struct_has_reclaim_array_field(st.structs, rty)) {
                        st = st.emit(ir.op_call_direct("__struct_drop_" + rty, 1));
                    }
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (is_enum_like_name(rty, st.structs)) {
                    // ENUM field (#4356 divergence 1): flat rc-gated box dec of
                    // the OLD value — a payloadless sentinel is guard-skipped, a
                    // sole-owned box frees (payloads leak, the exit sweep's
                    // safe-leak model for enum slots), an aliased box just decs.
                    // Admission gates both sides' enum values to fresh variant
                    // ctors (donor_enum_fields_fresh / the recipient walk), so
                    // the freed box can never be a still-live alias.
                    // "fn" fields ALSO land here (the coarse spelling reads as
                    // enum-like) — the same shallow rc-guarded dec IS the k_clo
                    // env-box release (captures leak), and the admission walks
                    // gate both sides' values to fresh lambdas / __mkclo$ boxes.
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(ri, struct_field_width(st.structs, donor_type, ri)));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                } else if (rty == "string") {
                    // STRING field (#4356 divergence 1): rc-aware __fern_str_free
                    // of the OLD value (box + heap data buffer; .rodata literal
                    // data heap-guard-skipped; shared boxes just dec). Both
                    // sides' string values are fresh-gated, so this can never
                    // free a still-live alias.
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(ri, struct_field_width(st.structs, donor_type, ri)));
                    st = st.emit(ir.op_call_direct("__fern_str_free", 1));
                    st = st.emit(ir.op_drop());
                } else if (rty == "string[]") {
                    // STRING[] field (rc-element arrays): DEEP rc-guarded
                    // __fern_str_arr_free of the OLD value (element boxes +
                    // buffer at rc==1; a shared buffer just decs). Both sides'
                    // values are gated element-fresh array literals
                    // (donor_enum_fields_fresh / cross_recipient_fields_fresh),
                    // so the freed elements can never be live aliases. wasm maps
                    // the helper to $__fern_arr_dec_ptr (same deep shape).
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(ri, struct_field_width(st.structs, donor_type, ri)));
                    st = st.emit(ir.op_call_direct("__fern_str_arr_free", 1));
                    st = st.emit(ir.op_drop());
                } else if (is_struct_array_field_type(st.structs, rty) || is_enum_array_field_type(st.structs, rty)) {
                    // struct[] / enum[] field: per-element shallow free of the
                    // OLD value via __fern_arrarr_free (each element box a
                    // rc-guarded arr_dec, then the buffer). Admission keeps
                    // struct[] elements scalar-fielded (nothing under the box
                    // to leak) and both sides element-fresh
                    // (boxarr_lit_all_elems_fresh), so no freed box can be a
                    // live alias; an enum element's payload stays on the
                    // k_enum shallow-leak model. wasm maps the helper to
                    // $__fern_arr_dec_ptr (same shape).
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_get(ri, struct_field_width(st.structs, donor_type, ri)));
                    st = st.emit(ir.op_call_direct("__fern_arrarr_free", 1));
                    st = st.emit(ir.op_drop());
                }
                ri = ri + 1;
            }
            st = st.emit(ir.op_else());
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_raw_load_ptr());
            st = st.emit(ir.op_raw_store_ptr());
            st = st.emit(ir.op_drop());
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
            st = st.emit(ir.op_end());
            // Write every decl field of T into the result box, in decl order (a
            // full construction sets all fields; cross_reuse_sites guarantees no
            // value references d).
            var di: i32 = 0;
            while (di < ndecl) {
                var jj: i32 = 0;
                var found: i32 = 0 - 1;
                while (jj < slit.field_names.len()) {
                    if (st.field_index_in(slit.type_name, slit.field_names[jj]) == di) { found = jj; }
                    jj = jj + 1;
                }
                if (found < 0) { return st.fail(); }
                if (struct_field_is_i64(st.structs, slit.type_name, di)) {
                    st = st.emit(ir.op_load_local(bslot));
                    st = lower_i64(slit.field_values[found], st);
                    if (!st.ok) { return st; }
                    st = st.emit(ir.op_struct_set_i64(di));
                } else {
                    st = st.emit(ir.op_load_local(bslot));
                    st = lower_expr(slit.field_values[found], st);
                    if (!st.ok) { return st; }
                    st = st.emit(ir.op_struct_set(di, struct_field_width(st.structs, slit.type_name, di)));
                }
                di = di + 1;
            }
            // Bind c to the result box and zero d's slot: on the reuse arm the
            // exit sweep frees the box once (via c) and decs a null for d; on the
            // fresh arm d's reference was released above and the aliases own the
            // old box.
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_store_local(cslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(dslot));
            return st;
        },
        _ => { return s.fail(); },
    }
}

// --- tuple cross-reuse (FBIP): a dead tuple box reused for a later tuple ctor ---
//
// The tuple analogue of emit_cross_struct_reuse — the delta that closes native's
// `general_reuse_tuple` parity (tuples were previously never reuse/donor targets).
// A `var c = (…)` tuple construction reuses an earlier dead donor tuple local d's
// box in place instead of allocating a fresh one. SIMPLER than the struct case:
// tuples are leak-mode (their element boxes are never reclaimed by the exit
// sweep), so d's OLD element values need NO release before the overwrite — they
// would leak whether reused or not, so no NEW leak and no UAF. The box is
// rc-headered (op_tuple_make → __fern_arr_box), so zeroing d's slot leaves the
// single exit dec (via c) to free it once. Element coverage matches the tuple
// CONSTRUCTOR (tuple_lit_ctor_eligible / op_tuple_make_k): i32 / i64 / f64
// scalars plus leak-mode pointer elements (string / struct / array / Option /
// nested tuple / Result / Map / enum), each written at its width via
// op_tuple_set / _w (i64.store / f64.store / i32.store on wasm; a uniform 8-byte
// movq / str on the register backends).

struct CrossTupleReuseSites { idxs: i32[], donors: string[] }

// fresh_tuple_lit_arity returns the element count of the tuple a name was bound
// from when its init is a direct tuple literal `(…)`, else -1 (the tuple analogue
// of fresh_struct_lit_type).
function fresh_tuple_lit_arity(body: ast.Stmt[], name: string): i32 {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprTuple(tl) => { return tl.elements.len(); },
                        _ => { return 0 - 1; },
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return 0 - 1;
}

// cross_tuple_construction_donor mirrors cross_construction_donor for tuples: the
// nearest earlier fresh SAME-ARITY tuple local that isn't the recipient, isn't
// reassigned, never escapes, is dead from k onward, and isn't already consumed.
// Arity match alone suffices for box reuse (the box is `arity` uniform 8-byte
// slots; d's original element TYPES are overwritten by c's, so are irrelevant).
function cross_tuple_construction_donor(body: ast.Stmt[], k: i32, arity: i32, c_name: string, consumed: string[]): string {
    // Same lazy at-most-once hoist of the body-invariant walks as
    // cross_construction_donor (they were per-candidate — quadratic).
    var tgts: string[] = [];
    var tgts_done: boolean = false;
    var allesc: string[] = [];
    var allesc_done: boolean = false;
    var sfx: string[] = [];
    var sfx_done: boolean = false;
    var i: i32 = 0;
    while (i < k) {
        match (body[i]) {
            ast.StmtVar(dv) => {
                var dname: string = dv.name;
                var elig: boolean = dname != c_name
                    && fresh_tuple_lit_arity(body, dname) == arity
                    && util.index_of_str(consumed, dname) < 0;
                if (elig) {
                    if (!tgts_done) { tgts = body_assign_targets(body); tgts_done = true; }
                    if (util.index_of_str(tgts, dname) >= 0) { elig = false; }
                }
                if (elig) {
                    if (!allesc_done) { allesc = walk_stmts_escapes(body, []); allesc_done = true; }
                    if (util.index_of_str(allesc, dname) >= 0) { elig = false; }
                }
                if (elig) {
                    // Suffix idents depend only on k — collect once per call.
                    if (!sfx_done) {
                        var m: i32 = k;
                        while (m < body.len()) { sfx = astwalk.collect_idents_stmt(body[m], sfx); m = m + 1; }
                        sfx_done = true;
                    }
                    if (util.index_of_str(sfx, dname) >= 0) { elig = false; }
                }
                if (elig) { return dname; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return "";
}

// cross_tuple_reuse_sites pairs each `var c = (…)` tuple construction with an
// earlier dead same-arity donor tuple. STRUCTURAL only (arity + donor liveness);
// the constructor-element eligibility (tuple_lit_ctor_eligible) is checked at the
// dispatch, where the lowering state is available, and falls back to normal
// lowering if not met. Each donor is consumed at most once.
function cross_tuple_reuse_sites(body: ast.Stmt[]): CrossTupleReuseSites {
    var idxs: i32[] = [];
    var donors: string[] = [];
    var k: i32 = 0;
    while (k < body.len()) {
        match (body[k]) {
            ast.StmtVar(v) => {
                match (v.init) {
                    ast.ExprTuple(tl) => {
                        var donor: string = cross_tuple_construction_donor(body, k, tl.elements.len(), v.name, donors);
                        if (donor.len() > 0) {
                            idxs = idxs.append(k);
                            donors = donors.append(donor);
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        k = k + 1;
    }
    return CrossTupleReuseSites { idxs: idxs, donors: donors };
}

// tuple_elem_ctor_eligible reports whether a tuple element (already IIFE-leaf-
// resolved) is admissible in a tuple constructor / reuse: a scalar (i32 / i64 /
// f64 / u32 / u64 / bool), string, struct, i32[] / typed-array pointer, Option,
// nested tuple, Result, Map, or nominal-enum — each a single leak-mode 8-byte
// slot. Shared by the op_tuple_make_k construction path and the tuple cross-reuse
// eligibility so the admitted element set never drifts between the two.
function tuple_elem_ctor_eligible(el: ast.Expr, s: LowerState): boolean {
    // i32[] (but not string[]/f64[]/i64[], which are the typed-array case below).
    var el_arr_ok: boolean = expr_is_arr_src(el, s)
        && !expr_is_strarr(el, s) && !expr_is_f64arr(el, s) && !expr_is_i64arr(el, s);
    // string[]/f64[]/i64[]: a heap POINTER in one slot; its element-typed tag lets
    // `t.N[i]` read at the right type/width.
    var el_typedarr_ok: boolean = expr_is_strarr(el, s) || expr_is_f64arr(el, s) || expr_is_i64arr(el, s);
    var el_opt_ok: boolean = expr_opt_elem_tag(el, s) != "";       // Option (leak-only box, one slot)
    var el_tuple_ok: boolean = expr_is_tuple(el, s);               // nested tuple (heap-tuple pointer)
    var el_result_ok: boolean = expr_is_result(el, s);            // Result (leak-only box)
    var el_map_ok: boolean = expr_map_type_tag(el, s) != "";       // Map (leak-only heap box)
    var el_enum_ok: boolean = expr_enum_type(el, s) != "";        // nominal enum (leak-only box)
    // A closure-box element (a `__mkclo$…` env-box constructor / a call to a
    // closure-returning fn / a closure-local ident — elem_type_tag's "clo"):
    // a leak-only heap box in one pointer slot, like a struct element.
    var el_clo_ok: boolean = elem_type_tag(el, s) == "clo";
    // A `cell_new(v)` element: a cell IS a one-element array box, so it rides
    // one pointer slot exactly as the array cases above do. A cell LOCAL was
    // already admitted through el_arr_ok / el_typedarr_ok (its slot is marked
    // is_arr), so only the direct constructor call was left bailing the whole
    // module — the difference being nothing but whether the cell was named
    // first.
    var el_cell_ok: boolean = cell_new_elem_tag(el, s) != "";
    // A CALL element with a statically-known SCALAR result:
    // (a) a free-fn call whose callee is in no NONSCALAR-return registry — its
    //     result is one scalar slot, i32-class (`(add(1,2), 4)`) or WIDE
    //     (`(big(2), 1)` with `big: i64` / `f64`);
    // (b) a closure-LOCAL call (`(f(3), 1)` with f a closure local);
    // (c) a closure tuple-element call (`(t.0(3), t.1)` — the callee is a
    //     numeric field access whose element is tagged "clo", dispatched
    //     env-first with an i32 result).
    // One scalar slot either way, and elem_type_tag already classifies the
    // width — "i64" via infer_expr_width, "f64" via expr_is_f64, else the
    // "i32" fallthrough — so the kind string drives the store width and the
    // construction loop routes an i64 element through lower_i64. A wide-
    // returning callee was excluded here while a wide LOCAL or wide
    // ARITHMETIC element was already admitted, which made only the call form
    // bail the whole module (#5902). An UNKNOWN or
    // nonscalar-returning callee stays ineligible (its result would mistype
    // the enc) — struct-returning calls pass via the expr_struct_type gate,
    // and f64[]/i64[]-returning ones via el_typedarr_ok.
    var el_call_ok: boolean = false;
    match (el) {
        ast.ExprCall(scc) => {
            match (scc.callee) {
                ast.ExprIdent(sccid) => {
                    if (s.is_closure_local(sccid.name)) { el_call_ok = true; }
                    else if (s.is_user_fn(sccid.name)
                        && !s.is_str_ret_fn(sccid.name) && !s.is_arr_ret_fn(sccid.name)
                        && !s.is_strarr_ret_fn(sccid.name)
                        && !s.is_f64arr_ret_fn(sccid.name) && !s.is_i64arr_ret_fn(sccid.name)
                        && s.opt_ret_type(sccid.name) == "" && s.tuple_ret_type(sccid.name) == ""
                        && s.map_ret_type(sccid.name) == ""
                        && util.index_of_str(s.sigs.closure_fns, sccid.name) < 0
                        && !s.is_closurearr_ret_fn(sccid.name)) { el_call_ok = true; }
                },
                ast.ExprFieldAccess(sccfa) => {
                    if (util.is_all_digits(sccfa.field) && expr_tuple_elem_tag(sccfa.obj, util.digits_to_i32(sccfa.field), s) == "clo") { el_call_ok = true; }
                    else {
                        // (d) a METHOD call whose result is provably one scalar
                        // slot — iife_method_ret_i32 is sound by EXCLUSION (a
                        // method registered as returning a string / array /
                        // tuple / struct / Option is rejected), and its wide
                        // sibling names an i64 / f64 result. Only the free-fn
                        // form was admitted, so `(p.sum(), 165i64)` bailed the
                        // whole module while `(f(6), 165i64)` lowered — the
                        // difference being nothing but how the callee is
                        // spelled.
                        var mrty: string = expr_struct_type(sccfa.obj, s);
                        if (mrty.len() > 0
                                && (iife_method_ret_i32(mrty, sccfa.field, s)
                                    || iife_method_ret_kind(mrty, sccfa.field, s).len() > 0)) { el_call_ok = true; }
                        // (e) `.len()` on a STRING or ARRAY receiver. The
                        // registry lookup above is keyed on a struct / enum type
                        // name, so it cannot answer for a builtin receiver — but
                        // a length is an i32 whatever it is measuring.
                        else if (sccfa.field == "len" && scc.args.len() == 0
                                && (expr_is_str(sccfa.obj, s) || expr_is_arr_src(sccfa.obj, s)
                                    || expr_is_strarr(sccfa.obj, s) || expr_is_f64arr(sccfa.obj, s)
                                    || expr_is_i64arr(sccfa.obj, s))) { el_call_ok = true; }
                        // (f) a MAP read method — the other builtin receiver the
                        // registry cannot answer for. Admitted exactly when
                        // map_method_elem_tag names the result kind, so the slot
                        // is never stored at a width the tag does not carry.
                        // `m.len()` at a tuple element bailed the whole function
                        // while `xs.len()` lowered, the difference being nothing
                        // but the receiver's type; `iter` stays out, its MapIter
                        // box holding a raw pointer into the mapbox. #7213.
                        else if (map_method_elem_tag(el, s) != "") { el_call_ok = true; }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    if (expr_is_nonscalar(el, s) && !expr_is_str(el, s) && expr_struct_type(el, s) == "" && !el_arr_ok && !el_typedarr_ok && !el_opt_ok && !el_tuple_ok && !el_result_ok && !el_map_ok && !el_enum_ok && !el_clo_ok && !el_call_ok && !el_cell_ok) { return false; }
    return true;
}

// tuple_lit_ctor_eligible reports whether every element of tuple literal `tup` is
// admissible for reuse — the SAME set op_tuple_make_k accepts for a fresh
// construction, so a recipient that would build as a normal tuple box can instead
// overwrite a same-arity dead donor's box (uniform 8-byte slots, leak-mode ⇒ no
// old-element release, regardless of the donor's original element types).
function tuple_lit_ctor_eligible(tup: ast.ExprTuple, s: LowerState): boolean {
    if (tup.elements.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < tup.elements.len()) {
        if (!tuple_elem_ctor_eligible(iife_leaf_value(tup.elements[i]), s)) { return false; }
        i = i + 1;
    }
    return true;
}

// emit_tup_box_child_releases gives back everything the tuple box in `slot` owns,
// leaving the box itself alone — for a site that FREES or RECYCLES that box and
// so owes its children (#7275). Two disjoint classes, and reclaimable_names_of
// puts a tuple local in at most one:
//
//   "TUP:"    the per-position retains a bare-ident element took at construction
//             (#7226), replayed from the slot's recorded kinds — the same list
//             the exit sweep, the rebind store and the precise drop replay.
//   "TUPRCS:" the fresh rc literals the scope-exit deep free would have released
//             (emit_rctuple_deep_free), minus its box dec.
//
// Emits nothing for a slot in neither, so a struct recipient (the other caller
// of emit_reuse_recip_prior_release) is byte-identical to before. Null-guarded
// on both limbs: __fern_rc_dec tolerates a zeroed slot but the op_tuple_get and
// the type-driven drop that reach the children DEREFERENCE the box, and a
// loop-carried slot holds its entry zero on the first pass.
function emit_tup_box_child_releases(se: LowerState, slot: i32): LowerState {
    var st: LowerState = emit_tup_elem_releases(se, slot, se.tup_elem_kinds_of(slot));
    if (slot_is_reclaimable_rctuple_sweep(st, slot)) {
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_const_i32(0));
        st = st.emit(ir.op_bin("ne", 0, false));     // slot != 0 (null guard)
        st = st.emit(ir.op_if(0));
        var rtp: i32[] = [];
        st = emit_tuple_type_child_drops(st, slot, rtp, "(" + st.locals[slot].tuple_elems + ")");
        st = st.emit(ir.op_end());
    }
    return st;
}

// emit_cross_tuple_reuse lowers `var c = (…)` as a RUNTIME-GUARDED in-place
// reuse of dead donor d's tuple box (#4350 slice 3; the token shape shared
// with the struct families): reused = __fern_rc_is_unique(d); box =
// __fern_alloc_reuse(reused ? d : 0, arity); each element slot of the result
// box is overwritten at its element WIDTH, c binds to the box (tagged via
// mark_tuple_elems from c_type, the recipient's declared tuple type, or from the
// element expressions when it has none), and d's slot is zeroed so the exit
// sweep frees the box once (via c). A shared donor degrades to a fresh box + a
// dec of d's reference instead of corrupting.
function emit_cross_tuple_reuse(c_name: string, c_type: string, c_site: string, init: ast.Expr, donor_name: string, release_prior: boolean, s: LowerState): LowerState {
    var dslot: i32 = s.slot_of(donor_name);
    if (dslot < 0) { return s.fail(); }
    match (init) {
        ast.ExprTuple(tup) => {
            var st: LowerState = s;
            var n: i32 = tup.elements.len();
            // c's slot tags (the mark_tuple_elems encoding), computed up front.
            // Prefer the DECLARED tuple type, exactly as bind_var_slot's ExprTuple
            // arm does — elem_type_tag coarsens a scalar-array element to the bare
            // "i32", so an inferred tag left `(i32, i32[])` recorded as "i32,i32"
            // and the scope-exit deep free (emit_rctuple_deep_free, type-driven via
            // emit_tuple_type_child_drops) then found no array child to release:
            // the recipient's own fresh array literal stranded, at its buffer's
            // size (#7275). The write loop below recomputes its WIDTH tag from the
            // element expression and is deliberately unaffected.
            var enc: string = "";
            var pe: i32 = 0;
            var c_annot: boolean = util.is_tuple_type_name(c_type);
            while (pe < n) {
                var ptek: string = "";
                if (c_annot) { ptek = tuple_type_elem_tag(c_type, pe); }
                if (ptek.len() == 0) { ptek = elem_type_tag(iife_leaf_value(tup.elements[pe]), st); }
                if (pe > 0) { enc = enc + ","; }
                enc = enc + ptek;
                pe = pe + 1;
            }
            // Bind c's slot up front — both guard arms store the result box there.
            // The binding-SITE key goes on before anything reads a class credit off
            // the slot (#7272): this path binds the recipient itself rather than
            // going through bind_var_slot, and a siteless slot resolves no credit.
            st = st.add_local(c_name);
            var cslot: i32 = st.slot_of(c_name);
            st = st.mark_reclaim_site(cslot, c_site);
            st = st.mark_tuple_elems(cslot, enc);
            // Loop body: free the recipient's prior (previous-iteration) box first —
            // only when the recipient is a RECLAIMABLE (non-escaping) tuple local
            // (an escaping recipient's box is owned by its container; a prior-
            // release would be a UAF).
            // A "TUPRCS:" recipient is loop-carried just as a "TUP:" one is, and its
            // prior box is equally dead — the narrower gate left the box itself
            // unreleased as well as its children (#7275).
            if (release_prior && (slot_is_reclaimable_tuple(st, cslot) || slot_is_reclaimable_rctuple_sweep(st, cslot))) { st = emit_reuse_recip_prior_release(st, cslot, dslot); }
            // Runtime uniqueness guard (#4350 slice 3, the token shape shared with
            // the struct families): reused = __fern_rc_is_unique(d); box =
            // __fern_alloc_reuse(reused ? d : 0, arity) — a tuple box has NO shape
            // word (elements at i*8, arr_box cap = arity = its slots), so the
            // fresh arm needs no slot-0 copy.
            //
            // What the donor's box OWNS is given back on the REUSE arm only, and
            // that asymmetry is the whole difficulty of the site (#7275). On the
            // reuse arm the box is recycled and its references die with it, so the
            // release is owed there. On the fresh arm the box survives under its
            // other owners — rc >= 2, so the dec of d's own reference never frees
            // it — and releasing its children would free what those owners still
            // read. The release therefore sits INSIDE the uniqueness test, not
            // before it, which is what separates this site from the sweep /
            // rebind-store / precise-drop three (emit_tup_box_child_releases).
            var uname: string = "$sxt_uniq" + util.i32_to_string(dslot);
            st = st.add_local(uname);
            var uslot: i32 = st.slot_of(uname);
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
            st = st.emit(ir.op_store_local(uslot));
            var kname: string = "$sxt_tok" + util.i32_to_string(dslot);
            st = st.add_local(kname);
            var kslot: i32 = st.slot_of(kname);
            st = st.emit(ir.op_load_local(uslot));
            st = st.emit(ir.op_if(0));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_store_local(kslot));
            // Reuse arm: the recycled box's children are dead. Released before
            // __fern_alloc_reuse repurposes the slots, while the reads are valid.
            st = emit_tup_box_child_releases(st, dslot);
            st = st.emit(ir.op_else());
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
            st = st.emit(ir.op_end());
            var bname: string = "$sxt_box" + util.i32_to_string(dslot);
            st = st.add_local(bname);
            var bslot: i32 = st.slot_of(bname);
            st = st.emit(ir.op_load_local(kslot));
            st = st.emit(ir.op_const_i32(n));
            st = st.emit(ir.op_call_direct("__fern_alloc_reuse", 2));
            st = st.emit(ir.op_store_local(bslot));
            // Overwrite each element slot of the result box with c's value at its
            // element WIDTH (i64 via lower_i64 + tuple_set_w(64,i64); f64 via
            // lower_expr + tuple_set_w(64,f64); i32 / pointer via tuple_set —
            // mirroring op_tuple_make_k). Element values cannot reference d
            // (cross_tuple_reuse_sites proves d dead at the construction).
            var i: i32 = 0;
            while (i < n) {
                var tek: string = elem_type_tag(iife_leaf_value(tup.elements[i]), st);
                st = st.emit(ir.op_load_local(bslot));
                if (tek == "i64") { st = lower_i64(tup.elements[i], st); }
                else { st = lower_expr(tup.elements[i], st); }
                if (!st.ok) { return st; }
                if (tek == "i64") { st = st.emit(ir.op_tuple_set_w(i, 64, true)); }
                else if (tek == "f64") { st = st.emit(ir.op_tuple_set_w(i, 64, false)); }
                else { st = st.emit(ir.op_tuple_set(i)); }
                i = i + 1;
            }
            // Bind c to the result box; zero d's slot so the exit sweep frees the
            // reused box once (via c) and harmlessly decs a null for d.
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_store_local(cslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(dslot));
            return st;
        },
        _ => { return s.fail(); },
    }
}

// --- enum-donor cross-reuse (FBIP): a dead scalar-enum box donates to a struct -
//
// A THIRD reuse shape. The `consumed_scalar_enum_frees` analysis already proves a
// function-local `var x = V(scalars...)` of an all-scalar enum, consumed by exactly
// one `match (x)` and DEAD after that match, is a sole-owner box that gets freed
// right after the match. Instead of FREEING that box, DONATE it: if a LATER full
// construction `var y = W { ... }` (a no-base struct literal of a
// struct_fields_reusable type W) has the SAME box size as x's box — i.e. the same
// field count, so x's `__fern_arr_box(p+1)` (p = V's payload count) equals W's
// `__fern_arr_box(nf+1)` (nf = W's field count) on every backend — then REUSE x's
// box for y: re-shape it (write W's shape pointer at offset 0, replacing V's), write
// every field of y into it, bind y to the box, zero x's slot, and SUPPRESS the
// post-match free of x (the reuse consumes the box; the exit sweep frees it once via
// y). Net: zero-alloc for y — the map/fold FBIP win in the contained cross-statement
// form. Donor (x) payloads are all scalar (enum_all_variants_scalar), so its old
// slots hold no rc-tracked value to release before the overwrite (unlike the
// struct-cross donor); W's leak-safe array fields are written as fresh literals and
// deep-dropped at y's reclamation, like the struct-cross recipient.
//
// Soundness: x is dead-after-match and non-escaping (the consumed_scalar_enum_frees
// gates), which already covers every statement at index >= match_idx, including y's
// construction index k — so y's field values cannot reference x (no read-while-write)
// and nothing else aliases the box. The box carries an rc header (op_struct_make), so
// the single exit dec (via y) frees it at the right size.
//
// Determinism / disjointness: computed AFTER cross_reuse_sites + self_overwrite, in
// index order. The donor x is an enum ctor, never a `fresh_struct_lit_type`, so it is
// structurally disjoint from the struct-cross / self-overwrite donor pools. The
// recipient y must not already be a self-overwrite or struct-cross site. Each donor x
// is consumed at most once and, once chosen, is removed from the enum-free set so it
// is NOT also freed (no double-free). The recipient construction is lowered in place
// by emit_enum_donor_reuse instead of lower_stmt + a fresh alloc.

// EnumDonorSites: parallel arrays — for each enum-donor reuse, the recipient
// construction's body-statement index, the recipient struct name, and the donor enum
// local name x whose box it reuses. Flat triple for the self-host nested-array limit.
struct EnumDonorSites { idxs: i32[], recips: string[], donors: string[] }

// enum_init_box_fields returns the box field count of a `var name = V(args)` /
// `var name = V` scalar-enum donor: V's payload field count (decl_field_count of the
// variant struct V), or 0 - 1 if name's init isn't a variant ctor / unit variant.
function enum_init_box_fields(body: ast.Stmt[], structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            ast.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        ast.ExprCall(c) => {
                            match (c.callee) {
                                ast.ExprIdent(id) => {
                                    if (variant_enum_owner(structs, id.name) != "") { return decl_field_count(structs, id.name); }
                                    return 0 - 1;
                                },
                                _ => { return 0 - 1; },
                            }
                        },
                        ast.ExprIdent(id2) => {
                            if (variant_enum_owner(structs, id2.name) != "") { return decl_field_count(structs, id2.name); }
                            return 0 - 1;
                        },
                        _ => { return 0 - 1; },
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return 0 - 1;
}

// enum_donor_reuse_sites pairs each later full no-base struct construction with an
// earlier consumed-and-dead scalar-enum donor of the SAME box size (field count).
// It is given the already-computed self-overwrite + cross-struct sites (so it never
// re-uses one of their construction indices) and the consumed_scalar_enum_frees set
// (its candidate donor pool, of which it consumes a disjoint subset). A donor is
// eligible for recipient at index k iff its consuming match index < k (so the box is
// live + reclaimable at k) and its field count equals the recipient struct's. Each
// donor is consumed at most once; the FIRST (nearest-from-front) eligible donor is
// chosen for determinism.
function enum_donor_reuse_sites(body: ast.Stmt[], structs: parser.StructDecl[], so: ReuseSites, xr: CrossReuseSites, ef: EnumFrees): EnumDonorSites {
    var idxs: i32[] = [];
    var recips: string[] = [];
    var donors: string[] = [];
    var k: i32 = 0;
    while (k < body.len()) {
        // skip a statement already owned by a self-overwrite or cross-struct site.
        var taken: boolean = false;
        var si: i32 = 0;
        while (si < so.idxs.len()) { if (so.idxs[si] == k) { taken = true; } si = si + 1; }
        var xi: i32 = 0;
        while (xi < xr.idxs.len()) { if (xr.idxs[xi] == k) { taken = true; } xi = xi + 1; }
        if (!taken) {
            match (body[k]) {
                ast.StmtVar(v) => {
                    match (v.init) {
                        ast.ExprStructLit(slit) => {
                            // Recipient admission widened to the CROSS field-kind set
                            // (enum / string / Map / tuple / Option — the reuse-audit
                            // follow-through): the donor is a consumed scalar-enum box
                            // (no old pointer slots, so the emitter's no-release write
                            // stays sound for every kind), the recipient's pointer
                            // field VALUES are gated FRESH by the shared
                            // cross_recipient_fields_fresh (fresh values are
                            // sole-owned — no alias-inc needed on the in-place
                            // writes), and the reused box's exit drop uses the same
                            // per-kind arms as a normally-constructed box (k_enum /
                            // k_struct release; Map / tuple / Option leak-only,
                            // exactly like the fresh-alloc path).
                            if (reuse_recipient_ok(slit, structs)) {
                                var want: i32 = decl_field_count(structs, slit.type_name);
                                // find the nearest unconsumed enum donor whose
                                // consuming match is before k and whose box size
                                // (field count) equals the recipient's.
                                var di: i32 = 0;
                                var chosen: string = "";
                                while (di < ef.idxs.len() && chosen == "") {
                                    var dname: string = ef.names[di];
                                    if (ef.idxs[di] < k
                                            && dname != v.name
                                            && util.index_of_str(donors, dname) < 0
                                            && enum_init_box_fields(body, structs, dname) == want) {
                                        chosen = dname;
                                    }
                                    di = di + 1;
                                }
                                if (chosen != "") {
                                    idxs = idxs.append(k);
                                    recips = recips.append(slit.type_name);
                                    donors = donors.append(chosen);
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        }
        k = k + 1;
    }
    return EnumDonorSites { idxs: idxs, recips: recips, donors: donors };
}

// emit_enum_donor_reuse lowers a full `var y = W { ... }` construction as a
// RUNTIME-GUARDED in-place reuse of donor x's (dead, consumed scalar-enum) box
// (#4350 slice 4; the token shape shared with the other guarded families):
// reused = __fern_rc_is_unique(x); box = __fern_alloc_reuse(reused ? x : 0,
// nfields+1 slots). The box is RE-SHAPED to W unconditionally
// (op_struct_set_shape — overwriting the donor variant's shape on the reuse
// arm, initialising slot 0 on the fresh arm), every field of y is written
// (decl order; no old-value dec — the donor's old slots are all scalars), y
// binds to the box, and x's slot is ZEROED so the exit sweep frees the box
// exactly once (via y). A shared donor degrades to a fresh box + a dec of x's
// reference (standing in for the suppressed post-match free) instead of
// corrupting. Mirrors emit_cross_struct_reuse, minus its old-field releases.
function emit_enum_donor_reuse(y_name: string, y_site: string, init: ast.Expr, recip: string, donor_name: string, s: LowerState): LowerState {
    var dslot: i32 = s.slot_of(donor_name);
    if (dslot < 0) { return s.fail(); }
    match (init) {
        ast.ExprStructLit(slit) => {
            var st: LowerState = s;
            var ndecl: i32 = decl_field_count(st.structs, slit.type_name);
            // Bind y's slot up front — both guard arms store the result box there.
            st = st.add_local(y_name);
            var yslot: i32 = st.slot_of(y_name);
            // Binding-SITE key before any credit is read off the slot (#7253):
            // this path binds the recipient outside bind_var_slot, and a siteless
            // slot resolves no credit at all — a silent leak, not a loud fault.
            if (y_site.len() > 0) { st = st.mark_reclaim_site(yslot, y_site); }
            st = st.mark_struct_type(yslot, slit.type_name);
            // Runtime uniqueness guard (#4350 slice 4, the shared token shape):
            // reused = __fern_rc_is_unique(x); box = __fern_alloc_reuse(reused ?
            // x : 0, nfields+1 slots) — the donor box's cap (V's payloads + 1)
            // equals W's nfields + 1 by the site gate (same field count), so the
            // reuse path always fits. No arm-specific prep beyond the token
            // select: the donor's old slots are all SCALARS (nothing to release
            // on the reuse arm) and W's shape is written UNCONDITIONALLY below
            // (this family re-shapes even on the reuse path), so the fresh arm
            // needs no slot-0 copy either — it only releases x's reference
            // (rc >= 2 there; the dec never frees, the aliases keep the box the
            // suppressed post-match free would otherwise have dec'd).
            var uname: string = "$sed_uniq" + util.i32_to_string(dslot);
            st = st.add_local(uname);
            var uslot: i32 = st.slot_of(uname);
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
            st = st.emit(ir.op_store_local(uslot));
            var kname: string = "$sed_tok" + util.i32_to_string(dslot);
            st = st.add_local(kname);
            var kslot: i32 = st.slot_of(kname);
            st = st.emit(ir.op_load_local(uslot));
            st = st.emit(ir.op_if(0));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_else());
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(kslot));
            st = st.emit(ir.op_load_local(dslot));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
            st = st.emit(ir.op_end());
            var bname: string = "$sed_box" + util.i32_to_string(dslot);
            st = st.add_local(bname);
            var bslot: i32 = st.slot_of(bname);
            st = st.emit(ir.op_load_local(kslot));
            st = st.emit(ir.op_const_i32(ndecl + 1));
            st = st.emit(ir.op_call_direct("__fern_alloc_reuse", 2));
            st = st.emit(ir.op_store_local(bslot));
            // Re-shape the result box to W: load box, write W's shape at offset 0
            // (on the reuse arm this overwrites the donor variant's shape; on the
            // fresh arm it initialises the fresh box's slot 0).
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_struct_set_shape(recip));
            st = st.emit(ir.op_drop());
            // Write every decl field of W into the box, in decl order.
            var di: i32 = 0;
            while (di < ndecl) {
                var jj: i32 = 0;
                var found: i32 = 0 - 1;
                while (jj < slit.field_names.len()) {
                    if (st.field_index_in(slit.type_name, slit.field_names[jj]) == di) { found = jj; }
                    jj = jj + 1;
                }
                if (found < 0) { return st.fail(); }
                if (struct_field_is_i64(st.structs, slit.type_name, di)) {
                    st = st.emit(ir.op_load_local(bslot));
                    st = lower_i64(slit.field_values[found], st);
                    if (!st.ok) { return st; }
                    st = st.emit(ir.op_struct_set_i64(di));
                } else {
                    st = st.emit(ir.op_load_local(bslot));
                    st = lower_expr(slit.field_values[found], st);
                    if (!st.ok) { return st; }
                    st = st.emit(ir.op_struct_set(di, struct_field_width(st.structs, slit.type_name, di)));
                }
                di = di + 1;
            }
            // Bind y to the result box; zero x's slot (y now owns the reused box;
            // on the fresh arm x's reference was already released above).
            st = st.emit(ir.op_load_local(bslot));
            st = st.emit(ir.op_store_local(yslot));
            st = st.emit(ir.op_const_i32(0));
            st = st.emit(ir.op_store_local(dslot));
            return st;
        },
        _ => { return s.fail(); },
    }
}

// --- general enum->enum cross-local box reuse (FBIP) --------------------------
//
// The enum analog of emit_cross_struct_reuse. A `var c = V([..])` construction of
// an array-payload enum E reuses the (dead, non-escaping, non-aliased) box of an
// EARLIER same-enum donor local `a = W([..])` instead of allocating a fresh box:
//   - RELEASE a's OLD variant payload arrays (runtime variant-dispatch arr_dec via
//     emit_enum_variant_payload_drops — box kept), since a is dead and its payload
//     provably never aliased (enum_only_wildcard_used_rec), so releasing the old
//     arrays dangles nothing;
//   - RE-SHAPE a's box to V (op_struct_set_shape) and write V's FRESH array-literal
//     payloads into the SAME box — SIZE-SAFE only because every variant of E has
//     the same field count (enum_all_variants_same_field_count) so a's box (sized
//     for W) has room for V;
//   - BIND c to a's box (marked enum E, mirroring a normal `var c = V(..)` decl),
//     then ZERO a's slot so a's box is reclaimed exactly once — via c, at c's own
//     reclamation point (precise_drop / rcenumfrees, which see `var c = V([..])` in
//     the AST). Net: one fewer __fern_arr_box + one fewer free per construction.
//
// SOUNDNESS / disjointness. The donor pool is DEAD rc-payload enum locals, which is
// structurally disjoint from every existing donor pool (fresh struct lits for the
// struct-cross / self-overwrite donors; SCALAR enums in enumfrees for the enum-donor
// path; tuples for the tuple-cross donor). The recipient is an enum-ctor var-decl,
// which none of self-overwrite / cross-struct / enum-donor / in-arm claim (they claim
// struct lits / IIFE matches). CRITICAL: a dead rc-payload enum donor is otherwise
// freed BEFORE k — by rcenumfrees (a top-level wildcard `match (a)`) or by the
// enum-rcpayload precise drop (a nested use) — so lower_func SUPPRESSES both for a
// chosen donor (index_of_str(ecross.donors, ..) guards), exactly as it suppresses the
// enum-donor and struct-cross donors. With those suppressions a's box survives to k,
// flows into c, and is freed once via c. Each donor is consumed at most once; the
// FIRST (nearest-from-front) eligible donor is chosen for determinism (the
// byte-identical fixpoint demands a deterministic AST->pairing function).

// EnumCrossSites: parallel arrays — for each enum->enum cross-reuse site, the
// recipient construction's body-statement index, the donor enum local name, and the
// enum E. Flat triple for the self-host nested-array limit.
struct EnumCrossSites { idxs: i32[], donors: string[], enums: string[] }

// enum_cross_reuse_sites pairs each `var c = V([..])` array-payload-enum construction
// with an earlier dead same-enum donor `a = W([..])` whose box it reuses in place. It
// is given the already-computed self-overwrite / cross-struct / enum-donor sites so it
// never re-claims one of their construction indices, and so its donor is disjoint from
// their donor pools. A statement k qualifies when: c's init is a fresh same-count
// array-payload variant ctor of E (variant_ctor_enum_owner + enum_all_variants_array_
// payload + enum_all_variants_same_field_count + variant_ctor_array_payloads_fresh);
// k is not already a so/xr/edr site; and there is a DEAD donor `a` of the SAME enum E,
// matching box size (enum_init_box_fields == want), never reassigned, never escaping,
// dead from k onward, not already consumed, a != c, whose payload is provably never
// aliased (enum_only_wildcard_used_rec). Each donor is consumed at most once.
function enum_cross_reuse_sites(body: ast.Stmt[], structs: parser.StructDecl[], so: ReuseSites, xr: CrossReuseSites, edr: EnumDonorSites): EnumCrossSites {
    var idxs: i32[] = [];
    var donors: string[] = [];
    var enums: string[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var k: i32 = 0;
    while (k < body.len()) {
        // skip a statement already owned by a self-overwrite / cross-struct /
        // enum-donor site (defensive — an enum-ctor var-decl is not a struct-lit
        // construction, so those never claim it, but mirror the taken/skip logic).
        var taken: boolean = false;
        var si: i32 = 0;
        while (si < so.idxs.len()) { if (so.idxs[si] == k) { taken = true; } si = si + 1; }
        var xi: i32 = 0;
        while (xi < xr.idxs.len()) { if (xr.idxs[xi] == k) { taken = true; } xi = xi + 1; }
        var ei: i32 = 0;
        while (ei < edr.idxs.len()) { if (edr.idxs[ei] == k) { taken = true; } ei = ei + 1; }
        if (!taken) {
            match (body[k]) {
                ast.StmtVar(v) => {
                    var e0: string = variant_ctor_enum_owner(v.init, structs);
                    if (e0.len() > 0
                            && enum_all_variants_array_payload(structs, e0)
                            && enum_all_variants_same_field_count(structs, e0)
                            && variant_ctor_array_payloads_fresh(v.init, structs)) {
                        var want: i32 = enum_init_box_fields(body, structs, v.name);
                        // scan earlier statements for the nearest eligible donor.
                        var i: i32 = 0;
                        var chosen: string = "";
                        while (i < k && chosen == "") {
                            match (body[i]) {
                                ast.StmtVar(dv) => {
                                    var dname: string = dv.name;
                                    var elig: boolean = dname != v.name
                                        && variant_ctor_enum_owner(dv.init, structs) == e0
                                        && enum_init_box_fields(body, structs, dname) == want
                                        && util.index_of_str(donors, dname) < 0
                                        && util.index_of_str(so.bases, dname) < 0
                                        && util.index_of_str(xr.donors, dname) < 0
                                        && util.index_of_str(edr.donors, dname) < 0;
                                    // not reassigned: keeps the donor out of the enum
                                    // self-reassign path (emit_enum_inplace_reassign),
                                    // which owns a reassigned array-payload enum local.
                                    if (elig && util.index_of_str(reassigned, dname) >= 0) { elig = false; }
                                    // NO separate walk_stmts_escapes gate: an enum's only
                                    // non-decl use is a bare-ident `match` scrutinee, which
                                    // walk_stmts_escapes flags as an escape. enum_only_
                                    // wildcard_used_rec (below) is the PRECISE non-alias /
                                    // non-escape proof — it rejects any mention that isn't
                                    // the decl, a fresh same-enum reassign, or a bind-free
                                    // wildcard match scrutinee (return/pass/alias all fail).
                                    if (elig) {
                                        // dead from statement k onward: no mention of
                                        // dname at index >= k (covers c's own payloads).
                                        var m: i32 = k;
                                        while (m < body.len()) {
                                            var none: string[] = [];
                                            if (util.index_of_str(astwalk.collect_idents_stmt(body[m], none), dname) >= 0) { elig = false; }
                                            m = m + 1;
                                        }
                                    }
                                    // non-aliasing proof: every mention of the donor is
                                    // a safe use (decl / fresh same-enum reassign / bind-
                                    // free wildcard match) — so releasing its old arrays
                                    // in emit_enum_cross_reuse dangles nothing.
                                    if (elig && !enum_only_wildcard_used_rec(body, dname, e0, structs)) { elig = false; }
                                    if (elig) { chosen = dname; }
                                },
                                _ => {}
                            }
                            i = i + 1;
                        }
                        if (chosen != "") {
                            idxs = idxs.append(k);
                            donors = donors.append(chosen);
                            enums = enums.append(e0);
                        }
                    }
                },
                _ => {}
            }
        }
        k = k + 1;
    }
    return EnumCrossSites { idxs: idxs, donors: donors, enums: enums };
}

// emit_enum_cross_reuse lowers `var c = V([..])` (V a variant of array-payload enum
// `enum_name`) as a RUNTIME-GUARDED in-place reuse of dead donor `donor_name`'s box —
// the enum analog of emit_cross_struct_reuse, built on the self-reassign primitives.
// The #4350 token shape: reused = __fern_rc_is_unique(a); on the reuse arm the token
// is a's box and the donor's OLD variant payload arrays are released (emit_enum_
// variant_payload_drops — box kept, solely owned); on the fresh arm the token is 0
// and a's box reference is dec'd instead (rc >= 2 there, so the dec never frees and
// the surviving aliases keep the box AND its payload arrays — releasing the payloads
// would corrupt the other owners' view). Then box = __fern_alloc_reuse(token, nf+1)
// (a's cap is nf+1 by the same-field-count site gate, so the reuse path always fits),
// the RESULT box is re-shaped to V and V's fresh array-literal payloads are written
// into it, c binds the result box (marked enum E), and the donor slot is ZEROED so
// the box is freed exactly once via c. Returns fail() on any non-`V([..])` shape.
function emit_enum_cross_reuse(c_name: string, c_site: string, value: ast.Expr, donor_name: string, enum_name: string, s: LowerState): LowerState {
    var dslot: i32 = s.slot_of(donor_name);
    if (dslot < 0) { return s.fail(); }
    match (value) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(vid) => {
                    var vname: string = vid.name;
                    if (variant_enum_owner(s.structs, vname) != enum_name) { return s.fail(); }
                    if (decl_field_count(s.structs, vname) != c.args.len()) { return s.fail(); }
                    var st: LowerState = s;
                    var nf: i32 = decl_field_count(st.structs, vname);
                    // Runtime uniqueness guard (#4350 slice 5, the shared token
                    // shape): reused = __fern_rc_is_unique(a).
                    var uname: string = "$exr_uniq" + util.i32_to_string(dslot);
                    st = st.add_local(uname);
                    var uslot: i32 = st.slot_of(uname);
                    st = st.emit(ir.op_load_local(dslot));
                    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
                    st = st.emit(ir.op_store_local(uslot));
                    // Token select + arm-specific donor release: reuse arm takes
                    // the donor box as token and releases its OLD payload arrays
                    // (solely owned, box kept for alloc_reuse); fresh arm takes a
                    // null token and releases only a's box REFERENCE (rc >= 2 —
                    // never frees; the aliases still own box + payload arrays).
                    var kname: string = "$exr_tok" + util.i32_to_string(dslot);
                    st = st.add_local(kname);
                    var kslot: i32 = st.slot_of(kname);
                    st = st.emit(ir.op_load_local(uslot));
                    st = st.emit(ir.op_if(0));
                    st = st.emit(ir.op_load_local(dslot));
                    st = st.emit(ir.op_store_local(kslot));
                    var dno_moved: string[] = [];
                    st = emit_enum_variant_payload_drops(st, dslot, enum_name, dno_moved);
                    st = st.emit(ir.op_else());
                    st = st.emit(ir.op_const_i32(0));
                    st = st.emit(ir.op_store_local(kslot));
                    st = st.emit(ir.op_load_local(dslot));
                    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    st = st.emit(ir.op_drop());
                    st = st.emit(ir.op_end());
                    // box = __fern_alloc_reuse(token, nf+1): the donor box on the
                    // reuse arm (cap nf+1 always matches), a fresh box otherwise.
                    var bname: string = "$exr_box" + util.i32_to_string(dslot);
                    st = st.add_local(bname);
                    var bslot: i32 = st.slot_of(bname);
                    st = st.emit(ir.op_load_local(kslot));
                    st = st.emit(ir.op_const_i32(nf + 1));
                    st = st.emit(ir.op_call_direct("__fern_alloc_reuse", 2));
                    st = st.emit(ir.op_store_local(bslot));
                    // Re-shape the result box to V (overwrites the donor variant's
                    // shape on the reuse arm; initialises slot 0 on the fresh arm).
                    st = st.emit(ir.op_load_local(bslot));
                    st = st.emit(ir.op_struct_set_shape(vname));
                    st = st.emit(ir.op_drop());
                    // Write V's fresh payloads into the result box, in decl order.
                    var di: i32 = 0;
                    while (di < c.args.len()) {
                        if (struct_field_is_i64(st.structs, vname, di)) {
                            st = st.emit(ir.op_load_local(bslot));
                            st = lower_i64(c.args[di], st);
                            if (!st.ok) { return st; }
                            st = st.emit(ir.op_struct_set_i64(di));
                        } else {
                            st = st.emit(ir.op_load_local(bslot));
                            st = lower_expr(c.args[di], st);
                            if (!st.ok) { return st; }
                            st = st.emit(ir.op_struct_set(di, struct_field_width(st.structs, vname, di)));
                        }
                        di = di + 1;
                    }
                    // Bind c to the result box; zero the donor slot.
                    var cb: LowerState = st.add_local(c_name);
                    var cslot: i32 = cb.slot_of(c_name);
            // The binding-SITE key goes on before anything reads a class credit off
            // the slot (#7253): this path binds the recipient itself rather than
            // going through bind_var_slot, and a siteless slot resolves no credit —
            // silently, as a leak. Same gap #7272 / #7349 hit on the tuple and
            // struct siblings.
                    if (c_site.len() > 0) { cb = cb.mark_reclaim_site(cslot, c_site); }
                    cb = cb.mark_struct_type(cslot, enum_name);
                    cb = cb.emit(ir.op_load_local(bslot));
                    cb = cb.emit(ir.op_store_local(cslot));
                    cb = cb.emit(ir.op_const_i32(0));
                    cb = cb.emit(ir.op_store_local(dslot));
                    return cb;
                },
                _ => { return s.fail(); }
            }
        },
        _ => { return s.fail(); }
    }
}

// --- in-arm consuming-match box reuse (FBIP) ---------------------------------
//
// The marquee Perceus "functional but in-place" win: `var y = match (x) { ... }`
// where x is a fresh, sole-owner, dead-after, non-escaping ALL-SCALAR-payload enum
// box consumed by THIS match-EXPRESSION, and EVERY arm constructs a NEW same-size
// variant `W(...)`. Instead of allocating a fresh box per arm result, REUSE x's box
// IN PLACE: re-shape it to the arm's variant (op_struct_set_shape), write the arm's
// constructed fields into it, and bind y to it. Net: one fewer __fern_arr_box per
// arm; x's leak is fixed (the box now flows into y, freed once at y's reclamation).
//
// SOUNDNESS, in five parts (mirrors the hard-parts checklist):
//   1. Reuse-token threading. No LowerState field / generic-path change: the whole
//      lowering is done HERE by emit_inarm_match_reuse, dispatched from lower_func
//      for a firing `var y = match(x)` statement (like emit_enum_donor_reuse). The
//      donor box is x's OWN slot (the scrutinee is the bare ident x).
//   2. Read-before-overwrite. Each arm reads its scalar payloads (__ev, __ev1, …)
//      out of x's box into fresh temps at arm entry (struct_get → store_local) BEFORE
//      the box is re-shaped/overwritten — so the arm's field expressions read the
//      payload COPIES, never the box fields being overwritten.
//   3. Same-size. The arm's constructed variant W has the SAME field count as x's
//      consumed variant (checked per arm), so __fern_arr_box(nf+1) sizes match and
//      the in-place box has room. EVERY arm must construct a same-size variant.
//   4. Exactly-once free. EVERY arm reuses the box (constructs y from it), so on
//      every path the box flows into y and is freed exactly once at y's reclamation
//      — there is no post-match free to suppress (an in-arm scrutinee is NOT a
//      top-level `match (x)`, so consumed_scalar_enum_frees never classified/freed
//      it). x's slot is ZEROED after the reuse so the exit sweep (which never
//      sweeps enum slots anyway) can't double-free via x.
//   5. Old rc-field drop. Restricted to ALL-SCALAR-payload enums (donor + every
//      constructed variant), so x's old box fields hold no rc value to release
//      before the overwrite. Widening to rc payloads is deferred. (Leak-safe
//      SCALAR-ARRAY payloads were later admitted with a cow-guarded per-slot
//      drop — see inarm_reuse_match_ok's per-position move/replace gate.)
//   6. Runtime uniqueness guard (#4350). The static gates are backstopped by the
//      shared token shape: reused = __fern_rc_is_unique(x); token = reused ? x : 0
//      (x's box reference dec'd on the fresh arm — rc >= 2 there, so the dec never
//      frees and the arms' payload reads stay valid); per arm, box =
//      __fern_alloc_reuse(token, nf+1) sized by the MATCHED variant (cap always
//      matches on the reuse arm via the same-size gate), and the re-shape + field
//      writes + y-bind all target the RESULT box. The array cow-guard splits per
//      guard arm: reuse -> dec the replaced old array; fresh -> never dec (the
//      aliases own it), and a same-slot MOVE retains (rc_inc) the array instead,
//      since the fresh box takes a second counted reference to x's still-owned
//      payload.

// inarm_iife_match: if `e` is the value-position IIFE wrapping a match-EXPRESSION
// (an ExprCall of a 0-param ExprLambda whose single body statement is a StmtMatch),
// returns that StmtMatch via `out` (true), else false. Mirrors lower_iife's shape
// gate (a 0-arg call of a 0-param lambda with a one-statement match body).
function inarm_iife_match(e: ast.Expr, structs: parser.StructDecl[]): ast.MatchArm[] {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() != 0) { return []; }
            match (c.callee) {
                ast.ExprLambda(lam) => {
                    if (lam.params.len() != 0) { return []; }
                    if (lam.body.len() != 1) { return []; }
                    match (lam.body[0]) {
                        ast.StmtMatch(mm) => { return mm.arms; },
                        _ => { return []; }
                    }
                },
                _ => { return []; }
            }
        },
        _ => { return []; }
    }
    return [];
}

// inarm_iife_scrutinee: the bare-ident scrutinee name of `var x`-style IIFE match
// `e`, or "" if `e` is not an IIFE match or its scrutinee is not a bare ident.
function inarm_iife_scrutinee(e: ast.Expr): string {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprLambda(lam) => {
                    if (lam.body.len() != 1) { return ""; }
                    match (lam.body[0]) {
                        ast.StmtMatch(mm) => {
                            match (mm.scrutinee) {
                                ast.ExprIdent(id) => { return id.name; },
                                _ => { return ""; }
                            }
                        },
                        _ => { return ""; }
                    }
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// inarm_arm_ctor_variant: the result variant name of arm body `body` when its
// terminal `return E` constructs a same-enum variant `W(args)` whose every payload
// field is scalar-or-leak-safe-array (enum_variant_reuse_payload_ok) and whose field
// count equals `want` (the donor variant's field count). Returns "" if the arm is
// not a same-size reuse-payload variant ctor. (Per-position move/replace soundness of
// the array args is checked in inarm_reuse_match_ok, which sees the pattern too.)
function inarm_arm_ctor_variant(body: ast.Stmt[], enum_name: string, want: i32, structs: parser.StructDecl[]): string {
    if (body.len() != 1) { return ""; }
    match (body[0]) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprCall(c) => {
                    match (c.callee) {
                        ast.ExprIdent(id) => {
                            if (variant_enum_owner(structs, id.name) != enum_name) { return ""; }
                            if (!enum_variant_reuse_payload_ok(structs, id.name)) { return ""; }
                            if (decl_field_count(structs, id.name) != want) { return ""; }
                            if (c.args.len() != want) { return ""; }
                            return id.name;
                        },
                        _ => { return ""; }
                    }
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// inarm_field_is_leaksafe_array: convenience — field `idx` of variant `vname` is a
// leak-safe scalar array (i32[]/i64[]/f64[]/boolean[]).
function inarm_field_is_leaksafe_array(structs: parser.StructDecl[], vname: string, idx: i32): boolean {
    return is_leaksafe_array_field(decl_field_type_at(structs, vname, idx));
}

// inarm_arm_pattern_binding: the pattern binding name at payload position `pos` of a
// PatVariant `pv` (pos 0 = pv.binding, pos i = pv.extra_bindings[i-1]), or "" if out
// of range or a `_` wildcard. Used to recognise an in-place ARRAY MOVE: a result
// ctor arg that is the bare ident bound from the SAME slot pos.
function inarm_arm_pattern_binding(pv: ast.PatVariant, pos: i32): string {
    if (pos == 0) {
        if (pv.binding == "_") { return ""; }
        return pv.binding;
    }
    if (pos - 1 < pv.extra_bindings.len()) {
        var b: string = pv.extra_bindings[pos - 1];
        if (b == "_") { return ""; }
        return b;
    }
    return "";
}

// inarm_reuse_match_ok: every arm of the IIFE match is a plain variant pattern (no
// guard) of the SAME enum, binding only reuse-payload fields (scalar or leak-safe
// array), and constructs a same-size reuse-payload variant of that enum. For ARRAY
// payload fields the lowering uses a cow-guarded drop; that is sound only when, per
// arm and per field position di where the RESULT field is a leak-safe array:
//   (a) the PATTERN field di is ALSO a leak-safe array (so the box slot di holds a
//       real array pointer the cow-guard can read+dec, never a scalar-as-pointer),
//   AND
//   (b) the result ctor arg di is EITHER a fresh array literal `[...]` (replace: old
//       array dropped, fresh written) OR the bare pattern binding bound from the
//       SAME slot di (in-place move: old==new so no dec, the array is reused).
// A permutation/swap (`V(p,q) => V(q,p)`) is rejected by (b) — the arg at di is bound
// from a DIFFERENT slot, so old!=new would wrongly dec a still-needed array. A scalar
// pattern slot under an array result (or vice-versa) is rejected by (a) / the type
// match. Bool/Option/wildcard arms and guards bail.
function inarm_reuse_match_ok(arms: ast.MatchArm[], enum_name: string, want: i32, structs: parser.StructDecl[]): boolean {
    if (arms.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < arms.len()) {
        var arm: ast.MatchArm = arms[i];
        if (arm.has_guard) { return false; }
        match (arm.pattern) {
            ast.PatVariant(pv) => {
                // No qualified names in this slice. Builtins need no separate
                // rejection: they own no enum, and `enum_name` is non-empty at
                // every call, so the ownership test below already excludes them
                // — while letting a user enum that happens to name a variant
                // `Ok` / `Some` keep the reuse.
                var vld: i32 = 0;
                while (vld < pv.type_name.len()) { if (pv.type_name[vld] == b'.') { return false; } vld = vld + 1; }
                if (variant_enum_owner(structs, pv.type_name) != enum_name) { return false; }
                if (!enum_variant_reuse_payload_ok(structs, pv.type_name)) { return false; }
                // The matched variant's SCALAR payload fields are read into temps at
                // their width. Admit i32 / u32 / boolean (plain i32 path) plus the
                // 8-byte i64 / f64; an ARRAY payload field rides the leak-safe-array
                // path (read into a pointer temp, written via cow-guard). u64 is
                // excluded for scalar fields (see inarm_reuse_payload_type_ok).
                var nf: i32 = decl_field_count(structs, pv.type_name);
                var fi: i32 = 0;
                while (fi < nf) {
                    var pft: string = decl_field_type_at(structs, pv.type_name, fi);
                    if (!is_leaksafe_array_field(pft) && !inarm_reuse_payload_type_ok(pft)) { return false; }
                    fi = fi + 1;
                }
                // The constructed result must be a same-size (== want) reuse-payload
                // variant whose every written SCALAR field is an admitted width.
                var rv: string = inarm_arm_ctor_variant(arm.body, enum_name, want, structs);
                if (rv == "") { return false; }
                var rnf: i32 = decl_field_count(structs, rv);
                var rfi: i32 = 0;
                while (rfi < rnf) {
                    var rft: string = decl_field_type_at(structs, rv, rfi);
                    if (!is_leaksafe_array_field(rft) && !inarm_reuse_payload_type_ok(rft)) { return false; }
                    rfi = rfi + 1;
                }
                // Per-position array-soundness: for each result array field di, the
                // pattern field di must be an array too (a), and the arg must be a
                // fresh literal or the same-slot pattern binding (b). Also reject the
                // reverse (pattern array under scalar result) so a donor array is not
                // silently overwritten + leaked.
                var rargs: ast.Expr[] = [];
                match (arm.body[0]) {
                    ast.StmtReturn(r2) => {
                        match (r2.value) {
                            ast.ExprCall(rc2) => { rargs = rc2.args; },
                            _ => { return false; }
                        }
                    },
                    _ => { return false; }
                }
                var di: i32 = 0;
                while (di < rnf) {
                    var res_arr: boolean = inarm_field_is_leaksafe_array(structs, rv, di);
                    var pat_arr: boolean = inarm_field_is_leaksafe_array(structs, pv.type_name, di);
                    if (res_arr != pat_arr) { return false; }   // (a) + reverse
                    if (res_arr) {
                        // (b): fresh literal OR the same-slot binding move.
                        var ok_arg: boolean = false;
                        match (rargs[di]) {
                            ast.ExprArray(_) => { ok_arg = true; },
                            ast.ExprIdent(aid) => {
                                var pb: string = inarm_arm_pattern_binding(pv, di);
                                if (pb != "" && aid.name == pb) { ok_arg = true; }
                            },
                            _ => {}
                        }
                        if (!ok_arg) { return false; }
                    }
                    di = di + 1;
                }
                // Each ARRAY pattern binding may be referenced in the result ctor
                // ONLY as its own same-slot move (handled above) — never elsewhere
                // (another arg, or a borrow sub-expression like `xs.len()`/`xs[i]`).
                // The move temp is an unmarked pointer alias, so a stray borrow use
                // wouldn't dispatch and a second move would double-reuse the slot.
                // Conservatively gate those out: an array binding that appears in any
                // arg OTHER than its own slot move bails the whole match.
                var pdi: i32 = 0;
                while (pdi < nf) {
                    if (inarm_field_is_leaksafe_array(structs, pv.type_name, pdi)) {
                        var abn: string = inarm_arm_pattern_binding(pv, pdi);
                        if (abn != "") {
                            var aj: i32 = 0;
                            while (aj < rargs.len()) {
                                // The own-slot move (arg aj==pdi is the bare ident abn)
                                // is allowed; any other mention of abn bails.
                                var is_own_move: boolean = false;
                                if (aj == pdi) {
                                    match (rargs[aj]) {
                                        ast.ExprIdent(mid) => { if (mid.name == abn) { is_own_move = true; } },
                                        _ => {}
                                    }
                                }
                                if (!is_own_move) {
                                    var ids: string[] = astwalk.collect_idents_expr(rargs[aj], []);
                                    if (util.index_of_str(ids, abn) >= 0) { return false; }
                                }
                                aj = aj + 1;
                            }
                        }
                    }
                    pdi = pdi + 1;
                }
            },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// InArmReuseSites: parallel arrays — for each firing `var y = match(x)` reuse, the
// body-statement index and the donor enum local name x whose box is reused.
struct InArmReuseSites { idxs: i32[], donors: string[] }

// consumed_inarm_reuse_sites finds every function-local `var y = match (x) { ... }`
// where x is a fresh, sole-owner, dead-after, non-escaping ALL-SCALAR enum box and
// EVERY arm constructs a same-size scalar variant of the SAME enum. x's box is
// reused in place to build y (emit_inarm_match_reuse). Conservative: x must be the
// bare-ident scrutinee, declared by a fresh scalar-enum init earlier, not
// reassigned, used exactly ONCE (as this scrutinee) and DEAD after this statement,
// and not escape anywhere. The match must reach lower_iife_match's enum path.
function consumed_inarm_reuse_sites(body: ast.Stmt[], structs: parser.StructDecl[]): InArmReuseSites {
    var idxs: i32[] = [];
    var donors: string[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var k: i32 = 0;
    while (k < body.len()) {
        match (body[k]) {
            ast.StmtVar(yv) => {
                var xname: string = inarm_iife_scrutinee(yv.init);
                if (xname != "" && xname != yv.name) {
                    var arms: ast.MatchArm[] = inarm_iife_match(yv.init, structs);
                    if (arms.len() > 0) {
                        // x must be a fresh scalar-enum init declared earlier, not
                        // reassigned.
                        var owner: string = "";
                        var want: i32 = 0 - 1;
                        var xi: i32 = 0;
                        while (xi < body.len()) {
                            match (body[xi]) {
                                ast.StmtVar(xv) => {
                                    if (xv.name == xname) {
                                        owner = fresh_reuse_enum_init(xv.init, structs);
                                        want = enum_init_box_fields(body, structs, xname);
                                    }
                                },
                                _ => {}
                            }
                            xi = xi + 1;
                        }
                        if (owner != "" && want >= 0 && util.index_of_str(reassigned, xname) < 0) {
                            // x is mentioned exactly once below its decl (this
                            // scrutinee): dead after k and only consumed here. Use
                            // name_used_after (any read past k) plus a single-mention
                            // check across the whole body.
                            var mentions: i32 = 0;
                            var mi: i32 = 0;
                            while (mi < body.len()) {
                                var used: string[] = astwalk.collect_idents_stmt(body[mi], []);
                                if (util.index_of_str(used, xname) >= 0) { mentions = mentions + 1; }
                                mi = mi + 1;
                            }
                            var dead_after: boolean = !name_used_after(body, xname, k);
                            // x's only mention is in body[k] (its decl statement does
                            // not read x; the scrutinee is the single read). So a sole
                            // owner consumed here has exactly ONE mention (at k).
                            var escapes: boolean = name_escapes_outside_stmt(body, xname, k);
                            // The donor's leak-safe-array payload args must be fresh
                            // array literals (sole ownership) so the cow-guard dec at
                            // reuse can't double-free a still-aliased array.
                            var donor_fresh: boolean = inarm_donor_arrays_are_fresh(body, structs, xname);
                            if (mentions == 1 && dead_after && !escapes && donor_fresh
                                    && inarm_reuse_match_ok(arms, owner, want, structs)) {
                                idxs = idxs.append(k);
                                donors = donors.append(xname);
                            }
                        }
                    }
                }
            },
            _ => {}
        }
        k = k + 1;
    }
    return InArmReuseSites { idxs: idxs, donors: donors };
}

// emit_inarm_match_reuse lowers a firing `var y = match (x) { ... }` (the site found
// by consumed_inarm_reuse_sites) with RUNTIME-GUARDED in-place reuse of x's box (the
// #4350 token shape — see soundness part 6 above). It emits the same block/br
// dispatch as the generic enum match, but each arm — after reading its scalar
// payloads into temps at their width (i32 / u32 / boolean via struct_get, i64 via
// struct_get_i64, f64 via struct_get width-64) — obtains the result box via
// __fern_alloc_reuse(token, nf+1) (x's own box when unique, fresh otherwise),
// re-shapes IT to the arm's constructed variant (op_struct_set_shape), writes the
// constructed fields at their width (i64 via lower_i64+struct_set_i64, else
// lower_expr+struct_set), binds y to the result box, zeroes x's slot, then br's
// out. Every arm binds y to a box it owns, so y is freed exactly once at y's
// reclamation (no post-match free exists for an in-arm scrutinee). Restricted to
// the inarm_reuse_match_ok shape
// (scalar enum, i32/u32/boolean/i64/u64/f64 payloads, same-size scalar-variant
// results, no guards/wildcards — see inarm_reuse_payload_type_ok).
function emit_inarm_match_reuse(y_name: string, y_site: string, init: ast.Expr, donor_name: string, s: LowerState): LowerState {
    var xslot: i32 = s.slot_of(donor_name);
    if (xslot < 0) { return s.fail(); }
    var arms: ast.MatchArm[] = inarm_iife_match(init, s.structs);
    if (arms.len() == 0) { return s.fail(); }
    // enum owner (TYPE) of the scrutinee / every arm result — recovered from the
    // first arm's pattern variant. NOT the scrutinee ident name.
    var enum_name: string = "";
    match (arms[0].pattern) {
        ast.PatVariant(pv0) => { enum_name = variant_enum_owner(s.structs, pv0.type_name); },
        _ => {}
    }
    if (enum_name == "") { return s.fail(); }
    // Bind y up front (a fresh local) and mark its enum type so a later `match (y)`
    // resolves the payload. y holds the reused box pointer.
    var st: LowerState = s.add_local(y_name);
    var yslot: i32 = st.slot_of(y_name);
    // Binding-SITE key before any credit is read off the slot (#7253): this path
    // binds the recipient outside bind_var_slot, and a siteless slot resolves no
    // credit at all — a silent leak, not a loud fault.
    if (y_site.len() > 0) { st = st.mark_reclaim_site(yslot, y_site); }
    st = st.mark_struct_type(yslot, enum_name);
    // Runtime uniqueness guard (#4350 slice 5, the shared token shape), hoisted
    // BEFORE the arm dispatch: reused = __fern_rc_is_unique(x); token = reused ?
    // x : 0. On the fresh arm x's box reference is dec'd here (rc >= 2 — the dec
    // never frees, so the arms' payload READS from x's box below stay valid; the
    // surviving aliases own the box and its payloads). __fern_alloc_reuse is
    // called PER ARM (below), because the required box size is the matched
    // variant's field count, only known after the variant test.
    var uname: string = "$iam_uniq" + util.i32_to_string(xslot);
    st = st.add_local(uname);
    var uslot: i32 = st.slot_of(uname);
    st = st.emit(ir.op_load_local(xslot));
    st = st.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
    st = st.emit(ir.op_store_local(uslot));
    var kname: string = "$iam_tok" + util.i32_to_string(xslot);
    st = st.add_local(kname);
    var kslot: i32 = st.slot_of(kname);
    st = st.emit(ir.op_load_local(uslot));
    st = st.emit(ir.op_if(0));
    st = st.emit(ir.op_load_local(xslot));
    st = st.emit(ir.op_store_local(kslot));
    st = st.emit(ir.op_else());
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(kslot));
    st = st.emit(ir.op_load_local(xslot));
    st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
    st = st.emit(ir.op_drop());
    st = st.emit(ir.op_end());
    st = st.emit(ir.op_block(0));   // outer block: arms br out of it
    var i: i32 = 0;
    while (i < arms.len()) {
        var arm: ast.MatchArm = arms[i];
        match (arm.pattern) {
            ast.PatVariant(pv) => {
                var vname: string = pv.type_name;
                st = st.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                st = st.emit(ir.op_load_local(xslot));
                st = st.emit(ir.op_variant_is(vname));
                st = st.emit(ir.op_bin("not", 0, false));   // 1 if NOT this variant
                st = st.emit(ir.op_brif(0));                // -> skip arm on mismatch
                // READ-BEFORE-OVERWRITE: read every scalar payload of the matched
                // variant out of x's box into a fresh temp slot, BEFORE re-shaping.
                // Read at the field's width: an i64 payload uses struct_get_i64
                // (i64.load), an f64 one struct_get width-64 (f64.load), else the i32
                // read — and mark the temp slot i64 / f64 so later uses in the arm's
                // ctor-arg expressions route through lower_i64 / the float ops
                // (mirrors the generic enum-match payload-binding path).
                var nbinds: i32 = 1 + pv.extra_bindings.len();
                var bidx: i32 = 0;
                while (bidx < nbinds) {
                    var bname: string = pv.binding;
                    if (bidx > 0) { bname = pv.extra_bindings[bidx - 1]; }
                    if (bname.len() > 0 && bname != "_") {
                        var bty: string = decl_field_type_at(st.structs, vname, bidx);
                        st = st.add_local(bname);
                        var bslot: i32 = st.slot_of(bname);
                        st = st.emit(ir.op_load_local(xslot));
                        if (bty == "i64") { st = st.emit(ir.op_struct_get_i64(bidx)); }
                        else if (bty == "f64") { st = st.emit(ir.op_struct_get(bidx, 64)); }
                        else { st = st.emit(ir.op_struct_get(bidx, 0)); }
                        st = st.emit(ir.op_store_local(bslot));
                        if (bty == "i64") { st = st.mark_i64(bslot, true); }
                        else if (bty == "f64") { st = st.mark_f64(bslot, true); }
                    }
                    bidx = bidx + 1;
                }
                // CONSTRUCT IN PLACE: re-shape x's box to the arm's result variant,
                // then write the constructed fields (reading the payload temps, which
                // are now safely copied). Mirrors emit_enum_donor_reuse.
                var rvariant: string = inarm_arm_ctor_variant(arm.body, enum_name, decl_field_count(st.structs, vname), st.structs);
                if (rvariant == "") { return s.fail(); }
                // the arm's constructed ctor call (its return value).
                var ctor_args: ast.Expr[] = [];
                match (arm.body[0]) {
                    ast.StmtReturn(r) => {
                        match (r.value) {
                            ast.ExprCall(rc) => { ctor_args = rc.args; },
                            _ => { return s.fail(); }
                        }
                    },
                    _ => { return s.fail(); }
                }
                // box = __fern_alloc_reuse(token, nf+1): x's own box on the reuse
                // arm (its cap is this variant's nf+1, and the constructed variant
                // has the SAME field count by the site gate, so the cap always
                // matches), a fresh right-sized box on the fresh arm. Called after
                // the payload reads (which must see x's box untouched) and before
                // the re-shape + writes, which all target the RESULT box.
                var bxname: string = "$iam_box" + util.i32_to_string(st.locals.len());
                st = st.add_local(bxname);
                var bxslot: i32 = st.slot_of(bxname);
                st = st.emit(ir.op_load_local(kslot));
                st = st.emit(ir.op_const_i32(decl_field_count(st.structs, vname) + 1));
                st = st.emit(ir.op_call_direct("__fern_alloc_reuse", 2));
                st = st.emit(ir.op_store_local(bxslot));
                st = st.emit(ir.op_load_local(bxslot));
                st = st.emit(ir.op_struct_set_shape(rvariant));
                st = st.emit(ir.op_drop());
                var di: i32 = 0;
                while (di < ctor_args.len()) {
                    // Write each constructed field at its width: a LEAK-SAFE ARRAY
                    // field via a cow-guarded drop (release the donor's OLD array at
                    // this slot unless the new value IS that same array — an in-place
                    // move — then store the new value); an i64 field via lower_i64 +
                    // struct_set_i64; an f64 / i32-shaped field via lower_expr +
                    // struct_set (width 64 for f64, 0 otherwise).
                    if (is_leaksafe_array_field(decl_field_type_at(st.structs, rvariant, di))) {
                        // Stash the NEW array value in a scratch local. The DONOR
                        // slot di (read from x's box, valid on both guard arms —
                        // the fresh arm's dec never frees) still holds the OLD
                        // array; the RESULT box's slot di is written below. The
                        // old-vs-new compare dispatches the arm-specific fixup:
                        //   reuse arm — if (old != new) arr_dec(old): a FRESH
                        //     literal replaces the solely-owned old array (drop
                        //     it); the same-slot MOVE (old==new) keeps it, now
                        //     owned by the result box (== x's box).
                        //   fresh arm — if (old == new) arr_inc(new): the MOVE
                        //     stores an alias of x's still-owned array into the
                        //     fresh box (a second counted reference, so retain);
                        //     a fresh literal (old != new) is solely the fresh
                        //     box's — no fixup. Never dec on this arm: x's
                        //     surviving aliases own the old arrays.
                        var scratch: string = "$iar" + util.i32_to_string(st.locals.len());
                        st = st.add_local(scratch);
                        var tmp: i32 = st.slot_of(scratch);
                        st = lower_expr(ctor_args[di], st);
                        if (!st.ok) { return st; }
                        st = st.emit(ir.op_store_local(tmp));
                        st = st.emit(ir.op_load_local(uslot));
                        st = st.emit(ir.op_if(0));
                        // reuse arm: if (old != new) arr_dec(old)
                        st = st.emit(ir.op_load_local(xslot));
                        st = st.emit(ir.op_struct_get(di, 0));     // OLD array ptr
                        st = st.emit(ir.op_load_local(tmp));       // NEW array ptr
                        st = st.emit(ir.op_bin("ne", 0, false));
                        st = st.emit(ir.op_if(0));
                        st = st.emit(ir.op_load_local(xslot));
                        st = st.emit(ir.op_struct_get(di, 0));
                        st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
                        st = st.emit(ir.op_drop());
                        st = st.emit(ir.op_end());
                        st = st.emit(ir.op_else());
                        // fresh arm: if (old == new) arr_inc(new)
                        st = st.emit(ir.op_load_local(xslot));
                        st = st.emit(ir.op_struct_get(di, 0));
                        st = st.emit(ir.op_load_local(tmp));
                        st = st.emit(ir.op_bin("eq", 0, false));
                        st = st.emit(ir.op_if(0));
                        st = st.emit(ir.op_load_local(tmp));
                        st = st.emit(ir.op_call_direct("__fern_rc_inc", 1));
                        st = st.emit(ir.op_drop());
                        st = st.emit(ir.op_end());
                        st = st.emit(ir.op_end());
                        // store NEW into the result box's slot di
                        st = st.emit(ir.op_load_local(bxslot));
                        st = st.emit(ir.op_load_local(tmp));
                        st = st.emit(ir.op_struct_set(di, 0));
                    } else if (struct_field_is_i64(st.structs, rvariant, di)) {
                        st = st.emit(ir.op_load_local(bxslot));
                        st = lower_i64(ctor_args[di], st);
                        if (!st.ok) { return st; }
                        st = st.emit(ir.op_struct_set_i64(di));
                    } else {
                        st = st.emit(ir.op_load_local(bxslot));
                        st = lower_expr(ctor_args[di], st);
                        if (!st.ok) { return st; }
                        st = st.emit(ir.op_struct_set(di, struct_field_width(st.structs, rvariant, di)));
                    }
                    di = di + 1;
                }
                // Bind y to the result box; zero x's slot (y now owns the box, freed
                // once at y's reclamation; the exit sweep never sweeps enum slots).
                st = st.emit(ir.op_load_local(bxslot));
                st = st.emit(ir.op_store_local(yslot));
                st = st.emit(ir.op_br(1));      // matched -> exit the match
                st = st.emit(ir.op_end());      // end arm block
            },
            _ => { return s.fail(); }
        }
        i = i + 1;
    }
    st = st.emit(ir.op_end());   // end outer block
    // x's box is now aliased by y; zero x's slot so no double-free via x.
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_store_local(xslot));
    return st;
}

// register_fnvalue_local_struct_rets augments `reg` with a `f|S` entry for each
// struct-returning fn-value LOCAL `var f = g` (type_name "fn", `g` a struct-
// returning function already in `reg`) — so a later `f()` resolves its struct
// result for field / method access (#3640 slice B.1). Recurses nested bodies so
// a binding inside an if / while / for / match arm counts.
function register_fnvalue_local_struct_rets(stmts: ast.Stmt[], reg: SigReg): SigReg {
    for stmt in stmts {
        match (stmt) {
            ast.StmtVar(v) => {
                if (v.type_name == "fn") {
                    match (v.init) {
                        ast.ExprIdent(g) => {
                            var s_ty: string = sig_reg_value_of(reg, g.name);
                            if (s_ty.len() > 0) { reg = sig_reg_append(reg, v.name + "|" + s_ty); }
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => { reg = register_fnvalue_local_struct_rets(f.then_body, reg); reg = register_fnvalue_local_struct_rets(f.else_body, reg); },
            ast.StmtWhile(w) => { reg = register_fnvalue_local_struct_rets(w.body, reg); },
            ast.StmtFor(fr) => { reg = register_fnvalue_local_struct_rets(fr.body, reg); },
            ast.StmtMatch(m) => {
                for arm in m.arms { reg = register_fnvalue_local_struct_rets(arm.body, reg); }
            },
            _ => {}
        }
    }
    return reg;
}

// has_self_tail reports whether `ops` contains at least one
// `call_direct <name>/<nparams> ; return` pair worth rewriting — the tail-call
// shape TCO fires on. The pre-walk lets tco_self_tail skip the loop wrapper
// entirely for a function with no self-tail call.
function has_self_tail(ops: ir.Op[], name: string, nparams: i32): boolean {
    var i: i32 = 0;
    while (i + 1 < ops.len()) {
        var o: ir.Op = ops[i];
        if (o.kind_tag == 149 && o.str == name && o.i32_imm == nparams) {  // call_direct
            if (ops[i + 1].kind_tag == 160) { return true; }  // return
        }
        i = i + 1;
    }
    return false;
}

// tco_self_tail is the self-host port of native internal/ir/tco.go (#4328). A
// self-recursive call in tail position (`return f(args)` inside `function f`)
// lowers to two adjacent ops `call_direct f/N ; return`; this rewrites every
// such pair into a parameter rebind + a backward branch to a synthetic outer
// loop wrapping the body, so the recursion reuses the current activation
// (O(1) stack) instead of growing it until it SIGSEGVs. Conservative — only
// direct calls to the enclosing function with a matching arg count fire (the
// args were pushed left-to-right, so the store_locals pop them in reverse into
// param slots N-1..0). Functions with no self-tail call are returned unchanged
// (no wrapper). Applies to every IR backend since all lower through lower_func.
function tco_self_tail(ops: ir.Op[], name: string, nparams: i32): ir.Op[] {
    if (name.len() == 0) { return ops; }
    if (!has_self_tail(ops, name, nparams)) { return ops; }
    // Wrap the body in `loop { ... } end` (blocktype 0 = void header, as the
    // existing while-loop lowering uses; br targets the loop header to iterate).
    var wrapped: ir.Op[] = [ir.op_loop(0)];
    var wi: i32 = 0;
    while (wi < ops.len()) { wrapped = wrapped.append(ops[wi]); wi = wi + 1; }
    wrapped = wrapped.append(ir.op_end());
    var out: ir.Op[] = [];
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < wrapped.len()) {
        var o: ir.Op = wrapped[i];
        // Track scope depth BEFORE the rewrite check, so a tail call sees the
        // depth of the scope it currently sits inside (matches native applyTCO).
        if (o.kind_tag == 152 || o.kind_tag == 153 || o.kind_tag == 154) { depth = depth + 1; }  // block, loop, if
        else if (o.kind_tag == 156) { depth = depth - 1; }  // end
        var is_stc: boolean = (o.kind_tag == 149 && o.str == name && o.i32_imm == nparams);  // call_direct
        if (is_stc && i + 1 < wrapped.len() && wrapped[i + 1].kind_tag == 160) {  // return
            var p: i32 = nparams - 1;
            while (p >= 0) { out = out.append(ir.op_store_local(p)); p = p - 1; }
            // The wrapper is the outermost open scope, depth-1 levels out from
            // the innermost — a `br depth-1` to a loop re-enters its header.
            out = out.append(ir.op_br(depth - 1));
            i = i + 2;    // consume both the call_direct and the return
        } else {
            out = out.append(o);
            i = i + 1;
        }
    }
    return out;
}

// --- TRMC: tail recursion modulo cons (#4352 slice 1) -------------------------
//
// The native pass (internal/ir/trmc.go) rewrites the canonical list-builder
//     function f(x: E, ...): E { match (x) { V(h, t) => { return C(g(h), f(t, ...)); },
//                                            N => { return N; } } }
// into a hole-passing LOOP: each iteration allocates the result node with its
// tail slot left as a hole, links the node into the previous hole (or the
// result), advances the hole to the new node's tail slot, rebinds the params,
// and continues — O(1) stack instead of one frame per element (deep
// list-building recursion SIGSEGVs without it, #4352).
//
// The detector admits the same widened shapes as native's (#5334 / #5344):
// rc-neutral statements before the `match` and before an arm's tail, `when`
// guards (gated on the UNGUARDED arms still covering every variant), a `_` arm,
// a tail `if`/`else`, a bare tail self-call, and a hole that is not the last
// payload. Port adaptations that remain:
//   - the hole is the previous NODE pointer, not a raw field address, and the
//     link write is a plain op_struct_set at the hole's field index — possible
//     because every cons leaf must agree on ONE payload position
//     (trmc_hole_index), so that index is a compile-time constant. This keeps
//     the rewrite fully portable (no raw pointer stores, which the wasm backend
//     doesn't lower). Native has no such restriction: it advances a raw address,
//     so its arms may put the hole wherever they like.
//   - nodes are built by the normal op_struct_make with a 0 dummy tail, so
//     layout / shape-ptr / rc-header parity with regular construction is
//     automatic (leak-mode enum boxes, same as the un-rewritten body).
//   - all payload fields (scrutinee arms and ctor) must be width-0 kinds
//     (i32 / pointer); i64/f64 payloads keep the plain recursion for now.
//
// Consume-safety (native slice 2 — freeing the scrutinee cell per iteration) is
// scoped to the NARROW shape, exactly as native scopes it: the loop releases a
// cell only on the advance, so a widened path that can leave the loop early
// walks away from cells the caller has already retained. See trmc_consume_safe.

// trmc_count_self_calls: how many calls to bare `fname` appear in `e`.
function trmc_count_self_calls(e: ast.Expr, fname: string): i32 {
    var n: i32 = 0;
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(cid) => { if (cid.name == fname) { n = n + 1; } },
                _ => { n = n + trmc_count_self_calls(c.callee, fname); }
            }
            for arg in c.args { n = n + trmc_count_self_calls(arg, fname); }
            return n;
        },
        ast.ExprBinary(b) => { return trmc_count_self_calls(b.left, fname) + trmc_count_self_calls(b.right, fname); },
        ast.ExprUnary(u) => { return trmc_count_self_calls(u.operand, fname); },
        ast.ExprIndex(ix) => { return trmc_count_self_calls(ix.array, fname) + trmc_count_self_calls(ix.index, fname); },
        ast.ExprFieldAccess(fa) => { return trmc_count_self_calls(fa.obj, fname); },
        ast.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { n = n + trmc_count_self_calls(a.elements[i], fname); i = i + 1; }
            return n;
        },
        ast.ExprTuple(t) => {
            for el in t.elements { n = n + trmc_count_self_calls(el, fname); }
            return n;
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { n = n + trmc_count_self_calls(sl.base, fname); }
            for fv in sl.field_values { n = n + trmc_count_self_calls(fv, fname); }
            return n;
        },
        _ => { return 0; }
    }
    return n;
}

// trmc_is_enum_type: `tn` names an enum (some variant struct carries it as owner).
function trmc_is_enum_type(structs: parser.StructDecl[], tn: string): boolean {
    for sd in structs {
        if (sd.enum_owner == tn) { return true; }
    }
    return false;
}

// trmc_variant_name strips a qualified `E.V` pattern / ctor name to the bare
// variant, resolving the mangled `E__V` form when that names the decl.
function trmc_variant_name(structs: parser.StructDecl[], raw: string): string {
    var vname: string = raw;
    var vdot: i32 = 0 - 1;
    var vc: i32 = 0;
    while (vc < raw.len()) {
        if (raw[vc] == b'.') { vdot = vc; }
        vc = vc + 1;
    }
    if (vdot >= 0) { vname = slice_unchecked(raw, vdot + 1, raw.len()) + ""; }
    if (!decl_is_struct(structs, vname) && vdot >= 0) {
        var vm: string = slice_unchecked(raw, 0, vdot) + "__" + slice_unchecked(raw, vdot + 1, raw.len());
        if (decl_is_struct(structs, vm)) { vname = vm; }
    }
    return vname;
}

// trmc_variant_fields_ok: every payload field of variant `vname` is a width-0
// kind (i32 / pointer) — the v1 width gate — and the variant is an ENUM-variant
// decl (synthetic __ev fields), not a union member (whole-box binding differs).
function trmc_variant_fields_ok(structs: parser.StructDecl[], vname: string): boolean {
    var n: i32 = decl_field_count(structs, vname);
    if (n > 0 && decl_field_type(structs, vname, "__ev") == "") { return false; }   // union member
    var i: i32 = 0;
    while (i < n) {
        if (struct_field_width(structs, vname, i) != 0) { return false; }
        var ft: string = decl_field_type_at(structs, vname, i);
        if (ft == "f32") { return false; }
        i = i + 1;
    }
    return true;
}

// trmc_is_self_call: `c` is a direct, fully-applied recursive call whose own
// arguments hold no further self-call (`f(f(t))` is two holes, not one).
function trmc_is_self_call(c: ast.ExprCall, fn: parser.FuncDecl): boolean {
    var named: boolean = false;
    match (c.callee) {
        ast.ExprIdent(cid) => { if (cid.name == fn.name) { named = true; } },
        _ => {}
    }
    if (!named) { return false; }
    if (c.args.len() != fn.params.len()) { return false; }
    for a in c.args {
        if (trmc_count_self_calls(a, fn.name) != 0) { return false; }
    }
    return true;
}

// trmc_call_ctor_name: the bare variant name a constructor call spells, or "".
function trmc_call_ctor_name(c: ast.ExprCall, structs: parser.StructDecl[]): string {
    match (c.callee) {
        ast.ExprIdent(cid) => { return trmc_variant_name(structs, cid.name); },
        ast.ExprFieldAccess(cfa) => { return trmc_variant_name(structs, cfa.field); },
        _ => { return ""; }
    }
    return "";
}

// trmc_hole_arg_index: the payload position of a ctor call that IS the single
// self-call — the hole — or -1 when there is none, when a self-call is buried
// inside a payload rather than being one, or when a second payload carries one.
function trmc_hole_arg_index(c: ast.ExprCall, fn: parser.FuncDecl): i32 {
    var hole: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < c.args.len()) {
        if (trmc_count_self_calls(c.args[i], fn.name) != 0) {
            if (hole >= 0) { return 0 - 1; }
            var ok: boolean = false;
            match (c.args[i]) {
                ast.ExprCall(sc) => { ok = trmc_is_self_call(sc, fn); },
                _ => {}
            }
            if (!ok) { return 0 - 1; }
            hole = i;
        }
        i = i + 1;
    }
    return hole;
}

// trmc_leaf_kind classifies a returned expression: 0 ineligible, 1 BASE (no
// self-call — fills the final hole and breaks), 2 CONS (a ctor with one
// self-call payload — builds a node and continues), 3 SELF (a bare tail call —
// advances the params with the hole untouched, the filter shape).
function trmc_leaf_kind(e: ast.Expr, fn: parser.FuncDecl, structs: parser.StructDecl[]): i32 {
    var nself: i32 = trmc_count_self_calls(e, fn.name);
    if (nself == 0) { return 1; }
    if (nself != 1) { return 0; }
    match (e) {
        ast.ExprCall(c) => {
            if (trmc_is_self_call(c, fn)) { return 3; }
            var arm_ctor: string = trmc_call_ctor_name(c, structs);
            if (arm_ctor.len() == 0) { return 0; }
            if (!decl_is_struct(structs, arm_ctor)) { return 0; }
            if (variant_enum_owner(structs, arm_ctor) != fn.ret_type) { return 0; }
            if (!trmc_variant_fields_ok(structs, arm_ctor)) { return 0; }
            var argc: i32 = c.args.len();
            if (argc == 0) { return 0; }
            if (argc != decl_field_count(structs, arm_ctor)) { return 0; }
            if (trmc_hole_arg_index(c, fn) < 0) { return 0; }
            return 2;
        },
        _ => { return 0; }
    }
    return 0;
}

// trmc_stmt_has_return / trmc_body_has_return: a `return` anywhere inside.
// A `return` in a TRMC body must reach the hole machinery, so it is classified
// as a tail or a guard clause rather than lowered as an ordinary statement.
function trmc_stmt_has_return(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtReturn(r) => { return true; },
        ast.StmtIf(f) => { return trmc_body_has_return(f.then_body) || trmc_body_has_return(f.else_body); },
        ast.StmtWhile(w) => { return trmc_body_has_return(w.body); },
        ast.StmtFor(fr) => { return trmc_body_has_return(fr.body); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (trmc_body_has_return(arm.body)) { return true; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function trmc_body_has_return(stmts: ast.Stmt[]): boolean {
    for st in stmts {
        if (trmc_stmt_has_return(st)) { return true; }
    }
    return false;
}

// trmc_local_type: the declared type of `name` as a `var` anywhere in the
// function body, or "" when it is not one (a parameter, a binding, or absent).
function trmc_local_type(stmts: ast.Stmt[], name: string): string {
    for st in stmts {
        match (st) {
            ast.StmtVar(v) => { if (v.name == name) { return v.type_name; } },
            ast.StmtIf(f) => {
                var t1: string = trmc_local_type(f.then_body, name);
                if (t1.len() > 0) { return t1; }
                var t2: string = trmc_local_type(f.else_body, name);
                if (t2.len() > 0) { return t2; }
            },
            _ => {}
        }
    }
    return "";
}

// trmc_neutral_stmt: `st` can be lowered inside the loop by ordinary statement
// lowering without registering a release the loop's own `return` would never
// run. Only SCALAR state qualifies — a scalar `var`, an assignment to a scalar
// non-parameter local, and `if` nests of those. Anything that can bind or
// overwrite a reference-counted value declines the transform.
function trmc_neutral_stmt(st: ast.Stmt, fn: parser.FuncDecl): boolean {
    match (st) {
        ast.StmtVar(v) => { return is_scalar_type_name(v.type_name); },
        ast.StmtAssign(a) => {
            if (a.target.len() == 0) { return false; }
            for p in fn.params {
                // Rebinding a parameter would fight the loop's own advance.
                if (p.name == a.target) { return false; }
            }
            return is_scalar_type_name(trmc_local_type(fn.body, a.target));
        },
        ast.StmtIf(f) => {
            for st2 in f.then_body {
                if (!trmc_neutral_stmt(st2, fn)) { return false; }
            }
            for st3 in f.else_body {
                if (!trmc_neutral_stmt(st3, fn)) { return false; }
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// trmc_step_ok: one statement before a tail — either a guard clause
// `if (c) { …return… }`, whose branch is itself a TRMC body so its `return`
// fills the hole, or an rc-neutral statement.
function trmc_step_ok(st: ast.Stmt, fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtIf(f) => {
            if (f.else_body.len() == 0 && trmc_body_has_return(f.then_body)) {
                return trmc_body_ok(f.then_body, fn, structs);
            }
        },
        _ => {}
    }
    if (trmc_stmt_has_return(st)) { return false; }
    if (trmc_count_self_calls_stmt(st, fn.name) != 0) { return false; }
    return trmc_neutral_stmt(st, fn);
}

// trmc_count_self_calls_stmt: self-calls anywhere in a statement.
function trmc_count_self_calls_stmt(st: ast.Stmt, fname: string): i32 {
    match (st) {
        ast.StmtVar(v) => { return trmc_count_self_calls(v.init, fname); },
        ast.StmtAssign(a) => { return trmc_count_self_calls(a.value, fname); },
        ast.StmtExpr(e) => { return trmc_count_self_calls(e.value, fname); },
        ast.StmtReturn(r) => { return trmc_count_self_calls(r.value, fname); },
        ast.StmtIf(f) => {
            var n: i32 = trmc_count_self_calls(f.cond, fname);
            for st2 in f.then_body { n = n + trmc_count_self_calls_stmt(st2, fname); }
            for st3 in f.else_body { n = n + trmc_count_self_calls_stmt(st3, fname); }
            return n;
        },
        _ => { return 0; }
    }
    return 0;
}

// trmc_tail_ok: the LAST statement of a TRMC body — a `return`, or an
// `if`/`else` whose branches are themselves TRMC bodies. Both branches must be
// present: a one-armed tail `if` falls out of the arm block, which is the NEXT
// arm's variant test — the wrong continuation entirely.
function trmc_tail_ok(st: ast.Stmt, fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    match (st) {
        ast.StmtReturn(r) => { return trmc_leaf_kind(r.value, fn, structs) > 0; },
        ast.StmtIf(f) => {
            if (f.else_body.len() == 0) { return false; }
            if (!trmc_body_ok(f.then_body, fn, structs)) { return false; }
            return trmc_body_ok(f.else_body, fn, structs);
        },
        _ => { return false; }
    }
    return false;
}

// trmc_body_ok: rc-neutral steps and guard clauses, then a tail. Every path out
// of an admitted body breaks or continues the loop; none falls through.
function trmc_body_ok(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    if (stmts.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < stmts.len() - 1) {
        if (!trmc_step_ok(stmts[i], fn, structs)) { return false; }
        i = i + 1;
    }
    return trmc_tail_ok(stmts[stmts.len() - 1], fn, structs);
}

// trmc_body_hole_index: the payload position every CONS leaf in a body puts its
// self-call at, or -1 when the body has no cons leaf. `seed` carries the index
// agreed so far; a leaf that disagrees returns -2, which poisons the whole scan.
// The link write is an op_struct_set at a COMPILE-TIME field index, so every
// node the loop can have built must carry its hole at the same one.
function trmc_body_hole_index(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: parser.StructDecl[], seed: i32): i32 {
    var acc: i32 = seed;
    for st in stmts {
        if (acc == 0 - 2) { return acc; }
        match (st) {
            ast.StmtReturn(r) => {
                if (trmc_leaf_kind(r.value, fn, structs) == 2) {
                    match (r.value) {
                        ast.ExprCall(c) => {
                            var hi: i32 = trmc_hole_arg_index(c, fn);
                            if (acc >= 0 && acc != hi) { return 0 - 2; }
                            acc = hi;
                        },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                acc = trmc_body_hole_index(f.then_body, fn, structs, acc);
                acc = trmc_body_hole_index(f.else_body, fn, structs, acc);
            },
            _ => {}
        }
    }
    return acc;
}

// trmc_hole_index: the single payload position the loop's hole occupies, or -1
// when the function has no cons leaf or its leaves disagree. Read by emit_trmc
// for the link write's field index.
pub function trmc_hole_index(fn: parser.FuncDecl, structs: parser.StructDecl[]): i32 {
    var acc: i32 = 0 - 1;
    var mi: i32 = fn.body.len() - 1;
    if (mi < 0) { return 0 - 1; }
    acc = trmc_body_hole_index(slice_stmts_upto(fn.body, mi), fn, structs, acc);
    if (acc == 0 - 2) { return 0 - 1; }
    match (fn.body[mi]) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                acc = trmc_body_hole_index(arm.body, fn, structs, acc);
                if (acc == 0 - 2) { return 0 - 1; }
            }
        },
        _ => { return 0 - 1; }
    }
    if (acc == 0 - 2) { return 0 - 1; }
    return acc;
}

// slice_stmts_upto: the first `n` statements of a body.
function slice_stmts_upto(stmts: ast.Stmt[], n: i32): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    var i: i32 = 0;
    while (i < n && i < stmts.len()) { out = out.append(stmts[i]); i = i + 1; }
    return out;
}

// trmc_arms_total: the UNGUARDED arms alone cover every variant of the
// scrutinee enum. A failing guard falls through to the next arm, and TRMC has
// no fall-through-to-join — falling off the last arm re-enters the loop with
// the scrutinee unchanged, which is a hang rather than a wrong answer.
function trmc_arms_total(m: ast.StmtMatch, structs: parser.StructDecl[], scrut_ty: string): boolean {
    var covered: string[] = [];
    for arm in m.arms {
        if (arm.has_guard) { continue; }
        match (arm.pattern) {
            ast.PatWildcard(w) => { return true; },
            ast.PatVariant(pv) => { covered = covered.append(trmc_variant_name(structs, pv.type_name)); }
        }
    }
    var seen: i32 = 0;
    for sd in structs {
        if (sd.enum_owner != scrut_ty) { continue; }
        seen = seen + 1;
        if (util.index_of_str(covered, sd.name) < 0) { return false; }
    }
    return seen > 0;
}

// trmc_eligible: fn is a single-hole modulo-cons shape — returns the variant
// name of its first recursive-arm ctor, or "" when ineligible. Gates mirror
// native detectTrmc (internal/ir/trmc.go) plus the width-0 restriction
// documented above; the hole's field index comes from trmc_hole_index, which
// requires every cons leaf to agree on one compile-time position.
function trmc_eligible(fn: parser.FuncDecl, structs: parser.StructDecl[]): string {
    if (fn.receiver_type.len() > 0) { return ""; }
    if (fn.type_params.len() > 0) { return ""; }
    if (fn.body.len() == 0) { return ""; }
    if (!trmc_is_enum_type(structs, fn.ret_type)) { return ""; }
    // The body must END in a `match`; everything before it is rc-neutral setup,
    // emitted INSIDE the loop because the recursion re-enters it.
    var mi: i32 = fn.body.len() - 1;
    var m_scrut: string = "";
    match (fn.body[mi]) {
        ast.StmtMatch(m0) => {
            match (m0.scrutinee) {
                ast.ExprIdent(sid) => { m_scrut = sid.name; },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    if (m_scrut.len() == 0) { return ""; }
    var pfx: i32 = 0;
    while (pfx < mi) {
        if (!trmc_step_ok(fn.body[pfx], fn, structs)) { return ""; }
        pfx = pfx + 1;
    }
    // scrutinee must be a param of enum type.
    var mp: i32 = 0 - 1;
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        if (fn.params[pi].name == m_scrut) { mp = pi; }
        pi = pi + 1;
    }
    if (mp < 0) { return ""; }
    // An `own` scrutinee is MOVED into the callee, which owes it a consuming
    // release the borrow-model loop does not emit. Native's detectTrmc refuses
    // it; the port never did.
    if (fn.params[mp].own) { return ""; }
    var scrut_ty: string = fn.params[mp].type_name;
    if (!trmc_is_enum_type(structs, scrut_ty)) { return ""; }
    var ctor: string = "";
    var any_cons: boolean = false;
    match (fn.body[mi]) {
        ast.StmtMatch(m) => {
            if (!trmc_arms_total(m, structs, scrut_ty)) { return ""; }
            for arm in m.arms {
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        // The arm binds payloads by hand, so there is nowhere to put
                        // an `@` whole-value name; a nested or literal-folded pattern
                        // carries a test this rewrite does not emit.
                        if (pv.at_binding.len() > 0) { return ""; }
                        if (pv.nested.len() > 0) { return ""; }
                        if (pv.has_lit_cond) { return ""; }
                        if (pv.tup_kinds.len() > 0) { return ""; }
                        var vname: string = trmc_variant_name(structs, pv.type_name);
                        if (!decl_is_struct(structs, vname)) { return ""; }
                        if (!trmc_variant_fields_ok(structs, vname)) { return ""; }
                    },
                    ast.PatWildcard(w) => {}
                }
                if (!trmc_body_ok(arm.body, fn, structs)) { return ""; }
                var ac: string = trmc_body_first_cons_ctor(arm.body, fn, structs);
                if (ac.len() > 0) {
                    any_cons = true;
                    if (ctor.len() == 0) { ctor = ac; }
                }
            }
        },
        _ => { return ""; }
    }
    // At least one constructor-wrapped self-call: that is what makes a function
    // modulo-cons rather than plainly tail-recursive.
    if (!any_cons) { return ""; }
    if (trmc_hole_index(fn, structs) < 0) { return ""; }
    return ctor;
}

// trmc_body_first_cons_ctor: the variant name of the first CONS leaf in a body,
// or "" when it has none.
function trmc_body_first_cons_ctor(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: parser.StructDecl[]): string {
    for st in stmts {
        match (st) {
            ast.StmtReturn(r) => {
                if (trmc_leaf_kind(r.value, fn, structs) == 2) {
                    match (r.value) {
                        ast.ExprCall(c) => { return trmc_call_ctor_name(c, structs); },
                        _ => {}
                    }
                }
            },
            ast.StmtIf(f) => {
                var t1: string = trmc_body_first_cons_ctor(f.then_body, fn, structs);
                if (t1.len() > 0) { return t1; }
                var t2: string = trmc_body_first_cons_ctor(f.else_body, fn, structs);
                if (t2.len() > 0) { return t2; }
            },
            _ => {}
        }
    }
    return "";
}

// trmc_consume_safe reports whether an eligible TRMC function may CONSUME its
// scrutinee — free each cell as the loop walks past it — the self-host port of
// native's trmcShapeConsumeSafe (internal/ir/trmc.go). Without it a consuming
// recursive build holds the whole input list live until the caller drops it;
// with it the walked cells recycle through the freelist into the nodes the loop
// is allocating, so peak heap is the OUTPUT rather than input + output.
//
// The loop STEALS the tail out of the cell it is about to free, so the cell can
// only be freed SHALLOWLY, and that is sound exactly when nothing else in the
// cell needs a drop. Hence: every recursive arm advances the matched param to
// one of its OWN bindings, that binding is a same-class cell of the scrutinee
// enum (the stolen tail), and every OTHER payload field is a flat scalar —
// copied, never rc-tracked, so a shallow free cannot strand it. A string or
// container payload fails the scan and the function keeps the borrow model.
// trmc_matched_param returns the parameter index the TRMC body matches on, or
// -1. The scrutinee is the cell the loop walks and frees, so both the consume
// scan and the call-site retain are keyed on it.
pub function trmc_matched_param(fn: parser.FuncDecl): i32 {
    if (fn.body.len() == 0) { return 0 - 1; }
    var m_scrut: string = "";
    match (fn.body[fn.body.len() - 1]) {
        ast.StmtMatch(m0) => {
            match (m0.scrutinee) {
                ast.ExprIdent(sid) => { m_scrut = sid.name; },
                _ => { return 0 - 1; }
            }
        },
        _ => { return 0 - 1; }
    }
    var mp: i32 = 0 - 1;
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        if (fn.params[pi].name == m_scrut) { mp = pi; }
        pi = pi + 1;
    }
    return mp;
}

function trmc_consume_safe(fn: parser.FuncDecl, structs: parser.StructDecl[]): boolean {
    var mp: i32 = trmc_matched_param(fn);
    if (mp < 0) { return false; }
    var scrut_ty: string = fn.params[mp].type_name;
    if (!trmc_is_enum_type(structs, scrut_ty)) { return false; }
    // NARROW shape only. The loop releases a cell on the ADVANCE, so every
    // widened path that can leave it early — a guard-false landing in a later
    // base arm, a branch tail whose base leaf fires mid-list, a `return` before
    // the arms — walks away from the cells still ahead of it, which the caller
    // has already retained for us. Those shapes still get TRMC; they keep the
    // borrow model. Scalar setup that cannot exit early is admitted: it changes
    // nothing about which cells the loop walks past.
    var mi: i32 = fn.body.len() - 1;
    var pfx: i32 = 0;
    while (pfx < mi) {
        if (trmc_stmt_has_return(fn.body[pfx])) { return false; }
        pfx = pfx + 1;
    }
    match (fn.body[mi]) {
        ast.StmtMatch(m) => {
            for arm in m.arms {
                if (arm.has_guard) { return false; }
                if (arm.body.len() != 1) { return false; }
                var vname: string = "";
                var binds: string[] = [];
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        vname = trmc_variant_name(structs, pv.type_name);
                        binds = binds.append(pv.binding);
                        var eb: i32 = 0;
                        while (eb < pv.extra_bindings.len()) { binds = binds.append(pv.extra_bindings[eb]); eb = eb + 1; }
                    },
                    _ => { return false; }
                }
                match (arm.body[0]) {
                    ast.StmtReturn(r) => {
                        if (trmc_leaf_kind(r.value, fn, structs) == 2) {
                            // The self-call's matched-param argument names the cell the
                            // loop advances to; it must be a bare binding of THIS arm,
                            // not a computed value that would leave the tail unreachable.
                            var adv: string = "";
                            match (r.value) {
                                ast.ExprCall(c) => {
                                    var hi: i32 = trmc_hole_arg_index(c, fn);
                                    if (hi < 0) { return false; }
                                    match (c.args[hi]) {
                                        ast.ExprCall(sc) => {
                                            if (mp >= sc.args.len()) { return false; }
                                            match (sc.args[mp]) {
                                                ast.ExprIdent(aid) => { adv = aid.name; },
                                                _ => { return false; }
                                            }
                                        },
                                        _ => { return false; }
                                    }
                                },
                                _ => { return false; }
                            }
                            if (adv.len() == 0 || adv == "_") { return false; }
                            var tail_bi: i32 = util.index_of_str(binds, adv);
                            if (tail_bi < 0) { return false; }
                            // Field types are checked for EVERY payload position, not
                            // only the named ones: a `_`-bound container is just as
                            // stranded by a shallow free as a named one.
                            var nf: i32 = decl_field_count(structs, vname);
                            var fi: i32 = 0;
                            while (fi < nf) {
                                var fname: string = "__ev";
                                if (fi > 0) { fname = "__ev" + util.i32_to_string(fi); }
                                var fty: string = decl_field_type(structs, vname, fname);
                                if (fi == tail_bi) {
                                    if (fty != scrut_ty) { return false; }
                                } else {
                                    if (!is_scalar_type_name(fty)) { return false; }
                                }
                                fi = fi + 1;
                            }
                        } else {
                            // A bare tail self-call or a branch tail is outside the
                            // narrow shape; only cons and base leaves are.
                            if (trmc_leaf_kind(r.value, fn, structs) != 1) { return false; }
                        }
                    },
                    _ => { return false; }
                }
            }
        },
        _ => { return false; }
    }
    return true;
}

// TrmcCtx carries the loop-invariant state the recursive TRMC emitters need:
// the hole / result / still slots, the scrutinee slot, the hole's field index,
// the `br` depths that reach the loop's continue and break edges from wherever
// the emitter currently is, and a path-unique prefix for temp names.
struct TrmcCtx {
    hole: i32,
    res: i32,
    still: i32,
    mslot: i32,
    tail_idx: i32,
    consuming: boolean,
    cont_d: i32,
    brk_d: i32,
    uid: string
}

// emit_trmc lowers an eligible fn (trmc_eligible returned `ctor`) as the
// hole-passing loop. Emits the COMPLETE body (including the final return); the
// caller skips the normal statement loop and the exit machinery — a TRMC body
// has no swept-class locals (params are borrowed; the setup statements the
// detector admits are scalar-only; binds/temps are scalars or enum boxes,
// leak-mode like the un-rewritten construction).
//
// Block shape (br depths from inside an arm block):
//   block(exit)            // br 2 = break with result
//     loop                 // br 1 = continue (next iteration)
//       [setup statements] // the statements before the `match`, re-run per
//                          // iteration because the recursion re-enters them
//       [per arm] block    // br 0 = skip arm (variant mismatch / guard false)
//         variant_is test; payload binds; optional guard test;
//         cons: heads -> temps; node = struct_make(arm ctor, heads…, 0 at hole);
//               hole-link(node); hole = node; rebind params; br 1
//         self: rebind params; br 1        // hole untouched — the filter shape
//         base: value -> temp; hole-link(value); br 2
//       end
//     end
//   end
//   load result; return
// A tail `if`/`else` nests both branches under an op_if, which is why the br
// depths ride in TrmcCtx rather than being written as literals.
// hole-link(v): if (hole == 0) { result = v } else { hole.<tail_idx> = v } — the
// hole's field index is one compile-time constant because trmc_hole_index gates
// every cons leaf to the same payload position, so the link is a plain
// struct_set into the node the previous iteration built.
function emit_trmc(fn: parser.FuncDecl, ctor: string, sin: LowerState): LowerState {
    var s: LowerState = sin;
    var tail_idx: i32 = trmc_hole_index(fn, s.structs);
    s = s.add_local("$trmc_hole");
    var hole: i32 = s.slot_of("$trmc_hole");
    s = s.add_local("$trmc_res");
    var res: i32 = s.slot_of("$trmc_res");
    s = s.emit(ir.op_const_i32(0));
    s = s.emit(ir.op_store_local(hole));
    s = s.emit(ir.op_const_i32(0));
    s = s.emit(ir.op_store_local(res));
    // Consuming traversal (#5333): `$trmc_still` stays 1 until the walk reaches a
    // SHARED cell. Up to that point each cell the loop leaves behind is released
    // and recycles through the freelist into the node the next iteration
    // allocates; from it on, the rest of the list belongs to the sharer and is
    // left alone. Declared even when unused so the slot numbering below does not
    // fork on the verdict.
    // Read the VERDICT, never re-derive it: the loop's release is only sound
    // paired with the call-site retain, and both read this registry.
    var consuming: boolean = s.is_trmc_consume_arg(fn.name, trmc_matched_param(fn));
    s = s.add_local("$trmc_still");
    var still: i32 = s.slot_of("$trmc_still");
    if (consuming) {
        s = s.emit(ir.op_const_i32(1));
        s = s.emit(ir.op_store_local(still));
    }
    var mi: i32 = fn.body.len() - 1;
    var mslot: i32 = 0 - 1;
    match (fn.body[mi]) {
        ast.StmtMatch(m0) => {
            match (m0.scrutinee) {
                ast.ExprIdent(sid) => { mslot = s.slot_of(sid.name); },
                _ => {}
            }
        },
        _ => {}
    }
    var base: TrmcCtx = TrmcCtx { hole: hole, res: res, still: still, mslot: mslot,
        tail_idx: tail_idx, consuming: consuming, cont_d: 1, brk_d: 2, uid: "" };
    s = s.emit(ir.op_block(0));   // exit
    s = s.emit(ir.op_loop(0));
    // The statements before the `match` belong INSIDE the loop: the recursion
    // re-enters them, so hoisting them out would freeze a local derived from a
    // parameter at its first-call value while the loop advances that parameter
    // underneath it. One level shallower than an arm body — no arm block yet.
    var pctx: TrmcCtx = TrmcCtx { ...base, cont_d: 0, brk_d: 1, uid: "p" };
    var pfx: i32 = 0;
    while (pfx < mi) {
        var ps: LowerState = emit_trmc_step(fn.body[pfx], fn, pctx, s, pfx);
        if (!ps.ok) { return ps; }
        s = ps;
        pfx = pfx + 1;
    }
    match (fn.body[mi]) {
        ast.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: ast.MatchArm = m.arms[ai];
                var vname: string = "";
                var binds: string[] = [];
                var wild: boolean = false;
                match (arm.pattern) {
                    ast.PatVariant(pv) => {
                        vname = trmc_variant_name(s.structs, pv.type_name);
                        binds = binds.append(pv.binding);
                        var eb: i32 = 0;
                        while (eb < pv.extra_bindings.len()) { binds = binds.append(pv.extra_bindings[eb]); eb = eb + 1; }
                    },
                    ast.PatWildcard(w) => { wild = true; }
                }
                s = s.emit(ir.op_block(0));   // arm
                if (!wild) {
                    s = s.emit(ir.op_load_local(mslot));
                    s = s.emit(ir.op_variant_is(vname));
                    s = s.emit(ir.op_bin("not", 0, false));
                    s = s.emit(ir.op_brif(0));
                    // payload binds (width-0 fields only — the detection gate).
                    var bi: i32 = 0;
                    while (bi < binds.len() && bi < decl_field_count(s.structs, vname)) {
                        var bname: string = binds[bi];
                        if (bname.len() > 0 && bname != "_") {
                            var fname: string = "__ev";
                            if (bi > 0) { fname = "__ev" + util.i32_to_string(bi); }
                            var ev_ty: string = decl_field_type(s.structs, vname, fname);
                            s = s.add_local(bname);
                            var bslot: i32 = s.slot_of(bname);
                            s = s.emit(ir.op_load_local(mslot));
                            s = s.emit(ir.op_struct_get(bi, 0));
                            s = s.emit(ir.op_store_local(bslot));
                            if (ev_ty == "string") { s = s.mark_str(bslot, true); }
                            else if (decl_is_struct(s.structs, ev_ty) || is_enum_like_name(ev_ty, s.structs)) { s = s.mark_struct_type(bslot, ev_ty); }
                        }
                        bi = bi + 1;
                    }
                }
                // With the bindings in locals, a `when` guard decides whether the
                // arm really matches; on false fall through to the next arm.
                if (arm.has_guard) {
                    var gl: LowerState = lower_expr(arm.guard, s);
                    if (!gl.ok) { return gl; }
                    s = gl.emit(ir.op_bin("not", 0, false));
                    s = s.emit(ir.op_brif(0));
                }
                var actx: TrmcCtx = TrmcCtx { ...base, uid: util.i32_to_string(ai) };
                var bs: LowerState = emit_trmc_body(arm.body, fn, actx, s);
                if (!bs.ok) { return bs; }
                s = bs;
                s = s.emit(ir.op_end());   // arm block
                ai = ai + 1;
            }
        },
        _ => {}
    }
    s = s.emit(ir.op_end());   // loop
    s = s.emit(ir.op_end());   // exit block
    s = s.emit(ir.op_load_local(res));
    s = s.emit(ir.op_return());
    return s;
}

// emit_trmc_step lowers one statement before a tail: a guard clause
// `if (c) { …return… }` as a nested body under an op_if (so its `return`
// reaches the hole machinery), anything else through ordinary lowering.
function emit_trmc_step(st: ast.Stmt, fn: parser.FuncDecl, ctx: TrmcCtx, sin: LowerState, idx: i32): LowerState {
    var guard_body: ast.Stmt[] = [];
    var guard_cond: ast.Expr = parser.e_bool(true);
    var is_guard: boolean = false;
    match (st) {
        ast.StmtIf(f) => {
            if (f.else_body.len() == 0 && trmc_body_has_return(f.then_body)) {
                is_guard = true;
                guard_cond = f.cond;
                guard_body = f.then_body;
            }
        },
        _ => {}
    }
    if (!is_guard) { return lower_stmt(st, sin); }
    var cl: LowerState = lower_expr(guard_cond, sin);
    if (!cl.ok) { return cl; }
    var s: LowerState = cl.emit(ir.op_if(0));
    var inner: TrmcCtx = TrmcCtx { ...ctx, cont_d: ctx.cont_d + 1, brk_d: ctx.brk_d + 1,
        uid: ctx.uid + "g" + util.i32_to_string(idx) };
    var bs: LowerState = emit_trmc_body(guard_body, fn, inner, s);
    if (!bs.ok) { return bs; }
    return bs.emit(ir.op_end());
}

// emit_trmc_body lowers a classified body: its steps, then the tail that leaves
// or re-enters the loop.
function emit_trmc_body(stmts: ast.Stmt[], fn: parser.FuncDecl, ctx: TrmcCtx, sin: LowerState): LowerState {
    var s: LowerState = sin;
    var i: i32 = 0;
    while (i < stmts.len() - 1) {
        var ss: LowerState = emit_trmc_step(stmts[i], fn, ctx, s, i);
        if (!ss.ok) { return ss; }
        s = ss;
        i = i + 1;
    }
    return emit_trmc_tail(stmts[stmts.len() - 1], fn, ctx, s);
}

// emit_trmc_tail lowers the last statement of a body — a `return` leaf, or an
// `if`/`else` whose branches are themselves bodies.
function emit_trmc_tail(st: ast.Stmt, fn: parser.FuncDecl, ctx: TrmcCtx, sin: LowerState): LowerState {
    match (st) {
        ast.StmtReturn(r) => { return emit_trmc_leaf(r.value, fn, ctx, sin); },
        ast.StmtIf(f) => {
            var cl: LowerState = lower_expr(f.cond, sin);
            if (!cl.ok) { return cl; }
            var s: LowerState = cl.emit(ir.op_if(0));
            var tctx: TrmcCtx = TrmcCtx { ...ctx, cont_d: ctx.cont_d + 1, brk_d: ctx.brk_d + 1, uid: ctx.uid + "t" };
            var ts: LowerState = emit_trmc_body(f.then_body, fn, tctx, s);
            if (!ts.ok) { return ts; }
            s = ts.emit(ir.op_else());
            var ectx: TrmcCtx = TrmcCtx { ...ctx, cont_d: ctx.cont_d + 1, brk_d: ctx.brk_d + 1, uid: ctx.uid + "e" };
            var es: LowerState = emit_trmc_body(f.else_body, fn, ectx, s);
            if (!es.ok) { return es; }
            return es.emit(ir.op_end());
        },
        _ => {}
    }
    return sin;
}

// emit_trmc_hole_link: if (hole == 0) { result = v } else { hole.<tail_idx> = v }.
function emit_trmc_hole_link(vslot: i32, ctx: TrmcCtx, sin: LowerState): LowerState {
    var s: LowerState = sin;
    s = s.emit(ir.op_load_local(ctx.hole));
    s = s.emit(ir.op_bin("not", 0, false));
    s = s.emit(ir.op_if(0));
    s = s.emit(ir.op_load_local(vslot));
    s = s.emit(ir.op_store_local(ctx.res));
    s = s.emit(ir.op_else());
    s = s.emit(ir.op_load_local(ctx.hole));
    s = s.emit(ir.op_load_local(vslot));
    s = s.emit(ir.op_struct_set(ctx.tail_idx, 0));
    s = s.emit(ir.op_end());
    return s;
}

// emit_trmc_advance rebinds the params to the recursive call's arguments, then
// continues. Every argument is evaluated into a temp FIRST (they read the
// current params / bindings), so a self-call that permutes or increments a
// scalar param cannot clobber an input it still needs.
function emit_trmc_advance(sc: ast.ExprCall, ctx: TrmcCtx, sin: LowerState): LowerState {
    var s: LowerState = sin;
    var aslots: i32[] = [];
    var sai: i32 = 0;
    while (sai < sc.args.len()) {
        var atmp: string = "$trmc_a" + ctx.uid + "_" + util.i32_to_string(sai);
        var al: LowerState = lower_expr(sc.args[sai], s);
        if (!al.ok) { return al; }
        s = al.add_local(atmp);
        var aslot: i32 = s.slot_of(atmp);
        s = s.emit(ir.op_store_local(aslot));
        aslots = aslots.append(aslot);
        sai = sai + 1;
    }
    // Release the just-walked cell HERE: after every read of it (the payload
    // binds, the head temps and the self-call argument temps above) and before
    // the param store overwrites the slot with the tail. `__fern_rc_dec` is the
    // shallow release — payload drops are emitted by the compiler, not by the
    // dec — which is what lets the stolen tail survive its parent. A cell that
    // is not uniquely owned ends the freeing instead: the dec balances the
    // caller's reference and the remaining list is left to whoever else holds it.
    if (ctx.consuming) {
        s = s.emit(ir.op_load_local(ctx.still));
        s = s.emit(ir.op_if(0));
        s = s.emit(ir.op_load_local(ctx.mslot));
        s = s.emit(ir.op_call_direct("__fern_rc_is_unique", 1));
        s = s.emit(ir.op_bin("not", 0, false));
        s = s.emit(ir.op_if(0));
        s = s.emit(ir.op_const_i32(0));
        s = s.emit(ir.op_store_local(ctx.still));
        s = s.emit(ir.op_end());
        s = s.emit(ir.op_load_local(ctx.mslot));
        s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));
        s = s.emit(ir.op_drop());
        s = s.emit(ir.op_end());
    }
    var pj: i32 = 0;
    while (pj < aslots.len()) {
        s = s.emit(ir.op_load_local(aslots[pj]));
        s = s.emit(ir.op_store_local(pj));
        pj = pj + 1;
    }
    return s;
}

// emit_trmc_leaf lowers one returned expression as a loop edge: a CONS builds
// its node with the hole payload left at 0, links it, advances the hole and
// continues; a bare SELF call advances the params with the hole untouched; a
// BASE value fills the final hole and breaks.
function emit_trmc_leaf(e: ast.Expr, fn: parser.FuncDecl, ctx: TrmcCtx, sin: LowerState): LowerState {
    var s: LowerState = sin;
    var kind: i32 = trmc_leaf_kind(e, fn, s.structs);
    if (kind == 1) {
        // base arm: value -> temp; hole-link; break.
        var vl: LowerState = lower_expr(e, s);
        if (!vl.ok) { return vl; }
        var vtmp: string = "$trmc_v" + ctx.uid;
        s = vl.add_local(vtmp);
        var vslot: i32 = s.slot_of(vtmp);
        s = s.emit(ir.op_store_local(vslot));
        s = emit_trmc_hole_link(vslot, ctx, s);
        return s.emit(ir.op_br(ctx.brk_d));
    }
    match (e) {
        ast.ExprCall(c) => {
            if (kind == 3) {
                // A plain tail call: the hole is already where this arm's result
                // belongs, so only the parameters advance.
                var ss: LowerState = emit_trmc_advance(c, ctx, s);
                if (!ss.ok) { return ss; }
                return ss.emit(ir.op_br(ctx.cont_d));
            }
            var argc: i32 = c.args.len();
            var hidx: i32 = trmc_hole_arg_index(c, fn);
            // Each cons leaf builds its OWN variant; trmc_hole_index pins them
            // only to one hole position.
            var arm_ctor: string = trmc_call_ctor_name(c, s.structs);
            // heads -> temps (evaluated BEFORE the node alloc, reading the
            // current bindings).
            var hslots: i32[] = [];
            var hi: i32 = 0;
            while (hi < argc) {
                if (hi != hidx) {
                    var htmp: string = "$trmc_h" + ctx.uid + "_" + util.i32_to_string(hslots.len());
                    var hl: LowerState = lower_expr(c.args[hi], s);
                    if (!hl.ok) { return hl; }
                    s = hl.add_local(htmp);
                    var hs: i32 = s.slot_of(htmp);
                    s = s.emit(ir.op_store_local(hs));
                    hslots = hslots.append(hs);
                }
                hi = hi + 1;
            }
            // node = struct_make(arm_ctor, heads…, 0 at the hole position).
            var li: i32 = 0;
            var hk: i32 = 0;
            while (li < argc) {
                if (li == hidx) {
                    s = s.emit(ir.op_const_i32(0));
                } else {
                    s = s.emit(ir.op_load_local(hslots[hk]));
                    hk = hk + 1;
                }
                li = li + 1;
            }
            s = s.emit(ir.op_struct_make(arm_ctor, argc, decl_index_of(s.structs, arm_ctor)));
            var ntmp: string = "$trmc_n" + ctx.uid;
            s = s.add_local(ntmp);
            var nslot: i32 = s.slot_of(ntmp);
            s = s.emit(ir.op_store_local(nslot));
            s = emit_trmc_hole_link(nslot, ctx, s);
            // hole = node.
            s = s.emit(ir.op_load_local(nslot));
            s = s.emit(ir.op_store_local(ctx.hole));
            match (c.args[hidx]) {
                ast.ExprCall(sc) => {
                    var as2: LowerState = emit_trmc_advance(sc, ctx, s);
                    if (!as2.ok) { return as2; }
                    s = as2;
                },
                _ => {}
            }
            return s.emit(ir.op_br(ctx.cont_d));
        },
        _ => {}
    }
    return s;
}

// lower_func lowers a whole function's body. Params take slots 0..n-1.
pub function lower_func(fn: parser.FuncDecl, structs: parser.StructDecl[], sg: FnSigs, for_wasm: boolean): LowerResult {
    // #4380 lever 3: mark in-bounds `arr[i]` reads (a `while (i < arr.len())`
    // guard proves them) so the ExprIndex lowering emits op_arr_get_nc. Runs
    // here — after every AST transform — so no later pass clobbers the flag.
    fn = parser.FuncDecl { ...fn, body: parser.elide_len_bounded_body(fn.body) };
    var empty: ir.Op[] = [];
    var noslots: i32[] = [];
    // ret_i64: does this function return i64 (so `return <i64expr>` lowers via
    // lower_i64, and the wasm signature carries (result i64))?
    // u64 returns ride the same i64 64-bit path (only signedness of the value's
    // own ops differs, already handled at the producing expression) (#2904).
    var ret_i64: boolean = fn.ret_type == "i64" || fn.ret_type == "u64";
    var ret_i64arr: boolean = fn.ret_type == "i64[]";
    // ret_dyn: this function returns a SCALAR `dyn Trait` (not a `dyn Trait[]`
    // array), so `return <expr>` coerces the value to `dyn Trait` via
    // lower_dyn_arg (box a primitive/string, leave a struct/enum unboxed).
    var ret_dyn: boolean = fn.ret_type.len() > 4 && slice_unchecked(fn.ret_type, 0, 4) == "dyn " && !is_array_type_name(fn.ret_type);
    // f64[]/i64[]-returning functions ARE lowered now — including METHODS:
    // sg.f64arr_ret_fns / sg.i64arr_ret_fns record them keyed by bare name (free fns)
    // or "<Type>.<method>" (methods), so a call site `var x = obj.f()`
    // element-width-tracks x as f64[]/i64[] (expr_is_f64arr / expr_is_i64arr's
    // method-call case) and a later x[i] reads an 8-byte f64/i64. The body
    // returns an f64/i64-array pointer (move-on-return like any array); a method
    // adds nothing array-specific — the receiver binds as slot 0 like any other
    // method, so the array-return and method machineries simply compose.
    // A FREE function with f64 in its signature IS lowered now: an f64 param is
    // marked f64 in the local table (so it loads/stores like any 8-byte value
    // and the wasm sig declares (param f64)); an f64 return lowers its value
    // expr (which the float ops already produce) and the wasm sig declares
    // (result f64). The register backends need no ABI change (f64 rides the
    // 8-byte slot). A METHOD with f64 in its signature IS lowered too now:
    // f64_ret_fns_of records methods keyed "<Type>.<method>", so the call site
    // recovers the result's f64-ness (expr_is_f64's method case); f64 args ride
    // lower_expr like any f64 value. (i64 methods get the same treatment below.)
    // A string-returning function IS lowered: its body returns a string box (an
    // 8-byte pointer, like any value), and the call site tracks the result as a
    // string via sg.str_ret_fns (see expr_is_str). A string[]-returning function is
    // lowered too: string[] is an ordinary rc-tracked array (move-on-return like
    // any array), and the call site tracks element string-ness via sg.strarr_ret_fns
    // (see expr_is_strarr). The string elements leak — never freed — matching the
    // leak-safe string-array model. Neither return shape bails anymore.
    // A struct-returning function IS lowered when the struct is leaf-safe (all
    // scalar fields): the body returns the struct's heap pointer (like any
    // value), and a call site recovers the struct type via sg.struct_ret_fns (see
    // struct_ret_type) to type later `p.x` field access. A non-leaf-safe struct
    // (array / nested-struct fields needing RC) still bails — matching the
    // scalar-only struct param / receiver constraint below.
    if (decl_is_struct(structs, fn.ret_type)) {
        if (!decl_is_leaksafe(structs, fn.ret_type)) {
            return lower_failed(fn, "returns struct `" + fn.ret_type + "`, which is not leak-safe (a field needs RC)");
        }
    }
    // A tuple-returning function IS lowered when every element is scalar (i32 /
    // bool / i64 / f64) or string: the body returns a tuple box (an 8-byte
    // pointer, like any value) whose elements ride uniform 8-byte slots, and a
    // call site recovers the element tags via sg.tuple_ret_fns (see tuple_ret_type)
    // to type `.N` / destructure — including the 8-byte i64.load/f64.load width
    // for an i64/f64 element (op_tuple_get_w in the `.N` and destructure paths).
    // Leaf-safe struct elements are allowed too (leak-only pointers, recovered by
    // type tag). Tuples with array / Option elements still bail — those would
    // need RC / payload threading through the return — keeping them local-only.
    // Only a BARE tuple return (`(A, B)`) is gated here. A tuple-ARRAY return
    // (`(A, B)[]`) starts with '(' too but is an array — it takes the generic
    // array move-on-return path (like P[] / string[]), so exclude array types
    // (else tuple_elem_tags chokes on the trailing "[]" and wrongly bails).
    if (fn.ret_type.len() > 0 && fn.ret_type[0] == b'(' && !is_array_type_name(fn.ret_type)) {
        if (!tuple_elems_lowerable(fn.ret_type, structs)) {
            return lower_failed(fn, "returns tuple `" + fn.ret_type + "`, whose elements are not all lowerable");
        }
    }
    // i64 params + returns ARE lowered now: an i64 param is marked i64 in the
    // local table below (so it loads/stores as i64 and the wasm sig declares
    // (param i64)); an i64 return lowers `return` via lower_i64 and the wasm sig
    // declares (result i64). x86-64/arm64 need no ABI change (i64 shares the
    // 64-bit slot). The register backends keep their stack-arg ABI; only wasm's
    // typed signature differs, handled in the backend from fn.params/fn.ret_type.
    // A METHOD with i64 in its signature IS lowered now: i64_ret_fns_of records
    // its i64 SIGNATURE keyed "<Type>.<method>", so the call site recovers the
    // result's i64-ness (infer_expr_width / lower_i64 method cases) and routes
    // i64 args through lower_i64 (param_is_i64 keyed by the same label). An
    // i64-field-reading body (`return c.base`) works now that i64 struct fields
    // lower (#2733: struct_get_i64).
    var names: string[] = [];
    var isarr: boolean[] = [];
    var isstr: boolean[] = [];
    var isstrarr: boolean[] = [];
    var structty: string[] = [];
    var optty: string[] = [];
    // closure/fn param -> its Option/Result return type (from ParamDecl.fn_ret),
    // "<name>|<type>". Seeds LowerState.closure_opt_rets so a direct closure-call
    // match scrutinee recovers the Option type (find_map-shaped combinators).
    var tupty: string[] = [];
    var mapty: string[] = [];
    // A Cell[T] PARAM's element type (#3457 slice 5): the local-annotation path
    // marks a `var c: Cell[i32]` slot is_cell, but the param columns hard-coded
    // is_cell false, so `c.get()` on a PARAMETER keyed "i32.get" — an unknown
    // symbol — and bailed the whole module. The map column
    // right above is the same shape, added for the same reason (#map-param).
    var cellty: string[] = [];
    var isi64: boolean[] = [];
    var isf64: boolean[] = [];
    var isf32: boolean[] = [];
    var isf64arr: boolean[] = [];
    // f32[] params take the dispatch overlay too — see LocalInfo.is_f32arr.
    var isf32arr: boolean[] = [];
    var isi64arr: boolean[] = [];
    var isboolarr: boolean[] = [];
    var isbool: boolean[] = [];
    var isu32: boolean[] = [];
    var isu64: boolean[] = [];
    // local_subword kind per slot ("" / "u8"); the
    // sub-32-bit sibling of isu32/isu64. Drives the post-arithmetic width wrap.
    var subword: string[] = [];
    var noloop: i32[] = [];
    // Method receiver → slot 0 (it sits at the first arg position, like param 0).
    // A scalar-field STRUCT receiver binds slot 0 as that struct (field-access
    // dispatch); a PRIMITIVE receiver (impl Trait for i32/boolean/string/i64/
    // f64) binds slot 0 as the scalar/string/i64/f64 it is — like a leading
    // param of that type — so `self` reads correctly and the call site's
    // primitive-receiver dispatch (expr_recv_prim_type) resolves. An ENUM
    // receiver binds slot 0 as a plain (heap-pointer) slot carrying the enum
    // type name, so `match (self)` works and an enum-typed call site dispatches
    // to `<Enum>.<method>`. An array / Option / tuple / non-leaksafe-struct
    // receiver still bails the module.
    if (fn.receiver_name.len() > 0) {
        var rbase: string = util.base_type_name(fn.receiver_type);
        var r_is_struct: boolean = decl_is_struct(structs, rbase);
        var r_is_prim: boolean = rbase == "i32" || rbase == "boolean" || rbase == "string" || rbase == "i64" || is_f64_scalar_type_name(rbase);
        // A Map[K, V] receiver (`function (m: Map[K, V]) contains_value(...)`).
        // base_type_name strips the generics to "Map", which is_enum_like_name
        // would otherwise mis-accept as a bare nominal enum — so test r_is_map
        // FIRST and exclude it from r_is_enum, then map-track the receiver slot
        // (mapty) below so `m.values()` / `m.get(k)` / `m.iter()` dispatch as map
        // ops (a Map receiver marked as an enum would mis-dispatch them).
        var r_is_map: boolean = is_map_type_name(fn.receiver_type) && !is_array_type_name(fn.receiver_type);
        var r_is_enum: boolean = !r_is_map && is_enum_like_name(rbase, structs);
        // An Option[T] / Result[T, E] receiver (`function (o: Option[i32])
        // unwrap_or(...)`) binds slot 0 as a leak-only opt box carrying the full
        // receiver type, so `match (self)` recovers the payload — the same way an
        // Option/Result PARAM is opt-tracked below. The call site dispatches to
        // `Option.<method>` (base_type_name strips the payload), matching the
        // emitted label (#3031).
        var r_is_opt: boolean = fn.receiver_type.len() >= 8 && (slice_unchecked(fn.receiver_type, 0, 7) == "Option[" || slice_unchecked(fn.receiver_type, 0, 7) == "Result[");
        if (r_is_struct) {
            if (!decl_is_leaksafe(structs, rbase)) {
                return lower_failed(fn, "receiver struct `" + rbase + "` is not leak-safe (a field needs RC)");
            }
        } else if (!r_is_prim && !r_is_enum && !r_is_opt && !r_is_map) {
            return lower_failed(fn, "receiver type `" + fn.receiver_type + "` is not a primitive / struct / enum / Option / Map");
        }
        // A nominal receiver (struct or enum) carries its type name in
        // local_struct_type — a struct for field access, an enum for a
        // `self.method()` (enum) dispatch. A primitive carries "".
        var rsty: string = "";
        if (r_is_struct || r_is_enum) { rsty = rbase; }
        var ropt: string = "";
        if (r_is_opt) { ropt = fn.receiver_type; }
        names = names.append(fn.receiver_name);
        isarr = isarr.append(false);
        isstr = isstr.append(rbase == "string");
        isstrarr = isstrarr.append(false);
        structty = structty.append(rsty);
        optty = optty.append(ropt);
        tupty = tupty.append("");
        // Map-track a Map receiver (the full Map[K, V] type) so map-op dispatch
        // on `self` resolves the key/value kinds — exactly like a Map PARAM below.
        if (r_is_map) { mapty = mapty.append(fn.receiver_type); } else { mapty = mapty.append(""); }
        cellty = cellty.append(cell_elem_of_type_name(fn.receiver_type));
        isi64 = isi64.append(rbase == "i64");
        isf64 = isf64.append(is_f64_scalar_type_name(rbase));
        // `float` excluded — the f64 alias, not f32 (#5882); isf64 covers it.
        isf32 = isf32.append(rbase == "f32");
        isf64arr = isf64arr.append(false);
        isf32arr = isf32arr.append(false);
        isi64arr = isi64arr.append(false);
        isboolarr = isboolarr.append(fn.receiver_type == "boolean[]");
        isbool = isbool.append(fn.receiver_type == "boolean");
        isu32 = isu32.append(is_u32_type_name(fn.receiver_type));
        isu64 = isu64.append(is_u64_type_name(fn.receiver_type));
        subword = subword.append(subword_kind_of_name(fn.receiver_type));
    }
    var i: i32 = 0;
    while (i < fn.params.len()) {
        // A struct param must be a scalar-field struct; otherwise bail.
        if (decl_is_struct(structs, fn.params[i].type_name) && !decl_is_leaksafe(structs, fn.params[i].type_name)) {
            return lower_failed(fn, "param `" + fn.params[i].name + ": " + fn.params[i].type_name + "` is a struct that is not leak-safe (a field needs RC)");
        }
        names = names.append(fn.params[i].name);
        // An array-typed param is array-tracked (so a[i] / a.len() / aliasing
        // it work) but BORROWED — the dec-sweep skips slots < n_params. A
        // string[] param is additionally element-tracked (a[i] is a string).
        isarr = isarr.append(is_array_type_name(fn.params[i].type_name));
        // A string-typed param is string-tracked (for `.len()` / concat / eq
        // dispatch); strings aren't RC'd, so there is no borrow bookkeeping.
        isstr = isstr.append(fn.params[i].type_name == "string");
        isstrarr = isstrarr.append(fn.params[i].type_name == "string[]");
        // A struct-typed param carries its type name for field-access dispatch;
        // an enum-typed param carries the enum name so `param.method()`
        // dispatches to `<Enum>.<method>`.
        var pty: string = "";
        if (decl_is_struct(structs, fn.params[i].type_name)) { pty = fn.params[i].type_name; }
        else if (is_enum_like_name(fn.params[i].type_name, structs)) { pty = fn.params[i].type_name; }
        // A struct-array param `a: P[]` carries the ELEMENT struct type, so
        // `a[i].field` / `for x in a` over the borrowed array resolve.
        else if (is_array_type_name(fn.params[i].type_name)
                 && decl_is_struct(structs, slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 2))) {
            pty = slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 2) + "";
        }
        // A 2D struct-/enum-array param `a: P[][]`: the INNERMOST element is the
        // struct/enum (strip both `[]`). The param is is_arrarr (set below), and
        // the array-foreach propagates this element type through `row` to `p`
        // (#3063, the param sibling of #3058/#3061).
        else if (is_array_type_name(fn.params[i].type_name)
                 && fn.params[i].type_name.len() >= 4 && is_array_type_name(slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 2))
                 && (decl_is_struct(structs, slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 4))
                     || is_enum_like_name(slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 4), structs))) {
            pty = slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 4) + "";
        }
        // A `dyn Trait` param (or the element of a `dyn Trait[]` param) carries
        // the coarse `"dyn <Trait>"` type so `param.method()` / `for x in param`
        // dispatches dynamically by the receiver's runtime shape pointer.
        else if (fn.params[i].type_name.len() > 4 && slice_unchecked(fn.params[i].type_name, 0, 4) == "dyn ") {
            if (is_array_type_name(fn.params[i].type_name)) { pty = slice_unchecked(fn.params[i].type_name, 0, fn.params[i].type_name.len() - 2) + ""; }
            else { pty = fn.params[i].type_name; }
        }
        // A WIDENED erased typevar param (#5464) is a plain i64 scalar on wasm, not
        // a struct: clear the coarse "K"/"V" struct-type the is_enum_like_name
        // heuristic assigned to the bare spelling, so elem_type_tag / expr_struct_type
        // read the slot at its i64 width (a tuple element stores 8-byte) rather than
        // returning the typevar name.
        if (for_wasm && is_erased_typevar(fn.params[i].type_name, structs) && erased_widenable(fn, structs)) { pty = ""; }
        structty = structty.append(pty);
        // An Option[T]/Result[T,E] param is opt-tracked so `match (param)` can
        // recover the payload type.
        var poty: string = "";
        var ptn: string = fn.params[i].type_name;
        if (ptn.len() >= 8 && (slice_unchecked(ptn, 0, 7) == "Option[" || slice_unchecked(ptn, 0, 7) == "Result[")) { poty = ptn; }
        optty = optty.append(poty);
        // A TUPLE-typed param records its element tags (the same
        // tuple_elem_tags split the declared-return registry uses, with fn
        // segments mapped "clo") so `t.N` reads / `t.N(args)` dispatch on the
        // parameter resolve — without this a tuple param's element reads had
        // no tag and the function bailed.
        var ptup: string = "";
        if (util.is_tuple_type_name(ptn) && !is_array_type_name(ptn)) { ptup = tuple_elem_tags(ptn); }
        tupty = tupty.append(ptup);
        // A Map[K,V] param records the slot's map type so `m.get_or(...)` / etc.
        // on the parameter dispatch as map ops (the local-var annotation path
        // already does this; params lacked it). #map-param.
        // A map-ARRAY param records its ELEMENT type, the same column convention
        // map-array LOCALS use, so `ms[i].get(k)` reads a real Map[K, V] rather
        // than the array spelling it happened to accept.
        if (is_map_type_name(ptn) && !is_array_type_name(ptn)) { mapty = mapty.append(ptn); }
        else if (map_elem_of_array_type(ptn) != "") { mapty = mapty.append(map_elem_of_array_type(ptn)); }
        else { mapty = mapty.append(""); }
        cellty = cellty.append(cell_elem_of_type_name(ptn));
        // On wasm a bare-typevar (erased-generic) param of a PASS-THROUGH fn
        // (bare-typevar RETURN, e.g. `id[T](x:T):T` / `fst[A,B](a:A,b:B):A`) is
        // typed i64 — the uniform 8-byte slot the register backends give every
        // param — so an i64/f64/i32/pointer value moves opaquely through it
        // (callers coerce at the boundary; #5464). Gated on the bare-typevar
        // RETURN so a CONTAINER-returning erased fn (`pair:(K,V)`, `dup:T[]`,
        // `some1:Option[T]`) keeps its i32-param path unchanged — wide args to
        // those still defer via erased_wide. Free functions only (methods are
        // never erased generics), matching flag '5' in fn_param_sigs_of.
        isi64 = isi64.append(fn.params[i].type_name == "i64"
            || (for_wasm && is_erased_typevar(fn.params[i].type_name, structs) && erased_widenable(fn, structs)));
        isf64 = isf64.append(is_f64_scalar_type_name(fn.params[i].type_name));
        // `float` is excluded deliberately — it is the f64 alias, not f32
        // (#5882). isf64 above already covers it via is_f64_scalar_type_name.
        isf32 = isf32.append(fn.params[i].type_name == "f32");
        // An f64[] param is element-width-tracked (a[i] reads an 8-byte f64);
        // the array itself rides the same 8-byte-stride layout every f64 array
        // literal in this (whole-module-IR) program uses, so passing one is safe.
        //
        // `f32[]` rides the SAME 8-byte f64 layout — a scalar f32 param already
        // lowers to a wasm f64 (see assert_at_f32's `(param f64)`), and the
        // array-literal / cell paths already mark an f32 element type as
        // f64arr. Without it here, a declared `f32[]` param was classified as
        // nothing at all, so `a[i]` emitted the default 4-byte stride +
        // i32.load into an f64-typed local: an invalid module where the value
        // reaches a float op, a silent wrong answer where it does not. It only
        // bit a param whose type had to be read off the DECLARATION — with no
        // imports, call-site inference marked the slot and hid it, so any
        // program with a single `import` reproduced and the same program
        // without one did not (#6175).
        isf64arr = isf64arr.append(is_float_array_type_name(fn.params[i].type_name));
        isf32arr = isf32arr.append(fn.params[i].type_name == "f32[]");
        isi64arr = isi64arr.append(fn.params[i].type_name == "i64[]");
