                            // the struct-lit fav_alias_inc idiom. Only a bare ident on
                            // an array slot: a fresh-literal payload isn't a local, so
                            // the sweep never frees it (it leaks — the safe-leak
                            // invariant for nested payloads). The inc pops + re-pushes
                            // the same pointer, leaving struct_make's arg order intact.
                            if (is_array_type_name(decl_field_type_at(vctor.structs, cid.name, vi))) {
