function reclaimable_unmatched_optarr(body: ast.Stmt[], opt_fresh_ret: SigReg, ufa: string[], out: string[]): string[] {
var ufai: i32 = 0;
while (ufai < ufa.len()) {
    out = out.append("OPTARR:" + ufa[ufai]);
    // #6360: a SECOND tag when this local's Err payload is a proven-fresh
    // string, so the sweep can fill the tag guard's else-branch for it alone.
    // OPTARR: is shared with the reassigned+match class, whose slots earned no
    // such proof — an unconditional Err release there would dangle.
    // Same key, one gate: the Err-payload proof asks about the variable.
    // "OPTARRERR:" is a SUB-TAG of the "OPTARR:" entry appended just above —
    // same slot, same key — so the two are granted and resolved together and
    // cannot end up keyed differently.
    if (unmatched_optarr_err_str_fresh(body, reclaim_site_name(ufa[ufai]), opt_fresh_ret)) {
        out = out.append("OPTARRERR:" + ufa[ufai]);
    }
    ufai = ufai + 1;
}

    return out;
}

function reclaimable_optstr(ufs: string[], out: string[]): string[] {
