function reclaimable_map(aliased_m: string[], body: ast.Stmt[], borrowable: string[], maps: string[], reassigned: string[], recv_borrow: string[], structs: parser.StructDecl[], out: string[]): string[] {
var mi: i32 = 0;
while (mi < maps.len()) {
    // `maps` holds BINDING-SITE keys (#7253); every gate below asks about the
    // NAME, and a same-named sibling binding refuses the credit for both — the
    // gate stays coarser than the key, which is the safe direction.
    var mapnm: string = reclaim_site_name(maps[mi]);
    // The two POSITIONAL gates, and their one override: a map whose only
    // alias and only escape is a bare-ident element of a local, non-escaping
    // tuple keeps the credit (#7212). The tuple holds an uncounted pointer
    // nothing on that side ever releases, so the local still owes the one
    // release, and scope exit is past every read of a local tuple. Asked
    // only when the plain reading has already refused — it walks the body
    // again, and the maps it can rescue are the minority that reach it.
    var pos_ok: boolean = util.index_of_str(aliased_m, mapnm) < 0
        && !body_unsafe_for(body, mapnm, borrowable, recv_borrow);
    // The other HOLDERS of the map's alias group (#7235) — the tuple hosts the
    // override admits, or the plain aliases map_alias_holder_sites vets.
    var holders: string[] = [];
    if (!pos_ok) {
        if (map_tuple_elem_borrow_only(body, mapnm, borrowable, recv_borrow, reassigned)) {
            pos_ok = true;
            holders = map_tuple_holder_rows(body, mapnm, maps[mi], holders);
        } else {
            var asites: string[] = map_alias_holder_sites(body, mapnm, borrowable, recv_borrow, reassigned);
            if (asites.len() > 0 && !body_unsafe_for_alias(body, mapnm, borrowable, recv_borrow, asites)) {
                pos_ok = true;
                var ai: i32 = 0;
                while (ai < asites.len()) { holders = holders.append("MAPAL:" + asites[ai] + "|" + maps[mi]); ai = ai + 1; }
            }
        }
    }
    // The reassigned gate admits the sanctioned COW self-reassign
    // (`m = m.insert(k, v)` — map_nonself_reassigned / #4357): insert at
    // rc==1 mutates in place and returns the SAME box, so the slot's
    // value is unchanged and the exit / precise reclaim still frees
    // exactly one live box. Any other rebind disqualifies as before.
    // The iteration and identity holes below are NOT overridden.
    if (!map_nonself_reassigned(body, mapnm)
        && pos_ok
        && !map_has_explicit_iter(body, mapnm)
        // Identity-carrying method hole (insert/without return the
        // receiver's own box — see expr_map_identity_use): any such use
        // can smuggle the mapbox past the borrow-only escape walk, so it
        // excludes the map from reclaim.
        && !map_identity_escape(body, mapnm)) {
        out = out.append("MAP:" + maps[mi]);
        var hi: i32 = 0;
        while (hi < holders.len()) { out = out.append(holders[hi]); hi = hi + 1; }
        // Every read of this map goes through len / has / get / get_or — no
        // keys() / values() / for-in, which on a flag-1 column hand out the
        // raw buffer — so the map is its buffers' sole holder and a grow may
        // free the superseded one (map_site_owncols).
        if (!map_has_col_alias_read(body, mapnm)) {
            out = out.append("MAPOWN:" + maps[mi]);
        }
        // #4353: a reclaimable map whose every VALUE (resp. KEY) is a fresh
        // string additionally deep-releases that column — via
        // __fern_map_free_vs / _ks / _kvs on the register backends (wasm
        // already deep-releases). Sound because the map is the sole rc=1 owner
        // of each fresh value / key box. A clone shares those elements
        // uncounted with the box it superseded, which is why every release in
        // the group but m's own sweep is the shallow free (map_alias_holder_sites).
        if (map_str_value_reclaimable(body, mapnm)) {
            out = out.append("MAPVS:" + maps[mi]);
        }
        if (map_str_key_reclaimable(body, mapnm)) {
            out = out.append("MAPKS:" + maps[mi]);
        }
        // #4353 item 3: an ARRAY- or STRUCT-valued column whose every value is
        // a fresh literal — released per element via __fern_map_free_va / _ksva.
        // Mutually exclusive with MAPVS: by the declared value type.
        if (map_box_value_reclaimable(body, mapnm, structs)) {
            out = out.append("MAPVA:" + maps[mi]);
        }
    }
    mi = mi + 1;
}

    return out;
}

function reclaimable_strarr(body: ast.Stmt[], borrowable: string[], msites: string[], sarrs: string[], sfok: string[], str_fresh_ret: string[], strarr_producers: string[], structs: parser.StructDecl[], out: string[]): string[] {
var sri: i32 = 0;
while (sri < sarrs.len()) {
    // #7282 string[] limb (#7391): a plain `var x: string[] = xs` alias
    // shares buffer AND elements, so it shares the credit — the bind
    // retains the buffer, both slots sweep through __fern_str_arr_free,
    // and its rc gate arbitrates: rc>1 decs and leaves the elements to the
    // other owner; only the LAST owner's rc==1 walks them. That gate is
    // what lets the alias take the SAME deep "SARR:" class where a struct
    // alias must take box-only "NODEEP:" — the walk cannot run twice.
    var sanm: string = reclaim_site_name(sarrs[sri]);
    var sasal: string[] = strarr_alias_chain_sites_of(body, sanm, borrowable, str_fresh_ret, strarr_producers, body, []);
    // A struct-literal `string[]` field is a counted share on the same terms
    // the string family took in #7557, and it needs the DEEP class rather
    // than a box-only one: the element walk must survive a path where the
    // holder is never constructed. __fern_str_arr_free's rc gate is what
    // makes granting both owners the walk safe — only the last one at rc 1
    // performs it.
    var sasfld: string[] = rc_counted_field_sites(body, sanm, structs, sfok, msites, out, "string[]", []);
    if (!strarr_unsafe_for_alias(body, sanm, borrowable, str_fresh_ret, strarr_producers, sasal, sasfld)) {
        out = out.append("SARR:" + sarrs[sri]);
        out = credit_alias_sites(out, "SARR:", sasal);
    }
    sri = sri + 1;
}

    return out;
}

function reclaimable_builtin_strarr(body: ast.Stmt[], borrowable: string[], bsarrs: string[], str_fresh_ret: string[], strarr_producers: string[], out: string[]): string[] {
var bri: i32 = 0;
while (bri < bsarrs.len()) {
    if (!strarr_unsafe_for(body, reclaim_site_name(bsarrs[bri]), borrowable, str_fresh_ret, strarr_producers)) { out = out.append("SARRB:" + bsarrs[bri]); }
    bri = bri + 1;
}

    return out;
}

function reclaimable_arrarr(aarrs: string[], body: ast.Stmt[], borrowable: string[], opt_fresh_ret: SigReg, out: string[]): string[] {
var aai: i32 = 0;
while (aai < aarrs.len()) {
    var aan: string = aarrs[aai];
    // "S|<name>" entries are strings-fresh MARKERS, not candidates.
    // NOT excluded on `reassigned` any more (#6092) — the self-append rebind
    // IS a reassignment, and refusing the credit for it left every
    // append-BUILT arr-of-arr leaking its rows. arrarr_unsafe_for validates
    // each rebind individually (only `g = g.append(<row literal>)` passes)
    // and is otherwise body_unsafe_for, so it subsumes both former checks.
    // The string[] class has worked this way since #4355.
    if (!(aan.len() > 2 && aan[0] == b'S' && aan[1] == b'|')
        && !arrarr_unsafe_for(body, reclaim_site_name(aan), borrowable, opt_fresh_ret)
        && !arrarr_row_escapes_iter(body, reclaim_site_name(aan), borrowable)) {
        out = out.append("ARRARR:" + aan);
        // STRICT string-kind credit only when every inner element proved
        // fresh (slot_is_reclaimable_arrarr consults this one when the
        // slot's type-aware arrarr_elem says the inners hold strings).
        if (util.index_of_str(aarrs, "S|" + aan) >= 0) { out = out.append("ARRARRS:" + aan); }
    }
    aai = aai + 1;
}

    return out;
}

function reclaimable_optaarr(body: ast.Stmt[], borrowable: string[], oaas: string[], plan_fe: string[], plan_on: boolean, reassigned: string[], recv_borrow: string[], out: string[]): string[] {
var oai: i32 = 0;
while (oai < oaas.len()) {
    // `oaas` holds BINDING-SITE keys (#7253); all four gates ask about the
    // VARIABLE, so each takes the bare name back out of the key.
    var oanm: string = reclaim_site_name(oaas[oai]);
    // The whole-name escape gate is plan-routed (step 2, the SCENUMS
    // pattern) and the plan verdict is now the WHOLE gate when the plan is
    // on — the staged union with the credit-side escape proof retired with
    // the per-site verdicts, which give the plan a key precise enough to
    // grant one binding and refuse its same-named neighbour. The
    // element-alias conjunct stays: a bound `var o = xs[i]` takes no
    // counted retain here (native's Index-shape dup is unported for
    // ARRAYS — the tuple-element half is tuple_elem_ret_dup), so no
    // ownership verdict can license it. It retires with that dup.
    var oa_esc_ok: boolean = false;
    if (!plan_on) { oa_esc_ok = !body_unsafe_for(body, oanm, borrowable, recv_borrow); }
    else if (!name_is_alias_bound(body, oanm)) {
        oa_esc_ok = util.index_of_str(plan_fe, oaas[oai]) >= 0;
    }
    if (oa_esc_ok
        && util.index_of_str(reassigned, oanm) < 0
        && !arrarr_row_escapes_boxiter(body, oanm)
        && !optaarr_elem_payload_escapes(body, oanm)) {
        out = out.append("OPTAARR:" + oaas[oai]);
    }
    oai = oai + 1;
}

    return out;
}

