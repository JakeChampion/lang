// examples/self_host/ssa_arm64.fern — an SSA → AArch64 (arm64 Linux ELF,
// GNU as) code generator: the arm64 sibling of ssa_x86.fern, and parity
// for the project's DEFAULT target. Lowers the optimised SSA from ssa.fern
// to machine code, the second backend in the AST → SSA → optimise → emit
// pipeline.
//
// Same strategy as the x86 backend (slice 8): no register allocation —
// every SSA value lives in an 8-byte stack slot at [sp, #8*v]; instructions
// load operands into w9/w10, compute, and store the result back. SSA is
// taken out of phi form by copies on the predecessor edges. Framing mirrors
// asm_arm64.fern: `__fn_<name>` bodies and `_start` dispatching into main()
// (exit syscall 93).

import "./ssa";
import "./util";

// slot returns the AArch64 memory operand for SSA value v's stack slot.
function slot(v: i32): string {
    return "[sp, #" + util.i32_to_string(8 * v) + "]";
}

// argreg maps a parameter index to its AAPCS64 32-bit argument register.
function argreg(i: i32): string { return "w" + util.i32_to_string(i); }
// argreg64 is the 64-bit (x-register) view, for pointer args/params.
function argreg64(i: i32): string { return "x" + util.i32_to_string(i); }
function argreg_w(i: i32, width: i32): string {
    if (width == 64) { return argreg64(i); }
    return argreg(i);
}

// regname maps an allocatable register index to its AArch64 32-bit name.
// We use the caller-saved temporaries w12..w15 (w9/w10/w11 are reserved as
// computation scratch); register-allocated values never live across a call
// (regalloc forces those to spill), so no save/restore is needed.
function regname(k: i32): string {
    if (k == 0) { return "w12"; }
    if (k == 1) { return "w13"; }
    if (k == 2) { return "w14"; }
    return "w15";
}
// regname64 is the 64-bit (x-register) view, used for pointer-width
// (alloc-derived) values.
function regname64(k: i32): string {
    if (k == 0) { return "x12"; }
    if (k == 1) { return "x13"; }
    if (k == 2) { return "x14"; }
    return "x15";
}
// NREGS is the size of that allocatable set.
function nregs(): i32 { return 4; }

// areg names a scratch register at a given width: class "a" → w9/x9,
// "c" → w10/x10, "d" → w11/x11.
function areg(cls: string, width: i32): string {
    if (cls == "a") { if (width == 64) { return "x9"; } return "w9"; }
    if (cls == "c") { if (width == 64) { return "x10"; } return "w10"; }
    if (width == 64) { return "x11"; }
    return "w11";
}
// regn returns where SSA value v lives at the given width — its register
// name (width-correct) if allocated, else its 8-byte stack slot.
function regn(reg_of: i32[], v: i32, width: i32): string {
    if (reg_of[v] >= 0) { if (width == 64) { return regname64(reg_of[v]); } return regname(reg_of[v]); }
    return slot(v);
}
// load_op moves SSA value v into scratch class `cls` (reg→reg move when v
// is allocated, else a load from its stack slot), at the value's width.
function load_op(reg_of: i32[], widths: i32[], v: i32, cls: string, out: string): string {
    var w: i32 = widths[v];
    if (reg_of[v] >= 0) { return out + "    mov " + areg(cls, w) + ", " + regn(reg_of, v, w) + "\n"; }
    return out + "    ldr " + areg(cls, w) + ", " + slot(v) + "\n";
}
// store_res moves scratch class `cls` into SSA value v's location.
function store_res(reg_of: i32[], widths: i32[], v: i32, cls: string, out: string): string {
    var w: i32 = widths[v];
    if (reg_of[v] >= 0) { return out + "    mov " + regn(reg_of, v, w) + ", " + areg(cls, w) + "\n"; }
    return out + "    str " + areg(cls, w) + ", " + slot(v) + "\n";
}

function block_index(f: ssa.SFunc, id: i32): i32 {
    var i: i32 = 0;
    while (i < f.blocks.len()) {
        if (f.blocks[i].id == id) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
function pred_slot(blk: ssa.SBlock, prev: i32): i32 {
    var i: i32 = 0;
    while (i < blk.preds.len()) {
        if (blk.preds[i] == prev) { return i; }
        i = i + 1;
    }
    return 0;
}

// emit_const materialises a 32-bit immediate into `reg` (movz low half,
// movk high half — handles any i32, including negatives).
function emit_const(imm: i32, reg: string, out: string): string {
    var lo: i32 = imm & 65535;
    var hi: i32 = (imm >> 16) & 65535;
    out = out + "    movz " + reg + ", #" + util.i32_to_string(lo) + "\n";
    out = out + "    movk " + reg + ", #" + util.i32_to_string(hi) + ", lsl #16\n";
    return out;
}

// emit_binary emits a binary op assuming the lhs is in w9/x9 and the rhs in
// w10/x10 (per `width` = the OPERANDS' width), leaving the result in w9/x9. A
// 64-bit operand width selects the x registers so i64 arithmetic keeps all 64
// bits; the same mnemonics serve both widths (only the register names change).
// A comparison compares the full-width operands (cmp x9, x10) but `cset` always
// writes an i32 0/1 in w9 (the result's own width).
function emit_binary(op: string, width: i32, out: string): string {
    var a: string = "w9"; var b: string = "w10"; var t: string = "w11";
    if (width == 64) { a = "x9"; b = "x10"; t = "x11"; }
    if (op == "+") { return out + "    add " + a + ", " + a + ", " + b + "\n"; }
    if (op == "-") { return out + "    sub " + a + ", " + a + ", " + b + "\n"; }
    if (op == "*") { return out + "    mul " + a + ", " + a + ", " + b + "\n"; }
    if (op == "/") { return out + "    sdiv " + a + ", " + a + ", " + b + "\n"; }
    if (op == "%") { return out + "    sdiv " + t + ", " + a + ", " + b + "\n    msub " + a + ", " + t + ", " + b + ", " + a + "\n"; }
    if (op == "&") { return out + "    and " + a + ", " + a + ", " + b + "\n"; }
    if (op == "|") { return out + "    orr " + a + ", " + a + ", " + b + "\n"; }
    if (op == "^") { return out + "    eor " + a + ", " + a + ", " + b + "\n"; }
    if (op == "<<") { return out + "    lsl " + a + ", " + a + ", " + b + "\n"; }
    if (op == ">>") { return out + "    asr " + a + ", " + a + ", " + b + "\n"; }
    if (op == "==") { return out + "    cmp " + a + ", " + b + "\n    cset w9, eq\n"; }
    if (op == "!=") { return out + "    cmp " + a + ", " + b + "\n    cset w9, ne\n"; }
    if (op == "<") { return out + "    cmp " + a + ", " + b + "\n    cset w9, lt\n"; }
    if (op == "<=") { return out + "    cmp " + a + ", " + b + "\n    cset w9, le\n"; }
    if (op == ">") { return out + "    cmp " + a + ", " + b + "\n    cset w9, gt\n"; }
    if (op == ">=") { return out + "    cmp " + a + ", " + b + "\n    cset w9, ge\n"; }
    if (op == "&&") {
        return out + "    cmp " + a + ", #0\n    cset w9, ne\n    cmp " + b + ", #0\n    cset w10, ne\n    and w9, w9, w10\n";
    }
    if (op == "||") {
        return out + "    cmp " + a + ", #0\n    cset w9, ne\n    cmp " + b + ", #0\n    cset w10, ne\n    orr w9, w9, w10\n";
    }
    return out;
}

// store_reg32 stores a named 32-bit source register into i32 value v's
// location (used for incoming params and call results), at the given width.
function store_reg(reg_of: i32[], v: i32, src: string, width: i32, out: string): string {
    if (reg_of[v] >= 0) { return out + "    mov " + regn(reg_of, v, width) + ", " + src + "\n"; }
    return out + "    str " + src + ", " + slot(v) + "\n";
}

// fconst_label is the .rodata label for a const_float value (unique per
// function + value id). f_arith / f_cc map float operators to AArch64 FP
// instructions / fcmp condition codes (a<b → mi: unordered/NaN yields false).
function fconst_label(fname: string, result: i32): string {
    return ".LCf_" + fname + "_" + util.i32_to_string(result);
}
// sconst_label is the .data label for a const_str (static [len, b0, …] string,
// one 8-byte word per element — the heap string layout the helpers read).
function sconst_label(fname: string, result: i32): string {
    return ".LCs_" + fname + "_" + util.i32_to_string(result);
}
function f_arith(op: string): string {
    if (op == "+") { return "fadd"; }
    if (op == "-") { return "fsub"; }
    if (op == "*") { return "fmul"; }
    return "fdiv";
}
function f_cc(op: string): string {
    if (op == "<") { return "mi"; }
    if (op == "<=") { return "ls"; }
    if (op == ">") { return "gt"; }
    if (op == ">=") { return "ge"; }
    if (op == "==") { return "eq"; }
    return "ne";
}

function emit_inst(ins: ssa.SInst, reg_of: i32[], widths: i32[], isfloat: i32[], fname: string, out: string): string {
    if (ins.kind_tag == 5) {  // const_str
        // Pointer to the static [len, bytes…] string constant (64-bit; stored
        // via store_reg so it honours the value's register/slot home).
        out = out + "    adrp x9, " + sconst_label(fname, ins.result) + "\n";
        out = out + "    add x9, x9, :lo12:" + sconst_label(fname, ins.result) + "\n";
        return store_reg(reg_of, ins.result, "x9", 64, out);
    }
    if (ins.kind_tag == 4) {  // const_float
        out = out + "    adrp x9, " + fconst_label(fname, ins.result) + "\n";
        out = out + "    ldr d0, [x9, :lo12:" + fconst_label(fname, ins.result) + "]\n";
        return out + "    str d0, " + slot(ins.result) + "\n";
    }
    if (ins.kind_tag == 1 || ins.kind_tag == 2) {
        out = emit_const(ins.imm, "w9", out);
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 3) {  // const_i64
        // A 64-bit integer literal: `ldr x9, =TEXT` lets the assembler splice
        // the full-width value into a literal-pool entry (any i64/u64 pattern),
        // then store at the value's 64-bit home. compute_widths marks it 64-bit.
        out = out + "    ldr x9, =" + ins.str + "\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 7) {  // copy
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 9) {  // binary
        // Float arithmetic (f64 result) and comparison (f64 operands, i32
        // result) over the values' stack slots, using the d registers.
        if (isfloat[ins.result] == 1) {
            out = out + "    ldr d0, " + slot(ins.args[0]) + "\n    ldr d1, " + slot(ins.args[1]) + "\n";
            out = out + "    " + f_arith(ins.str) + " d0, d0, d1\n";
            return out + "    str d0, " + slot(ins.result) + "\n";
        }
        if (isfloat[ins.args[0]] == 1) {
            out = out + "    ldr d0, " + slot(ins.args[0]) + "\n    ldr d1, " + slot(ins.args[1]) + "\n";
            out = out + "    fcmp d0, d1\n    cset w9, " + f_cc(ins.str) + "\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        out = load_op(reg_of, widths, ins.args[1], "c", out);
        // Operand width (not result width) selects w/x registers: an i64
        // comparison compares 64-bit operands but still yields an i32.
        out = emit_binary(ins.str, widths[ins.args[0]], out);
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 10) {  // unary
        if (ins.str == "-" && isfloat[ins.args[0]] == 1) {
            out = out + "    ldr d0, " + slot(ins.args[0]) + "\n    fneg d0, d0\n";
            return out + "    str d0, " + slot(ins.result) + "\n";
        }
        if (ins.str == "as_f64") {
            out = out + "    ldr w9, " + slot(ins.args[0]) + "\n    scvtf d0, w9\n";
            return out + "    str d0, " + slot(ins.result) + "\n";
        }
        if (ins.str == "as_i32") {
            if (isfloat[ins.args[0]] == 1) {
                out = out + "    ldr d0, " + slot(ins.args[0]) + "\n    fcvtzs w9, d0\n";
                return store_res(reg_of, widths, ins.result, "a", out);
            }
            out = load_op(reg_of, widths, ins.args[0], "a", out);
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        // f64_bits / f64_from_bits — bit reinterpret: move the 8-byte slot
        // unchanged (int<->float share the slot; f64 operands force
        // regalloc_none so both ends are slots).
        if (ins.str == "f64_bits" || ins.str == "f64_from_bits") {
            out = out + "    ldr x9, " + slot(ins.args[0]) + "\n";
            return out + "    str x9, " + slot(ins.result) + "\n";
        }
        // i32 -> i64 widen: sxtw sign-extends the 32-bit source into x9, uxtw
        // zero-extends. The i32 operand loads at its width (w9); result 64-bit.
        if (ins.str == "sext_i64") {
            out = load_op(reg_of, widths, ins.args[0], "a", out);
            out = out + "    sxtw x9, w9\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        if (ins.str == "zext_i64") {
            out = load_op(reg_of, widths, ins.args[0], "a", out);
            out = out + "    uxtw x9, w9\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        // i64 -> i32 truncate: load the 64-bit operand (x9), store the low word
        // at the result's 32-bit home (w9 is the low half of x9).
        if (ins.str == "wrap_i32") {
            out = load_op(reg_of, widths, ins.args[0], "a", out);
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        if (ins.str == "-") { out = out + "    neg w9, w9\n"; }
        else { out = out + "    cmp w9, #0\n    cset w9, eq\n"; }
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 11) {  // call
        // AAPCS64: integer/pointer args fill x0…, f64 args fill d0… (two
        // independent sequences).
        var ii: i32 = 0;
        var fi: i32 = 0;
        var i: i32 = 0;
        while (i < ins.args.len()) {
            if (isfloat[ins.args[i]] == 1) {
                out = out + "    ldr d" + util.i32_to_string(fi) + ", " + slot(ins.args[i]) + "\n";
                fi = fi + 1;
            } else {
                var aw: i32 = widths[ins.args[i]];
                if (reg_of[ins.args[i]] >= 0) {
                    out = out + "    mov " + argreg_w(ii, aw) + ", " + regn(reg_of, ins.args[i], aw) + "\n";
                } else {
                    out = out + "    ldr " + argreg_w(ii, aw) + ", " + slot(ins.args[i]) + "\n";
                }
                ii = ii + 1;
            }
            i = i + 1;
        }
        out = out + "    bl __fn_" + ins.str + "\n";
        // f64-returning call → result in d0; else w0/x0.
        if (isfloat[ins.result] == 1) { return out + "    str d0, " + slot(ins.result) + "\n"; }
        var rsrc: string = "w0";
        if (widths[ins.result] == 64) { rsrc = "x0"; }
        return store_reg(reg_of, ins.result, rsrc, widths[ins.result], out);
    }
    if (ins.kind_tag == 13) {  // funcaddr
        // Function address (closure code pointer) via adrp/add; pointer-width.
        out = out + "    adrp x9, __fn_" + ins.str + "\n";
        out = out + "    add x9, x9, :lo12:__fn_" + ins.str + "\n";
        return store_reg(reg_of, ins.result, "x9", 64, out);
    }
    if (ins.kind_tag == 12) {  // call_indirect
        // args[0] = code pointer (→ x9, a scratch outside x12-x15/x0-x7);
        // args[1..] = call args into x0… ; branch-with-link through x9.
        if (reg_of[ins.args[0]] >= 0) { out = out + "    mov x9, " + regn(reg_of, ins.args[0], 64) + "\n"; }
        else { out = out + "    ldr x9, " + slot(ins.args[0]) + "\n"; }
        var ci: i32 = 1;
        while (ci < ins.args.len() && ci < 9) {
            var caw: i32 = widths[ins.args[ci]];
            if (reg_of[ins.args[ci]] >= 0) { out = out + "    mov " + argreg_w(ci - 1, caw) + ", " + regn(reg_of, ins.args[ci], caw) + "\n"; }
            else { out = out + "    ldr " + argreg_w(ci - 1, caw) + ", " + slot(ins.args[ci]) + "\n"; }
            ci = ci + 1;
        }
        out = out + "    blr x9\n";
        var risrc: string = "w0";
        if (widths[ins.result] == 64) { risrc = "x0"; }
        return store_reg(reg_of, ins.result, risrc, widths[ins.result], out);
    }
    if (ins.kind_tag == 14) {  // alloc
        // Bump-allocate 8-byte word slots (a pointer element fits; i32
        // elements use the low 4 bytes); result = old hp. The slot count is
        // imm (compile-time) unless args[0] is present — a runtime size
        // (__new_array), loaded into x10 and scaled ×8. x9/x10/x11 are scratch
        // (SSA values live in x12-x15).
        if (ins.args.len() > 0) {
            out = load_op(reg_of, widths, ins.args[0], "c", out);   // size → w10 (x10 zero-extended)
            out = out + "    adrp x11, __fern_ssa_hp\n";
            out = out + "    add x11, x11, :lo12:__fern_ssa_hp\n";
            out = out + "    ldr x9, [x11]\n";                       // old hp → result
            out = out + "    lsl x10, x10, #3\n";                    // size * 8
            out = out + "    add x10, x9, x10\n";                    // new hp
            out = out + "    str x10, [x11]\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        out = out + "    adrp x10, __fern_ssa_hp\n";
        out = out + "    add x10, x10, :lo12:__fern_ssa_hp\n";
        out = out + "    ldr x9, [x10]\n";
        out = out + "    add x11, x9, #" + util.i32_to_string(ins.imm * 8) + "\n";
        out = out + "    str x11, [x10]\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 15) {  // load_elem
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // ptr (x9)
        out = load_op(reg_of, widths, ins.args[1], "c", out);   // index (w10)
        // Byte offset = idx * 8 (word stride); a w-access can't use the
        // scaled `sxtw #3` form, so compute it (sbfiz = sign-extend × 8)
        // and use an unscaled register offset.
        out = out + "    sbfiz x10, x10, #3, #32\n";
        if (ins.imm == 64) { out = out + "    ldr x9, [x9, x10]\n"; }
        else { out = out + "    ldr w9, [x9, x10]\n"; }
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 16) {  // store_elem
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // ptr (x9)
        out = load_op(reg_of, widths, ins.args[1], "c", out);   // index (w10)
        out = load_op(reg_of, widths, ins.args[2], "d", out);   // value (w11/x11)
        out = out + "    sbfiz x10, x10, #3, #32\n";
        if (ins.imm == 64) { return out + "    str x11, [x9, x10]\n"; }
        return out + "    str w11, [x9, x10]\n";
    }
    if (ins.kind_tag == 19) {  // print
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // handle → x9
        out = out + "    mov x0, x9\n";
        out = out + "    mov x1, #" + util.i32_to_string(ins.imm) + "\n";   // fd (1=stdout,2=stderr)
        return out + "    bl __fern_ssa_print\n";
    }
    if (ins.kind_tag == 21) {  // exit
        // exit(code): terminate via the exit syscall (93); code (i32) in x0.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // code → x9
        out = out + "    mov x0, x9\n";
        out = out + "    mov x8, #93\n";
        return out + "    svc #0\n";
    }
    if (ins.kind_tag == 23) { return out + "    bl __fern_ssa_strbuf_reset\n"; }
    if (ins.kind_tag == 24) {  // strbuf_append
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // string → x9
        out = out + "    mov x0, x9\n";
        return out + "    bl __fern_ssa_strbuf_append\n";
    }
    if (ins.kind_tag == 25) {  // strbuf_take
        out = out + "    bl __fern_ssa_strbuf_take\n";
        return store_reg(reg_of, ins.result, "x0", 64, out);   // result string ptr
    }
    if (ins.kind_tag == 17) {  // concat
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // a → x9
        out = out + "    mov x0, x9\n";
        out = load_op(reg_of, widths, ins.args[1], "a", out);   // b → x9
        out = out + "    mov x1, x9\n";
        out = out + "    bl __fern_ssa_concat\n";
        return store_reg(reg_of, ins.result, "x0", 64, out);
    }
    if (ins.kind_tag == 18) {  // streq
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        out = out + "    mov x0, x9\n";
        out = load_op(reg_of, widths, ins.args[1], "a", out);
        out = out + "    mov x1, x9\n";
        out = out + "    bl __fern_ssa_streq\n";
        return store_reg(reg_of, ins.result, "w0", 32, out);
    }
    if (ins.kind_tag == 26) {  // read_file
        // read_file(path) → Result box; __fern_ssa_read_file(x0 = path) → x0.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // path → x9
        out = out + "    mov x0, x9\n";
        out = out + "    bl __fern_ssa_read_file\n";
        return store_reg(reg_of, ins.result, "x0", 64, out);    // Result box ptr ← x0
    }
    if (ins.kind_tag == 27) {  // write_file
        // write_file(path, content) → Result box; __fern_ssa_write_file(x0 =
        // path, x1 = content) → x0.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // path → x9
        out = out + "    mov x0, x9\n";
        out = load_op(reg_of, widths, ins.args[1], "a", out);   // content → x9
        out = out + "    mov x1, x9\n";
        out = out + "    bl __fern_ssa_write_file\n";
        return store_reg(reg_of, ins.result, "x0", 64, out);    // Option box ptr ← x0
    }
    if (ins.kind_tag == 20) {  // write
        // write(handle): like print but no trailing newline (fd 1).
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // handle → x9
        out = out + "    mov x0, x9\n";
        return out + "    bl __fern_ssa_write\n";
    }
    if (ins.kind_tag == 22) {  // args
        // args() → string[] of argv; __fern_ssa_args() → x0.
        out = out + "    bl __fern_ssa_args\n";
        return store_reg(reg_of, ins.result, "x0", 64, out);    // string[] ptr ← x0
    }
    return out;
}

function emit_phi_moves(f: ssa.SFunc, reg_of: i32[], widths: i32[], pred: i32, tgt: i32, out: string): string {
    var ti: i32 = block_index(f, tgt);
    if (ti < 0) { return out; }
    var tb: ssa.SBlock = f.blocks[ti];
    var sl: i32 = pred_slot(tb, pred);
    var k: i32 = 0;
    while (k < tb.insts.len()) {
        var ins: ssa.SInst = tb.insts[k];
        if (ins.kind_tag == 8) {  // phi
            out = load_op(reg_of, widths, ins.args[sl], "a", out);
            out = store_res(reg_of, widths, ins.result, "a", out);
        }
        k = k + 1;
    }
    return out;
}

function blk_label(name: string, id: i32): string {
    return ".L_" + name + "_" + util.i32_to_string(id);
}

function emit_term(f: ssa.SFunc, reg_of: i32[], widths: i32[], isfloat: i32[], blk: ssa.SBlock, out: string): string {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag == 1) {  // const_int
        // An f64 return goes in d0; otherwise w0/x0.
        if (isfloat[t.value] == 1) {
            out = out + "    ldr d0, " + slot(t.value) + "\n";
            out = out + "    mov sp, x29\n";
            out = out + "    ldp x29, x30, [sp], #16\n";
            return out + "    ret\n";
        }
        var w: i32 = widths[t.value];
        var dst: string = "w0";
        if (w == 64) { dst = "x0"; }
        if (reg_of[t.value] >= 0) { out = out + "    mov " + dst + ", " + regn(reg_of, t.value, w) + "\n"; }
        else { out = out + "    ldr " + dst + ", " + slot(t.value) + "\n"; }
        out = out + "    mov sp, x29\n";
        out = out + "    ldp x29, x30, [sp], #16\n";
        return out + "    ret\n";
    }
    if (t.kind_tag == 2) {  // const_bool
        out = emit_phi_moves(f, reg_of, widths, blk.id, t.target, out);
        return out + "    b " + blk_label(f.name, t.target) + "\n";
    }
    if (t.kind_tag == 3) {  // const_i64
        out = load_op(reg_of, widths, t.cond, "a", out);
        out = out + "    cbnz w9, " + blk_label(f.name, t.t) + "\n";
        return out + "    b " + blk_label(f.name, t.f) + "\n";
    }
    return out;
}

pub function emit_func(f: ssa.SFunc, reg_of: i32[]): string {
    var widths: i32[] = ssa.compute_widths(f);
    var isfloat: i32[] = ssa.compute_isfloat(f);
    // f64 values occupy 8 bytes, so the generic copy / phi-edge moves (width-
    // driven ldr/str) must use the x registers to carry all 8 bytes; the FP
    // paths use d0/d1 directly.
    var wmerged: i32[] = [];
    var wi: i32 = 0;
    while (wi < widths.len()) {
        if (isfloat[wi] == 1) { wmerged = wmerged.append(64); } else { wmerged = wmerged.append(widths[wi]); }
        wi = wi + 1;
    }
    widths = wmerged;
    var chunks: string[] = [];
    chunks = chunks.append("__fn_" + f.name + ":\n");
    chunks = chunks.append("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
    var frame: i32 = f.nvals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0 && frame <= 4095) {
        chunks = chunks.append("    sub sp, sp, #" + util.i32_to_string(frame) + "\n");
    } else if (frame > 4095) {
        // AArch64 add/sub take a 12-bit immediate (<= 4095, or a 4096-multiple via
        // LSL #12); a larger frame (a function with many SSA values) must be
        // materialized into a scratch register first, else `as` rejects it as
        // "immediate out of range". x9 is free at the prologue — the params are
        // still in x0..x7 / d0..d7 (spilled just below) and the frame value is
        // dead after the sub — and movk supplies the high 16 bits for a very large
        // frame. The epilogue restores via `mov sp, x29`, so it needs no immediate.
        var lo: i32 = frame & 65535;
        var hi: i32 = (frame / 65536) & 65535;
        chunks = chunks.append("    mov x9, #" + util.i32_to_string(lo) + "\n");
        if (hi != 0) { chunks = chunks.append("    movk x9, #" + util.i32_to_string(hi) + ", lsl #16\n"); }
        chunks = chunks.append("    sub sp, sp, x9\n");
    }
    // Spill incoming args: f64 params arrive in d0…, integer/pointer params in
    // x0… (two AAPCS64 sequences).
    var p: i32 = 0;
    var iip: i32 = 0;
    var fip: i32 = 0;
    while (p < f.nparams) {
        if (isfloat[p] == 1) {
            chunks = chunks.append("    str d" + util.i32_to_string(fip) + ", " + slot(p) + "\n");
            fip = fip + 1;
        } else {
            var pw: i32 = widths[p];
            chunks = chunks.append(store_reg(reg_of, p, argreg_w(iip, pw), pw, ""));
            iip = iip + 1;
        }
        p = p + 1;
    }
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var blk: ssa.SBlock = f.blocks[bi];
        chunks = chunks.append(blk_label(f.name, blk.id) + ":\n");
        var k: i32 = 0;
        while (k < blk.insts.len()) {
            var ins: ssa.SInst = blk.insts[k];
            if (ins.kind_tag != 6 && ins.kind_tag != 8) {
                chunks = chunks.append(emit_inst(ins, reg_of, widths, isfloat, f.name, ""));
            }
            k = k + 1;
        }
        chunks = chunks.append(emit_term(f, reg_of, widths, isfloat, blk, ""));
        bi = bi + 1;
    }
    return util.str_join_chunks(chunks);
}

// func_has_float reports whether any value in f is an f64 — such a function
// is emitted with everything stack-spilled (regalloc_none) so the FP paths
// can address every value by its slot.
function func_has_float(f: ssa.SFunc): boolean {
    var fl: i32[] = ssa.compute_isfloat(f);
    var i: i32 = 0;
    while (i < fl.len()) { if (fl[i] == 1) { return true; } i = i + 1; }
    return false;
}

// emit_float_consts emits a .rodata `.double` for every const_float across
// all functions, labelled by fconst_label so emit_inst can load it.
function emit_float_consts(funcs: ssa.SFunc[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < funcs.len()) {
        var bi: i32 = 0;
        while (bi < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: ssa.SInst = blk.insts[k];
                if (ins.kind_tag == 4) {  // const_float
                    out = out + "    .align 8\n" + fconst_label(funcs[i].name, ins.result) + ":\n    .double " + ins.str + "\n";
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        i = i + 1;
    }
    return out;
}

// emit_str_consts emits a static [len, b0, b1, …] string (one 8-byte .quad
// per element) for every const_str across all functions, labelled by
// sconst_label — matching the runtime string layout the helpers read.
function emit_str_consts(funcs: ssa.SFunc[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < funcs.len()) {
        var bi: i32 = 0;
        while (bi < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: ssa.SInst = blk.insts[k];
                if (ins.kind_tag == 5) {  // const_str
                    var sv: string = ins.str;
                    var parts: string[] = [];
                    parts = parts.append("    .align 8\n" + sconst_label(funcs[i].name, ins.result) + ":\n    .quad " + util.i32_to_string(sv.len()) + "\n");
                    var ci: i32 = 0;
                    while (ci < sv.len()) { parts = parts.append("    .quad " + util.i32_to_string((sv[ci] as i32)) + "\n"); ci = ci + 1; }
                    out = out + util.str_join_chunks(parts);
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        i = i + 1;
    }
    return out;
}

pub function emit_program(funcs: ssa.SFunc[], use_regalloc: boolean): string {
    var out: string = "    .globl _start\n";
    // Heap: a 1 GiB zero-initialised arena and an 8-byte bump pointer.
    // Leak-everything (no reclamation yet — Perceus RC is a separate track),
    // so it is sized generously (1 GiB) to leave room for a
    // self-hosted SSA compiler to process a real source bundle. It is .bss
    // (demand-zero): the large reservation costs nothing on disk and no
    // resident memory until touched.
    out = out + "    .bss\n    .align 16\n__fern_ssa_heap:\n    .zero 1073741824\n";
    out = out + "    .data\n__fern_ssa_hp:\n    .quad 0\n";
    // String literals as static [len, bytes…] .data constants.
    out = out + emit_str_consts(funcs);
    // f64 literals as .rodata .double constants (the assembler computes bits).
    var fconsts: string = emit_float_consts(funcs);
    if (fconsts.len() > 0) { out = out + "    .section .rodata\n" + fconsts; }
    out = out + "    .text\n";
    // Collect each function body, then join once — a left fold here is
    // O(total²) and OOMs on a whole compiler's worth of asm.
    var chunks: string[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var reg_of: i32[] = ssa.regalloc_none(funcs[i]);
        // A float function keeps every value in its slot (the FP paths address
        // slots directly), so skip register allocation for it.
        if (use_regalloc && !func_has_float(funcs[i])) { reg_of = ssa.regalloc_linear(funcs[i], nregs()); }
        chunks = chunks.append(emit_func(funcs[i], reg_of));
        i = i + 1;
    }
    out = out + util.str_join_chunks(chunks);
    // __fern_ssa_print(x0 = string handle): write each byte to stdout, then a
    // trailing newline — Fern's print / eprint append a '\n' (the native
    // backend, the interpreter, and the AST emitters all do). The string is
    // [len, b0, …] as 8-byte words; each byte's low octet is at its word
    // address (little-endian), so write 1 byte per word.
    out = out + "__fern_ssa_print:\n";
    out = out + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    out = out + "    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n";
    out = out + "    mov x19, x0\n";              // handle
    out = out + "    mov w22, w1\n";               // fd
    out = out + "    ldr w20, [x19]\n";            // len = word[0]
    out = out + "    mov w21, #0\n";               // i = 0
    out = out + ".Lfsp_loop:\n";
    out = out + "    cmp w21, w20\n    b.ge .Lfsp_done\n";
    out = out + "    add w0, w21, #1\n";           // i+1
    out = out + "    sbfiz x1, x0, #3, #32\n";      // (i+1)*8
    out = out + "    add x1, x19, x1\n";            // &word[i+1] = byte address
    out = out + "    mov x0, x22\n    mov x2, #1\n    mov x8, #64\n    svc #0\n";
    out = out + "    add w21, w21, #1\n    b .Lfsp_loop\n";
    out = out + ".Lfsp_done:\n";
    // Trailing newline: write one '\n' byte from a scratch stack slot.
    out = out + "    sub sp, sp, #16\n    mov w0, #10\n    strb w0, [sp]\n";
    out = out + "    mov x1, sp\n    mov x0, x22\n    mov x2, #1\n    mov x8, #64\n    svc #0\n";
    out = out + "    add sp, sp, #16\n";
    out = out + "    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
    // __fern_ssa_concat(x0 = a, x1 = b) → x0: new length-prefixed string.
    // Leaf (no bl), so it uses caller-saved x9..x15 freely — no frame.
    out = out + "__fern_ssa_concat:\n";
    out = out + "    ldr w9, [x0]\n";              // lenA
    out = out + "    ldr w10, [x1]\n";             // lenB
    out = out + "    add w11, w9, w10\n";          // total
    out = out + "    adrp x12, __fern_ssa_hp\n    add x12, x12, :lo12:__fern_ssa_hp\n";
    out = out + "    ldr x13, [x12]\n";            // result = hp
    out = out + "    add w14, w11, #1\n    sbfiz x14, x14, #3, #32\n    add x14, x13, x14\n    str x14, [x12]\n";   // hp += (total+1)*8
    out = out + "    str w11, [x13]\n";            // result[0] = total
    out = out + "    mov w11, #0\n";               // i = 0
    out = out + ".Lcat_a:\n    cmp w11, w9\n    b.ge .Lcat_a_done\n";
    out = out + "    add w12, w11, #1\n    sbfiz x12, x12, #3, #32\n";
    out = out + "    ldr w14, [x0, x12]\n    str w14, [x13, x12]\n";
    out = out + "    add w11, w11, #1\n    b .Lcat_a\n.Lcat_a_done:\n";
    out = out + "    mov w11, #0\n";               // j = 0
    out = out + ".Lcat_b:\n    cmp w11, w10\n    b.ge .Lcat_b_done\n";
    out = out + "    add w12, w11, #1\n    sbfiz x12, x12, #3, #32\n    ldr w15, [x1, x12]\n";    // b[j+1]
    out = out + "    add w12, w9, #1\n    add w12, w12, w11\n    sbfiz x12, x12, #3, #32\n";       // dst word = lenA+1+j
    out = out + "    str w15, [x13, x12]\n";
    out = out + "    add w11, w11, #1\n    b .Lcat_b\n.Lcat_b_done:\n";
    out = out + "    mov x0, x13\n    ret\n";
    // __fern_ssa_streq(x0 = a, x1 = b) → w0 (1 if equal content else 0).
    out = out + "__fern_ssa_streq:\n";
    out = out + "    ldr w9, [x0]\n";              // lenA
    out = out + "    ldr w10, [x1]\n";             // lenB
    out = out + "    cmp w9, w10\n    b.ne .Lsne_no\n";
    out = out + "    mov w11, #0\n";               // i = 0
    out = out + ".Lsne_loop:\n    cmp w11, w9\n    b.ge .Lsne_yes\n";
    out = out + "    add w12, w11, #1\n    sbfiz x12, x12, #3, #32\n";
    out = out + "    ldr w13, [x0, x12]\n    ldr w14, [x1, x12]\n";
    out = out + "    cmp w13, w14\n    b.ne .Lsne_no\n";
    out = out + "    add w11, w11, #1\n    b .Lsne_loop\n";
    out = out + ".Lsne_yes:\n    mov w0, #1\n    ret\n";
    out = out + ".Lsne_no:\n    mov w0, #0\n    ret\n";
    // strbuf — the global amortised-O(1) string builder. Byte buffer in .bss
    // (256 MiB, demand-zero) + a length. append copies a source string's
    // bytes (read from the [len, byte-per-word] layout); take materialises a
    // fresh [len, bytes…] string and clears the buffer. Leaf helpers (x9..x15).
    out = out + "    .bss\n    .align 8\n__fern_ssa_strbuf_data:\n    .zero 268435456\n";
    out = out + "    .data\n    .align 8\n__fern_ssa_strbuf_len:\n    .quad 0\n";
    out = out + "    .text\n";
    out = out + "__fern_ssa_strbuf_reset:\n";
    out = out + "    adrp x9, __fern_ssa_strbuf_len\n    add x9, x9, :lo12:__fern_ssa_strbuf_len\n    str xzr, [x9]\n    ret\n";
    out = out + "__fern_ssa_strbuf_append:\n";              // x0 = source string
    out = out + "    ldr w9, [x0]\n    cbz w9, .Lsba_done\n";
    out = out + "    adrp x10, __fern_ssa_strbuf_data\n    add x10, x10, :lo12:__fern_ssa_strbuf_data\n";
    out = out + "    adrp x11, __fern_ssa_strbuf_len\n    add x11, x11, :lo12:__fern_ssa_strbuf_len\n";
    out = out + "    ldr x12, [x11]\n    add x10, x10, x12\n";   // dst = data + curlen
    out = out + "    mov w13, #0\n";                       // i = 0
    out = out + ".Lsba_loop:\n    cmp w13, w9\n    b.ge .Lsba_fin\n";
    out = out + "    add w14, w13, #1\n    sbfiz x14, x14, #3, #32\n";   // (i+1)*8
    out = out + "    ldrb w15, [x0, x14]\n    strb w15, [x10]\n    add x10, x10, #1\n";
    out = out + "    add w13, w13, #1\n    b .Lsba_loop\n";
    out = out + ".Lsba_fin:\n    ldr x12, [x11]\n    add x12, x12, w9, uxtw\n    str x12, [x11]\n";
    out = out + ".Lsba_done:\n    ret\n";
    out = out + "__fern_ssa_strbuf_take:\n";               // → x0
    out = out + "    adrp x11, __fern_ssa_strbuf_len\n    add x11, x11, :lo12:__fern_ssa_strbuf_len\n";
    out = out + "    ldr x9, [x11]\n";                     // total
    out = out + "    adrp x12, __fern_ssa_hp\n    add x12, x12, :lo12:__fern_ssa_hp\n";
    out = out + "    ldr x13, [x12]\n";                    // result = hp
    out = out + "    add x14, x9, #1\n    lsl x14, x14, #3\n    add x14, x13, x14\n    str x14, [x12]\n";   // hp += (total+1)*8
    out = out + "    str w9, [x13]\n";                     // result[0] = total
    out = out + "    adrp x10, __fern_ssa_strbuf_data\n    add x10, x10, :lo12:__fern_ssa_strbuf_data\n";
    out = out + "    mov x15, #0\n";                       // i = 0
    out = out + ".Lsbt_loop:\n    cmp x15, x9\n    b.ge .Lsbt_fin\n";
    out = out + "    ldrb w14, [x10, x15]\n";               // byte i
    out = out + "    add x12, x15, #1\n    lsl x12, x12, #3\n    str w14, [x13, x12]\n";   // result[i+1] = byte
    out = out + "    add x15, x15, #1\n    b .Lsbt_loop\n";
    out = out + ".Lsbt_fin:\n    str xzr, [x11]\n    mov x0, x13\n    ret\n";
    // File I/O — read_file / write_file lowered to the Linux aarch64 syscall
    // runtime (openat=56, read=63, write=64, close=57, lseek=62; AT_FDCWD
    // -100). Strings here use the SSA [len, byte-per-8-byte-word] layout, so
    // both helpers pack/unpack between that and the raw byte buffers the
    // syscalls work on (unlike the AST backend's {ptr,len}-over-packed-bytes).
    // Both allocate via __fern_ssa_alloc; the result is a fixed 2-word
    // [tag@0, payload@8] box matching the SSA Option/Result lowering.
    // __fern_ssa_alloc(x0 = bytes) → x0 = base (8-aligned bump off __fern_ssa_hp).
    out = out + "__fern_ssa_alloc:\n";
    out = out + "    add x0, x0, #7\n    lsr x0, x0, #3\n    lsl x1, x0, #3\n";   // round up to 8
    out = out + "    adrp x2, __fern_ssa_hp\n    add x2, x2, :lo12:__fern_ssa_hp\n";
    out = out + "    ldr x0, [x2]\n    add x3, x0, x1\n    str x3, [x2]\n    ret\n";
    // __fern_ssa_read_file(x0 = path string box) → x0 = Result box:
    // [tag=0@0, payload=string@8] Ok on success, [tag=1@0, payload=0@8] Err on
    // any I/O error. Packs the path to a NUL-terminated C string, opens
    // O_RDONLY, sizes via lseek(SEEK_END), reads to a packed byte buffer, then
    // expands those bytes into a fresh SSA [len, byte-per-word] string.
    out = out + "__fern_ssa_read_file:\n";
    out = out + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    out = out + "    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n    stp x23, x24, [sp, #-16]!\n";
    out = out + "    mov x19, x0\n";                  // path box
    out = out + "    ldr w21, [x19]\n";               // path len (word0)
    out = out + "    add x0, x21, #1\n    bl __fern_ssa_alloc\n    mov x22, x0\n";   // pathz buffer
    out = out + "    mov x9, #0\n";
    out = out + ".Lssa_rdf_copy:\n    cmp x9, x21\n    b.ge .Lssa_rdf_copydone\n";
    out = out + "    add x10, x9, #1\n    lsl x10, x10, #3\n    ldr w11, [x19, x10]\n";   // path word[i+1] low byte
    out = out + "    strb w11, [x22, x9]\n    add x9, x9, #1\n    b .Lssa_rdf_copy\n";
    out = out + ".Lssa_rdf_copydone:\n    mov w11, #0\n    strb w11, [x22, x21]\n";   // NUL
    out = out + "    mov x0, #-100\n    mov x1, x22\n    mov x2, #0\n    mov x3, #0\n    mov x8, #56\n    svc #0\n";   // openat O_RDONLY
    out = out + "    cmp x0, #0\n    b.lt .Lssa_rdf_err\n    mov x23, x0\n";   // fd
    out = out + "    mov x0, x23\n    mov x1, #0\n    mov x2, #2\n    mov x8, #62\n    svc #0\n    mov x24, x0\n";   // lseek SEEK_END → size
    out = out + "    mov x0, x23\n    mov x1, #0\n    mov x2, #0\n    mov x8, #62\n    svc #0\n";   // lseek SEEK_SET 0
    out = out + "    mov x0, x24\n    bl __fern_ssa_alloc\n    mov x24, x0\n    mov x20, x0\n    mov x21, #0\n";   // packed buf base / write ptr / total
    out = out + ".Lssa_rdf_rdloop:\n    mov x0, x23\n    mov x1, x20\n    ldr x2, =1048576\n    mov x8, #63\n    svc #0\n";   // read up to 1 MiB
    out = out + "    cmp x0, #0\n    b.le .Lssa_rdf_rddone\n    add x21, x21, x0\n    add x20, x20, x0\n    b .Lssa_rdf_rdloop\n";
    out = out + ".Lssa_rdf_rddone:\n    mov x0, x23\n    mov x8, #57\n    svc #0\n";   // close
    // Build SSA string [total, byte-per-word] from the packed buffer (x24).
    out = out + "    add x0, x21, #1\n    lsl x0, x0, #3\n    bl __fern_ssa_alloc\n    mov x9, x0\n";   // strbox
    out = out + "    str w21, [x9]\n";                // len = word0
    out = out + "    mov x10, #0\n";
    out = out + ".Lssa_rdf_expand:\n    cmp x10, x21\n    b.ge .Lssa_rdf_expanddone\n";
    out = out + "    ldrb w11, [x24, x10]\n    add x12, x10, #1\n    lsl x12, x12, #3\n    str w11, [x9, x12]\n";   // strbox[i+1] = byte
    out = out + "    add x10, x10, #1\n    b .Lssa_rdf_expand\n";
    out = out + ".Lssa_rdf_expanddone:\n    mov x24, x9\n";   // strbox
    out = out + "    mov x0, #16\n    bl __fern_ssa_alloc\n    mov x1, #0\n    str x1, [x0]\n    str x24, [x0, #8]\n";   // Ok box
    out = out + "    b .Lssa_rdf_ret\n";
    out = out + ".Lssa_rdf_err:\n    mov x0, #16\n    bl __fern_ssa_alloc\n    mov x1, #1\n    str x1, [x0]\n    mov x1, #0\n    str x1, [x0, #8]\n";   // Err box
    out = out + ".Lssa_rdf_ret:\n";
    out = out + "    ldp x23, x24, [sp], #16\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
    // __fern_ssa_write_file(x0 = path box, x1 = content box) → x0 = Result box:
    // [tag=0@0, 0@8] Ok(()) on success, [tag=1@0, 0@8] Err on any I/O error.
    // Packs the content (SSA word-per-byte → raw bytes) and the NUL-terminated
    // path, opens O_WRONLY|O_CREAT|O_TRUNC=577 mode 0644, writes, closes.
    out = out + "__fern_ssa_write_file:\n";
    out = out + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    out = out + "    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n    stp x23, x24, [sp, #-16]!\n";
    out = out + "    mov x19, x0\n";                  // path box
    out = out + "    mov x20, x1\n";                  // content box
    out = out + "    ldr w21, [x20]\n";               // content len
    out = out + "    add x0, x21, #1\n    bl __fern_ssa_alloc\n    mov x22, x0\n";   // packed content buffer
    out = out + "    mov x9, #0\n";
    out = out + ".Lssa_wf_pack:\n    cmp x9, x21\n    b.ge .Lssa_wf_packdone\n";
    out = out + "    add x10, x9, #1\n    lsl x10, x10, #3\n    ldr w11, [x20, x10]\n    strb w11, [x22, x9]\n";   // content word[i+1] → byte
    out = out + "    add x9, x9, #1\n    b .Lssa_wf_pack\n";
    out = out + ".Lssa_wf_packdone:\n";
    out = out + "    ldr w23, [x19]\n";               // path len
    out = out + "    add x0, x23, #1\n    bl __fern_ssa_alloc\n    mov x24, x0\n";   // pathz
    out = out + "    mov x9, #0\n";
    out = out + ".Lssa_wf_pcopy:\n    cmp x9, x23\n    b.ge .Lssa_wf_pcopydone\n";
    out = out + "    add x10, x9, #1\n    lsl x10, x10, #3\n    ldr w11, [x19, x10]\n    strb w11, [x24, x9]\n";
    out = out + "    add x9, x9, #1\n    b .Lssa_wf_pcopy\n";
    out = out + ".Lssa_wf_pcopydone:\n    mov w11, #0\n    strb w11, [x24, x23]\n";   // NUL
    out = out + "    mov x0, #-100\n    mov x1, x24\n    mov x2, #577\n    mov x3, #420\n    mov x8, #56\n    svc #0\n";   // openat O_WRONLY|O_CREAT|O_TRUNC, 0644
    out = out + "    cmp x0, #0\n    b.lt .Lssa_wf_err\n    mov x23, x0\n    mov x24, #0\n";   // fd / written
    out = out + ".Lssa_wf_loop:\n    cmp x24, x21\n    b.ge .Lssa_wf_done\n";
    out = out + "    mov x0, x23\n    add x1, x22, x24\n    sub x2, x21, x24\n    mov x8, #64\n    svc #0\n";   // write remaining
    out = out + "    cmp x0, #0\n    b.lt .Lssa_wf_errclose\n    add x24, x24, x0\n    b .Lssa_wf_loop\n";
    out = out + ".Lssa_wf_done:\n    mov x0, x23\n    mov x8, #57\n    svc #0\n";   // close
    out = out + "    mov x0, #16\n    bl __fern_ssa_alloc\n    str xzr, [x0]\n    str xzr, [x0, #8]\n";   // Ok(()) box
    out = out + "    b .Lssa_wf_ret\n";
    out = out + ".Lssa_wf_errclose:\n    mov x0, x23\n    mov x8, #57\n    svc #0\n";   // close, ignore result
    out = out + ".Lssa_wf_err:\n    mov x0, #16\n    bl __fern_ssa_alloc\n    mov x1, #1\n    str x1, [x0]\n    str xzr, [x0, #8]\n";   // Err box
    out = out + ".Lssa_wf_ret:\n";
    out = out + "    ldp x23, x24, [sp], #16\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
    // __fern_ssa_write(x0 = string handle): like __fern_ssa_print but with NO
    // trailing newline (the driver's raw-output primitive). One write syscall
    // per byte over the [len, byte-per-word] layout.
    out = out + "__fern_ssa_write:\n";
    out = out + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    out = out + "    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n";
    out = out + "    mov x19, x0\n";              // handle
    out = out + "    ldr w20, [x19]\n";            // len = word[0]
    out = out + "    mov w21, #0\n";               // i = 0
    out = out + ".Lfsw_loop:\n";
    out = out + "    cmp w21, w20\n    b.ge .Lfsw_done\n";
    out = out + "    add w0, w21, #1\n";           // i+1
    out = out + "    sbfiz x1, x0, #3, #32\n";      // (i+1)*8
    out = out + "    add x1, x19, x1\n";            // &word[i+1] = byte address
    out = out + "    mov x0, #1\n    mov x2, #1\n    mov x8, #64\n    svc #0\n";   // write(1, &byte, 1)
    out = out + "    add w21, w21, #1\n    b .Lfsw_loop\n";
    out = out + ".Lfsw_done:\n";
    out = out + "    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
    // argv vector saved by _start (argc + &argv[0]) for __fern_ssa_args.
    out = out + "    .bss\n    .align 8\n__fern_ssa_argc:\n    .zero 8\n__fern_ssa_argv:\n    .zero 8\n    .text\n";
    // __fern_ssa_args() → x0 = SSA string[] [argc, strptr0, …], each strptr a
    // fresh SSA [len, byte-per-word] string copied from the C argv[i]. Mirrors
    // read_file's C-string → SSA-string packing; x19-x24 survive __fern_ssa_alloc.
    out = out + "__fern_ssa_args:\n";
    out = out + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    out = out + "    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n    stp x23, x24, [sp, #-16]!\n";
    out = out + "    adrp x9, __fern_ssa_argc\n    add x9, x9, :lo12:__fern_ssa_argc\n    ldr x19, [x9]\n";   // x19 = argc
    out = out + "    add x0, x19, #1\n    lsl x0, x0, #3\n    bl __fern_ssa_alloc\n    mov x20, x0\n";   // arr base, (argc+1) words
    out = out + "    str w19, [x20]\n";            // arr[0] = argc
    out = out + "    adrp x9, __fern_ssa_argv\n    add x9, x9, :lo12:__fern_ssa_argv\n    ldr x21, [x9]\n";   // x21 = &argv[0]
    out = out + "    mov x22, #0\n";               // i = 0
    out = out + ".Lssa_args_loop:\n    cmp x22, x19\n    b.ge .Lssa_args_done\n";
    out = out + "    ldr x23, [x21, x22, lsl #3]\n";   // x23 = argv[i] (C string)
    out = out + "    mov x24, #0\n";               // strlen
    out = out + ".Lssa_args_strlen:\n    ldrb w9, [x23, x24]\n    cbz w9, .Lssa_args_strdone\n    add x24, x24, #1\n    b .Lssa_args_strlen\n";
    out = out + ".Lssa_args_strdone:\n";
    out = out + "    add x0, x24, #1\n    lsl x0, x0, #3\n    bl __fern_ssa_alloc\n    mov x9, x0\n";   // SSA string box (x9 survives: no bl until next loop)
    out = out + "    str w24, [x9]\n";             // box[0] = len
    out = out + "    mov x10, #0\n";               // j = 0
    out = out + ".Lssa_args_copy:\n    cmp x10, x24\n    b.ge .Lssa_args_copydone\n";
    out = out + "    ldrb w11, [x23, x10]\n    add x12, x10, #1\n    lsl x12, x12, #3\n    str w11, [x9, x12]\n";   // box[j+1] = byte
    out = out + "    add x10, x10, #1\n    b .Lssa_args_copy\n";
    out = out + ".Lssa_args_copydone:\n    add x12, x22, #1\n    lsl x12, x12, #3\n    str x9, [x20, x12]\n";   // arr[i+1] = box
    out = out + "    add x22, x22, #1\n    b .Lssa_args_loop\n";
    out = out + ".Lssa_args_done:\n    mov x0, x20\n";
    out = out + "    ldp x23, x24, [sp], #16\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
    out = out + "_start:\n";
    // Save argc + &argv[0] before any stack use (sp points at argc at entry).
    out = out + "    ldr x9, [sp]\n    adrp x10, __fern_ssa_argc\n    add x10, x10, :lo12:__fern_ssa_argc\n    str x9, [x10]\n";
    out = out + "    add x9, sp, #8\n    adrp x10, __fern_ssa_argv\n    add x10, x10, :lo12:__fern_ssa_argv\n    str x9, [x10]\n";
    out = out + "    adrp x9, __fern_ssa_heap\n";
    out = out + "    add x9, x9, :lo12:__fern_ssa_heap\n";
    out = out + "    adrp x10, __fern_ssa_hp\n";
    out = out + "    add x10, x10, :lo12:__fern_ssa_hp\n";
    out = out + "    str x9, [x10]\n";
    out = out + "    bl __fn_main\n";
    out = out + "    mov x8, #93\n";
    out = out + "    svc #0\n";
    return out;
}
