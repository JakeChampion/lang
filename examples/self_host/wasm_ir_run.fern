// examples/self_host/wasm_ir_run.fern — differential driver for the wasm IR
// code path (the wasm sibling of asm_ir_run, whose -target flag also covers arm64). With a `-ir`
// flag: when set AND the module is in the pure-i32 IR subset, it emits via the
// IR path (wasm_ir.emit_module_ir: AST -> stack IR -> WAT); otherwise it uses
// the unchanged AST backend (wasm.emit_module). The companion Go test pipes
// each program through both ways, runs the WAT under wasmtime, and asserts
// identical exit codes — proving the wasm IR path is behaviour-equivalent to
// the production AST path on the shared i32 subset.
//
// A SEPARATE driver so wasm.fern + the wasm_run bootstrap stay untouched.

import "std/io";
import "./lexer";
import "./parser";
import "./util";
import "./asmcore";
import "./irlower";
import "./wasm";
import "./wasm_ir";

function main(): i32 {
    var av: string[] = args();
    var use_ir: boolean = false;
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-ir") { use_ir = true; }
        ai = ai + 1;
    }
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    // Call-arity gate (#4360): shared with wasm_run — an arg-count mismatch
    // must reject before either the IR or the AST-fallback emit runs, not
    // miscompile. Checked on a default-filled COPY (the emit input is
    // untouched; both emit paths fill defaults themselves).
    var arity_errs: string = asmcore.check_call_arity(parser.fill_default_args_module(mod));
    // Bare-map_new chain gate (native E038/E003 parity) — same
    // reject-don't-miscompile rationale as the arity gate.
    arity_errs = arity_errs + asmcore.check_map_new_chain(mod);
    if (arity_errs.len() > 0) {
        eprint(arity_errs);
        return 1;
    }
    // subprocess (child-process spawning) is unsupportable on wasm/WASI. Reject
    // it with a clean diagnostic here — before either emit path — rather than
    // routing to the AST emitter (no wasm subprocess runtime → invalid WAT) or
    // emitting a broken IR module (#4320). This is the one op that is an
    // error-endpoint even in the full async/socket port.
    if (wasm_ir.module_uses_subprocess(mod)) {
        eprint("error: subprocess is not supported on the wasm target\n");
        return 1;
    }
    var emitted: string = "";
    var lm: parser.Module = wasm_ir.lift_lambdas(mod);
    // Eligibility must be judged with the builtin structs/enums injected
    // (FileStat / ProcessResult / IoError variants) — a struct-returning builtin
    // like stat() (whose match arm `Ok(s) => s.size` needs the FileStat layout to
    // lower) is only judged eligible once FileStat is present; otherwise it falls
    // to the AST path (which has no wasm stat runtime). Inject into a SEPARATE
    // copy used only for the eligibility decision — `lm` itself stays un-injected
    // so the monomorphise + post-monomorphize injection below assign struct
    // type-ids in the exact order the AST path uses (injecting before
    // monomorphize would renumber user structs and break struct programs).
    var elm: parser.Module = parser.Module { funcs: lm.funcs, structs: parser.inject_builtin_enums(lm.structs), aliases: lm.aliases, imports: lm.imports, top_stmts: lm.top_stmts, enums: lm.enums, resources: lm.resources, exports: lm.exports, impls: lm.impls, trait_reqs: lm.trait_reqs };
    // Judge eligibility BOTH ways: `lm_ok` is the exact verdict the un-injected
    // module gets (the main-path behaviour — every program that lowered before
    // still lowers identically), `elm_ok` additionally lets a struct-returning
    // builtin like stat() — only lowerable once FileStat is injected — qualify.
    var lm_ok: boolean = wasm_ir.wasm_eligible(lm);
    var elm_ok: boolean = wasm_ir.wasm_eligible(elm);
    if (use_ir && (lm_ok || elm_ok)) {
        // Hoist no-capture lambda arguments to top-level functions (closures
        // slice 2a) so callback-style lambdas ride the slice-1 function-value
        // path; lambda-free modules are unchanged. The AST fallback keeps the
        // original `mod`.
        // Monomorphise bounded generics (functions + generic structs/enums) on
        // the IR path, the same expansion module_with_builtins runs for the AST
        // path — otherwise a generic body keeps its `T[]` params, so an element
        // method like `xs[i].to_string()` can't see the concrete element type and
        // mis-dispatches (e.g. defaulting `.to_string()` to the i32 runtime
        // helper on a string element). The x86-64 driver (asm_run) gets this via
        // module_with_builtins; the wasm IR driver did its own lighter prep and
        // skipped it (#3893). Non-generic modules are unchanged (the passes
        // no-op when nothing is bounded-generic), so IR-eligible programs that
        // already worked keep their exact output.
        mod = parser.monomorphize_enums(parser.monomorphize_structs(parser.monomorphize_module(parser.register_map_method_generics(parser.register_array_method_generics(lm)))));
        // Inject the builtin structs/enums (FileStat / ProcessResult / IoError
        // variants) ONLY when they're what made the module eligible — i.e. a
        // struct-returning builtin like stat() that the un-injected module can't
        // lower (`!lm_ok && elm_ok`). Without them stat() has no FileStat layout,
        // so the match arm `Ok(s) => s.size` can't resolve its field offsets AND
        // the module_emits_op("stat") gate bails, so the $__fern_stat runtime +
        // import are never emitted (invalid module). For every program that was
        // already eligible un-injected (`lm_ok`), skip the injection so its IR
        // output stays byte-identical to before — appending the builtin structs
        // perturbs the emitter even when they're unused.
        if (!lm_ok && elm_ok) {
            mod = parser.Module { funcs: mod.funcs, structs: parser.inject_builtin_enums(mod.structs), aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
        }
        // Force the IR path: orchestrate the module wrapper + wasm's heap/RC
        // runtime + wasm_ir.emit_functions (the same orchestration
        // wasm.emit_module's use_ir dispatch does).
        // Lower every function ONCE and thread the cache through every collect /
        // gate pass below — this driver queries module_emits_op / module_uses_* /
        // str_values ~50× per compile, and re-lowering the whole module per query
        // is the O(functions²) × O(passes) blowup that OOMed large modules
        // (#4652). Mirrors wasm.emit_module's ir_cache.
        var ir_cache: irlower.LowerResult[] = wasm_ir.lower_all_for(mod);
        var o: string = "(module\n";
        o = o + "  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n";
        // wasi random_get import (issue #2747) — must precede the function
        // section. Emitted when the module uses random_bytes / random_i32.
        if (wasm_ir.module_uses_random(ir_cache)) { o = o + wasm.random_get_import(); }
        // print_int / print_str / eprint_str / putchar write via WASI fd_write
        // — import it only when the module writes to stdout or stderr.
        if (wasm_ir.module_emits_op_cached(ir_cache, "print_int") || wasm_ir.module_emits_op_cached(ir_cache, "print_str") || wasm_ir.module_emits_op_cached(ir_cache, "eprint_str") || wasm_ir.module_emits_op_cached(ir_cache, "putchar") || wasm_ir.module_emits_op_cached(ir_cache, "write_file")) {
            o = o + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n";
        }
        // read_file / write_file open paths under preopen fd 3: path_open +
        // fd_read + fd_close (write_file also uses the fd_write import above).
        // read_dir ALSO needs path_open + fd_close, so it shares this bundle (an
        // unused fd_read import for a read_dir-only module is valid wasm) and adds
        // only fd_readdir below — avoiding a double path_open / fd_close import.
        // These imports must precede the function section.
        // remove_dir_all ALSO needs path_open + fd_close (+ fd_readdir below), so
        // it joins this union too.
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { o = o + wasm.file_imports(); }
        // read_dir / remove_dir_all list a directory via fd_readdir (path_open /
        // fd_close come from file_imports above) — emit the standalone fd_readdir
        // import once across both.
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { o = o + wasm.readdir_fd_import(); }
        // read_line / read_int / read_chunk read stdin (fd 0) via fd_read.
        // file_imports above already imports fd_read for path-based file I/O, so
        // emit the standalone fd_read import ONLY when the module reads stdin but
        // does NOT do file I/O — otherwise fd_read would be imported twice (an
        // invalid module).
        if ((wasm_ir.module_emits_op_cached(ir_cache, "read_line") || wasm_ir.module_emits_op_cached(ir_cache, "read_int") || wasm_ir.module_emits_op_cached(ir_cache, "read_chunk")) && !(wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all"))) {
            o = o + wasm.stdin_fd_read_import();
        }
        // reader_close calls preview1 fd_close. file_imports supplies fd_close for
        // path I/O, so emit the standalone fd_close import ONLY for a reader that
        // does no file I/O — otherwise fd_close would be imported twice.
        if (wasm_ir.module_emits_op_cached(ir_cache, "reader_close") && !(wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all"))) {
            o = o + wasm.reader_fd_close_import();
        }
        // The clock builtins (monotonic_ns / now_unix_ms / now_ns) wrap the
        // preview1 wasi clock_time_get import — emitted (before the function
        // section, like the other imports) when the module reads any clock.
        if (wasm_ir.module_emits_op_cached(ir_cache, "monotonic_ns") || wasm_ir.module_emits_op_cached(ir_cache, "now_unix_ms") || wasm_ir.module_emits_op_cached(ir_cache, "now_ns") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) {
            o = o + "  (import \"wasi_snapshot_preview1\" \"clock_time_get\" (func $clock_time_get (param i32 i64 i32) (result i32)))\n";
        }
        // args() reads the wasi argv vector — its args_sizes_get / args_get
        // imports must precede the function section, emitted when the module
        // reads argv.
        if (wasm_ir.module_emits_op_cached(ir_cache, "args")) { o = o + wasm.args_helpers(); }
        // env(name) scans the wasi environ vector — its environ_sizes_get /
        // environ_get imports must precede the function section, emitted when the
        // module reads an env var.
        if (wasm_ir.module_emits_op_cached(ir_cache, "env")) { o = o + wasm.env_helpers(); }
        // stat(path) uses the preview1 path_filestat_get import (must precede the
        // function section), emitted when the module stats a file.
        if (wasm_ir.module_emits_op_cached(ir_cache, "stat")) { o = o + wasm.stat_import(); }
        // remove_file / remove_dir_all use the preview1 path_unlink_file import
        // (remove_dir_all unlinks the regular files it finds) — emit it once across
        // both (must precede the function section).
        if (wasm_ir.module_emits_op_cached(ir_cache, "remove_file") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { o = o + wasm.remove_file_import(); }
        // remove_dir_all also rmdirs each emptied directory via path_remove_directory.
        if (wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { o = o + wasm.remove_dir_import(); }
        // temp_dir(prefix) mkdirs a unique dir under the preopen via
        // path_create_directory (must precede the function section).
        if (wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) { o = o + wasm.temp_dir_import(); }
        // sleep_ms blocks on a monotonic-clock timeout via poll_oneoff.
        if (wasm_ir.module_emits_op_cached(ir_cache, "sleep_ms")) { o = o + wasm.sleep_ms_import(); }
        // Preview-2 timer-pollable ops (#4317): direct component-model imports.
        // A module using them composes to a component (see wasm_ir helpers).
        if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_timer_pollable")) { o = o + wasm_ir.wasi_subscribe_duration_import(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_pollable_drop")) { o = o + wasm_ir.wasi_pollable_drop_import(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_block")) { o = o + wasm_ir.wasi_pollable_block_import(); }
        o = o + "  (memory (export \"memory\") 16)\n";
        // String literals -> data-section blocks `[len:i32 LE][bytes]`. Emitted
        // caller-side (wasm owns le32_escape/wat_escape); wasm_ir supplies the
        // distinct values + their offsets so the data + const_str ptrs agree.
        var sv: string[] = wasm_ir.str_values(ir_cache);
        var di: i32 = 0;
        while (di < sv.len()) {
            o = o + "  (data (i32.const " + util.i32_to_string(wasm_ir.str_offset(sv, di)) + ") \""
                + wasm.le32_escape(sv[di].len()) + wasm.wat_escape(sv[di]) + "\")\n";
            di = di + 1;
        }
        if (wasm_ir.module_allocates(ir_cache) || wasm_ir.module_uses_i32_to_string(ir_cache) || wasm_ir.module_uses_chr(ir_cache) || wasm_ir.module_uses_strbuf(ir_cache) || wasm_ir.module_emits_op_cached(ir_cache, "env") || wasm_ir.module_emits_op_cached(ir_cache, "stat") || wasm_ir.module_emits_op_cached(ir_cache, "remove_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir") || wasm_ir.module_emits_op_cached(ir_cache, "sleep_ms") || wasm_ir.module_emits_op_cached(ir_cache, "read_chunk") || wasm_ir.module_emits_op_cached(ir_cache, "reader_close")) {
            o = o + wasm.heap_alloc_helpers(wasm_ir.heap_base_for(ir_cache), wasm_ir.fl_base_for(ir_cache), wasm_ir.fl_cells());
            o = o + wasm.rc_runtime_helpers(wasm_ir.heap_base_for(ir_cache));
        }
        // $__fern_arr_dec_ptr2 (string[][] deep reclaim, #4355 slice 9): only
        // when the module lowers a __fern_strarrarr_free call — see
        // wasm.arr_dec_ptr2_func for why it must not ride along unconditionally.
        if (wasm_ir.module_calls_strarrarr_free(ir_cache)) { o = o + wasm.arr_dec_ptr2_func(wasm_ir.heap_base_for(ir_cache)); }
        if (wasm_ir.module_calls_optarrarr_free(ir_cache)) { o = o + wasm.optarrarr_free_func(wasm_ir.heap_base_for(ir_cache)); }
        // $__fern_strbuf_* (global string-builder): a growable bump-heap buffer +
        // reset/append/take. Heap-backed (str_box / alloc), emitted above.
        if (wasm_ir.module_uses_strbuf(ir_cache)) { o = o + wasm.strbuf_helpers(); }
        // Per-type $__field_reclaim_<T> + $__struct_drop_<T> RC helper bodies
        // (#3457, Perceus slices 1c/1d + slice-3 nested deep-drop). emit_module's
        // own IR orchestration emits these; this differential driver assembles the
        // helper section itself, so it MUST emit them too — otherwise a struct
        // program whose deep-drop lowering inserts a `call $__struct_drop_<T>`
        // links against an undefined function and traps under wasmtime
        // (`unknown func $__struct_drop_<T>`). Returns "" for modules with no rc
        // fields, so non-struct programs are unchanged.
        o = o + wasm.emit_ir_rc_bodies(mod, ir_cache);
        if (wasm_ir.module_uses_divrem(ir_cache)) { o = o + wasm.divrem_helpers(); }
        if (wasm_ir.module_uses_i64_divrem(ir_cache)) { o = o + wasm.divrem64_helpers(); }
        // $__fern_exp_f64: e^x via a polynomial (no transcendental wasm
        // instruction). Self-contained f64 math — no imports or heap. fpow (x^y =
        // exp(y·ln x)) reuses it, so its gate folds fpow in (emitted once).
        if (wasm_ir.module_emits_op_cached(ir_cache, "fexp") || wasm_ir.module_emits_op_cached(ir_cache, "fpow")) { o = o + wasm.exp_func(); }
        // $__fern_log_f64: ln x via a polynomial (same — self-contained f64 math).
        // fpow reuses it too, so its gate folds fpow in.
        if (wasm_ir.module_emits_op_cached(ir_cache, "flog") || wasm_ir.module_emits_op_cached(ir_cache, "fpow")) { o = o + wasm.log_func(); }
        // $__fern_pow_f64: x^y = exp(y·ln x) — composes the two helpers above.
        if (wasm_ir.module_emits_op_cached(ir_cache, "fpow")) { o = o + wasm.pow_func(); }
        // $__fern_sin_f64 / $__fern_cos_f64: trig via argument reduction + Taylor
        // polynomials (no transcendental wasm instruction). Self-contained f64 math.
        if (wasm_ir.module_emits_op_cached(ir_cache, "fsin")) { o = o + wasm.sin_func(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "fcos")) { o = o + wasm.cos_func(); }
        // $__fern_strcat + $__fern_streq (concat / equality); references
        // $__fern_str_box from heap_alloc_helpers, which module_allocates pulls
        // in for any string program.
        if (wasm_ir.module_uses_strings(ir_cache) || wasm_ir.module_uses_maps(ir_cache)) { o = o + wasm.strcat_streq_helpers(); }
        // $__fern_i32_to_str backs i32.to_string() (wasm_helper_symbol maps the
        // IR call_direct to it).
        if (wasm_ir.module_uses_i32_to_string(ir_cache)) { o = o + wasm.to_string_helpers(); }
        // $__fern_now_ns / $__fern_now_unix_ms / $__fern_monotonic_ns back the
        // clock builtins (each result i64), reading the preview1 clock_time_get
        // import into the 8-byte scratch at addr 16 — emitted as a trio (the AST
        // path does the same) when the module reads any clock.
        if (wasm_ir.module_emits_op_cached(ir_cache, "monotonic_ns") || wasm_ir.module_emits_op_cached(ir_cache, "now_unix_ms") || wasm_ir.module_emits_op_cached(ir_cache, "now_ns") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) { o = o + wasm.clock_funcs(); }
        // $__fern_args builds the argv string[] via the wasi args_get import +
        // the heap runtime (module_allocates pulls the heap in for an args
        // module — op_allocates admits "args"). Emitted when the module reads argv.
        if (wasm_ir.module_emits_op_cached(ir_cache, "args")) { o = o + wasm.args_func(); }
        // $__fern_env(name): scan the environ vector for `NAME=`, box an
        // Option[string] (Some(value)/None). Heap-backed (allocates the value +
        // box), so the heap gate above folds env in.
        if (wasm_ir.module_emits_op_cached(ir_cache, "env")) { o = o + wasm.env_func(); }
        // $__fern_build_io_error(errno, path): map a WASI errno to a real
        // IoError variant box, shared by every fs helper's error path (the wasm
        // sibling of native wasmbin's __build_io_error / asm_ir's
        // __fern_io_error). Emit it once whenever any fs op is present so the
        // helpers' Err/Some payloads carry a matchable variant, not a raw errno.
        if (wasm_ir.module_emits_op_cached(ir_cache, "stat") || wasm_ir.module_emits_op_cached(ir_cache, "remove_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir") || wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file")) { o = o + wasm_ir.build_io_error_func(mod.structs); }
        // $__fern_stat(path, fstype): path_filestat_get -> FileStat struct +
        // Result box. Heap-backed (allocates the buffer + boxes), so folded into
        // the heap gate above.
        if (wasm_ir.module_emits_op_cached(ir_cache, "stat")) { o = o + wasm.stat_func(); }
        // $__fern_remove_file(path): path_unlink_file -> Option[IoError] box.
        // Heap-backed (allocates the box), so folded into the heap gate above.
        if (wasm_ir.module_emits_op_cached(ir_cache, "remove_file")) { o = o + wasm.remove_file_func(); }
        // $__fern_read_dir(path): path_open + fd_readdir loop -> Result[string[],
        // IoError] box. Heap-backed (allocates names + array + box) and uses
        // $__fern_arr_push (emitted by the arr_push gate below, which folds
        // read_dir in).
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_dir")) { o = o + wasm.read_dir_func(); }
        // $__fern_remove_dir_all(path): recursive rm -rf -> Option[IoError] box.
        // Heap-backed + uses $__fern_arr_push (both folded into the gates above).
        if (wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { o = o + wasm.remove_dir_func(); }
        // $__fern_temp_dir(prefix): mkdir a unique `<prefix>-<ns>` dir under the
        // preopen -> Result[string, IoError]. Heap-backed + uses the clock helper.
        if (wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) { o = o + wasm.temp_dir_func(); }
        // $__fern_sleep_ms(ms): block via poll_oneoff. Heap-backed (scratch buffer).
        if (wasm_ir.module_emits_op_cached(ir_cache, "sleep_ms")) { o = o + wasm.sleep_ms_func(); }
        // $__fern_read_file / $__fern_write_file: open under preopen fd 3 and
        // read/write the whole file, boxing a Result[string, IoError] /
        // Option[IoError]. They alloc via the heap runtime (module_allocates
        // pulls it in — op_allocates admits read_file/write_file). Emitted when
        // the module does the matching file op.
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_file")) { o = o + wasm.readfile_func(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "write_file")) { o = o + wasm.writefile_func(); }
        // $__fern_read_line boxes a line of stdin (heap-gated via op_allocates);
        // $__fern_read_int parses an int into scratch (no heap). Emitted when the
        // module reads stdin.
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_line")) { o = o + wasm.read_line_func(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_int")) { o = o + wasm.read_int_func(); }
        // $__fern_reader_read_chunk(fd,n) / $__fern_reader_close(fd) back the
        // Reader intrinsics (r.read_chunk(n) / r.close()) — a Reader is just its fd
        // (stdin = fd 0). Both box (Option[string] / Option[IoError]), so they ride
        // the heap runtime (gated in above); read_chunk reads via fd_read, close
        // via fd_close (imports emitted above). Backs std/io read_all_stdin on wasm.
        if (wasm_ir.module_emits_op_cached(ir_cache, "read_chunk")) { o = o + wasm.reader_read_chunk_func(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "reader_close")) { o = o + wasm.reader_close_func(); }
        // $__fern_str_to_i32 backs str_to_i32(s); allocation-free, own gate.
        if (wasm_ir.module_uses_str_to_i32(ir_cache)) { o = o + wasm.str_to_i32_helper(); }
        // $__fern_chr backs chr(n); allocates (heap gate ORs in module_uses_chr).
        if (wasm_ir.module_uses_chr(ir_cache)) { o = o + wasm.chr_helper(); }
        if (wasm_ir.module_uses_str_cmp(ir_cache)) { o = o + wasm.strcmp_helper(); }
        // $__fern_substr backs str_slice AND str_split (split slices each
        // segment), so emit it for either — but only ONCE.
        if (wasm_ir.module_uses_str_slice(ir_cache) || wasm_ir.module_emits_op_cached(ir_cache, "str_split") || wasm_ir.module_uses_str_lines(ir_cache)) { o = o + wasm.substr_helper(); }
        // $__fern_str_split (+ its private $__fern_arr_push) for the IR path.
        if (wasm_ir.module_emits_op_cached(ir_cache, "str_split") || wasm_ir.module_uses_str_lines(ir_cache)) { o = o + wasm.str_split_helper(); }
        // Scalar string search predicates (starts_with / ends_with / index_of /
        // contains) — self-contained, emitted only when used.
        if (wasm_ir.module_uses_str_predicate(ir_cache)) { o = o + wasm.str_predicate_helpers(); }
        // ASCII case transforms (to_upper / to_lower) — self-contained, emitted
        // only when used.
        if (wasm_ir.module_uses_str_case(ir_cache)) { o = o + wasm.str_case_helpers(); }
        // String repeat — self-contained, emitted only when used.
        if (wasm_ir.module_uses_str_repeat(ir_cache)) { o = o + wasm.str_repeat_helper(); }
        // String trim — self-contained, emitted only when used (IR-only on wasm).
        if (wasm_ir.module_uses_str_trim(ir_cache)) { o = o + wasm.str_trim_helper(); }
        // String reverse — self-contained, emitted only when used (IR-only on wasm).
        if (wasm_ir.module_uses_str_reverse(ir_cache)) { o = o + wasm.str_reverse_helper(); }
        // String replace — self-contained, emitted only when used (IR-only on wasm).
        if (wasm_ir.module_uses_str_replace(ir_cache)) { o = o + wasm.str_replace_helper(); }
        // String chars — self-contained, emitted only when used (IR-only on wasm).
        if (wasm_ir.module_uses_str_chars(ir_cache)) { o = o + wasm.str_chars_helper(); }
        // String lines — split on \n + trailing-empty trim (IR-only on wasm).
        if (wasm_ir.module_uses_str_lines(ir_cache)) { o = o + wasm.str_lines_helper(); }
        if (wasm_ir.module_uses_arr_slice(ir_cache)) { o = o + wasm.arr_slice_helper(); }
        if (wasm_ir.module_uses_arr_slice8(ir_cache)) { o = o + wasm.arr_slice8_helper(); }
        // `.append` (op_arr_push) emits a call to $__fern_arr_push; the IR path
        // needs the standalone push helper (the AST path's arr_helpers bundle —
        // which also defines arr_slice/slice8 — would double-define those, so use
        // the push-only emitter). Depends on $__fern_arr_box (module_allocates).
        // A self-reassign append (`a = a.append(v)`) lowers to op_arr_push_owned,
        // which calls $__fern_arr_push_owned (the reclaim-on-grow wrapper) — so it
        // must pull in BOTH $__fern_arr_push and the owned wrapper, else a program
        // whose only appends are self-reassigns calls an undefined function.
        // read_dir builds its string[] result via $__fern_arr_push, so it folds
        // into this gate (emitted once — a read_dir module that ALSO uses .append
        // shares the single definition).
        // str_split_helper (emitted above for str_split / str_lines) already
        // begins with arr_push_helper(), so it defines $__fern_arr_push itself —
        // gating that out here keeps the single definition (else a module using
        // BOTH .split()/lines AND .append double-defines it → "duplicate func").
        var needs_arr_push: boolean = wasm_ir.module_emits_op_cached(ir_cache, "arr_push") || wasm_ir.module_emits_op_cached(ir_cache, "arr_push_owned") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all");
        var split_emits_push: boolean = wasm_ir.module_emits_op_cached(ir_cache, "str_split") || wasm_ir.module_uses_str_lines(ir_cache);
        if (needs_arr_push && !split_emits_push) { o = o + wasm.arr_push_helper(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "arr_push_owned")) { o = o + wasm.arr_push_owned_helper(wasm_ir.heap_base_for(ir_cache)); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "arr_push_i64")) { o = o + wasm.arr_push_i64_helper(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "arr_push_f64")) { o = o + wasm.arr_push_f64_helper(); }
        if (wasm_ir.module_uses_maps(ir_cache)) { o = o + wasm.map_helpers(); }
        // $__fern_map_iter + accessors: the wasm map-iterator runtime (materializes
        // keys/values via map_helpers above, so gated after it). Emitted when the
        // module iterates a map (m.iter() / for-in-map).
        if (wasm_ir.module_emits_op_cached(ir_cache, "map_iter")) { o = o + wasm.map_iter_helpers(); }
        // Byte-source helpers (issue #2747). random_bytes returns a [len][bytes]
        // string block; str_bytes returns a u8[]; both reference the heap runtime
        // ($__fern_str_box / $__fern_arr_box) that module_allocates pulls in.
        // random_i32 is heap-free. The import is emitted above.
        if (wasm_ir.module_emits_op_cached(ir_cache, "random_bytes")) { o = o + wasm.random_bytes_ir_func(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "random_i32")) { o = o + wasm.random_i32_func(); }
        // print_int's $__fern_print_int: digit buffer in the 16-byte scratch past
        // the string blocks (the `+16` in fl_base_for); iovec in the low-24 scratch.
        if (wasm_ir.module_emits_op_cached(ir_cache, "print_int")) { o = o + wasm.print_int_helper(wasm_ir.str_offset(sv, sv.len())); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "print_str")) { o = o + wasm.print_str_helper(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "eprint_str")) { o = o + wasm.eprint_str_helper(); }
        if (wasm_ir.module_emits_op_cached(ir_cache, "str_bytes")) { o = o + wasm.str_bytes_func(); }
        // string_from_bytes(arr) packs a u8[] into a string block via
        // $__fern_string_from_bytes; op_str_from_bytes emits the call, so the
        // helper must be present (its absence left a dangling call -> the wasm
        // module failed to link). Depends on $__fern_alloc / $__fern_str_box,
        // which module_allocates pulls in via heap_alloc_helpers.
        if (wasm_ir.module_emits_op_cached(ir_cache, "str_from_bytes")) { o = o + wasm.string_from_bytes_helper(); }
        // Function-value support: the $fn<N> call_indirect signature types, the
        // funcref table, and its elem segment (empty for non-closure modules).
        o = o + wasm_ir.fn_support_section(ir_cache);
        o = o + wasm_ir.emit_functions(mod, ir_cache);
        o = o + "  (func $_start (call $proc_exit (call $main)))\n";
        o = o + "  (export \"_start\" (func $_start)))\n";
        emitted = o;
    } else {
        emitted = wasm.emit_module(parser.module_with_builtins(mod));
    }
    write(emitted);
    return 0;
}
