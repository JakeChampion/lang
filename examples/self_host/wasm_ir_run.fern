// examples/self_host/wasm_ir_run.fern — differential driver for the wasm IR
// code path (the wasm sibling of asm_ir_run, whose -target flag also covers arm64). With a `-ir`
// flag: when set AND the module is in the pure-i32 IR subset, it emits via the
// IR path (wasm_ir.emit_module_ir: AST -> stack IR -> WAT); otherwise it uses
// the unchanged AST backend (wasm.emit_module). The companion Go test pipes
// each program through both ways, runs the WAT under wasmtime, and asserts
// identical exit codes — proving the wasm IR path is behaviour-equivalent to
// the production AST path on the shared i32 subset.
//
// A SEPARATE driver so wasm.fern + the wasm_run bootstrap stay untouched.

import "std/io";
import "./lexer";
import "./parser";
import "./util";
import "./asmcore";
import "./irlower";
import "./wasm";
import "./wasm_ir";

function main(): i32 {
    var av: string[] = args();
    var use_ir: boolean = false;
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-ir") { use_ir = true; }
        ai = ai + 1;
    }
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    // Call-arity gate (#4360): shared with wasm_run — an arg-count mismatch
    // must reject before either the IR or the AST-fallback emit runs, not
    // miscompile. Checked on a default-filled COPY (the emit input is
    // untouched; both emit paths fill defaults themselves).
    var arity_errs: string = asmcore.check_call_arity(parser.fill_default_args_module(mod));
    // Bare-map_new chain gate (native E038/E003 parity) — same
    // reject-don't-miscompile rationale as the arity gate.
    arity_errs = arity_errs + asmcore.check_map_new_chain(mod);
    // Undefined-callee gate (native E001, #5644): a callee naming nothing
    // otherwise reaches the emitter's generic call path, which emits a call
    // against a symbol nothing defines — an opaque load-time `unknown func`
    // instead of a diagnostic pointing at the source.
    arity_errs = arity_errs + asmcore.check_undefined_calls(mod);
    if (arity_errs.len() > 0) {
        eprint(arity_errs);
        return 1;
    }
    // Builtins with no wasm meaning at all (subprocess #4320, timer_fd #4317)
    // are error endpoints, not deferrals: reject here, before either emit path,
    // rather than routing to the AST emitter — which has no runtime for them and
    // emits a call against a symbol nothing defines.
    var unsupported: string = wasm_ir.wasm_unsupported_builtin(mod);
    if (unsupported.len() > 0) {
        eprint(wasm_ir.wasm_unsupported_message(unsupported));
        return 1;
    }
    var emitted: string = "";
    var lm: parser.Module = wasm_ir.lift_lambdas(mod);
    // Eligibility must be judged with the builtin structs/enums injected
    // (FileStat / ProcessResult / IoError variants) — a struct-returning builtin
    // like stat() (whose match arm `Ok(s) => s.size` needs the FileStat layout to
    // lower) is only judged eligible once FileStat is present; otherwise it falls
    // to the AST path (which has no wasm stat runtime). Inject into a SEPARATE
    // copy used only for the eligibility decision — `lm` itself stays un-injected
    // so the monomorphise + post-monomorphize injection below assign struct
    // type-ids in the exact order the AST path uses (injecting before
    // monomorphize would renumber user structs and break struct programs).
    var elm: parser.Module = parser.Module { funcs: lm.funcs, structs: parser.inject_builtin_enums(lm.structs), aliases: lm.aliases, imports: lm.imports, top_stmts: lm.top_stmts, enums: lm.enums, resources: lm.resources, exports: lm.exports, impls: lm.impls, trait_reqs: lm.trait_reqs };
    // Judge eligibility BOTH ways: `lm_ok` is the exact verdict the un-injected
    // module gets (the main-path behaviour — every program that lowered before
    // still lowers identically), `elm_ok` additionally lets a struct-returning
    // builtin like stat() — only lowerable once FileStat is injected — qualify.
    var lm_ok: boolean = wasm_ir.wasm_eligible(lm);
    var elm_ok: boolean = wasm_ir.wasm_eligible(elm);
    // Monomorphise bounded generics (functions + generic structs/enums) on the
    // IR path — the same expansion module_with_builtins runs for the AST path.
    // Hoisted out of the emit block because it is ALSO what lets an erased-wide-
    // container module qualify: an erased generic `some1[T](x: T): Option[T]`
    // (or `Result` / `T[]`) is promoted to bounded (parser targeted promotion),
    // so this pass CLONES it per concrete instantiation — `some1__i64` with a
    // concrete `Option[i64]` return. After cloning, no call passes a wide value
    // through a bare-typevar param (each targets a concrete clone), so
    // `module_erased_wide` clears and the module lowers on the wasm IR path
    // instead of deferring to AST. Non-generic modules no-op (nothing bounded).
    var mmod: parser.Module = parser.monomorphize_enums(parser.monomorphize_structs(parser.monomorphize_module(parser.register_map_method_generics(parser.register_array_method_generics(lm)))));
    // `mono_ok` is the erased-wide-container rescue: only consulted when the raw
    // verdicts both say defer, so every program that already lowered keeps its
    // exact IR/AST verdict (and byte-identical output). Judging the SAME
    // monomorphised module the emit uses makes eligibility match what is emitted.
    var mono_ok: boolean = false;
    if (!lm_ok && !elm_ok) { mono_ok = wasm_ir.wasm_eligible(mmod); }
    if (use_ir && (lm_ok || elm_ok || mono_ok)) {
        mod = mmod;
        // Inject the builtin structs/enums (FileStat / ProcessResult / IoError
        // variants) ONLY when they're what made the module eligible — i.e. a
        // struct-returning builtin like stat() that the un-injected module can't
        // lower (`!lm_ok && elm_ok`). Without them stat() has no FileStat layout,
        // so the match arm `Ok(s) => s.size` can't resolve its field offsets AND
        // the module_emits_op("stat") gate bails, so the $__fern_stat runtime +
        // import are never emitted (invalid module). For every program that was
        // already eligible un-injected (`lm_ok`), skip the injection so its IR
        // output stays byte-identical to before — appending the builtin structs
        // perturbs the emitter even when they're unused.
        if (!lm_ok && elm_ok) {
            mod = parser.Module { funcs: mod.funcs, structs: parser.inject_builtin_enums(mod.structs), aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
        }
        // Force the IR path. Lower every function ONCE and hand the cache to
        // emit_ir_module, which queries module_emits_op / module_uses_* /
        // str_values ~50× — re-lowering per query is the O(functions²) ×
        // O(passes) blowup that OOMed large modules (#4652).
        var ir_cache: irlower.LowerResult[] = wasm_ir.lower_all_for(mod);
        // The module emission itself lives in wasm.emit_ir_module — the SINGLE
        // source of truth shared with wasm.emit_module_mode's IR branch. This
        // driver used to inline its own near-identical copy; the two drifted and
        // the emit_module_mode copy lost the whole WASI env/args/clock/fs surface,
        // emitting calls to helpers it never defined (#4801).
        emitted = wasm.emit_ir_module(mod, ir_cache);
    } else {
        emitted = wasm.emit_module(parser.module_with_builtins(mod));
    }
    write(emitted);
    return 0;
}
