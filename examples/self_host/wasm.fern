// str_split_helper emits the IR-path string→string[] runtime: a private
// $__fern_arr_push (via arr_push_helper) plus $__fern_str_split, which builds
// the result array with that push and slices each segment via $__fern_substr
// (the IR runtime emits substr_helper alongside this). It is SELF-CONTAINED so
// callers need only gate on str_split; a program that ALSO uses `.append` must
// therefore emit the standalone arr_push_helper only when str_split is absent
// (otherwise $__fern_arr_push would be defined twice). Depends only on
// $__fern_str_box / $__fern_arr_box from the heap runtime (module_allocates).
// The split body is transcribed verbatim from the strcat_helpers bundle's
// $__fern_str_split.
pub function str_split_helper(): string {
    var o: string = arr_push_helper();
    o = o + "  (func $__fern_str_split (param $s i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $sl i32) (local $sepl i32) (local $i i32) (local $start i32) (local $arr i32) (local $piece i32) (local $j i32) (local $match i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (local.set $sepl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (if (i32.eqz (local.get $sepl)) (then (return (call $__fern_arr_push (local.get $arr) (local.get $s)))))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $i) (i32.sub (local.get $sl) (local.get $sepl))))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm (loop $cm\n";
    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $sepl)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm)))\n";
    o = o + "      (if (local.get $match) (then\n";
    o = o + "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $i)))\n";
    o = o + "        (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (local.get $sepl)))\n";
    o = o + "        (local.set $start (local.get $i)))\n";
    o = o + "      (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $sl)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

pub function strcat_streq_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_strcat (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (i32.add (local.get $la) (local.get $lb)))))\n";
    o = o + "    (i32.store (local.get $p) (i32.add (local.get $la) (local.get $lb)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $da (loop $ca\n";
    o = o + "      (br_if $da (i32.ge_u (local.get $i) (local.get $la)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ca)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.ge_u (local.get $i) (local.get $lb)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $la)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cb)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_streq(a, b): 1 if the two string blocks are byte-equal.
    o = o + "  (func $__fern_streq (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (if (i32.ne (local.get $la) (i32.load (local.get $b))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $la)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    return o;
}

// strcmp_helper emits ONLY $__fern_strcmp (lexicographic -1/0/1). It is
// self-contained — it reads the two string boxes and calls nothing — so the IR
// path can pull in string ordering without the full strcat_helpers bundle
// (whose split/predicate helpers reference $__fern_arr_push and friends).
pub function strcmp_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_strcmp (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $n i32) (local $i i32) (local $ca i32) (local $cb i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $n (local.get $la))\n";
    o = o + "    (if (i32.lt_u (local.get $lb) (local.get $la)) (then (local.set $n (local.get $lb))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d2 (loop $c2\n";
    o = o + "      (br_if $d2 (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $ca (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $cb (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.lt_u (local.get $ca) (local.get $cb)) (then (return (i32.const -1))))\n";
    o = o + "      (if (i32.gt_u (local.get $ca) (local.get $cb)) (then (return (i32.const 1))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c2)))\n";
    o = o + "    (if (i32.lt_u (local.get $la) (local.get $lb)) (then (return (i32.const -1))))\n";
    o = o + "    (if (i32.gt_u (local.get $la) (local.get $lb)) (then (return (i32.const 1))))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}

// strcat_helpers emits the full string runtime bundle: concat + equality (via
// strcat_streq_helpers) then compare / split / predicate / case+repeat. Depends
// on $__fern_alloc from heap_alloc_helpers; the split/predicate helpers also use
// array helpers. Used by the AST wasm path.
pub function strcat_helpers(): string {
    var o: string = strcat_streq_helpers();
    // $__fern_strcmp(a, b): -1 / 0 / 1 lexicographic (unsigned bytes;
    // shorter prefix is less).
    o = o + "  (func $__fern_strcmp (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $n i32) (local $i i32) (local $ca i32) (local $cb i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $n (local.get $la))\n";
    o = o + "    (if (i32.lt_u (local.get $lb) (local.get $la)) (then (local.set $n (local.get $lb))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d2 (loop $c2\n";
    o = o + "      (br_if $d2 (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $ca (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $cb (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.lt_u (local.get $ca) (local.get $cb)) (then (return (i32.const -1))))\n";
    o = o + "      (if (i32.gt_u (local.get $ca) (local.get $cb)) (then (return (i32.const 1))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c2)))\n";
    o = o + "    (if (i32.lt_u (local.get $la) (local.get $lb)) (then (return (i32.const -1))))\n";
    o = o + "    (if (i32.gt_u (local.get $la) (local.get $lb)) (then (return (i32.const 1))))\n";
    o = o + "    (i32.const 0))\n";
    // $__fern_str_startswith(s, p): 1 if s begins with p.
    o = o + "  (func $__fern_str_startswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $lp i32) (local $j i32)\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (i32.load (local.get $s))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_str_endswith(s, p): 1 if s ends with p.
    o = o + "  (func $__fern_str_endswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lp i32) (local $off i32) (local $j i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (local.get $ls)) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $off (i32.sub (local.get $ls) (local.get $lp)))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d3 (loop $c3\n";
    o = o + "      (br_if $d3 (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $off) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c3)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_str_indexof(s, sub): first index of sub in s, or -1
    // (empty sub → 0). Naive O(n*m) scan.
    o = o + "  (func $__fern_str_indexof (param $s i32) (param $sub i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lsub i32) (local $i i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lsub (i32.load (local.get $sub)))\n";
    o = o + "    (if (i32.eqz (local.get $lsub)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.gt_u (local.get $lsub) (local.get $ls)) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $od (loop $oc\n";
    o = o + "      (br_if $od (i32.gt_u (local.get $i) (i32.sub (local.get $ls) (local.get $lsub))))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (block $id (loop $ic\n";
    o = o + "        (br_if $id (i32.ge_u (local.get $j) (local.get $lsub)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sub) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $id)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ic)))\n";
    o = o + "      (if (local.get $ok) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $oc)))\n";
    o = o + "    (i32.const -1))\n";
    // $__fern_str_upper / _lower(s): fresh block, ASCII-cased copy.
    o = o + "  (func $__fern_str_upper (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 97)) (i32.le_u (local.get $ch) (i32.const 122))) (then (local.set $ch (i32.sub (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    o = o + "  (func $__fern_str_lower (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dl (loop $cl\n";
    o = o + "      (br_if $dl (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 65)) (i32.le_u (local.get $ch) (i32.const 90))) (then (local.set $ch (i32.add (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_repeat(s, n): n copies of s in a fresh block.
    o = o + "  (func $__fern_str_repeat (param $s i32) (param $n i32) (result i32)\n";
    o = o + "    (local $l i32) (local $total i32) (local $p i32) (local $k i32) (local $i i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $total (i32.mul (local.get $l) (local.get $n)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $k (i32.const 0))\n";
    o = o + "    (block $dk (loop $ck\n";
    o = o + "      (br_if $dk (i32.ge_s (local.get $k) (local.get $n)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $di (loop $ci\n";
    o = o + "        (br_if $di (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (i32.mul (local.get $k) (local.get $l)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $ci)))\n";
    o = o + "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
    o = o + "      (br $ck)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_substr(s, start, end): fresh block with s[start:end).
    o = o + "  (func $__fern_substr (param $s i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $len i32) (local $p i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $s))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $len (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_join(a, sep): join the string[] a with sep into one
    // fresh string block.
    o = o + "  (func $__fern_str_join (param $a i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $n i32) (local $sl i32) (local $total i32) (local $i i32) (local $p i32) (local $w i32) (local $elem i32) (local $el i32) (local $j i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $sl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $total (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dt (loop $ct\n";
    o = o + "      (br_if $dt (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $total (i32.add (local.get $total) (i32.load (local.get $elem))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ct)))\n";
    o = o + "    (if (i32.gt_s (local.get $n) (i32.const 0)) (then (local.set $total (i32.add (local.get $total) (i32.mul (local.get $sl) (i32.sub (local.get $n) (i32.const 1)))))))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $w (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dj (loop $cj\n";
    o = o + "      (br_if $dj (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (if (i32.gt_s (local.get $i) (i32.const 0)) (then\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $ds (loop $cs\n";
    o = o + "          (br_if $ds (i32.ge_s (local.get $j) (local.get $sl)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j))))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $cs)))\n";
    o = o + "        (local.set $w (i32.add (local.get $w) (local.get $sl)))))\n";
    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $el (i32.load (local.get $elem)))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $de (loop $ce\n";
    o = o + "        (br_if $de (i32.ge_s (local.get $j) (local.get $el)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $elem) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ce)))\n";
    o = o + "      (local.set $w (i32.add (local.get $w) (local.get $el)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cj)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_split(s, sep): split s on sep into a fresh string[]
    // (built via arr_push). Empty sep → single-element [s].
    o = o + "  (func $__fern_str_split (param $s i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $sl i32) (local $sepl i32) (local $i i32) (local $start i32) (local $arr i32) (local $piece i32) (local $j i32) (local $match i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (local.set $sepl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (if (i32.eqz (local.get $sepl)) (then (return (call $__fern_arr_push (local.get $arr) (local.get $s)))))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $i) (i32.sub (local.get $sl) (local.get $sepl))))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm (loop $cm\n";
    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $sepl)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm)))\n";
    o = o + "      (if (local.get $match) (then\n";
    o = o + "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $i)))\n";
    o = o + "        (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (local.get $sepl)))\n";
    o = o + "        (local.set $start (local.get $i)))\n";
    o = o + "      (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $sl)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// collect_strings_expr interns every string literal reachable from an
// expression into the table.
function collect_strings_expr(e: parser.Expr, t: StrTable): StrTable {
    match (e) {
        parser.ExprString(se) => { return t.intern(se.value); },
        parser.ExprUnary(u) => { return collect_strings_expr(u.operand, t); },
        parser.ExprBinary(b) => {
            t = collect_strings_expr(b.left, t);
            return collect_strings_expr(b.right, t);
        },
        parser.ExprCall(c) => {
            // Walk the callee too — a method call like `"abc".len()`
            // hides its literal in the ExprFieldAccess receiver.
            t = collect_strings_expr(c.callee, t);
            var i: i32 = 0;
            while (i < c.args.len()) {
                t = collect_strings_expr(c.args[i], t);
                i = i + 1;
            }
            return t;
        },
        parser.ExprFieldAccess(fa) => {
            return collect_strings_expr(fa.obj, t);
        },
        parser.ExprSlice(sl) => {
            t = collect_strings_expr(sl.array, t);
            t = collect_strings_expr(sl.start, t);
            return collect_strings_expr(sl.end, t);
        },
        parser.ExprTuple(tu) => {
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                t = collect_strings_expr(tu.elements[ti], t);
                ti = ti + 1;
            }
            return t;
        },
        parser.ExprLambda(lm) => {
            // Intern string literals inside the lambda body (it compiles
            // against the same module string table).
            return collect_strings_stmts(lm.body, t);
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                t = collect_strings_expr(a.elements[i], t);
                i = i + 1;
            }
            return t;
        },
        parser.ExprIndex(ix) => {
            t = collect_strings_expr(ix.array, t);
            return collect_strings_expr(ix.index, t);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { t = collect_strings_expr(sl.base, t); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                t = collect_strings_expr(sl.field_values[i], t);
                i = i + 1;
            }
            return t;
        },
        _ => { return t; },
    }
    return t;
}

// collect_strings_stmts recurses a statement list (and nested if/while
// bodies) interning every string literal.
function collect_strings_stmts(body: parser.Stmt[], t: StrTable): StrTable {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { t = collect_strings_expr(v.init, t); },
            parser.StmtAssign(a) => { t = collect_strings_expr(a.value, t); },
            parser.StmtReturn(r) => { t = collect_strings_expr(r.value, t); },
            parser.StmtExpr(e) => { t = collect_strings_expr(e.value, t); },
            parser.StmtIf(f) => {
                t = collect_strings_expr(f.cond, t);
                t = collect_strings_stmts(f.then_body, t);
                t = collect_strings_stmts(f.else_body, t);
            },
            parser.StmtWhile(w) => {
                t = collect_strings_expr(w.cond, t);
                t = collect_strings_stmts(w.body, t);
            },
            parser.StmtFor(f) => {
                t = collect_strings_expr(f.iter, t);
                t = collect_strings_stmts(f.body, t);
            },
            parser.StmtMatch(m) => {
                t = collect_strings_expr(m.scrutinee, t);
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    t = collect_strings_stmts(m.arms[k].body, t);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return t;
}

// write_fixed emits a fd_write of `len` bytes at the constant memory
// address `off` (used for the "\n" byte). The errno result is dropped.
function write_fixed(off: i32, len: i32): string {
    var o: string = "";
    o = o + "    (i32.store (i32.const 0) (i32.const " + util.i32_to_string(off) + "))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const " + util.i32_to_string(len) + "))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    return o;
}

// emit_output emits a `write` / `print` of a string VALUE — any
// expression that evaluates to a string pointer (literal, local, param,
// call result). The pointer is parked in the temp slot at addr 16, then
// the iovec is set from the block header: buf = ptr+4, len = load(ptr).
// `print` follows with the "\n" byte at addr 12 (Fern's `print` ==
// println; `write` is verbatim).
function emit_output(name: string, args: parser.Expr[], st: WState): WState {
    if (args.len() != 1) { return st; }
    var ptr: string = emit_expr(args[0], st.cx, 0);
    st = st.w("    (i32.store (i32.const 16) " + ptr + ")\n");
    st = st.w("    (i32.store (i32.const 0) (i32.add (i32.load (i32.const 16)) (i32.const 4)))\n");
    st = st.w("    (i32.store (i32.const 4) (i32.load (i32.load (i32.const 16))))\n");
    st = st.w("    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n");
    if (name == "print") {
        st = st.w(write_fixed(12, 1));
    }
    return st;
}

// emit_stmts lowers a statement list, appending to st.out.
function emit_stmts(body: parser.Stmt[], st: WState): WState {
    var i: i32 = 0;
    while (i < body.len()) {
        st = emit_stmt(body[i], st);
        i = i + 1;
    }
    return st;
}

// emit_stmt lowers a single statement.
function emit_stmt(stmt: parser.Stmt, st: WState): WState {
    match (stmt) {
        parser.StmtVar(v) => {
            // `var (a, b, …) = <tuple>` destructure: park the tuple pointer
            // in $__lit0 (the init is emitted at depth 1 so it won't clash),
            // then bind name[i] = tuple.i (element i lives at offset i*4).
            if (comma_index(v.name) >= 0) {
                var dnames: string[] = split_commas(v.name);
                st = st.w("    (local.set $__lit0 " + emit_expr(v.init, st.cx, 1) + ")\n");
                var di: i32 = 0;
                while (di < dnames.len()) {
                    st = st.w("    (local.set $" + dnames[di] + " (i32.load (i32.add (local.get $__lit0) (i32.const " + util.i32_to_string(di * 4) + "))))\n");
                    di = di + 1;
                }
                return st;
            }
            // `var xs: i64[] = […]` / `f64[]`: a bare integer / float
            // literal carries no width, so emit the literal with the
            // declared element kind (8-byte slots + i64/f64 stores).
            var dak: string = arr_kind_of_spelling(v.type_name);
            if (dak != "i32") {
                match (v.init) {
                    parser.ExprArray(arr) => {
                        return st.w("    (local.set $" + v.name + " " + emit_array_literal_kind(arr, dak, st.cx, 0) + ")\n");
                    },
                    _ => {},
                }
            }
            // An i64- / f64-typed binding coerces its initialiser to that
            // type so a bare literal (`var t: i64 = 0;` / `var x: f64 =
            // 1;`) becomes the right const.
            if (v.type_name == "i64") {
                return st.w("    (local.set $" + v.name + " " + emit_i64(v.init, st.cx, 0) + ")\n");
            }
            if (is_float_type(v.type_name)) {
                return st.w("    (local.set $" + v.name + " " + emit_f64(v.init, st.cx, 0) + ")\n");
            }
            // A swept array binding: release any prior buffer in the slot
            // (cow-guarded) before storing, so a re-bound local — e.g. a
            // loop body's `var r = build()` re-run each iteration — frees
            // the previous iteration's buffer instead of leaking it. The
            // slot is zero-init, so the first binding dec's null (a no-op).
            // A bare-ident alias (`var ys = xs`) then retains the buffer.
            if (contains_str(st.cx.arr_swept, v.name)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(v.init, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + v.name + ")) (then (drop (call $__fern_arr_dec (local.get $" + v.name + ")))))\n");
                st = st.w("    (local.set $" + v.name + " (local.get $__retv_i32))\n");
                if (init_is_arr_alias(v.init, st.cx.arr_src)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + v.name + ")))\n");
                }
                return st;
            }
            // A swept string binding: release any prior string in the slot
            // (cow-guarded) before storing, so a re-bound local — e.g. a
            // loop body's `var s = a + b` each iteration — frees the previous
            // iteration's string instead of leaking it. The slot is
            // zero-init, so the first binding releases null (a no-op). A
            // bare-ident alias then retains the string.
            if (contains_str(st.cx.str_swept, v.name)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(v.init, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + v.name + ")) (then (drop (call $__fern_arr_dec (local.get $" + v.name + ")))))\n");
                st = st.w("    (local.set $" + v.name + " (local.get $__retv_i32))\n");
                if (init_is_string_alias(v.init, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + v.name + ")))\n");
                }
                return st;
            }
            // Perceus tuple inc-on-alias: `var u = t` retains the tuple box
            // so the exit sweep's dec of both slots balances.
            if (contains_str(st.cx.tup_swept, v.name)) {
                st = st.w("    (local.set $" + v.name + " " + emit_expr(v.init, st.cx, 0) + ")\n");
                if (init_is_tuple_alias(v.init, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + v.name + ")))\n");
                }
                return st;
            }
            // Perceus struct re-bind reclaim: release any prior struct in the
            // slot (recursive, cow-guarded) before storing, so a loop-body
            // `var p = …` re-run each iteration — or the `cx = Ctx{...cx}`
            // threading idiom — frees the previous value instead of leaking it.
            // The `i32.ne` guard skips an in-place result (same pointer). The
            // slot is zero-init so the first binding releases null (a no-op).
            // A bare-ident alias then retains the struct box.
            if (contains_str(st.cx.struct_swept, v.name)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(v.init, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + v.name + ")) (then\n" + emit_struct_release(v.name, lookup_pair(st.cx.sv_names, st.cx.sv_types, v.name), st.cx) + "    ))\n");
                st = st.w("    (local.set $" + v.name + " (local.get $__retv_i32))\n");
                if (init_is_struct_alias(v.init, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + v.name + ")))\n");
                }
                return st;
            }
            // Perceus option re-bind reclaim: release any prior option in the
            // slot (payload-aware, cow-guarded) before storing, so a loop-body
            // `var o = Some(…)` re-run each iteration frees the previous value
            // instead of leaking it. The `i32.ne` guard skips an in-place
            // result; the slot is zero-init so the first binding releases null.
            // A bare-ident alias then retains the variant box.
            if (contains_str(st.cx.opt_swept, v.name)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(v.init, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + v.name + ")) (then\n" + emit_option_release(v.name, lookup_pair(st.cx.ol_names, st.cx.ol_payloads, v.name), st.cx) + "    ))\n");
                st = st.w("    (local.set $" + v.name + " (local.get $__retv_i32))\n");
                if (init_is_option_alias(v.init, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + v.name + ")))\n");
                }
                return st;
            }
            // Perceus map inc-on-alias: `var m2 = m` retains the map box so the
            // exit sweep's dec balances. A fresh map_new-rooted construction is
            // rc 1 already (no inc — that would leak).
            if (contains_str(st.cx.map_swept, v.name)) {
                st = st.w("    (local.set $" + v.name + " " + emit_expr(v.init, st.cx, 0) + ")\n");
                if (init_is_map_alias(v.init, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + v.name + ")))\n");
                }
                return st;
            }
            return st.w("    (local.set $" + v.name + " " + emit_expr(v.init, st.cx, 0) + ")\n");
        },
        parser.StmtAssign(a) => {
            if (contains_str(st.cx.i64_names, a.target)) {
                return st.w("    (local.set $" + a.target + " " + emit_i64(a.value, st.cx, 0) + ")\n");
            }
            if (contains_str(st.cx.f64_names, a.target)) {
                return st.w("    (local.set $" + a.target + " " + emit_f64(a.value, st.cx, 0) + ")\n");
            }
            // Reassigning an owned array local: release the old buffer and
            // retain a newly-aliased one. The new value is computed into a
            // scratch first; the release is cow-aware — an in-place
            // `xs = xs.append(v)` returns the SAME pointer, so dec'ing would
            // over-release (the `i32.ne` guard skips it). A bare-ident alias
            // (`xs = ys`) retains the new buffer so the exit sweep balances.
            if (contains_str(st.cx.arr_swept, a.target)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(a.value, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + a.target + ")) (then (drop (call $__fern_arr_dec (local.get $" + a.target + ")))))\n");
                st = st.w("    (local.set $" + a.target + " (local.get $__retv_i32))\n");
                if (init_is_arr_alias(a.value, st.cx.arr_src)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + a.target + ")))\n");
                }
                return st;
            }
            // Reassigning an owned string local (`s = s + x`): release the
            // old string (cow-guarded) and retain a newly-aliased one — so a
            // string-building loop reclaims each intermediate instead of
            // leaking all but the last.
            if (contains_str(st.cx.str_swept, a.target)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(a.value, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + a.target + ")) (then (drop (call $__fern_arr_dec (local.get $" + a.target + ")))))\n");
                st = st.w("    (local.set $" + a.target + " (local.get $__retv_i32))\n");
                if (init_is_string_alias(a.value, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + a.target + ")))\n");
                }
                return st;
            }
            // Reassigning an owned struct local (`cx = Ctx{...cx}`, `a = step(a)`):
            // release the old struct (recursive, cow-guarded) and retain a
            // newly-aliased one, so the threading idiom reclaims each
            // intermediate instead of leaking it. Only owned LOCALS are swept —
            // a borrowed struct PARAM reassigned isn't in struct_swept, so its
            // (caller-owned) first value is never cow-freed.
            if (contains_str(st.cx.struct_swept, a.target)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(a.value, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + a.target + ")) (then\n" + emit_struct_release(a.target, lookup_pair(st.cx.sv_names, st.cx.sv_types, a.target), st.cx) + "    ))\n");
                st = st.w("    (local.set $" + a.target + " (local.get $__retv_i32))\n");
                if (init_is_struct_alias(a.value, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + a.target + ")))\n");
                }
                return st;
            }
            // Reassigning an owned option local: release the old option
            // (payload-aware, cow-guarded) and retain a newly-aliased one. Only
            // owned LOCALS are in opt_swept — a borrowed option PARAM reassigned
            // isn't, so its (caller-owned) first value is never cow-freed.
            if (contains_str(st.cx.opt_swept, a.target)) {
                st = st.w("    (local.set $__retv_i32 " + emit_expr(a.value, st.cx, 0) + ")\n");
                st = st.w("    (if (i32.ne (local.get $__retv_i32) (local.get $" + a.target + ")) (then\n" + emit_option_release(a.target, lookup_pair(st.cx.ol_names, st.cx.ol_payloads, a.target), st.cx) + "    ))\n");
                st = st.w("    (local.set $" + a.target + " (local.get $__retv_i32))\n");
                if (init_is_option_alias(a.value, st.cx)) {
                    st = st.w("    (drop (call $__fern_rc_inc (local.get $" + a.target + ")))\n");
                }
                return st;
            }
            return st.w("    (local.set $" + a.target + " " + emit_expr(a.value, st.cx, 0) + ")\n");
        },
        parser.StmtReturn(r) => {
            // Compute the return value, then run the Perceus exit release
            // sweep (dec every owned array local), then return. Computing
            // the result BEFORE the sweep is the correct Perceus order:
            // the result observes the locals' live rc, and the sweep
            // balances the inc-on-alias retains so the over-release
            // detector stays clean. Free is OFF, so a dec'd-but-returned
            // buffer stays valid; the return-retain / move-on-return that
            // free-on needs rides on top of this same shape.
            //
            // The result is parked in a typed temp ($__retv_*) across the
            // sweep. i64- / f64-returning functions coerce; an i64[]/f64[]
            // function builds a bare `return […]` literal at its width.
            var valstr: string = "";
            var tmp: string = "$__retv_i32";
            if (st.cx.ret_i64) { valstr = emit_i64(r.value, st.cx, 0); tmp = "$__retv_i64"; }
            else if (st.cx.ret_f64) { valstr = emit_f64(r.value, st.cx, 0); tmp = "$__retv_f64"; }
            else if (st.cx.ret_arr_kind != "i32") {
                match (r.value) {
                    parser.ExprArray(arr) => { valstr = emit_array_literal_kind(arr, st.cx.ret_arr_kind, st.cx, 0); },
                    _ => { valstr = emit_expr(r.value, st.cx, 0); },
                }
            } else { valstr = emit_expr(r.value, st.cx, 0); }
            // Perceus move-on-return: returning a bare owned array local
            // hands its buffer to the caller — exclude it from the release
            // sweep (otherwise arr_dec would free it before the caller reads
            // it). The return-retain inc and that dec are a balanced pair.
            var mov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.arr_swept, id.name)) { mov = id.name; } },
                _ => {},
            }
            // String move-on-return: returning a bare owned string local
            // hands it to the caller — exclude it from the string sweep.
            var smov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.str_swept, id.name)) { smov = id.name; } },
                _ => {},
            }
            // Tuple move-on-return: a bare owned tuple local returned is
            // excluded from the tuple sweep (handed over at its rc).
            var tmov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.tup_swept, id.name)) { tmov = id.name; } },
                _ => {},
            }
            // Struct move-on-return: a bare owned struct/enum local returned is
            // excluded from the struct sweep (handed over at its rc).
            var struct_mov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.struct_swept, id.name)) { struct_mov = id.name; } },
                _ => {},
            }
            // Option/Result move-on-return: a bare owned option local returned
            // is excluded from the option sweep (handed over at its rc).
            var opt_mov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.opt_swept, id.name)) { opt_mov = id.name; } },
                _ => {},
            }
            // Map move-on-return: a bare owned map local returned is excluded
            // from the map sweep (handed over at its rc).
            var map_mov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.map_swept, id.name)) { map_mov = id.name; } },
                _ => {},
            }
            // Closure move-on-return: a bare owned closure local returned is
            // excluded from the closure sweep (handed over at its rc).
            var clos_mov: string = "";
            match (r.value) {
                parser.ExprIdent(id) => { if (contains_str(st.cx.clos_swept, id.name)) { clos_mov = id.name; } },
                _ => {},
            }
            var sweep: string = arr_exit_sweep_excl(st.cx, mov) + str_exit_sweep_excl(st.cx, smov) + tup_exit_sweep_excl(st.cx, tmov) + struct_exit_sweep_excl(st.cx, struct_mov) + opt_exit_sweep_excl(st.cx, opt_mov) + map_exit_sweep_excl(st.cx, map_mov) + clos_exit_sweep_excl(st.cx, clos_mov);
            // Perceus return-retain: when an array/string-returning function
            // hands back a BORROWED reference (a field / index read, or a
            // borrowed param — anything not a fresh literal/concat/slice/call
            // and not a move-on-return local), retain it so the caller owns a
            // counted reference. A fresh result is already owned (no inc — that
            // would leak); a move-on-return local is excluded from the sweep
            // and handed over as-is. This must apply even with NO swept locals
            // (a function that just `return obj.field` still owes the caller a
            // retain — else the caller's release of the result is a UAF).
            // Struct/enum return-retain: a borrowed struct/enum return (a real
            // field / index read, or a borrowed param) is retained so the
            // caller owns a counted reference; a fresh literal / constructor
            // call / move-on-return local is not (would leak / double-own).
            var struct_borrowed: boolean = struct_type_of(r.value, st.cx).len() > 0 && ret_struct_is_borrowed(r.value, st.cx);
            // Option/Result return-retain: a borrowed option return (a field /
            // index read, or a borrowed param) is retained so the caller owns a
            // counted reference; a fresh Some/Ok/Err / None / option-call is not.
            var opt_borrowed: boolean = scrutinee_payload(r.value, st.cx).len() > 0 && ret_option_is_borrowed(r.value, st.cx);
            // Map return-retain: a returned borrowed map (a map param, or a
            // field / index read) is retained; a fresh map_new-rooted result is
            // owned-and-moved (a returned swept local is excluded via map_mov).
            var map_borrowed: boolean = false;
            match (r.value) {
                parser.ExprIdent(id) => { map_borrowed = contains_str(st.cx.map_names, id.name); },
                _ => {},
            }
            var retain: boolean = ((st.cx.ret_is_array || st.cx.ret_is_string || st.cx.ret_is_tuple) && ret_value_is_borrowed(r.value) || struct_borrowed || opt_borrowed || map_borrowed) && mov.len() == 0 && smov.len() == 0 && tmov.len() == 0 && struct_mov.len() == 0 && opt_mov.len() == 0 && map_mov.len() == 0;
            if (st.cx.ret_void) {
                st = st.w(sweep);
                return st.w("    (return " + valstr + ")\n");
            }
            if (sweep.len() == 0) {
                if (retain) {
                    return st.w("    (return (call $__fern_rc_inc " + valstr + "))\n");
                }
                return st.w("    (return " + valstr + ")\n");
            }
            st = st.w("    (local.set " + tmp + " " + valstr + ")\n");
            if (retain) {
                st = st.w("    (drop (call $__fern_rc_inc (local.get " + tmp + ")))\n");
            }
            st = st.w(sweep);
            return st.w("    (return (local.get " + tmp + "))\n");
        },
        parser.StmtExpr(e) => {
            // write(...) / print(...) are builtins (not user funcs), so
            // intercept them here and emit the fd_write sequence rather
            // than a generic call.
            match (e.value) {
                parser.ExprCall(c) => {
                    match (c.callee) {
                        parser.ExprIdent(id) => {
                            if (id.name == "write" || id.name == "print") {
                                return emit_output(id.name, c.args, st);
                            }
                            // eprint(s): write s to stderr via $__fern_eprint
                            // (the preview2 stderr shim or the preview1 fd 2 path).
                            if (id.name == "eprint" && c.args.len() == 1) {
                                return st.w("    (call $__fern_eprint " + emit_expr(c.args[0], st.cx, 0) + ")\n");
                            }
                            // exit(code): terminate via $__fern_exit (wasi:cli/exit
                            // in component-io, proc_exit in the preview1 path).
                            if (id.name == "exit" && c.args.len() == 1) {
                                return st.w("    (call $__fern_exit " + emit_expr(c.args[0], st.cx, 0) + ")\n");
                            }
                            if (id.name == "print_int" && c.args.len() == 1) {
                                if (is_i64_expr(c.args[0], st.cx)) {
                                    return st.w("    (call $__fern_print_int64 " + emit_i64(c.args[0], st.cx, 0) + ")\n");
                                }
                                return st.w("    (call $__fern_print_int " + emit_expr(c.args[0], st.cx, 0) + ")\n");
                            }
                            // putchar(c): write c's low byte to stdout. Stash
                            // the byte at scratch addr 16, point the iovec
                            // (base@0, len@4) at it, and fd_write fd 1 — reusing
                            // the same stdout path as write/print (the $fd_write
                            // shim in component-io, the preview1 import otherwise).
                            if (id.name == "putchar" && c.args.len() == 1) {
                                st = st.w("    (i32.store8 (i32.const 16) " + emit_expr(c.args[0], st.cx, 0) + ")\n");
                                st = st.w("    (i32.store (i32.const 0) (i32.const 16))\n");
                                st = st.w("    (i32.store (i32.const 4) (i32.const 1))\n");
                                return st.w("    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n");
                            }
                            if (id.name == "__set_index" && c.args.len() == 3) {
                                // arr[idx] = v  (parser desugar). Store v at
                                // arr + 8 + idx*slot; an i64[]/f64[] uses an
                                // 8-byte slot + i64/f64 store of a wide value.
                                var sk: string = array_elem_kind(c.args[0], st.cx);
                                var sv: string = "";
                                if (sk == "i64") { sv = emit_i64(c.args[2], st.cx, 0); }
                                else if (sk == "f64") { sv = emit_f64(c.args[2], st.cx, 0); }
                                else { sv = emit_expr(c.args[2], st.cx, 0); }
                                return st.w("    (" + elem_store_op(sk) + " (i32.add (i32.add " + emit_expr(c.args[0], st.cx, 0) + " (i32.const 8)) (i32.mul " + emit_expr(c.args[1], st.cx, 0) + " (i32.const " + util.i32_to_string(elem_slot_size(sk)) + "))) " + sv + ")\n");
                            }
                            if (id.name == "__set_field" && c.args.len() == 3) {
                                // obj.field = v  (parser desugar). The
                                // field name is a string literal arg; store
                                // v at obj + index*4.
                                return st.w("    (i32.store (i32.add " + emit_expr(c.args[0], st.cx, 0) + " (i32.const " + util.i32_to_string(set_field_offset(c.args[0], c.args[1], st.cx)) + ")) " + emit_expr(c.args[2], st.cx, 0) + ")\n");
                            }
                        },
                        _ => {},
                    }
                },
                _ => {},
            }
            // A call to a void function / method leaves nothing on the
            // stack — emit it bare; everything else is value-producing and
            // gets dropped.
            if (expr_is_void_call(e.value, st.cx)) {
                return st.w("    " + emit_expr(e.value, st.cx, 0) + "\n");
            }
            return st.w("    (drop " + emit_expr(e.value, st.cx, 0) + ")\n");
        },
        parser.StmtIf(f) => {
            st = st.w("    (if " + emit_expr(f.cond, st.cx, 0) + " (then\n");
            st = emit_stmts(f.then_body, st);
            st = st.w("    )");
            if (f.else_body.len() > 0) {
                st = st.w(" (else\n");
                st = emit_stmts(f.else_body, st);
                st = st.w("    )");
            }
            return st.w(")\n");
        },
        parser.StmtWhile(w) => {
            var id: i32 = st.n;
            var brk: string = "$brk_" + util.i32_to_string(id);
            var cont: string = "$cont_" + util.i32_to_string(id);
            // Save the enclosing loop's labels; restore after the body.
            var outer_brk: string = st.brk;
            var outer_cont: string = st.cont;
            // Bump the label counter and enter this loop's label scope.
            var inner: WState = WState {
                ...st,
                out: st.out + "    (block " + brk + " (loop " + cont + "\n"
                    + "    (br_if " + brk + " (i32.eqz " + emit_expr(w.cond, st.cx, 0) + "))\n",
                n: id + 1,
                brk: brk,
                cont: cont,
            };
            inner = emit_stmts(w.body, inner);
            // Restore the enclosing loop's labels; keep accumulated
            // output + the advanced counter.
            return WState {
                ...inner,
                out: inner.out + "    (br " + cont + ")))\n",
                brk: outer_brk,
                cont: outer_cont,
            };
        },
        parser.StmtBreak(_) => {
            return st.w("    (br " + st.brk + ")\n");
        },
        parser.StmtContinue(_) => {
            return st.w("    (br " + st.cont + ")\n");
        },
        parser.StmtFor(f) => {
            // `for (k, v) in m { body }` → walk the map's slots: the box is
            // evaluated once into $__fa<d>; $__fi<d> is the slot index;
            // each live slot (used == 1) binds k = keys[i], v = vals[i].
            if (comma_index(f.var_name) >= 0) {
                var d2: i32 = st.fd;
                var fi2: string = "$__fi" + util.i32_to_string(d2);
                var fa2: string = "$__fa" + util.i32_to_string(d2);
                var id2: i32 = st.n;
                var brk2: string = "$fbrk_" + util.i32_to_string(id2);
                var loop2: string = "$floop_" + util.i32_to_string(id2);
                var bodycont2: string = "$fcont_" + util.i32_to_string(id2);
                var kn: string = before_comma(f.var_name);
                var vn: string = after_comma(f.var_name);
                var ob: string = st.brk;
                var oc: string = st.cont;
                var head2: string =
                    "    (local.set " + fa2 + " " + emit_expr(f.iter, st.cx, 0) + ")\n"
                    + "    (local.set " + fi2 + " (i32.const 0))\n"
                    + "    (block " + brk2 + " (loop " + loop2 + "\n"
                    + "    (br_if " + brk2 + " (i32.ge_s (local.get " + fi2 + ") (i32.load (i32.add (local.get " + fa2 + ") (i32.const 4)))))\n"
                    + "    (if (i32.eq (i32.load (i32.add (i32.load (i32.add (local.get " + fa2 + ") (i32.const 16))) (i32.mul (local.get " + fi2 + ") (i32.const 4)))) (i32.const 1)) (then\n"
                    + "    (local.set $" + kn + " (i32.load (i32.add (i32.load (i32.add (local.get " + fa2 + ") (i32.const 8))) (i32.mul (local.get " + fi2 + ") (i32.const 4)))))\n"
                    + "    (local.set $" + vn + " (i32.load (i32.add (i32.load (i32.add (local.get " + fa2 + ") (i32.const 12))) (i32.mul (local.get " + fi2 + ") (i32.const 4)))))\n"
                    + "    (block " + bodycont2 + "\n";
                var inner2: WState = WState {
                    ...st,
                    out: st.out + head2,
                    n: id2 + 1,
                    brk: brk2,
                    cont: bodycont2,
                    fd: d2 + 1,
                };
                inner2 = emit_stmts(f.body, inner2);
                return WState {
                    ...inner2,
                    out: inner2.out + "    )))\n    (local.set " + fi2 + " (i32.add (local.get " + fi2 + ") (i32.const 1)))\n    (br " + loop2 + ")))\n",
                    brk: ob,
                    cont: oc,
                    fd: d2,
                };
            }
            // `for v in arr { body }` → index walk. The iterated array is
            // evaluated once into $__fa<d>; $__fi<d> is the index; v is
            // bound to arr[idx] each turn. Depth d (0..3) keeps nested
            // loops from clobbering each other's temps.
            var d: i32 = st.fd;
            var fi: string = "$__fi" + util.i32_to_string(d);
            var fa: string = "$__fa" + util.i32_to_string(d);
            var id: i32 = st.n;
            var brk: string = "$fbrk_" + util.i32_to_string(id);
            var lp: string = "$floop_" + util.i32_to_string(id);
            // `continue` must still run the index increment, so it
            // branches to the END of a body block (bodycont), after which
            // the increment + loop-back run. `break` branches to brk.
            var bodycont: string = "$fcont_" + util.i32_to_string(id);
            var outer_brk: string = st.brk;
            var outer_cont: string = st.cont;
            // Element kind picks the load op + slot stride (i64[]/f64[]
            // are 8-byte; the loop var is typed wide to match — see
            // collect_wide_loop_vars).
            var ekind: string = array_elem_kind(f.iter, st.cx);
            var eslot: string = util.i32_to_string(elem_slot_size(ekind));
            var head: string =
                "    (local.set " + fa + " " + emit_expr(f.iter, st.cx, 0) + ")\n"
                + "    (local.set " + fi + " (i32.const 0))\n"
                + "    (block " + brk + " (loop " + lp + "\n"
                + "    (br_if " + brk + " (i32.ge_s (local.get " + fi + ") (i32.load (local.get " + fa + "))))\n"
                + "    (local.set $" + f.var_name + " (" + elem_load_op(ekind) + " (i32.add (i32.add (local.get " + fa + ") (i32.const 8)) (i32.mul (local.get " + fi + ") (i32.const " + eslot + ")))))\n"
                + "    (block " + bodycont + "\n";
            var inner: WState = WState {
                ...st,
                out: st.out + head,
                n: id + 1,
                brk: brk,
                cont: bodycont,
                fd: d + 1,
            };
            inner = emit_stmts(f.body, inner);
            return WState {
                ...inner,
                out: inner.out + "    )\n    (local.set " + fi + " (i32.add (local.get " + fi + ") (i32.const 1)))\n    (br " + lp + ")))\n",
                brk: outer_brk,
                cont: outer_cont,
                fd: d,
            };
        },
        parser.StmtMatch(m) => {
            // Match on an Option/Result tag box: store the scrutinee once
            // in $__m<md>, then for each arm test the tag (load @0), bind
            // the payload (load @4) and run the body, branching to $mend
            // on a match. A wildcard arm runs unconditionally.
            var md: i32 = st.md;
            var mv: string = "$__m" + util.i32_to_string(md);
            var id: i32 = st.n;
            var mend: string = "$mend_" + util.i32_to_string(id);
            // Bump label counter + match depth so nested matches / loops
            // inside arm bodies use distinct labels + scrutinee temps.
            st = WState { ...st, n: id + 1, md: md + 1 };
            st = st.w("    (local.set " + mv + " " + emit_expr(m.scrutinee, st.cx, 0) + ")\n");
            st = st.w("    (block " + mend + "\n");
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        // Two dispatch schemes keyed on the variant name:
                        //   Option/Result (Some/Ok/None/Err): tag box —
                        //     compare tag@0, bind payload@4.
                        //   user struct union (type E = A | B): every
                        //     struct value carries its type id@0 — compare
                        //     id@0, bind the value itself.
                        var tag: i32 = variant_tag(pv.type_name);
                        var sid: i32 = struct_id(st.cx.structs, pv.type_name);
                        var nlabel: string = "$marm_" + util.i32_to_string(id) + "_" + util.i32_to_string(i);
                        st = st.w("    (block " + nlabel + "\n");
                        // `match (b) { true => …, false => … }`: the
                        // scrutinee is the bool value itself (not a tag box),
                        // so compare it directly. `true` skips when zero,
                        // `false` skips when non-zero.
                        if (pv.type_name == "true") {
                            st = st.w("    (br_if " + nlabel + " (i32.eqz (local.get " + mv + ")))\n");
                        } else if (pv.type_name == "false") {
                            st = st.w("    (br_if " + nlabel + " (local.get " + mv + "))\n");
                        } else if (tag >= 0) {
                            st = st.w("    (br_if " + nlabel + " (i32.ne (i32.load (local.get " + mv + ")) (i32.const " + util.i32_to_string(tag) + ")))\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                st = st.w("    (local.set $" + pv.binding + " (i32.load (i32.add (local.get " + mv + ") (i32.const 4))))\n");
                            }
                        } else if (sid >= 0) {
                            st = st.w("    (br_if " + nlabel + " (i32.ne (i32.load (local.get " + mv + ")) (i32.const " + util.i32_to_string(sid) + ")))\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                // An enum variant carries its payload in the
                                // synthetic `__ev` field at offset 4, so bind
                                // the payload; a struct-union variant
                                // (`type E = A | B`) binds the whole struct
                                // value (accessed via its named fields).
                                if (struct_field_index(st.cx.structs, pv.type_name, "__ev") >= 0) {
                                    if (pv.extra_bindings.len() == 0) {
                                        // Single payload: bind at its field width — a
                                        // wide i64/f64 `__ev` is read with i64/f64.load;
                                        // an i32 payload is the unchanged i32.load. S1.
                                        var pk: string = field_kind_of_type(struct_field_type(st.cx.structs, pv.type_name, "__ev"));
                                        st = st.w("    (local.set $" + pv.binding + " (" + elem_load_op(pk) + " (i32.add (local.get " + mv + ") (i32.const 4))))\n");
                                    } else {
                                        // Multi-payload variant `V(a, b, …)`: bind each
                                        // field (field j -> binding/extra_bindings[j-1])
                                        // at struct_field_off(j). Scoped to i32 fields
                                        // (4-byte stride); wide + multi is a later slice. S4.
                                        if (pv.binding.len() > 0 && pv.binding != "_") {
                                            st = st.w("    (local.set $" + pv.binding + " (i32.load (i32.add (local.get " + mv + ") (i32.const " + util.i32_to_string(struct_field_off(0)) + "))))\n");
                                        }
                                        var meb: i32 = 0;
                                        while (meb < pv.extra_bindings.len()) {
                                            if (pv.extra_bindings[meb].len() > 0 && pv.extra_bindings[meb] != "_") {
                                                st = st.w("    (local.set $" + pv.extra_bindings[meb] + " (i32.load (i32.add (local.get " + mv + ") (i32.const " + util.i32_to_string(struct_field_off(meb + 1)) + "))))\n");
                                            }
                                            meb = meb + 1;
                                        }
                                    }
                                } else {
                                    st = st.w("    (local.set $" + pv.binding + " (local.get " + mv + "))\n");
                                }
                            }
                        }
                        // Guard: a `when <expr>` arm runs only if the guard is
                        // true; a false guard skips to the arm-block end (next
                        // arm), same as a tag mismatch. The binding is already
                        // set, so the guard may reference it.
                        if (m.arms[i].has_guard) {
                            st = st.w("    (br_if " + nlabel + " (i32.eqz " + emit_expr(m.arms[i].guard, st.cx, 0) + "))\n");
                        }
                        st = emit_stmts(m.arms[i].body, st);
                        st = st.w("    (br " + mend + "))\n");
                    },
                    parser.PatWildcard(_) => {
                        // A guarded wildcard needs its own block to skip to when
                        // the guard is false (an unguarded wildcard always runs).
                        if (m.arms[i].has_guard) {
                            var wlabel: string = "$marm_" + util.i32_to_string(id) + "_" + util.i32_to_string(i);
                            st = st.w("    (block " + wlabel + "\n");
                            st = st.w("    (br_if " + wlabel + " (i32.eqz " + emit_expr(m.arms[i].guard, st.cx, 0) + "))\n");
                            st = emit_stmts(m.arms[i].body, st);
                            st = st.w("    (br " + mend + "))\n");
                        } else {
                            st = emit_stmts(m.arms[i].body, st);
                            st = st.w("    (br " + mend + ")\n");
                        }
                    },
                }
                i = i + 1;
            }
            st = st.w("    )\n");
            return WState { ...st, md: md };
        },
        _ => {
            // Unsupported statement in this slice — emit nothing.
            return st;
        },
    }
    return st;
}

// is_string_expr decides whether an expression has string type, so the
// `+` operator can pick concat vs add. Conservative + structural: a
// literal, a string-typed local/param, a `+` with a string operand, or
// a call to a string-returning function.
function is_string_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(id) => {
            if (contains_str(cx.locals, id.name)) { return true; }
            return is_const_ref(cx, id.name) && zero_arg_func_ret(cx, id.name) == "string";
        },
        parser.ExprBinary(b) => {
            if (b.op == "+") {
                return is_string_expr(b.left, cx) || is_string_expr(b.right, cx);
            }
            return false;
        },
        parser.ExprIndex(ix) => {
            // arr[i] is string-typed when arr is a string array.
            return is_string_array_expr(ix.array, cx);
        },
        parser.ExprSlice(sl) => {
            // Slicing a string yields a string (a string[] slice yields a
            // string[], handled by is_string_array_expr).
            return is_string_expr(sl.array, cx);
        },
        parser.ExprFieldAccess(fa) => {
            // Tuple index `t.N` is string when element N is a string.
            if (util.is_all_digits(fa.field)) {
                return tuple_elem_is_string(fa.obj, util.digits_to_i32(fa.field), cx);
            }
            // s.f is string-typed when f is a `string` field.
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return struct_field_type(cx.structs, ot, fa.field) == "string";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return contains_str(cx.funcs, id.name); },
                parser.ExprFieldAccess(fa) => {
                    // The string-returning builtin methods.
                    if (fa.field == "to_upper" || fa.field == "to_lower" || fa.field == "repeat") {
                        return is_string_expr(fa.obj, cx);
                    }
                    // join always yields a string (array receiver).
                    if (fa.field == "join") { return true; }
                    // .to_string() / .to_debug() always yield a string.
                    if (fa.field == "to_string" || fa.field == "to_debug") { return true; }
                    // get_or on a string-valued map yields a string.
                    if (fa.field == "get_or" && c.args.len() == 2 && is_str_val_map(fa.obj, cx)) { return true; }
                    // A receiver method declared to return string.
                    return method_ret(cx, struct_type_of(fa.obj, cx), fa.field) == "string";
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_string_array_expr decides whether an expression is a `string[]`: a
// string-typed local/param, an array literal whose elements are strings,
// or a call to a string[]-returning function.
function is_string_array_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.str_arrays, id.name); },
        parser.ExprArray(a) => {
            return a.elements.len() > 0 && is_string_expr(a.elements[0], cx);
        },
        parser.ExprSlice(sl) => {
            // A slice of a string[] is a string[].
            return is_string_array_expr(sl.array, cx);
        },
        parser.ExprFieldAccess(fa) => {
            // s.f is a string[] when f is a `string[]` field.
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return is_str_array_type(struct_field_type(cx.structs, ot, fa.field));
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // args() returns string[].
                    if (id.name == "args") { return true; }
                    return contains_str(cx.str_arr_funcs, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    // s.split(sep) yields a string[].
                    if (fa.field == "split") { return is_string_expr(fa.obj, cx); }
                    // m.keys() on a string-keyed map / m.values() on a
                    // string-valued map yields a string[].
                    if (fa.field == "keys" && is_str_key_map(fa.obj, cx)) { return true; }
                    if (fa.field == "values" && is_str_val_map(fa.obj, cx)) { return true; }
                    // A receiver method declared to return string[].
                    return is_str_array_type(method_ret(cx, struct_type_of(fa.obj, cx), fa.field));
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_str_array_type is true for the `string[]` annotation (and its
// prefix `[string]`, which the parser normalises to `string[]`).
function is_str_array_type(t: string): boolean {
    return t == "string[]";
}

// collect_str_funcs returns the names of free functions declared to
// return `string` — call results of these are string-typed.
function collect_str_funcs(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].ret_type == "string") {
            out = out.append(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_str_arr_funcs returns the names of free functions declared to
// return `string[]`.
function collect_str_arr_funcs(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_str_array_type(mod.funcs[i].ret_type)) {
            out = out.append(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_str_locals walks a function's params + body (in order,
// recursing if/while) collecting the names of string-typed locals: a
// `string` param, or a `var`/`let` whose annotation is `string` or whose
// initialiser is a string expression. Built incrementally so a later
// decl can depend on an earlier string local.
function collect_str_locals_stmts(body: parser.Stmt[], cx: Ctx): Ctx {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) >= 0) {
                    // `var (a, b, …) = <tuple>` destructure: type each element
                    // that is a struct so `a.field` resolves (without this
                    // the field read falls back to a bogus `(i32.const 0)`).
                    var dnames: string[] = split_commas(v.name);
                    var di: i32 = 0;
                    while (di < dnames.len()) {
                        var dt: string = tuple_elem_struct_type(v.init, di, cx);
                        if (is_struct_type(cx.structs, dt)) {
                            cx = Ctx { ...cx, sv_names: cx.sv_names.append(dnames[di]), sv_types: cx.sv_types.append(dt) };
                        }
                        di = di + 1;
                    }
                } else {
                    // Record a tuple local's per-element kinds + struct types
                    // here (in statement order) so a later destructure of it
                    // can recover element types; collect_tuple_locals' guard
                    // then skips the already-recorded name.
                    match (v.init) {
                        parser.ExprTuple(t) => {
                            if (!contains_str(cx.tup_names, v.name)) {
                                cx = Ctx { ...cx, tup_names: cx.tup_names.append(v.name), tup_kinds: cx.tup_kinds.append(tuple_kind_string(t.elements, cx)), tup_svtypes: cx.tup_svtypes.append(tuple_svtypes_csv(t.elements, cx)) };
                            }
                        },
                        _ => {},
                    }
                    // 64-bit-element array local: `var xs: i64[] = …`, or a
                    // var bound to a wide-array expression (an i64[]/f64[]
                    // call, or a slice of a wide array). Tracked so index /
                    // for / push / slice use the 8-byte stride + i64/f64 op.
                    var akind: string = arr_kind_of_spelling(v.type_name);
                    if (akind == "i32") { akind = array_elem_kind(v.init, cx); }
                    if (akind == "i64" && !contains_str(cx.i64_arr_names, v.name)) {
                        cx = Ctx { ...cx, i64_arr_names: cx.i64_arr_names.append(v.name) };
                    } else if (akind == "f64" && !contains_str(cx.f64_arr_names, v.name)) {
                        cx = Ctx { ...cx, f64_arr_names: cx.f64_arr_names.append(v.name) };
                    }
                    // Option/Result-typed var → track its payload type so a
                    // later `match (v)` types the Some/Ok binding.
                    var optpay: string = parse_option_payload(v.type_name);
                    if (optpay.len() == 0) { optpay = scrutinee_payload(v.init, cx); }
                    var styp: string = util.base_type_name(v.type_name);
                    // Keep an enum-typed declaration as the enum name (so its
                    // methods dispatch); only fall back to the initializer's
                    // type when the declared type is neither struct nor enum.
                    if (!is_struct_type(cx.structs, styp) && !is_enum_type_name(cx, styp)) { styp = struct_type_of(v.init, cx); }
                    if (optpay.len() > 0) {
                        cx = Ctx { ...cx, ol_names: cx.ol_names.append(v.name), ol_payloads: cx.ol_payloads.append(optpay), ol_err_payloads: cx.ol_err_payloads.append(parse_result_err_payload(v.type_name)) };
                    } else if (is_struct_type(cx.structs, styp) || is_enum_type_name(cx, styp)) {
                        cx = Ctx { ...cx, sv_names: cx.sv_names.append(v.name), sv_types: cx.sv_types.append(styp) };
                    } else if (is_str_array_type(v.type_name) || is_string_array_expr(v.init, cx)) {
                        cx = Ctx { ...cx, str_arrays: cx.str_arrays.append(v.name) };
                    } else if (v.type_name == "string" || is_string_expr(v.init, cx)) {
                        cx = Ctx { ...cx, locals: cx.locals.append(v.name) };
                    }
                }
            },
            parser.StmtIf(f) => {
                cx = collect_str_locals_stmts(f.then_body, cx);
                cx = collect_str_locals_stmts(f.else_body, cx);
            },
            parser.StmtWhile(w) => {
                cx = collect_str_locals_stmts(w.body, cx);
            },
            parser.StmtFor(f) => {
                if (comma_index(f.var_name) >= 0) {
                    // `for (k, v) in m` — k is a string for a string-keyed
                    // map, v for a string-valued map.
                    if (is_str_key_map(f.iter, cx)) {
                        cx = Ctx { ...cx, locals: cx.locals.append(before_comma(f.var_name)) };
                    }
                    if (is_str_val_map(f.iter, cx)) {
                        cx = Ctx { ...cx, locals: cx.locals.append(after_comma(f.var_name)) };
                    }
                } else if (is_string_array_expr(f.iter, cx)) {
                    // A `for s in <string[]>` binds s as a string.
                    cx = Ctx { ...cx, locals: cx.locals.append(f.var_name) };
                } else {
                    // A `for p in <Struct[]>` binds p as that struct.
                    var set: string = struct_array_elem_type(f.iter, cx);
                    if (set.len() > 0) {
                        cx = Ctx { ...cx, sv_names: cx.sv_names.append(f.var_name), sv_types: cx.sv_types.append(set) };
                    }
                }
                cx = collect_str_locals_stmts(f.body, cx);
            },
            parser.StmtMatch(m) => {
                // Type each Some/Ok arm's binding with the scrutinee's
                // payload type (string / string[] / struct), so the arm
                // body's string/struct operations resolve.
                var pt: string = scrutinee_payload(m.scrutinee, cx);
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if ((pv.type_name == "Some" || pv.type_name == "Ok") && pv.binding.len() > 0 && pv.binding != "_") {
                                if (pt == "string") {
                                    cx = Ctx { ...cx, locals: cx.locals.append(pv.binding) };
                                } else if (is_str_array_type(pt)) {
                                    cx = Ctx { ...cx, str_arrays: cx.str_arrays.append(pv.binding) };
                                } else if (is_struct_type(cx.structs, pt)) {
                                    cx = Ctx { ...cx, sv_names: cx.sv_names.append(pv.binding), sv_types: cx.sv_types.append(pt) };
                                }
                            } else if (is_struct_type(cx.structs, pv.type_name) && pv.binding.len() > 0 && pv.binding != "_") {
                                if (struct_field_index(cx.structs, pv.type_name, "__ev") >= 0) {
                                    // Enum-variant arm `Has(b)`: b is the
                                    // PAYLOAD (the `__ev` field), so type it as
                                    // the payload type. A primitive payload
                                    // (i32) is left unrecorded — struct_type_of
                                    // then returns "" and the primitive-method
                                    // dispatch handles `b.eq(…)`; a string
                                    // payload registers as a string local; a
                                    // struct/enum payload as its nominal type.
                                    var paytype: string = struct_field_type(cx.structs, pv.type_name, "__ev");
                                    if (paytype == "string") {
                                        cx = Ctx { ...cx, locals: cx.locals.append(pv.binding) };
                                    } else if (is_struct_type(cx.structs, paytype) || is_enum_type_name(cx, paytype)) {
                                        cx = Ctx { ...cx, sv_names: cx.sv_names.append(pv.binding), sv_types: cx.sv_types.append(paytype) };
                                    }
                                } else {
                                    // Struct-union arm `Variant(b)` binds b to
                                    // the value itself, typed as that struct.
                                    cx = Ctx { ...cx, sv_names: cx.sv_names.append(pv.binding), sv_types: cx.sv_types.append(pv.type_name) };
                                }
                            }
                        },
                        _ => {},
                    }
                    cx = collect_str_locals_stmts(m.arms[k].body, cx);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return cx;
}

function build_ctx(f: parser.FuncDecl, tab: StrTable, funcs: string[], str_arr_funcs: string[], structs: parser.StructDecl[], sf_names: string[], sf_types: string[], of_names: string[], of_payloads: string[], mr_types: string[], mr_names: string[], mr_rets: string[], i64_funcs: string[], mod_funcs: parser.FuncDecl[], f64_funcs: string[], lam_ctr: Cell[i32], lamdefs: Cell[string], cap_names: string[], cap_str: string[], cap_sv_names: string[], cap_sv_types: string[], cap_sa_names: string[], cap_sa_types: string[]): Ctx {
    // Every var/param name in this function (for lambda capture analysis).
    var all_locals: string[] = collect_locals(f.body, []);
    var alp: i32 = 0;
    while (alp < f.params.len()) {
        if (!contains_str(all_locals, f.params[alp].name)) { all_locals = all_locals.append(f.params[alp].name); }
        alp = alp + 1;
    }
    // A method's receiver is also a local in scope, so a lambda in the
    // method body can capture it (`return function() { … a.field … }`).
    if (f.receiver_name.len() > 0 && !contains_str(all_locals, f.receiver_name)) {
        all_locals = all_locals.append(f.receiver_name);
    }
    // Closure-typed locals/params: `fn` params + vars bound to a lambda
    // or to a call of a function that returns a closure. `fn[]` arrays of
    // closures let `var c = fns[i]` / `for f in fns` bind a closure too.
    var fn_arrs: string[] = collect_fn_arr_names(f.body, []);
    var fpa: i32 = 0;
    while (fpa < f.params.len()) {
        if (f.params[fpa].type_name == "fn[]" && !contains_str(fn_arrs, f.params[fpa].name)) {
            fn_arrs = fn_arrs.append(f.params[fpa].name);
        }
        fpa = fpa + 1;
    }
    var fn_names: string[] = collect_fn_var_names(f.body, [], fn_returning_func_names(mod_funcs), fn_returning_method_names(mod_funcs), fn_arrs);
    var fp: i32 = 0;
    while (fp < f.params.len()) {
        if (f.params[fp].type_name == "fn" && !contains_str(fn_names, f.params[fp].name)) {
            fn_names = fn_names.append(f.params[fp].name);
        }
        fp = fp + 1;
    }
    var locals: string[] = [];
    var str_arrays: string[] = [];
    var sv_names: string[] = [];
    var sv_types: string[] = [];
    var ol_names: string[] = [];
    var ol_payloads: string[] = [];
    var ol_err_payloads: string[] = [];
    // i64- / f64-typed params, plus the i64- / f64-declared names in the body.
    var i64_names: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "i64"), "i64", collect_i64_var_names(f.body, []));
    var f64_names: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "f64"), "f64", collect_f64_var_names(f.body, []));
    // Wide enum-payload match bindings (`match v { V(x) => … }` over an i64/f64
    // payload) are 64-bit locals too. S1.
    i64_names = collect_variant_payload_names(f.body, structs, "i64", i64_names);
    f64_names = collect_variant_payload_names(f.body, structs, "f64", f64_names);
    var map_names: string[] = collect_map_var_names(f.body, []);
    var cell_names: string[] = collect_cell_var_names(f.body, []);
    var pj: i32 = 0;
    while (pj < f.params.len()) {
        if (f.params[pj].type_name == "i64" && !contains_str(i64_names, f.params[pj].name)) {
            i64_names = i64_names.append(f.params[pj].name);
        }
        if (is_float_type(f.params[pj].type_name) && !contains_str(f64_names, f.params[pj].name)) {
            f64_names = f64_names.append(f.params[pj].name);
        }
        if (util.base_type_name(f.params[pj].type_name) == "Map" && !contains_str(map_names, f.params[pj].name)) {
            map_names = map_names.append(f.params[pj].name);
        }
        if (util.base_type_name(f.params[pj].type_name) == "Cell" && !contains_str(cell_names, f.params[pj].name)) {
            cell_names = cell_names.append(f.params[pj].name);
        }
        pj = pj + 1;
    }
    // A method's receiver is a struct-typed local (a generic receiver
    // `Box[T]` / `Box[i32]` strips to its base struct name).
    if (f.receiver_type.len() > 0) {
        sv_names = sv_names.append(f.receiver_name);
        sv_types = sv_types.append(util.base_type_name(f.receiver_type));
    }
    var i: i32 = 0;
    while (i < f.params.len()) {
        var pop: string = parse_option_payload(f.params[i].type_name);
        if (pop.len() > 0) {
            ol_names = ol_names.append(f.params[i].name);
            ol_payloads = ol_payloads.append(pop);
            ol_err_payloads = ol_err_payloads.append(parse_result_err_payload(f.params[i].type_name));
        } else if (is_str_array_type(f.params[i].type_name)) {
            str_arrays = str_arrays.append(f.params[i].name);
        } else if (is_struct_type(structs, util.base_type_name(f.params[i].type_name))) {
            // Generic instantiation `Box[i32]` / param `Box[T]` strips to
            // the base struct name `Box`.
            sv_names = sv_names.append(f.params[i].name);
            sv_types = sv_types.append(util.base_type_name(f.params[i].type_name));
        } else if (f.params[i].type_name == "string") {
            locals = locals.append(f.params[i].name);
        }
        i = i + 1;
    }
    // String captures type as string locals inside the lambda body.
    var csi: i32 = 0;
    while (csi < cap_str.len()) {
        if (!contains_str(locals, cap_str[csi])) { locals = locals.append(cap_str[csi]); }
        csi = csi + 1;
    }
    // Struct captures keep their struct type inside the lambda body, so
    // `cap.field` resolves the field offset (otherwise field reads emit a
    // bogus `(i32.const 0)`). The capture pointer itself is loaded from
    // the env box by the ExprIdent capture path.
    var cvi: i32 = 0;
    while (cvi < cap_sv_names.len()) {
        if (!contains_str(sv_names, cap_sv_names[cvi])) {
            sv_names = sv_names.append(cap_sv_names[cvi]);
            sv_types = sv_types.append(cap_sv_types[cvi]);
        }
        cvi = cvi + 1;
    }
    // 64-bit-element array params (i64[] / f64[]): seed the wide-array
    // name sets so index / for / push / slice use the 8-byte stride.
    var i64_arrs: string[] = [];
    var f64_arrs: string[] = [];
    var pa: i32 = 0;
    while (pa < f.params.len()) {
        if (f.params[pa].type_name == "i64[]") { i64_arrs = i64_arrs.append(f.params[pa].name); }
        if (f.params[pa].type_name == "f64[]" || f.params[pa].type_name == "f32[]") { f64_arrs = f64_arrs.append(f.params[pa].name); }
        pa = pa + 1;
    }
    var cx: Ctx = Ctx {
        tab: tab, locals: locals, funcs: funcs, str_arrays: str_arrays, str_arr_funcs: str_arr_funcs,
        structs: structs, sv_names: sv_names, sv_types: sv_types, sf_names: sf_names, sf_types: sf_types,
        of_names: of_names, of_payloads: of_payloads, ol_names: ol_names, ol_payloads: ol_payloads, ol_err_payloads: ol_err_payloads,
        mr_types: mr_types, mr_names: mr_names, mr_rets: mr_rets,
        i64_names: i64_names, i64_funcs: i64_funcs,
        ret_i64: f.ret_type == "i64", mod_funcs: mod_funcs,
        f64_names: f64_names, f64_funcs: f64_funcs,
        ret_f64: is_float_type(f.ret_type),
        map_names: map_names, cell_names: cell_names, map_str_names: [],
        map_str_key_names: collect_str_key_map_names(f.body, map_names, []),
        mvs_names: [], mvs_types: [],
        tup_names: [], tup_kinds: [], tup_svtypes: [],
        fn_names: fn_names, lam_ctr: lam_ctr, lamdefs: lamdefs,
        all_locals: all_locals, cap_names: cap_names,
        sa_names: [], sa_types: [], ta_names: [], ta_kinds: [], ta_svtypes: [],
        i64_arr_names: i64_arrs, f64_arr_names: f64_arrs,
        ret_arr_kind: arr_kind_of_spelling(f.ret_type),
        arr_swept: [], arr_src: [],
        ret_void: !returns_value(f.ret_type),
        ret_is_array: ty_spelling_is_array(f.ret_type),
        str_swept: [],
        ret_is_string: f.ret_type == "string",
        tup_swept: [],
        ret_is_tuple: f.ret_type.len() > 0 && f.ret_type[0] == 40,
        struct_swept: [],
        opt_swept: [],
        map_swept: [],
        clos_swept: [],
        clos_caps: [],
    };
    // Struct-array locals (computed from the base cx so struct_type_of of
    // the array elements resolves) — needed before the string-locals pass
    // so a `for p in pts` over a struct array types p as a struct.
    cx = Ctx { ...cx, sa_names: collect_struct_array_names(f.body, cx, []), sa_types: collect_struct_array_types(f.body, cx, []) };
    // Struct-array params (e.g. `ts: Tk[]`) are struct-array locals too, so
    // `ts[i].field` / `for x in ts` resolve the element struct type.
    var san: string[] = cx.sa_names;
    var sat: string[] = cx.sa_types;
    var sap: i32 = 0;
    while (sap < f.params.len()) {
        var pt: string = f.params[sap].type_name;
        if (pt.len() > 2 && pt[pt.len() - 2:pt.len()] == "[]") {
            var pe: str = pt[0:pt.len() - 2];
            if (is_struct_type(structs, pe) && !contains_str(san, f.params[sap].name)) {
                san = san.append(f.params[sap].name);
                sat = sat.append(pe);
            }
        }
        sap = sap + 1;
    }
    // Struct-array captures keep their element struct type inside the lambda
    // body, so `cap[i].field` resolves (otherwise the element field read emits a
    // bogus `(i32.const 0)`). Mirrors the cap_sv struct-capture seeding above.
    var casi: i32 = 0;
    while (casi < cap_sa_names.len()) {
        if (!contains_str(san, cap_sa_names[casi])) {
            san = san.append(cap_sa_names[casi]);
            sat = sat.append(cap_sa_types[casi]);
        }
        casi = casi + 1;
    }
    cx = Ctx { ...cx, sa_names: san, sa_types: sat };
    // Perceus array RC sets (counting milestone, free OFF). arr_src seeds
    // with the array-typed params/receiver (valid alias sources, but NOT
    // swept — params are borrowed) then adds the body's array vars;
    // arr_swept is the owned/alias body subset released at exit.
    var asrc: string[] = [];
    if (f.receiver_type.len() > 0 && ty_spelling_is_array(f.receiver_type)) { asrc = asrc.append(f.receiver_name); }
    var api: i32 = 0;
    while (api < f.params.len()) {
        if (ty_spelling_is_array(f.params[api].type_name) && !contains_str(asrc, f.params[api].name)) {
            asrc = asrc.append(f.params[api].name);
        }
        api = api + 1;
    }
    var arr_ret_fns: string[] = collect_arr_ret_fns(mod_funcs);
    var arr_ret_methods: string[] = collect_arr_ret_methods(mod_funcs);
    asrc = collect_arr_src(f.body, arr_ret_fns, asrc);
    var aswept: string[] = collect_arr_swept(f.body, asrc, arr_ret_fns, arr_ret_methods, []);
    cx = Ctx { ...cx, arr_src: asrc, arr_swept: aswept };
    // String-valued maps are needed during collect_str_locals_stmts (so a
    // `for v in m.values()` binds v as string). Seed them from
    // string-literal set values first (is_string_expr is accurate for
    // those even with no locals known), then run the string-locals pass,
    // then refine once more to catch string-local set values.
    var cx0: Ctx = Ctx { ...cx, map_str_names: collect_str_val_map_names(f.body, cx, map_names, []) };
    // Struct/enum-valued maps: tracked BEFORE the string-locals pass so a
    // `var p = m.get_or(…)` binding types as that struct (field access then
    // resolves instead of reading 0) and the map's deep release routes
    // correctly. Inferred from struct-literal insert values (struct-local
    // values need sv_names, not known yet — a sound miss).
    var mvn0: string[] = collect_struct_val_map_names(f.body, cx0, map_names, []);
    var cx0s: Ctx = Ctx { ...cx0, mvs_names: mvn0, mvs_types: collect_struct_val_map_types(f.body, mvn0, cx0) };
    var cx2: Ctx = collect_str_locals_stmts(f.body, cx0s);
    var cx3: Ctx = Ctx { ...cx2, map_str_names: collect_str_val_map_names(f.body, cx2, map_names, []) };
    // Tuple-local element kinds (after string locals are known).
    var cx4: Ctx = collect_tuple_locals(f.body, cx3);
    // Perceus string + tuple RC sets (counting milestone, free OFF) —
    // computed last, once all string/tuple locals are known so alias
    // sources resolve.
    var cx5: Ctx = Ctx { ...cx4, str_swept: collect_str_swept(f.body, cx4, []) };
    var cx6: Ctx = Ctx { ...cx5, tup_swept: collect_tup_swept(f.body, cx5, []) };
    // Perceus struct/enum RC set (counting milestone, free OFF) — computed
    // last, once all struct-valued locals are known so alias sources resolve.
    var cx7: Ctx = Ctx { ...cx6, struct_swept: collect_struct_swept(f.body, cx6, []) };
    // Perceus Option/Result RC set — computed once ol_names are known so option
    // aliases resolve.
    var cx8: Ctx = Ctx { ...cx7, opt_swept: collect_opt_swept(f.body, cx7, []) };
    // Perceus map RC set — computed once map_names are known so map aliases
    // resolve.
    var cx9: Ctx = Ctx { ...cx8, map_swept: collect_map_swept(f.body, cx8, []) };
    // Perceus closure RC set — lambda-literal-bound closure locals freed at
    // exit, with a parallel per-capture release snippet (computed from the full
    // cx so capture types resolve). clos_caps must be set together with
    // clos_swept so the two arrays stay index-parallel.
    var cnames: string[] = collect_clos_swept(f.body, []);
    return Ctx { ...cx9, clos_swept: cnames, clos_caps: collect_clos_caps(f.body, cnames, cx9) };
}

// collect_opt_func_names / _payloads: free functions returning
// Option[T] / Result[T, E], with their Some/Ok payload type T.
function collect_opt_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && parse_option_payload(mod.funcs[i].ret_type).len() > 0) {
            out = out.append(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_method_* build the receiver-method registry (parallel arrays:
// receiver type, method name, return type).
function collect_method_types(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.append(util.base_type_name(mod.funcs[i].receiver_type)); }
        i = i + 1;
    }
    return out;
}

function collect_method_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.append(mod.funcs[i].name); }
        i = i + 1;
    }
    return out;
}

function collect_method_rets(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.append(mod.funcs[i].ret_type); }
        i = i + 1;
    }
    return out;
}

function collect_opt_func_payloads(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0) {
            var p: string = parse_option_payload(mod.funcs[i].ret_type);
            if (p.len() > 0) { out = out.append(p); }
        }
        i = i + 1;
    }
    return out;
}

// collect_struct_funcs returns parallel arrays (names→struct return type)
// for free functions that return a declared struct.
function collect_struct_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_struct_type(mod.structs, mod.funcs[i].ret_type)) {
            out = out.append(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

function collect_struct_func_types(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_struct_type(mod.structs, mod.funcs[i].ret_type)) {
            out = out.append(mod.funcs[i].ret_type);
        }
        i = i + 1;
    }
    return out;
}

// returns_value is true when a function's declared return type carries
// an i32-shaped value (i32 / boolean / …). The void / unannotated case
// emits no `(result …)` and no fallthrough constant.
function returns_value(ret_type: string): boolean {
    if (ret_type.len() == 0) { return false; }
    if (ret_type == "void") { return false; }
    return true;
}

// emit_lambda emits a lambda body as a top-level wasm function
// `$__lambda<idx>` with a leading `$__env` param (the closure box ptr,
// ignored by a non-capturing lambda) followed by the lambda's params.
// It reuses emit_func via a synthesised FuncDecl, threading the shared
// lambda cells so nested lambdas keep counting.
function emit_lambda(lm: parser.ExprLambda, idx: i32, cx: Ctx, caps: string[]): string {
    var ps: parser.ParamDecl[] = [];
    ps = ps.append(parser.ParamDecl { name: "__env", type_name: "i32", own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" });
    var i: i32 = 0;
    while (i < lm.params.len()) {
        ps = ps.append(lm.params[i]);
        i = i + 1;
    }
    var rt: string = lm.ret_type;
    if (rt.len() == 0) { rt = "i32"; }
    var synth_tp: string[] = [];
    var synth: parser.FuncDecl = parser.FuncDecl {
        name: "__lambda" + util.i32_to_string(idx),
        receiver_name: "", receiver_type: "",
        type_params: synth_tp,
        params: ps, ret_type: rt, body: lm.body, line: 0, col: 0,
        import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false
    };
    // Captures that were strings in the enclosing scope stay string-typed;
    // struct captures keep their struct type so `cap.field` resolves.
    var cap_str: string[] = [];
    var cap_sv_names: string[] = [];
    var cap_sv_types: string[] = [];
    var cap_sa_names: string[] = [];
    var cap_sa_types: string[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) {
        if (contains_str(cx.locals, caps[ci])) { cap_str = cap_str.append(caps[ci]); }
        var cst: string = struct_type_of(parser.ExprIdent { name: caps[ci], line: 0, col: 0 }, cx);
        if (cst.len() > 0) {
            cap_sv_names = cap_sv_names.append(caps[ci]);
            cap_sv_types = cap_sv_types.append(cst);
        }
        // A struct-array capture keeps its element type so `cap[i].field`
        // resolves inside the lambda body.
        var sae: string = lookup_pair(cx.sa_names, cx.sa_types, caps[ci]);
        if (sae.len() > 0) {
            cap_sa_names = cap_sa_names.append(caps[ci]);
            cap_sa_types = cap_sa_types.append(sae);
        }
        ci = ci + 1;
    }
    return emit_func(synth, cx.tab, cx.funcs, cx.str_arr_funcs, cx.structs, cx.sf_names, cx.sf_types, cx.of_names, cx.of_payloads, cx.mr_types, cx.mr_names, cx.mr_rets, cx.i64_funcs, cx.mod_funcs, cx.f64_funcs, cx.lam_ctr, cx.lamdefs, caps, cap_str, cap_sv_names, cap_sv_types, cap_sa_names, cap_sa_types);
}

// emit_func emits one wasm function. Params become wasm params (locals
// 0..n-1, referenced by `$name`); declared `var`/`let` names that aren't
// params become `(local …)` decls. An i32-returning function gets a
// trailing `(i32.const 0)` as the fallthrough result when no `return`
// fires.
function emit_func(f: parser.FuncDecl, tab: StrTable, str_funcs: string[], str_arr_funcs: string[], structs: parser.StructDecl[], sf_names: string[], sf_types: string[], of_names: string[], of_payloads: string[], mr_types: string[], mr_names: string[], mr_rets: string[], i64_funcs: string[], mod_funcs: parser.FuncDecl[], f64_funcs: string[], lam_ctr: Cell[i32], lamdefs: Cell[string], cap_names: string[], cap_str: string[], cap_sv_names: string[], cap_sv_types: string[], cap_sa_names: string[], cap_sa_types: string[]): string {
    // A receiver method `function (r: T) m(...)` emits as `$T__m` with the
    // receiver prepended as the first param; a free function as `$name`.
    var fname: string = f.name;
    var pnames: string[] = [];
    var head: string = "  (func $";
    if (f.receiver_type.len() > 0) {
        fname = util.base_type_name(f.receiver_type) + "__" + f.name;
        head = head + fname + " (param $" + f.receiver_name + " i32)";
        pnames = pnames.append(f.receiver_name);
    } else {
        head = head + fname;
    }
    // The i64- / f64-typed local/param sets drive both the (param/local …)
    // decls here and the typed instruction paths in Ctx.
    var i64_set: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "i64"), "i64", collect_i64_var_names(f.body, []));
    var f64_set: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "f64"), "f64", collect_f64_var_names(f.body, []));
    // Wide enum-payload match bindings get an i64/f64 local declaration. S1.
    i64_set = collect_variant_payload_names(f.body, structs, "i64", i64_set);
    f64_set = collect_variant_payload_names(f.body, structs, "f64", f64_set);
    var i: i32 = 0;
    while (i < f.params.len()) {
        if (f.params[i].type_name == "i64") {
            head = head + " (param $" + f.params[i].name + " i64)";
            if (!contains_str(i64_set, f.params[i].name)) { i64_set = i64_set.append(f.params[i].name); }
        } else if (is_float_type(f.params[i].type_name)) {
            head = head + " (param $" + f.params[i].name + " f64)";
            if (!contains_str(f64_set, f.params[i].name)) { f64_set = f64_set.append(f.params[i].name); }
        } else {
            head = head + " (param $" + f.params[i].name + " i32)";
        }
        pnames = pnames.append(f.params[i].name);
        i = i + 1;
    }
    var has_result: boolean = returns_value(f.ret_type);
    var i64_result: boolean = f.ret_type == "i64";
    var f64_result: boolean = is_float_type(f.ret_type);
    if (has_result) {
        if (i64_result) { head = head + " (result i64)"; }
        else if (f64_result) { head = head + " (result f64)"; }
        else { head = head + " (result i32)"; }
    }
    head = head + "\n";

    var locals: string[] = collect_locals(f.body, []);
    // Reserved temps (one extra i32 local each, harmless): $__lit<d>
    // holds a fresh array/struct-literal pointer at literal-nesting depth
    // d (0..7); $__fi<d> / $__fa<d> are the loop index and iterated-array
    // pointer for a `for` at nesting depth d (0..3).
    var decls: string = "    (local $__lit0 i32) (local $__lit1 i32) (local $__lit2 i32) (local $__lit3 i32)\n";
    decls = decls + "    (local $__lit4 i32) (local $__lit5 i32) (local $__lit6 i32) (local $__lit7 i32)\n";
    decls = decls + "    (local $__fi0 i32) (local $__fi1 i32) (local $__fi2 i32) (local $__fi3 i32)\n";
    decls = decls + "    (local $__m0 i32) (local $__m1 i32) (local $__m2 i32) (local $__m3 i32)\n";
    decls = decls + "    (local $__fa0 i32) (local $__fa1 i32) (local $__fa2 i32) (local $__fa3 i32)\n";
    // Perceus return temps: park the result across the exit release sweep.
    decls = decls + "    (local $__retv_i32 i32) (local $__retv_i64 i64) (local $__retv_f64 f64)\n";
    // Array-of-tuple deep-release scratch: loop index / length / element box.
    decls = decls + "    (local $__tai i32) (local $__tan i32) (local $__te i32)\n";
    var li: i32 = 0;
    while (li < locals.len()) {
        if (!contains_str(pnames, locals[li]) && !is_reserved_local(locals[li])) {
            if (contains_str(i64_set, locals[li])) {
                decls = decls + "    (local $" + locals[li] + " i64)\n";
            } else if (contains_str(f64_set, locals[li])) {
                decls = decls + "    (local $" + locals[li] + " f64)\n";
            } else {
                decls = decls + "    (local $" + locals[li] + " i32)\n";
            }
        }
        li = li + 1;
    }

    var cx: Ctx = build_ctx(f, tab, str_funcs, str_arr_funcs, structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets, i64_funcs, mod_funcs, f64_funcs, lam_ctr, lamdefs, cap_names, cap_str, cap_sv_names, cap_sv_types, cap_sa_names, cap_sa_types);
    var st: WState = WState { out: "", n: 0, brk: "", cont: "", cx: cx, fd: 0, md: 0 };
    st = emit_stmts(f.body, st);

    var tail: string = "  )\n";
    if (has_result) {
        if (i64_result) { tail = "    (i64.const 0))\n"; }
        else if (f64_result) { tail = "    (f64.const 0))\n"; }
        else { tail = "    (i32.const 0))\n"; }
    }
    // Perceus exit sweep on the fall-through path (functions that end
    // without an explicit `return`). After a final `return` it is
    // unreachable-but-valid wasm, like the trailing fallthrough const.
    return head + decls + st.out + arr_exit_sweep(cx) + str_exit_sweep(cx) + tup_exit_sweep(cx) + struct_exit_sweep(cx) + opt_exit_sweep(cx) + map_exit_sweep(cx) + clos_exit_sweep(cx) + tail;
}

// module_uses_divrem is true when any free function body or the
// top-level statements contain a `/` or `%`.
function module_uses_divrem(mod: parser.Module): boolean {
    if (stmts_use_divrem(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_use_divrem(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// module_uses_struct_val_map gates the per-type $__fern_map_release_via_<T>
// emission: true if any `.insert(k, v)` anywhere has a value `v` that could be
// struct/enum-typed (a struct literal / call / ident / field / index read — the
// shapes struct_type_of can resolve), so a struct-valued map's exit sweep
// always finds its routed via_<T>. Conservative (over-emits dead helpers for a
// scalar-valued map whose value happens to be a call/ident) but never under-
// emits. Pure-scalar value forms (int / string / binary / bool) never match.
function expr_insert_val_possibly_struct(v: parser.Expr): boolean {
    match (v) {
        parser.ExprStructLit(_) => { return true; },
        parser.ExprCall(_) => { return true; },
        parser.ExprIdent(_) => { return true; },
        parser.ExprFieldAccess(_) => { return true; },
        parser.ExprIndex(_) => { return true; },
        _ => { return false; },
    }
    return false;
}

function expr_has_struct_val_insert(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "insert" && c.args.len() == 2 && expr_insert_val_possibly_struct(c.args[1])) { return true; }
                    if (expr_has_struct_val_insert(fa.obj)) { return true; }
                },
                parser.ExprIdent(_) => {},
                _ => {},
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                if (expr_has_struct_val_insert(c.args[ai])) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        parser.ExprBinary(b) => { return expr_has_struct_val_insert(b.left) || expr_has_struct_val_insert(b.right); },
        parser.ExprFieldAccess(fa) => { return expr_has_struct_val_insert(fa.obj); },
        parser.ExprIndex(ix) => { return expr_has_struct_val_insert(ix.array) || expr_has_struct_val_insert(ix.index); },
        _ => { return false; },
    }
    return false;
}

function stmts_have_struct_val_insert(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_struct_val_insert(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_struct_val_insert(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_struct_val_insert(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_struct_val_insert(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (stmts_have_struct_val_insert(f.then_body)) { return true; }
                if (stmts_have_struct_val_insert(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => { if (stmts_have_struct_val_insert(w.body)) { return true; } },
            parser.StmtFor(f) => { if (stmts_have_struct_val_insert(f.body)) { return true; } },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { if (stmts_have_struct_val_insert(m.arms[k].body)) { return true; } k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_struct_val_map(mod: parser.Module): boolean {
    if (stmts_have_struct_val_insert(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_struct_val_insert(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_array / stmts_have_array / module_uses_arrays detect array
// literals anywhere, so the bump allocator is emitted for array-only
// programs (no strings).
function expr_has_array(e: parser.Expr): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprUnary(u) => { return expr_has_array(u.operand); },
        parser.ExprBinary(b) => { return expr_has_array(b.left) || expr_has_array(b.right); },
        parser.ExprIndex(ix) => { return expr_has_array(ix.array) || expr_has_array(ix.index); },
        parser.ExprSlice(_) => { return true; },
        parser.ExprTuple(_) => { return true; },
        parser.ExprLambda(_) => { return true; },
        parser.ExprFieldAccess(fa) => { return expr_has_array(fa.obj); },
        parser.ExprCall(c) => {
            if (expr_has_array(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_array(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function stmts_have_array(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_array(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_array(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_array(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_array(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_array(f.cond)) { return true; }
                if (stmts_have_array(f.then_body)) { return true; }
                if (stmts_have_array(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_array(w.cond)) { return true; }
                if (stmts_have_array(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_array(f.iter)) { return true; }
                if (stmts_have_array(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_array(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_array(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_arrays(mod: parser.Module): boolean {
    if (stmts_have_array(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_array(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_struct / stmts_have_struct / module_uses_structs detect struct
// literals (which allocate), so the bump allocator is emitted for
// struct-using programs even without strings or arrays.
function expr_has_struct(e: parser.Expr): boolean {
    match (e) {
        parser.ExprStructLit(_) => { return true; },
        parser.ExprUnary(u) => { return expr_has_struct(u.operand); },
        parser.ExprBinary(b) => { return expr_has_struct(b.left) || expr_has_struct(b.right); },
        parser.ExprIndex(ix) => { return expr_has_struct(ix.array) || expr_has_struct(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_struct(fa.obj); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_has_struct(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            if (expr_has_struct(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_struct(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_have_struct(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_have_struct(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_struct(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_struct(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_struct(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_struct(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_struct(f.cond)) { return true; }
                if (stmts_have_struct(f.then_body)) { return true; }
                if (stmts_have_struct(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_struct(w.cond)) { return true; }
                if (stmts_have_struct(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_struct(f.iter)) { return true; }
                if (stmts_have_struct(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_struct(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_struct(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_structs(mod: parser.Module): boolean {
    if (stmts_have_struct(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_struct(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_option / module_uses_options detect Option/Result constructors
// (Some/Ok/Err calls, the None ident), which allocate a tag box — so the
// bump allocator is emitted for option/result-using programs.
function expr_has_option(e: parser.Expr): boolean {
    match (e) {
        parser.ExprIdent(id) => { return id.name == "None"; },
        parser.ExprUnary(u) => { return expr_has_option(u.operand); },
        parser.ExprBinary(b) => { return expr_has_option(b.left) || expr_has_option(b.right); },
        parser.ExprIndex(ix) => { return expr_has_option(ix.array) || expr_has_option(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_option(fa.obj); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_has_option(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (expr_has_option(sl.field_values[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (variant_tag(id.name) >= 0) { return true; }
                },
                _ => {},
            }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_option(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_have_option(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_have_option(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_option(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_option(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_option(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_option(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_option(f.cond)) { return true; }
                if (stmts_have_option(f.then_body)) { return true; }
                if (stmts_have_option(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_option(w.cond)) { return true; }
                if (stmts_have_option(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_option(f.iter)) { return true; }
                if (stmts_have_option(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_option(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_option(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_options(mod: parser.Module): boolean {
    if (stmts_have_option(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_option(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_calls / stmts_call / module_calls: does any expression call the
// free builtin named `fn` (by bare ident)? Used to gate runtime helpers
// like env().
function expr_calls(e: parser.Expr, fn: string): boolean {
    match (e) {
        parser.ExprUnary(u) => { return expr_calls(u.operand, fn); },
        parser.ExprBinary(b) => { return expr_calls(b.left, fn) || expr_calls(b.right, fn); },
        parser.ExprIndex(ix) => { return expr_calls(ix.array, fn) || expr_calls(ix.index, fn); },
        parser.ExprSlice(sl) => { return expr_calls(sl.array, fn) || expr_calls(sl.start, fn) || expr_calls(sl.end, fn); },
        parser.ExprTuple(tu) => {
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                if (expr_calls(tu.elements[ti], fn)) { return true; }
                ti = ti + 1;
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => { return expr_calls(fa.obj, fn); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_calls(a.elements[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (expr_calls(sl.field_values[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { if (id.name == fn) { return true; } },
                _ => {},
            }
            // Recurse the callee too — `args().len()` hides the args()
            // call inside the .len() field-access receiver.
            if (expr_calls(c.callee, fn)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_calls(c.args[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_call(lm.body, fn); },
        _ => { return false; },
    }
    return false;
}

function stmts_call(body: parser.Stmt[], fn: string): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_calls(v.init, fn)) { return true; } },
            parser.StmtAssign(a) => { if (expr_calls(a.value, fn)) { return true; } },
            parser.StmtReturn(r) => { if (expr_calls(r.value, fn)) { return true; } },
            parser.StmtExpr(e) => { if (expr_calls(e.value, fn)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_calls(f.cond, fn)) { return true; }
                if (stmts_call(f.then_body, fn)) { return true; }
                if (stmts_call(f.else_body, fn)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_calls(w.cond, fn)) { return true; }
                if (stmts_call(w.body, fn)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_calls(f.iter, fn)) { return true; }
                if (stmts_call(f.body, fn)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_calls(m.scrutinee, fn)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_call(m.arms[k].body, fn)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_calls(mod: parser.Module, fn: string): boolean {
    if (stmts_call(mod.top_stmts, fn)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_call(mod.funcs[i].body, fn)) { return true; }
        i = i + 1;
    }
    return false;
}

// collect_i64_var_names gathers the names of `var`/`let` bindings
// declared `i64` anywhere in a statement list (recursing nested bodies),
// so emit_func can declare them as i64 wasm locals and Ctx can route
// their uses through the i64 path.
// collect_wide_loop_vars finds the binding names of `for v in xs` loops
// whose iterated array has 64-bit elements, so the loop var is declared /
// typed as i64 / f64 (else the 8-byte element load would `local.set` an
// i64/f64 value into an i32 local). `kind` is "i64" or "f64"; `arrs` seeds
// the known wide-array names (params), and same-`kind` `var x: T[]` decls
// extend it in statement order as the walk descends.
function collect_wide_loop_vars(body: parser.Stmt[], arrs: string[], kind: string, acc: string[]): string[] {
    var declty: string = "i64[]";
    if (kind == "f64") { declty = "f64[]"; }
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if ((v.type_name == declty || (kind == "f64" && v.type_name == "f32[]")) && !contains_str(arrs, v.name)) {
                    arrs = arrs.append(v.name);
                }
            },
            parser.StmtFor(f) => {
                if (comma_index(f.var_name) < 0) {
                    match (f.iter) {
                        parser.ExprIdent(id) => {
                            if (contains_str(arrs, id.name) && !contains_str(acc, f.var_name)) { acc = acc.append(f.var_name); }
                        },
                        _ => {},
                    }
                }
                acc = collect_wide_loop_vars(f.body, arrs, kind, acc);
            },
            parser.StmtIf(f) => {
                acc = collect_wide_loop_vars(f.then_body, arrs, kind, acc);
                acc = collect_wide_loop_vars(f.else_body, arrs, kind, acc);
            },
            parser.StmtWhile(w) => { acc = collect_wide_loop_vars(w.body, arrs, kind, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_wide_loop_vars(m.arms[k].body, arrs, kind, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// wide_array_param_names returns the i64[] (kind "i64") or f64[]/f32[]
// (kind "f64") parameter names of a function.
function wide_array_param_names(f: parser.FuncDecl, kind: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < f.params.len()) {
        var t: string = f.params[i].type_name;
        if (kind == "i64" && t == "i64[]") { out = out.append(f.params[i].name); }
        if (kind == "f64" && (t == "f64[]" || t == "f32[]")) { out = out.append(f.params[i].name); }
        i = i + 1;
    }
    return out;
}

function collect_i64_var_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (v.type_name == "i64" && !contains_str(acc, v.name)) { acc = acc.append(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_i64_var_names(f.then_body, acc);
                acc = collect_i64_var_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_i64_var_names(w.body, acc);
            },
            parser.StmtFor(f) => {
                acc = collect_i64_var_names(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_i64_var_names(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// collect_variant_payload_names scans match arms for a user enum-variant
// binding whose payload (`__ev`) field has the given wide kind ("i64"/"f64"),
// appending each binding name — so `match v { V(x) => … }` over `enum E {
// V(i64) }` types the bound `x` as a 64-bit value (declared `(local $x i64)`
// and recognised by is_i64_expr / is_f64_expr). Option/Result variants
// (Some/Ok/None/Err) are skipped: their box payload is the fixed i32 slot
// (enum_box), not a wide user-variant slot. Mirrors collect_i64_var_names'
// recursion (into if/while/for bodies + match arms). S1 wide single payload.
function collect_variant_payload_names(body: parser.Stmt[], structs: parser.StructDecl[], kind: string, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtIf(f) => {
                acc = collect_variant_payload_names(f.then_body, structs, kind, acc);
                acc = collect_variant_payload_names(f.else_body, structs, kind, acc);
            },
            parser.StmtWhile(w) => { acc = collect_variant_payload_names(w.body, structs, kind, acc); },
            parser.StmtFor(f) => { acc = collect_variant_payload_names(f.body, structs, kind, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if (pv.binding.len() > 0 && pv.binding != "_" && variant_tag(pv.type_name) < 0) {
                                if (struct_field_index(structs, pv.type_name, "__ev") >= 0
                                    && field_kind_of_type(struct_field_type(structs, pv.type_name, "__ev")) == kind
                                    && !contains_str(acc, pv.binding)) {
                                    acc = acc.append(pv.binding);
                                }
                            }
                        },
                        _ => {},
                    }
                    acc = collect_variant_payload_names(m.arms[k].body, structs, kind, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// collect_i64_func_names returns the names of free functions whose
// declared return type is i64.
function collect_i64_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].ret_type == "i64") {
            out = out.append(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_f64_var_names / collect_f64_func_names mirror the i64 collectors
// for floating-point (f64 / f32 / float) bindings and return types.
// var_init_is_f64 detects, without a Ctx, an initialiser that evaluates to
// f64 from its structure alone: a float literal, a negation / float arith
// over such, or an `as f64` cast. Used so an un-annotated `var z = 1.5`
// declares its local as f64 (matching the f64 value the emitter stores) —
// otherwise the local defaults to i32 and the module fails to validate
// (i32 local <- f64.const). Cases needing type context (an f64-returning
// call, an f64-typed var read) still want an explicit `: f64` annotation,
// as before.
function var_init_is_f64(e: parser.Expr): boolean {
    match (e) {
        parser.ExprNumber(n) => { return n.is_float; },
        parser.ExprUnary(u) => {
            if (is_cast_op(u.op)) { return is_float_type(cast_target(u.op)); }
            if (u.op == "-") { return var_init_is_f64(u.operand); }
            return false;
        },
        parser.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return var_init_is_f64(b.left) || var_init_is_f64(b.right);
            }
            return false;
        },
        _ => { return false; },
    }
}

function collect_f64_var_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if ((is_float_type(v.type_name) || var_init_is_f64(v.init)) && !contains_str(acc, v.name)) { acc = acc.append(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_f64_var_names(f.then_body, acc);
                acc = collect_f64_var_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_f64_var_names(w.body, acc);
            },
            parser.StmtFor(f) => {
                acc = collect_f64_var_names(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_f64_var_names(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

function collect_f64_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_float_type(mod.funcs[i].ret_type)) {
            out = out.append(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// module_uses_clocks is true when the program calls any clock builtin.
function module_uses_clocks(mod: parser.Module): boolean {
    return module_calls(mod, "now_unix_ms") || module_calls(mod, "monotonic_ns") || module_calls(mod, "now_ns");
}

// component_shape classifies a program for the -target wasm-component CLI.
// Beyond no-I/O (0) and stdout (1), each *single* non-stdout WASI category a
// program uses maps to the matching component_full_io_* wrap. A program using
// two or more categories (e.g. read_file + env) has no single wrap yet, so it
// is rejected (-1) rather than emitting a component whose imports the framing
// can't satisfy. Shape codes:
//   0 no-I/O · 1 stdout · 2 fs-read · 3 fs-write · 4 fs-rw · 5 random
//   6 env · 7 args · 8 clock(wall) · 9 clock(mono) · 13 stderr · 14 exit
pub function component_shape(mod: parser.Module): i32 {
    var io: boolean = module_calls(mod, "print") || module_calls(mod, "write")
        || module_calls(mod, "putchar") || module_calls(mod, "print_int");
    var rd: boolean = module_calls(mod, "read_file");
    var wr: boolean = module_calls(mod, "write_file");
    var env: boolean = module_calls(mod, "env");
    var args: boolean = module_calls(mod, "args");
    var rnd: boolean = module_calls(mod, "random_bytes") || module_calls(mod, "random_i32");
    var clkw: boolean = module_calls(mod, "now_unix_ms") || module_calls(mod, "now_ns");
    var clkm: boolean = module_calls(mod, "monotonic_ns");
    var ep: boolean = module_calls(mod, "eprint");
    var ex: boolean = module_calls(mod, "exit");
    // Count distinct non-stdout WASI categories. Single-category programs and
    // a fixed set of two-category fs-paired combos have a wrapped wasi:cli/run
    // shape; anything else is rejected.
    var cats: i32 = 0;
    if (rd || wr) { cats = cats + 1; }
    if (env) { cats = cats + 1; }
    if (args) { cats = cats + 1; }
    if (rnd) { cats = cats + 1; }
    if (clkw || clkm) { cats = cats + 1; }
    if (ep) { cats = cats + 1; }
    if (ex) { cats = cats + 1; }
    if (cats > 2) { return 0 - 1; }
    if (cats == 0) {
        if (io) { return 1; }
        return 0;
    }
    if (cats == 2) {
        // Only specific fs-paired two-category combos have a single wrap.
        if ((rd || wr) && env) {
            if (rd && wr) { return 11; }   // fs read+write + env
            if (rd) { return 10; }          // fs read + env
            return 0 - 1;                   // write-only + env: no wrap
        }
        if ((rd || wr) && args) {
            if (rd && wr) { return 16; }   // fs read+write + args
            if (rd) { return 15; }          // fs read + args
            return 0 - 1;
        }
        if (rnd && wr && !rd) { return 12; } // random + fs write
        return 0 - 1;
    }
    if (rd || wr) {
        if (rd && wr) { return 4; }
        if (wr) { return 3; }
        return 2;
    }
    if (rnd) { return 5; }
    if (env) { return 6; }
    if (args) { return 7; }
    if (clkw || clkm) {
        // No combined wall+mono wrap; only one of the two is supported alone.
        if (clkw && clkm) { return 0 - 1; }
        if (clkm) { return 9; }
        return 8;
    }
    if (ep) { return 13; }
    if (ex) { return 14; }
    return 0 - 1;
}

// func_declares_i64 is true when a function signature or body involves an
// i64 value: an i64 return type, an i64 param, or an i64 local.
function func_declares_i64(f: parser.FuncDecl): boolean {
    if (f.ret_type == "i64") { return true; }
    var i: i32 = 0;
    while (i < f.params.len()) {
        if (f.params[i].type_name == "i64") { return true; }
        i = i + 1;
    }
    return collect_i64_var_names(f.body, []).len() > 0;
}

// expr_uses_i64_cast / stmts_use_i64_cast detect an `as i64` / `as u64`
// cast anywhere — such a cast yields an i64 value (and may feed
// print_int → print_int64) even with no i64-typed declaration, so it must
// also pull in the i64 runtime.
function expr_uses_i64_cast(e: parser.Expr): boolean {
    match (e) {
        parser.ExprUnary(u) => {
            if (u.op == "as_i64" || u.op == "as_u64") { return true; }
            return expr_uses_i64_cast(u.operand);
        },
        parser.ExprBinary(b) => {
            return expr_uses_i64_cast(b.left) || expr_uses_i64_cast(b.right);
        },
        parser.ExprCall(c) => {
            if (expr_uses_i64_cast(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_uses_i64_cast(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprIndex(ix) => { return expr_uses_i64_cast(ix.array) || expr_uses_i64_cast(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_uses_i64_cast(fa.obj); },
        parser.ExprLambda(lm) => { return stmts_use_i64_cast(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_use_i64_cast(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_uses_i64_cast(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_uses_i64_cast(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_uses_i64_cast(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_uses_i64_cast(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_uses_i64_cast(f.cond)) { return true; }
                if (stmts_use_i64_cast(f.then_body)) { return true; }
                if (stmts_use_i64_cast(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_uses_i64_cast(w.cond)) { return true; }
                if (stmts_use_i64_cast(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_uses_i64_cast(f.iter)) { return true; }
                if (stmts_use_i64_cast(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_uses_i64_cast(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_use_i64_cast(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// module_uses_i64 is true when the module touches i64 anywhere: a clock
// builtin call, any i64-typed return / param / local, or an `as i64` /
// `as u64` cast. Gates the i64 runtime (print_int64 + guarded div/rem)
// and the reserved scratch.
function module_uses_i64(mod: parser.Module): boolean {
    if (module_uses_clocks(mod)) { return true; }
    if (collect_i64_var_names(mod.top_stmts, []).len() > 0) { return true; }
    if (stmts_use_i64_cast(mod.top_stmts)) { return true; }
    // A desugared variant struct with an i64 `__ev` payload (S1 wide slot)
    // pulls in the i64 runtime: constructing or matching the payload, and any
    // i64 arithmetic on the bound value (e.g. `/`, `%` → the guarded helpers),
    // needs the 64-bit div/rem + formatter just like an explicit i64 local.
    var s: i32 = 0;
    while (s < mod.structs.len()) {
        var fj: i32 = 0;
        while (fj < mod.structs[s].fields.len()) {
            if (mod.structs[s].fields[fj].name == "__ev" && field_kind_of_type(mod.structs[s].fields[fj].type_name) == "i64") { return true; }
            fj = fj + 1;
        }
        s = s + 1;
    }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (func_declares_i64(mod.funcs[i])) { return true; }
        if (stmts_use_i64_cast(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// stmt_calls_print_int / module_uses_print_int detect whether the
// program calls the print_int builtin (statement position; recursing
// if/while bodies), so the helper is emitted only when used.
function stmt_calls_print_int(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtExpr(e) => {
                match (e.value) {
                    parser.ExprCall(c) => {
                        match (c.callee) {
                            parser.ExprIdent(id) => {
                                if (id.name == "print_int") { return true; }
                            },
                            _ => {},
                        }
                        // A lambda passed as a call argument may print.
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            match (c.args[ai]) {
                                parser.ExprLambda(lm) => { if (stmt_calls_print_int(lm.body)) { return true; } },
                                _ => {},
                            }
                            ai = ai + 1;
                        }
                    },
                    _ => {},
                }
            },
            parser.StmtVar(v) => {
                // `var f = function(){ … print_int … }` — scan the body.
                match (v.init) {
                    parser.ExprLambda(lm) => { if (stmt_calls_print_int(lm.body)) { return true; } },
                    _ => {},
                }
            },
            parser.StmtIf(f) => {
                if (stmt_calls_print_int(f.then_body)) { return true; }
                if (stmt_calls_print_int(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (stmt_calls_print_int(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (stmt_calls_print_int(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmt_calls_print_int(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_print_int(mod: parser.Module): boolean {
    if (stmt_calls_print_int(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmt_calls_print_int(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_uses_tostring / module_uses_tostring detect a `.to_string()` method
// call anywhere — so the integer→string runtime is emitted on demand.
function expr_uses_tostring(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => { if (fa.field == "to_string") { return true; } },
                _ => {},
            }
            if (expr_uses_tostring(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) { if (expr_uses_tostring(c.args[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprBinary(b) => { return expr_uses_tostring(b.left) || expr_uses_tostring(b.right); },
        parser.ExprUnary(u) => { return expr_uses_tostring(u.operand); },
        parser.ExprFieldAccess(fa) => { return expr_uses_tostring(fa.obj); },
        parser.ExprIndex(ix) => { return expr_uses_tostring(ix.array) || expr_uses_tostring(ix.index); },
        parser.ExprSlice(sl) => { return expr_uses_tostring(sl.array) || expr_uses_tostring(sl.start) || expr_uses_tostring(sl.end); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (expr_uses_tostring(a.elements[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { if (expr_uses_tostring(t.elements[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base && expr_uses_tostring(sl.base)) { return true; }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { if (expr_uses_tostring(sl.field_values[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_use_tostring(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_use_tostring(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_uses_tostring(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_uses_tostring(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_uses_tostring(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_uses_tostring(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_uses_tostring(f.cond)) { return true; }
                if (stmts_use_tostring(f.then_body)) { return true; }
                if (stmts_use_tostring(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_uses_tostring(w.cond)) { return true; }
                if (stmts_use_tostring(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_uses_tostring(f.iter)) { return true; }
                if (stmts_use_tostring(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_uses_tostring(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) { if (stmts_use_tostring(m.arms[k].body)) { return true; } k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// module_uses_string_type is true when the program references the `string`
// type anywhere — a function param/return, a struct field, or a local `var`
// declaration — even with no string literals. Such a program can still need
// the string runtime: string `==` lowers to a `$__fern_streq` call, so the
// string helpers must be emitted. Without this, a literal-free string-using
// program references an undefined `$__fern_streq` (a helper-emission gap akin
// to the f-string `__str_concat` one).
function type_is_string(t: string): boolean {
    return t == "string" || is_str_array_type(t);
}

function stmts_declare_string(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (type_is_string(v.type_name)) { return true; } },
            parser.StmtIf(f) => {
                if (stmts_declare_string(f.then_body)) { return true; }
                if (stmts_declare_string(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => { if (stmts_declare_string(w.body)) { return true; } },
            parser.StmtFor(f) => { if (stmts_declare_string(f.body)) { return true; } },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { if (stmts_declare_string(m.arms[k].body)) { return true; } k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_string_type(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[i];
        if (type_is_string(f.ret_type)) { return true; }
        var pi: i32 = 0;
        while (pi < f.params.len()) {
            if (type_is_string(f.params[pi].type_name)) { return true; }
            pi = pi + 1;
        }
        if (stmts_declare_string(f.body)) { return true; }
        i = i + 1;
    }
    if (stmts_declare_string(mod.top_stmts)) { return true; }
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var st: parser.StructDecl = mod.structs[si];
        var fi: i32 = 0;
        while (fi < st.fields.len()) {
            if (type_is_string(st.fields[fi].type_name)) { return true; }
            fi = fi + 1;
        }
        si = si + 1;
    }
    return false;
}

function module_uses_tostring(mod: parser.Module): boolean {
    if (stmts_use_tostring(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_use_tostring(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// emit_module produces the full WAT text for a module: the proc_exit
// import + memory, the guarded div/rem helpers (when used), every free
// function (so calls + recursion + mutual recursion resolve by name),
// and a `_start` that calls `proc_exit(main())`. A program with no
// `main` function (bare top-level statements) synthesises one from the
// module's top statements.
// emit_module emits the default WASI-preview1 *command* core module
// (`_start` → `proc_exit(main())`, exit code = main()'s value).
pub function emit_module(mod: parser.Module): string {
    return emit_module_mode(mod, false, false, false);
}

// emit_module_run emits the Component-Model *run* core module: no preview1
// scaffold, exporting `main` and `_lang_run` (`() -> i32`, 0 = ok). It is
// the core component_full wraps into a `wasi:cli/run` component. Valid for
// programs that use no WASI I/O (otherwise the core would import preview1
// functions the component can't satisfy — that needs the preview2 I/O
// codegen).
pub function emit_module_run(mod: parser.Module): string {
    return emit_module_mode(mod, true, false, false);
}

// emit_module_run_io emits the Component-Model *run* core for programs that
// write to stdout: like emit_module_run, but importing the preview2 stdout
// interfaces (wasi:cli/stdout/get-stdout + wasi:io/streams/
// [method]output-stream.blocking-write-and-flush) and defining a $fd_write
// *shim* over them, so the existing fd_write call sites work unchanged.
// component_full_io wraps the result into a wasi:cli/run component.
pub function emit_module_run_io(mod: parser.Module): string {
    return emit_module_mode(mod, true, true, false);
}

// emit_module_run_io_fs emits the Component-Model run core for programs that
// read files + write stdout: like emit_module_run_io, plus the preview2
// filesystem read imports + a preview2 $__fern_read_file + cabi_realloc.
// component_full_io_fs wraps the result.
pub function emit_module_run_io_fs(mod: parser.Module): string {
    return emit_module_mode(mod, true, true, true);
}

// emit_ir_module emits the complete preview1 command core module for an
// IR-eligible program: the wasi imports, memory + data section, the heap/RC
// runtime, every gated runtime helper, the lowered function bodies and the
// _start export.
//
// It is the SINGLE source of truth for wasm IR-path module emission. It used
// to be two hand-maintained copies — this function's body here in
// emit_module_mode, and a near-identical one inlined in the differential
// wasm_ir_run.fern driver — which silently drifted: the emit_module_mode copy
// never grew the WASI env / args / clock / write_file / stat / read_dir /
// temp_dir / sleep_ms / stdin-reader surface, nor map_iter / str_bytes / the
// f64 transcendentals, that the driver copy had. A module using any of them
// that reached THIS path emitted a `call $__fern_env` (etc.) with no matching
// definition or import, so wasmtime rejected the module with
// `unknown func: failed to find name $__fern_env` (#4801). Both callers now
// share this one body, so the drift cannot recur.
//
// `ir_cache` must be the lowering the caller also passes to emit_functions —
// the gates below and the emitted bodies have to agree on the same lowering.
pub function emit_ir_module(mod: parser.Module, ir_cache: irlower.LowerResult[]): string {
    var out: string = "(module\n";
    out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n";
    // wasi random_get import (issue #2747) — must precede the function
    // section. Emitted when the module uses random_bytes / random_i32.
    if (wasm_ir.module_uses_random(ir_cache)) { out = out + random_get_import(); }
    // print_int / print_str / eprint_str / putchar write via WASI fd_write
    // — import it only when the module writes to stdout or stderr.
    if (wasm_ir.module_emits_op_cached(ir_cache, "print_int") || wasm_ir.module_emits_op_cached(ir_cache, "print_i64") || wasm_ir.module_emits_op_cached(ir_cache, "print_str") || wasm_ir.module_emits_op_cached(ir_cache, "eprint_str") || wasm_ir.module_emits_op_cached(ir_cache, "putchar") || wasm_ir.module_emits_op_cached(ir_cache, "write_file")) {
        out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n";
    }
    // read_file / write_file open paths under preopen fd 3: path_open +
    // fd_read + fd_close (write_file also uses the fd_write import above).
    // read_dir ALSO needs path_open + fd_close, so it shares this bundle (an
    // unused fd_read import for a read_dir-only module is valid wasm) and adds
    // only fd_readdir below — avoiding a double path_open / fd_close import.
    // These imports must precede the function section.
    // remove_dir_all ALSO needs path_open + fd_close (+ fd_readdir below), so
    // it joins this union too.
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { out = out + file_imports(); }
    // read_dir / remove_dir_all list a directory via fd_readdir (path_open /
    // fd_close come from file_imports above) — emit the standalone fd_readdir
    // import once across both.
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { out = out + readdir_fd_import(); }
    // read_line / read_int / read_chunk read stdin (fd 0) via fd_read.
    // file_imports above already imports fd_read for path-based file I/O, so
    // emit the standalone fd_read import ONLY when the module reads stdin but
    // does NOT do file I/O — otherwise fd_read would be imported twice (an
    // invalid module).
    if ((wasm_ir.module_emits_op_cached(ir_cache, "read_line") || wasm_ir.module_emits_op_cached(ir_cache, "read_int") || wasm_ir.module_emits_op_cached(ir_cache, "read_chunk")) && !(wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all"))) {
        out = out + stdin_fd_read_import();
    }
    // reader_close calls preview1 fd_close. file_imports supplies fd_close for
    // path I/O, so emit the standalone fd_close import ONLY for a reader that
    // does no file I/O — otherwise fd_close would be imported twice.
    if (wasm_ir.module_emits_op_cached(ir_cache, "reader_close") && !(wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all"))) {
        out = out + reader_fd_close_import();
    }
    // The clock builtins (monotonic_ns / now_unix_ms / now_ns) wrap the
    // preview1 wasi clock_time_get import — emitted (before the function
    // section, like the other imports) when the module reads any clock.
    if (wasm_ir.module_emits_op_cached(ir_cache, "monotonic_ns") || wasm_ir.module_emits_op_cached(ir_cache, "now_unix_ms") || wasm_ir.module_emits_op_cached(ir_cache, "now_ns") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) {
        out = out + "  (import \"wasi_snapshot_preview1\" \"clock_time_get\" (func $clock_time_get (param i32 i64 i32) (result i32)))\n";
    }
    // args() reads the wasi argv vector — its args_sizes_get / args_get
    // imports must precede the function section, emitted when the module
    // reads argv.
    if (wasm_ir.module_emits_op_cached(ir_cache, "args")) { out = out + args_helpers(); }
    // env(name) scans the wasi environ vector — its environ_sizes_get /
    // environ_get imports must precede the function section, emitted when the
    // module reads an env var.
    if (wasm_ir.module_emits_op_cached(ir_cache, "env")) { out = out + env_helpers(); }
    // stat(path) uses the preview1 path_filestat_get import (must precede the
    // function section), emitted when the module stats a file.
    if (wasm_ir.module_emits_op_cached(ir_cache, "stat")) { out = out + stat_import(); }
    // remove_file / remove_dir_all use the preview1 path_unlink_file import
    // (remove_dir_all unlinks the regular files it finds) — emit it once across
    // both (must precede the function section).
    if (wasm_ir.module_emits_op_cached(ir_cache, "remove_file") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { out = out + remove_file_import(); }
    // remove_dir_all also rmdirs each emptied directory via path_remove_directory.
    if (wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { out = out + remove_dir_import(); }
    // temp_dir(prefix) mkdirs a unique dir under the preopen via
    // path_create_directory (must precede the function section).
    if (wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) { out = out + temp_dir_import(); }
    // sleep_ms blocks on a monotonic-clock timeout via poll_oneoff.
    if (wasm_ir.module_emits_op_cached(ir_cache, "sleep_ms")) { out = out + sleep_ms_import(); }
    // Preview-2 timer-pollable ops (#4317): direct component-model imports.
    // A module using them composes to a component (see wasm_ir helpers).
    if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_timer_pollable")) { out = out + wasm_ir.wasi_subscribe_duration_import(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_pollable_drop")) { out = out + wasm_ir.wasi_pollable_drop_import(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_block")) { out = out + wasm_ir.wasi_pollable_block_import(); }
    // tcp_connect / tcp_close (#4318): the wasi:sockets + stream-drop imports.
    // connect also BLOCKS on the socket's pollable to wait for the connection
    // to establish, so it needs pollable.block / [resource-drop]pollable — but
    // only when the module has not already imported them for wasm_block /
    // wasm_pollable_drop, since a duplicate import is an invalid module.
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_connect") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_close") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_listen") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_accept") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_pollable")) { out = out + wasm_ir.wasi_sockets_imports(); }
    // tcp_send / tcp_recv need the stream read/write imports (#4318 slice 2).
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_send") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_recv")) { out = out + wasm_ir.wasi_stream_io_imports(); }
    // tcp_listen / tcp_accept add bind + listen + accept; tcp_pollable and
    // tcp_accept both need the sockets base set (subscribe + the drops).
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_listen") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_accept")) { out = out + wasm_ir.wasi_sockets_server_imports(); }
    if ((wasm_ir.module_emits_op_cached(ir_cache, "tcp_connect") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_accept")) && !wasm_ir.module_emits_op_cached(ir_cache, "wasm_block")) { out = out + wasm_ir.wasi_pollable_block_import(); }
    if ((wasm_ir.module_emits_op_cached(ir_cache, "tcp_connect") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_accept")) && !wasm_ir.module_emits_op_cached(ir_cache, "wasm_pollable_drop")) { out = out + wasm_ir.wasi_pollable_drop_import(); }
    // wasm_poll: the LIST-typed wasi:io/poll.poll multiplexer (#4316). Its
    // helper is heap-backed (it allocates the 8-byte canonical return area), so
    // the heap gate below folds it in.
    if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_poll")) { out = out + wasm_ir.wasi_poll_import(); }
    out = out + "  (memory (export \"memory\") 16)\n";
    // String literals -> data-section blocks `[len:i32 LE][bytes]`. Emitted
    // caller-side (wasm owns le32_escape/wat_escape); wasm_ir supplies the
    // distinct values + their offsets so the data + const_str ptrs agree.
    var sv: string[] = wasm_ir.str_values(ir_cache);
    var di: i32 = 0;
    while (di < sv.len()) {
        out = out + "  (data (i32.const " + util.i32_to_string(wasm_ir.str_offset(sv, di)) + ") \""
            + le32_escape(sv[di].len()) + wat_escape(sv[di]) + "\")\n";
        di = di + 1;
    }
    if (wasm_ir.module_allocates(ir_cache) || wasm_ir.module_uses_i32_to_string(ir_cache) || wasm_ir.module_uses_chr(ir_cache) || wasm_ir.module_uses_strbuf(ir_cache) || wasm_ir.module_emits_op_cached(ir_cache, "env") || wasm_ir.module_emits_op_cached(ir_cache, "stat") || wasm_ir.module_emits_op_cached(ir_cache, "remove_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir") || wasm_ir.module_emits_op_cached(ir_cache, "sleep_ms") || wasm_ir.module_emits_op_cached(ir_cache, "read_chunk") || wasm_ir.module_emits_op_cached(ir_cache, "reader_close") || wasm_ir.module_emits_op_cached(ir_cache, "wasm_poll") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_connect") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_send") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_recv") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_listen") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_accept")) {
        out = out + heap_alloc_helpers(wasm_ir.heap_base_for(ir_cache), wasm_ir.fl_base_for(ir_cache), wasm_ir.fl_cells());
        out = out + rc_runtime_helpers(wasm_ir.heap_base_for(ir_cache));
    }
    // $__fern_arr_dec_ptr2 (string[][] deep reclaim, #4355 slice 9): only
    // when the module lowers a __fern_strarrarr_free call — see
    // arr_dec_ptr2_func for why it must not ride along unconditionally.
    if (wasm_ir.module_calls_strarrarr_free(ir_cache)) { out = out + arr_dec_ptr2_func(wasm_ir.heap_base_for(ir_cache)); }
    if (wasm_ir.module_calls_optarrarr_free(ir_cache)) { out = out + optarrarr_free_func(wasm_ir.heap_base_for(ir_cache)); }
    // $__fern_strbuf_* (global string-builder): a growable bump-heap buffer +
    // reset/append/take. Heap-backed (str_box / alloc), emitted above.
    if (wasm_ir.module_uses_strbuf(ir_cache)) { out = out + strbuf_helpers(); }
    // Per-type $__field_reclaim_<T> + $__struct_drop_<T> RC helper bodies
    // (#3457, Perceus slices 1c/1d + slice-3 nested deep-drop). emit_module's
    // own IR orchestration emits these; this differential driver assembles the
    // helper section itself, so it MUST emit them too — otherwise a struct
    // program whose deep-drop lowering inserts a `call $__struct_drop_<T>`
    // links against an undefined function and traps under wasmtime
    // (`unknown func $__struct_drop_<T>`). Returns "" for modules with no rc
    // fields, so non-struct programs are unchanged.
    out = out + emit_ir_rc_bodies(mod, ir_cache);
    if (wasm_ir.module_uses_divrem(ir_cache)) { out = out + divrem_helpers(); }
    if (wasm_ir.module_uses_i64_divrem(ir_cache)) { out = out + divrem64_helpers(); }
    // $__fern_exp_f64: e^x via a polynomial (no transcendental wasm
    // instruction). Self-contained f64 math — no imports or heap. fpow (x^y =
    // exp(y·ln x)) reuses it, so its gate folds fpow in (emitted once).
    if (wasm_ir.module_emits_op_cached(ir_cache, "fexp") || wasm_ir.module_emits_op_cached(ir_cache, "fpow")) { out = out + exp_func(); }
    // $__fern_log_f64: ln x via a polynomial (same — self-contained f64 math).
    // fpow reuses it too, so its gate folds fpow in.
    if (wasm_ir.module_emits_op_cached(ir_cache, "flog") || wasm_ir.module_emits_op_cached(ir_cache, "fpow")) { out = out + log_func(); }
    // $__fern_pow_f64: x^y = exp(y·ln x) — composes the two helpers above.
    if (wasm_ir.module_emits_op_cached(ir_cache, "fpow")) { out = out + pow_func(); }
    // $__fern_sin_f64 / $__fern_cos_f64: trig via argument reduction + Taylor
    // polynomials (no transcendental wasm instruction). Self-contained f64 math.
    if (wasm_ir.module_emits_op_cached(ir_cache, "fsin")) { out = out + sin_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "fcos")) { out = out + cos_func(); }
    // $__fern_strcat + $__fern_streq (concat / equality); references
    // $__fern_str_box from heap_alloc_helpers, which module_allocates pulls
    // in for any string program.
    if (wasm_ir.module_uses_strings(ir_cache) || wasm_ir.module_uses_maps(ir_cache)) { out = out + strcat_streq_helpers(); }
    // $__fern_i32_to_str backs i32.to_string() (wasm_helper_symbol maps the
    // IR call_direct to it).
    if (wasm_ir.module_uses_i32_to_string(ir_cache)) { out = out + to_string_helpers(); }
    // $__fern_now_ns / $__fern_now_unix_ms / $__fern_monotonic_ns back the
    // clock builtins (each result i64), reading the preview1 clock_time_get
    // import into the 8-byte scratch at addr 16 — emitted as a trio (the AST
    // path does the same) when the module reads any clock.
    if (wasm_ir.module_emits_op_cached(ir_cache, "monotonic_ns") || wasm_ir.module_emits_op_cached(ir_cache, "now_unix_ms") || wasm_ir.module_emits_op_cached(ir_cache, "now_ns") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) { out = out + clock_funcs(); }
    // $__fern_args builds the argv string[] via the wasi args_get import +
    // the heap runtime (module_allocates pulls the heap in for an args
    // module — op_allocates admits "args"). Emitted when the module reads argv.
    if (wasm_ir.module_emits_op_cached(ir_cache, "args")) { out = out + args_func(); }
    // $__fern_env(name): scan the environ vector for `NAME=`, box an
    // Option[string] (Some(value)/None). Heap-backed (allocates the value +
    // box), so the heap gate above folds env in.
    if (wasm_ir.module_emits_op_cached(ir_cache, "env")) { out = out + env_func(); }
    // $__fern_build_io_error(errno, path): map a WASI errno to a real
    // IoError variant box, shared by every fs helper's error path (the wasm
    // sibling of native wasmbin's __build_io_error / asm_ir's
    // __fern_io_error). Emit it once whenever any fs op is present so the
    // helpers' Err/Some payloads carry a matchable variant, not a raw errno.
    if (wasm_ir.module_emits_op_cached(ir_cache, "stat") || wasm_ir.module_emits_op_cached(ir_cache, "remove_file") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all") || wasm_ir.module_emits_op_cached(ir_cache, "temp_dir") || wasm_ir.module_emits_op_cached(ir_cache, "read_file") || wasm_ir.module_emits_op_cached(ir_cache, "write_file")) { out = out + wasm_ir.build_io_error_func(mod.structs); }
    // $__fern_stat(path, fstype): path_filestat_get -> FileStat struct +
    // Result box. Heap-backed (allocates the buffer + boxes), so folded into
    // the heap gate above.
    if (wasm_ir.module_emits_op_cached(ir_cache, "stat")) { out = out + stat_func(); }
    // $__fern_remove_file(path): path_unlink_file -> Option[IoError] box.
    // Heap-backed (allocates the box), so folded into the heap gate above.
    if (wasm_ir.module_emits_op_cached(ir_cache, "remove_file")) { out = out + remove_file_func(); }
    // $__fern_read_dir(path): path_open + fd_readdir loop -> Result[string[],
    // IoError] box. Heap-backed (allocates names + array + box) and uses
    // $__fern_arr_push (emitted by the arr_push gate below, which folds
    // read_dir in).
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_dir")) { out = out + read_dir_func(); }
    // $__fern_remove_dir_all(path): recursive rm -rf -> Option[IoError] box.
    // Heap-backed + uses $__fern_arr_push (both folded into the gates above).
    if (wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all")) { out = out + remove_dir_func(); }
    // $__fern_temp_dir(prefix): mkdir a unique `<prefix>-<ns>` dir under the
    // preopen -> Result[string, IoError]. Heap-backed + uses the clock helper.
    if (wasm_ir.module_emits_op_cached(ir_cache, "temp_dir")) { out = out + temp_dir_func(); }
    // $__fern_sleep_ms(ms): block via poll_oneoff. Heap-backed (scratch buffer).
    if (wasm_ir.module_emits_op_cached(ir_cache, "sleep_ms")) { out = out + sleep_ms_func(); }
    // wasm_poll returns a list<u32>, which the canonical ABI materialises in
    // GUEST memory via the exported cabi_realloc — without it `component new`
    // fails with "module does not export a function named cabi_realloc".
    // Shares $heap / $__fern_alloc with the heap runtime the gate above pulls
    // in for wasm_poll.
    if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_poll")) { out = out + wasm_ir.wasm_poll_func(); }
    // cabi_realloc is the canonical ABI's GUEST allocator, needed by every op
    // whose import RETURNS a list: wasm_poll (list<u32>) and tcp_recv
    // (list<u8>). One shared gate so it is emitted exactly once — a second
    // definition is a duplicate-export error.
    if (wasm_ir.module_emits_op_cached(ir_cache, "wasm_poll") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_recv")) { out = out + cabi_realloc_helper(); }
    // $__fern_network_handle is shared by every socket op; emitted with
    // whichever one pulls it in.
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_connect") || wasm_ir.module_emits_op_cached(ir_cache, "tcp_listen")) { out = out + wasm_ir.network_handle_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_connect")) { out = out + wasm_ir.tcp_connect_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_close")) { out = out + wasm_ir.tcp_close_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_send")) { out = out + wasm_ir.tcp_send_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_recv")) { out = out + wasm_ir.tcp_recv_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_listen")) { out = out + wasm_ir.tcp_listen_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_accept")) { out = out + wasm_ir.tcp_accept_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "tcp_pollable")) { out = out + wasm_ir.tcp_pollable_func(); }
    // $__fern_read_file / $__fern_write_file: open under preopen fd 3 and
    // read/write the whole file, boxing a Result[string, IoError] /
    // Option[IoError]. They alloc via the heap runtime (module_allocates
    // pulls it in — op_allocates admits read_file/write_file). Emitted when
    // the module does the matching file op.
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_file")) { out = out + readfile_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "write_file")) { out = out + writefile_func(); }
    // $__fern_read_line boxes a line of stdin (heap-gated via op_allocates);
    // $__fern_read_int parses an int into scratch (no heap). Emitted when the
    // module reads stdin.
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_line")) { out = out + read_line_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_int")) { out = out + read_int_func(); }
    // $__fern_reader_read_chunk(fd,n) / $__fern_reader_close(fd) back the
    // Reader intrinsics (r.read_chunk(n) / r.close()) — a Reader is just its fd
    // (stdin = fd 0). Both box (Option[string] / Option[IoError]), so they ride
    // the heap runtime (gated in above); read_chunk reads via fd_read, close
    // via fd_close (imports emitted above). Backs std/io read_all_stdin on wasm.
    if (wasm_ir.module_emits_op_cached(ir_cache, "read_chunk")) { out = out + reader_read_chunk_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "reader_close")) { out = out + reader_close_func(); }
    // $__fern_str_to_i32 backs str_to_i32(s); allocation-free, own gate.
    if (wasm_ir.module_uses_str_to_i32(ir_cache)) { out = out + str_to_i32_helper(); }
    // $__fern_chr backs chr(n); allocates (heap gate ORs in module_uses_chr).
    if (wasm_ir.module_uses_chr(ir_cache)) { out = out + chr_helper(); }
    if (wasm_ir.module_uses_str_cmp(ir_cache)) { out = out + strcmp_helper(); }
    // $__fern_substr backs str_slice AND str_split (split slices each
    // segment), so emit it for either — but only ONCE.
    if (wasm_ir.module_uses_str_slice(ir_cache) || wasm_ir.module_emits_op_cached(ir_cache, "str_split") || wasm_ir.module_uses_str_lines(ir_cache)) { out = out + substr_helper(); }
    // $__fern_str_split (+ its private $__fern_arr_push) for the IR path.
    if (wasm_ir.module_emits_op_cached(ir_cache, "str_split") || wasm_ir.module_uses_str_lines(ir_cache)) { out = out + str_split_helper(); }
    // Scalar string search predicates (starts_with / ends_with / index_of /
    // contains) — self-contained, emitted only when used.
    if (wasm_ir.module_uses_str_predicate(ir_cache)) { out = out + str_predicate_helpers(); }
    // ASCII case transforms (to_upper / to_lower) — self-contained, emitted
    // only when used.
    if (wasm_ir.module_uses_str_case(ir_cache)) { out = out + str_case_helpers(); }
    // String repeat — self-contained, emitted only when used.
    if (wasm_ir.module_uses_str_repeat(ir_cache)) { out = out + str_repeat_helper(); }
    // String trim — self-contained, emitted only when used (IR-only on wasm).
    if (wasm_ir.module_uses_str_trim(ir_cache)) { out = out + str_trim_helper(); }
    // String reverse — self-contained, emitted only when used (IR-only on wasm).
    if (wasm_ir.module_uses_str_reverse(ir_cache)) { out = out + str_reverse_helper(); }
    // String replace — self-contained, emitted only when used (IR-only on wasm).
    if (wasm_ir.module_uses_str_replace(ir_cache)) { out = out + str_replace_helper(); }
    // String chars — self-contained, emitted only when used (IR-only on wasm).
    if (wasm_ir.module_uses_str_chars(ir_cache)) { out = out + str_chars_helper(); }
    // String lines — split on \n + trailing-empty trim (IR-only on wasm).
    if (wasm_ir.module_uses_str_lines(ir_cache)) { out = out + str_lines_helper(); }
    if (wasm_ir.module_uses_arr_slice(ir_cache)) { out = out + arr_slice_helper(); }
    if (wasm_ir.module_uses_arr_slice8(ir_cache)) { out = out + arr_slice8_helper(); }
    // `.append` (op_arr_push) emits a call to $__fern_arr_push; the IR path
    // needs the standalone push helper (the AST path's arr_helpers bundle —
    // which also defines arr_slice/slice8 — would double-define those, so use
    // the push-only emitter). Depends on $__fern_arr_box (module_allocates).
    // A self-reassign append (`a = a.append(v)`) lowers to op_arr_push_owned,
    // which calls $__fern_arr_push_owned (the reclaim-on-grow wrapper) — so it
    // must pull in BOTH $__fern_arr_push and the owned wrapper, else a program
    // whose only appends are self-reassigns calls an undefined function.
    // read_dir builds its string[] result via $__fern_arr_push, so it folds
    // into this gate (emitted once — a read_dir module that ALSO uses .append
    // shares the single definition).
    // str_split_helper (emitted above for str_split / str_lines) already
    // begins with arr_push_helper(), so it defines $__fern_arr_push itself —
    // gating that out here keeps the single definition (else a module using
    // BOTH .split()/lines AND .append double-defines it → "duplicate func").
    var needs_arr_push: boolean = wasm_ir.module_emits_op_cached(ir_cache, "arr_push") || wasm_ir.module_emits_op_cached(ir_cache, "arr_push_owned") || wasm_ir.module_emits_op_cached(ir_cache, "read_dir") || wasm_ir.module_emits_op_cached(ir_cache, "remove_dir_all");
    var split_emits_push: boolean = wasm_ir.module_emits_op_cached(ir_cache, "str_split") || wasm_ir.module_uses_str_lines(ir_cache);
    if (needs_arr_push && !split_emits_push) { out = out + arr_push_helper(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "arr_push_owned")) { out = out + arr_push_owned_helper(wasm_ir.heap_base_for(ir_cache)); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "arr_push_i64")) { out = out + arr_push_i64_helper(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "arr_push_f64")) { out = out + arr_push_f64_helper(); }
    if (wasm_ir.module_uses_maps(ir_cache)) { out = out + map_helpers(); }
    // $__fern_map_iter + accessors: the wasm map-iterator runtime (materializes
    // keys/values via map_helpers above, so gated after it). Emitted when the
    // module iterates a map (m.iter() / for-in-map).
    if (wasm_ir.module_emits_op_cached(ir_cache, "map_iter")) { out = out + map_iter_helpers(); }
    // Byte-source helpers (issue #2747). random_bytes returns a [len][bytes]
    // string block; str_bytes returns a u8[]; both reference the heap runtime
    // ($__fern_str_box / $__fern_arr_box) that module_allocates pulls in.
    // random_i32 is heap-free. The import is emitted above.
    if (wasm_ir.module_emits_op_cached(ir_cache, "random_bytes")) { out = out + random_bytes_ir_func(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "random_i32")) { out = out + random_i32_func(); }
    // print_int's $__fern_print_int: digit buffer in the 16-byte scratch past
    // the string blocks (the `+16` in fl_base_for); iovec in the low-24 scratch.
    if (wasm_ir.module_emits_op_cached(ir_cache, "print_int")) { out = out + print_int_helper(wasm_ir.str_offset(sv, sv.len())); }
    // $__fern_print_int64 for print_int(i64): a 24-byte scratch buffer 16 bytes
    // past print_int's (matching the AST path's tab.next + 16 offset) so the two
    // never clobber when a module prints both widths.
    if (wasm_ir.module_emits_op_cached(ir_cache, "print_i64")) { out = out + print_int64_helper(wasm_ir.str_offset(sv, sv.len()) + 16); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "print_str")) { out = out + print_str_helper(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "eprint_str")) { out = out + eprint_str_helper(); }
    if (wasm_ir.module_emits_op_cached(ir_cache, "str_bytes")) { out = out + str_bytes_func(); }
    // string_from_bytes(arr) packs a u8[] into a string block via
    // $__fern_string_from_bytes; op_str_from_bytes emits the call, so the
    // helper must be present (its absence left a dangling call -> the wasm
    // module failed to link). Depends on $__fern_alloc / $__fern_str_box,
    // which module_allocates pulls in via heap_alloc_helpers.
    if (wasm_ir.module_emits_op_cached(ir_cache, "str_from_bytes")) { out = out + string_from_bytes_helper(); }
    // Function-value support: the $fn<N> call_indirect signature types, the
    // funcref table, and its elem segment (empty for non-closure modules).
    out = out + wasm_ir.fn_support_section(ir_cache);
    out = out + wasm_ir.emit_functions(mod, ir_cache);
    out = out + "  (func $_start (call $proc_exit (call $main)))\n";
    out = out + "  (export \"_start\" (func $_start)))\n";
    return out;
}

function emit_module_mode(mod: parser.Module, component: boolean, io: boolean, fs: boolean): string {
    // IR path (docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md §3): when use_ir is set
    // (default on) AND the whole module is in the i32 + arrays subset, emit the
    // preview1 command core from the target-agnostic stack IR
    // (wasm_ir.emit_functions — the wasm mirror of asm_ir, with wasm's linear-
    // memory layout + the SAME Perceus array RC). The IR emits FLAT WAT, which
    // both wasmtime and the self-host watbin encoder now assemble. The heap/RC
    // runtime is emitted from HERE (this module's heap_alloc_helpers /
    // rc_runtime_helpers), so wasm_ir does NOT import wasm — no cycle. Component
    // modes and out-of-subset modules (strings, structs, methods, …) fall
    // through to the AST emitter below, so the bootstrap is unaffected.
    var lm: parser.Module = wasm_ir.lift_lambdas(mod);
    // Lower every function ONCE into `ir_cache` and thread it through the whole
    // IR emit path (the gate deferral checks + all the module_uses_* / str_values
    // / fn_value_table collect passes below), instead of re-lowering the module
    // ~30× (once per query) — the O(functions²) × O(passes) blowup that OOMed the
    // self-host wasm compile of large modules (#4652). The cheap AST-only
    // should_use_ir_core gate runs FIRST so an ineligible bootstrap module is
    // never lowered here; only an eligible module pays the single lowering.
    var ir_ok: boolean = !component && wasm_ir.should_use_ir_core(lm);
    var ir_cache: irlower.LowerResult[] = [];
    if (ir_ok) {
        ir_cache = wasm_ir.lower_all_for(lm);
        ir_ok = wasm_ir.wasm_ir_deferrals_ok(ir_cache);
    }
    if (ir_ok) {
        // Hoist no-capture lambda call-args (closures slice 2a) before emit;
        // lambda-free modules are unchanged, and the AST path below keeps `mod`.
        mod = lm;
        return emit_ir_module(mod, ir_cache);
    }
    // Intern every string literal in the module into the data section.
    var tab: StrTable = new_str_table();
    tab = collect_strings_stmts(mod.top_stmts, tab);
    var si: i32 = 0;
    while (si < mod.funcs.len()) {
        tab = collect_strings_stmts(mod.funcs[si].body, tab);
        si = si + 1;
    }

    var has_strings: boolean = tab.values.len() > 0 || module_uses_string_type(mod);
    var str_funcs: string[] = collect_str_funcs(mod);
    var str_arr_funcs: string[] = collect_str_arr_funcs(mod);
    var sf_names: string[] = collect_struct_func_names(mod);
    var sf_types: string[] = collect_struct_func_types(mod);
    var of_names: string[] = collect_opt_func_names(mod);
    var of_payloads: string[] = collect_opt_func_payloads(mod);
    var mr_types: string[] = collect_method_types(mod);
    var mr_names: string[] = collect_method_names(mod);
    var mr_rets: string[] = collect_method_rets(mod);

    var i64_funcs: string[] = collect_i64_func_names(mod);
    var f64_funcs: string[] = collect_f64_func_names(mod);

    var has_env: boolean = module_calls(mod, "env");
    var has_random: boolean = module_calls(mod, "random_bytes") || module_calls(mod, "random_i32");
    var has_sfb: boolean = module_calls(mod, "string_from_bytes");
    var has_args: boolean = module_calls(mod, "args");
    var has_readfile: boolean = module_calls(mod, "read_file");
    var has_writefile: boolean = module_calls(mod, "write_file");
    var has_clocks: boolean = module_uses_clocks(mod);
    var has_wallclock: boolean = module_calls(mod, "now_unix_ms") || module_calls(mod, "now_ns");
    var has_monoclock: boolean = module_calls(mod, "monotonic_ns");
    var has_eprint: boolean = module_calls(mod, "eprint");
    var has_exit: boolean = module_calls(mod, "exit");
    var has_i64: boolean = module_uses_i64(mod);
    // A string/list<u8>-returning `@import` extern (P4c) needs the heap
    // allocator and the exported cabi_realloc. A string *parameter* needs a
    // wrapper too, but no realloc/heap (it forwards the guest's bytes).
    var has_extern_str: boolean = module_has_extern_composite_result(mod);
    var needs_extern_wrappers: boolean = module_needs_extern_wrappers(mod);

    var out: string = "(module\n";
    // Component-run cores are import-free (no preview1 entry / output), so
    // a core-instance can `instantiate` them with no args; preview1 command
    // cores import proc_exit (for _start) + fd_write (for print/write).
    if (!component) {
        out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n";
        out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n";
    }
    // Preview2 stdout imports (component-io mode): get-stdout returns an
    // output-stream handle; blocking-write-and-flush writes a (ptr,len)
    // list<u8>, its result going to the 4th (return-area) arg.
    if (component && io) {
        // When eprint is used the core also imports wasi:cli/stderr's
        // get-stderr; the native compiler orders it before stdout
        // (get-stderr, blocking-write-and-flush, get-stdout), so mirror that.
        // stdout stays imported either way (the io path always wires it), so
        // an eprint-only program just carries an unused stdout import and
        // still matches the eprint+stdout framing.
        if (has_eprint) {
            out = out + "  (import \"wasi:cli/stderr@0.2.0\" \"get-stderr\" (func $get_stderr (result i32)))\n";
            out = out + "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $bwf (param i32 i32 i32 i32)))\n";
            out = out + "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $get_stdout (result i32)))\n";
        } else {
            out = out + "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $get_stdout (result i32)))\n";
            out = out + "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $bwf (param i32 i32 i32 i32)))\n";
        }
    }
    // exit's wasi:cli/exit import sits immediately after the stdout pair (the
    // native compiler's canonical slot, before random/clocks/args/env/fs).
    // exit's status is a result discriminant: 0 = ok, 1 = err; the lowered
    // import takes it as an i32.
    if (component && io && has_exit) {
        out = out + "  (import \"wasi:cli/exit@0.2.0\" \"exit\" (func $exit (param i32)))\n";
    }
    // wasi imports must sit in the import section (before funcs), and the
    // preview2-native (io) path emits them in the native compiler's canonical
    // interface order — random, wall-clock, monotonic-clock, args, env, then
    // filesystem — so the core's import set matches the component framing for
    // any combination (single-import shapes are unaffected: each lone import
    // still lands right after the stdout pair).
    if (has_random) { if (io) { out = out + random_imports_p2(); } else { out = out + random_helpers(); } }
    if (has_clocks) { if (io) { out = out + clock_imports_p2(has_wallclock, has_monoclock); } else { out = out + clock_imports(); } }
    if (has_args) { if (io) { out = out + args_imports_p2(); } else { out = out + args_helpers(); } }
    if (has_env) { if (io) { out = out + env_imports_p2(); } else { out = out + env_helpers(); } }
    // component-io-fs: the preview2 filesystem imports (read and/or write).
    if (fs) { out = out + fs_imports_p2(has_readfile, has_writefile); }
    if ((has_readfile || has_writefile) && !fs) { out = out + file_imports(); }
    // `@import` extern declarations (P4): each becomes a core wasm function
    // import the world-driven composer wires. Empty when the program declares
    // none, so existing programs are unaffected.
    out = out + extern_imports(mod);
    // 16 pages (1 MiB) gives the bump heap (string concat) headroom.
    out = out + "  (memory (export \"memory\") 16)\n";
    // Scratch: a "\n" byte at addr 12 (for `print`); the iovec (0,4) and
    // nwritten (8) slots are written at runtime.
    out = out + "  (data (i32.const 12) \"\\0a\")\n";
    // Each literal is a `[len:i32 LE][bytes]` block at its interned
    // offset; the string value is a pointer to the block.
    var di: i32 = 0;
    while (di < tab.values.len()) {
        out = out + "  (data (i32.const " + util.i32_to_string(tab.offsets[di]) + ") \""
            + le32_escape(tab.values[di].len()) + wat_escape(tab.values[di]) + "\")\n";
        di = di + 1;
    }
    if (module_uses_divrem(mod)) {
        out = out + divrem_helpers();
    }
    // The print_int scratch buffer sits just above all string data.
    if (module_uses_print_int(mod)) {
        out = out + print_int_helper(tab.next);
    }
    // i64 runtime: the guarded 64-bit div/rem, the clock builtins, and the
    // i64 decimal formatter. print_int64 formats into a 24-byte buffer at
    // tab.next + 16 (just above the 16-byte print_int buffer).
    if (has_i64) {
        out = out + divrem64_helpers();
        out = out + print_int64_helper(tab.next + 16);
    }
    if (has_clocks) {
        if (io) { out = out + clock_funcs_p2(has_wallclock, has_monoclock); } else { out = out + clock_funcs(); }
    }
    // The bump heap (for string concat + array allocation) starts above
    // all static data: past the blocks, the 16-byte print_int buffer, and
    // (when i64 is used) the 24-byte print_int64 buffer.
    var heap_extra: i32 = 0;
    if (has_i64) { heap_extra = 24; }
    var has_arrays: boolean = module_uses_arrays(mod);
    var has_structs: boolean = module_uses_structs(mod);
    // Enum-constant access (`Color.Green`) builds a variant box but isn't a
    // struct literal, so gate the heap on any struct/enum declaration too.
    if (mod.structs.len() > 0) { has_structs = true; }
    var has_options: boolean = module_uses_options(mod);
    var has_maps: boolean = module_calls(mod, "map_new_i32") || module_calls(mod, "map_new");
    var has_tostring: boolean = module_uses_tostring(mod);
    var has_rcmem: boolean = module_uses_rcmem(mod);
    var needs_heap: boolean = has_strings || has_arrays || has_structs || has_options || has_env || has_random || has_sfb || has_args || has_readfile || has_writefile || has_maps || has_tostring || has_extern_str || export_needs_heap(mod) || has_rcmem || (component && io);
    // Memory layout above the static data: the Perceus size-class freelist
    // (65536 i32 heads = 256 KiB, covering blocks up to 512 KiB; zero-init
    // by wasm's zeroed memory = empty lists), then the bump heap. heap_base
    // is 8-aligned so every block (and thus the class = blocksize/8 scheme)
    // lines up. heap_base is also the rc helpers' low-address guard, so the
    // freelist region (below it) is never mistaken for a live heap object.
    // 65536 classes matches the asm backends' freelist cap (512 KiB blocks)
    // so wasm recycles the same range — the larger token/AST arrays included.
    var fl_base: i32 = (tab.next + 16 + heap_extra + 7) / 8 * 8;
    var fl_cells: i32 = 65536;
    var heap_base: i32 = fl_base + fl_cells * 4;
    if (needs_heap) {
        out = out + heap_alloc_helpers(heap_base, fl_base, fl_cells);
    }
    // The Perceus RC runtime (__fern_rc_*) + raw-memory pokes (__alloc
    // forwards to the bump heap above). Emitted whenever the heap is — the
    // array counting inc/exit-sweep emit $__fern_rc_inc / $__fern_arr_dec
    // calls, and any heap program may carry array params to count.
    if (needs_heap) {
        out = out + rc_runtime_helpers(heap_base);
    }
    // Transitive reclamation (Stage A): the per-struct/enum-type drop functions
    // ($__fern_release_<T>) that the struct exit-sweep + cow-dec call, so a
    // nested struct field recurses through its own release fn (arbitrary depth)
    // rather than a flat one-level dec. Emitted when the heap + any struct/enum
    // type exists.
    if (needs_heap && (mod.structs.len() > 0 || mod.enums.len() > 0)) {
        out = out + struct_enum_drop_helpers(mod, release_module_ctx(mod.structs, mr_types, mod.funcs));
    }
    // component-io: the $fd_write shim over the preview2 stdout stream, so
    // every fd_write call site (print / write / print_int) works unchanged.
    if (component && io) {
        if (has_eprint) { out = out + stderr_shim_helpers(); }
        out = out + stdout_shim_helpers();
    }
    // eprint's stderr writer: the preview2 shim above (component-io) or the
    // preview1 fd_write(2) helper (adapter / command path).
    if (has_eprint && !(component && io)) {
        out = out + eprint_func_p1();
    }
    // exit's terminator: wasi:cli/exit (component-io) or proc_exit (preview1).
    // The no-I/O component path (component && !io) imports neither, so exit is
    // only wired where its mechanism exists — the realistic CLI (preview1) and
    // component-io targets.
    if (has_exit && (!component || io)) {
        out = out + exit_func(component && io);
    }
    // The string runtime is needed for string literals AND for the string
    // values that env() / args() produce; the map runtime's key-equality
    // helper references $__fern_streq, so any map use needs it too.
    if (has_strings || has_env || has_args || has_readfile || has_writefile || has_maps || has_tostring) {
        out = out + strcat_helpers();
    }
    // The integer→string runtime backs `.to_string()` (f-string lowering).
    if (has_tostring) {
        out = out + to_string_helpers();
    }
    // arr_helpers (push) is also needed by string `split`, which builds
    // its result array via $__fern_arr_push — so emit it for strings too
    // (and for maps, which pull in the string runtime for key compare).
    if (has_arrays || has_strings || has_env || has_args || has_readfile || has_writefile || has_maps || has_tostring || module_has_array_param_export(mod)) {
        out = out + arr_helpers();
    }
    if (has_sfb) {
        out = out + string_from_bytes_helper();
    }
    if (has_maps) {
        out = out + map_helpers();
    }
    if (has_env) {
        if (io) { out = out + env_func_p2(); } else { out = out + env_func(); }
    }
    if (has_random) {
        if (io) { out = out + random_func_p2(); } else { out = out + random_func(); }
    }
    if (has_args) {
        if (io) { out = out + args_func_p2(); } else { out = out + args_func(); }
    }
    // Preview-1 read_file/write_file box their Err payload via
    // $__fern_build_io_error; emit it once for either. (The preview-2 _p2
    // helpers keep their own shape.)
    if (!fs && (has_readfile || has_writefile)) { out = out + wasm_ir.build_io_error_func(mod.structs); }
    if (has_readfile) {
        if (fs) { out = out + readfile_func_p2(); } else { out = out + readfile_func(); }
    }
    if (has_writefile) {
        if (fs) { out = out + writefile_func_p2(); } else { out = out + writefile_func(); }
    }
    // component-io-fs: the canonical-ABI realloc the fs lists need; a
    // string/list<u8>-returning extern (P4c) needs it too so the host can
    // materialize the returned bytes.
    if (fs || (io && (has_env || has_args)) || has_extern_str || export_needs_realloc(mod)) { out = out + cabi_realloc_helper(); }
    // P4c: the lift wrappers for string/list<u8>-returning `@import` externs.
    if (needs_extern_wrappers) { out = out + extern_wrappers(mod); }

    // Shared lambda cells (1-element arrays, mutated in place so the index
    // counter + accumulated $__lambda<i> defs persist across every
    // function's emission).
    var lam_ctr: Cell[i32] = cell_new(0);
    var lamdefs: Cell[string] = cell_new("");

    var has_main: boolean = false;
    var j: i32 = 0;
    while (j < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[j];
        // `@import` externs are declared by the import section above, not
        // defined here — skip their (empty) body.
        if (f.import_iface.len() > 0) { j = j + 1; continue; }
        // Emit free functions and receiver methods alike; emit_func
        // mangles a method's name to `$<RecvType>__<name>`.
        out = out + emit_func(f, tab, str_funcs, str_arr_funcs, mod.structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets, i64_funcs, mod.funcs, f64_funcs, lam_ctr, lamdefs, [], [], [], [], [], []);
        if (f.receiver_type.len() == 0 && f.name == "main") { has_main = true; }
        j = j + 1;
    }

    if (!has_main) {
        var noparams: parser.ParamDecl[] = [];
        var notp: string[] = [];
        var synth: parser.FuncDecl = parser.FuncDecl {
            name: "main",
            receiver_name: "",
            receiver_type: "",
            type_params: notp,
            params: noparams,
            ret_type: "i32",
            body: mod.top_stmts, line: 0, col: 0,
            import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false
        };
        out = out + emit_func(synth, tab, str_funcs, str_arr_funcs, mod.structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets, i64_funcs, mod.funcs, f64_funcs, lam_ctr, lamdefs, [], [], [], [], [], []);
    }

    // Closure + map-dispatch support: the accumulated lambda functions, the
    // shared call_indirect signature types ($clos<N> = env + N i32 args → i32),
    // the map hash/eq signature types ($fn1 = key→hash, $fn2 = (a,b)→eq — the
    // derived struct/enum-key Hash/Eq dispatch, #2671), and the function table +
    // elem segment indexing the lambdas. map_helpers() emits `call_indirect
    // (type $fn1/$fn2)` for ANY map module (the branch is dead for i32/string
    // keys, but wasm still validates the type + table), so a map-using module
    // with no closures MUST still declare $fn1/$fn2 and a (≥1-slot) table or the
    // module fails to validate — the IR path does this via fn_support_section;
    // this is the AST-path mirror.
    if (lam_ctr.get() > 0 || has_maps) {
        if (lam_ctr.get() > 0) {
            var ai: i32 = 0;
            while (ai <= 8) {
                out = out + "  (type $clos" + util.i32_to_string(ai) + " (func (param i32";
                var pj: i32 = 0;
                while (pj < ai) { out = out + " i32"; pj = pj + 1; }
                out = out + ") (result i32)))\n";
                ai = ai + 1;
            }
        }
        if (has_maps) {
            out = out + "  (type $fn1 (func (param i32) (result i32)))\n";
            out = out + "  (type $fn2 (func (param i32) (param i32) (result i32)))\n";
        }
        out = out + lamdefs.get();
        // A table must exist for any call_indirect to validate. Size it to the
        // lambda set, or a minimal 1 slot when the only indirect calls are the
        // (dead-for-i32/string) map hk/keq ones.
        var tsize: i32 = lam_ctr.get();
        if (tsize == 0) { tsize = 1; }
        out = out + "  (table " + util.i32_to_string(tsize) + " funcref)\n";
        if (lam_ctr.get() > 0) {
            out = out + "  (elem (i32.const 0)";
            var ei: i32 = 0;
            while (ei < lam_ctr.get()) {
                out = out + " $__lambda" + util.i32_to_string(ei);
                ei = ei + 1;
            }
            out = out + ")\n";
        }
    }

    // P6: surface a core export `iface#wit-name` for each `@export` function so
    // the Go world-driven composer lifts it as the named world export
    // (docs/WIT-BRING-YOUR-OWN.md). Additive — no `@export` emits nothing.
    out = out + extern_exports(mod);
    if (component) {
        // Component run entry: export main, and _lang_run = (main() == 0)
        // mapped to the 0=ok / 1=err result the canon lift expects.
        out = out + "  (export \"main\" (func $main))\n";
        out = out + "  (func $_lang_run (result i32) (i32.eqz (i32.eqz (call $main))))\n";
        out = out + "  (export \"_lang_run\" (func $_lang_run)))\n";
    } else {
        out = out + "  (func $_start (call $proc_exit (call $main)))\n";
        out = out + "  (export \"_start\" (func $_start)))\n";
    }
    return out;
}
