// examples/self_host/wasm.fern — the self-hosted WebAssembly emitter.
// Walks a parser.Module and emits a WASI **core module** in the text
// format (WAT) whose `_start` calls `proc_exit(main())` — so
// `wasmtime run prog.wat` exits with main's result, matching the native
// backends' "return value == exit code" contract.
//
// WAT's folded S-expression form makes the lowering a direct recursive
// string build: expressions nest their operands inside the operator
// (no operand-stack bookkeeping), and statements append to a WState
// accumulator that also threads the fresh-label counter and the
// enclosing loop's break/continue labels.
//
// Slice coverage:
//   - integer literals, bool literals, idents (locals)
//   - unary `-` and `!`; binary `+ - * / %`, comparisons
//     (`< <= > >= == !=`), and logical `&& ||`
//   - statements: var/let, assignment, return, if/else, while,
//     break, continue, bare expression
//
// Division / remainder are non-trapping, matching the native backends
// (and internal/codegen/wasmbin/runtime.go): `/` and `%` lower to calls
// to guarded `$__fern_idiv` / `$__fern_irem` helpers (emitted only when
// used) that sanitise the divisor so the hardware op can't fault —
// x / 0 = 0, x % 0 = x, INT_MIN / -1 = INT_MIN, INT_MIN % -1 = 0.
//
// Known gaps (tracked, follow-ups):
//   - `&&` / `||` lower to `i32.and` / `i32.or` (no short-circuit) —
//     correct while conditions are side-effect-free (no calls yet).
//   - function calls, match, for, strings/memory: later slices.

import "core/no_prelude";
import "./parser";

// StrTable interns string-literal payloads as `[len:i32][bytes]` blocks
// in linear memory (the data section); a string VALUE is the i32 pointer
// to its block (the len word). Parallel arrays keyed by the decoded
// string value; `next` is the running placement cursor.
//
// Memory map: the low 24 bytes are scratch — an iovec at 0 (buf@0,
// len@4), fd_write's nwritten slot at 8, a "\n" byte at 12 (for
// `print`), and a temp pointer slot at 16 (for value-based write/print).
// String blocks start at STR_BASE (24); the print_int format buffer
// sits just above all blocks (at tab.next).
struct StrTable { values: string[], offsets: i32[], next: i32 }

function new_str_table(): StrTable {
    return StrTable { values: [], offsets: [], next: 24 };
}

function (t: StrTable) intern(v: string): StrTable {
    var i: i32 = 0;
    while (i < t.values.len()) {
        if (t.values[i] == v) { return t; }
        i = i + 1;
    }
    // Block = 4-byte length prefix + the bytes.
    return StrTable {
        values: t.values.push(v),
        offsets: t.offsets.push(t.next),
        next: t.next + 4 + v.len(),
    };
}

function (t: StrTable) offset_of(v: string): i32 {
    var i: i32 = 0;
    while (i < t.values.len()) {
        if (t.values[i] == v) { return t.offsets[i]; }
        i = i + 1;
    }
    return 24;
}

// Ctx is the read-only emission context threaded through emit_expr: the
// interned string table (tab), the names of string-typed locals/params
// (locals) and string-returning functions (funcs), the `string[]`-typed
// locals (str_arrays) and `string[]`-returning functions (str_arr_funcs),
// and the struct world: the module's struct decls (structs), the
// struct-valued locals (sv_names→sv_types) and struct-returning functions
// (sf_names→sf_types). These drive the string-vs-int decisions for
// `+`/compare, the `arr[i]` element type, and struct field offsets/types.
struct Ctx {
    tab: StrTable,
    locals: string[],
    funcs: string[],
    str_arrays: string[],
    str_arr_funcs: string[],
    structs: parser.StructDecl[],
    sv_names: string[],
    sv_types: string[],
    sf_names: string[],
    sf_types: string[],
    of_names: string[],
    of_payloads: string[],
    ol_names: string[],
    ol_payloads: string[],
    mr_types: string[],
    mr_names: string[],
    mr_rets: string[],
}

// has_method / method_ret look a receiver method (receiver-type T, name n)
// up in the registry (parallel mr_types / mr_names / mr_rets).
function has_method(cx: Ctx, t: string, n: string): boolean {
    var i: i32 = 0;
    while (i < cx.mr_types.len()) {
        if (cx.mr_types[i] == t && cx.mr_names[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}

function method_ret(cx: Ctx, t: string, n: string): string {
    var i: i32 = 0;
    while (i < cx.mr_types.len()) {
        if (cx.mr_types[i] == t && cx.mr_names[i] == n) { return cx.mr_rets[i]; }
        i = i + 1;
    }
    return "";
}

// parse_option_payload extracts the Some/Ok payload type from an
// `Option[T]` / `Result[T, E]` type spelling, or "" otherwise.
function parse_option_payload(t: string): string {
    if (t.len() > 8 && t[0:7] == "Option[" && t[t.len() - 1] == 93) {
        return t[7:t.len() - 1];
    }
    if (t.len() > 8 && t[0:7] == "Result[" && t[t.len() - 1] == 93) {
        var inner: string = t[7:t.len() - 1];
        // First top-level comma separates Ok payload from Err type.
        var i: i32 = 0;
        var depth: i32 = 0;
        while (i < inner.len()) {
            var c: i32 = inner[i];
            if (c == 91) { depth = depth + 1; }
            else if (c == 93) { depth = depth - 1; }
            else if (c == 44 && depth == 0) { return trim_str(inner[0:i]); }
            i = i + 1;
        }
        return trim_str(inner);
    }
    return "";
}

// trim_str strips leading/trailing ASCII spaces.
function trim_str(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && s[a] == 32) { a = a + 1; }
    while (b > a && s[b - 1] == 32) { b = b - 1; }
    return s[a:b];
}

// struct_field_index returns the 0-based field position of `field` in the
// struct named `tn` (the heap offset is index*4), or -1 if not found.
function struct_field_index(structs: parser.StructDecl[], tn: string, field: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) {
            var j: i32 = 0;
            while (j < structs[i].fields.len()) {
                if (structs[i].fields[j].name == field) { return j; }
                j = j + 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// struct_field_count returns the number of fields in struct `tn` (0 if
// unknown).
function struct_field_count(structs: parser.StructDecl[], tn: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) { return structs[i].fields.len(); }
        i = i + 1;
    }
    return 0;
}

// struct_field_type returns the declared type of `field` in struct `tn`
// ("" if unknown).
function struct_field_type(structs: parser.StructDecl[], tn: string, field: string): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) {
            var j: i32 = 0;
            while (j < structs[i].fields.len()) {
                if (structs[i].fields[j].name == field) { return structs[i].fields[j].type_name; }
                j = j + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// lookup_pair returns the value paired with `key` in two parallel arrays
// (keys/vals), or "" if absent.
function lookup_pair(keys: string[], vals: string[], key: string): string {
    var i: i32 = 0;
    while (i < keys.len()) {
        if (keys[i] == key) { return vals[i]; }
        i = i + 1;
    }
    return "";
}

// base_type_name strips a generic argument list from a type spelling:
// `Box[i32]` / `Box[T]` → `Box`. Generics are erased, so the base name is
// what matches the struct table. (A plain `[T]` array type has no base
// ident, so this returns "" for it — harmless, arrays aren't structs.)
function base_type_name(t: string): string {
    var i: i32 = 0;
    while (i < t.len()) {
        if (t[i] == 91) { return t[0:i]; }
        i = i + 1;
    }
    return t;
}

// is_struct_type is true when `t` names a declared struct.
function is_struct_type(structs: parser.StructDecl[], t: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == t) { return true; }
        i = i + 1;
    }
    return false;
}

// struct_id returns a stable runtime type id for a struct (its index in
// the module's struct table), stored at offset 0 of every struct value so
// a union `match` can dispatch on it. -1 if unknown.
function struct_id(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// struct_field_off is the byte offset of field index `idx` in a struct
// value: the type id occupies slot 0, so fields start at 4.
function struct_field_off(idx: i32): i32 {
    return 4 + idx * 4;
}

// struct_type_of resolves the struct type name of an expression, or ""
// when it isn't struct-typed: a struct-valued local/param, a struct
// literal, a struct-returning call, or a struct-typed field of a struct.
function struct_type_of(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprIdent(id) => { return lookup_pair(cx.sv_names, cx.sv_types, id.name); },
        parser.ExprStructLit(sl) => { return sl.type_name; },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return lookup_pair(cx.sf_names, cx.sf_types, id.name); },
                parser.ExprFieldAccess(fa) => {
                    // A receiver method returning a struct.
                    var rt: string = method_ret(cx, struct_type_of(fa.obj, cx), fa.field);
                    if (is_struct_type(cx.structs, rt)) { return rt; }
                    return "";
                },
                _ => { return ""; },
            }
        },
        parser.ExprFieldAccess(fa) => {
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return ""; }
            var ft: string = struct_field_type(cx.structs, ot, fa.field);
            if (is_struct_type(cx.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; },
    }
    return "";
}

// scrutinee_payload returns the Some/Ok payload type of an Option/Result-
// typed expression: a call to an option-returning function, or an
// option-typed local. "" when unknown.
function scrutinee_payload(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // env(name): Option[string] / read_file(path):
                    // Result[string, _] — both Ok/Some payload is string.
                    if (id.name == "env" || id.name == "read_file") { return "string"; }
                    return lookup_pair(cx.of_names, cx.of_payloads, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    // A receiver method returning Option[T] / Result[T,E].
                    return parse_option_payload(method_ret(cx, struct_type_of(fa.obj, cx), fa.field));
                },
                _ => { return ""; },
            }
        },
        parser.ExprIdent(id) => { return lookup_pair(cx.ol_names, cx.ol_payloads, id.name); },
        _ => { return ""; },
    }
    return "";
}

// set_field_offset computes the byte offset for an `obj.field = v`
// desugar (`__set_field(obj, "field", v)`): the field-name string-literal
// arg resolved against obj's struct type.
function set_field_offset(obj: parser.Expr, name_arg: parser.Expr, cx: Ctx): i32 {
    var fname: string = "";
    match (name_arg) {
        parser.ExprString(se) => { fname = se.value; },
        _ => {},
    }
    var idx: i32 = struct_field_index(cx.structs, struct_type_of(obj, cx), fname);
    if (idx < 0) { return 4; }
    return struct_field_off(idx);
}

// WState threads the WAT body being built (out), a fresh-label counter
// (n), the current loop's break / continue labels (brk / cont, "" when
// not inside a loop), and the emission context (cx).
struct WState { out: string, n: i32, brk: string, cont: string, cx: Ctx, fd: i32, md: i32 }

// w appends text to the WAT body. Fern struct fields are immutable, so
// this returns a rebuilt WState (functional update) rather than mutating
// in place. Output here is small (one function body), so `out + text` is
// fine — asm.fern's strbuf optimisation is only needed for the huge
// self-compile bundles.
function (s: WState) w(text: string): WState {
    return WState { ...s, out: s.out + text };
}

// i32_to_string renders an i32 as decimal (used for fresh label
// numbers). Mirrors asm.fern's helper — the self-host doesn't expose an
// `(i32).to_string()` method to emitter code, so each emitter carries
// its own.
function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// hex_digit renders 0..15 as a lowercase hex character.
function hex_digit(d: i32): string {
    if (d == 0) { return "0"; } else if (d == 1) { return "1"; }
    else if (d == 2) { return "2"; } else if (d == 3) { return "3"; }
    else if (d == 4) { return "4"; } else if (d == 5) { return "5"; }
    else if (d == 6) { return "6"; } else if (d == 7) { return "7"; }
    else if (d == 8) { return "8"; } else if (d == 9) { return "9"; }
    else if (d == 10) { return "a"; } else if (d == 11) { return "b"; }
    else if (d == 12) { return "c"; } else if (d == 13) { return "d"; }
    else if (d == 14) { return "e"; } else { return "f"; }
}

// wat_escape renders a string's bytes for a WAT `(data …)` payload:
// printable ASCII passes through (except `"` and `\`), everything else
// becomes a `\HH` hex escape — so embedded newlines / quotes survive.
function wat_escape(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            out = out + s[i:i + 1];
        } else {
            out = out + "\\" + hex_digit(b / 16) + hex_digit(b % 16);
        }
        i = i + 1;
    }
    return out;
}

// le32_escape renders a non-negative i32 as four little-endian bytes in
// WAT `\HH` escape form — the length prefix of a string block.
function le32_escape(n: i32): string {
    var b0: i32 = n % 256;
    var b1: i32 = (n / 256) % 256;
    var b2: i32 = (n / 65536) % 256;
    var b3: i32 = (n / 16777216) % 256;
    return "\\" + hex_digit(b0 / 16) + hex_digit(b0 % 16)
        + "\\" + hex_digit(b1 / 16) + hex_digit(b1 % 16)
        + "\\" + hex_digit(b2 / 16) + hex_digit(b2 % 16)
        + "\\" + hex_digit(b3 / 16) + hex_digit(b3 % 16);
}

// enum_box builds an Option/Result tag box `[tag:i32 @0][payload @4]` as a
// single (block (result i32)) expression, reusing the $__lit<depth> temp.
function enum_box(tag: i32, payload: string, depth: i32): string {
    var ap: string = "$__lit" + i32_to_string(depth);
    var s: string = "(block (result i32)";
    s = s + " (local.set " + ap + " (call $__fern_alloc (i32.const 8)))";
    s = s + " (i32.store (local.get " + ap + ") (i32.const " + i32_to_string(tag) + "))";
    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const 4)) " + payload + ")";
    s = s + " (local.get " + ap + "))";
    return s;
}

// variant_tag maps an Option/Result variant name to its box tag (Some/Ok
// = 0, None/Err = 1), or -1 for a name that isn't a known variant.
function variant_tag(name: string): i32 {
    if (name == "Some" || name == "Ok") { return 0; }
    if (name == "None" || name == "Err") { return 1; }
    return 0 - 1;
}

// wasm_binop maps a Fern operator to its i32 wasm instruction.
function wasm_binop(op: string): string {
    if (op == "+") { return "i32.add"; }
    if (op == "-") { return "i32.sub"; }
    if (op == "*") { return "i32.mul"; }
    // Non-trapping div/rem: lower to the guarded helper calls. The
    // folded form `(call $name <left> <right>)` shares emit_expr's
    // `(<op> <left> <right>)` shape, so no special-casing is needed
    // there.
    if (op == "/") { return "call $__fern_idiv"; }
    if (op == "%") { return "call $__fern_irem"; }
    if (op == "<") { return "i32.lt_s"; }
    if (op == "<=") { return "i32.le_s"; }
    if (op == ">") { return "i32.gt_s"; }
    if (op == ">=") { return "i32.ge_s"; }
    if (op == "==") { return "i32.eq"; }
    if (op == "!=") { return "i32.ne"; }
    if (op == "&&") { return "i32.and"; }
    if (op == "||") { return "i32.or"; }
    return "i32.add";
}

// emit_expr lowers an expression to a folded WAT instruction tree. A
// string value is a pointer (i32) to its `[len:i32][bytes]` block; a
// string literal's value is the constant block offset interned in tab.
function emit_expr(e: parser.Expr, cx: Ctx, depth: i32): string {
    match (e) {
        parser.ExprNumber(n) => {
            return "(i32.const " + n.text + ")";
        },
        parser.ExprBool(b) => {
            if (b.value) { return "(i32.const 1)"; }
            return "(i32.const 0)";
        },
        parser.ExprString(se) => {
            return "(i32.const " + i32_to_string(cx.tab.offset_of(se.value)) + ")";
        },
        parser.ExprIdent(id) => {
            // None is the no-payload Option variant (tag 1).
            if (id.name == "None") { return enum_box(1, "(i32.const 0)", depth); }
            return "(local.get $" + id.name + ")";
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                return "(i32.sub (i32.const 0) " + emit_expr(u.operand, cx, depth) + ")";
            }
            if (u.op == "!") {
                return "(i32.eqz " + emit_expr(u.operand, cx, depth) + ")";
            }
            if (u.op == "try_") {
                // `x?` — unwrap a Some/Ok payload, or early-return the
                // None/Err box from the enclosing function. The box is
                // parked in $__lit<depth>; tag != 0 means None/Err.
                var ap: string = "$__lit" + i32_to_string(depth);
                var s: string = "(block (result i32)";
                s = s + " (local.set " + ap + " " + emit_expr(u.operand, cx, depth + 1) + ")";
                s = s + " (if (i32.ne (i32.load (local.get " + ap + ")) (i32.const 0)) (then (return (local.get " + ap + "))))";
                s = s + " (i32.load (i32.add (local.get " + ap + ") (i32.const 4))))";
                return s;
            }
            return emit_expr(u.operand, cx, depth);
        },
        parser.ExprBinary(b) => {
            // String-typed operands route `+` and the comparisons to the
            // string runtime; integer operands use the i32 ops.
            if (is_string_expr(b.left, cx) || is_string_expr(b.right, cx)) {
                var l: string = emit_expr(b.left, cx, depth);
                var r: string = emit_expr(b.right, cx, depth);
                if (b.op == "+") {
                    return "(call $__fern_strcat " + l + " " + r + ")";
                }
                if (b.op == "==") {
                    return "(call $__fern_streq " + l + " " + r + ")";
                }
                if (b.op == "!=") {
                    return "(i32.eqz (call $__fern_streq " + l + " " + r + "))";
                }
                if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                    return "(" + wasm_binop(b.op) + " (call $__fern_strcmp " + l + " " + r + ") (i32.const 0))";
                }
            }
            return "(" + wasm_binop(b.op) + " " + emit_expr(b.left, cx, depth) + " " + emit_expr(b.right, cx, depth) + ")";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // Option/Result constructors → tag boxes [tag@0][payload@4]:
                    // Some/Ok = tag 0, Err = tag 1 (None is the bare-ident case).
                    if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
                        return enum_box(0, emit_expr(c.args[0], cx, depth + 1), depth);
                    }
                    if (id.name == "Err" && c.args.len() == 1) {
                        return enum_box(1, emit_expr(c.args[0], cx, depth + 1), depth);
                    }
                    // env(name): Option[string] builtin → the wasi
                    // environ runtime helper.
                    if (id.name == "env" && c.args.len() == 1) {
                        return "(call $__fern_env " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // random_bytes(n): u8[] (i32[] of byte values).
                    if (id.name == "random_bytes" && c.args.len() == 1) {
                        return "(call $__fern_random_bytes " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // args(): string[] — the wasi argv vector.
                    if (id.name == "args" && c.args.len() == 0) {
                        return "(call $__fern_args)";
                    }
                    // read_file(path): Result[string, IoError] via wasi.
                    if (id.name == "read_file" && c.args.len() == 1) {
                        return "(call $__fern_read_file " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // Direct call to a free function: `f(a, b)` →
                    // `(call $f <a> <b>)`.
                    var s: string = "(call $" + id.name;
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        s = s + " " + emit_expr(c.args[i], cx, depth);
                        i = i + 1;
                    }
                    return s + ")";
                },
                parser.ExprFieldAccess(fa) => {
                    // `.len()` reads the length word at offset 0 — shared
                    // by string blocks ([len][bytes]) and array blocks
                    // ([len][cap][elems]), so it needs no string/array
                    // discrimination.
                    if (fa.field == "len" && c.args.len() == 0) {
                        return "(i32.load " + emit_expr(fa.obj, cx, depth) + ")";
                    }
                    // `.push(v)` is array-only (strings have no push), so it
                    // needs no type gate. Returns the (possibly grown) array.
                    if (fa.field == "push" && c.args.len() == 1) {
                        return "(call $__fern_arr_push " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + ")";
                    }
                    // `.join(sep)` is the array→string method (string[]
                    // receiver); no string-receiver gate.
                    if (fa.field == "join" && c.args.len() == 1) {
                        return "(call $__fern_str_join " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + ")";
                    }
                    // `.split(sep)` is the string→string[] method.
                    if (fa.field == "split" && c.args.len() == 1 && is_string_expr(fa.obj, cx)) {
                        return "(call $__fern_str_split " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + ")";
                    }
                    // The remaining string methods are string-only.
                    if (is_string_expr(fa.obj, cx)) {
                        var recv: string = emit_expr(fa.obj, cx, depth);
                        if (fa.field == "starts_with" && c.args.len() == 1) {
                            return "(call $__fern_str_startswith " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                        if (fa.field == "ends_with" && c.args.len() == 1) {
                            return "(call $__fern_str_endswith " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                        if (fa.field == "index_of" && c.args.len() == 1) {
                            return "(call $__fern_str_indexof " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                        if (fa.field == "contains" && c.args.len() == 1) {
                            return "(i32.ge_s (call $__fern_str_indexof " + recv + " " + emit_expr(c.args[0], cx, depth) + ") (i32.const 0))";
                        }
                        if (fa.field == "to_upper" && c.args.len() == 0) {
                            return "(call $__fern_str_upper " + recv + ")";
                        }
                        if (fa.field == "to_lower" && c.args.len() == 0) {
                            return "(call $__fern_str_lower " + recv + ")";
                        }
                        if (fa.field == "repeat" && c.args.len() == 1) {
                            return "(call $__fern_str_repeat " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                    }
                    // User receiver method: `obj.m(args)` → static dispatch
                    // to `$<RecvType>__m`, passing the receiver first.
                    var rt: string = struct_type_of(fa.obj, cx);
                    if (rt.len() > 0 && has_method(cx, rt, fa.field)) {
                        var s: string = "(call $" + rt + "__" + fa.field + " " + emit_expr(fa.obj, cx, depth);
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            s = s + " " + emit_expr(c.args[ai], cx, depth);
                            ai = ai + 1;
                        }
                        return s + ")";
                    }
                    return "(i32.const 0)";
                },
                _ => { return "(i32.const 0)"; },
            }
        },
        parser.ExprArray(a) => {
            // Array block: [len:i32 @0][cap:i32 @4][elems @8]. Built in a
            // (block (result i32) …) so it stays a single expression. A
            // depth-indexed temp ($__lit<depth>) holds the fresh pointer
            // while the header + elements are stored; nesting uses a
            // distinct temp per level (children emit at depth+1).
            var ap: string = "$__lit" + i32_to_string(depth);
            var n: i32 = a.elements.len();
            var s: string = "(block (result i32)";
            s = s + " (local.set " + ap + " (call $__fern_alloc (i32.const " + i32_to_string(8 + n * 4) + ")))";
            s = s + " (i32.store (local.get " + ap + ") (i32.const " + i32_to_string(n) + "))";
            s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const 4)) (i32.const " + i32_to_string(n) + "))";
            var i: i32 = 0;
            while (i < n) {
                s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + i32_to_string(8 + i * 4) + ")) " + emit_expr(a.elements[i], cx, depth + 1) + ")";
                i = i + 1;
            }
            s = s + " (local.get " + ap + "))";
            return s;
        },
        parser.ExprIndex(ix) => {
            // arr[i] → load the i32 element at base + 8 + i*4.
            return "(i32.load (i32.add (i32.add " + emit_expr(ix.array, cx, depth) + " (i32.const 8)) (i32.mul " + emit_expr(ix.index, cx, depth) + " (i32.const 4))))";
        },
        parser.ExprStructLit(sl) => {
            // Struct block: type id at slot 0, then one 4-byte slot per
            // declared field. Built in a (block (result i32) …) with a
            // depth-indexed temp, like array literals. With a base
            // (`S { ...base, f: v }`), copy every field from base first,
            // then store the listed overrides.
            var ap: string = "$__lit" + i32_to_string(depth);
            var nf: i32 = struct_field_count(cx.structs, sl.type_name);
            var s: string = "(block (result i32)";
            s = s + " (local.set " + ap + " (call $__fern_alloc (i32.const " + i32_to_string(4 + nf * 4) + ")))";
            s = s + " (i32.store (local.get " + ap + ") (i32.const " + i32_to_string(struct_id(cx.structs, sl.type_name)) + "))";
            if (sl.has_base) {
                var bp: string = emit_expr(sl.base, cx, depth + 1);
                var fi: i32 = 0;
                while (fi < nf) {
                    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + i32_to_string(struct_field_off(fi)) + ")) (i32.load (i32.add " + bp + " (i32.const " + i32_to_string(struct_field_off(fi)) + "))))";
                    fi = fi + 1;
                }
            }
            var i: i32 = 0;
            while (i < sl.field_names.len()) {
                var idx: i32 = struct_field_index(cx.structs, sl.type_name, sl.field_names[i]);
                if (idx >= 0) {
                    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + i32_to_string(struct_field_off(idx)) + ")) " + emit_expr(sl.field_values[i], cx, depth + 1) + ")";
                }
                i = i + 1;
            }
            s = s + " (local.get " + ap + "))";
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Bare field read s.f → load at base + 4 + index*4 (slot 0 is
            // the type id).
            var ot: string = struct_type_of(fa.obj, cx);
            var idx: i32 = struct_field_index(cx.structs, ot, fa.field);
            if (idx < 0) { return "(i32.const 0)"; }
            return "(i32.load (i32.add " + emit_expr(fa.obj, cx, depth) + " (i32.const " + i32_to_string(struct_field_off(idx)) + ")))";
        },
        _ => {
            return "(i32.const 0)";
        },
    }
    return "(i32.const 0)";
}

// is_reserved_local is true for the emitter's internal temp locals, so a
// user var of the same name doesn't get a duplicate (local …) decl.
function is_reserved_local(n: string): boolean {
    if (n == "__lit0" || n == "__lit1" || n == "__lit2" || n == "__lit3") { return true; }
    if (n == "__lit4" || n == "__lit5" || n == "__lit6" || n == "__lit7") { return true; }
    if (n == "__fi0" || n == "__fi1" || n == "__fi2" || n == "__fi3") { return true; }
    if (n == "__fa0" || n == "__fa1" || n == "__fa2" || n == "__fa3") { return true; }
    if (n == "__m0" || n == "__m1" || n == "__m2" || n == "__m3") { return true; }
    return false;
}

// contains_str is a small membership helper for local-name dedup.
function contains_str(xs: string[], n: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}

// collect_locals gathers every `var`/`let` name declared anywhere in a
// statement list (recursing into if / while bodies), deduped — wasm
// requires all locals declared at the top of the function.
function collect_locals(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (!contains_str(acc, v.name)) { acc = acc.push(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_locals(f.then_body, acc);
                acc = collect_locals(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_locals(w.body, acc);
            },
            parser.StmtFor(f) => {
                if (!contains_str(acc, f.var_name)) { acc = acc.push(f.var_name); }
                acc = collect_locals(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if (pv.binding.len() > 0 && pv.binding != "_" && !contains_str(acc, pv.binding)) {
                                acc = acc.push(pv.binding);
                            }
                        },
                        _ => {},
                    }
                    acc = collect_locals(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// expr_uses_divrem is true when an expression contains a `/` or `%`
// anywhere — used to decide whether the guarded helpers need emitting.
function expr_uses_divrem(e: parser.Expr): boolean {
    match (e) {
        parser.ExprBinary(b) => {
            if (b.op == "/" || b.op == "%") { return true; }
            if (expr_uses_divrem(b.left)) { return true; }
            return expr_uses_divrem(b.right);
        },
        parser.ExprUnary(u) => {
            return expr_uses_divrem(u.operand);
        },
        parser.ExprCall(c) => {
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_uses_divrem(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

// stmts_use_divrem recurses a statement list (and nested if/while
// bodies) for any `/` or `%`.
function stmts_use_divrem(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_uses_divrem(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_uses_divrem(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_uses_divrem(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_uses_divrem(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_uses_divrem(f.cond)) { return true; }
                if (stmts_use_divrem(f.then_body)) { return true; }
                if (stmts_use_divrem(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_uses_divrem(w.cond)) { return true; }
                if (stmts_use_divrem(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_uses_divrem(f.iter)) { return true; }
                if (stmts_use_divrem(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_uses_divrem(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_use_divrem(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// divrem_helpers returns the WAT for the guarded div/rem helpers. The
// divisor is sanitised to 1 whenever the real divisor would fault (== 0,
// or the signed INT_MIN / -1 overflow): `a / 1 = a = INT_MIN` gives the
// right overflow quotient and `a % 1 = 0` the right overflow remainder.
// A final `select` substitutes the divide-by-zero answer (0 for div, the
// dividend for rem). Mirrors internal/codegen/wasmbin/runtime.go.
function divrem_helpers(): string {
    var bad: string =
        "(i32.or (i32.eqz (local.get $b))"
        + " (i32.and (i32.eq (local.get $a) (i32.const -2147483648))"
        + " (i32.eq (local.get $b) (i32.const -1))))";
    var out: string = "";
    out = out + "  (func $__fern_idiv (param $a i32) (param $b i32) (result i32)\n";
    out = out + "    (local $safe i32)\n";
    out = out + "    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (i32.const 0) (i32.div_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n";
    out = out + "  (func $__fern_irem (param $a i32) (param $b i32) (result i32)\n";
    out = out + "    (local $safe i32)\n";
    out = out + "    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (local.get $a) (i32.rem_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n";
    return out;
}

// print_int_helper emits the `$__fern_print_int` runtime: format an i32
// as decimal into a 16-byte scratch buffer at `buf` (placed above all
// string data) and fd_write it. Digits are written backwards from the
// buffer end; negatives get a leading '-'. The magnitude is taken with
// unsigned div/rem after a (possibly overflowing) negation, which yields
// the correct digits even for INT_MIN (0 - INT_MIN = INT_MIN, whose
// unsigned value is exactly 2147483648). No trailing newline — matching
// the native print_int.
function print_int_helper(buf: i32): string {
    var b: string = i32_to_string(buf);
    var be: string = i32_to_string(buf + 16);
    var o: string = "";
    o = o + "  (func $__fern_print_int (param $n i32)\n";
    o = o + "    (local $i i32)\n";
    o = o + "    (local $neg i32)\n";
    o = o + "    (if (i32.eqz (local.get $n)) (then\n";
    o = o + "      (i32.store8 (i32.const " + b + ") (i32.const 48))\n";
    o = o + "      (i32.store (i32.const 0) (i32.const " + b + "))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (return)))\n";
    o = o + "    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $n (i32.sub (i32.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $i (i32.const " + be + "))\n";
    o = o + "    (block $done (loop $lp\n";
    o = o + "      (br_if $done (i32.eqz (local.get $n)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10))))\n";
    o = o + "      (local.set $n (i32.div_u (local.get $n) (i32.const 10)))\n";
    o = o + "      (br $lp)))\n";
    o = o + "    (if (local.get $neg) (then\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.const 45))))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $i))\n";
    o = o + "    (i32.store (i32.const 4) (i32.sub (i32.const " + be + ") (local.get $i)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}

// heap_alloc_helpers emits the bump allocator: a `$heap` global starting
// at `heap_base` (above all static data) and `$__fern_alloc` which bumps
// it. Shared by string concat and array allocation.
function heap_alloc_helpers(heap_base: i32): string {
    var o: string = "";
    o = o + "  (global $heap (mut i32) (i32.const " + i32_to_string(heap_base) + "))\n";
    o = o + "  (func $__fern_alloc (param $n i32) (result i32)\n";
    o = o + "    (local $p i32)\n";
    o = o + "    (local.set $p (global.get $heap))\n";
    o = o + "    (global.set $heap (i32.add (global.get $heap) (local.get $n)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// env_helpers emits the wasi environ imports + $__fern_env(name): the
// preview-1 two-call environ pattern (sizes_get then get) into bump-heap
// scratch, a linear scan for a `NAME=` entry, and an Option[string] tag
// box result (Some(value) / None). Value bytes are copied into a fresh
// string block. Uses the iovec scratch (addr 0 / 4) for the two sizes —
// safe because env() completes before any write/print reuses them.
function env_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"environ_sizes_get\" (func $environ_sizes_get (param i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"environ_get\" (func $environ_get (param i32 i32) (result i32)))\n";
    return o;
}

// env_func emits the $__fern_env body (separate from env_helpers so the
// imports can be placed in the import section, before functions).
function env_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_env (param $np i32) (result i32)\n";
    o = o + "    (local $count i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $nlen i32) (local $i i32) (local $e i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local $vstart i32) (local $vlen i32) (local $res i32) (local $tmp i32)\n";
    o = o + "    (local.set $nlen (i32.load (local.get $np)))\n";
    o = o + "    (drop (call $environ_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $count (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $count) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $environ_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $done (loop $cont\n";
    o = o + "      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $md (loop $mc\n";
    o = o + "        (br_if $md (i32.ge_u (local.get $j) (local.get $nlen)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (local.get $e) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $md)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $mc)))\n";
    o = o + "      (if (i32.and (local.get $ok) (i32.eq (i32.load8_u (i32.add (local.get $e) (local.get $nlen))) (i32.const 61))) (then\n";
    o = o + "        (local.set $vstart (i32.add (i32.add (local.get $e) (local.get $nlen)) (i32.const 1)))\n";
    o = o + "        (local.set $vlen (i32.const 0))\n";
    o = o + "        (block $vd (loop $vc\n";
    o = o + "          (br_if $vd (i32.eqz (i32.load8_u (i32.add (local.get $vstart) (local.get $vlen)))))\n";
    o = o + "          (local.set $vlen (i32.add (local.get $vlen) (i32.const 1)))\n";
    o = o + "          (br $vc)))\n";
    o = o + "        (local.set $res (call $__fern_alloc (i32.add (i32.const 4) (local.get $vlen))))\n";
    o = o + "        (i32.store (local.get $res) (local.get $vlen))\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $cd (loop $cc\n";
    o = o + "          (br_if $cd (i32.ge_u (local.get $j) (local.get $vlen)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vstart) (local.get $j))))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $cc)))\n";
    o = o + "        (local.set $tmp (call $__fern_alloc (i32.const 8)))\n";
    o = o + "        (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "        (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
    o = o + "        (return (local.get $tmp))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cont)))\n";
    o = o + "    (local.set $tmp (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// random_helpers / random_func emit the wasi random_get import + the
// $__fern_random_bytes(n) builtin: fill an n-byte wasi buffer and unpack
// each byte into a fresh i32[] array block ([len][cap][elems]).
function random_helpers(): string {
    return "  (import \"wasi_snapshot_preview1\" \"random_get\" (func $random_get (param i32 i32) (result i32)))\n";
}

function random_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
    o = o + "    (local $arr i32) (local $buf i32) (local $i i32)\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.add (i32.const 8) (i32.mul (local.get $n) (i32.const 4)))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $n)))\n";
    o = o + "    (drop (call $random_get (local.get $buf) (local.get $n)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load8_u (i32.add (local.get $buf) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// args_helpers / args_func emit the wasi args imports + $__fern_args():
// the two-call sizes-then-get pattern, building a string[] array whose
// elements are fresh string blocks copied from each NUL-terminated argv
// entry (argv[0] is the program name, matching the native backends).
function args_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"args_sizes_get\" (func $args_sizes_get (param i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"args_get\" (func $args_get (param i32 i32) (result i32)))\n";
    return o;
}

function args_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_args (result i32)\n";
    o = o + "    (local $argc i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $arr i32) (local $i i32) (local $e i32) (local $len i32) (local $j i32) (local $blk i32)\n";
    o = o + "    (drop (call $args_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $argc (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $argc) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $args_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.add (i32.const 8) (i32.mul (local.get $argc) (i32.const 4)))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $argc))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $argc))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $argc)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $len (i32.const 0))\n";
    o = o + "      (block $ld (loop $lc\n";
    o = o + "        (br_if $ld (i32.eqz (i32.load8_u (i32.add (local.get $e) (local.get $len)))))\n";
    o = o + "        (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "        (br $lc)))\n";
    o = o + "      (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "      (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $cd (loop $cc\n";
    o = o + "        (br_if $cd (i32.ge_u (local.get $j) (local.get $len)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $e) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cc)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// readfile_helpers / readfile_func emit the wasi file-read imports +
// $__fern_read_file(path): Result[string, IoError]. Opens the path
// relative to preopen fd 3 (a `--dir` / wasi preopen) via path_open,
// reads to EOF into a fresh string block, and returns Ok(block) (tag 0)
// or Err(errno) (tag 1) on open failure. The rights args are i64 — written
// directly in this hand-authored WAT, independent of the i32 value model.
// Read cap is 64 KiB (enough for the compiler-test files; larger files
// truncate — a follow-up can grow the block).
function readfile_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"path_open\" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"fd_read\" (func $fd_read (param i32 i32 i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"fd_close\" (func $fd_close (param i32) (result i32)))\n";
    return o;
}

function readfile_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_file (param $np i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $blk i32) (local $off i32) (local $n i32) (local $tmp i32)\n";
    // rights_base = FD_READ (2) | FD_SEEK (4) — a valid Rights mask
    // (all-ones is rejected: it sets bits outside the defined Rights set).
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 0) (i64.const 6) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_alloc (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $err))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (i32.const 65536))))\n";
    o = o + "    (local.set $off (i32.const 0))\n";
    o = o + "    (block $rd (loop $rc\n";
    o = o + "      (i32.store (i32.const 0) (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $off)))\n";
    o = o + "      (i32.store (i32.const 4) (i32.sub (i32.const 65536) (local.get $off)))\n";
    o = o + "      (drop (call $fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (local.set $n (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rd (i32.eqz (local.get $n)))\n";
    o = o + "      (local.set $off (i32.add (local.get $off) (local.get $n)))\n";
    o = o + "      (br $rc)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $off))\n";
    o = o + "    (local.set $tmp (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// arr_helpers emits the array runtime: $__fern_arr_push appends v to the
// array, growing geometrically (cap 0 → 4, else ×2) into a fresh block
// and copying the elements when full. Returns the (possibly new) pointer,
// matching `xs = xs.push(v)`. Depends on $__fern_alloc.
function arr_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_push (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $a)))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
    o = o + "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (local.set $ncap (i32.const 4))\n";
    o = o + "    (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))\n";
    o = o + "    (local.set $na (call $__fern_alloc (i32.add (i32.const 8) (i32.mul (local.get $ncap) (i32.const 4)))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// strcat_helpers emits the string runtime (concat / compare / predicate /
// case+repeat). Depends on $__fern_alloc from heap_alloc_helpers.
function strcat_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_strcat (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (i32.add (local.get $la) (local.get $lb)))))\n";
    o = o + "    (i32.store (local.get $p) (i32.add (local.get $la) (local.get $lb)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $da (loop $ca\n";
    o = o + "      (br_if $da (i32.ge_u (local.get $i) (local.get $la)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ca)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.ge_u (local.get $i) (local.get $lb)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $la)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cb)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_streq(a, b): 1 if the two string blocks are byte-equal.
    o = o + "  (func $__fern_streq (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (if (i32.ne (local.get $la) (i32.load (local.get $b))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $la)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_strcmp(a, b): -1 / 0 / 1 lexicographic (unsigned bytes;
    // shorter prefix is less).
    o = o + "  (func $__fern_strcmp (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $n i32) (local $i i32) (local $ca i32) (local $cb i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $n (local.get $la))\n";
    o = o + "    (if (i32.lt_u (local.get $lb) (local.get $la)) (then (local.set $n (local.get $lb))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d2 (loop $c2\n";
    o = o + "      (br_if $d2 (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $ca (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $cb (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.lt_u (local.get $ca) (local.get $cb)) (then (return (i32.const -1))))\n";
    o = o + "      (if (i32.gt_u (local.get $ca) (local.get $cb)) (then (return (i32.const 1))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c2)))\n";
    o = o + "    (if (i32.lt_u (local.get $la) (local.get $lb)) (then (return (i32.const -1))))\n";
    o = o + "    (if (i32.gt_u (local.get $la) (local.get $lb)) (then (return (i32.const 1))))\n";
    o = o + "    (i32.const 0))\n";
    // $__fern_str_startswith(s, p): 1 if s begins with p.
    o = o + "  (func $__fern_str_startswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $lp i32) (local $j i32)\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (i32.load (local.get $s))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_str_endswith(s, p): 1 if s ends with p.
    o = o + "  (func $__fern_str_endswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lp i32) (local $off i32) (local $j i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (local.get $ls)) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $off (i32.sub (local.get $ls) (local.get $lp)))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d3 (loop $c3\n";
    o = o + "      (br_if $d3 (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $off) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c3)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_str_indexof(s, sub): first index of sub in s, or -1
    // (empty sub → 0). Naive O(n*m) scan.
    o = o + "  (func $__fern_str_indexof (param $s i32) (param $sub i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lsub i32) (local $i i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lsub (i32.load (local.get $sub)))\n";
    o = o + "    (if (i32.eqz (local.get $lsub)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.gt_u (local.get $lsub) (local.get $ls)) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $od (loop $oc\n";
    o = o + "      (br_if $od (i32.gt_u (local.get $i) (i32.sub (local.get $ls) (local.get $lsub))))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (block $id (loop $ic\n";
    o = o + "        (br_if $id (i32.ge_u (local.get $j) (local.get $lsub)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sub) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $id)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ic)))\n";
    o = o + "      (if (local.get $ok) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $oc)))\n";
    o = o + "    (i32.const -1))\n";
    // $__fern_str_upper / _lower(s): fresh block, ASCII-cased copy.
    o = o + "  (func $__fern_str_upper (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 97)) (i32.le_u (local.get $ch) (i32.const 122))) (then (local.set $ch (i32.sub (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    o = o + "  (func $__fern_str_lower (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dl (loop $cl\n";
    o = o + "      (br_if $dl (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 65)) (i32.le_u (local.get $ch) (i32.const 90))) (then (local.set $ch (i32.add (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_repeat(s, n): n copies of s in a fresh block.
    o = o + "  (func $__fern_str_repeat (param $s i32) (param $n i32) (result i32)\n";
    o = o + "    (local $l i32) (local $total i32) (local $p i32) (local $k i32) (local $i i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $total (i32.mul (local.get $l) (local.get $n)))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $k (i32.const 0))\n";
    o = o + "    (block $dk (loop $ck\n";
    o = o + "      (br_if $dk (i32.ge_s (local.get $k) (local.get $n)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $di (loop $ci\n";
    o = o + "        (br_if $di (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (i32.mul (local.get $k) (local.get $l)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $ci)))\n";
    o = o + "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
    o = o + "      (br $ck)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_substr(s, start, end): fresh block with s[start:end).
    o = o + "  (func $__fern_substr (param $s i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $len i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_join(a, sep): join the string[] a with sep into one
    // fresh string block.
    o = o + "  (func $__fern_str_join (param $a i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $n i32) (local $sl i32) (local $total i32) (local $i i32) (local $p i32) (local $w i32) (local $elem i32) (local $el i32) (local $j i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $sl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $total (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dt (loop $ct\n";
    o = o + "      (br_if $dt (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $total (i32.add (local.get $total) (i32.load (local.get $elem))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ct)))\n";
    o = o + "    (if (i32.gt_s (local.get $n) (i32.const 0)) (then (local.set $total (i32.add (local.get $total) (i32.mul (local.get $sl) (i32.sub (local.get $n) (i32.const 1)))))))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $w (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dj (loop $cj\n";
    o = o + "      (br_if $dj (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (if (i32.gt_s (local.get $i) (i32.const 0)) (then\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $ds (loop $cs\n";
    o = o + "          (br_if $ds (i32.ge_s (local.get $j) (local.get $sl)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j))))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $cs)))\n";
    o = o + "        (local.set $w (i32.add (local.get $w) (local.get $sl)))))\n";
    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $el (i32.load (local.get $elem)))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $de (loop $ce\n";
    o = o + "        (br_if $de (i32.ge_s (local.get $j) (local.get $el)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $elem) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ce)))\n";
    o = o + "      (local.set $w (i32.add (local.get $w) (local.get $el)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cj)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_split(s, sep): split s on sep into a fresh string[]
    // (built via arr_push). Empty sep → single-element [s].
    o = o + "  (func $__fern_str_split (param $s i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $sl i32) (local $sepl i32) (local $i i32) (local $start i32) (local $arr i32) (local $piece i32) (local $j i32) (local $match i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (local.set $sepl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (if (i32.eqz (local.get $sepl)) (then (return (call $__fern_arr_push (local.get $arr) (local.get $s)))))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $i) (i32.sub (local.get $sl) (local.get $sepl))))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm (loop $cm\n";
    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $sepl)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm)))\n";
    o = o + "      (if (local.get $match) (then\n";
    o = o + "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $i)))\n";
    o = o + "        (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (local.get $sepl)))\n";
    o = o + "        (local.set $start (local.get $i)))\n";
    o = o + "      (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $sl)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// collect_strings_expr interns every string literal reachable from an
// expression into the table.
function collect_strings_expr(e: parser.Expr, t: StrTable): StrTable {
    match (e) {
        parser.ExprString(se) => { return t.intern(se.value); },
        parser.ExprUnary(u) => { return collect_strings_expr(u.operand, t); },
        parser.ExprBinary(b) => {
            t = collect_strings_expr(b.left, t);
            return collect_strings_expr(b.right, t);
        },
        parser.ExprCall(c) => {
            // Walk the callee too — a method call like `"abc".len()`
            // hides its literal in the ExprFieldAccess receiver.
            t = collect_strings_expr(c.callee, t);
            var i: i32 = 0;
            while (i < c.args.len()) {
                t = collect_strings_expr(c.args[i], t);
                i = i + 1;
            }
            return t;
        },
        parser.ExprFieldAccess(fa) => {
            return collect_strings_expr(fa.obj, t);
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                t = collect_strings_expr(a.elements[i], t);
                i = i + 1;
            }
            return t;
        },
        parser.ExprIndex(ix) => {
            t = collect_strings_expr(ix.array, t);
            return collect_strings_expr(ix.index, t);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { t = collect_strings_expr(sl.base, t); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                t = collect_strings_expr(sl.field_values[i], t);
                i = i + 1;
            }
            return t;
        },
        _ => { return t; },
    }
    return t;
}

// collect_strings_stmts recurses a statement list (and nested if/while
// bodies) interning every string literal.
function collect_strings_stmts(body: parser.Stmt[], t: StrTable): StrTable {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { t = collect_strings_expr(v.init, t); },
            parser.StmtAssign(a) => { t = collect_strings_expr(a.value, t); },
            parser.StmtReturn(r) => { t = collect_strings_expr(r.value, t); },
            parser.StmtExpr(e) => { t = collect_strings_expr(e.value, t); },
            parser.StmtIf(f) => {
                t = collect_strings_expr(f.cond, t);
                t = collect_strings_stmts(f.then_body, t);
                t = collect_strings_stmts(f.else_body, t);
            },
            parser.StmtWhile(w) => {
                t = collect_strings_expr(w.cond, t);
                t = collect_strings_stmts(w.body, t);
            },
            parser.StmtFor(f) => {
                t = collect_strings_expr(f.iter, t);
                t = collect_strings_stmts(f.body, t);
            },
            parser.StmtMatch(m) => {
                t = collect_strings_expr(m.scrutinee, t);
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    t = collect_strings_stmts(m.arms[k].body, t);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return t;
}

// write_fixed emits a fd_write of `len` bytes at the constant memory
// address `off` (used for the "\n" byte). The errno result is dropped.
function write_fixed(off: i32, len: i32): string {
    var o: string = "";
    o = o + "    (i32.store (i32.const 0) (i32.const " + i32_to_string(off) + "))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const " + i32_to_string(len) + "))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    return o;
}

// emit_output emits a `write` / `print` of a string VALUE — any
// expression that evaluates to a string pointer (literal, local, param,
// call result). The pointer is parked in the temp slot at addr 16, then
// the iovec is set from the block header: buf = ptr+4, len = load(ptr).
// `print` follows with the "\n" byte at addr 12 (Fern's `print` ==
// println; `write` is verbatim).
function emit_output(name: string, args: parser.Expr[], st: WState): WState {
    if (args.len() != 1) { return st; }
    var ptr: string = emit_expr(args[0], st.cx, 0);
    st = st.w("    (i32.store (i32.const 16) " + ptr + ")\n");
    st = st.w("    (i32.store (i32.const 0) (i32.add (i32.load (i32.const 16)) (i32.const 4)))\n");
    st = st.w("    (i32.store (i32.const 4) (i32.load (i32.load (i32.const 16))))\n");
    st = st.w("    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n");
    if (name == "print") {
        st = st.w(write_fixed(12, 1));
    }
    return st;
}

// emit_stmts lowers a statement list, appending to st.out.
function emit_stmts(body: parser.Stmt[], st: WState): WState {
    var i: i32 = 0;
    while (i < body.len()) {
        st = emit_stmt(body[i], st);
        i = i + 1;
    }
    return st;
}

// emit_stmt lowers a single statement.
function emit_stmt(stmt: parser.Stmt, st: WState): WState {
    match (stmt) {
        parser.StmtVar(v) => {
            return st.w("    (local.set $" + v.name + " " + emit_expr(v.init, st.cx, 0) + ")\n");
        },
        parser.StmtAssign(a) => {
            return st.w("    (local.set $" + a.target + " " + emit_expr(a.value, st.cx, 0) + ")\n");
        },
        parser.StmtReturn(r) => {
            return st.w("    (return " + emit_expr(r.value, st.cx, 0) + ")\n");
        },
        parser.StmtExpr(e) => {
            // write(...) / print(...) are builtins (not user funcs), so
            // intercept them here and emit the fd_write sequence rather
            // than a generic call.
            match (e.value) {
                parser.ExprCall(c) => {
                    match (c.callee) {
                        parser.ExprIdent(id) => {
                            if (id.name == "write" || id.name == "print") {
                                return emit_output(id.name, c.args, st);
                            }
                            if (id.name == "print_int" && c.args.len() == 1) {
                                return st.w("    (call $__fern_print_int " + emit_expr(c.args[0], st.cx, 0) + ")\n");
                            }
                            if (id.name == "__set_index" && c.args.len() == 3) {
                                // arr[idx] = v  (parser desugar). Store v
                                // at arr + 8 + idx*4.
                                return st.w("    (i32.store (i32.add (i32.add " + emit_expr(c.args[0], st.cx, 0) + " (i32.const 8)) (i32.mul " + emit_expr(c.args[1], st.cx, 0) + " (i32.const 4))) " + emit_expr(c.args[2], st.cx, 0) + ")\n");
                            }
                            if (id.name == "__set_field" && c.args.len() == 3) {
                                // obj.field = v  (parser desugar). The
                                // field name is a string literal arg; store
                                // v at obj + index*4.
                                return st.w("    (i32.store (i32.add " + emit_expr(c.args[0], st.cx, 0) + " (i32.const " + i32_to_string(set_field_offset(c.args[0], c.args[1], st.cx)) + ")) " + emit_expr(c.args[2], st.cx, 0) + ")\n");
                            }
                        },
                        _ => {},
                    }
                },
                _ => {},
            }
            return st.w("    (drop " + emit_expr(e.value, st.cx, 0) + ")\n");
        },
        parser.StmtIf(f) => {
            st = st.w("    (if " + emit_expr(f.cond, st.cx, 0) + " (then\n");
            st = emit_stmts(f.then_body, st);
            st = st.w("    )");
            if (f.else_body.len() > 0) {
                st = st.w(" (else\n");
                st = emit_stmts(f.else_body, st);
                st = st.w("    )");
            }
            return st.w(")\n");
        },
        parser.StmtWhile(w) => {
            var id: i32 = st.n;
            var brk: string = "$brk_" + i32_to_string(id);
            var cont: string = "$cont_" + i32_to_string(id);
            // Save the enclosing loop's labels; restore after the body.
            var outer_brk: string = st.brk;
            var outer_cont: string = st.cont;
            // Bump the label counter and enter this loop's label scope.
            var inner: WState = WState {
                ...st,
                out: st.out + "    (block " + brk + " (loop " + cont + "\n"
                    + "    (br_if " + brk + " (i32.eqz " + emit_expr(w.cond, st.cx, 0) + "))\n",
                n: id + 1,
                brk: brk,
                cont: cont,
            };
            inner = emit_stmts(w.body, inner);
            // Restore the enclosing loop's labels; keep accumulated
            // output + the advanced counter.
            return WState {
                ...inner,
                out: inner.out + "    (br " + cont + ")))\n",
                brk: outer_brk,
                cont: outer_cont,
            };
        },
        parser.StmtBreak(_) => {
            return st.w("    (br " + st.brk + ")\n");
        },
        parser.StmtContinue(_) => {
            return st.w("    (br " + st.cont + ")\n");
        },
        parser.StmtFor(f) => {
            // `for v in arr { body }` → index walk. The iterated array is
            // evaluated once into $__fa<d>; $__fi<d> is the index; v is
            // bound to arr[idx] each turn. Depth d (0..3) keeps nested
            // loops from clobbering each other's temps.
            var d: i32 = st.fd;
            var fi: string = "$__fi" + i32_to_string(d);
            var fa: string = "$__fa" + i32_to_string(d);
            var id: i32 = st.n;
            var brk: string = "$fbrk_" + i32_to_string(id);
            var loop: string = "$floop_" + i32_to_string(id);
            // `continue` must still run the index increment, so it
            // branches to the END of a body block (bodycont), after which
            // the increment + loop-back run. `break` branches to brk.
            var bodycont: string = "$fcont_" + i32_to_string(id);
            var outer_brk: string = st.brk;
            var outer_cont: string = st.cont;
            var head: string =
                "    (local.set " + fa + " " + emit_expr(f.iter, st.cx, 0) + ")\n"
                + "    (local.set " + fi + " (i32.const 0))\n"
                + "    (block " + brk + " (loop " + loop + "\n"
                + "    (br_if " + brk + " (i32.ge_s (local.get " + fi + ") (i32.load (local.get " + fa + "))))\n"
                + "    (local.set $" + f.var_name + " (i32.load (i32.add (i32.add (local.get " + fa + ") (i32.const 8)) (i32.mul (local.get " + fi + ") (i32.const 4)))))\n"
                + "    (block " + bodycont + "\n";
            var inner: WState = WState {
                ...st,
                out: st.out + head,
                n: id + 1,
                brk: brk,
                cont: bodycont,
                fd: d + 1,
            };
            inner = emit_stmts(f.body, inner);
            return WState {
                ...inner,
                out: inner.out + "    )\n    (local.set " + fi + " (i32.add (local.get " + fi + ") (i32.const 1)))\n    (br " + loop + ")))\n",
                brk: outer_brk,
                cont: outer_cont,
                fd: d,
            };
        },
        parser.StmtMatch(m) => {
            // Match on an Option/Result tag box: store the scrutinee once
            // in $__m<md>, then for each arm test the tag (load @0), bind
            // the payload (load @4) and run the body, branching to $mend
            // on a match. A wildcard arm runs unconditionally.
            var md: i32 = st.md;
            var mv: string = "$__m" + i32_to_string(md);
            var id: i32 = st.n;
            var mend: string = "$mend_" + i32_to_string(id);
            // Bump label counter + match depth so nested matches / loops
            // inside arm bodies use distinct labels + scrutinee temps.
            st = WState { ...st, n: id + 1, md: md + 1 };
            st = st.w("    (local.set " + mv + " " + emit_expr(m.scrutinee, st.cx, 0) + ")\n");
            st = st.w("    (block " + mend + "\n");
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        // Two dispatch schemes keyed on the variant name:
                        //   Option/Result (Some/Ok/None/Err): tag box —
                        //     compare tag@0, bind payload@4.
                        //   user struct union (type E = A | B): every
                        //     struct value carries its type id@0 — compare
                        //     id@0, bind the value itself.
                        var tag: i32 = variant_tag(pv.type_name);
                        var sid: i32 = struct_id(st.cx.structs, pv.type_name);
                        var nlabel: string = "$marm_" + i32_to_string(id) + "_" + i32_to_string(i);
                        st = st.w("    (block " + nlabel + "\n");
                        if (tag >= 0) {
                            st = st.w("    (br_if " + nlabel + " (i32.ne (i32.load (local.get " + mv + ")) (i32.const " + i32_to_string(tag) + ")))\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                st = st.w("    (local.set $" + pv.binding + " (i32.load (i32.add (local.get " + mv + ") (i32.const 4))))\n");
                            }
                        } else if (sid >= 0) {
                            st = st.w("    (br_if " + nlabel + " (i32.ne (i32.load (local.get " + mv + ")) (i32.const " + i32_to_string(sid) + ")))\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                st = st.w("    (local.set $" + pv.binding + " (local.get " + mv + "))\n");
                            }
                        }
                        st = emit_stmts(m.arms[i].body, st);
                        st = st.w("    (br " + mend + "))\n");
                    },
                    parser.PatWildcard(_) => {
                        st = emit_stmts(m.arms[i].body, st);
                        st = st.w("    (br " + mend + ")\n");
                    },
                }
                i = i + 1;
            }
            st = st.w("    )\n");
            return WState { ...st, md: md };
        },
        _ => {
            // Unsupported statement in this slice — emit nothing.
            return st;
        },
    }
    return st;
}

// is_string_expr decides whether an expression has string type, so the
// `+` operator can pick concat vs add. Conservative + structural: a
// literal, a string-typed local/param, a `+` with a string operand, or
// a call to a string-returning function.
function is_string_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(id) => { return contains_str(cx.locals, id.name); },
        parser.ExprBinary(b) => {
            if (b.op == "+") {
                return is_string_expr(b.left, cx) || is_string_expr(b.right, cx);
            }
            return false;
        },
        parser.ExprIndex(ix) => {
            // arr[i] is string-typed when arr is a string array.
            return is_string_array_expr(ix.array, cx);
        },
        parser.ExprFieldAccess(fa) => {
            // s.f is string-typed when f is a `string` field.
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return struct_field_type(cx.structs, ot, fa.field) == "string";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return contains_str(cx.funcs, id.name); },
                parser.ExprFieldAccess(fa) => {
                    // The string-returning builtin methods.
                    if (fa.field == "to_upper" || fa.field == "to_lower" || fa.field == "repeat") {
                        return is_string_expr(fa.obj, cx);
                    }
                    // join always yields a string (array receiver).
                    if (fa.field == "join") { return true; }
                    // A receiver method declared to return string.
                    return method_ret(cx, struct_type_of(fa.obj, cx), fa.field) == "string";
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_string_array_expr decides whether an expression is a `string[]`: a
// string-typed local/param, an array literal whose elements are strings,
// or a call to a string[]-returning function.
function is_string_array_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.str_arrays, id.name); },
        parser.ExprArray(a) => {
            return a.elements.len() > 0 && is_string_expr(a.elements[0], cx);
        },
        parser.ExprFieldAccess(fa) => {
            // s.f is a string[] when f is a `string[]` field.
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return is_str_array_type(struct_field_type(cx.structs, ot, fa.field));
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // args() returns string[].
                    if (id.name == "args") { return true; }
                    return contains_str(cx.str_arr_funcs, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    // s.split(sep) yields a string[].
                    if (fa.field == "split") { return is_string_expr(fa.obj, cx); }
                    // A receiver method declared to return string[].
                    return is_str_array_type(method_ret(cx, struct_type_of(fa.obj, cx), fa.field));
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_str_array_type is true for the `string[]` annotation (and its
// prefix `[string]`, which the parser normalises to `string[]`).
function is_str_array_type(t: string): boolean {
    return t == "string[]";
}

// collect_str_funcs returns the names of free functions declared to
// return `string` — call results of these are string-typed.
function collect_str_funcs(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].ret_type == "string") {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_str_arr_funcs returns the names of free functions declared to
// return `string[]`.
function collect_str_arr_funcs(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_str_array_type(mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_str_locals walks a function's params + body (in order,
// recursing if/while) collecting the names of string-typed locals: a
// `string` param, or a `var`/`let` whose annotation is `string` or whose
// initialiser is a string expression. Built incrementally so a later
// decl can depend on an earlier string local.
function collect_str_locals_stmts(body: parser.Stmt[], cx: Ctx): Ctx {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                // Option/Result-typed var → track its payload type so a
                // later `match (v)` types the Some/Ok binding.
                var optpay: string = parse_option_payload(v.type_name);
                if (optpay.len() == 0) { optpay = scrutinee_payload(v.init, cx); }
                var styp: string = base_type_name(v.type_name);
                if (!is_struct_type(cx.structs, styp)) { styp = struct_type_of(v.init, cx); }
                if (optpay.len() > 0) {
                    cx = Ctx { ...cx, ol_names: cx.ol_names.push(v.name), ol_payloads: cx.ol_payloads.push(optpay) };
                } else if (is_struct_type(cx.structs, styp)) {
                    cx = Ctx { ...cx, sv_names: cx.sv_names.push(v.name), sv_types: cx.sv_types.push(styp) };
                } else if (is_str_array_type(v.type_name) || is_string_array_expr(v.init, cx)) {
                    cx = Ctx { ...cx, str_arrays: cx.str_arrays.push(v.name) };
                } else if (v.type_name == "string" || is_string_expr(v.init, cx)) {
                    cx = Ctx { ...cx, locals: cx.locals.push(v.name) };
                }
            },
            parser.StmtIf(f) => {
                cx = collect_str_locals_stmts(f.then_body, cx);
                cx = collect_str_locals_stmts(f.else_body, cx);
            },
            parser.StmtWhile(w) => {
                cx = collect_str_locals_stmts(w.body, cx);
            },
            parser.StmtFor(f) => {
                // A `for s in <string[]>` binds s as a string.
                if (is_string_array_expr(f.iter, cx)) {
                    cx = Ctx { ...cx, locals: cx.locals.push(f.var_name) };
                }
                cx = collect_str_locals_stmts(f.body, cx);
            },
            parser.StmtMatch(m) => {
                // Type each Some/Ok arm's binding with the scrutinee's
                // payload type (string / string[] / struct), so the arm
                // body's string/struct operations resolve.
                var pt: string = scrutinee_payload(m.scrutinee, cx);
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if ((pv.type_name == "Some" || pv.type_name == "Ok") && pv.binding.len() > 0 && pv.binding != "_") {
                                if (pt == "string") {
                                    cx = Ctx { ...cx, locals: cx.locals.push(pv.binding) };
                                } else if (is_str_array_type(pt)) {
                                    cx = Ctx { ...cx, str_arrays: cx.str_arrays.push(pv.binding) };
                                } else if (is_struct_type(cx.structs, pt)) {
                                    cx = Ctx { ...cx, sv_names: cx.sv_names.push(pv.binding), sv_types: cx.sv_types.push(pt) };
                                }
                            } else if (is_struct_type(cx.structs, pv.type_name) && pv.binding.len() > 0 && pv.binding != "_") {
                                // Struct-union arm `Variant(b)` binds b to
                                // the value itself, typed as that struct.
                                cx = Ctx { ...cx, sv_names: cx.sv_names.push(pv.binding), sv_types: cx.sv_types.push(pv.type_name) };
                            }
                        },
                        _ => {},
                    }
                    cx = collect_str_locals_stmts(m.arms[k].body, cx);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return cx;
}

function build_ctx(f: parser.FuncDecl, tab: StrTable, funcs: string[], str_arr_funcs: string[], structs: parser.StructDecl[], sf_names: string[], sf_types: string[], of_names: string[], of_payloads: string[], mr_types: string[], mr_names: string[], mr_rets: string[]): Ctx {
    var locals: string[] = [];
    var str_arrays: string[] = [];
    var sv_names: string[] = [];
    var sv_types: string[] = [];
    var ol_names: string[] = [];
    var ol_payloads: string[] = [];
    // A method's receiver is a struct-typed local.
    if (f.receiver_type.len() > 0) {
        sv_names = sv_names.push(f.receiver_name);
        sv_types = sv_types.push(f.receiver_type);
    }
    var i: i32 = 0;
    while (i < f.params.len()) {
        var pop: string = parse_option_payload(f.params[i].type_name);
        if (pop.len() > 0) {
            ol_names = ol_names.push(f.params[i].name);
            ol_payloads = ol_payloads.push(pop);
        } else if (is_str_array_type(f.params[i].type_name)) {
            str_arrays = str_arrays.push(f.params[i].name);
        } else if (is_struct_type(structs, base_type_name(f.params[i].type_name))) {
            // Generic instantiation `Box[i32]` / param `Box[T]` strips to
            // the base struct name `Box`.
            sv_names = sv_names.push(f.params[i].name);
            sv_types = sv_types.push(base_type_name(f.params[i].type_name));
        } else if (f.params[i].type_name == "string") {
            locals = locals.push(f.params[i].name);
        }
        i = i + 1;
    }
    var cx: Ctx = Ctx {
        tab: tab, locals: locals, funcs: funcs, str_arrays: str_arrays, str_arr_funcs: str_arr_funcs,
        structs: structs, sv_names: sv_names, sv_types: sv_types, sf_names: sf_names, sf_types: sf_types,
        of_names: of_names, of_payloads: of_payloads, ol_names: ol_names, ol_payloads: ol_payloads,
        mr_types: mr_types, mr_names: mr_names, mr_rets: mr_rets,
    };
    return collect_str_locals_stmts(f.body, cx);
}

// collect_opt_func_names / _payloads: free functions returning
// Option[T] / Result[T, E], with their Some/Ok payload type T.
function collect_opt_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && parse_option_payload(mod.funcs[i].ret_type).len() > 0) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_method_* build the receiver-method registry (parallel arrays:
// receiver type, method name, return type).
function collect_method_types(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.push(mod.funcs[i].receiver_type); }
        i = i + 1;
    }
    return out;
}

function collect_method_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.push(mod.funcs[i].name); }
        i = i + 1;
    }
    return out;
}

function collect_method_rets(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.push(mod.funcs[i].ret_type); }
        i = i + 1;
    }
    return out;
}

function collect_opt_func_payloads(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0) {
            var p: string = parse_option_payload(mod.funcs[i].ret_type);
            if (p.len() > 0) { out = out.push(p); }
        }
        i = i + 1;
    }
    return out;
}

// collect_struct_funcs returns parallel arrays (names→struct return type)
// for free functions that return a declared struct.
function collect_struct_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_struct_type(mod.structs, mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

function collect_struct_func_types(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_struct_type(mod.structs, mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].ret_type);
        }
        i = i + 1;
    }
    return out;
}

// returns_value is true when a function's declared return type carries
// an i32-shaped value (i32 / boolean / …). The void / unannotated case
// emits no `(result …)` and no fallthrough constant.
function returns_value(ret_type: string): boolean {
    if (ret_type.len() == 0) { return false; }
    if (ret_type == "void") { return false; }
    return true;
}

// emit_func emits one wasm function. Params become wasm params (locals
// 0..n-1, referenced by `$name`); declared `var`/`let` names that aren't
// params become `(local …)` decls. An i32-returning function gets a
// trailing `(i32.const 0)` as the fallthrough result when no `return`
// fires.
function emit_func(f: parser.FuncDecl, tab: StrTable, str_funcs: string[], str_arr_funcs: string[], structs: parser.StructDecl[], sf_names: string[], sf_types: string[], of_names: string[], of_payloads: string[], mr_types: string[], mr_names: string[], mr_rets: string[]): string {
    // A receiver method `function (r: T) m(...)` emits as `$T__m` with the
    // receiver prepended as the first param; a free function as `$name`.
    var fname: string = f.name;
    var pnames: string[] = [];
    var head: string = "  (func $";
    if (f.receiver_type.len() > 0) {
        fname = f.receiver_type + "__" + f.name;
        head = head + fname + " (param $" + f.receiver_name + " i32)";
        pnames = pnames.push(f.receiver_name);
    } else {
        head = head + fname;
    }
    var i: i32 = 0;
    while (i < f.params.len()) {
        head = head + " (param $" + f.params[i].name + " i32)";
        pnames = pnames.push(f.params[i].name);
        i = i + 1;
    }
    var has_result: boolean = returns_value(f.ret_type);
    if (has_result) { head = head + " (result i32)"; }
    head = head + "\n";

    var locals: string[] = collect_locals(f.body, []);
    // Reserved temps (one extra i32 local each, harmless): $__lit<d>
    // holds a fresh array/struct-literal pointer at literal-nesting depth
    // d (0..7); $__fi<d> / $__fa<d> are the loop index and iterated-array
    // pointer for a `for` at nesting depth d (0..3).
    var decls: string = "    (local $__lit0 i32) (local $__lit1 i32) (local $__lit2 i32) (local $__lit3 i32)\n";
    decls = decls + "    (local $__lit4 i32) (local $__lit5 i32) (local $__lit6 i32) (local $__lit7 i32)\n";
    decls = decls + "    (local $__fi0 i32) (local $__fi1 i32) (local $__fi2 i32) (local $__fi3 i32)\n";
    decls = decls + "    (local $__m0 i32) (local $__m1 i32) (local $__m2 i32) (local $__m3 i32)\n";
    decls = decls + "    (local $__fa0 i32) (local $__fa1 i32) (local $__fa2 i32) (local $__fa3 i32)\n";
    var li: i32 = 0;
    while (li < locals.len()) {
        if (!contains_str(pnames, locals[li]) && !is_reserved_local(locals[li])) {
            decls = decls + "    (local $" + locals[li] + " i32)\n";
        }
        li = li + 1;
    }

    var cx: Ctx = build_ctx(f, tab, str_funcs, str_arr_funcs, structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets);
    var st: WState = WState { out: "", n: 0, brk: "", cont: "", cx: cx, fd: 0, md: 0 };
    st = emit_stmts(f.body, st);

    var tail: string = "  )\n";
    if (has_result) { tail = "    (i32.const 0))\n"; }
    return head + decls + st.out + tail;
}

// module_uses_divrem is true when any free function body or the
// top-level statements contain a `/` or `%`.
function module_uses_divrem(mod: parser.Module): boolean {
    if (stmts_use_divrem(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_use_divrem(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_array / stmts_have_array / module_uses_arrays detect array
// literals anywhere, so the bump allocator is emitted for array-only
// programs (no strings).
function expr_has_array(e: parser.Expr): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprUnary(u) => { return expr_has_array(u.operand); },
        parser.ExprBinary(b) => { return expr_has_array(b.left) || expr_has_array(b.right); },
        parser.ExprIndex(ix) => { return expr_has_array(ix.array) || expr_has_array(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_array(fa.obj); },
        parser.ExprCall(c) => {
            if (expr_has_array(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_array(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function stmts_have_array(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_array(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_array(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_array(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_array(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_array(f.cond)) { return true; }
                if (stmts_have_array(f.then_body)) { return true; }
                if (stmts_have_array(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_array(w.cond)) { return true; }
                if (stmts_have_array(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_array(f.iter)) { return true; }
                if (stmts_have_array(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_array(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_array(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_arrays(mod: parser.Module): boolean {
    if (stmts_have_array(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_array(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_struct / stmts_have_struct / module_uses_structs detect struct
// literals (which allocate), so the bump allocator is emitted for
// struct-using programs even without strings or arrays.
function expr_has_struct(e: parser.Expr): boolean {
    match (e) {
        parser.ExprStructLit(_) => { return true; },
        parser.ExprUnary(u) => { return expr_has_struct(u.operand); },
        parser.ExprBinary(b) => { return expr_has_struct(b.left) || expr_has_struct(b.right); },
        parser.ExprIndex(ix) => { return expr_has_struct(ix.array) || expr_has_struct(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_struct(fa.obj); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_has_struct(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            if (expr_has_struct(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_struct(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function stmts_have_struct(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_struct(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_struct(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_struct(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_struct(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_struct(f.cond)) { return true; }
                if (stmts_have_struct(f.then_body)) { return true; }
                if (stmts_have_struct(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_struct(w.cond)) { return true; }
                if (stmts_have_struct(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_struct(f.iter)) { return true; }
                if (stmts_have_struct(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_struct(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_struct(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_structs(mod: parser.Module): boolean {
    if (stmts_have_struct(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_struct(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_option / module_uses_options detect Option/Result constructors
// (Some/Ok/Err calls, the None ident), which allocate a tag box — so the
// bump allocator is emitted for option/result-using programs.
function expr_has_option(e: parser.Expr): boolean {
    match (e) {
        parser.ExprIdent(id) => { return id.name == "None"; },
        parser.ExprUnary(u) => { return expr_has_option(u.operand); },
        parser.ExprBinary(b) => { return expr_has_option(b.left) || expr_has_option(b.right); },
        parser.ExprIndex(ix) => { return expr_has_option(ix.array) || expr_has_option(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_option(fa.obj); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_has_option(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (expr_has_option(sl.field_values[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (variant_tag(id.name) >= 0) { return true; }
                },
                _ => {},
            }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_option(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function stmts_have_option(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_option(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_option(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_option(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_option(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_option(f.cond)) { return true; }
                if (stmts_have_option(f.then_body)) { return true; }
                if (stmts_have_option(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_option(w.cond)) { return true; }
                if (stmts_have_option(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_option(f.iter)) { return true; }
                if (stmts_have_option(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_option(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_option(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_options(mod: parser.Module): boolean {
    if (stmts_have_option(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_option(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_calls / stmts_call / module_calls: does any expression call the
// free builtin named `fn` (by bare ident)? Used to gate runtime helpers
// like env().
function expr_calls(e: parser.Expr, fn: string): boolean {
    match (e) {
        parser.ExprUnary(u) => { return expr_calls(u.operand, fn); },
        parser.ExprBinary(b) => { return expr_calls(b.left, fn) || expr_calls(b.right, fn); },
        parser.ExprIndex(ix) => { return expr_calls(ix.array, fn) || expr_calls(ix.index, fn); },
        parser.ExprFieldAccess(fa) => { return expr_calls(fa.obj, fn); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_calls(a.elements[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (expr_calls(sl.field_values[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { if (id.name == fn) { return true; } },
                _ => {},
            }
            // Recurse the callee too — `args().len()` hides the args()
            // call inside the .len() field-access receiver.
            if (expr_calls(c.callee, fn)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_calls(c.args[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function stmts_call(body: parser.Stmt[], fn: string): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_calls(v.init, fn)) { return true; } },
            parser.StmtAssign(a) => { if (expr_calls(a.value, fn)) { return true; } },
            parser.StmtReturn(r) => { if (expr_calls(r.value, fn)) { return true; } },
            parser.StmtExpr(e) => { if (expr_calls(e.value, fn)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_calls(f.cond, fn)) { return true; }
                if (stmts_call(f.then_body, fn)) { return true; }
                if (stmts_call(f.else_body, fn)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_calls(w.cond, fn)) { return true; }
                if (stmts_call(w.body, fn)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_calls(f.iter, fn)) { return true; }
                if (stmts_call(f.body, fn)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_calls(m.scrutinee, fn)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_call(m.arms[k].body, fn)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_calls(mod: parser.Module, fn: string): boolean {
    if (stmts_call(mod.top_stmts, fn)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_call(mod.funcs[i].body, fn)) { return true; }
        i = i + 1;
    }
    return false;
}

// stmt_calls_print_int / module_uses_print_int detect whether the
// program calls the print_int builtin (statement position; recursing
// if/while bodies), so the helper is emitted only when used.
function stmt_calls_print_int(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtExpr(e) => {
                match (e.value) {
                    parser.ExprCall(c) => {
                        match (c.callee) {
                            parser.ExprIdent(id) => {
                                if (id.name == "print_int") { return true; }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            },
            parser.StmtIf(f) => {
                if (stmt_calls_print_int(f.then_body)) { return true; }
                if (stmt_calls_print_int(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (stmt_calls_print_int(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (stmt_calls_print_int(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmt_calls_print_int(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_print_int(mod: parser.Module): boolean {
    if (stmt_calls_print_int(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmt_calls_print_int(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// emit_module produces the full WAT text for a module: the proc_exit
// import + memory, the guarded div/rem helpers (when used), every free
// function (so calls + recursion + mutual recursion resolve by name),
// and a `_start` that calls `proc_exit(main())`. A program with no
// `main` function (bare top-level statements) synthesises one from the
// module's top statements.
pub function emit_module(mod: parser.Module): string {
    // Intern every string literal in the module into the data section.
    var tab: StrTable = new_str_table();
    tab = collect_strings_stmts(mod.top_stmts, tab);
    var si: i32 = 0;
    while (si < mod.funcs.len()) {
        tab = collect_strings_stmts(mod.funcs[si].body, tab);
        si = si + 1;
    }

    var has_strings: boolean = tab.values.len() > 0;
    var str_funcs: string[] = collect_str_funcs(mod);
    var str_arr_funcs: string[] = collect_str_arr_funcs(mod);
    var sf_names: string[] = collect_struct_func_names(mod);
    var sf_types: string[] = collect_struct_func_types(mod);
    var of_names: string[] = collect_opt_func_names(mod);
    var of_payloads: string[] = collect_opt_func_payloads(mod);
    var mr_types: string[] = collect_method_types(mod);
    var mr_names: string[] = collect_method_names(mod);
    var mr_rets: string[] = collect_method_rets(mod);

    var has_env: boolean = module_calls(mod, "env");
    var has_random: boolean = module_calls(mod, "random_bytes");
    var has_args: boolean = module_calls(mod, "args");
    var has_readfile: boolean = module_calls(mod, "read_file");

    var out: string = "(module\n";
    out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n";
    out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n";
    // wasi imports must sit in the import section (before funcs).
    if (has_env) { out = out + env_helpers(); }
    if (has_random) { out = out + random_helpers(); }
    if (has_args) { out = out + args_helpers(); }
    if (has_readfile) { out = out + readfile_helpers(); }
    // 16 pages (1 MiB) gives the bump heap (string concat) headroom.
    out = out + "  (memory (export \"memory\") 16)\n";
    // Scratch: a "\n" byte at addr 12 (for `print`); the iovec (0,4) and
    // nwritten (8) slots are written at runtime.
    out = out + "  (data (i32.const 12) \"\\0a\")\n";
    // Each literal is a `[len:i32 LE][bytes]` block at its interned
    // offset; the string value is a pointer to the block.
    var di: i32 = 0;
    while (di < tab.values.len()) {
        out = out + "  (data (i32.const " + i32_to_string(tab.offsets[di]) + ") \""
            + le32_escape(tab.values[di].len()) + wat_escape(tab.values[di]) + "\")\n";
        di = di + 1;
    }
    if (module_uses_divrem(mod)) {
        out = out + divrem_helpers();
    }
    // The print_int scratch buffer sits just above all string data.
    if (module_uses_print_int(mod)) {
        out = out + print_int_helper(tab.next);
    }
    // The bump heap (for string concat + array allocation) starts above
    // all static data: past the blocks and the 16-byte print_int buffer.
    var has_arrays: boolean = module_uses_arrays(mod);
    var has_structs: boolean = module_uses_structs(mod);
    var has_options: boolean = module_uses_options(mod);
    if (has_strings || has_arrays || has_structs || has_options || has_env || has_random || has_args || has_readfile) {
        out = out + heap_alloc_helpers(tab.next + 16);
    }
    // The string runtime is needed for string literals AND for the string
    // values that env() / args() produce (which may be method-called /
    // concatenated even with no literal in the program).
    if (has_strings || has_env || has_args || has_readfile) {
        out = out + strcat_helpers();
    }
    // arr_helpers (push) is also needed by string `split`, which builds
    // its result array via $__fern_arr_push — so emit it for strings too.
    if (has_arrays || has_strings || has_env || has_args || has_readfile) {
        out = out + arr_helpers();
    }
    if (has_env) {
        out = out + env_func();
    }
    if (has_random) {
        out = out + random_func();
    }
    if (has_args) {
        out = out + args_func();
    }
    if (has_readfile) {
        out = out + readfile_func();
    }

    var has_main: boolean = false;
    var j: i32 = 0;
    while (j < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[j];
        // Emit free functions and receiver methods alike; emit_func
        // mangles a method's name to `$<RecvType>__<name>`.
        out = out + emit_func(f, tab, str_funcs, str_arr_funcs, mod.structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets);
        if (f.receiver_type.len() == 0 && f.name == "main") { has_main = true; }
        j = j + 1;
    }

    if (!has_main) {
        var noparams: parser.ParamDecl[] = [];
        var synth: parser.FuncDecl = parser.FuncDecl {
            name: "main",
            receiver_name: "",
            receiver_type: "",
            params: noparams,
            ret_type: "i32",
            body: mod.top_stmts,
        };
        out = out + emit_func(synth, tab, str_funcs, str_arr_funcs, mod.structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets);
    }

    out = out + "  (func $_start (call $proc_exit (call $main)))\n";
    out = out + "  (export \"_start\" (func $_start)))\n";
    return out;
}
