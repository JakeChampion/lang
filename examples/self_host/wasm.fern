    o = o + "          (br_if $dn (i32.ge_s (local.get $j) (local.get $ln)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $w)) (i32.load8_u (i32.add (i32.add (local.get $new) (i32.const 4)) (local.get $j))))\n";
    o = o + "          (local.set $w (i32.add (local.get $w) (i32.const 1)))\n";
