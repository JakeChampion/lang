    o = o + "    (if (i32.eqz (local.get $box)) (then (return (local.get $box))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $box) (i32.const 8))) (i32.const 1)) (then\n";
    // String-keyed map (kis@[box+20]==1): release each occupied slot's key
    // (construction-inc'd on insert) before freeing the keys buffer.
    o = o + "      (if (i32.eq (i32.load (i32.add (local.get $box) (i32.const 20))) (i32.const 1)) (then\n";
    o = o + "        (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "        (local.set $keys (i32.load (i32.add (local.get $box) (i32.const 8))))\n";
    o = o + "        (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "        (local.set $i (i32.const 0))\n";
    o = o + "        (block $mkd (loop $mkl\n";
    o = o + "          (br_if $mkd (i32.ge_u (local.get $i) (local.get $cap)))\n";
    o = o + "          (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "            (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $keys) (i32.mul (local.get $i) (i32.const 4))))))))\n";
    o = o + "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "          (br $mkl))))) \n";
    // String-valued map (vis@[box+28]==1): release each occupied slot's value
    // (construction-inc'd on insert) before freeing the vals buffer. Mirrors
    // the key loop + native __drop_map_str_values.
    o = o + "      (if (i32.load (i32.add (local.get $box) (i32.const 28))) (then\n";
    o = o + "        (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "        (local.set $vals (i32.load (i32.add (local.get $box) (i32.const 12))))\n";
    o = o + "        (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "        (local.set $i (i32.const 0))\n";
    o = o + "        (block $mvd (loop $mvl\n";
    o = o + "          (br_if $mvd (i32.ge_u (local.get $i) (local.get $cap)))\n";
    o = o + "          (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "            (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $vals) (i32.mul (local.get $i) (i32.const 4))))))))\n";
    o = o + "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "          (br $mvl))))) \n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 8)))))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 12)))))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 16)))))))\n";
    o = o + "    (call $__fern_arr_dec (local.get $box)))\n";
    return o;
}

// to_string_helpers emits the integer→string runtime backing
// `(n).to_string()` (the desugaring of an f-string interpolant): format
// str_to_i32_helper emits $__fern_str_to_i32: parse a `[len@0][bytes@4]` string
// strbuf_helpers emits the wasm global string-builder runtime (strbuf_reset /
// strbuf_append / strbuf_take) — the wasm sibling of asm_ir's __fern_strbuf_*
// (asm_ir.fern, a .bss buffer). The wasm AST backend never had strbuf, so this
// is authored fresh and the IR path is its only consumer. A growable byte buffer
// lives in the bump heap: $__fern_strbuf_ptr / _len / _cap track it; ensure()
// doubles the capacity (alloc a bigger block + copy, the old one leaks into the
// bump heap, matching the bump-heap norm) when an append would overflow. append
// copies a wasm string's bytes ([s+4 .. s+4+[s]]) onto the buffer; take snapshots
// the buffer into a fresh rc-boxed string ($__fern_str_box: [s]=len, bytes@[s+4])
// and resets len to 0. Heap-backed (str_box / alloc), so emitted only with the
// heap runtime (module_uses_strbuf folds into the heap gate).
pub function strbuf_helpers(): string {
    var o: string = "";
    o = o + "  (global $__fern_strbuf_ptr (mut i32) (i32.const 0))\n";
    o = o + "  (global $__fern_strbuf_len (mut i32) (i32.const 0))\n";
    o = o + "  (global $__fern_strbuf_cap (mut i32) (i32.const 0))\n";
    // reset: clear length (the buffer + capacity persist for reuse).
    o = o + "  (func $__fern_strbuf_reset\n";
    o = o + "    (global.set $__fern_strbuf_len (i32.const 0)))\n";
    // ensure(need): grow the buffer to hold at least `need` total bytes.
    o = o + "  (func $__fern_strbuf_ensure (param $need i32)\n";
    o = o + "    (local $ncap i32) (local $np i32) (local $i i32)\n";
    o = o + "    (if (i32.le_u (local.get $need) (global.get $__fern_strbuf_cap)) (then (return)))\n";
    o = o + "    (local.set $ncap (global.get $__fern_strbuf_cap))\n";
    o = o + "    (if (i32.eqz (local.get $ncap)) (then (local.set $ncap (i32.const 256))))\n";
    o = o + "    (block $gd (loop $gl (br_if $gd (i32.ge_u (local.get $ncap) (local.get $need))) (local.set $ncap (i32.mul (local.get $ncap) (i32.const 2))) (br $gl)))\n";
    o = o + "    (local.set $np (call $__fern_alloc (local.get $ncap)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $cd (loop $cl (br_if $cd (i32.ge_u (local.get $i) (global.get $__fern_strbuf_len)))\n";
    o = o + "      (i32.store8 (i32.add (local.get $np) (local.get $i)) (i32.load8_u (i32.add (global.get $__fern_strbuf_ptr) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $cl)))\n";
    o = o + "    (global.set $__fern_strbuf_ptr (local.get $np))\n";
    o = o + "    (global.set $__fern_strbuf_cap (local.get $ncap)))\n";
    // append(s): copy wasm string s's bytes ([s]=len, bytes@[s+4]) onto the buffer.
    o = o + "  (func $__fern_strbuf_append (param $s i32)\n";
    o = o + "    (local $sl i32) (local $i i32) (local $d i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (call $__fern_strbuf_ensure (i32.add (global.get $__fern_strbuf_len) (local.get $sl)))\n";
    o = o + "    (local.set $d (i32.add (global.get $__fern_strbuf_ptr) (global.get $__fern_strbuf_len)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $ad (loop $al (br_if $ad (i32.ge_u (local.get $i) (local.get $sl)))\n";
    o = o + "      (i32.store8 (i32.add (local.get $d) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $al)))\n";
    o = o + "    (global.set $__fern_strbuf_len (i32.add (global.get $__fern_strbuf_len) (local.get $sl))))\n";
    // take(): snapshot the buffer into a fresh rc-boxed string, reset len to 0.
    o = o + "  (func $__fern_strbuf_take (result i32)\n";
    o = o + "    (local $len i32) (local $box i32) (local $i i32)\n";
    o = o + "    (local.set $len (global.get $__fern_strbuf_len))\n";
    o = o + "    (local.set $box (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $box) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $td (loop $tl (br_if $td (i32.ge_u (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $box) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (global.get $__fern_strbuf_ptr) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $tl)))\n";
    o = o + "    (global.set $__fern_strbuf_len (i32.const 0))\n";
    o = o + "    (local.get $box))\n";
    return o;
}

// block into an i32. Optional leading '-', then decimal digits, stops at the
// first non-digit; empty block → 0. Allocation-free (no heap dependency) — the
// wasm companion to asm_ir's __fn___fern_str_to_i32 (the wasm AST backend had no
// str_to_i32, so this is authored fresh; the IR path is its only consumer).
pub function str_to_i32_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_to_i32 (param $s i32) (result i32)\n";
    o = o + "    (local $len i32) (local $i i32) (local $acc i32) (local $neg i32) (local $c i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $s)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (local.set $acc (i32.const 0))\n";
    o = o + "    (local.set $neg (i32.const 0))\n";
    // optional leading '-' (45): only when there is at least one byte.
    o = o + "    (if (i32.and (i32.gt_s (local.get $len) (i32.const 0)) (i32.eq (i32.load8_u (i32.add (local.get $s) (i32.const 4))) (i32.const 45))) (then\n";
    o = o + "      (local.set $neg (i32.const 1)) (local.set $i (i32.const 1))))\n";
    o = o + "    (block $d (loop $l\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    // stop at the first non-digit (< '0'(48) or > '9'(57)).
    o = o + "      (br_if $d (i32.lt_s (local.get $c) (i32.const 48)))\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $c) (i32.const 57)))\n";
    o = o + "      (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $l)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $acc (i32.sub (i32.const 0) (local.get $acc)))))\n";
    o = o + "    (local.get $acc))\n";
    return o;
}

// chr_helper emits $__fern_chr: an i32 byte value to a fresh 1-char
// `[len@0][bytes@4]` string block (len 1, the low byte at +4). The wasm
// companion to asm_ir's __fn___fern_chr (the wasm AST backend had no chr, so
// this is authored fresh). Depends on $__fern_alloc (module_allocates is pulled
// in by the chr gate alongside this).
pub function chr_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_chr (param $n i32) (result i32)\n";
    o = o + "    (local $blk i32)\n";
    // rc-header the 1-char block via $__fern_str_box (like every other heap
    // string), so a fresh non-escaping `chr(..)` local is reclaimable through
    // $__fern_arr_dec (#2649). The header is transparent to consumers: the block
    // still exposes [len@0][bytes@4] at the returned pointer.
    o = o + "    (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
    o = o + "    (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "    (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}

// an i32 / i64 into a fresh `[len][bytes]` heap block. Depends on
// $__fern_alloc.
pub function to_string_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_i32_to_str (param $n i32) (result i32)\n";
    o = o + "    (local $neg i32) (local $mag i32) (local $len i32) (local $blk i32) (local $p i32)\n";
    o = o + "    (if (i32.eqz (local.get $n)) (then\n";
    // rc-header the "0" block via $__fern_str_box like the general path below, so
    // a fresh `i32_to_string(0)` local is reclaimable through $__fern_arr_dec
    // (#2649) — previously this branch alone returned a header-less block, which
    // a string reclaim would mis-free.
    o = o + "      (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
    o = o + "      (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "      (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 48))\n";
    o = o + "      (return (local.get $blk))))\n";
    o = o + "    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (if (local.get $neg) (then (local.set $mag (i32.sub (i32.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (local.set $p (local.get $mag))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (br_if $cd (i32.eqz (local.get $p)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (local.set $p (i32.div_u (local.get $p) (i32.const 10)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
    o = o + "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $p (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $len)))\n";
    o = o + "    (block $fd (loop $fl\n";
    o = o + "      (br_if $fd (i32.eqz (local.get $mag)))\n";
    o = o + "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $mag) (i32.const 10))))\n";
    o = o + "      (local.set $mag (i32.div_u (local.get $mag) (i32.const 10)))\n";
    o = o + "      (br $fl)))\n";
    o = o + "    (if (local.get $neg) (then (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 45))))\n";
    o = o + "    (local.get $blk))\n";
    // i64 variant (mag / digit math in i64; addresses + length stay i32).
    o = o + "  (func $__fern_i64_to_str (param $n i64) (result i32)\n";
    o = o + "    (local $neg i32) (local $mag i64) (local $len i32) (local $blk i32) (local $p i32)\n";
    o = o + "    (if (i64.eqz (local.get $n)) (then\n";
    o = o + "      (local.set $blk (call $__fern_alloc (i32.const 5)))\n";
    o = o + "      (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "      (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 48))\n";
    o = o + "      (return (local.get $blk))))\n";
    o = o + "    (local.set $neg (i64.lt_s (local.get $n) (i64.const 0)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (if (local.get $neg) (then (local.set $mag (i64.sub (i64.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (br_if $cd (i64.eqz (local.get $mag)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (if (local.get $neg) (then (local.set $mag (i64.sub (i64.const 0) (local.get $n))) (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
    o = o + "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $p (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $len)))\n";
    o = o + "    (block $fd (loop $fl\n";
    o = o + "      (br_if $fd (i64.eqz (local.get $mag)))\n";
    o = o + "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $p) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $mag) (i64.const 10)))))\n";
    o = o + "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
    o = o + "      (br $fl)))\n";
    o = o + "    (if (local.get $neg) (then (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 45))))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}

// string_from_bytes_helper emits $__fern_string_from_bytes(arr): pack a u8[]
// (an i32[] array block `[len][cap][bytes-as-i32]`) into a fresh `[len][bytes]`
// string block, truncating each i32 element to its low byte via i32.store8.
// Depends on $__fern_alloc from heap_alloc_helpers.
pub function string_from_bytes_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_string_from_bytes (param $arr i32) (result i32)\n";
    o = o + "    (local $n i32) (local $s i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $arr)))\n";
    o = o + "    (local.set $s (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
    o = o + "    (i32.store (local.get $s) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i)) (i32.load (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $s))\n";
    return o;
}

// strcat_streq_helpers emits ONLY $__fern_strcat + $__fern_streq — the two
// string helpers the IR path's str_concat / str_eq need. The full
// strcat_helpers bundle (below) also emits strcmp / split / predicate / case
// helpers that pull in array helpers ($__fern_arr_push) the IR runtime does not
// provide, so the IR path emits this narrow subset instead.
// substr_helper emits just $__fern_substr(s, start, end) -> a fresh block with
// s[start:end) copied. Used by the IR path's str_slice op (the full AST runtime
// gets it via strcat_helpers; the IR path emits the narrow strcat_streq_helpers,
// so it pulls substr in separately). Depends only on $__fern_str_box, which the
// heap runtime provides for string programs (module_allocates).
pub function substr_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_substr (param $s i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $len i32) (local $p i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $s))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $len (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// str_predicate_helpers emits the IR-path scalar string search predicates —
// $__fern_str_startswith / _endswith / _indexof — transcribed verbatim from the
// strcat_helpers bundle. All three only read the two string boxes (no
// allocation, no calls), so they're self-contained; the IR path emits them
// gated on module_emits_op(mod, "str_starts_with"|…) rather than pulling in the
// whole AST bundle. `s.contains(sub)` lowers to `(indexof … >= 0)` at the IR
// layer, so it needs only $__fern_str_indexof here.
pub function str_predicate_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_startswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $lp i32) (local $j i32)\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (i32.load (local.get $s))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    o = o + "  (func $__fern_str_endswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lp i32) (local $off i32) (local $j i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (local.get $ls)) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $off (i32.sub (local.get $ls) (local.get $lp)))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d3 (loop $c3\n";
    o = o + "      (br_if $d3 (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $off) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c3)))\n";
    o = o + "    (i32.const 1))\n";
    o = o + "  (func $__fern_str_indexof (param $s i32) (param $sub i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lsub i32) (local $i i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lsub (i32.load (local.get $sub)))\n";
    o = o + "    (if (i32.eqz (local.get $lsub)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.gt_u (local.get $lsub) (local.get $ls)) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $od (loop $oc\n";
    o = o + "      (br_if $od (i32.gt_u (local.get $i) (i32.sub (local.get $ls) (local.get $lsub))))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (block $id (loop $ic\n";
    o = o + "        (br_if $id (i32.ge_u (local.get $j) (local.get $lsub)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sub) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $id)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ic)))\n";
    o = o + "      (if (local.get $ok) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $oc)))\n";
    o = o + "    (i32.const -1))\n";
    return o;
}

// str_case_helpers emits the IR-path ASCII case transforms — $__fern_str_upper /
// _lower, transcribed verbatim from the strcat_helpers bundle. Each allocates a
// fresh block via $__fern_str_box and copies `s` case-flipping ASCII letters; no
// other deps, so they're self-contained. Gated on module_uses_str_case. (The wasm
// runtime symbols are $__fern_str_upper / _lower, distinct from the register
// backends' __fern_str_to_upper / _to_lower.)
pub function str_case_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_upper (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 97)) (i32.le_u (local.get $ch) (i32.const 122))) (then (local.set $ch (i32.sub (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    o = o + "  (func $__fern_str_lower (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dl (loop $cl\n";
    o = o + "      (br_if $dl (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 65)) (i32.le_u (local.get $ch) (i32.const 90))) (then (local.set $ch (i32.add (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// str_repeat_helper emits the IR-path $__fern_str_repeat(s, n) — n copies of `s`
// in a fresh block via $__fern_str_box, transcribed verbatim from the
// strcat_helpers bundle so the IR and AST paths agree byte-for-byte. Gated on
// module_uses_str_repeat.
pub function str_repeat_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_repeat (param $s i32) (param $n i32) (result i32)\n";
    o = o + "    (local $l i32) (local $total i32) (local $p i32) (local $k i32) (local $i i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $total (i32.mul (local.get $l) (local.get $n)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $k (i32.const 0))\n";
    o = o + "    (block $dk (loop $ck\n";
    o = o + "      (br_if $dk (i32.ge_s (local.get $k) (local.get $n)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $di (loop $ci\n";
    o = o + "        (br_if $di (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (i32.mul (local.get $k) (local.get $l)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $ci)))\n";
    o = o + "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
    o = o + "      (br $ck)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// str_trim_helper emits the IR-path $__fern_str_trim(s) — a fresh block with `s`
// stripped of leading/trailing ASCII whitespace (space / tab / '\n' / '\r').
// wasm strings are inline blocks (no zero-copy view like the register backends'
// __fern_str_trim), so it COPIES the trimmed range into a fresh $__fern_str_box;
// the result (content + length) matches the register backends. wasm's AST path
// has no trim, so this is IR-only. Gated on module_uses_str_trim.
pub function str_trim_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_trim (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $start i32) (local $end i32) (local $nl i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (block $df (loop $cf\n";
    o = o + "      (br_if $df (i32.ge_s (local.get $start) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $start))))\n";
    o = o + "      (br_if $df (i32.eqz (i32.or (i32.or (i32.eq (local.get $ch) (i32.const 32)) (i32.eq (local.get $ch) (i32.const 9))) (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.eq (local.get $ch) (i32.const 13))))))\n";
    o = o + "      (local.set $start (i32.add (local.get $start) (i32.const 1)))\n";
    o = o + "      (br $cf)))\n";
    o = o + "    (local.set $end (local.get $l))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.le_s (local.get $end) (local.get $start)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.sub (local.get $end) (i32.const 1)))))\n";
    o = o + "      (br_if $db (i32.eqz (i32.or (i32.or (i32.eq (local.get $ch) (i32.const 32)) (i32.eq (local.get $ch) (i32.const 9))) (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.eq (local.get $ch) (i32.const 13))))))\n";
    o = o + "      (local.set $end (i32.sub (local.get $end) (i32.const 1)))\n";
    o = o + "      (br $cb)))\n";
    o = o + "    (local.set $nl (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $nl))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $nl))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dc (loop $cc\n";
    o = o + "      (br_if $dc (i32.ge_s (local.get $i) (local.get $nl)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cc)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// str_reverse_helper emits the IR-path $__fern_str_reverse(s) — a fresh block
// with `s`'s bytes in reverse order, copied via $__fern_str_box. wasm's AST path
// has no reverse, so this is IR-only. Gated on module_uses_str_reverse.
pub function str_reverse_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_reverse (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $l)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.sub (i32.sub (local.get $l) (local.get $i)) (i32.const 1)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// arr_push_helper emits $__fern_arr_push: append a 4-byte slot (i32 OR a
// pointer — strings are one word on wasm32) to an array, growing the backing
// box (doubling cap) when full. It is the helper the IR `.append` (op
// "arr_push") lowers to, and str_split_helper builds its result array with it.
// The full AST-path arr_helpers bundle is not on the IR path, so this narrow
// helper stands alone there. Depends only on $__fern_arr_box (module_allocates).
pub function arr_push_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_push (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $i i32) (local $rc i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $a)))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
    // #4873/#5325 containment gate (the wasm mirror of asm_ir's
    // .Larr_push_rc_ok): in-place append only for a SOLE-OWNER (rc == 1) or
    // immortal (bit-31, rc < 0 signed) receiver with spare capacity. A shared
    // (rc >= 2) receiver — the caller-side grow bracket inc'd it, or a counted
    // alias exists — takes the copy path even when capacity fits, leaving the
    // shared buffer untouched. Wasm-IR arrays are rc-headered via
    // $__fern_arr_box ([rc@0][bsz@4][len@8][cap@12], data = base+8), so the
    // rc word sits at [a-8]. An unheadered/garbage rc word fails the test and
    // merely takes the copy path — safe, never an in-place mutation.
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $a) (i32.const 8))))\n";
    o = o + "    (if (i32.and (i32.or (i32.eq (local.get $rc) (i32.const 1)) (i32.lt_s (local.get $rc) (i32.const 0))) (i32.lt_s (local.get $len) (local.get $cap))) (then\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    // Copy path: a shared receiver with spare capacity (len < cap) is an
    // UN-SHARE copy — keep the SAME cap instead of doubling (the #3425
    // arena-footprint lesson from the register port). True growth
    // (len >= cap) doubles (or starts at 4).
    o = o + "    (local.set $ncap (local.get $cap))\n";
    o = o + "    (if (i32.ge_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (local.set $ncap (i32.const 4))\n";
    o = o + "      (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $ncap) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// arr_push_owned_helper emits $__fern_arr_push_owned: the sole-owner self-append
// (irlower's !aliased `a = a.append(v)`). Wraps $__fern_arr_push and, iff the push
// GREW (reallocated, result != old), frees the dead old buffer via the shared
// $__fern_arr_dec — which at rc==1 (sole owner) returns the block to its size-class
// freelist, and is a no-op on null / low-addr / SSO / static-sentinel / rc!=1, so
// the owned helper inherits all the defensive gating. Sound only because the emit
// site proved the slot unaliased (no surviving reference to the superseded buffer).
// wasm analog of asm_ir's __fern_arr_push_owned. Depends on $__fern_arr_push +
// $__fern_arr_dec, both co-present whenever arr_push_owned is (module_allocates).
pub function arr_push_owned_helper(heap_base: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var o: string = "";
    o = o + "  (func $__fern_arr_push_owned (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (local $na i32) (local $rc i32)\n";
    o = o + "    (local.set $na (call $__fern_arr_push (local.get $a) (local.get $v)))\n";
    // Superseded-old release, REGISTER PARITY (#5325): free the dead old
    // buffer ONLY when it was the sole owner (rc == 1) — and no-op for any
    // shared (rc >= 2) old, exactly like asm_ir's .Lapo_ret "not sole owner —
    // leave (defensive)" gate. Delegating unconditionally to $__fern_arr_dec
    // DECREMENTED a shared old, eating the caller-side grow bracket's +1: the
    // bracket's own $__fern_arr_dec then freed the caller's still-referenced
    // buffer (the WIT-codec SIGABRT that blocked #5138 — outer's
    // `out = out.append(k)` on a bracketed param, chained tx shape). At
    // rc == 1 the shared $__fern_arr_dec takes its free path, so the sole-
    // owner behaviour is unchanged; guards (null/tagged/low/immortal) ride
    // along inside it.
    o = o + "    (if (i32.and (i32.ne (local.get $na) (local.get $a)) (i32.and (i32.ge_u (local.get $a) (i32.const " + hb + ")) (i32.eqz (i32.and (local.get $a) (i32.const 1))))) (then\n";
    o = o + "      (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "        (drop (call $__fern_arr_dec (local.get $a)))))))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// str_lines_helper emits the IR-path $__fern_str_lines(s) — split s on '\n' then
// drop a trailing empty segment when s is empty or ends with '\n' (so "a\nb\n"
// is 2 lines). Builds a "\n" delim block, calls $__fern_str_split, then
// decrements the result array's len by the trim flag. Depends on
// $__fern_str_split (so the IR runtime also emits str_split_helper + substr_helper
// when lines is used) + $__fern_str_box. wasm AST has no lines, so IR-only. Gated
// on module_uses_str_lines.
pub function str_lines_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_lines (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $trim i32) (local $delim i32) (local $arr i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $trim (i32.const 1))\n";
    o = o + "    (if (i32.ne (local.get $l) (i32.const 0)) (then\n";
    o = o + "      (local.set $trim (i32.eq (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.sub (local.get $l) (i32.const 1)))) (i32.const 10)))))\n";
    o = o + "    (local.set $delim (call $__fern_str_box (i32.const 5)))\n";
    o = o + "    (i32.store (local.get $delim) (i32.const 1))\n";
    o = o + "    (i32.store8 (i32.add (local.get $delim) (i32.const 4)) (i32.const 10))\n";
    o = o + "    (local.set $arr (call $__fern_str_split (local.get $s) (local.get $delim)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.sub (i32.load (local.get $arr)) (local.get $trim)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// str_chars_helper emits the IR-path $__fern_str_chars(s) — a fresh string[]
// whose i-th element is a 1-char string block s[i:i+1]. wasm strings are inline
// blocks, so each char is COPIED into a fresh $__fern_str_box (the register
// backends' __fern_str_chars makes zero-copy views). The result array uses the
// standard [len@0][cap@4][elems@8] layout (via $__fern_arr_box), matching
// str_split's result. wasm's AST path has no chars, so this is IR-only. Gated on
// module_uses_str_chars.
pub function str_chars_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_chars (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $arr i32) (local $i i32) (local $box i32)\n";
