    // ([len][cap][elems]) of the live keys / values, in probe order. count
    // sits at box+0; keys at box+8, vals at box+12 — $src selects which.
    o = o + "  (func $__fern_map_snapshot (param $box i32) (param $src i32) (result i32)\n";
    o = o + "    (local $n i32) (local $arr i32) (local $cap i32) (local $used i32) (local $base i32) (local $i i32) (local $j i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $box)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.add (i32.const 8) (i32.mul (local.get $n) (i32.const 4)))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "    (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "    (local.set $base (i32.load (i32.add (local.get $box) (local.get $src))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $cap)))\n";
    o = o + "      (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "        (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $j) (i32.const 4))) (i32.load (i32.add (local.get $base) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    o = o + "  (func $__fern_map_keys (param $box i32) (result i32)\n";
    o = o + "    (return (call $__fern_map_snapshot (local.get $box) (i32.const 8))))\n";
    o = o + "  (func $__fern_map_values (param $box i32) (result i32)\n";
    o = o + "    (return (call $__fern_map_snapshot (local.get $box) (i32.const 12))))\n";
