    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_str_endswith(s, p): 1 if s ends with p.
    o = o + "  (func $__fern_str_endswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lp i32) (local $off i32) (local $j i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (local.get $ls)) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $off (i32.sub (local.get $ls) (local.get $lp)))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d3 (loop $c3\n";
    o = o + "      (br_if $d3 (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $off) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c3)))\n";
    o = o + "    (i32.const 1))\n";
    // $__fern_str_indexof(s, sub): first index of sub in s, or -1
    // (empty sub → 0). Naive O(n*m) scan.
    o = o + "  (func $__fern_str_indexof (param $s i32) (param $sub i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lsub i32) (local $i i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lsub (i32.load (local.get $sub)))\n";
    o = o + "    (if (i32.eqz (local.get $lsub)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.gt_u (local.get $lsub) (local.get $ls)) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $od (loop $oc\n";
    o = o + "      (br_if $od (i32.gt_u (local.get $i) (i32.sub (local.get $ls) (local.get $lsub))))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (block $id (loop $ic\n";
    o = o + "        (br_if $id (i32.ge_u (local.get $j) (local.get $lsub)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sub) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $id)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ic)))\n";
    o = o + "      (if (local.get $ok) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
