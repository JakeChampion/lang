    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $l) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $l))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $box (call $__fern_str_box (i32.const 5)))\n";
    o = o + "      (i32.store (local.get $box) (i32.const 1))\n";
    o = o + "      (i32.store8 (i32.add (local.get $box) (i32.const 4)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $box))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// str_replace_helper emits the IR-path $__fern_str_replace(h, old, new) — every
// non-overlapping occurrence of `old` in `h` replaced by `new` (empty `old` / no
// match → `h` unchanged). Two-pass (count, then exact-size build into a fresh
// $__fern_str_box), matching the register backends' __fern_str_replace. wasm's
// AST path has no replace, so this is IR-only. Gated on module_uses_str_replace.
