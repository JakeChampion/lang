// examples/self_host/wasm.fern — the self-hosted WebAssembly emitter.
// Walks a parser.Module and emits a WASI **core module** in the text
// format (WAT) whose `_start` calls `proc_exit(main())` — so
// `wasmtime run prog.wat` exits with main's result, matching the native
// backends' "return value == exit code" contract.
//
// WAT's folded S-expression form makes the lowering a direct recursive
// string build: expressions nest their operands inside the operator
// (no operand-stack bookkeeping), and statements append to a WState
// accumulator that also threads the fresh-label counter and the
// enclosing loop's break/continue labels.
//
// Slice coverage:
//   - integer literals, bool literals, idents (locals)
//   - unary `-` and `!`; binary `+ - * / %`, comparisons
//     (`< <= > >= == !=`), and logical `&& ||`
//   - statements: var/let, assignment, return, if/else, while,
//     break, continue, bare expression
//
// Division / remainder are non-trapping, matching the native backends
// (and internal/codegen/wasmbin/runtime.go): `/` and `%` lower to calls
// to guarded `$__fern_idiv` / `$__fern_irem` helpers (emitted only when
// used) that sanitise the divisor so the hardware op can't fault —
// x / 0 = 0, x % 0 = x, INT_MIN / -1 = INT_MIN, INT_MIN % -1 = 0.
//
// Logical `&&` / `||` short-circuit: they lower to a value-producing
// `(if (result i32) L (then R) (else 0))` / `(... (then 1) (else R))`
// so the right operand is only evaluated when the left doesn't already
// decide the result. This keeps guard patterns and calling operands
// (e.g. `m.has(1) && !m.has(2)`, issue #2652) correct — the bare
// `i32.and` / `i32.or` of the binop table is only a fallback that this
// case intercepts first.

import "./parser";
import "./util";
import "./wasm_ir";
import "./irlower";

// StrTable interns string-literal payloads as `[len:i32][bytes]` blocks
// in linear memory (the data section); a string VALUE is the i32 pointer
// to its block (the len word). Parallel arrays keyed by the decoded
// string value; `next` is the running placement cursor.
//
// Memory map: the low 24 bytes are scratch — an iovec at 0 (buf@0,
// len@4), fd_write's nwritten slot at 8, a "\n" byte at 12 (for
// `print`), and a temp pointer slot at 16 (for value-based write/print).
// String blocks start at STR_BASE (24); the print_int format buffer
// sits just above all blocks (at tab.next).
struct StrTable { values: string[], offsets: i32[], next: i32 }

function new_str_table(): StrTable {
    return StrTable { values: [], offsets: [], next: 24 };
}

function (t: StrTable) intern(v: string): StrTable {
    var i: i32 = 0;
    while (i < t.values.len()) {
        if (t.values[i] == v) { return t; }
        i = i + 1;
    }
    // Block = 4-byte length prefix + the bytes.
    return StrTable {
        values: t.values.append(v),
        offsets: t.offsets.append(t.next),
        next: t.next + 4 + v.len(),
    };
}

function (t: StrTable) offset_of(v: string): i32 {
    var i: i32 = 0;
    while (i < t.values.len()) {
        if (t.values[i] == v) { return t.offsets[i]; }
        i = i + 1;
    }
    // A miss means the literal was never interned by the collection
    // pre-pass — a compiler bug. Returning the scratch base (24) here
    // silently pointed the emitted code at the iovec scratch area
    // (SH-008); fail loudly instead.
    eprint("wasm: string literal not interned: " + v);
    exit(1);
    return 0 - 1;
}

// Ctx is the read-only emission context threaded through emit_expr: the
// interned string table (tab), the names of string-typed locals/params
// (locals) and string-returning functions (funcs), the `string[]`-typed
// locals (str_arrays) and `string[]`-returning functions (str_arr_funcs),
// and the struct world: the module's struct decls (structs), the
// struct-valued locals (sv_names→sv_types) and struct-returning functions
// (sf_names→sf_types). These drive the string-vs-int decisions for
// `+`/compare, the `arr[i]` element type, and struct field offsets/types.
struct Ctx {
    tab: StrTable,
    locals: string[],
    funcs: string[],
    str_arrays: string[],
    str_arr_funcs: string[],
    structs: parser.StructDecl[],
    sv_names: string[],
    sv_types: string[],
    sf_names: string[],
    sf_types: string[],
    of_names: string[],
    of_payloads: string[],
    ol_names: string[],
    ol_payloads: string[],
    // ol_err_payloads: parallel to ol_names/ol_payloads — the Result Err type E
    // ("" for an Option / non-Result), so a freed Ok-or-Err box releases the
    // Err payload too when it's rc-tracked.
    ol_err_payloads: string[],
    mr_types: string[],
    mr_names: string[],
    mr_rets: string[],
    // i64-typed locals/params (i64_names) and free functions returning
    // i64 (i64_funcs). Drive the i64-vs-i32 instruction choice for
    // arithmetic / comparison / literals and for emitting i64 locals.
    i64_names: string[],
    i64_funcs: string[],
    // ret_i64 is true while emitting a function whose declared return type
    // is i64 (so `return <literal>;` coerces to i64). mod_funcs is the
    // module's free/method decls, used to coerce call args to i64 params.
    ret_i64: boolean,
    mod_funcs: parser.FuncDecl[],
    // f64 mirror of the i64 fields: float-typed locals/params (f64_names),
    // f64-returning free functions (f64_funcs), and the i64-return flag.
    f64_names: string[],
    f64_funcs: string[],
    ret_f64: boolean,
    // map_names: locals/params holding an i32-keyed map, so `.set` / `.get`
    // / `.has` / `.get_or` on them dispatch to the map runtime.
    map_names: string[],
    // cell_names: locals/params holding a Cell[T] (docs/CELL-TYPE-PLAN.md),
    // so `.get()` / `.set(v)` on them dispatch to the single-slot box ops.
    cell_names: string[],
    // map_str_names: the subset of map_names whose values are strings, so
    // `.get` / `.get_or` results are typed as string.
    map_str_names: string[],
    // map_str_key_names: the subset whose keys are strings (built via
    // map_new, not map_new_i32), so `.keys()` is typed as string[].
    map_str_key_names: string[],
    // mvs_names → mvs_types: map locals whose VALUE type is a struct/enum
    // (inferred from an inserted value's struct_type_of). Drives two things:
    // (1) `.get` / `.get_or` on such a map is typed as that struct so field
    // access resolves (previously the result read 0 — a value bug); and
    // (2) the map's exit sweep routes to the per-type deep release
    // $__fern_map_release_via_<T> (native __drop_map_via_) so each value's
    // fields reclaim, not just the value box.
    mvs_names: string[],
    mvs_types: string[],
    // Tuple locals (tup_names) with a per-element kind string (tup_kinds):
    // one char per element, 's' = string, else 'i'. Drives `t.N` typing.
    tup_names: string[],
    tup_kinds: string[],
    // Per tuple local (parallel to tup_names): a comma-separated list of
    // each element's struct type ("" for non-struct elements), so a
    // `var (a, b) = t` destructure can type a struct element correctly.
    tup_svtypes: string[],
    // Closure support. fn_names: locals/params that hold a closure value
    // (a lambda or an `fn`-typed param), so calling them lowers to
    // call_indirect. lam_ctr / lamdefs are module-wide shared Cells, mutated
    // in place: lam_ctr.get() is the next lambda's table index, lamdefs.get()
    // accumulates the emitted `$__lambda<i>` function texts. arities[0]
    // records which call_indirect param-counts have been used (digits, for
    // emitting the $clos<N> types).
    fn_names: string[],
    lam_ctr: Cell[i32],
    lamdefs: Cell[string],
    // all_locals: every var/param name in the enclosing function — used to
    // decide which free idents in a lambda body are real captures.
    // cap_names: this (lambda) function's captures, in box order, so an
    // ident read resolves to an $__env load at offset 4 + i*4.
    all_locals: string[],
    cap_names: string[],
    // Struct-array locals (sa_names → element struct type sa_types), so
    // `for p in pts { p.field / p.method() }` and `pts[i].field` resolve.
    sa_names: string[],
    sa_types: string[],
    // Tuple-array locals (ta_names): an array whose elements are tuples, with
    // the per-element kind string (ta_kinds) + struct/enum svtype CSV
    // (ta_svtypes) of the element tuple shape — parallel to tup_kinds /
    // tup_svtypes but describing each array element. Drives the deep release
    // of array-of-tuple at exit (native __drop_arr_tuple_): each element tuple
    // box's pointer-bearing elements reclaim before the box + buffer are freed.
    ta_names: string[],
    ta_kinds: string[],
    ta_svtypes: string[],
    // Arrays whose element type is 64-bit (i64[] / f64[]): they use an
    // 8-byte element slot + i64/f64 load/store, vs the 4-byte i32 default.
    // Tracked by local/param name so index / for / push / slice pick the
    // right stride and op.
    i64_arr_names: string[],
    f64_arr_names: string[],
    // The enclosing function's array-return element kind ("i64"/"f64"/
    // "i32"), so `return [<bare literals>]` from an i64[]/f64[] function
    // emits the literal with the right (8-byte) element width.
    ret_arr_kind: string,
    // Perceus array reference-counting (counting milestone, free OFF).
    // arr_swept: body array locals to release (dec) at function exit —
    // the owned-fresh (literal/slice) + bare-ident-alias subset. arr_src:
    // every name that holds an array (params + the above + typed [] vars),
    // used to recognise an alias source at the inc-on-alias site.
    arr_swept: string[],
    arr_src: string[],
    // True when the function returns nothing (void) — a `return` then
    // carries no operand, so the exit-sweep temp dance is skipped.
    ret_void: boolean,
    // True when the function's declared return type is an array — a
    // non-move array result is retained across the exit sweep so a result
    // that aliases a swept local (e.g. `return wcat(o, …)` where wcat
    // returns its borrowed buffer in place) isn't freed under the caller.
    ret_is_array: boolean,
    // Perceus string reference-counting (counting milestone, free OFF).
    // str_swept: body string locals that are OWNED (a fresh concat result
    // or a string literal) or a bare-ident alias — released (rc dec, no
    // free yet) at function exit. Static literals are guard-no-ops; heap
    // concats balance their inc-on-alias. Borrowed sources (params, field /
    // index reads, get_or, method results) are conservatively NOT swept.
    str_swept: string[],
    // True when the function's declared return type is `string` — a
    // non-move string result is retained across the exit sweep (so a result
    // aliasing a swept string local isn't freed under the caller).
    ret_is_string: boolean,
    // Perceus tuple reference-counting (counting milestone, free OFF).
    // tup_swept: body tuple locals (a fresh tuple literal, or a bare-ident
    // alias) released at function exit. Like strings, a tuple is a flat rc
    // box; recursive element-release rides on this when free is flipped on.
    tup_swept: string[],
    // True when the function returns a tuple (`(T, …)`) — a non-move tuple
    // result is retained across the exit sweep.
    ret_is_tuple: boolean,
    // Perceus struct/enum reference-counting (counting milestone, free OFF).
    // struct_swept: body struct/enum-value locals that are OWNED (a fresh
    // struct literal, a variant / unit-variant / enum-constant box, a
    // struct-returning call) or a bare-ident alias — released (rc dec, no
    // free yet) at function exit. A struct is rc-boxed like a flat tuple;
    // recursive field-release rides on this when free is flipped on. Borrowed
    // sources (params, field / index reads) are conservatively NOT swept.
    struct_swept: string[],
    // Perceus Option/Result reference-counting (counting milestone, free OFF).
    // opt_swept: body Option/Result-value locals (in ol_names) that are OWNED
    // (a Some/Ok/Err / None construction, an option-returning call, or a
    // bare-ident alias) — released (rc dec, no free yet) at function exit. A
    // variant box is rc-boxed flat ([tag@0][payload@4]); the Some/Ok-payload
    // recursive release rides on this when free is flipped on. Borrowed sources
    // (params, field / index reads) are conservatively NOT swept.
    opt_swept: string[],
    // Perceus map reference-counting (counting milestone, free OFF). map_swept:
    // body map locals that are OWNED (a `map_new[_i32]`-rooted construction /
    // `.insert` chain, or a bare-ident alias) — released (rc dec, no free yet)
    // at function exit. The map box is rc-boxed; the key/value-array + string
    // key/value release rides on this when free is flipped on. A map mutated in
    // place (`m = m.insert(…)`) returns the SAME box, so it stays one owned
    // local; borrowed params are NOT swept.
    map_swept: string[],
    // Perceus closure reference-counting. clos_swept: body closure locals
    // bound directly to a lambda literal (`var f = function(…){…}`) — an
    // OWNED, freshly rc-boxed env block. Freed (rc dec → box reclaim) at
    // function exit, excluding a move-on-return slot. The env is now rc-boxed
    // via $__fern_str_box (header at [box-8]; table_idx@0 + captures@4+i*4
    // unchanged), so its box reclaims; per-capture release rides on this in a
    // later slice (captures still leak one level here — sound). Only
    // lambda-literal bindings are swept; closure-returning calls, aliases, and
    // bare function-name values are NOT (leak, sound).
    clos_swept: string[],
    // Parallel to clos_swept: the precomputed per-capture release snippet for
    // each closure local (rc==1-gated release of its rc-tracked captures via
    // capture_release_op). "" when the closure has no rc-tracked captures.
    // Balances the capture construction-inc done at the lambda's build site.
    clos_caps: string[],
}

// func_param_is_i64 is true when free function `fn`'s parameter at index
// `idx` is declared i64 — so a call site coerces that argument to i64.
function func_param_is_i64(cx: Ctx, fn: string, idx: i32): boolean {
    var i: i32 = 0;
    while (i < cx.mod_funcs.len()) {
        if (cx.mod_funcs[i].receiver_type.len() == 0 && cx.mod_funcs[i].name == fn) {
            if (idx < cx.mod_funcs[i].params.len()) {
                return cx.mod_funcs[i].params[idx].type_name == "i64";
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// is_zero_arg_func is true when `name` is a free, zero-parameter function
// (e.g. a `const` desugar) — a bare reference to it lowers to a call.
function is_zero_arg_func(cx: Ctx, name: string): boolean {
    return zero_arg_func_ret(cx, name).len() > 0;
}

// zero_arg_func_ret returns the declared return type of a free, zero-arg
// function `name` ("__void__" when it returns nothing, "" when there is no
// such function) — drives const-reference typing.
function zero_arg_func_ret(cx: Ctx, name: string): string {
    var i: i32 = 0;
    while (i < cx.mod_funcs.len()) {
        if (cx.mod_funcs[i].receiver_type.len() == 0 && cx.mod_funcs[i].name == name && cx.mod_funcs[i].params.len() == 0) {
            if (cx.mod_funcs[i].ret_type.len() == 0) { return "__void__"; }
            return cx.mod_funcs[i].ret_type;
        }
        i = i + 1;
    }
    return "";
}

// is_const_ref is true for a bare ident naming a zero-arg free function
// (a `const`) that isn't shadowed by a local of the same name.
function is_const_ref(cx: Ctx, name: string): boolean {
    return !contains_str(cx.all_locals, name) && is_zero_arg_func(cx, name);
}

// func_param_is_f64 is the f64 analogue of func_param_is_i64.
function func_param_is_f64(cx: Ctx, fn: string, idx: i32): boolean {    var i: i32 = 0;
    while (i < cx.mod_funcs.len()) {
        if (cx.mod_funcs[i].receiver_type.len() == 0 && cx.mod_funcs[i].name == fn) {
            if (idx < cx.mod_funcs[i].params.len()) {
                return is_float_type(cx.mod_funcs[i].params[idx].type_name);
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// expr_map_rooted is true for an expression whose value is a fresh map:
// a `map_new_i32(n)` call or a `.insert(…)` chain over one. Used at
// var-collection time (no Ctx available yet) to seed map_names.
function expr_map_rooted(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "map_new_i32" || id.name == "map_new"; },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "insert") { return expr_map_rooted(fa.obj); }
                    return false;
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_map_expr is true when `e` denotes an i32-keyed map at emit time: a
// map-rooted expression or a tracked map-typed local/param.
function is_map_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.map_names, id.name); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "map_new_i32" || id.name == "map_new"; },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "insert") { return is_map_expr(fa.obj, cx); }
                    return false;
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_cell_new_call is true when `e` is a `cell_new(v)` call.
function is_cell_new_call(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "cell_new"; },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_cell_expr is true when `e` denotes a Cell — a cell_new(...) call, a
// tracked cell-typed local/param, or a struct FIELD whose declared type is
// Cell[...] (docs/CELL-TYPE-PLAN.md). The field case resolves the owner
// struct via struct_type_of, then checks the field's declared type — so
// `cx.lam_ctr.get()` on a `lam_ctr: Cell[i32]` field dispatches as a cell,
// matching the asm/ssa backends (whose Ty-based detection already handles
// fields).
function is_cell_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.cell_names, id.name); },
        parser.ExprFieldAccess(fa) => {
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return util.base_type_name(struct_field_type(cx.structs, ot, fa.field)) == "Cell";
        },
        _ => { return is_cell_new_call(e); },
    }
    return false;
}

// collect_cell_var_names gathers `var`/`let` names initialised with a
// cell_new(...) call (recursing nested bodies).
function collect_cell_var_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (is_cell_new_call(v.init) && !contains_str(acc, v.name)) { acc = acc.append(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_cell_var_names(f.then_body, acc);
                acc = collect_cell_var_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => { acc = collect_cell_var_names(w.body, acc); },
            parser.StmtFor(f) => { acc = collect_cell_var_names(f.body, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_cell_var_names(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => { },
        }
        i = i + 1;
    }
    return acc;
}

// collect_map_var_names gathers `var`/`let` names whose initialiser is a
// map-rooted expression (recursing nested bodies).
function collect_map_var_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (expr_map_rooted(v.init) && !contains_str(acc, v.name)) { acc = acc.append(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_map_var_names(f.then_body, acc);
                acc = collect_map_var_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => { acc = collect_map_var_names(w.body, acc); },
            parser.StmtFor(f) => { acc = collect_map_var_names(f.body, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_map_var_names(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// is_str_val_map is true when `e` denotes a map whose values are strings:
// a tracked string-valued map local, or a `.set` chain that stores a
// string value (so `Map { "k": "v" }.get(...)` is typed without a local).
function is_str_val_map(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.map_str_names, id.name); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if ((fa.field == "insert") && c.args.len() == 2) {
                        if (is_string_expr(c.args[1], cx)) { return true; }
                        return is_str_val_map(fa.obj, cx);
                    }
                    return false;
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// set_chain_has_str: does a map-rooted `.set` chain store any string value?
function set_chain_has_str(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if ((fa.field == "insert") && c.args.len() == 2) {
                        if (is_string_expr(c.args[1], cx)) { return true; }
                        return set_chain_has_str(fa.obj, cx);
                    }
                    return false;
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// collect_str_val_map_names returns the subset of map_names whose values
// are strings, found by scanning every `var`/assignment that builds the
// map (init chain or `m = m.insert(k, "…")`) for a string-typed set value.
// Run after string locals are known so is_string_expr is accurate.
function collect_str_val_map_names(body: parser.Stmt[], cx: Ctx, map_names: string[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (contains_str(map_names, v.name) && !contains_str(acc, v.name) && set_chain_has_str(v.init, cx)) {
                    acc = acc.append(v.name);
                }
            },
            parser.StmtAssign(a) => {
                if (contains_str(map_names, a.target) && !contains_str(acc, a.target) && set_chain_has_str(a.value, cx)) {
                    acc = acc.append(a.target);
                }
            },
            parser.StmtIf(f) => {
                acc = collect_str_val_map_names(f.then_body, cx, map_names, acc);
                acc = collect_str_val_map_names(f.else_body, cx, map_names, acc);
            },
            parser.StmtWhile(w) => { acc = collect_str_val_map_names(w.body, cx, map_names, acc); },
            parser.StmtFor(f) => { acc = collect_str_val_map_names(f.body, cx, map_names, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_str_val_map_names(m.arms[k].body, cx, map_names, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// map_val_struct_type: the struct/enum VALUE type of a map expression ("" if
// not a tracked struct-valued map) — a tracked map local, or a `.insert` chain
// whose set value is a struct (so a struct-valued map literal types too).
function map_val_struct_type(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprIdent(id) => { return lookup_pair(cx.mvs_names, cx.mvs_types, id.name); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if ((fa.field == "insert") && c.args.len() == 2) {
                        var st: string = struct_type_of(c.args[1], cx);
                        if (st.len() > 0) { return st; }
                        return map_val_struct_type(fa.obj, cx);
                    }
                    return "";
                },
                _ => { return ""; },
            }
        },
        _ => { return ""; },
    }
    return "";
}

// set_chain_val_struct_type: the struct/enum type of a value stored in a
// map-rooted `.insert` chain ("" if none / non-struct). Mirrors
// set_chain_has_str but returns the value's struct_type_of so a struct-valued
// map can be recognised + typed.
function set_chain_val_struct_type(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if ((fa.field == "insert") && c.args.len() == 2) {
                        var st: string = struct_type_of(c.args[1], cx);
                        if (st.len() > 0) { return st; }
                        return set_chain_val_struct_type(fa.obj, cx);
                    }
                    return "";
                },
                _ => { return ""; },
            }
        },
        _ => { return ""; },
    }
    return "";
}

// map_val_struct_type_for finds the `var name = <chain>` / `name = <chain>`
// that builds map `name` and returns its struct/enum value type ("" if none).
// Driven per mvs name so the names/types arrays stay parallel.
function map_val_struct_type_for(body: parser.Stmt[], name: string, cx: Ctx): string {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (v.name == name) {
                    var t: string = set_chain_val_struct_type(v.init, cx);
                    if (t.len() > 0) { return t; }
                }
            },
            parser.StmtAssign(a) => {
                if (a.target == name) {
                    var t: string = set_chain_val_struct_type(a.value, cx);
                    if (t.len() > 0) { return t; }
                }
            },
            parser.StmtIf(f) => {
                var t: string = map_val_struct_type_for(f.then_body, name, cx);
                if (t.len() > 0) { return t; }
                var e2: string = map_val_struct_type_for(f.else_body, name, cx);
                if (e2.len() > 0) { return e2; }
            },
            parser.StmtWhile(w) => {
                var t: string = map_val_struct_type_for(w.body, name, cx);
                if (t.len() > 0) { return t; }
            },
            parser.StmtFor(f) => {
                var t: string = map_val_struct_type_for(f.body, name, cx);
                if (t.len() > 0) { return t; }
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    var t: string = map_val_struct_type_for(m.arms[k].body, name, cx);
                    if (t.len() > 0) { return t; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return "";
}

// collect_struct_val_map_names: map locals whose set-chain stores a struct/enum
// value. collect_struct_val_map_types maps each (parallel) to its value type.
function collect_struct_val_map_names(body: parser.Stmt[], cx: Ctx, map_names: string[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (contains_str(map_names, v.name) && !contains_str(acc, v.name) && set_chain_val_struct_type(v.init, cx).len() > 0) {
                    acc = acc.append(v.name);
                }
            },
            parser.StmtAssign(a) => {
                if (contains_str(map_names, a.target) && !contains_str(acc, a.target) && set_chain_val_struct_type(a.value, cx).len() > 0) {
                    acc = acc.append(a.target);
                }
            },
            parser.StmtIf(f) => {
                acc = collect_struct_val_map_names(f.then_body, cx, map_names, acc);
                acc = collect_struct_val_map_names(f.else_body, cx, map_names, acc);
            },
            parser.StmtWhile(w) => { acc = collect_struct_val_map_names(w.body, cx, map_names, acc); },
            parser.StmtFor(f) => { acc = collect_struct_val_map_names(f.body, cx, map_names, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_struct_val_map_names(m.arms[k].body, cx, map_names, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

function collect_struct_val_map_types(body: parser.Stmt[], names: string[], cx: Ctx): string[] {
    var acc: string[] = [];
    var i: i32 = 0;
    while (i < names.len()) {
        acc = acc.append(map_val_struct_type_for(body, names[i], cx));
        i = i + 1;
    }
    return acc;
}

// map_root_is_str: does a map-rooted expression's constructor select
// string keys (map_new) rather than i32 keys (map_new_i32)?
function map_root_is_str(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "map_new"; },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "insert") { return map_root_is_str(fa.obj); }
                    return false;
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_str_key_map is true when `e` denotes a string-keyed map: a tracked
// map_str_key_names local, or a string-keyed constructor / `.set` chain.
function is_str_key_map(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.map_str_key_names, id.name); },
        _ => { return map_root_is_str(e); },
    }
    return false;
}

// collect_str_key_map_names returns the subset of map_names built with a
// string-keyed constructor (map_new), found by scanning the map-building
// `var` / assignment for each.
function collect_str_key_map_names(body: parser.Stmt[], map_names: string[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (contains_str(map_names, v.name) && !contains_str(acc, v.name) && map_root_is_str(v.init)) {
                    acc = acc.append(v.name);
                }
            },
            parser.StmtAssign(a) => {
                if (contains_str(map_names, a.target) && !contains_str(acc, a.target) && map_root_is_str(a.value)) {
                    acc = acc.append(a.target);
                }
            },
            parser.StmtIf(f) => {
                acc = collect_str_key_map_names(f.then_body, map_names, acc);
                acc = collect_str_key_map_names(f.else_body, map_names, acc);
            },
            parser.StmtWhile(w) => { acc = collect_str_key_map_names(w.body, map_names, acc); },
            parser.StmtFor(f) => { acc = collect_str_key_map_names(f.body, map_names, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_str_key_map_names(m.arms[k].body, map_names, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// collect_fn_var_names gathers `var f = function(...) {...}` binding names
// (closure-valued locals), recursing nested bodies. `fnrets` lists the
// free functions whose return type is `fn` (a closure) so a binding
// `var f = make_adder(5)` is recognised as a closure-valued local too;
// `fnmeths` does the same for receiver methods (`var f = obj.make()`).
// collect_fn_arr_names lists locals declared with the `fn[]` type (an
// array of closures), so an element read binds a closure.
function collect_fn_arr_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (v.type_name == "fn[]" && !contains_str(acc, v.name)) { acc = acc.append(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_fn_arr_names(f.then_body, acc);
                acc = collect_fn_arr_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => { acc = collect_fn_arr_names(w.body, acc); },
            parser.StmtFor(f) => { acc = collect_fn_arr_names(f.body, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_fn_arr_names(m.arms[k].body, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// ty_spelling_is_array reports whether a declared type spelling names an
// array type — i.e. ends in the two-char "[]" suffix (i32[] / string[] /
// Foo[] / i32[][]). Generic spellings like Map[K,V] / Box[T] end in "]"
// but not "[]", so they are correctly excluded.
function ty_spelling_is_array(t: string): boolean {
    if (t.len() < 2) { return false; }
    return t[t.len() - 2:t.len()] == "[]";
}

// init_is_owned_array: the init expression yields a freshly-owned array
// (rc 1) — an array literal or a slice (which copies into a new block).
function init_is_owned_array(e: parser.Expr): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprSlice(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// insert_val_is_array: does a map `.insert` value expr yield an rc-boxed array
// (any element type)? Drives the map value rc-flag (vis) so an array value is
// construction-inc'd + reclaimed one level (arr_dec frees the buffer — complete
// for i32[]/i64[]/f64[]; a string[]/struct[] value's elements leak one level,
// sound). A scalar / string value never matches here (handled separately), so
// the flat arr_dec on death can't corrupt a non-pointer. Covers the common
// insert forms: array literal, non-substring slice, an arr_src-tracked ident.
function insert_val_is_array(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprSlice(sl) => { return !is_string_expr(e, cx); },
        parser.ExprIdent(id) => { return contains_str(cx.arr_src, id.name); },
        _ => { return false; },
    }
    return false;
}

// init_is_owned_string: the init produces a fresh, OWNED heap string (rc 1)
// — a concatenation (`a + b`, a $__fern_str_box block) — or an immortal
// string literal (data-section; the rc helpers' address guard no-ops it).
// Borrowed string sources (field/index reads, get_or, method results) are
// excluded for now (conservative: they leak, sound while free is off).
function init_is_owned_string(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        parser.ExprBinary(b) => { return b.op == "+" && is_string_expr(e, cx); },
        parser.ExprSlice(_) => { return is_string_expr(e, cx); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => { if (fa.field == "get_or") { return false; } },
                _ => {},
            }
            return is_string_expr(e, cx);
        },
        _ => { return false; }
    }
    return false;
}

// ret_value_is_borrowed reports whether a returned array/string value is a
// BORROWED reference the function must retain for the caller — a field
// access (`obj.field`), an index read (`arr[i]`), or a bare ident (a
// borrowed param, or a non-move local that aliases something it doesn't
// own). A fresh literal / concat / slice / call result is already owned, so
// it is NOT retained (re-retaining would leak). Move-on-return swept locals
// are filtered out separately (by the mov/smov exclusion) before this runs.
function ret_value_is_borrowed(e: parser.Expr): boolean {
    match (e) {
        // Definitely fresh & uniquely owned — never retained (would leak):
        parser.ExprArray(_) => { return false; },     // array literal
        parser.ExprString(_) => { return false; },    // string literal
        parser.ExprBinary(_) => { return false; },    // concat
        parser.ExprSlice(_) => { return false; },     // slice/substr (copy)
        // Everything else may alias/borrow — a field/index read, a borrowed
        // param ident, or a CALL that returns its borrowed arg in place
        // (`return wcat(o, …)`), so retain to hand the caller ownership.
        _ => { return true; }
    }
    return true;
}

// init_is_string_alias: the init is a bare ident naming an existing string
// (an alias to retain — the inc site).
function init_is_string_alias(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(_) => { return is_string_expr(e, cx); },
        _ => { return false; }
    }
    return false;
}

// collect_str_swept gathers body string locals to release at function exit:
// those bound to an owned string (concat / literal) or a bare-ident alias.
// comma destructures are skipped. Uses cx (string locals already known) so
// is_string_expr resolves alias sources.
function collect_str_swept(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (init_is_owned_string(v.init, cx) || init_is_string_alias(v.init, cx)) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_str_swept(f.then_body, cx, acc);
                acc = collect_str_swept(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_str_swept(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_str_swept(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_str_swept(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// str_exit_sweep emits the string release sweep: a release ($__fern_arr_dec
// — strings are flat, so the shared array dec frees them at rc 1 into the
// size-class freelist) of every owned string local, EXCEPT `excl` (the
// move-on-return slot, handed to the caller at its current rc). Pass "" to
// sweep all. A literal slot is a guard no-op (data-section address); a heap
// string at rc 1 is freed.
function str_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.str_swept.len()) {
        if (cx.str_swept[i] != excl) {
            o = o + "    (drop (call $__fern_arr_dec (local.get $" + cx.str_swept[i] + ")))\n";
        }
        i = i + 1;
    }
    return o;
}

function str_exit_sweep(cx: Ctx): string {
    return str_exit_sweep_excl(cx, "");
}

// init_is_owned_tuple / init_is_tuple_alias: a `var t = (…)` tuple literal
// is a fresh owned rc box; a `var u = t` bare-ident alias of a tracked
// tuple local retains it. (Borrowed sources — params, field/index reads —
// are conservatively not swept.)
function init_is_owned_tuple(e: parser.Expr): boolean {
    match (e) {
        parser.ExprTuple(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

function init_is_tuple_alias(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.tup_names, id.name); },
        _ => { return false; }
    }
    return false;
}

// collect_tup_swept gathers body tuple locals to release at exit (an owned
// tuple literal or a bare-ident tuple alias). Uses cx (tuple locals known).
function collect_tup_swept(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (init_is_owned_tuple(v.init) || init_is_tuple_alias(v.init, cx)) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_tup_swept(f.then_body, cx, acc);
                acc = collect_tup_swept(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_tup_swept(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_tup_swept(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_tup_swept(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// tup_exit_sweep_excl emits the tuple release sweep with RECURSIVE field
// release. For each owned tuple local (except `excl`, the move-on-return
// slot): if this is the LAST owner (rc word at [t-8] == 1, i.e. the box is
// about to be freed) first release the rc-tracked ('a' array / 's' string)
// elements — read from the tuple's compile-time kind string — then free the
// box via the shared $__fern_arr_dec. The rc==1 guard ensures the elements
// are released exactly once, on the final free (an aliased tuple at rc>1
// just decrements). A scalar ('i') element is skipped. Elements nested in
// other containers are released only when freed at THIS sweep (a tuple
// freed indirectly via arr_dec leaks its elements — sound, a known gap).
// tuple_release_inner builds the WAT that releases the pointer-bearing
// elements of a single tuple box rooted at `base` (a WAT expr yielding the
// box pointer). Shared by the tuple-local sweep and the array-of-tuple deep
// release. A struct/enum element (kind 'i' but carrying an svtype) recurses
// through its $__fern_release_ fn; 's' string / 'a' scalar-array → flat
// arr_dec; 'A' pointer-element array → arr_dec_ptr (one level). Scalar 'i'
// elements are skipped.
function tuple_release_inner(base: string, kinds: string, svcsv: string, cx: Ctx): string {
    var inner: string = "";
    var e: i32 = 0;
    while (e < kinds.len()) {
        var load: string = "(i32.load (i32.add " + base + " (i32.const " + util.i32_to_string(e * 4) + ")))";
        var svt: string = nth_csv_elem(svcsv, e);
        if (svt.len() > 0 && (is_struct_type(cx.structs, svt) || (is_enum_type_name(cx, svt) && svt != "Option" && svt != "Result"))) {
            inner = inner + " (drop (call $__fern_release_" + svt + " " + load + "))";
        } else if (kinds[e] == 97 || kinds[e] == 115) {
            inner = inner + " (drop (call $__fern_arr_dec " + load + "))";
        } else if (kinds[e] == 65) {
            inner = inner + " (drop (call $__fern_arr_dec_ptr " + load + "))";
        }
        e = e + 1;
    }
    return inner;
}

function tup_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.tup_swept.len()) {
        var name: string = cx.tup_swept[i];
        if (name != excl) {
            var kinds: string = lookup_pair(cx.tup_names, cx.tup_kinds, name);
            var svcsv: string = lookup_pair(cx.tup_names, cx.tup_svtypes, name);
            var inner: string = tuple_release_inner("(local.get $" + name + ")", kinds, svcsv, cx);
            if (inner.len() > 0) {
                // Null-guard: a conditionally-unassigned tuple local is 0; the
                // inline `[t-8]` rc-read would fault at address -8.
                o = o + "    (if (local.get $" + name + ") (then (if (i32.eq (i32.load (i32.sub (local.get $" + name + ") (i32.const 8))) (i32.const 1)) (then" + inner + "))))\n";
            }
            o = o + "    (drop (call $__fern_arr_dec (local.get $" + name + ")))\n";
        }
        i = i + 1;
    }
    return o;
}

function tup_exit_sweep(cx: Ctx): string {
    return tup_exit_sweep_excl(cx, "");
}

// init_is_owned_struct: the init produces a FRESH or MOVED struct/enum value
// the local owns — a struct literal, a struct-returning call (incl. a
// positional variant constructor and a struct-returning method/function), a
// bare 0-field unit variant (`Nil`/`Empty`), or an enum constant
// (`Color.Green`). A struct field / index read is BORROWED, not owned
// (handled by the return-retain path, never swept). Alias detection is
// separate (init_is_struct_alias).
function init_is_owned_struct(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprStructLit(_) => { return true; },
        parser.ExprCall(_) => { return struct_type_of(e, cx).len() > 0; },
        parser.ExprIdent(id) => {
            return is_struct_type(cx.structs, id.name) && struct_field_count(cx.structs, id.name) == 0;
        },
        parser.ExprFieldAccess(fa) => {
            // An enum constant (`Color.Green`): obj isn't struct-typed but the
            // field names a variant — a fresh box. A real field read
            // (`s.field`, obj struct-typed) is borrowed, not owned.
            return struct_type_of(fa.obj, cx).len() == 0 && is_struct_type(cx.structs, fa.field);
        },
        _ => { return false; },
    }
    return false;
}

// init_is_struct_alias: a bare-ident reference to a struct-valued local/param
// (a co-owner to retain — the inc site), excluding unit variants (those are
// fresh boxes handled as owned, not aliased).
function init_is_struct_alias(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => {
            if (is_struct_type(cx.structs, id.name)) { return false; }
            return lookup_pair(cx.sv_names, cx.sv_types, id.name).len() > 0;
        },
        _ => { return false; },
    }
    return false;
}

// collect_struct_swept gathers body struct/enum-value locals to release at
// exit: an owned struct (init_is_owned_struct) or a bare-ident alias
// (init_is_struct_alias). Comma destructures are skipped. Uses cx (struct
// locals already known) so alias sources resolve.
function collect_struct_swept(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (init_is_owned_struct(v.init, cx) || init_is_struct_alias(v.init, cx)) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_struct_swept(f.then_body, cx, acc);
                acc = collect_struct_swept(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_struct_swept(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_struct_swept(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_struct_swept(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// struct_field_kind_char classifies a struct field TYPE for recursive
// release: 'a' array, 's' string, 'S' rc-boxed struct / enum / tuple (freed
// one level — the nested value's OWN fields leak, a sound known gap), 'i'
// scalar / unprovable (SKIPPED). Soundness is asymmetric and critical: a
// false 'a'/'s'/'S' on a scalar field would $__fern_arr_dec a raw integer
// (corruption for a large even value above heap_base), so the classifier is
// EXACT for the pointer cases and defaults everything else to 'i' (a missed
// pointer field just leaks, never corrupts).
function struct_field_kind_char(ft: string, cx: Ctx): string {
    if (ty_spelling_is_array(ft)) { return "a"; }
    if (ft == "string") { return "s"; }
    if (ft.len() > 0 && ft[0] == 40) { return "S"; }
    if (is_struct_type(cx.structs, ft)) { return "S"; }
    if (is_enum_type_name(cx, ft)) { return "S"; }
    return "i";
}

// array_field_elem_is_ptr: for an array field type "T[]", is the ELEMENT T an
// rc-boxed pointer (string / struct / enum / tuple / nested array)? Drives
// whether a struct's array field is deep-released ($__fern_arr_dec_ptr, which
// releases the elements) or freed flat ($__fern_arr_dec — for i32/i64/f64
// scalar elements, which must NOT be dec'd as pointers).
function array_field_elem_is_ptr(ft: string, cx: Ctx): boolean {
    if (!ty_spelling_is_array(ft)) { return false; }
    return struct_field_kind_char(ft[0:ft.len() - 2], cx) != "i";
}

// emit_wasm_struct_drop_body returns the WAT for $__struct_drop_<t>(box) -> box —
// the wasm sibling of asm_ir.emit_ir_struct_drop_one (Perceus slice 1c). For each
// ARRAY field (struct_field_kind_char == "a") it releases the field BUFFER via
// $__fern_arr_dec_ptr (pointer-element array — releases ITS elements too, the
// deep walk encapsulated in the helper) or $__fern_arr_dec (scalar-element array
// — flat free). Both rc-guard (only free at rc==1) and null-/literal-guard
// internally, so no explicit uniqueness or null check is needed. Non-array rc
// fields (string / nested struct) are skipped — a later slice, matching the
// register backends' array-only struct_drop. The field offset is the IR
// struct layout (`8 + i*8` — an 8-byte header then 8-byte slots, matching
// wasm_ir's struct_make / struct_get / struct_set), NOT the AST `struct_field_off`
// (`4 + i*4`): this body runs on the IR path, where the box is laid out by the IR
// emitter. A pointer field is stored as i32 in the low 4 bytes of its 8-byte slot,
// so an `i32.load` at the slot offset recovers the buffer pointer. Returns box
// (the call site drops it).
// emit_ir_rc_bodies returns the per-type $__field_reclaim_<T> + $__struct_drop_<T>
// helper-function definitions for the IR path (#3457, Perceus slices 1c/1d):
// field_reclaim frees a superseded rc-array field buffer on a consume-rebind and
// frees the old box via $__fern_snapshot_dec; struct_drop deep-drops a struct's
// rc fields at scope exit (incl. the Perceus slice-3 nested-struct deep-drop).
// Both share one release ctx. Shared by emit_module's IR orchestration AND the
// differential wasm_ir_run driver, so the driver emits the SAME definitions for
// every `call $__struct_drop_<T>` / `call $__field_reclaim_<T>` the lowered IR
// inserts — without this the driver linked against undefined helpers and any
// struct program with a deep-drop trapped (`unknown func $__struct_drop_<T>`).
pub function emit_ir_rc_bodies(mod: parser.Module, cache: irlower.LowerResult[]): string {
    var out: string = "";
    var rc_cx: Ctx = release_module_ctx(mod.structs, collect_method_types(mod), mod.funcs);
    // #4355: replaced-STRING-field admission — the wasm IR driver is
    // single-module whole-program, so mod.funcs is the full read scope
    // (see irlower.strfld_reclaim_ok_types_of).
    var sfok: string[] = irlower.strfld_reclaim_ok_types_of(mod.funcs, mod.structs);
    var frt: string[] = wasm_ir.field_reclaim_types(cache);
    var frti: i32 = 0;
    while (frti < frt.len()) {
        out = out + emit_wasm_field_reclaim_body(frt[frti], rc_cx, wasm_ir.heap_base_for(cache), util.index_of_str(sfok, frt[frti]) >= 0, util.index_of_str(sfok, "clo:" + frt[frti]) >= 0);
        frti = frti + 1;
    }
    // #5235: plain-fn-pointer-array field markers ("FNPTR:<sty>.<field>") — a
    // registered field is buffer-only-freed (its elements are raw code addresses).
    var fpk: string[] = irlower.fnptr_arr_fields_of(mod.funcs, mod.structs);
    var sdt: string[] = wasm_ir.struct_drop_types(cache, mod.structs);
    var sdti: i32 = 0;
    while (sdti < sdt.len()) {
        out = out + emit_wasm_struct_drop_body(sdt[sdti], rc_cx, util.index_of_str(sfok, sdt[sdti]) >= 0, util.index_of_str(sfok, "clo:" + sdt[sdti]) >= 0, fpk);
        sdti = sdti + 1;
    }
    // Per-element-type array deep-drop helpers (#2649): $__struct_arr_elems_drop_<E>
    // for each struct-array element type E reachable from a struct_drop type. Emitted
    // after the struct_drop bodies they call (order is irrelevant for wasm funcs, but
    // struct_drop_types already added each E so $__struct_drop_<E> exists).
    var aet: string[] = wasm_ir.struct_arr_elems_drop_types(cache, mod.structs);
    var aeti: i32 = 0;
    while (aeti < aet.len()) {
        out = out + emit_wasm_struct_arr_elems_drop_body(aet[aeti], rc_cx);
        aeti = aeti + 1;
    }
    return out;
}

// emit_wasm_struct_arr_elems_drop_body returns the WAT for
// $__struct_arr_elems_drop_<E>(buf) -> buf — the wasm sibling of
// asm_ir.emit_ir_struct_arr_elems_drop_one (#2649 array-element deep-drop). For a
// uniquely-owned buffer it walks the elements and, per uniquely-owned element box,
// calls $__struct_drop_<E> to release the element's OWN rc fields — the level the
// shallow $__fern_arr_dec_ptr walk leaked. It frees neither the element boxes nor the
// buffer; the caller's arr_dec_ptr (emitted right after) still does that. $__fern_rc_is_unique
// null-/low-/sentinel-guards internally, so a shared buffer or element is skipped.
// wasm32 array layout: len at buf[0], element i at buf+8+i*4 (4-byte pointers), rc at buf-8.
function emit_wasm_struct_arr_elems_drop_body(e: string, cx: Ctx): string {
    var o: string = "  (func $__struct_arr_elems_drop_" + e + " (param $buf i32) (result i32)\n";
    o = o + "    (local $i i32) (local $n i32) (local $e i32)\n";
    o = o + "    (if (call $__fern_rc_is_unique (local.get $buf)) (then\n";
    o = o + "      (local.set $n (i32.load (local.get $buf)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $saed_done (loop $saed_lp\n";
    o = o + "        (br_if $saed_done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (local.set $e (i32.load (i32.add (i32.add (local.get $buf) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "        (if (call $__fern_rc_is_unique (local.get $e)) (then\n";
    o = o + "          (drop (call $__struct_drop_" + e + " (local.get $e)))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $saed_lp))))) \n";
    o = o + "    (local.get $buf))\n";
    return o;
}

function emit_wasm_struct_drop_body(t: string, cx: Ctx, str_ok: boolean, clo_ok: boolean, fnptr_fields: string[]): string {
    var o: string = "  (func $__struct_drop_" + t + " (param $box i32) (result i32)\n";
    var si: i32 = 0;
    while (si < cx.structs.len()) {
        if (cx.structs[si].name == t) {
            var k: i32 = 0;
            while (k < cx.structs[si].fields.len()) {
                var ft: string = cx.structs[si].fields[k].type_name;
                // #5235: a registered plain-fn-pointer array field — its elements
                // are RAW code addresses, so it must NOT be walked as a pointer
                // array ($__fern_arr_dec_ptr releases each element as a box →
                // SIGSEGV). Free the BUFFER only (flat $__fern_arr_dec, no element
                // walk); the buffer is a real rc box the struct owns at rc=1, so
                // this frees it once (the wasm sibling of the register backends'
                // k_fnptr arm).
                var fnptr_here: boolean = util.has_str(fnptr_fields, "FNPTR:" + t + "." + cx.structs[si].fields[k].name);
                if (struct_field_kind_char(ft, cx) == "a" && fnptr_here) {
                    var fpload: string = "(i32.load offset=" + util.i32_to_string(8 + k * 8) + " (local.get $box))";
                    o = o + "    (drop (call $__fern_arr_dec " + fpload + "))\n";
                } else if (struct_field_kind_char(ft, cx) == "a") {
                    var load: string = "(i32.load offset=" + util.i32_to_string(8 + k * 8) + " (local.get $box))";
                    // MULTI-LEVEL array-element deep-drop (#2649): a struct-ARRAY field
                    // `X[]` whose element struct X is deep-drop-ok releases each element's
                    // OWN rc fields via $__struct_arr_elems_drop_X BEFORE arr_dec_ptr frees
                    // the element boxes + buffer. Enum-array elements have no $__struct_drop,
                    // so they keep the plain arr_dec_ptr (one level).
                    if (irlower.is_struct_array_field_type(cx.structs, ft)) {
                        var elem_ty: str = ft[0 : ft.len() - 2];
                        if (irlower.nested_field_deep_drop_ok(cx.structs, elem_ty)) {
                            o = o + "    (drop (call $__struct_arr_elems_drop_" + elem_ty + " " + load + "))\n";
                        }
                    }
                    if (array_field_elem_is_ptr(ft, cx)) {
                        o = o + "    (drop (call $__fern_arr_dec_ptr " + load + "))\n";
                    } else {
                        o = o + "    (drop (call $__fern_arr_dec " + load + "))\n";
                    }
                } else if (is_struct_type(cx.structs, ft)) {
                    var sload: string = "(i32.load offset=" + util.i32_to_string(8 + k * 8) + " (local.get $box))";
                    if (irlower.nested_field_deep_drop_ok(cx.structs, ft)) {
                        // DEEP nested-struct field drop (Perceus slice 3 deep-drop):
                        // when the inner box is UNIQUELY owned, first $__struct_drop_<ft>
                        // releases the inner's OWN rc-array buffers, THEN $__fern_arr_dec
                        // frees the inner box — mirroring the x86 / arm64 deep-drop arm.
                        // ft is deep-drop-ok (its nested-struct closure is ACYCLIC per
                        // nested_field_deep_drop_ok), so $__struct_drop_<ft> may itself
                        // recurse into ft's own deep-drop-ok fields: the call graph is a
                        // DAG (multi-level, no cycle). struct_drop_types' transitive
                        // closure emits every reachable inner body. $__fern_rc_is_unique
                        // null-/rc-guards internally; a shared inner (rc>1) skips the
                        // field-release and only the box decs.
                        o = o + "    (if (call $__fern_rc_is_unique " + sload + ") (then\n";
                        o = o + "      (drop (call $__struct_drop_" + ft + " " + sload + "))))\n";
                        o = o + "    (drop (call $__fern_arr_dec " + sload + "))\n";
                    } else {
                        // A DIRECT nested-struct field (`inner: Inner`) that is NOT a
                        // deep-drop-ok leaf (a self-referential / tree struct carries a
                        // nested-struct field, so it stays here): freed SHALLOW via the
                        // same $__fern_arr_dec as a scalar-array buffer — one level, like
                        // a struct-array element box (arr_dec frees struct boxes too).
                        // rc-guarded inside arr_dec; the construction alias-inc (shared
                        // irlower) balances it. Mirrors the x86 / arm64 shallow k_struct
                        // case (Perceus slice 3c). Enum/tuple/Option fields (also kind
                        // "S") stay leak-only — is_struct_type is false for them.
                        o = o + "    (drop (call $__fern_arr_dec " + sload + "))\n";
                    }
                } else if (ft == "fn" && clo_ok) {
                    // An fn-typed (closure) field: the slot holds an rc-headered
                    // `__mkclo$` env box, shallow-freed via the rc-guarded
                    // $__fern_arr_dec — one level, captures leak. GATED on the
                    // clofld admission ("clo:<T>" in strfld_reclaim_ok_types_of:
                    // fresh-lambda-only values, no base copies, call-only reads),
                    // the wasm sibling of the register backends' k_clo arm
                    // (#5104). A non-admitted type keeps the sound leak.
                    var cldload: string = "(i32.load offset=" + util.i32_to_string(8 + k * 8) + " (local.get $box))";
                    o = o + "    (drop (call $__fern_arr_dec " + cldload + "))\n";
                } else if (ft == "string" && str_ok) {
                    // A `string` field is an rc-headered INLINE block on wasm
                    // ([rc][bsz][len][bytes]); reclaim it with $__fern_arr_dec — frees
                    // at rc==1 by size class, guards a data-section literal (below
                    // heap_base), decs a shared box, and the rc-underflow detector
                    // catches a double free. Balanced by the shared-irlower
                    // construction alias-inc. Mirrors the x86 / arm64 k_str arm
                    // (#4297 A2). GATED on the STRFLDOK admission (str_ok, from the
                    // whole-program read scan — the same verdict the field-reclaim
                    // string arm and the construction retain use): a non-admitted
                    // type's string fields are uncounted aliases this dec would
                    // over-release (#3425, x86 twin note in emit_ir_struct_drop_one).
                    var strload: string = "(i32.load offset=" + util.i32_to_string(8 + k * 8) + " (local.get $box))";
                    o = o + "    (drop (call $__fern_arr_dec " + strload + "))\n";
                }
                k = k + 1;
            }
        }
        si = si + 1;
    }
    o = o + "    (local.get $box))\n";
    return o;
}

// emit_wasm_field_reclaim_body returns the WAT for
// $__field_reclaim_<t>(new, old, snap) -> new — the wasm sibling of
// asm_ir.emit_ir_field_reclaim_one (Perceus slice 1d). The consume-rebind
// replaced-field reclaim: when a struct PARAM is reassigned (`a = T { … }`),
// the superseded `old` struct's rc-array field buffers are freed, then `old`'s
// box itself via $__fern_snapshot_dec. For each ARRAY field (struct_field_kind_char
// == "a") it frees old.field_k (SHALLOW — $__fern_arr_dec, matching the register
// backends; a pointer-element field's element boxes are a known one-level gap on
// every backend) iff old.field_k differs from BOTH new.field_k (cow — the rebind
// kept the buffer) and, when snap != 0, snap.field_k (the caller's borrowed
// original). The field offset is the IR struct layout (`8 + i*8`), as in
// emit_wasm_struct_drop_body. `old` null / below heap_base skips the field loop
// (snapshot_dec null-guards the box free). Returns `new`. `hb` is the module's
// heap base (the low-address guard threshold).
function emit_wasm_field_reclaim_body(t: string, cx: Ctx, hb: i32, str_ok: boolean, clo_ok: boolean): string {
    var o: string = "  (func $__field_reclaim_" + t + " (param $new i32) (param $old i32) (param $snap i32) (result i32)\n";
    o = o + "    (if (i32.ge_u (local.get $old) (i32.const " + util.i32_to_string(hb) + ")) (then\n";
    var si: i32 = 0;
    while (si < cx.structs.len()) {
        if (cx.structs[si].name == t) {
            var k: i32 = 0;
            while (k < cx.structs[si].fields.len()) {
                var ft: string = cx.structs[si].fields[k].type_name;
                // A replaced STRING field (#4355) rides the same guarded dec:
                // a wasm heap string is a single inline rc-headered block, so
                // $__fern_arr_dec IS the wasm string free (it null-/low-/
                // sentinel-guards a literal internally). Balanced by the shared
                // irlower construction retain, and gated on the whole-program
                // read scan (str_ok) — see the x86 emit_ir_field_reclaim_one
                // string arm.
                var frk: string = struct_field_kind_char(ft, cx);
                // A replaced fn (closure) field rides the same guarded
                // $__fern_arr_dec: the superseded `__mkclo$` env box is one
                // rc-headered block, shallow-freed (captures leak). Gated on
                // the clofld admission (clo_ok) — the wasm fr_clo sibling.
                if (frk == "a" || (frk == "s" && str_ok) || (ft == "fn" && clo_ok)) {
                    var off: string = util.i32_to_string(8 + k * 8);
                    var oldf: string = "(i32.load offset=" + off + " (local.get $old))";
                    var newf: string = "(i32.load offset=" + off + " (local.get $new))";
                    var snapf: string = "(i32.load offset=" + off + " (local.get $snap))";
                    var dec: string = "(drop (call $__fern_arr_dec " + oldf + "))";
                    // cow: skip if old.field_k == new.field_k. Then snap guard,
                    // nested (NOT a flat i32.or) so snap.field_k is never loaded
                    // when snap == 0: dec if snap == 0, else dec iff
                    // old.field_k != snap.field_k.
                    o = o + "      (if (i32.ne " + oldf + " " + newf + ") (then\n";
                    o = o + "        (if (i32.eqz (local.get $snap)) (then " + dec + ")\n";
                    o = o + "          (else (if (i32.ne " + oldf + " " + snapf + ") (then " + dec + "))))))\n";
                }
                k = k + 1;
            }
        }
        si = si + 1;
    }
    o = o + "    ))\n";
    o = o + "    (call $__fern_snapshot_dec (local.get $new) (local.get $old) (local.get $snap)))\n";
    return o;
}

// emit_struct_release frees one owned struct/enum local with RECURSIVE
// field-release: if it is the LAST owner (rc word at [s-8] == 1, i.e. the box
// is about to be freed) first release each rc-tracked field (a string or
// nested struct via $__fern_arr_dec; a pointer-element array via
// $__fern_arr_dec_ptr so ITS elements are released too; a scalar array flat),
// then free the box via the shared $__fern_arr_dec. The rc==1 guard ensures
// fields are released exactly once, on the final free (an aliased struct at
// rc>1 just decrements). The per-field construction-incs pair with these decs
// so a struct stored in a container survives. A scalar field is skipped
// (struct_field_kind_char). An enum local's variant payload isn't reached (its
// static type has 0 struct fields) — a sound leak, like a nested struct's own
// fields.
// emit_struct_release routes a swept struct/enum local to its generated
// per-type drop function ($__fern_release_<T>), which recursively releases the
// value's rc-tracked fields (nested struct fields recurse via THEIR release
// fns — transitive reclamation, matching the native __drop_struct_<N>) then
// frees the box. An untyped fallback (sty not a known struct/enum) frees the
// box flat. The release fns are generated once per module by
// struct_enum_drop_helpers.
function emit_struct_release(name: string, sty: string, cx: Ctx): string {
    if (is_struct_type(cx.structs, sty) || is_enum_type_name(cx, sty)) {
        return "    (drop (call $__fern_release_" + sty + " (local.get $" + name + ")))\n";
    }
    return "    (drop (call $__fern_arr_dec (local.get $" + name + ")))\n";
}

// struct_release_field_inner builds the rc==1-guarded field-release WAT for a
// value at pointer-expr `pe` of struct type `sty` (the generated
// $__fern_release_<T> body). A nested STRUCT or ENUM field recurses through
// that type's release fn (deep / transitive); a tuple field, a string, and
// arrays release one level (arrays via arr_dec_ptr when their element is a
// pointer). A scalar field is skipped.
function struct_release_field_inner(pe: string, sty: string, cx: Ctx): string {
    var inner: string = "";
    var nf: i32 = struct_field_count(cx.structs, sty);
    var fi: i32 = 0;
    while (fi < nf) {
        var ft: string = struct_field_type_at(cx.structs, sty, fi);
        var fk: string = struct_field_kind_char(ft, cx);
        var off: string = util.i32_to_string(struct_field_off(fi));
        var load: string = "(i32.load (i32.add " + pe + " (i32.const " + off + ")))";
        if (fk == "S" && (is_struct_type(cx.structs, ft) || (is_enum_type_name(cx, ft) && ft != "Option" && ft != "Result"))) {
            inner = inner + " (drop (call $__fern_release_" + ft + " " + load + "))";
        } else if (fk == "a") {
            // Array field: a STRUCT-element array deep-releases each element
            // (Stage B, $__fern_arr_release_<Elem>); a string-element (or other
            // pointer) array frees one level (arr_dec_ptr); a scalar array flat.
            var elem: str = ft[0:ft.len() - 2];
            if (is_struct_type(cx.structs, elem) || (is_enum_type_name(cx, elem) && elem != "Option" && elem != "Result")) {
                inner = inner + " (drop (call $__fern_arr_release_" + elem + " " + load + "))";
            } else if (array_field_elem_is_ptr(ft, cx)) {
                inner = inner + " (drop (call $__fern_arr_dec_ptr " + load + "))";
            } else {
                inner = inner + " (drop (call $__fern_arr_dec " + load + "))";
            }
        } else if (fk == "s" || fk == "S") {
            inner = inner + " (drop (call $__fern_arr_dec " + load + "))";
        }
        fi = fi + 1;
    }
    return inner;
}

// struct_enum_drop_helpers generates the per-type drop functions for every
// struct + enum type: $__fern_release_<S> (recursive field release) and
// $__fern_release_<E> (an enum value box — flat one level for now; variant
// payload dispatch is a later stage). Mutual recursion (a struct field that is
// itself a struct calls that type's fn) gives arbitrary-depth reclamation;
// each fn rc==1-gates internally, so a shared child at rc>1 just decrements.
function struct_enum_drop_helpers(mod: parser.Module, cx: Ctx): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        var sty: string = mod.structs[i].name;
        var inner: string = struct_release_field_inner("(local.get $p)", sty, cx);
        o = o + "  (func $__fern_release_" + sty + " (param $p i32) (result i32)\n";
        o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
        if (inner.len() > 0) {
            o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $p) (i32.const 8))) (i32.const 1)) (then" + inner + "))\n";
        }
        o = o + "    (call $__fern_arr_dec (local.get $p)))\n";
        // $__fern_arr_release_<S>(a): Stage B — an array whose elements are
        // structs of type S. When `a` is the last owner ([a-8]==1) deep-release
        // each element through $__fern_release_<S> (so the struct's OWN fields
        // reclaim too, not just the box), then free the buffer. Mutual recursion
        // with $__fern_release_<S> (whose S[] fields call this) gives
        // arbitrary-depth tree reclamation (Node { items: Node[] }). `a` is
        // always a heap array or null, so the null guard + rc==1 suffice.
        o = o + "  (func $__fern_arr_release_" + sty + " (param $a i32) (result i32)\n";
        o = o + "    (local $i i32) (local $n i32)\n";
        o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
        o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
        o = o + "      (local.set $n (i32.load (local.get $a)))\n";
        o = o + "      (local.set $i (i32.const 0))\n";
        o = o + "      (block $ard (loop $arl\n";
        o = o + "        (br_if $ard (i32.ge_u (local.get $i) (local.get $n)))\n";
        o = o + "        (drop (call $__fern_release_" + sty + " (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
        o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
        o = o + "        (br $arl)))))\n";
        o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
        i = i + 1;
    }
    var e: i32 = 0;
    while (e < mod.enums.len()) {
        var en: string = mod.enums[e].name;
        // Option/Result locals use emit_option_release, not a $__fern_release_
        // fn; an enum sharing a struct name (shouldn't happen) is skipped.
        if (en != "Option" && en != "Result" && !is_struct_type(mod.structs, en)) {
            // Stage C — variant payload dispatch (native genEnumDrops): an enum
            // value is a variant box [struct_id@0][fields@4…]. Dispatch on the
            // tag to the matching variant struct's release fn (which releases
            // that variant's payload fields then frees the box). A struct_id
            // that matches no variant falls through to a flat free.
            o = o + "  (func $__fern_release_" + en + " (param $p i32) (result i32)\n";
            o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
            var vi: i32 = 0;
            while (vi < mod.enums[e].variant_names.len()) {
                var vn: string = mod.enums[e].variant_names[vi];
                var sid: i32 = struct_id(mod.structs, vn);
                o = o + "    (if (i32.eq (i32.load (local.get $p)) (i32.const " + util.i32_to_string(sid) + ")) (then (return (call $__fern_release_" + vn + " (local.get $p)))))\n";
                vi = vi + 1;
            }
            o = o + "    (call $__fern_arr_dec (local.get $p)))\n";
            // Stage D — array-of-enum deep release: per element call the enum's
            // (dispatching) release fn so each variant's payload reclaims, then
            // free the buffer. Drives the AST's Stmt[] / Expr[] etc.
            o = o + "  (func $__fern_arr_release_" + en + " (param $a i32) (result i32)\n";
            o = o + "    (local $i i32) (local $n i32)\n";
            o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
            o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
            o = o + "      (local.set $n (i32.load (local.get $a)))\n";
            o = o + "      (local.set $i (i32.const 0))\n";
            o = o + "      (block $erd (loop $erl\n";
            o = o + "        (br_if $erd (i32.ge_u (local.get $i) (local.get $n)))\n";
            o = o + "        (drop (call $__fern_release_" + en + " (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
            o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
            o = o + "        (br $erl)))))\n";
            o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
        }
        e = e + 1;
    }
    // Per-type map deep-release (native __drop_map_via_): a struct/enum-valued
    // map's exit sweep routes to $__fern_map_release_via_<T>, which is the
    // generic map_release with the VALUE column deep-released through
    // $__fern_release_<T> (the value's own fields reclaim, not just its box).
    // Emitted only when the module actually builds a struct-valued map, so
    // map-less / scalar-valued-map programs carry no dead helpers.
    if (module_uses_struct_val_map(mod)) {
        var si: i32 = 0;
        while (si < mod.structs.len()) { o = o + map_release_via_fn(mod.structs[si].name); si = si + 1; }
        var ei: i32 = 0;
        while (ei < mod.enums.len()) {
            var en2: string = mod.enums[ei].name;
            if (en2 != "Option" && en2 != "Result" && !is_struct_type(mod.structs, en2)) {
                o = o + map_release_via_fn(en2);
            }
            ei = ei + 1;
        }
    }
    return o;
}

// map_release_via_fn(T) emits $__fern_map_release_via_<T>: a copy of
// $__fern_map_release whose value loop deep-releases each occupied slot's value
// via $__fern_release_<T> (instead of the generic flat arr_dec), so a
// struct/enum-valued map reclaims its values' inner fields. String keys (kis)
// are still released; the three arrays + box are freed. Standalone — the map
// sweep calls THIS instead of the generic release for such a map, so values are
// released exactly once.
function map_release_via_fn(t: string): string {
    var o: string = "";
    o = o + "  (func $__fern_map_release_via_" + t + " (param $box i32) (result i32)\n";
    o = o + "    (local $i i32) (local $cap i32) (local $keys i32) (local $used i32) (local $vals i32)\n";
    o = o + "    (if (i32.eqz (local.get $box)) (then (return (local.get $box))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $box) (i32.const 8))) (i32.const 1)) (then\n";
    // String keys: release each occupied slot's key (as in the generic release).
    o = o + "      (if (i32.eq (i32.load (i32.add (local.get $box) (i32.const 20))) (i32.const 1)) (then\n";
    o = o + "        (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "        (local.set $keys (i32.load (i32.add (local.get $box) (i32.const 8))))\n";
    o = o + "        (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "        (local.set $i (i32.const 0))\n";
    o = o + "        (block $mkd (loop $mkl\n";
    o = o + "          (br_if $mkd (i32.ge_u (local.get $i) (local.get $cap)))\n";
    o = o + "          (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "            (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $keys) (i32.mul (local.get $i) (i32.const 4))))))))\n";
    o = o + "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "          (br $mkl))))) \n";
    // Values: deep-release each occupied slot via $__fern_release_<T> (rc==1-
    // gated inside that fn, so a value shared via an outstanding get borrow only
    // dec's). vis is irrelevant here — we know the values are struct/enum boxes.
    o = o + "      (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "      (local.set $vals (i32.load (i32.add (local.get $box) (i32.const 12))))\n";
    o = o + "      (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $mvd (loop $mvl\n";
    o = o + "        (br_if $mvd (i32.ge_u (local.get $i) (local.get $cap)))\n";
    o = o + "        (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "          (drop (call $__fern_release_" + t + " (i32.load (i32.add (local.get $vals) (i32.mul (local.get $i) (i32.const 4))))))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $mvl)))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 8)))))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 12)))))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 16)))))))\n";
    o = o + "    (call $__fern_arr_dec (local.get $box)))\n";
    return o;
}

// release_module_ctx builds a minimal Ctx carrying only the type info the
// drop-fn generator's classifiers need (structs + method-return types for enum
// detection); every per-function field is empty.
function release_module_ctx(structs: parser.StructDecl[], mr_types: string[], mod_funcs: parser.FuncDecl[]): Ctx {
    return Ctx {
        tab: new_str_table(), locals: [], funcs: [], str_arrays: [], str_arr_funcs: [],
        structs: structs, sv_names: [], sv_types: [], sf_names: [], sf_types: [],
        of_names: [], of_payloads: [], ol_names: [], ol_payloads: [], ol_err_payloads: [],
        mr_types: mr_types, mr_names: [], mr_rets: [],
        i64_names: [], i64_funcs: [],
        ret_i64: false, mod_funcs: mod_funcs,
        f64_names: [], f64_funcs: [],
        ret_f64: false,
        map_names: [], cell_names: [], map_str_names: [],
        map_str_key_names: [],
        mvs_names: [], mvs_types: [],
        tup_names: [], tup_kinds: [], tup_svtypes: [],
        fn_names: [], lam_ctr: cell_new(0), lamdefs: cell_new(""),
        all_locals: [], cap_names: [],
        sa_names: [], sa_types: [], ta_names: [], ta_kinds: [], ta_svtypes: [],
        i64_arr_names: [], f64_arr_names: [],
        ret_arr_kind: "i32",
        arr_swept: [], arr_src: [],
        ret_void: false,
        ret_is_array: false,
        str_swept: [],
        ret_is_string: false,
        tup_swept: [],
        ret_is_tuple: false,
        struct_swept: [],
        opt_swept: [],
        map_swept: [],
        clos_swept: [],
        clos_caps: [],
    };
}

// struct_exit_sweep_excl emits the struct/enum release sweep (FREE ON, with
// recursive field-release via emit_struct_release) of every owned struct
// local, except `excl` (the move-on-return slot handed to the caller at its
// rc). Each local's type is recovered from sv_types so the per-field kinds
// resolve; an untyped fallback ("" — not in sv_names) frees only the box.
function struct_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.struct_swept.len()) {
        var name: string = cx.struct_swept[i];
        if (name != excl) {
            o = o + emit_struct_release(name, lookup_pair(cx.sv_names, cx.sv_types, name), cx);
        }
        i = i + 1;
    }
    return o;
}

function struct_exit_sweep(cx: Ctx): string {
    return struct_exit_sweep_excl(cx, "");
}

// init_is_owned_option: the init produces a FRESH or MOVED Option/Result value
// the local owns — a Some/Ok/Err constructor call, a bare `None`, or an
// option-returning call (read_file / env / map.get / a user fn or method whose
// return type is Option/Result, detected via scrutinee_payload). A borrowed
// field / index read is NOT owned (handled by the return-retain path).
function init_is_owned_option(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (variant_tag(id.name) >= 0) { return true; }
                    return scrutinee_payload(e, cx).len() > 0;
                },
                _ => { return scrutinee_payload(e, cx).len() > 0; },
            }
        },
        parser.ExprIdent(id) => { return id.name == "None"; },
        _ => { return false; },
    }
    return false;
}

// init_is_option_alias: a bare-ident reference to an Option/Result local/param
// (a co-owner to retain), excluding the fresh `None` box.
function init_is_option_alias(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => {
            if (id.name == "None") { return false; }
            return contains_str(cx.ol_names, id.name);
        },
        _ => { return false; },
    }
    return false;
}

// collect_opt_swept gathers body Option/Result-value locals to release at exit:
// an owned option (init_is_owned_option) or a bare-ident alias
// (init_is_option_alias). Comma destructures skipped. Uses cx (ol_names known).
function collect_opt_swept(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (init_is_owned_option(v.init, cx) || init_is_option_alias(v.init, cx)) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_opt_swept(f.then_body, cx, acc);
                acc = collect_opt_swept(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_opt_swept(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_opt_swept(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_opt_swept(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// emit_option_release frees one owned Option/Result local with the tag-guarded
// payload recursive release: if it is the LAST owner ([p-8]==1, about to free)
// AND the tag at [p] is 0 (Some/Ok — the payload-carrying variant), release the
// payload at [p+4] according to its declared type (string / pointer-array via
// $__fern_arr_dec_ptr / scalar-array / nested struct one level — a scalar
// payload like Option<i32> is skipped), THEN free the box via $__fern_arr_dec.
// `pt` is the Some/Ok payload type (from ol_payloads); a Result's Err payload
// type is recovered from ol_err_payloads and released on the tag-1 path (an
// Option's None is tag 1 with no Err type → skipped). Null-guarded (a
// conditionally-unassigned option local is 0). The construction-incs
// (enum_box_retain's payload retain + the option-into-container retains) pair
// with these decs so the payload balances.
function emit_option_release(name: string, pt: string, cx: Ctx): string {
    var o: string = "";
    var pk: string = struct_field_kind_char(pt, cx);
    if (pk == "a" || pk == "s" || pk == "S") {
        var dec: string = "$__fern_arr_dec";
        if (pk == "a" && array_field_elem_is_ptr(pt, cx)) { dec = "$__fern_arr_dec_ptr"; }
        o = o + "    (if (local.get $" + name + ") (then (if (i32.eq (i32.load (i32.sub (local.get $" + name + ") (i32.const 8))) (i32.const 1)) (then (if (i32.eqz (i32.load (local.get $" + name + "))) (then (drop (call " + dec + " (i32.load (i32.add (local.get $" + name + ") (i32.const 4)))))))))))\n";
    }
    // Result Err payload (tag 1): release when the Err type is rc-tracked.
    var et: string = lookup_pair(cx.ol_names, cx.ol_err_payloads, name);
    var ek: string = struct_field_kind_char(et, cx);
    if (ek == "a" || ek == "s" || ek == "S") {
        var edec: string = "$__fern_arr_dec";
        if (ek == "a" && array_field_elem_is_ptr(et, cx)) { edec = "$__fern_arr_dec_ptr"; }
        o = o + "    (if (local.get $" + name + ") (then (if (i32.eq (i32.load (i32.sub (local.get $" + name + ") (i32.const 8))) (i32.const 1)) (then (if (i32.eq (i32.load (local.get $" + name + ")) (i32.const 1)) (then (drop (call " + edec + " (i32.load (i32.add (local.get $" + name + ") (i32.const 4)))))))))))\n";
    }
    o = o + "    (drop (call $__fern_arr_dec (local.get $" + name + ")))\n";
    return o;
}

// opt_exit_sweep_excl emits the Option/Result release sweep (FREE ON, with the
// tag-guarded payload release via emit_option_release) of every owned option
// local, except `excl` (the move-on-return slot). Each local's Some/Ok payload
// type is recovered from ol_payloads.
function opt_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.opt_swept.len()) {
        var name: string = cx.opt_swept[i];
        if (name != excl) {
            o = o + emit_option_release(name, lookup_pair(cx.ol_names, cx.ol_payloads, name), cx);
        }
        i = i + 1;
    }
    return o;
}

function opt_exit_sweep(cx: Ctx): string {
    return opt_exit_sweep_excl(cx, "");
}

// init_is_owned_map: the init produces a FRESH map the local owns — a
// `map_new[_i32]`-rooted construction or `.insert` chain (expr_map_rooted). A
// map mutated in place (`m = m.insert(…)`) returns the same box, so the local
// stays the single owner; an alias is handled by init_is_map_alias.
function init_is_owned_map(e: parser.Expr, cx: Ctx): boolean {
    return expr_map_rooted(e);
}

// init_is_map_alias: a bare-ident reference to a map local/param (a co-owner of
// the same box, to retain).
function init_is_map_alias(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.map_names, id.name); },
        _ => { return false; },
    }
    return false;
}

// collect_map_swept gathers body map locals to release at exit: an owned map
// (init_is_owned_map) or a bare-ident alias (init_is_map_alias). Comma
// destructures skipped.
function collect_map_swept(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (init_is_owned_map(v.init, cx) || init_is_map_alias(v.init, cx)) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_map_swept(f.then_body, cx, acc);
                acc = collect_map_swept(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_map_swept(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_map_swept(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_map_swept(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// map_exit_sweep_excl emits the map release sweep (FREE ON via
// $__fern_map_release — frees the keys/vals/used arrays + the box when last
// owner) of every owned map local, except `excl` (the move-on-return slot).
// One level: the string keys/values held in the arrays leak (not
// construction-inc'd into the map), a sound documented gap.
function map_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.map_swept.len()) {
        if (cx.map_swept[i] != excl) {
            // A struct/enum-valued map deep-releases its values via the per-type
            // $__fern_map_release_via_<T> (native __drop_map_via_); otherwise the
            // generic release (which one-level-frees string K/V via arr_dec).
            var mvt: string = lookup_pair(cx.mvs_names, cx.mvs_types, cx.map_swept[i]);
            if (mvt.len() > 0 && mvt != "Option" && mvt != "Result") {
                o = o + "    (drop (call $__fern_map_release_via_" + mvt + " (local.get $" + cx.map_swept[i] + ")))\n";
            } else {
                o = o + "    (drop (call $__fern_map_release (local.get $" + cx.map_swept[i] + ")))\n";
            }
        }
        i = i + 1;
    }
    return o;
}

function map_exit_sweep(cx: Ctx): string {
    return map_exit_sweep_excl(cx, "");
}

// clos_exit_sweep_excl frees each owned closure local's rc-boxed env block
// at function exit (rc dec via the shared $__fern_arr_dec; reclaims the box
// on the last reference), except `excl` — a move-on-return slot handed to the
// caller. Captures still leak one level here (a later slice releases them);
// the box reclaim is sound on its own (a borrowed closure at rc>1 just dec's).
function clos_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.clos_swept.len()) {
        if (cx.clos_swept[i] != excl) {
            // Release rc-tracked captures (rc==1-gated, so a shared closure at
            // rc>1 just dec's the box below) BEFORE freeing the env block.
            if (i < cx.clos_caps.len()) { o = o + cx.clos_caps[i]; }
            o = o + "    (drop (call $__fern_arr_dec (local.get $" + cx.clos_swept[i] + ")))\n";
        }
        i = i + 1;
    }
    return o;
}

// clos_release_snippet builds the rc==1-gated per-capture release WAT for a
// closure local `name` bound to lambda `lm`: for each rc-tracked capture
// (capture_kind), load it from the env at 4+i*4 and release via
// capture_release_op. "" when no capture needs release. The null + rc==1
// guards mirror the struct/tuple sweeps (a shared env at rc>1 just dec's).
function clos_release_snippet(name: string, lm: parser.ExprLambda, cx: Ctx): string {
    var caps: string[] = lambda_captures(lm, cx);
    var inner: string = "";
    var i: i32 = 0;
    while (i < caps.len()) {
        var kind: string = capture_kind(caps[i], cx);
        if (kind.len() > 0) {
            var load: string = "(i32.load (i32.add (local.get $" + name + ") (i32.const " + util.i32_to_string(4 + i * 4) + ")))";
            inner = inner + capture_release_op(kind, load);
        }
        i = i + 1;
    }
    if (inner.len() == 0) { return ""; }
    return "    (if (local.get $" + name + ") (then (if (i32.eq (i32.load (i32.sub (local.get $" + name + ") (i32.const 8))) (i32.const 1)) (then" + inner + "))))\n";
}

// clos_snippet_for walks the body for the `var name = function(…){…}` binding
// and returns its capture-release snippet (or "" if not found / no rc
// captures). Driven per clos_swept name so the result array stays parallel.
function clos_snippet_for(body: parser.Stmt[], name: string, cx: Ctx): string {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (v.name == name) {
                    match (v.init) {
                        parser.ExprLambda(lm) => { return clos_release_snippet(name, lm, cx); },
                        _ => {},
                    }
                }
            },
            parser.StmtIf(f) => {
                var t: string = clos_snippet_for(f.then_body, name, cx);
                if (t.len() > 0) { return t; }
                var e: string = clos_snippet_for(f.else_body, name, cx);
                if (e.len() > 0) { return e; }
            },
            parser.StmtWhile(w) => {
                var r: string = clos_snippet_for(w.body, name, cx);
                if (r.len() > 0) { return r; }
            },
            parser.StmtFor(f) => {
                var r: string = clos_snippet_for(f.body, name, cx);
                if (r.len() > 0) { return r; }
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    var r: string = clos_snippet_for(m.arms[k].body, name, cx);
                    if (r.len() > 0) { return r; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return "";
}

// collect_clos_caps builds the per-closure-local release snippet array,
// parallel to clos_swept (one entry per swept closure name, in order).
function collect_clos_caps(body: parser.Stmt[], names: string[], cx: Ctx): string[] {
    var acc: string[] = [];
    var i: i32 = 0;
    while (i < names.len()) {
        acc = acc.append(clos_snippet_for(body, names[i], cx));
        i = i + 1;
    }
    return acc;
}

function clos_exit_sweep(cx: Ctx): string {
    return clos_exit_sweep_excl(cx, "");
}

// collect_clos_swept gathers body closure locals bound directly to a lambda
// literal (`var f = function(…){…}`) — freshly rc-boxed, owned envs the exit
// sweep frees. Aliases, closure-returning calls, and bare function-name
// values are excluded (they leak one level — sound). Comma destructures
// skipped. Recurses nested bodies.
function collect_clos_swept(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    match (v.init) {
                        parser.ExprLambda(_) => { acc = acc.append(v.name); },
                        _ => {},
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_clos_swept(f.then_body, acc);
                acc = collect_clos_swept(f.else_body, acc);
            },
            parser.StmtWhile(w) => { acc = collect_clos_swept(w.body, acc); },
            parser.StmtFor(f) => { acc = collect_clos_swept(f.body, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_clos_swept(m.arms[k].body, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// ret_map_is_borrowed: a returned map that borrows (a field / index read, or a
// borrowed-param ident — a returned swept local is a move, filtered by
// map_mov) is retained. A fresh map_new-rooted construction is owned-and-moved.
function ret_map_is_borrowed(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprFieldAccess(_) => { return true; },
        parser.ExprIndex(_) => { return true; },
        parser.ExprIdent(_) => { return true; },
        _ => { return false; },
    }
    return false;
}

// ret_option_is_borrowed: a returned Option/Result that aliases/borrows (a
// field / index read, or a borrowed-param ident — a returned swept local is a
// move, filtered out by opt_mov) and so must be retained. A fresh
// Some/Ok/Err / None / option-returning call is owned-and-moved, not retained.
function ret_option_is_borrowed(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprFieldAccess(_) => { return true; },
        parser.ExprIndex(_) => { return true; },
        parser.ExprIdent(id) => { return id.name != "None"; },
        _ => { return false; },
    }
    return false;
}

// ret_struct_is_borrowed: a returned struct/enum value that aliases/borrows
// and so must be retained to hand the caller a counted reference — a real
// field read (`s.field`), an index read, or a bare-ident (a borrowed param;
// a returned swept local is a move, filtered out separately by struct_mov).
// A fresh struct literal / variant-constructor call / unit-variant / enum
// constant is owned-and-moved, never retained (would leak).
function ret_struct_is_borrowed(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprFieldAccess(fa) => { return struct_type_of(fa.obj, cx).len() > 0; },
        parser.ExprIndex(_) => { return true; },
        parser.ExprIdent(_) => { return true; },
        _ => { return false; },
    }
    return false;
}

// store_value_is_borrowed: the value being stored into a heap container (an
// array element / push, a struct or tuple field, an enum payload) references
// an rc-tracked object that ALREADY has another owner — a bare-ident alias,
// OR a struct field read (`r.node`) whose field type is rc-tracked, OR an
// index read of a struct- / string-array. Such a store must RETAIN (inc) the
// value so the container co-owns it; otherwise releasing the source frees the
// value out from under the container (the `children.append(r.node)` UAF in
// the recursive WAT parser). A freshly-constructed unique value (literal /
// constructor call / concat / slice) is NOT borrowed — the container takes
// sole ownership, no inc (that would leak). This subsumes the four
// init_is_*_alias checks and extends them to borrowed field / index reads.
function store_value_is_borrowed(v: parser.Expr, cx: Ctx): boolean {
    if (init_is_arr_alias(v, cx.arr_src) || init_is_string_alias(v, cx) || init_is_tuple_alias(v, cx) || init_is_struct_alias(v, cx) || init_is_option_alias(v, cx) || init_is_map_alias(v, cx)) { return true; }
    match (v) {
        parser.ExprFieldAccess(fa) => {
            // A tuple index (t.N) is conservatively skipped here (tuple
            // recursive-release drives its own retains); a real struct field
            // read is borrowed when the field type is rc-tracked.
            if (util.is_all_digits(fa.field)) { return false; }
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return struct_field_kind_char(struct_field_type(cx.structs, ot, fa.field), cx) != "i";
        },
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(id) => { return contains_str(cx.sa_names, id.name) || contains_str(cx.str_arrays, id.name); },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// arr_exit_sweep emits the Perceus function-exit release: a release
// ($__fern_arr_dec, which frees at rc 1) of every owned array local
// (cx.arr_swept), except `excl` — the Perceus move-on-return slot, whose
// buffer is handed to the caller at its current rc (the return-retain
// inc and this dec would be a balanced pair, so both are elided). Pass ""
// to sweep all. An unassigned slot (declared in a not-taken branch) is 0,
// and arr_dec short-circuits null, so it is a no-op.
function arr_exit_sweep_excl(cx: Ctx, excl: string): string {
    var o: string = "";
    var i: i32 = 0;
    while (i < cx.arr_swept.len()) {
        var name: string = cx.arr_swept[i];
        if (name != excl) {
            // A struct-array local DEEP-releases each element through that
            // struct's $__fern_arr_release_<S> (Stage B); a string-array frees
            // its strings one level (arr_dec_ptr); a scalar array (or
            // array-of-array / array-of-tuple, still one-level-flat) frees flat.
            var sat: string = lookup_pair(cx.sa_names, cx.sa_types, name);
            var tak: string = lookup_pair(cx.ta_names, cx.ta_kinds, name);
            if (sat.len() > 0 && (is_struct_type(cx.structs, sat) || (is_enum_type_name(cx, sat) && sat != "Option" && sat != "Result"))) {
                o = o + "    (drop (call $__fern_arr_release_" + sat + " (local.get $" + name + ")))\n";
            } else if (tak.len() > 0) {
                // Array-of-tuple deep release (native __drop_arr_tuple_): when
                // the array is the last owner ([a-8]==1) walk its elements; each
                // element is a tuple box whose pointer-bearing fields reclaim
                // (rc==1-gated per box) before the box is freed, then the buffer
                // is freed. Mirrors $__fern_arr_release_<S> + the inline tuple
                // sweep. The element box pointer is [a+8+i*4]; len is [a].
                var tasv: string = lookup_pair(cx.ta_names, cx.ta_svtypes, name);
                var einner: string = tuple_release_inner("(local.get $__te)", tak, tasv, cx);
                o = o + "    (if (local.get $" + name + ") (then (if (i32.eq (i32.load (i32.sub (local.get $" + name + ") (i32.const 8))) (i32.const 1)) (then\n";
                o = o + "      (local.set $__tan (i32.load (local.get $" + name + ")))\n";
                o = o + "      (local.set $__tai (i32.const 0))\n";
                o = o + "      (block $atd (loop $atl\n";
                o = o + "        (br_if $atd (i32.ge_u (local.get $__tai) (local.get $__tan)))\n";
                o = o + "        (local.set $__te (i32.load (i32.add (i32.add (local.get $" + name + ") (i32.const 8)) (i32.mul (local.get $__tai) (i32.const 4)))))\n";
                if (einner.len() > 0) {
                    o = o + "        (if (local.get $__te) (then (if (i32.eq (i32.load (i32.sub (local.get $__te) (i32.const 8))) (i32.const 1)) (then" + einner + "))))\n";
                }
                o = o + "        (drop (call $__fern_arr_dec (local.get $__te)))\n";
                o = o + "        (local.set $__tai (i32.add (local.get $__tai) (i32.const 1)))\n";
                o = o + "        (br $atl)))))))\n";
                o = o + "    (drop (call $__fern_arr_dec (local.get $" + name + ")))\n";
            } else if (contains_str(cx.str_arrays, name) || contains_str(cx.sa_names, name)) {
                o = o + "    (drop (call $__fern_arr_dec_ptr (local.get $" + name + ")))\n";
            } else {
                o = o + "    (drop (call $__fern_arr_dec (local.get $" + name + ")))\n";
            }
        }
        i = i + 1;
    }
    return o;
}

function arr_exit_sweep(cx: Ctx): string {
    return arr_exit_sweep_excl(cx, "");
}

// init_is_arr_alias: the init is a bare ident naming an existing array
// (an alias that must be retained — the inc-on-alias site).
function init_is_arr_alias(e: parser.Expr, src: string[]): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(src, id.name); },
        _ => { return false; }
    }
    return false;
}

// init_is_user_arr_call: the init is a direct call to a user free function
// declared to return an array (callee is a bare ident in `arr_ret_fns`).
// The result is OWNED — the callee's return-retain (StmtReturn incs any
// non-move array result) hands it over at a counted rc, so the caller may
// sweep it. Method calls (`xs.append(v)`, which can return the receiver in
// place) and un-annotated returns are deliberately excluded: they carry no
// return-retain, so sweeping their result could double-free.
function init_is_user_arr_call(e: parser.Expr, arr_ret_fns: string[]): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return contains_str(arr_ret_fns, id.name); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// init_is_fresh_array_builtin: the init is a builtin / method call that
// always returns a FRESH, uniquely-owned array (rc 1) — `args()`,
// `random_bytes(n)`, and a map's `.keys()` / `.values()` snapshot. Unlike
// `.append(v)` (which can hand back the receiver in place), these never
// alias an existing buffer, so the result can be counted + swept directly.
function init_is_fresh_array_builtin(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "args" || id.name == "random_bytes"; },
                parser.ExprFieldAccess(fa) => { return fa.field == "keys" || fa.field == "values"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// collect_arr_src / collect_arr_swept drive the wasm Perceus array
// reference-counting (the counting milestone — inc-on-alias + exit
// release sweep, free still OFF). arr_src is the set of names that hold an
// array (used to recognise an alias source); arr_swept is the subset of
// body locals that are DEFINITELY OWNED at rc 1 (a fresh array literal /
// slice) or a bare-ident alias of another array (which gets an inc), so
// dec'ing them at function exit balances. Borrowed params, field reads,
// index reads and call results are deliberately NOT swept (no inc to
// balance them without the construction-store machinery) — they leak,
// which is sound while free is off and avoids any over-release. comma
// names (`var (a, b) = …` destructures) are skipped.
function collect_arr_src(body: parser.Stmt[], arr_ret_fns: string[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (ty_spelling_is_array(v.type_name) || init_is_owned_array(v.init) || init_is_user_arr_call(v.init, arr_ret_fns) || init_is_fresh_array_builtin(v.init)) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_arr_src(f.then_body, arr_ret_fns, acc);
                acc = collect_arr_src(f.else_body, arr_ret_fns, acc);
            },
            parser.StmtWhile(w) => { acc = collect_arr_src(w.body, arr_ret_fns, acc); },
            parser.StmtFor(f) => { acc = collect_arr_src(f.body, arr_ret_fns, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_arr_src(m.arms[k].body, arr_ret_fns, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

function collect_arr_swept(body: parser.Stmt[], src: string[], arr_ret_fns: string[], arr_ret_methods: string[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) < 0 && !contains_str(acc, v.name)) {
                    if (init_is_owned_array(v.init) || init_is_arr_alias(v.init, src) || init_is_user_arr_call(v.init, arr_ret_fns) || init_is_fresh_array_builtin(v.init)
                        || (ty_spelling_is_array(v.type_name) && init_is_user_arr_method(v.init, arr_ret_methods))) {
                        acc = acc.append(v.name);
                    }
                }
            },
            parser.StmtIf(f) => {
                acc = collect_arr_swept(f.then_body, src, arr_ret_fns, arr_ret_methods, acc);
                acc = collect_arr_swept(f.else_body, src, arr_ret_fns, arr_ret_methods, acc);
            },
            parser.StmtWhile(w) => { acc = collect_arr_swept(w.body, src, arr_ret_fns, arr_ret_methods, acc); },
            parser.StmtFor(f) => { acc = collect_arr_swept(f.body, src, arr_ret_fns, arr_ret_methods, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_arr_swept(m.arms[k].body, src, arr_ret_fns, arr_ret_methods, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// collect_arr_ret_fns lists the module's free functions declared to return
// an array — the set whose call results are safe to count/sweep (their
// StmtReturn applies return-retain).
function collect_arr_ret_fns(mod_funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod_funcs.len()) {
        if (mod_funcs[i].receiver_type.len() == 0 && ty_spelling_is_array(mod_funcs[i].ret_type)) {
            out = out.append(mod_funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// array_method_field returns the `<field>` of a `__method_Array_<field>`
// auto-discovered helper name (handling the bundler's `<mod>__` prefix, which
// leaves the convention name as a suffix), or "" when `name` is not one.
function array_method_field(name: string): string {
    var marker: string = "__method_Array_";
    var ml: i32 = marker.len();
    var i: i32 = 0;
    var found: i32 = 0 - 1;
    while (i + ml <= name.len()) {
        if (name[i : i + ml] == marker) { found = i; }
        i = i + 1;
    }
    if (found < 0) { return ""; }
    return name[found + ml : name.len()] + "";
}

// wasm_find_array_method returns the exact in-scope name of the std/array
// helper backing `a.<field>()` — `__method_Array_<field>` or the bundler's
// `<mod>__`-mangled form — or "" when none is in scope. Mirrors asmcore's
// find_array_method_func for the wasm backend.
function wasm_find_array_method(field: string, mod_funcs: parser.FuncDecl[]): string {
    var target: string = "__method_Array_" + field;
    var tn: i32 = target.len();
    var i: i32 = 0;
    while (i < mod_funcs.len()) {
        var nm: string = mod_funcs[i].name;
        if (mod_funcs[i].receiver_type.len() == 0) {
            if (nm == target) { return nm; }
            if (nm.len() > tn && nm[nm.len() - tn : nm.len()] == target) { return nm; }
        }
        i = i + 1;
    }
    return "";
}

// collect_arr_ret_methods lists the names of user METHODS declared to
// return an array. Like user free functions, their StmtReturn applies
// return-retain, so a result bound to a (declared-array) local is safe to
// count/sweep. Builtin methods (`.append`/`.with`, which can hand back the
// receiver in place) are NOT user methods, so they never appear here.
function collect_arr_ret_methods(mod_funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod_funcs.len()) {
        if (mod_funcs[i].receiver_type.len() > 0 && ty_spelling_is_array(mod_funcs[i].ret_type) && !contains_str(out, mod_funcs[i].name)) {
            out = out.append(mod_funcs[i].name);
        }
        // Auto-discovered array methods reached via method syntax
        // (`a.reversed()` → __method_Array_reversed) return-retain just like a
        // user method, so an array-returning helper's FIELD name must sweep too.
        if (mod_funcs[i].receiver_type.len() == 0 && ty_spelling_is_array(mod_funcs[i].ret_type)) {
            var fld: string = array_method_field(mod_funcs[i].name);
            if (fld.len() > 0 && !contains_str(out, fld)) { out = out.append(fld); }
        }
        i = i + 1;
    }
    return out;
}

// init_is_user_arr_method: the init is a method call `obj.m()` where `m` is
// a user method declared to return an array. Paired at the call site with a
// declared-array local type (so a same-named method on another receiver
// that returns a non-array can't misclassify the slot), it is safe to
// sweep — the method's return-retain hands the buffer over at a counted rc.
function init_is_user_arr_method(e: parser.Expr, arr_ret_methods: string[]): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => { return contains_str(arr_ret_methods, fa.field); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function collect_fn_var_names(body: parser.Stmt[], acc: string[], fnrets: string[], fnmeths: string[], fnarrs: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                match (v.init) {
                    parser.ExprLambda(_) => {
                        if (!contains_str(acc, v.name)) { acc = acc.append(v.name); }
                    },
                    parser.ExprCall(c) => {
                        // `var f = g(...)` / `var f = obj.m(...)` where the
                        // callee returns a closure.
                        match (c.callee) {
                            parser.ExprIdent(cid) => {
                                if (contains_str(fnrets, cid.name) && !contains_str(acc, v.name)) {
                                    acc = acc.append(v.name);
                                }
                            },
                            parser.ExprFieldAccess(fa) => {
                                if (contains_str(fnmeths, fa.field) && !contains_str(acc, v.name)) {
                                    acc = acc.append(v.name);
                                }
                            },
                            _ => {},
                        }
                    },
                    parser.ExprIndex(ix) => {
                        // `var c = fns[i]` where fns is an `fn[]` array.
                        match (ix.array) {
                            parser.ExprIdent(aid) => {
                                if (contains_str(fnarrs, aid.name) && !contains_str(acc, v.name)) {
                                    acc = acc.append(v.name);
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            },
            parser.StmtIf(f) => {
                acc = collect_fn_var_names(f.then_body, acc, fnrets, fnmeths, fnarrs);
                acc = collect_fn_var_names(f.else_body, acc, fnrets, fnmeths, fnarrs);
            },
            parser.StmtWhile(w) => { acc = collect_fn_var_names(w.body, acc, fnrets, fnmeths, fnarrs); },
            parser.StmtFor(f) => {
                // `for f in fns` over an `fn[]` array binds a closure.
                if (comma_index(f.var_name) < 0) {
                    match (f.iter) {
                        parser.ExprIdent(iid) => {
                            if (contains_str(fnarrs, iid.name) && !contains_str(acc, f.var_name)) {
                                acc = acc.append(f.var_name);
                            }
                        },
                        _ => {},
                    }
                }
                acc = collect_fn_var_names(f.body, acc, fnrets, fnmeths, fnarrs);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_fn_var_names(m.arms[k].body, acc, fnrets, fnmeths, fnarrs);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// fn_returning_func_names lists the module's free functions whose declared
// return type is the coarse closure spelling `fn`.
function fn_returning_func_names(mod_funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod_funcs.len()) {
        if (mod_funcs[i].ret_type == "fn" && mod_funcs[i].receiver_name.len() == 0) {
            out = out.append(mod_funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// fn_returning_method_names lists the receiver-method names whose declared
// return type is the coarse closure spelling `fn`. Keyed by bare method
// name (not the mangled `$T__m`), which is enough to recognise a
// `var f = obj.m()` binding as closure-valued at the call site.
function fn_returning_method_names(mod_funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod_funcs.len()) {
        if (mod_funcs[i].ret_type == "fn" && mod_funcs[i].receiver_name.len() > 0
            && !contains_str(out, mod_funcs[i].name)) {
            out = out.append(mod_funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_idents_expr / _stmts gather every referenced identifier in an
// expression / statement list (for lambda capture analysis).
function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { if (!contains_str(acc, id.name)) { acc = acc.append(id.name); } },
        parser.ExprUnary(u) => { acc = collect_idents_expr(u.operand, acc); },
        parser.ExprBinary(b) => {
            acc = collect_idents_expr(b.left, acc);
            acc = collect_idents_expr(b.right, acc);
        },
        parser.ExprCall(c) => {
            acc = collect_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) { acc = collect_idents_expr(c.args[i], acc); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            acc = collect_idents_expr(ix.array, acc);
            acc = collect_idents_expr(ix.index, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_idents_expr(sl.array, acc);
            acc = collect_idents_expr(sl.start, acc);
            acc = collect_idents_expr(sl.end, acc);
        },
        parser.ExprFieldAccess(fa) => { acc = collect_idents_expr(fa.obj, acc); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { acc = collect_idents_expr(a.elements[i], acc); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { acc = collect_idents_expr(t.elements[i], acc); i = i + 1; }
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { acc = collect_idents_expr(sl.base, acc); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { acc = collect_idents_expr(sl.field_values[i], acc); i = i + 1; }
        },
        parser.ExprLambda(lm) => { acc = collect_idents_stmts(lm.body, acc); },
        _ => {},
    }
    return acc;
}

function collect_idents_stmts(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { acc = collect_idents_expr(v.init, acc); },
            parser.StmtAssign(a) => {
                if (!contains_str(acc, a.target)) { acc = acc.append(a.target); }
                acc = collect_idents_expr(a.value, acc);
            },
            parser.StmtReturn(r) => { acc = collect_idents_expr(r.value, acc); },
            parser.StmtExpr(e) => { acc = collect_idents_expr(e.value, acc); },
            parser.StmtIf(f) => {
                acc = collect_idents_expr(f.cond, acc);
                acc = collect_idents_stmts(f.then_body, acc);
                acc = collect_idents_stmts(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_idents_expr(w.cond, acc);
                acc = collect_idents_stmts(w.body, acc);
            },
            parser.StmtFor(f) => {
                acc = collect_idents_expr(f.iter, acc);
                acc = collect_idents_stmts(f.body, acc);
            },
            parser.StmtMatch(m) => {
                acc = collect_idents_expr(m.scrutinee, acc);
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_idents_stmts(m.arms[k].body, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// collect_bound_stmts gathers names bound inside a statement list: `var` /
// `let`, `for` variables (incl. `(k, v)` pairs), and match arm bindings.
function collect_bound_stmts(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (!contains_str(acc, v.name)) { acc = acc.append(v.name); } },
            parser.StmtIf(f) => {
                acc = collect_bound_stmts(f.then_body, acc);
                acc = collect_bound_stmts(f.else_body, acc);
            },
            parser.StmtWhile(w) => { acc = collect_bound_stmts(w.body, acc); },
            parser.StmtFor(f) => {
                if (comma_index(f.var_name) >= 0) {
                    var kn: string = before_comma(f.var_name);
                    var vn: string = after_comma(f.var_name);
                    if (!contains_str(acc, kn)) { acc = acc.append(kn); }
                    if (!contains_str(acc, vn)) { acc = acc.append(vn); }
                } else if (!contains_str(acc, f.var_name)) {
                    acc = acc.append(f.var_name);
                }
                acc = collect_bound_stmts(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if (pv.binding.len() > 0 && pv.binding != "_" && !contains_str(acc, pv.binding)) {
                                acc = acc.append(pv.binding);
                            }
                            // Multi-payload variant `V(a, b, …)`: the extra
                            // bindings are locals too (S4).
                            var ebk: i32 = 0;
                            while (ebk < pv.extra_bindings.len()) {
                                if (pv.extra_bindings[ebk].len() > 0 && pv.extra_bindings[ebk] != "_" && !contains_str(acc, pv.extra_bindings[ebk])) {
                                    acc = acc.append(pv.extra_bindings[ebk]);
                                }
                                ebk = ebk + 1;
                            }
                        },
                        _ => {},
                    }
                    acc = collect_bound_stmts(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// lambda_captures returns the lambda's real captures (in first-seen
// order): referenced idents that are locals/params of the enclosing
// function (cx.all_locals) and not bound inside the lambda itself.
function lambda_captures(lm: parser.ExprLambda, cx: Ctx): string[] {
    var refs: string[] = collect_idents_stmts(lm.body, []);
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lm.params.len()) { bound = bound.append(lm.params[pi].name); pi = pi + 1; }
    bound = collect_bound_stmts(lm.body, bound);
    var caps: string[] = [];
    var ri: i32 = 0;
    while (ri < refs.len()) {
        var nm: string = refs[ri];
        if (!contains_str(bound, nm) && !contains_str(caps, nm) && contains_str(cx.all_locals, nm)) {
            caps = caps.append(nm);
        }
        ri = ri + 1;
    }
    return caps;
}

// capture_kind classifies a closure capture by its release shape, shared by
// the construction-inc (at lambda build) and the per-capture release (at
// closure death) so the two are exactly balanced. Returns:
//   ""       — scalar / fn / map / option / tuple: not rc-released (skip)
//   "s"      — string (release via $__fern_arr_dec)
//   "a"      — scalar (i32) array (release via $__fern_arr_dec)
//   "p"      — pointer-element array, string[] / struct[] (one level via
//              $__fern_arr_dec_ptr)
//   "S:<T>"  — struct/enum value (deep release via $__fern_release_<T>)
// A capture not matched here is conservatively skipped (leak one level, sound).
function capture_kind(name: string, cx: Ctx): string {
    var svt: string = lookup_pair(cx.sv_names, cx.sv_types, name);
    if (svt.len() > 0 && (is_struct_type(cx.structs, svt) || (is_enum_type_name(cx, svt) && svt != "Option" && svt != "Result"))) {
        return "S:" + svt;
    }
    if (contains_str(cx.arr_src, name)) {
        // A struct/enum-element array capture deep-releases each element through
        // $__fern_arr_release_<Elem> (mirrors native arrElemStructDropName), so
        // the elements' own fields reclaim — not just the buffer. A string[]
        // (or other pointer-element) array frees one level (arr_dec_ptr); a
        // scalar array frees flat (arr_dec).
        var sae: string = lookup_pair(cx.sa_names, cx.sa_types, name);
        if (sae.len() > 0 && (is_struct_type(cx.structs, sae) || (is_enum_type_name(cx, sae) && sae != "Option" && sae != "Result"))) {
            return "A:" + sae;
        }
        if (contains_str(cx.str_arrays, name) || contains_str(cx.sa_names, name)) { return "p"; }
        return "a";
    }
    if (is_string_expr(parser.ExprIdent { name: name, line: 0, col: 0 }, cx)) { return "s"; }
    return "";
}

// capture_release_op emits the WAT that releases one capture (loaded from
// `load`) according to its kind — the death side of capture_kind.
function capture_release_op(kind: string, load: string): string {
    if (kind == "s" || kind == "a") { return " (drop (call $__fern_arr_dec " + load + "))"; }
    if (kind == "p") { return " (drop (call $__fern_arr_dec_ptr " + load + "))"; }
    if (kind.len() > 2 && kind[0:2] == "S:") { return " (drop (call $__fern_release_" + kind[2:kind.len()] + " " + load + "))"; }
    if (kind.len() > 2 && kind[0:2] == "A:") { return " (drop (call $__fern_arr_release_" + kind[2:kind.len()] + " " + load + "))"; }
    return "";
}

// tuple_kind_string builds the per-element kind tag for a tuple literal:
// one char per element, 's' for a string element, else 'i'.
// is_tuple_elem_array: a conservative "this expr is an rc-boxed array"
// test for tuple element kinds — only DEFINITELY-array shapes (an array
// literal, a non-string slice, or a bare ident in arr_src) so a mismarked
// scalar never gets a (corrupting) recursive dec. A missed array → 'i'
// (leak, sound).
function is_tuple_elem_array(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprSlice(_) => { return true; },
        parser.ExprIdent(id) => { return contains_str(cx.arr_src, id.name); },
        _ => { return false; }
    }
    return false;
}

// tuple_elem_array_is_ptr: is a tuple's array element a POINTER-element array
// (string[] / struct[]) — so its elements get deep-released via
// $__fern_arr_dec_ptr — rather than a scalar array (i32[]/i64[]/f64[], freed
// flat)? Soundness-critical and asymmetric: a false positive would dec scalar
// values as pointers (corruption), so this returns true ONLY when the element
// type is provably a pointer; anything unsure (an ExprSlice, an empty literal,
// a plain i32[] ident) stays flat (a missed deep-release only leaks).
function tuple_elem_array_is_ptr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.str_arrays, id.name) || contains_str(cx.sa_names, id.name); },
        parser.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return is_string_expr(arr.elements[0], cx) || struct_type_of(arr.elements[0], cx).len() > 0;
        },
        _ => { return false; },
    }
    return false;
}

// tuple_kind_string records a per-element kind char: 's' string, 'a'
// rc-boxed array, else 'i'. Drives `t.N` string typing (only 's' is read
// there) AND the tuple free recursive field-release (which dec's 'a'/'s'
// elements).
function tuple_kind_string(elements: parser.Expr[], cx: Ctx): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < elements.len()) {
        if (is_string_expr(elements[i], cx)) { out = out + "s"; }
        else if (is_tuple_elem_array(elements[i], cx)) {
            // 'A' = pointer-element array (deep-released via arr_dec_ptr),
            // 'a' = scalar array (freed flat). Asymmetric — only the proven
            // pointer case gets 'A' (a false 'A' on a scalar array corrupts).
            if (tuple_elem_array_is_ptr(elements[i], cx)) { out = out + "A"; }
            else { out = out + "a"; }
        }
        else { out = out + "i"; }
        i = i + 1;
    }
    return out;
}

// tuple_elem_is_string reports whether element `n` of a tuple expression
// is a string: from a tracked tuple local's kind string, or directly from
// a tuple literal's element.
function tuple_elem_is_string(obj: parser.Expr, n: i32, cx: Ctx): boolean {
    match (obj) {
        parser.ExprIdent(id) => {
            var ks: string = lookup_pair(cx.tup_names, cx.tup_kinds, id.name);
            return n >= 0 && n < ks.len() && ks[n] == 115;
        },
        parser.ExprTuple(t) => {
            return n >= 0 && n < t.elements.len() && is_string_expr(t.elements[n], cx);
        },
        _ => { return false; },
    }
    return false;
}

// collect_tuple_locals records each `var t = (…)` tuple local with its
// element-kind string (so `t.N` types correctly). Run after string locals
// are known. Returns cx with tup_names / tup_kinds extended.
function collect_tuple_locals(body: parser.Stmt[], cx: Ctx): Ctx {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                match (v.init) {
                    parser.ExprTuple(t) => {
                        if (!contains_str(cx.tup_names, v.name)) {
                            cx = Ctx { ...cx, tup_names: cx.tup_names.append(v.name), tup_kinds: cx.tup_kinds.append(tuple_kind_string(t.elements, cx)), tup_svtypes: cx.tup_svtypes.append(tuple_svtypes_csv(t.elements, cx)) };
                        }
                    },
                    // Array-of-tuple local: `var ps = [(a, b), …]`. Record the
                    // element tuple's shape (kinds + svtypes from the first
                    // literal element) so the exit sweep deep-releases each
                    // element tuple's pointer-bearing fields (native
                    // __drop_arr_tuple_), not just the array buffer flat.
                    parser.ExprArray(a) => {
                        if (a.elements.len() > 0 && !contains_str(cx.ta_names, v.name)) {
                            match (a.elements[0]) {
                                parser.ExprTuple(t0) => {
                                    cx = Ctx { ...cx, ta_names: cx.ta_names.append(v.name), ta_kinds: cx.ta_kinds.append(tuple_kind_string(t0.elements, cx)), ta_svtypes: cx.ta_svtypes.append(tuple_svtypes_csv(t0.elements, cx)) };
                                },
                                _ => {},
                            }
                        }
                    },
                    _ => {},
                }
            },
            parser.StmtIf(f) => {
                cx = collect_tuple_locals(f.then_body, cx);
                cx = collect_tuple_locals(f.else_body, cx);
            },
            parser.StmtWhile(w) => { cx = collect_tuple_locals(w.body, cx); },
            parser.StmtFor(f) => { cx = collect_tuple_locals(f.body, cx); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    cx = collect_tuple_locals(m.arms[k].body, cx);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return cx;
}

// is_clock_builtin is true for the wall-clock / monotonic builtins, which
// all return i64 (their values exceed the i32 range).
function is_clock_builtin(name: string): boolean {
    return name == "now_unix_ms" || name == "monotonic_ns" || name == "now_ns";
}

// is_i64_expr is true when an expression evaluates to an i64 value: a
// clock builtin, an i64-typed local/param, a call to an i64-returning
// function, an i64 method return, a unary minus on an i64, or an
// arithmetic binary op with an i64 operand. Comparisons / logical ops
// yield an i32 bool even over i64 operands, so they are NOT i64.
function is_i64_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => {
            if (contains_str(cx.i64_names, id.name)) { return true; }
            return is_const_ref(cx, id.name) && zero_arg_func_ret(cx, id.name) == "i64";
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return is_i64_expr(u.operand, cx); }
            if (u.op == "as_i64" || u.op == "as_u64") { return true; }
            return false;
        },
        parser.ExprBinary(b) => {
            if (is_int_binop(b.op)) {
                return is_i64_expr(b.left, cx) || is_i64_expr(b.right, cx);
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (is_clock_builtin(id.name)) { return true; }
                    if (id.name == "f64_bits") { return true; }
                    return contains_str(cx.i64_funcs, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    return method_ret(cx, struct_type_of(fa.obj, cx), fa.field) == "i64";
                },
                _ => { return false; },
            }
        },
        parser.ExprIndex(ix) => { return array_elem_kind(ix.array, cx) == "i64"; },
        _ => { return false; },
    }
    return false;
}

// is_int_binop is true for the integer binary ops whose RESULT is an
// integer (arithmetic + bitwise) — so an i64 operand makes the whole
// expression i64. Comparisons (i32 bool result) are excluded.
function is_int_binop(op: string): boolean {
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
        || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>";
}

// wasm_binop_i64 maps a Fern operator to its i64 wasm instruction. Div /
// rem route to the guarded i64 helpers (mirroring the i32 ops);
// comparisons / logical ops produce an i32 result from i64 operands.
function wasm_binop_i64(op: string): string {
    if (op == "+") { return "i64.add"; }
    if (op == "-") { return "i64.sub"; }
    if (op == "*") { return "i64.mul"; }
    if (op == "/") { return "call $__fern_idiv64"; }
    if (op == "%") { return "call $__fern_irem64"; }
    if (op == "<") { return "i64.lt_s"; }
    if (op == "<=") { return "i64.le_s"; }
    if (op == ">") { return "i64.gt_s"; }
    if (op == ">=") { return "i64.ge_s"; }
    if (op == "==") { return "i64.eq"; }
    if (op == "!=") { return "i64.ne"; }
    if (op == "&") { return "i64.and"; }
    if (op == "|") { return "i64.or"; }
    if (op == "^") { return "i64.xor"; }
    if (op == "<<") { return "i64.shl"; }
    if (op == ">>") { return "i64.shr_s"; }
    return "i64.add";
}

// emit_i64 lowers an expression to an instruction tree that yields an
// i64 value. The i64 shapes (number literal, i64 local, i64 arithmetic,
// unary minus, clock / i64-function call) are emitted with i64 ops; any
// other (i32-producing) sub-expression is widened with i64.extend_i32_s
// so it can feed an i64 operand (e.g. `bigI64 - smallI32`).
function emit_i64(e: parser.Expr, cx: Ctx, depth: i32): string {
    match (e) {
        parser.ExprNumber(n) => {
            return "(i64.const " + n.text + ")";
        },
        parser.ExprIdent(id) => {
            if (contains_str(cx.i64_names, id.name)) {
                return "(local.get $" + id.name + ")";
            }
            if (is_const_ref(cx, id.name) && zero_arg_func_ret(cx, id.name) == "i64") {
                return "(call $" + id.name + ")";
            }
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                return "(i64.sub (i64.const 0) " + emit_i64(u.operand, cx, depth) + ")";
            }
            if (u.op == "as_i64" || u.op == "as_u64") {
                // `x as i64`: from f64 truncate, from i64 pass through,
                // from i32 sign-extend (the emit_i64 default).
                if (is_f64_expr(u.operand, cx)) {
                    return "(i64.trunc_f64_s " + emit_f64(u.operand, cx, depth) + ")";
                }
                if (is_i64_expr(u.operand, cx)) {
                    return emit_i64(u.operand, cx, depth);
                }
                return "(i64.extend_i32_s " + emit_expr(u.operand, cx, depth) + ")";
            }
        },
        parser.ExprBinary(b) => {
            if (is_int_binop(b.op)) {
                return "(" + wasm_binop_i64(b.op) + " " + emit_i64(b.left, cx, depth) + " " + emit_i64(b.right, cx, depth) + ")";
            }
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (id.name == "now_unix_ms" && c.args.len() == 0) { return "(call $__fern_now_unix_ms)"; }
                    if (id.name == "monotonic_ns" && c.args.len() == 0) { return "(call $__fern_monotonic_ns)"; }
                    if (id.name == "now_ns" && c.args.len() == 0) { return "(call $__fern_now_ns)"; }
                    if (id.name == "f64_bits" && c.args.len() == 1) {
                        // reinterpret an f64's IEEE-754 bits as i64.
                        return "(i64.reinterpret_f64 " + emit_f64(c.args[0], cx, depth) + ")";
                    }
                    if (contains_str(cx.i64_funcs, id.name)) {
                        var s: string = "(call $" + id.name;
                        var i: i32 = 0;
                        while (i < c.args.len()) {
                            if (func_param_is_i64(cx, id.name, i)) {
                                s = s + " " + emit_i64(c.args[i], cx, depth + 1);
                            } else {
                                s = s + " " + emit_expr(c.args[i], cx, depth);
                            }
                            i = i + 1;
                        }
                        return s + ")";
                    }
                },
                _ => {},
            }
        },
        parser.ExprIndex(ix) => {
            // i64[] element read — 8-byte slot, i64.load.
            if (array_elem_kind(ix.array, cx) == "i64") {
                return "(i64.load (i32.add (i32.add " + emit_expr(ix.array, cx, depth) + " (i32.const 8)) (i32.mul " + emit_expr(ix.index, cx, depth) + " (i32.const 8))))";
            }
        },
        _ => {},
    }
    // i32-producing expression in an i64 context — widen it.
    return "(i64.extend_i32_s " + emit_expr(e, cx, depth) + ")";
}

// is_float_type names the floating-point spellings (all lowered to f64 —
// matching the native backends, which carry no distinct f32).
function is_float_type(t: string): boolean {
    return t == "f64" || t == "f32" || t == "float";
}

// is_cast_to is true when a unary op is the `as <ty>` cast desugar
// (`as_<ty>`) targeting `ty` (e.g. is_cast_to(u.op, "f64")).
function is_cast_op(op: string): boolean {
    return op.len() > 3 && op[0:3] == "as_";
}

function cast_target(op: string): string {
    return op[3:] + "";
}

// is_f64_math_builtin names the math intrinsics with a direct wasm f64
// instruction (sin/cos/exp/log/pow have no primitive and are deferred).
function is_f64_math_builtin(name: string): boolean {
    return name == "__sqrt_f64" || name == "__floor_f64" || name == "__ceil_f64"
        || name == "__trunc_f64" || name == "__round_f64" || name == "__abs_f64";
}

function f64_math_instr(name: string): string {
    if (name == "__sqrt_f64") { return "f64.sqrt"; }
    if (name == "__floor_f64") { return "f64.floor"; }
    if (name == "__ceil_f64") { return "f64.ceil"; }
    if (name == "__trunc_f64") { return "f64.trunc"; }
    if (name == "__round_f64") { return "f64.nearest"; }
    return "f64.abs";
}

// is_f64_expr is true when an expression evaluates to an f64 value: a
// float literal, an f64-typed local/param, an f64-returning function /
// method, an `as f64` cast, a unary minus on an f64, an f64 math
// builtin, or an arithmetic binary op with an f64 operand. Comparisons
// yield an i32 bool even over f64 operands, so they are NOT f64.
function is_f64_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprNumber(n) => {
            return n.is_float;
        },
        parser.ExprIdent(id) => {
            if (contains_str(cx.f64_names, id.name)) { return true; }
            return is_const_ref(cx, id.name) && is_float_type(zero_arg_func_ret(cx, id.name));
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return is_f64_expr(u.operand, cx); }
            if (is_cast_op(u.op)) { return is_float_type(cast_target(u.op)); }
            return false;
        },
        parser.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return is_f64_expr(b.left, cx) || is_f64_expr(b.right, cx);
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (is_f64_math_builtin(id.name)) { return true; }
                    if (id.name == "f64_from_bits") { return true; }
                    return contains_str(cx.f64_funcs, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    return is_float_type(method_ret(cx, struct_type_of(fa.obj, cx), fa.field));
                },
                _ => { return false; },
            }
        },
        parser.ExprIndex(ix) => { return array_elem_kind(ix.array, cx) == "f64"; },
        _ => { return false; },
    }
    return false;
}

// wasm_binop_f64 maps a Fern operator to its f64 wasm instruction;
// comparisons produce an i32 result from f64 operands. (Float `%` is not
// a primitive and is not supported.)
function wasm_binop_f64(op: string): string {
    if (op == "+") { return "f64.add"; }
    if (op == "-") { return "f64.sub"; }
    if (op == "*") { return "f64.mul"; }
    if (op == "/") { return "f64.div"; }
    if (op == "<") { return "f64.lt"; }
    if (op == "<=") { return "f64.le"; }
    if (op == ">") { return "f64.gt"; }
    if (op == ">=") { return "f64.ge"; }
    if (op == "==") { return "f64.eq"; }
    if (op == "!=") { return "f64.ne"; }
    return "f64.add";
}

// emit_f64 lowers an expression to an instruction tree yielding an f64
// value. Any int-producing sub-expression in an f64 context is converted
// (f64.convert_i32_s / _i64_s), so `3.5 + n` and an int passed to an f64
// param both work.
function emit_f64(e: parser.Expr, cx: Ctx, depth: i32): string {
    match (e) {
        parser.ExprNumber(n) => {
            return "(f64.const " + n.text + ")";
        },
        parser.ExprIdent(id) => {
            if (contains_str(cx.f64_names, id.name)) {
                return "(local.get $" + id.name + ")";
            }
            if (is_const_ref(cx, id.name) && is_float_type(zero_arg_func_ret(cx, id.name))) {
                return "(call $" + id.name + ")";
            }
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                return "(f64.neg " + emit_f64(u.operand, cx, depth) + ")";
            }
            if (is_cast_op(u.op) && is_float_type(cast_target(u.op))) {
                return emit_f64(u.operand, cx, depth);
            }
        },
        parser.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return "(" + wasm_binop_f64(b.op) + " " + emit_f64(b.left, cx, depth) + " " + emit_f64(b.right, cx, depth) + ")";
            }
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (is_f64_math_builtin(id.name) && c.args.len() == 1) {
                        return "(" + f64_math_instr(id.name) + " " + emit_f64(c.args[0], cx, depth) + ")";
                    }
                    if (id.name == "f64_from_bits" && c.args.len() == 1) {
                        // reinterpret an i64's bits as an IEEE-754 f64.
                        return "(f64.reinterpret_i64 " + emit_i64(c.args[0], cx, depth) + ")";
                    }
                    if (contains_str(cx.f64_funcs, id.name)) {
                        var s: string = "(call $" + id.name;
                        var i: i32 = 0;
                        while (i < c.args.len()) {
                            if (func_param_is_f64(cx, id.name, i)) {
                                s = s + " " + emit_f64(c.args[i], cx, depth + 1);
                            } else {
                                s = s + " " + emit_expr(c.args[i], cx, depth);
                            }
                            i = i + 1;
                        }
                        return s + ")";
                    }
                },
                _ => {},
            }
        },
        parser.ExprIndex(ix) => {
            // f64[] element read — 8-byte slot, f64.load.
            if (array_elem_kind(ix.array, cx) == "f64") {
                return "(f64.load (i32.add (i32.add " + emit_expr(ix.array, cx, depth) + " (i32.const 8)) (i32.mul " + emit_expr(ix.index, cx, depth) + " (i32.const 8))))";
            }
        },
        _ => {},
    }
    // int-producing expression in an f64 context — convert it.
    if (is_i64_expr(e, cx)) {
        return "(f64.convert_i64_s " + emit_i64(e, cx, depth) + ")";
    }
    return "(f64.convert_i32_s " + emit_expr(e, cx, depth) + ")";
}

// has_method / method_ret look a receiver method (receiver-type T, name n)
// up in the registry (parallel mr_types / mr_names / mr_rets).
function has_method(cx: Ctx, t: string, n: string): boolean {
    var i: i32 = 0;
    while (i < cx.mr_types.len()) {
        if (cx.mr_types[i] == t && cx.mr_names[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}

// wasm_result_type maps a Fern return-type spelling to the wasm value type
// a dispatch `(block (result …))` should carry: f64 for floats, i64 for
// i64, else i32 (covers i32 / bool / string / heap-pointer returns).
function wasm_result_type(ret: string): string {
    if (is_float_type(ret)) { return "f64"; }
    if (ret == "i64") { return "i64"; }
    return "i32";
}

// wasm_zero emits the zero literal of a wasm value type — the innermost
// (no-variant-matched) arm of a runtime dispatch chain.
function wasm_zero(wt: string): string {
    if (wt == "f64") { return "(f64.const 0)"; }
    if (wt == "i64") { return "(i64.const 0)"; }
    return "(i32.const 0)";
}

// wat_extern_valtype maps a Fern type spelling to the wasm value type used in
// an `@import` extern's core signature (bring-your-own WIT, P4 —
// docs/WIT-BRING-YOUR-OWN.md): 64-bit ints lower to i64, floats to f64, and
// everything else (i32 / bool / char / handle / heap pointer) to i32.
function wat_extern_valtype(t: string): string {
    if (is_float_type(t)) { return "f64"; }
    if (t == "i64" || t == "u64" || t == "s64") { return "i64"; }
    return "i32";
}

// extern_imports emits the core wasm function imports for the module's
// `@import` extern declarations (P4). A body-less `@import("iface", "wit")`
// function becomes `(import "iface" "wit" (func $name (param …) (result …)))`;
// a call to the function resolves to `$name` like any free function. These are
// preview-2 component imports — the world-driven composer wires them.
// is_extern_composite_ret is true for the `@import` extern result types that
// use the canonical return-area lowering (P4c): a string, a u8[] (list<u8>),
// a numeric array (list<T> with T's slot == canonical size), or a record
// (materialized into a self-host struct).
function is_extern_composite_ret(mod: parser.Module, t: string): boolean {
    return t == "string" || t == "u8[]" || t == "boolean[]" || extern_array_param_supported(t) || extern_record_result_supported(mod, t) || extern_sum_param_supported(t) || extern_variant_result_supported(mod, t);
}

// extern_array_param_supported is true for an `@import` array parameter whose
// element's canonical size equals its self-host slot size (i32/u32/f32 slot 4,
// i64/u64/f64 slot 8). The wrapper copies the elements into a freshly 8-aligned
// buffer and passes (buf, len): the self-host heap isn't aligned, but the
// canonical list<T> (T wider than a byte) requires an aligned data pointer.
// u8 (slot 4 != canonical 1) would also need repacking — see
// extern_byte_array_param for that path.
function extern_array_param_supported(t: string): boolean {
    if (t.len() <= 2 || t[t.len() - 2:t.len()] != "[]") { return false; }
    var k: str = t[0:t.len() - 2];
    return k == "i32" || k == "u32" || k == "i64" || k == "u64" || k == "f32" || k == "f64";
}

// extern_byte_array_param is true for an `@import` u8[] or boolean[] parameter.
// The self-host stores both element kinds one-per-4-byte-slot (byte values
// widened to i32; a bool is 0/1), but the canonical list<u8> / list<bool> wants
// them packed one byte each. So unlike the wider arrays (whose self-host slot
// already matches the canonical element size and only need an aligned copy), a
// byte array needs a byte-repacking copy: the wrapper allocs `len` bytes and
// writes each element's low byte. Alignment is moot for 1-byte elements.
function extern_byte_array_param(t: string): boolean {
    return t == "u8[]" || t == "boolean[]";
}

// extern_record_param_supported is true for an `@import` record (struct)
// parameter the wrapper can flatten to its fields. A self-host struct value is
// [type-id@0][field@+4 each in a 4-byte slot]. The canonical record flattens to
// one i32 per field, including the sub-word integer (u8), which the
// wrapper reads with a width+sign-aware load (extern_field_load_op) so the
// pushed i32 is correctly zero-extended. Scoped to 1..16 fields, each an
// 8-/32-bit integer.
// extern_field_is_scalar reports whether a record field type is a flattenable
// scalar (an 8-/32-bit integer — every self-host slot is i32-class).
function extern_field_is_scalar(ft: string): boolean {
    return ft == "i32" || ft == "u32" || ft == "u8" || ft == "boolean";
}

// extern_record_leaf_count is the total number of flattened scalar leaves of a
// record, recursing into nested record fields to arbitrary depth. Both record
// params and results flatten nested records inline to arbitrary depth, so the
// count recurses fully.
function extern_record_leaf_count(mod: parser.Module, t: string): i32 {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == t) {
            var n: i32 = mod.structs[i].fields.len();
            var leaves: i32 = 0;
            var j: i32 = 0;
            while (j < n) {
                var ft: string = mod.structs[i].fields[j].type_name;
                if (extern_field_is_scalar(ft)) { leaves = leaves + 1; }
                else { leaves = leaves + extern_record_leaf_count(mod, ft); }
                j = j + 1;
            }
            return leaves;
        }
        i = i + 1;
    }
    return 0;
}

// extern_record_nestable reports whether `t` is a record (struct) lowerable as a
// nested record field to arbitrary depth: 1..16 fields, each a flattenable scalar
// OR itself a nestable record. Gates both nested params and nested results.
function extern_record_nestable(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == t) {
            var n: i32 = mod.structs[i].fields.len();
            if (n == 0 || n > 16) { return false; }
            var j: i32 = 0;
            while (j < n) {
                var ft: string = mod.structs[i].fields[j].type_name;
                if (!extern_field_is_scalar(ft) && !extern_record_nestable(mod, ft)) { return false; }
                j = j + 1;
            }
            return true;
        }
        i = i + 1;
    }
    return false;
}

// extern_record_depth is the maximum record-nesting depth of result struct `t`:
// 0 if all fields are scalar, 1 for one level of nested records, N for N levels.
// Used to reserve one scratch inner-struct local per level in the result wrapper.
function extern_record_depth(mod: parser.Module, t: string): i32 {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == t) {
            var n: i32 = mod.structs[i].fields.len();
            var maxd: i32 = 0;
            var j: i32 = 0;
            while (j < n) {
                var ft: string = mod.structs[i].fields[j].type_name;
                if (!extern_field_is_scalar(ft)) {
                    var d: i32 = 1 + extern_record_depth(mod, ft);
                    if (d > maxd) { maxd = d; }
                }
                j = j + 1;
            }
            return maxd;
        }
        i = i + 1;
    }
    return 0;
}

// extern_record_param_supported is true for a record (struct) `@import`
// parameter the wrapper can flatten. Each field is a flattenable scalar, OR a
// nested record (flattened inline by the canonical ABI, to **arbitrary depth**
// via extern_record_nestable). Scoped to 1..16 fields and 1..16 total leaves.
function extern_record_param_supported(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == t) {
            var n: i32 = mod.structs[i].fields.len();
            if (n == 0 || n > 16) { return false; }
            var j: i32 = 0;
            while (j < n) {
                var ft: string = mod.structs[i].fields[j].type_name;
                if (!extern_field_is_scalar(ft) && !extern_record_nestable(mod, ft)) { return false; }
                j = j + 1;
            }
            var leaves: i32 = extern_record_leaf_count(mod, t);
            return leaves >= 1 && leaves <= 16;
        }
        i = i + 1;
    }
    return false;
}

// extern_record_result_supported is the result-side gate: 1..16 fields, each a
// scalar (8-/32-bit integer) OR a nested record (flattened inline by the
// canonical ABI, to **arbitrary depth** via extern_record_nestable). The
// sub-word field (u8) is supported via a dual layout — the canonical
// return-area packs it at its natural 1-byte size + alignment
// (extern_canon_top_off / extern_canon_record_size_nested), which differs from
// the self-host struct's 4-byte slots; the wrapper reads it with a
// width-aware load and stores it into the wider slot, allocating a separate
// inner struct per nested node (one scratch local per nesting level).
//
// Single-leaf-via-nested is rejected: a 1-leaf record returns by value (Direct),
// but the by-value wrapper can't reconstruct a nested struct, so only a single
// *scalar* field is Direct-eligible (mirrors the Go ExternRecordResult path).
function extern_record_result_supported(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == t) {
            var n: i32 = mod.structs[i].fields.len();
            if (n == 0 || n > 16) { return false; }
            var j: i32 = 0;
            while (j < n) {
                var ft: string = mod.structs[i].fields[j].type_name;
                if (!extern_field_is_scalar(ft) && !extern_record_nestable(mod, ft)) { return false; }
                j = j + 1;
            }
            var leaves: i32 = extern_record_leaf_count(mod, t);
            if (leaves < 1 || leaves > 16) { return false; }
            var direct_scalar: boolean = n == 1 && extern_field_is_scalar(mod.structs[i].fields[0].type_name);
            if (leaves == 1 && !direct_scalar) { return false; }
            return true;
        }
        i = i + 1;
    }
    return false;
}

// extern_plain_enum_param is true for a "plain" user enum @import parameter — an
// enum (in mod.enums) with >=1 variant, all payloadless (each variant desugars
// to a 0-field struct). It maps to a WIT `enum`, which flattens to a single i32
// discriminant = the variant index. A self-host payloadless enum value is a
// pointer to a `[struct_id@0]` box, but struct_id is a *global* id, not the
// variant index, so the wrapper maps it (extern_plain_enum_disc).
function extern_plain_enum_param(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == t) {
            var n: i32 = mod.enums[i].variant_names.len();
            if (n == 0) { return false; }
            var j: i32 = 0;
            while (j < n) {
                var vn: string = mod.enums[i].variant_names[j];
                if (!is_struct_type(mod.structs, vn) || struct_field_count(mod.structs, vn) != 0) { return false; }
                j = j + 1;
            }
            return true;
        }
        i = i + 1;
    }
    return false;
}

// extern_variant_param_supported is true for a general user-enum @import
// parameter that flattens like Result to (disc, payload): a user enum (in
// mod.enums) where every variant is a 0-field struct (payloadless) or a 1-field
// struct whose field is i32/u32, all single-payloads uniform (the self-host slot
// is i32 anyway), with at least one payloaded variant (else it's a plain enum).
// The wrapper maps struct_id → variant index (extern_plain_enum_disc) for the
// disc and reads the payload at struct_field_off(0); for a payloadless-case
// value the payload read yields ignored garbage (the host drops it).
function extern_variant_param_supported(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == t) {
            var n: i32 = mod.enums[i].variant_names.len();
            if (n == 0) { return false; }
            var anyp: boolean = false;
            var maxf: i32 = 0;
            var j: i32 = 0;
            while (j < n) {
                var vn: string = mod.enums[i].variant_names[j];
                if (!is_struct_type(mod.structs, vn)) { return false; }
                var fc: i32 = struct_field_count(mod.structs, vn);
                if (fc > maxf) { maxf = fc; }
                if (fc >= 1) { anyp = true; }
                j = j + 1;
            }
            if (!anyp) { return false; }
            if (maxf >= 2) {
                // Multi-field variant (a case carries >=2 payloads, in WIT a
                // tuple): joins to maxf i32 slots. Scoped to i32/u32 fields.
                var k: i32 = 0;
                while (k < n) {
                    var vn2: string = mod.enums[i].variant_names[k];
                    var fcc: i32 = struct_field_count(mod.structs, vn2);
                    var fj: i32 = 0;
                    while (fj < fcc) {
                        var ft2: string = struct_field_type_at(mod.structs, vn2, fj);
                        if (ft2 != "i32" && ft2 != "u32") { return false; }
                        fj = fj + 1;
                    }
                    k = k + 1;
                }
                return true;
            }
            // Single-field arms (0 or 1 payload): i32/u32 (4-byte), i64/u64 or
            // f64 (8-byte, S1 wide slot). A mixed-width set joins to an i64
            // canonical slot (per-arm extend/load — an f64 arm reinterprets via
            // the i64 bit-load); a uniform i32 set keeps the i32 join. An f32
            // arm (stored in the box as an 8-byte f64 — the self-host has no
            // distinct f32) is accepted only in the S2 shape checked below.
            var any_f32: boolean = false;
            var any_i32: boolean = false;
            var any_64: boolean = false;
            var k2: i32 = 0;
            while (k2 < n) {
                var vn3: string = mod.enums[i].variant_names[k2];
                if (struct_field_count(mod.structs, vn3) == 1) {
                    var ft3: string = struct_field_type_at(mod.structs, vn3, 0);
                    if (ft3 != "i32" && ft3 != "u32" && ft3 != "i64" && ft3 != "u64" && ft3 != "f64" && ft3 != "f32") { return false; }
                    if (ft3 == "f32") { any_f32 = true; }
                    if (ft3 == "i32" || ft3 == "u32") { any_i32 = true; }
                    if (ft3 == "i64" || ft3 == "u64" || ft3 == "f64") { any_64 = true; }
                }
                k2 = k2 + 1;
            }
            // S2 f32 scope (#5327): only the non-uniform same-width shape
            // `{ i(s32), f(f32) }` — the f32 arm rides the canonical 32-bit
            // i32 join via a demote+reinterpret bridge, so the variant must
            // ALSO carry an i32/u32 payload arm (keeping the join i32) and NO
            // 64-bit arm. Still deferred: a uniform-f32 variant (its canonical
            // join is an f32 signature slot, which the self-host — no distinct
            // f32 — can't carry) and an f32 arm mixed with a 64-bit arm (a
            // 4-vs-8-byte impedance against the i64 join).
            if (any_f32 && (!any_i32 || any_64)) { return false; }
            // A uniform-f64 variant (every payloaded arm f64) is accepted too: it
            // joins to an f64 canonical slot (not the i64 bit-container the mixed-
            // width path emits) — see extern_variant_is_uniform_f64 + the f64-join
            // branches in the import sig / param push / result wrapper.
            return true;
        }
        i = i + 1;
    }
    return false;
}

// extern_variant_max_fields returns the maximum payload-field count across a
// supported variant's arms (the multi-field SlotCount); 1 (or 0) for a
// single-field variant.
function extern_variant_max_fields(mod: parser.Module, t: string): i32 {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == t) {
            var n: i32 = mod.enums[i].variant_names.len();
            var maxf: i32 = 0;
            var j: i32 = 0;
            while (j < n) {
                var fc: i32 = struct_field_count(mod.structs, mod.enums[i].variant_names[j]);
                if (fc > maxf) { maxf = fc; }
                j = j + 1;
            }
            return maxf;
        }
        i = i + 1;
    }
    return 0;
}

// extern_variant_is_multifield is true when a supported variant has any arm with
// >=2 payload fields — it joins to SlotCount=max_fields i32 slots rather than the
// single (disc, payload) slot.
function extern_variant_is_multifield(mod: parser.Module, t: string): boolean {
    return extern_variant_max_fields(mod, t) >= 2;
}

// extern_variant_multifield_slot builds slot j of a multi-field variant @import
// parameter: a lazy if/else chain on the box struct_id that, for the matched arm,
// i32.loads its field j (at struct_field_off(j)) if it has one, else 0 (padding a
// shorter arm). Lazy (not select): a shorter arm's box has no slot j, so the
// non-matched branches must not read it.
function extern_variant_multifield_slot(mod: parser.Module, t: string, j: i32, boxloc: string): string {
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].name == t) {
            var n: i32 = mod.enums[ei].variant_names.len();
            var acc: string = extern_variant_arm_slot(mod, mod.enums[ei].variant_names[n - 1], j, boxloc);
            var k: i32 = n - 2;
            while (k >= 0) {
                var sid: i32 = struct_id(mod.structs, mod.enums[ei].variant_names[k]);
                acc = "(if (result i32) (i32.eq (i32.load (local.get " + boxloc + ")) (i32.const " + util.i32_to_string(sid) + ")) (then " + extern_variant_arm_slot(mod, mod.enums[ei].variant_names[k], j, boxloc) + ") (else " + acc + "))";
                k = k - 1;
            }
            return acc;
        }
        ei = ei + 1;
    }
    return "(i32.const 0)";
}

// extern_variant_arm_slot emits one arm's slot-j value: i32.load at
// struct_field_off(j) if the arm has a field j, else i32.const 0 (padding).
function extern_variant_arm_slot(mod: parser.Module, vn: string, j: i32, boxloc: string): string {
    if (j < struct_field_count(mod.structs, vn)) {
        return "(i32.load (i32.add (local.get " + boxloc + ") (i32.const " + util.i32_to_string(struct_field_off(j)) + ")))";
    }
    return "(i32.const 0)";
}

// extern_variant_join_is64 is true when a supported variant's canonical payload
// join is i64 — i.e. at least one payloaded arm carries a 64-bit (i64/u64)
// field. A uniform i32 variant joins to i32 (the original single-slot path); a
// set with any 64-bit arm joins to i64 (mixed-width: per-arm extend/load).
function extern_variant_join_is64(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == t) {
            var n: i32 = mod.enums[i].variant_names.len();
            var j: i32 = 0;
            while (j < n) {
                var vn: string = mod.enums[i].variant_names[j];
                if (struct_field_count(mod.structs, vn) == 1) {
                    var ft: string = struct_field_type_at(mod.structs, vn, 0);
                    if (ft == "i64" || ft == "u64" || ft == "f64") { return true; }
                }
                j = j + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// extern_variant_is_uniform_f64 is true when EVERY payloaded arm of a supported
// variant carries an f64 (>=1 such arm). Its canonical join is an f64 slot — so
// it takes the f64-join path (an f64 import param, an f64.load of the box payload)
// rather than the i64 bit-container the mixed-width path emits. Checked BEFORE
// extern_variant_join_is64 (which also fires for an f64 arm).
function extern_variant_is_uniform_f64(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == t) {
            var n: i32 = mod.enums[i].variant_names.len();
            var anyp: boolean = false;
            var j: i32 = 0;
            while (j < n) {
                var vn: string = mod.enums[i].variant_names[j];
                if (struct_field_count(mod.structs, vn) == 1) {
                    if (struct_field_type_at(mod.structs, vn, 0) != "f64") { return false; }
                    anyp = true;
                }
                j = j + 1;
            }
            return anyp;
        }
        i = i + 1;
    }
    return false;
}

// extern_variant_has_f32_arm is true when a supported variant carries an f32
// single-field arm. Its canonical join stays the 32-bit i32 slot (the gate
// requires a sibling i32/u32 arm and no 64-bit arm — the S2 scope), but the
// box stores an f32 payload widened to an 8-byte f64 (the self-host has no
// distinct f32), so every i32-join read/write of the payload needs the
// demote+reinterpret bridge (extern_variant_payload_join_i32_f32 on the param
// side, extern_variant_result_store_f32 on the result side).
function extern_variant_has_f32_arm(mod: parser.Module, t: string): boolean {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == t) {
            var n: i32 = mod.enums[i].variant_names.len();
            var j: i32 = 0;
            while (j < n) {
                var vn: string = mod.enums[i].variant_names[j];
                if (struct_field_count(mod.structs, vn) == 1 && struct_field_type_at(mod.structs, vn, 0) == "f32") { return true; }
                j = j + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// extern_variant_payload_join_i64 builds the i64 canonical-join value for a
// variant @import parameter whose join is i64: a lazy if/else chain on the box's
// struct_id that, for the matched arm, loads the payload at offset 4 and coerces
// it to i64 — an i64/u64 arm `i64.load`s it directly; a 32-bit arm `i32.load`s +
// zero-extends; a payloadless arm contributes 0 (the host drops it). The chain
// MUST be if/else (not select): the arms read the box at different widths, and
// only the matched arm's box is wide enough, so non-taken branches must not run.
function extern_variant_payload_join_i64(mod: parser.Module, t: string, boxloc: string): string {
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].name == t) {
            var n: i32 = mod.enums[ei].variant_names.len();
            var acc: string = extern_variant_arm_join_i64(mod, mod.enums[ei].variant_names[n - 1], boxloc);
            var k: i32 = n - 2;
            while (k >= 0) {
                var sid: i32 = struct_id(mod.structs, mod.enums[ei].variant_names[k]);
                acc = "(if (result i64) (i32.eq (i32.load (local.get " + boxloc + ")) (i32.const " + util.i32_to_string(sid) + ")) (then " + extern_variant_arm_join_i64(mod, mod.enums[ei].variant_names[k], boxloc) + ") (else " + acc + "))";
                k = k - 1;
            }
            return acc;
        }
        ei = ei + 1;
    }
    return "(i64.const 0)";
}

// extern_variant_arm_join_i64 emits one arm's payload coerced to the i64 join:
// i64.load for a 64-bit field, i64.extend_i32_u(i32.load) for a 32-bit field,
// i64.const 0 for a payloadless arm. Payload sits at struct_field_off(0) = 4.
function extern_variant_arm_join_i64(mod: parser.Module, vn: string, boxloc: string): string {
    if (struct_field_count(mod.structs, vn) == 1) {
        var ft: string = struct_field_type_at(mod.structs, vn, 0);
        // A 64-bit arm (i64/u64, or an f64 read as its raw bits) loads i64
        // directly; a 32-bit arm zero-extends. The box holds an f64 payload's
        // bits, so i64.load is the value-preserving reinterpret the canonical
        // f64->i64 coercion wants.
        if (ft == "i64" || ft == "u64" || ft == "f64") {
            return "(i64.load offset=4 (local.get " + boxloc + "))";
        }
        return "(i64.extend_i32_u (i32.load offset=4 (local.get " + boxloc + ")))";
    }
    return "(i64.const 0)";
}

// extern_variant_payload_join_i32_f32 builds the i32 canonical-join value for a
// variant @import parameter that carries an f32 arm (the join is still i32 —
// the gate's S2 scope): a lazy if/else chain on the box's struct_id that, for
// the matched arm, reads the payload at offset 4 — an f32 arm f64.loads its
// widened payload and bridges it to the join (f32.demote_f64 then
// i32.reinterpret_f32, the canonical f32→i32 bit coercion); an i32/u32 arm
// i32.loads directly; a payloadless arm contributes 0 (the host drops it). The
// chain MUST be if/else (not select), same as extern_variant_payload_join_i64:
// the arms read the box at different widths, and only the matched arm's box is
// wide enough, so non-taken branches must not run. Used only when
// extern_variant_has_f32_arm — an f32-free variant keeps the single
// unconditional i32.load (byte-identical output).
function extern_variant_payload_join_i32_f32(mod: parser.Module, t: string, boxloc: string): string {
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].name == t) {
            var n: i32 = mod.enums[ei].variant_names.len();
            var acc: string = extern_variant_arm_join_i32_f32(mod, mod.enums[ei].variant_names[n - 1], boxloc);
            var k: i32 = n - 2;
            while (k >= 0) {
                var sid: i32 = struct_id(mod.structs, mod.enums[ei].variant_names[k]);
                acc = "(if (result i32) (i32.eq (i32.load (local.get " + boxloc + ")) (i32.const " + util.i32_to_string(sid) + ")) (then " + extern_variant_arm_join_i32_f32(mod, mod.enums[ei].variant_names[k], boxloc) + ") (else " + acc + "))";
                k = k - 1;
            }
            return acc;
        }
        ei = ei + 1;
    }
    return "(i32.const 0)";
}

// extern_variant_arm_join_i32_f32 emits one arm's payload coerced to the i32
// join: the demote+reinterpret bridge for an f32 field (the box holds it as an
// 8-byte f64 at struct_field_off(0) = 4), a plain i32.load for a 32-bit field,
// i32.const 0 for a payloadless arm.
function extern_variant_arm_join_i32_f32(mod: parser.Module, vn: string, boxloc: string): string {
    if (struct_field_count(mod.structs, vn) == 1) {
        if (struct_field_type_at(mod.structs, vn, 0) == "f32") {
            return "(i32.reinterpret_f32 (f32.demote_f64 (f64.load offset=4 (local.get " + boxloc + "))))";
        }
        return "(i32.load offset=4 (local.get " + boxloc + "))";
    }
    return "(i32.const 0)";
}

// extern_variant_result_store_f32 builds the payload store for an i32-join
// variant result that carries an f32 arm: an if/else chain on the wire disc $d
// (the variant index) that, for an f32 arm, bridges the host's i32 payload —
// the f32's raw bits — into the box's 8-byte f64 slot (f32.reinterpret_i32
// then f64.promote_f32, so the S1 f64.load match bind recovers the float); for
// every other arm it copies the i32 payload (unread garbage for a payloadless
// arm, exactly as on the f32-free i32-join path). Reads the host payload at
// offset 4 of $rb (the i32-join return area), stores at offset 4 of $s.
function extern_variant_result_store_f32(mod: parser.Module, t: string): string {
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].name == t) {
            var n: i32 = mod.enums[ei].variant_names.len();
            var acc: string = extern_variant_result_store_f32_arm(mod, mod.enums[ei].variant_names[n - 1]);
            var k: i32 = n - 2;
            while (k >= 0) {
                acc = "(if (i32.eq (local.get $d) (i32.const " + util.i32_to_string(k) + ")) (then " + extern_variant_result_store_f32_arm(mod, mod.enums[ei].variant_names[k]) + ") (else " + acc + "))";
                k = k - 1;
            }
            return acc;
        }
        ei = ei + 1;
    }
    return "(i32.store offset=4 (local.get $s) (i32.load offset=4 (local.get $rb)))";
}

// extern_variant_result_store_f32_arm emits one arm's result payload store:
// the promote bridge for an f32 field, the plain i32 copy otherwise.
function extern_variant_result_store_f32_arm(mod: parser.Module, vn: string): string {
    if (struct_field_count(mod.structs, vn) == 1 && struct_field_type_at(mod.structs, vn, 0) == "f32") {
        return "(f64.store offset=4 (local.get $s) (f64.promote_f32 (f32.reinterpret_i32 (i32.load offset=4 (local.get $rb)))))";
    }
    return "(i32.store offset=4 (local.get $s) (i32.load offset=4 (local.get $rb)))";
}

// extern_variant_result_supported is the result-side gate for a general
// `variant` return with a uniform payload. It accepts the same shape as a
// variant parameter — every payloaded variant a 1-field i32/u32 struct, all
// uniform, ≥1 payloaded — and **allows payloadless variants** (a mixed
// `variant`, e.g. `{ some(s32), none }`). The result wrapper materializes an
// always-`[struct_id@0][payload@4]` box; a payloadless case gets that box with
// an unused payload (tag-correct, match-correct — the payload is never read for
// it), exactly how the Go backend and option/result results handle a
// payloadless arm. The canonical variant flattens to (disc, payload), indirect.
function extern_variant_result_supported(mod: parser.Module, t: string): boolean {
    return extern_variant_param_supported(mod, t);
}

// extern_plain_enum_disc emits a WAT i32 expression mapping the plain-enum value
// at `eploc` (a pointer to `[struct_id@0]`) to its canonical WIT discriminant
// (the variant index): a select-chain comparing the loaded struct_id against
// each variant's struct_id. The Fern variant order must match the WIT case
// order (the index is the disc).
function extern_plain_enum_disc(mod: parser.Module, t: string, eploc: string): string {
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].name == t) {
            var n: i32 = mod.enums[ei].variant_names.len();
            // Build from the default (last index) outward.
            var acc: string = "(i32.const " + util.i32_to_string(n - 1) + ")";
            var k: i32 = n - 2;
            while (k >= 0) {
                var sid: i32 = struct_id(mod.structs, mod.enums[ei].variant_names[k]);
                acc = "(select (i32.const " + util.i32_to_string(k) + ") " + acc + " (i32.eq (i32.load (local.get " + eploc + ")) (i32.const " + util.i32_to_string(sid) + ")))";
                k = k - 1;
            }
            return acc;
        }
        ei = ei + 1;
    }
    return "(i32.const 0)";
}

// extern_plain_enum_sid emits a WAT i32 expression mapping a runtime WIT-enum
// discriminant (variant index, in local `dloc`) back to the matching variant's
// struct_id — the inverse of extern_plain_enum_disc, used to materialize a Fern
// payloadless enum value `[struct_id@0]` from an enum *result*. A select-chain
// `disc==k ? sid_k : acc`.
function extern_plain_enum_sid(mod: parser.Module, t: string, dloc: string): string {
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].name == t) {
            var n: i32 = mod.enums[ei].variant_names.len();
            var acc: string = "(i32.const " + util.i32_to_string(struct_id(mod.structs, mod.enums[ei].variant_names[n - 1])) + ")";
            var k: i32 = n - 2;
            while (k >= 0) {
                var sid: i32 = struct_id(mod.structs, mod.enums[ei].variant_names[k]);
                acc = "(select (i32.const " + util.i32_to_string(sid) + ") " + acc + " (i32.eq (local.get " + dloc + ") (i32.const " + util.i32_to_string(k) + ")))";
                k = k - 1;
            }
            return acc;
        }
        ei = ei + 1;
    }
    return "(i32.const 0)";
}
// field of type `ft` from its 4-byte slot, leaving its canonical i32 on the
// stack. The sub-word integer uses a width-aware load so the value is correctly
// zero-extended (the self-host stores it in a 4-byte little-endian slot,
// so the low byte at the field offset is the meaningful one).
function extern_field_load_op(ft: string): string {
    if (ft == "u8" || ft == "boolean") { return "i32.load8_u"; }
    return "i32.load";
}

// extern_canon_field_size returns the canonical-ABI memory size (== alignment)
// of a record field type: u8 → 1, else 4.
function extern_canon_field_size(ft: string): i32 {
    if (ft == "u8" || ft == "boolean") { return 1; }
    return 4;
}

// extern_canon_field_align returns the canonical-ABI alignment of a result-record
// field type: a scalar's own size, or (for a nested record, inlined by the
// canonical ABI) the max alignment of the nested record's fields, recursing to
// arbitrary depth.
function extern_canon_field_align(mod: parser.Module, ft: string): i32 {
    if (extern_field_is_scalar(ft)) { return extern_canon_field_size(ft); }
    var n: i32 = struct_field_count(mod.structs, ft);
    var maxa: i32 = 1;
    var i: i32 = 0;
    while (i < n) {
        var a: i32 = extern_canon_field_align(mod, struct_field_type_at(mod.structs, ft, i));
        if (a > maxa) { maxa = a; }
        i = i + 1;
    }
    return maxa;
}

// extern_canon_field_csize returns the canonical-ABI size of a result-record
// field type: a scalar's own size, or (for a nested record, inlined) the nested
// record's canonical size, recursing to arbitrary depth.
function extern_canon_field_csize(mod: parser.Module, ft: string): i32 {
    if (extern_field_is_scalar(ft)) { return extern_canon_field_size(ft); }
    return extern_canon_record_size_nested(mod, ft);
}

// extern_canon_top_off returns the canonical-ABI offset of top-level field `idx`
// in result struct `tn`, placing each field (scalar or inlined nested record) at
// its alignment + size — the layout the host writes the indirect result into.
function extern_canon_top_off(mod: parser.Module, tn: string, idx: i32): i32 {
    var pos: i32 = 0;
    var i: i32 = 0;
    while (i < idx) {
        var ft: string = struct_field_type_at(mod.structs, tn, i);
        var a: i32 = extern_canon_field_align(mod, ft);
        var rem: i32 = pos % a;
        if (rem != 0) { pos = pos + (a - rem); }
        pos = pos + extern_canon_field_csize(mod, ft);
        i = i + 1;
    }
    var fa: i32 = extern_canon_field_align(mod, struct_field_type_at(mod.structs, tn, idx));
    var frem: i32 = pos % fa;
    if (frem != 0) { pos = pos + (fa - frem); }
    return pos;
}

// extern_canon_record_size_nested returns the canonical-ABI size of result
// struct `tn`, accounting for inlined nested record fields (the end of the last
// field rounded up to the record's max field alignment).
function extern_canon_record_size_nested(mod: parser.Module, tn: string): i32 {
    var n: i32 = struct_field_count(mod.structs, tn);
    if (n == 0) { return 0; }
    var last: i32 = n - 1;
    var lsz: i32 = extern_canon_field_csize(mod, struct_field_type_at(mod.structs, tn, last));
    var size: i32 = extern_canon_top_off(mod, tn, last) + lsz;
    var maxa: i32 = 1;
    var i: i32 = 0;
    while (i < n) {
        var a: i32 = extern_canon_field_align(mod, struct_field_type_at(mod.structs, tn, i));
        if (a > maxa) { maxa = a; }
        i = i + 1;
    }
    var rem: i32 = size % maxa;
    if (rem != 0) { size = size + (maxa - rem); }
    return size;
}

// extern_emit_record_fill emits WAT filling the self-host result struct whose
// pointer is in local `dst` (its type id already stored by the caller) from the
// canonical return area in local $rb, for struct `tn` whose canonical base offset
// within the area is `canon_base`. A scalar field is read width+sign-aware at its
// canonical offset; a nested record field allocs an inner struct into
// $inner<depth>, recurses to fill it, and stores its pointer in the outer slot.
// Recurses to arbitrary depth — the wrapper reserves one $inner local per level.
// The single local per depth is safe across siblings: a child's pointer is stored
// into its parent before the next sibling at that depth overwrites the local.
function extern_emit_record_fill(mod: parser.Module, dst: string, tn: string, canon_base: i32, depth: i32): string {
    var out: string = "";
    var nf: i32 = struct_field_count(mod.structs, tn);
    var rc: i32 = 0;
    while (rc < nf) {
        var rcft: string = struct_field_type_at(mod.structs, tn, rc);
        var coff: i32 = canon_base + extern_canon_top_off(mod, tn, rc);
        if (extern_field_is_scalar(rcft)) {
            out = out + "    (i32.store (i32.add (local.get " + dst + ") (i32.const " + util.i32_to_string(struct_field_off(rc)) + ")) (" + extern_field_load_op(rcft) + " (i32.add (local.get $rb) (i32.const " + util.i32_to_string(coff) + "))))\n";
        } else {
            var inner_local: string = "$inner" + util.i32_to_string(depth);
            var inf: i32 = struct_field_count(mod.structs, rcft);
            out = out + "    (local.set " + inner_local + " (call $__fern_str_box (i32.const " + util.i32_to_string(4 + inf * 4) + ")))\n";
            out = out + "    (i32.store (local.get " + inner_local + ") (i32.const " + util.i32_to_string(struct_id(mod.structs, rcft)) + "))\n";
            out = out + extern_emit_record_fill(mod, inner_local, rcft, coff, depth + 1);
            out = out + "    (i32.store (i32.add (local.get " + dst + ") (i32.const " + util.i32_to_string(struct_field_off(rc)) + ")) (local.get " + inner_local + "))\n";
        }
        rc = rc + 1;
    }
    return out;
}

// extern_emit_record_param_leaves emits the flattened scalar leaves of a record
// `@import` parameter, pushed (in declaration order) as the canonical core args
// the raw import expects. `base_expr` is a WAT expression evaluating to the
// struct value pointer (e.g. `(local.get $ep0)`). A scalar field is loaded
// width+sign-aware at base+off; a nested record field deref-s the inner value
// pointer at base+off and recurses with that as the new base — to arbitrary
// depth. (The base sub-expression is re-evaluated per leaf, matching the one-level
// shape this generalizes; the redundant inner-pointer loads are cheap.)
function extern_emit_record_param_leaves(mod: parser.Module, base_expr: string, tn: string): string {
    var out: string = "";
    var n: i32 = struct_field_count(mod.structs, tn);
    var fi: i32 = 0;
    while (fi < n) {
        var ft: string = struct_field_type_at(mod.structs, tn, fi);
        var field_expr: string = "(i32.add " + base_expr + " (i32.const " + util.i32_to_string(struct_field_off(fi)) + "))";
        if (extern_field_is_scalar(ft)) {
            out = out + " (" + extern_field_load_op(ft) + " " + field_expr + ")";
        } else {
            out = out + extern_emit_record_param_leaves(mod, "(i32.load " + field_expr + ")", ft);
        }
        fi = fi + 1;
    }
    return out;
}

// struct_field_type_at returns the declared type of field `idx` in struct `tn`
// ("" if out of range / unknown).
function struct_field_type_at(structs: parser.StructDecl[], tn: string, idx: i32): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) {
            if (idx >= 0 && idx < structs[i].fields.len()) { return structs[i].fields[idx].type_name; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// extern_record_ret_direct is true for a supported record RESULT with exactly
// one field. A single-field record flattens to exactly one core value (fits
// MAX_FLAT_RESULTS=1), so the canonical ABI returns it by value — the import
// returns the field's i32 directly (no return-area pointer / cabi_realloc), and
// the wrapper materializes the one-field struct from that value (mirrors the Go
// ExternRecordResult.Direct path). Multi-field records return indirectly.
function extern_record_ret_direct(mod: parser.Module, t: string): boolean {
    return extern_record_result_supported(mod, t)
        && struct_field_count(mod.structs, t) == 1
        && extern_field_is_scalar(struct_field_type_at(mod.structs, t, 0));
}
// parameter (P4c): a sum type whose arm payload(s) are i32/u32. A self-host
// Option/Result is a heap box `[tag:i32 @0][payload:i32 @4]`; the canonical
// option/result flattens to (disc, payload).
pub function extern_sum_param_supported(t: string): boolean {
    // Decode via the structured TypeRef (SH-021 — parser.parse_type_ref) instead
    // of the magic-byte `Option[` / `Result[` prefix + top-level-comma depth scan.
    // A flat sum param is a NON-array Option[i32|u32] or Result[i32|u32, i32|u32];
    // an array (array_depth != 0) or any other shape is unsupported. Byte-identical
    // to the former scan across the whole type grammar (verified old-vs-new over a
    // corpus incl. arrays, nested-generic payloads, malformed arities, bare names).
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.array_depth != 0) { return false; }
    if (r.base == "Option" && r.args.len() == 1) {
        var p: string = parser.render_type_ref(r.args[0]);
        return p == "i32" || p == "u32";
    }
    if (r.base == "Result" && r.args.len() == 2) {
        var ok: string = parser.render_type_ref(r.args[0]);
        var er: string = parser.render_type_ref(r.args[1]);
        return (ok == "i32" || ok == "u32") && (er == "i32" || er == "u32");
    }
    return false;
}

// extern_sum_param_is_option reports whether t is an Option[...] — its
// discriminant is remapped 1-tag (Fern Some=0/None=1 reverses canonical
// none=0/some=1; Result's Ok=0/Err=1 already matches, no remap).
pub function extern_sum_param_is_option(t: string): boolean {
    // `t` is a bracketed `Option[…]` (incl. an array-of-option `Option[…][]`),
    // via the structured TypeRef instead of the `t[0:7] == "Option["` prefix scan.
    // The array_depth arm reproduces the old prefix check's acceptance of a
    // trailing `[]` (and of the degenerate `Option[]`); a bare `Option` with no
    // bracket stays false. Byte-identical (verified old-vs-new over a corpus).
    var r: parser.TypeRef = parser.parse_type_ref(t);
    return r.base == "Option" && (r.args.len() > 0 || r.array_depth > 0);
}

// tuple_type_elem_count returns the number of top-level elements in a tuple
// type spelling "(A, B, …)", or 0 if it isn't a parenthesised tuple.
function tuple_type_elem_count(t: string): i32 {
    if (t.len() < 2 || t[0] != 40) { return 0; }  // 40 = '('
    var idx: i32 = 0;
    while (nth_tuple_type_elem(t, idx).len() > 0) { idx = idx + 1; }
    return idx;
}

// extern_tuple_param_supported is true for an `@import` tuple parameter the
// wrapper can flatten to its elements. A self-host tuple is a heap block of N
// consecutive 4-byte slots (element i @ i*4, no header) — every element is
// i32-class — and the canonical tuple flattens to one i32 per element, in
// order. Scoped to 2..16 i32/u32 elements (a 1-element parenthesised type isn't
// a tuple in Fern; the canonical wider/byte elements wouldn't fit a 4-byte
// slot). No alignment wall: like records, it flattens to values.
function extern_tuple_param_supported(t: string): boolean {
    var n: i32 = tuple_type_elem_count(t);
    if (n < 2 || n > 16) { return false; }
    var i: i32 = 0;
    while (i < n) {
        var e: string = nth_tuple_type_elem(t, i);
        if (e != "i32" && e != "u32") { return false; }
        i = i + 1;
    }
    return true;
}

// has_extern_mem_param is true when an `@import` extern takes a parameter a
// wrapper must lower: a `string` / numeric array (canonical (ptr, len)) or a
// record (flattened to its fields).
function has_extern_mem_param(mod: parser.Module, f: parser.FuncDecl): boolean {
    var i: i32 = 0;
    while (i < f.params.len()) {
        var pt: string = f.params[i].type_name;
        if (pt == "string" || extern_array_param_supported(pt) || extern_byte_array_param(pt) || extern_record_param_supported(mod, pt) || extern_sum_param_supported(pt) || extern_tuple_param_supported(pt) || extern_plain_enum_param(mod, pt) || extern_variant_param_supported(mod, pt)) { return true; }
        i = i + 1;
    }
    return false;
}

// extern_needs_wrapper is true when an extern's Fern call must resolve to a
// generated wrapper rather than straight to the import: a composite result
// (return-area lift) or a memory/record parameter.
function extern_needs_wrapper(mod: parser.Module, f: parser.FuncDecl): boolean {
    return is_extern_composite_ret(mod, f.ret_type) || has_extern_mem_param(mod, f) || extern_plain_enum_param(mod, f.ret_type);
}

function extern_imports(mod: parser.Module): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[i];
        if (f.import_iface.len() > 0) {
            if (extern_needs_wrapper(mod, f)) {
                // The raw import is named $name__import; the Fern $name resolves
                // to the wrapper (see extern_wrappers). Each string param
                // lowers to (ptr, len) = 2 i32s.
                out = out + "  (import \"" + f.import_iface + "\" \"" + f.import_wit + "\" (func $" + f.name + "__import";
                var sp: i32 = 0;
                while (sp < f.params.len()) {
                    if (f.params[sp].type_name == "string" || extern_array_param_supported(f.params[sp].type_name) || extern_byte_array_param(f.params[sp].type_name)) {
                        // string / list<T> / list<u8>: canonical (ptr, len) = 2 i32s.
                        out = out + " (param i32) (param i32)";
                    } else if (extern_record_param_supported(mod, f.params[sp].type_name)) {
                        // record: flattens to one i32 per leaf (recursing one
                        // level into a nested record field).
                        var rn: i32 = 0;
                        while (rn < extern_record_leaf_count(mod, f.params[sp].type_name)) {
                            out = out + " (param i32)";
                            rn = rn + 1;
                        }
                    } else if (extern_sum_param_supported(f.params[sp].type_name)) {
                        // option/result: flattens to (disc, payload) = 2 i32s.
                        out = out + " (param i32) (param i32)";
                    } else if (extern_tuple_param_supported(f.params[sp].type_name)) {
                        // tuple: flattens to one i32 per element.
                        var tn: i32 = 0;
                        while (tn < tuple_type_elem_count(f.params[sp].type_name)) {
                            out = out + " (param i32)";
                            tn = tn + 1;
                        }
                    } else if (extern_plain_enum_param(mod, f.params[sp].type_name)) {
                        // WIT enum: flattens to a single i32 discriminant.
                        out = out + " (param i32)";
                    } else if (extern_variant_param_supported(mod, f.params[sp].type_name)) {
                        // variant: flattens to (disc:i32, payload-join). A multi-
                        // field variant joins to SlotCount i32 slots; otherwise the
                        // join is i64 (mixed-width / 64-bit-bearing) or i32.
                        out = out + " (param i32)";
                        if (extern_variant_is_multifield(mod, f.params[sp].type_name)) {
                            var sc: i32 = extern_variant_max_fields(mod, f.params[sp].type_name);
                            var si: i32 = 0;
                            while (si < sc) { out = out + " (param i32)"; si = si + 1; }
                        } else if (extern_variant_is_uniform_f64(mod, f.params[sp].type_name)) {
                            out = out + " (param f64)";
                        } else if (extern_variant_join_is64(mod, f.params[sp].type_name)) {
                            out = out + " (param i64)";
                        } else {
                            out = out + " (param i32)";
                        }
                    } else {
                        out = out + " (param " + wat_extern_valtype(f.params[sp].type_name) + ")";
                    }
                    sp = sp + 1;
                }
                if (extern_record_ret_direct(mod, f.ret_type)) {
                    // Single-field record result: returned by value (all
                    // self-host record fields are i32), no return area.
                    out = out + " (result i32)))\n";
                } else if (is_extern_composite_ret(mod, f.ret_type)) {
                    // Composite result: trailing return-area pointer, no result.
                    out = out + " (param i32)))\n";
                } else {
                    if (returns_value(f.ret_type)) {
                        out = out + " (result " + wat_extern_valtype(f.ret_type) + ")";
                    }
                    out = out + "))\n";
                }
            } else {
                out = out + "  (import \"" + f.import_iface + "\" \"" + f.import_wit + "\" (func $" + f.name;
                var p: i32 = 0;
                while (p < f.params.len()) {
                    out = out + " (param " + wat_extern_valtype(f.params[p].type_name) + ")";
                    p = p + 1;
                }
                if (returns_value(f.ret_type)) {
                    out = out + " (result " + wat_extern_valtype(f.ret_type) + ")";
                }
                out = out + "))\n";
            }
        }
        i = i + 1;
    }
    return out;
}

// extern_exports emits a core wasm export `iface#wit-name` for each `@export`
// function (P6 — docs/WIT-BRING-YOUR-OWN.md). The function is emitted normally
// (it has a body); this surfaces the WIT-id alias the Go world-driven composer
// (ComposeExportsFromWorld) keys off to lift it as the named world export.
// export_func_ret returns the declared return type of the free function named
// `name` (or "" if not found) — used to pick the export's lift shape.
function export_func_ret(mod: parser.Module, name: string): string {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].name == name) {
            return mod.funcs[i].ret_type;
        }
        i = i + 1;
    }
    return "";
}

// export_func_params returns the parameter list of the free function `name`.
function export_func_params(mod: parser.Module, name: string): parser.ParamDecl[] {
    var none: parser.ParamDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].name == name) {
            return mod.funcs[i].params;
        }
        i = i + 1;
    }
    return none;
}

// export_has_string_param reports whether any parameter is a string.
function export_has_string_param(params: parser.ParamDecl[]): boolean {
    var i: i32 = 0;
    while (i < params.len()) {
        if (params[i].type_name == "string") { return true; }
        i = i + 1;
    }
    return false;
}

// export_has_numeric_array_param reports whether any parameter is a numeric
// array (`list<T>`, slot == canonical element size) — the shape whose export
// wrapper rebuilds a self-host array from the canonical (ptr,len).
function export_has_numeric_array_param(params: parser.ParamDecl[]): boolean {
    var i: i32 = 0;
    while (i < params.len()) {
        if (extern_array_param_supported(params[i].type_name)) { return true; }
        i = i + 1;
    }
    return false;
}

// module_has_array_param_export reports whether any `@export` takes a numeric
// array parameter — its wrapper needs the array runtime (__fern_arr_box).
function module_has_array_param_export(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.exports.len()) {
        if (export_has_numeric_array_param(export_func_params(mod, mod.exports[i].func_name))) { return true; }
        i = i + 1;
    }
    return false;
}

// build_export_wrapper emits the core wrapper bridging the canonical ABI of a
// composite-signature `@export` to the Fern function (P6 —
// docs/WIT-BRING-YOUR-OWN.md). A string parameter arrives as canonical
// `(ptr,len)` core params, which the wrapper copies into a fresh `[len][bytes]`
// block the Fern function expects; a string result is a `[len][bytes]` pointer
// the wrapper repacks into the canonical `[ptr,len]` return area. Scalars pass
// through. Local indices: wrapper params 0..W-1, then one block local per
// string param, then a loop counter, then (string result) $s + $ra.
function build_export_wrapper(fname: string, params: parser.ParamDecl[], ret: string): string {
    // Each string OR numeric-array param takes two canonical wrapper slots
    // (ptr,len) and gets one scratch "block" local (the [len][bytes] string block
    // / the rebuilt Fern array); scalars take one slot, no local.
    var w_slots: i32 = 0;
    var nblk: i32 = 0;
    var j: i32 = 0;
    while (j < params.len()) {
        if (params[j].type_name == "string" || extern_array_param_supported(params[j].type_name)) {
            w_slots = w_slots + 2; nblk = nblk + 1;
        } else { w_slots = w_slots + 1; }
        j = j + 1;
    }
    var str_result: boolean = ret == "string";
    // A numeric-array (`list<T>`, slot == canonical element size) result repacks
    // the Fern array into the canonical (ptr,len) return area (P6 — see the
    // array-result branch below).
    var arr_result: boolean = extern_array_param_supported(ret);
    // An Option/Result result repacks the self-host enum box into the canonical
    // (disc:u8@0, payload:i32@4) return area (P6 — see the sum-result branch).
    var sum_result: boolean = extern_sum_param_supported(ret);
    // A tuple result copies the self-host tuple's i32 elements into the canonical
    // (element i @ i*4) return area (P6 — see the tuple-result branch).
    var tup_result: boolean = extern_tuple_param_supported(ret);
    var i_local: i32 = w_slots + nblk;
    var s_local: i32 = w_slots + nblk + 1;
    var ra_local: i32 = w_slots + nblk + 2;
    // Array-result locals (mutually exclusive with the string-result ones): the
    // call result (the array block base), its length, the 8-aligned element
    // buffer, and the return area. The copy counter reuses $i (i_local).
    var arr_arr: i32 = w_slots + nblk + 1;
    var arr_alen: i32 = w_slots + nblk + 2;
    var arr_buf: i32 = w_slots + nblk + 3;
    var arr_ra: i32 = w_slots + nblk + 4;
    // Sum-result / tuple-result locals: the call result (the box / tuple pointer)
    // and the return area.
    var sum_v: i32 = w_slots + nblk + 1;
    var sum_rb: i32 = w_slots + nblk + 2;
    var tup_v: i32 = w_slots + nblk + 1;
    var tup_rb: i32 = w_slots + nblk + 2;

    var head: string = "  (func $__xwrap_" + fname;
    j = 0;
    while (j < params.len()) {
        if (params[j].type_name == "string" || extern_array_param_supported(params[j].type_name)) { head = head + " (param i32) (param i32)"; }
        else { head = head + " (param " + wat_extern_valtype(params[j].type_name) + ")"; }
        j = j + 1;
    }
    if (str_result || arr_result || sum_result || tup_result) { head = head + " (result i32)"; }
    else if (returns_value(ret)) { head = head + " (result " + wat_extern_valtype(ret) + ")"; }
    head = head + "\n";

    var nlocals: i32 = nblk + 1;
    if (str_result) { nlocals = nlocals + 2; }
    if (arr_result) { nlocals = nlocals + 4; }
    if (sum_result) { nlocals = nlocals + 2; }
    if (tup_result) { nlocals = nlocals + 2; }
    var locals: string = "    ";
    var k: i32 = 0;
    while (k < nlocals) { locals = locals + "(local i32) "; k = k + 1; }
    locals = locals + "\n";

    var body: string = "";
    var wp: i32 = 0;   // running wrapper-param index
    var blk: i32 = w_slots;
    var callargs: string = "";
    j = 0;
    while (j < params.len()) {
        if (params[j].type_name == "string") {
            var lenI: i32 = wp + 1;
            var blkS: string = util.i32_to_string(blk);
            var iS: string = util.i32_to_string(i_local);
            var lenS: string = util.i32_to_string(lenI);
            var ptrS: string = util.i32_to_string(wp);
            var jS: string = util.i32_to_string(j);
            body = body + "    (local.set " + blkS + " (call $__fern_alloc (i32.add (i32.const 4) (local.get " + lenS + "))))\n";
            body = body + "    (i32.store (local.get " + blkS + ") (local.get " + lenS + "))\n";
            body = body + "    (local.set " + iS + " (i32.const 0))\n";
            body = body + "    (block $d" + jS + " (loop $c" + jS + "\n";
            body = body + "      (br_if $d" + jS + " (i32.ge_u (local.get " + iS + ") (local.get " + lenS + ")))\n";
            body = body + "      (i32.store8 (i32.add (i32.add (local.get " + blkS + ") (i32.const 4)) (local.get " + iS + ")) (i32.load8_u (i32.add (local.get " + ptrS + ") (local.get " + iS + "))))\n";
            body = body + "      (local.set " + iS + " (i32.add (local.get " + iS + ") (i32.const 1)))\n";
            body = body + "      (br $c" + jS + ")))\n";
            callargs = callargs + " (local.get " + blkS + ")";
            blk = blk + 1;
            wp = wp + 2;
        } else if (extern_array_param_supported(params[j].type_name)) {
            // Numeric-array (`list<T>`) param: the canonical ABI passes (ptr,len)
            // with the elements contiguous at their stride; rebuild the self-host
            // array ([len@0], elements at +8 in native slots — see the import
            // array-result wrapper) and pass its block base to the Fern func.
            var akind: str = params[j].type_name[0:params[j].type_name.len() - 2];
            var assz: string = util.i32_to_string(elem_slot_size(akind));
            var ablkS: string = util.i32_to_string(blk);
            var aiS: string = util.i32_to_string(i_local);
            var alenS: string = util.i32_to_string(wp + 1);
            var aptrS: string = util.i32_to_string(wp);
            var ajS: string = util.i32_to_string(j);
            body = body + "    (local.set " + ablkS + " (call $__fern_arr_box (i32.mul (local.get " + alenS + ") (i32.const " + assz + "))))\n";
            body = body + "    (i32.store (local.get " + ablkS + ") (local.get " + alenS + "))\n";
            body = body + "    (local.set " + aiS + " (i32.const 0))\n";
            body = body + "    (block $pda" + ajS + " (loop $pca" + ajS + "\n";
            body = body + "      (br_if $pda" + ajS + " (i32.ge_u (local.get " + aiS + ") (local.get " + alenS + ")))\n";
            body = body + "      (" + elem_store_op(akind) + " (i32.add (i32.add (local.get " + ablkS + ") (i32.const 8)) (i32.mul (local.get " + aiS + ") (i32.const " + assz + "))) (" + elem_load_op(akind) + " (i32.add (local.get " + aptrS + ") (i32.mul (local.get " + aiS + ") (i32.const " + assz + ")))))\n";
            body = body + "      (local.set " + aiS + " (i32.add (local.get " + aiS + ") (i32.const 1)))\n";
            body = body + "      (br $pca" + ajS + ")))\n";
            callargs = callargs + " (local.get " + ablkS + ")";
            blk = blk + 1;
            wp = wp + 2;
        } else {
            callargs = callargs + " (local.get " + util.i32_to_string(wp) + ")";
            wp = wp + 1;
        }
        j = j + 1;
    }
    if (str_result) {
        var sS: string = util.i32_to_string(s_local);
        var raS: string = util.i32_to_string(ra_local);
        body = body + "    (local.set " + sS + " (call $" + fname + callargs + "))\n";
        body = body + "    (local.set " + raS + " (i32.and (i32.add (call $__fern_alloc (i32.const 12)) (i32.const 3)) (i32.const -4)))\n";
        body = body + "    (i32.store (local.get " + raS + ") (i32.add (local.get " + sS + ") (i32.const 4)))\n";
        body = body + "    (i32.store (i32.add (local.get " + raS + ") (i32.const 4)) (i32.load (local.get " + sS + ")))\n";
        body = body + "    (local.get " + raS + "))\n";
    } else if (arr_result) {
        // Numeric-array (`list<T>`) result. The Fern array is `[len@0]` with the
        // elements at +8 in native slots; the canonical list<T> needs a (ptr,len)
        // pair whose data is contiguous at the element stride and aligned to it.
        // The self-host heap isn't aligned, so — like the import array *param*
        // wrapper — copy the elements into a fresh 8-aligned buffer, then write
        // the 4-byte-aligned [buf,len] return area the Go composer's memory lift
        // reads.
        var rk: str = ret[0:ret.len() - 2];
        var ss: string = util.i32_to_string(elem_slot_size(rk));
        var aS: string = util.i32_to_string(arr_arr);
        var lnS: string = util.i32_to_string(arr_alen);
        var bfS: string = util.i32_to_string(arr_buf);
        var raS2: string = util.i32_to_string(arr_ra);
        var iS2: string = util.i32_to_string(i_local);
        body = body + "    (local.set " + aS + " (call $" + fname + callargs + "))\n";
        body = body + "    (local.set " + lnS + " (i32.load (local.get " + aS + ")))\n";
        body = body + "    (local.set " + bfS + " (i32.and (i32.add (call $__fern_alloc (i32.mul (local.get " + lnS + ") (i32.const " + ss + "))) (i32.const 7)) (i32.const -8)))\n";
        body = body + "    (local.set " + iS2 + " (i32.const 0))\n";
        body = body + "    (block $da (loop $ca\n";
        body = body + "      (br_if $da (i32.ge_u (local.get " + iS2 + ") (local.get " + lnS + ")))\n";
        body = body + "      (" + elem_store_op(rk) + " (i32.add (local.get " + bfS + ") (i32.mul (local.get " + iS2 + ") (i32.const " + ss + "))) (" + elem_load_op(rk) + " (i32.add (i32.add (local.get " + aS + ") (i32.const 8)) (i32.mul (local.get " + iS2 + ") (i32.const " + ss + ")))))\n";
        body = body + "      (local.set " + iS2 + " (i32.add (local.get " + iS2 + ") (i32.const 1)))\n";
        body = body + "      (br $ca)))\n";
        body = body + "    (local.set " + raS2 + " (i32.and (i32.add (call $__fern_alloc (i32.const 12)) (i32.const 3)) (i32.const -4)))\n";
        body = body + "    (i32.store (local.get " + raS2 + ") (local.get " + bfS + "))\n";
        body = body + "    (i32.store (i32.add (local.get " + raS2 + ") (i32.const 4)) (local.get " + lnS + "))\n";
        body = body + "    (local.get " + raS2 + "))\n";
    } else if (sum_result) {
        // Option/Result result. The Fern func returns an enum box pointer
        // ([tag:i32@0][payload:i32@4]); the canonical sum returns indirectly
        // through (disc:u8@0, payload:i32@4). Write the area with the disc
        // remapped 1-tag for option (Fern Some=0/None=1 ↔ canonical
        // none=0/some=1; Result Ok=0/Err=1 matches). The heap bump isn't
        // aligned, so over-alloc the 8-byte area by 7 and 8-align.
        var svS: string = util.i32_to_string(sum_v);
        var srbS: string = util.i32_to_string(sum_rb);
        body = body + "    (local.set " + svS + " (call $" + fname + callargs + "))\n";
        body = body + "    (local.set " + srbS + " (i32.and (i32.add (call $__fern_alloc (i32.const 15)) (i32.const 7)) (i32.const -8)))\n";
        if (extern_sum_param_is_option(ret)) {
            body = body + "    (i32.store8 (local.get " + srbS + ") (i32.sub (i32.const 1) (i32.load (local.get " + svS + "))))\n";
        } else {
            body = body + "    (i32.store8 (local.get " + srbS + ") (i32.load (local.get " + svS + ")))\n";
        }
        body = body + "    (i32.store offset=4 (local.get " + srbS + ") (i32.load offset=4 (local.get " + svS + ")))\n";
        body = body + "    (local.get " + srbS + "))\n";
    } else if (tup_result) {
        // Tuple result. The Fern func returns a tuple pointer (element i @ i*4,
        // no header); the canonical tuple returns indirectly with element i at
        // the same i*4 offset (all i32). Copy each element into the 8-aligned
        // return area.
        var tvS: string = util.i32_to_string(tup_v);
        var trbS: string = util.i32_to_string(tup_rb);
        var tn: i32 = tuple_type_elem_count(ret);
        body = body + "    (local.set " + tvS + " (call $" + fname + callargs + "))\n";
        body = body + "    (local.set " + trbS + " (i32.and (i32.add (call $__fern_alloc (i32.const " + util.i32_to_string(tn * 4 + 7) + ")) (i32.const 7)) (i32.const -8)))\n";
        var ti: i32 = 0;
        while (ti < tn) {
            var toff: string = util.i32_to_string(ti * 4);
            body = body + "    (i32.store (i32.add (local.get " + trbS + ") (i32.const " + toff + ")) (i32.load (i32.add (local.get " + tvS + ") (i32.const " + toff + "))))\n";
            ti = ti + 1;
        }
        body = body + "    (local.get " + trbS + "))\n";
    } else {
        body = body + "    (call $" + fname + callargs + "))\n";
    }
    return head + locals + body;
}

// export_needs_heap reports whether any `@export` has a string parameter or a
// string result — its wrapper uses __fern_alloc to build the [len][bytes] block
// / canonical return area, so the heap allocator must be emitted (P6).
function export_needs_heap(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.exports.len()) {
        var nm: string = mod.exports[i].func_name;
        var params: parser.ParamDecl[] = export_func_params(mod, nm);
        if (export_func_ret(mod, nm) == "string" || export_has_string_param(params) || extern_array_param_supported(export_func_ret(mod, nm)) || export_has_numeric_array_param(params) || extern_sum_param_supported(export_func_ret(mod, nm)) || extern_tuple_param_supported(export_func_ret(mod, nm))) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// export_needs_realloc reports whether any `@export` has a string or numeric-
// array parameter — the canonical realloc lift materialises the incoming bytes
// via cabi_realloc, so the core must emit + export it (P6).
function export_needs_realloc(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.exports.len()) {
        var params: parser.ParamDecl[] = export_func_params(mod, mod.exports[i].func_name);
        if (export_has_string_param(params) || export_has_numeric_array_param(params)) { return true; }
        i = i + 1;
    }
    return false;
}

function extern_exports(mod: parser.Module): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < mod.exports.len()) {
        var x: parser.ExportBinding = mod.exports[i];
        var ret: string = export_func_ret(mod, x.func_name);
        var params: parser.ParamDecl[] = export_func_params(mod, x.func_name);
        if (ret == "string" || export_has_string_param(params) || extern_array_param_supported(ret) || export_has_numeric_array_param(params) || extern_sum_param_supported(ret) || extern_tuple_param_supported(ret)) {
            // Composite signature: surface a wrapper that bridges the canonical
            // ABI (string params materialised as [len][bytes] blocks, a string
            // result repacked into the [ptr,len] return area, a numeric-array
            // `list<T>` result copied into an aligned (ptr,len) return area) to
            // the Fern func.
            out = out + build_export_wrapper(x.func_name, params, ret);
            out = out + "  (export \"" + x.iface + "#" + x.wit + "\" (func $__xwrap_" + x.func_name + "))\n";
        } else {
            out = out + "  (export \"" + x.iface + "#" + x.wit + "\" (func $" + x.func_name + "))\n";
        }
        i = i + 1;
    }
    return out;
}

// module_has_extern_composite_result is true when any `@import` extern returns
// a string / u8[] — the P4c composite-result shapes that need a wrapper plus
// the exported cabi_realloc.
function module_has_extern_composite_result(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].import_iface.len() > 0 && is_extern_composite_ret(mod, mod.funcs[i].ret_type)) { return true; }
        i = i + 1;
    }
    return false;
}

// module_needs_extern_wrappers is true when any `@import` extern needs a
// generated wrapper (composite result or string parameter).
function module_needs_extern_wrappers(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].import_iface.len() > 0 && extern_needs_wrapper(mod, mod.funcs[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// extern_wrappers emits, for each string/list<u8>-returning `@import` extern
// (P4c), the wrapper the Fern call resolves to. It allocates an 8-byte
// canonical return area (data @+0, len @+4), calls the raw import
// ($name__import) with the scalar params + the return-area pointer, then lifts
// the host (data_ptr, len) bytes into a self-host string (`[len][bytes]`) or a
// u8[] (`[len@0]` header, elements at +8 with 4-byte slots).
function extern_wrappers(mod: parser.Module): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[i];
        if (f.import_iface.len() > 0 && has_extern_mem_param(mod, f)) {
            // memory parameter (P4c): the wrapper forwards each to the canonical
            // (ptr, len). A `string` ([len][bytes]) forwards (ptr+4, load(ptr)).
            // A numeric array forwards (buf, len): the self-host array value is
            // the block base (len@0, elements@+8), but the heap isn't aligned,
            // so the wrapper copies the elements into a freshly 8-aligned buffer
            // first (a list<T> data pointer must be aligned). Scalars pass
            // through. Result is scalar/void (a composite result alongside a
            // memory param is not supported yet).
            out = out + "  (func $" + f.name;
            var pp: i32 = 0;
            while (pp < f.params.len()) {
                var ppn: string = "$ep" + util.i32_to_string(pp);
                if (f.params[pp].type_name == "string" || extern_array_param_supported(f.params[pp].type_name) || extern_byte_array_param(f.params[pp].type_name) || extern_record_param_supported(mod, f.params[pp].type_name) || extern_sum_param_supported(f.params[pp].type_name) || extern_tuple_param_supported(f.params[pp].type_name) || extern_plain_enum_param(mod, f.params[pp].type_name) || extern_variant_param_supported(mod, f.params[pp].type_name)) {
                    out = out + " (param " + ppn + " i32)";
                } else {
                    out = out + " (param " + ppn + " " + wat_extern_valtype(f.params[pp].type_name) + ")";
                }
                pp = pp + 1;
            }
            if (returns_value(f.ret_type)) {
                out = out + " (result " + wat_extern_valtype(f.ret_type) + ")";
            }
            out = out + "\n";
            // Locals: a buffer per array param + a shared loop counter / len.
            var na: i32 = 0;
            var qi: i32 = 0;
            while (qi < f.params.len()) {
                if (extern_array_param_supported(f.params[qi].type_name) || extern_byte_array_param(f.params[qi].type_name)) {
                    out = out + "    (local $ab" + util.i32_to_string(qi) + " i32)\n";
                    na = na + 1;
                }
                qi = qi + 1;
            }
            if (na > 0) { out = out + "    (local $ai i32) (local $an i32)\n"; }
            // Copy each array param into an 8-aligned buffer before the call.
            var ci: i32 = 0;
            while (ci < f.params.len()) {
                if (extern_array_param_supported(f.params[ci].type_name)) {
                    var cppn: string = "$ep" + util.i32_to_string(ci);
                    var bn: string = "$ab" + util.i32_to_string(ci);
                    var tn: string = f.params[ci].type_name;
                    var k: str = tn[0:tn.len() - 2];
                    var ss: string = util.i32_to_string(elem_slot_size(k));
                    var lbl: string = util.i32_to_string(ci);
                    out = out + "    (local.set $an (i32.load (local.get " + cppn + ")))\n";
                    out = out + "    (local.set " + bn + " (i32.and (i32.add (call $__fern_alloc (i32.mul (local.get $an) (i32.const " + ss + "))) (i32.const 7)) (i32.const -8)))\n";
                    out = out + "    (local.set $ai (i32.const 0))\n";
                    out = out + "    (block $d" + lbl + " (loop $c" + lbl + "\n";
                    out = out + "      (br_if $d" + lbl + " (i32.ge_u (local.get $ai) (local.get $an)))\n";
                    out = out + "      (" + elem_store_op(k) + " (i32.add (local.get " + bn + ") (i32.mul (local.get $ai) (i32.const " + ss + "))) (" + elem_load_op(k) + " (i32.add (i32.add (local.get " + cppn + ") (i32.const 8)) (i32.mul (local.get $ai) (i32.const " + ss + ")))))\n";
                    out = out + "      (local.set $ai (i32.add (local.get $ai) (i32.const 1)))\n";
                    out = out + "      (br $c" + lbl + ")))\n";
                } else if (extern_byte_array_param(f.params[ci].type_name)) {
                    // u8[] / boolean[]: repack one byte per element into a
                    // `len`-byte buffer. Source elements live in 4-byte slots at
                    // +8; write each low byte contiguously (the canonical
                    // list<u8> / list<bool> is byte-packed, alignment 1).
                    var ucppn: string = "$ep" + util.i32_to_string(ci);
                    var ubn: string = "$ab" + util.i32_to_string(ci);
                    var ulbl: string = util.i32_to_string(ci);
                    out = out + "    (local.set $an (i32.load (local.get " + ucppn + ")))\n";
                    out = out + "    (local.set " + ubn + " (call $__fern_alloc (local.get $an)))\n";
                    out = out + "    (local.set $ai (i32.const 0))\n";
                    out = out + "    (block $d" + ulbl + " (loop $c" + ulbl + "\n";
                    out = out + "      (br_if $d" + ulbl + " (i32.ge_u (local.get $ai) (local.get $an)))\n";
                    out = out + "      (i32.store8 (i32.add (local.get " + ubn + ") (local.get $ai)) (i32.load (i32.add (i32.add (local.get " + ucppn + ") (i32.const 8)) (i32.mul (local.get $ai) (i32.const 4)))))\n";
                    out = out + "      (local.set $ai (i32.add (local.get $ai) (i32.const 1)))\n";
                    out = out + "      (br $c" + ulbl + ")))\n";
                }
                ci = ci + 1;
            }
            // Call with each param forwarded to its canonical shape.
            out = out + "    (call $" + f.name + "__import";
            var fi: i32 = 0;
            while (fi < f.params.len()) {
                var fppn: string = "$ep" + util.i32_to_string(fi);
                if (f.params[fi].type_name == "string") {
                    out = out + " (i32.add (local.get " + fppn + ") (i32.const 4)) (i32.load (local.get " + fppn + "))";
                } else if (extern_array_param_supported(f.params[fi].type_name) || extern_byte_array_param(f.params[fi].type_name)) {
                    out = out + " (local.get $ab" + util.i32_to_string(fi) + ") (i32.load (local.get " + fppn + "))";
                } else if (extern_record_param_supported(mod, f.params[fi].type_name)) {
                    // record: push each leaf flattened to its canonical i32 (a
                    // width+sign-aware load for sub-word fields), recursing into
                    // nested record fields to arbitrary depth (deref the inner
                    // value pointer, then its leaves).
                    out = out + extern_emit_record_param_leaves(mod, "(local.get " + fppn + ")", f.params[fi].type_name);
                } else if (extern_sum_param_supported(f.params[fi].type_name)) {
                    // option/result: push the discriminant (tag@0, remapped
                    // 1-tag for option) then the payload (@4).
                    if (extern_sum_param_is_option(f.params[fi].type_name)) {
                        out = out + " (i32.sub (i32.const 1) (i32.load (local.get " + fppn + ")))";
                    } else {
                        out = out + " (i32.load (local.get " + fppn + "))";
                    }
                    out = out + " (i32.load offset=4 (local.get " + fppn + "))";
                } else if (extern_tuple_param_supported(f.params[fi].type_name)) {
                    // tuple: push each i32 element (element i @ i*4, no header).
                    var tfi: i32 = 0;
                    while (tfi < tuple_type_elem_count(f.params[fi].type_name)) {
                        out = out + " (i32.load (i32.add (local.get " + fppn + ") (i32.const " + util.i32_to_string(tfi * 4) + ")))";
                        tfi = tfi + 1;
                    }
                } else if (extern_plain_enum_param(mod, f.params[fi].type_name)) {
                    // WIT enum: push the discriminant (variant index), mapped
                    // from the value's [struct_id@0] via a select-chain.
                    out = out + " " + extern_plain_enum_disc(mod, f.params[fi].type_name, fppn);
                } else if (extern_variant_param_supported(mod, f.params[fi].type_name)) {
                    // variant: push the disc (struct_id → variant index) then the
                    // payload-join. A multi-field variant pushes SlotCount i32 slots
                    // (each disc-branched — the arm's field j or 0 padding); an i64
                    // join (mixed-width) coerces each arm to i64 via a disc-branch;
                    // else the single i32 payload at struct_field_off(0). For a
                    // payloadless-case value the payload read is ignored garbage.
                    out = out + " " + extern_plain_enum_disc(mod, f.params[fi].type_name, fppn);
                    if (extern_variant_is_multifield(mod, f.params[fi].type_name)) {
                        var msc: i32 = extern_variant_max_fields(mod, f.params[fi].type_name);
                        var msi: i32 = 0;
                        while (msi < msc) {
                            out = out + " " + extern_variant_multifield_slot(mod, f.params[fi].type_name, msi, fppn);
                            msi = msi + 1;
                        }
                    } else if (extern_variant_is_uniform_f64(mod, f.params[fi].type_name)) {
                        // uniform f64: push the box's f64 payload directly.
                        out = out + " (f64.load (i32.add (local.get " + fppn + ") (i32.const " + util.i32_to_string(struct_field_off(0)) + ")))";
                    } else if (extern_variant_join_is64(mod, f.params[fi].type_name)) {
                        out = out + " " + extern_variant_payload_join_i64(mod, f.params[fi].type_name, fppn);
                    } else if (extern_variant_has_f32_arm(mod, f.params[fi].type_name)) {
                        // i32 join with an f32 arm (S2, #5327): per-arm bridge —
                        // the f32 arm's payload sits in the box as an f64.
                        out = out + " " + extern_variant_payload_join_i32_f32(mod, f.params[fi].type_name, fppn);
                    } else {
                        out = out + " (i32.load (i32.add (local.get " + fppn + ") (i32.const " + util.i32_to_string(struct_field_off(0)) + ")))";
                    }
                } else {
                    out = out + " (local.get " + fppn + ")";
                }
                fi = fi + 1;
            }
            out = out + "))\n";
        } else if (f.import_iface.len() > 0 && extern_record_ret_direct(mod, f.ret_type)) {
            // single-field record result (P4c): returned by value (one i32),
            // no return area. The wrapper materializes the one-field self-host
            // struct (type-id@0, field@+4) from the import's i32 result.
            out = out + "  (func $" + f.name;
            var dp: i32 = 0;
            while (dp < f.params.len()) {
                out = out + " (param $ep" + util.i32_to_string(dp) + " " + wat_extern_valtype(f.params[dp].type_name) + ")";
                dp = dp + 1;
            }
            out = out + " (result i32)\n";
            out = out + "    (local $s i32)\n";
            out = out + "    (local.set $s (call $__fern_alloc (i32.const 8)))\n";
            out = out + "    (i32.store (local.get $s) (i32.const " + util.i32_to_string(struct_id(mod.structs, f.ret_type)) + "))\n";
            // field @ struct_field_off(0) = the import's by-value i32 result.
            out = out + "    (i32.store (i32.add (local.get $s) (i32.const " + util.i32_to_string(struct_field_off(0)) + ")) (call $" + f.name + "__import";
            var da: i32 = 0;
            while (da < f.params.len()) {
                out = out + " (local.get $ep" + util.i32_to_string(da) + ")";
                da = da + 1;
            }
            out = out + "))\n";
            out = out + "    (local.get $s))\n";
        } else if (f.import_iface.len() > 0 && extern_record_result_supported(mod, f.ret_type)) {
            // record result (P4c): a multi-field record returns indirectly; the
            // host writes the fields into the return area at the canonical memory
            // layout (sub-word fields pack tighter than the self-host struct's
            // 4-byte slots; a nested record is inlined). The wrapper reads each
            // field at its canonical offset (width+sign-aware) and stores it into
            // the self-host struct (type-id@0, fields@+4 in 4-byte slots). A nested
            // record field gets its own inner struct, filled from the inlined area
            // and pointed to by the outer slot, returning the outer pointer.
            var nf: i32 = struct_field_count(mod.structs, f.ret_type);
            var canonsz: i32 = extern_canon_record_size_nested(mod, f.ret_type);
            var maxdepth: i32 = extern_record_depth(mod, f.ret_type);
            out = out + "  (func $" + f.name;
            var rp: i32 = 0;
            while (rp < f.params.len()) {
                out = out + " (param $ep" + util.i32_to_string(rp) + " " + wat_extern_valtype(f.params[rp].type_name) + ")";
                rp = rp + 1;
            }
            out = out + " (result i32)\n";
            out = out + "    (local $rb i32) (local $s i32)";
            // One scratch local per nesting level for the inner structs.
            var dl: i32 = 0;
            while (dl < maxdepth) {
                out = out + " (local $inner" + util.i32_to_string(dl) + " i32)";
                dl = dl + 1;
            }
            out = out + "\n";
            // Return area: canonical size, 8-aligned. Over-allocate by 7 so the
            // aligned pointer + area stays within the reserved block (the heap
            // bump isn't aligned, so the next alloc would otherwise overlap).
            out = out + "    (local.set $rb (i32.and (i32.add (call $__fern_alloc (i32.const " + util.i32_to_string(canonsz + 7) + ")) (i32.const 7)) (i32.const -8)))\n";
            out = out + "    (call $" + f.name + "__import";
            var ra: i32 = 0;
            while (ra < f.params.len()) {
                out = out + " (local.get $ep" + util.i32_to_string(ra) + ")";
                ra = ra + 1;
            }
            out = out + " (local.get $rb))\n";
            // Materialize the struct: type id at slot 0, then fill each field
            // (scalar or nested) recursively from the inlined canonical area.
            out = out + "    (local.set $s (call $__fern_str_box (i32.const " + util.i32_to_string(4 + nf * 4) + ")))\n";
            out = out + "    (i32.store (local.get $s) (i32.const " + util.i32_to_string(struct_id(mod.structs, f.ret_type)) + "))\n";
            out = out + extern_emit_record_fill(mod, "$s", f.ret_type, 0, 0);
            out = out + "    (local.get $s))\n";
        } else if (f.import_iface.len() > 0 && extern_sum_param_supported(f.ret_type)) {
            // option/result result (P4c): flattens to (disc, payload), returned
            // indirectly (disc:u8 @0, payload:i32 @4). The wrapper materializes
            // a self-host enum box [tag:i32 @0][payload @4], remapping the
            // discriminant back (1-disc for option).
            out = out + "  (func $" + f.name;
            var sp2: i32 = 0;
            while (sp2 < f.params.len()) {
                out = out + " (param $ep" + util.i32_to_string(sp2) + " " + wat_extern_valtype(f.params[sp2].type_name) + ")";
                sp2 = sp2 + 1;
            }
            out = out + " (result i32)\n";
            out = out + "    (local $rb i32) (local $s i32)\n";
            // Return area: disc:u8 @0, payload @4 (8 bytes), 8-aligned with slack.
            out = out + "    (local.set $rb (i32.and (i32.add (call $__fern_alloc (i32.const 15)) (i32.const 7)) (i32.const -8)))\n";
            out = out + "    (call $" + f.name + "__import";
            var sa: i32 = 0;
            while (sa < f.params.len()) {
                out = out + " (local.get $ep" + util.i32_to_string(sa) + ")";
                sa = sa + 1;
            }
            out = out + " (local.get $rb))\n";
            // Materialize the enum box: tag (remapped) @0, payload @4.
            out = out + "    (local.set $s (call $__fern_alloc (i32.const 8)))\n";
            if (extern_sum_param_is_option(f.ret_type)) {
                out = out + "    (i32.store (local.get $s) (i32.sub (i32.const 1) (i32.load8_u (local.get $rb))))\n";
            } else {
                out = out + "    (i32.store (local.get $s) (i32.load8_u (local.get $rb)))\n";
            }
            out = out + "    (i32.store offset=4 (local.get $s) (i32.load offset=4 (local.get $rb)))\n";
            out = out + "    (local.get $s))\n";
        } else if (f.import_iface.len() > 0 && extern_plain_enum_param(mod, f.ret_type)) {
            // WIT enum result: the import returns a single i32 discriminant; the
            // wrapper materializes the Fern payloadless enum value by mapping the
            // disc to the matching variant's struct_id and storing it in a fresh
            // `[struct_id@0]` box (the same shape a bare `Green` produces).
            out = out + "  (func $" + f.name;
            var enp: i32 = 0;
            while (enp < f.params.len()) {
                out = out + " (param $ep" + util.i32_to_string(enp) + " " + wat_extern_valtype(f.params[enp].type_name) + ")";
                enp = enp + 1;
            }
            out = out + " (result i32)\n";
            out = out + "    (local $d i32) (local $s i32)\n";
            out = out + "    (local.set $d (call $" + f.name + "__import";
            var ena: i32 = 0;
            while (ena < f.params.len()) {
                out = out + " (local.get $ep" + util.i32_to_string(ena) + ")";
                ena = ena + 1;
            }
            out = out + "))\n";
            out = out + "    (local.set $s (call $__fern_alloc (i32.const 4)))\n";
            out = out + "    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n";
            out = out + "    (local.get $s))\n";
        } else if (f.import_iface.len() > 0 && extern_variant_result_supported(mod, f.ret_type)) {
            // variant result: returned indirectly. The canonical variant memory
            // layout is disc:u8 @0 then the payload aligned to the join width — @4
            // for an i32 join, @8 for an i64 (mixed-width) join. The wrapper
            // materializes a self-host payloaded-variant box [struct_id@0][payload
            // @4], mapping the disc to the variant's struct_id (extern_plain_enum_sid).
            // For an i64 join it stores the full 8-byte payload; a match on a
            // 32-bit arm then reads only its low 4 bytes (S1 width-aware bind), so
            // no per-arm result branch is needed.
            var vj64: boolean = extern_variant_join_is64(mod, f.ret_type);
            var vmf: boolean = extern_variant_is_multifield(mod, f.ret_type);
            var vsc: i32 = extern_variant_max_fields(mod, f.ret_type);
            out = out + "  (func $" + f.name;
            var vrp: i32 = 0;
            while (vrp < f.params.len()) {
                out = out + " (param $ep" + util.i32_to_string(vrp) + " " + wat_extern_valtype(f.params[vrp].type_name) + ")";
                vrp = vrp + 1;
            }
            out = out + " (result i32)\n";
            out = out + "    (local $rb i32) (local $d i32) (local $s i32)\n";
            // Return area, 8-aligned with slack: i32 join needs 8 usable bytes
            // (payload @4), i64 join 16 (payload @8), a multi-field join 4 +
            // SlotCount*4 (slots @4,8,…) — over-alloc by 7 to align.
            if (vmf) {
                out = out + "    (local.set $rb (i32.and (i32.add (call $__fern_alloc (i32.const " + util.i32_to_string(4 + vsc * 4 + 7) + ")) (i32.const 7)) (i32.const -8)))\n";
            } else if (vj64) {
                out = out + "    (local.set $rb (i32.and (i32.add (call $__fern_alloc (i32.const 23)) (i32.const 7)) (i32.const -8)))\n";
            } else {
                out = out + "    (local.set $rb (i32.and (i32.add (call $__fern_alloc (i32.const 15)) (i32.const 7)) (i32.const -8)))\n";
            }
            out = out + "    (call $" + f.name + "__import";
            var vra: i32 = 0;
            while (vra < f.params.len()) {
                out = out + " (local.get $ep" + util.i32_to_string(vra) + ")";
                vra = vra + 1;
            }
            out = out + " (local.get $rb))\n";
            out = out + "    (local.set $d (i32.load8_u (local.get $rb)))\n";
            // Materialize [struct_id@0][payload@4] (struct_id mapped from disc); box
            // sized for the join (12 bytes for an i64 payload, 4+SlotCount*4 for a
            // multi-field one, else 8).
            if (vmf) {
                // Multi-field: copy every SlotCount slot (area @4+4*j) into the box
                // field j (@struct_field_off(j) = 4+4*j). The return area is sized
                // for the widest arm, so reading all slots is in-bounds; a match on
                // a shorter arm reads only its own fields (the rest stay unread).
                out = out + "    (local.set $s (call $__fern_alloc (i32.const " + util.i32_to_string(4 + vsc * 4) + ")))\n";
                out = out + "    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n";
                var cj: i32 = 0;
                while (cj < vsc) {
                    out = out + "    (i32.store offset=" + util.i32_to_string(struct_field_off(cj)) + " (local.get $s) (i32.load offset=" + util.i32_to_string(struct_field_off(cj)) + " (local.get $rb)))\n";
                    cj = cj + 1;
                }
            } else if (extern_variant_is_uniform_f64(mod, f.ret_type)) {
                // uniform f64: the return area packs the f64 payload @8 (8-aligned);
                // store it into the box @4 as an f64. Checked before vj64 (which
                // also fires for an f64 arm).
                out = out + "    (local.set $s (call $__fern_alloc (i32.const 12)))\n";
                out = out + "    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n";
                out = out + "    (f64.store offset=4 (local.get $s) (f64.load offset=8 (local.get $rb)))\n";
            } else if (vj64) {
                out = out + "    (local.set $s (call $__fern_alloc (i32.const 12)))\n";
                out = out + "    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n";
                out = out + "    (i64.store offset=4 (local.get $s) (i64.load offset=8 (local.get $rb)))\n";
            } else if (extern_variant_has_f32_arm(mod, f.ret_type)) {
                // i32 join with an f32 arm (S2, #5327): the host's payload slot
                // carries the f32's raw bits @4. The box stores an f32 payload
                // widened to f64 (S1), so the store is branched per-arm on the
                // disc: the f32 arm bridges bits → f32 → f64 into a 12-byte
                // box; every other arm keeps the plain i32 copy.
                out = out + "    (local.set $s (call $__fern_alloc (i32.const 12)))\n";
                out = out + "    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n";
                out = out + "    " + extern_variant_result_store_f32(mod, f.ret_type) + "\n";
            } else {
                out = out + "    (local.set $s (call $__fern_alloc (i32.const 8)))\n";
                out = out + "    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n";
                out = out + "    (i32.store offset=4 (local.get $s) (i32.load offset=4 (local.get $rb)))\n";
            }
            out = out + "    (local.get $s))\n";
        } else if (f.import_iface.len() > 0 && is_extern_composite_ret(mod, f.ret_type)) {
            out = out + "  (func $" + f.name;
            var args: string = "";
            var p: i32 = 0;
            while (p < f.params.len()) {
                var pn: string = "$ep" + util.i32_to_string(p);
                out = out + " (param " + pn + " " + wat_extern_valtype(f.params[p].type_name) + ")";
                args = args + " (local.get " + pn + ")";
                p = p + 1;
            }
            out = out + " (result i32)\n";
            out = out + "    (local $rb i32) (local $dp i32) (local $ln i32) (local $s i32) (local $i i32)\n";
            // The canonical return area for a list/string result must be
            // 4-byte aligned; __fern_alloc bumps without aligning, so over-
            // allocate and round up. 12 = 8-byte area + 3 bytes of slack.
            out = out + "    (local.set $rb (i32.and (i32.add (call $__fern_alloc (i32.const 12)) (i32.const 3)) (i32.const -4)))\n";
            out = out + "    (call $" + f.name + "__import" + args + " (local.get $rb))\n";
            out = out + "    (local.set $dp (i32.load (local.get $rb)))\n";
            out = out + "    (local.set $ln (i32.load offset=4 (local.get $rb)))\n";
            if (f.ret_type == "u8[]" || f.ret_type == "boolean[]") {
                // u8[] / boolean[]: `[len@0]` header, elements packed into 4-byte
                // slots at +8 (the self-host array layout — see elem_slot_size).
                // Both store one byte per element, so expand each host byte into
                // its slot (a boolean[] element is the canonical list<bool> byte,
                // 0/1, the same shape as a list<u8> byte).
                out = out + "    (local.set $s (call $__fern_arr_box (i32.mul (local.get $ln) (i32.const 4))))\n";
                out = out + "    (i32.store (local.get $s) (local.get $ln))\n";
                out = out + "    (local.set $i (i32.const 0))\n";
                out = out + "    (block $d (loop $c\n";
                out = out + "      (br_if $d (i32.ge_u (local.get $i) (local.get $ln)))\n";
                out = out + "      (i32.store (i32.add (i32.add (local.get $s) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load8_u (i32.add (local.get $dp) (local.get $i))))\n";
                out = out + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
                out = out + "      (br $c)))\n";
                out = out + "    (local.get $s))\n";
            } else if (extern_array_param_supported(f.ret_type)) {
                // numeric array list<T>: the slot size equals the canonical
                // element size, so copy each element straight into its slot at
                // +8 (no byte-expansion as for u8[]).
                var rk: str = f.ret_type[0:f.ret_type.len() - 2];
                var rss: string = util.i32_to_string(elem_slot_size(rk));
                out = out + "    (local.set $s (call $__fern_arr_box (i32.mul (local.get $ln) (i32.const " + rss + "))))\n";
                out = out + "    (i32.store (local.get $s) (local.get $ln))\n";
                out = out + "    (local.set $i (i32.const 0))\n";
                out = out + "    (block $d (loop $c\n";
                out = out + "      (br_if $d (i32.ge_u (local.get $i) (local.get $ln)))\n";
                out = out + "      (" + elem_store_op(rk) + " (i32.add (i32.add (local.get $s) (i32.const 8)) (i32.mul (local.get $i) (i32.const " + rss + "))) (" + elem_load_op(rk) + " (i32.add (local.get $dp) (i32.mul (local.get $i) (i32.const " + rss + ")))))\n";
                out = out + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
                out = out + "      (br $c)))\n";
                out = out + "    (local.get $s))\n";
            } else {
                // string: `[len][bytes]` block.
                out = out + "    (local.set $s (call $__fern_alloc (i32.add (i32.const 4) (local.get $ln))))\n";
                out = out + "    (i32.store (local.get $s) (local.get $ln))\n";
                out = out + "    (local.set $i (i32.const 0))\n";
                out = out + "    (block $d (loop $c\n";
                out = out + "      (br_if $d (i32.ge_u (local.get $i) (local.get $ln)))\n";
                out = out + "      (i32.store8 (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $dp) (local.get $i))))\n";
                out = out + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
                out = out + "      (br $c)))\n";
                out = out + "    (local.get $s))\n";
            }
        }
        i = i + 1;
    }
    return out;
}

// emit_dyn_dispatch lowers a method call on a `dyn Trait` (trait-object)
// receiver whose concrete type isn't known statically: it reads the
// receiver's runtime struct id (the type tag at offset 0, the same one
// `match` reads) and branches to the matching `$Struct__method`, over
// every struct that implements `field`. Returns "" when no struct
// implements it (so the caller keeps its `(i32.const 0)` fallback).
// The wasm backend is otherwise static-dispatch; this is the runtime
// dispatch that makes `dyn Trait` work (mirroring the native backends'
// runtime shape-compare). The receiver is parked in `$__lit<depth>` so a
// non-trivial receiver expression evaluates once.
function emit_dyn_dispatch(obj: parser.Expr, field: string, args: parser.Expr[], cx: Ctx, depth: i32): string {
    var impls: string[] = [];
    var i: i32 = 0;
    while (i < cx.mr_names.len()) {
        if (cx.mr_names[i] == field && is_struct_type(cx.structs, cx.mr_types[i])
                && !contains_str(impls, cx.mr_types[i])) {
            impls = impls.append(cx.mr_types[i]);
        }
        i = i + 1;
    }
    if (impls.len() == 0) { return ""; }
    var sc: string = "$__lit" + util.i32_to_string(depth);
    var argtext: string = "";
    var a: i32 = 0;
    while (a < args.len()) {
        argtext = argtext + " " + emit_expr(args[a], cx, depth + 1);
        a = a + 1;
    }
    var wt: string = wasm_result_type(method_ret(cx, impls[0], field));
    var chain: string = wasm_zero(wt);
    var k: i32 = impls.len() - 1;
    while (k >= 0) {
        var sid: i32 = struct_id(cx.structs, impls[k]);
        chain = "(if (result " + wt + ") (i32.eq (i32.load (local.get " + sc + ")) (i32.const " + util.i32_to_string(sid)
            + ")) (then (call $" + impls[k] + "__" + field + " (local.get " + sc + ")" + argtext + ")) (else " + chain + "))";
        k = k - 1;
    }
    return "(block (result " + wt + ") (local.set " + sc + " " + emit_expr(obj, cx, depth + 1) + ") " + chain + ")";
}

// is_enum_type_name reports whether `name` is a method-bearing ENUM type —
// not a declared struct, but the receiver type of at least one method.
// Enum names aren't in the struct table (only their variants are), so a
// var typed `Shape` must record `Shape` (not the variant from its
// initializer) for its methods to dispatch.
function is_enum_type_name(cx: Ctx, name: string): boolean {
    if (name.len() == 0) { return false; }
    // A primitive scalar OR `string` receiver type (`impl Eq for i32`,
    // `impl Show for string`, `function (n: i32) twice()`) lands in mr_types too,
    // but is NEVER an enum — guard it, else a struct's i32/i64/f64/boolean field
    // gets misclassified "S" (drop helper emits an undefined `$__fern_release_i32`)
    // or a `string[]` field's element is taken for a struct (undefined
    // `$__fern_arr_release_string`) — both are wasm validation errors.
    if (is_primitive_type_name(name) || name == "string") { return false; }
    if (is_struct_type(cx.structs, name)) { return false; }
    var i: i32 = 0;
    while (i < cx.mr_types.len()) {
        if (cx.mr_types[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// is_primitive_type_name reports whether `name` spells a built-in scalar type
// (never rc-tracked, never a struct/enum). Scalars are released as no-ops.
function is_primitive_type_name(name: string): boolean {
    return name == "i32" || name == "i64" || name == "f64" || name == "boolean";
}

// func_body_matches_variant reports whether `stmts` contains a top-level
// `match (<recv>) { … }` with an arm whose variant pattern names `variant`
// — i.e. the receiver method dispatches that variant. Used to recover the
// enum a variant belongs to (the variant->enum link is dropped at parse;
// only the enum's methods carry it, in their `match (self)` arms).
function func_body_matches_variant(stmts: parser.Stmt[], recv: string, variant: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtMatch(m) => {
                var is_recv: boolean = false;
                match (m.scrutinee) {
                    parser.ExprIdent(id) => { if (id.name == recv) { is_recv = true; } },
                    _ => {},
                }
                if (is_recv) {
                    var a: i32 = 0;
                    while (a < m.arms.len()) {
                        match (m.arms[a].pattern) {
                            parser.PatVariant(pv) => { if (pv.type_name == variant) { return true; } },
                            _ => {},
                        }
                        a = a + 1;
                    }
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// enum_of_variant returns the enum type a variant constructor `name`
// belongs to (`Has` -> `Opt`), or "" if `name` isn't a known variant. It
// scans the enum methods (a receiver method whose type is an enum, not a
// struct) for the one whose `match (self)` handles `name`. This lets an
// INLINE variant receiver (`Has(5).eq(…)`, `Nil.eq(…)`) dispatch to the
// enum's method statically — the var-typed form already worked because the
// var's annotation records the enum directly.
function enum_of_variant(cx: Ctx, name: string): string {
    var i: i32 = 0;
    while (i < cx.mod_funcs.len()) {
        var fd: parser.FuncDecl = cx.mod_funcs[i];
        if (fd.receiver_name.len() > 0 && is_enum_type_name(cx, fd.receiver_type)) {
            if (func_body_matches_variant(fd.body, fd.receiver_name, name)) {
                return fd.receiver_type;
            }
        }
        i = i + 1;
    }
    return "";
}

// expr_is_void_call is true when `e` calls a user free function or method
// declared with no return type — such a call leaves nothing on the stack,
// so it must NOT be wrapped in `(drop …)`. Builtins (which return values)
// aren't in mod_funcs / the method registry, so they read as non-void.
function expr_is_void_call(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    var i: i32 = 0;
                    while (i < cx.mod_funcs.len()) {
                        if (cx.mod_funcs[i].receiver_type.len() == 0 && cx.mod_funcs[i].name == id.name) {
                            return !returns_value(cx.mod_funcs[i].ret_type);
                        }
                        i = i + 1;
                    }
                    return false;
                },
                parser.ExprFieldAccess(fa) => {
                    var rt: string = struct_type_of(fa.obj, cx);
                    return has_method(cx, rt, fa.field) && !returns_value(method_ret(cx, rt, fa.field));
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

function method_ret(cx: Ctx, t: string, n: string): string {
    var i: i32 = 0;
    while (i < cx.mr_types.len()) {
        if (cx.mr_types[i] == t && cx.mr_names[i] == n) { return cx.mr_rets[i]; }
        i = i + 1;
    }
    return "";
}

// parse_result_err_payload extracts the Err type E from a `Result[T, E]` type
// spelling via the structured TypeRef (SH-021, docs/SELF-HOST-AUDIT.md T2), or ""
// for an Option (no Err arm), a non-Result type, or an ARRAY of Result
// (`Result[…, …][]` is an array value, not a Result). Used to release a Result's
// Err payload on free. Supersedes the former `Result[` prefix + top-level-comma
// depth scan; on the array case that scan returned garbage (the prefix matched
// and the trailing `]` passed the last-char test), which this corrects to "".
pub function parse_result_err_payload(t: string): string {
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.array_depth == 0 && r.base == "Result" && r.args.len() >= 2) {
        return parser.render_type_ref(r.args[1]);
    }
    return "";
}

// parse_option_payload extracts the Some/Ok payload type T from an `Option[T]` /
// `Result[T, E]` type spelling via the structured TypeRef, or "" for any other
// type (incl. an ARRAY of option/result — `Option[…][]` is an array, not an
// Option). Same SH-021 migration as parse_result_err_payload; the former scan
// returned garbage on the array case, corrected here to "".
pub function parse_option_payload(t: string): string {
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.array_depth == 0 && (r.base == "Option" || r.base == "Result") && r.args.len() >= 1) {
        return parser.render_type_ref(r.args[0]);
    }
    return "";
}

// A `for (k, v) in m` loop encodes its two binding names as "k,v" in the
// for-var; comma_index / before_comma / after_comma split them.
function comma_index(s: string): i32 {
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == 44) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function before_comma(s: string): string {
    var c: i32 = comma_index(s);
    if (c < 0) { return s; }
    return s[0:c] + "";
}

function after_comma(s: string): string {
    var c: i32 = comma_index(s);
    if (c < 0) { return ""; }
    return s[c + 1 : s.len()] + "";
}

// split_commas breaks a comma-joined name list ("a,b,c") into its parts.
// Used by `var (a, b, …)` tuple destructuring, which supports any arity.
function split_commas(s: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= s.len()) {
        if (i == s.len() || s[i] == 44) {
            out = out.append(s[start:i]);
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// struct_field_index returns the 0-based field position of `field` in the
// struct named `tn` (the heap offset is index*4), or -1 if not found.
function struct_field_index(structs: parser.StructDecl[], tn: string, field: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) {
            var j: i32 = 0;
            while (j < structs[i].fields.len()) {
                if (structs[i].fields[j].name == field) { return j; }
                j = j + 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// struct_field_count returns the number of fields in struct `tn` (0 if
// unknown).
function struct_field_count(structs: parser.StructDecl[], tn: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) { return structs[i].fields.len(); }
        i = i + 1;
    }
    return 0;
}

// struct_field_type returns the declared type of `field` in struct `tn`
// ("" if unknown).
function struct_field_type(structs: parser.StructDecl[], tn: string, field: string): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == tn) {
            var j: i32 = 0;
            while (j < structs[i].fields.len()) {
                if (structs[i].fields[j].name == field) { return structs[i].fields[j].type_name; }
                j = j + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// lookup_pair returns the value paired with `key` in two parallel arrays
// (keys/vals), or "" if absent.
function lookup_pair(keys: string[], vals: string[], key: string): string {
    var i: i32 = 0;
    while (i < keys.len()) {
        if (keys[i] == key) { return vals[i]; }
        i = i + 1;
    }
    return "";
}

// base_type_name strips a generic argument list from a type spelling:
// `Box[i32]` / `Box[T]` → `Box`. Generics are erased, so the base name is
// what matches the struct table. (A plain `[T]` array type has no base
// ident, so this returns "" for it — harmless, arrays aren't structs.)
// base_type_name -> util.base_type_name (SH-020).

// is_struct_type is true when `t` names a declared struct.
function is_struct_type(structs: parser.StructDecl[], t: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == t) { return true; }
        i = i + 1;
    }
    return false;
}

// struct_id returns a stable runtime type id for a struct (its index in
// the module's struct table), stored at offset 0 of every struct value so
// a union `match` can dispatch on it. -1 if unknown.
function struct_id(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// struct_field_off is the byte offset of field index `idx` in a struct
// value: the type id occupies slot 0, so fields start at 4.
function struct_field_off(idx: i32): i32 {
    return 4 + idx * 4;
}

// struct_type_of resolves the struct type name of an expression, or ""
// when it isn't struct-typed: a struct-valued local/param, a struct
// literal, a struct-returning call, or a struct-typed field of a struct.
function struct_type_of(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprIdent(id) => {
            var sv: string = lookup_pair(cx.sv_names, cx.sv_types, id.name);
            if (sv.len() > 0) { return sv; }
            // A bare unit-variant receiver (`Nil.eq(…)`): map it to its enum.
            if (is_struct_type(cx.structs, id.name)) { return enum_of_variant(cx, id.name); }
            return "";
        },
        parser.ExprStructLit(sl) => { return sl.type_name; },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    var sf: string = lookup_pair(cx.sf_names, cx.sf_types, id.name);
                    if (sf.len() > 0) { return sf; }
                    // A positional variant constructor receiver (`Has(5).eq(…)`):
                    // map the variant to its enum so the method dispatches.
                    if (is_struct_type(cx.structs, id.name)) { return enum_of_variant(cx, id.name); }
                    return "";
                },
                parser.ExprFieldAccess(fa) => {
                    // A struct/enum-valued map's `.get_or` result is that struct
                    // type (so `m.get_or(k, d).field` resolves). `.get` returns
                    // an Option box, not the bare value, so it's excluded here.
                    if (fa.field == "get_or" && is_map_expr(fa.obj, cx)) {
                        var mvt: string = map_val_struct_type(fa.obj, cx);
                        if (mvt.len() > 0) { return mvt; }
                    }
                    // A receiver method returning a struct.
                    var rt: string = method_ret(cx, struct_type_of(fa.obj, cx), fa.field);
                    if (is_struct_type(cx.structs, rt)) { return rt; }
                    return "";
                },
                _ => { return ""; },
            }
        },
        parser.ExprFieldAccess(fa) => {
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return ""; }
            var ft: string = struct_field_type(cx.structs, ot, fa.field);
            if (is_struct_type(cx.structs, ft)) { return ft; }
            return "";
        },
        parser.ExprIndex(ix) => {
            // pts[i] is a struct when pts is a struct-array.
            return struct_array_elem_type(ix.array, cx);
        },
        _ => { return ""; },
    }
    return "";
}

// str_trim_spaces strips leading/trailing ASCII spaces (32).
function str_trim_spaces(s: string): string {
    var a: i32 = 0;
    while (a < s.len() && s[a] == 32) { a = a + 1; }
    var b: i32 = s.len();
    while (b > a && s[b - 1] == 32) { b = b - 1; }
    return s[a:b] + "";
}

// nth_tuple_type_elem parses a tuple-type spelling "(A, B, …)" and returns the
// idx-th element type, or "" when the spelling isn't a tuple or idx is out of
// range. Decodes via the structured TypeRef (SH-021, docs/SELF-HOST-AUDIT.md T2)
// instead of a hand-rolled bracket/paren depth scan; parse_type_ref already splits
// the elements without letting a nested generic's (Map[K, V]) or tuple's inner
// commas confuse the split. A tuple-ARRAY ("(A, B)[]", array_depth > 0) is a value
// of array type, not a tuple, so it returns "" — the former scan keyed only off a
// leading "(" and so mis-read the trailing "[]" as tuple content, wrongly reporting
// e.g. `(i32, i32)[]` as a flat extern tuple param; the fixpoints confirm no such
// tuple-array spelling reaches this on the self-host sources.
pub function nth_tuple_type_elem(spelling: string, idx: i32): string {
    var r: parser.TypeRef = parser.parse_type_ref(spelling);
    if (r.array_depth != 0 || !r.is_tuple) { return ""; }
    if (idx < 0 || idx >= r.args.len()) { return ""; }
    return parser.render_type_ref(r.args[idx]);
}

// nth_csv_elem returns the idx-th comma-separated field of `csv` (used for
// the per-element struct-type list tracked on a tuple local), or "".
function nth_csv_elem(csv: string, idx: i32): string {
    var cur: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < csv.len()) {
        if (csv[i] == 44) {
            if (cur == idx) { return csv[start:i] + ""; }
            cur = cur + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (cur == idx) { return csv[start:csv.len()] + ""; }
    return "";
}

// free_func_ret_spelling returns the declared return-type spelling of a
// free function by name (e.g. "(P, i32)"), or "" if not found.
function free_func_ret_spelling(cx: Ctx, name: string): string {
    var i: i32 = 0;
    while (i < cx.mod_funcs.len()) {
        if (cx.mod_funcs[i].name == name && cx.mod_funcs[i].receiver_name.len() == 0) {
            return cx.mod_funcs[i].ret_type;
        }
        i = i + 1;
    }
    return "";
}

// tuple_svtypes_csv builds the per-element struct-type list of a tuple
// literal ("P," for `(P{…}, 1)`), so a later destructure of a tuple local
// can recover each element's struct type.
function tuple_svtypes_csv(elements: parser.Expr[], cx: Ctx): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < elements.len()) {
        if (i > 0) { out = out + ","; }
        out = out + struct_type_of(elements[i], cx);
        i = i + 1;
    }
    return out;
}

// tuple_elem_struct_type resolves the struct type of element `idx` of a
// tuple-valued expression, or "" when that element isn't a struct: an
// inline tuple literal, a call to a tuple-returning free function / method
// (parsed from its return-type spelling), or a tracked tuple local.
function tuple_elem_struct_type(obj: parser.Expr, idx: i32, cx: Ctx): string {
    match (obj) {
        parser.ExprTuple(t) => {
            if (idx >= 0 && idx < t.elements.len()) { return struct_type_of(t.elements[idx], cx); }
            return "";
        },
        parser.ExprIdent(id) => {
            var el: string = nth_csv_elem(lookup_pair(cx.tup_names, cx.tup_svtypes, id.name), idx);
            if (is_struct_type(cx.structs, el)) { return el; }
            return "";
        },
        parser.ExprCall(c) => {
            var spelling: string = "";
            match (c.callee) {
                parser.ExprIdent(cid) => { spelling = free_func_ret_spelling(cx, cid.name); },
                parser.ExprFieldAccess(fa) => { spelling = method_ret(cx, struct_type_of(fa.obj, cx), fa.field); },
                _ => {},
            }
            var el2: string = nth_tuple_type_elem(spelling, idx);
            if (is_struct_type(cx.structs, el2)) { return el2; }
            return "";
        },
        _ => { return ""; },
    }
    return "";
}

// struct_array_elem_type returns the element struct type of a struct-array
// expression ("" otherwise): a tracked struct-array local, an array literal
// of struct values, or a slice of one.
function struct_array_elem_type(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprIdent(id) => { return lookup_pair(cx.sa_names, cx.sa_types, id.name); },
        parser.ExprArray(a) => {
            if (a.elements.len() > 0) { return struct_type_of(a.elements[0], cx); }
            return "";
        },
        parser.ExprSlice(sl) => { return struct_array_elem_type(sl.array, cx); },
        parser.ExprFieldAccess(fa) => {
            // A struct field whose declared type is a struct array, e.g.
            // `bag.items` where `items: Pt[]` — so `bag.items[i].field`
            // resolves. (Without this the element read falls back to a
            // bogus `(i32.const 0)`.)
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return ""; }
            var ft: string = struct_field_type(cx.structs, ot, fa.field);
            if (ft.len() > 2 && ft[ft.len() - 2:ft.len()] == "[]") {
                var elem: str = ft[0:ft.len() - 2];
                if (is_struct_type(cx.structs, elem)) { return elem + ""; }
            }
            return "";
        },
        _ => { return ""; },
    }
    return "";
}

// array_elem_kind classifies an array expression's element width: "i64" /
// "f64" (an 8-byte slot + i64/f64 load/store) or "i32" (the 4-byte
// default). It drives the stride and load/store op at every
// array-element site. NOTE: an inline literal of bare integer literals
// reads as "i32" here (the literals carry no width) — the i64/f64-ness of
// such a literal comes from its declaration context, which passes the
// kind explicitly to emit_array_literal.
function array_elem_kind(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprIdent(id) => {
            if (contains_str(cx.i64_arr_names, id.name)) { return "i64"; }
            if (contains_str(cx.f64_arr_names, id.name)) { return "f64"; }
            return "i32";
        },
        parser.ExprSlice(sl) => { return array_elem_kind(sl.array, cx); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return arr_kind_of_spelling(free_func_ret_spelling(cx, id.name)); },
                parser.ExprFieldAccess(fa) => { return arr_kind_of_spelling(method_ret(cx, struct_type_of(fa.obj, cx), fa.field)); },
                _ => { return "i32"; },
            }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (is_i64_expr(a.elements[i], cx)) { return "i64"; }
                if (is_f64_expr(a.elements[i], cx)) { return "f64"; }
                i = i + 1;
            }
            return "i32";
        },
        _ => { return "i32"; },
    }
    return "i32";
}

// arr_kind_of_spelling maps an array type spelling to its element kind.
function arr_kind_of_spelling(t: string): string {
    if (t == "i64[]") { return "i64"; }
    if (t == "f64[]" || t == "f32[]") { return "f64"; }
    return "i32";
}

// field_kind_of_type maps a SCALAR field/payload type spelling to its heap
// slot kind: "i64" (64-bit int — 8-byte slot, i64 load/store), "f64" (any
// float, incl. f32 which the self-host widens to f64 — 8-byte slot), or "i32"
// (the 4-byte default). Drives the wide enum-payload slot (S1) the same way
// arr_kind_of_spelling drives wide array elements.
function field_kind_of_type(t: string): string {
    if (t == "i64" || t == "u64") { return "i64"; }
    if (is_float_type(t)) { return "f64"; }
    return "i32";
}

// elem_slot_size / elem_store_op / elem_load_op give the per-element byte
// stride and the wasm store/load instruction for an element kind.
function elem_slot_size(kind: string): i32 {
    if (kind == "i64" || kind == "f64") { return 8; }
    return 4;
}
function elem_store_op(kind: string): string {
    if (kind == "i64") { return "i64.store"; }
    if (kind == "f64") { return "f64.store"; }
    return "i32.store";
}
function elem_load_op(kind: string): string {
    if (kind == "i64") { return "i64.load"; }
    if (kind == "f64") { return "f64.load"; }
    return "i32.load";
}

// sa_elem_decl_type returns the element struct type a `var` declares as a
// struct-array (from its init array literal or a `T[]` annotation), "" if
// it isn't one.
function sa_elem_decl_type(v: parser.StmtVar, cx: Ctx): string {
    // A `dyn Trait[]` local is a heterogeneous trait-object array — never a
    // homogeneous struct array, even when its initializer literal happens to
    // start with a concrete struct. Leaving it untyped keeps the loop var's
    // method calls on the runtime-dispatch (emit_dyn_dispatch) path.
    if (v.type_name.len() >= 4 && v.type_name[0:4] == "dyn ") { return ""; }
    var et: string = struct_array_elem_type(v.init, cx);
    if (et.len() == 0 && v.type_name.len() > 2 && v.type_name[v.type_name.len() - 2] == 91 && is_struct_type(cx.structs, util.base_type_name(v.type_name))) {
        et = util.base_type_name(v.type_name);
    }
    return et;
}

// collect_struct_array_names / _types are parallel collectors (same
// traversal) recording struct-array `var`s and their element struct types.
function collect_struct_array_names(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (sa_elem_decl_type(v, cx).len() > 0) { acc = acc.append(v.name); } },
            parser.StmtIf(f) => {
                acc = collect_struct_array_names(f.then_body, cx, acc);
                acc = collect_struct_array_names(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_struct_array_names(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_struct_array_names(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_struct_array_names(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

function collect_struct_array_types(body: parser.Stmt[], cx: Ctx, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                var et: string = sa_elem_decl_type(v, cx);
                if (et.len() > 0) { acc = acc.append(et); }
            },
            parser.StmtIf(f) => {
                acc = collect_struct_array_types(f.then_body, cx, acc);
                acc = collect_struct_array_types(f.else_body, cx, acc);
            },
            parser.StmtWhile(w) => { acc = collect_struct_array_types(w.body, cx, acc); },
            parser.StmtFor(f) => { acc = collect_struct_array_types(f.body, cx, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) { acc = collect_struct_array_types(m.arms[k].body, cx, acc); k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// scrutinee_payload returns the Some/Ok payload type of an Option/Result-
// typed expression: a call to an option-returning function, or an
// option-typed local. "" when unknown.
function scrutinee_payload(e: parser.Expr, cx: Ctx): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // env(name): Option[string] / read_file(path):
                    // Result[string, _] — both Ok/Some payload is string.
                    if (id.name == "env" || id.name == "read_file") { return "string"; }
                    return lookup_pair(cx.of_names, cx.of_payloads, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    // get on a string-valued map → Option[string].
                    if (fa.field == "get" && c.args.len() == 1 && is_str_val_map(fa.obj, cx)) { return "string"; }
                    // A receiver method returning Option[T] / Result[T,E].
                    return parse_option_payload(method_ret(cx, struct_type_of(fa.obj, cx), fa.field));
                },
                _ => { return ""; },
            }
        },
        parser.ExprIdent(id) => { return lookup_pair(cx.ol_names, cx.ol_payloads, id.name); },
        _ => { return ""; },
    }
    return "";
}

// set_field_offset computes the byte offset for an `obj.field = v`
// desugar (`__set_field(obj, "field", v)`): the field-name string-literal
// arg resolved against obj's struct type.
function set_field_offset(obj: parser.Expr, name_arg: parser.Expr, cx: Ctx): i32 {
    var fname: string = "";
    match (name_arg) {
        parser.ExprString(se) => { fname = se.value; },
        _ => {},
    }
    var idx: i32 = struct_field_index(cx.structs, struct_type_of(obj, cx), fname);
    if (idx < 0) { return 4; }
    return struct_field_off(idx);
}

// WState threads the WAT body being built (out), a fresh-label counter
// (n), the current loop's break / continue labels (brk / cont, "" when
// not inside a loop), and the emission context (cx).
struct WState { out: string, n: i32, brk: string, cont: string, cx: Ctx, fd: i32, md: i32 }

// w appends text to the WAT body. Fern struct fields are immutable, so
// this returns a rebuilt WState (functional update) rather than mutating
// in place. Output here is small (one function body), so `out + text` is
// fine — asm.fern's strbuf optimisation is only needed for the huge
// self-compile bundles.
function (s: WState) w(text: string): WState {
    return WState { ...s, out: s.out + text };
}

// i32_to_string renders an i32 as decimal (used for fresh label
// numbers). Mirrors asm.fern's helper — the self-host doesn't expose an
// `(i32).to_string()` method to emitter code, so each emitter carries
// its own.
// i32_to_string now lives in util.fern (imported as `util`). See SH-020.

// is_all_digits / digits_to_i32 recognise + parse a tuple-index field name
// (`.0`, `.1`, …) — the parser stores it as a numeric string.
// is_all_digits now lives in util.fern (imported as `util`). See SH-020.

// digits_to_i32 now lives in util.fern (imported as `util`). See SH-020.
function hex_digit(d: i32): string {
    if (d == 0) { return "0"; } else if (d == 1) { return "1"; }
    else if (d == 2) { return "2"; } else if (d == 3) { return "3"; }
    else if (d == 4) { return "4"; } else if (d == 5) { return "5"; }
    else if (d == 6) { return "6"; } else if (d == 7) { return "7"; }
    else if (d == 8) { return "8"; } else if (d == 9) { return "9"; }
    else if (d == 10) { return "a"; } else if (d == 11) { return "b"; }
    else if (d == 12) { return "c"; } else if (d == 13) { return "d"; }
    else if (d == 14) { return "e"; } else { return "f"; }
}

// wat_escape renders a string's bytes for a WAT `(data …)` payload:
// printable ASCII passes through (except `"` and `\`), everything else
// becomes a `\HH` hex escape — so embedded newlines / quotes survive.
pub function wat_escape(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            out = out + s[i:i + 1];
        } else {
            out = out + "\\" + hex_digit(b / 16) + hex_digit(b % 16);
        }
        i = i + 1;
    }
    return out;
}

// le32_escape renders a non-negative i32 as four little-endian bytes in
// WAT `\HH` escape form — the length prefix of a string block.
pub function le32_escape(n: i32): string {
    var b0: i32 = n % 256;
    var b1: i32 = (n / 256) % 256;
    var b2: i32 = (n / 65536) % 256;
    var b3: i32 = (n / 16777216) % 256;
    return "\\" + hex_digit(b0 / 16) + hex_digit(b0 % 16)
        + "\\" + hex_digit(b1 / 16) + hex_digit(b1 % 16)
        + "\\" + hex_digit(b2 / 16) + hex_digit(b2 % 16)
        + "\\" + hex_digit(b3 / 16) + hex_digit(b3 % 16);
}

// enum_box builds an Option/Result tag box `[tag:i32 @0][payload @4]` as a
// single (block (result i32)) expression, reusing the $__lit<depth> temp.
function enum_box(tag: i32, payload: string, depth: i32): string {
    return enum_box_retain(tag, payload, depth, false);
}

// enum_box_retain is enum_box with a Perceus construction-store inc:
// when `retain` is true the payload is an existing array reference, so
// the box co-owns the buffer and retains it (the payload string is a
// bare `(local.get …)`, safe to duplicate). Free is OFF, so this only
// bumps the rc; it readies Option/Result payload arrays for free-on.
function enum_box_retain(tag: i32, payload: string, depth: i32, retain: boolean): string {
    var ap: string = "$__lit" + util.i32_to_string(depth);
    var s: string = "(block (result i32)";
    // Perceus Option/Result rc-box layout: the variant box ([tag@0][payload@4])
    // is rc-headered via the generic $__fern_str_box (8-byte rc+bsz header,
    // returns base+8), so it carries an rc word at [p-8] while tag@[p] and
    // payload@[p+4] (every p-relative access) are unchanged. Counting + the
    // payload recursive release ride on this foundation in later slices.
    s = s + " (local.set " + ap + " (call $__fern_str_box (i32.const 8)))";
    s = s + " (i32.store (local.get " + ap + ") (i32.const " + util.i32_to_string(tag) + "))";
    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const 4)) " + payload + ")";
    if (retain) {
        s = s + " (drop (call $__fern_rc_inc " + payload + "))";
    }
    s = s + " (local.get " + ap + "))";
    return s;
}

// variant_tag maps an Option/Result variant name to its box tag (Some/Ok
// = 0, None/Err = 1), or -1 for a name that isn't a known variant.
function variant_tag(name: string): i32 {
    if (name == "Some" || name == "Ok") { return 0; }
    if (name == "None" || name == "Err") { return 1; }
    return 0 - 1;
}

// wasm_binop maps a Fern operator to its i32 wasm instruction.
function wasm_binop(op: string): string {
    if (op == "+") { return "i32.add"; }
    if (op == "-") { return "i32.sub"; }
    if (op == "*") { return "i32.mul"; }
    // Non-trapping div/rem: lower to the guarded helper calls. The
    // folded form `(call $name <left> <right>)` shares emit_expr's
    // `(<op> <left> <right>)` shape, so no special-casing is needed
    // there.
    if (op == "/") { return "call $__fern_idiv"; }
    if (op == "%") { return "call $__fern_irem"; }
    if (op == "<") { return "i32.lt_s"; }
    if (op == "<=") { return "i32.le_s"; }
    if (op == ">") { return "i32.gt_s"; }
    if (op == ">=") { return "i32.ge_s"; }
    if (op == "==") { return "i32.eq"; }
    if (op == "!=") { return "i32.ne"; }
    if (op == "&&") { return "i32.and"; }
    if (op == "||") { return "i32.or"; }
    // Bitwise operators.
    if (op == "&") { return "i32.and"; }
    if (op == "|") { return "i32.or"; }
    if (op == "^") { return "i32.xor"; }
    if (op == "<<") { return "i32.shl"; }
    if (op == ">>") { return "i32.shr_s"; }
    return "i32.add";
}

// emit_array_literal_kind builds an array block `[len:i32 @0][cap:i32 @4]
// [elems @8]` in a `(block (result i32) …)`. `kind` ("i32"/"i64"/"f64")
// fixes the element slot size (4 or 8) and the per-element store op +
// value-emit, so an `i64[]` / `f64[]` literal whose width comes from its
// declaration (a bare-integer literal carries none) is stored correctly.
// A depth-indexed temp ($__lit<depth>) holds the fresh pointer; nested
// literals emit at depth+1 to avoid clobbering it.
function emit_array_literal_kind(a: parser.ExprArray, kind: string, cx: Ctx, depth: i32): string {
    var ap: string = "$__lit" + util.i32_to_string(depth);
    var n: i32 = a.elements.len();
    var slot: i32 = elem_slot_size(kind);
    var sop: string = elem_store_op(kind);
    var s: string = "(block (result i32)";
    s = s + " (local.set " + ap + " (call $__fern_arr_box (i32.const " + util.i32_to_string(n * slot) + ")))";
    s = s + " (i32.store (local.get " + ap + ") (i32.const " + util.i32_to_string(n) + "))";
    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const 4)) (i32.const " + util.i32_to_string(n) + "))";
    var i: i32 = 0;
    while (i < n) {
        var ev: string = "";
        if (kind == "i64") { ev = emit_i64(a.elements[i], cx, depth + 1); }
        else if (kind == "f64") { ev = emit_f64(a.elements[i], cx, depth + 1); }
        else { ev = emit_expr(a.elements[i], cx, depth + 1); }
        s = s + " (" + sop + " (i32.add (local.get " + ap + ") (i32.const " + util.i32_to_string(8 + i * slot) + ")) " + ev + ")";
        // Perceus construction-store inc: an array-of-arrays element that
        // is an existing array reference is retained (the outer array now
        // co-owns it alongside the source local). Only the i32-slot path
        // can hold a pointer element (i64/f64 elements are scalars).
        if (kind == "i32" && store_value_is_borrowed(a.elements[i], cx)) {
            s = s + " (drop (call $__fern_rc_inc " + emit_expr(a.elements[i], cx, depth + 1) + "))";
        }
        i = i + 1;
    }
    s = s + " (local.get " + ap + "))";
    return s;
}

// emit_expr lowers an expression to a folded WAT instruction tree. A
// string value is a pointer (i32) to its `[len:i32][bytes]` block; a
// string literal's value is the constant block offset interned in tab.
function emit_expr(e: parser.Expr, cx: Ctx, depth: i32): string {
    // i64- / f64-typed expressions lower through their dedicated
    // instruction paths; everything else stays in the uniform i32 model.
    if (is_i64_expr(e, cx)) {
        return emit_i64(e, cx, depth);
    }
    if (is_f64_expr(e, cx)) {
        return emit_f64(e, cx, depth);
    }
    match (e) {
        parser.ExprNumber(n) => {
            return "(i32.const " + n.text + ")";
        },
        parser.ExprBool(b) => {
            if (b.value) { return "(i32.const 1)"; }
            return "(i32.const 0)";
        },
        parser.ExprString(se) => {
            return "(i32.const " + util.i32_to_string(cx.tab.offset_of(se.value)) + ")";
        },
        parser.ExprIdent(id) => {
            // None is the no-payload Option variant (tag 1).
            if (id.name == "None") { return enum_box(1, "(i32.const 0)", depth); }
            // A captured name (inside a lambda body) loads from the closure
            // env box at offset 4 + captureIndex*4.
            var capi: i32 = util.index_of_str(cx.cap_names, id.name);
            if (capi >= 0) {
                return "(i32.load (i32.add (local.get $__env) (i32.const " + util.i32_to_string(4 + capi * 4) + ")))";
            }
            // A bare reference to a zero-arg free function — a `const`
            // desugar — lowers to a call (unless shadowed by a local).
            if (is_const_ref(cx, id.name)) {
                return "(call $" + id.name + ")";
            }
            // A bare reference to a 0-field declared struct is a unit enum
            // variant (`Nil`, `Empty`): construct its [struct_id@0] tag box,
            // so `match` reads the right tag at offset 0.
            if (is_struct_type(cx.structs, id.name) && struct_field_count(cx.structs, id.name) == 0) {
                var uap: string = "$__lit" + util.i32_to_string(depth);
                return "(block (result i32) (local.set " + uap + " (call $__fern_str_box (i32.const 4))) (i32.store (local.get " + uap + ") (i32.const " + util.i32_to_string(struct_id(cx.structs, id.name)) + ")) (local.get " + uap + "))";
            }
            return "(local.get $" + id.name + ")";
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                return "(i32.sub (i32.const 0) " + emit_expr(u.operand, cx, depth) + ")";
            }
            if (u.op == "!") {
                return "(i32.eqz " + emit_expr(u.operand, cx, depth) + ")";
            }
            if (u.op == "try_") {
                // `x?` — unwrap a Some/Ok payload, or early-return the
                // None/Err box from the enclosing function. The box is
                // parked in $__lit<depth>; tag != 0 means None/Err.
                var ap: string = "$__lit" + util.i32_to_string(depth);
                var s: string = "(block (result i32)";
                s = s + " (local.set " + ap + " " + emit_expr(u.operand, cx, depth + 1) + ")";
                s = s + " (if (i32.ne (i32.load (local.get " + ap + ")) (i32.const 0)) (then (return (local.get " + ap + "))))";
                s = s + " (i32.load (i32.add (local.get " + ap + ") (i32.const 4))))";
                return s;
            }
            if (is_cast_op(u.op)) {
                // `x as <ty>` to an i32-width target (f64 / i64 / f32 /
                // u64 targets are intercepted by the emit_expr-top
                // dispatch). Source: f64 → truncate, i64 → wrap, else the
                // i32 value itself; then mask for the sub-word
                // target (u8).
                var ty: string = cast_target(u.op);
                var inner: string = "";
                if (is_f64_expr(u.operand, cx)) {
                    inner = "(i32.trunc_f64_s " + emit_f64(u.operand, cx, depth) + ")";
                } else if (is_i64_expr(u.operand, cx)) {
                    inner = "(i32.wrap_i64 " + emit_i64(u.operand, cx, depth) + ")";
                } else {
                    inner = emit_expr(u.operand, cx, depth);
                }
                if (ty == "u8") { return "(i32.and " + inner + " (i32.const 255))"; }
                return inner;
            }
            return emit_expr(u.operand, cx, depth);
        },
        parser.ExprBinary(b) => {
            // String-typed operands route `+` and the comparisons to the
            // string runtime; integer operands use the i32 ops.
            if (is_string_expr(b.left, cx) || is_string_expr(b.right, cx)) {
                var l: string = emit_expr(b.left, cx, depth);
                var r: string = emit_expr(b.right, cx, depth);
                if (b.op == "+") {
                    return "(call $__fern_strcat " + l + " " + r + ")";
                }
                if (b.op == "==") {
                    return "(call $__fern_streq " + l + " " + r + ")";
                }
                if (b.op == "!=") {
                    return "(i32.eqz (call $__fern_streq " + l + " " + r + "))";
                }
                if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                    return "(" + wasm_binop(b.op) + " (call $__fern_strcmp " + l + " " + r + ") (i32.const 0))";
                }
            }
            // An i64-typed arithmetic op is handled by the emit_expr-top
            // dispatch; reaching here with an i64 operand means a
            // comparison (i32 bool result) over i64 values — coerce both
            // sides to i64 and use the i64 comparison instruction.
            if (is_i64_expr(b.left, cx) || is_i64_expr(b.right, cx)) {
                return "(" + wasm_binop_i64(b.op) + " " + emit_i64(b.left, cx, depth) + " " + emit_i64(b.right, cx, depth) + ")";
            }
            // Likewise an f64 comparison (f64 arithmetic is intercepted
            // above) — coerce both sides to f64 and use the f64 compare.
            if (is_f64_expr(b.left, cx) || is_f64_expr(b.right, cx)) {
                return "(" + wasm_binop_f64(b.op) + " " + emit_f64(b.left, cx, depth) + " " + emit_f64(b.right, cx, depth) + ")";
            }
            // Logical && / || short-circuit: the right operand is only
            // evaluated when needed, so side effects / guard patterns (e.g.
            // `p != 0 && load(p)`) behave correctly.
            if (b.op == "&&") {
                return "(if (result i32) " + emit_expr(b.left, cx, depth) + " (then " + emit_expr(b.right, cx, depth) + ") (else (i32.const 0)))";
            }
            if (b.op == "||") {
                return "(if (result i32) " + emit_expr(b.left, cx, depth) + " (then (i32.const 1)) (else " + emit_expr(b.right, cx, depth) + "))";
            }
            return "(" + wasm_binop(b.op) + " " + emit_expr(b.left, cx, depth) + " " + emit_expr(b.right, cx, depth) + ")";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprLambda(_) => {
                    // Inline-lambda call (IIFE), e.g. an if-expression
                    // desugar `(function(): T { … })()`. The lambda value
                    // is a box ptr; call_indirect needs it twice (as the
                    // $__env arg and to load the table index box[0]), so
                    // local.tee it into this expression's depth-owned
                    // scratch ($__lit<depth>) — args evaluate at depth+1
                    // and can't clobber it.
                    var sc: string = "$__lit" + util.i32_to_string(depth);
                    var boxe: string = emit_expr(c.callee, cx, depth + 1);
                    var ci: string = "(call_indirect (type $clos" + util.i32_to_string(c.args.len()) + ") (local.tee " + sc + " " + boxe + ")";
                    var k: i32 = 0;
                    while (k < c.args.len()) {
                        ci = ci + " " + emit_expr(c.args[k], cx, depth + 1);
                        k = k + 1;
                    }
                    ci = ci + " (i32.load (local.get " + sc + ")))";
                    return ci;
                },
                parser.ExprIdent(id) => {
                    // Option/Result constructors → tag boxes [tag@0][payload@4]:
                    // Some/Ok = tag 0, Err = tag 1 (None is the bare-ident case).
                    if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
                        return enum_box_retain(0, emit_expr(c.args[0], cx, depth + 1), depth, store_value_is_borrowed(c.args[0], cx));
                    }
                    if (id.name == "Err" && c.args.len() == 1) {
                        return enum_box_retain(1, emit_expr(c.args[0], cx, depth + 1), depth, store_value_is_borrowed(c.args[0], cx));
                    }
                    // env(name): Option[string] builtin → the wasi
                    // environ runtime helper.
                    if (id.name == "env" && c.args.len() == 1) {
                        return "(call $__fern_env " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // random_bytes(n): u8[] (i32[] of byte values).
                    if (id.name == "random_bytes" && c.args.len() == 1) {
                        return "(call $__fern_random_bytes " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // string_from_bytes(bytes): pack a u8[] (i32[] of byte
                    // values) into a fresh [len][bytes] string block.
                    if (id.name == "string_from_bytes" && c.args.len() == 1) {
                        return "(call $__fern_string_from_bytes " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // random_i32(): a single i32 of randomness.
                    if (id.name == "random_i32" && c.args.len() == 0) {
                        return "(call $__fern_random_i32)";
                    }
                    // args(): string[] — the wasi argv vector.
                    if (id.name == "args" && c.args.len() == 0) {
                        return "(call $__fern_args)";
                    }
                    // read_file(path): Result[string, IoError] via wasi.
                    if (id.name == "read_file" && c.args.len() == 1) {
                        return "(call $__fern_read_file " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // write_file(path, content): Option[IoError] via wasi.
                    if (id.name == "write_file" && c.args.len() == 2) {
                        return "(call $__fern_write_file " + emit_expr(c.args[0], cx, depth + 1) + " " + emit_expr(c.args[1], cx, depth + 1) + ")";
                    }
                    // map_new_i32(n) / map_new(n): fresh i32- / string-keyed
                    // map (the desugar of a `Map { … }` literal — integer
                    // keys pick map_new_i32, string keys map_new).
                    if (id.name == "map_new_i32" && c.args.len() == 1) {
                        return "(call $__fern_map_new " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    if (id.name == "map_new" && c.args.len() == 1) {
                        return "(call $__fern_map_new_str " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // cell_new(v) — a single-slot box (docs/CELL-TYPE-PLAN.md).
                    if (id.name == "cell_new" && c.args.len() == 1) {
                        return "(call $__fern_cell_new " + emit_expr(c.args[0], cx, depth + 1) + ")";
                    }
                    // Closure call: the callee is a local/param holding a
                    // closure box. Indirect-call through the function table
                    // — push the box as the $__env arg, then the args, then
                    // the table index (box[0]).
                    if (contains_str(cx.fn_names, id.name)) {
                        var ci: string = "(call_indirect (type $clos" + util.i32_to_string(c.args.len()) + ") (local.get $" + id.name + ")";
                        var k: i32 = 0;
                        while (k < c.args.len()) {
                            ci = ci + " " + emit_expr(c.args[k], cx, depth);
                            k = k + 1;
                        }
                        ci = ci + " (i32.load (local.get $" + id.name + ")))";
                        return ci;
                    }
                    // Positional variant constructor: `Circle(3)` where the
                    // callee names a declared struct (an enum variant carries
                    // its payload as field 0). Build the value
                    // [struct_id@0, arg0@4, arg1@8, …] — the same layout a
                    // struct literal produces, so `match` reads the tag at
                    // offset 0 and the payload at offset 4. (Plain user enums:
                    // only Option/Result were special-cased before.)
                    if (is_struct_type(cx.structs, id.name)) {
                        var vap: string = "$__lit" + util.i32_to_string(depth);
                        var vnf: i32 = struct_field_count(cx.structs, id.name);
                        // Box size: the tag word + each field by its slot width
                        // (a wide i64/f64 `__ev` payload takes 8 bytes, an
                        // i32-class field 4). All-i32 reproduces `4 + vnf*4`. S1.
                        var vbytes: i32 = 4;
                        var vk: i32 = 0;
                        while (vk < vnf) {
                            vbytes = vbytes + elem_slot_size(field_kind_of_type(struct_field_type_at(cx.structs, id.name, vk)));
                            vk = vk + 1;
                        }
                        var vs: string = "(block (result i32)";
                        vs = vs + " (local.set " + vap + " (call $__fern_str_box (i32.const " + util.i32_to_string(vbytes) + ")))";
                        vs = vs + " (i32.store (local.get " + vap + ") (i32.const " + util.i32_to_string(struct_id(cx.structs, id.name)) + "))";
                        var vi: i32 = 0;
                        while (vi < c.args.len()) {
                            // Store each payload at its field width: a wide
                            // i64/f64 field uses i64/f64.store of the i64/f64-
                            // emitted arg; i32 fields are unchanged. (struct_field_off
                            // is the 4-byte-stride offset — correct while a wide
                            // payload is the single `__ev` field; multi-field wide
                            // layout is S4.)
                            var fk: string = field_kind_of_type(struct_field_type_at(cx.structs, id.name, vi));
                            var fval: string = "";
                            if (fk == "i64") { fval = emit_i64(c.args[vi], cx, depth + 1); }
                            else if (fk == "f64") { fval = emit_f64(c.args[vi], cx, depth + 1); }
                            else { fval = emit_expr(c.args[vi], cx, depth + 1); }
                            vs = vs + " (" + elem_store_op(fk) + " (i32.add (local.get " + vap + ") (i32.const " + util.i32_to_string(struct_field_off(vi)) + ")) " + fval + ")";
                            // Perceus construction-store inc: a user enum
                            // variant payload that is an existing array
                            // reference is retained (the variant co-owns it).
                            if (store_value_is_borrowed(c.args[vi], cx)) {
                                vs = vs + " (drop (call $__fern_rc_inc " + emit_expr(c.args[vi], cx, depth + 1) + "))";
                            }
                            vi = vi + 1;
                        }
                        return vs + " (local.get " + vap + "))";
                    }
                    // Direct call to a free function: `f(a, b)` →
                    // `(call $f <a> <b>)`. Args bound to an i64 param are
                    // coerced to i64 (so a bare literal becomes i64.const).
                    var s: string = "(call $" + id.name;
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        if (func_param_is_i64(cx, id.name, i)) {
                            s = s + " " + emit_i64(c.args[i], cx, depth + 1);
                        } else {
                            s = s + " " + emit_expr(c.args[i], cx, depth);
                        }
                        i = i + 1;
                    }
                    return s + ")";
                },
                parser.ExprFieldAccess(fa) => {
                    // `.to_string()` — f-string interpolants desugar to it.
                    // A string is itself; an i64 / i32 receiver formats via
                    // the integer→string runtime.
                    if (fa.field == "to_string" && c.args.len() == 0) {
                        if (is_string_expr(fa.obj, cx)) { return emit_expr(fa.obj, cx, depth); }
                        if (is_i64_expr(fa.obj, cx)) { return "(call $__fern_i64_to_str " + emit_i64(fa.obj, cx, depth + 1) + ")"; }
                        // Only format as an integer when the receiver isn't a
                        // struct / enum with its own `to_string` (hand-written
                        // or `@derive(Display)`). Such a receiver must dispatch
                        // to that method — fall through to the user-method
                        // dispatch below instead of treating the pointer as an
                        // i32.
                        var tsrt: string = struct_type_of(fa.obj, cx);
                        if (tsrt.len() == 0 || !has_method(cx, tsrt, "to_string")) {
                            return "(call $__fern_i32_to_str " + emit_expr(fa.obj, cx, depth) + ")";
                        }
                    }
                    // `.len()` reads the length word at offset 0 — shared
                    // by string blocks ([len][bytes]) and array blocks
                    // ([len][cap][elems]), so it needs no string/array
                    // discrimination.
                    if (fa.field == "len" && c.args.len() == 0) {
                        return "(i32.load " + emit_expr(fa.obj, cx, depth) + ")";
                    }
                    // `.append(v)` is array-only (strings have no push), so it
                    // needs no type gate. Returns the (possibly grown) array.
                    // i64[]/f64[] use 8-byte-slot push helpers taking a wide
                    // value.
                    if (fa.field == "append" && c.args.len() == 1) {
                        var pk: string = array_elem_kind(fa.obj, cx);
                        if (pk == "i64") {
                            return "(call $__fern_arr_push_i64 " + emit_expr(fa.obj, cx, depth) + " " + emit_i64(c.args[0], cx, depth) + ")";
                        }
                        if (pk == "f64") {
                            return "(call $__fern_arr_push_f64 " + emit_expr(fa.obj, cx, depth) + " " + emit_f64(c.args[0], cx, depth) + ")";
                        }
                        // Perceus construction-store retain: appending a
                        // BORROWED rc-tracked value (an alias, or a struct
                        // field / struct-array index read like
                        // `children.append(r.node)`) retains it so the array
                        // co-owns it — else releasing the source frees it out
                        // from under the array (the recursive-parser UAF). A
                        // fresh value (literal / call / concat) is sole-owned,
                        // no inc.
                        var pushval: string = emit_expr(c.args[0], cx, depth);
                        if (store_value_is_borrowed(c.args[0], cx)) {
                            pushval = "(call $__fern_rc_inc " + pushval + ")";
                        }
                        return "(call $__fern_arr_push " + emit_expr(fa.obj, cx, depth) + " " + pushval + ")";
                    }
                    // `.with(i, v)` — value-returning element set (replacing
                    // `arr[i] = v`). i64[]/f64[] use the 8-byte-slot variants.
                    // Cell[T] (docs/CELL-TYPE-PLAN.md): get() loads slot 0;
                    // set(v) stores it in place. set returns the cell pointer
                    // (a value) so a bare `c.set(v);` statement drops cleanly.
                    // v1 holds scalars in an i32 slot.
                    if (is_cell_expr(fa.obj, cx) && fa.field == "get" && c.args.len() == 0) {
                        return "(i32.load " + emit_expr(fa.obj, cx, depth) + ")";
                    }
                    if (is_cell_expr(fa.obj, cx) && fa.field == "set" && c.args.len() == 1) {
                        return "(call $__fern_cell_set " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + ")";
                    }
                    if (fa.field == "with" && c.args.len() == 2) {
                        var wk: string = array_elem_kind(fa.obj, cx);
                        if (wk == "i64") {
                            return "(call $__fern_arr_with_i64 " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + " " + emit_i64(c.args[1], cx, depth) + ")";
                        }
                        if (wk == "f64") {
                            return "(call $__fern_arr_with_f64 " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + " " + emit_f64(c.args[1], cx, depth) + ")";
                        }
                        return "(call $__fern_arr_with " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + " " + emit_expr(c.args[1], cx, depth) + ")";
                    }
                    // `.join(sep)` is the array→string method (string[]
                    // receiver); no string-receiver gate.
                    if (fa.field == "join" && c.args.len() == 1) {
                        return "(call $__fern_str_join " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + ")";
                    }
                    // `.split(sep)` is the string→string[] method.
                    if (fa.field == "split" && c.args.len() == 1 && is_string_expr(fa.obj, cx)) {
                        return "(call $__fern_str_split " + emit_expr(fa.obj, cx, depth) + " " + emit_expr(c.args[0], cx, depth) + ")";
                    }
                    // i32-keyed map methods. `.len()` is already handled by
                    // the generic length read (count sits at box offset 0).
                    if (is_map_expr(fa.obj, cx)) {
                        var mrecv: string = emit_expr(fa.obj, cx, depth);
                        if ((fa.field == "insert") && c.args.len() == 2) {
                            // vis (value-is-rc-pointer) is determined statically
                            // from the value expr's type so $__fern_map_set can
                            // construction-inc an rc-tracked value on insert and
                            // $__fern_map_release can release it on the map's
                            // death (mirrors kis for keys + native
                            // __drop_map_str_values). A map's value type is
                            // homogeneous, so the per-insert flag is stable.
                            // A string / struct/enum / array value is rc-boxed,
                            // so a generic rc_inc / arr_dec one-level-reclaims it;
                            // the struct/enum FIELD deep-release rides on the
                            // per-type $__fern_map_release_via_<T> routing (an
                            // array value reclaims its buffer — complete for a
                            // scalar-element array; ptr-element arrays leak their
                            // elements one level, sound).
                            var visf: string = "(i32.const 0)";
                            if (is_string_expr(c.args[1], cx) || struct_type_of(c.args[1], cx).len() > 0 || insert_val_is_array(c.args[1], cx)) { visf = "(i32.const 1)"; }
                            // vconsume / kconsume are the IR-path's fresh key/value
                            // reclaim (#4353 wasm bug 2); the legacy AST path keeps the
                            // retain-only model (both 0, a fresh key/value leaks by one
                            // as before) — it is being retired in favour of the IR path,
                            // which computes the flags from is_fresh_str_temp.
                            return "(call $__fern_map_set " + mrecv + " " + emit_expr(c.args[0], cx, depth + 1) + " " + emit_expr(c.args[1], cx, depth + 1) + " " + visf + " (i32.const 0) (i32.const 0))";
                        }
                        if (fa.field == "get" && c.args.len() == 1) {
                            return "(call $__fern_map_get " + mrecv + " " + emit_expr(c.args[0], cx, depth + 1) + ")";
                        }
                        if (fa.field == "get_or" && c.args.len() == 2) {
                            return "(call $__fern_map_get_or " + mrecv + " " + emit_expr(c.args[0], cx, depth + 1) + " " + emit_expr(c.args[1], cx, depth + 1) + ")";
                        }
                        if (fa.field == "has" && c.args.len() == 1) {
                            return "(call $__fern_map_has " + mrecv + " " + emit_expr(c.args[0], cx, depth + 1) + ")";
                        }
                        if ((fa.field == "without") && c.args.len() == 1) {
                            return "(call $__fern_map_delete " + mrecv + " " + emit_expr(c.args[0], cx, depth + 1) + ")";
                        }
                        if (fa.field == "keys" && c.args.len() == 0) {
                            return "(call $__fern_map_keys " + mrecv + ")";
                        }
                        if (fa.field == "values" && c.args.len() == 0) {
                            return "(call $__fern_map_values " + mrecv + ")";
                        }
                    }
                    // The remaining string methods are string-only.
                    if (is_string_expr(fa.obj, cx)) {
                        var recv: string = emit_expr(fa.obj, cx, depth);
                        if (fa.field == "starts_with" && c.args.len() == 1) {
                            return "(call $__fern_str_startswith " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                        if (fa.field == "ends_with" && c.args.len() == 1) {
                            return "(call $__fern_str_endswith " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                        if (fa.field == "index_of" && c.args.len() == 1) {
                            return "(call $__fern_str_indexof " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                        if (fa.field == "contains" && c.args.len() == 1) {
                            return "(i32.ge_s (call $__fern_str_indexof " + recv + " " + emit_expr(c.args[0], cx, depth) + ") (i32.const 0))";
                        }
                        if (fa.field == "to_upper" && c.args.len() == 0) {
                            return "(call $__fern_str_upper " + recv + ")";
                        }
                        if (fa.field == "to_lower" && c.args.len() == 0) {
                            return "(call $__fern_str_lower " + recv + ")";
                        }
                        if (fa.field == "repeat" && c.args.len() == 1) {
                            return "(call $__fern_str_repeat " + recv + " " + emit_expr(c.args[0], cx, depth) + ")";
                        }
                    }
                    // User receiver method: `obj.m(args)` → static dispatch
                    // to `$<RecvType>__m`, passing the receiver first.
                    var rt: string = struct_type_of(fa.obj, cx);
                    if (rt.len() > 0 && has_method(cx, rt, fa.field)) {
                        var s: string = "(call $" + rt + "__" + fa.field + " " + emit_expr(fa.obj, cx, depth);
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            s = s + " " + emit_expr(c.args[ai], cx, depth);
                            ai = ai + 1;
                        }
                        return s + ")";
                    }
                    // Primitive-receiver user method: the receiver isn't a
                    // struct/enum, so it's a primitive — pick its type and
                    // dispatch to `$<prim>__method` when a user impl exists
                    // (e.g. `impl Eq for i32`, which a derived struct/enum's
                    // `self.x.eq(other.x)` field/payload compare needs).
                    if (rt.len() == 0) {
                        var prt: string = "i32";
                        if (is_string_expr(fa.obj, cx)) { prt = "string"; }
                        else if (is_i64_expr(fa.obj, cx)) { prt = "i64"; }
                        if (has_method(cx, prt, fa.field)) {
                            var ps: string = "(call $" + prt + "__" + fa.field + " " + emit_expr(fa.obj, cx, depth);
                            var pai: i32 = 0;
                            while (pai < c.args.len()) {
                                ps = ps + " " + emit_expr(c.args[pai], cx, depth);
                                pai = pai + 1;
                            }
                            return ps + ")";
                        }
                        // `dyn Trait` receiver: the concrete type isn't known
                        // statically, so dispatch on the runtime struct id.
                        var dynd: string = emit_dyn_dispatch(fa.obj, fa.field, c.args, cx, depth);
                        if (dynd.len() > 0) { return dynd; }
                    }
                    // Array auto-discovered method (mirror of the asm backends):
                    // `a.<field>(args)` whose `__method_Array_<field>` helper is
                    // in scope desugars to `__method_Array_<field>(a, args)`. The
                    // intercepted methods (len / join / append / …) returned
                    // above; the checker has proven the receiver is an array, so
                    // helper-existence is a sufficient gate. Bare on the
                    // single-file path, `<mod>__`-mangled by the bundler.
                    var amf: string = wasm_find_array_method(fa.field, cx.mod_funcs);
                    if (amf.len() > 0) {
                        var am: string = "(call $" + amf + " " + emit_expr(fa.obj, cx, depth);
                        var amai: i32 = 0;
                        while (amai < c.args.len()) {
                            am = am + " " + emit_expr(c.args[amai], cx, depth);
                            amai = amai + 1;
                        }
                        return am + ")";
                    }
                    return "(i32.const 0)";
                },
                _ => { return "(i32.const 0)"; },
            }
        },
        parser.ExprArray(a) => {
            // Element kind from the literal itself (i64/f64 only when the
            // elements are typed wide; a bare-integer-literal i64[] gets its
            // kind from its declaration via emit_array_literal_kind).
            return emit_array_literal_kind(a, array_elem_kind(e, cx), cx, depth);
        },
        parser.ExprLambda(lm) => {
            // A lambda value is a 1-slot closure box [table_idx]. The body
            // is emitted as $__lambda<idx> (appended to the shared lamdefs
            // cell) and registered in the function table at `idx`. Calling
            // the value goes through call_indirect (see the ExprCall path).
            // Non-capturing: the $__env param is ignored.
            var caps: string[] = lambda_captures(lm, cx);
            var idx: i32 = cx.lam_ctr.get();
            cx.lam_ctr.set(idx + 1);
            // Emit the body FIRST (it may append nested lambdas to the
            // shared cell), THEN append this lambda's text — reading
            // cx.lamdefs.get() only after, so nested defs aren't clobbered.
            var lamtext: string = emit_lambda(lm, idx, cx, caps);
            cx.lamdefs.set(cx.lamdefs.get() + lamtext);
            var ap: string = "$__lit" + util.i32_to_string(depth);
            var s: string = "(block (result i32)";
            // rc-box the env via $__fern_str_box (8-byte rc+bsz header, returns
            // base+8) so the closure carries an rc word at [box-8] and can be
            // counted + freed; table_idx@0 + captures@4+i*4 are unchanged
            // (str_box just adds a header below the returned pointer).
            s = s + " (local.set " + ap + " (call $__fern_str_box (i32.const " + util.i32_to_string(4 + caps.len() * 4) + ")))";
            s = s + " (i32.store (local.get " + ap + ") (i32.const " + util.i32_to_string(idx) + "))";
            // Capture values: evaluated in the enclosing scope, stored at
            // box + 4 + i*4 (matching the lambda body's $__env loads).
            var ic: i32 = 0;
            while (ic < caps.len()) {
                s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + util.i32_to_string(4 + ic * 4) + ")) " + emit_expr(parser.ExprIdent { name: caps[ic], line: 0, col: 0 }, cx, depth + 1) + ")";
                // Perceus capture construction-inc: an rc-tracked capture (string
                // / array / struct / enum) is co-owned by the env, so retain it;
                // the closure's death releases it (capture_kind classifies both
                // sides identically, so they balance). A guard no-op for an
                // immortal literal; scalars carry no rc and are skipped.
                if (capture_kind(caps[ic], cx).len() > 0) {
                    s = s + " (drop (call $__fern_rc_inc " + emit_expr(parser.ExprIdent { name: caps[ic], line: 0, col: 0 }, cx, depth + 1) + "))";
                }
                ic = ic + 1;
            }
            s = s + " (local.get " + ap + "))";
            return s;
        },
        parser.ExprTuple(t) => {
            // Tuple block: N consecutive i32 slots, element i at offset
            // i*4 (`t.N` knows the offset statically). rc-boxed via the
            // generic $__fern_str_box (8-byte rc+bsz header, returns
            // base+8), so the tuple carries an rc word at [t-8] while every
            // t-relative element access is unchanged — the Phase-1e
            // container layout foundation. Built in a (block (result i32) …)
            // with a depth-indexed temp.
            var ap: string = "$__lit" + util.i32_to_string(depth);
            var n: i32 = t.elements.len();
            var bytes: i32 = n * 4;
            if (bytes == 0) { bytes = 4; }
            var s: string = "(block (result i32)";
            s = s + " (local.set " + ap + " (call $__fern_str_box (i32.const " + util.i32_to_string(bytes) + ")))";
            var i: i32 = 0;
            while (i < n) {
                s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + util.i32_to_string(i * 4) + ")) " + emit_expr(t.elements[i], cx, depth + 1) + ")";
                // Perceus construction-store inc: a tuple element that is an
                // existing array reference is retained (the tuple co-owns it).
                if (store_value_is_borrowed(t.elements[i], cx)) {
                    s = s + " (drop (call $__fern_rc_inc " + emit_expr(t.elements[i], cx, depth + 1) + "))";
                }
                i = i + 1;
            }
            s = s + " (local.get " + ap + "))";
            return s;
        },
        parser.ExprIndex(ix) => {
            // `s[i]` on a string is a byte load (block is [len][bytes@4],
            // 1 byte each); `arr[i]` on an array is the i32 element at
            // base + 8 + i*4.
            if (is_string_expr(ix.array, cx)) {
                return "(i32.load8_u (i32.add (i32.add " + emit_expr(ix.array, cx, depth) + " (i32.const 4)) " + emit_expr(ix.index, cx, depth) + "))";
            }
            return "(i32.load (i32.add (i32.add " + emit_expr(ix.array, cx, depth) + " (i32.const 8)) (i32.mul " + emit_expr(ix.index, cx, depth) + " (i32.const 4))))";
        },
        parser.ExprSlice(sl) => {
            // `x[a:b]` — a string slice reuses $__fern_substr (a fresh
            // [len][bytes] block); an array slice copies the element range
            // into a fresh [len][cap][elems] block via $__fern_arr_slice.
            // Both repr element/byte copies, so i32[] and string[] share
            // the array path.
            if (is_string_expr(sl.array, cx)) {
                return "(call $__fern_substr " + emit_expr(sl.array, cx, depth) + " " + emit_expr(sl.start, cx, depth) + " " + emit_expr(sl.end, cx, depth) + ")";
            }
            // i64[]/f64[] slice copies 8-byte elements (the byte-move helper
            // is element-type-agnostic, so one wide variant serves both).
            if (array_elem_kind(sl.array, cx) != "i32") {
                return "(call $__fern_arr_slice8 " + emit_expr(sl.array, cx, depth) + " " + emit_expr(sl.start, cx, depth) + " " + emit_expr(sl.end, cx, depth) + ")";
            }
            return "(call $__fern_arr_slice " + emit_expr(sl.array, cx, depth) + " " + emit_expr(sl.start, cx, depth) + " " + emit_expr(sl.end, cx, depth) + ")";
        },
        parser.ExprStructLit(sl) => {
            // Struct block: type id at slot 0, then one 4-byte slot per
            // declared field. Built in a (block (result i32) …) with a
            // depth-indexed temp, like array literals. With a base
            // (`S { ...base, f: v }`), copy every field from base first,
            // then store the listed overrides.
            var ap: string = "$__lit" + util.i32_to_string(depth);
            var nf: i32 = struct_field_count(cx.structs, sl.type_name);
            var s: string = "(block (result i32)";
            // Perceus struct rc-box layout: a struct block is rc-headered via
            // the generic $__fern_str_box (8-byte rc+bsz header, returns
            // base+8), so it carries an rc word at [s-8] while every
            // s-relative field access (type id at slot 0, fields at
            // struct_field_off) is unchanged. The payload size handed to
            // str_box is the raw block size (tag word + one slot per field);
            // counting + recursive field-release ride on this foundation.
            s = s + " (local.set " + ap + " (call $__fern_str_box (i32.const " + util.i32_to_string(4 + nf * 4) + ")))";
            s = s + " (i32.store (local.get " + ap + ") (i32.const " + util.i32_to_string(struct_id(cx.structs, sl.type_name)) + "))";
            if (sl.has_base) {
                var bp: string = emit_expr(sl.base, cx, depth + 1);
                var fi: i32 = 0;
                while (fi < nf) {
                    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + util.i32_to_string(struct_field_off(fi)) + ")) (i32.load (i32.add " + bp + " (i32.const " + util.i32_to_string(struct_field_off(fi)) + "))))";
                    // Perceus construction-store inc: copying a base struct's
                    // array field into the new struct creates a second owner,
                    // so retain it — UNLESS this field is overridden below (its
                    // copy is about to be replaced, so retaining would leak).
                    var overridden: boolean = false;
                    var ok: i32 = 0;
                    while (ok < sl.field_names.len()) {
                        if (struct_field_index(cx.structs, sl.type_name, sl.field_names[ok]) == fi) { overridden = true; }
                        ok = ok + 1;
                    }
                    if (!overridden && struct_field_kind_char(struct_field_type_at(cx.structs, sl.type_name, fi), cx) != "i") {
                        s = s + " (drop (call $__fern_rc_inc (i32.load (i32.add " + bp + " (i32.const " + util.i32_to_string(struct_field_off(fi)) + ")))))";
                    }
                    fi = fi + 1;
                }
            }
            var i: i32 = 0;
            while (i < sl.field_names.len()) {
                var idx: i32 = struct_field_index(cx.structs, sl.type_name, sl.field_names[i]);
                if (idx >= 0) {
                    s = s + " (i32.store (i32.add (local.get " + ap + ") (i32.const " + util.i32_to_string(struct_field_off(idx)) + ")) " + emit_expr(sl.field_values[i], cx, depth + 1) + ")";
                    // Perceus construction-store inc: storing an existing
                    // array reference into a struct field retains the buffer
                    // (the struct now co-owns it alongside the source local).
                    if (store_value_is_borrowed(sl.field_values[i], cx)) {
                        s = s + " (drop (call $__fern_rc_inc " + emit_expr(sl.field_values[i], cx, depth + 1) + "))";
                    }
                }
                i = i + 1;
            }
            s = s + " (local.get " + ap + "))";
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Tuple index `t.N` (numeric field) → load at base + N*4.
            if (util.is_all_digits(fa.field)) {
                return "(i32.load (i32.add " + emit_expr(fa.obj, cx, depth) + " (i32.const " + util.i32_to_string(util.digits_to_i32(fa.field) * 4) + ")))";
            }
            var ot: string = struct_type_of(fa.obj, cx);
            // Enum constant `Color.Green`: the receiver isn't a struct
            // value, but the field names a (zero-field variant) struct —
            // emit a variant box `[type_id]`, like `Green {}`, so the
            // existing struct-union `match` dispatch works.
            if (ot.len() == 0 && is_struct_type(cx.structs, fa.field)) {
                var vp: string = "$__lit" + util.i32_to_string(depth);
                return "(block (result i32) (local.set " + vp + " (call $__fern_str_box (i32.const " + util.i32_to_string(4 + struct_field_count(cx.structs, fa.field) * 4) + "))) (i32.store (local.get " + vp + ") (i32.const " + util.i32_to_string(struct_id(cx.structs, fa.field)) + ")) (local.get " + vp + "))";
            }
            // Bare field read s.f → load at base + 4 + index*4 (slot 0 is
            // the type id).
            var idx: i32 = struct_field_index(cx.structs, ot, fa.field);
            if (idx < 0) { return "(i32.const 0)"; }
            return "(i32.load (i32.add " + emit_expr(fa.obj, cx, depth) + " (i32.const " + util.i32_to_string(struct_field_off(idx)) + ")))";
        },
        _ => {
            return "(i32.const 0)";
        },
    }
    return "(i32.const 0)";
}

// is_reserved_local is true for the emitter's internal temp locals, so a
// user var of the same name doesn't get a duplicate (local …) decl.
function is_reserved_local(n: string): boolean {
    if (n == "__lit0" || n == "__lit1" || n == "__lit2" || n == "__lit3") { return true; }
    if (n == "__lit4" || n == "__lit5" || n == "__lit6" || n == "__lit7") { return true; }
    if (n == "__fi0" || n == "__fi1" || n == "__fi2" || n == "__fi3") { return true; }
    if (n == "__fa0" || n == "__fa1" || n == "__fa2" || n == "__fa3") { return true; }
    if (n == "__m0" || n == "__m1" || n == "__m2" || n == "__m3") { return true; }
    if (n == "__retv_i32" || n == "__retv_i64" || n == "__retv_f64") { return true; }
    if (n == "__tai" || n == "__tan" || n == "__te") { return true; }
    return false;
}

// contains_str is a small membership helper for local-name dedup.
function contains_str(xs: string[], n: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}

// index_of_str returns the position of `n` in `xs`, or -1 if absent.
// index_of_str -> util.index_of_str (SH-020/SH-007).

// collect_locals gathers every `var`/`let` name declared anywhere in a
// statement list (recursing into if / while bodies), deduped — wasm
// requires all locals declared at the top of the function.
function collect_locals(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                // `var (a, b, …) = …` destructure: declare every name.
                if (comma_index(v.name) >= 0) {
                    var dnames: string[] = split_commas(v.name);
                    var di: i32 = 0;
                    while (di < dnames.len()) {
                        if (!contains_str(acc, dnames[di])) { acc = acc.append(dnames[di]); }
                        di = di + 1;
                    }
                } else if (!contains_str(acc, v.name)) {
                    acc = acc.append(v.name);
                }
            },
            parser.StmtIf(f) => {
                acc = collect_locals(f.then_body, acc);
                acc = collect_locals(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_locals(w.body, acc);
            },
            parser.StmtFor(f) => {
                // `for (k, v) in m` encodes both names as "k,v" — declare
                // each as its own local.
                if (comma_index(f.var_name) >= 0) {
                    var kn: string = before_comma(f.var_name);
                    var vn: string = after_comma(f.var_name);
                    if (!contains_str(acc, kn)) { acc = acc.append(kn); }
                    if (!contains_str(acc, vn)) { acc = acc.append(vn); }
                } else if (!contains_str(acc, f.var_name)) {
                    acc = acc.append(f.var_name);
                }
                acc = collect_locals(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if (pv.binding.len() > 0 && pv.binding != "_" && !contains_str(acc, pv.binding)) {
                                acc = acc.append(pv.binding);
                            }
                            // Multi-payload variant `V(a, b, …)`: the extra
                            // bindings are locals too (S4).
                            var ebk: i32 = 0;
                            while (ebk < pv.extra_bindings.len()) {
                                if (pv.extra_bindings[ebk].len() > 0 && pv.extra_bindings[ebk] != "_" && !contains_str(acc, pv.extra_bindings[ebk])) {
                                    acc = acc.append(pv.extra_bindings[ebk]);
                                }
                                ebk = ebk + 1;
                            }
                        },
                        _ => {},
                    }
                    acc = collect_locals(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// expr_uses_divrem is true when an expression contains a `/` or `%`
// anywhere — used to decide whether the guarded helpers need emitting.
function expr_uses_divrem(e: parser.Expr): boolean {
    match (e) {
        parser.ExprBinary(b) => {
            if (b.op == "/" || b.op == "%") { return true; }
            if (expr_uses_divrem(b.left)) { return true; }
            return expr_uses_divrem(b.right);
        },
        parser.ExprUnary(u) => {
            return expr_uses_divrem(u.operand);
        },
        parser.ExprCall(c) => {
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_uses_divrem(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_use_divrem(lm.body); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_uses_divrem(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                if (expr_uses_divrem(t.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprIndex(ix) => {
            if (expr_uses_divrem(ix.array)) { return true; }
            return expr_uses_divrem(ix.index);
        },
        parser.ExprSlice(sl) => {
            if (expr_uses_divrem(sl.array)) { return true; }
            if (expr_uses_divrem(sl.start)) { return true; }
            return expr_uses_divrem(sl.end);
        },
        parser.ExprStructLit(sx) => {
            var i: i32 = 0;
            while (i < sx.field_values.len()) {
                if (expr_uses_divrem(sx.field_values[i])) { return true; }
                i = i + 1;
            }
            if (sx.has_base) { return expr_uses_divrem(sx.base); }
            return false;
        },
        parser.ExprFieldAccess(fa) => { return expr_uses_divrem(fa.obj); },
        _ => { return false; },
    }
    return false;
}

// stmts_use_divrem recurses a statement list (and nested if/while
// bodies) for any `/` or `%`.
function stmts_use_divrem(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_uses_divrem(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_uses_divrem(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_uses_divrem(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_uses_divrem(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_uses_divrem(f.cond)) { return true; }
                if (stmts_use_divrem(f.then_body)) { return true; }
                if (stmts_use_divrem(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_uses_divrem(w.cond)) { return true; }
                if (stmts_use_divrem(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_uses_divrem(f.iter)) { return true; }
                if (stmts_use_divrem(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_uses_divrem(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_use_divrem(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// divrem_helpers returns the WAT for the guarded div/rem helpers. The
// divisor is sanitised to 1 whenever the real divisor would fault (== 0,
// or the signed INT_MIN / -1 overflow): `a / 1 = a = INT_MIN` gives the
// right overflow quotient and `a % 1 = 0` the right overflow remainder.
// A final `select` substitutes the divide-by-zero answer (0 for div, the
// dividend for rem). Mirrors internal/codegen/wasmbin/runtime.go.
pub function divrem_helpers(): string {
    var bad: string =
        "(i32.or (i32.eqz (local.get $b))"
        + " (i32.and (i32.eq (local.get $a) (i32.const -2147483648))"
        + " (i32.eq (local.get $b) (i32.const -1))))";
    var out: string = "";
    out = out + "  (func $__fern_idiv (param $a i32) (param $b i32) (result i32)\n";
    out = out + "    (local $safe i32)\n";
    out = out + "    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (i32.const 0) (i32.div_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n";
    out = out + "  (func $__fern_irem (param $a i32) (param $b i32) (result i32)\n";
    out = out + "    (local $safe i32)\n";
    out = out + "    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (local.get $a) (i32.rem_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n";
    return out;
}

// divrem64_helpers mirrors divrem_helpers for 64-bit operands: the
// guarded `$__fern_idiv64` / `$__fern_irem64` used by i64 `/` and `%`.
// Same sanitise-divisor-to-1 + select-substitute scheme, with the i64
// INT_MIN sentinel (-9223372036854775808).
pub function divrem64_helpers(): string {
    var bad: string =
        "(i32.or (i64.eqz (local.get $b))"
        + " (i32.and (i64.eq (local.get $a) (i64.const -9223372036854775808))"
        + " (i64.eq (local.get $b) (i64.const -1))))";
    var out: string = "";
    out = out + "  (func $__fern_idiv64 (param $a i64) (param $b i64) (result i64)\n";
    out = out + "    (local $safe i64)\n";
    out = out + "    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (i64.const 0) (i64.div_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n";
    out = out + "  (func $__fern_irem64 (param $a i64) (param $b i64) (result i64)\n";
    out = out + "    (local $safe i64)\n";
    out = out + "    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (local.get $a) (i64.rem_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n";
    return out;
}

// clock_imports returns the wasi clock_time_get import (must sit in the
// import section, before any func). `precision` and the timestamp are
// i64; the timestamp is written to a caller-supplied address.
function clock_imports(): string {
    return "  (import \"wasi_snapshot_preview1\" \"clock_time_get\" (func $clock_time_get (param i32 i64 i32) (result i32)))\n";
}

// clock_imports_p2 emits the preview2 clock imports actually used: wall-clock
// `now` (a datetime record {seconds: u64, nanoseconds: u32} written to a
// return area) backs now_ns / now_unix_ms; monotonic-clock `now` (a u64
// instant returned directly) backs monotonic_ns. Imported precisely so the
// core's import set matches the corresponding component framing.
function clock_imports_p2(has_wall: boolean, has_mono: boolean): string {
    var o: string = "";
    if (has_wall) {
        o = o + "  (import \"wasi:clocks/wall-clock@0.2.0\" \"now\" (func $wall_now (param i32)))\n";
    }
    if (has_mono) {
        o = o + "  (import \"wasi:clocks/monotonic-clock@0.2.0\" \"now\" (func $mono_now (result i64)))\n";
    }
    return o;
}

// clock_funcs emits the i64 clock builtins. clock_time_get(clockid,
// precision, out) writes an 8-byte nanosecond timestamp at `out`; we
// reuse the 8-byte scratch at addr 16 (write-then-load, no concurrent
// use). now_unix_ms = realtime ns / 1_000_000; monotonic_ns = the raw
// monotonic clock; now_ns = the raw realtime clock.
pub function clock_funcs(): string {
    var o: string = "";
    o = o + "  (func $__fern_now_ns (result i64)\n";
    o = o + "    (drop (call $clock_time_get (i32.const 0) (i64.const 1000) (i32.const 16)))\n";
    o = o + "    (i64.load (i32.const 16)))\n";
    o = o + "  (func $__fern_now_unix_ms (result i64)\n";
    o = o + "    (drop (call $clock_time_get (i32.const 0) (i64.const 1000) (i32.const 16)))\n";
    o = o + "    (i64.div_u (i64.load (i32.const 16)) (i64.const 1000000)))\n";
    o = o + "  (func $__fern_monotonic_ns (result i64)\n";
    o = o + "    (drop (call $clock_time_get (i32.const 1) (i64.const 1000) (i32.const 16)))\n";
    o = o + "    (i64.load (i32.const 16)))\n";
    return o;
}

// clock_funcs_p2 emits the preview2 clock builtins actually used. wall-clock
// `now` writes seconds (i64 @ 0) + nanoseconds (i32 @ 8) to an 8-aligned
// return area: now_ns = seconds*1e9 + nanos; now_unix_ms = seconds*1000 +
// nanos/1e6. monotonic-clock `now` returns the nanosecond instant directly.
// Each emitted function matches its preview1 counterpart's i64 result, so
// every call site is unchanged.
function clock_funcs_p2(has_wall: boolean, has_mono: boolean): string {
    var o: string = "";
    if (has_wall) {
        o = o + "  (func $__fern_now_ns (result i64)\n";
        o = o + "    (local $ra i32)\n";
        o = o + "    (local.set $ra (i32.and (i32.add (call $__fern_alloc (i32.const 16)) (i32.const 7)) (i32.const -8)))\n";
        o = o + "    (call $wall_now (local.get $ra))\n";
        o = o + "    (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000000000)) (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8))))))\n";
        o = o + "  (func $__fern_now_unix_ms (result i64)\n";
        o = o + "    (local $ra i32)\n";
        o = o + "    (local.set $ra (i32.and (i32.add (call $__fern_alloc (i32.const 16)) (i32.const 7)) (i32.const -8)))\n";
        o = o + "    (call $wall_now (local.get $ra))\n";
        o = o + "    (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000)) (i64.div_u (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8)))) (i64.const 1000000))))\n";
    }
    if (has_mono) {
        o = o + "  (func $__fern_monotonic_ns (result i64)\n";
        o = o + "    (call $mono_now))\n";
    }
    return o;
}

// print_int64_helper mirrors print_int_helper for i64 values, formatting
// into a 24-byte scratch buffer at `buf` (i64's widest decimal is 20
// chars incl. sign). No trailing newline.
function print_int64_helper(buf: i32): string {
    var b: string = util.i32_to_string(buf);
    var be: string = util.i32_to_string(buf + 24);
    var o: string = "";
    o = o + "  (func $__fern_print_int64 (param $n i64)\n";
    o = o + "    (local $i i32)\n";
    o = o + "    (local $neg i32)\n";
    o = o + "    (if (i64.eqz (local.get $n)) (then\n";
    o = o + "      (i32.store8 (i32.const " + b + ") (i32.const 48))\n";
    o = o + "      (i32.store (i32.const 0) (i32.const " + b + "))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (return)))\n";
    o = o + "    (local.set $neg (i64.lt_s (local.get $n) (i64.const 0)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $n (i64.sub (i64.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $i (i32.const " + be + "))\n";
    o = o + "    (block $done (loop $lp\n";
    o = o + "      (br_if $done (i64.eqz (local.get $n)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $n) (i64.const 10)))))\n";
    o = o + "      (local.set $n (i64.div_u (local.get $n) (i64.const 10)))\n";
    o = o + "      (br $lp)))\n";
    o = o + "    (if (local.get $neg) (then\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.const 45))))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $i))\n";
    o = o + "    (i32.store (i32.const 4) (i32.sub (i32.const " + be + ") (local.get $i)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}

// print_int_helper emits the `$__fern_print_int` runtime: format an i32
// as decimal into a 16-byte scratch buffer at `buf` (placed above all
// string data) and fd_write it. Digits are written backwards from the
// buffer end; negatives get a leading '-'. The magnitude is taken with
// unsigned div/rem after a (possibly overflowing) negation, which yields
// the correct digits even for INT_MIN (0 - INT_MIN = INT_MIN, whose
// unsigned value is exactly 2147483648). No trailing newline — matching
// the native print_int.
pub function print_int_helper(buf: i32): string {
    var b: string = util.i32_to_string(buf);
    var be: string = util.i32_to_string(buf + 16);
    var o: string = "";
    o = o + "  (func $__fern_print_int (param $n i32)\n";
    o = o + "    (local $i i32)\n";
    o = o + "    (local $neg i32)\n";
    o = o + "    (if (i32.eqz (local.get $n)) (then\n";
    o = o + "      (i32.store8 (i32.const " + b + ") (i32.const 48))\n";
    o = o + "      (i32.store (i32.const 0) (i32.const " + b + "))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (return)))\n";
    o = o + "    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $n (i32.sub (i32.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $i (i32.const " + be + "))\n";
    o = o + "    (block $done (loop $lp\n";
    o = o + "      (br_if $done (i32.eqz (local.get $n)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10))))\n";
    o = o + "      (local.set $n (i32.div_u (local.get $n) (i32.const 10)))\n";
    o = o + "      (br $lp)))\n";
    o = o + "    (if (local.get $neg) (then\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.const 45))))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $i))\n";
    o = o + "    (i32.store (i32.const 4) (i32.sub (i32.const " + be + ") (local.get $i)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}

// print_str_helper emits the `$__fern_print_str` runtime: given a string-block
// pointer `[len@0][bytes@4]`, set the iovec (buf = ptr+4, len = load(ptr)) in the
// low-24 scratch (memory 0/4, nwritten at 8) and fd_write it to stdout (fd 1).
pub function print_str_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_print_str (param $p i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $p) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $p)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}

// eprint_str_helper is print_str_helper to STDERR (fd 2): the IR path's eprint.
// `eprint` is the stderr line-printer — it appends a trailing newline (mirroring
// `print` and the Go-backend / interp / AST-path `eprint`). The newline byte is
// materialised at scratch addr 12 and flushed as a second 1-byte fd_write.
pub function eprint_str_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_eprint_str (param $p i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $p) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $p)))\n";
    o = o + "    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (i32.store8 (i32.const 12) (i32.const 10))\n";
    o = o + "    (i32.store (i32.const 0) (i32.const 12))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}

// stdout_shim_helpers emits the component-io $fd_write shim: a $fd_write
// function (same signature as the preview1 import) that writes to stdout
// through the preview2 stream interface. The stdout handle from get-stdout
// is fetched once (cached in $__stdout_handle, -1 = unfetched); each write
// reads the iovec (ptr@iovs, len@iovs+4), allocates a 16-byte return area
// for blocking-write-and-flush's result, and reports nwritten = len. So
// every existing `(call $fd_write (i32.const 1) (i32.const 0) (i32.const 1)
// (i32.const 8))` site (the iovec at addr 0) works unchanged.
function stdout_shim_helpers(): string {
    var o: string = "";
    o = o + "  (global $__stdout_handle (mut i32) (i32.const -1))\n";
    o = o + "  (func $fd_write (param $fd i32) (param $iovs i32) (param $iovn i32) (param $nw i32) (result i32)\n";
    o = o + "    (local $ptr i32) (local $len i32) (local $ret i32)\n";
    o = o + "    (if (i32.eq (global.get $__stdout_handle) (i32.const -1))\n";
    o = o + "      (then (global.set $__stdout_handle (call $get_stdout))))\n";
    o = o + "    (local.set $ptr (i32.load (local.get $iovs)))\n";
    o = o + "    (local.set $len (i32.load (i32.add (local.get $iovs) (i32.const 4))))\n";
    // The result return-area must be aligned to the result type's
    // alignment (the stream-error variant holds an own<error> handle); the
    // bump pointer isn't, so over-allocate and round up to 8.
    o = o + "    (local.set $ret (i32.and (i32.add (call $__fern_alloc (i32.const 24)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (call $bwf (global.get $__stdout_handle) (local.get $ptr) (local.get $len) (local.get $ret))\n";
    o = o + "    (i32.store (local.get $nw) (local.get $len))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}

// stderr_shim_helpers emits the component-io $__fern_eprint(s): write a
// string block's bytes to stderr through the preview2 stream interface. The
// stderr handle from get-stderr is fetched once (cached in $__stderr_handle,
// -1 = unfetched); blocking-write-and-flush drains (s+4, len@s) with an
// 8-aligned result return area (same alignment care as the stdout shim).
// Shares the $bwf import with the stdout shim.
function stderr_shim_helpers(): string {
    var o: string = "";
    o = o + "  (global $__stderr_handle (mut i32) (i32.const -1))\n";
    o = o + "  (func $__fern_eprint (param $s i32)\n";
    o = o + "    (local $ret i32)\n";
    o = o + "    (if (i32.eq (global.get $__stderr_handle) (i32.const -1))\n";
    o = o + "      (then (global.set $__stderr_handle (call $get_stderr))))\n";
    o = o + "    (local.set $ret (i32.and (i32.add (call $__fern_alloc (i32.const 24)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (call $bwf (global.get $__stderr_handle) (i32.add (local.get $s) (i32.const 4)) (i32.load (local.get $s)) (local.get $ret))\n";
    // eprint appends a newline (it is print-to-stderr): write the "\\n" byte
    // at scratch addr 12 as a second flush.
    o = o + "    (call $bwf (global.get $__stderr_handle) (i32.const 12) (i32.const 1) (local.get $ret)))\n";
    return o;
}

// eprint_func_p1 emits the preview1 $__fern_eprint(s): write the string
// block's bytes to fd 2 (stderr) via the preview1 fd_write import, using the
// iovec scratch at addr 0/4 and nwritten at 8 (same idiom as write/print).
function eprint_func_p1(): string {
    var o: string = "";
    o = o + "  (func $__fern_eprint (param $s i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $s) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $s)))\n";
    o = o + "    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    // eprint appends a newline (print-to-stderr): write the "\\n" at addr 12.
    o = o + "    (i32.store (i32.const 0) (i32.const 12))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}

// exit_func emits $__fern_exit(code): terminate the program. In component-io
// it calls wasi:cli/exit's exit with `code` as the result discriminant (0 =
// ok → exit 0, 1 = err → exit 1; a code > 1 is an invalid discriminant and
// traps, mirroring the native compiler); in the preview1 / command path it
// calls proc_exit(code), which honours the raw code. Either import diverges,
// so the trailing `unreachable` keeps the (void) function well-formed without
// a fallthrough path.
function exit_func(component_io: boolean): string {
    var o: string = "";
    o = o + "  (func $__fern_exit (param $c i32)\n";
    if (component_io) {
        o = o + "    (call $exit (local.get $c))\n";
    } else {
        o = o + "    (call $proc_exit (local.get $c))\n";
    }
    o = o + "    (unreachable))\n";
    return o;
}

// heap_alloc_helpers emits the bump allocator: a `$heap` global starting
// at `heap_base` (above all static data) and `$__fern_alloc` which bumps
// it. Shared by string concat and array allocation.
pub function heap_alloc_helpers(heap_base: i32, fl_base: i32, fl_cells: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var flb: string = util.i32_to_string(fl_base);
    var flc: string = util.i32_to_string(fl_cells);
    var o: string = "";
    // The over-release detector global lives here (before $__fern_arr_dec,
    // which bumps it, and before rc_runtime_helpers, which also reads it).
    o = o + "  (global $__fern_rc_underflow (mut i32) (i32.const 0))\n";
    o = o + "  (global $heap (mut i32) (i32.const " + hb + "))\n";
    // Perceus size-class freelist: a per-class head pointer array at
    // [fl_base .. fl_base + fl_cells*4), zero-initialised (empty lists) by
    // wasm's zeroed linear memory. Class = roundup8(blocksize)/8. A freed
    // block (rc reaching 0 in $__fern_arr_dec) is pushed onto its class;
    // $__fern_alloc pops a same-class block before bumping. Blocks larger
    // than fl_cells*8 bytes are bump-only (never recycled).
    o = o + "  (func $__fern_alloc (param $n i32) (result i32)\n";
    o = o + "    (local $p i32) (local $cls i32) (local $head i32)\n";
    o = o + "    (local.set $n (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (local.set $cls (i32.shr_u (local.get $n) (i32.const 3)))\n";
    o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
    o = o + "      (local.set $head (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
    o = o + "      (if (local.get $head) (then\n";
    o = o + "        (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (i32.load (i32.add (local.get $head) (i32.const 4))))\n";
    o = o + "        (return (local.get $head))))))\n";
    o = o + "    (local.set $p (global.get $heap))\n";
    o = o + "    (global.set $heap (i32.add (global.get $heap) (local.get $n)))\n";
    // Grow linear memory when the bump pointer passes the current capacity
    // (memory.size pages * 64KiB). Without this the bump allocator traps
    // once a program allocates past the initial pages.
    o = o + "    (if (i32.gt_u (global.get $heap) (i32.mul (memory.size) (i32.const 65536)))\n";
    o = o + "      (then (drop (memory.grow (i32.div_u (i32.add (i32.sub (global.get $heap) (i32.mul (memory.size) (i32.const 65536))) (i32.const 65535)) (i32.const 65536))))))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_arr_box(eb) -> a: allocate an rc-headered array block and
    // return the DATA pointer `a`. Block layout: [rc@0][bsz@4][len@8]
    // [cap@12][elems@16..]; a = base+8, so the rc word sits at [a-8]
    // (matching the asm backends' [data-8] convention) while len@[a],
    // cap@[a+4], elems@[a+8] keep every a-relative array access unchanged.
    // rc starts at 1 (the fresh owner). bsz (at [base+4] = [a-4]) records
    // the rounded block size so $__fern_arr_dec can pick the freelist class
    // without knowing the element width.
    o = o + "  (func $__fern_arr_box (param $eb i32) (result i32)\n";
    o = o + "    (local $base i32) (local $n i32)\n";
    o = o + "    (local.set $n (i32.and (i32.add (i32.add (i32.const 16) (local.get $eb)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
    o = o + "    (i32.add (local.get $base) (i32.const 8)))\n";
    // $__fern_str_box(p) -> s: rc-header a heap STRING block. `p` is the
    // string payload size (4-byte len word + bytes); the 8-byte rc+bsz
    // header is prepended and s = base+8 is returned, so [s] = len,
    // [s+4..] = bytes keep every s-relative string access unchanged while
    // the rc word sits at [s-8] and the block size at [s-4]. Static string
    // literals live in the data section (below heap_base) and are left
    // unboxed — the rc helpers' address guard treats them as immortal.
    // Frees through the shared $__fern_arr_dec (size-class freelist), since
    // a string is flat (no rc-tracked children). Foundation: heap strings
    // are now rc-boxed; counting + release ride on this in later slices.
    o = o + "  (func $__fern_str_box (param $p i32) (result i32)\n";
    o = o + "    (local $base i32) (local $n i32)\n";
    o = o + "    (local.set $n (i32.and (i32.add (i32.add (i32.const 8) (local.get $p)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
    o = o + "    (i32.add (local.get $base) (i32.const 8)))\n";
    // $__fern_alloc_reuse(token, slots) -> box (#4350): the FBIP reuse-
    // degrade primitive, wasm twin of the asm __fn___fern_alloc_reuse, adapted
    // to the str_box layout (rc@box-8, bsz@box-4). A struct box for nf fields
    // is $__fern_str_box(slots*8) — slots counts every payload word (a struct's
    // type-id slot + fields = nf+1, a tuple's elements = arity) — i.e. block
    // size 8 + slots*8 (8-byte header; already 8-aligned). null token -> fresh box; size
    // match -> hand the SAME block back (rc stays 1 — the caller's
    // $__fern_rc_is_unique gate guaranteed sole ownership; the caller
    // overwrites the type-id slot before any read); mismatch -> free the donor
    // block exactly as $__fern_arr_dec's rc==1 path does (rc=0, next parked in
    // the bsz slot, pushed onto its size class) and alloc fresh — a mispaired
    // reuse is only ever slower, never unsound.
    o = o + "  (func $__fern_alloc_reuse (param $t i32) (param $nf i32) (result i32)\n";
    o = o + "    (local $want i32) (local $base i32) (local $cls i32)\n";
    o = o + "    (local.set $want (i32.add (i32.const 8) (i32.mul (local.get $nf) (i32.const 8))))\n";
    o = o + "    (if (i32.eqz (local.get $t)) (then\n";
    o = o + "      (return (call $__fern_str_box (i32.mul (local.get $nf) (i32.const 8))))))\n";
    o = o + "    (local.set $base (i32.sub (local.get $t) (i32.const 8)))\n";
    o = o + "    (if (i32.eq (i32.load (i32.add (local.get $base) (i32.const 4))) (local.get $want)) (then\n";
    o = o + "      (return (local.get $t))))\n";
    o = o + "    (local.set $cls (i32.shr_u (i32.load (i32.add (local.get $base) (i32.const 4))) (i32.const 3)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 0))\n";
    o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
    o = o + "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
    o = o + "      (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (local.get $base))))\n";
    o = o + "    (call $__fern_str_box (i32.mul (local.get $nf) (i32.const 8))))\n";
    // $__fern_arr_dec(a) -> a: Perceus array release. Same guard chain as
    // the rc helpers (null / SSO low-bit / low-addr / sentinel). rc > 1:
    // decrement. rc <= 0: over-release (detector++), no free. rc == 1:
    // FREE — clear rc to 0 (a double-free then reads 0 and ticks the
    // detector instead of corrupting) and push the block onto its size
    // class (the next pointer is parked in the bsz slot at base+4, which
    // $__fern_arr_box rewrites on reuse, so rc stays 0 while free).
    o = o + "  (func $__fern_arr_dec (param $a i32) (result i32)\n";
    o = o + "    (local $base i32) (local $rc i32) (local $cls i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (local.set $base (i32.sub (local.get $a) (i32.const 8)))\n";
    o = o + "    (local.set $rc (i32.load (local.get $base)))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.gt_s (local.get $rc) (i32.const 1)) (then\n";
    o = o + "      (i32.store (local.get $base) (i32.sub (local.get $rc) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (if (i32.le_s (local.get $rc) (i32.const 0)) (then\n";
    o = o + "      (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (local.set $cls (i32.shr_u (i32.load (i32.add (local.get $base) (i32.const 4))) (i32.const 3)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 0))\n";
    o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
    o = o + "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
    o = o + "      (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (local.get $base))))\n";
    o = o + "    (local.get $a))\n";
    // $__fern_arr_dec_ptr(a) -> a: Perceus release of an array whose ELEMENTS
    // are rc-boxed pointers (string[] / struct[] / array-of-array / tuple[]).
    // When `a` is the LAST owner (rc word at [a-8] == 1, i.e. about to be
    // freed) first release every element (a 4-byte i32 slot at [a+8 + i*4],
    // for i in 0..len at [a]) via the shared $__fern_arr_dec, THEN free the
    // buffer itself. The rc==1 guard ensures elements are released exactly
    // once, on the final free (an aliased array at rc>1 just decrements the
    // buffer, elements untouched — they live on through the other owner). One
    // level: an element's OWN rc-tracked children leak (a sound known gap,
    // matching the struct/tuple one-level release). Same null / low-bit /
    // low-addr guards as $__fern_arr_dec so a non-heap or null array is a
    // no-op.
    o = o + "  (func $__fern_arr_dec_ptr (param $a i32) (result i32)\n";
    o = o + "    (local $i i32) (local $n i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "      (local.set $n (i32.load (local.get $a)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $adp_done (loop $adp_lp\n";
    o = o + "        (br_if $adp_done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (drop (call $__fern_arr_dec (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $adp_lp))))) \n";
    o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
    return o;
}

// arr_dec_ptr2_func emits $__fern_arr_dec_ptr2(a) -> a: the TWO-LEVEL sibling
// of $__fern_arr_dec_ptr (#4355 slice 9 — string[][] / arr-of-arr-of-pointers
// reclaim): identical shell, but each element is itself a POINTER-element
// array released fully by $__fern_arr_dec_ptr (its elements — wasm strings are
// single inline blocks — then its buffer), before the outer buffer frees. Same
// rc==1 gate, so a shared outer just decs and elements live on. Emitted
// SEPARATELY from heap_alloc_helpers, gated on the module actually lowering a
// __fern_strarrarr_free call (wasm_ir.module_calls_strarrarr_free): its body's
// inner `call $__fern_arr_dec_ptr` text would otherwise appear in every
// allocating module and trip the negative WAT-grep contracts
// (strarr-elem-alias-excluded).

// optarrarr_free_func: the $__fern_optarrarr_free WAT body (#4365) — the
// Option[<scalar-arr>][] reclaim, wasm sibling of the x86/arm64
// __fn___fern_optarrarr_free bodies. Per element (an 8-byte rc-headered
// [tag@0, payload@4] option box from opt_make/opt_none): a UNIQUELY-owned box
// (rc@e-8 == 1) with tag 0 (Some/Ok) first decs its payload buffer, then the
// box itself is $__fern_arr_dec'd (rc-guarded), then the outer buffer. Only
// emitted when the module lowers a __fern_optarrarr_free call
// (module_calls_optarrarr_free), matching the arr_dec_ptr2 gating.
pub function optarrarr_free_func(heap_base: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var o: string = "";
    o = o + "  (func $__fern_optarrarr_free (param $a i32) (result i32)\n";
    o = o + "    (local $i i32) (local $n i32) (local $e i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "      (local.set $n (i32.load (local.get $a)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $oaf_done (loop $oaf_lp\n";
    o = o + "        (br_if $oaf_done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (local.set $e (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "        (block $oaf_skip\n";
    o = o + "          (br_if $oaf_skip (i32.eqz (local.get $e)))\n";
    o = o + "          (br_if $oaf_skip (i32.and (local.get $e) (i32.const 1)))\n";
    o = o + "          (br_if $oaf_skip (i32.lt_u (local.get $e) (i32.const " + hb + ")))\n";
    o = o + "          (if (i32.and (i32.eq (i32.load (i32.sub (local.get $e) (i32.const 8))) (i32.const 1))\n";
    o = o + "                       (i32.eqz (i32.load (local.get $e))))\n";
    o = o + "            (then (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $e) (i32.const 4)))))))\n";
    o = o + "          (drop (call $__fern_arr_dec (local.get $e))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $oaf_lp))))) \n";
    o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
    return o;
}

pub function arr_dec_ptr2_func(heap_base: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var o: string = "";
    o = o + "  (func $__fern_arr_dec_ptr2 (param $a i32) (result i32)\n";
    o = o + "    (local $i i32) (local $n i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "      (local.set $n (i32.load (local.get $a)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $adp2_done (loop $adp2_lp\n";
    o = o + "        (br_if $adp2_done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (drop (call $__fern_arr_dec_ptr (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $adp2_lp))))) \n";
    o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
    return o;
}

// rc_runtime_helpers emits the Perceus reference-counting runtime for the
// wasm backend — the wasm32 mirror of the x86-64 / arm64 helpers
// (asm.fern `__fn___fern_rc_*`). The rc word is an i32 at [ptr-8]; the
// "data pointer" handed to these helpers is base+8 (so the rc precedes
// the payload). Guard chain matches the asm backends: null → SSO inline
// low-bit tag → low-address → static sentinel (rc high bit / negative as
// signed i32, marking an immortal data-section literal). Unlike the asm
// backends (heap mmap'd high, so a fixed `< 0x10000` guard works), wasm
// linear memory starts low and the bump heap sits just above the static
// data, so the low-address threshold is `heap_base` itself: any pointer
// below it is static data (sentinel-guarded) or a non-pointer small int,
// and every real heap object is >= heap_base. An over-release (dec at
// rc <= 0) bumps the `$__fern_rc_underflow` detector rather than
// corrupting the count, surfaced by __fern_rc_underflow_count(). The
// low-level memory pokes (__alloc / __load_i32 / __store_i32) are the
// wasm counterparts of the x86 `__fn___alloc` / `__fn___load_i32` /
// `__fn___store_i32` runtime funcs: __alloc forwards to the bump heap so
// the rc tests (and any `core/map` raw-memory source that links) resolve.
// This is the additive Phase-0c foundation for wasm RC — the array
// layout migration + inc/dec call sites ride on it in later slices,
// exactly as on the asm backends.
pub function rc_runtime_helpers(heap_base: i32): string {
    var lo: string = util.i32_to_string(heap_base);
    var o: string = "";
    // ($__fern_rc_underflow is defined in heap_alloc_helpers, emitted first.)
    // __alloc(n) -> ptr: forward to the bump allocator.
    o = o + "  (func $__alloc (param $n i32) (result i32)\n";
    o = o + "    (call $__fern_alloc (local.get $n)))\n";
    // __free(p): no-op (bump heap; reclamation is the freelist's job).
    o = o + "  (func $__free (param $p i32) (result i32)\n";
    o = o + "    (local.get $p))\n";
    // __load_i32(a) -> i32.
    o = o + "  (func $__load_i32 (param $a i32) (result i32)\n";
    o = o + "    (i32.load (local.get $a)))\n";
    // __store_i32(a, v) -> a (value-producing so the StmtExpr drop balances).
    o = o + "  (func $__store_i32 (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (i32.store (local.get $a) (local.get $v))\n";
    o = o + "    (local.get $a))\n";
    // __fern_rc_inc(p) -> p: retain.
    o = o + "  (func $__fern_rc_inc (param $p i32) (result i32)\n";
    o = o + "    (local $rc i32)\n";
    o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
    o = o + "    (i32.store (i32.sub (local.get $p) (i32.const 8)) (i32.add (local.get $rc) (i32.const 1)))\n";
    o = o + "    (local.get $p))\n";
    // __fern_rc_dec(p) -> p: release; over-release bumps the detector.
    o = o + "  (func $__fern_rc_dec (param $p i32) (result i32)\n";
    o = o + "    (local $rc i32)\n";
    o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.le_s (local.get $rc) (i32.const 0))\n";
    o = o + "      (then (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))))\n";
    o = o + "    (i32.store (i32.sub (local.get $p) (i32.const 8)) (i32.sub (local.get $rc) (i32.const 1)))\n";
    o = o + "    (local.get $p))\n";
    // __fern_rc_is_unique(p) -> 1 iff a live heap object with rc == 1.
    o = o + "  (func $__fern_rc_is_unique (param $p i32) (result i32)\n";
    o = o + "    (local $rc i32)\n";
    o = o + "    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.eq (local.get $rc) (i32.const 1)) (then (return (i32.const 1))))\n";
    o = o + "    (i32.const 0))\n";
    // __fern_rc_underflow_count() -> i32: the over-release detector.
    o = o + "  (func $__fern_rc_underflow_count (result i32)\n";
    o = o + "    (global.get $__fern_rc_underflow))\n";
    // __fern_snapshot_dec(new, old, snap) -> new (#3456 slice 2). REAL now
    // (Perceus self-host slice 1d): the snapshot-param consume-rebind reclaim.
    // Frees `old` (the superseded intermediate box) only when it is UNIQUELY
    // owned (rc == 1) AND differs from BOTH `new` (cow — the rebind kept it) and
    // `snap` (the caller's borrowed original — never freed). A shared box
    // (rc > 1) is LEFT untouched, NOT decremented: the snapshot param is borrowed,
    // so we hold no count to release — matching the x86 body's `cmpl $1 / jne`
    // (free iff rc==1, else leave). The free reuses $__fern_arr_dec's rc==1 branch
    // (freelist push by size class) — guarding rc==1 here first means arr_dec only
    // ever sees the uniquely-owned case, so it frees rather than decrements.
    // Returns `new`. ($__fern_arr_dec is emitted alongside, in heap_alloc_helpers.)
    o = o + "  (func $__fern_snapshot_dec (param $new i32) (param $old i32) (param $snap i32) (result i32)\n";
    o = o + "    (if (i32.eq (local.get $old) (local.get $new)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.eq (local.get $old) (local.get $snap)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.eqz (local.get $old)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.and (local.get $old) (i32.const 1)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.lt_u (local.get $old) (i32.const " + lo + ")) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.ne (i32.load (i32.sub (local.get $old) (i32.const 8))) (i32.const 1)) (then (return (local.get $new))))\n";
    o = o + "    (drop (call $__fern_arr_dec (local.get $old)))\n";
    o = o + "    (local.get $new))\n";
    return o;
}

// module_uses_rcmem reports whether the program calls any of the RC /
// raw-memory intrinsics, gating both rc_runtime_helpers and (since
// __alloc forwards to it) the bump heap.
function module_uses_rcmem(mod: parser.Module): boolean {
    return module_calls(mod, "__alloc") || module_calls(mod, "__free")
        || module_calls(mod, "__load_i32") || module_calls(mod, "__store_i32")
        || module_calls(mod, "__fern_rc_inc") || module_calls(mod, "__fern_rc_dec")
        || module_calls(mod, "__fern_rc_is_unique")
        || module_calls(mod, "__fern_snapshot_dec")
        || module_calls(mod, "__fern_rc_underflow_count");
}

// env_helpers emits the wasi environ imports + $__fern_env(name): the
// preview-1 two-call environ pattern (sizes_get then get) into bump-heap
// scratch, a linear scan for a `NAME=` entry, and an Option[string] tag
// box result (Some(value) / None). Value bytes are copied into a fresh
// string block. Uses the iovec scratch (addr 0 / 4) for the two sizes —
// safe because env() completes before any write/print reuses them.
pub function env_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"environ_sizes_get\" (func $environ_sizes_get (param i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"environ_get\" (func $environ_get (param i32 i32) (result i32)))\n";
    return o;
}

// env_imports_p2 is the preview2 counterpart: wasi:cli/environment's
// get-environment, which writes a list<tuple<string,string>> — header
// (ptr, count) into the passed return area, each tuple 16 bytes
// (key{ptr@0,len@4}, value{ptr@8,len@12}). The list is host-allocated via
// the exported cabi_realloc.
function env_imports_p2(): string {
    return "  (import \"wasi:cli/environment@0.2.0\" \"get-environment\" (func $get_environment (param i32)))\n";
}

// env_func_p2 is the preview2 $__fern_env(name): get-environment, then a
// linear scan of the (key,value) tuples for a key byte-equal to `name`,
// returning the same Option[string] box as the preview1 helper (Some(value)
// = tag 0 + a fresh [len][bytes] value block at +4; None = tag 1). `name` is
// a [len][bytes] block (bytes at name+4, len at name).
function env_func_p2(): string {
    var o: string = "";
    o = o + "  (func $__fern_env (param $np i32) (result i32)\n";
    o = o + "    (local $ra i32) (local $ptr i32) (local $count i32) (local $nlen i32)\n";
    o = o + "    (local $i i32) (local $tup i32) (local $kp i32) (local $kl i32)\n";
    o = o + "    (local $vp i32) (local $vl i32) (local $ok i32) (local $j i32) (local $res i32) (local $tmp i32)\n";
    o = o + "    (local.set $nlen (i32.load (local.get $np)))\n";
    // get-environment writes the (ptr, count) list header as two i32s, so the
    // return area must be 4-aligned; the bump cursor isn't, so over-allocate
    // and round up to 8.
    o = o + "    (local.set $ra (i32.and (i32.add (call $__fern_alloc (i32.const 16)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (call $get_environment (local.get $ra))\n";
    o = o + "    (local.set $ptr (i32.load (local.get $ra)))\n";
    o = o + "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $done (loop $cont\n";
    o = o + "      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
    o = o + "      (local.set $tup (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
    o = o + "      (local.set $kp (i32.load (local.get $tup)))\n";
    o = o + "      (local.set $kl (i32.load (i32.add (local.get $tup) (i32.const 4))))\n";
    o = o + "      (if (i32.eq (local.get $kl) (local.get $nlen)) (then\n";
    o = o + "        (local.set $ok (i32.const 1))\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $md (loop $mc\n";
    o = o + "          (br_if $md (i32.ge_u (local.get $j) (local.get $nlen)))\n";
    o = o + "          (if (i32.ne (i32.load8_u (i32.add (local.get $kp) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $md)))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $mc)))\n";
    o = o + "        (if (local.get $ok) (then\n";
    o = o + "          (local.set $vp (i32.load (i32.add (local.get $tup) (i32.const 8))))\n";
    o = o + "          (local.set $vl (i32.load (i32.add (local.get $tup) (i32.const 12))))\n";
    o = o + "          (local.set $res (call $__fern_alloc (i32.add (i32.const 4) (local.get $vl))))\n";
    o = o + "          (i32.store (local.get $res) (local.get $vl))\n";
    o = o + "          (local.set $j (i32.const 0))\n";
    o = o + "          (block $cd (loop $cc\n";
    o = o + "            (br_if $cd (i32.ge_u (local.get $j) (local.get $vl)))\n";
    o = o + "            (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vp) (local.get $j))))\n";
    o = o + "            (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "            (br $cc)))\n";
    o = o + "          (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "          (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "          (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
    o = o + "          (return (local.get $tmp))))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cont)))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// env_func emits the $__fern_env body (separate from env_helpers so the
// imports can be placed in the import section, before functions).
pub function env_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_env (param $np i32) (result i32)\n";
    o = o + "    (local $count i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $nlen i32) (local $i i32) (local $e i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local $vstart i32) (local $vlen i32) (local $res i32) (local $tmp i32)\n";
    o = o + "    (local.set $nlen (i32.load (local.get $np)))\n";
    o = o + "    (drop (call $environ_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $count (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $count) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $environ_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $done (loop $cont\n";
    o = o + "      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $md (loop $mc\n";
    o = o + "        (br_if $md (i32.ge_u (local.get $j) (local.get $nlen)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (local.get $e) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $md)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $mc)))\n";
    o = o + "      (if (i32.and (local.get $ok) (i32.eq (i32.load8_u (i32.add (local.get $e) (local.get $nlen))) (i32.const 61))) (then\n";
    o = o + "        (local.set $vstart (i32.add (i32.add (local.get $e) (local.get $nlen)) (i32.const 1)))\n";
    o = o + "        (local.set $vlen (i32.const 0))\n";
    o = o + "        (block $vd (loop $vc\n";
    o = o + "          (br_if $vd (i32.eqz (i32.load8_u (i32.add (local.get $vstart) (local.get $vlen)))))\n";
    o = o + "          (local.set $vlen (i32.add (local.get $vlen) (i32.const 1)))\n";
    o = o + "          (br $vc)))\n";
    o = o + "        (local.set $res (call $__fern_alloc (i32.add (i32.const 4) (local.get $vlen))))\n";
    o = o + "        (i32.store (local.get $res) (local.get $vlen))\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $cd (loop $cc\n";
    o = o + "          (br_if $cd (i32.ge_u (local.get $j) (local.get $vlen)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vstart) (local.get $j))))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $cc)))\n";
    o = o + "        (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "        (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "        (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
    o = o + "        (return (local.get $tmp))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cont)))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// random_helpers / random_func emit the wasi random_get import + the
// $__fern_random_bytes(n) builtin: fill an n-byte wasi buffer and unpack
// each byte into a fresh i32[] array block ([len][cap][elems]).
function random_helpers(): string {
    return "  (import \"wasi_snapshot_preview1\" \"random_get\" (func $random_get (param i32 i32) (result i32)))\n";
}

// random_imports_p2 is the preview2 counterpart: wasi:random/random's
// get-random-u64 (a u64 of randomness per call, no return area / list).
function random_imports_p2(): string {
    return "  (import \"wasi:random/random@0.2.0\" \"get-random-u64\" (func $get_random_u64 (result i64)))\n";
}

// random_get_import / random_bytes_ir_func / random_i32_func / str_bytes_func
// are the IR-path byte-source helpers (issue #2747). They are kept SEPARATE
// from random_helpers / random_func (the AST path's bundle, whose
// $__fern_random_bytes returns a u8[] array) because the IR path types
// random_bytes as a string: random_bytes_ir_func builds a `[len][bytes]` string
// block so str_index / str_len read it correctly, matching the register
// backends. The wasm_ir_run driver emits these gated by module_emits_op; a
// single compile picks one path, so the shared $__fern_random_* symbols never
// clash.
pub function random_get_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"random_get\" (func $random_get (param i32 i32) (result i32)))\n";
}

// $__fern_random_bytes(n) -> a fresh `[len][bytes]` string block of n CSPRNG
// bytes. Allocates 4+n bytes via $__fern_str_box, stores len@0, fills bytes@4
// from random_get.
pub function random_bytes_ir_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
    o = o + "    (local $s i32)\n";
    o = o + "    (local.set $s (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
    o = o + "    (i32.store (local.get $s) (local.get $n))\n";
    o = o + "    (drop (call $random_get (i32.add (local.get $s) (i32.const 4)) (local.get $n)))\n";
    o = o + "    (local.get $s))\n";
    return o;
}

// $__fern_random_i32() -> one CSPRNG i32: fill 4 bytes at the low-memory scratch
// (addr 16, inside the reserved 24-byte scratch region) and load them.
pub function random_i32_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_i32 (result i32)\n";
    o = o + "    (drop (call $random_get (i32.const 16) (i32.const 4)))\n";
    o = o + "    (i32.load (i32.const 16)))\n";
    return o;
}

// $__fern_str_bytes(s) -> a fresh u8[] (`[len][cap][i32 elems]`) holding the
// bytes of string block `s`. Backs both bytes() and as_bytes() (the slot-array
// model has no zero-copy slice view). Reads bytes from s+4+i (the [len][bytes]
// layout), stores each zero-extended into the array's 4-byte slot at arr+8+i*4.
pub function str_bytes_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_bytes (param $s i32) (result i32)\n";
    o = o + "    (local $n i32) (local $arr i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $s)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

function random_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
    o = o + "    (local $arr i32) (local $buf i32) (local $i i32)\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $n)))\n";
    o = o + "    (drop (call $random_get (local.get $buf) (local.get $n)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load8_u (i32.add (local.get $buf) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    // random_i32(): fill 4 wasi bytes at addr 16 and load them as an i32.
    o = o + "  (func $__fern_random_i32 (result i32)\n";
    o = o + "    (drop (call $random_get (i32.const 16) (i32.const 4)))\n";
    o = o + "    (i32.load (i32.const 16)))\n";
    return o;
}

// random_func_p2 is the preview2 $__fern_random_bytes: same i32[] array
// block result ([len][cap][bytes-as-i32]), but the byte source is
// get-random-u64 — one u64 (8 bytes) fetched per 8 output bytes, each byte
// sliced out with a shift+mask. Matches random_func's return shape so every
// random_bytes call site is unchanged.
function random_func_p2(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
    o = o + "    (local $arr i32) (local $i i32) (local $r i64)\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (if (i32.eqz (i32.and (local.get $i) (i32.const 7))) (then (local.set $r (call $get_random_u64))))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.and (i32.wrap_i64 (i64.shr_u (local.get $r) (i64.extend_i32_u (i32.mul (i32.and (local.get $i) (i32.const 7)) (i32.const 8))))) (i32.const 255)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    // random_i32(): the low 32 bits of one get-random-u64 call.
    o = o + "  (func $__fern_random_i32 (result i32)\n";
    o = o + "    (i32.wrap_i64 (call $get_random_u64)))\n";
    return o;
}

// args_helpers / args_func emit the wasi args imports + $__fern_args():
// the two-call sizes-then-get pattern, building a string[] array whose
// elements are fresh string blocks copied from each NUL-terminated argv
// entry (argv[0] is the program name, matching the native backends).
pub function args_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"args_sizes_get\" (func $args_sizes_get (param i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"args_get\" (func $args_get (param i32 i32) (result i32)))\n";
    return o;
}

// args_imports_p2 is the preview2 counterpart: wasi:cli/environment's
// get-arguments, which writes a list<string> — header (ptr, count) into the
// return area, each string 8 bytes (ptr@0, len@4). Host-allocated via the
// exported cabi_realloc.
function args_imports_p2(): string {
    return "  (import \"wasi:cli/environment@0.2.0\" \"get-arguments\" (func $get_arguments (param i32)))\n";
}

// args_func_p2 is the preview2 $__fern_args: get-arguments, then copy each
// list entry into a fresh [len][bytes] string block and store its pointer in
// the same string[] array block ([len][cap][elem-ptrs]) the preview1 helper
// builds, so every args() call site is unchanged.
function args_func_p2(): string {
    var o: string = "";
    o = o + "  (func $__fern_args (result i32)\n";
    o = o + "    (local $ra i32) (local $ptr i32) (local $count i32) (local $arr i32)\n";
    o = o + "    (local $i i32) (local $sp i32) (local $sl i32) (local $blk i32) (local $j i32)\n";
    // get-arguments writes a (ptr, count) header of two i32s, so the return
    // area must be 4-aligned; over-allocate and round up to 8.
    o = o + "    (local.set $ra (i32.and (i32.add (call $__fern_alloc (i32.const 16)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (call $get_arguments (local.get $ra))\n";
    o = o + "    (local.set $ptr (i32.load (local.get $ra)))\n";
    o = o + "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $count) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $count))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $count))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $count)))\n";
    o = o + "      (local.set $sp (i32.load (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 8)))))\n";
    o = o + "      (local.set $sl (i32.load (i32.add (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4))))\n";
    o = o + "      (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $sl))))\n";
    o = o + "      (i32.store (local.get $blk) (local.get $sl))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $cd (loop $cc\n";
    o = o + "        (br_if $cd (i32.ge_u (local.get $j) (local.get $sl)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $sp) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cc)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

pub function args_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_args (result i32)\n";
    o = o + "    (local $argc i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $arr i32) (local $i i32) (local $e i32) (local $len i32) (local $j i32) (local $blk i32)\n";
    o = o + "    (drop (call $args_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $argc (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $argc) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $args_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $argc) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $argc))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $argc))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $argc)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $len (i32.const 0))\n";
    o = o + "      (block $ld (loop $lc\n";
    o = o + "        (br_if $ld (i32.eqz (i32.load8_u (i32.add (local.get $e) (local.get $len)))))\n";
    o = o + "        (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "        (br $lc)))\n";
    o = o + "      (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "      (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $cd (loop $cc\n";
    o = o + "        (br_if $cd (i32.ge_u (local.get $j) (local.get $len)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $e) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cc)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// readfile_helpers / readfile_func emit the wasi file-read imports +
// $__fern_read_file(path): Result[string, IoError]. Opens the path
// relative to preopen fd 3 (a `--dir` / wasi preopen) via path_open,
// reads to EOF into a fresh string block, and returns Ok(block) (tag 0)
// or Err(errno) (tag 1) on open failure. The rights args are i64 — written
// directly in this hand-authored WAT, independent of the i32 value model.
// Read cap is 64 KiB (enough for the compiler-test files; larger files
// truncate — a follow-up can grow the block).
// file_imports emits the wasi imports shared by read_file / write_file
// (path_open's rights args are i64 — fine in hand-authored WAT). fd_read
// is unused by write-only programs but harmless (wasi satisfies it).
// fs_imports_p2 emits the preview2 filesystem imports (component-io-fs mode).
// get-directories (preopens) + descriptor.open-at are shared by read and
// write; read adds read-via-stream + input-stream.blocking-read; write adds
// write-via-stream (output-stream.blocking-write-and-flush is already imported
// by the stdout shim). The import order — stdout pair, then get-directories,
// open-at, then the read/write methods — matches what the corresponding
// component framing (component_full_io_fs / _write) lowers, so the core's
// imports line up with the framing's canon-lower trampolines.
function fs_imports_p2(has_readfile: boolean, has_writefile: boolean): string {
    var o: string = "";
    o = o + "  (import \"wasi:filesystem/preopens@0.2.0\" \"get-directories\" (func $get_directories (param i32)))\n";
    o = o + "  (import \"wasi:filesystem/types@0.2.0\" \"[method]descriptor.open-at\" (func $open_at (param i32 i32 i32 i32 i32 i32 i32)))\n";
    if (has_readfile) {
        o = o + "  (import \"wasi:filesystem/types@0.2.0\" \"[method]descriptor.read-via-stream\" (func $read_via_stream (param i32 i64 i32)))\n";
        o = o + "  (import \"wasi:io/streams@0.2.0\" \"[method]input-stream.blocking-read\" (func $blocking_read (param i32 i64 i32)))\n";
    }
    if (has_writefile) {
        o = o + "  (import \"wasi:filesystem/types@0.2.0\" \"[method]descriptor.write-via-stream\" (func $write_via_stream (param i32 i64 i32)))\n";
    }
    return o;
}

// cabi_realloc_helper emits the canonical-ABI realloc the runtime calls when
// lowering the lists returned by get-directories / blocking-read: align the
// bump pointer to `align`, then bump by `new_size`.
function cabi_realloc_helper(): string {
    var o: string = "";
    o = o + "  (func $cabi_realloc (param $op i32) (param $os i32) (param $al i32) (param $ns i32) (result i32)\n";
    o = o + "    (global.set $heap (i32.and (i32.add (global.get $heap) (i32.sub (local.get $al) (i32.const 1))) (i32.sub (i32.const 0) (local.get $al))))\n";
    o = o + "    (call $__fern_alloc (local.get $ns)))\n";
    o = o + "  (export \"cabi_realloc\" (func $cabi_realloc))\n";
    return o;
}

// readfile_func_p2 is the preview2 $__fern_read_file: get-directories ->
// first preopen descriptor -> open-at(path) -> read-via-stream ->
// blocking-read loop, copying each chunk into a buffer. Returns the same
// 8-byte Result box as the preview1 helper ([tag][payload]; Ok payload is a
// `[len][bytes]` string block, Err payload is the wasi error code). The
// return area (32 bytes, 8-aligned) holds each call's canonical result.
function readfile_func_p2(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_file (param $np i32) (result i32)\n";
    o = o + "    (local $ra i32) (local $fd i32) (local $strm i32) (local $buf i32) (local $off i32) (local $cp i32) (local $cl i32) (local $i i32) (local $tmp i32)\n";
    o = o + "    (local.set $ra (i32.and (i32.add (call $__fern_alloc (i32.const 32)) (i32.const 7)) (i32.const -8)))\n";
    // first preopen descriptor = load(load(retarea))
    o = o + "    (call $get_directories (local.get $ra))\n";
    o = o + "    (local.set $fd (i32.load (i32.load (local.get $ra))))\n";
    // open-at(desc, path-flags=1, path+4, len, oflags=0, descriptor-flags=1, ra)
    o = o + "    (call $open_at (local.get $fd) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 0) (i32.const 1) (local.get $ra))\n";
    o = o + "    (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "    (call $read_via_stream (local.get $fd) (i64.const 0) (local.get $ra))\n";
    o = o + "    (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $strm (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.add (i32.const 4) (i32.const 1048576))))\n";
    o = o + "    (local.set $off (i32.const 0))\n";
    o = o + "    (block $rd (loop $rc\n";
    o = o + "      (call $blocking_read (local.get $strm) (i64.const 4096) (local.get $ra))\n";
    o = o + "      (br_if $rd (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)))\n";
    o = o + "      (local.set $cp (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "      (local.set $cl (i32.load (i32.add (local.get $ra) (i32.const 8))))\n";
    o = o + "      (br_if $rd (i32.eqz (local.get $cl)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $cd (loop $cc\n";
    o = o + "        (br_if $cd (i32.ge_u (local.get $i) (local.get $cl)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 4)) (i32.add (local.get $off) (local.get $i))) (i32.load8_u (i32.add (local.get $cp) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $cc)))\n";
    o = o + "      (local.set $off (i32.add (local.get $off) (local.get $cl)))\n";
    o = o + "      (br $rc)))\n";
    o = o + "    (i32.store (local.get $buf) (local.get $off))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $buf))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// writefile_func_p2 is the preview2 $__fern_write_file: get-directories ->
// first preopen descriptor -> open-at(path, create|truncate, write) ->
// write-via-stream -> blocking-write-and-flush the content in <=4096-byte
// chunks. Returns the same 8-byte Option box as the preview1 helper (tag 1 =
// None on success; tag 0 = Some(errcode) on open/write failure). $np / $cp are
// the path / content `[len][bytes]` blocks; the return area (32 bytes,
// 8-aligned) holds each host call's canonical result. blocking-write-and-flush
// is the $bwf already imported by the stdout shim.
function writefile_func_p2(): string {
    var o: string = "";
    o = o + "  (func $__fern_write_file (param $np i32) (param $cp i32) (result i32)\n";
    o = o + "    (local $ra i32) (local $fd i32) (local $strm i32) (local $clen i32) (local $cur i32) (local $chunk i32) (local $tmp i32)\n";
    o = o + "    (local.set $ra (i32.and (i32.add (call $__fern_alloc (i32.const 32)) (i32.const 7)) (i32.const -8)))\n";
    // first preopen descriptor = load(load(retarea))
    o = o + "    (call $get_directories (local.get $ra))\n";
    o = o + "    (local.set $fd (i32.load (i32.load (local.get $ra))))\n";
    // open-at(desc, path-flags=1, path+4, len, open-flags=9 create|truncate,
    // descriptor-flags=2 write, ra)
    o = o + "    (call $open_at (local.get $fd) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 9) (i32.const 2) (local.get $ra))\n";
    o = o + "    (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "    (call $write_via_stream (local.get $fd) (i64.const 0) (local.get $ra))\n";
    o = o + "    (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $strm (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
    o = o + "    (local.set $clen (i32.load (local.get $cp)))\n";
    o = o + "    (local.set $cur (i32.const 0))\n";
    o = o + "    (block $wd (loop $wc\n";
    o = o + "      (br_if $wd (i32.ge_u (local.get $cur) (local.get $clen)))\n";
    o = o + "      (local.set $chunk (i32.sub (local.get $clen) (local.get $cur)))\n";
    o = o + "      (if (i32.gt_u (local.get $chunk) (i32.const 4096)) (then (local.set $chunk (i32.const 4096))))\n";
    // blocking-write-and-flush(stream, content+4+cur, chunk, ra)
    o = o + "      (call $bwf (local.get $strm) (i32.add (i32.add (local.get $cp) (i32.const 4)) (local.get $cur)) (local.get $chunk) (local.get $ra))\n";
    o = o + "      (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
    o = o + "        (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "        (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "        (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "        (return (local.get $tmp))))\n";
    o = o + "      (local.set $cur (i32.add (local.get $cur) (local.get $chunk)))\n";
    o = o + "      (br $wc)))\n";
    // success -> None (tag 1)
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

pub function file_imports(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"path_open\" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"fd_read\" (func $fd_read (param i32 i32 i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"fd_close\" (func $fd_close (param i32) (result i32)))\n";
    return o;
}

pub function readfile_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_file (param $np i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $blk i32) (local $off i32) (local $n i32) (local $tmp i32) (local $cap i32)\n";
    // rights_base = FD_READ (2) | FD_SEEK (4) — a valid Rights mask
    // (all-ones is rejected: it sets bits outside the defined Rights set).
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 0) (i64.const 6) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $np)))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    // Growable read buffer: a [len][bytes] block whose data capacity starts
    // at 64 KiB and extends by 64 KiB whenever it fills. The bump allocator
    // hands out contiguous bytes and nothing else allocates during the read
    // loop, so each extension lands right after the current buffer. (The old
    // code used a fixed 64 KiB buffer, silently truncating larger files: once
    // off reached 64 KiB the iovec length went to 0, fd_read returned 0, and
    // the loop mistook that for EOF.)
    o = o + "    (local.set $cap (i32.const 65536))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $cap))))\n";
    o = o + "    (local.set $off (i32.const 0))\n";
    o = o + "    (block $rd (loop $rc\n";
    // Ensure room before reading, so a full buffer is never mistaken for EOF.
    o = o + "      (if (i32.ge_u (local.get $off) (local.get $cap)) (then\n";
    o = o + "        (drop (call $__fern_alloc (i32.const 65536)))\n";
    o = o + "        (local.set $cap (i32.add (local.get $cap) (i32.const 65536)))))\n";
    o = o + "      (i32.store (i32.const 0) (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $off)))\n";
    o = o + "      (i32.store (i32.const 4) (i32.sub (local.get $cap) (local.get $off)))\n";
    o = o + "      (drop (call $fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (local.set $n (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rd (i32.eqz (local.get $n)))\n";
    o = o + "      (local.set $off (i32.add (local.get $off) (local.get $n)))\n";
    o = o + "      (br $rc)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $off))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// writefile_func emits $__fern_write_file(path, content): Option[IoError]
// — create/truncate the path (oflags O_CREAT|O_TRUNC = 9), write the
// content block's bytes via fd_write, fd_close. Returns None (tag 1) on
// success or Some(errno) (tag 0) when path_open fails. rights_base =
// FD_WRITE (64) | FD_SEEK (4) = 68.
pub function writefile_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_write_file (param $np i32) (param $cp i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $tmp i32)\n";
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 9) (i64.const 68) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $np)))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $cp) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $cp)))\n";
    o = o + "    (drop (call $fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}

// stat_import emits the preview1 path_filestat_get import (separate from
// file_imports, which read_file/write_file own, so a stat-only module doesn't
// pull path_open/fd_read).
pub function stat_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_filestat_get\" (func $path_filestat_get (param i32 i32 i32 i32 i32) (result i32)))\n";
}

// stat_func emits $__fern_stat(path, fstype) -> Result[FileStat, IoError] box.
// path_filestat_get(preopen fd 3, symlink_follow, path bytes @path+4 / len @[path],
// into a 64-byte heap buffer); on error push Result.Err [tag1, payload0] (the same
// null-IoError the register backends use). On success read filetype@buf+16 (WASI:
// 3=directory, 4=regular_file) + size@buf+32 (i64 -> low i32), build the FileStat
// struct box [type_id@0, is_file@8, is_dir@16, size@24] (the IR struct layout; the
// type-id is the module-specific struct_type_id passed in by the op handler), and
// wrap it Result.Ok [tag0, payload=structptr]. Boxes via $__fern_str_box (the same
// rc-boxed [tag@0,payload@4] / struct shapes opt_make / struct_make build).
pub function stat_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_stat (param $path i32) (param $fstype i32) (result i32)\n";
    o = o + "    (local $err i32) (local $buf i32) (local $ft i32) (local $sz i64) (local $fs i32) (local $res i32)\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 64)))\n";
    o = o + "    (local.set $err (call $path_filestat_get (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (local.get $buf)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
    o = o + "      (return (local.get $res))))\n";
    o = o + "    (local.set $ft (i32.load8_u (i32.add (local.get $buf) (i32.const 16))))\n";
    // WASI filestat size is an i64 at buf+32; FileStat.size is i64, so load the
    // full 8 bytes and i64.store it into the size@24 slot (a >2 GiB file would
    // truncate under the old low-32-bit i32 load/store).
    o = o + "    (local.set $sz (i64.load (i32.add (local.get $buf) (i32.const 32))))\n";
    o = o + "    (local.set $fs (call $__fern_str_box (i32.const 32)))\n";
    o = o + "    (i32.store (local.get $fs) (local.get $fstype))\n";
    o = o + "    (i32.store (i32.add (local.get $fs) (i32.const 8)) (i32.eq (local.get $ft) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.add (local.get $fs) (i32.const 16)) (i32.eq (local.get $ft) (i32.const 3)))\n";
    o = o + "    (i64.store (i32.add (local.get $fs) (i32.const 24)) (local.get $sz))\n";
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $fs))\n";
    o = o + "    (local.get $res))\n";
    return o;
}

// remove_file_import emits the preview1 path_unlink_file import (separate from
// file_imports, so a remove_file-only module doesn't pull in path_open/fd_read).
pub function remove_file_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_unlink_file\" (func $path_unlink_file (param i32 i32 i32) (result i32)))\n";
}

// remove_file_func emits $__fern_remove_file(path) -> Option[IoError] box.
// path_unlink_file(preopen fd 3, path bytes @path+4 / len @[path]) unlinks the
// file; on success (errno 0) push Option.None [tag1, payload0], else push
// Option.Some(IoError) [tag0, payload=0] with the same null-IoError placeholder
// the register backends and $__fern_stat's Err arm use (the match binds the
// payload with a wildcard, so its exact value is never read). Option's tag
// convention matches opt_make / $__fern_env: Some=0, None=1. Boxes via
// $__fern_str_box (the rc-boxed [tag@0,payload@4] shape).
pub function remove_file_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_remove_file (param $path i32) (result i32)\n";
    o = o + "    (local $err i32) (local $res i32)\n";
    o = o + "    (local.set $err (call $path_unlink_file (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (if (i32.eq (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (i32.const 0))\n";
    o = o + "      (return (local.get $res))))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
    o = o + "    (local.get $res))\n";
    return o;
}

// readdir_fd_import emits the preview1 fd_readdir import that $__fern_read_dir
// uses. path_open / fd_close come from file_imports (emitted once for any module
// doing path-based file I/O OR read_dir — an unused fd_read import there is valid
// wasm), so this adds only the fd_readdir entry, avoiding a double import.
pub function readdir_fd_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"fd_readdir\" (func $fd_readdir (param i32 i32 i32 i64 i32) (result i32)))\n";
}

// read_dir_func emits $__fern_read_dir(path) -> Result[string[], IoError] box.
// path_open(preopen fd 3, FD_READDIR right) the directory, then loop fd_readdir
// over the WASI dirent stream (dirent header is 24 bytes: d_next u64 @0, d_ino
// u64 @8, d_namlen u32 @16, d_type u8 @20; the name's d_namlen bytes follow),
// skipping "." / "..", building a string[] via $__fern_arr_push (each entry a
// fresh [len][bytes] block). The cookie loop pages through large directories and
// resumes from the last COMPLETE entry when fd_readdir truncates the trailing
// name (bufused == buflen). On path_open failure push Result.Err [tag1, errno];
// otherwise Result.Ok [tag0, arrayptr]. The readdir buffer is alloc'd once before
// the loop, so the name/array allocations that follow it never overlap the bytes
// a later fd_readdir page overwrites. Needs the heap runtime + $__fern_arr_push.
pub function read_dir_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_dir (param $path i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $arr i32) (local $buf i32)\n";
    o = o + "    (local $cookie i64) (local $lastnext i64) (local $used i32) (local $pos i32)\n";
    o = o + "    (local $namlen i32) (local $nameptr i32) (local $blk i32) (local $i i32) (local $skip i32) (local $res i32)\n";
    // path_open: dirflags = symlink_follow (1), oflags = 0, rights_base =
    // FD_READDIR (1<<14 = 16384). fd written to scratch addr 16.
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (i32.const 0) (i64.const 16384) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
    o = o + "      (return (local.get $res))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    // Empty string[] (len = cap = 0); $__fern_arr_push grows it.
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.const 0)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
    o = o + "    (local.set $cookie (i64.const 0))\n";
    o = o + "    (block $rdone (loop $rloop\n";
    o = o + "      (drop (call $fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
    o = o + "      (local.set $used (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rdone (i32.eqz (local.get $used)))\n";
    o = o + "      (local.set $pos (i32.const 0))\n";
    o = o + "      (local.set $lastnext (local.get $cookie))\n";
    o = o + "      (block $pdone (loop $ploop\n";
    // Need a full 24-byte dirent header.
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
    o = o + "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
    o = o + "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
    // Name must be fully present, else fd_readdir truncated it — stop and resume.
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
    o = o + "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
    // Skip "." and "..".
    o = o + "        (local.set $skip (i32.const 0))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.eqz (local.get $skip)) (then\n";
    o = o + "          (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $namlen))))\n";
    o = o + "          (i32.store (local.get $blk) (local.get $namlen))\n";
    o = o + "          (local.set $i (i32.const 0))\n";
    o = o + "          (block $cd (loop $cc\n";
    o = o + "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
    o = o + "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
    o = o + "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "            (br $cc)))\n";
    o = o + "          (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $blk)))))\n";
    o = o + "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
    o = o + "        (br $ploop)))\n";
    // bufused < buflen => the whole directory fit; otherwise resume from the last
    // complete entry's cookie.
    o = o + "      (br_if $rdone (i32.lt_u (local.get $used) (i32.const 4096)))\n";
    o = o + "      (local.set $cookie (local.get $lastnext))\n";
    o = o + "      (br $rloop)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $arr))\n";
    o = o + "    (local.get $res))\n";
    return o;
}

// remove_dir_import emits the preview1 path_remove_directory import that
// $__fern_remove_dir_all uses to rmdir a now-empty directory. path_open /
// fd_close (file_imports), fd_readdir (readdir_fd_import) and path_unlink_file
// (remove_file_import) are shared with the other fs ops; the caller emits each of
// those bundles once across the union of ops that need them, so this adds only the
// path_remove_directory entry.
pub function remove_dir_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_remove_directory\" (func $path_remove_directory (param i32 i32 i32) (result i32)))\n";
}

// remove_dir_func emits $__fern_remove_dir_all(path) -> Option[IoError] box — a
// recursive rm -rf, the wasm sibling of asm_ir's __fern_remove_dir_all. It first
// path_open(oflags = O_DIRECTORY 2, FD_READDIR right)s the path: success => it's a
// directory; ENOTDIR (54) => it's a file, path_unlink_file it; ENOENT (44) => it
// is already gone (None — rm -rf ignores a missing path); any other errno => Some.
// For a directory it enumerates ALL child base names via an fd_readdir cookie loop
// (skipping . / ..) into a string[] FIRST and fd_closes — so the directory is not
// mutated while it is being iterated — then for each child builds `path + "/" +
// name` and RECURSES (the recursion classifies file vs dir itself), and finally
// path_remove_directorys the now-empty path. Child / rmdir results are best-effort
// (ignored), matching the register backends. Recursion is scratch-safe: the addr-8
// (bufused) and addr-16 (fd) scratch are only live during this frame's enumeration
// phase, which finishes before any recursive call. Two tiny $__rda_none /
// $__rda_some helpers build the Option box (None = tag1, Some = tag0, matching
// opt_make / remove_file). Needs the heap runtime + $__fern_arr_push.
pub function remove_dir_func(): string {
    var o: string = "";
    // Option-box constructors (shared by every return site).
    o = o + "  (func $__rda_none (result i32)\n";
    o = o + "    (local $r i32)\n";
    o = o + "    (local.set $r (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $r) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $r) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $r))\n";
    o = o + "  (func $__rda_some (param $e i32) (result i32)\n";
    o = o + "    (local $r i32)\n";
    o = o + "    (local.set $r (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $r) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $r) (i32.const 4)) (local.get $e))\n";
    o = o + "    (local.get $r))\n";
    o = o + "  (func $__fern_remove_dir_all (param $path i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $names i32) (local $buf i32)\n";
    o = o + "    (local $cookie i64) (local $lastnext i64) (local $used i32) (local $pos i32)\n";
    o = o + "    (local $namlen i32) (local $nameptr i32) (local $blk i32) (local $i i32) (local $skip i32)\n";
    o = o + "    (local $plen i32) (local $nm i32) (local $child i32) (local $j i32)\n";
    // Try to open as a directory (oflags = O_DIRECTORY = 2, rights = FD_READDIR).
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (i32.const 2) (i64.const 16384) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (if (i32.eq (local.get $err) (i32.const 44)) (then (return (call $__rda_none))))\n";
    o = o + "      (if (i32.eq (local.get $err) (i32.const 54)) (then\n";
    o = o + "        (drop (call $path_unlink_file (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
    o = o + "        (return (call $__rda_none))))\n";
    o = o + "      (return (call $__rda_some (call $__fern_build_io_error (local.get $err) (local.get $path))))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    // Enumerate all child names into a string[] (empty to grow).
    o = o + "    (local.set $names (call $__fern_arr_box (i32.const 0)))\n";
    o = o + "    (i32.store (local.get $names) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $names) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
    o = o + "    (local.set $cookie (i64.const 0))\n";
    o = o + "    (block $rdone (loop $rloop\n";
    o = o + "      (drop (call $fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
    o = o + "      (local.set $used (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rdone (i32.eqz (local.get $used)))\n";
    o = o + "      (local.set $pos (i32.const 0))\n";
    o = o + "      (local.set $lastnext (local.get $cookie))\n";
    o = o + "      (block $pdone (loop $ploop\n";
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
    o = o + "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
    o = o + "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
    o = o + "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
    o = o + "        (local.set $skip (i32.const 0))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.eqz (local.get $skip)) (then\n";
    o = o + "          (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $namlen))))\n";
    o = o + "          (i32.store (local.get $blk) (local.get $namlen))\n";
    o = o + "          (local.set $i (i32.const 0))\n";
    o = o + "          (block $cd (loop $cc\n";
    o = o + "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
    o = o + "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
    o = o + "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "            (br $cc)))\n";
    o = o + "          (local.set $names (call $__fern_arr_push (local.get $names) (local.get $blk)))))\n";
    o = o + "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
    o = o + "        (br $ploop)))\n";
    o = o + "      (br_if $rdone (i32.lt_u (local.get $used) (i32.const 4096)))\n";
    o = o + "      (local.set $cookie (local.get $lastnext))\n";
    o = o + "      (br $rloop)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    // Remove each child: build `path + "/" + name`, recurse (file -> unlink, dir
    // -> recurse), ignoring the per-child result (best effort).
    o = o + "    (local.set $plen (i32.load (local.get $path)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dd (loop $dc\n";
    o = o + "      (br_if $dd (i32.ge_s (local.get $i) (i32.load (local.get $names))))\n";
    o = o + "      (local.set $nm (i32.load (i32.add (i32.add (local.get $names) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $namlen (i32.load (local.get $nm)))\n";
    o = o + "      (local.set $child (call $__fern_alloc (i32.add (i32.const 4) (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $namlen)))))\n";
    o = o + "      (i32.store (local.get $child) (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $namlen)))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $p1d (loop $p1c\n";
    o = o + "        (br_if $p1d (i32.ge_u (local.get $j) (local.get $plen)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $child) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (i32.add (local.get $path) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $p1c)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $child) (i32.const 4)) (local.get $plen)) (i32.const 47))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $p2d (loop $p2c\n";
    o = o + "        (br_if $p2d (i32.ge_u (local.get $j) (local.get $namlen)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (i32.add (local.get $child) (i32.const 4)) (i32.add (local.get $plen) (i32.const 1))) (local.get $j)) (i32.load8_u (i32.add (i32.add (local.get $nm) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $p2c)))\n";
    o = o + "      (drop (call $__fern_remove_dir_all (local.get $child)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $dc)))\n";
    o = o + "    (drop (call $path_remove_directory (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
    o = o + "    (call $__rda_none))\n";
    return o;
}

// exp_func emits $__fern_exp_f64(x) -> e^x — the wasm sibling of asm_arm64's
// __fern_exp_f64 polynomial helper (x86 uses the x87 FPU; wasm has no
// transcendental instruction). exp(x) = 2^k · poly(r) where k = round(x·log2e),
// r = x − k·ln2 ∈ [−ln2/2, ln2/2], poly is the degree-7 Taylor of e^r (Horner),
// and 2^k is built directly in the f64 exponent bits ((k+1023) << 52 reinterpreted
// as f64). Same coefficients as the arm64 helper. Self-contained f64 math — no
// imports, no heap. f64.nearest is ties-to-even vs arm64's frinta (ties-to-away),
// but they differ only on exact .5 ties of x·log2e (measure zero), so the result
// is identical for every practical input.
pub function exp_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_exp_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $kf f64) (local $ki i64) (local $r f64) (local $p f64)\n";
    o = o + "    (local.set $kf (f64.nearest (f64.mul (local.get $x) (f64.const 1.4426950408889634))))\n";
    o = o + "    (local.set $ki (i64.trunc_f64_s (local.get $kf)))\n";
    o = o + "    (local.set $r (f64.sub (local.get $x) (f64.mul (local.get $kf) (f64.const 0.6931471805599453))))\n";
    o = o + "    (local.set $p (f64.const 0.00019841269841269841))\n";                                    // 1/5040
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.0013888888888888889)))\n"; // 1/720
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.0083333333333333332)))\n"; // 1/120
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.041666666666666664)))\n";  // 1/24
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.16666666666666666)))\n";   // 1/6
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.5)))\n";
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1.0)))\n";
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1.0)))\n";
    o = o + "    (f64.mul (local.get $p) (f64.reinterpret_i64 (i64.shl (i64.add (local.get $ki) (i64.const 1023)) (i64.const 52)))))\n";
    return o;
}

// log_func emits $__fern_log_f64(x) -> ln x (x > 0) — the wasm sibling of
// asm_arm64's __fern_log_f64 (same algorithm + coefficients). Decompose
// x = m·2^e (m ∈ [1,2) via the exponent/mantissa bits), normalize m to
// [√2/2, √2) so f = (m−1)/(m+1) is small, then ln(m) = 2·(f + f³/3 + f⁵/5 + … +
// f¹¹/11) via a Horner polynomial in f², and ln(x) = e·ln2 + ln(m). The exponent
// is extracted with i64 bit ops (shr/and/sub) and the mantissa re-biased to
// [1,2) by masking the low 52 bits and OR-ing the 1023 exponent. Self-contained
// f64 math — no imports, no heap. (Domain x <= 0 is the caller's contract, as on
// the register backends.)
pub function log_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_log_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $bits i64) (local $e i64) (local $m f64) (local $f f64) (local $f2 f64) (local $p f64)\n";
    o = o + "    (local.set $bits (i64.reinterpret_f64 (local.get $x)))\n";
    // e = ((bits >> 52) & 0x7ff) - 1023
    o = o + "    (local.set $e (i64.sub (i64.and (i64.shr_u (local.get $bits) (i64.const 52)) (i64.const 2047)) (i64.const 1023)))\n";
    // m = reinterpret((bits & ((1<<52)-1)) | (1023<<52)) -> [1,2)
    o = o + "    (local.set $m (f64.reinterpret_i64 (i64.or (i64.and (local.get $bits) (i64.const 4503599627370495)) (i64.const 4607182418800017408))))\n";
    // normalize to [sqrt2/2, sqrt2): if m > sqrt2, halve m and bump e
    o = o + "    (if (f64.gt (local.get $m) (f64.const 1.4142135623730951)) (then\n";
    o = o + "      (local.set $m (f64.mul (local.get $m) (f64.const 0.5)))\n";
    o = o + "      (local.set $e (i64.add (local.get $e) (i64.const 1)))))\n";
    o = o + "    (local.set $f (f64.div (f64.sub (local.get $m) (f64.const 1.0)) (f64.add (local.get $m) (f64.const 1.0))))\n";
    o = o + "    (local.set $f2 (f64.mul (local.get $f) (local.get $f)))\n";
    // Horner in f2: ((((l11*f2+l9)*f2+l7)*f2+l5)*f2+l3)*f2 + 1
    o = o + "    (local.set $p (f64.const 0.090909090909090912))\n";                                          // 1/11
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $f2)) (f64.const 0.1111111111111111)))\n";  // 1/9
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $f2)) (f64.const 0.14285714285714285)))\n"; // 1/7
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $f2)) (f64.const 0.2)))\n";                 // 1/5
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $f2)) (f64.const 0.33333333333333331)))\n"; // 1/3
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $f2)) (f64.const 1.0)))\n";
    // ln(m) = 2 * f * poly
    o = o + "    (local.set $p (f64.mul (local.get $p) (local.get $f)))\n";
    o = o + "    (local.set $p (f64.add (local.get $p) (local.get $p)))\n";
    // ln(x) = e*ln2 + ln(m)
    o = o + "    (f64.add (f64.mul (f64.convert_i64_s (local.get $e)) (f64.const 0.6931471805599453)) (local.get $p)))\n";
    return o;
}

// pow_func emits $__fern_pow_f64(x, y) -> x^y = exp(y·ln x) (x > 0) — the wasm
// sibling of asm_arm64's __fern_pow_f64. Composes the exp + log runtimes
// ($__fern_exp_f64 / $__fern_log_f64, which the caller emits alongside this), so
// it is a one-liner. The two f64 operands arrive in stack order x then y
// (irlower's op_fbin), matching the param order. Domain x <= 0 is the caller's
// contract, as on the register backends.
pub function pow_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_pow_f64 (param $x f64) (param $y f64) (result f64)\n";
    o = o + "    (call $__fern_exp_f64 (f64.mul (local.get $y) (call $__fern_log_f64 (local.get $x)))))\n";
    return o;
}

// trig_reduce_and_polys emits the shared body of $__fern_sin_f64 / $__fern_cos_f64
// up to (but not including) the quadrant select: range-reduce k = round(x/(π/2)),
// q = k & 3, r = x − k·(π/2) ∈ [−π/4, π/4], then build sin(r) and cos(r) as Taylor
// polynomials in r² (Horner) into $sinr / $cosr. Same coefficients as asm_arm64's
// __fern_sin_f64 / __fern_cos_f64. Locals $k/$q/$r/$r2/$sinr/$cosr are declared by
// the caller. q = k & 3 keeps the low two bits even for negative k (two's
// complement), matching the arm64 `and`.
function trig_reduce_and_polys(): string {
    var o: string = "";
    o = o + "    (local.set $k (f64.nearest (f64.div (local.get $x) (f64.const 1.5707963267948966))))\n";
    o = o + "    (local.set $q (i64.and (i64.trunc_f64_s (local.get $k)) (i64.const 3)))\n";
    o = o + "    (local.set $r (f64.sub (local.get $x) (f64.mul (local.get $k) (f64.const 1.5707963267948966))))\n";
    o = o + "    (local.set $r2 (f64.mul (local.get $r) (local.get $r)))\n";
    // sin(r) = r·(1 + s3·r² + s5·r⁴ + s7·r⁶)
    o = o + "    (local.set $sinr (f64.const -0.00019841269841269841))\n";                                         // -1/5040
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const 0.0083333333333333332)))\n"; // 1/120
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const -0.16666666666666666)))\n";  // -1/6
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const 1.0)))\n";
    o = o + "    (local.set $sinr (f64.mul (local.get $sinr) (local.get $r)))\n";
    // cos(r) = 1 + c2·r² + c4·r⁴ + c6·r⁶
    o = o + "    (local.set $cosr (f64.const -0.0013888888888888889))\n";                                          // -1/720
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const 0.041666666666666664)))\n";  // 1/24
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const -0.5)))\n";                  // -1/2
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const 1.0)))\n";
    return o;
}

// sin_func emits $__fern_sin_f64(x) -> sin x — the wasm sibling of asm_arm64's
// __fern_sin_f64. Shares trig_reduce_and_polys, then the quadrant q = k & 3 picks
// sin(r) / cos(r) / −sin(r) / −cos(r). Self-contained f64 math — no imports/heap.
pub function sin_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_sin_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $k f64) (local $q i64) (local $r f64) (local $r2 f64) (local $sinr f64) (local $cosr f64)\n";
    o = o + trig_reduce_and_polys();
    // q: 0 -> sin(r), 1 -> cos(r), 2 -> -sin(r), 3 -> -cos(r)
    o = o + "    (if (result f64) (i64.eqz (local.get $q))\n";
    o = o + "      (then (local.get $sinr))\n";
    o = o + "      (else (if (result f64) (i64.eq (local.get $q) (i64.const 1))\n";
    o = o + "        (then (local.get $cosr))\n";
    o = o + "        (else (if (result f64) (i64.eq (local.get $q) (i64.const 2))\n";
    o = o + "          (then (f64.neg (local.get $sinr)))\n";
    o = o + "          (else (f64.neg (local.get $cosr)))))))))\n";
    return o;
}

// cos_func emits $__fern_cos_f64(x) -> cos x — same reduction/polys as sin, but the
// quadrant picks cos(r) / −sin(r) / −cos(r) / sin(r).
pub function cos_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_cos_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $k f64) (local $q i64) (local $r f64) (local $r2 f64) (local $sinr f64) (local $cosr f64)\n";
    o = o + trig_reduce_and_polys();
    // q: 0 -> cos(r), 1 -> -sin(r), 2 -> -cos(r), 3 -> sin(r)
    o = o + "    (if (result f64) (i64.eqz (local.get $q))\n";
    o = o + "      (then (local.get $cosr))\n";
    o = o + "      (else (if (result f64) (i64.eq (local.get $q) (i64.const 1))\n";
    o = o + "        (then (f64.neg (local.get $sinr)))\n";
    o = o + "        (else (if (result f64) (i64.eq (local.get $q) (i64.const 2))\n";
    o = o + "          (then (f64.neg (local.get $cosr)))\n";
    o = o + "          (else (local.get $sinr))))))))\n";
    return o;
}

// map_iter_helpers emits the wasm IR map-iterator runtime: $__fern_map_iter +
// the four accessors $__fern_mapiter_has_next / _key / _value / _advance. The
// register backends (x86-64 / arm64) iterate their PARALLEL-ARRAY maps lazily
// (cursor straight into the live keys[]/vals[]); a wasm map is a HASH map with
// gaps, so instead the iterator MATERIALIZES the live entries up front via the
// existing $__fern_map_keys / $__fern_map_values (which $__fern_map_snapshot
// compacts in matching slot order, so keys[j] pairs with values[j]). The
// iterator box is [keys@0, vals@4, cursor@8] (12 bytes); has_next compares the
// cursor to keys.len (len @ keys+0), key/value index the snapshot arrays (elems
// @ arr+8, 4-byte slots — i32 or string pointer alike), and advance bumps the
// stored cursor in place (the box is re-read each loop turn). Reuses map_helpers
// (emitted for any map module), so it pulls in no new structural runtime.
pub function map_iter_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_map_iter (param $map i32) (result i32)\n";
    o = o + "    (local $box i32)\n";
    o = o + "    (local.set $box (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (i32.store (local.get $box) (call $__fern_map_keys (local.get $map)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 4)) (call $__fern_map_values (local.get $map)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (i32.const 0))\n";
    o = o + "    (local.get $box))\n";
    // has_next: cursor (box@8) < keys.len (len @ keys+0, keys = box@0)
    o = o + "  (func $__fern_mapiter_has_next (param $box i32) (result i32)\n";
    o = o + "    (i32.lt_s (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.load (i32.load (local.get $box)))))\n";
    // key: keys[cursor] — keys = box@0, element at keys + 8 + cursor*4
    o = o + "  (func $__fern_mapiter_key (param $box i32) (result i32)\n";
    o = o + "    (i32.load (i32.add (i32.add (i32.load (local.get $box)) (i32.const 8)) (i32.mul (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 4)))))\n";
    // value: values[cursor] — values = box@4
    o = o + "  (func $__fern_mapiter_value (param $box i32) (result i32)\n";
    o = o + "    (i32.load (i32.add (i32.add (i32.load (i32.add (local.get $box) (i32.const 4))) (i32.const 8)) (i32.mul (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 4)))))\n";
    // advance: box@8 += 1; push a dummy (the statement drops it)
    o = o + "  (func $__fern_mapiter_advance (param $box i32) (result i32)\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (i32.add (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 1)))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}

// temp_dir_import emits the preview1 path_create_directory import that
// $__fern_temp_dir uses to mkdir the unique directory under the preopen.
pub function temp_dir_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_create_directory\" (func $path_create_directory (param i32 i32 i32) (result i32)))\n";
}

// sleep_ms_import emits the preview1 poll_oneoff import that $__fern_sleep_ms
// uses to block on a monotonic-clock timeout.
pub function sleep_ms_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"poll_oneoff\" (func $poll_oneoff (param i32 i32 i32 i32) (result i32)))\n";
}

// sleep_ms_func emits $__fern_sleep_ms(ms) -> i32 (a dummy the statement drops,
// mirroring the x86 push). Where the register backends nanosleep a timespec, wasm
// preview1 has no sleep syscall — but a bare timed block needs only poll_oneoff
// with a SINGLE monotonic-clock subscription (NOT the wasi:io/poll multiplexer the
// reactor needs). ms <= 0 returns immediately. Builds one preview1 `subscription`
// in a fresh heap buffer (userdata u64 @0, eventtype tag u8 @8 = 0/clock, then the
// subscription_clock at @16: clockid u32 @16 = 1/monotonic, timeout u64 @24 =
// ms·1e6 ns, precision u64 @32 = 0, subclockflags u16 @40 = 0/RELATIVE), with the
// 32-byte event-out at @48 and the nevents slot at @80, and poll_oneoff blocks for
// the timeout. Heap-backed (the buffer), so gated into the heap runtime.
pub function sleep_ms_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_sleep_ms (param $ms i32) (result i32)\n";
    o = o + "    (local $buf i32)\n";
    o = o + "    (if (i32.gt_s (local.get $ms) (i32.const 0)) (then\n";
    o = o + "      (local.set $buf (call $__fern_alloc (i32.const 88)))\n";
    o = o + "      (i64.store (local.get $buf) (i64.const 0))\n";
    o = o + "      (i32.store8 (i32.add (local.get $buf) (i32.const 8)) (i32.const 0))\n";
    o = o + "      (i32.store (i32.add (local.get $buf) (i32.const 16)) (i32.const 1))\n";
    o = o + "      (i64.store (i32.add (local.get $buf) (i32.const 24)) (i64.mul (i64.extend_i32_s (local.get $ms)) (i64.const 1000000)))\n";
    o = o + "      (i64.store (i32.add (local.get $buf) (i32.const 32)) (i64.const 0))\n";
    o = o + "      (i32.store16 (i32.add (local.get $buf) (i32.const 40)) (i32.const 0))\n";
    o = o + "      (drop (call $poll_oneoff (local.get $buf) (i32.add (local.get $buf) (i32.const 48)) (i32.const 1) (i32.add (local.get $buf) (i32.const 80))))))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}

// temp_dir_func emits $__fern_temp_dir(prefix) -> Result[string, IoError] box.
// Builds a unique name `<prefix>-<monotonic_ns>` and path_create_directorys it
// under the preopen (fd 3), returning Ok(name) / Err(IoError). Mirrors asm_ir's
// __fern_temp_dir EXCEPT it drops the absolute "/tmp/" prefix: wasm has no global
// /tmp, only the preopen, so the returned path is preopen-RELATIVE — exactly the
// model every other wasm fs op (stat / read_dir / remove_file / remove_dir_all)
// already uses, so the name round-trips through those ops within the sandbox. The
// ns suffix is converted to decimal inline (count digits, then write right-to-
// left). Needs the heap runtime ($__fern_str_box / $__fern_alloc), the clock
// runtime ($__fern_monotonic_ns) and path_create_directory.
pub function temp_dir_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_temp_dir (param $prefix i32) (result i32)\n";
    o = o + "    (local $ns i64) (local $tmp i64) (local $nd i32) (local $plen i32) (local $tot i32)\n";
    o = o + "    (local $blk i32) (local $base i32) (local $i i32) (local $err i32) (local $res i32)\n";
    o = o + "    (local.set $ns (call $__fern_monotonic_ns))\n";
    o = o + "    (local.set $plen (i32.load (local.get $prefix)))\n";
    // Count decimal digits of ns (>= 1).
    o = o + "    (local.set $tmp (local.get $ns))\n";
    o = o + "    (local.set $nd (i32.const 1))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (local.set $tmp (i64.div_u (local.get $tmp) (i64.const 10)))\n";
    o = o + "      (br_if $cd (i64.eqz (local.get $tmp)))\n";
    o = o + "      (local.set $nd (i32.add (local.get $nd) (i32.const 1)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.set $tot (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $nd)))\n";
    // String block [len][bytes].
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $tot))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $tot))\n";
    // Copy prefix bytes.
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $pd (loop $pl\n";
    o = o + "      (br_if $pd (i32.ge_u (local.get $i) (local.get $plen)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $prefix) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $pl)))\n";
    // Separator '-'.
    o = o + "    (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 45))\n";
    // ns decimal digits, written right-to-left into [base .. base+nd).
    o = o + "    (local.set $base (i32.add (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 1)))\n";
    o = o + "    (local.set $tmp (local.get $ns))\n";
    o = o + "    (local.set $i (local.get $nd))\n";
    o = o + "    (block $wd (loop $wl\n";
    o = o + "      (br_if $wd (i32.eqz (local.get $i)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (i32.add (local.get $base) (local.get $i)) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $tmp) (i64.const 10)))))\n";
    o = o + "      (local.set $tmp (i64.div_u (local.get $tmp) (i64.const 10)))\n";
    o = o + "      (br $wl)))\n";
    // mkdir under the preopen.
    o = o + "    (local.set $err (call $path_create_directory (i32.const 3) (i32.add (local.get $blk) (i32.const 4)) (local.get $tot)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $blk)))\n";
    o = o + "      (return (local.get $res))))\n";
    // Ok(path).
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $res))\n";
    return o;
}

// stdin_fd_read_import emits the standalone wasi fd_read import that read_line /
// read_int use to read stdin (fd 0). file_imports ALSO imports fd_read for
// read_file, so the caller (wasm_ir_run) must emit only one of the two — this
// one when the module reads stdin but does NOT do path-based file I/O.
pub function stdin_fd_read_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"fd_read\" (func $fd_read (param i32 i32 i32 i32) (result i32)))\n";
}

// read_line_func emits $__fern_read_line (no args -> Option[string]): one line of
// stdin INCLUDING its trailing '\n', Some(line) / None at EOF (#4369 — matches
// native, replacing the old bare-string-stripped block). Reads up to 256 bytes
// from fd 0 via fd_read (iovec {ptr,len} at addr 0, byte count at addr 8), scans
// for '\n' (len includes it), boxes [len:i32][bytes], and wraps it in an Option
// box [tag@0, payload@4] via __fern_str_box — the same string + Option layout
// reader_read_chunk_func builds. Heap-gated (op_allocates).
pub function read_line_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_line (result i32)\n";
    o = o + "    (local $buf i32) (local $nread i32) (local $len i32) (local $blk i32) (local $i i32) (local $opt i32)\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 256)))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $buf))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const 256))\n";
    o = o + "    (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (local.set $nread (i32.load (i32.const 8)))\n";
    o = o + "    (if (i32.eqz (local.get $nread)) (then\n";
    o = o + "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $opt) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
    o = o + "      (return (local.get $opt))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $len) (local.get $nread)))\n";
    o = o + "      (br_if $d (i32.eq (i32.load8_u (i32.add (local.get $buf) (local.get $len))) (i32.const 10)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (if (i32.lt_u (local.get $len) (local.get $nread)) (then\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $cd (loop $cc\n";
    o = o + "      (br_if $cd (i32.ge_u (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $buf) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cc)))\n";
    o = o + "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $opt) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $opt))\n";
    return o;
}

// reader_fd_close_import emits the standalone wasi fd_close import that
// $__fern_reader_close uses. file_imports ALSO imports fd_close (for path I/O),
// so the caller (wasm_ir_run) emits this one ONLY when a reader-closing module
// does NOT do path-based file I/O — otherwise fd_close would be imported twice.
pub function reader_fd_close_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"fd_close\" (func $fd_close (param i32) (result i32)))\n";
}

// reader_read_chunk_func emits $__fern_reader_read_chunk(fd, n) -> Option[string]
// — the wasm sibling of asm_ir's __fern_reader_read_chunk (x86 uses sys_read;
// wasm uses preview1 fd_read). A Reader is just its fd (an i32; stdin() = fd 0).
// Reads up to n bytes from fd via fd_read (iovec {ptr,len} at addr 0, byte count
// at addr 8 — the same scratch idiom as read_line) directly into a fresh string
// block [len:i32][bytes], then wraps it in an Option box [tag@0, payload@4]:
// Some(chunk) (tag 0) when bytes were read, None (tag 1) at EOF / no bytes. Same
// string + Option layout env_func builds. Needs the heap runtime (str_box/alloc).
pub function reader_read_chunk_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_reader_read_chunk (param $fd i32) (param $n i32) (result i32)\n";
    o = o + "    (local $blk i32) (local $nread i32) (local $opt i32)\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $n))))\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $blk) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (local.get $n))\n";
    o = o + "    (drop (call $fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (local.set $nread (i32.load (i32.const 8)))\n";
    o = o + "    (if (i32.eqz (local.get $nread)) (then\n";
    o = o + "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $opt) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
    o = o + "      (return (local.get $opt))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $nread))\n";
    o = o + "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $opt) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $opt))\n";
    return o;
}

// reader_close_func emits $__fern_reader_close(fd) -> Option[IoError] — the wasm
// sibling of asm_ir's __fern_reader_close. Closes the fd via preview1 fd_close
// and returns None (tag 1 = no error), matching the register backends (which
// always report success). Allocates the 8-byte Option box, so it too rides the
// heap runtime.
pub function reader_close_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_reader_close (param $fd i32) (result i32)\n";
    o = o + "    (local $opt i32)\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $opt) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $opt))\n";
    return o;
}

// read_int_func emits $__fern_read_int (no args -> i32). Reads up to 16 bytes
// from fd 0 into the 16-byte scratch at addr 16 (write-then-parse, no concurrent
// use — same scratch-reuse the clock helpers do), then parses a leading optional
// '-' + decimal digits, stopping at the first non-digit (newline / EOF). Unlike
// read_line it allocates nothing (the result is a bare i32), matching the
// register backends — so a read_int-only module needs no heap runtime.
pub function read_int_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_int (result i32)\n";
    o = o + "    (local $nread i32) (local $i i32) (local $acc i32) (local $neg i32) (local $c i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.const 16))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const 16))\n";
    o = o + "    (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (local.set $nread (i32.load (i32.const 8)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (local.set $acc (i32.const 0))\n";
    o = o + "    (local.set $neg (i32.const 0))\n";
    o = o + "    (if (i32.and (i32.gt_u (local.get $nread) (i32.const 0)) (i32.eq (i32.load8_u (i32.const 16)) (i32.const 45))) (then\n";
    o = o + "      (local.set $neg (i32.const 1)) (local.set $i (i32.const 1))))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $nread)))\n";
    o = o + "      (local.set $c (i32.sub (i32.load8_u (i32.add (i32.const 16) (local.get $i))) (i32.const 48)))\n";
    o = o + "      (br_if $d (i32.gt_u (local.get $c) (i32.const 9)))\n";
    o = o + "      (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 10)) (local.get $c)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (if (result i32) (local.get $neg) (then (i32.sub (i32.const 0) (local.get $acc))) (else (local.get $acc))))\n";
    return o;
}

// arr_helpers emits the array runtime: $__fern_arr_push appends v to the
// array, growing geometrically (cap 0 → 4, else ×2) into a fresh block
// and copying the elements when full. Returns the (possibly new) pointer,
// matching `xs = xs.append(v)`. Depends on $__fern_alloc.
// arr_slice_helper emits ONLY $__fern_arr_slice (a fresh array holding
// a[start:end), 4-byte i32 elements). Self-contained apart from $__fern_arr_box
// (always emitted with the heap runtime), so the IR path can pull in array
// slicing without the rest of arr_helpers (push / wide variants).
pub function arr_slice_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_slice (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// arr_slice8_helper emits ONLY $__fern_arr_slice8 (a fresh array holding
// a[start:end), 8-byte f64/i64 elements — a raw i64 byte-move). Self-contained
// apart from $__fern_arr_box, so the IR path can pull in f64[] slicing without
// the rest of arr_helpers (the wide push variants etc.).
pub function arr_slice8_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_slice8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 8))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 8)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

function arr_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_push (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $a)))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
    o = o + "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (local.set $ncap (i32.const 4))\n";
    o = o + "    (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $ncap) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "    (local.get $na))\n";
    // $__fern_arr_slice(a, start, end) → fresh array block holding
    // a[start:end) (len = cap = end-start), copying the i32 elements.
    o = o + "  (func $__fern_arr_slice (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    // 8-byte-slot variants for i64[] / f64[]: push_i64 / push_f64 store a
    // wide value; slice8 copies 8-byte elements (raw i64 move — works for
    // both element types). Always emitted with the array runtime.
    o = o + arr_push_wide("i64", "i64");
    o = o + arr_push_wide("f64", "f64");
    o = o + "  (func $__fern_arr_slice8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 8))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 8)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    // $__fern_arr_with(a, i, v) → a: in-place element store returning the
    // (same) array — the value-returning `arr.with(i, v)` replacing the
    // removed `arr[i] = v` statement. 4-byte i32 slot; _i64/_f64 are the
    // 8-byte-slot variants for i64[] / f64[].
    o = o + "  (func $__fern_arr_with (param $a i32) (param $i i32) (param $v i32) (result i32)\n";
    o = o + "    (i32.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $v))\n";
    o = o + "    (local.get $a))\n";
    // Cell[T] (docs/CELL-TYPE-PLAN.md): a single i32 slot. cell_new allocs +
    // stores + returns the pointer; cell_set stores in place + returns the
    // pointer (so a bare `c.set(v);` drops a value cleanly). get is inline
    // (i32.load). Leak-everything heap, so no RC.
    o = o + "  (func $__fern_cell_new (param $v i32) (result i32)\n";
    o = o + "    (local $p i32)\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $p) (local.get $v))\n";
    o = o + "    (local.get $p))\n";
    o = o + "  (func $__fern_cell_set (param $c i32) (param $v i32) (result i32)\n";
    o = o + "    (i32.store (local.get $c) (local.get $v))\n";
    o = o + "    (local.get $c))\n";
    o = o + "  (func $__fern_arr_with_i64 (param $a i32) (param $i i32) (param $v i64) (result i32)\n";
    o = o + "    (i64.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (local.get $v))\n";
    o = o + "    (local.get $a))\n";
    o = o + "  (func $__fern_arr_with_f64 (param $a i32) (param $i i32) (param $v f64) (result i32)\n";
    o = o + "    (f64.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (local.get $v))\n";
    o = o + "    (local.get $a))\n";
    return o;
}

// arr_push_wide emits a geometric-growth push for an 8-byte-slot array.
// `vty` is the wasm value type of the appended element (i64 / f64);
// `sop` its store op. Existing elements are copied with a raw i64 move
// (8 bytes, element-type-agnostic).
// arr_push_i64_helper emits $__fern_arr_push_i64 standalone for the IR path
// (the AST path gets it bundled inside arr_helpers). 8-byte-slot geometric-
// growth push — the i64[] / u64[] companion to arr_push_helper's 4-byte
// $__fern_arr_push. Depends only on $__fern_arr_box (module_allocates).
pub function arr_push_i64_helper(): string {
    return arr_push_wide("i64", "i64");
}

// arr_push_f64_helper emits $__fern_arr_push_f64 — the f64[] companion to
// arr_push_i64_helper. Same 8-byte-slot geometric-growth push, but the value
// param + final store are f64 (the existing-element copy loop stays i64.load /
// i64.store, which is bit-preserving for the raw 8-byte slots). Lowered from
// `a = a.append(v)` on an f64[].
pub function arr_push_f64_helper(): string {
    return arr_push_wide("f64", "f64");
}

function arr_push_wide(vty: string, sop: string): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_push_" + vty + " (param $a i32) (param $v " + vty + ") (result i32)\n";
    o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $a)))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
    o = o + "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (" + sop + ".store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const 8))) (local.get $v))\n";
    o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (local.set $ncap (i32.const 4))\n";
    o = o + "    (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $ncap) (i32.const 8))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (" + sop + ".store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const 8))) (local.get $v))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// map_helpers emits the i32-keyed / i32-valued hash-map runtime. The map
// box is 24 bytes: [count@0][cap@4][keys@8][vals@12][used@16][pad@20];
// keys / vals / used are three separate cap*4 regions (open addressing,
// linear probing; `used[i]` is 0 = empty, 1 = occupied). count sits at
// offset 0 so the generic `.len()` (load word @0) returns the entry
// count. Fresh bump-allocated memory is already zero, so a new `used`
// region reads as all-empty. Depends on $__fern_alloc.
pub function map_helpers(): string {
    var o: string = "";
    // $__fern_str_hash(ptr) → 32-bit FNV-1a over a string block's bytes
    // ([len@0][bytes@4]).
    o = o + "  (func $__fern_str_hash (param $p i32) (result i32)\n";
    o = o + "    (local $h i32) (local $n i32) (local $i i32)\n";
    o = o + "    (local.set $h (i32.const -2128831035))\n";
    o = o + "    (local.set $n (i32.load (local.get $p)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $h (i32.mul (i32.xor (local.get $h) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)))) (i32.const 16777619)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $h))\n";
    // $__fern_map_hk(k, cap, kis) → bucket. String keys (kis=1) hash their
    // bytes; i32 keys use a Fibonacci-ish multiply. Masked to cap-1 (cap is
    // always a power of two).
    o = o + "  (func $__fern_map_hk (param $k i32) (param $cap i32) (param $kis i32) (param $hashidx i32) (result i32)\n";
    o = o + "    (if (result i32) (i32.eq (local.get $kis) (i32.const 2))\n";
    // Struct/enum key (kis 2): the derived hash via the funcref table (#2671).
    o = o + "      (then (i32.and (call_indirect (type $fn1) (local.get $k) (local.get $hashidx)) (i32.sub (local.get $cap) (i32.const 1))))\n";
    o = o + "      (else (if (result i32) (local.get $kis)\n";
    o = o + "        (then (i32.and (call $__fern_str_hash (local.get $k)) (i32.sub (local.get $cap) (i32.const 1))))\n";
    o = o + "        (else (i32.and (i32.mul (local.get $k) (i32.const -1640531527)) (i32.sub (local.get $cap) (i32.const 1))))))))\n";
    // $__fern_map_keq(a, b, kis) → key equality. String keys (kis=1) compare
    // by content via $__fern_streq; i32 keys by value.
    o = o + "  (func $__fern_map_keq (param $a i32) (param $b i32) (param $kis i32) (param $eqidx i32) (result i32)\n";
    o = o + "    (if (result i32) (i32.eq (local.get $kis) (i32.const 2))\n";
    // Struct/enum key (kis 2): the derived eq via the funcref table (#2671).
    o = o + "      (then (call_indirect (type $fn2) (local.get $a) (local.get $b) (local.get $eqidx)))\n";
    o = o + "      (else (if (result i32) (local.get $kis)\n";
    o = o + "        (then (call $__fern_streq (local.get $a) (local.get $b)))\n";
    o = o + "        (else (i32.eq (local.get $a) (local.get $b)))))))\n";
    // $__fern_map_new(hint) → empty i32-keyed box with cap 8 (kis=0 @ +20).
    o = o + "  (func $__fern_map_new (param $hint i32) (result i32)\n";
    o = o + "    (return (call $__fern_map_new_k (local.get $hint) (i32.const 0) (i32.const 0) (i32.const 0))))\n";
    // $__fern_map_new_str(hint) → empty string-keyed box (kis=1 @ +20).
    o = o + "  (func $__fern_map_new_str (param $hint i32) (result i32)\n";
    o = o + "    (return (call $__fern_map_new_k (local.get $hint) (i32.const 1) (i32.const 0) (i32.const 0))))\n";
    // $__fern_map_new_struct(hint, hashidx, eqidx) → struct/enum-keyed box
    // (kis=2 @ +20); the derived hash/eq funcref-table slots are stored at
    // +32 / +36 so hk/keq can call_indirect them. #2671.
    o = o + "  (func $__fern_map_new_struct (param $hint i32) (param $hashidx i32) (param $eqidx i32) (result i32)\n";
    o = o + "    (return (call $__fern_map_new_k (local.get $hint) (i32.const 2) (local.get $hashidx) (local.get $eqidx))))\n";
    // The box is 32 bytes: [count@0][cap@4][keys@8][vals@12][used@16]
    // [kis@20][tombs@24][vis@28]; `used[i]` is 0 = empty, 1 = occupied, 2 =
    // tombstone (a deleted slot the probe must skip past). vis (value-is-
    // string) mirrors kis: set by $__fern_map_set when a string value is
    // inserted, read by $__fern_map_release to release the values.
    o = o + "  (func $__fern_map_new_k (param $hint i32) (param $kis i32) (param $hashidx i32) (param $eqidx i32) (result i32)\n";
    o = o + "    (local $box i32) (local $zi i32)\n";
    // The map box is rc-headered via $__fern_str_box (returns base+8, so every
    // box-relative field [box+N] is unchanged) so a map local can be counted
    // and freed; the 32-byte payload holds [count@0][cap@4][keys@8][vals@12]
    // [used@16][kis@20][tombs@24][vis@28].
    o = o + "    (local.set $box (call $__fern_str_box (i32.const 40)))\n";
    o = o + "    (i32.store (local.get $box) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 4)) (i32.const 8))\n";
    // keys/vals/used are rc-boxed via $__fern_str_box (flat: data ptr at
    // base+8, so [arr + i*4] addressing is unchanged) so $__fern_map_grow can
    // free the old arrays on resize (and the map free, later, can release
    // them). Each holds cap (=8) i32 slots = 32 payload bytes.
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (call $__fern_str_box (i32.const 32)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 12)) (call $__fern_str_box (i32.const 32)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 16)) (call $__fern_str_box (i32.const 32)))\n";
    // Zero the `used` array: a $__fern_str_box block recycled from the freelist
    // (since map_grow now frees old arrays) carries STALE occupancy flags, and
    // an unzeroed used[] makes $__fern_map_find probe forever. (keys/vals need
    // no zeroing — only occupied slots, gated by used[], are ever read.)
    o = o + "    (local.set $zi (i32.const 0))\n";
    o = o + "    (block $zd (loop $zl\n";
    o = o + "      (br_if $zd (i32.ge_u (local.get $zi) (i32.const 8)))\n";
    o = o + "      (i32.store (i32.add (i32.load (i32.add (local.get $box) (i32.const 16))) (i32.mul (local.get $zi) (i32.const 4))) (i32.const 0))\n";
    o = o + "      (local.set $zi (i32.add (local.get $zi) (i32.const 1)))\n";
    o = o + "      (br $zl)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 20)) (local.get $kis))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 24)) (i32.const 0))\n";
    // vis starts 0 (no string value seen yet); $__fern_map_set sets it on the
    // first string-value insert. A freelist-recycled box carries stale bytes,
    // so the explicit zero matters.
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 28)) (i32.const 0))\n";
    // Struct/enum-key funcref-table slots (kis 2); 0 / unused for i32/string.
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 32)) (local.get $hashidx))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 36)) (local.get $eqidx))\n";
    o = o + "    (local.get $box))\n";
    // $__fern_map_grow(box): double the capacity and rehash live entries.
    o = o + "  (func $__fern_map_grow (param $box i32)\n";
    o = o + "    (local $oc i32) (local $ok i32) (local $ov i32) (local $ou i32)\n";
    o = o + "    (local $nc i32) (local $nk i32) (local $nv i32) (local $nu i32)\n";
    o = o + "    (local $i i32) (local $idx i32) (local $key i32) (local $kis i32) (local $zi i32)\n";
    o = o + "    (local.set $kis (i32.load (i32.add (local.get $box) (i32.const 20))))\n";
    o = o + "    (local.set $oc (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "    (local.set $ok (i32.load (i32.add (local.get $box) (i32.const 8))))\n";
    o = o + "    (local.set $ov (i32.load (i32.add (local.get $box) (i32.const 12))))\n";
    o = o + "    (local.set $ou (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "    (local.set $nc (i32.mul (local.get $oc) (i32.const 2)))\n";
    o = o + "    (local.set $nk (call $__fern_str_box (i32.mul (local.get $nc) (i32.const 4))))\n";
    o = o + "    (local.set $nv (call $__fern_str_box (i32.mul (local.get $nc) (i32.const 4))))\n";
    o = o + "    (local.set $nu (call $__fern_str_box (i32.mul (local.get $nc) (i32.const 4))))\n";
    // Zero the new `used` array — a freelist-recycled block holds stale flags;
    // the rehash below only sets the LIVE slots to 1, so unzeroed gaps would
    // read as occupied and hang $__fern_map_find.
    o = o + "    (local.set $zi (i32.const 0))\n";
    o = o + "    (block $zd (loop $zl\n";
    o = o + "      (br_if $zd (i32.ge_u (local.get $zi) (local.get $nc)))\n";
    o = o + "      (i32.store (i32.add (local.get $nu) (i32.mul (local.get $zi) (i32.const 4))) (i32.const 0))\n";
    o = o + "      (local.set $zi (i32.add (local.get $zi) (i32.const 1)))\n";
    o = o + "      (br $zl)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 4)) (local.get $nc))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (local.get $nk))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 12)) (local.get $nv))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 16)) (local.get $nu))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 24)) (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
