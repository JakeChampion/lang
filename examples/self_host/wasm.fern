    o = o + "      (br_if $dc (i32.gt_s (i32.add (local.get $i) (local.get $lo)) (local.get $lh)))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm (loop $cm\n";
    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $lo)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $old) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
