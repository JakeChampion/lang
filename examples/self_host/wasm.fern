    o = o + "      (block $di (loop $ci\n";
    o = o + "        (br_if $di (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (i32.mul (local.get $k) (local.get $l)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $ci)))\n";
