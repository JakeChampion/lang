    o = o + "  (func $__fern_str_join (param $a i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $n i32) (local $sl i32) (local $total i32) (local $i i32) (local $p i32) (local $w i32) (local $elem i32) (local $el i32) (local $j i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $sl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $total (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dt (loop $ct\n";
    o = o + "      (br_if $dt (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $total (i32.add (local.get $total) (i32.load (local.get $elem))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ct)))\n";
    o = o + "    (if (i32.gt_s (local.get $n) (i32.const 0)) (then (local.set $total (i32.add (local.get $total) (i32.mul (local.get $sl) (i32.sub (local.get $n) (i32.const 1)))))))\n";
    o = o + "    (local.set $p (call $__fern_alloc (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $w (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dj (loop $cj\n";
    o = o + "      (br_if $dj (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (if (i32.gt_s (local.get $i) (i32.const 0)) (then\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $ds (loop $cs\n";
    o = o + "          (br_if $ds (i32.ge_s (local.get $j) (local.get $sl)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j))))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $cs)))\n";
    o = o + "        (local.set $w (i32.add (local.get $w) (local.get $sl)))))\n";
    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $el (i32.load (local.get $elem)))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $de (loop $ce\n";
    o = o + "        (br_if $de (i32.ge_s (local.get $j) (local.get $el)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $elem) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ce)))\n";
    o = o + "      (local.set $w (i32.add (local.get $w) (local.get $el)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cj)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_str_split(s, sep): split s on sep into a fresh string[]
    // (built via arr_push). Empty sep → single-element [s].
    o = o + "  (func $__fern_str_split (param $s i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $sl i32) (local $sepl i32) (local $i i32) (local $start i32) (local $arr i32) (local $piece i32) (local $j i32) (local $match i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (local.set $sepl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (if (i32.eqz (local.get $sepl)) (then (return (call $__fern_arr_push (local.get $arr) (local.get $s)))))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $i) (i32.sub (local.get $sl) (local.get $sepl))))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm (loop $cm\n";
    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $sepl)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm)))\n";
    o = o + "      (if (local.get $match) (then\n";
    o = o + "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $i)))\n";
    o = o + "        (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (local.get $sepl)))\n";
    o = o + "        (local.set $start (local.get $i)))\n";
    o = o + "      (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $sl)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// collect_strings_expr interns every string literal reachable from an
// expression into the table.
function collect_strings_expr(e: parser.Expr, t: StrTable): StrTable {
    match (e) {
        parser.ExprString(se) => { return t.intern(se.value); },
        parser.ExprUnary(u) => { return collect_strings_expr(u.operand, t); },
        parser.ExprBinary(b) => {
            t = collect_strings_expr(b.left, t);
            return collect_strings_expr(b.right, t);
        },
        parser.ExprCall(c) => {
            // Walk the callee too — a method call like `"abc".len()`
            // hides its literal in the ExprFieldAccess receiver.
            t = collect_strings_expr(c.callee, t);
            var i: i32 = 0;
            while (i < c.args.len()) {
                t = collect_strings_expr(c.args[i], t);
                i = i + 1;
            }
            return t;
        },
        parser.ExprFieldAccess(fa) => {
            return collect_strings_expr(fa.obj, t);
        },
        parser.ExprSlice(sl) => {
            t = collect_strings_expr(sl.array, t);
            t = collect_strings_expr(sl.start, t);
            return collect_strings_expr(sl.end, t);
        },
        parser.ExprTuple(tu) => {
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                t = collect_strings_expr(tu.elements[ti], t);
                ti = ti + 1;
            }
            return t;
        },
        parser.ExprLambda(lm) => {
            // Intern string literals inside the lambda body (it compiles
            // against the same module string table).
            return collect_strings_stmts(lm.body, t);
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                t = collect_strings_expr(a.elements[i], t);
                i = i + 1;
            }
            return t;
        },
        parser.ExprIndex(ix) => {
            t = collect_strings_expr(ix.array, t);
            return collect_strings_expr(ix.index, t);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { t = collect_strings_expr(sl.base, t); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                t = collect_strings_expr(sl.field_values[i], t);
                i = i + 1;
            }
            return t;
        },
        _ => { return t; },
    }
    return t;
}

// collect_strings_stmts recurses a statement list (and nested if/while
// bodies) interning every string literal.
function collect_strings_stmts(body: parser.Stmt[], t: StrTable): StrTable {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { t = collect_strings_expr(v.init, t); },
            parser.StmtAssign(a) => { t = collect_strings_expr(a.value, t); },
            parser.StmtReturn(r) => { t = collect_strings_expr(r.value, t); },
            parser.StmtExpr(e) => { t = collect_strings_expr(e.value, t); },
            parser.StmtIf(f) => {
                t = collect_strings_expr(f.cond, t);
                t = collect_strings_stmts(f.then_body, t);
                t = collect_strings_stmts(f.else_body, t);
            },
            parser.StmtWhile(w) => {
                t = collect_strings_expr(w.cond, t);
                t = collect_strings_stmts(w.body, t);
            },
            parser.StmtFor(f) => {
                t = collect_strings_expr(f.iter, t);
                t = collect_strings_stmts(f.body, t);
            },
            parser.StmtMatch(m) => {
                t = collect_strings_expr(m.scrutinee, t);
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    t = collect_strings_stmts(m.arms[k].body, t);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return t;
}

// write_fixed emits a fd_write of `len` bytes at the constant memory
// address `off` (used for the "\n" byte). The errno result is dropped.
function write_fixed(off: i32, len: i32): string {
    var o: string = "";
    o = o + "    (i32.store (i32.const 0) (i32.const " + i32_to_string(off) + "))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const " + i32_to_string(len) + "))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    return o;
}

// emit_output emits a `write` / `print` of a string VALUE — any
// expression that evaluates to a string pointer (literal, local, param,
// call result). The pointer is parked in the temp slot at addr 16, then
// the iovec is set from the block header: buf = ptr+4, len = load(ptr).
// `print` follows with the "\n" byte at addr 12 (Fern's `print` ==
// println; `write` is verbatim).
function emit_output(name: string, args: parser.Expr[], st: WState): WState {
    if (args.len() != 1) { return st; }
    var ptr: string = emit_expr(args[0], st.cx, 0);
    st = st.w("    (i32.store (i32.const 16) " + ptr + ")\n");
    st = st.w("    (i32.store (i32.const 0) (i32.add (i32.load (i32.const 16)) (i32.const 4)))\n");
    st = st.w("    (i32.store (i32.const 4) (i32.load (i32.load (i32.const 16))))\n");
    st = st.w("    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n");
    if (name == "print") {
        st = st.w(write_fixed(12, 1));
    }
    return st;
}

// emit_stmts lowers a statement list, appending to st.out.
function emit_stmts(body: parser.Stmt[], st: WState): WState {
    var i: i32 = 0;
    while (i < body.len()) {
        st = emit_stmt(body[i], st);
        i = i + 1;
    }
    return st;
}

// emit_stmt lowers a single statement.
function emit_stmt(stmt: parser.Stmt, st: WState): WState {
    match (stmt) {
        parser.StmtVar(v) => {
            // `var (a, b) = <tuple>` destructure: park the tuple pointer in
            // $__lit0 (the init is emitted at depth 1 so it won't clash),
            // then bind a = tuple.0, b = tuple.1.
            if (comma_index(v.name) >= 0) {
                var an: string = before_comma(v.name);
                var bn: string = after_comma(v.name);
                st = st.w("    (local.set $__lit0 " + emit_expr(v.init, st.cx, 1) + ")\n");
                st = st.w("    (local.set $" + an + " (i32.load (local.get $__lit0)))\n");
                return st.w("    (local.set $" + bn + " (i32.load (i32.add (local.get $__lit0) (i32.const 4))))\n");
            }
            // `var xs: i64[] = […]` / `f64[]`: a bare integer / float
            // literal carries no width, so emit the literal with the
            // declared element kind (8-byte slots + i64/f64 stores).
            var dak: string = arr_kind_of_spelling(v.type_name);
            if (dak != "i32") {
                match (v.init) {
                    parser.ExprArray(arr) => {
                        return st.w("    (local.set $" + v.name + " " + emit_array_literal_kind(arr, dak, st.cx, 0) + ")\n");
                    },
                    _ => {},
                }
            }
            // An i64- / f64-typed binding coerces its initialiser to that
            // type so a bare literal (`var t: i64 = 0;` / `var x: f64 =
            // 1;`) becomes the right const.
            if (v.type_name == "i64") {
                return st.w("    (local.set $" + v.name + " " + emit_i64(v.init, st.cx, 0) + ")\n");
            }
            if (is_float_type(v.type_name)) {
                return st.w("    (local.set $" + v.name + " " + emit_f64(v.init, st.cx, 0) + ")\n");
            }
            return st.w("    (local.set $" + v.name + " " + emit_expr(v.init, st.cx, 0) + ")\n");
        },
        parser.StmtAssign(a) => {
            if (contains_str(st.cx.i64_names, a.target)) {
                return st.w("    (local.set $" + a.target + " " + emit_i64(a.value, st.cx, 0) + ")\n");
            }
            if (contains_str(st.cx.f64_names, a.target)) {
                return st.w("    (local.set $" + a.target + " " + emit_f64(a.value, st.cx, 0) + ")\n");
            }
            return st.w("    (local.set $" + a.target + " " + emit_expr(a.value, st.cx, 0) + ")\n");
        },
        parser.StmtReturn(r) => {
            // In an i64- / f64-returning function the return value is
            // coerced to match the wasm `(result …)`.
            if (st.cx.ret_i64) {
                return st.w("    (return " + emit_i64(r.value, st.cx, 0) + ")\n");
            }
            if (st.cx.ret_f64) {
                return st.w("    (return " + emit_f64(r.value, st.cx, 0) + ")\n");
            }
            // `return [<bare literals>]` from an i64[]/f64[] function: the
            // literal carries no width, so build it with the declared
            // element kind (8-byte slots).
            if (st.cx.ret_arr_kind != "i32") {
                match (r.value) {
                    parser.ExprArray(arr) => {
                        return st.w("    (return " + emit_array_literal_kind(arr, st.cx.ret_arr_kind, st.cx, 0) + ")\n");
                    },
                    _ => {},
                }
            }
            return st.w("    (return " + emit_expr(r.value, st.cx, 0) + ")\n");
        },
        parser.StmtExpr(e) => {
            // write(...) / print(...) are builtins (not user funcs), so
            // intercept them here and emit the fd_write sequence rather
            // than a generic call.
            match (e.value) {
                parser.ExprCall(c) => {
                    match (c.callee) {
                        parser.ExprIdent(id) => {
                            if (id.name == "write" || id.name == "print") {
                                return emit_output(id.name, c.args, st);
                            }
                            if (id.name == "print_int" && c.args.len() == 1) {
                                if (is_i64_expr(c.args[0], st.cx)) {
                                    return st.w("    (call $__fern_print_int64 " + emit_i64(c.args[0], st.cx, 0) + ")\n");
                                }
                                return st.w("    (call $__fern_print_int " + emit_expr(c.args[0], st.cx, 0) + ")\n");
                            }
                            if (id.name == "__set_index" && c.args.len() == 3) {
                                // arr[idx] = v  (parser desugar). Store v at
                                // arr + 8 + idx*slot; an i64[]/f64[] uses an
                                // 8-byte slot + i64/f64 store of a wide value.
                                var sk: string = array_elem_kind(c.args[0], st.cx);
                                var sv: string = "";
                                if (sk == "i64") { sv = emit_i64(c.args[2], st.cx, 0); }
                                else if (sk == "f64") { sv = emit_f64(c.args[2], st.cx, 0); }
                                else { sv = emit_expr(c.args[2], st.cx, 0); }
                                return st.w("    (" + elem_store_op(sk) + " (i32.add (i32.add " + emit_expr(c.args[0], st.cx, 0) + " (i32.const 8)) (i32.mul " + emit_expr(c.args[1], st.cx, 0) + " (i32.const " + i32_to_string(elem_slot_size(sk)) + "))) " + sv + ")\n");
                            }
                            if (id.name == "__set_field" && c.args.len() == 3) {
                                // obj.field = v  (parser desugar). The
                                // field name is a string literal arg; store
                                // v at obj + index*4.
                                return st.w("    (i32.store (i32.add " + emit_expr(c.args[0], st.cx, 0) + " (i32.const " + i32_to_string(set_field_offset(c.args[0], c.args[1], st.cx)) + ")) " + emit_expr(c.args[2], st.cx, 0) + ")\n");
                            }
                        },
                        _ => {},
                    }
                },
                _ => {},
            }
            // A call to a void function / method leaves nothing on the
            // stack — emit it bare; everything else is value-producing and
            // gets dropped.
            if (expr_is_void_call(e.value, st.cx)) {
                return st.w("    " + emit_expr(e.value, st.cx, 0) + "\n");
            }
            return st.w("    (drop " + emit_expr(e.value, st.cx, 0) + ")\n");
        },
        parser.StmtIf(f) => {
            st = st.w("    (if " + emit_expr(f.cond, st.cx, 0) + " (then\n");
            st = emit_stmts(f.then_body, st);
            st = st.w("    )");
            if (f.else_body.len() > 0) {
                st = st.w(" (else\n");
                st = emit_stmts(f.else_body, st);
                st = st.w("    )");
            }
            return st.w(")\n");
        },
        parser.StmtWhile(w) => {
            var id: i32 = st.n;
            var brk: string = "$brk_" + i32_to_string(id);
            var cont: string = "$cont_" + i32_to_string(id);
            // Save the enclosing loop's labels; restore after the body.
            var outer_brk: string = st.brk;
            var outer_cont: string = st.cont;
            // Bump the label counter and enter this loop's label scope.
            var inner: WState = WState {
                ...st,
                out: st.out + "    (block " + brk + " (loop " + cont + "\n"
                    + "    (br_if " + brk + " (i32.eqz " + emit_expr(w.cond, st.cx, 0) + "))\n",
                n: id + 1,
                brk: brk,
                cont: cont,
            };
            inner = emit_stmts(w.body, inner);
            // Restore the enclosing loop's labels; keep accumulated
            // output + the advanced counter.
            return WState {
                ...inner,
                out: inner.out + "    (br " + cont + ")))\n",
                brk: outer_brk,
                cont: outer_cont,
            };
        },
        parser.StmtBreak(_) => {
            return st.w("    (br " + st.brk + ")\n");
        },
        parser.StmtContinue(_) => {
            return st.w("    (br " + st.cont + ")\n");
        },
        parser.StmtFor(f) => {
            // `for (k, v) in m { body }` → walk the map's slots: the box is
            // evaluated once into $__fa<d>; $__fi<d> is the slot index;
            // each live slot (used == 1) binds k = keys[i], v = vals[i].
            if (comma_index(f.var_name) >= 0) {
                var d2: i32 = st.fd;
                var fi2: string = "$__fi" + i32_to_string(d2);
                var fa2: string = "$__fa" + i32_to_string(d2);
                var id2: i32 = st.n;
                var brk2: string = "$fbrk_" + i32_to_string(id2);
                var loop2: string = "$floop_" + i32_to_string(id2);
                var bodycont2: string = "$fcont_" + i32_to_string(id2);
                var kn: string = before_comma(f.var_name);
                var vn: string = after_comma(f.var_name);
                var ob: string = st.brk;
                var oc: string = st.cont;
                var head2: string =
                    "    (local.set " + fa2 + " " + emit_expr(f.iter, st.cx, 0) + ")\n"
                    + "    (local.set " + fi2 + " (i32.const 0))\n"
                    + "    (block " + brk2 + " (loop " + loop2 + "\n"
                    + "    (br_if " + brk2 + " (i32.ge_s (local.get " + fi2 + ") (i32.load (i32.add (local.get " + fa2 + ") (i32.const 4)))))\n"
                    + "    (if (i32.eq (i32.load (i32.add (i32.load (i32.add (local.get " + fa2 + ") (i32.const 16))) (i32.mul (local.get " + fi2 + ") (i32.const 4)))) (i32.const 1)) (then\n"
                    + "    (local.set $" + kn + " (i32.load (i32.add (i32.load (i32.add (local.get " + fa2 + ") (i32.const 8))) (i32.mul (local.get " + fi2 + ") (i32.const 4)))))\n"
                    + "    (local.set $" + vn + " (i32.load (i32.add (i32.load (i32.add (local.get " + fa2 + ") (i32.const 12))) (i32.mul (local.get " + fi2 + ") (i32.const 4)))))\n"
                    + "    (block " + bodycont2 + "\n";
                var inner2: WState = WState {
                    ...st,
                    out: st.out + head2,
                    n: id2 + 1,
                    brk: brk2,
                    cont: bodycont2,
                    fd: d2 + 1,
                };
                inner2 = emit_stmts(f.body, inner2);
                return WState {
                    ...inner2,
                    out: inner2.out + "    )))\n    (local.set " + fi2 + " (i32.add (local.get " + fi2 + ") (i32.const 1)))\n    (br " + loop2 + ")))\n",
                    brk: ob,
                    cont: oc,
                    fd: d2,
                };
            }
            // `for v in arr { body }` → index walk. The iterated array is
            // evaluated once into $__fa<d>; $__fi<d> is the index; v is
            // bound to arr[idx] each turn. Depth d (0..3) keeps nested
            // loops from clobbering each other's temps.
            var d: i32 = st.fd;
            var fi: string = "$__fi" + i32_to_string(d);
            var fa: string = "$__fa" + i32_to_string(d);
            var id: i32 = st.n;
            var brk: string = "$fbrk_" + i32_to_string(id);
            var loop: string = "$floop_" + i32_to_string(id);
            // `continue` must still run the index increment, so it
            // branches to the END of a body block (bodycont), after which
            // the increment + loop-back run. `break` branches to brk.
            var bodycont: string = "$fcont_" + i32_to_string(id);
            var outer_brk: string = st.brk;
            var outer_cont: string = st.cont;
            // Element kind picks the load op + slot stride (i64[]/f64[]
            // are 8-byte; the loop var is typed wide to match — see
            // collect_wide_loop_vars).
            var ekind: string = array_elem_kind(f.iter, st.cx);
            var eslot: string = i32_to_string(elem_slot_size(ekind));
            var head: string =
                "    (local.set " + fa + " " + emit_expr(f.iter, st.cx, 0) + ")\n"
                + "    (local.set " + fi + " (i32.const 0))\n"
                + "    (block " + brk + " (loop " + loop + "\n"
                + "    (br_if " + brk + " (i32.ge_s (local.get " + fi + ") (i32.load (local.get " + fa + "))))\n"
                + "    (local.set $" + f.var_name + " (" + elem_load_op(ekind) + " (i32.add (i32.add (local.get " + fa + ") (i32.const 8)) (i32.mul (local.get " + fi + ") (i32.const " + eslot + ")))))\n"
                + "    (block " + bodycont + "\n";
            var inner: WState = WState {
                ...st,
                out: st.out + head,
                n: id + 1,
                brk: brk,
                cont: bodycont,
                fd: d + 1,
            };
            inner = emit_stmts(f.body, inner);
            return WState {
                ...inner,
                out: inner.out + "    )\n    (local.set " + fi + " (i32.add (local.get " + fi + ") (i32.const 1)))\n    (br " + loop + ")))\n",
                brk: outer_brk,
                cont: outer_cont,
                fd: d,
            };
        },
        parser.StmtMatch(m) => {
            // Match on an Option/Result tag box: store the scrutinee once
            // in $__m<md>, then for each arm test the tag (load @0), bind
            // the payload (load @4) and run the body, branching to $mend
            // on a match. A wildcard arm runs unconditionally.
            var md: i32 = st.md;
            var mv: string = "$__m" + i32_to_string(md);
            var id: i32 = st.n;
            var mend: string = "$mend_" + i32_to_string(id);
            // Bump label counter + match depth so nested matches / loops
            // inside arm bodies use distinct labels + scrutinee temps.
            st = WState { ...st, n: id + 1, md: md + 1 };
            st = st.w("    (local.set " + mv + " " + emit_expr(m.scrutinee, st.cx, 0) + ")\n");
            st = st.w("    (block " + mend + "\n");
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        // Two dispatch schemes keyed on the variant name:
                        //   Option/Result (Some/Ok/None/Err): tag box —
                        //     compare tag@0, bind payload@4.
                        //   user struct union (type E = A | B): every
                        //     struct value carries its type id@0 — compare
                        //     id@0, bind the value itself.
                        var tag: i32 = variant_tag(pv.type_name);
                        var sid: i32 = struct_id(st.cx.structs, pv.type_name);
                        var nlabel: string = "$marm_" + i32_to_string(id) + "_" + i32_to_string(i);
                        st = st.w("    (block " + nlabel + "\n");
                        // `match (b) { true => …, false => … }`: the
                        // scrutinee is the bool value itself (not a tag box),
                        // so compare it directly. `true` skips when zero,
                        // `false` skips when non-zero.
                        if (pv.type_name == "true") {
                            st = st.w("    (br_if " + nlabel + " (i32.eqz (local.get " + mv + ")))\n");
                        } else if (pv.type_name == "false") {
                            st = st.w("    (br_if " + nlabel + " (local.get " + mv + "))\n");
                        } else if (tag >= 0) {
                            st = st.w("    (br_if " + nlabel + " (i32.ne (i32.load (local.get " + mv + ")) (i32.const " + i32_to_string(tag) + ")))\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                st = st.w("    (local.set $" + pv.binding + " (i32.load (i32.add (local.get " + mv + ") (i32.const 4))))\n");
                            }
                        } else if (sid >= 0) {
                            st = st.w("    (br_if " + nlabel + " (i32.ne (i32.load (local.get " + mv + ")) (i32.const " + i32_to_string(sid) + ")))\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                // An enum variant carries its payload in the
                                // synthetic `__ev` field at offset 4, so bind
                                // the payload; a struct-union variant
                                // (`type E = A | B`) binds the whole struct
                                // value (accessed via its named fields).
                                if (struct_field_index(st.cx.structs, pv.type_name, "__ev") >= 0) {
                                    st = st.w("    (local.set $" + pv.binding + " (i32.load (i32.add (local.get " + mv + ") (i32.const 4))))\n");
                                } else {
                                    st = st.w("    (local.set $" + pv.binding + " (local.get " + mv + "))\n");
                                }
                            }
                        }
                        st = emit_stmts(m.arms[i].body, st);
                        st = st.w("    (br " + mend + "))\n");
                    },
                    parser.PatWildcard(_) => {
                        st = emit_stmts(m.arms[i].body, st);
                        st = st.w("    (br " + mend + ")\n");
                    },
                }
                i = i + 1;
            }
            st = st.w("    )\n");
            return WState { ...st, md: md };
        },
        _ => {
            // Unsupported statement in this slice — emit nothing.
            return st;
        },
    }
    return st;
}

// is_string_expr decides whether an expression has string type, so the
// `+` operator can pick concat vs add. Conservative + structural: a
// literal, a string-typed local/param, a `+` with a string operand, or
// a call to a string-returning function.
function is_string_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(id) => {
            if (contains_str(cx.locals, id.name)) { return true; }
            return is_const_ref(cx, id.name) && zero_arg_func_ret(cx, id.name) == "string";
        },
        parser.ExprBinary(b) => {
            if (b.op == "+") {
                return is_string_expr(b.left, cx) || is_string_expr(b.right, cx);
            }
            return false;
        },
        parser.ExprIndex(ix) => {
            // arr[i] is string-typed when arr is a string array.
            return is_string_array_expr(ix.array, cx);
        },
        parser.ExprSlice(sl) => {
            // Slicing a string yields a string (a string[] slice yields a
            // string[], handled by is_string_array_expr).
            return is_string_expr(sl.array, cx);
        },
        parser.ExprFieldAccess(fa) => {
            // Tuple index `t.N` is string when element N is a string.
            if (is_all_digits(fa.field)) {
                return tuple_elem_is_string(fa.obj, digits_to_i32(fa.field), cx);
            }
            // s.f is string-typed when f is a `string` field.
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return struct_field_type(cx.structs, ot, fa.field) == "string";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return contains_str(cx.funcs, id.name); },
                parser.ExprFieldAccess(fa) => {
                    // The string-returning builtin methods.
                    if (fa.field == "to_upper" || fa.field == "to_lower" || fa.field == "repeat") {
                        return is_string_expr(fa.obj, cx);
                    }
                    // join always yields a string (array receiver).
                    if (fa.field == "join") { return true; }
                    // .to_string() always yields a string.
                    if (fa.field == "to_string") { return true; }
                    // get_or on a string-valued map yields a string.
                    if (fa.field == "get_or" && c.args.len() == 2 && is_str_val_map(fa.obj, cx)) { return true; }
                    // A receiver method declared to return string.
                    return method_ret(cx, struct_type_of(fa.obj, cx), fa.field) == "string";
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_string_array_expr decides whether an expression is a `string[]`: a
// string-typed local/param, an array literal whose elements are strings,
// or a call to a string[]-returning function.
function is_string_array_expr(e: parser.Expr, cx: Ctx): boolean {
    match (e) {
        parser.ExprIdent(id) => { return contains_str(cx.str_arrays, id.name); },
        parser.ExprArray(a) => {
            return a.elements.len() > 0 && is_string_expr(a.elements[0], cx);
        },
        parser.ExprSlice(sl) => {
            // A slice of a string[] is a string[].
            return is_string_array_expr(sl.array, cx);
        },
        parser.ExprFieldAccess(fa) => {
            // s.f is a string[] when f is a `string[]` field.
            var ot: string = struct_type_of(fa.obj, cx);
            if (ot.len() == 0) { return false; }
            return is_str_array_type(struct_field_type(cx.structs, ot, fa.field));
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // args() returns string[].
                    if (id.name == "args") { return true; }
                    return contains_str(cx.str_arr_funcs, id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    // s.split(sep) yields a string[].
                    if (fa.field == "split") { return is_string_expr(fa.obj, cx); }
                    // m.keys() on a string-keyed map / m.values() on a
                    // string-valued map yields a string[].
                    if (fa.field == "keys" && is_str_key_map(fa.obj, cx)) { return true; }
                    if (fa.field == "values" && is_str_val_map(fa.obj, cx)) { return true; }
                    // A receiver method declared to return string[].
                    return is_str_array_type(method_ret(cx, struct_type_of(fa.obj, cx), fa.field));
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// is_str_array_type is true for the `string[]` annotation (and its
// prefix `[string]`, which the parser normalises to `string[]`).
function is_str_array_type(t: string): boolean {
    return t == "string[]";
}

// collect_str_funcs returns the names of free functions declared to
// return `string` — call results of these are string-typed.
function collect_str_funcs(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].ret_type == "string") {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_str_arr_funcs returns the names of free functions declared to
// return `string[]`.
function collect_str_arr_funcs(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_str_array_type(mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_str_locals walks a function's params + body (in order,
// recursing if/while) collecting the names of string-typed locals: a
// `string` param, or a `var`/`let` whose annotation is `string` or whose
// initialiser is a string expression. Built incrementally so a later
// decl can depend on an earlier string local.
function collect_str_locals_stmts(body: parser.Stmt[], cx: Ctx): Ctx {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (comma_index(v.name) >= 0) {
                    // `var (a, b) = <tuple>` destructure: type each element
                    // that is a struct so `a.field` resolves (without this
                    // the field read falls back to a bogus `(i32.const 0)`).
                    var an: string = before_comma(v.name);
                    var at: string = tuple_elem_struct_type(v.init, 0, cx);
                    if (is_struct_type(cx.structs, at)) {
                        cx = Ctx { ...cx, sv_names: cx.sv_names.push(an), sv_types: cx.sv_types.push(at) };
                    }
                    var bn: string = after_comma(v.name);
                    var bt: string = tuple_elem_struct_type(v.init, 1, cx);
                    if (is_struct_type(cx.structs, bt)) {
                        cx = Ctx { ...cx, sv_names: cx.sv_names.push(bn), sv_types: cx.sv_types.push(bt) };
                    }
                } else {
                    // Record a tuple local's per-element kinds + struct types
                    // here (in statement order) so a later destructure of it
                    // can recover element types; collect_tuple_locals' guard
                    // then skips the already-recorded name.
                    match (v.init) {
                        parser.ExprTuple(t) => {
                            if (!contains_str(cx.tup_names, v.name)) {
                                cx = Ctx { ...cx, tup_names: cx.tup_names.push(v.name), tup_kinds: cx.tup_kinds.push(tuple_kind_string(t.elements, cx)), tup_svtypes: cx.tup_svtypes.push(tuple_svtypes_csv(t.elements, cx)) };
                            }
                        },
                        _ => {},
                    }
                    // 64-bit-element array local: `var xs: i64[] = …`, or a
                    // var bound to a wide-array expression (an i64[]/f64[]
                    // call, or a slice of a wide array). Tracked so index /
                    // for / push / slice use the 8-byte stride + i64/f64 op.
                    var akind: string = arr_kind_of_spelling(v.type_name);
                    if (akind == "i32") { akind = array_elem_kind(v.init, cx); }
                    if (akind == "i64" && !contains_str(cx.i64_arr_names, v.name)) {
                        cx = Ctx { ...cx, i64_arr_names: cx.i64_arr_names.push(v.name) };
                    } else if (akind == "f64" && !contains_str(cx.f64_arr_names, v.name)) {
                        cx = Ctx { ...cx, f64_arr_names: cx.f64_arr_names.push(v.name) };
                    }
                    // Option/Result-typed var → track its payload type so a
                    // later `match (v)` types the Some/Ok binding.
                    var optpay: string = parse_option_payload(v.type_name);
                    if (optpay.len() == 0) { optpay = scrutinee_payload(v.init, cx); }
                    var styp: string = base_type_name(v.type_name);
                    // Keep an enum-typed declaration as the enum name (so its
                    // methods dispatch); only fall back to the initializer's
                    // type when the declared type is neither struct nor enum.
                    if (!is_struct_type(cx.structs, styp) && !is_enum_type_name(cx, styp)) { styp = struct_type_of(v.init, cx); }
                    if (optpay.len() > 0) {
                        cx = Ctx { ...cx, ol_names: cx.ol_names.push(v.name), ol_payloads: cx.ol_payloads.push(optpay) };
                    } else if (is_struct_type(cx.structs, styp) || is_enum_type_name(cx, styp)) {
                        cx = Ctx { ...cx, sv_names: cx.sv_names.push(v.name), sv_types: cx.sv_types.push(styp) };
                    } else if (is_str_array_type(v.type_name) || is_string_array_expr(v.init, cx)) {
                        cx = Ctx { ...cx, str_arrays: cx.str_arrays.push(v.name) };
                    } else if (v.type_name == "string" || is_string_expr(v.init, cx)) {
                        cx = Ctx { ...cx, locals: cx.locals.push(v.name) };
                    }
                }
            },
            parser.StmtIf(f) => {
                cx = collect_str_locals_stmts(f.then_body, cx);
                cx = collect_str_locals_stmts(f.else_body, cx);
            },
            parser.StmtWhile(w) => {
                cx = collect_str_locals_stmts(w.body, cx);
            },
            parser.StmtFor(f) => {
                if (comma_index(f.var_name) >= 0) {
                    // `for (k, v) in m` — k is a string for a string-keyed
                    // map, v for a string-valued map.
                    if (is_str_key_map(f.iter, cx)) {
                        cx = Ctx { ...cx, locals: cx.locals.push(before_comma(f.var_name)) };
                    }
                    if (is_str_val_map(f.iter, cx)) {
                        cx = Ctx { ...cx, locals: cx.locals.push(after_comma(f.var_name)) };
                    }
                } else if (is_string_array_expr(f.iter, cx)) {
                    // A `for s in <string[]>` binds s as a string.
                    cx = Ctx { ...cx, locals: cx.locals.push(f.var_name) };
                } else {
                    // A `for p in <Struct[]>` binds p as that struct.
                    var set: string = struct_array_elem_type(f.iter, cx);
                    if (set.len() > 0) {
                        cx = Ctx { ...cx, sv_names: cx.sv_names.push(f.var_name), sv_types: cx.sv_types.push(set) };
                    }
                }
                cx = collect_str_locals_stmts(f.body, cx);
            },
            parser.StmtMatch(m) => {
                // Type each Some/Ok arm's binding with the scrutinee's
                // payload type (string / string[] / struct), so the arm
                // body's string/struct operations resolve.
                var pt: string = scrutinee_payload(m.scrutinee, cx);
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    match (m.arms[k].pattern) {
                        parser.PatVariant(pv) => {
                            if ((pv.type_name == "Some" || pv.type_name == "Ok") && pv.binding.len() > 0 && pv.binding != "_") {
                                if (pt == "string") {
                                    cx = Ctx { ...cx, locals: cx.locals.push(pv.binding) };
                                } else if (is_str_array_type(pt)) {
                                    cx = Ctx { ...cx, str_arrays: cx.str_arrays.push(pv.binding) };
                                } else if (is_struct_type(cx.structs, pt)) {
                                    cx = Ctx { ...cx, sv_names: cx.sv_names.push(pv.binding), sv_types: cx.sv_types.push(pt) };
                                }
                            } else if (is_struct_type(cx.structs, pv.type_name) && pv.binding.len() > 0 && pv.binding != "_") {
                                if (struct_field_index(cx.structs, pv.type_name, "__ev") >= 0) {
                                    // Enum-variant arm `Has(b)`: b is the
                                    // PAYLOAD (the `__ev` field), so type it as
                                    // the payload type. A primitive payload
                                    // (i32) is left unrecorded — struct_type_of
                                    // then returns "" and the primitive-method
                                    // dispatch handles `b.eq(…)`; a string
                                    // payload registers as a string local; a
                                    // struct/enum payload as its nominal type.
                                    var paytype: string = struct_field_type(cx.structs, pv.type_name, "__ev");
                                    if (paytype == "string") {
                                        cx = Ctx { ...cx, locals: cx.locals.push(pv.binding) };
                                    } else if (is_struct_type(cx.structs, paytype) || is_enum_type_name(cx, paytype)) {
                                        cx = Ctx { ...cx, sv_names: cx.sv_names.push(pv.binding), sv_types: cx.sv_types.push(paytype) };
                                    }
                                } else {
                                    // Struct-union arm `Variant(b)` binds b to
                                    // the value itself, typed as that struct.
                                    cx = Ctx { ...cx, sv_names: cx.sv_names.push(pv.binding), sv_types: cx.sv_types.push(pv.type_name) };
                                }
                            }
                        },
                        _ => {},
                    }
                    cx = collect_str_locals_stmts(m.arms[k].body, cx);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return cx;
}

function build_ctx(f: parser.FuncDecl, tab: StrTable, funcs: string[], str_arr_funcs: string[], structs: parser.StructDecl[], sf_names: string[], sf_types: string[], of_names: string[], of_payloads: string[], mr_types: string[], mr_names: string[], mr_rets: string[], i64_funcs: string[], mod_funcs: parser.FuncDecl[], f64_funcs: string[], lam_ctr: i32[], lamdefs: string[], cap_names: string[], cap_str: string[], cap_sv_names: string[], cap_sv_types: string[]): Ctx {
    // Every var/param name in this function (for lambda capture analysis).
    var all_locals: string[] = collect_locals(f.body, []);
    var alp: i32 = 0;
    while (alp < f.params.len()) {
        if (!contains_str(all_locals, f.params[alp].name)) { all_locals = all_locals.push(f.params[alp].name); }
        alp = alp + 1;
    }
    // A method's receiver is also a local in scope, so a lambda in the
    // method body can capture it (`return function() { … a.field … }`).
    if (f.receiver_name.len() > 0 && !contains_str(all_locals, f.receiver_name)) {
        all_locals = all_locals.push(f.receiver_name);
    }
    // Closure-typed locals/params: `fn` params + vars bound to a lambda
    // or to a call of a function that returns a closure. `fn[]` arrays of
    // closures let `var c = fns[i]` / `for f in fns` bind a closure too.
    var fn_arrs: string[] = collect_fn_arr_names(f.body, []);
    var fpa: i32 = 0;
    while (fpa < f.params.len()) {
        if (f.params[fpa].type_name == "fn[]" && !contains_str(fn_arrs, f.params[fpa].name)) {
            fn_arrs = fn_arrs.push(f.params[fpa].name);
        }
        fpa = fpa + 1;
    }
    var fn_names: string[] = collect_fn_var_names(f.body, [], fn_returning_func_names(mod_funcs), fn_returning_method_names(mod_funcs), fn_arrs);
    var fp: i32 = 0;
    while (fp < f.params.len()) {
        if (f.params[fp].type_name == "fn" && !contains_str(fn_names, f.params[fp].name)) {
            fn_names = fn_names.push(f.params[fp].name);
        }
        fp = fp + 1;
    }
    var locals: string[] = [];
    var str_arrays: string[] = [];
    var sv_names: string[] = [];
    var sv_types: string[] = [];
    var ol_names: string[] = [];
    var ol_payloads: string[] = [];
    // i64- / f64-typed params, plus the i64- / f64-declared names in the body.
    var i64_names: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "i64"), "i64", collect_i64_var_names(f.body, []));
    var f64_names: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "f64"), "f64", collect_f64_var_names(f.body, []));
    var map_names: string[] = collect_map_var_names(f.body, []);
    var pj: i32 = 0;
    while (pj < f.params.len()) {
        if (f.params[pj].type_name == "i64" && !contains_str(i64_names, f.params[pj].name)) {
            i64_names = i64_names.push(f.params[pj].name);
        }
        if (is_float_type(f.params[pj].type_name) && !contains_str(f64_names, f.params[pj].name)) {
            f64_names = f64_names.push(f.params[pj].name);
        }
        if (base_type_name(f.params[pj].type_name) == "Map" && !contains_str(map_names, f.params[pj].name)) {
            map_names = map_names.push(f.params[pj].name);
        }
        pj = pj + 1;
    }
    // A method's receiver is a struct-typed local (a generic receiver
    // `Box[T]` / `Box[i32]` strips to its base struct name).
    if (f.receiver_type.len() > 0) {
        sv_names = sv_names.push(f.receiver_name);
        sv_types = sv_types.push(base_type_name(f.receiver_type));
    }
    var i: i32 = 0;
    while (i < f.params.len()) {
        var pop: string = parse_option_payload(f.params[i].type_name);
        if (pop.len() > 0) {
            ol_names = ol_names.push(f.params[i].name);
            ol_payloads = ol_payloads.push(pop);
        } else if (is_str_array_type(f.params[i].type_name)) {
            str_arrays = str_arrays.push(f.params[i].name);
        } else if (is_struct_type(structs, base_type_name(f.params[i].type_name))) {
            // Generic instantiation `Box[i32]` / param `Box[T]` strips to
            // the base struct name `Box`.
            sv_names = sv_names.push(f.params[i].name);
            sv_types = sv_types.push(base_type_name(f.params[i].type_name));
        } else if (f.params[i].type_name == "string") {
            locals = locals.push(f.params[i].name);
        }
        i = i + 1;
    }
    // String captures type as string locals inside the lambda body.
    var csi: i32 = 0;
    while (csi < cap_str.len()) {
        if (!contains_str(locals, cap_str[csi])) { locals = locals.push(cap_str[csi]); }
        csi = csi + 1;
    }
    // Struct captures keep their struct type inside the lambda body, so
    // `cap.field` resolves the field offset (otherwise field reads emit a
    // bogus `(i32.const 0)`). The capture pointer itself is loaded from
    // the env box by the ExprIdent capture path.
    var cvi: i32 = 0;
    while (cvi < cap_sv_names.len()) {
        if (!contains_str(sv_names, cap_sv_names[cvi])) {
            sv_names = sv_names.push(cap_sv_names[cvi]);
            sv_types = sv_types.push(cap_sv_types[cvi]);
        }
        cvi = cvi + 1;
    }
    // 64-bit-element array params (i64[] / f64[]): seed the wide-array
    // name sets so index / for / push / slice use the 8-byte stride.
    var i64_arrs: string[] = [];
    var f64_arrs: string[] = [];
    var pa: i32 = 0;
    while (pa < f.params.len()) {
        if (f.params[pa].type_name == "i64[]") { i64_arrs = i64_arrs.push(f.params[pa].name); }
        if (f.params[pa].type_name == "f64[]" || f.params[pa].type_name == "f32[]") { f64_arrs = f64_arrs.push(f.params[pa].name); }
        pa = pa + 1;
    }
    var cx: Ctx = Ctx {
        tab: tab, locals: locals, funcs: funcs, str_arrays: str_arrays, str_arr_funcs: str_arr_funcs,
        structs: structs, sv_names: sv_names, sv_types: sv_types, sf_names: sf_names, sf_types: sf_types,
        of_names: of_names, of_payloads: of_payloads, ol_names: ol_names, ol_payloads: ol_payloads,
        mr_types: mr_types, mr_names: mr_names, mr_rets: mr_rets,
        i64_names: i64_names, i64_funcs: i64_funcs,
        ret_i64: f.ret_type == "i64", mod_funcs: mod_funcs,
        f64_names: f64_names, f64_funcs: f64_funcs,
        ret_f64: is_float_type(f.ret_type),
        map_names: map_names, map_str_names: [],
        map_str_key_names: collect_str_key_map_names(f.body, map_names, []),
        tup_names: [], tup_kinds: [], tup_svtypes: [],
        fn_names: fn_names, lam_ctr: lam_ctr, lamdefs: lamdefs,
        all_locals: all_locals, cap_names: cap_names,
        sa_names: [], sa_types: [],
        i64_arr_names: i64_arrs, f64_arr_names: f64_arrs,
        ret_arr_kind: arr_kind_of_spelling(f.ret_type),
    };
    // Struct-array locals (computed from the base cx so struct_type_of of
    // the array elements resolves) — needed before the string-locals pass
    // so a `for p in pts` over a struct array types p as a struct.
    cx = Ctx { ...cx, sa_names: collect_struct_array_names(f.body, cx, []), sa_types: collect_struct_array_types(f.body, cx, []) };
    // Struct-array params (e.g. `ts: Tk[]`) are struct-array locals too, so
    // `ts[i].field` / `for x in ts` resolve the element struct type.
    var san: string[] = cx.sa_names;
    var sat: string[] = cx.sa_types;
    var sap: i32 = 0;
    while (sap < f.params.len()) {
        var pt: string = f.params[sap].type_name;
        if (pt.len() > 2 && pt[pt.len() - 2:pt.len()] == "[]") {
            var pe: string = pt[0:pt.len() - 2];
            if (is_struct_type(structs, pe) && !contains_str(san, f.params[sap].name)) {
                san = san.push(f.params[sap].name);
                sat = sat.push(pe);
            }
        }
        sap = sap + 1;
    }
    cx = Ctx { ...cx, sa_names: san, sa_types: sat };
    // String-valued maps are needed during collect_str_locals_stmts (so a
    // `for v in m.values()` binds v as string). Seed them from
    // string-literal set values first (is_string_expr is accurate for
    // those even with no locals known), then run the string-locals pass,
    // then refine once more to catch string-local set values.
    var cx0: Ctx = Ctx { ...cx, map_str_names: collect_str_val_map_names(f.body, cx, map_names, []) };
    var cx2: Ctx = collect_str_locals_stmts(f.body, cx0);
    var cx3: Ctx = Ctx { ...cx2, map_str_names: collect_str_val_map_names(f.body, cx2, map_names, []) };
    // Tuple-local element kinds (after string locals are known).
    return collect_tuple_locals(f.body, cx3);
}

// collect_opt_func_names / _payloads: free functions returning
// Option[T] / Result[T, E], with their Some/Ok payload type T.
function collect_opt_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && parse_option_payload(mod.funcs[i].ret_type).len() > 0) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_method_* build the receiver-method registry (parallel arrays:
// receiver type, method name, return type).
function collect_method_types(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.push(base_type_name(mod.funcs[i].receiver_type)); }
        i = i + 1;
    }
    return out;
}

function collect_method_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.push(mod.funcs[i].name); }
        i = i + 1;
    }
    return out;
}

function collect_method_rets(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() > 0) { out = out.push(mod.funcs[i].ret_type); }
        i = i + 1;
    }
    return out;
}

function collect_opt_func_payloads(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0) {
            var p: string = parse_option_payload(mod.funcs[i].ret_type);
            if (p.len() > 0) { out = out.push(p); }
        }
        i = i + 1;
    }
    return out;
}

// collect_struct_funcs returns parallel arrays (names→struct return type)
// for free functions that return a declared struct.
function collect_struct_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_struct_type(mod.structs, mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

function collect_struct_func_types(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_struct_type(mod.structs, mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].ret_type);
        }
        i = i + 1;
    }
    return out;
}

// returns_value is true when a function's declared return type carries
// an i32-shaped value (i32 / boolean / …). The void / unannotated case
// emits no `(result …)` and no fallthrough constant.
function returns_value(ret_type: string): boolean {
    if (ret_type.len() == 0) { return false; }
    if (ret_type == "void") { return false; }
    return true;
}

// emit_lambda emits a lambda body as a top-level wasm function
// `$__lambda<idx>` with a leading `$__env` param (the closure box ptr,
// ignored by a non-capturing lambda) followed by the lambda's params.
// It reuses emit_func via a synthesised FuncDecl, threading the shared
// lambda cells so nested lambdas keep counting.
function emit_lambda(lm: parser.ExprLambda, idx: i32, cx: Ctx, caps: string[]): string {
    var ps: parser.ParamDecl[] = [];
    ps = ps.push(parser.ParamDecl { name: "__env", type_name: "i32" });
    var i: i32 = 0;
    while (i < lm.params.len()) {
        ps = ps.push(lm.params[i]);
        i = i + 1;
    }
    var rt: string = lm.ret_type;
    if (rt.len() == 0) { rt = "i32"; }
    var synth_tp: string[] = [];
    var synth: parser.FuncDecl = parser.FuncDecl {
        name: "__lambda" + i32_to_string(idx),
        receiver_name: "", receiver_type: "",
        type_params: synth_tp,
        params: ps, ret_type: rt, body: lm.body,
    };
    // Captures that were strings in the enclosing scope stay string-typed;
    // struct captures keep their struct type so `cap.field` resolves.
    var cap_str: string[] = [];
    var cap_sv_names: string[] = [];
    var cap_sv_types: string[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) {
        if (contains_str(cx.locals, caps[ci])) { cap_str = cap_str.push(caps[ci]); }
        var cst: string = struct_type_of(parser.ExprIdent { name: caps[ci] }, cx);
        if (cst.len() > 0) {
            cap_sv_names = cap_sv_names.push(caps[ci]);
            cap_sv_types = cap_sv_types.push(cst);
        }
        ci = ci + 1;
    }
    return emit_func(synth, cx.tab, cx.funcs, cx.str_arr_funcs, cx.structs, cx.sf_names, cx.sf_types, cx.of_names, cx.of_payloads, cx.mr_types, cx.mr_names, cx.mr_rets, cx.i64_funcs, cx.mod_funcs, cx.f64_funcs, cx.lam_ctr, cx.lamdefs, caps, cap_str, cap_sv_names, cap_sv_types);
}

// emit_func emits one wasm function. Params become wasm params (locals
// 0..n-1, referenced by `$name`); declared `var`/`let` names that aren't
// params become `(local …)` decls. An i32-returning function gets a
// trailing `(i32.const 0)` as the fallthrough result when no `return`
// fires.
function emit_func(f: parser.FuncDecl, tab: StrTable, str_funcs: string[], str_arr_funcs: string[], structs: parser.StructDecl[], sf_names: string[], sf_types: string[], of_names: string[], of_payloads: string[], mr_types: string[], mr_names: string[], mr_rets: string[], i64_funcs: string[], mod_funcs: parser.FuncDecl[], f64_funcs: string[], lam_ctr: i32[], lamdefs: string[], cap_names: string[], cap_str: string[], cap_sv_names: string[], cap_sv_types: string[]): string {
    // A receiver method `function (r: T) m(...)` emits as `$T__m` with the
    // receiver prepended as the first param; a free function as `$name`.
    var fname: string = f.name;
    var pnames: string[] = [];
    var head: string = "  (func $";
    if (f.receiver_type.len() > 0) {
        fname = base_type_name(f.receiver_type) + "__" + f.name;
        head = head + fname + " (param $" + f.receiver_name + " i32)";
        pnames = pnames.push(f.receiver_name);
    } else {
        head = head + fname;
    }
    // The i64- / f64-typed local/param sets drive both the (param/local …)
    // decls here and the typed instruction paths in Ctx.
    var i64_set: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "i64"), "i64", collect_i64_var_names(f.body, []));
    var f64_set: string[] = collect_wide_loop_vars(f.body, wide_array_param_names(f, "f64"), "f64", collect_f64_var_names(f.body, []));
    var i: i32 = 0;
    while (i < f.params.len()) {
        if (f.params[i].type_name == "i64") {
            head = head + " (param $" + f.params[i].name + " i64)";
            if (!contains_str(i64_set, f.params[i].name)) { i64_set = i64_set.push(f.params[i].name); }
        } else if (is_float_type(f.params[i].type_name)) {
            head = head + " (param $" + f.params[i].name + " f64)";
            if (!contains_str(f64_set, f.params[i].name)) { f64_set = f64_set.push(f.params[i].name); }
        } else {
            head = head + " (param $" + f.params[i].name + " i32)";
        }
        pnames = pnames.push(f.params[i].name);
        i = i + 1;
    }
    var has_result: boolean = returns_value(f.ret_type);
    var i64_result: boolean = f.ret_type == "i64";
    var f64_result: boolean = is_float_type(f.ret_type);
    if (has_result) {
        if (i64_result) { head = head + " (result i64)"; }
        else if (f64_result) { head = head + " (result f64)"; }
        else { head = head + " (result i32)"; }
    }
    head = head + "\n";

    var locals: string[] = collect_locals(f.body, []);
    // Reserved temps (one extra i32 local each, harmless): $__lit<d>
    // holds a fresh array/struct-literal pointer at literal-nesting depth
    // d (0..7); $__fi<d> / $__fa<d> are the loop index and iterated-array
    // pointer for a `for` at nesting depth d (0..3).
    var decls: string = "    (local $__lit0 i32) (local $__lit1 i32) (local $__lit2 i32) (local $__lit3 i32)\n";
    decls = decls + "    (local $__lit4 i32) (local $__lit5 i32) (local $__lit6 i32) (local $__lit7 i32)\n";
    decls = decls + "    (local $__fi0 i32) (local $__fi1 i32) (local $__fi2 i32) (local $__fi3 i32)\n";
    decls = decls + "    (local $__m0 i32) (local $__m1 i32) (local $__m2 i32) (local $__m3 i32)\n";
    decls = decls + "    (local $__fa0 i32) (local $__fa1 i32) (local $__fa2 i32) (local $__fa3 i32)\n";
    var li: i32 = 0;
    while (li < locals.len()) {
        if (!contains_str(pnames, locals[li]) && !is_reserved_local(locals[li])) {
            if (contains_str(i64_set, locals[li])) {
                decls = decls + "    (local $" + locals[li] + " i64)\n";
            } else if (contains_str(f64_set, locals[li])) {
                decls = decls + "    (local $" + locals[li] + " f64)\n";
            } else {
                decls = decls + "    (local $" + locals[li] + " i32)\n";
            }
        }
        li = li + 1;
    }

    var cx: Ctx = build_ctx(f, tab, str_funcs, str_arr_funcs, structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets, i64_funcs, mod_funcs, f64_funcs, lam_ctr, lamdefs, cap_names, cap_str, cap_sv_names, cap_sv_types);
    var st: WState = WState { out: "", n: 0, brk: "", cont: "", cx: cx, fd: 0, md: 0 };
    st = emit_stmts(f.body, st);

    var tail: string = "  )\n";
    if (has_result) {
        if (i64_result) { tail = "    (i64.const 0))\n"; }
        else if (f64_result) { tail = "    (f64.const 0))\n"; }
        else { tail = "    (i32.const 0))\n"; }
    }
    return head + decls + st.out + tail;
}

// module_uses_divrem is true when any free function body or the
// top-level statements contain a `/` or `%`.
function module_uses_divrem(mod: parser.Module): boolean {
    if (stmts_use_divrem(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_use_divrem(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_array / stmts_have_array / module_uses_arrays detect array
// literals anywhere, so the bump allocator is emitted for array-only
// programs (no strings).
function expr_has_array(e: parser.Expr): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprUnary(u) => { return expr_has_array(u.operand); },
        parser.ExprBinary(b) => { return expr_has_array(b.left) || expr_has_array(b.right); },
        parser.ExprIndex(ix) => { return expr_has_array(ix.array) || expr_has_array(ix.index); },
        parser.ExprSlice(_) => { return true; },
        parser.ExprTuple(_) => { return true; },
        parser.ExprLambda(_) => { return true; },
        parser.ExprFieldAccess(fa) => { return expr_has_array(fa.obj); },
        parser.ExprCall(c) => {
            if (expr_has_array(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_array(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

function stmts_have_array(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_array(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_array(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_array(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_array(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_array(f.cond)) { return true; }
                if (stmts_have_array(f.then_body)) { return true; }
                if (stmts_have_array(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_array(w.cond)) { return true; }
                if (stmts_have_array(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_array(f.iter)) { return true; }
                if (stmts_have_array(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_array(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_array(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_arrays(mod: parser.Module): boolean {
    if (stmts_have_array(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_array(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_struct / stmts_have_struct / module_uses_structs detect struct
// literals (which allocate), so the bump allocator is emitted for
// struct-using programs even without strings or arrays.
function expr_has_struct(e: parser.Expr): boolean {
    match (e) {
        parser.ExprStructLit(_) => { return true; },
        parser.ExprUnary(u) => { return expr_has_struct(u.operand); },
        parser.ExprBinary(b) => { return expr_has_struct(b.left) || expr_has_struct(b.right); },
        parser.ExprIndex(ix) => { return expr_has_struct(ix.array) || expr_has_struct(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_struct(fa.obj); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_has_struct(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            if (expr_has_struct(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_struct(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_have_struct(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_have_struct(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_struct(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_struct(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_struct(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_struct(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_struct(f.cond)) { return true; }
                if (stmts_have_struct(f.then_body)) { return true; }
                if (stmts_have_struct(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_struct(w.cond)) { return true; }
                if (stmts_have_struct(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_struct(f.iter)) { return true; }
                if (stmts_have_struct(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_struct(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_struct(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_structs(mod: parser.Module): boolean {
    if (stmts_have_struct(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_struct(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_has_option / module_uses_options detect Option/Result constructors
// (Some/Ok/Err calls, the None ident), which allocate a tag box — so the
// bump allocator is emitted for option/result-using programs.
function expr_has_option(e: parser.Expr): boolean {
    match (e) {
        parser.ExprIdent(id) => { return id.name == "None"; },
        parser.ExprUnary(u) => { return expr_has_option(u.operand); },
        parser.ExprBinary(b) => { return expr_has_option(b.left) || expr_has_option(b.right); },
        parser.ExprIndex(ix) => { return expr_has_option(ix.array) || expr_has_option(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_has_option(fa.obj); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_has_option(a.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (expr_has_option(sl.field_values[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (variant_tag(id.name) >= 0) { return true; }
                },
                _ => {},
            }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_has_option(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_have_option(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_have_option(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_has_option(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_has_option(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_has_option(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_has_option(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_has_option(f.cond)) { return true; }
                if (stmts_have_option(f.then_body)) { return true; }
                if (stmts_have_option(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_has_option(w.cond)) { return true; }
                if (stmts_have_option(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_has_option(f.iter)) { return true; }
                if (stmts_have_option(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_has_option(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_have_option(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_options(mod: parser.Module): boolean {
    if (stmts_have_option(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_have_option(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_calls / stmts_call / module_calls: does any expression call the
// free builtin named `fn` (by bare ident)? Used to gate runtime helpers
// like env().
function expr_calls(e: parser.Expr, fn: string): boolean {
    match (e) {
        parser.ExprUnary(u) => { return expr_calls(u.operand, fn); },
        parser.ExprBinary(b) => { return expr_calls(b.left, fn) || expr_calls(b.right, fn); },
        parser.ExprIndex(ix) => { return expr_calls(ix.array, fn) || expr_calls(ix.index, fn); },
        parser.ExprSlice(sl) => { return expr_calls(sl.array, fn) || expr_calls(sl.start, fn) || expr_calls(sl.end, fn); },
        parser.ExprTuple(tu) => {
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                if (expr_calls(tu.elements[ti], fn)) { return true; }
                ti = ti + 1;
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => { return expr_calls(fa.obj, fn); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_calls(a.elements[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                if (expr_calls(sl.field_values[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { if (id.name == fn) { return true; } },
                _ => {},
            }
            // Recurse the callee too — `args().len()` hides the args()
            // call inside the .len() field-access receiver.
            if (expr_calls(c.callee, fn)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_calls(c.args[i], fn)) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_call(lm.body, fn); },
        _ => { return false; },
    }
    return false;
}

function stmts_call(body: parser.Stmt[], fn: string): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_calls(v.init, fn)) { return true; } },
            parser.StmtAssign(a) => { if (expr_calls(a.value, fn)) { return true; } },
            parser.StmtReturn(r) => { if (expr_calls(r.value, fn)) { return true; } },
            parser.StmtExpr(e) => { if (expr_calls(e.value, fn)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_calls(f.cond, fn)) { return true; }
                if (stmts_call(f.then_body, fn)) { return true; }
                if (stmts_call(f.else_body, fn)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_calls(w.cond, fn)) { return true; }
                if (stmts_call(w.body, fn)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_calls(f.iter, fn)) { return true; }
                if (stmts_call(f.body, fn)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_calls(m.scrutinee, fn)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_call(m.arms[k].body, fn)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_calls(mod: parser.Module, fn: string): boolean {
    if (stmts_call(mod.top_stmts, fn)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_call(mod.funcs[i].body, fn)) { return true; }
        i = i + 1;
    }
    return false;
}

// collect_i64_var_names gathers the names of `var`/`let` bindings
// declared `i64` anywhere in a statement list (recursing nested bodies),
// so emit_func can declare them as i64 wasm locals and Ctx can route
// their uses through the i64 path.
// collect_wide_loop_vars finds the binding names of `for v in xs` loops
// whose iterated array has 64-bit elements, so the loop var is declared /
// typed as i64 / f64 (else the 8-byte element load would `local.set` an
// i64/f64 value into an i32 local). `kind` is "i64" or "f64"; `arrs` seeds
// the known wide-array names (params), and same-`kind` `var x: T[]` decls
// extend it in statement order as the walk descends.
function collect_wide_loop_vars(body: parser.Stmt[], arrs: string[], kind: string, acc: string[]): string[] {
    var declty: string = "i64[]";
    if (kind == "f64") { declty = "f64[]"; }
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if ((v.type_name == declty || (kind == "f64" && v.type_name == "f32[]")) && !contains_str(arrs, v.name)) {
                    arrs = arrs.push(v.name);
                }
            },
            parser.StmtFor(f) => {
                if (comma_index(f.var_name) < 0) {
                    match (f.iter) {
                        parser.ExprIdent(id) => {
                            if (contains_str(arrs, id.name) && !contains_str(acc, f.var_name)) { acc = acc.push(f.var_name); }
                        },
                        _ => {},
                    }
                }
                acc = collect_wide_loop_vars(f.body, arrs, kind, acc);
            },
            parser.StmtIf(f) => {
                acc = collect_wide_loop_vars(f.then_body, arrs, kind, acc);
                acc = collect_wide_loop_vars(f.else_body, arrs, kind, acc);
            },
            parser.StmtWhile(w) => { acc = collect_wide_loop_vars(w.body, arrs, kind, acc); },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_wide_loop_vars(m.arms[k].body, arrs, kind, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// wide_array_param_names returns the i64[] (kind "i64") or f64[]/f32[]
// (kind "f64") parameter names of a function.
function wide_array_param_names(f: parser.FuncDecl, kind: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < f.params.len()) {
        var t: string = f.params[i].type_name;
        if (kind == "i64" && t == "i64[]") { out = out.push(f.params[i].name); }
        if (kind == "f64" && (t == "f64[]" || t == "f32[]")) { out = out.push(f.params[i].name); }
        i = i + 1;
    }
    return out;
}

function collect_i64_var_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (v.type_name == "i64" && !contains_str(acc, v.name)) { acc = acc.push(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_i64_var_names(f.then_body, acc);
                acc = collect_i64_var_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_i64_var_names(w.body, acc);
            },
            parser.StmtFor(f) => {
                acc = collect_i64_var_names(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_i64_var_names(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

// collect_i64_func_names returns the names of free functions whose
// declared return type is i64.
function collect_i64_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].ret_type == "i64") {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// collect_f64_var_names / collect_f64_func_names mirror the i64 collectors
// for floating-point (f64 / f32 / float) bindings and return types.
function collect_f64_var_names(body: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                if (is_float_type(v.type_name) && !contains_str(acc, v.name)) { acc = acc.push(v.name); }
            },
            parser.StmtIf(f) => {
                acc = collect_f64_var_names(f.then_body, acc);
                acc = collect_f64_var_names(f.else_body, acc);
            },
            parser.StmtWhile(w) => {
                acc = collect_f64_var_names(w.body, acc);
            },
            parser.StmtFor(f) => {
                acc = collect_f64_var_names(f.body, acc);
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    acc = collect_f64_var_names(m.arms[k].body, acc);
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return acc;
}

function collect_f64_func_names(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].receiver_type.len() == 0 && is_float_type(mod.funcs[i].ret_type)) {
            out = out.push(mod.funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// module_uses_clocks is true when the program calls any clock builtin.
function module_uses_clocks(mod: parser.Module): boolean {
    return module_calls(mod, "now_unix_ms") || module_calls(mod, "monotonic_ns") || module_calls(mod, "now_ns");
}

// func_declares_i64 is true when a function signature or body involves an
// i64 value: an i64 return type, an i64 param, or an i64 local.
function func_declares_i64(f: parser.FuncDecl): boolean {
    if (f.ret_type == "i64") { return true; }
    var i: i32 = 0;
    while (i < f.params.len()) {
        if (f.params[i].type_name == "i64") { return true; }
        i = i + 1;
    }
    return collect_i64_var_names(f.body, []).len() > 0;
}

// expr_uses_i64_cast / stmts_use_i64_cast detect an `as i64` / `as u64`
// cast anywhere — such a cast yields an i64 value (and may feed
// print_int → print_int64) even with no i64-typed declaration, so it must
// also pull in the i64 runtime.
function expr_uses_i64_cast(e: parser.Expr): boolean {
    match (e) {
        parser.ExprUnary(u) => {
            if (u.op == "as_i64" || u.op == "as_u64") { return true; }
            return expr_uses_i64_cast(u.operand);
        },
        parser.ExprBinary(b) => {
            return expr_uses_i64_cast(b.left) || expr_uses_i64_cast(b.right);
        },
        parser.ExprCall(c) => {
            if (expr_uses_i64_cast(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_uses_i64_cast(c.args[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        parser.ExprIndex(ix) => { return expr_uses_i64_cast(ix.array) || expr_uses_i64_cast(ix.index); },
        parser.ExprFieldAccess(fa) => { return expr_uses_i64_cast(fa.obj); },
        parser.ExprLambda(lm) => { return stmts_use_i64_cast(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_use_i64_cast(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_uses_i64_cast(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_uses_i64_cast(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_uses_i64_cast(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_uses_i64_cast(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_uses_i64_cast(f.cond)) { return true; }
                if (stmts_use_i64_cast(f.then_body)) { return true; }
                if (stmts_use_i64_cast(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_uses_i64_cast(w.cond)) { return true; }
                if (stmts_use_i64_cast(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_uses_i64_cast(f.iter)) { return true; }
                if (stmts_use_i64_cast(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_uses_i64_cast(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmts_use_i64_cast(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// module_uses_i64 is true when the module touches i64 anywhere: a clock
// builtin call, any i64-typed return / param / local, or an `as i64` /
// `as u64` cast. Gates the i64 runtime (print_int64 + guarded div/rem)
// and the reserved scratch.
function module_uses_i64(mod: parser.Module): boolean {
    if (module_uses_clocks(mod)) { return true; }
    if (collect_i64_var_names(mod.top_stmts, []).len() > 0) { return true; }
    if (stmts_use_i64_cast(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (func_declares_i64(mod.funcs[i])) { return true; }
        if (stmts_use_i64_cast(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// stmt_calls_print_int / module_uses_print_int detect whether the
// program calls the print_int builtin (statement position; recursing
// if/while bodies), so the helper is emitted only when used.
function stmt_calls_print_int(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtExpr(e) => {
                match (e.value) {
                    parser.ExprCall(c) => {
                        match (c.callee) {
                            parser.ExprIdent(id) => {
                                if (id.name == "print_int") { return true; }
                            },
                            _ => {},
                        }
                        // A lambda passed as a call argument may print.
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            match (c.args[ai]) {
                                parser.ExprLambda(lm) => { if (stmt_calls_print_int(lm.body)) { return true; } },
                                _ => {},
                            }
                            ai = ai + 1;
                        }
                    },
                    _ => {},
                }
            },
            parser.StmtVar(v) => {
                // `var f = function(){ … print_int … }` — scan the body.
                match (v.init) {
                    parser.ExprLambda(lm) => { if (stmt_calls_print_int(lm.body)) { return true; } },
                    _ => {},
                }
            },
            parser.StmtIf(f) => {
                if (stmt_calls_print_int(f.then_body)) { return true; }
                if (stmt_calls_print_int(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (stmt_calls_print_int(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (stmt_calls_print_int(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (stmt_calls_print_int(m.arms[k].body)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_print_int(mod: parser.Module): boolean {
    if (stmt_calls_print_int(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmt_calls_print_int(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_uses_tostring / module_uses_tostring detect a `.to_string()` method
// call anywhere — so the integer→string runtime is emitted on demand.
function expr_uses_tostring(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => { if (fa.field == "to_string") { return true; } },
                _ => {},
            }
            if (expr_uses_tostring(c.callee)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) { if (expr_uses_tostring(c.args[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprBinary(b) => { return expr_uses_tostring(b.left) || expr_uses_tostring(b.right); },
        parser.ExprUnary(u) => { return expr_uses_tostring(u.operand); },
        parser.ExprFieldAccess(fa) => { return expr_uses_tostring(fa.obj); },
        parser.ExprIndex(ix) => { return expr_uses_tostring(ix.array) || expr_uses_tostring(ix.index); },
        parser.ExprSlice(sl) => { return expr_uses_tostring(sl.array) || expr_uses_tostring(sl.start) || expr_uses_tostring(sl.end); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (expr_uses_tostring(a.elements[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { if (expr_uses_tostring(t.elements[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base && expr_uses_tostring(sl.base)) { return true; }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { if (expr_uses_tostring(sl.field_values[i])) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprLambda(lm) => { return stmts_use_tostring(lm.body); },
        _ => { return false; },
    }
    return false;
}

function stmts_use_tostring(body: parser.Stmt[]): boolean {
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => { if (expr_uses_tostring(v.init)) { return true; } },
            parser.StmtAssign(a) => { if (expr_uses_tostring(a.value)) { return true; } },
            parser.StmtReturn(r) => { if (expr_uses_tostring(r.value)) { return true; } },
            parser.StmtExpr(e) => { if (expr_uses_tostring(e.value)) { return true; } },
            parser.StmtIf(f) => {
                if (expr_uses_tostring(f.cond)) { return true; }
                if (stmts_use_tostring(f.then_body)) { return true; }
                if (stmts_use_tostring(f.else_body)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (expr_uses_tostring(w.cond)) { return true; }
                if (stmts_use_tostring(w.body)) { return true; }
            },
            parser.StmtFor(f) => {
                if (expr_uses_tostring(f.iter)) { return true; }
                if (stmts_use_tostring(f.body)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (expr_uses_tostring(m.scrutinee)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) { if (stmts_use_tostring(m.arms[k].body)) { return true; } k = k + 1; }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_uses_tostring(mod: parser.Module): boolean {
    if (stmts_use_tostring(mod.top_stmts)) { return true; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (stmts_use_tostring(mod.funcs[i].body)) { return true; }
        i = i + 1;
    }
    return false;
}

// emit_module produces the full WAT text for a module: the proc_exit
// import + memory, the guarded div/rem helpers (when used), every free
// function (so calls + recursion + mutual recursion resolve by name),
// and a `_start` that calls `proc_exit(main())`. A program with no
// `main` function (bare top-level statements) synthesises one from the
// module's top statements.
// emit_module emits the default WASI-preview1 *command* core module
// (`_start` → `proc_exit(main())`, exit code = main()'s value).
pub function emit_module(mod: parser.Module): string {
    return emit_module_mode(mod, false, false, false);
}

// emit_module_run emits the Component-Model *run* core module: no preview1
// scaffold, exporting `main` and `_lang_run` (`() -> i32`, 0 = ok). It is
// the core component_full wraps into a `wasi:cli/run` component. Valid for
// programs that use no WASI I/O (otherwise the core would import preview1
// functions the component can't satisfy — that needs the preview2 I/O
// codegen).
pub function emit_module_run(mod: parser.Module): string {
    return emit_module_mode(mod, true, false, false);
}

// emit_module_run_io emits the Component-Model *run* core for programs that
// write to stdout: like emit_module_run, but importing the preview2 stdout
// interfaces (wasi:cli/stdout/get-stdout + wasi:io/streams/
// [method]output-stream.blocking-write-and-flush) and defining a $fd_write
// *shim* over them, so the existing fd_write call sites work unchanged.
// component_full_io wraps the result into a wasi:cli/run component.
pub function emit_module_run_io(mod: parser.Module): string {
    return emit_module_mode(mod, true, true, false);
}

// emit_module_run_io_fs emits the Component-Model run core for programs that
// read files + write stdout: like emit_module_run_io, plus the preview2
// filesystem read imports + a preview2 $__fern_read_file + cabi_realloc.
// component_full_io_fs wraps the result.
pub function emit_module_run_io_fs(mod: parser.Module): string {
    return emit_module_mode(mod, true, true, true);
}

function emit_module_mode(mod: parser.Module, component: boolean, io: boolean, fs: boolean): string {
    // Intern every string literal in the module into the data section.
    var tab: StrTable = new_str_table();
    tab = collect_strings_stmts(mod.top_stmts, tab);
    var si: i32 = 0;
    while (si < mod.funcs.len()) {
        tab = collect_strings_stmts(mod.funcs[si].body, tab);
        si = si + 1;
    }

    var has_strings: boolean = tab.values.len() > 0;
    var str_funcs: string[] = collect_str_funcs(mod);
    var str_arr_funcs: string[] = collect_str_arr_funcs(mod);
    var sf_names: string[] = collect_struct_func_names(mod);
    var sf_types: string[] = collect_struct_func_types(mod);
    var of_names: string[] = collect_opt_func_names(mod);
    var of_payloads: string[] = collect_opt_func_payloads(mod);
    var mr_types: string[] = collect_method_types(mod);
    var mr_names: string[] = collect_method_names(mod);
    var mr_rets: string[] = collect_method_rets(mod);

    var i64_funcs: string[] = collect_i64_func_names(mod);
    var f64_funcs: string[] = collect_f64_func_names(mod);

    var has_env: boolean = module_calls(mod, "env");
    var has_random: boolean = module_calls(mod, "random_bytes");
    var has_args: boolean = module_calls(mod, "args");
    var has_readfile: boolean = module_calls(mod, "read_file");
    var has_writefile: boolean = module_calls(mod, "write_file");
    var has_clocks: boolean = module_uses_clocks(mod);
    var has_wallclock: boolean = module_calls(mod, "now_unix_ms") || module_calls(mod, "now_ns");
    var has_monoclock: boolean = module_calls(mod, "monotonic_ns");
    var has_i64: boolean = module_uses_i64(mod);

    var out: string = "(module\n";
    // Component-run cores are import-free (no preview1 entry / output), so
    // a core-instance can `instantiate` them with no args; preview1 command
    // cores import proc_exit (for _start) + fd_write (for print/write).
    if (!component) {
        out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n";
        out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n";
    }
    // Preview2 stdout imports (component-io mode): get-stdout returns an
    // output-stream handle; blocking-write-and-flush writes a (ptr,len)
    // list<u8>, its result going to the 4th (return-area) arg.
    if (component && io) {
        out = out + "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $get_stdout (result i32)))\n";
        out = out + "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $bwf (param i32 i32 i32 i32)))\n";
    }
    // component-io-fs: the preview2 filesystem imports (read and/or write).
    if (fs) { out = out + fs_imports_p2(has_readfile, has_writefile); }
    // wasi imports must sit in the import section (before funcs).
    if (has_env) { if (io) { out = out + env_imports_p2(); } else { out = out + env_helpers(); } }
    if (has_random) { if (io) { out = out + random_imports_p2(); } else { out = out + random_helpers(); } }
    if (has_args) { if (io) { out = out + args_imports_p2(); } else { out = out + args_helpers(); } }
    if ((has_readfile || has_writefile) && !fs) { out = out + file_imports(); }
    if (has_clocks) { if (io) { out = out + clock_imports_p2(has_wallclock, has_monoclock); } else { out = out + clock_imports(); } }
    // 16 pages (1 MiB) gives the bump heap (string concat) headroom.
    out = out + "  (memory (export \"memory\") 16)\n";
    // Scratch: a "\n" byte at addr 12 (for `print`); the iovec (0,4) and
    // nwritten (8) slots are written at runtime.
    out = out + "  (data (i32.const 12) \"\\0a\")\n";
    // Each literal is a `[len:i32 LE][bytes]` block at its interned
    // offset; the string value is a pointer to the block.
    var di: i32 = 0;
    while (di < tab.values.len()) {
        out = out + "  (data (i32.const " + i32_to_string(tab.offsets[di]) + ") \""
            + le32_escape(tab.values[di].len()) + wat_escape(tab.values[di]) + "\")\n";
        di = di + 1;
    }
    if (module_uses_divrem(mod)) {
        out = out + divrem_helpers();
    }
    // The print_int scratch buffer sits just above all string data.
    if (module_uses_print_int(mod)) {
        out = out + print_int_helper(tab.next);
    }
    // i64 runtime: the guarded 64-bit div/rem, the clock builtins, and the
    // i64 decimal formatter. print_int64 formats into a 24-byte buffer at
    // tab.next + 16 (just above the 16-byte print_int buffer).
    if (has_i64) {
        out = out + divrem64_helpers();
        out = out + print_int64_helper(tab.next + 16);
    }
    if (has_clocks) {
        if (io) { out = out + clock_funcs_p2(has_wallclock, has_monoclock); } else { out = out + clock_funcs(); }
    }
    // The bump heap (for string concat + array allocation) starts above
    // all static data: past the blocks, the 16-byte print_int buffer, and
    // (when i64 is used) the 24-byte print_int64 buffer.
    var heap_extra: i32 = 0;
    if (has_i64) { heap_extra = 24; }
    var has_arrays: boolean = module_uses_arrays(mod);
    var has_structs: boolean = module_uses_structs(mod);
    // Enum-constant access (`Color.Green`) builds a variant box but isn't a
    // struct literal, so gate the heap on any struct/enum declaration too.
    if (mod.structs.len() > 0) { has_structs = true; }
    var has_options: boolean = module_uses_options(mod);
    var has_maps: boolean = module_calls(mod, "map_new_i32") || module_calls(mod, "map_new");
    var has_tostring: boolean = module_uses_tostring(mod);
    if (has_strings || has_arrays || has_structs || has_options || has_env || has_random || has_args || has_readfile || has_writefile || has_maps || has_tostring || (component && io)) {
        out = out + heap_alloc_helpers(tab.next + 16 + heap_extra);
    }
    // component-io: the $fd_write shim over the preview2 stdout stream, so
    // every fd_write call site (print / write / print_int) works unchanged.
    if (component && io) {
        out = out + stdout_shim_helpers();
    }
    // The string runtime is needed for string literals AND for the string
    // values that env() / args() produce; the map runtime's key-equality
    // helper references $__fern_streq, so any map use needs it too.
    if (has_strings || has_env || has_args || has_readfile || has_writefile || has_maps || has_tostring) {
        out = out + strcat_helpers();
    }
    // The integer→string runtime backs `.to_string()` (f-string lowering).
    if (has_tostring) {
        out = out + to_string_helpers();
    }
    // arr_helpers (push) is also needed by string `split`, which builds
    // its result array via $__fern_arr_push — so emit it for strings too
    // (and for maps, which pull in the string runtime for key compare).
    if (has_arrays || has_strings || has_env || has_args || has_readfile || has_writefile || has_maps || has_tostring) {
        out = out + arr_helpers();
    }
    if (has_maps) {
        out = out + map_helpers();
    }
    if (has_env) {
        if (io) { out = out + env_func_p2(); } else { out = out + env_func(); }
    }
    if (has_random) {
        if (io) { out = out + random_func_p2(); } else { out = out + random_func(); }
    }
    if (has_args) {
        if (io) { out = out + args_func_p2(); } else { out = out + args_func(); }
    }
    if (has_readfile) {
        if (fs) { out = out + readfile_func_p2(); } else { out = out + readfile_func(); }
    }
    if (has_writefile) {
        if (fs) { out = out + writefile_func_p2(); } else { out = out + writefile_func(); }
    }
    // component-io-fs: the canonical-ABI realloc the fs lists need.
    if (fs || (io && (has_env || has_args))) { out = out + cabi_realloc_helper(); }

    // Shared lambda cells (1-element arrays, mutated in place so the index
    // counter + accumulated $__lambda<i> defs persist across every
    // function's emission).
    var lam_ctr: i32[] = [0];
    var lamdefs: string[] = [""];

    var has_main: boolean = false;
    var j: i32 = 0;
    while (j < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[j];
        // Emit free functions and receiver methods alike; emit_func
        // mangles a method's name to `$<RecvType>__<name>`.
        out = out + emit_func(f, tab, str_funcs, str_arr_funcs, mod.structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets, i64_funcs, mod.funcs, f64_funcs, lam_ctr, lamdefs, [], [], [], []);
        if (f.receiver_type.len() == 0 && f.name == "main") { has_main = true; }
        j = j + 1;
    }

    if (!has_main) {
        var noparams: parser.ParamDecl[] = [];
        var notp: string[] = [];
        var synth: parser.FuncDecl = parser.FuncDecl {
            name: "main",
            receiver_name: "",
            receiver_type: "",
            type_params: notp,
            params: noparams,
            ret_type: "i32",
            body: mod.top_stmts,
        };
        out = out + emit_func(synth, tab, str_funcs, str_arr_funcs, mod.structs, sf_names, sf_types, of_names, of_payloads, mr_types, mr_names, mr_rets, i64_funcs, mod.funcs, f64_funcs, lam_ctr, lamdefs, [], [], [], []);
    }

    // Closure support: the accumulated lambda functions, the shared
    // call_indirect signature types ($clos<N> = env + N i32 args → i32),
    // and the function table + elem segment indexing them.
    if (lam_ctr[0] > 0) {
        var ai: i32 = 0;
        while (ai <= 8) {
            out = out + "  (type $clos" + i32_to_string(ai) + " (func (param i32";
            var pj: i32 = 0;
            while (pj < ai) { out = out + " i32"; pj = pj + 1; }
            out = out + ") (result i32)))\n";
            ai = ai + 1;
        }
        out = out + lamdefs[0];
        out = out + "  (table " + i32_to_string(lam_ctr[0]) + " funcref)\n";
        out = out + "  (elem (i32.const 0)";
        var ei: i32 = 0;
        while (ei < lam_ctr[0]) {
            out = out + " $__lambda" + i32_to_string(ei);
            ei = ei + 1;
        }
        out = out + ")\n";
    }

    if (component) {
        // Component run entry: export main, and _lang_run = (main() == 0)
        // mapped to the 0=ok / 1=err result the canon lift expects.
        out = out + "  (export \"main\" (func $main))\n";
        out = out + "  (func $_lang_run (result i32) (i32.eqz (i32.eqz (call $main))))\n";
        out = out + "  (export \"_lang_run\" (func $_lang_run)))\n";
    } else {
        out = out + "  (func $_start (call $proc_exit (call $main)))\n";
        out = out + "  (export \"_start\" (func $_start)))\n";
    }
    return out;
}
