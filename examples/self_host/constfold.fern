// examples/self_host/constfold.fern — sixth concrete step of the
// self-host port. First AST→AST transformation: walks a
// parser.Module and replaces every constant sub-expression with
// a single literal node. `1 + 2 * 3` becomes `7` before the
// checker / interp / codegen ever sees the binary tree.
//
// Up to now every layer (checker, interp, printer) has been an
// AST consumer — pattern-match each variant, do something, never
// produce new tree nodes. This one rebuilds the tree, folding
// where it can, copying where it can't. That's the pattern the
// real Go pipeline uses for monomorph / closureconv / treeshake /
// the production constfold pass.
//
// Scope:
//   - i32 arithmetic: + - * / %     (skips / and % on zero
//     divisor; leaves the original binary node so the runtime
//     can surface the error)
//   - i32 comparisons: < <= > >= == !=  →  bool literal
//   - bool: && ||  →  bool literal (no short-circuit because we
//     fold only when both sides are already constant; partial-
//     constant short-circuit is a later pass)
//   - bool: !   →  bool literal
//   - i32 unary `-` →  i32 literal
//   - String concatenation `a + b` when both sides are literals
//   - Recurses through every container variant (Call args, Array
//     elements, Index, If cond/branches, While cond/body, etc.)
//     so nested foldings cascade in a single pass.

import "./lexer";
import "./parser";
import "./util";
import "./astwalk";

// =================== INT / FOLD HELPERS ====================

// Parse the digit run captured by the lexer back into an i32.
// No suffix handling — same simplification the interp uses.
// digits_to_i32 now lives in util.fern (imported as `util`). See SH-020.

// i32_to_string now lives in util.fern (imported as `util`); the
// fold uses util.i32_to_string to render a folded literal. See SH-020.

function lit_i32(n: i32): parser.Expr {
    return parser.ExprNumber { text: util.i32_to_string(n), suffix: "", raw: "", is_float: false, line: 0, col: 0 };
}

function lit_bool(b: boolean): parser.Expr {
    return parser.ExprBool { value: b };
}

function lit_string(s: string): parser.Expr {
    return parser.ExprString { value: s, line: 0, col: 0 };
}

// Optional-Int sentinel: Fern-port has no Option in the stdlib
// (no generics in our parser stub). Encode "absent" as the
// boolean `ok` field; consumers check that first.
struct OptInt { ok: boolean, v: i32 }

function as_int_lit(e: parser.Expr): OptInt {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return OptInt { ok: false, v: 0 }; }
            // lit_to_i32 (hex/binary-aware): digits_to_i32 stopped at the
            // `x`/`b` prefix and read every `0x`/`0b` operand as 0, so `-O`
            // mis-folded `0x10 + 1` to 1 (#4341, constfold sibling).
            return OptInt { ok: true, v: util.lit_to_i32(n.text) };
        },
        _ => { return OptInt { ok: false, v: 0 }; }
    }
    return OptInt { ok: false, v: 0 };
}

struct OptBool { ok: boolean, v: boolean }

function as_bool_lit(e: parser.Expr): OptBool {
    match (e) {
        parser.ExprBool(b) => { return OptBool { ok: true, v: b.value }; },
        _ => { return OptBool { ok: false, v: false }; }
    }
    return OptBool { ok: false, v: false };
}

struct OptString { ok: boolean, v: string }

function as_string_lit(e: parser.Expr): OptString {
    match (e) {
        parser.ExprString(s) => { return OptString { ok: true, v: s.value }; },
        _ => { return OptString { ok: false, v: "" }; }
    }
    return OptString { ok: false, v: "" };
}

// =================== EXPR FOLDING ====================

// fold_expr returns a possibly-rewritten expression. The output
// has the same parser.Expr shape; what may change is "constants
// folded one level up." Multiple passes aren't needed — the
// post-order walk means children fold first, so by the time we
// look at a parent binary node both operands are already in
// their folded form.
pub function fold_expr(e: parser.Expr): parser.Expr {
    return astwalk.map_expr(e, fold_node);
}

// fold_node is this pass minus the walk: one node, whose children the
// post-order map has already folded, collapsed to a literal when it can be.
// Only the two arithmetic shapes contribute; every other node is its own
// rebuilt form.
function fold_node(e: parser.Expr): parser.Expr {
    match (e) {
        parser.ExprBinary(b) => { return fold_binary(b.op, b.left, b.right); },
        parser.ExprUnary(u) => { return fold_unary(u.op, u.operand); },
        _ => { return e; }
    }
    return e;
}

function fold_binary(op: string, lhs: parser.Expr, rhs: parser.Expr): parser.Expr {
    // i32 arithmetic + comparison + equality.
    var li: OptInt = as_int_lit(lhs);
    var ri: OptInt = as_int_lit(rhs);
    if (li.ok && ri.ok) {
        if (op == "+") { return lit_i32(li.v + ri.v); }
        if (op == "-") { return lit_i32(li.v - ri.v); }
        if (op == "*") { return lit_i32(li.v * ri.v); }
        if (op == "/") {
            if (ri.v == 0) { return parser.ExprBinary { op: op, left: lhs, right: rhs, line: 0, col: 0 }; }
            return lit_i32(li.v / ri.v);
        }
        if (op == "%") {
            if (ri.v == 0) { return parser.ExprBinary { op: op, left: lhs, right: rhs, line: 0, col: 0 }; }
            return lit_i32(li.v % ri.v);
        }
        if (op == "<") { return lit_bool(li.v < ri.v); }
        if (op == "<=") { return lit_bool(li.v <= ri.v); }
        if (op == ">") { return lit_bool(li.v > ri.v); }
        if (op == ">=") { return lit_bool(li.v >= ri.v); }
        if (op == "==") { return lit_bool(li.v == ri.v); }
        if (op == "!=") { return lit_bool(li.v != ri.v); }
    }
    // bool && / ||.
    var lb: OptBool = as_bool_lit(lhs);
    var rb: OptBool = as_bool_lit(rhs);
    if (lb.ok && rb.ok) {
        if (op == "&&") { return lit_bool(lb.v && rb.v); }
        if (op == "||") { return lit_bool(lb.v || rb.v); }
        if (op == "==") { return lit_bool(lb.v == rb.v); }
        if (op == "!=") { return lit_bool(lb.v != rb.v); }
    }
    // String concatenation when both sides are literals.
    var ls: OptString = as_string_lit(lhs);
    var rs: OptString = as_string_lit(rhs);
    if (ls.ok && rs.ok) {
        if (op == "+") { return lit_string(ls.v + rs.v); }
        if (op == "==") { return lit_bool(ls.v == rs.v); }
        if (op == "!=") { return lit_bool(ls.v != rs.v); }
    }
    // Nothing to fold — rebuild with folded children.
    return parser.ExprBinary { op: op, left: lhs, right: rhs, line: 0, col: 0 };
}

function fold_unary(op: string, operand: parser.Expr): parser.Expr {
    if (op == "-") {
        var oi: OptInt = as_int_lit(operand);
        if (oi.ok) { return lit_i32(0 - oi.v); }
    }
    if (op == "!") {
        var ob: OptBool = as_bool_lit(operand);
        if (ob.ok) { return lit_bool(!ob.v); }
    }
    return parser.ExprUnary { op: op, operand: operand, line: 0, col: 0 };
}

// =================== STMT / MODULE FOLDING ====================

function fold_stmt(st: parser.Stmt): parser.Stmt {
    return astwalk.map_stmt(st, fold_node);
}

function fold_block(body: parser.Stmt[]): parser.Stmt[] {
    return astwalk.map_stmts(body, fold_node);
}

pub function fold_module(mod: parser.Module): parser.Module {
    var funcs: parser.FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[i];
        funcs = funcs.append(parser.FuncDecl {
            name: fd.name,
            receiver_name: fd.receiver_name,
            receiver_type: fd.receiver_type,
            type_params: fd.type_params,
            params: fd.params,
            ret_type: fd.ret_type,
            body: fold_block(fd.body),
            line: fd.line, col: fd.col,
            import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: [], fip: fd.fip, fbip: fd.fbip, fip_allowance: fd.fip_allowance, ret_str: fd.ret_str, async: fd.async,
            is_pub: fd.is_pub
       , is_const: fd.is_const });
        i = i + 1;
    }
    return parser.Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: fold_block(mod.top_stmts), enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls };
}

// =================== VALIDATION ====================

// Convenience: parse a source, fold, return the folded module.
function fold_source(src: string): parser.Module {
    return fold_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // `1 + 2 * 3` should fold to literal 7. Verify the var
    // init is a single ExprNumber whose text reads "7".
    var mod1: parser.Module = fold_source("var a = 1 + 2 * 3; return a;");
    match (mod1.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "7") { return 10; } },
                _ => { return 11; }
            }
        },
        _ => { return 12; }
    }

    // `(1 + 2) * 3` folds to 9.
    var mod2: parser.Module = fold_source("var a = (1 + 2) * 3; return a;");
    match (mod2.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "9") { return 20; } },
                _ => { return 21; }
            }
        },
        _ => { return 22; }
    }

    // Comparison folds to bool: `5 < 10` → true.
    var mod3: parser.Module = fold_source("var b = 5 < 10; return 0;");
    match (mod3.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBool(b) => { if (!b.value) { return 30; } },
                _ => { return 31; }
            }
        },
        _ => { return 32; }
    }

    // Boolean: `true && false` → false. `!true` → false.
    var mod4: parser.Module = fold_source("var a = true && false; var b = !true; return 0;");
    match (mod4.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBool(b) => { if (b.value) { return 40; } },
                _ => { return 41; }
            }
        },
        _ => { return 42; }
    }
    match (mod4.top_stmts[1]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBool(b) => { if (b.value) { return 43; } },
                _ => { return 44; }
            }
        },
        _ => { return 45; }
    }

    // String concat folds: `"hi " + "there"` → single ExprString.
    var mod5: parser.Module = fold_source("var s = \"hi \" + \"there\"; return 0;");
    match (mod5.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprString(s) => { if (s.value != "hi there") { return 50; } },
                _ => { return 51; }
            }
        },
        _ => { return 52; }
    }

    // Non-constant operand prevents folding: `1 + x` stays as
    // an ExprBinary. Confirms the pass leaves unknowns alone.
    var mod6: parser.Module = fold_source("var a = 1 + x; return 0;");
    match (mod6.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "+") { return 60; } },
                _ => { return 61; }
            }
        },
        _ => { return 62; }
    }

    // Division by zero stays unfolded (the runtime should surface
    // the error, not the folder).
    var mod7: parser.Module = fold_source("var a = 1 / 0; return 0;");
    match (mod7.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "/") { return 70; } },
                _ => { return 71; }
            }
        },
        _ => { return 72; }
    }

    // Nested foldings cascade: `(2 + 3) * (4 + 5)` → 45 in one pass.
    var mod8: parser.Module = fold_source("var a = (2 + 3) * (4 + 5); return 0;");
    match (mod8.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "45") { return 80; } },
                _ => { return 81; }
            }
        },
        _ => { return 82; }
    }

    // Folds inside function-decl bodies too.
    var mod9: parser.Module = fold_source("function add(): i32 { return 1 + 2; } function main(): i32 { return add(); }");
    if (mod9.funcs.len() != 2) { return 90; }
    match (mod9.funcs[0].body[0]) {
        parser.StmtReturn(r) => {
            match (r.value) {
                parser.ExprNumber(n) => { if (n.text != "3") { return 91; } },
                _ => { return 92; }
            }
        },
        _ => { return 93; }
    }

    return 0;
}
