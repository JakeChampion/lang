// examples/self_host/constfold.fern — sixth concrete step of the
// self-host port. First AST→AST transformation: walks a
// parser.Module and replaces every constant sub-expression with
// a single literal node. `1 + 2 * 3` becomes `7` before the
// checker / interp / codegen ever sees the binary tree.
//
// Up to now every layer (checker, interp, printer) has been an
// AST consumer — pattern-match each variant, do something, never
// produce new tree nodes. This one rebuilds the tree, folding
// where it can, copying where it can't. That's the pattern the
// real Go pipeline uses for monomorph / closureconv / treeshake /
// the production constfold pass.
//
// Scope:
//   - integer arithmetic: + - * / %  (skips / and % on zero
//     divisor; leaves the original binary node so the runtime
//     can surface the error)
//   - integer comparisons: < <= > >= == !=  →  bool literal
//   - bool: && ||  →  bool literal (no short-circuit because we
//     fold only when both sides are already constant; partial-
//     constant short-circuit is a later pass)
//   - bool: !   →  bool literal
//   - integer unary `-` →  integer literal
//   - String concatenation `a + b` when both sides are literals
//   - Recurses through every container variant (Call args, Array
//     elements, Index, If cond/branches, While cond/body, etc.)
//     so nested foldings cascade in a single pass.
//
// Arithmetic is evaluated in i64 and the operands' declared width decides
// whether the answer may be emitted — see fits. This pass runs on EVERY
// build, so a fold that changes the answer is a miscompile.

import "./lexer";
import "./parser";
import "./util";
import "./astwalk";

// =================== INT / FOLD HELPERS ====================

// A folded literal is built in the shape the PARSER produces. A number
// literal's TEXT never carries a sign — irlower.literal_is_i64 classifies by
// its LENGTH and says so — so a negative result is unary minus over the
// magnitude, exactly as `-5` is parsed. Emitting the sign inline made an
// 11-character "-2147483648", which literal_is_i64 read as an i64 and the i32
// return path then declined: `return 0 - 2147483647 - 1`, which is how std/i32
// spells i32::MIN because it is the only way to spell it, stopped lowering.
//
// The magnitude comes from i64_to_string with its sign stripped rather than
// from negating the value, so INT64_MIN — which has no negation — needs no
// case of its own.
function lit_int(v: i64, suffix: string): parser.Expr {
    var s: string = util.i64_to_string(v);
    if (v >= 0) { return num_lit(s, suffix); }
    return parser.ExprUnary { op: "-", operand: num_lit(s[1:s.len()], suffix), line: 0, col: 0 };
}

function num_lit(text: string, suffix: string): parser.Expr {
    return parser.ExprNumber { text: text, suffix: suffix, raw: "", is_float: false, line: 0, col: 0 };
}

// fits reports whether `v` is representable in the type a literal's SUFFIX
// names. Folding runs on every build, over ordinary user arithmetic, so a fold
// that changes the answer is a miscompile rather than a missed optimisation:
// `2147484527u32 % 861u32` is 713, and reading those operands as signed i32
// answered -677 (#6261's fixture, which this predicate is what keeps green).
//
// i64 / u64 are declined rather than folded in range. Downstream, a literal's
// width is re-derived from its text LENGTH (irlower.literal_is_i64), so a
// folded 64-bit result would be re-read at whatever width its digit count
// implies — an answer this pass cannot control. Floats are not integers, and a
// char literal carries its source spelling in `raw`, which a rebuilt literal
// would lose. Declining leaves the runtime op, which is always right.
function fits(v: i64, suffix: string): boolean {
    if (suffix == "" || suffix == "i32") { return v >= 0 - 2147483648i64 && v <= 2147483647i64; }
    if (suffix == "u32") { return v >= 0 && v <= 4294967295i64; }
    if (suffix == "u8") { return v >= 0 && v <= 255i64; }
    return false;
}

function lit_bool(b: boolean): parser.Expr {
    return parser.ExprBool { value: b };
}

function lit_string(s: string): parser.Expr {
    return parser.ExprString { value: s, line: 0, col: 0 };
}

// Optional-Int sentinel: Fern-port has no Option in the stdlib
// (no generics in our parser stub). Encode "absent" as the
// boolean `ok` field; consumers check that first. The value is i64 and the
// literal's suffix rides alongside, because folding has to know the declared
// width to decide whether its answer is representable — see fits.
struct OptInt { ok: boolean, v: i64, suffix: string }

function as_int_lit(e: parser.Expr): OptInt {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return OptInt { ok: false, v: 0, suffix: "" }; }
            // lit_to_i64 (hex/binary-aware): digits_to_i32 stopped at the
            // `x`/`b` prefix and read every `0x`/`0b` operand as 0, so `-O`
            // mis-folded `0x10 + 1` to 1 (#4341, constfold sibling). The i64
            // accumulation is what lets fits see a u32-range literal's real
            // value instead of the wrapped one.
            return OptInt { ok: true, v: util.lit_to_i64(n.text), suffix: n.suffix };
        },
        parser.ExprUnary(u) => {
            // The negated form lit_int produces, so a chain still folds all the
            // way: `0 - 2147483647 - 1` needs the inner fold's result to be
            // readable by the outer one.
            if (u.op == "-") {
                var inner: OptInt = as_int_lit(u.operand);
                if (inner.ok) { return OptInt { ok: true, v: 0 - inner.v, suffix: inner.suffix }; }
            }
            return OptInt { ok: false, v: 0, suffix: "" };
        },
        _ => { return OptInt { ok: false, v: 0, suffix: "" }; }
    }
    return OptInt { ok: false, v: 0, suffix: "" };
}

struct OptBool { ok: boolean, v: boolean }

function as_bool_lit(e: parser.Expr): OptBool {
    match (e) {
        parser.ExprBool(b) => { return OptBool { ok: true, v: b.value }; },
        _ => { return OptBool { ok: false, v: false }; }
    }
    return OptBool { ok: false, v: false };
}

struct OptString { ok: boolean, v: string }

function as_string_lit(e: parser.Expr): OptString {
    match (e) {
        parser.ExprString(s) => { return OptString { ok: true, v: s.value }; },
        _ => { return OptString { ok: false, v: "" }; }
    }
    return OptString { ok: false, v: "" };
}

// =================== EXPR FOLDING ====================

// fold_expr returns a possibly-rewritten expression. The output
// has the same parser.Expr shape; what may change is "constants
// folded one level up." Multiple passes aren't needed — the
// post-order walk means children fold first, so by the time we
// look at a parent binary node both operands are already in
// their folded form.
pub function fold_expr(e: parser.Expr): parser.Expr {
    return astwalk.map_expr(e, fold_node);
}

// fold_node is this pass minus the walk: one node, whose children the
// post-order map has already folded, collapsed to a literal when it can be.
// Only the two arithmetic shapes contribute; every other node is its own
// rebuilt form.
function fold_node(e: parser.Expr): parser.Expr {
    match (e) {
        parser.ExprBinary(b) => { return fold_binary(b.op, b.left, b.right); },
        parser.ExprUnary(u) => { return fold_unary(u.op, u.operand); },
        _ => { return e; }
    }
    return e;
}

function fold_binary(op: string, lhs: parser.Expr, rhs: parser.Expr): parser.Expr {
    var unfolded: parser.Expr = parser.ExprBinary { op: op, left: lhs, right: rhs, line: 0, col: 0 };
    // Integer arithmetic + comparison + equality, evaluated in i64 so a u32
    // operand keeps its value. Both operands must name the SAME type: mixing
    // widths is the checker's business, and picking one of them here would
    // decide it arbitrarily. Both must also be representable in it, or the
    // parse already wrapped and every answer below is built on the wrong
    // number.
    var li: OptInt = as_int_lit(lhs);
    var ri: OptInt = as_int_lit(rhs);
    if (li.ok && ri.ok && li.suffix == ri.suffix && fits(li.v, li.suffix) && fits(ri.v, ri.suffix)) {
        var sfx: string = li.suffix;
        // An arithmetic result that overflows its width is NOT folded: the
        // runtime op wraps and this pass does not, so folding it would change
        // the answer. Comparisons cannot overflow, so they always fold.
        if (op == "+") { return fold_arith(li.v + ri.v, sfx, unfolded); }
        if (op == "-") { return fold_arith(li.v - ri.v, sfx, unfolded); }
        if (op == "*") { return fold_arith(li.v * ri.v, sfx, unfolded); }
        if (op == "/") {
            if (ri.v == 0) { return unfolded; }
            return fold_arith(li.v / ri.v, sfx, unfolded);
        }
        if (op == "%") {
            if (ri.v == 0) { return unfolded; }
            return fold_arith(li.v % ri.v, sfx, unfolded);
        }
        if (op == "<") { return lit_bool(li.v < ri.v); }
        if (op == "<=") { return lit_bool(li.v <= ri.v); }
        if (op == ">") { return lit_bool(li.v > ri.v); }
        if (op == ">=") { return lit_bool(li.v >= ri.v); }
        if (op == "==") { return lit_bool(li.v == ri.v); }
        if (op == "!=") { return lit_bool(li.v != ri.v); }
    }
    // bool && / ||.
    var lb: OptBool = as_bool_lit(lhs);
    var rb: OptBool = as_bool_lit(rhs);
    if (lb.ok && rb.ok) {
        if (op == "&&") { return lit_bool(lb.v && rb.v); }
        if (op == "||") { return lit_bool(lb.v || rb.v); }
        if (op == "==") { return lit_bool(lb.v == rb.v); }
        if (op == "!=") { return lit_bool(lb.v != rb.v); }
    }
    // String concatenation when both sides are literals.
    var ls: OptString = as_string_lit(lhs);
    var rs: OptString = as_string_lit(rhs);
    if (ls.ok && rs.ok) {
        if (op == "+") { return lit_string(ls.v + rs.v); }
        if (op == "==") { return lit_bool(ls.v == rs.v); }
        if (op == "!=") { return lit_bool(ls.v != rs.v); }
    }
    // Nothing to fold — rebuild with folded children.
    return unfolded;
}

// fold_arith emits the folded literal, or leaves the expression alone when the
// value is not representable in the operands' type.
function fold_arith(v: i64, suffix: string, unfolded: parser.Expr): parser.Expr {
    if (!fits(v, suffix)) { return unfolded; }
    return lit_int(v, suffix);
}

function fold_unary(op: string, operand: parser.Expr): parser.Expr {
    if (op == "-") {
        var oi: OptInt = as_int_lit(operand);
        // The operand of a unary minus is a MAGNITUDE, so it is the negated
        // result that has to be representable — 2147483648 alone does not fit
        // i32, but `-2147483648` is exactly i32::MIN.
        if (oi.ok && fits(0 - oi.v, oi.suffix)) { return lit_int(0 - oi.v, oi.suffix); }
    }
    if (op == "!") {
        var ob: OptBool = as_bool_lit(operand);
        if (ob.ok) { return lit_bool(!ob.v); }
    }
    return parser.ExprUnary { op: op, operand: operand, line: 0, col: 0 };
}

// =================== STMT / MODULE FOLDING ====================

function fold_stmt(st: parser.Stmt): parser.Stmt {
    return astwalk.map_stmt(st, fold_node);
}

function fold_block(body: parser.Stmt[]): parser.Stmt[] {
    return astwalk.map_stmts(body, fold_node);
}

pub function fold_module(mod: parser.Module): parser.Module {
    var funcs: parser.FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        funcs = funcs.append(parser.FuncDecl { ...mod.funcs[i], body: fold_block(mod.funcs[i].body) });
        i = i + 1;
    }
    return parser.Module { ...mod, funcs: funcs, top_stmts: fold_block(mod.top_stmts) };
}

// =================== ASSERT ELISION ====================

// elide_asserts drops every `assert(...)` check from the program — the `-O`
// release-build behaviour, and the only thing native spends that flag on
// (internal/constfold.ElideAsserts, #4416). The parser desugars an assert to
// an `if (!cond) { eprint(…); exit(1); }` stamped with parser.ORIGIN_ASSERT,
// so the pass filters exactly those out of every statement list.
//
// The elision removes the condition's evaluation along with the check, which
// is why asserts must be side-effect-free — so the driver runs it after the
// checker and the capability gates. On this compiler that keeps parity with
// the GATES only: the checker's own verdict on an ill-typed assert does not
// reach the build, because every code one raises is on the checker's measured
// partial-gap list (#7170).
pub function elide_asserts(mod: parser.Module): parser.Module {
    var funcs: parser.FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        funcs = funcs.append(parser.FuncDecl { ...mod.funcs[i], body: astwalk.splice_stmts(mod.funcs[i].body, drop_assert) });
        i = i + 1;
    }
    return parser.Module { ...mod, funcs: funcs, top_stmts: astwalk.splice_stmts(mod.top_stmts, drop_assert) };
}

// drop_assert keeps every statement but the assert desugar. The splicing fold
// carries it into nested blocks, lambda bodies and match arms, so no shape
// needs a case here.
function drop_assert(st: parser.Stmt): parser.Stmt[] {
    var keep: parser.Stmt[] = [st];
    match (st) {
        parser.StmtIf(f) => {
            if (f.origin == parser.ORIGIN_ASSERT) {
                var gone: parser.Stmt[] = [];
                return gone;
            }
            return keep;
        },
        _ => { return keep; }
    }
    return keep;
}

// =================== VALIDATION ====================

// Convenience: parse a source, fold, return the folded module.
function fold_source(src: string): parser.Module {
    return fold_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // `1 + 2 * 3` should fold to literal 7. Verify the var
    // init is a single ExprNumber whose text reads "7".
    var mod1: parser.Module = fold_source("var a = 1 + 2 * 3; return a;");
    match (mod1.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "7") { return 10; } },
                _ => { return 11; }
            }
        },
        _ => { return 12; }
    }

    // `(1 + 2) * 3` folds to 9.
    var mod2: parser.Module = fold_source("var a = (1 + 2) * 3; return a;");
    match (mod2.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "9") { return 20; } },
                _ => { return 21; }
            }
        },
        _ => { return 22; }
    }

    // Comparison folds to bool: `5 < 10` → true.
    var mod3: parser.Module = fold_source("var b = 5 < 10; return 0;");
    match (mod3.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBool(b) => { if (!b.value) { return 30; } },
                _ => { return 31; }
            }
        },
        _ => { return 32; }
    }

    // Boolean: `true && false` → false. `!true` → false.
    var mod4: parser.Module = fold_source("var a = true && false; var b = !true; return 0;");
    match (mod4.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBool(b) => { if (b.value) { return 40; } },
                _ => { return 41; }
            }
        },
        _ => { return 42; }
    }
    match (mod4.top_stmts[1]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBool(b) => { if (b.value) { return 43; } },
                _ => { return 44; }
            }
        },
        _ => { return 45; }
    }

    // String concat folds: `"hi " + "there"` → single ExprString.
    var mod5: parser.Module = fold_source("var s = \"hi \" + \"there\"; return 0;");
    match (mod5.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprString(s) => { if (s.value != "hi there") { return 50; } },
                _ => { return 51; }
            }
        },
        _ => { return 52; }
    }

    // Non-constant operand prevents folding: `1 + x` stays as
    // an ExprBinary. Confirms the pass leaves unknowns alone.
    var mod6: parser.Module = fold_source("var a = 1 + x; return 0;");
    match (mod6.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "+") { return 60; } },
                _ => { return 61; }
            }
        },
        _ => { return 62; }
    }

    // Division by zero stays unfolded (the runtime should surface
    // the error, not the folder).
    var mod7: parser.Module = fold_source("var a = 1 / 0; return 0;");
    match (mod7.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "/") { return 70; } },
                _ => { return 71; }
            }
        },
        _ => { return 72; }
    }

    // Nested foldings cascade: `(2 + 3) * (4 + 5)` → 45 in one pass.
    var mod8: parser.Module = fold_source("var a = (2 + 3) * (4 + 5); return 0;");
    match (mod8.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "45") { return 80; } },
                _ => { return 81; }
            }
        },
        _ => { return 82; }
    }

    // Folds inside function-decl bodies too.
    var mod9: parser.Module = fold_source("function add(): i32 { return 1 + 2; } function main(): i32 { return add(); }");
    if (mod9.funcs.len() != 2) { return 90; }
    match (mod9.funcs[0].body[0]) {
        parser.StmtReturn(r) => {
            match (r.value) {
                parser.ExprNumber(n) => { if (n.text != "3") { return 91; } },
                _ => { return 92; }
            }
        },
        _ => { return 93; }
    }

    // Unsigned operands fold with UNSIGNED semantics, because the arithmetic
    // runs in i64 and a u32 literal keeps its value there. Read as signed i32
    // this answered -677 (#6261's fixture value). The suffix rides onto the
    // folded literal, so the result is still a u32.
    var mod10: parser.Module = fold_source("var a = 2147484527u32 % 861u32; return 0;");
    match (mod10.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => {
                    if (n.text != "713") { return 100; }
                    if (n.suffix != "u32") { return 101; }
                },
                _ => { return 102; }
            }
        },
        _ => { return 103; }
    }

    // A result outside the operands' width is NOT folded: `5u32 - 10u32` wraps
    // to 4294967291 at runtime and this pass does not wrap, so folding it to
    // -5 would change the answer.
    var mod11: parser.Module = fold_source("var a = 5u32 - 10u32; return 0;");
    match (mod11.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "-") { return 110; } },
                _ => { return 111; }
            }
        },
        _ => { return 112; }
    }

    // Same rule one width up on the signed side: `2000000000 + 2000000000`
    // overflows i32, so it stays a runtime add.
    var mod12: parser.Module = fold_source("var a = 2000000000 + 2000000000; return 0;");
    match (mod12.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "+") { return 120; } },
                _ => { return 121; }
            }
        },
        _ => { return 122; }
    }

    // Mixed widths are the checker's business — folding would have to pick one
    // of the two types, so it picks neither.
    var mod13: parser.Module = fold_source("var a = 5u32 + 5; return 0;");
    match (mod13.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "+") { return 130; } },
                _ => { return 131; }
            }
        },
        _ => { return 132; }
    }

    // i32::MIN: the one magnitude with no i32 representation, so it is spelled
    // `0 - 2147483647 - 1`. The chain folds all the way, and the sign lands on
    // a unary minus rather than in the literal's text — where its 11 characters
    // would read as an i64 (irlower.literal_is_i64 classifies by LENGTH).
    var mod14: parser.Module = fold_source("var a = 0 - 2147483647 - 1; return 0;");
    match (mod14.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprUnary(u) => {
                    if (u.op != "-") { return 140; }
                    match (u.operand) {
                        parser.ExprNumber(n) => { if (n.text != "2147483648") { return 141; } },
                        _ => { return 142; }
                    }
                },
                _ => { return 143; }
            }
        },
        _ => { return 144; }
    }

    // -O's assert elision. The desugar is marked by the parser, so the pass
    // finds it again; a hand-written `if` of the same shape is untouched.
    var mod15: parser.Module = elide_asserts(fold_source(
        "function main(): i32 { assert(1 > 2); return 0; }"));
    if (mod15.funcs[0].body.len() != 1) { return 150; }
    match (mod15.funcs[0].body[0]) {
        parser.StmtReturn(_) => { },
        _ => { return 151; }
    }

    var mod16: parser.Module = elide_asserts(fold_source(
        "function main(): i32 { if (1 > 2) { return 3; } return 0; }"));
    if (mod16.funcs[0].body.len() != 2) { return 152; }

    // The three places a top-level filter misses. Each nests one assert; all
    // three have to go, and the enclosing statement has to stay.
    var mod17: parser.Module = elide_asserts(fold_source(
        "function main(): i32 { while (false) { assert(1 > 2); } return 0; }"));
    match (mod17.funcs[0].body[0]) {
        parser.StmtWhile(w) => { if (w.body.len() != 0) { return 160; } },
        _ => { return 161; }
    }

    var mod18: parser.Module = elide_asserts(fold_source(
        "function main(): i32 { var f = function(): i32 { assert(1 > 2); return 1; }; return 0; }"));
    match (mod18.funcs[0].body[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprLambda(lm) => { if (lm.body.len() != 1) { return 170; } },
                _ => { return 171; }
            }
        },
        _ => { return 172; }
    }

    var mod19: parser.Module = elide_asserts(fold_source(
        "enum E { A(i32) } function main(): i32 { var e: E = E.A(1); match (e) { E.A(v) => { assert(v > 2); }, _ => { return 9; } } return 0; }"));
    match (mod19.funcs[0].body[1]) {
        parser.StmtMatch(mt) => { if (mt.arms[0].body.len() != 0) { return 180; } },
        _ => { return 181; }
    }

    // A lambda nested in a lambda: the splice must reach it, and reach it
    // ONCE — a body visited twice would splice an expanding rewrite twice.
    var mod20: parser.Module = elide_asserts(fold_source(
        "function main(): i32 { var f = function(): i32 { var g = function(): i32 { assert(1 > 2); return 1; }; return 2; }; return 0; }"));
    match (mod20.funcs[0].body[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprLambda(outer) => {
                    if (outer.body.len() != 2) { return 190; }
                    match (outer.body[0]) {
                        parser.StmtVar(iv) => {
                            match (iv.init) {
                                parser.ExprLambda(inner) => { if (inner.body.len() != 1) { return 191; } },
                                _ => { return 192; }
                            }
                        },
                        _ => { return 193; }
                    }
                },
                _ => { return 194; }
            }
        },
        _ => { return 195; }
    }

    // fold_module rebuilds every FuncDecl, so it has to carry every field
    // across. It used to spell them out and reset bound_traits to empty in the
    // process; the checker and the printer both read that field, and both run
    // before this pass, so nothing observed the loss — until something after
    // it does.
    var mod21: parser.Module = fold_module(parser.parse_module(lexer.tokenize(
        "function pick[T: Ord](a: T, b: T): T { if (a < b) { return a; } return b; }")));
    if (mod21.funcs[0].bound_traits.len() != 1) { return 200; }
    if (mod21.funcs[0].bound_traits[0] != "Ord") { return 201; }

    return 0;
}
