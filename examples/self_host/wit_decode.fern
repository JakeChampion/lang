// examples/self_host/wit_decode.fern — self-host port of
// internal/wasm/componenttype's bring-your-own-WIT decoder
// (docs/WIT-BRING-YOUR-OWN.md, P1). The destination is the self-hosted
// compiler; the Go decoder is the byte-identical oracle.
//
// Slice 1: the byte-reader LEB primitives + the component-type payload
// section walker. A `component-type` payload is itself a component binary
// (\0asm 0d 00 01 00 + sections); this validates the header and walks the
// top-level sections, then re-emits them (id + uleb size + body) so a
// round-trip reproduces the input — exercising the uleb reader against the
// real fern.bin through the self-host. Slices 2/3 add the value-type grammar
// and the world model. Depends on leb128.fern (leb_u32).

// UlebRead is the result of reading a uleb128: the decoded value and the
// position just past it.
struct UlebRead { value: i32, next: i32 }

// wit_read_uleb reads an unsigned LEB128 from buf starting at pos.
function wit_read_uleb(buf: i32[], pos: i32): UlebRead {
    var v: i32 = 0;
    var shift: i32 = 0;
    var p: i32 = pos;
    var done: boolean = false;
    while (!done) {
        var c: i32 = buf[p];
        p = p + 1;
        v = v | ((c & 127) << shift);
        if ((c & 128) == 0) {
            done = true;
        } else {
            shift = shift + 7;
        }
    }
    return UlebRead { value: v, next: p };
}

// wit_component_header returns the 8-byte component preamble
// (\0asm + version 13, layer 1) every component-type payload starts with.
function wit_component_header(): i32[] {
    return [0, 97, 115, 109, 13, 0, 1, 0];
}

// wit_reencode_sections validates the component header of a component-type
// payload, walks its top-level sections (each: id byte + uleb size + body),
// and re-emits them (id + uleb size + body). The result equals the input
// when the walker and the uleb reader/writer agree — the slice-1 round-trip
// gate. Returns an empty buffer if the header is wrong.
function wit_reencode_sections(payload: i32[]): i32[] {
    var hdr: i32[] = wit_component_header();
    var i: i32 = 0;
    while (i < hdr.len()) {
        if (payload[i] != hdr[i]) {
            return [];
        }
        i = i + 1;
    }
    var o: i32[] = [];
    i = 0;
    while (i < 8) {
        o = o.append(payload[i]);
        i = i + 1;
    }
    var pos: i32 = 8;
    while (pos < payload.len()) {
        var id: i32 = payload[pos];
        pos = pos + 1;
        var r: UlebRead = wit_read_uleb(payload, pos);
        var size: i32 = r.value;
        pos = r.next;
        o = o.append(id);
        o = leb_u32(o, size);
        var j: i32 = 0;
        while (j < size) {
            o = o.append(payload[pos + j]);
            j = j + 1;
        }
        pos = pos + size;
    }
    return o;
}

// ---- slice 2: value-type grammar -----------------------------------------
//
// A component-model value type is a signed LEB128 (s33): a small negative
// value is a primitive (the canonical single byte is the 0x73..0x7f code), a
// non-negative value is a type index. So a valtype round-trips as one signed
// i32 — decode with wit_read_sleb, re-encode with leb_i32 (verified
// canonical). The defined value types (record / variant / enum / flags /
// list / option / result / tuple / own / borrow) and function types decode
// into flat models (parallel arrays) and re-encode from them, so a
// structural mis-parse changes the bytes and is caught by the round-trip.

struct SlebR { value: i32, next: i32 }
struct NameR { s: string, next: i32 }

// wit_read_sleb reads a signed LEB128 from buf at pos.
function wit_read_sleb(buf: i32[], pos: i32): SlebR {
    var result: i32 = 0;
    var shift: i32 = 0;
    var p: i32 = pos;
    var done: boolean = false;
    while (!done) {
        var c: i32 = buf[p];
        p = p + 1;
        result = result | ((c & 127) << shift);
        shift = shift + 7;
        if ((c & 128) == 0) {
            if (shift < 32 && (c & 64) != 0) {
                result = result | (0 - (1 << shift));
            }
            done = true;
        }
    }
    return SlebR { value: result, next: p };
}

// wit_read_name reads a uleb-length-prefixed UTF-8 name.
function wit_read_name(buf: i32[], pos: i32): NameR {
    var r: UlebRead = wit_read_uleb(buf, pos);
    var n: i32 = r.value;
    var p: i32 = r.next;
    var bytes: u8[] = [];
    var i: i32 = 0;
    while (i < n) {
        bytes = bytes.append(buf[p + i] as u8);
        i = i + 1;
    }
    return NameR { s: string_from_bytes_unchecked(bytes), next: p + n };
}

// wit_append_name appends a uleb-length-prefixed name.
function wit_append_name(out: i32[], s: string): i32[] {
    out = leb_u32(out, s.len());
    var i: i32 = 0;
    while (i < s.len()) {
        out = out.append((s[i] as i32));
        i = i + 1;
    }
    return out;
}

// WitDef is a decoded defined value type (tag + the fields meaningful for it).
struct WitDef {
    tag: i32,
    rec_names: string[], rec_vals: i32[],
    var_names: string[], var_has_ty: i32[], var_ty: i32[], var_has_ref: i32[], var_ref: i32[],
    ef_names: string[],
    elem: i32,
    tup_elems: i32[],
    has_ok: i32, ok: i32, has_err: i32, err: i32,
    resource: i32
}
struct WitDefR { def: WitDef, next: i32 }

function wit_decode_def(buf: i32[], pos: i32): WitDefR {
    var tag: i32 = buf[pos];
    var p: i32 = pos + 1;
    var rec_names: string[] = [];
    var rec_vals: i32[] = [];
    var var_names: string[] = [];
    var var_has_ty: i32[] = [];
    var var_ty: i32[] = [];
    var var_has_ref: i32[] = [];
    var var_ref: i32[] = [];
    var ef_names: string[] = [];
    var elem: i32 = 0;
    var tup_elems: i32[] = [];
    var has_ok: i32 = 0;
    var ok: i32 = 0;
    var has_err: i32 = 0;
    var err: i32 = 0;
    var resource: i32 = 0;
    if (tag == 114) {
        var rc: UlebRead = wit_read_uleb(buf, p);
        var n: i32 = rc.value;
        p = rc.next;
        var i: i32 = 0;
        while (i < n) {
            var nr: NameR = wit_read_name(buf, p);
            p = nr.next;
            var vr: SlebR = wit_read_sleb(buf, p);
            p = vr.next;
            rec_names = rec_names.append(nr.s);
            rec_vals = rec_vals.append(vr.value);
            i = i + 1;
        }
    } else if (tag == 113) {
        var rc2: UlebRead = wit_read_uleb(buf, p);
        var n2: i32 = rc2.value;
        p = rc2.next;
        var i2: i32 = 0;
        while (i2 < n2) {
            var nr2: NameR = wit_read_name(buf, p);
            p = nr2.next;
            var ht: i32 = 0;
            var ty: i32 = 0;
            if (buf[p] == 1) {
                p = p + 1;
                var vr2: SlebR = wit_read_sleb(buf, p);
                p = vr2.next;
                ht = 1;
                ty = vr2.value;
            } else {
                p = p + 1;
            }
            var hr: i32 = 0;
            var rf: i32 = 0;
            if (buf[p] == 1) {
                p = p + 1;
                var rr: UlebRead = wit_read_uleb(buf, p);
                p = rr.next;
                hr = 1;
                rf = rr.value;
            } else {
                p = p + 1;
            }
            var_names = var_names.append(nr2.s);
            var_has_ty = var_has_ty.append(ht);
            var_ty = var_ty.append(ty);
            var_has_ref = var_has_ref.append(hr);
            var_ref = var_ref.append(rf);
            i2 = i2 + 1;
        }
    } else if (tag == 109 || tag == 110) {
        var rc3: UlebRead = wit_read_uleb(buf, p);
        var n3: i32 = rc3.value;
        p = rc3.next;
        var i3: i32 = 0;
        while (i3 < n3) {
            var nr3: NameR = wit_read_name(buf, p);
            p = nr3.next;
            ef_names = ef_names.append(nr3.s);
            i3 = i3 + 1;
        }
    } else if (tag == 112 || tag == 107) {
        var er: SlebR = wit_read_sleb(buf, p);
        p = er.next;
        elem = er.value;
    } else if (tag == 111) {
        var rc4: UlebRead = wit_read_uleb(buf, p);
        var n4: i32 = rc4.value;
        p = rc4.next;
        var i4: i32 = 0;
        while (i4 < n4) {
            var tr: SlebR = wit_read_sleb(buf, p);
            p = tr.next;
            tup_elems = tup_elems.append(tr.value);
            i4 = i4 + 1;
        }
    } else if (tag == 106) {
        if (buf[p] == 1) {
            p = p + 1;
            var okr: SlebR = wit_read_sleb(buf, p);
            p = okr.next;
            has_ok = 1;
            ok = okr.value;
        } else {
            p = p + 1;
        }
        if (buf[p] == 1) {
            p = p + 1;
            var erq: SlebR = wit_read_sleb(buf, p);
            p = erq.next;
            has_err = 1;
            err = erq.value;
        } else {
            p = p + 1;
        }
    } else if (tag == 105 || tag == 104) {
        var rr2: UlebRead = wit_read_uleb(buf, p);
        p = rr2.next;
        resource = rr2.value;
    }
    return WitDefR {
        def: WitDef {
            tag: tag,
            rec_names: rec_names, rec_vals: rec_vals,
            var_names: var_names, var_has_ty: var_has_ty, var_ty: var_ty, var_has_ref: var_has_ref, var_ref: var_ref,
            ef_names: ef_names,
            elem: elem,
            tup_elems: tup_elems,
            has_ok: has_ok, ok: ok, has_err: has_err, err: err,
            resource: resource
        },
        next: p
    };
}

function wit_encode_def(out: i32[], d: WitDef): i32[] {
    out = out.append(d.tag);
    if (d.tag == 114) {
        out = leb_u32(out, d.rec_names.len());
        var i: i32 = 0;
        while (i < d.rec_names.len()) {
            out = wit_append_name(out, d.rec_names[i]);
            out = leb_i32(out, d.rec_vals[i]);
            i = i + 1;
        }
    } else if (d.tag == 113) {
        out = leb_u32(out, d.var_names.len());
        var i2: i32 = 0;
        while (i2 < d.var_names.len()) {
            out = wit_append_name(out, d.var_names[i2]);
            if (d.var_has_ty[i2] == 1) {
                out = out.append(1);
                out = leb_i32(out, d.var_ty[i2]);
            } else {
                out = out.append(0);
            }
            if (d.var_has_ref[i2] == 1) {
                out = out.append(1);
                out = leb_u32(out, d.var_ref[i2]);
            } else {
                out = out.append(0);
            }
            i2 = i2 + 1;
        }
    } else if (d.tag == 109 || d.tag == 110) {
        out = leb_u32(out, d.ef_names.len());
        var i3: i32 = 0;
        while (i3 < d.ef_names.len()) {
            out = wit_append_name(out, d.ef_names[i3]);
            i3 = i3 + 1;
        }
    } else if (d.tag == 112 || d.tag == 107) {
        out = leb_i32(out, d.elem);
    } else if (d.tag == 111) {
        out = leb_u32(out, d.tup_elems.len());
        var i4: i32 = 0;
        while (i4 < d.tup_elems.len()) {
            out = leb_i32(out, d.tup_elems[i4]);
            i4 = i4 + 1;
        }
    } else if (d.tag == 106) {
        if (d.has_ok == 1) {
            out = out.append(1);
            out = leb_i32(out, d.ok);
        } else {
            out = out.append(0);
        }
        if (d.has_err == 1) {
            out = out.append(1);
            out = leb_i32(out, d.err);
        } else {
            out = out.append(0);
        }
    } else if (d.tag == 105 || d.tag == 104) {
        out = leb_u32(out, d.resource);
    }
    return out;
}

// WitFunc is a decoded function type.
struct WitFunc {
    p_names: string[], p_vals: i32[],
    named: i32, result: i32,
    r_names: string[], r_vals: i32[]
}
struct WitFuncR { fn: WitFunc, next: i32 }

function wit_decode_func(buf: i32[], pos: i32): WitFuncR {
    var p: i32 = pos + 1;
    var p_names: string[] = [];
    var p_vals: i32[] = [];
    var rc: UlebRead = wit_read_uleb(buf, p);
    var n: i32 = rc.value;
    p = rc.next;
    var i: i32 = 0;
    while (i < n) {
        var nr: NameR = wit_read_name(buf, p);
        p = nr.next;
        var vr: SlebR = wit_read_sleb(buf, p);
        p = vr.next;
        p_names = p_names.append(nr.s);
        p_vals = p_vals.append(vr.value);
        i = i + 1;
    }
    var named: i32 = 0;
    var result: i32 = 0;
    var r_names: string[] = [];
    var r_vals: i32[] = [];
    if (buf[p] == 0) {
        p = p + 1;
        var rr: SlebR = wit_read_sleb(buf, p);
        p = rr.next;
        result = rr.value;
    } else {
        p = p + 1;
        named = 1;
        var rc2: UlebRead = wit_read_uleb(buf, p);
        var n2: i32 = rc2.value;
        p = rc2.next;
        var j: i32 = 0;
        while (j < n2) {
            var nr2: NameR = wit_read_name(buf, p);
            p = nr2.next;
            var vr2: SlebR = wit_read_sleb(buf, p);
            p = vr2.next;
            r_names = r_names.append(nr2.s);
            r_vals = r_vals.append(vr2.value);
            j = j + 1;
        }
    }
    return WitFuncR {
        fn: WitFunc { p_names: p_names, p_vals: p_vals, named: named, result: result, r_names: r_names, r_vals: r_vals },
        next: p
    };
}

function wit_encode_func(out: i32[], f: WitFunc): i32[] {
    out = out.append(64);
    out = leb_u32(out, f.p_names.len());
    var i: i32 = 0;
    while (i < f.p_names.len()) {
        out = wit_append_name(out, f.p_names[i]);
        out = leb_i32(out, f.p_vals[i]);
        i = i + 1;
    }
    if (f.named == 1) {
        out = out.append(1);
        out = leb_u32(out, f.r_names.len());
        var j: i32 = 0;
        while (j < f.r_names.len()) {
            out = wit_append_name(out, f.r_names[j]);
            out = leb_i32(out, f.r_vals[j]);
            j = j + 1;
        }
    } else {
        out = out.append(0);
        out = leb_i32(out, f.result);
    }
    return out;
}

// ---- slice 3: component/instance types + decls + the full round-trip ------
//
// The outer structure (component 0x41 / instance 0x42 types, their decls —
// type / alias / import / export — externdescs and aliases) is transcoded:
// every byte is parsed and re-emitted through the same encoders, with the
// value-type leaves going through slice 2's decode/encode. A structural
// mis-parse desyncs the cursor and changes the output, so round-tripping the
// whole fern.bin / http.bin type + export sections is a strong oracle —
// matching the Go decoder's World round-trip, but in the self-host.

struct TxR { next: i32, out: i32[] }

// wit_tx_typedef transcodes one type definition at pos.
function wit_tx_typedef(buf: i32[], pos: i32, out: i32[]): TxR {
    var tag: i32 = buf[pos];
    if (tag == 65 || tag == 66) {
        out = out.append(tag);
        var p: i32 = pos + 1;
        var rc: UlebRead = wit_read_uleb(buf, p);
        var count: i32 = rc.value;
        p = rc.next;
        out = leb_u32(out, count);
        var i: i32 = 0;
        while (i < count) {
            var t: TxR = wit_tx_decl(buf, p, out);
            p = t.next;
            out = t.out;
            i = i + 1;
        }
        return TxR { next: p, out: out };
    } else if (tag == 64) {
        var fr: WitFuncR = wit_decode_func(buf, pos);
        out = wit_encode_func(out, fr.fn);
        return TxR { next: fr.next, out: out };
    } else if (tag >= 104 && tag <= 114) {
        var dr: WitDefR = wit_decode_def(buf, pos);
        out = wit_encode_def(out, dr.def);
        return TxR { next: dr.next, out: out };
    } else {
        out = out.append(tag);
        return TxR { next: pos + 1, out: out };
    }
}

// wit_tx_decl transcodes one declaration inside a component/instance type.
function wit_tx_decl(buf: i32[], pos: i32, out: i32[]): TxR {
    var kind: i32 = buf[pos];
    out = out.append(kind);
    var p: i32 = pos + 1;
    if (kind == 1) {
        return wit_tx_typedef(buf, p, out);
    } else if (kind == 2) {
        return wit_tx_alias(buf, p, out);
    } else if (kind == 3 || kind == 4) {
        var ne: TxR = wit_tx_externname(buf, p, out);
        p = ne.next;
        out = ne.out;
        return wit_tx_externdesc(buf, p, out);
    }
    return TxR { next: p, out: out };
}

// wit_tx_externname transcodes a label-kind name (0x00 + uleb-len + bytes).
function wit_tx_externname(buf: i32[], pos: i32, out: i32[]): TxR {
    out = out.append(buf[pos]);
    var nr: NameR = wit_read_name(buf, pos + 1);
    out = wit_append_name(out, nr.s);
    return TxR { next: nr.next, out: out };
}

// wit_tx_externdesc transcodes an import/export externdesc.
function wit_tx_externdesc(buf: i32[], pos: i32, out: i32[]): TxR {
    var kind: i32 = buf[pos];
    out = out.append(kind);
    var p: i32 = pos + 1;
    if (kind == 1 || kind == 4 || kind == 5) {
        var r: UlebRead = wit_read_uleb(buf, p);
        out = leb_u32(out, r.value);
        p = r.next;
    } else if (kind == 2) {
        var sr: SlebR = wit_read_sleb(buf, p);
        out = leb_i32(out, sr.value);
        p = sr.next;
    } else if (kind == 3) {
        var bound: i32 = buf[p];
        out = out.append(bound);
        p = p + 1;
        if (bound == 0) {
            var r2: UlebRead = wit_read_uleb(buf, p);
            out = leb_u32(out, r2.value);
            p = r2.next;
        }
    } else if (kind == 0) {
        out = out.append(buf[p]);
        p = p + 1;
        var r3: UlebRead = wit_read_uleb(buf, p);
        out = leb_u32(out, r3.value);
        p = r3.next;
    }
    return TxR { next: p, out: out };
}

// wit_tx_alias transcodes an alias declaration.
function wit_tx_alias(buf: i32[], pos: i32, out: i32[]): TxR {
    var sort: i32 = buf[pos];
    out = out.append(sort);
    var p: i32 = pos + 1;
    if (sort == 0) {
        out = out.append(buf[p]);
        p = p + 1;
    }
    var target: i32 = buf[p];
    out = out.append(target);
    p = p + 1;
    if (target == 0 || target == 1) {
        var r: UlebRead = wit_read_uleb(buf, p);
        out = leb_u32(out, r.value);
        p = r.next;
        var nr: NameR = wit_read_name(buf, p);
        out = wit_append_name(out, nr.s);
        p = nr.next;
    } else if (target == 2) {
        var r2: UlebRead = wit_read_uleb(buf, p);
        out = leb_u32(out, r2.value);
        p = r2.next;
        var r3: UlebRead = wit_read_uleb(buf, p);
        out = leb_u32(out, r3.value);
        p = r3.next;
    }
    return TxR { next: p, out: out };
}

// wit_transcode_type_section round-trips a component type section body.
function wit_transcode_type_section(buf: i32[]): i32[] {
    var out: i32[] = [];
    var rc: UlebRead = wit_read_uleb(buf, 0);
    out = leb_u32(out, rc.value);
    var p: i32 = rc.next;
    var i: i32 = 0;
    while (i < rc.value) {
        var t: TxR = wit_tx_typedef(buf, p, out);
        p = t.next;
        out = t.out;
        i = i + 1;
    }
    return out;
}

// wit_transcode_export_section round-trips a component export section body.
function wit_transcode_export_section(buf: i32[]): i32[] {
    var out: i32[] = [];
    var rc: UlebRead = wit_read_uleb(buf, 0);
    out = leb_u32(out, rc.value);
    var p: i32 = rc.next;
    var i: i32 = 0;
    while (i < rc.value) {
        var ne: TxR = wit_tx_externname(buf, p, out);
        p = ne.next;
        out = ne.out;
        out = out.append(buf[p]);
        p = p + 1;
        var r: UlebRead = wit_read_uleb(buf, p);
        out = leb_u32(out, r.value);
        p = r.next;
        var has: i32 = buf[p];
        out = out.append(has);
        p = p + 1;
        if (has == 1) {
            var de: TxR = wit_tx_externdesc(buf, p, out);
            p = de.next;
            out = de.out;
        }
        i = i + 1;
    }
    return out;
}

// wit_section_body returns the body of the first section with id want_id.
function wit_section_body(payload: i32[], want_id: i32): i32[] {
    var pos: i32 = 8;
    var found: i32[] = [];
    var done: boolean = false;
    while (pos < payload.len() && !done) {
        var id: i32 = payload[pos];
        pos = pos + 1;
        var r: UlebRead = wit_read_uleb(payload, pos);
        var size: i32 = r.value;
        pos = r.next;
        if (id == want_id) {
            var j: i32 = 0;
            while (j < size) {
                found = found.append(payload[pos + j]);
                j = j + 1;
            }
            done = true;
        }
        pos = pos + size;
    }
    return found;
}

// ---- P2 slice: world lift (import interface names) -----------------------
//
// Navigate the decoded world to its imported interface names -- the self-host
// mirror of componenttype's World.Interfaces (names). The type section's
// type 0 is the outer wrapper component; its first decl is the world
// component (Type(component)); the world component's import decls (kind 0x03)
// name the interfaces. Non-import decls are skipped with the slice-3
// transcoder (wit_tx_decl, throwing away its output).

function wit_world_import_names(tbody: i32[]): string[] {
    var names: string[] = [];
    var none: i32[] = [];
    var rc: UlebRead = wit_read_uleb(tbody, 0);
    var p: i32 = rc.next;
    // type 0: outer component (0x41) + decl vec.
    p = p + 1;
    var oc: UlebRead = wit_read_uleb(tbody, p);
    p = oc.next;
    // outer decl 0: type decl (0x01) whose typedef is the world component (0x41).
    p = p + 1;
    p = p + 1;
    var wc: UlebRead = wit_read_uleb(tbody, p);
    var wcount: i32 = wc.value;
    p = wc.next;
    var i: i32 = 0;
    while (i < wcount) {
        var kind: i32 = tbody[p];
        if (kind == 3) {
            // import: externname is 0x00 + uleb-len + bytes.
            var nr: NameR = wit_read_name(tbody, p + 2);
            names = names.append(nr.s);
        }
        var skip: TxR = wit_tx_decl(tbody, p, none);
        p = skip.next;
        i = i + 1;
    }
    return names;
}

// ---- P2 slice: emit the world import prefix ------------------------------
//
// Self-host mirror of componenttype's EmitWorldImports: replay the world
// component's decls as top-level component sections (type decl -> type
// section id 7, alias -> alias section id 6, import -> import section id 10),
// skipping exports. Each decl's payload (the bytes after its kind byte) is
// the section body content, prefixed with vec(1) -- so the output is
// byte-identical to the Go EmitWorldImports.

function wit_emit_section(out: i32[], id: i32, body: i32[]): i32[] {
    out = out.append(id);
    out = leb_u32(out, body.len());
    var k: i32 = 0;
    while (k < body.len()) {
        out = out.append(body[k]);
        k = k + 1;
    }
    return out;
}

function wit_emit_world_imports(tbody: i32[]): i32[] {
    var out: i32[] = [];
    var none: i32[] = [];
    var rc: UlebRead = wit_read_uleb(tbody, 0);
    var p: i32 = rc.next;
    p = p + 1;
    var oc: UlebRead = wit_read_uleb(tbody, p);
    p = oc.next;
    p = p + 1;
    p = p + 1;
    var wc: UlebRead = wit_read_uleb(tbody, p);
    var wcount: i32 = wc.value;
    p = wc.next;
    var i: i32 = 0;
    while (i < wcount) {
        var kind: i32 = tbody[p];
        var skip: TxR = wit_tx_decl(tbody, p, none);
        var declEnd: i32 = skip.next;
        var sec: i32 = 0;
        if (kind == 1) {
            sec = 7;
        } else if (kind == 2) {
            sec = 6;
        } else if (kind == 3) {
            sec = 10;
        }
        if (sec != 0) {
            var body: i32[] = [1];
            var j: i32 = p + 1;
            while (j < declEnd) {
                body = body.append(tbody[j]);
                j = j + 1;
            }
            out = wit_emit_section(out, sec, body);
        }
        p = declEnd;
        i = i + 1;
    }
    return out;
}

// ---- P2 slice: classify imports from the world --------------------------
//
// Self-host mirror of componenttype's Classify: derive each imported
// function's lowering kind (0 no-opt, 1 mem, 2 mem+realloc) from its resolved
// signature via the canonical-ABI flattening rules. Value-type indices are
// resolved against a per-scope offset table (the byte offset of each type's
// encoding), reusing wit_decode_def; sentinel -1 entries (aliases / surfaced
// resources) resolve as scalar handles, matching the Go ResolveDef==nil case.

// wit_iface_instance_offset returns the byte offset (in the type-section body)
// of the instance type the world imports under `iface`, or -1.
function wit_iface_instance_offset(tbody: i32[], iface: string): i32 {
    var none: i32[] = [];
    var rc: UlebRead = wit_read_uleb(tbody, 0);
    var p: i32 = rc.next;
    p = p + 1;
    var oc: UlebRead = wit_read_uleb(tbody, p);
    p = oc.next;
    p = p + 1;
    p = p + 1;
    var wc: UlebRead = wit_read_uleb(tbody, p);
    var wcount: i32 = wc.value;
    p = wc.next;
    var typeOffsets: i32[] = [];
    var result: i32 = 0 - 1;
    var found: boolean = false;
    var i: i32 = 0;
    while (i < wcount && !found) {
        var kind: i32 = tbody[p];
        if (kind == 1) {
            typeOffsets = typeOffsets.append(p + 1);
        } else if (kind == 2) {
            if (tbody[p + 1] == 3) { typeOffsets = typeOffsets.append(0 - 1); }
        } else if (kind == 3) {
            var nr: NameR = wit_read_name(tbody, p + 2);
            if (nr.s == iface) {
                var tr: UlebRead = wit_read_uleb(tbody, nr.next + 1);
                result = typeOffsets[tr.value];
                found = true;
            }
        }
        var skip: TxR = wit_tx_decl(tbody, p, none);
        p = skip.next;
        i = i + 1;
    }
    return result;
}

function wit_contains_heap(tbody: i32[], offs: i32[], v: i32): boolean {
    if (v < 0) {
        return v == (0 - 13);
    }
    if (v >= offs.len()) { return false; }
    var off: i32 = offs[v];
    if (off < 0) { return false; }
    var d: WitDef = wit_decode_def(tbody, off).def;
    if (d.tag == 112) { return true; }
    if (d.tag == 107) { return wit_contains_heap(tbody, offs, d.elem); }
    if (d.tag == 111) {
        var i: i32 = 0;
        while (i < d.tup_elems.len()) {
            if (wit_contains_heap(tbody, offs, d.tup_elems[i])) { return true; }
            i = i + 1;
        }
    }
    if (d.tag == 114) {
        var j: i32 = 0;
        while (j < d.rec_vals.len()) {
            if (wit_contains_heap(tbody, offs, d.rec_vals[j])) { return true; }
            j = j + 1;
        }
    }
    if (d.tag == 113) {
        var k: i32 = 0;
        while (k < d.var_ty.len()) {
            if (d.var_has_ty[k] == 1 && wit_contains_heap(tbody, offs, d.var_ty[k])) { return true; }
            k = k + 1;
        }
    }
    if (d.tag == 106) {
        if (d.has_ok == 1 && wit_contains_heap(tbody, offs, d.ok)) { return true; }
        if (d.has_err == 1 && wit_contains_heap(tbody, offs, d.err)) { return true; }
    }
    return false;
}

function wit_flatten(tbody: i32[], offs: i32[], v: i32): i32 {
    if (v < 0) {
        if (v == (0 - 13)) { return 2; }
        return 1;
    }
    if (v >= offs.len()) { return 1; }
    var off: i32 = offs[v];
    if (off < 0) { return 1; }
    var d: WitDef = wit_decode_def(tbody, off).def;
    if (d.tag == 112) { return 2; }
    if (d.tag == 105 || d.tag == 104 || d.tag == 109 || d.tag == 110) { return 1; }
    if (d.tag == 107) { return 1 + wit_flatten(tbody, offs, d.elem); }
    if (d.tag == 111) {
        var n: i32 = 0;
        var i: i32 = 0;
        while (i < d.tup_elems.len()) {
            n = n + wit_flatten(tbody, offs, d.tup_elems[i]);
            i = i + 1;
        }
        return n;
    }
    if (d.tag == 114) {
        var n2: i32 = 0;
        var j: i32 = 0;
        while (j < d.rec_vals.len()) {
            n2 = n2 + wit_flatten(tbody, offs, d.rec_vals[j]);
            j = j + 1;
        }
        return n2;
    }
    if (d.tag == 113) {
        var mx: i32 = 0;
        var k: i32 = 0;
        while (k < d.var_ty.len()) {
            var c: i32 = 0;
            if (d.var_has_ty[k] == 1) { c = wit_flatten(tbody, offs, d.var_ty[k]); }
            if (c > mx) { mx = c; }
            k = k + 1;
        }
        return 1 + mx;
    }
    if (d.tag == 106) {
        var ok: i32 = 0;
        var er: i32 = 0;
        if (d.has_ok == 1) { ok = wit_flatten(tbody, offs, d.ok); }
        if (d.has_err == 1) { er = wit_flatten(tbody, offs, d.err); }
        if (ok > er) { return 1 + ok; }
        return 1 + er;
    }
    return 1;
}

// wit_classify returns the lowering kind (0/1/2) for (iface, fname) in the world.
function wit_classify(tbody: i32[], iface: string, fname: string): i32 {
    var instOff: i32 = wit_iface_instance_offset(tbody, iface);
    if (instOff < 0) { return 0; }
    var none: i32[] = [];
    var p: i32 = instOff + 1;
    var dc: UlebRead = wit_read_uleb(tbody, p);
    var dcount: i32 = dc.value;
    p = dc.next;
    var offs: i32[] = [];
    var funcOff: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < dcount) {
        var kind: i32 = tbody[p];
        if (kind == 1) {
            offs = offs.append(p + 1);
        } else if (kind == 2) {
            if (tbody[p + 1] == 3) { offs = offs.append(0 - 1); }
        } else if (kind == 4) {
            var nr: NameR = wit_read_name(tbody, p + 2);
            var edk: i32 = tbody[nr.next];
            if (edk == 3) {
                offs = offs.append(0 - 1);
            } else if (edk == 1 && nr.s == fname) {
                var tr: UlebRead = wit_read_uleb(tbody, nr.next + 1);
                funcOff = offs[tr.value];
            }
        }
        var skip: TxR = wit_tx_decl(tbody, p, none);
        p = skip.next;
        i = i + 1;
    }
    if (funcOff < 0) { return 0; }
    var f: WitFunc = wit_decode_func(tbody, funcOff).fn;
    var needR: boolean = false;
    if (f.named == 0) {
        if (wit_contains_heap(tbody, offs, f.result)) { needR = true; }
    } else {
        var r: i32 = 0;
        while (r < f.r_vals.len()) {
            if (wit_contains_heap(tbody, offs, f.r_vals[r])) { needR = true; }
            r = r + 1;
        }
    }
    if (needR) { return 2; }
    var pj: i32 = 0;
    while (pj < f.p_vals.len()) {
        if (wit_contains_heap(tbody, offs, f.p_vals[pj])) { return 1; }
        pj = pj + 1;
    }
    var flat: i32 = 0;
    if (f.named == 0) {
        flat = wit_flatten(tbody, offs, f.result);
    } else {
        var rk: i32 = 0;
        while (rk < f.r_vals.len()) {
            flat = flat + wit_flatten(tbody, offs, f.r_vals[rk]);
            rk = rk + 1;
        }
    }
    if (flat > 1) { return 1; }
    return 0;
}

// ---- P2 slice: prefix index layout --------------------------------------
//
// Self-host mirror of componenttype's PrefixLayout / ImportInstanceIndex: the
// component type / instance index counts the world import prefix produces (the
// suffix's n_type0 / n_inst0), and the instance index each interface lands at
// (which the suffix aliases its functions from). Navigates the world component
// decls like wit_world_import_names, counting type slots (type decls + type
// aliases) and import decls.

struct WitPrefixLayout { types: i32, instances: i32 }

function wit_prefix_layout(tbody: i32[]): WitPrefixLayout {
    var none: i32[] = [];
    var rc: UlebRead = wit_read_uleb(tbody, 0);
    var p: i32 = rc.next;
    p = p + 1;
    var oc: UlebRead = wit_read_uleb(tbody, p);
    p = oc.next;
    p = p + 1;
    p = p + 1;
    var wc: UlebRead = wit_read_uleb(tbody, p);
    var wcount: i32 = wc.value;
    p = wc.next;
    var types: i32 = 0;
    var instances: i32 = 0;
    var i: i32 = 0;
    while (i < wcount) {
        var kind: i32 = tbody[p];
        if (kind == 1) {
            types = types + 1;
        } else if (kind == 2) {
            if (tbody[p + 1] == 3) { types = types + 1; }
        } else if (kind == 3) {
            instances = instances + 1;
        }
        var skip: TxR = wit_tx_decl(tbody, p, none);
        p = skip.next;
        i = i + 1;
    }
    return WitPrefixLayout { types: types, instances: instances };
}

// wit_import_instance_index returns the instance index `iface` lands at among
// the world's import decls, or -1.
function wit_import_instance_index(tbody: i32[], iface: string): i32 {
    var none: i32[] = [];
    var rc: UlebRead = wit_read_uleb(tbody, 0);
    var p: i32 = rc.next;
    p = p + 1;
    var oc: UlebRead = wit_read_uleb(tbody, p);
    p = oc.next;
    p = p + 1;
    p = p + 1;
    var wc: UlebRead = wit_read_uleb(tbody, p);
    var wcount: i32 = wc.value;
    p = wc.next;
    var idx: i32 = 0;
    var result: i32 = 0 - 1;
    var found: boolean = false;
    var i: i32 = 0;
    while (i < wcount) {
        var kind: i32 = tbody[p];
        if (kind == 3) {
            if (!found) {
                var nr: NameR = wit_read_name(tbody, p + 2);
                if (nr.s == iface) {
                    result = idx;
                    found = true;
                }
                idx = idx + 1;
            }
        }
        var skip: TxR = wit_tx_decl(tbody, p, none);
        p = skip.next;
        i = i + 1;
    }
    return result;
}

// ---- P2 slice: parse a core module's function imports --------------------
//
// Self-host mirror of component.coreFuncImports: walk a core wasm module's
// type + import sections and return each function import with its param
// valtypes (the trampoline signature a memory lowering mirrors). Parallel
// arrays: ifaces[i] / names[i] / params[i].

struct WitCoreImports { ifaces: string[], names: string[], params: i32[][] }

function wit_core_func_imports(bin: i32[]): WitCoreImports {
    // pass 1: functype params from the type section (id 1).
    var typeParams: i32[][] = [];
    var off: i32 = 8;
    var doneTypes: boolean = false;
    while (off < bin.len() && !doneTypes) {
        var id: i32 = bin[off];
        off = off + 1;
        var sr: UlebRead = wit_read_uleb(bin, off);
        var size: i32 = sr.value;
        off = sr.next;
        var body: i32 = off;
        off = off + size;
        if (id == 1) {
            var cr: UlebRead = wit_read_uleb(bin, body);
            var count: i32 = cr.value;
            var p: i32 = cr.next;
            var i: i32 = 0;
            while (i < count) {
                p = p + 1;
                var pr: UlebRead = wit_read_uleb(bin, p);
                var pc: i32 = pr.value;
                p = pr.next;
                var params: i32[] = [];
                var j: i32 = 0;
                while (j < pc) {
                    params = params.append(bin[p]);
                    p = p + 1;
                    j = j + 1;
                }
                var rr: UlebRead = wit_read_uleb(bin, p);
                var rcount: i32 = rr.value;
                p = rr.next;
                var k: i32 = 0;
                while (k < rcount) {
                    p = p + 1;
                    k = k + 1;
                }
                typeParams = typeParams.append(params);
                i = i + 1;
            }
            doneTypes = true;
        }
    }
    // pass 2: import section (id 2) -> func imports with their type's params.
    var ifaces: string[] = [];
    var names: string[] = [];
    var params2: i32[][] = [];
    off = 8;
    var doneImports: boolean = false;
    while (off < bin.len() && !doneImports) {
        var id2: i32 = bin[off];
        off = off + 1;
        var sr2: UlebRead = wit_read_uleb(bin, off);
        var size2: i32 = sr2.value;
        off = sr2.next;
        var body2: i32 = off;
        off = off + size2;
        if (id2 == 2) {
            var cr2: UlebRead = wit_read_uleb(bin, body2);
            var count2: i32 = cr2.value;
            var p: i32 = cr2.next;
            var i2: i32 = 0;
            while (i2 < count2) {
                var mr: NameR = wit_read_name(bin, p);
                p = mr.next;
                var fr: NameR = wit_read_name(bin, p);
                p = fr.next;
                var kind: i32 = bin[p];
                p = p + 1;
                if (kind == 0) {
                    var tr: UlebRead = wit_read_uleb(bin, p);
                    p = tr.next;
                    var none: i32[] = [];
                    var pp: i32[] = none;
                    if (tr.value < typeParams.len()) { pp = typeParams[tr.value]; }
                    ifaces = ifaces.append(mr.s);
                    names = names.append(fr.s);
                    params2 = params2.append(pp);
                } else if (kind == 1) {
                    p = p + 2;
                    var lr: UlebRead = wit_read_uleb(bin, p);
                    p = lr.next;
                } else if (kind == 2) {
                    var flag: i32 = bin[p];
                    p = p + 1;
                    var l1: UlebRead = wit_read_uleb(bin, p);
                    p = l1.next;
                    if (flag == 1) {
                        var l2: UlebRead = wit_read_uleb(bin, p);
                        p = l2.next;
                    }
                } else {
                    p = p + 2;
                }
                i2 = i2 + 1;
            }
            doneImports = true;
        }
    }
    return WitCoreImports { ifaces: ifaces, names: names, params: params2 };
}
