        s = s.write("    cmovlq %r9, %rax\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    jmp .Lai32_min_loop\n");
        s = s.write(".Lai32_min_done:\n");
        s = s.write("    ret\n");
        s = s.write("__fern_arr_i32_max:\n");
        s = s.write("    movq (%rdi), %rcx\n");
        s = s.write("    movq 8(%rdi), %rax\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write(".Lai32_max_loop:\n");
        s = s.write("    cmpq %rcx, %rdx\n");
        s = s.write("    jge .Lai32_max_done\n");
        s = s.write("    movq %rdx, %r8\n");
        s = s.write("    incq %r8\n");
        s = s.write("    movq (%rdi,%r8,8), %r9\n");
        s = s.write("    cmpq %rax, %r9\n");
        s = s.write("    cmovgq %r9, %rax\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    jmp .Lai32_max_loop\n");
        s = s.write(".Lai32_max_done:\n");
        s = s.write("    ret\n");
    }
    // __fern_i32_pow: %rdi = base, %rsi = exp. Returns
    // %rax = base^exp. Negative exp returns 1 (UB-ish, but
    // matches the language's no-runtime-check stance —
    // integer pow with negative exp is undefined for i32).
    if (s.has_need("i32_pow")) {
        s = s.write("__fern_i32_pow:\n");
        s = s.write("    movq $1, %rax\n");        // result
        s = s.write(".Lpow_loop:\n");
        s = s.write("    cmpq $0, %rsi\n");
        s = s.write("    jle .Lpow_done\n");
        s = s.write("    imulq %rdi, %rax\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    jmp .Lpow_loop\n");
        s = s.write(".Lpow_done:\n");
        s = s.write("    ret\n");
    }
    // __fern_str_reverse: %rdi = src box. Returns %rax =
    // new string box with bytes in reverse order.
    if (s.has_need("str_reverse")) {
        s = s.write("__fern_str_reverse:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq (%rdi), %r12\n");      // src data
        s = s.write("    movq 8(%rdi), %r13\n");     // src len
        // alloc new data buffer
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r14\n");        // dst data
        // reverse copy
        s = s.write("    movq $0, %r15\n");          // i
        s = s.write(".Lstr_rev_loop:\n");
        s = s.write("    cmpq %r13, %r15\n");
        s = s.write("    jge .Lstr_rev_done\n");
        s = s.write("    movq %r13, %rcx\n");
        s = s.write("    subq %r15, %rcx\n");
        s = s.write("    decq %rcx\n");             // src idx = len-1-i
        s = s.write("    movzbq (%r12,%rcx,1), %rax\n");
        s = s.write("    movb %al, (%r14,%r15,1)\n");
        s = s.write("    incq %r15\n");
        s = s.write("    jmp .Lstr_rev_loop\n");
        s = s.write(".Lstr_rev_done:\n");
        // alloc box
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r14, (%rax)\n");
        s = s.write("    movq %r13, 8(%rax)\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_str_bytes: %rdi = source string box. Returns
    // %rax = i32[] of byte values (each zero-extended to 8
    // bytes in the array's uniform 8-byte slot).
    if (s.has_need("str_bytes")) {
        s = s.write("__fern_str_bytes:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq (%rdi), %r12\n");      // src data
        s = s.write("    movq 8(%rdi), %r13\n");     // src len
        // alloc (len + 2) * 8 (extra word for the hidden cap)
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    addq $2, %rdi\n");
        s = s.write("    shlq $3, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r14\n");        // arr base
        s = s.write("    movq %r13, (%r14)\n");      // cap
        s = s.write("    addq $8, %r14\n");          // shift to base+8
        s = s.write("    movq %r13, (%r14)\n");      // len
        s = s.write("    movq $0, %r15\n");          // i
        s = s.write(".Lbytes_loop:\n");
        s = s.write("    cmpq %r13, %r15\n");
        s = s.write("    jge .Lbytes_done\n");
        s = s.write("    movzbq (%r12,%r15,1), %rcx\n");
        s = s.write("    movq %r15, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq %rcx, (%r14,%rdx,8)\n");
        s = s.write("    incq %r15\n");
        s = s.write("    jmp .Lbytes_loop\n");
        s = s.write(".Lbytes_done:\n");
        s = s.write("    movq %r14, %rax\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_str_chars: %rdi = source string box. Returns
    // %rax = string[] of 1-byte string boxes. Each box reuses
    // the source's data pointer at the appropriate offset
    // (no per-char byte alloc) and length 1.
    if (s.has_need("str_chars")) {
        s = s.write("__fern_str_chars:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    subq $16, %rsp\n");        // align + slot for i
        s = s.write("    movq %rdi, %r12\n");       // src box
        s = s.write("    movq (%r12), %r13\n");     // src data
        s = s.write("    movq 8(%r12), %r14\n");    // src len
        // alloc array (len + 2) * 8 (extra word for the hidden cap)
        s = s.write("    movq %r14, %rdi\n");
        s = s.write("    addq $2, %rdi\n");
        s = s.write("    shlq $3, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r15\n");       // arr base
        s = s.write("    movq %r14, (%r15)\n");     // cap
        s = s.write("    addq $8, %r15\n");         // shift to base+8
        s = s.write("    movq %r14, (%r15)\n");     // arr.len
        s = s.write("    movq $0, -40(%rbp)\n");    // i
        s = s.write(".Lchars_loop:\n");
        s = s.write("    movq -40(%rbp), %rcx\n");
        s = s.write("    cmpq %r14, %rcx\n");
        s = s.write("    jge .Lchars_done\n");
        // alloc 16-byte box
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        // box[0] = src_data + i
        s = s.write("    movq -40(%rbp), %rcx\n");
        s = s.write("    movq %r13, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    movq %rdx, (%rax)\n");
        // box[1] = 1
        s = s.write("    movq $1, 8(%rax)\n");
        // arr[i+1] = box
        s = s.write("    movq -40(%rbp), %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %rax, (%r15,%rcx,8)\n");
        s = s.write("    incq -40(%rbp)\n");
        s = s.write("    jmp .Lchars_loop\n");
        s = s.write(".Lchars_done:\n");
        s = s.write("    movq %r15, %rax\n");
        s = s.write("    addq $16, %rsp\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_i32_product: %rdi = i32-array ptr. Returns
    // %rax = product of all elements (1 if empty — matches
    // the mathematical empty-product identity). Leaf.
    if (s.has_need("arr_i32_product")) {
        s = s.write("__fern_arr_i32_product:\n");
        s = s.write("    movq (%rdi), %rcx\n");      // len
        s = s.write("    movq $1, %rax\n");          // product
        s = s.write("    movq $0, %rdx\n");          // i
        s = s.write(".Lai32_prod_loop:\n");
        s = s.write("    cmpq %rcx, %rdx\n");
        s = s.write("    jge .Lai32_prod_done\n");
        s = s.write("    movq %rdx, %r8\n");
        s = s.write("    incq %r8\n");
        s = s.write("    imulq (%rdi,%r8,8), %rax\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    jmp .Lai32_prod_loop\n");
        s = s.write(".Lai32_prod_done:\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_i32_sum: %rdi = i32-array ptr. Returns %rax
    // = sum of all elements (0 if empty). Leaf — no frame.
    if (s.has_need("arr_i32_sum")) {
        s = s.write("__fern_arr_i32_sum:\n");
        s = s.write("    movq (%rdi), %rcx\n");      // len
        s = s.write("    movq $0, %rax\n");          // sum
        s = s.write("    movq $0, %rdx\n");          // i
        s = s.write(".Lai32_sum_loop:\n");
        s = s.write("    cmpq %rcx, %rdx\n");
        s = s.write("    jge .Lai32_sum_done\n");
        s = s.write("    movq %rdx, %r8\n");
        s = s.write("    incq %r8\n");
        s = s.write("    addq (%rdi,%r8,8), %rax\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    jmp .Lai32_sum_loop\n");
        s = s.write(".Lai32_sum_done:\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_str_index_of: %rdi = string-array ptr,
    // %rsi = target string-box ptr. Returns %rax = first index
    // where __fern_str_eq(arr[i], target) is true, or -1.
    if (s.has_need("arr_str_index_of")) {
        s = s.write("__fern_arr_str_index_of:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");      // arr
        s = s.write("    movq %rsi, %r13\n");      // target
        s = s.write("    movq (%r12), %r14\n");    // len
        s = s.write("    movq $0, %r15\n");        // i
        s = s.write(".Las_idx_loop:\n");
        s = s.write("    cmpq %r14, %r15\n");
        s = s.write("    jge .Las_idx_notfound\n");
        s = s.write("    movq %r15, %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq (%r12,%rcx,8), %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    call __fern_str_eq\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jnz .Las_idx_found\n");
        s = s.write("    incq %r15\n");
        s = s.write("    jmp .Las_idx_loop\n");
        s = s.write(".Las_idx_found:\n");
        s = s.write("    movq %r15, %rax\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        s = s.write(".Las_idx_notfound:\n");
        s = s.write("    movq $-1, %rax\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_i32_index_of: %rdi = arr ptr, %rsi = target val.
    // Returns %rax = first index where arr[i] == val, or -1.
    if (s.has_need("arr_i32_index_of")) {
        s = s.write("__fern_arr_i32_index_of:\n");
        s = s.write("    movq (%rdi), %rdx\n");      // len
        s = s.write("    movq $0, %rcx\n");          // i
        s = s.write(".Lai32_idx_loop:\n");
        s = s.write("    cmpq %rdx, %rcx\n");
        s = s.write("    jge .Lai32_idx_notfound\n");
        s = s.write("    movq %rcx, %r8\n");
        s = s.write("    incq %r8\n");
        s = s.write("    movq (%rdi,%r8,8), %r9\n");
        s = s.write("    cmpq %rsi, %r9\n");
        s = s.write("    je .Lai32_idx_found\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lai32_idx_loop\n");
        s = s.write(".Lai32_idx_found:\n");
        s = s.write("    movq %rcx, %rax\n");
        s = s.write("    ret\n");
        s = s.write(".Lai32_idx_notfound:\n");
        s = s.write("    movq $-1, %rax\n");
        s = s.write("    ret\n");
    }
    return s;
}

pub function emit_module(mod: parser.Module): string {
    // Reset the global strbuf before any .write calls. Output is
    // accumulated there (amortised O(1) per append) and materialised
    // into a fresh string at the tail via strbuf_take().
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // Seed the struct-decl table so emit_expr's ExprStructLit
    // / ExprFieldAccess paths can look up field layout. Builtin enum
    // injection (JsonValue / IoError) happens in the driver via
    // parser.module_with_builtins, so emit_module stays pure.
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    // Type-check before codegen. On any diagnostic, report and abort —
    // emitting assembly for ill-typed input would miscompile silently.
    var check_errs: string = asmcore.check_module(mod, s);
    if (check_errs.len() > 0) {
        eprint(check_errs);
        exit(1);
        return "";
    }
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own label
    // (__fn_<name>:); _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    // _start: program entry point. If main() exists, call it
    // and use its return value as the exit code. Otherwise
    // run top-level stmts directly.
    s = s.write("_start:\n");
    // If args_count() / arg_at() were used, save argc + argv
    // from the initial stack BEFORE any push (the kernel
    // places argc at the top of the stack on entry).
    if (s.has_need("args")) {
        s = s.write("    movq (%rsp), %rax\n");
        s = s.write("    movq %rax, __fern_argc(%rip)\n");
        s = s.write("    leaq 8(%rsp), %rax\n");
        s = s.write("    movq %rax, __fern_argv(%rip)\n");
    }
    // Save envp for env(). It follows argv's NULL terminator on the
    // entry stack: envp = rsp + 16 + argc*8 (argc at [rsp], argv at
    // rsp+8 with argc+1 slots incl. the NULL). Gated on needs_heap —
    // the env() runtime helper allocates, so it only links when the
    // heap is present, and any program calling env() marks the heap.
    if (s.has_need("heap")) {
        s = s.write("    movq (%rsp), %rax\n");            // argc
        s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");   // envp base
        s = s.write("    movq %rax, __fern_envp(%rip)\n");
    }
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    if (asmcore.has_main(mod)) {
        // call __fn_main; exit with %rax.
        s = s.write("    call __fn_main\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    } else {
        var n_locals: i32 = asmcore.count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    subq $" + asmcore.i32_to_string(bytes) + ", %rsp\n");
        }
        var i: i32 = 0;
        while (i < mod.top_stmts.len()) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit (in case there's no return).
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    s = emit_runtime(s);
    // s.out is always empty by design (writes route through the
    // strbuf primitive instead). Materialise the accumulated bytes.
    return strbuf_take();
}


function emit_source(src: string): string {
    return emit_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // Minimal: `return 42;` should produce asm that contains the
    // literal `$42`, a `pushq` of it, the syscall epilogue with
    // `$60` (sys_exit_group), and `syscall`.
    var a1: string = emit_source("return 42;");
    if (!asmcore.contains(a1, "movq $42")) { return 10; }
    if (!asmcore.contains(a1, "pushq %rax")) { return 11; }
    if (!asmcore.contains(a1, "popq %rdi")) { return 12; }
    if (!asmcore.contains(a1, "movq $60, %rax")) { return 13; }
    if (!asmcore.contains(a1, "syscall")) { return 14; }
    if (!asmcore.contains(a1, ".globl _start")) { return 15; }

    // Arithmetic: `return 2 + 3;` should emit addq.
    var a2: string = emit_source("return 2 + 3;");
    if (!asmcore.contains(a2, "movq $2")) { return 20; }
    if (!asmcore.contains(a2, "movq $3")) { return 21; }
    if (!asmcore.contains(a2, "addq")) { return 22; }

    // Subtraction.
    var a3: string = emit_source("return 7 - 4;");
    if (!asmcore.contains(a3, "subq")) { return 30; }

    // Multiplication.
    var a4: string = emit_source("return 6 * 7;");
    if (!asmcore.contains(a4, "imulq")) { return 40; }

    // Division — emits cqto for sign-extension + idivq.
    var a5: string = emit_source("return 20 / 4;");
    if (!asmcore.contains(a5, "cqto")) { return 50; }
    if (!asmcore.contains(a5, "idivq")) { return 51; }

    // Modulo — moves remainder from rdx into rax.
    var a6: string = emit_source("return 23 % 5;");
    if (!asmcore.contains(a6, "cqto")) { return 60; }
    if (!asmcore.contains(a6, "idivq")) { return 61; }
    if (!asmcore.contains(a6, "movq %rdx, %rax")) { return 62; }

    // Unary negation.
    var a7: string = emit_source("return -5;");
    if (!asmcore.contains(a7, "negq")) { return 70; }

    // Nested expressions: `return (2 + 3) * 4;` — should have
    // an addq before the imulq (left subtree fully emitted
    // first).
    var a8: string = emit_source("return (2 + 3) * 4;");
    if (!asmcore.contains(a8, "addq")) { return 80; }
    if (!asmcore.contains(a8, "imulq")) { return 81; }

    // Comparisons: each op emits `cmpq` + the matching setcc +
    // a movzbq zero-extension. Result is a 0 or 1 on the rt
    // stack, suitable as an i32 exit code.
    var a9: string = emit_source("return 5 < 10;");
    if (!asmcore.contains(a9, "cmpq")) { return 90; }
    if (!asmcore.contains(a9, "setl")) { return 91; }
    if (!asmcore.contains(a9, "movzbq")) { return 92; }

    var a10: string = emit_source("return 5 <= 5;");
    if (!asmcore.contains(a10, "setle")) { return 100; }

    var a11: string = emit_source("return 7 > 3;");
    if (!asmcore.contains(a11, "setg")) { return 110; }

    var a12: string = emit_source("return 7 >= 7;");
    if (!asmcore.contains(a12, "setge")) { return 120; }

    var a13: string = emit_source("return 4 == 4;");
    if (!asmcore.contains(a13, "sete")) { return 130; }

    var a14: string = emit_source("return 4 != 5;");
    if (!asmcore.contains(a14, "setne")) { return 140; }

    // If/else: emits `cmpq $0`, `je .L0`, the then-block, `jmp
    // .L1`, `.L0:`, the else-block, `.L1:`.
    var a15: string = emit_source("if (true) { return 1; } else { return 2; }");
    if (!asmcore.contains(a15, "cmpq $0")) { return 150; }
    if (!asmcore.contains(a15, "je .L")) { return 151; }
    if (!asmcore.contains(a15, "jmp .L")) { return 152; }
    if (!asmcore.contains(a15, ".L0:")) { return 153; }
    if (!asmcore.contains(a15, ".L1:")) { return 154; }

    // No-else if: only the cond-fail jump label, no second jmp.
    var a16: string = emit_source("if (true) { return 1; } return 0;");
    if (!asmcore.contains(a16, "cmpq $0")) { return 160; }
    if (!asmcore.contains(a16, "je .L")) { return 161; }

    // While: emits top label, cond, je exit, body, jmp top,
    // exit label.
    var a17: string = emit_source("while (1 < 2) { return 0; }");
    if (!asmcore.contains(a17, "cmpq $0")) { return 170; }
    if (!asmcore.contains(a17, "je .L")) { return 171; }
    if (!asmcore.contains(a17, "jmp .L")) { return 172; }

    // Locals: frame prologue + slot store + slot load. `var x =
    // 5; return x;` should pushq %rbp, subq the frame, then
    // movq the literal into -8(%rbp), then pushq from -8(%rbp).
    var a18: string = emit_source("var x = 5; return x;");
    if (!asmcore.contains(a18, "pushq %rbp")) { return 180; }
    if (!asmcore.contains(a18, "movq %rsp, %rbp")) { return 181; }
    if (!asmcore.contains(a18, "subq $")) { return 182; }
    if (!asmcore.contains(a18, "movq %rax, -8(%rbp)")) { return 183; }
    if (!asmcore.contains(a18, "pushq -8(%rbp)")) { return 184; }

    // Multiple locals get distinct slots: -8, -16, -24, ...
    var a19: string = emit_source("var a = 1; var b = 2; var c = 3; return c;");
    if (!asmcore.contains(a19, "movq %rax, -8(%rbp)")) { return 190; }
    if (!asmcore.contains(a19, "movq %rax, -16(%rbp)")) { return 191; }
    if (!asmcore.contains(a19, "movq %rax, -24(%rbp)")) { return 192; }
    if (!asmcore.contains(a19, "pushq -24(%rbp)")) { return 193; }

    // Re-assignment: `x = x + 1;` reads + writes the same slot.
    var a20: string = emit_source("var x = 5; x = x + 1; return x;");
    if (!asmcore.contains(a20, "pushq -8(%rbp)")) { return 200; }
    if (!asmcore.contains(a20, "movq %rax, -8(%rbp)")) { return 201; }
    if (!asmcore.contains(a20, "addq")) { return 202; }

    // Compound assign desugars: `x += 1` → `x = x + 1` so the
    // asm shape is identical.
    var a21: string = emit_source("var x = 0; x += 7; return x;");
    if (!asmcore.contains(a21, "addq")) { return 210; }
    if (!asmcore.contains(a21, "movq %rax, -8(%rbp)")) { return 211; }

    // Counter loop: `var i = 0; while (i < 3) { i = i + 1; }
    // return i;` exercises locals + branches together.
    var a22: string = emit_source(
        "var i = 0; while (i < 3) { i = i + 1; } return i;"
    );
    if (!asmcore.contains(a22, "pushq -8(%rbp)")) { return 220; }
    if (!asmcore.contains(a22, "je .L")) { return 221; }
    if (!asmcore.contains(a22, "jmp .L")) { return 222; }

    // Function decl + call: emits __fn_add label, calls from
    // main, has leave + ret in the body, and _start calls
    // __fn_main.
    var a23: string = emit_source(
        "function add(x: i32, y: i32): i32 { return x + y; }"
        + " function main(): i32 { return add(2, 3); }"
    );
    if (!asmcore.contains(a23, "__fn_add:")) { return 230; }
    if (!asmcore.contains(a23, "__fn_main:")) { return 231; }
    if (!asmcore.contains(a23, "call __fn_add")) { return 232; }
    if (!asmcore.contains(a23, "call __fn_main")) { return 233; }
    if (!asmcore.contains(a23, "leave")) { return 234; }
    if (!asmcore.contains(a23, "ret\n")) { return 235; }

    // print("...") lowers to a write syscall + emits the
    // literal in .rodata at label .S0.
    var a24: string = emit_source("print(\"hi\\n\"); return 0;");
    if (!asmcore.contains(a24, "leaq .S0(%rip)")) { return 240; }
    if (!asmcore.contains(a24, "movq $1, %rdi")) { return 241; }
    if (!asmcore.contains(a24, "movq $1, %rax")) { return 242; }  // sys_write
    if (!asmcore.contains(a24, ".section .rodata")) { return 243; }
    if (!asmcore.contains(a24, ".S0: .ascii")) { return 244; }
    if (!asmcore.contains(a24, "hi")) { return 245; }

    // print_int(N) emits a call to the __fern_print_int helper,
    // which the module appends once at the end of .text.
    var a25: string = emit_source("print_int(42); return 0;");
    if (!asmcore.contains(a25, "call __fern_print_int")) { return 250; }
    if (!asmcore.contains(a25, "__fern_print_int:")) { return 251; }
    if (!asmcore.contains(a25, ".Lpi_div:")) { return 252; }

    // read_int() emits a call to the __fern_read_int helper,
    // which the module appends once at the end of .text.
    var a26: string = emit_source("return read_int();");
    if (!asmcore.contains(a26, "call __fern_read_int")) { return 260; }
    if (!asmcore.contains(a26, "__fern_read_int:")) { return 261; }
    if (!asmcore.contains(a26, ".Lri_loop:")) { return 262; }

    return 0;
}
