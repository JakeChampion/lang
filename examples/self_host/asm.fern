                var outer_off: i32 = s.lookup_local(caps[oi]);
                s = s.write("    movq " + i32_to_string(outer_off) + "(%rbp), %rcx\n");
                s = s.write("    movq %rcx, " + i32_to_string((oi + 1) * 8) + "(%rax)\n");
                oi = oi + 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    # parser-side unknown\n");
            s = s.write("    pushq $0\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: EmitState): EmitState {
    var i: i32 = 0;
    while (i < body.len()) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

// emit_map_kv_for emits a `for (k, v) in m` loop (the var name is
// "k,v"; kv_comma is the comma index). Iterates the map's parallel
// keys[]/values[] arrays by index, binding k = keys[i+1], v =
// values[i+1]. A separate function so emit_stmt's StmtFor arm stays
// small.
function emit_map_kv_for(s: EmitState, f: parser.StmtFor, kv_comma: i32): EmitState {
    var iter_ty: string = infer_expr_type(f.iter, s);
    var kvk: string = f.var_name[0 : kv_comma];
    var kvv: string = f.var_name[kv_comma + 1 : f.var_name.len()];
    var kvk_ty: string = "string";
    if (map_key_is_i32(iter_ty)) { kvk_ty = "i32"; }
    var kvv_ty: string = map_value_part(iter_ty);
    s = emit_expr(f.iter, s);
    var kvm_name: string = "__forkv_map_" + i32_to_string(s.label_n);
    s = s.bind_local(kvm_name);
    var kvm_off: i32 = s.lookup_local(kvm_name);
    s = s.write("    popq %rax\n");
    s = s.write("    movq %rax, " + i32_to_string(kvm_off) + "(%rbp)\n");
    var kvi_name: string = "__forkv_i_" + i32_to_string(s.label_n);
    s = s.bind_local(kvi_name);
    var kvi_off: i32 = s.lookup_local(kvi_name);
    s = s.write("    movq $0, " + i32_to_string(kvi_off) + "(%rbp)\n");
    s = s.bind_local_typed(kvk, kvk_ty);
    var kvk_off: i32 = s.lookup_local(kvk);
    s = s.bind_local_typed(kvv, kvv_ty);
    var kvv_off: i32 = s.lookup_local(kvv);
    var kvtop: LabelOut = fresh_label(s);
    s = kvtop.state;
    var kvcont: LabelOut = fresh_label(s);
    s = kvcont.state;
    var kvend: LabelOut = fresh_label(s);
    s = kvend.state;
    s = s.write(kvtop.name + ":\n");
    s = s.write("    movq " + i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");   // keys arr
    s = s.write("    movq (%rcx), %rcx\n");   // keys.len
    s = s.write("    movq " + i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    cmpq %rcx, %rdx\n");
    s = s.write("    jge " + kvend.name + "\n");
    s = s.write("    movq " + i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");   // keys arr
    s = s.write("    movq " + i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rcx,%rdx,8), %rax\n");   // keys[i+1]
    s = s.write("    movq %rax, " + i32_to_string(kvk_off) + "(%rbp)\n");
    s = s.write("    movq " + i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq 8(%rax), %rcx\n");   // values arr
    s = s.write("    movq " + i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rcx,%rdx,8), %rax\n");   // values[i+1]
    s = s.write("    movq %rax, " + i32_to_string(kvv_off) + "(%rbp)\n");
    s = s.push_loop_labels(kvend.name, kvcont.name);
    var kvbi: i32 = 0;
    while (kvbi < f.body.len()) {
        s = emit_stmt(f.body[kvbi], s);
        kvbi = kvbi + 1;
    }
    s = s.pop_loop_labels();
    s = s.write(kvcont.name + ":\n");
    s = s.write("    movq " + i32_to_string(kvi_off) + "(%rbp), %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rax, " + i32_to_string(kvi_off) + "(%rbp)\n");
    s = s.write("    jmp " + kvtop.name + "\n");
    s = s.write(kvend.name + ":\n");
    return s;
}

function emit_stmt(stmt: parser.Stmt, s: EmitState): EmitState {
    match (stmt) {
        // StmtDefer is lowered away (parser.lower_defers) before emit; this
        // arm only satisfies exhaustiveness.
        parser.StmtDefer(_) => { return s.write("    # unsupported: StmtDefer survived lowering\n"); },
        parser.StmtReturn(r) => {
            s = emit_expr(r.value, s);
            if (s.in_function) {
                // Function return: result in %rax, restore
                // caller's frame, ret.
                s = s.write("    popq %rax\n");
                s = s.write("    leave\n");
                s = s.write("    ret\n");
            } else {
                // Top-level return: lower to sys_exit_group so
                // the program terminates with the right exit
                // code.
                s = s.write("    popq %rdi\n");
                s = s.write("    movq $60, %rax\n");
                s = s.write("    syscall\n");
            }
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; popq %rax; cmpq $0, %rax; je <else_lbl>
            //   <then-body>; jmp <end_lbl>
            // <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            var else_l: LabelOut = fresh_label(s);
            s = else_l.state;
            s = s.write("    je " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (ifs.else_body.len() > 0) {
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; popq %rax; cmpq $0, %rax;
            //            je <exit_lbl>
            //            <body>; jmp <top_lbl>
            // <exit_lbl>:
            //
            // break inside the body jumps to <exit_lbl>;
            // continue jumps to <top_lbl> (re-evaluate cond).
            var top_l: LabelOut = fresh_label(s);
            s = top_l.state;
            var exit_l: LabelOut = fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    je " + exit_l.name + "\n");
            s = s.push_loop_labels(exit_l.name, top_l.name);
            s = emit_block(w.body, s);
            s = s.pop_loop_labels();
            s = s.write("    jmp " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(v) => {
            // `var (a, b) = E` tuple destructuring (name encoded "a,b"):
            // eval the tuple box, bind a = box[0], b = box[8].
            var tdc: i32 = 0 - 1;
            var tdci: i32 = 0;
            while (tdci < v.name.len()) {
                if (v.name[tdci] == 44 && tdc < 0) { tdc = tdci; }
                tdci = tdci + 1;
            }
            if (tdc >= 0) {
                var tda: string = v.name[0 : tdc];
                var tdb: string = v.name[tdc + 1 : v.name.len()];
                var tdtags: TwoTags = tuple_destructure_tags(v.init, s);
                s = emit_expr(v.init, s);
                s = s.write("    popq %rax\n");          // tuple box
                s = s.bind_local_typed(tda, tdtags.a);
                var tda_off: i32 = s.lookup_local(tda);
                s = s.write("    movq (%rax), %rcx\n");  // box.0
                s = s.write("    movq %rcx, " + i32_to_string(tda_off) + "(%rbp)\n");
                s = s.bind_local_typed(tdb, tdtags.b);
                var tdb_off: i32 = s.lookup_local(tdb);
                s = s.write("    movq 8(%rax), %rcx\n"); // box.1
                s = s.write("    movq %rcx, " + i32_to_string(tdb_off) + "(%rbp)\n");
                return s;
            }
            // Compile init, then pop to the new local's slot.
            // Infer init's type so the local carries it (used
            // by string-aware dispatch in ExprBinary / len /
            // print etc.). An explicit annotation overrides
            // the inference. bind_local_typed binds the name
            // BEFORE the lookup_local call resolves the slot.
            var ity: string = infer_expr_type(v.init, s);
            if (v.type_name.len() > 0) {
                ity = ret_tag_of(v.type_name);
            }
            s = emit_expr(v.init, s);
            s = s.bind_local_typed(v.name, ity);
            var off: i32 = s.lookup_local(v.name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtAssign(a) => {
            if (!s.has_local(a.target)) {
                s = s.write("    # unresolved assign: " + a.target + "\n");
                return s;
            }
            s = emit_expr(a.value, s);
            var off: i32 = s.lookup_local(a.target);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtExpr(x) => {
            // Evaluate for side effects, drop the result.
            s = emit_expr(x.value, s);
            s = s.write("    popq %rax\n");
            return s;
        },
        parser.StmtMatch(m) => {
            // Lowering: eval the scrutinee, save into a fresh
            // local slot (so each arm can reload it without
            // worrying about %rax being clobbered by inner ops).
            // Then for each arm, emit:
            //   PatVariant: load shape ptr, compare to interned
            //   struct name, jump to next arm on mismatch. On
            //   match, bind `binding` to the scrutinee value
            //   (if non-empty), execute body, jump to end.
            //   PatWildcard: always match, no dispatch.
            // No exhaustiveness check — that's the checker's job.
            s = emit_expr(m.scrutinee, s);
            // Allocate the synthetic scrutinee slot.
            var scrut_name: string = "__match_scrut_" + i32_to_string(s.label_n);
            s = s.bind_local(scrut_name);
            var scrut_off: i32 = s.lookup_local(scrut_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(scrut_off) + "(%rbp)\n");
            // Bump the label counter for end-of-match.
            var end_lbl: i32 = s.label_n;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 1,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs,
                local_types: s.local_types,
                needs_str_concat: s.needs_str_concat,
                needs_str_eq: s.needs_str_eq,
                needs_str_print: s.needs_str_print,
                needs_str_cmp: s.needs_str_cmp,
                needs_str_read_line: s.needs_str_read_line,
                needs_i32_to_string: s.needs_i32_to_string,
                needs_str_to_i32: s.needs_str_to_i32,
                needs_eprint: s.needs_eprint,
                needs_str_search: s.needs_str_search,
                needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
            };
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[ai];
                var next_lbl: i32 = s.label_n;
                s = EmitState {
                    out: s.out,
                    label_n: s.label_n + 1,
                    local_names: s.local_names,
                    in_function: s.in_function,
                    string_lits: s.string_lits,
                    needs_print_int: s.needs_print_int,
                    needs_read_int: s.needs_read_int,
                    needs_heap: s.needs_heap,
                    struct_decls: s.struct_decls,
                    loop_exit_labels: s.loop_exit_labels,
                    loop_cont_labels: s.loop_cont_labels,
                    funcs: s.funcs,
                    local_types: s.local_types,
                    needs_str_concat: s.needs_str_concat,
                    needs_str_eq: s.needs_str_eq,
                    needs_str_print: s.needs_str_print,
                    needs_str_cmp: s.needs_str_cmp,
                    needs_str_read_line: s.needs_str_read_line,
                    needs_i32_to_string: s.needs_i32_to_string,
                    needs_str_to_i32: s.needs_str_to_i32,
                    needs_eprint: s.needs_eprint,
                    needs_str_search: s.needs_str_search,
                    needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
                };
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.type_name == "true" || pv.type_name == "false") {
                            // `match (b) { true => …, false => … }`: the
                            // scrutinee is the bool itself (0/1), not a box.
                            s = s.write("    movq " + i32_to_string(scrut_off) + "(%rbp), %rax\n");
                            s = s.write("    testq %rax, %rax\n");
                            if (pv.type_name == "true") {
                                s = s.write("    jz .Lmatch_next_" + i32_to_string(next_lbl) + "\n");
                            } else {
                                s = s.write("    jnz .Lmatch_next_" + i32_to_string(next_lbl) + "\n");
                            }
                        } else if (pv.type_name == "Some" || pv.type_name == "None"
                                || pv.type_name == "Ok" || pv.type_name == "Err") {
                            // Built-in Option / Result: discriminate on
                            // the i32 tag at offset 0 (Some/Ok=0,
                            // None/Err=1), not the struct shape pointer.
                            // The non-empty variant (Some/Ok) binds its
                            // PAYLOAD (offset 8), not the box.
                            s = s.write("    movq " + i32_to_string(scrut_off) + "(%rbp), %rax\n");
                            s = s.write("    movq (%rax), %rcx\n");
                            var want: i32 = 0;
                            if (pv.type_name == "None" || pv.type_name == "Err") { want = 1; }
                            s = s.write("    cmpq $" + i32_to_string(want) + ", %rcx\n");
                            s = s.write("    jne .Lmatch_next_" + i32_to_string(next_lbl) + "\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                s = s.write("    movq 8(%rax), %rcx\n");   // payload
                                // The only Option/Result producers here
                                // (read_chunk → Some, read_file → Ok) carry
                                // string payloads, so bind the payload as a
                                // string for print / concat dispatch.
                                s = s.bind_local_typed(pv.binding, match_payload_type(m.scrutinee, s));
                                var pbind_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rcx, " + i32_to_string(pbind_off) + "(%rbp)\n");
                            }
                        } else {
                        // Shape-pointer compare against pv.type_name.
                        s = s.write("    movq " + i32_to_string(scrut_off) + "(%rbp), %rax\n");
                        s = s.write("    movq (%rax), %rcx\n");
                        var nameLit: StringLitOut = add_string_lit(s, pv.type_name);
                        s = nameLit.state;
                        s = s.write("    leaq .S" + i32_to_string(nameLit.idx) + "(%rip), %rdx\n");
                        s = s.write("    cmpq %rdx, %rcx\n");
                        s = s.write("    jne .Lmatch_next_" + i32_to_string(next_lbl) + "\n");
                        if (pv.binding.len() > 0 && pv.binding != "_") {
                            if (is_enum_variant(pv.type_name, s)) {
                                // Enum variant `Circle(r)`: bind the
                                // PAYLOAD at offset 8 (typed via the
                                // "__ev" marker field), not the box.
                                s = s.write("    movq 8(%rax), %rcx\n");
                                s = s.bind_local_typed(pv.binding, field_type_tag_in(pv.type_name, "__ev", s));
                                var ev_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rcx, " + i32_to_string(ev_off) + "(%rbp)\n");
                            } else {
                                // `type X = A|B` union member: bind the
                                // whole struct, typed with the variant's
                                // struct name so a field read (`VString(s)
                                // => s.v`) resolves within that struct.
                                s = s.bind_local_typed(pv.binding, pv.type_name);
                                var bind_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rax, " + i32_to_string(bind_off) + "(%rbp)\n");
                            }
                        }
                        }
                    },
                    parser.PatWildcard(_) => {
                        // Wildcard always matches — no dispatch.
                    }
                }
                // Emit the arm body.
                var bi: i32 = 0;
                while (bi < arm.body.len()) {
                    s = emit_stmt(arm.body[bi], s);
                    bi = bi + 1;
                }
                s = s.write("    jmp .Lmatch_end_" + i32_to_string(end_lbl) + "\n");
                s = s.write(".Lmatch_next_" + i32_to_string(next_lbl) + ":\n");
                ai = ai + 1;
            }
            s = s.write(".Lmatch_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtFor(f) => {
            // Lowering desugar: `for x in arr { body }`
            //   var __for_arr_N = arr;
            //   var __for_i_N = 0;
            //   while (__for_i_N < len(__for_arr_N)) {
            //       var x = __for_arr_N[__for_i_N];
            //       body;
            //       __for_i_N = __for_i_N + 1;
            //   }
            //
            // Allocate three synthetic locals (array ptr, index,
            // element var). The index lives in a slot so the
            // body can read it for diagnostics; the iter
            // expression is hoisted into a slot so it isn't re-
            // evaluated each iteration (mirrors how `for` works
            // in higher-level languages — the iterator is
            // resolved once).
            // Infer container element type so the loop var
            // carries it (lets `for x in strs { print(x); }`
            // dispatch as string).
            var iter_ty: string = infer_expr_type(f.iter, s);
            // `for (k, v) in m` — the var name is "k,v"; iterate the
            // map's parallel keys[]/values[] arrays (see emit_map_kv_for).
            var kv_comma: i32 = 0 - 1;
            var kvci: i32 = 0;
            while (kvci < f.var_name.len()) {
                if (f.var_name[kvci] == 44 && kv_comma < 0) { kv_comma = kvci; }
                kvci = kvci + 1;
            }
            if (is_map(iter_ty) && kv_comma >= 0) {
                return emit_map_kv_for(s, f, kv_comma);
            }
            var elem_ty: string = "i32";
            if (iter_ty == "array_string") { elem_ty = "string"; }
            if (iter_ty == "array_u32") { elem_ty = "u32"; }
            if (iter_ty == "array_u64") { elem_ty = "u64"; }
            if (iter_ty == "array_i64") { elem_ty = "i64"; }
            s = emit_expr(f.iter, s);
            var arr_name: string = "__for_arr_" + i32_to_string(s.label_n);
            s = s.bind_local(arr_name);
            var arr_off: i32 = s.lookup_local(arr_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(arr_off) + "(%rbp)\n");
            var idx_name: string = "__for_i_" + i32_to_string(s.label_n);
            s = s.bind_local(idx_name);
            var idx_off: i32 = s.lookup_local(idx_name);
            s = s.write("    movq $0, " + i32_to_string(idx_off) + "(%rbp)\n");
            s = s.bind_local_typed(f.var_name, elem_ty);
            var elem_off: i32 = s.lookup_local(f.var_name);
            // Loop labels: top (cond), cont (i++), end (exit).
            var top_lbl: i32 = s.label_n;
            var cont_lbl: i32 = s.label_n + 1;
            var end_lbl: i32 = s.label_n + 2;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 3,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs,
                local_types: s.local_types,
                needs_str_concat: s.needs_str_concat,
                needs_str_eq: s.needs_str_eq,
                needs_str_print: s.needs_str_print,
                needs_str_cmp: s.needs_str_cmp,
                needs_str_read_line: s.needs_str_read_line,
                needs_i32_to_string: s.needs_i32_to_string,
                needs_str_to_i32: s.needs_str_to_i32,
                needs_eprint: s.needs_eprint,
                needs_str_search: s.needs_str_search,
                needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
            };
            s = s.write(".Lfor_top_" + i32_to_string(top_lbl) + ":\n");
            // Condition: __for_i_N < len(__for_arr_N).
            s = s.write("    movq " + i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq (%rax), %rcx\n");        // length
            s = s.write("    movq " + i32_to_string(idx_off) + "(%rbp), %rdx\n");
            s = s.write("    cmpq %rcx, %rdx\n");
            s = s.write("    jge .Lfor_end_" + i32_to_string(end_lbl) + "\n");
            // Bind element: x = arr[i].
            s = s.write("    movq " + i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq " + i32_to_string(idx_off) + "(%rbp), %rcx\n");
            s = s.write("    incq %rcx\n");
            s = s.write("    movq (%rax,%rcx,8), %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(elem_off) + "(%rbp)\n");
            // Body — break jumps to .Lfor_end; continue jumps
            // to .Lfor_cont (the i++ block) so the loop still
            // advances.
            s = s.push_loop_labels(".Lfor_end_" + i32_to_string(end_lbl), ".Lfor_cont_" + i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < f.body.len()) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + i32_to_string(cont_lbl) + ":\n");
            s = s.write("    movq " + i32_to_string(idx_off) + "(%rbp), %rax\n");
            s = s.write("    incq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(idx_off) + "(%rbp)\n");
            s = s.write("    jmp .Lfor_top_" + i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (lbl.len() == 0) { return s.write("    # break outside loop\n"); }
            return s.write("    jmp " + lbl + "\n");
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (lbl.len() == 0) { return s.write("    # continue outside loop\n"); }
            return s.write("    jmp " + lbl + "\n");
        },
        parser.StmtUnknown(_) => { return s.write("    # unsupported: StmtUnknown\n"); }
    }
    return s;
}

// emit_module produces the full assembly text. Top-level stmts
// are emitted in order under `_start`. The Linux runtime calls
// `_start` first; sys_exit_group terminates the process with
// the exit code in %rdi.
// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, body, and (fallback) epilogue. Params
// arrive on the stack at +16(%rbp), +24(%rbp), … (caller
// pushed right-to-left, so param[0] is closest to the return
// address); the prologue copies them into the function's
// own local slots so the body reads them uniformly.
function emit_function(fd: parser.FuncDecl, s: EmitState): EmitState {
    // Methods get `__fn_<RecvType>__<method>:` so multiple
    // structs can have the same method name without colliding.
    // Plain funcs keep `__fn_<name>:` for source compat with the
    // earlier slices' call emitters.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) {
        // Generic receiver types (`Box[T]`) strip to the base struct
        // name `Box` so the method symbol matches the dispatch shape
        // compare (which uses the value's base-name shape string).
        label_name = base_type_name(fd.receiver_type) + "." + fd.name;
    }
    s = s.write("__fn_" + sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var has_recv: boolean = fd.receiver_name.len() > 0;
    var argc: i32 = fd.params.len();
    if (has_recv) { argc = argc + 1; }
    var n_body_locals: i32 = count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    subq $" + i32_to_string(bytes) + ", %rsp\n");
    }
    // Fresh locals table for this function's scope; keep the
    // monotonic label_n + in_function flag.
    s = s.reset_locals();
    s = s.enter_function();
    // For methods, bind receiver first so it occupies local
    // slot 0 (at -8(%rbp)) and reads from +16(%rbp).
    if (has_recv) {
        s = s.bind_local_typed(fd.receiver_name, ret_tag_of(fd.receiver_type));
        var recv_off: i32 = s.lookup_local(fd.receiver_name);
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq %rax, " + i32_to_string(recv_off) + "(%rbp) # recv " + fd.receiver_name + "\n");
    }
    // Bind params + copy from caller-stack offsets into local
    // slots. param[i] sits at +(16 + (i + recv_shift)*8)(%rbp).
    var recv_shift: i32 = 0;
    if (has_recv) { recv_shift = 1; }
    var n_params: i32 = fd.params.len();
    var i: i32 = 0;
    while (i < n_params) {
        s = s.bind_local_typed(fd.params[i].name, ret_tag_of(fd.params[i].type_name));
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + (i + recv_shift) * 8;
        s = s.write("    movq " + i32_to_string(arg_off) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + i32_to_string(local_off) + "(%rbp) # param " + fd.params[i].name + "\n");
        i = i + 1;
    }
    // Body. Any StmtReturn inside lowers to leave + ret
    // (because in_function is set).
    var bi: i32 = 0;
    while (bi < fd.body.len()) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end
    // doesn't run into the next function's label.
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}

// has_main returns true if any FuncDecl in mod is named `main`.
function has_main(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == "main") { return true; }
        i = i + 1;
    }
    return false;
}

// escape_for_ascii rewrites a string for `.ascii "…"` syntax:
// quotes get backslashed, backslashes doubled, common control
// chars use the named escape sequence so GAS treats them as the
// byte. Other control bytes (NUL, DEL, anything < 0x20 we don't
// handle by name) get a 3-digit octal escape — always 3 digits
// to avoid ambiguity when followed by a literal digit.
function escape_for_ascii(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b == 13) { out = out + "\\r"; }
        else if (b < 32 || b == 127) {
            // 3-digit octal: \<o2><o1><o0>.
            var o0: i32 = b % 8;
            var o1: i32 = (b / 8) % 8;
            var o2: i32 = (b / 64) % 8;
            out = out + "\\" + i32_to_string(o2) + i32_to_string(o1) + i32_to_string(o0);
        }
        else { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// === Type-checking pass (Option/Result vs. concrete) ===
//
// The self-host emitter assumes well-typed input; this pass catches the
// one error class that otherwise miscompiles silently — a wrapped value
// (Option/Result) used where a concrete scalar/array is expected, or vice
// versa (e.g. `function f(): i32 { return xs.max(); }`, since `.max()` is
// Option[i32]). It is deliberately narrow: the coarse string-tag type
// system + position-less AST make a full checker infeasible, and the Go
// checker owns scalar-vs-scalar / arity / field errors. See
// docs/SELFHOST-CHECKER.md.

struct CheckCtx { st: EmitState, errs: string }

function is_wrapper(tag: string): boolean {
    if (tag.len() >= 7 && tag[0:7] == "option:") { return true; }
    if (tag.len() >= 7 && tag[0:7] == "result:") { return true; }
    return false;
}

function is_concrete(tag: string): boolean {
    return is_int_tag(tag) || tag == "string" || tag == "bool" || tag == "f64"
        || is_int_array_tag(tag) || tag == "array_string" || tag == "array";
}

// Conservative: reject ONLY when exactly one side is an Option/Result
// wrapper and the other is a confidently-inferred concrete type. Both
// wrappers (payload inference is too coarse to compare), any "unknown",
// and scalar-vs-scalar are all accepted.
function assignable(want: string, got: string): boolean {
    if (want == got) { return true; }
    if (want == "unknown" || got == "unknown") { return true; }
    var ww: boolean = is_wrapper(want);
    var gw: boolean = is_wrapper(got);
    if (ww && gw) { return true; }
    if (ww || gw) {
        var other: string = want;
        if (ww) { other = got; }
        if (is_concrete(other)) { return false; }
        return true;
    }
    return true;
}

// Render an internal tag back to source-like syntax for diagnostics.
function friendly_type(tag: string): string {
    if (tag.len() >= 7 && tag[0:7] == "option:") {
        return "Option[" + friendly_type(tag[7:tag.len()]) + "]";
    }
    if (tag.len() >= 7 && tag[0:7] == "result:") {
        return "Result[" + friendly_type(tag[7:tag.len()]) + ", _]";
    }
    if (tag == "array_i32") { return "i32[]"; }
    if (tag == "array_u32") { return "u32[]"; }
    if (tag == "array_u64") { return "u64[]"; }
    if (tag == "array_i64") { return "i64[]"; }
    if (tag == "array_string") { return "string[]"; }
    return tag;
}

function check_stmt(st: parser.Stmt, want: string, fname: string, ctx: CheckCtx): CheckCtx {
    match (st) {
        parser.StmtReturn(r) => {
            var got: string = infer_expr_type(r.value, ctx.st);
            if (!assignable(want, got)) {
                return CheckCtx {
                    st: ctx.st,
                    errs: ctx.errs + "error[E002]: in fn '" + fname
                        + "': returns " + friendly_type(want)
                        + " but expression has type " + friendly_type(got) + "\n"
                };
            }
            return ctx;
        },
        parser.StmtVar(v) => {
            var got: string = infer_expr_type(v.init, ctx.st);
            var bind_ty: string = got;
            if (v.type_name.len() > 0) {
                var declared: string = ret_tag_of(v.type_name);
                bind_ty = declared;
                if (!assignable(declared, got)) {
                    ctx = CheckCtx {
                        st: ctx.st,
                        errs: ctx.errs + "error[E003]: in fn '" + fname
                            + "': variable '" + v.name + "' declared "
                            + friendly_type(declared) + " but initializer has type "
                            + friendly_type(got) + "\n"
                    };
                }
            }
            return CheckCtx { st: ctx.st.bind_local_typed(v.name, bind_ty), errs: ctx.errs };
        },
        parser.StmtAssign(a) => {
            var got: string = infer_expr_type(a.value, ctx.st);
            var tt: string = ctx.st.local_type_of(a.target);
            if (!assignable(tt, got)) {
                return CheckCtx {
                    st: ctx.st,
                    errs: ctx.errs + "error[E004]: in fn '" + fname
                        + "': assignment to '" + a.target + "' of type "
                        + friendly_type(tt) + " from expression of type "
                        + friendly_type(got) + "\n"
                };
            }
            return ctx;
        },
        parser.StmtIf(f) => {
            ctx = check_stmts(f.then_body, want, fname, ctx);
            return check_stmts(f.else_body, want, fname, ctx);
        },
        parser.StmtWhile(w) => {
            return check_stmts(w.body, want, fname, ctx);
        },
        parser.StmtFor(fo) => {
            var it: string = infer_expr_type(fo.iter, ctx.st);
            var elem: string = "unknown";
            if (it == "array_i32") { elem = "i32"; }
            if (it == "array_u32") { elem = "u32"; }
            if (it == "array_u64") { elem = "u64"; }
            if (it == "array_i64") { elem = "i64"; }
            if (it == "array_string") { elem = "string"; }
            ctx = CheckCtx { st: ctx.st.bind_local_typed(fo.var_name, elem), errs: ctx.errs };
            return check_stmts(fo.body, want, fname, ctx);
        },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var actx: CheckCtx = ctx;
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if ((pv.type_name == "Some" || pv.type_name == "Ok")
                                && pv.binding.len() > 0) {
                            actx = CheckCtx {
                                st: ctx.st.bind_local_typed(pv.binding,
                                    match_payload_type(m.scrutinee, ctx.st)),
                                errs: ctx.errs
                            };
                        }
                    },
                    parser.PatWildcard(_) => { }
                }
                actx = check_stmts(m.arms[ai].body, want, fname, actx);
                // Keep accumulated errors; drop arm-local bindings.
                ctx = CheckCtx { st: ctx.st, errs: actx.errs };
                ai = ai + 1;
            }
            return ctx;
        },
        _ => { return ctx; }
    }
    return ctx;
}

function check_stmts(stmts: parser.Stmt[], want: string, fname: string, ctx: CheckCtx): CheckCtx {
    var i: i32 = 0;
    while (i < stmts.len()) {
        ctx = check_stmt(stmts[i], want, fname, ctx);
        i = i + 1;
    }
    return ctx;
}

function check_func(fd: parser.FuncDecl, s: EmitState): string {
    var want: string = ret_tag_of(fd.ret_type);
    var s2: EmitState = s.reset_locals();
    if (fd.receiver_type.len() > 0) {
        s2 = s2.bind_local_typed(fd.receiver_name, ret_tag_of(fd.receiver_type));
    }
    var pi: i32 = 0;
    while (pi < fd.params.len()) {
        s2 = s2.bind_local_typed(fd.params[pi].name, ret_tag_of(fd.params[pi].type_name));
        pi = pi + 1;
    }
    var ctx: CheckCtx = CheckCtx { st: s2, errs: "" };
    ctx = check_stmts(fd.body, want, fd.name, ctx);
    return ctx.errs;
}

function check_module(mod: parser.Module, s: EmitState): string {
    var errs: string = "";
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        errs = errs + check_func(mod.funcs[fi], s);
        fi = fi + 1;
    }
    return errs;
}

pub function emit_module(mod: parser.Module): string {
    // Reset the global strbuf before any .write calls. Output is
    // accumulated there (amortised O(1) per append) and materialised
    // into a fresh string at the tail via strbuf_take().
    strbuf_reset();
    var s: EmitState = new_state();
    // Seed the struct-decl table so emit_expr's ExprStructLit
    // / ExprFieldAccess paths can look up field layout. Builtin enum
    // injection (JsonValue / IoError) happens in the driver via
    // parser.module_with_builtins, so emit_module stays pure.
    s = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: mod.structs,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: mod.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
    // Type-check before codegen. On any diagnostic, report and abort —
    // emitting assembly for ill-typed input would miscompile silently.
    var check_errs: string = check_module(mod, s);
    if (check_errs.len() > 0) {
        eprint(check_errs);
        exit(1);
        return "";
    }
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own label
    // (__fn_<name>:); _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    // _start: program entry point. If main() exists, call it
    // and use its return value as the exit code. Otherwise
    // run top-level stmts directly.
    s = s.write("_start:\n");
    // If args_count() / arg_at() were used, save argc + argv
    // from the initial stack BEFORE any push (the kernel
    // places argc at the top of the stack on entry).
    if (s.needs_args) {
        s = s.write("    movq (%rsp), %rax\n");
        s = s.write("    movq %rax, __fern_argc(%rip)\n");
        s = s.write("    leaq 8(%rsp), %rax\n");
        s = s.write("    movq %rax, __fern_argv(%rip)\n");
    }
    // Save envp for env(). It follows argv's NULL terminator on the
    // entry stack: envp = rsp + 16 + argc*8 (argc at [rsp], argv at
    // rsp+8 with argc+1 slots incl. the NULL). Gated on needs_heap —
    // the env() runtime helper allocates, so it only links when the
    // heap is present, and any program calling env() marks the heap.
    if (s.needs_heap) {
        s = s.write("    movq (%rsp), %rax\n");            // argc
        s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");   // envp base
        s = s.write("    movq %rax, __fern_envp(%rip)\n");
    }
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    if (has_main(mod)) {
        // call __fn_main; exit with %rax.
        s = s.write("    call __fn_main\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    } else {
        var n_locals: i32 = count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    subq $" + i32_to_string(bytes) + ", %rsp\n");
        }
        var i: i32 = 0;
        while (i < mod.top_stmts.len()) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit (in case there's no return).
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    // __fern_print_int helper: appended once at the end of the
    // .text section if any print_int call surfaced needs_print_int.
    // Converts the i64 in %rdi to decimal text in a stack buffer
    // and writes it to stdout. Handles zero, positive, and
    // negative values (prepending `-`).
    if (s.needs_print_int) {
        s = s.write("__fern_print_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    movq $0, %r10\n");        // sign flag
        s = s.write("    cmpq $0, %rax\n");
