    // Built-in `.index_of(s)` / `.contains(s)` on
    // string arrays — uses `__fern_str_eq` per
    // element so content equality matches even
    // when the .rodata slots differ.
    if ((fa.field == "index_of" || fa.field == "contains")
            && c.args.len() == 1 && asmcore.ty_is_array_string(prim_recv)) {
        // __fern_arr_str_index_of is a Fern runtime function (#2649): call it via
        // the __fn_ stack convention (xs=param[0] at +16, target=param[1] at +24).
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    pushq %rdi\n");
        s = s.write("    call __fn___fern_arr_str_index_of\n");
        s = s.write("    addq $16, %rsp\n");
        if (fa.field == "contains") {
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    movq $0, %rax\n");
            s = s.write("    setge %al\n");
            s = s.write("    movzbq %al, %rax\n");
        }
        s = s.write("    pushq %rax\n");
        s = s.mark_arr_str_index_of();
        return s;
    }
    // Built-in `.sum()` on i32 arrays — returns
    // the sum of all elements (0 if empty).
    if (fa.field == "sum" && c.args.len() == 0
            && asmcore.ty_is_array_i32(prim_recv)) {
        // __fern_arr_i32_sum is a Fern runtime function (#2649): call it via
        // the ordinary __fn_ stack convention (the borrowed array is param[0]).
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn___fern_arr_i32_sum\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_arr_i32_sum();
        return s;
    }
    // Built-in `.product()` on i32 arrays —
    // returns the product of all elements (1 if
    // empty, matching the empty-product identity).
    if (fa.field == "product" && c.args.len() == 0
            && asmcore.ty_is_array_i32(prim_recv)) {
        // __fern_arr_i32_product is a Fern runtime function (#2649).
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn___fern_arr_i32_product\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_arr_i32_product();
        return s;
    }
    // Built-in `.min()` / `.max()` on i32 arrays →
    // Option[i32]: Some(extremum) when non-empty, None on
    // an empty array (heap box [tag @0, payload @8]).
    if ((fa.field == "min" || fa.field == "max")
            && c.args.len() == 0 && asmcore.ty_is_array_i32(prim_recv)) {
        s = emit_expr(fa.obj, s);
        var mm_none: asmcore.LabelOut = asmcore.fresh_label(s);
        s = mm_none.state;
        var mm_end: asmcore.LabelOut = asmcore.fresh_label(s);
        s = mm_end.state;
        s = s.write("    popq %rdi\n");          // arr
        s = s.write("    movq (%rdi), %rax\n");  // len
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jz " + mm_none.name + "\n");
        // __fern_arr_i32_min/_max are Fern runtime functions (#2649): the
        // len==0 case is handled above, so they take a non-empty borrowed array
        // and return the extremum. Call via the ordinary __fn_ stack convention.
        s = s.write("    pushq %rdi\n");          // arr arg
        if (fa.field == "min") {
            s = s.write("    call __fn___fern_arr_i32_min\n");
        } else {
            s = s.write("    call __fn___fern_arr_i32_max\n");
        }
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");          // save extremum
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %rcx\n");
        s = s.write("    movq $0, (%rax)\n");     // Some tag
        s = s.write("    movq %rcx, 8(%rax)\n");  // payload
        s = s.write("    jmp " + mm_end.name + "\n");
        s = s.write(mm_none.name + ":\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");     // None tag
        s = s.write(mm_end.name + ":\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_arr_i32_min_max();
        return s;
    }
    // Built-in `.index_of(x)` / `.contains(x)` on
    // i32 arrays — linear search for `x`. Returns
    // the index for `index_of`, the >= 0 test for
    // `contains`.
    if ((fa.field == "index_of" || fa.field == "contains")
            && c.args.len() == 1 && asmcore.ty_is_array_i32(prim_recv)) {
        // __fern_arr_i32_index_of is a Fern runtime function (#2649): push args
        // right-to-left (target then array) so the array is param[0] at +16 and
        // target is param[1] at +24; result (index or -1) comes back in %rax.
        s = emit_expr(c.args[0], s);   // target
        s = emit_expr(fa.obj, s);      // array
        s = s.write("    call __fn___fern_arr_i32_index_of\n");
        s = s.write("    addq $16, %rsp\n");
        if (fa.field == "contains") {
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    movq $0, %rax\n");
            s = s.write("    setge %al\n");
            s = s.write("    movzbq %al, %rax\n");
        }
        s = s.write("    pushq %rax\n");
        s = s.mark_arr_i32_index_of();
        return s;
    }
    // Built-in string methods that mirror existing
    // free-function builtins. The free-function
    // dispatch below already knows the assembly
    // — we just route receiver-first form into
    // the same emit shape so users can write
    // `s.split(",")` instead of `str_split(s, ",")`.
    if (asmcore.ty_is_string(prim_recv)) {
        if (fa.field == "chars" && c.args.len() == 0) {
            // __fern_str_chars is a Fern runtime function now (#2649): __fn_ stack
            // convention (s=param[0] at +16). mark_str_chars pulls in arr_push + heap.
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_chars\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_chars();
            return s;
        }
        if (fa.field == "bytes" && c.args.len() == 0) {
            // __fern_str_bytes is a Fern runtime function now (#2649): __fn_ stack
            // convention (s=param[0] at +16). mark_str_bytes pulls in arr_push + heap.
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_bytes\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_bytes();
            return s;
        }
        // `s.as_bytes()` — in std/string this is the
        // zero-copy companion to bytes(); the self-host's
        // slot-array representation has no separate slice
        // view, so it returns the same fresh i32[] as
        // bytes() (correct, just not zero-copy).
        if (fa.field == "as_bytes" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_bytes\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_bytes();
            return s;
        }
        if (fa.field == "reverse" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);   // s (arg stays on the stack = param[0])
            s = s.write("    call __fn___fern_str_reverse\n    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_reverse();
            return s;
        }
        if (fa.field == "first_byte" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rax\n");
            s = s.write("    movq (%rax), %rax\n");
            s = s.write("    movzbq (%rax), %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        }
        if (fa.field == "last_byte" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rax\n");
            s = s.write("    movq 8(%rax), %rcx\n");
            s = s.write("    movq (%rax), %rax\n");
            s = s.write("    decq %rcx\n");
            s = s.write("    movzbq (%rax,%rcx,1), %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        }
        if (fa.field == "lines" && c.args.len() == 0) {
            // `s.lines()` — split on '\n', then drop a trailing empty entry when
            // s is empty or ends with '\n' (so "a\nb\nc\n".lines() is 3 lines, not
            // 4 — matching the interp and Rust/Python). __fern_str_lines is a Fern
            // runtime function now (#2649): __fn_ stack convention (s=param[0] at
            // +16). mark_str_lines pulls in its str_split + arr_slice + heap deps.
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_lines\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_lines();
            return s;
        }
        if (fa.field == "split" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);       // s
            s = emit_expr(c.args[0], s);    // sep
            s = s.write("    popq %rsi\n");   // sep
            s = s.write("    popq %rdi\n");   // s
            s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_split\n    addq $16, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_split();
            return s;
        }
        if (fa.field == "contains" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_index_of\n    addq $16, %rsp\n");
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    movq $0, %rax\n");
            s = s.write("    setge %al\n");
            s = s.write("    movzbq %al, %rax\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            return s;
        }
        if (fa.field == "starts_with" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_starts_with\n    addq $16, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            return s;
        }
        if (fa.field == "ends_with" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_ends_with\n    addq $16, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            return s;
        }
        if (fa.field == "index_of" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_index_of\n    addq $16, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            return s;
        }
        if (fa.field == "trim" && c.args.len() == 0) {
            // __fern_str_trim is a Fern runtime function (#2649): __fn_ stack
            // convention (s=param[0] at +16). mark_str_trim pulls in heap (the
            // returned slice box allocates). No longer rides the str_search need.
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_trim\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_trim();
            return s;
        }
        if (fa.field == "to_upper" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_to_upper\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_case();
            return s;
        }
        if (fa.field == "to_lower" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    call __fn___fern_str_to_lower\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_case();
            return s;
        }
        if (fa.field == "repeat" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);       // s
            s = emit_expr(c.args[0], s);    // n
            s = s.write("    popq %rsi\n");   // n
            s = s.write("    popq %rdi\n");   // s
            s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_repeat\n    addq $16, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_repeat();
            return s;
        }
        if (fa.field == "replace" && c.args.len() == 2) {
            s = emit_expr(fa.obj, s);       // h
            s = emit_expr(c.args[0], s);    // o
            s = emit_expr(c.args[1], s);    // nw
            s = s.write("    popq %rdx\n");   // nw
            s = s.write("    popq %rsi\n");   // o
            s = s.write("    popq %rdi\n");   // h
            s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_replace\n    addq $24, %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_replace();
            return s;
        }
    }
    if (asmcore.ty_is_string(prim_recv) || asmcore.is_int_tag(prim_recv) || asmcore.ty_is_bool(prim_recv) || asmcore.ty_is_f64(prim_recv)) {
        var pmi: i32 = c.args.len() - 1;
        while (pmi >= 0) {
            s = emit_expr(c.args[pmi], s);
            pmi = pmi - 1;
        }
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn_" + asmcore.sanitize_label(asmcore.ty_tag(prim_recv) + "." + fa.field) + "\n");
        s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
        s = s.write("    pushq %rax\n");
        return s;
    }
    // Array auto-discovered method: `a.<field>(args)` where the receiver is an
    // array and a std/array free function `__method_Array_<field>` is in scope
    // desugars to `__method_Array_<field>(a, args)` — the exact call the
    // explicit `array.__method_Array_<field>(a, …)` form already lowers to, so
    // reuse emit_call's ret-type / RC / ABI handling rather than re-deriving it
    // here. The intercepted fast paths (sum / max / len / append / with / …)
    // returned above; this catches the rest (sum_squared, reversed, distinct,
    // sorted_asc, …). The helper is bare on the single-file path and
    // `<mod>__`-mangled by the bundler on the import path; resolve the exact
    // in-scope name.
    if (asmcore.ty_is_array(prim_recv) || asmcore.is_int_array_tag(prim_recv) || asmcore.ty_is_array_string(prim_recv)) {
        var amf: string = asmcore.find_array_method_func(fa.field, s);
        if (amf.len() > 0) {
            var new_args: parser.Expr[] = [fa.obj];
            var nai: i32 = 0;
            while (nai < c.args.len()) { new_args = new_args.append(c.args[nai]); nai = nai + 1; }
            var rewritten: parser.ExprCall = parser.ExprCall {
                callee: parser.ExprIdent { name: amf, line: fa.line, col: fa.col },
                args: new_args, line: c.line, col: c.col, type_argc: 0, ty: ""
            };
            return emit_call(rewritten, s);
        }
    }
    // Method call: `obj.method(args)`. Push
    // args right-to-left, then push the
    // receiver (so receiver sits at +16(%rbp)
    // and arg[0] at +24(%rbp) inside the
    // callee). Then dispatch on the receiver's
    // shape pointer.
    var mi: i32 = c.args.len() - 1;
    while (mi >= 0) {
        // Mirror the free-function call's `fn`-arg
        // boxing so `f.bench("…", n, my_workload)`
        // wraps `my_workload` as a closure value
        // instead of calling it 0-arg here. Without
        // this the callee receives `my_workload()`'s
        // return value (garbage) and crashes on the
        // indirect call inside its body.
        var fvn: string = asmcore.arg_fn_value_name(c.args[mi], fa.field, mi, s);
        if (fvn.len() > 0) { s = emit_fn_value(fvn, s); }
        else { s = emit_expr(c.args[mi], s); }
        mi = mi - 1;
    }
    s = emit_expr(fa.obj, s);
    // Peek receiver pointer (top of stack) to
    // read its shape pointer; load shape into
    // %rcx without consuming the receiver.
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");
    var m_end_lbl: i32 = s.label_n;
    s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
    // For each func whose name matches and
    // receiver_type is non-empty, emit a shape-
    // compare arm. Walk in declaration order so
    // the asm is deterministic.
    var fdi: i32 = 0;
    while (fdi < s.funcs.len()) {
        var fd_m: parser.FuncDecl = s.funcs[fdi];
        // Only emit shape-compare arms for STRUCT (incl.
        // enum-variant) receiver types — a value's runtime
        // shape is always one of these. A method whose
        // receiver_type is an ENUM name is handled in the
        // fallback below (the variant value's shape won't
        // match any struct arm).
        if (fd_m.name == fa.field && fd_m.receiver_type.len() > 0
                && !asmcore.recv_is_array(fd_m.receiver_type)
                && asmcore.is_struct_decl_name(util.base_type_name(fd_m.receiver_type), s)) {
            var arm_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, util.base_type_name(fd_m.receiver_type));
            s = arm_lit.state;
            var next_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = next_l.state;
            s = s.write("    leaq .S" + util.i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
            s = s.write("    cmpq %rdx, %rcx\n");
            s = s.write("    jne " + next_l.name + "\n");
            s = s.write("    call __fn_" + asmcore.sanitize_label(util.base_type_name(fd_m.receiver_type) + "." + fd_m.name) + "\n");
            // Caller cleans up args + receiver.
            s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.write("    jmp .Lmethod_end_" + util.i32_to_string(m_end_lbl) + "\n");
            s = s.write(next_l.name + ":\n");
        }
        fdi = fdi + 1;
    }
    // Enum-receiver fallback: a method registered on an
    // enum TYPE (receiver_type not a struct decl). The
    // receiver here is a variant value whose shape matched
    // no struct arm; call the enum method, whose internal
    // `match (self)` dispatches on the variant. First such
    // method wins (method names are effectively unique).
    var enum_recv: string = "";
    var efi: i32 = 0;
    while (efi < s.funcs.len()) {
        var efd: parser.FuncDecl = s.funcs[efi];
        if (enum_recv.len() == 0 && efd.name == fa.field && efd.receiver_type.len() > 0
                && !asmcore.recv_is_array(efd.receiver_type)
                && asmcore.is_enum_recv(util.base_type_name(efd.receiver_type), s)) {
            enum_recv = util.base_type_name(efd.receiver_type);
        }
        efi = efi + 1;
    }
    if (enum_recv.len() > 0) {
        s = s.write("    call __fn_" + asmcore.sanitize_label(enum_recv + "." + fa.field) + "\n");
        s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.write(".Lmethod_end_" + util.i32_to_string(m_end_lbl) + ":\n");
        return s;
    }
    // Fallthrough: no matching method. Clean up
    // args + receiver, push sentinel -1.
    s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write("    pushq %rax\n");
    s = s.write(".Lmethod_end_" + util.i32_to_string(m_end_lbl) + ":\n");
    return s;
    return s;
}

function emit_call(c: parser.ExprCall, s: asmcore.EmitState): asmcore.EmitState {
    var name: string = "";
    // Inline-lambda call (IIFE), e.g. an if-expression desugar
    // `(function(): T { … })()`. Emit the closure box, push the
    // args above it, then invoke via the closure convention (box
    // ptr in %r10, args at +16(%rbp), …) — same as the local-
    // closure path below, but the box is the inline lambda's.
    match (c.callee) {
        parser.ExprLambda(_) => {
            s = emit_expr(c.callee, s);          // push closure box
            var la: i32 = c.args.len() - 1;
            while (la >= 0) {
                s = emit_expr(c.args[la], s);
                la = la - 1;
            }
            s = s.write("    movq " + util.i32_to_string(c.args.len() * 8) + "(%rsp), %r10\n"); // box ptr
            s = s.write("    movq (%r10), %rdx\n");
            s = s.write("    call *%rdx\n");
            s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n"); // pop args + box
            s = s.write("    pushq %rax\n");
            return s;
        },
        _ => {}
    }
    match (c.callee) {
        parser.ExprIdent(id) => { name = id.name; },
        parser.ExprFieldAccess(fa) => {
            // s.p.N() — a fn-valued TUPLE ELEMENT call (numeric field = tuple
            // index), not a method. A method name is never all-digits, so route
            // it to the generic closure-value call (evaluate the callee to its
            // box ptr, invoke via the closure convention) instead of
            // emit_method_call, which found no method "N" and returned the -1
            // sentinel (exit 255). Reading the element (`var g = s.p.N; g()`)
            // already works; this is the direct-call sibling.
            if (util.is_all_digits(fa.field)) {
                s = emit_expr(c.callee, s);          // push closure box
                var tla: i32 = c.args.len() - 1;
                while (tla >= 0) {
                    s = emit_expr(c.args[tla], s);
                    tla = tla - 1;
                }
                s = s.write("    movq " + util.i32_to_string(c.args.len() * 8) + "(%rsp), %r10\n");
                s = s.write("    movq (%r10), %rdx\n");
                s = s.write("    call *%rdx\n");
                s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            return emit_method_call(c, fa, s);
        },
        _ => {
            // Generic closure-VALUE call: any callee expression that
            // evaluates to a closure box — an array element `arr[i]()`,
            // a tuple element, a call result — not just a bare
            // ident / lambda / method. Evaluate the callee to its box
            // ptr, push args above it, then invoke via the closure
            // convention (box ptr in %r10, fn_addr = box[0]). Same shape
            // as the ExprLambda IIFE arm above; the previous `pushq $0`
            // stub silently compiled such a call to "return 0".
            s = emit_expr(c.callee, s); // push closure box
            var cla: i32 = c.args.len() - 1;
            while (cla >= 0) {
                s = emit_expr(c.args[cla], s);
                cla = cla - 1;
            }
            s = s.write("    movq " + util.i32_to_string(c.args.len() * 8) + "(%rsp), %r10\n"); // box ptr (below args)
            s = s.write("    movq (%r10), %rdx\n");
            s = s.write("    call *%rdx\n");
            s = s.write("    addq $" + util.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n"); // pop args + box
            s = s.write("    pushq %rax\n");
            return s;
        }
    }
    // print(str_literal) — builtin lowering to write(1, ptr, len).
    // Compile-time we already know the literal's bytes, so we
    // intern it in `.rodata`, look up the offset, and emit the
    // syscall directly. Other string-typed args fall through
    // as unsupported.
    // len(arr) — load the length prefix at offset 0
    // of the array box. Today this assumes the arg is
    // an array (a string arg would read random bytes);
    // a future slice with type info can route string
    // arguments through __fern_str_len.
    var bo: CallOut = try_emit_builtin(c, name, s);
    s = bo.state;
    if (bo.done) { return s; }
    // Closure call: callee ident resolves to a local
    // holding a closure box ptr. The box layout is
    // [fn_addr, cap0, cap1, …] (always-boxed, even for
    // capture-less lambdas — see the ExprLambda arm).
    //
    // Calling convention: push args RIGHT-to-LEFT (so the
    // callee sees param[0] at +16(%rbp) — IDENTICAL to a
    // direct call), then load the box ptr into %r10 and
    // indirect-call box[0]. The callee body reads the box
    // from %r10 (a closure stashes it in its first local;
    // a plain top-level function used as a value ignores
    // it). This box-in-register shape means a plain
    // function and a closure share one call convention with
    // no param shifting and no per-function trampolines.
    if (s.has_local(name)) {
        var ci: i32 = c.args.len() - 1;
        while (ci >= 0) {
            s = emit_expr(c.args[ci], s);
            ci = ci - 1;
        }
        var off: i32 = s.lookup_local(name);
        s = s.write("    movq " + util.i32_to_string(off) + "(%rbp), %r10\n");
        s = s.write("    movq (%r10), %rdx\n");
        s = s.write("    call *%rdx\n");
        // Caller cleanup: args only (box was in a register).
        if (c.args.len() > 0) {
            s = s.write("    addq $" + util.i32_to_string(c.args.len() * 8) + ", %rsp\n");
        }
        s = s.write("    pushq %rax\n");
        return s;
    }
    // Generic user-function call. Push args RIGHT-to-LEFT
    // so the callee sees param[0] at +16(%rbp) (after
    // `pushq %rbp` + the return address). The callee
    // prologue copies args from those positive offsets
    // into local slots so the body reads them like any
    // other local.
    var i: i32 = c.args.len() - 1;
    while (i >= 0) {
        var fvn: string = asmcore.arg_fn_value_name(c.args[i], name, i, s);
        if (fvn.len() > 0) { s = emit_fn_value(fvn, s); }
        else { s = emit_expr(c.args[i], s); }
        i = i - 1;
    }
    s = s.write("    call __fn_" + asmcore.sanitize_label(name) + "\n");
    // Caller cleans up stack args (System V style for
    // pure-stack args; we don't use the register-arg
    // path of the standard SysV ABI).
    if (c.args.len() > 0) {
        s = s.write("    addq $" + util.i32_to_string(c.args.len() * 8) + ", %rsp\n");
    }
    // Result is in %rax — push for the surrounding
    // expression's stack-machine semantics.
    s = s.write("    pushq %rax\n");
    return s;
    return s;
}

// emit_divmod emits `/` (is_mod=false) or `%` (is_mod=true) with the
// dividend already in %rax and the divisor in %rcx. UNSIGNED operands must
// use the unsigned `divq` (not the signed `cqto; idivq`), and u32 operands
// are zero-extended first: a u32 lives in a 64-bit register that can carry
// garbage in its high 32 bits (e.g. `range` in std/math.random_int), and a
// 64-bit signed/garbage-divisor divide then returns a wrong result — an
// intermittent, heap-corrupting bug (random_int returned out-of-range
// values, producing a negative-length string slice that crashed
// __fern_str_concat). See std/math.random_int's note on the u32 modulo path.
function emit_divmod(b: parser.ExprBinary, s: asmcore.EmitState, is_mod: boolean): asmcore.EmitState {
    var lt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
    var rt: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
    // Normalize 32-bit operands to a clean 64-bit value first. A 32-bit
    // value lives in a 64-bit register that can carry GARBAGE in its high
    // 32 bits (the codegen doesn't keep them extended), and a 64-bit
    // divide (idivq/divq) over that garbage returns a wrong quotient /
    // remainder. Sign-extend i32 (movslq), zero-extend u32 (movl); 64-bit
    // types (i64/u64/usize) already fill the register and are left alone.
    // This was an intermittent, heap-corrupting bug: `iter % n` and
    // random_int's `u % range` returned out-of-range values that produced
    // negative-length string slices and crashed __fern_str_concat.
    if (asmcore.ty_is_u32(lt)) { s = s.write("    movl %eax, %eax\n"); }
    else if (asmcore.ty_is_i32(lt)) { s = s.write("    movslq %eax, %rax\n"); }
    if (asmcore.ty_is_u32(rt)) { s = s.write("    movl %ecx, %ecx\n"); }
    else if (asmcore.ty_is_i32(rt)) { s = s.write("    movslq %ecx, %rcx\n"); }
    if (asmcore.is_unsigned_tag(lt) || asmcore.is_unsigned_tag(rt)) {
        s = s.write("    xorq %rdx, %rdx\n");
        s = s.write("    divq %rcx\n");             // unsigned
    } else {
        s = s.write("    cqto\n");
        s = s.write("    idivq %rcx\n");            // signed
    }
    if (is_mod) {
        s = s.write("    movq %rdx, %rax\n");
    }
    return s;
}

function emit_expr(e: parser.Expr, s: asmcore.EmitState): asmcore.EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) {
                // Float literal: GAS converts the decimal text to an
                // IEEE-754 double in .rodata; load its bits and push
                // them (floats flow through the rt-stack as their
                // 8-byte bit pattern, like every other value).
                var fl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = fl.state;
                s = s.write("    .section .rodata\n");
                s = s.write(fl.name + ": .double " + n.text + "\n");
                s = s.write("    .text\n");
                s = s.write("    movsd " + fl.name + "(%rip), %xmm0\n");
                s = s.write("    movq %xmm0, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    movq $" + n.text + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprBinary(b) => {
            // String-aware dispatch: `s + t` where either side
            // is a string lowers to __fern_str_concat; `s == t`
            // / `s != t` for strings lowers to __fern_str_eq.
            // Type info comes from infer_expr_type on the
            // operands — that walks the AST + local_types.
            if (b.op == "+") {
                var lt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var rt: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(lt) || asmcore.ty_is_string(rt)) {
                    // __fern_str_concat is a Fern runtime function now (#2649, via
                    // the raw-memory intrinsics): __fn_ stack convention — a=param[0]
                    // at +16, b=param[1] at +24. Eval lhs then rhs (side-effect
                    // order), then re-push so a lands on top.
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");      // rhs (b)
                    s = s.write("    popq %rdi\n");      // lhs (a)
                    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_concat\n    addq $16, %rsp\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var ert: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(elt) || asmcore.ty_is_string(ert)) {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_eq\n    addq $16, %rsp\n");
                    if (b.op == "!=") {
                        s = s.write("    xorq $1, %rax\n");
                    }
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: route < / <= / > / >= for
            // string operands through __fern_str_cmp, then
            // compare its signed result against zero to derive
            // the bool.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var ort: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(olt) || asmcore.ty_is_string(ort)) {
                    // __fern_str_cmp is a Fern runtime function (#2649): call it
                    // via the ordinary __fn_ stack convention. Operand stack has
                    // [left, right] (right on top); re-push so left=a is param[0]
                    // at +16 and right=b is param[1] at +24.
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");   // right (b)
                    s = s.write("    popq %rdi\n");   // left (a)
                    s = s.write("    pushq %rsi\n");  // b -> +24
                    s = s.write("    pushq %rdi\n");  // a -> +16 (top)
                    s = s.write("    call __fn___fern_str_cmp\n");
                    s = s.write("    addq $16, %rsp\n");
                    s = s.write("    cmpq $0, %rax\n");
                    s = s.write("    movq $0, %rax\n");
                    if (b.op == "<") { s = s.write("    setl %al\n"); }
                    else if (b.op == "<=") { s = s.write("    setle %al\n"); }
                    else if (b.op == ">") { s = s.write("    setg %al\n"); }
                    else { s = s.write("    setge %al\n"); }
                    s = s.write("    movzbq %al, %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. The right operand's
            // side effects must not run when the left already
            // decides the result. `&&` short-circuits on false
            // (left == 0 ⇒ result = 0); `||` short-circuits on
            // true (left != 0 ⇒ result = 1). Otherwise the
            // right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    popq %rax\n");
                s = s.write("    testq %rax, %rax\n");
                var short_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = short_l.state;
                var end_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    jz " + short_l.name + "\n");
                } else {
                    s = s.write("    jnz " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    movq $0, %rax\n");
                } else {
                    s = s.write("    movq $1, %rax\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Float (f64) arithmetic + comparison. Operands flow as
            // 8-byte bit patterns; load into xmm regs and operate.
            // Arithmetic pushes the result bits; comparison pushes a
            // 0/1 i32. Detected when either operand infers as f64.
            var is_flt: boolean = asmcore.ty_is_f64(asmcore.infer_expr_type(b.left, s)) || asmcore.ty_is_f64(asmcore.infer_expr_type(b.right, s));
            if (is_flt && (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm1\n");   // rhs
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm0\n");   // lhs
                if (b.op == "+") { s = s.write("    addsd %xmm1, %xmm0\n"); }
                else if (b.op == "-") { s = s.write("    subsd %xmm1, %xmm0\n"); }
                else if (b.op == "*") { s = s.write("    mulsd %xmm1, %xmm0\n"); }
                else { s = s.write("    divsd %xmm1, %xmm0\n"); }
                s = s.write("    movq %xmm0, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (is_flt && (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "==" || b.op == "!=")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm1\n");   // rhs
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm0\n");   // lhs
                s = s.write("    ucomisd %xmm1, %xmm0\n");
                s = s.write("    movq $0, %rax\n");
                // IEEE: every relation with NaN is false; equality with
                // NaN is also false; only `!=` returns true on NaN.
                // ucomisd sets CF=ZF=PF=1 for unordered, so plain setb /
                // setbe would mis-report `NaN < x` and `NaN <= x` as
                // true. Mask `<` and `<=` with `setnp` (PF=0 → ordered);
                // `==` gates on ordered-AND-equal, `!=` accepts either
                // ordered-not-equal OR unordered. `>` / `>=` map to
                // seta / setae which already require CF=0, so unordered
                // (CF=1) is automatically false.
                if (b.op == "<") {
                    s = s.write("    setb %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else if (b.op == "<=") {
                    s = s.write("    setbe %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else if (b.op == ">") { s = s.write("    seta %al\n"); }
                else if (b.op == ">=") { s = s.write("    setae %al\n"); }
                else if (b.op == "==") {
                    s = s.write("    sete %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else {
                    s = s.write("    setne %al\n");
                    s = s.write("    setp %dl\n");
                    s = s.write("    orb %dl, %al\n");
                }
                s = s.write("    movzbq %al, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    popq %rcx\n");        // rhs
            s = s.write("    popq %rax\n");        // lhs
            if (b.op == "+") {
                s = s.write("    addq %rcx, %rax\n");
            } else if (b.op == "-") {
                s = s.write("    subq %rcx, %rax\n");
            } else if (b.op == "*") {
                s = s.write("    imulq %rcx, %rax\n");
            } else if (b.op == "/") {
                s = emit_divmod(b, s, false);
            } else if (b.op == "%") {
                s = emit_divmod(b, s, true);
            } else if (b.op == "&") {
                s = s.write("    andq %rcx, %rax\n");
            } else if (b.op == "|") {
                s = s.write("    orq %rcx, %rax\n");
            } else if (b.op == "^") {
                s = s.write("    xorq %rcx, %rax\n");
            } else if (b.op == "<<") {
                s = s.write("    shlq %cl, %rax\n");
            } else if (b.op == ">>") {
                // Arithmetic (signed) shift right — Fern i32 is signed.
                s = s.write("    sarq %cl, %rax\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmpq rhs, lhs` sets flags from
                // (lhs - rhs); setcc materialises the bool in
                // %al, movzbq zero-extends into %rax so the
                // surrounding stack push gets a clean 0/1.
                // Pick signed vs unsigned set instructions from the
                // operand tags — `u32` / `u64` / `usize` use
                // setb / setbe / seta / setae so values near u64-max
                // sort/compare in the expected order.
                var is_unsigned: boolean = asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.left, s))
                    || asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.right, s));
                s = s.write("    cmpq %rcx, %rax\n");
                var cc: string = "";
                if (b.op == "<") { if (is_unsigned) { cc = "setb"; } else { cc = "setl"; } }
                else if (b.op == "<=") { if (is_unsigned) { cc = "setbe"; } else { cc = "setle"; } }
                else if (b.op == ">") { if (is_unsigned) { cc = "seta"; } else { cc = "setg"; } }
                else if (b.op == ">=") { if (is_unsigned) { cc = "setae"; } else { cc = "setge"; } }
                else if (b.op == "==") { cc = "sete"; }
                else { cc = "setne"; }
                s = s.write("    " + cc + " %al\n");
                s = s.write("    movzbq %al, %rax\n");
            } else {
                s = s.write("    # unsupported binop: " + b.op + "\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnary(u) => {
            // `expr?` try operator: unwrap a Some/Ok payload, or
            // early-return the None/Err box from the enclosing function.
            if (u.op == "try_") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");          // option/result box
                s = s.write("    movq (%rax), %rcx\n");  // tag (0 = Some/Ok)
                var tlbl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = tlbl.state;
                s = s.write("    testq %rcx, %rcx\n");
                s = s.write("    jz " + tlbl.name + "\n");
                // None/Err: return the box (already in %rax) unchanged.
                s = s.write("    leave\n");
                s = s.write("    ret\n");
                s = s.write(tlbl.name + ":\n");
                s = s.write("    movq 8(%rax), %rax\n"); // payload
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                if (asmcore.ty_is_f64(asmcore.infer_expr_type(u.operand, s))) {
                    // Float negation: flip the IEEE-754 sign bit (63).
                    s = s.write("    movabsq $-9223372036854775808, %rcx\n");
                    s = s.write("    xorq %rcx, %rax\n");
                } else {
                    s = s.write("    negq %rax\n");
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                s = s.write("    xorq $1, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // `expr as Type` casts (parser desugars to the unary op
            // `as_<Type>`). All integer types occupy 64-bit slots, so
            // a cast masks (unsigned) or sign-extends (signed) to the
            // target width; i64/u64/usize and anything else are no-ops.
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ty: str = u.op[3:u.op.len()];
                var src_ty: asmcore.Ty = asmcore.infer_expr_type(u.operand, s);
                var to_float: boolean = ty == "f64" || ty == "f32" || ty == "float";
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                if (to_float) {
                    // → float. From int: cvtsi2sd. From float: no-op.
                    if (!asmcore.ty_is_f64(src_ty)) {
                        s = s.write("    cvtsi2sd %rax, %xmm0\n");
                        s = s.write("    movq %xmm0, %rax\n");
                    }
                } else if (asmcore.ty_is_f64(src_ty)) {
                    // float → int: truncate toward zero, then width-mask.
                    s = s.write("    movq %rax, %xmm0\n");
                    s = s.write("    cvttsd2si %xmm0, %rax\n");
                    if (ty == "u8") { s = s.write("    andq $255, %rax\n"); }
                } else {
                    if (ty == "u8") { s = s.write("    andq $255, %rax\n"); }
                    else if (ty == "u32") { s = s.write("    movl %eax, %eax\n"); }
                    else if (ty == "i32") { s = s.write("    movslq %eax, %rax\n"); }
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    pushq " + util.i32_to_string(off) + "(%rbp)\n");
                return s;
            }
            // Built-in `None` — the empty Option. Heap box whose
            // first word is the tag 1 (Some=0 / None=1). See the
            // Some(x) constructor + the StmtMatch Some/None arms.
            if (id.name == "None") {
                s = s.write("    movq $16, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                s = s.write("    movq $1, (%rax)\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // A bare ident naming a zero-arg, receiver-less function
            // (i.e. a `const`, desugared to such a function) lowers to
            // a call to that function.
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    s = s.write("    call __fn_" + asmcore.sanitize_label(id.name) + "\n");
                    s = s.write("    pushq %rax\n");
                    return s;
                }
                cfi = cfi + 1;
            }
            // A bare ident naming a receiver-less function WITH params
            // is a function value (higher-order use, e.g. `apply(dbl, …)`).
            // Represent it as a 1-slot closure box `[&__fn_name]` so it
            // flows through the same closure-call path as a real lambda.
            // The box-in-%r10 convention means the plain function ignores
            // the (empty) box and reads its params at +16(%rbp) as usual.
            var fvi: i32 = 0;
            while (fvi < s.funcs.len()) {
                if (s.funcs[fvi].name == id.name && s.funcs[fvi].receiver_type.len() == 0 && s.funcs[fvi].params.len() > 0) {
                    return emit_fn_value(id.name, s);
                }
                fvi = fvi + 1;
            }
            // A bare ident naming a zero-field struct is a no-payload
            // enum variant (`JNull`). Construct [shape_ptr] — an 8-byte
            // box holding the interned variant name, so the match's
            // shape-pointer compare identifies it.
            if (asmcore.is_unit_variant(id.name, s)) {
                s = s.write("    movq $8, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                var uvLit: asmcore.StringLitOut = asmcore.add_string_lit(s, id.name);
                s = uvLit.state;
                s = s.write("    leaq .S" + util.i32_to_string(uvLit.idx) + "(%rip), %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unresolved ident: " + id.name + "\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — encode as a 0/1 i32 so it can flow
            // through comparison-style consumers (e.g. an if
            // cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    movq $" + util.i32_to_string(v) + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal lowering: intern the bytes in .rodata, then build an
            // rc-headered box via __fern_str_box (#2649 Option A) — data = .rodata
            // label, len = byte count. box = [rc=1][data][len]; data@box+0 / len@box+8
            // unchanged, so __fern_str_concat / _eq / _slice / _print are unaffected,
            // and the rc header keeps the box consistent with the IR path (a box may
            // cross the legacy/IR boundary in a merged bundle).
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, sv.value);
            s = lo.state;
            s = s.mark_heap();
            s = s.write("    leaq .S" + util.i32_to_string(lo.idx) + "(%rip), %rdi\n");
            s = s.write("    movq $" + util.i32_to_string(sv.value.len()) + ", %rsi\n");
            s = s.write("    call __fern_str_box\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprCall(c) => {
            return emit_call(c, s);
        },
        parser.ExprTuple(t) => {
            // Layout: [val0, val1, …, val_(N-1)] — no shape
            // pointer because tuple field access uses the
            // numeric `.0` / `.1` / … spelling, and the offset
            // is known at the access site without runtime
            // dispatch.
            //
            // Steps:
            //   1. Compile each element in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate N*8 bytes on the heap.
            //   3. Pop each element from the rt-stack into
            //      [%rax + i*8] — descending i so the top-of-
            //      stack lands in the LAST slot.
            //   4. Push %rax (the tuple pointer).
            var n_elems: i32 = t.elements.len();
            var ti: i32 = 0;
            while (ti < n_elems) {
                s = emit_expr(t.elements[ti], s);
                ti = ti + 1;
            }
            var t_bytes: i32 = n_elems * 8;
            if (n_elems == 0) { t_bytes = 8; }
            s = s.write("    movq $" + util.i32_to_string(t_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            var tj: i32 = n_elems - 1;
            while (tj >= 0) {
                s = s.write("    popq %rcx\n");
                if (asmcore.needs_rc_inc_on_alias(t.elements[tj], s)) {
                    s = s.mark_heap();
                    s = s.write("    pushq %rax\n");            // save tuple ptr
                    s = s.write("    pushq %rcx\n");            // retain arg = element
                    s = s.write("    call __fn___fern_rc_inc\n");
                    s = s.write("    addq $8, %rsp\n");
                    s = s.write("    movq %rax, %rcx\n");       // element (helper returns the ptr)
                    s = s.write("    popq %rax\n");             // restore tuple ptr
                }
                s = s.write("    movq %rcx, " + util.i32_to_string(tj * 8) + "(%rax)\n");
                tj = tj - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprArray(a) => {
            // Layout: [len: 8 bytes, val0, val1, …, val_(N-1)].
            // The length prefix lets `len(a)` lower to a single
            // load at offset 0 without dragging type info
            // through the backend. ExprIndex shifts the index
            // by +1 slot to skip the prefix.
            //
            // Steps:
            //   1. Compile each element in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate (N+1)*8 bytes on the heap.
            //   3. Store the length at [%rax + 0].
            //   4. Pop each element from the rt-stack into
            //      [%rax + (i+1)*8] — descending i so the
            //      top-of-stack lands in the LAST slot.
            //   5. Push %rax (the array pointer).
            var n_elems: i32 = a.elements.len();
            var ai: i32 = 0;
            while (ai < n_elems) {
                s = emit_expr(a.elements[ai], s);
                ai = ai + 1;
            }
            // Layout with a hidden capacity word: alloc
            // [cap, len, e0, …] at base B and return B+8, so readers
            // see the classic [len@0, e_i@(i+1)*8] layout while
            // __fern_arr_push finds cap at -16 (rc at -8) and can grow
            // geometrically. cap = len for a literal (first push
            // reallocs, then doubles).
            s = s.write("    movq $" + util.i32_to_string(n_elems) + ", %rdi\n");   // cap = element count
            s = s.write("    call __fern_arr_box\n");   // -> data ptr in %rax (cap + len written)
            s = s.mark_heap();
            var aj: i32 = n_elems - 1;
            while (aj >= 0) {
                s = s.write("    popq %rcx\n");
                if (asmcore.needs_rc_inc_on_alias(a.elements[aj], s)) {
                    s = s.mark_heap();
                    s = s.write("    pushq %rax\n");            // save array ptr
                    s = s.write("    pushq %rcx\n");            // retain arg = element
                    s = s.write("    call __fn___fern_rc_inc\n");
                    s = s.write("    addq $8, %rsp\n");
                    s = s.write("    movq %rax, %rcx\n");       // element (helper returns the ptr)
                    s = s.write("    popq %rax\n");             // restore array ptr
                }
                s = s.write("    movq %rcx, " + util.i32_to_string((aj + 1) * 8) + "(%rax)\n");
                aj = aj - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprIndex(x) => {
            // Dispatch on container type: string → load byte
            // (zero-extended) at box.data_ptr + i. Array → load
            // 8-byte slot at box[(i+1)*8].
            //
            // No bounds check in this first cut — out-of-range
            // produces undefined data, matching the wasm
            // backend's i32[] semantics today.
            var ct: asmcore.Ty = asmcore.infer_expr_type(x.array, s);
            s = emit_expr(x.array, s);
            s = emit_expr(x.index, s);
            s = s.write("    popq %rcx\n");
            s = s.write("    popq %rax\n");
            if (asmcore.ty_is_string(ct)) {
                // box[0] = data ptr; load byte at +rcx.
                s = s.write("    movq (%rax), %rax\n");
                s = s.write("    movzbq (%rax,%rcx,1), %rax\n");
            } else {
                s = s.write("    incq %rcx\n");
                s = s.write("    movq (%rax,%rcx,8), %rax\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprSlice(sl) => {
            // String slice: allocate a new 16-byte box with
            // data_ptr = src.data_ptr + start, len = end - start.
            // No bounds check.
            var st: asmcore.Ty = asmcore.infer_expr_type(sl.array, s);
            if (asmcore.ty_is_string(st)) {
                s = emit_expr(sl.array, s);
                s = emit_expr(sl.start, s);
                s = emit_expr(sl.end, s);
                s = s.write("    popq %r8\n");          // end
                s = s.write("    popq %rcx\n");         // start
                s = s.write("    popq %rdx\n");         // src box
                // Save end/start/src across __fern_alloc call.
                // SysV: %rdi/rsi/rdx/rcx/r8/r9 are arg regs +
                // caller-saved. Use callee-saved %r12 for end,
                // %r13 for start, %r14 for src.
                s = s.write("    pushq %r12\n");
                s = s.write("    pushq %r13\n");
                s = s.write("    pushq %r14\n");
                s = s.write("    movq %r8, %r12\n");
                s = s.write("    movq %rcx, %r13\n");
                s = s.write("    movq %rdx, %r14\n");
                s = s.write("    movq $16, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                // box.data_ptr = src.data_ptr + start.
                s = s.write("    movq (%r14), %rcx\n");
                s = s.write("    addq %r13, %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                // box.len = end - start.
                s = s.write("    movq %r12, %rcx\n");
                s = s.write("    subq %r13, %rcx\n");
                s = s.write("    movq %rcx, 8(%rax)\n");
                s = s.write("    popq %r14\n");
                s = s.write("    popq %r13\n");
                s = s.write("    popq %r12\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (asmcore.is_int_array_tag(st) || asmcore.ty_is_array_string(st) || asmcore.ty_is_array(st)) {
                s = emit_expr(sl.array, s);
                s = emit_expr(sl.start, s);
                s = emit_expr(sl.end, s);
                s = s.write("    popq %rdx\n");        // end
                s = s.write("    popq %rsi\n");        // start
                s = s.write("    popq %rdi\n");        // src arr
                s = s.write("    call __fern_arr_slice\n");
                s = s.write("    pushq %rax\n");
                s = s.mark_arr_slice();
                return s;
            }
            s = s.write("    # unsupported: slice on non-string\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprStructLit(sl) => {
            // Layout: [shape_ptr, val0, val1, …, val_(N-1)].
            // The shape pointer is the interned struct-name
            // string in .rodata — string-pointer equality is
            // enough to identify the struct type at runtime.
            //
            // Struct-update `Name { ...base, f: v }`: the new box has
            // one slot per DECLARED field (in decl order); un-overridden
            // slots are copied verbatim from the base, the rest are the
            // override values. Perceus: both the copied array fields and
            // the override array values are retained (the new struct owns
            // those references) — matching the Go IR lowering. Needed for
            // free-readiness: the new struct may outlive the base/source.
            if (sl.has_base) {
                // Find the struct decl to size the box + map override
                // names to decl-order field indices.
                var dn: i32 = 0;
                var fields: parser.StructFieldDecl[] = [];
                var ddi: i32 = 0;
                while (ddi < s.struct_decls.len()) {
                    if (s.struct_decls[ddi].name == sl.type_name) {
                        fields = s.struct_decls[ddi].fields;
                        dn = fields.len();
                    }
                    ddi = ddi + 1;
                }
                // Evaluate the base (its pointer lands on the rt-stack).
                s = emit_expr(sl.base, s);
                // Allocate the new box: (dn+1)*8 bytes. Base ptr stays on
                // the rt-stack across the call (alloc clobbers scratch).
                var su_bytes: i32 = (dn + 1) * 8;
                s = s.write("    movq $" + util.i32_to_string(su_bytes) + ", %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                // Shape pointer at [%rax + 0].
                var suNameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, sl.type_name);
                s = suNameLit.state;
                s = s.write("    leaq .S" + util.i32_to_string(suNameLit.idx) + "(%rip), %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                // Pop the base pointer into %rsi — no calls happen during
                // the field-copy below, so %rsi survives.
                s = s.write("    popq %rsi\n");
                // Copy each NON-overridden declared field from base→box.
                var ci: i32 = 0;
                while (ci < dn) {
                    var cname: string = fields[ci].name;
                    var overridden: boolean = false;
                    var oj: i32 = 0;
                    while (oj < sl.field_names.len()) {
                        if (sl.field_names[oj] == cname) { overridden = true; }
                        oj = oj + 1;
                    }
                    if (!overridden) {
                        s = s.write("    movq " + util.i32_to_string((ci + 1) * 8) + "(%rsi), %rcx\n");
                        // Perceus construction inc: the new struct gets a
                        // reference to the base's array field, so retain it
                        // (base + box ptrs preserved across the call).
                        if (asmcore.ty_is_array_like(asmcore.ty_from_name(fields[ci].type_name))) {
                            s = s.mark_heap();
                            s = s.write("    pushq %rsi\n");            // save base
                            s = s.write("    pushq %rax\n");            // save box
                            s = s.write("    pushq %rcx\n");            // retain arg
                            s = s.write("    call __fn___fern_rc_inc\n");
                            s = s.write("    addq $8, %rsp\n");
                            s = s.write("    movq %rax, %rcx\n");       // value (helper returns ptr)
                            s = s.write("    popq %rax\n");             // restore box
                            s = s.write("    popq %rsi\n");             // restore base
                        }
                        s = s.write("    movq %rcx, " + util.i32_to_string((ci + 1) * 8) + "(%rax)\n");
                    }
                    ci = ci + 1;
                }
                // Save the box pointer on the rt-stack; the override
                // value exprs below may use both registers and the stack.
                s = s.write("    pushq %rax\n");
                var ok: i32 = 0;
                while (ok < sl.field_names.len()) {
                    // decl-order index of this override field.
                    var oidx: i32 = 0;
                    var of2: i32 = 0;
                    while (of2 < dn) {
                        if (fields[of2].name == sl.field_names[ok]) { oidx = of2; }
                        of2 = of2 + 1;
                    }
                    var ov_inc: boolean = asmcore.needs_rc_inc_on_alias(sl.field_values[ok], s);
                    s = emit_expr(sl.field_values[ok], s);  // rt: [box, val]
                    s = s.write("    popq %rcx\n");          // val → %rcx
                    s = s.write("    popq %rax\n");          // box → %rax
                    if (ov_inc) {
                        s = s.mark_heap();
                        s = s.write("    pushq %rax\n");            // save box
                        s = s.write("    pushq %rcx\n");            // retain arg = override value
                        s = s.write("    call __fn___fern_rc_inc\n");
                        s = s.write("    addq $8, %rsp\n");
                        s = s.write("    movq %rax, %rcx\n");       // value (helper returns ptr)
                        s = s.write("    popq %rax\n");             // restore box
                    }
                    s = s.write("    movq %rcx, " + util.i32_to_string((oidx + 1) * 8) + "(%rax)\n");
                    s = s.write("    pushq %rax\n");         // box back on rt-stack
                    ok = ok + 1;
                }
                return s;
            }
            var n_fields: i32 = sl.field_values.len();
            // Field-slot mapping (#4554): values are EVALUATED in literal
            // order (source-visible side effects keep their written order),
            // but each value must be STORED at its field's DECLARATION-order
            // slot — the offset ExprFieldAccess reads back at. The old code
            // stored positionally (literal index j → slot j+1), silently
            // scrambling every field of a literal written out of decl order
            // (the #4552 LowerState literal corrupted the stage-2 bootstrap
            // this way: `aliased_names` read back `clo_cap_kinds`' value).
            // slot_of[j] = decl index of literal field j, falling back to j
            // when the decl is unknown or a name doesn't resolve (synthesized
            // literals for shapes without a registered decl keep the old
            // positional layout, which is also how they are read back).
            var lit_fields: parser.StructFieldDecl[] = [];
            var lfi: i32 = 0;
            while (lfi < s.struct_decls.len()) {
                if (s.struct_decls[lfi].name == sl.type_name) { lit_fields = s.struct_decls[lfi].fields; }
                lfi = lfi + 1;
            }
            // Allocation-free fast path: virtually every literal already lists
            // its fields in decl order, and this emitter runs on the
            // leak-everything bump heap — building a slot_of array per literal
            // across a whole self-compile is real heap pressure (the arm64
            // stage-2 self-compile sits near its arena limit, #3425). Only
            // build the mapping when a name is actually out of place.
            var lit_in_order: boolean = true;
            var oc: i32 = 0;
            while (oc < n_fields) {
                if (lit_fields.len() > 0 && oc < sl.field_names.len() && oc < lit_fields.len()) {
                    if (lit_fields[oc].name != sl.field_names[oc]) { lit_in_order = false; }
                }
                oc = oc + 1;
            }
            var slot_of: i32[] = [];
            if (!lit_in_order) {
                var so: i32 = 0;
                while (so < n_fields) {
                    var so_idx: i32 = so;
                    if (lit_fields.len() > 0 && so < sl.field_names.len()) {
                        var sd: i32 = 0;
                        while (sd < lit_fields.len()) {
                            if (lit_fields[sd].name == sl.field_names[so]) { so_idx = sd; }
                            sd = sd + 1;
                        }
                    }
                    slot_of = slot_of.append(so_idx);
                    so = so + 1;
                }
            }
            var i: i32 = 0;
            while (i < n_fields) {
                s = emit_expr(sl.field_values[i], s);
                i = i + 1;
            }
            // Box size: the DECLARED field count when the decl is known (a
            // literal is checker-verified complete, so these agree; the decl
            // count is the layout truth), else the literal count.
            var box_fields: i32 = n_fields;
            if (lit_fields.len() > 0) { box_fields = lit_fields.len(); }
            var slot_bytes: i32 = (box_fields + 1) * 8;
            s = s.write("    movq $" + util.i32_to_string(slot_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            // Intern the struct name string in .rodata.
            var nameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, sl.type_name);
            s = nameLit.state;
            s = s.write("    leaq .S" + util.i32_to_string(nameLit.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            // Pop fields off the rt-stack into the struct. Perceus
            // construction inc (Phase 1d): a field initialised from an
            // rc-tracked array alias creates a new reference the struct
            // now owns, so retain it (prevents a use-after-free once
            // free is on — the struct outlives the source local). A
            // fresh literal / call value is already owned. %rax holds
            // the box ptr and must survive the retain call.
            var j: i32 = n_fields - 1;
            while (j >= 0) {
                s = s.write("    popq %rcx\n");
                if (asmcore.needs_rc_inc_on_alias(sl.field_values[j], s)) {
                    s = s.mark_heap();
                    s = s.write("    pushq %rax\n");            // save box ptr
                    s = s.write("    pushq %rcx\n");            // retain arg = field value
                    s = s.write("    call __fn___fern_rc_inc\n");
                    s = s.write("    addq $8, %rsp\n");
                    s = s.write("    movq %rax, %rcx\n");       // value (helper returns the ptr)
                    s = s.write("    popq %rax\n");             // restore box ptr
                }
                var st_idx: i32 = j;
                if (!lit_in_order) { st_idx = slot_of[j]; }
                s = s.write("    movq %rcx, " + util.i32_to_string((st_idx + 1) * 8) + "(%rax)\n");
                j = j - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field name (`.0` / `.1` / …) → tuple
            // access. Tuples are laid out without a shape
            // pointer, so the offset is just idx*8 from the
            // box pointer. No runtime dispatch needed.
            if (util.is_all_digits(fa.field)) {
                var tup_idx: i32 = util.digits_to_i32(fa.field);
                s = emit_expr(fa.obj, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq " + util.i32_to_string(tup_idx * 8) + "(%rax), %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Lowering: compile the receiver expression, pop
            // the struct pointer into %rax, dispatch on the
            // shape pointer at [%rax + 0]. For each struct
            // decl in mod.structs that contains a field with
            // this name, emit a "if shape matches → load at
            // compile-time offset" arm. Falls through to a
            // sentinel (-1) if no match.
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rax\n");
            // Use the label counter for end-of-dispatch label.
            var end_lbl: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
            // Walk each struct decl looking for the named
            // field. Emit a shape-pointer comparison arm for
            // each match.
            var di: i32 = 0;
            while (di < s.struct_decls.len()) {
                var sd: parser.StructDecl = s.struct_decls[di];
                var fi: i32 = 0;
                var found_idx: i32 = 0 - 1;
                while (fi < sd.fields.len()) {
                    if (sd.fields[fi].name == fa.field) { found_idx = fi; }
                    fi = fi + 1;
                }
                if (found_idx >= 0) {
                    var arm_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, sd.name);
                    s = arm_lit.state;
                    s = s.write("    movq (%rax), %rcx\n");
                    s = s.write("    leaq .S" + util.i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    jne .Lfa_next_" + util.i32_to_string(s.label_n) + "\n");
                    s = s.write("    movq " + util.i32_to_string((found_idx + 1) * 8) + "(%rax), %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp .Lfa_end_" + util.i32_to_string(end_lbl) + "\n");
                    s = s.write(".Lfa_next_" + util.i32_to_string(s.label_n) + ":\n");
                    s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
                }
                di = di + 1;
            }
            // No-shape-matched fallthrough: push sentinel -1.
            s = s.write("    movq $-1, %rax\n");
            s = s.write("    pushq %rax\n");
            s = s.write(".Lfa_end_" + util.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.ExprLambda(lm) => {
            // Lowering with always-box calling convention:
            //
            //   jmp .Lskip_lambda_N
            //   .Llambda_N:
            //       <prologue; load box ptr from +16(%rbp);
            //        load each capture from box[+8, +16, …];
            //        load params from +24, +32, …; body;
            //        implicit return 0>
            //   .Lskip_lambda_N:
            //   # allocate (1 + N_caps) * 8 bytes on heap
            //   movq $<bytes>, %rdi; call __fern_alloc
            //   leaq .Llambda_N(%rip), %rcx
            //   movq %rcx, (%rax)              # fn_addr at box[0]
            //   # eval each capture in OUTER scope and store
            //   movq <cap_local_off>(%rbp), %rcx
            //   movq %rcx, <(i+1)*8>(%rax)
            //   pushq %rax                     # box ptr
            //
            // The call site reads box ptr, peeks box[0] for the
            // fn_addr, and indirect-calls. The box ptr lives on
            // the stack just below the args so the callee sees
            // it at +16(%rbp).
            //
            // Capture-less lambdas use the same shape with a
            // 1-slot box, keeping the call convention uniform.
            var caps: string[] = asmcore.lambda_captures(lm, s);
            var n_caps: i32 = caps.len();
            var lam_id: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 2 };
            var skip_lbl: string = ".Lskip_lambda_" + util.i32_to_string(lam_id);
            var body_lbl: string = ".Llambda_" + util.i32_to_string(lam_id);
            s = s.write("    jmp " + skip_lbl + "\n");
            s = s.write(body_lbl + ":\n");
            s = s.write("    pushq %rbp\n");
            s = s.write("    movq %rsp, %rbp\n");
            // Inside the body, allocate locals for:
            //   1 box-ptr slot + N capture slots + M param
            //   slots + count_locals(body) inner-var slots.
            var saved_locals: string[] = s.local_names;
            var saved_local_types: asmcore.Ty[] = s.local_types;
            var saved_in_function: boolean = s.in_function;
            var argc_l: i32 = lm.params.len();
            var n_body_locals_l: i32 = asmcore.count_locals(lm.body);
            var total_locals_l: i32 = 1 + n_caps + argc_l + n_body_locals_l;
            if (total_locals_l > 0) {
                var bytes_l: i32 = total_locals_l * 8;
                if (bytes_l % 16 != 0) { bytes_l = bytes_l + 8; }
                s = s.write("    subq $" + util.i32_to_string(bytes_l) + ", %rsp\n");
            }
            s = s.reset_locals();
            s = s.enter_function();
            // Bind __closure_box (slot 0), copy from %r10 (the box
            // ptr the call site loaded into that register).
            var box_name: string = "__closure_box";
            s = s.bind_local(box_name);
            var box_off: i32 = s.lookup_local(box_name);
            s = s.write("    movq %r10, " + util.i32_to_string(box_off) + "(%rbp)\n");
            // Bind each capture, load from box[+(i+1)*8]. The
            // capture preserves the outer scope's type so that
            // type-aware dispatch inside the lambda body (e.g.
            // `len(s)` resolving to the string-len helper, or
            // `a + b` routing through `__fern_str_concat`)
            // sees the right thing — without this the captured
            // local lands here as `"unknown"` and falls through
            // to the i32 path.
            var ci: i32 = 0;
            while (ci < n_caps) {
                var cap_ty: asmcore.Ty = asmcore.ty_unknown();
                var li: i32 = 0;
                while (li < saved_locals.len()) {
                    if (saved_locals[li] == caps[ci]) {
                        cap_ty = saved_local_types[li];
                        li = saved_locals.len();
                    } else {
                        li = li + 1;
                    }
                }
                s = s.bind_local_typed(caps[ci], cap_ty);
                var c_off: i32 = s.lookup_local(caps[ci]);
                s = s.write("    movq " + util.i32_to_string(box_off) + "(%rbp), %rcx\n");
                s = s.write("    movq " + util.i32_to_string((ci + 1) * 8) + "(%rcx), %rax\n");
                s = s.write("    movq %rax, " + util.i32_to_string(c_off) + "(%rbp) # capture " + caps[ci] + "\n");
                ci = ci + 1;
            }
            // Bind params; args sit at +16, +24, … — IDENTICAL to a
            // direct call, because the box now arrives in %r10 rather
            // than as a hidden stack arg.
            var pi2: i32 = 0;
            while (pi2 < argc_l) {
                s = s.bind_local_typed(lm.params[pi2].name, asmcore.ty_from_name(lm.params[pi2].type_name));
                var p_off: i32 = s.lookup_local(lm.params[pi2].name);
                var a_off: i32 = 16 + pi2 * 8;
                s = s.write("    movq " + util.i32_to_string(a_off) + "(%rbp), %rax\n");
                s = s.write("    movq %rax, " + util.i32_to_string(p_off) + "(%rbp) # param " + lm.params[pi2].name + "\n");
                pi2 = pi2 + 1;
            }
            // Body.
            var bi_l: i32 = 0;
            while (bi_l < lm.body.len()) {
                s = emit_stmt(lm.body[bi_l], s);
                bi_l = bi_l + 1;
            }
            // Fallback implicit return 0.
            s = s.write("    movq $0, %rax\n");
            s = s.write("    leave\n");
            s = s.write("    ret\n");
            // Restore outer scope's locals + in_function flag.
            s = asmcore.EmitState { ...s, local_names: saved_locals, in_function: saved_in_function, local_types: saved_local_types };
            s = s.write(skip_lbl + ":\n");
            // Allocate box: (1 + n_caps) * 8 bytes.
            var box_bytes: i32 = (1 + n_caps) * 8;
            s = s.write("    movq $" + util.i32_to_string(box_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            // Store fn_addr at box[0].
            s = s.write("    leaq " + body_lbl + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            // Store captures (read from outer locals). Perceus
            // construction inc: a captured rc-tracked array is retained
            // (the closure box owns the reference) — box ptr preserved
            // across the retain call.
            var oi: i32 = 0;
            while (oi < n_caps) {
                var outer_off: i32 = s.lookup_local(caps[oi]);
                s = s.write("    movq " + util.i32_to_string(outer_off) + "(%rbp), %rcx\n");
                if (asmcore.ty_is_array_like(s.local_type_of(caps[oi]))) {
                    s = s.mark_heap();
                    s = s.write("    pushq %rax\n");            // save box ptr
                    s = s.write("    pushq %rcx\n");            // retain arg = capture
                    s = s.write("    call __fn___fern_rc_inc\n");
                    s = s.write("    addq $8, %rsp\n");
                    s = s.write("    movq %rax, %rcx\n");       // value (helper returns ptr)
                    s = s.write("    popq %rax\n");             // restore box ptr
                }
                s = s.write("    movq %rcx, " + util.i32_to_string((oi + 1) * 8) + "(%rax)\n");
                oi = oi + 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    # parser-side unknown\n");
            s = s.write("    pushq $0\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: asmcore.EmitState): asmcore.EmitState {
    var i: i32 = 0;
    while (i < body.len()) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

// emit_map_kv_for emits a `for (k, v) in m` loop (the var name is
// "k,v"; kv_comma is the comma index). Iterates the map's parallel
// keys[]/values[] arrays by index, binding k = keys[i+1], v =
// values[i+1]. A separate function so emit_stmt's StmtFor arm stays
// small.
function emit_map_kv_for(s: asmcore.EmitState, f: parser.StmtFor, kv_comma: i32): asmcore.EmitState {
    var iter_ty: asmcore.Ty = asmcore.infer_expr_type(f.iter, s);
    var kvk: str = f.var_name[0 : kv_comma];
    var kvv: str = f.var_name[kv_comma + 1 : f.var_name.len()];
    var kvk_ty: asmcore.Ty = asmcore.ty_string();
    if (asmcore.map_key_is_i32(iter_ty)) { kvk_ty = asmcore.ty_i32(); }
    var kvv_ty: asmcore.Ty = asmcore.map_val(iter_ty);
    s = emit_expr(f.iter, s);
    var kvm_name: string = "__forkv_map_" + util.i32_to_string(s.label_n);
    s = s.bind_local(kvm_name);
    var kvm_off: i32 = s.lookup_local(kvm_name);
    s = s.write("    popq %rax\n");
    s = s.write("    movq %rax, " + util.i32_to_string(kvm_off) + "(%rbp)\n");
    var kvi_name: string = "__forkv_i_" + util.i32_to_string(s.label_n);
    s = s.bind_local(kvi_name);
    var kvi_off: i32 = s.lookup_local(kvi_name);
    s = s.write("    movq $0, " + util.i32_to_string(kvi_off) + "(%rbp)\n");
    s = s.bind_local_typed(kvk, kvk_ty);
    var kvk_off: i32 = s.lookup_local(kvk);
    s = s.bind_local_typed(kvv, kvv_ty);
    var kvv_off: i32 = s.lookup_local(kvv);
    var kvtop: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvtop.state;
    var kvcont: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvcont.state;
    var kvend: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvend.state;
    s = s.write(kvtop.name + ":\n");
    s = s.write("    movq " + util.i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");   // keys arr
    s = s.write("    movq (%rcx), %rcx\n");   // keys.len
    s = s.write("    movq " + util.i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    cmpq %rcx, %rdx\n");
    s = s.write("    jge " + kvend.name + "\n");
    s = s.write("    movq " + util.i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");   // keys arr
    s = s.write("    movq " + util.i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rcx,%rdx,8), %rax\n");   // keys[i+1]
    s = s.write("    movq %rax, " + util.i32_to_string(kvk_off) + "(%rbp)\n");
    s = s.write("    movq " + util.i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq 8(%rax), %rcx\n");   // values arr
    s = s.write("    movq " + util.i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rcx,%rdx,8), %rax\n");   // values[i+1]
    s = s.write("    movq %rax, " + util.i32_to_string(kvv_off) + "(%rbp)\n");
    s = s.push_loop_labels(kvend.name, kvcont.name);
    var kvbi: i32 = 0;
    while (kvbi < f.body.len()) {
        s = emit_stmt(f.body[kvbi], s);
        kvbi = kvbi + 1;
    }
    s = s.pop_loop_labels();
    s = s.write(kvcont.name + ":\n");
    s = s.write("    movq " + util.i32_to_string(kvi_off) + "(%rbp), %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rax, " + util.i32_to_string(kvi_off) + "(%rbp)\n");
    s = s.write("    jmp " + kvtop.name + "\n");
    s = s.write(kvend.name + ":\n");
    return s;
}

// emit_array_exit_dec emits the Perceus function-exit release sweep:
// release (dec) each array-typed LOCAL slot, skipping the leading
// n_params receiver+parameter slots (params are BORROWED — the caller
// still owns them). Slot for local index i is at -8*(i+1)(%rbp). The
// dec helper short-circuits null / low-address / sentinel, so an
// unassigned (zero-init) slot or a non-pointer is a no-op. Clobbers
// %rax/%rcx — callers needing a live value across the sweep save it
// first. Emitted at every in-function return + the fallback exit.
//
// `excl` is the local index to SKIP (Perceus move-on-return elides the
// dec for the slot whose buffer is being handed to the caller); pass -1
// to sweep every array local.
function emit_array_exit_dec_excl(s: asmcore.EmitState, excl: i32): asmcore.EmitState {
    var i: i32 = s.n_params;
    var any: boolean = false;
    while (i < s.local_names.len()) {
        if (i != excl && asmcore.ty_is_array_like(s.local_types[i])) {
            var off: i32 = 0 - 8 * (i + 1);
            s = s.write("    pushq " + util.i32_to_string(off) + "(%rbp)\n");  // slot value as dec arg
            s = s.write("    call __fn___fern_arr_dec\n");
            s = s.write("    addq $8, %rsp\n");
            any = true;
        }
        i = i + 1;
    }
    if (any) { s = s.mark_heap(); }
    return s;
}

function emit_array_exit_dec(s: asmcore.EmitState): asmcore.EmitState {
    return emit_array_exit_dec_excl(s, 0 - 1);
}

function emit_stmt(stmt: parser.Stmt, s: asmcore.EmitState): asmcore.EmitState {
    match (stmt) {
        // StmtDefer is lowered away (lower_defers) before emit; this arm only
        // satisfies exhaustiveness.
        parser.StmtDefer(_) => { s = s.write("    # unsupported: StmtDefer survived lowering\n"); return s; },
        parser.StmtReturn(r) => {
            // Capture whether we're returning an rc-tracked array BEFORE
            // emitting (the type oracle reads the current locals).
            var ret_is_arr: boolean = asmcore.ty_is_array_like(asmcore.infer_expr_type(r.value, s));
            // Perceus move-on-return: returning a bare owned array local
            // hands its buffer to the caller directly — skip the retain
            // inc and exclude that slot from the sweep (a balanced pair).
            var mov_idx: i32 = s.move_on_return_idx(r.value);
            s = emit_expr(r.value, s);
            if (s.in_function) {
                // Function return: result in %rax. Perceus exit: if the
                // result is an array we hand to the caller, retain it so
                // it survives the local release sweep (which dec's its
                // slot); then sweep the array locals, then restore the
                // result and ret. Net rc for the returned buffer is
                // unchanged for the caller. When move-on-return applies
                // (mov_idx >= 0) the inc is elided and the sweep skips
                // that slot, so the pair cancels.
                s = s.write("    popq %rax\n");
                if (ret_is_arr && mov_idx < 0) {
                    s = s.mark_heap();
                    s = s.write("    pushq %rax\n");
                    s = s.write("    call __fn___fern_rc_inc\n");
                    s = s.write("    addq $8, %rsp\n");
                }
                s = s.write("    pushq %rax\n");        // save result across the sweep
                s = emit_array_exit_dec_excl(s, mov_idx);
                s = s.write("    popq %rax\n");          // restore result
                s = s.write("    leave\n");
                s = s.write("    ret\n");
            } else {
                // Top-level return: lower to sys_exit_group so
                // the program terminates with the right exit
                // code.
                s = s.write("    popq %rdi\n");
                s = s.write("    movq $60, %rax\n");
                s = s.write("    syscall\n");
            }
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; popq %rax; cmpq $0, %rax; je <else_lbl>
            //   <then-body>; jmp <end_lbl>
            // <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            var else_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = else_l.state;
            s = s.write("    je " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (ifs.else_body.len() > 0) {
                var end_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = end_l.state;
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; popq %rax; cmpq $0, %rax;
            //            je <exit_lbl>
            //            <body>; jmp <top_lbl>
            // <exit_lbl>:
            //
            // break inside the body jumps to <exit_lbl>;
            // continue jumps to <top_lbl> (re-evaluate cond).
            var top_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = top_l.state;
            var exit_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    je " + exit_l.name + "\n");
            s = s.push_loop_labels(exit_l.name, top_l.name);
            s = emit_block(w.body, s);
            s = s.pop_loop_labels();
            s = s.write("    jmp " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(v) => {
            // `var (a, b, …) = E` tuple destructuring (name encoded
            // "a,b,c"): eval the tuple box, bind name[i] = box[i*8] for any
            // arity. The box pointer stays in %rax across the loop.
            var td_has_comma: boolean = false;
            var tdci: i32 = 0;
            while (tdci < v.name.len()) {
                if (v.name[tdci] == 44) { td_has_comma = true; }
                tdci = tdci + 1;
            }
            if (td_has_comma) {
                s = emit_expr(v.init, s);
                s = s.write("    popq %rax\n");          // tuple box
                var td_seg: i32 = 0;
                var td_idx: i32 = 0;
                var td_pos: i32 = 0;
                while (td_pos <= v.name.len()) {
                    if (td_pos == v.name.len() || v.name[td_pos] == 44) {
                        var td_nm: str = v.name[td_seg : td_pos];
                        var td_tag: asmcore.Ty = asmcore.tuple_destructure_tag_at(v.init, td_idx, s);
                        s = s.bind_local_typed(td_nm, td_tag);
                        var td_off: i32 = s.lookup_local(td_nm);
                        s = s.write("    movq " + util.i32_to_string(td_idx * 8) + "(%rax), %rcx\n");
                        s = s.write("    movq %rcx, " + util.i32_to_string(td_off) + "(%rbp)\n");
                        td_idx = td_idx + 1;
                        td_seg = td_pos + 1;
                    }
                    td_pos = td_pos + 1;
                }
                return s;
            }
            // Compile init, then pop to the new local's slot.
            // Infer init's type so the local carries it (used
            // by string-aware dispatch in ExprBinary / len /
            // print etc.). An explicit annotation overrides
            // the inference. bind_local_typed binds the name
            // BEFORE the lookup_local call resolves the slot.
            var ity: asmcore.Ty = asmcore.infer_expr_type(v.init, s);
            if (v.type_name.len() > 0) {
                ity = asmcore.ty_from_name(v.type_name);
            }
            // Perceus inc (Phase 1d): binding `var y = x` where x is an
            // rc-tracked array creates a second reference, so retain the
            // buffer. A fresh literal / call result is already owned and
            // is not re-incremented (needs_rc_inc_on_alias gates this).
            var alias_inc: boolean = asmcore.needs_rc_inc_on_alias(v.init, s);
            s = emit_expr(v.init, s);
            s = s.bind_local_typed(v.name, ity);
            var off: i32 = s.lookup_local(v.name);
            s = s.write("    popq %rax\n");
            if (alias_inc) {
                s = s.mark_heap();                          // __fern_rc_inc lives in the heap runtime block
                s = s.write("    pushq %rax\n");            // arg for __fern_rc_inc (frameless: param[0] at 8(%rsp))
                s = s.write("    call __fn___fern_rc_inc\n"); // returns the ptr in %rax
                s = s.write("    addq $8, %rsp\n");
            }
            // Perceus dec-on-overwrite at a re-bound array slot: a loop
            // body's `var r = …` maps to ONE frame slot (zero-init at entry,
            // so the first binding releases null — a no-op), so releasing the
            // slot's prior buffer here frees each iteration's value instead
            // of leaking all but the last. Cow-guarded (skip when the RHS is
            // the same object, as an in-place mutator can return); balanced
            // with the alias-inc above.
            if (asmcore.ty_is_array_like(ity)) {
                s = s.mark_heap();
                var dvov: asmcore.LabelOut = asmcore.fresh_label(s);
                s = dvov.state;
                s = s.write("    movq " + util.i32_to_string(off) + "(%rbp), %rcx\n");  // OLD slot value
                s = s.write("    cmpq %rax, %rcx\n");
                s = s.write("    je " + dvov.name + "\n");
                s = s.write("    pushq %rax\n");            // save new value across the dec
                s = s.write("    pushq %rcx\n");            // OLD value as dec arg
                s = s.write("    call __fn___fern_arr_dec\n");
                s = s.write("    addq $8, %rsp\n");         // pop dec arg
                s = s.write("    popq %rax\n");             // restore new value
                s = s.write(dvov.name + ":\n");
            }
            s = s.write("    movq %rax, " + util.i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtAssign(a) => {
            if (!s.has_local(a.target)) {
                s = s.write("    # unresolved assign: " + a.target + "\n");
                return s;
            }
            // Perceus inc/dec (Phase 1d): reassigning an array slot
            // `y = x` retains the new reference (if it aliases an
            // rc-tracked array) and releases the OLD value the slot held
            // (dec-on-overwrite). A fresh literal / call RHS is already
            // owned and is not re-incremented. The old value was bound
            // by an earlier `var y = ...` (rc >= 1) or is null, so the
            // dec is over-release-detector clean. No free yet (safe
            // leak) — this balances the reassignment lifecycle ahead of
            // Phase 3.
            var reassign_inc: boolean = asmcore.needs_rc_inc_on_alias(a.value, s);
            var target_is_arr: boolean = asmcore.ty_is_array_like(s.local_type_of(a.target));
            // Borrow model: a reassigned array PARAMETER (idx < n_params)
            // must NOT release its old value -- the caller owns it.
            if ((0 - s.lookup_local(a.target)) / 8 - 1 < s.n_params) { target_is_arr = false; }
            s = emit_expr(a.value, s);
            var off: i32 = s.lookup_local(a.target);
            s = s.write("    popq %rax\n");                 // new value
            if (reassign_inc) {
                s = s.mark_heap();
                s = s.write("    pushq %rax\n");
                s = s.write("    call __fn___fern_rc_inc\n"); // retain new (returns ptr in %rax)
                s = s.write("    addq $8, %rsp\n");
            }
            if (target_is_arr) {
                s = s.mark_heap();
                // Cow-aware dec (Phase 3 prep): skip the release when the
                // new value IS the old value the slot held — i.e. an
                // in-place mutator (`xs = xs.append(v)` growing in place)
                // returned the same buffer. Releasing it then would
                // over-count (the buffer is still live as the new value).
                // Only release when the RHS produced a DIFFERENT object.
                var skip_lbl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = skip_lbl.state;
                s = s.write("    movq " + util.i32_to_string(off) + "(%rbp), %rcx\n");  // OLD value
                s = s.write("    cmpq %rax, %rcx\n");
                s = s.write("    je " + skip_lbl.name + "\n");
                s = s.write("    pushq %rax\n");            // save new value across the dec
                s = s.write("    pushq %rcx\n");            // OLD value as dec arg
                s = s.write("    call __fn___fern_arr_dec\n");
                s = s.write("    addq $8, %rsp\n");         // pop dec arg
                s = s.write("    popq %rax\n");             // restore new value
                s = s.write(skip_lbl.name + ":\n");
            }
            s = s.write("    movq %rax, " + util.i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtExpr(x) => {
            // Evaluate for side effects, drop the result.
            s = emit_expr(x.value, s);
            s = s.write("    popq %rax\n");
            return s;
        },
        parser.StmtMatch(m) => {
            // Lowering: eval the scrutinee, save into a fresh
            // local slot (so each arm can reload it without
            // worrying about %rax being clobbered by inner ops).
            // Then for each arm, emit:
            //   PatVariant: load shape ptr, compare to interned
            //   struct name, jump to next arm on mismatch. On
            //   match, bind `binding` to the scrutinee value
            //   (if non-empty), execute body, jump to end.
            //   PatWildcard: always match, no dispatch.
            // No exhaustiveness check — that's the checker's job.
            s = emit_expr(m.scrutinee, s);
            // Allocate the synthetic scrutinee slot.
            var scrut_name: string = "__match_scrut_" + util.i32_to_string(s.label_n);
            s = s.bind_local(scrut_name);
            var scrut_off: i32 = s.lookup_local(scrut_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + util.i32_to_string(scrut_off) + "(%rbp)\n");
            // Bump the label counter for end-of-match.
            var end_lbl: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[ai];
                var next_lbl: i32 = s.label_n;
                s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.type_name == "true" || pv.type_name == "false") {
                            // `match (b) { true => …, false => … }`: the
                            // scrutinee is the bool itself (0/1), not a box.
                            s = s.write("    movq " + util.i32_to_string(scrut_off) + "(%rbp), %rax\n");
                            s = s.write("    testq %rax, %rax\n");
                            if (pv.type_name == "true") {
                                s = s.write("    jz .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                            } else {
                                s = s.write("    jnz .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                            }
                        } else if (pv.type_name == "Some" || pv.type_name == "None"
                                || pv.type_name == "Ok" || pv.type_name == "Err") {
                            // Built-in Option / Result: discriminate on
                            // the i32 tag at offset 0 (Some/Ok=0,
                            // None/Err=1), not the struct shape pointer.
                            // The non-empty variant (Some/Ok) binds its
                            // PAYLOAD (offset 8), not the box.
                            s = s.write("    movq " + util.i32_to_string(scrut_off) + "(%rbp), %rax\n");
                            s = s.write("    movq (%rax), %rcx\n");
                            var want: i32 = 0;
                            if (pv.type_name == "None" || pv.type_name == "Err") { want = 1; }
                            s = s.write("    cmpq $" + util.i32_to_string(want) + ", %rcx\n");
                            s = s.write("    jne .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                s = s.write("    movq 8(%rax), %rcx\n");   // payload
                                // The only Option/Result producers here
                                // (read_chunk → Some, read_file → Ok) carry
                                // string payloads, so bind the payload as a
                                // string for print / concat dispatch.
                                s = s.bind_local_typed(pv.binding, asmcore.match_payload_type(m.scrutinee, s));
                                var pbind_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rcx, " + util.i32_to_string(pbind_off) + "(%rbp)\n");
                            }
                        } else {
                        // Shape-pointer compare against pv.type_name.
                        s = s.write("    movq " + util.i32_to_string(scrut_off) + "(%rbp), %rax\n");
                        s = s.write("    movq (%rax), %rcx\n");
                        var nameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, pv.type_name);
                        s = nameLit.state;
                        s = s.write("    leaq .S" + util.i32_to_string(nameLit.idx) + "(%rip), %rdx\n");
                        s = s.write("    cmpq %rdx, %rcx\n");
                        s = s.write("    jne .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                        if (pv.binding.len() > 0 && pv.binding != "_") {
                            if (asmcore.is_enum_variant(pv.type_name, s)) {
                                // Enum variant `Circle(r)`: bind the
                                // PAYLOAD at offset 8 (typed via the
                                // "__ev" marker field), not the box.
                                s = s.write("    movq 8(%rax), %rcx\n");
                                s = s.bind_local_typed(pv.binding, asmcore.field_type_tag_in(pv.type_name, "__ev", s));
                                var ev_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rcx, " + util.i32_to_string(ev_off) + "(%rbp)\n");
                            } else {
                                // `type X = A|B` union member: bind the
                                // whole struct, typed with the variant's
                                // struct name so a field read (`VString(s)
                                // => s.v`) resolves within that struct.
                                s = s.bind_local_typed(pv.binding, asmcore.ty_named(pv.type_name));
                                var bind_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rax, " + util.i32_to_string(bind_off) + "(%rbp)\n");
                            }
                        }
                        }
                    },
                    parser.PatWildcard(_) => {
                        // Wildcard always matches — no dispatch.
                    }
                }
                // Guard: a `Pat when <expr> =>` arm runs its body only if the
                // guard is true. The binding (if any) is already in scope, so
                // the guard may reference it (`Has(n) when n > 0`). A false
                // guard jumps to the next arm — the same target as a pattern
                // mismatch — so it falls through correctly (and an all-guards-
                // fail match falls through to the end, like a non-exhaustive
                // match).
                if (arm.has_guard) {
                    s = emit_expr(arm.guard, s);
                    s = s.write("    popq %rax\n");
                    s = s.write("    testq %rax, %rax\n");
                    s = s.write("    jz .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                }
                // Emit the arm body.
                var bi: i32 = 0;
                while (bi < arm.body.len()) {
                    s = emit_stmt(arm.body[bi], s);
                    bi = bi + 1;
                }
                s = s.write("    jmp .Lmatch_end_" + util.i32_to_string(end_lbl) + "\n");
                s = s.write(".Lmatch_next_" + util.i32_to_string(next_lbl) + ":\n");
                ai = ai + 1;
            }
            s = s.write(".Lmatch_end_" + util.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtFor(f) => {
            // Lowering desugar: `for x in arr { body }`
            //   var __for_arr_N = arr;
            //   var __for_i_N = 0;
            //   while (__for_i_N < len(__for_arr_N)) {
            //       var x = __for_arr_N[__for_i_N];
            //       body;
            //       __for_i_N = __for_i_N + 1;
            //   }
            //
            // Allocate three synthetic locals (array ptr, index,
            // element var). The index lives in a slot so the
            // body can read it for diagnostics; the iter
            // expression is hoisted into a slot so it isn't re-
            // evaluated each iteration (mirrors how `for` works
            // in higher-level languages — the iterator is
            // resolved once).
            // Infer container element type so the loop var
            // carries it (lets `for x in strs { print(x); }`
            // dispatch as string).
            var iter_ty: asmcore.Ty = asmcore.infer_expr_type(f.iter, s);
            // `for (k, v) in m` — the var name is "k,v"; iterate the
            // map's parallel keys[]/values[] arrays (see emit_map_kv_for).
            var kv_comma: i32 = 0 - 1;
            var kvci: i32 = 0;
            while (kvci < f.var_name.len()) {
                if (f.var_name[kvci] == 44 && kv_comma < 0) { kv_comma = kvci; }
                kvci = kvci + 1;
            }
            if (asmcore.is_map(iter_ty) && kv_comma >= 0) {
                return emit_map_kv_for(s, f, kv_comma);
            }
            var elem_ty: asmcore.Ty = asmcore.ty_i32();
            if (asmcore.ty_is_array_string(iter_ty)) { elem_ty = asmcore.ty_string(); }
            if (asmcore.ty_is_array_u32(iter_ty)) { elem_ty = asmcore.ty_u32(); }
            if (asmcore.ty_is_array_u64(iter_ty)) { elem_ty = asmcore.ty_u64(); }
            if (asmcore.ty_is_array_i64(iter_ty)) { elem_ty = asmcore.ty_i64(); }
            // Generic `array` tag (struct / `dyn Trait` / otherwise
            // non-primitive elements — `ret_tag_of` collapses every
            // `T[]` that isn't a known scalar array to "array", losing
            // the element name). Bind the loop var as "unknown" rather
            // than the i32 default so a method call on it
            // (`for x in shapes { x.area() }`) routes through the
            // runtime-shape dispatch instead of the primitive path.
            if (asmcore.ty_is_array(iter_ty)) { elem_ty = asmcore.ty_unknown(); }
            // `for b in STR` (iterate a string's BYTES): a string box is
            // { data_ptr @0, len @8 } with byte elements, NOT the array layout
            // (len @0, 8-byte elements) below. Reading it as an array walks the
            // header as data (#2822). The IR path desugars in lower_string_
            // foreach; the AST path needs the string-shaped length + byte loads
            // (latent here — str_to_i32's `for b in s` routes IR on x86 — but
            // kept in parity with the arm64 AST fix so an AST-routed string
            // foreach is correct on both backends). Bytes bind as i32.
            var is_str_iter: boolean = asmcore.ty_is_string(iter_ty);
            if (is_str_iter) { elem_ty = asmcore.ty_i32(); }
            s = emit_expr(f.iter, s);
            var arr_name: string = "__for_arr_" + util.i32_to_string(s.label_n);
            s = s.bind_local(arr_name);
            var arr_off: i32 = s.lookup_local(arr_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + util.i32_to_string(arr_off) + "(%rbp)\n");
            var idx_name: string = "__for_i_" + util.i32_to_string(s.label_n);
            s = s.bind_local(idx_name);
            var idx_off: i32 = s.lookup_local(idx_name);
            s = s.write("    movq $0, " + util.i32_to_string(idx_off) + "(%rbp)\n");
            s = s.bind_local_typed(f.var_name, elem_ty);
            var elem_off: i32 = s.lookup_local(f.var_name);
            // Loop labels: top (cond), cont (i++), end (exit).
            var top_lbl: i32 = s.label_n;
            var cont_lbl: i32 = s.label_n + 1;
            var end_lbl: i32 = s.label_n + 2;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 3 };
            s = s.write(".Lfor_top_" + util.i32_to_string(top_lbl) + ":\n");
            // Condition: __for_i_N < len(__for_arr_N). String len @8; array @0.
            s = s.write("    movq " + util.i32_to_string(arr_off) + "(%rbp), %rax\n");
            if (is_str_iter) {
                s = s.write("    movq 8(%rax), %rcx\n");    // string length @8
            } else {
                s = s.write("    movq (%rax), %rcx\n");     // array length @0
            }
            s = s.write("    movq " + util.i32_to_string(idx_off) + "(%rbp), %rdx\n");
            s = s.write("    cmpq %rcx, %rdx\n");
            s = s.write("    jge .Lfor_end_" + util.i32_to_string(end_lbl) + "\n");
            // Bind element. String: byte-load data_ptr[idx] (data_ptr @0);
            // array: 8-byte element at (idx+1)*8 (header offset).
            s = s.write("    movq " + util.i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq " + util.i32_to_string(idx_off) + "(%rbp), %rcx\n");
            if (is_str_iter) {
                s = s.write("    movq (%rax), %rax\n");      // data_ptr @0
                s = s.write("    movzbl (%rax,%rcx), %eax\n"); // byte at data[idx] (zero-extends)
            } else {
                s = s.write("    incq %rcx\n");
                s = s.write("    movq (%rax,%rcx,8), %rax\n");
            }
            s = s.write("    movq %rax, " + util.i32_to_string(elem_off) + "(%rbp)\n");
            // Body — break jumps to .Lfor_end; continue jumps
            // to .Lfor_cont (the i++ block) so the loop still
            // advances.
            s = s.push_loop_labels(".Lfor_end_" + util.i32_to_string(end_lbl), ".Lfor_cont_" + util.i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < f.body.len()) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + util.i32_to_string(cont_lbl) + ":\n");
            s = s.write("    movq " + util.i32_to_string(idx_off) + "(%rbp), %rax\n");
            s = s.write("    incq %rax\n");
            s = s.write("    movq %rax, " + util.i32_to_string(idx_off) + "(%rbp)\n");
            s = s.write("    jmp .Lfor_top_" + util.i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + util.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (lbl.len() == 0) { s = s.write("    # break outside loop\n"); return s; }
            s = s.write("    jmp " + lbl + "\n"); return s;
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (lbl.len() == 0) { s = s.write("    # continue outside loop\n"); return s; }
            s = s.write("    jmp " + lbl + "\n"); return s;
        },
        parser.StmtUnknown(_) => { s = s.write("    # unsupported: StmtUnknown\n"); return s; }
    }
    return s;
}

// emit_module produces the full assembly text. Top-level stmts
// are emitted in order under `_start`. The Linux runtime calls
// `_start` first; sys_exit_group terminates the process with
// the exit code in %rdi.
// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, body, and (fallback) epilogue. Params
// arrive on the stack at +16(%rbp), +24(%rbp), … (caller
// pushed right-to-left, so param[0] is closest to the return
// address); the prologue copies them into the function's
// own local slots so the body reads them uniformly.
function emit_function(fd: parser.FuncDecl, s: asmcore.EmitState): asmcore.EmitState {
    // Methods get `__fn_<RecvType>__<method>:` so multiple
    // structs can have the same method name without colliding.
    // Plain funcs keep `__fn_<name>:` for source compat with the
    // earlier slices' call emitters.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) {
        // Generic receiver types (`Box[T]`) strip to the base struct
        // name `Box` so the method symbol matches the dispatch shape
        // compare (which uses the value's base-name shape string).
        label_name = util.base_type_name(fd.receiver_type) + "." + fd.name;
    }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var has_recv: boolean = fd.receiver_name.len() > 0;
    var argc: i32 = fd.params.len();
    if (has_recv) { argc = argc + 1; }
    var n_body_locals: i32 = asmcore.count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    subq $" + util.i32_to_string(bytes) + ", %rsp\n");
    }
    // Zero-init the body-local slots (Perceus exit-sweep safety): a
    // `var` decl skipped on this path leaves its slot readable by the
    // release sweep, which must see NULL (the dec helper no-ops) rather
    // than stack garbage. Body locals are indices [argc, total_locals),
    // the contiguous range [-total_locals*8 .. -argc*8) from %rbp; the
    // param slots (filled below) are above it and untouched. rep stosq
    // clobbers rax/rcx/rdi, which are dead here (before the param copy).
    if (n_body_locals > 0) {
        s = s.write("    leaq " + util.i32_to_string(0 - total_locals * 8) + "(%rbp), %rdi\n");
        s = s.write("    movq $" + util.i32_to_string(n_body_locals) + ", %rcx\n");
        s = s.write("    xorq %rax, %rax\n");
        s = s.write("    cld\n");
        s = s.write("    rep stosq\n");
    }
    // Fresh locals table for this function's scope; keep the
    // monotonic label_n + in_function flag.
    s = s.reset_locals();
    s = s.enter_function();
    // For methods, bind receiver first so it occupies local
    // slot 0 (at -8(%rbp)) and reads from +16(%rbp).
    if (has_recv) {
        s = s.bind_local_typed(fd.receiver_name, asmcore.struct_local_tag(fd.receiver_type, s));
        var recv_off: i32 = s.lookup_local(fd.receiver_name);
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq %rax, " + util.i32_to_string(recv_off) + "(%rbp) # recv " + fd.receiver_name + "\n");
    }
    // Bind params + copy from caller-stack offsets into local
    // slots. param[i] sits at +(16 + (i + recv_shift)*8)(%rbp).
    var recv_shift: i32 = 0;
    if (has_recv) { recv_shift = 1; }
    var n_params: i32 = fd.params.len();
    var i: i32 = 0;
    while (i < n_params) {
        s = s.bind_local_typed(fd.params[i].name, asmcore.struct_local_tag(fd.params[i].type_name, s));
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + (i + recv_shift) * 8;
        s = s.write("    movq " + util.i32_to_string(arg_off) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + util.i32_to_string(local_off) + "(%rbp) # param " + fd.params[i].name + "\n");
        i = i + 1;
    }
    // Record the receiver+param slot boundary so the Perceus exit
    // sweep releases only LOCALS, not the borrowed params.
    s = s.set_n_params(argc);
    // Body. Any StmtReturn inside lowers to leave + ret
    // (because in_function is set).
    var bi: i32 = 0;
    while (bi < fd.body.len()) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end
    // doesn't run into the next function's label. Release the array
    // locals first (Perceus exit sweep) — the 0 return is not an array,
    // so no retain is needed; the sweep clobbers %rax before we set it.
    s = emit_array_exit_dec(s);
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}

// emit_runtime_fern_fn is the migration primitive for issue #2649: a runtime
// helper written in *Fern* (rather than a hand-written asm string) is parsed
// and lowered through the normal function emitter, so it links as
// `__fn_<name>` and is called via the ordinary stack convention. The body must
// be self-contained — fully type-annotated and bottoming out in operations
// that lower inline (scalar arithmetic, control flow), so it needs no checker
// pass and calls no other helper (no circularity). As more leaf helpers move
// to Fern, they reuse this entry point.
function emit_runtime_fern_fn(src: string, s: asmcore.EmitState): asmcore.EmitState {
    var m: parser.Module = parser.parse_module(lexer.tokenize(src));
    // String literals the helper body interns (e.g. "" in arr_str_join) land in
    // string_lits AFTER the main .rodata pool was emitted (the runtime is emitted
    // after the pool), so flush any NEW ones here in their own .rodata block (then
    // return to .text). A literal-free helper adds none, so this is a no-op for it.
    var lit0: i32 = s.string_lits.len();
    var i: i32 = 0;
    while (i < m.funcs.len()) {
        s = emit_function(m.funcs[i], s);
        i = i + 1;
    }
    if (s.string_lits.len() > lit0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = lit0;
        while (li < s.string_lits.len()) {
            s = s.write(".S" + util.i32_to_string(li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
        s = s.write("    .text\n");
    }
    return s;
}










// emit_runtime appends the runtime-library helper bodies the
// module requested via need()/has_need(): print_int, the heap
// bump-allocator, string + array helpers, args, strbuf, etc.
// Each block is gated on has_need(...) so only referenced
// helpers are emitted. Split out of emit_module so that the
// orchestration (type-check, function bodies, _start) stays
// readable; the relative emission order is unchanged.
function emit_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // __fern_print_int helper: appended once at the end of the
    // .text section if any print_int call surfaced needs_print_int.
    // Converts the i64 in %rdi to decimal text in a stack buffer
    // and writes it to stdout. Handles zero, positive, and
    // negative values (prepending `-`).
    if (s.has_need("print_int")) {
        s = s.write("__fern_print_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    movq $0, %r10\n");        // sign flag
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jge .Lpi_pos\n");
        s = s.write("    negq %rax\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write(".Lpi_pos:\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lpi_loop_start\n");
        s = s.write("    movb $48, -1(%rbp)\n");   // '0'
        s = s.write("    leaq -1(%rbp), %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    jmp .Lpi_write\n");
        s = s.write(".Lpi_loop_start:\n");
        s = s.write("    leaq -1(%rbp), %rsi\n");
        s = s.write("    movq $0, %r8\n");         // length
        s = s.write(".Lpi_div:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");            // rax/=10, rdx=remainder
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lpi_div\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Lpi_no_neg\n");
        s = s.write("    movb $45, (%rsi)\n");     // '-'
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write(".Lpi_no_neg:\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    movq %r8, %rdx\n");
        s = s.write(".Lpi_write:\n");
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    movq $1, %rax\n");        // sys_write
        s = s.write("    syscall\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_now_unix_ms / __fern_monotonic_ns: clock_gettime
    // (x86-64 syscall 228) helpers. Emitted unconditionally — they
    // don't touch the heap, so they can't ride the needs_heap gate
    // that carries read_file/write_file, and a pure-scalar program
    // that times something must still link. The kernel writes a
    // `struct timespec { i64 tv_sec; i64 tv_nsec }` to the buffer.
    // Errno is ignored: with a fixed clock id and a stack buffer we
    // control, the realistic failures (EFAULT/EINVAL) can't fire.
    // now_unix_ms: CLOCK_REALTIME=0 → tv_sec*1000 + tv_nsec/1e6.
    s = s.write("__fern_now_unix_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %r10\n");       // tv_sec
    s = s.write("    imulq $1000, %r10, %r10\n"); // sec * 1000
    s = s.write("    movq 8(%rsp), %rax\n");      // tv_nsec
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000000, %rcx\n");
    s = s.write("    divq %rcx\n");               // rax = nsec / 1e6
    s = s.write("    addq %r10, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // monotonic_ns: CLOCK_MONOTONIC=1 → tv_sec*1e9 + tv_nsec.
    s = s.write("__fern_monotonic_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $1, %rdi\n");           // CLOCK_MONOTONIC
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // now_ns: CLOCK_REALTIME=0 → tv_sec*1e9 + tv_nsec (the
    // nanosecond-resolution twin of now_unix_ms).
    s = s.write("__fern_now_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // __fern_sleep_ms(%rdi = ms) — pause for `ms` milliseconds via
    // nanosleep (syscall 35); ms <= 0 returns immediately. Lives next
    // to the clock helpers (emitted unconditionally) — no heap, just
    // a syscall and a 16-byte timespec on the stack.
    s = s.write(".globl __fern_sleep_ms\n");
    s = s.write(".type __fern_sleep_ms, @function\n");
    s = s.write("__fern_sleep_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $32, %rsp\n");
    s = s.write("    cmpq $0, %rdi\n");
    s = s.write("    jle .Lsm_done\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000, %rcx\n");
    s = s.write("    divq %rcx\n");
    s = s.write("    movq %rax, (%rsp)\n");
    s = s.write("    movq $1000000, %rax\n");
    s = s.write("    imulq %rdx, %rax\n");
    s = s.write("    movq %rax, 8(%rsp)\n");
    s = s.write("    movq %rsp, %rdi\n");
    s = s.write("    movq $0, %rsi\n");
    s = s.write("    movq $35, %rax\n");
    s = s.write("    syscall\n");
    s = s.write(".Lsm_done:\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_sleep_ms, .-__fern_sleep_ms\n");
    // __fern_read_int helper: reads up to 16 bytes from stdin
    // into a stack buffer, then parses an optional leading `-`
    // followed by decimal digits. Returns the parsed value in
    // %rax. Stops at the first non-digit (including newline /
    // EOF). Skips leading whitespace not implemented — input
    // is expected to start with the digits / minus.
    if (s.has_need("read_int")) {
        s = s.write("__fern_read_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq $0, %rdi\n");          // fd 0
        s = s.write("    leaq -16(%rbp), %rsi\n");
        s = s.write("    movq $16, %rdx\n");
        s = s.write("    movq $0, %rax\n");          // sys_read
        s = s.write("    syscall\n");
        s = s.write("    leaq -16(%rbp), %rcx\n");   // cursor
        s = s.write("    leaq -16(%rbp), %r8\n");    // end ptr
        s = s.write("    addq %rax, %r8\n");
        s = s.write("    movq $0, %r9\n");           // accumulator
        s = s.write("    movq $0, %r10\n");          // neg flag
        s = s.write("    cmpq %rcx, %r8\n");
        s = s.write("    je .Lri_done\n");
        s = s.write("    movzbq (%rcx), %rax\n");
        s = s.write("    cmpq $45, %rax\n");         // '-'
        s = s.write("    jne .Lri_loop\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write("    incq %rcx\n");
        s = s.write(".Lri_loop:\n");
        s = s.write("    cmpq %rcx, %r8\n");
        s = s.write("    je .Lri_done\n");
        s = s.write("    movzbq (%rcx), %rax\n");
        s = s.write("    subq $48, %rax\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jl .Lri_done\n");
        s = s.write("    cmpq $9, %rax\n");
        s = s.write("    jg .Lri_done\n");
        s = s.write("    imulq $10, %r9\n");
        s = s.write("    addq %rax, %r9\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lri_loop\n");
        s = s.write(".Lri_done:\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Lri_no_neg\n");
        s = s.write("    negq %r9\n");
        s = s.write(".Lri_no_neg:\n");
        s = s.write("    movq %r9, %rax\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_print_str: %rdi = string box ptr. Loads box.data
    // and box.len, issues a write(1, ptr, len). (No trailing
    // newline — `write` is the no-newline output builtin; the Go
    // backend's `print` does add one, so the bootstrap driver uses
    // `write` to keep the self-hosted output byte-identical.)
    if (s.has_need("str_print")) {
        s = s.write("__fern_print_str:\n");
        s = s.write("    movq (%rdi), %rsi\n");
        s = s.write("    movq 8(%rdi), %rdx\n");
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    ret\n");
    }
    // __fern_str_concat is now a Fern runtime function (#2649, via the raw-memory
    // intrinsics): see asmcore.rt_src_str_concat — alloc lenA+lenB, copy A then B
    // byte-by-byte (__raw_store8), box it (__raw_string). Backs `+` on strings,
    // called via the __fn_ stack convention. heap is its sole dep (the intrinsics
    // add no symbol). Mirrors the x86-64 IR path + arm64.
    if (s.has_need("str_concat")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_concat(), s);
    }
    // __fern_str_eq is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_eq, called via the __fn_ stack convention. Every caller
    // (the == operator, the IR op, and the hand-asm map/arr_str internals) sets
    // up %rdi=A/%rsi=B before the call, so the uniform push+stack-call works at
    // all of them. Mirrors the x86-64 IR path + arm64.
    if (s.has_need("str_eq")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_eq(), s);
    }
    // __fern_str_cmp is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_cmp. Lexicographic byte compare with a length tiebreak,
    // returning the signed difference (operators use the sign); stack convention.
    // Mirrors the x86-64 IR path (asm_ir.emit_ir_runtime_fern_fn) and arm64.
    if (s.has_need("str_cmp")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_cmp(), s);
    }
    // __fern_read_line: no args. Allocates a 256-byte heap
    // read buffer, syscalls sys_read(fd=0, buf, 256), scans
    // for '\n', allocates a 16-byte box `[data_ptr, len]` and
    // returns the box ptr in %rax. The data_ptr points at the
    // same heap region (the buf bytes up to the newline). On
    // EOF the box has len = bytes_read with no '\n' adjustment.
    if (s.has_need("str_read_line")) {
        // __fern_read_line: no args -> Option[string] (#4369): Some(line incl. '\n')
        // / None at EOF. The Option box is rc-headered (__fern_arr_box cap=2, like
        // op_opt_make) so the match-consume drop is valid; mirrors the IR body.
        s = s.write("__fern_read_line:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");                 // buffer
        s = s.write("    pushq %r13\n");                 // bytes / strbox
        s = s.write("    movq $256, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");            // buf ptr
        s = s.write("    movq $0, %rax\n");
        s = s.write("    movq $0, %rdi\n");              // fd 0
        s = s.write("    movq %r12, %rsi\n");
        s = s.write("    movq $256, %rdx\n");
        s = s.write("    syscall\n");
        s = s.write("    movq %rax, %r13\n");            // bytes_read
        s = s.write("    cmpq $0, %r13\n");
        s = s.write("    jle .Lrl_none\n");              // EOF / error -> None
        s = s.write("    movq %r12, %rcx\n");
        s = s.write("    movq %r12, %r8\n");
        s = s.write("    addq %r13, %r8\n");
        s = s.write(".Lrl_scan:\n");
        s = s.write("    cmpq %rcx, %r8\n");
        s = s.write("    je .Lrl_no_nl\n");
        s = s.write("    movzbq (%rcx), %rax\n");
        s = s.write("    cmpq $10, %rax\n");
        s = s.write("    je .Lrl_found\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrl_scan\n");
        s = s.write(".Lrl_no_nl:\n");
        s = s.write("    movq %r13, %rdx\n");            // len = whole read
        s = s.write("    jmp .Lrl_box\n");
        s = s.write(".Lrl_found:\n");
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    subq %r12, %rdx\n");            // index of '\n'
        s = s.write("    incq %rdx\n");                  // include the '\n'
        s = s.write(".Lrl_box:\n");
        s = s.write("    pushq %rdx\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");          // strbox
        s = s.write("    popq %rdx\n");
        s = s.write("    movq %r12, (%rax)\n");
        s = s.write("    movq %rdx, 8(%rax)\n");
        s = s.write("    movq %rax, %r13\n");            // strbox
        s = s.write("    movq $2, %rdi\n");
        s = s.write("    call __fern_arr_box\n");        // Some box (rc-headered)
        s = s.write("    movq $0, (%rax)\n");            // tag=0 Some
        s = s.write("    movq %r13, 8(%rax)\n");         // payload = strbox
        s = s.write("    jmp .Lrl_ret\n");
        s = s.write(".Lrl_none:\n");
        s = s.write("    movq $2, %rdi\n");
        s = s.write("    call __fern_arr_box\n");        // None box (rc-headered)
        s = s.write("    movq $1, (%rax)\n");            // tag=1 None
        s = s.write(".Lrl_ret:\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // __fern_read_all_stdin: no args. Allocates a large buffer,
        // loops sys_read(fd=0, …) appending until EOF (read → 0),
        // then returns a 16-byte box `[data_ptr, total_len]`. The
        // buffer is sized to hold a whole compiler-source bundle.
        s = s.write("__fern_read_all_stdin:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");        // total bytes
        s = s.write("    pushq %r13\n");        // buf base
        s = s.write("    pushq %r14\n");        // current write ptr
        s = s.write("    movq $33554432, %rdi\n");   // 32 MiB read buffer
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");
        s = s.write("    movq %rax, %r14\n");
        s = s.write("    movq $0, %r12\n");
        s = s.write(".Lras_loop:\n");
        s = s.write("    movq $0, %rax\n");      // sys_read
        s = s.write("    movq $0, %rdi\n");      // fd 0
        s = s.write("    movq %r14, %rsi\n");    // dst = write ptr
        s = s.write("    movq $1048576, %rdx\n");// up to 1 MiB per read
        s = s.write("    syscall\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jle .Lras_done\n");     // 0 = EOF, <0 = error
        s = s.write("    addq %rax, %r12\n");
        s = s.write("    addq %rax, %r14\n");
        s = s.write("    jmp .Lras_loop\n");
        s = s.write(".Lras_done:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r13, (%rax)\n");
        s = s.write("    movq %r12, 8(%rax)\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_i32_to_string is now a Fern runtime function (#2649, via the
    // raw-memory intrinsics): see asmcore.rt_src_i32_to_string. Called via the
    // __fn_ stack convention; heap-only dep. Mirrors the x86-64 IR path + arm64.
    if (s.has_need("i32_to_string")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_i32_to_string(), s);
    }
    // __fern_u32_to_string (#2649): the UNSIGNED sibling for `(u32).to_string()`,
    // via the raw-memory intrinsics; heap-only dep. See asmcore.rt_src_u32_to_string.
    if (s.has_need("u32_to_string")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_u32_to_string(), s);
    }
    // __fern_i64_to_string / __fern_u64_to_string: width-correct siblings for
    // 64-bit `.to_string()` receivers; heap-only deps. See asmcore.rt_src_*.
    if (s.has_need("i64_to_string")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_i64_to_string(), s);
    }
    if (s.has_need("u64_to_string")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_u64_to_string(), s);
    }
    // __fern_str_to_i32 is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_to_i32. Parses a borrowed string into an i32 (optional
    // leading '-', decimal digits, stop at first non-digit); stack convention.
    // Mirrors the x86-64 IR path (asm_ir.emit_ir_runtime_fern_fn) and arm64.
    if (s.has_need("str_to_i32")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_to_i32(), s);
    }
    // __fern_eprint_str: %rdi = string box ptr. Loads box.data
    // + box.len, issues a write(2, ptr, len) — stderr — then a
    // trailing newline (eprint is the stderr line-printer, mirroring
    // `print` and the Go-backend / interp / wasm `eprint`, which all
    // append "\n"). The newline byte is written from a stack slot.
    if (s.has_need("eprint")) {
        s = s.write("__fern_eprint_str:\n");
        s = s.write("    movq (%rdi), %rsi\n");
        s = s.write("    movq 8(%rdi), %rdx\n");
        s = s.write("    movq $2, %rdi\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    pushq $10\n");
        s = s.write("    movq $2, %rdi\n");
        s = s.write("    movq %rsp, %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    ret\n");
    }
    // __fern_str_starts_with: %rdi = box A, %rsi = box B
    // (prefix). Returns 1 in %rax if A starts with B (or B is
    // empty), else 0.
    // __fern_str_index_of: %rdi = haystack box, %rsi = needle.
    // Returns the first byte offset where needle matches, or
    // -1 if not found. Empty needle returns 0.
    if (s.has_need("str_search")) {
        // __fern_str_starts_with / _ends_with / _index_of are now Fern runtime
        // functions (#2649): see asmcore.rt_src_str_search, called via the __fn_
        // stack convention. (str_to_* below stay hand-written — they copy bytes
        // into a fresh buffer, a Tier-2 op needing the raw-memory primitives.)
        // str_trim is also Fern now (rt_src_str_trim) but gated on its own
        // str_trim need, emitted in the migrated-helpers section below — it's a
        // zero-copy slice, so it no longer rides the str_search bundle.
        // Mirrors the x86-64 IR path + arm64.
        s = emit_runtime_fern_fn(asmcore.rt_src_str_search(), s);
        // str_to_upper / str_to_lower are now Fern too (rt_src_str_to_upper/_lower
        // via the raw-memory intrinsics) but gated on their own str_case need,
        // emitted in the migrated-helpers section — they no longer ride this
        // str_search bundle.
        // __fern_str_repeat is now a Fern runtime function (#2649): see
        // asmcore.rt_src_str_repeat, emitted (need-gated on str_repeat) in the
        // migrated-helpers section via the raw-memory intrinsics. It no longer
        // rides this str_search bundle.
        // __fern_str_replace is now a Fern runtime function (#2649): see
        // asmcore.rt_src_str_replace, emitted (need-gated on str_replace) in the
        // migrated-helpers section via the raw-memory intrinsics. It no longer
        // rides this str_search bundle.
        // __fern_chr is now a Fern runtime function (#2649): see asmcore.rt_src_chr,
        // emitted (need-gated on chr) in the migrated-helpers section below via the
        // raw-memory intrinsics. No longer hand-rolled in this str_search bundle.
        // __fern_str_split is now a Fern runtime function (#2649): see
        // asmcore.rt_src_str_split, emitted (need-gated on str_split) in the
        // migrated-helpers section via .append() + string slices. No longer
        // hand-rolled in this str_search bundle.
    }
    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted
    // after this pool, inside the needs_heap block) can reference its
    // shape-name label. The helper's own add_string_lit dedups to this
    // slot; without the early intern the label would be undefined for
    // programs that never mention stat() themselves.
    if (s.has_need("heap")) {
        var fsPre: asmcore.StringLitOut = asmcore.add_string_lit(s, "FileStat");
        s = fsPre.state;
        var prPre: asmcore.StringLitOut = asmcore.add_string_lit(s, "ProcessResult");
        s = prPre.state;
    }
    // .rodata: emit each interned string literal as a
    // labelled `.ascii` directive. GAS interprets the escape
    // sequences in the quoted string, so a `\n` byte in the
    // source string lands as a single LF in the resulting
    // .rodata bytes.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(".S" + util.i32_to_string(li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Heap allocator: a bump pointer over a lazily-mmap'd arena. The
    // arena is mmap'd at hint 0x10000000 on the first __fern_alloc call
    // (mirrors the native x86-64 backend + the self-host arm64 backend)
    // rather than reserved as a multi-GiB `.bss` block in the loaded
    // image. The arena base comes from the kernel at runtime, so the
    // emitted binary makes NO assumption about the linker's .bss layout —
    // bfd, lld and mold all lay it out compatibly (issue #4081: the old
    // static-.bss heap, addressed via `movabs $__fern_heap`, only linked
    // correctly under bfd). No deallocation — leak-everything bump heap.
    if (s.has_need("heap")) {
        var heap_size: string = "17179869184";   // 0x400000000, 16 GiB. Raised from 8 GiB (0x200000000) when the stage-2 x86 self-compile crossed the 8 GiB exit-137 alloc trap again — the same wall arm64 hit and cleared: the compiler's live set grows with every compiler-source addition and reached ~8 GiB (0.6% headroom), so an IR-widening addition tipped it. The mmap is MAP_NORESERVE (0x4022 below), so the wider reservation is exempt from overcommit accounting and costs nothing until touched (the ~8 GiB actually touched is unchanged — only the exit-137 ceiling moves); the length loads via movabs (64-bit imm). Lockstep with asm_ir.fern + the native x86-64 backend; arm64 (asm_arm64.fern + native) is already at 16 GiB — this brings x86 up to match (see the native arm64 heapBytes comment for the NORESERVE rationale).
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_heap_ptr: .quad 0\n");       // bump cursor (0 until first mmap)
        s = s.write("    .align 8\n");
        s = s.write("__fern_heap_end: .quad 0\n");        // arena end (base + heap_size), set at mmap time
        s = s.write("    .align 8\n");
        // RC over-release (underflow) detector — Phase 0c. Bumped by
        // __fern_rc_dec when it sees rc <= 0 before decrementing; read
        // back by __fern_rc_underflow_count(). A clean program leaves
        // this at 0; the eventual Phase-3 free flip gates on a
        // corpus-wide 0 here (mirrors the native detector in
        // internal/codegen/x86_64/x86_64.go).
        s = s.write("__fern_rc_underflow: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_freelist: .skip 524288\n");
        // NOTE: there is no static `.bss` heap reservation anymore — the
        // arena is mmap'd at runtime (see .Lalloc_nofl below). Every .bss
        // symbol here (cursor / end / underflow / freelist) is small and
        // RIP-relative addressable regardless of linker layout, so the
        // emitted binary is linker-agnostic (issue #4081).
        s = s.write("    .section .text\n");
        s = s.write(".globl __fern_alloc\n");
        s = s.write(".type __fern_alloc, @function\n");
        s = s.write("__fern_alloc:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    addq $7, %rdi\n");
        s = s.write("    andq $-8, %rdi\n");
        s = s.write("    pushq %rcx\n");
        s = s.write("    pushq %rdx\n");
        s = s.write("    movq %rdi, %rcx\n");
        s = s.write("    shrq $3, %rcx\n");
        s = s.write("    cmpq $65536, %rcx\n");
        s = s.write("    jae .Lalloc_nofl\n");
        s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
        s = s.write("    movq (%rdx,%rcx,8), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jz .Lalloc_nofl\n");
        s = s.write("    movq (%rax), %rdi\n");
        s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
        s = s.write("    popq %rdx\n");
        s = s.write("    popq %rcx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".Lalloc_nofl:\n");
        s = s.write("    popq %rdx\n");
        s = s.write("    popq %rcx\n");
        s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lalloc_inited\n");
        // First allocation: lazily mmap the arena at hint 0x10000000
        // (MAP_PRIVATE | MAP_ANONYMOUS, R+W). Runs once. The kernel hands
        // back the base, so the heap address is NOT derived from the
        // linker's .bss layout (issue #4081 — mirrors the native x86-64
        // backend's emitAllocRuntime + the self-host arm64 backend). The
        // mmap syscall clobbers %rcx/%r11 plus its arg regs, so every
        // register except %rax/%rdi (the alloc clobber contract) is
        // saved across it; %rdi (the rounded size) is live and restored.
        s = s.write("    pushq %rdi\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    pushq %rcx\n");
        s = s.write("    pushq %rdx\n");
        s = s.write("    pushq %r8\n");
        s = s.write("    pushq %r9\n");
        s = s.write("    pushq %r10\n");
        s = s.write("    pushq %r11\n");
        s = s.write("    movl $0x10000000, %edi\n");          // addr hint
        s = s.write("    movabs $" + heap_size + ", %rsi\n"); // length (64-bit imm — 8 GiB exceeds u32)
        s = s.write("    movl $3, %edx\n");                   // PROT_READ | PROT_WRITE
        s = s.write("    movl $0x4022, %r10d\n");             // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE (exempt from overcommit accounting; lockstep with the native x86-64 backend)
        s = s.write("    movq $-1, %r8\n");                   // fd
        s = s.write("    xorl %r9d, %r9d\n");                 // offset
        s = s.write("    movl $9, %eax\n");                   // __NR_mmap
        s = s.write("    syscall\n");
        s = s.write("    cmpq $0, %rax\n");                   // mmap returns -errno on failure
        s = s.write("    jl .Lalloc_oom\n");
        s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
        s = s.write("    movabs $" + heap_size + ", %rcx\n"); // heap_size (64-bit imm)
        s = s.write("    addq %rax, %rcx\n");                 // %rcx = base + heap_size (END)
        s = s.write("    movq %rcx, __fern_heap_end(%rip)\n");
        s = s.write("    popq %r11\n");
        s = s.write("    popq %r10\n");
        s = s.write("    popq %r9\n");
        s = s.write("    popq %r8\n");
        s = s.write("    popq %rdx\n");
        s = s.write("    popq %rcx\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write(".Lalloc_inited:\n");
        s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
        s = s.write("    addq %rax, %rdi\n");
        // Bounds check: a bump heap has no GC, so an overflow would run
        // past the mmap'd arena and segfault. Trap with a clean,
        // recognisable exit code (137) instead. The arena end was recorded
        // at mmap time, so this is a single RIP-relative memory-operand
        // compare — no scratch register to save.
        s = s.write("    cmpq __fern_heap_end(%rip), %rdi\n");
        s = s.write("    ja .Lalloc_oom\n");
        s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".Lalloc_oom:\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    movq $137, %rdi\n");
        s = s.write("    syscall\n");
        s = s.write(".size __fern_alloc, .-__fern_alloc\n");

        // __fern_arr_box(%rdi = cap element count) -> %rax = array data
        // pointer. Centralises the array box layout so every array
        // allocation site (literal / push-grow / slice / concat /
        // reverse / split / str_bytes / str_chars / args / u8) shares
        // ONE layout definition (docs/RC-PERCEUS-SELF-HOST-PORT.md Phase
        // 0a/0b). Perceus rc-header layout: base = [cap, rc, len, e0,
        // e1, ...]; the returned data pointer is base+16 (at the len
        // slot), so rc is at [data-8] (the uniform offset the generic
        // __fern_rc_inc / __fern_rc_dec / __fern_rc_is_unique helpers
        // read), cap is at [data-16], and element i stays at
        // [data+(i+1)*8] — UNCHANGED from the pre-rc layout, since array
        // readers index relative to data; only the alloc side moves. The
        // helper inits rc = 1 and writes cap and len = cap; callers
        // overwrite len when it differs (push) and fill the elements.
        // Clobbers only %rax + %rdi (matching __fern_alloc's contract,
        // so it is a drop-in replacement at every call site — callers
        // keep live values in %rcx/%rsi/%r8-%r15 across the call).
        s = s.write("__fern_arr_box:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rdi\n");             // save cap (also keeps 16B align)
        s = s.write("    addq $3, %rdi\n");          // cap + 3 header words (cap, rc, len)
        s = s.write("    shlq $3, %rdi\n");          // * 8 bytes
        s = s.write("    call __fern_alloc\n");      // base in %rax
        s = s.write("    movq -8(%rbp), %rdi\n");    // reload cap
        s = s.write("    movq %rdi, (%rax)\n");      // cap at base+0   (= data-16)
        s = s.write("    movq $1, 8(%rax)\n");       // rc = 1 at base+8 (= data-8)
        s = s.write("    movq %rdi, 16(%rax)\n");    // len = cap at base+16 (= data)
        s = s.write("    addq $16, %rax\n");         // data ptr = base+16
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // __fern_str_box(%rdi = data, %rsi = len) -> %rax = box (rc-headered, #2649
        // Option A). Block = [rc=1@base, data@base+8, len@base+16] (24B, class 3);
        // box = base+8 so data@box+0 / len@box+8 are unchanged and rc@box-8 rides the
        // shared rc word. The pure-legacy sibling of the IR runtime's copy (only one
        // runtime is linked per compile). Legacy strings are never reclaimed, but the
        // rc header keeps the box layout identical to the IR path for merged bundles.
        s = s.write("__fern_str_box:\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    pushq %rdi\n");
        s = s.write("    movq $24, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    movq %rdi, 8(%rax)\n");
        s = s.write("    movq %rsi, 16(%rax)\n");
        s = s.write("    addq $8, %rax\n");
        s = s.write("    ret\n");

        // Low-level memory intrinsics (`__alloc` / `__free` / the
        // `__load_*` / `__store_*` pokes / `__ptr_width` / `__memset`)
        // and the RC intrinsics (`__fern_rc_inc` / `__fern_arr_dec` /
        // `__fern_drop_arr_ptr`). The Go backend inlines these; here
        // they're plain runtime functions under the self-host's
        // stack-arg ABI (param[0] at 16(%rbp), result in %rax). They
        // exist so a program that imports `std/json` / `core/map`
        // links: that map implementation's source pokes raw memory
        // through these names. The self-host's own `Map[K,V]` lowers
        // to the native `__fern_map_*` runtime, so the `core/map`
        // bodies are never actually called — but their symbols must
        // resolve. RC + `__free` are no-ops, consistent with the
        // leak-everything bump heap (nothing is ever reclaimed).
        s = s.write("__fn___alloc:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___free:\n");
        s = s.write("    ret\n");
        s = s.write("__fn___memset:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rdi\n");     // dst
        s = s.write("    movq 24(%rbp), %rax\n");     // fill byte (in %al)
        s = s.write("    movq 32(%rbp), %rcx\n");     // count
        s = s.write("    cld\n");
        s = s.write("    rep stosb\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_i32:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movslq (%rax), %rax\n");     // i32 load, sign-extended
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___store_i32:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");     // addr
        s = s.write("    movq 24(%rbp), %rcx\n");     // val
        s = s.write("    movl %ecx, (%rax)\n");       // store low 4 bytes
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_i64:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq (%rax), %rax\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_ptr:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq (%rax), %rax\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___store_ptr:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");     // addr
        s = s.write("    movq 24(%rbp), %rcx\n");     // val
        s = s.write("    movq %rcx, (%rax)\n");       // store 8 bytes
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___ptr_width:\n");
        s = s.write("    movq $8, %rax\n");
        s = s.write("    ret\n");
        // RC intrinsics — Phase 0c real bodies (ported from the native
        // x86_64 backend, internal/codegen/x86_64/x86_64.go
        // emitRcIncRuntime / emitRcDecRuntime / emitRcIsUniqueRuntime).
        // The rc word is a 32-bit count at [data-8]; data is the value
        // pointer callers hold. Guard chain: null -> SSO inline-tag
        // (low bit set => packed small string, not a pointer) ->
        // low-address (< 0x10000 => a non-pointer scalar / enum tag in
        // an rc slot, never a heap object) -> static sentinel (rc high
        // bit set => immortal, never touch). The heap is now mmap'd at
        // hint 0x10000000 (issue #4081), so every real heap object sits
        // well above the < 0x10000 cutoff and the guard stays correct
        // (it conservatively rejects only true sub-64KiB scalars/tags).
        // Frameless: param[0] is at 8(%rsp) after the call;
        // result returned in %rax (the input ptr), matching arm64 so a
        // caller can chain an inc into an expression.
        //
        // No free path yet (Phase 1/safe-leak): rc_dec decrements to 0
        // (and below, bumping the underflow detector) but never returns
        // storage. __fern_arr_dec / __fern_drop_arr_ptr stay no-ops
        // until the array rc-header layout migration wires them in.
        s = s.write("__fn___fern_rc_inc:\n");
        s = s.write("    movq 8(%rsp), %rax\n");      // ptr (also return)
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jz .Lshrcinc_ret\n");
        s = s.write("    testb $1, %al\n");           // SSO inline tag
        s = s.write("    jnz .Lshrcinc_ret\n");
        s = s.write("    cmpq $0x10000, %rax\n");     // low-address guard
        s = s.write("    jb .Lshrcinc_ret\n");
        s = s.write("    movl -8(%rax), %ecx\n");     // rc
        s = s.write("    testl %ecx, %ecx\n");
        s = s.write("    js .Lshrcinc_ret\n");        // static sentinel
        s = s.write("    addl $1, %ecx\n");
        s = s.write("    movl %ecx, -8(%rax)\n");
        s = s.write(".Lshrcinc_ret:\n");
        s = s.write("    ret\n");
        s = s.write("__fn___fern_rc_dec:\n");
