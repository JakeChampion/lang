        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

// add_string_lit appends the literal to the pool and returns
// its index, used by the caller to emit `leaq .S<idx>(%rip), …`.
// The pool is materialised in .rodata at end-of-module.
struct StringLitOut { state: EmitState, idx: i32 }
function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: if the same value has already been interned,
    // return its existing slot. This is load-bearing for the
    // shape-pointer dispatch in ExprFieldAccess + StmtMatch,
    // which compares the runtime shape ptr against a freshly-
    // interned struct-name string. Without dedup, the two
    // .S<N> labels resolve to different .rodata addresses and
    // string-pointer equality always fails.
    var i: i32 = 0;
    while (i < s.string_lits.len()) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
        }
        i = i + 1;
    }
    var idx: i32 = s.string_lits.len();
    var sl: string[] = s.string_lits.push(v);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: sl,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
    return StringLitOut { state: ns, idx: idx };
}

// lookup_local returns the byte offset off %rbp for `name`, or
// 0 if not found (callers should sanity-check via the parallel
// "is bound" path — emit_expr's ExprIdent arm surfaces a
// comment marker on miss).
function (s: EmitState) lookup_local(name: string): i32 {
    // Newest binding wins. Walk back-to-front so shadowing
    // resolves to the most-recent slot.
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) {
            return 0 - 8 * (i + 1);
        }
        i = i - 1;
    }
    return 0;
}

function (s: EmitState) has_local(name: string): boolean {
    var i: i32 = 0;
    while (i < s.local_names.len()) {
        if (s.local_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// fresh_label hands out a unique label name (".L<n>") and
// returns the new state with label_n already bumped — so the
// caller can reuse `s` for subsequent emits without
// double-allocating.
struct LabelOut { state: EmitState, name: string }
function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + i32_to_string(s.label_n);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n + 1,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
    return LabelOut { state: ns, name: name };
}

// count_locals walks a stmt body recursively (into if / while
// bodies) to determine the total number of `var` decls. The
// result feeds the function-entry `subq $<N*8>, %rsp` so the
// frame has enough room for every local that might be live.
// Conservative: counts every var even if branches make them
// mutually exclusive at runtime — that's fine for stack
// allocation, and far simpler than a liveness analysis.
function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < body.len()) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

// name_has_comma reports whether a (possibly comma-encoded) binding
// name holds two names — `var (a,b)` tuple destructuring and
// `for (k,v)` map iteration encode their pair as "a,b".
function name_has_comma(name: string): boolean {
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == 44) { return true; }
        i = i + 1;
    }
    return false;
}

function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(v) => {
            // `var (a,b) = …` binds two locals; a plain var binds one.
            if (name_has_comma(v.name)) { return 2; }
            return 1;
        },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // `for (k,v) in m` binds 4 synthetic/user locals (map ptr,
            // index, k, v); a plain `for x in arr` binds 3 (array ptr,
            // index, element).
            if (name_has_comma(f.var_name)) { return 4 + count_locals(f.body); }
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

// =================== ASM EMITTER ====================

// emit_fn_value emits a 1-slot closure box [&__fn_name] for a function
// referenced by name as a value. Shared by ExprIdent (params>0) and the
// call-arg path (a fn-typed param of any arity — including a 0-arg
// `() => R`, which can't be distinguished from a const at the ident
// site, so the boxing decision is made at the call site instead).
function emit_fn_value(name: string, s: EmitState): EmitState {
    s = s.write("    movq $8, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.mark_heap();
    s = s.write("    leaq __fn_" + sanitize_label(name) + "(%rip), %rcx\n");
    s = s.write("    movq %rcx, (%rax)\n");
    s = s.write("    pushq %rax\n");
    return s;
}

// is_value_fn_name reports whether name is a receiver-less function.
function is_value_fn_name(s: EmitState, name: string): boolean {
    var fi: i32 = 0;
    while (fi < s.funcs.len()) {
        if (s.funcs[fi].name == name && s.funcs[fi].receiver_type.len() == 0) { return true; }
        fi = fi + 1;
    }
    return false;
}

// callee_param_is_fn reports whether any function declared with the
// given name has a `fn`-typed param at idx. Used by `arg_fn_value_name`
// to know whether a bare ident argument should be boxed as a closure
// value (instead of being called as a 0-arg function). Looks at both
// receiver-less and receiver methods so `f.call_one(noop)` boxes
// `noop` the same way `call_n(3, noop)` does.
function callee_param_is_fn(s: EmitState, name: string, idx: i32): boolean {
    var fi: i32 = 0;
    while (fi < s.funcs.len()) {
        if (s.funcs[fi].name == name) {
            if (idx < s.funcs[fi].params.len()
                    && s.funcs[fi].params[idx].type_name == "fn") {
                return true;
            }
        }
        fi = fi + 1;
    }
    return false;
}

// arg_fn_value_name returns the function name to box for a call argument
// when the callee's param at idx is fn-typed and the arg is a bare ident
// naming a function; otherwise "". This makes a 0-arg function passed by
// name (e.g. `bench(name, n, my_workload)`) lower to a function value
// rather than a call.
function arg_fn_value_name(arg: parser.Expr, callee: string, idx: i32, s: EmitState): string {
    match (arg) {
        parser.ExprIdent(id) => {
            if (callee_param_is_fn(s, callee, idx) && is_value_fn_name(s, id.name)) {
                return id.name;
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) {
                // Float literal: GAS converts the decimal text to an
                // IEEE-754 double in .rodata; load its bits and push
                // them (floats flow through the rt-stack as their
                // 8-byte bit pattern, like every other value).
                var fl: LabelOut = fresh_label(s);
                s = fl.state;
                s = s.write("    .section .rodata\n");
                s = s.write(fl.name + ": .double " + n.text + "\n");
                s = s.write("    .text\n");
                s = s.write("    movsd " + fl.name + "(%rip), %xmm0\n");
                s = s.write("    movq %xmm0, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    movq $" + n.text + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprBinary(b) => {
            // String-aware dispatch: `s + t` where either side
            // is a string lowers to __fern_str_concat; `s == t`
            // / `s != t` for strings lowers to __fern_str_eq.
            // Type info comes from infer_expr_type on the
            // operands — that walks the AST + local_types.
            if (b.op == "+") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");      // rhs
                    s = s.write("    popq %rdi\n");      // lhs
                    s = s.write("    call __fern_str_concat\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: string = infer_expr_type(b.left, s);
                var ert: string = infer_expr_type(b.right, s);
                if (elt == "string" || ert == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __fern_str_eq\n");
                    if (b.op == "!=") {
                        s = s.write("    xorq $1, %rax\n");
                    }
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: route < / <= / > / >= for
            // string operands through __fern_str_cmp, then
            // compare its signed result against zero to derive
            // the bool.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: string = infer_expr_type(b.left, s);
                var ort: string = infer_expr_type(b.right, s);
                if (olt == "string" || ort == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __fern_str_cmp\n");
                    s = s.write("    cmpq $0, %rax\n");
                    s = s.write("    movq $0, %rax\n");
                    if (b.op == "<") { s = s.write("    setl %al\n"); }
                    else if (b.op == "<=") { s = s.write("    setle %al\n"); }
                    else if (b.op == ">") { s = s.write("    setg %al\n"); }
                    else { s = s.write("    setge %al\n"); }
                    s = s.write("    movzbq %al, %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. The right operand's
            // side effects must not run when the left already
            // decides the result. `&&` short-circuits on false
            // (left == 0 ⇒ result = 0); `||` short-circuits on
            // true (left != 0 ⇒ result = 1). Otherwise the
            // right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    popq %rax\n");
                s = s.write("    testq %rax, %rax\n");
                var short_l: LabelOut = fresh_label(s);
                s = short_l.state;
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    jz " + short_l.name + "\n");
                } else {
                    s = s.write("    jnz " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    movq $0, %rax\n");
                } else {
                    s = s.write("    movq $1, %rax\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Float (f64) arithmetic + comparison. Operands flow as
            // 8-byte bit patterns; load into xmm regs and operate.
            // Arithmetic pushes the result bits; comparison pushes a
            // 0/1 i32. Detected when either operand infers as f64.
            var is_flt: boolean = infer_expr_type(b.left, s) == "f64" || infer_expr_type(b.right, s) == "f64";
            if (is_flt && (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm1\n");   // rhs
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm0\n");   // lhs
                if (b.op == "+") { s = s.write("    addsd %xmm1, %xmm0\n"); }
                else if (b.op == "-") { s = s.write("    subsd %xmm1, %xmm0\n"); }
                else if (b.op == "*") { s = s.write("    mulsd %xmm1, %xmm0\n"); }
                else { s = s.write("    divsd %xmm1, %xmm0\n"); }
                s = s.write("    movq %xmm0, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (is_flt && (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "==" || b.op == "!=")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm1\n");   // rhs
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm0\n");   // lhs
                s = s.write("    ucomisd %xmm1, %xmm0\n");
                s = s.write("    movq $0, %rax\n");
                // IEEE: every relation with NaN is false; equality with
                // NaN is also false; only `!=` returns true on NaN.
                // ucomisd sets CF=ZF=PF=1 for unordered, so plain setb /
                // setbe would mis-report `NaN < x` and `NaN <= x` as
                // true. Mask `<` and `<=` with `setnp` (PF=0 → ordered);
                // `==` gates on ordered-AND-equal, `!=` accepts either
                // ordered-not-equal OR unordered. `>` / `>=` map to
                // seta / setae which already require CF=0, so unordered
                // (CF=1) is automatically false.
                if (b.op == "<") {
                    s = s.write("    setb %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else if (b.op == "<=") {
                    s = s.write("    setbe %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else if (b.op == ">") { s = s.write("    seta %al\n"); }
                else if (b.op == ">=") { s = s.write("    setae %al\n"); }
                else if (b.op == "==") {
                    s = s.write("    sete %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else {
                    s = s.write("    setne %al\n");
                    s = s.write("    setp %dl\n");
                    s = s.write("    orb %dl, %al\n");
                }
                s = s.write("    movzbq %al, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    popq %rcx\n");        // rhs
            s = s.write("    popq %rax\n");        // lhs
            if (b.op == "+") {
                s = s.write("    addq %rcx, %rax\n");
            } else if (b.op == "-") {
                s = s.write("    subq %rcx, %rax\n");
            } else if (b.op == "*") {
                s = s.write("    imulq %rcx, %rax\n");
            } else if (b.op == "/") {
                // idivq: dividend in rdx:rax (sign-extended via
                // cqto), divisor in operand. Result quotient in
                // rax, remainder in rdx.
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
            } else if (b.op == "%") {
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
                s = s.write("    movq %rdx, %rax\n");
            } else if (b.op == "&") {
                s = s.write("    andq %rcx, %rax\n");
            } else if (b.op == "|") {
                s = s.write("    orq %rcx, %rax\n");
            } else if (b.op == "^") {
                s = s.write("    xorq %rcx, %rax\n");
            } else if (b.op == "<<") {
                s = s.write("    shlq %cl, %rax\n");
            } else if (b.op == ">>") {
                // Arithmetic (signed) shift right — Fern i32 is signed.
                s = s.write("    sarq %cl, %rax\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmpq rhs, lhs` sets flags from
                // (lhs - rhs); setcc materialises the bool in
                // %al, movzbq zero-extends into %rax so the
                // surrounding stack push gets a clean 0/1.
                // Pick signed vs unsigned set instructions from the
                // operand tags — `u32` / `u64` / `usize` use
                // setb / setbe / seta / setae so values near u64-max
                // sort/compare in the expected order.
                var is_unsigned: boolean = is_unsigned_tag(infer_expr_type(b.left, s))
                    || is_unsigned_tag(infer_expr_type(b.right, s));
                s = s.write("    cmpq %rcx, %rax\n");
                var cc: string = "";
                if (b.op == "<") { if (is_unsigned) { cc = "setb"; } else { cc = "setl"; } }
                else if (b.op == "<=") { if (is_unsigned) { cc = "setbe"; } else { cc = "setle"; } }
                else if (b.op == ">") { if (is_unsigned) { cc = "seta"; } else { cc = "setg"; } }
                else if (b.op == ">=") { if (is_unsigned) { cc = "setae"; } else { cc = "setge"; } }
                else if (b.op == "==") { cc = "sete"; }
                else { cc = "setne"; }
                s = s.write("    " + cc + " %al\n");
                s = s.write("    movzbq %al, %rax\n");
            } else {
                s = s.write("    # unsupported binop: " + b.op + "\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnary(u) => {
            // `expr?` try operator: unwrap a Some/Ok payload, or
            // early-return the None/Err box from the enclosing function.
            if (u.op == "try_") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");          // option/result box
                s = s.write("    movq (%rax), %rcx\n");  // tag (0 = Some/Ok)
                var tlbl: LabelOut = fresh_label(s);
                s = tlbl.state;
                s = s.write("    testq %rcx, %rcx\n");
                s = s.write("    jz " + tlbl.name + "\n");
                // None/Err: return the box (already in %rax) unchanged.
                s = s.write("    leave\n");
                s = s.write("    ret\n");
                s = s.write(tlbl.name + ":\n");
                s = s.write("    movq 8(%rax), %rax\n"); // payload
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                if (infer_expr_type(u.operand, s) == "f64") {
                    // Float negation: flip the IEEE-754 sign bit (63).
                    s = s.write("    movabsq $-9223372036854775808, %rcx\n");
                    s = s.write("    xorq %rcx, %rax\n");
                } else {
                    s = s.write("    negq %rax\n");
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                s = s.write("    xorq $1, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // `expr as Type` casts (parser desugars to the unary op
            // `as_<Type>`). All integer types occupy 64-bit slots, so
            // a cast masks (unsigned) or sign-extends (signed) to the
            // target width; i64/u64/usize and anything else are no-ops.
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ty: string = u.op[3:u.op.len()];
                var src_ty: string = infer_expr_type(u.operand, s);
                var to_float: boolean = ty == "f64" || ty == "f32" || ty == "float";
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                if (to_float) {
                    // → float. From int: cvtsi2sd. From float: no-op.
                    if (src_ty != "f64") {
                        s = s.write("    cvtsi2sd %rax, %xmm0\n");
                        s = s.write("    movq %xmm0, %rax\n");
                    }
                } else if (src_ty == "f64") {
                    // float → int: truncate toward zero, then width-mask.
                    s = s.write("    movq %rax, %xmm0\n");
                    s = s.write("    cvttsd2si %xmm0, %rax\n");
                    if (ty == "u8") { s = s.write("    andq $255, %rax\n"); }
                    else if (ty == "u16") { s = s.write("    andq $65535, %rax\n"); }
                    else if (ty == "i8") { s = s.write("    movsbq %al, %rax\n"); }
                    else if (ty == "i16") { s = s.write("    movswq %ax, %rax\n"); }
                } else {
                    if (ty == "u8") { s = s.write("    andq $255, %rax\n"); }
                    else if (ty == "u16") { s = s.write("    andq $65535, %rax\n"); }
                    else if (ty == "u32") { s = s.write("    movl %eax, %eax\n"); }
                    else if (ty == "i8") { s = s.write("    movsbq %al, %rax\n"); }
                    else if (ty == "i16") { s = s.write("    movswq %ax, %rax\n"); }
                    else if (ty == "i32") { s = s.write("    movslq %eax, %rax\n"); }
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    pushq " + i32_to_string(off) + "(%rbp)\n");
                return s;
            }
            // Built-in `None` — the empty Option. Heap box whose
            // first word is the tag 1 (Some=0 / None=1). See the
            // Some(x) constructor + the StmtMatch Some/None arms.
            if (id.name == "None") {
                s = s.write("    movq $16, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                s = s.write("    movq $1, (%rax)\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // A bare ident naming a zero-arg, receiver-less function
            // (i.e. a `const`, desugared to such a function) lowers to
            // a call to that function.
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    s = s.write("    call __fn_" + sanitize_label(id.name) + "\n");
                    s = s.write("    pushq %rax\n");
                    return s;
                }
                cfi = cfi + 1;
            }
            // A bare ident naming a receiver-less function WITH params
            // is a function value (higher-order use, e.g. `apply(dbl, …)`).
            // Represent it as a 1-slot closure box `[&__fn_name]` so it
            // flows through the same closure-call path as a real lambda.
            // The box-in-%r10 convention means the plain function ignores
            // the (empty) box and reads its params at +16(%rbp) as usual.
            var fvi: i32 = 0;
            while (fvi < s.funcs.len()) {
                if (s.funcs[fvi].name == id.name && s.funcs[fvi].receiver_type.len() == 0 && s.funcs[fvi].params.len() > 0) {
                    return emit_fn_value(id.name, s);
                }
                fvi = fvi + 1;
            }
            // A bare ident naming a zero-field struct is a no-payload
            // enum variant (`JNull`). Construct [shape_ptr] — an 8-byte
            // box holding the interned variant name, so the match's
            // shape-pointer compare identifies it.
            if (is_unit_variant(id.name, s)) {
                s = s.write("    movq $8, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                var uvLit: StringLitOut = add_string_lit(s, id.name);
                s = uvLit.state;
                s = s.write("    leaq .S" + i32_to_string(uvLit.idx) + "(%rip), %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unresolved ident: " + id.name + "\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — encode as a 0/1 i32 so it can flow
            // through comparison-style consumers (e.g. an if
            // cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    movq $" + i32_to_string(v) + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal lowering: intern the bytes in
            // .rodata, then allocate a 16-byte box on the heap
            // `[data_ptr: 8, len: 8]` and push the box pointer.
            // The box layout is shared with __fern_str_concat
            // / _eq / _slice / _print runtime helpers.
            var lo: StringLitOut = add_string_lit(s, sv.value);
            s = lo.state;
            s = s.write("    movq $16, %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            s = s.write("    leaq .S" + i32_to_string(lo.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    movq $" + i32_to_string(sv.value.len()) + ", %rcx\n");
            s = s.write("    movq %rcx, 8(%rax)\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprCall(c) => {
            var name: string = "";
            // Inline-lambda call (IIFE), e.g. an if-expression desugar
            // `(function(): T { … })()`. Emit the closure box, push the
            // args above it, then invoke via the closure convention (box
            // ptr in %r10, args at +16(%rbp), …) — same as the local-
            // closure path below, but the box is the inline lambda's.
            match (c.callee) {
                parser.ExprLambda(_) => {
                    s = emit_expr(c.callee, s);          // push closure box
                    var la: i32 = c.args.len() - 1;
                    while (la >= 0) {
                        s = emit_expr(c.args[la], s);
                        la = la - 1;
                    }
                    s = s.write("    movq " + i32_to_string(c.args.len() * 8) + "(%rsp), %r10\n"); // box ptr
                    s = s.write("    movq (%r10), %rdx\n");
                    s = s.write("    call *%rdx\n");
                    s = s.write("    addq $" + i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n"); // pop args + box
                    s = s.write("    pushq %rax\n");
                    return s;
                },
                _ => {}
            }
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                parser.ExprFieldAccess(fa) => {
                    // Reader.read_chunk(n) — read up to n bytes from
                    // the receiver fd; returns Some(string) on a
                    // non-empty read, None at EOF. The receiver is a
                    // Reader (its fd value); see stdin().
                    if (fa.field == "read_chunk" && c.args.len() == 1) {
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = s.write("    popq %rsi\n");   // n
                        s = s.write("    popq %rdi\n");   // fd
                        s = s.write("    call __fern_reader_read_chunk\n");
                        s = s.write("    pushq %rax\n");
                        s = s.mark_heap();
                        return s;
                    }
                    // Reader.close(n) — close the receiver fd. Always
                    // returns None (the IoError arm is unused here).
                    if (fa.field == "close" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rdi\n");   // fd
                        s = s.write("    call __fern_reader_close\n");
                        s = s.write("    pushq %rax\n");
                        s = s.mark_heap();
                        return s;
                    }
                    // Primitive-receiver fast path: when the
                    // receiver's inferred type is "string" /
                    // "i32" / "bool" / "f64", skip the shape-
                    // pointer dispatch chain (those values
                    // aren't heap-boxed with a shape ptr) and
                    // call `__fn_<type>__<method>` directly.
                    var prim_recv: string = infer_expr_type(fa.obj, s);
                    // Map methods (string-keyed). set returns the
                    // (mutated) map; get → Option[V]; has → bool;
                    // len → i32.
                    if (is_map(prim_recv) && fa.field == "set" && c.args.len() == 2) {
                        var kk_set: string = "0";
                        if (map_key_is_i32(prim_recv)) { kk_set = "1"; }
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = emit_expr(c.args[1], s);
                        s = s.write("    popq %rdx\n");   // v
                        s = s.write("    popq %rsi\n");   // k
                        s = s.write("    popq %rdi\n");   // mapbox
                        s = s.write("    movq $" + kk_set + ", %rcx\n");   // keykind
                        s = s.write("    call __fern_map_set\n");
                        s = s.write("    pushq %rax\n");
                        s = s.mark_heap();
                        s = s.mark_str_eq();
                        s = s.mark_arr_push();
                        return s;
                    }
                    if (is_map(prim_recv) && fa.field == "get" && c.args.len() == 1) {
                        var kk_get: string = "0";
                        if (map_key_is_i32(prim_recv)) { kk_get = "1"; }
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = s.write("    popq %rsi\n");   // k
                        s = s.write("    popq %rdi\n");   // mapbox
                        s = s.write("    movq $" + kk_get + ", %rdx\n");   // keykind
                        s = s.write("    call __fern_map_get\n");
                        s = s.write("    pushq %rax\n");
                        s = s.mark_heap();
                        s = s.mark_str_eq();
                        return s;
                    }
                    // m.get_or(k, default) — equivalent to `match m.get(k)
                    // { Some(v) => v, None => default }`, but inlined so
                    // core/map's open-addressing body (which doesn't
                    // match the native __fern_map_* runtime layout)
                    // never runs. Without this the generic struct
                    // shape-dispatch reads garbage out of the map box
                    // and segfaults — std/test's assert_json_eq_field_*
                    // helpers (via core/map's m.get_or) hit it.
                    if (is_map(prim_recv) && fa.field == "get_or" && c.args.len() == 2) {
                        var kk_or: string = "0";
                        if (map_key_is_i32(prim_recv)) { kk_or = "1"; }
                        var or_lbl: i32 = s.label_n;
                        s = EmitState {
                            out: s.out, label_n: s.label_n + 2, local_names: s.local_names,
                            in_function: s.in_function, string_lits: s.string_lits,
                            needs_print_int: s.needs_print_int, needs_read_int: s.needs_read_int,
                            needs_heap: s.needs_heap, struct_decls: s.struct_decls,
                            loop_exit_labels: s.loop_exit_labels, loop_cont_labels: s.loop_cont_labels,
                            funcs: s.funcs, local_types: s.local_types,
                            needs_str_concat: s.needs_str_concat, needs_str_eq: s.needs_str_eq,
                            needs_str_print: s.needs_str_print, needs_str_cmp: s.needs_str_cmp,
                            needs_str_read_line: s.needs_str_read_line,
                            needs_i32_to_string: s.needs_i32_to_string, needs_str_to_i32: s.needs_str_to_i32,
                            needs_eprint: s.needs_eprint, needs_str_search: s.needs_str_search,
                            needs_args: s.needs_args, needs_arr_push: s.needs_arr_push,
                            needs_arr_slice: s.needs_arr_slice, needs_arr_i32_index_of: s.needs_arr_i32_index_of,
                            needs_arr_reverse: s.needs_arr_reverse, needs_arr_concat: s.needs_arr_concat,
                            needs_arr_str_index_of: s.needs_arr_str_index_of,
                            needs_arr_str_join: s.needs_arr_str_join, needs_arr_i32_sum: s.needs_arr_i32_sum,
                            needs_arr_i32_min_max: s.needs_arr_i32_min_max,
                            needs_arr_i32_product: s.needs_arr_i32_product,
                            needs_str_chars: s.needs_str_chars, needs_str_bytes: s.needs_str_bytes,
                            needs_str_reverse: s.needs_str_reverse, needs_i32_pow: s.needs_i32_pow
                        };
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = emit_expr(c.args[1], s);
                        // stack: [default, k, mapbox] (top down).
                        s = s.write("    popq %rdx\n");   // default (saved on stack below)
                        s = s.write("    popq %rsi\n");   // k
                        s = s.write("    popq %rdi\n");   // mapbox
                        s = s.write("    pushq %rdx\n");  // save default across call
                        s = s.write("    movq $" + kk_or + ", %rdx\n");
                        s = s.write("    call __fern_map_get\n");   // rax = Option box
                        s = s.write("    popq %rdx\n");   // restore default
                        s = s.write("    movq (%rax), %rcx\n");  // tag (0=Some, 1=None)
                        s = s.write("    testq %rcx, %rcx\n");
                        s = s.write("    jnz .Lgo_def_" + i32_to_string(or_lbl) + "\n");
                        s = s.write("    movq 8(%rax), %rax\n");  // Some payload
                        s = s.write("    jmp .Lgo_end_" + i32_to_string(or_lbl) + "\n");
                        s = s.write(".Lgo_def_" + i32_to_string(or_lbl) + ":\n");
                        s = s.write("    movq %rdx, %rax\n");
                        s = s.write(".Lgo_end_" + i32_to_string(or_lbl) + ":\n");
                        s = s.write("    pushq %rax\n");
                        s = s.mark_heap();
                        s = s.mark_str_eq();
                        return s;
                    }
                    if (is_map(prim_recv) && fa.field == "has" && c.args.len() == 1) {
                        var kk_has: string = "0";
                        if (map_key_is_i32(prim_recv)) { kk_has = "1"; }
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = s.write("    popq %rsi\n");   // k
                        s = s.write("    popq %rdi\n");   // mapbox
                        s = s.write("    movq $" + kk_has + ", %rdx\n");   // keykind
                        s = s.write("    call __fern_map_has\n");
                        s = s.write("    pushq %rax\n");
                        s = s.mark_str_eq();
                        return s;
                    }
                    if (is_map(prim_recv) && fa.field == "len" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");
                        s = s.write("    movq (%rax), %rax\n");   // keys arr
                        s = s.write("    movq (%rax), %rax\n");   // keys.len
                        s = s.write("    pushq %rax\n");
                        s = s.mark_heap();
                        s = s.mark_str_eq();
                        s = s.mark_arr_push();
                        return s;
                    }
                    // m.keys() / m.values() — the map box already holds
                    // the parallel keys[]/values[] arrays at offset 0/8,
                    // so return them directly (live snapshots; the
                    // self-host compiler isn't perf-/aliasing-critical).
                    if (is_map(prim_recv) && fa.field == "keys" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");
                        s = s.write("    movq (%rax), %rax\n");   // keys arr
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    if (is_map(prim_recv) && fa.field == "values" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");
                        s = s.write("    movq 8(%rax), %rax\n");  // values arr
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    // Map iteration. m.iter() → a 16-byte iterator box
                    // [map_ptr @0, cursor @8]; has_next / key / value /
                    // advance read or bump the cursor over the parallel
                    // keys[] / values[] arrays.
                    if (is_map(prim_recv) && fa.field == "iter" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);                 // map ptr
                        s = s.write("    movq $16, %rdi\n");
                        s = s.write("    call __fern_alloc\n");
                        s = s.mark_heap();
                        s = s.write("    popq %rcx\n");           // map ptr
                        s = s.write("    movq %rcx, (%rax)\n");   // map @0
                        s = s.write("    movq $0, 8(%rax)\n");    // cursor @8
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    if (is_mapiter(prim_recv) && fa.field == "has_next" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");           // iter
                        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
                        s = s.write("    movq (%rax), %rdx\n");   // map
                        s = s.write("    movq (%rdx), %rdx\n");   // keys arr
                        s = s.write("    movq (%rdx), %rdx\n");   // keys.len
                        s = s.write("    cmpq %rdx, %rcx\n");
                        s = s.write("    movq $0, %rax\n");
                        s = s.write("    setl %al\n");
                        s = s.write("    movzbq %al, %rax\n");
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    if (is_mapiter(prim_recv) && fa.field == "key" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");
                        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
                        s = s.write("    movq (%rax), %rdx\n");   // map
                        s = s.write("    movq (%rdx), %rdx\n");   // keys arr
                        s = s.write("    incq %rcx\n");
                        s = s.write("    movq (%rdx,%rcx,8), %rax\n");  // keys[cursor+1]
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    if (is_mapiter(prim_recv) && fa.field == "value" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");
                        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
                        s = s.write("    movq (%rax), %rdx\n");   // map
                        s = s.write("    movq 8(%rdx), %rdx\n");  // values arr
                        s = s.write("    incq %rcx\n");
                        s = s.write("    movq (%rdx,%rcx,8), %rax\n");  // values[cursor+1]
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    if (is_mapiter(prim_recv) && fa.field == "advance" && c.args.len() == 0) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    popq %rax\n");           // iter
                        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
                        s = s.write("    incq %rcx\n");
                        s = s.write("    movq %rcx, 8(%rax)\n");
                        s = s.write("    pushq $0\n");            // dummy result
                        return s;
                    }
                    // Built-in `.len()` on string / array values.
                    // String boxes carry the byte-count at offset
