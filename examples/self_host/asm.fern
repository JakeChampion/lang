        s = s.write("    movq 8(%rdi), %r13\n");     // len
        // Advance %r12 past leading whitespace.
        s = s.write(".Ltrim_front:\n");
        s = s.write("    cmpq $0, %r13\n");
        s = s.write("    je .Ltrim_box\n");
