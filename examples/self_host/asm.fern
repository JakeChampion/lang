// examples/self_host/asm.fern — first true codegen layer in the
// self-host port. Walks a parser.Module and emits AT&T x86_64
// assembly text. The emitted asm uses Linux syscall conventions
// (sys_exit_group = 60) and is assemble-able with
// `gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmpq + setcc
//   - Parenthesised grouping (handled implicitly via recursion)
//   - Unary `-`
//   - Control flow: if/else and while (forward-jump patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit_group
//
// The output programs are valid standalone Linux ELF binaries
// after `gcc -nostdlib -static <out>.s -o <out>`. A follow-up
// Go-side test could exec them and assert the exit code matches
// the Fern-port's interp.fern on the same source — that would
// be a real "Fern emits running native code" demo. For now the
// Fern-side validation is substring assertions on the emitted
// text.
//
// Lowering shape — a textual stack machine. Each expr emits ops
// that leave its result on the rt-stack via push %rax:
//   literal n:  movq $n, %rax; pushq %rax
//   bin l op r: <emit l>; <emit r>; popq %rcx; popq %rax;
//               <op>; pushq %rax
// Statement `return <expr>;` emits the expr, then pops into %rdi
// and issues `sys_exit_group`. Same lowering the production
// codegen uses for the same shape — just typeset as text.

import "./lexer";
import "./parser";
import "./asmcore";
import "./util";
import "./asm_ir";

















































































// =================== ASM EMITTER ====================

// emit_fn_value emits a 1-slot closure box [&__fn_name] for a function
// referenced by name as a value. Shared by ExprIdent (params>0) and the
// call-arg path (a fn-typed param of any arity — including a 0-arg
// `() => R`, which can't be distinguished from a const at the ident
// site, so the boxing decision is made at the call site instead).
function emit_fn_value(name: string, s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    movq $8, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.mark_heap();
    s = s.write("    leaq __fn_" + asmcore.sanitize_label(name) + "(%rip), %rcx\n");
    s = s.write("    movq %rcx, (%rax)\n");
    s = s.write("    pushq %rax\n");
    return s;
}




// enum_payload_retain emits a Perceus construction retain for an
// enum / Option / Result payload sitting in %rcx, when that payload
// aliases an rc-tracked array (the box now owns the reference, so the
// array must survive the source local's release). The box pointer in
// %rax is preserved across the call (__fern_rc_inc returns the ptr).
// A fresh literal / call payload is already owned and not re-retained.
function enum_payload_retain(arg: parser.Expr, s: asmcore.EmitState): asmcore.EmitState {
    if (!asmcore.needs_rc_inc_on_alias(arg, s)) { return s; }
    s = s.mark_heap();
    s = s.write("    pushq %rax\n");            // save box ptr
    s = s.write("    pushq %rcx\n");            // retain arg = payload
    s = s.write("    call __fn___fern_rc_inc\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    movq %rax, %rcx\n");       // payload (helper returns the ptr)
    s = s.write("    popq %rax\n");             // restore box ptr
    return s;
}

// emit_call lowers a parser.ExprCall (the `c` payload). Split out
// of emit_expr's match so the dispatch reads as a table and this
// arm — the largest by far — is independently navigable.
// CallOut signals whether try_emit_builtin handled the call.
struct CallOut { state: asmcore.EmitState, done: boolean }

// try_emit_builtin lowers a builtin/intrinsic free call by name
// (print, len, str_*, map_new, Some/Ok/Err, f64 intrinsics, strbuf,
// …). Returns done=true when it emitted the call; done=false (with
// the state untouched) when `name` is not a builtin, so emit_call
// falls through to the closure / generic user-call path.
function try_emit_builtin(c: parser.ExprCall, name: string, s: asmcore.EmitState): CallOut {
    if (name == "len" && c.args.len() == 1) {
        // Dispatch on operand type: string → load
        // box.len at offset 8; array → load len prefix
        // at offset 0. Unknown defaults to array.
        var lt: asmcore.Ty = asmcore.infer_expr_type(c.args[0], s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rax\n");
        if (asmcore.ty_is_string(lt)) {
            s = s.write("    movq 8(%rax), %rax\n");
        } else {
            s = s.write("    movq (%rax), %rax\n");
        }
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // Raw-memory intrinsics (#2649 Tier-2 floor — docs/RUNTIME-INTRINSICS.md).
    // Unsafe/unchecked; only the audited Tier-2 helpers use them. Each is one
    // instruction (or a __fern_alloc call). Args arrive on the operand stack
    // left-to-right (last arg on top). Stores push the value back to keep the
    // one-value-per-expr invariant; statement position drops it.
    if (name == "__raw_alloc" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n    call __fern_alloc\n    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_store8" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    addq %rcx, %rax\n    movb %dl, (%rax)\n    pushq %rdx\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_load8" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rcx\n    popq %rax\n    addq %rcx, %rax\n    movzbl (%rax), %eax\n    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_store_ptr" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    movq %rdx, (%rax,%rcx,8)\n    pushq %rdx\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_load_ptr" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rcx\n    popq %rax\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_string" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        // rc-headered box via __fern_str_box (#2649 Option A): len (top) -> %rsi,
        // data -> %rdi. A legacy-path box can flow into an IR caller that reclaims it,
        // so it must carry the same rc header as the IR path's boxes.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_box\n    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // `write(s)` is `print(s)` without a trailing newline. The
    // self-host print runtime already omits the newline, so
    // write and print share the same lowering here; the Go
    // backend distinguishes them (print = puts, with newline),
    // so the bootstrap driver uses `write` to keep the
    // self-hosted output byte-identical to the Go-built one.
    if ((name == "print" || name == "write") && c.args.len() == 1) {
        // `print` appends a newline (Fern's print == println);
        // `write` emits the bytes verbatim. Both otherwise share
        // this lowering.
        var add_nl: boolean = name == "print";
        var arg: parser.Expr = c.args[0];
        match (arg) {
            parser.ExprString(sv) => {
                // Fast path for literals — direct
                // syscall, no heap-box alloc. For `print`
                // the trailing newline rides along in the
                // interned literal so it's one write.
                var lit_val: string = sv.value;
                if (add_nl) { lit_val = sv.value + "\n"; }
                var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, lit_val);
                s = lo.state;
                s = s.write("    movq $1, %rdi\n");
                s = s.write("    leaq .S" + util.i32_to_string(lo.idx) + "(%rip), %rsi\n");
                s = s.write("    movq $" + util.i32_to_string(lit_val.len()) + ", %rdx\n");
                s = s.write("    movq $1, %rax\n");
                s = s.write("    syscall\n");
                s = s.write("    pushq $0\n");
                return CallOut { state: s, done: true };
            },
            _ => { }
        }
        // Non-literal string argument: eval as box ptr,
        // route through __fern_print_str.
        var at: asmcore.Ty = asmcore.infer_expr_type(arg, s);
        if (asmcore.ty_is_string(at)) {
            s = emit_expr(arg, s);
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_print_str\n");
            s = s.mark_str_print();
            if (add_nl) {
                var nlo: asmcore.StringLitOut = asmcore.add_string_lit(s, "\n");
                s = nlo.state;
                s = s.write("    movq $1, %rdi\n");
                s = s.write("    leaq .S" + util.i32_to_string(nlo.idx) + "(%rip), %rsi\n");
                s = s.write("    movq $1, %rdx\n");
                s = s.write("    movq $1, %rax\n");
                s = s.write("    syscall\n");
            }
            s = s.write("    pushq $0\n");
            return CallOut { state: s, done: true };
        }
    }
    // eprint(s) — same as print but writes to stderr
    // (fd=2). Useful for error messages that shouldn't
    // mix with normal stdout output.
    if (name == "eprint" && c.args.len() == 1) {
        var earg: parser.Expr = c.args[0];
        match (earg) {
            parser.ExprString(esv) => {
                // eprint appends a newline (stderr line-printer); the trailing
                // "\n" rides along in the interned literal so it's one write.
                var elit: string = esv.value + "\n";
                var elo: asmcore.StringLitOut = asmcore.add_string_lit(s, elit);
                s = elo.state;
                s = s.write("    movq $2, %rdi\n");
                s = s.write("    leaq .S" + util.i32_to_string(elo.idx) + "(%rip), %rsi\n");
                s = s.write("    movq $" + util.i32_to_string(elit.len()) + ", %rdx\n");
                s = s.write("    movq $1, %rax\n");
                s = s.write("    syscall\n");
                s = s.write("    pushq $0\n");
                return CallOut { state: s, done: true };
            },
            _ => { }
        }
        var eat: asmcore.Ty = asmcore.infer_expr_type(earg, s);
        if (asmcore.ty_is_string(eat)) {
            s = emit_expr(earg, s);
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_eprint_str\n");
            s = s.write("    pushq $0\n");
            s = s.mark_eprint();
            return CallOut { state: s, done: true };
        }
    }
    // print_int(i32_expr) — builtin lowering to a call into
    // a runtime helper that converts the value to decimal
    // text and writes it to stdout. The helper is emitted
    // once at the end of the module if any print_int call
    // appears.
    if (name == "print_int" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_print_int\n");
        s = s.write("    pushq $0\n");
        s = s.mark_print_int();
        return CallOut { state: s, done: true };
    }
    // eprint_int(n) — stderr companion to print_int.
    // Composed from __fern_i32_to_string + __fern_eprint_str
    // so we don't need a third runtime helper.
    if (name == "eprint_int" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_i32_to_string\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    call __fern_eprint_str\n");
        s = s.write("    pushq $0\n");
        s = s.mark_i32_to_string();
        s = s.mark_eprint();
        return CallOut { state: s, done: true };
    }
    // exit(n) — process exit with the given code.
    // Lowers to sys_exit (#60 on x86_64). The push $0
    // after the syscall is unreachable but keeps the
    // rt-stack shape so a surrounding expression like
    // `if (cond) { exit(7); }` doesn't desynchronise.
    if (name == "exit" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    pushq $0\n");
        return CallOut { state: s, done: true };
    }
    // args_count() — returns argc (the number of command-
    // line arguments, including argv[0]).
    if (name == "args_count" && c.args.len() == 0) {
        s = s.write("    movq __fern_argc(%rip), %rax\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_args();
        return CallOut { state: s, done: true };
    }
    // args() — the full language's argv accessor: returns a
    // string[] of all command-line arguments (argv[0] first).
    if (name == "args" && c.args.len() == 0) {
        s = s.write("    call __fern_args\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_args();
        return CallOut { state: s, done: true };
    }
    // arg_at(i) — returns argv[i] as a string box.
    // i is bounds-clamped by the user — out-of-range
    // reads through random memory.
    if (name == "arg_at" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_arg_at\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_args();
        return CallOut { state: s, done: true };
    }
    // str_split(s, sep) — returns string[] of substrings
    // separated by sep. Empty sep → [s]. No matches → [s].
    if (name == "str_split" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);   // s
        s = emit_expr(c.args[1], s);   // sep
        s = s.write("    popq %rsi\n");   // sep
        s = s.write("    popq %rdi\n");   // s
        // __fn_ stack convention: param[0]=s on top (+16), param[1]=sep (+24).
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_split\n    addq $16, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_split();
        return CallOut { state: s, done: true };
    }
    // read_int() — builtin no-arg call to the read_int helper.
    // Reads up to 16 bytes from stdin, parses an optional
    // leading `-` followed by decimal digits, returns the
    // result in %rax. Push it so the surrounding expression
    // sees it on the rt-stack.
    if (name == "read_int" && c.args.len() == 0) {
        s = s.write("    call __fern_read_int\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_read_int();
        return CallOut { state: s, done: true };
    }
    // read_line() — no-arg builtin returning a string
    // box. Reads up to 256 bytes from stdin, scans for
    // a '\n', allocates a 16-byte box whose data ptr
    // points at the read bytes and whose len is the
    // byte count up to (but not including) the newline.
    if (name == "read_line" && c.args.len() == 0) {
        s = s.write("    call __fern_read_line\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_read_line();
        return CallOut { state: s, done: true };
    }
    // read_all_stdin() — read fd 0 to EOF into one string box.
    // Unlike read_line (one 256-byte read), this loops until
    // the read syscall returns 0, so it can pull in a whole
    // multi-line source (blank lines and all) — required for
    // feeding the compiler its own source. Piggybacks the
    // read_line needs-flag for runtime emission + heap.
    if (name == "read_all_stdin" && c.args.len() == 0) {
        s = s.write("    call __fern_read_all_stdin\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_read_line();
        return CallOut { state: s, done: true };
    }
    // read_file(path) — read the whole named file. Returns
    // Result[string, IoError]: Ok(contents) on success,
    // Err(_) on any I/O error. Matches the full language's
    // signature so `match read_file(p) { Ok(s) =>, Err(_) => }`
    // compiles the same here as under the Go backend.
    if (name == "read_file" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_read_file\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // write_file(path, content) — write the whole content to
    // the named file. Returns Option[IoError]: None on success,
    // Some(_) on any I/O error.
    if (name == "write_file" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rsi\n");        // content box
        s = s.write("    popq %rdi\n");        // path box
        s = s.write("    call __fern_write_file\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // now_unix_ms() — wall-clock milliseconds since the Unix
    // epoch (clock_gettime(CLOCK_REALTIME)). Returns an i64 in
    // %rax; no heap.
    if (name == "now_unix_ms" && c.args.len() == 0) {
        s = s.write("    call __fern_now_unix_ms\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // monotonic_ns() — nanoseconds from a monotonic clock
    // (clock_gettime(CLOCK_MONOTONIC)). For elapsed-time
    // measurement, not wall-clock. Returns an i64 in %rax.
    if (name == "monotonic_ns" && c.args.len() == 0) {
        s = s.write("    call __fern_monotonic_ns\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // now_ns() — wall-clock nanoseconds since the Unix epoch
    // (clock_gettime(CLOCK_REALTIME)). The i64 nanosecond twin of
    // now_unix_ms. Returns an i64 in %rax; no heap.
    if (name == "now_ns" && c.args.len() == 0) {
        s = s.write("    call __fern_now_ns\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // sleep_ms(n) — pause for `n` ms (no-op if n <= 0).
    // Returns void; we push 0 so the stack-machine invariant
    // holds.
    if (name == "sleep_ms" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_sleep_ms\n");
        s = s.write("    pushq $0\n");
        return CallOut { state: s, done: true };
    }
    // remove_file(path) — unlink. Returns Option[IoError]:
    // None on success, Some(_) on error.
    if (name == "remove_file" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_remove_file\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // subprocess(cmd, args, stdin) → ProcessResult — spawn a
    // child, pipe its stdin / stdout / stderr, collect both
    // streams to EOF + the exit code.
    if (name == "subprocess" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    popq %rdx\n");   // stdin box
        s = s.write("    popq %rsi\n");   // args box
        s = s.write("    popq %rdi\n");   // cmd box
        s = s.write("    call __fern_subprocess\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // f64_bits / f64_from_bits — no-op reinterprets. The
    // 8-byte rt-stack slot already holds the IEEE bit pattern.
    if ((name == "f64_bits" || name == "f64_from_bits") && c.args.len() == 1) {
        return CallOut { state: emit_expr(c.args[0], s), done: true };
    }
    // f32_bits(x) — narrow f64 to f32, take the 32-bit pattern
    // as a sign-extended i32 slot.
    if (name == "f32_bits" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq %rax, %xmm0\n");
        s = s.write("    cvtsd2ss %xmm0, %xmm0\n");
        s = s.write("    movd %xmm0, %eax\n");
        s = s.write("    movsxd %eax, %rax\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // f32_from_bits(b) — interpret the low 32 bits of b as an
    // IEEE-754 f32 and widen to f64.
    if (name == "f32_from_bits" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rax\n");
        s = s.write("    movd %eax, %xmm0\n");
        s = s.write("    cvtss2sd %xmm0, %xmm0\n");
        s = s.write("    movq %xmm0, %rax\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // env(name) — look up an environment variable. Returns
    // Option[string]: Some(value) if set, None otherwise.
    if (name == "env" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");        // name box
        s = s.write("    call __fern_env\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // temp_dir(prefix) — make a uniquely-named directory under
    // /tmp. Returns Result[string]: Ok(path) or Err(_).
    if (name == "temp_dir" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");        // prefix box
        s = s.write("    call __fern_temp_dir\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // read_dir(path) — list a directory's base-name children.
    // Returns Result[string[]]: Ok(names) or Err(_).
    if (name == "read_dir" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");        // path box
        s = s.write("    call __fern_read_dir\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // stat(path) — file metadata. Returns Result[FileStat]:
    // Ok(FileStat{is_file, is_dir, size}) or Err(_).
    if (name == "stat" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");        // path box
        s = s.write("    call __fern_stat\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // remove_dir_all(path) — recursive rm -rf. Returns
    // Option[IoError]: None on success (incl. missing), Some(_).
    if (name == "remove_dir_all" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");        // path box
        s = s.write("    call __fern_remove_dir_all\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // f64 math intrinsics — the cheap subset that lowers to a
    // single SSE instruction. The -nostdlib native backends
    // can't link libm, so std/float's `__*_f64` primitives are
    // implemented directly. Operand + result are f64 bit
    // patterns on the stack (in %rax). roundsd needs SSE4.1
    // (universal on x86-64). `__round_f64` is round-half-away-
    // from-zero (Go's math.Round) = trunc(x + copysign(0.5, x)).
    if ((name == "__abs_f64" || name == "__sqrt_f64" || name == "__floor_f64"
            || name == "__ceil_f64" || name == "__trunc_f64" || name == "__round_f64")
            && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rax\n");
        if (name == "__abs_f64") {
            s = s.write("    movabsq $0x7fffffffffffffff, %rcx\n");
            s = s.write("    andq %rcx, %rax\n");
        } else if (name == "__sqrt_f64") {
            s = s.write("    movq %rax, %xmm0\n");
            s = s.write("    sqrtsd %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n");
        } else if (name == "__floor_f64") {
            s = s.write("    movq %rax, %xmm0\n");
            s = s.write("    roundsd $1, %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n");
        } else if (name == "__ceil_f64") {
            s = s.write("    movq %rax, %xmm0\n");
            s = s.write("    roundsd $2, %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n");
        } else if (name == "__trunc_f64") {
            s = s.write("    movq %rax, %xmm0\n");
            s = s.write("    roundsd $3, %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n");
        } else {
            s = s.write("    movq %rax, %rcx\n");
            s = s.write("    movabsq $0x8000000000000000, %rdx\n");
            s = s.write("    andq %rdx, %rcx\n");            // sign bit of x
            s = s.write("    movabsq $0x3fe0000000000000, %rdx\n"); // 0.5
            s = s.write("    orq %rdx, %rcx\n");             // copysign(0.5, x)
            s = s.write("    movq %rcx, %xmm1\n");
            s = s.write("    movq %rax, %xmm0\n");
            s = s.write("    addsd %xmm1, %xmm0\n");
            s = s.write("    roundsd $3, %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n");
        }
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // f64 transcendentals — the x87 FPU computes these directly
    // (no libm, hardware-accurate). The value is moved through a
    // stack slot (x87 loads from memory, not xmm). exp(x) =
    // 2^(x·log2 e) via f2xm1 + fscale; log(x) = ln2·log2(x) via
    // fyl2x.
    if ((name == "__sin_f64" || name == "__cos_f64"
            || name == "__exp_f64" || name == "__log_f64") && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rax\n");
        s = s.write("    subq $8, %rsp\n");
        s = s.write("    movq %rax, (%rsp)\n");
        if (name == "__sin_f64") {
            s = s.write("    fldl (%rsp)\n");
            s = s.write("    fsin\n");
            s = s.write("    fstpl (%rsp)\n");
        } else if (name == "__cos_f64") {
            s = s.write("    fldl (%rsp)\n");
            s = s.write("    fcos\n");
            s = s.write("    fstpl (%rsp)\n");
        } else if (name == "__log_f64") {
            s = s.write("    fldln2\n");
            s = s.write("    fldl (%rsp)\n");
            s = s.write("    fyl2x\n");
            s = s.write("    fstpl (%rsp)\n");
        } else {
            s = s.write("    fldl2e\n");
            s = s.write("    fmull (%rsp)\n");      // t = x*log2(e)
            s = s.write("    fld %st(0)\n");
            s = s.write("    frndint\n");           // n = round(t)
            s = s.write("    fsubr %st, %st(1)\n"); // st1 = t - n = f (GAS fsubr)
            s = s.write("    fxch %st(1)\n");        // st0=f, st1=n
            s = s.write("    f2xm1\n");              // 2^f - 1
            s = s.write("    fld1\n");
            s = s.write("    faddp\n");              // 2^f
            s = s.write("    fscale\n");             // 2^f * 2^n
            s = s.write("    fstp %st(1)\n");
            s = s.write("    fstpl (%rsp)\n");
        }
        s = s.write("    movq (%rsp), %rax\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // pow(x, y) = x^y = 2^(y·log2 x) (x > 0). fyl2x then the
    // f2xm1 + fscale 2^t reconstruction.
    if (name == "__pow_f64" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);   // x
        s = emit_expr(c.args[1], s);   // y
        s = s.write("    popq %rcx\n");        // y
        s = s.write("    popq %rax\n");        // x
        s = s.write("    subq $16, %rsp\n");
        s = s.write("    movq %rax, (%rsp)\n");   // x
        s = s.write("    movq %rcx, 8(%rsp)\n");  // y
        s = s.write("    fldl 8(%rsp)\n");        // st0 = y
        s = s.write("    fldl (%rsp)\n");          // st0 = x, st1 = y
        s = s.write("    fyl2x\n");                // t = y*log2(x)
        s = s.write("    fld %st(0)\n");
        s = s.write("    frndint\n");              // n = round(t)
        s = s.write("    fsubr %st, %st(1)\n");    // st1 = t - n = f (GAS fsubr)
        s = s.write("    fxch %st(1)\n");
        s = s.write("    f2xm1\n");
        s = s.write("    fld1\n");
        s = s.write("    faddp\n");
        s = s.write("    fscale\n");
        s = s.write("    fstp %st(1)\n");
        s = s.write("    fstpl (%rsp)\n");
        s = s.write("    movq (%rsp), %rax\n");
        s = s.write("    addq $16, %rsp\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // __alloc_u8(n) — fresh zeroed byte array of n elements
    // (this emitter's array layout: 8-byte slots, cap header).
    if (name == "__alloc_u8" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_alloc_u8\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // __memcpy(dst, src, n) — raw byte copy (rep movsb). Args
    // are usize pointers + a byte count; returns the dst as a
    // dummy. std/string only reaches this from its bytes()
    // body, which the self-host dispatches to __fern_str_bytes
    // instead, so this exists mainly so std/string links.
    if (name == "__memcpy" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);   // dst
        s = emit_expr(c.args[1], s);   // src
        s = emit_expr(c.args[2], s);   // n
        s = s.write("    popq %rcx\n");        // n
        s = s.write("    popq %rsi\n");        // src
        s = s.write("    popq %rdi\n");        // dst
        s = s.write("    rep movsb\n");
        s = s.write("    pushq $0\n");
        return CallOut { state: s, done: true };
    }
    // string_from_bytes(arr) — pack each element's low byte
    // into a fresh string. Round-trips s.bytes() / a u8[] build.
    if (name == "string_from_bytes" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);   // arr (stays on the stack = param[0])
        s = s.write("    call __fn___fern_string_from_bytes\n    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_from_bytes();
        return CallOut { state: s, done: true };
    }
    // map_new(n) — a fresh empty Map (string-keyed, 8-byte
    // values; parallel keys[]/values[] arrays). The capacity
    // hint n is evaluated for side effects then ignored.
    if ((name == "map_new" || name == "map_new_i32") && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_map_new\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return CallOut { state: s, done: true };
    }
    // cell_new(v) — a single-slot box (docs/CELL-TYPE-PLAN.md): alloc 8
    // bytes, store the value, return the pointer. Leak-everything heap, so
    // no header / RC.
    if (name == "cell_new" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);             // value on the stack
        s = s.write("    movq $8, %rdi\n");
        s = s.write("    call __fern_alloc\n");   // rax = cell ptr
        s = s.write("    popq %rcx\n");           // value
        s = s.write("    movq %rcx, (%rax)\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // random_bytes(n) — a string of n cryptographically-random
    // bytes (getrandom). Used by std/math's random_int.
    if (name == "random_bytes" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_random_bytes\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // __set_index(arr, idx, val) — array element assignment,
    // the desugar of `arr[idx] = val`. Stores val into the
    // (idx+1)*8 slot; pushes a dummy so the surrounding
    // expression-statement has something to pop.
    if (name == "__set_index" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);   // arr
        s = emit_expr(c.args[1], s);   // idx
        s = emit_expr(c.args[2], s);   // val
        s = s.write("    popq %rdx\n");        // val
        s = s.write("    popq %rcx\n");        // idx
        s = s.write("    popq %rax\n");        // arr
        s = s.write("    incq %rcx\n");        // skip len prefix
        s = s.write("    movq %rdx, (%rax,%rcx,8)\n");
        s = s.write("    pushq $0\n");
        return CallOut { state: s, done: true };
    }
    // __set_field(obj, "field", val) — the desugar of
    // `obj.field = val`. Mirrors the field-READ shape dispatch:
    // for each struct decl declaring `field`, compare obj's
    // shape ptr and store val at the field's slot (idx+1)*8.
    if (name == "__set_field" && c.args.len() == 3) {
        var sf_field: string = "";
        match (c.args[1]) {
            parser.ExprString(sv) => { sf_field = sv.value; },
            _ => { }
        }
        s = emit_expr(c.args[0], s);   // obj
        s = emit_expr(c.args[2], s);   // val
        s = s.write("    popq %rdx\n");        // val
        s = s.write("    popq %rax\n");        // obj ptr
        var sf_end: asmcore.LabelOut = asmcore.fresh_label(s);
        s = sf_end.state;
        var sfdi: i32 = 0;
        while (sfdi < s.struct_decls.len()) {
            var sfsd: parser.StructDecl = s.struct_decls[sfdi];
            var sffi: i32 = 0;
            var sf_found: i32 = 0 - 1;
            while (sffi < sfsd.fields.len()) {
                if (sfsd.fields[sffi].name == sf_field) { sf_found = sffi; }
                sffi = sffi + 1;
            }
            if (sf_found >= 0) {
                var sf_next: asmcore.LabelOut = asmcore.fresh_label(s);
                s = sf_next.state;
                var sf_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, sfsd.name);
                s = sf_lit.state;
                s = s.write("    movq (%rax), %rcx\n");
                s = s.write("    leaq .S" + util.i32_to_string(sf_lit.idx) + "(%rip), %r8\n");
                s = s.write("    cmpq %r8, %rcx\n");
                s = s.write("    jne " + sf_next.name + "\n");
                s = s.write("    movq %rdx, " + util.i32_to_string((sf_found + 1) * 8) + "(%rax)\n");
                s = s.write("    jmp " + sf_end.name + "\n");
                s = s.write(sf_next.name + ":\n");
            }
