        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_argc: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_argv: .quad 0\n");
        s = s.write("    .section .text\n");
        s = s.write("__fern_arg_at:\n");
