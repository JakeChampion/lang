        // O_WRONLY|O_CREAT|O_TRUNC=577, 0644), writes the content bytes,
        // closes. Linux x86-64: openat=257, write=1, close=3.
        s = s.write(".globl __fern_write_file\n");
        s = s.write(".type __fern_write_file, @function\n");
        s = s.write("__fern_write_file:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // path data ptr (copy)
        s = s.write("    pushq %r12\n");           // content data ptr
        s = s.write("    pushq %r13\n");           // pathz / fd
        s = s.write("    pushq %r14\n");           // content len
        s = s.write("    pushq %r15\n");           // path len / bytes written
        // Capture content {data,len} before rsi is clobbered.
        s = s.write("    movq (%rsi), %r12\n");     // content data ptr
        s = s.write("    movq 8(%rsi), %r14\n");    // content len
        // NUL-terminate the path: copy len bytes into a len+1 buffer.
        s = s.write("    movq (%rdi), %rbx\n");     // path data ptr
        s = s.write("    movq 8(%rdi), %r15\n");    // path len
        s = s.write("    leaq 1(%r15), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // pathz
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lwf_copy:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Lwf_copydone\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%r13,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lwf_copy\n");
        s = s.write(".Lwf_copydone:\n");
        s = s.write("    movb $0, (%r13,%r15,1)\n"); // NUL terminator
        // openat(AT_FDCWD=-100, pathz, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq $577, %rdx\n");
        s = s.write("    movq $420, %r10\n");
        s = s.write("    movq $257, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lwf_err\n");
        s = s.write("    movq %rax, %r13\n");       // fd (pathz no longer needed)
        // write loop: r15 = bytes written so far.
        s = s.write("    movq $0, %r15\n");
        s = s.write(".Lwf_loop:\n");
        s = s.write("    cmpq %r14, %r15\n");
        s = s.write("    jge .Lwf_done\n");
        s = s.write("    movq %r13, %rdi\n");        // fd
        s = s.write("    leaq (%r12,%r15,1), %rsi\n"); // content data + written
        s = s.write("    movq %r14, %rdx\n");
