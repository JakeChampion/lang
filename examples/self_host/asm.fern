    // on any 8-byte-payload array.
    if (s.needs_arr_concat) {
        s = s.write("__fern_arr_concat:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");      // arr A
        s = s.write("    movq %rsi, %r13\n");      // arr B
        s = s.write("    movq (%r12), %r14\n");    // a_len
        s = s.write("    movq (%r13), %r15\n");    // b_len
