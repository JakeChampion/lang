// examples/self_host/asm.fern — first true codegen layer in the
// self-host port. Walks a parser.Module and emits AT&T x86_64
// assembly text. The emitted asm uses Linux syscall conventions
// (sys_exit_group = 60) and is assemble-able with
// `gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmpq + setcc
//   - Parenthesised grouping (handled implicitly via recursion)
//   - Unary `-`
//   - Control flow: if/else and while (forward-jump patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit_group
//
// The output programs are valid standalone Linux ELF binaries
// after `gcc -nostdlib -static <out>.s -o <out>`. A follow-up
// Go-side test could exec them and assert the exit code matches
// the lang-port's interp.fern on the same source — that would
// be a real "lang emits running native code" demo. For now the
// lang-side validation is substring assertions on the emitted
// text.
//
// Lowering shape — a textual stack machine. Each expr emits ops
// that leave its result on the rt-stack via push %rax:
//   literal n:  movq $n, %rax; pushq %rax
//   bin l op r: <emit l>; <emit r>; popq %rcx; popq %rax;
//               <op>; pushq %rax
// Statement `return <expr>;` emits the expr, then pops into %rdi
// and issues `sys_exit_group`. Same lowering the production
// codegen uses for the same shape — just typeset as text.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== TEXT HELPERS ====================

function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// base_type_name strips a generic argument list from a type spelling:
// `Box[i32]` / `Box[T]` → `Box`. Generics are erased, so the base name
// is what a struct value's runtime shape string carries and what the
// method-dispatch shape compare must match. A non-generic name is
// returned unchanged. (`91` is `[`.)
function base_type_name(t: string): string {
    var i: i32 = 0;
    while (i < t.len()) {
        if (t[i] == 91) { return t[0:i]; }
        i = i + 1;
    }
    return t;
}

// sanitize_label rewrites `.` to `__` so qualified-name
// function labels (e.g. `parser.parse_module`) emit a label
// like `__fn_parser__parse_module:` rather than the
// dot-in-symbol form that GNU as parses inconsistently.
function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < name.len()) {
        var b: i32 = name[i];
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

function digits_to_i32(s: string): i32 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// is_all_digits returns true iff `s` is non-empty and every
// byte is an ASCII digit. Used by ExprFieldAccess to detect
// tuple-style numeric field names (`.0`, `.1`, …) versus
// struct field names.
function is_all_digits(s: string): boolean {
    if (s.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// =================== FREE-VAR WALKER ====================
// Used by ExprLambda capture analysis. Same shape as the
// walker in vm.fern's #824.

function has_str(xs: string[], s: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.push(id.name); },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = collect_idents_expr(b.left, acc);
            return collect_idents_expr(b.right, acc);
        },
        parser.ExprUnary(u) => { return collect_idents_expr(u.operand, acc); },
        parser.ExprCall(c) => {
            acc = collect_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) {
                acc = collect_idents_expr(c.args[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = collect_idents_expr(a.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                acc = collect_idents_expr(t.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = collect_idents_expr(x.array, acc);
            return collect_idents_expr(x.index, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_idents_expr(sl.array, acc);
            acc = collect_idents_expr(sl.start, acc);
            return collect_idents_expr(sl.end, acc);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { acc = collect_idents_expr(sl.base, acc); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                acc = collect_idents_expr(sl.field_values[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return collect_idents_expr(fa.obj, acc); },
        parser.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                acc = collect_idents_stmt(lm.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_idents_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        // StmtDefer is eliminated by lower_defers before emit; here for
        // exhaustiveness, recursing defensively.
        parser.StmtDefer(d) => { return collect_idents_stmt(d.action, acc); },
        parser.StmtVar(v) => { return collect_idents_expr(v.init, acc); },
        parser.StmtReturn(r) => { return collect_idents_expr(r.value, acc); },
        parser.StmtExpr(e) => { return collect_idents_expr(e.value, acc); },
        parser.StmtIf(i) => {
            acc = collect_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_idents_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_idents_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_idents_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => { return collect_idents_expr(a.value, acc); },
        parser.StmtMatch(m) => {
            acc = collect_idents_expr(m.scrutinee, acc);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_idents_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_idents_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_bound_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtDefer(d) => { return collect_bound_stmt(d.action, acc); },
        parser.StmtVar(v) => { return acc.push(v.name); },
        parser.StmtReturn(_) => { return acc; },
        parser.StmtExpr(_) => { return acc; },
        parser.StmtIf(i) => {
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_bound_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_bound_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_bound_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(_) => { return acc; },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0) { acc = acc.push(pv.binding); }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_bound_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = acc.push(f.var_name);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_bound_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// lambda_captures returns the names that the lambda body
// reads and that resolve to a local in the OUTER scope (i.e.
// real captures). Params and body-bound names are subtracted;
// top-level function names are filtered by checking has_local.
function lambda_captures(lm: parser.ExprLambda, outer: EmitState): string[] {
    var refs: string[] = [];
    var bi: i32 = 0;
    while (bi < lm.body.len()) {
        refs = collect_idents_stmt(lm.body[bi], refs);
        bi = bi + 1;
    }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lm.params.len()) {
        bound = bound.push(lm.params[pi].name);
        pi = pi + 1;
    }
    var si: i32 = 0;
    while (si < lm.body.len()) {
        bound = collect_bound_stmt(lm.body[si], bound);
        si = si + 1;
    }
    var caps: string[] = [];
    var ri: i32 = 0;
    while (ri < refs.len()) {
        var nm: string = refs[ri];
        if (!has_str(bound, nm) && !has_str(caps, nm) && outer.has_local(nm)) {
            caps = caps.push(nm);
        }
        ri = ri + 1;
    }
    return caps;
}

// infer_expr_type returns a coarse type tag for an expression
// based on its syntactic shape + the current EmitState's
// local_types. Used by ExprBinary / ExprIndex / etc. to
// dispatch on operand types (e.g. string + string → concat,
// i32 + i32 → addq). Tag values:
//   "i32", "bool", "string", "array", "tuple", "struct",
//   "fn", "unknown".
function infer_expr_type(e: parser.Expr, s: EmitState): string {
    match (e) {
        parser.ExprNumber(n) => { if (n.is_float) { return "f64"; } return "i32"; },
        parser.ExprBool(_) => { return "bool"; },
        parser.ExprString(_) => { return "string"; },
        parser.ExprArray(a) => {
            // Element-type tracking: if the first element is
            // a string (or another array-of-string), tag the
            // whole array as "array_string" so indexing routes
            // string-aware dispatch. Empty arrays default to
            // plain "array"; the explicit `string[]` annotation
            // on a `var` declaration overrides.
            if (a.elements.len() == 0) { return "array"; }
            var et: string = infer_expr_type(a.elements[0], s);
            if (et == "string") { return "array_string"; }
            if (et == "i32" || et == "bool") { return "array_i32"; }
            return "array";
        },
        parser.ExprTuple(_) => { return "tuple"; },
        parser.ExprStructLit(_) => { return "struct"; },
        parser.ExprLambda(lm) => {
            // Encode the return type in the tag so a later
            // `f()` call site can recover it from the local's
            // recorded type. The closure-box itself is just an
            // 8-byte pointer regardless of return shape, so
            // capture / call machinery is unaffected; this is
            // purely for the type-aware dispatch on the result
            // (e.g. `print(f())` needs to know the result is a
            // string to route through `__fern_print_str`).
            return "fn_" + ret_tag_of(lm.ret_type);
        },
        parser.ExprIdent(id) => {
            if (id.name == "None") { return "option:unknown"; }
            if (s.has_local(id.name)) { return s.local_type_of(id.name); }
            // A bare ident may name a zero-arg function (a `const`);
            // report its return type so const-typed exprs dispatch.
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    return ret_tag_of(s.funcs[cfi].ret_type);
                }
                cfi = cfi + 1;
            }
            return s.local_type_of(id.name);
        },
        parser.ExprBinary(b) => {
            // `+` propagates string when either side is string
            // (string + string → string concat). Comparisons
            // and logical ops return bool. Other arithmetic
            // returns i32.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">="
                    || b.op == "==" || b.op == "!=" || b.op == "&&" || b.op == "||") {
                return "bool";
            }
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") { return "string"; }
                if (lt == "f64" || rt == "f64") { return "f64"; }
                return "i32";
            }
            return "i32";
        },
        parser.ExprUnary(u) => {
            if (u.op == "!") { return "bool"; }
            if (u.op == "-") { return infer_expr_type(u.operand, s); }
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ct: string = u.op[3:u.op.len()];
                if (ct == "f64" || ct == "f32" || ct == "float") { return "f64"; }
                return "i32";
            }
            return "i32";
        },
        parser.ExprCall(c) => {
            // `len(_)` always returns i32. Plain calls look up
            // the FuncDecl.ret_type. Method calls on primitive
            // receivers also resolve via the FuncDecl table —
            // for struct receivers the shape can vary at
            // runtime, so we keep those as "unknown".
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (id.name == "Some" && c.args.len() == 1) {
                        return "option:" + infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "Ok" && c.args.len() == 1) {
                        return "result:" + infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "Err" && c.args.len() == 1) { return "result:unknown"; }
                    if (id.name == "read_file") { return "result:string"; }
                    if (id.name == "write_file") { return "option:unknown"; }
                    // now_unix_ms / monotonic_ns return i64. The self-host
                    // has no distinct i64 tag — all integers live in 64-bit
                    // rax slots and compare via cmpq — so "i32" routes them
                    // through the integer path without truncation.
                    if (id.name == "now_unix_ms") { return "i32"; }
                    if (id.name == "monotonic_ns") { return "i32"; }
                    // sleep_ms / remove_file: void / Option[IoError].
                    // Float bit-reinterpret: f64<->i64 passes through
                    // (the rt-stack already holds the bit pattern);
                    // f32<->i32 narrows / widens via SSE.
                    if (id.name == "sleep_ms") { return "i32"; }
                    if (id.name == "remove_file") { return "option:unknown"; }
                    // subprocess(cmd, args, stdin) → ProcessResult struct.
                    // Field access on the result dispatches through the
                    // shape-pointer path (struct_decl entry injected by
                    // parser.inject_builtin_enums), so "unknown" here
                    // is fine — the tag carries no info field-access
                    // would need.
                    if (id.name == "subprocess") { return "unknown"; }
                    if (id.name == "f64_bits" || id.name == "f32_bits") { return "i32"; }
                    if (id.name == "f64_from_bits" || id.name == "f32_from_bits") { return "f64"; }
                    // env(name): Option[string] — Some(value) if the
                    // variable is set (including empty), None otherwise.
                    if (id.name == "env") { return "option:string"; }
                    // Filesystem builtins. temp_dir → Result[string];
                    // read_dir → Result[string[]]; stat → Result[FileStat]
                    // (payload struct, handled by shape dispatch);
                    // remove_dir_all → Option[IoError].
                    if (id.name == "temp_dir") { return "result:string"; }
                    if (id.name == "read_dir") { return "result:array_string"; }
                    if (id.name == "stat") { return "result:unknown"; }
                    if (id.name == "remove_dir_all") { return "option:unknown"; }
                    if (id.name == "len") { return "i32"; }
                    if (id.name == "read_int") { return "i32"; }
                    if (id.name == "read_line") { return "string"; }
                    if (id.name == "read_all_stdin") { return "string"; }
                    if (id.name == "i32_to_string") { return "string"; }
                    if (id.name == "int__int_to_string") { return "string"; }
                    if (id.name == "str_to_i32") { return "i32"; }
                    if (id.name == "str_starts_with") { return "bool"; }
                    if (id.name == "str_ends_with") { return "bool"; }
                    if (id.name == "str_contains") { return "bool"; }
                    if (id.name == "str_index_of") { return "i32"; }
                    if (id.name == "str_trim") { return "string"; }
                    if (id.name == "str_to_upper") { return "string"; }
                    if (id.name == "str_to_lower") { return "string"; }
                    if (id.name == "str_repeat") { return "string"; }
                    if (id.name == "str_replace") { return "string"; }
                    if (id.name == "chr") { return "string"; }
                    if (id.name == "exit") { return "i32"; }
                    if (id.name == "args_count") { return "i32"; }
                    if (id.name == "arg_at") { return "string"; }
                    if (id.name == "args") { return "array_string"; }
                    if (id.name == "__alloc_u8") { return "array_i32"; }
                    if (id.name == "string_from_bytes") { return "string"; }
                    if (id.name == "random_bytes") { return "string"; }
                    if (id.name == "map_new") { return "map"; }
                    if (id.name == "map_new_i32") { return "mapI:unknown"; }
                    if (id.name == "__abs_f64" || id.name == "__sqrt_f64"
                            || id.name == "__floor_f64" || id.name == "__ceil_f64"
                            || id.name == "__trunc_f64" || id.name == "__round_f64"
                            || id.name == "__sin_f64" || id.name == "__cos_f64"
                            || id.name == "__exp_f64" || id.name == "__log_f64"
                            || id.name == "__pow_f64") {
                        return "f64";
                    }
                    if (id.name == "str_split") { return "array_string"; }
                    // Local-callee path: when `f()` invokes a
                    // local var that was bound to a lambda, its
                    // recorded type is `fn_<ret>` (see the
                    // ExprLambda match arm above). Strip the
                    // prefix so downstream dispatch (`print(f())`,
                    // string concat, etc.) sees the actual return
                    // type rather than `"unknown"`.
                    if (s.has_local(id.name)) {
                        var lt: string = s.local_type_of(id.name);
                        if (lt == "fn_string") { return "string"; }
                        if (lt == "fn_i32") { return "i32"; }
                        if (lt == "fn_bool") { return "bool"; }
                        if (lt == "fn_array_string") { return "array_string"; }
                        if (lt == "fn_array_i32") { return "array_i32"; }
                    }
                    // Plain function call: look up ret_type.
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            return ret_tag_of(s.funcs[fi].ret_type);
                        }
                        fi = fi + 1;
                    }
                    return "unknown";
                },
                parser.ExprFieldAccess(fa) => {
                    // Method call: only inferable when the
                    // receiver has a known primitive type (so
                    // we can find a single FuncDecl that
                    // matches name + receiver_type).
                    var rt: string = infer_expr_type(fa.obj, s);
                    if (fa.field == "read_chunk") { return "option:string"; }
                    if (is_map(rt) && fa.field == "get") {
                        return "option:" + map_value_part(rt);
                    }
                    if (is_map(rt) && fa.field == "get_or") {
                        return map_value_part(rt);
                    }
                    if (is_map(rt) && fa.field == "set") { return rt; }
                    if (is_map(rt) && fa.field == "has") { return "bool"; }
                    if (is_map(rt) && fa.field == "len") { return "i32"; }
                    if (is_map(rt) && fa.field == "keys") {
                        if (map_key_is_i32(rt)) { return "array_i32"; }
                        return "array_string";
                    }
                    if (is_map(rt) && fa.field == "values") {
                        var vt: string = map_value_part(rt);
                        if (vt == "i32") { return "array_i32"; }
                        if (vt == "string") { return "array_string"; }
                        return "array";
                    }
                    if (is_map(rt) && fa.field == "iter") {
                        return "mapiter:" + map_value_part(rt);
                    }
                    if (is_mapiter(rt) && fa.field == "has_next") { return "bool"; }
                    if (is_mapiter(rt) && fa.field == "key") { return "string"; }
                    if (is_mapiter(rt) && fa.field == "value") { return rt[8:rt.len()]; }
                    if ((is_int_tag(rt) || rt == "string") && fa.field == "to_string") {
                        return "string";
                    }
                    if ((rt == "f64" || rt == "f32" || rt == "float") && fa.field == "to_string") {
                        return "string";
                    }
                    if (rt == "i32" && (fa.field == "abs" || fa.field == "min" || fa.field == "max" || fa.field == "clamp" || fa.field == "pow" || fa.field == "sign" || fa.field == "to_lower" || fa.field == "to_upper" || fa.field == "gcd" || fa.field == "lcm")) {
                        return "i32";
                    }
                    if (rt == "i32" && fa.field == "to_ascii_string") {
                        return "string";
                    }
                    if (rt == "i32" && (fa.field == "is_even" || fa.field == "is_odd" || fa.field == "is_zero" || fa.field == "is_positive" || fa.field == "is_negative" || fa.field == "is_digit" || fa.field == "is_alpha" || fa.field == "is_letter" || fa.field == "is_alnum" || fa.field == "is_lower" || fa.field == "is_upper" || fa.field == "is_hex_digit")) {
                        return "bool";
                    }
                    if (fa.field == "len"
                            && (rt == "string" || is_int_array_tag(rt) || rt == "array_string" || rt == "array")) {
                        return "i32";
                    }
                    if (fa.field == "is_empty"
                            && (rt == "string" || is_int_array_tag(rt) || rt == "array_string" || rt == "array")) {
                        return "bool";
                    }
                    // `.push(x)` / `.reverse()` / `.concat(b)` return the same array type.
                    if ((fa.field == "push" || fa.field == "reverse" || fa.field == "concat")
                            && (is_int_array_tag(rt) || rt == "array_string" || rt == "array")) {
                        return rt;
                    }
                    // `.first()` / `.last()` return the element type.
                    if ((fa.field == "first" || fa.field == "last")
                            && (is_int_array_tag(rt) || rt == "array_string")) {
                        if (rt == "array_i32") { return "i32"; }
                        if (rt == "array_u32") { return "u32"; }
                        if (rt == "array_u64") { return "u64"; }
                        if (rt == "array_i64") { return "i64"; }
                        return "string";
                    }
                    // i32/string-array search methods.
                    if (rt == "array_i32" || rt == "array_string") {
                        if (fa.field == "index_of") { return "i32"; }
                        if (fa.field == "contains") { return "bool"; }
                    }
                    if (rt == "array_i32"
                            && (fa.field == "sum" || fa.field == "product")) {
                        return "i32";
                    }
                    // `.min()` / `.max()` on an i32 array → Option[i32]
                    // (None on empty); the Some payload binds as i32 via
                    // match_payload_type.
                    if (rt == "array_i32" && (fa.field == "min" || fa.field == "max")) {
                        return "option:i32";
                    }
                    if (rt == "array_string" && fa.field == "join") {
                        return "string";
                    }
                    // String methods that mirror existing builtins.
                    if (rt == "string") {
                        if (fa.field == "split") { return "array_string"; }
                        if (fa.field == "chars") { return "array_string"; }
                        if (fa.field == "lines") { return "array_string"; }
                        if (fa.field == "bytes") { return "array_i32"; }
                        if (fa.field == "as_bytes") { return "array_i32"; }
                        if (fa.field == "reverse") { return "string"; }
                        if (fa.field == "first_byte" || fa.field == "last_byte") { return "i32"; }
                        if (fa.field == "contains") { return "bool"; }
                        if (fa.field == "starts_with") { return "bool"; }
                        if (fa.field == "ends_with") { return "bool"; }
                        if (fa.field == "index_of") { return "i32"; }
                        if (fa.field == "trim") { return "string"; }
                        if (fa.field == "to_upper") { return "string"; }
                        if (fa.field == "to_lower") { return "string"; }
                        if (fa.field == "repeat") { return "string"; }
                        if (fa.field == "replace") { return "string"; }
                    }
                    if (rt == "string" || rt == "i32" || rt == "bool" || rt == "f64") {
                        var mi: i32 = 0;
                        while (mi < s.funcs.len()) {
                            if (s.funcs[mi].name == fa.field && s.funcs[mi].receiver_type == rt) {
                                return ret_tag_of(s.funcs[mi].ret_type);
                            }
                            mi = mi + 1;
                        }
                    }
                    // Method call on a struct (or otherwise non-
                    // primitive) receiver: the coarse receiver tag
                    // ("struct") loses the struct name, so resolve by
                    // method name alone — find any function with this
                    // name and a non-empty receiver type, return its
                    // result tag. First match wins; method names are
                    // effectively unique in the self-host sources.
                    // Without this, `(obj.method()).len()` /
                    // `obj.method()[i]` mis-dispatch (the receiver
                    // infers "unknown"); parser.fern's struct-literal
                    // look-ahead `(look.peek_ident()).len()` is
                    // exactly this shape, so the self-hosted parser
                    // mis-parsed every struct literal without it.
                    var mj: i32 = 0;
                    while (mj < s.funcs.len()) {
                        if (s.funcs[mj].name == fa.field && s.funcs[mj].receiver_type.len() > 0) {
                            return ret_tag_of(s.funcs[mj].ret_type);
                        }
                        mj = mj + 1;
                    }
                    return "unknown";
                },
                _ => { return "unknown"; }
            }
            return "unknown";
        },
        parser.ExprIndex(x) => {
            // Container type drives element type:
            //   string → "i32" (byte)
            //   array_string → "string"
            //   array_u64 → "u64" (so element compares pick unsigned)
            //   array_u32 → "u32"; array_i64 → "i64"; else → "i32"
            var at: string = infer_expr_type(x.array, s);
            if (at == "string") { return "i32"; }
            if (at == "array_string") { return "string"; }
            if (at == "array_u64") { return "u64"; }
            if (at == "array_u32") { return "u32"; }
            if (at == "array_i64") { return "i64"; }
            return "i32";
        },
        parser.ExprSlice(sl) => {
            // Slice preserves the container type.
            var at: string = infer_expr_type(sl.array, s);
            return at;
        },
        parser.ExprFieldAccess(fa) => {
            // Bare struct-field read (`x.s`). When the receiver's type
            // is a known struct NAME (e.g. a match-bound variant
            // payload `VString(s) => s.v`), resolve the field WITHIN
            // that struct — disambiguating fields shared across union
            // variants (interp's VInt/VString/VFloat all have `v`).
            // Otherwise fall back to the first-match field scan.
            var frt: string = infer_expr_type(fa.obj, s);
            var di: i32 = 0;
            while (di < s.struct_decls.len()) {
                if (s.struct_decls[di].name == frt) {
                    return field_type_tag_in(frt, fa.field, s);
                }
                di = di + 1;
            }
            return field_type_tag(fa.field, s);
        },
        parser.ExprUnknown(_) => { return "unknown"; }
    }
    return "unknown";
}

// match_payload_type infers the type tag of an Option/Result payload
// binding (Some(x) / Ok(x)) from the match scrutinee: read_chunk /
// read_file / read_all_stdin → string; a literal Some(e)/Ok(e) → the
// type of e; otherwise unknown (so an i32 payload isn't wrongly typed
// "string", which would route arithmetic through string concat).
function match_payload_type(scrut: parser.Expr, s: EmitState): string {
    match (scrut) {
        parser.ExprIdent(id) => {
            // Scrutinee is a local — recover the wrapped payload tag
            // from its declared/inferred type. `option:T` / `result:T`
            // expose T directly; everything else (and absent locals)
            // falls back to "unknown" so we don't mis-tag.
            if (s.has_local(id.name)) {
                var lt: string = s.local_type_of(id.name);
                if (lt.len() >= 7 && lt[0:7] == "option:") { return lt[7 : lt.len()]; }
                if (lt.len() >= 7 && lt[0:7] == "result:") { return lt[7 : lt.len()]; }
            }
            return "unknown";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
                        return infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "read_file" || id.name == "read_all_stdin") { return "string"; }
                    if (id.name == "temp_dir") { return "string"; }
                    if (id.name == "read_dir") { return "array_string"; }
                    // Arbitrary free / module function returning
                    // Option[T] or Result[T, …] — split the declared
                    // ret_type to get T. Without this, scrutinees like
                    // `match (test.assert_is_some_i32(...)) { Some(msg)
                    // … }` bind `msg` as "unknown" and a downstream
                    // `msg.contains(...)` mis-dispatches.
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            var rt: string = s.funcs[fi].ret_type;
                            if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == 93) {
                                return ret_tag_of(rt[7 : rt.len() - 1]);
                            }
                            if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                // Result[T, E] — first generic arg is the
                                // Ok payload; split on the top-level
                                // comma so a nested Map[K, V] doesn't
                                // mislead. (Reuses split_tuple_ret's
                                // depth-tracking shape by stripping the
                                // outer `[]` and pretending it's a tuple.)
                                var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                return split_tuple_ret(inner).a;
                            }
                            return "unknown";
                        }
                        fi = fi + 1;
                    }
                    return "unknown";
                },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "read_chunk") { return "string"; }
                    if (fa.field == "get") {
                        var rt: string = infer_expr_type(fa.obj, s);
                        if (is_map(rt)) { return map_value_part(rt); }
                    }
                    // `arr.min()` / `arr.max()` on an i32 array →
                    // Option[i32]; the payload is i32.
                    if (fa.field == "min" || fa.field == "max") {
                        if (infer_expr_type(fa.obj, s) == "array_i32") { return "i32"; }
                    }
                    // Receiver method call: look up the FuncDecl whose
                    // receiver matches the obj's type tag and method
                    // name matches the field. If its ret_type is
                    // Option[T] / Result[T, …], return T. Without this
                    // `match s.parse_int() { Some(got) … }` binds got as
                    // "unknown" and got.to_string() mis-dispatches.
                    var rcv: string = infer_expr_type(fa.obj, s);
                    if (rcv.len() > 0) {
                        var fi: i32 = 0;
                        while (fi < s.funcs.len()) {
                            if (s.funcs[fi].name == fa.field && s.funcs[fi].receiver_type == rcv) {
                                var rt: string = s.funcs[fi].ret_type;
                                if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == 93) {
                                    return ret_tag_of(rt[7 : rt.len() - 1]);
                                }
                                if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                    var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                    return split_tuple_ret(inner).a;
                                }
                                return "unknown";
                            }
                            fi = fi + 1;
                        }
                    }
                    return "unknown";
                },
                _ => { return "unknown"; }
            }
        },
        _ => { return "unknown"; }
    }
    return "unknown";
}

// ret_tag_of maps a parser-side type name string to one of
// the infer_expr_type tag values. Unknown shapes (struct
// names, generics, etc.) fall through to "unknown".
function ret_tag_of(name: string): string {
    if (name == "i32") { return "i32"; }
    // Wider / unsigned integer scalars get their own tags so the
    // comparison emit can pick signed vs unsigned set instructions.
    // Method dispatch (.to_string / .abs / .min etc.) goes through
    // is_int_tag below, which accepts every integer tag — so the
    // i32 codegen path still services all of them.
    if (name == "u32") { return "u32"; }
    if (name == "u64") { return "u64"; }
    if (name == "i64") { return "i64"; }
    if (name == "usize") { return "usize"; }
    if (name == "isize") { return "isize"; }
    if (name == "u32[]") { return "array_u32"; }
    if (name == "u64[]") { return "array_u64"; }
    if (name == "i64[]") { return "array_i64"; }
    if (name == "f64" || name == "f32" || name == "float") { return "f64"; }
    if (name == "bool" || name == "boolean") { return "bool"; }
    if (name == "string") { return "string"; }
    if (name == "string[]") { return "array_string"; }
    if (name == "i32[]") { return "array_i32"; }
    if (name == "bool[]" || name == "boolean[]") { return "array_i32"; }
    if (name.len() >= 8 && name[0:8] == "MapIter[") {
        // MapIter[K, V] → "mapiter:<value-tag>" so `.value()` infers V.
        return "mapiter:" + generic_value_tag(name, 8);
    }
    if (name.len() >= 4 && name[0:4] == "Map[") {
        // Carry the value type into the tag ("map:<value-tag>") so
        // `m.get(k)` payloads infer correctly (e.g. string[] → array
        // push/len rather than the string default). i32-keyed maps
        // tag as "mapI:<V>" so dispatch picks integer key comparison.
        if (generic_key_tag(name, 4) == "i32") {
            return "mapI:" + generic_value_tag(name, 4);
        }
        return "map:" + generic_value_tag(name, 4);
    }
    if (name.len() >= 3 && name[0:3] == "Map") { return "map:unknown"; }
    // Option[T] / Result[T, E] → first-class wrapper tags. Must precede
    // the trailing-`]` → "array" fallback below (both end in `]`). The
    // payload of Result is left "unknown" — the checker only compares the
    // wrapper-ness, never the error arm.
    if (name.len() >= 8 && name[0:7] == "Option[") {
        return "option:" + ret_tag_of(name[7:name.len() - 1]);
    }
    if (name.len() >= 8 && name[0:7] == "Result[") {
        // Result[T, E] — preserve the Ok payload tag so `match (r)
        // { Ok(v) => … }` knows v's type. Wrap in parens and reuse
        // split_tuple_ret's bracket-depth-aware split, then prefix
        // "result:" so existing is_result() checks still match.
        var inner: string = "(" + name[7 : name.len() - 1] + ")";
        return "result:" + split_tuple_ret(inner).a;
    }
    if (name.len() > 0 && name[name.len() - 1] == 93) {
        // Trailing `]` → other `T[]` shapes (struct[] etc.)
        // or Map[..]. Treat as plain array.
        return "array";
    }
    return "unknown";
}

// TwoTags carries the inferred element type tags of a
// two-element tuple-destructure binding.
struct TwoTags { a: string, b: string }

// split_tuple_ret splits a reconstructed tuple type string
// "(A, B)" into the type tags of its first two elements
// (ret_tag_of each), tracking bracket / paren depth so a comma
// inside `Map[K, V]` or a nested tuple doesn't split early.
// Non-tuple input (or a tuple with no top-level comma) falls
// back to ("i32", "i32") — the historical default for
// tuple-destructure bindings.
function split_tuple_ret(tt: string): TwoTags {
    if (tt.len() < 3 || tt[0] != 40) { return TwoTags { a: "i32", b: "i32" }; }
    var inner: string = tt[1 : tt.len() - 1];                    // drop outer ( )
    var depth: i32 = 0;
    var i: i32 = 0;
    var split_at: i32 = 0 - 1;
    while (i < inner.len()) {
        var ch: i32 = inner[i];
        if (ch == 91 || ch == 40) { depth = depth + 1; }
        else if (ch == 93 || ch == 41) { depth = depth - 1; }
        else if (ch == 44 && depth == 0 && split_at < 0) { split_at = i; }
        i = i + 1;
    }
    if (split_at < 0) { return TwoTags { a: "i32", b: "i32" }; }
    var a: string = inner[0 : split_at];
    var bstart: i32 = split_at + 1;
    if (bstart < inner.len() && inner[bstart] == 32) { bstart = bstart + 1; }  // skip ", " space
    var b: string = inner[bstart : inner.len()];
    return TwoTags { a: ret_tag_of(a), b: ret_tag_of(b) };
}

// tuple_destructure_tags infers the element type tags for a
// `var (a, b) = init` binding. A tuple literal infers each item
// directly; a call to a free function whose return type is a
// reconstructed `(A, B)` tuple is split via split_tuple_ret.
// Everything else falls back to ("i32", "i32"). Binding the
// precise tag (rather than blindly "i32") is what lets a
// struct-typed element's receiver methods dispatch through the
// runtime shape-pointer path instead of mis-mangling as
// `__fn_i32__<method>`.
function tuple_destructure_tags(init: parser.Expr, s: EmitState): TwoTags {
    match (init) {
        parser.ExprTuple(t) => {
            if (t.elements.len() >= 2) {
                return TwoTags { a: infer_expr_type(t.elements[0], s), b: infer_expr_type(t.elements[1], s) };
            }
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            return split_tuple_ret(s.funcs[fi].ret_type);
                        }
                        fi = fi + 1;
                    }
                },
                _ => { }
            }
        },
        _ => { }
    }
    return TwoTags { a: "i32", b: "i32" };
}

// is_int_tag accepts every integer-shaped type tag — i32 / i64 /
// u32 / u64 / usize / isize — so method-dispatch sites that used
// to check `tag == "i32"` keep accepting wider/unsigned values.
function is_int_tag(t: string): boolean {
    return t == "i32" || t == "u32" || t == "u64" || t == "i64"
        || t == "usize" || t == "isize";
}

// is_int_array_tag — same idea for arrays of integers.
function is_int_array_tag(t: string): boolean {
    return t == "array_i32" || t == "array_u32" || t == "array_u64"
        || t == "array_i64";
}

// is_unsigned_tag picks out the tags whose values need unsigned
// compare semantics (setb/setbe/seta/setae instead of setl/le/g/ge).
function is_unsigned_tag(t: string): boolean {
    return t == "u32" || t == "u64" || t == "usize";
}

// is_unsigned_int_array_tag — array element type is unsigned.
function is_unsigned_int_array_tag(t: string): boolean {
    return t == "array_u32" || t == "array_u64";
}

// generic_key_tag extracts the key-type tag from a `Map[K, V]` type
// name (the part before the first ", "); `start` is past the `[`.
function generic_key_tag(name: string, start: i32): string {
    if (name.len() <= start + 1) { return "unknown"; }
    var inner: string = name[start : name.len() - 1];
    var i: i32 = 0;
    while (i + 1 < inner.len()) {
        if (inner[i] == 44 && inner[i + 1] == 32) {
            return ret_tag_of(inner[0 : i]);
        }
        i = i + 1;
    }
    return "unknown";
}

// is_mapiter reports whether a tag denotes a Map iterator
// ("mapiter:<value-tag>"). Distinct from is_map, which excludes it.
function is_mapiter(t: string): boolean {
    return t.len() >= 8 && t[0:8] == "mapiter:";
}

// is_map reports whether a type tag denotes a Map: "map",
// "map:<V>" (string key), or "mapI:<V>" (i32 key). Excludes
// "mapiter:" (the iterator tag).
function is_map(t: string): boolean {
    return t == "map" || (t.len() >= 4 && t[0:4] == "map:")
        || (t.len() >= 5 && t[0:5] == "mapI:");
}

// map_key_is_i32 reports whether a Map tag denotes integer keys
// ("mapI:<V>") — selects integer key comparison in dispatch.
function map_key_is_i32(t: string): boolean {
    return t.len() >= 5 && t[0:5] == "mapI:";
}

// map_value_part returns the value-type tag carried by a Map tag,
// handling both the "map:<V>" and "mapI:<V>" forms.
function map_value_part(t: string): string {
    if (t.len() >= 5 && t[0:5] == "mapI:") { return t[5 : t.len()]; }
    if (t.len() >= 4 && t[0:4] == "map:") { return t[4 : t.len()]; }
    return "unknown";
}

// is_enum_variant reports whether `name` is a payload-bearing enum
// variant — a synthesized struct carrying the marker field "__ev"
// (see parser.fern parse_enum_decl). Such variants construct/match
// with a single payload at offset 8 rather than binding the whole
// struct (the `type X = A|B` union-member behaviour).
function is_enum_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == "__ev") { return true; }
                fi = fi + 1;
            }
            return false;
        }
        di = di + 1;
    }
    return false;
}

// is_unit_variant reports whether `name` is a registered zero-field
// struct — i.e. a no-payload enum variant (`JNull`). Used to construct
// the variant value from a bare identifier. (`type X = A|B` members are
// always real multi-field structs, so a zero-field struct only arises
// from an enum no-payload variant.)
function is_unit_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            return s.struct_decls[di].fields.len() == 0;
        }
        di = di + 1;
    }
    return false;
}

// generic_value_tag extracts the value-type tag from a `Map[K, V]` /
// `MapIter[K, V]` type name, e.g. "Map[string, string[]]" →
// "array_string". `start` is the index past the opening `[`. Splits at
// the first ", " (the K/V separator); everything after is the value.
function generic_value_tag(name: string, start: i32): string {
    if (name.len() <= start + 1) { return "unknown"; }
    var inner: string = name[start : name.len() - 1];
    var i: i32 = 0;
    while (i + 1 < inner.len()) {
        if (inner[i] == 44 && inner[i + 1] == 32) {
            return ret_tag_of(inner[i + 2 : inner.len()]);
        }
        i = i + 1;
    }
    return "unknown";
}

// field_type_tag infers the type tag of a struct-field read (`x.s`)
// by finding a struct decl that declares a field of that name and
// mapping its declared type. The emit side dispatches field reads by
// runtime shape so it never needs the static struct, but infer does
// — without this, `x.s` came back "unknown", so `x.s[i]` mis-took
// the array path and `x.s.len()` misfired (fatal for any struct with
// a string / array field, e.g. the lexer's `Lex { src: string, … }`).
// First match wins; field names are effectively unique per type in
// the self-host sources.
// field_type_tag_in resolves a field's type tag within a SPECIFIC
// named struct (used when the receiver's struct type is known).
function field_type_tag_in(struct_name: string, field: string, s: EmitState): string {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == struct_name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == field) {
                    return ret_tag_of(sd.fields[fi].type_name);
                }
                fi = fi + 1;
            }
            return "unknown";
        }
        di = di + 1;
    }
    return "unknown";
}

function field_type_tag(field: string, s: EmitState): string {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        var sd: parser.StructDecl = s.struct_decls[di];
        var fi: i32 = 0;
        while (fi < sd.fields.len()) {
            if (sd.fields[fi].name == field) {
                return ret_tag_of(sd.fields[fi].type_name);
            }
            fi = fi + 1;
        }
        di = di + 1;
    }
    return "unknown";
}

// =================== EMIT STATE ====================

// EmitState bundles the running output text, a monotonic label
// counter, the active locals table, an `in_function` flag, and
// a pool of string literals that get materialised in `.rodata`
// at the end of emit. Threaded by value through every emit_*
// call — each return produces a fresh EmitState with the
// appended text and (where relevant) updated counters /
// locals / literals.
pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    needs_print_int: boolean,
    needs_read_int: boolean,
    needs_heap: boolean,
    // struct_decls: the module's struct decls — used by
    // ExprStructLit + ExprFieldAccess to look up field
    // layout. Seeded from mod.structs at the start of
    // emit_module.
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: stacks of jump
    // targets for break + continue inside the currently-active
    // loops. Pushed when entering a StmtWhile / StmtFor body,
    // popped on the way out. break uses the top of
    // loop_exit_labels; continue uses the top of
    // loop_cont_labels (which for `for` points at the index-
    // increment block, NOT the top of the loop).
    loop_exit_labels: string[],
    loop_cont_labels: string[],
    // funcs: the module's FuncDecls — used by ExprCall on an
    // ExprFieldAccess callee (method call) to find every
    // struct that has a matching method, so the dispatch
    // chain can emit a shape-compare arm per matching struct.
    funcs: parser.FuncDecl[],
    // local_types: parallel to local_names — the inferred
    // type of each local, populated at StmtVar binding time
    // via infer_expr_type. Used by ExprBinary("+") / ExprIndex
    // / `len()` etc. to dispatch on operand types (string vs
    // i32 vs array). Tag values: "i32", "bool", "string",
    // "array", "tuple", "struct", "fn", "unknown".
    local_types: string[],
    // needs_str_*: lazy-emit flags for the string runtime
    // helpers (set by emit_expr when the helpers are
    // referenced; checked at the end of emit_module).
    needs_str_concat: boolean,
    needs_str_eq: boolean,
    needs_str_print: boolean,
    needs_str_cmp: boolean,
    needs_str_read_line: boolean,
    needs_i32_to_string: boolean,
    needs_str_to_i32: boolean,
    needs_eprint: boolean,
    needs_str_search: boolean,
    needs_args: boolean,
    needs_arr_push: boolean,
    needs_arr_slice: boolean,
    needs_arr_i32_index_of: boolean,
    needs_arr_reverse: boolean,
    needs_arr_concat: boolean,
    needs_arr_str_index_of: boolean,
    needs_arr_str_join: boolean,
    needs_arr_i32_sum: boolean,
    needs_arr_i32_min_max: boolean,
    needs_arr_i32_product: boolean,
    needs_str_chars: boolean,
    needs_str_bytes: boolean,
    needs_str_reverse: boolean,
    needs_i32_pow: boolean
}

function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    var fns: parser.FuncDecl[] = [];
    var lts: string[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needs_print_int: false,
        needs_read_int: false,
        needs_heap: false,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn,
        funcs: fns,
        local_types: lts,
        needs_str_concat: false,
        needs_str_eq: false,
        needs_str_print: false,
        needs_str_cmp: false,
        needs_str_read_line: false,
        needs_i32_to_string: false,
        needs_str_to_i32: false,
        needs_eprint: false,
        needs_str_search: false,
        needs_args: false,
        needs_arr_push: false,
        needs_arr_slice: false,
        needs_arr_i32_index_of: false,
        needs_arr_reverse: false,
        needs_arr_concat: false,
        needs_arr_str_index_of: false,
        needs_arr_str_join: false,
        needs_arr_i32_sum: false,
        needs_arr_i32_min_max: false,
        needs_arr_i32_product: false,
        needs_str_chars: false,
        needs_str_bytes: false,
        needs_str_reverse: false,
        needs_i32_pow: false
    };
}

function (s: EmitState) write(text: string): EmitState {
    // O(N) amortised: route through the global strbuf primitive
    // instead of `s.out + text` (which is O(N²) — fatal for self-
    // hosting). The .out field stays "" through the build; the
    // accumulated bytes live in the strbuf until emit_module's
    // tail calls strbuf_take to materialise the final string.
    strbuf_append(text);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) bind_local(name: string): EmitState {
    return s.bind_local_typed(name, "unknown");
}

function (s: EmitState) bind_local_typed(name: string, ty: string): EmitState {
    var ln: string[] = s.local_names.push(name);
    var lts: string[] = s.local_types.push(ty);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: lts,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) local_type_of(name: string): string {
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) { return s.local_types[i]; }
        i = i - 1;
    }
    return "unknown";
}

function (s: EmitState) reset_locals(): EmitState {
    var ln: string[] = [];
    var lts: string[] = [];
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: lts,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) enter_function(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: true,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) push_loop_labels(exit_lbl: string, cont_lbl: string): EmitState {
    var nex: string[] = s.loop_exit_labels.push(exit_lbl);
    var ncn: string[] = s.loop_cont_labels.push(cont_lbl);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: nex,
        loop_cont_labels: ncn,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) pop_loop_labels(): EmitState {
    var nex: string[] = [];
    var ncn: string[] = [];
    var i: i32 = 0;
    while (i < s.loop_exit_labels.len() - 1) {
        nex = nex.push(s.loop_exit_labels[i]);
        ncn = ncn.push(s.loop_cont_labels[i]);
        i = i + 1;
    }
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: nex,
        loop_cont_labels: ncn,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) top_loop_exit(): string {
    if (s.loop_exit_labels.len() == 0) { return ""; }
    return s.loop_exit_labels[s.loop_exit_labels.len() - 1];
}

function (s: EmitState) top_loop_cont(): string {
    if (s.loop_cont_labels.len() == 0) { return ""; }
    return s.loop_cont_labels[s.loop_cont_labels.len() - 1];
}

function (s: EmitState) leave_function(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: false,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

// mark_print_int flips the "this module needs the print_int
// helper" flag. emit_module checks it after the body emit and
// appends the __fern_print_int label + body if true.
function (s: EmitState) mark_print_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: true,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

// mark_heap flips the "this module needs the heap allocator"
// flag. emit_module checks it after the body emit and appends
// the `__fern_heap_ptr` bump-pointer + `__fern_alloc` helper
// when true. Used by struct literals + array literals once the
// asm backend grows real heap-backed value codegen.
function (s: EmitState) mark_heap(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: true,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
