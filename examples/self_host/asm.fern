        s = s.write("    movq $4, %rcx\n");
        s = s.write("    jmp .Larr_push_cap\n");
        s = s.write(".Larr_push_dbl:\n");
        s = s.write("    shlq $1, %rcx\n");
        s = s.write(".Larr_push_cap:\n");
        s = s.write("    movq %rcx, %r15\n");        // r15 = newcap
        s = s.write("    addq $2, %rcx\n");
        s = s.write("    shlq $3, %rcx\n");
        s = s.write("    movq %rcx, %rdi\n");
        s = s.write("    call __fern_alloc\n");      // base in %rax
        s = s.write("    movq %r15, (%rax)\n");      // cap at base
        s = s.write("    addq $8, %rax\n");          // returned ptr = base+8
        s = s.write("    movq %r14, %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %rcx, (%rax)\n");      // new len = old+1
