        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Larr_slice_done\n");
        s = s.write("    movq %r13, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq (%r12,%rdx,8), %rdi\n");
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq %rdi, (%rax,%rdx,8)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Larr_slice_loop\n");
        s = s.write(".Larr_slice_done:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
