        s = s.write("    je .Ltrim_front_step\n");
        s = s.write("    cmpq $9, %rax\n");
        s = s.write("    je .Ltrim_front_step\n");
        s = s.write("    cmpq $10, %rax\n");
        s = s.write("    je .Ltrim_front_step\n");
        s = s.write("    cmpq $13, %rax\n");
