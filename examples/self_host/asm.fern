        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // __fern_str_replace: %rdi = haystack box, %rsi = old
        // box, %rdx = new box. Empty old → returns haystack
        // unchanged (no allocation). Otherwise two-pass:
        // count occurrences, allocate exact target size, walk
        // and copy.
        s = s.write("__fern_str_replace:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, -8(%rbp)\n");    // haystack box
        s = s.write("    movq %rsi, -16(%rbp)\n");   // old box
        s = s.write("    movq %rdx, -24(%rbp)\n");   // new box
        s = s.write("    movq $0, -32(%rbp)\n");     // count
        // If lenO == 0, return haystack as-is.
        s = s.write("    movq 8(%rsi), %r14\n");     // lenO
        s = s.write("    testq %r14, %r14\n");
        s = s.write("    jnz .Lrepl_count\n");
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    jmp .Lrepl_exit\n");
        s = s.write(".Lrepl_count:\n");
        s = s.write("    movq (%rdi), %r12\n");      // haystack data
        s = s.write("    movq 8(%rdi), %r13\n");     // haystack len
        s = s.write("    movq (%rsi), %rbx\n");      // old data
        s = s.write("    movq $0, %r15\n");          // i = 0
        s = s.write(".Lrepl_cl:\n");
        s = s.write("    movq %r15, %rax\n");
        s = s.write("    addq %r14, %rax\n");
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    jg .Lrepl_count_done\n");
        s = s.write("    movq $0, %r10\n");          // j
        s = s.write(".Lrepl_clm:\n");
        s = s.write("    cmpq %r14, %r10\n");
        s = s.write("    je .Lrepl_match\n");
        s = s.write("    movq %r12, %r11\n");
        s = s.write("    addq %r15, %r11\n");
        s = s.write("    addq %r10, %r11\n");
        s = s.write("    movzbq (%r11), %rax\n");
        s = s.write("    movq %rbx, %r11\n");
        s = s.write("    addq %r10, %r11\n");
        s = s.write("    movzbq (%r11), %r11\n");
        s = s.write("    cmpq %r11, %rax\n");
        s = s.write("    jne .Lrepl_clnomatch\n");
        s = s.write("    incq %r10\n");
        s = s.write("    jmp .Lrepl_clm\n");
        s = s.write(".Lrepl_match:\n");
        s = s.write("    incq -32(%rbp)\n");
        s = s.write("    addq %r14, %r15\n");
        s = s.write("    jmp .Lrepl_cl\n");
        s = s.write(".Lrepl_clnomatch:\n");
        s = s.write("    incq %r15\n");
        s = s.write("    jmp .Lrepl_cl\n");
        s = s.write(".Lrepl_count_done:\n");
        // If count == 0, return haystack as-is.
        s = s.write("    movq -32(%rbp), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jnz .Lrepl_build\n");
        s = s.write("    movq -8(%rbp), %rax\n");
        s = s.write("    jmp .Lrepl_exit\n");
        s = s.write(".Lrepl_build:\n");
        // total = lenH + count * (lenN - lenO)
        s = s.write("    movq -24(%rbp), %rax\n");
        s = s.write("    movq 8(%rax), %rax\n");
        s = s.write("    subq %r14, %rax\n");
        s = s.write("    imulq -32(%rbp), %rax\n");
        s = s.write("    addq %r13, %rax\n");
        s = s.write("    movq %rax, %r15\n");        // total len
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jne .Lrepl_alloc\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write(".Lrepl_alloc:\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %rbx\n");        // dst buf
        // Walk haystack copying to dst.
        s = s.write("    movq -8(%rbp), %rax\n");
        s = s.write("    movq (%rax), %r12\n");
        s = s.write("    movq $0, %r10\n");          // i
        s = s.write("    movq %rbx, %r11\n");        // dst cursor
        s = s.write(".Lrepl_walk:\n");
        s = s.write("    movq %r10, %rax\n");
        s = s.write("    addq %r14, %rax\n");
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    jg .Lrepl_tail\n");
        // Check match.
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lrepl_chk:\n");
        s = s.write("    cmpq %r14, %rcx\n");
        s = s.write("    je .Lrepl_writenew\n");
        s = s.write("    movq %r12, %rsi\n");
        s = s.write("    addq %r10, %rsi\n");
        s = s.write("    addq %rcx, %rsi\n");
        s = s.write("    movzbq (%rsi), %rdx\n");
        s = s.write("    movq -16(%rbp), %rsi\n");
        s = s.write("    movq (%rsi), %rsi\n");
        s = s.write("    addq %rcx, %rsi\n");
        s = s.write("    movzbq (%rsi), %rsi\n");
        s = s.write("    cmpq %rsi, %rdx\n");
        s = s.write("    jne .Lrepl_chknomatch\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrepl_chk\n");
        s = s.write(".Lrepl_writenew:\n");
        s = s.write("    movq -24(%rbp), %rsi\n");
        s = s.write("    movq (%rsi), %rsi\n");
        s = s.write("    movq -24(%rbp), %rcx\n");
        s = s.write("    movq 8(%rcx), %rcx\n");
        s = s.write("    testq %rcx, %rcx\n");
        s = s.write("    jz .Lrepl_advance\n");
        s = s.write(".Lrepl_wn_loop:\n");
        s = s.write("    movzbq (%rsi), %rdx\n");
        s = s.write("    movb %dl, (%r11)\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    incq %r11\n");
        s = s.write("    decq %rcx\n");
        s = s.write("    jnz .Lrepl_wn_loop\n");
        s = s.write(".Lrepl_advance:\n");
        s = s.write("    addq %r14, %r10\n");
        s = s.write("    jmp .Lrepl_walk\n");
        s = s.write(".Lrepl_chknomatch:\n");
        s = s.write("    movq %r12, %rsi\n");
        s = s.write("    addq %r10, %rsi\n");
        s = s.write("    movzbq (%rsi), %rax\n");
        s = s.write("    movb %al, (%r11)\n");
        s = s.write("    incq %r10\n");
        s = s.write("    incq %r11\n");
        s = s.write("    jmp .Lrepl_walk\n");
        s = s.write(".Lrepl_tail:\n");
        s = s.write("    cmpq %r13, %r10\n");
        s = s.write("    je .Lrepl_box\n");
        s = s.write("    movq %r12, %rsi\n");
        s = s.write("    addq %r10, %rsi\n");
        s = s.write("    movzbq (%rsi), %rax\n");
        s = s.write("    movb %al, (%r11)\n");
        s = s.write("    incq %r10\n");
        s = s.write("    incq %r11\n");
        s = s.write("    jmp .Lrepl_tail\n");
        s = s.write(".Lrepl_box:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rbx, (%rax)\n");
        s = s.write("    movq %r15, 8(%rax)\n");
        s = s.write(".Lrepl_exit:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // __fern_chr: %rdi = i32 byte value. Allocates 1 byte
        // for the char data + 16 bytes for the box. Stores the
        // low byte of %rdi into the data and the length 1 into
        // the box.
        s = s.write("__fern_chr:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    movq %rdi, %r13\n");        // save value
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");        // buf ptr
        s = s.write("    movb %r13b, (%r12)\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");
        s = s.write("    movq $1, 8(%rax)\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // __fern_str_split: %rdi = haystack box, %rsi = sep box.
        // Returns string[] (array of string boxes) of segments
        // split by sep. Empty sep → [haystack]. Two-pass:
        // count separators, then walk + slice.
        //
        // Stack frame locals (-N(%rbp)):
        //   -8:  haystack box ptr
        //   -16: sep box ptr
        //   -24: count of separators
        //   -32: array ptr (built)
        //   -40: write_idx
        //   -48: seg_start offset
        s = s.write("__fern_str_split:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $48, %rsp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, -8(%rbp)\n");
        s = s.write("    movq %rsi, -16(%rbp)\n");
        s = s.write("    movq $0, -24(%rbp)\n");
        // If sep is empty, build single-element array [haystack].
        s = s.write("    movq 8(%rsi), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jz .Lsplit_single\n");
        // First pass: count separators.
        s = s.write("    movq (%rdi), %r12\n");      // hd
        s = s.write("    movq 8(%rdi), %r13\n");     // hl
        s = s.write("    movq (%rsi), %r14\n");      // sd
        s = s.write("    movq 8(%rsi), %r15\n");     // sl
        s = s.write("    movq $0, %rbx\n");          // i
        s = s.write(".Lsplit_cl:\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    addq %r15, %rax\n");
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    jg .Lsplit_count_done\n");
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lsplit_clm:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    je .Lsplit_match\n");
        s = s.write("    movq %r12, %rdx\n");
        s = s.write("    addq %rbx, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    movzbq (%rdx), %rax\n");
        s = s.write("    movq %r14, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    movzbq (%rdx), %rdx\n");
        s = s.write("    cmpq %rdx, %rax\n");
        s = s.write("    jne .Lsplit_clnomatch\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lsplit_clm\n");
        s = s.write(".Lsplit_match:\n");
        s = s.write("    incq -24(%rbp)\n");
        s = s.write("    addq %r15, %rbx\n");
        s = s.write("    jmp .Lsplit_cl\n");
        s = s.write(".Lsplit_clnomatch:\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lsplit_cl\n");
        s = s.write(".Lsplit_count_done:\n");
        // Allocate array: 16 (cap + len words) + (count+1)*8 bytes.
        s = s.write("    movq -24(%rbp), %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    shlq $3, %rax\n");
        s = s.write("    addq $16, %rax\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        // cap at base, shift to base+8, store returned ptr + len
        // (hidden-cap layout; see __fern_arr_push).
        s = s.write("    movq -24(%rbp), %rcx\n");
        s = s.write("    incq %rcx\n");              // len = count + 1
        s = s.write("    movq %rcx, (%rax)\n");      // cap
        s = s.write("    addq $8, %rax\n");
        s = s.write("    movq %rax, -32(%rbp)\n");   // returned arr ptr (base+8)
        s = s.write("    movq %rcx, (%rax)\n");      // len
        s = s.write("    movq $0, -40(%rbp)\n");     // write_idx
        s = s.write("    movq $0, -48(%rbp)\n");     // seg_start
        // Second pass: walk haystack, emit segments.
        s = s.write("    movq -8(%rbp), %rax\n");
        s = s.write("    movq (%rax), %r12\n");
        s = s.write("    movq 8(%rax), %r13\n");
        s = s.write("    movq -16(%rbp), %rax\n");
        s = s.write("    movq (%rax), %r14\n");
        s = s.write("    movq 8(%rax), %r15\n");
        s = s.write("    movq $0, %rbx\n");
        s = s.write(".Lsplit_walk:\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    addq %r15, %rax\n");
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    jg .Lsplit_tail\n");
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lsplit_chk:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    je .Lsplit_segend\n");
        s = s.write("    movq %r12, %rdx\n");
        s = s.write("    addq %rbx, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    movzbq (%rdx), %rax\n");
        s = s.write("    movq %r14, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    movzbq (%rdx), %rdx\n");
        s = s.write("    cmpq %rdx, %rax\n");
        s = s.write("    jne .Lsplit_chknomatch\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lsplit_chk\n");
        s = s.write(".Lsplit_segend:\n");
        // Emit segment [seg_start, i).
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq -8(%rbp), %rcx\n");
        s = s.write("    movq (%rcx), %rcx\n");
        s = s.write("    addq -48(%rbp), %rcx\n");
        s = s.write("    movq %rcx, (%rax)\n");
        s = s.write("    movq %rbx, %rcx\n");
        s = s.write("    subq -48(%rbp), %rcx\n");
        s = s.write("    movq %rcx, 8(%rax)\n");
        // Store box ptr in array at slot (write_idx+1)*8.
        s = s.write("    movq -32(%rbp), %rdi\n");
        s = s.write("    movq -40(%rbp), %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq %rax, (%rdi,%rdx,8)\n");
        s = s.write("    incq -40(%rbp)\n");
        s = s.write("    addq %r15, %rbx\n");
        s = s.write("    movq %rbx, -48(%rbp)\n");
        s = s.write("    jmp .Lsplit_walk\n");
        s = s.write(".Lsplit_chknomatch:\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lsplit_walk\n");
        s = s.write(".Lsplit_tail:\n");
        // Final segment [seg_start, hl).
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq -8(%rbp), %rcx\n");
        s = s.write("    movq (%rcx), %rcx\n");
        s = s.write("    addq -48(%rbp), %rcx\n");
        s = s.write("    movq %rcx, (%rax)\n");
        s = s.write("    movq %r13, %rcx\n");
        s = s.write("    subq -48(%rbp), %rcx\n");
        s = s.write("    movq %rcx, 8(%rax)\n");
        s = s.write("    movq -32(%rbp), %rdi\n");
        s = s.write("    movq -40(%rbp), %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq %rax, (%rdi,%rdx,8)\n");
        s = s.write("    movq -32(%rbp), %rax\n");
        s = s.write("    jmp .Lsplit_exit\n");
        // Empty sep: single-element array [haystack].
        s = s.write(".Lsplit_single:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, -32(%rbp)\n");
        s = s.write("    movq $1, (%rax)\n");
        // Need a box copy: alloc 16 + copy haystack's data/len.
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq -8(%rbp), %rcx\n");
        s = s.write("    movq (%rcx), %rdx\n");
        s = s.write("    movq %rdx, (%rax)\n");
        s = s.write("    movq 8(%rcx), %rdx\n");
        s = s.write("    movq %rdx, 8(%rax)\n");
        s = s.write("    movq -32(%rbp), %rdi\n");
        s = s.write("    movq %rax, 8(%rdi)\n");
        s = s.write("    movq %rdi, %rax\n");
        s = s.write(".Lsplit_exit:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted
    // after this pool, inside the needs_heap block) can reference its
    // shape-name label. The helper's own add_string_lit dedups to this
    // slot; without the early intern the label would be undefined for
    // programs that never mention stat() themselves.
    if (s.needs_heap) {
        var fsPre: StringLitOut = add_string_lit(s, "FileStat");
        s = fsPre.state;
        var prPre: StringLitOut = add_string_lit(s, "ProcessResult");
        s = prPre.state;
    }
    // .rodata: emit each interned string literal as a
    // labelled `.ascii` directive. GAS interprets the escape
    // sequences in the quoted string, so a `\n` byte in the
    // source string lands as a single LF in the resulting
    // .rodata bytes.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(".S" + i32_to_string(li) + ": .ascii \"" + escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Heap allocator: a 1 MiB .bss buffer + bump pointer. The
    // pointer starts at `__fern_heap` and advances by `size`
    // each `__fern_alloc(size)` call. No deallocation — fine
    // for the small validation programs that exercise structs.
    if (s.needs_heap) {
        var heap_size: string = "1073741824";   // 1 GiB
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_heap_ptr: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_heap: .skip " + heap_size + "\n");   // 1 GiB — room for read_all_stdin + self-compiling a whole source bundle (zero-page .bss, no file-size cost)
        s = s.write("    .section .text\n");
        s = s.write(".globl __fern_alloc\n");
        s = s.write(".type __fern_alloc, @function\n");
        s = s.write("__fern_alloc:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        // Initialise __fern_heap_ptr on first call (lazy).
        s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lalloc_inited\n");
        s = s.write("    leaq __fern_heap(%rip), %rax\n");
        s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
        s = s.write(".Lalloc_inited:\n");
        // Result = current ptr; advance ptr by %rdi (the size).
        s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
        s = s.write("    addq %rax, %rdi\n");
        // Bounds check: a bump heap has no GC, so an overflow would
        // silently run past the buffer into adjacent .bss (e.g. the
        // strbuf output accumulator) and corrupt it. Trap with a clean,
        // recognisable exit code (137) instead of corrupting memory.
        // %rcx is saved/restored so __fern_alloc keeps its original
        // clobber contract (only %rax + %rdi) — callers hold live values
        // in other registers across the call (e.g. to_ascii_string keeps
        // the byte in %rcx). popq doesn't disturb the cmp's flags.
        s = s.write("    pushq %rcx\n");
        s = s.write("    leaq __fern_heap(%rip), %rcx\n");
        s = s.write("    addq $" + heap_size + ", %rcx\n");
        s = s.write("    cmpq %rcx, %rdi\n");
        s = s.write("    popq %rcx\n");
        s = s.write("    ja .Lalloc_oom\n");
        s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".Lalloc_oom:\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    movq $137, %rdi\n");
        s = s.write("    syscall\n");
        s = s.write(".size __fern_alloc, .-__fern_alloc\n");

        // Low-level memory intrinsics (`__alloc` / `__free` / the
        // `__load_*` / `__store_*` pokes / `__ptr_width` / `__memset`)
        // and the RC intrinsics (`__fern_rc_inc` / `__fern_arr_dec` /
        // `__fern_drop_arr_ptr`). The Go backend inlines these; here
        // they're plain runtime functions under the self-host's
        // stack-arg ABI (param[0] at 16(%rbp), result in %rax). They
        // exist so a program that imports `std/json` / `core/map`
        // links: that map implementation's source pokes raw memory
        // through these names. The self-host's own `Map[K,V]` lowers
        // to the native `__fern_map_*` runtime, so the `core/map`
        // bodies are never actually called — but their symbols must
        // resolve. RC + `__free` are no-ops, consistent with the
        // leak-everything bump heap (nothing is ever reclaimed).
        s = s.write("__fn___alloc:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___free:\n");
        s = s.write("    ret\n");
        s = s.write("__fn___memset:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rdi\n");     // dst
        s = s.write("    movq 24(%rbp), %rax\n");     // fill byte (in %al)
        s = s.write("    movq 32(%rbp), %rcx\n");     // count
        s = s.write("    cld\n");
        s = s.write("    rep stosb\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_i32:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movslq (%rax), %rax\n");     // i32 load, sign-extended
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___store_i32:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");     // addr
        s = s.write("    movq 24(%rbp), %rcx\n");     // val
        s = s.write("    movl %ecx, (%rax)\n");       // store low 4 bytes
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_i64:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq (%rax), %rax\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_ptr:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq (%rax), %rax\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___store_ptr:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq 16(%rbp), %rax\n");     // addr
        s = s.write("    movq 24(%rbp), %rcx\n");     // val
        s = s.write("    movq %rcx, (%rax)\n");       // store 8 bytes
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write("__fn___ptr_width:\n");
        s = s.write("    movq $8, %rax\n");
        s = s.write("    ret\n");
        // RC intrinsics — no-ops (leak-everything heap). __fern_rc_inc
        // passes its argument through in %rax in case a caller chains.
        s = s.write("__fn___fern_rc_inc:\n");
        s = s.write("    movq 8(%rsp), %rax\n");
        s = s.write("    ret\n");
        s = s.write("__fn___fern_arr_dec:\n");
        s = s.write("    ret\n");
        s = s.write("__fn___fern_drop_arr_ptr:\n");
        s = s.write("    ret\n");

        // __fern_reader_read_chunk(%rdi = fd, %rsi = n) →
        // Option[string]. Reads up to n bytes; on a non-empty read
        // returns Some(string) — an Option box [tag=0, strbox@8]
        // wrapping a {data@0, len@8} string box — and at EOF (read
        // ≤ 0) returns None (box [tag=1]). The fd is the receiver
        // Reader value (see stdin()).
        s = s.write(".globl __fern_reader_read_chunk\n");
        s = s.write(".type __fern_reader_read_chunk, @function\n");
        s = s.write("__fern_reader_read_chunk:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // fd
        s = s.write("    pushq %r12\n");           // n / bytes_read
        s = s.write("    pushq %r13\n");           // data ptr / strbox
        s = s.write("    pushq %r14\n");           // (alignment)
        s = s.write("    movq %rdi, %rbx\n");
        s = s.write("    movq %rsi, %r12\n");
        s = s.write("    movq %r12, %rdi\n");       // alloc n data bytes
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");
        s = s.write("    movq %rbx, %rdi\n");       // read(fd, data, n)
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq %r12, %rdx\n");
        s = s.write("    movq $0, %rax\n");         // sys_read
        s = s.write("    syscall\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jle .Lrrc_none\n");
        s = s.write("    movq %rax, %r12\n");       // bytes_read
        s = s.write("    movq $16, %rdi\n");        // string box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r13, (%rax)\n");     // data@0
        s = s.write("    movq %r12, 8(%rax)\n");    // len@8
        s = s.write("    movq %rax, %r13\n");       // strbox
        s = s.write("    movq $16, %rdi\n");        // Some box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");       // tag = Some
        s = s.write("    movq %r13, 8(%rax)\n");    // payload
        s = s.write("    jmp .Lrrc_ret\n");
        s = s.write(".Lrrc_none:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");       // tag = None
        s = s.write(".Lrrc_ret:\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_reader_read_chunk, .-__fern_reader_read_chunk\n");

        // __fern_reader_close(%rdi = fd) → Option[IoError]. Closes
        // the fd and always returns None (the error arm is unused
        // by read_all_stdin, the only caller today).
        s = s.write(".globl __fern_reader_close\n");
        s = s.write(".type __fern_reader_close, @function\n");
        s = s.write("__fern_reader_close:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    movq $3, %rax\n");         // sys_close(fd)
        s = s.write("    syscall\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");       // None
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_reader_close, .-__fern_reader_close\n");

        // __fern_read_file(%rdi = path string box) → Result[string,
        // IoError]: an Option-shaped box [tag@0, payload@8] with
        // tag=0 Ok(string contents) on success, tag=1 Err(_) on any
        // I/O error (payload 0 — the IoError detail isn't modelled in
        // this emitter; sensible callers use Err(_)). Copies the path
        // into a NUL-terminated buffer (the {data,len} box isn't
        // NUL-terminated), openat(AT_FDCWD, path, O_RDONLY), reads to
        // EOF into a 64 MiB buffer, closes. Linux x86-64 syscalls:
        // openat=257, read=0, close=3.
        s = s.write(".globl __fern_read_file\n");
        s = s.write(".type __fern_read_file, @function\n");
        s = s.write("__fern_read_file:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // path data ptr / write ptr
        s = s.write("    pushq %r12\n");           // fd
        s = s.write("    pushq %r13\n");           // pathz / buf base
        s = s.write("    pushq %r14\n");           // total
        s = s.write("    pushq %r15\n");           // path len
        // NUL-terminate the path: copy len bytes into a len+1 buffer.
        s = s.write("    movq (%rdi), %rbx\n");     // path data ptr
        s = s.write("    movq 8(%rdi), %r15\n");    // path len
        s = s.write("    leaq 1(%r15), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // pathz
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lrdf_copy:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Lrdf_copydone\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%r13,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrdf_copy\n");
        s = s.write(".Lrdf_copydone:\n");
        s = s.write("    movb $0, (%r13,%r15,1)\n"); // NUL terminator
        // openat(AT_FDCWD=-100, pathz, O_RDONLY=0, 0)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $0, %r10\n");
        s = s.write("    movq $257, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lrdf_err\n");
        s = s.write("    movq %rax, %r12\n");       // fd
        // Size the file via lseek so we allocate exactly what's
        // needed (a fixed buffer would exhaust the heap when a driver
        // read_file's several modules). lseek=8, SEEK_END=2, SEEK_SET=0.
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    movq $2, %rdx\n");
        s = s.write("    movq $8, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    movq %rax, %r14\n");        // file size
        s = s.write("    movq %r12, %rdi\n");        // rewind to start
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $8, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    movq %r14, %rdi\n");        // alloc exactly size bytes
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // buf base
        s = s.write("    movq %rax, %rbx\n");       // write ptr
        s = s.write("    movq $0, %r14\n");         // total
        s = s.write(".Lrdf_rdloop:\n");
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    movq %rbx, %rsi\n");
        s = s.write("    movq $1048576, %rdx\n");   // up to 1 MiB per read
        s = s.write("    movq $0, %rax\n");         // sys_read
        s = s.write("    syscall\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jle .Lrdf_rddone\n");
        s = s.write("    addq %rax, %r14\n");
        s = s.write("    addq %rax, %rbx\n");
        s = s.write("    jmp .Lrdf_rdloop\n");
        s = s.write(".Lrdf_rddone:\n");
        s = s.write("    movq %r12, %rdi\n");       // close(fd)
        s = s.write("    movq $3, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    movq $16, %rdi\n");        // string box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r13, (%rax)\n");     // data@0
        s = s.write("    movq %r14, 8(%rax)\n");    // len@8
        s = s.write("    movq %rax, %r13\n");       // strbox
        s = s.write("    movq $16, %rdi\n");        // Result Ok box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");       // tag = Ok
        s = s.write("    movq %r13, 8(%rax)\n");    // payload = string
        s = s.write("    jmp .Lrdf_ret\n");
        s = s.write(".Lrdf_err:\n");
        s = s.write("    movq $16, %rdi\n");        // Result Err box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");       // tag = Err
        s = s.write("    movq $0, 8(%rax)\n");      // payload (unused)
        s = s.write(".Lrdf_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_read_file, .-__fern_read_file\n");

        // __fern_write_file(%rdi = path box, %rsi = content box) →
        // Option[IoError]: [tag@0, payload@8] box — tag=1 None on
        // success, tag=0 Some(_) on any I/O error (payload 0; the
        // IoError detail isn't modelled here, same as __fern_read_file's
        // Err(_)). NUL-terminates the path, openat(AT_FDCWD, path,
        // O_WRONLY|O_CREAT|O_TRUNC=577, 0644), writes the content bytes,
        // closes. Linux x86-64: openat=257, write=1, close=3.
        s = s.write(".globl __fern_write_file\n");
        s = s.write(".type __fern_write_file, @function\n");
        s = s.write("__fern_write_file:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // path data ptr (copy)
        s = s.write("    pushq %r12\n");           // content data ptr
        s = s.write("    pushq %r13\n");           // pathz / fd
        s = s.write("    pushq %r14\n");           // content len
        s = s.write("    pushq %r15\n");           // path len / bytes written
        // Capture content {data,len} before rsi is clobbered.
        s = s.write("    movq (%rsi), %r12\n");     // content data ptr
        s = s.write("    movq 8(%rsi), %r14\n");    // content len
        // NUL-terminate the path: copy len bytes into a len+1 buffer.
        s = s.write("    movq (%rdi), %rbx\n");     // path data ptr
        s = s.write("    movq 8(%rdi), %r15\n");    // path len
        s = s.write("    leaq 1(%r15), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // pathz
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lwf_copy:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Lwf_copydone\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%r13,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lwf_copy\n");
        s = s.write(".Lwf_copydone:\n");
        s = s.write("    movb $0, (%r13,%r15,1)\n"); // NUL terminator
        // openat(AT_FDCWD=-100, pathz, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq $577, %rdx\n");
        s = s.write("    movq $420, %r10\n");
        s = s.write("    movq $257, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lwf_err\n");
        s = s.write("    movq %rax, %r13\n");       // fd (pathz no longer needed)
        // write loop: r15 = bytes written so far.
        s = s.write("    movq $0, %r15\n");
        s = s.write(".Lwf_loop:\n");
        s = s.write("    cmpq %r14, %r15\n");
        s = s.write("    jge .Lwf_done\n");
        s = s.write("    movq %r13, %rdi\n");        // fd
        s = s.write("    leaq (%r12,%r15,1), %rsi\n"); // content data + written
        s = s.write("    movq %r14, %rdx\n");
        s = s.write("    subq %r15, %rdx\n");        // remaining
        s = s.write("    movq $1, %rax\n");          // write
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lwf_err_close\n");
        s = s.write("    addq %rax, %r15\n");
        s = s.write("    jmp .Lwf_loop\n");
        s = s.write(".Lwf_done:\n");
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    movq $3, %rax\n");          // close
        s = s.write("    syscall\n");
        // None (success): 16-byte box, tag=1.
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");
        s = s.write("    jmp .Lwf_ret\n");
        s = s.write(".Lwf_err_close:\n");
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    movq $3, %rax\n");          // close, ignore result
        s = s.write("    syscall\n");
        s = s.write(".Lwf_err:\n");
        // Some(_) (failure): 16-byte box, tag=0, payload 0.
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Lwf_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_write_file, .-__fern_write_file\n");

        // __fern_env(%rdi = name string box) → Option[string]:
        // a [tag@0, payload@8] box — tag=0 Some(value string box) if
        // the variable is set, tag=1 None otherwise. Walks __fern_envp
        // (saved by _start) looking for an entry whose key matches the
        // first name.len bytes followed by '='. The value box points
        // directly at the envp bytes (kernel-provided, immortal) so no
        // copy is needed. Same 5-callee-saved-pushes shape as
        // __fern_read_file (__fern_alloc preserves rbx/r12..r15).
        s = s.write(".section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_envp: .quad 0\n");
        s = s.write(".section .text\n");
        s = s.write(".globl __fern_env\n");
        s = s.write(".type __fern_env, @function\n");
        s = s.write("__fern_env:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // envp cursor
        s = s.write("    pushq %r12\n");           // name data ptr
        s = s.write("    pushq %r13\n");           // name len
        s = s.write("    pushq %r14\n");           // value data ptr / strbox
        s = s.write("    pushq %r15\n");           // value len
        s = s.write("    movq (%rdi), %r12\n");     // name data
        s = s.write("    movq 8(%rdi), %r13\n");    // name len
        s = s.write("    movq __fern_envp(%rip), %rbx\n");
        s = s.write(".Lenv_loop:\n");
        s = s.write("    movq (%rbx), %rdi\n");     // envp[i]
        s = s.write("    testq %rdi, %rdi\n");
        s = s.write("    jz .Lenv_none\n");
        // Compare the first name.len bytes of the entry with the name.
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lenv_cmp:\n");
        s = s.write("    cmpq %r13, %rcx\n");
        s = s.write("    jge .Lenv_cmpdone\n");
        s = s.write("    movb (%rdi,%rcx,1), %al\n");
        s = s.write("    movb (%r12,%rcx,1), %dl\n");
        s = s.write("    cmpb %dl, %al\n");
        s = s.write("    jne .Lenv_next\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lenv_cmp\n");
        s = s.write(".Lenv_cmpdone:\n");
        // Require '=' immediately after the matched key bytes.
        s = s.write("    movb (%rdi,%r13,1), %al\n");
        s = s.write("    cmpb $61, %al\n");          // '='
        s = s.write("    jne .Lenv_next\n");
        // value start = entry + name.len + 1; strlen it.
        s = s.write("    leaq 1(%rdi,%r13,1), %r14\n");
        s = s.write("    movq $0, %r15\n");
        s = s.write(".Lenv_strlen:\n");
        s = s.write("    movb (%r14,%r15,1), %al\n");
        s = s.write("    testb %al, %al\n");
        s = s.write("    jz .Lenv_strlen_done\n");
        s = s.write("    incq %r15\n");
        s = s.write("    jmp .Lenv_strlen\n");
        s = s.write(".Lenv_strlen_done:\n");
        s = s.write("    movq $16, %rdi\n");         // string box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r14, (%rax)\n");      // data@0
        s = s.write("    movq %r15, 8(%rax)\n");     // len@8
        s = s.write("    movq %rax, %r14\n");        // strbox
        s = s.write("    movq $16, %rdi\n");         // Option Some box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");        // tag = Some
        s = s.write("    movq %r14, 8(%rax)\n");     // payload = strbox
        s = s.write("    jmp .Lenv_ret\n");
        s = s.write(".Lenv_next:\n");
        s = s.write("    addq $8, %rbx\n");
        s = s.write("    jmp .Lenv_loop\n");
        s = s.write(".Lenv_none:\n");
        s = s.write("    movq $16, %rdi\n");         // Option None box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");        // tag = None
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Lenv_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_env, .-__fern_env\n");

        // __fern_temp_dir(%rdi = prefix box) → Result[string]: makes a
        // uniquely-named directory "/tmp/<prefix>-<monotonic_ns>" and
        // returns Ok(its path) or Err(_). Uniqueness rides the
        // nanosecond monotonic clock (single mkdir attempt). The Ok box
        // points at the heap path buffer; the box length excludes the
        // NUL the buffer also carries (kept for the mkdirat syscall).
        s = s.write(".globl __fern_temp_dir\n");
        s = s.write(".type __fern_temp_dir, @function\n");
        s = s.write("__fern_temp_dir:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // prefix box
        s = s.write("    pushq %r12\n");           // prefix len
        s = s.write("    pushq %r13\n");           // path base
        s = s.write("    pushq %r14\n");           // cursor / total len
        s = s.write("    pushq %r15\n");           // ns
        s = s.write("    movq %rdi, %rbx\n");       // prefix box
        s = s.write("    call __fern_monotonic_ns\n");
        s = s.write("    movq %rax, %r15\n");       // ns (unique suffix)
        s = s.write("    movq 8(%rbx), %r12\n");    // prefix len
        s = s.write("    leaq 27(%r12), %rdi\n");   // 5+plen+1+20+1
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // path base
        s = s.write("    movb $47, 0(%r13)\n");     // '/'
        s = s.write("    movb $116, 1(%r13)\n");    // 't'
        s = s.write("    movb $109, 2(%r13)\n");    // 'm'
        s = s.write("    movb $112, 3(%r13)\n");    // 'p'
        s = s.write("    movb $47, 4(%r13)\n");     // '/'
        s = s.write("    movq $5, %r14\n");         // cursor
        s = s.write("    movq (%rbx), %rcx\n");      // prefix data
        s = s.write("    movq $0, %rdx\n");
        s = s.write(".Ltd_pcopy:\n");
        s = s.write("    cmpq %r12, %rdx\n");
        s = s.write("    jge .Ltd_pdone\n");
        s = s.write("    movb (%rcx,%rdx,1), %al\n");
        s = s.write("    movb %al, (%r13,%r14,1)\n");
        s = s.write("    incq %r14\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    jmp .Ltd_pcopy\n");
        s = s.write(".Ltd_pdone:\n");
        s = s.write("    movb $45, (%r13,%r14,1)\n"); // '-'
        s = s.write("    incq %r14\n");
        // Count decimal digits of ns → %r8 (ns==0 → 1).
        s = s.write("    movq %r15, %rax\n");
        s = s.write("    movq $0, %r8\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jne .Ltd_cnt\n");
        s = s.write("    movq $1, %r8\n");
        s = s.write("    jmp .Ltd_cntdone\n");
        s = s.write(".Ltd_cnt:\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    je .Ltd_cntdone\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Ltd_cnt\n");
        s = s.write(".Ltd_cntdone:\n");
        // Write digits least-significant-first into [cursor .. cursor+D-1].
        s = s.write("    leaq -1(%r14,%r8,1), %r9\n");  // last digit pos
        s = s.write("    movq %r15, %rax\n");
        s = s.write(".Ltd_wr:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%r13,%r9,1)\n");
        s = s.write("    decq %r9\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jne .Ltd_wr\n");
        s = s.write("    addq %r8, %r14\n");         // total len
        s = s.write("    movb $0, (%r13,%r14,1)\n"); // NUL
        // mkdirat(AT_FDCWD=-100, pathz, 0700=448)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq $448, %rdx\n");
        s = s.write("    movq $258, %rax\n");        // mkdirat
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jnz .Ltd_err\n");
        s = s.write("    movq $16, %rdi\n");         // string box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r13, (%rax)\n");      // data
        s = s.write("    movq %r14, 8(%rax)\n");     // len
        s = s.write("    movq %rax, %r13\n");        // strbox
        s = s.write("    movq $16, %rdi\n");         // Result Ok box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");        // Ok
        s = s.write("    movq %r13, 8(%rax)\n");
        s = s.write("    jmp .Ltd_ret\n");
        s = s.write(".Ltd_err:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");        // Err
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Ltd_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_temp_dir, .-__fern_temp_dir\n");

        // __fern_stat(%rdi = path box) → Result[FileStat]. newfstatat
        // (syscall 262) into a stack buffer; reads st_mode (offset 24
        // on x86-64) and st_size (offset 48), builds a FileStat struct
        // [shape, is_file@8, is_dir@16, size@24] whose shape pointer is
        // the interned "FileStat" name (so field access matches it),
        // and wraps it in Result Ok / Err.
        var fsLit: StringLitOut = add_string_lit(s, "FileStat");
        s = fsLit.state;
        s = s.write(".globl __fern_stat\n");
        s = s.write(".type __fern_stat, @function\n");
        s = s.write("__fern_stat:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // path data / st_size
        s = s.write("    pushq %r12\n");           // is_file
        s = s.write("    pushq %r13\n");           // pathz / struct ptr
        s = s.write("    pushq %r14\n");           // is_dir
        s = s.write("    pushq %r15\n");           // path len
        s = s.write("    subq $160, %rsp\n");       // statbuf (144) + slack
        s = s.write("    movq (%rdi), %rbx\n");     // path data
        s = s.write("    movq 8(%rdi), %r15\n");    // path len
        s = s.write("    leaq 1(%r15), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // pathz
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lstat_copy:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Lstat_cpd\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%r13,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lstat_copy\n");
        s = s.write(".Lstat_cpd:\n");
        s = s.write("    movb $0, (%r13,%r15,1)\n");
        // newfstatat(AT_FDCWD, pathz, statbuf=%rsp, 0)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq %rsp, %rdx\n");
        s = s.write("    movq $0, %r10\n");
        s = s.write("    movq $262, %rax\n");        // newfstatat
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lstat_err\n");
        s = s.write("    movl 24(%rsp), %eax\n");    // st_mode
        s = s.write("    andl $61440, %eax\n");      // & S_IFMT (0xF000)
        s = s.write("    movq $0, %r12\n");
        s = s.write("    cmpl $32768, %eax\n");      // S_IFREG (0x8000)
        s = s.write("    jne .Lstat_nf\n");
        s = s.write("    movq $1, %r12\n");
        s = s.write(".Lstat_nf:\n");
        s = s.write("    movq $0, %r14\n");
        s = s.write("    cmpl $16384, %eax\n");      // S_IFDIR (0x4000)
        s = s.write("    jne .Lstat_nd\n");
        s = s.write("    movq $1, %r14\n");
        s = s.write(".Lstat_nd:\n");
        s = s.write("    movq 48(%rsp), %rbx\n");    // st_size
        s = s.write("    movq $32, %rdi\n");         // FileStat struct
        s = s.write("    call __fern_alloc\n");
        s = s.write("    leaq .S" + i32_to_string(fsLit.idx) + "(%rip), %rcx\n");
        s = s.write("    movq %rcx, (%rax)\n");      // shape
        s = s.write("    movq %r12, 8(%rax)\n");     // is_file
        s = s.write("    movq %r14, 16(%rax)\n");    // is_dir
        s = s.write("    movq %rbx, 24(%rax)\n");    // size
        s = s.write("    movq %rax, %r13\n");        // struct ptr
        s = s.write("    movq $16, %rdi\n");         // Result Ok box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");        // Ok
        s = s.write("    movq %r13, 8(%rax)\n");
        s = s.write("    jmp .Lstat_ret\n");
        s = s.write(".Lstat_err:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");        // Err
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Lstat_ret:\n");
        s = s.write("    addq $160, %rsp\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_stat, .-__fern_stat\n");

        // __fern_read_dir(%rdi = path box) → Result[string[]]. Opens the
        // directory (O_RDONLY|O_DIRECTORY), reads all entries via
        // getdents64 (217) into a 1 MiB heap buffer, then makes two
        // passes: count valid entries (skipping "." / ".."), allocate
        // the [cap, len, e0…] array, and fill it with string boxes whose
        // data points straight at the immortal getdents buffer.
        s = s.write(".globl __fern_read_dir\n");
        s = s.write(".type __fern_read_dir, @function\n");
        s = s.write("__fern_read_dir:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // offset cursor
        s = s.write("    pushq %r12\n");           // fd / array ptr
        s = s.write("    pushq %r13\n");           // buf base
        s = s.write("    pushq %r14\n");           // total
        s = s.write("    pushq %r15\n");           // path len / count / index
        s = s.write("    movq (%rdi), %rbx\n");     // path data
        s = s.write("    movq 8(%rdi), %r15\n");    // path len
        s = s.write("    leaq 1(%r15), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");       // pathz (temp)
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lrd_copy:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Lrd_cpd\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%r12,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrd_copy\n");
        s = s.write(".Lrd_cpd:\n");
        s = s.write("    movb $0, (%r12,%r15,1)\n");
        // openat(AT_FDCWD, pathz, O_RDONLY|O_DIRECTORY=65536, 0)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %r12, %rsi\n");
        s = s.write("    movq $65536, %rdx\n");
        s = s.write("    movq $0, %r10\n");
        s = s.write("    movq $257, %rax\n");        // openat
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lrd_err\n");
        s = s.write("    movq %rax, %r12\n");        // fd
        s = s.write("    movq $1048576, %rdi\n");    // 1 MiB buffer
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");        // buf base
        s = s.write("    movq $0, %r14\n");          // total
        s = s.write(".Lrd_g:\n");
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    leaq (%r13,%r14,1), %rsi\n");
        s = s.write("    movq $1048576, %rdx\n");
        s = s.write("    subq %r14, %rdx\n");
        s = s.write("    movq $217, %rax\n");        // getdents64
        s = s.write("    syscall\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jle .Lrd_gd\n");
        s = s.write("    addq %rax, %r14\n");
        s = s.write("    jmp .Lrd_g\n");
        s = s.write(".Lrd_gd:\n");
        s = s.write("    movq %r12, %rdi\n");        // close(fd)
        s = s.write("    movq $3, %rax\n");
        s = s.write("    syscall\n");
        // pass 1: count valid entries → %r15
        s = s.write("    movq $0, %r15\n");          // count
        s = s.write("    movq $0, %rbx\n");          // offset
        s = s.write(".Lrd_c1:\n");
        s = s.write("    cmpq %r14, %rbx\n");
        s = s.write("    jge .Lrd_c1d\n");
        s = s.write("    leaq 19(%r13,%rbx,1), %rax\n"); // name ptr
        s = s.write("    movb (%rax), %cl\n");
        s = s.write("    cmpb $46, %cl\n");          // '.'
        s = s.write("    jne .Lrd_c1n\n");
        s = s.write("    movb 1(%rax), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrd_c1s\n");            // "." → skip
        s = s.write("    cmpb $46, %cl\n");
        s = s.write("    jne .Lrd_c1n\n");
        s = s.write("    movb 2(%rax), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrd_c1s\n");            // ".." → skip
        s = s.write(".Lrd_c1n:\n");
        s = s.write("    incq %r15\n");
        s = s.write(".Lrd_c1s:\n");
        s = s.write("    movzwq 16(%r13,%rbx,1), %rax\n"); // d_reclen
        s = s.write("    addq %rax, %rbx\n");
        s = s.write("    jmp .Lrd_c1\n");
        s = s.write(".Lrd_c1d:\n");
        s = s.write("    leaq 2(%r15), %rdi\n");     // (count+2)*8
        s = s.write("    shlq $3, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r15, (%rax)\n");      // cap
        s = s.write("    addq $8, %rax\n");
        s = s.write("    movq %r15, (%rax)\n");      // len
        s = s.write("    movq %rax, %r12\n");        // array ptr P
        // pass 2: fill
        s = s.write("    movq $0, %rbx\n");          // offset
        s = s.write("    movq $0, %r15\n");          // element index
        s = s.write(".Lrd_p2:\n");
        s = s.write("    cmpq %r14, %rbx\n");
        s = s.write("    jge .Lrd_p2d\n");
        s = s.write("    leaq 19(%r13,%rbx,1), %rax\n"); // name ptr
        s = s.write("    movb (%rax), %cl\n");
        s = s.write("    cmpb $46, %cl\n");
        s = s.write("    jne .Lrd_p2t\n");
        s = s.write("    movb 1(%rax), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrd_p2a\n");
        s = s.write("    cmpb $46, %cl\n");
        s = s.write("    jne .Lrd_p2t\n");
        s = s.write("    movb 2(%rax), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrd_p2a\n");
        s = s.write(".Lrd_p2t:\n");
        s = s.write("    movq $0, %rdx\n");          // strlen
        s = s.write(".Lrd_p2sl:\n");
        s = s.write("    movb (%rax,%rdx,1), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrd_p2sd\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    jmp .Lrd_p2sl\n");
        s = s.write(".Lrd_p2sd:\n");
        s = s.write("    pushq %rax\n");             // name ptr
        s = s.write("    pushq %rdx\n");             // len
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %rdx\n");
        s = s.write("    popq %rcx\n");              // name ptr
        s = s.write("    movq %rcx, (%rax)\n");      // box.data
        s = s.write("    movq %rdx, 8(%rax)\n");     // box.len
        s = s.write("    movq %r15, %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %rax, (%r12,%rcx,8)\n"); // P[index+1] = box
        s = s.write("    incq %r15\n");
        s = s.write(".Lrd_p2a:\n");
        s = s.write("    movzwq 16(%r13,%rbx,1), %rax\n");
        s = s.write("    addq %rax, %rbx\n");
        s = s.write("    jmp .Lrd_p2\n");
        s = s.write(".Lrd_p2d:\n");
        s = s.write("    movq $16, %rdi\n");         // Result Ok box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");        // Ok
        s = s.write("    movq %r12, 8(%rax)\n");
        s = s.write("    jmp .Lrd_ret\n");
        s = s.write(".Lrd_err:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");        // Err
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Lrd_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_read_dir, .-__fern_read_dir\n");

        // __fern_remove_dir_all(%rdi = path box) → Option[IoError].
        // Recursive rm -rf: open the path as a directory; ENOENT → None
        // (already gone), ENOTDIR → unlink the file, success → recurse
        // into each child (path + "/" + name) then rmdir. Best-effort:
        // returns None except when the initial open fails for a reason
        // other than ENOENT/ENOTDIR. Child paths are freshly heap-built
        // string boxes; getdents uses a 64 KiB per-level buffer.
        s = s.write(".globl __fern_remove_dir_all\n");
        s = s.write(".type __fern_remove_dir_all, @function\n");
        s = s.write("__fern_remove_dir_all:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // pathz
        s = s.write("    pushq %r12\n");           // fd
        s = s.write("    pushq %r13\n");           // buf base
        s = s.write("    pushq %r14\n");           // total
        s = s.write("    pushq %r15\n");           // offset cursor
        s = s.write("    movq (%rdi), %r12\n");     // path data
        s = s.write("    movq 8(%rdi), %r13\n");    // path len
        s = s.write("    leaq 1(%r13), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %rbx\n");       // pathz
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lrda_copy:\n");
        s = s.write("    cmpq %r13, %rcx\n");
        s = s.write("    jge .Lrda_cpd\n");
        s = s.write("    movb (%r12,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%rbx,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrda_copy\n");
        s = s.write(".Lrda_cpd:\n");
        s = s.write("    movb $0, (%rbx,%r13,1)\n");
        // openat(AT_FDCWD, pathz, O_RDONLY|O_DIRECTORY)
        s = s.write("    movq $-100, %rdi\n");
        s = s.write("    movq %rbx, %rsi\n");
        s = s.write("    movq $65536, %rdx\n");
        s = s.write("    movq $0, %r10\n");
        s = s.write("    movq $257, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jns .Lrda_dir\n");
        s = s.write("    cmpq $-2, %rax\n");         // -ENOENT
        s = s.write("    je .Lrda_none\n");
        s = s.write("    cmpq $-20, %rax\n");        // -ENOTDIR → file
        s = s.write("    jne .Lrda_some\n");
        s = s.write("    movq $-100, %rdi\n");       // unlinkat(file)
        s = s.write("    movq %rbx, %rsi\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $263, %rax\n");        // unlinkat
        s = s.write("    syscall\n");
        s = s.write("    jmp .Lrda_none\n");
        s = s.write(".Lrda_dir:\n");
        s = s.write("    movq %rax, %r12\n");        // fd
        s = s.write("    movq $65536, %rdi\n");      // 64 KiB getdents buffer
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");        // buf
        s = s.write("    movq $0, %r14\n");          // total
        s = s.write(".Lrda_g:\n");
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    leaq (%r13,%r14,1), %rsi\n");
        s = s.write("    movq $65536, %rdx\n");
        s = s.write("    subq %r14, %rdx\n");
        s = s.write("    movq $217, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jle .Lrda_gd\n");
        s = s.write("    addq %rax, %r14\n");
        s = s.write("    jmp .Lrda_g\n");
        s = s.write(".Lrda_gd:\n");
        s = s.write("    movq $0, %r15\n");          // offset
        s = s.write(".Lrda_it:\n");
        s = s.write("    cmpq %r14, %r15\n");
        s = s.write("    jge .Lrda_itd\n");
        s = s.write("    leaq 19(%r13,%r15,1), %rax\n"); // name ptr
        s = s.write("    movb (%rax), %cl\n");
        s = s.write("    cmpb $46, %cl\n");
        s = s.write("    jne .Lrda_ch\n");
        s = s.write("    movb 1(%rax), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrda_adv\n");
        s = s.write("    cmpb $46, %cl\n");
        s = s.write("    jne .Lrda_ch\n");
        s = s.write("    movb 2(%rax), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrda_adv\n");
        s = s.write(".Lrda_ch:\n");
        s = s.write("    movq %rax, %r8\n");          // name ptr
        s = s.write("    movq $0, %r9\n");            // plen = strlen(pathz)
        s = s.write(".Lrda_pl:\n");
        s = s.write("    movb (%rbx,%r9,1), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrda_pld\n");
        s = s.write("    incq %r9\n");
        s = s.write("    jmp .Lrda_pl\n");
        s = s.write(".Lrda_pld:\n");
        s = s.write("    movq $0, %r10\n");           // nlen = strlen(name)
        s = s.write(".Lrda_nl:\n");
        s = s.write("    movb (%r8,%r10,1), %cl\n");
        s = s.write("    cmpb $0, %cl\n");
        s = s.write("    je .Lrda_nld\n");
        s = s.write("    incq %r10\n");
        s = s.write("    jmp .Lrda_nl\n");
        s = s.write(".Lrda_nld:\n");
        s = s.write("    pushq %r8\n");               // name ptr
        s = s.write("    pushq %r9\n");               // plen
        s = s.write("    pushq %r10\n");              // nlen
        s = s.write("    leaq 1(%r9,%r10,1), %rdi\n"); // plen+nlen+1
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %rsi\n");         // child data buf
        s = s.write("    popq %r10\n");
        s = s.write("    popq %r9\n");
        s = s.write("    popq %r8\n");
        s = s.write("    movq $0, %rcx\n");           // copy pathz
        s = s.write(".Lrda_cc1:\n");
        s = s.write("    cmpq %r9, %rcx\n");
        s = s.write("    jge .Lrda_cc1d\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%rsi,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrda_cc1\n");
        s = s.write(".Lrda_cc1d:\n");
        s = s.write("    movb $47, (%rsi,%r9,1)\n");  // '/'
        s = s.write("    movq $0, %rcx\n");           // copy name at plen+1
        s = s.write(".Lrda_cc2:\n");
        s = s.write("    cmpq %r10, %rcx\n");
        s = s.write("    jge .Lrda_cc2d\n");
        s = s.write("    movb (%r8,%rcx,1), %dl\n");
        s = s.write("    leaq 1(%r9,%rcx,1), %rax\n");
        s = s.write("    movb %dl, (%rsi,%rax,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrda_cc2\n");
        s = s.write(".Lrda_cc2d:\n");
        s = s.write("    leaq 1(%r9,%r10,1), %r11\n"); // child len = plen+nlen+1
        s = s.write("    pushq %rsi\n");
        s = s.write("    pushq %r11\n");
        s = s.write("    movq $16, %rdi\n");          // string box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %r11\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    movq %rsi, (%rax)\n");       // data
        s = s.write("    movq %r11, 8(%rax)\n");      // len
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    call __fern_remove_dir_all\n"); // recurse
        s = s.write(".Lrda_adv:\n");
        s = s.write("    movzwq 16(%r13,%r15,1), %rax\n");
        s = s.write("    addq %rax, %r15\n");
        s = s.write("    jmp .Lrda_it\n");
        s = s.write(".Lrda_itd:\n");
        s = s.write("    movq %r12, %rdi\n");         // close(fd)
        s = s.write("    movq $3, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    movq $-100, %rdi\n");        // rmdir via unlinkat
        s = s.write("    movq %rbx, %rsi\n");
        s = s.write("    movq $512, %rdx\n");         // AT_REMOVEDIR
        s = s.write("    movq $263, %rax\n");
        s = s.write("    syscall\n");
        s = s.write(".Lrda_none:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");         // None
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write("    jmp .Lrda_ret\n");
        s = s.write(".Lrda_some:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");         // Some
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Lrda_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_remove_dir_all, .-__fern_remove_dir_all\n");

        // __fern_remove_file(%rdi = path box) → Option[IoError]. Same
        // NUL-terminate + unlinkat shape as remove_dir_all's file
        // branch. Returns None on success, Some(_) on error.
        s = s.write(".globl __fern_remove_file\n");
        s = s.write(".type __fern_remove_file, @function\n");
        s = s.write("__fern_remove_file:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // path data
        s = s.write("    pushq %r12\n");           // path len
        s = s.write("    pushq %r13\n");           // pathz
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq (%rdi), %rbx\n");     // path data
        s = s.write("    movq 8(%rdi), %r12\n");    // path len
        s = s.write("    leaq 1(%r12), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");       // pathz
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Lrf_copy:\n");
        s = s.write("    cmpq %r12, %rcx\n");
        s = s.write("    jge .Lrf_cpd\n");
        s = s.write("    movb (%rbx,%rcx,1), %dl\n");
        s = s.write("    movb %dl, (%r13,%rcx,1)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lrf_copy\n");
        s = s.write(".Lrf_cpd:\n");
        s = s.write("    movb $0, (%r13,%r12,1)\n");
        s = s.write("    movq $-100, %rdi\n");      // AT_FDCWD
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $263, %rax\n");       // unlinkat
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    js .Lrf_err\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $1, (%rax)\n");        // None
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write("    jmp .Lrf_ret\n");
        s = s.write(".Lrf_err:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");        // Some
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write(".Lrf_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_remove_file, .-__fern_remove_file\n");

        // __fern_subprocess(%rdi = cmd box, %rsi = args box (string[]),
        //                   %rdx = stdin box) → ProcessResult struct.
        // Creates 3 pipes, forks, plumbs the child's stdin / stdout /
        // stderr through them, execve's cmd with argv = [cmd, args…,
        // NULL] and the parent's envp. Parent writes the stdin
        // payload, reads stdout + stderr to EOF, waits, and packs the
        // result into a `{shape, stdout, stderr, exit_code}` struct.
        // Spawn failure (cmd not found) lands as exit_code = 127 via
        // the child's `exit(127)` fallback after a returning execve.
        // Captures are read into 64 KiB scratch buffers — bigger
        // outputs are silently truncated; the tests fit easily.
        var prLit: StringLitOut = add_string_lit(s, "ProcessResult");
        s = prLit.state;
        s = s.write(".globl __fern_subprocess\n");
        s = s.write(".type __fern_subprocess, @function\n");
        s = s.write("__fern_subprocess:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    subq $128, %rsp\n");
        // Save input boxes into callee-saved regs.
        s = s.write("    movq %rdi, %r12\n");   // cmd box
        s = s.write("    movq %rsi, %r13\n");   // args box
        s = s.write("    movq %rdx, %r14\n");   // stdin box
        // Build cmdz at -64(%rbp): NUL-terminated cmd string.
        s = s.write("    movq 8(%r12), %r15\n");  // cmd len
        s = s.write("    leaq 1(%r15), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, -64(%rbp)\n");
        s = s.write("    movq (%r12), %rcx\n");   // cmd data
        s = s.write("    movq $0, %r8\n");
        s = s.write(".Lsp_ccmd:\n");
        s = s.write("    cmpq %r15, %r8\n");
        s = s.write("    jge .Lsp_ccmd_d\n");
        s = s.write("    movb (%rcx, %r8, 1), %al\n");
        s = s.write("    movq -64(%rbp), %r9\n");
        s = s.write("    movb %al, (%r9, %r8, 1)\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Lsp_ccmd\n");
        s = s.write(".Lsp_ccmd_d:\n");
        s = s.write("    movq -64(%rbp), %r9\n");
        s = s.write("    movb $0, (%r9, %r15, 1)\n");
        // Build argv at -56(%rbp): (nargs + 2) pointer slots.
        s = s.write("    movq (%r13), %r15\n");   // nargs
        s = s.write("    leaq 2(%r15), %rdi\n");
        s = s.write("    shlq $3, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, -56(%rbp)\n");
        // argv[0] = cmdz.
        s = s.write("    movq -64(%rbp), %rcx\n");
        s = s.write("    movq -56(%rbp), %r9\n");
        s = s.write("    movq %rcx, (%r9)\n");
        // argv[i+1] = NUL-terminated copy of args[i].
        s = s.write("    movq $0, %rbx\n");
        s = s.write(".Lsp_arg:\n");
        s = s.write("    cmpq %r15, %rbx\n");
        s = s.write("    jge .Lsp_arg_d\n");
        s = s.write("    leaq 1(%rbx), %rcx\n");
        s = s.write("    movq (%r13, %rcx, 8), %r10\n");   // args[i] box
        s = s.write("    movq 8(%r10), %rsi\n");           // arg_len
        s = s.write("    leaq 1(%rsi), %rdi\n");
        s = s.write("    pushq %r10\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %r10\n");
        s = s.write("    movq (%r10), %rcx\n");
        s = s.write("    movq $0, %r8\n");
        s = s.write(".Lsp_acopy:\n");
        s = s.write("    cmpq %rsi, %r8\n");
        s = s.write("    jge .Lsp_acopy_d\n");
        s = s.write("    movb (%rcx, %r8, 1), %dl\n");
        s = s.write("    movb %dl, (%rax, %r8, 1)\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Lsp_acopy\n");
        s = s.write(".Lsp_acopy_d:\n");
        s = s.write("    movb $0, (%rax, %rsi, 1)\n");
        s = s.write("    movq -56(%rbp), %r9\n");
        s = s.write("    leaq 1(%rbx), %rcx\n");
        s = s.write("    movq %rax, (%r9, %rcx, 8)\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lsp_arg\n");
        s = s.write(".Lsp_arg_d:\n");
        // argv[nargs+1] = NULL.
        s = s.write("    movq -56(%rbp), %r9\n");
        s = s.write("    leaq 1(%r15), %rcx\n");
        s = s.write("    movq $0, (%r9, %rcx, 8)\n");
        // Create 3 pipes (pipe2 syscall 293, flags 0). Layout in
        // frame: in_r@-96, in_w@-92, out_r@-88, out_w@-84,
        // err_r@-80, err_w@-76 (4-byte fds packed contiguously).
        s = s.write("    leaq -96(%rbp), %rdi\n");
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    movq $293, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    leaq -88(%rbp), %rdi\n");
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    movq $293, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    leaq -80(%rbp), %rdi\n");
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    movq $293, %rax\n");
        s = s.write("    syscall\n");
        // fork (syscall 57). rax = pid in parent, 0 in child, <0 on error.
        s = s.write("    movq $57, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lsp_parent\n");
        // ---------- CHILD ----------
        // dup2(in_r, 0), dup2(out_w, 1), dup2(err_w, 2).
        s = s.write("    movl -96(%rbp), %edi\n");
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    movq $33, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    movl -84(%rbp), %edi\n");
        s = s.write("    movq $1, %rsi\n");
        s = s.write("    movq $33, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    movl -76(%rbp), %edi\n");
        s = s.write("    movq $2, %rsi\n");
        s = s.write("    movq $33, %rax\n");
        s = s.write("    syscall\n");
        // Close all 6 original pipe fds.
        s = s.write("    movl -96(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -92(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -88(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -84(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -80(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -76(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        // execve(cmdz, argv, envp).
        // First try cmd as-given (handles absolute / relative paths).
        s = s.write("    movq -64(%rbp), %rdi\n");
        s = s.write("    movq -56(%rbp), %rsi\n");
        s = s.write("    movq __fern_envp(%rip), %rdx\n");
        s = s.write("    movq $59, %rax\n");
        s = s.write("    syscall\n");
        // execve only returns on failure. Fall back to common $PATH
        // prefixes /bin/ and /usr/bin/ so bare names like "echo" /
        // "sh" / "cat" — used heavily by std/test's process tests —
        // resolve without re-implementing full PATH search.
        // Allocate cmd_len + max-prefix-len + 1 byte buffer
        // ("/usr/bin/" is 9 bytes), copy prefix + cmd + NUL, execve.
        s = s.write("    movq -64(%rbp), %r12\n");   // cmdz (saved)
        s = s.write("    movq $0, %rbx\n");          // cmd_len
        s = s.write(".Lsp_clen:\n");
        s = s.write("    movb (%r12, %rbx, 1), %al\n");
        s = s.write("    cmpb $0, %al\n");
        s = s.write("    je .Lsp_clen_d\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lsp_clen\n");
        s = s.write(".Lsp_clen_d:\n");
        // Build "/bin/<cmd>" buffer (5 + cmd_len + 1).
        s = s.write("    leaq 6(%rbx), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");
        s = s.write("    movb $47, 0(%r13)\n");    // '/'
        s = s.write("    movb $98, 1(%r13)\n");    // 'b'
        s = s.write("    movb $105, 2(%r13)\n");   // 'i'
        s = s.write("    movb $110, 3(%r13)\n");   // 'n'
        s = s.write("    movb $47, 4(%r13)\n");    // '/'
        s = s.write("    movq $0, %r8\n");
        s = s.write(".Lsp_bcopy:\n");
        s = s.write("    cmpq %rbx, %r8\n");
        s = s.write("    jge .Lsp_bcopy_d\n");
        s = s.write("    movb (%r12, %r8, 1), %al\n");
        s = s.write("    leaq 5(%r8), %rcx\n");
        s = s.write("    movb %al, (%r13, %rcx, 1)\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Lsp_bcopy\n");
        s = s.write(".Lsp_bcopy_d:\n");
        s = s.write("    leaq 5(%rbx), %rcx\n");
        s = s.write("    movb $0, (%r13, %rcx, 1)\n");   // NUL
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    movq -56(%rbp), %rsi\n");
        s = s.write("    movq __fern_envp(%rip), %rdx\n");
        s = s.write("    movq $59, %rax\n");
        s = s.write("    syscall\n");
        // Try /usr/bin/<cmd> (9 + cmd_len + 1).
        s = s.write("    leaq 10(%rbx), %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");
        s = s.write("    movb $47, 0(%r13)\n");    // '/'
        s = s.write("    movb $117, 1(%r13)\n");   // 'u'
        s = s.write("    movb $115, 2(%r13)\n");   // 's'
        s = s.write("    movb $114, 3(%r13)\n");   // 'r'
        s = s.write("    movb $47, 4(%r13)\n");    // '/'
        s = s.write("    movb $98, 5(%r13)\n");    // 'b'
        s = s.write("    movb $105, 6(%r13)\n");   // 'i'
        s = s.write("    movb $110, 7(%r13)\n");   // 'n'
        s = s.write("    movb $47, 8(%r13)\n");    // '/'
        s = s.write("    movq $0, %r8\n");
        s = s.write(".Lsp_ucopy:\n");
        s = s.write("    cmpq %rbx, %r8\n");
        s = s.write("    jge .Lsp_ucopy_d\n");
        s = s.write("    movb (%r12, %r8, 1), %al\n");
        s = s.write("    leaq 9(%r8), %rcx\n");
        s = s.write("    movb %al, (%r13, %rcx, 1)\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Lsp_ucopy\n");
        s = s.write(".Lsp_ucopy_d:\n");
        s = s.write("    leaq 9(%rbx), %rcx\n");
        s = s.write("    movb $0, (%r13, %rcx, 1)\n");
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    movq -56(%rbp), %rsi\n");
        s = s.write("    movq __fern_envp(%rip), %rdx\n");
        s = s.write("    movq $59, %rax\n");
        s = s.write("    syscall\n");
        // All execve attempts failed → exit(127).
        s = s.write("    movq $127, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
        // ---------- PARENT ----------
        s = s.write(".Lsp_parent:\n");
        s = s.write("    movq %rax, %r15\n");   // child pid
        // Close child ends in parent: in_r, out_w, err_w.
        s = s.write("    movl -96(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -84(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        s = s.write("    movl -76(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        // Write stdin payload (if any) to in_w, then close in_w.
        s = s.write("    movq 8(%r14), %rdx\n");   // stdin len
        s = s.write("    testq %rdx, %rdx\n");
        s = s.write("    jz .Lsp_close_in\n");
        s = s.write("    movl -92(%rbp), %edi\n");
        s = s.write("    movq (%r14), %rsi\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write("    syscall\n");
        s = s.write(".Lsp_close_in:\n");
        s = s.write("    movl -92(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        // Read stdout to EOF into a 64 KiB buffer (rbx = buf,
        // r12 = total bytes read).
        s = s.write("    movq $65536, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %rbx\n");
        s = s.write("    movq $0, %r12\n");
        s = s.write(".Lsp_rdo:\n");
        s = s.write("    movq $65536, %rdx\n");
        s = s.write("    subq %r12, %rdx\n");
        s = s.write("    testq %rdx, %rdx\n");
        s = s.write("    jle .Lsp_rdo_d\n");
        s = s.write("    movl -88(%rbp), %edi\n");
        s = s.write("    leaq (%rbx, %r12, 1), %rsi\n");
        s = s.write("    movq $0, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jle .Lsp_rdo_d\n");
        s = s.write("    addq %rax, %r12\n");
        s = s.write("    jmp .Lsp_rdo\n");
        s = s.write(".Lsp_rdo_d:\n");
        s = s.write("    movl -88(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        // Read stderr similarly (r13 = buf, r14 = total).
        s = s.write("    movq $65536, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");
        s = s.write("    movq $0, %r14\n");
        s = s.write(".Lsp_rde:\n");
        s = s.write("    movq $65536, %rdx\n");
        s = s.write("    subq %r14, %rdx\n");
        s = s.write("    testq %rdx, %rdx\n");
        s = s.write("    jle .Lsp_rde_d\n");
        s = s.write("    movl -80(%rbp), %edi\n");
        s = s.write("    leaq (%r13, %r14, 1), %rsi\n");
        s = s.write("    movq $0, %rax\n");
        s = s.write("    syscall\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jle .Lsp_rde_d\n");
        s = s.write("    addq %rax, %r14\n");
        s = s.write("    jmp .Lsp_rde\n");
        s = s.write(".Lsp_rde_d:\n");
        s = s.write("    movl -80(%rbp), %edi\n    movq $3, %rax\n    syscall\n");
        // wait4(child_pid, &status @ -8, 0, NULL).
        s = s.write("    movq %r15, %rdi\n");
        s = s.write("    leaq -8(%rbp), %rsi\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $0, %r10\n");
        s = s.write("    movq $61, %rax\n");
        s = s.write("    syscall\n");
        // Decode exit status: WIFEXITED → status >> 8; signaled → 128+sig.
        s = s.write("    movl -8(%rbp), %eax\n");
        s = s.write("    testb $127, %al\n");
        s = s.write("    jnz .Lsp_signaled\n");
        s = s.write("    shrl $8, %eax\n");
        s = s.write("    andl $255, %eax\n");
        s = s.write("    jmp .Lsp_have_exit\n");
        s = s.write(".Lsp_signaled:\n");
        s = s.write("    andl $127, %eax\n");
        s = s.write("    addl $128, %eax\n");
        s = s.write(".Lsp_have_exit:\n");
        s = s.write("    movl %eax, %r15d\n");
        // Build stdout box {data=rbx, len=r12}.
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rbx, (%rax)\n");
        s = s.write("    movq %r12, 8(%rax)\n");
        s = s.write("    movq %rax, %rbx\n");
        // Build stderr box {data=r13, len=r14}.
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r13, (%rax)\n");
        s = s.write("    movq %r14, 8(%rax)\n");
        s = s.write("    movq %rax, %r13\n");
        // Build ProcessResult struct: [shape, stdout, stderr, exit_code].
        s = s.write("    movq $32, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    leaq .S" + i32_to_string(prLit.idx) + "(%rip), %rcx\n");
        s = s.write("    movq %rcx, (%rax)\n");
        s = s.write("    movq %rbx, 8(%rax)\n");
        s = s.write("    movq %r13, 16(%rax)\n");
        s = s.write("    movq %r15, 24(%rax)\n");
        // Epilogue.
        s = s.write("    addq $128, %rsp\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_subprocess, .-__fern_subprocess\n");

        // __fern_f64_to_string(%rdi = IEEE-754 f64 bits) → string box.
        // Fixed-precision decimal, a hand-asm transcription of
        // std/float's __float_to_string with k=15: NaN → "NaN"; sign
        // split; Inf (x != 0 && x*2 == x) → "Inf"; integer part via
        // cvttsd2si (truncate toward zero); fractional part scaled by
        // 1e15, truncated, then zero-padded to 15 digits with trailing
        // zeros trimmed (decimal point dropped when the fraction is 0).
        // The 15 fraction digits are staged in a 16-byte stack temp.
        s = s.write(".globl __fern_f64_to_string\n");
        s = s.write(".type __fern_f64_to_string, @function\n");
        s = s.write("__fern_f64_to_string:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // cursor
        s = s.write("    pushq %r12\n");           // buffer base
        s = s.write("    pushq %r13\n");           // intPart / fracInt / effective
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");           // saved f64 bits
        s = s.write("    subq $32, %rsp\n");        // 15-digit fraction temp
        s = s.write("    movq %rdi, %r15\n");       // save bits
        s = s.write("    movq %rdi, %xmm0\n");
        s = s.write("    ucomisd %xmm0, %xmm0\n");
        s = s.write("    jp .Lf2s_nan\n");
        s = s.write("    movq $64, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");       // buffer
        s = s.write("    movq $0, %rbx\n");         // cursor
        s = s.write("    movq %r15, %xmm0\n");      // reload x
        // sign
        s = s.write("    xorpd %xmm2, %xmm2\n");
        s = s.write("    ucomisd %xmm2, %xmm0\n");
        s = s.write("    jae .Lf2s_nonneg\n");
        s = s.write("    movb $45, (%r12,%rbx,1)\n"); // '-'
        s = s.write("    incq %rbx\n");
        s = s.write("    movabsq $-9223372036854775808, %rax\n"); // sign bit
        s = s.write("    movq %rax, %xmm1\n");
        s = s.write("    xorpd %xmm1, %xmm0\n");
        s = s.write(".Lf2s_nonneg:\n");
        // Inf: x != 0 && x*2 == x
        s = s.write("    xorpd %xmm2, %xmm2\n");
        s = s.write("    ucomisd %xmm2, %xmm0\n");
        s = s.write("    je .Lf2s_notinf\n");
        s = s.write("    movabsq $4611686018427387904, %rax\n"); // 2.0
        s = s.write("    movq %rax, %xmm1\n");
        s = s.write("    movsd %xmm0, %xmm3\n");
        s = s.write("    mulsd %xmm1, %xmm3\n");     // x*2
        s = s.write("    ucomisd %xmm0, %xmm3\n");
        s = s.write("    jne .Lf2s_notinf\n");
        s = s.write("    jp .Lf2s_notinf\n");
        s = s.write("    movb $73, (%r12,%rbx,1)\n");  // 'I'
        s = s.write("    incq %rbx\n");
        s = s.write("    movb $110, (%r12,%rbx,1)\n"); // 'n'
        s = s.write("    incq %rbx\n");
        s = s.write("    movb $102, (%r12,%rbx,1)\n"); // 'f'
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lf2s_finish\n");
        s = s.write(".Lf2s_notinf:\n");
        s = s.write("    cvttsd2si %xmm0, %r13\n");  // intPart
        // count int digits → %r8
        s = s.write("    movq %r13, %rax\n");
        s = s.write("    movq $0, %r8\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jne .Lf2s_icnt\n");
        s = s.write("    movq $1, %r8\n");
        s = s.write("    jmp .Lf2s_icntd\n");
        s = s.write(".Lf2s_icnt:\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    je .Lf2s_icntd\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Lf2s_icnt\n");
        s = s.write(".Lf2s_icntd:\n");
        s = s.write("    leaq -1(%rbx,%r8,1), %r9\n");
        s = s.write("    movq %r13, %rax\n");
        s = s.write(".Lf2s_iwr:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%r12,%r9,1)\n");
        s = s.write("    decq %r9\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jne .Lf2s_iwr\n");
        s = s.write("    addq %r8, %rbx\n");         // cursor += intdigits
        // frac = x - intPart
        s = s.write("    cvtsi2sd %r13, %xmm1\n");
        s = s.write("    subsd %xmm1, %xmm0\n");
        s = s.write("    xorpd %xmm2, %xmm2\n");
        s = s.write("    ucomisd %xmm2, %xmm0\n");
        s = s.write("    jae .Lf2s_fracpos\n");
        s = s.write("    movabsq $-9223372036854775808, %rax\n");
        s = s.write("    movq %rax, %xmm1\n");
        s = s.write("    xorpd %xmm1, %xmm0\n");
        s = s.write(".Lf2s_fracpos:\n");
        s = s.write("    movabsq $4831355200913801216, %rax\n"); // 1e15
        s = s.write("    movq %rax, %xmm1\n");
        s = s.write("    mulsd %xmm1, %xmm0\n");
        s = s.write("    cvttsd2si %xmm0, %r13\n");  // fracInt
        // fill 15 padded digits: temp[14..0]
        s = s.write("    movq %r13, %rax\n");
        s = s.write("    movq $14, %r9\n");
        s = s.write(".Lf2s_ffill:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%rsp,%r9,1)\n");
        s = s.write("    decq %r9\n");
        s = s.write("    cmpq $0, %r9\n");
        s = s.write("    jge .Lf2s_ffill\n");
        // effective = 15 - trailing zeros
        s = s.write("    movq $15, %r13\n");
        s = s.write(".Lf2s_ftrim:\n");
        s = s.write("    cmpq $0, %r13\n");
        s = s.write("    je .Lf2s_fdone\n");
        s = s.write("    movq %r13, %rax\n");
        s = s.write("    decq %rax\n");
        s = s.write("    movzbq (%rsp,%rax,1), %rcx\n");
        s = s.write("    cmpq $48, %rcx\n");
        s = s.write("    jne .Lf2s_fdone\n");
        s = s.write("    decq %r13\n");
        s = s.write("    jmp .Lf2s_ftrim\n");
        s = s.write(".Lf2s_fdone:\n");
        s = s.write("    cmpq $0, %r13\n");
        s = s.write("    je .Lf2s_finish\n");
        s = s.write("    movb $46, (%r12,%rbx,1)\n"); // '.'
        s = s.write("    incq %rbx\n");
        s = s.write("    movq $0, %r9\n");
        s = s.write(".Lf2s_fcopy:\n");
        s = s.write("    cmpq %r13, %r9\n");
        s = s.write("    jge .Lf2s_finish\n");
        s = s.write("    movzbq (%rsp,%r9,1), %rcx\n");
        s = s.write("    movb %cl, (%r12,%rbx,1)\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    incq %r9\n");
        s = s.write("    jmp .Lf2s_fcopy\n");
        s = s.write(".Lf2s_finish:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");
        s = s.write("    movq %rbx, 8(%rax)\n");
        s = s.write("    jmp .Lf2s_ret\n");
        s = s.write(".Lf2s_nan:\n");
        s = s.write("    movq $4, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");
        s = s.write("    movb $78, 0(%r12)\n");      // 'N'
        s = s.write("    movb $97, 1(%r12)\n");      // 'a'
        s = s.write("    movb $78, 2(%r12)\n");      // 'N'
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");
        s = s.write("    movq $3, 8(%rax)\n");
        s = s.write(".Lf2s_ret:\n");
        s = s.write("    addq $32, %rsp\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_f64_to_string, .-__fern_f64_to_string\n");

        // __fern_alloc_u8(%rdi = n) → fresh n-element array (this
        // emitter's layout: [cap, len, e0…] at base B, returned B+8,
        // 8-byte slots). Elements start zero (the heap is zeroed .bss).
        s = s.write(".globl __fern_alloc_u8\n");
        s = s.write(".type __fern_alloc_u8, @function\n");
        s = s.write("__fern_alloc_u8:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    movq %rdi, %r12\n");        // n
        s = s.write("    leaq 2(%r12), %rdi\n");     // (n+2)*8 bytes
        s = s.write("    shlq $3, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");       // cap
        s = s.write("    addq $8, %rax\n");
        s = s.write("    movq %r12, (%rax)\n");       // len
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_alloc_u8, .-__fern_alloc_u8\n");

        // __fern_string_from_bytes(%rdi = arr ptr) → string box.
        // Packs the low byte of each element slot into a contiguous
        // len-byte buffer.
        s = s.write(".globl __fern_string_from_bytes\n");
        s = s.write(".type __fern_string_from_bytes, @function\n");
        s = s.write("__fern_string_from_bytes:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");            // arr
        s = s.write("    pushq %r12\n");            // len
        s = s.write("    pushq %r13\n");            // data buf
        s = s.write("    pushq %r14\n");            // i
        s = s.write("    movq %rdi, %rbx\n");
        s = s.write("    movq (%rbx), %r12\n");      // len
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    call __fern_alloc\n");      // len-byte buffer
        s = s.write("    movq %rax, %r13\n");
        s = s.write("    movq $0, %r14\n");
        s = s.write(".Lsfb_loop:\n");
        s = s.write("    cmpq %r12, %r14\n");
        s = s.write("    jge .Lsfb_done\n");
        s = s.write("    movq %r14, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%rbx,%rax,8), %rcx\n"); // slot (i+1)*8
        s = s.write("    movb %cl, (%r13,%r14,1)\n");  // low byte
        s = s.write("    incq %r14\n");
        s = s.write("    jmp .Lsfb_loop\n");
        s = s.write(".Lsfb_done:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r13, (%rax)\n");       // data@0
        s = s.write("    movq %r12, 8(%rax)\n");      // len@8
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_string_from_bytes, .-__fern_string_from_bytes\n");

        // __fern_random_bytes(%rdi = n) → string box of n random bytes
        // via getrandom (syscall 318). Used by std/math's random_int.
        s = s.write(".globl __fern_random_bytes\n");
        s = s.write(".type __fern_random_bytes, @function\n");
        s = s.write("__fern_random_bytes:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");           // n
        s = s.write("    pushq %r12\n");           // buf
        s = s.write("    movq %rdi, %rbx\n");       // n
        s = s.write("    call __fern_alloc\n");     // alloc n bytes (rdi = n)
        s = s.write("    movq %rax, %r12\n");       // buf
        s = s.write("    movq %r12, %rdi\n");       // getrandom(buf, n, 0)
        s = s.write("    movq %rbx, %rsi\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $318, %rax\n");       // sys_getrandom
        s = s.write("    syscall\n");
        s = s.write("    movq $16, %rdi\n");        // string box
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");      // data@0
        s = s.write("    movq %rbx, 8(%rax)\n");     // len@8
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_random_bytes, .-__fern_random_bytes\n");

        // __fern_i32_gcd(%rdi = n, %rsi = other) → gcd(|n|, |other|)
        // by Euclid. Mirrors std/i32.gcd.
        s = s.write(".globl __fern_i32_gcd\n");
        s = s.write(".type __fern_i32_gcd, @function\n");
        s = s.write("__fern_i32_gcd:\n");
        s = s.write("    movq %rdi, %rax\n");        // a = |n|
        s = s.write("    movq %rax, %rdx\n");
        s = s.write("    negq %rdx\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    cmovl %rdx, %rax\n");
        s = s.write("    movq %rsi, %rcx\n");        // b = |other|
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    negq %rdx\n");
        s = s.write("    cmpq $0, %rcx\n");
        s = s.write("    cmovl %rdx, %rcx\n");
        s = s.write(".Lgcd_loop:\n");
        s = s.write("    testq %rcx, %rcx\n");
        s = s.write("    je .Lgcd_done\n");
        s = s.write("    movq %rcx, %r8\n");          // t = b
        s = s.write("    cqto\n");
        s = s.write("    idivq %rcx\n");              // rdx = a % b
        s = s.write("    movq %r8, %rax\n");          // a = t
        s = s.write("    movq %rdx, %rcx\n");         // b = a%b
        s = s.write("    jmp .Lgcd_loop\n");
        s = s.write(".Lgcd_done:\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_i32_gcd, .-__fern_i32_gcd\n");

        // __fern_i32_lcm(%rdi = n, %rsi = other) → lcm. Mirrors
        // std/i32.lcm: 0 if either is 0, else |n/gcd| * |other|.
        s = s.write(".globl __fern_i32_lcm\n");
        s = s.write(".type __fern_i32_lcm, @function\n");
        s = s.write("__fern_i32_lcm:\n");
        s = s.write("    testq %rdi, %rdi\n");
        s = s.write("    je .Llcm_zero\n");
        s = s.write("    testq %rsi, %rsi\n");
        s = s.write("    je .Llcm_zero\n");
        s = s.write("    pushq %rdi\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    call __fern_i32_gcd\n");      // rax = g
        s = s.write("    movq %rax, %rcx\n");          // g
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    movq %rdi, %rax\n");          // n / g
        s = s.write("    cqto\n");
        s = s.write("    idivq %rcx\n");
        s = s.write("    movq %rax, %rdx\n");          // |n/g|
        s = s.write("    negq %rdx\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    cmovl %rdx, %rax\n");
        s = s.write("    movq %rsi, %rcx\n");          // |other|
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    negq %rdx\n");
        s = s.write("    cmpq $0, %rcx\n");
        s = s.write("    cmovl %rdx, %rcx\n");
        s = s.write("    imulq %rcx, %rax\n");
        s = s.write("    ret\n");
        s = s.write(".Llcm_zero:\n");
        s = s.write("    movq $0, %rax\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_i32_lcm, .-__fern_i32_lcm\n");

        // Map runtime (string-keyed, 8-byte values). A Map is a 16-byte
        // box [keys: string[] @0, values: T[] @8]; both start empty.
        // Linear scan + str_eq; set/get grow via __fern_arr_push.
        // Gated on (arr_push && str_eq) — both are marked at every map
        // op, so the gate is true exactly when maps (or both helpers)
        // are used; the runtimes' deps are then guaranteed present.
        if (s.needs_arr_push && s.needs_str_eq) {

        // __fern_map_new(%rdi = capacity hint, ignored) → empty map box.
        s = s.write(".globl __fern_map_new\n");
        s = s.write(".type __fern_map_new, @function\n");
        s = s.write("__fern_map_new:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    subq $8, %rsp\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");        // mapbox
        s = s.write("    movq %rax, %rbx\n");
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    call __fern_alloc_u8\n");      // empty keys
        s = s.write("    movq %rax, (%rbx)\n");
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    call __fern_alloc_u8\n");      // empty values
        s = s.write("    movq %rax, 8(%rbx)\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_new, .-__fern_map_new\n");

        // __fern_map_set(%rdi = mapbox, %rsi = key, %rdx = val) →
        // mapbox. Updates in place on a key hit, else appends.
        // Registers r12-r15/rbx survive __fern_str_eq.
        s = s.write(".globl __fern_map_set\n");
        s = s.write(".type __fern_map_set, @function\n");
        s = s.write("__fern_map_set:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");          // mapbox
        s = s.write("    movq %rsi, %r13\n");          // key
        s = s.write("    movq %rdx, %r14\n");          // val
        s = s.write("    movq (%r12), %r15\n");        // keys arr
        s = s.write("    movq $0, %rbx\n");            // i
        s = s.write("    testq %rcx, %rcx\n");          // keykind (1 = i32)
        s = s.write("    jnz .Lms_loop_i32\n");
        s = s.write(".Lms_loop:\n");                    // string-key loop
        s = s.write("    movq (%r15), %rax\n");        // keys.len
        s = s.write("    cmpq %rax, %rbx\n");
        s = s.write("    jge .Lms_append\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r15,%rax,8), %rdi\n");  // keys[i+1]
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    call __fern_str_eq\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jnz .Lms_found\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lms_loop\n");
        s = s.write(".Lms_loop_i32:\n");                // i32-key loop
        s = s.write("    movq (%r15), %rax\n");
        s = s.write("    cmpq %rax, %rbx\n");
        s = s.write("    jge .Lms_append\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r15,%rax,8), %rax\n");   // keys[i+1]
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    je .Lms_found\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lms_loop_i32\n");
        s = s.write(".Lms_found:\n");
        s = s.write("    movq 8(%r12), %rax\n");        // values arr
        s = s.write("    movq %rbx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq %r14, (%rax,%rdx,8)\n");  // values[i+1] = val
        s = s.write("    jmp .Lms_ret\n");
        s = s.write(".Lms_append:\n");
        s = s.write("    movq (%r12), %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    call __fern_arr_push\n");      // keys.push(key)
        s = s.write("    movq %rax, (%r12)\n");
        s = s.write("    movq 8(%r12), %rdi\n");
        s = s.write("    movq %r14, %rsi\n");
        s = s.write("    call __fern_arr_push\n");      // values.push(val)
        s = s.write("    movq %rax, 8(%r12)\n");
        s = s.write(".Lms_ret:\n");
        s = s.write("    movq %r12, %rax\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_set, .-__fern_map_set\n");

        // __fern_map_get(%rdi = mapbox, %rsi = key) → Option[V]:
        // Some(values[i]) on hit, None otherwise.
        s = s.write(".globl __fern_map_get\n");
        s = s.write(".type __fern_map_get, @function\n");
        s = s.write("__fern_map_get:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");          // mapbox
        s = s.write("    movq %rsi, %r13\n");          // key
        s = s.write("    movq (%r12), %r15\n");        // keys arr
        s = s.write("    movq $0, %rbx\n");
        s = s.write("    testq %rdx, %rdx\n");          // keykind (1 = i32)
        s = s.write("    jnz .Lmg_loop_i32\n");
        s = s.write(".Lmg_loop:\n");                    // string-key loop
        s = s.write("    movq (%r15), %rax\n");
        s = s.write("    cmpq %rax, %rbx\n");
        s = s.write("    jge .Lmg_none\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r15,%rax,8), %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    call __fern_str_eq\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jnz .Lmg_found\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lmg_loop\n");
        s = s.write(".Lmg_loop_i32:\n");                // i32-key loop
        s = s.write("    movq (%r15), %rax\n");
        s = s.write("    cmpq %rax, %rbx\n");
        s = s.write("    jge .Lmg_none\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r15,%rax,8), %rax\n");
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    je .Lmg_found\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lmg_loop_i32\n");
        s = s.write(".Lmg_found:\n");
        s = s.write("    movq 8(%r12), %rax\n");        // values arr
        s = s.write("    movq %rbx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq (%rax,%rdx,8), %r13\n");   // values[i+1]
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");          // Some box
        s = s.write("    movq $0, (%rax)\n");
        s = s.write("    movq %r13, 8(%rax)\n");
        s = s.write("    jmp .Lmg_ret\n");
        s = s.write(".Lmg_none:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");          // None box
        s = s.write("    movq $1, (%rax)\n");
        s = s.write(".Lmg_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_get, .-__fern_map_get\n");

        // __fern_map_has(%rdi = mapbox, %rsi = key) → 0/1.
        s = s.write(".globl __fern_map_has\n");
        s = s.write(".type __fern_map_has, @function\n");
        s = s.write("__fern_map_has:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");
        s = s.write("    movq %rsi, %r13\n");
        s = s.write("    movq (%r12), %r15\n");
        s = s.write("    movq $0, %rbx\n");
        s = s.write("    testq %rdx, %rdx\n");          // keykind (1 = i32)
        s = s.write("    jnz .Lmh_loop_i32\n");
        s = s.write(".Lmh_loop:\n");                    // string-key loop
        s = s.write("    movq (%r15), %rax\n");
        s = s.write("    cmpq %rax, %rbx\n");
        s = s.write("    jge .Lmh_no\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r15,%rax,8), %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    call __fern_str_eq\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jnz .Lmh_yes\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lmh_loop\n");
        s = s.write(".Lmh_loop_i32:\n");                // i32-key loop
        s = s.write("    movq (%r15), %rax\n");
        s = s.write("    cmpq %rax, %rbx\n");
        s = s.write("    jge .Lmh_no\n");
        s = s.write("    movq %rbx, %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r15,%rax,8), %rax\n");
        s = s.write("    cmpq %r13, %rax\n");
        s = s.write("    je .Lmh_yes\n");
        s = s.write("    incq %rbx\n");
        s = s.write("    jmp .Lmh_loop_i32\n");
        s = s.write(".Lmh_yes:\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write("    jmp .Lmh_ret\n");
        s = s.write(".Lmh_no:\n");
        s = s.write("    movq $0, %rax\n");
        s = s.write(".Lmh_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_has, .-__fern_map_has\n");
        }

        // Global string-builder primitive — the amortised-O(1)
        // output accumulator (strbuf_reset / strbuf_append /
        // strbuf_take). Emitted alongside the heap (it allocates via
        // __fern_alloc on take). A string is a 16-byte box
        // {data@0, len@8}. Mirrors the Go backend's
        // emitStrBufRuntime; required so a program that uses strbuf
        // — including asm.fern itself — self-compiles and links.
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_strbuf_len: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_strbuf_data: .skip 16777216\n");   // 16 MiB
        s = s.write("    .section .text\n");
        // reset: len = 0
        s = s.write(".globl __fern_strbuf_reset\n");
        s = s.write("__fern_strbuf_reset:\n");
        s = s.write("    movq $0, __fern_strbuf_len(%rip)\n");
        s = s.write("    ret\n");
        // append(box): copy box.len bytes from box.data to
        // strbuf_data + strbuf_len, then bump len.
        s = s.write(".globl __fern_strbuf_append\n");
        s = s.write("__fern_strbuf_append:\n");
        s = s.write("    movq (%rdi), %rsi\n");                // src data ptr
        s = s.write("    movq 8(%rdi), %rcx\n");               // src len
        s = s.write("    leaq __fern_strbuf_data(%rip), %rdx\n");
        s = s.write("    addq __fern_strbuf_len(%rip), %rdx\n");// dst = data + len
        s = s.write("    cmpq $0, %rcx\n");
        s = s.write("    je .Lsbapp_done\n");
        s = s.write(".Lsbapp_loop:\n");
        s = s.write("    movzbq (%rsi), %rax\n");
        s = s.write("    movb %al, (%rdx)\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    decq %rcx\n");
        s = s.write("    jne .Lsbapp_loop\n");
        s = s.write(".Lsbapp_done:\n");
