    // is just its fd (0 for stdin); read_chunk / close take
    // the fd value directly. No heap box, no by-reference
    // receiver (the Go backend models it differently, but
    // Option values never cross the compiler boundary so the
    // representation only needs to be self-consistent).
    if (name == "stdin" && c.args.len() == 0) {
        s = s.write("    movq $0, %rax\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // Some(x) — wrap a payload in an Option. Heap box
    // [tag=0 @0, payload @8]; the matching None has tag 1.
    if (name == "Some" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    popq %rcx\n");          // payload
        s = enum_payload_retain(c.args[0], s);   // Perceus: retain an rc-tracked array payload
        s = s.write("    movq $0, (%rax)\n");    // tag = Some
        s = s.write("    movq %rcx, 8(%rax)\n"); // payload
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // Ok(x) / Err(x) — wrap a payload in a Result. Same box
    // shape as Option: tag @0, payload @8. Ok = 0 / Err = 1
    // (matches the StmtMatch arm discriminant + the runtime
    // helpers that construct Result via resultOk / resultErr).
    // Without this, a Fern body that `return Ok(...)` or
    // `return Err(...)` falls through to the generic call path
    // and emits `call __fn_Ok` / `call __fn_Err` — undefined
    // at link time. std/fuzz's fuzz_corpus_from_dir hits it.
    if ((name == "Ok" || name == "Err") && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    popq %rcx\n");
        s = enum_payload_retain(c.args[0], s);   // Perceus: retain an rc-tracked array payload
        if (name == "Ok") {
            s = s.write("    movq $0, (%rax)\n");
        } else {
            s = s.write("    movq $1, (%rax)\n");
        }
        s = s.write("    movq %rcx, 8(%rax)\n");
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // Enum variant constructor with a payload: `Circle(x)` where
    // `Circle` is a synthesized variant struct (has the marker
    // field "__ev"). Heap box [shape_ptr @0, payload @8] — the
    // shape ptr is the interned variant name, matching the
    // struct-literal layout so the match's shape-pointer compare
    // works; the payload binds at offset 8 (like Some).
    if (asmcore.is_enum_variant(name, s) && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    popq %rcx\n");          // payload
        s = enum_payload_retain(c.args[0], s);   // Perceus: retain an rc-tracked array payload
        var evLit: asmcore.StringLitOut = asmcore.add_string_lit(s, name);
        s = evLit.state;
        s = s.write("    leaq .S" + util.i32_to_string(evLit.idx) + "(%rip), %rdx\n");
        s = s.write("    movq %rdx, (%rax)\n");  // shape ptr
        s = s.write("    movq %rcx, 8(%rax)\n"); // payload
        s = s.write("    pushq %rax\n");
        return CallOut { state: s, done: true };
    }
    // i32_to_string(n) — convert an i32 to its decimal
    // string box. Useful for composing numeric output
    // into a larger message: `"answer: " + i32_to_string(n)`.
    if (name == "i32_to_string" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_i32_to_string\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_i32_to_string();
        return CallOut { state: s, done: true };
    }
    // `int.int_to_string(n)` — modload mangles the qualified
    // call to `int__int_to_string`. Route it to the native
    // runtime helper rather than core/int's pure-Fern body,
    // which uses raw __memcpy / string_from_bytes through
    // u8[] memory and silently misbehaves under the self-
    // host's u8[] layout. std/http's response serializer
    // chains `... + int.int_to_string(resp.status) + ...`.
    if (name == "int__int_to_string" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_i32_to_string\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_i32_to_string();
        return CallOut { state: s, done: true };
    }
    // str_to_i32(s) — parse a string box into an i32.
    // Leading whitespace not handled; optional leading
    // `-`, then decimal digits, stops at first non-digit.
    if (name == "str_to_i32" && c.args.len() == 1) {
        // __fern_str_to_i32 is a Fern runtime function (#2649): call it via the
        // ordinary __fn_ stack convention (the borrowed string is param[0]).
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_str_to_i32\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_to_i32();
        return CallOut { state: s, done: true };
    }
    // str_starts_with(s, prefix) — bool. Checks first
    // len(prefix) bytes of s match prefix verbatim.
    if (name == "str_starts_with" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_starts_with\n    addq $16, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    if (name == "str_ends_with" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_ends_with\n    addq $16, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    // str_contains(s, needle) — bool. Linear search.
    if (name == "str_contains" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_index_of\n    addq $16, %rsp\n");
        // Convert -1 (not found) / >=0 to bool.
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    setge %al\n");
        s = s.write("    movzbq %al, %rax\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    // str_index_of(s, needle) — i32. First match offset
    // or -1 if not found.
    if (name == "str_index_of" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rsi\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_index_of\n    addq $16, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    // str_trim(s) — strip leading + trailing ASCII
    // whitespace (space, tab, '\n', '\r'). Returns a
    // new 16-byte box pointing into the same char data
    // with adjusted ptr + len. Heap-allocs the new box.
    if (name == "str_trim" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_str_trim\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_search();
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // str_to_upper(s) / str_to_lower(s) — ASCII case
    // conversion. Returns a new string box with newly
    // heap-allocated char data (the original bytes
    // aren't mutated).
    if (name == "str_to_upper" && c.args.len() == 1) {
        // __fern_str_to_upper is a Fern runtime function now (#2649, via the
        // raw-memory intrinsics): __fn_ stack convention. mark_str_case pulls heap.
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_str_to_upper\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_case();
        return CallOut { state: s, done: true };
    }
    if (name == "str_to_lower" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_str_to_lower\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_case();
        return CallOut { state: s, done: true };
    }
    // str_repeat(s, n) — concat s with itself n times.
    // n <= 0 yields empty.
    if (name == "str_repeat" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rsi\n");   // n
        s = s.write("    popq %rdi\n");   // s
        // __fn_ stack convention: param[0]=s on top (+16), param[1]=n below (+24).
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_repeat\n    addq $16, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_repeat();
        return CallOut { state: s, done: true };
    }
    // str_replace(s, old, new) — replace all occurrences
    // of `old` in `s` with `new`. Empty old → s unchanged.
    if (name == "str_replace" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);   // h
        s = emit_expr(c.args[1], s);   // o
        s = emit_expr(c.args[2], s);   // nw
        s = s.write("    popq %rdx\n");   // nw
        s = s.write("    popq %rsi\n");   // o
        s = s.write("    popq %rdi\n");   // h
        // __fn_ stack convention: param[0]=h on top (+16), param[1]=o (+24),
        // param[2]=nw (+32). Push param2, param1, param0.
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_replace\n    addq $24, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_replace();
        return CallOut { state: s, done: true };
    }
    // chr(n) — convert an i32 byte value to a single-
    // char string box. Useful for building up strings
    // byte by byte (e.g. constructing escape sequences).
    if (name == "chr" && c.args.len() == 1) {
        // __fern_chr is a Fern runtime function now (#2649, via the raw-memory
        // intrinsics): __fn_ stack convention (b=param[0] at +16). mark_chr pulls
        // in heap. No longer rides the str_search bundle.
        s = emit_expr(c.args[0], s);
        s = s.write("    call __fn___fern_chr\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_chr();
        return CallOut { state: s, done: true };
    }
    // strbuf_reset() / strbuf_append(s) / strbuf_take() —
    // the global string-builder primitive. The Go backend
    // emits these as builtins; the self-host emitter must do
    // the same, otherwise a program that uses strbuf (such as
    // asm.fern itself — its `write` routes through it) links
    // with undefined `__fern_strbuf_*` references. Register
    // calling convention like the other runtime helpers
    // (arg in %rdi), NOT the stack-arg user-call path.
    // mark_heap pulls in __fern_alloc (strbuf_take allocates)
    // and gates the runtime emission below on needs_heap.
    if (name == "strbuf_reset" && c.args.len() == 0) {
        s = s.write("    call __fern_strbuf_reset\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "strbuf_append" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rdi\n");
        s = s.write("    call __fern_strbuf_append\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "strbuf_take" && c.args.len() == 0) {
        s = s.write("    call __fern_strbuf_take\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    return CallOut { state: s, done: false };
}

// emit_method_call lowers a method / field-access call
// (obj.method(args)): the reader, map, string and array
// intrinsics plus the runtime shape-pointer dispatch over
// struct + enum receiver methods. Split out of emit_call's
// callee match; the arm always handles the call (a no-match
// pushes the -1 sentinel), so this returns EmitState directly.
function emit_method_call(c: parser.ExprCall, fa: parser.ExprFieldAccess, s: asmcore.EmitState): asmcore.EmitState {
    // Reader.read_chunk(n) — read up to n bytes from
    // the receiver fd; returns Some(string) on a
    // non-empty read, None at EOF. The receiver is a
    // Reader (its fd value); see stdin().
    if (fa.field == "read_chunk" && c.args.len() == 1) {
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rsi\n");   // n
        s = s.write("    popq %rdi\n");   // fd
        s = s.write("    call __fern_reader_read_chunk\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return s;
    }
    // Reader.close(n) — close the receiver fd. Always
    // returns None (the IoError arm is unused here).
    if (fa.field == "close" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rdi\n");   // fd
        s = s.write("    call __fern_reader_close\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        return s;
    }
    // Primitive-receiver fast path: when the
    // receiver's inferred type is "string" /
    // "i32" / "bool" / "f64", skip the shape-
    // pointer dispatch chain (those values
    // aren't heap-boxed with a shape ptr) and
    // call `__fn_<type>__<method>` directly.
    var prim_recv: asmcore.Ty = asmcore.infer_expr_type(fa.obj, s);
    // Cell[T] (docs/CELL-TYPE-PLAN.md): a single-slot box.
    // get() loads slot 0; set(v) stores it in place and returns
    // void (a dummy is pushed so the surrounding statement pops
    // something, like __set_index). Leak-everything heap, so no RC.
    if (asmcore.is_cell(prim_recv) && fa.field == "get" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq (%rax), %rax\n");
        s = s.write("    pushq %rax\n");
        return s;
    }
    if (asmcore.is_cell(prim_recv) && fa.field == "set" && c.args.len() == 1) {
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rcx\n");          // value
        s = s.write("    popq %rax\n");          // cell ptr
        s = s.write("    movq %rcx, (%rax)\n");
        s = s.write("    pushq $0\n");           // void result placeholder
        return s;
    }
    // Map methods (string-keyed). set returns the
    // (mutated) map; get → Option[V]; has → bool;
    // len → i32.
    if (asmcore.is_map(prim_recv) && (fa.field == "insert") && c.args.len() == 2) {
        var kk_set: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_set = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    popq %rdx\n");   // v
        s = s.write("    popq %rsi\n");   // k
        s = s.write("    popq %rdi\n");   // mapbox
        s = s.write("    movq $" + kk_set + ", %rcx\n");   // keykind
        s = s.write("    call __fern_map_set\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    // m.without(k) — remove key k, returning the
    // tuple (map, existed). The runtime shifts the parallel
    // keys[]/values[] down over the hit slot (preserving order)
    // and shrinks both lengths; the result is a 2-slot box that
    // the tuple-destructure path reads as box[0]=map, box[1]=
    // existed. mark_arr_push keeps the map-runtime block (gated
    // on needs_arr_push && needs_str_eq) emitted even for a
    // program that only constructs + deletes.
    if (asmcore.is_map(prim_recv) && (fa.field == "without") && c.args.len() == 1) {
        var kk_del: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_del = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rsi\n");   // k
        s = s.write("    popq %rdi\n");   // mapbox
        s = s.write("    movq $" + kk_del + ", %rdx\n");   // keykind
        s = s.write("    call __fern_map_delete\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "get" && c.args.len() == 1) {
        var kk_get: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_get = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rsi\n");   // k
        s = s.write("    popq %rdi\n");   // mapbox
        s = s.write("    movq $" + kk_get + ", %rdx\n");   // keykind
        s = s.write("    call __fern_map_get\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        return s;
    }
    // m.get_or(k, default) — equivalent to `match m.get(k)
    // { Some(v) => v, None => default }`, but inlined so
    // core/map's open-addressing body (which doesn't
    // match the native __fern_map_* runtime layout)
    // never runs. Without this the generic struct
    // shape-dispatch reads garbage out of the map box
    // and segfaults — std/test's assert_json_eq_field_*
    // helpers (via core/map's m.get_or) hit it.
    if (asmcore.is_map(prim_recv) && fa.field == "get_or" && c.args.len() == 2) {
        var kk_or: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_or = "1"; }
        var or_lbl: i32 = s.label_n;
        s = asmcore.EmitState { ...s, label_n: s.label_n + 2 };
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        // stack: [default, k, mapbox] (top down).
        s = s.write("    popq %rdx\n");   // default (saved on stack below)
        s = s.write("    popq %rsi\n");   // k
        s = s.write("    popq %rdi\n");   // mapbox
        s = s.write("    pushq %rdx\n");  // save default across call
        s = s.write("    movq $" + kk_or + ", %rdx\n");
        s = s.write("    call __fern_map_get\n");   // rax = Option box
        s = s.write("    popq %rdx\n");   // restore default
        s = s.write("    movq (%rax), %rcx\n");  // tag (0=Some, 1=None)
        s = s.write("    testq %rcx, %rcx\n");
        s = s.write("    jnz .Lgo_def_" + util.i32_to_string(or_lbl) + "\n");
        s = s.write("    movq 8(%rax), %rax\n");  // Some payload
        s = s.write("    jmp .Lgo_end_" + util.i32_to_string(or_lbl) + "\n");
        s = s.write(".Lgo_def_" + util.i32_to_string(or_lbl) + ":\n");
        s = s.write("    movq %rdx, %rax\n");
        s = s.write(".Lgo_end_" + util.i32_to_string(or_lbl) + ":\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "has" && c.args.len() == 1) {
        var kk_has: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_has = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    popq %rsi\n");   // k
        s = s.write("    popq %rdi\n");   // mapbox
        s = s.write("    movq $" + kk_has + ", %rdx\n");   // keykind
        s = s.write("    call __fern_map_has\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_str_eq();
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "len" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq (%rax), %rax\n");   // keys arr
        s = s.write("    movq (%rax), %rax\n");   // keys.len
        s = s.write("    pushq %rax\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    // m.keys() / m.values() — the map box already holds
    // the parallel keys[]/values[] arrays at offset 0/8,
    // so return them directly (live snapshots; the
    // self-host compiler isn't perf-/aliasing-critical).
    if (asmcore.is_map(prim_recv) && fa.field == "keys" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq (%rax), %rax\n");   // keys arr
        s = s.write("    pushq %rax\n");
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "values" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq 8(%rax), %rax\n");  // values arr
        s = s.write("    pushq %rax\n");
        return s;
    }
    // Map iteration. m.iter() → a 16-byte iterator box
    // [map_ptr @0, cursor @8]; has_next / key / value /
    // advance read or bump the cursor over the parallel
    // keys[] / values[] arrays.
    if (asmcore.is_map(prim_recv) && fa.field == "iter" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);                 // map ptr
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    popq %rcx\n");           // map ptr
        s = s.write("    movq %rcx, (%rax)\n");   // map @0
        s = s.write("    movq $0, 8(%rax)\n");    // cursor @8
        s = s.write("    pushq %rax\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "has_next" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");           // iter
        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
        s = s.write("    movq (%rax), %rdx\n");   // map
        s = s.write("    movq (%rdx), %rdx\n");   // keys arr
        s = s.write("    movq (%rdx), %rdx\n");   // keys.len
        s = s.write("    cmpq %rdx, %rcx\n");
        s = s.write("    movq $0, %rax\n");
        s = s.write("    setl %al\n");
        s = s.write("    movzbq %al, %rax\n");
        s = s.write("    pushq %rax\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "key" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
        s = s.write("    movq (%rax), %rdx\n");   // map
        s = s.write("    movq (%rdx), %rdx\n");   // keys arr
        s = s.write("    incq %rcx\n");
        s = s.write("    movq (%rdx,%rcx,8), %rax\n");  // keys[cursor+1]
        s = s.write("    pushq %rax\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "value" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
        s = s.write("    movq (%rax), %rdx\n");   // map
        s = s.write("    movq 8(%rdx), %rdx\n");  // values arr
        s = s.write("    incq %rcx\n");
        s = s.write("    movq (%rdx,%rcx,8), %rax\n");  // values[cursor+1]
        s = s.write("    pushq %rax\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "advance" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");           // iter
        s = s.write("    movq 8(%rax), %rcx\n");  // cursor
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %rcx, 8(%rax)\n");
        s = s.write("    pushq $0\n");            // dummy result
        return s;
    }
    // Built-in `.len()` on string / array values.
    // String boxes carry the byte-count at offset
    // 8; array boxes carry the element-count at
    // offset 0. Same inline load as the legacy
    // `len(x)` free-function form used to emit.
    if (fa.field == "len" && c.args.len() == 0
            && (asmcore.ty_is_string(prim_recv)
                || asmcore.ty_is_array(prim_recv)
                || asmcore.is_int_array_tag(prim_recv)
                || asmcore.ty_is_array_string(prim_recv))) {
        s = emit_expr(fa.obj, s);
        s = s.write("    popq %rax\n");
        if (asmcore.ty_is_string(prim_recv)) {
            s = s.write("    movq 8(%rax), %rax\n");
        } else {
            s = s.write("    movq (%rax), %rax\n");
        }
        s = s.write("    pushq %rax\n");
        return s;
    }
    // Built-in `.to_string()` on a u32 receiver routes to the UNSIGNED
    // __fern_u32_to_string runtime helper, NOT the signed __fern_i32_to_string:
    // the latter mis-renders a value with bit 31 set (e.g. `(0 as u32) - (1 as
    // u32)` = 4294967295), reading the low 32 bits as a negative i32 in its
    // digit loop. Must come before the is_int_tag shortcut below, which would
    // otherwise catch u32. (#2649 — exposed when i32_to_string moved from the
    // tolerant 64-bit hand-asm to the strict-i32 Fern helper. A runtime helper
    // (not std/u32's method) so it works without `import "std/u32"`, as the i32
    // builtin did.)
    if (fa.field == "to_string" && c.args.len() == 0 && asmcore.ty_is_u32(prim_recv)) {
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn___fern_u32_to_string\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_u32_to_string();
        return s;
    }
    // 64-bit receivers must NOT fall into the is_int_tag shortcut below:
    // __fern_i32_to_string reads only the low 32 bits of its arg slot, so a
    // wide i64/u64 silently truncated (1234567890123 printed as 1912276171).
    // Route to the width-correct runtime helpers, mirroring the u32 case.
    if (fa.field == "to_string" && c.args.len() == 0 && asmcore.ty_is_i64(prim_recv)) {
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn___fern_i64_to_string\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_i64_to_string();
        return s;
    }
    if (fa.field == "to_string" && c.args.len() == 0 && asmcore.ty_is_u64(prim_recv)) {
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn___fern_u64_to_string\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.mark_u64_to_string();
        return s;
    }
    // Built-in `.to_string()` on i32 and string —
    // i32 routes to the existing runtime helper,
    // string returns the receiver unchanged. The
    // generic path below would chase a
    // `__fn_i32.to_string` symbol that no FuncDecl
    // emits, producing a link error.
    if (fa.field == "to_string" && c.args.len() == 0
            && (asmcore.is_int_tag(prim_recv) || asmcore.ty_is_string(prim_recv))) {
        s = emit_expr(fa.obj, s);
        if (asmcore.is_int_tag(prim_recv)) {
            // The WIDTH-64 helper, not __fern_i32_to_string: this backend
