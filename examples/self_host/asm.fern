        s = s.write("    cmpq %r14, %rcx\n");
        s = s.write("    jg .Larr_push_copy_done\n");
        s = s.write("    movq (%r12,%rcx,8), %rdx\n");
        s = s.write("    movq %rdx, (%rax,%rcx,8)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Larr_push_copy\n");
        s = s.write(".Larr_push_copy_done:\n");
        // Store the new value at slot (len+1).
        s = s.write("    movq %r14, %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %r13, (%rax,%rcx,8)\n");
        s = s.write(".Larr_push_ret:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
