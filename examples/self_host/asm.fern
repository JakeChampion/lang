    // is an 8-byte payload — i32 zero-extended or string-
    // box ptr.
    if (s.needs_arr_slice) {
        s = s.write("__fern_arr_slice:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");      // src arr ptr
        s = s.write("    movq %rsi, %r13\n");      // start
        s = s.write("    movq %rdx, %r14\n");      // end
        s = s.write("    movq %r14, %r15\n");
        s = s.write("    subq %r13, %r15\n");      // new len = end - start
