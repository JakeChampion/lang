        }
        if (fa.field == "index_of" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_str_index_of\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            return s;
        }
        if (fa.field == "trim" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_str_trim\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            s = s.mark_heap();
            return s;
        }
        if (fa.field == "to_upper" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_str_to_upper\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            s = s.mark_heap();
            return s;
        }
        if (fa.field == "to_lower" && c.args.len() == 0) {
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_str_to_lower\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            s = s.mark_heap();
            return s;
        }
        if (fa.field == "repeat" && c.args.len() == 1) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_str_repeat\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            s = s.mark_heap();
            return s;
        }
        if (fa.field == "replace" && c.args.len() == 2) {
            s = emit_expr(fa.obj, s);
            s = emit_expr(c.args[0], s);
            s = emit_expr(c.args[1], s);
            s = s.write("    popq %rdx\n");
            s = s.write("    popq %rsi\n");
            s = s.write("    popq %rdi\n");
            s = s.write("    call __fern_str_replace\n");
            s = s.write("    pushq %rax\n");
            s = s.mark_str_search();
            s = s.mark_heap();
            return s;
        }
    }
    if (asmcore.ty_is_string(prim_recv) || asmcore.is_int_tag(prim_recv) || asmcore.ty_is_bool(prim_recv) || asmcore.ty_is_f64(prim_recv)) {
        var pmi: i32 = c.args.len() - 1;
        while (pmi >= 0) {
            s = emit_expr(c.args[pmi], s);
            pmi = pmi - 1;
        }
        s = emit_expr(fa.obj, s);
        s = s.write("    call __fn_" + asmcore.sanitize_label(asmcore.ty_tag(prim_recv) + "." + fa.field) + "\n");
        s = s.write("    addq $" + asmcore.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
        s = s.write("    pushq %rax\n");
        return s;
    }
    // Method call: `obj.method(args)`. Push
    // args right-to-left, then push the
    // receiver (so receiver sits at +16(%rbp)
    // and arg[0] at +24(%rbp) inside the
    // callee). Then dispatch on the receiver's
    // shape pointer.
    var mi: i32 = c.args.len() - 1;
    while (mi >= 0) {
        // Mirror the free-function call's `fn`-arg
        // boxing so `f.bench("…", n, my_workload)`
        // wraps `my_workload` as a closure value
        // instead of calling it 0-arg here. Without
        // this the callee receives `my_workload()`'s
        // return value (garbage) and crashes on the
        // indirect call inside its body.
        var fvn: string = asmcore.arg_fn_value_name(c.args[mi], fa.field, mi, s);
        if (fvn.len() > 0) { s = emit_fn_value(fvn, s); }
        else { s = emit_expr(c.args[mi], s); }
        mi = mi - 1;
    }
    s = emit_expr(fa.obj, s);
    // Peek receiver pointer (top of stack) to
    // read its shape pointer; load shape into
    // %rcx without consuming the receiver.
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");
    var m_end_lbl: i32 = s.label_n;
    s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
    // For each func whose name matches and
    // receiver_type is non-empty, emit a shape-
    // compare arm. Walk in declaration order so
    // the asm is deterministic.
    var fdi: i32 = 0;
    while (fdi < s.funcs.len()) {
        var fd_m: parser.FuncDecl = s.funcs[fdi];
        // Only emit shape-compare arms for STRUCT (incl.
        // enum-variant) receiver types — a value's runtime
        // shape is always one of these. A method whose
        // receiver_type is an ENUM name is handled in the
        // fallback below (the variant value's shape won't
        // match any struct arm).
        if (fd_m.name == fa.field && fd_m.receiver_type.len() > 0
                && asmcore.is_struct_decl_name(asmcore.base_type_name(fd_m.receiver_type), s)) {
            var arm_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, asmcore.base_type_name(fd_m.receiver_type));
            s = arm_lit.state;
            var next_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = next_l.state;
            s = s.write("    leaq .S" + asmcore.i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
            s = s.write("    cmpq %rdx, %rcx\n");
            s = s.write("    jne " + next_l.name + "\n");
            s = s.write("    call __fn_" + asmcore.sanitize_label(asmcore.base_type_name(fd_m.receiver_type) + "." + fd_m.name) + "\n");
            // Caller cleans up args + receiver.
            s = s.write("    addq $" + asmcore.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
            s = s.write("    pushq %rax\n");
            s = s.write("    jmp .Lmethod_end_" + asmcore.i32_to_string(m_end_lbl) + "\n");
            s = s.write(next_l.name + ":\n");
        }
        fdi = fdi + 1;
    }
    // Enum-receiver fallback: a method registered on an
    // enum TYPE (receiver_type not a struct decl). The
    // receiver here is a variant value whose shape matched
    // no struct arm; call the enum method, whose internal
    // `match (self)` dispatches on the variant. First such
    // method wins (method names are effectively unique).
    var enum_recv: string = "";
    var efi: i32 = 0;
    while (efi < s.funcs.len()) {
        var efd: parser.FuncDecl = s.funcs[efi];
        if (enum_recv.len() == 0 && efd.name == fa.field && efd.receiver_type.len() > 0
                && asmcore.is_enum_recv(asmcore.base_type_name(efd.receiver_type), s)) {
            enum_recv = asmcore.base_type_name(efd.receiver_type);
        }
        efi = efi + 1;
    }
    if (enum_recv.len() > 0) {
        s = s.write("    call __fn_" + asmcore.sanitize_label(enum_recv + "." + fa.field) + "\n");
        s = s.write("    addq $" + asmcore.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
        s = s.write("    pushq %rax\n");
        s = s.write(".Lmethod_end_" + asmcore.i32_to_string(m_end_lbl) + ":\n");
        return s;
    }
    // Fallthrough: no matching method. Clean up
    // args + receiver, push sentinel -1.
    s = s.write("    addq $" + asmcore.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write("    pushq %rax\n");
    s = s.write(".Lmethod_end_" + asmcore.i32_to_string(m_end_lbl) + ":\n");
    return s;
    return s;
}

function emit_call(c: parser.ExprCall, s: asmcore.EmitState): asmcore.EmitState {
    var name: string = "";
    // Inline-lambda call (IIFE), e.g. an if-expression desugar
    // `(function(): T { … })()`. Emit the closure box, push the
    // args above it, then invoke via the closure convention (box
    // ptr in %r10, args at +16(%rbp), …) — same as the local-
    // closure path below, but the box is the inline lambda's.
    match (c.callee) {
        parser.ExprLambda(_) => {
            s = emit_expr(c.callee, s);          // push closure box
            var la: i32 = c.args.len() - 1;
            while (la >= 0) {
                s = emit_expr(c.args[la], s);
                la = la - 1;
            }
            s = s.write("    movq " + asmcore.i32_to_string(c.args.len() * 8) + "(%rsp), %r10\n"); // box ptr
            s = s.write("    movq (%r10), %rdx\n");
            s = s.write("    call *%rdx\n");
            s = s.write("    addq $" + asmcore.i32_to_string((c.args.len() + 1) * 8) + ", %rsp\n"); // pop args + box
            s = s.write("    pushq %rax\n");
            return s;
        },
        _ => {}
    }
    match (c.callee) {
        parser.ExprIdent(id) => { name = id.name; },
        parser.ExprFieldAccess(fa) => {
            return emit_method_call(c, fa, s);
        },
        _ => {
            s = s.write("    # call target not ident\n");
            s = s.write("    pushq $0\n");
            return s;
        }
    }
    // print(str_literal) — builtin lowering to write(1, ptr, len).
    // Compile-time we already know the literal's bytes, so we
    // intern it in `.rodata`, look up the offset, and emit the
    // syscall directly. Other string-typed args fall through
    // as unsupported.
    // len(arr) — load the length prefix at offset 0
    // of the array box. Today this assumes the arg is
    // an array (a string arg would read random bytes);
    // a future slice with type info can route string
    // arguments through __fern_str_len.
    var bo: CallOut = try_emit_builtin(c, name, s);
    s = bo.state;
    if (bo.done) { return s; }
    // Closure call: callee ident resolves to a local
    // holding a closure box ptr. The box layout is
    // [fn_addr, cap0, cap1, …] (always-boxed, even for
    // capture-less lambdas — see the ExprLambda arm).
    //
    // Calling convention: push args RIGHT-to-LEFT (so the
    // callee sees param[0] at +16(%rbp) — IDENTICAL to a
    // direct call), then load the box ptr into %r10 and
    // indirect-call box[0]. The callee body reads the box
    // from %r10 (a closure stashes it in its first local;
    // a plain top-level function used as a value ignores
    // it). This box-in-register shape means a plain
    // function and a closure share one call convention with
    // no param shifting and no per-function trampolines.
    if (s.has_local(name)) {
        var ci: i32 = c.args.len() - 1;
        while (ci >= 0) {
            s = emit_expr(c.args[ci], s);
            ci = ci - 1;
        }
        var off: i32 = s.lookup_local(name);
        s = s.write("    movq " + asmcore.i32_to_string(off) + "(%rbp), %r10\n");
        s = s.write("    movq (%r10), %rdx\n");
        s = s.write("    call *%rdx\n");
        // Caller cleanup: args only (box was in a register).
        if (c.args.len() > 0) {
            s = s.write("    addq $" + asmcore.i32_to_string(c.args.len() * 8) + ", %rsp\n");
        }
        s = s.write("    pushq %rax\n");
        return s;
    }
    // Generic user-function call. Push args RIGHT-to-LEFT
    // so the callee sees param[0] at +16(%rbp) (after
    // `pushq %rbp` + the return address). The callee
    // prologue copies args from those positive offsets
    // into local slots so the body reads them like any
    // other local.
    var i: i32 = c.args.len() - 1;
    while (i >= 0) {
        var fvn: string = asmcore.arg_fn_value_name(c.args[i], name, i, s);
        if (fvn.len() > 0) { s = emit_fn_value(fvn, s); }
        else { s = emit_expr(c.args[i], s); }
        i = i - 1;
    }
    s = s.write("    call __fn_" + asmcore.sanitize_label(name) + "\n");
    // Caller cleans up stack args (System V style for
    // pure-stack args; we don't use the register-arg
    // path of the standard SysV ABI).
    if (c.args.len() > 0) {
        s = s.write("    addq $" + asmcore.i32_to_string(c.args.len() * 8) + ", %rsp\n");
    }
    // Result is in %rax — push for the surrounding
    // expression's stack-machine semantics.
    s = s.write("    pushq %rax\n");
    return s;
    return s;
}

function emit_expr(e: parser.Expr, s: asmcore.EmitState): asmcore.EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) {
                // Float literal: GAS converts the decimal text to an
                // IEEE-754 double in .rodata; load its bits and push
                // them (floats flow through the rt-stack as their
                // 8-byte bit pattern, like every other value).
                var fl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = fl.state;
                s = s.write("    .section .rodata\n");
                s = s.write(fl.name + ": .double " + n.text + "\n");
                s = s.write("    .text\n");
                s = s.write("    movsd " + fl.name + "(%rip), %xmm0\n");
                s = s.write("    movq %xmm0, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    movq $" + n.text + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprBinary(b) => {
            // String-aware dispatch: `s + t` where either side
            // is a string lowers to __fern_str_concat; `s == t`
            // / `s != t` for strings lowers to __fern_str_eq.
            // Type info comes from infer_expr_type on the
            // operands — that walks the AST + local_types.
            if (b.op == "+") {
                var lt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var rt: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(lt) || asmcore.ty_is_string(rt)) {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");      // rhs
                    s = s.write("    popq %rdi\n");      // lhs
                    s = s.write("    call __fern_str_concat\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var ert: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(elt) || asmcore.ty_is_string(ert)) {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __fern_str_eq\n");
                    if (b.op == "!=") {
                        s = s.write("    xorq $1, %rax\n");
                    }
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: route < / <= / > / >= for
            // string operands through __fern_str_cmp, then
            // compare its signed result against zero to derive
            // the bool.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var ort: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(olt) || asmcore.ty_is_string(ort)) {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __fern_str_cmp\n");
                    s = s.write("    cmpq $0, %rax\n");
                    s = s.write("    movq $0, %rax\n");
                    if (b.op == "<") { s = s.write("    setl %al\n"); }
                    else if (b.op == "<=") { s = s.write("    setle %al\n"); }
                    else if (b.op == ">") { s = s.write("    setg %al\n"); }
                    else { s = s.write("    setge %al\n"); }
                    s = s.write("    movzbq %al, %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. The right operand's
            // side effects must not run when the left already
            // decides the result. `&&` short-circuits on false
            // (left == 0 ⇒ result = 0); `||` short-circuits on
            // true (left != 0 ⇒ result = 1). Otherwise the
            // right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    popq %rax\n");
                s = s.write("    testq %rax, %rax\n");
                var short_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = short_l.state;
                var end_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    jz " + short_l.name + "\n");
                } else {
                    s = s.write("    jnz " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    movq $0, %rax\n");
                } else {
                    s = s.write("    movq $1, %rax\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Float (f64) arithmetic + comparison. Operands flow as
            // 8-byte bit patterns; load into xmm regs and operate.
            // Arithmetic pushes the result bits; comparison pushes a
            // 0/1 i32. Detected when either operand infers as f64.
            var is_flt: boolean = asmcore.ty_is_f64(asmcore.infer_expr_type(b.left, s)) || asmcore.ty_is_f64(asmcore.infer_expr_type(b.right, s));
            if (is_flt && (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm1\n");   // rhs
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm0\n");   // lhs
                if (b.op == "+") { s = s.write("    addsd %xmm1, %xmm0\n"); }
                else if (b.op == "-") { s = s.write("    subsd %xmm1, %xmm0\n"); }
                else if (b.op == "*") { s = s.write("    mulsd %xmm1, %xmm0\n"); }
                else { s = s.write("    divsd %xmm1, %xmm0\n"); }
                s = s.write("    movq %xmm0, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (is_flt && (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "==" || b.op == "!=")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm1\n");   // rhs
                s = s.write("    popq %rax\n");
                s = s.write("    movq %rax, %xmm0\n");   // lhs
                s = s.write("    ucomisd %xmm1, %xmm0\n");
                s = s.write("    movq $0, %rax\n");
                // IEEE: every relation with NaN is false; equality with
                // NaN is also false; only `!=` returns true on NaN.
                // ucomisd sets CF=ZF=PF=1 for unordered, so plain setb /
                // setbe would mis-report `NaN < x` and `NaN <= x` as
                // true. Mask `<` and `<=` with `setnp` (PF=0 → ordered);
                // `==` gates on ordered-AND-equal, `!=` accepts either
                // ordered-not-equal OR unordered. `>` / `>=` map to
                // seta / setae which already require CF=0, so unordered
                // (CF=1) is automatically false.
                if (b.op == "<") {
                    s = s.write("    setb %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else if (b.op == "<=") {
                    s = s.write("    setbe %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else if (b.op == ">") { s = s.write("    seta %al\n"); }
                else if (b.op == ">=") { s = s.write("    setae %al\n"); }
                else if (b.op == "==") {
                    s = s.write("    sete %al\n");
                    s = s.write("    setnp %dl\n");
                    s = s.write("    andb %dl, %al\n");
                }
                else {
                    s = s.write("    setne %al\n");
                    s = s.write("    setp %dl\n");
                    s = s.write("    orb %dl, %al\n");
                }
                s = s.write("    movzbq %al, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    popq %rcx\n");        // rhs
            s = s.write("    popq %rax\n");        // lhs
            if (b.op == "+") {
                s = s.write("    addq %rcx, %rax\n");
            } else if (b.op == "-") {
                s = s.write("    subq %rcx, %rax\n");
            } else if (b.op == "*") {
                s = s.write("    imulq %rcx, %rax\n");
            } else if (b.op == "/") {
                // idivq: dividend in rdx:rax (sign-extended via
                // cqto), divisor in operand. Result quotient in
                // rax, remainder in rdx.
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
            } else if (b.op == "%") {
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
                s = s.write("    movq %rdx, %rax\n");
            } else if (b.op == "&") {
                s = s.write("    andq %rcx, %rax\n");
            } else if (b.op == "|") {
                s = s.write("    orq %rcx, %rax\n");
            } else if (b.op == "^") {
                s = s.write("    xorq %rcx, %rax\n");
            } else if (b.op == "<<") {
                s = s.write("    shlq %cl, %rax\n");
            } else if (b.op == ">>") {
                // Arithmetic (signed) shift right — Fern i32 is signed.
                s = s.write("    sarq %cl, %rax\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmpq rhs, lhs` sets flags from
                // (lhs - rhs); setcc materialises the bool in
                // %al, movzbq zero-extends into %rax so the
                // surrounding stack push gets a clean 0/1.
                // Pick signed vs unsigned set instructions from the
                // operand tags — `u32` / `u64` / `usize` use
                // setb / setbe / seta / setae so values near u64-max
                // sort/compare in the expected order.
                var is_unsigned: boolean = asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.left, s))
                    || asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.right, s));
                s = s.write("    cmpq %rcx, %rax\n");
                var cc: string = "";
                if (b.op == "<") { if (is_unsigned) { cc = "setb"; } else { cc = "setl"; } }
                else if (b.op == "<=") { if (is_unsigned) { cc = "setbe"; } else { cc = "setle"; } }
                else if (b.op == ">") { if (is_unsigned) { cc = "seta"; } else { cc = "setg"; } }
                else if (b.op == ">=") { if (is_unsigned) { cc = "setae"; } else { cc = "setge"; } }
                else if (b.op == "==") { cc = "sete"; }
                else { cc = "setne"; }
                s = s.write("    " + cc + " %al\n");
                s = s.write("    movzbq %al, %rax\n");
            } else {
                s = s.write("    # unsupported binop: " + b.op + "\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnary(u) => {
            // `expr?` try operator: unwrap a Some/Ok payload, or
            // early-return the None/Err box from the enclosing function.
            if (u.op == "try_") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");          // option/result box
                s = s.write("    movq (%rax), %rcx\n");  // tag (0 = Some/Ok)
                var tlbl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = tlbl.state;
                s = s.write("    testq %rcx, %rcx\n");
                s = s.write("    jz " + tlbl.name + "\n");
                // None/Err: return the box (already in %rax) unchanged.
                s = s.write("    leave\n");
                s = s.write("    ret\n");
                s = s.write(tlbl.name + ":\n");
                s = s.write("    movq 8(%rax), %rax\n"); // payload
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                if (asmcore.ty_is_f64(asmcore.infer_expr_type(u.operand, s))) {
                    // Float negation: flip the IEEE-754 sign bit (63).
                    s = s.write("    movabsq $-9223372036854775808, %rcx\n");
                    s = s.write("    xorq %rcx, %rax\n");
                } else {
                    s = s.write("    negq %rax\n");
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                s = s.write("    xorq $1, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // `expr as Type` casts (parser desugars to the unary op
            // `as_<Type>`). All integer types occupy 64-bit slots, so
            // a cast masks (unsigned) or sign-extends (signed) to the
            // target width; i64/u64/usize and anything else are no-ops.
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ty: string = u.op[3:u.op.len()];
                var src_ty: asmcore.Ty = asmcore.infer_expr_type(u.operand, s);
                var to_float: boolean = ty == "f64" || ty == "f32" || ty == "float";
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                if (to_float) {
                    // → float. From int: cvtsi2sd. From float: no-op.
                    if (!asmcore.ty_is_f64(src_ty)) {
                        s = s.write("    cvtsi2sd %rax, %xmm0\n");
                        s = s.write("    movq %xmm0, %rax\n");
                    }
                } else if (asmcore.ty_is_f64(src_ty)) {
                    // float → int: truncate toward zero, then width-mask.
                    s = s.write("    movq %rax, %xmm0\n");
                    s = s.write("    cvttsd2si %xmm0, %rax\n");
                    if (ty == "u8") { s = s.write("    andq $255, %rax\n"); }
                    else if (ty == "u16") { s = s.write("    andq $65535, %rax\n"); }
                    else if (ty == "i8") { s = s.write("    movsbq %al, %rax\n"); }
                    else if (ty == "i16") { s = s.write("    movswq %ax, %rax\n"); }
                } else {
                    if (ty == "u8") { s = s.write("    andq $255, %rax\n"); }
                    else if (ty == "u16") { s = s.write("    andq $65535, %rax\n"); }
                    else if (ty == "u32") { s = s.write("    movl %eax, %eax\n"); }
                    else if (ty == "i8") { s = s.write("    movsbq %al, %rax\n"); }
                    else if (ty == "i16") { s = s.write("    movswq %ax, %rax\n"); }
                    else if (ty == "i32") { s = s.write("    movslq %eax, %rax\n"); }
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    pushq " + asmcore.i32_to_string(off) + "(%rbp)\n");
                return s;
            }
            // Built-in `None` — the empty Option. Heap box whose
            // first word is the tag 1 (Some=0 / None=1). See the
            // Some(x) constructor + the StmtMatch Some/None arms.
            if (id.name == "None") {
                s = s.write("    movq $16, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                s = s.write("    movq $1, (%rax)\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // A bare ident naming a zero-arg, receiver-less function
            // (i.e. a `const`, desugared to such a function) lowers to
            // a call to that function.
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    s = s.write("    call __fn_" + asmcore.sanitize_label(id.name) + "\n");
                    s = s.write("    pushq %rax\n");
                    return s;
                }
                cfi = cfi + 1;
            }
            // A bare ident naming a receiver-less function WITH params
            // is a function value (higher-order use, e.g. `apply(dbl, …)`).
            // Represent it as a 1-slot closure box `[&__fn_name]` so it
            // flows through the same closure-call path as a real lambda.
            // The box-in-%r10 convention means the plain function ignores
            // the (empty) box and reads its params at +16(%rbp) as usual.
            var fvi: i32 = 0;
            while (fvi < s.funcs.len()) {
                if (s.funcs[fvi].name == id.name && s.funcs[fvi].receiver_type.len() == 0 && s.funcs[fvi].params.len() > 0) {
                    return emit_fn_value(id.name, s);
                }
                fvi = fvi + 1;
            }
            // A bare ident naming a zero-field struct is a no-payload
            // enum variant (`JNull`). Construct [shape_ptr] — an 8-byte
            // box holding the interned variant name, so the match's
            // shape-pointer compare identifies it.
            if (asmcore.is_unit_variant(id.name, s)) {
                s = s.write("    movq $8, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                var uvLit: asmcore.StringLitOut = asmcore.add_string_lit(s, id.name);
                s = uvLit.state;
                s = s.write("    leaq .S" + asmcore.i32_to_string(uvLit.idx) + "(%rip), %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unresolved ident: " + id.name + "\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — encode as a 0/1 i32 so it can flow
            // through comparison-style consumers (e.g. an if
            // cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    movq $" + asmcore.i32_to_string(v) + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal lowering: intern the bytes in
            // .rodata, then allocate a 16-byte box on the heap
            // `[data_ptr: 8, len: 8]` and push the box pointer.
            // The box layout is shared with __fern_str_concat
            // / _eq / _slice / _print runtime helpers.
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, sv.value);
            s = lo.state;
            s = s.write("    movq $16, %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            s = s.write("    leaq .S" + asmcore.i32_to_string(lo.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    movq $" + asmcore.i32_to_string(sv.value.len()) + ", %rcx\n");
            s = s.write("    movq %rcx, 8(%rax)\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprCall(c) => {
            return emit_call(c, s);
        },
        parser.ExprTuple(t) => {
            // Layout: [val0, val1, …, val_(N-1)] — no shape
            // pointer because tuple field access uses the
            // numeric `.0` / `.1` / … spelling, and the offset
            // is known at the access site without runtime
            // dispatch.
            //
            // Steps:
            //   1. Compile each element in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate N*8 bytes on the heap.
            //   3. Pop each element from the rt-stack into
            //      [%rax + i*8] — descending i so the top-of-
            //      stack lands in the LAST slot.
            //   4. Push %rax (the tuple pointer).
            var n_elems: i32 = t.elements.len();
            var ti: i32 = 0;
            while (ti < n_elems) {
                s = emit_expr(t.elements[ti], s);
                ti = ti + 1;
            }
            var t_bytes: i32 = n_elems * 8;
            if (n_elems == 0) { t_bytes = 8; }
            s = s.write("    movq $" + asmcore.i32_to_string(t_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            var tj: i32 = n_elems - 1;
            while (tj >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + asmcore.i32_to_string(tj * 8) + "(%rax)\n");
                tj = tj - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprArray(a) => {
            // Layout: [len: 8 bytes, val0, val1, …, val_(N-1)].
            // The length prefix lets `len(a)` lower to a single
            // load at offset 0 without dragging type info
            // through the backend. ExprIndex shifts the index
            // by +1 slot to skip the prefix.
            //
            // Steps:
            //   1. Compile each element in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate (N+1)*8 bytes on the heap.
            //   3. Store the length at [%rax + 0].
            //   4. Pop each element from the rt-stack into
            //      [%rax + (i+1)*8] — descending i so the
            //      top-of-stack lands in the LAST slot.
            //   5. Push %rax (the array pointer).
            var n_elems: i32 = a.elements.len();
            var ai: i32 = 0;
            while (ai < n_elems) {
                s = emit_expr(a.elements[ai], s);
                ai = ai + 1;
            }
            // Layout with a hidden capacity word: alloc
            // [cap, len, e0, …] at base B and return B+8, so readers
            // see the classic [len@0, e_i@(i+1)*8] layout while
            // __fern_arr_push finds cap at -8 and can grow
            // geometrically. cap = len for a literal (first push
            // reallocs, then doubles).
            var a_bytes: i32 = (n_elems + 2) * 8;
            s = s.write("    movq $" + asmcore.i32_to_string(a_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            s = s.write("    movq $" + asmcore.i32_to_string(n_elems) + ", %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");   // cap at base
            s = s.write("    addq $8, %rax\n");       // shift to returned ptr (base+8)
            s = s.write("    movq %rcx, (%rax)\n");   // len at base+8
            var aj: i32 = n_elems - 1;
            while (aj >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + asmcore.i32_to_string((aj + 1) * 8) + "(%rax)\n");
                aj = aj - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprIndex(x) => {
            // Dispatch on container type: string → load byte
            // (zero-extended) at box.data_ptr + i. Array → load
            // 8-byte slot at box[(i+1)*8].
            //
            // No bounds check in this first cut — out-of-range
            // produces undefined data, matching the wasm
            // backend's i32[] semantics today.
            var ct: asmcore.Ty = asmcore.infer_expr_type(x.array, s);
            s = emit_expr(x.array, s);
            s = emit_expr(x.index, s);
            s = s.write("    popq %rcx\n");
            s = s.write("    popq %rax\n");
            if (asmcore.ty_is_string(ct)) {
                // box[0] = data ptr; load byte at +rcx.
                s = s.write("    movq (%rax), %rax\n");
                s = s.write("    movzbq (%rax,%rcx,1), %rax\n");
            } else {
                s = s.write("    incq %rcx\n");
                s = s.write("    movq (%rax,%rcx,8), %rax\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprSlice(sl) => {
            // String slice: allocate a new 16-byte box with
            // data_ptr = src.data_ptr + start, len = end - start.
            // No bounds check.
            var st: asmcore.Ty = asmcore.infer_expr_type(sl.array, s);
            if (asmcore.ty_is_string(st)) {
                s = emit_expr(sl.array, s);
                s = emit_expr(sl.start, s);
                s = emit_expr(sl.end, s);
                s = s.write("    popq %r8\n");          // end
                s = s.write("    popq %rcx\n");         // start
                s = s.write("    popq %rdx\n");         // src box
                // Save end/start/src across __fern_alloc call.
                // SysV: %rdi/rsi/rdx/rcx/r8/r9 are arg regs +
                // caller-saved. Use callee-saved %r12 for end,
                // %r13 for start, %r14 for src.
                s = s.write("    pushq %r12\n");
                s = s.write("    pushq %r13\n");
                s = s.write("    pushq %r14\n");
                s = s.write("    movq %r8, %r12\n");
                s = s.write("    movq %rcx, %r13\n");
                s = s.write("    movq %rdx, %r14\n");
                s = s.write("    movq $16, %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                // box.data_ptr = src.data_ptr + start.
                s = s.write("    movq (%r14), %rcx\n");
                s = s.write("    addq %r13, %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                // box.len = end - start.
                s = s.write("    movq %r12, %rcx\n");
                s = s.write("    subq %r13, %rcx\n");
                s = s.write("    movq %rcx, 8(%rax)\n");
                s = s.write("    popq %r14\n");
                s = s.write("    popq %r13\n");
                s = s.write("    popq %r12\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (asmcore.is_int_array_tag(st) || asmcore.ty_is_array_string(st) || asmcore.ty_is_array(st)) {
                s = emit_expr(sl.array, s);
                s = emit_expr(sl.start, s);
                s = emit_expr(sl.end, s);
                s = s.write("    popq %rdx\n");        // end
                s = s.write("    popq %rsi\n");        // start
                s = s.write("    popq %rdi\n");        // src arr
                s = s.write("    call __fern_arr_slice\n");
                s = s.write("    pushq %rax\n");
                s = s.mark_arr_slice();
                return s;
            }
            s = s.write("    # unsupported: slice on non-string\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprStructLit(sl) => {
            // Layout: [shape_ptr, val0, val1, …, val_(N-1)].
            // The shape pointer is the interned struct-name
            // string in .rodata — string-pointer equality is
            // enough to identify the struct type at runtime.
            //
            // Struct-update `Name { ...base, f: v }`: the new box has
            // one slot per DECLARED field (in decl order); un-overridden
            // slots are copied verbatim from the base, the rest are the
            // override values. This heap is leak-everything (rc intrinsics
            // are no-ops), so no rc bookkeeping is needed on the copies —
            // unlike the Go IR lowering, which inc's each copied pointer
            // field. See docs/IMMUTABILITY-MIGRATION-PLAN.md.
            if (sl.has_base) {
                // Find the struct decl to size the box + map override
                // names to decl-order field indices.
                var dn: i32 = 0;
                var fields: parser.StructFieldDecl[] = [];
                var ddi: i32 = 0;
                while (ddi < s.struct_decls.len()) {
                    if (s.struct_decls[ddi].name == sl.type_name) {
                        fields = s.struct_decls[ddi].fields;
                        dn = fields.len();
                    }
                    ddi = ddi + 1;
                }
                // Evaluate the base (its pointer lands on the rt-stack).
                s = emit_expr(sl.base, s);
                // Allocate the new box: (dn+1)*8 bytes. Base ptr stays on
                // the rt-stack across the call (alloc clobbers scratch).
                var su_bytes: i32 = (dn + 1) * 8;
                s = s.write("    movq $" + asmcore.i32_to_string(su_bytes) + ", %rdi\n");
                s = s.write("    call __fern_alloc\n");
                s = s.mark_heap();
                // Shape pointer at [%rax + 0].
                var suNameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, sl.type_name);
                s = suNameLit.state;
                s = s.write("    leaq .S" + asmcore.i32_to_string(suNameLit.idx) + "(%rip), %rcx\n");
                s = s.write("    movq %rcx, (%rax)\n");
                // Pop the base pointer into %rsi — no calls happen during
                // the field-copy below, so %rsi survives.
                s = s.write("    popq %rsi\n");
                // Copy each NON-overridden declared field from base→box.
                var ci: i32 = 0;
                while (ci < dn) {
                    var cname: string = fields[ci].name;
                    var overridden: boolean = false;
                    var oj: i32 = 0;
                    while (oj < sl.field_names.len()) {
                        if (sl.field_names[oj] == cname) { overridden = true; }
                        oj = oj + 1;
                    }
                    if (!overridden) {
                        s = s.write("    movq " + asmcore.i32_to_string((ci + 1) * 8) + "(%rsi), %rcx\n");
                        s = s.write("    movq %rcx, " + asmcore.i32_to_string((ci + 1) * 8) + "(%rax)\n");
                    }
                    ci = ci + 1;
                }
                // Save the box pointer on the rt-stack; the override
                // value exprs below may use both registers and the stack.
                s = s.write("    pushq %rax\n");
                var ok: i32 = 0;
                while (ok < sl.field_names.len()) {
                    // decl-order index of this override field.
                    var oidx: i32 = 0;
                    var of2: i32 = 0;
                    while (of2 < dn) {
                        if (fields[of2].name == sl.field_names[ok]) { oidx = of2; }
                        of2 = of2 + 1;
                    }
                    s = emit_expr(sl.field_values[ok], s);  // rt: [box, val]
                    s = s.write("    popq %rcx\n");          // val → %rcx
                    s = s.write("    popq %rax\n");          // box → %rax
                    s = s.write("    movq %rcx, " + asmcore.i32_to_string((oidx + 1) * 8) + "(%rax)\n");
                    s = s.write("    pushq %rax\n");         // box back on rt-stack
                    ok = ok + 1;
                }
                return s;
            }
            var n_fields: i32 = sl.field_values.len();
            var i: i32 = 0;
            while (i < n_fields) {
                s = emit_expr(sl.field_values[i], s);
                i = i + 1;
            }
            var slot_bytes: i32 = (n_fields + 1) * 8;
            s = s.write("    movq $" + asmcore.i32_to_string(slot_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            // Intern the struct name string in .rodata.
            var nameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, sl.type_name);
            s = nameLit.state;
            s = s.write("    leaq .S" + asmcore.i32_to_string(nameLit.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            // Pop fields off the rt-stack into the struct.
            var j: i32 = n_fields - 1;
            while (j >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + asmcore.i32_to_string((j + 1) * 8) + "(%rax)\n");
                j = j - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field name (`.0` / `.1` / …) → tuple
            // access. Tuples are laid out without a shape
            // pointer, so the offset is just idx*8 from the
            // box pointer. No runtime dispatch needed.
            if (asmcore.is_all_digits(fa.field)) {
                var tup_idx: i32 = asmcore.digits_to_i32(fa.field);
                s = emit_expr(fa.obj, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq " + asmcore.i32_to_string(tup_idx * 8) + "(%rax), %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Lowering: compile the receiver expression, pop
            // the struct pointer into %rax, dispatch on the
            // shape pointer at [%rax + 0]. For each struct
            // decl in mod.structs that contains a field with
            // this name, emit a "if shape matches → load at
            // compile-time offset" arm. Falls through to a
            // sentinel (-1) if no match.
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rax\n");
            // Use the label counter for end-of-dispatch label.
            var end_lbl: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
            // Walk each struct decl looking for the named
            // field. Emit a shape-pointer comparison arm for
            // each match.
            var di: i32 = 0;
            while (di < s.struct_decls.len()) {
                var sd: parser.StructDecl = s.struct_decls[di];
                var fi: i32 = 0;
                var found_idx: i32 = 0 - 1;
                while (fi < sd.fields.len()) {
                    if (sd.fields[fi].name == fa.field) { found_idx = fi; }
                    fi = fi + 1;
                }
                if (found_idx >= 0) {
                    var arm_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, sd.name);
                    s = arm_lit.state;
                    s = s.write("    movq (%rax), %rcx\n");
                    s = s.write("    leaq .S" + asmcore.i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    jne .Lfa_next_" + asmcore.i32_to_string(s.label_n) + "\n");
                    s = s.write("    movq " + asmcore.i32_to_string((found_idx + 1) * 8) + "(%rax), %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp .Lfa_end_" + asmcore.i32_to_string(end_lbl) + "\n");
                    s = s.write(".Lfa_next_" + asmcore.i32_to_string(s.label_n) + ":\n");
                    s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
                }
                di = di + 1;
            }
            // No-shape-matched fallthrough: push sentinel -1.
            s = s.write("    movq $-1, %rax\n");
            s = s.write("    pushq %rax\n");
            s = s.write(".Lfa_end_" + asmcore.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.ExprLambda(lm) => {
            // Lowering with always-box calling convention:
            //
            //   jmp .Lskip_lambda_N
            //   .Llambda_N:
            //       <prologue; load box ptr from +16(%rbp);
            //        load each capture from box[+8, +16, …];
            //        load params from +24, +32, …; body;
            //        implicit return 0>
            //   .Lskip_lambda_N:
            //   # allocate (1 + N_caps) * 8 bytes on heap
            //   movq $<bytes>, %rdi; call __fern_alloc
            //   leaq .Llambda_N(%rip), %rcx
            //   movq %rcx, (%rax)              # fn_addr at box[0]
            //   # eval each capture in OUTER scope and store
            //   movq <cap_local_off>(%rbp), %rcx
            //   movq %rcx, <(i+1)*8>(%rax)
            //   pushq %rax                     # box ptr
            //
            // The call site reads box ptr, peeks box[0] for the
            // fn_addr, and indirect-calls. The box ptr lives on
            // the stack just below the args so the callee sees
            // it at +16(%rbp).
            //
            // Capture-less lambdas use the same shape with a
            // 1-slot box, keeping the call convention uniform.
            var caps: string[] = asmcore.lambda_captures(lm, s);
            var n_caps: i32 = caps.len();
            var lam_id: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 2 };
            var skip_lbl: string = ".Lskip_lambda_" + asmcore.i32_to_string(lam_id);
            var body_lbl: string = ".Llambda_" + asmcore.i32_to_string(lam_id);
            s = s.write("    jmp " + skip_lbl + "\n");
            s = s.write(body_lbl + ":\n");
            s = s.write("    pushq %rbp\n");
            s = s.write("    movq %rsp, %rbp\n");
            // Inside the body, allocate locals for:
            //   1 box-ptr slot + N capture slots + M param
            //   slots + count_locals(body) inner-var slots.
            var saved_locals: string[] = s.local_names;
            var saved_local_types: asmcore.Ty[] = s.local_types;
            var saved_in_function: boolean = s.in_function;
            var argc_l: i32 = lm.params.len();
            var n_body_locals_l: i32 = asmcore.count_locals(lm.body);
            var total_locals_l: i32 = 1 + n_caps + argc_l + n_body_locals_l;
            if (total_locals_l > 0) {
                var bytes_l: i32 = total_locals_l * 8;
                if (bytes_l % 16 != 0) { bytes_l = bytes_l + 8; }
                s = s.write("    subq $" + asmcore.i32_to_string(bytes_l) + ", %rsp\n");
            }
            s = s.reset_locals();
            s = s.enter_function();
            // Bind __closure_box (slot 0), copy from %r10 (the box
            // ptr the call site loaded into that register).
            var box_name: string = "__closure_box";
            s = s.bind_local(box_name);
            var box_off: i32 = s.lookup_local(box_name);
            s = s.write("    movq %r10, " + asmcore.i32_to_string(box_off) + "(%rbp)\n");
            // Bind each capture, load from box[+(i+1)*8]. The
            // capture preserves the outer scope's type so that
            // type-aware dispatch inside the lambda body (e.g.
            // `len(s)` resolving to the string-len helper, or
            // `a + b` routing through `__fern_str_concat`)
            // sees the right thing — without this the captured
            // local lands here as `"unknown"` and falls through
            // to the i32 path.
            var ci: i32 = 0;
            while (ci < n_caps) {
                var cap_ty: asmcore.Ty = asmcore.ty_unknown();
                var li: i32 = 0;
                while (li < saved_locals.len()) {
                    if (saved_locals[li] == caps[ci]) {
                        cap_ty = saved_local_types[li];
                        li = saved_locals.len();
                    } else {
                        li = li + 1;
                    }
                }
                s = s.bind_local_typed(caps[ci], cap_ty);
                var c_off: i32 = s.lookup_local(caps[ci]);
                s = s.write("    movq " + asmcore.i32_to_string(box_off) + "(%rbp), %rcx\n");
                s = s.write("    movq " + asmcore.i32_to_string((ci + 1) * 8) + "(%rcx), %rax\n");
                s = s.write("    movq %rax, " + asmcore.i32_to_string(c_off) + "(%rbp) # capture " + caps[ci] + "\n");
                ci = ci + 1;
            }
            // Bind params; args sit at +16, +24, … — IDENTICAL to a
            // direct call, because the box now arrives in %r10 rather
            // than as a hidden stack arg.
            var pi2: i32 = 0;
            while (pi2 < argc_l) {
                s = s.bind_local_typed(lm.params[pi2].name, asmcore.ty_from_name(lm.params[pi2].type_name));
                var p_off: i32 = s.lookup_local(lm.params[pi2].name);
                var a_off: i32 = 16 + pi2 * 8;
                s = s.write("    movq " + asmcore.i32_to_string(a_off) + "(%rbp), %rax\n");
                s = s.write("    movq %rax, " + asmcore.i32_to_string(p_off) + "(%rbp) # param " + lm.params[pi2].name + "\n");
                pi2 = pi2 + 1;
            }
            // Body.
            var bi_l: i32 = 0;
            while (bi_l < lm.body.len()) {
                s = emit_stmt(lm.body[bi_l], s);
                bi_l = bi_l + 1;
            }
            // Fallback implicit return 0.
            s = s.write("    movq $0, %rax\n");
            s = s.write("    leave\n");
            s = s.write("    ret\n");
            // Restore outer scope's locals + in_function flag.
            s = asmcore.EmitState { ...s, local_names: saved_locals, in_function: saved_in_function, local_types: saved_local_types };
            s = s.write(skip_lbl + ":\n");
            // Allocate box: (1 + n_caps) * 8 bytes.
            var box_bytes: i32 = (1 + n_caps) * 8;
            s = s.write("    movq $" + asmcore.i32_to_string(box_bytes) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.mark_heap();
            // Store fn_addr at box[0].
            s = s.write("    leaq " + body_lbl + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            // Store captures (read from outer locals).
            var oi: i32 = 0;
            while (oi < n_caps) {
                var outer_off: i32 = s.lookup_local(caps[oi]);
                s = s.write("    movq " + asmcore.i32_to_string(outer_off) + "(%rbp), %rcx\n");
                s = s.write("    movq %rcx, " + asmcore.i32_to_string((oi + 1) * 8) + "(%rax)\n");
                oi = oi + 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    # parser-side unknown\n");
            s = s.write("    pushq $0\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: asmcore.EmitState): asmcore.EmitState {
    var i: i32 = 0;
    while (i < body.len()) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

// emit_map_kv_for emits a `for (k, v) in m` loop (the var name is
// "k,v"; kv_comma is the comma index). Iterates the map's parallel
// keys[]/values[] arrays by index, binding k = keys[i+1], v =
// values[i+1]. A separate function so emit_stmt's StmtFor arm stays
// small.
function emit_map_kv_for(s: asmcore.EmitState, f: parser.StmtFor, kv_comma: i32): asmcore.EmitState {
    var iter_ty: asmcore.Ty = asmcore.infer_expr_type(f.iter, s);
    var kvk: string = f.var_name[0 : kv_comma];
    var kvv: string = f.var_name[kv_comma + 1 : f.var_name.len()];
    var kvk_ty: asmcore.Ty = asmcore.ty_string();
    if (asmcore.map_key_is_i32(iter_ty)) { kvk_ty = asmcore.ty_i32(); }
    var kvv_ty: asmcore.Ty = asmcore.map_val(iter_ty);
    s = emit_expr(f.iter, s);
    var kvm_name: string = "__forkv_map_" + asmcore.i32_to_string(s.label_n);
    s = s.bind_local(kvm_name);
    var kvm_off: i32 = s.lookup_local(kvm_name);
    s = s.write("    popq %rax\n");
    s = s.write("    movq %rax, " + asmcore.i32_to_string(kvm_off) + "(%rbp)\n");
    var kvi_name: string = "__forkv_i_" + asmcore.i32_to_string(s.label_n);
    s = s.bind_local(kvi_name);
    var kvi_off: i32 = s.lookup_local(kvi_name);
    s = s.write("    movq $0, " + asmcore.i32_to_string(kvi_off) + "(%rbp)\n");
    s = s.bind_local_typed(kvk, kvk_ty);
    var kvk_off: i32 = s.lookup_local(kvk);
    s = s.bind_local_typed(kvv, kvv_ty);
    var kvv_off: i32 = s.lookup_local(kvv);
    var kvtop: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvtop.state;
    var kvcont: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvcont.state;
    var kvend: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvend.state;
    s = s.write(kvtop.name + ":\n");
    s = s.write("    movq " + asmcore.i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");   // keys arr
    s = s.write("    movq (%rcx), %rcx\n");   // keys.len
    s = s.write("    movq " + asmcore.i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    cmpq %rcx, %rdx\n");
    s = s.write("    jge " + kvend.name + "\n");
    s = s.write("    movq " + asmcore.i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq (%rax), %rcx\n");   // keys arr
    s = s.write("    movq " + asmcore.i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rcx,%rdx,8), %rax\n");   // keys[i+1]
    s = s.write("    movq %rax, " + asmcore.i32_to_string(kvk_off) + "(%rbp)\n");
    s = s.write("    movq " + asmcore.i32_to_string(kvm_off) + "(%rbp), %rax\n");
    s = s.write("    movq 8(%rax), %rcx\n");   // values arr
    s = s.write("    movq " + asmcore.i32_to_string(kvi_off) + "(%rbp), %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rcx,%rdx,8), %rax\n");   // values[i+1]
    s = s.write("    movq %rax, " + asmcore.i32_to_string(kvv_off) + "(%rbp)\n");
    s = s.push_loop_labels(kvend.name, kvcont.name);
    var kvbi: i32 = 0;
    while (kvbi < f.body.len()) {
        s = emit_stmt(f.body[kvbi], s);
        kvbi = kvbi + 1;
    }
    s = s.pop_loop_labels();
    s = s.write(kvcont.name + ":\n");
    s = s.write("    movq " + asmcore.i32_to_string(kvi_off) + "(%rbp), %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rax, " + asmcore.i32_to_string(kvi_off) + "(%rbp)\n");
    s = s.write("    jmp " + kvtop.name + "\n");
    s = s.write(kvend.name + ":\n");
    return s;
}

function emit_stmt(stmt: parser.Stmt, s: asmcore.EmitState): asmcore.EmitState {
    match (stmt) {
        // StmtDefer is lowered away (parser.lower_defers) before emit; this
        // arm only satisfies exhaustiveness.
        parser.StmtDefer(_) => { return s.write("    # unsupported: StmtDefer survived lowering\n"); },
        parser.StmtReturn(r) => {
            s = emit_expr(r.value, s);
            if (s.in_function) {
                // Function return: result in %rax, restore
                // caller's frame, ret.
                s = s.write("    popq %rax\n");
                s = s.write("    leave\n");
                s = s.write("    ret\n");
            } else {
                // Top-level return: lower to sys_exit_group so
                // the program terminates with the right exit
                // code.
                s = s.write("    popq %rdi\n");
                s = s.write("    movq $60, %rax\n");
                s = s.write("    syscall\n");
            }
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; popq %rax; cmpq $0, %rax; je <else_lbl>
            //   <then-body>; jmp <end_lbl>
            // <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            var else_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = else_l.state;
            s = s.write("    je " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (ifs.else_body.len() > 0) {
                var end_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = end_l.state;
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; popq %rax; cmpq $0, %rax;
            //            je <exit_lbl>
            //            <body>; jmp <top_lbl>
            // <exit_lbl>:
            //
            // break inside the body jumps to <exit_lbl>;
            // continue jumps to <top_lbl> (re-evaluate cond).
            var top_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = top_l.state;
            var exit_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    je " + exit_l.name + "\n");
            s = s.push_loop_labels(exit_l.name, top_l.name);
            s = emit_block(w.body, s);
            s = s.pop_loop_labels();
            s = s.write("    jmp " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(v) => {
            // `var (a, b) = E` tuple destructuring (name encoded "a,b"):
            // eval the tuple box, bind a = box[0], b = box[8].
            var tdc: i32 = 0 - 1;
            var tdci: i32 = 0;
            while (tdci < v.name.len()) {
                if (v.name[tdci] == 44 && tdc < 0) { tdc = tdci; }
                tdci = tdci + 1;
            }
            if (tdc >= 0) {
                var tda: string = v.name[0 : tdc];
                var tdb: string = v.name[tdc + 1 : v.name.len()];
                var tdtags: asmcore.TwoTags = asmcore.tuple_destructure_tags(v.init, s);
                s = emit_expr(v.init, s);
                s = s.write("    popq %rax\n");          // tuple box
                s = s.bind_local_typed(tda, tdtags.a);
                var tda_off: i32 = s.lookup_local(tda);
                s = s.write("    movq (%rax), %rcx\n");  // box.0
                s = s.write("    movq %rcx, " + asmcore.i32_to_string(tda_off) + "(%rbp)\n");
                s = s.bind_local_typed(tdb, tdtags.b);
                var tdb_off: i32 = s.lookup_local(tdb);
                s = s.write("    movq 8(%rax), %rcx\n"); // box.1
                s = s.write("    movq %rcx, " + asmcore.i32_to_string(tdb_off) + "(%rbp)\n");
                return s;
            }
            // Compile init, then pop to the new local's slot.
            // Infer init's type so the local carries it (used
            // by string-aware dispatch in ExprBinary / len /
            // print etc.). An explicit annotation overrides
            // the inference. bind_local_typed binds the name
            // BEFORE the lookup_local call resolves the slot.
            var ity: asmcore.Ty = asmcore.infer_expr_type(v.init, s);
            if (v.type_name.len() > 0) {
                ity = asmcore.ty_from_name(v.type_name);
            }
            s = emit_expr(v.init, s);
            s = s.bind_local_typed(v.name, ity);
            var off: i32 = s.lookup_local(v.name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + asmcore.i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtAssign(a) => {
            if (!s.has_local(a.target)) {
                s = s.write("    # unresolved assign: " + a.target + "\n");
                return s;
            }
            s = emit_expr(a.value, s);
            var off: i32 = s.lookup_local(a.target);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + asmcore.i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtExpr(x) => {
            // Evaluate for side effects, drop the result.
            s = emit_expr(x.value, s);
            s = s.write("    popq %rax\n");
            return s;
        },
        parser.StmtMatch(m) => {
            // Lowering: eval the scrutinee, save into a fresh
            // local slot (so each arm can reload it without
            // worrying about %rax being clobbered by inner ops).
            // Then for each arm, emit:
            //   PatVariant: load shape ptr, compare to interned
            //   struct name, jump to next arm on mismatch. On
            //   match, bind `binding` to the scrutinee value
            //   (if non-empty), execute body, jump to end.
            //   PatWildcard: always match, no dispatch.
            // No exhaustiveness check — that's the checker's job.
            s = emit_expr(m.scrutinee, s);
            // Allocate the synthetic scrutinee slot.
            var scrut_name: string = "__match_scrut_" + asmcore.i32_to_string(s.label_n);
            s = s.bind_local(scrut_name);
            var scrut_off: i32 = s.lookup_local(scrut_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + asmcore.i32_to_string(scrut_off) + "(%rbp)\n");
            // Bump the label counter for end-of-match.
            var end_lbl: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[ai];
                var next_lbl: i32 = s.label_n;
                s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.type_name == "true" || pv.type_name == "false") {
                            // `match (b) { true => …, false => … }`: the
                            // scrutinee is the bool itself (0/1), not a box.
                            s = s.write("    movq " + asmcore.i32_to_string(scrut_off) + "(%rbp), %rax\n");
                            s = s.write("    testq %rax, %rax\n");
                            if (pv.type_name == "true") {
                                s = s.write("    jz .Lmatch_next_" + asmcore.i32_to_string(next_lbl) + "\n");
                            } else {
                                s = s.write("    jnz .Lmatch_next_" + asmcore.i32_to_string(next_lbl) + "\n");
                            }
                        } else if (pv.type_name == "Some" || pv.type_name == "None"
                                || pv.type_name == "Ok" || pv.type_name == "Err") {
                            // Built-in Option / Result: discriminate on
                            // the i32 tag at offset 0 (Some/Ok=0,
                            // None/Err=1), not the struct shape pointer.
                            // The non-empty variant (Some/Ok) binds its
                            // PAYLOAD (offset 8), not the box.
                            s = s.write("    movq " + asmcore.i32_to_string(scrut_off) + "(%rbp), %rax\n");
                            s = s.write("    movq (%rax), %rcx\n");
                            var want: i32 = 0;
                            if (pv.type_name == "None" || pv.type_name == "Err") { want = 1; }
                            s = s.write("    cmpq $" + asmcore.i32_to_string(want) + ", %rcx\n");
                            s = s.write("    jne .Lmatch_next_" + asmcore.i32_to_string(next_lbl) + "\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                s = s.write("    movq 8(%rax), %rcx\n");   // payload
                                // The only Option/Result producers here
                                // (read_chunk → Some, read_file → Ok) carry
                                // string payloads, so bind the payload as a
                                // string for print / concat dispatch.
                                s = s.bind_local_typed(pv.binding, asmcore.match_payload_type(m.scrutinee, s));
                                var pbind_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rcx, " + asmcore.i32_to_string(pbind_off) + "(%rbp)\n");
                            }
                        } else {
                        // Shape-pointer compare against pv.type_name.
                        s = s.write("    movq " + asmcore.i32_to_string(scrut_off) + "(%rbp), %rax\n");
                        s = s.write("    movq (%rax), %rcx\n");
                        var nameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, pv.type_name);
                        s = nameLit.state;
                        s = s.write("    leaq .S" + asmcore.i32_to_string(nameLit.idx) + "(%rip), %rdx\n");
                        s = s.write("    cmpq %rdx, %rcx\n");
                        s = s.write("    jne .Lmatch_next_" + asmcore.i32_to_string(next_lbl) + "\n");
                        if (pv.binding.len() > 0 && pv.binding != "_") {
                            if (asmcore.is_enum_variant(pv.type_name, s)) {
                                // Enum variant `Circle(r)`: bind the
                                // PAYLOAD at offset 8 (typed via the
                                // "__ev" marker field), not the box.
                                s = s.write("    movq 8(%rax), %rcx\n");
                                s = s.bind_local_typed(pv.binding, asmcore.field_type_tag_in(pv.type_name, "__ev", s));
                                var ev_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rcx, " + asmcore.i32_to_string(ev_off) + "(%rbp)\n");
                            } else {
                                // `type X = A|B` union member: bind the
                                // whole struct, typed with the variant's
                                // struct name so a field read (`VString(s)
                                // => s.v`) resolves within that struct.
                                s = s.bind_local_typed(pv.binding, asmcore.ty_named(pv.type_name));
                                var bind_off: i32 = s.lookup_local(pv.binding);
                                s = s.write("    movq %rax, " + asmcore.i32_to_string(bind_off) + "(%rbp)\n");
                            }
                        }
                        }
                    },
                    parser.PatWildcard(_) => {
                        // Wildcard always matches — no dispatch.
                    }
                }
                // Guard: a `Pat when <expr> =>` arm runs its body only if the
                // guard is true. The binding (if any) is already in scope, so
                // the guard may reference it (`Has(n) when n > 0`). A false
                // guard jumps to the next arm — the same target as a pattern
                // mismatch — so it falls through correctly (and an all-guards-
                // fail match falls through to the end, like a non-exhaustive
                // match).
                if (arm.has_guard) {
                    s = emit_expr(arm.guard, s);
                    s = s.write("    popq %rax\n");
                    s = s.write("    testq %rax, %rax\n");
                    s = s.write("    jz .Lmatch_next_" + asmcore.i32_to_string(next_lbl) + "\n");
                }
                // Emit the arm body.
                var bi: i32 = 0;
                while (bi < arm.body.len()) {
                    s = emit_stmt(arm.body[bi], s);
                    bi = bi + 1;
                }
                s = s.write("    jmp .Lmatch_end_" + asmcore.i32_to_string(end_lbl) + "\n");
                s = s.write(".Lmatch_next_" + asmcore.i32_to_string(next_lbl) + ":\n");
                ai = ai + 1;
            }
            s = s.write(".Lmatch_end_" + asmcore.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtFor(f) => {
            // Lowering desugar: `for x in arr { body }`
            //   var __for_arr_N = arr;
            //   var __for_i_N = 0;
            //   while (__for_i_N < len(__for_arr_N)) {
            //       var x = __for_arr_N[__for_i_N];
            //       body;
            //       __for_i_N = __for_i_N + 1;
            //   }
            //
            // Allocate three synthetic locals (array ptr, index,
            // element var). The index lives in a slot so the
            // body can read it for diagnostics; the iter
            // expression is hoisted into a slot so it isn't re-
            // evaluated each iteration (mirrors how `for` works
            // in higher-level languages — the iterator is
            // resolved once).
            // Infer container element type so the loop var
            // carries it (lets `for x in strs { print(x); }`
            // dispatch as string).
            var iter_ty: asmcore.Ty = asmcore.infer_expr_type(f.iter, s);
            // `for (k, v) in m` — the var name is "k,v"; iterate the
            // map's parallel keys[]/values[] arrays (see emit_map_kv_for).
            var kv_comma: i32 = 0 - 1;
            var kvci: i32 = 0;
            while (kvci < f.var_name.len()) {
                if (f.var_name[kvci] == 44 && kv_comma < 0) { kv_comma = kvci; }
                kvci = kvci + 1;
            }
            if (asmcore.is_map(iter_ty) && kv_comma >= 0) {
                return emit_map_kv_for(s, f, kv_comma);
            }
            var elem_ty: asmcore.Ty = asmcore.ty_i32();
            if (asmcore.ty_is_array_string(iter_ty)) { elem_ty = asmcore.ty_string(); }
            if (asmcore.ty_is_array_u32(iter_ty)) { elem_ty = asmcore.ty_u32(); }
            if (asmcore.ty_is_array_u64(iter_ty)) { elem_ty = asmcore.ty_u64(); }
            if (asmcore.ty_is_array_i64(iter_ty)) { elem_ty = asmcore.ty_i64(); }
            // Generic `array` tag (struct / `dyn Trait` / otherwise
            // non-primitive elements — `ret_tag_of` collapses every
            // `T[]` that isn't a known scalar array to "array", losing
            // the element name). Bind the loop var as "unknown" rather
            // than the i32 default so a method call on it
            // (`for x in shapes { x.area() }`) routes through the
            // runtime-shape dispatch instead of the primitive path.
            if (asmcore.ty_is_array(iter_ty)) { elem_ty = asmcore.ty_unknown(); }
            s = emit_expr(f.iter, s);
            var arr_name: string = "__for_arr_" + asmcore.i32_to_string(s.label_n);
            s = s.bind_local(arr_name);
            var arr_off: i32 = s.lookup_local(arr_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + asmcore.i32_to_string(arr_off) + "(%rbp)\n");
            var idx_name: string = "__for_i_" + asmcore.i32_to_string(s.label_n);
            s = s.bind_local(idx_name);
            var idx_off: i32 = s.lookup_local(idx_name);
            s = s.write("    movq $0, " + asmcore.i32_to_string(idx_off) + "(%rbp)\n");
            s = s.bind_local_typed(f.var_name, elem_ty);
            var elem_off: i32 = s.lookup_local(f.var_name);
            // Loop labels: top (cond), cont (i++), end (exit).
            var top_lbl: i32 = s.label_n;
            var cont_lbl: i32 = s.label_n + 1;
            var end_lbl: i32 = s.label_n + 2;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 3 };
            s = s.write(".Lfor_top_" + asmcore.i32_to_string(top_lbl) + ":\n");
            // Condition: __for_i_N < len(__for_arr_N).
            s = s.write("    movq " + asmcore.i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq (%rax), %rcx\n");        // length
            s = s.write("    movq " + asmcore.i32_to_string(idx_off) + "(%rbp), %rdx\n");
            s = s.write("    cmpq %rcx, %rdx\n");
            s = s.write("    jge .Lfor_end_" + asmcore.i32_to_string(end_lbl) + "\n");
            // Bind element: x = arr[i].
            s = s.write("    movq " + asmcore.i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq " + asmcore.i32_to_string(idx_off) + "(%rbp), %rcx\n");
            s = s.write("    incq %rcx\n");
            s = s.write("    movq (%rax,%rcx,8), %rax\n");
            s = s.write("    movq %rax, " + asmcore.i32_to_string(elem_off) + "(%rbp)\n");
            // Body — break jumps to .Lfor_end; continue jumps
            // to .Lfor_cont (the i++ block) so the loop still
            // advances.
            s = s.push_loop_labels(".Lfor_end_" + asmcore.i32_to_string(end_lbl), ".Lfor_cont_" + asmcore.i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < f.body.len()) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + asmcore.i32_to_string(cont_lbl) + ":\n");
            s = s.write("    movq " + asmcore.i32_to_string(idx_off) + "(%rbp), %rax\n");
            s = s.write("    incq %rax\n");
            s = s.write("    movq %rax, " + asmcore.i32_to_string(idx_off) + "(%rbp)\n");
            s = s.write("    jmp .Lfor_top_" + asmcore.i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + asmcore.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (lbl.len() == 0) { return s.write("    # break outside loop\n"); }
            return s.write("    jmp " + lbl + "\n");
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (lbl.len() == 0) { return s.write("    # continue outside loop\n"); }
            return s.write("    jmp " + lbl + "\n");
        },
        parser.StmtUnknown(_) => { return s.write("    # unsupported: StmtUnknown\n"); }
    }
    return s;
}

// emit_module produces the full assembly text. Top-level stmts
// are emitted in order under `_start`. The Linux runtime calls
// `_start` first; sys_exit_group terminates the process with
// the exit code in %rdi.
// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, body, and (fallback) epilogue. Params
// arrive on the stack at +16(%rbp), +24(%rbp), … (caller
// pushed right-to-left, so param[0] is closest to the return
// address); the prologue copies them into the function's
// own local slots so the body reads them uniformly.
function emit_function(fd: parser.FuncDecl, s: asmcore.EmitState): asmcore.EmitState {
    // Methods get `__fn_<RecvType>__<method>:` so multiple
    // structs can have the same method name without colliding.
    // Plain funcs keep `__fn_<name>:` for source compat with the
    // earlier slices' call emitters.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) {
        // Generic receiver types (`Box[T]`) strip to the base struct
        // name `Box` so the method symbol matches the dispatch shape
        // compare (which uses the value's base-name shape string).
        label_name = asmcore.base_type_name(fd.receiver_type) + "." + fd.name;
    }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var has_recv: boolean = fd.receiver_name.len() > 0;
    var argc: i32 = fd.params.len();
    if (has_recv) { argc = argc + 1; }
    var n_body_locals: i32 = asmcore.count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    subq $" + asmcore.i32_to_string(bytes) + ", %rsp\n");
    }
    // Fresh locals table for this function's scope; keep the
    // monotonic label_n + in_function flag.
    s = s.reset_locals();
    s = s.enter_function();
    // For methods, bind receiver first so it occupies local
    // slot 0 (at -8(%rbp)) and reads from +16(%rbp).
    if (has_recv) {
        s = s.bind_local_typed(fd.receiver_name, asmcore.struct_local_tag(fd.receiver_type, s));
        var recv_off: i32 = s.lookup_local(fd.receiver_name);
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq %rax, " + asmcore.i32_to_string(recv_off) + "(%rbp) # recv " + fd.receiver_name + "\n");
    }
    // Bind params + copy from caller-stack offsets into local
    // slots. param[i] sits at +(16 + (i + recv_shift)*8)(%rbp).
    var recv_shift: i32 = 0;
    if (has_recv) { recv_shift = 1; }
    var n_params: i32 = fd.params.len();
    var i: i32 = 0;
    while (i < n_params) {
        s = s.bind_local_typed(fd.params[i].name, asmcore.struct_local_tag(fd.params[i].type_name, s));
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + (i + recv_shift) * 8;
        s = s.write("    movq " + asmcore.i32_to_string(arg_off) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + asmcore.i32_to_string(local_off) + "(%rbp) # param " + fd.params[i].name + "\n");
        i = i + 1;
    }
    // Body. Any StmtReturn inside lowers to leave + ret
    // (because in_function is set).
    var bi: i32 = 0;
    while (bi < fd.body.len()) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end
    // doesn't run into the next function's label.
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}











// emit_runtime appends the runtime-library helper bodies the
// module requested via need()/has_need(): print_int, the heap
// bump-allocator, string + array helpers, args, strbuf, etc.
// Each block is gated on has_need(...) so only referenced
// helpers are emitted. Split out of emit_module so that the
// orchestration (type-check, function bodies, _start) stays
// readable; the relative emission order is unchanged.
function emit_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // __fern_print_int helper: appended once at the end of the
    // .text section if any print_int call surfaced needs_print_int.
    // Converts the i64 in %rdi to decimal text in a stack buffer
    // and writes it to stdout. Handles zero, positive, and
    // negative values (prepending `-`).
    if (s.has_need("print_int")) {
        s = s.write("__fern_print_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    movq $0, %r10\n");        // sign flag
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jge .Lpi_pos\n");
        s = s.write("    negq %rax\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write(".Lpi_pos:\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lpi_loop_start\n");
        s = s.write("    movb $48, -1(%rbp)\n");   // '0'
        s = s.write("    leaq -1(%rbp), %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    jmp .Lpi_write\n");
        s = s.write(".Lpi_loop_start:\n");
        s = s.write("    leaq -1(%rbp), %rsi\n");
        s = s.write("    movq $0, %r8\n");         // length
        s = s.write(".Lpi_div:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");            // rax/=10, rdx=remainder
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lpi_div\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Lpi_no_neg\n");
        s = s.write("    movb $45, (%rsi)\n");     // '-'
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write(".Lpi_no_neg:\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    movq %r8, %rdx\n");
        s = s.write(".Lpi_write:\n");
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    movq $1, %rax\n");        // sys_write
        s = s.write("    syscall\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_now_unix_ms / __fern_monotonic_ns: clock_gettime
    // (x86-64 syscall 228) helpers. Emitted unconditionally — they
    // don't touch the heap, so they can't ride the needs_heap gate
    // that carries read_file/write_file, and a pure-scalar program
    // that times something must still link. The kernel writes a
    // `struct timespec { i64 tv_sec; i64 tv_nsec }` to the buffer.
    // Errno is ignored: with a fixed clock id and a stack buffer we
    // control, the realistic failures (EFAULT/EINVAL) can't fire.
    // now_unix_ms: CLOCK_REALTIME=0 → tv_sec*1000 + tv_nsec/1e6.
    s = s.write("__fern_now_unix_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %r10\n");       // tv_sec
    s = s.write("    imulq $1000, %r10, %r10\n"); // sec * 1000
    s = s.write("    movq 8(%rsp), %rax\n");      // tv_nsec
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000000, %rcx\n");
    s = s.write("    divq %rcx\n");               // rax = nsec / 1e6
    s = s.write("    addq %r10, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // monotonic_ns: CLOCK_MONOTONIC=1 → tv_sec*1e9 + tv_nsec.
    s = s.write("__fern_monotonic_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $1, %rdi\n");           // CLOCK_MONOTONIC
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // __fern_sleep_ms(%rdi = ms) — pause for `ms` milliseconds via
    // nanosleep (syscall 35); ms <= 0 returns immediately. Lives next
    // to the clock helpers (emitted unconditionally) — no heap, just
    // a syscall and a 16-byte timespec on the stack.
    s = s.write(".globl __fern_sleep_ms\n");
    s = s.write(".type __fern_sleep_ms, @function\n");
    s = s.write("__fern_sleep_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $32, %rsp\n");
    s = s.write("    cmpq $0, %rdi\n");
    s = s.write("    jle .Lsm_done\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000, %rcx\n");
    s = s.write("    divq %rcx\n");
    s = s.write("    movq %rax, (%rsp)\n");
    s = s.write("    movq $1000000, %rax\n");
    s = s.write("    imulq %rdx, %rax\n");
    s = s.write("    movq %rax, 8(%rsp)\n");
    s = s.write("    movq %rsp, %rdi\n");
    s = s.write("    movq $0, %rsi\n");
    s = s.write("    movq $35, %rax\n");
    s = s.write("    syscall\n");
    s = s.write(".Lsm_done:\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_sleep_ms, .-__fern_sleep_ms\n");
    // __fern_read_int helper: reads up to 16 bytes from stdin
    // into a stack buffer, then parses an optional leading `-`
    // followed by decimal digits. Returns the parsed value in
    // %rax. Stops at the first non-digit (including newline /
    // EOF). Skips leading whitespace not implemented — input
    // is expected to start with the digits / minus.
    if (s.has_need("read_int")) {
        s = s.write("__fern_read_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq $0, %rdi\n");          // fd 0
        s = s.write("    leaq -16(%rbp), %rsi\n");
        s = s.write("    movq $16, %rdx\n");
        s = s.write("    movq $0, %rax\n");          // sys_read
        s = s.write("    syscall\n");
        s = s.write("    leaq -16(%rbp), %rcx\n");   // cursor
        s = s.write("    leaq -16(%rbp), %r8\n");    // end ptr
        s = s.write("    addq %rax, %r8\n");
        s = s.write("    movq $0, %r9\n");           // accumulator
