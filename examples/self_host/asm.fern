    }
    // __fern_chr — Fern runtime function (#2649), the first Tier-2 helper via the
    // raw-memory intrinsics: alloc 1 byte, store b, box it. Only dep is heap.
    if (s.has_need("chr")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_chr(), s);
    }
    // __fern_str_to_upper / __fern_str_to_lower — Fern runtime functions (#2649)
    // via the raw-memory intrinsics: copy each byte case-flipped if alpha. Both
    // gated on the single str_case need (un-bundled from str_search). heap-only dep.
    if (s.has_need("str_case")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_to_upper(), s);
        s = emit_runtime_fern_fn(asmcore.rt_src_str_to_lower(), s);
    }
    // __fern_str_repeat — Fern runtime function (#2649) via the raw-memory
    // intrinsics: n copies of `s` in a fresh buffer + box. heap-only dep.
    if (s.has_need("str_repeat")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_repeat(), s);
    }
    // __fern_str_reverse — Fern runtime function (#2649) via the raw-memory
    // intrinsics: a fresh box with s's bytes reversed. heap-only dep.
    if (s.has_need("str_reverse")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_reverse(), s);
    }
    // __fern_str_replace — Fern runtime function (#2649) via the raw-memory
    // intrinsics: two-pass count + build, replacing each non-overlapping `old`
    // with `new`. heap-only dep.
    if (s.has_need("str_replace")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_replace(), s);
    }
    // __fern_string_from_bytes — Fern runtime function (#2649) via the raw-memory
    // intrinsics: pack each array element's low byte into a fresh string box.
    // heap-only dep.
    if (s.has_need("str_from_bytes")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_string_from_bytes(), s);
    }
    // __fern_str_split — Fern runtime function (#2649): scans for `sep` and
    // appends each segment slice (.append() → arr_push, present via its own need
    // set by mark_str_split / mark_str_lines during module-body emission). heap dep.
    if (s.has_need("str_split")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_str_split(), s);
    }
    // __fern_str_bytes is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_bytes, emitted (need-gated) in the migrated-helpers
    // section below. It builds the i32[] by appending each byte (arr_push), so it
    // no longer hand-rolls __fern_arr_box + a slot-store loop here.
    // __fern_str_chars is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_chars, emitted (need-gated) in the migrated-helpers
    // section below. It appends each 1-char slice s[i:i+1] (arr_push), so it no
    // longer hand-rolls __fern_arr_box + a per-char box-store loop here.
    // __fern_arr_i32_product / _sum are now Fern runtime functions (#2649),
    // compiled through emit_function (see asmcore.rt_src_arr_i32_*). They link
    // as __fn___fern_arr_i32_product / __fn___fern_arr_i32_sum and are called
    // via the ordinary stack convention; the array param is borrowed.
    if (s.has_need("arr_i32_product")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_i32_product(), s);
    }
    if (s.has_need("arr_i32_sum")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_i32_sum(), s);
    }
    // __fern_arr_str_index_of is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_str_index_of. It CALLS str_eq (also Fern now) — the
    // first migrated helper that calls another; its str_eq dep is marked by
    // mark_arr_str_index_of so str_eq's body is emitted too. Linear scan
    // returning the first index where xs[i] == target, or -1.
    if (s.has_need("arr_str_index_of")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_str_index_of(), s);
    }
    // __fern_arr_i32_index_of is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_i32_index_of. Linear scan returning the first index
    // where arr[i] == target, or -1; called via the stack convention.
    if (s.has_need("arr_i32_index_of")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_i32_index_of(), s);
    }
    // The heap arena is no longer a static `.bss` reservation — it is
    // mmap'd lazily on the first __fern_alloc call (see the .bss block +
    // .Lalloc_nofl path in the heap runtime above). That removes the old
    // linker-layout dependency (issue #4081): the arena base comes from
    // the kernel, so bfd / lld / mold all produce a correct binary.
    return s;
}

pub function emit_module(mod: parser.Module): string {
    var parse_errs: string = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
        eprint(parse_errs);
        exit(1);
        return "";
    }
    // Type-check before codegen — BEFORE the IR fast-path below, so an
    // ill-typed module aborts instead of returning IR-emitted assembly that
    // miscompiles silently (#4327: the fused gate+emit used to return ahead
    // of this check, so every IR-eligible module skipped it entirely). The
    // arm64 driver (asm_arm64.emit_module) already orders the gate ahead of
    // its IR branch; this mirrors it. The checker state seeds the same
    // struct-decl/funcs tables the AST-path state below does.
    var chk: asmcore.EmitState = asmcore.new_state();
    chk = asmcore.EmitState { ...chk, struct_decls: mod.structs, funcs: mod.funcs };
    var check_errs: string = asmcore.check_module(mod, chk);
    if (check_errs.len() > 0) {
        eprint(check_errs);
        exit(1);
        return "";
    }
    // IR code path (parallel-path migration, docs/RC-PERCEUS-SELF-HOST-IR-
    // REBUILD.md §3): when use_ir is set AND the whole module is in the IR
    // subset, lower it AST -> stack IR -> asm via asm_ir.emit_module_ir
    // (proven behaviour-equivalent to the AST emit below). use_ir defaults
    // TRUE (asmcore.new_state), so the IR route is the production path and
    // the pre-codegen gate above is load-bearing for it.
    // Hoist no-capture lambda arguments to top-level functions first (closures
    // slice 2a) so a callback-style lambda rides the slice-1 function-value path.
    // A lambda-free module is returned unchanged, so this is inert for them.
    var lm: parser.Module = asm_ir.lift_lambdas(mod);
    // #4394 lever 3: the fused gate+emit lowers each function once and returns ""
    // when the module is ineligible (falls through to the AST emit below), rather
    // than the former all_eligible(lm) gate pass + emit_module_ir(lm) emit pass
    // each lowering every function.
    if (asmcore.new_state().use_ir) {
        var g: string = asm_ir.emit_module_ir_gated(lm, []);
        if (g != "") { return g; }
    }
    // Reset the global strbuf before any .write calls. Output is
    // accumulated there (amortised O(1) per append) and materialised
    // into a fresh string at the tail via strbuf_take().
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // Seed the struct-decl table so emit_expr's ExprStructLit
    // / ExprFieldAccess paths can look up field layout. Builtin enum
    // injection (JsonValue / IoError) happens in the driver via
    // parser.module_with_builtins, so emit_module stays pure.
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own label
    // (__fn_<name>:); _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    // _start: program entry point. If main() exists, call it
    // and use its return value as the exit code. Otherwise
    // run top-level stmts directly.
    s = s.write("_start:\n");
    // If args_count() / arg_at() were used, save argc + argv
    // from the initial stack BEFORE any push (the kernel
    // places argc at the top of the stack on entry).
    if (s.has_need("args")) {
        s = s.write("    movq (%rsp), %rax\n");
        s = s.write("    movq %rax, __fern_argc(%rip)\n");
        s = s.write("    leaq 8(%rsp), %rax\n");
        s = s.write("    movq %rax, __fern_argv(%rip)\n");
    }
    // Save envp for env(). It follows argv's NULL terminator on the
    // entry stack: envp = rsp + 16 + argc*8 (argc at [rsp], argv at
    // rsp+8 with argc+1 slots incl. the NULL). Gated on needs_heap —
    // the env() runtime helper allocates, so it only links when the
    // heap is present, and any program calling env() marks the heap.
    if (s.has_need("heap")) {
        s = s.write("    movq (%rsp), %rax\n");            // argc
        s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");   // envp base
        s = s.write("    movq %rax, __fern_envp(%rip)\n");
    }
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    if (asmcore.has_main(mod)) {
        // call __fn_main; exit with %rax.
        s = s.write("    call __fn_main\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    } else {
        var n_locals: i32 = asmcore.count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    subq $" + util.i32_to_string(bytes) + ", %rsp\n");
        }
        var i: i32 = 0;
        while (i < mod.top_stmts.len()) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit (in case there's no return).
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    s = emit_runtime(s);
    // s.out is always empty by design (writes route through the
    // strbuf primitive instead). Materialise the accumulated bytes.
    return strbuf_take();
}


function emit_source(src: string): string {
    return emit_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // Minimal: `return 42;` should produce asm that contains the
    // literal `$42`, a `pushq` of it, the syscall epilogue with
    // `$60` (sys_exit_group), and `syscall`.
    var a1: string = emit_source("return 42;");
    if (!util.contains(a1, "movq $42")) { return 10; }
    if (!util.contains(a1, "pushq %rax")) { return 11; }
    // The exit code reaches %rdi before the exit_group syscall. Which
    // instruction puts it there is instruction selection, not contract: the AST
    // emitter popped the statement stack straight into %rdi, while the IR path
    // — which now serves these script-shaped sources via asmcore.synth_script_main
    // (#3457) — returns through __fn_main and moves %rax across.
    if (!util.contains(a1, "popq %rdi") && !util.contains(a1, "movq %rax, %rdi")) { return 12; }
    if (!util.contains(a1, "movq $60, %rax")) { return 13; }
    if (!util.contains(a1, "syscall")) { return 14; }
    if (!util.contains(a1, ".globl _start")) { return 15; }

    // Arithmetic: `return 2 + 3;` should emit addq.
    var a2: string = emit_source("return 2 + 3;");
    if (!util.contains(a2, "movq $2")) { return 20; }
    if (!util.contains(a2, "movq $3")) { return 21; }
    if (!util.contains(a2, "addq")) { return 22; }

    // Subtraction.
    var a3: string = emit_source("return 7 - 4;");
    if (!util.contains(a3, "subq")) { return 30; }

    // Multiplication.
    var a4: string = emit_source("return 6 * 7;");
    if (!util.contains(a4, "imulq")) { return 40; }

    // Division — emits cqto for sign-extension + idivq.
    var a5: string = emit_source("return 20 / 4;");
    if (!util.contains(a5, "cqto")) { return 50; }
    if (!util.contains(a5, "idivq")) { return 51; }

    // Modulo — moves remainder from rdx into rax.
    var a6: string = emit_source("return 23 % 5;");
    if (!util.contains(a6, "cqto")) { return 60; }
    if (!util.contains(a6, "idivq")) { return 61; }
    if (!util.contains(a6, "movq %rdx, %rax")) { return 62; }

    // Unary negation. The AST emitter selected `negq`; the IR path (which serves
    // this script-shaped source since #3457) lowers `-x` as `0 - x`, so accept
    // either — the contract is that the negation is materialised, not how.
    var a7: string = emit_source("return -5;");
    if (!util.contains(a7, "negq") && !util.contains(a7, "subq")) { return 70; }

    // Nested expressions: `return (2 + 3) * 4;` — should have
    // an addq before the imulq (left subtree fully emitted
    // first).
    var a8: string = emit_source("return (2 + 3) * 4;");
    if (!util.contains(a8, "addq")) { return 80; }
    if (!util.contains(a8, "imulq")) { return 81; }

    // Comparisons: each op emits `cmpq` + the matching setcc +
    // a movzbq zero-extension. Result is a 0 or 1 on the rt
    // stack, suitable as an i32 exit code.
    var a9: string = emit_source("return 5 < 10;");
    if (!util.contains(a9, "cmpq")) { return 90; }
    if (!util.contains(a9, "setl")) { return 91; }
    if (!util.contains(a9, "movzbq")) { return 92; }

    var a10: string = emit_source("return 5 <= 5;");
    if (!util.contains(a10, "setle")) { return 100; }

    var a11: string = emit_source("return 7 > 3;");
    if (!util.contains(a11, "setg")) { return 110; }

    var a12: string = emit_source("return 7 >= 7;");
    if (!util.contains(a12, "setge")) { return 120; }

    var a13: string = emit_source("return 4 == 4;");
    if (!util.contains(a13, "sete")) { return 130; }

    var a14: string = emit_source("return 4 != 5;");
    if (!util.contains(a14, "setne")) { return 140; }

    // If/else: emits `cmpq $0`, `je .L0`, the then-block, `jmp
    // .L1`, `.L0:`, the else-block, `.L1:`.
    var a15: string = emit_source("if (true) { return 1; } else { return 2; }");
    if (!util.contains(a15, "cmpq $0")) { return 150; }
    if (!util.contains(a15, "je .L")) { return 151; }
    if (!util.contains(a15, "jmp .L")) { return 152; }
    if (!util.contains(a15, ".L0:")) { return 153; }
    if (!util.contains(a15, ".L1:")) { return 154; }

    // No-else if: only the cond-fail jump label, no second jmp.
    var a16: string = emit_source("if (true) { return 1; } return 0;");
    if (!util.contains(a16, "cmpq $0")) { return 160; }
    if (!util.contains(a16, "je .L")) { return 161; }

    // While: emits top label, cond, je exit, body, jmp top,
    // exit label.
    var a17: string = emit_source("while (1 < 2) { return 0; }");
    if (!util.contains(a17, "cmpq $0")) { return 170; }
    if (!util.contains(a17, "je .L")) { return 171; }
    if (!util.contains(a17, "jmp .L")) { return 172; }

    // Locals: frame prologue + slot store + slot load. `var x =
    // 5; return x;` should pushq %rbp, subq the frame, then
    // movq the literal into -8(%rbp), then pushq from -8(%rbp).
    var a18: string = emit_source("var x = 5; return x;");
    if (!util.contains(a18, "pushq %rbp")) { return 180; }
    if (!util.contains(a18, "movq %rsp, %rbp")) { return 181; }
    if (!util.contains(a18, "subq $")) { return 182; }
    if (!util.contains(a18, "movq %rax, -8(%rbp)")) { return 183; }
    if (!util.contains(a18, "pushq -8(%rbp)")) { return 184; }

    // Multiple locals get distinct slots: -8, -16, -24, ...
    var a19: string = emit_source("var a = 1; var b = 2; var c = 3; return c;");
    if (!util.contains(a19, "movq %rax, -8(%rbp)")) { return 190; }
    if (!util.contains(a19, "movq %rax, -16(%rbp)")) { return 191; }
    if (!util.contains(a19, "movq %rax, -24(%rbp)")) { return 192; }
    if (!util.contains(a19, "pushq -24(%rbp)")) { return 193; }

    // Re-assignment: `x = x + 1;` reads + writes the same slot.
    var a20: string = emit_source("var x = 5; x = x + 1; return x;");
    if (!util.contains(a20, "pushq -8(%rbp)")) { return 200; }
    if (!util.contains(a20, "movq %rax, -8(%rbp)")) { return 201; }
    if (!util.contains(a20, "addq")) { return 202; }

    // Compound assign desugars: `x += 1` → `x = x + 1` so the
    // asm shape is identical.
    var a21: string = emit_source("var x = 0; x += 7; return x;");
    if (!util.contains(a21, "addq")) { return 210; }
    if (!util.contains(a21, "movq %rax, -8(%rbp)")) { return 211; }

    // Counter loop: `var i = 0; while (i < 3) { i = i + 1; }
    // return i;` exercises locals + branches together.
    var a22: string = emit_source(
        "var i = 0; while (i < 3) { i = i + 1; } return i;"
    );
    if (!util.contains(a22, "pushq -8(%rbp)")) { return 220; }
    if (!util.contains(a22, "je .L")) { return 221; }
    if (!util.contains(a22, "jmp .L")) { return 222; }

    // Function decl + call: emits __fn_add label, calls from
    // main, has leave + ret in the body, and _start calls
    // __fn_main.
    var a23: string = emit_source(
        "function add(x: i32, y: i32): i32 { return x + y; }"
        + " function main(): i32 { return add(2, 3); }"
    );
    if (!util.contains(a23, "__fn_add:")) { return 230; }
    if (!util.contains(a23, "__fn_main:")) { return 231; }
    if (!util.contains(a23, "call __fn_add")) { return 232; }
    if (!util.contains(a23, "call __fn_main")) { return 233; }
    if (!util.contains(a23, "leave")) { return 234; }
    if (!util.contains(a23, "ret\n")) { return 235; }

    // print("...") lowers to a write syscall + emits the
    // literal in .rodata at label .S0.
    var a24: string = emit_source("print(\"hi\\n\"); return 0;");
    if (!util.contains(a24, "leaq .S0(%rip)")) { return 240; }
    if (!util.contains(a24, "movq $1, %rdi")) { return 241; }
    if (!util.contains(a24, "movq $1, %rax")) { return 242; }  // sys_write
    if (!util.contains(a24, ".section .rodata")) { return 243; }
    if (!util.contains(a24, ".S0: .ascii")) { return 244; }
    if (!util.contains(a24, "hi")) { return 245; }

    // print_int(N) emits a call to the __fern_print_int helper,
    // which the module appends once at the end of .text.
    var a25: string = emit_source("print_int(42); return 0;");
    if (!util.contains(a25, "call __fern_print_int")) { return 250; }
    if (!util.contains(a25, "__fern_print_int:")) { return 251; }
    if (!util.contains(a25, ".Lpi_div:")) { return 252; }

    // read_int() emits a call to the __fern_read_int helper,
    // which the module appends once at the end of .text.
    var a26: string = emit_source("return read_int();");
    if (!util.contains(a26, "call __fern_read_int")) { return 260; }
    if (!util.contains(a26, "__fern_read_int:")) { return 261; }
    if (!util.contains(a26, ".Lri_loop:")) { return 262; }

    return 0;
}
