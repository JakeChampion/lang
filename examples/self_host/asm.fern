        s = s.write("    pushq %r14\n");           // i
        s = s.write("    movq __fern_argc(%rip), %r12\n");
        s = s.write("    leaq 2(%r12), %rdi\n");   // (argc+2)*8 bytes
        s = s.write("    shlq $3, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");     // cap
        s = s.write("    addq $8, %rax\n");
        s = s.write("    movq %r12, (%rax)\n");     // len
        s = s.write("    movq %rax, %r13\n");       // arr (base+8)
        s = s.write("    movq $0, %r14\n");
        s = s.write(".Largs_loop:\n");
        s = s.write("    cmpq %r12, %r14\n");
        s = s.write("    jge .Largs_done\n");
        s = s.write("    movq %r14, %rdi\n");
        s = s.write("    call __fern_arg_at\n");
        s = s.write("    movq %r14, %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %rax, (%r13,%rcx,8)\n");  // arr[i+1] = box
        s = s.write("    incq %r14\n");
        s = s.write("    jmp .Largs_loop\n");
        s = s.write(".Largs_done:\n");
        s = s.write("    movq %r13, %rax\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
