        s = s.write("    incq %rdx\n");
        s = s.write("    movq (%r12,%rdx,8), %rsi\n");
        s = s.write("    movq %rsi, (%rax,%rdx,8)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Larr_concat_a\n");
        s = s.write(".Larr_concat_b_init:\n");
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Larr_concat_b:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Larr_concat_done\n");
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq (%r13,%rdx,8), %rsi\n");
        s = s.write("    movq %r14, %r8\n");
        s = s.write("    addq %rcx, %r8\n");
        s = s.write("    incq %r8\n");
        s = s.write("    movq %rsi, (%rax,%r8,8)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Larr_concat_b\n");
        s = s.write(".Larr_concat_done:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
