        s = s.write("    movq %r15, %rdi\n");
        s = s.write("    movq -40(%rbp), %rax\n");
        s = s.write("    incq %rax\n");
        s = s.write("    movq (%r12,%rax,8), %rsi\n");
        s = s.write("    call __fern_str_concat\n");
        s = s.write("    movq %rax, %r15\n");
        s = s.write("    incq -40(%rbp)\n");
        s = s.write("    jmp .Lasj_loop\n");
        s = s.write(".Lasj_empty:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq $0, (%rax)\n");
        s = s.write("    movq $0, 8(%rax)\n");
        s = s.write("    jmp .Lasj_exit\n");
        s = s.write(".Lasj_done:\n");
        s = s.write("    movq %r15, %rax\n");
        s = s.write(".Lasj_exit:\n");
        s = s.write("    addq $16, %rsp\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
