// The production consumer for the typed semantic pipeline.
//
// `semsource` produces an `ssasem.Func` from checked syntax and the checker's
// types, `ssaunits` plans its counted units, and `ssarc` lowers both to the
// stack IR the backends already emit (docs/SELFHOST-SEMANTIC-SOURCE.md). Until
// now the only thing that ran that chain over a whole module was a test driver;
// this is where a whole-program emit path asks for it.
//
// The substitution is whole or nothing: every declaration produced, and
// `ircore.lower_gated` reads the produced bodies in place of lowering them, or
// none, and the module keeps the AST lowering it always had. With FERN_SEM_IR
// empty, what a backend receives is what it received before, op for op.
//
// The result is handed to the emit path as a VALUE (`ircore.Sub`) rather than
// produced inside it, so that only a driver that wants the path links the
// pipeline behind it. Linking it everywhere cost the eight backend-carrying
// drivers 6.7-10.2% of their bytes for a flag they never read.
//
// Two contracts hold the mixed module together, one per direction:
//
//   - An AST-lowered CALLER of a produced callee reads registries derived from
//     that callee's SYNTAX, which disagree with the contract a produced body
//     honours. `ssarc.caller_sigs` rewrites them from the verified result and
//     parameter types, and the AST lowering runs with the rewritten set.
//   - A produced CALLER of an AST-lowered callee has no such repair — the
//     callee's parameter modes are whatever the interprocedural fixpoints
//     concluded, not what its declaration says — so such a body keeps the AST
//     lowering instead, and so does anything that called it. `prune` is that
//     fixpoint.
import "./ast";
import "./astwalk";
import "./ir";
import "./ircore";
import "./irlower";
import "./parser";
import "./semsource";
import "./ssasem";
import "./ssarc";
import "./ssaunits";
import "./semtypes";
import "./typeinfo";
import "./util";

// Every body the substitution is considering, declarations first (aligned with
// mod.funcs) and then the instances the declarations asked for. `n1` is the
// symbol a body defines and `n2` the receiver-qualified spelling a method's
// call op names instead; `keep` is whether the body is still going to be
// emitted, which `prune` only ever turns off.
struct Rows {
    body: irlower.LowerResult[],
    n1: string[],
    n2: string[],
    keep: boolean[],
    grows: ssaunits.GrowRow[],
    // The type of every function value each body calls, one entry per
    // indirect call; `prune` reads it against the values the AST lowering
    // builds.
    called: typeinfo.Type[][],
    // Each row's unit plan, kept so a second lowering can take the plan back
    // rather than computing it again for a row the ownership inference did not
    // move (#9969).
    plans: ssaunits.Plan[],
}

// sem_ir_on reports whether the semantic lowering runs: it does unless
// FERN_SEM_IR is set EMPTY, which is the AST lowering unchanged.
//
// The empty value is the off spelling, which is DELIBERATELY not what the
// flags beside it do — `ircore.strict_ir_on` and its neighbours read presence
// alone — so do not "fix" it back. `FERN_SEM_IR=` is how a differential
// harness spells the control leg, and reading it as "set, therefore on" made
// one compare the semantic path against itself: green, and measuring nothing.
// A flag whose whole job is to have an off column has to have one, and now
// that the path is the default the empty value is that column.
pub function sem_ir_on(): boolean {
    match (env("FERN_SEM_IR")) {
        Some(v) => { return v.len() > 0; },
        None => { return true; }
    }
}

// sem_report_on reports whether FERN_SEM_IR_REPORT asks for a line per refusal
// on stderr, and the per-module tally. Nothing about the emitted program
// changes with it; it only says what was produced and why the rest was not.
pub function sem_report_on(): boolean {
    match (env("FERN_SEM_IR_REPORT")) {
        Some(v) => { return v.len() > 0; },
        None => { return false; }
    }
}

// sem_ir_only is the bisect knob: a comma-separated list of name prefixes, and
// only a declaration matching one of them is produced. Everything else keeps
// the AST lowering, and `prune` carries the consequences — so a run under it is
// a mixed module built the same way any other is. Empty (or unset) produces
// everything. It exists because a defect this path introduces shows up as a
// wrong answer from a WHOLE PROGRAM, and halving the produced set is the only
// way to walk in on it: the conformance corpus agrees with the AST path on 496
// of 498 cases and the compiler it builds still segfaults.
function sem_ir_only(): string {
    match (env("FERN_SEM_IR_ONLY")) {
        Some(v) => { return v; },
        None => { return ""; }
    }
}

// FERN_SEM_IR_SKIP is the other half of the knob: the same prefix list, read as
// an exclusion. Halving the produced set with FERN_SEM_IR_ONLY cannot isolate a
// defect that needs a produced CALLER and a produced CALLEE, because either
// half prunes the call between them; removing one prefix at a time from the
// whole set can.
function sem_ir_skip(): string {
    match (env("FERN_SEM_IR_SKIP")) {
        Some(v) => { return v; },
        None => { return ""; }
    }
}

// sem_reuse_on reports whether the second lowering the ownership inference
// asks for takes back the rows the inference did not move, instead of planning
// and lowering every row again (#9969).
//
// `FERN_SEM_REUSE=` is the off column, spelled the way `sem_ir_on` spells
// its own: set-but-empty re-lowers everything. It is what
// TestSelfHostInferredReuseIsIdentical compares the reuse against, and the
// reason the reuse can be held to byte equality rather than argued for — a
// fast path with no slow path to check is a fast path nothing checks.
function sem_reuse_on(): boolean {
    match (env("FERN_SEM_REUSE")) {
        Some(v) => { return v.len() > 0; },
        None => { return true; }
    }
}

function has_prefix_in(list: string, name: string): boolean {
    var at: i32 = 0;
    var field: string = irlower.csv_nth(list, at);
    while (field.len() > 0) {
        if (util.str_has_prefix(name, field)) { return true; }
        at = at + 1;
        field = irlower.csv_nth(list, at);
    }
    return false;
}

// selected reports whether the bisect knobs admit this declaration.
function selected(only: string, skip: string, name: string): boolean {
    if (skip.len() > 0 && has_prefix_in(skip, name)) { return false; }
    if (only.len() == 0) { return true; }
    return has_prefix_in(only, name);
}

// sem_strict_on reports whether FERN_SEM_IR_STRICT makes a module the typed
// path does not produce whole a hard error, where it would keep the AST
// lowering. The refusals are reported first, as FERN_SEM_IR_REPORT would.
pub function sem_strict_on(): boolean {
    match (env("FERN_SEM_IR_STRICT")) {
        Some(v) => { return v.len() > 0; },
        None => { return false; }
    }
}

function report(what: string, why: string): i32 {
    if (sem_report_on() || sem_strict_on()) { eprint("FERN_SEM_IR: " + what + ": " + why + "\n"); }
    return 0;
}

// declined is the cache entry for a function this boundary is not emitting:
// `ok: false` is what the substitution reads as "keep the AST body", and
// nothing emits from it, so the partial-op shape ircore.lower_failed_refuse
// guards against cannot arise.
function declined(why: string): irlower.LowerResult {
    return irlower.LowerResult { ok: false, why: why, ops: [], n_locals: 0, n_params: 0,
        erased_wide: false, superseded: false, arr_slots: [], i64_slots: [], f64_slots: [], str_slots: [],
        alias_incs: [], name: "", result_kind: irlower.result_from_decl() };
}

// The entry for a template whose instances stand for it: a body of no ops
// the emit skips (irlower.LowerResult.superseded), in place of the AST
// lowering of the erased body, whose wasm verdict (erased_wide) would
// otherwise decline a module nothing in it calls that body from (#9838).
function superseded(): irlower.LowerResult {
    return irlower.LowerResult { ok: true, why: "", ops: [], n_locals: 0, n_params: 0,
        erased_wide: false, superseded: true, arr_slots: [], i64_slots: [], f64_slots: [], str_slots: [],
        alias_incs: [], name: "", result_kind: irlower.result_from_decl() };
}

// produced_plan plans one function's units. A refusal at either stage yields a
// plan that is not ok, and the body it would have lowered keeps the AST one.
function produced_plan(p: semsource.Produced, what: string): ssaunits.Plan {
    // A template's erased body is not a body this boundary has: its instances
    // are separate symbols of their own, and the erased symbol keeps the AST
    // lowering that its own AST callers name.
    if (p.template) {
        if (!p.ok && !p.bodyless) { report(what, p.why); }
        return ssaunits.refused("generic template");
    }
    if (!p.ok) { report(what, p.why); return ssaunits.refused(p.why); }
    var plan: ssaunits.Plan = ssaunits.plan(p.func, p.modes);
    if (!plan.ok) { report(what, plan.why); }
    return plan;
}

// produced_body lowers a planned function. Every plan is made before any body
// is lowered, because a caller's bracket reads its callees' plans (`grows`).
function produced_body(p: semsource.Produced, plan: ssaunits.Plan, structs: irlower.StructTab, grows: ssaunits.GrowRow[], what: string): irlower.LowerResult {
    if (!plan.ok) { return declined(plan.why); }
    var r: irlower.LowerResult = ssarc.lower(p.func, p.modes, plan, structs, grows);
    if (!r.ok) { report(what, r.why); return declined(r.why); }
    return r;
}

// A per-type drop or release helper is emitted alongside whichever bodies
// need it, so it is a provided body during the scan rather than a call that
// escapes.
function is_drop_helper(name: string): boolean {
    return util.str_has_prefix(name, "__sem_drop_") || util.str_has_prefix(name, "__sem_release_");
}

function live_reg(r: Rows): irlower.SigReg {
    var rows: string[] = [];
    var i: i32 = 0;
    while (i < r.body.len()) {
        if (r.keep[i]) {
            rows = rows.append(r.n1[i]);
            if (r.n2[i].len() > 0) { rows = rows.append(r.n2[i]); }
        }
        i = i + 1;
    }
    return irlower.sig_reg_of(rows);
}

// escaping_callee names the first direct call or function value in a produced
// body that reaches a symbol no surviving produced body defines. The runtime
// helpers and the C calls are provided bodies with a fixed ABI, so they are
// not it.
// A dyn dispatch reaches every implementation its chain names, so each is a
// callee the same way.
function escaping_callee(r: irlower.LowerResult, reg: irlower.SigReg, funcs: parser.FuncDecl[]): string {
    for o in r.ops {
        if (o.kind_tag == 147) {  // dyn_dispatch
            for arm in semsource.dyn_arms(funcs, ir.dyn_dispatch_method(o.str), ir.dyn_dispatch_traits(o.str)) {
                if (!irlower.sig_reg_has_exact(reg, arm)) { return arm; }
            }
        }
        if (o.kind_tag == 149 || o.kind_tag == 6) {  // call_direct, const_func
            if (!ircore.is_fern_helper(o.str) && !ircore.is_c_call(o.str)
                && !is_drop_helper(o.str) && !irlower.sig_reg_has_exact(reg, o.str)) {
                return o.str;
            }
        }
    }
    return "";
}

// The types of the function values a body calls: the callee value's own type
// at each indirect call.
function called_values(f: ssasem.Func): typeinfo.Type[] {
    var out: typeinfo.Type[] = [];
    for b in f.graph.blocks {
        for ins in b.insts {
            if (ins.kind_tag == ssasem.call_value() && ins.args.len() > 0) { out = out.append(f.values[ins.args[0]]); }
        }
    }
    return out;
}

// A function value the AST lowering builds: the type the box hands out where
// the declaration has a contract to read it from, else its arity alone.
struct AstValue { ty: typeinfo.Type, arity: i32, typed: boolean }

// The hoisted bodies a function value names: a no-capture lambda or a bare
// function name's trampoline, a capturing lambda's body, an immediately
// invoked one (irlower.lift_lambdas).
function hoisted(name: string): boolean {
    return util.contains(name, "$wrap") || util.contains(name, "$clo") || util.contains(name, "$iife");
}

// The function values the AST lowering builds: every hoisted body this
// substitution is not emitting. An array such a body builds holds elements
// it never retained, since the AST lowering's push leaks the buffer instead,
// and a produced body that called the value would release those elements
// as its own. A direct call to such a body is what `escaping_callee` refuses;
// the box that names it reaches a produced body through any caller, so the
// produced side is refused by the value's type instead.
function ast_values(mod: parser.Module, built: semsource.Built, r: Rows): AstValue[] {
    var out: AstValue[] = [];
    var i: i32 = 0;
    while (i < r.keep.len()) {
        if (!r.keep[i]) {
            var key: string = r.n1[i];
            var params: i32 = 0;
            if (i < mod.funcs.len()) { key = call_key(mod.funcs[i]); params = mod.funcs[i].params.len(); }
            else {
                var template: i32 = util.index_of_str(r.n2, built.instances[i - mod.funcs.len()].key);
                key = built.instances[i - mod.funcs.len()].key;
                if (template >= 0 && template < mod.funcs.len()) { params = mod.funcs[template].params.len(); }
            }
            if (hoisted(key) && params > 0) {
                var at: i32 = ssasem.find_contract(built.contracts, key);
                var v: AstValue = AstValue { ty: typeinfo.unchecked(), arity: params - 1, typed: false };
                if (i < mod.funcs.len() && at >= 0 && ssasem.closure_env(built.contracts[at])) {
                    var ty: typeinfo.Type = ssasem.closure_type(built.contracts[at]);
                    v = AstValue { ty: ty, arity: ssasem.func_params(ty).len(), typed: semtypes.concrete(ty, true) };
                }
                out = out.append(v);
            }
        }
        i = i + 1;
    }
    return out;
}

// Whether a function type carries a reference: a parameter or the result
// whose value is a box. A scalar-only callback has nothing either side could
// release, so the two lowerings agree on it whichever built the value.
function carries_reference(t: typeinfo.Type): boolean {
    for p in ssasem.func_params(t) { if (ssasem.reference(p)) { return true; } }
    return ssasem.reference(ssasem.func_result(t));
}

// Whether a value of type `t` may be one the AST lowering built: the same
// type, or the same arity where either side's type is not in hand.
function ast_value_call(called: typeinfo.Type[], values: AstValue[]): string {
    for t in called {
        if (!carries_reference(t)) { continue; }
        var arity: i32 = ssasem.func_params(t).len();
        for v in values {
            if (v.arity != arity) { continue; }
            if (v.typed && semtypes.concrete(t, true) && !semtypes.equal(v.ty, t)) { continue; }
            return "calls a function value of " + util.i32_to_string(arity) + " arguments, a type the AST lowering builds a value of";
        }
    }
    return "";
}

// The declaration a hoisted body was lifted out of: the name before the
// marker. The lift names the box `__mkclo$<creator>$wrapN`, built in the
// creator's body, so the creator is the one that hands the value out.
function creator_of(name: string): string {
    var markers: string[] = ["$wrap", "$clo", "$iife"];
    for m in markers {
        var at: i32 = util.index_of_sub(name, m);
        if (at >= 0) { return slice_unchecked(name, 0, at) + ""; }
    }
    return "";
}

// A produced hoisted body whose value an AST-lowered creator builds is
// called by the AST lowering through that box, under the AST convention:
// the mirror of `ast_value_call`. Such a body keeps the AST lowering, and
// what it calls directly is reached through the direct-call contracts
// (ssarc.caller_sigs, irlower.consume_sigs) instead. A creator no row
// names is read as AST-lowered.
function ast_built_value(r: Rows, i: i32): string {
    var creator: string = creator_of(r.n1[i]);
    if (creator.len() == 0) { return ""; }
    var at: i32 = util.index_of_str(r.n1, creator);
    if (at < 0) { at = util.index_of_str(r.n2, creator); }
    if (at >= 0 && r.keep[at]) { return ""; }
    return "is a function value " + creator + " builds, which the AST lowering defines";
}

// The names a body calls directly, as written: a bare callee, or a method's
// field name with a leading dot, which `rows_of_name` matches against every
// receiver-qualified spelling that ends in it.
function called_name(e: ast.Expr, own acc: string[]): string[] {
    if let ast.ExprCall(c) = e {
        if let ast.ExprIdent(id) = c.callee {
            if (parser.mkclo_body(id.name).len() == 0) { return acc.append(id.name); }
        }
        if let ast.ExprFieldAccess(fa) = c.callee { return acc.append("." + fa.field); }
    }
    return acc;
}

function direct_callees(mod: parser.Module, built: semsource.Built, i: i32): string[] {
    var out: string[] = [];
    if (i < mod.funcs.len()) {
        for st in mod.funcs[i].body { out = astwalk.fold_stmt(st, out, called_name); }
        return out;
    }
    for c in built.instances[i - mod.funcs.len()].func.calls { out = out.append(c.name); }
    return out;
}

// The rows a called name may reach: the declaration or instance of that name,
// or every method whose receiver-qualified spelling ends in the dotted field.
function rows_of_name(r: Rows, name: string): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < r.n1.len()) {
        if (r.n1[i] == name || r.n2[i] == name) { out = out.append(i); }
        else if (name.len() > 0 && name[0] == b'.' && r.n2[i].len() > name.len()
            && slice_unchecked(r.n2[i], r.n2[i].len() - name.len(), r.n2[i].len()) == name) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// Every body an AST-lowered hoisted body reaches by direct call, through any
// AST-lowered body on the way, keeps the AST lowering. A hoisted body is
// called through its box, and the AST lowering's ownership analysis cannot
// see through an indirect call: the AST caller of the box takes nothing
// below it to consume an `own` reference it lent, and releases it after, so
// a produced consumer anywhere in that cone frees it first.
function ast_indirect_cone(r: Rows, mod: parser.Module, built: semsource.Built): Rows {
    var pending: i32[] = [];
    var i: i32 = 0;
    while (i < r.body.len()) {
        if (!r.keep[i] && hoisted(r.n1[i])) { pending = pending.append(i); }
        i = i + 1;
    }
    var seen: i32[] = [];
    var at: i32 = 0;
    while (at < pending.len()) {
        var row: i32 = pending[at];
        at = at + 1;
        if (util.index_of_i32(seen, row) >= 0) { continue; }
        seen = seen.append(row);
        for name in direct_callees(mod, built, row) {
            for callee in rows_of_name(r, name) {
                if (r.keep[callee]) {
                    report(r.n1[callee], "is reached by a direct call from " + r.n1[row] + ", which the AST lowering calls through a box");
                    r = Rows { ...r, keep: r.keep.with(callee, false) };
                }
                pending = pending.append(callee);
            }
        }
    }
    return r;
}

// prune turns off every produced body that calls one this boundary is not
// emitting, to a fixpoint: dropping a body takes its symbol out of the live
// set, so the next round reaches whatever called it, and may make it a
// function value the AST lowering builds, so the next round reaches whatever
// calls a value of its type, and whatever an AST-lowered hoisted body reaches.
// A round that turns nothing off is the fixpoint, and `keep` only ever
// shrinks, so there is one.
function prune(r: Rows, mod: parser.Module, built: semsource.Built): Rows {
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var reg: irlower.SigReg = live_reg(r);
        var values: AstValue[] = ast_values(mod, built, r);
        var i: i32 = 0;
        while (i < r.body.len()) {
            if (r.keep[i]) {
                var bad: string = escaping_callee(r.body[i], reg, mod.funcs);
                if (bad.len() > 0) { bad = "calls " + bad + ", which the AST lowering defines"; }
                else { bad = ast_value_call(r.called[i], values); }
                if (bad.len() == 0) { bad = ast_built_value(r, i); }
                if (bad.len() > 0) {
                    report(r.n1[i], bad);
                    r = Rows { ...r, keep: r.keep.with(i, false) };
                    changed = true;
                }
            }
            i = i + 1;
        }
        var before: i32 = kept_count(r);
        r = ast_indirect_cone(r, mod, built);
        if (kept_count(r) != before) { changed = true; }
    }
    return r;
}

function kept_count(r: Rows): i32 {
    var n: i32 = 0;
    for k in r.keep { if (k) { n = n + 1; } }
    return n;
}

// The symbol a call to declaration `i` names: the receiver-qualified spelling
// for a method, the bare name otherwise.
function call_key(fd: parser.FuncDecl): string {
    if (fd.receiver_type.len() > 0) { return util.base_type_name(fd.receiver_type) + "." + fd.name; }
    return fd.name;
}

// The produced body at row `i`: a declaration first, then an instance.
function produced_at(built: semsource.Built, mod: parser.Module, i: i32): semsource.Produced {
    if (i < mod.funcs.len()) { return built.decls[i]; }
    return built.instances[i - mod.funcs.len()];
}

// No rows to take back: what the FIRST lowering of a module is handed, and
// what makes `rows_of` compute every plan and every body.
function no_reuse(): Rows {
    return Rows { body: [], n1: [], n2: [], keep: [], grows: [], called: [], plans: [] };
}

// Whether row `i` can be taken from `prev` unchanged. `changed` is
// `semsource.changed_rows` over the two module productions, in this same
// order, so a row is reusable exactly where the inference moved neither its
// own modes nor a contract it calls. An empty `prev` reuses nothing, which is
// what the first lowering passes.
function row_reusable(prev: Rows, changed: boolean[], i: i32): boolean {
    if (!sem_reuse_on()) { return false; }
    if (i >= prev.plans.len() || i >= prev.body.len() || i >= changed.len()) { return false; }
    return !changed[i];
}

// rows_of produces every body once and records the symbols each defines: every
// plan first, then the callee table the brackets read, then every body.
//
// `prev` / `changed` let a second lowering take back the rows the ownership
// inference did not move. A plan is a function of its row's graph and modes
// alone, so an unmoved row's plan comes straight back. A BODY also reads the
// module's grow table, but only through the callees it names
// (`ssarc.bracketed`), so it comes back when those callees' rows agree —
// which they need not, since a moved row can grow a callee's mask and change
// how every caller of it brackets.
function rows_of(mod: parser.Module, built: semsource.Built, structs: irlower.StructTab, prev: Rows, changed: boolean[]): Rows {
    var only: string = sem_ir_only();
    var skip: string = sem_ir_skip();
    var r: Rows = no_reuse();
    var plans: ssaunits.Plan[] = [];
    var keys: string[] = [];
    var funcs: ssasem.Func[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[i];
        var plan: ssaunits.Plan = ssaunits.refused("not selected");
        if (row_reusable(prev, changed, i)) { plan = prev.plans[i]; }
        else if (selected(only, skip, fd.name)) { plan = produced_plan(built.decls[i], fd.name); }
        plans = plans.append(plan);
        keys = keys.append(call_key(fd));
        funcs = funcs.append(built.decls[i].func);
        r = Rows { ...r, n1: r.n1.append(fd.name), n2: r.n2.append(call_key(fd)), called: r.called.append(called_values(built.decls[i].func)) };
        i = i + 1;
    }
    var at: i32 = mod.funcs.len();
    for p in built.instances {
        // An instance is named after the template it came from, so the bisect
        // knob reaches it through the same prefix test.
        var plan: ssaunits.Plan = ssaunits.refused("not selected");
        if (row_reusable(prev, changed, at)) { plan = prev.plans[at]; }
        else if (selected(only, skip, p.func.graph.name)) { plan = produced_plan(p, p.func.graph.name); }
        plans = plans.append(plan);
        keys = keys.append(p.func.graph.name);
        funcs = funcs.append(p.func);
        r = Rows { ...r, n1: r.n1.append(p.func.graph.name), n2: r.n2.append(""), called: r.called.append(called_values(p.func)) };
        at = at + 1;
    }
    r = Rows { ...r, grows: ssaunits.grow_table(keys, funcs, plans), plans: plans };
    i = 0;
    while (i < plans.len()) {
        var body: irlower.LowerResult = reused_or_lowered(built, mod, structs, r, prev, changed, i);
        r = Rows { ...r, body: r.body.append(body), keep: r.keep.append(body.ok) };
        i = i + 1;
    }
    return r;
}

// Row `i`'s body: `prev`'s where the inference moved neither the row nor the
// grow mask of any callee it names, freshly lowered otherwise.
function reused_or_lowered(built: semsource.Built, mod: parser.Module, structs: irlower.StructTab, r: Rows, prev: Rows, changed: boolean[], i: i32): irlower.LowerResult {
    var p: semsource.Produced = produced_at(built, mod, i);
    if (row_reusable(prev, changed, i)
        && ssaunits.grow_rows_agree(prev.grows, r.grows, ssasem.called_names(p.func))) {
        return prev.body[i];
    }
    return produced_body(p, r.plans[i], structs, r.grows, r.n1[i]);
}

// substitution produces every function this boundary admits and hands the
// result back as a value for the emit path to thread in (ircore.Sub). The
// caller normalises the module exactly as the emit path does, so the bodies
// line up with `mod.funcs` position for position.
//
// `base` is the pre-`append_dyn` registry set the emitters read; the rows
// caller_sigs rewrites are returned in the Sub, and the emit and the AST
// lowering of what is left both read them.
struct Inference { built: semsource.Built, rows: Rows }

// Whether the typed pipeline lowers EVERY body of this module. A template's
// erased body is not one — its instances stand for it — and neither is a
// declaration with no body here.
function lowers_whole_module(built: semsource.Built, r: Rows): boolean {
    var i: i32 = 0;
    while (i < r.keep.len()) {
        if (!r.keep[i]) {
            if (i >= built.decls.len()) { return false; }
            if (!built.decls[i].template && !built.decls[i].bodyless) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// The ownership inference, applied only where it is sound to.
//
// A mode `semsource.with_inferred_modes` infers is invisible to the AST
// lowering, which reads `own` off the declaration and nothing else. In a MIXED
// module an AST-lowered caller therefore hands a borrowed argument to a callee
// that now releases one, and the count goes under — a segfault building the
// compiler, and `field-append` answering 3 where it answers 199. A declared
// `own` is safe there precisely because it is a source fact both lowerings
// read.
//
// So the inference runs only when this pass lowers the whole module, which is
// what `prune` has just decided. The second lowering is what that costs, and
// it is never paid where it would hurt: a module with anything left to the AST
// lowering fails the test on the FIRST pass and never reaches here. The second
// pass is checked as well as the first — a mode can refuse a plan
// (`ssaunits.mode_error`), and a module that stops lowering whole under the
// inference keeps the modes it declared.
function inferred_pass(mod: parser.Module, built: semsource.Built, r: Rows, structs: irlower.StructTab): Inference {
    var same: Inference = Inference { built: built, rows: r };
    if (!lowers_whole_module(built, r)) { return same; }
    var widened: semsource.Built = semsource.with_inferred_modes(built);
    var changed: boolean[] = semsource.changed_rows(built, widened);
    if (!semsource.any_row_changed(changed)) { return same; }
    var r2: Rows = prune(rows_of(mod, widened, structs, r, changed), mod, widened);
    if (!lowers_whole_module(widened, r2)) { return same; }
    return Inference { built: widened, rows: r2 };
}

pub function substitution(mod: parser.Module, structs: irlower.StructTab, base: irlower.FnSigs): ircore.Sub {
    if (!sem_ir_on()) { return ircore.no_sub(); }
    var built: semsource.Built = semsource.build_module(mod);
    util.arr_push_cliff_report("sem:built", 0);
    var rows: Rows = rows_of(mod, built, structs, no_reuse(), []);
    util.arr_push_cliff_report("sem:lowered", 0);
    var r: Rows = prune(rows, mod, built);
    util.arr_push_cliff_report("sem:pruned", 0);
    var inf: Inference = inferred_pass(mod, built, r, structs);
    built = inf.built;
    r = inf.rows;
    var sigs: irlower.FnSigs = base;
    var helpers: irlower.LowerResult[] = [];
    var bodies: irlower.LowerResult[] = [];
    // The may-grow masks an AST caller brackets by are rebuilt with every
    // produced declaration's own in place of the one its syntax would give.
    var seeds: string[] = [];
    // The `own` array positions the produced bodies consume, which an AST
    // caller reads as a transfer rather than a borrow it releases after
    // (irlower.own_consumed_positions). An instance is keyed by its template,
    // since that is the name an AST caller's call spells.
    var consumed: string[] = [];
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (r.keep[i]) {
            sigs = ssarc.caller_sigs(sigs, mod.funcs[i].name, built.decls[i].func, built.decls[i].modes, r.plans[i]);
            seeds = seeds.append(call_key(mod.funcs[i]) + "|"
                + ssarc.grow_mask(call_key(mod.funcs[i]), built.decls[i].func, r.grows, mod.funcs[i].receiver_type.len() > 0));
            if (mod.funcs[i].receiver_type.len() == 0) {
                consumed = util.append_all(consumed, ssarc.consumed_array_rows(mod.funcs[i].name, built.decls[i].func, built.decls[i].modes));
            }
            helpers = util.append_all(helpers, ssarc.drop_helpers(built.decls[i].func));
            bodies = bodies.append(r.body[i]);
            n = n + 1;
        } else if (built.decls[i].template && (built.decls[i].ok || built.decls[i].bodyless)) {
            // A template's erased body is no body of this module's: its
            // produced instances stand for it, and one nothing instantiates
            // is called by nobody. Neither is a refusal.
            bodies = bodies.append(declined("generic template"));
            n = n + 1;
        } else { bodies = bodies.append(declined("kept the AST lowering")); }
        i = i + 1;
    }
    var instances: irlower.LowerResult[] = [];
    var at: i32 = 0;
    while (at < built.instances.len()) {
        if (r.keep[mod.funcs.len() + at]) {
            helpers = util.append_all(helpers, ssarc.drop_helpers(built.instances[at].func));
            instances = instances.append(r.body[mod.funcs.len() + at]);
            if (!util.contains(built.instances[at].key, ".")) {
                consumed = util.append_all(consumed, ssarc.consumed_array_rows(built.instances[at].key, built.instances[at].func, built.instances[at].modes));
            }
        }
        at = at + 1;
    }
    if (seeds.len() > 0) { sigs = irlower.regrow_sigs(sigs, mod.funcs, structs, seeds); }
    if (consumed.len() > 0) { sigs = irlower.consume_sigs(sigs, mod.funcs, consumed); }
    util.arr_push_cliff_report("sem:substituted", 0);
    // Production is all or nothing: a module with a refused declaration keeps
    // the AST lowering whole, since a produced body beside an AST-lowered one
    // is two memory conventions on one module, sound only where the contracts
    // `prune` reads cover every crossing. The bisect knobs keep the mixed
    // module, which is what they exist to halve.
    if (n < mod.funcs.len() && sem_ir_only() == "" && sem_ir_skip() == "") {
        report("module", "produced 0 of " + util.i32_to_string(mod.funcs.len()) + " declarations and 0 of "
            + util.i32_to_string(built.instances.len()) + " instances: "
            + util.i32_to_string(mod.funcs.len() - n) + " refused, the AST lowering stands");
        if (sem_strict_on()) {
            eprint("FERN_SEM_IR_STRICT: the typed lowering refused " + util.i32_to_string(mod.funcs.len() - n) + " declarations; the FERN_SEM_IR lines above name each\n");
            exit(3);
        }
        return ircore.no_sub();
    }
    report("module", "produced " + util.i32_to_string(n) + " of "
        + util.i32_to_string(mod.funcs.len()) + " declarations and "
        + util.i32_to_string(instances.len()) + " of "
        + util.i32_to_string(built.instances.len()) + " instances");
    // A module produced whole calls no template's erased body: every caller
    // is produced and calls an instance. Under the bisect knobs an AST-lowered
    // caller may still call it, so there the AST lowering stands.
    if (n == mod.funcs.len() && sem_ir_only() == "" && sem_ir_skip() == "") {
        var i2: i32 = 0;
        while (i2 < mod.funcs.len()) {
            if (!bodies[i2].ok && built.decls[i2].template) { bodies = bodies.with(i2, superseded()); }
            i2 = i2 + 1;
        }
    }
    // The declaration-less bodies are deduped by symbol and conflict-checked
    // here, where the rule lives, so the emit path's tail is a plain append.
    var extra: irlower.LowerResult[] = ssarc.merge_helpers(instances, helpers);
    if (n == 0 && extra.len() == 0) { return ircore.no_sub(); }
    return ircore.Sub { on: true, bodies: bodies, extra: extra, sigs: sigs };
}

// The module an emit path gates and emits, so a caller can produce the
// substitution against the same normalisation and the same order. The x86-64
// and arm64 paths spell it this way; the wasm one has its own
// (wasm_ir.route_normalized), which its caller asks for instead.
pub function gated_module(mod: parser.Module): parser.Module {
    return parser.infer_ret_types_module(ircore.script_normalized(mod));
}
