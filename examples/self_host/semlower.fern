// The production consumer for the typed semantic pipeline.
//
// `semsource` produces an `ssasem.Func` from checked syntax and the checker's
// types, `ssaunits` plans its counted units, and `ssarc` lowers both to the
// stack IR the backends already emit (docs/SELFHOST-SEMANTIC-SOURCE.md). Until
// now the only thing that ran that chain over a whole module was a test driver;
// this is where a whole-program emit path asks for it.
//
// The substitution is per function against the AST lowering, which stays the
// module's eligibility verdict: `ircore.lower_gated` still lowers and judges
// every function, and a produced body replaces its cache entry afterwards. With
// FERN_SEM_IR unset, what a backend receives is what it received before, op for
// op.
//
// The result is handed to the emit path as a VALUE (`ircore.Sub`) rather than
// produced inside it, so that only a driver that wants the path links the
// pipeline behind it. Linking it everywhere cost the eight backend-carrying
// drivers 6.7-10.2% of their bytes for a flag they never read.
//
// Two contracts hold the mixed module together, one per direction:
//
//   - An AST-lowered CALLER of a produced callee reads registries derived from
//     that callee's SYNTAX, which disagree with the contract a produced body
//     honours. `ssarc.caller_sigs` rewrites them from the verified result and
//     parameter types, and the AST lowering runs with the rewritten set.
//   - A produced CALLER of an AST-lowered callee has no such repair — the
//     callee's parameter modes are whatever the interprocedural fixpoints
//     concluded, not what its declaration says — so such a body keeps the AST
//     lowering instead, and so does anything that called it. `prune` is that
//     fixpoint.
import "./ircore";
import "./irlower";
import "./parser";
import "./semsource";
import "./ssarc";
import "./ssaunits";
import "./util";

// Every body the substitution is considering, declarations first (aligned with
// mod.funcs) and then the instances the declarations asked for. `n1` is the
// symbol a body defines and `n2` the receiver-qualified spelling a method's
// call op names instead; `keep` is whether the body is still going to be
// emitted, which `prune` only ever turns off.
struct Rows {
    body: irlower.LowerResult[],
    n1: string[],
    n2: string[],
    keep: boolean[],
    grows: ssaunits.GrowRow[],
}

// sem_ir_on reports whether FERN_SEM_IR selects the semantic lowering. Off is
// the AST lowering unchanged.
//
// An EMPTY value is off, which is DELIBERATELY not what the flags beside it do
// — `ircore.strict_ir_on` and its neighbours read presence alone — so do not
// "fix" it back. `FERN_SEM_IR=` is how a differential harness spells the
// control leg, and reading it as "set, therefore on" made one compare the
// semantic path against itself: green, and measuring nothing. A flag whose
// whole job is to have an off column has to have one.
pub function sem_ir_on(): boolean {
    match (env("FERN_SEM_IR")) {
        Some(v) => { return v.len() > 0; },
        None => { return false; }
    }
}

// sem_report_on reports whether FERN_SEM_IR_REPORT asks for a line per refusal
// on stderr, and the per-module tally. Nothing about the emitted program
// changes with it; it only says what was produced and why the rest was not.
pub function sem_report_on(): boolean {
    match (env("FERN_SEM_IR_REPORT")) {
        Some(v) => { return v.len() > 0; },
        None => { return false; }
    }
}

// sem_ir_only is the bisect knob: a comma-separated list of name prefixes, and
// only a declaration matching one of them is produced. Everything else keeps
// the AST lowering, and `prune` carries the consequences — so a run under it is
// a mixed module built the same way any other is. Empty (or unset) produces
// everything. It exists because a defect this path introduces shows up as a
// wrong answer from a WHOLE PROGRAM, and halving the produced set is the only
// way to walk in on it: the conformance corpus agrees with the AST path on 496
// of 498 cases and the compiler it builds still segfaults.
function sem_ir_only(): string {
    match (env("FERN_SEM_IR_ONLY")) {
        Some(v) => { return v; },
        None => { return ""; }
    }
}

// FERN_SEM_IR_SKIP is the other half of the knob: the same prefix list, read as
// an exclusion. Halving the produced set with FERN_SEM_IR_ONLY cannot isolate a
// defect that needs a produced CALLER and a produced CALLEE, because either
// half prunes the call between them; removing one prefix at a time from the
// whole set can.
function sem_ir_skip(): string {
    match (env("FERN_SEM_IR_SKIP")) {
        Some(v) => { return v; },
        None => { return ""; }
    }
}

function has_prefix_in(list: string, name: string): boolean {
    var at: i32 = 0;
    var field: string = irlower.csv_nth(list, at);
    while (field.len() > 0) {
        if (util.str_has_prefix(name, field)) { return true; }
        at = at + 1;
        field = irlower.csv_nth(list, at);
    }
    return false;
}

// selected reports whether the bisect knobs admit this declaration.
function selected(only: string, skip: string, name: string): boolean {
    if (skip.len() > 0 && has_prefix_in(skip, name)) { return false; }
    if (only.len() == 0) { return true; }
    return has_prefix_in(only, name);
}

function report(what: string, why: string): i32 {
    if (sem_report_on()) { eprint("FERN_SEM_IR: " + what + ": " + why + "\n"); }
    return 0;
}

// declined is the cache entry for a function this boundary is not emitting:
// `ok: false` is what the substitution reads as "keep the AST body", and
// nothing emits from it, so the partial-op shape ircore.lower_failed_refuse
// guards against cannot arise.
function declined(why: string): irlower.LowerResult {
    return irlower.LowerResult { ok: false, why: why, ops: [], n_locals: 0, n_params: 0,
        erased_wide: false, arr_slots: [], i64_slots: [], f64_slots: [], str_slots: [],
        alias_incs: [], name: "", result_kind: irlower.result_from_decl() };
}

// produced_plan plans one function's units. A refusal at either stage yields a
// plan that is not ok, and the body it would have lowered keeps the AST one.
function produced_plan(p: semsource.Produced, what: string): ssaunits.Plan {
    // A template's erased body is not a body this boundary has: its instances
    // are separate symbols of their own, and the erased symbol keeps the AST
    // lowering that its own AST callers name.
    if (p.template) { return ssaunits.refused("generic template"); }
    if (!p.ok) { report(what, p.why); return ssaunits.refused(p.why); }
    var plan: ssaunits.Plan = ssaunits.plan(p.func, p.modes);
    if (!plan.ok) { report(what, plan.why); }
    return plan;
}

// produced_body lowers a planned function. Every plan is made before any body
// is lowered, because a caller's bracket reads its callees' plans (`grows`).
function produced_body(p: semsource.Produced, plan: ssaunits.Plan, structs: irlower.StructTab, grows: ssaunits.GrowRow[], what: string): irlower.LowerResult {
    if (!plan.ok) { return declined(plan.why); }
    var r: irlower.LowerResult = ssarc.lower(p.func, p.modes, plan, structs, grows);
    if (!r.ok) { report(what, r.why); return declined(r.why); }
    return r;
}

// A per-type drop helper is emitted alongside whichever bodies need it, so it
// is a provided body during the scan rather than a call that escapes.
function is_drop_helper(name: string): boolean {
    return util.str_has_prefix(name, "__sem_drop_");
}

function live_reg(r: Rows): irlower.SigReg {
    var rows: string[] = [];
    var i: i32 = 0;
    while (i < r.body.len()) {
        if (r.keep[i]) {
            rows = rows.append(r.n1[i]);
            if (r.n2[i].len() > 0) { rows = rows.append(r.n2[i]); }
        }
        i = i + 1;
    }
    return irlower.sig_reg_of(rows);
}

// escaping_callee names the first direct call or function value in a produced
// body that reaches a symbol no surviving produced body defines. The runtime
// helpers and the C calls are provided bodies with a fixed ABI, so they are
// not it.
function escaping_callee(r: irlower.LowerResult, reg: irlower.SigReg): string {
    for o in r.ops {
        if (o.kind_tag == 149 || o.kind_tag == 6) {  // call_direct, const_func
            if (!ircore.is_fern_helper(o.str) && !ircore.is_c_call(o.str)
                && !is_drop_helper(o.str) && !irlower.sig_reg_has_exact(reg, o.str)) {
                return o.str;
            }
        }
    }
    return "";
}

// prune turns off every produced body that calls one this boundary is not
// emitting, to a fixpoint: dropping a body takes its symbol out of the live
// set, so the next round reaches whatever called it. A round that turns
// nothing off is the fixpoint, and `keep` only ever shrinks, so there is one.
function prune(r: Rows): Rows {
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var reg: irlower.SigReg = live_reg(r);
        var i: i32 = 0;
        while (i < r.body.len()) {
            if (r.keep[i]) {
                var bad: string = escaping_callee(r.body[i], reg);
                if (bad.len() > 0) {
                    report(r.n1[i], "calls " + bad + ", which the AST lowering defines");
                    r = Rows { ...r, keep: r.keep.with(i, false) };
                    changed = true;
                }
            }
            i = i + 1;
        }
    }
    return r;
}

// The symbol a call to declaration `i` names: the receiver-qualified spelling
// for a method, the bare name otherwise.
function call_key(fd: parser.FuncDecl): string {
    if (fd.receiver_type.len() > 0) { return util.base_type_name(fd.receiver_type) + "." + fd.name; }
    return fd.name;
}

// The produced body at row `i`: a declaration first, then an instance.
function produced_at(built: semsource.Built, mod: parser.Module, i: i32): semsource.Produced {
    if (i < mod.funcs.len()) { return built.decls[i]; }
    return built.instances[i - mod.funcs.len()];
}

// rows_of produces every body once and records the symbols each defines: every
// plan first, then the callee table the brackets read, then every body.
function rows_of(mod: parser.Module, built: semsource.Built, structs: irlower.StructTab): Rows {
    var only: string = sem_ir_only();
    var skip: string = sem_ir_skip();
    var r: Rows = Rows { body: [], n1: [], n2: [], keep: [], grows: [] };
    var plans: ssaunits.Plan[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[i];
        var plan: ssaunits.Plan = ssaunits.refused("not selected");
        if (selected(only, skip, fd.name)) { plan = produced_plan(built.decls[i], fd.name); }
        if (plan.ok) { r = Rows { ...r, grows: util.append_all(r.grows, ssaunits.grow_rows(call_key(fd), built.decls[i].func, plan)) }; }
        plans = plans.append(plan);
        r = Rows { ...r, n1: r.n1.append(fd.name), n2: r.n2.append(call_key(fd)) };
        i = i + 1;
    }
    for p in built.instances {
        // An instance is named after the template it came from, so the bisect
        // knob reaches it through the same prefix test.
        var plan: ssaunits.Plan = ssaunits.refused("not selected");
        if (selected(only, skip, p.func.graph.name)) { plan = produced_plan(p, p.func.graph.name); }
        if (plan.ok) { r = Rows { ...r, grows: util.append_all(r.grows, ssaunits.grow_rows(p.func.graph.name, p.func, plan)) }; }
        plans = plans.append(plan);
        r = Rows { ...r, n1: r.n1.append(p.func.graph.name), n2: r.n2.append("") };
    }
    i = 0;
    while (i < plans.len()) {
        var body: irlower.LowerResult = produced_body(produced_at(built, mod, i), plans[i], structs, r.grows, r.n1[i]);
        r = Rows { ...r, body: r.body.append(body), keep: r.keep.append(body.ok) };
        i = i + 1;
    }
    return r;
}

// substitution produces every function this boundary admits and hands the
// result back as a value for the emit path to thread in (ircore.Sub). The
// caller normalises the module exactly as the emit path does, so the bodies
// line up with `mod.funcs` position for position.
//
// `base` is the pre-`append_dyn` registry set the emitters read; the rows
// caller_sigs rewrites are returned in the Sub, and the emit and the AST
// lowering of what is left both read them.
pub function substitution(mod: parser.Module, structs: irlower.StructTab, base: irlower.FnSigs): ircore.Sub {
    if (!sem_ir_on()) { return ircore.no_sub(); }
    var built: semsource.Built = semsource.build_module(mod);
    var r: Rows = prune(rows_of(mod, built, structs));
    var sigs: irlower.FnSigs = base;
    var helpers: irlower.LowerResult[] = [];
    var bodies: irlower.LowerResult[] = [];
    // The may-grow masks an AST caller brackets by are rebuilt with every
    // produced declaration's own in place of the one its syntax would give.
    var seeds: string[] = [];
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (r.keep[i]) {
            sigs = ssarc.caller_sigs(sigs, mod.funcs[i].name, built.decls[i].func, built.decls[i].modes);
            seeds = seeds.append(call_key(mod.funcs[i]) + "|"
                + ssarc.grow_mask(call_key(mod.funcs[i]), built.decls[i].func, r.grows, mod.funcs[i].receiver_type.len() > 0));
            helpers = util.append_all(helpers, ssarc.drop_helpers(built.decls[i].func));
            bodies = bodies.append(r.body[i]);
            n = n + 1;
        } else { bodies = bodies.append(declined("kept the AST lowering")); }
        i = i + 1;
    }
    var instances: irlower.LowerResult[] = [];
    var at: i32 = 0;
    while (at < built.instances.len()) {
        if (r.keep[mod.funcs.len() + at]) {
            helpers = util.append_all(helpers, ssarc.drop_helpers(built.instances[at].func));
            instances = instances.append(r.body[mod.funcs.len() + at]);
        }
        at = at + 1;
    }
    if (seeds.len() > 0) { sigs = irlower.regrow_sigs(sigs, mod.funcs, structs, seeds); }
    report("module", "produced " + util.i32_to_string(n) + " of "
        + util.i32_to_string(mod.funcs.len()) + " declarations and "
        + util.i32_to_string(instances.len()) + " of "
        + util.i32_to_string(built.instances.len()) + " instances");
    // The declaration-less bodies are deduped by symbol and conflict-checked
    // here, where the rule lives, so the emit path's tail is a plain append.
    var extra: irlower.LowerResult[] = ssarc.merge_helpers(instances, helpers);
    if (n == 0 && extra.len() == 0) { return ircore.no_sub(); }
    return ircore.Sub { on: true, bodies: bodies, extra: extra, sigs: sigs };
}

// The module an emit path gates and emits, so a caller can produce the
// substitution against the same normalisation and the same order. The x86-64
// and arm64 paths spell it this way; the wasm one has its own
// (wasm_ir.route_normalized), which its caller asks for instead.
pub function gated_module(mod: parser.Module): parser.Module {
    return parser.infer_ret_types_module(ircore.script_normalized(mod));
}
