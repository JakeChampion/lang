// Exact declaration adapters for passes that still consume ParamDecl metadata.
// Keep signature construction in one place: typed match binders and legacy
// declaration spellings must describe the same closure calling convention.
import "./ast";
import "./parser";
import "./typeinfo";
import "./util";

function declined(name: string): ast.ParamDecl {
  return ast.ParamDecl { name: name, type_name: "", is_str: false, own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" };
}

pub function param_from_type(name: string, t: typeinfo.Type): ast.ParamDecl {
  if let typeinfo.TypeFunc(f) = t { return fn_param_from_type(name, t); }
  var spelling: string = typeinfo.spelling(t);
  var view: boolean = spelling == "str";
  if (view) { spelling = "string"; }
  return ast.ParamDecl { ...declined(name), type_name: spelling, is_str: view };
}

pub function fn_param_decl(name: string, tys: string[], ret: string): ast.ParamDecl {
  if (ret.len() == 0) { return declined(name); }
  var ptys: string = "";
  var dyns: string = "";
  var i: i32 = 0;
  while (i < tys.len()) {
    if (tys[i].len() == 0) { return declined(name); }
    if (i > 0) { ptys = ptys + ","; }
    ptys = ptys + tys[i];
    if (tys[i].len() > 4 && slice_unchecked(tys[i], 0, 4) == "dyn ") {
      if (dyns.len() > 0) { dyns = dyns + ","; }
      dyns = dyns + util.i32_to_string(i);
    }
    i = i + 1;
  }
  return ast.ParamDecl { name: name, type_name: "fn", is_str: false, own: false, has_default: false, default_value: parser.e_unknown(""), ret_arr: false, fn_ret: ret, fn_param_dyn: dyns, fn_param_types: ptys };
}

pub function fn_param_from_spelling(name: string, sp: string): ast.ParamDecl {
  var r: parser.TypeRef = parser.parse_type_ref(sp);
  if (!parser.ref_is_fn_value(r)) { return declined(name); }
  var f: parser.TypeRef = parser.ref_ungroup(r);
  var params: string[] = [];
  var i: i32 = 0;
  while (i + 1 < f.args.len()) {
    params = params.append(parser.render_type_ref(f.args[i]));
    i = i + 1;
  }
  return fn_param_decl(name, params, parser.render_type_ref(parser.ref_fn_result(r)));
}

pub function fn_param_from_type(name: string, t: typeinfo.Type): ast.ParamDecl {
  if let typeinfo.TypeFunc(f) = t {
    if (!f.params_known) { return declined(name); }
    var params: string[] = [];
    for param in f.param_types { params = params.append(typeinfo.spelling(param)); }
    return fn_param_decl(name, params, typeinfo.spelling(f.ret_type));
  }
  return declined(name);
}

pub function fn_param_from_var(v: ast.StmtVar): ast.ParamDecl {
  if (v.type_name == "fn" && v.fn_ret.len() > 0) {
    return fn_param_from_spelling(v.name, "(" + v.fn_param_types + ") => " + v.fn_ret);
  }
  return fn_param_from_spelling(v.name, v.type_name);
}
