import "./ast";
import "./util";

// astwalk — shared AST traversals for the self-hosted compiler.
// First home (SH-022): the free-variable collectors used by every
// backend's closure/capture analysis. asmcore / ssa / vm carried
// byte-identical copies of these; they now live here once. Imports
// only parser, so any frontend module can depend on it.

// fold_expr threads `acc` through every expression reachable from `e`, calling
// `visit` on each node in pre-order before descending into its children. It is
// the shared spine the hand-written per-consumer traversals collapse onto: a
// consumer writes only what one node contributes and inherits the recursion, so
// a new parser node is covered everywhere the moment it is covered here (#6993).
//
// `visit` reaches it as a nested named function closing over whatever context
// the consumer needs — see collect_qualrefs_expr. An arrow lambda works too
// since #6996; the named form is kept because it reads better at the call site.
pub function fold_expr[T](e: ast.Expr, acc: T, visit: (ast.Expr, T) => T): T {
    return fold_expr_pruned(e, acc, visit, descend_all);
}

// fold_stmt is fold_expr's statement half: it visits every EXPRESSION `st`
// reaches, in source order. The statement nodes themselves are visited by
// fold_stmt_nodes, or by fold_stmt_spine when the consumer wants statements
// alone — a binder name, an assignment target — and no expression at all.
pub function fold_stmt[T](st: ast.Stmt, acc: T, visit: (ast.Expr, T) => T): T {
    return fold_stmt_pruned(st, acc, visit, descend_all);
}

// descend_all is the unpruned walk's descent rule: every node's children are
// reachable.
pub function descend_all(e: ast.Expr): boolean { return true; }

// fold_expr_pruned is fold_expr with descent control. `visit` still sees every
// node the walk reaches; `descend` then decides whether that node's CHILDREN
// are walked, which is what a consumer needs when one node's contribution
// already accounts for its subtree.
//
// collect_idents_expr is the archetype: a nested lambda contributes its FREE
// variables, computed by subtracting the lambda's own bindings from its body's
// reads. Descending would instead append every name the body mentions,
// including the lambda's own params — the bug that made an enclosing closure
// treat them as unresolvable captures and decline the lift.
//
// The rule is a plain predicate over the node rather than a `(T, boolean)`
// return or a `Visit[T]` box because it is asked once per node on the
// compiler's hottest walk: a boxed answer would be one allocation per AST node
// visited, where a predicate is a call.
//
// The no-op statement visitor has to be spelled as an arrow lambda: a nested
// named function keeps its declared `T` verbatim when the enclosing generic is
// monomorphised, and a top-level generic one cannot be named as a value at all
// (#7040, #7042). It captures nothing, so it lifts to a plain function —
// measured identical to passing a top-level named no-op.
pub function fold_expr_pruned[T](e: ast.Expr, acc: T, visit: (ast.Expr, T) => T, descend: (ast.Expr) => boolean): T {
    return fold_expr_nodes(e, acc, (st: ast.Stmt, a: T) => a, visit, descend);
}

// fold_stmt_pruned is fold_expr_pruned's statement half. `descend` gates the
// expressions it reaches exactly as it does inside an expression tree.
pub function fold_stmt_pruned[T](st: ast.Stmt, acc: T, visit: (ast.Expr, T) => T, descend: (ast.Expr) => boolean): T {
    return fold_stmt_nodes(st, acc, (s: ast.Stmt, a: T) => a, visit, descend);
}

// fold_expr_nodes / fold_stmt_nodes are the walk itself, and the only copy of
// it. They visit BOTH node kinds: `visit_stmt` on each statement in pre-order,
// `visit_expr` on each expression. Two visitors rather than native's single
// `fn(Node) bool` (internal/ast/walk.go) because `Expr` and `Stmt` are separate
// unions here with no common supertype — wrapping them in one would cost an
// allocation per node visited.
//
// A consumer whose contribution is statement-shaped needs this pair: an
// assignment TARGET and a `var` / `for` / match-arm BINDER are names carried on
// the statement, not expressions the expression visitor can ever be handed.
pub function fold_expr_nodes[T](e: ast.Expr, acc: T, visit_stmt: (ast.Stmt, T) => T, visit_expr: (ast.Expr, T) => T, descend: (ast.Expr) => boolean): T {
    acc = visit_expr(e, acc);
    if (!descend(e)) { return acc; }
    match (e) {
        ast.ExprIdent(_) => { return acc; },
        ast.ExprNumber(_) => { return acc; },
        ast.ExprString(_) => { return acc; },
        ast.ExprBool(_) => { return acc; },
        ast.ExprBinary(b) => {
            acc = fold_expr_nodes(b.left, acc, visit_stmt, visit_expr, descend);
            return fold_expr_nodes(b.right, acc, visit_stmt, visit_expr, descend);
        },
        ast.ExprUnary(u) => { return fold_expr_nodes(u.operand, acc, visit_stmt, visit_expr, descend); },
        ast.ExprCall(c) => {
            acc = fold_expr_nodes(c.callee, acc, visit_stmt, visit_expr, descend);
            for arg in c.args {
                acc = fold_expr_nodes(arg, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.ExprArray(a) => {
            for el in a.elements {
                acc = fold_expr_nodes(el, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.ExprMapLit(ml) => {
            var i: i32 = 0;
            while (i < ml.keys.len()) {
                acc = fold_expr_nodes(ml.keys[i], acc, visit_stmt, visit_expr, descend);
                acc = fold_expr_nodes(ml.vals[i], acc, visit_stmt, visit_expr, descend);
                i = i + 1;
            }
            return acc;
        },
        ast.ExprFString(fs) => {
            var i: i32 = 0;
            while (i < fs.exprs.len()) {
                if (fs.is_expr[i]) { acc = fold_expr_nodes(fs.exprs[i], acc, visit_stmt, visit_expr, descend); }
                i = i + 1;
            }
            return acc;
        },
        ast.ExprTuple(t) => {
            for el in t.elements {
                acc = fold_expr_nodes(el, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.ExprIndex(x) => {
            acc = fold_expr_nodes(x.array, acc, visit_stmt, visit_expr, descend);
            return fold_expr_nodes(x.index, acc, visit_stmt, visit_expr, descend);
        },
        ast.ExprSlice(sl) => {
            acc = fold_expr_nodes(sl.array, acc, visit_stmt, visit_expr, descend);
            acc = fold_expr_nodes(sl.start, acc, visit_stmt, visit_expr, descend);
            return fold_expr_nodes(sl.end, acc, visit_stmt, visit_expr, descend);
        },
        ast.ExprStructLit(sl) => {
            if (sl.has_base) { acc = fold_expr_nodes(sl.base, acc, visit_stmt, visit_expr, descend); }
            for field_value in sl.field_values {
                acc = fold_expr_nodes(field_value, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.ExprFieldAccess(fa) => { return fold_expr_nodes(fa.obj, acc, visit_stmt, visit_expr, descend); },
        ast.ExprLambda(lm) => {
            for body_st in lm.body {
                acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

pub function fold_stmt_nodes[T](st: ast.Stmt, acc: T, visit_stmt: (ast.Stmt, T) => T, visit_expr: (ast.Expr, T) => T, descend: (ast.Expr) => boolean): T {
    acc = visit_stmt(st, acc);
    match (st) {
        ast.StmtDefer(d) => { return fold_stmt_nodes(d.action, acc, visit_stmt, visit_expr, descend); },
        ast.StmtVar(v) => { return fold_expr_nodes(v.init, acc, visit_stmt, visit_expr, descend); },
        ast.StmtReturn(r) => { return fold_expr_nodes(r.value, acc, visit_stmt, visit_expr, descend); },
        ast.StmtExpr(e) => { return fold_expr_nodes(e.value, acc, visit_stmt, visit_expr, descend); },
        ast.StmtIf(i) => {
            acc = fold_expr_nodes(i.cond, acc, visit_stmt, visit_expr, descend);
            for body_st in i.then_body {
                acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
            }
            for body_st in i.else_body {
                acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.StmtWhile(w) => {
            acc = fold_expr_nodes(w.cond, acc, visit_stmt, visit_expr, descend);
            for body_st in w.body {
                acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.StmtAssign(a) => { return fold_expr_nodes(a.value, acc, visit_stmt, visit_expr, descend); },
        ast.StmtMatch(m) => {
            acc = fold_expr_nodes(m.scrutinee, acc, visit_stmt, visit_expr, descend);
            for arm in m.arms {
                if (arm.has_guard) { acc = fold_expr_nodes(arm.guard, acc, visit_stmt, visit_expr, descend); }
                for body_st in arm.body {
                    acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
                }
            }
            return acc;
        },
        ast.StmtFor(f) => {
            acc = fold_expr_nodes(f.iter, acc, visit_stmt, visit_expr, descend);
            for body_st in f.body {
                acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
            }
            return acc;
        },
        ast.StmtBreak(_) => { return acc; },
        ast.StmtContinue(_) => { return acc; },
        ast.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// fold_stmt_spine folds `visit` over the statement subtree rooted at `st` — the
// statement itself and every statement its control flow encloses — entering no
// expression, so a lambda body stays out of reach.
//
// This is what a statement-shaped consumer wants: an assignment TARGET and a
// `var` / `for` / match-arm BINDER are names carried on the statement, so the
// expression half of fold_stmt_nodes contributes nothing and costs two indirect
// calls plus a match for every expression a statement owns.
//
// Every variant is spelled out rather than wildcarded: a new statement kind
// carrying a block should fail to compile here, not silently drop its body.
pub function fold_stmt_spine[T](st: ast.Stmt, acc: T, visit: (ast.Stmt, T) => T): T {
    acc = visit(st, acc);
    match (st) {
        ast.StmtDefer(d) => { return fold_stmt_spine(d.action, acc, visit); },
        ast.StmtIf(i) => {
            for body_st in i.then_body { acc = fold_stmt_spine(body_st, acc, visit); }
            for body_st in i.else_body { acc = fold_stmt_spine(body_st, acc, visit); }
            return acc;
        },
        ast.StmtWhile(w) => {
            for body_st in w.body { acc = fold_stmt_spine(body_st, acc, visit); }
            return acc;
        },
        ast.StmtFor(f) => {
            for body_st in f.body { acc = fold_stmt_spine(body_st, acc, visit); }
            return acc;
        },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                for body_st in arm.body { acc = fold_stmt_spine(body_st, acc, visit); }
            }
            return acc;
        },
        ast.StmtVar(_) => { return acc; },
        ast.StmtReturn(_) => { return acc; },
        ast.StmtExpr(_) => { return acc; },
        ast.StmtAssign(_) => { return acc; },
        ast.StmtBreak(_) => { return acc; },
        ast.StmtContinue(_) => { return acc; },
        ast.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// fold_stmt_own visits the expressions the statement ITSELF owns — a `var`'s
// initialiser, an assignment's value, a `return` / expression statement's
// value, an `if` / `while` condition, a `for`'s iterated expression, and a
// `match`'s scrutinee and arm guards — and does NOT enter the statement lists
// it encloses.
//
// fold_stmt is the whole-subtree walk; this is the one level a PER-STATEMENT
// pass wants when its driver visits the child blocks itself. interp's cellify
// pre-pass is the archetype: it runs once per statement of a block against that
// block's reassignment set, and a nested block gets its own pass with its own
// set — walking into one here would cell a loop-local `var` that has to stay
// per-iteration.
//
// A `defer`'s action is a child statement, so it contributes nothing at this
// level. Every variant is spelled out rather than wildcarded: a new statement
// kind should fail to compile here, not silently own no expressions.
pub function fold_stmt_own[T](st: ast.Stmt, acc: T, visit: (ast.Expr, T) => T): T {
    return fold_stmt_own_pruned(st, acc, visit, descend_all);
}

// fold_stmt_own_pruned is fold_stmt_own with descent control, on the same terms
// as fold_expr_pruned: `descend` decides whether a visited node's CHILDREN are
// walked, which a consumer needs when one node's contribution already accounts
// for its whole subtree.
pub function fold_stmt_own_pruned[T](st: ast.Stmt, acc: T, visit: (ast.Expr, T) => T, descend: (ast.Expr) => boolean): T {
    match (st) {
        ast.StmtVar(v) => { return fold_expr_pruned(v.init, acc, visit, descend); },
        ast.StmtAssign(a) => { return fold_expr_pruned(a.value, acc, visit, descend); },
        ast.StmtReturn(r) => { return fold_expr_pruned(r.value, acc, visit, descend); },
        ast.StmtExpr(e) => { return fold_expr_pruned(e.value, acc, visit, descend); },
        ast.StmtIf(i) => { return fold_expr_pruned(i.cond, acc, visit, descend); },
        ast.StmtWhile(w) => { return fold_expr_pruned(w.cond, acc, visit, descend); },
        ast.StmtFor(f) => { return fold_expr_pruned(f.iter, acc, visit, descend); },
        ast.StmtMatch(m) => {
            acc = fold_expr_pruned(m.scrutinee, acc, visit, descend);
            for arm in m.arms {
                if (arm.has_guard) { acc = fold_expr_pruned(arm.guard, acc, visit, descend); }
            }
            return acc;
        },
        ast.StmtDefer(_) => { return acc; },
        ast.StmtBreak(_) => { return acc; },
        ast.StmtContinue(_) => { return acc; },
        ast.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// ---- the rewriting fold -------------------------------------------------
//
// map_expr / map_stmt / map_stmts are fold_expr's rewriting twin: where the
// fold threads an accumulator out, these thread a NEW TREE out. They are the
// shared spine for the hand-written `Expr -> Expr` recursions the same way the
// fold is for the collectors, and they converge on native's
// ast.RewriteProgramExprs (internal/ast/walk.go).
//
// POST-ORDER, like native's: a node's children are rewritten first, and `visit`
// then sees the REBUILT node. A consumer that must inspect a child before it is
// rewritten needs a pre-order variant, which no consumer has needed yet.
//
// EXPRESSIONS are replaced; STATEMENTS are rebuilt but never replaced — again
// native's split. A statement's shape is decided by the parser and the desugars;
// what a rewrite pass changes is the expressions in its slots.
//
// Every node is rebuilt with a functional update (`{ ...x, field: … }`) rather
// than a field-by-field literal. That is not brevity: a field-by-field rebuild
// has to be revisited every time a node gains a field, and the hand-written
// rewriters it replaces spell out between five and nine fields each.
//
// The `sugar` fields (StmtIf.sugar, StmtMatch.sugar) are the arms as WRITTEN,
// which only the printer reads, and they are carried through unrewritten — a
// rewrite of the compile path must not rewrite the author's source shape.
pub function map_expr(e: ast.Expr, visit: (ast.Expr) => ast.Expr): ast.Expr {
    match (e) {
        ast.ExprNumber(_) => { return visit(e); },
        ast.ExprIdent(_) => { return visit(e); },
        ast.ExprString(_) => { return visit(e); },
        ast.ExprBool(_) => { return visit(e); },
        ast.ExprUnknown(_) => { return visit(e); },
        ast.ExprBinary(b) => {
            return visit(ast.ExprBinary { ...b, left: map_expr(b.left, visit), right: map_expr(b.right, visit) });
        },
        ast.ExprUnary(u) => { return visit(ast.ExprUnary { ...u, operand: map_expr(u.operand, visit) }); },
        ast.ExprCall(c) => {
            var args: ast.Expr[] = [];
            for arg in c.args { args = args.append(map_expr(arg, visit)); }
            return visit(ast.ExprCall { ...c, callee: map_expr(c.callee, visit), args: args });
        },
        ast.ExprArray(a) => {
            var els: ast.Expr[] = [];
            for el in a.elements { els = els.append(map_expr(el, visit)); }
            return visit(ast.ExprArray { ...a, elements: els });
        },
        ast.ExprTuple(t) => {
            var tel: ast.Expr[] = [];
            for el in t.elements { tel = tel.append(map_expr(el, visit)); }
            return visit(ast.ExprTuple { ...t, elements: tel });
        },
        ast.ExprIndex(ix) => {
            return visit(ast.ExprIndex { ...ix, array: map_expr(ix.array, visit), index: map_expr(ix.index, visit) });
        },
        ast.ExprSlice(sl) => {
            return visit(ast.ExprSlice { ...sl, array: map_expr(sl.array, visit), start: map_expr(sl.start, visit), end: map_expr(sl.end, visit) });
        },
        ast.ExprStructLit(st) => {
            var fv: ast.Expr[] = [];
            for field_value in st.field_values { fv = fv.append(map_expr(field_value, visit)); }
            // `base` is only a real expression when has_base; the slot is
            // otherwise whatever the parser left there.
            var nb: ast.Expr = st.base;
            if (st.has_base) { nb = map_expr(st.base, visit); }
            return visit(ast.ExprStructLit { ...st, field_values: fv, base: nb });
        },
        ast.ExprFieldAccess(fa) => { return visit(ast.ExprFieldAccess { ...fa, obj: map_expr(fa.obj, visit) }); },
        ast.ExprLambda(lm) => { return visit(ast.ExprLambda { ...lm, body: map_stmts(lm.body, visit) }); },
        ast.ExprMapLit(ml) => {
            var ks: ast.Expr[] = [];
            var vs: ast.Expr[] = [];
            for key in ml.keys { ks = ks.append(map_expr(key, visit)); }
            for val in ml.vals { vs = vs.append(map_expr(val, visit)); }
            return visit(ast.ExprMapLit { ...ml, keys: ks, vals: vs });
        },
        ast.ExprFString(fs) => {
            // The three arrays are parallel, one entry per PART: a part with
            // is_expr false is literal text and its `exprs` slot is filler, not
            // an expression to rewrite.
            var xs: ast.Expr[] = [];
            var q: i32 = 0;
            while (q < fs.exprs.len()) {
                if (fs.is_expr[q]) { xs = xs.append(map_expr(fs.exprs[q], visit)); }
                else { xs = xs.append(fs.exprs[q]); }
                q = q + 1;
            }
            return visit(ast.ExprFString { ...fs, exprs: xs });
        }
    }
    return visit(e);
}

// map_stmt rebuilds one statement with every expression it reaches rewritten,
// including the ones inside the blocks it encloses.
pub function map_stmt(st: ast.Stmt, visit: (ast.Expr) => ast.Expr): ast.Stmt {
    match (st) {
        ast.StmtVar(v) => { return ast.StmtVar { ...v, init: map_expr(v.init, visit) }; },
        ast.StmtReturn(r) => { return ast.StmtReturn { ...r, value: map_expr(r.value, visit) }; },
        ast.StmtExpr(x) => { return ast.StmtExpr { ...x, value: map_expr(x.value, visit) }; },
        ast.StmtAssign(a) => { return ast.StmtAssign { ...a, value: map_expr(a.value, visit) }; },
        ast.StmtIf(f) => {
            return ast.StmtIf { ...f, cond: map_expr(f.cond, visit), then_body: map_stmts(f.then_body, visit), else_body: map_stmts(f.else_body, visit) };
        },
        ast.StmtWhile(w) => { return ast.StmtWhile { ...w, cond: map_expr(w.cond, visit), body: map_stmts(w.body, visit) }; },
        ast.StmtFor(fo) => { return ast.StmtFor { ...fo, iter: map_expr(fo.iter, visit), body: map_stmts(fo.body, visit) }; },
        ast.StmtMatch(mt) => {
            var arms: ast.MatchArm[] = [];
            for arm in mt.arms {
                var g: ast.Expr = arm.guard;
                if (arm.has_guard) { g = map_expr(arm.guard, visit); }
                arms = arms.append(ast.MatchArm { ...arm, body: map_stmts(arm.body, visit), guard: g });
            }
            return ast.StmtMatch { ...mt, scrutinee: map_expr(mt.scrutinee, visit), arms: arms };
        },
        ast.StmtDefer(d) => { return ast.StmtDefer { ...d, action: map_stmt(d.action, visit) }; },
        ast.StmtBreak(_) => { return st; },
        ast.StmtContinue(_) => { return st; },
        ast.StmtUnknown(_) => { return st; }
    }
    return st;
}

pub function map_stmts(stmts: ast.Stmt[], visit: (ast.Expr) => ast.Expr): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    for stmt in stmts { out = out.append(map_stmt(stmt, visit)); }
    return out;
}

// ---- the accumulator-carrying rewriting fold ----------------------------
//
// map_expr_acc / map_stmt_acc / map_stmts_acc are map_expr's state-threading
// twin: the walk hands back a NEW TREE and an accumulator, for the rewrite
// passes that also build something as they go — irlower's env-box lift is the
// archetype, accumulating the hoisted `$cloN` functions and the counter that
// names them.
//
// PRE-ORDER, claim-or-descend — the opposite of map_expr's post-order, and
// deliberately: `visit` sees each node BEFORE its children are rewritten and
// answers `(node, acc, handled)`. handled=true → the visitor owns the whole
// subtree: its node and acc come back verbatim and the spine does not descend.
// One flag covers both a rewrite and a prune, because a claiming rewriter
// needs its policy helpers to receive ORIGINAL children — post-order would
// hand them already-rewritten ones and double-wrap `__mkclo$` markers.
// handled=false → the visitor's node is ignored (decline with the node
// untouched) and the spine rebuilds the children itself, threading the
// visitor's acc through them, returning handled=false.
//
// CHILD ORDER IS CONTRACT here, not an implementation detail: consumers name
// hoisted helpers `$cloN` / `$wrapN` / `$iifeN` from a counter riding the
// accumulator, so the visit order is baked into emitted symbol names and the
// fixpoint's byte-identity with them. The order is source order — a statement's
// own expressions before its child blocks (if: cond, then, else; match:
// scrutinee, then per arm the guard before the body) — with one inherited
// exception: ExprCall walks its ARGUMENTS left-to-right and THEN its callee,
// the order map_expr and every hand walk this spine absorbs already use.
// Binary is left then right, Index array then index, Slice array/start/end,
// StructLit field_values then base, MapLit key before value per entry.
//
// Statements are rebuilt, never replaced, on map_stmt's terms: a declined
// statement is rebuilt with a functional update, so line / sugar / origin ride
// through untouched, and a claiming visitor is expected to hand back the same
// statement kind it was shown.
//
// The result is a TUPLE, not a `Visit[T]` struct, and the constraint is the
// per-module self-compile, not taste: a generic struct in the signature makes
// the parser promote `T` to the monomorphiser, and the per-module emit path
// runs no monomorphiser at all — the un-cloned template reaches the unit emit
// and fails IR verify. A bare tuple keeps `T` ERASED, the same single-compile
// treatment the fold spine gets, so the spine rides every path fold does.
// Like the fold's `T`, an accumulator must be pointer-shaped or i32 — an
// erased slot cannot carry a bare wide scalar.
//
// Unlike map_expr, the expression walk carries the STATEMENT visitor too. A
// single-visitor wrapper would have to pass a generic no-op statement visitor
// along, and that value has no expressible spelling: a top-level generic
// function cannot be named as a value, and a lambda's lifted body does not
// monomorphise with the enclosing function (#7040, #7042). A consumer with
// nothing to say about statements writes the no-op itself, at its own
// concrete T.
//
// One tuple per node visited is a bounded constant factor on a walk that
// already reconstructs every node it touches, so the fold spine's
// predicate-not-box rule does not bind here — and it still binds THERE: the
// fold stays allocation-free per node, and a consumer that needs state out of
// a rewrite belongs on this spine, not on a retrofitted fold.
pub function map_expr_acc[T](e: ast.Expr, acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Expr, T, boolean) {
    var (ve, va, vh) = visit(e, acc);
    if (vh) { return (ve, va, true); }
    var a: T = va;
    match (e) {
        ast.ExprNumber(_) => { return (e, a, false); },
        ast.ExprIdent(_) => { return (e, a, false); },
        ast.ExprString(_) => { return (e, a, false); },
        ast.ExprBool(_) => { return (e, a, false); },
        ast.ExprUnknown(_) => { return (e, a, false); },
        ast.ExprBinary(b) => {
            var (le, la, lh) = map_expr_acc(b.left, a, visit_stmt, visit);
            var (re, ra, rh) = map_expr_acc(b.right, la, visit_stmt, visit);
            return (ast.ExprBinary { ...b, left: le, right: re }, ra, false);
        },
        ast.ExprUnary(u) => {
            var (oe, oa, oh) = map_expr_acc(u.operand, a, visit_stmt, visit);
            return (ast.ExprUnary { ...u, operand: oe }, oa, false);
        },
        ast.ExprCall(c) => {
            var args: ast.Expr[] = [];
            for arg in c.args {
                var (ae, aa, ah) = map_expr_acc(arg, a, visit_stmt, visit);
                a = aa;
                args = args.append(ae);
            }
            var (ce, ca, ch) = map_expr_acc(c.callee, a, visit_stmt, visit);
            return (ast.ExprCall { ...c, callee: ce, args: args }, ca, false);
        },
        ast.ExprArray(arr) => {
            var els: ast.Expr[] = [];
            for el in arr.elements {
                var (ee, ea, eh) = map_expr_acc(el, a, visit_stmt, visit);
                a = ea;
                els = els.append(ee);
            }
            return (ast.ExprArray { ...arr, elements: els }, a, false);
        },
        ast.ExprTuple(t) => {
            var tel: ast.Expr[] = [];
            for el in t.elements {
                var (ee, ea, eh) = map_expr_acc(el, a, visit_stmt, visit);
                a = ea;
                tel = tel.append(ee);
            }
            return (ast.ExprTuple { ...t, elements: tel }, a, false);
        },
        ast.ExprIndex(ix) => {
            var (xe, xa, xh) = map_expr_acc(ix.array, a, visit_stmt, visit);
            var (ie, ia, ih) = map_expr_acc(ix.index, xa, visit_stmt, visit);
            return (ast.ExprIndex { ...ix, array: xe, index: ie }, ia, false);
        },
        ast.ExprSlice(sl) => {
            var (xe, xa, xh) = map_expr_acc(sl.array, a, visit_stmt, visit);
            var (se, sa, sh) = map_expr_acc(sl.start, xa, visit_stmt, visit);
            var (ne, na, nh) = map_expr_acc(sl.end, sa, visit_stmt, visit);
            return (ast.ExprSlice { ...sl, array: xe, start: se, end: ne }, na, false);
        },
        ast.ExprStructLit(sl) => {
            var fv: ast.Expr[] = [];
            for field_value in sl.field_values {
                var (fe, fa, fh) = map_expr_acc(field_value, a, visit_stmt, visit);
                a = fa;
                fv = fv.append(fe);
            }
            // `base` is only a real expression when has_base; the slot is
            // otherwise whatever the parser left there.
            var nb: ast.Expr = sl.base;
            if (sl.has_base) {
                var (be, ba, bh) = map_expr_acc(sl.base, a, visit_stmt, visit);
                a = ba;
                nb = be;
            }
            return (ast.ExprStructLit { ...sl, field_values: fv, base: nb }, a, false);
        },
        ast.ExprFieldAccess(fa) => {
            var (oe, oa, oh) = map_expr_acc(fa.obj, a, visit_stmt, visit);
            return (ast.ExprFieldAccess { ...fa, obj: oe }, oa, false);
        },
        ast.ExprLambda(lm) => {
            var (bs, ba) = map_stmts_acc(lm.body, a, visit_stmt, visit);
            return (ast.ExprLambda { ...lm, body: bs }, ba, false);
        },
        ast.ExprMapLit(ml) => {
            var ks: ast.Expr[] = [];
            var vs: ast.Expr[] = [];
            var q: i32 = 0;
            while (q < ml.keys.len()) {
                var (ke, ka, kh) = map_expr_acc(ml.keys[q], a, visit_stmt, visit);
                var (ue, ua, uh) = map_expr_acc(ml.vals[q], ka, visit_stmt, visit);
                a = ua;
                ks = ks.append(ke);
                vs = vs.append(ue);
                q = q + 1;
            }
            return (ast.ExprMapLit { ...ml, keys: ks, vals: vs }, a, false);
        },
        ast.ExprFString(fs) => {
            // The three arrays are parallel, one entry per PART: a part with
            // is_expr false is literal text and its `exprs` slot is filler, not
            // an expression to rewrite.
            var xs: ast.Expr[] = [];
            var q: i32 = 0;
            while (q < fs.exprs.len()) {
                if (fs.is_expr[q]) {
                    var (pe, pa, ph) = map_expr_acc(fs.exprs[q], a, visit_stmt, visit);
                    a = pa;
                    xs = xs.append(pe);
                } else { xs = xs.append(fs.exprs[q]); }
                q = q + 1;
            }
            return (ast.ExprFString { ...fs, exprs: xs }, a, false);
        }
    }
    return (e, a, false);
}

pub function map_stmt_acc[T](st: ast.Stmt, acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Stmt, T, boolean) {
    var (vs, va, vh) = visit_stmt(st, acc);
    if (vh) { return (vs, va, true); }
    var a: T = va;
    match (st) {
        ast.StmtVar(v) => {
            var (ie, ia, ih) = map_expr_acc(v.init, a, visit_stmt, visit);
            return (ast.StmtVar { ...v, init: ie }, ia, false);
        },
        ast.StmtReturn(rt) => {
            var (ve, vla, vlh) = map_expr_acc(rt.value, a, visit_stmt, visit);
            return (ast.StmtReturn { ...rt, value: ve }, vla, false);
        },
        ast.StmtExpr(x) => {
            var (ve, vla, vlh) = map_expr_acc(x.value, a, visit_stmt, visit);
            return (ast.StmtExpr { ...x, value: ve }, vla, false);
        },
        ast.StmtAssign(asg) => {
            var (ve, vla, vlh) = map_expr_acc(asg.value, a, visit_stmt, visit);
            return (ast.StmtAssign { ...asg, value: ve }, vla, false);
        },
        ast.StmtIf(f) => {
            var (ce, ca, ch) = map_expr_acc(f.cond, a, visit_stmt, visit);
            var (tb, ta) = map_stmts_acc(f.then_body, ca, visit_stmt, visit);
            var (eb, ea) = map_stmts_acc(f.else_body, ta, visit_stmt, visit);
            return (ast.StmtIf { ...f, cond: ce, then_body: tb, else_body: eb }, ea, false);
        },
        ast.StmtWhile(w) => {
            var (ce, ca, ch) = map_expr_acc(w.cond, a, visit_stmt, visit);
            var (wb, wa) = map_stmts_acc(w.body, ca, visit_stmt, visit);
            return (ast.StmtWhile { ...w, cond: ce, body: wb }, wa, false);
        },
        ast.StmtFor(fo) => {
            var (ie, ia, ih) = map_expr_acc(fo.iter, a, visit_stmt, visit);
            var (fb, fba) = map_stmts_acc(fo.body, ia, visit_stmt, visit);
            return (ast.StmtFor { ...fo, iter: ie, body: fb }, fba, false);
        },
        ast.StmtMatch(mt) => {
            var (se, sa, sh) = map_expr_acc(mt.scrutinee, a, visit_stmt, visit);
            a = sa;
            var arms: ast.MatchArm[] = [];
            for arm in mt.arms {
                var g: ast.Expr = arm.guard;
                if (arm.has_guard) {
                    var (ge, ga, gh) = map_expr_acc(arm.guard, a, visit_stmt, visit);
                    a = ga;
                    g = ge;
                }
                var (ab, aa) = map_stmts_acc(arm.body, a, visit_stmt, visit);
                a = aa;
                arms = arms.append(ast.MatchArm { ...arm, body: ab, guard: g });
            }
            return (ast.StmtMatch { ...mt, scrutinee: se, arms: arms }, a, false);
        },
        ast.StmtDefer(d) => {
            var (de, da, dh) = map_stmt_acc(d.action, a, visit_stmt, visit);
            return (ast.StmtDefer { ...d, action: de }, da, false);
        },
        ast.StmtBreak(_) => { return (st, a, false); },
        ast.StmtContinue(_) => { return (st, a, false); },
        ast.StmtUnknown(_) => { return (st, a, false); }
    }
    return (st, a, false);
}

pub function map_stmts_acc[T](stmts: ast.Stmt[], acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Stmt[], T) {
    var out: ast.Stmt[] = [];
    for stmt in stmts {
        var (ns, na, nh) = map_stmt_acc(stmt, acc, visit_stmt, visit);
        acc = na;
        out = out.append(ns);
    }
    return (out, acc);
}

// splice_stmts is the REMOVING sibling of map_stmts. map_stmt rewrites
// expressions and can only replace a statement with exactly one statement;
// `visit` here returns a LIST, so a pass can drop a statement (return []),
// keep it (return [st]) or expand it. `-O`'s assert elision is the first
// consumer and needs the dropping direction.
//
// Two passes, because statements live in two places. map_stmts reaches the
// ones inside EXPRESSIONS — a lambda body, including one nested in a call
// argument or a match-arm guard — and splices each lambda's own tree as it
// goes; splice_own then walks the statement tree proper. Each statement is
// visited exactly once: map_expr is bottom-up, so an inner lambda is spliced
// before the outer one, and splice_own never re-enters an expression.
pub function splice_stmts(stmts: ast.Stmt[], visit: (ast.Stmt) => ast.Stmt[]): ast.Stmt[] {
    var mapped: ast.Stmt[] = map_stmts(stmts, function(x: ast.Expr): ast.Expr {
        match (x) {
            ast.ExprLambda(lm) => { return ast.ExprLambda { ...lm, body: splice_own(lm.body, visit) }; },
            _ => { return x; }
        }
        return x;
    });
    return splice_own(mapped, visit);
}

// splice_own applies `visit` down one statement tree, post-order. It does NOT
// descend into expressions: splice_stmts' map pass has already spliced every
// lambda body, and descending again would splice a nested one twice.
function splice_own(stmts: ast.Stmt[], visit: (ast.Stmt) => ast.Stmt[]): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    for stmt in stmts {
        var repl: ast.Stmt[] = visit(splice_own_children(stmt, visit));
        for r in repl { out = out.append(r); }
    }
    return out;
}

// splice_own_children rebuilds one statement with each statement list it
// encloses spliced. It does not visit `st` itself; that is splice_own's job,
// so children are spliced before their parent is judged.
function splice_own_children(st: ast.Stmt, visit: (ast.Stmt) => ast.Stmt[]): ast.Stmt {
    match (st) {
        ast.StmtIf(f) => {
            return ast.StmtIf { ...f, then_body: splice_own(f.then_body, visit), else_body: splice_own(f.else_body, visit) };
        },
        ast.StmtWhile(w) => { return ast.StmtWhile { ...w, body: splice_own(w.body, visit) }; },
        ast.StmtFor(fo) => { return ast.StmtFor { ...fo, body: splice_own(fo.body, visit) }; },
        ast.StmtMatch(mt) => {
            var arms: ast.MatchArm[] = [];
            for arm in mt.arms {
                arms = arms.append(ast.MatchArm { ...arm, body: splice_own(arm.body, visit) });
            }
            return ast.StmtMatch { ...mt, arms: arms };
        },
        ast.StmtDefer(d) => { return ast.StmtDefer { ...d, action: splice_own_children(d.action, visit) }; },
        _ => { return st; }
    }
    return st;
}

// ident_of contributes one node's identifier READS. It is the whole of
// collect_idents_expr that is not the walk.
function ident_of(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprIdent(id) => { return acc.append(id.name); },
        ast.ExprLambda(lm) => {
            // A nested lambda reads, from the ENCLOSING scope, only its FREE
            // variables — its own params and locally-bound names are bound WITHIN
            // it, not read from outside. Collect the inner body's idents, subtract
            // the inner lambda's params + locals, and append the remainder.
            // Without this an inner lambda's params (e.g. the `y` of
            // `function(y){…}`) leak as spurious references of the outer scope,
            // which makes the enclosing lambda's capture analysis treat `y` as an
            // unresolvable capture and decline the lift (nested closures bail).
            //
            // This is why the walk is `not_lambda`-pruned: the subtraction is the
            // node's whole contribution, and descending would re-add the very
            // names it removed.
            var inner_used: string[] = [];
            for body_st in lm.body { inner_used = collect_idents_stmt(body_st, inner_used); }
            var inner_bound: string[] = [];
            for p in lm.params { inner_bound = inner_bound.append(p.name); }
            for body_st in lm.body { inner_bound = collect_bound_stmt(body_st, inner_bound); }
            for nm in inner_used {
                if (util.index_of_str(inner_bound, nm) < 0) { acc = acc.append(nm); }
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// not_lambda stops the walk at a lambda: ident_of has already accounted for its
// whole body.
function not_lambda(e: ast.Expr): boolean {
    match (e) {
        ast.ExprLambda(_) => { return false; },
        _ => { return true; }
    }
    return true;
}

// collect_idents_expr appends every identifier READ in `e` to `acc`
// (with duplicates; consumers dedup when building capture lists).
pub function collect_idents_expr(e: ast.Expr, acc: string[]): string[] {
    return fold_expr_pruned(e, acc, ident_of, not_lambda);
}

// subst_ident_expr returns `e` with every identifier READ named `from`
// rewritten to `to`. Used to rewrite an `@`-binding reference (`n`) to the
// cached scrutinee local in a match-arm guard, where the whole-value binding
// isn't yet in scope.
//
// It walks over map_expr, so the rename reaches every node rather than the
// eight this used to spell out. The five it missed were not exotic: a guard
// mentioning `n` inside a struct literal, a slice, a map literal, an f-string
// or a lambda kept the original name, and lowering then failed to resolve it
// (`FERN_STRICT_IR: function value n not defined`) on a program native
// compiles and runs.
pub function subst_ident_expr(e: ast.Expr, from: string, to: string): ast.Expr {
    // Nested so the rename pair rides the closure rather than an extra
    // parameter on every recursive call — the same spelling the fold's
    // consumers use.
    function subst_one(x: ast.Expr): ast.Expr {
        match (x) {
            ast.ExprIdent(id) => {
                if (id.name == from) { return ast.ExprIdent { ...id, name: to }; }
                return x;
            },
            _ => { return x; }
        }
        return x;
    }
    return map_expr(e, subst_one);
}

// assign_target_of contributes what a statement reads that is not an
// expression, which is one name: an assignment's TARGET. A lambda that WRITES
// a captured outer scalar without ever reading it (`x = 42`) still captures
// `x`, so the free-variable collector has to see write-only targets (#2850 /
// SH-057). The target is always a bare name — index and field assigns desugar
// to __set_index / __set_field calls carried in `value`. Duplicates are fine;
// capture lists dedup.
function assign_target_of(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtAssign(a) => { return acc.append(a.target); },
        _ => { return acc; }
    }
    return acc;
}

// collect_idents_stmt appends every identifier READ in `st` to `acc`, with
// duplicates. `not_lambda` stops the walk at a lambda because ident_of has
// already accounted for its whole body; a `when` guard is walked like an arm
// body, since a name read only there is still a name the closure must capture.
pub function collect_idents_stmt(st: ast.Stmt, acc: string[]): string[] {
    return fold_stmt_nodes(st, acc, assign_target_of, ident_of, not_lambda);
}

// append_bound_name appends a binder name, splitting the comma-joined form the
// multi-name binders use — a tuple destructure `var (a, b) = t` ("a,b", #5173)
// and a two-binding `for (k, v) in m` ("k,v"). Unsplit, neither name is
// recognised as an enclosing local, so a lambda reading one reads as
// capture-free: it takes the no-capture `$wrapN` lift and resolves the name
// against the module instead of capturing it.
function append_bound_name(acc: string[], name: string): string[] {
    var has_comma: boolean = false;
    for ch in name { if (ch == b',') { has_comma = true; } }
    if (!has_comma) { return acc.append(name); }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= name.len()) {
        if (i == name.len() || name[i] == b',') {
            var piece: string = slice_unchecked(name, start, i) + "";
            if (piece.len() > 0) { acc = acc.append(piece); }
            start = i + 1;
        }
        i = i + 1;
    }
    return acc;
}

// CallSite is one call located at the call, with `method` saying which kind of
// callee it had: false for a bare identifier, true for a field access
// (`x.write(…)`). Both are recorded, and the flag matters — the target
// boundary (platforms.fern) gates BUILTINS, which are free functions, so it
// reads only the bare-identifier half, while the package boundary (caps.fern)
// follows the method half as a call-graph edge.
pub struct CallSite { name: string, line: i32, col: i32, method: boolean }

// call_site_of records the call `e` makes if its callee is NAMED in `want` —
// the callee's own name for a bare identifier, the field name for a method
// call. It is one node's contribution; fold_expr / fold_stmt supply the walk.
//
// The filter is not a convenience: the only callers look for a handful of names
// across the whole bundle, and collecting every call first would allocate one
// CallSite per call site in the program — on the compiler's own sources that is
// the kind of pass that walks a self-compile into the arena wall. Matching
// during the walk keeps the allocation proportional to the hits, which is
// normally none.
//
// Unlike collect_idents_expr this sees INTO a lambda body rather than
// subtracting its bindings: a lambda's calls are part of what the artifact
// executes, which is the question here, where free-variable analysis asks what
// the enclosing scope must capture.
function call_site_of(e: ast.Expr, want: string[], acc: CallSite[]): CallSite[] {
    match (e) {
        ast.ExprCall(c) => {
            match (c.callee) {
                ast.ExprIdent(id) => {
                    if (util.has_str(want, id.name)) { return acc.append(CallSite { name: id.name, line: c.line, col: c.col, method: false }); }
                    return acc;
                },
                ast.ExprFieldAccess(fa) => {
                    if (util.has_str(want, fa.field)) { return acc.append(CallSite { name: fa.field, line: c.line, col: c.col, method: true }); }
                    return acc;
                },
                _ => { return acc; }
            }
        },
        _ => { return acc; }
    }
    return acc;
}

// collect_calls_stmt appends every wanted call reachable from `st` to `acc`.
pub function collect_calls_stmt(st: ast.Stmt, want: string[], acc: CallSite[]): CallSite[] {
    function visit(e: ast.Expr, a: CallSite[]): CallSite[] { return call_site_of(e, want, a); }
    return fold_stmt(st, acc, visit);
}

// pattern_binders appends every name a match-arm pattern binds: the payload
// slot, each further slot of a multi-payload variant (`Tag(a, b)`), and the
// `@` whole-value binder of `n @ Tag(x)`. `nested` is a parse-time transient —
// desugar_nested_arms flattens sub-patterns before any consumer sees one — but
// it is recursed anyway so a pattern that does reach here cannot hide a binder.
//
// This is the same set irlower's sa_pat_binds enumerates, which is the point:
// two answers to "what does this pattern bind" is how at_binding came to be
// missing from one of them (#6993).
function pattern_binders(p: ast.Pattern, acc: string[]): string[] {
    match (p) {
        ast.PatVariant(pv) => {
            if (pv.binding.len() > 0) { acc = acc.append(pv.binding); }
            if (pv.at_binding.len() > 0) { acc = acc.append(pv.at_binding); }
            for eb in pv.extra_bindings {
                if (eb.len() > 0) { acc = acc.append(eb); }
            }
            for sub in pv.nested {
                acc = pattern_binders(sub, acc);
            }
            return acc;
        },
        ast.PatWildcard(_) => { return acc; }
    }
    return acc;
}

// binders_of contributes the names one statement BINDS: a `var`, a `for`'s
// loop variable, and the patterns of a `match`'s arms. Every one of them is
// carried on the statement node, which is why this walk needs a statement
// visitor and cannot be written over fold_stmt alone.
function binders_of(st: ast.Stmt, acc: string[]): string[] {
    match (st) {
        ast.StmtVar(v) => { return append_bound_name(acc, v.name); },
        ast.StmtFor(f) => { return append_bound_name(acc, f.var_name); },
        ast.StmtMatch(m) => {
            for arm in m.arms {
                acc = pattern_binders(arm.pattern, acc);
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// collect_bound_stmt appends every name `st` binds in the scope it belongs to.
// Consumers subtract it from collect_idents_stmt's reads to get free variables,
// so a name missing here is read as a capture of an enclosing local that does
// not exist.
pub function collect_bound_stmt(st: ast.Stmt, acc: string[]): string[] {
    return fold_stmt_spine(st, acc, binders_of);
}

// collect_bound_stmts is collect_bound_stmt over a body. Callers that want a
// whole function's binders — the over-approximating "bound anywhere in this
// body, so a bare reference to it is local throughout" set that shadowing
// means for bare names — want this one.
pub function collect_bound_stmts(stmts: ast.Stmt[], acc: string[]): string[] {
    for stmt in stmts {
        acc = collect_bound_stmt(stmt, acc);
    }
    return acc;
}

// --- qualified module references (#6714) ----------------------------------
//
// QualRef is one `<qual>.<name>` reference: a MODULE-qualified use, written as
// such in source. It exists because the distinction is only available BEFORE
// flatten — bundling rewrites `bigint.__bi_make` and a bare same-module
// `__bi_make` into the identical ident `bigint____bi_make`, so a rule that
// needs to tell a cross-module reference from an internal one cannot run on
// the bundle. The visibility check learned that the expensive way.
pub struct QualRef { qual: string, name: string, line: i32, col: i32 }

// qualref_of records the module-qualified reference `e` makes, if any: a field
// access whose object is an ident naming a module in scope. `mod.f(…)`'s callee
// and a bare `mod.CONST` are the same node, so they are one case.
//
// The reference is located at the field access, which the parser positions at
// the dot — matching native, whose rewriter reports this against `fa.P` and not
// against the enclosing call.
function qualref_of(e: ast.Expr, quals: string[], acc: QualRef[]): QualRef[] {
    match (e) {
        ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
                ast.ExprIdent(id) => {
                    if (util.has_str(quals, id.name)) {
                        return acc.append(QualRef { qual: id.name, name: fa.field, line: fa.line, col: fa.col });
                    }
                },
                _ => {}
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// collect_qualrefs_expr appends every `<q>.<name>` in `e` whose qualifier `q`
// is in `quals` (the module names in scope for the file being walked).
pub function collect_qualrefs_expr(e: ast.Expr, quals: string[], acc: QualRef[]): QualRef[] {
    function visit(n: ast.Expr, a: QualRef[]): QualRef[] { return qualref_of(n, quals, a); }
    return fold_expr(e, acc, visit);
}

// collect_qualrefs_stmt is collect_qualrefs_expr's statement half.
pub function collect_qualrefs_stmt(st: ast.Stmt, quals: string[], acc: QualRef[]): QualRef[] {
    function visit(n: ast.Expr, a: QualRef[]): QualRef[] { return qualref_of(n, quals, a); }
    return fold_stmt(st, acc, visit);
}
