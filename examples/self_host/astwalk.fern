import "./parser";
import "./util";

// astwalk — shared AST traversals for the self-hosted compiler.
// First home (SH-022): the free-variable collectors used by every
// backend's closure/capture analysis. asmcore / ssa / vm carried
// byte-identical copies of these; they now live here once. (wasm's
// stmt collector has a different shape + coverage and is NOT folded
// in yet — see the SH-022 appendix.) Imports only parser, so any
// frontend module can depend on it.

// collect_idents_expr appends every identifier READ in `e` to `acc`
// (with duplicates; consumers dedup when building capture lists).
pub function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.append(id.name); },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = collect_idents_expr(b.left, acc);
            return collect_idents_expr(b.right, acc);
        },
        parser.ExprUnary(u) => { return collect_idents_expr(u.operand, acc); },
        parser.ExprCall(c) => {
            acc = collect_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) {
                acc = collect_idents_expr(c.args[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = collect_idents_expr(a.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                acc = collect_idents_expr(t.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = collect_idents_expr(x.array, acc);
            return collect_idents_expr(x.index, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_idents_expr(sl.array, acc);
            acc = collect_idents_expr(sl.start, acc);
            return collect_idents_expr(sl.end, acc);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { acc = collect_idents_expr(sl.base, acc); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                acc = collect_idents_expr(sl.field_values[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return collect_idents_expr(fa.obj, acc); },
        parser.ExprLambda(lm) => {
            // A nested lambda reads, from the ENCLOSING scope, only its FREE
            // variables — its own params and locally-bound names are bound WITHIN
            // it, not read from outside. Collect the inner body's idents, subtract
            // the inner lambda's params + locals, and append the remainder.
            // Without this an inner lambda's params (e.g. the `y` of
            // `function(y){…}`) leak as spurious references of the outer scope,
            // which makes the enclosing lambda's capture analysis treat `y` as an
            // unresolvable capture and decline the lift (nested closures bail).
            var inner_used: string[] = [];
            var iu: i32 = 0;
            while (iu < lm.body.len()) { inner_used = collect_idents_stmt(lm.body[iu], inner_used); iu = iu + 1; }
            var inner_bound: string[] = [];
            var ip: i32 = 0;
            while (ip < lm.params.len()) { inner_bound = inner_bound.append(lm.params[ip].name); ip = ip + 1; }
            var ib: i32 = 0;
            while (ib < lm.body.len()) { inner_bound = collect_bound_stmt(lm.body[ib], inner_bound); ib = ib + 1; }
            var ik: i32 = 0;
            while (ik < inner_used.len()) {
                if (util.index_of_str(inner_bound, inner_used[ik]) < 0) { acc = acc.append(inner_used[ik]); }
                ik = ik + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

// subst_ident_expr returns `e` with every identifier READ named `from`
// rewritten to `to`. Used to rewrite an `@`-binding reference (`n`) to the
// cached scrutinee local in a match-arm guard, where the whole-value binding
// isn't yet in scope. Structural mirror of collect_idents_expr; unhandled
// leaves pass through unchanged.
pub function subst_ident_expr(e: parser.Expr, from: string, to: string): parser.Expr {
    match (e) {
        parser.ExprIdent(id) => {
            if (id.name == from) { return parser.ExprIdent { name: to, line: id.line, col: id.col }; }
            return e;
        },
        parser.ExprBinary(b) => {
            return parser.ExprBinary { op: b.op, left: subst_ident_expr(b.left, from, to), right: subst_ident_expr(b.right, from, to), line: b.line, col: b.col };
        },
        parser.ExprUnary(u) => {
            return parser.ExprUnary { op: u.op, operand: subst_ident_expr(u.operand, from, to), line: u.line, col: u.col };
        },
        parser.ExprCall(c) => {
            var nargs: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { nargs = nargs.append(subst_ident_expr(c.args[i], from, to)); i = i + 1; }
            return parser.ExprCall { callee: subst_ident_expr(c.callee, from, to), args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
        },
        parser.ExprFieldAccess(fa) => {
            return parser.ExprFieldAccess { obj: subst_ident_expr(fa.obj, from, to), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
        },
        parser.ExprIndex(x) => {
            return parser.ExprIndex { array: subst_ident_expr(x.array, from, to), index: subst_ident_expr(x.index, from, to), unchecked: x.unchecked, ty: x.ty };
        },
        parser.ExprArray(a) => {
            var na: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { na = na.append(subst_ident_expr(a.elements[i], from, to)); i = i + 1; }
            return parser.ExprArray { elements: na };
        },
        parser.ExprTuple(t) => {
            var nt: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { nt = nt.append(subst_ident_expr(t.elements[i], from, to)); i = i + 1; }
            return parser.ExprTuple { elements: nt, line: t.line, col: t.col };
        },
        _ => { return e; }
    }
    return e;
}

pub function collect_idents_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        // StmtDefer is eliminated before emit (lower_defers); the arm is here
        // for exhaustiveness and recurses defensively on the lowered form.
        parser.StmtDefer(d) => { return collect_idents_stmt(d.action, acc); },
        parser.StmtVar(v) => { return collect_idents_expr(v.init, acc); },
        parser.StmtReturn(r) => { return collect_idents_expr(r.value, acc); },
        parser.StmtExpr(e) => { return collect_idents_expr(e.value, acc); },
        parser.StmtIf(i) => {
            acc = collect_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_idents_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_idents_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_idents_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => {
            // Collect the value's reads AND the assign target: a lambda that
            // WRITES a captured outer scalar without reading it (`x = 42`) still
            // captures `x`, so the free-var collector must see write-only targets
            // (#2850 / SH-057). `wasm`'s collector already did this. The target is
            // a bare name (index / field assigns desugar to __set_index /
            // __set_field calls carried in `value`). Duplicates are fine — capture
            // lists dedup.
            acc = collect_idents_expr(a.value, acc);
            return acc.append(a.target);
        },
        parser.StmtMatch(m) => {
            acc = collect_idents_expr(m.scrutinee, acc);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                // A `when` guard reads identifiers too (e.g. an enclosing local
                // used only in the guard). Missing it left such a name out of
                // the closure's capture list, so the guard read garbage at
                // runtime → segfault. Walk the guard like the body.
                if (m.arms[ai].has_guard) { acc = collect_idents_expr(m.arms[ai].guard, acc); }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_idents_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_idents_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// append_bound_name appends a binder name, splitting the comma-joined form the
// multi-name binders use — a tuple destructure `var (a, b) = t` ("a,b", #5173)
// and a two-binding `for (k, v) in m` ("k,v"). Unsplit, neither name is
// recognised as an enclosing local, so a lambda reading one reads as
// capture-free: it takes the no-capture `$wrapN` lift and resolves the name
// against the module instead of capturing it.
function append_bound_name(acc: string[], name: string): string[] {
    var has_comma: boolean = false;
    var ci: i32 = 0;
    while (ci < name.len()) { if (name[ci] == 44) { has_comma = true; } ci = ci + 1; }
    if (!has_comma) { return acc.append(name); }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= name.len()) {
        if (i == name.len() || name[i] == 44) {
            var piece: string = name[start : i] + "";
            if (piece.len() > 0) { acc = acc.append(piece); }
            start = i + 1;
        }
        i = i + 1;
    }
    return acc;
}

// CallSite is one call located at the call, with `method` saying which kind of
// callee it had: false for a bare identifier, true for a field access
// (`x.write(…)`). Both are recorded, and the flag matters — the target
// boundary (platforms.fern) gates BUILTINS, which are free functions, so it
// reads only the bare-identifier half, while the package boundary (caps.fern)
// follows the method half as a call-graph edge.
pub struct CallSite { name: string, line: i32, col: i32, method: boolean }

// collect_calls_expr appends every call in `e` whose callee is NAMED in `want`
// to `acc` — the callee's own name for a bare identifier, the field name for a
// method call.
//
// The filter is not a convenience: the only caller looks for a handful of
// names across the whole bundle, and collecting every call first would
// allocate one CallSite per call site in the program — on the compiler's own
// sources that is the kind of pass that walks a self-compile into the arena
// wall. Matching during the walk keeps the allocation proportional to the
// hits, which is normally none.
//
// Unlike collect_idents_expr this descends INTO a lambda body rather than
// subtracting its bindings: a lambda's calls are part of what the artifact
// executes, which is the question here, where free-variable analysis asks
// what the enclosing scope must capture.
pub function collect_calls_expr(e: parser.Expr, want: string[], acc: CallSite[]): CallSite[] {
    match (e) {
        parser.ExprIdent(_) => { return acc; },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = collect_calls_expr(b.left, want, acc);
            return collect_calls_expr(b.right, want, acc);
        },
        parser.ExprUnary(u) => { return collect_calls_expr(u.operand, want, acc); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (util.has_str(want, id.name)) { acc = acc.append(CallSite { name: id.name, line: c.line, col: c.col, method: false }); }
                },
                parser.ExprFieldAccess(fa) => {
                    if (util.has_str(want, fa.field)) { acc = acc.append(CallSite { name: fa.field, line: c.line, col: c.col, method: true }); }
                    acc = collect_calls_expr(fa.obj, want, acc);
                },
                _ => { acc = collect_calls_expr(c.callee, want, acc); }
            }
            var i: i32 = 0;
            while (i < c.args.len()) {
                acc = collect_calls_expr(c.args[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = collect_calls_expr(a.elements[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                acc = collect_calls_expr(t.elements[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = collect_calls_expr(x.array, want, acc);
            return collect_calls_expr(x.index, want, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_calls_expr(sl.array, want, acc);
            acc = collect_calls_expr(sl.start, want, acc);
            return collect_calls_expr(sl.end, want, acc);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { acc = collect_calls_expr(sl.base, want, acc); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                acc = collect_calls_expr(sl.field_values[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return collect_calls_expr(fa.obj, want, acc); },
        parser.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                acc = collect_calls_stmt(lm.body[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

// collect_calls_stmt is collect_calls_expr's statement half.
pub function collect_calls_stmt(st: parser.Stmt, want: string[], acc: CallSite[]): CallSite[] {
    match (st) {
        parser.StmtDefer(d) => { return collect_calls_stmt(d.action, want, acc); },
        parser.StmtVar(v) => { return collect_calls_expr(v.init, want, acc); },
        parser.StmtReturn(r) => { return collect_calls_expr(r.value, want, acc); },
        parser.StmtExpr(e) => { return collect_calls_expr(e.value, want, acc); },
        parser.StmtIf(i) => {
            acc = collect_calls_expr(i.cond, want, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_calls_stmt(i.then_body[ti], want, acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_calls_stmt(i.else_body[ei], want, acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_calls_expr(w.cond, want, acc);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_calls_stmt(w.body[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => { return collect_calls_expr(a.value, want, acc); },
        parser.StmtMatch(m) => {
            acc = collect_calls_expr(m.scrutinee, want, acc);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                if (m.arms[ai].has_guard) { acc = collect_calls_expr(m.arms[ai].guard, want, acc); }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_calls_stmt(m.arms[ai].body[bi], want, acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_calls_expr(f.iter, want, acc);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_calls_stmt(f.body[i], want, acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

pub function collect_bound_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtDefer(d) => { return collect_bound_stmt(d.action, acc); },
        parser.StmtVar(v) => { return append_bound_name(acc, v.name); },
        parser.StmtReturn(_) => { return acc; },
        parser.StmtExpr(_) => { return acc; },
        parser.StmtIf(i) => {
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_bound_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_bound_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_bound_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(_) => { return acc; },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0) { acc = acc.append(pv.binding); }
                        // Multi-payload variants (`Tag(a, b)`) bind every extra
                        // payload too — collecting only the main binding left an
                        // extra binding invisible as an enclosing local, so a
                        // lambda capturing it (lambda_captures' encl gate)
                        // declined the lift and the module fell to the
                        // miscompiling AST path (#5155).
                        var ebi: i32 = 0;
                        while (ebi < pv.extra_bindings.len()) {
                            // Bind the element to a typed local before .len() /
                            // .append — a direct `pv.extra_bindings[ebi].len()`
                            // mis-dispatched the string element as i32 (an
                            // undefined `__fn_i32__len` at single-module link),
                            // the idiom irlower.fern uses for the same field.
                            var ebn: string = pv.extra_bindings[ebi];
                            if (ebn.len() > 0) { acc = acc.append(ebn); }
                            ebi = ebi + 1;
                        }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_bound_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = append_bound_name(acc, f.var_name);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_bound_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}
