import "./parser";
import "./util";

// astwalk — shared AST traversals for the self-hosted compiler.
// First home (SH-022): the free-variable collectors used by every
// backend's closure/capture analysis. asmcore / ssa / vm carried
// byte-identical copies of these; they now live here once. (wasm's
// stmt collector has a different shape + coverage and is NOT folded
// in yet — see the SH-022 appendix.) Imports only parser, so any
// frontend module can depend on it.

// fold_expr threads `acc` through every expression reachable from `e`, calling
// `visit` on each node in pre-order before descending into its children. It is
// the shared spine the hand-written per-consumer traversals collapse onto: a
// consumer writes only what one node contributes and inherits the recursion, so
// a new parser node is covered everywhere the moment it is covered here (#6993).
//
// `visit` reaches it as a nested named function closing over whatever context
// the consumer needs — see collect_qualrefs_expr. An arrow lambda works too
// since #6996; the named form is kept because it reads better at the call site.
pub function fold_expr[T](e: parser.Expr, acc: T, visit: (parser.Expr, T) => T): T {
    return fold_expr_pruned(e, acc, visit, descend_all);
}

// fold_stmt is fold_expr's statement half: it visits every EXPRESSION `st`
// reaches, in source order. Statement nodes themselves are not visited — a
// consumer that needs those inspects the statement before handing its
// expressions here.
pub function fold_stmt[T](st: parser.Stmt, acc: T, visit: (parser.Expr, T) => T): T {
    return fold_stmt_pruned(st, acc, visit, descend_all);
}

// descend_all is the unpruned walk's descent rule: every node's children are
// reachable.
function descend_all(e: parser.Expr): boolean { return true; }

// fold_expr_pruned is fold_expr with descent control. `visit` still sees every
// node the walk reaches; `descend` then decides whether that node's CHILDREN
// are walked, which is what a consumer needs when one node's contribution
// already accounts for its subtree.
//
// collect_idents_expr is the archetype: a nested lambda contributes its FREE
// variables, computed by subtracting the lambda's own bindings from its body's
// reads. Descending would instead append every name the body mentions,
// including the lambda's own params — the bug that made an enclosing closure
// treat them as unresolvable captures and decline the lift.
//
// The rule is a plain predicate over the node rather than a `(T, boolean)`
// return or a `Visit[T]` box because it is asked once per node on the
// compiler's hottest walk: a boxed answer would be one allocation per AST node
// visited, where a predicate is a call.
pub function fold_expr_pruned[T](e: parser.Expr, acc: T, visit: (parser.Expr, T) => T, descend: (parser.Expr) => boolean): T {
    acc = visit(e, acc);
    if (!descend(e)) { return acc; }
    match (e) {
        parser.ExprIdent(_) => { return acc; },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = fold_expr_pruned(b.left, acc, visit, descend);
            return fold_expr_pruned(b.right, acc, visit, descend);
        },
        parser.ExprUnary(u) => { return fold_expr_pruned(u.operand, acc, visit, descend); },
        parser.ExprCall(c) => {
            acc = fold_expr_pruned(c.callee, acc, visit, descend);
            var i: i32 = 0;
            while (i < c.args.len()) {
                acc = fold_expr_pruned(c.args[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = fold_expr_pruned(a.elements[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprMapLit(ml) => {
            var i: i32 = 0;
            while (i < ml.keys.len()) {
                acc = fold_expr_pruned(ml.keys[i], acc, visit, descend);
                acc = fold_expr_pruned(ml.vals[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFString(fs) => {
            var i: i32 = 0;
            while (i < fs.exprs.len()) {
                if (fs.is_expr[i]) { acc = fold_expr_pruned(fs.exprs[i], acc, visit, descend); }
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                acc = fold_expr_pruned(t.elements[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = fold_expr_pruned(x.array, acc, visit, descend);
            return fold_expr_pruned(x.index, acc, visit, descend);
        },
        parser.ExprSlice(sl) => {
            acc = fold_expr_pruned(sl.array, acc, visit, descend);
            acc = fold_expr_pruned(sl.start, acc, visit, descend);
            return fold_expr_pruned(sl.end, acc, visit, descend);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { acc = fold_expr_pruned(sl.base, acc, visit, descend); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                acc = fold_expr_pruned(sl.field_values[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return fold_expr_pruned(fa.obj, acc, visit, descend); },
        parser.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                acc = fold_stmt_pruned(lm.body[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

// fold_stmt_pruned is fold_expr_pruned's statement half. `descend` gates the
// expressions it reaches exactly as it does inside an expression tree.
pub function fold_stmt_pruned[T](st: parser.Stmt, acc: T, visit: (parser.Expr, T) => T, descend: (parser.Expr) => boolean): T {
    match (st) {
        parser.StmtDefer(d) => { return fold_stmt_pruned(d.action, acc, visit, descend); },
        parser.StmtVar(v) => { return fold_expr_pruned(v.init, acc, visit, descend); },
        parser.StmtReturn(r) => { return fold_expr_pruned(r.value, acc, visit, descend); },
        parser.StmtExpr(e) => { return fold_expr_pruned(e.value, acc, visit, descend); },
        parser.StmtIf(i) => {
            acc = fold_expr_pruned(i.cond, acc, visit, descend);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = fold_stmt_pruned(i.then_body[ti], acc, visit, descend);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = fold_stmt_pruned(i.else_body[ei], acc, visit, descend);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = fold_expr_pruned(w.cond, acc, visit, descend);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = fold_stmt_pruned(w.body[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => { return fold_expr_pruned(a.value, acc, visit, descend); },
        parser.StmtMatch(m) => {
            acc = fold_expr_pruned(m.scrutinee, acc, visit, descend);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                if (m.arms[ai].has_guard) { acc = fold_expr_pruned(m.arms[ai].guard, acc, visit, descend); }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = fold_stmt_pruned(m.arms[ai].body[bi], acc, visit, descend);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = fold_expr_pruned(f.iter, acc, visit, descend);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = fold_stmt_pruned(f.body[i], acc, visit, descend);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// ident_of contributes one node's identifier READS. It is the whole of
// collect_idents_expr that is not the walk.
function ident_of(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.append(id.name); },
        parser.ExprLambda(lm) => {
            // A nested lambda reads, from the ENCLOSING scope, only its FREE
            // variables — its own params and locally-bound names are bound WITHIN
            // it, not read from outside. Collect the inner body's idents, subtract
            // the inner lambda's params + locals, and append the remainder.
            // Without this an inner lambda's params (e.g. the `y` of
            // `function(y){…}`) leak as spurious references of the outer scope,
            // which makes the enclosing lambda's capture analysis treat `y` as an
            // unresolvable capture and decline the lift (nested closures bail).
            //
            // This is why the walk is `not_lambda`-pruned: the subtraction is the
            // node's whole contribution, and descending would re-add the very
            // names it removed.
            var inner_used: string[] = [];
            var iu: i32 = 0;
            while (iu < lm.body.len()) { inner_used = collect_idents_stmt(lm.body[iu], inner_used); iu = iu + 1; }
            var inner_bound: string[] = [];
            var ip: i32 = 0;
            while (ip < lm.params.len()) { inner_bound = inner_bound.append(lm.params[ip].name); ip = ip + 1; }
            var ib: i32 = 0;
            while (ib < lm.body.len()) { inner_bound = collect_bound_stmt(lm.body[ib], inner_bound); ib = ib + 1; }
            var ik: i32 = 0;
            while (ik < inner_used.len()) {
                if (util.index_of_str(inner_bound, inner_used[ik]) < 0) { acc = acc.append(inner_used[ik]); }
                ik = ik + 1;
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// not_lambda stops the walk at a lambda: ident_of has already accounted for its
// whole body.
function not_lambda(e: parser.Expr): boolean {
    match (e) {
        parser.ExprLambda(_) => { return false; },
        _ => { return true; }
    }
    return true;
}

// collect_idents_expr appends every identifier READ in `e` to `acc`
// (with duplicates; consumers dedup when building capture lists).
pub function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    return fold_expr_pruned(e, acc, ident_of, not_lambda);
}

// subst_ident_expr returns `e` with every identifier READ named `from`
// rewritten to `to`. Used to rewrite an `@`-binding reference (`n`) to the
// cached scrutinee local in a match-arm guard, where the whole-value binding
// isn't yet in scope. Structural mirror of collect_idents_expr; unhandled
// leaves pass through unchanged.
pub function subst_ident_expr(e: parser.Expr, from: string, to: string): parser.Expr {
    match (e) {
        parser.ExprIdent(id) => {
            if (id.name == from) { return parser.ExprIdent { name: to, line: id.line, col: id.col }; }
            return e;
        },
        parser.ExprBinary(b) => {
            return parser.ExprBinary { op: b.op, left: subst_ident_expr(b.left, from, to), right: subst_ident_expr(b.right, from, to), line: b.line, col: b.col };
        },
        parser.ExprUnary(u) => {
            return parser.ExprUnary { op: u.op, operand: subst_ident_expr(u.operand, from, to), line: u.line, col: u.col };
        },
        parser.ExprCall(c) => {
            var nargs: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { nargs = nargs.append(subst_ident_expr(c.args[i], from, to)); i = i + 1; }
            return parser.ExprCall { callee: subst_ident_expr(c.callee, from, to), args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: c.ty };
        },
        parser.ExprFieldAccess(fa) => {
            return parser.ExprFieldAccess { obj: subst_ident_expr(fa.obj, from, to), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
        },
        parser.ExprIndex(x) => {
            return parser.ExprIndex { array: subst_ident_expr(x.array, from, to), index: subst_ident_expr(x.index, from, to), unchecked: x.unchecked, ty: x.ty };
        },
        parser.ExprArray(a) => {
            var na: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { na = na.append(subst_ident_expr(a.elements[i], from, to)); i = i + 1; }
            return parser.ExprArray { elements: na };
        },
        parser.ExprTuple(t) => {
            var nt: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { nt = nt.append(subst_ident_expr(t.elements[i], from, to)); i = i + 1; }
            return parser.ExprTuple { elements: nt, line: t.line, col: t.col };
        },
        _ => { return e; }
    }
    return e;
}

pub function collect_idents_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        // StmtDefer is eliminated before emit (lower_defers); the arm is here
        // for exhaustiveness and recurses defensively on the lowered form.
        parser.StmtDefer(d) => { return collect_idents_stmt(d.action, acc); },
        parser.StmtVar(v) => { return collect_idents_expr(v.init, acc); },
        parser.StmtReturn(r) => { return collect_idents_expr(r.value, acc); },
        parser.StmtExpr(e) => { return collect_idents_expr(e.value, acc); },
        parser.StmtIf(i) => {
            acc = collect_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_idents_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_idents_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_idents_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => {
            // Collect the value's reads AND the assign target: a lambda that
            // WRITES a captured outer scalar without reading it (`x = 42`) still
            // captures `x`, so the free-var collector must see write-only targets
            // (#2850 / SH-057). `wasm`'s collector already did this. The target is
            // a bare name (index / field assigns desugar to __set_index /
            // __set_field calls carried in `value`). Duplicates are fine — capture
            // lists dedup.
            acc = collect_idents_expr(a.value, acc);
            return acc.append(a.target);
        },
        parser.StmtMatch(m) => {
            acc = collect_idents_expr(m.scrutinee, acc);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                // A `when` guard reads identifiers too (e.g. an enclosing local
                // used only in the guard). Missing it left such a name out of
                // the closure's capture list, so the guard read garbage at
                // runtime → segfault. Walk the guard like the body.
                if (m.arms[ai].has_guard) { acc = collect_idents_expr(m.arms[ai].guard, acc); }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_idents_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_idents_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// append_bound_name appends a binder name, splitting the comma-joined form the
// multi-name binders use — a tuple destructure `var (a, b) = t` ("a,b", #5173)
// and a two-binding `for (k, v) in m` ("k,v"). Unsplit, neither name is
// recognised as an enclosing local, so a lambda reading one reads as
// capture-free: it takes the no-capture `$wrapN` lift and resolves the name
// against the module instead of capturing it.
function append_bound_name(acc: string[], name: string): string[] {
    var has_comma: boolean = false;
    var ci: i32 = 0;
    while (ci < name.len()) { if (name[ci] == 44) { has_comma = true; } ci = ci + 1; }
    if (!has_comma) { return acc.append(name); }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= name.len()) {
        if (i == name.len() || name[i] == 44) {
            var piece: string = name[start : i] + "";
            if (piece.len() > 0) { acc = acc.append(piece); }
            start = i + 1;
        }
        i = i + 1;
    }
    return acc;
}

// CallSite is one call located at the call, with `method` saying which kind of
// callee it had: false for a bare identifier, true for a field access
// (`x.write(…)`). Both are recorded, and the flag matters — the target
// boundary (platforms.fern) gates BUILTINS, which are free functions, so it
// reads only the bare-identifier half, while the package boundary (caps.fern)
// follows the method half as a call-graph edge.
pub struct CallSite { name: string, line: i32, col: i32, method: boolean }

// call_site_of records the call `e` makes if its callee is NAMED in `want` —
// the callee's own name for a bare identifier, the field name for a method
// call. It is one node's contribution; fold_expr / fold_stmt supply the walk.
//
// The filter is not a convenience: the only callers look for a handful of names
// across the whole bundle, and collecting every call first would allocate one
// CallSite per call site in the program — on the compiler's own sources that is
// the kind of pass that walks a self-compile into the arena wall. Matching
// during the walk keeps the allocation proportional to the hits, which is
// normally none.
//
// Unlike collect_idents_expr this sees INTO a lambda body rather than
// subtracting its bindings: a lambda's calls are part of what the artifact
// executes, which is the question here, where free-variable analysis asks what
// the enclosing scope must capture.
function call_site_of(e: parser.Expr, want: string[], acc: CallSite[]): CallSite[] {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (util.has_str(want, id.name)) { return acc.append(CallSite { name: id.name, line: c.line, col: c.col, method: false }); }
                    return acc;
                },
                parser.ExprFieldAccess(fa) => {
                    if (util.has_str(want, fa.field)) { return acc.append(CallSite { name: fa.field, line: c.line, col: c.col, method: true }); }
                    return acc;
                },
                _ => { return acc; }
            }
        },
        _ => { return acc; }
    }
    return acc;
}

// collect_calls_stmt appends every wanted call reachable from `st` to `acc`.
pub function collect_calls_stmt(st: parser.Stmt, want: string[], acc: CallSite[]): CallSite[] {
    function visit(e: parser.Expr, a: CallSite[]): CallSite[] { return call_site_of(e, want, a); }
    return fold_stmt(st, acc, visit);
}

pub function collect_bound_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtDefer(d) => { return collect_bound_stmt(d.action, acc); },
        parser.StmtVar(v) => { return append_bound_name(acc, v.name); },
        parser.StmtReturn(_) => { return acc; },
        parser.StmtExpr(_) => { return acc; },
        parser.StmtIf(i) => {
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_bound_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_bound_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_bound_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(_) => { return acc; },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0) { acc = acc.append(pv.binding); }
                        // Multi-payload variants (`Tag(a, b)`) bind every extra
                        // payload too — collecting only the main binding left an
                        // extra binding invisible as an enclosing local, so a
                        // lambda capturing it (lambda_captures' encl gate)
                        // declined the lift and the module fell to the
                        // miscompiling AST path (#5155).
                        var ebi: i32 = 0;
                        while (ebi < pv.extra_bindings.len()) {
                            // Bind the element to a typed local before .len() /
                            // .append — a direct `pv.extra_bindings[ebi].len()`
                            // mis-dispatched the string element as i32 (an
                            // undefined `__fn_i32__len` at single-module link),
                            // the idiom irlower.fern uses for the same field.
                            var ebn: string = pv.extra_bindings[ebi];
                            if (ebn.len() > 0) { acc = acc.append(ebn); }
                            ebi = ebi + 1;
                        }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_bound_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = append_bound_name(acc, f.var_name);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_bound_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// --- qualified module references (#6714) ----------------------------------
//
// QualRef is one `<qual>.<name>` reference: a MODULE-qualified use, written as
// such in source. It exists because the distinction is only available BEFORE
// flatten — bundling rewrites `bigint.__bi_make` and a bare same-module
// `__bi_make` into the identical ident `bigint____bi_make`, so a rule that
// needs to tell a cross-module reference from an internal one cannot run on
// the bundle. The visibility check learned that the expensive way.
pub struct QualRef { qual: string, name: string, line: i32, col: i32 }

// qualref_of records the module-qualified reference `e` makes, if any: a field
// access whose object is an ident naming a module in scope. `mod.f(…)`'s callee
// and a bare `mod.CONST` are the same node, so they are one case.
//
// The reference is located at the field access, which the parser positions at
// the dot — matching native, whose rewriter reports this against `fa.P` and not
// against the enclosing call.
function qualref_of(e: parser.Expr, quals: string[], acc: QualRef[]): QualRef[] {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            match (fa.obj) {
                parser.ExprIdent(id) => {
                    if (util.has_str(quals, id.name)) {
                        return acc.append(QualRef { qual: id.name, name: fa.field, line: fa.line, col: fa.col });
                    }
                },
                _ => {}
            }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// collect_qualrefs_expr appends every `<q>.<name>` in `e` whose qualifier `q`
// is in `quals` (the module names in scope for the file being walked).
pub function collect_qualrefs_expr(e: parser.Expr, quals: string[], acc: QualRef[]): QualRef[] {
    function visit(n: parser.Expr, a: QualRef[]): QualRef[] { return qualref_of(n, quals, a); }
    return fold_expr(e, acc, visit);
}

// collect_qualrefs_stmt is collect_qualrefs_expr's statement half.
pub function collect_qualrefs_stmt(st: parser.Stmt, quals: string[], acc: QualRef[]): QualRef[] {
    function visit(n: parser.Expr, a: QualRef[]): QualRef[] { return qualref_of(n, quals, a); }
    return fold_stmt(st, acc, visit);
}
