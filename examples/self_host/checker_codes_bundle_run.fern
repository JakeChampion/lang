// examples/self_host/checker_codes_bundle_run.fern — bundle-driven
// counterpart of checker_codes_run.fern. Where that driver checks a
// single self-contained module fed on stdin, this one reads a *bundle*
// of modules (the `///MODULE <name>` format that bundle_run.fern
// consumes), merges them into one resolved module via flatten.bundle
// (the self-host's modload equivalent — it mangles each import's
// non-receiver decls and rewrites cross-module `mod.X` references,
// while keeping receiver methods bare so `.method()` dispatch survives),
// then runs the self-hosted type checker over the merged module and
// prints the diagnostic CODE of every diagnostic, one per line.
//
// This lets the Go-vs-self-host differential gate
// (self_host_checker_codes_test.go) reach diagnostics that depend on the
// METHOD / TYPE table built from imported stdlib modules — e.g. the
// validity of a string method like `.contains()` (a user-defined method
// in std/string, not a builtin) — which the single-module driver can't
// see because it never resolves imports.
//
// Input format is identical to bundle_run.fern: modules concatenated,
// each introduced by a `///MODULE <name>` marker line, the LAST module
// the entry and the rest its importable modules (their `<name>` is what
// the entry's `import "./<name>"` resolves to). Exits 1 when any
// diagnostic was emitted, 0 otherwise.

import "std/io";
import "./lexer";
import "./parser";
import "./flatten";
import "./checker";

// MARKER is the module-introducer prefix: `///MODULE `. (Mirrors
// bundle_run.fern; kept local so this driver stands alone.)
function is_marker(line: string): boolean {
    var p: string = "///MODULE ";
    if (line.len() < p.len()) { return false; }
    var i: i32 = 0;
    while (i < p.len()) {
        if (line[i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

function marker_name(line: string): string {
    var name: string = line[10:line.len()];
    var n: i32 = name.len();
    if (n > 0 && name[n - 1] == 13) { return name[0:n - 1]; }
    return name;
}

struct Sections { names: string[], sources: string[] }

function split_modules(blob: string): Sections {
    var names: string[] = [];
    var sources: string[] = [];
    var n: i32 = blob.len();
    var i: i32 = 0;
    var line_start: i32 = 0;
    var cur_name: string = "";
    var src_start: i32 = 0;
    var have: boolean = false;
    while (i <= n) {
        if (i == n || blob[i] == 10) {
            var line: string = blob[line_start:i];
            if (is_marker(line)) {
                if (have) {
                    names = names.append(cur_name);
                    sources = sources.append(blob[src_start:line_start]);
                }
                cur_name = marker_name(line);
                src_start = i + 1;
                have = true;
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    if (have) {
        names = names.append(cur_name);
        sources = sources.append(blob[src_start:n]);
    }
    return Sections { names: names, sources: sources };
}

function main(): i32 {
    var blob: string = io.read_all_stdin();
    var secs: Sections = split_modules(blob);
    var count: i32 = secs.names.len();
    if (count == 0) { return 1; }

    var loaded: flatten.LoadedModule[] = [];
    var i: i32 = 0;
    while (i < count - 1) {
        var m: parser.Module = parser.parse_module(lexer.tokenize(secs.sources[i]));
        loaded = loaded.append(flatten.LoadedModule { name: secs.names[i], mod: m });
        i = i + 1;
    }
    var entry: parser.Module = parser.parse_module(lexer.tokenize(secs.sources[count - 1]));
    var merged: parser.Module = flatten.bundle(entry, loaded);

    var mt: checker.ModuleTypes = checker.check_module(merged);
    var j: i32 = 0;
    while (j < mt.diags.len()) {
        print(mt.diags[j].code);
        j = j + 1;
    }
    if (mt.diags.len() > 0) { return 1; }
    return 0;
}
