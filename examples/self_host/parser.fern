                    // The rest of the enclosing block is the success arm, so
                    // the bindings stay live for it — see the note on the
                    // single-binding path below.
                    var lsp_rest: Stmt[] = [];
                    while (p.peek_punct() != "}" && !p.at_end()) {
                        var (lsp_rs, lsp_rp) = parse_stmt(p);
                        if (lsp_rp.pos == p.pos) { p = p.advance(); continue; }
                        p = lsp_rp;
                        lsp_rest = lsp_rest.append(lsp_rs);
                    }
                    var lsp_arms: MatchArm[] = [];
                    var lsp_i: i32 = 0;
                    while (lsp_i < lsp_pats.len()) {
                        var (fl_pat, fl_g, fl_hg) = fold_lit_cond(lsp_pats[lsp_i], e_bool(true), false);
                        lsp_arms = lsp_arms.append(MatchArm { pattern: fl_pat, body: lsp_rest, line: vline, col: vcol, guard: fl_g, has_guard: fl_hg });
                        lsp_i = lsp_i + 1;
                    }
                    lsp_arms = lsp_arms.append(MatchArm { pattern: p_wildcard(), body: lsp_else, line: vline, col: vcol, guard: e_bool(true), has_guard: false });
                    lsp_arms = desugar_nested_arms(lsp_arms, 0, "");
                    return (s_match_origin(lsp_init, lsp_arms, vline, vcol, "let_else"), p);
