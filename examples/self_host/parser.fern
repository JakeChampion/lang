        // lambda's return type, so stamp it rather than leaving irt_guess to
        // reconstruct it from the body. Inference can only answer for the
        // expression forms it has arms for; a builtin-method body
        // (`m.get_or(k, 0.0)`) is unanswerable there without absorbing the whole
        // builtin surface. The annotation outranks the inference.
        init_expr = stamp_lambda_ret(init_expr, v_fn_ret);
        init_expr = stamp_value_block_ret(init_expr, type_name);
        return (StmtVar { name: name, type_name: type_name, init: init_expr, line: vline, col: vcol, is_str: v_is_str }, p);
    }
    if (kw == "return") {
        var rline: i32 = p.peek_line();
        var rcol: i32 = p.peek_col();
        p = p.advance();
        var (val_expr, val_p) = parse_expr(p);
        p = val_p;
