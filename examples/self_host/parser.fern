// examples/self_host/parser.fern — recursive-descent parser
// layered on the Fern-port lexer (`./lexer`). Together they form
// the second concrete step of the self-host port (after the
// standalone lexer in `lexer.fern`). Now that cross-module
// qualified variant patterns work (`lexer.TokIdent(x) => …`),
// the parser imports the lexer rather than inlining a copy.
//
// Scope:
//   - Expressions with precedence: + - * / % comparisons
//     equality && || (mirrors Go parser's precedence climbing)
//   - Numbers (with float / integer / suffix distinction
//     surfaced on the AST node)
//   - Identifier expressions + function calls `f(a, b)`
//   - Parenthesised grouping
//   - Statements: `var x = expr;`, `return expr;`, expression
//     stmts
//
// Out of scope (Go parser covers them; follow-up port):
//   - Types / type annotations
//   - Struct / enum / union decls
//   - `if` / `while` / `for` / `match` / `defer` / `arena`
//   - String / f-string handling (lexer recognises them; parser
//     stub treats them as opaque ExprUnknown)
//   - Receivers, type-params, `pub`, `import`

import "./util";
import "./lexer";

// =================== PARSER ====================

// Expression nodes. Recursive via the union — `ExprBinary` holds
// two Expr children, `ExprCall` holds a list of args, etc. The Go
// parser produces a denser typed AST (NumberLit / FloatLit /
// Ident / Binary / Call); this port collapses similar shapes into
// fewer variants to keep the union member count tractable.

// `raw` is the source spelling of a quoted literal — `'x'` (a `char`,
// suffix "char") or `b'x'` (a `u8`, suffix "u8"). The lexer decodes the
// scalar into `text` as a decimal numeral, so every consumer of a
// suffixed integer literal reads them unchanged and only the printer
// needs the spelling back. Empty for an ordinary number.
pub struct ExprNumber { text: string, suffix: string, raw: string, is_float: boolean, line: i32, col: i32 }
pub struct ExprIdent { name: string, line: i32, col: i32 }
pub struct ExprString { value: string, line: i32, col: i32 }
pub struct ExprBool { value: boolean }
pub struct ExprBinary { op: string, left: Expr, right: Expr, line: i32, col: i32 }
pub struct ExprUnary { op: string, operand: Expr, line: i32, col: i32 }
// type_argc is the number of explicit call-site type arguments (`f[i32](x)`
// has 1). The arguments themselves are erased — only the count is kept, so the
// checker can flag a generic-call type-argument arity mismatch (E040). 0 means
// no `[...]` was written.
// `ty` is the resolved result-type tag (typed-IR migration, #5531): the annotate
// pass (annotate.fern) stamps it post-constfold with the checker's inferred type
// in irlower's tag vocabulary ("f64" for a float value, etc.), and lowering READS
// it instead of re-deriving the call's type structurally. "" = unannotated (the
// asm_ir_run harness and native cmd/fern don't run annotate), in which case
// lowering falls back to its structural walk — so the field is byte-identity-safe.
pub struct ExprCall { callee: Expr, args: Expr[], line: i32, col: i32, type_argc: i32, ty: string }
// Array literal `[e1, e2, e3]`. Empty literal `[]` is allowed —
// the checker rejects an empty literal in inference contexts
// because it can't infer the element type.
pub struct ExprArray { elements: Expr[] }
// ExprLambda is a function-valued expression: `function (a: T,
// b: T): U { body }` — same shape as FuncDecl minus the name.
// Capture semantics happen at the runtime layer; the parser
// just builds the AST node.
pub struct ExprLambda { params: ParamDecl[], ret_type: string, body: Stmt[], use_infer: boolean }
// ExprTuple holds a parenthesised comma-separated list:
// `(a, b, c)`. Distinct from arrays because tuple shape is
// fixed-arity / heterogeneous; arrays are homogeneous and
// dynamic. Field access in Fern uses `.0`, `.1`, etc. but
// that's a later milestone — this slice only adds parsing.
pub struct ExprTuple { elements: Expr[], line: i32, col: i32 }
// Postfix indexing `a[i]`. `a` can be any Expr that evaluates to
// an array; `i` must type-check to i32. Out-of-range access at
// runtime surfaces as VErr from the interp.
// `unchecked` is #4380 lever 3: set by elide_len_bounded_body on a READ
// `arr[i]` proven in-bounds by an enclosing `while (i < arr.len())` guard,
// so irlower emits op_arr_get_nc (no per-iteration bounds check + len
// reload). Defaults false; index WRITES are __set_index calls, never
// ExprIndex, so only reads are ever marked.
// `ty` is the typed-IR carrier (#5531's third): the checker's inferred type
// for the ELEMENT this read yields, stamped by checker.annotate_module and
// spelled in irlower's canonical tag vocabulary. Empty when unannotated (the
// asm_ir_run harness and the native compiler never run annotate) or when the
// checker could not resolve it, in which case irlower's structural walk
// answers unchanged.
pub struct ExprIndex { array: Expr, index: Expr, unchecked: boolean, ty: string }
// Postfix slicing `a[start:end]`. Returns a subview of the same
// kind as `a` (subarray for TypeArray, substring for
// TypeString). `start` is inclusive, `end` is exclusive — same
// shape as Python / Go / Rust slicing.
// `ty` is the typed-IR carrier naming the SOURCE array's type — "f64[]" /
// "i64[]" / … — because the fact irlower's arr_slice needs is the source
// element width, which is what its structural walk (expr_is_f64arr /
// expr_is_i64arr on slc.array) also asks. Stamped by checker.annotate_module
// via type_to_arrtag. Empty when unannotated (the
// asm_ir_run harness and the native compiler never run annotate) or when the
// checker could not name the element type, in which case irlower's structural
// walk answers unchanged. NOTE it carries through the monomorphisation
// rebuilds: dropping it there miscompiles clones (#6181).
pub struct ExprSlice { array: Expr, start: Expr, end: Expr, ty: string }
// Struct literal `Name { field: value, field: value }`. The
// type_name is the struct's declared name; field_names and
// field_values parallel-array the initializers in source
// order. Empty struct lit `Name { }` is allowed (zero fields).
//
// Struct-update `Name { ...base, field: value }`: a leading
// `...base` spread copies the un-overridden fields from `base`,
// the listed fields override. `has_base` flags the presence of a
// base; when false, `base` holds a placeholder ExprUnknown
// sentinel (Expr is a no-null union, so we carry the flag rather
// than sniff the sentinel). With a base, a subset of fields is
// legal — the checker relaxes completeness. See
// docs/IMMUTABILITY-MIGRATION-PLAN.md.
pub struct ExprStructLit { type_name: string, field_names: string[], field_values: Expr[], has_base: boolean, base: Expr, line: i32, col: i32 }
// Postfix field access `obj.field`. obj can be any Expr that
// evaluates to a struct value. `ty` is the typed-IR carrier
// (#5986, the ExprCall.ty sibling from #5531): checker's
// annotate_module stamps the field read's inferred type tag so
// irlower reads it instead of re-deriving the receiver's struct
// type structurally. "" when unannotated.
pub struct ExprFieldAccess { obj: Expr, field: string, line: i32, col: i32, ty: string }
// ExprUnknown is the parser's rejection channel: there is no error list, so a
// construct the parser refuses becomes this node, which every consumer reports
// (interp: a VErr; asmcore: P001/P002; checker: an unknown type). `kind` names
// the reason and `line`/`col` locate it (0 when the producer has no position).
pub struct ExprUnknown { kind: string, line: i32, col: i32 }
// ExprMapLit is a `Map { k0: v0, … }` literal as WRITTEN, and reaches only the
// printer: parse_map_lit desugars every other parse to the
// `map_new[_i32](8).insert(k0, v0)…` chain the compile path is written against,
// and `-fmt` (Par.verbatim) takes this instead. Printing the chain back is not a
// style choice — the chain states no K/V, so a `var m: Map[string, i32] = Map {}`
// came back as `map_new(8)` and stopped compiling (E043).
pub struct ExprMapLit { keys: Expr[], vals: Expr[], line: i32, col: i32 }

// ExprFString is an f-string `f"a {x} b"` as WRITTEN, and like ExprMapLit reaches
// only the printer: every other parse desugars it into the `+`-chain of
// `.to_string()` calls the compile path is written against, and printing that
// chain back replaces the author's interpolation with its expansion. The three
// arrays are parallel, one entry per part: `is_expr[i]` says whether the part is
// an interpolant in `exprs[i]` or literal text in `lits[i]`. An interpolant is
// held PARSED, not as source text, because the printer re-emits it through
// print_expr — which is what native does, so the two agree on its spelling.
pub struct ExprFString { lits: string[], exprs: Expr[], is_expr: boolean[], line: i32, col: i32 }

pub type Expr = ExprNumber | ExprIdent | ExprString | ExprBool
              | ExprBinary | ExprUnary | ExprCall
              | ExprArray | ExprTuple | ExprIndex | ExprSlice
              | ExprStructLit | ExprFieldAccess | ExprLambda
              | ExprMapLit | ExprFString | ExprUnknown;

// Statement nodes.

// StmtVar binds a name to an init value. `type_name` is the
// optional `: Type` annotation (bare type name; empty string
// means no annotation). The checker uses it to override the
// inferred init type — so a `var sh: Shape = Circle { … }`
// binds `sh` as TypeUnion("Shape") rather than the inferred
// TypeStruct("Circle"). Interp / VM ignore it (annotations
// are checker-only metadata).
pub struct StmtVar { name: string, type_name: string, init: Expr, line: i32, col: i32, is_str: boolean }
pub struct StmtReturn { value: Expr, line: i32, col: i32 }
pub struct StmtExpr { value: Expr, line: i32 }
// StmtIf models `if (cond) { then... } else { else... }`. else_body
// is empty (`[]`) when the source omits the `else` branch; the
// checker / interp branch on `len(else_body) == 0` rather than a
// separate `has_else` flag.
// `else_chained` records that the source wrote `else if`, not `else { if … }`.
// Both parse to a one-element else_body holding a StmtIf, so only this bit
// distinguishes them, and only the PRINTER reads it: reprinting one as the
// other rewrites the user's source, and the block form additionally scopes
// anything declared before the inner `if` (#6779).
// MatchSugar is the written form of a match whose scrutinee is a TUPLE, a
// STRUCT, or a non-enum value, carried on the `if` that build_tuple_match /
// build_struct_match / build_literal_match desugar it to. All three replace
// the match outright — the first two with a done-flag chain, the third with an
// if/else-if chain — and leave no StmtMatch behind, so without this the printer
// had only the chain to render: `-fmt -w` wrote `var __sm4_5_d = false; …`
// (#7065) or the bare `if (n == 0) … else …` (#7072) over the user's match.
// Read by the printer only; the walk and every lowering pass ignore it. Empty
// (all three arm lists empty) on every other StmtIf, which is all of them.
pub struct MatchSugar { scrut: Expr, tup: TupArm[], strct: StructArm[], lits: LitArm[], line: i32, col: i32 }
// origin records the source form a synthesised `if (true) { … }` stands in for,
// so `-fmt` reprints what was written rather than the lowering: "block" for a
// bare `{ … }` statement (the Stmt union has no block node), "chain_assign" for
// `a = b = c` (one assignment per target), "" for every `if` the programmer
// actually spelled. Read by the printer only.
pub struct StmtIf { cond: Expr, then_body: Stmt[], else_body: Stmt[], line: i32, else_chained: boolean, sugar: MatchSugar, origin: string }
// StmtWhile models `while (cond) { body... }`. The body executes
// repeatedly as long as cond evaluates to a true VBool; an
// in-body `return` short-circuits the loop the same way it
// short-circuits an if-branch.
pub struct StmtWhile { cond: Expr, body: Stmt[], label: string, line: i32, is_loop: boolean }
// StmtAssign models a re-assignment to an existing var: `x = expr;`.
// The target is an ident name — full lvalue syntax (field /
// index / tuple) is a later port milestone. The checker verifies
// the target is already bound and that types match; the interp
// updates the env's slot in place.
pub struct StmtAssign { target: string, value: Expr, line: i32, col: i32, target_line: i32, target_col: i32 }
// StmtMatch models `match (scrutinee) { Pat => { ... }, ... }`.
// Arms are walked top-to-bottom; the first pattern that matches
// runs its body. The checker enforces that the pattern variant
// (e.g. `Circle(c)`) refers to a known struct that's a variant
// of the scrutinee's union type. Wildcards (`_`) act as the
// default catch-all. The body is a stmt list, mirroring
// StmtIf / StmtWhile; expression-position match lives in a
// later slice (ExprMatch).
// binding is the first payload binding (or "" / "_"); extra_bindings holds any
// further bindings written in `Variant(a, b, …)`. The self-host's variants are
// single-payload, so a multi-binding pattern is a payload-arity error (E015) —
// extra_bindings lets the checker count them; codegen still uses `binding`.
// `nested`, when non-empty (a single element), holds a sub-pattern for the
// payload position — `Some(Ok(n))` parses `Some` with nested = [Ok(n)]. The
// parser desugars a nested arm into a flat outer arm whose body re-matches the
// payload on an inner `match` (desugar_nested_arms), so the checker / codegen
// only ever see flat arms; empty (the common case) means a plain binder.
// `field_names`, when non-empty, marks a RECORD-form pattern — `Rect { h, w }`
// binds by field name in any order — and holds the FIELDS as written, with the
// bindings holding the locals each was bound to (they differ only under the
// `f: local` renaming form). It is a transient parse artefact:
// resolve_variant_fields_module rewrites a settled pattern into the equivalent
// positional one (bindings in declaration order) and clears it, so the checker
// and codegen only ever see positional patterns. A pattern that still carries
// names after that pass named a field the variant does not have, named one
// twice, missed one, or renamed one — all E015 at the checker.
// lit_cond is the condition a literal payload slot implies: `Sm(0)` binds the
// slot to a synthetic name and tests it, so the pattern carries
// `__pl<line>_<col> == 0` and has_lit_cond is set. The PARSER folds it into
// the guard of whichever arm the pattern becomes — the outer arm for a direct
// slot, the inner match's arm for a nested one — and clears it. Nothing
// downstream should ever see it set; the checker refuses one that survives,
// so a fold site nobody added cannot quietly go back to matching every value.
// tup_kinds / tup_binds / tup_lits / tup_pats carry a TUPLE sub-pattern sitting
// in payload slot 0 (`Pr((a, b))`), in parse_tuple_arm_pattern's encoding.
// Pattern cannot express a tuple, so the data rides here and build_merged_arm
// turns it into a build_tuple_match inner match rather than the variant one.
// Empty tup_kinds means no tuple sub-pattern.
pub struct PatVariant { type_name: string, binding: string, extra_bindings: string[], nested: Pattern[], at_binding: string, field_names: string[], lit_cond: Expr, has_lit_cond: boolean, tup_kinds: i32[], tup_binds: string[], tup_lits: Expr[], tup_pats: Pattern[] }
pub struct PatWildcard { tag: i32 }
pub type Pattern = PatVariant | PatWildcard;
// guard is an optional `if <expr>` between the pattern and `=>`; has_guard
// distinguishes a real guard from the placeholder. When present the arm matches
// only if the guard evaluates true (E027 checks it is boolean).
pub struct MatchArm { pattern: Pattern, body: Stmt[], line: i32, col: i32, guard: Expr, has_guard: boolean }
// `origin` records whether this match was written directly (""), or
// synthesised by the parser from an `if let` (`"if_let"`) / `let … else`
// (`"let_else"`) desugar. Codegen ignores it (a desugared match compiles
// exactly like a hand-written one — keeping the fixpoint byte-identical),
// but the checker reads it to apply the dedicated `if-let`/`let-else`
// diagnostics (E022/E023) the Go checker emits, instead of the generic
// match-arm diagnostics (E035) the desugared shape would otherwise draw.
// sugar is the arms as the PROGRAMMER wrote them, kept when a pattern carried
// something the lowering consumes — a nested payload (`Some(Ok(n))`) or a
// literal payload (`Sm(0)`, folded into the arm's guard). Read by the PRINTER
// only, so `-fmt` reprints the pattern the source spelled instead of the merged
// arm and its `__nest` temp, or the `V(__pl…) when __pl… == 0` the fold leaves.
// Empty on every ordinary match, where the lowered arms ARE the written ones.
pub struct StmtMatch { scrutinee: Expr, arms: MatchArm[], line: i32, col: i32, origin: string, sugar: MatchArm[] }
// StmtFor models `for VAR in EXPR { body }`. The iter expr
// evaluates to an array (interp) / TypeArray (checker); the
// loop binds `var_name` to each element in turn. break /
// continue inside the body aren't modeled yet — a future
// slice can add them as StmtBreak / StmtContinue.
pub struct StmtFor { var_name: string, iter: Expr, body: Stmt[], label: string, line: i32 }
// StmtBreak / StmtContinue model `break;` and `continue;`. The
// tag fields are placeholder payload — variants need a shape
// in the union and these stmts have no other state. The
// surrounding while / for body handles the actual control
// transfer.
pub struct StmtBreak { tag: i32, line: i32, col: i32, label: string }
pub struct StmtContinue { tag: i32, line: i32, col: i32, label: string }
pub struct StmtUnknown { kind: string }

// StmtDefer holds an action statement to run when the scope that executed it
// finishes: the enclosing loop iteration for a defer in a loop body, else the
// enclosing function (LIFO, every return path + falloff). It exists only
// between the parser and the lower_defers pass (module_with_builtins) — that pass
// eliminates every StmtDefer before any backend emits, so the emitters
// never lower one at runtime (their arms are there for exhaustiveness).
//
// `on_error` is 1 for an `errdefer` — cleanup that runs only on an error
// exit (a `return` of a None/Err value), not on success or falloff. 0 for
// a plain `defer`. lower_defers schedules the two kinds at the right exits.
pub struct StmtDefer { action: Stmt, on_error: i32, line: i32 }

pub type Stmt = StmtVar | StmtReturn | StmtExpr | StmtIf | StmtWhile
              | StmtAssign | StmtMatch | StmtFor
              | StmtBreak | StmtContinue | StmtUnknown | StmtDefer;

// Top-level function decl: `function name(p1: T1, p2: T2): RT { body }`.
// type names are captured as bare strings — full type-syntax
// parsing (arrays / generics / unions) is a later milestone.
// fn_param_dyn: for a `fn`-typed param whose OWN parameter list contains
// `dyn Trait` positions (`f: (dyn Speak) => i32`), a comma-separated list of the
// dyn parameter indices ("0", "0,2"), else "". The flat "fn" type tag discards
// the fn's per-parameter types, so this sidecar preserves which of a fn-value's
// arguments must be dyn-boxed at an indirect call `f(7)` — without it a primitive
// literal there is passed unboxed and op_dyn_dispatch reads it as a shape pointer
// (SIGSEGV, #5276). Populated by peek_fn_param_dyn in parse_param.
// fn_param_types: the same sidecar one level up — for a `fn`-typed param, the
// comma-separated SPELLINGS of the fn's own parameter types ("i64", "i32,string").
// `fn_ret` already preserves the return type for the same reason; together they
// reconstruct the declared signature the flat "fn" tag threw away. wasm needs it
// because a funcref type is structural: a `(i64) => boolean` value dispatched
// through an all-i32 `(type $fn2)` is a module that will not load, and an
// `(i32) => i64` one is a runtime `indirect call type mismatch` (#6282). The
// spellings are kept RAW rather than mapped to widths here, because deciding
// whether `T` is a type variable or a struct named T needs the enclosing
// function's type_params, which parse_param does not have.
pub struct ParamDecl { name: string, type_name: string, own: boolean, has_default: boolean, default_value: Expr, ret_arr: boolean, fn_ret: string, fn_param_dyn: string, fn_param_types: string }
// Receiver fields capture `function (recv: RecvType) name(…)`
// — the self-host source uses them heavily for struct methods
// like `function (p: Par) advance(): Par`. Both fields are
// empty for plain functions. Downstream consumers treat
// receiver methods as plain functions for now (the receiver
// is conceptually a hidden first parameter — a later slice
// can prepend it to `params` during method-call lowering).
// type_params holds the BOUNDED type-parameter names (e.g. `["T"]` for
// `function f[T: Eq](…)`). It's empty for non-generic functions and for
// UNBOUNDED generics (`id[T]`), which the self-host still handles by
// erasure. A non-empty type_params marks a function the monomorphiser
// must clone per concrete call-site type — see monomorphize_module and
// docs/TRAITS.md (self-host slice 2).
// import_iface / import_wit bind a body-less function to a WIT import via an
// `@import("wasi:iface@x.y.z", "wit-func-name")` attribute (bring-your-own
// WIT, P4 — docs/WIT-BRING-YOUR-OWN.md). Both empty for an ordinary function;
// when set, body is empty and a call lowers to a core wasm import of
// (import_iface, import_wit).
// bound_traits runs PARALLEL to type_params: bound_traits[i] holds the
// trait bound(s) on type_params[i] as a `+`-joined list of trait names
// (module-qualified as written, e.g. `cmp.Ord`; generic-arg bounds like
// `Iterator[i32]` keep the base name only), or "" for a type param with
// no trait bound (an UNBOUNDED param the monomorphiser promoted into
// type_params — see the promotion loop in parse_func_decl). It exists so
// the checker can flag E021 generic-bound conformance at call sites
// (#4842); it is checker-only and never read by codegen, so it is
// fixpoint-neutral. Empty for non-generic functions.
pub struct FuncDecl { name: string, receiver_name: string, receiver_type: string, type_params: string[], params: ParamDecl[], ret_type: string, body: Stmt[], line: i32, col: i32, import_iface: string, import_wit: string, type_param_count: i32, bound_traits: string[], fip: boolean, fbip: boolean, fip_allowance: i32, ret_str: boolean, async: boolean, is_const: boolean, is_pub: boolean }

// Top-level struct decl: `struct Name { field1: T1, field2: T2 }`.
// Same simplifying assumption as FuncDecl: type names are
// captured as bare strings; full type syntax (arrays /
// generics / unions) lands in a follow-up.
pub struct StructFieldDecl { name: string, type_name: string, fn_ret: string }
// type_params holds a generic struct's parameter names (`["T"]` for
// `struct Box[T]`); empty for a non-generic struct. The monomorphiser
// uses it to clone `Box[i32]` → a concrete `Box__i32` with the field
// types substituted, so primitive/string payloads resolve their methods.
// must_consume records a `@must_consume` attribute on the struct decl
// (docs/MUST-CONSUME.md): the checker's E067 obligation walk consults it.
// derives records the trait names of an `@derive(…)` attribute on the
// decl (an enum's derives are stamped on each variant record): the
// synthesis itself happens at parse time (synth_derives), but the
// checker's E021 derive-field conformance pre-check (#5392) needs to
// know which traits were derived.
// variant_field_names holds a RECORD-form enum variant's field names
// (`Rect { w: f64, h: f64 }` → ["w", "h"]), parallel to `fields`, whose
// entries stay the positional `__ev` / `__ev1` / … payload markers so the
// layout and every downstream `__ev` test are unchanged. Empty for a plain
// struct and for a positional (`Pair(A, B)`) or payloadless variant.
pub struct StructDecl { name: string, fields: StructFieldDecl[], type_params: string[], derives: string[], line: i32, col: i32, enum_owner: string, must_consume: boolean, variant_field_names: string[], is_pub: boolean }

// Top-level union type alias: `type Name = V1 | V2 | V3;`.
// Variants are captured as bare type-name strings — they
// resolve to other struct decls in the same module (or to
// primitives in a later milestone). The `pub` modifier is
// optional and currently swallowed without ceremony, since
// the self-host pipeline doesn't yet distinguish exported
// from private decls.
pub struct TypeAlias { name: string, variants: string[], line: i32, col: i32, is_pub: boolean }

// Top-level import: `import "./path";`. The path is captured
// verbatim (including the quotes-stripped value). Resolution
// across files is a later milestone — for now the parser
// just gathers them into the Module so the rest of the
// pipeline can see what dependencies a source declares.
// `is_reexport` distinguishes a plain `import "path";` (false) from a
// `pub use "path".{names…};` re-export directive (true). A re-export
// import carries the re-exported names in `reexport_names`; the module
// loader still treats it as an import (so the target module is loaded +
// bundled), and the bundler reads the names to build the re-export table
// that redirects a consumer's `facade.name` to the original module's
// mangled symbol. See flatten.bundle / docs/PRELUDE-TO-MODULES.md.
pub struct Import { path: string, is_reexport: boolean, reexport_names: string[], alias: string, line: i32 }

// warn_unresolved_imports prints a stderr diagnostic when `mod` declares imports
// that the CALLER has no module loader to resolve, and reports whether it did.
//
// The single-program drivers — interp_run, wasm_run, asm_ir_run, wasm_ir_run,
// asm_run, asm_pathprobe_run — run `parse_module` on raw stdin and resolve
// nothing. Feed one a program that imports `std/string` and it does not
// complain: the import is ignored, the qualified names go undefined, and the
// driver reports whatever a broken program reports — `ast` from a path probe,
// exit 254 from an interpreter, a bail from an eligibility check. Every one of
// those reads exactly like a compiler gap.
//
// It is not a hypothetical. Three issue diagnoses were wrong for this reason:
// #5990 recorded "to_ascii_lower absent from interp.fern" (really: std/string
// never loaded; the true blocker is that interp.fern implements none of the
// raw-memory intrinsics, #5998), #5992 recorded "to_lower is not IR-eligible on
// wasm" from a wasm_run `ast` verdict (it is eligible — the emitted module
// called an undefined helper), and a third was made while fixing the second.
// docs/TEST-GATES.md documents the trap in prose; a trap that careful readers
// walk into repeatedly needs to announce itself at the point of use.
//
// Deliberately a WARNING, not an error, and deliberately not touching the exit
// code: dozens of existing tests feed these drivers programs whose imports are
// incidental (they use builtin `Map` syntax while carrying `import "core/map"`),
// and those programs compile correctly. Breaking them would buy nothing — the
// harm was always to a human reading a verdict, and a human reads stderr.
// FERN_STRICT_IMPORTS=1 promotes it to a hard exit for anyone who wants the
// stronger guarantee, mirroring FERN_STRICT_IR.
pub function warn_unresolved_imports(mod: Module, driver: string): boolean {
    if (mod.imports.len() == 0) { return false; }
    var paths: string = "";
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        if (i > 0) { paths = paths + ", "; }
        paths = paths + "\"" + mod.imports[i].path + "\"";
        i = i + 1;
    }
    eprint("warning: " + driver + " has no module loader; UNRESOLVED imports: " + paths + "\n");
    eprint("warning: any verdict below (ir/ast, exit code, eligibility bail) describes a BROKEN program, not the language.\n");
    eprint("warning: to judge this program use a loading driver: `fern <prog> <stdlib-root>`, or asm_load_run.\n");
    match (env("FERN_STRICT_IMPORTS")) {
        Some(_) => {
            eprint("error: FERN_STRICT_IMPORTS=1 refuses an unresolvable-import run\n");
            exit(3);
        },
        None => {},
    }
    return true;
}

// A whole compilation unit: the funcs declared at top level and
// any stmts that appear outside a function decl. The interp /
// checker treat funcs first (build a signature table) and then
// either dispatch to `main` if it exists or fall back to the
// top-level stmt stream as the entry point.
// impls / trait_reqs carry the trait-conformance data the checker needs for
// E021 (#4347): trait_reqs lists each trait's REQUIRED (abstract, body-less)
// method names, and impls records every `impl Trait for Type` block with the
// methods it explicitly provides. parse_module populates both; the
// transformation passes propagate them unchanged.
pub struct Module { funcs: FuncDecl[], structs: StructDecl[], aliases: TypeAlias[], imports: Import[], top_stmts: Stmt[], enums: EnumDecl[], resources: ResourceDecl[], exports: ExportBinding[], impls: ImplInfo[], trait_reqs: TraitReq[], trait_decls: TraitDecl[] }

// TraitReq is one trait's required-method set: the abstract (body-less)
// signatures an `impl` MUST provide. A defaulted (bodied) method is NOT
// required (the default is synthesised onto impls that omit it), so it never
// appears here. Drives the E021 missing-method check (#4347).
// TraitReq carries a trait's ABSTRACT (required) methods for the E021
// conformance check (#4347). `methods` is the required method names; `req_sigs`
// is the parallel full signatures (same length/order) so the checker can also
// diagnose an impl method whose arity / param types / return type disagree with
// the trait's declaration (Self resolves to the impl type at the check site).
pub struct TraitReq { trait_name: string, methods: string[], req_sigs: FuncDecl[], supertraits: string[] }

// TraitDecl is the `trait` block as WRITTEN, retained for the formatter
// (#6773) and, since it is the only record of a trait's TYPE PARAMETERS, for
// the E021 conformance check. The compile path reads two DERIVED views of it
// and neither can be printed from: TraitReq keeps the abstract method set for
// E021, with names simplified past any `mod.` qualifier, and TraitDefault
// keeps the bodied methods so they can be synthesised onto impls that omit
// them. Between them they drop the `pub`, the type parameters, the source
// position, and the order the methods were written in — so a formatted file
// lost its `trait` blocks entirely and every `impl` of one then named a trait
// the file no longer declared. A method's body is empty when it was written
// abstract.
pub struct TraitDecl { name: string, type_params: string[], supertraits: string[], methods: FuncDecl[], line: i32, col: i32, is_pub: boolean }

// ImplDecl is an `impl` block as WRITTEN, retained for the formatter (#6783) for
// the same reason TraitDecl is. parse_impl_decl desugars on the way in — each
// method becomes an ordinary receiver method on `Module.funcs` and the block
// reduces to an ImplInfo (trait name, impl type, method names) for the E021
// conformance walk — so a formatted file re-declared each method as a plain
// receiver method and the `impl` it belonged to was gone. A type stopped
// implementing the trait.
//
// `methods` holds the DESUGARED forms, which is what native prints too: `Self`
// already reads as the concrete impl type there, and a method's `self` receiver
// is re-inserted as its first parameter at print time. `trait_ref` is "" for an
// inherent `impl Type { … }`.
pub struct ImplDecl { trait_ref: string, type_ref: string, type_params: string[], bounds: string[], methods: FuncDecl[], line: i32, col: i32 }

// FieldLines records the source line of each FIELD of one struct, or of each
// VARIANT of one enum, for the formatter alone. Both formatters force the
// multi-line block form when a comment sits inside the braces, and drain each
// comment against the field it was written above; with no line per field the
// self-host printed the one-liner instead and every such comment was re-emitted
// above the NEXT declaration, where it documents the wrong thing (#6802).
//
// It rides beside Module for the reason TraitDecl does: 57 StructFieldDecl
// literals across the self-host would each have to carry a line none of them
// reads.
pub struct FieldLines { name: string, decl_line: i32, lines: i32[] }

// ParsedFmt is parse_module_verbatim's result: the module plus the decls kept
// only for printing.
pub struct ParsedFmt { pmod: Module, ptraits: TraitDecl[], pimpls: ImplDecl[], pflines: FieldLines[] }

// ResourceDecl records a `resource Name;` declaration (P5 — WIT resource-handle
// types, docs/WIT-BRING-YOUR-OWN.md). `iface` / `wit` carry the WIT identity
// from an `@import("iface", "wit-resource-name")` attribute (empty for an
// unbound resource). lower_defers_prepass_module uses the binding to synthesize the
// `[resource-drop]` import an owned handle is released through.
pub struct ResourceDecl { name: string, iface: string, wit: string }

// ExportBinding records an `@export("iface", "wit-name") function f {…}` binding
// (P6 — docs/WIT-BRING-YOUR-OWN.md): the function `func_name` implements the WIT
// world export (iface, wit). The wasm emitter surfaces a core export
// `iface#wit-name` for each so the Go world-driven composer lifts it. Kept as a
// Module side-list (like resources) rather than a FuncDecl field to avoid
// rippling through every FuncDecl literal.
pub struct ExportBinding { func_name: string, iface: string, wit: string }

// EnumDecl preserves an enum's name + the names of its variants. The
// parser desugars each enum into variant structs (pushed to `structs`)
// for codegen, which drops the enum -> variants grouping; this record
// keeps it so the checker can detect enum-level declaration errors (an
// enum redeclared, a duplicate variant) that the flat struct table can't
// distinguish from ordinary structs. Codegen ignores it.
// must_consume mirrors StructDecl.must_consume for `@must_consume enum`
// declarations (docs/MUST-CONSUME.md, E067).
pub struct EnumDecl { name: string, variant_names: string[], type_params: string[], line: i32, col: i32, must_consume: boolean, is_pub: boolean }

// enum_variant_names extracts the variant names from an enum's desugared
// variant structs.
function enum_variant_names(variants: StructDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < variants.len()) { out = out.append(variants[i].name); i = i + 1; }
    return out;
}

// concat_enums appends two enum-decl lists (used when merging modules).
function concat_enums(a: EnumDecl[], b: EnumDecl[]): EnumDecl[] {
    var out: EnumDecl[] = a;
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// Helper wraps to satisfy the implicit-union-wrap return-position
// rule. Same pattern lexer.fern uses for Token construction.

function e_number(text: string, suffix: string, is_float: boolean): Expr {
    return ExprNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: 0, col: 0 };
}
function e_number_at(text: string, suffix: string, is_float: boolean, line: i32, col: i32): Expr {
    return ExprNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: line, col: col };
}
function e_quoted_at(text: string, suffix: string, raw: string, line: i32, col: i32): Expr {
    return ExprNumber { text: text, suffix: suffix, raw: raw, is_float: false, line: line, col: col };
}
function e_ident(name: string): Expr { return ExprIdent { name: name, line: 0, col: 0 }; }
function e_ident_at(name: string, line: i32, col: i32): Expr { return ExprIdent { name: name, line: line, col: col }; }
function e_string(value: string): Expr { return ExprString { value: value, line: 0, col: 0 }; }
function e_string_at(value: string, line: i32, col: i32): Expr { return ExprString { value: value, line: line, col: col }; }
pub function e_bool(value: boolean): Expr { return ExprBool { value: value }; }
function e_binary(op: string, left: Expr, right: Expr): Expr {
    return ExprBinary { op: op, left: left, right: right, line: 0, col: 0 };
}
function e_binary_at(op: string, left: Expr, right: Expr, line: i32, col: i32): Expr {
    return ExprBinary { op: op, left: left, right: right, line: line, col: col };
}
function e_unary(op: string, operand: Expr): Expr { return ExprUnary { op: op, operand: operand, line: 0, col: 0 }; }
function e_unary_at(op: string, operand: Expr, line: i32, col: i32): Expr { return ExprUnary { op: op, operand: operand, line: line, col: col }; }
function e_call(callee: Expr, args: Expr[]): Expr { return ExprCall { callee: callee, args: args, line: 0, col: 0, type_argc: 0, ty: "" }; }
function e_call_at(callee: Expr, args: Expr[], line: i32, col: i32): Expr { return ExprCall { callee: callee, args: args, line: line, col: col, type_argc: 0, ty: "" }; }
function e_array(elements: Expr[]): Expr { return ExprArray { elements: elements }; }
function e_tuple(elements: Expr[]): Expr { return ExprTuple { elements: elements, line: 0, col: 0 }; }
function e_tuple_at(elements: Expr[], line: i32, col: i32): Expr { return ExprTuple { elements: elements, line: line, col: col }; }
function e_index(array: Expr, index: Expr): Expr { return ExprIndex { array: array, index: index, unchecked: false, ty: "" }; }
function e_slice(array: Expr, start: Expr, end: Expr): Expr {
    return ExprSlice { array: array, start: start, end: end, ty: "" };
}
function e_struct_lit(type_name: string, field_names: string[], field_values: Expr[], line: i32, col: i32): Expr {
    return ExprStructLit { type_name: type_name, field_names: field_names, field_values: field_values, has_base: false, base: e_unknown("no-base"), line: line, col: col };
}
// e_struct_update builds a struct-update literal carrying a base
// spread source. The base is the value whose un-overridden fields
// are copied into the new box; the listed fields override.
function e_struct_update(type_name: string, field_names: string[], field_values: Expr[], base: Expr, line: i32, col: i32): Expr {
    return ExprStructLit { type_name: type_name, field_names: field_names, field_values: field_values, has_base: true, base: base, line: line, col: col };
}
function e_field_access(obj: Expr, field: string): Expr {
    return ExprFieldAccess { obj: obj, field: field, line: 0, col: 0, ty: "" };
}
function e_field_access_at(obj: Expr, field: string, line: i32, col: i32): Expr {
    return ExprFieldAccess { obj: obj, field: field, line: line, col: col, ty: "" };
}
function e_lambda(params: ParamDecl[], ret_type: string, body: Stmt[]): Expr {
    return ExprLambda { params: params, ret_type: ret_type, body: body, use_infer: false };
}
pub function e_unknown(kind: string): Expr { return ExprUnknown { kind: kind, line: 0, col: 0 }; }
pub function e_unknown_at(kind: string, line: i32, col: i32): Expr { return ExprUnknown { kind: kind, line: line, col: col }; }

function s_var(name: string, type_name: string, init: Expr): Stmt {
    return StmtVar { name: name, type_name: type_name, init: init, line: 0, col: 0, is_str: false };
}
// s_var_at is s_var with an explicit source position (used at the parse
// site so a `var` declaration's diagnostics — E003 / E013 / E020 — point
// at the `var` keyword).
function s_var_at(name: string, type_name: string, init: Expr, line: i32, col: i32): Stmt {
    return StmtVar { name: name, type_name: type_name, init: init, line: line, col: col, is_str: false };
}

// parse_destructure_names consumes `(a, b, …)` with the cursor ON the opening
// `(`, returning the comma-joined binding encoding a tuple-destructure StmtVar
// carries in its name. A NESTED element `(a, (b, c))` encodes as the inner list
// in parens — `"a,(b,c)"` — and lower_var splits on TOP-LEVEL commas, binding
// the parenthesised position to a temp it destructures again. ok=false when an
// element is not a binder: native rejects the same shape, because a literal
// element can fail to match and a destructuring bind has no else branch. The
// count is this level's position count, which the no-singleton-tuples rule
// needs and a comma scan cannot give (a nested position carries its own).
function parse_destructure_names(p: Par): (string, i32, boolean, Par) {
    p = p.advance(); // consume `(`
    var names: string = "";
    var count: i32 = 0;
    var first: boolean = true;
    while (p.peek_punct() != ")" && !p.at_end()) {
        var part: string = "";
        if (p.peek_punct() == "(") {
            var (inner, inner_n, inner_ok, inner_p) = parse_destructure_names(p);
            p = inner_p;
            if (!inner_ok || inner_n < 2) { return ("", 0, false, p); }
            part = "(" + inner + ")";
        } else {
            part = p.peek_ident();
            if (part.len() == 0) { return ("", 0, false, p); }
            p = p.advance();
        }
        if (!first) { names = names + ","; }
        names = names + part;
        first = false;
        count = count + 1;
        if (p.peek_punct() == ",") { p = p.advance(); }
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    return (names, count, true, p);
}

// parse_struct_destructure consumes `{ x, y: b, .. } = E;` with the cursor
// on the opening `{` (the struct-type name already consumed as `struct_name`).
// It encodes the whole binding as ONE StmtVar the way tuple destructure does:
// `name` carries the comma-joined BINDING names ("x,b"), and `type_name`
// carries the marker "@sd:<StructName>:<comma-joined FIELD names>". irlower's
// lower_struct_destructure decodes it into per-field `var bind = tmp.field;`
// binds. A trailing `..` marks intentionally-omitted fields (partial bind).
function parse_struct_destructure(p: Par, struct_name: string, line: i32, col: i32): (Stmt, Par) {
    p = p.advance(); // consume `{`
    var bindings: string = "";
    var fields: string = "";
    var first: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
        if (p.peek_punct() == "..") { p = p.advance(); break; }
        var fld: string = p.peek_ident();
        // Same finiteness argument as the tuple loop: nothing below consumes
        // a non-ident field token, so it has to end the parse.
        if (fld.len() == 0) {
            return (s_unknown("a struct destructuring pattern binds field names"), p);
        }
        p = p.advance();
        var bind: string = fld;
        if (p.peek_punct() == ":") {
            p = p.advance();
            var bn: string = p.peek_ident();
            if (bn.len() > 0) { p = p.advance(); bind = bn; }
        }
        if (!first) { bindings = bindings + ","; fields = fields + ","; }
        bindings = bindings + bind;
        fields = fields + fld;
        first = false;
        if (p.peek_punct() == ",") { p = p.advance(); }
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    if (p.peek_punct() == "=") { p = p.advance(); }
    var (init_expr, ip) = parse_expr(p);
    p = ip;
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (s_var_at(bindings, "@sd:" + struct_name + ":" + fields, init_expr, line, col), p);
}
function s_return(value: Expr): Stmt { return StmtReturn { value: value, line: 0, col: 0 }; }
// s_return_at carries the `return` keyword position so E002 / E012 point at it.
function s_return_at(value: Expr, line: i32, col: i32): Stmt { return StmtReturn { value: value, line: line, col: col }; }
function s_expr(value: Expr): Stmt { return StmtExpr { value: value, line: 0 }; }
function s_if(cond: Expr, then_body: Stmt[], else_body: Stmt[]): Stmt {
    return s_if_chained(cond, then_body, else_body, false);
}
// no_match_sugar is the empty MatchSugar every StmtIf but the two match
// desugars carries.
pub function no_match_sugar(): MatchSugar {
    var no_tup: TupArm[] = [];
    var no_struct: StructArm[] = [];
    var no_lit: LitArm[] = [];
    return MatchSugar { scrut: e_unknown(""), tup: no_tup, strct: no_struct, lits: no_lit, line: 0, col: 0 };
}
// s_if_match wraps the done-flag chain a tuple- or struct-scrutinee match
// desugars to, carrying the arms as WRITTEN so the printer reprints the match.
function s_if_match(body: Stmt[], sugar: MatchSugar): Stmt {
    var no_else: Stmt[] = [];
    return StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: sugar.line, else_chained: false, sugar: sugar, origin: "" };
}
// s_if_chained is s_if for the one caller that knows how the else was WRITTEN:
// the `if` statement parse. Every other construction is synthesised, and a
// synthesised else-body is printed in block form (both spellings re-parse to
// the same AST, so only source fidelity is at stake).
function s_if_chained(cond: Expr, then_body: Stmt[], else_body: Stmt[], chained: boolean): Stmt {
    return StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: chained, sugar: no_match_sugar(), origin: "" };
}
// s_if_tagged is a scoping `if (true) { … }` labelled with the source form it
// stands in for, so `-fmt` reprints that form rather than the scope.
function s_if_tagged(body: Stmt[], origin: string): Stmt {
    var no_else: Stmt[] = [];
    return StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}
// s_block is the bare `{ … }` statement.
function s_block(body: Stmt[]): Stmt {
    return s_if_tagged(body, "block");
}
function s_while(cond: Expr, body: Stmt[]): Stmt {
    return StmtWhile { cond: cond, body: body, label: "", line: 0, is_loop: false };
}
function s_for(var_name: string, iter: Expr, body: Stmt[]): Stmt {
    return StmtFor { var_name: var_name, iter: iter, body: body, label: "", line: 0 };
}
// with_loop_label stamps a parsed loop label onto a freshly-built while/for loop
// (a no-op for the empty label or a non-loop stmt). `loop`/for-range parse helpers
// return a StmtWhile/StmtFor; this re-wraps it carrying the label.
function with_loop_label(st: Stmt, label: string): Stmt {
    if (label.len() == 0) { return st; }
    match (st) {
        StmtWhile(w) => { return StmtWhile { cond: w.cond, body: w.body, label: label, line: w.line, is_loop: w.is_loop }; },
        StmtFor(fr) => { return StmtFor { var_name: fr.var_name, iter: fr.iter, body: fr.body, label: label, line: fr.line }; },
        StmtIf(f) => {
            // A C-style `for` desugars to `if (true) { INIT; var __forc_…;
            // while (true) { … } }` (parse_for_stmt), so the source label
            // belongs to that inner while — without this a `break outer`
            // inside the loop finds no loop carrying the name.
            var n: i32 = f.then_body.len();
            if (n == 0) { return st; }
            match (f.then_body[n - 1]) {
                StmtWhile(w2) => {
                    var relabelled: Stmt[] = [];
                    var i: i32 = 0;
                    while (i < n - 1) { relabelled = relabelled.append(f.then_body[i]); i = i + 1; }
                    relabelled = relabelled.append(StmtWhile { cond: w2.cond, body: w2.body, label: label, line: w2.line, is_loop: w2.is_loop });
                    return StmtIf { ...f, cond: f.cond, then_body: relabelled, else_body: f.else_body };
                },
                _ => { return st; }
            }
            return st;
        },
        _ => { return st; }
    }
    return st;
}
function s_break(): Stmt { return StmtBreak { tag: 0, line: 0, col: 0, label: "" }; }
function s_break_at(line: i32, col: i32): Stmt { return StmtBreak { tag: 0, line: line, col: col, label: "" }; }
function s_continue(): Stmt { return StmtContinue { tag: 0, line: 0, col: 0, label: "" }; }
function s_continue_at(line: i32, col: i32): Stmt { return StmtContinue { tag: 0, line: line, col: col, label: "" }; }
function s_assign(target: string, value: Expr): Stmt {
    return StmtAssign { target: target, value: value, line: 0, col: 0, target_line: 0, target_col: 0 };
}
// s_assign_at carries the `=`-token position (line/col, where E003 points)
// and the target identifier's position (target_line/target_col, where the
// Go checker reports E001 for an undefined assignment target).
function s_assign_at(target: string, value: Expr, line: i32, col: i32, target_line: i32, target_col: i32): Stmt {
    return StmtAssign { target: target, value: value, line: line, col: col, target_line: target_line, target_col: target_col };
}
function s_match(scrutinee: Expr, arms: MatchArm[]): Stmt {
    var no_sugar: MatchArm[] = [];
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: 0, col: 0, origin: "", sugar: no_sugar };
}
function s_match_at(scrutinee: Expr, arms: MatchArm[], line: i32, col: i32): Stmt {
    var no_sugar: MatchArm[] = [];
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: no_sugar };
}
// s_match_sugared is s_match_at plus the written-form arms for the printer.
function s_match_sugared(scrutinee: Expr, arms: MatchArm[], sugar: MatchArm[], line: i32, col: i32): Stmt {
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: sugar };
}

// array_builder_elem extracts T from an "ArrayBuilder[T]" type spelling
// (the self-host parser keeps param types as strings). Returns "" when the
// spelling isn't ArrayBuilder[...]. See docs/ARRAY-BUILDER-PLAN.md.
function array_builder_elem(t: string): string {
    var prefix: string = "ArrayBuilder[";
    var pl: i32 = prefix.len();
    if (t.len() < pl + 1) { return ""; }
    if (t[t.len() - 1] != 93) { return ""; }  // 93 = ']'
    // Manual prefix match (parser.fern doesn't import std/string for
    // starts_with) — byte-compare against "ArrayBuilder[".
    var i: i32 = 0;
    while (i < pl) {
        if (t[i] != prefix[i]) { return ""; }
        i = i + 1;
    }
    return t[pl : t.len() - 1] + "";
}

// is_builder_mutation is true when `c` is `b.append(...)` / `b.with(...)` /
// `b.insert(...)` — an in-place builder mutation that becomes a reassignment.
// `insert` covers the Map.build builder (`b.insert(k, v)`).
function is_builder_mutation(c: ExprCall, b: string): boolean {
    match (c.callee) {
        ExprFieldAccess(fa) => {
            if (fa.field != "append" && fa.field != "with" && fa.field != "insert") { return false; }
            match (fa.obj) {
                ExprIdent(id) => { return id.name == b; },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// rewrite_builder_stmt retargets statement-position `b.append(...)` /
// `b.with(...)` into `b = b.append(...)`, recursing into every statement
// container so a builder mutated inside a loop / branch is handled. A
// builder call left unrewritten (e.g. inside a nested lambda, not descended
// into) stays a discarded value-returning result and trips E055 — loud, not
// a silent lost write.
function rewrite_builder_stmt(s: Stmt, b: string): Stmt {
    match (s) {
        StmtExpr(es) => {
            match (es.value) {
                ExprCall(c) => {
                    if (is_builder_mutation(c, b)) { return s_assign(b, es.value); }
                    return s;
                },
                _ => { return s; },
            }
        },
        StmtIf(f) => {
            return StmtIf { ...f, cond: f.cond, then_body: rewrite_builder_stmts(f.then_body, b), else_body: rewrite_builder_stmts(f.else_body, b) };
        },
        StmtWhile(w) => {
            return StmtWhile { cond: w.cond, body: rewrite_builder_stmts(w.body, b), label: w.label, line: w.line, is_loop: w.is_loop };
        },
        StmtFor(fr) => {
            return StmtFor { var_name: fr.var_name, iter: fr.iter, body: rewrite_builder_stmts(fr.body, b), label: fr.label, line: fr.line };
        },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: MatchArm = m.arms[ai];
                arms = arms.append(MatchArm { pattern: arm.pattern, body: rewrite_builder_stmts(arm.body, b), line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard });
                ai = ai + 1;
            }
            return StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms };
        },
        _ => { return s; },
    }
    return s;
}

function rewrite_builder_stmts(stmts: Stmt[], b: string): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        out = out.append(rewrite_builder_stmt(stmts[i], b));
        i = i + 1;
    }
    return out;
}

// maybe_desugar_array_build lowers `Array.build(function(b: ArrayBuilder[T]):
// void { BODY })` into a unique-local IIFE — the self-host mirror of the Go
// parser desugar (docs/ARRAY-BUILDER-PLAN.md). Returns `base` unchanged when
// it isn't a well-formed Array.build call.
function maybe_desugar_array_build(base: Expr): Expr {
    match (base) {
        ExprCall(call) => {
            match (call.callee) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "build") { return base; }
                    match (fa.obj) {
                        ExprIdent(id) => {
                            if (id.name != "Array") { return base; }
                            if (call.args.len() != 1) { return base; }
                            match (call.args[0]) {
                                ExprLambda(lam) => {
                                    if (lam.params.len() != 1) { return base; }
                                    var elem: string = array_builder_elem(lam.params[0].type_name);
                                    if (elem.len() == 0) { return base; }
                                    var bname: string = lam.params[0].name;
                                    var arrty: string = elem + "[]";
                                    var stmts: Stmt[] = [];
                                    stmts = stmts.append(s_var(bname, arrty, e_array([])));
                                    var rewritten: Stmt[] = rewrite_builder_stmts(lam.body, bname);
                                    var ri: i32 = 0;
                                    while (ri < rewritten.len()) {
                                        stmts = stmts.append(rewritten[ri]);
                                        ri = ri + 1;
                                    }
                                    stmts = stmts.append(s_return(e_ident(bname)));
                                    var iife: Expr = ExprLambda { params: [], ret_type: arrty, body: stmts, use_infer: false };
                                    return ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_argc: 0, ty: "" };
                                },
                                _ => { return base; },
                            }
                        },
                        _ => { return base; },
                    }
                },
                _ => { return base; },
            }
        },
        _ => { return base; },
    }
    return base;
}

// map_builder_inner extracts "K, V" from a "MapBuilder[K, V]" type spelling
// (kept as a string by the self-host parser). Returns "" when the spelling
// isn't MapBuilder[...]. The map sibling of array_builder_elem.
function map_builder_inner(t: string): string {
    var prefix: string = "MapBuilder[";
    var pl: i32 = prefix.len();
    if (t.len() < pl + 1) { return ""; }
    if (t[t.len() - 1] != 93) { return ""; }  // 93 = ']'
    var i: i32 = 0;
    while (i < pl) {
        if (t[i] != prefix[i]) { return ""; }
        i = i + 1;
    }
    return t[pl : t.len() - 1] + "";
}

// maybe_desugar_map_build lowers `Map.build(function(b: MapBuilder[K, V]):
// void { BODY })` into a unique-local IIFE — the map sibling of
// maybe_desugar_array_build (docs/ARRAY-BUILDER-PLAN.md). `b` is a fresh
// non-escaping map so every `b.insert(k, v)` (rewritten to `b = b.insert(...)`)
// is the in-place fast path. Returns `base` unchanged when it isn't a
// well-formed Map.build call.
function maybe_desugar_map_build(base: Expr): Expr {
    match (base) {
        ExprCall(call) => {
            match (call.callee) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "build") { return base; }
                    match (fa.obj) {
                        ExprIdent(id) => {
                            if (id.name != "Map") { return base; }
                            if (call.args.len() != 1) { return base; }
                            match (call.args[0]) {
                                ExprLambda(lam) => {
                                    if (lam.params.len() != 1) { return base; }
                                    var inner: string = map_builder_inner(lam.params[0].type_name);
                                    if (inner.len() == 0) { return base; }
                                    var bname: string = lam.params[0].name;
                                    var mapty: string = "Map[" + inner + "]";
                                    var cargs: Expr[] = [];
                                    cargs = cargs.append(e_number("8", "", false));
                                    var stmts: Stmt[] = [];
                                    stmts = stmts.append(s_var(bname, mapty, e_call(e_ident("map_new"), cargs)));
                                    var rewritten: Stmt[] = rewrite_builder_stmts(lam.body, bname);
                                    var ri: i32 = 0;
                                    while (ri < rewritten.len()) {
                                        stmts = stmts.append(rewritten[ri]);
                                        ri = ri + 1;
                                    }
                                    stmts = stmts.append(s_return(e_ident(bname)));
                                    var iife: Expr = ExprLambda { params: [], ret_type: mapty, body: stmts, use_infer: false };
                                    return ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_argc: 0, ty: "" };
                                },
                                _ => { return base; },
                            }
                        },
                        _ => { return base; },
                    }
                },
                _ => { return base; },
            }
        },
        _ => { return base; },
    }
    return base;
}
// s_match_origin is s_match_at tagged with the desugar that produced it
// ("if_let" / "let_else"); see StmtMatch.origin.
function s_match_origin(scrutinee: Expr, arms: MatchArm[], line: i32, col: i32, origin: string): Stmt {
    var no_sugar: MatchArm[] = [];
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: no_sugar };
}
// s_match_origin_sugared is s_match_origin plus the written-form arms.
function s_match_origin_sugared(scrutinee: Expr, arms: MatchArm[], sugar: MatchArm[], line: i32, col: i32, origin: string): Stmt {
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: sugar };
}
function p_variant(type_name: string, binding: string): Pattern {
    var no_extra: string[] = [];
    var no_nested: Pattern[] = [];
    var no_tup_kinds: i32[] = [];
    var no_tup_binds: string[] = [];
    var no_tup_lits: Expr[] = [];
    var no_tup_pats: Pattern[] = [];
    return PatVariant { type_name: type_name, binding: binding, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
}
// p_variant_n builds a variant pattern binding N payloads as `<prefix>0` …
// `<prefix>N-1`. p_variant's single `binding` covers only the first, which is
// why every @derive synthesiser over enum variants silently ignored payloads
// past it — a `Rect(2, 3)` compared, hashed and rendered as if it were
// `Rect(2)`. n <= 0 binds nothing (a unit variant).
function p_variant_n(type_name: string, prefix: string, n: i32): Pattern {
    if (n <= 0) { return p_variant(type_name, ""); }
    var extra: string[] = [];
    var i: i32 = 1;
    while (i < n) { extra = extra.append(prefix + dl_itoa(i)); i = i + 1; }
    var no_nested: Pattern[] = [];
    var no_tup_kinds: i32[] = [];
    var no_tup_binds: string[] = [];
    var no_tup_lits: Expr[] = [];
    var no_tup_pats: Pattern[] = [];
    return PatVariant { type_name: type_name, binding: prefix + "0", extra_bindings: extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
}
// fold_lit_cond moves a pattern's implied literal-payload condition onto the
// arm being built and clears it from the pattern. Call it at every point the
// PARSER turns a freshly parsed Pattern into a MatchArm — the outer arm for a
// direct slot, build_merged_arm's inner arm for a nested one. After the fold
// the arm is an ordinary guarded arm, so no later stage needs to know literal
// payload slots exist.
function fold_lit_cond(pat: Pattern, guard: Expr, has_guard: boolean): (Pattern, Expr, boolean) {
    match (pat) {
        PatVariant(pv) => {
            if (!pv.has_lit_cond) { return (pat, guard, has_guard); }
            var no_tup_kinds: i32[] = [];
            var no_tup_binds: string[] = [];
            var no_tup_lits: Expr[] = [];
            var no_tup_pats: Pattern[] = [];
            var cleared: Pattern = PatVariant { ...pv, lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
            if (!has_guard) { return (cleared, pv.lit_cond, true); }
            return (cleared, e_binary("&&", pv.lit_cond, guard), true);
        },
        _ => { return (pat, guard, has_guard); }
    }
}

function p_wildcard(): Pattern { return PatWildcard { tag: 0 }; }
function s_unknown(kind: string): Stmt { return StmtUnknown { kind: kind }; }
function s_defer(action: Stmt): Stmt { return StmtDefer { action: action, on_error: 0, line: 0 }; }
function s_errdefer(action: Stmt): Stmt { return StmtDefer { action: action, on_error: 1, line: 0 }; }

// label_depth returns the relative loop depth of `name` in the enclosing-loop
// label stack (the last entry is the innermost loop), or -1 if absent. Depth 0 is
// the innermost loop, 1 its enclosing loop, and so on.
function label_depth(labels: string[], name: string): i32 {
    var i: i32 = labels.len() - 1;
    while (i >= 0) {
        if (labels[i] == name) { return (labels.len() - 1) - i; }
        i = i - 1;
    }
    return 0 - 1;
}

// resolve_labels_stmt rewrites a labeled `break`/`continue`'s `tag` to the
// relative loop depth of its target label, recursing through every statement
// container (if / while / for / match / defer) so a break/continue
// anywhere in the nest is resolved against the live enclosing-loop label stack
// (`labels`; "" for an unlabeled loop). An unlabeled break/continue keeps tag 0
// (the innermost loop). This runs on the RAW parsed module before any desugar
// pass, so the loop labels are still in place and every downstream pass only has
// to carry the already-resolved `tag` (which break/continue stmts preserve by
// identity through those passes).
function resolve_labels_stmt(st: Stmt, labels: string[]): Stmt {
    match (st) {
        StmtBreak(b) => {
            if (b.label.len() == 0) { return st; }
            var d: i32 = label_depth(labels, b.label);
            if (d < 0) { d = 0; }
            return StmtBreak { tag: d, line: b.line, col: b.col, label: b.label };
        },
        StmtContinue(c) => {
            if (c.label.len() == 0) { return st; }
            var d2: i32 = label_depth(labels, c.label);
            if (d2 < 0) { d2 = 0; }
            return StmtContinue { tag: d2, line: c.line, col: c.col, label: c.label };
        },
        StmtWhile(w) => {
            return StmtWhile { cond: w.cond, body: resolve_labels_block(w.body, labels.append(w.label)), label: w.label, line: w.line, is_loop: w.is_loop };
        },
        StmtFor(fr) => {
            return StmtFor { var_name: fr.var_name, iter: fr.iter, body: resolve_labels_block(fr.body, labels.append(fr.label)), label: fr.label, line: fr.line };
        },
        StmtIf(f) => {
            return StmtIf { ...f, cond: f.cond, then_body: resolve_labels_block(f.then_body, labels), else_body: resolve_labels_block(f.else_body, labels) };
        },
        StmtMatch(m) => {
            var arms2: MatchArm[] = [];
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var a: MatchArm = m.arms[ai];
                arms2 = arms2.append(MatchArm { pattern: a.pattern, body: resolve_labels_block(a.body, labels), line: a.line, col: a.col, guard: a.guard, has_guard: a.has_guard });
                ai = ai + 1;
            }
            return StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms2 };
        },
        StmtDefer(dd) => {
            return StmtDefer { action: resolve_labels_stmt(dd.action, labels), on_error: dd.on_error, line: dd.line };
        },
        _ => { return st; }
    }
    return st;
}

function resolve_labels_block(stmts: Stmt[], labels: string[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        out = out.append(resolve_labels_stmt(stmts[i], labels));
        i = i + 1;
    }
    return out;
}

// resolve_labels_module bakes each labeled break/continue's relative loop depth
// into its `tag` (see resolve_labels_stmt). Runs first in the prepare pipeline,
// on the freshly parsed module.
pub function resolve_labels_module(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var none: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        funcs = funcs.append(FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: resolve_labels_block(fd.body, none), line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, fbip: fd.fbip, fip_allowance: fd.fip_allowance, ret_str: fd.ret_str, async: fd.async, is_const: fd.is_const, is_pub: fd.is_pub });
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: resolve_labels_block(mod.top_stmts, none), enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls };
}


// Parser state. `toks` is the lexer's output; `pos` is the
// current cursor into it. We mutate via value-semantics (return
// fresh Par from each consume()).

// `no_struct` suppresses the `Ident { … }` / `pkg.Type { … }`
// struct-literal shortcut in parse_primary while parsing an
// expression whose trailing `{` opens a block instead — the
// `for VAR in EXPR { body }` iter being the motivating case
// (`for x in a {}` must read `a` + an empty block, not the empty
// struct literal `a {}`). Set true only around the iter parse and
// restored afterward; it rides through advance() so it stays in
// force for the whole iter sub-expression, matching the Go
// parser's noStructLit (which likewise blocks nested struct lits
// in the iter — `for x in f(Foo{…})` is rejected on both).
// `map_kind` is the KEY KIND a `Map { … }` literal about to be parsed should be
// built with — 1 for i32, 0 for string, -1 for "no annotation, guess". Set by
// the var-decl parser from the declared type and consumed by parse_map_lit,
// the same parse-context shape as no_struct. It reaches ONLY a literal: a
// hand-written `map_new(8).insert(1, 10)` chain keeps the constructor the
// author wrote, so the E038 gate on it (asmcore.check_map_new_chain, which
// mirrors a native rejection) still fires.
// structnames lists every struct DECLARED in this token stream. A match arm
// `Rect { w, h }` is spelled exactly like the struct pattern `Point { x, y }`,
// and which one it is depends on the scrutinee's type, which the parser does not
// know — so it decides on the name: a locally-declared struct takes the
// struct-pattern desugar, anything else (a record-form enum variant, or a name
// from an import) takes the variant path. The tie goes to the variant because a
// record variant destructured by name is otherwise unparseable — the `{` ends
// the arm and the rest of the file is reinterpreted (#6676) — while a struct
// pattern on an imported struct has never been written here. Pre-scanned once
// per stream rather than accumulated as decls are parsed, so a match written
// ahead of the struct it destructures still resolves.
// verbatim keeps the WRITTEN spelling of a type where the compile parse
// canonicalises it — `str` erased to `string`, a function type coarsed to the
// flat `fn` tag (#6773). Only `-fmt` sets it: those canonicalisations are what
// every downstream `== "string"` / `== "fn"` dispatch site reads, and the
// formatter is the one consumer that parses without compiling.
struct Par { toks: lexer.Token[], pos: i32, no_struct: boolean, map_kind: i32, structnames: string[], verbatim: boolean }

// scan_struct_names walks the token stream for `struct N` / `pub struct N`
// declarations and returns the names. A shape scan, not a parse: `struct` is a
// keyword, so the ident that follows one is always a declared struct name.
function scan_struct_names(toks: lexer.Token[]): string[] {
    var out: string[] = [];
    var q: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: out, verbatim: false };
    while (!q.at_end()) {
        if (q.peek_keyword() != "struct") { q = q.advance(); continue; }
        q = q.advance();
        var nm: string = q.peek_ident();
        if (nm.len() > 0) { out = out.append(nm); q = q.advance(); }
    }
    return out;
}

function (p: Par) at_end(): boolean {
    if (p.pos >= p.toks.len()) { return true; }
    var t: lexer.Token = p.toks[p.pos];
    match (t) {
        lexer.TokEof(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

function (p: Par) peek(): lexer.Token {
    if (p.pos < p.toks.len()) { return p.toks[p.pos]; }
    return lexer.eof_tok(0, 0);
}

// peek_line / peek_col return the 1-based source position of the current
// token (0 when unavailable) — every token variant carries line/col, so
// the parser can stamp positions onto the AST nodes it builds.
function (p: Par) peek_line(): i32 {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokEof(x) => { return x.line; },
        lexer.TokNumber(x) => { return x.line; },
        lexer.TokIdent(x) => { return x.line; },
        lexer.TokKeyword(x) => { return x.line; },
        lexer.TokPunct(x) => { return x.line; },
        lexer.TokString(x) => { return x.line; },
        lexer.TokError(x) => { return x.line; },
        lexer.TokFString(x) => { return x.line; },
    }
    return 0;
}
function (p: Par) peek_col(): i32 {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokEof(x) => { return x.col; },
        lexer.TokNumber(x) => { return x.col; },
        lexer.TokIdent(x) => { return x.col; },
        lexer.TokKeyword(x) => { return x.col; },
        lexer.TokPunct(x) => { return x.col; },
        lexer.TokString(x) => { return x.col; },
        lexer.TokError(x) => { return x.col; },
        lexer.TokFString(x) => { return x.col; },
    }
    return 0;
}

function (p: Par) advance(): Par {
    return Par { toks: p.toks, pos: p.pos + 1, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim };
}
// with_no_struct returns a cursor with the struct-literal-suppression
// flag set as given (position unchanged).
function (p: Par) with_no_struct(v: boolean): Par {
    return Par { toks: p.toks, pos: p.pos, no_struct: v, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim };
}
function (p: Par) with_map_kind(v: i32): Par {
    return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: v, structnames: p.structnames, verbatim: p.verbatim };
}

// Token-shape queries: each returns "" when the token isn't of
// the expected kind, otherwise the text/name. Callers branch on
// the empty-string result rather than re-matching.
function (p: Par) peek_punct(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokPunct(x) => { return x.text; },
        _ => { return ""; }
    }
    return "";
}
function (p: Par) peek_keyword(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokKeyword(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// more_elems consumes a comma-separated list's separator and reports
// whether another element follows, alongside the advanced cursor. It
// answers false both when there is no comma and when the comma is a
// TRAILING one sitting directly before `close` — so every list routed
// through it accepts a trailing comma. The mirror of the native
// parser's `moreElems` (internal/parser/parser.go); the two must agree
// or a program's legality depends on which compiler reads it.
function (p: Par) more_elems(close: string): (boolean, Par) {
    if (p.peek_punct() != ",") { return (false, p); }
    var q: Par = p.advance();
    return (q.peek_punct() != close, q);
}

// peek2_punct returns the punctuation text of the token ONE past the
// cursor ("" when it isn't a punctuator / out of range). The 2-token
// lookahead the call-argument parser needs to spot a named argument
// (`name = value`): the current token is the IDENT, this is the `=`.
function (p: Par) peek2_punct(): string {
    if (p.pos + 1 < p.toks.len()) {
        var t: lexer.Token = p.toks[p.pos + 1];
        match (t) {
            lexer.TokPunct(x) => { return x.text; },
            _ => { return ""; }
        }
    }
    return "";
}
function (p: Par) peek_ident(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokIdent(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// peek_punct_at / peek_ident_at read the token k slots past the cursor
// (0 == the cursor), returning "" when it is the wrong kind or out of
// range. The wider lookahead the struct `@`-pattern dispatch needs to spot
// `name @ Ident {` before committing to the struct-match desugar.
function (p: Par) peek_punct_at(k: i32): string {
    if (p.pos + k < p.toks.len()) {
        var t: lexer.Token = p.toks[p.pos + k];
        match (t) {
            lexer.TokPunct(x) => { return x.text; },
            _ => { return ""; }
        }
    }
    return "";
}
function (p: Par) peek_ident_at(k: i32): string {
    if (p.pos + k < p.toks.len()) {
        var t: lexer.Token = p.toks[p.pos + k];
        match (t) {
            lexer.TokIdent(x) => { return x.name; },
            _ => { return ""; }
        }
    }
    return "";
}
// peek_is_literal reports whether the cursor sits on a number or
// string literal token. Used by the match-arm parser to recognise a
// literal-pattern arm (`0 => …`, `"yes" => …`) — a match on a
// non-enum (i32 / string) scrutinee — and desugar the whole match to
// an if/else-if chain (see build_literal_match), mirroring the native
// compiler's emitLiteralMatch.
// peek_number_text is the source text of a number-literal token at the
// cursor, or "" for any other token. The graded `fip(n)` / `fbip(n)`
// allowance is the only reader: it needs the digits, not just the kind
// peek_is_literal reports.
function (p: Par) peek_number_text(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokNumber(x) => { return x.text; },
        _ => { return ""; }
    }
    return "";
}

function (p: Par) peek_is_literal(): boolean {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokNumber(x) => { return true; },
        lexer.TokString(x) => { return true; },
        _ => { return false; }
    }
    return false;
}

// peek_is_pat_literal is peek_is_literal widened by one token for PATTERN
// position: the sign of a negative literal is a separate `-` punct, so the
// one-token test declined `-1 => …` and the whole match fell to the variant
// path and bailed (#6394). The grammar has always permitted it —
// `LiteralPattern = [ '-' ] ( NUMBER | FLOAT ) | …`.
//
// Only the GATE needs widening: every literal-pattern site parses through
// parse_binary, which already handles unary minus, so the sign folds in with
// no change to the arms themselves.
function (p: Par) peek_is_pat_literal(): boolean {
    if (p.peek_is_literal()) { return true; }
    if (p.peek_punct() != "-") { return false; }
    if (p.pos + 1 < p.toks.len()) {
        var t: lexer.Token = p.toks[p.pos + 1];
        match (t) {
            lexer.TokNumber(x) => { return true; },
            _ => { return false; }
        }
    }
    return false;
}

// peek_member_name returns the identifier at the cursor, OR a reserved
// keyword that is nonetheless allowed in MEMBER position — currently only
// `default` (a reserved keyword that doubles as the `Default` trait's
// method name `Type.default()`). Returns "" otherwise. Mirrors the Go
// parser's expectMemberName; used for function/method names and field
// access so `function default()` and `obj.default()` parse while the
// keyword stays reserved everywhere else.
function (p: Par) peek_member_name(): string {
    var nm: string = p.peek_ident();
    if (nm.len() > 0) { return nm; }
    if (p.peek_keyword() == "default") { return "default"; }
    return "";
}

// punct_at returns the punctuation text of the token at absolute index
// `idx` ("" when out of range or not a punct token). Used by the
// arrow-lambda lookahead, which must peek several tokens ahead of the
// cursor without advancing.
function (p: Par) punct_at(idx: i32): string {
    if (idx < 0 || idx >= p.toks.len()) { return ""; }
    var t: lexer.Token = p.toks[idx];
    match (t) {
        lexer.TokPunct(x) => { return x.text; },
        _ => { return ""; }
    }
    return "";
}
// ident_at returns the identifier name of the token at absolute index
// `idx` ("" when out of range or not an ident token).
function (p: Par) ident_at(idx: i32): string {
    if (idx < 0 || idx >= p.toks.len()) { return ""; }
    var t: lexer.Token = p.toks[idx];
    match (t) {
        lexer.TokIdent(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// keyword_at returns the keyword text of the token at absolute index
// `idx` ("" when out of range or not a keyword token). Used by the
// if_stmt_has_else lookahead (#4522), which scans past an `if`'s
// paren-balanced condition and brace-balanced then-body to peek for
// a trailing `else`.
function (p: Par) keyword_at(idx: i32): string {
    if (idx < 0 || idx >= p.toks.len()) { return ""; }
    var t: lexer.Token = p.toks[idx];
    match (t) {
        lexer.TokKeyword(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// if_stmt_has_else reports whether the `if` the cursor is on has a
// trailing `else` clause, by skipping its paren-balanced condition and
// brace-balanced then-body and peeking for `else`. Used by
// branch_stmt_start (#4522) to route an else-LESS `if` in a block body
// through the statement path — such an `if` cannot be a value expression
// (an if-EXPRESSION requires `else`), so it is control flow. Mirrors the
// Go parser's ifStmtHasElse.
function (p: Par) if_stmt_has_else(): boolean {
    var i: i32 = p.pos + 1;  // skip `if`
    // Skip `( … )` (paren-balanced).
    if (p.punct_at(i) == "(") {
        var depth: i32 = 0;
        while (i < p.toks.len()) {
            var pt: string = p.punct_at(i);
            if (pt == "(") { depth = depth + 1; }
            else if (pt == ")") {
                depth = depth - 1;
                if (depth == 0) { i = i + 1; break; }
            }
            i = i + 1;
        }
    }
    // Skip `{ … }` (brace-balanced) then-body.
    if (p.punct_at(i) == "{") {
        var bdepth: i32 = 0;
        while (i < p.toks.len()) {
            var bt: string = p.punct_at(i);
            if (bt == "{") { bdepth = bdepth + 1; }
            else if (bt == "}") {
                bdepth = bdepth - 1;
                if (bdepth == 0) { i = i + 1; break; }
            }
            i = i + 1;
        }
    }
    return p.keyword_at(i) == "else";
}

// arrow_lambda_at reports whether the cursor (sitting on `(`) begins an
// arrow lambda — `() => …`, `(): R => …`, or `(IDENT: TYPE, …) [: R] => …`
// — as opposed to a grouping `(e)` or tuple `(e0, e1)`. The disambiguator
// (ported from the native parser's looksLikeArrowLambda, #2701): an arrow
// lambda's parens are empty or start with a typed param `IDENT :`, which an
// expression never does, and the matching `)` is followed by `=>` or `:`
// (the return-type colon). It scans to the balanced `)` and checks the
// token after it.
function (p: Par) arrow_lambda_at(): boolean {
    // p.pos is at "(".
    var open: i32 = p.pos;
    // Empty params: `(` `)` then `=>` / `:`.
    if (p.punct_at(open + 1) == ")") {
        var after: string = p.punct_at(open + 2);
        return after == "=>" || after == ":";
    }
    // Tuple-destructuring first param: `((a, b): (T, U), …) => …`.
    // After the outer `(` comes an inner `( IDENT` binding list whose
    // matching `)` is immediately followed by `:` — a shape no
    // expression has (`((a, b), c)` / `((a + b) * c)` never put a `:`
    // after the inner close). Scan the inner parens to check, then
    // fall through to the outer-paren scan below.
    if (p.punct_at(open + 1) == "(" && p.ident_at(open + 2).len() > 0) {
        var idepth: i32 = 0;
        var k: i32 = open + 1;
        var inner_ok: boolean = false;
        var scanning: boolean = true;
        while (scanning && k < p.toks.len()) {
            var ipk: string = p.punct_at(k);
            if (ipk == "(") { idepth = idepth + 1; }
            else if (ipk == ")") {
                idepth = idepth - 1;
                if (idepth == 0) {
                    inner_ok = p.punct_at(k + 1) == ":";
                    scanning = false;
                }
            }
            if (scanning) { k = k + 1; }
        }
        if (!inner_ok) { return false; }
    } else if (p.ident_at(open + 1).len() == 0 || p.punct_at(open + 2) != ":") {
        // Non-empty: must otherwise start with a typed param `IDENT :`.
        return false;
    }
    // Scan to the matching `)` and check the token after it.
    var depth: i32 = 0;
    var j: i32 = open;
    while (j < p.toks.len()) {
        var pk: string = p.punct_at(j);
        if (pk == "(") {
            depth = depth + 1;
        } else if (pk == ")") {
            depth = depth - 1;
            if (depth == 0) {
                var aft: string = p.punct_at(j + 1);
                return aft == "=>" || aft == ":";
            }
        }
        j = j + 1;
    }
    return false;
}

// parse_arrow_lambda parses `(params) [: R] => expr` into an ExprLambda
// whose body is the single statement `[return expr]` — exactly the AST the
// verbose `function (params): R { return expr; }` form produces, so the
// lambda-lift + IR-lowering machinery handles it with no further changes.
// The cursor is on the opening `(`. Parameter types are required (as in the
// verbose form); the return type is optional. Ported from the native
// parser's parseArrowLambda (#2701).
function parse_arrow_lambda(p: Par): (Expr, Par) {
    p = p.advance();  // consume `(`
    var params: ParamDecl[] = [];
    var apd_names: string[] = [];
    var apd_synths: string[] = [];
    var apd_lines: i32[] = [];
    var apd_cols: i32[] = [];
    if (p.peek_punct() != ")") {
        while (true) {
            if (p.peek_punct() == "(") {
                var (atpr_param, atpr_destr_names, atpr_line, atpr_col, atpr_p) = parse_tuple_param(p);
                p = atpr_p;
                if (atpr_destr_names.len() == 0) {
                    return (e_unknown("lambda: bad tuple param"), p);
                }
                params = params.append(atpr_param);
                apd_names = apd_names.append(atpr_destr_names);
                apd_synths = apd_synths.append(atpr_param.name);
                apd_lines = apd_lines.append(atpr_line);
                apd_cols = apd_cols.append(atpr_col);
                if (p.peek_punct() == ",") {
                    p = p.advance();
                    if (p.peek_punct() == ")") { break; }
                    continue;
                }
                break;
            }
            var (pr_param, pr_p) = parse_param(p);
            p = pr_p;
            params = params.append(pr_param);
            // A trailing comma before `)` must not start another parameter —
            // parse_param returns its empty sentinel for `)`, and appending that
            // gives the function one phantom nameless param. Harmless-looking on a
            // register backend, fatal on wasm, where a function's arity is
            // DECLARED: `(n: i32,) => n * 2` hoisted `$__lam_0` with two params and
            // the one-argument call site underflowed the stack (#6354). Mirrors the
            // struct-field and struct-literal parsers, which have guarded this
            // since they were written.
            if (p.peek_punct() == ",") {
                p = p.advance();
                if (p.peek_punct() == ")") { break; }
                continue;
            }
            break;
        }
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    var ret_type: string = "";
    if (p.peek_punct() == ":") {
        p = p.advance();
        var (rtr_name, rtr_ret_arr, rtr_fn_ret, rtr_p) = parse_type_name(p);
        p = rtr_p;
        ret_type = rtr_name;
    }
    if (p.peek_punct() == "=>") { p = p.advance(); }
    var (ber_expr, ber_p) = parse_expr(p);
    p = ber_p;
    var body: Stmt[] = [s_return(ber_expr)];
    body = prepend_param_destrs(body, apd_names, apd_synths, apd_lines, apd_cols);
    return parse_postfix(p, e_lambda(params, ret_type, body));
}

// Parse results are `(parsed_thing…, Par)` tuple returns — both pieces
// of the value + new-parser pair threaded through recursive-descent
// (docs/CURSOR-IDIOM.md). Avoids a stateful `var p: Par` shared across
// helpers.

// map_key_kind_of_expr classifies a map-literal KEY as 1 (integer-keyed),
// 0 (string-keyed) or -1 (undecidable) by walking down to its leftmost
// literal leaf. A key is rarely a bare literal — `(1 + 1)`, `(560 | (x <<|
// 6))` and `-3` all reach a decisive leaf one or two nodes down — and the
// leftmost operand is the one that fixes the type of an arithmetic or
// concatenation chain.
//
// Only a leaf can decide. An identifier, a call or an `if` expression is
// genuinely unclassifiable here: the parser has no types, which is the root
// of why this decision is awkward in the first place (the native compiler
// keeps a typed `ast.MapLit` and lets the checker answer). Those return -1.
// Where the literal initializes an ANNOTATED binding, parse_map_lit takes the
// key kind straight off the declaration (Par.map_kind) and never asks this.
// This is the fallback for every other position.
function map_key_kind_of_expr(e: Expr): i32 {
    match (e) {
        ExprNumber(_) => { return 1; },
        ExprString(_) => { return 0; },
        ExprBinary(b) => { return map_key_kind_of_expr(b.left); },
        ExprUnary(u) => {
            // An `as <type>` cast (op "as_<type>") is DECISIVE on its target,
            // whatever the operand is — `(f(x) >> 32u64) as i32` is an integer
            // key even though nothing below the cast can be classified. Reading
            // the target rather than recursing into the operand mirrors
            // mono_infer, which already treats casts this way; recursing was
            // what left a generated map keyed entirely on casts and
            // if-expressions still falling back to the string constructor after
            // the first #6207 fix.
            if (u.op.len() > 3 && u.op[0:3] == "as_") {
                if (u.op[3:u.op.len()] == "string") { return 0; }
                return 1;
            }
            return map_key_kind_of_expr(u.operand);
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

// parse_map_lit parses a map literal `Map { k0: v0, k1: v1, … }` (the
// cursor is on the opening `{`) and desugars it to a chained
// `map_new[_i32](n).insert(k0,v0).insert(k1,v1)…` — insert returns the map, so
// the whole thing is one expression. The constructor carries the KEY KIND,
// which the chained .set dispatch reads back to pick the right key compare.
//
// This used to match the FIRST key against `ExprNumber` and nothing else, so
// every non-literal key — including `(1 + 1)` — fell through to map_new, the
// STRING constructor. An i32-keyed map then built itself as string-keyed and
// __fern_map_set compared its integer keys through __fern_str_eq, dereferencing
// them as pointers: a SIGSEGV at construction, with no read of the map
// anywhere (#6207). One computed key merely mistyped the map silently; two
// reached the compare.
//
// The key walk below is the guess of last resort. A `var m: Map[K, V] = …`
// declaration answers the same question exactly and arrives as Par.map_kind,
// which takes precedence where it is set.
function parse_map_lit(p: Par): (Expr, Par) {
    // Take the declaration's answer for THIS literal, then clear it: a
    // `Map[string, i32]` literal appearing as a VALUE inside a `Map[i32, …]`
    // literal must not inherit the outer key kind, which would reintroduce
    // this bug in a rarer shape.
    var want_kk: i32 = p.map_kind;
    var mline: i32 = p.peek_line();
    var mcol: i32 = p.peek_col();
    p = p.with_map_kind(0 - 1).advance();   // consume `{`
    var mlk: Expr[] = [];
    var mlv: Expr[] = [];
    if (p.peek_punct() != "}") {
        while (true) {
            var (mke_expr, mke_p) = parse_expr(p);
            p = mke_p;
            if (p.peek_punct() == ":") { p = p.advance(); }
            var (mve_expr, mve_p) = parse_expr(p);
            p = mve_p;
            mlk = mlk.append(mke_expr);
            mlv = mlv.append(mve_expr);
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    if (p.verbatim) { return parse_postfix(p, ExprMapLit { keys: mlk, vals: mlv, line: mline, col: mcol }); }
    // The first key that CAN be classified decides, rather than the first key
    // full stop: keys are homogeneous, so a later decisive one describes the
    // map just as well as the first, and consulting it costs nothing. Only an
    // all-undecidable key set (identifiers, calls) still falls back to
    // map_new — the case the parser cannot answer without types.
    var kk: i32 = want_kk;
    var kki: i32 = 0;
    while (kki < mlk.len()) {
        if (kk < 0) { kk = map_key_kind_of_expr(mlk[kki]); }
        kki = kki + 1;
    }
    var ctor: string = if (kk == 1) { "map_new_i32" } else { "map_new" };
    var cargs: Expr[] = [];
    cargs = cargs.append(e_number("8", "", false));
    var mbase: Expr = e_call(e_ident(ctor), cargs);
    var mpi: i32 = 0;
    while (mpi < mlk.len()) {
        var sargs: Expr[] = [];
        sargs = sargs.append(mlk[mpi]);
        sargs = sargs.append(mlv[mpi]);
        mbase = e_call(e_field_access(mbase, "insert"), sargs);
        mpi = mpi + 1;
    }
    return parse_postfix(p, mbase);
}

// map_ann_key_kind reads a map DECLARATION's key kind out of its type
// annotation — 1 for `Map[i32, …]`, 0 for `Map[string, …]`, -1 for anything
// else (not a map, or a struct/enum key, which map_new/map_new_i32 cannot
// spell — those keep whatever the construction site chose). The "i32," /
// "string," spelling is parse_type_name's canonical join (", " between
// generic args, no space after `[`); irlower's annotated-`map_new` path
// matches the same two prefixes.
function map_ann_key_kind(t: string): i32 {
    if (t.len() < 5 || t[0:4] != "Map[") { return 0 - 1; }
    var inner: str = t[4 : t.len()];
    if (inner.len() >= 4 && inner[0:4] == "i32,") { return 1; }
    if (inner.len() >= 7 && inner[0:7] == "string,") { return 0; }
    return 0 - 1;
}

// parse_struct_lit_body parses `{ f: v, … }` (the cursor is on the
// opening `{`) and returns an ExprStructLit with the given
// type_name. Shared by the bare-ident struct literal in
// parse_primary and the qualified `pkg.Type { … }` form in
// parse_postfix.
function parse_struct_lit_body(p: Par, type_name: string, sline: i32, scol: i32): (Expr, Par) {
    p = p.advance();  // consume `{`
    var fnames: string[] = [];
    var fvals: Expr[] = [];
    // Struct-update `Name { ...base, field: value }`: a leading
    // `...base` spread copies the un-overridden fields from `base`,
    // the listed fields override. `...base` must be first. With no
    // overrides (`Name { ...base }`) it's a legal pure copy.
    var has_base: boolean = false;
    var base: Expr = e_unknown("no-base");
    if (p.peek_punct() == "...") {
        p = p.advance();
        var (br_expr, br_p) = parse_expr(p);
        p = br_p;
        has_base = true;
        base = br_expr;
        if (p.peek_punct() == ",") {
            p = p.advance();
        } else {
            // No overrides — expect the closing brace (pure copy).
            if (p.peek_punct() != "}") {
                return (e_unknown("missing } in struct update"), p);
            }
            p = p.advance();
            return (e_struct_update(type_name, fnames, fvals, base, sline, scol), p);
        }
    }
    if (p.peek_punct() != "}") {
        while (true) {
            var fn: string = p.peek_ident();
            if (fn.len() == 0) {
                return (e_unknown("missing field name in struct lit"), p);
            }
            p = p.advance();
            if (p.peek_punct() != ":") {
                return (e_unknown("missing : in struct lit"), p);
            }
            p = p.advance();
            var (fv_expr, fv_p) = parse_expr(p);
            p = fv_p;
            fnames = fnames.append(fn);
            fvals = fvals.append(fv_expr);
            if (p.peek_punct() == ",") {
                p = p.advance();
                // Trailing comma before the closing brace is allowed
                // (std/test's TestRunner literals use it).
                if (p.peek_punct() == "}") { break; }
                continue;
            }
            break;
        }
    }
    if (p.peek_punct() != "}") {
        return (e_unknown("missing } in struct lit"), p);
    }
    p = p.advance();
    if (has_base) {
        return (e_struct_update(type_name, fnames, fvals, base, sline, scol), p);
    }
    return (e_struct_lit(type_name, fnames, fvals, sline, scol), p);
}

// parse_postfix runs the chained-postfix loop on a base
// expression. Handles call (`(args)`), index / slice (`[i]`,
// `[i:j]`), and field access (`.name` / `.0`). Returns when
// the next token isn't one of these. Used by parse_primary
// to share the loop across multiple base shapes — ident
// chains, parenthesised exprs, tuple / array literals.
// scan_written_type_args reconstructs a `[T1, T2, …]` instantiation as written.
// The cursor sits just past the `[` and is left on the matching `]`. Each
// argument goes through parse_type_name, so the spelling is the type grammar's
// own — which under `-fmt` keeps `str`, `[T]` and fn types as the author wrote
// them. A count of 0 means the brackets do not hold a type list; the cursor is
// then wherever the attempt stopped and the caller must restore it.
function scan_written_type_args(p: Par): (string, i32, Par) {
    var out: string = "";
    var n: i32 = 0;
    while (true) {
        var (tn, tn_arr, tn_fnret, tn_p) = parse_type_name(p);
        if (tn.len() == 0) { return ("", 0, p); }
        p = tn_p;
        if (n > 0) { out = out + ", "; }
        out = out + tn;
        n = n + 1;
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() != "]") { return ("", 0, p); }
    return (out, n, p);
}

// with_written_type_args spells a call's explicit instantiation onto the callee's
// written name — `empty` + `[i32]` for `empty[i32]()`, the method's field name
// for a receiver call. Formatter-only: the compile parse erases type args to
// their count, and no consumer reads a name back apart from the printer.
function with_written_type_args(callee: Expr, args: string): Expr {
    match (callee) {
        ExprIdent(id) => { return ExprIdent { name: id.name + "[" + args + "]", line: id.line, col: id.col }; },
        ExprFieldAccess(fa) => { return ExprFieldAccess { obj: fa.obj, field: fa.field + "[" + args + "]", line: fa.line, col: fa.col, ty: fa.ty }; },
        _ => { return callee; }
    }
    return callee;
}

function parse_postfix(p: Par, base: Expr): (Expr, Par) {
    // Carries the explicit type-argument count from a `[...]` instantiation to
    // the call `(...)` that immediately follows (`f[i32](x)`), so the call node
    // records it for the E040 arity check. Reset after each call.
    var pending_type_argc: i32 = 0;
    // The same instantiation AS WRITTEN, for `-fmt` only (Par.verbatim). The
    // count alone cannot be printed, so a formatted `empty[i32]()` came back as
    // `empty()` — E040, the formatter deleting the syntax the diagnostic asks
    // for. Attached to the callee's written name rather than to a new ExprCall
    // field, the way parse_type_name carries a bound's args on the type name.
    var pending_type_args: string = "";
    while (true) {
        var pk: string = p.peek_punct();
        if (pk == "(") {
            // The Go parser positions a Call at its opening paren
            // (`Call{P: open.Pos}`), so E004 (arity) lands here.
            var oline: i32 = p.peek_line();
            var ocol: i32 = p.peek_col();
            p = p.advance();
            var args: Expr[] = [];
            if (p.peek_punct() != ")") {
                while (true) {
                    // Named argument `name = value`: an IDENT immediately
                    // followed by a single `=` (peek2 is exactly "=", never
                    // "==" / "=>"). Encode it as a synthetic
                    // `ExprBinary("__named_arg", <name ident>, value)` marker;
                    // fill_default_args_module reorders these into positional
                    // order against the callee's params and fills omitted
                    // defaults, mirroring the native `defaultargs` pass. Without
                    // this, parse_expr reads `name` as a bare value and stops at
                    // `=`, breaking the call.
                    var an: string = p.peek_ident();
                    if (an.len() > 0 && p.peek2_punct() == "=") {
                        var aline: i32 = p.peek_line();
                        var acol: i32 = p.peek_col();
                        p = p.advance();   // consume the parameter name
                        p = p.advance();   // consume `=`
                        var (rv_expr, rv_p) = parse_expr(p);
                        p = rv_p;
                        args = args.append(ExprBinary { op: "__named_arg", left: ExprIdent { name: an, line: aline, col: acol }, right: rv_expr, line: aline, col: acol });
                    } else {
                        var (ra_expr, ra_p) = parse_expr(p);
                        p = ra_p;
                        args = args.append(ra_expr);
                    }
                    var (ca_more, ca_p) = p.more_elems(")");
                    p = ca_p;
                    if (ca_more) { continue; }
                    break;
                }
            }
            if (p.peek_punct() != ")") {
                return (e_unknown("missing ) in call"), p);
            }
            p = p.advance();
            if (pending_type_args.len() > 0) { base = with_written_type_args(base, pending_type_args); }
            base = ExprCall { callee: base, args: args, line: oline, col: ocol, type_argc: pending_type_argc, ty: "" };
            base = maybe_desugar_array_build(base);
            base = maybe_desugar_map_build(base);
            pending_type_argc = 0;
            pending_type_args = "";
        } else if (pk == "[") {
            p = p.advance();
            // Leading-colon slice `a[:hi]` (low implicitly 0), mirroring the
            // Go parseCall's `[:b]` form. The `:` isn't a value expression, so
            // without handling it here the type-arg probe below would misread
            // `:hi` as erased type args and drop the slice (#4339). `a[:]` is
            // the full slice `[0:len]`.
            if (p.peek_punct() == ":") {
                p = p.advance(); // consume `:`
                // Low bound is a literal 0. Inlined (not bound to a local)
                // because the checker mishandles `var x: Expr = e_number(...)`
                // here but accepts e_number inline as a call argument.
                if (p.peek_punct() == "]") {
                    p = p.advance();
                    base = e_slice(base, e_number("0", "", false), e_call(e_field_access(base, "len"), []));
                    continue;
                }
                var (shi_expr, shi_p) = parse_expr(p);
                p = shi_p;
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in slice"), p);
                }
                p = p.advance();
                base = e_slice(base, e_number("0", "", false), shi_expr);
                continue;
            }
            // Generic instantiation `f[i32](…)` / `Box[T] { … }`: the
            // bracket holds type arguments, not a value index. Detect it by
            // probing parse_expr — if it makes no progress (a type keyword
            // like `i32` isn't a value expression), skip to the matching
            // `]` and erase the type args, leaving `base` unchanged.
            var idxStart: i32 = p.pos;
            var (idx_expr, idx_p) = parse_expr(p);
            if (idx_p.pos == idxStart) {
                // `-fmt` reads the arguments back out as types before the skip
                // loop erases them. On anything the type grammar does not accept
                // the cursor is restored and the erasing walk below runs as it
                // always did, so a shape only the compile path understands cannot
                // desync the parse.
                if (p.verbatim) {
                    var ta_save: Par = p;
                    var (wta_text, wta_n, wta_p) = scan_written_type_args(p);
                    if (wta_n > 0) {
                        pending_type_args = wta_text;
                        pending_type_argc = wta_n;
                        p = wta_p;
                    } else {
                        p = ta_save;
                    }
                }
                // Count the top-level (comma-separated) type arguments while
                // skipping them, tracking nested `[...]` depth so a comma
                // inside `Map[K, V]` doesn't inflate the count.
                var ta_depth: i32 = 0;
                var ta_saw: boolean = false;
                var ta_commas: i32 = 0;
                while (!p.at_end()) {
                    var tp2: string = p.peek_punct();
                    if (tp2 == "]" && ta_depth == 0) { break; }
                    if (tp2 == "[") { ta_depth = ta_depth + 1; }
                    if (tp2 == "]") { ta_depth = ta_depth - 1; }
                    if (tp2 == "," && ta_depth == 0) { ta_commas = ta_commas + 1; }
                    ta_saw = true;
                    p = p.advance();
                }
                if (ta_saw) { pending_type_argc = ta_commas + 1; }
                if (p.peek_punct() == "]") { p = p.advance(); }
                // `Name[T] { … }` — a generic struct construction: the
                // erased base is the struct name; parse the literal body.
                if (p.peek_punct() == "{") {
                    match (base) {
                        ExprIdent(bid) => {
                            // The written instantiation rides on the literal's
                            // type name under `-fmt`: dropping it re-infers the
                            // literal, so `Box[i64] { val: 42 }` came back as
                            // `Box { val: 42 }` and quietly became `Box[i32]`.
                            var glit_name: string = bid.name;
                            if (pending_type_args.len() > 0) { glit_name = glit_name + "[" + pending_type_args + "]"; }
                            var (glit_expr, glit_p) = parse_struct_lit_body(p, glit_name, 0, 0);
                            p = glit_p;
                            base = glit_expr;
                            pending_type_argc = 0;
                            pending_type_args = "";
                        },
                        _ => {},
                    }
                }
                continue;
            }
            p = idx_p;
            if (p.peek_punct() == ":") {
                p = p.advance();
                // Open-ended high bound `a[lo:]` — the end defaults to the
                // source length, mirroring the Go parser's nil `High`. We
                // synthesise `base.len()` inline (no new Expr-typed local,
                // which the checker mis-resolves in this nested scope) so
                // every downstream consumer — checker, the three AST
                // emitters, and SSA build_func — sees a real i32 end rather
                // than the `ExprUnknown` placeholder they each mistranslate.
                if (p.peek_punct() == "]") {
                    p = p.advance();
                    base = e_slice(base, idx_expr, e_call(e_field_access(base, "len"), []));
                    continue;
                }
                var (end_expr, end_p) = parse_expr(p);
                p = end_p;
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in slice"), p);
                }
                p = p.advance();
                base = e_slice(base, idx_expr, end_expr);
            } else {
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in index"), p);
                }
                p = p.advance();
                base = e_index(base, idx_expr);
            }
        } else if (pk == ".") {
            // Field access `obj.field`. Field is either an
            // ident (struct field) or a numeric literal
            // (tuple index — `.0`, `.1`, …). Both shapes
            // store the field name as a bare string.
            // The Go parser positions a FieldAccess at its dot
            // (`FieldAccess{P: dot.Pos}`), so E043 / E046 land there.
            var dline: i32 = p.peek_line();
            var dcol: i32 = p.peek_col();
            p = p.advance();
            var fname: string = p.peek_member_name();
            if (fname.len() == 0) {
                match (p.peek()) {
                    lexer.TokNumber(n) => { fname = n.text; },
                    _ => { }
                }
            }
            if (fname.len() == 0) {
                return (e_unknown("missing field name after ."), p);
            }
            p = p.advance();
            // Qualified struct literal: `pkg.Type { f: v, … }`. Only
            // when the base is a bare (module) ident and a struct-lit
            // `{` follows — same look-ahead guard parse_primary uses
            // for bare `Name { … }` so it doesn't swallow a
            // `for x in pkg.iter { body }` block. flatten.fern
            // reconstructs parser AST nodes this way
            // (`parser.ExprBinary { … }`), so the self-host parser
            // must accept it to parse its own source.
            var qname: string = "";
            match (base) {
                ExprIdent(qid) => { qname = qid.name; },
                _ => { }
            }
            var qstruct_ok: boolean = false;
            if (qname.len() > 0 && !p.no_struct && p.peek_punct() == "{") {
                var qlook: Par = p.advance();
                if (qlook.peek_punct() == "}") {
                    qstruct_ok = true;
                } else if (qlook.peek_punct() == "...") {
                    // Struct-update spread: `pkg.Type { ...base, f: v }`.
                    // Mirrors the bare-ident look-ahead below; without
                    // this the `...` falls through to a field access and
                    // the `{ … }` is mis-parsed (a qualified-type spread
                    // such as `asmcore.EmitState { ...s, … }`).
                    qstruct_ok = true;
                } else if ((qlook.peek_ident()).len() > 0) {
                    var qlook2: Par = qlook.advance();
                    if (qlook2.peek_punct() == ":") { qstruct_ok = true; }
                }
            }
            if (qstruct_ok) {
                var (qr_expr, qr_p) = parse_struct_lit_body(p, qname + "." + fname, 0, 0);
                p = qr_p;
                base = qr_expr;
            } else {
                base = e_field_access_at(base, fname, dline, dcol);
            }
        } else if (p.peek_keyword() == "as") {
            // `expr as Type` cast. Desugar to a unary op
            // `as_<Type>` (operand = base); the emitter masks /
            // sign-extends per the target integer width (see
            // asm.fern). Modelling it as a unary keeps `base` in
            // argument position — the checker mishandles `Expr`
            // identity for a reassigned local in var-decl / array-
            // push position but accepts it as a function argument
            // (cf. e_call(base, …) above). Without this branch the
            // parser would stall on the `as` keyword.
            var asline: i32 = p.peek_line();
            var ascol: i32 = p.peek_col();
            p = p.advance();
            // `expr as? Type` downcast (docs/DYN-TRAITS.md §9): an `as`
            // immediately followed by `?` is the fallible `dyn Trait`
            // downcast, NOT the numeric/ascription cast. Disambiguate by
            // peeking the `?` here and tagging the unary op `as?_<Type>`
            // (vs the plain `as_<Type>`); irlower lowers it to a shape
            // read + compare yielding Option[T]. Consume the `?` now so it
            // binds to `as` and isn't mis-read as the postfix `?` try op.
            var is_downcast: boolean = false;
            if (p.peek_punct() == "?") { is_downcast = true; p = p.advance(); }
            // Read the full target type spelling via parse_type_name so the
            // cast op name carries any generic args / array `[]` / qualified
            // `pkg.Type` suffix (`e as i32[]` → `as_i32[]`, `e as Option[i32]`
            // → `as_Option[i32]`) instead of stalling on the brackets or
            // mis-reading them as a postfix index. Earlier this dropped the
            // generic args, so a binding `var x = None as Option[i32]` rebound
            // to the payload-less `var x: Option = None` — which the self-host
            // IR path can't size (a bare `None` has no statically-known payload
            // type), bailing the whole module to the AST backend (#2669). The
            // generic suffix only matters for a payload-less operand like
            // `None` (a `Some(e)` / `[e]` operand carries its own type), but
            // preserving it is uniformly correct and the cast still lowers as a
            // zero-cost identity. Numeric targets (`as i32`, `as f64`) come
            // back as the bare name, so is_numeric_cast_op still recognises
            // them. parse_type_name also folds a trailing `[]` and a qualified
            // `pkg.Type` chain the old single-ident read left on the cursor.
            var (castty_name, castty_ret_arr, castty_fn_ret, castty_p) = parse_type_name(p);
            p = castty_p;
            var tyname: string = castty_name;
            if (is_downcast) { base = e_unary_at("as?_" + tyname, base, asline, ascol); }
            else { base = e_unary_at("as_" + tyname, base, asline, ascol); }
        } else if (p.peek_punct() == "?") {
            // `expr?` try operator. Desugar to the unary op `try_`
            // (operand = base); the emitter unwraps a Some/Ok payload
            // or early-returns the None/Err box from the enclosing
            // (Option/Result-returning) function. Stamp the `?` token's
            // position so the E042 diagnostics anchor where native does.
            var qline: i32 = p.peek_line();
            var qcol: i32 = p.peek_col();
            p = p.advance();
            base = e_unary_at("try_", base, qline, qcol);
        } else {
            break;
        }
    }
    return (base, p);
}

// parse_expr_from_text re-lexes + parses an f-string interpolant's
// raw text into an Expr. The lexer already isolated the interpolant
// (balanced braces, inner string literals skipped), so a fresh
// tokenize + parse_expr round-trip recovers the AST. Mirrors the Go
// parser's parseExprFromText.
//
// `base_line` / `base_col` are where `text` starts in the enclosing
// file. The re-lex numbers `text` from 1:1, so the tokens are rebased
// before parsing and every node the parse produces names the file.
function parse_expr_from_text(text: string, base_line: i32, base_col: i32): Expr {
    var toks: lexer.Token[] = lexer.rebase_tokens(lexer.tokenize(text), base_line, base_col);
    var sub: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: false };
    var (r_expr, r_p) = parse_expr(sub);
    return r_expr;
}

// parse_primary: number, ident (which may extend to call), string,
// bool, parenthesised expr, unknown otherwise.
function parse_primary(p: Par): (Expr, Par) {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokNumber(x) => {
            var nline: i32 = p.peek_line();
            var ncol: i32 = p.peek_col();
            p = p.advance();
            // Range-check a float literal where the token becomes a value, the
            // same point the Go parser hands the text to strconv.ParseFloat: a
            // magnitude f64 cannot hold is P002 on both engines, not a silent
            // +Inf (#6842). The rejection rides an ExprUnknown, since the parser
            // has no error list, and still goes through parse_postfix so token
            // consumption is unchanged.
            // `-fmt` opts out (Par.verbatim): a reformat must return the text it
            // was given, and the marker replaces the literal, so keeping the
            // check here would print the program's number away.
            if (!p.verbatim && x.is_float && util.f64_lit_out_of_range(x.text)) {
                return parse_postfix(p, e_unknown_at(util.f64_range_kind(x.text), nline, ncol));
            }
            // Route through parse_postfix so a numeric primary can
            // carry a trailing `as Type` cast (e.g. `15 as u8`).
            if (x.raw.len() > 0) {
                return parse_postfix(p, e_quoted_at(x.text, x.suffix, x.raw, nline, ncol));
            }
            return parse_postfix(p, e_number_at(x.text, x.suffix, x.is_float, nline, ncol));
        },
        lexer.TokString(x) => {
            var sline: i32 = p.peek_line();
            var scol: i32 = p.peek_col();
            p = p.advance();
            // Allow postfix chains on string literals — e.g.
            // `"a,b,c".split(",")`. Without parse_postfix the
            // `.split` would dangle and the surrounding caller
            // would treat the literal as the whole expression.
            return parse_postfix(p, e_string_at(x.value, sline, scol));
        },
        lexer.TokKeyword(x) => {
            if (x.name == "true") {
                p = p.advance();
                // Route through parse_postfix like the number / string literal
                // arms so a postfix chain on a bool literal (`true.to_i()`) is
                // parsed, not silently dropped (#4338).
                return parse_postfix(p, e_bool(true));
            }
            if (x.name == "false") {
                p = p.advance();
                return parse_postfix(p, e_bool(false));
            }
            if (x.name == "function") {
                // Anonymous function expression: `function (a:
                // T, …): RT { body }`. Same grammar as the
                // top-level FuncDecl minus the name and the
                // optional receiver clause.
                p = p.advance();  // consume `function`
                if (p.peek_punct() != "(") {
                    return (e_unknown("lambda: missing ("), p);
                }
                p = p.advance();
                var params: ParamDecl[] = [];
                var lpd_names: string[] = [];
                var lpd_synths: string[] = [];
                var lpd_lines: i32[] = [];
                var lpd_cols: i32[] = [];
                if (p.peek_punct() != ")") {
                    while (true) {
                        if (p.peek_punct() == "(") {
                            var (ltpr_param, ltpr_destr_names, ltpr_line, ltpr_col, ltpr_p) = parse_tuple_param(p);
                            p = ltpr_p;
                            if (ltpr_destr_names.len() == 0) {
                                return (e_unknown("lambda: bad tuple param"), p);
                            }
                            params = params.append(ltpr_param);
                            lpd_names = lpd_names.append(ltpr_destr_names);
                            lpd_synths = lpd_synths.append(ltpr_param.name);
                            lpd_lines = lpd_lines.append(ltpr_line);
                            lpd_cols = lpd_cols.append(ltpr_col);
                            if (p.peek_punct() == ",") {
                                p = p.advance();
                                if (p.peek_punct() == ")") { break; }
                                continue;
                            }
                            break;
                        }
                        var (pr_param, pr_p) = parse_param(p);
                        p = pr_p;
                        params = params.append(pr_param);
                        // Trailing comma before `)` — see the note in the arrow-lambda
                        // parameter loop (#6354).
                        if (p.peek_punct() == ",") {
                            p = p.advance();
                            if (p.peek_punct() == ")") { break; }
                            continue;
                        }
                        break;
                    }
                }
                if (p.peek_punct() == ")") { p = p.advance(); }
                var lret: string = "";
                if (p.peek_punct() == ":") {
                    p = p.advance();
                    var (ltr_name, ltr_ret_arr, ltr_fn_ret, ltr_p) = parse_type_name(p);
                    p = ltr_p;
                    lret = ltr_name;
                }
                var (lblk_body, lblk_p) = parse_block(p);
                p = lblk_p;
                var lbody: Stmt[] = prepend_param_destrs(lblk_body, lpd_names, lpd_synths, lpd_lines, lpd_cols);
                return parse_postfix(p, e_lambda(params, lret, lbody));
            }
            if (x.name == "match") {
                // match-expression in value position: desugar to an
                // immediately-invoked closure wrapping a statement-match whose
                // arms `return` (see parse_match_expr), reusing the existing
                // match + lambda codegen. Route through parse_postfix so
                // `(match …).method()` chains.
                var mc: IfChain = parse_match_expr(p);
                var mno_params: ParamDecl[] = [];
                var mlam_body: Stmt[] = [mc.stmt];
                // The tuple / struct desugars carry their value in a LOCAL (their
                // arm bodies assign to it, see IfChain.value_local) — declare it
                // ahead of the chain and return it after, so the IIFE has exactly
                // one terminal return and lower_value_block treats it as the
                // block's value instead of letting an arm's `return` escape.
                if (mc.value_local.len() > 0) {
                    mlam_body = [s_var(mc.value_local, "", zero_expr_for(mc.rt)), mc.stmt, s_return(e_ident(mc.value_local))];
                }
                // A desugar with no terminal return at all gets a synthetic one so
                // the IIFE lambda always returns.
                else if (mc.needs_default_return) { mlam_body = mlam_body.append(s_return(zero_expr_for(mc.rt))); }
                var mno_args: Expr[] = [];
                var miife: Expr = e_call(e_lambda(mno_params, mc.rt, mlam_body), mno_args);
                return parse_postfix(mc.par, miife);
            }
            if (x.name == "if") {
                // if-expression in value position: desugar to an
                // immediately-invoked closure (see parse_if_chain). Route
                // through parse_postfix so `(if …).method()` chains.
                var ic: IfChain = parse_if_chain(p);
                var no_params: ParamDecl[] = [];
                var lam_body: Stmt[] = [ic.stmt];
                var no_args: Expr[] = [];
                var iife: Expr = e_call(e_lambda(no_params, ic.rt, lam_body), no_args);
                return parse_postfix(ic.par, iife);
            }
            // A TYPE keyword used as a MODULE name: `string.repeat_char(…)`
            // imports std/string, whose basename alias `string` collides with the
            // `string` type keyword, so the lexer emits a keyword token, not an
            // ident. When a type keyword is immediately followed by `.`, it is a
            // module-qualified reference base (not a type) — parse it as a bare
            // ident and let parse_postfix handle the `.field(…)` chain;
            // flatten_qualified then rewrites `string.f` -> `string__f`. Without
            // this the keyword fell through to e_unknown and the call never lowered
            // (the native parser already accepts this form). Guarded by the
            // following `.` so a type keyword in any other position is unaffected.
            var is_tykw: boolean = x.name == "string" || x.name == "boolean" || x.name == "void"
                || x.name == "i32" || x.name == "i64"
                || x.name == "u8" || x.name == "u32" || x.name == "u64"
                || x.name == "usize" || x.name == "f32" || x.name == "f64";
            if (is_tykw) {
                var kwline: i32 = p.peek_line();
                var kwcol: i32 = p.peek_col();
                var look: Par = p.advance();
                if (look.peek_punct() == ".") {
                    return parse_postfix(look, e_ident_at(x.name, kwline, kwcol));
                }
            }
            return (e_unknown("keyword:" + x.name), p);
        },
        lexer.TokIdent(x) => {
            var idline: i32 = p.peek_line();
            var idcol: i32 = p.peek_col();
            p = p.advance();
            var base: Expr = e_ident_at(x.name, idline, idcol);
            // Map literal `Map { k0: v0, … }` — parsed in a helper
            // (kept out of this arm so it stays small enough for the
            // backend's branch-displacement limits).
            if (x.name == "Map" && p.peek_punct() == "{") {
                return parse_map_lit(p);
            }
            // Struct literal: `Name { f: v, g: w }`. Only valid
            // when the base is still a bare ident (the struct
            // type's name). Consumes the whole construct;
            // subsequent postfixes (field access, etc.) can
            // chain through the postfix loop. We disambiguate
            // from `for x in Name { body }` (where `Name` is
            // the iter, not a struct-lit type) by peeking two
            // tokens ahead: a real struct-lit is either empty
            // (`{}`) or starts with `Ident :`. Anything else
            // means the `{` belongs to a surrounding block.
            var struct_lit_ok: boolean = false;
            if (!p.no_struct && p.peek_punct() == "{") {
                var look: Par = p.advance();
                if (look.peek_punct() == "}") {
                    struct_lit_ok = true;
                } else if (look.peek_punct() == "...") {
                    // `Name { ...base ... }` — struct-update spread.
                    struct_lit_ok = true;
                } else if ((look.peek_ident()).len() > 0) {
                    var look2: Par = look.advance();
                    if (look2.peek_punct() == ":") { struct_lit_ok = true; }
                }
            }
            if (struct_lit_ok) {
                // Delegate to the shared body parser (same as the qualified
                // `pkg.Type { … }` path at parse_postfix and the generic
                // `Name[T] { … }` path) rather than re-implementing the
                // spread / field / trailing-comma loop inline (SH-040).
                var (slr_expr, slr_p) = parse_struct_lit_body(p, x.name, idline, idcol);
                p = slr_p;
                base = slr_expr;
            }
            return parse_postfix(p, base);
        },
        lexer.TokPunct(x) => {
            if (x.text == "(") {
                // Arrow lambda `(params) [: R] => expr` — a concise anonymous
                // function whose body is a single expression (desugared to
                // `function (params): R { return expr; }`, the same ExprLambda
                // the verbose form produces). Checked before the grouping /
                // tuple parse: an arrow lambda's parens hold a parameter list
                // (`IDENT : TYPE`, or empty), which a grouping (`(e)`) or tuple
                // (`(e0, e1)`) never does. See #2701.
                if (p.arrow_lambda_at()) {
                    return parse_arrow_lambda(p);
                }
                // `(expr)` — grouping. `(e0, e1, …)` — tuple
                // literal. The first expr decides whether we're
                // grouping or building a tuple: a `,` follow-up
                // means tuple; anything else (`)`) means a plain
                // parenthesized expression. Either way the
                // result feeds through the postfix loop so
                // `(a, b).0` and `(f(x)).y` both work.
                var tpl: i32 = p.peek_line();
                var tpc: i32 = p.peek_col();
                p = p.advance();
                // `()` — the unit value (#6040), the sole inhabitant of
                // `void` and the payload of a Result that succeeded with
                // nothing to report (`write_file(...)` → `Ok(())`). It
                // lowers to a constant 0, exactly as the native compiler
                // lowers its UnitLit, so both agree on the payload slot.
                // arrow_lambda_at() already claimed `() => e` above.
                if (p.peek_punct() == ")") {
                    p = p.advance();
                    return parse_postfix(p, e_number_at("0", "", false, tpl, tpc));
                }
                var (inner_expr, inner_p) = parse_expr(p);
                p = inner_p;
                if (p.peek_punct() == ",") {
                    var elems: Expr[] = [];
                    elems = elems.append(inner_expr);
                    while (p.peek_punct() == ",") {
                        p = p.advance();
                        if (p.peek_punct() == ")") { break; }
                        var (er_expr, er_p) = parse_expr(p);
                        p = er_p;
                        elems = elems.append(er_expr);
                    }
                    if (p.peek_punct() == ")") { p = p.advance(); }
                    return parse_postfix(p, e_tuple_at(elems, tpl, tpc));
                }
                if (p.peek_punct() == ")") { p = p.advance(); }
                return parse_postfix(p, inner_expr);
            }
            if (x.text == "[") {
                // Array literal `[e1, e2, e3]`. Empty `[]` allowed.
                p = p.advance();
                var elems: Expr[] = [];
                if (p.peek_punct() != "]") {
                    while (true) {
                        var (er_expr, er_p) = parse_expr(p);
                        p = er_p;
                        elems = elems.append(er_expr);
                        var (ea_more, ea_p) = p.more_elems("]");
                        p = ea_p;
                        if (ea_more) { continue; }
                        break;
                    }
                }
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in array literal"), p);
                }
                p = p.advance();
                return parse_postfix(p, e_array(elems));
            }
            if (x.text == "{" && !p.no_struct) {
                // General value-position block-expression (#4521) — the
                // self-host mirror of the Go parser's parsePrimary `{` case.
                // Reuse parse_branch_body (the if/match value-branch machinery,
                // which already desugars `{ s; …; tail }` to `[<stmts…>,
                // s_return(tail)]`) and wrap it in an immediately-invoked
                // zero-arg lambda, exactly like the if/match value expressions
                // desugar above. Gated on !no_struct like the `Ident { … }`
                // struct-literal case so a loop/if HEADER's trailing `{` still
                // opens the body rather than being consumed here.
                var (bb_body, bb_rt, bb_p) = parse_branch_body(p);
                var bx_params: ParamDecl[] = [];
                var bx_args: Expr[] = [];
                var iife: Expr = e_call(e_lambda(bx_params, bb_rt, bb_body), bx_args);
                return parse_postfix(bb_p, iife);
            }
            if (x.text == "-" || x.text == "!") {
                // The Go parser positions a Unary at its operator token
                // (`Unary{P: op.Pos}`), so E009 (`!`) lands there.
                var uline: i32 = p.peek_line();
                var ucol: i32 = p.peek_col();
                p = p.advance();
                var (operand_expr, operand_p) = parse_primary(p);
                return (e_unary_at(x.text, operand_expr, uline, ucol), operand_p);
            }
            // Unknown leading punct — advance past it so the
            // surrounding parse loop can recover. Skipping the
            // advance would loop forever in parse_program when
            // a stmt has stray trailing punct (e.g. tuple-lit
            // postfix that doesn't pair with the TokIdent's
            // chain loop).
            p = p.advance();
            return (e_unknown("punct:" + x.text), p);
        },
        lexer.TokEof(_) => { return (e_unknown("eof"), p); },
        lexer.TokError(x) => { return (e_unknown("lex error: " + x.msg), p); },
        lexer.TokFString(f) => {
            p = p.advance();
            if (p.verbatim) {
                var vlits: string[] = [];
                var vexprs: Expr[] = [];
                var vflags: boolean[] = [];
                var vi: i32 = 0;
                while (vi < f.parts.len()) {
                    var vpart: lexer.FStringPart = f.parts[vi];
                    vflags = vflags.append(vpart.is_expr);
                    if (vpart.is_expr) {
                        vlits = vlits.append("");
                        vexprs = vexprs.append(parse_expr_from_text(vpart.expr, vpart.line, vpart.col));
                    } else {
                        vlits = vlits.append(vpart.lit);
                        vexprs = vexprs.append(e_unknown("fstring-literal-part"));
                    }
                    vi = vi + 1;
                }
                return parse_postfix(p, ExprFString { lits: vlits, exprs: vexprs, is_expr: vflags, line: f.line, col: f.col });
            }
            // Desugar to a `+`-chain, mirroring the Go checker's
            // FString lowering: literal parts → string literals,
            // interpolant parts → `(<sub-parsed expr>).to_string()`,
            // folded left-to-right. An empty f-string desugars to "".
            var built: Expr = e_string("");
            var has: boolean = false;
            var i: i32 = 0;
            while (i < f.parts.len()) {
                var part: lexer.FStringPart = f.parts[i];
                var piece: Expr = e_string(part.lit);
                if (part.is_expr) {
                    var no_args: Expr[] = [];
                    piece = e_call(e_field_access(parse_expr_from_text(part.expr, part.line, part.col), "to_string"), no_args);
                }
                if (!has) {
                    built = piece;
                    has = true;
                } else {
                    built = e_binary("+", built, piece);
                }
                i = i + 1;
            }
            // Allow postfix chains on the f-string value (`f"...".len()`),
            // consistent with the plain string-literal arm.
            return parse_postfix(p, built);
        }
    }
    return (e_unknown("primary"), p);
}

// precedence: higher binds tighter. Returns -1 for non-binop
// punctuators. Mirrors the Go parser's Pratt-style table.
function precedence(op: string): i32 {
    if (op == "||") { return 1; }
    if (op == "&&") { return 2; }
    if (op == "|") { return 3; }
    if (op == "^") { return 4; }
    if (op == "&") { return 5; }
    if (op == "==" || op == "!=") { return 6; }
    if (op == "<" || op == ">" || op == "<=" || op == ">=") { return 7; }
    if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") { return 8; }
    if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") { return 9; }
    if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") { return 10; }
    return 0 - 1;
}

// parse_binary uses precedence climbing. `min_prec` is the
// minimum precedence the caller will accept — recursively
// climbs while the next operator's prec is >= min_prec.
function parse_binary(p: Par, min_prec: i32): (Expr, Par) {
    var (lhs_expr, lhs_p) = parse_primary(p);
    p = lhs_p;
    while (true) {
        var op: string = p.peek_punct();
        var prec: i32 = precedence(op);
        if (prec < min_prec) { return (lhs_expr, p); }
        // The Go parser positions a Binary at its operator token
        // (`Binary{P: opTok.Pos}`), so E009 / E041 land there.
        var opline: i32 = p.peek_line();
        var opcol: i32 = p.peek_col();
        p = p.advance();
        var (rhs_expr, rhs_p) = parse_binary(p, prec + 1);
        p = rhs_p;
        lhs_expr = e_binary_at(op, lhs_expr, rhs_expr, opline, opcol);
    }
    return (lhs_expr, p);
}

function parse_expr(p: Par): (Expr, Par) {
    return parse_pipe(p);
}

// IfChain carries a parsed if-expression chain: the StmtIf (whose arms
// `return` the branch expressions) plus a return-type tag for the IIFE.
// needs_default_return marks a desugar whose statement (a struct- or tuple-match
// done-flag if-chain) has no guaranteed terminal return, so the wrapping match-
// expression IIFE lambda would fall through without returning and bail lowering
// (unlike the enum StmtMatch / literal `_`-chain forms, which always return).
// The IIFE builder appends a synthetic terminal `return <zero of rt>` when set;
// the arms are exhaustive so it is unreachable, present only to satisfy the
// return checker. Kept false for enum / literal / if-expr so their emit is
// unchanged.
// value_local names the IIFE-body local a desugar STORES its value into
// instead of returning it. The tuple- / struct-pattern desugars splice their
// arm bodies into a `done`-flag if-chain, so an arm's `return E` ends up as a
// plain statement in the IIFE body — and a multi-statement IIFE body lowers
// INLINE (lower_value_block), which means that `return` returned from the
// ENCLOSING function and the match-expression never produced a value at all.
// With value_local set, parse_primary builds the body as
// `[var v = <zero>; <chain>; return v;]`: the chain's arm tails assign, and the
// single terminal return is the block's value. Empty for every other desugar
// (the StmtIf / StmtMatch forms, whose arm returns ARE the value because their
// bodies are single-statement and lower through lower_iife's own rewrites).
pub struct IfChain { par: Par, stmt: Stmt, rt: string, needs_default_return: boolean, value_local: string }

// value_arm_body rewrites a match-EXPRESSION arm body so its value-producing
// terminal `return E` becomes `val = E`. Leading statements are untouched, so
// a user `return` among them still returns from the enclosing function — the
// same rule iife_rewrite_arm_body applies to the StmtMatch form. A body whose
// last statement is not a return (a divergent arm) is left alone; the value
// local keeps its zero.
function value_arm_body(body: Stmt[], val: string): Stmt[] {
    if (body.len() == 0) { return body; }
    match (body[body.len() - 1]) {
        StmtReturn(r) => {
            var out: Stmt[] = [];
            var i: i32 = 0;
            while (i < body.len() - 1) { out = out.append(body[i]); i = i + 1; }
            return out.append(s_assign(val, r.value));
        },
        _ => { return body; }
    }
    return body;
}

// zero_expr_for builds a throwaway value of scalar return-type `rt` for the
// synthetic terminal return above.
//
// A 64-BIT integer width rides on the zero as a literal suffix. The value local
// is declared unannotated, so a bare `var v = 0` gives it an i32 slot and the
// arm store `v = 5000000000i64` then has nowhere to go — the module bails with
// "assignment to `…_r` from number literal". The narrower integer tags need no
// suffix: they already fit the i32 slot. Anything else (rt is whatever
// if_expr_rt read off the first arm, including a literal's own suffix) falls to
// i32 0, which at worst re-bails rather than miscompiling.
function zero_expr_for(rt: string): Expr {
    if (rt == "string") { return e_string(""); }
    if (rt == "bool") { return e_bool(false); }
    if (rt == "f64") { return e_number("0", "", true); }
    if (rt == "i64" || rt == "u64") { return e_number("0", rt, false); }
    return e_number("0", "", false);
}

// if_expr_rt picks a return-type tag for the if-expression's IIFE from
// the then-branch's shape. The IIFE value itself is always correct (an
// 8-byte slot); this tag only labels the result for the rare case of
// dispatching a method directly on an unannotated if-expression.
function if_expr_rt(e: Expr): string {
    match (e) {
        ExprString(_) => { return "string"; },
        ExprBool(_) => { return "bool"; },
        ExprNumber(n) => {
            if (n.is_float) { return "f64"; }
            // A WIDE literal — explicit `i64` / `u64` suffix, or a magnitude past
            // i32-max — names i64. Defaulting it to i32 gave the desugared IIFE a
            // return type its body contradicted, and since that type is non-empty
            // infer_ret_types_module never revisited it: `var w: i64 = (if (c) {
            // 5000000000 } else { … })` bailed the whole module off the IR path.
            //
            // The other branch kinds were already classified, which is why only
            // wide integers were affected — string / bool / f64 branches, i64 branches
            // through an IDENT (the slot carries the width), and an i64 if-expr
            // in `return` position inside an i64 function (the enclosing return
            // type supplies it) all lowered fine. A bare wide literal is the one
            // shape with nothing but this classifier to go on.
            // ANY suffix names the type outright, and must be read BEFORE the
            // magnitude rule below: `2147484197u32` is a u32 that happens to
            // exceed i32-max, so classifying it by magnitude calls it i64 and the
            // IIFE returns the wrong type. `mono_infer` in this file already does
            // exactly this; the two are sibling literal classifiers.
            if (n.suffix.len() > 0) { return n.suffix; }
            if (literal_is_i64(n.text)) { return "i64"; }
            return "i32";
        },
        // A NESTED if / match-EXPRESSION. Both desugar to a 0-arg IIFE over a
        // 0-param lambda whose ret_type this function just computed one level
        // down, so read it back rather than falling through to "i32" — that
        // fall-through is what made nesting lose a width the inner expression
        // had already worked out: `match (…) { Some(v) => v, None => (if (c)
        // { id(803i64) } else { 421i64 }) }` labelled its IIFE i32 and bailed
        // the module, while the same if-expression unnested was fine. Reading
        // the lambda covers a hand-written `(function (): T { … })()` too, where
        // the annotation is the author's. #6276.
        ExprCall(c) => {
            if (c.args.len() != 0) { return "i32"; }
            match (c.callee) {
                ExprLambda(lam) => {
                    if (lam.params.len() == 0 && lam.ret_type.len() > 0) { return lam.ret_type; }
                    return "i32";
                },
                _ => { return "i32"; }
            }
        },
        // ARITHMETIC over the branch value. The comment above says "the other
        // branch kinds were already classified" — a binary was not, so
        // `if (c) { 107u64 / 42u64 } else { … }` labelled its IIFE i32 while the
        // body computed u64. Being non-empty, that tag also stops
        // infer_ret_types_module revisiting the lambda, so nothing downstream
        // can recover the width and the module bails ("did not lower: `return`
        // of binary `/`").
        //
        // A comparison yields a bool whatever its operands are; anything else
        // takes wider_rt of the two sides, the same combination parse_if_chain
        // already applies ACROSS branches, so a width appearing on either side
        // survives.
        ExprBinary(b) => {
            if (irt_is_cmp(b.op)) { return "bool"; }
            return wider_rt(if_expr_rt(b.left), if_expr_rt(b.right));
        },
        _ => { return "i32"; }
    }
}

// wider_rt combines the two branch tags of an if-expression. The branches yield
// ONE value, so one tag has to describe both, and a 64-bit branch is the one
// that cannot be narrowed: declaring i32 over it is the same contradiction
// if_expr_rt was fixed to stop producing. Anything else keeps the then-branch's
// tag, which is what parse_if_chain did unconditionally — it computed the else
// branch's tag and dropped it on the floor, so width appearing only in the else
// branch was still lost (`if (c) { 6 } else { 5000000000 }`).
function wider_rt(a: string, b: string): string {
    if (a == b) { return a; }
    if (a == "i64" || a == "u64") { return a; }
    if (b == "i64" || b == "u64") { return b; }
    return a;
}

// LitArm is one arm of a match on a non-enum (i32 / string) scrutinee:
// a literal to compare against (`lit`, dispatched via `==`) or the `_`
// catch-all (`is_wild`), plus an optional guard and the arm body. The
// match-arm parsers (parse_match_stmt / parse_match_expr) collect these
// only when the first arm is a literal, then hand them to
// build_literal_match instead of emitting a StmtMatch.
// `has_range` marks a range pattern `lo..hi` / `lo..=hi`: `lit` is the low
// bound, `range_hi` the high, and `range_inclusive` picks `..=` (inclusive)
// over `..` (exclusive). build_literal_match lowers it to a bound test
// `scrut >= lo && scrut <op> hi` instead of `scrut == lit`.
pub struct LitArm { is_wild: boolean, lit: Expr, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32, range_hi: Expr, has_range: boolean, range_inclusive: boolean }

// parse_lit_or_range parses a scalar-pattern low bound and, when a `..` /
// `..=` follows, the high bound of a range pattern. Returns (low, high,
// has_range, inclusive, par); high is a dummy when has_range is false.
//
// Bounds parse with parse_binary(p, 4) — min-precedence 4 (just above `|`,
// precedence 3), so a bare `|` is left for the or-pattern splitter
// (parse_lit_alts) rather than being consumed as bitwise-or. A plain literal
// is a primary, so this is byte-identical to the previous min-prec 1 for
// every scalar pattern that doesn't top-level a `|` / `&&` / `||` (none do).
function parse_lit_or_range(p: Par): (Expr, Expr, boolean, boolean, Par) {
    var (lo_expr, lo_p) = parse_binary(p, 4);
    p = lo_p;
    var pk: string = p.peek_punct();
    if (pk == ".." || pk == "..=") {
        p = p.advance();
        var (hi_expr, hi_p) = parse_binary(p, 4);
        p = hi_p;
        return (lo_expr, hi_expr, true, pk == "..=", p);
    }
    return (lo_expr, e_bool(true), false, false, p);
}

// parse_lit_alts parses one-or-more `|`-separated scalar patterns
// (`1 | 2 | 3`, or ranges) sharing a guard + body. Each alternative becomes
// its own LitArm; the parallel arrays run in alternative order.
function parse_lit_alts(p: Par): (Expr[], Expr[], boolean[], boolean[], Par) {
    var lits: Expr[] = [];
    var his: Expr[] = [];
    var hrs: boolean[] = [];
    var incs: boolean[] = [];
    var (l0, h0, hr0, inc0, p0) = parse_lit_or_range(p);
    p = p0;
    lits = lits.append(l0);
    his = his.append(h0);
    hrs = hrs.append(hr0);
    incs = incs.append(inc0);
    while (p.peek_punct() == "|") {
        p = p.advance();
        var (ln, hn, hrn, incn, pn) = parse_lit_or_range(p);
        p = pn;
        lits = lits.append(ln);
        his = his.append(hn);
        hrs = hrs.append(hrn);
        incs = incs.append(incn);
    }
    return (lits, his, hrs, incs, p);
}

// build_literal_match lowers a match on a non-enum scrutinee to a nested
// if/else-if chain — the same shape the native compiler's emitLiteralMatch
// emits. The chain is built
// backwards: the `_` arm's body is the base else; each literal arm wraps
// it as `if (scrut == lit) { body } else { rest }` (a guard folds in as
// `scrut == lit && guard`). The caller only routes here when at least
// one literal arm exists, so the result is always an if statement.
// EXCEPTIONS: two shapes are handed back as a real StmtMatch instead of
// being desugared, because with no StmtMatch left the checker cannot see
// the arms at all — and both are errors it has a rule for.
//
//   * a wildcard `_` that isn't the LAST arm is E026 (native: "wildcard
//     `_` arm must be last"); the backward desugar would silently swallow
//     the unreachable post-`_` arms.
//   * NO unguarded `_` anywhere is E030 — the i32 / string / f64 / boolean
//     domains are open, so native requires the wildcard and
//     scalar_match_exhaustive_diags ports that rule. Desugared, the chain
//     just ends with an empty else, and the arms' `return`s became
//     invisible to the return-path walk: the diagnostic the user got was
//     E052 ("can fall off the end"), naming the wrong problem entirely,
//     and in a void function there was no diagnostic at all (#6683).
//
// The StmtMatch spells the `_` arm as PatWildcard and every literal arm as
// a bare PatVariant("") whose empty type-name the E028 / E015 / union-E030
// checks all skip, so the existing match_diags / block_exits passes emit
// exactly the one code native produces. Neither shape ever type-checks, so
// this StmtMatch never reaches codegen, and a well-formed literal match
// (an unguarded wildcard, last) still desugars unchanged.
function build_literal_match(scrut: Expr, arms: LitArm[], mkline: i32, mkcol: i32): Stmt {
    var wi: i32 = 0;
    var non_last_wild: boolean = false;
    var saw_wild: boolean = false;
    while (wi < arms.len()) {
        // The two questions take DIFFERENT views of a guarded `_ when c`.
        //
        // E026 ("wildcard `_` arm must be last") counts it: native reports the
        // misplaced-wildcard error for any `_` before the end, guard or no
        // guard, and the self-host accepted `_ when c => …, _ => …` outright
        // until this counted it too.
        //
        // Exhaustiveness does not: a guarded `_` may fall through, so only an
        // UNGUARDED one closes the domain and answers E030.
        if (arms[wi].is_wild) {
            if (!arms[wi].has_guard) { saw_wild = true; }
            if (wi < arms.len() - 1) { non_last_wild = true; }
        }
        wi = wi + 1;
    }
    if (non_last_wild || !saw_wild) {
        var marms: MatchArm[] = [];
        var mi: i32 = 0;
        while (mi < arms.len()) {
            var la: LitArm = arms[mi];
            var pat: Pattern = p_variant("", "");
            if (la.is_wild) { pat = p_wildcard(); }
            marms = marms.append(MatchArm { pattern: pat, body: la.body, line: la.line, col: la.col, guard: la.guard, has_guard: la.has_guard });
            mi = mi + 1;
        }
        return s_match_at(scrut, marms, mkline, mkcol);
    }
    var else_body: Stmt[] = [];
    var i: i32 = arms.len() - 1;
    while (i >= 0) {
        var a: LitArm = arms[i];
        if (a.is_wild) {
            if (a.has_guard) {
                else_body = [s_if(a.guard, a.body, else_body)];
            } else {
                else_body = a.body;
            }
        } else {
            var cond: Expr = e_binary("==", scrut, a.lit);
            if (a.has_range) {
                // `lo..hi` / `lo..=hi` → `scrut >= lo && scrut <op> hi`.
                // Built at parse time, so the self-host checker settles the
                // comparison widths — no manual stamping needed (unlike the
                // native IR path).
                var hi_op: string = "<";
                if (a.range_inclusive) { hi_op = "<="; }
                cond = e_binary("&&", e_binary(">=", scrut, a.lit), e_binary(hi_op, scrut, a.range_hi));
            }
            if (a.has_guard) { cond = e_binary("&&", cond, a.guard); }
            else_body = [s_if(cond, a.body, else_body)];
        }
        i = i - 1;
    }
    if (else_body.len() == 0) { return s_unknown("empty literal match"); }
    // The chain replaces the match outright — there is no StmtMatch left — so
    // hang the arms as written off its outermost `if` for `-fmt` (#7072).
    return with_match_sugar(else_body[0], MatchSugar { ...no_match_sugar(), scrut: scrut, lits: arms, line: mkline, col: mkcol });
}

// with_match_sugar records the match a desugar stands in for on the `if` that
// desugar produced. Printer-only: the arms it carries hold the same statement
// objects the chain does, so every other pass reads the chain.
function with_match_sugar(st: Stmt, sugar: MatchSugar): Stmt {
    match (st) {
        StmtIf(i) => { return StmtIf { ...i, sugar: sugar }; },
        _ => { return st; },
    }
}

// ---- Tuple-pattern match (`match (pair) { (0, y) => …, (x, y) => … }`) ----
//
// A `(` at the FIRST arm's pattern position marks a match on a
// tuple-typed scrutinee. Arms are parsed into TupArm records and the
// whole match desugars at parse time (build_tuple_match) into
// constructs the rest of the pipeline already handles:
//
//   if (true) {                                  // scopes the temps
//     var (__tmL_C_e0, __tmL_C_e1) = <scrutinee>; // the destructure StmtVar
//     var __tmL_C_d = false;                      // "an arm ran" flag
//     if (!__tmL_C_d && __tmL_C_e0 == LIT && …) { // literal elements
//       var x = __tmL_C_e1;                       // binder elements
//       if (<guard>) { __tmL_C_d = true; <body> } // guard sees the binds
//     }
//     …one if per arm; `_` and all-binder arms have no eq conditions…
//   }
//
// The flag chain (instead of build_literal_match's backwards if/else
// nesting) is what lets a guard run AFTER the arm's binders are
// declared while a guard-false still falls through to the next arm.
// The native checker validated arity / exhaustiveness / types before
// any of this runs on the self-host path, so no diagnostics are
// re-implemented here. Element kinds: 0 = binder, 1 = `_`, 2 = literal,
// 3 = variant sub-pattern (`(A(x), y)`) — elem_pats[k] then holds the
// PatVariant, and build_tuple_match nests the arm inside a match on the
// element temp rather than adding a condition — 4 = nested tuple
// (`(a, (b, c))`), where elem_pats[k] carries the nested element encoding in
// its own tup_* fields and build_tuple_match destructures the element temp a
// level deeper. elem_pats runs parallel to elem_kinds with a wildcard filler
// at every other kind.
pub struct TupArm { is_wild: boolean, elem_kinds: i32[], binds: string[], lits: Expr[], elem_pats: Pattern[], at_binding: string, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32 }

// p_tuple_carrier wraps a nested tuple element's encoding in a Pattern so it
// can ride on elem_pats. The variant fields are inert — elem_kinds says 4, and
// only the tup_* fields are read back.
function p_tuple_carrier(kinds: i32[], binds: string[], lits: Expr[], pats: Pattern[]): Pattern {
    var no_extra: string[] = [];
    var no_nested: Pattern[] = [];
    return PatVariant { type_name: "", binding: "", extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: kinds, tup_binds: binds, tup_lits: lits, tup_pats: pats };
}

// parse_tuple_arm_pattern consumes `(p0, p1, …)` with the cursor on the
// opening `(`, returning the element encoding. A parse problem yields
// elem_kinds.len() == 0 (the callers emit a degenerate stmt).

function parse_tuple_arm_pattern(p: Par): (i32[], string[], Expr[], Pattern[], Par) {
    var elem_kinds: i32[] = [];
    var binds: string[] = [];
    var lits: Expr[] = [];
    var pats: Pattern[] = [];
    var none: i32[] = [];
    var no_pats: Pattern[] = [];
    p = p.advance(); // consume `(`
    while (p.peek_punct() != ")" && !p.at_end()) {
        var n: string = p.peek_ident();
        if (n == "_") {
            p = p.advance();
            elem_kinds = elem_kinds.append(1);
            binds = binds.append("");
            lits = lits.append(e_bool(true));
            pats = pats.append(p_wildcard());
        } else if (p.peek_punct() == "(") {
            // Nested tuple element: the same production, one level down, so
            // `(a, (b, (c, d)))` nests to any depth and every element rule
            // applies at every level (including the 2-element minimum).
            var (ne_kinds, ne_binds, ne_lits, ne_pats, ne_p) = parse_tuple_arm_pattern(p);
            p = ne_p;
            if (ne_kinds.len() == 0) { return (none, [], [], no_pats, p); }
            elem_kinds = elem_kinds.append(4);
            binds = binds.append("");
            lits = lits.append(e_bool(true));
            pats = pats.append(p_tuple_carrier(ne_kinds, ne_binds, ne_lits, ne_pats));
        } else if (n.len() > 0 && (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == ".")) {
            // Variant sub-pattern: a binder is followed by `,` or `)`, so `(`
            // (payload list, empty for a payload-less variant) and `.` (a
            // `mod.` qualifier) both say variant unambiguously. The payload
            // list is the ARM-position production, so a payload slot may hold
            // a nested variant (`A(Ok(n))`), a literal (`A(0)`) or a tuple
            // (`A((a, b))`) — wrap_tuple_elems routes each through the same
            // desugar an arm-position payload takes.
            var (ve_pat, ve_p) = parse_pattern(p);
            p = ve_p;
            elem_kinds = elem_kinds.append(3);
            binds = binds.append("");
            lits = lits.append(e_bool(true));
            pats = pats.append(ve_pat);
        } else if (n.len() > 0) {
            p = p.advance();
            elem_kinds = elem_kinds.append(0);
            binds = binds.append(n);
            lits = lits.append(e_bool(true));
            pats = pats.append(p_wildcard());
        } else if (p.peek_is_pat_literal()) {
            var (le_expr, le_p) = parse_expr(p);
            p = le_p;
            elem_kinds = elem_kinds.append(2);
            binds = binds.append("");
            lits = lits.append(le_expr);
            pats = pats.append(p_wildcard());
        } else {
            return (none, [], [], no_pats, p);
        }
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    if (elem_kinds.len() < 2) {
        return (none, [], [], no_pats, p);
    }
    return (elem_kinds, binds, lits, pats, p);
}

// tuple_elem_names joins the per-element temp names for one level's
// destructure — `prefix_e0,prefix_e1,…`, the comma-joined form a multi-name
// `var` declaration takes.
function tuple_elem_names(prefix: string, n: i32): string {
    var names: string = "";
    var k: i32 = 0;
    while (k < n) {
        if (k > 0) { names = names + ","; }
        names = names + prefix + "_e" + util.i32_to_string(k);
        k = k + 1;
    }
    return names;
}

// wrap_tuple_elems wraps an arm's matched path in whatever its non-binder
// elements need, innermost element last, and returns the wrapped path.
//
// A variant element (kind 3) nests the path inside a match on the element
// temp — the tag test and the payload binds are exactly what a match arm
// already does, so a payload SUB-PATTERN needs nothing new either: the two
// synthesised arms go through fold_lit_cond and desugar_nested_arms, the same
// pair an arm-position payload takes. A nested tuple element (kind 4)
// destructures the element temp one level deeper, recurses for that level's
// own elements, declares its binders and tests its literals. The destructure
// is irrefutable, so running it before the level's own tests is safe.
function wrap_tuple_elems(path: Stmt[], kinds: i32[], pats: Pattern[], prefix: string, line: i32, col: i32): Stmt[] {
    var cur: Stmt[] = path;
    var wi: i32 = kinds.len() - 1;
    while (wi >= 0) {
        var en: string = prefix + "_e" + util.i32_to_string(wi);
        if (kinds[wi] == 3) {
            var (mk_pat, mk_guard, mk_hg) = fold_lit_cond(pats[wi], e_bool(true), false);
            var mk_arms: MatchArm[] = [];
            mk_arms = mk_arms.append(MatchArm { pattern: mk_pat, body: cur, line: line, col: col, guard: mk_guard, has_guard: mk_hg });
            var mk_skip: Stmt[] = [];
            mk_arms = mk_arms.append(MatchArm { pattern: p_wildcard(), body: mk_skip, line: line, col: col, guard: e_bool(true), has_guard: false });
            var mk_wrap: Stmt[] = [];
            // Every element of every level shares the arm's line/col, so the
            // element temp name is what keeps the desugar's own temps apart.
            mk_wrap = mk_wrap.append(s_match_at(e_ident_at(en, line, col), desugar_nested_arms(mk_arms, 0, en), line, col));
            cur = mk_wrap;
        } else if (kinds[wi] == 4) {
            var (nk, nb, nl, np) = pv_tup(pats[wi]);
            var sub: Stmt[] = wrap_tuple_elems(cur, nk, np, en, line, col);
            // This level's binder decls sit outside the deeper wraps, so they
            // are in scope for everything the wrap encloses — the deeper
            // elements' tests, the guard and the body.
            var body: Stmt[] = [];
            var bk: i32 = 0;
            while (bk < nk.len()) {
                if (nk[bk] == 0) {
                    body = body.append(s_var_at(nb[bk], "", e_ident_at(en + "_e" + util.i32_to_string(bk), line, col), line, col));
                }
                bk = bk + 1;
            }
            var si: i32 = 0;
            while (si < sub.len()) { body = body.append(sub[si]); si = si + 1; }
            var ncond: Expr = e_bool(true);
            var has_ncond: boolean = false;
            var lk: i32 = 0;
            while (lk < nk.len()) {
                if (nk[lk] == 2) {
                    var one: Expr = e_binary("==", e_ident(en + "_e" + util.i32_to_string(lk)), nl[lk]);
                    if (has_ncond) { ncond = e_binary("&&", ncond, one); } else { ncond = one; }
                    has_ncond = true;
                }
                lk = lk + 1;
            }
            var nwrap: Stmt[] = [];
            nwrap = nwrap.append(s_var_at(tuple_elem_names(en, nk.len()), "", e_ident_at(en, line, col), line, col));
            if (has_ncond) {
                nwrap = nwrap.append(s_if(ncond, body, []));
            } else {
                var ci: i32 = 0;
                while (ci < body.len()) { nwrap = nwrap.append(body[ci]); ci = ci + 1; }
            }
            cur = nwrap;
        }
        wi = wi - 1;
    }
    return cur;
}

// build_tuple_match assembles the desugared statement described above.
function build_tuple_match(scrut: Expr, arms: TupArm[], mkline: i32, mkcol: i32): Stmt {
    if (arms.len() == 0) { return s_unknown("empty tuple match"); }
    // Element count comes from the first tuple-pattern arm (the checker
    // guarantees all arms agree with the scrutinee's arity).
    var n_elems: i32 = 0;
    var ai: i32 = 0;
    while (ai < arms.len()) {
        if (!arms[ai].is_wild) { n_elems = arms[ai].elem_kinds.len(); break; }
        ai = ai + 1;
    }
    if (n_elems < 2) { return s_unknown("tuple match with no tuple arm"); }
    var base: string = "__tm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
    var done: string = base + "_d";
    var whole: string = base + "_w";
    var names: string = tuple_elem_names(base, n_elems);
    // Any `@` binding forces caching the whole tuple in `whole` first, so the
    // at-name can alias it while the element destructure reads from it (a
    // single scrutinee eval). Without `@` the destructure reads `scrut`
    // directly — the compiler's own sources take this path, so the emit
    // stays byte-identical.
    var any_at: boolean = false;
    var qi: i32 = 0;
    while (qi < arms.len()) {
        if (!arms[qi].is_wild && arms[qi].at_binding.len() > 0) { any_at = true; }
        qi = qi + 1;
    }
    var outer: Stmt[] = [];
    if (any_at) {
        outer = outer.append(s_var_at(whole, "", scrut, mkline, mkcol));
        outer = outer.append(s_var_at(names, "", e_ident(whole), mkline, mkcol));
    } else {
        outer = outer.append(s_var_at(names, "", scrut, mkline, mkcol));
    }
    outer = outer.append(s_var(done, "", e_bool(false)));
    ai = 0;
    while (ai < arms.len()) {
        var a: TupArm = arms[ai];
        var cond: Expr = e_unary("!", e_ident(done));
        var inner: Stmt[] = [];
        if (a.is_wild) {
            // `_` arm: no element tests, no binds; a guard folds into
            // the condition (short-circuit keeps it after the flag).
            if (a.has_guard) { cond = e_binary("&&", cond, a.guard); }
            inner = inner.append(s_assign(done, e_bool(true)));
            var wb: i32 = 0;
            while (wb < a.body.len()) { inner = inner.append(a.body[wb]); wb = wb + 1; }
            outer = outer.append(s_if(cond, inner, []));
            ai = ai + 1;
            continue;
        }
        var ek: i32 = 0;
        while (ek < a.elem_kinds.len()) {
            if (a.elem_kinds[ek] == 2) {
                cond = e_binary("&&", cond, e_binary("==", e_ident(base + "_e" + util.i32_to_string(ek)), a.lits[ek]));
            }
            ek = ek + 1;
        }
        // Binder decls run on the matched path, before the guard.
        var binds: Stmt[] = [];
        // `@` binding: bind the whole matched tuple (cached in `whole`) to
        // the at-name, in scope for the guard + body.
        if (a.at_binding.len() > 0) {
            binds = binds.append(s_var_at(a.at_binding, "", e_ident_at(whole, a.line, a.col), a.line, a.col));
        }
        ek = 0;
        while (ek < a.elem_kinds.len()) {
            if (a.elem_kinds[ek] == 0) {
                binds = binds.append(s_var_at(a.binds[ek], "", e_ident_at(base + "_e" + util.i32_to_string(ek), a.line, a.col), a.line, a.col));
            }
            ek = ek + 1;
        }
        if (a.has_guard) {
            var guarded: Stmt[] = [];
            guarded = guarded.append(s_assign(done, e_bool(true)));
            var gb: i32 = 0;
            while (gb < a.body.len()) { guarded = guarded.append(a.body[gb]); gb = gb + 1; }
            var bi: i32 = 0;
            while (bi < binds.len()) { inner = inner.append(binds[bi]); bi = bi + 1; }
            inner = inner.append(s_if(a.guard, guarded, []));
        } else {
            inner = inner.append(s_assign(done, e_bool(true)));
            var bi2: i32 = 0;
            while (bi2 < binds.len()) { inner = inner.append(binds[bi2]); bi2 = bi2 + 1; }
            var ab: i32 = 0;
            while (ab < a.body.len()) { inner = inner.append(a.body[ab]); ab = ab + 1; }
        }
        // The variant and nested-tuple elements wrap the arm's whole matched
        // path (innermost = last element). The `done` flag is set inside, so a
        // failing tag or nested-literal test falls through to the next arm the
        // way a failing top-level literal test does.
        inner = wrap_tuple_elems(inner, a.elem_kinds, a.elem_pats, base, a.line, a.col);
        outer = outer.append(s_if(cond, inner, []));
        ai = ai + 1;
    }
    var no_struct: StructArm[] = [];
    return s_if_match(outer, MatchSugar { ...no_match_sugar(), scrut: scrut, tup: arms, line: mkline, col: mkcol });
}

// ---- Struct-pattern match (`match (p) { Point { x, y } => … }`) ----
//
// The self-host has no named-field ENUM variant patterns, so an
// `Ident {` at an arm position is unambiguously a STRUCT pattern. A struct
// has one shape, so a struct-pattern arm is irrefutable — it binds the named
// fields and (with a guard) the first arm whose guard passes runs. It
// desugars at parse time, like build_tuple_match, into the `done`-flag chain
// with per-field `var bind = tmp.field;` binds — no checker/irlower changes:
// the field reads + ifs lower through the ordinary paths.
// field_kinds / field_lits / field_pats run parallel to binds / fields and
// carry a field SUB-PATTERN (`P { x: 0, y }`), using the same encoding TupArm
// uses for tuple elements: 0 = plain binder or rename, 2 = literal (tested as
// a condition, because the IR lowers a literal match only through the
// parse-time literal desugar), 3 = variant sub-pattern (the arm's matched path
// nests inside a match on the field). A slot carrying a sub-pattern binds
// nothing itself — its pattern introduces the bindings.
pub struct StructArm { is_wild: boolean, type_name: string, binds: string[], fields: string[], field_kinds: i32[], field_lits: Expr[], field_pats: Pattern[], at_binding: string, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32 }

// parse_struct_arm_pattern consumes `S { x, y }` (shorthand fields) or
// `S { x: a, y: b }` (renamed: field `x` bound to local `a`); a trailing
// `..` marks omitted fields, the cursor on the struct-name ident. Returns the
// parallel binding + field name lists (fields[i] is the projected field,
// binds[i] the local it binds). The struct name is not retained — the
// scrutinee's type drives field resolution at lowering.
function parse_struct_arm_pattern(p: Par): (string[], string[], i32[], Expr[], Pattern[], boolean, Par) {
    var binds: string[] = [];
    var fields: string[] = [];
    var kinds: i32[] = [];
    var lits: Expr[] = [];
    var pats: Pattern[] = [];
    var ok: boolean = true;
    if (p.peek_ident().len() > 0) { p = p.advance(); } // struct name
    if (p.peek_punct() == "{") { p = p.advance(); }
    while (p.peek_punct() != "}" && !p.at_end()) {
        if (p.peek_punct() == "..") { p = p.advance(); break; }
        var fld: string = p.peek_ident();
        // Nothing below consumes a non-ident field token, so the loop stops on
        // one or it spins. The arm is malformed, and `ok` is what says so —
        // dropping the token instead would compile a pattern binding less
        // than the source asked for.
        if (fld.len() == 0) {
            p = p.advance();
            ok = false;
            break;
        }
        p = p.advance();
        var bind: string = fld;
        var fkind: i32 = 0;
        var flit: Expr = e_bool(true);
        var fpat: Pattern = p_wildcard();
        if (p.peek_punct() == ":") {
            p = p.advance();
            // `field: <x>` is a rename when x is a plain local — an ident
            // followed by `,` or `}` — and a SUB-PATTERN otherwise. The same
            // line the native parser draws, so the two agree on what recurses.
            if (p.peek_is_pat_literal()) {
                var (le_expr, le_p) = parse_expr(p);
                p = le_p;
                fkind = 2;
                flit = le_expr;
                bind = "";
            } else if (struct_field_variant_start(p)) {
                var (fp, fpp) = parse_pattern(p);
                p = fpp;
                fkind = 3;
                fpat = fp;
                bind = "";
            } else {
                var lc: string = p.peek_ident();
                if (lc.len() > 0) { p = p.advance(); }
                bind = lc;
            }
        }
        binds = binds.append(bind);
        fields = fields.append(fld);
        kinds = kinds.append(fkind);
        lits = lits.append(flit);
        pats = pats.append(fpat);
        if (p.peek_punct() == ",") { p = p.advance(); }
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    return (binds, fields, kinds, lits, pats, ok, p);
}

// struct_field_variant_start reports whether the cursor (just past a
// `field:`) opens a VARIANT sub-pattern rather than naming a rename local. A
// rename is a bare ident followed by `,` or `}`, so `(` (payload list, empty
// for a payload-less variant) and `.` (a `mod.` qualifier) both say variant.
function struct_field_variant_start(p: Par): boolean {
    var n: string = p.peek_ident();
    if (n.len() > 0 && n != "_") {
        var nx: string = p.peek_punct_at(1);
        if (nx == "(" || nx == ".") { return true; }
    }
    return false;
}

function build_struct_match(scrut: Expr, arms: StructArm[], mkline: i32, mkcol: i32): Stmt {
    if (arms.len() == 0) { return s_unknown("empty struct match"); }
    var base: string = "__sm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
    var tmp: string = base + "_v";
    var done: string = base + "_d";
    var outer: Stmt[] = [];
    outer = outer.append(s_var(tmp, "", scrut));
    outer = outer.append(s_var(done, "", e_bool(false)));
    var ai: i32 = 0;
    while (ai < arms.len()) {
        var a: StructArm = arms[ai];
        var cond: Expr = e_unary("!", e_ident(done));
        var inner: Stmt[] = [];
        if (a.is_wild) {
            if (a.has_guard) { cond = e_binary("&&", cond, a.guard); }
            inner = inner.append(s_assign(done, e_bool(true)));
            var wb: i32 = 0;
            while (wb < a.body.len()) { inner = inner.append(a.body[wb]); wb = wb + 1; }
            outer = outer.append(s_if(cond, inner, []));
            ai = ai + 1;
            continue;
        }
        // A LITERAL field is an equality test folded into the arm condition —
        // the same treatment a literal tuple element gets, and the reason it
        // is not a nested match: the IR lowers a literal match only through
        // the parse-time literal desugar, not from a raw match node.
        var lk: i32 = 0;
        while (lk < a.field_kinds.len()) {
            if (a.field_kinds[lk] == 2) {
                cond = e_binary("&&", cond, e_binary("==", e_field_access_at(e_ident(tmp), a.fields[lk], a.line, a.col), a.field_lits[lk]));
            }
            lk = lk + 1;
        }
        var binds: Stmt[] = [];
        // `@` binding: bind the whole matched struct (the cached scrutinee
        // `tmp`) to the at-name, in scope for the guard + body.
        if (a.at_binding.len() > 0) {
            binds = binds.append(s_var_at(a.at_binding, "", e_ident(tmp), a.line, a.col));
        }
        var bk: i32 = 0;
        while (bk < a.binds.len()) {
            // A field carrying a sub-pattern binds nothing itself — the
            // wrap below matches it and its pattern introduces the bindings.
            if (a.binds[bk].len() > 0) {
                binds = binds.append(s_var_at(a.binds[bk], "", e_field_access_at(e_ident(tmp), a.fields[bk], a.line, a.col), a.line, a.col));
            }
            bk = bk + 1;
        }
        if (a.has_guard) {
            var guarded: Stmt[] = [];
            guarded = guarded.append(s_assign(done, e_bool(true)));
            var gb: i32 = 0;
            while (gb < a.body.len()) { guarded = guarded.append(a.body[gb]); gb = gb + 1; }
            var bi: i32 = 0;
            while (bi < binds.len()) { inner = inner.append(binds[bi]); bi = bi + 1; }
            inner = inner.append(s_if(a.guard, guarded, []));
        } else {
            inner = inner.append(s_assign(done, e_bool(true)));
            var bi2: i32 = 0;
            while (bi2 < binds.len()) { inner = inner.append(binds[bi2]); bi2 = bi2 + 1; }
            var ab: i32 = 0;
            while (ab < a.body.len()) { inner = inner.append(a.body[ab]); ab = ab + 1; }
        }
        // A field sub-pattern (`P { x: 0, y }`) tests the field and binds
        // whatever its pattern binds — which is what a match arm already
        // does, so the arm's whole matched path nests inside one match per
        // such field (innermost = last field). The `done` flag is set inside,
        // so a failing field falls through to the next arm.
        inner = wrap_struct_fields(inner, a, tmp);
        outer = outer.append(s_if(cond, inner, []));
        ai = ai + 1;
    }
    var no_tup: TupArm[] = [];
    return s_if_match(outer, MatchSugar { ...no_match_sugar(), scrut: scrut, strct: arms, line: mkline, col: mkcol });
}

// wrap_struct_fields nests the arm's matched path inside a match on each
// field that carries a sub-pattern, innermost field last.
function wrap_struct_fields(path: Stmt[], a: StructArm, tmp: string): Stmt[] {
    var cur: Stmt[] = path;
    var wi: i32 = a.field_kinds.len() - 1;
    while (wi >= 0) {
        if (a.field_kinds[wi] == 3) {
            var mk_arms: MatchArm[] = [];
            mk_arms = mk_arms.append(MatchArm { pattern: a.field_pats[wi], body: cur, line: a.line, col: a.col, guard: e_bool(true), has_guard: false });
            var mk_skip: Stmt[] = [];
            mk_arms = mk_arms.append(MatchArm { pattern: p_wildcard(), body: mk_skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false });
            // Match on an IDENT holding the field, not on the field access
            // itself: the scrutinee is read once, and the IR lowers a match on
            // a local where a match on a field expression bails to the AST
            // emitter (which no longer exists).
            var fv: string = tmp + "_f" + util.i32_to_string(wi);
            var mk_wrap: Stmt[] = [];
            mk_wrap = mk_wrap.append(s_var_at(fv, "", e_field_access_at(e_ident(tmp), a.fields[wi], a.line, a.col), a.line, a.col));
            mk_wrap = mk_wrap.append(s_match_at(e_ident_at(fv, a.line, a.col), mk_arms, a.line, a.col));
            cur = mk_wrap;
        }
        wi = wi - 1;
    }
    return cur;
}

// is_struct_pattern_arm reports whether the arm the cursor sits on destructures
// a STRUCT (`Point { x, y }`, or `w @ Point { x, y }`) rather than a record-form
// enum variant, which is spelled identically — see Par.structnames for how the
// two are told apart. Only the arm's head name is inspected: the struct-pattern
// desugar is chosen once, off the first arm, so this decides for the match.
function is_struct_pattern_arm(p: Par): boolean {
    var head: string = p.peek_ident();
    if (head.len() > 0 && p.peek_punct_at(1) == "@") { head = p.peek_ident_at(2); }
    if (head.len() == 0) { return false; }
    return util.has_str(p.structnames, head);
}

// parse_struct_match_arms parses the arm list of a struct match (cursor just
// past the opening `{`), returning the arms + the first arm's return-type tag.
// Shared by the statement and expression forms: expr_form=true parses each arm
// body as a value branch (`parse_branch_body` / a bare tail expr, so the IIFE
// wrapper yields it); expr_form=false parses a statement block (`parse_block`).
function parse_struct_match_arms(p: Par, expr_form: boolean): (StructArm[], string, boolean, Par) {
    var arms: StructArm[] = [];
    var rt: string = "i32";
    var first: boolean = true;
    var all_ok: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
        var sline: i32 = p.peek_line();
        var scol: i32 = p.peek_col();
        var s_wild: boolean = false;
        var s_binds: string[] = [];
        var s_fields: string[] = [];
        var s_field_kinds: i32[] = [];
        var s_field_lits: Expr[] = [];
        var s_field_pats: Pattern[] = [];
        var s_at: string = "";
        var s_type: string = "";
        // Optional `name @` prefix: bind the whole matched struct to `name`
        // while destructuring its fields (`w @ Point { x, y }`).
        if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
            s_at = p.peek_ident();
            p = p.advance();
            p = p.advance();
        }
        if (p.peek_ident() == "_" && p.peek2_punct() != "{") {
            p = p.advance();
            s_wild = true;
        } else {
            // The struct name the arm spelled. parse_struct_arm_pattern
            // consumes and discards it (the desugar binds fields off a temp
            // and never needs it); the printer does need it, and the cursor
            // is on it here.
            s_type = p.peek_ident();
            var (spb, spf, spkinds, splits, sppats, spok, spp) = parse_struct_arm_pattern(p);
            p = spp;
            s_binds = spb;
            s_fields = spf;
            s_field_kinds = spkinds;
            s_field_lits = splits;
            s_field_pats = sppats;
            if (!spok) { all_ok = false; }
        }
        var s_guard: Expr = e_bool(true);
        var s_has_guard: boolean = false;
        if (p.peek_keyword() == "when") {
            p = p.advance();
            var (sgr_expr, sgr_p) = parse_expr(p);
            p = sgr_p;
            s_guard = sgr_expr;
            s_has_guard = true;
        }
        if (p.peek_punct() == "=>") { p = p.advance(); }
        var sbody: Stmt[] = [];
        var sbrt: string = "i32";
        if (expr_form) {
            if (p.peek_punct() == "{") {
                var (sbb_body, sbb_rt, sbb_p) = parse_branch_body(p);
                p = sbb_p;
                sbody = sbb_body;
                sbrt = sbb_rt;
            } else {
                var (ser_expr, ser_p) = parse_expr(p);
                p = ser_p;
                sbody = [s_return(ser_expr)];
                sbrt = if_expr_rt(ser_expr);
            }
        } else {
            var (sblk_body, sblk_p) = parse_block(p);
            p = sblk_p;
            sbody = sblk_body;
        }
        if (first) { rt = sbrt; first = false; }
        arms = arms.append(StructArm { is_wild: s_wild, type_name: s_type, binds: s_binds, fields: s_fields, field_kinds: s_field_kinds, field_lits: s_field_lits, field_pats: s_field_pats, at_binding: s_at, guard: s_guard, has_guard: s_has_guard, body: sbody, line: sline, col: scol });
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    return (arms, rt, all_ok, p);
}

// parse_branch_body yields a parsed if/match value-branch body: the
// Stmt[] (leading statements followed by `s_return(tail)`) plus the
// return-type tag derived from the TAIL expression (the block's value).

// branch_stmt_start reports whether the next token begins a STATEMENT
// inside an if/match value-branch body (block-expressions slice 1). These
// are the keyword-led statements parse_stmt handles directly (each
// consumes its own terminator) plus a nested `{`-block. `if` / `match`
// are deliberately EXCLUDED: they stand as the trailing value expression
// (`{ …; if (c) { a } else { b } }`) and the single-expr branch form
// `else { if (c) { … } else { … } }` relies on the inner if/match parsing
// as a value-expression. Everything else parses as an expression
// (an ExprStmt when a `;` follows, else the trailing tail). Mirrors the
// Go parser's branchStmtStart.
function branch_stmt_start(p: Par): boolean {
    if (p.peek_punct() == "{") { return true; }
    var kw: string = p.peek_keyword();
    // #4522: an else-LESS `if` in a block body is a control-flow STATEMENT
    // (`{ if (early) { return 0; } …; tail }`), not the value expression — an
    // if-EXPRESSION requires `else`, so an else-less `if` can never be a tail
    // value. An `if` WITH `else` stays on the expression path so
    // `{ …; if (c) { a } else { b } }` still yields a value and the else-if
    // chain form is unaffected.
    if (kw == "if" && !p.if_stmt_has_else()) { return true; }
    if (kw == "while" || kw == "loop" || kw == "for" || kw == "break"
        || kw == "continue" || kw == "return" || kw == "defer"
        || kw == "errdefer" || kw == "var" || kw == "let"
        || kw == "function") { return true; }
    return false;
}

// branch_stmts_diverge reports whether a value-branch body's statements exit
// on every path, so the block never falls through to a trailing value. Mirrors
// the Go checker's stmtsDiverge / stmtDiverges: only the LAST statement is
// consulted, `loop { … }` counts as unconditional (breaks are ignored, the same
// conservative stance the Go side takes), an `if` needs both arms, and a `match`
// needs every arm.
function branch_stmts_diverge(stmts: Stmt[]): boolean {
    if (stmts.len() == 0) { return false; }
    return branch_stmt_diverges(stmts[stmts.len() - 1]);
}

function branch_stmt_diverges(st: Stmt): boolean {
    match (st) {
        StmtReturn(_) => { return true; },
        StmtBreak(_) => { return true; },
        StmtContinue(_) => { return true; },
        StmtWhile(w) => { return w.is_loop; },
        StmtIf(f) => {
            if (f.else_body.len() == 0) { return false; }
            return branch_stmts_diverge(f.then_body) && branch_stmts_diverge(f.else_body);
        },
        StmtMatch(m) => {
            if (m.arms.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < m.arms.len()) {
                if (!branch_stmts_diverge(m.arms[i].body)) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// branch_dead_tail picks the UNREACHABLE value a diverging branch is given so
// its shape matches every other value branch (leading statements + a trailing
// value). Reusing the `return E` the block leaves through keeps the tail's type
// consistent with the enclosing function's; anything else — a `loop`, a bare
// `break`, a void `return` — takes a zero, which no path can read.
function branch_dead_tail(stmts: Stmt[]): Expr {
    if (stmts.len() == 0) { return e_number("0", "", false); }
    match (stmts[stmts.len() - 1]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprUnknown(_) => { return e_number("0", "", false); },
                _ => { return r.value; }
            }
        },
        _ => { return e_number("0", "", false); }
    }
    return e_number("0", "", false);
}

// parse_branch_body parses the `{ … }` body of an if/match value-branch
// (block-expressions slice 1), mirroring the Go parser's parseBranchBody.
// The body is a sequence of `;`-terminated statements run before an
// optional trailing expression written WITHOUT a `;` — that trailing
// expression is the branch's value. The cursor is expected on `{`.
//
//   - `{ e }`          → `[s_return(e)]` (single-expr branch, kept
//     byte-identical to the pre-block-expr behaviour so existing
//     if/match expressions don't regress).
//   - `{ s; …; tail }` → `[<leading stmts…>, s_return(tail)]`, which
//     irlower's lower_value_tail already lowers (leading statements +
//     a final value-producing statement).
//
// A keyword-led item (var/let/while/… or a nested `{`-block) parses as a
// statement via parse_stmt. A non-keyword item parses as an expression:
// an ExprStmt if a `;` follows, otherwise the trailing TAIL (which must
// be followed by `}`). The `rt` tag is derived from the TAIL expression
// (the value), not a leading statement, so the desugared IIFE / value-
// lowering gets the right return type.
function parse_branch_body(p: Par): (Stmt[], string, Par) {
    var ebody: Stmt[] = [];
    var rt: string = "i32";
    if (p.peek_punct() != "{") {
        ebody = ebody.append(s_unknown("missing { in branch body"));
        return (ebody, rt, p);
    }
    p = p.advance();  // consume `{`
    var leading: Stmt[] = [];
    var have_tail: boolean = false;
    var tail: Expr = e_unknown("empty branch");
    while (p.peek_punct() != "}" && !p.at_end()) {
        if (branch_stmt_start(p)) {
            var (sr_stmt, sr_p) = parse_stmt(p);
            // Progress guard: a malformed statement that consumed no token
            // would otherwise spin forever — skip it instead.
            if (sr_p.pos == p.pos) { p = p.advance(); continue; }
            p = sr_p;
            leading = leading.append(sr_stmt);
            continue;
        }
        // Non-keyword item: an expression that is either an ExprStmt
        // (followed by `;`) or the trailing value (followed by `}`).
        var (er_expr, er_p) = parse_expr(p);
        p = er_p;
        if (p.peek_punct() == ";") {
            p = p.advance();
            leading = leading.append(s_expr(er_expr));
            continue;
        }
        // No `;` — this is the trailing tail expression; `}` must follow.
        tail = er_expr;
        have_tail = true;
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    if (have_tail) { rt = if_expr_rt(tail); }
    // A value-less block (no trailing tail) in value position has no
    // result — yield a StmtUnknown so the branch surfaces an error rather
    // than silently miscompiling (the Go checker reports E061). A block
    // whose statements ALWAYS exit early never reaches a trailing value:
    // its type is `never`, not void, so it is admitted (#4522). Every one of
    // its statements stays LEADING — the value-block lowering runs those inline,
    // which is what lets their `return` / `break` leave the enclosing function
    // or loop — and the block gets an unreachable tail so its shape is the one
    // the lowering reads (leading statements + a trailing value).
    if (!have_tail) {
        if (!branch_stmts_diverge(leading)) {
            leading = leading.append(s_unknown("value branch has no trailing expression"));
            return (leading, rt, p);
        }
        var dead: Expr = branch_dead_tail(leading);
        rt = if_expr_rt(dead);
        leading = leading.append(s_return(dead));
        return (leading, rt, p);
    }
    leading = leading.append(s_return(tail));
    return (leading, rt, p);
}

// parse_if_chain parses `if (c) { E1 } else { E2 }` (and `else if`
// chains, via recursion through the else arm) into a StmtIf whose arms
// `return` the branch expressions. parse_primary wraps the result in an
// IIFE `(function(): RT { <stmt> })()`, so it lowers to the ExprCall +
// ExprLambda the rest of the pipeline already handles — no new AST node,
// so every backend supports if-expressions at once. The IIFE captures
// any referenced locals automatically (the lambda machinery computes
// captures). Mirrors the Go parser's parseIfExpr: then/else are
// block-with-tail bodies (block-expressions slice 1) — a multi-statement
// branch (`{ var k = …; k }`) runs the leading statements then yields the
// trailing tail — and a final `else` is required (the if-expression is
// total). A lone trailing expression with no leading statements stays
// `[s_return(expr)]`, byte-identical to the pre-block-expr behaviour.
function parse_if_chain(p: Par): IfChain {
    p = p.advance();                              // `if`
    if (p.peek_punct() == "(") { p = p.advance(); }
    var (condr_expr, condr_p) = parse_expr(p);
    p = condr_p;
    if (p.peek_punct() == ")") { p = p.advance(); }
    var (thenb_body, thenb_rt, thenb_p) = parse_branch_body(p);
    p = thenb_p;
    var then_body: Stmt[] = thenb_body;
    var rt: string = thenb_rt;
    if (p.peek_keyword() == "else") { p = p.advance(); }
    var else_body: Stmt[] = [];
    if (p.peek_keyword() == "if") {
        // `else if (…) { … }` — the else arm is itself an if-chain.
        var nested: IfChain = parse_if_chain(p);
        p = nested.par;
        else_body = [nested.stmt];
    } else {
        var (elseb_body, elseb_rt, elseb_p) = parse_branch_body(p);
        p = elseb_p;
        else_body = elseb_body;
        rt = wider_rt(rt, elseb_rt);
    }
    return IfChain { par: p, stmt: s_if(condr_expr, then_body, else_body), rt: rt, needs_default_return: false, value_local: "" };
}

// parse_match_expr parses `match (e) { Pat => E, Pat when C => E, … }` in value
// position into a StmtMatch whose arms `return` their (bare) expression, plus a
// return-type tag for the IIFE. parse_primary wraps the result in an IIFE
// (`(function(): RT { <stmt> })()`), so it reuses the statement-match + lambda
// codegen every backend already supports — no new AST node, so all backends
// get match-expressions at once (mirrors parse_if_chain).
function parse_match_expr(p: Par): IfChain {
    var mkline: i32 = p.peek_line();
    var mkcol: i32 = p.peek_col();
    p = p.advance();                              // `match`
    if (p.peek_punct() == "(") { p = p.advance(); }
    var (sr_expr, sr_p) = parse_expr(p);
    p = sr_p;
    if (p.peek_punct() == ")") { p = p.advance(); }
    var rt: string = "i32";
    if (p.peek_punct() == "{") { p = p.advance(); }
    // A `(` at the FIRST arm's pattern position marks a match on a
    // TUPLE scrutinee — same build_tuple_match desugar as the statement
    // form; the surrounding IIFE (built by the caller) turns the
    // arm bodies' `return`s into the expression's value.
    if (p.peek_punct() == "(" || (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(")) {
        var etarms: TupArm[] = [];
        var etfirst: boolean = true;
        while (p.peek_punct() != "}" && !p.at_end()) {
            var etline: i32 = p.peek_line();
            var etcol: i32 = p.peek_col();
            var et_wild: boolean = false;
            var et_empty_body: Stmt[] = [];
            var et_at: string = "";
            // Optional `name @` prefix: bind the whole matched tuple.
            if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
                et_at = p.peek_ident();
                p = p.advance();
                p = p.advance();
            }
            // Partial-TupArm buffer (guard + body filled after parsing),
            // same IR-eligible struct-array shape as the statement form.
            var etpats: TupArm[] = [];
            if (p.peek_punct() == "(") {
                var (etpr_elem_kinds, etpr_binds, etpr_lits, etpr_pats, etpr_p) = parse_tuple_arm_pattern(p);
                p = etpr_p;
                if (etpr_elem_kinds.len() == 0) {
                    return IfChain { par: p, stmt: s_unknown("bad tuple pattern"), rt: rt, needs_default_return: false, value_local: "" };
                }
                etpats = etpats.append(TupArm { is_wild: false, elem_kinds: etpr_elem_kinds, binds: etpr_binds, lits: etpr_lits, elem_pats: etpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol });
                // Tuple or-patterns: one TupArm per `|` alternative sharing
                // the guard + body (per-alternative binds), same as the
                // statement form and the native per-alternative desugar.
                while (p.peek_punct() == "|") {
                    p = p.advance();
                    var (etor_kinds, etor_binds, etor_lits, etor_pats, etor_p) = parse_tuple_arm_pattern(p);
                    p = etor_p;
                    if (etor_kinds.len() == 0) {
                        return IfChain { par: p, stmt: s_unknown("bad tuple pattern"), rt: rt, needs_default_return: false, value_local: "" };
                    }
                    etpats = etpats.append(TupArm { is_wild: false, elem_kinds: etor_kinds, binds: etor_binds, lits: etor_lits, elem_pats: etor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol });
                }
            } else {
                var (etwp_pattern, etwp_p) = parse_pattern(p);
                p = etwp_p;
                et_wild = true;
            }
            var et_guard: Expr = e_bool(true);
            var et_has_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (etgr_expr, etgr_p) = parse_expr(p);
                p = etgr_p;
                et_guard = etgr_expr;
                et_has_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            var etbody: Stmt[] = [];
            var etrt: string = "i32";
            if (p.peek_punct() == "{") {
                var (etbb_body, etbb_rt, etbb_p) = parse_branch_body(p);
                p = etbb_p;
                etbody = etbb_body;
                etrt = etbb_rt;
            } else {
                var (eter_expr, eter_p) = parse_expr(p);
                p = eter_p;
                etbody = [s_return(eter_expr)];
                etrt = if_expr_rt(eter_expr);
            }
            if (etfirst) { rt = etrt; etfirst = false; }
            if (et_wild) {
                var etw_kinds: i32[] = [];
                var etw_pats: Pattern[] = [];
                var etw_binds: string[] = [];
                var etw_lits: Expr[] = [];
                etarms = etarms.append(TupArm { is_wild: true, elem_kinds: etw_kinds, binds: etw_binds, lits: etw_lits, elem_pats: etw_pats, at_binding: "", guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol });
            } else {
                var etalt: i32 = 0;
                while (etalt < etpats.len()) {
                    var etpa: TupArm = etpats[etalt];
                    etarms = etarms.append(TupArm { is_wild: false, elem_kinds: etpa.elem_kinds, binds: etpa.binds, lits: etpa.lits, elem_pats: etpa.elem_pats, at_binding: et_at, guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol });
                    etalt = etalt + 1;
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        // Route the arm values through a value LOCAL rather than through
        // `return`: build_tuple_match splices each arm body into the done-flag
        // if-chain, where a `return` would leave the enclosing function instead
        // of yielding the expression's value (see IfChain.value_local).
        var etval: string = "__tm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
        var etvarms: TupArm[] = [];
        var etvi: i32 = 0;
        while (etvi < etarms.len()) {
            var etva: TupArm = etarms[etvi];
            etvarms = etvarms.append(TupArm { is_wild: etva.is_wild, elem_kinds: etva.elem_kinds, binds: etva.binds, lits: etva.lits, elem_pats: etva.elem_pats, at_binding: etva.at_binding, guard: etva.guard, has_guard: etva.has_guard, body: value_arm_body(etva.body, etval), line: etva.line, col: etva.col });
            etvi = etvi + 1;
        }
        return IfChain { par: p, stmt: build_tuple_match(sr_expr, etvarms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: etval };
    }
    // A declared struct's `Ident {` at the FIRST arm marks a STRUCT-pattern match
    // (is_struct_pattern_arm; a record-form enum variant is spelled the same way
    // but needs the variant path's tag test): desugar to the field-bind flag
    // chain (build_struct_match).
    if (is_struct_pattern_arm(p) && ((p.peek_ident().len() > 0 && p.peek2_punct() == "{") || (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{"))) {
        var (smarms, smrt, smok, smp) = parse_struct_match_arms(p, true);
        p = smp;
        if (!smok) {
            return IfChain { par: p, stmt: s_unknown("a struct pattern binds field names"), rt: smrt, needs_default_return: false, value_local: "" };
        }
        // Same value-local routing as the tuple desugar above: build_struct_match
        // splices arm bodies into the same done-flag if-chain shape.
        // `_r`, not `_v`: build_struct_match already uses `<base>_v` for its
        // cached scrutinee, and reusing it made the arm store overwrite the
        // scrutinee instead of the result.
        var smval: string = "__sm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
        var smvarms: StructArm[] = [];
        var smvi: i32 = 0;
        while (smvi < smarms.len()) {
            var smva: StructArm = smarms[smvi];
            smvarms = smvarms.append(StructArm { ...smva, body: value_arm_body(smva.body, smval) });
            smvi = smvi + 1;
        }
        return IfChain { par: p, stmt: build_struct_match(sr_expr, smvarms, mkline, mkcol), rt: smrt, needs_default_return: false, value_local: smval };
    }
    // A literal at the FIRST arm's pattern position marks a match on a
    // non-enum (i32 / string) scrutinee: parse every arm as a literal /
    // `_` and desugar to an if/else-if chain (build_literal_match). The
    // decision is made once, up front, so the common enum/variant match
    // takes the normal StmtMatch path below with no extra allocation.
    if (p.peek_is_pat_literal()) {
        var lit_arms: LitArm[] = [];
        var lfirst: boolean = true;
        while (p.peek_punct() != "}" && !p.at_end()) {
            var laline: i32 = p.peek_line();
            var lacol: i32 = p.peek_col();
            var lwild: boolean = false;
            var lalt_lits: Expr[] = [];
            var lalt_his: Expr[] = [];
            var lalt_hrs: boolean[] = [];
            var lalt_incs: boolean[] = [];
            if (p.peek_is_pat_literal()) {
                var (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
                p = la_p;
                lalt_lits = la_lits;
                lalt_his = la_his;
                lalt_hrs = la_hrs;
                lalt_incs = la_incs;
            } else {
                var (lpr_pattern, lpr_p) = parse_pattern(p);
                p = lpr_p;
                lwild = true;
            }
            var lguard: Expr = e_bool(true);
            var lhas_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (lgr_expr, lgr_p) = parse_expr(p);
                p = lgr_p;
                lguard = lgr_expr;
                lhas_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            // A `{ … }` arm body is a block-with-tail (block-expressions
            // slice 1): leading statements then the trailing value. A bare
            // expression arm body stays the pre-block-expr single-expr form.
            var lbody: Stmt[] = [];
            var lrt: string = "i32";
            if (p.peek_punct() == "{") {
                var (lbb_body, lbb_rt, lbb_p) = parse_branch_body(p);
                p = lbb_p;
                lbody = lbb_body;
                lrt = lbb_rt;
            } else {
                var (ler_expr, ler_p) = parse_expr(p);
                p = ler_p;
                lbody = [s_return(ler_expr)];
                lrt = if_expr_rt(ler_expr);
            }
            if (lfirst) { rt = lrt; lfirst = false; }
            if (lwild) {
                lit_arms = lit_arms.append(LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false });
            } else {
                // One LitArm per `|` alternative, sharing the guard + body.
                var lai: i32 = 0;
                while (lai < lalt_lits.len()) {
                    lit_arms = lit_arms.append(LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai] });
                    lai = lai + 1;
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return IfChain { par: p, stmt: build_literal_match(sr_expr, lit_arms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "" };
    }
    var arms: MatchArm[] = [];
    var ewritten: MatchArm[] = [];
    var first: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
        var aline: i32 = p.peek_line();
        var acol: i32 = p.peek_col();
        var (pr_pattern, pr_p) = parse_pattern(p);
        p = pr_p;
        // Or-patterns: `A | B | … => expr` — one MatchArm per alternative,
        // sharing the guard + body. Variant patterns only (see the stmt-form
        // note); a literal-first match takes the build_literal_match path.
        var pats: Pattern[] = [pr_pattern];
        while (p.peek_punct() == "|") {
            p = p.advance();
            var (pr2_pattern, pr2_p) = parse_pattern(p);
            p = pr2_p;
            pats = pats.append(pr2_pattern);
        }
        var arm_guard: Expr = e_bool(true);
        var arm_has_guard: boolean = false;
        if (p.peek_keyword() == "when") {
            p = p.advance();
            var (gr_expr, gr_p) = parse_expr(p);
            p = gr_p;
            arm_guard = gr_expr;
            arm_has_guard = true;
        }
        if (p.peek_punct() == "=>") { p = p.advance(); }
        // A `{ … }` arm body is a block-with-tail (block-expressions slice
        // 1): leading statements then the trailing value. A bare expression
        // arm body stays the pre-block-expr single-expr form.
        var abody: Stmt[] = [];
        var art: string = "i32";
        if (p.peek_punct() == "{") {
            var (abb_body, abb_rt, abb_p) = parse_branch_body(p);
            p = abb_p;
            abody = abb_body;
            art = abb_rt;
        } else {
            var (er_expr, er_p) = parse_expr(p);
            p = er_p;
            abody = [s_return(er_expr)];
            art = if_expr_rt(er_expr);
        }
        // Combine every arm's tag, not just the first one's. The arms yield ONE
        // value, so one tag has to describe all of them, and a 64-bit arm is the
        // one that cannot be narrowed — see wider_rt, which #6246 introduced for
        // exactly this on the if-expression side. First-arm-wins lost the width
        // whenever the leading arm was the one with nothing to go on:
        // `match (x %? y) { Some(v) => v, None => 111i64 }` read `v` as i32,
        // labelled the IIFE i32, and the i64 `return` then bailed the module.
        if (first) { rt = art; first = false; } else { rt = wider_rt(rt, art); }
        var pi: i32 = 0;
        while (pi < pats.len()) {
            ewritten = ewritten.append(MatchArm { pattern: pats[pi], body: abody, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard });
            var (fa_pat, fa_g, fa_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
            arms = arms.append(MatchArm { pattern: fa_pat, body: abody, line: aline, col: acol, guard: fa_g, has_guard: fa_hg });
            pi = pi + 1;
        }
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    // A TUPLE sub-pattern (`Pr((a, b))`) makes build_merged_arm splice the arm
    // bodies into build_tuple_match's done-flag chain, where an arm's `return`
    // leaves the enclosing function instead of yielding the expression's value.
    // That is the same shape the tuple- and struct-SCRUTINEE desugars above hit,
    // so it takes the same cure: route the arm values through a value local
    // (see IfChain.value_local). A variant sub-pattern needs none of this — its
    // inner match is a StmtMatch, whose arm returns lower_iife_match rewrites.
    if (arms_have_tuple_subpattern(arms)) {
        var ntval: string = "__nt" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
        var ntarms: MatchArm[] = [];
        var nti: i32 = 0;
        while (nti < arms.len()) {
            var nta: MatchArm = arms[nti];
            ntarms = ntarms.append(MatchArm { pattern: nta.pattern, body: value_arm_body(nta.body, ntval), line: nta.line, col: nta.col, guard: nta.guard, has_guard: nta.has_guard });
            nti = nti + 1;
        }
        return IfChain { par: p, stmt: s_match_at(sr_expr, desugar_nested_arms(ntarms, 0, ""), mkline, mkcol), rt: rt, needs_default_return: false, value_local: ntval };
    }
    var esugar: MatchArm[] = [];
    if (arms_have_written_form(ewritten)) { esugar = ewritten; }
    arms = desugar_nested_arms(arms, 0, "");
    return IfChain { par: p, stmt: s_match_sugared(sr_expr, arms, esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "" };
}

// arms_have_tuple_subpattern reports whether any arm holds a tuple sub-pattern
// in its payload slot — the arms that build_merged_arm routes through
// build_tuple_match rather than through a variant inner match.
function arms_have_tuple_subpattern(arms: MatchArm[]): boolean {
    var i: i32 = 0;
    while (i < arms.len()) {
        match (arms[i].pattern) {
            PatVariant(pv) => { if (pv.tup_kinds.len() > 0) { return true; } },
            PatWildcard(w) => {}
        }
        i = i + 1;
    }
    return false;
}

// pipe_prepend builds [head] ++ tail — the argument list for a piped
// call where `head` (the piped value) becomes the first argument.
function pipe_prepend(head: Expr, tail: Expr[]): Expr[] {
    var out: Expr[] = [head];
    var i: i32 = 0;
    while (i < tail.len()) {
        out = out.append(tail[i]);
        i = i + 1;
    }
    return out;
}

// pipe_desugar lowers `left |> right`. `x |> f(a, b)` prepends x to the
// call's args → `f(x, a, b)`; `x |> f(a, _)` substitutes x at the `_`
// topic placeholder instead → `f(a, x)` (at most one `_`, direct args
// only — the native parser rejects two with P004, so a native-valid
// program has at most one; this mirror substitutes at the first);
// `x |> f` (a bare callee) wraps it as a single-arg call → `f(x)`.
// Mirrors the Go parser's parsePipe, lowering to the same ExprCall the
// rest of the pipeline already handles.
function pipe_desugar(left: Expr, right: Expr): Expr {
    match (right) {
        ExprCall(c) => {
            var hole: i32 = 0 - 1;
            var hi: i32 = 0;
            while (hi < c.args.len()) {
                if (hole < 0) {
                    match (c.args[hi]) {
                        ExprIdent(id) => { if (id.name == "_") { hole = hi; } },
                        _ => {}
                    }
                }
                hi = hi + 1;
            }
            if (hole >= 0) {
                var subst: Expr[] = [];
                var si: i32 = 0;
                while (si < c.args.len()) {
                    if (si == hole) {
                        subst = subst.append(left);
                    } else {
                        subst = subst.append(c.args[si]);
                    }
                    si = si + 1;
                }
                return e_call(c.callee, subst);
            }
            return e_call(c.callee, pipe_prepend(left, c.args));
        },
        _ => {
            var one: Expr[] = [left];
            return e_call(right, one);
        }
    }
}

// parse_pipe sits just above parse_binary (looser than every binary
// operator, left-associative): the operands of `|>` are full binary
// expressions and the pipe itself only binds at the expression top
// level, matching the Go grammar (parseExpr -> parsePipe -> parseLogicOr).
// parse_range handles the range EXPRESSION `a..b` / `a..=b`, desugaring it to a
// first-class iterator value: `iter.range(a, b)` / `iter.range_incl(a, b)` —
// core/iter's `Range`, which implements `Iterator`, so `iter.sum(0..n)` and
// `(0..10)` passed to any combinator flow through the iterator protocol
// (requires `import "core/iter"`; flatten_qualified rewrites `iter.range` ->
// `iter__range`). It sits just below the pipe operator and reads its operands
// with parse_binary so `0..n+1` is `0..(n+1)`. The `for i in LOW..HIGH` loop
// keeps its own counted-loop desugar — parse_for_stmt reads its bounds with
// parse_binary (below this level), so a range there stays the optimized form.
function parse_range(p: Par): (Expr, Par) {
    var (left_expr, left_p) = parse_binary(p, 1);
    p = left_p;
    var pk: string = p.peek_punct();
    if (pk == ".." || pk == "..=") {
        p = p.advance();
        var fn: string = "range";
        if (pk == "..=") { fn = "range_incl"; }
        var (right_expr, right_p) = parse_binary(p, 1);
        p = right_p;
        var callee: Expr = e_field_access(e_ident("iter"), fn);
        var args: Expr[] = [left_expr, right_expr];
        return (e_call(callee, args), p);
    }
    return (left_expr, p);
}

function parse_pipe(p: Par): (Expr, Par) {
    var (left_expr, left_p) = parse_range(p);
    p = left_p;
    var acc: Expr = left_expr;
    while (p.peek_punct() == "|>") {
        p = p.advance();
        var (right_expr, right_p) = parse_range(p);
        p = right_p;
        // `-fmt` keeps the written pipe. The desugar folds the LHS into the
        // call's argument list (or into its `_` hole), which is unrecoverable
        // afterwards — a reformat rewrote `x |> f` as `f(x)`. Held as an
        // ExprBinary rather than a new node: the RHS as written is exactly what
        // the printer has to emit after the arrow.
        if (p.verbatim) { acc = e_binary("|>", acc, right_expr); continue; }
        acc = pipe_desugar(acc, right_expr);
    }
    return (acc, p);
}

// parse_stmt: `var x = expr;`, `return expr;`, or `expr;`.
// parse_block consumes `{ stmt; stmt; … }` and returns the
// resulting Stmt[]. The opening `{` is expected to be the current
// token. On malformed input — missing `{` or `}` — the result is
// a single StmtUnknown so the outer caller can still surface a
// reasonable error site.

function parse_block(p: Par): (Stmt[], Par) {
    if (p.peek_punct() != "{") {
        var miss: Stmt[] = [s_unknown("missing { in block")];
        return (miss, p);
    }
    p = p.advance();
    var (r_body, r_p) = parse_block_body(p);
    p = r_p;
    if (p.peek_punct() == "}") { p = p.advance(); }
    return (r_body, p);
}

// parse_block_body parses statements up to (but not consuming) the block's
// closing `}`. Split from parse_block so the callback-passing `use` bind can
// recurse on the rest of the block.
function parse_block_body(p: Par): (Stmt[], Par) {
    var body: Stmt[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
        // `use NAME [: TYPE] <- CALL;` — monadic-bind / callback-passing sugar
        // (native parseUse). The rest of the enclosing block becomes the body
        // of a callback lambda appended as CALL's last argument, and the block
        // returns CALL's result. `use n <- apply(41); <rest>` desugars to
        // `return apply(41, (n) => { <rest> });`. A nested `use` in <rest>
        // recurses. Without this the line shredded (#4335).
        if (p.peek_keyword() == "use") {
            p = p.advance(); // consume `use`
            var uname: string = p.peek_ident();
            if (uname.len() > 0) { p = p.advance(); }
            var utype: string = "";
            if (p.peek_punct() == ":") {
                p = p.advance();
                var (utn_name, utn_ret_arr, utn_fn_ret, utn_p) = parse_type_name(p);
                p = utn_p;
                utype = utn_name;
            }
            // `<-` lexes as `<` then `-`.
            if (p.peek_punct() == "<") { p = p.advance(); }
            if (p.peek_punct() == "-") { p = p.advance(); }
            var (usrc_expr, usrc_p) = parse_expr(p);
            p = usrc_p;
            if (p.peek_punct() == ";") { p = p.advance(); }
            // The rest of the block is the callback body (recurse so a further
            // `use` chains).
            var (rest_body, rest_p) = parse_block_body(p);
            p = rest_p;
            var cbparam: ParamDecl = ParamDecl { name: uname, type_name: utype, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "", fn_param_types: "" };
            var cbparams: ParamDecl[] = [cbparam];
            // use_infer marks the synthesised callback when the user wrote
            // no `: TYPE` — the checker's E032 rule verifies the binding
            // type is inferrable from the callee's signature (native
            // inferUseParam). An annotated `use n: T <- …` never draws E032.
            var cb: Expr = ExprLambda { params: cbparams, ret_type: "", body: rest_body, use_infer: utype.len() == 0 };
            match (usrc_expr) {
                ExprCall(c) => {
                    var newargs: Expr[] = c.args.append(cb);
                    body = body.append(s_return(e_call(c.callee, newargs)));
                },
                _ => {
                    body = body.append(s_unknown("use source must be a function call"));
                },
            }
            return (body, p);
        }
        var (r_stmt, r_p) = parse_stmt(p);
        // Guarantee progress: a malformed statement that doesn't consume a
        // token would otherwise spin forever — skip it instead.
        if (r_p.pos == p.pos) {
            p = p.advance();
            continue;
        }
        p = r_p;
        body = body.append(r_stmt);
    }
    return (body, p);
}

// parse_block_or_stmt accepts EITHER a braced `{ … }` block OR a single
// braceless statement, wrapping the latter in a one-element body. Native
// control-flow bodies (if-then/else, while, loop, `for x in it`) are a
// `parseStmt`, so `if (x == 0) x = 40;` is valid there; the self-host used
// to require `{` and mis-parsed a braceless body into an
// `/*unknown-stmt: missing { in block*/` with the real statement hoisted to
// run unconditionally (#4337). Only the control-flow body sites route here;
// function / match-arm / lambda blocks still require braces.
function parse_block_or_stmt(p: Par): (Stmt[], Par) {
    if (p.peek_punct() == "{") { return parse_block(p); }
    var (r_stmt, r_p) = parse_stmt(p);
    // Guarantee progress on a malformed body token rather than spinning.
    if (r_p.pos == p.pos) {
        var none: Stmt[] = [s_unknown("missing statement in braceless body")];
        return (none, p.advance());
    }
    var one: Stmt[] = [r_stmt];
    return (one, r_p);
}

// parse_pattern reads a single match-arm pattern. Forms accepted:
//   _                  — PatWildcard
//   Name               — PatVariant { type_name: Name, binding: "" }
//   Name(_)            — PatVariant { type_name: Name, binding: "_" }
//   Name(ident)        — PatVariant { type_name: Name, binding: ident }
// The lexer treats `_` as an identifier (underscore is a valid
// alpha byte) so wildcards arrive here via peek_ident.

function parse_pattern(p: Par): (Pattern, Par) {
    // Accumulates the condition implied by any literal payload slots; see
    // PatVariant.lit_cond.
    var lit_cond: Expr = e_bool(true);
    var has_lit_cond: boolean = false;
    var tup_kinds: i32[] = [];
    var tup_binds: string[] = [];
    var tup_lits: Expr[] = [];
    var tup_pats: Pattern[] = [];
    var name: string = p.peek_ident();
    // `n @ Variant(...)` — bind the whole matched value to `n` while also
    // matching the variant. Consume the `IDENT @` prefix; the variant name
    // follows. Only meaningful before a variant pattern.
    var at_binding: string = "";
    if (name.len() > 0 && name != "_" && p.peek2_punct() == "@") {
        at_binding = name;
        p = p.advance();  // binder name
        p = p.advance();  // `@`
        name = p.peek_ident();
    }
    // `true` / `false` arms (and other keyword-named patterns) arrive as
    // keyword tokens, not idents — fall back to the keyword text.
    if (name.len() == 0) { name = p.peek_keyword(); }
    if (name == "_") {
        p = p.advance();
        return (p_wildcard(), p);
    }
    // A literal-pattern arm (`1 => …`, `"yes" => …`) only reaches
    // parse_pattern when an EARLIER arm wasn't a literal (so the whole
    // match took the variant path) — e.g. a wildcard-first match
    // `_ => …, 1 => …`, which is itself an E026 error. The literal token
    // is not an ident/keyword, so without consuming it here the cursor
    // would stick on it: the arm's `=>` and body would fail to parse,
    // corrupting the return-path (E052) analysis. Consume it and yield a
    // bare PatVariant("") — the empty type-name is skipped by the E028 /
    // E015 variant checks, leaving only the E026 the misplaced wildcard
    // already earns.
    if (p.peek_is_pat_literal()) {
        p = p.advance();
        return (p_variant("", ""), p);
    }
    if (name.len() == 0) {
        return (p_variant("", ""), p);
    }
    p = p.advance();
    // Qualified variant pattern: `pkg.Variant` (e.g.
    // `lexer.TokNumber(n)`). Consume the `.ident` suffix chain so
    // cross-module variant patterns parse. Without this the `.` is
    // left on the cursor and parse_match_stmt's arm loop can't
    // advance — it spins, allocating until OOM. parser.fern's own
    // matches use `lexer.TokX(...)` throughout, so this is required
    // for the self-host parser to parse its own source. Same gap as
    // parse_type_name's qualified-name handling.
    while (p.peek_punct() == ".") {
        p = p.advance();  // consume `.`
        var seg: string = p.peek_ident();
        if (seg.len() == 0) { seg = p.peek_keyword(); }
        if (seg.len() == 0) { break; }
        name = name + "." + seg;
        p = p.advance();
    }
    var binding: string = "";
    var extra_bindings: string[] = [];
    var nested: Pattern[] = [];
    var field_names: string[] = [];
    if (p.peek_punct() == "{") {
        // Record-form pattern `Rect { h, w }`: each entry names a FIELD, bound to
        // a local of the same name, and the order is free. The names are recorded
        // as written and both bindings and order are settled later, against the
        // variant's declaration, by resolve_variant_fields_module.
        //
        // field_names holds the FIELDS and the bindings the LOCALS they were bound
        // to — the same pair native carries. They differ only under the `f: local`
        // renaming form, which parses here (native accepts it syntactically too)
        // and is rejected by the checker.
        p = p.advance();
        while (p.peek_punct() != "}" && !p.at_end()) {
            var fnm: string = p.peek_ident();
            if (fnm.len() == 0) { p = p.advance(); continue; }
            p = p.advance();
            var local: string = fnm;
            if (p.peek_punct() == ":") {
                p = p.advance();
                var ren: string = p.peek_ident();
                if (ren.len() > 0) { local = ren; p = p.advance(); }
            }
            field_names = field_names.append(fnm);
            if (field_names.len() == 1) { binding = local; } else { extra_bindings = extra_bindings.append(local); }
            if (p.peek_punct() == ",") { p = p.advance(); }
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
    } else if (p.peek_punct() == "(") {
        p = p.advance();
        // Parse comma-separated payload bindings: `Variant(a, b, …)`. The
        // first is `binding`; the rest go to `extra_bindings` so the checker
        // can flag a payload-arity mismatch (E015). Single-payload variants
        // (all the self-host supports) use only `binding`.
        //
        // A single-payload slot that itself begins a variant pattern
        // (`Some(Ok(n))` — an ident followed by `(` / `{` / `.`) is a NESTED
        // sub-pattern: recurse and record it in `nested`; desugar_nested_arms
        // later rewrites the arm to a flat outer arm + inner match. A bare
        // ident stays a plain binder, so `Some(x)` is unchanged.
        var bn: i32 = 0;
        while (p.peek_punct() != ")" && !p.at_end()) {
            if (bn == 0 && p.peek_ident().len() > 0
                && (p.peek2_punct() == "(" || p.peek2_punct() == "{" || p.peek2_punct() == ".")) {
                var (sub_pat, sub_p) = parse_pattern(p);
                p = sub_p;
                nested = nested.append(sub_pat);
                bn = bn + 1;
            } else if (bn == 0 && p.peek_punct() == "(") {
                // A TUPLE sub-pattern in the slot (`Pr((a, b))`). Pattern has
                // no tuple case, so the elements ride on PatVariant and
                // build_merged_arm turns them into a tuple inner match.
                var (tk, tb, tl, tpp, tp) = parse_tuple_arm_pattern(p);
                p = tp;
                tup_kinds = tk;
                tup_binds = tb;
                tup_lits = tl;
                tup_pats = tpp;
                binding = "__tupslot";
                bn = bn + 1;
            } else if (p.peek_is_pat_literal()) {
                // A literal payload slot (`Sm(0)`) tests the payload rather
                // than binding it. Bind the slot to a synthetic name and
                // record `name == literal`; the arm builder folds that into
                // the arm's guard, so every backend sees an ordinary guarded
                // arm. Dropping the token here — which is what used to
                // happen — left a bare `Sm` arm that matched every payload.
                var lit_line: i32 = p.peek_line();
                var lit_col: i32 = p.peek_col();
                var (lit_expr, lit_p) = parse_binary(p, 4);
                p = lit_p;
                var slot: string = "__pl" + dl_itoa(lit_line) + "_" + dl_itoa(lit_col);
                if (bn == 0) { binding = slot; } else { extra_bindings = extra_bindings.append(slot); }
                var one = e_binary("==", e_ident(slot), lit_expr);
                if (has_lit_cond) { lit_cond = e_binary("&&", lit_cond, one); } else { lit_cond = one; }
                has_lit_cond = true;
                bn = bn + 1;
            } else {
                var inner: string = p.peek_ident();
                if (inner.len() > 0) {
                    if (bn == 0) { binding = inner; } else { extra_bindings = extra_bindings.append(inner); }
                    bn = bn + 1;
                    p = p.advance();
                } else {
                    p = p.advance();
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); }
        }
        if (p.peek_punct() == ")") { p = p.advance(); }
    }
    return (PatVariant { type_name: name, binding: binding, extra_bindings: extra_bindings, nested: nested, at_binding: at_binding, field_names: field_names, lit_cond: lit_cond, has_lit_cond: has_lit_cond, tup_kinds: tup_kinds, tup_binds: tup_binds, tup_lits: tup_lits, tup_pats: tup_pats }, p);
}

// prepend_stmt returns a fresh statement list with `s` in front of `body`.
// Isolating the concat in a helper (rather than an inline `var xs: Stmt[] =
// []` + appends of field-derived elements) keeps the element type canonical
// through the parameter, so the imported-module type mangling stays
// consistent.
function prepend_stmt(s: Stmt, body: Stmt[]): Stmt[] {
    var out: Stmt[] = [];
    out = out.append(s);
    var i: i32 = 0;
    while (i < body.len()) {
        out = out.append(body[i]);
        i = i + 1;
    }
    return out;
}

// pv_tup returns a pattern's tuple sub-pattern encoding, empty for a wildcard.
pub function pv_tup(pat: Pattern): (i32[], string[], Expr[], Pattern[]) {
    var no_k: i32[] = [];
    var no_b: string[] = [];
    var no_l: Expr[] = [];
    var no_p: Pattern[] = [];
    match (pat) {
        PatVariant(v) => { return (v.tup_kinds, v.tup_binds, v.tup_lits, v.tup_pats); },
        PatWildcard(w) => { return (no_k, no_b, no_l, no_p); }
    }
    return (no_k, no_b, no_l, no_p);
}

// pv_name returns a pattern's variant type-name, or "" for a wildcard.
function pv_name(pat: Pattern): string {
    match (pat) {
        PatVariant(v) => { return v.type_name; },
        PatWildcard(w) => { return ""; }
    }
    return "";
}

// arm_is_nested reports whether an arm's pattern carries a nested sub-pattern.
function arm_is_nested(arm: MatchArm): boolean {
    match (arm.pattern) {
        PatVariant(v) => { return v.nested.len() > 0 || v.tup_kinds.len() > 0; },
        PatWildcard(w) => { return false; }
    }
    return false;
}

// desugar_nested_arms rewrites arms carrying nested sub-patterns
// (`Some(Ok(n))`) into flat arms whose body re-matches the payload on an
// inner match, grouping contiguous same-variant arms into one merged arm
// `V(__nest…) => match __nest… { … }`. A no-op returning the arms unchanged
// when no arm nests — so every existing match (the whole self-host source
// among them) parses byte-identically. `depth` keeps the synthesised payload
// temp unique across nesting levels, and `tag` across callers that synthesise
// arms sharing one line/col — pass "" when the arms come from distinct source
// positions. Recurses so `Some(Ok(Some(x)))` desugars at every depth.
function desugar_nested_arms(arms: MatchArm[], depth: i32, tag: string): MatchArm[] {
    // Any-nested short-circuit: leaves the common (flat) case allocation-free
    // and, more importantly, byte-identical to the pre-feature output.
    var seen_nested: boolean = false;
    var s: i32 = 0;
    while (s < arms.len()) {
        if (arm_is_nested(arms[s])) { seen_nested = true; }
        s = s + 1;
    }
    if (!seen_nested) { return arms; }
    // An unguarded trailing `_` is the outer fallthrough: copied into each
    // merged inner match so a payload matching no inner pattern runs it.
    var fall: Stmt[] = [];
    var has_fall: boolean = false;
    if (arms.len() > 0) {
        var last: MatchArm = arms[arms.len() - 1];
        if (pv_name(last.pattern) == "" && !last.has_guard) {
            fall = last.body;
            has_fall = true;
        }
    }
    var out: MatchArm[] = [];
    var i: i32 = 0;
    while (i < arms.len()) {
        var vn: string = pv_name(arms[i].pattern);
        if (vn == "") {
            out = out.append(arms[i]);
            i = i + 1;
        } else {
            var j: i32 = i;
            while (j < arms.len() && pv_name(arms[j].pattern) == vn) { j = j + 1; }
            var any_nested: boolean = false;
            var k: i32 = i;
            while (k < j) { if (arm_is_nested(arms[k])) { any_nested = true; } k = k + 1; }
            if (!any_nested) {
                var c: i32 = i;
                while (c < j) { out = out.append(arms[c]); c = c + 1; }
            } else {
                out = out.append(build_merged_arm(vn, arms, i, j, fall, has_fall, depth, tag));
            }
            i = j;
        }
    }
    return out;
}

// build_merged_arm collapses one contiguous run of same-variant arms
// (arms[lo..hi], at least one nested) into a single flat arm
// `V(__nest) => match __nest { <inner arms> }`. A flat sibling arm rebinds
// the whole payload to its binder; a trailing outer `_` becomes the inner
// wildcard so unmatched payloads fall through.
// group_has_tuple reports whether any arm of a merged variant group carries a
// tuple sub-pattern, which decides whether the inner match is a tuple match.
function group_has_tuple(arms: MatchArm[], lo: i32, hi: i32): boolean {
    var i: i32 = lo;
    while (i < hi) {
        match (arms[i].pattern) {
            PatVariant(v) => { if (v.tup_kinds.len() > 0) { return true; } },
            PatWildcard(w) => {}
        }
        i = i + 1;
    }
    return false;
}

// tuple_elems_irrefutable reports whether every element matches every value —
// a binder (kind 0), a `_` (kind 1), or a nested tuple (kind 4) all of whose
// own elements do. A literal (kind 2) and a variant sub-pattern (kind 3) can
// fail, at any depth.
function tuple_elems_irrefutable(kinds: i32[], pats: Pattern[]): boolean {
    var i: i32 = 0;
    while (i < kinds.len()) {
        if (kinds[i] == 2 || kinds[i] == 3) { return false; }
        if (kinds[i] == 4) {
            var (nk, nb, nl, np) = pv_tup(pats[i]);
            if (!tuple_elems_irrefutable(nk, np)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

function build_merged_arm(vn: string, arms: MatchArm[], lo: i32, hi: i32, fall: Stmt[], has_fall: boolean, depth: i32, tag: string): MatchArm {
    var gp_line: i32 = arms[lo].line;
    var gp_col: i32 = arms[lo].col;
    var tmp: string = "__nest_" + util.i32_to_string(gp_line) + "_" + util.i32_to_string(gp_col) + "_" + util.i32_to_string(depth) + tag;
    var inner: MatchArm[] = [];
    var has_inner_wild: boolean = false;
    var k: i32 = lo;
    while (k < hi) {
        var g: MatchArm = arms[k];
        var inner_pat: Pattern = p_wildcard();
        var inner_body: Stmt[] = g.body;
        match (g.pattern) {
            PatVariant(gv) => {
                if (gv.nested.len() > 0) {
                    inner_pat = gv.nested[0];
                } else if (gv.binding.len() > 0 && gv.binding != "_") {
                    // A flat sibling (`Some(x)`): rebind the whole payload.
                    inner_body = prepend_stmt(s_var(gv.binding, "", e_ident(tmp)), g.body);
                }
            },
            PatWildcard(w) => {}
        }
        if (pv_name(inner_pat) == "" && !g.has_guard) { has_inner_wild = true; }
        var (fn_pat, fn_g, fn_hg) = fold_lit_cond(inner_pat, g.guard, g.has_guard);
        inner = inner.append(MatchArm { pattern: fn_pat, body: inner_body, line: g.line, col: g.col, guard: fn_g, has_guard: fn_hg });
        k = k + 1;
    }
    if (!has_inner_wild && has_fall) {
        inner = inner.append(MatchArm { pattern: p_wildcard(), body: fall, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false });
    }
    // A TUPLE sub-pattern makes the inner match a TUPLE match. Same merge
    // shape as the variant case — the slot binds a temp and each arm of the
    // group contributes one inner arm — but routed through build_tuple_match,
    // because Pattern cannot express a tuple. A flat sibling (`Pr(x)`) becomes
    // a wildcard tuple arm that rebinds the whole slot, exactly as it becomes
    // a wildcard variant arm on the other path.
    if (group_has_tuple(arms, lo, hi)) {
        var tarms: TupArm[] = [];
        var no_k: i32[] = [];
        var no_p: Pattern[] = [];
        var no_b: string[] = [];
        var no_l: Expr[] = [];
        var tuple_covers: boolean = false;
        var q: i32 = lo;
        while (q < hi) {
            var ga: MatchArm = arms[q];
            match (ga.pattern) {
                PatVariant(gv2) => {
                    if (gv2.tup_kinds.len() > 0) {
                        if (!ga.has_guard && tuple_elems_irrefutable(gv2.tup_kinds, gv2.tup_pats)) { tuple_covers = true; }
                        tarms = tarms.append(TupArm { is_wild: false, elem_kinds: gv2.tup_kinds, binds: gv2.tup_binds, lits: gv2.tup_lits, elem_pats: gv2.tup_pats, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: ga.body, line: ga.line, col: ga.col });
                    } else {
                        var b2: Stmt[] = ga.body;
                        if (gv2.binding.len() > 0 && gv2.binding != "_") {
                            b2 = prepend_stmt(s_var(gv2.binding, "", e_ident(tmp)), ga.body);
                        }
                        if (!ga.has_guard) { tuple_covers = true; }
                        tarms = tarms.append(TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: b2, line: ga.line, col: ga.col });
                    }
                },
                PatWildcard(w2) => {}
            }
            q = q + 1;
        }
        // Only route the outer fallthrough in when nothing above already
        // covers every value — an all-binder tuple arm does, and appending
        // after it would emit an arm that can never run.
        if (!tuple_covers && has_fall) {
            tarms = tarms.append(TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: e_bool(true), has_guard: false, body: fall, line: gp_line, col: gp_col });
        }
        var tmatch: Stmt = build_tuple_match(e_ident(tmp), tarms, gp_line, gp_col);
        var t_no_extra: string[] = [];
        var t_no_nested: Pattern[] = [];
        var t_nk: i32[] = [];
        var t_nb: string[] = [];
        var t_nl: Expr[] = [];
        var t_np: Pattern[] = [];
        var t_merged: Pattern = PatVariant { type_name: vn, binding: tmp, extra_bindings: t_no_extra, nested: t_no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: t_nk, tup_binds: t_nb, tup_lits: t_nl, tup_pats: t_np };
        var t_body: Stmt[] = [tmatch];
        return MatchArm { pattern: t_merged, body: t_body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false };
    }
    var inner_desugared: MatchArm[] = desugar_nested_arms(inner, depth + 1, tag);
    var inner_match: Stmt = s_match_at(e_ident(tmp), inner_desugared, gp_line, gp_col);
    var no_extra: string[] = [];
    var no_nested: Pattern[] = [];
    var no_tup_kinds: i32[] = [];
    var no_tup_binds: string[] = [];
    var no_tup_lits: Expr[] = [];
    var no_tup_pats: Pattern[] = [];
    var merged_pat: Pattern = PatVariant { type_name: vn, binding: tmp, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
    var body: Stmt[] = [inner_match];
    return MatchArm { pattern: merged_pat, body: body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false };
}

// parse_match_stmt consumes `match (scrutinee) { arm, arm, … }`
// starting from the `match` keyword. Arms separate with `,`
// (trailing comma optional). Each arm is `Pat => { stmts… }`.
// Malformed input recovers by yielding an empty-arm StmtMatch
// — the surrounding parse_module loop continues at the next
// token.

function parse_match_stmt(p: Par): (Stmt, Par) {
    // E030 (non-exhaustive match) is reported at the `match` keyword.
    var mkline: i32 = p.peek_line();
    var mkcol: i32 = p.peek_col();
    p = p.advance();  // consume `match`
    var empty_arms: MatchArm[] = [];
    if (p.peek_punct() != "(") {
        return (s_match(e_unknown("match: missing ("), empty_arms), p);
    }
    p = p.advance();
    var (sr_expr, sr_p) = parse_expr(p);
    p = sr_p;
    if (p.peek_punct() == ")") { p = p.advance(); }
    if (p.peek_punct() != "{") {
        return (s_match_at(sr_expr, empty_arms, mkline, mkcol), p);
    }
    p = p.advance();
    // A `(` at the FIRST arm's pattern position marks a match on a
    // TUPLE scrutinee: parse every arm as a tuple pattern / `_` and
    // desugar to the flag-chain build_tuple_match emits.
    if (p.peek_punct() == "(" || (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(")) {
        var tarms: TupArm[] = [];
        while (p.peek_punct() != "}" && !p.at_end()) {
            var taline: i32 = p.peek_line();
            var tacol: i32 = p.peek_col();
            var t_wild: boolean = false;
            var t_empty_body: Stmt[] = [];
            var t_at: string = "";
            // Optional `name @` prefix: bind the whole matched tuple to
            // `name` while destructuring its elements (`w @ (a, b)`).
            if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
                t_at = p.peek_ident();
                p = p.advance();
                p = p.advance();
            }
            // Buffer each `|` alternative as a partial TupArm (guard + body
            // filled in once parsed). A TupArm[] is the same struct-array
            // build_tuple_match already consumes, so its array fields stay
            // on the IR-eligible path — no bare nested-array locals.
            var tpats: TupArm[] = [];
            if (p.peek_punct() == "(") {
                var (tpr_elem_kinds, tpr_binds, tpr_lits, tpr_pats, tpr_p) = parse_tuple_arm_pattern(p);
                p = tpr_p;
                if (tpr_elem_kinds.len() == 0) {
                    return (s_unknown("bad tuple pattern"), p);
                }
                tpats = tpats.append(TupArm { is_wild: false, elem_kinds: tpr_elem_kinds, binds: tpr_binds, lits: tpr_lits, elem_pats: tpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol });
                // Tuple or-patterns: `(1, 2) | (3, 4) => …`. Each `|`
                // alternative becomes its own TupArm sharing the guard +
                // body (per-alternative binds), matching the literal path
                // above and the native per-alternative desugar.
                while (p.peek_punct() == "|") {
                    p = p.advance();
                    var (tor_kinds, tor_binds, tor_lits, tor_pats, tor_p) = parse_tuple_arm_pattern(p);
                    p = tor_p;
                    if (tor_kinds.len() == 0) {
                        return (s_unknown("bad tuple pattern"), p);
                    }
                    tpats = tpats.append(TupArm { is_wild: false, elem_kinds: tor_kinds, binds: tor_binds, lits: tor_lits, elem_pats: tor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol });
                }
            } else {
                var (twp_pattern, twp_p) = parse_pattern(p);
                p = twp_p;
                t_wild = true;
            }
            var t_guard: Expr = e_bool(true);
            var t_has_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (tgr_expr, tgr_p) = parse_expr(p);
                p = tgr_p;
                t_guard = tgr_expr;
                t_has_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            var (tbb_body, tbb_p) = parse_block(p);
            p = tbb_p;
            if (t_wild) {
                var tw_kinds: i32[] = [];
                var tw_pats: Pattern[] = [];
                var tw_binds: string[] = [];
                var tw_lits: Expr[] = [];
                tarms = tarms.append(TupArm { is_wild: true, elem_kinds: tw_kinds, binds: tw_binds, lits: tw_lits, elem_pats: tw_pats, at_binding: "", guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol });
            } else {
                var talt: i32 = 0;
                while (talt < tpats.len()) {
                    var tpa: TupArm = tpats[talt];
                    tarms = tarms.append(TupArm { is_wild: false, elem_kinds: tpa.elem_kinds, binds: tpa.binds, lits: tpa.lits, elem_pats: tpa.elem_pats, at_binding: t_at, guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol });
                    talt = talt + 1;
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return (build_tuple_match(sr_expr, tarms, mkline, mkcol), p);
    }
    // An `Ident {` at the FIRST arm marks a STRUCT-pattern match (see
    // parse_match_expr) — desugar to the field-bind flag chain.
    if (is_struct_pattern_arm(p) && ((p.peek_ident().len() > 0 && p.peek2_punct() == "{") || (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{"))) {
        var (smarms, smrt, smok, smp) = parse_struct_match_arms(p, false);
        p = smp;
        if (!smok) { return (s_unknown("a struct pattern binds field names"), p); }
        return (build_struct_match(sr_expr, smarms, mkline, mkcol), p);
    }
    // A literal at the FIRST arm's pattern position marks a match on a
    // non-enum (i32 / string) scrutinee: parse every arm as a literal /
    // `_` and desugar to an if/else-if chain (build_literal_match). The
    // decision is made once, up front, so the common enum/variant match
    // takes the normal StmtMatch path below with no extra allocation.
    if (p.peek_is_pat_literal()) {
        var lit_arms: LitArm[] = [];
        while (p.peek_punct() != "}" && !p.at_end()) {
            var laline: i32 = p.peek_line();
            var lacol: i32 = p.peek_col();
            var lwild: boolean = false;
            var lalt_lits: Expr[] = [];
            var lalt_his: Expr[] = [];
            var lalt_hrs: boolean[] = [];
            var lalt_incs: boolean[] = [];
            if (p.peek_is_pat_literal()) {
                var (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
                p = la_p;
                lalt_lits = la_lits;
                lalt_his = la_his;
                lalt_hrs = la_hrs;
                lalt_incs = la_incs;
            } else {
                var (lpr_pattern, lpr_p) = parse_pattern(p);
                p = lpr_p;
                lwild = true;
            }
            var lguard: Expr = e_bool(true);
            var lhas_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (lgr_expr, lgr_p) = parse_expr(p);
                p = lgr_p;
                lguard = lgr_expr;
                lhas_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            var (lbb_body, lbb_p) = parse_block(p);
            p = lbb_p;
            if (lwild) {
                lit_arms = lit_arms.append(LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false });
            } else {
                // One LitArm per `|` alternative, sharing the guard + body.
                var lai: i32 = 0;
                while (lai < lalt_lits.len()) {
                    lit_arms = lit_arms.append(LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai] });
                    lai = lai + 1;
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return (build_literal_match(sr_expr, lit_arms, mkline, mkcol), p);
    }
    var arms: MatchArm[] = [];
    var written: MatchArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
        // E026 / E028 are reported at the arm (Go's `arm.P`), which is the
        // pattern's first token.
        var aline: i32 = p.peek_line();
        var acol: i32 = p.peek_col();
        var (pr_pattern, pr_p) = parse_pattern(p);
        p = pr_p;
        // Or-patterns: `A | B | … => body`. Each `|`-separated variant
        // pattern becomes its own MatchArm sharing the guard + body, so the
        // checker (exhaustiveness) and lowering see a flat arm list. Bindings
        // are per-alternative; the body only sees those the alternative
        // introduces. (Variant patterns only — a literal arm takes the
        // build_literal_match path above, and bare `|` is bitwise-or there.)
        var pats: Pattern[] = [pr_pattern];
        while (p.peek_punct() == "|") {
            p = p.advance();
            var (pr2_pattern, pr2_p) = parse_pattern(p);
            p = pr2_p;
            pats = pats.append(pr2_pattern);
        }
        // Optional guard: `Pattern when <expr> => …`. The arm matches only
        // when the guard is true (E027 checks it is boolean). Applies to
        // every alternative of an or-pattern.
        var arm_guard: Expr = e_bool(true);
        var arm_has_guard: boolean = false;
        if (p.peek_keyword() == "when") {
            p = p.advance();
            var (gr_expr, gr_p) = parse_expr(p);
            p = gr_p;
            arm_guard = gr_expr;
            arm_has_guard = true;
        }
        // `=>` arrives as a single punct token from the lexer.
        if (p.peek_punct() == "=>") {
            p = p.advance();
        }
        var (bb_body, bb_p) = parse_block(p);
        p = bb_p;
        var pi: i32 = 0;
        while (pi < pats.len()) {
            // The WRITTEN arm goes to `sugar` before fold_lit_cond moves a
            // literal payload into the guard and before desugar_nested_arms
            // merges a nested one — those two are what the printer must not
            // reprint in place of the source.
            written = written.append(MatchArm { pattern: pats[pi], body: bb_body, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard });
            var (fs_pat, fs_g, fs_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
            arms = arms.append(MatchArm { pattern: fs_pat, body: bb_body, line: aline, col: acol, guard: fs_g, has_guard: fs_hg });
            pi = pi + 1;
        }
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    var sugar: MatchArm[] = [];
    if (arms_have_written_form(written)) { sugar = written; }
    arms = desugar_nested_arms(arms, 0, "");
    return (s_match_sugared(sr_expr, arms, sugar, mkline, mkcol), p);
}

// arms_have_written_form reports whether any arm's pattern carries something
// the lowering consumes — a nested payload or a literal one — so the written
// arms are worth keeping for the printer. False for every ordinary match.
function arms_have_written_form(written: MatchArm[]): boolean {
    var i: i32 = 0;
    while (i < written.len()) {
        match (written[i].pattern) {
            PatVariant(v) => {
                if (v.nested.len() > 0 || v.has_lit_cond) { return true; }
            },
            PatWildcard(w) => {}
        }
        i = i + 1;
    }
    return false;
}

// expr_mentions / stmts_mention report whether `name` appears as an
// identifier anywhere in an expression / statement list. Used to detect a
// self-recursive local function (whose body references its own name) —
// the closure-valued-local desugar below can't bind the name before the
// lambda captures it, so recursion needs top-level hoisting (closureconv),
// which isn't ported yet. Conservative: any mention counts.
pub function expr_mentions(e: Expr, name: string): boolean {
    match (e) {
        ExprIdent(id) => { return id.name == name; },
        ExprBinary(b) => { return expr_mentions(b.left, name) || expr_mentions(b.right, name); },
        ExprUnary(u) => { return expr_mentions(u.operand, name); },
        ExprCall(c) => {
            if (expr_mentions(c.callee, name)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_mentions(c.args[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_mentions(a.elements[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                if (expr_mentions(t.elements[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprIndex(ix) => { return expr_mentions(ix.array, name) || expr_mentions(ix.index, name); },
        ExprSlice(sl) => { return expr_mentions(sl.array, name) || expr_mentions(sl.start, name) || expr_mentions(sl.end, name); },
        ExprFieldAccess(fa) => { return expr_mentions(fa.obj, name); },
        ExprStructLit(s) => {
            if (s.has_base && expr_mentions(s.base, name)) { return true; }
            var i: i32 = 0;
            while (i < s.field_values.len()) {
                if (expr_mentions(s.field_values[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprLambda(lm) => { return stmts_mention(lm.body, name); },
        _ => { return false; }
    }
}

pub function stmt_mentions(st: Stmt, name: string): boolean {
    match (st) {
        StmtVar(v) => { return expr_mentions(v.init, name); },
        StmtReturn(r) => { return expr_mentions(r.value, name); },
        StmtExpr(e) => { return expr_mentions(e.value, name); },
        StmtAssign(a) => { return expr_mentions(a.value, name); },
        StmtIf(f) => { return expr_mentions(f.cond, name) || stmts_mention(f.then_body, name) || stmts_mention(f.else_body, name); },
        StmtWhile(w) => { return expr_mentions(w.cond, name) || stmts_mention(w.body, name); },
        StmtFor(fr) => { return expr_mentions(fr.iter, name) || stmts_mention(fr.body, name); },
        StmtMatch(m) => {
            if (expr_mentions(m.scrutinee, name)) { return true; }
            var i: i32 = 0;
            while (i < m.arms.len()) {
                if (stmts_mention(m.arms[i].body, name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; }
    }
}

pub function stmts_mention(stmts: Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        if (stmt_mentions(stmts[i], name)) { return true; }
        i = i + 1;
    }
    return false;
}

// parse_loop_stmt parses `loop { body }` — the canonical infinite loop —
// and desugars it to `while (true) { body }` so it rides the existing
// StmtWhile IR lowering (block/loop/br_if) with no new node or emitter
// arm. Kept in its own function so parse_stmt (already very large) doesn't
// grow — an oversized function miscompiles on the native backend (#2720).
function parse_loop_stmt(p: Par): (Stmt, Par) {
    var p2: Par = p.advance();
    var (lb_body, lb_p) = parse_block_or_stmt(p2);
    // `loop` and `while (true)` are the same loop to every consumer below the
    // printer, which is why one node models both; is_loop records which was
    // written so a reformat does not rewrite one into the other.
    return (StmtWhile { cond: e_bool(true), body: lb_body, label: "", line: 0, is_loop: true }, lb_p);
}

// parse_for_stmt parses a `for` statement (`p` is positioned at the
// `for` keyword). Split out of parse_stmt's keyword dispatch so that
// already-large function stays under the native backend's per-function
// size limit (oversized functions miscompile — cf. #2720). Three forms:
// `for (k, v) in m { body }` (map destructuring), `for x in EXPR { body }`
// (array / range foreach), and the range form `for i in LOW..HIGH` /
// `for i in LOW..=HIGH` — the latter two encode the interval as a
// synthetic `__range` / `__range_incl` call (see below).
function parse_for_stmt(p: Par): (Stmt, Par) {
    // `for VAR in EXPR { body }`. `in` arrives as a plain
    // TokIdent (not in the lexer's keyword set), so peek
    // it through peek_ident rather than peek_keyword.
    p = p.advance();  // consume `for`
    // `for (k, v) in m { body }` — map destructuring iteration. The
    // two names are encoded as "k,v" in the for-var; the emitter
    // detects the comma + a map iter and emits an iterator loop.
    if (p.peek_punct() == "(") {
        var cfl: i32 = p.peek_line();
        var cfc: i32 = p.peek_col();
        p = p.advance();
        // C-style `for (INIT; COND; STEP) { BODY }` — distinguished from the
        // `for (k, v) in m` map form by a top-level `;` in the header (the map
        // form has none). Native accepts a `var` init, an expression init, or
        // an empty init/cond (`parser.go` parseFor); the self-host previously
        // gated only on a `var` init (#2820), so `for (i = 0; …)` / `for (;
        // …)` fell into the map arm and shredded (#4339). The Stmt union has
        // no C-style-for node, so desugar to a scoped while loop with a
        // first-iteration flag, so a `continue` re-runs STEP (matching C
        // semantics) instead of skipping it. Reuses if / while / break.
        //
        // Detect via a lookahead: scan a copy of the cursor for a top-level
        // `;` before the matching `)`, tracking ()[]{} nesting depth.
        var scan: Par = p;
        var sc_depth: i32 = 0;
        var is_cfor: boolean = false;
        while (!scan.at_end()) {
            var sp: string = scan.peek_punct();
            if (sp == "(" || sp == "[" || sp == "{") { sc_depth = sc_depth + 1; }
            else if (sp == ")" || sp == "]" || sp == "}") {
                if (sc_depth == 0) { break; }
                sc_depth = sc_depth - 1;
            }
            else if (sp == ";" && sc_depth == 0) { is_cfor = true; break; }
            scan = scan.advance();
        }
        if (is_cfor) {
            // INIT: empty (`;`), `var …`, or an expression statement — each
            // terminated by `;` (parse_stmt eats it for the var/expr forms).
            var initstmts: Stmt[] = [];
            if (p.peek_punct() == ";") {
                p = p.advance();
            } else {
                var (fcinit_stmt, fcinit_p) = parse_stmt(p);
                p = fcinit_p;
                initstmts = [fcinit_stmt];
            }
            // COND: empty means "always true" (`for (…; ; …)` loops forever).
            var condexpr: Expr = e_bool(true);
            if (p.peek_punct() != ";") {
                var (fccond_expr, fccond_p) = parse_expr(p);
                p = fccond_p;
                condexpr = fccond_expr;
            }
            if (p.peek_punct() == ";") { p = p.advance(); }
            var stepone: Stmt[] = [];                 // STEP (no `;`, stops at `)`)
            if (p.peek_punct() != ")") {
                var (fcstep_stmt, fcstep_p) = parse_stmt(p);
                p = fcstep_p;
                stepone = [fcstep_stmt];
            }
            if (p.peek_punct() == ")") { p = p.advance(); }
            var (fcbody_body, fcbody_p) = parse_block(p);
            p = fcbody_p;
            var flag: string = "__forc_" + util.i32_to_string(cfl) + "_" + util.i32_to_string(cfc);
            var noelse: Stmt[] = [];
            var wbody: Stmt[] = [];
            // if (!first) { STEP }   -- runs STEP before every iteration but
            //                           the first, so a `continue` runs it too.
            wbody = wbody.append(s_if(e_unary("!", e_ident(flag)), stepone, noelse));
            // first = false
            wbody = wbody.append(s_assign(flag, e_bool(false)));
            // if (!(COND)) { break }  — with an empty cond, COND is `true`, so
            // this is `if (!true) break`, i.e. never breaks (infinite loop).
            var breakone: Stmt[] = [s_break()];
            wbody = wbody.append(s_if(e_unary("!", condexpr), breakone, noelse));
            var fbi: i32 = 0;
            while (fbi < fcbody_body.len()) { wbody = wbody.append(fcbody_body[fbi]); fbi = fbi + 1; }
            // { INIT; var first = true; while (true) { <wbody> } }  (scoped via if-true)
            var outer: Stmt[] = [];
            var ini: i32 = 0;
            while (ini < initstmts.len()) { outer = outer.append(initstmts[ini]); ini = ini + 1; }
            outer = outer.append(s_var(flag, "", e_bool(true)));
            outer = outer.append(s_while(e_bool(true), wbody));
            return (s_if(e_bool(true), outer, noelse), p);
        }
        var kvk: string = p.peek_ident();
        if (kvk.len() > 0) { p = p.advance(); }
        if (p.peek_punct() == ",") { p = p.advance(); }
        var kvv: string = p.peek_ident();
        if (kvv.len() > 0) { p = p.advance(); }
        // `for (k, v,) in m` — the binder is a comma-separated list like any
        // other, so it takes a trailing comma. Without this the `)` and the
        // `in` are each one token further right than the fixed lookahead
        // expects: neither is consumed, `in` parses as an ordinary identifier
        // (it is not a lexer keyword), and the module bails. The native parser
        // learned this in #6358, which shipped the conformance fixture the
        // self-host then failed on all three legs.
        if (p.peek_punct() == ",") { p = p.advance(); }
        if (p.peek_punct() == ")") { p = p.advance(); }
        if (p.peek_ident() == "in") { p = p.advance(); }
        // Suppress trailing struct-literal parsing — the `{` that
        // follows the iter opens the loop body, not a struct lit.
        var kv_saved: boolean = p.no_struct;
        var (kvi_expr, kvi_p) = parse_expr(p.with_no_struct(true));
        p = (kvi_p).with_no_struct(kv_saved);
        var (kvb_body, kvb_p) = parse_block(p);
        p = kvb_p;
        return (s_for(kvk + "," + kvv, kvi_expr, kvb_body), p);
    }
    var fvar: string = p.peek_ident();
    if (fvar.len() == 0) {
        return (s_unknown("missing for-var name"), p);
    }
    p = p.advance();
    if (p.peek_ident() != "in") {
        return (s_unknown("missing `in` in for"), p);
    }
    p = p.advance();  // consume `in`
    // Suppress trailing struct-literal parsing on the iter so that
    // `for x in a {}` reads `a` + an empty block, not `a {}`.
    var f_saved: boolean = p.no_struct;
    // Read the iterable / LOW bound BELOW the range-expression level
    // (parse_binary, not parse_expr) so `for i in 0..n` stops at `..` and keeps
    // the counted-loop desugar below, instead of collapsing `0..n` into an
    // `iter.range(0, n)` iterator value.
    var (fiter_expr, fiter_p) = parse_binary(p.with_no_struct(true), 1);
    p = (fiter_p).with_no_struct(f_saved);
    var iter_expr: Expr = fiter_expr;
    // Range form `for IDENT in LOW..HIGH { body }`. parse_expr stops
    // at `..` (not a binary operator), so `fiter_expr` is LOW; read
    // `..` + HIGH and encode the half-open interval as a synthetic
    // `__range(LOW, HIGH)` call — the same parser-internal-builtin
    // idiom as `__set_index` / `__set_field`. The checker binds the
    // loop var to i32 and irlower lowers it to a counted loop; the
    // call shape rides through constfold / substitution / printing
    // for free (LOW, HIGH are ordinary i32 sub-expressions). The
    // inclusive form `LOW..=HIGH` emits `__range_incl(LOW, HIGH)`
    // instead, which irlower lowers with a `<=` (closed-interval)
    // condition.
    var range_punct: string = p.peek_punct();
    if (range_punct == ".." || range_punct == "..=") {
        p = p.advance();   // consume `..` or `..=`
        var hi_saved: boolean = p.no_struct;
        var (fhi_expr, fhi_p) = parse_binary(p.with_no_struct(true), 1);
        p = (fhi_p).with_no_struct(hi_saved);
        var rargs: Expr[] = [fiter_expr, fhi_expr];
        var range_fn: string = "__range";
        if (range_punct == "..=") { range_fn = "__range_incl"; }
        iter_expr = e_call(e_ident(range_fn), rargs);
    }
    var (fb_body, fb_p) = parse_block_or_stmt(p);
    p = fb_p;
    return (s_for(fvar, iter_expr, fb_body), p);
}

// with_stmt_line stamps the source line a statement STARTS on. Five Stmt kinds
// grew the field for the formatter, which places a comment by comparing its
// line against the line of the statement that follows it (#6769); the other
// kinds already carried a position from their own construction, and a
// synthesised statement keeps the 0 its literal gives it — the same
// "0 cannot name anything the user wrote" convention print_module already uses
// to skip `@derive`'s methods.
function with_stmt_line(st: Stmt, line: i32): Stmt {
    match (st) {
        StmtExpr(x) => { return StmtExpr { value: x.value, line: line }; },
        StmtIf(f) => { return StmtIf { ...f, line: line }; },
        StmtWhile(w) => { return StmtWhile { cond: w.cond, body: w.body, label: w.label, line: line, is_loop: w.is_loop }; },
        StmtFor(fo) => { return StmtFor { var_name: fo.var_name, iter: fo.iter, body: fo.body, label: fo.label, line: line }; },
        StmtDefer(d) => { return StmtDefer { action: d.action, on_error: d.on_error, line: line }; },
        _ => { return st; }
    }
    return st;
}

// parse_stmt parses one statement and stamps the line it began on.
function parse_stmt(p: Par): (Stmt, Par) {
    var stmt_line: i32 = p.peek_line();
    var (parsed, after) = parse_stmt_at(p);
    return (with_stmt_line(parsed, stmt_line), after);
}

function parse_stmt_at(p: Par): (Stmt, Par) {
    // A bare block `{ ... }` in statement position is its own scope. The
    // self-host Stmt union has no StmtBlock node, so desugar it to
    // `if (true) { ... }` — reusing the scoped if-body (the same trick
    // `loop` uses for `while (true)`), tagged so `-fmt` reprints the braces.
    // Map / struct literals only appear in expression position, so a leading
    // `{` here is unambiguously a block.
    if (p.peek_punct() == "{") {
        var (bb_body, bb_p) = parse_block(p);
        return (s_block(bb_body), bb_p);
    }
    // Loop label `outer: while (…) { … }` / `outer: for … ` / `outer: loop { … }`.
    // A leading `IDENT :` immediately before a loop keyword is a label (a bare
    // `IDENT :` at statement start has no other meaning). Capture it, consume the
    // `IDENT :`, and attach it to the loop below via with_loop_label; a labeled
    // `break outer` / `continue outer` targets it (resolve_labels bakes the
    // relative depth into the break/continue tag).
    var loop_label: string = "";
    var llid: string = p.peek_ident();
    if (llid.len() > 0) {
        var lp1: Par = p.advance();
        if (lp1.peek_punct() == ":") {
            var lp2: Par = lp1.advance();
            var lkw: string = lp2.peek_keyword();
            if (lkw == "while" || lkw == "for" || lkw == "loop") {
                loop_label = llid;
                p = lp2;
            }
        }
    }
    // `assert(cond)` / `assert(cond, msg)` builtin — desugar to
    // `if (!cond) { eprint("assertion failed[: msg]"); exit(1); }`. A
    // parser-level rewrite over the existing `!` / string-`+` / eprint /
    // exit primitives, so it lowers with no dedicated codegen on every
    // backend and both IR paths — mirroring the native parser's
    // parseAssert. `assert` is an identifier (not a keyword), so we only
    // intercept the statement-position `assert (` shape and leave the
    // name free for ordinary use elsewhere. #4416.
    if (p.peek_ident() == "assert") {
        var as0: Par = p.advance();  // consume `assert`
        if (as0.peek_punct() == "(") {
            var asp: Par = as0.advance();  // consume `(`
            var (as_cond, ascp) = parse_expr(asp);
            asp = ascp;
            var as_has_msg: boolean = false;
            var as_msg: Expr = e_string("");
            if (asp.peek_punct() == ",") {
                asp = asp.advance();
                var (asm_e, asmp) = parse_expr(asp);
                as_msg = asm_e;
                asp = asmp;
                as_has_msg = true;
            }
            if (asp.peek_punct() == ")") { asp = asp.advance(); }
            if (asp.peek_punct() == ";") { asp = asp.advance(); }
            var as_text: Expr = e_string("assertion failed");
            if (as_has_msg) {
                as_text = e_binary("+", e_string("assertion failed: "), as_msg);
            }
            var as_body: Stmt[] = [];
            var as_eargs: Expr[] = [];
            as_eargs = as_eargs.append(as_text);
            as_body = as_body.append(s_expr(e_call(e_ident("eprint"), as_eargs)));
            var as_xargs: Expr[] = [];
            as_xargs = as_xargs.append(e_number("1", "", false));
            as_body = as_body.append(s_expr(e_call(e_ident("exit"), as_xargs)));
            var as_noelse: Stmt[] = [];
            return (s_if(e_unary("!", as_cond), as_body, as_noelse), asp);
        }
    }
    // `todo;` / `todo("msg");` builtin — desugar to
    // `while (true) { eprint("todo[: msg]"); exit(101); }`, mirroring
    // the native parser's parseTodo (whose `loop { ... }` desugar this
    // parser lowers to the same while-true shape — see parse_loop_stmt).
    // The always-true loop makes the stub DIVERGE for the checker's
    // missing-return / let-else analyses, so `todo;` can stand in for a
    // whole non-void function body; exit(101) fires on the first
    // iteration. Only the statement-position `todo ;` / `todo (` shapes
    // are intercepted, so `todo` stays usable as an ordinary identifier
    // elsewhere. The runtime message must stay byte-identical to the
    // native parser's.
    if (p.peek_ident() == "todo") {
        var td0: Par = p.advance();  // consume `todo`
        var td0p: string = td0.peek_punct();
        if (td0p == "(" || td0p == ";") {
            var tdp: Par = td0;
            var td_has_msg: boolean = false;
            var td_msg: Expr = e_string("");
            if (td0p == "(") {
                tdp = tdp.advance();  // consume `(`
                if (tdp.peek_punct() != ")") {
                    var (tdm_e, tdmp) = parse_expr(tdp);
                    td_msg = tdm_e;
                    tdp = tdmp;
                    td_has_msg = true;
                }
                if (tdp.peek_punct() == ")") { tdp = tdp.advance(); }
            }
            if (tdp.peek_punct() == ";") { tdp = tdp.advance(); }
            var td_text: Expr = e_string("todo: not implemented");
            if (td_has_msg) {
                td_text = e_binary("+", e_string("todo: "), td_msg);
            }
            var td_body: Stmt[] = [];
            var td_eargs: Expr[] = [];
            td_eargs = td_eargs.append(td_text);
            td_body = td_body.append(s_expr(e_call(e_ident("eprint"), td_eargs)));
            var td_xargs: Expr[] = [];
            td_xargs = td_xargs.append(e_number("101", "", false));
            td_body = td_body.append(s_expr(e_call(e_ident("exit"), td_xargs)));
            return (s_while(e_bool(true), td_body), tdp);
        }
    }
    var kw: string = p.peek_keyword();
    if (kw == "defer") {
        // `defer ACTION;` — the deferred action is an ordinary statement
        // (assignment, call, …). Parse it (which consumes the trailing
        // `;`) and wrap it; lower_defers schedules it at function exit.
        p = p.advance();  // consume `defer`
        var (da_stmt, da_p) = parse_stmt(p);
        return (s_defer(da_stmt), da_p);
    }
    if (kw == "errdefer") {
        // `errdefer ACTION;` — like `defer`, but lower_defers schedules it
        // only on an error exit (a `return` of a None/Err value).
        p = p.advance();  // consume `errdefer`
        var (ea_stmt, ea_p) = parse_stmt(p);
        return (s_errdefer(ea_stmt), ea_p);
    }
    if (kw == "function") {
        // Local (nested) function declaration: desugar to a closure-valued
        // local `var name = function(params): ret { body };`. Calls resolve
        // through the closure-call path, and references to enclosing locals
        // are captured by the lambda machinery. Mirrors the Go parser
        // marking it IsLocal + the closureconv hoist. (Self-reference /
        // recursion isn't captured — the name is bound after the lambda is
        // built — matching a plain closure-valued local.)
        var (fr_func, fr_p) = parse_func_decl(p);
        p = fr_p;
        if (stmts_mention(fr_func.body, fr_func.name)) {
            // Self-recursive local function: the closure can't reference
            // itself (the name binds after the lambda captures), so this
            // needs top-level hoisting (closureconv), not yet ported.
            // Surface it rather than miscompile silently.
            return (s_var(fr_func.name, "", e_lambda(fr_func.params, fr_func.ret_type, fr_func.body)), p);
        }
        var lam: Expr = e_lambda(fr_func.params, fr_func.ret_type, fr_func.body);
        // `-fmt` records which of the two spellings was written, the way a
        // struct destructure rides on the same field ("@sd:…"): both parse to a
        // lambda-valued local, so without the marker a nested declaration came
        // back as `var f = function(…) { … };`.
        if (p.verbatim) { return (s_var_at(fr_func.name, "@fndecl", lam, fr_func.line, fr_func.col), p); }
        return (s_var(fr_func.name, "", lam), p);
    }
    if (kw == "match") {
        var (mr_stmt, mr_p) = parse_match_stmt(p);
        return (mr_stmt, mr_p);
    }
    if (kw == "if") {
        p = p.advance();
        // `if let PAT = EXPR { then } else { else }` desugars to a
        // `match (EXPR) { PAT => { then }, _ => { else } }` — the
        // pattern arm plus a wildcard arm for the else (empty when
        // there's no else). Parsed before the `(` check since if-let
        // has no parenthesised condition.
        if (p.peek_keyword() == "let") {
            p = p.advance();  // consume `let`
            // A STRUCT-pattern head (`if let P { x, y } = e`) takes the
            // field-bind flag chain instead, the same build_struct_match the
            // match arms use — parse_pattern's `IDENT {` is the record-form
            // VARIANT pattern, a different shape. `structnames` is what tells
            // the two apart, exactly as is_struct_pattern_arm does for arms.
            // The pattern is irrefutable, so the wildcard arm carrying the
            // else is unreachable; it is still emitted so an `else` written
            // here parses and the shape matches the refutable path.
            if (is_struct_pattern_arm(p) && ((p.peek_ident().len() > 0 && p.peek2_punct() == "{") || (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{"))) {
                var ils_line: i32 = p.peek_line();
                var ils_col: i32 = p.peek_col();
                var ils_at: string = "";
                if (p.peek_ident().len() > 0 && p.peek2_punct() == "@") {
                    ils_at = p.peek_ident();
                    p = p.advance();
                    p = p.advance();
                }
                var ils_type: string = p.peek_ident();
                var (ils_binds, ils_fields, ils_field_kinds, ils_field_lits, ils_field_pats, ils_ok, ils_pp) = parse_struct_arm_pattern(p);
                p = ils_pp;
                if (!ils_ok) { return (s_unknown("a struct pattern binds field names"), p); }
                if (p.peek_punct() == "=") { p = p.advance(); }
                var ils_saved: boolean = p.no_struct;
                var (ils_scrut, ils_sp) = parse_expr(p.with_no_struct(true));
                p = (ils_sp).with_no_struct(ils_saved);
                var (ils_then, ils_tp) = parse_block(p);
                p = ils_tp;
                var ils_else: Stmt[] = [];
                if (p.peek_keyword() == "else") {
                    p = p.advance();
                    var (ils_eb, ils_ep) = parse_block(p);
                    p = ils_ep;
                    ils_else = ils_eb;
                }
                var ils_arms: StructArm[] = [];
                ils_arms = ils_arms.append(StructArm { is_wild: false, type_name: ils_type, binds: ils_binds, fields: ils_fields, field_kinds: ils_field_kinds, field_lits: ils_field_lits, field_pats: ils_field_pats, at_binding: ils_at, guard: e_bool(true), has_guard: false, body: ils_then, line: ils_line, col: ils_col });
                var ils_nb: string[] = [];
                var ils_no_pats: Pattern[] = [];
                var ils_no_kinds: i32[] = [];
                var ils_no_lits: Expr[] = [];
                var ils_nf: string[] = [];
                ils_arms = ils_arms.append(StructArm { is_wild: true, type_name: "", binds: ils_nb, fields: ils_nf, field_kinds: ils_no_kinds, field_lits: ils_no_lits, field_pats: ils_no_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: ils_else, line: ils_line, col: ils_col });
                return (build_struct_match(ils_scrut, ils_arms, ils_line, ils_col), p);
            }
            var (ilpat_pattern, ilpat_p) = parse_pattern(p);
            p = ilpat_p;
            // Or-patterns: `if let A(x) | B(x) = e { … }` — one arm per
            // alternative sharing the then-block, the same per-alternative
            // expansion match arms use.
            var ilpats: Pattern[] = [ilpat_pattern];
            while (p.peek_punct() == "|") {
                p = p.advance();
                var (ilalt_pattern, ilalt_p) = parse_pattern(p);
                p = ilalt_p;
                ilpats = ilpats.append(ilalt_pattern);
            }
            if (p.peek_punct() == "=") { p = p.advance(); }
            // The source expression is followed directly by the then-block's
            // `{`, so struct-literal parsing must be suppressed while reading
            // it (native sets p.noStructLit here) — otherwise a bare-ident
            // source whose then-block starts with `}`, `...`, or `IDENT :`
            // (e.g. a labeled loop) is swallowed as `ident { … }` (#4339
            // item 4). Same save/restore shape as the for-in iterable.
            var il_saved: boolean = p.no_struct;
            var (ilscrut_expr, ilscrut_p) = parse_expr(p.with_no_struct(true));
            p = (ilscrut_p).with_no_struct(il_saved);
            var (ilthen_body, ilthen_p) = parse_block(p);
            p = ilthen_p;
            var ilelse: Stmt[] = [];
            if (p.peek_keyword() == "else") {
                p = p.advance();
                var (ileb_body, ileb_p) = parse_block(p);
                p = ileb_p;
                ilelse = ileb_body;
            }
            var ilarms: MatchArm[] = [];
            var ilwritten: MatchArm[] = [];
            var ilpi: i32 = 0;
            while (ilpi < ilpats.len()) {
                ilwritten = ilwritten.append(MatchArm { pattern: ilpats[ilpi], body: ilthen_body, line: 0, col: 0, guard: e_bool(true), has_guard: false });
                var (fi_pat, fi_g, fi_hg) = fold_lit_cond(ilpats[ilpi], e_bool(true), false);
                ilarms = ilarms.append(MatchArm { pattern: fi_pat, body: ilthen_body, line: 0, col: 0, guard: fi_g, has_guard: fi_hg });
                ilpi = ilpi + 1;
            }
            var ilwild: MatchArm = MatchArm { pattern: p_wildcard(), body: ilelse, line: 0, col: 0, guard: e_bool(true), has_guard: false };
            ilarms = ilarms.append(ilwild);
            ilwritten = ilwritten.append(ilwild);
            // A nested head (`if let Some(Ok(n)) = e`) flattens the same way a
            // match arm does; the wildcard arm above is the outer fallthrough
            // desugar_nested_arms copies into the inner match, so a payload
            // matching no inner pattern runs the else rather than falling off
            // a non-exhaustive inner match.
            ilarms = desugar_nested_arms(ilarms, 0, "");
            var ilsugar: MatchArm[] = [];
            if (arms_have_written_form(ilwritten)) { ilsugar = ilwritten; }
            return (s_match_origin_sugared(ilscrut_expr, ilarms, ilsugar, 0, 0, "if_let"), p);
        }
        if (p.peek_punct() != "(") {
            return (s_unknown("missing ( in if"), p);
        }
        p = p.advance();
        var (c_expr, c_p) = parse_expr(p);
        p = c_p;
        if (p.peek_punct() == ")") { p = p.advance(); }
        var (then_blk_body, then_blk_p) = parse_block_or_stmt(p);
        p = then_blk_p;
        var else_body: Stmt[] = [];
        // Whether the else was WRITTEN as a chain. `else if` and
        // `else { if … }` produce the same one-element else_body, so the
        // printer cannot tell them apart without this (#6779).
        var else_chained: boolean = false;
        if (p.peek_keyword() == "else") {
            p = p.advance();
            // `else if` — wrap as a nested StmtIf in the else
            // branch so an else-chain reads as one shape.
            if (p.peek_keyword() == "if") {
                var (nested_stmt, nested_p) = parse_stmt(p);
                p = nested_p;
                else_body = else_body.append(nested_stmt);
                else_chained = true;
            } else {
                var (else_blk_body, else_blk_p) = parse_block_or_stmt(p);
                p = else_blk_p;
                else_body = else_blk_body;
            }
