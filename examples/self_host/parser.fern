// examples/self_host/parser.fern — recursive-descent parser
// layered on the Fern-port lexer (`./lexer`). Together they form
// the second concrete step of the self-host port (after the
// standalone lexer in `lexer.fern`). Now that cross-module
// qualified variant patterns work (`lexer.TokIdent(x) => …`),
// the parser imports the lexer rather than inlining a copy.
//
// Scope:
//   - Expressions with precedence: + - * / % comparisons
//     equality && || (mirrors Go parser's precedence climbing)
//   - Numbers (with float / integer / suffix distinction
//     surfaced on the AST node)
//   - Identifier expressions + function calls `f(a, b)`
//   - Parenthesised grouping
//   - Statements: `var x = expr;`, `return expr;`, expression
//     stmts
//
// Out of scope (Go parser covers them; follow-up port):
//   - Types / type annotations
//   - Struct / enum / union decls
//   - `if` / `while` / `for` / `match` / `defer` / `arena`
//   - String / f-string handling (lexer recognises them; parser
//     stub treats them as opaque ExprUnknown)
//   - Receivers, type-params, `pub`, `import`

import "./util";
import "./lexer";

// =================== PARSER ====================

// Expression nodes. Recursive via the union — `ExprBinary` holds
// two Expr children, `ExprCall` holds a list of args, etc. The Go
// parser produces a denser typed AST (NumberLit / FloatLit /
// Ident / Binary / Call); this port collapses similar shapes into
// fewer variants to keep the union member count tractable.

pub struct ExprNumber { text: string, suffix: string, is_float: boolean, line: i32, col: i32 }
pub struct ExprIdent { name: string, line: i32, col: i32 }
pub struct ExprString { value: string, line: i32, col: i32 }
pub struct ExprBool { value: boolean }
pub struct ExprBinary { op: string, left: Expr, right: Expr, line: i32, col: i32 }
pub struct ExprUnary { op: string, operand: Expr, line: i32, col: i32 }
// type_argc is the number of explicit call-site type arguments (`f[i32](x)`
// has 1). The arguments themselves are erased — only the count is kept, so the
// checker can flag a generic-call type-argument arity mismatch (E040). 0 means
// no `[...]` was written.
pub struct ExprCall { callee: Expr, args: Expr[], line: i32, col: i32, type_argc: i32 }
// Array literal `[e1, e2, e3]`. Empty literal `[]` is allowed —
// the checker rejects an empty literal in inference contexts
// because it can't infer the element type.
pub struct ExprArray { elements: Expr[] }
// ExprLambda is a function-valued expression: `function (a: T,
// b: T): U { body }` — same shape as FuncDecl minus the name.
// Capture semantics happen at the runtime layer; the parser
// just builds the AST node.
pub struct ExprLambda { params: ParamDecl[], ret_type: string, body: Stmt[], use_infer: boolean }
// ExprTuple holds a parenthesised comma-separated list:
// `(a, b, c)`. Distinct from arrays because tuple shape is
// fixed-arity / heterogeneous; arrays are homogeneous and
// dynamic. Field access in Fern uses `.0`, `.1`, etc. but
// that's a later milestone — this slice only adds parsing.
pub struct ExprTuple { elements: Expr[], line: i32, col: i32 }
// Postfix indexing `a[i]`. `a` can be any Expr that evaluates to
// an array; `i` must type-check to i32. Out-of-range access at
// runtime surfaces as VErr from the interp.
// `unchecked` is #4380 lever 3: set by elide_len_bounded_body on a READ
// `arr[i]` proven in-bounds by an enclosing `while (i < arr.len())` guard,
// so irlower emits op_arr_get_nc (no per-iteration bounds check + len
// reload). Defaults false; index WRITES are __set_index calls, never
// ExprIndex, so only reads are ever marked.
pub struct ExprIndex { array: Expr, index: Expr, unchecked: boolean }
// Postfix slicing `a[start:end]`. Returns a subview of the same
// kind as `a` (subarray for TypeArray, substring for
// TypeString). `start` is inclusive, `end` is exclusive — same
// shape as Python / Go / Rust slicing.
pub struct ExprSlice { array: Expr, start: Expr, end: Expr }
// Struct literal `Name { field: value, field: value }`. The
// type_name is the struct's declared name; field_names and
// field_values parallel-array the initializers in source
// order. Empty struct lit `Name { }` is allowed (zero fields).
//
// Struct-update `Name { ...base, field: value }`: a leading
// `...base` spread copies the un-overridden fields from `base`,
// the listed fields override. `has_base` flags the presence of a
// base; when false, `base` holds a placeholder ExprUnknown
// sentinel (Expr is a no-null union, so we carry the flag rather
// than sniff the sentinel). With a base, a subset of fields is
// legal — the checker relaxes completeness. See
// docs/IMMUTABILITY-MIGRATION-PLAN.md.
pub struct ExprStructLit { type_name: string, field_names: string[], field_values: Expr[], has_base: boolean, base: Expr, line: i32, col: i32 }
// Postfix field access `obj.field`. obj can be any Expr that
// evaluates to a struct value.
pub struct ExprFieldAccess { obj: Expr, field: string, line: i32, col: i32 }
pub struct ExprUnknown { kind: string }

pub type Expr = ExprNumber | ExprIdent | ExprString | ExprBool
              | ExprBinary | ExprUnary | ExprCall
              | ExprArray | ExprTuple | ExprIndex | ExprSlice
              | ExprStructLit | ExprFieldAccess | ExprLambda
              | ExprUnknown;

// Statement nodes.

// StmtVar binds a name to an init value. `type_name` is the
// optional `: Type` annotation (bare type name; empty string
// means no annotation). The checker uses it to override the
// inferred init type — so a `var sh: Shape = Circle { … }`
// binds `sh` as TypeUnion("Shape") rather than the inferred
// TypeStruct("Circle"). Interp / VM ignore it (annotations
// are checker-only metadata).
pub struct StmtVar { name: string, type_name: string, init: Expr, line: i32, col: i32, is_str: boolean }
pub struct StmtReturn { value: Expr, line: i32, col: i32 }
pub struct StmtExpr { value: Expr }
// StmtIf models `if (cond) { then... } else { else... }`. else_body
// is empty (`[]`) when the source omits the `else` branch; the
// checker / interp branch on `len(else_body) == 0` rather than a
// separate `has_else` flag.
pub struct StmtIf { cond: Expr, then_body: Stmt[], else_body: Stmt[] }
// StmtWhile models `while (cond) { body... }`. The body executes
// repeatedly as long as cond evaluates to a true VBool; an
// in-body `return` short-circuits the loop the same way it
// short-circuits an if-branch.
pub struct StmtWhile { cond: Expr, body: Stmt[], label: string }
// StmtAssign models a re-assignment to an existing var: `x = expr;`.
// The target is an ident name — full lvalue syntax (field /
// index / tuple) is a later port milestone. The checker verifies
// the target is already bound and that types match; the interp
// updates the env's slot in place.
pub struct StmtAssign { target: string, value: Expr, line: i32, col: i32, target_line: i32, target_col: i32 }
// StmtMatch models `match (scrutinee) { Pat => { ... }, ... }`.
// Arms are walked top-to-bottom; the first pattern that matches
// runs its body. The checker enforces that the pattern variant
// (e.g. `Circle(c)`) refers to a known struct that's a variant
// of the scrutinee's union type. Wildcards (`_`) act as the
// default catch-all. The body is a stmt list, mirroring
// StmtIf / StmtWhile; expression-position match lives in a
// later slice (ExprMatch).
// binding is the first payload binding (or "" / "_"); extra_bindings holds any
// further bindings written in `Variant(a, b, …)`. The self-host's variants are
// single-payload, so a multi-binding pattern is a payload-arity error (E015) —
// extra_bindings lets the checker count them; codegen still uses `binding`.
// `nested`, when non-empty (a single element), holds a sub-pattern for the
// payload position — `Some(Ok(n))` parses `Some` with nested = [Ok(n)]. The
// parser desugars a nested arm into a flat outer arm whose body re-matches the
// payload on an inner `match` (desugar_nested_arms), so the checker / codegen
// only ever see flat arms; empty (the common case) means a plain binder.
pub struct PatVariant { type_name: string, binding: string, extra_bindings: string[], nested: Pattern[] }
pub struct PatWildcard { tag: i32 }
pub type Pattern = PatVariant | PatWildcard;
// guard is an optional `if <expr>` between the pattern and `=>`; has_guard
// distinguishes a real guard from the placeholder. When present the arm matches
// only if the guard evaluates true (E027 checks it is boolean).
pub struct MatchArm { pattern: Pattern, body: Stmt[], line: i32, col: i32, guard: Expr, has_guard: boolean }
// `origin` records whether this match was written directly (""), or
// synthesised by the parser from an `if let` (`"if_let"`) / `let … else`
// (`"let_else"`) desugar. Codegen ignores it (a desugared match compiles
// exactly like a hand-written one — keeping the fixpoint byte-identical),
// but the checker reads it to apply the dedicated `if-let`/`let-else`
// diagnostics (E022/E023) the Go checker emits, instead of the generic
// match-arm diagnostics (E035) the desugared shape would otherwise draw.
pub struct StmtMatch { scrutinee: Expr, arms: MatchArm[], line: i32, col: i32, origin: string }
// StmtFor models `for VAR in EXPR { body }`. The iter expr
// evaluates to an array (interp) / TypeArray (checker); the
// loop binds `var_name` to each element in turn. break /
// continue inside the body aren't modeled yet — a future
// slice can add them as StmtBreak / StmtContinue.
pub struct StmtFor { var_name: string, iter: Expr, body: Stmt[], label: string }
// StmtBreak / StmtContinue model `break;` and `continue;`. The
// tag fields are placeholder payload — variants need a shape
// in the union and these stmts have no other state. The
// surrounding while / for body handles the actual control
// transfer.
pub struct StmtBreak { tag: i32, line: i32, col: i32, label: string }
pub struct StmtContinue { tag: i32, line: i32, col: i32, label: string }
pub struct StmtUnknown { kind: string }

// StmtDefer holds an action statement to run when the enclosing function
// exits (LIFO, every return path + falloff). It exists only between the
// parser and the lower_defers pass (module_with_builtins) — that pass
// eliminates every StmtDefer before any backend emits, so the emitters
// never lower one at runtime (their arms are there for exhaustiveness).
//
// `on_error` is 1 for an `errdefer` — cleanup that runs only on an error
// exit (a `return` of a None/Err value), not on success or falloff. 0 for
// a plain `defer`. lower_defers schedules the two kinds at the right exits.
pub struct StmtDefer { action: Stmt, on_error: i32 }

pub type Stmt = StmtVar | StmtReturn | StmtExpr | StmtIf | StmtWhile
              | StmtAssign | StmtMatch | StmtFor
              | StmtBreak | StmtContinue | StmtUnknown | StmtDefer;

// Top-level function decl: `function name(p1: T1, p2: T2): RT { body }`.
// type names are captured as bare strings — full type-syntax
// parsing (arrays / generics / unions) is a later milestone.
// fn_param_dyn: for a `fn`-typed param whose OWN parameter list contains
// `dyn Trait` positions (`f: (dyn Speak) => i32`), a comma-separated list of the
// dyn parameter indices ("0", "0,2"), else "". The flat "fn" type tag discards
// the fn's per-parameter types, so this sidecar preserves which of a fn-value's
// arguments must be dyn-boxed at an indirect call `f(7)` — without it a primitive
// literal there is passed unboxed and op_dyn_dispatch reads it as a shape pointer
// (SIGSEGV, #5276). Populated by peek_fn_param_dyn in parse_param.
pub struct ParamDecl { name: string, type_name: string, own: boolean, has_default: boolean, default_value: Expr, ret_arr: boolean, fn_ret: string, fn_param_dyn: string }
// Receiver fields capture `function (recv: RecvType) name(…)`
// — the self-host source uses them heavily for struct methods
// like `function (p: Par) advance(): Par`. Both fields are
// empty for plain functions. Downstream consumers treat
// receiver methods as plain functions for now (the receiver
// is conceptually a hidden first parameter — a later slice
// can prepend it to `params` during method-call lowering).
// type_params holds the BOUNDED type-parameter names (e.g. `["T"]` for
// `function f[T: Eq](…)`). It's empty for non-generic functions and for
// UNBOUNDED generics (`id[T]`), which the self-host still handles by
// erasure. A non-empty type_params marks a function the monomorphiser
// must clone per concrete call-site type — see monomorphize_module and
// docs/TRAITS.md (self-host slice 2).
// import_iface / import_wit bind a body-less function to a WIT import via an
// `@import("wasi:iface@x.y.z", "wit-func-name")` attribute (bring-your-own
// WIT, P4 — docs/WIT-BRING-YOUR-OWN.md). Both empty for an ordinary function;
// when set, body is empty and a call lowers to a core wasm import of
// (import_iface, import_wit).
// bound_traits runs PARALLEL to type_params: bound_traits[i] holds the
// trait bound(s) on type_params[i] as a `+`-joined list of trait names
// (module-qualified as written, e.g. `cmp.Ord`; generic-arg bounds like
// `Iterator[i32]` keep the base name only), or "" for a type param with
// no trait bound (an UNBOUNDED param the monomorphiser promoted into
// type_params — see the promotion loop in parse_func_decl). It exists so
// the checker can flag E021 generic-bound conformance at call sites
// (#4842); it is checker-only and never read by codegen, so it is
// fixpoint-neutral. Empty for non-generic functions.
pub struct FuncDecl { name: string, receiver_name: string, receiver_type: string, type_params: string[], params: ParamDecl[], ret_type: string, body: Stmt[], line: i32, col: i32, import_iface: string, import_wit: string, type_param_count: i32, bound_traits: string[], fip: boolean, ret_str: boolean }

// Top-level struct decl: `struct Name { field1: T1, field2: T2 }`.
// Same simplifying assumption as FuncDecl: type names are
// captured as bare strings; full type syntax (arrays /
// generics / unions) lands in a follow-up.
pub struct StructFieldDecl { name: string, type_name: string, fn_ret: string }
// type_params holds a generic struct's parameter names (`["T"]` for
// `struct Box[T]`); empty for a non-generic struct. The monomorphiser
// uses it to clone `Box[i32]` → a concrete `Box__i32` with the field
// types substituted, so primitive/string payloads resolve their methods.
// must_consume records a `@must_consume` attribute on the struct decl
// (docs/MUST-CONSUME.md): the checker's E067 obligation walk consults it.
// derives records the trait names of an `@derive(…)` attribute on the
// decl (an enum's derives are stamped on each variant record): the
// synthesis itself happens at parse time (synth_derives), but the
// checker's E021 derive-field conformance pre-check (#5392) needs to
// know which traits were derived.
pub struct StructDecl { name: string, fields: StructFieldDecl[], type_params: string[], derives: string[], line: i32, col: i32, enum_owner: string, must_consume: boolean }

// Top-level union type alias: `type Name = V1 | V2 | V3;`.
// Variants are captured as bare type-name strings — they
// resolve to other struct decls in the same module (or to
// primitives in a later milestone). The `pub` modifier is
// optional and currently swallowed without ceremony, since
// the self-host pipeline doesn't yet distinguish exported
// from private decls.
pub struct TypeAlias { name: string, variants: string[], line: i32, col: i32 }

// Top-level import: `import "./path";`. The path is captured
// verbatim (including the quotes-stripped value). Resolution
// across files is a later milestone — for now the parser
// just gathers them into the Module so the rest of the
// pipeline can see what dependencies a source declares.
// `is_reexport` distinguishes a plain `import "path";` (false) from a
// `pub use "path".{names…};` re-export directive (true). A re-export
// import carries the re-exported names in `reexport_names`; the module
// loader still treats it as an import (so the target module is loaded +
// bundled), and the bundler reads the names to build the re-export table
// that redirects a consumer's `facade.name` to the original module's
// mangled symbol. See flatten.bundle / docs/PRELUDE-TO-MODULES.md.
pub struct Import { path: string, is_reexport: boolean, reexport_names: string[], alias: string }

// A whole compilation unit: the funcs declared at top level and
// any stmts that appear outside a function decl. The interp /
// checker treat funcs first (build a signature table) and then
// either dispatch to `main` if it exists or fall back to the
// top-level stmt stream as the entry point.
// impls / trait_reqs carry the trait-conformance data the checker needs for
// E021 (#4347): trait_reqs lists each trait's REQUIRED (abstract, body-less)
// method names, and impls records every `impl Trait for Type` block with the
// methods it explicitly provides. parse_module populates both; the
// transformation passes propagate them unchanged.
pub struct Module { funcs: FuncDecl[], structs: StructDecl[], aliases: TypeAlias[], imports: Import[], top_stmts: Stmt[], enums: EnumDecl[], resources: ResourceDecl[], exports: ExportBinding[], impls: ImplInfo[], trait_reqs: TraitReq[] }

// TraitReq is one trait's required-method set: the abstract (body-less)
// signatures an `impl` MUST provide. A defaulted (bodied) method is NOT
// required (the default is synthesised onto impls that omit it), so it never
// appears here. Drives the E021 missing-method check (#4347).
// TraitReq carries a trait's ABSTRACT (required) methods for the E021
// conformance check (#4347). `methods` is the required method names; `req_sigs`
// is the parallel full signatures (same length/order) so the checker can also
// diagnose an impl method whose arity / param types / return type disagree with
// the trait's declaration (Self resolves to the impl type at the check site).
pub struct TraitReq { trait_name: string, methods: string[], req_sigs: FuncDecl[], supertraits: string[] }

// ResourceDecl records a `resource Name;` declaration (P5 — WIT resource-handle
// types, docs/WIT-BRING-YOUR-OWN.md). `iface` / `wit` carry the WIT identity
// from an `@import("iface", "wit-resource-name")` attribute (empty for an
// unbound resource). insert_resource_drops uses the binding to synthesize the
// `[resource-drop]` import an owned handle is released through.
pub struct ResourceDecl { name: string, iface: string, wit: string }

// ExportBinding records an `@export("iface", "wit-name") function f {…}` binding
// (P6 — docs/WIT-BRING-YOUR-OWN.md): the function `func_name` implements the WIT
// world export (iface, wit). The wasm emitter surfaces a core export
// `iface#wit-name` for each so the Go world-driven composer lifts it. Kept as a
// Module side-list (like resources) rather than a FuncDecl field to avoid
// rippling through every FuncDecl literal.
pub struct ExportBinding { func_name: string, iface: string, wit: string }

// EnumDecl preserves an enum's name + the names of its variants. The
// parser desugars each enum into variant structs (pushed to `structs`)
// for codegen, which drops the enum -> variants grouping; this record
// keeps it so the checker can detect enum-level declaration errors (an
// enum redeclared, a duplicate variant) that the flat struct table can't
// distinguish from ordinary structs. Codegen ignores it.
// must_consume mirrors StructDecl.must_consume for `@must_consume enum`
// declarations (docs/MUST-CONSUME.md, E067).
pub struct EnumDecl { name: string, variant_names: string[], type_params: string[], line: i32, col: i32, must_consume: boolean }

// enum_variant_names extracts the variant names from an enum's desugared
// variant structs.
function enum_variant_names(variants: StructDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < variants.len()) { out = out.append(variants[i].name); i = i + 1; }
    return out;
}

// concat_enums appends two enum-decl lists (used when merging modules).
function concat_enums(a: EnumDecl[], b: EnumDecl[]): EnumDecl[] {
    var out: EnumDecl[] = a;
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// Helper wraps to satisfy the implicit-union-wrap return-position
// rule. Same pattern lexer.fern uses for Token construction.

function e_number(text: string, suffix: string, is_float: boolean): Expr {
    return ExprNumber { text: text, suffix: suffix, is_float: is_float, line: 0, col: 0 };
}
function e_number_at(text: string, suffix: string, is_float: boolean, line: i32, col: i32): Expr {
    return ExprNumber { text: text, suffix: suffix, is_float: is_float, line: line, col: col };
}
function e_ident(name: string): Expr { return ExprIdent { name: name, line: 0, col: 0 }; }
function e_ident_at(name: string, line: i32, col: i32): Expr { return ExprIdent { name: name, line: line, col: col }; }
function e_string(value: string): Expr { return ExprString { value: value, line: 0, col: 0 }; }
function e_string_at(value: string, line: i32, col: i32): Expr { return ExprString { value: value, line: line, col: col }; }
function e_bool(value: boolean): Expr { return ExprBool { value: value }; }
function e_binary(op: string, left: Expr, right: Expr): Expr {
    return ExprBinary { op: op, left: left, right: right, line: 0, col: 0 };
}
function e_binary_at(op: string, left: Expr, right: Expr, line: i32, col: i32): Expr {
    return ExprBinary { op: op, left: left, right: right, line: line, col: col };
}
function e_unary(op: string, operand: Expr): Expr { return ExprUnary { op: op, operand: operand, line: 0, col: 0 }; }
function e_unary_at(op: string, operand: Expr, line: i32, col: i32): Expr { return ExprUnary { op: op, operand: operand, line: line, col: col }; }
function e_call(callee: Expr, args: Expr[]): Expr { return ExprCall { callee: callee, args: args, line: 0, col: 0, type_argc: 0 }; }
function e_call_at(callee: Expr, args: Expr[], line: i32, col: i32): Expr { return ExprCall { callee: callee, args: args, line: line, col: col, type_argc: 0 }; }
function e_array(elements: Expr[]): Expr { return ExprArray { elements: elements }; }
function e_tuple(elements: Expr[]): Expr { return ExprTuple { elements: elements, line: 0, col: 0 }; }
function e_tuple_at(elements: Expr[], line: i32, col: i32): Expr { return ExprTuple { elements: elements, line: line, col: col }; }
function e_index(array: Expr, index: Expr): Expr { return ExprIndex { array: array, index: index, unchecked: false }; }
function e_slice(array: Expr, start: Expr, end: Expr): Expr {
    return ExprSlice { array: array, start: start, end: end };
}
function e_struct_lit(type_name: string, field_names: string[], field_values: Expr[], line: i32, col: i32): Expr {
    return ExprStructLit { type_name: type_name, field_names: field_names, field_values: field_values, has_base: false, base: e_unknown("no-base"), line: line, col: col };
}
// e_struct_update builds a struct-update literal carrying a base
// spread source. The base is the value whose un-overridden fields
// are copied into the new box; the listed fields override.
function e_struct_update(type_name: string, field_names: string[], field_values: Expr[], base: Expr, line: i32, col: i32): Expr {
    return ExprStructLit { type_name: type_name, field_names: field_names, field_values: field_values, has_base: true, base: base, line: line, col: col };
}
function e_field_access(obj: Expr, field: string): Expr {
    return ExprFieldAccess { obj: obj, field: field, line: 0, col: 0 };
}
function e_field_access_at(obj: Expr, field: string, line: i32, col: i32): Expr {
    return ExprFieldAccess { obj: obj, field: field, line: line, col: col };
}
function e_lambda(params: ParamDecl[], ret_type: string, body: Stmt[]): Expr {
    return ExprLambda { params: params, ret_type: ret_type, body: body, use_infer: false };
}
pub function e_unknown(kind: string): Expr { return ExprUnknown { kind: kind }; }

function s_var(name: string, type_name: string, init: Expr): Stmt {
    return StmtVar { name: name, type_name: type_name, init: init, line: 0, col: 0, is_str: false };
}
// s_var_at is s_var with an explicit source position (used at the parse
// site so a `var` declaration's diagnostics — E003 / E013 / E020 — point
// at the `var` keyword).
function s_var_at(name: string, type_name: string, init: Expr, line: i32, col: i32): Stmt {
    return StmtVar { name: name, type_name: type_name, init: init, line: line, col: col, is_str: false };
}

// parse_struct_destructure consumes `{ x, y: b, .. } = E;` with the cursor
// on the opening `{` (the struct-type name already consumed as `struct_name`).
// It encodes the whole binding as ONE StmtVar the way tuple destructure does:
// `name` carries the comma-joined BINDING names ("x,b"), and `type_name`
// carries the marker "@sd:<StructName>:<comma-joined FIELD names>". irlower's
// lower_struct_destructure decodes it into per-field `var bind = tmp.field;`
// binds. A trailing `..` marks intentionally-omitted fields (partial bind).
function parse_struct_destructure(p: Par, struct_name: string, line: i32, col: i32): (Stmt, Par) {
    p = p.advance(); // consume `{`
    var bindings: string = "";
    var fields: string = "";
    var first: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
        if (p.peek_punct() == "..") { p = p.advance(); break; }
        var fld: string = p.peek_ident();
        if (fld.len() > 0) { p = p.advance(); }
        var bind: string = fld;
        if (p.peek_punct() == ":") {
            p = p.advance();
            var bn: string = p.peek_ident();
            if (bn.len() > 0) { p = p.advance(); bind = bn; }
        }
        if (!first) { bindings = bindings + ","; fields = fields + ","; }
        bindings = bindings + bind;
        fields = fields + fld;
        first = false;
        if (p.peek_punct() == ",") { p = p.advance(); }
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    if (p.peek_punct() == "=") { p = p.advance(); }
    var (init_expr, ip) = parse_expr(p);
    p = ip;
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (s_var_at(bindings, "@sd:" + struct_name + ":" + fields, init_expr, line, col), p);
}
function s_return(value: Expr): Stmt { return StmtReturn { value: value, line: 0, col: 0 }; }
// s_return_at carries the `return` keyword position so E002 / E012 point at it.
function s_return_at(value: Expr, line: i32, col: i32): Stmt { return StmtReturn { value: value, line: line, col: col }; }
function s_expr(value: Expr): Stmt { return StmtExpr { value: value }; }
function s_if(cond: Expr, then_body: Stmt[], else_body: Stmt[]): Stmt {
    return StmtIf { cond: cond, then_body: then_body, else_body: else_body };
}
function s_while(cond: Expr, body: Stmt[]): Stmt {
    return StmtWhile { cond: cond, body: body, label: "" };
}
function s_for(var_name: string, iter: Expr, body: Stmt[]): Stmt {
    return StmtFor { var_name: var_name, iter: iter, body: body, label: "" };
}
// with_loop_label stamps a parsed loop label onto a freshly-built while/for loop
// (a no-op for the empty label or a non-loop stmt). `loop`/for-range parse helpers
// return a StmtWhile/StmtFor; this re-wraps it carrying the label.
function with_loop_label(st: Stmt, label: string): Stmt {
    if (label.len() == 0) { return st; }
    match (st) {
        StmtWhile(w) => { return StmtWhile { cond: w.cond, body: w.body, label: label }; },
        StmtFor(fr) => { return StmtFor { var_name: fr.var_name, iter: fr.iter, body: fr.body, label: label }; },
        _ => { return st; }
    }
    return st;
}
function s_break(): Stmt { return StmtBreak { tag: 0, line: 0, col: 0, label: "" }; }
function s_break_at(line: i32, col: i32): Stmt { return StmtBreak { tag: 0, line: line, col: col, label: "" }; }
function s_continue(): Stmt { return StmtContinue { tag: 0, line: 0, col: 0, label: "" }; }
function s_continue_at(line: i32, col: i32): Stmt { return StmtContinue { tag: 0, line: line, col: col, label: "" }; }
function s_assign(target: string, value: Expr): Stmt {
    return StmtAssign { target: target, value: value, line: 0, col: 0, target_line: 0, target_col: 0 };
}
// s_assign_at carries the `=`-token position (line/col, where E003 points)
// and the target identifier's position (target_line/target_col, where the
// Go checker reports E001 for an undefined assignment target).
function s_assign_at(target: string, value: Expr, line: i32, col: i32, target_line: i32, target_col: i32): Stmt {
    return StmtAssign { target: target, value: value, line: line, col: col, target_line: target_line, target_col: target_col };
}
function s_match(scrutinee: Expr, arms: MatchArm[]): Stmt {
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: 0, col: 0, origin: "" };
}
function s_match_at(scrutinee: Expr, arms: MatchArm[], line: i32, col: i32): Stmt {
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "" };
}

// array_builder_elem extracts T from an "ArrayBuilder[T]" type spelling
// (the self-host parser keeps param types as strings). Returns "" when the
// spelling isn't ArrayBuilder[...]. See docs/ARRAY-BUILDER-PLAN.md.
function array_builder_elem(t: string): string {
    var prefix: string = "ArrayBuilder[";
    var pl: i32 = prefix.len();
    if (t.len() < pl + 1) { return ""; }
    if (t[t.len() - 1] != 93) { return ""; }  // 93 = ']'
    // Manual prefix match (parser.fern doesn't import std/string for
    // starts_with) — byte-compare against "ArrayBuilder[".
    var i: i32 = 0;
    while (i < pl) {
        if (t[i] != prefix[i]) { return ""; }
        i = i + 1;
    }
    return t[pl : t.len() - 1] + "";
}

// is_builder_mutation is true when `c` is `b.append(...)` / `b.with(...)` /
// `b.insert(...)` — an in-place builder mutation that becomes a reassignment.
// `insert` covers the Map.build builder (`b.insert(k, v)`).
function is_builder_mutation(c: ExprCall, b: string): boolean {
    match (c.callee) {
        ExprFieldAccess(fa) => {
            if (fa.field != "append" && fa.field != "with" && fa.field != "insert") { return false; }
            match (fa.obj) {
                ExprIdent(id) => { return id.name == b; },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// rewrite_builder_stmt retargets statement-position `b.append(...)` /
// `b.with(...)` into `b = b.append(...)`, recursing into every statement
// container so a builder mutated inside a loop / branch is handled. A
// builder call left unrewritten (e.g. inside a nested lambda, not descended
// into) stays a discarded value-returning result and trips E055 — loud, not
// a silent lost write.
function rewrite_builder_stmt(s: Stmt, b: string): Stmt {
    match (s) {
        StmtExpr(es) => {
            match (es.value) {
                ExprCall(c) => {
                    if (is_builder_mutation(c, b)) { return s_assign(b, es.value); }
                    return s;
                },
                _ => { return s; },
            }
        },
        StmtIf(f) => {
            return StmtIf { cond: f.cond, then_body: rewrite_builder_stmts(f.then_body, b), else_body: rewrite_builder_stmts(f.else_body, b) };
        },
        StmtWhile(w) => {
            return StmtWhile { cond: w.cond, body: rewrite_builder_stmts(w.body, b), label: w.label };
        },
        StmtFor(fr) => {
            return StmtFor { var_name: fr.var_name, iter: fr.iter, body: rewrite_builder_stmts(fr.body, b), label: fr.label };
        },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: MatchArm = m.arms[ai];
                arms = arms.append(MatchArm { pattern: arm.pattern, body: rewrite_builder_stmts(arm.body, b), line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard });
                ai = ai + 1;
            }
            return StmtMatch { scrutinee: m.scrutinee, arms: arms, line: m.line, col: m.col, origin: m.origin };
        },
        _ => { return s; },
    }
    return s;
}

function rewrite_builder_stmts(stmts: Stmt[], b: string): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        out = out.append(rewrite_builder_stmt(stmts[i], b));
        i = i + 1;
    }
    return out;
}

// maybe_desugar_array_build lowers `Array.build(function(b: ArrayBuilder[T]):
// void { BODY })` into a unique-local IIFE — the self-host mirror of the Go
// parser desugar (docs/ARRAY-BUILDER-PLAN.md). Returns `base` unchanged when
// it isn't a well-formed Array.build call.
function maybe_desugar_array_build(base: Expr): Expr {
    match (base) {
        ExprCall(call) => {
            match (call.callee) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "build") { return base; }
                    match (fa.obj) {
                        ExprIdent(id) => {
                            if (id.name != "Array") { return base; }
                            if (call.args.len() != 1) { return base; }
                            match (call.args[0]) {
                                ExprLambda(lam) => {
                                    if (lam.params.len() != 1) { return base; }
                                    var elem: string = array_builder_elem(lam.params[0].type_name);
                                    if (elem.len() == 0) { return base; }
                                    var bname: string = lam.params[0].name;
                                    var arrty: string = elem + "[]";
                                    var stmts: Stmt[] = [];
                                    stmts = stmts.append(s_var(bname, arrty, e_array([])));
                                    var rewritten: Stmt[] = rewrite_builder_stmts(lam.body, bname);
                                    var ri: i32 = 0;
                                    while (ri < rewritten.len()) {
                                        stmts = stmts.append(rewritten[ri]);
                                        ri = ri + 1;
                                    }
                                    stmts = stmts.append(s_return(e_ident(bname)));
                                    var iife: Expr = ExprLambda { params: [], ret_type: arrty, body: stmts, use_infer: false };
                                    return ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_argc: 0 };
                                },
                                _ => { return base; },
                            }
                        },
                        _ => { return base; },
                    }
                },
                _ => { return base; },
            }
        },
        _ => { return base; },
    }
    return base;
}

// map_builder_inner extracts "K, V" from a "MapBuilder[K, V]" type spelling
// (kept as a string by the self-host parser). Returns "" when the spelling
// isn't MapBuilder[...]. The map sibling of array_builder_elem.
function map_builder_inner(t: string): string {
    var prefix: string = "MapBuilder[";
    var pl: i32 = prefix.len();
    if (t.len() < pl + 1) { return ""; }
    if (t[t.len() - 1] != 93) { return ""; }  // 93 = ']'
    var i: i32 = 0;
    while (i < pl) {
        if (t[i] != prefix[i]) { return ""; }
        i = i + 1;
    }
    return t[pl : t.len() - 1] + "";
}

// maybe_desugar_map_build lowers `Map.build(function(b: MapBuilder[K, V]):
// void { BODY })` into a unique-local IIFE — the map sibling of
// maybe_desugar_array_build (docs/ARRAY-BUILDER-PLAN.md). `b` is a fresh
// non-escaping map so every `b.insert(k, v)` (rewritten to `b = b.insert(...)`)
// is the in-place fast path. Returns `base` unchanged when it isn't a
// well-formed Map.build call.
function maybe_desugar_map_build(base: Expr): Expr {
    match (base) {
        ExprCall(call) => {
            match (call.callee) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "build") { return base; }
                    match (fa.obj) {
                        ExprIdent(id) => {
                            if (id.name != "Map") { return base; }
                            if (call.args.len() != 1) { return base; }
                            match (call.args[0]) {
                                ExprLambda(lam) => {
                                    if (lam.params.len() != 1) { return base; }
                                    var inner: string = map_builder_inner(lam.params[0].type_name);
                                    if (inner.len() == 0) { return base; }
                                    var bname: string = lam.params[0].name;
                                    var mapty: string = "Map[" + inner + "]";
                                    var cargs: Expr[] = [];
                                    cargs = cargs.append(e_number("8", "", false));
                                    var stmts: Stmt[] = [];
                                    stmts = stmts.append(s_var(bname, mapty, e_call(e_ident("map_new"), cargs)));
                                    var rewritten: Stmt[] = rewrite_builder_stmts(lam.body, bname);
                                    var ri: i32 = 0;
                                    while (ri < rewritten.len()) {
                                        stmts = stmts.append(rewritten[ri]);
                                        ri = ri + 1;
                                    }
                                    stmts = stmts.append(s_return(e_ident(bname)));
                                    var iife: Expr = ExprLambda { params: [], ret_type: mapty, body: stmts, use_infer: false };
                                    return ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_argc: 0 };
                                },
                                _ => { return base; },
                            }
                        },
                        _ => { return base; },
                    }
                },
                _ => { return base; },
            }
        },
        _ => { return base; },
    }
    return base;
}
// s_match_origin is s_match_at tagged with the desugar that produced it
// ("if_let" / "let_else"); see StmtMatch.origin.
function s_match_origin(scrutinee: Expr, arms: MatchArm[], line: i32, col: i32, origin: string): Stmt {
    return StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin };
}
function p_variant(type_name: string, binding: string): Pattern {
    var no_extra: string[] = [];
    var no_nested: Pattern[] = [];
    return PatVariant { type_name: type_name, binding: binding, extra_bindings: no_extra, nested: no_nested };
}
function p_wildcard(): Pattern { return PatWildcard { tag: 0 }; }
function s_unknown(kind: string): Stmt { return StmtUnknown { kind: kind }; }
function s_defer(action: Stmt): Stmt { return StmtDefer { action: action, on_error: 0 }; }
function s_errdefer(action: Stmt): Stmt { return StmtDefer { action: action, on_error: 1 }; }

// label_depth returns the relative loop depth of `name` in the enclosing-loop
// label stack (the last entry is the innermost loop), or -1 if absent. Depth 0 is
// the innermost loop, 1 its enclosing loop, and so on.
function label_depth(labels: string[], name: string): i32 {
    var i: i32 = labels.len() - 1;
    while (i >= 0) {
        if (labels[i] == name) { return (labels.len() - 1) - i; }
        i = i - 1;
    }
    return 0 - 1;
}

// resolve_labels_stmt rewrites a labeled `break`/`continue`'s `tag` to the
// relative loop depth of its target label, recursing through every statement
// container (if / while / for / match / defer) so a break/continue
// anywhere in the nest is resolved against the live enclosing-loop label stack
// (`labels`; "" for an unlabeled loop). An unlabeled break/continue keeps tag 0
// (the innermost loop). This runs on the RAW parsed module before any desugar
// pass, so the loop labels are still in place and every downstream pass only has
// to carry the already-resolved `tag` (which break/continue stmts preserve by
// identity through those passes).
function resolve_labels_stmt(st: Stmt, labels: string[]): Stmt {
    match (st) {
        StmtBreak(b) => {
            if (b.label.len() == 0) { return st; }
            var d: i32 = label_depth(labels, b.label);
            if (d < 0) { d = 0; }
            return StmtBreak { tag: d, line: b.line, col: b.col, label: b.label };
        },
        StmtContinue(c) => {
            if (c.label.len() == 0) { return st; }
            var d2: i32 = label_depth(labels, c.label);
            if (d2 < 0) { d2 = 0; }
            return StmtContinue { tag: d2, line: c.line, col: c.col, label: c.label };
        },
        StmtWhile(w) => {
            return StmtWhile { cond: w.cond, body: resolve_labels_block(w.body, labels.append(w.label)), label: w.label };
        },
        StmtFor(fr) => {
            return StmtFor { var_name: fr.var_name, iter: fr.iter, body: resolve_labels_block(fr.body, labels.append(fr.label)), label: fr.label };
        },
        StmtIf(f) => {
            return StmtIf { cond: f.cond, then_body: resolve_labels_block(f.then_body, labels), else_body: resolve_labels_block(f.else_body, labels) };
        },
        StmtMatch(m) => {
            var arms2: MatchArm[] = [];
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var a: MatchArm = m.arms[ai];
                arms2 = arms2.append(MatchArm { pattern: a.pattern, body: resolve_labels_block(a.body, labels), line: a.line, col: a.col, guard: a.guard, has_guard: a.has_guard });
                ai = ai + 1;
            }
            return StmtMatch { scrutinee: m.scrutinee, arms: arms2, line: m.line, col: m.col, origin: m.origin };
        },
        StmtDefer(dd) => {
            return StmtDefer { action: resolve_labels_stmt(dd.action, labels), on_error: dd.on_error };
        },
        _ => { return st; }
    }
    return st;
}

function resolve_labels_block(stmts: Stmt[], labels: string[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        out = out.append(resolve_labels_stmt(stmts[i], labels));
        i = i + 1;
    }
    return out;
}

// resolve_labels_module bakes each labeled break/continue's relative loop depth
// into its `tag` (see resolve_labels_stmt). Runs first in the prepare pipeline,
// on the freshly parsed module.
pub function resolve_labels_module(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var none: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        funcs = funcs.append(FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: resolve_labels_block(fd.body, none), line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str });
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: resolve_labels_block(mod.top_stmts, none), enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}


// Parser state. `toks` is the lexer's output; `pos` is the
// current cursor into it. We mutate via value-semantics (return
// fresh Par from each consume()).

// `no_struct` suppresses the `Ident { … }` / `pkg.Type { … }`
// struct-literal shortcut in parse_primary while parsing an
// expression whose trailing `{` opens a block instead — the
// `for VAR in EXPR { body }` iter being the motivating case
// (`for x in a {}` must read `a` + an empty block, not the empty
// struct literal `a {}`). Set true only around the iter parse and
// restored afterward; it rides through advance() so it stays in
// force for the whole iter sub-expression, matching the Go
// parser's noStructLit (which likewise blocks nested struct lits
// in the iter — `for x in f(Foo{…})` is rejected on both).
struct Par { toks: lexer.Token[], pos: i32, no_struct: boolean }

function (p: Par) at_end(): boolean {
    if (p.pos >= p.toks.len()) { return true; }
    var t: lexer.Token = p.toks[p.pos];
    match (t) {
        lexer.TokEof(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

function (p: Par) peek(): lexer.Token {
    if (p.pos < p.toks.len()) { return p.toks[p.pos]; }
    return lexer.eof_tok(0, 0);
}

// peek_line / peek_col return the 1-based source position of the current
// token (0 when unavailable) — every token variant carries line/col, so
// the parser can stamp positions onto the AST nodes it builds.
function (p: Par) peek_line(): i32 {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokEof(x) => { return x.line; },
        lexer.TokNumber(x) => { return x.line; },
        lexer.TokIdent(x) => { return x.line; },
        lexer.TokKeyword(x) => { return x.line; },
        lexer.TokPunct(x) => { return x.line; },
        lexer.TokString(x) => { return x.line; },
        lexer.TokError(x) => { return x.line; },
        lexer.TokFString(x) => { return x.line; },
    }
    return 0;
}
function (p: Par) peek_col(): i32 {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokEof(x) => { return x.col; },
        lexer.TokNumber(x) => { return x.col; },
        lexer.TokIdent(x) => { return x.col; },
        lexer.TokKeyword(x) => { return x.col; },
        lexer.TokPunct(x) => { return x.col; },
        lexer.TokString(x) => { return x.col; },
        lexer.TokError(x) => { return x.col; },
        lexer.TokFString(x) => { return x.col; },
    }
    return 0;
}

function (p: Par) advance(): Par {
    return Par { toks: p.toks, pos: p.pos + 1, no_struct: p.no_struct };
}
// with_no_struct returns a cursor with the struct-literal-suppression
// flag set as given (position unchanged).
function (p: Par) with_no_struct(v: boolean): Par {
    return Par { toks: p.toks, pos: p.pos, no_struct: v };
}

// Token-shape queries: each returns "" when the token isn't of
// the expected kind, otherwise the text/name. Callers branch on
// the empty-string result rather than re-matching.
function (p: Par) peek_punct(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokPunct(x) => { return x.text; },
        _ => { return ""; }
    }
    return "";
}
function (p: Par) peek_keyword(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokKeyword(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// peek2_punct returns the punctuation text of the token ONE past the
// cursor ("" when it isn't a punctuator / out of range). The 2-token
// lookahead the call-argument parser needs to spot a named argument
// (`name = value`): the current token is the IDENT, this is the `=`.
function (p: Par) peek2_punct(): string {
    if (p.pos + 1 < p.toks.len()) {
        var t: lexer.Token = p.toks[p.pos + 1];
        match (t) {
            lexer.TokPunct(x) => { return x.text; },
            _ => { return ""; }
        }
    }
    return "";
}
function (p: Par) peek_ident(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokIdent(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// peek_is_literal reports whether the cursor sits on a number or
// string literal token. Used by the match-arm parser to recognise a
// literal-pattern arm (`0 => …`, `"yes" => …`) — a match on a
// non-enum (i32 / string) scrutinee — and desugar the whole match to
// an if/else-if chain (see build_literal_match), mirroring the native
// compiler's emitLiteralMatch.
function (p: Par) peek_is_literal(): boolean {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokNumber(x) => { return true; },
        lexer.TokString(x) => { return true; },
        _ => { return false; }
    }
    return false;
}

// peek_member_name returns the identifier at the cursor, OR a reserved
// keyword that is nonetheless allowed in MEMBER position — currently only
// `default` (a reserved keyword that doubles as the `Default` trait's
// method name `Type.default()`). Returns "" otherwise. Mirrors the Go
// parser's expectMemberName; used for function/method names and field
// access so `function default()` and `obj.default()` parse while the
// keyword stays reserved everywhere else.
function (p: Par) peek_member_name(): string {
    var nm: string = p.peek_ident();
    if (nm.len() > 0) { return nm; }
    if (p.peek_keyword() == "default") { return "default"; }
    return "";
}

// punct_at returns the punctuation text of the token at absolute index
// `idx` ("" when out of range or not a punct token). Used by the
// arrow-lambda lookahead, which must peek several tokens ahead of the
// cursor without advancing.
function (p: Par) punct_at(idx: i32): string {
    if (idx < 0 || idx >= p.toks.len()) { return ""; }
    var t: lexer.Token = p.toks[idx];
    match (t) {
        lexer.TokPunct(x) => { return x.text; },
        _ => { return ""; }
    }
    return "";
}
// ident_at returns the identifier name of the token at absolute index
// `idx` ("" when out of range or not an ident token).
function (p: Par) ident_at(idx: i32): string {
    if (idx < 0 || idx >= p.toks.len()) { return ""; }
    var t: lexer.Token = p.toks[idx];
    match (t) {
        lexer.TokIdent(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// keyword_at returns the keyword text of the token at absolute index
// `idx` ("" when out of range or not a keyword token). Used by the
// if_stmt_has_else lookahead (#4522), which scans past an `if`'s
// paren-balanced condition and brace-balanced then-body to peek for
// a trailing `else`.
function (p: Par) keyword_at(idx: i32): string {
    if (idx < 0 || idx >= p.toks.len()) { return ""; }
    var t: lexer.Token = p.toks[idx];
    match (t) {
        lexer.TokKeyword(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
// if_stmt_has_else reports whether the `if` the cursor is on has a
// trailing `else` clause, by skipping its paren-balanced condition and
// brace-balanced then-body and peeking for `else`. Used by
// branch_stmt_start (#4522) to route an else-LESS `if` in a block body
// through the statement path — such an `if` cannot be a value expression
// (an if-EXPRESSION requires `else`), so it is control flow. Mirrors the
// Go parser's ifStmtHasElse.
function (p: Par) if_stmt_has_else(): boolean {
    var i: i32 = p.pos + 1;  // skip `if`
    // Skip `( … )` (paren-balanced).
    if (p.punct_at(i) == "(") {
        var depth: i32 = 0;
        while (i < p.toks.len()) {
            var pt: string = p.punct_at(i);
            if (pt == "(") { depth = depth + 1; }
            else if (pt == ")") {
                depth = depth - 1;
                if (depth == 0) { i = i + 1; break; }
            }
            i = i + 1;
        }
    }
    // Skip `{ … }` (brace-balanced) then-body.
    if (p.punct_at(i) == "{") {
        var bdepth: i32 = 0;
        while (i < p.toks.len()) {
            var bt: string = p.punct_at(i);
            if (bt == "{") { bdepth = bdepth + 1; }
            else if (bt == "}") {
                bdepth = bdepth - 1;
                if (bdepth == 0) { i = i + 1; break; }
            }
            i = i + 1;
        }
    }
    return p.keyword_at(i) == "else";
}

// arrow_lambda_at reports whether the cursor (sitting on `(`) begins an
// arrow lambda — `() => …`, `(): R => …`, or `(IDENT: TYPE, …) [: R] => …`
// — as opposed to a grouping `(e)` or tuple `(e0, e1)`. The disambiguator
// (ported from the native parser's looksLikeArrowLambda, #2701): an arrow
// lambda's parens are empty or start with a typed param `IDENT :`, which an
// expression never does, and the matching `)` is followed by `=>` or `:`
// (the return-type colon). It scans to the balanced `)` and checks the
// token after it.
function (p: Par) arrow_lambda_at(): boolean {
    // p.pos is at "(".
    var open: i32 = p.pos;
    // Empty params: `(` `)` then `=>` / `:`.
    if (p.punct_at(open + 1) == ")") {
        var after: string = p.punct_at(open + 2);
        return after == "=>" || after == ":";
    }
    // Tuple-destructuring first param: `((a, b): (T, U), …) => …`.
    // After the outer `(` comes an inner `( IDENT` binding list whose
    // matching `)` is immediately followed by `:` — a shape no
    // expression has (`((a, b), c)` / `((a + b) * c)` never put a `:`
    // after the inner close). Scan the inner parens to check, then
    // fall through to the outer-paren scan below.
    if (p.punct_at(open + 1) == "(" && p.ident_at(open + 2).len() > 0) {
        var idepth: i32 = 0;
        var k: i32 = open + 1;
        var inner_ok: boolean = false;
        var scanning: boolean = true;
        while (scanning && k < p.toks.len()) {
            var ipk: string = p.punct_at(k);
            if (ipk == "(") { idepth = idepth + 1; }
            else if (ipk == ")") {
                idepth = idepth - 1;
                if (idepth == 0) {
                    inner_ok = p.punct_at(k + 1) == ":";
                    scanning = false;
                }
            }
            if (scanning) { k = k + 1; }
        }
        if (!inner_ok) { return false; }
    } else if (p.ident_at(open + 1).len() == 0 || p.punct_at(open + 2) != ":") {
        // Non-empty: must otherwise start with a typed param `IDENT :`.
        return false;
    }
    // Scan to the matching `)` and check the token after it.
    var depth: i32 = 0;
    var j: i32 = open;
    while (j < p.toks.len()) {
        var pk: string = p.punct_at(j);
        if (pk == "(") {
            depth = depth + 1;
        } else if (pk == ")") {
            depth = depth - 1;
            if (depth == 0) {
                var aft: string = p.punct_at(j + 1);
                return aft == "=>" || aft == ":";
            }
        }
        j = j + 1;
    }
    return false;
}

// parse_arrow_lambda parses `(params) [: R] => expr` into an ExprLambda
// whose body is the single statement `[return expr]` — exactly the AST the
// verbose `function (params): R { return expr; }` form produces, so the
// lambda-lift + IR-lowering machinery handles it with no further changes.
// The cursor is on the opening `(`. Parameter types are required (as in the
// verbose form); the return type is optional. Ported from the native
// parser's parseArrowLambda (#2701).
function parse_arrow_lambda(p: Par): (Expr, Par) {
    p = p.advance();  // consume `(`
    var params: ParamDecl[] = [];
    var apd_names: string[] = [];
    var apd_synths: string[] = [];
    var apd_lines: i32[] = [];
    var apd_cols: i32[] = [];
    if (p.peek_punct() != ")") {
        while (true) {
            if (p.peek_punct() == "(") {
                var (atpr_param, atpr_destr_names, atpr_line, atpr_col, atpr_p) = parse_tuple_param(p);
                p = atpr_p;
                if (atpr_destr_names.len() == 0) {
                    return (e_unknown("lambda: bad tuple param"), p);
                }
                params = params.append(atpr_param);
                apd_names = apd_names.append(atpr_destr_names);
                apd_synths = apd_synths.append(atpr_param.name);
                apd_lines = apd_lines.append(atpr_line);
                apd_cols = apd_cols.append(atpr_col);
                if (p.peek_punct() == ",") { p = p.advance(); continue; }
                break;
            }
            var (pr_param, pr_p) = parse_param(p);
            p = pr_p;
            params = params.append(pr_param);
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    var ret_type: string = "";
    if (p.peek_punct() == ":") {
        p = p.advance();
        var (rtr_name, rtr_ret_arr, rtr_fn_ret, rtr_p) = parse_type_name(p);
        p = rtr_p;
        ret_type = rtr_name;
    }
    if (p.peek_punct() == "=>") { p = p.advance(); }
    var (ber_expr, ber_p) = parse_expr(p);
    p = ber_p;
    var body: Stmt[] = [s_return(ber_expr)];
    body = prepend_param_destrs(body, apd_names, apd_synths, apd_lines, apd_cols);
    return parse_postfix(p, e_lambda(params, ret_type, body));
}

// Parse results are `(parsed_thing…, Par)` tuple returns — both pieces
// of the value + new-parser pair threaded through recursive-descent
// (docs/CURSOR-IDIOM.md). Avoids a stateful `var p: Par` shared across
// helpers.

// parse_map_lit parses a map literal `Map { k0: v0, k1: v1, … }` (the
// cursor is on the opening `{`) and desugars it to a chained
// `map_new[_i32](n).insert(k0,v0).insert(k1,v1)…` — insert returns the map, so
// the whole thing is one expression. map_new_i32 when the first key is
// a number literal (integer keys), else map_new (string keys), so the
// chained .set dispatch picks the right key compare.
function parse_map_lit(p: Par): (Expr, Par) {
    p = p.advance();   // consume `{`
    var mlk: Expr[] = [];
    var mlv: Expr[] = [];
    if (p.peek_punct() != "}") {
        while (true) {
            var (mke_expr, mke_p) = parse_expr(p);
            p = mke_p;
            if (p.peek_punct() == ":") { p = p.advance(); }
            var (mve_expr, mve_p) = parse_expr(p);
            p = mve_p;
            mlk = mlk.append(mke_expr);
            mlv = mlv.append(mve_expr);
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    // map_new_i32 when the first key is a number literal (integer keys),
    // else map_new (string keys). Written as an if/match EXPRESSION rather
    // than the old "declare temp, statement-match to assign it" workaround
    // (issue #4405 — block/if/match expressions now lower on every backend).
    var ctor: string = if (mlk.len() > 0) {
        match (mlk[0]) {
            ExprNumber(_) => "map_new_i32",
            _ => "map_new"
        }
    } else { "map_new" };
    var cargs: Expr[] = [];
    cargs = cargs.append(e_number("8", "", false));
    var mbase: Expr = e_call(e_ident(ctor), cargs);
    var mpi: i32 = 0;
    while (mpi < mlk.len()) {
        var sargs: Expr[] = [];
        sargs = sargs.append(mlk[mpi]);
        sargs = sargs.append(mlv[mpi]);
        mbase = e_call(e_field_access(mbase, "insert"), sargs);
        mpi = mpi + 1;
    }
    return parse_postfix(p, mbase);
}

// parse_struct_lit_body parses `{ f: v, … }` (the cursor is on the
// opening `{`) and returns an ExprStructLit with the given
// type_name. Shared by the bare-ident struct literal in
// parse_primary and the qualified `pkg.Type { … }` form in
// parse_postfix.
function parse_struct_lit_body(p: Par, type_name: string, sline: i32, scol: i32): (Expr, Par) {
    p = p.advance();  // consume `{`
    var fnames: string[] = [];
    var fvals: Expr[] = [];
    // Struct-update `Name { ...base, field: value }`: a leading
    // `...base` spread copies the un-overridden fields from `base`,
    // the listed fields override. `...base` must be first. With no
    // overrides (`Name { ...base }`) it's a legal pure copy.
    var has_base: boolean = false;
    var base: Expr = e_unknown("no-base");
    if (p.peek_punct() == "...") {
        p = p.advance();
        var (br_expr, br_p) = parse_expr(p);
        p = br_p;
        has_base = true;
        base = br_expr;
        if (p.peek_punct() == ",") {
            p = p.advance();
        } else {
            // No overrides — expect the closing brace (pure copy).
            if (p.peek_punct() != "}") {
                return (e_unknown("missing } in struct update"), p);
            }
            p = p.advance();
            return (e_struct_update(type_name, fnames, fvals, base, sline, scol), p);
        }
    }
    if (p.peek_punct() != "}") {
        while (true) {
            var fn: string = p.peek_ident();
            if (fn.len() == 0) {
                return (e_unknown("missing field name in struct lit"), p);
            }
            p = p.advance();
            if (p.peek_punct() != ":") {
                return (e_unknown("missing : in struct lit"), p);
            }
            p = p.advance();
            var (fv_expr, fv_p) = parse_expr(p);
            p = fv_p;
            fnames = fnames.append(fn);
            fvals = fvals.append(fv_expr);
            if (p.peek_punct() == ",") {
                p = p.advance();
                // Trailing comma before the closing brace is allowed
                // (std/test's TestRunner literals use it).
                if (p.peek_punct() == "}") { break; }
                continue;
            }
            break;
        }
    }
    if (p.peek_punct() != "}") {
        return (e_unknown("missing } in struct lit"), p);
    }
    p = p.advance();
    if (has_base) {
        return (e_struct_update(type_name, fnames, fvals, base, sline, scol), p);
    }
    return (e_struct_lit(type_name, fnames, fvals, sline, scol), p);
}

// parse_postfix runs the chained-postfix loop on a base
// expression. Handles call (`(args)`), index / slice (`[i]`,
// `[i:j]`), and field access (`.name` / `.0`). Returns when
// the next token isn't one of these. Used by parse_primary
// to share the loop across multiple base shapes — ident
// chains, parenthesised exprs, tuple / array literals.
function parse_postfix(p: Par, base: Expr): (Expr, Par) {
    // Carries the explicit type-argument count from a `[...]` instantiation to
    // the call `(...)` that immediately follows (`f[i32](x)`), so the call node
    // records it for the E040 arity check. Reset after each call.
    var pending_type_argc: i32 = 0;
    while (true) {
        var pk: string = p.peek_punct();
        if (pk == "(") {
            // The Go parser positions a Call at its opening paren
            // (`Call{P: open.Pos}`), so E004 (arity) lands here.
            var oline: i32 = p.peek_line();
            var ocol: i32 = p.peek_col();
            p = p.advance();
            var args: Expr[] = [];
            if (p.peek_punct() != ")") {
                while (true) {
                    // Named argument `name = value`: an IDENT immediately
                    // followed by a single `=` (peek2 is exactly "=", never
                    // "==" / "=>"). Encode it as a synthetic
                    // `ExprBinary("__named_arg", <name ident>, value)` marker;
                    // fill_default_args_module reorders these into positional
                    // order against the callee's params and fills omitted
                    // defaults, mirroring the native `defaultargs` pass. Without
                    // this, parse_expr reads `name` as a bare value and stops at
                    // `=`, breaking the call.
                    var an: string = p.peek_ident();
                    if (an.len() > 0 && p.peek2_punct() == "=") {
                        var aline: i32 = p.peek_line();
                        var acol: i32 = p.peek_col();
                        p = p.advance();   // consume the parameter name
                        p = p.advance();   // consume `=`
                        var (rv_expr, rv_p) = parse_expr(p);
                        p = rv_p;
                        args = args.append(ExprBinary { op: "__named_arg", left: ExprIdent { name: an, line: aline, col: acol }, right: rv_expr, line: aline, col: acol });
                    } else {
                        var (ra_expr, ra_p) = parse_expr(p);
                        p = ra_p;
                        args = args.append(ra_expr);
                    }
                    if (p.peek_punct() == ",") { p = p.advance(); continue; }
                    break;
                }
            }
            if (p.peek_punct() != ")") {
                return (e_unknown("missing ) in call"), p);
            }
            p = p.advance();
            base = ExprCall { callee: base, args: args, line: oline, col: ocol, type_argc: pending_type_argc };
            base = maybe_desugar_array_build(base);
            base = maybe_desugar_map_build(base);
            pending_type_argc = 0;
        } else if (pk == "[") {
            p = p.advance();
            // Leading-colon slice `a[:hi]` (low implicitly 0), mirroring the
            // Go parseCall's `[:b]` form. The `:` isn't a value expression, so
            // without handling it here the type-arg probe below would misread
            // `:hi` as erased type args and drop the slice (#4339). `a[:]` is
            // the full slice `[0:len]`.
            if (p.peek_punct() == ":") {
                p = p.advance(); // consume `:`
                // Low bound is a literal 0. Inlined (not bound to a local)
                // because the checker mishandles `var x: Expr = e_number(...)`
                // here but accepts e_number inline as a call argument.
                if (p.peek_punct() == "]") {
                    p = p.advance();
                    base = e_slice(base, e_number("0", "", false), e_call(e_field_access(base, "len"), []));
                    continue;
                }
                var (shi_expr, shi_p) = parse_expr(p);
                p = shi_p;
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in slice"), p);
                }
                p = p.advance();
                base = e_slice(base, e_number("0", "", false), shi_expr);
                continue;
            }
            // Generic instantiation `f[i32](…)` / `Box[T] { … }`: the
            // bracket holds type arguments, not a value index. Detect it by
            // probing parse_expr — if it makes no progress (a type keyword
            // like `i32` isn't a value expression), skip to the matching
            // `]` and erase the type args, leaving `base` unchanged.
            var idxStart: i32 = p.pos;
            var (idx_expr, idx_p) = parse_expr(p);
            if (idx_p.pos == idxStart) {
                // Count the top-level (comma-separated) type arguments while
                // skipping them, tracking nested `[...]` depth so a comma
                // inside `Map[K, V]` doesn't inflate the count.
                var ta_depth: i32 = 0;
                var ta_saw: boolean = false;
                var ta_commas: i32 = 0;
                while (!p.at_end()) {
                    var tp2: string = p.peek_punct();
                    if (tp2 == "]" && ta_depth == 0) { break; }
                    if (tp2 == "[") { ta_depth = ta_depth + 1; }
                    if (tp2 == "]") { ta_depth = ta_depth - 1; }
                    if (tp2 == "," && ta_depth == 0) { ta_commas = ta_commas + 1; }
                    ta_saw = true;
                    p = p.advance();
                }
                if (ta_saw) { pending_type_argc = ta_commas + 1; }
                if (p.peek_punct() == "]") { p = p.advance(); }
                // `Name[T] { … }` — a generic struct construction: the
                // erased base is the struct name; parse the literal body.
                if (p.peek_punct() == "{") {
                    match (base) {
                        ExprIdent(bid) => {
                            var (glit_expr, glit_p) = parse_struct_lit_body(p, bid.name, 0, 0);
                            p = glit_p;
                            base = glit_expr;
                        },
                        _ => {},
                    }
                }
                continue;
            }
            p = idx_p;
            if (p.peek_punct() == ":") {
                p = p.advance();
                // Open-ended high bound `a[lo:]` — the end defaults to the
                // source length, mirroring the Go parser's nil `High`. We
                // synthesise `base.len()` inline (no new Expr-typed local,
                // which the checker mis-resolves in this nested scope) so
                // every downstream consumer — checker, the three AST
                // emitters, and SSA build_func — sees a real i32 end rather
                // than the `ExprUnknown` placeholder they each mistranslate.
                if (p.peek_punct() == "]") {
                    p = p.advance();
                    base = e_slice(base, idx_expr, e_call(e_field_access(base, "len"), []));
                    continue;
                }
                var (end_expr, end_p) = parse_expr(p);
                p = end_p;
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in slice"), p);
                }
                p = p.advance();
                base = e_slice(base, idx_expr, end_expr);
            } else {
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in index"), p);
                }
                p = p.advance();
                base = e_index(base, idx_expr);
            }
        } else if (pk == ".") {
            // Field access `obj.field`. Field is either an
            // ident (struct field) or a numeric literal
            // (tuple index — `.0`, `.1`, …). Both shapes
            // store the field name as a bare string.
            // The Go parser positions a FieldAccess at its dot
            // (`FieldAccess{P: dot.Pos}`), so E043 / E046 land there.
            var dline: i32 = p.peek_line();
            var dcol: i32 = p.peek_col();
            p = p.advance();
            var fname: string = p.peek_member_name();
            if (fname.len() == 0) {
                match (p.peek()) {
                    lexer.TokNumber(n) => { fname = n.text; },
                    _ => { }
                }
            }
            if (fname.len() == 0) {
                return (e_unknown("missing field name after ."), p);
            }
            p = p.advance();
            // Qualified struct literal: `pkg.Type { f: v, … }`. Only
            // when the base is a bare (module) ident and a struct-lit
            // `{` follows — same look-ahead guard parse_primary uses
            // for bare `Name { … }` so it doesn't swallow a
            // `for x in pkg.iter { body }` block. flatten.fern
            // reconstructs parser AST nodes this way
            // (`parser.ExprBinary { … }`), so the self-host parser
            // must accept it to parse its own source.
            var qname: string = "";
            match (base) {
                ExprIdent(qid) => { qname = qid.name; },
                _ => { }
            }
            var qstruct_ok: boolean = false;
            if (qname.len() > 0 && !p.no_struct && p.peek_punct() == "{") {
                var qlook: Par = p.advance();
                if (qlook.peek_punct() == "}") {
                    qstruct_ok = true;
                } else if (qlook.peek_punct() == "...") {
                    // Struct-update spread: `pkg.Type { ...base, f: v }`.
                    // Mirrors the bare-ident look-ahead below; without
                    // this the `...` falls through to a field access and
                    // the `{ … }` is mis-parsed (a qualified-type spread
                    // such as `asmcore.EmitState { ...s, … }`).
                    qstruct_ok = true;
                } else if ((qlook.peek_ident()).len() > 0) {
                    var qlook2: Par = qlook.advance();
                    if (qlook2.peek_punct() == ":") { qstruct_ok = true; }
                }
            }
            if (qstruct_ok) {
                var (qr_expr, qr_p) = parse_struct_lit_body(p, qname + "." + fname, 0, 0);
                p = qr_p;
                base = qr_expr;
            } else {
                base = e_field_access_at(base, fname, dline, dcol);
            }
        } else if (p.peek_keyword() == "as") {
            // `expr as Type` cast. Desugar to a unary op
            // `as_<Type>` (operand = base); the emitter masks /
            // sign-extends per the target integer width (see
            // asm.fern). Modelling it as a unary keeps `base` in
            // argument position — the checker mishandles `Expr`
            // identity for a reassigned local in var-decl / array-
            // push position but accepts it as a function argument
            // (cf. e_call(base, …) above). Without this branch the
            // parser would stall on the `as` keyword.
            var asline: i32 = p.peek_line();
            var ascol: i32 = p.peek_col();
            p = p.advance();
            // `expr as? Type` downcast (docs/DYN-TRAITS.md §9): an `as`
            // immediately followed by `?` is the fallible `dyn Trait`
            // downcast, NOT the numeric/ascription cast. Disambiguate by
            // peeking the `?` here and tagging the unary op `as?_<Type>`
            // (vs the plain `as_<Type>`); irlower lowers it to a shape
            // read + compare yielding Option[T]. Consume the `?` now so it
            // binds to `as` and isn't mis-read as the postfix `?` try op.
            var is_downcast: boolean = false;
            if (p.peek_punct() == "?") { is_downcast = true; p = p.advance(); }
            // Read the full target type spelling via parse_type_name so the
            // cast op name carries any generic args / array `[]` / qualified
            // `pkg.Type` suffix (`e as i32[]` → `as_i32[]`, `e as Option[i32]`
            // → `as_Option[i32]`) instead of stalling on the brackets or
            // mis-reading them as a postfix index. Earlier this dropped the
            // generic args, so a binding `var x = None as Option[i32]` rebound
            // to the payload-less `var x: Option = None` — which the self-host
            // IR path can't size (a bare `None` has no statically-known payload
            // type), bailing the whole module to the AST backend (#2669). The
            // generic suffix only matters for a payload-less operand like
            // `None` (a `Some(e)` / `[e]` operand carries its own type), but
            // preserving it is uniformly correct and the cast still lowers as a
            // zero-cost identity. Numeric targets (`as i32`, `as f64`) come
            // back as the bare name, so is_numeric_cast_op still recognises
            // them. parse_type_name also folds a trailing `[]` and a qualified
            // `pkg.Type` chain the old single-ident read left on the cursor.
            var (castty_name, castty_ret_arr, castty_fn_ret, castty_p) = parse_type_name(p);
            p = castty_p;
            var tyname: string = castty_name;
            if (is_downcast) { base = e_unary_at("as?_" + tyname, base, asline, ascol); }
            else { base = e_unary_at("as_" + tyname, base, asline, ascol); }
        } else if (p.peek_punct() == "?") {
            // `expr?` try operator. Desugar to the unary op `try_`
            // (operand = base); the emitter unwraps a Some/Ok payload
            // or early-returns the None/Err box from the enclosing
            // (Option/Result-returning) function. Stamp the `?` token's
            // position so the E042 diagnostics anchor where native does.
            var qline: i32 = p.peek_line();
            var qcol: i32 = p.peek_col();
            p = p.advance();
            base = e_unary_at("try_", base, qline, qcol);
        } else {
            break;
        }
    }
    return (base, p);
}

// parse_expr_from_text re-lexes + parses an f-string interpolant's
// raw text into an Expr. The lexer already isolated the interpolant
// (balanced braces, inner string literals skipped), so a fresh
// tokenize + parse_expr round-trip recovers the AST. Mirrors the Go
// parser's parseExprFromText.
function parse_expr_from_text(text: string): Expr {
    var toks: lexer.Token[] = lexer.tokenize(text);
    var sub: Par = Par { toks: toks, pos: 0, no_struct: false };
    var (r_expr, r_p) = parse_expr(sub);
    return r_expr;
}

// parse_primary: number, ident (which may extend to call), string,
// bool, parenthesised expr, unknown otherwise.
function parse_primary(p: Par): (Expr, Par) {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokNumber(x) => {
            var nline: i32 = p.peek_line();
            var ncol: i32 = p.peek_col();
            p = p.advance();
            // Route through parse_postfix so a numeric primary can
            // carry a trailing `as Type` cast (e.g. `15 as u8`).
            return parse_postfix(p, e_number_at(x.text, x.suffix, x.is_float, nline, ncol));
        },
        lexer.TokString(x) => {
            var sline: i32 = p.peek_line();
            var scol: i32 = p.peek_col();
            p = p.advance();
            // Allow postfix chains on string literals — e.g.
            // `"a,b,c".split(",")`. Without parse_postfix the
            // `.split` would dangle and the surrounding caller
            // would treat the literal as the whole expression.
            return parse_postfix(p, e_string_at(x.value, sline, scol));
        },
        lexer.TokKeyword(x) => {
            if (x.name == "true") {
                p = p.advance();
                // Route through parse_postfix like the number / string literal
                // arms so a postfix chain on a bool literal (`true.to_i()`) is
                // parsed, not silently dropped (#4338).
                return parse_postfix(p, e_bool(true));
            }
            if (x.name == "false") {
                p = p.advance();
                return parse_postfix(p, e_bool(false));
            }
            if (x.name == "function") {
                // Anonymous function expression: `function (a:
                // T, …): RT { body }`. Same grammar as the
                // top-level FuncDecl minus the name and the
                // optional receiver clause.
                p = p.advance();  // consume `function`
                if (p.peek_punct() != "(") {
                    return (e_unknown("lambda: missing ("), p);
                }
                p = p.advance();
                var params: ParamDecl[] = [];
                var lpd_names: string[] = [];
                var lpd_synths: string[] = [];
                var lpd_lines: i32[] = [];
                var lpd_cols: i32[] = [];
                if (p.peek_punct() != ")") {
                    while (true) {
                        if (p.peek_punct() == "(") {
                            var (ltpr_param, ltpr_destr_names, ltpr_line, ltpr_col, ltpr_p) = parse_tuple_param(p);
                            p = ltpr_p;
                            if (ltpr_destr_names.len() == 0) {
                                return (e_unknown("lambda: bad tuple param"), p);
                            }
                            params = params.append(ltpr_param);
                            lpd_names = lpd_names.append(ltpr_destr_names);
                            lpd_synths = lpd_synths.append(ltpr_param.name);
                            lpd_lines = lpd_lines.append(ltpr_line);
                            lpd_cols = lpd_cols.append(ltpr_col);
                            if (p.peek_punct() == ",") { p = p.advance(); continue; }
                            break;
                        }
                        var (pr_param, pr_p) = parse_param(p);
                        p = pr_p;
                        params = params.append(pr_param);
                        if (p.peek_punct() == ",") { p = p.advance(); continue; }
                        break;
                    }
                }
                if (p.peek_punct() == ")") { p = p.advance(); }
                var lret: string = "";
                if (p.peek_punct() == ":") {
                    p = p.advance();
                    var (ltr_name, ltr_ret_arr, ltr_fn_ret, ltr_p) = parse_type_name(p);
                    p = ltr_p;
                    lret = ltr_name;
                }
                var (lblk_body, lblk_p) = parse_block(p);
                p = lblk_p;
                var lbody: Stmt[] = prepend_param_destrs(lblk_body, lpd_names, lpd_synths, lpd_lines, lpd_cols);
                return parse_postfix(p, e_lambda(params, lret, lbody));
            }
            if (x.name == "match") {
                // match-expression in value position: desugar to an
                // immediately-invoked closure wrapping a statement-match whose
                // arms `return` (see parse_match_expr), reusing the existing
                // match + lambda codegen. Route through parse_postfix so
                // `(match …).method()` chains.
                var mc: IfChain = parse_match_expr(p);
                var mno_params: ParamDecl[] = [];
                var mlam_body: Stmt[] = [mc.stmt];
                var mno_args: Expr[] = [];
                var miife: Expr = e_call(e_lambda(mno_params, mc.rt, mlam_body), mno_args);
                return parse_postfix(mc.par, miife);
            }
            if (x.name == "if") {
                // if-expression in value position: desugar to an
                // immediately-invoked closure (see parse_if_chain). Route
                // through parse_postfix so `(if …).method()` chains.
                var ic: IfChain = parse_if_chain(p);
                var no_params: ParamDecl[] = [];
                var lam_body: Stmt[] = [ic.stmt];
                var no_args: Expr[] = [];
                var iife: Expr = e_call(e_lambda(no_params, ic.rt, lam_body), no_args);
                return parse_postfix(ic.par, iife);
            }
            // A TYPE keyword used as a MODULE name: `string.repeat_char(…)`
            // imports std/string, whose basename alias `string` collides with the
            // `string` type keyword, so the lexer emits a keyword token, not an
            // ident. When a type keyword is immediately followed by `.`, it is a
            // module-qualified reference base (not a type) — parse it as a bare
            // ident and let parse_postfix handle the `.field(…)` chain;
            // flatten_qualified then rewrites `string.f` -> `string__f`. Without
            // this the keyword fell through to e_unknown and the call never lowered
            // (the native parser already accepts this form). Guarded by the
            // following `.` so a type keyword in any other position is unaffected.
            var is_tykw: boolean = x.name == "string" || x.name == "boolean" || x.name == "void"
                || x.name == "i32" || x.name == "i64"
                || x.name == "u8" || x.name == "u32" || x.name == "u64"
                || x.name == "usize" || x.name == "f32" || x.name == "f64";
            if (is_tykw) {
                var kwline: i32 = p.peek_line();
                var kwcol: i32 = p.peek_col();
                var look: Par = p.advance();
                if (look.peek_punct() == ".") {
                    return parse_postfix(look, e_ident_at(x.name, kwline, kwcol));
                }
            }
            return (e_unknown("keyword:" + x.name), p);
        },
        lexer.TokIdent(x) => {
            var idline: i32 = p.peek_line();
            var idcol: i32 = p.peek_col();
            p = p.advance();
            var base: Expr = e_ident_at(x.name, idline, idcol);
            // Map literal `Map { k0: v0, … }` — parsed in a helper
            // (kept out of this arm so it stays small enough for the
            // backend's branch-displacement limits).
            if (x.name == "Map" && p.peek_punct() == "{") {
                return parse_map_lit(p);
            }
            // Struct literal: `Name { f: v, g: w }`. Only valid
            // when the base is still a bare ident (the struct
            // type's name). Consumes the whole construct;
            // subsequent postfixes (field access, etc.) can
            // chain through the postfix loop. We disambiguate
            // from `for x in Name { body }` (where `Name` is
            // the iter, not a struct-lit type) by peeking two
            // tokens ahead: a real struct-lit is either empty
            // (`{}`) or starts with `Ident :`. Anything else
            // means the `{` belongs to a surrounding block.
            var struct_lit_ok: boolean = false;
            if (!p.no_struct && p.peek_punct() == "{") {
                var look: Par = p.advance();
                if (look.peek_punct() == "}") {
                    struct_lit_ok = true;
                } else if (look.peek_punct() == "...") {
                    // `Name { ...base ... }` — struct-update spread.
                    struct_lit_ok = true;
                } else if ((look.peek_ident()).len() > 0) {
                    var look2: Par = look.advance();
                    if (look2.peek_punct() == ":") { struct_lit_ok = true; }
                }
            }
            if (struct_lit_ok) {
                // Delegate to the shared body parser (same as the qualified
                // `pkg.Type { … }` path at parse_postfix and the generic
                // `Name[T] { … }` path) rather than re-implementing the
                // spread / field / trailing-comma loop inline (SH-040).
                var (slr_expr, slr_p) = parse_struct_lit_body(p, x.name, idline, idcol);
                p = slr_p;
                base = slr_expr;
            }
            return parse_postfix(p, base);
        },
        lexer.TokPunct(x) => {
            if (x.text == "(") {
                // Arrow lambda `(params) [: R] => expr` — a concise anonymous
                // function whose body is a single expression (desugared to
                // `function (params): R { return expr; }`, the same ExprLambda
                // the verbose form produces). Checked before the grouping /
                // tuple parse: an arrow lambda's parens hold a parameter list
                // (`IDENT : TYPE`, or empty), which a grouping (`(e)`) or tuple
                // (`(e0, e1)`) never does. See #2701.
                if (p.arrow_lambda_at()) {
                    return parse_arrow_lambda(p);
                }
                // `(expr)` — grouping. `(e0, e1, …)` — tuple
                // literal. The first expr decides whether we're
                // grouping or building a tuple: a `,` follow-up
                // means tuple; anything else (`)`) means a plain
                // parenthesized expression. Either way the
                // result feeds through the postfix loop so
                // `(a, b).0` and `(f(x)).y` both work.
                var tpl: i32 = p.peek_line();
                var tpc: i32 = p.peek_col();
                p = p.advance();
                var (inner_expr, inner_p) = parse_expr(p);
                p = inner_p;
                if (p.peek_punct() == ",") {
                    var elems: Expr[] = [];
                    elems = elems.append(inner_expr);
                    while (p.peek_punct() == ",") {
                        p = p.advance();
                        if (p.peek_punct() == ")") { break; }
                        var (er_expr, er_p) = parse_expr(p);
                        p = er_p;
                        elems = elems.append(er_expr);
                    }
                    if (p.peek_punct() == ")") { p = p.advance(); }
                    return parse_postfix(p, e_tuple_at(elems, tpl, tpc));
                }
                if (p.peek_punct() == ")") { p = p.advance(); }
                return parse_postfix(p, inner_expr);
            }
            if (x.text == "[") {
                // Array literal `[e1, e2, e3]`. Empty `[]` allowed.
                p = p.advance();
                var elems: Expr[] = [];
                if (p.peek_punct() != "]") {
                    while (true) {
                        var (er_expr, er_p) = parse_expr(p);
                        p = er_p;
                        elems = elems.append(er_expr);
                        if (p.peek_punct() == ",") { p = p.advance(); continue; }
                        break;
                    }
                }
                if (p.peek_punct() != "]") {
                    return (e_unknown("missing ] in array literal"), p);
                }
                p = p.advance();
                return parse_postfix(p, e_array(elems));
            }
            if (x.text == "{" && !p.no_struct) {
                // General value-position block-expression (#4521) — the
                // self-host mirror of the Go parser's parsePrimary `{` case.
                // Reuse parse_branch_body (the if/match value-branch machinery,
                // which already desugars `{ s; …; tail }` to `[<stmts…>,
                // s_return(tail)]`) and wrap it in an immediately-invoked
                // zero-arg lambda, exactly like the if/match value expressions
                // desugar above. Gated on !no_struct like the `Ident { … }`
                // struct-literal case so a loop/if HEADER's trailing `{` still
                // opens the body rather than being consumed here.
                var (bb_body, bb_rt, bb_p) = parse_branch_body(p);
                var bx_params: ParamDecl[] = [];
                var bx_args: Expr[] = [];
                var iife: Expr = e_call(e_lambda(bx_params, bb_rt, bb_body), bx_args);
                return parse_postfix(bb_p, iife);
            }
            if (x.text == "-" || x.text == "!") {
                // The Go parser positions a Unary at its operator token
                // (`Unary{P: op.Pos}`), so E009 (`!`) lands there.
                var uline: i32 = p.peek_line();
                var ucol: i32 = p.peek_col();
                p = p.advance();
                var (operand_expr, operand_p) = parse_primary(p);
                return (e_unary_at(x.text, operand_expr, uline, ucol), operand_p);
            }
            // Unknown leading punct — advance past it so the
            // surrounding parse loop can recover. Skipping the
            // advance would loop forever in parse_program when
            // a stmt has stray trailing punct (e.g. tuple-lit
            // postfix that doesn't pair with the TokIdent's
            // chain loop).
            p = p.advance();
            return (e_unknown("punct:" + x.text), p);
        },
        lexer.TokEof(_) => { return (e_unknown("eof"), p); },
        lexer.TokError(x) => { return (e_unknown("lex error: " + x.msg), p); },
        lexer.TokFString(f) => {
            p = p.advance();
            // Desugar to a `+`-chain, mirroring the Go checker's
            // FString lowering: literal parts → string literals,
            // interpolant parts → `(<sub-parsed expr>).to_string()`,
            // folded left-to-right. An empty f-string desugars to "".
            var built: Expr = e_string("");
            var has: boolean = false;
            var i: i32 = 0;
            while (i < f.parts.len()) {
                var part: lexer.FStringPart = f.parts[i];
                var piece: Expr = e_string(part.lit);
                if (part.is_expr) {
                    var no_args: Expr[] = [];
                    piece = e_call(e_field_access(parse_expr_from_text(part.expr), "to_string"), no_args);
                }
                if (!has) {
                    built = piece;
                    has = true;
                } else {
                    built = e_binary("+", built, piece);
                }
                i = i + 1;
            }
            // Allow postfix chains on the f-string value (`f"...".len()`),
            // consistent with the plain string-literal arm.
            return parse_postfix(p, built);
        }
    }
    return (e_unknown("primary"), p);
}

// precedence: higher binds tighter. Returns -1 for non-binop
// punctuators. Mirrors the Go parser's Pratt-style table.
function precedence(op: string): i32 {
    if (op == "||") { return 1; }
    if (op == "&&") { return 2; }
    if (op == "|") { return 3; }
    if (op == "^") { return 4; }
    if (op == "&") { return 5; }
    if (op == "==" || op == "!=") { return 6; }
    if (op == "<" || op == ">" || op == "<=" || op == ">=") { return 7; }
    if (op == "<<" || op == ">>") { return 8; }
    if (op == "+" || op == "-") { return 9; }
    if (op == "*" || op == "/" || op == "%") { return 10; }
    return 0 - 1;
}

// parse_binary uses precedence climbing. `min_prec` is the
// minimum precedence the caller will accept — recursively
// climbs while the next operator's prec is >= min_prec.
function parse_binary(p: Par, min_prec: i32): (Expr, Par) {
    var (lhs_expr, lhs_p) = parse_primary(p);
    p = lhs_p;
    while (true) {
        var op: string = p.peek_punct();
        var prec: i32 = precedence(op);
        if (prec < min_prec) { return (lhs_expr, p); }
        // The Go parser positions a Binary at its operator token
        // (`Binary{P: opTok.Pos}`), so E009 / E041 land there.
        var opline: i32 = p.peek_line();
        var opcol: i32 = p.peek_col();
        p = p.advance();
        var (rhs_expr, rhs_p) = parse_binary(p, prec + 1);
        p = rhs_p;
        lhs_expr = e_binary_at(op, lhs_expr, rhs_expr, opline, opcol);
    }
    return (lhs_expr, p);
}

function parse_expr(p: Par): (Expr, Par) {
    return parse_pipe(p);
}

// IfChain carries a parsed if-expression chain: the StmtIf (whose arms
// `return` the branch expressions) plus a return-type tag for the IIFE.
pub struct IfChain { par: Par, stmt: Stmt, rt: string }

// if_expr_rt picks a return-type tag for the if-expression's IIFE from
// the then-branch's shape. The IIFE value itself is always correct (an
// 8-byte slot); this tag only labels the result for the rare case of
// dispatching a method directly on an unannotated if-expression.
function if_expr_rt(e: Expr): string {
    match (e) {
        ExprString(_) => { return "string"; },
        ExprBool(_) => { return "bool"; },
        ExprNumber(n) => {
            if (n.is_float) { return "f64"; }
            return "i32";
        },
        _ => { return "i32"; }
    }
}

// LitArm is one arm of a match on a non-enum (i32 / string) scrutinee:
// a literal to compare against (`lit`, dispatched via `==`) or the `_`
// catch-all (`is_wild`), plus an optional guard and the arm body. The
// match-arm parsers (parse_match_stmt / parse_match_expr) collect these
// only when the first arm is a literal, then hand them to
// build_literal_match instead of emitting a StmtMatch.
// `has_range` marks a range pattern `lo..hi` / `lo..=hi`: `lit` is the low
// bound, `range_hi` the high, and `range_inclusive` picks `..=` (inclusive)
// over `..` (exclusive). build_literal_match lowers it to a bound test
// `scrut >= lo && scrut <op> hi` instead of `scrut == lit`.
struct LitArm { is_wild: boolean, lit: Expr, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32, range_hi: Expr, has_range: boolean, range_inclusive: boolean }

// parse_lit_or_range parses a scalar-pattern low bound and, when a `..` /
// `..=` follows, the high bound of a range pattern. Returns (low, high,
// has_range, inclusive, par); high is a dummy when has_range is false.
//
// Bounds parse with parse_binary(p, 4) — min-precedence 4 (just above `|`,
// precedence 3), so a bare `|` is left for the or-pattern splitter
// (parse_lit_alts) rather than being consumed as bitwise-or. A plain literal
// is a primary, so this is byte-identical to the previous min-prec 1 for
// every scalar pattern that doesn't top-level a `|` / `&&` / `||` (none do).
function parse_lit_or_range(p: Par): (Expr, Expr, boolean, boolean, Par) {
    var (lo_expr, lo_p) = parse_binary(p, 4);
    p = lo_p;
    var pk: string = p.peek_punct();
    if (pk == ".." || pk == "..=") {
        p = p.advance();
        var (hi_expr, hi_p) = parse_binary(p, 4);
        p = hi_p;
        return (lo_expr, hi_expr, true, pk == "..=", p);
    }
    return (lo_expr, e_bool(true), false, false, p);
}

// parse_lit_alts parses one-or-more `|`-separated scalar patterns
// (`1 | 2 | 3`, or ranges) sharing a guard + body. Each alternative becomes
// its own LitArm; the parallel arrays run in alternative order.
function parse_lit_alts(p: Par): (Expr[], Expr[], boolean[], boolean[], Par) {
    var lits: Expr[] = [];
    var his: Expr[] = [];
    var hrs: boolean[] = [];
    var incs: boolean[] = [];
    var (l0, h0, hr0, inc0, p0) = parse_lit_or_range(p);
    p = p0;
    lits = lits.append(l0);
    his = his.append(h0);
    hrs = hrs.append(hr0);
    incs = incs.append(inc0);
    while (p.peek_punct() == "|") {
        p = p.advance();
        var (ln, hn, hrn, incn, pn) = parse_lit_or_range(p);
        p = pn;
        lits = lits.append(ln);
        his = his.append(hn);
        hrs = hrs.append(hrn);
        incs = incs.append(incn);
    }
    return (lits, his, hrs, incs, p);
}

// build_literal_match lowers a match on a non-enum scrutinee to a nested
// if/else-if chain — the same shape the native compiler's emitLiteralMatch
// emits. The chain is built
// backwards: the `_` arm's body is the base else; each literal arm wraps
// it as `if (scrut == lit) { body } else { rest }` (a guard folds in as
// `scrut == lit && guard`). The caller only routes here when at least
// one literal arm exists, so the result is always an if statement.
// EXCEPTION: a wildcard `_` that isn't the LAST arm is an E026 error
// (native: "wildcard `_` arm must be last"). The backward desugar would
// silently swallow the unreachable post-`_` arms, and with no StmtMatch
// left the checker can't see the misplaced wildcard. So in that case we
// DON'T desugar: we hand back a real StmtMatch (the `_` arm as
// PatWildcard, every literal arm as a bare PatVariant("") whose empty
// type-name the E028 / E015 / E030 checks all skip) so the existing
// match_diags / block_exits passes emit exactly E026 — the same single
// code native produces. Such a program never type-checks, so this
// StmtMatch never reaches codegen, and a well-formed literal match
// (wildcard last or absent) still desugars unchanged.
function build_literal_match(scrut: Expr, arms: LitArm[], mkline: i32, mkcol: i32): Stmt {
    var wi: i32 = 0;
    var non_last_wild: boolean = false;
    while (wi < arms.len()) {
        // Only an UNGUARDED `_` is a true catch-all that makes the
        // following arms dead (and that native treats as exhaustive, so
        // E026 is its only diagnostic). A guarded `_ when c` is
        // conditional — its exhaustiveness (E030) is a separate concern —
        // so leave those on the normal desugar path.
        if (arms[wi].is_wild && !arms[wi].has_guard && wi < arms.len() - 1) { non_last_wild = true; }
        wi = wi + 1;
    }
    if (non_last_wild) {
        var marms: MatchArm[] = [];
        var mi: i32 = 0;
        while (mi < arms.len()) {
            var la: LitArm = arms[mi];
            var pat: Pattern = p_variant("", "");
            if (la.is_wild) { pat = p_wildcard(); }
            marms = marms.append(MatchArm { pattern: pat, body: la.body, line: la.line, col: la.col, guard: la.guard, has_guard: la.has_guard });
            mi = mi + 1;
        }
        return s_match_at(scrut, marms, mkline, mkcol);
    }
    var else_body: Stmt[] = [];
    var i: i32 = arms.len() - 1;
    while (i >= 0) {
        var a: LitArm = arms[i];
        if (a.is_wild) {
            if (a.has_guard) {
                else_body = [s_if(a.guard, a.body, else_body)];
            } else {
                else_body = a.body;
            }
        } else {
            var cond: Expr = e_binary("==", scrut, a.lit);
            if (a.has_range) {
                // `lo..hi` / `lo..=hi` → `scrut >= lo && scrut <op> hi`.
                // Built at parse time, so the self-host checker settles the
                // comparison widths — no manual stamping needed (unlike the
                // native IR path).
                var hi_op: string = "<";
                if (a.range_inclusive) { hi_op = "<="; }
                cond = e_binary("&&", e_binary(">=", scrut, a.lit), e_binary(hi_op, scrut, a.range_hi));
            }
            if (a.has_guard) { cond = e_binary("&&", cond, a.guard); }
            else_body = [s_if(cond, a.body, else_body)];
        }
        i = i - 1;
    }
    if (else_body.len() == 0) { return s_unknown("empty literal match"); }
    return else_body[0];
}

// ---- Tuple-pattern match (`match (pair) { (0, y) => …, (x, y) => … }`) ----
//
// A `(` at the FIRST arm's pattern position marks a match on a
// tuple-typed scrutinee. Arms are parsed into TupArm records and the
// whole match desugars at parse time (build_tuple_match) into
// constructs the rest of the pipeline already handles:
//
//   if (true) {                                  // scopes the temps
//     var (__tmL_C_e0, __tmL_C_e1) = <scrutinee>; // the destructure StmtVar
//     var __tmL_C_d = false;                      // "an arm ran" flag
//     if (!__tmL_C_d && __tmL_C_e0 == LIT && …) { // literal elements
//       var x = __tmL_C_e1;                       // binder elements
//       if (<guard>) { __tmL_C_d = true; <body> } // guard sees the binds
//     }
//     …one if per arm; `_` and all-binder arms have no eq conditions…
//   }
//
// The flag chain (instead of build_literal_match's backwards if/else
// nesting) is what lets a guard run AFTER the arm's binders are
// declared while a guard-false still falls through to the next arm.
// The native checker validated arity / exhaustiveness / types before
// any of this runs on the self-host path, so no diagnostics are
// re-implemented here. Element kinds: 0 = binder, 1 = `_`, 2 = literal.
struct TupArm { is_wild: boolean, elem_kinds: i32[], binds: string[], lits: Expr[], guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32 }

// parse_tuple_arm_pattern consumes `(p0, p1, …)` with the cursor on the
// opening `(`, returning the element encoding. A parse problem yields
// elem_kinds.len() == 0 (the callers emit a degenerate stmt).

function parse_tuple_arm_pattern(p: Par): (i32[], string[], Expr[], Par) {
    var elem_kinds: i32[] = [];
    var binds: string[] = [];
    var lits: Expr[] = [];
    var none: i32[] = [];
    p = p.advance(); // consume `(`
    while (p.peek_punct() != ")" && !p.at_end()) {
        var n: string = p.peek_ident();
        if (n == "_") {
            p = p.advance();
            elem_kinds = elem_kinds.append(1);
            binds = binds.append("");
            lits = lits.append(e_bool(true));
        } else if (n.len() > 0) {
            p = p.advance();
            elem_kinds = elem_kinds.append(0);
            binds = binds.append(n);
            lits = lits.append(e_bool(true));
        } else if (p.peek_is_literal()) {
            var (le_expr, le_p) = parse_expr(p);
            p = le_p;
            elem_kinds = elem_kinds.append(2);
            binds = binds.append("");
            lits = lits.append(le_expr);
        } else {
            return (none, [], [], p);
        }
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    if (elem_kinds.len() < 2) {
        return (none, [], [], p);
    }
    return (elem_kinds, binds, lits, p);
}

// build_tuple_match assembles the desugared statement described above.
function build_tuple_match(scrut: Expr, arms: TupArm[], mkline: i32, mkcol: i32): Stmt {
    if (arms.len() == 0) { return s_unknown("empty tuple match"); }
    // Element count comes from the first tuple-pattern arm (the checker
    // guarantees all arms agree with the scrutinee's arity).
    var n_elems: i32 = 0;
    var ai: i32 = 0;
    while (ai < arms.len()) {
        if (!arms[ai].is_wild) { n_elems = arms[ai].elem_kinds.len(); break; }
        ai = ai + 1;
    }
    if (n_elems < 2) { return s_unknown("tuple match with no tuple arm"); }
    var base: string = "__tm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
    var done: string = base + "_d";
    var names: string = "";
    var k: i32 = 0;
    while (k < n_elems) {
        if (k > 0) { names = names + ","; }
        names = names + base + "_e" + util.i32_to_string(k);
        k = k + 1;
    }
    var outer: Stmt[] = [];
    outer = outer.append(s_var_at(names, "", scrut, mkline, mkcol));
    outer = outer.append(s_var(done, "", e_bool(false)));
    ai = 0;
    while (ai < arms.len()) {
        var a: TupArm = arms[ai];
        var cond: Expr = e_unary("!", e_ident(done));
        var inner: Stmt[] = [];
        if (a.is_wild) {
            // `_` arm: no element tests, no binds; a guard folds into
            // the condition (short-circuit keeps it after the flag).
            if (a.has_guard) { cond = e_binary("&&", cond, a.guard); }
            inner = inner.append(s_assign(done, e_bool(true)));
            var wb: i32 = 0;
            while (wb < a.body.len()) { inner = inner.append(a.body[wb]); wb = wb + 1; }
            outer = outer.append(s_if(cond, inner, []));
            ai = ai + 1;
            continue;
        }
        var ek: i32 = 0;
        while (ek < a.elem_kinds.len()) {
            if (a.elem_kinds[ek] == 2) {
                cond = e_binary("&&", cond, e_binary("==", e_ident(base + "_e" + util.i32_to_string(ek)), a.lits[ek]));
            }
            ek = ek + 1;
        }
        // Binder decls run on the matched path, before the guard.
        var binds: Stmt[] = [];
        ek = 0;
        while (ek < a.elem_kinds.len()) {
            if (a.elem_kinds[ek] == 0) {
                binds = binds.append(s_var_at(a.binds[ek], "", e_ident_at(base + "_e" + util.i32_to_string(ek), a.line, a.col), a.line, a.col));
            }
            ek = ek + 1;
        }
        if (a.has_guard) {
            var guarded: Stmt[] = [];
            guarded = guarded.append(s_assign(done, e_bool(true)));
            var gb: i32 = 0;
            while (gb < a.body.len()) { guarded = guarded.append(a.body[gb]); gb = gb + 1; }
            var bi: i32 = 0;
            while (bi < binds.len()) { inner = inner.append(binds[bi]); bi = bi + 1; }
            inner = inner.append(s_if(a.guard, guarded, []));
        } else {
            inner = inner.append(s_assign(done, e_bool(true)));
            var bi2: i32 = 0;
            while (bi2 < binds.len()) { inner = inner.append(binds[bi2]); bi2 = bi2 + 1; }
            var ab: i32 = 0;
            while (ab < a.body.len()) { inner = inner.append(a.body[ab]); ab = ab + 1; }
        }
        outer = outer.append(s_if(cond, inner, []));
        ai = ai + 1;
    }
    return s_if(e_bool(true), outer, []);
}

// parse_branch_body yields a parsed if/match value-branch body: the
// Stmt[] (leading statements followed by `s_return(tail)`) plus the
// return-type tag derived from the TAIL expression (the block's value).

// branch_stmt_start reports whether the next token begins a STATEMENT
// inside an if/match value-branch body (block-expressions slice 1). These
// are the keyword-led statements parse_stmt handles directly (each
// consumes its own terminator) plus a nested `{`-block. `if` / `match`
// are deliberately EXCLUDED: they stand as the trailing value expression
// (`{ …; if (c) { a } else { b } }`) and the single-expr branch form
// `else { if (c) { … } else { … } }` relies on the inner if/match parsing
// as a value-expression. Everything else parses as an expression
// (an ExprStmt when a `;` follows, else the trailing tail). Mirrors the
// Go parser's branchStmtStart.
function branch_stmt_start(p: Par): boolean {
    if (p.peek_punct() == "{") { return true; }
    var kw: string = p.peek_keyword();
    // #4522: an else-LESS `if` in a block body is a control-flow STATEMENT
    // (`{ if (early) { return 0; } …; tail }`), not the value expression — an
    // if-EXPRESSION requires `else`, so an else-less `if` can never be a tail
    // value. An `if` WITH `else` stays on the expression path so
    // `{ …; if (c) { a } else { b } }` still yields a value and the else-if
    // chain form is unaffected.
    if (kw == "if" && !p.if_stmt_has_else()) { return true; }
    if (kw == "while" || kw == "loop" || kw == "for" || kw == "break"
        || kw == "continue" || kw == "return" || kw == "defer"
        || kw == "errdefer" || kw == "var" || kw == "let"
        || kw == "function") { return true; }
    return false;
}

// parse_branch_body parses the `{ … }` body of an if/match value-branch
// (block-expressions slice 1), mirroring the Go parser's parseBranchBody.
// The body is a sequence of `;`-terminated statements run before an
// optional trailing expression written WITHOUT a `;` — that trailing
// expression is the branch's value. The cursor is expected on `{`.
//
//   - `{ e }`          → `[s_return(e)]` (single-expr branch, kept
//     byte-identical to the pre-block-expr behaviour so existing
//     if/match expressions don't regress).
//   - `{ s; …; tail }` → `[<leading stmts…>, s_return(tail)]`, which
//     irlower's lower_value_tail already lowers (leading statements +
//     a final value-producing statement).
//
// A keyword-led item (var/let/while/… or a nested `{`-block) parses as a
// statement via parse_stmt. A non-keyword item parses as an expression:
// an ExprStmt if a `;` follows, otherwise the trailing TAIL (which must
// be followed by `}`). The `rt` tag is derived from the TAIL expression
// (the value), not a leading statement, so the desugared IIFE / value-
// lowering gets the right return type.
function parse_branch_body(p: Par): (Stmt[], string, Par) {
    var ebody: Stmt[] = [];
    var rt: string = "i32";
    if (p.peek_punct() != "{") {
        ebody = ebody.append(s_unknown("missing { in branch body"));
        return (ebody, rt, p);
    }
    p = p.advance();  // consume `{`
    var leading: Stmt[] = [];
    var have_tail: boolean = false;
    var tail: Expr = e_unknown("empty branch");
    while (p.peek_punct() != "}" && !p.at_end()) {
        if (branch_stmt_start(p)) {
            var (sr_stmt, sr_p) = parse_stmt(p);
            // Progress guard: a malformed statement that consumed no token
            // would otherwise spin forever — skip it instead.
            if (sr_p.pos == p.pos) { p = p.advance(); continue; }
            p = sr_p;
            leading = leading.append(sr_stmt);
            continue;
        }
        // Non-keyword item: an expression that is either an ExprStmt
        // (followed by `;`) or the trailing value (followed by `}`).
        var (er_expr, er_p) = parse_expr(p);
        p = er_p;
        if (p.peek_punct() == ";") {
            p = p.advance();
            leading = leading.append(s_expr(er_expr));
            continue;
        }
        // No `;` — this is the trailing tail expression; `}` must follow.
        tail = er_expr;
        have_tail = true;
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    if (have_tail) { rt = if_expr_rt(tail); }
    // A value-less block (no trailing tail) in value position has no
    // result — yield a StmtUnknown so the branch surfaces an error rather
    // than silently miscompiling (the Go checker reports E061).
    if (!have_tail) {
        leading = leading.append(s_unknown("value branch has no trailing expression"));
        return (leading, rt, p);
    }
    leading = leading.append(s_return(tail));
    return (leading, rt, p);
}

// parse_if_chain parses `if (c) { E1 } else { E2 }` (and `else if`
// chains, via recursion through the else arm) into a StmtIf whose arms
// `return` the branch expressions. parse_primary wraps the result in an
// IIFE `(function(): RT { <stmt> })()`, so it lowers to the ExprCall +
// ExprLambda the rest of the pipeline already handles — no new AST node,
// so every backend supports if-expressions at once. The IIFE captures
// any referenced locals automatically (the lambda machinery computes
// captures). Mirrors the Go parser's parseIfExpr: then/else are
// block-with-tail bodies (block-expressions slice 1) — a multi-statement
// branch (`{ var k = …; k }`) runs the leading statements then yields the
// trailing tail — and a final `else` is required (the if-expression is
// total). A lone trailing expression with no leading statements stays
// `[s_return(expr)]`, byte-identical to the pre-block-expr behaviour.
function parse_if_chain(p: Par): IfChain {
    p = p.advance();                              // `if`
    if (p.peek_punct() == "(") { p = p.advance(); }
    var (condr_expr, condr_p) = parse_expr(p);
    p = condr_p;
    if (p.peek_punct() == ")") { p = p.advance(); }
    var (thenb_body, thenb_rt, thenb_p) = parse_branch_body(p);
    p = thenb_p;
    var then_body: Stmt[] = thenb_body;
    var rt: string = thenb_rt;
    if (p.peek_keyword() == "else") { p = p.advance(); }
    var else_body: Stmt[] = [];
    if (p.peek_keyword() == "if") {
        // `else if (…) { … }` — the else arm is itself an if-chain.
        var nested: IfChain = parse_if_chain(p);
        p = nested.par;
        else_body = [nested.stmt];
    } else {
        var (elseb_body, elseb_rt, elseb_p) = parse_branch_body(p);
        p = elseb_p;
        else_body = elseb_body;
    }
    return IfChain { par: p, stmt: s_if(condr_expr, then_body, else_body), rt: rt };
}

// parse_match_expr parses `match (e) { Pat => E, Pat when C => E, … }` in value
// position into a StmtMatch whose arms `return` their (bare) expression, plus a
// return-type tag for the IIFE. parse_primary wraps the result in an IIFE
// (`(function(): RT { <stmt> })()`), so it reuses the statement-match + lambda
// codegen every backend already supports — no new AST node, so all backends
// get match-expressions at once (mirrors parse_if_chain).
function parse_match_expr(p: Par): IfChain {
    var mkline: i32 = p.peek_line();
    var mkcol: i32 = p.peek_col();
    p = p.advance();                              // `match`
    if (p.peek_punct() == "(") { p = p.advance(); }
    var (sr_expr, sr_p) = parse_expr(p);
    p = sr_p;
    if (p.peek_punct() == ")") { p = p.advance(); }
    var rt: string = "i32";
    if (p.peek_punct() == "{") { p = p.advance(); }
    // A `(` at the FIRST arm's pattern position marks a match on a
    // TUPLE scrutinee — same build_tuple_match desugar as the statement
    // form; the surrounding IIFE (built by the caller) turns the
    // arm bodies' `return`s into the expression's value.
    if (p.peek_punct() == "(") {
        var etarms: TupArm[] = [];
        var etfirst: boolean = true;
        while (p.peek_punct() != "}" && !p.at_end()) {
            var etline: i32 = p.peek_line();
            var etcol: i32 = p.peek_col();
            var et_wild: boolean = false;
            var et_kinds: i32[] = [];
            var et_binds: string[] = [];
            var et_lits: Expr[] = [];
            if (p.peek_punct() == "(") {
                var (etpr_elem_kinds, etpr_binds, etpr_lits, etpr_p) = parse_tuple_arm_pattern(p);
                p = etpr_p;
                if (etpr_elem_kinds.len() == 0) {
                    return IfChain { par: p, stmt: s_unknown("bad tuple pattern"), rt: rt };
                }
                et_kinds = etpr_elem_kinds;
                et_binds = etpr_binds;
                et_lits = etpr_lits;
            } else {
                var (etwp_pattern, etwp_p) = parse_pattern(p);
                p = etwp_p;
                et_wild = true;
            }
            var et_guard: Expr = e_bool(true);
            var et_has_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (etgr_expr, etgr_p) = parse_expr(p);
                p = etgr_p;
                et_guard = etgr_expr;
                et_has_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            var etbody: Stmt[] = [];
            var etrt: string = "i32";
            if (p.peek_punct() == "{") {
                var (etbb_body, etbb_rt, etbb_p) = parse_branch_body(p);
                p = etbb_p;
                etbody = etbb_body;
                etrt = etbb_rt;
            } else {
                var (eter_expr, eter_p) = parse_expr(p);
                p = eter_p;
                etbody = [s_return(eter_expr)];
                etrt = if_expr_rt(eter_expr);
            }
            if (etfirst) { rt = etrt; etfirst = false; }
            etarms = etarms.append(TupArm { is_wild: et_wild, elem_kinds: et_kinds, binds: et_binds, lits: et_lits, guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol });
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return IfChain { par: p, stmt: build_tuple_match(sr_expr, etarms, mkline, mkcol), rt: rt };
    }
    // A literal at the FIRST arm's pattern position marks a match on a
    // non-enum (i32 / string) scrutinee: parse every arm as a literal /
    // `_` and desugar to an if/else-if chain (build_literal_match). The
    // decision is made once, up front, so the common enum/variant match
    // takes the normal StmtMatch path below with no extra allocation.
    if (p.peek_is_literal()) {
        var lit_arms: LitArm[] = [];
        var lfirst: boolean = true;
        while (p.peek_punct() != "}" && !p.at_end()) {
            var laline: i32 = p.peek_line();
            var lacol: i32 = p.peek_col();
            var lwild: boolean = false;
            var lalt_lits: Expr[] = [];
            var lalt_his: Expr[] = [];
            var lalt_hrs: boolean[] = [];
            var lalt_incs: boolean[] = [];
            if (p.peek_is_literal()) {
                var (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
                p = la_p;
                lalt_lits = la_lits;
                lalt_his = la_his;
                lalt_hrs = la_hrs;
                lalt_incs = la_incs;
            } else {
                var (lpr_pattern, lpr_p) = parse_pattern(p);
                p = lpr_p;
                lwild = true;
            }
            var lguard: Expr = e_bool(true);
            var lhas_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (lgr_expr, lgr_p) = parse_expr(p);
                p = lgr_p;
                lguard = lgr_expr;
                lhas_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            // A `{ … }` arm body is a block-with-tail (block-expressions
            // slice 1): leading statements then the trailing value. A bare
            // expression arm body stays the pre-block-expr single-expr form.
            var lbody: Stmt[] = [];
            var lrt: string = "i32";
            if (p.peek_punct() == "{") {
                var (lbb_body, lbb_rt, lbb_p) = parse_branch_body(p);
                p = lbb_p;
                lbody = lbb_body;
                lrt = lbb_rt;
            } else {
                var (ler_expr, ler_p) = parse_expr(p);
                p = ler_p;
                lbody = [s_return(ler_expr)];
                lrt = if_expr_rt(ler_expr);
            }
            if (lfirst) { rt = lrt; lfirst = false; }
            if (lwild) {
                lit_arms = lit_arms.append(LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false });
            } else {
                // One LitArm per `|` alternative, sharing the guard + body.
                var lai: i32 = 0;
                while (lai < lalt_lits.len()) {
                    lit_arms = lit_arms.append(LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai] });
                    lai = lai + 1;
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return IfChain { par: p, stmt: build_literal_match(sr_expr, lit_arms, mkline, mkcol), rt: rt };
    }
    var arms: MatchArm[] = [];
    var first: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
        var aline: i32 = p.peek_line();
        var acol: i32 = p.peek_col();
        var (pr_pattern, pr_p) = parse_pattern(p);
        p = pr_p;
        // Or-patterns: `A | B | … => expr` — one MatchArm per alternative,
        // sharing the guard + body. Variant patterns only (see the stmt-form
        // note); a literal-first match takes the build_literal_match path.
        var pats: Pattern[] = [pr_pattern];
        while (p.peek_punct() == "|") {
            p = p.advance();
            var (pr2_pattern, pr2_p) = parse_pattern(p);
            p = pr2_p;
            pats = pats.append(pr2_pattern);
        }
        var arm_guard: Expr = e_bool(true);
        var arm_has_guard: boolean = false;
        if (p.peek_keyword() == "when") {
            p = p.advance();
            var (gr_expr, gr_p) = parse_expr(p);
            p = gr_p;
            arm_guard = gr_expr;
            arm_has_guard = true;
        }
        if (p.peek_punct() == "=>") { p = p.advance(); }
        // A `{ … }` arm body is a block-with-tail (block-expressions slice
        // 1): leading statements then the trailing value. A bare expression
        // arm body stays the pre-block-expr single-expr form.
        var abody: Stmt[] = [];
        var art: string = "i32";
        if (p.peek_punct() == "{") {
            var (abb_body, abb_rt, abb_p) = parse_branch_body(p);
            p = abb_p;
            abody = abb_body;
            art = abb_rt;
        } else {
            var (er_expr, er_p) = parse_expr(p);
            p = er_p;
            abody = [s_return(er_expr)];
            art = if_expr_rt(er_expr);
        }
        if (first) { rt = art; first = false; }
        var pi: i32 = 0;
        while (pi < pats.len()) {
            arms = arms.append(MatchArm { pattern: pats[pi], body: abody, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard });
            pi = pi + 1;
        }
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    arms = desugar_nested_arms(arms, 0);
    return IfChain { par: p, stmt: s_match_at(sr_expr, arms, mkline, mkcol), rt: rt };
}

// pipe_prepend builds [head] ++ tail — the argument list for a piped
// call where `head` (the piped value) becomes the first argument.
function pipe_prepend(head: Expr, tail: Expr[]): Expr[] {
    var out: Expr[] = [head];
    var i: i32 = 0;
    while (i < tail.len()) {
        out = out.append(tail[i]);
        i = i + 1;
    }
    return out;
}

// pipe_desugar lowers `left |> right`. `x |> f(a, b)` prepends x to the
// call's args → `f(x, a, b)`; `x |> f(a, _)` substitutes x at the `_`
// topic placeholder instead → `f(a, x)` (at most one `_`, direct args
// only — the native parser rejects two with P004, so a native-valid
// program has at most one; this mirror substitutes at the first);
// `x |> f` (a bare callee) wraps it as a single-arg call → `f(x)`.
// Mirrors the Go parser's parsePipe, lowering to the same ExprCall the
// rest of the pipeline already handles.
function pipe_desugar(left: Expr, right: Expr): Expr {
    match (right) {
        ExprCall(c) => {
            var hole: i32 = 0 - 1;
            var hi: i32 = 0;
            while (hi < c.args.len()) {
                if (hole < 0) {
                    match (c.args[hi]) {
                        ExprIdent(id) => { if (id.name == "_") { hole = hi; } },
                        _ => {}
                    }
                }
                hi = hi + 1;
            }
            if (hole >= 0) {
                var subst: Expr[] = [];
                var si: i32 = 0;
                while (si < c.args.len()) {
                    if (si == hole) {
                        subst = subst.append(left);
                    } else {
                        subst = subst.append(c.args[si]);
                    }
                    si = si + 1;
                }
                return e_call(c.callee, subst);
            }
            return e_call(c.callee, pipe_prepend(left, c.args));
        },
        _ => {
            var one: Expr[] = [left];
            return e_call(right, one);
        }
    }
}

// parse_pipe sits just above parse_binary (looser than every binary
// operator, left-associative): the operands of `|>` are full binary
// expressions and the pipe itself only binds at the expression top
// level, matching the Go grammar (parseExpr -> parsePipe -> parseLogicOr).
// parse_range handles the range EXPRESSION `a..b` / `a..=b`, desugaring it to a
// first-class iterator value: `iter.range(a, b)` / `iter.range_incl(a, b)` —
// core/iter's `Range`, which implements `Iterator`, so `iter.sum(0..n)` and
// `(0..10)` passed to any combinator flow through the iterator protocol
// (requires `import "core/iter"`; flatten_qualified rewrites `iter.range` ->
// `iter__range`). It sits just below the pipe operator and reads its operands
// with parse_binary so `0..n+1` is `0..(n+1)`. The `for i in LOW..HIGH` loop
// keeps its own counted-loop desugar — parse_for_stmt reads its bounds with
// parse_binary (below this level), so a range there stays the optimized form.
function parse_range(p: Par): (Expr, Par) {
    var (left_expr, left_p) = parse_binary(p, 1);
    p = left_p;
    var pk: string = p.peek_punct();
    if (pk == ".." || pk == "..=") {
        p = p.advance();
        var fn: string = "range";
        if (pk == "..=") { fn = "range_incl"; }
        var (right_expr, right_p) = parse_binary(p, 1);
        p = right_p;
        var callee: Expr = e_field_access(e_ident("iter"), fn);
        var args: Expr[] = [left_expr, right_expr];
        return (e_call(callee, args), p);
    }
    return (left_expr, p);
}

function parse_pipe(p: Par): (Expr, Par) {
    var (left_expr, left_p) = parse_range(p);
    p = left_p;
    var acc: Expr = left_expr;
    while (p.peek_punct() == "|>") {
        p = p.advance();
        var (right_expr, right_p) = parse_range(p);
        p = right_p;
        acc = pipe_desugar(acc, right_expr);
    }
    return (acc, p);
}

// parse_stmt: `var x = expr;`, `return expr;`, or `expr;`.
// parse_block consumes `{ stmt; stmt; … }` and returns the
// resulting Stmt[]. The opening `{` is expected to be the current
// token. On malformed input — missing `{` or `}` — the result is
// a single StmtUnknown so the outer caller can still surface a
// reasonable error site.

function parse_block(p: Par): (Stmt[], Par) {
    if (p.peek_punct() != "{") {
        var miss: Stmt[] = [s_unknown("missing { in block")];
        return (miss, p);
    }
    p = p.advance();
    var (r_body, r_p) = parse_block_body(p);
    p = r_p;
    if (p.peek_punct() == "}") { p = p.advance(); }
    return (r_body, p);
}

// parse_block_body parses statements up to (but not consuming) the block's
// closing `}`. Split from parse_block so the callback-passing `use` bind can
// recurse on the rest of the block.
function parse_block_body(p: Par): (Stmt[], Par) {
    var body: Stmt[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
        // `use NAME [: TYPE] <- CALL;` — monadic-bind / callback-passing sugar
        // (native parseUse). The rest of the enclosing block becomes the body
        // of a callback lambda appended as CALL's last argument, and the block
        // returns CALL's result. `use n <- apply(41); <rest>` desugars to
        // `return apply(41, (n) => { <rest> });`. A nested `use` in <rest>
        // recurses. Without this the line shredded (#4335).
        if (p.peek_keyword() == "use") {
            p = p.advance(); // consume `use`
            var uname: string = p.peek_ident();
            if (uname.len() > 0) { p = p.advance(); }
            var utype: string = "";
            if (p.peek_punct() == ":") {
                p = p.advance();
                var (utn_name, utn_ret_arr, utn_fn_ret, utn_p) = parse_type_name(p);
                p = utn_p;
                utype = utn_name;
            }
            // `<-` lexes as `<` then `-`.
            if (p.peek_punct() == "<") { p = p.advance(); }
            if (p.peek_punct() == "-") { p = p.advance(); }
            var (usrc_expr, usrc_p) = parse_expr(p);
            p = usrc_p;
            if (p.peek_punct() == ";") { p = p.advance(); }
            // The rest of the block is the callback body (recurse so a further
            // `use` chains).
            var (rest_body, rest_p) = parse_block_body(p);
            p = rest_p;
            var cbparam: ParamDecl = ParamDecl { name: uname, type_name: utype, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" };
            var cbparams: ParamDecl[] = [cbparam];
            // use_infer marks the synthesised callback when the user wrote
            // no `: TYPE` — the checker's E032 rule verifies the binding
            // type is inferrable from the callee's signature (native
            // inferUseParam). An annotated `use n: T <- …` never draws E032.
            var cb: Expr = ExprLambda { params: cbparams, ret_type: "", body: rest_body, use_infer: utype.len() == 0 };
            match (usrc_expr) {
                ExprCall(c) => {
                    var newargs: Expr[] = c.args.append(cb);
                    body = body.append(s_return(e_call(c.callee, newargs)));
                },
                _ => {
                    body = body.append(s_unknown("use source must be a function call"));
                },
            }
            return (body, p);
        }
        var (r_stmt, r_p) = parse_stmt(p);
        // Guarantee progress: a malformed statement that doesn't consume a
        // token would otherwise spin forever — skip it instead.
        if (r_p.pos == p.pos) {
            p = p.advance();
            continue;
        }
        p = r_p;
        body = body.append(r_stmt);
    }
    return (body, p);
}

// parse_block_or_stmt accepts EITHER a braced `{ … }` block OR a single
// braceless statement, wrapping the latter in a one-element body. Native
// control-flow bodies (if-then/else, while, loop, `for x in it`) are a
// `parseStmt`, so `if (x == 0) x = 40;` is valid there; the self-host used
// to require `{` and mis-parsed a braceless body into an
// `/*unknown-stmt: missing { in block*/` with the real statement hoisted to
// run unconditionally (#4337). Only the control-flow body sites route here;
// function / match-arm / lambda blocks still require braces.
function parse_block_or_stmt(p: Par): (Stmt[], Par) {
    if (p.peek_punct() == "{") { return parse_block(p); }
    var (r_stmt, r_p) = parse_stmt(p);
    // Guarantee progress on a malformed body token rather than spinning.
    if (r_p.pos == p.pos) {
        var none: Stmt[] = [s_unknown("missing statement in braceless body")];
        return (none, p.advance());
    }
    var one: Stmt[] = [r_stmt];
    return (one, r_p);
}

// parse_pattern reads a single match-arm pattern. Forms accepted:
//   _                  — PatWildcard
//   Name               — PatVariant { type_name: Name, binding: "" }
//   Name(_)            — PatVariant { type_name: Name, binding: "_" }
//   Name(ident)        — PatVariant { type_name: Name, binding: ident }
// The lexer treats `_` as an identifier (underscore is a valid
// alpha byte) so wildcards arrive here via peek_ident.

function parse_pattern(p: Par): (Pattern, Par) {
    var name: string = p.peek_ident();
    // `true` / `false` arms (and other keyword-named patterns) arrive as
    // keyword tokens, not idents — fall back to the keyword text.
    if (name.len() == 0) { name = p.peek_keyword(); }
    if (name == "_") {
        p = p.advance();
        return (p_wildcard(), p);
    }
    // A literal-pattern arm (`1 => …`, `"yes" => …`) only reaches
    // parse_pattern when an EARLIER arm wasn't a literal (so the whole
    // match took the variant path) — e.g. a wildcard-first match
    // `_ => …, 1 => …`, which is itself an E026 error. The literal token
    // is not an ident/keyword, so without consuming it here the cursor
    // would stick on it: the arm's `=>` and body would fail to parse,
    // corrupting the return-path (E052) analysis. Consume it and yield a
    // bare PatVariant("") — the empty type-name is skipped by the E028 /
    // E015 variant checks, leaving only the E026 the misplaced wildcard
    // already earns.
    if (p.peek_is_literal()) {
        p = p.advance();
        return (p_variant("", ""), p);
    }
    if (name.len() == 0) {
        return (p_variant("", ""), p);
    }
    p = p.advance();
    // Qualified variant pattern: `pkg.Variant` (e.g.
    // `lexer.TokNumber(n)`). Consume the `.ident` suffix chain so
    // cross-module variant patterns parse. Without this the `.` is
    // left on the cursor and parse_match_stmt's arm loop can't
    // advance — it spins, allocating until OOM. parser.fern's own
    // matches use `lexer.TokX(...)` throughout, so this is required
    // for the self-host parser to parse its own source. Same gap as
    // parse_type_name's qualified-name handling.
    while (p.peek_punct() == ".") {
        p = p.advance();  // consume `.`
        var seg: string = p.peek_ident();
        if (seg.len() == 0) { seg = p.peek_keyword(); }
        if (seg.len() == 0) { break; }
        name = name + "." + seg;
        p = p.advance();
    }
    var binding: string = "";
    var extra_bindings: string[] = [];
    var nested: Pattern[] = [];
    if (p.peek_punct() == "(") {
        p = p.advance();
        // Parse comma-separated payload bindings: `Variant(a, b, …)`. The
        // first is `binding`; the rest go to `extra_bindings` so the checker
        // can flag a payload-arity mismatch (E015). Single-payload variants
        // (all the self-host supports) use only `binding`.
        //
        // A single-payload slot that itself begins a variant pattern
        // (`Some(Ok(n))` — an ident followed by `(` / `{` / `.`) is a NESTED
        // sub-pattern: recurse and record it in `nested`; desugar_nested_arms
        // later rewrites the arm to a flat outer arm + inner match. A bare
        // ident stays a plain binder, so `Some(x)` is unchanged.
        var bn: i32 = 0;
        while (p.peek_punct() != ")" && !p.at_end()) {
            if (bn == 0 && p.peek_ident().len() > 0
                && (p.peek2_punct() == "(" || p.peek2_punct() == "{" || p.peek2_punct() == ".")) {
                var (sub_pat, sub_p) = parse_pattern(p);
                p = sub_p;
                nested = nested.append(sub_pat);
                bn = bn + 1;
            } else {
                var inner: string = p.peek_ident();
                if (inner.len() > 0) {
                    if (bn == 0) { binding = inner; } else { extra_bindings = extra_bindings.append(inner); }
                    bn = bn + 1;
                    p = p.advance();
                } else {
                    p = p.advance();
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); }
        }
        if (p.peek_punct() == ")") { p = p.advance(); }
    }
    return (PatVariant { type_name: name, binding: binding, extra_bindings: extra_bindings, nested: nested }, p);
}

// prepend_stmt returns a fresh statement list with `s` in front of `body`.
// Isolating the concat in a helper (rather than an inline `var xs: Stmt[] =
// []` + appends of field-derived elements) keeps the element type canonical
// through the parameter, so the imported-module type mangling stays
// consistent.
function prepend_stmt(s: Stmt, body: Stmt[]): Stmt[] {
    var out: Stmt[] = [];
    out = out.append(s);
    var i: i32 = 0;
    while (i < body.len()) {
        out = out.append(body[i]);
        i = i + 1;
    }
    return out;
}

// pv_name returns a pattern's variant type-name, or "" for a wildcard.
function pv_name(pat: Pattern): string {
    match (pat) {
        PatVariant(v) => { return v.type_name; },
        PatWildcard(w) => { return ""; }
    }
    return "";
}

// arm_is_nested reports whether an arm's pattern carries a nested sub-pattern.
function arm_is_nested(arm: MatchArm): boolean {
    match (arm.pattern) {
        PatVariant(v) => { return v.nested.len() > 0; },
        PatWildcard(w) => { return false; }
    }
    return false;
}

// desugar_nested_arms rewrites arms carrying nested sub-patterns
// (`Some(Ok(n))`) into flat arms whose body re-matches the payload on an
// inner match, grouping contiguous same-variant arms into one merged arm
// `V(__nest…) => match __nest… { … }`. A no-op returning the arms unchanged
// when no arm nests — so every existing match (the whole self-host source
// among them) parses byte-identically. `depth` keeps the synthesised payload
// temp unique across nesting levels. Recurses so `Some(Ok(Some(x)))` desugars
// at every depth.
function desugar_nested_arms(arms: MatchArm[], depth: i32): MatchArm[] {
    // Any-nested short-circuit: leaves the common (flat) case allocation-free
    // and, more importantly, byte-identical to the pre-feature output.
    var seen_nested: boolean = false;
    var s: i32 = 0;
    while (s < arms.len()) {
        if (arm_is_nested(arms[s])) { seen_nested = true; }
        s = s + 1;
    }
    if (!seen_nested) { return arms; }
    // An unguarded trailing `_` is the outer fallthrough: copied into each
    // merged inner match so a payload matching no inner pattern runs it.
    var fall: Stmt[] = [];
    var has_fall: boolean = false;
    if (arms.len() > 0) {
        var last: MatchArm = arms[arms.len() - 1];
        if (pv_name(last.pattern) == "" && !last.has_guard) {
            fall = last.body;
            has_fall = true;
        }
    }
    var out: MatchArm[] = [];
    var i: i32 = 0;
    while (i < arms.len()) {
        var vn: string = pv_name(arms[i].pattern);
        if (vn == "") {
            out = out.append(arms[i]);
            i = i + 1;
        } else {
            var j: i32 = i;
            while (j < arms.len() && pv_name(arms[j].pattern) == vn) { j = j + 1; }
            var any_nested: boolean = false;
            var k: i32 = i;
            while (k < j) { if (arm_is_nested(arms[k])) { any_nested = true; } k = k + 1; }
            if (!any_nested) {
                var c: i32 = i;
                while (c < j) { out = out.append(arms[c]); c = c + 1; }
            } else {
                out = out.append(build_merged_arm(vn, arms, i, j, fall, has_fall, depth));
            }
            i = j;
        }
    }
    return out;
}

// build_merged_arm collapses one contiguous run of same-variant arms
// (arms[lo..hi], at least one nested) into a single flat arm
// `V(__nest) => match __nest { <inner arms> }`. A flat sibling arm rebinds
// the whole payload to its binder; a trailing outer `_` becomes the inner
// wildcard so unmatched payloads fall through.
function build_merged_arm(vn: string, arms: MatchArm[], lo: i32, hi: i32, fall: Stmt[], has_fall: boolean, depth: i32): MatchArm {
    var gp_line: i32 = arms[lo].line;
    var gp_col: i32 = arms[lo].col;
    var tmp: string = "__nest_" + util.i32_to_string(gp_line) + "_" + util.i32_to_string(gp_col) + "_" + util.i32_to_string(depth);
    var inner: MatchArm[] = [];
    var has_inner_wild: boolean = false;
    var k: i32 = lo;
    while (k < hi) {
        var g: MatchArm = arms[k];
        var inner_pat: Pattern = p_wildcard();
        var inner_body: Stmt[] = g.body;
        match (g.pattern) {
            PatVariant(gv) => {
                if (gv.nested.len() > 0) {
                    inner_pat = gv.nested[0];
                } else if (gv.binding.len() > 0 && gv.binding != "_") {
                    // A flat sibling (`Some(x)`): rebind the whole payload.
                    inner_body = prepend_stmt(s_var(gv.binding, "", e_ident(tmp)), g.body);
                }
            },
            PatWildcard(w) => {}
        }
        if (pv_name(inner_pat) == "" && !g.has_guard) { has_inner_wild = true; }
        inner = inner.append(MatchArm { pattern: inner_pat, body: inner_body, line: g.line, col: g.col, guard: g.guard, has_guard: g.has_guard });
        k = k + 1;
    }
    if (!has_inner_wild && has_fall) {
        inner = inner.append(MatchArm { pattern: p_wildcard(), body: fall, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false });
    }
    var inner_desugared: MatchArm[] = desugar_nested_arms(inner, depth + 1);
    var inner_match: Stmt = s_match_at(e_ident(tmp), inner_desugared, gp_line, gp_col);
    var no_extra: string[] = [];
    var no_nested: Pattern[] = [];
    var merged_pat: Pattern = PatVariant { type_name: vn, binding: tmp, extra_bindings: no_extra, nested: no_nested };
    var body: Stmt[] = [inner_match];
    return MatchArm { pattern: merged_pat, body: body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false };
}

// parse_match_stmt consumes `match (scrutinee) { arm, arm, … }`
// starting from the `match` keyword. Arms separate with `,`
// (trailing comma optional). Each arm is `Pat => { stmts… }`.
// Malformed input recovers by yielding an empty-arm StmtMatch
// — the surrounding parse_module loop continues at the next
// token.

function parse_match_stmt(p: Par): (Stmt, Par) {
    // E030 (non-exhaustive match) is reported at the `match` keyword.
    var mkline: i32 = p.peek_line();
    var mkcol: i32 = p.peek_col();
    p = p.advance();  // consume `match`
    var empty_arms: MatchArm[] = [];
    if (p.peek_punct() != "(") {
        return (s_match(e_unknown("match: missing ("), empty_arms), p);
    }
    p = p.advance();
    var (sr_expr, sr_p) = parse_expr(p);
    p = sr_p;
    if (p.peek_punct() == ")") { p = p.advance(); }
    if (p.peek_punct() != "{") {
        return (s_match_at(sr_expr, empty_arms, mkline, mkcol), p);
    }
    p = p.advance();
    // A `(` at the FIRST arm's pattern position marks a match on a
    // TUPLE scrutinee: parse every arm as a tuple pattern / `_` and
    // desugar to the flag-chain build_tuple_match emits.
    if (p.peek_punct() == "(") {
        var tarms: TupArm[] = [];
        while (p.peek_punct() != "}" && !p.at_end()) {
            var taline: i32 = p.peek_line();
            var tacol: i32 = p.peek_col();
            var t_wild: boolean = false;
            var t_kinds: i32[] = [];
            var t_binds: string[] = [];
            var t_lits: Expr[] = [];
            if (p.peek_punct() == "(") {
                var (tpr_elem_kinds, tpr_binds, tpr_lits, tpr_p) = parse_tuple_arm_pattern(p);
                p = tpr_p;
                if (tpr_elem_kinds.len() == 0) {
                    return (s_unknown("bad tuple pattern"), p);
                }
                t_kinds = tpr_elem_kinds;
                t_binds = tpr_binds;
                t_lits = tpr_lits;
            } else {
                var (twp_pattern, twp_p) = parse_pattern(p);
                p = twp_p;
                t_wild = true;
            }
            var t_guard: Expr = e_bool(true);
            var t_has_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (tgr_expr, tgr_p) = parse_expr(p);
                p = tgr_p;
                t_guard = tgr_expr;
                t_has_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            var (tbb_body, tbb_p) = parse_block(p);
            p = tbb_p;
            tarms = tarms.append(TupArm { is_wild: t_wild, elem_kinds: t_kinds, binds: t_binds, lits: t_lits, guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol });
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return (build_tuple_match(sr_expr, tarms, mkline, mkcol), p);
    }
    // A literal at the FIRST arm's pattern position marks a match on a
    // non-enum (i32 / string) scrutinee: parse every arm as a literal /
    // `_` and desugar to an if/else-if chain (build_literal_match). The
    // decision is made once, up front, so the common enum/variant match
    // takes the normal StmtMatch path below with no extra allocation.
    if (p.peek_is_literal()) {
        var lit_arms: LitArm[] = [];
        while (p.peek_punct() != "}" && !p.at_end()) {
            var laline: i32 = p.peek_line();
            var lacol: i32 = p.peek_col();
            var lwild: boolean = false;
            var lalt_lits: Expr[] = [];
            var lalt_his: Expr[] = [];
            var lalt_hrs: boolean[] = [];
            var lalt_incs: boolean[] = [];
            if (p.peek_is_literal()) {
                var (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
                p = la_p;
                lalt_lits = la_lits;
                lalt_his = la_his;
                lalt_hrs = la_hrs;
                lalt_incs = la_incs;
            } else {
                var (lpr_pattern, lpr_p) = parse_pattern(p);
                p = lpr_p;
                lwild = true;
            }
            var lguard: Expr = e_bool(true);
            var lhas_guard: boolean = false;
            if (p.peek_keyword() == "when") {
                p = p.advance();
                var (lgr_expr, lgr_p) = parse_expr(p);
                p = lgr_p;
                lguard = lgr_expr;
                lhas_guard = true;
            }
            if (p.peek_punct() == "=>") { p = p.advance(); }
            var (lbb_body, lbb_p) = parse_block(p);
            p = lbb_p;
            if (lwild) {
                lit_arms = lit_arms.append(LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false });
            } else {
                // One LitArm per `|` alternative, sharing the guard + body.
                var lai: i32 = 0;
                while (lai < lalt_lits.len()) {
                    lit_arms = lit_arms.append(LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai] });
                    lai = lai + 1;
                }
            }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
        return (build_literal_match(sr_expr, lit_arms, mkline, mkcol), p);
    }
    var arms: MatchArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
        // E026 / E028 are reported at the arm (Go's `arm.P`), which is the
        // pattern's first token.
        var aline: i32 = p.peek_line();
        var acol: i32 = p.peek_col();
        var (pr_pattern, pr_p) = parse_pattern(p);
        p = pr_p;
        // Or-patterns: `A | B | … => body`. Each `|`-separated variant
        // pattern becomes its own MatchArm sharing the guard + body, so the
        // checker (exhaustiveness) and lowering see a flat arm list. Bindings
        // are per-alternative; the body only sees those the alternative
        // introduces. (Variant patterns only — a literal arm takes the
        // build_literal_match path above, and bare `|` is bitwise-or there.)
        var pats: Pattern[] = [pr_pattern];
        while (p.peek_punct() == "|") {
            p = p.advance();
            var (pr2_pattern, pr2_p) = parse_pattern(p);
            p = pr2_p;
            pats = pats.append(pr2_pattern);
        }
        // Optional guard: `Pattern when <expr> => …`. The arm matches only
        // when the guard is true (E027 checks it is boolean). Applies to
        // every alternative of an or-pattern.
        var arm_guard: Expr = e_bool(true);
        var arm_has_guard: boolean = false;
        if (p.peek_keyword() == "when") {
            p = p.advance();
            var (gr_expr, gr_p) = parse_expr(p);
            p = gr_p;
            arm_guard = gr_expr;
            arm_has_guard = true;
        }
        // `=>` arrives as a single punct token from the lexer.
        if (p.peek_punct() == "=>") {
            p = p.advance();
        }
        var (bb_body, bb_p) = parse_block(p);
        p = bb_p;
        var pi: i32 = 0;
        while (pi < pats.len()) {
            arms = arms.append(MatchArm { pattern: pats[pi], body: bb_body, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard });
            pi = pi + 1;
        }
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    arms = desugar_nested_arms(arms, 0);
    return (s_match_at(sr_expr, arms, mkline, mkcol), p);
}

// expr_mentions / stmts_mention report whether `name` appears as an
// identifier anywhere in an expression / statement list. Used to detect a
// self-recursive local function (whose body references its own name) —
// the closure-valued-local desugar below can't bind the name before the
// lambda captures it, so recursion needs top-level hoisting (closureconv),
// which isn't ported yet. Conservative: any mention counts.
pub function expr_mentions(e: Expr, name: string): boolean {
    match (e) {
        ExprIdent(id) => { return id.name == name; },
        ExprBinary(b) => { return expr_mentions(b.left, name) || expr_mentions(b.right, name); },
        ExprUnary(u) => { return expr_mentions(u.operand, name); },
        ExprCall(c) => {
            if (expr_mentions(c.callee, name)) { return true; }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (expr_mentions(c.args[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (expr_mentions(a.elements[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                if (expr_mentions(t.elements[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprIndex(ix) => { return expr_mentions(ix.array, name) || expr_mentions(ix.index, name); },
        ExprSlice(sl) => { return expr_mentions(sl.array, name) || expr_mentions(sl.start, name) || expr_mentions(sl.end, name); },
        ExprFieldAccess(fa) => { return expr_mentions(fa.obj, name); },
        ExprStructLit(s) => {
            if (s.has_base && expr_mentions(s.base, name)) { return true; }
            var i: i32 = 0;
            while (i < s.field_values.len()) {
                if (expr_mentions(s.field_values[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprLambda(lm) => { return stmts_mention(lm.body, name); },
        _ => { return false; }
    }
}

pub function stmt_mentions(st: Stmt, name: string): boolean {
    match (st) {
        StmtVar(v) => { return expr_mentions(v.init, name); },
        StmtReturn(r) => { return expr_mentions(r.value, name); },
        StmtExpr(e) => { return expr_mentions(e.value, name); },
        StmtAssign(a) => { return expr_mentions(a.value, name); },
        StmtIf(f) => { return expr_mentions(f.cond, name) || stmts_mention(f.then_body, name) || stmts_mention(f.else_body, name); },
        StmtWhile(w) => { return expr_mentions(w.cond, name) || stmts_mention(w.body, name); },
        StmtFor(fr) => { return expr_mentions(fr.iter, name) || stmts_mention(fr.body, name); },
        StmtMatch(m) => {
            if (expr_mentions(m.scrutinee, name)) { return true; }
            var i: i32 = 0;
            while (i < m.arms.len()) {
                if (stmts_mention(m.arms[i].body, name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        _ => { return false; }
    }
}

pub function stmts_mention(stmts: Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        if (stmt_mentions(stmts[i], name)) { return true; }
        i = i + 1;
    }
    return false;
}

// parse_loop_stmt parses `loop { body }` — the canonical infinite loop —
// and desugars it to `while (true) { body }` so it rides the existing
// StmtWhile IR lowering (block/loop/br_if) with no new node or emitter
// arm. Kept in its own function so parse_stmt (already very large) doesn't
// grow — an oversized function miscompiles on the native backend (#2720).
function parse_loop_stmt(p: Par): (Stmt, Par) {
    var p2: Par = p.advance();
    var (lb_body, lb_p) = parse_block_or_stmt(p2);
    return (s_while(e_bool(true), lb_body), lb_p);
}

// parse_for_stmt parses a `for` statement (`p` is positioned at the
// `for` keyword). Split out of parse_stmt's keyword dispatch so that
// already-large function stays under the native backend's per-function
// size limit (oversized functions miscompile — cf. #2720). Three forms:
// `for (k, v) in m { body }` (map destructuring), `for x in EXPR { body }`
// (array / range foreach), and the range form `for i in LOW..HIGH` /
// `for i in LOW..=HIGH` — the latter two encode the interval as a
// synthetic `__range` / `__range_incl` call (see below).
function parse_for_stmt(p: Par): (Stmt, Par) {
    // `for VAR in EXPR { body }`. `in` arrives as a plain
    // TokIdent (not in the lexer's keyword set), so peek
    // it through peek_ident rather than peek_keyword.
    p = p.advance();  // consume `for`
    // `for (k, v) in m { body }` — map destructuring iteration. The
    // two names are encoded as "k,v" in the for-var; the emitter
    // detects the comma + a map iter and emits an iterator loop.
    if (p.peek_punct() == "(") {
        var cfl: i32 = p.peek_line();
        var cfc: i32 = p.peek_col();
        p = p.advance();
        // C-style `for (INIT; COND; STEP) { BODY }` — distinguished from the
        // `for (k, v) in m` map form by a top-level `;` in the header (the map
        // form has none). Native accepts a `var` init, an expression init, or
        // an empty init/cond (`parser.go` parseFor); the self-host previously
        // gated only on a `var` init (#2820), so `for (i = 0; …)` / `for (;
        // …)` fell into the map arm and shredded (#4339). The Stmt union has
        // no C-style-for node, so desugar to a scoped while loop with a
        // first-iteration flag, so a `continue` re-runs STEP (matching C
        // semantics) instead of skipping it. Reuses if / while / break.
        //
        // Detect via a lookahead: scan a copy of the cursor for a top-level
        // `;` before the matching `)`, tracking ()[]{} nesting depth.
        var scan: Par = p;
        var sc_depth: i32 = 0;
        var is_cfor: boolean = false;
        while (!scan.at_end()) {
            var sp: string = scan.peek_punct();
            if (sp == "(" || sp == "[" || sp == "{") { sc_depth = sc_depth + 1; }
            else if (sp == ")" || sp == "]" || sp == "}") {
                if (sc_depth == 0) { break; }
                sc_depth = sc_depth - 1;
            }
            else if (sp == ";" && sc_depth == 0) { is_cfor = true; break; }
            scan = scan.advance();
        }
        if (is_cfor) {
            // INIT: empty (`;`), `var …`, or an expression statement — each
            // terminated by `;` (parse_stmt eats it for the var/expr forms).
            var initstmts: Stmt[] = [];
            if (p.peek_punct() == ";") {
                p = p.advance();
            } else {
                var (fcinit_stmt, fcinit_p) = parse_stmt(p);
                p = fcinit_p;
                initstmts = [fcinit_stmt];
            }
            // COND: empty means "always true" (`for (…; ; …)` loops forever).
            var condexpr: Expr = e_bool(true);
            if (p.peek_punct() != ";") {
                var (fccond_expr, fccond_p) = parse_expr(p);
                p = fccond_p;
                condexpr = fccond_expr;
            }
            if (p.peek_punct() == ";") { p = p.advance(); }
            var stepone: Stmt[] = [];                 // STEP (no `;`, stops at `)`)
            if (p.peek_punct() != ")") {
                var (fcstep_stmt, fcstep_p) = parse_stmt(p);
                p = fcstep_p;
                stepone = [fcstep_stmt];
            }
            if (p.peek_punct() == ")") { p = p.advance(); }
            var (fcbody_body, fcbody_p) = parse_block(p);
            p = fcbody_p;
            var flag: string = "__forc_" + util.i32_to_string(cfl) + "_" + util.i32_to_string(cfc);
            var noelse: Stmt[] = [];
            var wbody: Stmt[] = [];
            // if (!first) { STEP }   -- runs STEP before every iteration but
            //                           the first, so a `continue` runs it too.
            wbody = wbody.append(s_if(e_unary("!", e_ident(flag)), stepone, noelse));
            // first = false
            wbody = wbody.append(s_assign(flag, e_bool(false)));
            // if (!(COND)) { break }  — with an empty cond, COND is `true`, so
            // this is `if (!true) break`, i.e. never breaks (infinite loop).
            var breakone: Stmt[] = [s_break()];
            wbody = wbody.append(s_if(e_unary("!", condexpr), breakone, noelse));
            var fbi: i32 = 0;
            while (fbi < fcbody_body.len()) { wbody = wbody.append(fcbody_body[fbi]); fbi = fbi + 1; }
            // { INIT; var first = true; while (true) { <wbody> } }  (scoped via if-true)
            var outer: Stmt[] = [];
            var ini: i32 = 0;
            while (ini < initstmts.len()) { outer = outer.append(initstmts[ini]); ini = ini + 1; }
            outer = outer.append(s_var(flag, "", e_bool(true)));
            outer = outer.append(s_while(e_bool(true), wbody));
            return (s_if(e_bool(true), outer, noelse), p);
        }
        var kvk: string = p.peek_ident();
        if (kvk.len() > 0) { p = p.advance(); }
        if (p.peek_punct() == ",") { p = p.advance(); }
        var kvv: string = p.peek_ident();
        if (kvv.len() > 0) { p = p.advance(); }
        if (p.peek_punct() == ")") { p = p.advance(); }
        if (p.peek_ident() == "in") { p = p.advance(); }
        // Suppress trailing struct-literal parsing — the `{` that
        // follows the iter opens the loop body, not a struct lit.
        var kv_saved: boolean = p.no_struct;
        var (kvi_expr, kvi_p) = parse_expr(p.with_no_struct(true));
        p = (kvi_p).with_no_struct(kv_saved);
        var (kvb_body, kvb_p) = parse_block(p);
        p = kvb_p;
        return (s_for(kvk + "," + kvv, kvi_expr, kvb_body), p);
    }
    var fvar: string = p.peek_ident();
    if (fvar.len() == 0) {
        return (s_unknown("missing for-var name"), p);
    }
    p = p.advance();
    if (p.peek_ident() != "in") {
        return (s_unknown("missing `in` in for"), p);
    }
    p = p.advance();  // consume `in`
    // Suppress trailing struct-literal parsing on the iter so that
    // `for x in a {}` reads `a` + an empty block, not `a {}`.
    var f_saved: boolean = p.no_struct;
    // Read the iterable / LOW bound BELOW the range-expression level
    // (parse_binary, not parse_expr) so `for i in 0..n` stops at `..` and keeps
    // the counted-loop desugar below, instead of collapsing `0..n` into an
    // `iter.range(0, n)` iterator value.
    var (fiter_expr, fiter_p) = parse_binary(p.with_no_struct(true), 1);
    p = (fiter_p).with_no_struct(f_saved);
    var iter_expr: Expr = fiter_expr;
    // Range form `for IDENT in LOW..HIGH { body }`. parse_expr stops
    // at `..` (not a binary operator), so `fiter_expr` is LOW; read
    // `..` + HIGH and encode the half-open interval as a synthetic
    // `__range(LOW, HIGH)` call — the same parser-internal-builtin
    // idiom as `__set_index` / `__set_field`. The checker binds the
    // loop var to i32 and irlower lowers it to a counted loop; the
    // call shape rides through constfold / substitution / printing
    // for free (LOW, HIGH are ordinary i32 sub-expressions). The
    // inclusive form `LOW..=HIGH` emits `__range_incl(LOW, HIGH)`
    // instead, which irlower lowers with a `<=` (closed-interval)
    // condition.
    var range_punct: string = p.peek_punct();
    if (range_punct == ".." || range_punct == "..=") {
        p = p.advance();   // consume `..` or `..=`
        var hi_saved: boolean = p.no_struct;
        var (fhi_expr, fhi_p) = parse_binary(p.with_no_struct(true), 1);
        p = (fhi_p).with_no_struct(hi_saved);
        var rargs: Expr[] = [fiter_expr, fhi_expr];
        var range_fn: string = "__range";
        if (range_punct == "..=") { range_fn = "__range_incl"; }
        iter_expr = e_call(e_ident(range_fn), rargs);
    }
    var (fb_body, fb_p) = parse_block_or_stmt(p);
    p = fb_p;
    return (s_for(fvar, iter_expr, fb_body), p);
}

function parse_stmt(p: Par): (Stmt, Par) {
    // A bare block `{ ... }` in statement position is its own scope. The
    // self-host Stmt union has no StmtBlock node, so desugar it to
    // `if (true) { ... }` — reusing the scoped if-body (the same trick
    // `loop` uses for `while (true)`). Map / struct literals only appear in
    // expression position, so a leading `{` here is unambiguously a block.
    if (p.peek_punct() == "{") {
        var (bb_body, bb_p) = parse_block(p);
        var noelse: Stmt[] = [];
        return (s_if(e_bool(true), bb_body, noelse), bb_p);
    }
    // Loop label `outer: while (…) { … }` / `outer: for … ` / `outer: loop { … }`.
    // A leading `IDENT :` immediately before a loop keyword is a label (a bare
    // `IDENT :` at statement start has no other meaning). Capture it, consume the
    // `IDENT :`, and attach it to the loop below via with_loop_label; a labeled
    // `break outer` / `continue outer` targets it (resolve_labels bakes the
    // relative depth into the break/continue tag).
    var loop_label: string = "";
    var llid: string = p.peek_ident();
    if (llid.len() > 0) {
        var lp1: Par = p.advance();
        if (lp1.peek_punct() == ":") {
            var lp2: Par = lp1.advance();
            var lkw: string = lp2.peek_keyword();
            if (lkw == "while" || lkw == "for" || lkw == "loop") {
                loop_label = llid;
                p = lp2;
            }
        }
    }
    // `assert(cond)` / `assert(cond, msg)` builtin — desugar to
    // `if (!cond) { eprint("assertion failed[: msg]"); exit(1); }`. A
    // parser-level rewrite over the existing `!` / string-`+` / eprint /
    // exit primitives, so it lowers with no dedicated codegen on every
    // backend and both IR paths — mirroring the native parser's
    // parseAssert. `assert` is an identifier (not a keyword), so we only
    // intercept the statement-position `assert (` shape and leave the
    // name free for ordinary use elsewhere. #4416.
    if (p.peek_ident() == "assert") {
        var as0: Par = p.advance();  // consume `assert`
        if (as0.peek_punct() == "(") {
            var asp: Par = as0.advance();  // consume `(`
            var (as_cond, ascp) = parse_expr(asp);
            asp = ascp;
            var as_has_msg: boolean = false;
            var as_msg: Expr = e_string("");
            if (asp.peek_punct() == ",") {
                asp = asp.advance();
                var (asm_e, asmp) = parse_expr(asp);
                as_msg = asm_e;
                asp = asmp;
                as_has_msg = true;
            }
            if (asp.peek_punct() == ")") { asp = asp.advance(); }
            if (asp.peek_punct() == ";") { asp = asp.advance(); }
            var as_text: Expr = e_string("assertion failed");
            if (as_has_msg) {
                as_text = e_binary("+", e_string("assertion failed: "), as_msg);
            }
            var as_body: Stmt[] = [];
            var as_eargs: Expr[] = [];
            as_eargs = as_eargs.append(as_text);
            as_body = as_body.append(s_expr(e_call(e_ident("eprint"), as_eargs)));
            var as_xargs: Expr[] = [];
            as_xargs = as_xargs.append(e_number("1", "", false));
            as_body = as_body.append(s_expr(e_call(e_ident("exit"), as_xargs)));
            var as_noelse: Stmt[] = [];
            return (s_if(e_unary("!", as_cond), as_body, as_noelse), asp);
        }
    }
    // `todo;` / `todo("msg");` builtin — desugar to
    // `while (true) { eprint("todo[: msg]"); exit(101); }`, mirroring
    // the native parser's parseTodo (whose `loop { ... }` desugar this
    // parser lowers to the same while-true shape — see parse_loop_stmt).
    // The always-true loop makes the stub DIVERGE for the checker's
    // missing-return / let-else analyses, so `todo;` can stand in for a
    // whole non-void function body; exit(101) fires on the first
    // iteration. Only the statement-position `todo ;` / `todo (` shapes
    // are intercepted, so `todo` stays usable as an ordinary identifier
    // elsewhere. The runtime message must stay byte-identical to the
    // native parser's.
    if (p.peek_ident() == "todo") {
        var td0: Par = p.advance();  // consume `todo`
        var td0p: string = td0.peek_punct();
        if (td0p == "(" || td0p == ";") {
            var tdp: Par = td0;
            var td_has_msg: boolean = false;
            var td_msg: Expr = e_string("");
            if (td0p == "(") {
                tdp = tdp.advance();  // consume `(`
                if (tdp.peek_punct() != ")") {
                    var (tdm_e, tdmp) = parse_expr(tdp);
                    td_msg = tdm_e;
                    tdp = tdmp;
                    td_has_msg = true;
                }
                if (tdp.peek_punct() == ")") { tdp = tdp.advance(); }
            }
            if (tdp.peek_punct() == ";") { tdp = tdp.advance(); }
            var td_text: Expr = e_string("todo: not implemented");
            if (td_has_msg) {
                td_text = e_binary("+", e_string("todo: "), td_msg);
            }
            var td_body: Stmt[] = [];
            var td_eargs: Expr[] = [];
            td_eargs = td_eargs.append(td_text);
            td_body = td_body.append(s_expr(e_call(e_ident("eprint"), td_eargs)));
            var td_xargs: Expr[] = [];
            td_xargs = td_xargs.append(e_number("101", "", false));
            td_body = td_body.append(s_expr(e_call(e_ident("exit"), td_xargs)));
            return (s_while(e_bool(true), td_body), tdp);
        }
    }
    var kw: string = p.peek_keyword();
    if (kw == "defer") {
        // `defer ACTION;` — the deferred action is an ordinary statement
        // (assignment, call, …). Parse it (which consumes the trailing
        // `;`) and wrap it; lower_defers schedules it at function exit.
        p = p.advance();  // consume `defer`
        var (da_stmt, da_p) = parse_stmt(p);
        return (s_defer(da_stmt), da_p);
    }
    if (kw == "errdefer") {
        // `errdefer ACTION;` — like `defer`, but lower_defers schedules it
        // only on an error exit (a `return` of a None/Err value).
        p = p.advance();  // consume `errdefer`
        var (ea_stmt, ea_p) = parse_stmt(p);
        return (s_errdefer(ea_stmt), ea_p);
    }
    if (kw == "function") {
        // Local (nested) function declaration: desugar to a closure-valued
        // local `var name = function(params): ret { body };`. Calls resolve
        // through the closure-call path, and references to enclosing locals
        // are captured by the lambda machinery. Mirrors the Go parser
        // marking it IsLocal + the closureconv hoist. (Self-reference /
        // recursion isn't captured — the name is bound after the lambda is
        // built — matching a plain closure-valued local.)
        var (fr_func, fr_p) = parse_func_decl(p);
        p = fr_p;
        if (stmts_mention(fr_func.body, fr_func.name)) {
            // Self-recursive local function: the closure can't reference
            // itself (the name binds after the lambda captures), so this
            // needs top-level hoisting (closureconv), not yet ported.
            // Surface it rather than miscompile silently.
            return (s_var(fr_func.name, "", e_lambda(fr_func.params, fr_func.ret_type, fr_func.body)), p);
        }
        var lam: Expr = e_lambda(fr_func.params, fr_func.ret_type, fr_func.body);
        return (s_var(fr_func.name, "", lam), p);
    }
    if (kw == "match") {
        var (mr_stmt, mr_p) = parse_match_stmt(p);
        return (mr_stmt, mr_p);
    }
    if (kw == "if") {
        p = p.advance();
        // `if let PAT = EXPR { then } else { else }` desugars to a
        // `match (EXPR) { PAT => { then }, _ => { else } }` — the
        // pattern arm plus a wildcard arm for the else (empty when
        // there's no else). Parsed before the `(` check since if-let
        // has no parenthesised condition.
        if (p.peek_keyword() == "let") {
            p = p.advance();  // consume `let`
            var (ilpat_pattern, ilpat_p) = parse_pattern(p);
            p = ilpat_p;
            if (p.peek_punct() == "=") { p = p.advance(); }
            // The source expression is followed directly by the then-block's
            // `{`, so struct-literal parsing must be suppressed while reading
            // it (native sets p.noStructLit here) — otherwise a bare-ident
            // source whose then-block starts with `}`, `...`, or `IDENT :`
            // (e.g. a labeled loop) is swallowed as `ident { … }` (#4339
            // item 4). Same save/restore shape as the for-in iterable.
            var il_saved: boolean = p.no_struct;
            var (ilscrut_expr, ilscrut_p) = parse_expr(p.with_no_struct(true));
            p = (ilscrut_p).with_no_struct(il_saved);
            var (ilthen_body, ilthen_p) = parse_block(p);
            p = ilthen_p;
            var ilelse: Stmt[] = [];
            if (p.peek_keyword() == "else") {
                p = p.advance();
                var (ileb_body, ileb_p) = parse_block(p);
                p = ileb_p;
                ilelse = ileb_body;
            }
            var ilarms: MatchArm[] = [];
            ilarms = ilarms.append(MatchArm { pattern: ilpat_pattern, body: ilthen_body, line: 0, col: 0, guard: e_bool(true), has_guard: false });
            ilarms = ilarms.append(MatchArm { pattern: p_wildcard(), body: ilelse, line: 0, col: 0, guard: e_bool(true), has_guard: false });
            return (s_match_origin(ilscrut_expr, ilarms, 0, 0, "if_let"), p);
        }
        if (p.peek_punct() != "(") {
            return (s_unknown("missing ( in if"), p);
        }
        p = p.advance();
        var (c_expr, c_p) = parse_expr(p);
        p = c_p;
        if (p.peek_punct() == ")") { p = p.advance(); }
        var (then_blk_body, then_blk_p) = parse_block_or_stmt(p);
        p = then_blk_p;
        var else_body: Stmt[] = [];
        if (p.peek_keyword() == "else") {
            p = p.advance();
            // `else if` — wrap as a nested StmtIf in the else
            // branch so an else-chain reads as one shape.
            if (p.peek_keyword() == "if") {
                var (nested_stmt, nested_p) = parse_stmt(p);
                p = nested_p;
                else_body = else_body.append(nested_stmt);
            } else {
                var (else_blk_body, else_blk_p) = parse_block_or_stmt(p);
                p = else_blk_p;
                else_body = else_blk_body;
            }
        }
        return (s_if(c_expr, then_blk_body, else_body), p);
    }
    if (kw == "while") {
        p = p.advance();
        if (p.peek_punct() != "(") {
            return (s_unknown("missing ( in while"), p);
        }
        p = p.advance();
        var (wc_expr, wc_p) = parse_expr(p);
        p = wc_p;
        if (p.peek_punct() == ")") { p = p.advance(); }
        var (wb_body, wb_p) = parse_block_or_stmt(p);
        p = wb_p;
        return (with_loop_label(s_while(wc_expr, wb_body), loop_label), p);
    }
    if (kw == "loop") { var (lr_stmt, lr_p) = parse_loop_stmt(p); return (with_loop_label(lr_stmt, loop_label), lr_p); }
    if (kw == "for") { var (fr0_stmt, fr0_p) = parse_for_stmt(p); return (with_loop_label(fr0_stmt, loop_label), fr0_p); }
    // `let` and `var` introduce a binding the same way here — the
    // self-host compiler doesn't track the immutability distinction
    // (the Go checker enforces it), so both parse to the same StmtVar.
    // Without the `let` arm, a statement-level `let (a, b) = E;` /
    // `let x = E;` fell through to the expression-statement path, which
    // can't consume the `let` keyword and so never advanced the cursor
    // — an infinite loop (observed as an OOM/SIGKILL when the self-host
    // compiler hit `let`). The variant `let Pat(..) = E else { .. }`
    // (let-else) is handled below: it desugars the rest of the
    // enclosing block into the success arm of a statement-match.
    if (kw == "var" || kw == "let") {
        var vline: i32 = p.peek_line();
        var vcol: i32 = p.peek_col();
        p = p.advance();
        // `var (x, y, …) = E` / `let (x, y, …) = E` — tuple destructuring of
        // ANY arity. The names are encoded comma-joined ("x,y,z"); the emitter
        // splits them and binds from the tuple's element slots.
        if (p.peek_punct() == "(") {
            p = p.advance();
            var tdnames: string = "";
            var tdfirst: boolean = true;
            while (p.peek_punct() != ")" && !p.at_end()) {
                var tdn: string = p.peek_ident();
                if (tdn.len() > 0) { p = p.advance(); }
                if (!tdfirst) { tdnames = tdnames + ","; }
                tdnames = tdnames + tdn;
                tdfirst = false;
                if (p.peek_punct() == ",") { p = p.advance(); }
            }
            if (p.peek_punct() == ")") { p = p.advance(); }
            if (p.peek_punct() == "=") { p = p.advance(); }
            var (tdinit_expr, tdinit_p) = parse_expr(p);
            p = tdinit_p;
            if (p.peek_punct() == ";") { p = p.advance(); }
            return (s_var_at(tdnames, "", tdinit_expr, vline, vcol), p);
        }
        var name: string = p.peek_ident();
        if (name.len() == 0) {
            return (s_unknown("missing var name"), p);
        }
        p = p.advance();
        // Struct destructure `var Point { x, y } = E;` / `let Point { … } = E;`
        // — `name` is the struct type, the `{` opens the field pattern.
        if (p.peek_punct() == "{") {
            return parse_struct_destructure(p, name, vline, vcol);
        }
        // let-else payload bindings: `let Variant(b1, b2, …) = E else { … }`.
        // The first binding is `le_binding`; any further ones go to
        // `le_extra` (matching parse_pattern's PatVariant shape, so the
        // checker can flag a payload-arity mismatch via E015).
        var le_binding: string = "";
        var le_extra: string[] = [];
        if (p.peek_punct() == "(") {
            p = p.advance();
            var ben: i32 = 0;
            while (p.peek_punct() != ")" && !p.at_end()) {
                var bind_inner: string = p.peek_ident();
                if (bind_inner.len() > 0) {
                    if (ben == 0) { le_binding = bind_inner; } else { le_extra = le_extra.append(bind_inner); }
                    ben = ben + 1;
                    p = p.advance();
                } else {
                    p = p.advance();
                }
                if (p.peek_punct() == ",") { p = p.advance(); }
            }
            if (p.peek_punct() == ")") { p = p.advance(); }
        }
        // Optional `: Type` — capture the type name string so
        // the checker can resolve it. Full type syntax (arrays
        // / generics) is still a later milestone; for now just
        // the bare leading token.
        var type_name: string = "";
        // A bare `var x: str = …` annotation is recorded on StmtVar.is_str
        // BEFORE parse_type_name erases the spelling to "string" — the E065
        // view-escape chase treats a `str` binding as a view of its
        // initializer, but a `string` binding as owned backing storage.
        var v_is_str: boolean = false;
        if (p.peek_punct() == ":") {
            p = p.advance();
            if (p.peek_ident() == "str") {
                var vstr_probe: Par = p.advance();
                if (vstr_probe.peek_punct() == "=") { v_is_str = true; }
            }
            var (vtr_name, vtr_ret_arr, vtr_fn_ret, vtr_p) = parse_type_name(p);
            p = vtr_p;
            type_name = vtr_name;
        }
        if (p.peek_punct() != "=") {
            return (s_unknown("missing = in var"), p);
        }
        p = p.advance();
        // The source expr is followed by either `;` (plain binding) or
        // the `else` keyword (let-else) — never directly by `{`, so no
        // struct-literal suppression is needed here.
        var (init_expr, init_p) = parse_expr(p);
        p = init_p;
        // let-else: `let Variant(b..) = E else { divergent };`. The
        // rest of the enclosing block becomes the success arm body;
        // the else block becomes the wildcard arm. Reuses the
        // statement-match machinery — no new AST node:
        //   match (E) { Variant(b..) => { <rest of block> },
        //               _ => { divergent } }
        // The success bindings are live for the rest of the block
        // (they live inside the arm), and the else branch is expected
        // to diverge (return / break / continue) — the Go checker
        // enforces that (E022); via the desugar a non-diverging else
        // simply falls through to the end of the block.
        if (p.peek_keyword() == "else") {
            p = p.advance();  // consume `else`
            var (le_else_body, le_else_p) = parse_block(p);
            p = le_else_p;
            if (p.peek_punct() == ";") { p = p.advance(); }
            // Consume the rest of the enclosing block as the success
            // body, mirroring parse_block's loop (incl. its
            // progress guard so a malformed statement can't spin).
            var rest: Stmt[] = [];
            while (p.peek_punct() != "}" && !p.at_end()) {
                var (rr_stmt, rr_p) = parse_stmt(p);
                if (rr_p.pos == p.pos) { p = p.advance(); continue; }
                p = rr_p;
                rest = rest.append(rr_stmt);
            }
            var le_no_nested: Pattern[] = [];
            var le_pat: Pattern = PatVariant { type_name: name, binding: le_binding, extra_bindings: le_extra, nested: le_no_nested };
            var le_arms: MatchArm[] = [];
            le_arms = le_arms.append(MatchArm { pattern: le_pat, body: rest, line: vline, col: vcol, guard: e_bool(true), has_guard: false });
            le_arms = le_arms.append(MatchArm { pattern: p_wildcard(), body: le_else_body, line: vline, col: vcol, guard: e_bool(true), has_guard: false });
            return (s_match_origin(init_expr, le_arms, vline, vcol, "let_else"), p);
        }
        if (p.peek_punct() == ";") { p = p.advance(); }
        return (StmtVar { name: name, type_name: type_name, init: init_expr, line: vline, col: vcol, is_str: v_is_str }, p);
    }
    if (kw == "return") {
        var rline: i32 = p.peek_line();
        var rcol: i32 = p.peek_col();
        p = p.advance();
        var (val_expr, val_p) = parse_expr(p);
        p = val_p;
        if (p.peek_punct() == ";") { p = p.advance(); }
        return (s_return_at(val_expr, rline, rcol), p);
    }
    if (kw == "break") {
        // E011 is reported at the `break` keyword (Go's `Break{P}`).
        var bkline: i32 = p.peek_line();
        var bkcol: i32 = p.peek_col();
        p = p.advance();
        // Optional target label: `break outer;`. resolve_labels turns it into a
        // relative loop depth in the tag. Only treat a trailing ident as the label
        // when it is immediately followed by `;` — otherwise a `break` with no
        // trailing semicolon followed by an identifier-led statement would wrongly
        // swallow that statement's leading ident.
        var blbl: string = "";
        var bid: string = p.peek_ident();
        if (bid.len() > 0 && p.advance().peek_punct() == ";") { blbl = bid; p = p.advance(); }
        if (p.peek_punct() == ";") { p = p.advance(); }
        return (StmtBreak { tag: 0, line: bkline, col: bkcol, label: blbl }, p);
    }
    if (kw == "continue") {
        // E011 is reported at the `continue` keyword (Go's `Continue{P}`).
        var ckline: i32 = p.peek_line();
        var ckcol: i32 = p.peek_col();
        p = p.advance();
        // Optional target label: `continue outer;` (only when followed by `;`; see
        // the break case for why).
        var clbl: string = "";
        var cid: string = p.peek_ident();
        if (cid.len() > 0 && p.advance().peek_punct() == ";") { clbl = cid; p = p.advance(); }
        if (p.peek_punct() == ";") { p = p.advance(); }
        return (StmtContinue { tag: 0, line: ckline, col: ckcol, label: clbl }, p);
    }
    // Expression statement — or (compound) assignment if `=`,
    // `+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`, `^=`, `<<=`, `>>=`
    // follows. The parser doesn't accept any of these as binary
    // operators (none of them are in the precedence table), so
    // parse_expr stops at the ident; we peek for the assign-op
    // here and either build a plain StmtAssign or desugar a
    // compound to
    //   StmtAssign { target, ExprBinary(<op>, ExprIdent(target), rhs) }
    // so the rest of the pipeline sees only plain assigns. The
    // bitwise / shift compound set (`&= |= ^= <<= >>=`) mirrors
    // the native parser's compoundOps map exactly, so both
    // front-ends desugar the same operators to the same binary op.
    //
    // Only bare-ident targets are supported in this cut — full
    // lvalue syntax (field / index / tuple) is a later
    // milestone.
    var (e_expr, e_p) = parse_expr(p);
    p = e_p;
    // Capture the assign-op position — the Go checker reports an
    // assignment type error (E003) at the `=` token, not the lvalue.
    var aline: i32 = p.peek_line();
    var acol: i32 = p.peek_col();
    var assign_op: string = p.peek_punct();
    var is_assign: boolean = assign_op == "=";
    var is_compound: boolean = assign_op == "+=" || assign_op == "-="
                            || assign_op == "*=" || assign_op == "/="
                            || assign_op == "%=" || assign_op == "&="
                            || assign_op == "|=" || assign_op == "^="
                            || assign_op == "<<=" || assign_op == ">>=";
    if (is_assign || is_compound) {
        p = p.advance(); // consume the assign-op token
        var (av_expr, av_p) = parse_expr(p);
        p = av_p;
        // Chained assignment `x = y = e` (plain `=`, bare-ident targets):
        // native assignment is a right-recursive expression, so the value
        // flows to every target. parse_expr stopped at the inner `=`, so
        // av_expr is the next target. Collect the ident chain + final value
        // and emit the equivalent right-to-left assigns (`y = e; x = y;` —
        // e is evaluated exactly once) in a scoped block. Without this the
        // trailing `= e` was left as junk and only the first link ran, a
        // silent wrong result (#4339 item 1). Index / field middle targets
        // fall through to the single-assign path unchanged (as before).
        if (is_assign && p.peek_punct() == "=") {
            match (e_expr) {
                ExprIdent(id0) => {
                    var chain: string[] = [];
                    var okchain: boolean = true;
                    var moretgt: boolean = true;
                    while (moretgt && okchain) {
                        match (av_expr) {
                            ExprIdent(idn) => {
                                chain = chain.append(idn.name);
                                p = p.advance();          // consume the `=`
                                var (nx_expr, nx_p) = parse_expr(p);
                                p = nx_p;
                                av_expr = nx_expr;
                                av_p = nx_p;
                                moretgt = (p.peek_punct() == "=");
                            },
                            _ => { okchain = false; },
                        }
                    }
                    if (okchain && chain.len() > 0) {
                        if (p.peek_punct() == ";") { p = p.advance(); }
                        var noelse: Stmt[] = [];
                        var stmts: Stmt[] = [];
                        // innermost target gets the final value, then each
                        // earlier target copies from the one to its right.
                        stmts = stmts.append(s_assign(chain[chain.len() - 1], av_expr));
                        var ci: i32 = chain.len() - 1;
                        while (ci > 0) {
                            stmts = stmts.append(s_assign(chain[ci - 1], e_ident(chain[ci])));
                            ci = ci - 1;
                        }
                        stmts = stmts.append(s_assign(id0.name, e_ident(chain[0])));
                        return (s_if(e_bool(true), stmts, noelse), p);
                    }
                },
                _ => { },
            }
        }
        if (p.peek_punct() == ";") { p = p.advance(); }
        var rhs: Expr = av_expr;
        // Dispatch on the lvalue shape: bare ident → StmtAssign;
        // `arr[idx]` → desugar to the builtin __set_index(arr, idx,
        // value) (an expression statement) so no new Stmt node is
        // needed. Compound `arr[idx] += y` reads the element back (see
        // the ExprIndex arm below); field compounds work the same way.
        match (e_expr) {
            ExprIdent(id) => {
                var rhs2: Expr = rhs;
                if (is_compound) {
                    // `x += y` desugars to `x = x + y`. Strip the
                    // trailing `=` off the op to recover the operator.
                    var op: str = assign_op[0:assign_op.len() - 1];
                    rhs2 = e_binary(op, e_ident(id.name), rhs);
                }
                return (s_assign_at(id.name, rhs2, aline, acol, id.line, id.col), p);
            },
            ExprIndex(ix) => {
                // `arr[idx] = rhs` → __set_index(arr, idx, rhs). A compound
                // `arr[idx] += y` reads the element back: rhs becomes
                // `arr[idx] <op> y`.
                var irhs: Expr = rhs;
                if (is_compound) {
                    var iop: str = assign_op[0:assign_op.len() - 1];
                    irhs = e_binary(iop, e_index(ix.array, ix.index), rhs);
                }
                var sargs: Expr[] = [];
                sargs = sargs.append(ix.array);
                sargs = sargs.append(ix.index);
                sargs = sargs.append(irhs);
                return (s_expr(e_call(e_ident("__set_index"), sargs)), p);
            },
            ExprFieldAccess(fa) => {
                // `obj.field = rhs` → __set_field(obj, "field", rhs)
                // (an expression statement; the emitter shape-dispatches
                // to the field's slot). Compound forms desugar to a read
                // of the same field (re-evaluates obj — fine for the
                // simple lvalues that use this).
                var frhs: Expr = rhs;
                if (is_compound) {
                    var fop: str = assign_op[0:assign_op.len() - 1];
                    frhs = e_binary(fop, e_field_access(fa.obj, fa.field), rhs);
                }
                var fargs: Expr[] = [];
                fargs = fargs.append(fa.obj);
                // Carry the field-access dot position on the field-name
                // string so the checker can report E048 (assign to an
                // immutable field) at the dot, matching the Go checker's
                // FieldAccess position. Codegen ignores the position.
                fargs = fargs.append(e_string_at(fa.field, fa.line, fa.col));
                fargs = fargs.append(frhs);
                return (s_expr(e_call(e_ident("__set_field"), fargs)), p);
            },
            _ => { return (s_unknown("lhs of assign must be ident, index, or field"), p); }
        }
    }
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (s_expr(e_expr), p);
}

pub function parse_program(toks: lexer.Token[]): Stmt[] {
    var p: Par = Par { toks: toks, pos: 0, no_struct: false };
    var out: Stmt[] = [];
    while (!p.at_end()) {
        var (r_stmt, r_p) = parse_stmt(p);
        p = r_p;
        out = out.append(r_stmt);
    }
    return out;
}

// parse_param consumes `ident: type_name` and returns a fresh Par +
// the ParamDecl. ret_arr records, for a closure-typed param `(T) => U[]`
// (coarsed to type_name "fn"), that the closure RETURNS an array — the one
// bit lower_func needs to admit `for y in f(x)` (flat_map's shape) onto the
// IR path. The type position is a bare ident in this cut —
// no array / generic / union syntax.

// parse_type_name reads a (possibly generic) type spelling and
// returns it as a single concatenated string. Recognises:
//   * `Name`                     — `Map` or `i32`
//   * `Name[T1, T2, …]`          — `Map[string, i32]`
// Nested generics (`Map[Map[…], …]`) aren't unrolled; the
// inner `[…]` substring is captured verbatim by counting the
// matching `]`. Returns (par, name) — empty name means
// the parser saw nothing useful.
// fn_ret records, for a closure-typed result `(T) => R` (coarsed to the flat
// tag "fn"), the spelling of R when R is a concrete STRUCT type — the sibling
// of the `ret_arr` bit. It lets a fn-value PARAM `g: () => P` carry enough to
// resolve `g().field` (struct_ret_fns gets a `g|P` entry in lower_func), so the
// call-result field read lowers on the IR path instead of bailing to AST
// (#3640 slice A). Empty for non-struct returns (the common fn-value case).

// consume_array_suffix swallows trailing `[]` suffix(es) after a type and
// appends them to `name`. Needed for the parenthesized type forms — a
// tuple `(i32, i32)[]` or function `(() => i32)[]` array — whose `[]`
// would otherwise be left on the cursor, breaking the surrounding `var`
// decl (the binding's local then never gets declared).
// is_struct_ret_name reports whether `n` is a plausible bare struct/enum type
// name to record as a fn-value's return type (#3640) — a non-empty plain
// identifier that isn't a primitive / built-in tag. Over-recording is harmless
// (the downstream field lookup just fails to resolve and bails as before); this
// only filters the obvious non-structs so the registry stays clean.
function is_struct_ret_name(n: string): boolean {
    if (n.len() == 0) { return false; }
    // Reject anything carrying array / generic / tuple / qualified syntax — a
    // bare struct name has none of these.
    var i: i32 = 0;
    while (i < n.len()) {
        var c: i32 = n[i];
        if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 46 || c == 32) { return false; }
        i = i + 1;
    }
    if (n == "i32" || n == "i64" || n == "u8" || n == "u32" || n == "u64"
        || n == "f32" || n == "f64" || n == "string" || n == "boolean" || n == "void"
        || n == "fn" || n == "unknown" || n == "any") { return false; }
    return true;
}

// is_nominal_ret_name reports whether `n` is a (possibly GENERIC) nominal type
// spelling — a named struct or enum, bare (`Fut`) or instantiated (`Fut[T]`,
// `Future[i32]`, `Map[K, V]`), optionally qualified (`mod.Fut[i32]`). Unlike
// is_struct_ret_name it tolerates the `[...]` generic-arg brackets and a `.`
// qualifier; it still rejects a tuple/fn spelling and the primitives. Used to
// retain an enum-variant fn payload's return type (`(i32) => Fut[T]`) so the
// monomorphiser can recover a nested `match (cont(tok))`'s instantiation (#4722).
function is_nominal_ret_name(n: string): boolean {
    if (n.len() == 0) { return false; }
    // Base = the spelling up to the first generic-arg bracket. A tuple/fn base
    // (opens with `(`) disqualifies.
    var base: string = n;
    var bi: i32 = 0;
    while (bi < n.len()) {
        if (n[bi] == 91) { base = n[0 : bi] + ""; bi = n.len(); }
        else { bi = bi + 1; }
    }
    if (base.len() == 0) { return false; }
    if (base[0] == 40) { return false; }   // tuple / fn spelling
    if (base == "i32" || base == "i64" || base == "u8" || base == "u32" || base == "u64"
        || base == "f32" || base == "f64" || base == "string" || base == "boolean" || base == "void"
        || base == "fn" || base == "unknown" || base == "any") { return false; }
    return true;
}

function consume_array_suffix(p: Par, name: string): (string, boolean, string, Par) {
    while (p.peek_punct() == "[") {
        p = p.advance();
        if (p.peek_punct() == "]") {
            p = p.advance();
            name = name + "[]";
        }
    }
    return (name, false, "", p);
}

// coarsen_type_seg coarsens ONE tuple-element spelling: a segment
// containing a `=>` is a function type — "fn", or "fn[]" for a
// parenthesized fn-array element ("((i32)=>i32)[]") — unless the
// segment is itself a nested TUPLE (a parenthesized list with a comma
// at its own depth 1), which recurses through coarsen_fn_elems. A
// segment with no arrow passes through unchanged.
function coarsen_type_seg(seg: string): string {
    var has_arrow: boolean = false;
    var k: i32 = 0;
    while (k + 1 < seg.len()) {
        if (seg[k] == 61 && seg[k + 1] == 62) { has_arrow = true; }   // "=>"
        k = k + 1;
    }
    if (!has_arrow) { return seg; }
    if (seg.len() >= 2 && seg[0] == 40) {   // 40 = '('
        // Find the close paren matching seg[0], and whether a depth-1
        // comma appears inside it (a nested tuple's element separator).
        var d: i32 = 0;
        var close: i32 = 0 - 1;
        var comma1: boolean = false;
        var j: i32 = 0;
        while (j < seg.len()) {
            if (seg[j] == 40 || seg[j] == 91) { d = d + 1; }        // '(' '['
            else if (seg[j] == 41 || seg[j] == 93) {                 // ')' ']'
                d = d - 1;
                if (d == 0 && seg[j] == 41 && close < 0) { close = j; }
            }
            else if (seg[j] == 44 && d == 1 && close < 0) { comma1 = true; }   // ','
            j = j + 1;
        }
        // `(params) => R` — the parens are a PARAM LIST (arrow follows
        // the close, possibly with a depth-1 comma between the params):
        // the whole segment is one fn type.
        if (close >= 0 && close + 2 < seg.len() && seg[close + 1] == 61 && seg[close + 2] == 62) {
            return "fn";
        }
        // Nested tuple (`((i32)=>i32, i32)`), possibly with an array
        // suffix: recurse on the parenthesized part, keep the suffix.
        if (comma1 && close >= 0) {
            return coarsen_fn_elems(seg[0 : close + 1] + "") + seg[close + 1 : seg.len()];
        }
        // Parenthesized whole-fn element (`((i32)=>i32)` / with "[]").
        if (close >= 0 && close + 1 < seg.len()) { return "fn" + seg[close + 1 : seg.len()]; }
        return "fn";
    }
    return "fn";
}

// coarsen_fn_elems rewrites a reconstructed TUPLE type spelling whose
// elements include function types — "((i32)=>i32, i32)" — so each
// fn-typed depth-1 segment collapses to the coarse "fn" tag all
// consumers expect ("(fn, i32)"), mirroring how a standalone fn type
// coarsens to "fn". Elements with no arrow pass through untouched, so
// the precise spellings tuple-destructure relies on survive.
function coarsen_fn_elems(spelling: string): string {
    if (spelling.len() < 2 || spelling[0] != 40) { return spelling; }   // 40 = '('
    var inner: str = spelling[1 : spelling.len() - 1];
    var out: string = "(";
    var depth: i32 = 0;
    var start: i32 = 0;
    var first: boolean = true;
    var i: i32 = 0;
    while (i <= inner.len()) {
        if (i == inner.len() || (inner[i] == 44 && depth == 0)) {   // 44 = ','
            var seg: string = inner[start : i] + "";
            while (seg.len() > 0 && seg[0] == 32) { seg = seg[1 : seg.len()] + ""; }
            while (seg.len() > 0 && seg[seg.len() - 1] == 32) { seg = seg[0 : seg.len() - 1] + ""; }
            if (!first) { out = out + ", "; }
            out = out + coarsen_type_seg(seg);
            first = false;
            start = i + 1;
        } else if (inner[i] == 91 || inner[i] == 40) { depth = depth + 1; }   // '[' '('
        else if (inner[i] == 93 || inner[i] == 41) { depth = depth - 1; }   // ']' ')'
        i = i + 1;
    }
    return out + ")";
}

function parse_type_name(p: Par): (string, boolean, string, Par) {
    var base: string = p.peek_ident();
    if (base.len() == 0) { base = p.peek_keyword(); }
    // `dyn Trait` (single) or `dyn A + B + …` (multi-trait object) — a
    // runtime trait-object type. The self-host erases it to a coarse
    // `"dyn <trait>"` / `"dyn A + B"` spelling and dispatches method
    // calls by the value's runtime shape (a struct/enum value carries
    // its own shape pointer); op_dyn_dispatch enumerates EVERY module
    // method of the called name over its struct/prim receivers, so a
    // method from ANY trait in the set lands on the concrete impl with
    // no trait-specific dispatch path — only the type parse changes for
    // the multi-trait case. Recurse per trait so `dyn Shape[]` /
    // `dyn mod.Shape` / `dyn A + B[]` reuse the generic-arg +
    // trailing-`[]` handling; the `[]` falls on the last trait and so on
    // the whole `"dyn …"` spelling, which is what is_array_type_name +
    // the element-strip (name[0:len-2]) expect. Traits are joined in
    // source order with " + " (matching the native String() separator);
    // dispatch is set-agnostic, so no sort/dedup is needed for the
    // coarse self-host model. A trailing/empty `+` is a parse error.
    // See docs/DYN-TRAITS.md §4.3 + §10.
    if (base == "dyn") {
        p = p.advance(); // consume `dyn`
        var (dinner_name, dinner_ret_arr, dinner_fn_ret, dinner_p) = parse_type_name(p);
        p = dinner_p;
        var dynname: string = dinner_name;
        // Collect any `+ Trait` continuations (multi-trait `dyn A + B`).
        while (p.peek_punct() == "+") {
            p = p.advance(); // consume `+`
            var (dmore_name, dmore_ret_arr, dmore_fn_ret, dmore_p) = parse_type_name(p);
            p = dmore_p;
            if (dmore_name.len() == 0) {
                // Trailing / empty `+` — no trait name followed it.
                return ("", false, "", p);
            }
            dynname = dynname + " + " + dmore_name;
        }
        return ("dyn " + dynname, false, "", p);
    }
    // WIT resource-handle type `own R` / `borrow R` (P5 —
    // docs/WIT-BRING-YOUR-OWN.md). A handle is an opaque i32 at the canonical
    // ABI, so the self-host erases it to "i32" (mirroring the Go ir.LowerWith
    // handle-erasure): consume the inner resource type and return "i32". The
    // owned/borrowed distinction and the resource binding are checker-/drop-
    // slice concerns the emitter doesn't need here.
    if (base == "own" || base == "borrow") {
        // WIT resource-handle type `own R` / `borrow R` (P5 —
        // docs/WIT-BRING-YOUR-OWN.md). Preserved as "own <R>" / "borrow <R>"
        // (mirroring `dyn <trait>`): it lowers to i32 everywhere (a handle is an
        // opaque scalar — see wat_extern_valtype and the local/param valtype
        // defaults), and the spelling lets insert_resource_drops find owned
        // handles and tell own from borrow for its move analysis.
        p = p.advance(); // consume `own` / `borrow`
        var (hinner_name, hinner_ret_arr, hinner_fn_ret, hinner_p) = parse_type_name(p);
        return (base + " " + hinner_name, false, "", hinner_p);
    }
    if (base.len() == 0) {
        // Tuple type `(T1, T2, …)`. The self-host stores types
        // coarsely, so consume the balanced parens and return a
        // placeholder "tuple" rather than the precise shape. Without
        // this the leading `(` is left on the cursor and the decl
        // loop spins (OOM). std/string's split_at / split_once use
        // `(string, string)` and `Option[(string, string)]`.
        if (p.peek_punct() == "(") {
            // A parenthesized SINGLE trait-object type — `(dyn T)`,
            // `(dyn A + B)`, optionally arrayed `(dyn T)[]`. The parens are
            // redundant grouping (source needs them so a trailing `[]` binds to
            // the whole `dyn T`, not to a trait generic-arg). Unwrap to the
            // paren-free `dyn T` / `dyn T[]` spelling the `dyn` branch above
            // produces — otherwise the tuple char-collect loop below mashes
            // `dyn Shape` into `(dynShape)` (space dropped, parens kept) and
            // every `type_name[0:4] == "dyn "` consumer misses, so a
            // `(dyn Trait)[]` PARAM's element dispatch declines the IR path
            // (#5203). A genuine tuple whose first element is `dyn`
            // (`(dyn A, i32)`) is NOT a single-type wrap: the `)`-follows check
            // fails and the untouched cursor runs the unchanged tuple path.
            var dpa: Par = p.advance();   // peek past `(`
            if (dpa.peek_keyword() == "dyn") {
                var (dpw_name, dpw_ret_arr, dpw_fn_ret, dpw_p) = parse_type_name(dpa);
                if (dpw_p.peek_punct() == ")") {
                    // `(dyn T) => R` is a FUNCTION type whose PARAMETER is a
                    // trait object, not a grouped trait-object array — the arrow
                    // follows the parens. Leave it to the char-collect + `=> R`
                    // path below (which coarsens it to "fn"); only unwrap a
                    // genuine `(dyn T)` / `(dyn T)[]`. Without this guard the
                    // arrow + return type are dropped and `(dyn T) => R` params
                    // fail to parse (#5267 regressed this shape).
                    var dpw_after: Par = dpw_p.advance();   // past `)`
                    if (dpw_after.peek_punct() != "=>") {
                        return consume_array_suffix(dpw_after, dpw_name);
                    }
                }
            }
            var tbuf: string = "";
            var td: i32 = 0;
            var is_fn: boolean = false;
            var top_comma: boolean = false;
            while (!p.at_end()) {
                var tpk: string = p.peek_punct();
                if (tpk == "(") { td = td + 1; tbuf = tbuf + "("; p = p.advance(); continue; }
                if (tpk == ")") { td = td - 1; tbuf = tbuf + ")"; p = p.advance(); if (td == 0) { break; } continue; }
                if (tpk == ",") { if (td == 1) { top_comma = true; } tbuf = tbuf + ", "; p = p.advance(); continue; }
                if (tpk == "[") { tbuf = tbuf + "["; p = p.advance(); continue; }
                if (tpk == "]") { tbuf = tbuf + "]"; p = p.advance(); continue; }
                if (tpk == ".") { tbuf = tbuf + "."; p = p.advance(); continue; }
                // A `=>` *inside* the parens with NO depth-1 comma means the
                // parens wrap a whole function type (`(() => i32)`), not a
                // tuple — coarse it to "fn" (a closure box). With a depth-1
                // comma the parens are a TUPLE whose elements include fn
                // types (`((i32) => i32, i32)`); keep the arrow in the
                // reconstructed spelling so coarsen_fn_elems below can
                // collapse just the fn-typed SEGMENTS. (The `(T,…) => R`
                // form, with `=>` *after* the parens, is handled below.)
                if (tpk == "=>") { is_fn = true; tbuf = tbuf + "=>"; p = p.advance(); continue; }
                var tseg: string = p.peek_ident();
                if (tseg.len() == 0) { tseg = p.peek_keyword(); }
                if (tseg.len() == 0) { p = p.advance(); continue; }
                tbuf = tbuf + tseg;
                p = p.advance();
            }
            // Parenthesized function type `(… => …)` → coarse "fn", plus any
            // trailing `[]` (an array of closures). Only when there is no
            // depth-1 comma: with one, the parens are a tuple and the arrow
            // belongs to an ELEMENT (unless a `=> R` follows the parens —
            // the fn-taking-a-tuple-param form the next branch handles).
            if (is_fn && !top_comma) {
                return consume_array_suffix(p, "fn");
            }
            // Function type `(T1, …) => R`. After the balanced param
            // parens, a `=>` introduces the return type. Consume it
            // and the return-type spelling, returning a coarse "fn"
            // tag (the self-host stores types coarsely; the only thing
            // the emitter needs is that a value of this type is a
            // closure box). Without consuming `=> R` the arrow + return
            // type are left on the cursor and the decl loop spins (OOM).
            if (p.peek_punct() == "=>") {
                p = p.advance();  // consume `=>`
                var (rr_name, rr_ret_arr, rr_fn_ret, rr_p) = parse_type_name(p);
                p = rr_p;
                // `(…) => R` — coarse "fn"; a trailing `[]` makes it an
                // array of closures. Record ret_arr when R is itself an
                // array (`(T) => U[]`): the tag stays the plain "fn" all
                // consumers expect, but the bit rides along so lower_func can
                // admit `for y in f(x)` (flat_map) onto the IR path.
                var (fnr_name, fnr_ret_arr, fnr_fn_ret, fnr_p) = consume_array_suffix(p, "fn");
                var r_is_arr: boolean = rr_name.len() >= 2 && rr_name[rr_name.len() - 2 : rr_name.len()] == "[]";
                // Preserve R when it is a concrete struct return type, so a
                // fn-value `g: () => P` can resolve `g().field` on the IR path
                // (#3640). A bare struct-ish name qualifies — arrays carry their
                // info in ret_arr, and primitives need no field lookup. Also
                // preserve a (possibly generic) NOMINAL enum return spelling
                // (`(i32) => Fut[T]`) so an enum-variant fn payload retains its
                // return type: the variant desugar records it on the variant
                // struct field's fn_ret, and monomorphize's me_scrutinee_type
                // recovers it to rewrite a nested `match (cont(tok))`'s arms
                // (#4722). The struct_ret_fns consumer in irlower excludes any
                // bracketed (generic) fn_ret, so a non-struct enum return here
                // adds no spurious struct-return entry — it is read only via the
                // new StructFieldDecl.fn_ret field path.
                var fn_ret_ty: string = "";
                if (!r_is_arr && is_struct_ret_name(rr_name)) { fn_ret_ty = rr_name; }
                else if (!r_is_arr && is_nominal_ret_name(rr_name)) { fn_ret_ty = rr_name; }
                // Also preserve a plain `string` return (`(i32) => string`): the
                // StructFieldDecl.fn_ret consumer needs it so a chained string
                // op on an fn-FIELD call result (`h.f(1).len()`) dispatches as
                // a string (#5306 gap 2). The struct_ret_fns param consumer
                // filters "string" out (a string is not a struct), so this adds
                // no spurious struct-return entry.
                else if (!r_is_arr && rr_name == "string") { fn_ret_ty = "string"; }
                return (fnr_name, r_is_arr, fn_ret_ty, fnr_p);
            }
            // Tuple type — return the reconstructed precise spelling
            // (e.g. "(string, TestRunner)") so tuple-destructure
            // bindings can recover each element's type. ret_tag_of
            // still maps the whole "(…)" to "unknown", so this is a
            // strict superset of the old coarse "tuple" placeholder. A
            // trailing `[]` makes it an array of tuples. An fn-typed
            // element's spelling collapses to the coarse "fn" tag
            // (`((i32) => i32, i32)` → "(fn, i32)") — before this,
            // ANY arrow inside the parens coarsened the WHOLE type to
            // "fn", so a tuple containing a function wasn't even a
            // tuple type to the self-host compiler.
            if (is_fn) { tbuf = coarsen_fn_elems(tbuf); }
            return consume_array_suffix(p, tbuf);
        }
        // Prefix-bracket type `[T]` (e.g. `var ab: [u8] = ...`).
        // Without consuming it the surrounding decl loop spins on the
        // `[` (OOMs the compiler). Reduce to the canonical postfix
        // `T[]` form by parsing the inner type, swallowing the `]`,
        // and returning `inner + "[]"` so ret_tag_of maps it through
        // the existing array path.
        if (p.peek_punct() == "[") {
            p = p.advance();   // consume `[`
            var (bracketed_name, bracketed_ret_arr, bracketed_fn_ret, bracketed_p) = parse_type_name(p);
            p = bracketed_p;
            if (p.peek_punct() == "]") { p = p.advance(); }
            return (bracketed_name + "[]", false, "", p);
        }
        return ("", false, "", p);
    }
    p = p.advance();
    // Qualified type name: `pkg.Name` (e.g. `lexer.Token`). Consume
    // the `.ident` suffix chain so cross-module type references in
    // struct fields / params / return types parse cleanly. Without
    // this the `.` is left on the cursor and the surrounding field /
    // decl loop can't make progress — it spins, allocating until the
    // process is OOM-killed. parser.fern itself is full of
    // `lexer.Token` field / param types, so this is required for the
    // self-host parser to parse its own source.
    while (p.peek_punct() == ".") {
        p = p.advance();  // consume `.`
        var seg0: string = p.peek_ident();
        if (seg0.len() == 0) { seg0 = p.peek_keyword(); }
        if (seg0.len() == 0) { break; }
        base = base + "." + seg0;
        p = p.advance();
    }
    // `str` -- the borrowed-string view type (#4813). The self-host ERASES
    // it to "string" at the parse boundary: the parse-time mirror of the
    // native ir/erase_str.go choke point. A view lowers to exactly the
    // string box shape, and the view-discipline enforcement (E065 / the
    // borrow rules) is the native checker's job, so normalizing here keeps
    // every downstream `== "string"` dispatch site working unchanged -- the
    // self-host COMPILES str programs, natively-checked. A qualified
    // `str.Foo` keeps its nominal spelling (the dot-chain above already
    // extended base past the bare name).
    if (base == "str") { base = "string"; }
    if (p.peek_punct() != "[") {
        return (base, false, "", p);
    }
    // Consume `[T1, T2, …]` by tracking bracket depth so nested
    // generics survive verbatim. Token text reconstructed from
    // the same peek_* family — type-name args are restricted
    // to idents / keywords / `,` / `[` / `]`.
    p = p.advance();  // consume opening `[`
    var inner: string = "";
    var depth: i32 = 1;
    // Two ident/keyword tokens are only ever adjacent inside a generic arg
    // for a `dyn Trait` object type (`Result[i32, dyn Error]`). Every other
    // separator (`,` `[` `(` …) inserts its own delimiter, but two bare
    // idents have none — so reinsert the space to keep the canonical
    // `"dyn Error"` spelling. Without it the payload type is stored as
    // `"dynError"` and the dyn-dispatch guard (`rty[0:4] == "dyn "`) misses.
    var prev_ident: boolean = false;
    while (depth > 0 && !p.at_end()) {
        var pk: string = p.peek_punct();
        if (pk == "[") { depth = depth + 1; inner = inner + "["; p = p.advance(); prev_ident = false; continue; }
        if (pk == "]") { depth = depth - 1; if (depth == 0) { break; } inner = inner + "]"; p = p.advance(); prev_ident = false; continue; }
        if (pk == ",") { inner = inner + ", "; p = p.advance(); prev_ident = false; continue; }
        // Multi-trait object `dyn A + B` nested in a generic arg — match the
        // top-level `parse_type` spelling (` + ` joined) so the dyn payload
        // type round-trips identically.
        if (pk == "+") { inner = inner + " + "; p = p.advance(); prev_ident = false; continue; }
        // Tuple types nested inside a generic arg, e.g.
        // `Option[(string, string)]` — pass parens through verbatim.
        if (pk == "(") { inner = inner + "("; p = p.advance(); prev_ident = false; continue; }
        if (pk == ")") { inner = inner + ")"; p = p.advance(); prev_ident = false; continue; }
        // FN-typed generic arg, e.g. `Option[() => i32]`, `Map[i32, (A) => B]`,
        // `Result[(i32) => i32, E]` — pass the `=>` arrow through verbatim (joined
        // with surrounding spaces) so the fn-type spelling round-trips inside the
        // brackets. Without this the loop breaks on `=>`, truncating the type to
        // `Option[()]` and leaving `=> i32` on the cursor — which then corrupts the
        // enclosing decl body into a StmtUnknown.
        if (pk == "=>") { inner = inner + " => "; p = p.advance(); prev_ident = false; continue; }
        var seg: string = p.peek_ident();
        if (seg.len() == 0) { seg = p.peek_keyword(); }
        if (seg.len() == 0) { break; }
        if (prev_ident) { inner = inner + " "; }
        inner = inner + seg;
        p = p.advance();
        prev_ident = true;
    }
    if (p.peek_punct() == "]") { p = p.advance(); }
    var nm: string = base + "[" + inner + "]";
    // Trailing array suffixes for nested array types: `i32[][]`,
    // `T[][][]`, `Map[K, V][]`, etc. After a complete type a `[` is only
    // ever an (empty) array suffix in this grammar, so consume each
    // `[]` pair and append it. Without this the second `[]` is left on
    // the cursor and the surrounding decl misaligns (the `var` binding
    // gets dropped). The base case `T[]` already returned above.
    while (p.peek_punct() == "[") {
        p = p.advance();  // consume `[`
        if (p.peek_punct() == "]") {
            p = p.advance();  // consume `]`
            nm = nm + "[]";
        } else {
            break;
        }
    }
    return (nm, false, "", p);
}

// parse_tuple_param consumes a tuple-destructuring parameter
// `(a, b): (T, U)` — the cursor is on the opening `(` of the binding
// list. Desugared exactly like the native parser's parseTupleParam:
// the param becomes a synthetic `__ptuple_<line>_<col>` holder of the
// annotated tuple type, and destr_names carries the comma-joined
// binding names ("a,b") the caller prepends to the freshly-parsed
// body as an ordinary destructure statement (s_var_at with the
// comma-joined name — the same StmtVar shape `var (a, b) = …;`
// produces), so the whole feature rides the existing destructure
// lowering. Empty destr_names signals a parse problem (fewer than 2
// names, or a missing `:`); callers degrade the same way they do for
// parse_param's empty-name result.

function parse_tuple_param(p: Par): (ParamDecl, string, i32, i32, Par) {
    var tline: i32 = p.peek_line();
    var tcol: i32 = p.peek_col();
    var bad: ParamDecl = ParamDecl { name: "", type_name: "", own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" };
    p = p.advance(); // consume `(`
    var names: string = "";
    var count: i32 = 0;
    while (true) {
        var n: string = p.peek_ident();
        if (n.len() == 0) { break; }
        p = p.advance();
        if (count > 0) { names = names + ","; }
        names = names + n;
        count = count + 1;
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    // At least 2 names (no-singleton-tuples rule), and the annotation
    // is required.
    if (count < 2) {
        return (bad, "", tline, tcol, p);
    }
    if (p.peek_punct() != ":") {
        return (bad, "", tline, tcol, p);
    }
    p = p.advance();
    var (tr_name, tr_ret_arr, tr_fn_ret, tr_p) = parse_type_name(p);
    p = tr_p;
    // A destructured parameter can't carry a default value.
    if (p.peek_punct() == "=") {
        return (bad, "", tline, tcol, p);
    }
    var synth: string = "__ptuple_" + util.i32_to_string(tline) + "_" + util.i32_to_string(tcol);
    return (ParamDecl { name: synth, type_name: tr_name, own: false, has_default: false, default_value: e_unknown(""), ret_arr: tr_ret_arr, fn_ret: tr_fn_ret, fn_param_dyn: "" }, names, tline, tcol, p);
}

// prepend_param_destrs splices the desugared `var (a, b) = <synth>;`
// destructures for any tuple-destructuring parameters at the front of
// a freshly-parsed body, in parameter order. The four arrays are
// parallel (one entry per destructured param).
function prepend_param_destrs(body: Stmt[], destrs: string[], synths: string[], lines: i32[], cols: i32[]): Stmt[] {
    if (destrs.len() == 0) { return body; }
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < destrs.len()) {
        out = out.append(s_var_at(destrs[i], "", e_ident_at(synths[i], lines[i], cols[i]), lines[i], cols[i]));
        i = i + 1;
    }
    var j: i32 = 0;
    while (j < body.len()) {
        out = out.append(body[j]);
        j = j + 1;
    }
    return out;
}

// peek_fn_param_dyn is a NON-consuming lookahead at a type position. If the type
// is a function type `(P0, …, Pn) => R`, it returns the comma-separated indices
// of the parameters whose type head is `dyn …` (a trait object) — "0", "0,2", …
// — else "". parse_param records this on the `fn`-typed param so an indirect call
// `f(7)` knows to dyn-box the arg (the flat "fn" tag drops per-param types, #5276).
// Scans a local copy of the parser; the caller's cursor is untouched.
function peek_fn_param_dyn(p0: Par): string {
    var p: Par = p0;
    if (p.peek_punct() != "(") { return ""; }
    p = p.advance();   // consume '('
    var positions: string = "";
    var idx: i32 = 0;
    var depth: i32 = 1;
    var param_is_dyn: boolean = false;
    var seen_token: boolean = false;
    var type_head: boolean = true;   // the next depth-1 token leads a type (param start / after ':')
    while (!p.at_end() && depth > 0) {
        var pk: string = p.peek_punct();
        if (pk == "(") { depth = depth + 1; seen_token = true; type_head = false; p = p.advance(); continue; }
        if (pk == ")") {
            depth = depth - 1;
            if (depth == 0) {
                if (seen_token && param_is_dyn) {
                    if (positions.len() > 0) { positions = positions + ","; }
                    positions = positions + util.i32_to_string(idx);
                }
                p = p.advance();
                break;
            }
            p = p.advance(); continue;
        }
        if (depth == 1 && pk == ",") {
            if (seen_token && param_is_dyn) {
                if (positions.len() > 0) { positions = positions + ","; }
                positions = positions + util.i32_to_string(idx);
            }
            idx = idx + 1;
            param_is_dyn = false;
            seen_token = false;
            type_head = true;
            p = p.advance(); continue;
        }
        if (depth == 1 && pk == ":") { type_head = true; seen_token = true; p = p.advance(); continue; }
        // A word token (ident or keyword). `dyn` at a type head marks the param.
        var kw: string = p.peek_keyword();
        if (kw.len() == 0) { kw = p.peek_ident(); }
        if (depth == 1 && type_head && kw == "dyn") { param_is_dyn = true; }
        if (kw.len() > 0) { seen_token = true; type_head = false; }
        p = p.advance();
    }
    // Only a genuine fn type if a `=>` (return arrow) follows the params.
    if (p.peek_punct() != "=>") { return ""; }
    return positions;
}

function parse_param(p: Par): (ParamDecl, Par) {
    var name: string = p.peek_ident();
    if (name.len() == 0) {
        return (ParamDecl { name: "", type_name: "", own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }, p);
    }
    // `own NAME: TYPE` — the affine-ownership modifier (move-checked by
    // the checker's E050/E051). `own` is a plain ident to the lexer, so it
    // only counts as the modifier when another ident (the real name)
    // follows; a parameter literally named `own` (no name after) is left
    // as-is.
    var is_own: boolean = false;
    if (name == "own") {
        var probe: Par = p.advance();
        if (probe.peek_ident().len() > 0) {
            is_own = true;
            p = probe;
            name = p.peek_ident();
        }
    }
    p = p.advance();
    if (p.peek_punct() != ":") {
        return (ParamDecl { name: name, type_name: "", own: is_own, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }, p);
    }
    p = p.advance();
    // Capture the fn-type's per-parameter dyn positions BEFORE parse_type_name
    // coarsens the spelling to the flat "fn" tag (#5276).
    var tr_fn_pdyn: string = peek_fn_param_dyn(p);
    var (tr_name, tr_ret_arr, tr_fn_ret, tr_p) = parse_type_name(p);
    p = tr_p;
    if (tr_name != "fn") { tr_fn_pdyn = ""; }
    // Optional default value: `function f(a: i32, b: i32 = 128)`.
    // fill_default_args_module fills it at call sites that omit the argument.
    var has_def: boolean = false;
    var def_val: Expr = e_unknown("");
    if (p.peek_punct() == "=") {
        p = p.advance();
        var (de_expr, de_p) = parse_expr(p);
        p = de_p;
        has_def = true;
        def_val = de_expr;
    }
    return (ParamDecl { name: name, type_name: tr_name, own: is_own, has_default: has_def, default_value: def_val, ret_arr: tr_ret_arr, fn_ret: tr_fn_ret, fn_param_dyn: tr_fn_pdyn }, p);
}

// parse_func_decl consumes `function name(params): ret_type { body }`
// starting from the `function` keyword. Errors leave the parser at
// the offending token; the surrounding parse_module loop turns the
// result into a degenerate FuncDecl with empty name on failure so
// the caller can spot it.

function parse_func_decl(p: Par): (FuncDecl, Par) {
    // Caller has already peeked the `function` keyword. Consume.
    var fline: i32 = p.peek_line();
    var fcol: i32 = p.peek_col();
    p = p.advance();
    var empty_params: ParamDecl[] = [];
    var empty_body: Stmt[] = [];
    // Bounded type-parameter names collected from a `[T: Bound]` list
    // (empty for non-generic / unbounded-generic functions). Drives
    // monomorphisation — see FuncDecl.type_params.
    var bounded_tps: string[] = [];
    // Parallel to bounded_tps: the trait bound(s) on each collected type
    // param (a `+`-joined trait-name list; "" for a promoted unbounded
    // param). Feeds FuncDecl.bound_traits for the checker's E021 call-site
    // conformance check (#4842).
    var bound_names: string[] = [];
    // Unbounded type params, collected during the header parse and TARGETED-
    // promoted after the signature is known: an unbounded `T` is promoted to
    // the monomorphiser (so its instantiations clone) ONLY when it feeds a
    // parametric type — appearing as a type-ARGUMENT inside brackets
    // (`ArrayIter[T]`, `Option[T]`) in a param or return type. A purely-opaque
    // `T` / `T[]` (uniform 8-byte ABI) or one that surfaces only in a trait
    // bound (`count[T, I: Iterator[T]]`, where the param is `it: I`) stays
    // erased — promoting it would add an unbindable key component and inflate
    // the 512-function IR budget on the bootstrap self-compiles.
    var unbounded_tps: string[] = [];
    // Total number of type parameters (bounded + unbounded). Bounded names
    // are kept for the monomorphiser; unbounded ones are erased, but the
    // count is recorded so the checker can flag a generic-call type-argument
    // arity mismatch (E040).
    var all_tp_count: i32 = 0;
    // Optional receiver clause: `function (recv: RecvType) name(…)`.
    // Distinguished from the param list by appearing before the
    // method name. A `(` immediately after `function` triggers
    // receiver-mode parsing.
    var receiver_name: string = "";
    var receiver_type: string = "";
    if (p.peek_punct() == "(") {
        p = p.advance();
        receiver_name = p.peek_ident();
        // `function (own s: T) name(…)` — the affine-ownership receiver
        // modifier (mirrors parse_param's `own NAME: TYPE` probe: `own`
        // only counts as the modifier when another ident follows, so a
        // receiver literally named `own` still parses). The flag itself is
        // NOT yet recorded on FuncDecl: the self-host backends lower every
        // param — receiver included — as a borrow (leak-safe), so parsing
        // past the keyword is all compilation needs. Threading a
        // receiver_own flag through FuncDecl (for checker.fern's ow_
        // method-call guard, mirroring the native checker's hoisted
        // flags[0]) is the follow-up checker-parity slice.
        if (receiver_name == "own") {
            var rprobe: Par = p.advance();
            if (rprobe.peek_ident().len() > 0) {
                p = rprobe;
                receiver_name = p.peek_ident();
            }
        }
        if (receiver_name.len() > 0) {
            p = p.advance();
            if (p.peek_punct() == ":") {
                p = p.advance();
                var (rtr_name, rtr_ret_arr, rtr_fn_ret, rtr_p) = parse_type_name(p);
                p = rtr_p;
                receiver_type = rtr_name;
            }
        }
        if (p.peek_punct() == ")") { p = p.advance(); }
    }
    var name: string = p.peek_member_name();
    if (name.len() == 0) {
        return (FuncDecl { name: "", receiver_name: receiver_name, receiver_type: receiver_type, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: bound_names, fip: false, ret_str: false }, p);
    }
    p = p.advance();
    // Optional generic type parameters: `name[T]`, `name[T: Bound, U]`.
    // UNBOUNDED params are erased (the self-host ABI is a uniform 8-byte
    // slot, so one body fits every instantiation). BOUNDED params name a
    // trait whose methods the body calls on a `T`-typed value — those
    // can't be erased (dynamic dispatch can't read a shape pointer off
    // an unboxed primitive), so we record them for the monomorphiser.
    // See docs/TRAITS.md (self-host slice 2).
    if (p.peek_punct() == "[") {
        p = p.advance();
        while (!p.at_end()) {
            if (p.peek_punct() == "]") { break; }
            var tpname: string = p.peek_ident();
            if (tpname.len() == 0) { p = p.advance(); continue; }
            p = p.advance();
            all_tp_count = all_tp_count + 1;
            var has_bound: boolean = false;
            var this_bounds: string = "";
            if (p.peek_punct() == ":") {
                has_bound = true;
                p = p.advance();
                // Consume `Trait (+ Trait)*`, each possibly `mod.Trait` and
                // each possibly carrying generic args (`Iterator[i32]`).
                // Accumulate the trait name(s) into this_bounds (a `+`-joined
                // list; base name only for a generic-arg bound) so the checker
                // can test conformance of the call-site type argument (#4842).
                var go: boolean = true;
                while (go && !p.at_end()) {
                    var tname: string = "";
                    if (p.peek_ident().len() > 0) { tname = p.peek_ident(); p = p.advance(); }
                    if (p.peek_punct() == ".") {
                        p = p.advance();
                        if (p.peek_ident().len() > 0) { tname = tname + "." + p.peek_ident(); p = p.advance(); }
                    }
                    // A parametrised-trait bound (`T: Iterator[i32]`) carries a
                    // bracketed type-arg list after the trait name — consume the
                    // balanced `[ … ]` (possibly nested) so the bound parses and
                    // the function stays on the monomorphisation / IR path rather
                    // than mis-parsing at the `[` and bailing to AST.
                    if (p.peek_punct() == "[") {
                        var depth: i32 = 0;
                        var bgo: boolean = true;
                        while (bgo && !p.at_end()) {
                            var bpk: string = p.peek_punct();
                            if (bpk == "[") { depth = depth + 1; p = p.advance(); }
                            else if (bpk == "]") { depth = depth - 1; p = p.advance(); if (depth == 0) { bgo = false; } }
                            else { p = p.advance(); }
                        }
                    }
                    if (tname.len() > 0) {
                        if (this_bounds.len() > 0) { this_bounds = this_bounds + "+"; }
                        this_bounds = this_bounds + tname;
                    }
                    if (p.peek_punct() == "+") { p = p.advance(); } else { go = false; }
                }
            }
            if (has_bound) { bounded_tps = bounded_tps.append(tpname); bound_names = bound_names.append(this_bounds); }
            else { unbounded_tps = unbounded_tps.append(tpname); }
            if (p.peek_punct() == ",") { p = p.advance(); }
        }
        if (p.peek_punct() == "]") { p = p.advance(); }
    }
    if (p.peek_punct() != "(") {
        return (FuncDecl { name: name, receiver_name: receiver_name, receiver_type: receiver_type, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", type_param_count: all_tp_count, bound_traits: bound_names, fip: false, ret_str: false }, p);
    }
    p = p.advance();
    var params: ParamDecl[] = [];
    // Tuple-destructuring params: parallel arrays of the comma-joined
    // binding names / synthetic holder names / positions, prepended to
    // the body (as destructure statements) after parse_block below.
    var pd_names: string[] = [];
    var pd_synths: string[] = [];
    var pd_lines: i32[] = [];
    var pd_cols: i32[] = [];
    if (p.peek_punct() != ")") {
        while (true) {
            if (p.peek_punct() == "(") {
                var (tpr_param, tpr_destr_names, tpr_line, tpr_col, tpr_p) = parse_tuple_param(p);
                p = tpr_p;
                if (tpr_destr_names.len() == 0) {
                    return (FuncDecl { name: "", receiver_name: receiver_name, receiver_type: receiver_type, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: bound_names, fip: false, ret_str: false }, p);
                }
                params = params.append(tpr_param);
                pd_names = pd_names.append(tpr_destr_names);
                pd_synths = pd_synths.append(tpr_param.name);
                pd_lines = pd_lines.append(tpr_line);
                pd_cols = pd_cols.append(tpr_col);
                if (p.peek_punct() == ",") { p = p.advance(); continue; }
                break;
            }
            var (pr_param, pr_p) = parse_param(p);
            p = pr_p;
            params = params.append(pr_param);
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            break;
        }
    }
    if (p.peek_punct() == ")") { p = p.advance(); }
    var ret_type: string = "";
    // A bare `str` return spelling is recorded on FuncDecl.ret_str BEFORE
    // parse_type_name erases it to "string" — the E065 view-escape rule
    // needs to know the function returns a borrowed view. Probe: the token
    // after `str` must open the body (`{`) or end an extern decl (`;`), so
    // `str.Foo` / `str[]` spellings keep their normal resolution.
    var fn_ret_str: boolean = false;
    if (p.peek_punct() == ":") {
        p = p.advance();
        if (p.peek_ident() == "str") {
            var str_probe: Par = p.advance();
            if (str_probe.peek_punct() == "{" || str_probe.peek_punct() == ";") { fn_ret_str = true; }
        }
        var (fr_tr_name, fr_tr_ret_arr, fr_tr_fn_ret, fr_tr_p) = parse_type_name(p);
        p = fr_tr_p;
        ret_type = fr_tr_name;
    }
    // Targeted promotion: promote an unbounded type param only when BOTH
    //   (a) it feeds a parametric type — appears as a bracketed type-argument
    //       (`ArrayIter[T]`) in a param or the return type, so a struct/enum
    //       clone needs its concrete value; AND
    //   (b) it is bindable from a param — appears as a standalone token at
    //       paren-depth 0 in some param type (`xs: T[]`, `b: Box[T]`), the
    //       positions `bind_unify` actually unifies. A `T` reachable only via
    //       the RETURN (`find[T, I](…): Option[T]`) or inside a function-type /
    //       tuple param (`(T) => boolean`) is NOT bindable from the call args,
    //       so promoting it would mint an incomplete instantiation key and the
    //       call site would fail to resolve. `of[T](xs: T[]): ArrayIter[T]`
    //       satisfies both; `find` / `nth` / `count` satisfy neither and stay
    //       erased (as before).
    var ui: i32 = 0;
    while (ui < unbounded_tps.len()) {
        var un: string = unbounded_tps[ui];
        // (a) feeds: a user-parametric type-arg (struct/enum clone needs it) OR a
        //     Map[...] key/value position. The Map case is the IR-codegen sibling
        //     of the struct-clone case: a generic body's map ops read the concrete
        //     key-kind off the param/return type, so an erased `Map[K, V]` would
        //     default to string-key dispatch and miscompile an i32-keyed map
        //     (`from[K, V](pairs: (K, V)[]): Map[K, V]`). #map-generic.
        var feeds: boolean = feeds_user_parametric(ret_type, un) || feeds_map_typearg(ret_type, un);
        var bindable: boolean = false;
        var pj: i32 = 0;
        while (pj < params.len()) {
            if (feeds_user_parametric(params[pj].type_name, un) || feeds_map_typearg(params[pj].type_name, un)) { feeds = true; }
            // (b) bindable: a standalone token at paren-depth 0, OR inside a tuple /
            //     tuple-array param — bind_unify now destructures `(K, V)` parens,
            //     so a `(K, V)[]` param recovers both vars from the call's argument.
            if (token_at_paren_depth0(params[pj].type_name, un) || token_in_tuple_param(params[pj].type_name, un)) { bindable = true; }
            pj = pj + 1;
        }
        // (b′) return-bindable: a param reachable only through the RETURN's
        // user-parametric / Map position (`mk[T](): Box[T]`, `set_new[T]():
        // Set[T]`) is bindable from the call-site ANNOTATION via infer_inst_ret's
        // return-type-directed instantiation (mono_var_init) — the annotated-var
        // context a no-argument generic CONSTRUCTOR is always used in. Without
        // promotion its erased body's generic struct literal (`Box { xs: [] }`)
        // can't lower and drags the module to the AST emitter (std/set's set_new
        // → segfault). Builtin returns (Option[T] / Result[T,E]) are erased-safe
        // and stay unpromoted: feeds_user_parametric excludes their bases, so a
        // `find[T,I](): Option[T]` — bindable from NO call site — is untouched.
        var ret_bindable: boolean = feeds_user_parametric(ret_type, un) || feeds_map_typearg(ret_type, un);
        if (feeds && (bindable || ret_bindable)) { bounded_tps = bounded_tps.append(un); bound_names = bound_names.append(""); }
        ui = ui + 1;
    }
    // A body-less function (`function f(): T;`) is an extern import
    // declaration — the caller's `@import` attribute supplies its WIT binding.
    // Otherwise parse the block body.
    if (p.peek_punct() == ";") {
        p = p.advance();
        // A body-less decl is an `@import` signature — a destructured
        // param has nothing to bind into, so degrade to the empty-name
        // FuncDecl the caller treats as a parse failure.
        if (pd_names.len() > 0) {
            return (FuncDecl { name: "", receiver_name: receiver_name, receiver_type: receiver_type, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: bound_names, fip: false, ret_str: false }, p);
        }
        return (FuncDecl { name: name, receiver_name: receiver_name, receiver_type: receiver_type, type_params: bounded_tps, params: params, ret_type: ret_type, body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", type_param_count: all_tp_count, bound_traits: bound_names, fip: false, ret_str: fn_ret_str }, p);
    }
    var (blk_body, blk_p) = parse_block(p);
    p = blk_p;
    var fbody: Stmt[] = prepend_param_destrs(blk_body, pd_names, pd_synths, pd_lines, pd_cols);
    return (FuncDecl { name: name, receiver_name: receiver_name, receiver_type: receiver_type, type_params: bounded_tps, params: params, ret_type: ret_type, body: fbody, line: fline, col: fcol, import_iface: "", import_wit: "", type_param_count: all_tp_count, bound_traits: bound_names, fip: false, ret_str: fn_ret_str }, p);
}

// parse_module is the entry point that handles both function
// decls and "loose" top-level stmts. Loose stmts are appended to
// `top_stmts` in source order so a runner can use them as a
// fallback entry point when there's no `main` function.
// parse_struct_field consumes `name: type_name` and returns the
// declared field. Same type-name model as parse_param: a bare
// ident, no array / generic syntax for this cut.

function parse_struct_field(p: Par): (StructFieldDecl, Par) {
    var name: string = p.peek_ident();
    if (name.len() == 0) {
        return (StructFieldDecl { name: "", type_name: "", fn_ret: "" }, p);
    }
    p = p.advance();
    if (p.peek_punct() != ":") {
        return (StructFieldDecl { name: name, type_name: "", fn_ret: "" }, p);
    }
    p = p.advance();
    var (sftr_name, sftr_ret_arr, sftr_fn_ret, sftr_p) = parse_type_name(p);
    return (StructFieldDecl { name: name, type_name: sftr_name, fn_ret: sftr_fn_ret }, sftr_p);
}

// parse_struct_decl consumes `struct Name { field, field, … }`
// starting from the `struct` keyword. Fields may be separated
// by `,` or terminated without one (last field's trailing `,`
// is optional). Errors leave the parser at the offending token;
// surrounding parse_module recovers via the StructDecl with
// empty name.

function parse_struct_decl(p: Par): (StructDecl, Par) {
    var sline: i32 = p.peek_line();
    var scol: i32 = p.peek_col();
    p = p.advance();  // consume `struct`
    var name: string = p.peek_ident();
    var notp0: string[] = [];
    if (name.len() == 0) {
        var empty: StructFieldDecl[] = [];
        return (StructDecl { name: "", fields: empty, type_params: notp0, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false }, p);
    }
    p = p.advance();
    // Optional generic type parameters: `struct Box[T] { … }`. Captured
    // so the monomorphiser can clone a concrete struct per instantiation
    // (the field layout is uniform, but the per-instantiation field
    // TYPES drive primitive/string method dispatch).
    var tparams: string[] = [];
    if (p.peek_punct() == "[") {
        p = p.advance(); // consume `[`
        var gd: i32 = 1;
        while (!p.at_end() && gd > 0) {
            var gpk: string = p.peek_punct();
            if (gpk == "[") { gd = gd + 1; p = p.advance(); continue; }
            if (gpk == "]") { gd = gd - 1; p = p.advance(); continue; }
            if (gd == 1) {
                var tpn: string = p.peek_ident();
                if (tpn.len() > 0) { tparams = tparams.append(tpn); }
            }
            p = p.advance();
        }
    }
    if (p.peek_punct() != "{") {
        var empty: StructFieldDecl[] = [];
        return (StructDecl { name: name, fields: empty, type_params: tparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false }, p);
    }
    p = p.advance();
    var fields: StructFieldDecl[] = [];
    if (p.peek_punct() != "}") {
        while (true) {
            var (fr_field, fr_p) = parse_struct_field(p);
            p = fr_p;
            fields = fields.append(fr_field);
            // A trailing comma before `}` must not start another (empty-named)
            // field — mirrors the struct-literal parser and the Go parser.
            if (p.peek_punct() == ",") {
                p = p.advance();
                if (p.peek_punct() == "}") { break; }
                continue;
            }
            break;
        }
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    return (StructDecl { name: name, fields: fields, type_params: tparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false }, p);
}

// parse_type_alias consumes `type Name = V1 | V2 | … ;` starting
// from the `type` keyword. Empty variant lists (`type X = ;`)
// produce an alias with no variants — the checker rejects them,
// but parsing stays lenient so error recovery proceeds. The
// trailing semicolon is consumed if present.

function parse_type_alias(p: Par): (TypeAlias, Par) {
    // E016 (alias name collides with a struct/enum) is reported at the
    // `type` keyword.
    var taline: i32 = p.peek_line();
    var tacol: i32 = p.peek_col();
    p = p.advance();  // consume `type`
    var name: string = p.peek_ident();
    if (name.len() == 0) {
        var empty: string[] = [];
        return (TypeAlias { name: "", variants: empty, line: taline, col: tacol }, p);
    }
    p = p.advance();
    if (p.peek_punct() != "=") {
        var empty2: string[] = [];
        return (TypeAlias { name: name, variants: empty2, line: taline, col: tacol }, p);
    }
    p = p.advance();  // consume `=`
    var variants: string[] = [];
    while (true) {
        var v: string = p.peek_ident();
        if (v.len() == 0) {
            // Allow keyword-style variants too (e.g. `null` if it
            // ever lexes as a keyword); for now fall through to
            // end-of-list handling.
            break;
        }
        p = p.advance();
        variants = variants.append(v);
        if (p.peek_punct() == "|") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (TypeAlias { name: name, variants: variants, line: taline, col: tacol }, p);
}

// parse_enum_decl consumes a Rust-style `enum Name { V1, V2(T), … }`
// starting from the `enum` keyword. Each variant is lowered to a
// StructDecl: a payload-bearing variant `V2(T)` becomes a struct with
// a single marker field `__ev` of the payload type; a no-payload
// variant `V1` becomes a zero-field struct. The marker field is how
// the emitter tells an enum variant (bind the payload at offset 8)
// from a `type X = A|B` union member (bind the whole struct). Only the
// first payload of a multi-payload variant is bound; extras are
// consumed. The enum's own name isn't recorded — variant names are
// global, as with the existing union machinery.

function parse_enum_decl(p: Par): (string, StructDecl[], string[], Par) {
    p = p.advance();  // consume `enum`
    var out: StructDecl[] = [];
    var name: string = p.peek_ident();
    if (name.len() == 0) { return ("", out, [], p); }
    p = p.advance();
    // Optional generic type parameters: `enum Opt[T] { … }`. Captured so the
    // monomorphiser can clone a concrete enum per instantiation (the variant
    // payload TYPES are substituted, like a generic struct's fields). Mirrors
    // the `struct Box[T]` parse above.
    var tparams: string[] = [];
    if (p.peek_punct() == "[") {
        p = p.advance(); // consume `[`
        var gd: i32 = 1;
        while (!p.at_end() && gd > 0) {
            var gpk: string = p.peek_punct();
            if (gpk == "[") { gd = gd + 1; p = p.advance(); continue; }
            if (gpk == "]") { gd = gd - 1; p = p.advance(); continue; }
            if (gd == 1) {
                var tpn: string = p.peek_ident();
                if (tpn.len() > 0) { tparams = tparams.append(tpn); }
            }
            p = p.advance();
        }
    }
    if (p.peek_punct() != "{") { return (name, out, tparams, p); }
    p = p.advance();
    while (p.peek_punct() != "}" && !p.at_end()) {
        var vname: string = p.peek_ident();
        if (vname.len() == 0) { break; }
        p = p.advance();
        var fields: StructFieldDecl[] = [];
        if (p.peek_punct() == "(") {
            p = p.advance();
            var (tr_name, tr_ret_arr, tr_fn_ret, tr_p) = parse_type_name(p);
            p = tr_p;
            // A multi-payload variant `V(A, B, …)` keeps every payload as a field
            // `__ev`, `__ev1`, `__ev2`, … (the first stays `__ev` so the existing
            // "is this a payloaded variant?" checks that look for `__ev` still
            // fire). Codegen indexes them by position (struct_field_off).
            fields = fields.append(StructFieldDecl { name: "__ev", type_name: tr_name, fn_ret: tr_fn_ret });
            var pnum: i32 = 1;
            while (p.peek_punct() == ",") {
                p = p.advance();
                var (tr2_name, tr2_ret_arr, tr2_fn_ret, tr2_p) = parse_type_name(p);
                p = tr2_p;
                fields = fields.append(StructFieldDecl { name: "__ev" + dl_itoa(pnum), type_name: tr2_name, fn_ret: tr2_fn_ret });
                pnum = pnum + 1;
            }
            if (p.peek_punct() == ")") { p = p.advance(); }
        }
        out = out.append(StructDecl { name: vname, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: name, must_consume: false });
        if (p.peek_punct() == ",") { p = p.advance(); continue; }
        break;
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    return (name, out, tparams, p);
}

// parse_import consumes `import "path";` starting from the
// `import` keyword. The path string is captured verbatim; the
// trailing semicolon is consumed when present. Malformed input
// (missing string, etc.) yields an Import with empty path so
// the surrounding loop can recover.

function parse_import(p: Par): (Import, Par) {
    p = p.advance();  // consume `import`
    var path: string = "";
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokString(s) => { path = s.value; p = p.advance(); },
        _ => { }
    }
    // Optional `as <ident>` alias clause (`import "std/io_buffered" as io`): the
    // alias becomes the qualifier for `io.foo` references; flatten maps it back to
    // the module's mangle prefix (basename). An alias equal to the basename is the
    // common, redundant form. `as` is a keyword (peek_keyword, like the cast `x as
    // T`), so it never collides with an identifier.
    var alias: string = "";
    if (p.peek_keyword() == "as") {
        p = p.advance();  // consume `as`
        alias = p.peek_ident();
        if (alias.len() > 0) { p = p.advance(); }
    }
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (Import { path: path, is_reexport: false, reexport_names: [], alias: alias }, p);
}

// parse_pubuse consumes `use "path".{name1, name2, …};` (cursor on the
// `use` keyword; a leading `pub` is stripped by the caller). It returns
// an Import flagged `is_reexport` carrying the re-exported names, so the
// loader pulls in the target module and the bundler can redirect a
// consumer's `facade.name` to the target's mangled symbol. Malformed
// input degrades to an empty re-export the caller can recover from.
function parse_pubuse(p: Par): (Import, Par) {
    p = p.advance();  // consume `use`
    var path: string = "";
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokString(s) => { path = s.value; p = p.advance(); },
        _ => { }
    }
    if (p.peek_punct() == ".") { p = p.advance(); }
    var names: string[] = [];
    if (p.peek_punct() == "{") {
        p = p.advance();
        while (!p.at_end() && p.peek_punct() != "}") {
            var nm: string = p.peek_ident();
            if (nm.len() > 0) { names = names.append(nm); p = p.advance(); }
            if (p.peek_punct() == ",") { p = p.advance(); continue; }
            if (p.peek_punct() == "}") { continue; }
            // Unexpected token — bail to avoid spinning.
            if (nm.len() == 0) { p = p.advance(); }
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
    }
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (Import { path: path, is_reexport: true, reexport_names: names, alias: "" }, p);
}

// parse_const_decl consumes `const NAME[: T] = EXPR;` (cursor on the
// `const` keyword) and returns it as a zero-arg FuncDecl returning
// EXPR — so the rest of the pipeline + the emitter reuse the existing
// function machinery, and a bare `NAME` reference becomes a call.
function parse_const_decl(p: Par): (FuncDecl, Par) {
    p = p.advance();  // consume `const`
    var name: string = p.peek_ident();
    if (name.len() == 0) { name = p.peek_keyword(); }
    if (name.len() > 0) { p = p.advance(); }
    var ty: string = "";
    if (p.peek_punct() == ":") {
        p = p.advance();
        var (tr_name, tr_ret_arr, tr_fn_ret, tr_p) = parse_type_name(p);
        p = tr_p;
        ty = tr_name;
    }
    if (p.peek_punct() == "=") { p = p.advance(); }
    var (er_expr, er_p) = parse_expr(p);
    p = er_p;
    if (p.peek_punct() == ";") { p = p.advance(); }
    var body: Stmt[] = [];
    body = body.append(s_return(er_expr));
    var noparams: ParamDecl[] = [];
    var notp: string[] = [];
    return (FuncDecl { name: name, receiver_name: "", receiver_type: "", type_params: notp, params: noparams, ret_type: ty, body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false }, p);
}

// struct_declared reports whether `structs` already contains a struct
// (or synthesized enum variant) with the given name.
function struct_declared(structs: StructDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

// add_builtin_variant appends a synthesized enum-variant struct (a
// payload variant carries the marker field "__ev"; a no-payload variant
// has zero fields — same lowering as parse_enum_decl) unless a struct of
// that name is already declared.
function add_builtin_variant(acc: StructDecl[], name: string, payload_type: string, enum_name: string): StructDecl[] {
    if (struct_declared(acc, name)) { return acc; }
    var fields: StructFieldDecl[] = [];
    if (payload_type.len() > 0) {
        fields = fields.append(StructFieldDecl { name: "__ev", type_name: payload_type, fn_ret: "" });
    }
    return acc.append(StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: enum_name, must_consume: false });
}

// inject_builtin_enums adds the variant structs for the enums the
// reference front-end auto-injects — JsonValue and IoError — unless the
// program already declares them. This is the self-host analogue of the
// checker's builtinEnumDecls: it lets programs use `std/json`
// (JString(x), match … JObject(m) …) and IoError without a local enum
// declaration. Option / Result are handled separately (Some/Ok/None/Err
// are special-cased in the emitter).
pub function inject_builtin_enums(structs: StructDecl[]): StructDecl[] {
    structs = add_builtin_variant(structs, "JNull", "", "JsonValue");
    structs = add_builtin_variant(structs, "JBool", "boolean", "JsonValue");
    structs = add_builtin_variant(structs, "JNumber", "string", "JsonValue");
    structs = add_builtin_variant(structs, "JString", "string", "JsonValue");
    structs = add_builtin_variant(structs, "JArray", "JsonValue[]", "JsonValue");
    structs = add_builtin_variant(structs, "JObject", "Map[string, JsonValue]", "JsonValue");
    structs = add_builtin_variant(structs, "NotFound", "string", "IoError");
    structs = add_builtin_variant(structs, "PermissionDenied", "string", "IoError");
    structs = add_builtin_variant(structs, "AlreadyExists", "string", "IoError");
    structs = add_builtin_variant(structs, "InvalidUtf8", "string", "IoError");
    structs = add_builtin_variant(structs, "Interrupted", "", "IoError");
    structs = add_builtin_variant(structs, "Unsupported", "", "IoError");
    // Other carries TWO payloads (path, message) like native's declaration
    // (#4370) — open-coded because add_builtin_variant takes one payload.
    // Field naming matches the user-enum desugar: `__ev`, `__ev1`.
    if (!struct_declared(structs, "Other")) {
        var otf: StructFieldDecl[] = [];
        otf = otf.append(StructFieldDecl { name: "__ev", type_name: "string", fn_ret: "" });
        otf = otf.append(StructFieldDecl { name: "__ev1", type_name: "string", fn_ret: "" });
        structs = structs.append(StructDecl { name: "Other", fields: otf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "IoError", must_consume: false });
    }
    // FileStat: the builtin struct returned by stat(path). Injected so
    // the emitter knows its field layout ([shape, is_file@8, is_dir@16,
    // size@24]) — the __fern_stat runtime helper builds a struct whose
    // shape pointer is the interned "FileStat" name, matching the arm
    // that field access emits for is_file / is_dir / size.
    if (!struct_declared(structs, "FileStat")) {
        var fsf: StructFieldDecl[] = [];
        fsf = fsf.append(StructFieldDecl { name: "is_file", type_name: "boolean", fn_ret: "" });
        fsf = fsf.append(StructFieldDecl { name: "is_dir", type_name: "boolean", fn_ret: "" });
        fsf = fsf.append(StructFieldDecl { name: "size", type_name: "i64", fn_ret: "" });
        structs = structs.append(StructDecl { name: "FileStat", fields: fsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    // ProcessResult — returned by `subprocess(cmd, args, stdin)`.
    // Same injection pattern as FileStat: the __fern_subprocess
    // runtime helper builds a struct whose shape pointer is the
    // interned "ProcessResult" name, and the emitter resolves
    // `r.stdout` / `r.stderr` / `r.exit_code` to slot offsets from
    // this decl.
    if (!struct_declared(structs, "ProcessResult")) {
        var prf: StructFieldDecl[] = [];
        prf = prf.append(StructFieldDecl { name: "stdout", type_name: "string", fn_ret: "" });
        prf = prf.append(StructFieldDecl { name: "stderr", type_name: "string", fn_ret: "" });
        prf = prf.append(StructFieldDecl { name: "exit_code", type_name: "i32", fn_ret: "" });
        structs = structs.append(StructDecl { name: "ProcessResult", fields: prf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    // std/headers' HeaderMap + std/http's HttpRequest / HttpResponse
    // are constructed via record literals (e.g. `HeaderMap { names: …,
    // values: … }`) but the stdlib files don't carry an explicit
    // `struct` declaration — the Go-side checker infers the shape
    // from usage, but the self-host's shape-pointer dispatch needs
    // the declaration to resolve field offsets. Adding the decls to
    // the stdlib files would tip the Go checker into "treat methods
    // as fields" mode (so e.g. `h.get_all(…)` no longer resolves to
    // the receiver method). Inject them at the self-host's table
    // instead so the Go side stays untouched.
    if (!struct_declared(structs, "HeaderMap")) {
        var hmf: StructFieldDecl[] = [];
        hmf = hmf.append(StructFieldDecl { name: "names", type_name: "string[]", fn_ret: "" });
        hmf = hmf.append(StructFieldDecl { name: "values", type_name: "string[]", fn_ret: "" });
        structs = structs.append(StructDecl { name: "HeaderMap", fields: hmf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    if (!struct_declared(structs, "HttpRequest")) {
        var hrf: StructFieldDecl[] = [];
        hrf = hrf.append(StructFieldDecl { name: "method", type_name: "string", fn_ret: "" });
        hrf = hrf.append(StructFieldDecl { name: "path", type_name: "string", fn_ret: "" });
        hrf = hrf.append(StructFieldDecl { name: "body", type_name: "string", fn_ret: "" });
        hrf = hrf.append(StructFieldDecl { name: "headers", type_name: "HeaderMap", fn_ret: "" });
        structs = structs.append(StructDecl { name: "HttpRequest", fields: hrf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    if (!struct_declared(structs, "HttpResponse")) {
        var hsf: StructFieldDecl[] = [];
        hsf = hsf.append(StructFieldDecl { name: "status", type_name: "i32", fn_ret: "" });
        hsf = hsf.append(StructFieldDecl { name: "body", type_name: "string", fn_ret: "" });
        hsf = hsf.append(StructFieldDecl { name: "headers", type_name: "HeaderMap", fn_ret: "" });
        structs = structs.append(StructDecl { name: "HttpResponse", fields: hsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    // std/time's seven date/time types are compiler built-ins (registered in
    // the Go checker, not `struct`-declared in std/time), so the self-host's
    // shape-pointer dispatch + field-offset resolution need their layouts here
    // — the same pattern as FileStat / HeaderMap above. Field lists mirror
    // internal/checker/checker.go's registration exactly. All are leaf-safe
    // (scalar / string / nested leaf-safe struct fields), so their constructors
    // (date_make / span_days / …) and field reads lower on the IR path.
    structs = add_builtin_struct2(structs, "Instant", "sec", "i64", "nsec", "i32");
    structs = add_builtin_struct2(structs, "Duration", "sec", "i64", "nsec", "i32");
    structs = add_builtin_struct2(structs, "TimeZone", "name", "string", "offset_seconds", "i32");
    structs = add_builtin_struct2(structs, "DateTime", "date", "Date", "time", "Time");
    structs = add_builtin_struct2(structs, "Zoned", "instant", "Instant", "zone", "TimeZone");
    if (!struct_declared(structs, "Date")) {
        var df: StructFieldDecl[] = [];
        df = df.append(StructFieldDecl { name: "year", type_name: "i32", fn_ret: "" });
        df = df.append(StructFieldDecl { name: "month", type_name: "i32", fn_ret: "" });
        df = df.append(StructFieldDecl { name: "day", type_name: "i32", fn_ret: "" });
        structs = structs.append(StructDecl { name: "Date", fields: df, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    if (!struct_declared(structs, "Time")) {
        var tf: StructFieldDecl[] = [];
        tf = tf.append(StructFieldDecl { name: "hour", type_name: "i32", fn_ret: "" });
        tf = tf.append(StructFieldDecl { name: "minute", type_name: "i32", fn_ret: "" });
        tf = tf.append(StructFieldDecl { name: "second", type_name: "i32", fn_ret: "" });
        tf = tf.append(StructFieldDecl { name: "nsec", type_name: "i32", fn_ret: "" });
        structs = structs.append(StructDecl { name: "Time", fields: tf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    if (!struct_declared(structs, "Span")) {
        var spf: StructFieldDecl[] = [];
        spf = spf.append(StructFieldDecl { name: "years", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "months", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "weeks", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "days", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "hours", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "minutes", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "seconds", type_name: "i32", fn_ret: "" });
        spf = spf.append(StructFieldDecl { name: "nanos", type_name: "i32", fn_ret: "" });
        structs = structs.append(StructDecl { name: "Span", fields: spf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    // std/io_buffered + std/stream + std/mock_platform built-ins (registered
    // in the Go checker, not `struct`-declared in source) — same injection
    // pattern as the time types. Field lists mirror checker.go exactly:
    //   Stream       { data: u8[], pos: i32 }       — byte cursor reader
    //   BytesWriter  { data: u8[] }                 — in-memory write buffer
    //   MockCall     { name: string, args: string } — recorded call entry
    //   MockPlatform { calls: MockCall[] }           — call-recording mock
    // Stream / BytesWriter carry a sub-word (u8[]) array field, now leak-safe
    // (is_leaksafe_array_field), so their constructors / methods lower on the
    // IR path. MockPlatform's `calls: MockCall[]` is an array-of-leaf-struct
    // field (leak mode). MockCall is two strings (leaf-safe).
    structs = add_builtin_struct2(structs, "MockCall", "name", "string", "args", "string");
    structs = add_builtin_struct2(structs, "Stream", "data", "u8[]", "pos", "i32");
    if (!struct_declared(structs, "BytesWriter")) {
        var bwf: StructFieldDecl[] = [];
        bwf = bwf.append(StructFieldDecl { name: "data", type_name: "u8[]", fn_ret: "" });
        structs = structs.append(StructDecl { name: "BytesWriter", fields: bwf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    if (!struct_declared(structs, "MockPlatform")) {
        var mpf: StructFieldDecl[] = [];
        mpf = mpf.append(StructFieldDecl { name: "calls", type_name: "MockCall[]", fn_ret: "" });
        structs = structs.append(StructDecl { name: "MockPlatform", fields: mpf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    // std/url's Url is a compiler built-in (registered in the Go checker, not
    // `struct`-declared in std/url), so the IR path needs its layout to lower
    // `Url { … }` construction / field reads — the same pattern as Stream /
    // BytesWriter / the time types. Fields mirror internal/checker/checker.go
    // exactly; all scalar/string, so leaf-safe (url_parse's Url-spread builder
    // and `Option[Url]` return lower).
    if (!struct_declared(structs, "Url")) {
        var urlf: StructFieldDecl[] = [];
        urlf = urlf.append(StructFieldDecl { name: "scheme", type_name: "string", fn_ret: "" });
        urlf = urlf.append(StructFieldDecl { name: "host", type_name: "string", fn_ret: "" });
        urlf = urlf.append(StructFieldDecl { name: "port", type_name: "i32", fn_ret: "" });
        urlf = urlf.append(StructFieldDecl { name: "path", type_name: "string", fn_ret: "" });
        urlf = urlf.append(StructFieldDecl { name: "query", type_name: "string", fn_ret: "" });
        urlf = urlf.append(StructFieldDecl { name: "fragment", type_name: "string", fn_ret: "" });
        structs = structs.append(StructDecl { name: "Url", fields: urlf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
    }
    return structs;
}

// add_builtin_struct2 injects a 2-field built-in struct (guarded by name) —
// the common shape for the injected time types (sec/nsec, name/offset, …).
function add_builtin_struct2(structs: StructDecl[], name: string, f0: string, t0: string, f1: string, t1: string): StructDecl[] {
    if (struct_declared(structs, name)) { return structs; }
    var fields: StructFieldDecl[] = [];
    fields = fields.append(StructFieldDecl { name: f0, type_name: t0, fn_ret: "" });
    fields = fields.append(StructFieldDecl { name: f1, type_name: t1, fn_ret: "" });
    return structs.append(StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false });
}

// module_with_builtins returns `mod` with the auto-injected builtin
// enum variants (JsonValue / IoError) merged into its struct table.
// Compilation drivers call this before emit; emit_module itself stays
// pure so the asm self-test (which calls emit_module directly and is
// compiled to native code) doesn't carry the injection path.
// ---------------------------------------------------------------
// Monomorphisation of trait-bounded generics.
//
// The self-host erases unbounded generics (uniform 8-byte ABI) and
// dispatches `obj.method()` dynamically by a shape pointer read off the
// receiver — which heap values carry but unboxed primitives do not. A
// BOUNDED generic (`f[T: Eq](a: T, …)`) calls trait methods on a
// `T`-typed value, so when T is a primitive the dynamic dispatch reads
// garbage and crashes. The fix: clone the bounded generic per concrete
// call-site type so the receiver's STATIC type is concrete and routes
// through the emitter's working static-primitive dispatch. No emitter
// change is needed (see docs/TRAITS.md §7a).
//
// monomorphize_module (called by module_with_builtins) walks every
// non-generic body + the top stmts, rewrites each call to a bounded
// generic `f(args)` to a mangled `f__<concretetype>(args)` (concrete
// type inferred from the argument bound to the type variable), collects
// the needed instantiations, then clones each bounded generic per
// instantiation with the type variable substituted. A worklist handles
// clones that themselves call bounded generics.

// MEnv is a tiny var-name -> type-name environment for inference.
struct MEnv { mnames: string[], mtypes: string[] }
function (e: MEnv) ebind(n: string, t: string): MEnv {
    return MEnv { mnames: e.mnames.append(n), mtypes: e.mtypes.append(t) };
}
function (e: MEnv) elook(n: string): string {
    var i: i32 = e.mnames.len() - 1;
    while (i >= 0) {
        if (e.mnames[i] == n) { return e.mtypes[i]; }
        i = i - 1;
    }
    return "";
}

// Insts accumulates the unique (bounded-generic name, concrete type)
// instantiations discovered while rewriting call sites.
// Insts records generic instantiations as three parallel arrays: the base
// name, the mangled `__`-key (used to build clone symbol names), and `iargs`
// — the ORIGINAL single-type-arg spelling for a single-param enum. iargs
// exists because a composite (fn) arg mangles LOSSILY (`(i32) => i32` →
// sanitized `_i32_____i32`), so phase-2 field substitution can't recover the
// real field type from the key alone; it reads iargs instead. For a nominal /
// nested-enum key, iargs carries the original spelling too, but `me_rewrite_ty`
// re-derives the identical mangled field type either way (`Opt[i32]` → `Opt__i32`
// == the key), so those stay byte-identical. Non-enum callers use the default
// `iadd` (iargs = the key), which phase-2 enum cloning never reads.
struct Insts { inames: string[], itypes: string[], iargs: string[] }
function (a: Insts) ihas(n: string, t: string): boolean {
    var i: i32 = 0;
    while (i < a.inames.len()) {
        if (a.inames[i] == n && a.itypes[i] == t) { return true; }
        i = i + 1;
    }
    return false;
}
function (a: Insts) iadd(n: string, t: string): Insts {
    if (a.ihas(n, t)) { return a; }
    return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(t) };
}
// iadd_arg records an instantiation together with the original single-arg
// spelling `arg` (phase-2 field substitution reads it for a fn-keyed clone).
// Enum-collection sites use this; the default `iadd` sets iargs = key.
function (a: Insts) iadd_arg(n: string, t: string, arg: string): Insts {
    if (a.ihas(n, t)) { return a; }
    return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(arg) };
}
// ihas_other reports whether `n` is already recorded at a DIFFERENT
// concrete type than `t`. The array-method path uses this to keep a
// generic array method on a single element type per program: a second
// distinct element type leaves the `recv.m(args)` call in method form
// (→ AST), avoiding a pre-existing self-host crash that lowering a
// 2-param array helper (`concat`) at two element types triggers.
function (a: Insts) ihas_other(n: string, t: string): boolean {
    var i: i32 = 0;
    while (i < a.inames.len()) {
        if (a.inames[i] == n && a.itypes[i] != t) { return true; }
        i = i + 1;
    }
    return false;
}

struct RExpr { rexpr: Expr, rins: Insts }
struct RStmtOne { rstmt: Stmt, renv: MEnv, rins2: Insts }
struct RStmts { rstmts: Stmt[], rins3: Insts }

// arrm_has_bare_elem_param reports whether a folded generic array method
// `__arrm_m[T]` takes a BARE value param of the element type (`sep: T` in
// `intersperse`, `x: T` in `push`) — its element var is type_params[0]. Such a
// method's AST fallback miscompiles a 16-byte value (`string`), so unlike
// `concat` / `reverse` (only `T[]` params) it must ride the per-element-type
// free-generic clone at EVERY element type, not just the first. Gates the
// ihas_other single-element-type restriction below.
function arrm_has_bare_elem_param(fd: FuncDecl): boolean {
    if (fd.type_params.len() == 0) { return false; }
    var ev: string = fd.type_params[0];
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (fd.params[i].type_name == ev) { return true; }
        i = i + 1;
    }
    return false;
}

// bg_index returns the index in `funcs` of a bounded-generic function
// named `name` (type_params non-empty, plain function), or -1.
function bg_index(funcs: FuncDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].type_params.len() > 0) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// tparam_arg_index returns the index of the first parameter whose
// declared type is the (first) type variable — the argument whose
// concrete type fixes the instantiation. -1 if none.
function tparam_arg_index(fd: FuncDecl): i32 {
    if (fd.type_params.len() == 0) { return 0 - 1; }
    var tp: string = fd.type_params[0];
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (fd.params[i].type_name == tp) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// tp_index returns the position of `name` in `tparams`, or -1.
function tp_index(name: string, tparams: string[]): i32 {
    var i: i32 = 0;
    while (i < tparams.len()) {
        if (tparams[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// type_ends_arr reports whether a type string ends with the `[]`
// array suffix.
function type_ends_arr(s: string): boolean {
    if (s.len() < 2) { return false; }
    return s[s.len() - 2 : s.len()] == "[]";
}

// first_bracket returns the index of the first `[` in `s`, or -1.
function first_bracket(s: string): i32 {
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i : i + 1] == "[") { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// split_top_commas splits a generic-arg inner string (e.g. `K, V` or
// `string, Map[a, b]`) on top-level commas, tracking `[]`/`()` depth so a
// comma nested inside `Map[...]` or a tuple doesn't split early. A comma's
// single following space (the canonical `, ` spelling) is consumed when
// present, but a BARE `,` splits too: irlower's compact tuple element tags
// (`(clo,i32)`, elem_type_tag's nested-tuple arm) join without the space,
// and requiring it made parse_type_ref read `(clo,i32)` as a ONE-element
// tuple — so tuple_type_elem_tag returned "clo,i32", the `t.K.N(args)` /
// `arr[i].N(args)` closure-element dispatch missed its "clo" tag, and the
// call fell through to bogus method dispatch (`i32.0`), bailing the module
// to the legacy AST path (which miscompiles those shapes).
function split_top_commas(s: string): string[] {
    var out: string[] = [];
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        var c: str = s[i : i + 1];
        if (c == "[" || c == "(") { depth = depth + 1; }
        if (c == "]" || c == ")") { depth = depth - 1; }
        if (depth == 0 && c == ",") {
            out = out.append(s[start : i]);
            i = i + 1;
            if (i < s.len() && s[i : i + 1] == " ") { i = i + 1; }
            start = i;
            continue;
        }
        i = i + 1;
    }
    out = out.append(s[start : s.len()]);
    return out;
}

// ---------------------------------------------------------------------------
// Structured type references (SH-021, foundation slice — unblocks #4394 lever 1).
//
// Types are carried through the self-host compiler as flat STRINGS ("i32",
// "Map[string, i32]", "Option[(string, string)]", "i32[]", …) that a dozen
// downstream sites re-decode by hand — depth-tracking byte scans keyed on exact
// separators ("[", "]", "(", ", "), off-by-one bracket surgery, and unsound
// "names never contain X" assumptions (asmcore ty_from_name / split_tuple_ret /
// tuple_ret_tag_at, checker's six type_from_name* resolvers, wasm). Each is a
// fresh chance to mis-read a nested generic or tuple.
//
// TypeRef is the structured form those scans should target instead: parse the
// string ONCE into a tree, then pattern-match on it. This slice adds the type
// plus the canonical parse/render pair (round-trip: render_type_ref(parse_type_ref
// s) == s for every canonical type spelling); later slices retarget each
// byte-scanning consumer onto parse_type_ref, and eventually the parser produces
// TypeRef directly so the string becomes render output rather than the source of
// truth. See docs/SELF-HOST-AUDIT.md T2.
//
//   base        — the head name: "i32" / "Foo" / "mod.Bar" for a scalar or named
//                 type; the constructor ("Map" / "Option" / "Result" / …) for a
//                 generic; "" for a tuple.
//   args        — the generic arguments ("Map[K, V]" → [K, V]) or the tuple
//                 element types ("(a, b)" → [a, b]); empty for a plain name.
//   array_depth — the number of trailing "[]" suffixes ("i32[][]" → 2), applied
//                 outside base/args so "(a, b)[]" and "Map[i32][]" round-trip.
//   is_tuple    — true for "(…)" tuples (base is "", args are the elements),
//                 distinguishing them from a "Name[…]" generic at render time.
//
// Function types ("(…) => R"), `dyn`/`own`/`borrow` handles etc. are already
// coarsed to opaque spellings ("fn", "dyn Shape", "own R") by parse_type_name, so
// TypeRef treats them as opaque named bases (a trailing "[]" still peels off,
// e.g. "dyn Shape[]"); it is not a source-syntax type parser.
pub struct TypeRef { base: string, args: TypeRef[], array_depth: i32, is_tuple: boolean }

// parse_type_ref decodes a canonical type spelling into a TypeRef tree. It is the
// single place the "[]" / "(…)" / "Name[…]" / ", " grammar is scanned; every
// other decoder should call this rather than re-implement the depth tracking.
pub function parse_type_ref(sin: string): TypeRef {
    var s: string = sin;
    var depth: i32 = 0;
    // Peel trailing array suffixes. A literal empty "[]" at the end is
    // unambiguously an array marker: a generic's brackets always enclose
    // content ("Map[…]") and a tuple ends with ")", so neither ends in "[]".
    while (s.len() >= 2 && s[s.len() - 2] == 91 && s[s.len() - 1] == 93) {
        depth = depth + 1;
        s = s[0 : s.len() - 2] + "";
    }
    // Tuple "(…)": base "", args are the (recursively parsed) elements.
    if (s.len() >= 2 && s[0] == 40 && s[s.len() - 1] == 41) {
        var tsegs: string[] = split_top_commas(s[1 : s.len() - 1]);
        var targs: TypeRef[] = [];
        var ti: i32 = 0;
        while (ti < tsegs.len()) { targs = targs.append(parse_type_ref(tsegs[ti])); ti = ti + 1; }
        return TypeRef { base: "", args: targs, array_depth: depth, is_tuple: true };
    }
    // Generic "Name[…]": base is the head before the first top-level "[", args
    // are the bracketed, comma-split arguments. (After the array peel above the
    // last char is the generic's own "]".)
    var lb: i32 = 0 - 1;
    var j: i32 = 0;
    while (j < s.len()) {
        if (s[j] == 91) { lb = j; j = s.len(); } else { j = j + 1; }
    }
    if (lb >= 0 && s.len() > 0 && s[s.len() - 1] == 93) {
        var gsegs: string[] = split_top_commas(s[lb + 1 : s.len() - 1]);
        var gargs: TypeRef[] = [];
        var gi: i32 = 0;
        while (gi < gsegs.len()) { gargs = gargs.append(parse_type_ref(gsegs[gi])); gi = gi + 1; }
        return TypeRef { base: s[0 : lb] + "", args: gargs, array_depth: depth, is_tuple: false };
    }
    // Plain scalar / named type (incl. opaque "dyn …" / "own …" spellings).
    return TypeRef { base: s, args: [], array_depth: depth, is_tuple: false };
}

// render_type_ref is the inverse of parse_type_ref: it reproduces the canonical
// spelling, so render_type_ref(parse_type_ref(s)) == s for every canonical s.
pub function render_type_ref(t: TypeRef): string {
    var inner: string = "";
    if (t.is_tuple) {
        inner = "(";
        var i: i32 = 0;
        while (i < t.args.len()) {
            if (i > 0) { inner = inner + ", "; }
            inner = inner + render_type_ref(t.args[i]);
            i = i + 1;
        }
        inner = inner + ")";
    } else if (t.args.len() > 0) {
        inner = t.base + "[";
        var k: i32 = 0;
        while (k < t.args.len()) {
            if (k > 0) { inner = inner + ", "; }
            inner = inner + render_type_ref(t.args[k]);
            k = k + 1;
        }
        inner = inner + "]";
    } else {
        inner = t.base;
    }
    var d: i32 = 0;
    while (d < t.array_depth) { inner = inner + "[]"; d = d + 1; }
    return inner;
}

// split_dunder splits a joined instantiation key like `i32__string`
// into its per-type-parameter concrete pieces. Concrete type names
// never contain `__`, so a literal scan is unambiguous.
function split_dunder(s: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i + 1 < s.len()) {
        if (s[i : i + 2] == "__") {
            out = out.append(s[start : i]);
            i = i + 2;
            start = i;
            continue;
        }
        i = i + 1;
    }
    out = out.append(s[start : s.len()]);
    return out;
}

// sanitize_key turns a (possibly composite) instantiation key into a symbol-
// safe mangled suffix: a generic-enum type argument carries brackets / commas
// (`Box[Opt[i32]]`'s key is `Opt[i32]`), which can't appear in a struct clone's
// name. Rewrite `[` and `,` to the `__` separator and drop `]` / spaces, so
// `Opt[i32]` → `Opt__i32` and `Pair[i32, string]` → `Pair__i32__string`. A key
// that is already bracket-free (every existing case — a primitive, a bare
// struct, or a nested struct clone like `Box__i32`) passes through unchanged, so
// this is a no-op on the pre-existing instantiations and only reshapes the
// generic-struct-of-generic-enum combo (#3694). The raw bracketed key is kept
// for field-type SUBSTITUTION (so the enum pass still sees `Opt[i32]` to clone);
// only the emitted NAME is sanitized.
function sanitize_key(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var ch: i32 = s[i];
        if (ch == 91) { out = out + "__"; }         // '[' -> __
        else if (ch == 93) { }                       // ']' -> drop
        else if (ch == 44) { out = out + "__"; }    // ',' -> __
        else if (ch == 59) { out = out + "__"; }    // ';' (multi-param key sep) -> __
        else if (ch == 32) { }                       // ' ' -> drop
        else { out = out + s[i : i + 1]; }
        i = i + 1;
    }
    return out;
}

// bind_unify matches a parameter-type pattern against the argument's
// inferred concrete type, recording a binding for each type variable it
// pins down. Handles a bare variable (`T` ⊢ i32), an array element
// (`T[]` vs `i32[]` ⊢ T=i32), and a same-base composite of equal arity
// (`Map[K, V]` vs `Map[i32, string]` ⊢ K=i32, V=string). First binding
// for a variable wins (so a later opaque argument can't clobber it).
function bind_unify(pattern: string, concrete: string, tparams: string[], binds: MEnv): MEnv {
    if (tp_index(pattern, tparams) >= 0) {
        if (binds.elook(pattern).len() == 0 && concrete.len() > 0) {
            return binds.ebind(pattern, concrete);
        }
        return binds;
    }
    if (type_ends_arr(pattern) && type_ends_arr(concrete)) {
        return bind_unify(pattern[0 : pattern.len() - 2], concrete[0 : concrete.len() - 2], tparams, binds);
    }
    // Tuple pattern `(K, V)` vs `(i32, i32)` — destructure the parens and unify
    // pairwise, so a tuple (or tuple-array, via the array case above) parameter
    // recovers its element type vars. first_bracket only finds `[`, so without
    // this a tuple param's vars never bind (`from[K,V](pairs: (K,V)[])`).
    if (pattern.len() >= 2 && pattern[0:1] == "(" && pattern[pattern.len() - 1 : pattern.len()] == ")"
            && concrete.len() >= 2 && concrete[0:1] == "(" && concrete[concrete.len() - 1 : concrete.len()] == ")") {
        var tpparts: string[] = split_top_commas(pattern[1 : pattern.len() - 1]);
        var tcparts: string[] = split_top_commas(concrete[1 : concrete.len() - 1]);
        if (tpparts.len() == tcparts.len()) {
            var tb: MEnv = binds;
            var tj: i32 = 0;
            while (tj < tpparts.len()) {
                tb = bind_unify(tpparts[tj], tcparts[tj], tparams, tb);
                tj = tj + 1;
            }
            return tb;
        }
    }
    var pb: i32 = first_bracket(pattern);
    var cb: i32 = first_bracket(concrete);
    if (pb > 0 && cb > 0 && pattern[pattern.len() - 1 : pattern.len()] == "]" && concrete[concrete.len() - 1 : concrete.len()] == "]") {
        if (pattern[0 : pb] == concrete[0 : cb]) {
            var pparts: string[] = split_top_commas(pattern[pb + 1 : pattern.len() - 1]);
            var cparts: string[] = split_top_commas(concrete[cb + 1 : concrete.len() - 1]);
            if (pparts.len() == cparts.len()) {
                var b: MEnv = binds;
                var j: i32 = 0;
                while (j < pparts.len()) {
                    b = bind_unify(pparts[j], cparts[j], tparams, b);
                    j = j + 1;
                }
                return b;
            }
        }
    }
    // The pattern is a generic instantiation (`Box[U]`) but the concrete is its
    // already-MANGLED clone name (`Box__i32`) — a nested generic value whose
    // literal was rewritten before this key inference (a generic struct/enum
    // field of another generic struct). Recover the concrete's type args from
    // the `__`-mangled key and unify. A single-param pattern takes the whole
    // key as one arg (it may itself be a mangled nested clone); a multi-param
    // pattern splits unambiguously.
    if (pb > 0 && pattern[pattern.len() - 1 : pattern.len()] == "]" && cb < 0) {
        var pbase: str = pattern[0 : pb];
        var mpfx: string = pbase + "__";
        if (concrete.len() > mpfx.len() && concrete[0 : mpfx.len()] == mpfx) {
            var pp: string[] = split_top_commas(pattern[pb + 1 : pattern.len() - 1]);
            var ckey: str = concrete[mpfx.len() : concrete.len()];
            var cp: string[] = [ckey];
            if (pp.len() != 1) { cp = split_dunder(ckey); }
            if (pp.len() == cp.len()) {
                var b2: MEnv = binds;
                var j2: i32 = 0;
                while (j2 < pp.len()) {
                    b2 = bind_unify(pp[j2], cp[j2], tparams, b2);
                    j2 = j2 + 1;
                }
                return b2;
            }
        }
    }
    return binds;
}

// lambda_ret_of returns the concrete return type of a lambda ARGUMENT —
// what lets a type parameter that appears ONLY in a fn-param's return
// position (`key: (T) => K`) be bound from the closure passed for it.
// The coarse "fn" tag on the param carries no args, so bind_unify over
// the param's type_name never sees `K`; the return spelling is recovered
// here instead. Prefers the lambda's explicit `: R` annotation; for an
// arrow / `use_infer` lambda with no annotation, infers R from the first
// `return` in the body, typed under an env extended with the lambda's
// own (declared) params. "" for a non-lambda arg or an unknown body type
// — the call then stays generic exactly as before.
function lambda_ret_of(e: Expr, env: MEnv, funcs: FuncDecl[]): string {
    match (e) {
        ExprLambda(lm) => {
            if (lm.ret_type.len() > 0) { return lm.ret_type; }
            var lenv: MEnv = env;
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                lenv = lenv.ebind(lm.params[pi].name, lm.params[pi].type_name);
                pi = pi + 1;
            }
            var si: i32 = 0;
            while (si < lm.body.len()) {
                match (lm.body[si]) {
                    StmtReturn(r) => { return mono_infer(r.value, lenv, funcs); },
                    _ => {},
                }
                si = si + 1;
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// infer_inst infers the concrete instantiation of `fd`'s type
// parameters from a call's arguments and returns them joined by `__` in
// declaration order (e.g. `i32`, or `i32__string` for `Map[K, V]`).
// Every argument contributes its bindings via bind_unify (so
// `assert_eq(x.to_upper(), "Y")` still resolves via the literal second
// argument when the first is opaque, and `Map[K, V]` recovers both K
// and V from a single map argument). A type parameter that surfaces only
// as a fn-param's RETURN (`sort_key[T, K: Ord](xs, key: (T) => K)`) is
// bound from that argument's `lambda_ret_of` — otherwise `K` stays
// unbound, the key is "", and the whole template is dropped (an
// undefined-reference link error). Returns "" if any type parameter is
// left unbound — the call then stays generic.
function infer_inst(fd: FuncDecl, args: Expr[], env: MEnv, funcs: FuncDecl[]): string {
    if (fd.type_params.len() == 0) { return ""; }
    var binds: MEnv = MEnv { mnames: [], mtypes: [] };
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (i < args.len()) {
            var ct: string = mono_infer(args[i], env, funcs);
            if (ct.len() > 0) {
                binds = bind_unify(fd.params[i].type_name, ct, fd.type_params, binds);
            }
            // A type param appearing ONLY in a fn-param's return position
            // (`key: (T) => K`) is invisible to the type_name unify above —
            // the coarse "fn" tag carries no args. Recover it from the
            // closure argument's own return type (kept in fd.params[i].fn_ret).
            if (fd.params[i].type_name == "fn" && tp_index(fd.params[i].fn_ret, fd.type_params) >= 0) {
                var lr: string = lambda_ret_of(args[i], env, funcs);
                if (lr.len() > 0) {
                    binds = bind_unify(fd.params[i].fn_ret, lr, fd.type_params, binds);
                }
            }
        }
        i = i + 1;
    }
    return binds_to_key(fd.type_params, binds);
}

// binds_to_key joins a resolved binding env into the ';'-separated
// instantiation key infer_inst returns, or "" if any type param is unbound.
function binds_to_key(tparams: string[], binds: MEnv): string {
    var key: string = "";
    var j: i32 = 0;
    while (j < tparams.len()) {
        var b: string = binds.elook(tparams[j]);
        if (b.len() == 0) { return ""; }
        // Join multi-param instantiation keys with ';' (a char that never
        // appears in a type name) rather than '__': a per-param value can
        // itself be a module-mangled type (`iter__ArrayIter[i32]`) whose
        // embedded '__' would make split_dunder shatter the key into the wrong
        // arity (the documented multi-param limitation). split_inst_key splits
        // on ';' so each value stays intact; sanitize_key maps ';' -> '__' so
        // the emitted clone NAME is unchanged for the simple multi-param case.
        if (j > 0) { key = key + ";"; }
        key = key + b;
        j = j + 1;
    }
    return key;
}

// infer_inst_ret is infer_inst PLUS return-type-directed instantiation: it
// also binds any type param left unbound by the arguments from `expected_ret`
// unified against `fd.ret_type`. This is what instantiates a no-argument
// generic constructor from its call-site annotation — `var b: Box[i32] =
// mk()` binds mk[T]()'s `T` (which appears ONLY in the `Box[T]` return) from
// the `Box[i32]` annotation. Without it such a call stays the un-monomorphised
// template (T unbound), whose `Box { xs: [] }` can't lower and drags the
// module to the AST emitter (std/set's `set_new` → segfault). Returns "" when
// still incomplete (the call then stays generic, as before).
function infer_inst_ret(fd: FuncDecl, args: Expr[], expected_ret: string, env: MEnv, funcs: FuncDecl[]): string {
    if (fd.type_params.len() == 0) { return ""; }
    var binds: MEnv = MEnv { mnames: [], mtypes: [] };
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (i < args.len()) {
            var ct: string = mono_infer(args[i], env, funcs);
            if (ct.len() > 0) {
                binds = bind_unify(fd.params[i].type_name, ct, fd.type_params, binds);
            }
            if (fd.params[i].type_name == "fn" && tp_index(fd.params[i].fn_ret, fd.type_params) >= 0) {
                var lr: string = lambda_ret_of(args[i], env, funcs);
                if (lr.len() > 0) {
                    binds = bind_unify(fd.params[i].fn_ret, lr, fd.type_params, binds);
                }
            }
        }
        i = i + 1;
    }
    if (expected_ret.len() > 0) {
        binds = bind_unify(fd.ret_type, expected_ret, fd.type_params, binds);
    }
    return binds_to_key(fd.type_params, binds);
}

// split_inst_key splits a multi-param instantiation key (joined by infer_inst
// with ';') back into its per-param concrete types, preserving any '__' inside
// a single module-mangled value. The ';'-free single-param key is handled by
// the callers' `[key]` fast path (never reaches here).
function split_inst_key(s: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == 59) {                            // ';'
            out = out.append(s[start : i]);
            i = i + 1;
            start = i;
            continue;
        }
        i = i + 1;
    }
    out = out.append(s[start : s.len()]);
    return out;
}

// tv_word_char reports whether `c` continues a type-name token (a letter,
// digit or `_`) — the token boundary type_str_vars scans on.
function tv_word_char(c: i32): boolean {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
}

// type_str_vars collects the single-uppercase-letter type variables (T /
// K / V …) appearing in a coarse type spelling, appended to `acc`
// (deduped). A maximal `[A-Za-z0-9_]` run that is exactly one uppercase
// letter is a var — the per-token form of looks_type_var, so it finds
// `T` in `T[]`, both `K` and `V` in `Map[K, V]`, etc., while multi-char
// names (Map / JsonValue) and lowercase primitives never match.
function type_str_vars(ty: string, acc: string[]): string[] {
    var out: string[] = acc;
    var i: i32 = 0;
    var n: i32 = ty.len();
    while (i < n) {
        if (tv_word_char(ty[i])) {
            var start: i32 = i;
            while (i < n && tv_word_char(ty[i])) { i = i + 1; }
            var tok: string = ty[start : i] + "";
            if (tok.len() == 1 && tok[0] >= 65 && tok[0] <= 90 && !util.has_str(out, tok)) {
                out = out.append(tok);
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

// full_ret_binds unifies EVERY param of `fd` against its argument to bind
// the type vars in `vars` — bounded AND unbounded alike. call_ret_type
// uses it to recover an unbounded element param that survives the
// bounded-only substitution (the `T` in `sort_key[T, K: Ord](xs, key):
// T[]`, erased from fd.type_params). A fn-param's own return var is
// bound from the lambda argument's return type (mirroring infer_inst).
function full_ret_binds(fd: FuncDecl, args: Expr[], env: MEnv, funcs: FuncDecl[], vars: string[]): MEnv {
    var binds: MEnv = MEnv { mnames: [], mtypes: [] };
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (i < args.len()) {
            var ct: string = mono_infer(args[i], env, funcs);
            if (ct.len() > 0) {
                binds = bind_unify(fd.params[i].type_name, ct, vars, binds);
            }
            if (fd.params[i].type_name == "fn" && tp_index(fd.params[i].fn_ret, vars) >= 0) {
                var lr: string = lambda_ret_of(args[i], env, funcs);
                if (lr.len() > 0) {
                    binds = bind_unify(fd.params[i].fn_ret, lr, vars, binds);
                }
            }
        }
        i = i + 1;
    }
    return binds;
}

// func_ret_of returns the return type of a plain function by name.
function func_ret_of(funcs: FuncDecl[], name: string): string {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) { return funcs[i].ret_type; }
        i = i + 1;
    }
    return "";
}

// func_param_type_at returns the declared type spelling of parameter `idx`
// of the receiver-less function named `name`, or "" (name not found, or idx
// out of range). The generic-enum monomorphiser uses it to pin a bare
// unit-variant call argument (`get(Non)`) from the callee's parameter type —
// the call-site analogue of the `var o: Opt[i32] = Non` annotation.
function func_param_type_at(funcs: FuncDecl[], name: string, idx: i32): string {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) {
            if (idx >= 0 && idx < funcs[i].params.len()) { return funcs[i].params[idx].type_name; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

function call_ret_type(funcs: FuncDecl[], name: string, args: Expr[], env: MEnv): string {
    var fi: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) { fi = i; }
        i = i + 1;
    }
    if (fi < 0) { return ""; }
    var fd: FuncDecl = funcs[fi];
    if (fd.type_params.len() == 0) { return fd.ret_type; }
    var key: string = infer_inst(fd, args, env, funcs);
    if (key.len() == 0) { return ""; }
    var cts: string[] = [key];
    if (fd.type_params.len() != 1) { cts = split_inst_key(key); }
    var rt: string = subst_ty(fd.ret_type, fd.type_params, cts);
    // The bounded-only substitution above can leave an UNBOUNDED type
    // param in the return type — `sort_key[T, K: Ord](xs, key): T[]`
    // erases T from fd.type_params, so `T[]` survives with T unresolved,
    // and a caller (`var out = sort_key(strs, key)`) then can't recover
    // the element type for dispatch. Bind any residual var from the full
    // param unification and substitute.
    var rvars: string[] = type_str_vars(rt, []);
    if (rvars.len() > 0) {
        var fb: MEnv = full_ret_binds(fd, args, env, funcs, rvars);
        var rcts: string[] = [];
        var vi: i32 = 0;
        while (vi < rvars.len()) {
            var bv: string = fb.elook(rvars[vi]);
            if (bv.len() == 0) { bv = rvars[vi]; }
            rcts = rcts.append(bv);
            vi = vi + 1;
        }
        rt = subst_ty(rt, rvars, rcts);
    }
    return rt;
}

// assoc_ret_of returns the return type of the associated function (or method)
// `<tyname>.<method>` — a receiver-LESS impl method keyed by its receiver type,
// like a derived `default()`. Lets mono_infer type an associated call
// `Inner.default()` so a generic constructor body `Box { v: Inner.default() }`
// infers its instantiation key (Box[Inner]) from the field value.
function assoc_ret_of(funcs: FuncDecl[], tyname: string, method: string): string {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == method && funcs[i].receiver_type == tyname) { return funcs[i].ret_type; }
        i = i + 1;
    }
    return "";
}

// mono_infer computes a coarse type-name for an expression, enough to
// pick the right clone. Unknown shapes return "" (the call stays
// generic — fine for non-primitive receivers).
function mono_infer(e: Expr, env: MEnv, funcs: FuncDecl[]): string {
    match (e) {
        ExprNumber(n) => {
            if (n.is_float) { return "f64"; }
            if (n.suffix.len() > 0) { return n.suffix; }
            return "i32";
        },
        ExprString(_) => { return "string"; },
        ExprBool(_) => { return "boolean"; },
        ExprArray(a) => {
            // Array literal `[e0, …]`: the type is the element type
            // plus `[]`, so a `T[]` parameter can recover the element.
            if (a.elements.len() == 0) { return ""; }
            var et: string = mono_infer(a.elements[0], env, funcs);
            if (et.len() == 0) { return ""; }
            return et + "[]";
        },
        ExprIdent(id) => { return env.elook(id.name); },
        ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||") {
                return "boolean";
            }
            return mono_infer(b.left, env, funcs);
        },
        ExprUnary(u) => {
            if (u.op == "!") { return "boolean"; }
            // An `as <type>` cast (op "as_<type>") evaluates to its TARGET type,
            // not the operand's. Without this a `3 as i64` argument inferred the
            // operand's "i32", so a bounded-generic `assert_eq((x).min(y), 3 as
            // i64)` bound `T = i32` and the i64-valued clone failed to lower
            // (#3457: i64/u64 `.min`/`.max`/`.abs`/`.clamp` + i64 array reductions).
            if (u.op.len() > 3 && u.op[0:3] == "as_") { return u.op[3:u.op.len()] + ""; }
            return mono_infer(u.operand, env, funcs);
        },
        ExprStructLit(sl) => { return sl.type_name; },
        ExprTuple(tu) => {
            // A tuple literal `(e0, e1, …)` → `(T0, T1, …)`, so a `(K, V)[]`
            // parameter (via the ExprArray case) recovers its element vars
            // through bind_unify's tuple destructure. Any unknown element makes
            // the whole tuple unknown (return "") — the call then stays generic.
            var inner: string = "";
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                var et: string = mono_infer(tu.elements[ti], env, funcs);
                if (et.len() == 0) { return ""; }
                if (ti > 0) { inner = inner + ", "; }
                inner = inner + et;
                ti = ti + 1;
            }
            return "(" + inner + ")";
        },
        ExprCall(c) => {
            match (c.callee) {
                ExprIdent(cid) => {
                    var crt: string = call_ret_type(funcs, cid.name, c.args, env);
                    if (crt.len() == 0) { crt = func_ret_of(funcs, cid.name); }
                    // A bare type variable as the inferred call type — `A` from a
                    // generic whose return type IS an UNBOUNDED type param
                    // (`fold[T, A, I]: A`): `A` is erased from `type_params`, so
                    // call_ret_type's subst never replaces it (and a fully
                    // unbounded `gfold[T, A]: A` has empty `type_params`, so its
                    // raw `A` ret_type is returned verbatim). That bare `A` then
                    // flows into any bounded generic it's passed to
                    // (`var s = iter.fold(..); assert_eq(s, 6)`), keying a
                    // spurious clone `assert_eq__A` whose `A.eq` / `A.to_string`
                    // can't resolve — dragging the module to the AST emitter. A
                    // bare type variable is never a usable concrete type, so
                    // report "unknown" (the other, concrete-literal arg still
                    // binds the call at `i32`).
                    if (looks_type_var(crt)) { return ""; }
                    return crt;
                },
                ExprFieldAccess(cfa) => {
                    // A `.to_string()` / `.to_debug()` method call yields a string
                    // regardless of the receiver type. Inferring it lets a bounded
                    // generic call like `assert_eq(x.to_string(), y.to_string())`
                    // bind its `T = string` from a computed (non-literal) argument
                    // — without it, neither arg infers a type, the call stays the
                    // uninstantiated template, and the whole module is dragged to
                    // the AST emitter (#3457: the std/u32 wrapping test's
                    // `rotr_roundtrip` asserts two computed `.to_string()`s).
                    if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) { return "string"; }
                    // Generic array method `recv.m(args)` whose receiver is an
                    // array — folded to `__arrm_m[T]` by
                    // register_array_method_generics. Infer the receiver's element
                    // type and substitute it into the method's return type, so a
                    // CHAINED call (`a.concat(b).concat(c)`) recovers the inner
                    // result type and the outer call rewrites onto the IR path too.
                    var amgi: i32 = bg_index(funcs, "__arrm_" + cfa.field);
                    if (amgi >= 0) {
                        var recvt: string = mono_infer(cfa.obj, env, funcs);
                        if (type_ends_arr(recvt)) {
                            var el: str = recvt[0 : recvt.len() - 2];
                            return subst_ty(funcs[amgi].ret_type, funcs[amgi].type_params, [el]);
                        }
                    }
                    // Associated call `Type.method()` (e.g. `Inner.default()`):
                    // the object is a bare type name, so infer the method's
                    // return type — lets a generic constructor body infer its
                    // instantiation key from a defaulted field value.
                    match (cfa.obj) {
                        ExprIdent(oid) => {
                            var qrt: string = call_ret_type(funcs, oid.name + "." + cfa.field, c.args, env);
                            if (qrt.len() > 0) { return qrt; }
                            return assoc_ret_of(funcs, oid.name, cfa.field);
                        },
                        _ => { return ""; }
                    }
                    return "";
                },
                _ => { return ""; }
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// mono_expr rebuilds `e`, rewriting any call to a bounded generic into
// its mangled clone name and recording the instantiation.
function mono_expr(e: Expr, env: MEnv, funcs: FuncDecl[], ins: Insts): RExpr {
    match (e) {
        ExprBinary(b) => {
            var l: RExpr = mono_expr(b.left, env, funcs, ins);
            var r: RExpr = mono_expr(b.right, env, funcs, l.rins);
            return RExpr { rexpr: ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col }, rins: r.rins };
        },
        ExprUnary(u) => {
            var o: RExpr = mono_expr(u.operand, env, funcs, ins);
            return RExpr { rexpr: ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col }, rins: o.rins };
        },
        ExprCall(c) => {
            var nargs: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < c.args.len()) {
                var ra: RExpr = mono_expr(c.args[i], env, funcs, cur);
                cur = ra.rins;
                nargs = nargs.append(ra.rexpr);
                i = i + 1;
            }
            match (c.callee) {
                ExprIdent(cid) => {
                    var bi: i32 = bg_index(funcs, cid.name);
                    if (bi >= 0) {
                        var ct: string = infer_inst(funcs[bi], c.args, env, funcs);
                        if (ct.len() > 0) {
                            // The clone NAME must be symbol-safe: a key that is a
                            // generic-struct instantiation (`iter__ArrayIter[i32]`,
                            // from an Iterator-bounded reducer over `iter.of(xs)`)
                            // carries brackets that GAS rejects in a label. Sanitise
                            // the name (`[`/`,` -> `__`); keep the RAW key in the
                            // worklist so clone_bg's body type-substitution and the
                            // struct pass's mg_ty still see `iter__ArrayIter[i32]`.
                            var mang: string = cid.name + "__" + sanitize_key(ct);
                            cur = cur.iadd(cid.name, ct);
                            return RExpr { rexpr: ExprCall { callee: ExprIdent { name: mang, line: cid.line, col: cid.col }, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: cur };
                        }
                    }
                },
                ExprFieldAccess(fac) => {
                    // Module-qualified call `mod.f(args)`: the merged
                    // module names the function `mod.f`. Match the
                    // bounded-generic registry on that dotted name and
                    // rewrite the field to the mangled clone suffix so
                    // the emitter resolves `mod.f__<type>`.
                    match (fac.obj) {
                        ExprIdent(modid) => {
                            var qn: string = modid.name + "." + fac.field;
                            var bi2: i32 = bg_index(funcs, qn);
                            if (bi2 >= 0) {
                                var ct2: string = infer_inst(funcs[bi2], c.args, env, funcs);
                                if (ct2.len() > 0) {
                                    cur = cur.iadd(qn, ct2);
                                    return RExpr { rexpr: ExprCall { callee: ExprFieldAccess { obj: fac.obj, field: fac.field + "__" + sanitize_key(ct2), line: fac.line, col: fac.col }, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: cur };
                                }
                            }
                        },
                        _ => {}
                    }
                    // Value-receiver generic array method `recv.m(args)` —
                    // m was folded to a bounded free generic `__arrm_m[T]`
                    // by register_array_method_generics. When recv is
                    // array-typed, fold it into arg0 and emit a free call
                    // the worklist instantiates to `__arrm_m__<elem>`.
                    // Checked after the module-qualified case so a real
                    // `mod.f(args)` still wins.
                    var amn: string = "__arrm_" + fac.field;
                    var amg: i32 = bg_index(funcs, amn);
                    if (amg >= 0) {
                        var rty: string = mono_infer(fac.obj, env, funcs);
                        if (type_ends_arr(rty)) {
                            var raw: Expr[] = [fac.obj];
                            var rk: i32 = 0;
                            while (rk < c.args.len()) { raw = raw.append(c.args[rk]); rk = rk + 1; }
                            var ct3: string = infer_inst(funcs[amg], raw, env, funcs);
                            // Keep a generic array method with only `T[]` params
                            // (`concat` / `reverse`) on ONE element type per program:
                            // a second distinct element type leaves the call in method
                            // form (→ AST), sidestepping a self-host crash lowering
                            // such a helper at two element types. A method taking a
                            // BARE element-typed value param (`intersperse(sep: T)` /
                            // `push(x: T)`) is EXEMPT: its AST fallback miscompiles a
                            // 16-byte `string` value, so it must clone per element type
                            // at every element type — the free `intersperse[T]` it
                            // delegates to is now monomorphised (bare-value-param
                            // promotion), so both clones carry the concrete param ABI.
                            if (ct3.len() > 0 && cur.ihas_other(amn, ct3) && !arrm_has_bare_elem_param(funcs[amg])) { ct3 = ""; }
                            if (ct3.len() > 0) {
                                var ro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                                cur = ro.rins;
                                var folded: Expr[] = [ro.rexpr];
                                var fk: i32 = 0;
                                while (fk < nargs.len()) { folded = folded.append(nargs[fk]); fk = fk + 1; }
                                cur = cur.iadd(amn, ct3);
                                return RExpr { rexpr: ExprCall { callee: ExprIdent { name: amn + "__" + sanitize_key(ct3), line: fac.line, col: fac.col }, args: folded, line: c.line, col: c.col, type_argc: 0 }, rins: cur };
                            }
                        }
                    }
                    // Value-receiver generic MAP method `recv.verb(args)` — verb
                    // was folded to `__mapm_verb[K, V]` by
                    // register_map_method_generics. When recv is map-typed, fold
                    // it into arg0 and emit a free call the worklist instantiates
                    // to `__mapm_verb__<K>;<V>`. The Map sibling of the array arm
                    // above; checked after it so a `T[]` receiver still wins.
                    var mmn: string = "__mapm_" + fac.field;
                    var mmg: i32 = bg_index(funcs, mmn);
                    if (mmg >= 0) {
                        var mrty: string = mono_infer(fac.obj, env, funcs);
                        if (mrty.len() >= 4 && mrty[0:4] == "Map[") {
                            var mraw: Expr[] = [fac.obj];
                            var mrk: i32 = 0;
                            while (mrk < c.args.len()) { mraw = mraw.append(c.args[mrk]); mrk = mrk + 1; }
                            var mct: string = infer_inst(funcs[mmg], mraw, env, funcs);
                            if (mct.len() > 0) {
                                var mro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                                cur = mro.rins;
                                var mfolded: Expr[] = [mro.rexpr];
                                var mfk: i32 = 0;
                                while (mfk < nargs.len()) { mfolded = mfolded.append(nargs[mfk]); mfk = mfk + 1; }
                                cur = cur.iadd(mmn, mct);
                                return RExpr { rexpr: ExprCall { callee: ExprIdent { name: mmn + "__" + sanitize_key(mct), line: fac.line, col: fac.col }, args: mfolded, line: c.line, col: c.col, type_argc: 0 }, rins: cur };
                            }
                        }
                    }
                },
                _ => {}
            }
            var rc: RExpr = mono_expr(c.callee, env, funcs, cur);
            return RExpr { rexpr: ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: rc.rins };
        },
        ExprArray(a) => {
            var els: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < a.elements.len()) {
                var re: RExpr = mono_expr(a.elements[i], env, funcs, cur);
                cur = re.rins;
                els = els.append(re.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprArray { elements: els }, rins: cur };
        },
        ExprTuple(t) => {
            var els: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < t.elements.len()) {
                var re: RExpr = mono_expr(t.elements[i], env, funcs, cur);
                cur = re.rins;
                els = els.append(re.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprTuple { elements: els, line: t.line, col: t.col }, rins: cur };
        },
        ExprIndex(ix) => {
            var ar: RExpr = mono_expr(ix.array, env, funcs, ins);
            var idx: RExpr = mono_expr(ix.index, env, funcs, ar.rins);
            return RExpr { rexpr: ExprIndex { array: ar.rexpr, index: idx.rexpr, unchecked: false }, rins: idx.rins };
        },
        ExprSlice(sl) => {
            var ar: RExpr = mono_expr(sl.array, env, funcs, ins);
            var st: RExpr = mono_expr(sl.start, env, funcs, ar.rins);
            var en: RExpr = mono_expr(sl.end, env, funcs, st.rins);
            return RExpr { rexpr: ExprSlice { array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
        },
        ExprFieldAccess(fa) => {
            var o: RExpr = mono_expr(fa.obj, env, funcs, ins);
            return RExpr { rexpr: ExprFieldAccess { obj: o.rexpr, field: fa.field, line: fa.line, col: fa.col }, rins: o.rins };
        },
        ExprStructLit(s) => {
            var vals: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < s.field_values.len()) {
                var rv: RExpr = mono_expr(s.field_values[i], env, funcs, cur);
                cur = rv.rins;
                vals = vals.append(rv.rexpr);
                i = i + 1;
            }
            var rb: RExpr = mono_expr(s.base, env, funcs, cur);
            return RExpr { rexpr: ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: rb.rexpr, line: s.line, col: s.col }, rins: rb.rins };
        },
        ExprLambda(lm) => {
            var bodyr: RStmts = mono_stmts(lm.body, env, funcs, ins, "");
            return RExpr { rexpr: ExprLambda { params: lm.params, ret_type: lm.ret_type, body: bodyr.rstmts, use_infer: lm.use_infer }, rins: bodyr.rins3 };
        },
        _ => { return RExpr { rexpr: e, rins: ins }; }
    }
    return RExpr { rexpr: e, rins: ins };
}

// mono_stmt rebuilds a statement, threading the inference env (only
// StmtVar extends it) and the instantiation accumulator.
// mono_call_expected rewrites an expression in a position with a known EXPECTED
// type (`expected`), applying return-type-directed instantiation when it is a
// bounded-generic call: `var b: Box[i32] = mk()` / `function two(): Box[i32] {
// return mk(); }` bind mk's type params from the `Box[i32]` expected type (via
// infer_inst_ret) so a no-argument constructor monomorphises instead of staying
// a template. (A return-only type param is now promoted, so the template is
// DROPPED — an unresolved call site would be an undefined reference, not just an
// AST fallback, which is why every expected-type position must resolve it.)
// Falls through to plain mono_expr when there is no expected type, the callee
// isn't a bounded generic, or the instantiation still can't be resolved — a
// strict superset of mono_expr for this position.
function mono_call_expected(e: Expr, expected: string, env: MEnv, funcs: FuncDecl[], ins: Insts): RExpr {
    if (expected.len() > 0) {
        match (e) {
            ExprCall(c) => {
                match (c.callee) {
                    ExprIdent(cid) => {
                        var bi: i32 = bg_index(funcs, cid.name);
                        if (bi >= 0) {
                            var key: string = infer_inst_ret(funcs[bi], c.args, expected, env, funcs);
                            if (key.len() > 0) {
                                var nargs: Expr[] = [];
                                var cur: Insts = ins;
                                var i: i32 = 0;
                                while (i < c.args.len()) {
                                    var ra: RExpr = mono_expr(c.args[i], env, funcs, cur);
                                    cur = ra.rins;
                                    nargs = nargs.append(ra.rexpr);
                                    i = i + 1;
                                }
                                var mang: string = cid.name + "__" + sanitize_key(key);
                                cur = cur.iadd(cid.name, key);
                                return RExpr { rexpr: ExprCall { callee: ExprIdent { name: mang, line: cid.line, col: cid.col }, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: cur };
                            }
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    return mono_expr(e, env, funcs, ins);
}

function mono_stmt(st: Stmt, env: MEnv, funcs: FuncDecl[], ins: Insts, ret_ty: string): RStmtOne {
    match (st) {
        StmtVar(v) => {
            var iv: RExpr = mono_call_expected(v.init, v.type_name, env, funcs, ins);
            var ty: string = v.type_name;
            if (ty.len() == 0) { ty = mono_infer(v.init, env, funcs); }
            return RStmtOne { rstmt: StmtVar { name: v.name, type_name: v.type_name, init: iv.rexpr, line: v.line, col: v.col, is_str: v.is_str }, renv: env.ebind(v.name, ty), rins2: iv.rins };
        },
        StmtReturn(r) => {
            // A `return mk()` binds a bounded-generic constructor's type params
            // from the enclosing function's declared return type — the return-
            // position sibling of the StmtVar annotation above.
            var rv: RExpr = mono_call_expected(r.value, ret_ty, env, funcs, ins);
            return RStmtOne { rstmt: StmtReturn { value: rv.rexpr, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
        },
        StmtExpr(x) => {
            var xv: RExpr = mono_expr(x.value, env, funcs, ins);
            return RStmtOne { rstmt: StmtExpr { value: xv.rexpr }, renv: env, rins2: xv.rins };
        },
        StmtAssign(a) => {
            var av: RExpr = mono_expr(a.value, env, funcs, ins);
            return RStmtOne { rstmt: StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
        },
        StmtIf(f) => {
            var cv: RExpr = mono_expr(f.cond, env, funcs, ins);
            var tb: RStmts = mono_stmts(f.then_body, env, funcs, cv.rins, ret_ty);
            var eb: RStmts = mono_stmts(f.else_body, env, funcs, tb.rins3, ret_ty);
            return RStmtOne { rstmt: StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts }, renv: env, rins2: eb.rins3 };
        },
        StmtWhile(w) => {
            var cv: RExpr = mono_expr(w.cond, env, funcs, ins);
            var wb: RStmts = mono_stmts(w.body, env, funcs, cv.rins, ret_ty);
            return RStmtOne { rstmt: StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label }, renv: env, rins2: wb.rins3 };
        },
        StmtFor(fr) => {
            var it: RExpr = mono_expr(fr.iter, env, funcs, ins);
            var benv: MEnv = env.ebind(fr.var_name, "");
            var fb: RStmts = mono_stmts(fr.body, benv, funcs, it.rins, ret_ty);
            return RStmtOne { rstmt: StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label }, renv: env, rins2: fb.rins3 };
        },
        StmtMatch(m) => {
            var sv: RExpr = mono_expr(m.scrutinee, env, funcs, ins);
            var arms: MatchArm[] = [];
            var cur: Insts = sv.rins;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var ab: RStmts = mono_stmts(m.arms[i].body, env, funcs, cur, ret_ty);
                cur = ab.rins3;
                arms = arms.append(MatchArm { pattern: m.arms[i].pattern, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: m.arms[i].guard, has_guard: m.arms[i].has_guard });
                i = i + 1;
            }
            return RStmtOne { rstmt: StmtMatch { scrutinee: sv.rexpr, arms: arms, line: m.line, col: m.col, origin: m.origin }, renv: env, rins2: cur };
        },
        _ => { return RStmtOne { rstmt: st, renv: env, rins2: ins }; }
    }
    return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

// mono_stmts walks a statement list, threading the (block-local) env. `ret_ty`
// is the enclosing function's declared return type, used by StmtReturn to bind
// a `return <generic constructor>()` from it; "" at top-level / in a lambda.
function mono_stmts(stmts: Stmt[], env: MEnv, funcs: FuncDecl[], ins: Insts, ret_ty: string): RStmts {
    var out: Stmt[] = [];
    var e2: MEnv = env;
    var cur: Insts = ins;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var rs: RStmtOne = mono_stmt(stmts[i], e2, funcs, cur, ret_ty);
        out = out.append(rs.rstmt);
        e2 = rs.renv;
        cur = rs.rins2;
        i = i + 1;
    }
    return RStmts { rstmts: out, rins3: cur };
}

// env_from_params seeds an MEnv with a function's parameter types.
function env_from_params(params: ParamDecl[]): MEnv {
    var e: MEnv = MEnv { mnames: [], mtypes: [] };
    var i: i32 = 0;
    while (i < params.len()) {
        e = e.ebind(params[i].name, params[i].type_name);
        i = i + 1;
    }
    return e;
}

// subst_ty replaces every type variable in `tparams` with its concrete
// type from `cts` (same index), handling a bare variable (`T` → i32),
// the array form (`T[]` → i32[]), and a composite of any base
// (`Map[K, V]` → Map[i32, string]) by recursing into each top-level
// argument. Everything else passes through unchanged.
function subst_ty(name: string, tparams: string[], cts: string[]): string {
    var k: i32 = tp_index(name, tparams);
    if (k >= 0) { return cts[k]; }
    if (type_ends_arr(name)) {
        return subst_ty(name[0 : name.len() - 2], tparams, cts) + "[]";
    }
    if (name.len() >= 2 && name[0 : 1] == "(" && name[name.len() - 1 : name.len()] == ")") {
        var tparts: string[] = split_top_commas(name[1 : name.len() - 1]);
        var tnin: string = "";
        var tj: i32 = 0;
        while (tj < tparts.len()) {
            if (tj > 0) { tnin = tnin + ", "; }
            tnin = tnin + subst_ty(tparts[tj], tparams, cts);
            tj = tj + 1;
        }
        return "(" + tnin + ")";
    }
    var lb: i32 = first_bracket(name);
    if (lb > 0 && name[name.len() - 1 : name.len()] == "]") {
        var inner: str = name[lb + 1 : name.len() - 1];
        var parts: string[] = split_top_commas(inner);
        var ninner: string = "";
        var j: i32 = 0;
        while (j < parts.len()) {
            if (j > 0) { ninner = ninner + ", "; }
            ninner = ninner + subst_ty(parts[j], tparams, cts);
            j = j + 1;
        }
        return name[0 : lb] + "[" + ninner + "]";
    }
    return name;
}

// subst_expr substitutes a type-parameter NAME used as a value-level
// identifier with its concrete type. The only place a type parameter `T`
// appears as an expression is the OBJECT of an associated call — `T.default()`
// in a monomorphised generic body — so substituting any matching ExprIdent
// rewrites it to `Concrete.default()`, which then resolves like any associated
// call (issue #2779 item 3). Recurses through the expression shapes a generic
// body can carry; other leaves pass through. Struct-literal TYPE names are left
// alone (the struct-literal monomorphiser, ms_expr, mangles `Box` → `Box__C`).
function subst_expr(e: Expr, tparams: string[], cts: string[]): Expr {
    match (e) {
        ExprIdent(id) => {
            var k: i32 = tp_index(id.name, tparams);
            if (k >= 0) { return ExprIdent { name: cts[k], line: id.line, col: id.col }; }
            return e;
        },
        ExprFieldAccess(fa) => { return ExprFieldAccess { obj: subst_expr(fa.obj, tparams, cts), field: fa.field, line: fa.line, col: fa.col }; },
        ExprCall(c) => {
            // A defaulted generic field `T.default()` where `T` substitutes to a
            // PRIMITIVE has no associated impl to dispatch to in the IR path —
            // emit the primitive's zero literal directly (i32→0, string→"",
            // boolean→false, f64→0.0), exactly as the concrete struct-default
            // path does for a scalar field. This lets a generic `@derive(Default)`
            // over a primitive (`Box[i32].default()`) lower through the IR path
            // (the native compiler resolves the same `T.default()` via the
            // primitive `Default` impl — see #2864).
            match (c.callee) {
                ExprFieldAccess(cfa) => {
                    match (cfa.obj) {
                        ExprIdent(oid) => {
                            if (c.args.len() == 0) {
                                var pk: i32 = tp_index(oid.name, tparams);
                                if (pk >= 0) {
                                    // T.default() on a primitive → the primitive's zero
                                    // literal (see above).
                                    if (cfa.field == "default" && dv_is_scalar(cts[pk])) { return dv_default_expr(cts[pk]); }
                                    // T.zero() / T.one() (std/num's additive / multiplicative
                                    // identities) on a NUMERIC primitive have no associated
                                    // impl to dispatch to in the IR path either — emit the
                                    // identity literal directly (i32→0/1, f64→0.0/1.0),
                                    // exactly as the `default` case does, so a generic
                                    // reducer `sum[T: Add + Zero](xs): T { var acc = T.zero(); … }`
                                    // lowers through the IR path instead of bailing to the AST
                                    // emitter (the native compiler resolves the same call via
                                    // the primitive Zero / One impl).
                                    if (cfa.field == "zero" && dv_is_num_scalar(cts[pk])) { return dv_num_identity_expr(cts[pk], false); }
                                    if (cfa.field == "one" && dv_is_num_scalar(cts[pk])) { return dv_num_identity_expr(cts[pk], true); }
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            var na: Expr[] = [];
            var ci: i32 = 0;
            while (ci < c.args.len()) { na = na.append(subst_expr(c.args[ci], tparams, cts)); ci = ci + 1; }
            return ExprCall { callee: subst_expr(c.callee, tparams, cts), args: na, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        ExprStructLit(sl) => {
            var nv: Expr[] = [];
            var si: i32 = 0;
            while (si < sl.field_values.len()) { nv = nv.append(subst_expr(sl.field_values[si], tparams, cts)); si = si + 1; }
            var nb: Expr = sl.base;
            if (sl.has_base) { nb = subst_expr(sl.base, tparams, cts); }
            return ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nb, line: sl.line, col: sl.col };
        },
        ExprBinary(b) => { return ExprBinary { op: b.op, left: subst_expr(b.left, tparams, cts), right: subst_expr(b.right, tparams, cts), line: b.line, col: b.col }; },
        ExprUnary(u) => { return ExprUnary { op: u.op, operand: subst_expr(u.operand, tparams, cts), line: u.line, col: u.col }; },
        ExprIndex(ix) => { return ExprIndex { array: subst_expr(ix.array, tparams, cts), index: subst_expr(ix.index, tparams, cts), unchecked: ix.unchecked }; },
        _ => { return e; }
    }
    return e;
}

// subst_stmts rewrites `var x: T` type annotations to the concrete type in a
// cloned generic body, AND substitutes type-parameter names appearing as
// expression objects (`T.default()` → `Concrete.default()`, via subst_expr).
function subst_stmts(stmts: Stmt[], tparams: string[], cts: string[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: Stmt = stmts[i];
        match (st) {
            StmtVar(v) => { out = out.append(StmtVar { name: v.name, type_name: subst_ty(v.type_name, tparams, cts), init: subst_expr(v.init, tparams, cts), line: v.line, col: v.col, is_str: v.is_str }); },
            StmtReturn(r) => { out = out.append(StmtReturn { value: subst_expr(r.value, tparams, cts), line: r.line, col: r.col }); },
            StmtExpr(x) => { out = out.append(StmtExpr { value: subst_expr(x.value, tparams, cts) }); },
            StmtAssign(a) => { out = out.append(StmtAssign { target: a.target, value: subst_expr(a.value, tparams, cts), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }); },
            StmtIf(f) => { out = out.append(StmtIf { cond: subst_expr(f.cond, tparams, cts), then_body: subst_stmts(f.then_body, tparams, cts), else_body: subst_stmts(f.else_body, tparams, cts) }); },
            StmtWhile(w) => { out = out.append(StmtWhile { cond: subst_expr(w.cond, tparams, cts), body: subst_stmts(w.body, tparams, cts), label: w.label }); },
            StmtFor(fr) => { out = out.append(StmtFor { var_name: fr.var_name, iter: subst_expr(fr.iter, tparams, cts), body: subst_stmts(fr.body, tparams, cts), label: fr.label }); },
            StmtMatch(m) => {
                var arms: MatchArm[] = [];
                var j: i32 = 0;
                while (j < m.arms.len()) {
                    arms = arms.append(MatchArm { pattern: m.arms[j].pattern, body: subst_stmts(m.arms[j].body, tparams, cts), line: m.arms[j].line, col: m.arms[j].col, guard: subst_expr(m.arms[j].guard, tparams, cts), has_guard: m.arms[j].has_guard });
                    j = j + 1;
                }
                out = out.append(StmtMatch { scrutinee: subst_expr(m.scrutinee, tparams, cts), arms: arms, line: m.line, col: m.col, origin: m.origin });
            },
            _ => { out = out.append(st); }
        }
        i = i + 1;
    }
    return out;
}

// retarget_self_lit_expr rewrites every bare-base struct literal `base { .. }`
// in a cloned struct-method body to the concrete clone name `mang`. A struct's
// own method that constructs its struct WITHOUT explicit type arguments (the
// `next` of an `impl[T] Iterator[T] for ArrayIter[T]`: `return Some((v,
// ArrayIter { xs: self.xs, idx: .. }))`) is building the SAME instantiation as
// the receiver — `Self` in value position. ms_expr can't infer that key
// (mono_infer has no field-access / struct typing for `self.xs`), so resolve it
// structurally here, mirroring the `Self`-in-types resolution that
// to_concrete_struct_ty does for the return / param types. Nested values are
// walked so a struct literal inside a tuple / call / array is retargeted too.
function retarget_self_lit_expr(e: Expr, base: string, mang: string): Expr {
    match (e) {
        ExprStructLit(sl) => {
            var nv: Expr[] = [];
            var si: i32 = 0;
            while (si < sl.field_values.len()) { nv = nv.append(retarget_self_lit_expr(sl.field_values[si], base, mang)); si = si + 1; }
            var nb: Expr = sl.base;
            if (sl.has_base) { nb = retarget_self_lit_expr(sl.base, base, mang); }
            var tn: string = sl.type_name;
            if (tn == base) { tn = mang; }
            return ExprStructLit { type_name: tn, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nb, line: sl.line, col: sl.col };
        },
        ExprCall(c) => {
            var na: Expr[] = [];
            var ci: i32 = 0;
            while (ci < c.args.len()) { na = na.append(retarget_self_lit_expr(c.args[ci], base, mang)); ci = ci + 1; }
            return ExprCall { callee: retarget_self_lit_expr(c.callee, base, mang), args: na, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        ExprTuple(t) => {
            var ne: Expr[] = [];
            var ti: i32 = 0;
            while (ti < t.elements.len()) { ne = ne.append(retarget_self_lit_expr(t.elements[ti], base, mang)); ti = ti + 1; }
            return ExprTuple { elements: ne, line: t.line, col: t.col };
        },
        ExprArray(a) => {
            var ne2: Expr[] = [];
            var ai: i32 = 0;
            while (ai < a.elements.len()) { ne2 = ne2.append(retarget_self_lit_expr(a.elements[ai], base, mang)); ai = ai + 1; }
            return ExprArray { elements: ne2 };
        },
        ExprBinary(b) => { return ExprBinary { op: b.op, left: retarget_self_lit_expr(b.left, base, mang), right: retarget_self_lit_expr(b.right, base, mang), line: b.line, col: b.col }; },
        ExprUnary(u) => { return ExprUnary { op: u.op, operand: retarget_self_lit_expr(u.operand, base, mang), line: u.line, col: u.col }; },
        ExprIndex(ix) => { return ExprIndex { array: retarget_self_lit_expr(ix.array, base, mang), index: retarget_self_lit_expr(ix.index, base, mang), unchecked: ix.unchecked }; },
        ExprSlice(sl2) => { return ExprSlice { array: retarget_self_lit_expr(sl2.array, base, mang), start: retarget_self_lit_expr(sl2.start, base, mang), end: retarget_self_lit_expr(sl2.end, base, mang) }; },
        ExprFieldAccess(fa) => { return ExprFieldAccess { obj: retarget_self_lit_expr(fa.obj, base, mang), field: fa.field, line: fa.line, col: fa.col }; },
        _ => { return e; }
    }
    return e;
}
// retarget_self_lit_stmts walks a cloned struct-method body, applying
// retarget_self_lit_expr to every contained expression.
function retarget_self_lit_stmts(stmts: Stmt[], base: string, mang: string): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: Stmt = stmts[i];
        match (st) {
            StmtVar(v) => { out = out.append(StmtVar { name: v.name, type_name: v.type_name, init: retarget_self_lit_expr(v.init, base, mang), line: v.line, col: v.col, is_str: v.is_str }); },
            StmtReturn(r) => { out = out.append(StmtReturn { value: retarget_self_lit_expr(r.value, base, mang), line: r.line, col: r.col }); },
            StmtExpr(x) => { out = out.append(StmtExpr { value: retarget_self_lit_expr(x.value, base, mang) }); },
            StmtAssign(a) => { out = out.append(StmtAssign { target: a.target, value: retarget_self_lit_expr(a.value, base, mang), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }); },
            StmtIf(f) => { out = out.append(StmtIf { cond: retarget_self_lit_expr(f.cond, base, mang), then_body: retarget_self_lit_stmts(f.then_body, base, mang), else_body: retarget_self_lit_stmts(f.else_body, base, mang) }); },
            StmtWhile(w) => { out = out.append(StmtWhile { cond: retarget_self_lit_expr(w.cond, base, mang), body: retarget_self_lit_stmts(w.body, base, mang), label: w.label }); },
            StmtFor(fr) => { out = out.append(StmtFor { var_name: fr.var_name, iter: retarget_self_lit_expr(fr.iter, base, mang), body: retarget_self_lit_stmts(fr.body, base, mang), label: fr.label }); },
            StmtMatch(m) => {
                var arms: MatchArm[] = [];
                var j: i32 = 0;
                while (j < m.arms.len()) {
                    arms = arms.append(MatchArm { pattern: m.arms[j].pattern, body: retarget_self_lit_stmts(m.arms[j].body, base, mang), line: m.arms[j].line, col: m.arms[j].col, guard: retarget_self_lit_expr(m.arms[j].guard, base, mang), has_guard: m.arms[j].has_guard });
                    j = j + 1;
                }
                out = out.append(StmtMatch { scrutinee: retarget_self_lit_expr(m.scrutinee, base, mang), arms: arms, line: m.line, col: m.col, origin: m.origin });
            },
            _ => { out = out.append(st); }
        }
        i = i + 1;
    }
    return out;
}

// clone_bg builds the `f__<key>` clone of bounded-generic func `fd`,
// substituting each type variable with its concrete type (the `__`-
// joined `key`, split back into per-parameter pieces) across params +
// return + body annotations.
function clone_bg(fd: FuncDecl, key: string): FuncDecl {
    var tparams: string[] = fd.type_params;
    // A single type parameter's key IS the one concrete type, verbatim —
    // never split it. A multi-param key is joined by infer_inst with ';'
    // (split_inst_key), so a per-param module-mangled value (`iter__ArrayIter[i32]`,
    // from an Iterator-bounded reducer `sum_iter[T: Add, I: Iterator[T]]` over
    // `iter.of(xs)`) keeps its embedded '__' intact — split_dunder would have
    // shattered it into the wrong arity and bound `I` to the bogus "iter".
    var cts: string[] = [key];
    if (tparams.len() != 1) { cts = split_inst_key(key); }
    var nparams: ParamDecl[] = [];
    var i: i32 = 0;
    while (i < fd.params.len()) {
        nparams = nparams.append(ParamDecl { name: fd.params[i].name, type_name: subst_ty(fd.params[i].type_name, tparams, cts), own: fd.params[i].own, has_default: fd.params[i].has_default, default_value: fd.params[i].default_value, ret_arr: fd.params[i].ret_arr, fn_ret: subst_ty(fd.params[i].fn_ret, tparams, cts), fn_param_dyn: fd.params[i].fn_param_dyn });
        i = i + 1;
    }
    var notp: string[] = [];
    return FuncDecl {
        name: fd.name + "__" + sanitize_key(key),
        receiver_name: "",
        receiver_type: "",
        type_params: notp,
        params: nparams,
        ret_type: subst_ty(fd.ret_type, tparams, cts),
        body: subst_stmts(fd.body, tparams, cts), line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str
    };
}

// ---- generic array-method monomorphisation (slice 1) ----------------
// A generic array-receiver method `(xs: T[]) m(args): R` (std/array's
// `concat` etc.) has no struct to instantiate and is skipped by both
// monomorphize_module (receiver methods are skipped) and
// monomorphize_structs (an array is not a generic struct), so its `T`
// stays a free var. The legacy AST array-method dispatch then types the
// receiver as i32 and mis-dispatches `i32.m`, dragging the module to the
// AST emitter. register_array_method_generics folds such a method into a
// bounded free generic `__arrm_m[T](xs: T[], args): R` (receiver as
// arg0) and DROPS the method decl; mono_expr's array-method arm rewrites
// each `xs.m(ys)` call to `__arrm_m(xs, ys)`, and the existing
// free-generic worklist clones one concrete `__arrm_m__<elem>` per
// element type — so generic array methods ride the proven free-generic
// monomorphiser instead of the i32-mis-dispatching AST path.

// looks_type_var reports whether `s` names a generic type variable: a
// single uppercase letter (T / U / K / V …), the spelling the stdlib's
// generic receivers use (`(xs: T[]) concat(…)`). Concrete element types
// (`i32`, `string`, `JsonValue`) and the type-specific `__method_Array_*`
// helpers' `i32[]` / `string[]` receivers never match.
function looks_type_var(s: string): boolean {
    if (s.len() != 1) { return false; }
    var c: i32 = s[0];
    return c >= 65 && c <= 90;
}

// is_generic_array_method gates the array-method path: a method
// (`receiver_name` set) whose receiver is `<var>[]` for a single type
// variable. Closure ("fn") params ARE allowed (`reduce` / `sort_by` /
// `filter` / `any` / `all` / `find`) and so are the method's OWN
// (unbounded) type params (`map[U]` / `flat_map[U]` / `fold[A]` /
// `zip[U]`): the receiver alone fixes the monomorphised `T`, while an
// unbounded extra type variable (`U` / `A`) is ERASED by the self-host's
// uniform 8-byte ABI exactly as it is in the free function — its
// result-element width is driven by the CALL SITE's annotation
// (`var ys: string[] = xs.map(f)`), not by cloning the body, so the
// folded body's delegation to the free `map` / `flat_map` / `fold` /
// `zip` (all of which already lower on IR) carries it through.
//
// A BOUNDED RECEIVER — `(xs: T[]) max[T: cmp.Ord]()`, whose body calls
// trait methods on the receiver element (`xs[i].cmp(m)`) — re-declares the
// receiver var `T` in `fd.type_params` (only BOUNDED params land there;
// unbounded `U`/`A` are erased). That is folded too: the receiver still
// fixes the monomorphised `T`, and substituting `T := <elem>` makes
// `xs[i].cmp(m)` resolve by ordinary concrete-type dispatch — exactly the
// path the equivalent free generic `max[T: cmp.Ord](xs: T[])` already rides.
// What stays excluded is a bounded EXTRA type param (a bounded `U` not
// fixed by the receiver): `fd.type_params` may hold the receiver var alone.
function is_generic_array_method(fd: FuncDecl): boolean {
    if (fd.receiver_name.len() == 0) { return false; }
    if (!type_ends_arr(fd.receiver_type)) { return false; }
    var elem: str = fd.receiver_type[0 : fd.receiver_type.len() - 2];
    if (!looks_type_var(elem)) { return false; }
    // The only bounded type param permitted is the receiver element var
    // itself (a bounded receiver); any other bounded param can't be erased
    // and isn't fixed by the receiver, so it can't ride this fold.
    var k: i32 = 0;
    while (k < fd.type_params.len()) {
        if (fd.type_params[k] != elem) { return false; }
        k = k + 1;
    }
    return true;
}

// register_array_method_generics rewrites each generic array-receiver
// method into a bounded free generic `__arrm_<name>[T]` with the
// receiver folded to a leading param, and drops the original method. A
// no-op when none is present (the compiler's own sources call the free
// `concat(xs, ys)` form, never `xs.concat(ys)`, so the byte-identical
// bootstrap fixpoint is preserved). Runs before monomorphize_module so
// the folded body's free `concat(xs, other)` call is rewritten too.
pub function register_array_method_generics(mod: Module): Module {
    var any_am: boolean = false;
    var ci: i32 = 0;
    while (ci < mod.funcs.len()) {
        if (is_generic_array_method(mod.funcs[ci])) { any_am = true; }
        ci = ci + 1;
    }
    if (!any_am) { return mod; }

    var out: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        if (is_generic_array_method(fd)) {
            var elem: str = fd.receiver_type[0 : fd.receiver_type.len() - 2];
            var tps: string[] = [elem];
            // Fold the receiver into a leading param named after the
            // receiver, so the body's references to it resolve normally.
            var nparams: ParamDecl[] = [ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
            var j: i32 = 0;
            while (j < fd.params.len()) {
                nparams = nparams.append(fd.params[j]);
                j = j + 1;
            }
            out = out.append(FuncDecl {
                name: "__arrm_" + fd.name,
                receiver_name: "", receiver_type: "",
                type_params: tps,
                params: nparams,
                ret_type: fd.ret_type,
                body: fd.body, line: fd.line, col: fd.col,
                import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: 1, bound_traits: [], fip: false, ret_str: false
            });
        } else {
            out = out.append(fd);
        }
        i = i + 1;
    }
    return Module {
        funcs: out,
        structs: mod.structs,
        aliases: mod.aliases,
        imports: mod.imports,
        top_stmts: mod.top_stmts,
        enums: mod.enums,
        resources: mod.resources,
        exports: mod.exports,
        impls: mod.impls,
        trait_reqs: mod.trait_reqs
    };
}

// ---- generic map-method monomorphisation (the Map sibling of the array
// fold above) ------------------------------------------------------------
// A generic map-receiver method `(m: Map[K, V]) verb(args): R` (core/map's
// `merge` / `extend` / `entries` / `contains_value` / …) is skipped by
// monomorphize_module (receiver methods) and monomorphize_structs (Map is a
// built-in, not a generic struct), so its `K` / `V` stay free vars. The body's
// map ops then read the key-kind off the unsubstituted `Map[K, V]` type, where
// map_key_kind_of (matching only the `Map[i32,` prefix) DEFAULTS to string —
// miscompiling an i32-keyed map (the integer key is dereferenced as a string
// pointer → SIGSEGV). register_map_method_generics folds such a method into a
// free generic `__mapm_<verb>[K, V](m: Map[K, V], args): R` (receiver as arg0,
// the receiver's type-vars as the clone's type params) and DROPS the method;
// mono_expr's map-method arm rewrites each `m.verb(args)` call to
// `__mapm_verb(m, args)`, so the proven free-generic worklist clones one
// concrete `__mapm_verb__<K>;<V>` per key/value pair — with `subst_ty`
// substituting `Map[K,V] → Map[i32,i32]`, so the cloned body's key-kind is
// correct. Mirrors register_array_method_generics exactly.

// map_receiver_typevars returns the type-variable arguments of a `Map[K, V]`
// receiver type (e.g. ["K", "V"]), or [] if the receiver isn't a Map whose
// args are all type variables. The args must ALL be type vars — a partially
// concrete `Map[i32, V]` isn't a generic the worklist can key on.
function map_receiver_typevars(recv: string): string[] {
    var none: string[] = [];
    if (recv.len() < 5 || recv[0:4] != "Map[" || recv[recv.len() - 1 : recv.len()] != "]") { return none; }
    // split_top_commas splits on ", " (consuming the space), so each part is
    // already trimmed — the normalised spelling every receiver type carries.
    var parts: string[] = split_top_commas(recv[4 : recv.len() - 1]);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < parts.len()) {
        var tv: string = parts[i];
        if (!looks_type_var(tv)) { return none; }
        out = out.append(tv);
        i = i + 1;
    }
    return out;
}

// is_generic_map_method gates the map-method fold: a method whose receiver is
// `Map[<vars>]`, with no bounded type params other than the receiver's own
// vars (closure / value params are allowed, exactly as the array path permits
// `reduce` / `sort_by`). A 2-tuple-returning verb (`get_or_insert`) is folded
// like any other — whether its tuple-with-Map result then lowers is the
// lowering side's concern, not the fold's.
function is_generic_map_method(fd: FuncDecl): boolean {
    if (fd.receiver_name.len() == 0) { return false; }
    var tvs: string[] = map_receiver_typevars(fd.receiver_type);
    if (tvs.len() == 0) { return false; }
    // Every bounded type param must be one of the receiver's vars (the receiver
    // fixes them); an extra bounded param isn't fixed by the receiver.
    var k: i32 = 0;
    while (k < fd.type_params.len()) {
        if (!str_in(tvs, fd.type_params[k])) { return false; }
        k = k + 1;
    }
    return true;
}

// register_map_method_generics folds each generic map-receiver method into a
// free generic `__mapm_<name>[<vars>]`, receiver folded to a leading param,
// and drops the original. A no-op when none is present — the compiler's own
// sources never call the generic core/map verbs, so the byte-identical
// bootstrap fixpoint is preserved. Runs before monomorphize_module so the
// folded body's own free calls rewrite too.
pub function register_map_method_generics(mod: Module): Module {
    var any_mm: boolean = false;
    var ci: i32 = 0;
    while (ci < mod.funcs.len()) {
        if (is_generic_map_method(mod.funcs[ci])) { any_mm = true; }
        ci = ci + 1;
    }
    if (!any_mm) { return mod; }

    var out: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        if (is_generic_map_method(fd)) {
            var tps: string[] = map_receiver_typevars(fd.receiver_type);
            var nparams: ParamDecl[] = [ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
            var j: i32 = 0;
            while (j < fd.params.len()) {
                nparams = nparams.append(fd.params[j]);
                j = j + 1;
            }
            out = out.append(FuncDecl {
                name: "__mapm_" + fd.name,
                receiver_name: "", receiver_type: "",
                type_params: tps,
                params: nparams,
                ret_type: fd.ret_type,
                body: fd.body, line: fd.line, col: fd.col,
                import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: tps.len(), bound_traits: [], fip: false, ret_str: false
            });
        } else {
            out = out.append(fd);
        }
        i = i + 1;
    }
    return Module {
        funcs: out,
        structs: mod.structs,
        aliases: mod.aliases,
        imports: mod.imports,
        top_stmts: mod.top_stmts,
        enums: mod.enums,
        resources: mod.resources,
        exports: mod.exports,
        impls: mod.impls,
        trait_reqs: mod.trait_reqs
    };
}

// monomorphize_module expands trait-bounded generics. Non-generic
// bodies + top stmts get their bounded-generic call sites rewritten to
// mangled clone names; the clones are then generated per instantiation
// (a worklist covers clones that call other bounded generics).
pub function monomorphize_module(mod: Module): Module {
    var funcs: FuncDecl[] = mod.funcs;
    // Nothing to do if there are no bounded generics.
    var any_bg: boolean = false;
    var bi: i32 = 0;
    while (bi < funcs.len()) {
        if (funcs[bi].receiver_name.len() == 0 && funcs[bi].type_params.len() > 0) { any_bg = true; }
        bi = bi + 1;
    }
    if (!any_bg) { return mod; }

    var ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
    // Rewrite call sites in every NON-bounded function body. Bounded
    // generics themselves are dropped (replaced by clones), so their
    // bodies are rewritten later, per clone.
    var rewritten: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var fd: FuncDecl = funcs[i];
        if (fd.receiver_name.len() == 0 && fd.type_params.len() > 0) {
            // skip — will be cloned
        } else {
            var env: MEnv = env_from_params(fd.params);
            var rb: RStmts = mono_stmts(fd.body, env, funcs, ins, fd.ret_type);
            ins = rb.rins3;
            rewritten = rewritten.append(FuncDecl {
                name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type,
                type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: rb.rstmts, line: fd.line, col: fd.col,
                import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str
            });
        }
        i = i + 1;
    }
    // Rewrite top-level stmts too.
    var topenv: MEnv = MEnv { mnames: [], mtypes: [] };
    var tr: RStmts = mono_stmts(mod.top_stmts, topenv, funcs, ins, "");
    ins = tr.rins3;

    // Worklist: generate clones; a clone's own body may call bounded
    // generics, adding new instantiations.
    var done: Insts = Insts { inames: [], itypes: [], iargs: [] };
    var wi: i32 = 0;
    while (wi < ins.inames.len()) {
        var nm: string = ins.inames[wi];
        var ct: string = ins.itypes[wi];
        if (done.ihas(nm, ct)) { wi = wi + 1; continue; }
        done = done.iadd(nm, ct);
        var gi: i32 = bg_index(funcs, nm);
        if (gi >= 0) {
            var cl: FuncDecl = clone_bg(funcs[gi], ct);
            // Rewrite the clone's body so any bounded-generic calls it
            // makes resolve too (and enqueue their instantiations).
            var cenv: MEnv = env_from_params(cl.params);
            var crb: RStmts = mono_stmts(cl.body, cenv, funcs, ins, cl.ret_type);
            ins = crb.rins3;
            rewritten = rewritten.append(FuncDecl {
                name: cl.name, receiver_name: "", receiver_type: "",
                type_params: cl.type_params, params: cl.params, ret_type: cl.ret_type, body: crb.rstmts, line: cl.line, col: cl.col,
                import_iface: cl.import_iface, import_wit: cl.import_wit, type_param_count: cl.type_param_count, bound_traits: [], fip: cl.fip, ret_str: cl.ret_str
            });
        }
        wi = wi + 1;
    }

    return Module {
        funcs: rewritten,
        structs: mod.structs,
        aliases: mod.aliases,
        imports: mod.imports,
        top_stmts: tr.rstmts,
        enums: mod.enums,
        resources: mod.resources,
        exports: mod.exports,
        impls: mod.impls,
        trait_reqs: mod.trait_reqs
    };
}

// ---- generic-struct monomorphisation --------------------------------
// The self-host historically erased generic struct type parameters: a
// `Box[i32]` and a `Box[string]` shared one untyped "Box" shape. That's
// fine when the type argument is a heap value (its runtime shape drives
// method dispatch) but breaks for a primitive/string `T`, because then
// `self.v` has static type "T" and `self.v.to_string()` can't be
// dispatched (no shape header on a raw i32). This pass clones each
// generic struct per concrete instantiation (`Box[i32]` -> `Box__i32`
// with `v: i32`), re-points its @derive- and `impl`-synthesised methods
// at the clone, and rewrites every annotation + struct literal to the
// mangled name — so the field types are concrete and dispatch resolves
// statically (the same `f__<key>` scheme the function monomorphiser
// uses). A no-op when no struct is generic (the self-host source +
// stdlib use none), which keeps the byte-identical fixpoint.

// TyIns threads a rewritten type string alongside the running
// instantiation accumulator.
struct TyIns { ty: string, mins: Insts }
// FRes threads a rewritten function alongside the accumulator.
struct FRes { ffn: FuncDecl, fins: Insts }

// gstruct_index returns the index of the generic struct named `base` in
// `gstructs`, or -1.
function gstruct_index(gstructs: StructDecl[], base: string): i32 {
    var i: i32 = 0;
    while (i < gstructs.len()) {
        if (gstructs[i].name == base) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// strip_struct_base returns a (possibly generic) receiver/struct type's
// base name: `Box` / `Box[T]` / `Box[i32]` all yield "Box".
function strip_struct_base(ty: string): string {
    var lb: i32 = first_bracket(ty);
    if (lb > 0) { return ty[0 : lb] + ""; }
    return ty;
}

// mg_ty mangles a generic-struct reference inside a type string to its
// monomorphised clone name (`Box[i32]` -> `Box__i32`), recursing through
// an array suffix and nested generic arguments, recording each
// instantiation it discovers. Non-generic types pass through unchanged.
function mg_ty(ty: string, gstructs: StructDecl[], ins: Insts): TyIns {
    if (type_ends_arr(ty)) {
        var r: TyIns = mg_ty(ty[0 : ty.len() - 2], gstructs, ins);
        return TyIns { ty: r.ty + "[]", mins: r.mins };
    }
    if (ty.len() >= 2 && ty[0 : 1] == "(" && ty[ty.len() - 1 : ty.len()] == ")") {
        var tps: string[] = split_top_commas(ty[1 : ty.len() - 1]);
        var tcur: Insts = ins;
        var tnin2: string = "";
        var tk: i32 = 0;
        while (tk < tps.len()) {
            var tpr: TyIns = mg_ty(tps[tk], gstructs, tcur);
            tcur = tpr.mins;
            if (tk > 0) { tnin2 = tnin2 + ", "; }
            tnin2 = tnin2 + tpr.ty;
            tk = tk + 1;
        }
        return TyIns { ty: "(" + tnin2 + ")", mins: tcur };
    }
    var lb: i32 = first_bracket(ty);
    if (lb > 0 && ty[ty.len() - 1 : ty.len()] == "]") {
        var base: str = ty[0 : lb];
        var inner: str = ty[lb + 1 : ty.len() - 1];
        var parts: string[] = split_top_commas(inner);
        if (gstruct_index(gstructs, base) >= 0) {
            var cur: Insts = ins;
            var key: string = "";
            var j: i32 = 0;
            while (j < parts.len()) {
                var pr: TyIns = mg_ty(parts[j], gstructs, cur);
                cur = pr.mins;
                if (j > 0) { key = key + "__"; }
                key = key + pr.ty;
                j = j + 1;
            }
            cur = cur.iadd(base, key);
            return TyIns { ty: base + "__" + sanitize_key(key), mins: cur };
        }
        // A NON-generic-struct generic base — a built-in `Option`/`Result` or a
        // user generic ENUM (`Opt[Box[i32]]`). The base itself isn't mangled
        // here (the enum pass, which runs after, keys it), but recurse into its
        // args so a NESTED generic-struct argument is monomorphised to its clone
        // name (`Opt[Box[i32]]` -> `Opt[Box__i32]`); the enum pass then sees a
        // plain nominal arg it can key. Args with no generic struct pass through
        // unchanged. Only fires when a generic struct exists in the module (the
        // whole pass is a no-op otherwise), so it is fixpoint-safe.
        var cur2: Insts = ins;
        var ninner: string = "";
        var k: i32 = 0;
        while (k < parts.len()) {
            var pr2: TyIns = mg_ty(parts[k], gstructs, cur2);
            cur2 = pr2.mins;
            if (k > 0) { ninner = ninner + ", "; }
            ninner = ninner + pr2.ty;
            k = k + 1;
        }
        return TyIns { ty: base + "[" + ninner + "]", mins: cur2 };
    }
    return TyIns { ty: ty, mins: ins };
}

// to_concrete_struct_ty resolves a method's substituted type string to
// the concrete clone name: a bare base (`Box`, from a @derive method's
// `other: Box` param) becomes the mangled name directly; an arg form
// (`Box[i32]`, from a parametric `impl[T]`) goes through mg_ty.
function to_concrete_struct_ty(ty: string, base: string, mang: string, gstructs: StructDecl[]): string {
    if (ty == base) { return mang; }
    var fresh: Insts = Insts { inames: [], itypes: [], iargs: [] };
    return mg_ty(ty, gstructs, fresh).ty;
}

// infer_lit_key infers the concrete instantiation key for a struct
// literal of generic struct `gd` from its field values — unifying each
// value's inferred type against the field's declared type, exactly the
// way a call's arguments pin its type parameters. Returns "" if any type
// parameter is left unbound (the literal then stays erased).
function infer_lit_key(gd: StructDecl, fnames: string[], fvals: Expr[], env: MEnv, funcs: FuncDecl[]): string {
    var binds: MEnv = MEnv { mnames: [], mtypes: [] };
    var fi: i32 = 0;
    while (fi < gd.fields.len()) {
        var fname: string = gd.fields[fi].name;
        var vi: i32 = 0;
        while (vi < fnames.len()) {
            if (fnames[vi] == fname) {
                var ct: string = mono_infer(fvals[vi], env, funcs);
                if (ct.len() > 0) {
                    binds = bind_unify(gd.fields[fi].type_name, ct, gd.type_params, binds);
                }
            }
            vi = vi + 1;
        }
        fi = fi + 1;
    }
    var key: string = "";
    var k: i32 = 0;
    while (k < gd.type_params.len()) {
        var b: string = binds.elook(gd.type_params[k]);
        if (b.len() == 0) { return ""; }
        if (k > 0) { key = key + "__"; }
        key = key + b;
        k = k + 1;
    }
    return key;
}

// ms_expr rewrites a struct literal of a generic struct to its mangled
// clone name (inferring the key from field values) and recurses through
// every sub-expression, threading the instantiation accumulator.
function ms_expr(e: Expr, env: MEnv, gstructs: StructDecl[], funcs: FuncDecl[], ins: Insts): RExpr {
    match (e) {
        ExprBinary(b) => {
            var l: RExpr = ms_expr(b.left, env, gstructs, funcs, ins);
            var r: RExpr = ms_expr(b.right, env, gstructs, funcs, l.rins);
            return RExpr { rexpr: ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col }, rins: r.rins };
        },
        ExprUnary(u) => {
            var o: RExpr = ms_expr(u.operand, env, gstructs, funcs, ins);
            return RExpr { rexpr: ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col }, rins: o.rins };
        },
        ExprCall(c) => {
            var rc: RExpr = ms_expr(c.callee, env, gstructs, funcs, ins);
            var cur: Insts = rc.rins;
            var nargs: Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) {
                var ra: RExpr = ms_expr(c.args[i], env, gstructs, funcs, cur);
                cur = ra.rins;
                nargs = nargs.append(ra.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: cur };
        },
        ExprArray(a) => {
            var els: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < a.elements.len()) {
                var re: RExpr = ms_expr(a.elements[i], env, gstructs, funcs, cur);
                cur = re.rins;
                els = els.append(re.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprArray { elements: els }, rins: cur };
        },
        ExprTuple(t) => {
            var els: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < t.elements.len()) {
                var re: RExpr = ms_expr(t.elements[i], env, gstructs, funcs, cur);
                cur = re.rins;
                els = els.append(re.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprTuple { elements: els, line: t.line, col: t.col }, rins: cur };
        },
        ExprIndex(ix) => {
            var ar: RExpr = ms_expr(ix.array, env, gstructs, funcs, ins);
            var idx: RExpr = ms_expr(ix.index, env, gstructs, funcs, ar.rins);
            return RExpr { rexpr: ExprIndex { array: ar.rexpr, index: idx.rexpr, unchecked: false }, rins: idx.rins };
        },
        ExprSlice(sl) => {
            var ar: RExpr = ms_expr(sl.array, env, gstructs, funcs, ins);
            var st: RExpr = ms_expr(sl.start, env, gstructs, funcs, ar.rins);
            var en: RExpr = ms_expr(sl.end, env, gstructs, funcs, st.rins);
            return RExpr { rexpr: ExprSlice { array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
        },
        ExprFieldAccess(fa) => {
            var o: RExpr = ms_expr(fa.obj, env, gstructs, funcs, ins);
            return RExpr { rexpr: ExprFieldAccess { obj: o.rexpr, field: fa.field, line: fa.line, col: fa.col }, rins: o.rins };
        },
        ExprStructLit(s) => {
            var cur: Insts = ins;
            var vals: Expr[] = [];
            var i: i32 = 0;
            while (i < s.field_values.len()) {
                var rv: RExpr = ms_expr(s.field_values[i], env, gstructs, funcs, cur);
                cur = rv.rins;
                vals = vals.append(rv.rexpr);
                i = i + 1;
            }
            var rb: RExpr = ms_expr(s.base, env, gstructs, funcs, cur);
            cur = rb.rins;
            var tn: string = s.type_name;
            var gi: i32 = gstruct_index(gstructs, s.type_name);
            if (gi >= 0) {
                var key: string = infer_lit_key(gstructs[gi], s.field_names, vals, env, funcs);
                if (key.len() > 0) {
                    tn = s.type_name + "__" + sanitize_key(key);
                    cur = cur.iadd(s.type_name, key);
                }
            }
            return RExpr { rexpr: ExprStructLit { type_name: tn, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: rb.rexpr, line: s.line, col: s.col }, rins: cur };
        },
        ExprLambda(lm) => {
            var bodyr: RStmts = ms_stmts(lm.body, env, gstructs, funcs, ins, "");
            var rt: TyIns = mg_ty(lm.ret_type, gstructs, bodyr.rins3);
            var nparams: ParamDecl[] = [];
            var pcur: Insts = rt.mins;
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                var pt: TyIns = mg_ty(lm.params[pi].type_name, gstructs, pcur);
                pcur = pt.mins;
                nparams = nparams.append(ParamDecl { name: lm.params[pi].name, type_name: pt.ty, own: lm.params[pi].own, has_default: lm.params[pi].has_default, default_value: lm.params[pi].default_value, ret_arr: lm.params[pi].ret_arr, fn_ret: lm.params[pi].fn_ret, fn_param_dyn: lm.params[pi].fn_param_dyn });
                pi = pi + 1;
            }
            return RExpr { rexpr: ExprLambda { params: nparams, ret_type: rt.ty, body: bodyr.rstmts, use_infer: false }, rins: pcur };
        },
        _ => { return RExpr { rexpr: e, rins: ins }; }
    }
    return RExpr { rexpr: e, rins: ins };
}

// retype_assoc_ctor rewrites a receiver-less associated call on a GENERIC
// struct base — `Box.default()` — to its monomorphised name
// `Box__Inner.default()` when the binding's annotation pins the instantiation
// (`var b: Box[Inner] = Box.default()`). A receiver-less constructor has no
// arguments to infer its type params from, so the instantiation is taken from
// the annotation (`concrete` = the mangled struct name `Box__Inner`); the
// matching method clone is `<concrete>.<method>`. The generic-struct guard
// keeps a plain `mod.func()` untouched. Other inits pass through.
function retype_assoc_ctor(init: Expr, concrete: string, gstructs: StructDecl[]): Expr {
    match (init) {
        ExprCall(c) => {
            match (c.callee) {
                ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        ExprIdent(oid) => {
                            if (gstruct_index(gstructs, oid.name) >= 0) {
                                var pfx: string = oid.name + "__";
                                if (concrete.len() > pfx.len() && concrete[0 : pfx.len()] == pfx) {
                                    return ExprCall { callee: ExprFieldAccess { obj: ExprIdent { name: concrete, line: oid.line, col: oid.col }, field: fa.field, line: fa.line, col: fa.col }, args: c.args, line: c.line, col: c.col, type_argc: c.type_argc };
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return init;
}

// retype_struct_lit re-keys a still-generic struct literal from its binding's
// annotation when the field values alone couldn't pin the instantiation. The
// motivating case is a generic struct of a generic ENUM (`var b: Box[Opt[i32]]
// = Box { v: Sm(5) }`): infer_lit_key can't infer `Opt[i32]` from the variant
// construction `Sm(5)` (mono_infer doesn't key variant calls), so the literal
// stays the bare generic `Box` and dangles. The annotation already mangled to
// `concrete` (`Box__Opt__i32`) and mg_ty recorded that instantiation, so we
// just re-point the literal's type name at it — the enum pass then keys the
// inner `Sm(5)` from the clone's `v: Opt[i32]` field type. Mirrors
// retype_assoc_ctor (the constructor-call analogue). A literal ms_expr already
// keyed (its base is a mangled clone, not a generic base) is left untouched, as
// is a non-matching annotation. See #3694.
function retype_struct_lit(init: Expr, concrete: string, gstructs: StructDecl[]): Expr {
    match (init) {
        ExprStructLit(s) => {
            if (gstruct_index(gstructs, s.type_name) >= 0) {
                var pfx: string = s.type_name + "__";
                if (concrete.len() > pfx.len() && concrete[0 : pfx.len()] == pfx) {
                    return ExprStructLit { type_name: concrete, field_names: s.field_names, field_values: s.field_values, has_base: s.has_base, base: s.base, line: s.line, col: s.col };
                }
            }
        },
        _ => {}
    }
    return init;
}

// ms_stmt rewrites one statement: generic-struct annotations on a `var`
// go through mg_ty, struct literals through ms_expr, threading env+ins.
function ms_stmt(st: Stmt, env: MEnv, gstructs: StructDecl[], funcs: FuncDecl[], ins: Insts, ret_ty: string): RStmtOne {
    match (st) {
        StmtVar(v) => {
            var iv: RExpr = ms_expr(v.init, env, gstructs, funcs, ins);
            var ta: TyIns = mg_ty(v.type_name, gstructs, iv.rins);
            // A receiver-less associated constructor `Box.default()` bound to a
            // generic-struct annotation takes its instantiation from that
            // annotation: rewrite it to `Box__Inner.default()`.
            var ninit: Expr = retype_struct_lit(retype_assoc_ctor(iv.rexpr, ta.ty, gstructs), ta.ty, gstructs);
            return RStmtOne { rstmt: StmtVar { name: v.name, type_name: ta.ty, init: ninit, line: v.line, col: v.col, is_str: false }, renv: env.ebind(v.name, ta.ty), rins2: ta.mins };
        },
        StmtReturn(r) => {
            var rv: RExpr = ms_expr(r.value, env, gstructs, funcs, ins);
            // A `return Box { xs: [] }` whose instantiation can't be inferred
            // from the field values (an empty-array field yields no element
            // type) takes it from the FUNCTION's concrete return type — the
            // return-position sibling of the StmtVar annotation retype above.
            // Without this a monomorphised no-arg constructor's generic struct
            // literal stays "Box" and can't lower (std/set's set_new).
            var nret: Expr = retype_struct_lit(rv.rexpr, ret_ty, gstructs);
            return RStmtOne { rstmt: StmtReturn { value: nret, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
        },
        StmtExpr(x) => {
            var xv: RExpr = ms_expr(x.value, env, gstructs, funcs, ins);
            return RStmtOne { rstmt: StmtExpr { value: xv.rexpr }, renv: env, rins2: xv.rins };
        },
        StmtAssign(a) => {
            var av: RExpr = ms_expr(a.value, env, gstructs, funcs, ins);
            return RStmtOne { rstmt: StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
        },
        StmtIf(f) => {
            var cv: RExpr = ms_expr(f.cond, env, gstructs, funcs, ins);
            var tb: RStmts = ms_stmts(f.then_body, env, gstructs, funcs, cv.rins, ret_ty);
            var eb: RStmts = ms_stmts(f.else_body, env, gstructs, funcs, tb.rins3, ret_ty);
            return RStmtOne { rstmt: StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts }, renv: env, rins2: eb.rins3 };
        },
        StmtWhile(w) => {
            var cv: RExpr = ms_expr(w.cond, env, gstructs, funcs, ins);
            var wb: RStmts = ms_stmts(w.body, env, gstructs, funcs, cv.rins, ret_ty);
            return RStmtOne { rstmt: StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label }, renv: env, rins2: wb.rins3 };
        },
        StmtFor(fr) => {
            var it: RExpr = ms_expr(fr.iter, env, gstructs, funcs, ins);
            var benv: MEnv = env.ebind(fr.var_name, "");
            var fb: RStmts = ms_stmts(fr.body, benv, gstructs, funcs, it.rins, ret_ty);
            return RStmtOne { rstmt: StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label }, renv: env, rins2: fb.rins3 };
        },
        StmtMatch(m) => {
            var sv: RExpr = ms_expr(m.scrutinee, env, gstructs, funcs, ins);
            var arms: MatchArm[] = [];
            var cur: Insts = sv.rins;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var ab: RStmts = ms_stmts(m.arms[i].body, env, gstructs, funcs, cur, ret_ty);
                cur = ab.rins3;
                arms = arms.append(MatchArm { pattern: m.arms[i].pattern, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: m.arms[i].guard, has_guard: m.arms[i].has_guard });
                i = i + 1;
            }
            return RStmtOne { rstmt: StmtMatch { scrutinee: sv.rexpr, arms: arms, line: m.line, col: m.col, origin: m.origin }, renv: env, rins2: cur };
        },
        _ => { return RStmtOne { rstmt: st, renv: env, rins2: ins }; }
    }
    return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

// ms_stmts walks a statement list, threading the (block-local) env. `ret_ty`
// is the enclosing function's concrete (mangled) return type, used to retype a
// `return <generic struct literal>` whose instantiation the field values can't
// supply; "" at top-level / for non-struct returns (a no-op there).
function ms_stmts(stmts: Stmt[], env: MEnv, gstructs: StructDecl[], funcs: FuncDecl[], ins: Insts, ret_ty: string): RStmts {
    var out: Stmt[] = [];
    var e2: MEnv = env;
    var cur: Insts = ins;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var rs: RStmtOne = ms_stmt(stmts[i], e2, gstructs, funcs, cur, ret_ty);
        out = out.append(rs.rstmt);
        e2 = rs.renv;
        cur = rs.rins2;
        i = i + 1;
    }
    return RStmts { rstmts: out, rins3: cur };
}

// ms_func rewrites a non-generic function's param/return/receiver
// annotations and body, recording any generic-struct instantiation used.
function ms_func(fn: FuncDecl, gstructs: StructDecl[], funcs: FuncDecl[], ins: Insts): FRes {
    var cur: Insts = ins;
    var nparams: ParamDecl[] = [];
    var i: i32 = 0;
    while (i < fn.params.len()) {
        var pt: TyIns = mg_ty(fn.params[i].type_name, gstructs, cur);
        cur = pt.mins;
        nparams = nparams.append(ParamDecl { name: fn.params[i].name, type_name: pt.ty, own: fn.params[i].own, has_default: fn.params[i].has_default, default_value: fn.params[i].default_value, ret_arr: fn.params[i].ret_arr, fn_ret: fn.params[i].fn_ret, fn_param_dyn: fn.params[i].fn_param_dyn });
        i = i + 1;
    }
    var rt: TyIns = mg_ty(fn.ret_type, gstructs, cur);
    cur = rt.mins;
    var rcv: TyIns = mg_ty(fn.receiver_type, gstructs, cur);
    cur = rcv.mins;
    var br: RStmts = ms_stmts(fn.body, env_from_params(fn.params), gstructs, funcs, cur, rt.ty);
    cur = br.rins3;
    return FRes {
        ffn: FuncDecl {
            name: fn.name, receiver_name: fn.receiver_name, receiver_type: rcv.ty,
            type_params: fn.type_params, params: nparams, ret_type: rt.ty, body: br.rstmts, line: fn.line, col: fn.col,
            import_iface: fn.import_iface, import_wit: fn.import_wit, type_param_count: fn.type_param_count, bound_traits: [], fip: fn.fip, ret_str: fn.ret_str
        },
        fins: cur
    };
}

// clone_struct_method builds the per-instantiation clone of a generic
// struct's method (a @derive-synthesised one with a bare `Box` receiver,
// or a parametric-`impl` one with a `Box[T]` receiver + type params),
// substituting the type variables and re-pointing receiver/params/return
// at the mangled clone name. The body's `var T` annotations are
// substituted; its literal display strings (baked from the original
// struct's name at synth time) stay intact.
function clone_struct_method(m: FuncDecl, base: string, key: string, gstructs: StructDecl[]): FuncDecl {
    // Substitute with the generic STRUCT's type params (not the method's, which
    // a synthesized method like default() leaves empty). The struct's params are
    // the ones a method body refers to — e.g. a derived default()'s
    // `T.default()`; subst_stmts rewrites both `var x: T` annotations and the
    // `T.default()` object. A parametric-impl method's own type params match the
    // struct's, so this is equivalent for those.
    var gsi: i32 = gstruct_index(gstructs, base);
    var tparams: string[] = m.type_params;
    if (gsi >= 0) { tparams = gstructs[gsi].type_params; }
    // A single-type-param key is the one concrete arg verbatim (a mangled
    // nested clone like `Box__i32` must not be split on `__`); multi-param
    // keys split unambiguously into per-param pieces.
    var cts: string[] = [key];
    if (tparams.len() != 1) { cts = split_dunder(key); }
    var mang: string = base + "__" + sanitize_key(key);
    // finalize_impl_method (at parse time) bakes the BARE source struct name
    // into a generic impl method's `Self` positions, but the struct is
    // registered module-prefixed (`iter__ArrayIter`). Normalise the bare base
    // back to the prefixed `base` so to_concrete_struct_ty / mg_ty can mangle a
    // nested `Self` instantiation (`Option[(i32, ArrayIter[i32])]` ->
    // `Option[(i32, iter__ArrayIter__i32)]`) in the clone's return / params.
    var bsegs: string[] = split_dunder(base);
    var bare_base: string = bsegs[bsegs.len() - 1];
    var nparams: ParamDecl[] = [];
    var i: i32 = 0;
    while (i < m.params.len()) {
        var psrc: string = replace_struct_ident(m.params[i].type_name, bare_base, base);
        var pt: string = to_concrete_struct_ty(subst_ty(psrc, tparams, cts), base, mang, gstructs);
        nparams = nparams.append(ParamDecl { name: m.params[i].name, type_name: pt, own: m.params[i].own, has_default: m.params[i].has_default, default_value: m.params[i].default_value, ret_arr: m.params[i].ret_arr, fn_ret: m.params[i].fn_ret, fn_param_dyn: m.params[i].fn_param_dyn });
        i = i + 1;
    }
    var rsrc: string = replace_struct_ident(m.ret_type, bare_base, base);
    var rt: string = to_concrete_struct_ty(subst_ty(rsrc, tparams, cts), base, mang, gstructs);
    var notp: string[] = [];
    return FuncDecl {
        name: m.name, receiver_name: m.receiver_name, receiver_type: mang,
        type_params: notp, params: nparams, ret_type: rt,
        body: retarget_self_lit_stmts(subst_stmts(m.body, tparams, cts), base, mang), line: m.line, col: m.col,
        import_iface: m.import_iface, import_wit: m.import_wit, type_param_count: m.type_param_count, bound_traits: [], fip: m.fip, ret_str: m.ret_str
    };
}

// monomorphize_structs clones every generic struct (and its methods) per
// concrete instantiation, rewriting all references to the mangled name.
// See the section comment above. Runs after function monomorphisation so
// it also sees the concrete `Box[i32]` annotations those clones produce.
pub function monomorphize_structs(mod: Module): Module {
    var gstructs: StructDecl[] = [];
    var gi: i32 = 0;
    while (gi < mod.structs.len()) {
        if (mod.structs[gi].type_params.len() > 0) { gstructs = gstructs.append(mod.structs[gi]); }
        gi = gi + 1;
    }
    if (gstructs.len() == 0) { return mod; }

    var ins: Insts = Insts { inames: [], itypes: [], iargs: [] };

    // Phase 1: rewrite all references; drop the generic decls.
    var nstructs: StructDecl[] = [];
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var sd: StructDecl = mod.structs[si];
        if (sd.type_params.len() == 0) {
            var nf: StructFieldDecl[] = [];
            var fj: i32 = 0;
            while (fj < sd.fields.len()) {
                var ft: TyIns = mg_ty(sd.fields[fj].type_name, gstructs, ins);
                ins = ft.mins;
                nf = nf.append(StructFieldDecl { name: sd.fields[fj].name, type_name: ft.ty, fn_ret: sd.fields[fj].fn_ret });
                fj = fj + 1;
            }
            nstructs = nstructs.append(StructDecl { name: sd.name, fields: nf, type_params: [], derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume });
        }
        si = si + 1;
    }

    var nfuncs: FuncDecl[] = [];
    var fi2: i32 = 0;
    while (fi2 < mod.funcs.len()) {
        var fn: FuncDecl = mod.funcs[fi2];
        var rbase: string = strip_struct_base(fn.receiver_type);
        if (fn.receiver_type.len() > 0 && gstruct_index(gstructs, rbase) >= 0) {
            // generic-struct method OR receiver-less associated fn (a derived
            // `default()`, receiver_name "") — dropped here, cloned in phase 2.
        } else {
            var fr: FRes = ms_func(fn, gstructs, mod.funcs, ins);
            ins = fr.fins;
            nfuncs = nfuncs.append(fr.ffn);
        }
        fi2 = fi2 + 1;
    }

    var topenv: MEnv = MEnv { mnames: [], mtypes: [] };
    var tr: RStmts = ms_stmts(mod.top_stmts, topenv, gstructs, mod.funcs, ins, "");
    ins = tr.rins3;

    // Phase 2: generate clones; a worklist covers clones whose own field
    // types / method bodies reference further instantiations.
    var done: Insts = Insts { inames: [], itypes: [], iargs: [] };
    var wi: i32 = 0;
    while (wi < ins.inames.len()) {
        var base: string = ins.inames[wi];
        var key: string = ins.itypes[wi];
        if (done.ihas(base, key)) { wi = wi + 1; continue; }
        done = done.iadd(base, key);
        var idx: i32 = gstruct_index(gstructs, base);
        if (idx >= 0) {
            var gd: StructDecl = gstructs[idx];
            // A single-type-param struct's key IS the one concrete arg verbatim
            // (which may itself be a mangled nested clone like `Box__i32`, so
            // splitting on `__` would wrongly fracture it). A multi-param key is
            // the `__`-join of simple nominals and splits unambiguously.
            var cts: string[] = [key];
            if (gd.type_params.len() != 1) { cts = split_dunder(key); }
            var mang: string = base + "__" + sanitize_key(key);
            var cf: StructFieldDecl[] = [];
            var cfi: i32 = 0;
            while (cfi < gd.fields.len()) {
                var subbed: string = subst_ty(gd.fields[cfi].type_name, gd.type_params, cts);
                var ft2: TyIns = mg_ty(subbed, gstructs, ins);
                ins = ft2.mins;
                cf = cf.append(StructFieldDecl { name: gd.fields[cfi].name, type_name: ft2.ty, fn_ret: subst_ty(gd.fields[cfi].fn_ret, gd.type_params, cts) });
                cfi = cfi + 1;
            }
            nstructs = nstructs.append(StructDecl { name: mang, fields: cf, type_params: [], derives: gd.derives, line: gd.line, col: gd.col, enum_owner: gd.enum_owner, must_consume: gd.must_consume });
            var mi: i32 = 0;
            while (mi < mod.funcs.len()) {
                var mm: FuncDecl = mod.funcs[mi];
                if (mm.receiver_type.len() > 0 && strip_struct_base(mm.receiver_type) == base) {
                    var clm: FuncDecl = clone_struct_method(mm, base, key, gstructs);
                    var br2: RStmts = ms_stmts(clm.body, env_from_params(clm.params), gstructs, mod.funcs, ins, clm.ret_type);
                    ins = br2.rins3;
                    nfuncs = nfuncs.append(FuncDecl {
                        name: clm.name, receiver_name: clm.receiver_name, receiver_type: clm.receiver_type,
                        type_params: clm.type_params, params: clm.params, ret_type: clm.ret_type, body: br2.rstmts, line: clm.line, col: clm.col,
                        import_iface: clm.import_iface, import_wit: clm.import_wit, type_param_count: clm.type_param_count, bound_traits: [], fip: clm.fip, ret_str: clm.ret_str
                    });
                }
                mi = mi + 1;
            }
        }
        wi = wi + 1;
    }

    return Module {
        funcs: nfuncs,
        structs: nstructs,
        aliases: mod.aliases,
        imports: mod.imports,
        top_stmts: tr.rstmts,
        enums: mod.enums,
        resources: mod.resources,
        exports: mod.exports,
        impls: mod.impls,
        trait_reqs: mod.trait_reqs
    };
}

// ---- generic-enum monomorphisation ----------------------------------
// The self-host historically erased generic enum type parameters: an
// `Opt[i32]` and an `Opt[string]` shared one untyped "Opt" shape, so the
// variant payload type stayed the bare type variable `T` and the IR path
// couldn't resolve a payload's primitive methods (`s.len()` on a string
// payload mis-dispatched) — so the whole module bailed to the legacy AST
// emitter. This pass mirrors monomorphize_structs for enums: clone each
// generic enum per concrete instantiation (`Opt[i32]` → `Opt__i32` with
// `Sm__i32(i32)`), mangle the variant CONSTRUCTION call sites and `match`
// arm patterns to the clone, rewrite the `Opt[i32]` annotations to
// `Opt__i32`, and wire the cloned enums + variant structs into the
// returned Module (the generic originals are dropped). Scope: a generic
// enum with NO associated methods/derives and a key whose every type arg
// is a simple nominal (primitive / string / bare struct). A method-bearing
// generic enum, or an instantiation with a composite key (`Opt[Box[i32]]`),
// is left untouched — its references aren't rewritten and its decls aren't
// dropped, so it keeps its pre-existing (un-monomorphised) behaviour
// instead of dangling. The compiler source + stdlib use no generic enums,
// so the pass is a no-op there (fixpoint-safe), exactly like the
// generic-struct pass. See issue #3572.

// enum_has_method reports whether any function is an associated function /
// method of the enum named `ename` (receiver type strips to `ename`).
function enum_has_method(funcs: FuncDecl[], ename: string): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].receiver_type.len() > 0 && strip_struct_base(funcs[i].receiver_type) == ename) { return true; }
        i = i + 1;
    }
    return false;
}

// genum_is_mono reports whether the enum named `name` is a generic enum
// the pass will monomorphise: it has type params and no associated methods.
function genum_is_mono(enums: EnumDecl[], funcs: FuncDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (enums[i].name == name && enums[i].type_params.len() > 0) {
            return !enum_has_method(funcs, name);
        }
        i = i + 1;
    }
    return false;
}

// genum_index returns the index of the generic EnumDecl named `name`, or -1.
function genum_index(enums: EnumDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (enums[i].name == name && enums[i].type_params.len() > 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// genum_owner_of_variant returns the index of the monomorphisable generic
// enum whose variant list contains `vname`, or -1. (Variant names are
// effectively global in the desugared struct table, so a bare `Sm`
// construction resolves to its enum this way.)
function genum_owner_of_variant(enums: EnumDecl[], funcs: FuncDecl[], vname: string): i32 {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (enums[i].type_params.len() > 0 && !enum_has_method(funcs, enums[i].name)) {
            var vn: string[] = enums[i].variant_names;
            var j: i32 = 0;
            while (j < vn.len()) {
                if (vn[j] == vname) { return i; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// is_simple_key reports whether an instantiation key is a `__`-join of
// simple nominal tokens (no `[`, no space) — the in-scope shape. A
// composite key (`Box[i32]`, a tuple) is rejected so the instantiation
// is left un-monomorphised rather than producing a malformed symbol.
function is_simple_key(key: string): boolean {
    if (key.len() == 0) { return false; }
    if (util.contains(key, "[")) { return false; }
    if (util.contains(key, " ")) { return false; }
    if (util.contains(key, "(")) { return false; }
    return true;
}

// genum_single_arg returns the single top-level type argument of a
// `Base[arg]` spelling (the in-scope nested shape has exactly one), or "".
function genum_single_arg(ty: string): string {
    var lb: i32 = first_bracket(ty);
    if (lb <= 0) { return ""; }
    if (ty[ty.len() - 1 : ty.len()] != "]") { return ""; }
    var parts: string[] = split_top_commas(ty[lb + 1 : ty.len() - 1]);
    if (parts.len() != 1) { return ""; }
    return parts[0];
}

// genum_key_from_anno extracts the instantiation key from a type spelling
// `Base[arg, …]` when Base == base, else "". A single-type-param enum may
// take a NESTED generic-enum arg (`Opt[Opt[i32]]` → key `Opt__i32`), keyed
// recursively via ge_targ_mangle; a multi-param enum keeps the pre-existing
// scope — every arg must be a simple nominal, since the `__` join is
// ambiguous once an arg is itself composite.
function genum_key_from_anno(ty: string, base: string, enums: EnumDecl[], funcs: FuncDecl[]): string {
    var lb: i32 = first_bracket(ty);
    if (lb <= 0) { return ""; }
    if (ty[ty.len() - 1 : ty.len()] != "]") { return ""; }
    if (ty[0 : lb] != base) { return ""; }
    var parts: string[] = split_top_commas(ty[lb + 1 : ty.len() - 1]);
    if (parts.len() == 1) {
        return ge_targ_mangle(parts[0], enums, funcs);
    }
    var key: string = "";
    var j: i32 = 0;
    while (j < parts.len()) {
        if (j > 0) { key = key + "__"; }
        var p: string = parts[j];
        if (first_bracket(p) >= 0) { return ""; }
        if (util.contains(p, " ")) { return ""; }
        if (util.contains(p, "(")) { return ""; }
        key = key + p;
        j = j + 1;
    }
    return key;
}

// GEInst describes a recognised generic-enum instantiation derived from a
// type spelling: ok, the base enum name, the `__`-joined key, and the
// mangled enum name `Base__key`.
struct GEInst { ok: boolean, base: string, key: string, mang: string }

// ge_inst_of recognises a type spelling as a monomorphisable generic-enum
// instantiation (`Opt[i32]` → ok, base "Opt", key "i32", mang "Opt__i32").
// A bare base / non-generic / method-bearing / composite-key spelling
// yields ok=false.
function ge_inst_of(ty: string, enums: EnumDecl[], funcs: FuncDecl[]): GEInst {
    var lb: i32 = first_bracket(ty);
    if (lb <= 0) { return GEInst { ok: false, base: "", key: "", mang: "" }; }
    if (ty[ty.len() - 1 : ty.len()] != "]") { return GEInst { ok: false, base: "", key: "", mang: "" }; }
    var base: str = ty[0 : lb];
    if (!genum_is_mono(enums, funcs, base)) { return GEInst { ok: false, base: "", key: "", mang: "" }; }
    var key: string = genum_key_from_anno(ty, base, enums, funcs);
    if (key.len() == 0) { return GEInst { ok: false, base: "", key: "", mang: "" }; }
    return GEInst { ok: true, base: base + "", key: key, mang: base + "__" + key };
}

// fn_key_sanitize maps a fn type spelling into a token safe to embed in a `__`
// symbol name — every char outside [A-Za-z0-9_] becomes '_'. Mirrors native's
// `sanitize` (internal/monomorph/monomorph.go) so a fn type argument
// (`(i32) => i32`) keys to `_i32_____i32` instead of dragging its parens /
// spaces / `=>` into an unassemblable symbol. (The sibling `sanitize_key`
// above handles only bracket/comma keys and is shared with fn/struct mangling,
// so a fn-only transform stays out of its blast radius.)
function fn_key_sanitize(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var c: i32 = s[i];
        var alnum: boolean = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (alnum) { out = out + s[i : i + 1]; } else { out = out + "_"; }
        i = i + 1;
    }
    return out;
}

// pk_is_fn_spelling reports whether `t` is a single-parameter-list function
// type spelling — `(...) => R` with no depth-1 comma (a top-level comma is a
// tuple, not a param list). The self-host sibling of irlower's
// is_fn_payload_spelling; lets ge_targ_mangle admit a fn type arg as a
// (sanitised) monomorphisation key.
function pk_is_fn_spelling(t: string): boolean {
    var n: i32 = t.len();
    if (n < 5) { return false; }
    if (t[0] != 40) { return false; }
    var depth: i32 = 0;
    var i: i32 = 0;
    var close: i32 = 0 - 1;
    while (i < n) {
        var ch: i32 = t[i];
        if (ch == 40 || ch == 91) { depth = depth + 1; }
        else if (ch == 41 || ch == 93) { depth = depth - 1; if (depth == 0 && ch == 41) { close = i; i = n; } }
        else if (ch == 44 && depth == 1) { return false; }
        i = i + 1;
    }
    if (close < 0) { return false; }
    var j: i32 = close + 1;
    while (j < n && t[j] == 32) { j = j + 1; }
    if (j + 1 >= n) { return false; }
    return t[j] == 61 && t[j + 1] == 62;
}

// fn_spelling_ret returns the result-type spelling of a fn type
// (`(i32) => Opt[i32]` → `Opt[i32]`), or "" when `t` is not a fn spelling. The
// coarsening below stores it on a variant fn field's fn_ret, matching how the
// parser records a source-written fn field (type_name "fn" + fn_ret).
function fn_spelling_ret(t: string): string {
    if (!pk_is_fn_spelling(t)) { return ""; }
    var n: i32 = t.len();
    var depth: i32 = 0;
    var i: i32 = 0;
    var close: i32 = 0 - 1;
    while (i < n) {
        var ch: i32 = t[i];
        if (ch == 40 || ch == 91) { depth = depth + 1; }
        else if (ch == 41 || ch == 93) { depth = depth - 1; if (depth == 0 && ch == 41) { close = i; i = n; } }
        i = i + 1;
    }
    var j: i32 = close + 1;
    while (j < n && t[j] == 32) { j = j + 1; }
    j = j + 2;                                   // skip "=>"
    while (j < n && t[j] == 32) { j = j + 1; }
    return t[j : n] + "";
}

// ge_targ_mangle mangles ONE generic-enum type argument to its `__` symbol
// form: a simple nominal (`i32`, `string`, a bare struct `P`) passes through;
// a NESTED monomorphisable generic-enum arg (`Opt[i32]`) recurses to its
// mangled clone name (`Opt__i32`); a fn type (`(i32) => i32`) sanitises to a
// symbol-safe token (native parity). Returns "" for an arg this pass still
// can't key (an array, tuple, generic struct, or a method-bearing /
// non-generic enum), so the enclosing instantiation bails to AST cleanly.
function ge_targ_mangle(arg: string, enums: EnumDecl[], funcs: FuncDecl[]): string {
    if (arg.len() == 0) { return ""; }
    if (pk_is_fn_spelling(arg)) { return fn_key_sanitize(arg); }
    var lb: i32 = first_bracket(arg);
    if (lb < 0) {
        if (util.contains(arg, " ")) { return ""; }
        if (util.contains(arg, "(")) { return ""; }
        return arg;
    }
    var gi: GEInst = ge_inst_of(arg, enums, funcs);
    if (gi.ok) { return gi.mang; }
    return "";
}

// me_rewrite_ty rewrites a generic-enum type spelling to its mangled clone
// name (`Opt[i32]` → `Opt__i32`); other spellings (incl. the `[]` array of
// a generic enum) pass through, recursing on the array element.
function me_rewrite_ty(ty: string, enums: EnumDecl[], funcs: FuncDecl[]): string {
    if (type_ends_arr(ty)) {
        return me_rewrite_ty(ty[0 : ty.len() - 2], enums, funcs) + "[]";
    }
    var gi: GEInst = ge_inst_of(ty, enums, funcs);
    if (gi.ok) { return gi.mang; }
    return ty;
}

// me_collect_anno records the instantiation a type spelling names (if any),
// recursing into a nested generic-enum argument (`Opt[Opt[i32]]` enqueues
// both `Opt[Opt[i32]]` and the inner `Opt[i32]`) so every clone the outer
// references gets generated in phase 2.
function me_collect_anno(ty: string, enums: EnumDecl[], funcs: FuncDecl[], ins: Insts): Insts {
    var t: string = ty;
    if (type_ends_arr(t)) { t = t[0 : t.len() - 2] + ""; }
    var gi: GEInst = ge_inst_of(t, enums, funcs);
    if (!gi.ok) { return ins; }
    var cur: Insts = ins.iadd_arg(gi.base, gi.key, genum_single_arg(t));
    var lb: i32 = first_bracket(t);
    if (lb > 0 && t[t.len() - 1 : t.len()] == "]") {
        var parts: string[] = split_top_commas(t[lb + 1 : t.len() - 1]);
        var j: i32 = 0;
        while (j < parts.len()) {
            cur = me_collect_anno(parts[j], enums, funcs, cur);
            j = j + 1;
        }
    }
    return cur;
}

// variant_struct_index returns the index of the desugared variant struct
// named `vname` owned by enum `owner`, or -1.
function variant_struct_index(structs: StructDecl[], vname: string, owner: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == vname && structs[i].enum_owner == owner) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// me_infer_variant_key infers the instantiation key for a variant
// construction `V(args)` of generic enum `ed`: first from the expected
// annotation (`var o: Opt[i32] = Sm(5)`), then from the payload argument
// types unified against the variant struct's field types (`Sm(5)` → T=i32).
// Returns "" (leave generic) if unresolved or composite.
function me_infer_variant_key(ed: EnumDecl, vname: string, args: Expr[], expected: string, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: FuncDecl[]): string {
    var fromAnno: string = genum_key_from_anno(expected, ed.name, enums, funcs);
    if (fromAnno.len() > 0) { return fromAnno; }
    var vidx: i32 = variant_struct_index(structs, vname, ed.name);
    if (vidx < 0) { return ""; }
    var fields: StructFieldDecl[] = structs[vidx].fields;
    var binds: MEnv = MEnv { mnames: [], mtypes: [] };
    var fi: i32 = 0;
    while (fi < fields.len() && fi < args.len()) {
        var at: string = mono_infer(args[fi], env, funcs);
        if (at.len() > 0) { binds = bind_unify(fields[fi].type_name, at, ed.type_params, binds); }
        fi = fi + 1;
    }
    var key: string = "";
    var j: i32 = 0;
    while (j < ed.type_params.len()) {
        var b: string = binds.elook(ed.type_params[j]);
        if (b.len() == 0) { return ""; }
        if (j > 0) { key = key + "__"; }
        key = key + b;
        j = j + 1;
    }
    // A single-param fn instantiation (`Has(f)` with f: (i32) => i32, the
    // binding carrying the full spelling): sanitise to the same symbol-safe
    // token ge_targ_mangle produces for the annotated path, so the inferred
    // and annotated spellings of one instantiation share a clone (#5298
    // follow-up). The caller recovers the raw spelling for iargs by re-running
    // mono_infer on the payload arg.
    if (ed.type_params.len() == 1 && pk_is_fn_spelling(key)) { return fn_key_sanitize(key); }
    if (!is_simple_key(key)) { return ""; }
    return key;
}

// me_env_from_params seeds an MEnv with a function's parameter types (the
// ORIGINAL spellings, so a `match` on a param recovers its `Opt[i32]`).
function me_env_from_params(params: ParamDecl[]): MEnv {
    var e: MEnv = MEnv { mnames: [], mtypes: [] };
    var i: i32 = 0;
    while (i < params.len()) {
        var pt: string = params[i].type_name;
        // A fn-typed param coarsens to "fn" with its return type held in
        // fn_ret; encode it as "fn => <ret>" so me_scrutinee_type can recover a
        // `match (f(x))` scrutinee's generic-enum return type and rewrite its
        // arms (mirrors the me_bind_pat_vars fn-payload encoding). Otherwise the
        // scrutinee typed "" and the arms stayed un-mangled → wrong variant.
        if (pt == "fn" && params[i].fn_ret.len() > 0) { pt = "fn => " + params[i].fn_ret; }
        e = e.ebind(params[i].name, pt);
        i = i + 1;
    }
    return e;
}

// me_expr rewrites generic-enum variant constructions to their mangled
// clone names and recurses through every sub-expression. `expected` is the
// type the expression flows into (a var annotation / return type), used to
// pin a unit / ambiguous variant's instantiation; "" when unknown.
function me_expr(e: Expr, expected: string, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: FuncDecl[], ins: Insts): RExpr {
    match (e) {
        ExprBinary(b) => {
            var l: RExpr = me_expr(b.left, "", env, enums, structs, funcs, ins);
            var r: RExpr = me_expr(b.right, "", env, enums, structs, funcs, l.rins);
            return RExpr { rexpr: ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col }, rins: r.rins };
        },
        ExprUnary(u) => {
            var o: RExpr = me_expr(u.operand, "", env, enums, structs, funcs, ins);
            return RExpr { rexpr: ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col }, rins: o.rins };
        },
        ExprCall(c) => {
            // A variant construction `V(args)` (bare ident) or `Enum.V(args)`
            // (qualified). The qualified form is only a construction when the
            // object names a generic enum — otherwise `s.len()` (a method call,
            // structurally identical: ExprCall over ExprFieldAccess) would be
            // mis-read as constructing a variant named `len`.
            var vname: string = "";
            match (c.callee) {
                ExprIdent(cid) => { vname = cid.name; },
                ExprFieldAccess(cfa) => {
                    match (cfa.obj) {
                        ExprIdent(oid) => {
                            if (genum_index(enums, oid.name) >= 0) { vname = cfa.field; }
                        },
                        _ => { }
                    }
                },
                _ => { }
            }
            // For an annotation-pinned variant construction of a single-type-
            // param enum, propagate the payload's expected type into the args so
            // a NESTED unit-variant payload (`Sm(Nn)` under `Opt[Opt[i32]]`) gets
            // pinned (the inner `Nn` has nothing to infer from). All fields of a
            // single-param variant are `T`, so each arg expects the scrutinee's
            // single original-spelling arg.
            var argexp: string = "";
            if (vname.len() > 0) {
                var ownerA: i32 = genum_owner_of_variant(enums, funcs, vname);
                if (ownerA >= 0 && enums[ownerA].type_params.len() == 1
                    && genum_key_from_anno(expected, enums[ownerA].name, enums, funcs).len() > 0) {
                    argexp = genum_single_arg(expected);
                }
            }
            // A plain function call `f(args)` — a callee ident that is NOT a
            // generic-enum variant construction — pins each bare unit-variant
            // argument from the callee's declared PARAMETER type (`get(Non)` with
            // `get(o: Opt[i32])` flows `Opt[i32]` into `Non`). This is the
            // call-site analogue of `var o: Opt[i32] = Non`; without it the bare
            // `Non` stayed un-rewritten, then monomorphize_enums dropped the
            // generic `Non` struct and the dangling reference dragged the module
            // to the AST emitter (#5247).
            var calleeFn: string = "";
            if (vname.len() > 0 && genum_owner_of_variant(enums, funcs, vname) < 0) { calleeFn = vname; }
            var nargs: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < c.args.len()) {
                var ae: string = argexp;
                if (ae.len() == 0 && calleeFn.len() > 0) { ae = func_param_type_at(funcs, calleeFn, i); }
                var ra: RExpr = me_expr(c.args[i], ae, env, enums, structs, funcs, cur);
                cur = ra.rins;
                nargs = nargs.append(ra.rexpr);
                i = i + 1;
            }
            if (vname.len() > 0) {
                var owner: i32 = genum_owner_of_variant(enums, funcs, vname);
                if (owner >= 0) {
                    var key: string = me_infer_variant_key(enums[owner], vname, c.args, expected, env, enums, structs, funcs);
                    if (key.len() > 0) {
                        // The original single-arg spelling (for a fn-keyed clone's
                        // field type). From the annotation when present; else for
                        // an INFERRED fn key the payload arg's full spelling
                        // (phase-2 coarsens it to the "fn" + fn_ret field shape);
                        // else the key IS the arg spelling (a nominal key).
                        var carg: string = genum_single_arg(expected);
                        if (carg.len() == 0 && enums[owner].type_params.len() == 1 && c.args.len() > 0) {
                            var raw0: string = mono_infer(c.args[0], env, funcs);
                            if (pk_is_fn_spelling(raw0)) { carg = raw0; }
                        }
                        if (carg.len() == 0) { carg = key; }
                        cur = cur.iadd_arg(enums[owner].name, key, carg);
                        var mv: string = vname + "__" + key;
                        return RExpr { rexpr: ExprCall { callee: ExprIdent { name: mv, line: c.line, col: c.col }, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: cur };
                    }
                }
            }
            var rc: RExpr = me_expr(c.callee, "", env, enums, structs, funcs, cur);
            return RExpr { rexpr: ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, rins: rc.rins };
        },
        ExprIdent(id) => {
            // A bare unit-variant construction `Nn` — needs the expected
            // annotation to pin its instantiation (no payload to infer from).
            var owner: i32 = genum_owner_of_variant(enums, funcs, id.name);
            if (owner >= 0) {
                var key: string = genum_key_from_anno(expected, enums[owner].name, enums, funcs);
                if (key.len() > 0) {
                    var nins: Insts = ins.iadd_arg(enums[owner].name, key, genum_single_arg(expected));
                    return RExpr { rexpr: ExprIdent { name: id.name + "__" + key, line: id.line, col: id.col }, rins: nins };
                }
            }
            return RExpr { rexpr: e, rins: ins };
        },
        ExprArray(a) => {
            // An array literal flowing into `Opt[i32][]` propagates the ELEMENT
            // expected type (`Opt[i32]`) to each element, so a unit-variant
            // element (`Nn`, no payload to infer from) still pins its
            // instantiation. Strip one `[]` off the expected array type.
            var elexp: string = "";
            if (type_ends_arr(expected)) { elexp = expected[0 : expected.len() - 2] + ""; }
            var nels: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < a.elements.len()) {
                var re: RExpr = me_expr(a.elements[i], elexp, env, enums, structs, funcs, cur);
                cur = re.rins;
                nels = nels.append(re.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprArray { elements: nels }, rins: cur };
        },
        ExprTuple(t) => {
            var nels: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < t.elements.len()) {
                var re: RExpr = me_expr(t.elements[i], "", env, enums, structs, funcs, cur);
                cur = re.rins;
                nels = nels.append(re.rexpr);
                i = i + 1;
            }
            return RExpr { rexpr: ExprTuple { elements: nels, line: t.line, col: t.col }, rins: cur };
        },
        ExprIndex(ix) => {
            var ar: RExpr = me_expr(ix.array, "", env, enums, structs, funcs, ins);
            var ir: RExpr = me_expr(ix.index, "", env, enums, structs, funcs, ar.rins);
            return RExpr { rexpr: ExprIndex { array: ar.rexpr, index: ir.rexpr, unchecked: false }, rins: ir.rins };
        },
        ExprSlice(sl) => {
            var ar: RExpr = me_expr(sl.array, "", env, enums, structs, funcs, ins);
            var st: RExpr = me_expr(sl.start, "", env, enums, structs, funcs, ar.rins);
            var en: RExpr = me_expr(sl.end, "", env, enums, structs, funcs, st.rins);
            return RExpr { rexpr: ExprSlice { array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
        },
        ExprStructLit(s) => {
            var nvals: Expr[] = [];
            var cur: Insts = ins;
            var i: i32 = 0;
            while (i < s.field_values.len()) {
                // Propagate the declared field type as the expected type so a
                // generic-enum field set to a unit / payload-less variant
                // (`S { o: Nn }` where `o: Opt[i32]`) pins its instantiation
                // from the field annotation rather than staying generic.
                var fexp: string = me_field_type_of(structs, s.type_name, s.field_names[i]);
                var rv: RExpr = me_expr(s.field_values[i], fexp, env, enums, structs, funcs, cur);
                cur = rv.rins;
                nvals = nvals.append(rv.rexpr);
                i = i + 1;
            }
            var rb: RExpr = me_expr(s.base, "", env, enums, structs, funcs, cur);
            return RExpr { rexpr: ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: nvals, has_base: s.has_base, base: rb.rexpr, line: s.line, col: s.col }, rins: rb.rins };
        },
        ExprFieldAccess(fa) => {
            // A QUALIFIED unit-variant value `Enum.Variant` (no call) flowing
            // into a generic-enum type: pin its instantiation from `expected`
            // and rewrite to the mangled bare form, mirroring the bare-ident
            // arm — so `get(Opt.Non)` with `get(o: Opt[i32])` instantiates from
            // the callee's parameter type (flowed in as `expected`) instead of
            // staying generic and dangling once monomorphize_enums drops the
            // generic variant struct (#5247 follow-up; the bare `get(Non)` form
            // is pinned in the ExprIdent arm). The payloaded `Enum.Variant(args)`
            // form is a call, handled in the ExprCall arm above.
            match (fa.obj) {
                ExprIdent(oid) => {
                    if (genum_index(enums, oid.name) >= 0) {
                        var owner: i32 = genum_owner_of_variant(enums, funcs, fa.field);
                        if (owner >= 0) {
                            var key: string = genum_key_from_anno(expected, enums[owner].name, enums, funcs);
                            if (key.len() > 0) {
                                var nins: Insts = ins.iadd_arg(enums[owner].name, key, genum_single_arg(expected));
                                return RExpr { rexpr: ExprIdent { name: fa.field + "__" + key, line: fa.line, col: fa.col }, rins: nins };
                            }
                        }
                    }
                },
                _ => { }
            }
            var ob: RExpr = me_expr(fa.obj, "", env, enums, structs, funcs, ins);
            return RExpr { rexpr: ExprFieldAccess { obj: ob.rexpr, field: fa.field, line: fa.line, col: fa.col }, rins: ob.rins };
        },
        ExprLambda(lm) => {
            var lb: RStmts = me_stmts(lm.body, env, lm.ret_type, enums, structs, funcs, ins);
            return RExpr { rexpr: ExprLambda { params: lm.params, ret_type: me_rewrite_ty(lm.ret_type, enums, funcs), body: lb.rstmts, use_infer: lm.use_infer }, rins: lb.rins3 };
        },
        _ => { return RExpr { rexpr: e, rins: ins }; }
    }
    return RExpr { rexpr: e, rins: ins };
}

// me_rewrite_match_arms rewrites each variant pattern of a `match` whose
// scrutinee is a known generic-enum instantiation (base, key) to the
// mangled clone variant (`Sm` → `Sm__i32`), leaving wildcards and
// non-owned variants untouched. Arm bodies are walked separately.
function me_rewrite_arm_pattern(pat: Pattern, ed: EnumDecl, key: string): Pattern {
    match (pat) {
        PatVariant(pv) => {
            var simple: string = pv.type_name;
            var k: i32 = 0;
            while (k < pv.type_name.len()) {
                if (pv.type_name[k] == 46) { simple = pv.type_name[k + 1 : pv.type_name.len()] + ""; }
                k = k + 1;
            }
            var vn: string[] = ed.variant_names;
            var j: i32 = 0;
            while (j < vn.len()) {
                if (vn[j] == simple) {
                    return PatVariant { type_name: simple + "__" + key, binding: pv.binding, extra_bindings: pv.extra_bindings, nested: pv.nested };
                }
                j = j + 1;
            }
            return pat;
        },
        _ => { return pat; }
    }
    return pat;
}

// me_field_type_of returns the declared type of field `fname` on the struct
// named `sname` (stripped of any generic args), or "".
function me_field_type_of(structs: StructDecl[], sname: string, fname: string): string {
    var base: string = strip_struct_base(sname);
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == base) {
            var fs: StructFieldDecl[] = structs[i].fields;
            var j: i32 = 0;
            while (j < fs.len()) {
                if (fs[j].name == fname) { return fs[j].type_name; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

// me_fn_ret_spelling returns the return-type spelling of an encoded fn-value
// binding (`fn => Fut[i32]` → `Fut[i32]`), or "" when `t` is not one. The
// binding is produced by me_bind_pat_vars for a fn-typed enum payload; splitting
// on the LAST ` => ` yields the final result type (#4722).
function me_fn_ret_spelling(t: string): string {
    var last: i32 = 0 - 1;
    var i: i32 = 0;
    while (i + 4 <= t.len()) {
        if (t[i : i + 4] == " => ") { last = i; }
        i = i + 1;
    }
    if (last < 0) { return ""; }
    return t[last + 4 : t.len()] + "";
}

// me_scrutinee_type recovers the (original-spelling) type of a match scrutinee
// or for-loop iterable, so its generic-enum instantiation can be read: an
// ident / param / for-loop var via the env, a call result via the callee's
// declared return type, an index `a[i]` via the array's element type, a struct
// literal via its type name, and a field access `s.o` via the field's declared
// type (so `match (s.o)` over a generic-enum-typed field rewrites its arms).
// "" when it can't be determined (the arms then stay un-rewritten).
// me_tuple_elem_type returns the element type spelling at position `field` (a
// numeric tuple index like "0" / "1") of a tuple type `ty` ("(T0, T1, …)"), or
// "" if `ty` isn't a tuple, `field` isn't numeric, or the index is out of
// range. The split is bracket/paren-depth aware so a nested generic / tuple
// element (`(Opt[i32], Map[i32, i32])`) isn't split at its inner commas. Lets
// me_scrutinee_type type a match scrutinee that is a tuple element
// (`match (t.0)`) over a generic-enum element so its arms rewrite.
function me_tuple_elem_type(ty: string, field: string): string {
    if (ty.len() < 2 || ty[0] != 40) { return ""; }
    if (field.len() == 0) { return ""; }
    var idx: i32 = 0;
    var fi: i32 = 0;
    while (fi < field.len()) {
        if (field[fi] < 48 || field[fi] > 57) { return ""; }
        idx = idx * 10 + (field[fi] - 48);
        fi = fi + 1;
    }
    var inner: string = ty[1 : ty.len() - 1] + "";
    var depth: i32 = 0;
    var start: i32 = 0;
    var cur: i32 = 0;
    var i: i32 = 0;
    while (i <= inner.len()) {
        if (i == inner.len() || (inner[i] == 44 && depth == 0)) {
            if (cur == idx) {
                var seg: string = inner[start : i] + "";
                var s2: i32 = 0;
                while (s2 < seg.len() && seg[s2] == 32) { s2 = s2 + 1; }
                return seg[s2 : seg.len()] + "";
            }
            cur = cur + 1;
            start = i + 1;
        } else {
            if (inner[i] == 91 || inner[i] == 40) { depth = depth + 1; }
            if (inner[i] == 93 || inner[i] == 41) { depth = depth - 1; }
        }
        i = i + 1;
    }
    return "";
}

function me_scrutinee_type(e: Expr, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: FuncDecl[]): string {
    match (e) {
        ExprIdent(id) => { return env.elook(id.name); },
        ExprStructLit(s) => { return s.type_name; },
        ExprCall(c) => {
            match (c.callee) {
                ExprIdent(cid) => {
                    // An INLINE variant construction as the scrutinee
                    // (`match (Has(f))`): infer its instantiation from the
                    // payload args and return the original-spelling type
                    // (`Opt[(i32) => i32]`), so ge_inst_of derives the same
                    // mangled key the construction rewrite used and the arms
                    // rewrite to the mangled variants (#5298 follow-up).
                    var vgo: i32 = genum_owner_of_variant(enums, funcs, cid.name);
                    if (vgo >= 0) {
                        var vgk: string = me_infer_variant_key(enums[vgo], cid.name, c.args, "", env, enums, structs, funcs);
                        if (vgk.len() > 0) {
                            var vga: string = vgk;
                            if (enums[vgo].type_params.len() == 1 && c.args.len() > 0) {
                                var vgr: string = mono_infer(c.args[0], env, funcs);
                                if (pk_is_fn_spelling(vgr)) { vga = vgr; }
                            }
                            return enums[vgo].name + "[" + vga + "]";
                        }
                    }
                    // A match-bound fn payload (`cont`, bound by me_bind_pat_vars
                    // to `fn => Fut[i32]`): calling it yields that return type, so
                    // a nested `match (cont(tok))` over a recursive generic enum
                    // recovers its instantiation and rewrites its arms (#4722).
                    // Falls back to a top-level function's declared return type.
                    var fr: string = me_fn_ret_spelling(env.elook(cid.name));
                    if (fr.len() > 0) { return fr; }
                    return func_ret_of(funcs, cid.name);
                },
                ExprFieldAccess(cfa) => {
                    // A METHOD call `recv.method(args)` as the scrutinee: resolve
                    // the receiver's type and return the method's declared return
                    // type, so `match (s.find(k))` over a generic-enum-returning
                    // method recovers its instantiation and rewrites its arms.
                    // Without this the method scrutinee resolved "" (only a free
                    // function's return was recovered), so the arms stayed
                    // un-mangled against the concrete enum and the match read the
                    // wrong variant.
                    var rt: string = me_scrutinee_type(cfa.obj, env, enums, structs, funcs);
                    if (rt.len() > 0) {
                        var rbase: string = strip_struct_base(rt);
                        var mi: i32 = 0;
                        while (mi < funcs.len()) {
                            if (funcs[mi].name == cfa.field && funcs[mi].receiver_type.len() > 0
                                && strip_struct_base(funcs[mi].receiver_type) == rbase) {
                                return funcs[mi].ret_type;
                            }
                            mi = mi + 1;
                        }
                    }
                    return "";
                },
                _ => { return ""; }
            }
            return "";
        },
        ExprIndex(ix) => {
            var at: string = me_scrutinee_type(ix.array, env, enums, structs, funcs);
            if (type_ends_arr(at)) { return at[0 : at.len() - 2] + ""; }
            return "";
        },
        ExprFieldAccess(fa) => {
            var ot: string = me_scrutinee_type(fa.obj, env, enums, structs, funcs);
            if (ot.len() == 0) { return ""; }
            // A tuple-element access `t.N`: the element's type, so `match (t.0)`
            // over a generic-enum element recovers its instantiation. Falls
            // through to the struct-field lookup for a named field.
            var te: string = me_tuple_elem_type(ot, fa.field);
            if (te.len() > 0) { return te; }
            return me_field_type_of(structs, ot, fa.field);
        },
        _ => { return ""; }
    }
    return "";
}

// me_bind_pat_vars binds a match arm's payload variable(s) to their concrete
// types in the arm-body env, so a nested match on a bound value recovers its
// instantiation. For a single-type-param enum each binding takes the matched
// variant's declared field type with the param substituted by the scrutinee's
// one concrete arg (`arg0`): for `Opt[T] { Sm(T) }` the field is `T` → `arg0`,
// but for `E[U] { A(Opt[U]) }` the field is `Opt[U]` → `Opt[arg0]`, so a nested
// `match (o)` sees the real `Opt[i32]` rather than a bare `i32`.
function me_bind_pat_vars(pat: Pattern, ed: EnumDecl, arg0: string, structs: StructDecl[], env: MEnv): MEnv {
    match (pat) {
        PatVariant(pv) => {
            var simple: string = pv.type_name;
            var k: i32 = 0;
            while (k < pv.type_name.len()) {
                if (pv.type_name[k] == 46) { simple = pv.type_name[k + 1 : pv.type_name.len()] + ""; }
                k = k + 1;
            }
            var vidx: i32 = variant_struct_index(structs, simple, ed.name);
            if (vidx < 0) { return env; }
            var fs: StructFieldDecl[] = structs[vidx].fields;
            var cts: string[] = [arg0];
            // Ordered payload variables: the primary binding, then extras.
            var names: string[] = [];
            if (pv.binding.len() > 0) { names = names.append(pv.binding); }
            var bi: i32 = 0;
            while (bi < pv.extra_bindings.len()) {
                if (pv.extra_bindings[bi].len() > 0) { names = names.append(pv.extra_bindings[bi]); }
                bi = bi + 1;
            }
            var e: MEnv = env;
            var ni: i32 = 0;
            while (ni < names.len() && ni < fs.len()) {
                // A fn-typed payload (`Pending(i32, (i32) => Future[T])`) binds
                // to an encoded fn spelling `fn => <ret>` carrying its
                // (substituted) return type, so me_scrutinee_type can recover a
                // nested `match (cont(tok))`'s enum instantiation and rewrite its
                // arms (#4722). A non-fn payload binds to its substituted type.
                if (fs[ni].type_name == "fn" && fs[ni].fn_ret.len() > 0) {
                    e = e.ebind(names[ni], "fn => " + subst_ty(fs[ni].fn_ret, ed.type_params, cts));
                } else {
                    e = e.ebind(names[ni], subst_ty(fs[ni].type_name, ed.type_params, cts));
                }
                ni = ni + 1;
            }
            return e;
        },
        _ => { return env; }
    }
    return env;
}

// me_stmt mirrors mono_stmt for the enum pass: it rewrites generic-enum
// annotations, variant constructions, and `match` arm patterns, threading
// the var-type env (original spellings) and the enclosing return type.
function me_stmt(st: Stmt, env: MEnv, ret_ty: string, enums: EnumDecl[], structs: StructDecl[], funcs: FuncDecl[], ins: Insts): RStmtOne {
    match (st) {
        StmtVar(v) => {
            var iv: RExpr = me_expr(v.init, v.type_name, env, enums, structs, funcs, ins);
            var cins: Insts = me_collect_anno(v.type_name, enums, funcs, iv.rins);
            var nty: string = me_rewrite_ty(v.type_name, enums, funcs);
            // Track the var's type for a later `match`: the annotation if
            // present, else the init's recovered type (a call result, so
            // `var o = wrap(4); match (o)` resolves like `match (wrap(4))`).
            var vty: string = v.type_name;
            // A fn-typed local coarsens to "fn" (its return type is dropped
            // from the annotation); recover the FULL spelling from the init
            // lambda's declared params + return type ("(i32) => i32"), so
            // `match (f(x))` recovers a generic-enum return (me_fn_ret_spelling
            // splits on the LAST " => ", so the full spelling parses the same
            // as the old "fn => <ret>" encoding) AND a variant construction
            // `Has(f)` can infer + sanitise an fn instantiation key (#5298
            // follow-up — the coarse encoding was rejected by is_simple_key,
            // so the inline construct-and-match shape stayed generic and
            // SIGSEGV'd). Falls back to the old encoding when a param type is
            // unrecoverable.
            if (vty == "fn") {
                match (v.init) {
                    ExprLambda(lm) => {
                        if (lm.ret_type.len() > 0) {
                            var lfs: string = "";
                            var lfok: boolean = true;
                            var lfi: i32 = 0;
                            while (lfi < lm.params.len()) {
                                if (lm.params[lfi].type_name.len() == 0) { lfok = false; }
                                if (lfi > 0) { lfs = lfs + ", "; }
                                lfs = lfs + lm.params[lfi].type_name;
                                lfi = lfi + 1;
                            }
                            if (lfok) { vty = "(" + lfs + ") => " + lm.ret_type; }
                            else { vty = "fn => " + lm.ret_type; }
                        }
                    },
                    _ => { }
                }
            }
            if (vty.len() == 0) { vty = me_scrutinee_type(v.init, env, enums, structs, funcs); }
            return RStmtOne { rstmt: StmtVar { name: v.name, type_name: nty, init: iv.rexpr, line: v.line, col: v.col, is_str: false }, renv: env.ebind(v.name, vty), rins2: cins };
        },
        StmtReturn(r) => {
            var rv: RExpr = me_expr(r.value, ret_ty, env, enums, structs, funcs, ins);
            return RStmtOne { rstmt: StmtReturn { value: rv.rexpr, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
        },
        StmtExpr(x) => {
            var xv: RExpr = me_expr(x.value, "", env, enums, structs, funcs, ins);
            return RStmtOne { rstmt: StmtExpr { value: xv.rexpr }, renv: env, rins2: xv.rins };
        },
        StmtAssign(a) => {
            var av: RExpr = me_expr(a.value, env.elook(a.target), env, enums, structs, funcs, ins);
            return RStmtOne { rstmt: StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
        },
        StmtIf(f) => {
            var cv: RExpr = me_expr(f.cond, "", env, enums, structs, funcs, ins);
            var tb: RStmts = me_stmts(f.then_body, env, ret_ty, enums, structs, funcs, cv.rins);
            var eb: RStmts = me_stmts(f.else_body, env, ret_ty, enums, structs, funcs, tb.rins3);
            return RStmtOne { rstmt: StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts }, renv: env, rins2: eb.rins3 };
        },
        StmtWhile(w) => {
            var cv: RExpr = me_expr(w.cond, "", env, enums, structs, funcs, ins);
            var wb: RStmts = me_stmts(w.body, env, ret_ty, enums, structs, funcs, cv.rins);
            return RStmtOne { rstmt: StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label }, renv: env, rins2: wb.rins3 };
        },
        StmtFor(fr) => {
            var it: RExpr = me_expr(fr.iter, "", env, enums, structs, funcs, ins);
            // Bind the loop variable to the iterable's ELEMENT type so a `match`
            // in the body recovers a generic-enum element's instantiation
            // (`for o in xs` over `Opt[i32][]` → o: `Opt[i32]`). Strip one `[]`
            // off the iterable's tracked type.
            var itty: string = me_scrutinee_type(fr.iter, env, enums, structs, funcs);
            var elty: string = "";
            if (type_ends_arr(itty)) { elty = itty[0 : itty.len() - 2] + ""; }
            var benv: MEnv = env.ebind(fr.var_name, elty);
            var fb: RStmts = me_stmts(fr.body, benv, ret_ty, enums, structs, funcs, it.rins);
            return RStmtOne { rstmt: StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label }, renv: env, rins2: fb.rins3 };
        },
        StmtMatch(m) => {
            var sv: RExpr = me_expr(m.scrutinee, "", env, enums, structs, funcs, ins);
            var cur: Insts = sv.rins;
            // Recover the scrutinee's generic-enum instantiation: an annotated
            // ident / param / for-loop var, a call result (the callee's return
            // type), or an index into a generic-enum array.
            var sty: string = me_scrutinee_type(m.scrutinee, env, enums, structs, funcs);
            var gi: GEInst = ge_inst_of(sty, enums, funcs);
            var arms: MatchArm[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var npat: Pattern = m.arms[i].pattern;
                // armenv binds this arm's payload variable(s) so a NESTED match
                // on the bound value recovers its instantiation. For a single-
                // type-param enum every payload field is `T`, so each binding
                // takes the scrutinee's single original-spelling type arg
                // (`Sm(n)` over `Opt[Opt[i32]]` → n: `Opt[i32]`).
                var armenv: MEnv = env;
                if (gi.ok) {
                    var gidx: i32 = genum_index(enums, gi.base);
                    if (gidx >= 0) {
                        npat = me_rewrite_arm_pattern(m.arms[i].pattern, enums[gidx], gi.key);
                        cur = cur.iadd_arg(gi.base, gi.key, genum_single_arg(sty));
                        if (enums[gidx].type_params.len() == 1) {
                            var arg0: string = genum_single_arg(sty);
                            if (arg0.len() > 0) { armenv = me_bind_pat_vars(m.arms[i].pattern, enums[gidx], arg0, structs, env); }
                        }
                    }
                }
                var gv: RExpr = me_expr(m.arms[i].guard, "", armenv, enums, structs, funcs, cur);
                cur = gv.rins;
                var ab: RStmts = me_stmts(m.arms[i].body, armenv, ret_ty, enums, structs, funcs, cur);
                cur = ab.rins3;
                arms = arms.append(MatchArm { pattern: npat, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: gv.rexpr, has_guard: m.arms[i].has_guard });
                i = i + 1;
            }
            return RStmtOne { rstmt: StmtMatch { scrutinee: sv.rexpr, arms: arms, line: m.line, col: m.col, origin: m.origin }, renv: env, rins2: cur };
        },
        _ => { return RStmtOne { rstmt: st, renv: env, rins2: ins }; }
    }
    return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

// me_stmts walks a statement list, threading the block-local env.
function me_stmts(stmts: Stmt[], env: MEnv, ret_ty: string, enums: EnumDecl[], structs: StructDecl[], funcs: FuncDecl[], ins: Insts): RStmts {
    var out: Stmt[] = [];
    var e2: MEnv = env;
    var cur: Insts = ins;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var rs: RStmtOne = me_stmt(stmts[i], e2, ret_ty, enums, structs, funcs, cur);
        out = out.append(rs.rstmt);
        e2 = rs.renv;
        cur = rs.rins2;
        i = i + 1;
    }
    return RStmts { rstmts: out, rins3: cur };
}

// me_rewrite_params rewrites each parameter's generic-enum type annotation.
function me_rewrite_params(params: ParamDecl[], enums: EnumDecl[], funcs: FuncDecl[]): ParamDecl[] {
    var out: ParamDecl[] = [];
    var i: i32 = 0;
    while (i < params.len()) {
        var p: ParamDecl = params[i];
        out = out.append(ParamDecl { name: p.name, type_name: me_rewrite_ty(p.type_name, enums, funcs), own: p.own, has_default: p.has_default, default_value: p.default_value, ret_arr: p.ret_arr, fn_ret: p.fn_ret, fn_param_dyn: p.fn_param_dyn });
        i = i + 1;
    }
    return out;
}

pub function monomorphize_enums(mod: Module): Module {
    // Nothing to do unless there is a monomorphisable generic enum.
    var any: boolean = false;
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        if (mod.enums[ei].type_params.len() > 0 && !enum_has_method(mod.funcs, mod.enums[ei].name)) { any = true; }
        ei = ei + 1;
    }
    if (!any) { return mod; }

    var ins: Insts = Insts { inames: [], itypes: [], iargs: [] };

    // Phase 1: rewrite references in every function (body + param/ret types)
    // and the top-level statements, accumulating instantiations.
    var nfuncs: FuncDecl[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var fn: FuncDecl = mod.funcs[fi];
        var env: MEnv = me_env_from_params(fn.params);
        var rb: RStmts = me_stmts(fn.body, env, fn.ret_type, mod.enums, mod.structs, mod.funcs, ins);
        ins = rb.rins3;
        ins = me_collect_anno(fn.ret_type, mod.enums, mod.funcs, ins);
        var pj: i32 = 0;
        while (pj < fn.params.len()) {
            ins = me_collect_anno(fn.params[pj].type_name, mod.enums, mod.funcs, ins);
            pj = pj + 1;
        }
        nfuncs = nfuncs.append(FuncDecl {
            name: fn.name, receiver_name: fn.receiver_name, receiver_type: fn.receiver_type,
            type_params: fn.type_params, params: me_rewrite_params(fn.params, mod.enums, mod.funcs),
            ret_type: me_rewrite_ty(fn.ret_type, mod.enums, mod.funcs), body: rb.rstmts, line: fn.line, col: fn.col,
            import_iface: fn.import_iface, import_wit: fn.import_wit, type_param_count: fn.type_param_count, bound_traits: [], fip: fn.fip, ret_str: fn.ret_str
        });
        fi = fi + 1;
    }
    var topenv: MEnv = MEnv { mnames: [], mtypes: [] };
    var tr: RStmts = me_stmts(mod.top_stmts, topenv, "", mod.enums, mod.structs, mod.funcs, ins);
    ins = tr.rins3;

    // Phase 1b: collect instantiations referenced by STRUCT FIELD types — a
    // (non-generic) struct with a generic-enum-typed field (`struct S { o:
    // Opt[i32] }`) must clone `Opt__i32` too, else the passthrough field below
    // dangles on the dropped generic `Opt`. A bare type-param field (`T`, on a
    // generic enum's own variant struct) yields no instantiation, so this is a
    // no-op there.
    var sfi: i32 = 0;
    while (sfi < mod.structs.len()) {
        var sfd: StructFieldDecl[] = mod.structs[sfi].fields;
        var sfj: i32 = 0;
        while (sfj < sfd.len()) {
            ins = me_collect_anno(sfd[sfj].type_name, mod.enums, mod.funcs, ins);
            sfj = sfj + 1;
        }
        sfi = sfi + 1;
    }

    // Phase 2: generate a concrete enum + variant structs per instantiation.
    var cl_enums: EnumDecl[] = [];
    var cl_structs: StructDecl[] = [];
    // dropped_bases collects the generic enum names that were instantiated;
    // their originals (+ variant structs) are removed from the passthrough.
    var dropped: string[] = [];
    var wi: i32 = 0;
    while (wi < ins.inames.len()) {
        var base: string = ins.inames[wi];
        var key: string = ins.itypes[wi];
        var gidx: i32 = genum_index(mod.enums, base);
        if (gidx >= 0) {
            var ed: EnumDecl = mod.enums[gidx];
            // A single-type-param enum substitutes T with the ORIGINAL arg
            // spelling (`iargs`), not the mangled key: for a nominal / nested
            // clone the two coincide (`i32`, `Opt[i32]` → me_rewrite_ty gives
            // `Opt__i32` == the key), but a fn-keyed clone's key is LOSSILY
            // sanitised (`_i32_____i32`), so only iargs recovers the real field
            // type `(i32) => i32`. A multi-param key is the `__`-join of simple
            // nominals and splits unambiguously (iargs is unused there).
            var cts: string[] = [ins.iargs[wi]];
            if (ed.type_params.len() != 1) { cts = split_dunder(key); }
            var mname: string = base + "__" + key;
            var nvn: string[] = [];
            var vi2: i32 = 0;
            while (vi2 < ed.variant_names.len()) {
                var vn0: string = ed.variant_names[vi2];
                nvn = nvn.append(vn0 + "__" + key);
                // Clone the variant's desugared struct with substituted payloads.
                var vidx: i32 = variant_struct_index(mod.structs, vn0, base);
                if (vidx >= 0) {
                    var vs: StructDecl = mod.structs[vidx];
                    var nf: StructFieldDecl[] = [];
                    var fj2: i32 = 0;
                    while (fj2 < vs.fields.len()) {
                        // Substitute the payload's type params, then mangle a
                        // resulting generic-enum reference to its clone name and
                        // enqueue it — a variant whose payload is another generic
                        // enum in the param (`enum E[U] { A(Opt[U]) }` → after
                        // subst `A(Opt[i32])`) must reference `Opt__i32` and have
                        // it cloned (the enqueue extends this worklist). A plain
                        // payload (`i32`, a struct) passes through unchanged.
                        var subbed: string = subst_ty(vs.fields[fj2].type_name, ed.type_params, cts);
                        ins = me_collect_anno(subbed, mod.enums, mod.funcs, ins);
                        // A fn-payload field carries its return spelling on fn_ret
                        // (`(i32) => Fut[T]` → fn_ret "Fut[T]"). Substitute + mangle
                        // it the same way as the payload type so the clone's field
                        // reads the instantiated enum (`Fut__i32`) — the source
                        // me_scrutinee_type recovers to rewrite a nested match's
                        // arms (#4722). Empty (non-fn) fn_ret stays empty.
                        var sub_ret: string = subst_ty(vs.fields[fj2].fn_ret, ed.type_params, cts);
                        ins = me_collect_anno(sub_ret, mod.enums, mod.funcs, ins);
                        var f_ty: string = me_rewrite_ty(subbed, mod.enums, mod.funcs);
                        var f_ret: string = me_rewrite_ty(sub_ret, mod.enums, mod.funcs);
                        // A type-param substituted to a fn spelling (`T` → `(i32)
                        // => i32`, #5298) must be COARSENED to the parser's fn
                        // field shape — type_name "fn" with the result on fn_ret —
                        // so the IR path recognises it as a fn payload (a raw
                        // spelling in type_name trips the per-function IR
                        // eligibility, bailing the whole function to AST).
                        if (pk_is_fn_spelling(f_ty)) {
                            f_ret = me_rewrite_ty(fn_spelling_ret(f_ty), mod.enums, mod.funcs);
                            ins = me_collect_anno(f_ret, mod.enums, mod.funcs, ins);
                            f_ty = "fn";
                        }
                        nf = nf.append(StructFieldDecl { name: vs.fields[fj2].name, type_name: f_ty, fn_ret: f_ret });
                        fj2 = fj2 + 1;
                    }
                    cl_structs = cl_structs.append(StructDecl { name: vn0 + "__" + key, fields: nf, type_params: [], derives: vs.derives, line: vs.line, col: vs.col, enum_owner: mname, must_consume: vs.must_consume });
                }
                vi2 = vi2 + 1;
            }
            cl_enums = cl_enums.append(EnumDecl { name: mname, variant_names: nvn, type_params: [], line: ed.line, col: ed.col, must_consume: ed.must_consume });
            if (!str_in(dropped, base)) { dropped = dropped.append(base); }
        }
        wi = wi + 1;
    }

    // Phase 3: passthrough non-dropped enums + structs, then append clones.
    var out_enums: EnumDecl[] = [];
    var oei: i32 = 0;
    while (oei < mod.enums.len()) {
        if (!str_in(dropped, mod.enums[oei].name)) { out_enums = out_enums.append(mod.enums[oei]); }
        oei = oei + 1;
    }
    var k2: i32 = 0;
    while (k2 < cl_enums.len()) { out_enums = out_enums.append(cl_enums[k2]); k2 = k2 + 1; }

    var out_structs: StructDecl[] = [];
    var osi: i32 = 0;
    while (osi < mod.structs.len()) {
        var sd: StructDecl = mod.structs[osi];
        if (sd.enum_owner.len() == 0 || !str_in(dropped, sd.enum_owner)) {
            // Rewrite a kept struct's generic-enum-typed fields to the mangled
            // clone (`o: Opt[i32]` -> `o: Opt__i32`), matching the clones phase 2
            // generated; non-generic-enum field types pass through unchanged.
            var rf: StructFieldDecl[] = [];
            var rfj: i32 = 0;
            while (rfj < sd.fields.len()) {
                rf = rf.append(StructFieldDecl { name: sd.fields[rfj].name, type_name: me_rewrite_ty(sd.fields[rfj].type_name, mod.enums, mod.funcs), fn_ret: me_rewrite_ty(sd.fields[rfj].fn_ret, mod.enums, mod.funcs) });
                rfj = rfj + 1;
            }
            out_structs = out_structs.append(StructDecl { name: sd.name, fields: rf, type_params: sd.type_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume });
        }
        osi = osi + 1;
    }
    var k3: i32 = 0;
    while (k3 < cl_structs.len()) { out_structs = out_structs.append(cl_structs[k3]); k3 = k3 + 1; }

    return Module {
        funcs: nfuncs,
        structs: out_structs,
        aliases: mod.aliases,
        imports: mod.imports,
        top_stmts: tr.rstmts,
        enums: out_enums,
        resources: mod.resources,
        exports: mod.exports,
        impls: mod.impls,
        trait_reqs: mod.trait_reqs
    };
}

// str_in reports membership of `s` in `xs`.
function str_in(xs: string[], s: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

// ---- defer lowering -------------------------------------------------
// `defer ACTION;` runs ACTION when the enclosing function exits — at every
// return path and at falloff, in LIFO order, and only if the defer
// statement was actually reached (a per-defer flag). The return value is
// captured before the deferred actions run. lower_defers_module eliminates
// every StmtDefer (rewriting to flag-sets + per-exit cleanup) so the
// backends never emit one. Mirrors the Go IR's ast.Defer + IsActive local.

// dl_itoa renders a non-negative i32 as decimal (flag indices). parser.fern
// has no i32_to_string, so build digits via 1-char string slices.
function dl_itoa(n: i32): string {
    if (n == 0) { return "0"; }
    var digits: string = "0123456789";
    var s: string = "";
    var x: i32 = n;
    while (x > 0) {
        var d: i32 = x % 10;
        s = digits[d:d + 1] + s;
        x = x / 10;
    }
    return s;
}

struct DeferAcc { stmts: Stmt[], actions: Stmt[], flags: i32[] }

// dl_collect_stmt(s) rebuild the body with each `defer ACTION` replaced by
// `__dfa<i> = 1`, accumulating the actions (index = position in the list)
// and a parallel `flags` list (0 = plain defer, 1 = errdefer). Recurses
// through nested blocks so a conditional defer gets its flag set only when
// its branch runs.
function dl_collect_stmts(stmts: Stmt[], actions: Stmt[], flags: i32[]): DeferAcc {
    var out: Stmt[] = [];
    var acc: Stmt[] = actions;
    var afl: i32[] = flags;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var r: DeferAcc = dl_collect_stmt(stmts[i], acc, afl);
        var j: i32 = 0;
        while (j < r.stmts.len()) { out = out.append(r.stmts[j]); j = j + 1; }
        acc = r.actions;
        afl = r.flags;
        i = i + 1;
    }
    return DeferAcc { stmts: out, actions: acc, flags: afl };
}

function dl_collect_stmt(st: Stmt, actions: Stmt[], flags: i32[]): DeferAcc {
    match (st) {
        StmtDefer(d) => {
            var setflag: Stmt = s_assign("__dfa" + dl_itoa(actions.len()), e_number("1", "", false));
            var one: Stmt[] = [setflag];
            return DeferAcc { stmts: one, actions: actions.append(d.action), flags: flags.append(d.on_error) };
        },
        StmtIf(f) => {
            var tr: DeferAcc = dl_collect_stmts(f.then_body, actions, flags);
            var er: DeferAcc = dl_collect_stmts(f.else_body, tr.actions, tr.flags);
            var one: Stmt[] = [s_if(f.cond, tr.stmts, er.stmts)];
            return DeferAcc { stmts: one, actions: er.actions, flags: er.flags };
        },
        StmtWhile(w) => {
            var br: DeferAcc = dl_collect_stmts(w.body, actions, flags);
            var one: Stmt[] = [s_while(w.cond, br.stmts)];
            return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
        },
        StmtFor(fr) => {
            var br: DeferAcc = dl_collect_stmts(fr.body, actions, flags);
            var one: Stmt[] = [s_for(fr.var_name, fr.iter, br.stmts)];
            return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
        },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var acc: Stmt[] = actions;
            var afl: i32[] = flags;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var ar: DeferAcc = dl_collect_stmts(m.arms[i].body, acc, afl);
                arms = arms.append(MatchArm { pattern: m.arms[i].pattern, body: ar.stmts, line: m.arms[i].line, col: m.arms[i].col, guard: m.arms[i].guard, has_guard: m.arms[i].has_guard });
                acc = ar.actions;
                afl = ar.flags;
                i = i + 1;
            }
            var one: Stmt[] = [s_match(m.scrutinee, arms)];
            return DeferAcc { stmts: one, actions: acc, flags: afl };
        },
        _ => {
            var one: Stmt[] = [st];
            return DeferAcc { stmts: one, actions: actions, flags: flags };
        }
    }
}

// dl_cleanup_kind builds the LIFO cleanup for one kind: for i = n-1 .. 0,
// `if (__dfa<i>) { action_i }`, restricted to actions whose on_error flag
// equals `want` (0 = plain defer, 1 = errdefer). With every flag 0 (no
// errdefer) `want = 0` reproduces the original all-actions cleanup, so a
// defer-only function lowers byte-identically.
function dl_cleanup_kind(actions: Stmt[], flags: i32[], want: i32): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = actions.len() - 1;
    while (i >= 0) {
        if (flags[i] == want) {
            var body1: Stmt[] = [actions[i]];
            var noelse: Stmt[] = [];
            out = out.append(s_if(e_ident("__dfa" + dl_itoa(i)), body1, noelse));
        }
        i = i - 1;
    }
    return out;
}

// dl_is_err_value reports whether a return value is statically a None/Err —
// the failure variant — so an `errdefer` should fire on this return. `None`
// is a bare ident; `Err(x)` is a call to the `Err` constructor. (`?`
// propagation is not visible to this parse-time pass — same scope as the
// self-host's plain `defer`, which also only fires on explicit returns.)
function dl_is_err_value(e: Expr): boolean {
    match (e) {
        ExprIdent(id) => { return id.name == "None"; },
        ExprCall(c) => {
            match (c.callee) {
                ExprIdent(cid) => { return cid.name == "Err"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// dl_expand_returns replaces each `return E` with
// `__defret = E; <cleanup_all>; [<cleanup_err> if E is None/Err]; return __defret;`
// (the value is captured before the deferred actions run). cleanup_all (plain
// defers) runs on every return; cleanup_err (errdefers) runs only when the
// returned value is a None/Err. A bare/void return runs cleanup_all only.
function dl_expand_returns(stmts: Stmt[], cleanup_all: Stmt[], cleanup_err: Stmt[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        var ex: Stmt[] = dl_expand_return_stmt(stmts[i], cleanup_all, cleanup_err);
        var j: i32 = 0;
        while (j < ex.len()) { out = out.append(ex[j]); j = j + 1; }
        i = i + 1;
    }
    return out;
}

function dl_expand_return_stmt(st: Stmt, cleanup_all: Stmt[], cleanup_err: Stmt[]): Stmt[] {
    match (st) {
        StmtReturn(r) => {
            var isvoid: boolean = false;
            match (r.value) {
                ExprUnknown(_) => { isvoid = true; },
                _ => {}
            }
            var out: Stmt[] = [];
            if (!isvoid) { out = out.append(s_assign("__defret", r.value)); }
            var i: i32 = 0;
            while (i < cleanup_all.len()) { out = out.append(cleanup_all[i]); i = i + 1; }
            if (!isvoid && dl_is_err_value(r.value)) {
                var k: i32 = 0;
                while (k < cleanup_err.len()) { out = out.append(cleanup_err[k]); k = k + 1; }
            }
            if (isvoid) { out = out.append(s_return(r.value)); }
            else { out = out.append(s_return(e_ident("__defret"))); }
            return out;
        },
        StmtIf(f) => {
            var one: Stmt[] = [s_if(f.cond, dl_expand_returns(f.then_body, cleanup_all, cleanup_err), dl_expand_returns(f.else_body, cleanup_all, cleanup_err))];
            return one;
        },
        StmtWhile(w) => {
            var one: Stmt[] = [s_while(w.cond, dl_expand_returns(w.body, cleanup_all, cleanup_err))];
            return one;
        },
        StmtFor(fr) => {
            var one: Stmt[] = [s_for(fr.var_name, fr.iter, dl_expand_returns(fr.body, cleanup_all, cleanup_err))];
            return one;
        },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) {
                arms = arms.append(MatchArm { pattern: m.arms[i].pattern, body: dl_expand_returns(m.arms[i].body, cleanup_all, cleanup_err), line: m.arms[i].line, col: m.arms[i].col, guard: m.arms[i].guard, has_guard: m.arms[i].has_guard });
                i = i + 1;
            }
            var one: Stmt[] = [s_match(m.scrutinee, arms)];
            return one;
        },
        _ => {
            var one: Stmt[] = [st];
            return one;
        }
    }
}


// CapLift records a capturing recursive local that was lambda-lifted: its
// (now top-level) name and the ordered list of enclosing names it
// captured. hoist_local_funcs_module uses it to rewrite the *enclosing*
// body's calls `f(args)` → `f(args, cap1, …)`; the recursive calls inside
// the lifted body are rewritten at lift time.
pub struct CapLift { name: string, caps: string[] }

function hl_no_lifts(): CapLift[] { var e: CapLift[] = []; return e; }

function hl_append_lifts(a: CapLift[], b: CapLift[]): CapLift[] {
    var out: CapLift[] = a;
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(b[i]); i = i + 1; }
    return out;
}

function hl_param_names(params: ParamDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < params.len()) { out = out.append(params[i].name); i = i + 1; }
    return out;
}

function hl_append_str(a: string[], b: string[]): string[] {
    var out: string[] = a;
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(b[i]); i = i + 1; }
    return out;
}

function hl_collect_var_names(stmts: Stmt[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => { out = out.append(v.name); },
            StmtIf(f) => {
                out = hl_append_str(out, hl_collect_var_names(f.then_body));
                out = hl_append_str(out, hl_collect_var_names(f.else_body));
            },
            StmtWhile(w) => { out = hl_append_str(out, hl_collect_var_names(w.body)); },
            StmtFor(fr) => { out = hl_append_str(out, hl_collect_var_names(fr.body)); },
            StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = hl_append_str(out, hl_collect_var_names(m.arms[a].body)); a = a + 1; }
            },
            StmtDefer(d) => {
                var one: Stmt[] = [d.action];
                out = hl_append_str(out, hl_collect_var_names(one));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// hl_has_rec_local reports whether a statement list (descending into
// nested blocks) contains a self-recursive local function — a `var f =
// <lambda whose body mentions f>`. hl_rewrite uses this to leave bodies
// with no recursive local completely untouched, so the rebuild path only
// runs where it must — and the self-host's own sources (which use none)
// pass through byte-for-byte, keeping the stage-2 fixpoint intact.
function hl_has_rec_local(stmts: Stmt[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => {
                match (v.init) {
                    ExprLambda(lam) => { if (stmts_mention(lam.body, v.name)) { return true; } },
                    _ => { }
                }
            },
            StmtIf(f) => { if (hl_has_rec_local(f.then_body) || hl_has_rec_local(f.else_body)) { return true; } },
            StmtWhile(w) => { if (hl_has_rec_local(w.body)) { return true; } },
            StmtFor(fr) => { if (hl_has_rec_local(fr.body)) { return true; } },
            StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { if (hl_has_rec_local(m.arms[a].body)) { return true; } a = a + 1; }
            },
            StmtDefer(d) => {
                var one: Stmt[] = [d.action];
                if (hl_has_rec_local(one)) { return true; }
            },
            _ => { }
        }
        i = i + 1;
    }
    return false;
}

// hl_capture_list returns the ordered, de-duplicated list of enclosing
// names a recursive lambda captures (the same predicate as hl_captures,
// but collecting the names instead of a boolean) — the extra parameters
// the lambda-lift appends.
function hl_capture_list(lam: ExprLambda, own_name: string, enclosing: string[]): string[] {
    var shadow: string[] = hl_param_names(lam.params);
    shadow = hl_append_str(shadow, hl_collect_var_names(lam.body));
    var caps: string[] = [];
    var i: i32 = 0;
    while (i < enclosing.len()) {
        var e: string = enclosing[i];
        if (e != own_name && !util.has_str(shadow, e) && !util.has_str(caps, e)) {
            if (stmts_mention(lam.body, e)) { caps = caps.append(e); }
        }
        i = i + 1;
    }
    return caps;
}

// rw_call_expr appends `caps` (as ident arguments) to every call of
// `fname` in an expression, recursing through the whole tree. Used by the
// lambda-lift to thread a lifted function's captured variables through its
// call sites. ExprCall is the only node it changes; the rest are rebuilt
// verbatim around their rewritten children.
function rw_call_expr(e: Expr, fname: string, caps: string[]): Expr {
    match (e) {
        ExprCall(c) => {
            var new_callee: Expr = rw_call_expr(c.callee, fname, caps);
            var new_args: Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { new_args = new_args.append(rw_call_expr(c.args[i], fname, caps)); i = i + 1; }
            // If this is a call of the lifted function, append the captures.
            var is_target: boolean = false;
            match (c.callee) {
                ExprIdent(id) => { if (id.name == fname) { is_target = true; } },
                _ => { }
            }
            if (is_target) {
                var k: i32 = 0;
                while (k < caps.len()) { new_args = new_args.append(e_ident(caps[k])); k = k + 1; }
            }
            return ExprCall { callee: new_callee, args: new_args, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        ExprBinary(b) => { return e_binary(b.op, rw_call_expr(b.left, fname, caps), rw_call_expr(b.right, fname, caps)); },
        ExprUnary(u) => { return e_unary(u.op, rw_call_expr(u.operand, fname, caps)); },
        ExprArray(a) => {
            var els: Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { els = els.append(rw_call_expr(a.elements[i], fname, caps)); i = i + 1; }
            return e_array(els);
        },
        ExprTuple(t) => {
            var els: Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { els = els.append(rw_call_expr(t.elements[i], fname, caps)); i = i + 1; }
            return e_tuple_at(els, t.line, t.col);
        },
        ExprIndex(ix) => { return e_index(rw_call_expr(ix.array, fname, caps), rw_call_expr(ix.index, fname, caps)); },
        ExprSlice(sl) => { return e_slice(rw_call_expr(sl.array, fname, caps), rw_call_expr(sl.start, fname, caps), rw_call_expr(sl.end, fname, caps)); },
        ExprFieldAccess(fa) => { return e_field_access(rw_call_expr(fa.obj, fname, caps), fa.field); },
        ExprStructLit(s) => {
            var vals: Expr[] = [];
            var i: i32 = 0;
            while (i < s.field_values.len()) { vals = vals.append(rw_call_expr(s.field_values[i], fname, caps)); i = i + 1; }
            var nb: Expr = s.base;
            if (s.has_base) { nb = rw_call_expr(s.base, fname, caps); }
            return ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: nb, line: s.line, col: s.col };
        },
        ExprLambda(lm) => {
            // A nested lambda can call the lifted function too; rewrite its body.
            return e_lambda(lm.params, lm.ret_type, rw_call_stmts(lm.body, fname, caps));
        },
        _ => { return e; }
    }
}

// rw_call_stmts applies rw_call_expr to every expression in a statement
// list (descending into nested blocks), rebuilding the statements around
// the rewritten expressions.
function rw_call_stmts(stmts: Stmt[], fname: string, caps: string[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => { out = out.append(s_var_at(v.name, v.type_name, rw_call_expr(v.init, fname, caps), v.line, v.col)); },
            StmtReturn(r) => { out = out.append(s_return_at(rw_call_expr(r.value, fname, caps), r.line, r.col)); },
            StmtExpr(e) => { out = out.append(s_expr(rw_call_expr(e.value, fname, caps))); },
            StmtAssign(a) => { out = out.append(s_assign_at(a.target, rw_call_expr(a.value, fname, caps), a.line, a.col, a.target_line, a.target_col)); },
            StmtIf(f) => { out = out.append(s_if(rw_call_expr(f.cond, fname, caps), rw_call_stmts(f.then_body, fname, caps), rw_call_stmts(f.else_body, fname, caps))); },
            StmtWhile(w) => { out = out.append(s_while(rw_call_expr(w.cond, fname, caps), rw_call_stmts(w.body, fname, caps))); },
            StmtFor(fr) => { out = out.append(s_for(fr.var_name, rw_call_expr(fr.iter, fname, caps), rw_call_stmts(fr.body, fname, caps))); },
            StmtMatch(m) => {
                var arms: MatchArm[] = [];
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    arms = arms.append(MatchArm { pattern: m.arms[a].pattern, body: rw_call_stmts(m.arms[a].body, fname, caps), line: m.arms[a].line, col: m.arms[a].col, guard: rw_call_expr(m.arms[a].guard, fname, caps), has_guard: m.arms[a].has_guard });
                    a = a + 1;
                }
                out = out.append(s_match_at(rw_call_expr(m.scrutinee, fname, caps), arms, m.line, m.col));
            },
            StmtDefer(d) => {
                var one: Stmt[] = [d.action];
                var rd: Stmt[] = rw_call_stmts(one, fname, caps);
                if (rd.len() >= 1) { out = out.append(s_defer(rd[0])); }
            },
            _ => { out = out.append(stmts[i]); },
        }
        i = i + 1;
    }
    return out;
}

function hl_rewrite_match(m: StmtMatch, enclosing: string[], hoisted: FuncDecl[]): (Stmt[], FuncDecl[], CapLift[]) {
    var arms: MatchArm[] = [];
    var acc: FuncDecl[] = hoisted;
    var acc_lifts: CapLift[] = hl_no_lifts();
    var a: i32 = 0;
    while (a < m.arms.len()) {
        var (ar_stmts, ar_hoisted, ar_lifts) = hl_rewrite(m.arms[a].body, enclosing, acc);
        acc = ar_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, ar_lifts);
        arms = arms.append(MatchArm { pattern: m.arms[a].pattern, body: ar_stmts, line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard });
        a = a + 1;
    }
    return ([s_match_at(m.scrutinee, arms, m.line, m.col)], acc, acc_lifts);
}

// hl_rewrite lifts self-recursive local functions out of a statement
// list. A body with none is returned verbatim (the precheck) — so only
// functions that actually use the feature are ever rebuilt.
function hl_rewrite(stmts: Stmt[], enclosing: string[], hoisted: FuncDecl[]): (Stmt[], FuncDecl[], CapLift[]) {
    if (!hl_has_rec_local(stmts)) { return (stmts, hoisted, hl_no_lifts()); }
    var out: Stmt[] = [];
    var acc: FuncDecl[] = hoisted;
    var acc_lifts: CapLift[] = hl_no_lifts();
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => {
                // A self-recursive local function (`var f = <lambda
                // mentioning f>`) is lifted out; everything else passes
                // through as the ORIGINAL stmts[i] (re-wrapping the
                // unwrapped payload via `[v]` would drop it).
                var did_lift: boolean = false;
                match (v.init) {
                    ExprLambda(lam) => {
                        if (stmts_mention(lam.body, v.name)) {
                            did_lift = true;
                            // Captured enclosing names become trailing
                            // parameters (lambda-lifting); a capture-free
                            // local just keeps its parameter list.
                            var caps: string[] = hl_capture_list(lam, v.name, enclosing);
                            var new_params: ParamDecl[] = lam.params;
                            var ci: i32 = 0;
                            while (ci < caps.len()) { new_params = new_params.append(ParamDecl { name: caps[ci], type_name: "", own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }); ci = ci + 1; }
                            // Hoist nested recursive locals first; inside the
                            // lifted function the captures are in scope as params.
                            var inner_encl: string[] = hl_param_names(new_params);
                            inner_encl = hl_append_str(inner_encl, hl_collect_var_names(lam.body));
                            var (ir_stmts, ir_hoisted, ir_lifts) = hl_rewrite(lam.body, inner_encl, acc);
                            acc = ir_hoisted;
                            acc_lifts = hl_append_lifts(acc_lifts, ir_lifts);
                            // Thread the captures through the recursive self-calls.
                            var lifted_body: Stmt[] = ir_stmts;
                            if (caps.len() > 0) { lifted_body = rw_call_stmts(lifted_body, v.name, caps); }
                            var notp: string[] = [];
                            acc = acc.append(FuncDecl {
                                name: v.name, receiver_name: "", receiver_type: "",
                                type_params: notp, params: new_params, ret_type: lam.ret_type,
                                body: lifted_body, line: v.line, col: v.col,
                                import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false
                            });
                            if (caps.len() > 0) { acc_lifts = acc_lifts.append(CapLift { name: v.name, caps: caps }); }
                        }
                    },
                    _ => { }
                }
                if (!did_lift) { out = out.append(stmts[i]); }
            },
            StmtIf(f) => {
                var (tr_stmts, tr_hoisted, tr_lifts) = hl_rewrite(f.then_body, enclosing, acc);
                acc = tr_hoisted;
                acc_lifts = hl_append_lifts(acc_lifts, tr_lifts);
                var (er_stmts, er_hoisted, er_lifts) = hl_rewrite(f.else_body, enclosing, acc);
                acc = er_hoisted;
                acc_lifts = hl_append_lifts(acc_lifts, er_lifts);
                out = out.append(s_if(f.cond, tr_stmts, er_stmts));
            },
            StmtWhile(w) => {
                var (wr_stmts, wr_hoisted, wr_lifts) = hl_rewrite(w.body, enclosing, acc);
                acc = wr_hoisted;
                acc_lifts = hl_append_lifts(acc_lifts, wr_lifts);
                out = out.append(s_while(w.cond, wr_stmts));
            },
            StmtFor(fr) => {
                var (fr2_stmts, fr2_hoisted, fr2_lifts) = hl_rewrite(fr.body, enclosing, acc);
                acc = fr2_hoisted;
                acc_lifts = hl_append_lifts(acc_lifts, fr2_lifts);
                out = out.append(s_for(fr.var_name, fr.iter, fr2_stmts));
            },
            StmtMatch(m) => {
                var (mr_stmts, mr_hoisted, mr_lifts) = hl_rewrite_match(m, enclosing, acc);
                acc = mr_hoisted;
                acc_lifts = hl_append_lifts(acc_lifts, mr_lifts);
                var km: i32 = 0;
                while (km < mr_stmts.len()) { out = out.append(mr_stmts[km]); km = km + 1; }
            },
            StmtDefer(d) => {
                var one: Stmt[] = [d.action];
                var (dr_stmts, dr_hoisted, dr_lifts) = hl_rewrite(one, enclosing, acc);
                acc = dr_hoisted;
                acc_lifts = hl_append_lifts(acc_lifts, dr_lifts);
                if (dr_stmts.len() >= 1) { out = out.append(s_defer(dr_stmts[0])); }
            },
            _ => { out = out.append(stmts[i]); },
        }
        i = i + 1;
    }
    return (out, acc, acc_lifts);
}

// hl_apply_lifts rewrites a (host) statement list's calls to each
// lambda-lifted function, appending that function's captured names as
// trailing arguments — the external counterpart to the recursive-call
// rewrite done at lift time.
function hl_apply_lifts(stmts: Stmt[], lifts: CapLift[]): Stmt[] {
    var out: Stmt[] = stmts;
    var i: i32 = 0;
    while (i < lifts.len()) {
        if (lifts[i].caps.len() > 0) { out = rw_call_stmts(out, lifts[i].name, lifts[i].caps); }
        i = i + 1;
    }
    return out;
}

pub function hoist_local_funcs_module(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var hoisted: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fn: FuncDecl = mod.funcs[i];
        var encl: string[] = hl_param_names(fn.params);
        encl = hl_append_str(encl, hl_collect_var_names(fn.body));
        var (r_stmts, r_hoisted, r_lifts) = hl_rewrite(fn.body, encl, hoisted);
        hoisted = r_hoisted;
        // Rewrite this body's calls to any lambda-lifted function so the
        // captures are passed at the (now top-level) call sites.
        var fn_body: Stmt[] = hl_apply_lifts(r_stmts, r_lifts);
        funcs = funcs.append(FuncDecl {
            name: fn.name, receiver_name: fn.receiver_name, receiver_type: fn.receiver_type,
            type_params: fn.type_params, params: fn.params, ret_type: fn.ret_type, body: fn_body,
            line: fn.line, col: fn.col, import_iface: fn.import_iface, import_wit: fn.import_wit,
            type_param_count: fn.type_param_count, bound_traits: [], fip: fn.fip, ret_str: fn.ret_str
        });
        i = i + 1;
    }
    var tencl: string[] = hl_collect_var_names(mod.top_stmts);
    var (tr_stmts, tr_hoisted, tr_lifts) = hl_rewrite(mod.top_stmts, tencl, hoisted);
    hoisted = tr_hoisted;
    var top_body: Stmt[] = hl_apply_lifts(tr_stmts, tr_lifts);
    var j: i32 = 0;
    while (j < hoisted.len()) { funcs = funcs.append(hoisted[j]); j = j + 1; }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: top_body, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

function lower_defers_func(fn: FuncDecl): FuncDecl {
    var empty: Stmt[] = [];
    var emptyf: i32[] = [];
    var cr: DeferAcc = dl_collect_stmts(fn.body, empty, emptyf);
    if (cr.actions.len() == 0) { return fn; }
    // cleanup_all = plain defers (every return + falloff); cleanup_err =
    // errdefers (only on a None/Err return). For a defer-only function
    // cleanup_err is empty and this is byte-identical to the old lowering.
    var cleanup: Stmt[] = dl_cleanup_kind(cr.actions, cr.flags, 0);
    var cleanup_err: Stmt[] = dl_cleanup_kind(cr.actions, cr.flags, 1);
    var expanded: Stmt[] = dl_expand_returns(cr.stmts, cleanup, cleanup_err);
    var body: Stmt[] = [];
    // Shared return temp + per-defer flags, all i32, initialised to 0.
    body = body.append(s_var("__defret", "", e_number("0", "", false)));
    var i: i32 = 0;
    while (i < cr.actions.len()) {
        body = body.append(s_var("__dfa" + dl_itoa(i), "", e_number("0", "", false)));
        i = i + 1;
    }
    // `?`-edge cleanup markers (#4334): the try operator is lowered long after
    // this parse-time pass (irlower's lower_try), so its implicit early return
    // can't be expanded here like a StmtReturn. Instead, embed both cleanup
    // lists in the body behind never-true guards; lower_try recognises the
    // guard idents and replays the guarded statements at the `?` failure edge
    // (plain defers first, then errdefers — native's TryOp order). The guards
    // are ordinary always-0 flags, so on every backend that does NOT know the
    // markers (the legacy AST emitters) these blocks are dead code and the
    // lowering is behaviourally unchanged.
    body = body.append(s_var("__dfa_tryall", "", e_number("0", "", false)));
    body = body.append(s_var("__dfa_tryerr", "", e_number("0", "", false)));
    var k: i32 = 0;
    while (k < expanded.len()) { body = body.append(expanded[k]); k = k + 1; }
    // Falloff cleanup (a function that returns on every path leaves this
    // unreachable; a void function that falls off runs it).
    var c: i32 = 0;
    while (c < cleanup.len()) { body = body.append(cleanup[c]); c = c + 1; }
    var noelse: Stmt[] = [];
    body = body.append(s_if(e_ident("__dfa_tryall"), cleanup, noelse));
    body = body.append(s_if(e_ident("__dfa_tryerr"), cleanup_err, noelse));
    return FuncDecl {
        name: fn.name, receiver_name: fn.receiver_name, receiver_type: fn.receiver_type,
        type_params: fn.type_params, params: fn.params, ret_type: fn.ret_type, body: body, line: fn.line, col: fn.col,
        import_iface: fn.import_iface, import_wit: fn.import_wit, type_param_count: fn.type_param_count, bound_traits: [], fip: fn.fip, ret_str: fn.ret_str
    };
}

pub function lower_defers_module(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        funcs = funcs.append(lower_defers_func(mod.funcs[i]));
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// ---- automatic resource-handle drop (P5 slice 3) --------------------
// Mirrors the Go internal/ir/insert_resource_drops.go. For each owned `own R`
// top-level local that is not moved (returned, or passed to an `own`
// parameter), insert `defer __resource_drop_R(local);` right after the
// declaration — lower_defers_module then runs it on every exit path — and
// synthesize one body-less `@import("<iface>","[resource-drop]<wit>")` drop
// function per dropped resource (which the world-driven composer wires).
// Borrowed handles are never dropped. Sound over complete: a handle whose
// escaping use isn't recognised is conservatively treated as moved.

function resource_drop_fn_name(res: string): string { return "__resource_drop_" + res; }

// name_in_list is a local membership test (contains_str lives in other modules).
// name_in_list -> util.has_str (SH-020).

// handle_resource_of returns R for an owned-handle spelling "own R", else "".
function handle_resource_of(type_name: string): string {
    if (type_name.len() >= 4 && type_name[0:4] == "own ") {
        return type_name[4 : type_name.len()] + "";
    }
    return "";
}

function resource_binding_iface(resources: ResourceDecl[], name: string): string {
    var i: i32 = 0;
    while (i < resources.len()) {
        if (resources[i].name == name) { return resources[i].iface; }
        i = i + 1;
    }
    return "";
}

function resource_binding_wit(resources: ResourceDecl[], name: string): string {
    var i: i32 = 0;
    while (i < resources.len()) {
        if (resources[i].name == name) { return resources[i].wit; }
        i = i + 1;
    }
    return "";
}

// handle_returned reports whether `name` appears in any return value in stmts.
function handle_returned(stmts: Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtReturn(r) => { if (expr_mentions(r.value, name)) { return true; } },
            StmtIf(f) => { if (handle_returned(f.then_body, name) || handle_returned(f.else_body, name)) { return true; } },
            StmtWhile(w) => { if (handle_returned(w.body, name)) { return true; } },
            StmtFor(fr) => { if (handle_returned(fr.body, name)) { return true; } },
            StmtMatch(m) => {
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (handle_returned(m.arms[k].body, name)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

// callee_param_is_own reports whether function `fname`'s parameter at position
// `pos` is an owned-handle (`own …`) type — an argument there is moved.
function callee_param_is_own(funcs: FuncDecl[], fname: string, pos: i32): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == fname) {
            if (pos < funcs[i].params.len()) {
                var tn: string = funcs[i].params[pos].type_name;
                return tn.len() >= 4 && tn[0:4] == "own ";
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

function expr_own_consumes(e: Expr, funcs: FuncDecl[], name: string): boolean {
    match (e) {
        ExprCall(c) => {
            match (c.callee) {
                ExprIdent(id) => {
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        match (c.args[i]) {
                            ExprIdent(aid) => {
                                if (aid.name == name && callee_param_is_own(funcs, id.name, i)) { return true; }
                            },
                            _ => {},
                        }
                        i = i + 1;
                    }
                },
                _ => {},
            }
            if (expr_own_consumes(c.callee, funcs, name)) { return true; }
            var j: i32 = 0;
            while (j < c.args.len()) {
                if (expr_own_consumes(c.args[j], funcs, name)) { return true; }
                j = j + 1;
            }
            return false;
        },
        ExprBinary(b) => { return expr_own_consumes(b.left, funcs, name) || expr_own_consumes(b.right, funcs, name); },
        ExprUnary(u) => { return expr_own_consumes(u.operand, funcs, name); },
        _ => { return false; }
    }
}

// handle_own_consumed reports whether `name` is passed as a call argument bound
// to an owned-handle parameter anywhere in stmts (moved into the callee).
function handle_own_consumed(stmts: Stmt[], funcs: FuncDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => { if (expr_own_consumes(v.init, funcs, name)) { return true; } },
            StmtReturn(r) => { if (expr_own_consumes(r.value, funcs, name)) { return true; } },
            StmtExpr(e) => { if (expr_own_consumes(e.value, funcs, name)) { return true; } },
            StmtAssign(a) => { if (expr_own_consumes(a.value, funcs, name)) { return true; } },
            StmtIf(f) => {
                if (expr_own_consumes(f.cond, funcs, name) || handle_own_consumed(f.then_body, funcs, name) || handle_own_consumed(f.else_body, funcs, name)) { return true; }
            },
            StmtWhile(w) => { if (expr_own_consumes(w.cond, funcs, name) || handle_own_consumed(w.body, funcs, name)) { return true; } },
            StmtFor(fr) => { if (expr_own_consumes(fr.iter, funcs, name) || handle_own_consumed(fr.body, funcs, name)) { return true; } },
            StmtMatch(m) => {
                if (expr_own_consumes(m.scrutinee, funcs, name)) { return true; }
                var k: i32 = 0;
                while (k < m.arms.len()) {
                    if (handle_own_consumed(m.arms[k].body, funcs, name)) { return true; }
                    k = k + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

pub function insert_resource_drops(mod: Module): Module {
    if (mod.resources.len() == 0) { return mod; }
    var out_funcs: FuncDecl[] = [];
    var needed: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var f: FuncDecl = mod.funcs[i];
        if (f.import_iface.len() > 0) { out_funcs = out_funcs.append(f); i = i + 1; continue; }
        var nbody: Stmt[] = [];
        var j: i32 = 0;
        while (j < f.body.len()) {
            var s: Stmt = f.body[j];
            nbody = nbody.append(s);
            match (s) {
                StmtVar(v) => {
                    var res: string = handle_resource_of(v.type_name);
                    if (res.len() > 0) {
                        var iface: string = resource_binding_iface(mod.resources, res);
                        if (iface.len() > 0
                            && !handle_returned(f.body, v.name)
                            && !handle_own_consumed(f.body, mod.funcs, v.name)) {
                            var dropcall: Expr = e_call(e_ident(resource_drop_fn_name(res)), [e_ident(v.name)]);
                            nbody = nbody.append(s_defer(s_expr(dropcall)));
                            if (!util.has_str(needed, res)) { needed = needed.append(res); }
                        }
                    }
                },
                _ => {},
            }
            j = j + 1;
        }
        out_funcs = out_funcs.append(FuncDecl { ...f, body: nbody });
        i = i + 1;
    }
    var no_tp: string[] = [];
    var no_body: Stmt[] = [];
    var k: i32 = 0;
    while (k < needed.len()) {
        var rn: string = needed[k];
        var iface2: string = resource_binding_iface(mod.resources, rn);
        var wit2: string = resource_binding_wit(mod.resources, rn);
        var hp: ParamDecl[] = [ParamDecl { name: "h", type_name: "own " + rn, own: true, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
        out_funcs = out_funcs.append(FuncDecl {
            name: resource_drop_fn_name(rn), receiver_name: "", receiver_type: "",
            type_params: no_tp, params: hp, ret_type: "void", body: no_body,
            line: 0, col: 0, import_iface: iface2, import_wit: "[resource-drop]" + wit2, type_param_count: 0, bound_traits: [], fip: false, ret_str: false
        });
        k = k + 1;
    }
    return Module { funcs: out_funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// ---------------------------------------------------------------------------
// Range-for desugaring for the NON-IR consumers.
//
// `for i in LOW..HIGH` parses to a StmtFor whose iter is the synthetic
// `__range(LOW, HIGH)` call (see parse_stmt). The IR path lowers that directly
// (irlower.lower_range_for); but the AST emitters, the SSA backend, and the
// tree-walking interpreter don't know `__range` — left untouched, they emit a
// `call __fn___range` (a link error) or mis-evaluate the iter. So for those
// consumers we desugar the `__range` for-iter into a counting while-loop built
// from existing nodes:
//
//     var i = LOW - 1;
//     var $hi_<var> = HIGH;          // HIGH evaluated once (`0..f()` calls f once)
//     while (true) {
//         i = i + 1;                 // increment at the TOP so a user `continue`
//         if (i >= $hi_<var>) break; // (which jumps to the while header) still
//         <body>                     // advances the counter — break/continue work
//     }
//
// Empty / reversed ranges (`5..5`, `9..3`) run zero iterations. The helpers
// return BARE Stmt[] (never a struct wrapping a fresh array) to avoid the
// native RC free-list reclaim that corrupts a freshly-built array placed in a
// struct-literal field (cf. #2759).
//
// This runs in module_with_builtins (AST emitters), interp.eval_module, and
// ssa.build_func — NOT on the IR path (lift_lambdas), which keeps the
// `__range` shape for lower_range_for.
function iter_range_args(iter: Expr): Expr[] {
    match (iter) {
        ExprCall(c) => {
            if (c.args.len() != 2) { return []; }
            match (c.callee) {
                ExprIdent(id) => { if (id.name == "__range") { return c.args; } },
                _ => {}
            }
        },
        _ => {}
    }
    return [];
}

pub function desugar_ranges_block(body: Stmt[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        var r: Stmt[] = desugar_ranges_one(body[i]);
        var j: i32 = 0;
        while (j < r.len()) { out = out.append(r[j]); j = j + 1; }
        i = i + 1;
    }
    return out;
}

function desugar_ranges_one(st: Stmt): Stmt[] {
    match (st) {
        StmtFor(fr) => {
            var dbody: Stmt[] = desugar_ranges_block(fr.body);
            var rargs: Expr[] = iter_range_args(fr.iter);
            if (rargs.len() == 2) {
                var hi_name: string = "$hi_" + fr.var_name;
                var ivar: Stmt = s_var(fr.var_name, "i32", e_binary("-", rargs[0], e_number("1", "", false)));
                var hivar: Stmt = s_var(hi_name, "i32", rargs[1]);
                var incr: Stmt = s_assign(fr.var_name, e_binary("+", e_ident(fr.var_name), e_number("1", "", false)));
                var brk: Stmt = s_if(e_binary(">=", e_ident(fr.var_name), e_ident(hi_name)), [s_break()], []);
                var wbody: Stmt[] = [incr, brk];
                var k: i32 = 0;
                while (k < dbody.len()) { wbody = wbody.append(dbody[k]); k = k + 1; }
                return [ivar, hivar, s_while(e_bool(true), wbody)];
            }
            return [StmtFor { var_name: fr.var_name, iter: fr.iter, body: dbody, label: fr.label }];
        },
        StmtIf(f) => {
            return [StmtIf { cond: f.cond, then_body: desugar_ranges_block(f.then_body), else_body: desugar_ranges_block(f.else_body) }];
        },
        StmtWhile(w) => {
            return [StmtWhile { cond: w.cond, body: desugar_ranges_block(w.body), label: w.label }];
        },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var a: i32 = 0;
            while (a < m.arms.len()) {
                arms = arms.append(MatchArm { pattern: m.arms[a].pattern, body: desugar_ranges_block(m.arms[a].body), line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard });
                a = a + 1;
            }
            return [StmtMatch { scrutinee: m.scrutinee, arms: arms, line: m.line, col: m.col, origin: m.origin }];
        },
        StmtDefer(d) => {
            var r: Stmt[] = desugar_ranges_one(d.action);
            if (r.len() == 1) { return [StmtDefer { action: r[0], on_error: d.on_error }]; }
            return [st];
        },
        _ => { return [st]; }
    }
    return [st];
}

pub function desugar_ranges_func(fd: FuncDecl): FuncDecl {
    return FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: desugar_ranges_block(fd.body), line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str };
}

pub function desugar_ranges_module(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        funcs = funcs.append(desugar_ranges_func(mod.funcs[i]));
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: desugar_ranges_block(mod.top_stmts), enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// desugar_prepass_module fuses the three leading whole-module DESUGAR passes —
// resolve_labels_module, fill_default_args_module, desugar_ranges_module — into a
// single traversal that rebuilds the module ONCE instead of three times (#4394
// lever 3: the front-end composes ~14 allocating module rebuilds before the
// checker, and under partially-freeing RC each rebuild is resident cost). All
// three are pre-analysis LOCAL body rewrites — each maps func→func by rewriting
// only the statement body, never the signature list — so applying them in order
// per function is byte-identical to running them as three separate module passes:
//
//   * resolve_labels_block is purely local (labeled break/continue within a body).
//   * fda_stmts reads the funcs list only for callee SIGNATURES (fda_lookup_params
//     touches name / receiver_type / params, never bodies), and none of the three
//     passes alters a signature, so the ORIGINAL mod.funcs is the same signature
//     view the sequential fill_default_args pass saw post-resolve_labels.
//   * desugar_ranges_block is purely local (for-range → while), and the unlabeled
//     breaks it introduces run AFTER resolve_labels here exactly as in the
//     sequential order, so they are (correctly) never label-resolved.
//
// The fill-default-args guard (module_has_default_params / module_has_named_args)
// is likewise unaffected by resolve_labels (which adds/removes no default params
// or named args), so it is evaluated once on the incoming module and gates the
// per-body fda step — reproducing fill_default_args_module's early-return.
pub function desugar_prepass_module(mod: Module): Module {
    var need_fda: boolean = module_has_default_params(mod) || module_has_named_args(mod);
    var none: string[] = [];
    var funcs: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        var body: Stmt[] = resolve_labels_block(fd.body, none);
        if (need_fda) { body = fda_stmts(body, mod.funcs); }
        body = desugar_ranges_block(body);
        funcs = funcs.append(FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: body, line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str });
        i = i + 1;
    }
    var tops: Stmt[] = resolve_labels_block(mod.top_stmts, none);
    if (need_fda) { tops = fda_stmts(tops, mod.funcs); }
    tops = desugar_ranges_block(tops);
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: tops, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// ---------------------------------------------------------------------------
// Default-argument filling.
//
// `function f(a: i32, b: i32 = 128)` declares an optional parameter. A call
// that omits the trailing argument — `f(5)` — is rewritten to the complete
// positional call `f(5, 128)` here, so the checker, the IR lowering, the SSA
// backend, and the interpreter all see a full argument list and need no
// knowledge of defaults. Mirrors the native compiler's internal/defaultargs.
//
// The rewriter follows rw_call_expr / rw_call_stmts exactly — only the
// ExprCall arm differs: instead of appending captured names, it appends the
// callee's declared defaults for the omitted trailing parameters. A module
// with no defaulted parameter is returned verbatim (the precheck), so
// default-free programs — including the self-host's own sources — are
// byte-identical and the fixpoint holds.
function module_has_default_params(mod: Module): boolean {
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var ps: ParamDecl[] = mod.funcs[fi].params;
        var pi: i32 = 0;
        while (pi < ps.len()) {
            if (ps[pi].has_default) { return true; }
            pi = pi + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// fda_lookup_params returns the parameter list of the free function named
// `name`, or an empty list (a method — called via field access, not a bare
// ident — or a builtin never matches).
function fda_lookup_params(name: string, funcs: FuncDecl[]): ParamDecl[] {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].receiver_type.len() == 0 && funcs[i].name == name) {
            return funcs[i].params;
        }
        i = i + 1;
    }
    var none: ParamDecl[] = [];
    return none;
}

// ---- named-argument resolution (mirrors internal/defaultargs) ----
// A named argument `name = value` is parsed into a synthetic
// `ExprBinary("__named_arg", <name ident>, value)` marker. These helpers
// recognise, inspect, and resolve those markers against a callee's
// parameter list, turning a mixed positional/named call into a plain
// positional one with defaults filled — so every later pass and backend
// sees an ordinary `Args` list (the same contract the native pass gives
// the Go checker).

function fda_is_named_marker(e: Expr): boolean {
    match (e) {
        ExprBinary(b) => { return b.op == "__named_arg"; },
        _ => { return false; }
    }
    return false;
}

function fda_marker_name(e: Expr): string {
    match (e) {
        ExprBinary(b) => {
            match (b.left) {
                ExprIdent(id) => { return id.name; },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

function fda_marker_value(e: Expr): Expr {
    match (e) {
        ExprBinary(b) => { return b.right; },
        _ => { return e; }
    }
    return e;
}

function fda_args_have_named(args: Expr[]): boolean {
    var i: i32 = 0;
    while (i < args.len()) {
        if (fda_is_named_marker(args[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// fda_strip_named unwraps any named markers to their bare value, dropping
// the name. The fallback when a named argument lands on a callee we can't
// resolve (a method or an unknown function — an error in the native
// compiler); unwrapping keeps a well-formed positional call so nothing
// downstream trips over the marker.
function fda_strip_named(args: Expr[]): Expr[] {
    var out: Expr[] = [];
    var i: i32 = 0;
    while (i < args.len()) {
        if (fda_is_named_marker(args[i])) { out = out.append(fda_marker_value(args[i])); }
        else { out = out.append(args[i]); }
        i = i + 1;
    }
    return out;
}

function fda_named_lookup(names: string[], vals: Expr[], want: string): i32 {
    var i: i32 = 0;
    while (i < names.len()) {
        if (names[i] == want) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// fda_resolve_named rebuilds a positional argument list from a call whose
// args mix leading positionals and trailing `name = value` markers. Each
// parameter takes, in order: the matching leading positional, else a named
// value for its name, else its default. A still-unfilled required param
// gets its (empty) default_value placeholder — the same shape an omitted
// required positional arg leaves, so the checker's arity path reports it.
function fda_resolve_named(params: ParamDecl[], args: Expr[]): Expr[] {
    var posvals: Expr[] = [];
    var nnames: string[] = [];
    var nvals: Expr[] = [];
    var i: i32 = 0;
    while (i < args.len()) {
        if (fda_is_named_marker(args[i])) {
            nnames = nnames.append(fda_marker_name(args[i]));
            nvals = nvals.append(fda_marker_value(args[i]));
        } else {
            posvals = posvals.append(args[i]);
        }
        i = i + 1;
    }
    var out: Expr[] = [];
    var pi: i32 = 0;
    while (pi < params.len()) {
        if (pi < posvals.len()) {
            out = out.append(posvals[pi]);
        } else {
            var ni: i32 = fda_named_lookup(nnames, nvals, params[pi].name);
            if (ni >= 0) { out = out.append(nvals[ni]); }
            else { out = out.append(params[pi].default_value); }
        }
        pi = pi + 1;
    }
    // Surplus positional args (more than params) — keep them so an arity
    // error still surfaces rather than silently dropping arguments.
    var j: i32 = params.len();
    while (j < posvals.len()) { out = out.append(posvals[j]); j = j + 1; }
    return out;
}

// stmts_have_named / expr_has_named detect whether a module contains any
// named-argument marker, so fill_default_args_module runs the resolving
// walk even for a module with no default-valued parameters (named args and
// defaults are independent features).
function expr_has_named(e: Expr, depth: i32): boolean {
    if (depth > 256) { return false; }
    match (e) {
        ExprCall(c) => {
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (fda_is_named_marker(c.args[i])) { return true; }
                if (expr_has_named(c.args[i], depth + 1)) { return true; }
                i = i + 1;
            }
            return expr_has_named(c.callee, depth + 1);
        },
        ExprBinary(b) => {
            if (b.op == "__named_arg") { return true; }
            if (expr_has_named(b.left, depth + 1)) { return true; }
            return expr_has_named(b.right, depth + 1);
        },
        ExprUnary(u) => { return expr_has_named(u.operand, depth + 1); },
        ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (expr_has_named(a.elements[i], depth + 1)) { return true; } i = i + 1; }
            return false;
        },
        ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { if (expr_has_named(t.elements[i], depth + 1)) { return true; } i = i + 1; }
            return false;
        },
        ExprIndex(ix) => {
            if (expr_has_named(ix.array, depth + 1)) { return true; }
            return expr_has_named(ix.index, depth + 1);
        },
        ExprSlice(sl) => {
            if (expr_has_named(sl.array, depth + 1)) { return true; }
            if (expr_has_named(sl.start, depth + 1)) { return true; }
            return expr_has_named(sl.end, depth + 1);
        },
        ExprFieldAccess(fa) => { return expr_has_named(fa.obj, depth + 1); },
        ExprStructLit(s) => {
            var i: i32 = 0;
            while (i < s.field_values.len()) { if (expr_has_named(s.field_values[i], depth + 1)) { return true; } i = i + 1; }
            if (s.has_base) { return expr_has_named(s.base, depth + 1); }
            return false;
        },
        ExprLambda(lm) => { return stmts_have_named(lm.body); },
        _ => { return false; }
    }
    return false;
}

function stmts_have_named(stmts: Stmt[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => { if (expr_has_named(v.init, 0)) { return true; } },
            StmtReturn(r) => { if (expr_has_named(r.value, 0)) { return true; } },
            StmtExpr(e) => { if (expr_has_named(e.value, 0)) { return true; } },
            StmtAssign(a) => { if (expr_has_named(a.value, 0)) { return true; } },
            StmtIf(f) => {
                if (expr_has_named(f.cond, 0)) { return true; }
                if (stmts_have_named(f.then_body)) { return true; }
                if (stmts_have_named(f.else_body)) { return true; }
            },
            StmtWhile(w) => {
                if (expr_has_named(w.cond, 0)) { return true; }
                if (stmts_have_named(w.body)) { return true; }
            },
            StmtFor(fr) => {
                if (expr_has_named(fr.iter, 0)) { return true; }
                if (stmts_have_named(fr.body)) { return true; }
            },
            StmtMatch(m) => {
                if (expr_has_named(m.scrutinee, 0)) { return true; }
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    if (stmts_have_named(m.arms[a].body)) { return true; }
                    a = a + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

function module_has_named_args(mod: Module): boolean {
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (stmts_have_named(mod.funcs[fi].body)) { return true; }
        fi = fi + 1;
    }
    return stmts_have_named(mod.top_stmts);
}

function fda_expr(e: Expr, funcs: FuncDecl[]): Expr {
    match (e) {
        ExprCall(c) => {
            var new_callee: Expr = fda_expr(c.callee, funcs);
            var new_args: Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { new_args = new_args.append(fda_expr(c.args[i], funcs)); i = i + 1; }
            var has_named: boolean = fda_args_have_named(new_args);
            match (c.callee) {
                ExprIdent(id) => {
                    var params: ParamDecl[] = fda_lookup_params(id.name, funcs);
                    if (has_named) {
                        // Reorder named + leading-positional args into a plain
                        // positional list, filling defaults. A named arg on an
                        // unknown callee (no params found) falls back to a
                        // name-stripped positional call.
                        if (params.len() > 0) { new_args = fda_resolve_named(params, new_args); }
                        else { new_args = fda_strip_named(new_args); }
                    } else if (params.len() > new_args.len()) {
                        var ok: boolean = true;
                        var k: i32 = new_args.len();
                        while (k < params.len()) { if (!params[k].has_default) { ok = false; } k = k + 1; }
                        if (ok) {
                            var j: i32 = new_args.len();
                            while (j < params.len()) { new_args = new_args.append(params[j].default_value); j = j + 1; }
                        }
                    }
                },
                _ => {
                    // Method / indirect callee: named args aren't supported on
                    // these (an error natively); strip the marker so codegen
                    // never sees it.
                    if (has_named) { new_args = fda_strip_named(new_args); }
                }
            }
            return ExprCall { callee: new_callee, args: new_args, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        ExprBinary(b) => { return e_binary(b.op, fda_expr(b.left, funcs), fda_expr(b.right, funcs)); },
        ExprUnary(u) => { return e_unary(u.op, fda_expr(u.operand, funcs)); },
        ExprArray(a) => {
            var els: Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { els = els.append(fda_expr(a.elements[i], funcs)); i = i + 1; }
            return e_array(els);
        },
        ExprTuple(t) => {
            var els: Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { els = els.append(fda_expr(t.elements[i], funcs)); i = i + 1; }
            return e_tuple_at(els, t.line, t.col);
        },
        ExprIndex(ix) => { return e_index(fda_expr(ix.array, funcs), fda_expr(ix.index, funcs)); },
        ExprSlice(sl) => { return e_slice(fda_expr(sl.array, funcs), fda_expr(sl.start, funcs), fda_expr(sl.end, funcs)); },
        ExprFieldAccess(fa) => { return e_field_access(fda_expr(fa.obj, funcs), fa.field); },
        ExprStructLit(s) => {
            var vals: Expr[] = [];
            var i: i32 = 0;
            while (i < s.field_values.len()) { vals = vals.append(fda_expr(s.field_values[i], funcs)); i = i + 1; }
            var nb: Expr = s.base;
            if (s.has_base) { nb = fda_expr(s.base, funcs); }
            return ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: nb, line: s.line, col: s.col };
        },
        ExprLambda(lm) => { return e_lambda(lm.params, lm.ret_type, fda_stmts(lm.body, funcs)); },
        _ => { return e; }
    }
}

function fda_stmts(stmts: Stmt[], funcs: FuncDecl[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => { out = out.append(s_var_at(v.name, v.type_name, fda_expr(v.init, funcs), v.line, v.col)); },
            StmtReturn(r) => { out = out.append(s_return_at(fda_expr(r.value, funcs), r.line, r.col)); },
            StmtExpr(e) => { out = out.append(s_expr(fda_expr(e.value, funcs))); },
            StmtAssign(a) => { out = out.append(s_assign_at(a.target, fda_expr(a.value, funcs), a.line, a.col, a.target_line, a.target_col)); },
            StmtIf(f) => { out = out.append(s_if(fda_expr(f.cond, funcs), fda_stmts(f.then_body, funcs), fda_stmts(f.else_body, funcs))); },
            StmtWhile(w) => { out = out.append(s_while(fda_expr(w.cond, funcs), fda_stmts(w.body, funcs))); },
            StmtFor(fr) => { out = out.append(s_for(fr.var_name, fda_expr(fr.iter, funcs), fda_stmts(fr.body, funcs))); },
            StmtMatch(m) => {
                var arms: MatchArm[] = [];
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    arms = arms.append(MatchArm { pattern: m.arms[a].pattern, body: fda_stmts(m.arms[a].body, funcs), line: m.arms[a].line, col: m.arms[a].col, guard: fda_expr(m.arms[a].guard, funcs), has_guard: m.arms[a].has_guard });
                    a = a + 1;
                }
                out = out.append(s_match_at(fda_expr(m.scrutinee, funcs), arms, m.line, m.col));
            },
            StmtDefer(d) => {
                var one: Stmt[] = [d.action];
                var rd: Stmt[] = fda_stmts(one, funcs);
                if (rd.len() >= 1) { out = out.append(s_defer(rd[0])); }
            },
            _ => { out = out.append(stmts[i]); },
        }
        i = i + 1;
    }
    return out;
}

pub function fill_default_args_module(mod: Module): Module {
    if (!module_has_default_params(mod) && !module_has_named_args(mod)) { return mod; }
    var funcs: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        funcs = funcs.append(FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: fda_stmts(fd.body, mod.funcs), line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str });
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: fda_stmts(mod.top_stmts, mod.funcs), enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// ---- return-type inference -----------------------------------------
// An unannotated function (ret_type == "") gets its return type inferred
// from its `return` expressions, so call sites tag the result correctly
// (e.g. `greet().len()` needs `greet` to be known to return string).
// Mirrors the native checker's inferReturnType. The self-host's own
// sources are fully annotated, so every function keeps ret_type != ""
// and this pass is byte-identical for them (fixpoint-safe). It BAILS
// (leaves "") on anything it can't pin down — locals, recursion,
// conflicting or complex returns — preserving the prior behaviour for
// those rather than guessing.

function irt_param_type(params: ParamDecl[], name: string): string {
    var i: i32 = 0;
    while (i < params.len()) {
        if (params[i].name == name) { return params[i].type_name; }
        i = i + 1;
    }
    return "";
}

function irt_func_ret(funcs: FuncDecl[], name: string): string {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_type.len() == 0) { return funcs[i].ret_type; }
        i = i + 1;
    }
    return "";
}

function irt_is_cmp(op: string): boolean {
    return op == "<" || op == "<=" || op == ">" || op == ">="
        || op == "==" || op == "!=" || op == "&&" || op == "||";
}

function irt_is_option(s: string): boolean {
    return s.len() >= 7 && s[0:7] == "Option[";
}

// irt_guess returns the inferred type-name string for a return expression,
// or "" if it can't be determined.
function irt_guess(e: Expr, params: ParamDecl[], funcs: FuncDecl[]): string {
    match (e) {
        ExprNumber(n) => { if (n.is_float) { return "f64"; } return "i32"; },
        ExprString(_) => { return "string"; },
        ExprBool(_) => { return "boolean"; },
        ExprIdent(id) => { return irt_param_type(params, id.name); },
        ExprBinary(b) => {
            if (irt_is_cmp(b.op)) { return "boolean"; }
            return irt_guess(b.left, params, funcs);
        },
        ExprStructLit(s) => { return s.type_name; },
        // A non-empty array literal infers `T[]` from its first element
        // (#5326): without this an unannotated array-returning function never
        // enters the `*_ret_fns_of` registries, so a `var a = f()` binding
        // left the slot's element kind untracked and a[i] silently took the
        // 4-byte default stride — a wrong-value miscompile for f64/string
        // elements on the self-host IR path.
        ExprArray(al) => {
            if (al.elements.len() == 0) { return ""; }
            var el: string = irt_guess(al.elements[0], params, funcs);
            if (el == "") { return ""; }
            return el + "[]";
        },
        ExprCall(c) => {
            match (c.callee) {
                ExprIdent(cid) => {
                    if (cid.name == "Some") {
                        if (c.args.len() == 1) {
                            var inner: string = irt_guess(c.args[0], params, funcs);
                            if (inner != "") { return "Option[" + inner + "]"; }
                        }
                        return "Option";
                    }
                    if (cid.name == "None") { return "Option"; }
                    // Result needs both type arguments which a single Ok/Err
                    // return can't supply; leave it to an annotation.
                    if (cid.name == "Ok" || cid.name == "Err") { return ""; }
                    return irt_func_ret(funcs, cid.name);
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}

function irt_unify(a: string, b: string): string {
    if (a == b) { return a; }
    if (irt_is_option(a) && b == "Option") { return a; }
    if (irt_is_option(b) && a == "Option") { return b; }
    return "";
}

function irt_collect_returns(stmts: Stmt[], acc: Expr[]): Expr[] {
    var out: Expr[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        out = irt_collect_stmt(stmts[i], out);
        i = i + 1;
    }
    return out;
}

function irt_collect_stmt(st: Stmt, acc: Expr[]): Expr[] {
    match (st) {
        StmtReturn(r) => { return acc.append(r.value); },
        StmtIf(f) => {
            var a: Expr[] = irt_collect_returns(f.then_body, acc);
            return irt_collect_returns(f.else_body, a);
        },
        StmtWhile(w) => { return irt_collect_returns(w.body, acc); },
        StmtFor(fr) => { return irt_collect_returns(fr.body, acc); },
        StmtMatch(m) => {
            var a: Expr[] = acc;
            var i: i32 = 0;
            while (i < m.arms.len()) { a = irt_collect_returns(m.arms[i].body, a); i = i + 1; }
            return a;
        },
        _ => { return acc; }
    }
}

// irt_infer_func unifies the inferred types of every return in fd, or "" if
// any return can't be determined or they conflict (a bare `return;` value is
// ExprUnknown -> "" -> bail, so void / mixed functions keep their void type).
function irt_infer_func(fd: FuncDecl, funcs: FuncDecl[]): string {
    var empty: Expr[] = [];
    var rets: Expr[] = irt_collect_returns(fd.body, empty);
    if (rets.len() == 0) { return ""; }
    var unified: string = "";
    var i: i32 = 0;
    while (i < rets.len()) {
        var g: string = irt_guess(rets[i], fd.params, funcs);
        if (g == "") { return ""; }
        if (unified == "") { unified = g; }
        else {
            unified = irt_unify(unified, g);
            if (unified == "") { return ""; }
        }
        i = i + 1;
    }
    return unified;
}

function irt_set_ret(funcs: FuncDecl[], idx: i32, rt: string): FuncDecl[] {
    var out: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (i == idx) {
            var f: FuncDecl = funcs[i];
            out = out.append(FuncDecl { name: f.name, receiver_name: f.receiver_name, receiver_type: f.receiver_type, type_params: f.type_params, params: f.params, ret_type: rt, body: f.body, line: f.line, col: f.col, import_iface: f.import_iface, import_wit: f.import_wit, type_param_count: f.type_param_count, bound_traits: f.bound_traits, fip: f.fip, ret_str: f.ret_str });
        } else {
            out = out.append(funcs[i]);
        }
        i = i + 1;
    }
    return out;
}

// infer_ret_types_module stamps an inferred ret_type on each unannotated
// plain (non-method, non-generic) function. A few passes let a call to a
// function inferred later in the list resolve.
pub function infer_ret_types_module(mod: Module): Module {
    var funcs: FuncDecl[] = mod.funcs;
    var pass: i32 = 0;
    while (pass < 3) {
        var i: i32 = 0;
        while (i < funcs.len()) {
            var fd: FuncDecl = funcs[i];
            if (fd.ret_type == "" && fd.body.len() > 0 && fd.receiver_type.len() == 0 && fd.type_param_count == 0) {
                var inferred: string = irt_infer_func(fd, funcs);
                if (inferred != "") { funcs = irt_set_ret(funcs, i, inferred); }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// ---- call-only 0-arg fn-value inlining ------------------------------
// The self-host's "bare 0-arg receiver-less fn name = a CALL to it" rule (the
// `const` rule, #2954) mis-lowers `var f = mk` (mk a 0-arg function) to
// `var f = mk()`, binding the RESULT — so a later `f()` calls a non-function
// and segfaults (an IR-path miscompile for an i32 return, an AST one for a
// struct). When `f` is used ONLY as a call target, it is unambiguously the
// function VALUE of a 0-arg function — and a 0-arg fn-value called is exactly
// its direct call evaluated at each call site (matching the native compiler).
// So inline it: drop the `var f = mk` binding and rewrite every `f(args)` to
// `mk(args)`. `f` used as a value (`return f`, `g(f)`), reassigned, or
// re-declared in a nested scope is left alone (the const-call semantics still
// apply). The native compiler already handles this; this is a self-host-only
// fix that lands on BOTH the IR and AST paths (both consume this module). The
// compiler source uses no such bindings, so the pass is fixpoint-neutral.

// CFScan counts a name's VALUE uses (as a plain value) and CALL uses (as a
// direct call callee) within an expression / statement subtree.
struct CFScan { vals: i32, calls: i32 }
function cf_add(a: CFScan, b: CFScan): CFScan { return CFScan { vals: a.vals + b.vals, calls: a.calls + b.calls }; }

function cf_zero(): CFScan { return CFScan { vals: 0, calls: 0 }; }

// cf_is_zero_arg_fn reports whether `name` is a receiver-less module function
// with zero parameters (the const-rule shape that `var f = name` mis-handles).
function cf_is_zero_arg_fn(funcs: FuncDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].params.len() == 0) { return true; }
        i = i + 1;
    }
    return false;
}

function cf_scan_expr(e: Expr, f: string): CFScan {
    match (e) {
        ExprIdent(id) => { if (id.name == f) { return CFScan { vals: 1, calls: 0 }; } return cf_zero(); },
        ExprBinary(b) => { return cf_add(cf_scan_expr(b.left, f), cf_scan_expr(b.right, f)); },
        ExprUnary(u) => { return cf_scan_expr(u.operand, f); },
        ExprCall(c) => {
            var acc: CFScan = cf_zero();
            var callee_is_f: boolean = false;
            match (c.callee) {
                ExprIdent(cid) => { if (cid.name == f) { callee_is_f = true; } },
                _ => { }
            }
            if (callee_is_f) { acc = CFScan { vals: 0, calls: 1 }; }
            else { acc = cf_scan_expr(c.callee, f); }
            var i: i32 = 0;
            while (i < c.args.len()) { acc = cf_add(acc, cf_scan_expr(c.args[i], f)); i = i + 1; }
            return acc;
        },
        ExprArray(a) => {
            var acc: CFScan = cf_zero();
            var i: i32 = 0;
            while (i < a.elements.len()) { acc = cf_add(acc, cf_scan_expr(a.elements[i], f)); i = i + 1; }
            return acc;
        },
        ExprTuple(t) => {
            var acc: CFScan = cf_zero();
            var i: i32 = 0;
            while (i < t.elements.len()) { acc = cf_add(acc, cf_scan_expr(t.elements[i], f)); i = i + 1; }
            return acc;
        },
        ExprIndex(ix) => { return cf_add(cf_scan_expr(ix.array, f), cf_scan_expr(ix.index, f)); },
        ExprSlice(sl) => { return cf_add(cf_scan_expr(sl.array, f), cf_add(cf_scan_expr(sl.start, f), cf_scan_expr(sl.end, f))); },
        ExprStructLit(sl) => {
            var acc: CFScan = cf_scan_expr(sl.base, f);
            var i: i32 = 0;
            while (i < sl.field_values.len()) { acc = cf_add(acc, cf_scan_expr(sl.field_values[i], f)); i = i + 1; }
            return acc;
        },
        ExprFieldAccess(fa) => { return cf_scan_expr(fa.obj, f); },
        ExprLambda(lm) => { return cf_scan_stmts(lm.body, f); },
        _ => { return cf_zero(); }
    }
    return cf_zero();
}

function cf_scan_stmt(st: Stmt, f: string): CFScan {
    match (st) {
        StmtVar(v) => { return cf_scan_expr(v.init, f); },
        StmtReturn(r) => { return cf_scan_expr(r.value, f); },
        StmtExpr(x) => { return cf_scan_expr(x.value, f); },
        StmtAssign(a) => {
            var base: CFScan = cf_scan_expr(a.value, f);
            if (a.target == f) { return cf_add(base, CFScan { vals: 1, calls: 0 }); }
            return base;
        },
        StmtIf(fst) => { return cf_add(cf_scan_expr(fst.cond, f), cf_add(cf_scan_stmts(fst.then_body, f), cf_scan_stmts(fst.else_body, f))); },
        StmtWhile(w) => { return cf_add(cf_scan_expr(w.cond, f), cf_scan_stmts(w.body, f)); },
        StmtFor(fr) => { return cf_add(cf_scan_expr(fr.iter, f), cf_scan_stmts(fr.body, f)); },
        StmtMatch(m) => {
            var acc: CFScan = cf_scan_expr(m.scrutinee, f);
            var i: i32 = 0;
            while (i < m.arms.len()) { acc = cf_add(acc, cf_add(cf_scan_expr(m.arms[i].guard, f), cf_scan_stmts(m.arms[i].body, f))); i = i + 1; }
            return acc;
        },
        StmtDefer(d) => { return cf_scan_stmt(d.action, f); },
        _ => { return cf_zero(); }
    }
    return cf_zero();
}

function cf_scan_stmts(stmts: Stmt[], f: string): CFScan {
    var acc: CFScan = cf_zero();
    var i: i32 = 0;
    while (i < stmts.len()) { acc = cf_add(acc, cf_scan_stmt(stmts[i], f)); i = i + 1; }
    return acc;
}

// cf_decl_count counts `var <name>` bindings anywhere in a statement list.
function cf_decl_count(stmts: Stmt[], name: string): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            StmtVar(v) => { if (v.name == name) { n = n + 1; } },
            StmtIf(f) => { n = n + cf_decl_count(f.then_body, name) + cf_decl_count(f.else_body, name); },
            StmtWhile(w) => { n = n + cf_decl_count(w.body, name); },
            StmtFor(fr) => { n = n + cf_decl_count(fr.body, name); if (fr.var_name == name) { n = n + 1; } },
            StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) { n = n + cf_decl_count(m.arms[ai].body, name); ai = ai + 1; }
            },
            _ => { }
        }
        i = i + 1;
    }
    return n;
}

// cf_rw_expr rewrites every direct call `f(args)` to `target(args)`.
function cf_rw_expr(e: Expr, f: string, target: string): Expr {
    match (e) {
        ExprBinary(b) => { return ExprBinary { op: b.op, left: cf_rw_expr(b.left, f, target), right: cf_rw_expr(b.right, f, target), line: b.line, col: b.col }; },
        ExprUnary(u) => { return ExprUnary { op: u.op, operand: cf_rw_expr(u.operand, f, target), line: u.line, col: u.col }; },
        ExprCall(c) => {
            var na: Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { na = na.append(cf_rw_expr(c.args[i], f, target)); i = i + 1; }
            var ncallee: Expr = c.callee;
            var done: boolean = false;
            match (c.callee) {
                ExprIdent(cid) => { if (cid.name == f) { ncallee = ExprIdent { name: target, line: cid.line, col: cid.col }; done = true; } },
                _ => { }
            }
            if (!done) { ncallee = cf_rw_expr(c.callee, f, target); }
            return ExprCall { callee: ncallee, args: na, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        ExprArray(a) => {
            var ne: Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { ne = ne.append(cf_rw_expr(a.elements[i], f, target)); i = i + 1; }
            return ExprArray { elements: ne };
        },
        ExprTuple(t) => {
            var ne: Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { ne = ne.append(cf_rw_expr(t.elements[i], f, target)); i = i + 1; }
            return ExprTuple { elements: ne, line: t.line, col: t.col };
        },
        ExprIndex(ix) => { return ExprIndex { array: cf_rw_expr(ix.array, f, target), index: cf_rw_expr(ix.index, f, target), unchecked: ix.unchecked }; },
        ExprSlice(sl) => { return ExprSlice { array: cf_rw_expr(sl.array, f, target), start: cf_rw_expr(sl.start, f, target), end: cf_rw_expr(sl.end, f, target) }; },
        ExprStructLit(sl) => {
            var nv: Expr[] = [];
            var i: i32 = 0;
            while (i < sl.field_values.len()) { nv = nv.append(cf_rw_expr(sl.field_values[i], f, target)); i = i + 1; }
            return ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: cf_rw_expr(sl.base, f, target), line: sl.line, col: sl.col };
        },
        ExprFieldAccess(fa) => { return ExprFieldAccess { obj: cf_rw_expr(fa.obj, f, target), field: fa.field, line: fa.line, col: fa.col }; },
        ExprLambda(lm) => { return ExprLambda { params: lm.params, ret_type: lm.ret_type, body: cf_rw_stmts(lm.body, f, target), use_infer: lm.use_infer }; },
        _ => { return e; }
    }
    return e;
}

function cf_rw_stmt(st: Stmt, f: string, target: string): Stmt {
    match (st) {
        StmtVar(v) => { return StmtVar { name: v.name, type_name: v.type_name, init: cf_rw_expr(v.init, f, target), line: v.line, col: v.col, is_str: v.is_str }; },
        StmtReturn(r) => { return StmtReturn { value: cf_rw_expr(r.value, f, target), line: r.line, col: r.col }; },
        StmtExpr(x) => { return StmtExpr { value: cf_rw_expr(x.value, f, target) }; },
        StmtAssign(a) => { return StmtAssign { target: a.target, value: cf_rw_expr(a.value, f, target), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }; },
        StmtIf(fst) => { return StmtIf { cond: cf_rw_expr(fst.cond, f, target), then_body: cf_rw_stmts(fst.then_body, f, target), else_body: cf_rw_stmts(fst.else_body, f, target) }; },
        StmtWhile(w) => { return StmtWhile { cond: cf_rw_expr(w.cond, f, target), body: cf_rw_stmts(w.body, f, target), label: w.label }; },
        StmtFor(fr) => { return StmtFor { var_name: fr.var_name, iter: cf_rw_expr(fr.iter, f, target), body: cf_rw_stmts(fr.body, f, target), label: fr.label }; },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) { arms = arms.append(MatchArm { pattern: m.arms[i].pattern, body: cf_rw_stmts(m.arms[i].body, f, target), line: m.arms[i].line, col: m.arms[i].col, guard: cf_rw_expr(m.arms[i].guard, f, target), has_guard: m.arms[i].has_guard }); i = i + 1; }
            return StmtMatch { scrutinee: cf_rw_expr(m.scrutinee, f, target), arms: arms, line: m.line, col: m.col, origin: m.origin };
        },
        StmtDefer(d) => { return StmtDefer { action: cf_rw_stmt(d.action, f, target), on_error: d.on_error }; },
        _ => { return st; }
    }
    return st;
}

function cf_rw_stmts(stmts: Stmt[], f: string, target: string): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) { out = out.append(cf_rw_stmt(stmts[i], f, target)); i = i + 1; }
    return out;
}

// ===================================================================
// #4380 lever 3: syntactic bounds-check elision for len-bounded loops.
//
// A purely syntactic pass (mirroring internal/parser/bounds_elide.go) that
// marks array-index READS `arr[i]` inside a `while (i < arr.len())` loop as
// Unchecked, so irlower drops the per-iteration bounds check + the per-access
// `len` reload (op_arr_get_nc). No type info is
// consulted: the IR honours the flag ONLY on the true array path, so marking a
// string / map index is a harmless no-op there.
//
// Self-host specifics vs the native pass:
//   - There is no C-style-for AST node (parse_for_stmt desugars it to
//     `while (true) { … if (!(cond)) break … }` at parse time), so only an
//     EXPLICIT `while (i < arr.len())` guard is matched. The self-host code
//     the pass targets uses that idiom near-universally.
//   - Index WRITES desugar to `__set_index(arr, i, v)` calls, never ExprIndex,
//     so every `arr[i]` ExprIndex is a read — no write target to mis-mark.
//   - Closures capture by value and the checker forbids assigning a captured
//     variable (E049), so a lambda body can never mutate the outer `i` / rebind
//     `arr`. The safety walks below therefore recurse through statements only
//     (assignments are always statements; the only expr carrying statements is
//     a lambda, which cannot touch the outer bindings).
//
// An access is marked only when `0 <= i < len(arr)` is syntactically provable:
//   - the guard is exactly `i < arr.len()` (strict `<`, both operands bare
//     idents) — the upper bound `i < len`;
//   - `i` starts at a non-negative integer literal in the statement immediately
//     before the loop, and every assignment to `i` in the body is
//     `i = i + <non-negative int literal>` — so `i` is monotonic non-decreasing
//     and never drops below 0 (the check also guards NEGATIVE indices);
//   - `arr` is never reassigned and neither `i` nor `arr` is rebound (shadowed)
//     in the body — so `len(arr)` and the binding stay invariant;
//   - the access precedes the first statement that assigns `i` (a read after an
//     increment could reach `len`).
// Accesses inside a lambda / defer body are never marked: that code runs later,
// when `i` may have advanced past `len`.

struct LenLoopMatch { ok: boolean, idx: string, arr: string }
struct LenArrRef { ok: boolean, name: string }

// elide_len_bounded_body is the pass entry: it rewrites a function body,
// returning a copy with in-bounds `arr[i]` reads marked. Called at
// irlower.lower_func entry — after every AST transform — so no later pass
// clobbers the flag and the transform sites all default it to false.
pub function elide_len_bounded_body(stmts: Stmt[]): Stmt[] {
    // Recurse into nested statement lists first, so inner loops are handled in
    // place; then elide while-loops at THIS level (each needs its preceding
    // statement as the source of `i`'s start value).
    var lowered: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) { lowered = lowered.append(elb_recurse_stmt(stmts[i])); i = i + 1; }
    var out: Stmt[] = [];
    var p: i32 = 0;
    while (p < lowered.len()) {
        var st: Stmt = lowered[p];
        match (st) {
            StmtWhile(w) => { if (p > 0) { st = elb_try_while(w, lowered[p - 1]); } },
            _ => { }
        }
        out = out.append(st);
        p = p + 1;
    }
    return out;
}

// elb_recurse_stmt rebuilds one statement with elide_len_bounded_body applied to
// each nested statement list (does NOT descend into lambda bodies — they are
// lifted to their own FuncDecls before lower_func, each processed separately).
function elb_recurse_stmt(st: Stmt): Stmt {
    match (st) {
        StmtIf(f) => { return StmtIf { cond: f.cond, then_body: elide_len_bounded_body(f.then_body), else_body: elide_len_bounded_body(f.else_body) }; },
        StmtWhile(w) => { return StmtWhile { cond: w.cond, body: elide_len_bounded_body(w.body), label: w.label }; },
        StmtFor(fr) => { return StmtFor { var_name: fr.var_name, iter: fr.iter, body: elide_len_bounded_body(fr.body), label: fr.label }; },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var arm: MatchArm = m.arms[i];
                arms = arms.append(MatchArm { pattern: arm.pattern, body: elide_len_bounded_body(arm.body), line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard });
                i = i + 1;
            }
            return StmtMatch { scrutinee: m.scrutinee, arms: arms, line: m.line, col: m.col, origin: m.origin };
        },
        StmtDefer(d) => { return StmtDefer { action: elb_recurse_stmt(d.action), on_error: d.on_error }; },
        _ => { return st; }
    }
    return st;
}

// elb_try_while checks the invariants for one while-loop and, when they hold,
// returns the loop with its qualifying body-prefix reads marked. `prev` is the
// statement immediately before the loop (the source of `i`'s start value).
function elb_try_while(w: StmtWhile, prev: Stmt): Stmt {
    var m: LenLoopMatch = elb_loop_match(w.cond);
    if (!m.ok) { return StmtWhile { cond: w.cond, body: w.body, label: w.label }; }
    if (elb_assigns_stmts(w.body, m.arr)) { return StmtWhile { cond: w.cond, body: w.body, label: w.label }; }
    if (elb_binds_stmts(w.body, m.idx) || elb_binds_stmts(w.body, m.arr)) { return StmtWhile { cond: w.cond, body: w.body, label: w.label }; }
    if (!elb_idx_monotonic_stmts(w.body, m.idx)) { return StmtWhile { cond: w.cond, body: w.body, label: w.label }; }
    if (!elb_starts_nonneg(prev, m.idx)) { return StmtWhile { cond: w.cond, body: w.body, label: w.label }; }
    var nb: Stmt[] = [];
    var i: i32 = 0;
    var stop: boolean = false;
    while (i < w.body.len()) {
        var st: Stmt = w.body[i];
        if (!stop && elb_assigns_stmt(st, m.idx)) { stop = true; }
        if (!stop) { st = elb_mark_stmt(st, m.idx, m.arr); }
        nb = nb.append(st);
        i = i + 1;
    }
    return StmtWhile { cond: w.cond, body: nb, label: w.label };
}

// elb_loop_match matches `IDX < ARR.len()` (strict `<`, both operands bare
// idents, IDX != ARR) and returns (IDX, ARR).
function elb_loop_match(cond: Expr): LenLoopMatch {
    match (cond) {
        ExprBinary(b) => {
            if (b.op == "<") {
                match (b.left) {
                    ExprIdent(li) => {
                        var la: LenArrRef = elb_len_array(b.right);
                        if (la.ok && la.name != li.name) { return LenLoopMatch { ok: true, idx: li.name, arr: la.name }; }
                    },
                    _ => { }
                }
            }
        },
        _ => { }
    }
    return LenLoopMatch { ok: false, idx: "", arr: "" };
}

// elb_len_array returns the array-ident of a `A.len()` length expression, where
// A is a bare ident. Fern has no free `len(A)` function (that idiom is E001), so
// only the method form is matched.
function elb_len_array(e: Expr): LenArrRef {
    match (e) {
        ExprCall(c) => {
            match (c.callee) {
                ExprFieldAccess(fa) => {
                    if (fa.field == "len" && c.args.len() == 0) {
                        match (fa.obj) { ExprIdent(id) => { return LenArrRef { ok: true, name: id.name }; }, _ => { } }
                    }
                },
                _ => { }
            }
        },
        _ => { }
    }
    return LenArrRef { ok: false, name: "" };
}

// elb_starts_nonneg proves `idx`'s entry value is a non-negative integer literal
// from the immediately-preceding `var idx = v` / `idx = v` statement (nothing
// runs between it and the guard).
function elb_starts_nonneg(prev: Stmt, idx: string): boolean {
    match (prev) {
        StmtVar(v) => { if (v.name == idx) { return elb_is_nonneg_int(v.init); } },
        StmtAssign(a) => { if (a.target == idx) { return elb_is_nonneg_int(a.value); } },
        _ => { }
    }
    return false;
}

// elb_is_nonneg_int reports whether e is a non-negative integer literal. The
// lexer tokenises `-1` as unary-minus over `1`, so a bare integer ExprNumber is
// always non-negative; the leading-digit guard is belt-and-braces.
function elb_is_nonneg_int(e: Expr): boolean {
    match (e) {
        ExprNumber(n) => {
            if (n.is_float) { return false; }
            if (n.text.len() == 0) { return false; }
            var c0: i32 = n.text[0];
            return c0 >= 48 && c0 <= 57;
        },
        _ => { return false; }
    }
    return false;
}

// elb_assigns_stmts / elb_assigns_stmt report whether any `name = …` assignment
// appears in the statement subtree. Assignments are always statements (the only
// expr that carries statements is a lambda, which cannot assign the outer name),
// so no expression walk is needed.
function elb_assigns_stmts(stmts: Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) { if (elb_assigns_stmt(stmts[i], name)) { return true; } i = i + 1; }
    return false;
}
function elb_assigns_stmt(st: Stmt, name: string): boolean {
    match (st) {
        StmtAssign(a) => { return a.target == name; },
        StmtIf(f) => { return elb_assigns_stmts(f.then_body, name) || elb_assigns_stmts(f.else_body, name); },
        StmtWhile(w) => { return elb_assigns_stmts(w.body, name); },
        StmtFor(fr) => { return elb_assigns_stmts(fr.body, name); },
        StmtMatch(m) => {
            var i: i32 = 0;
            while (i < m.arms.len()) { if (elb_assigns_stmts(m.arms[i].body, name)) { return true; } i = i + 1; }
            return false;
        },
        StmtDefer(d) => { return elb_assigns_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}

// elb_binds_stmts / elb_binds_stmt report whether the statement subtree rebinds
// (declares / shadows / iterates) `name` via a `var`, a `for` loop variable, or
// a match-arm pattern binding.
function elb_binds_stmts(stmts: Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) { if (elb_binds_stmt(stmts[i], name)) { return true; } i = i + 1; }
    return false;
}
function elb_binds_stmt(st: Stmt, name: string): boolean {
    match (st) {
        StmtVar(v) => { return v.name == name; },
        StmtFor(fr) => { if (fr.var_name == name) { return true; } return elb_binds_stmts(fr.body, name); },
        StmtIf(f) => { return elb_binds_stmts(f.then_body, name) || elb_binds_stmts(f.else_body, name); },
        StmtWhile(w) => { return elb_binds_stmts(w.body, name); },
        StmtMatch(m) => {
            var i: i32 = 0;
            while (i < m.arms.len()) {
                if (elb_pat_binds(m.arms[i].pattern, name)) { return true; }
                if (elb_binds_stmts(m.arms[i].body, name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        StmtDefer(d) => { return elb_binds_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}
function elb_pat_binds(p: Pattern, name: string): boolean {
    match (p) {
        PatVariant(pv) => {
            if (pv.binding == name) { return true; }
            var i: i32 = 0;
            while (i < pv.extra_bindings.len()) { if (pv.extra_bindings[i] == name) { return true; } i = i + 1; }
            var j: i32 = 0;
            while (j < pv.nested.len()) { if (elb_pat_binds(pv.nested[j], name)) { return true; } j = j + 1; }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// elb_idx_monotonic_stmts / _stmt report whether EVERY assignment to `idx` in
// the subtree is `idx = idx + <non-negative int literal>` (keeps idx monotonic
// non-decreasing). Any other shape fails.
function elb_idx_monotonic_stmts(stmts: Stmt[], idx: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) { if (!elb_idx_monotonic_stmt(stmts[i], idx)) { return false; } i = i + 1; }
    return true;
}
function elb_idx_monotonic_stmt(st: Stmt, idx: string): boolean {
    match (st) {
        StmtAssign(a) => { if (a.target == idx) { return elb_is_monotonic_incr(a.value, idx); } return true; },
        StmtIf(f) => { return elb_idx_monotonic_stmts(f.then_body, idx) && elb_idx_monotonic_stmts(f.else_body, idx); },
        StmtWhile(w) => { return elb_idx_monotonic_stmts(w.body, idx); },
        StmtFor(fr) => { return elb_idx_monotonic_stmts(fr.body, idx); },
        StmtMatch(m) => {
            var i: i32 = 0;
            while (i < m.arms.len()) { if (!elb_idx_monotonic_stmts(m.arms[i].body, idx)) { return false; } i = i + 1; }
            return true;
        },
        StmtDefer(d) => { return elb_idx_monotonic_stmt(d.action, idx); },
        _ => { return true; }
    }
    return true;
}
function elb_is_monotonic_incr(v: Expr, idx: string): boolean {
    match (v) {
        ExprBinary(b) => {
            if (b.op == "+") {
                match (b.left) {
                    ExprIdent(li) => { if (li.name == idx) { return elb_is_nonneg_int(b.right); } },
                    _ => { }
                }
            }
        },
        _ => { }
    }
    return false;
}

// elb_mark_stmt / elb_mark_stmts / elb_mark_expr rebuild the subtree, setting
// `unchecked` on every `arr[idx]` read (both operands the exact idents). They do
// NOT descend into lambda bodies or defer actions — that code runs later, when
// idx may have advanced past len.
function elb_mark_stmts(stmts: Stmt[], idx: string, arr: string): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) { out = out.append(elb_mark_stmt(stmts[i], idx, arr)); i = i + 1; }
    return out;
}
function elb_mark_stmt(st: Stmt, idx: string, arr: string): Stmt {
    match (st) {
        StmtVar(v) => { return StmtVar { name: v.name, type_name: v.type_name, init: elb_mark_expr(v.init, idx, arr), line: v.line, col: v.col, is_str: v.is_str }; },
        StmtReturn(r) => { return StmtReturn { value: elb_mark_expr(r.value, idx, arr), line: r.line, col: r.col }; },
        StmtExpr(x) => { return StmtExpr { value: elb_mark_expr(x.value, idx, arr) }; },
        StmtAssign(a) => { return StmtAssign { target: a.target, value: elb_mark_expr(a.value, idx, arr), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }; },
        StmtIf(f) => { return StmtIf { cond: elb_mark_expr(f.cond, idx, arr), then_body: elb_mark_stmts(f.then_body, idx, arr), else_body: elb_mark_stmts(f.else_body, idx, arr) }; },
        StmtWhile(w) => { return StmtWhile { cond: elb_mark_expr(w.cond, idx, arr), body: elb_mark_stmts(w.body, idx, arr), label: w.label }; },
        StmtFor(fr) => { return StmtFor { var_name: fr.var_name, iter: elb_mark_expr(fr.iter, idx, arr), body: elb_mark_stmts(fr.body, idx, arr), label: fr.label }; },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var arm: MatchArm = m.arms[i];
                arms = arms.append(MatchArm { pattern: arm.pattern, body: elb_mark_stmts(arm.body, idx, arr), line: arm.line, col: arm.col, guard: elb_mark_expr(arm.guard, idx, arr), has_guard: arm.has_guard });
                i = i + 1;
            }
            return StmtMatch { scrutinee: elb_mark_expr(m.scrutinee, idx, arr), arms: arms, line: m.line, col: m.col, origin: m.origin };
        },
        _ => { return st; }
    }
    return st;
}
function elb_mark_expr(e: Expr, idx: string, arr: string): Expr {
    match (e) {
        ExprIndex(ix) => {
            var mark: boolean = ix.unchecked;
            match (ix.array) {
                ExprIdent(aid) => {
                    match (ix.index) {
                        ExprIdent(iid) => { if (aid.name == arr && iid.name == idx) { mark = true; } },
                        _ => { }
                    }
                },
                _ => { }
            }
            return ExprIndex { array: elb_mark_expr(ix.array, idx, arr), index: elb_mark_expr(ix.index, idx, arr), unchecked: mark };
        },
        ExprBinary(b) => { return ExprBinary { op: b.op, left: elb_mark_expr(b.left, idx, arr), right: elb_mark_expr(b.right, idx, arr), line: b.line, col: b.col }; },
        ExprUnary(u) => { return ExprUnary { op: u.op, operand: elb_mark_expr(u.operand, idx, arr), line: u.line, col: u.col }; },
        ExprCall(c) => {
            var na: Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { na = na.append(elb_mark_expr(c.args[i], idx, arr)); i = i + 1; }
            return ExprCall { callee: elb_mark_expr(c.callee, idx, arr), args: na, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        ExprArray(a) => {
            var ne: Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { ne = ne.append(elb_mark_expr(a.elements[i], idx, arr)); i = i + 1; }
            return ExprArray { elements: ne };
        },
        ExprTuple(t) => {
            var ne: Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { ne = ne.append(elb_mark_expr(t.elements[i], idx, arr)); i = i + 1; }
            return ExprTuple { elements: ne, line: t.line, col: t.col };
        },
        ExprSlice(sl) => { return ExprSlice { array: elb_mark_expr(sl.array, idx, arr), start: elb_mark_expr(sl.start, idx, arr), end: elb_mark_expr(sl.end, idx, arr) }; },
        ExprStructLit(sl) => {
            var nv: Expr[] = [];
            var i: i32 = 0;
            while (i < sl.field_values.len()) { nv = nv.append(elb_mark_expr(sl.field_values[i], idx, arr)); i = i + 1; }
            var nbase: Expr = sl.base;
            if (sl.has_base) { nbase = elb_mark_expr(sl.base, idx, arr); }
            return ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col };
        },
        ExprFieldAccess(fa) => { return ExprFieldAccess { obj: elb_mark_expr(fa.obj, idx, arr), field: fa.field, line: fa.line, col: fa.col }; },
        _ => { return e; }
    }
    return e;
}

// cf_inline_fn_body inlines every call-only 0-arg fn-value binding in a
// function body's TOP-LEVEL statements (one full pass, left to right).
// cf_all_zero_arg_fn_elems reports whether every element of an array literal is
// a bare identifier naming a 0-arg receiver-less module function — the shape
// `[mk, mk2]` that would otherwise const-CALL each element through the generic
// array lowering (storing `mk()` results), so a later `fns[i]()` calls an
// integer as a code pointer and segfaults. (A >0-arg fn name already lowers to a
// fn value, so only the 0-arg case needs this rescue.)
function cf_all_zero_arg_fn_elems(elems: Expr[], funcs: FuncDecl[]): boolean {
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        match (elems[i]) {
            ExprIdent(id) => { if (!cf_is_zero_arg_fn(funcs, id.name)) { return false; } },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// cf_arr_scan_expr counts a name's INDEXED-CALL uses (`f[i](...)` — calls) vs
// any OTHER use (vals: `f[i]` as a value, `f` passed / stored / a bare ref). A
// `var f = [fns…]` used only as indexed calls is a fn-pointer array; a value use
// means the elements are meant as const CALLS (an `i32[]` of `mk()` results).
function cf_arr_scan_expr(e: Expr, f: string): CFScan {
    match (e) {
        ExprIdent(id) => { if (id.name == f) { return CFScan { vals: 1, calls: 0 }; } return cf_zero(); },
        ExprBinary(b) => { return cf_add(cf_arr_scan_expr(b.left, f), cf_arr_scan_expr(b.right, f)); },
        ExprUnary(u) => { return cf_arr_scan_expr(u.operand, f); },
        ExprCall(c) => {
            var acc: CFScan = cf_zero();
            var indexed_f: boolean = false;
            match (c.callee) {
                ExprIndex(ix) => {
                    match (ix.array) {
                        ExprIdent(aid) => { if (aid.name == f) { indexed_f = true; acc = cf_add(CFScan { vals: 0, calls: 1 }, cf_arr_scan_expr(ix.index, f)); } },
                        _ => { }
                    }
                },
                _ => { }
            }
            if (!indexed_f) { acc = cf_arr_scan_expr(c.callee, f); }
            var i: i32 = 0;
            while (i < c.args.len()) { acc = cf_add(acc, cf_arr_scan_expr(c.args[i], f)); i = i + 1; }
            return acc;
        },
        ExprArray(a) => {
            var acc: CFScan = cf_zero();
            var i: i32 = 0;
            while (i < a.elements.len()) { acc = cf_add(acc, cf_arr_scan_expr(a.elements[i], f)); i = i + 1; }
            return acc;
        },
        ExprTuple(t) => {
            var acc: CFScan = cf_zero();
            var i: i32 = 0;
            while (i < t.elements.len()) { acc = cf_add(acc, cf_arr_scan_expr(t.elements[i], f)); i = i + 1; }
            return acc;
        },
        ExprIndex(ix) => { return cf_add(cf_arr_scan_expr(ix.array, f), cf_arr_scan_expr(ix.index, f)); },
        ExprSlice(sl) => { return cf_add(cf_arr_scan_expr(sl.array, f), cf_add(cf_arr_scan_expr(sl.start, f), cf_arr_scan_expr(sl.end, f))); },
        ExprStructLit(sl) => {
            var acc: CFScan = cf_arr_scan_expr(sl.base, f);
            var i: i32 = 0;
            while (i < sl.field_values.len()) { acc = cf_add(acc, cf_arr_scan_expr(sl.field_values[i], f)); i = i + 1; }
            return acc;
        },
        ExprFieldAccess(fa) => { return cf_arr_scan_expr(fa.obj, f); },
        ExprLambda(lm) => { return cf_arr_scan_stmts(lm.body, f); },
        _ => { return cf_zero(); }
    }
    return cf_zero();
}

function cf_arr_scan_stmt(st: Stmt, f: string): CFScan {
    match (st) {
        StmtVar(v) => { return cf_arr_scan_expr(v.init, f); },
        StmtReturn(r) => { return cf_arr_scan_expr(r.value, f); },
        StmtExpr(x) => { return cf_arr_scan_expr(x.value, f); },
        StmtAssign(a) => {
            var base: CFScan = cf_arr_scan_expr(a.value, f);
            if (a.target == f) { return cf_add(base, CFScan { vals: 1, calls: 0 }); }
            return base;
        },
        StmtIf(fst) => { return cf_add(cf_arr_scan_expr(fst.cond, f), cf_add(cf_arr_scan_stmts(fst.then_body, f), cf_arr_scan_stmts(fst.else_body, f))); },
        StmtWhile(w) => { return cf_add(cf_arr_scan_expr(w.cond, f), cf_arr_scan_stmts(w.body, f)); },
        StmtFor(fr) => { return cf_add(cf_arr_scan_expr(fr.iter, f), cf_arr_scan_stmts(fr.body, f)); },
        StmtMatch(m) => {
            var acc: CFScan = cf_arr_scan_expr(m.scrutinee, f);
            var i: i32 = 0;
            while (i < m.arms.len()) { acc = cf_add(acc, cf_add(cf_arr_scan_expr(m.arms[i].guard, f), cf_arr_scan_stmts(m.arms[i].body, f))); i = i + 1; }
            return acc;
        },
        StmtDefer(d) => { return cf_arr_scan_stmt(d.action, f); },
        _ => { return cf_zero(); }
    }
    return cf_zero();
}

function cf_arr_scan_stmts(stmts: Stmt[], f: string): CFScan {
    var acc: CFScan = cf_zero();
    var i: i32 = 0;
    while (i < stmts.len()) { acc = cf_add(acc, cf_arr_scan_stmt(stmts[i], f)); i = i + 1; }
    return acc;
}

function cf_inline_fn_body(body: Stmt[], funcs: FuncDecl[]): Stmt[] {
    var out: Stmt[] = body;
    var i: i32 = 0;
    while (i < out.len()) {
        var handled: boolean = false;
        match (out[i]) {
            StmtVar(v) => {
                match (v.init) {
                    ExprIdent(id) => {
                        if (cf_is_zero_arg_fn(funcs, id.name) && cf_decl_count(out, v.name) == 1) {
                            var sc: CFScan = cf_scan_stmts(out, v.name);
                            if (sc.vals == 0 && sc.calls >= 1) {
                                // Drop the binding; rewrite f(args) -> fnname(args).
                                var nb: Stmt[] = [];
                                var k: i32 = 0;
                                while (k < out.len()) { if (k != i) { nb = nb.append(out[k]); } k = k + 1; }
                                out = cf_rw_stmts(nb, v.name, id.name);
                                handled = true;
                            }
                        }
                    },
                    _ => { }
                }
            },
            _ => { }
        }
        if (!handled) { i = i + 1; }
    }
    // Annotate a `var fns = [<0-arg fn names>]` used ONLY as indexed calls
    // (`fns[i]()`) as a fn-pointer array (`fn[]`), so the fn[]-array lowering
    // emits const_func per element instead of const-CALLING each (which makes
    // `fns[i]()` call an integer as a code pointer → segfault). A value use of
    // `fns` leaves it as the generic const-called array (the elements are
    // `mk()` results), so const semantics are unchanged.
    var res: Stmt[] = [];
    var j: i32 = 0;
    while (j < out.len()) {
        var keep: Stmt = out[j];
        match (out[j]) {
            StmtVar(v) => {
                if (v.type_name.len() == 0) {
                    match (v.init) {
                        ExprArray(arr) => {
                            if (cf_all_zero_arg_fn_elems(arr.elements, funcs) && cf_decl_count(out, v.name) == 1) {
                                var asc: CFScan = cf_arr_scan_stmts(out, v.name);
                                if (asc.vals == 0 && asc.calls >= 1) {
                                    keep = StmtVar { name: v.name, type_name: "fn[]", init: v.init, line: v.line, col: v.col, is_str: v.is_str };
                                }
                            }
                        },
                        _ => { }
                    }
                }
            },
            _ => { }
        }
        res = res.append(keep);
        j = j + 1;
    }
    return res;
}

pub function inline_callonly_fn_values(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        funcs = funcs.append(FuncDecl {
            name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type,
            type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type,
            body: cf_inline_fn_body(fd.body, mod.funcs), line: fd.line, col: fd.col,
            import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str
        });
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: cf_inline_fn_body(mod.top_stmts, mod.funcs), enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// ===== #3640 slice B.2: use-directed struct-fn-value-local inference =====
//
// An unannotated `var f = mk` where `mk` is a zero-arg receiver-less function
// returning a STRUCT is ambiguous: it can mean "call mk, store the struct" (a
// const-call) or "bind mk as a function VALUE". The self-host defaults to the
// const-call, so a later `f()` calls the stored struct as a code pointer and
// crashes (#3640 case B). The native compiler disambiguates from USE: if `f` is
// later CALLED (`f(...)`), it is a fn-value. This pass recovers that — it
// rewrites such a `var f = mk` to carry the coarse `fn` type, exactly the
// annotation `var f: () => P = mk` already carries, so the fn-value binding +
// the slice-B.1 struct-return registration in lower_func handle it on the IR
// path. Restricted to STRUCT-returning targets (issue case B): this keeps the
// rewrite away from the genuinely ambiguous fn-returning-fn shape, and i32 /
// string const-fn locals stay out of scope. Runs on the shared IR funnel
// (irlower.lift_lambdas), so the route decision and the emitted code stay
// consistent across backends.

// fnv_name_called_in_expr reports whether `name` appears as the CALLEE of a call
// (`name(...)`) anywhere in `e`. A bare read or a field/member access does NOT
// count — those are the const-call interpretation.
function fnv_name_called_in_expr(e: Expr, name: string): boolean {
    match (e) {
        ExprCall(c) => {
            match (c.callee) {
                ExprIdent(cid) => { if (cid.name == name) { return true; } },
                _ => { if (fnv_name_called_in_expr(c.callee, name)) { return true; } }
            }
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (fnv_name_called_in_expr(c.args[i], name)) { return true; }
                i = i + 1;
            }
            return false;
        },
        ExprBinary(b) => { return fnv_name_called_in_expr(b.left, name) || fnv_name_called_in_expr(b.right, name); },
        ExprUnary(u) => { return fnv_name_called_in_expr(u.operand, name); },
        ExprIndex(x) => { return fnv_name_called_in_expr(x.array, name) || fnv_name_called_in_expr(x.index, name); },
        ExprSlice(sl) => { return fnv_name_called_in_expr(sl.array, name) || fnv_name_called_in_expr(sl.start, name) || fnv_name_called_in_expr(sl.end, name); },
        ExprFieldAccess(fa) => { return fnv_name_called_in_expr(fa.obj, name); },
        ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (fnv_name_called_in_expr(a.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { if (fnv_name_called_in_expr(t.elements[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ExprStructLit(sl) => {
            if (sl.has_base) { if (fnv_name_called_in_expr(sl.base, name)) { return true; } }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { if (fnv_name_called_in_expr(sl.field_values[i], name)) { return true; } i = i + 1; }
            return false;
        },
        ExprLambda(lm) => { return fnv_name_called_in_block(lm.body, name); },
        _ => { return false; }
    }
    return false;
}

function fnv_name_called_in_block(stmts: Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        if (fnv_name_called_in_stmt(stmts[i], name)) { return true; }
        i = i + 1;
    }
    return false;
}

function fnv_name_called_in_stmt(st: Stmt, name: string): boolean {
    match (st) {
        StmtVar(v) => { return fnv_name_called_in_expr(v.init, name); },
        StmtReturn(r) => { return fnv_name_called_in_expr(r.value, name); },
        StmtExpr(e) => { return fnv_name_called_in_expr(e.value, name); },
        StmtAssign(a) => { return fnv_name_called_in_expr(a.value, name); },
        StmtIf(f) => { return fnv_name_called_in_expr(f.cond, name) || fnv_name_called_in_block(f.then_body, name) || fnv_name_called_in_block(f.else_body, name); },
        StmtWhile(w) => { return fnv_name_called_in_expr(w.cond, name) || fnv_name_called_in_block(w.body, name); },
        StmtFor(fr) => { return fnv_name_called_in_expr(fr.iter, name) || fnv_name_called_in_block(fr.body, name); },
        StmtMatch(m) => {
            if (fnv_name_called_in_expr(m.scrutinee, name)) { return true; }
            var ai: i32 = 0;
            while (ai < m.arms.len()) { if (fnv_name_called_in_block(m.arms[ai].body, name)) { return true; } ai = ai + 1; }
            return false;
        },
        StmtDefer(d) => { return fnv_name_called_in_stmt(d.action, name); },
        _ => { return false; }
    }
    return false;
}

// fnv_is_struct_ret_zero_arg reports whether `name` is a zero-arg, receiver-less
// function whose return type is a DECLARED struct — the precise shape whose
// `var f = name` binding the slice-B.1 lower_func registration can carry.
function fnv_is_struct_ret_zero_arg(funcs: FuncDecl[], structs: StructDecl[], name: string): boolean {
    var fi: i32 = 0;
    while (fi < funcs.len()) {
        if (funcs[fi].name == name && funcs[fi].receiver_type.len() == 0 && funcs[fi].params.len() == 0) {
            var rt: string = funcs[fi].ret_type;
            var si: i32 = 0;
            while (si < structs.len()) {
                if (structs[si].name == rt) { return true; }
                si = si + 1;
            }
            return false;
        }
        fi = fi + 1;
    }
    return false;
}

function fnv_rewrite_block(stmts: Stmt[], whole: Stmt[], funcs: FuncDecl[], structs: StructDecl[]): Stmt[] {
    var out: Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        out = out.append(fnv_rewrite_stmt(stmts[i], whole, funcs, structs));
        i = i + 1;
    }
    return out;
}

function fnv_rewrite_stmt(st: Stmt, whole: Stmt[], funcs: FuncDecl[], structs: StructDecl[]): Stmt {
    match (st) {
        StmtVar(v) => {
            if (v.type_name.len() == 0) {
                match (v.init) {
                    ExprIdent(rid) => {
                        if (fnv_is_struct_ret_zero_arg(funcs, structs, rid.name) && fnv_name_called_in_block(whole, v.name)) {
                            return StmtVar { name: v.name, type_name: "fn", init: v.init, line: v.line, col: v.col, is_str: v.is_str };
                        }
                    },
                    _ => {}
                }
            }
            return st;
        },
        StmtIf(f) => { return StmtIf { cond: f.cond, then_body: fnv_rewrite_block(f.then_body, whole, funcs, structs), else_body: fnv_rewrite_block(f.else_body, whole, funcs, structs) }; },
        StmtWhile(w) => { return StmtWhile { cond: w.cond, body: fnv_rewrite_block(w.body, whole, funcs, structs), label: w.label }; },
        StmtFor(fr) => { return StmtFor { var_name: fr.var_name, iter: fr.iter, body: fnv_rewrite_block(fr.body, whole, funcs, structs), label: fr.label }; },
        StmtMatch(m) => {
            var arms: MatchArm[] = [];
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                arms = arms.append(MatchArm { pattern: m.arms[ai].pattern, body: fnv_rewrite_block(m.arms[ai].body, whole, funcs, structs), line: m.arms[ai].line, col: m.arms[ai].col, guard: m.arms[ai].guard, has_guard: m.arms[ai].has_guard });
                ai = ai + 1;
            }
            return StmtMatch { scrutinee: m.scrutinee, arms: arms, line: m.line, col: m.col, origin: m.origin };
        },
        _ => { return st; }
    }
    return st;
}

pub function infer_fnvalue_locals_module(mod: Module): Module {
    var funcs: FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: FuncDecl = mod.funcs[i];
        var nbody: Stmt[] = fnv_rewrite_block(fd.body, fd.body, mod.funcs, mod.structs);
        funcs = funcs.append(FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: nbody, line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str });
        i = i + 1;
    }
    return Module { funcs: funcs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

pub function module_with_builtins(mod: Module): Module {
    // Automatic drop for owned WIT resource handles (P5 slice 3): insert a
    // `defer <drop>(h);` for each kept `own R` local and synthesize the
    // `[resource-drop]` import functions — BEFORE lower_defers_module so the
    // inserted defers expand to drops on every exit path
    // (docs/WIT-BRING-YOUR-OWN.md).
    // #4394 lever 3: the three leading desugar passes (resolve_labels →
    // fill_default_args → desugar_ranges) are fused into desugar_prepass_module,
    // one module rebuild instead of three (byte-identical — see its doc comment).
    var mono: Module = inline_callonly_fn_values(monomorphize_enums(monomorphize_structs(monomorphize_module(register_map_method_generics(register_array_method_generics(lower_defers_module(insert_resource_drops(infer_ret_types_module(hoist_local_funcs_module(desugar_prepass_module(mod)))))))))));
    return Module {
        funcs: mono.funcs,
        structs: inject_builtin_enums(mono.structs),
        aliases: mono.aliases,
        imports: mono.imports,
        top_stmts: mono.top_stmts,
        enums: mono.enums,
        resources: mono.resources,
        exports: mono.exports,
        impls: mono.impls,
        trait_reqs: mono.trait_reqs
    };
}

// parse_impl_block yields the parser plus the desugared receiver-method
// FuncDecls produced from an `impl Trait for Type { … }` block, along
// with the metadata parse_module needs to synthesise inherited trait
// default methods after every trait declaration has been seen:
// trait_name (simple, qualifier stripped), impl_type, the impl's bounded
// type params, and the method names the impl explicitly provided.

// TraitDefault is one trait method that carries a `{ … }` default body
// (abstract signatures are dropped). `trait_name` is the simple trait
// name; `method` is the parsed method (params[0] = self for a receiver
// method, `Self` still spelled in its types). An impl of the trait that
// omits the method inherits a copy via finalize_impl_method.
pub struct TraitDefault { trait_name: string, method: FuncDecl }

// ImplInfo is the per-impl metadata parse_module retains so it can
// synthesise inherited defaults after the full module is parsed (a trait
// may be declared after the impl that depends on it).
pub struct ImplInfo { trait_name: string, impl_type: string, type_params: string[], method_names: string[] }

// str_list_contains reports whether `xs` holds `want`.
function str_list_contains(xs: string[], want: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == want) { return true; }
        i = i + 1;
    }
    return false;
}

// ============ @derive synthesis (structs) ============
// Mirrors the Go checker's synthEq / synthDisplay / synthOrd so a
// self-host-compiled program gets the same field-wise methods. Structs
// only for now — enums desugar to struct-unions here, so enum @derive
// is a follow-up. See docs/TRAITS.md.

// derive_simple_name returns a (possibly qualified) trait name's simple
// name (after the last `.`): `cmp.Display` → "Display".
pub function derive_simple_name(name: string): string {
    var last_dot: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == 46) { last_dot = i; }
        i = i + 1;
    }
    if (last_dot >= 0) { return name[last_dot + 1 : name.len()] + ""; }
    return name;
}

// self_field / other_field build `self.f` / `other.f`.
function dv_self_field(f: string): Expr { return e_field_access(e_ident("self"), f); }
function dv_other_field(f: string): Expr { return e_field_access(e_ident("other"), f); }
// dv_call0 / dv_call1 build `recv.m()` / `recv.m(arg)`.
function dv_call0(recv: Expr, m: string): Expr {
    var noargs: Expr[] = [];
    return e_call(e_field_access(recv, m), noargs);
}
function dv_call1(recv: Expr, m: string, arg: Expr): Expr {
    var args: Expr[] = [arg];
    return e_call(e_field_access(recv, m), args);
}

// synth_struct_display: `to_string` rendering `Name { f: …, … }` — the
// exact format the Go synthDisplay emits (so the differential oracle
// agrees).
function synth_struct_display(sd: StructDecl): FuncDecl {
    var expr: Expr = e_string(sd.name + " {");
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        var sep: string = " ";
        if (i > 0) { sep = ", "; }
        expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
        expr = e_binary("+", expr, dv_call0(dv_self_field(sd.fields[i].name), "to_string"));
        i = i + 1;
    }
    if (sd.fields.len() == 0) {
        expr = e_binary("+", expr, e_string("}"));
    } else {
        expr = e_binary("+", expr, e_string(" }"));
    }
    var body: Stmt[] = [s_return(expr)];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "to_string", receiver_name: "self", receiver_type: sd.name, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// dv_debug_render builds the Debug rendering of a single value of static
// type `t`. Unlike the native checker — which routes every field through a
// `Debug` trait method — the self-host has no trait-impl methods on
// primitives (it discards `impl` bodies; `__fn_i32__to_debug` would be
// undefined), so it renders type-directed, matching the native output:
//   * `string`  → quoted: `"\"" + v + "\""` (so a dump is unambiguous).
//   * numeric / boolean scalar → `v.to_string()` (a built-in, as derived
//     Display uses).
//   * anything else (a nominal struct/enum) → `v.to_debug()`, composing
//     through its own derived Debug.
// (Strings with embedded quotes/backslashes aren't escaped here — the
// native `impl Debug for string` does, a small self-host fidelity gap.)
function dv_is_debug_scalar(t: string): boolean {
    return t == "i32" || t == "i64" || t == "u32" || t == "u64"
        || t == "f32" || t == "f64" || t == "boolean";
}
function dv_debug_render(value: Expr, t: string): Expr {
    if (t == "string") {
        return e_binary("+", e_binary("+", e_string("\""), value), e_string("\""));
    }
    if (dv_is_debug_scalar(t)) {
        return dv_call0(value, "to_string");
    }
    return dv_call0(value, "to_debug");
}

// synth_struct_debug: `to_debug` rendering the structural `Name { f: …, …
// }` form — the Debug sibling of synth_struct_display. The one difference
// from the derived Display is that a string field renders QUOTED
// (`name: "hi"`), via dv_debug_render. Mirrors the Go synthDebug output.
function synth_struct_debug(sd: StructDecl): FuncDecl {
    var expr: Expr = e_string(sd.name + " {");
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        var sep: string = " ";
        if (i > 0) { sep = ", "; }
        expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
        expr = e_binary("+", expr, dv_debug_render(dv_self_field(sd.fields[i].name), sd.fields[i].type_name));
        i = i + 1;
    }
    if (sd.fields.len() == 0) {
        expr = e_binary("+", expr, e_string("}"));
    } else {
        expr = e_binary("+", expr, e_string(" }"));
    }
    var body: Stmt[] = [s_return(expr)];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "to_debug", receiver_name: "self", receiver_type: sd.name, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_struct_eq: field-wise `<f-eq> && …` (true for an empty struct),
// where a scalar field compares with the primitive `==` and a nominal field
// delegates to its own derived `.eq()` — see dv_eq_expr.
function synth_struct_eq(sd: StructDecl): FuncDecl {
    var expr: Expr = e_bool(true);
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        var cm: Expr = dv_eq_expr(sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
        if (i == 0) { expr = cm; } else { expr = e_binary("&&", expr, cm); }
        i = i + 1;
    }
    var body: Stmt[] = [s_return(expr)];
    var notp: string[] = [];
    var params: ParamDecl[] = [ParamDecl { name: "other", type_name: sd.name, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
    return FuncDecl { name: "eq", receiver_name: "self", receiver_type: sd.name, type_params: notp, params: params, ret_type: "boolean", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_struct_ord: lexicographic `cmp` — first non-zero field cmp wins.
function synth_struct_ord(sd: StructDecl): FuncDecl {
    var stmts: Stmt[] = [];
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        var vn: string = "__c" + dl_itoa(i);
        var cs: Stmt[] = dv_cmp_stmts(vn, sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
        var k: i32 = 0;
        while (k < cs.len()) { stmts = stmts.append(cs[k]); k = k + 1; }
        var cond: Expr = e_binary("!=", e_ident(vn), e_number("0", "", false));
        var thenb: Stmt[] = [s_return(e_ident(vn))];
        var elseb: Stmt[] = [];
        stmts = stmts.append(s_if(cond, thenb, elseb));
        i = i + 1;
    }
    stmts = stmts.append(s_return(e_number("0", "", false)));
    var notp: string[] = [];
    var params: ParamDecl[] = [ParamDecl { name: "other", type_name: sd.name, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
    return FuncDecl { name: "cmp", receiver_name: "self", receiver_type: sd.name, type_params: notp, params: params, ret_type: "i32", body: stmts, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_struct_hash: field-wise `h = h * 31 + self.f.hash()` fold from a
// seed of 17, mirroring the Go synthHash so the differential oracle
// agrees. Pairs with the derived `eq` under `a == b ⇒ a.hash() ==
// b.hash()`.
function synth_struct_hash(sd: StructDecl): FuncDecl {
    var stmts: Stmt[] = [s_var("__h", "i32", e_number("17", "", false))];
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        var fs: Stmt[] = dv_hash_stmts("__h", sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dl_itoa(i));
        var k: i32 = 0;
        while (k < fs.len()) { stmts = stmts.append(fs[k]); k = k + 1; }
        i = i + 1;
    }
    stmts = stmts.append(s_return(e_ident("__h")));
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "hash", receiver_name: "self", receiver_type: sd.name, type_params: notp, params: noparams, ret_type: "i32", body: stmts, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_struct_json: field-wise `to_json` rendering a struct as a JSON
// object `{"f":<f.to_json()>,...}`, mirroring the Go synthJson so the
// differential oracle agrees. Field names need no escaping (identifiers).
function synth_struct_json(sd: StructDecl): FuncDecl {
    var expr: Expr = e_string("{");
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        var sep: string = "";
        if (i > 0) { sep = ","; }
        expr = e_binary("+", expr, e_string(sep + "\"" + sd.fields[i].name + "\":"));
        expr = e_binary("+", expr, dv_call0(dv_self_field(sd.fields[i].name), "to_json"));
        i = i + 1;
    }
    expr = e_binary("+", expr, e_string("}"));
    var body: Stmt[] = [s_return(expr)];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "to_json", receiver_name: "self", receiver_type: sd.name, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// fromjson_accessor returns the `json.json_get_*` accessor for a field
// type, or "" when the type has none — the gate `from_json_derivable`
// uses to decide whether the deserialise companion can be synthesised.
// Mirrors the native synthFromJson switch: 64-bit ints go through the
// i64 accessor, narrower ints through i32, plus bool / string. Any other
// field type (nested struct, array, Option, f64) has no flat accessor —
// serialise still works, deserialise is a documented follow-up (#2695).
function fromjson_accessor(tn: string): string {
    if (tn == "i64" || tn == "u64") { return "json_get_i64"; }
    if (tn == "i32" || tn == "u32") { return "json_get_i32"; }
    if (tn == "boolean") { return "json_get_bool"; }
    if (tn == "string") { return "json_get_string"; }
    return "";
}

// from_json_derivable reports whether every field of `sd` has a flat
// `json.json_get_*` accessor — the precondition for synth_from_json. A
// struct with a single unsupported field gets `to_json` only.
function from_json_derivable(sd: StructDecl): boolean {
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        if (fromjson_accessor(sd.fields[i].type_name).len() == 0) { return false; }
        i = i + 1;
    }
    return true;
}

// synth_from_json builds the deserialise companion to synth_struct_json:
// a receiver-less associated `from_json(s: string): Result[Self, string]`
// that parses the JSON text and extracts each field by name, returning
// `Err(...)` on invalid JSON or a missing field. The body nests one
// `match` per field over its `json.json_get_*` accessor `Option`, so a
// missing field short-circuits to `Err("missing field: <name>")` without
// a `?` operator; the innermost arm returns `Ok(Self { … })`. The
// `json.*` calls resolve through the `@derive(json.Json)` site's own
// `import "std/json"` (basename alias `json`) — modload rewrites them to
// the flat `json__*`. Mirrors the native synthFromJson (#2695). Only
// called when from_json_derivable(sd) holds, so every field's accessor
// is non-empty.
function synth_from_json(sd: StructDecl): FuncDecl {
    // Innermost: return Ok(Self { f: __fj_f, … }).
    var fnames: string[] = [];
    var fvals: Expr[] = [];
    var k: i32 = 0;
    while (k < sd.fields.len()) {
        fnames = fnames.append(sd.fields[k].name);
        fvals = fvals.append(e_ident("__fj_" + sd.fields[k].name));
        k = k + 1;
    }
    var lit: Expr = e_struct_lit(sd.name, fnames, fvals, 0, 0);
    var body: Stmt[] = [s_return(e_call(e_ident("Ok"), [lit]))];
    // Wrap each field's accessor match, inner-to-outer.
    var fi: i32 = sd.fields.len() - 1;
    while (fi >= 0) {
        var fname: string = sd.fields[fi].name;
        var acc: string = fromjson_accessor(sd.fields[fi].type_name);
        var accessor_call: Expr = e_call(e_field_access(e_ident("json"), acc), [e_ident("__fj_jv"), e_string(fname)]);
        var missing: Stmt[] = [s_return(e_call(e_ident("Err"), [e_string("missing field: " + fname)]))];
        var arms: MatchArm[] = [];
        arms = arms.append(MatchArm { pattern: p_variant("Some", "__fj_" + fname), body: body, line: 0, col: 0, guard: e_bool(true), has_guard: false });
        arms = arms.append(MatchArm { pattern: p_variant("None", ""), body: missing, line: 0, col: 0, guard: e_bool(true), has_guard: false });
        body = [s_match(accessor_call, arms)];
        fi = fi - 1;
    }
    // Outermost: parse the string, then run the field chain.
    var parse_fail: Stmt[] = [s_return(e_call(e_ident("Err"), [e_string("invalid JSON")]))];
    var oarms: MatchArm[] = [];
    oarms = oarms.append(MatchArm { pattern: p_variant("Some", "__fj_jv"), body: body, line: 0, col: 0, guard: e_bool(true), has_guard: false });
    oarms = oarms.append(MatchArm { pattern: p_variant("None", ""), body: parse_fail, line: 0, col: 0, guard: e_bool(true), has_guard: false });
    var obody: Stmt[] = [s_match(e_call(e_field_access(e_ident("json"), "json_parse"), [e_ident("s")]), oarms)];
    var params: ParamDecl[] = [ParamDecl { name: "s", type_name: "string", own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
    var notp: string[] = [];
    return FuncDecl { name: "from_json", receiver_name: "", receiver_type: sd.name, type_params: notp, params: params, ret_type: "Result[" + sd.name + ", string]", body: obody, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_display: variant-wise `to_string` rendering `Variant(p)` /
// `Variant` — the same shape the Go synthEnumDisplay emits. Self-host
// enum variants carry at most one payload (`__ev`), so a payload
// variant renders its single field.
function synth_enum_display(ename: string, variants: StructDecl[]): FuncDecl {
    var arms: MatchArm[] = [];
    var i: i32 = 0;
    while (i < variants.len()) {
        var v: StructDecl = variants[i];
        if (v.fields.len() > 0) {
            var e: Expr = e_string(v.name + "(");
            e = e_binary("+", e, dv_call0(e_ident("__p0"), "to_string"));
            e = e_binary("+", e, e_string(")"));
            arms = arms.append(MatchArm { pattern: p_variant(v.name, "__p0"), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        } else {
            arms = arms.append(MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string(v.name))], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        }
        i = i + 1;
    }
    var body: Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "to_string", receiver_name: "self", receiver_type: ename, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_debug: `to_debug` rendering `Variant` / `Variant(<debug
// payload>)` — the Debug sibling of synth_enum_display. The payload is
// rendered type-directed (a string payload is quoted) via dv_debug_render.
// Like synth_enum_display this covers payload-less and single-payload
// variants. Mirrors the Go synthEnumDebug output.
function synth_enum_debug(ename: string, variants: StructDecl[]): FuncDecl {
    var arms: MatchArm[] = [];
    var i: i32 = 0;
    while (i < variants.len()) {
        var v: StructDecl = variants[i];
        if (v.fields.len() > 0) {
            var e: Expr = e_string(v.name + "(");
            e = e_binary("+", e, dv_debug_render(e_ident("__p0"), v.fields[0].type_name));
            e = e_binary("+", e, e_string(")"));
            arms = arms.append(MatchArm { pattern: p_variant(v.name, "__p0"), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        } else {
            arms = arms.append(MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string(v.name))], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        }
        i = i + 1;
    }
    var body: Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "to_debug", receiver_name: "self", receiver_type: ename, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_eq: match self, then match other — same variant compares
// the payload (`__s0.eq(__o0)`), any other variant is unequal. Mirrors
// the Go synthEnumEq.
function synth_enum_eq(ename: string, variants: StructDecl[]): FuncDecl {
    var arms: MatchArm[] = [];
    var i: i32 = 0;
    while (i < variants.len()) {
        var v: StructDecl = variants[i];
        var inner: MatchArm[] = [];
        if (v.fields.len() > 0) {
            var eqx: Expr = dv_eq_expr(v.fields[0].type_name, e_ident("__s0"), e_ident("__o0"));
            inner = inner.append(MatchArm { pattern: p_variant(v.name, "__o0"), body: [s_return(eqx)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
            inner = inner.append(MatchArm { pattern: p_wildcard(), body: [s_return(e_bool(false))], line: 0, col: 0, guard: e_bool(true), has_guard: false });
            arms = arms.append(MatchArm { pattern: p_variant(v.name, "__s0"), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        } else {
            inner = inner.append(MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_bool(true))], line: 0, col: 0, guard: e_bool(true), has_guard: false });
            inner = inner.append(MatchArm { pattern: p_wildcard(), body: [s_return(e_bool(false))], line: 0, col: 0, guard: e_bool(true), has_guard: false });
            arms = arms.append(MatchArm { pattern: p_variant(v.name, ""), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        }
        i = i + 1;
    }
    var body: Stmt[] = [s_match(e_ident("self"), arms), s_return(e_bool(false))];
    var notp: string[] = [];
    var params: ParamDecl[] = [ParamDecl { name: "other", type_name: ename, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
    return FuncDecl { name: "eq", receiver_name: "self", receiver_type: ename, type_params: notp, params: params, ret_type: "boolean", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_ord: variant-wise `cmp` — a variant declared earlier sorts
// before one declared later (by index); within the same variant the
// single payload is compared. Mirrors the Go synthEnumOrd.
function synth_enum_ord(ename: string, variants: StructDecl[]): FuncDecl {
    var arms: MatchArm[] = [];
    var i: i32 = 0;
    while (i < variants.len()) {
        var vi: StructDecl = variants[i];
        var inner: MatchArm[] = [];
        var j: i32 = 0;
        while (j < variants.len()) {
            var vj: StructDecl = variants[j];
            var ob: string = "";
            if (vj.fields.len() > 0) { ob = "__o0"; }
            var ibody: Stmt[] = [];
            if (j < i) {
                ibody = [s_return(e_number("1", "", false))];
            } else {
                if (j > i) {
                    ibody = [s_return(e_binary("-", e_number("0", "", false), e_number("1", "", false)))];
                } else {
                    if (vi.fields.len() > 0) {
                        var cstmts: Stmt[] = dv_cmp_stmts("__c0", vi.fields[0].type_name, e_ident("__s0"), e_ident("__o0"));
                        var emptyb: Stmt[] = [];
                        cstmts = cstmts.append(s_if(e_binary("!=", e_ident("__c0"), e_number("0", "", false)), [s_return(e_ident("__c0"))], emptyb));
                        cstmts = cstmts.append(s_return(e_number("0", "", false)));
                        ibody = cstmts;
                    } else {
                        ibody = [s_return(e_number("0", "", false))];
                    }
                }
            }
            inner = inner.append(MatchArm { pattern: p_variant(vj.name, ob), body: ibody, line: 0, col: 0, guard: e_bool(true), has_guard: false });
            j = j + 1;
        }
        var sb: string = "";
        if (vi.fields.len() > 0) { sb = "__s0"; }
        arms = arms.append(MatchArm { pattern: p_variant(vi.name, sb), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        i = i + 1;
    }
    var body: Stmt[] = [s_match(e_ident("self"), arms), s_return(e_number("0", "", false))];
    var notp: string[] = [];
    var params: ParamDecl[] = [ParamDecl { name: "other", type_name: ename, own: false, has_default: false, default_value: e_unknown(""), ret_arr: false, fn_ret: "", fn_param_dyn: "" }];
    return FuncDecl { name: "cmp", receiver_name: "self", receiver_type: ename, type_params: notp, params: params, ret_type: "i32", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_hash: variant-wise `hash` — seed the accumulator with the
// variant's tag (17 + declaration index) so distinct variants hash
// apart, then fold the single payload (`__p0`) through `h = h * 31 +
// __p0.hash()`. Mirrors the Go synthEnumHash (self-host enum variants
// carry at most one payload).
function synth_enum_hash(ename: string, variants: StructDecl[]): FuncDecl {
    var arms: MatchArm[] = [];
    var i: i32 = 0;
    while (i < variants.len()) {
        var v: StructDecl = variants[i];
        var stmts: Stmt[] = [s_var("__h", "i32", e_number(dl_itoa(17 + i), "", false))];
        var pat: string = "";
        if (v.fields.len() > 0) {
            pat = "__p0";
            var fs: Stmt[] = dv_hash_stmts("__h", v.fields[0].type_name, e_ident("__p0"), dl_itoa(i));
            var k: i32 = 0;
            while (k < fs.len()) { stmts = stmts.append(fs[k]); k = k + 1; }
        }
        stmts = stmts.append(s_return(e_ident("__h")));
        arms = arms.append(MatchArm { pattern: p_variant(v.name, pat), body: stmts, line: 0, col: 0, guard: e_bool(true), has_guard: false });
        i = i + 1;
    }
    var body: Stmt[] = [s_match(e_ident("self"), arms), s_return(e_number("0", "", false))];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "hash", receiver_name: "self", receiver_type: ename, type_params: notp, params: noparams, ret_type: "i32", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_json: variant-wise `to_json` — a unit variant renders as
// its name as a JSON string (`"Empty"`); a payload variant as a single-
// key object (`{"Circle":<__p0.to_json()>}`). Externally-tagged, matching
// the Go synthEnumJson (self-host enum variants carry at most one payload).
function synth_enum_json(ename: string, variants: StructDecl[]): FuncDecl {
    var arms: MatchArm[] = [];
    var i: i32 = 0;
    while (i < variants.len()) {
        var v: StructDecl = variants[i];
        if (v.fields.len() > 0) {
            var e: Expr = e_string("{\"" + v.name + "\":");
            e = e_binary("+", e, dv_call0(e_ident("__p0"), "to_json"));
            e = e_binary("+", e, e_string("}"));
            arms = arms.append(MatchArm { pattern: p_variant(v.name, "__p0"), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        } else {
            arms = arms.append(MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string("\"" + v.name + "\""))], line: 0, col: 0, guard: e_bool(true), has_guard: false });
        }
        i = i + 1;
    }
    var body: Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "to_json", receiver_name: "self", receiver_type: ename, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// enum_default_derivable reports whether an enum has a derivable default: it
// has at least one variant, and every payload of its FIRST variant is itself
// default-derivable. Mirrors the Go synthEnumDefault's gate.
function enum_default_derivable(variants: StructDecl[]): boolean {
    if (variants.len() == 0) { return false; }
    var v0: StructDecl = variants[0];
    var i: i32 = 0;
    while (i < v0.fields.len()) {
        if (!dv_default_derivable(v0.fields[i].type_name)) { return false; }
        i = i + 1;
    }
    return true;
}

// synth_enum_default: the associated function `function default(): Self {
// return <FirstVariant>(<dv>, …); }` — an enum defaults to its first variant,
// each payload defaulted. Receiver-less (empty receiver_name), so it lowers
// via the associated-function IR path; a unit first variant builds a bare
// variant value, a payload one a variant construction. Mirrors the Go
// synthEnumDefault.
function synth_enum_default(ename: string, variants: StructDecl[]): FuncDecl {
    var v0: StructDecl = variants[0];
    var value: Expr = e_ident(v0.name);
    if (v0.fields.len() > 0) {
        var args: Expr[] = [];
        var i: i32 = 0;
        while (i < v0.fields.len()) {
            args = args.append(dv_default_expr(v0.fields[i].type_name));
            i = i + 1;
        }
        value = e_call(e_ident(v0.name), args);
    }
    var body: Stmt[] = [s_return(value)];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    return FuncDecl { name: "default", receiver_name: "", receiver_type: ename, type_params: notp, params: noparams, ret_type: ename, body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_enum_derives appends the derivable enum methods. Display, Eq,
// Ord, Hash, Json, and Default are supported (Ord uses variant-declaration
// order then a lexicographic payload compare; Hash seeds with the variant
// tag; Json is externally tagged; Default is the first variant defaulted —
// the only associated/receiver-less one).
function synth_enum_derives(ename: string, variants: StructDecl[], derives: string[], funcs: FuncDecl[]): FuncDecl[] {
    var di: i32 = 0;
    while (di < derives.len()) {
        var kind: string = derive_simple_name(derives[di]);
        if (kind == "Display") { funcs = funcs.append(synth_enum_display(ename, variants)); }
        if (kind == "Debug") { funcs = funcs.append(synth_enum_debug(ename, variants)); }
        if (kind == "Eq") { funcs = funcs.append(synth_enum_eq(ename, variants)); }
        if (kind == "Ord") { funcs = funcs.append(synth_enum_ord(ename, variants)); }
        if (kind == "Hash") { funcs = funcs.append(synth_enum_hash(ename, variants)); }
        if (kind == "Json") { funcs = funcs.append(synth_enum_json(ename, variants)); }
        if (kind == "Default") { if (enum_default_derivable(variants)) { funcs = funcs.append(synth_enum_default(ename, variants)); } }
        di = di + 1;
    }
    return funcs;
}

// ---- @derive(Default) -------------------------------------------------
// `Default.default()` is an ASSOCIATED function (no `self`): `Type.default()`
// builds a type's zero value. For a concrete struct the field types are
// concrete, so each field's default is either a scalar zero literal or a
// nominal field's own `Type.default()` (a plain associated call — item 1's
// IR path resolves it). Mirrors the Go synthDefault / defaultDeriveExpr.

// dv_is_scalar reports whether a type is a primitive scalar whose default
// is a zero literal: i32/i64/u32/u64 → 0, f32/f64 → 0.0, boolean → false,
// string → "".
function dv_is_scalar(t: string): boolean {
    return t == "i32" || t == "i64" || t == "u32" || t == "u64"
        || t == "f32" || t == "f64" || t == "boolean" || t == "string";
}

// dv_default_derivable reports whether a field type has a derivable
// default: a scalar, or a bare NOMINAL name (a struct/enum whose own
// `default()` supplies the value). An array / map / generic / tuple /
// function shape — anything carrying `[`, `]`, `(`, `)`, `,` or a space —
// has no derived default (mirroring the Go defaultDeriveExpr's ok=false).
function dv_default_derivable(t: string): boolean {
    if (dv_is_scalar(t)) { return true; }
    if (t.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < t.len()) {
        var c: i32 = t[i];
        // [ ] ( ) , space → a non-nominal shape.
        if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 32) { return false; }
        i = i + 1;
    }
    return true;
}

// dv_default_expr builds the default value for a field of type `t`: a
// scalar zero literal, or `T.default()` (an associated call, no receiver)
// for a nominal type that delegates to its own derived default.
function dv_default_expr(t: string): Expr {
    if (t == "string") { return e_string(""); }
    if (t == "boolean") { return e_bool(false); }
    if (t == "f32" || t == "f64") { return e_number("0.0", "", true); }
    if (dv_is_scalar(t)) { return e_number("0", "", false); }
    var noargs: Expr[] = [];
    return e_call(e_field_access(e_ident(t), "default"), noargs);
}

// dv_eq_expr builds the equality test for one derived-`eq` field/payload.
// A SCALAR (`dv_is_scalar`) compares with the primitive `==`, so the derive
// needs no `Eq` impl for that type — which matters on the self-host, whose
// loader skips `core`/`std` imports, leaving `core/cmp`'s primitive `i32.eq`
// (etc.) unavailable; a `.eq()` call there would bail the module to the AST
// emitter. A nominal field delegates to its own (local, derived) `.eq()`.
// `==` matches `core/cmp`'s scalar `eq` exactly (`self == other`), so the
// native/self-host differential oracle still agrees.
function dv_eq_expr(ty: string, lhs: Expr, rhs: Expr): Expr {
    if (dv_is_scalar(ty)) { return e_binary("==", lhs, rhs); }
    return dv_call1(lhs, "eq", rhs);
}

// dv_cmp_stmts builds the statements that compute the three-way comparison of
// one derived-`cmp` field/payload into the i32 local `vn`. A NUMERIC scalar
// inlines core/cmp's Ord body (`vn = -1 / 1 / 0` via `<` / `>`), so the derive
// needs no `Ord` impl for that type — which the self-host loader (local +
// builtin only, no core/std) doesn't provide; a `.cmp()` there would bail the
// module to the AST emitter. A nominal field delegates to its own (local,
// derived) `.cmp()`; a string field also keeps `.cmp()` (its Ord routes
// through sort.string_cmp, not a primitive `<`), so a string-keyed derive(Ord)
// remains the one shape that still falls back. The inline `<`/`>` form matches
// core/cmp's numeric `cmp` exactly, so the differential oracle still agrees.
function dv_cmp_stmts(vn: string, ty: string, lhs: Expr, rhs: Expr): Stmt[] {
    if (dv_is_num_scalar(ty)) {
        var neg1: Expr = e_binary("-", e_number("0", "", false), e_number("1", "", false));
        var out: Stmt[] = [s_var(vn, "i32", e_number("0", "", false))];
        out = out.append(s_if(e_binary("<", lhs, rhs), [s_assign(vn, neg1)], []));
        out = out.append(s_if(e_binary(">", lhs, rhs), [s_assign(vn, e_number("1", "", false))], []));
        return out;
    }
    return [s_var(vn, "i32", dv_call1(lhs, "cmp", rhs))];
}

// dv_hash_stmts builds the statements that fold one field/payload's hash into
// the i32 accumulator `hv` via `h = h * 31 + <field hash>`. A SCALAR inlines
// its own hash — numeric: the value (cast to i32 for non-i32 widths); boolean:
// 0 / 1; string: an FNV-style per-byte `h = h*31 + ch` fold — so the derive
// needs NO `impl Hash for <primitive>`. The stdin-only self-host drivers
// (wasm_ir_run / asm_run, which parse a single source with no core/cmp loaded)
// don't provide those impls, so a primitive `.hash()` call would resolve to an
// unknown function and BAIL the whole module to the AST backend (the exact gap
// that kept struct/enum Map keys off the wasm self-host hash map — #2671). A
// NOMINAL field/payload delegates to its own (local, derived) `.hash()`. The
// only law the Map relies on is `a == b ⇒ a.hash() == b.hash()`, which the
// value-wise fold preserves; the absolute hash need not match core/cmp's mix.
// `sfx` disambiguates the per-string loop variable across fields. Mirrors the
// inline-primitive approach dv_cmp_stmts takes for `Ord`.
function dv_hash_stmts(hv: string, ty: string, recv: Expr, sfx: string): Stmt[] {
    var mul: Expr = e_binary("*", e_ident(hv), e_number("31", "", false));
    if (ty == "string") {
        // h = h * 31; var i = 0; while (i < recv.len()) { h = h*31 + recv[i]; i = i+1; }
        var iv: string = "__hsi" + sfx;
        var body: Stmt[] = [s_assign(hv, e_binary("+",
            e_binary("*", e_ident(hv), e_number("31", "", false)),
            e_index(recv, e_ident(iv))))];
        body = body.append(s_assign(iv, e_binary("+", e_ident(iv), e_number("1", "", false))));
        var out: Stmt[] = [s_assign(hv, mul)];
        out = out.append(s_var(iv, "i32", e_number("0", "", false)));
        out = out.append(s_while(e_binary("<", e_ident(iv), dv_call0(recv, "len")), body));
        return out;
    }
    if (ty == "boolean") {
        // h = h * 31; if (recv) { h = h + 1; }
        var t: Stmt[] = [s_assign(hv, e_binary("+", e_ident(hv), e_number("1", "", false)))];
        return [s_assign(hv, mul), s_if(recv, t, [])];
    }
    if (dv_is_num_scalar(ty)) {
        var v: Expr = recv;
        if (ty != "i32") { v = e_unary("as_i32", recv); }
        return [s_assign(hv, e_binary("+", mul, v))];
    }
    // Nominal struct/enum field: delegate to its own derived `.hash()`.
    return [s_assign(hv, e_binary("+", mul, dv_call0(recv, "hash")))];
}

// dv_is_num_scalar reports whether `t` is a numeric scalar — the subset of
// dv_is_scalar (excluding string / boolean) that std/num's Zero / One are
// impl'd for, so a `T.zero()` / `T.one()` on such a `T` can lower to a literal.
function dv_is_num_scalar(t: string): boolean {
    return t == "i32" || t == "i64" || t == "u32" || t == "u64"
        || t == "f32" || t == "f64";
}

// dv_num_identity_expr builds the additive (`one=false` → 0 / 0.0) or
// multiplicative (`one=true` → 1 / 1.0) identity literal for a numeric scalar
// type — the `T.zero()` / `T.one()` counterpart to dv_default_expr's scalar
// zero.
function dv_num_identity_expr(t: string, one: boolean): Expr {
    if (t == "f32" || t == "f64") {
        if (one) { return e_number("1.0", "", true); }
        return e_number("0.0", "", true);
    }
    if (one) { return e_number("1", "", false); }
    return e_number("0", "", false);
}

// struct_default_derivable reports whether EVERY field of `sd` has a
// derivable default (so the whole struct does). The Go checker is the
// strict gate; here we simply skip synthesis when a field isn't
// derivable, leaving `Type.default()` unresolved — the same end state as
// the Go path's error (no default method synthesised).
function struct_default_derivable(sd: StructDecl): boolean {
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        if (!dv_default_derivable(sd.fields[i].type_name)) { return false; }
        i = i + 1;
    }
    return true;
}

// synth_struct_default: the associated function `function default(): Self
// { return Name { f0: <dv>, … }; }` — receiver-less (empty receiver_name),
// so it lowers via the associated-function IR path (item 1). Mirrors the
// Go synthDefault.
function synth_struct_default(sd: StructDecl): FuncDecl {
    var fnames: string[] = [];
    var fvals: Expr[] = [];
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        fnames = fnames.append(sd.fields[i].name);
        fvals = fvals.append(dv_default_expr(sd.fields[i].type_name));
        i = i + 1;
    }
    var lit: Expr = e_struct_lit(sd.name, fnames, fvals, 0, 0);
    var body: Stmt[] = [s_return(lit)];
    var notp: string[] = [];
    var noparams: ParamDecl[] = [];
    // Like the other derived struct methods, default() carries NO function-level
    // type params (an empty list keeps monomorphize_module from treating it as a
    // generic free function). When the struct is generic, the struct-method
    // monomorphiser clones it per instantiation and substitutes `T` using the
    // STRUCT's type params (clone_struct_method) — so a generic body's
    // `T.default()` becomes `Concrete.default()`.
    return FuncDecl { name: "default", receiver_name: "", receiver_type: sd.name, type_params: notp, params: noparams, ret_type: sd.name, body: body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0, bound_traits: [], fip: false, ret_str: false };
}

// synth_derives appends the synthesised methods for each derivable trait
// (`Eq` / `Display` / `Ord` / `Hash` / `Json` / `Default`) named in
// `derives` for struct `sd` onto `funcs`. Non-derivable / unknown trait
// names are ignored (the Go checker is the strict gate). `Default` is the
// only associated (receiver-less) one — and only synthesised when every
// field is itself default-derivable.
function synth_derives(sd: StructDecl, derives: string[], funcs: FuncDecl[], has_json_import: boolean): FuncDecl[] {
    var di: i32 = 0;
    while (di < derives.len()) {
        var kind: string = derive_simple_name(derives[di]);
        if (kind == "Display") { funcs = funcs.append(synth_struct_display(sd)); }
        if (kind == "Debug") { funcs = funcs.append(synth_struct_debug(sd)); }
        if (kind == "Eq") { funcs = funcs.append(synth_struct_eq(sd)); }
        if (kind == "Ord") { funcs = funcs.append(synth_struct_ord(sd)); }
        if (kind == "Hash") { funcs = funcs.append(synth_struct_hash(sd)); }
        if (kind == "Json") {
            funcs = funcs.append(synth_struct_json(sd));
            // The deserialise companion `from_json` calls `json.json_parse` /
            // `json.json_get_*`, so it is ONLY synthesised when the real
            // std/json is imported (mirrors native's `json__json_parse in
            // prog.Funcs` gate). A module deriving a user's OWN inline `trait
            // Json` — or one that never imports std/json — gets serialise-only,
            // so those `json.*` calls are never emitted into an unresolved
            // module.
            if (has_json_import && from_json_derivable(sd)) { funcs = funcs.append(synth_from_json(sd)); }
        }
        if (kind == "Default") { if (struct_default_derivable(sd)) { funcs = funcs.append(synth_struct_default(sd)); } }
        di = di + 1;
    }
    return funcs;
}

// imports_have_std_json reports whether the module's parsed imports include
// std/json — the precondition for synthesising a `@derive(Json)` struct's
// `from_json` (whose body calls std/json's json_parse / json_get_*). Imports
// are conventionally at the top of a module, so they are already accumulated
// by the time a `@derive` struct decl is reached in parse_module.
function imports_have_std_json(imports: Import[]): boolean {
    var i: i32 = 0;
    while (i < imports.len()) {
        if (imports[i].path == "std/json") { return true; }
        i = i + 1;
    }
    return false;
}

// parse_derive_attr consumes `@derive(Trait, mod.Trait, …)` (the `@` is
// at the cursor) and returns the (possibly qualified) trait names.
function parse_derive_attr(p: Par): (string[], Par) {
    var derives: string[] = [];
    p = p.advance(); // `@`
    if (p.peek_ident() == "derive") { p = p.advance(); }
    if (p.peek_punct() == "(") {
        p = p.advance();
        while (!p.at_end()) {
            if (p.peek_punct() == ")") { break; }
            var tn: string = p.peek_ident();
            if (tn.len() == 0) { p = p.advance(); continue; }
            p = p.advance();
            while (p.peek_punct() == ".") {
                p = p.advance();
                var seg: string = p.peek_ident();
                if (seg.len() > 0) { tn = tn + "." + seg; p = p.advance(); }
            }
            derives = derives.append(tn);
            if (p.peek_punct() == ",") { p = p.advance(); }
        }
        if (p.peek_punct() == ")") { p = p.advance(); }
    }
    return (derives, p);
}

// parse_import_attr consumes `@import("wasi:iface@x.y.z", "wit-func-name")`
// (the `@` is at the cursor) and returns the interface + WIT function strings
// that bind the following body-less function to a WIT import (bring-your-own
// WIT, P4 — docs/WIT-BRING-YOUR-OWN.md). `is_import` is false when the
// attribute after `@` is not `import`, so the caller falls back to @derive.
function parse_import_attr(p: Par): (string, string, boolean, Par) {
    p = p.advance(); // `@`
    if (p.peek_keyword() != "import") {
        return ("", "", false, p);
    }
    p = p.advance(); // `import`
    var iface: string = "";
    var wit: string = "";
    if (p.peek_punct() == "(") {
        p = p.advance();
        match (p.peek()) {
            lexer.TokString(s) => { iface = s.value; p = p.advance(); },
            _ => { }
        }
        if (p.peek_punct() == ",") { p = p.advance(); }
        match (p.peek()) {
            lexer.TokString(s) => { wit = s.value; p = p.advance(); },
            _ => { }
        }
        if (p.peek_punct() == ")") { p = p.advance(); }
    }
    return (iface, wit, true, p);
}

// parse_export_attr consumes `@export("wasi:iface@x.y.z", "wit-name")` (the `@`
// is at the cursor) and returns the (iface, name) pair that binds the following
// function to a WIT export (P6 — docs/WIT-BRING-YOUR-OWN.md). Reuses
// the shared (iface, wit, …, Par) tuple shape.
function parse_export_attr(p: Par): (string, string, boolean, Par) {
    p = p.advance(); // `@`
    if (p.peek_ident() != "export") {
        return ("", "", false, p);
    }
    p = p.advance(); // `export`
    var iface: string = "";
    var wit: string = "";
    if (p.peek_punct() == "(") {
        p = p.advance();
        match (p.peek()) {
            lexer.TokString(s) => { iface = s.value; p = p.advance(); },
            _ => { }
        }
        if (p.peek_punct() == ",") { p = p.advance(); }
        match (p.peek()) {
            lexer.TokString(s) => { wit = s.value; p = p.advance(); },
            _ => { }
        }
        if (p.peek_punct() == ")") { p = p.advance(); }
    }
    return (iface, wit, true, p);
}

// yields the parsed resource name plus the advanced parser.

// parse_resource_decl_name consumes `resource Name;` (the contextual `resource`
// identifier is at the cursor) and returns the parser plus `Name`. The optional
// `@import` WIT binding is attached by parse_module. See ResourceDecl and
// docs/WIT-BRING-YOUR-OWN.md (P5).
function parse_resource_decl_name(p: Par): (string, Par) {
    p = p.advance(); // `resource`
    var name: string = p.peek_ident();
    if (name.len() > 0) { p = p.advance(); } // Name
    if (p.peek_punct() == ";") { p = p.advance(); }
    return (name, p);
}

// parse_impl_decl consumes `impl Trait for Type { <function>… }`.
// Each method is desugared into an ordinary receiver-method
// FuncDecl — its first `self: Self` parameter becomes the receiver
// with `Self` rewritten to the concrete `for` type — so the rest
// of the self-host pipeline (which already dispatches methods by
// receiver type) handles trait impls with no further changes.
// The trait name is parsed and discarded: the self-host resolves
// `obj.method()` by the receiver's concrete type, not via the
// trait. Mirrors the Go parser's impl desugaring (docs/TRAITS.md).
function parse_impl_decl(p: Par): (FuncDecl[], string, string, string[], string[], Par) {
    var out: FuncDecl[] = [];
    var method_names: string[] = [];
    p = p.advance(); // `impl`
    // Parametric impl: `impl[T: Bound] Trait for Box[T] { … }`. Collect
    // the impl's type-parameter names (bounded ones drive
    // monomorphisation; unbounded are erased) so each desugared method
    // carries them — the `for` type (`Box[T]`) keeps `T`, and the
    // emitter strips the generic args to the base struct name `Box`.
    // See docs/TRAITS.md.
    var impl_tps: string[] = [];
    if (p.peek_punct() == "[") {
        p = p.advance();
        while (!p.at_end()) {
            if (p.peek_punct() == "]") { break; }
            var tpn: string = p.peek_ident();
            if (tpn.len() == 0) { p = p.advance(); continue; }
            p = p.advance();
            var bounded: boolean = false;
            if (p.peek_punct() == ":") {
                bounded = true;
                p = p.advance();
                var go2: boolean = true;
                while (go2 && !p.at_end()) {
                    if (p.peek_ident().len() > 0) { p = p.advance(); }
                    if (p.peek_punct() == ".") {
                        p = p.advance();
                        if (p.peek_ident().len() > 0) { p = p.advance(); }
                    }
                    if (p.peek_punct() == "+") { p = p.advance(); } else { go2 = false; }
                }
            }
            if (bounded) { impl_tps = impl_tps.append(tpn); }
            if (p.peek_punct() == ",") { p = p.advance(); }
        }
        if (p.peek_punct() == "]") { p = p.advance(); }
    }
    // First name after `impl` (possibly `mod.Name`). For a trait impl
    // (`impl Trait for Type`) it's the trait; for an inherent impl
    // (`impl Type { … }`, #2700) there is no `for` and this name IS the
    // impl type, with no trait.
    var (tnr_name, tnr_ret_arr, tnr_fn_ret, tnr_p) = parse_type_name(p);
    p = tnr_p;
    var first_name: string = tnr_name;
    var trait_name: string = "";
    var impl_type: string = "";
    if (p.peek_keyword() == "for") {
        p = p.advance();
        // Trait name retained so parse_module can match the impl against
        // the trait's default methods.
        trait_name = first_name;
        var (ity_name, ity_ret_arr, ity_fn_ret, ity_p) = parse_type_name(p);
        p = ity_p;
        impl_type = ity_name;
    } else {
        // Inherent impl: the first name is the type; receiver-less methods
        // are associated functions (`Type.f(args)`), `self`-taking ones are
        // ordinary methods.
        impl_type = first_name;
    }
    if (p.peek_punct() == "{") { p = p.advance(); }
    while (!p.at_end()) {
        if (p.peek_punct() == "}") { break; }
        var kw: string = p.peek_keyword();
        if (kw == "pub") { p = p.advance(); kw = p.peek_keyword(); }
        if (kw != "function") {
            // Defensive: don't stall on an unexpected token.
            p = p.advance();
            continue;
        }
        var (fr_func, fr_p) = parse_func_decl(p);
        p = fr_p;
        var m: FuncDecl = fr_func;
        // finalize_impl_method does the receiver-peel / associated-function
        // encoding, the `Self` -> impl_type rewrite, and the bounded-type-
        // param merge (shared with trait default-method synthesis).
        out = out.append(finalize_impl_method(m, impl_type, impl_tps));
        method_names = method_names.append(m.name);
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    // Strip generic args from the trait ref (`Greet[i32]` -> `Greet`) before
    // reducing to the simple name, so a generic-trait impl matches its trait
    // declaration for default-method synthesis (parse_module compares against
    // the trait decl's bracket-free simple name). Without the strip,
    // `impl Greet[i32] for P` records trait_name "Greet[i32]", never matches
    // the `Greet` trait, and its default methods are never synthesised (#4340).
    return (out, derive_simple_name(strip_struct_base(trait_name)), impl_type, impl_tps, method_names, p);
}

// finalize_impl_method turns a parsed impl/trait-default method `m` into
// the receiver-method (or associated-function) FuncDecl the rest of the
// pipeline consumes: `Self` -> impl_type across params + return, the
// leading `self` peeled into the receiver (a method whose first param
// isn't `self` is an associated function with an empty receiver_name),
// and the impl's bounded type params merged in. Shared by parse_impl_decl
// (written methods) and trait default-method synthesis in parse_module.
function ident_byte(b: i32): boolean {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95;
}
// is_builtin_generic_base reports whether `b` is a built-in generic type
// constructor whose instantiations are NOT cloned by the struct/enum
// monomorphiser — `Option` / `Result` (uniform leak-only boxes) and `Map`
// (built-in K/V dispatch). A type param appearing only as their argument
// (`find[T](…): Option[T]`) does not need promotion: the uniform 8-byte ABI
// already handles it, exactly as the historical erasure did.
function is_builtin_generic_base(b: string): boolean {
    return b == "Option" || b == "Result" || b == "Map";
}
// enclosing_bracket_base returns the base identifier of the INNERMOST `[ … ]`
// that encloses position `pos` in `ty` — `Box` for the `T` in `Box[T]`,
// `Option` for the `T` in `Box[Option[T]]` — or "" if `pos` is not inside any
// bracket. Found by scanning left from `pos`, balancing `]`/`[`, until the
// first unmatched `[`; the base is the identifier immediately preceding it.
function enclosing_bracket_base(ty: string, pos: i32): string {
    var bal: i32 = 0;
    var i: i32 = pos - 1;
    while (i >= 0) {
        var c: i32 = ty[i];
        if (c == 93) { bal = bal + 1; }                 // ']'
        else if (c == 91) {                             // '['
            if (bal == 0) {
                var st: i32 = i;
                while (st > 0 && ident_byte(ty[st - 1])) { st = st - 1; }
                return ty[st : i] + "";
            }
            bal = bal - 1;
        }
        i = i - 1;
    }
    return "";
}
// feeds_user_parametric reports whether the type-param `name` appears as a
// bracketed type-ARGUMENT to a USER parametric type in `ty` — i.e. inside
// `Base[ … name … ]` where `Base` is a user generic struct/enum (NOT a
// built-in: see is_builtin_generic_base, and NOT the array marker `T[]`, whose
// `[` is preceded by the element and encloses nothing). Such an occurrence
// means a struct/enum clone needs `name`'s concrete value, so the unbounded
// param must be promoted to the monomorphiser. `ArrayIter[T]` matches;
// `Option[T]` / `Map[K, V]` / bare `T` / `T[]` do not. The base checked is the
// INNERMOST enclosing bracket (`Box[Option[T]]` -> base `Option`, no promote).
function feeds_user_parametric(ty: string, name: string): boolean {
    var i: i32 = 0;
    var nl: i32 = name.len();
    if (nl == 0) { return false; }
    while (i < ty.len()) {
        if (i + nl <= ty.len() && ty[i : i + nl] == name) {
            var prev_ok: boolean = true;
            if (i > 0 && ident_byte(ty[i - 1])) { prev_ok = false; }
            var next_ok: boolean = true;
            if (i + nl < ty.len() && ident_byte(ty[i + nl])) { next_ok = false; }
            if (prev_ok && next_ok) {
                var b: string = enclosing_bracket_base(ty, i);
                if (b.len() > 0 && !is_builtin_generic_base(b)) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}
// feeds_map_typearg reports whether `name` appears as a bracketed type-ARGUMENT
// to a `Map[...]` (key or value position) in `ty`. feeds_user_parametric
// EXCLUDES the built-in `Map` base (a Map needs no struct clone) — but a generic
// body's map ops DO need the concrete K/V to pick the key-kind / value-is-ptr,
// so a `Map`-feeding type var must be promoted to the monomorphiser too, else
// the erased body defaults to string-key dispatch and miscompiles an i32-keyed
// map. This is the Map-codegen sibling of feeds_user_parametric's struct-clone
// rule. The base checked is the INNERMOST enclosing bracket.
function feeds_map_typearg(ty: string, name: string): boolean {
    var i: i32 = 0;
    var nl: i32 = name.len();
    if (nl == 0) { return false; }
    while (i < ty.len()) {
        if (i + nl <= ty.len() && ty[i : i + nl] == name) {
            var prev_ok: boolean = true;
            if (i > 0 && ident_byte(ty[i - 1])) { prev_ok = false; }
            var next_ok: boolean = true;
            if (i + nl < ty.len() && ident_byte(ty[i + nl])) { next_ok = false; }
            if (prev_ok && next_ok) {
                if (enclosing_bracket_base(ty, i) == "Map") { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}
// token_at_paren_depth0 reports whether `name` appears as a standalone
// identifier token at PAREN nesting depth 0 in `ty` — the positions a param
// type lets `bind_unify` recover a type param from a call argument (`T`,
// `T[]`, `Box[T]`; brackets `[]` are unified, so they don't gate). A token
// inside `(`…`)` (a function-type or tuple param like `(T) => boolean`) is NOT
// reached by bind_unify, so it does not make the param bind the type variable.
function token_at_paren_depth0(ty: string, name: string): boolean {
    var pdepth: i32 = 0;
    var i: i32 = 0;
    var nl: i32 = name.len();
    if (nl == 0) { return false; }
    while (i < ty.len()) {
        var c: i32 = ty[i];
        if (c == 40) { pdepth = pdepth + 1; i = i + 1; continue; }   // '('
        if (c == 41) { pdepth = pdepth - 1; i = i + 1; continue; }   // ')'
        if (pdepth == 0 && i + nl <= ty.len() && ty[i : i + nl] == name) {
            var prev_ok: boolean = true;
            if (i > 0 && ident_byte(ty[i - 1])) { prev_ok = false; }
            var next_ok: boolean = true;
            if (i + nl < ty.len() && ident_byte(ty[i + nl])) { next_ok = false; }
            if (prev_ok && next_ok) { return true; }
        }
        i = i + 1;
    }
    return false;
}
// token_in_tuple_param reports whether `name` appears as a standalone token
// inside a TUPLE (or tuple-array) parameter type — `(K, V)` / `(K, V)[]`. A
// function type `(T) => U` ends at its result (not `)`), so the start-`(`/end-
// `)` shape check excludes it. bind_unify now destructures tuple parens, so a
// var in this position binds from the call argument — the tuple sibling of
// token_at_paren_depth0. Over-broadness is safe: if bind_unify can't recover the
// var, infer_inst leaves it unbound and the call simply stays generic.
function token_in_tuple_param(ty: string, name: string): boolean {
    if (name.len() == 0) { return false; }
    var t: string = ty;
    while (type_ends_arr(t)) { t = t[0 : t.len() - 2] + ""; }   // strip array markers
    if (t.len() < 2 || t[0:1] != "(" || t[t.len() - 1 : t.len()] != ")") { return false; }
    var inner: str = t[1 : t.len() - 1];
    var i: i32 = 0;
    var nl: i32 = name.len();
    while (i < inner.len()) {
        if (i + nl <= inner.len() && inner[i : i + nl] == name) {
            var prev_ok: boolean = true;
            if (i > 0 && ident_byte(inner[i - 1])) { prev_ok = false; }
            var next_ok: boolean = true;
            if (i + nl < inner.len() && ident_byte(inner[i + nl])) { next_ok = false; }
            if (prev_ok && next_ok) { return true; }
        }
        i = i + 1;
    }
    return false;
}
// replace_struct_ident rewrites every standalone `from` identifier token in a
// type string to `to` (identifier-boundary aware, like subst_self). Used to
// normalise a finalize-baked BARE struct name (`ArrayIter`, the source spelling
// substituted into a generic impl method's `Self` positions at parse time)
// back to the module-prefixed registered name (`iter__ArrayIter`) BEFORE the
// struct monomorphiser mangles it — otherwise mg_ty cannot match the bare base
// against the prefixed gstructs entry and the clone's return/param type keeps a
// dangling `ArrayIter[i32]` that never lowers. The boundary check skips the
// `ArrayIter` inside an already-prefixed `iter__ArrayIter` (preceded by `_`).
function replace_struct_ident(ty: string, from: string, to: string): string {
    if (ty.len() == 0 || from.len() == 0 || from == to) { return ty; }
    var out: string = "";
    var i: i32 = 0;
    var fl: i32 = from.len();
    while (i < ty.len()) {
        if (i + fl <= ty.len() && ty[i : i + fl] == from) {
            var prev_ok: boolean = true;
            if (i > 0 && ident_byte(ty[i - 1])) { prev_ok = false; }
            var next_ok: boolean = true;
            if (i + fl < ty.len() && ident_byte(ty[i + fl])) { next_ok = false; }
            if (prev_ok && next_ok) { out = out + to; i = i + fl; continue; }
        }
        out = out + ty[i : i + 1];
        i = i + 1;
    }
    return out;
}
// subst_self rewrites every standalone `Self` token in a type string to
// impl_type, INCLUDING nested (Option[(T, Self)] -> Option[(T, ArrayIter[T])]).
// pub so the checker's E021 signature comparison (#4347) can apply the SAME
// substitution to a trait's required signature that finalize_impl_method
// applied to the impl method — a consistent rewrite means a conforming impl
// compares equal while a genuine arity / type mismatch surfaces.
pub function subst_self(ty: string, impl_type: string): string {
    if (ty.len() == 0) { return ty; }
    var out: string = "";
    var i: i32 = 0;
    while (i < ty.len()) {
        if (i + 4 <= ty.len() && ty[i : i + 4] == "Self") {
            var prev_ok: boolean = true;
            if (i > 0 && ident_byte(ty[i - 1])) { prev_ok = false; }
            var next_ok: boolean = true;
            if (i + 4 < ty.len() && ident_byte(ty[i + 4])) { next_ok = false; }
            if (prev_ok && next_ok) { out = out + impl_type; i = i + 4; continue; }
        }
        out = out + ty[i : i + 1];
        i = i + 1;
    }
    return out;
}

function finalize_impl_method(m: FuncDecl, impl_type: string, impl_tps: string[]): FuncDecl {
    var rt: string = subst_self(m.ret_type, impl_type);
    var mtps: string[] = m.type_params;
    var ti: i32 = 0;
    while (ti < impl_tps.len()) { mtps = mtps.append(impl_tps[ti]); ti = ti + 1; }
    var has_self: boolean = false;
    if (m.params.len() > 0) {
        if (m.params[0].name == "self") { has_self = true; }
    }
    if (!has_self) {
        // Associated function: keep ALL params (none is a receiver),
        // rewrite `Self` -> impl_type across them, emit with empty receiver.
        var aparams: ParamDecl[] = [];
        var ai: i32 = 0;
        while (ai < m.params.len()) {
            var apt: string = m.params[ai].type_name;
            apt = subst_self(apt, impl_type);
            aparams = aparams.append(ParamDecl { name: m.params[ai].name, type_name: apt, own: m.params[ai].own, has_default: m.params[ai].has_default, default_value: m.params[ai].default_value, ret_arr: m.params[ai].ret_arr, fn_ret: m.params[ai].fn_ret, fn_param_dyn: m.params[ai].fn_param_dyn });
            ai = ai + 1;
        }
        return FuncDecl {
            name: m.name,
            receiver_name: "",
            receiver_type: impl_type,
            type_params: mtps,
            params: aparams,
            ret_type: rt,
            body: m.body, line: m.line, col: m.col,
            import_iface: m.import_iface, import_wit: m.import_wit, type_param_count: m.type_param_count, bound_traits: [], fip: m.fip, ret_str: m.ret_str
        };
    }
    // Receiver method: peel the first param (`self`) into the receiver
    // and rewrite `Self` -> impl_type across the remaining params.
    var rname: string = "self";
    var newparams: ParamDecl[] = [];
    var i: i32 = 0;
    while (i < m.params.len()) {
        if (i == 0) {
            rname = m.params[i].name;
        } else {
            var pt: string = m.params[i].type_name;
            pt = subst_self(pt, impl_type);
            newparams = newparams.append(ParamDecl { name: m.params[i].name, type_name: pt, own: m.params[i].own, has_default: m.params[i].has_default, default_value: m.params[i].default_value, ret_arr: m.params[i].ret_arr, fn_ret: m.params[i].fn_ret, fn_param_dyn: m.params[i].fn_param_dyn });
        }
        i = i + 1;
    }
    return FuncDecl {
        name: m.name,
        receiver_name: rname,
        receiver_type: impl_type,
        type_params: mtps,
        params: newparams,
        ret_type: rt,
        body: m.body, line: m.line, col: m.col,
        import_iface: m.import_iface, import_wit: m.import_wit, type_param_count: m.type_param_count, bound_traits: [], fip: m.fip, ret_str: m.ret_str
    };
}

// parse_trait_decl consumes a `trait Name { <method>; … }` block. The
// self-host doesn't validate conformance (dispatch is by receiver type),
// so abstract signatures carry no weight and are dropped — but a method
// with a `{ … }` DEFAULT body is retained: parse_module synthesises a
// copy onto every impl of the trait that omits it (Self-host parity with
// the Go checker's synthesizeTraitDefaults — see docs/TRAITS.md). Each
// method parses with the ordinary parse_func_decl machinery (no receiver
// clause; its first parameter is `self: Self`); an abstract one ends at
// `;` and so comes back with an empty body, which we skip.
function parse_trait_decl(p: Par): (TraitDefault[], TraitReq, Par) {
    var defaults: TraitDefault[] = [];
    var required: string[] = [];
    var required_sigs: FuncDecl[] = [];
    var supertraits: string[] = [];
    p = p.advance(); // `trait`
    var tname: string = p.peek_ident();
    if (tname.len() > 0) { p = p.advance(); } // name
    var simple: string = derive_simple_name(tname);
    // Optional generic type parameters: `trait Greet[T] { … }`. Native
    // parses these via parseTypeParamList; the self-host erases traits
    // (dispatch is by receiver type) and monomorphises a default method
    // through the IMPL's type params in finalize_impl_method, so the
    // trait's declared params carry no weight — but they MUST be consumed
    // here or `[T]` and the trait body spill back into parse_module as a
    // stray array literal + orphan block, losing default methods (#4340).
    // Mirrors the struct/enum decl generics loop (bracket-depth scan).
    if (p.peek_punct() == "[") {
        p = p.advance(); // consume `[`
        var gd: i32 = 1;
        while (!p.at_end() && gd > 0) {
            var gpk: string = p.peek_punct();
            if (gpk == "[") { gd = gd + 1; p = p.advance(); continue; }
            if (gpk == "]") { gd = gd - 1; p = p.advance(); continue; }
            p = p.advance();
        }
    }
    // Optional supertrait clause `: Trait (+ Trait)*` (each possibly
    // `mod.Trait`). Dispatch is still by receiver type, but the supertrait
    // NAMES are retained for the E021 conformance check (#4347): an
    // `impl B for T` where `trait B: A` also requires an `impl A for T`.
    // See docs/TRAITS.md.
    if (p.peek_punct() == ":") {
        p = p.advance();
        var go_sup: boolean = true;
        while (go_sup && !p.at_end()) {
            var sup_name: string = "";
            if (p.peek_ident().len() > 0) { sup_name = p.peek_ident(); p = p.advance(); }
            if (p.peek_punct() == ".") {
                p = p.advance();
                if (p.peek_ident().len() > 0) { sup_name = p.peek_ident(); p = p.advance(); }
            }
            if (sup_name.len() > 0) { supertraits = supertraits.append(derive_simple_name(sup_name)); }
            if (p.peek_punct() == "+") { p = p.advance(); } else { go_sup = false; }
        }
    }
    if (p.peek_punct() == "{") {
        p = p.advance();
        while (!p.at_end()) {
            if (p.peek_punct() == "}") { break; }
            if (p.peek_keyword() == "function") {
                var (fr_func, fr_p) = parse_func_decl(p);
                p = fr_p;
                // A non-empty body marks a default method. (An empty `{}`
                // body is indistinguishable from an abstract `;` here and
                // is treated as abstract — it would synthesise a no-op.)
                if (fr_func.body.len() > 0) {
                    defaults = defaults.append(TraitDefault { trait_name: simple, method: fr_func });
                } else {
                    // Abstract (body-less) signature: a REQUIRED method every
                    // impl must provide (#4347 E021). Bodied defaults above are
                    // NOT required (synthesised onto omitting impls). The full
                    // decl rides req_sigs (parallel to required) for the
                    // signature-mismatch check.
                    required = required.append(fr_func.name);
                    required_sigs = required_sigs.append(fr_func);
                }
            } else {
                // Defensive: don't stall on an unexpected token.
                p = p.advance();
            }
        }
        if (p.peek_punct() == "}") { p = p.advance(); }
    }
    return (defaults, TraitReq { trait_name: simple, methods: required, req_sigs: required_sigs, supertraits: supertraits }, p);
}

pub function parse_module(toks: lexer.Token[]): Module {
    var p: Par = Par { toks: toks, pos: 0, no_struct: false };
    var funcs: FuncDecl[] = [];
    var trait_defaults: TraitDefault[] = [];
    var trait_reqs: TraitReq[] = [];
    var impl_infos: ImplInfo[] = [];
    var structs: StructDecl[] = [];
    var aliases: TypeAlias[] = [];
    var imports: Import[] = [];
    var top_stmts: Stmt[] = [];
    var enums: EnumDecl[] = [];
    var resources: ResourceDecl[] = [];
    var exports: ExportBinding[] = [];
    while (!p.at_end()) {
        var kw: string = p.peek_keyword();
        // `pub` is currently a no-op prefix on top-level decls
        // — strip it and re-read the keyword so `pub function`,
        // `pub struct`, and `pub type` all dispatch correctly.
        if (kw == "pub") {
            p = p.advance();
            kw = p.peek_keyword();
        }
        // `@derive(Trait, …)` attribute on the following struct/enum.
        // Synthesise the field-wise trait methods (structs); enum
        // derive is a follow-up. See docs/TRAITS.md.
        if (p.peek_punct() == "@") {
            // `@import("iface", "wit-func")` binds the following body-less
            // function to a WIT import (P4). A probe past `@` distinguishes it
            // from `@derive`, which keeps the original cursor.
            var probe: Par = p.advance();
            if (probe.peek_keyword() == "import") {
                var (iar_iface, iar_wit, iar_is_import, iar_p) = parse_import_attr(p);
                p = iar_p;
                var ik: string = p.peek_keyword();
                if (ik == "pub") { p = p.advance(); ik = p.peek_keyword(); }
                if (ik == "function") {
                    var (ifr_func, ifr_p) = parse_func_decl(p);
                    p = ifr_p;
                    var ifn: FuncDecl = FuncDecl { ...ifr_func, import_iface: iar_iface, import_wit: iar_wit };
                    funcs = funcs.append(ifn);
                } else if (p.peek_ident() == "resource") {
                    // `@import(iface, wit) resource Name;` binds a WIT resource
                    // handle type to its WIT identity (P5). Record it so
                    // insert_resource_drops can synthesize the [resource-drop].
                    var (rnr_name, rnr_p) = parse_resource_decl_name(p);
                    p = rnr_p;
                    resources = resources.append(ResourceDecl { name: rnr_name, iface: iar_iface, wit: iar_wit });
                }
                continue;
            }
            if (probe.peek_ident() == "export") {
                // `@export("iface", "wit-name") function f(…) {…}` binds a
                // function to a WIT export (P6 — docs/WIT-BRING-YOUR-OWN.md).
                // The function is parsed normally; the binding is recorded on
                // Module.exports so the wasm emitter surfaces a core export
                // `iface#wit-name` the Go composer lifts.
                var (ear_iface, ear_wit, ear_is_import, ear_p) = parse_export_attr(p);
                p = ear_p;
                var xk: string = p.peek_keyword();
                if (xk == "pub") { p = p.advance(); xk = p.peek_keyword(); }
                if (xk == "function") {
                    var (xfr_func, xfr_p) = parse_func_decl(p);
                    p = xfr_p;
                    funcs = funcs.append(xfr_func);
                    exports = exports.append(ExportBinding { func_name: xfr_func.name, iface: ear_iface, wit: ear_wit });
                }
                continue;
            }
            if (probe.peek_ident() == "inline" || probe.peek_ident() == "noinline") {
                // `@inline` / `@noinline` markers (#4412 Rec §14) are
                // consulted by the NATIVE inliner only — the self-host
                // IR path runs no inline pass, so the marker is
                // parse-tolerated and dropped (the must_consume
                // precedent below). The following function decl parses
                // normally on the next loop iteration.
                p = probe.advance();
                continue;
            }
            if (probe.peek_ident() == "must_consume") {
                // `@must_consume` marker (docs/MUST-CONSUME.md): stamp
                // the following struct/enum decl so the checker's E067
                // obligation walk sees the mark. `@must_consume` before
                // anything other than a struct/enum decl stays
                // parse-tolerated (dropped) — the native parser rejects
                // that shape, and the self-host only compiles
                // native-valid programs.
                p = probe.advance();  // consume `must_consume`
                var mck: string = p.peek_keyword();
                if (mck == "pub") { p = p.advance(); mck = p.peek_keyword(); }
                if (mck == "struct") {
                    var (mcs_decl, mcs_p) = parse_struct_decl(p);
                    p = mcs_p;
                    structs = structs.append(StructDecl { ...mcs_decl, must_consume: true });
                    continue;
                }
                if (mck == "enum") {
                    var mceline: i32 = p.peek_line();
                    var mcecol: i32 = p.peek_col();
                    var (mce_name, mce_variants, mce_type_params, mce_p) = parse_enum_decl(p);
                    p = mce_p;
                    enums = enums.append(EnumDecl { name: mce_name, variant_names: enum_variant_names(mce_variants), type_params: mce_type_params, line: mceline, col: mcecol, must_consume: true });
                    var mcei: i32 = 0;
                    while (mcei < mce_variants.len()) {
                        structs = structs.append(mce_variants[mcei]);
                        mcei = mcei + 1;
                    }
                    continue;
                }
                continue;
            }
            var (dr_derives, dr_p) = parse_derive_attr(p);
            p = dr_p;
            var dk: string = p.peek_keyword();
            if (dk == "pub") { p = p.advance(); dk = p.peek_keyword(); }
            if (dk == "struct") {
                var (dsr_decl, dsr_p) = parse_struct_decl(p);
                p = dsr_p;
                structs = structs.append(StructDecl { ...dsr_decl, derives: dr_derives });
                funcs = synth_derives(dsr_decl, dr_derives, funcs, imports_have_std_json(imports));
                continue;
            }
            if (dk == "enum") {
                var deline: i32 = p.peek_line();
                var decol: i32 = p.peek_col();
                var (denr_name, denr_variants, denr_type_params, denr_p) = parse_enum_decl(p);
                p = denr_p;
                enums = enums.append(EnumDecl { name: denr_name, variant_names: enum_variant_names(denr_variants), type_params: denr_type_params, line: deline, col: decol, must_consume: false });
                var dei: i32 = 0;
                while (dei < denr_variants.len()) {
                    structs = structs.append(StructDecl { ...denr_variants[dei], derives: dr_derives });
                    dei = dei + 1;
                }
                // Synthesise variant-wise Display / Eq methods on the
                // enum type; they dispatch via the enum-method fallback.
                funcs = synth_enum_derives(denr_name, denr_variants, dr_derives, funcs);
                continue;
            }
            continue;
        }
        // `fip` / `fbip` are contextual modifiers on a function decl (`fip
        // function …` / `pub fbip(1) function …`), each with an optional
        // graded allowance `(n)`. The self-host STAMPS only the bare `fip`
        // (the strict E053 subset its checker enforces); `fbip` and the
        // graded `fip(n)` / `fbip(n)` forms are parse-TOLERATED and
        // DROPPED: the IR-level E068 verification (plan E2') lives in the
        // native compiler only until the self-host reuse port (plan E4)
        // lands, and stamping `fip` on a graded/fbip declaration would send
        // a legitimately-allocating body into the strict E053 walk. Dropping
        // the mark is the sound direction (the guarantee simply goes
        // unchecked here — the native compile of the same program checks
        // it). Recognised only when the whole modifier shape is directly
        // followed by `function`, so both names stay usable as ordinary
        // identifiers everywhere else — the same rule the native parser
        // uses.
        var decl_fip: boolean = false;
        var fm_name: string = p.peek_ident();
        if (fm_name == "fip" || fm_name == "fbip") {
            var fm_probe: Par = p.advance();
            var fm_graded: boolean = false;
            if (fm_probe.peek_punct() == "(") {
                // Graded allowance `(n)`: a single integer literal, then `)`.
                var fm_num: Par = fm_probe.advance();
                if (fm_num.peek_is_literal()) {
                    var fm_close: Par = fm_num.advance();
                    if (fm_close.peek_punct() == ")") {
                        fm_probe = fm_close.advance();
                        fm_graded = true;
                    }
                }
            }
            if (fm_probe.peek_keyword() == "function") {
                p = fm_probe;
                kw = "function";
                decl_fip = fm_name == "fip" && !fm_graded;
            }
        }
        if (kw == "function") {
            var (fr_func, fr_p) = parse_func_decl(p);
            p = fr_p;
            if (decl_fip) {
                funcs = funcs.append(FuncDecl { ...fr_func, fip: true });
            } else {
                funcs = funcs.append(fr_func);
            }
            continue;
        }
        if (kw == "struct") {
            var (sr_decl, sr_p) = parse_struct_decl(p);
            p = sr_p;
            structs = structs.append(sr_decl);
            continue;
        }
        if (kw == "type") {
            var (tr_alias, tr_p) = parse_type_alias(p);
            p = tr_p;
            aliases = aliases.append(tr_alias);
            continue;
        }
        if (kw == "enum") {
            var eline: i32 = p.peek_line();
            var ecol: i32 = p.peek_col();
            var (enr_name, enr_variants, enr_type_params, enr_p) = parse_enum_decl(p);
            p = enr_p;
            enums = enums.append(EnumDecl { name: enr_name, variant_names: enum_variant_names(enr_variants), type_params: enr_type_params, line: eline, col: ecol, must_consume: false });
            var ei: i32 = 0;
            while (ei < enr_variants.len()) {
                structs = structs.append(enr_variants[ei]);
                ei = ei + 1;
            }
            continue;
        }
        if (kw == "const") {
            // `const NAME: T = EXPR;` desugars to a zero-arg function
            // `function NAME(): T { return EXPR; }`; a bare reference
            // to NAME is lowered to a call (see emit_expr ExprIdent).
            var (cr_func, cr_p) = parse_const_decl(p);
            p = cr_p;
            funcs = funcs.append(cr_func);
            continue;
        }
        if (kw == "import") {
            var (ir_imp, ir_p) = parse_import(p);
            p = ir_p;
            imports = imports.append(ir_imp);
            continue;
        }
        // `pub use "path".{names…};` — a re-export directive. Recorded as a
        // re-export Import so the loader pulls in the target module and the
        // bundler redirects `facade.name` to the target's mangled symbol.
        if (kw == "use") {
            var (ur_imp, ur_p) = parse_pubuse(p);
            p = ur_p;
            imports = imports.append(ur_imp);
            continue;
        }
        if (kw == "trait") {
            var (tpr_defaults, tpr_req, tpr_p) = parse_trait_decl(p);
            p = tpr_p;
            var tdi: i32 = 0;
            while (tdi < tpr_defaults.len()) {
                trait_defaults = trait_defaults.append(tpr_defaults[tdi]);
                tdi = tdi + 1;
            }
            // Retain the trait's required (abstract) method set for E021 (#4347).
            // Retain a trait's requirement record when it has abstract methods
            // OR supertraits — a supertrait-only trait (`trait Num: Add + …{}`)
            // has no methods but still drives the E021 supertrait-impl check.
            if (tpr_req.methods.len() > 0 || tpr_req.supertraits.len() > 0) { trait_reqs = trait_reqs.append(tpr_req); }
            continue;
        }
        if (kw == "impl") {
            var (imr_funcs, imr_trait_name, imr_impl_type, imr_type_params, imr_method_names, imr_p) = parse_impl_decl(p);
            p = imr_p;
            var mi: i32 = 0;
            while (mi < imr_funcs.len()) {
                funcs = funcs.append(imr_funcs[mi]);
                mi = mi + 1;
            }
            impl_infos = impl_infos.append(ImplInfo { trait_name: imr_trait_name, impl_type: imr_impl_type, type_params: imr_type_params, method_names: imr_method_names });
            continue;
        }
        // `resource Name;` — a top-level WIT resource-handle declaration (P5).
        // `resource` is a contextual identifier (not a keyword), so dispatch
        // here when it's followed by a name. Recorded (with an empty WIT binding
        // when no `@import` preceded it). See docs/WIT-BRING-YOUR-OWN.md.
        if (p.peek_ident() == "resource") {
            var pr: Par = p.advance();
            if (pr.peek_ident().len() > 0) {
                var (rnr2_name, rnr2_p) = parse_resource_decl_name(p);
                p = rnr2_p;
                resources = resources.append(ResourceDecl { name: rnr2_name, iface: "", wit: "" });
                continue;
            }
        }
        var (stmtR_stmt, stmtR_p) = parse_stmt(p);
        // Guarantee forward progress: if a malformed top-level token (e.g.
        // a reserved keyword where a declaration / statement is expected)
        // leaves the cursor un-advanced, skip it rather than spin forever.
        if (stmtR_p.pos == p.pos) {
            p = p.advance();
            continue;
        }
        p = stmtR_p;
        top_stmts = top_stmts.append(stmtR_stmt);
    }
    // Synthesise inherited trait default methods now that the whole module
    // is parsed (a trait may be declared after the impl that uses it). For
    // each impl, every default of its trait that the impl did not provide
    // becomes a receiver method on the impl type — the same desugaring a
    // written method gets. Self-host parity with the Go checker's
    // synthesizeTraitDefaults (see docs/TRAITS.md); same-module only.
    var iii: i32 = 0;
    while (iii < impl_infos.len()) {
        var info: ImplInfo = impl_infos[iii];
        var ddi: i32 = 0;
        while (ddi < trait_defaults.len()) {
            var td: TraitDefault = trait_defaults[ddi];
            if (td.trait_name == info.trait_name) {
                if (!str_list_contains(info.method_names, td.method.name)) {
                    funcs = funcs.append(finalize_impl_method(td.method, info.impl_type, info.type_params));
                }
            }
            ddi = ddi + 1;
        }
        iii = iii + 1;
    }
    // Resolve loop labels here, at the single shared parse entry, so every
    // driver/backend pipeline sees break/continue tags already baked in (the
    // per-driver prep pipelines diverge, so doing it here is the universal spot).
    // Idempotent: re-running on already-resolved tags recomputes the same depth.
    return resolve_labels_module(Module { funcs: funcs, structs: structs, aliases: aliases, imports: imports, top_stmts: top_stmts, enums: enums, resources: resources, exports: exports, impls: impl_infos, trait_reqs: trait_reqs });
}

// merge_module flat-concatenates `into`'s decls with `from`'s:
// funcs + structs + aliases are appended. top_stmts and the
// imports list of `into` are preserved unchanged — top-level
// stmts from imported modules don't run, and resolved imports
// don't replicate. Used by callers that want to feed a multi-
// source build through the rest of the pipeline as a single
// Module (a stand-in for real cross-file namespace resolution
// until that lands).
pub function merge_module(into: Module, from: Module): Module {
    var nfuncs: FuncDecl[] = into.funcs;
    var fi: i32 = 0;
    while (fi < from.funcs.len()) { nfuncs = nfuncs.append(from.funcs[fi]); fi = fi + 1; }
    var nstructs: StructDecl[] = into.structs;
    var si: i32 = 0;
    while (si < from.structs.len()) { nstructs = nstructs.append(from.structs[si]); si = si + 1; }
    var naliases: TypeAlias[] = into.aliases;
    var ai: i32 = 0;
    while (ai < from.aliases.len()) { naliases = naliases.append(from.aliases[ai]); ai = ai + 1; }
    var nresources: ResourceDecl[] = into.resources;
    var ri: i32 = 0;
    while (ri < from.resources.len()) { nresources = nresources.append(from.resources[ri]); ri = ri + 1; }
    var nexports: ExportBinding[] = into.exports;
    var xi: i32 = 0;
    while (xi < from.exports.len()) { nexports = nexports.append(from.exports[xi]); xi = xi + 1; }
    var nimpls: ImplInfo[] = into.impls;
    var nii: i32 = 0;
    while (nii < from.impls.len()) { nimpls = nimpls.append(from.impls[nii]); nii = nii + 1; }
    var ntreqs: TraitReq[] = into.trait_reqs;
    var nti: i32 = 0;
    while (nti < from.trait_reqs.len()) { ntreqs = ntreqs.append(from.trait_reqs[nti]); nti = nti + 1; }
    return Module {
        funcs: nfuncs,
        structs: nstructs,
        aliases: naliases,
        imports: into.imports,
        top_stmts: into.top_stmts,
        enums: concat_enums(into.enums, from.enums),
        resources: nresources,
        exports: nexports,
        impls: nimpls,
        trait_reqs: ntreqs
    };
}

// merge_module_prefixed adds `from`'s decls to `into` with
// each decl's name renamed to `prefix + "." + name`. Models
// flat-namespace cross-file imports — a call site like
// `parser.parse_module(…)` resolves to a function literally
// named `"parser.parse_module"` in the merged module.
pub function merge_module_prefixed(into: Module, from: Module, prefix: string): Module {
    var nfuncs: FuncDecl[] = into.funcs;
    var fi: i32 = 0;
    while (fi < from.funcs.len()) {
        var fd: FuncDecl = from.funcs[fi];
        nfuncs = nfuncs.append(FuncDecl {
            name: prefix + "." + fd.name,
            receiver_name: fd.receiver_name,
            receiver_type: fd.receiver_type,
            type_params: fd.type_params,
            params: fd.params,
            ret_type: fd.ret_type,
            body: fd.body, line: fd.line, col: fd.col,
            import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str
        });
        fi = fi + 1;
    }
    var nstructs: StructDecl[] = into.structs;
    var si: i32 = 0;
    while (si < from.structs.len()) {
        var sd: StructDecl = from.structs[si];
        nstructs = nstructs.append(StructDecl { name: prefix + "." + sd.name, fields: sd.fields, type_params: sd.type_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume });
        si = si + 1;
    }
    var naliases: TypeAlias[] = into.aliases;
    var ai: i32 = 0;
    while (ai < from.aliases.len()) {
        var ad: TypeAlias = from.aliases[ai];
        naliases = naliases.append(TypeAlias { name: prefix + "." + ad.name, variants: ad.variants, line: ad.line, col: ad.col });
        ai = ai + 1;
    }
    var nresources: ResourceDecl[] = into.resources;
    var ri: i32 = 0;
    while (ri < from.resources.len()) {
        var rd: ResourceDecl = from.resources[ri];
        nresources = nresources.append(ResourceDecl { name: prefix + "." + rd.name, iface: rd.iface, wit: rd.wit });
        ri = ri + 1;
    }
    var nexports: ExportBinding[] = into.exports;
    var xi: i32 = 0;
    while (xi < from.exports.len()) {
        var xb: ExportBinding = from.exports[xi];
        nexports = nexports.append(ExportBinding { func_name: prefix + "." + xb.func_name, iface: xb.iface, wit: xb.wit });
        xi = xi + 1;
    }
    var nimpls: ImplInfo[] = into.impls;
    var nii: i32 = 0;
    while (nii < from.impls.len()) { nimpls = nimpls.append(from.impls[nii]); nii = nii + 1; }
    var ntreqs: TraitReq[] = into.trait_reqs;
    var nti: i32 = 0;
    while (nti < from.trait_reqs.len()) { ntreqs = ntreqs.append(from.trait_reqs[nti]); nti = nti + 1; }
    return Module {
        funcs: nfuncs,
        structs: nstructs,
        aliases: naliases,
        imports: into.imports,
        top_stmts: into.top_stmts,
        enums: concat_enums(into.enums, from.enums),
        resources: nresources,
        exports: nexports,
        impls: nimpls,
        trait_reqs: ntreqs
    };
}

// =================== VALIDATION ====================

function main(): i32 {
    // Source under test:
    //   var x = 1 + 2 * 3;        // x = 7
    //   var y = (1 + 2) * 3;      // y = 9
    //   return x + y;             // returns 16
    var src: string = "var x = 1 + 2 * 3; var y = (1 + 2) * 3; return x + y;";
    var toks: lexer.Token[] = lexer.tokenize(src);
    var prog: Stmt[] = parse_program(toks);
    if (prog.len() != 3) { return 1; }

    // Stmt 0: var x = 1 + 2 * 3   →   StmtVar { name: "x", init: ExprBinary "+" }
    match (prog[0]) {
        StmtVar(s0) => {
            if (s0.name != "x") { return 100; }
            match (s0.init) {
                ExprBinary(b) => {
                    if (b.op != "+") { return 101; }
                    // Right side should be `2 * 3` (binary with op "*").
                    match (b.right) {
                        ExprBinary(rb) => {
                            if (rb.op != "*") { return 102; }
                        },
                        _ => { return 103; }
                    }
                    // Left side should be number 1.
                    match (b.left) {
                        ExprNumber(n) => { if (n.text != "1") { return 104; } },
                        _ => { return 105; }
                    }
                },
                _ => { return 106; }
            }
        },
        _ => { return 107; }
    }

    // Stmt 1: var y = (1 + 2) * 3   →  StmtVar { name: "y", init: ExprBinary "*" }
    match (prog[1]) {
        StmtVar(s1) => {
            if (s1.name != "y") { return 200; }
            match (s1.init) {
                ExprBinary(b) => {
                    if (b.op != "*") { return 201; }
                    // Left side is the grouped `1 + 2` — should
                    // be a `+` binary thanks to the parens.
                    match (b.left) {
                        ExprBinary(lb) => {
                            if (lb.op != "+") { return 202; }
                        },
                        _ => { return 203; }
                    }
                },
                _ => { return 204; }
            }
        },
        _ => { return 205; }
    }

    // Stmt 2: return x + y   →  StmtReturn { value: ExprBinary "+" }
    match (prog[2]) {
        StmtReturn(s2) => {
            match (s2.value) {
                ExprBinary(b) => {
                    if (b.op != "+") { return 300; }
                    match (b.left) {
                        ExprIdent(id) => { if (id.name != "x") { return 301; } },
                        _ => { return 302; }
                    }
                    match (b.right) {
                        ExprIdent(id) => { if (id.name != "y") { return 303; } },
                        _ => { return 304; }
                    }
                },
                _ => { return 305; }
            }
        },
        _ => { return 306; }
    }

    // If-statement parse: `if (x < 0) { var a = 1; } else { var b = 2; }`
    // should produce a single StmtIf with one stmt in each branch.
    var src2: string = "if (x < 0) { var a = 1; } else { var b = 2; }";
    var prog2: Stmt[] = parse_program(lexer.tokenize(src2));
    if (prog2.len() != 1) { return 400; }
    match (prog2[0]) {
        StmtIf(ifs) => {
            // cond: ExprBinary `<`.
            match (ifs.cond) {
                ExprBinary(b) => { if (b.op != "<") { return 401; } },
                _ => { return 402; }
            }
            if (ifs.then_body.len() != 1) { return 403; }
            if (ifs.else_body.len() != 1) { return 404; }
        },
        _ => { return 405; }
    }

    // Else-less if: ensure else_body is empty.
    var src3: string = "if (true) { return 1; }";
    var prog3: Stmt[] = parse_program(lexer.tokenize(src3));
    match (prog3[0]) {
        StmtIf(ifs) => {
            if (ifs.else_body.len() != 0) { return 500; }
        },
        _ => { return 501; }
    }

    // While loop: `while (i < 5) { i = i + 1; }` → one StmtWhile
    // with cond ExprBinary `<` and a single-stmt body (StmtAssign).
    var src4: string = "while (i < 5) { i = i + 1; }";
    var prog4: Stmt[] = parse_program(lexer.tokenize(src4));
    if (prog4.len() != 1) { return 600; }
    match (prog4[0]) {
        StmtWhile(w) => {
            match (w.cond) {
                ExprBinary(b) => { if (b.op != "<") { return 601; } },
                _ => { return 602; }
            }
            if (w.body.len() != 1) { return 603; }
            match (w.body[0]) {
                StmtAssign(a) => {
                    if (a.target != "i") { return 604; }
                    match (a.value) {
                        ExprBinary(b) => { if (b.op != "+") { return 605; } },
                        _ => { return 606; }
                    }
                },
                _ => { return 607; }
            }
        },
        _ => { return 608; }
    }

    // Compound assignment desugar: `x += 1;` should parse as a
    // StmtAssign whose RHS is an ExprBinary("+", ExprIdent("x"),
    // ExprNumber("1")). Confirms the desugar fires.
    var srcC: string = "x += 1;";
    var progC: Stmt[] = parse_program(lexer.tokenize(srcC));
    if (progC.len() != 1) { return 700; }
    match (progC[0]) {
        StmtAssign(a) => {
            if (a.target != "x") { return 701; }
            match (a.value) {
                ExprBinary(b) => {
                    if (b.op != "+") { return 702; }
                    match (b.left) {
                        ExprIdent(id) => { if (id.name != "x") { return 703; } },
                        _ => { return 704; }
                    }
                    match (b.right) {
                        ExprNumber(n) => { if (n.text != "1") { return 705; } },
                        _ => { return 706; }
                    }
                },
                _ => { return 707; }
            }
        },
        _ => { return 708; }
    }

    // `s *= 2;` → same shape with op `*`.
    var srcD: string = "s *= 2;";
    match (parse_program(lexer.tokenize(srcD))[0]) {
        StmtAssign(a) => {
            match (a.value) {
                ExprBinary(b) => { if (b.op != "*") { return 720; } },
                _ => { return 721; }
            }
        },
        _ => { return 722; }
    }

    // Bitwise / shift compounds desugar the same way: `m &= 6;` → op `&`,
    // `f <<= 3;` → op `<<`. Mirrors the native parser's compoundOps set.
    var srcBwAnd: string = "m &= 6;";
    match (parse_program(lexer.tokenize(srcBwAnd))[0]) {
        StmtAssign(a) => {
            match (a.value) {
                ExprBinary(b) => { if (b.op != "&") { return 730; } },
                _ => { return 731; }
            }
        },
        _ => { return 732; }
    }
    var srcBwShl: string = "f <<= 3;";
    match (parse_program(lexer.tokenize(srcBwShl))[0]) {
        StmtAssign(a) => {
            match (a.value) {
                ExprBinary(b) => { if (b.op != "<<") { return 733; } },
                _ => { return 734; }
            }
        },
        _ => { return 735; }
    }

    // Slice parsing: `s[1:4]` → ExprSlice with three subtrees.
    var srcS: string = "var t = s[1:4]; return 0;";
    var progS: Stmt[] = parse_program(lexer.tokenize(srcS));
    match (progS[0]) {
        StmtVar(v) => {
            match (v.init) {
                ExprSlice(sl) => {
                    match (sl.start) {
                        ExprNumber(n) => { if (n.text != "1") { return 650; } },
                        _ => { return 651; }
                    }
                    match (sl.end) {
                        ExprNumber(n) => { if (n.text != "4") { return 652; } },
                        _ => { return 653; }
                    }
                },
                _ => { return 654; }
            }
        },
        _ => { return 655; }
    }

    // Open-ended slice `s[1:]` — the omitted high bound desugars to
    // `s.len()`, so sl.end is a zero-arg call of `s.len` (mirrors the
    // Go parser's nil High → length default).
    var srcOS: string = "var t = s[1:]; return 0;";
    var progOS: Stmt[] = parse_program(lexer.tokenize(srcOS));
    match (progOS[0]) {
        StmtVar(v) => {
            match (v.init) {
                ExprSlice(sl) => {
                    match (sl.start) {
                        ExprNumber(n) => { if (n.text != "1") { return 656; } },
                        _ => { return 657; }
                    }
                    match (sl.end) {
                        ExprCall(c) => {
                            if (c.args.len() != 0) { return 658; }
                            match (c.callee) {
                                ExprFieldAccess(fa) => {
                                    if (fa.field != "len") { return 659; }
                                    match (fa.obj) {
                                        ExprIdent(id) => { if (id.name != "s") { return 660; } },
                                        _ => { return 661; }
                                    }
                                },
                                _ => { return 662; }
                            }
                        },
                        _ => { return 663; }
                    }
                },
                _ => { return 664; }
            }
        },
        _ => { return 665; }
    }

    // parse_module: two function decls, no top-level stmts.
    var src5: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
    var mod: Module = parse_module(lexer.tokenize(src5));
    if (mod.funcs.len() != 2) { return 700; }
    if (mod.top_stmts.len() != 0) { return 701; }
    // add: name, 2 params, ret type i32.
    if (mod.funcs[0].name != "add") { return 702; }
    if (mod.funcs[0].params.len() != 2) { return 703; }
    if (mod.funcs[0].params[0].name != "x") { return 704; }
    if (mod.funcs[0].params[0].type_name != "i32") { return 705; }
    if (mod.funcs[0].ret_type != "i32") { return 706; }
    if (mod.funcs[0].body.len() != 1) { return 707; }
    // main: name, 0 params, ret type i32.
    if (mod.funcs[1].name != "main") { return 708; }
    if (mod.funcs[1].params.len() != 0) { return 709; }
    if (mod.funcs[1].ret_type != "i32") { return 710; }

    // parse_module: struct decls.
    var srcSt: string = "struct Point { x: i32, y: i32 } struct Empty { } function main(): i32 { return 0; }";
    var modSt: Module = parse_module(lexer.tokenize(srcSt));
    if (modSt.structs.len() != 2) { return 720; }
    if (modSt.structs[0].name != "Point") { return 721; }
    if (modSt.structs[0].fields.len() != 2) { return 722; }
    if (modSt.structs[0].fields[0].name != "x") { return 723; }
    if (modSt.structs[0].fields[0].type_name != "i32") { return 724; }
    if (modSt.structs[0].fields[1].name != "y") { return 725; }
    if (modSt.structs[1].name != "Empty") { return 726; }
    if (modSt.structs[1].fields.len() != 0) { return 727; }
    if (modSt.funcs.len() != 1) { return 728; }
    if (modSt.funcs[0].name != "main") { return 729; }

    // A trailing comma after the last struct field must NOT produce a phantom
    // empty-named field (it did — breaking struct-literal field matching in the
    // SSA build_func for any struct written with a trailing comma, e.g. Ctx).
    var srcTc: string = "struct Tc { a: i32, b: i32, } function main(): i32 { return 0; }";
    var modTc: Module = parse_module(lexer.tokenize(srcTc));
    if (modTc.structs.len() != 1) { return 730; }
    if (modTc.structs[0].fields.len() != 2) { return 731; }
    if (modTc.structs[0].fields[1].name != "b") { return 732; }

    // Struct literal: `var p = Point { x: 3, y: 4 };`
    var srcL: string = "var p = Point { x: 3, y: 4 }; return 0;";
    var progL: Stmt[] = parse_program(lexer.tokenize(srcL));
    match (progL[0]) {
        StmtVar(v) => {
            if (v.name != "p") { return 800; }
            match (v.init) {
                ExprStructLit(sl) => {
                    if (sl.type_name != "Point") { return 801; }
                    if (sl.field_names.len() != 2) { return 802; }
                    if (sl.field_names[0] != "x") { return 803; }
                    if (sl.field_names[1] != "y") { return 804; }
                    match (sl.field_values[0]) {
                        ExprNumber(n) => { if (n.text != "3") { return 805; } },
                        _ => { return 806; }
                    }
                },
                _ => { return 807; }
            }
        },
        _ => { return 808; }
    }

    // Field access: `p.x`
    var srcF: string = "return p.x;";
    var progF: Stmt[] = parse_program(lexer.tokenize(srcF));
    match (progF[0]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "x") { return 810; }
                    match (fa.obj) {
                        ExprIdent(id) => { if (id.name != "p") { return 811; } },
                        _ => { return 812; }
                    }
                },
                _ => { return 813; }
            }
        },
        _ => { return 814; }
    }

    // Chained: `Point { x: 1, y: 2 }.x` should parse as
    // ExprFieldAccess { obj: ExprStructLit{...}, field: "x" }.
    var srcCh: string = "return Point { x: 1, y: 2 }.x;";
    var progCh: Stmt[] = parse_program(lexer.tokenize(srcCh));
    match (progCh[0]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "x") { return 820; }
                    match (fa.obj) {
                        ExprStructLit(sl) => { if (sl.type_name != "Point") { return 821; } },
                        _ => { return 822; }
                    }
                },
                _ => { return 823; }
            }
        },
        _ => { return 824; }
    }

    // parse_module: union type aliases.
    //   pub type Shape = Circle | Square | Triangle;
    //   pub type Cell  = Empty | Wall;
    var srcTy: string = "pub type Shape = Circle | Square | Triangle; pub type Cell = Empty | Wall; struct Circle { r: i32 } function main(): i32 { return 0; }";
    var modTy: Module = parse_module(lexer.tokenize(srcTy));
    if (modTy.aliases.len() != 2) { return 830; }
    if (modTy.aliases[0].name != "Shape") { return 831; }
    if (modTy.aliases[0].variants.len() != 3) { return 832; }
    if (modTy.aliases[0].variants[0] != "Circle") { return 833; }
    if (modTy.aliases[0].variants[1] != "Square") { return 834; }
    if (modTy.aliases[0].variants[2] != "Triangle") { return 835; }
    if (modTy.aliases[1].name != "Cell") { return 836; }
    if (modTy.aliases[1].variants.len() != 2) { return 837; }
    if (modTy.aliases[1].variants[0] != "Empty") { return 838; }
    if (modTy.aliases[1].variants[1] != "Wall") { return 839; }
    // Struct + func still parse alongside aliases.
    if (modTy.structs.len() != 1) { return 840; }
    if (modTy.structs[0].name != "Circle") { return 841; }
    if (modTy.funcs.len() != 1) { return 842; }
    if (modTy.funcs[0].name != "main") { return 843; }

    // Single-variant alias is allowed (it's just a type-rename).
    var srcTy2: string = "type Id = Inner;";
    var modTy2: Module = parse_module(lexer.tokenize(srcTy2));
    if (modTy2.aliases.len() != 1) { return 850; }
    if (modTy2.aliases[0].name != "Id") { return 851; }
    if (modTy2.aliases[0].variants.len() != 1) { return 852; }
    if (modTy2.aliases[0].variants[0] != "Inner") { return 853; }

    // Match statement: variant + wildcard arms with bindings.
    //   match (e) {
    //       Circle(c) => { return 1; },
    //       Square(_) => { return 2; },
    //       _ => { return 3; }
    //   }
    var srcMa: string = "match (e) { Circle(c) => { return 1; }, Square(_) => { return 2; }, _ => { return 3; } }";
    var progMa: Stmt[] = parse_program(lexer.tokenize(srcMa));
    if (progMa.len() != 1) { return 900; }
    match (progMa[0]) {
        StmtMatch(m) => {
            match (m.scrutinee) {
                ExprIdent(id) => { if (id.name != "e") { return 901; } },
                _ => { return 902; }
            }
            if (m.arms.len() != 3) { return 903; }
            // Arm 0: Circle(c) => { return 1; }
            match (m.arms[0].pattern) {
                PatVariant(pv) => {
                    if (pv.type_name != "Circle") { return 904; }
                    if (pv.binding != "c") { return 905; }
                },
                _ => { return 906; }
            }
            if (m.arms[0].body.len() != 1) { return 907; }
            // Arm 1: Square(_) => { return 2; }
            match (m.arms[1].pattern) {
                PatVariant(pv) => {
                    if (pv.type_name != "Square") { return 908; }
                    if (pv.binding != "_") { return 909; }
                },
                _ => { return 910; }
            }
            // Arm 2: _ => { return 3; }
            match (m.arms[2].pattern) {
                PatWildcard(_) => { },
                _ => { return 911; }
            }
        },
        _ => { return 912; }
    }

    // Bare variant pattern (no parens, no binding): `Foo => { ... }`.
    var srcMb: string = "match (x) { Foo => { return 1; }, _ => { return 0; } }";
    var progMb: Stmt[] = parse_program(lexer.tokenize(srcMb));
    match (progMb[0]) {
        StmtMatch(m) => {
            if (m.arms.len() != 2) { return 920; }
            match (m.arms[0].pattern) {
                PatVariant(pv) => {
                    if (pv.type_name != "Foo") { return 921; }
                    if (pv.binding != "") { return 922; }
                },
                _ => { return 923; }
            }
        },
        _ => { return 924; }
    }

    // Var type annotation — user type (Shape).
    var srcTV: string = "var sh: Shape = c; return 0;";
    var progTV: Stmt[] = parse_program(lexer.tokenize(srcTV));
    match (progTV[0]) {
        StmtVar(v) => {
            if (v.name != "sh") { return 930; }
            if (v.type_name != "Shape") { return 931; }
        },
        _ => { return 932; }
    }

    // Var type annotation — primitive (i32).
    var srcTI: string = "var n: i32 = 7; return 0;";
    var progTI: Stmt[] = parse_program(lexer.tokenize(srcTI));
    match (progTI[0]) {
        StmtVar(v) => {
            if (v.name != "n") { return 940; }
            if (v.type_name != "i32") { return 941; }
        },
        _ => { return 942; }
    }

    // Var without annotation — type_name stays empty.
    var srcTU: string = "var x = 42; return 0;";
    var progTU: Stmt[] = parse_program(lexer.tokenize(srcTU));
    match (progTU[0]) {
        StmtVar(v) => {
            if (v.name != "x") { return 950; }
            if (v.type_name != "") { return 951; }
        },
        _ => { return 952; }
    }

    // Receiver method — `function (p: Par) advance(): Par { … }`.
    // Captures the receiver name + type alongside the method
    // name; the param list and return type behave normally.
    var srcRM: string = "function (p: Par) advance(n: i32): Par { return p; }";
    var modRM: Module = parse_module(lexer.tokenize(srcRM));
    if (modRM.funcs.len() != 1) { return 960; }
    if (modRM.funcs[0].name != "advance") { return 961; }
    if (modRM.funcs[0].receiver_name != "p") { return 962; }
    if (modRM.funcs[0].receiver_type != "Par") { return 963; }
    if (modRM.funcs[0].params.len() != 1) { return 964; }
    if (modRM.funcs[0].params[0].name != "n") { return 965; }
    if (modRM.funcs[0].ret_type != "Par") { return 966; }

    // Plain function — receiver fields stay empty.
    var srcRP: string = "function add(a: i32, b: i32): i32 { return a + b; }";
    var modRP: Module = parse_module(lexer.tokenize(srcRP));
    if (modRP.funcs.len() != 1) { return 970; }
    if (modRP.funcs[0].name != "add") { return 971; }
    if (modRP.funcs[0].receiver_name != "") { return 972; }
    if (modRP.funcs[0].receiver_type != "") { return 973; }

    // Receiver method with zero-arg param list — still parses
    // cleanly. `function (s: Scope) is_empty(): bool { … }`.
    var srcR0: string = "function (s: Scope) is_empty(): bool { return false; }";
    var modR0: Module = parse_module(lexer.tokenize(srcR0));
    if (modR0.funcs.len() != 1) { return 980; }
    if (modR0.funcs[0].name != "is_empty") { return 981; }
    if (modR0.funcs[0].receiver_name != "s") { return 982; }
    if (modR0.funcs[0].receiver_type != "Scope") { return 983; }
    if (modR0.funcs[0].params.len() != 0) { return 984; }

    // Top-level imports: `import "./lexer"; import "./parser";`.
    // Both get captured into mod.imports as Import entries.
    var srcIm: string = "import \"./lexer\"; import \"./parser\"; function main(): i32 { return 0; }";
    var modIm: Module = parse_module(lexer.tokenize(srcIm));
    if (modIm.imports.len() != 2) { return 990; }
    if (modIm.imports[0].path != "./lexer") { return 991; }
    if (modIm.imports[1].path != "./parser") { return 992; }
    if (modIm.funcs.len() != 1) { return 993; }
    if (modIm.funcs[0].name != "main") { return 994; }

    // Module without imports — list stays empty.
    var srcIp: string = "function main(): i32 { return 0; }";
    var modIp: Module = parse_module(lexer.tokenize(srcIp));
    if (modIp.imports.len() != 0) { return 1000; }

    // For-in loop: `for x in arr { … }` parses as StmtFor with
    // var_name + iter + body.
    var srcFor: string = "for x in arr { var y = x + 1; }";
    var progFor: Stmt[] = parse_program(lexer.tokenize(srcFor));
    if (progFor.len() != 1) { return 1010; }
    match (progFor[0]) {
        StmtFor(fs) => {
            if (fs.var_name != "x") { return 1011; }
            match (fs.iter) {
                ExprIdent(id) => { if (id.name != "arr") { return 1012; } },
                _ => { return 1013; }
            }
            if (fs.body.len() != 1) { return 1014; }
        },
        _ => { return 1015; }
    }

    // For-in with array literal as iter.
    var srcFor2: string = "for n in [1, 2, 3] { n; }";
    var progFor2: Stmt[] = parse_program(lexer.tokenize(srcFor2));
    match (progFor2[0]) {
        StmtFor(fs) => {
            if (fs.var_name != "n") { return 1020; }
            match (fs.iter) {
                ExprArray(a) => { if (a.elements.len() != 3) { return 1021; } },
                _ => { return 1022; }
            }
        },
        _ => { return 1023; }
    }

    // Tuple literal: `(1, 2, 3)` parses as ExprTuple with 3
    // elements. Single-arg paren stays grouping.
    var srcTu: string = "var t = (1, 2, 3); return 0;";
    var progTu: Stmt[] = parse_program(lexer.tokenize(srcTu));
    match (progTu[0]) {
        StmtVar(v) => {
            match (v.init) {
                ExprTuple(t) => {
                    if (t.elements.len() != 3) { return 1030; }
                    match (t.elements[0]) {
                        ExprNumber(n) => { if (n.text != "1") { return 1031; } },
                        _ => { return 1032; }
                    }
                },
                _ => { return 1033; }
            }
        },
        _ => { return 1034; }
    }

    // Grouping stays grouping when there's no comma.
    var srcGr: string = "var g = (1 + 2); return 0;";
    var progGr: Stmt[] = parse_program(lexer.tokenize(srcGr));
    match (progGr[0]) {
        StmtVar(v) => {
            match (v.init) {
                ExprBinary(b) => { if (b.op != "+") { return 1040; } },
                _ => { return 1041; }
            }
        },
        _ => { return 1042; }
    }

    // Tuple with heterogeneous elements (number + string).
    var srcTH: string = "var t = (1, \"hi\"); return 0;";
    var progTH: Stmt[] = parse_program(lexer.tokenize(srcTH));
    match (progTH[0]) {
        StmtVar(v) => {
            match (v.init) {
                ExprTuple(t) => {
                    if (t.elements.len() != 2) { return 1050; }
                    match (t.elements[1]) {
                        ExprString(s) => { if (s.value != "hi") { return 1051; } },
                        _ => { return 1052; }
                    }
                },
                _ => { return 1053; }
            }
        },
        _ => { return 1054; }
    }

    // Postfix on a tuple literal: `(1, 2, 3).0` parses as
    // ExprFieldAccess(ExprTuple(…), "0"). The postfix loop is
    // now shared across primary shapes so this round-trips.
    var srcTp: string = "return (10, 20, 30).1;";
    var progTp: Stmt[] = parse_program(lexer.tokenize(srcTp));
    match (progTp[0]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprFieldAccess(fa) => {
                    if (fa.field != "1") { return 1055; }
                    match (fa.obj) {
                        ExprTuple(t) => { if (t.elements.len() != 3) { return 1056; } },
                        _ => { return 1057; }
                    }
                },
                _ => { return 1058; }
            }
        },
        _ => { return 1059; }
    }

    // break / continue stmts.
    var srcBC: string = "while (true) { if (x > 10) { break; } if (x < 0) { continue; } }";
    var progBC: Stmt[] = parse_program(lexer.tokenize(srcBC));
    if (progBC.len() != 1) { return 1060; }
    match (progBC[0]) {
        StmtWhile(w) => {
            if (w.body.len() != 2) { return 1061; }
            match (w.body[0]) {
                StmtIf(ifs) => {
                    match (ifs.then_body[0]) {
                        StmtBreak(_) => { },
                        _ => { return 1062; }
                    }
                },
                _ => { return 1063; }
            }
            match (w.body[1]) {
                StmtIf(ifs) => {
                    match (ifs.then_body[0]) {
                        StmtContinue(_) => { },
                        _ => { return 1064; }
                    }
                },
                _ => { return 1065; }
            }
        },
        _ => { return 1066; }
    }

    // Generic type-name parsing — `Map[K, V]` in a param
    // captures the full spelling as a single string.
    var srcGT: string = "function lookup(m: Map[string, i32], k: string): i32 { return 0; }";
    var modGT: Module = parse_module(lexer.tokenize(srcGT));
    if (modGT.funcs.len() != 1) { return 1080; }
    if (modGT.funcs[0].params[0].type_name != "Map[string, i32]") { return 1081; }
    if (modGT.funcs[0].params[1].type_name != "string") { return 1082; }

    // Generic ret_type spelling captured through parse_type_name.
    var srcGR: string = "function fresh(): Map[string, i32] { return null; }";
    var modGR: Module = parse_module(lexer.tokenize(srcGR));
    if (modGR.funcs[0].ret_type != "Map[string, i32]") { return 1083; }

    // Generic struct field type.
    var srcGS: string = "struct Cache { entries: Map[string, i32] } function main(): i32 { return 0; }";
    var modGS: Module = parse_module(lexer.tokenize(srcGS));
    if (modGS.structs.len() != 1) { return 1084; }
    if (modGS.structs[0].fields[0].type_name != "Map[string, i32]") { return 1085; }

    // BOUNDED type params are recorded on FuncDecl.type_params for the
    // monomorphiser; UNBOUNDED ones stay erased (empty). See docs/TRAITS.md.
    var srcBT: string = "function same[T: Eq + Display](a: T, b: T): i32 { return 0; }";
    var modBT: Module = parse_module(lexer.tokenize(srcBT));
    if (modBT.funcs[0].type_params.len() != 1) { return 1086; }
    if (modBT.funcs[0].type_params[0] != "T") { return 1087; }
    // The bound list is consumed; the param type stays the bare `T`.
    if (modBT.funcs[0].params[0].type_name != "T") { return 1088; }
    var srcUT: string = "function id[T](x: T): T { return x; }";
    var modUT: Module = parse_module(lexer.tokenize(srcUT));
    if (modUT.funcs[0].type_params.len() != 0) { return 1089; }

    // Module merge — flat-concatenate decls from a "main"
    // module with an "imported" module's decls.
    var mainSrc: string = "import \"./greet\"; function main(): i32 { return hello(); }";
    var greetSrc: string = "pub function hello(): i32 { return 42; }";
    var mainMod: Module = parse_module(lexer.tokenize(mainSrc));
    var greetMod: Module = parse_module(lexer.tokenize(greetSrc));
    var merged: Module = merge_module(mainMod, greetMod);
    if (merged.funcs.len() != 2) { return 1090; }
    // Order: mainMod.funcs first, then greetMod.funcs appended.
    if (merged.funcs[0].name != "main") { return 1091; }
    if (merged.funcs[1].name != "hello") { return 1092; }
    // imports + top_stmts come from `into` only.
    if (merged.imports.len() != 1) { return 1093; }

    // Prefixed merge — same imports but each decl renamed to
    // `prefix.name`. Models cross-file flat-namespace
    // resolution: `parser.parse_module` → function literally
    // named "parser.parse_module".
    var pSrc: string = "pub function parse_module(): i32 { return 1; } pub struct Token { v: i32 }";
    var pMod: Module = parse_module(lexer.tokenize(pSrc));
    var withImp: Module = merge_module_prefixed(mainMod, pMod, "parser");
    if (withImp.funcs.len() != 2) { return 1094; }
    if (withImp.funcs[1].name != "parser.parse_module") { return 1095; }
    if (withImp.structs.len() != 1) { return 1096; }
    if (withImp.structs[0].name != "parser.Token") { return 1097; }

    // Generic var-annotation.
    var srcGV: string = "var m: Map[string, i32] = a; return 0;";
    var progGV: Stmt[] = parse_program(lexer.tokenize(srcGV));
    match (progGV[0]) {
        StmtVar(v) => {
            if (v.type_name != "Map[string, i32]") { return 1086; }
        },
        _ => { return 1087; }
    }

    // Lambda expression: `function (x: i32): i32 { return x + 1; }`.
    var srcLm: string = "var f = function (x: i32): i32 { return x + 1; }; return 0;";
    var progLm: Stmt[] = parse_program(lexer.tokenize(srcLm));
    match (progLm[0]) {
        StmtVar(v) => {
            match (v.init) {
                ExprLambda(lm) => {
                    if (lm.params.len() != 1) { return 1070; }
                    if (lm.params[0].name != "x") { return 1071; }
                    if (lm.params[0].type_name != "i32") { return 1072; }
                    if (lm.ret_type != "i32") { return 1073; }
                    if (lm.body.len() != 1) { return 1074; }
                },
                _ => { return 1075; }
            }
        },
        _ => { return 1076; }
    }

    // f-string desugar: `return f"x={x}";` lowers to
    //   "x=" + (x).to_string()
    // i.e. ExprBinary("+", ExprString("x="),
    //        ExprCall{ callee: ExprFieldAccess{ obj: ExprIdent("x"),
    //                                            field: "to_string" } }).
    var srcFs: string = "return f\"x={x}\";";
    var progFs: Stmt[] = parse_program(lexer.tokenize(srcFs));
    match (progFs[0]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprBinary(b) => {
                    if (b.op != "+") { return 1100; }
                    match (b.left) {
                        ExprString(s) => { if (s.value != "x=") { return 1101; } },
                        _ => { return 1102; }
                    }
                    match (b.right) {
                        ExprCall(call) => {
                            match (call.callee) {
                                ExprFieldAccess(fa) => {
                                    if (fa.field != "to_string") { return 1103; }
                                    match (fa.obj) {
                                        ExprIdent(id) => { if (id.name != "x") { return 1104; } },
                                        _ => { return 1105; }
                                    }
                                },
                                _ => { return 1106; }
                            }
                        },
                        _ => { return 1107; }
                    }
                },
                _ => { return 1108; }
            }
        },
        _ => { return 1109; }
    }

    // Empty f-string desugars to the empty string literal.
    match (parse_program(lexer.tokenize("return f\"\";"))[0]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprString(s) => { if (s.value != "") { return 1110; } },
                _ => { return 1111; }
            }
        },
        _ => { return 1112; }
    }

    // Literal-only f-string desugars to a single string literal.
    match (parse_program(lexer.tokenize("return f\"hi\";"))[0]) {
        StmtReturn(r) => {
            match (r.value) {
                ExprString(s) => { if (s.value != "hi") { return 1113; } },
                _ => { return 1114; }
            }
        },
        _ => { return 1115; }
    }

    // Qualified type names in struct fields: `lexer.Token` (and the
    // array form `lexer.Token[]`). Before the parse_type_name fix
    // the stray `.` parked the field loop and the parser spun until
    // OOM — fatal for parsing parser.fern's own source. Assert the
    // field type-name strings round-trip the qualifier (and the
    // unqualified array form still works).
    var srcQ: string = "struct Par { toks: lexer.Token[], cur: parser.Node, n: i32 } function main(): i32 { return 0; }";
    var modQ: Module = parse_module(lexer.tokenize(srcQ));
    if (modQ.structs.len() != 1) { return 1120; }
    if (modQ.structs[0].name != "Par") { return 1121; }
    if (modQ.structs[0].fields.len() != 3) { return 1122; }
    if (modQ.structs[0].fields[0].type_name != "lexer.Token[]") { return 1123; }
    if (modQ.structs[0].fields[1].type_name != "parser.Node") { return 1124; }
    if (modQ.structs[0].fields[2].type_name != "i32") { return 1125; }
    if (modQ.funcs.len() != 1) { return 1126; }

    // Qualified type as a param + return type.
    var srcQ2: string = "function f(t: lexer.Token): lexer.Token { return t; }";
    var modQ2: Module = parse_module(lexer.tokenize(srcQ2));
    if (modQ2.funcs.len() != 1) { return 1130; }
    if (modQ2.funcs[0].params.len() != 1) { return 1131; }
    if (modQ2.funcs[0].params[0].type_name != "lexer.Token") { return 1132; }
    if (modQ2.funcs[0].ret_type != "lexer.Token") { return 1133; }

    // Qualified variant patterns in a match: `lexer.TokNumber(n)`.
    // Before the parse_pattern fix the stray `.` parked the arm loop
    // and the parser spun until OOM — fatal for parsing parser.fern's
    // own `match (t) { lexer.TokX(x) => … }` statements.
    var srcM: string = "match (t) { lexer.TokNumber(n) => { x = 1; }, _ => { x = 0; } }";
    var progM: Stmt[] = parse_program(lexer.tokenize(srcM));
    if (progM.len() != 1) { return 1140; }
    match (progM[0]) {
        StmtMatch(m) => {
            if (m.arms.len() != 2) { return 1141; }
            match (m.arms[0].pattern) {
                PatVariant(pv) => {
                    if (pv.type_name != "lexer.TokNumber") { return 1142; }
                    if (pv.binding != "n") { return 1143; }
                },
                _ => { return 1144; }
            }
            match (m.arms[1].pattern) {
                PatWildcard(_) => { },
                _ => { return 1145; }
            }
        },
        _ => { return 1146; }
    }

    return 0;
}
