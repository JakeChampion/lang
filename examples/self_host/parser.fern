            var no_tup_kinds: i32[] = [];
            var no_tup_binds: string[] = [];
            var no_tup_lits: Expr[] = [];
            var no_tup_pats: Pattern[] = [];
            var le_pat: Pattern = PatVariant { type_name: name, binding: le_binding, extra_bindings: le_extra, nested: le_no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
            var le_arms: MatchArm[] = [];
