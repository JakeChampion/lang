            if (p.peek_punct() == "=") { p = p.advance(); }
            var (tdinit_expr, tdinit_p) = parse_expr(p);
            p = tdinit_p;
            if (p.peek_punct() == ";") { p = p.advance(); }
            return (s_var_at(tdnames, "", tdinit_expr, vline, vcol), p);
        }
        var name: string = p.peek_ident();
        if (name.len() == 0) {
            return (s_unknown("missing var name"), p);
        }
        // The cursor still ON the head, for the let-else pattern parse below —
        // parse_pattern wants to read the name itself.
        var le_pat_start: Par = p;
        p = p.advance();
        // Struct destructure `var Point { x, y } = E;` / `let Point { … } = E;`
        // — `name` is the struct type, the `{` opens the field pattern. A
        // record-form variant is spelled the same way here, but native rejects
        // `let Rect { w, h } = E else …` at parse time, so it stays a struct
        // destructure (and the same rejection) rather than becoming self-host-
        // only surface. `if let` accepts the record form on both, via
        // parse_pattern.
        if (p.peek_punct() == "{") {
            return parse_struct_destructure(p, name, vline, vcol);
        }
        // `let PAT = E else { … }` with a pattern-shaped head takes the shared
        // grammar: parse_pattern gives it nested payloads, `@` bindings and
        // or-patterns, the same forms `if let` and the match arms accept.
        //
        // A head spelled `NAME(`, `NAME@` or `NAME|` is never a plain binding,
        // but only an `else` makes it a let-else, and that keyword sits past
        // the initializer. Par is a value, so the whole head is parsed
        // speculatively and thrown away when no `else` follows, leaving the
        // original cursor to the paths below.
        if (p.peek_punct() == "(" || p.peek_punct() == "@" || p.peek_punct() == "|") {
            var (lsp_pat, lsp_p) = parse_pattern(le_pat_start);
