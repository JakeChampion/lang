                lsp_pats = lsp_pats.append(lsp_alt);
            }
            if (lsp_p.peek_punct() == "=") {
                lsp_p = lsp_p.advance();
                var (lsp_init, lsp_ip) = parse_expr(lsp_p);
                lsp_p = lsp_ip;
