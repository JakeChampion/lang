// examples/self_host/ssa_x86.fern — an SSA → x86-64 (Linux, AT&T syntax)
// code generator. This is the start of the endgame for the self-hosted
// compiler: today the backends emit straight from the AST (asm.fern,
// asm_arm64.fern); this lowers the optimised SSA from ssa.fern to machine
// code instead, so the backends can eventually be rebuilt on the SSA +
// optimiser pipeline (AST → SSA → optimise → emit) and the AST emitters
// retired.
//
// Strategy (slice 8 — the i32 subset that build_func handles): no register
// allocation yet. Every SSA value gets an 8-byte stack slot; instructions
// load operands into scratch registers (%eax / %ecx), compute, and store
// the result back to its slot. Correct and simple; a register allocator is
// a later slice. SSA is taken out of phi form by inserting copies on the
// predecessor edges (every phi block is entered only by an unconditional
// `br` in our construction, so no critical-edge splitting is needed).
//
// The framing mirrors asm.fern: functions are labelled `__fn_<name>`, and
// `_start` calls `__fn_main` and exits with its return value (syscall 60).

import "./ssa";
import "./util";

// str_join_range concatenates parts[lo..hi) by balanced divide-and-conquer.
// A left fold (out = out + parts[i]) copies the whole accumulator on every
// append → O(total²) when emitting a large program; this splits the range in
// half and merges, so each of the log n levels copies O(total) → O(total·log n)
// overall. (Array push is amortised O(1), but string concat is O(len), so the
// emit hot path collects chunks in a string[] and joins once through here.)
function str_join_range(parts: string[], lo: i32, hi: i32): string {
    var n: i32 = hi - lo;
    if (n <= 0) { return ""; }
    if (n == 1) { return parts[lo]; }
    var mid: i32 = lo + n / 2;
    return str_join_range(parts, lo, mid) + str_join_range(parts, mid, hi);
}
function str_join_chunks(parts: string[]): string {
    return str_join_range(parts, 0, parts.len());
}

// slot returns the AT&T memory operand for SSA value v's stack slot.
function slot(v: i32): string {
    return "-" + util.i32_to_string(8 * (v + 1)) + "(%rbp)";
}

// argreg32 maps a parameter index to its System V 32-bit argument register.
function argreg32(i: i32): string {
    if (i == 0) { return "%edi"; }
    if (i == 1) { return "%esi"; }
    if (i == 2) { return "%edx"; }
    if (i == 3) { return "%ecx"; }
    if (i == 4) { return "%r8d"; }
    return "%r9d";
}
// argreg64 is the 64-bit view of the argument registers, for pointer args.
function argreg64(i: i32): string {
    if (i == 0) { return "%rdi"; }
    if (i == 1) { return "%rsi"; }
    if (i == 2) { return "%rdx"; }
    if (i == 3) { return "%rcx"; }
    if (i == 4) { return "%r8"; }
    return "%r9";
}
function argreg_w(i: i32, width: i32): string {
    if (width == 64) { return argreg64(i); }
    return argreg32(i);
}

// regname maps an allocatable register index to its x86-64 32-bit name. We
// use the caller-saved %r10d / %r11d — never used as computation scratch
// (%eax/%ecx), as argument registers, or clobbered by idiv (%edx). Since
// regalloc force-spills any value live across a call, these need no
// save/restore.
function regname(k: i32): string {
    if (k == 0) { return "%r10d"; }
    return "%r11d";
}
// regname64 is the 64-bit view, used for pointer-width (alloc-derived)
// values so they round-trip all eight bytes.
function regname64(k: i32): string {
    if (k == 0) { return "%r10"; }
    return "%r11";
}
function nregs(): i32 { return 2; }

// w_mov / xreg pick the move mnemonic and scratch-register name for a
// value's width (32 → movl/%eax, 64 → movq/%rax).
function w_mov(width: i32): string { if (width == 64) { return "movq"; } return "movl"; }
function xreg(cls: string, width: i32): string {
    if (cls == "a") { if (width == 64) { return "%rax"; } return "%eax"; }
    if (cls == "c") { if (width == 64) { return "%rcx"; } return "%ecx"; }
    return "%rdx";
}

// regn returns where SSA value v lives at the given width — its register
// name (width-correct) if allocated, else its 8-byte stack slot.
function regn(reg_of: i32[], v: i32, width: i32): string {
    if (reg_of[v] >= 0) { if (width == 64) { return regname64(reg_of[v]); } return regname(reg_of[v]); }
    return slot(v);
}
// load_op moves SSA value v into scratch register class `cls`, picking the
// width from `widths`. store_res is the reverse.
function load_op(reg_of: i32[], widths: i32[], v: i32, cls: string, out: string): string {
    var w: i32 = widths[v];
    return out + "    " + w_mov(w) + " " + regn(reg_of, v, w) + ", " + xreg(cls, w) + "\n";
}
function store_res(reg_of: i32[], widths: i32[], v: i32, cls: string, out: string): string {
    var w: i32 = widths[v];
    return out + "    " + w_mov(w) + " " + xreg(cls, w) + ", " + regn(reg_of, v, w) + "\n";
}

function block_index(f: ssa.SFunc, id: i32): i32 {
    var i: i32 = 0;
    while (i < f.blocks.len()) {
        if (f.blocks[i].id == id) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
function pred_slot(blk: ssa.SBlock, prev: i32): i32 {
    var i: i32 = 0;
    while (i < blk.preds.len()) {
        if (blk.preds[i] == prev) { return i; }
        i = i + 1;
    }
    return 0;
}

// emit_binary emits a binary op assuming %eax/%rax = lhs and %ecx/%rcx = rhs
// (per `width`), leaving the result in %eax/%rax. `width` is the OPERANDS'
// width: 64 selects the q-suffixed instructions and 64-bit registers so i64
// arithmetic doesn't truncate. A comparison still leaves an i32 0/1 in %eax
// (the caller stores it at the result's own — i32 — width), but it compares the
// full 64-bit operands (cmpq) when they are i64.
function emit_binary(op: string, width: i32, out: string): string {
    if (width == 64) {
        var a: string = "%rax"; var c: string = "%rcx";
        if (op == "+") { return out + "    addq " + c + ", " + a + "\n"; }
        if (op == "-") { return out + "    subq " + c + ", " + a + "\n"; }
        if (op == "*") { return out + "    imulq " + c + ", " + a + "\n"; }
        if (op == "/") { return out + "    cqto\n    idivq " + c + "\n"; }
        if (op == "%") { return out + "    cqto\n    idivq " + c + "\n    movq %rdx, %rax\n"; }
        if (op == "&") { return out + "    andq " + c + ", " + a + "\n"; }
        if (op == "|") { return out + "    orq " + c + ", " + a + "\n"; }
        if (op == "^") { return out + "    xorq " + c + ", " + a + "\n"; }
        if (op == "<<") { return out + "    salq %cl, " + a + "\n"; }
        if (op == ">>") { return out + "    sarq %cl, " + a + "\n"; }
        // Comparisons on 64-bit operands (cmpq); result is an i32 0/1 in %eax.
        if (op == "==") { return out + "    cmpq " + c + ", " + a + "\n    sete %al\n    movzbl %al, %eax\n"; }
        if (op == "!=") { return out + "    cmpq " + c + ", " + a + "\n    setne %al\n    movzbl %al, %eax\n"; }
        if (op == "<") { return out + "    cmpq " + c + ", " + a + "\n    setl %al\n    movzbl %al, %eax\n"; }
        if (op == "<=") { return out + "    cmpq " + c + ", " + a + "\n    setle %al\n    movzbl %al, %eax\n"; }
        if (op == ">") { return out + "    cmpq " + c + ", " + a + "\n    setg %al\n    movzbl %al, %eax\n"; }
        if (op == ">=") { return out + "    cmpq " + c + ", " + a + "\n    setge %al\n    movzbl %al, %eax\n"; }
        if (op == "&&") {
            return out + "    testq " + a + ", " + a + "\n    setne %al\n    movzbl %al, %eax\n    testq " + c + ", " + c + "\n    setne %cl\n    movzbl %cl, %ecx\n    andl %ecx, %eax\n";
        }
        if (op == "||") {
            return out + "    testq " + a + ", " + a + "\n    setne %al\n    movzbl %al, %eax\n    testq " + c + ", " + c + "\n    setne %cl\n    movzbl %cl, %ecx\n    orl %ecx, %eax\n";
        }
        return out;
    }
    if (op == "+") { return out + "    addl %ecx, %eax\n"; }
    if (op == "-") { return out + "    subl %ecx, %eax\n"; }
    if (op == "*") { return out + "    imull %ecx, %eax\n"; }
    if (op == "/") { return out + "    cltd\n    idivl %ecx\n"; }
    if (op == "%") { return out + "    cltd\n    idivl %ecx\n    movl %edx, %eax\n"; }
    if (op == "&") { return out + "    andl %ecx, %eax\n"; }
    if (op == "|") { return out + "    orl %ecx, %eax\n"; }
    if (op == "^") { return out + "    xorl %ecx, %eax\n"; }
    if (op == "<<") { return out + "    sall %cl, %eax\n"; }
    if (op == ">>") { return out + "    sarl %cl, %eax\n"; }
    // Comparisons: cmpl computes %eax - %ecx; set the byte then zero-extend.
    if (op == "==") { return out + "    cmpl %ecx, %eax\n    sete %al\n    movzbl %al, %eax\n"; }
    if (op == "!=") { return out + "    cmpl %ecx, %eax\n    setne %al\n    movzbl %al, %eax\n"; }
    if (op == "<") { return out + "    cmpl %ecx, %eax\n    setl %al\n    movzbl %al, %eax\n"; }
    if (op == "<=") { return out + "    cmpl %ecx, %eax\n    setle %al\n    movzbl %al, %eax\n"; }
    if (op == ">") { return out + "    cmpl %ecx, %eax\n    setg %al\n    movzbl %al, %eax\n"; }
    if (op == ">=") { return out + "    cmpl %ecx, %eax\n    setge %al\n    movzbl %al, %eax\n"; }
    // Logical &&/|| — normalise both sides to 0/1 then bitwise combine.
    if (op == "&&") {
        return out + "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n    testl %ecx, %ecx\n    setne %cl\n    movzbl %cl, %ecx\n    andl %ecx, %eax\n";
    }
    if (op == "||") {
        return out + "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n    testl %ecx, %ecx\n    setne %cl\n    movzbl %cl, %ecx\n    orl %ecx, %eax\n";
    }
    return out;
}

// fconst_label is the .rodata label for a const_float value (unique per
// function + value id), holding the f64 bits the assembler computes from the
// literal text.
function fconst_label(fname: string, result: i32): string {
    return ".LCf_" + fname + "_" + util.i32_to_string(result);
}

// sconst_label is the .data label for a const_str value (a static
// [len, b0, b1, …] string, one 8-byte word per element — matching the heap
// string layout the runtime helpers read).
function sconst_label(fname: string, result: i32): string {
    return ".LCs_" + fname + "_" + util.i32_to_string(result);
}

// fsetcc maps a float comparison operator to its x86 set-condition mnemonic.
// ucomisd %xmm1, %xmm0 sets CF when xmm0 < xmm1 (the lhs), so the unsigned
// (b/a) conditions read as the signed float relations on lhs vs rhs.
function fsetcc(op: string): string {
    if (op == "<") { return "setb"; }
    if (op == "<=") { return "setbe"; }
    if (op == ">") { return "seta"; }
    if (op == ">=") { return "setae"; }
    if (op == "==") { return "sete"; }
    return "setne";
}

// fbinop maps a float arithmetic operator to its SSE2 instruction.
function fbinop(op: string): string {
    if (op == "+") { return "addsd"; }
    if (op == "-") { return "subsd"; }
    if (op == "*") { return "mulsd"; }
    return "divsd";
}

// emit_inst lowers a single value-defining instruction. param and phi are
// handled elsewhere (prologue / edge copies) and skipped here. isfloat marks
// f64 values (always stack-spilled in a float function, so slot() is their
// home); fname names the function for const_float .rodata labels.
function emit_inst(ins: ssa.SInst, reg_of: i32[], widths: i32[], isfloat: i32[], fname: string, out: string): string {
    if (ins.kind_tag == 4) {  // const_float
        out = out + "    movsd " + fconst_label(fname, ins.result) + "(%rip), %xmm0\n";
        return out + "    movsd %xmm0, " + slot(ins.result) + "\n";
    }
    if (ins.kind_tag == 5) {  // const_str
        // Pointer to the static [len, bytes…] string constant (64-bit; stored
        // via store_res so it honours the value's register/slot home).
        out = out + "    leaq " + sconst_label(fname, ins.result) + "(%rip), %rax\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 1 || ins.kind_tag == 2) {
        return out + "    movl $" + util.i32_to_string(ins.imm) + ", " + regn(reg_of, ins.result, 32) + "\n";
    }
    if (ins.kind_tag == 3) {  // const_i64
        // A 64-bit integer literal: splice the source text straight into a
        // movabsq (the assembler parses the full-width immediate), then store at
        // the value's 64-bit home. compute_widths marks this value 64-bit.
        out = out + "    movabsq $" + ins.str + ", %rax\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 7) {  // copy
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 9) {  // binary
        // Float arithmetic (result is f64) and float comparison (f64 operands,
        // i32 result) use SSE2 over the values' stack slots.
        if (isfloat[ins.result] == 1) {
            out = out + "    movsd " + slot(ins.args[0]) + ", %xmm0\n";
            out = out + "    movsd " + slot(ins.args[1]) + ", %xmm1\n";
            out = out + "    " + fbinop(ins.str) + " %xmm1, %xmm0\n";
            return out + "    movsd %xmm0, " + slot(ins.result) + "\n";
        }
        if (isfloat[ins.args[0]] == 1) {
            out = out + "    movsd " + slot(ins.args[0]) + ", %xmm0\n";
            out = out + "    movsd " + slot(ins.args[1]) + ", %xmm1\n";
            out = out + "    ucomisd %xmm1, %xmm0\n    " + fsetcc(ins.str) + " %al\n    movzbl %al, %eax\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        out = load_op(reg_of, widths, ins.args[1], "c", out);
        // Operand width (not result width) selects 32- vs 64-bit instructions:
        // an i64 comparison compares 64-bit operands (cmpq) but yields an i32.
        out = emit_binary(ins.str, widths[ins.args[0]], out);
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 10) {  // unary
        // f64 negation: 0.0 - x.
        if (ins.str == "-" && isfloat[ins.args[0]] == 1) {
            out = out + "    movsd " + slot(ins.args[0]) + ", %xmm0\n";
            out = out + "    pxor %xmm1, %xmm1\n    subsd %xmm0, %xmm1\n";
            return out + "    movsd %xmm1, " + slot(ins.result) + "\n";
        }
        // i32 → f64.
        if (ins.str == "as_f64") {
            out = out + "    cvtsi2sdl " + slot(ins.args[0]) + ", %xmm0\n";
            return out + "    movsd %xmm0, " + slot(ins.result) + "\n";
        }
        // f64 → i32 (truncating); a non-float `as i32` is an identity copy.
        if (ins.str == "as_i32") {
            if (isfloat[ins.args[0]] == 1) {
                out = out + "    cvttsd2si " + slot(ins.args[0]) + ", %eax\n";
                return out + "    movl %eax, " + regn(reg_of, ins.result, 32) + "\n";
            }
            out = load_op(reg_of, widths, ins.args[0], "a", out);
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        // f64_bits / f64_from_bits — bit reinterpret. The 8-byte slot already
        // holds the IEEE pattern; move it unchanged (int<->float share the
        // slot). f64 operands force regalloc_none, so both ends are slots.
        if (ins.str == "f64_bits" || ins.str == "f64_from_bits") {
            out = out + "    movq " + slot(ins.args[0]) + ", %rax\n";
            return out + "    movq %rax, " + slot(ins.result) + "\n";
        }
        // i32 -> i64 widen: movslq sign-extends the 32-bit source into %rax;
        // movl zero-extends (writing %eax clears the upper 32 bits of %rax).
        // Result stored 64-bit.
        if (ins.str == "sext_i64") {
            out = out + "    movslq " + regn(reg_of, ins.args[0], 32) + ", %rax\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        if (ins.str == "zext_i64") {
            out = out + "    movl " + regn(reg_of, ins.args[0], 32) + ", %eax\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        // i64 -> i32 truncate: load the 64-bit operand, store at the result's
        // 32-bit home (keeps the low word).
        if (ins.str == "wrap_i32") {
            out = load_op(reg_of, widths, ins.args[0], "a", out);
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        if (ins.str == "-") { out = out + "    negl %eax\n"; }
        else { out = out + "    testl %eax, %eax\n    sete %al\n    movzbl %al, %eax\n"; }
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 11) {  // call
        // System V: integer/pointer args fill rdi,rsi,… ; f64 args fill
        // xmm0,xmm1,… — two independent register sequences.
        var ii: i32 = 0;
        var fi: i32 = 0;
        var i: i32 = 0;
        while (i < ins.args.len()) {
            if (isfloat[ins.args[i]] == 1) {
                out = out + "    movsd " + slot(ins.args[i]) + ", %xmm" + util.i32_to_string(fi) + "\n";
                fi = fi + 1;
            } else {
                var aw: i32 = widths[ins.args[i]];
                out = out + "    " + w_mov(aw) + " " + regn(reg_of, ins.args[i], aw) + ", " + argreg_w(ii, aw) + "\n";
                ii = ii + 1;
            }
            i = i + 1;
        }
        out = out + "    call __fn_" + ins.str + "\n";
        // f64-returning call (imm=2) → result in xmm0; else eax/rax.
        if (isfloat[ins.result] == 1) { return out + "    movsd %xmm0, " + slot(ins.result) + "\n"; }
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 13) {  // funcaddr
        // Materialise a function's address (a closure code pointer) via a
        // RIP-relative lea; the result is pointer-width.
        out = out + "    leaq __fn_" + ins.str + "(%rip), %rax\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 12) {  // call_indirect
        // args[0] is the code pointer; args[1..] the call args. Load the
        // pointer into %rax (not an allocatable reg, r10/r11, nor an arg reg)
        // before staging argregs, then call through it.
        out = out + "    movq " + regn(reg_of, ins.args[0], 64) + ", %rax\n";
        var ci: i32 = 1;
        while (ci < ins.args.len() && ci <= 6) {
            var caw: i32 = widths[ins.args[ci]];
            out = out + "    " + w_mov(caw) + " " + regn(reg_of, ins.args[ci], caw) + ", " + argreg_w(ci - 1, caw) + "\n";
            ci = ci + 1;
        }
        out = out + "    call *%rax\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 14) {  // alloc
        // Bump-allocate 8-byte word slots off the heap pointer. Every element
        // occupies a word so a pointer element (struct field) fits; i32
        // elements just use the low 4 bytes. The slot count is imm
        // (compile-time) unless args[0] is present — a runtime size
        // (__new_array), loaded and scaled ×8.
        if (ins.args.len() > 0) {
            out = load_op(reg_of, widths, ins.args[0], "c", out);   // size → ecx (rcx zero-extended)
            out = out + "    movq __fern_ssa_hp(%rip), %rax\n";      // old hp → result
            out = out + "    shlq $3, %rcx\n";                       // size * 8
            out = out + "    addq %rcx, __fern_ssa_hp(%rip)\n";
            return store_res(reg_of, widths, ins.result, "a", out);
        }
        out = out + "    movq __fern_ssa_hp(%rip), %rax\n";
        out = out + "    addq $" + util.i32_to_string(ins.imm * 8) + ", __fern_ssa_hp(%rip)\n";
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 15) {  // load_elem
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // ptr (64)
        out = load_op(reg_of, widths, ins.args[1], "c", out);   // index (32, zero-extends rcx)
        if (ins.imm == 64) { out = out + "    movq (%rax,%rcx,8), %rax\n"; }
        else { out = out + "    movl (%rax,%rcx,8), %eax\n"; }
        return store_res(reg_of, widths, ins.result, "a", out);
    }
    if (ins.kind_tag == 16) {  // store_elem
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // ptr (64)
        out = load_op(reg_of, widths, ins.args[1], "c", out);   // index (32)
        if (ins.imm == 64) {
            out = out + "    movq " + regn(reg_of, ins.args[2], 64) + ", %rdx\n";   // pointer value
            return out + "    movq %rdx, (%rax,%rcx,8)\n";
        }
        out = out + "    movl " + regn(reg_of, ins.args[2], 32) + ", %edx\n";   // i32 value
        return out + "    movl %edx, (%rax,%rcx,8)\n";
    }
    if (ins.kind_tag == 19) {  // print
        // print/eprint(handle): write each byte to fd (imm: 1=stdout,2=stderr).
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // handle (64-bit) → %rax
        out = out + "    movq %rax, %rdi\n";
        out = out + "    movl $" + util.i32_to_string(ins.imm) + ", %esi\n";   // fd
        return out + "    call __fern_ssa_print\n";
    }
    if (ins.kind_tag == 21) {  // exit
        // exit(code): terminate via the exit syscall (60); code (i32) in %edi.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // code → %rax
        out = out + "    movl %eax, %edi\n";
        out = out + "    movl $60, %eax\n";
        return out + "    syscall\n";
    }
    if (ins.kind_tag == 23) { return out + "    call __fern_ssa_strbuf_reset\n"; }
    if (ins.kind_tag == 24) {  // strbuf_append
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // string → %rax
        out = out + "    movq %rax, %rdi\n";
        return out + "    call __fern_ssa_strbuf_append\n";
    }
    if (ins.kind_tag == 25) {  // strbuf_take
        out = out + "    call __fern_ssa_strbuf_take\n";
        return store_res(reg_of, widths, ins.result, "a", out);   // result string ptr ← %rax
    }
    if (ins.kind_tag == 17) {  // concat
        // a ++ b → new heap string; __fern_ssa_concat(rdi=a, rsi=b) → rax.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // a → %rax
        out = out + "    movq %rax, %rdi\n";
        out = load_op(reg_of, widths, ins.args[1], "a", out);   // b → %rax
        out = out + "    movq %rax, %rsi\n";
        out = out + "    call __fern_ssa_concat\n";
        return store_res(reg_of, widths, ins.result, "a", out);  // result (64) ← %rax
    }
    if (ins.kind_tag == 18) {  // streq
        // a == b by content; __fern_ssa_streq(rdi=a, rsi=b) → eax (0/1).
        out = load_op(reg_of, widths, ins.args[0], "a", out);
        out = out + "    movq %rax, %rdi\n";
        out = load_op(reg_of, widths, ins.args[1], "a", out);
        out = out + "    movq %rax, %rsi\n";
        out = out + "    call __fern_ssa_streq\n";
        return store_res(reg_of, widths, ins.result, "a", out);  // result (32) ← %eax
    }
    if (ins.kind_tag == 26) {  // read_file
        // read_file(path) → Result box; __fern_ssa_read_file(rdi=path) → rax.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // path → %rax
        out = out + "    movq %rax, %rdi\n";
        out = out + "    call __fern_ssa_read_file\n";
        return store_res(reg_of, widths, ins.result, "a", out);  // Result box ptr ← %rax
    }
    if (ins.kind_tag == 27) {  // write_file
        // write_file(path, content) → Result box;
        // __fern_ssa_write_file(rdi=path, rsi=content) → rax.
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // path → %rax
        out = out + "    movq %rax, %rdi\n";
        out = load_op(reg_of, widths, ins.args[1], "a", out);   // content → %rax
        out = out + "    movq %rax, %rsi\n";
        out = out + "    call __fern_ssa_write_file\n";
        return store_res(reg_of, widths, ins.result, "a", out);  // Option box ptr ← %rax
    }
    if (ins.kind_tag == 20) {  // write
        // write(handle): like print but no trailing newline (fd 1).
        out = load_op(reg_of, widths, ins.args[0], "a", out);   // handle → %rax
        out = out + "    movq %rax, %rdi\n";
        return out + "    call __fern_ssa_write\n";
    }
    if (ins.kind_tag == 22) {  // args
        // args() → string[] of argv; __fern_ssa_args() → rax.
        out = out + "    call __fern_ssa_args\n";
        return store_res(reg_of, widths, ins.result, "a", out);  // string[] ptr ← %rax
    }
    return out;
}

// emit_phi_moves copies the phi operands flowing along the edge pred → tgt
// into the phi result slots (out-of-SSA on this edge), at each phi's width.
function emit_phi_moves(f: ssa.SFunc, reg_of: i32[], widths: i32[], pred: i32, tgt: i32, out: string): string {
    var ti: i32 = block_index(f, tgt);
    if (ti < 0) { return out; }
    var tb: ssa.SBlock = f.blocks[ti];
    var sl: i32 = pred_slot(tb, pred);
    var k: i32 = 0;
    while (k < tb.insts.len()) {
        var ins: ssa.SInst = tb.insts[k];
        if (ins.kind_tag == 8) {  // phi
            out = load_op(reg_of, widths, ins.args[sl], "a", out);
            out = store_res(reg_of, widths, ins.result, "a", out);
        }
        k = k + 1;
    }
    return out;
}

function blk_label(name: string, id: i32): string {
    return ".L_" + name + "_" + util.i32_to_string(id);
}

function emit_term(f: ssa.SFunc, name: string, reg_of: i32[], widths: i32[], isfloat: i32[], blk: ssa.SBlock, out: string): string {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag == 1) {  // const_int
        // An f64 return goes in xmm0; otherwise eax/rax.
        if (isfloat[t.value] == 1) { out = out + "    movsd " + slot(t.value) + ", %xmm0\n"; return out + "    leave\n    ret\n"; }
        out = load_op(reg_of, widths, t.value, "a", out);
        return out + "    leave\n    ret\n";
    }
    if (t.kind_tag == 2) {  // const_bool
        out = emit_phi_moves(f, reg_of, widths, blk.id, t.target, out);
        return out + "    jmp " + blk_label(name, t.target) + "\n";
    }
    if (t.kind_tag == 3) {  // const_i64
        out = out + "    movl " + regn(reg_of, t.cond, 32) + ", %eax\n";
        out = out + "    testl %eax, %eax\n";
        out = out + "    jne " + blk_label(name, t.t) + "\n";
        return out + "    jmp " + blk_label(name, t.f) + "\n";
    }
    return out;
}

// emit_func lowers one SSA function to its `__fn_<name>` body.
pub function emit_func(f: ssa.SFunc, reg_of: i32[]): string {
    var widths: i32[] = ssa.compute_widths(f);
    var isfloat: i32[] = ssa.compute_isfloat(f);
    // f64 values occupy 8 bytes, so the generic copy / phi-edge moves (which
    // pick movl/movq by width) must use movq to carry all 8 bytes — otherwise
    // a float loop variable's phi move truncates it. The SSE2 paths use movsd
    // directly; this only fixes the width-driven gpr moves.
    var wmerged: i32[] = [];
    var wi: i32 = 0;
    while (wi < widths.len()) {
        if (isfloat[wi] == 1) { wmerged = wmerged.append(64); } else { wmerged = wmerged.append(widths[wi]); }
        wi = wi + 1;
    }
    widths = wmerged;
    // Collect asm fragments in a string[] (amortised-O(1) push) and join once
    // at the end; emit_inst / emit_term append to their `out` arg and never
    // read it, so passing "" returns just that piece's contribution.
    var chunks: string[] = [];
    chunks = chunks.append("__fn_" + f.name + ":\n");
    chunks = chunks.append("    pushq %rbp\n    movq %rsp, %rbp\n");
    var frame: i32 = f.nvals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { chunks = chunks.append("    subq $" + util.i32_to_string(frame) + ", %rsp\n"); }
    // Spill incoming arguments to their slots. f64 params arrive in xmm0,…
    // (a separate sequence from the integer/pointer argregs), matching the
    // System V split the call site uses.
    var p: i32 = 0;
    var iip: i32 = 0;
    var fip: i32 = 0;
    while (p < f.nparams) {
        if (isfloat[p] == 1) {
            chunks = chunks.append("    movsd %xmm" + util.i32_to_string(fip) + ", " + slot(p) + "\n");
            fip = fip + 1;
        } else {
            var pw: i32 = widths[p];
            chunks = chunks.append("    " + w_mov(pw) + " " + argreg_w(iip, pw) + ", " + regn(reg_of, p, pw) + "\n");
            iip = iip + 1;
        }
        p = p + 1;
    }
    // Emit each block: label, instructions, terminator.
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var blk: ssa.SBlock = f.blocks[bi];
        chunks = chunks.append(blk_label(f.name, blk.id) + ":\n");
        var k: i32 = 0;
        while (k < blk.insts.len()) {
            var ins: ssa.SInst = blk.insts[k];
            if (ins.kind_tag != 6 && ins.kind_tag != 8) {
                chunks = chunks.append(emit_inst(ins, reg_of, widths, isfloat, f.name, ""));
            }
            k = k + 1;
        }
        chunks = chunks.append(emit_term(f, f.name, reg_of, widths, isfloat, blk, ""));
        bi = bi + 1;
    }
    return str_join_chunks(chunks);
}

// emit_program frames the whole module: a heap (a .bss arena + bump
// pointer), each function body, then `_start` — which initialises the heap
// pointer and dispatches into main(). With use_regalloc the linear-scan
// allocator runs per function (caller-saved %r10d/%r11d); else everything
// spills.
// func_has_float reports whether any value in f is an f64 — such a function
// is emitted with everything stack-spilled (regalloc_none), so the SSE2
// paths can address every value by its slot (no XMM allocation needed).
function func_has_float(f: ssa.SFunc): boolean {
    var fl: i32[] = ssa.compute_isfloat(f);
    var i: i32 = 0;
    while (i < fl.len()) { if (fl[i] == 1) { return true; } i = i + 1; }
    return false;
}

// emit_float_consts emits a .rodata `.double` constant for every const_float
// across all functions, labelled by fconst_label so emit_inst can load it.
function emit_float_consts(funcs: ssa.SFunc[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < funcs.len()) {
        var bi: i32 = 0;
        while (bi < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: ssa.SInst = blk.insts[k];
                if (ins.kind_tag == 4) {  // const_float
                    out = out + "    .align 8\n" + fconst_label(funcs[i].name, ins.result) + ":\n    .double " + ins.str + "\n";
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        i = i + 1;
    }
    return out;
}

// emit_str_consts emits a static [len, b0, b1, …] string (one 8-byte .quad
// per element) for every const_str across all functions, labelled by
// sconst_label — matching the runtime string layout the helpers read.
function emit_str_consts(funcs: ssa.SFunc[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < funcs.len()) {
        var bi: i32 = 0;
        while (bi < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: ssa.SInst = blk.insts[k];
                if (ins.kind_tag == 5) {  // const_str
                    var sv: string = ins.str;
                    var parts: string[] = [];
                    parts = parts.append("    .align 8\n" + sconst_label(funcs[i].name, ins.result) + ":\n    .quad " + util.i32_to_string(sv.len()) + "\n");
                    var ci: i32 = 0;
                    while (ci < sv.len()) { parts = parts.append("    .quad " + util.i32_to_string((sv[ci] as i32)) + "\n"); ci = ci + 1; }
                    out = out + str_join_chunks(parts);
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        i = i + 1;
    }
    return out;
}

pub function emit_program(funcs: ssa.SFunc[], use_regalloc: boolean): string {
    var out: string = "    .globl _start\n";
    // Heap: a 1 GiB zero-initialised arena and an 8-byte bump pointer.
    // The arena is leak-everything (no reclamation yet — Perceus RC is a
    // separate track), so it is sized generously (1 GiB) to leave room for
    // a self-hosted SSA compiler to process a real source
    // bundle. It is .bss (demand-zero), so the large reservation costs
    // nothing on disk and no resident memory until actually touched.
    out = out + "    .bss\n    .align 16\n__fern_ssa_heap:\n    .zero 1073741824\n";
    out = out + "    .data\n__fern_ssa_hp:\n    .quad 0\n";
    // String literals as static [len, bytes…] .data constants.
    out = out + emit_str_consts(funcs);
    // f64 literals as .rodata .double constants (the assembler computes bits).
    var fconsts: string = emit_float_consts(funcs);
    if (fconsts.len() > 0) { out = out + "    .section .rodata\n" + fconsts; }
    out = out + "    .text\n";
    // Collect each function body, then join once — a left fold here is
    // O(total²) and OOMs on a whole compiler's worth of asm.
    var chunks: string[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var reg_of: i32[] = ssa.regalloc_none(funcs[i]);
        // A float function keeps every value in its slot (the SSE2 paths
        // address slots directly), so skip register allocation for it.
        if (use_regalloc && !func_has_float(funcs[i])) { reg_of = ssa.regalloc_linear(funcs[i], nregs()); }
        chunks = chunks.append(emit_func(funcs[i], reg_of));
        i = i + 1;
    }
    out = out + str_join_chunks(chunks);
    // __fern_ssa_print(%rdi = string handle): write each byte to stdout,
    // then a trailing newline — Fern's print / eprint append a '\n' (the
    // native backend, the interpreter, and the AST emitters all do).
    // The string is [len, b0, b1, …] as 8-byte words; each byte's low octet
    // sits at its word's address (little-endian), so write 1 byte per word.
    out = out + "__fern_ssa_print:\n";
    out = out + "    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n";
    out = out + "    movq %rdi, %rbx\n";          // handle
    out = out + "    movl %esi, %r14d\n";          // fd
    out = out + "    movl (%rbx), %r12d\n";        // len = word[0]
    out = out + "    xorl %r13d, %r13d\n";         // i = 0
    out = out + ".Lfsp_loop:\n";
    out = out + "    cmpl %r12d, %r13d\n    jge .Lfsp_done\n";
    out = out + "    leal 1(%r13d), %eax\n";       // i+1
    out = out + "    movl %eax, %eax\n";           // zero-extend to rax
    out = out + "    leaq (%rbx,%rax,8), %rsi\n";   // &word[i+1] = byte address
    out = out + "    movq $1, %rax\n    movl %r14d, %edi\n    movq $1, %rdx\n    syscall\n";
    out = out + "    incl %r13d\n    jmp .Lfsp_loop\n";
    out = out + ".Lfsp_done:\n";
    // Trailing newline: write one '\n' byte from a scratch stack slot.
    out = out + "    subq $16, %rsp\n    movb $10, (%rsp)\n";
    out = out + "    movq $1, %rax\n    movl %r14d, %edi\n    movq %rsp, %rsi\n    movq $1, %rdx\n    syscall\n";
    out = out + "    addq $16, %rsp\n";
    out = out + "    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
    // __fern_ssa_concat(%rdi = a, %rsi = b) → %rax: new length-prefixed
    // string = lenA+lenB, then A's bytes, then B's bytes. Words are 8 bytes;
    // each byte is an i32 (we copy the low 4 bytes per word).
    out = out + "__fern_ssa_concat:\n";
    out = out + "    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n";
    out = out + "    movq %rdi, %rbx\n";          // a
    out = out + "    movq %rsi, %r12\n";          // b
    out = out + "    movl (%rbx), %r13d\n";        // lenA
    out = out + "    movl (%r12), %r14d\n";        // lenB
    out = out + "    movl %r13d, %eax\n    addl %r14d, %eax\n";   // eax = total
    out = out + "    movq __fern_ssa_hp(%rip), %r15\n";           // r15 = result ptr
    out = out + "    leal 1(%rax), %ecx\n    movl %ecx, %ecx\n";   // ecx = total+1
    out = out + "    leaq (,%rcx,8), %rdx\n    addq %rdx, __fern_ssa_hp(%rip)\n";   // hp += (total+1)*8
    out = out + "    movl %eax, (%r15)\n";         // result[0] = total
    out = out + "    xorl %ecx, %ecx\n";           // i = 0
    out = out + ".Lcat_a:\n    cmpl %r13d, %ecx\n    jge .Lcat_a_done\n";
    out = out + "    leal 1(%rcx), %eax\n    movl %eax, %eax\n";
    out = out + "    movl (%rbx,%rax,8), %edx\n    movl %edx, (%r15,%rax,8)\n";
    out = out + "    incl %ecx\n    jmp .Lcat_a\n.Lcat_a_done:\n";
    out = out + "    xorl %ecx, %ecx\n";           // j = 0
    out = out + ".Lcat_b:\n    cmpl %r14d, %ecx\n    jge .Lcat_b_done\n";
    out = out + "    leal 1(%rcx), %eax\n    movl %eax, %eax\n";          // src word = j+1
    out = out + "    movl (%r12,%rax,8), %edx\n";   // b[j+1]
    out = out + "    movl %r13d, %edi\n    addl $1, %edi\n    addl %ecx, %edi\n    movl %edi, %edi\n";   // dst word = lenA+1+j
    out = out + "    movl %edx, (%r15,%rdi,8)\n";
    out = out + "    incl %ecx\n    jmp .Lcat_b\n.Lcat_b_done:\n";
    out = out + "    movq %r15, %rax\n";           // return result ptr
    out = out + "    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
    // __fern_ssa_streq(%rdi = a, %rsi = b) → %eax (1 if equal content else 0).
    out = out + "__fern_ssa_streq:\n";
    out = out + "    movl (%rdi), %ecx\n";          // lenA
    out = out + "    movl (%rsi), %edx\n";          // lenB
    out = out + "    cmpl %edx, %ecx\n    jne .Lsne_no\n";   // lengths differ → 0
    out = out + "    xorl %r8d, %r8d\n";            // i = 0
    out = out + ".Lsne_loop:\n    cmpl %ecx, %r8d\n    jge .Lsne_yes\n";
    out = out + "    leal 1(%r8d), %eax\n    movl %eax, %eax\n";
    out = out + "    movl (%rdi,%rax,8), %r9d\n    movl (%rsi,%rax,8), %r10d\n";
    out = out + "    cmpl %r10d, %r9d\n    jne .Lsne_no\n";
    out = out + "    incl %r8d\n    jmp .Lsne_loop\n";
    out = out + ".Lsne_yes:\n    movl $1, %eax\n    ret\n";
    out = out + ".Lsne_no:\n    xorl %eax, %eax\n    ret\n";
    // strbuf — the global amortised-O(1) string builder. A byte buffer in
    // .bss (256 MiB, demand-zero) + a length. append copies a source string's
    // bytes (read from the [len, byte-per-word] layout) into the buffer; take
    // materialises a fresh [len, bytes…] string and clears the buffer.
    out = out + "    .bss\n    .align 8\n__fern_ssa_strbuf_data:\n    .zero 268435456\n";
    out = out + "    .data\n    .align 8\n__fern_ssa_strbuf_len:\n    .quad 0\n";
    out = out + "    .text\n";
    out = out + "__fern_ssa_strbuf_reset:\n    movq $0, __fern_ssa_strbuf_len(%rip)\n    ret\n";
    out = out + "__fern_ssa_strbuf_append:\n";
    out = out + "    movl (%rdi), %ecx\n";                  // src len (word0)
    out = out + "    testl %ecx, %ecx\n    je .Lsba_done\n";
    out = out + "    leaq __fern_ssa_strbuf_data(%rip), %rdx\n";
    out = out + "    addq __fern_ssa_strbuf_len(%rip), %rdx\n";   // dst = data + curlen
    out = out + "    xorl %eax, %eax\n";                   // i = 0
    out = out + ".Lsba_loop:\n    cmpl %ecx, %eax\n    jge .Lsba_fin\n";
    out = out + "    leal 1(%eax), %r8d\n    movl %r8d, %r8d\n";   // src word = i+1
    out = out + "    movzbl (%rdi,%r8,8), %r9d\n";          // byte = low octet of word i+1
    out = out + "    movb %r9b, (%rdx)\n    incq %rdx\n";
    out = out + "    incl %eax\n    jmp .Lsba_loop\n";
    out = out + ".Lsba_fin:\n    addq %rcx, __fern_ssa_strbuf_len(%rip)\n";
    out = out + ".Lsba_done:\n    ret\n";
    out = out + "__fern_ssa_strbuf_take:\n";
    out = out + "    movq __fern_ssa_strbuf_len(%rip), %rcx\n";    // total bytes
    out = out + "    movq __fern_ssa_hp(%rip), %r8\n";            // result ptr
    out = out + "    leaq 1(%rcx), %rax\n    leaq (,%rax,8), %rdx\n";   // (total+1)*8
    out = out + "    addq %rdx, __fern_ssa_hp(%rip)\n";
    out = out + "    movl %ecx, (%r8)\n";                  // result[0] = total
    out = out + "    leaq __fern_ssa_strbuf_data(%rip), %rsi\n";
    out = out + "    xorl %eax, %eax\n";                   // i = 0
    out = out + ".Lsbt_loop:\n    cmpq %rcx, %rax\n    jge .Lsbt_fin\n";
    out = out + "    movzbl (%rsi,%rax), %edx\n";           // byte i
    out = out + "    leaq 1(%rax), %r9\n";                  // dst word = i+1
    out = out + "    movl %edx, (%r8,%r9,8)\n";             // result[i+1] = byte
    out = out + "    incq %rax\n    jmp .Lsbt_loop\n";
    out = out + ".Lsbt_fin:\n    movq $0, __fern_ssa_strbuf_len(%rip)\n";
    out = out + "    movq %r8, %rax\n    ret\n";
    // File I/O — read_file / write_file lowered to the Linux x86-64 syscall
    // runtime (openat=257, read=0, write=1, close=3, lseek=8; AT_FDCWD -100).
    // Strings use the SSA [len, byte-per-8-byte-word] layout, so both helpers
    // pack/unpack between that and the raw byte buffers the syscalls work on.
    // Both allocate via __fern_ssa_alloc; the result is a fixed 2-word
    // [tag@0, payload@8] box matching the SSA Option/Result lowering. Loop
    // counters that straddle a syscall live in callee-saved regs (a syscall
    // clobbers rcx/r11), so rcx counts only in syscall-free copy loops.
    // __fern_ssa_alloc(rdi = bytes) → rax = base (8-aligned bump off __fern_ssa_hp).
    out = out + "__fern_ssa_alloc:\n";
    out = out + "    addq $7, %rdi\n    andq $-8, %rdi\n";
    out = out + "    movq __fern_ssa_hp(%rip), %rax\n    addq %rdi, __fern_ssa_hp(%rip)\n    ret\n";
    // __fern_ssa_read_file(rdi = path string box) → rax = Result box:
    // [tag=0@0, payload=string@8] Ok, or [tag=1@0, 0@8] Err on any I/O error.
    out = out + "__fern_ssa_read_file:\n";
    out = out + "    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n";
    out = out + "    movq %rdi, %rbx\n";              // path box
    out = out + "    movl (%rbx), %r13d\n";           // path len (word0)
    out = out + "    leaq 1(%r13), %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r12\n";   // pathz
    out = out + "    xorl %ecx, %ecx\n";
    out = out + ".Lssa_rdf_copy:\n    cmpl %r13d, %ecx\n    jge .Lssa_rdf_copydone\n";
    out = out + "    leal 1(%ecx), %eax\n    movl %eax, %eax\n    movl (%rbx,%rax,8), %edx\n";   // path word[i+1]
    out = out + "    movb %dl, (%r12,%rcx)\n    incl %ecx\n    jmp .Lssa_rdf_copy\n";
    out = out + ".Lssa_rdf_copydone:\n    movb $0, (%r12,%r13)\n";   // NUL
    out = out + "    movq $-100, %rdi\n    movq %r12, %rsi\n    xorl %edx, %edx\n    xorl %r10d, %r10d\n    movl $257, %eax\n    syscall\n";   // openat O_RDONLY
    out = out + "    testq %rax, %rax\n    js .Lssa_rdf_err\n    movq %rax, %r12\n";   // fd
    out = out + "    movq %r12, %rdi\n    xorl %esi, %esi\n    movl $2, %edx\n    movl $8, %eax\n    syscall\n    movq %rax, %r14\n";   // lseek SEEK_END → size
    out = out + "    movq %r12, %rdi\n    xorl %esi, %esi\n    xorl %edx, %edx\n    movl $8, %eax\n    syscall\n";   // lseek SEEK_SET 0
    out = out + "    movq %r14, %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r14\n    movq %rax, %r15\n    xorl %r13d, %r13d\n";   // packed buf / write ptr / total
    out = out + ".Lssa_rdf_rdloop:\n    movq %r12, %rdi\n    movq %r15, %rsi\n    movq $1048576, %rdx\n    xorl %eax, %eax\n    syscall\n";   // read up to 1 MiB
    out = out + "    testq %rax, %rax\n    jle .Lssa_rdf_rddone\n    addq %rax, %r13\n    addq %rax, %r15\n    jmp .Lssa_rdf_rdloop\n";
    out = out + ".Lssa_rdf_rddone:\n    movq %r12, %rdi\n    movl $3, %eax\n    syscall\n";   // close
    // Build SSA string [total, byte-per-word] from the packed buffer (r14).
    out = out + "    leaq 1(%r13), %rdi\n    shlq $3, %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r15\n";   // strbox
    out = out + "    movl %r13d, (%r15)\n    xorl %ecx, %ecx\n";   // len = word0
    out = out + ".Lssa_rdf_expand:\n    cmpl %r13d, %ecx\n    jge .Lssa_rdf_expanddone\n";
    out = out + "    movzbl (%r14,%rcx), %edx\n    leal 1(%ecx), %eax\n    movl %eax, %eax\n    movl %edx, (%r15,%rax,8)\n";   // strbox[i+1] = byte
    out = out + "    incl %ecx\n    jmp .Lssa_rdf_expand\n";
    out = out + ".Lssa_rdf_expanddone:\n";
    out = out + "    movl $16, %edi\n    call __fern_ssa_alloc\n    movq $0, (%rax)\n    movq %r15, 8(%rax)\n";   // Ok box
    out = out + "    jmp .Lssa_rdf_ret\n";
    out = out + ".Lssa_rdf_err:\n    movl $16, %edi\n    call __fern_ssa_alloc\n    movq $1, (%rax)\n    movq $0, 8(%rax)\n";   // Err box
    out = out + ".Lssa_rdf_ret:\n";
    out = out + "    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
    // __fern_ssa_write_file(rdi = path box, rsi = content box) → rax = Result
    // box: [tag=0@0, 0@8] Ok(()) on success, [tag=1@0, 0@8] Err on I/O error.
    out = out + "__fern_ssa_write_file:\n";
    out = out + "    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n";
    out = out + "    movq %rdi, %rbx\n";              // path box
    out = out + "    movq %rsi, %r12\n";              // content box
    out = out + "    movl (%r12), %r13d\n";           // content len
    out = out + "    leaq 1(%r13), %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r14\n";   // packed content buf
    out = out + "    xorl %ecx, %ecx\n";
    out = out + ".Lssa_wf_pack:\n    cmpl %r13d, %ecx\n    jge .Lssa_wf_packdone\n";
    out = out + "    leal 1(%ecx), %eax\n    movl %eax, %eax\n    movl (%r12,%rax,8), %edx\n    movb %dl, (%r14,%rcx)\n";
    out = out + "    incl %ecx\n    jmp .Lssa_wf_pack\n";
    out = out + ".Lssa_wf_packdone:\n";
    out = out + "    movl (%rbx), %r15d\n";           // path len
    out = out + "    leaq 1(%r15), %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r12\n";   // pathz
    out = out + "    xorl %ecx, %ecx\n";
    out = out + ".Lssa_wf_pcopy:\n    cmpl %r15d, %ecx\n    jge .Lssa_wf_pcopydone\n";
    out = out + "    leal 1(%ecx), %eax\n    movl %eax, %eax\n    movl (%rbx,%rax,8), %edx\n    movb %dl, (%r12,%rcx)\n";
    out = out + "    incl %ecx\n    jmp .Lssa_wf_pcopy\n";
    out = out + ".Lssa_wf_pcopydone:\n    movb $0, (%r12,%r15)\n";   // NUL
    out = out + "    movq $-100, %rdi\n    movq %r12, %rsi\n    movl $577, %edx\n    movl $420, %r10d\n    movl $257, %eax\n    syscall\n";   // openat O_WRONLY|O_CREAT|O_TRUNC, 0644
    out = out + "    testq %rax, %rax\n    js .Lssa_wf_err\n    movq %rax, %r12\n    xorl %r15d, %r15d\n";   // fd / written
    out = out + ".Lssa_wf_loop:\n    cmpl %r13d, %r15d\n    jge .Lssa_wf_done\n";
    out = out + "    movq %r12, %rdi\n    leaq (%r14,%r15), %rsi\n    movl %r13d, %edx\n    subl %r15d, %edx\n    movl $1, %eax\n    syscall\n";   // write remaining
    out = out + "    testq %rax, %rax\n    js .Lssa_wf_errclose\n    addq %rax, %r15\n    jmp .Lssa_wf_loop\n";
    out = out + ".Lssa_wf_done:\n    movq %r12, %rdi\n    movl $3, %eax\n    syscall\n";   // close
    out = out + "    movl $16, %edi\n    call __fern_ssa_alloc\n    movq $0, (%rax)\n    movq $0, 8(%rax)\n";   // Ok(()) box
    out = out + "    jmp .Lssa_wf_ret\n";
    out = out + ".Lssa_wf_errclose:\n    movq %r12, %rdi\n    movl $3, %eax\n    syscall\n";   // close, ignore result
    out = out + ".Lssa_wf_err:\n    movl $16, %edi\n    call __fern_ssa_alloc\n    movq $1, (%rax)\n    movq $0, 8(%rax)\n";   // Err box
    out = out + ".Lssa_wf_ret:\n";
    out = out + "    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
    // __fern_ssa_write(rdi = string handle): like __fern_ssa_print but with NO
    // trailing newline — the driver's raw-output primitive. One write syscall
    // per byte over the [len, byte-per-word] layout (low octet of each word).
    out = out + "__fern_ssa_write:\n";
    out = out + "    pushq %rbx\n    pushq %r12\n    pushq %r13\n";
    out = out + "    movq %rdi, %rbx\n";          // handle
    out = out + "    movl (%rbx), %r12d\n";        // len = word[0]
    out = out + "    xorl %r13d, %r13d\n";         // i = 0
    out = out + ".Lfsw_loop:\n";
    out = out + "    cmpl %r12d, %r13d\n    jge .Lfsw_done\n";
    out = out + "    leal 1(%r13d), %eax\n    movl %eax, %eax\n";   // i+1
    out = out + "    leaq (%rbx,%rax,8), %rsi\n";   // &word[i+1] = byte address
    out = out + "    movq $1, %rax\n    movl $1, %edi\n    movq $1, %rdx\n    syscall\n";   // write(1, &byte, 1)
    out = out + "    incl %r13d\n    jmp .Lfsw_loop\n";
    out = out + ".Lfsw_done:\n";
    out = out + "    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
    // argv vector saved by _start (argc + &argv[0]) for __fern_ssa_args.
    out = out + "    .bss\n    .align 8\n__fern_ssa_argc:\n    .zero 8\n__fern_ssa_argv:\n    .zero 8\n    .text\n";
    // __fern_ssa_args() → rax = SSA string[] [argc, strptr0, …], each strptr a
    // fresh SSA [len, byte-per-word] string copied from the C argv[i]. Mirrors
    // read_file's C-string → SSA-string packing. alloc preserves r8/r9/rcx/rdx
    // (it touches only rdi/rax), so those carry per-arg state across the call.
    out = out + "__fern_ssa_args:\n";
    out = out + "    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n";
    out = out + "    movq __fern_ssa_argc(%rip), %r12\n";       // argc
    out = out + "    leaq 1(%r12), %rdi\n    shlq $3, %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r13\n";   // arr base, (argc+1) words
    out = out + "    movl %r12d, (%r13)\n";                     // arr[0] = argc
    out = out + "    movq __fern_ssa_argv(%rip), %r14\n";       // &argv[0]
    out = out + "    xorq %r15, %r15\n";                        // i = 0
    out = out + ".Lssa_args_loop:\n    cmpq %r12, %r15\n    jge .Lssa_args_done\n";
    out = out + "    movq (%r14,%r15,8), %rbx\n";               // argv[i] (C string)
    out = out + "    xorq %rcx, %rcx\n";                        // strlen
    out = out + ".Lssa_args_strlen:\n    movzbl (%rbx,%rcx), %eax\n    testb %al, %al\n    je .Lssa_args_strdone\n    incq %rcx\n    jmp .Lssa_args_strlen\n";
    out = out + ".Lssa_args_strdone:\n    movq %rcx, %r8\n";    // r8 = len
    out = out + "    leaq 1(%r8), %rdi\n    shlq $3, %rdi\n    call __fern_ssa_alloc\n    movq %rax, %r9\n";   // SSA string box
    out = out + "    movl %r8d, (%r9)\n";                       // box[0] = len
    out = out + "    xorq %rcx, %rcx\n";                        // j = 0
    out = out + ".Lssa_args_copy:\n    cmpq %r8, %rcx\n    jge .Lssa_args_copydone\n";
    out = out + "    movzbl (%rbx,%rcx), %eax\n    leaq 1(%rcx), %rdx\n    movl %eax, (%r9,%rdx,8)\n";   // box[j+1] = byte
    out = out + "    incq %rcx\n    jmp .Lssa_args_copy\n";
    out = out + ".Lssa_args_copydone:\n    leaq 1(%r15), %rdx\n    movq %r9, (%r13,%rdx,8)\n";   // arr[i+1] = box
    out = out + "    incq %r15\n    jmp .Lssa_args_loop\n";
    out = out + ".Lssa_args_done:\n    movq %r13, %rax\n";
    out = out + "    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
    out = out + "_start:\n";
    // Save argc + &argv[0] before any stack use (rsp points at argc at entry).
    out = out + "    movq (%rsp), %rax\n    movq %rax, __fern_ssa_argc(%rip)\n";
    out = out + "    leaq 8(%rsp), %rax\n    movq %rax, __fern_ssa_argv(%rip)\n";
    out = out + "    leaq __fern_ssa_heap(%rip), %rax\n";
    out = out + "    movq %rax, __fern_ssa_hp(%rip)\n";
    out = out + "    call __fn_main\n";
    out = out + "    movl %eax, %edi\n";
    out = out + "    movq $60, %rax\n";
    out = out + "    syscall\n";
    return out;
}
