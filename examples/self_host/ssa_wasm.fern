// examples/self_host/ssa_wasm.fern — an SSA → WebAssembly text (WAT) code
// generator, the third consumer of the shared SSA IR (after ssa_x86.fern
// and ssa_arm64.fern). Where those emit flat label + jump assembly, WAT
// has no arbitrary jumps, so the SSA control-flow graph is lowered with
// the standard *dispatch-loop* shape:
//
//     (block $exit (loop $L
//        (block $blkN-1 … (block $blk0
//           (br_table $blk0 … $blkN-1 (local.get $pc)))  ;; dispatch on $pc
//        … block 0 body + terminator …)
//        … block 1 …) … ))
//
// Each terminator sets $pc to its successor's dispatch index and `br $L`s
// back to the dispatch (or `return`s). SSA values become wasm locals —
// on wasm32 every value (i32 and pointer alike) is a 32-bit local, so the
// width bookkeeping the native backends need disappears here.
//
// Strategy (Phase 2 of docs/SELFHOST-SSA-ALWAYS.md): the wasm backend now
// covers the whole SSA subset build_func produces — the integer ops, the
// heap (alloc / load_elem / store_elem over a linear-memory bump allocator;
// on wasm32 every value is a 4-byte i32 word: arrays, strings, structs,
// tuples, methods, maps), strings (concat / streq), I/O (print: bytes + a
// trailing '\n' via fd_write), and closures (funcaddr / call_indirect via a
// function table). The closure convention passes the env box as a trailing
// arg, so call_indirect uses a $clos<arity> type and the table holds each
// function's closure-callable form: a capturing lambda (which takes __env)
// directly, a plain function value through an env-dropping wrapper (wasm's
// call_indirect is strictly typed, unlike the native backends). `supported()`
// still gates per kind so a future IR addition falls back to wasm.fern rather
// than emitting broken WAT, but in practice every current kind is covered.

import "./ssa";
import "./util";

// loc returns the WAT operand that reads SSA value v (a wasm local read).
// SSA value ids are dense 0..nvals-1 and map 1:1 to wasm local indices:
// params occupy 0..nparams-1 (wasm function params) and the rest are the
// declared locals, in id order.
function loc(v: i32): string {
    return "(local.get " + util.i32_to_string(v) + ")";
}

// index_of_str returns the position of s in xs, or 0 if absent (every
// function is in the table, so a funcaddr always resolves).
// index_of_str -> util.index_of_str (SH-020/SH-007).

// block_index maps a block id to its position in f.blocks (its dispatch
// index), or -1. pred_slot finds prev's position in blk.preds (the phi
// operand slot for the edge prev → blk).

// wasm_binop maps a binary operator to its WAT s-expression over the two
// operand reads a and b. Fern i32 is signed, so comparisons / div / rem
// use the signed (_s) variants. && / || normalise each side to 0/1 then
// bit-combine (both operands are already-evaluated SSA values, matching
// the native backends' non-short-circuit lowering).
function wasm_binop(op: string, a: string, b: string): string {
    if (op == "+") { return "(i32.add " + a + " " + b + ")"; }
    if (op == "-") { return "(i32.sub " + a + " " + b + ")"; }
    if (op == "*") { return "(i32.mul " + a + " " + b + ")"; }
    if (op == "/") { return "(i32.div_s " + a + " " + b + ")"; }
    if (op == "%") { return "(i32.rem_s " + a + " " + b + ")"; }
    if (op == "&") { return "(i32.and " + a + " " + b + ")"; }
    if (op == "|") { return "(i32.or " + a + " " + b + ")"; }
    if (op == "^") { return "(i32.xor " + a + " " + b + ")"; }
    if (op == "<<") { return "(i32.shl " + a + " " + b + ")"; }
    if (op == ">>") { return "(i32.shr_s " + a + " " + b + ")"; }
    if (op == "==") { return "(i32.eq " + a + " " + b + ")"; }
    if (op == "!=") { return "(i32.ne " + a + " " + b + ")"; }
    if (op == "<") { return "(i32.lt_s " + a + " " + b + ")"; }
    if (op == "<=") { return "(i32.le_s " + a + " " + b + ")"; }
    if (op == ">") { return "(i32.gt_s " + a + " " + b + ")"; }
    if (op == ">=") { return "(i32.ge_s " + a + " " + b + ")"; }
    if (op == "&&") { return "(i32.and (i32.ne " + a + " (i32.const 0)) (i32.ne " + b + " (i32.const 0)))"; }
    if (op == "||") { return "(i32.or (i32.ne " + a + " (i32.const 0)) (i32.ne " + b + " (i32.const 0)))"; }
    return "(i32.const 0)";
}

// emit_inst lowers one value-defining instruction to a `(local.set …)`.
// param and phi are handled elsewhere (wasm params / predecessor edges).
function emit_inst(ins: ssa.SInst, fnnames: string[], isfloat: i32[]): string {
    if (ins.kind_tag == 5) {  // const_str
        // Materialise the literal [len, b0, b1, …] on the heap (one i32 word
        // per element). build_func emits one compact const_str; the backend
        // expands it (so the IR stays small for string-heavy functions).
        var sv: string = ins.str;
        var n: i32 = sv.len();
        var o: string = "    (local.set " + util.i32_to_string(ins.result) + " (global.get $__hp))\n";
        o = o + "    (global.set $__hp (i32.add (global.get $__hp) (i32.const " + util.i32_to_string((n + 1) * 4) + ")))\n";
        o = o + "    (i32.store " + loc(ins.result) + " (i32.const " + util.i32_to_string(n) + "))\n";
        var ci: i32 = 0;
        while (ci < n) {
            o = o + "    (i32.store (i32.add " + loc(ins.result) + " (i32.const " + util.i32_to_string((ci + 1) * 4) + ")) (i32.const " + util.i32_to_string((sv[ci] as i32)) + "))\n";
            ci = ci + 1;
        }
        return o;
    }
    if (ins.kind_tag == 4) {  // const_float
        return "    (local.set " + util.i32_to_string(ins.result) + " (f64.const " + ins.str + "))\n";
    }
    if (ins.kind_tag == 1 || ins.kind_tag == 2) {
        return "    (local.set " + util.i32_to_string(ins.result) + " (i32.const " + util.i32_to_string(ins.imm) + "))\n";
    }
    if (ins.kind_tag == 7) {  // copy
        return "    (local.set " + util.i32_to_string(ins.result) + " " + loc(ins.args[0]) + ")\n";
    }
    if (ins.kind_tag == 9) {  // binary
        // Float arithmetic (f64 result) / comparison (f64 operands, i32 result).
        if (isfloat[ins.result] == 1) {
            return "    (local.set " + util.i32_to_string(ins.result) + " (" + wasm_fbinop(ins.str) + " " + loc(ins.args[0]) + " " + loc(ins.args[1]) + "))\n";
        }
        if (isfloat[ins.args[0]] == 1) {
            return "    (local.set " + util.i32_to_string(ins.result) + " (" + wasm_fcmp(ins.str) + " " + loc(ins.args[0]) + " " + loc(ins.args[1]) + "))\n";
        }
        return "    (local.set " + util.i32_to_string(ins.result) + " " + wasm_binop(ins.str, loc(ins.args[0]), loc(ins.args[1])) + ")\n";
    }
    if (ins.kind_tag == 10) {  // unary
        if (ins.str == "-" && isfloat[ins.args[0]] == 1) {
            return "    (local.set " + util.i32_to_string(ins.result) + " (f64.neg " + loc(ins.args[0]) + "))\n";
        }
        if (ins.str == "as_f64") {
            return "    (local.set " + util.i32_to_string(ins.result) + " (f64.convert_i32_s " + loc(ins.args[0]) + "))\n";
        }
        if (ins.str == "as_i32") {
            if (isfloat[ins.args[0]] == 1) {
                return "    (local.set " + util.i32_to_string(ins.result) + " (i32.trunc_f64_s " + loc(ins.args[0]) + "))\n";
            }
            return "    (local.set " + util.i32_to_string(ins.result) + " " + loc(ins.args[0]) + ")\n";
        }
        if (ins.str == "-") {
            return "    (local.set " + util.i32_to_string(ins.result) + " (i32.sub (i32.const 0) " + loc(ins.args[0]) + "))\n";
        }
        return "    (local.set " + util.i32_to_string(ins.result) + " (i32.eqz " + loc(ins.args[0]) + "))\n";
    }
    if (ins.kind_tag == 11) {  // call
        var expr: string = "(call $__fn_" + ins.str;
        var i: i32 = 0;
        while (i < ins.args.len()) { expr = expr + " " + loc(ins.args[i]); i = i + 1; }
        expr = expr + ")";
        return "    (local.set " + util.i32_to_string(ins.result) + " " + expr + ")\n";
    }
    // Heap: a bump allocator over linear memory. On wasm32 every value is a
    // 4-byte i32 word, so the native backends' 8-byte word stride / pointer
    // width collapses to a uniform 4-byte word here (element i lives at
    // base + i*4; imm element widths are ignored — every slot is one i32).
    if (ins.kind_tag == 14) {  // alloc
        // Reserve the result words off __hp, then bump. The word count is imm
        // (compile-time) unless args[0] is present — a runtime size scaled ×4.
        var out: string = "    (local.set " + util.i32_to_string(ins.result) + " (global.get $__hp))\n";
        if (ins.args.len() > 0) {
            return out + "    (global.set $__hp (i32.add (global.get $__hp) (i32.mul " + loc(ins.args[0]) + " (i32.const 4))))\n";
        }
        return out + "    (global.set $__hp (i32.add (global.get $__hp) (i32.const " + util.i32_to_string(ins.imm * 4) + ")))\n";
    }
    if (ins.kind_tag == 15) {  // load_elem
        return "    (local.set " + util.i32_to_string(ins.result) + " (i32.load (i32.add " + loc(ins.args[0]) + " (i32.shl " + loc(ins.args[1]) + " (i32.const 2)))))\n";
    }
    if (ins.kind_tag == 16) {  // store_elem
        // No result — a pure memory store at base + index*4.
        return "    (i32.store (i32.add " + loc(ins.args[0]) + " (i32.shl " + loc(ins.args[1]) + " (i32.const 2))) " + loc(ins.args[2]) + ")\n";
    }
    // Strings (byte arrays in the [len, c0, c1, …] word layout) + I/O, lowered
    // to calls into the runtime helpers emitted by emit_program.
    if (ins.kind_tag == 17) {  // concat
        return "    (local.set " + util.i32_to_string(ins.result) + " (call $__fern_ssa_concat " + loc(ins.args[0]) + " " + loc(ins.args[1]) + "))\n";
    }
    if (ins.kind_tag == 18) {  // streq
        return "    (local.set " + util.i32_to_string(ins.result) + " (call $__fern_ssa_streq " + loc(ins.args[0]) + " " + loc(ins.args[1]) + "))\n";
    }
    if (ins.kind_tag == 19) {  // print
        // No result — write the string's bytes (plus a trailing newline) to
        // fd imm (1=stdout, 2=stderr).
        return "    (call $__fern_ssa_print " + loc(ins.args[0]) + " (i32.const " + util.i32_to_string(ins.imm) + "))\n";
    }
    if (ins.kind_tag == 13) {  // funcaddr
        // A function value is its slot in the function table (wasm has no raw
        // code pointers); slot i holds the closure-callable form of funcs[i].
        return "    (local.set " + util.i32_to_string(ins.result) + " (i32.const " + util.i32_to_string(util.index_of_str(fnnames, ins.str)) + "))\n";
    }
    if (ins.kind_tag == 12) {  // call_indirect
        // args[0] is the table slot (a function value); args[1..] the call
        // args, with the closure env passed last. call_indirect takes the args
        // then the table index, typed by the call's arity ($clos<nargs>).
        var nargs: i32 = ins.args.len() - 1;
        var ci: string = "(call_indirect (type $clos" + util.i32_to_string(nargs) + ")";
        var ai: i32 = 1;
        while (ai < ins.args.len()) { ci = ci + " " + loc(ins.args[ai]); ai = ai + 1; }
        ci = ci + " " + loc(ins.args[0]) + ")";
        return "    (local.set " + util.i32_to_string(ins.result) + " " + ci + ")\n";
    }
    return "";
}

// emit_phi_moves copies the phi operands flowing along the edge pred → tgt
// into the phi result locals (out-of-SSA on this edge). In our construction
// only `br` targets carry phis (brif targets never do), so this is called
// only from the `br` terminator. Sequential copies mirror the native
// backends.
function emit_phi_moves(f: ssa.SFunc, pred: i32, tgt: i32): string {
    var ti: i32 = ssa.block_index(f, tgt);
    if (ti < 0) { return ""; }
    var tb: ssa.SBlock = f.blocks[ti];
    var sl: i32 = ssa.pred_slot(tb, pred);
    var out: string = "";
    var k: i32 = 0;
    while (k < tb.insts.len()) {
        var ins: ssa.SInst = tb.insts[k];
        if (ins.kind_tag == 8) {  // phi
            out = out + "    (local.set " + util.i32_to_string(ins.result) + " " + loc(ins.args[sl]) + ")\n";
        }
        k = k + 1;
    }
    return out;
}

// emit_term lowers a block's terminator. `pc` is the dispatch-state local
// index; `ret` exits the function, `br` / `brif` set $pc and loop back.
function emit_term(f: ssa.SFunc, blk: ssa.SBlock, pc: i32): string {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag == 1) {  // const_int
        return "    (return " + loc(t.value) + ")\n";
    }
    if (t.kind_tag == 2) {  // const_bool
        var out: string = emit_phi_moves(f, blk.id, t.target);
        out = out + "    (local.set " + util.i32_to_string(pc) + " (i32.const " + util.i32_to_string(ssa.block_index(f, t.target)) + "))\n";
        return out + "    (br $L)\n";
    }
    if (t.kind_tag == 3) {  // const_i64
        var out2: string = "    (if " + loc(t.cond) + "\n";
        out2 = out2 + "      (then (local.set " + util.i32_to_string(pc) + " (i32.const " + util.i32_to_string(ssa.block_index(f, t.t)) + ")))\n";
        out2 = out2 + "      (else (local.set " + util.i32_to_string(pc) + " (i32.const " + util.i32_to_string(ssa.block_index(f, t.f)) + "))))\n";
        return out2 + "    (br $L)\n";
    }
    return "";
}

// emit_block emits one block's value instructions then its terminator.
function emit_block(f: ssa.SFunc, blk: ssa.SBlock, pc: i32, fnnames: string[], isfloat: i32[]): string {
    var out: string = "";
    var k: i32 = 0;
    while (k < blk.insts.len()) {
        var ins: ssa.SInst = blk.insts[k];
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
            out = out + emit_inst(ins, fnnames, isfloat);
        }
        k = k + 1;
    }
    return out + emit_term(f, blk, pc);
}

// func_returns_float reports whether the function's `ret` yields an f64 (so
// its wasm signature is `(result f64)`).
function func_returns_float(f: ssa.SFunc, isfloat: i32[]): boolean {
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var t: ssa.STerm = f.blocks[bi].term;
        if (t.kind_tag == 1 && isfloat[t.value] == 1) { return true; }
        bi = bi + 1;
    }
    return false;
}

// wasm_fbinop / wasm_fcmp map float arithmetic / comparison operators to
// their f64 wasm instructions (comparisons yield i32).
function wasm_fbinop(op: string): string {
    if (op == "+") { return "f64.add"; }
    if (op == "-") { return "f64.sub"; }
    if (op == "*") { return "f64.mul"; }
    return "f64.div";
}
function wasm_fcmp(op: string): string {
    if (op == "<") { return "f64.lt"; }
    if (op == "<=") { return "f64.le"; }
    if (op == ">") { return "f64.gt"; }
    if (op == ">=") { return "f64.ge"; }
    if (op == "==") { return "f64.eq"; }
    return "f64.ne";
}

// emit_func lowers one SSA function to a `$__fn_<name>` wasm function.
// fnnames is the function-table layout (for funcaddr slot indices).
pub function emit_func(f: ssa.SFunc, fnnames: string[]): string {
    var isfloat: i32[] = ssa.compute_isfloat(f);
    var returns_float: boolean = func_returns_float(f, isfloat);
    var chunks: string[] = [];
    // f64 params / result / locals get the f64 wasm type (wasm is typed, so
    // each value's local carries its kind directly — no width bookkeeping).
    var sig: string = "  (func $__fn_" + f.name;
    var p: i32 = 0;
    while (p < f.nparams) {
        if (isfloat[p] == 1) { sig = sig + " (param f64)"; } else { sig = sig + " (param i32)"; }
        p = p + 1;
    }
    if (returns_float) { sig = sig + " (result f64)\n"; } else { sig = sig + " (result i32)\n"; }
    chunks = chunks.append(sig);
    // Locals: SSA value ids nparams..nvals-1, then the dispatch state $pc at
    // index nvals.
    var v: i32 = f.nparams;
    while (v < f.nvals) {
        if (isfloat[v] == 1) { chunks = chunks.append("    (local f64)\n"); } else { chunks = chunks.append("    (local i32)\n"); }
        v = v + 1;
    }
    chunks = chunks.append("    (local i32) ;; $pc\n");
    var pc: i32 = f.nvals;
    var nb: i32 = f.blocks.len();
    // Initialise $pc to the entry block's dispatch index.
    chunks = chunks.append("    (local.set " + util.i32_to_string(pc) + " (i32.const " + util.i32_to_string(ssa.block_index(f, f.entry)) + "))\n");
    chunks = chunks.append("    (block $exit (loop $L\n");
    // Open the nested dispatch blocks, outermost ($blk nb-1) to innermost
    // ($blk0), then the br_table that branches to each by dispatch index.
    var bo: i32 = nb - 1;
    while (bo >= 0) { chunks = chunks.append("    (block $blk" + util.i32_to_string(bo) + "\n"); bo = bo - 1; }
    var brt: string = "    (br_table";
    var bi: i32 = 0;
    while (bi < nb) { brt = brt + " $blk" + util.i32_to_string(bi); bi = bi + 1; }
    brt = brt + " (local.get " + util.i32_to_string(pc) + "))\n";
    chunks = chunks.append(brt);
    // Close $blk0 then emit block 0's code, close $blk1 then block 1, … —
    // a br_table jump to $blkK lands right after $blkK's close, i.e. at
    // block K's code.
    bi = 0;
    while (bi < nb) {
        chunks = chunks.append("    ) ;; blk" + util.i32_to_string(bi) + "\n");
        chunks = chunks.append(emit_block(f, f.blocks[bi], pc, fnnames, isfloat));
        bi = bi + 1;
    }
    chunks = chunks.append("    ))\n");           // close loop + exit
    chunks = chunks.append("    (unreachable))\n"); // every path returns / loops
    return util.str_join_chunks(chunks);
}

// inst_supported reports whether this backend can lower an instruction
// kind. param / phi are structural (handled outside emit_inst) and count
// as supported.
function inst_supported(ins: ssa.SInst): boolean {
    var kind: i32 = ins.kind_tag;
    // f64_bits / f64_from_bits reinterprets produce / consume a 64-bit i64
    // pattern, which doesn't fit wasm32's i32 value model — fall back to the
    // AST wasm emitter for programs that use them.
    if (kind == 10) { return ins.str != "f64_bits" && ins.str != "f64_from_bits"; }   // unary
    return kind == 1 || kind == 2 || kind == 9                       // const_int / const_bool / binary
        || kind == 11 || kind == 6 || kind == 7                       // call / param / copy
        || kind == 8 || kind == 14 || kind == 15                      // phi / alloc / load_elem
        || kind == 16 || kind == 17 || kind == 18                     // store_elem / concat / streq
        || kind == 19 || kind == 13 || kind == 12                     // print / funcaddr / call_indirect
        || kind == 4 || kind == 5;                                    // const_float / const_str
}

// supported reports whether every instruction in every function is in the
// subset this backend lowers — the caller (fern.try_ssa) uses it to fall
// back to the AST wasm emitter for programs that need heap-backed ops.
pub function supported(funcs: ssa.SFunc[]): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        var f: ssa.SFunc = funcs[i];
        var b: i32 = 0;
        while (b < f.blocks.len()) {
            var blk: ssa.SBlock = f.blocks[b];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                if (!inst_supported(blk.insts[k])) { return false; }
                k = k + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return true;
}

// uses_kind reports whether any instruction in any function has the given
// kind — used to emit a runtime helper (and its imports) only when needed.
function uses_kind(funcs: ssa.SFunc[], kind_tag: i32): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        var b: i32 = 0;
        while (b < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[b];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                if (blk.insts[k].kind_tag == kind_tag) { return true; }
                k = k + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return false;
}

// concat_helper: __fern_ssa_concat(a, b) → a new [lenA+lenB, A words…, B
// words…] string. Strings are [len, c0, c1, …] with one i32 word per byte
// (the byte in the low octet), so concat copies whole words.
function concat_helper(): string {
    var o: string = "  (func $__fern_ssa_concat (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $p (global.get $__hp))\n";
    o = o + "    (global.set $__hp (i32.add (global.get $__hp) (i32.mul (i32.add (i32.add (local.get $la) (local.get $lb)) (i32.const 1)) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $p) (i32.add (local.get $la) (local.get $lb)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $da (loop $ca\n";
    o = o + "      (br_if $da (i32.ge_s (local.get $i) (local.get $la)))\n";
    o = o + "      (i32.store (i32.add (local.get $p) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2))) (i32.load (i32.add (local.get $a) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $ca)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.ge_s (local.get $i) (local.get $lb)))\n";
    o = o + "      (i32.store (i32.add (local.get $p) (i32.shl (i32.add (i32.add (local.get $la) (local.get $i)) (i32.const 1)) (i32.const 2))) (i32.load (i32.add (local.get $b) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $cb)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}

// streq_helper: __fern_ssa_streq(a, b) → 1 if equal content else 0.
function streq_helper(): string {
    var o: string = "  (func $__fern_ssa_streq (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (if (i32.ne (local.get $la) (i32.load (local.get $b))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $la)))\n";
    o = o + "      (if (i32.ne (i32.load (i32.add (local.get $a) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2)))) (i32.load (i32.add (local.get $b) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2))))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    return o;
}

// print_helper: __fern_ssa_print(h, fd) writes the string's bytes then a
// trailing '\n' to fd via fd_write, one byte per call (no scratch-size
// limit). Fern's print / eprint append a newline (the native backend, the
// interpreter, and the AST emitters all do). The fixed low-memory scratch:
// byte buffer at 0, iovec [base=0,len=1] at 8, nwritten at 16 — all inside
// the reserved [0,1024) region below $__hp.
function print_helper(): string {
    var o: string = "  (func $__fern_ssa_print (param $h i32) (param $fd i32)\n";
    o = o + "    (local $len i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $h)))\n";
    o = o + "    (i32.store (i32.const 8) (i32.const 0)) (i32.store (i32.const 12) (i32.const 1))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.const 0) (i32.load (i32.add (local.get $h) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2)))))\n";
    o = o + "      (drop (call $fd_write (local.get $fd) (i32.const 8) (i32.const 1) (i32.const 16)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $c)))\n";
    o = o + "    (i32.store8 (i32.const 0) (i32.const 10))\n";   // trailing newline
    o = o + "    (drop (call $fd_write (local.get $fd) (i32.const 8) (i32.const 1) (i32.const 16)))\n";
    o = o + "    )\n";
    return o;
}

// max_indirect_arity returns the largest call_indirect arg count (minus the
// code-pointer operand) across all functions, or -1 if there are none — the
// highest $clos<N> function type the module needs for its indirect calls.
function max_indirect_arity(funcs: ssa.SFunc[]): i32 {
    var m: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < funcs.len()) {
        var b: i32 = 0;
        while (b < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[b];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                if (blk.insts[k].kind_tag == 12) {  // call_indirect
                    var n: i32 = blk.insts[k].args.len() - 1;
                    if (n > m) { m = n; }
                }
                k = k + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return m;
}

// is_funcaddr_target reports whether `name` is taken as a function value
// anywhere (a funcaddr operand) — such a function needs a closure-callable
// table entry.
function is_funcaddr_target(funcs: ssa.SFunc[], name: string): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        var b: i32 = 0;
        while (b < funcs[i].blocks.len()) {
            var blk: ssa.SBlock = funcs[i].blocks[b];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                if (blk.insts[k].kind_tag == 13 && blk.insts[k].str == name) { return true; }
                k = k + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return false;
}

// clos_wrapper emits an env-dropping table wrapper for a no-env function used
// as a value. The closure convention passes the env box as a trailing arg to
// every indirect call, so a plain function (U params, no __env) needs a
// wrapper of arity U+1 that forwards the U user args and ignores the env —
// otherwise wasm's strictly-typed call_indirect ($clos<U+1>) traps on the
// function's U-param type. (Capturing lambdas already take __env, so they are
// called directly and need no wrapper.)
function clos_wrapper(f: ssa.SFunc): string {
    var o: string = "  (func $__clos_" + f.name;
    var p: i32 = 0;
    while (p < f.nparams) { o = o + " (param i32)"; p = p + 1; }
    o = o + " (param i32) (result i32)\n";   // trailing env param (ignored)
    o = o + "    (call $__fn_" + f.name;
    var a: i32 = 0;
    while (a < f.nparams) { o = o + " (local.get " + util.i32_to_string(a) + ")"; a = a + 1; }
    o = o + "))\n";
    return o;
}

// emit_program frames the whole module: the WASI proc_exit import (plus
// fd_write when print is used), an exported linear memory (WASI command
// modules require one), the $clos<N> function types + a function table when
// closures are used, the runtime helpers a program actually uses, each
// function body, then a `_start` that exits with main()'s value.
pub function emit_program(funcs: ssa.SFunc[]): string {
    var parts: string[] = [];
    parts = parts.append("(module\n");
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n");
    var has_print: boolean = uses_kind(funcs, 19);
    if (has_print) {
        parts = parts.append("  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n");
    }
    // A 16 MiB linear-memory arena (256 × 64 KiB pages) and a bump pointer
    // ($__hp) for the heap. The low 1 KiB is reserved (print scratch / null).
    parts = parts.append("  (memory (export \"memory\") 256)\n");
    parts = parts.append("  (global $__hp (mut i32) (i32.const 1024))\n");
    // Function values: a value is a table slot index; call_indirect dispatches
    // through a $clos<arity> type. Emit the types, a table of every function
    // (slot i = the closure-callable form of funcs[i]: the function itself if
    // it takes __env, else an env-dropping wrapper), and the wrappers.
    var fnnames: string[] = [];
    var ni: i32 = 0;
    while (ni < funcs.len()) { fnnames = fnnames.append(funcs[ni].name); ni = ni + 1; }
    var has_clos: boolean = uses_kind(funcs, 13) || uses_kind(funcs, 12);
    if (has_clos) {
        var maxa: i32 = max_indirect_arity(funcs);
        var a: i32 = 0;
        while (a <= maxa) {
            var ty: string = "  (type $clos" + util.i32_to_string(a) + " (func";
            var pj: i32 = 0;
            while (pj < a) { ty = ty + " (param i32)"; pj = pj + 1; }
            parts = parts.append(ty + " (result i32)))\n");
            a = a + 1;
        }
        parts = parts.append("  (table " + util.i32_to_string(funcs.len()) + " funcref)\n");
        var el: string = "  (elem (i32.const 0)";
        var ei: i32 = 0;
        while (ei < funcs.len()) {
            if (!funcs[ei].takes_env && is_funcaddr_target(funcs, funcs[ei].name)) {
                el = el + " $__clos_" + funcs[ei].name;
            } else {
                el = el + " $__fn_" + funcs[ei].name;
            }
            ei = ei + 1;
        }
        parts = parts.append(el + ")\n");
        var wi: i32 = 0;
        while (wi < funcs.len()) {
            if (!funcs[wi].takes_env && is_funcaddr_target(funcs, funcs[wi].name)) {
                parts = parts.append(clos_wrapper(funcs[wi]));
            }
            wi = wi + 1;
        }
    }
    if (uses_kind(funcs, 17)) { parts = parts.append(concat_helper()); }
    if (uses_kind(funcs, 18)) { parts = parts.append(streq_helper()); }
    if (has_print) { parts = parts.append(print_helper()); }
    var chunks: string[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        chunks = chunks.append(emit_func(funcs[i], fnnames));
        i = i + 1;
    }
    parts = parts.append(util.str_join_chunks(chunks));
    parts = parts.append("  (func $_start (call $proc_exit (call $__fn_main)))\n");
    parts = parts.append("  (export \"_start\" (func $_start))\n");
    parts = parts.append(")\n");
    return util.str_join_chunks(parts);
}
