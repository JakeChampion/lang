// examples/self_host/asm_arm64_load_run.fern — arm64 mirror of
// asm_load_run.fern. Takes an entry .fern file path on the command
// line, follows its `import "./x"` declarations to sibling files
// (and `std/…` / `core/…` under the optional second-arg stdlib
// root), loads them transitively, flattens, and prints aarch64
// assembly to stdout.
//
//     $ asm_arm64_load_run prog.fern [stdlib-root] > prog.s
//
// File-loading machinery is identical to asm_load_run; only the
// emitter import differs (./asm_arm64 instead of ./asm).

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./checker";
import "./asm_arm64";
import "./asm_ir";
import "./treeshake";

function last_slash(p: string): i32 {
    var i: i32 = 0;
    var last: i32 = 0 - 1;
    while (i < p.len()) {
        if (p[i] == 47) { last = i; }
        i = i + 1;
    }
    return last;
}

function dir_of(p: string): string {
    var ls: i32 = last_slash(p);
    if (ls < 0) { return ""; }
    return p[0:ls];
}

function module_name(import_path: string): string {
    var ls: i32 = last_slash(import_path);
    if (ls >= 0) { return import_path[ls + 1:import_path.len()]; }
    return import_path;
}

function is_local(import_path: string): boolean {
    if (import_path.len() == 0) { return false; }
    return import_path[0] == 46;
}

function join_path(dir: string, name: string): string {
    if (dir.len() == 0) { return name + ".fern"; }
    return dir + "/" + name + ".fern";
}

// contains_name -> util.has_str (SH-020).

function should_load(import_path: string, root: string): boolean {
    if (import_path.len() == 0) { return false; }
    if (is_local(import_path)) { return true; }
    if (root.len() == 0) { return false; }
    return true;
}

function resolve_path(import_path: string, entry_dir: string, root: string): string {
    if (is_local(import_path)) {
        return join_path(entry_dir, module_name(import_path));
    }
    return root + "/" + import_path + ".fern";
}

function add_imports(paths: string[], mod: parser.Module, root: string): string[] {
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var ip: string = mod.imports[i].path;
        if (should_load(ip, root) && !util.has_str(paths, ip)) {
            paths = paths.append(ip);
        }
        i = i + 1;
    }
    return paths;
}

function main(): i32 {
    var av: string[] = args();
    if (av.len() < 2) {
        eprint("usage: asm_arm64_load_run <entry.fern> [stdlib-root]\n");
        return 2;
    }
    var entry_path: string = av[1];
    var dir: string = dir_of(entry_path);
    // First non-flag arg after the entry is the stdlib root; flags mirror
    // asm_load_run: -no-treeshake opts out of the default (stdlib-root) prune,
    // -treeshake forces it on even without a root, -decide prints ir/ast.
    var root: string = "";
    var do_treeshake: boolean = false;
    var no_treeshake: boolean = false;
    var do_decide: boolean = false;
    var ag: i32 = 2;
    while (ag < av.len()) {
        if (av[ag] == "-treeshake") { do_treeshake = true; }
        else if (av[ag] == "-no-treeshake") { no_treeshake = true; }
        else if (av[ag] == "-decide") { do_decide = true; }
        else if (root == "") { root = av[ag]; }
        ag = ag + 1;
    }

    var esrc: string = "";
    var eok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { esrc = s; eok = true; },
        Err(e) => { eok = false; },
    }
    if (!eok) {
        eprint("asm_arm64_load_run: cannot read entry file\n");
        return 1;
    }
    var entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    var paths: string[] = add_imports([], entry_mod, root);
    var loaded: flatten.LoadedModule[] = [];
    var done: string[] = [];
    var j: i32 = 0;
    while (j < paths.len()) {
        var ipath: string = paths[j];
        j = j + 1;
        if (!util.has_str(done, ipath)) {
            done = done.append(ipath);
            var mpath: string = resolve_path(ipath, dir, root);
            var msrc: string = "";
            var mok: boolean = false;
            match (read_file(mpath)) {
                Ok(s2) => { msrc = s2; mok = true; },
                Err(e) => { mok = false; },
            }
            if (!mok) {
                eprint("asm_arm64_load_run: cannot read module: ");
                eprint(mpath);
                eprint("\n");
                return 1;
            }
            var m: parser.Module = parser.parse_module(lexer.tokenize(msrc));
            loaded = loaded.append(flatten.LoadedModule { name: module_name(ipath), mod: m });
            paths = add_imports(paths, m, root);
        }
    }

    var merged: parser.Module = flatten.bundle(entry_mod, loaded);

    // Prune unreachable functions so a stdlib-importing program fits the IR
    // budget (see asm_load_run.fern / treeshake.fern). Default-on with a stdlib
    // root; -no-treeshake opts out. The prune + the IR-eligibility decision are
    // target-agnostic, so arm64 routes exactly as x86-64 does.
    if ((do_treeshake || root.len() > 0) && !no_treeshake) { merged = treeshake.treeshake(merged); }

    // `-decide`: print the route (ir / ast) the merged module takes and stop.
    if (do_decide) {
        var dm: parser.Module = asm_ir.lift_lambdas(parser.module_with_builtins(merged));
        if (asm_ir.all_eligible(dm)) { print("ir\n"); } else { print("ast\n"); }
        return 0;
    }

    // Immutability gate (see asm_load_run.fern): reject the immutable-data
    // cycle rules (E048/E049/E055/E056) before codegen, filtered so the
    // partial checker's other rules can't false-positive-reject.
    var imm: checker.Diag[] = checker.filter_immutability(checker.check_module(merged).diags);
    if (imm.len() > 0) {
        eprint(checker.format_diags(imm));
        return 1;
    }

    write(asm_arm64.emit_module(parser.module_with_builtins(merged), false));
    return 0;
}
