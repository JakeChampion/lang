            // args [left, right], exactly as build_func lowers string `+`. The
            // fresh string is owned; irlower's RC around it is stripped like the
            // rest (SSA leaks).
            if (stack.len() < 2) { ok = false; }
            else {
                var cb: i32 = stack[stack.len() - 1];
                var ca: i32 = stack[stack.len() - 2];
                stack = drop_last2(stack);
                var ccv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 17, result: ccv, args: [ca, cb], imm: 0, str: "" });
                stack = stack.append(ccv);
            }
