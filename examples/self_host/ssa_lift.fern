            // Reset the global amortised-O(1) string builder. The op PUSHES a
            // (dummy) result in the IR stack model — as a statement it is
            // followed by a `drop` — so the lift pushes the inst's result to
            // keep the stack balanced. Mirrors build_func's strbuf_reset().
            var sbr: i32 = nvals; nvals = nvals + 1;
            cur_insts = cur_insts.append(ssa.SInst { kind_tag: 23, result: sbr, args: [], imm: 0, str: "" });
            stack = stack.append(sbr);
