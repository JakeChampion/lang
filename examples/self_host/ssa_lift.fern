                stack = drop_last(stack);
                var ifv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 10, result: ifv, args: [ifx], imm: 0, str: "as_f64" });
                stack = stack.append(ifv);
