            // args [left, right], result an i32 bool. irlower lowers `!=` as
            // str_eq followed by `not`, which the lift already handles.
            if (stack.len() < 2) { ok = false; }
            else {
                var eb: i32 = stack[stack.len() - 1];
                var ea: i32 = stack[stack.len() - 2];
                stack = drop_last2(stack);
                var eqv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 18, result: eqv, args: [ea, eb], imm: 0, str: "" });
                stack = stack.append(eqv);
            }
