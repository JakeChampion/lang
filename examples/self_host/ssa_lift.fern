// examples/self_host/ssa_lift.fern — lift the self-host STACK IR (ir.fern's
// `Op[]`) into SSA form (ssa.fern's `SFunc`), the self-hosted mirror of
// native's `internal/ssa/lift.go` (`LiftFromIR`). The lift is the front of
// `-backend ssa` (docs/SELFHOST-SSA-BACKEND.md): each lowered function's ops
// become one SFunc that `ssa.prune_dead`, `ssa.regalloc_linear` and the
// per-ISA emitters in `asm_arm64_ir.fern` and `asm_ir.fern` turn into code
// on the frame, ABI and runtime the stack machine this replaced used.
//
// What comes out is spelled onto the flat backends' layouts, never a layout
// of its own: a record field is a load at (i+1)*8 behind the shape word, an
// array's length a load at 0, a string's at 8, a construction a box
// allocation and stores, a string or runtime op the same helper call the
// flat arm makes, and an op with no selection of its own (the byte kernels,
// the map ops, the byte buffer, the string ops) a `flat_op` that runs the
// stack machine's arm between a push of the operands and a pop of the
// result. A binary carries its IR kind name and width (`str`, `imm`), a
// unary the op name, so the emitters select from the table the stack
// machine uses. The reference-count helper calls the lowering threads
// through stay calls, so an emitted function keeps the memory model of the
// stack-machine function beside it.
//
// The lift is a single linear pass over the op stream: the operand stack
// becomes value ids, the declared locals slots that phis merge at every
// scope exit and loop header, and the structured scopes (`block` / `loop` /
// `if` / `else` / `end`, `br` / `brif`) are tracked on an explicit scope
// stack. An op the lift cannot admit sets `ok=false` and names itself in
// `bail`, and the backend refuses the function naming it: every op the
// lowering produces has an arm, so a bail is a compiler bug (ircore.ssa_refuse).

import "./ir";
import "./ssa";
import "./util";

// `bail` names the IR op kind that forced ok=false (or "unbalanced-scope"),
// "" when the lift succeeded — a diagnostic for the coverage scan; the
// production drivers read only .func / .ok.
pub struct LResult { func: ssa.SFunc, ok: boolean, bail: string }

// ---- small array helpers (value-semantics, no slice syntax) -------------

// splice appends `more` onto the block's instruction list. A helper builds
// what it adds on a fresh list and the caller appends it here, onto a list
// only this frame holds: an append on the list passed INTO the helper copied
// the whole list, since the caller's reference kept it shared, and that made
// the lift quadratic on the compiler's largest functions.
function splice(insts: ssa.SInst[], more: ssa.SInst[]): ssa.SInst[] {
    for x in more { insts = insts.append(x); }
    return insts;
}

// The lift writes its slot vector and scope rows with `.with` on the local
// itself: an element update through a helper's parameter copies the whole
// array, since the caller's reference keeps it shared, and on the compiler's
// largest functions that copy per store made the lift quadratic. The scope
// stacks and rows never shrink: `sc_n` is the depth, a scope exit lowers it,
// and the next entry at that depth overwrites what the exit left.

function drop_last(a: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < a.len() - 1) { out = out.append(a[i]); i = i + 1; }
    return out;
}
function drop_last2(a: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < a.len() - 2) { out = out.append(a[i]); i = i + 1; }
    return out;
}
// put_at / put_at_s write v at depth d of a scope stack, growing it only past
// its length.
function put_at(own xs: i32[], d: i32, v: i32): i32[] {
    if (d < xs.len()) { return xs.with(d, v); }
    return xs.append(v);
}
function put_at_s(own xs: string[], d: i32, v: string): string[] {
    if (d < xs.len()) { return xs.with(d, v); }
    return xs.append(v);
}

// ---- IR binary-op kind -> SSA `binary`/`unary` op string ----------------

// LitWord / decimal_word parse an irlower literal's SOURCE TEXT into the i32 the
// SSA `const_int` holds. irlower carries integer literals as text so the AST
// backends can splice hex / full-u32 values straight into an immediate; the lift
// needs a number, and util.digits_to_i32 handles plain DECIMAL only — so a
// non-decimal literal reports ok=false and the caller bails rather than emitting
// a wrong constant. Shared by const_i32_text and const_struct's field words.
// The value-stack state a value-producing op reads and rewrites: the SSA
// value counter, the operand stack, the instructions built so far, and the
// ok flag a malformed op clears.
struct LiftVals { nvals: i32, stack: i32[], insts: ssa.SInst[], ok: boolean }

struct LitWord { ok: boolean, value: i32 }

function bin_sym(k: string): string {
    if (k == "add") { return "+"; }
    if (k == "sub") { return "-"; }
    if (k == "mul") { return "*"; }
    if (k == "div_s") { return "/"; }
    if (k == "div_u") { return "/"; }
    if (k == "rem_s") { return "%"; }
    if (k == "rem_u") { return "%"; }
    if (k == "eq") { return "=="; }
    if (k == "ne") { return "!="; }
    if (k == "lt_s") { return "<"; }
    if (k == "lt_u") { return "<"; }
    if (k == "le_s") { return "<="; }
    if (k == "le_u") { return "<="; }
    if (k == "gt_s") { return ">"; }
    if (k == "gt_u") { return ">"; }
    if (k == "ge_s") { return ">="; }
    if (k == "ge_u") { return ">="; }
    if (k == "and") { return "&"; }
    if (k == "or") { return "|"; }
    if (k == "xor") { return "^"; }
    if (k == "shl") { return "<<"; }
    if (k == "shr_s") { return ">>"; }
    if (k == "shr_u") { return ">>"; }
    return "";
}

// drop_n drops the last n elements (used to pop a stride-nslots scope row).
function drop_n(a: i32[], n: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < a.len() - n) { out = out.append(a[i]); i = i + 1; }
    return out;
}

// fbin_sym names the f64 binaries: "" for any other op. Arithmetic (fadd
// and the rest) yields an f64; a compare (feq and the rest) yields an i32
// 0/1. A float is its bit pattern in an integer register throughout, so the
// binary carries the op name and the emitter selects the float instruction.
function fbin_sym(k: string): string {
    if (k == "fadd") { return "+"; }
    if (k == "fsub") { return "-"; }
    if (k == "fmul") { return "*"; }
    if (k == "fdiv") { return "/"; }
    if (k == "feq") { return "=="; }
    if (k == "fne") { return "!="; }
    if (k == "flt") { return "<"; }
    if (k == "fle") { return "<="; }
    if (k == "fgt") { return ">"; }
    if (k == "fge") { return ">="; }
    return "";
}

// ---- the lift ------------------------------------------------------------

// admits reports whether the production lift has an arm for `op`: one of
// its own, or the stack machine's through flat_op.
pub function admits(op: ir.Op): boolean { return prod_kind(ir.kind_name(op.kind_tag)) || flat_arm_op(op); }

// flat_arm_op reports whether `op` can run through the stack machine's own
// arm (flat_op, 59): the arm pops what op_pops says, pushes one value, and
// reads no frame slot. dyn_dispatch's arm reads its arguments from the
// locals the lowering spilled them to, which the register path keeps no
// slots for; the lift has an instruction of its own for it (60).
function flat_arm_op(op: ir.Op): boolean {
    if (op.kind_tag == ir.kind_id("dyn_dispatch")) { return false; }
    return ir.op_pops(op) >= 0 && ir.op_pushes(op) == 1;
}

// lift_from_ir_prod is the lift the production backends read
// (docs/SELFHOST-SSA-BACKEND.md): it admits the integer spine, the structured
// control flow and every `call_direct` as instructions of its own, and every
// other op with a known stack effect through the stack machine's arm for it
// (flat_arm_op); what is left bails, naming the op. The runtime
// helper calls the lowering threads through — the reference-count pair, the
// per-type drops, the reclaim helpers — stay calls, so the emitted function
// keeps the memory model of the stack-machine function beside it. A binary
// carries its IR kind name and width (`str`, `imm`) rather than the symbol the
// optimiser reads, and an integer cast carries the cast in `str`, so the
// emitter selects instructions from the same table the stack machine does.
pub function lift_from_ir_prod(name: string, nparams: i32, nslots: i32, ops: ir.Op[]): LResult {
    return lift_impl(name, nparams, nslots, ops);
}

// prod_kind is the op vocabulary lift_from_ir_prod admits.
function prod_kind(k: string): boolean {
    if (bin_sym(k) != "") { return true; }
    var spine: string[] = ["const_i32", "const_i32_text", "const_i64",
        "int_extend", "int_wrap", "int_cast", "u32_wrap", "not",
        "load_local", "store_local", "tee_local", "drop", "return",
        "block", "loop", "if", "else", "end", "br", "brif", "call_direct", "dyn_dispatch"];
    for x in spine { if (x == k) { return true; } }
    return prod_mem_kind(k) || prod_float_kind(k);
}

// kind_class packs the three classifications lift_impl branches on: bit 0
// prod_kind, bit 1 prod_mem_kind, bit 2 prod_float_kind. lift_impl works it
// out once per kind it meets, since each builds and scans its name lists.
function kind_class(k: string): i32 {
    var c: i32 = 0;
    if (prod_kind(k)) { c = c + 1; }
    if (prod_mem_kind(k)) { c = c + 2; }
    if (prod_float_kind(k)) { c = c + 4; }
    return c;
}

// prod_float_kind is the f64 vocabulary: the literal, the arithmetic and
// compares, the single-instruction math, the conversions and reinterprets,
// and the transcendentals the stack machine calls the runtime for. A value
// is its 8-byte IEEE pattern in an integer register throughout, as on the
// stack machine, so the emitters need no float register class.
function prod_float_kind(k: string): boolean {
    if (fbin_sym(k) != "" || prod_float_call_argc(k) > 0) { return true; }
    var un: string[] = ["const_f64", "fsqrt", "ffloor", "fceil", "ftrunc", "fabs", "fround", "fneg",
        "i32_to_f64", "f64_to_i32", "f64_to_i64", "f32_bits", "f32_from_bits", "f64_bits", "f64_from_bits"];
    for x in un { if (x == k) { return true; } }
    return false;
}

// prod_float_call_argc is the operand count of a transcendental, which
// every backend calls a runtime helper for (kind 50 with the op's name).
function prod_float_call_argc(k: string): i32 {
    if (k == "fpow") { return 2; }
    if (k == "fsin" || k == "fcos" || k == "fexp" || k == "flog") { return 1; }
    return 0;
}

// lift_float_prod lifts one f64 op: a binary carries its kind name and width
// 64 like the integer binaries, a unary its kind name (an int-to-float
// conversion also its source width) with the unsigned flag in `imm`, and a
// reinterpret between f64 and i64 moves nothing.
function lift_float_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], insts: ssa.SInst[]): LiftVals {
    var argc: i32 = 1;
    if (fbin_sym(k) != "" || k == "fpow") { argc = 2; }
    if (stack.len() < argc) { return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: false }; }
    if (k == "f64_bits" || k == "f64_from_bits") { return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: true }; }
    var args: i32[] = [];
    var i: i32 = stack.len() - argc;
    while (i < stack.len()) { args = args.append(stack[i]); i = i + 1; }
    stack = drop_n(stack, argc);
    var v: i32 = nvals; nvals = nvals + 1;
    if (fbin_sym(k) != "") { insts = insts.append(ssa.SInst { kind_tag: 9, result: v, args: args, imm: 64, str: k }); }
    else if (prod_float_call_argc(k) > 0) { insts = insts.append(ssa.SInst { kind_tag: 50, result: v, args: args, imm: 0, str: k }); }
    else {
        var what: string = k;
        if (k == "i32_to_f64") {
            // The lowering leaves the width 0 on the widening it inserts at an
            // f64 parameter or in mixed arithmetic; the stack machine converts
            // that as a signed 32-bit source.
            var w: i32 = op.width;
            if (w == 0) { w = 32; }
            what = k + ":" + util.i32_to_string(w);
        }
        var flag: i32 = 0;
        if (op.unsigned) { flag = 1; }
        insts = insts.append(ssa.SInst { kind_tag: 10, result: v, args: args, imm: flag, str: what });
    }
    stack = stack.append(v);
    return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: true };
}

// prod_mem_kind is the op vocabulary lift_prod_mem lowers onto the flat
// backends' box layouts (ssa.fern's kinds 40..48).
function prod_mem_kind(k: string): boolean {
    var mem: string[] = ["struct_get", "struct_set", "tuple_set", "arr_len", "str_len", "tuple_get", "opt_tag", "opt_payload",
        "arr_get", "arr_set", "str_index", "const_func", "const_str", "variant_is", "struct_set_shape",
        "struct_make", "arr_make", "tuple_make", "opt_make", "opt_none", "str_slice",
        "raw_load_ptr", "raw_store_ptr", "raw_load8", "raw_store8", "struct_copy", "const_struct", "call_indirect"];
    for x in mem { if (x == k) { return true; } }
    return prod_call_argc(k) > 0 || prod_host_kind(k);
}

// prod_host_kind is the host floor the stack machine reaches without a Fern
// helper on the stack ABI: the raw syscalls, exit, the string box stamp, the
// string builder, the three static addresses and the full-width address add;
// with the zero-operand helper calls, which prod_call_argc cannot name.
function prod_host_kind(k: string): boolean {
    var host: string[] = ["syscall3", "syscall4", "syscall5", "syscall6", "exit", "raw_string", "strbuf_reset", "strbuf_append",
        "raw_scratch", "raw_environ", "raw_splice_pipe", "raw_addr", "monotonic_ns", "now_unix_ms",
        "load_i32", "load_i64", "load_ptr", "store_i32", "store_i64", "store_ptr", "raw_arr_box",
        "map_new", "strbuf_take", "args", "map_hash_seed", "arr_push_shared_bytes", "arr_push_shared_count"];
    for x in host { if (x == k) { return true; } }
    return k == "clz" || k == "ctz" || k == "popcount";
}

// lift_prod_host lifts one host-floor op: a syscall is a register-ABI call
// (50) carrying its name with the number first among its operands, as are
// exit, the string box stamp and the builder ops; the two static addresses
// are sym_addr (58) with the symbol in `str` and `imm` 1 when the word at it
// is wanted; raw_addr is the 64-bit add; the clock ops are stack-ABI calls
// with no operand. The width loads and stores at an address are the box
// load and store at offset 0, a 4-byte one carrying "i32" in `str`; a store
// leaves the zero the stack machine pushes in its place.
function lift_prod_host(k: string, op: ir.Op, lv: LiftVals): LiftVals {
    if (k == "clz" || k == "ctz" || k == "popcount") { return lift_pop_push(lv, 1, 10, 0, k + ":" + util.i32_to_string(op.width)); }
    if (k == "map_new") { return lift_pop_push(lv, 1, 50, 0, k); }
    if (k == "strbuf_take" || k == "args" || k == "map_hash_seed") { return lift_pop_push(lv, 0, 50, 0, k); }
    if (k == "arr_push_shared_bytes") { return lift_pop_push(lv, 0, 58, 1, "__fern_arr_push_copied"); }
    if (k == "arr_push_shared_count") { return lift_pop_push(lv, 0, 58, 1, "__fern_arr_push_shared"); }
    if (k == "load_i64" || k == "load_ptr") { return lift_pop_push(lv, 1, 40, 0, ""); }
    if (k == "load_i32") { return lift_pop_push(lv, 1, 10, 0, k); }
    if (k == "store_i64" || k == "store_ptr" || k == "store_i32") {
        var stored: LiftVals = lift_store(lv, 41, 0);
        if (!stored.ok) { return stored; }
        if (k == "store_i32") {
            var last: i32 = stored.insts.len() - 1;
            stored = LiftVals { ...stored, insts: stored.insts.with(last, ssa.SInst { ...stored.insts[last], str: "i32" }) };
        }
        return lift_pop_push(stored, 0, 1, 0, "");
    }
    if (k == "raw_arr_box") { return lift_pop_push(lv, 1, 50, 0, k); }
    if (k == "syscall3") { return lift_pop_push(lv, 4, 50, 0, k); }
    if (k == "syscall4") { return lift_pop_push(lv, 5, 50, 0, k); }
    if (k == "syscall5") { return lift_pop_push(lv, 6, 50, 0, k); }
    if (k == "syscall6") { return lift_pop_push(lv, 7, 50, 0, k); }
    if (k == "raw_string") { return lift_pop_push(lv, 2, 50, 0, k); }
    if (k == "exit" || k == "strbuf_append") { return lift_pop_push(lv, 1, 50, 0, k); }
    if (k == "strbuf_reset") { return lift_pop_push(lv, 0, 50, 0, k); }
    if (k == "raw_scratch") { return lift_pop_push(lv, 1, 58, 0, "__fern_scratch"); }
    if (k == "raw_environ") { return lift_pop_push(lv, 0, 58, 1, "__fern_envp"); }
    if (k == "raw_splice_pipe") { return lift_pop_push(lv, 0, 58, 0, "__fern_splice_pipe"); }
    if (k == "raw_addr") { return lift_pop_push(lv, 2, 9, 64, "add"); }
    return lift_pop_push(lv, 0, 49, 0, k);
}

// prod_call_argc is the operand count of an op the stack machine emits as a
// call into the runtime, 0 for any other op. str_call (49) reaches a
// Fern-compiled helper on the stack ABI with the arguments in order;
// rt_call (50) a routine on the register ABI.
function prod_call_argc(k: string): i32 {
    var two: string[] = ["str_concat", "str_eq", "str_cmp", "arr_push", "arr_push_owned", "arr_push_i64", "arr_push_f64", "arr_push_owned_i64", "arr_push_owned_f64"];
    for x in two { if (x == k) { return 2; } }
    var one: string[] = ["str_from_bytes", "alloc", "alloc_u8", "raw_alloc", "print_str", "eprint_str",
        "read_line", "read_file", "read_file_bytes", "remove_dir_all", "remove_file", "create_dir_all",
        "read_dir", "read_dir_all", "env", "stat", "lstat", "putchar", "temp_dir", "reader_close"];
    for y in one { if (y == k) { return 1; } }
    if (k == "arr_slice" || k == "subprocess") { return 3; }
    if (k == "write_file" || k == "write_file_exec" || k == "read_chunk" || k == "writer_write") { return 2; }
    return 0;
}
function prod_call_kind(k: string): i32 {
    if (k == "alloc" || k == "alloc_u8" || k == "raw_alloc" || util.str_has_prefix(k, "arr_push")) { return 50; }
    return 49;
}

// ld_off is the byte offset a single-load op reads at, or -1 when `k` is
// not one: a record field at (i+1)*8 behind the shape word, an array's
// length at 0, a string's length at 8, a tuple element at i*8, an Option
// box's tag at 0 and payload at 8.
function ld_off(k: string, op: ir.Op): i32 {
    if (k == "struct_get") { return (op.i32_imm + 1) * 8; }
    if (k == "arr_len" || k == "opt_tag") { return 0; }
    if (k == "str_len" || k == "opt_payload") { return 8; }
    if (k == "tuple_get") { return op.i32_imm * 8; }
    return 0 - 1;
}

// lift_prod_mem lowers one memory op onto kinds 40..48. Every arm pops what
// the stack machine pops and pushes what it pushes, so the operand stack
// stays aligned with the IR's own accounting.
function lift_prod_mem(k: string, op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[]): LiftVals {
    var lv: LiftVals = LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: true };
    if (prod_host_kind(k)) { return lift_prod_host(k, op, lv); }
    if (util.str_has_prefix(k, "raw_store") || k == "struct_set" || k == "tuple_set" || k == "arr_set") { return lift_prod_store(k, op, lv); }
    if (k == "variant_is") { return lift_variant_is_prod(op, lv); }
    if (k == "struct_set_shape") { return lift_struct_set_shape_prod(op, lv); }
    if (k == "str_slice") { return lift_pop_push(lv, 3, 51, view_in_frame(op), ""); }
    if (k == "call_indirect") { return lift_call_indirect_prod(op, lv); }
    if (prod_call_argc(k) > 0) { return lift_pop_push(lv, prod_call_argc(k), prod_call_kind(k), 0, k); }
    var made: LiftVals = lift_prod_make(k, op, lv);
    if (made.ok || made.stack.len() != lv.stack.len()) { return made; }
    return lift_prod_read(k, op, lv);
}

// call_indirect: the operand stack is [a0, .., a(n-1), target] with the
// function value on top; call_ind takes the target first, then the arguments.
function lift_call_indirect_prod(op: ir.Op, lv: LiftVals): LiftVals {
    var argc: i32 = op.i32_imm;
    if (lv.stack.len() < argc + 1) { return LiftVals { ...lv, ok: false }; }
    var target: i32 = lv.stack[lv.stack.len() - 1];
    var args: i32[] = [target];
    var d: i32 = argc;
    while (d >= 1) { args = args.append(lv.stack[lv.stack.len() - 1 - d]); d = d - 1; }
    var stack: i32[] = lv.stack;
    var e: i32 = 0;
    while (e <= argc) { stack = drop_last(stack); e = e + 1; }
    var v: i32 = lv.nvals;
    var insts: ssa.SInst[] = lv.insts.append(ssa.SInst { kind_tag: 56, result: v, args: args, imm: argc, str: "" });
    return LiftVals { nvals: v + 1, stack: stack.append(v), insts: insts, ok: true };
}

// lift_prod_store is the five stores: a record field, a tuple element and a
// checked array element push nothing back, the raw stores leave the stored
// value. A tuple element sits at `idx * 8` where a record field sits one shape
// word further in, the offsets `ld_off` already reads them back at, and every
// element rides the same eight bytes on these backends whatever its width —
// which is why the wide form takes this arm too, as the wide READ takes the
// plain load.
function lift_prod_store(k: string, op: ir.Op, lv: LiftVals): LiftVals {
    if (k == "struct_set") { return lift_store(lv, 41, (op.i32_imm + 1) * 8); }
    if (k == "tuple_set") { return lift_store(lv, 41, op.i32_imm * 8); }
    if (k == "arr_set") { return lift_store(lv, 43, 0); }
    if (k == "raw_store_ptr") { return lift_store_keep(lv, 53); }
    return lift_store_keep(lv, 55);
}

// lift_prod_make is the constructions: a box allocated and filled, or copied.
// For any other op it hands back `lv` unchanged with ok false, which
// lift_prod_mem reads as "not a construction".
function lift_prod_make(k: string, op: ir.Op, lv: LiftVals): LiftVals {
    if (k == "struct_make") { return lift_box_make(op.i32_imm + 1, op.i32_imm, 8, op.str, lv); }
    if (k == "arr_make") { return lift_box_make(op.i32_imm, op.i32_imm, 8, "", lv); }
    if (k == "tuple_make") { return lift_box_make(op.i32_imm, op.i32_imm, 0, "", lv); }
    if (k == "opt_make") { return lift_opt_make_prod(op.i32_imm, true, lv); }
    if (k == "opt_none") { return lift_opt_make_prod(1, false, lv); }
    if (k == "struct_copy") { return lift_struct_copy_prod(op, lv); }
    return LiftVals { ...lv, ok: false };
}

// A str_slice whose lowering gave it frame slots for the view box (i32_imm
// above 0) keeps a frame box in the SSA emit too, in words of the emitter's
// choosing; the emitter reads only whether it is one.
function view_in_frame(op: ir.Op): i32 {
    if (op.i32_imm > 0) { return 1; }
    return 0;
}

// lift_store_keep is a raw store that leaves the stored value on the stack,
// as raw_store_ptr and raw_store8 push it back.
function lift_store_keep(lv: LiftVals, kind: i32): LiftVals {
    if (lv.stack.len() < 3) { return LiftVals { ...lv, ok: false }; }
    var val: i32 = lv.stack[lv.stack.len() - 1];
    var stored: LiftVals = lift_store(lv, kind, 0);
    if (!stored.ok) { return stored; }
    return LiftVals { ...stored, stack: stored.stack.append(val) };
}

// struct_copy(box) copies `imm` fields through the runtime; the field count
// travels as a constant in the second register argument.
function lift_struct_copy_prod(op: ir.Op, lv: LiftVals): LiftVals {
    var n: LiftVals = lift_pop_push(lv, 0, 1, op.i32_imm, "");
    return lift_pop_push(n, 2, 50, 0, "struct_copy");
}

// lift_prod_read is the value-producing half: the single loads, the checked
// element and byte reads, and the two label addresses.
function lift_prod_read(k: string, op: ir.Op, lv: LiftVals): LiftVals {
    if (ld_off(k, op) >= 0) { return lift_pop_push(lv, 1, 40, ld_off(k, op), ""); }
    if (k == "raw_load_ptr") { return lift_pop_push(lv, 2, 52, 0, ""); }
    if (k == "raw_load8") { return lift_pop_push(lv, 2, 54, 0, ""); }
    if (k == "arr_get") { return lift_pop_push(lv, 2, 42, op.i32_imm, ""); }
    if (k == "str_index") { return lift_pop_push(lv, 2, 44, op.i32_imm, ""); }
    if (k == "const_func") { return lift_pop_push(lv, 0, 45, 0, op.str); }
    if (k == "const_struct") { return lift_pop_push(lv, 0, 57, 0, op.str); }
    return lift_pop_push(lv, 0, 47, 0, op.str);
}

// lift_pop_push pops `npop` operands (bottom first in args) and pushes the
// result of one instruction of kind `kind` over them.
function lift_pop_push(lv: LiftVals, npop: i32, kind: i32, imm: i32, str: string): LiftVals {
    if (lv.stack.len() < npop) { return LiftVals { ...lv, ok: false }; }
    var args: i32[] = [];
    var d: i32 = npop - 1;
    while (d >= 0) { args = args.append(lv.stack[lv.stack.len() - 1 - d]); d = d - 1; }
    var stack: i32[] = lv.stack;
    var e: i32 = 0;
    while (e < npop) { stack = drop_last(stack); e = e + 1; }
    var v: i32 = lv.nvals;
    var insts: ssa.SInst[] = lv.insts.append(ssa.SInst { kind_tag: kind, result: v, args: args, imm: imm, str: str });
    return LiftVals { nvals: v + 1, stack: stack.append(v), insts: insts, ok: true };
}

// lift_store is a store that pushes nothing: st_at pops [box, val], arr_st
// pops [base, idx, val] (val on top in both).
function lift_store(lv: LiftVals, kind: i32, imm: i32): LiftVals {
    var npop: i32 = 2;
    if (kind == 43 || kind == 53 || kind == 55) { npop = 3; }
    var pushed: LiftVals = lift_pop_push(lv, npop, kind, imm, "");
    if (!pushed.ok) { return pushed; }
    return LiftVals { ...pushed, stack: drop_last(pushed.stack) };
}

// struct_set_shape: write the interned shape address over slot 0 of the box on
// top of the stack and leave the box there. The store is the same kind 41 that
// struct_set uses at offset 0 and the address the same kind 46 variant_is
// compares against, so both emitters already select for it.
function lift_struct_set_shape_prod(op: ir.Op, lv: LiftVals): LiftVals {
    if (lv.stack.len() < 1) { return LiftVals { ...lv, ok: false }; }
    var box: i32 = lv.stack[lv.stack.len() - 1];
    var shape: LiftVals = lift_pop_push(lv, 0, 46, 0, op.str);
    if (!shape.ok) { return shape; }
    var stored: LiftVals = lift_store(shape, 41, 0);
    if (!stored.ok) { return stored; }
    return LiftVals { ...stored, stack: stored.stack.append(box) };
}

// variant_is: the shape word at 0 of the box against the variant's interned
// shape address, by pointer equality, as both flat backends test it.
function lift_variant_is_prod(op: ir.Op, lv: LiftVals): LiftVals {
    var tag: LiftVals = lift_pop_push(lv, 1, 40, 0, "");
    if (!tag.ok) { return tag; }
    var shape: LiftVals = lift_pop_push(tag, 0, 46, 0, op.str);
    return lift_pop_push(shape, 2, 9, 0, "eq");
}

// lift_box_make allocates a box of `cap` words and stores the `n` operands on
// the stack (the last pushed is the highest element) at `first` + i*8; a
// shape name stores the shape's address at 0 first, as struct_make does.
function lift_box_make(cap: i32, n: i32, first: i32, shape: string, lv: LiftVals): LiftVals {
    if (lv.stack.len() < n) { return LiftVals { ...lv, ok: false }; }
    var elems: i32[] = [];
    var d: i32 = n - 1;
    while (d >= 0) { elems = elems.append(lv.stack[lv.stack.len() - 1 - d]); d = d - 1; }
    var stack: i32[] = lv.stack;
    var e: i32 = 0;
    while (e < n) { stack = drop_last(stack); e = e + 1; }
    var nvals: i32 = lv.nvals;
    var box: i32 = nvals; nvals = nvals + 1;
    var insts: ssa.SInst[] = lv.insts.append(ssa.SInst { kind_tag: 48, result: box, args: [], imm: cap, str: "" });
    if (shape.len() > 0) {
        var sh: i32 = nvals; nvals = nvals + 1;
        insts = insts.append(ssa.SInst { kind_tag: 46, result: sh, args: [], imm: 0, str: shape });
        insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, sh], imm: 0, str: "" });
        nvals = nvals + 1;
    }
    var i: i32 = 0;
    while (i < n) {
        insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, elems[i]], imm: first + i * 8, str: "" });
        nvals = nvals + 1;
        i = i + 1;
    }
    return LiftVals { nvals: nvals, stack: stack.append(box), insts: insts, ok: true };
}

// lift_opt_make_prod builds the two-word Option box [tag@0, payload@8] the
// stack machine builds: opt_make pops the payload, opt_none stores 0.
function lift_opt_make_prod(tag: i32, has_payload: boolean, lv: LiftVals): LiftVals {
    var payload: i32 = 0 - 1;
    var stack: i32[] = lv.stack;
    if (has_payload) {
        if (stack.len() < 1) { return LiftVals { ...lv, ok: false }; }
        payload = stack[stack.len() - 1];
        stack = drop_last(stack);
    }
    var nvals: i32 = lv.nvals;
    var box: i32 = nvals; nvals = nvals + 1;
    var insts: ssa.SInst[] = lv.insts.append(ssa.SInst { kind_tag: 48, result: box, args: [], imm: 2, str: "" });
    var tv: i32 = nvals; nvals = nvals + 1;
    insts = insts.append(ssa.SInst { kind_tag: 1, result: tv, args: [], imm: tag, str: "" });
    insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, tv], imm: 0, str: "" });
    nvals = nvals + 1;
    if (payload < 0) {
        payload = nvals; nvals = nvals + 1;
        insts = insts.append(ssa.SInst { kind_tag: 1, result: payload, args: [], imm: 0, str: "" });
    }
    insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, payload], imm: 8, str: "" });
    nvals = nvals + 1;
    return LiftVals { nvals: nvals, stack: stack.append(box), insts: insts, ok: true };
}

// bin_str / bin_imm are what a lifted binary carries: the optimiser's symbol
// for the optimiser's consumers, the IR kind name and width for the production
// emitter.

// lift_int_narrow_prod lifts the integer width ops as the stack machine
// selects them: a pointer-width extend or wrap moves nothing, so the value
// flows through; the rest become one unary carrying the op (and the cast's
// target type) in `str` and the unsigned flag in `imm`.
function lift_int_narrow_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[], ok: boolean): LiftVals {
    if (stack.len() < 1) { return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: false }; }
    if ((k == "int_extend" || k == "int_wrap") && op.width == ir.width_ptr()) {
        return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: ok };
    }
    var a: i32 = stack[stack.len() - 1];
    stack = drop_last(stack);
    var what: string = k;
    if (k == "int_cast") { what = "int_cast:" + op.str; }
    var flag: i32 = 0;
    if (op.unsigned) { flag = 1; }
    var v: i32 = nvals; nvals = nvals + 1;
    cur_insts = cur_insts.append(ssa.SInst { kind_tag: 10, result: v, args: [a], imm: flag, str: what });
    stack = stack.append(v);
    return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: ok };
}

// lift_const_text_prod lifts a literal carried as source text to the text
// constant (kind 3), `imm` 64 for an i64 literal, which each emitter
// materialises the way its stack machine does.
function lift_const_text_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[]): LiftVals {
    var width: i32 = 0;
    if (k == "const_i64") { width = 64; }
    var v: i32 = nvals; nvals = nvals + 1;
    cur_insts = cur_insts.append(ssa.SInst { kind_tag: 3, result: v, args: [], imm: width, str: op.str });
    stack = stack.append(v);
    return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: true };
}

function lift_impl(name: string, nparams: i32, nslots: i32, ops: ir.Op[]): LResult {
    var nvals: i32 = 0;
    var next_blk: i32 = 0;
    var bail: string = "";   // the op kind that forced a fall-back (scan diagnostic)

    var blocks: ssa.SBlock[] = [];
    var cur_id: i32 = next_blk; next_blk = next_blk + 1;   // entry = block 0
    var cur_insts: ssa.SInst[] = [];
    var cur_preds: i32[] = [];
    var cur_term: ssa.STerm = STerm_none();
    var cur_dead: boolean = false;     // current block is unreachable (post-branch)

    var stack: i32[] = [];
    var slots: i32[] = [];
    var ok: boolean = true;

    // params -> value ids 0..nparams-1; declared locals -> const_int 0.
    var p: i32 = 0;
    while (p < nparams) {
        var pv: i32 = nvals; nvals = nvals + 1;
        cur_insts = cur_insts.append(ssa.SInst { kind_tag: 6, result: pv, args: [], imm: p, str: "" });
        slots = slots.append(pv);
        p = p + 1;
    }
    while (slots.len() < nslots) {
        var zv: i32 = nvals; nvals = nvals + 1;
        cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: zv, args: [], imm: 0, str: "" });
        slots = slots.append(zv);
    }

    // ---- unified scope stack (if / block / loop), innermost = last entry --
    // Per-scope (one entry each): kind, uid (edge ownership), target block id
    // (if->merge, block->exit, loop->header), and the if-only bookkeeping.
    var sc_kind: string[] = [];
    var sc_uid: i32[] = [];
    var sc_target: i32[] = [];
    var sc_else: i32[] = [];
    var sc_seen_else: i32[] = [];
    var sc_then_blk: i32[] = [];
    var sc_then_reaches: i32[] = [];
    var sc_parent: i32[] = [];
    // sc_edge_from: the edge count when the scope opened; its edges are the
    // ones recorded from there on, so an exit scans those rather than all.
    var sc_edge_from: i32[] = [];
    var sc_n: i32 = 0;
    // Per-scope stride-nslots rows (kept for EVERY scope so positions align):
    var sc_snap: i32[] = [];          // if: pre-if slots; else: unused
    var sc_then_slots: i32[] = [];     // if: then-arm exit slots
    var sc_header_phis: i32[] = [];    // loop: header phi value-id per slot
    var next_uid: i32 = 1;

    // ---- branch edges (global, tagged by owner scope uid) ----------------
    // Each br/brif records the predecessor block + its slot vector; the target
    // scope consumes its edges at `end` (loop -> header phis; block -> exit
    // merge). edge_vals is flattened stride-nslots.
    var edge_owner: i32[] = [];
    var edge_block: i32[] = [];
    var edge_vals: i32[] = [];

    // Each kind's name and kind_class, filled in the first time it appears.
    var top_tag: i32 = 0;
    for o in ops { if (o.kind_tag > top_tag) { top_tag = o.kind_tag; } }
    var knames: string[] = [];
    var kcls: i32[] = [];
    while (kcls.len() <= top_tag) { kcls = kcls.append(0 - 1); knames = knames.append(""); }
    var i: i32 = 0;
    while (i < ops.len() && ok) {
        var op: ir.Op = ops[i];
        var tag: i32 = op.kind_tag;
        if (tag < 0) { ok = false; bail = "invalid#" + util.i32_to_string(tag); i = i + 1; continue; }
        if (kcls[tag] < 0) {
            knames = knames.with(tag, ir.kind_name(tag));
            kcls = kcls.with(tag, kind_class(knames[tag]));
        }
        var k: string = knames[tag];
        var cls: i32 = kcls[tag];

        // Skip dead code after a terminator (e.g. ops after a `return`/`br`
        // inside an arm); only else/end/the matching block delimiters act on it.
        if (cur_term.kind_tag != 0 && k != "else" && k != "end") {
            i = i + 1;
            continue;
        }

        if ((cls & 1) == 0 && flat_arm_op(op)) {
            var lv: LiftVals = lift_pop_push(LiftVals { nvals: nvals, stack: stack, insts: [], ok: true }, ir.op_pops(op), 59, i, k);
            nvals = lv.nvals; stack = lv.stack; cur_insts = splice(cur_insts, lv.insts); ok = lv.ok;
        } else if ((cls & 1) == 0) {
            ok = false;
        } else if ((k == "const_i32_text" || k == "const_i64")) {
            var lv: LiftVals = lift_const_text_prod(k, op, nvals, stack, []);
            nvals = lv.nvals; stack = lv.stack; cur_insts = splice(cur_insts, lv.insts);
        } else if ((k == "int_extend" || k == "int_wrap" || k == "int_cast" || k == "u32_wrap")) {
            var lv: LiftVals = lift_int_narrow_prod(k, op, nvals, stack, [], ok);
            nvals = lv.nvals; stack = lv.stack; cur_insts = splice(cur_insts, lv.insts); ok = lv.ok;
        } else if ((cls & 2) != 0) {
            var lv: LiftVals = lift_prod_mem(k, op, nvals, stack, []);
            nvals = lv.nvals; stack = lv.stack; cur_insts = splice(cur_insts, lv.insts); ok = lv.ok;
        } else if (k != "const_f64" && (cls & 4) != 0) {
            var lv: LiftVals = lift_float_prod(k, op, nvals, stack, []);
            nvals = lv.nvals; stack = lv.stack; cur_insts = splice(cur_insts, lv.insts); ok = lv.ok;
        } else if (k == "const_i32") {
            var v: i32 = nvals; nvals = nvals + 1;
            cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: op.i32_imm, str: "" });
            stack = stack.append(v);
        } else if (k == "const_f64") {
            // An f64 literal, carried as source text: the const_float inst,
            // which each emitter materialises as the literal's bits.
            var fcv: i32 = nvals; nvals = nvals + 1;
            cur_insts = cur_insts.append(ssa.SInst { kind_tag: 4, result: fcv, args: [], imm: 0, str: op.str });
            stack = stack.append(fcv);
        } else if (k == "load_local") {
            if (op.i32_imm < 0 || op.i32_imm >= slots.len()) { ok = false; }
            else { stack = stack.append(slots[op.i32_imm]); }
        } else if (k == "store_local") {
            if (stack.len() < 1) { ok = false; }
            else {
                var sv: i32 = stack[stack.len() - 1];
                stack = drop_last(stack);
                slots = slots.with(op.i32_imm, sv);
            }
        } else if (k == "tee_local") {
            if (stack.len() < 1) { ok = false; }
            else { slots = slots.with(op.i32_imm, stack[stack.len() - 1]); }
        } else if (bin_sym(k) != "") {
            if (stack.len() < 2) { ok = false; }
            else {
                var r: i32 = stack[stack.len() - 1];
                var l: i32 = stack[stack.len() - 2];
                stack = drop_last2(stack);
                var bv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 9, result: bv, args: [l, r], imm: op.width, str: k });
                stack = stack.append(bv);
            }
        } else if (k == "not") {
            if (stack.len() < 1) { ok = false; }
            else {
                var x: i32 = stack[stack.len() - 1];
                stack = drop_last(stack);
                var nv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 10, result: nv, args: [x], imm: 0, str: "!" });
                stack = stack.append(nv);
            }
        } else if (k == "call_direct") {
            var lv: LiftVals = lift_call_direct(op, nvals, stack, [], ok);
            nvals = lv.nvals; stack = lv.stack; cur_insts = splice(cur_insts, lv.insts); ok = lv.ok;
        } else if (k == "dyn_dispatch") {
            // The receiver and the arguments are the values of the argc
            // consecutive slots from base_slot the lowering stored them to;
            // the instruction carries them as operands and the op's index
            // for its labels.
            var dargs: i32[] = [];
            var dk: i32 = 0;
            while (dk < op.width) {
                if (op.i32_imm + dk < 0 || op.i32_imm + dk >= slots.len()) { ok = false; }
                else { dargs = dargs.append(slots[op.i32_imm + dk]); }
                dk = dk + 1;
            }
            var dv: i32 = nvals; nvals = nvals + 1;
            cur_insts = cur_insts.append(ssa.SInst { kind_tag: 60, result: dv, args: dargs, imm: i, str: op.str });
            stack = stack.append(dv);
        } else if (k == "drop") {
            if (stack.len() < 1) { ok = false; } else { stack = drop_last(stack); }
        } else if (k == "return") {
            if (stack.len() < 1) { ok = false; }
            else {
                var rv: i32 = stack[stack.len() - 1];
                stack = drop_last(stack);
                cur_term = STerm_ret(rv);
            }
        } else if (k == "if") {
            if (op.i32_imm != 0) { ok = false; }
            else if (stack.len() < 1) { ok = false; }
            else {
                var cond: i32 = stack[stack.len() - 1];
                stack = drop_last(stack);
                var then_id: i32 = next_blk; next_blk = next_blk + 1;
                var else_id: i32 = next_blk; next_blk = next_blk + 1;
                var merge_id: i32 = next_blk; next_blk = next_blk + 1;
                var parent_id: i32 = cur_id;
                cur_term = STerm_brif(cond, then_id, else_id);
                blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
                // push an if-scope
                sc_kind = put_at_s(sc_kind, sc_n, "if");
                sc_uid = put_at(sc_uid, sc_n, next_uid); next_uid = next_uid + 1;
                sc_target = put_at(sc_target, sc_n, merge_id);
                sc_else = put_at(sc_else, sc_n, else_id);
                sc_seen_else = put_at(sc_seen_else, sc_n, 0);
                sc_then_blk = put_at(sc_then_blk, sc_n, 0 - 1);
                sc_then_reaches = put_at(sc_then_reaches, sc_n, 0);
                sc_parent = put_at(sc_parent, sc_n, parent_id);
                sc_edge_from = put_at(sc_edge_from, sc_n, edge_owner.len());
                sc_n = sc_n + 1;
                var rd_if: i32 = sc_n - 1;
                var rs_rd_if: i32 = 0;
                while (rs_rd_if < nslots) {
                    var at_rd_if: i32 = rd_if * nslots + rs_rd_if;
                    if (at_rd_if < sc_snap.len()) {
                        sc_snap = sc_snap.with(at_rd_if, slots[rs_rd_if]); sc_then_slots = sc_then_slots.with(at_rd_if, 0); sc_header_phis = sc_header_phis.with(at_rd_if, 0);
                    } else {
                        sc_snap = sc_snap.append(slots[rs_rd_if]); sc_then_slots = sc_then_slots.append(0); sc_header_phis = sc_header_phis.append(0);
                    }
                    rs_rd_if = rs_rd_if + 1;
                }
                cur_id = then_id; cur_insts = []; cur_preds = [parent_id]; cur_term = STerm_none(); cur_dead = false;
            }
        } else if (k == "else") {
            var top: i32 = sc_n - 1;
            if (top < 0 || sc_kind[top] != "if" || sc_seen_else[top] == 1) { ok = false; }
            else {
                var merge_id2: i32 = sc_target[top];
                // The then-arm reaches the merge only if it ran off its end
                // live — not if it returned, nor if it branched out (break /
                // continue), which leaves cur_dead with an empty terminator.
                var reaches: i32 = 0; if (cur_term.kind_tag == 0 && !cur_dead) { reaches = 1; }
                if (reaches == 1) { cur_term = STerm_br(merge_id2); }
                sc_then_blk = sc_then_blk.with(top, cur_id);
                sc_then_reaches = sc_then_reaches.with(top, reaches);
                var fs: i32 = 0;
                while (fs < nslots) { sc_then_slots = sc_then_slots.with(top * nslots + fs, slots[fs]); fs = fs + 1; }
                // Don't emit a phantom block for an arm that already branched
                // out (its real terminated block was appended at the branch).
                if (!cur_dead) { blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds }); }
                sc_seen_else = sc_seen_else.with(top, 1);
                var rs: i32 = 0;
                while (rs < nslots) { slots = slots.with(rs, sc_snap[top * nslots + rs]); rs = rs + 1; }
                cur_id = sc_else[top]; cur_insts = []; cur_preds = [sc_parent[top]]; cur_term = STerm_none(); cur_dead = false;
            }
        } else if (k == "block") {
            var exit_id: i32 = next_blk; next_blk = next_blk + 1;
            sc_kind = put_at_s(sc_kind, sc_n, "block");
            sc_uid = put_at(sc_uid, sc_n, next_uid); next_uid = next_uid + 1;
            sc_target = put_at(sc_target, sc_n, exit_id);
            sc_else = put_at(sc_else, sc_n, 0);
            sc_seen_else = put_at(sc_seen_else, sc_n, 0);
            sc_then_blk = put_at(sc_then_blk, sc_n, 0);
            sc_then_reaches = put_at(sc_then_reaches, sc_n, 0);
            sc_parent = put_at(sc_parent, sc_n, 0);
            sc_edge_from = put_at(sc_edge_from, sc_n, edge_owner.len());
            sc_n = sc_n + 1;
            var rd_blk: i32 = sc_n - 1;
            var rs_rd_blk: i32 = 0;
            while (rs_rd_blk < nslots) {
                var at_rd_blk: i32 = rd_blk * nslots + rs_rd_blk;
                if (at_rd_blk < sc_snap.len()) {
                    sc_snap = sc_snap.with(at_rd_blk, 0); sc_then_slots = sc_then_slots.with(at_rd_blk, 0); sc_header_phis = sc_header_phis.with(at_rd_blk, 0);
                } else {
                    sc_snap = sc_snap.append(0); sc_then_slots = sc_then_slots.append(0); sc_header_phis = sc_header_phis.append(0);
                }
                rs_rd_blk = rs_rd_blk + 1;
            }
        } else if (k == "loop") {
            var hdr_id: i32 = next_blk; next_blk = next_blk + 1;
            var entry_blk: i32 = cur_id;
            var luid: i32 = next_uid; next_uid = next_uid + 1;
            // close the entry block with a br to the header; record the entry edge.
            cur_term = STerm_br(hdr_id);
            blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
            edge_owner = edge_owner.append(luid); edge_block = edge_block.append(entry_blk);
            var ev: i32 = 0;
            while (ev < nslots) { edge_vals = edge_vals.append(slots[ev]); ev = ev + 1; }
            // header block: a placeholder phi per slot (args filled at `end`).
            var hdr_insts: ssa.SInst[] = [];
            var hp_row: i32[] = [];
            var hs: i32 = 0;
            while (hs < nslots) {
                var ph: i32 = nvals; nvals = nvals + 1;
                hdr_insts = hdr_insts.append(ssa.SInst { kind_tag: 8, result: ph, args: [], imm: 0, str: "" });
                hp_row = hp_row.append(ph);
                slots = slots.with(hs, ph);
                hs = hs + 1;
            }
            sc_kind = put_at_s(sc_kind, sc_n, "loop");
            sc_uid = put_at(sc_uid, sc_n, luid);
            sc_target = put_at(sc_target, sc_n, hdr_id);
            sc_else = put_at(sc_else, sc_n, 0);
            sc_seen_else = put_at(sc_seen_else, sc_n, 0);
            sc_then_blk = put_at(sc_then_blk, sc_n, 0);
            sc_then_reaches = put_at(sc_then_reaches, sc_n, 0);
            sc_parent = put_at(sc_parent, sc_n, entry_blk);
            sc_edge_from = put_at(sc_edge_from, sc_n, edge_owner.len() - 1);
            sc_n = sc_n + 1;
            var rd_loop: i32 = sc_n - 1;
            var rs_rd_loop: i32 = 0;
            while (rs_rd_loop < nslots) {
                var at_rd_loop: i32 = rd_loop * nslots + rs_rd_loop;
                if (at_rd_loop < sc_snap.len()) {
                    sc_snap = sc_snap.with(at_rd_loop, 0); sc_then_slots = sc_then_slots.with(at_rd_loop, 0); sc_header_phis = sc_header_phis.with(at_rd_loop, hp_row[rs_rd_loop]);
                } else {
                    sc_snap = sc_snap.append(0); sc_then_slots = sc_then_slots.append(0); sc_header_phis = sc_header_phis.append(hp_row[rs_rd_loop]);
                }
                rs_rd_loop = rs_rd_loop + 1;
            }
            cur_id = hdr_id; cur_insts = hdr_insts; cur_preds = [entry_blk]; cur_term = STerm_none(); cur_dead = false;
        } else if (k == "br" || k == "brif") {
            var depth: i32 = op.i32_imm;
            var pos: i32 = sc_n - 1 - depth;
            if (pos < 0 || pos >= sc_n) { ok = false; }
            else {
                var cond_b: i32 = 0;
                var ok_b: boolean = true;
                if (k == "brif") {
                    if (stack.len() < 1) { ok_b = false; }
                    else { cond_b = stack[stack.len() - 1]; stack = drop_last(stack); }
                }
                if (!ok_b) { ok = false; }
                else {
                    var tgt: i32 = sc_target[pos];
                    var owner: i32 = sc_uid[pos];
                    var obid: i32 = cur_id;
                    // record this out-edge for the target scope's merge.
                    edge_owner = edge_owner.append(owner); edge_block = edge_block.append(obid);
                    var bv2: i32 = 0;
                    while (bv2 < nslots) { edge_vals = edge_vals.append(slots[bv2]); bv2 = bv2 + 1; }
                    if (k == "br") {
                        cur_term = STerm_br(tgt);
                        blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
                        cur_id = next_blk; next_blk = next_blk + 1; cur_insts = []; cur_preds = []; cur_term = STerm_none(); cur_dead = true;
                    } else {
                        var ftid: i32 = next_blk; next_blk = next_blk + 1;
                        cur_term = STerm_brif(cond_b, tgt, ftid);
                        blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
                        cur_id = ftid; cur_insts = []; cur_preds = [obid]; cur_term = STerm_none(); cur_dead = false;
                    }
                }
            }
        } else if (k == "end") {
            var t2: i32 = sc_n - 1;
            if (t2 < 0) { ok = false; }
            else if (sc_kind[t2] == "if") {
                var merge3: i32 = sc_target[t2];
                var parent3: i32 = sc_parent[t2];
                if (sc_seen_else[t2] == 0) {
                    var else_id_a: i32 = sc_else[t2];
                    var t_reaches: i32 = 0; if (cur_term.kind_tag == 0 && !cur_dead) { t_reaches = 1; }
                    var then_blk: i32 = cur_id;
                    var then_slots_a: i32[] = slots;
                    if (t_reaches == 1) { cur_term = STerm_br(merge3); }
                    if (!cur_dead) { blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds }); }
                    blocks = blocks.append(ssa.SBlock { id: else_id_a, insts: [], term: STerm_br(merge3), preds: [parent3] });
                    var preds_a: i32[] = [];
                    if (t_reaches == 1) { preds_a = preds_a.append(then_blk); }
                    preds_a = preds_a.append(else_id_a);
                    cur_id = merge3; cur_insts = []; cur_preds = preds_a; cur_term = STerm_none(); cur_dead = false;
                    var s2: i32 = 0;
                    while (s2 < nslots) {
                        var snapv: i32 = sc_snap[t2 * nslots + s2];
                        if (t_reaches == 1) {
                            var tv2: i32 = then_slots_a[s2];
                            if (tv2 != snapv) {
                                var ph2a: i32 = nvals; nvals = nvals + 1;
                                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 8, result: ph2a, args: [tv2, snapv], imm: 0, str: "" });
                                slots = slots.with(s2, ph2a);
                            } else { slots = slots.with(s2, tv2); }
                        } else { slots = slots.with(s2, snapv); }
                        s2 = s2 + 1;
                    }
                } else {
                    var e_reaches: i32 = 0; if (cur_term.kind_tag == 0 && !cur_dead) { e_reaches = 1; }
                    var else_blk: i32 = cur_id;
                    var else_slots_a: i32[] = slots;
                    if (e_reaches == 1) { cur_term = STerm_br(merge3); }
                    if (!cur_dead) { blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds }); }
                    var then_blk2: i32 = sc_then_blk[t2];
                    var then_reaches2: i32 = sc_then_reaches[t2];
                    var preds_b: i32[] = [];
                    if (then_reaches2 == 1) { preds_b = preds_b.append(then_blk2); }
                    if (e_reaches == 1) { preds_b = preds_b.append(else_blk); }
                    cur_id = merge3; cur_insts = []; cur_preds = preds_b; cur_term = STerm_none(); cur_dead = (preds_b.len() == 0);
                    var s3: i32 = 0;
                    while (s3 < nslots) {
                        var tvv: i32 = sc_then_slots[t2 * nslots + s3];
                        var evv: i32 = else_slots_a[s3];
                        if (then_reaches2 == 1 && e_reaches == 1) {
                            if (tvv != evv) {
                                var ph3: i32 = nvals; nvals = nvals + 1;
                                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 8, result: ph3, args: [tvv, evv], imm: 0, str: "" });
                                slots = slots.with(s3, ph3);
                            } else { slots = slots.with(s3, tvv); }
                        } else if (then_reaches2 == 1) { slots = slots.with(s3, tvv); }
                        else if (e_reaches == 1) { slots = slots.with(s3, evv); }
                        else { slots = slots.with(s3, tvv); }
                        s3 = s3 + 1;
                    }
                }
                sc_n = sc_n - 1;
            } else if (sc_kind[t2] == "loop") {
                // A body whose last statement returns reaches the loop's end
                // as a live, terminated block; it is appended here. One that
                // falls off the end continues after the loop, in the enclosing
                // scope: it branches to a fresh block that becomes current,
                // with the body's slot values, once the header is rebuilt.
                var lf: LoopFall = loop_fall(cur_dead, cur_term, cur_id, next_blk, slots);
                next_blk = lf.next_blk;
                if (lf.falls) { cur_term = STerm_br(lf.cont); }
                blocks = loop_tail_appended(blocks, cur_dead, cur_id, cur_insts, cur_term, cur_preds);
                var luid2: i32 = sc_uid[t2];
                var hid: i32 = sc_target[t2];
                // collect this loop's incoming edges (entry + back-edges).
                var eidx: i32[] = [];
                var j: i32 = sc_edge_from[t2];
                while (j < edge_owner.len()) { if (edge_owner[j] == luid2) { eidx = eidx.append(j); } j = j + 1; }
                var lpreds: i32[] = [];
                var q: i32 = 0;
                while (q < eidx.len()) { lpreds = lpreds.append(edge_block[eidx[q]]); q = q + 1; }
                // rebuild the header block: fill each placeholder phi's args.
                var nb: ssa.SBlock[] = [];
                var bi: i32 = 0;
                while (bi < blocks.len()) {
                    var b: ssa.SBlock = blocks[bi];
                    if (b.id == hid) {
                        var ni: ssa.SInst[] = [];
                        var ii: i32 = 0;
                        while (ii < b.insts.len()) {
                            var inst: ssa.SInst = b.insts[ii];
                            // The header's first nslots instructions are its
                            // placeholder phis, one per slot in slot order.
                            var sslot: i32 = 0 - 1;
                            if (ii < nslots && sc_header_phis[t2 * nslots + ii] == inst.result) { sslot = ii; }
                            if (inst.kind_tag == 8 && sslot >= 0) {
                                var pargs: i32[] = [];
                                var qq: i32 = 0;
                                while (qq < eidx.len()) { pargs = pargs.append(edge_vals[eidx[qq] * nslots + sslot]); qq = qq + 1; }
                                ni = ni.append(ssa.SInst { kind_tag: 8, result: inst.result, args: pargs, imm: 0, str: "" });
                            } else { ni = ni.append(inst); }
                            ii = ii + 1;
                        }
                        nb = nb.append(ssa.SBlock { id: b.id, insts: ni, term: b.term, preds: lpreds });
                    } else { nb = nb.append(b); }
                    bi = bi + 1;
                }
                blocks = nb;
                cur_dead = true;
                if (lf.falls) {
                    slots = lf.slots;
                    cur_preds = [lf.tail]; cur_id = lf.cont; cur_insts = []; cur_term = STerm_none(); cur_dead = false;
                } else {
                    // Nothing leaves the loop alive and the tail block was
                    // just appended, so control continues in a FRESH dead
                    // block — the same shape `br` leaves behind. Staying on
                    // the published id let a later unconditional append (the
                    // function's own tail, an `if`, a `loop`) emit that block
                    // a second time, and two entries with one id spell one
                    // label twice (#9688).
                    cur_id = next_blk; next_blk = next_blk + 1;
                    cur_insts = []; cur_preds = []; cur_term = STerm_none();
                    var rsl: i32 = 0;
                    while (rsl < nslots) { slots = slots.with(rsl, sc_header_phis[t2 * nslots + rsl]); rsl = rsl + 1; }
                }
                sc_n = sc_n - 1;
            } else {
                // block: open the exit, merging all br/brif-out edges (+ a
                // fall-through edge if the current block reaches `end` live).
                var buid: i32 = sc_uid[t2];
                var eid: i32 = sc_target[t2];
                var bidx: i32[] = [];
                var jb: i32 = sc_edge_from[t2];
                while (jb < edge_owner.len()) { if (edge_owner[jb] == buid) { bidx = bidx.append(jb); } jb = jb + 1; }
                var falls_through: boolean = (!cur_dead) && (cur_term.kind_tag == 0);
                var fcur: i32 = cur_id;
                var fslots: i32[] = slots;
                // A LIVE current block is always emitted: with a synthesized
                // br-to-exit if it runs off the end, or as-is if it already ended
                // in a `return`. Only the fall-through case feeds the exit merge.
                // (Without the return case, a match arm's body — a block whose
                // fall-through path ends in `return` — would dangle: branched-to
                // by the arm's brif but never appended.)
                if (!cur_dead) {
                    if (falls_through) { cur_term = STerm_br(eid); }
                    blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
                }
                var bpreds: i32[] = [];
                var qb: i32 = 0;
                while (qb < bidx.len()) { bpreds = bpreds.append(edge_block[bidx[qb]]); qb = qb + 1; }
                if (falls_through) { bpreds = bpreds.append(fcur); }
                var eo_insts: ssa.SInst[] = [];
                var es: i32 = 0;
                while (es < nslots) {
                    var vals: i32[] = [];
                    var qe: i32 = 0;
                    while (qe < bidx.len()) { vals = vals.append(edge_vals[bidx[qe] * nslots + es]); qe = qe + 1; }
                    if (falls_through) { vals = vals.append(fslots[es]); }
                    if (vals.len() == 0) {
                        // unreachable exit; leave slot as-is.
                    } else {
                        var first: i32 = vals[0];
                        var alleq: boolean = true;
                        var qv: i32 = 0;
                        while (qv < vals.len()) { if (vals[qv] != first) { alleq = false; } qv = qv + 1; }
                        if (alleq) { slots = slots.with(es, first); }
                        else {
                            var phe: i32 = nvals; nvals = nvals + 1;
                            eo_insts = eo_insts.append(ssa.SInst { kind_tag: 8, result: phe, args: vals, imm: 0, str: "" });
                            slots = slots.with(es, phe);
                        }
                    }
                    es = es + 1;
                }
                cur_id = eid; cur_insts = eo_insts; cur_preds = bpreds; cur_term = STerm_none();
                cur_dead = (bpreds.len() == 0);
                sc_n = sc_n - 1;
            }
        } else {
            ok = false;   // outside the slice — caller falls back.
        }
        // Record the offending op kind the first time the lift bails (any
        // branch above — unhandled op, width-64, stack underflow, …). A tag
        // ir.kind_name can't render carries its raw id (#5452 — a bare
        // "invalid" hid the registry skew that unnamed struct_copy=198).
        if (!ok && bail == "") {
            bail = k;
            if (k == "invalid") { bail = bail + "#" + util.i32_to_string(op.kind_tag); }
        }
        i = i + 1;
    }

    if (ok && sc_n != 0) { ok = false; bail = "unbalanced-scope"; }   // unbalanced scopes

    if (ok) {
        if (cur_term.kind_tag == 0 && stack.len() >= 1) {
            cur_term = STerm_ret(stack[stack.len() - 1]);
        } else if (cur_term.kind_tag == 0 && !cur_dead) {
            // A REACHABLE final block with no value on the stack still needs a
            // terminator so it is emitted. This is the exhaustive-match exit:
            // when every arm diverges (returns), the block's structural exit is
            // reachable only through the dead "no arm matched" default edge — a
            // br into a block that would otherwise be dropped (empty + untermed),
            // dangling that edge's label. A dummy `ret 0` (never executed) makes
            // the block real. Mirrors how native fills an unreachable exit.
            var dz: i32 = nvals; nvals = nvals + 1;
            cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: dz, args: [], imm: 0, str: "" });
            cur_term = STerm_ret(dz);
        }
        if (cur_term.kind_tag != 0 || cur_insts.len() > 0 || cur_id == 0) {
            blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
        }
    }

    var f: ssa.SFunc = ssa.SFunc { name: name, nparams: nparams, nvals: nvals, blocks: blocks, entry: 0, takes_env: false };
    return LResult { func: f, ok: ok, bail: bail };
}

// LoopFall is a loop body that reaches the loop's end alive and unterminated:
// `tail` is that block, `cont` the fresh block control continues in after
// the loop, `slots` the body's slot values there.
struct LoopFall { falls: boolean, tail: i32, cont: i32, next_blk: i32, slots: i32[] }

function loop_fall(dead: boolean, term: ssa.STerm, id: i32, next_blk: i32, slots: i32[]): LoopFall {
    if (dead || term.kind_tag != 0) { return LoopFall { falls: false, tail: id, cont: 0 - 1, next_blk: next_blk, slots: slots }; }
    return LoopFall { falls: true, tail: id, cont: next_blk, next_blk: next_blk + 1, slots: slots };
}

function loop_tail_appended(blocks: ssa.SBlock[], dead: boolean, id: i32, insts: ssa.SInst[], term: ssa.STerm, preds: i32[]): ssa.SBlock[] {
    if (dead || term.kind_tag == 0) { return blocks; }
    return blocks.append(ssa.SBlock { id: id, insts: insts, term: term, preds: preds });
}

// In production mode every callee is a call, the runtime helpers included:
// the emitted function keeps the stack machine's memory model.
function lift_call_direct(op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[], ok: boolean): LiftVals {
    var argc: i32 = op.i32_imm;
    if (stack.len() < argc) { ok = false; }
    else {
        var cargs: i32[] = [];
        var d: i32 = argc - 1;
        while (d >= 0) { cargs = cargs.append(stack[stack.len() - 1 - d]); d = d - 1; }
        var e: i32 = 0;
        while (e < argc) { stack = drop_last(stack); e = e + 1; }
        var pv: i32 = nvals; nvals = nvals + 1;
        cur_insts = cur_insts.append(ssa.SInst { kind_tag: 11, result: pv, args: cargs, imm: 0, str: op.str });
        stack = stack.append(pv);
    }

    return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: ok };
}

// ---- STerm constructors (ssa.fern's t_* helpers are module-private) ------

function STerm_ret(value: i32): ssa.STerm { return ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value }; }
function STerm_br(target: i32): ssa.STerm { return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 }; }
function STerm_brif(cond: i32, t: i32, f: i32): ssa.STerm { return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 }; }
function STerm_none(): ssa.STerm { return ssa.STerm { kind_tag: 0, cond: 0, target: 0, t: 0, f: 0, value: 0 }; }
