                var sh: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 14, result: sh, args: [], imm: snf + 1, str: "" });
                var stagi: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: stagi, args: [], imm: 0, str: "" });
                var stagv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: stagv, args: [], imm: struct_id_of(structs, op.str), str: "" });
                var stsv: i32 = nvals; nvals = nvals + 1;
                cur_insts = cur_insts.append(ssa.SInst { kind_tag: 16, result: stsv, args: [sh, stagi, stagv], imm: 0, str: "" });
                var sm2: i32 = 0;
