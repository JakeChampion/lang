// Dependency-aware dataflow over the existing SSA graph. The semantic phase
// supplies verified, transitive lifetime dependencies by VALUE identity.
// This module neither infers ownership nor certifies a counted-unit plan.
// Keep phi inputs on predecessor edges; do not add synthetic graph operands.
import "./ssa";

// The sets are bit rows, one per block POSITION (block ids need not be
// contiguous after CFG simplification), `words` i64s each, value id v at bit
// v % 64 of word v / 64. Read them through live_in_has / live_out_has.
// `at` maps a block id to its position in the graph the flow was computed
// over (position).
pub struct Flow {
    ok: boolean,
    why: string,
    words: i32,
    live_in: i64[],
    live_out: i64[],
    at: i32[]
}

function failed(why: string): Flow {
    return Flow { ok: false, why: why, words: 0, live_in: [], live_out: [], at: [] };
}

// position is block id's position, -1 for an id the graph does not carry.
pub function position(fl: Flow, id: i32): i32 {
    if (id < 0 || id >= fl.at.len()) { return 0 - 1; }
    return fl.at[id];
}
pub function live_in_has(fl: Flow, bi: i32, v: i32): boolean { return bit_has(fl.live_in, bi * fl.words, v); }
pub function live_out_has(fl: Flow, bi: i32, v: i32): boolean { return bit_has(fl.live_out, bi * fl.words, v); }

// live_in_ids / live_out_ids list block bi's live-in / live-out values in
// ascending order; out_not_in the values live out of bi and not into si.
pub function live_in_ids(fl: Flow, bi: i32): i32[] { return set_ids(fl.live_in, bi * fl.words, [], 0, fl.words); }
pub function live_out_ids(fl: Flow, bi: i32): i32[] { return set_ids(fl.live_out, bi * fl.words, [], 0, fl.words); }
pub function out_not_in(fl: Flow, bi: i32, si: i32): i32[] { return set_ids(fl.live_out, bi * fl.words, fl.live_in, si * fl.words, fl.words); }

// set_ids walks `words` words of rows from base a word at a time, clearing
// the bits set in minus from mbase when minus is not empty.
function set_ids(rows: i64[], base: i32, minus: i64[], mbase: i32, words: i32): i32[] {
    var out: i32[] = [];
    if (rows.len() == 0) { return out; }
    var w: i32 = 0;
    while (w < words) {
        var x: i64 = rows[base + w];
        if (minus.len() != 0) { x = x & (minus[mbase + w] ^ (0i64 - 1i64)); }
        while (x != 0i64) {
            out = out.append(w * 64 + __ctz64(x as u64));
            x = x & (x - 1i64);
        }
        w = w + 1;
    }
    return out;
}

// live_in_bits / live_out_bits spell a set out as one flag per block * nvals,
// for a reader that wants every bit.
pub function live_in_bits(fl: Flow, nblocks: i32, nvals: i32): boolean[] { return spelled(fl.live_in, fl.words, nblocks, nvals); }
pub function live_out_bits(fl: Flow, nblocks: i32, nvals: i32): boolean[] { return spelled(fl.live_out, fl.words, nblocks, nvals); }

function spelled(rows: i64[], words: i32, nblocks: i32, nvals: i32): boolean[] {
    var out: boolean[] = [];
    var bi: i32 = 0;
    while (bi < nblocks) {
        var v: i32 = 0;
        while (v < nvals) { out = out.append(bit_has(rows, bi * words, v)); v = v + 1; }
        bi = bi + 1;
    }
    return out;
}

function bit_has(rows: i64[], base: i32, v: i32): boolean {
    if (v < 0 || rows.len() == 0) { return false; }
    return ((rows[base + v / 64] >> ((v % 64) as i64)) & 1i64) != 0i64;
}

function bit_set(own rows: i64[], base: i32, v: i32): i64[] {
    var w: i32 = base + v / 64;
    return rows.with(w, rows[w] | (1i64 << ((v % 64) as i64)));
}

function words_of(n: i32): i64[] {
    var out: i64[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(0i64); i = i + 1; }
    return out;
}

function zeroes(n: i32): boolean[] {
    var out: boolean[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(false); i = i + 1; }
    return out;
}

// first_positions maps each non-negative block id to the position of the
// first block carrying it, -1 for an id no block carries.
function first_positions(f: ssa.SFunc): i32[] {
    var top: i32 = 0 - 1;
    for b in f.blocks { if (b.id > top) { top = b.id; } }
    var out: i32[] = [];
    var i: i32 = 0;
    while (i <= top) { out = out.append(0 - 1); i = i + 1; }
    i = 0;
    while (i < f.blocks.len()) {
        var id: i32 = f.blocks[i].id;
        if (id >= 0 && out[id] < 0) { out = out.with(id, i); }
        i = i + 1;
    }
    return out;
}

function block_index(at: i32[], id: i32): i32 {
    if (id < 0 || id >= at.len()) { return 0 - 1; }
    return at[id];
}

function pred_index(b: ssa.SBlock, id: i32): i32 {
    var i: i32 = 0;
    while (i < b.preds.len()) {
        if (b.preds[i] == id) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function successor(t: ssa.STerm, which: i32): i32 {
    if (t.kind_tag == 2 && which == 0) { return t.target; }
    if (t.kind_tag == 3) {
        if (which == 0) { return t.t; }
        return t.f;
    }
    return 0 - 1;
}

// Structural input validation only. Semantic typing, dominance and the
// availability of each dependency remain obligations of the caller.
pub function input_error(f: ssa.SFunc, dependencies: i32[][]): string {
    if (f.nvals < 0 || dependencies.len() != f.nvals) { return "dependency dimensions"; }
    var at: i32[] = first_positions(f);
    if (block_index(at, f.entry) < 0) { return "missing entry block"; }
    if (f.nvals > 0 && f.blocks.len() > 2147483647 / f.nvals) { return "live matrix overflow"; }
    for deps in dependencies {
        for value in deps {
            if (value < 0 || value >= f.nvals) { return "dependency value out of range"; }
        }
    }
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var b: ssa.SBlock = f.blocks[bi];
        if (b.id < 0 || block_index(at, b.id) != bi) { return "duplicate or negative block id"; }
        if (b.term.kind_tag < 1 || b.term.kind_tag > 4) { return "invalid terminator"; }
        if (b.term.kind_tag == 1 && (b.term.value < 0 - 1 || b.term.value >= f.nvals)) { return "return value out of range"; }
        if (b.term.kind_tag == 3 && (b.term.cond < 0 || b.term.cond >= f.nvals)) { return "condition value out of range"; }
        var pi: i32 = 0;
        while (pi < b.preds.len()) {
            var pb: i32 = block_index(at, b.preds[pi]);
            if (pb < 0 || pred_index(b, b.preds[pi]) != pi) { return "invalid predecessor"; }
            var pt: ssa.STerm = f.blocks[pb].term;
            if (successor(pt, 0) != b.id && successor(pt, 1) != b.id) { return "predecessor is not an edge"; }
            pi = pi + 1;
        }
        for ins in b.insts {
            if (ins.result < 0 - 1 || ins.result >= f.nvals) { return "result value out of range"; }
            if (ins.kind_tag == 8 && ins.args.len() != b.preds.len()) { return "phi predecessor arity"; }
            for arg in ins.args {
                if (arg < 0 || arg >= f.nvals) { return "operand value out of range"; }
            }
        }
        var si: i32 = 0;
        while (si < 2) {
            var target: i32 = successor(b.term, si);
            if (target >= 0) {
                var sb: i32 = block_index(at, target);
                if (sb < 0) { return "missing successor"; }
                if (pred_index(f.blocks[sb], b.id) < 0) { return "missing predecessor edge"; }
            } else if (b.term.kind_tag == 3 || (b.term.kind_tag == 2 && si == 0)) {
                return "negative successor";
            }
            si = si + 1;
        }
        bi = bi + 1;
    }
    return "";
}

function add_use(own bits: i64[], base: i32, value: i32, dependencies: i32[][]): i64[] {
    if (value < 0) { return bits; }
    bits = bit_set(bits, base, value);
    for dep in dependencies[value] { bits = bit_set(bits, base, dep); }
    return bits;
}

function add_local_use(own bits: i64[], defs: i64[], base: i32, value: i32, dependencies: i32[][]): i64[] {
    if (value < 0) { return bits; }
    if (!bit_has(defs, base, value)) { bits = bit_set(bits, base, value); }
    for dep in dependencies[value] {
        if (!bit_has(defs, base, dep)) { bits = bit_set(bits, base, dep); }
    }
    return bits;
}

// This is the self-host counterpart of native SSA's
// ComputeLivenessWithDependencies. Dependencies must already be transitive
// and available at every use of their key, including uses on phi edges.
pub function compute(f: ssa.SFunc, dependencies: i32[][]): Flow {
    var why: string = input_error(f, dependencies);
    if (why != "") { return failed(why); }
    var words: i32 = (f.nvals + 63) / 64;
    var nb: i32 = f.blocks.len();
    var at: i32[] = position_of(f);
    var uses: i64[] = words_of(nb * words);
    var defs: i64[] = words_of(nb * words);
    var bi: i32 = 0;
    while (bi < nb) {
        var b: ssa.SBlock = f.blocks[bi];
        var base: i32 = bi * words;
        for ins in b.insts {
            if (ins.kind_tag != 8) {
                for arg in ins.args { uses = add_local_use(uses, defs, base, arg, dependencies); }
            }
            if (ins.result >= 0) { defs = bit_set(defs, base, ins.result); }
        }
        if (b.term.kind_tag == 1) { uses = add_local_use(uses, defs, base, b.term.value, dependencies); }
        if (b.term.kind_tag == 3) { uses = add_local_use(uses, defs, base, b.term.cond, dependencies); }
        bi = bi + 1;
    }
    var live_in: i64[] = words_of(nb * words);
    var live_out: i64[] = words_of(nb * words);
    // row holds the block being recomputed, so a pass updates live_out in
    // place instead of copying the whole table for each block.
    var row: i64[] = words_of(words);
    var changed: boolean = true;
    while (changed) {
        changed = false;
        bi = nb - 1;
        while (bi >= 0) {
            var b: ssa.SBlock = f.blocks[bi];
            var base: i32 = bi * words;
            var w: i32 = 0;
            while (w < words) { row = row.with(w, live_out[base + w]); w = w + 1; }
            var si: i32 = 0;
            while (si < 2) {
                var target: i32 = successor(b.term, si);
                if (target >= 0) {
                    var sb: i32 = at[target];
                    w = 0;
                    while (w < words) {
                        row = row.with(w, row[w] | live_in[sb * words + w]);
                        w = w + 1;
                    }
                    // Phi arguments belong to this exact predecessor edge.
                    // The phi result is a definition in the successor, so its
                    // normal live-in set already excludes that result.
                    var pi: i32 = pred_index(f.blocks[sb], b.id);
                    for ins in f.blocks[sb].insts {
                        if (ins.kind_tag == 8) { row = add_use(row, 0, ins.args[pi], dependencies); }
                    }
                }
                si = si + 1;
            }
            w = 0;
            while (w < words) {
                if (row[w] != live_out[base + w]) { live_out = live_out.with(base + w, row[w]); changed = true; }
                var inw: i64 = uses[base + w] | (row[w] & (defs[base + w] ^ (0i64 - 1i64)));
                if (inw != live_in[base + w]) { live_in = live_in.with(base + w, inw); changed = true; }
                w = w + 1;
            }
            bi = bi - 1;
        }
    }
    return Flow { ok: true, why: "", words: words, live_in: live_in, live_out: live_out, at: at };
}

// position_of maps a block id to its position in f.blocks, -1 for an id no
// block carries.
function position_of(f: ssa.SFunc): i32[] {
    var top: i32 = 0;
    for b in f.blocks { if (b.id > top) { top = b.id; } }
    var out: i32[] = [];
    var i: i32 = 0;
    while (i <= top) { out = out.append(0 - 1); i = i + 1; }
    i = 0;
    while (i < f.blocks.len()) { out = out.with(f.blocks[i].id, i); i = i + 1; }
    return out;
}
