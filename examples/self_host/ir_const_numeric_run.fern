// examples/self_host/ir_const_numeric_run.fern — compiles stdin with every
// i64 and f64 constant the lowering produced as text rebuilt from its value
// (ir.op_const_i64 / ir.op_const_f64), then emits it. The program has to
// behave exactly as it does when compiled normally: a backend reading only one
// of the two constant forms emits an empty immediate for the other (#8996).
//
//   ir_const_numeric_run -target x86-64-linux < prog.fern > prog.s
//   ir_const_numeric_run -target arm64-linux  < prog.fern > prog.s
//   ir_const_numeric_run -target wasm32-wasi  < prog.fern > prog.wat
//
// stderr reports how many constants of each kind were rebuilt.

import "./util";
import "./parser";
import "./rundriver";
import "./ir";
import "./irlower";
import "./ircore";
import "./asm_ir";
import "./asm_arm64_ir";
import "./wasm_ir";
import "./asmcore";

struct Rebuilt { cache: irlower.LowerResult[], i64s: i32, f64s: i32 }

function rebuild(cache: irlower.LowerResult[]): Rebuilt {
    var out: irlower.LowerResult[] = [];
    var n64: i32 = 0;
    var nf: i32 = 0;
    for r in cache {
        var ops: ir.Op[] = [];
        for o in r.ops {
            var no: ir.Op = o;
            if (o.kind_tag == ir.kind_id("const_i64") && o.str.len() > 0) {
                no = ir.Op { ...ir.op_const_i64(util.lit_to_i64(o.str)), decl: o.decl };
                n64 = n64 + 1;
            } else if (o.kind_tag == ir.kind_id("const_f64") && o.str.len() > 0) {
                no = ir.Op { ...ir.op_const_f64(f64_from_bits(util.parse_f64_bits(o.str))), decl: o.decl };
                nf = nf + 1;
            }
            ops = ops.append(no);
        }
        out = out.append(irlower.LowerResult { ...r, ops: ops });
    }
    return Rebuilt { cache: out, i64s: n64, f64s: nf };
}

// sub_of hands the rebuilt lowering to the emit the way the CLI hands it a
// semantic one: every declaration's body substituted, over the same registry.
function sub_of(rb: Rebuilt, base: irlower.FnSigs): ircore.Sub {
    eprint("rebuilt i64=" + util.i32_to_string(rb.i64s) + " f64=" + util.i32_to_string(rb.f64s) + "\n");
    return ircore.Sub { ...ircore.no_sub(), on: true, bodies: rb.cache, extra: [], sigs: base };
}

// bits_round_trip checks the patterns no source literal spells: a NaN's
// payload and sign, both infinities, and negative zero.
function bits_round_trip(): boolean {
    var pats: i64[] = [0x7ff8000000000123i64, 0i64 - 0x0007fffffffffffdi64, 0x7ff0000000000000i64, 0i64 - 0x0010000000000000i64, 0i64 - 0x7fffffffffffffffi64 - 1i64, 1i64];
    for b in pats {
        if (ir.const_f64_bits(ir.op_const_f64(f64_from_bits(b))) != b) { return false; }
    }
    return ir.const_i64_text(ir.op_const_i64(0i64 - 0x7fffffffffffffffi64 - 1i64)) == "-9223372036854775808";
}

function main(): i32 {
    if (!bits_round_trip()) { eprint("ir_const_numeric_run: a numeric constant did not keep its bits\n"); return 3; }
    var av: string[] = args();
    var target: string = "x86-64-linux";
    if (av.len() > 2 && av[1] == "-target") { target = av[2]; }
    var mod: parser.Module = rundriver.parse_stdin("ir_const_numeric_run");
    if (asmcore.refuse_parse_unknowns([mod]) || asmcore.refuse_decl_names([mod])) { return 1; }
    if (target == "wasm32-wasi") {
        var lm: parser.Module = wasm_ir.route_normalized(mod);
        var stab: irlower.StructTab = irlower.struct_tab(lm.structs);
        var base: irlower.FnSigs = ircore.wp_fn_sigs(lm.funcs, stab);
        var g: ircore.Lowered = wasm_ir.lower_all_gated(lm, stab, base, ircore.no_sub());
        if (!g.ok) { eprint("ir_const_numeric_run: the module did not lower\n"); return 1; }
        write(wasm_ir.emit_module_mode_or_error_sub(mod, false, false, sub_of(rebuild(g.cache), base)));
        return 0;
    }
    var im: parser.Module = parser.infer_ret_types_module(ircore.script_normalized(mod));
    var imtab: irlower.StructTab = irlower.struct_tab(im.structs);
    var ibase: irlower.FnSigs = ircore.wp_fn_sigs(im.funcs, imtab);
    var ig: ircore.Lowered = ircore.lower_gated(im, imtab, irlower.fn_sigs_with_dyn(ibase, im.trait_reqs), [], false, ircore.no_sub());
    if (!ig.ok) { eprint("ir_const_numeric_run: the module did not lower\n"); return 1; }
    var sub: ircore.Sub = sub_of(rebuild(ig.cache), ibase);
    if (target == "arm64-linux") { write(asm_arm64_ir.emit_module_ir_gated_sub(mod, false, sub)); }
    else { write(asm_ir.emit_module_ir_gated_sub(mod, [], sub)); }
    return 0;
}
