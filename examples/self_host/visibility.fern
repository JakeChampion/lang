// examples/self_host/visibility.fern — cross-module `pub` enforcement (#6714).
//
// Kept out of modloader.fern deliberately. The rule needs astwalk + checker,
// and modloader is imported by every minimal driver (checker_modload_run,
// asm_modload_run, ssa_lift_scan_run, …) whose project dir carries a fixed,
// small source list. Putting the rule there widened modloader's import closure
// and broke those drivers; a separate module keeps the loader's dependencies
// as narrow as they were and costs the full driver one import.

import "./parser";
import "./flatten";
import "./util";
import "./astwalk";
import "./checker";

// --- cross-module visibility (#6714) --------------------------------------
//
// Native enforces `pub` in modload's rewriter: a `mod.X` naming a declaration
// `mod` did not export is an error, not a resolvable reference. The self-host
// swallowed the modifier entirely, so a private member was callable from any
// module — a program native REFUSES TO BUILD produced a working binary here.
//
// The check runs on the PRE-FLATTEN ASTs, one module at a time, because that is
// the only place the distinction survives. Bundling rewrites a qualified
// `bigint.__bi_make` and a bare same-module `__bi_make` into the SAME ident
// `bigint____bi_make`, so a bundle-level rule cannot tell an outside caller
// from the module's own internals — and core/bigint, whose methods call its
// private helpers by bare name, is exactly the shape that exposes it.

// import_quals returns the qualifiers a module's source may write: the import's
// alias when it has one, else the path's basename (`import "std/io_buffered" as
// io` → `io`; `import "./lexer"` → `lexer`). Built by concatenation rather than
// slicing — a slice is a `str` view of the path, and this outlives it.
function import_quals(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var im: parser.Import = mod.imports[i];
        if (im.alias.len() > 0) { out = out.append(im.alias); }
        else { out = out.append(base_name_of(im.path)); }
        i = i + 1;
    }
    return out;
}

// base_name_of is modloader.base_name, duplicated rather than imported: this
// module is on the full driver's path only, and importing modloader for one
// eight-line helper would drag the loader's whole closure back in — the
// dependency widening that broke six minimal drivers the first time.
function base_name_of(path: string): string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { start = i + 1; }   // '/'
        i = i + 1;
    }
    return path[start:path.len()] + "";
}

// module_named finds a loaded module by its namespace name.
function module_named(loaded: flatten.LoadedModule[], name: string): i32 {
    var i: i32 = 0;
    while (i < loaded.len()) {
        if (loaded[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// declares_private reports whether `mod` has a top-level function `name` that is
// NOT `pub`. Receiver-bearing methods are excluded: they are reached through a
// value (`x.m()`), never module-qualified, so `pub` does not gate them. A name
// the module does not declare at all returns false — an unknown qualified name
// is somebody else's diagnostic, and reporting it as "not exported" would send
// the reader off to add `pub` to a declaration that does not exist.
function declares_private(mod: parser.Module, name: string): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[i];
        if (f.name == name && f.receiver_name.len() == 0) { return !f.is_pub; }
        i = i + 1;
    }
    return false;
}

// module_diags reports every `<qual>.<name>` in `src`'s own functions that names
// a private top-level function of the module `qual` resolves to.
function module_diags(src: parser.Module, loaded: flatten.LoadedModule[]): checker.Diag[] {
    var out: checker.Diag[] = [];
    var quals: string[] = import_quals(src);
    if (quals.len() == 0) { return out; }
    var refs: astwalk.QualRef[] = [];
    var i: i32 = 0;
    while (i < src.funcs.len()) {
        var bi: i32 = 0;
        while (bi < src.funcs[i].body.len()) {
            refs = astwalk.collect_qualrefs_stmt(src.funcs[i].body[bi], quals, refs);
            bi = bi + 1;
        }
        i = i + 1;
    }
    var ri: i32 = 0;
    while (ri < refs.len()) {
        var r: astwalk.QualRef = refs[ri];
        var mi: i32 = module_named(loaded, r.qual);
        if (mi >= 0 && declares_private(loaded[mi].mod, r.name)) {
            out = out.append(checker.Diag {
                code: "",
                message: r.qual + "." + r.name + " is not exported (declare it as `pub function " + r.name + " …` to make it accessible from other modules)",
                line: r.line,
                col: r.col
            });
        }
        ri = ri + 1;
    }
    return out;
}

// export_diags checks the entry and every loaded module against the visibility
// rule. A module's references to its OWN declarations are bare idents, never
// qualified, so they are structurally out of scope here rather than filtered —
// which is what makes this formulation immune to the false positives the
// bundle-level one produced.
pub function export_diags(entry: parser.Module, loaded: flatten.LoadedModule[]): checker.Diag[] {
    var out: checker.Diag[] = module_diags(entry, loaded);
    var i: i32 = 0;
    while (i < loaded.len()) {
        var ds: checker.Diag[] = module_diags(loaded[i].mod, loaded);
        var di: i32 = 0;
        while (di < ds.len()) { out = out.append(ds[di]); di = di + 1; }
        i = i + 1;
    }
    return out;
}
