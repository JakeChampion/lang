// Closed typed effects for enum-root borrows and counted scalar-array returns.
// The syntax adapter below creates value identities; verify reads no AST.
import "./ast";
import "./parser";
import "./typeinfo";
import "./util";

pub struct Variant { owner: typeinfo.Type, name: string, fields: typeinfo.Type[] }
pub struct Value { ty: typeinfo.Type, kind: i32, args: i32[], variant: i32, field: i32 }
pub struct Effect { kind: i32, value: i32, variant: i32 }
pub struct Binding { site: string, value: i32, owns_root: boolean }
pub struct Region { ok: boolean, name: string, result: typeinfo.Type, values: Value[], effects: Effect[], bindings: Binding[], variants: Variant[], params: i32[], callees: Region[] }
pub struct Plan { ok: boolean, roots: string[], borrowed: boolean[] }

function integer(): typeinfo.Type { return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false }; }
function boolean_type(): typeinfo.Type { return typeinfo.TypeBool { tag: 0 }; }
function array_type(): typeinfo.Type { return typeinfo.TypeArray { elem: integer() }; }
function same(a: typeinfo.Type, b: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(x) = a {
        if let typeinfo.TypeI32(y) = b { return x.width == y.width && x.unsigned == y.unsigned && x.is_char == y.is_char; }
    }
    if let typeinfo.TypeBool(_) = a { if let typeinfo.TypeBool(_) = b { return true; } }
    if let typeinfo.TypeArray(x) = a { if let typeinfo.TypeArray(y) = b { return same(x.elem, y.elem); } }
    if let typeinfo.TypeUnion(x) = a {
        if let typeinfo.TypeUnion(y) = b { return x.name == y.name && x.args.len() == 0 && y.args.len() == 0; }
    }
    return false;
}
function scalar(t: typeinfo.Type): boolean { return same(t, integer()) || same(t, boolean_type()); }
function enumeration(t: typeinfo.Type): boolean {
    if let typeinfo.TypeUnion(u) = t { return u.args.len() == 0; }
    return false;
}
function refused(): Plan { return Plan { ok: false, roots: [], borrowed: [] }; }

function exclusive_child(r: Region, parent: i32, child: i32): boolean {
    if (r.values[child].kind != 2) { return false; }
    for b in r.bindings { if (b.value == child) { return false; } }
    var uses: i32 = 0; var i: i32 = 0;
    for v in r.values {
        for arg in v.args {
            if (arg == child) { if (i != parent) { return false; } uses = uses + 1; }
        }
        i = i + 1;
    }
    for e in r.effects { if (e.kind == 1 && e.value == child) { return false; } }
    return uses == 1;
}

function value_valid(r: Region, i: i32): boolean {
    var v: Value = r.values[i];
    for arg in v.args { if (arg < 0 || arg >= i) { return false; } }
    if (v.kind == 0) { return i < r.params.len() && r.params[i] == i && v.args.len() == 0 && (scalar(v.ty) || enumeration(v.ty)); }
    if (v.kind == 1) { return v.args.len() == 0 && scalar(v.ty); }
    if (v.kind == 2) {
        if (!same(v.ty, array_type())) { return false; }
        for arg in v.args { if (!same(r.values[arg].ty, integer())) { return false; } }
        return true;
    }
    if (v.kind == 3) {
        if (v.variant < 0 || v.variant >= r.variants.len()) { return false; }
        var decl: Variant = r.variants[v.variant];
        if (!same(v.ty, decl.owner) || v.args.len() != decl.fields.len()) { return false; }
        var j: i32 = 0;
        while (j < v.args.len()) {
            // Construction moves only fresh literal arrays into its fields.
            var child: Value = r.values[v.args[j]];
            if (!same(child.ty, decl.fields[j]) || !exclusive_child(r, i, v.args[j])) { return false; }
            j = j + 1;
        }
        return true;
    }
    if (v.kind == 4) {
        if (v.variant < 0 || v.variant >= r.callees.len()) { return false; }
        var callee: Region = r.callees[v.variant];
        // Closed, nonrecursive summaries are derived from independently
        // verified semantic regions, never inferred from a function name.
        if (callee.callees.len() != 0 || !verify(callee).ok || !same(v.ty, callee.result) || v.args.len() != callee.params.len()) { return false; }
        var j: i32 = 0;
        while (j < v.args.len()) {
            if (!same(r.values[v.args[j]].ty, callee.values[callee.params[j]].ty)) { return false; }
            j = j + 1;
        }
        return true;
    }
    if (v.kind == 5) {
        if (v.args.len() != 1 || v.variant < 0 || v.variant >= r.variants.len()) { return false; }
        var decl: Variant = r.variants[v.variant];
        return same(r.values[v.args[0]].ty, decl.owner) && v.field >= 0
            && v.field < decl.fields.len() && same(v.ty, decl.fields[v.field]);
    }
    // Scalar operations only read arrays or scalar operands; enum reads occur
    // exclusively through explicit variant guards and projections.
    if (v.kind == 6) {
        if (!scalar(v.ty)) { return false; }
        for arg in v.args { if (!scalar(r.values[arg].ty) && !same(r.values[arg].ty, array_type())) { return false; } }
        return true;
    }
    return false;
}

pub function verify(r: Region): Plan {
    if (!r.ok) { return refused(); }
    var guards: i32[] = [];
    var variants: i32[] = [];
    var depth: i32 = 0;
    var next: i32 = 0;
    var returns: i32 = 0;
    for e in r.effects {
        if (e.kind == 0) {
            if (e.value != next || next >= r.values.len() || !value_valid(r, next)) { return refused(); }
            var v: Value = r.values[next];
            if (v.kind == 5) {
                var level: i32 = depth - 1;
                if (level < 0 || guards[level] != v.args[0] || variants[level] != v.variant) { return refused(); }
            }
            next = next + 1;
        } else if (e.kind == 1) {
            if (e.value < 0 || e.value >= next || !same(r.values[e.value].ty, r.result)) { return refused(); }
            // Fresh arrays transfer their unit; projections acquire a separate
            // unit. There is no enum-root return or uncounted child escape.
            if (!scalar(r.result) && r.values[e.value].kind != 2 && r.values[e.value].kind != 4 && r.values[e.value].kind != 5) { return refused(); }
            returns = returns + 1;
        } else if (e.kind == 2) {
            if (e.value < 0 || e.value >= next || e.variant < 0 || e.variant >= r.variants.len()) { return refused(); }
            if (!same(r.values[e.value].ty, r.variants[e.variant].owner)) { return refused(); }
            if (depth == guards.len()) { guards = guards.append(e.value); variants = variants.append(e.variant); }
            else { guards = guards.with(depth, e.value); variants = variants.with(depth, e.variant); }
            depth = depth + 1;
        } else if (e.kind == 3) {
            if (depth == 0) { return refused(); }
            depth = depth - 1;
            if (e.value != guards[depth] || e.variant != variants[depth]) { return refused(); }
        } else { return refused(); }
    }
    if (next != r.values.len() || depth != 0 || returns == 0) { return refused(); }
    var roots: string[] = [];
    for b in r.bindings {
        if (b.value < 0 || b.value >= next || b.site == "") { return refused(); }
        if (b.owns_root) {
            if (r.values[b.value].kind != 3) { return refused(); }
            roots = roots.append(b.site);
        }
    }
    // Cross-construction storage reuse needs its own value-transfer contract.
    if (roots.len() > 1) { return refused(); }
    // A constructed root must have one owned binding, not a second credit for
    // an alias. Unbound temporaries have a different physical cleanup contract.
    var i: i32 = 0;
    while (i < next) {
        if (r.values[i].kind == 3) {
            var count: i32 = 0;
            for b in r.bindings { if (b.value == i && b.owns_root) { count = count + 1; } }
            if (count != 1) { return refused(); }
        }
        i = i + 1;
    }
    var borrowed: boolean[] = [];
    var position: i32 = 0;
    for param in r.params {
        if (param != position || param >= next || r.values[param].kind != 0) { return refused(); }
        borrowed = borrowed.append(enumeration(r.values[param].ty));
        position = position + 1;
    }
    return Plan { ok: true, roots: roots, borrowed: borrowed };
}

// Syntax import is closed and immutable: no assignment, unknown call, capture or
// aggregate store can disappear from the effect stream. Names resolve through
// lexical bindings; semantic values keep distinct monotonic identities.
struct Scope { names: string[], ids: i32[] }
struct Imported { region: Region, value: i32 }
function bad(r: Region): Imported { return Imported { region: Region { ...r, ok: false }, value: 0 - 1 }; }
function put(r: Region, ty: typeinfo.Type, kind: i32, args: i32[], variant: i32, field: i32): Imported {
    var id: i32 = r.values.len();
    var v: Value = Value { ty: ty, kind: kind, args: args, variant: variant, field: field };
    return Imported { region: Region { ...r, values: r.values.append(v),
        effects: r.effects.append(Effect { kind: 0, value: id, variant: 0 - 1 }) }, value: id };
}
function resolve(scope: Scope, name: string): i32 {
    var i: i32 = scope.names.len() - 1;
    while (i >= 0) { if (scope.names[i] == name) { return scope.ids[i]; } i = i - 1; }
    return 0 - 1;
}
function declared(name: string, variants: Variant[]): typeinfo.Type {
    if (name == "i32") { return integer(); }
    if (name == "boolean") { return boolean_type(); }
    if (name == "i32[]") { return array_type(); }
    for v in variants { if (typeinfo.spelling(v.owner) == name) { return v.owner; } }
    return typeinfo.unchecked();
}
function variant_index(r: Region, name: string, owner: string): i32 {
    var found: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < r.variants.len()) {
        var v: Variant = r.variants[i];
        if ((v.name == name || typeinfo.spelling(v.owner) + "." + v.name == name)
            && (owner == "" || typeinfo.spelling(v.owner) == owner)) {
            if (found >= 0) { return 0 - 1; }
            found = i;
        }
        i = i + 1;
    }
    return found;
}
function expr(e: ast.Expr, scope: Scope, r: Region): Imported {
    if (!r.ok) { return bad(r); }
    match (e) {
        ast.ExprIdent(id) => {
            var at: i32 = resolve(scope, id.name);
            if (at >= 0) { return Imported { region: r, value: at }; }
            var vi: i32 = variant_index(r, id.name, "");
            if (vi >= 0 && r.variants[vi].fields.len() == 0) { return put(r, r.variants[vi].owner, 3, [], vi, 0); }
        },
        ast.ExprNumber(n) => { if (!n.is_float && (n.suffix == "" || n.suffix == "i32")) { return put(r, integer(), 1, [], 0, 0); } },
        ast.ExprBool(_) => { return put(r, boolean_type(), 1, [], 0, 0); },
        ast.ExprArray(a) => {
            if (a.elem_ty != "" && a.elem_ty != "i32") { return bad(r); }
            var st: Region = r; var args: i32[] = [];
            for el in a.elements { var x: Imported = expr(el, scope, st); st = x.region; args = args.append(x.value); }
            return put(st, array_type(), 2, args, 0, 0);
        },
        ast.ExprBinary(b) => {
            var left: Imported = expr(b.left, scope, r);
            var right: Imported = expr(b.right, scope, left.region);
            if (!right.region.ok) { return bad(right.region); }
            if (b.op == "&&" || b.op == "||") {
                if (!same(right.region.values[left.value].ty, boolean_type()) || !same(right.region.values[right.value].ty, boolean_type())) { return bad(right.region); }
                return put(right.region, boolean_type(), 6, [left.value, right.value], 0, 0);
            }
            if (!same(right.region.values[left.value].ty, integer()) || !same(right.region.values[right.value].ty, integer())) { return bad(right.region); }
            var ty: typeinfo.Type = integer();
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { ty = boolean_type(); }
            else if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/" && b.op != "%") { return bad(right.region); }
            return put(right.region, ty, 6, [left.value, right.value], 0, 0);
        },
        ast.ExprIndex(ix) => {
            var arr: Imported = expr(ix.array, scope, r); var index: Imported = expr(ix.index, scope, arr.region);
            if (!index.region.ok || !same(index.region.values[arr.value].ty, array_type()) || !same(index.region.values[index.value].ty, integer())) { return bad(index.region); }
            return put(index.region, integer(), 6, [arr.value, index.value], 0, 0);
        },
        ast.ExprCall(c) => { return call(c, scope, r); },
        _ => {}
    }
    return bad(r);
}
function call(c: ast.ExprCall, scope: Scope, r: Region): Imported {
    var name: string = "";
    if let ast.ExprIdent(id) = c.callee { if (resolve(scope, id.name) < 0) { name = id.name; } }
    if let ast.ExprFieldAccess(f) = c.callee {
            if (f.field == "len" && c.args.len() == 0) {
                var x: Imported = expr(f.obj, scope, r);
                if (x.region.ok && same(x.region.values[x.value].ty, array_type())) { return put(x.region, integer(), 6, [x.value], 0, 0); }
                return bad(x.region);
            }
            if let ast.ExprIdent(id) = f.obj { if (resolve(scope, id.name) < 0) { name = id.name + "." + f.field; } }
    }
    var vi: i32 = variant_index(r, name, "");
    if (c.type_argc != 0) { return bad(r); }
    var ci: i32 = 0;
    while (ci < r.callees.len()) {
        if (r.callees[ci].name == name) {
            if (vi >= 0) { return bad(r); }
            var st: Region = r; var args: i32[] = [];
            for arg in c.args { var x: Imported = expr(arg, scope, st); st = x.region; args = args.append(x.value); }
            return put(st, r.callees[ci].result, 4, args, ci, 0);
        }
        ci = ci + 1;
    }
    if (vi < 0) { return bad(r); }
    var st: Region = r; var args: i32[] = [];
    for arg in c.args { var x: Imported = expr(arg, scope, st); st = x.region; args = args.append(x.value); }
    return put(st, r.variants[vi].owner, 3, args, vi, 0);
}

function match_body(m: ast.StmtMatch, scope: Scope, r: Region): Region {
    var scrut: Imported = expr(m.scrutinee, scope, r);
    if (!scrut.region.ok) { return scrut.region; }
    var st: Region = scrut.region;
    for arm in m.arms {
        var inner: Scope = scope;
        if (arm.has_guard || arm.alt_cont) { return bad(st).region; }
        match (arm.pattern) {
            ast.PatWildcard(_) => { st = body(arm.body, inner, st); },
            ast.PatVariant(p) => {
                if (p.nested.len() != 0 || p.at_binding != "" || p.has_lit_cond || p.tup_kinds.len() != 0 || p.field_names.len() != 0) { return bad(st).region; }
                var vi: i32 = variant_index(st, p.type_name, typeinfo.spelling(st.values[scrut.value].ty));
                if (vi < 0) { return bad(st).region; }
                st = Region { ...st, effects: st.effects.append(Effect { kind: 2, value: scrut.value, variant: vi }) };
                var names: string[] = [];
                if (p.binding != "") { names = names.append(p.binding); }
                for name in p.extra_bindings { names = names.append(name); }
                if (names.len() > st.variants[vi].fields.len()) { return bad(st).region; }
                var i: i32 = 0;
                for name in names {
                    if (name != "_") {
                        var x: Imported = put(st, st.variants[vi].fields[i], 5, [scrut.value], vi, i);
                        st = x.region; inner = Scope { names: inner.names.append(name), ids: inner.ids.append(x.value) };
                    }
                    i = i + 1;
                }
                st = body(arm.body, inner, st);
                st = Region { ...st, effects: st.effects.append(Effect { kind: 3, value: scrut.value, variant: vi }) };
            },
            _ => { return bad(st).region; }
        }
    }
    return st;
}
function body(stmts: ast.Stmt[], initial: Scope, r: Region): Region {
    var st: Region = r; var scope: Scope = initial;
    for stmt in stmts {
        if (!st.ok) { return st; }
        match (stmt) {
            ast.StmtVar(v) => {
                var before: i32 = st.values.len(); var x: Imported = expr(v.init, scope, st); st = x.region;
                if (!st.ok) { return st; }
                if (v.type_name != "" && !same(declared(v.type_name, st.variants), st.values[x.value].ty)) { return bad(st).region; }
                scope = Scope { names: scope.names.append(v.name), ids: scope.ids.append(x.value) };
                var site: string = v.name + "@" + util.i32_to_string(v.line) + ":" + util.i32_to_string(v.col);
                st = Region { ...st, bindings: st.bindings.append(Binding { site: site, value: x.value,
                    owns_root: x.value >= before && st.values[x.value].kind == 3 }) };
            },
            ast.StmtReturn(ret) => {
                var x: Imported = expr(ret.value, scope, st); st = x.region;
                st = Region { ...st, effects: st.effects.append(Effect { kind: 1, value: x.value, variant: 0 - 1 }) };
            },
            ast.StmtMatch(m) => { st = match_body(m, scope, st); },
            ast.StmtIf(f) => {
                var c: Imported = expr(f.cond, scope, st); st = c.region;
                if (!st.ok || !same(st.values[c.value].ty, boolean_type())) { return bad(st).region; }
                st = body(f.then_body, scope, st); st = body(f.else_body, scope, st);
            },
            _ => { return bad(st).region; }
        }
    }
    return st;
}

pub function import_function(fn: parser.FuncDecl, decls: parser.StructDecl[]): Region { return import_calls(fn, decls, []); }

function import_calls(fn: parser.FuncDecl, decls: parser.StructDecl[], callees: Region[]): Region {
    var result: typeinfo.Type = declared(fn.ret_type, []);
    var r: Region = Region { ok: false, name: fn.name, result: result, values: [], effects: [], bindings: [], variants: [], params: [], callees: callees };
    if ((!same(result, array_type()) && !scalar(result)) || fn.receiver_type != "" || fn.type_params.len() != 0 || fn.async) { return r; }
    var variants: Variant[] = [];
    for d in decls {
        if (d.enum_owner != "" && d.type_params.len() == 0) {
            var fields: typeinfo.Type[] = []; var supported: boolean = true;
            for f in d.fields { if (f.type_name != "i32[]") { supported = false; } fields = fields.append(array_type()); }
            if (supported) { variants = variants.append(Variant { owner: typeinfo.TypeUnion { name: d.enum_owner, args: [] }, name: d.name, fields: fields }); }
        }
    }
    r = Region { ...r, ok: true, variants: variants };
    var scope: Scope = Scope { names: [], ids: [] };
    for p in fn.params {
        if (p.own) { return bad(r).region; }
        var x: Imported = put(r, declared(p.type_name, variants), 0, [], 0, 0); r = x.region;
        r = Region { ...r, params: r.params.append(x.value) };
        scope = Scope { names: scope.names.append(p.name), ids: scope.ids.append(x.value) };
    }
    return body(fn.body, scope, r);
}

pub function analyze(fn: parser.FuncDecl, decls: parser.StructDecl[]): Plan { return verify(import_function(fn, decls)); }

pub function leaves(funcs: parser.FuncDecl[], decls: parser.StructDecl[]): Region[] {
    var out: Region[] = [];
    for fn in funcs {
        var r: Region = import_function(fn, decls); var p: Plan = verify(r);
        if (p.ok) {
            var relevant: boolean = p.roots.len() > 0;
            for borrowed in p.borrowed { if (borrowed) { relevant = true; } }
            if (relevant) { out = out.append(r); }
        }
    }
    return out;
}

pub function analyze_calls(fn: parser.FuncDecl, decls: parser.StructDecl[], callees: Region[]): Plan {
    if (callees.len() == 0) { return refused(); }
    return verify(import_calls(fn, decls, callees));
}
