// examples/self_host/tuple_elem_tag_run.fern — byte-identity guard for irlower's
// tuple element-tag decoder (irlower.fern's tuple_type_elem_tag, SH-021 slice —
// docs/SELF-HOST-AUDIT.md T2).
//
// tuple_type_elem_tag now extracts element n of a tuple type spelling
// "(t0, t1, …)" via the structured TypeRef (parser.parse_type_ref) instead of a
// hand-rolled depth-tracking top-level-comma scan. This driver runs the REAL
// (imported) function AND a frozen copy of the FORMER scan over a corpus spanning
// every branch — plain tuples, tuples with nested-generic / nested-tuple / array
// elements (the inner commas the depth scan must not split on), single-element
// tuples, out-of-range and negative indices, non-tuples, and a tuple-array
// ("(a, b)[]") — for each element index, and asserts the new decode equals the old
// for every (type, n). Exits with the mismatch count (0 = byte-identical), so a
// regression in the TypeRef decode (or in parse_type_ref feeding it) fails here.

import "./irlower";
import "./util";

// --- frozen reference: the exact depth-tracking scan tuple_type_elem_tag replaced ---
function ref_trim(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && s[a] == b' ') { a = a + 1; }
    while (b > a && s[b - 1] == b' ') { b = b - 1; }
    return s[a:b] + "";
}
function ref_elem_tag(t: string, n: i32): string {
    var len: i32 = t.len();
    if (len < 3 || t[0:1] != "(" || t[len - 1 : len] != ")") { return ""; }
    var inner: str = t[1 : len - 1];
    var depth: i32 = 0;
    var start: i32 = 0;
    var idx: i32 = 0;
    var i: i32 = 0;
    while (i <= inner.len()) {
        if (i == inner.len() || (depth == 0 && inner[i] == b',')) {
            if (idx == n) { return ref_trim(inner[start : i]); }
            idx = idx + 1;
            start = i + 1;
        } else {
            var ch: i32 = inner[i] as i32;
            if (ch == 91 || ch == 40) { depth = depth + 1; }
            else if (ch == 93 || ch == 41) { depth = depth - 1; }
        }
        i = i + 1;
    }
    return "";
}

function show(s: string): string { if (s.len() == 0) { return "<empty>"; } return s; }

function main(): i32 {
    var corpus: string[] = [
        "(i32, i32)", "(i32, string, boolean)", "(Map[a, b], i32)",
        "((a, b), c)", "(i32[], string)", "(Option[i32], Result[i32, u32])",
        "(x)", "(i32, i32)[]", "()", "i32", "Map[a, b]", "Option[i32]", "",
        "(a, (b, c), d)"
    ];
    var out: string = "";
    var bad: i32 = 0;
    var i: i32 = 0;
    while (i < corpus.len()) {
        var t: string = corpus[i];
        // Probe indices -1..4 to cover in-range, out-of-range, and negative.
        var n: i32 = 0 - 1;
        while (n <= 4) {
            var real: string = irlower.tuple_type_elem_tag(t, n);
            var ref: string = ref_elem_tag(t, n);
            var mark: string = "ok  ";
            if (real != ref) { mark = "BAD "; bad = bad + 1; }
            out = out + mark + show(t) + "[" + util.i32_to_string(n) + "]=" + show(real) + "\n";
            n = n + 1;
        }
        i = i + 1;
    }
    out = out + "mismatches=" + util.i32_to_string(bad) + "\n";
    write(out);
    return bad;
}
