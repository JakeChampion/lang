// examples/self_host/elf.fern — a minimal static, non-PIE ELF-64
// executable writer for the self-hosted *native* backend. This is the
// container half of the native-binary path that aims to remove the
// external `gcc` / `ld` link step the self-host currently shells out to
// for x86-64 / arm64 Linux (mirroring the Go reference
// internal/native/elf/elf.go).
//
// Because a Fern program links to one self-contained blob
// (`-static -nostdlib`: no archives, no shared objects, no relocations
// against external symbols, no PLT/GOT) the "linker" is trivial: lay the
// headers + .text out at a fixed virtual address and point e_entry at the
// first instruction. There are no section headers (the kernel loader
// needs only the program headers) and a single PT_LOAD maps the whole
// file. Reference: the ELF-64 gABI.
//
// Conventions (matching leb128.fern / wat_encode.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each helper appends
//     to it and returns the (possibly grown) buffer (`buf = f(buf, …)`).
//   * This module is intentionally **import-free** so (a) the native
//     emitter can `import "./elf"` and (b) the unit test can concatenate
//     this file with a driver `main()` and feed the whole thing to the
//     single-module wasm_run driver.
//   * 8-byte ELF fields are written via elf_le64 (an i64 value); the
//     values we emit are all small (addresses < 2^31, sizes), but the
//     full 8 bytes are always laid down per the ELF-64 layout.

// ---- fixed layout constants (see internal/native/elf/elf.go) ----

// elf_eh_size is the ELF-64 header size (e_ehsize).
function elf_eh_size(): i32 { return 64; }

// elf_ph_size is the ELF-64 program-header entry size (e_phentsize).
function elf_ph_size(): i32 { return 56; }

// elf_base_vaddr is the load address (0x400000), a multiple of the page
// alignment below.
function elf_base_vaddr(): i32 { return 4194304; }

// elf_page_align is the arm64 max page size (16 KiB) used for p_align.
function elf_page_align(): i32 { return 65536; }

// elf_em_aarch64 is EM_AARCH64 (e_machine).
pub function elf_em_aarch64(): i32 { return 183; }

// elf_em_x86_64 is EM_X86_64 (e_machine).
function elf_em_x86_64(): i32 { return 62; }

// elf_text_vaddr is the virtual address at which .text begins in the
// single-segment image (just past the ELF header + one program header).
// A native assembler needs this to resolve PC-relative symbol references
// (adrp / :lo12: on arm64, rip-relative on x86-64).
pub function elf_text_vaddr(): i32 {
    return elf_base_vaddr() + elf_eh_size() + elf_ph_size();
}

// ---- little-endian byte emitters ----

// elf_le16 appends the low 2 bytes of `v`, little-endian.
function elf_le16(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    return buf;
}

// elf_le32 appends the 4 bytes of `v`, little-endian.
function elf_le32(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 24) & 255);
    return buf;
}

// elf_le64 appends the 8 bytes of a 64-bit `v`, little-endian. `>>` is an
// arithmetic shift; the `& 255` after each shift discards any
// sign-extended high bits, so the result is correct for any value.
function elf_le64(buf: i32[], v: i64): i32[] {
    buf = buf.append((v & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 32) & 255) as i32);
    buf = buf.append(((v >> 40) & 255) as i32);
    buf = buf.append(((v >> 48) & 255) as i32);
    buf = buf.append(((v >> 56) & 255) as i32);
    return buf;
}

// ---- buffer helpers ----

// elf_cat appends every byte of `src` to `buf`.
pub function elf_cat(buf: i32[], src: i32[]): i32[] {
    var i: i32 = 0;
    while (i < src.len()) {
        buf = buf.append(src[i]);
        i = i + 1;
    }
    return buf;
}

// elf_pad_to_8 appends zero bytes until the buffer length is a multiple
// of 8 (so the data blob lands 8-byte aligned after .text).
pub function elf_pad_to_8(b: i32[]): i32[] {
    while ((b.len() % 8) != 0) {
        b = b.append(0);
    }
    return b;
}

// elf_u32_to_i64 zero-extends an i32 byte count to i64 (treating its bits
// as unsigned). A .bss size can exceed 2^31 — the self-host arm64 heap is
// 2.5 GiB — which overflows i32 into a negative bit pattern; a plain
// `bss as i64` would SIGN-extend that to a garbage (huge) p_memsz that the
// kernel cannot map. Masking off the sign-extended high word recovers the
// intended unsigned size.
function elf_u32_to_i64(v: i32): i64 {
    var u: i64 = v as i64;
    // `v as i64` SIGN-extends; for an overflowed (negative) byte count add
    // 2^32 to recover the unsigned value. 2^32 is built via a shift because
    // an integer *literal* that large is typed i32 and truncates to 0.
    if (u < 0) { u = u + ((1 as i64) << 32); }
    return u;
}

// ---- the image writer ----

// elf_image emits the ELF header + one PT_LOAD (with the given p_flags)
// covering the whole file, followed by `body`. `machine` selects
// e_machine (EM_AARCH64 / EM_X86_64). Entry is the first instruction of
// .text (elf_text_vaddr).
function elf_image(body: i32[], flags: i32, machine: i32): i32[] {
    return elf_image_entry(body, flags, machine, 0);
}

// elf_image_entry is elf_image with an explicit entry offset within
// .text: e_entry = elf_text_vaddr() + entry_off. Used when the program's
// entry is a label other than the first instruction (e.g. asm.fern emits
// `__fn_main` before `_start`, so the entry is `_start`'s offset).
function elf_image_entry(body: i32[], flags: i32, machine: i32, entry_off: i32): i32[] {
    return elf_image_entry_bss(body, flags, machine, entry_off, 0);
}

// elf_image_entry_bss is elf_image_entry plus a trailing .bss of `bss`
// bytes: the segment's p_memsz exceeds p_filesz by `bss`, so the loader
// zero-fills that region in memory without it occupying any file bytes
// (the standard way to reserve zero-init globals without bloating the file).
pub function elf_image_entry_bss(body: i32[], flags: i32, machine: i32, entry_off: i32, bss: i32): i32[] {
    var filesz: i64 = (elf_eh_size() + elf_ph_size() + body.len()) as i64;
    var memsz: i64 = filesz + elf_u32_to_i64(bss);
    var entry: i64 = (elf_text_vaddr() + entry_off) as i64;
    var zero64: i64 = 0;

    var buf: i32[] = [];

    // ---- ELF-64 header (64 bytes) ----
    buf = buf.append(127);  // 0x7f  EI_MAG0
    buf = buf.append(69);   // 'E'   EI_MAG1
    buf = buf.append(76);   // 'L'   EI_MAG2
    buf = buf.append(70);   // 'F'   EI_MAG3
    buf = buf.append(2);    // EI_CLASS = ELFCLASS64
    buf = buf.append(1);    // EI_DATA  = ELFDATA2LSB
    buf = buf.append(1);    // EI_VERSION = EV_CURRENT
    buf = buf.append(0);    // EI_OSABI = SysV
    var p: i32 = 0;       // EI_PAD (8 bytes)
    while (p < 8) {
        buf = buf.append(0);
        p = p + 1;
    }
    buf = elf_le16(buf, 2);                       // e_type    = ET_EXEC
    buf = elf_le16(buf, machine);                 // e_machine
    buf = elf_le32(buf, 1);                       // e_version = EV_CURRENT
    buf = elf_le64(buf, entry);                   // e_entry
    buf = elf_le64(buf, elf_eh_size() as i64);    // e_phoff (PHs follow the EH)
    buf = elf_le64(buf, zero64);                  // e_shoff (no section headers)
    buf = elf_le32(buf, 0);                       // e_flags
    buf = elf_le16(buf, elf_eh_size());           // e_ehsize
    buf = elf_le16(buf, elf_ph_size());           // e_phentsize
    buf = elf_le16(buf, 1);                       // e_phnum
    buf = elf_le16(buf, 0);                       // e_shentsize
    buf = elf_le16(buf, 0);                       // e_shnum
    buf = elf_le16(buf, 0);                       // e_shstrndx

    // ---- Program header (56 bytes): one PT_LOAD covering the file ----
    buf = elf_le32(buf, 1);                       // p_type  = PT_LOAD
    buf = elf_le32(buf, flags);                   // p_flags
    buf = elf_le64(buf, zero64);                  // p_offset
    buf = elf_le64(buf, elf_base_vaddr() as i64); // p_vaddr
    buf = elf_le64(buf, elf_base_vaddr() as i64); // p_paddr
    buf = elf_le64(buf, filesz);                  // p_filesz
    buf = elf_le64(buf, memsz);                   // p_memsz (incl. .bss)
    buf = elf_le64(buf, elf_page_align() as i64); // p_align

    return elf_cat(buf, body);
}

// ---- public wrappers ----

// elf_static_executable wraps a flat .text blob into a runnable static
// ELF-64 executable for arm64 Linux (R+X). Execution begins at the first
// byte of text; the program provides its own startup and exits via a
// syscall (no libc / crt0).
function elf_static_executable(text: i32[]): i32[] {
    return elf_image(text, 5, elf_em_aarch64()); // PF_R | PF_X
}

// elf_static_executable_x86 is the x86-64 counterpart of
// elf_static_executable (R+X).
function elf_static_executable_x86(text: i32[]): i32[] {
    return elf_image(text, 5, elf_em_x86_64()); // PF_R | PF_X
}

// elf_static_executable_data wraps .text + a data blob (rodata followed
// by the zero-initialised .bss globals an assembler appends) into a
// runnable static ELF-64 executable for arm64 Linux. Both live in a
// single PT_LOAD, with the data placed 8-byte aligned after .text. The
// segment is mapped R+W+X: the .bss globals must be writable and a single
// segment keeps the loader simple.
function elf_static_executable_data(text: i32[], data: i32[]): i32[] {
    var body: i32[] = elf_cat([], text);
    body = elf_pad_to_8(body);
    body = elf_cat(body, data);
    return elf_image(body, 7, elf_em_aarch64()); // PF_R | PF_W | PF_X
}

// elf_static_executable_data_x86 is the x86-64 counterpart of
// elf_static_executable_data (R+W+X), identical single-segment layout,
// only e_machine differs (EM_X86_64).
function elf_static_executable_data_x86(text: i32[], data: i32[]): i32[] {
    var body: i32[] = elf_cat([], text);
    body = elf_pad_to_8(body);
    body = elf_cat(body, data);
    return elf_image(body, 7, elf_em_x86_64()); // PF_R | PF_W | PF_X
}

// elf_static_executable_data_x86_at is elf_static_executable_data_x86 with
// an explicit entry offset within .text (the offset of the `_start` label,
// since asm.fern emits other functions before it).
function elf_static_executable_data_x86_at(text: i32[], data: i32[], entry_off: i32): i32[] {
    var body: i32[] = elf_cat([], text);
    body = elf_pad_to_8(body);
    body = elf_cat(body, data);
    return elf_image_entry(body, 7, elf_em_x86_64(), entry_off); // PF_R | PF_W | PF_X
}

// elf_static_executable_bss_x86_at is elf_static_executable_data_x86_at
// plus a trailing zero-init .bss of `bss` bytes (R+W+X). The .bss lives in
// memory just past the file content (p_memsz = p_filesz + bss); rip-
// relative refs to .bss globals resolve into it. This is the form a real
// program needs for its zero-init globals (cursors, scratch buffers, etc.).
pub function elf_static_executable_bss_x86_at(text: i32[], data: i32[], bss: i32, entry_off: i32): i32[] {
    var body: i32[] = elf_cat([], text);
    body = elf_pad_to_8(body);
    body = elf_cat(body, data);
    return elf_image_entry_bss(body, 7, elf_em_x86_64(), entry_off, bss); // PF_R | PF_W | PF_X
}

// ---- W^X two-segment layout ----
//
// The images above map a single PT_LOAD R+W+X — simple, but a
// writable+executable mapping is rejected by W^X-enforcing loaders
// (notably Android's SELinux policy). The W^X layout splits code and data
// into two PT_LOAD segments: an R+X segment for the headers + .text and a
// separate R+W segment for the data blob (.rodata + writable globals +
// .bss), so no mapping is ever both writable and executable. The data
// segment starts on the first page boundary past .text; an assembler must
// resolve data-symbol references against that page-aligned address (the
// Go reference does this in arm64.BytesProgramWX / x86_64.AssembleProgramWX).

// elf_text_vaddr_wx is the .text virtual address for the W^X image: past
// the ELF header + TWO program headers (code + data), so one elf_ph_size()
// further in than elf_text_vaddr(). An assembler resolving PC-relative
// fixups for a W^X image uses this as its textVAddr.
pub function elf_text_vaddr_wx(): i32 {
    return elf_base_vaddr() + elf_eh_size() + 2 * elf_ph_size();
}

// elf_page_up rounds `v` up to the next elf_page_align() (16 KiB)
// boundary — where the R+W data segment begins so it never shares a page
// (and thus page protections) with the R+X code segment.
function elf_page_up(v: i32): i32 {
    var pa: i32 = elf_page_align();
    var rem: i32 = v % pa;
    if (rem == 0) { return v; }
    return v + (pa - rem);
}

// elf_data_vaddr_wx is the load address of the R+W data segment for a W^X
// image whose .text is `text_len` bytes: the first page boundary at or
// after the end of .text. An assembler resolving data-symbol references
// for a W^X image (e.g. arm64_gas_link's data vaddr) must use this so the
// references line up with where elf_image_wx places the data blob.
pub function elf_data_vaddr_wx(text_len: i32): i32 {
    return elf_base_vaddr() + elf_page_up(elf_eh_size() + 2 * elf_ph_size() + text_len);
}

// elf_image_wx emits the ELF header (e_phnum = 2) + two PT_LOAD program
// headers, then .text, then — on the first page boundary past .text — the
// data blob. The code segment (headers + .text) is mapped R+X; the data
// segment is mapped R+W and may extend `bss` zero-filled bytes past its
// file content (p_memsz > p_filesz). `entry_off` is the entry's offset
// within .text. File offsets equal virtual-address offsets (both measured
// from elf_base_vaddr()), so the page-aligned data offset is congruent to
// its load address mod the page size — what the loader requires.
pub function elf_image_wx(text: i32[], data: i32[], machine: i32, entry_off: i32, bss: i32): i32[] {
    return elf_image_two_seg(text, data, machine, entry_off, bss, elf_base_vaddr(), 2); // ET_EXEC
}

// elf_image_two_seg is the shared W^X / PIE two-segment writer: an R+X code
// segment (headers + .text) and an R+W data segment (.rodata + globals +
// `bss` zero-fill), with the data blob on the first page boundary past
// .text. `base` is the load address (elf_base_vaddr() for the fixed-address
// W^X image, 0 for the position-independent ET_DYN image) and `e_type` is
// ET_EXEC (2) or ET_DYN (3). All vaddrs are base + offset, so the
// page-aligned data offset stays congruent to its load address mod the page.
function elf_image_two_seg(text: i32[], data: i32[], machine: i32, entry_off: i32, bss: i32, base: i32, e_type: i32): i32[] {
    var headers: i32 = elf_eh_size() + 2 * elf_ph_size(); // 176
    var text_end: i32 = headers + text.len();             // end of R+X segment
    var data_off: i32 = elf_page_up(text_end);            // file offset == vaddr offset of data
    var code_sz: i64 = text_end as i64;                   // headers + .text in one segment
    var data_filesz: i64 = data.len() as i64;
    var data_memsz: i64 = data_filesz + elf_u32_to_i64(bss);
    var code_vaddr: i64 = base as i64;
    var data_vaddr: i64 = (base + data_off) as i64;
    var entry: i64 = (base + headers + entry_off) as i64;
    var zero64: i64 = 0;

    var buf: i32[] = [];

    // ---- ELF-64 header (64 bytes) ----
    buf = buf.append(127);  // 0x7f  EI_MAG0
    buf = buf.append(69);   // 'E'
    buf = buf.append(76);   // 'L'
    buf = buf.append(70);   // 'F'
    buf = buf.append(2);    // EI_CLASS = ELFCLASS64
    buf = buf.append(1);    // EI_DATA  = ELFDATA2LSB
    buf = buf.append(1);    // EI_VERSION = EV_CURRENT
    buf = buf.append(0);    // EI_OSABI = SysV
    var p: i32 = 0;       // EI_PAD (8 bytes)
    while (p < 8) {
        buf = buf.append(0);
        p = p + 1;
    }
    buf = elf_le16(buf, e_type);                  // e_type (ET_EXEC / ET_DYN)
    buf = elf_le16(buf, machine);                 // e_machine
    buf = elf_le32(buf, 1);                       // e_version = EV_CURRENT
    buf = elf_le64(buf, entry);                   // e_entry
    buf = elf_le64(buf, elf_eh_size() as i64);    // e_phoff (PHs follow the EH)
    buf = elf_le64(buf, zero64);                  // e_shoff (no section headers)
    buf = elf_le32(buf, 0);                       // e_flags
    buf = elf_le16(buf, elf_eh_size());           // e_ehsize
    buf = elf_le16(buf, elf_ph_size());           // e_phentsize
    buf = elf_le16(buf, 2);                       // e_phnum (code + data)
    buf = elf_le16(buf, 0);                       // e_shentsize
    buf = elf_le16(buf, 0);                       // e_shnum
    buf = elf_le16(buf, 0);                       // e_shstrndx

    // ---- Program header 0 (56 bytes): R+X code (headers + .text) ----
    buf = elf_le32(buf, 1);          // p_type  = PT_LOAD
    buf = elf_le32(buf, 5);          // p_flags = PF_R | PF_X
    buf = elf_le64(buf, zero64);     // p_offset
    buf = elf_le64(buf, code_vaddr); // p_vaddr
    buf = elf_le64(buf, code_vaddr); // p_paddr
    buf = elf_le64(buf, code_sz);    // p_filesz
    buf = elf_le64(buf, code_sz);    // p_memsz
    buf = elf_le64(buf, elf_page_align() as i64); // p_align

    // ---- Program header 1 (56 bytes): R+W data (.rodata + globals + .bss) ----
    buf = elf_le32(buf, 1);          // p_type  = PT_LOAD
    buf = elf_le32(buf, 6);          // p_flags = PF_R | PF_W
    buf = elf_le64(buf, data_off as i64); // p_offset
    buf = elf_le64(buf, data_vaddr); // p_vaddr
    buf = elf_le64(buf, data_vaddr); // p_paddr
    buf = elf_le64(buf, data_filesz);// p_filesz
    buf = elf_le64(buf, data_memsz); // p_memsz (incl. .bss)
    buf = elf_le64(buf, elf_page_align() as i64); // p_align

    // ---- body: .text, then page padding, then the data blob ----
    buf = elf_cat(buf, text);
    while (buf.len() < data_off) {
        buf = buf.append(0);
    }
    return elf_cat(buf, data);
}

// elf_text_vaddr_pie is the .text vaddr for the position-independent
// (ET_DYN) image, measured from a load base of 0 (past the ELF header + two
// program headers). The self-host arm64 emitter materialises function
// addresses via runtime adrp/:lo12: and embeds no absolute pointers, so the
// PIE needs NO dynamic relocations: the kernel maps the ET_DYN at an
// arbitrary base and the PC-relative code runs unchanged.
pub function elf_text_vaddr_pie(): i32 {
    return elf_eh_size() + 2 * elf_ph_size(); // 176, base 0
}

// elf_data_vaddr_pie is the R+W data segment's base-0 vaddr for the PIE
// image: the first page boundary past a `text_len`-byte .text.
pub function elf_data_vaddr_pie(text_len: i32): i32 {
    return elf_page_up(elf_eh_size() + 2 * elf_ph_size() + text_len);
}

// elf_image_pie is elf_image_wx as a static position-independent executable:
// the same two-segment W^X layout but ET_DYN with a load base of 0 (and no
// dynamic relocations, since the self-host arm64 emitter materialises every
// function address via runtime adrp/:lo12: rather than absolute `.quad`
// slots). Lay .text / data out at elf_text_vaddr_pie() / elf_data_vaddr_pie()
// so the PC-relative fixups line up.
//
// NOT YET WIRED to a -target. The self-host arm64 backend stores heap
// pointers in 32 bits (the heap is sized to keep base + 3.5 GiB < 4 GiB —
// see asm_arm64.fern's heap_size), so the image must load in the low 4 GiB.
// A PIE is mapped at a high randomized base (on qemu AND real Android), which
// truncates those pointers and trips the alloc trap on the first allocation.
// Wiring this up needs the self-host backend to use 64-bit pointers (or an
// mmap heap that maps low), the way the native arm64 backend already does;
// until then this is a tested container only (see TestSelfHostELF). The
// native compiler's -target arm64-android (cmd/fern) is unaffected — it uses
// 64-bit pointers + an mmap heap and runs at any base.
pub function elf_image_pie(text: i32[], data: i32[], machine: i32, entry_off: i32, bss: i32): i32[] {
    return elf_image_two_seg(text, data, machine, entry_off, bss, 0, 3); // base 0, ET_DYN
}

// elf_static_executable_data_wx is the W^X counterpart of
// elf_static_executable_data: arm64 (EM_AARCH64), entry at the first
// instruction, no .bss. Pair it with an assembler that page-aligns
// .rodata (textVAddr = elf_text_vaddr_wx()).
function elf_static_executable_data_wx(text: i32[], data: i32[]): i32[] {
    return elf_image_wx(text, data, elf_em_aarch64(), 0, 0);
}

// elf_static_executable_data_x86_wx is the x86-64 counterpart of
// elf_static_executable_data_wx (EM_X86_64).
function elf_static_executable_data_x86_wx(text: i32[], data: i32[]): i32[] {
    return elf_image_wx(text, data, elf_em_x86_64(), 0, 0);
}

// elf_static_executable_bss_x86_wx_at is the W^X counterpart of
// elf_static_executable_bss_x86_at — the form a real program needs: an
// explicit entry offset within .text plus a trailing zero-init .bss of
// `bss` bytes in the R+W data segment (p_memsz = p_filesz + bss). This is
// what asm.fern's mmap-free heap reservation lowers to under W^X.
pub function elf_static_executable_bss_x86_wx_at(text: i32[], data: i32[], bss: i32, entry_off: i32): i32[] {
    return elf_image_wx(text, data, elf_em_x86_64(), entry_off, bss);
}

// ---- section headers + .symtab (#6637) ---------------------------------
//
// Every writer above emits program headers only: `e_shoff` is 0 and there
// are no sections, which is all a loader needs to RUN a static binary.
// `nm`, a debugger and a profiler read the SECTION side, so a symbol table
// needs that whole layer underneath it — a symbol's `st_shndx` has to name
// a real section index to resolve at all.
//
// This is written as an APPEND over a finished image rather than as a
// variant of any one writer. The images differ (one segment vs the W^X two,
// ET_EXEC vs the PIE ET_DYN) but the section layer is identical for all of
// them, and appending keeps it that way: sections are not loaded, so adding
// them past the last segment cannot disturb what is.
//
// Scope matches native's `-g` exactly: a static `.symtab`, not DWARF.

// Elf64_Sym is 24 bytes; Elf64_Shdr is 64.
pub function elf_sym_size(): i32 { return 24; }
pub function elf_sh_size(): i32 { return 64; }

// elf_align8_buf appends zero bytes until the length is a multiple of 8.
// Both .symtab and the section-header table are 8-aligned structures.
function elf_align8_buf(b: i32[]): i32[] {
    var out: i32[] = b;
    while ((out.len() % 8) != 0) { out = out.append(0); }
    return out;
}

// elf_str_bytes appends `s`'s bytes and a NUL. Byte-at-a-time because
// elf.fern is deliberately import-free.
function elf_str_bytes(b: i32[], s: string): i32[] {
    var out: i32[] = b;
    var i: i32 = 0;
    while (i < s.len()) {
        out = out.append(s[i] as i32);
        i = i + 1;
    }
    return out.append(0);
}

// elf_patch_le16 / elf_patch_le32 overwrite an already-emitted field.
// Subscripts are read-only in Fern, so this rebuilds through `.with`.
function elf_patch_le16(b: i32[], off: i32, v: i32): i32[] {
    var out: i32[] = b.with(off, v & 255);
    return out.with(off + 1, (v >> 8) & 255);
}

function elf_patch_le32(b: i32[], off: i32, v: i32): i32[] {
    var out: i32[] = b.with(off, v & 255);
    out = out.with(off + 1, (v >> 8) & 255);
    out = out.with(off + 2, (v >> 16) & 255);
    return out.with(off + 3, (v >> 24) & 255);
}

// elf_shdr appends one 64-byte Elf64_Shdr.
function elf_shdr(b: i32[], name_off: i32, sh_type: i32, flags: i64, addr: i64, off: i64, size: i64, link: i32, info: i32, align: i64, entsize: i64): i32[] {
    var out: i32[] = b;
    out = elf_le32(out, name_off);
    out = elf_le32(out, sh_type);
    out = elf_le64(out, flags);
    out = elf_le64(out, addr);
    out = elf_le64(out, off);
    out = elf_le64(out, size);
    out = elf_le32(out, link);
    out = elf_le32(out, info);
    out = elf_le64(out, align);
    out = elf_le64(out, entsize);
    return out;
}

// elf_append_symtab appends a static `.symtab` to a finished ELF image,
// naming each (sym_names[i], sym_offs[i]) as an STT_FUNC / STB_GLOBAL
// symbol at `text_vaddr + sym_offs[i]`, and adds the section-header table
// the symbols need to resolve: NULL, .text, .symtab, .strtab, .shstrtab.
//
// `text_off` / `text_len` locate .text within the image, and `text_vaddr`
// is the address it loads at — all three differ between the single-segment
// and W^X writers, so the caller supplies them rather than this guessing.
//
// `sym_sizes` is each symbol's extent in bytes, parallel to the other two.
// A profiler or backtrace needs it to decide which function an address falls
// in; a table of zero-sized symbols resolves exact entry points and nothing
// else. elf_func_syms computes it the way native's FuncSyms does.
//
// An EMPTY `sym_names` returns the image UNCHANGED. That is what makes the
// section layer safe to land ahead of the `-g` flag: every existing caller
// keeps a byte-identical image, and not by re-deriving one that ought to
// match — by not touching it.
pub function elf_append_symtab(img: i32[], text_vaddr: i32, text_off: i32, text_len: i32, sym_names: string[], sym_offs: i32[], sym_sizes: i32[]): i32[] {
    if (sym_names.len() == 0) { return img; }

    var nsym: i32 = sym_names.len();
    var zero64: i64 = 0;

    // .strtab: index 0 is the empty name, then each symbol's, recording the
    // st_name offset as it goes.
    var strtab: i32[] = [0];
    var name_offs: i32[] = [];
    var si: i32 = 0;
    while (si < nsym) {
        name_offs = name_offs.append(strtab.len());
        strtab = elf_str_bytes(strtab, sym_names[si]);
        si = si + 1;
    }

    // .shstrtab, laid out in section-index order.
    var shstrtab: i32[] = [0];
    var n_text: i32 = shstrtab.len();
    shstrtab = elf_str_bytes(shstrtab, ".text");
    var n_symtab: i32 = shstrtab.len();
    shstrtab = elf_str_bytes(shstrtab, ".symtab");
    var n_strtab: i32 = shstrtab.len();
    shstrtab = elf_str_bytes(shstrtab, ".strtab");
    var n_shstrtab: i32 = shstrtab.len();
    shstrtab = elf_str_bytes(shstrtab, ".shstrtab");

    var out: i32[] = elf_align8_buf(img);

    var symtab_off: i32 = out.len();
    var symtab_size: i32 = (nsym + 1) * elf_sym_size();

    // Entry 0 is the reserved null symbol: every field zero.
    var z: i32 = 0;
    while (z < elf_sym_size()) { out = out.append(0); z = z + 1; }

    var k: i32 = 0;
    while (k < nsym) {
        out = elf_le32(out, name_offs[k]);                        // st_name
        out = out.append(18);                                     // st_info = (STB_GLOBAL<<4)|STT_FUNC
        out = out.append(0);                                      // st_other
        out = elf_le16(out, 1);                                   // st_shndx = .text
        out = elf_le64(out, (text_vaddr + sym_offs[k]) as i64);   // st_value
        out = elf_le64(out, sym_sizes[k] as i64);                 // st_size
        k = k + 1;
    }

    var strtab_off: i32 = out.len();
    out = elf_cat(out, strtab);
    var shstrtab_off: i32 = out.len();
    out = elf_cat(out, shstrtab);

    out = elf_align8_buf(out);
    var sh_off: i32 = out.len();

    // NULL
    out = elf_shdr(out, 0, 0, zero64, zero64, zero64, zero64, 0, 0, zero64, zero64);
    // .text — SHT_PROGBITS, SHF_ALLOC|SHF_EXECINSTR
    out = elf_shdr(out, n_text, 1, 6, text_vaddr as i64, text_off as i64, text_len as i64, 0, 0, 16, zero64);
    // .symtab — sh_link is .strtab (3); sh_info is the first non-local
    // symbol index, which is 1 because the null symbol is the only local.
    out = elf_shdr(out, n_symtab, 2, zero64, zero64, symtab_off as i64, symtab_size as i64, 3, 1, 8, elf_sym_size() as i64);
    // .strtab
    out = elf_shdr(out, n_strtab, 3, zero64, zero64, strtab_off as i64, strtab.len() as i64, 0, 0, 1, zero64);
    // .shstrtab
    out = elf_shdr(out, n_shstrtab, 3, zero64, zero64, shstrtab_off as i64, shstrtab.len() as i64, 0, 0, 1, zero64);

    // Point the header at the table just written. e_shoff is 8 bytes at
    // 0x28; an image this size never needs the high word.
    out = elf_patch_le32(out, 40, sh_off);
    out = elf_patch_le16(out, 58, elf_sh_size());   // e_shentsize
    out = elf_patch_le16(out, 60, 5);               // e_shnum
    out = elf_patch_le16(out, 62, 4);               // e_shstrndx = .shstrtab
    return out;
}

// elf_text_off is where .text begins in a SINGLE-segment image: just past
// the ELF header and its one program header. The x86-64 binary path uses
// this layout; arm64's W^X link uses elf_wx_text_off below.
pub function elf_text_off(): i32 { return elf_eh_size() + elf_ph_size(); }

// elf_wx_text_off is where .text begins in a W^X two-segment image: just
// past the ELF header and its two program headers. The symbol appender
// needs it, and so does anything else locating .text in that layout.
pub function elf_wx_text_off(): i32 { return elf_eh_size() + 2 * elf_ph_size(); }

// elf_wx_text_vaddr is the address that offset loads at.
pub function elf_wx_text_vaddr(): i32 { return elf_base_vaddr() + elf_wx_text_off(); }

// elf_func_syms turns an assembler's parallel label tables into the symbol
// arrays elf_append_symtab wants, applying native's FuncSyms rule:
//
//   - a label with an empty name, or one starting with `.`, is INTERNAL —
//     a branch target, not a function — and is left out;
//   - `sec_filter` keeps only labels in one section (.text is 0 for the x86
//     tables; pass -1 when the assembler records no section, as arm64's does
//     not);
//   - the result is sorted by offset, then by name, because a symbol table
//     is read by address and an unsorted one makes `nm` output arbitrary;
//   - each symbol's SIZE is the distance to the next symbol, and the last
//     one runs to `text_end`. Sizes cannot be computed before the sort, so
//     this is the only place that can produce them.
//
// Returns the three arrays interleaved through out-params is not a thing
// Fern has, so the three accessors below each run the same selection. The
// duplication is deliberate: a struct-of-arrays return type would have to be
// declared in a module elf.fern is not allowed to import.
pub function elf_func_sym_names(lab_names: string[], lab_offs: i32[], lab_secs: i32[], sec_filter: i32, text_end: i32): string[] {
    var idx: i32[] = elf_func_sym_order(lab_names, lab_offs, lab_secs, sec_filter);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < idx.len()) { out = out.append(lab_names[idx[i]]); i = i + 1; }
    return out;
}

pub function elf_func_sym_offs(lab_names: string[], lab_offs: i32[], lab_secs: i32[], sec_filter: i32, text_end: i32): i32[] {
    var idx: i32[] = elf_func_sym_order(lab_names, lab_offs, lab_secs, sec_filter);
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < idx.len()) { out = out.append(lab_offs[idx[i]]); i = i + 1; }
    return out;
}

// elf_func_sym_sizes is the reason the order matters: each entry spans to the
// next symbol's offset, and the last to `text_end`.
pub function elf_func_sym_sizes(lab_names: string[], lab_offs: i32[], lab_secs: i32[], sec_filter: i32, text_end: i32): i32[] {
    var idx: i32[] = elf_func_sym_order(lab_names, lab_offs, lab_secs, sec_filter);
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < idx.len()) {
        var here: i32 = lab_offs[idx[i]];
        var end: i32 = text_end;
        if (i + 1 < idx.len()) { end = lab_offs[idx[i + 1]]; }
        var sz: i32 = end - here;
        if (sz < 0) { sz = 0; }
        out = out.append(sz);
        i = i + 1;
    }
    return out;
}

// elf_func_sym_order returns the indices of the labels that become symbols,
// sorted by offset then name. Insertion sort: a label table is small and
// already close to offset-ordered, since labels are recorded as code is
// emitted.
function elf_func_sym_order(lab_names: string[], lab_offs: i32[], lab_secs: i32[], sec_filter: i32): i32[] {
    var idx: i32[] = [];
    var i: i32 = 0;
    while (i < lab_names.len()) {
        var keep: boolean = lab_names[i].len() > 0;
        if (keep && lab_names[i][0:1] == ".") { keep = false; }
        if (keep && sec_filter >= 0) {
            if (i >= lab_secs.len() || lab_secs[i] != sec_filter) { keep = false; }
        }
        if (keep) { idx = idx.append(i); }
        i = i + 1;
    }
    var a: i32 = 1;
    while (a < idx.len()) {
        var cur: i32 = idx[a];
        var b: i32 = a - 1;
        while (b >= 0) {
            var prev: i32 = idx[b];
            var after: boolean = lab_offs[prev] > lab_offs[cur];
            if (!after && lab_offs[prev] == lab_offs[cur]) {
                after = elf_str_gt(lab_names[prev], lab_names[cur]);
            }
            if (!after) { b = 0 - 1; }
            else {
                idx = idx.with(b + 1, prev);
                idx = idx.with(b, cur);
                b = b - 1;
            }
        }
        a = a + 1;
    }
    return idx;
}

// elf_str_gt is `x > y` byte-wise, for the name tiebreak.
function elf_str_gt(x: string, y: string): boolean {
    var i: i32 = 0;
    while (i < x.len() && i < y.len()) {
        var cx: i32 = x[i] as i32;
        var cy: i32 = y[i] as i32;
        if (cx != cy) { return cx > cy; }
        i = i + 1;
    }
    return x.len() > y.len();
}
