// examples/self_host/asm_arm64_ir.fern — the arm64 instruction-selector for
// the target-agnostic stack IR (irlower.fern's Op[]). The arm64 sibling of
// asm_ir.fern: it lowers the SAME lowered op stream to arm64 in asm_arm64's
// dialect (__fn_<name> labels, the 16-byte operand rt-stack, x29 frame), so a
// fully-IR-eligible module gets a native-parity Perceus array RC backend on
// arm64 too. The array layout + RC runtime are IDENTICAL to x86's
// (__fern_arr_box: base = [cap, rc, len, e0..], data = base+16, element i at
// data+(i+1)*8) — arm64's heap is the same 8-byte-slot shape — so the SAME
// Op[] produces a compatible layout; only the instruction selection differs.
//
// Reuse: the backend-INDEPENDENT analysis (eligibility, array-return tracking,
// the helper-name map) is ircore's (ircore.lower_gated / array_ret_fns /
// is_fern_helper / ir_helper_symbol), and the GAS text this backend emits
// identically to x86 — the literal / shape labels, their `.data` blocks, the
// runtime `.globl` list — is asmcore's. Nothing
// here imports asm_ir. This file is therefore ONLY the arm64 codegen for the
// op stream.
//
// Like asm_ir, this is a SEPARATE module imported only by its differential
// driver (asm_ir_run -target arm64-linux) — asm_arm64.fern and the arm64 bootstrap stay
// untouched until a later fold/flip slice.

import "./parser";
import "./asmcore";
import "./checker";
import "./util";
import "./ir";
import "./irlower";
import "./irverify";
import "./irverifygate";
import "./lexer";
import "./ircore";
import "./ssa";
import "./ssa_lift";

// fr_ldr / fr_str load/store `reg` at the x29-relative frame offset `off`
// (always <= 0 — locals live below the frame pointer). Inlined copies of
// asm_arm64's frame_ldr/frame_str (this module can't import asm_arm64 without a
// cycle): a scaled ldr/str can't encode a negative offset and ldur/stur only
// reach -256, so for a frame with >32 slots materialise the address in x16
// (AAPCS scratch, dead across a frame access here) via sub first.
// fr_sub_imm emits `dst = base - imm`, materialising the immediate in x17 (IP1,
// AAPCS scratch, dead at every caller here) when it exceeds arm64's 12-bit
// add/sub immediate ceiling (#4095). The IR path's large functions exceed it
// — irlower.lower_stmt has ~590 locals → a 4736-byte frame and frame-relative
// offsets to match — which the AST emitter never hits (its frames stay under
// 4 KiB). A single MOVZ covers up to 65535; past that the high half goes in
// with MOVK, as the native backend's frameAddrX16 does, since the semantic
// lowering gives a large main one slot per value and passes 8,192 of them.
function fr_sub_imm(s: asmcore.EmitState, dst: string, base: string, imm: i32): asmcore.EmitState {
    if (imm <= 4095) {
        s = s.write("    sub " + dst + ", " + base + ", #" + util.i32_to_string(imm) + "\n"); return s;
    }
    s = s.write("    movz x17, #" + util.i32_to_string(imm & 65535) + "\n");
    if (imm > 65535) { s = s.write("    movk x17, #" + util.i32_to_string((imm >> 16) & 65535) + ", lsl #16\n"); }
    s = s.write("    sub " + dst + ", " + base + ", x17\n"); return s;
}

// arm64_copy_words emits a straight-line word copy of `n` 8-byte words from
// `src` to `dst` (#6728). x9/x10/x11 are AAPCS scratch and dead at both call
// sites; the loop is emitted rather than unrolled because n is 65536 here.
function arm64_copy_words(s: asmcore.EmitState, src: string, dst: string, n: i32): asmcore.EmitState {
    var lo: asmcore.LabelOut = asmcore.fresh_label(s);
    var lbl: string = lo.name;
    s = lo.state;
    s = s.write("    adrp x9, " + src + "\n    add x9, x9, :lo12:" + src + "\n");
    s = s.write("    adrp x10, " + dst + "\n    add x10, x10, :lo12:" + dst + "\n");
    s = s.write("    mov x11, #" + util.i32_to_string(n) + "\n");
    s = s.write(lbl + ":\n");
    s = s.write("    ldr x12, [x9], #8\n");
    s = s.write("    str x12, [x10], #8\n");
    s = s.write("    sub x11, x11, #1\n");
    s = s.write("    cbnz x11, " + lbl + "\n");
    return s;
}

function fr_ldr(s: asmcore.EmitState, reg: string, off: i32): asmcore.EmitState {
    if (off >= 0 - 256) {
        s = s.write("    ldr " + reg + ", [x29, #" + util.i32_to_string(off) + "]\n"); return s;
    }
    s = fr_sub_imm(s, "x16", "x29", 0 - off);
    s = s.write("    ldr " + reg + ", [x16]\n"); return s;
}

function fr_str(s: asmcore.EmitState, reg: string, off: i32): asmcore.EmitState {
    if (off >= 0 - 256) {
        s = s.write("    str " + reg + ", [x29, #" + util.i32_to_string(off) + "]\n"); return s;
    }
    s = fr_sub_imm(s, "x16", "x29", 0 - off);
    s = s.write("    str " + reg + ", [x16]\n"); return s;
}

// ir_bin_asm renders the arm64 for one IR binary op: lhs in x0, rhs in x1,
// result in x0 — mirroring asm_arm64's own ExprBinary sequences (64-bit ops,
// signed i32 div/rem via sdiv/msub) so the IR and AST paths agree.
// `d` holds the left operand and takes the result, `r` holds the right, and
// `t` is a scratch the rem forms need. The stack machine passes x0/x1/x2;
// the register path passes its own working registers, since x0 is a value
// home there and must not be written by an arm that is not a call.
function ir_bin_asm(tag: i32, width: i32, d: string, r: string, t: string): string {
    if (tag == 21) { return "    add " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 22) { return "    sub " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 23) { return "    mul " + d + ", " + d + ", " + r + "\n"; }
    // i32 signed division narrows its result back to 32 bits: the operands
    // are held sign-extended in 64-bit regs, and the one quotient that overflows
    // i32 — INT_MIN / -1 = 2^31 — is representable in the 64-bit register, so
    // without the sxtw it stayed positive instead of wrapping to INT_MIN like
    // native, interp, and the x86 IR path's guarded div (#4329). sdiv itself
    // is non-trapping (x/0 = 0), so no guard is needed — only the narrow.
    // rem needs no sxtw: |rem| < |divisor| keeps it in i32 range, and the
    // INT_MIN % -1 msub yields 0 in-register already.
    if (tag == 24 && width != 64) { return "    sdiv " + d + ", " + d + ", " + r + "\n    sxtw " + d + ", " + ssa_wreg(d) + "\n"; }
    if (tag == 24) { return "    sdiv " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 26) { return "    sdiv " + t + ", " + d + ", " + r + "\n    msub " + d + ", " + t + ", " + r + ", " + d + "\n"; }
    // Unsigned 64-bit div/rem (u64, #2904): udiv instead of sdiv.
    if (tag == 25) { return "    udiv " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 27) { return "    udiv " + t + ", " + d + ", " + r + "\n    msub " + d + ", " + t + ", " + r + ", " + d + "\n"; }
    if (tag == 28) { return "    and " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 29) { return "    orr " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 30) { return "    eor " + d + ", " + d + ", " + r + "\n"; }
    // Shift counts mask to the operand width: mod 64 for i64 (the x-form masks
    // the count register to 6 bits in hardware), mod 32 for i32/u32. The i32
    // shifts used to emit the bare x-form, so a count >= 32 wrapped mod 64
    // instead of mod 32 (#4330). Mirror asm_ir.fern's fix: mask the count to 5
    // bits BUT keep the 64-bit shift, so the operand's slot extension is
    // preserved — a u32 is held zero-extended (bit 63 = 0) and an i32
    // sign-extended (bit 63 = bit 31), and `asr`/`lsr`/`lsl` on the full
    // register does the right thing for both. (A w-form `asr` would fill from
    // bit 31, corrupting a u32 `>>` — which lowers through shr_s — whose bit 31
    // is a data bit, not a sign bit.)
    if (width == 64) {
        if (tag == 31) { return "    lsl " + d + ", " + d + ", " + r + "\n"; }
        if (tag == 32) { return "    asr " + d + ", " + d + ", " + r + "\n"; }
        if (tag == 33) { return "    lsr " + d + ", " + d + ", " + r + "\n"; }
    }
    if (tag == 31) { return "    and " + r + ", " + r + ", #31\n    lsl " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 32) { return "    and " + r + ", " + r + ", #31\n    asr " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 33) { return "    and " + r + ", " + r + ", #31\n    lsr " + d + ", " + d + ", " + r + "\n"; }
    if (tag == 35) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", eq\n"; }
    if (tag == 36) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", ne\n"; }
    if (tag == 37) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", lt\n"; }
    if (tag == 38) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", le\n"; }
    if (tag == 39) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", gt\n"; }
    if (tag == 40) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", ge\n"; }
    // Unsigned 64-bit compares (u64, #2904): the lo/ls/hi/hs condition codes
    // read CF instead of the signed N/V flags — correct once bit 63 is set.
    if (tag == 41) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", lo\n"; }
    if (tag == 42) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", ls\n"; }
    if (tag == 43) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", hi\n"; }
    if (tag == 44) { return "    cmp " + d + ", " + r + "\n    cset " + d + ", hs\n"; }
    return ircore.unsupported_op_refuse(tag, "arm64");
}

// ir_cmp_cond names the condition code an integer comparison feeds when its
// result goes straight to a branch: the code that holds when the comparison
// does (when_true) or its inverse. `cmp x0, x1` has already set the flags, so
// the signed/unsigned split is the same one ir_bin_asm's cset family makes.
function ir_cmp_cond(tag: i32, when_true: boolean): string {
    // Tags 35 (eq) through 44 (ge_u), in order; any other tag reads as ge_u.
    var direct: string[] = ["eq", "ne", "lt", "le", "gt", "ge", "lo", "ls", "hi", "hs"];
    var neg: string[] = ["ne", "eq", "ge", "gt", "le", "lt", "hs", "hi", "ls", "lo"];
    var at: i32 = tag - 35;
    if (at < 0 || at > 9) { at = 9; }
    if (when_true) { return direct[at]; }
    return neg[at];
}

// shift_imm_asm is one shift of `a` by a known count into `d`, the mask folded
// into the immediate at the operand's width; the count comes from the
// allocator's immediate table.
function shift_imm_asm(tag: i32, width: i32, count: i64, d: string, a: string): string {
    var k: i32 = (count as i32) & 31;
    if (width == 64) { k = (count as i32) & 63; }
    var imm: string = " " + d + ", " + a + ", #" + util.i32_to_string(k) + "\n";
    if (tag == 31) { return "    lsl" + imm; }
    if (tag == 32) { return "    asr" + imm; }
    return "    lsr" + imm;
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_stack_op's dispatch — see ir.is_str_op_kind). The runtime helpers
// come from asm_arm64.emit_runtime, gated by the mark_* needs set here.
// emit_mismatch_arm64 emits the __mismatch kernel (#8791): operand stack
// [a box, ao, b box, bo, n] (n on top) -> the offset of the first byte where
// a[ao..ao+n) and b[bo..bo+n) differ, or the clamped n when they are equal.
//
// emit_str_op's memchr kernel with the broadcast needle replaced by a second
// operand stream: `eor` zeroes the lanes that match and `cmtst` turns the
// survivors into all-ones, so the shrn / fmov / rbit / clz gather that finds
// memchr's first hit finds the first DIFFERENCE here unchanged.
//
// Sub-16 ranges take memcmp's OVERLAPPING WINDOWS rather than the scalar
// remainder — the leading and trailing 8 (or 4) bytes, which overlap, so two
// loads per operand cover the whole band. A line-oriented caller compares
// SHORT ranges, and walking those a byte at a time is the cost this kernel
// exists to remove.
//
// The clamps are the op's contract, not defensive tidying: the value returned
// on equality is the clamped n, so a caller asking for more than either range
// holds gets the shorter answer and its `== n` test fails.
//
// x8 / x9 are the two cursors (ld1 has no indexed form), x12 remembers a's
// range start so the answer is one subtraction and x13 its end; x4 keeps the
// clamped n for the equal case. Leaf body — no call, so every register is free.
function emit_mismatch_arm64(s: asmcore.EmitState): asmcore.EmitState {
    var mlo: asmcore.LabelOut = asmcore.fresh_label(s);
    var lb: string = mlo.name;
    s = mlo.state;
    s = s.write("    ldr x4, [sp], #16\n    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    ldr x5, [x0, #8]\n    ldr x0, [x0]\n");
    s = s.write("    ldr x6, [x2, #8]\n    ldr x2, [x2]\n");
    // Each offset clamps into [0, len] of its own string.
    s = s.write("    cmp x1, #0\n    b.ge " + lb + "_aop\n    mov x1, #0\n");
    s = s.write(lb + "_aop:\n    cmp x1, x5\n    csel x1, x5, x1, gt\n");
    s = s.write("    cmp x3, #0\n    b.ge " + lb + "_bop\n    mov x3, #0\n");
    s = s.write(lb + "_bop:\n    cmp x3, x6\n    csel x3, x6, x3, gt\n");
    // n = min(n, len(a) - ao, len(b) - bo), floored at 0.
    s = s.write("    sub x5, x5, x1\n    sub x6, x6, x3\n");
    s = s.write("    cmp x4, x5\n    csel x4, x5, x4, gt\n");
    s = s.write("    cmp x4, x6\n    csel x4, x6, x4, gt\n");
    s = s.write("    cmp x4, #0\n    b.ge " + lb + "_nok\n    mov x4, #0\n");
    s = s.write(lb + "_nok:\n    add x8, x0, x1\n    add x9, x2, x3\n");
    s = s.write("    mov x12, x8\n    add x13, x8, x4\n");
    // NEON loop, 16 bytes of each operand an iteration. The load runs only
    // with a full block left in both ranges, so it never reads past either
    // and there is no alignment prologue to pay.
    s = s.write(lb + "_vec:\n    sub x10, x13, x8\n    cmp x10, #16\n    b.lt " + lb + "_short\n");
    s = s.write("    ld1 {v0.16b}, [x8]\n    ld1 {v1.16b}, [x9]\n");
    s = s.write("    eor v0.16b, v0.16b, v1.16b\n    cmtst v0.16b, v0.16b, v0.16b\n");
    s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x11, d0\n");
    s = s.write("    cbz x11, " + lb + "_next\n");
    // Lowest set bit -> lane. shrn leaves four mask bits per input byte,
    // hence the >>2 — the same nibble arithmetic memchr pays.
    s = s.write("    rbit x11, x11\n    clz x11, x11\n    lsr x11, x11, #2\n");
    s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
    s = s.write(lb + "_next:\n    add x8, x8, #16\n    add x9, x9, #16\n    b " + lb + "_vec\n");
    // 8..15 bytes: the leading 8 and the trailing 8, which overlap.
    s = s.write(lb + "_short:\n    cmp x10, #8\n    b.lt " + lb + "_w4\n");
    s = s.write("    ldr x11, [x8]\n    ldr x14, [x9]\n    eor x11, x11, x14\n");
    s = s.write("    cbnz x11, " + lb + "_w8l\n");
    s = s.write("    sub x14, x10, #8\n    ldr x11, [x8, x14]\n    ldr x15, [x9, x14]\n");
    s = s.write("    eor x11, x11, x15\n    cbz x11, " + lb + "_eq\n");
    // The leading window proved [0, 8) equal, so a difference the trailing
    // window reports cannot land below 8 — its offset is the first one.
    s = s.write("    add x8, x8, x14\n");
    // Lowest set bit of the xor >> 3 is the byte, little-endian.
    s = s.write(lb + "_w8l:\n    rbit x11, x11\n    clz x11, x11\n    lsr x11, x11, #3\n");
    s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
    // 4..7 bytes: the same pair of windows, four bytes wide.
    s = s.write(lb + "_w4:\n    cmp x10, #4\n    b.lt " + lb + "_tail\n");
    s = s.write("    ldr w11, [x8]\n    ldr w14, [x9]\n    eor w11, w11, w14\n");
    s = s.write("    cbnz w11, " + lb + "_w4l\n");
    s = s.write("    sub x14, x10, #4\n    ldr w11, [x8, x14]\n    ldr w15, [x9, x14]\n");
    s = s.write("    eor w11, w11, w15\n    cbz w11, " + lb + "_eq\n");
    s = s.write("    add x8, x8, x14\n");
    s = s.write(lb + "_w4l:\n    rbit w11, w11\n    clz w11, w11\n    lsr w11, w11, #3\n");
    s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
    // Scalar remainder: fewer than 4 bytes in the band, or fewer than 16 left
    // after the vector loop.
    s = s.write(lb + "_tail:\n    cmp x8, x13\n    b.ge " + lb + "_eq\n");
    s = s.write("    ldrb w11, [x8]\n    ldrb w14, [x9]\n    cmp w11, w14\n");
    s = s.write("    b.ne " + lb + "_th\n");
    s = s.write("    add x8, x8, #1\n    add x9, x9, #1\n    b " + lb + "_tail\n");
    s = s.write(lb + "_th:\n    sub x2, x8, x12\n    b " + lb + "_done\n");
    s = s.write(lb + "_eq:\n    mov x2, x4\n");
    s = s.write(lb + "_done:\n    str x2, [sp, #-16]!\n");
    return s;
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 225) {  // memchr
        // operand stack [box, byte, from] (from on top) -> i32 index or -1.
        //
        // NEON, 16 bytes an iteration, the same kernel the native arm64
        // emitter runs: dup to splat the needle, then ld1 / cmeq / shrn /
        // fmov / rbit+clz. §3.4 step 3 for this tier — the meaning is
        // unchanged, only the speed.
        //
        // NEON has no pmovmskb, so the mask comes out as a NIBBLE per input
        // byte: cmeq gives 0x00/0xFF per lane, `shrn v0.8b, v0.8h, #4` narrows
        // each 16-bit lane to one byte carrying four of those bits, and the
        // lane index is therefore the lowest set bit over FOUR.
        //
        // The vector load runs only with a full block left, so it never reads
        // past the string and there is no alignment prologue to pay. x5 is the
        // cursor pointer (ld1 has no indexed form), x6 the end, x7 the mask.
        var mlo: asmcore.LabelOut = asmcore.fresh_label(s);
        var l_clamped: string = mlo.name;
        var mlo2: asmcore.LabelOut = asmcore.fresh_label(mlo.state);
        var l_vec: string = mlo2.name;
        var mlo3: asmcore.LabelOut = asmcore.fresh_label(mlo2.state);
        var l_next: string = mlo3.name;
        var mlo4: asmcore.LabelOut = asmcore.fresh_label(mlo3.state);
        var l_tail: string = mlo4.name;
        var mlo5: asmcore.LabelOut = asmcore.fresh_label(mlo4.state);
        var l_hit: string = mlo5.name;
        var mlo6: asmcore.LabelOut = asmcore.fresh_label(mlo5.state);
        var l_none: string = mlo6.name;
        var mlo7: asmcore.LabelOut = asmcore.fresh_label(mlo6.state);
        var l_done: string = mlo7.name;
        s = mlo7.state;
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
        s = s.write("    cmp x2, #0\n    b.ge " + l_clamped + "\n    mov x2, #0\n");
        s = s.write(l_clamped + ":\n");
        // Unsigned compare against 255 rejects both a negative byte and one
        // above the range in a single test. Checked once, so neither loop
        // below needs a per-iteration guard.
        s = s.write("    cmp x1, #255\n    b.hi " + l_none + "\n");
        s = s.write("    cmp x2, x3\n    b.ge " + l_none + "\n");
        s = s.write("    add x5, x0, x2\n    add x6, x0, x3\n");
        s = s.write("    dup v1.16b, w1\n");
        s = s.write(l_vec + ":\n");
        s = s.write("    sub x7, x6, x5\n    cmp x7, #16\n    b.lt " + l_tail + "\n");
        s = s.write("    ld1 {v0.16b}, [x5]\n    cmeq v0.16b, v0.16b, v1.16b\n");
        s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
        s = s.write("    cbz x7, " + l_next + "\n");
        s = s.write("    rbit x4, x7\n    clz x4, x4\n    lsr x4, x4, #2\n");
        s = s.write("    add x5, x5, x4\n    sub x2, x5, x0\n    b " + l_done + "\n");
        s = s.write(l_next + ":\n    add x5, x5, #16\n    b " + l_vec + "\n");
        // Scalar tail: fewer than 16 bytes left, and the whole algorithm for a
        // string shorter than one block.
        s = s.write(l_tail + ":\n");
        s = s.write("    cmp x5, x6\n    b.ge " + l_none + "\n");
        s = s.write("    ldrb w4, [x5]\n");
        s = s.write("    cmp x4, x1\n    b.eq " + l_hit + "\n");
        s = s.write("    add x5, x5, #1\n    b " + l_tail + "\n");
        s = s.write(l_hit + ":\n    sub x2, x5, x0\n    b " + l_done + "\n");
        s = s.write(l_none + ":\n    mov x2, #-1\n");
        s = s.write(l_done + ":\n    str x2, [sp, #-16]!\n");
        return s;
    }
    if (o.kind_tag == 245) {  // mismatch
        return emit_mismatch_arm64(s);
    }
    if (o.kind_tag == 234) {  // rmemchr
        // operand stack [box, byte, from] (from on top) -> the index of the
        // LAST `byte` at or before `from`, or -1.
        //
        // NEON, 16 bytes an iteration, walking DOWN: the block ENDING at the
        // cursor is loaded at `cursor - 15`. §3.4 step 3 for this tier.
        //
        // This is memchr's body read backwards, and the whole difference is
        // which end of the mask is scanned: the rightmost match is the HIGHEST
        // set bit, and arm64 has no find-highest, so the bit index is 63 - clz
        // and the lane is that over four (shrn gives four mask bits per input
        // byte). memchr divides the LOWEST set bit by the same four.
        //
        // x5 is the block base INDEX and x6 its address; both are carried
        // across iterations and stepped by 16 rather than recomputed from the
        // cursor, which measured about a third of the loop on the x86-64 twin.
        // x3 holds len-1 for the clamp and is dead after it, so the hit path
        // borrows it for the 63.
        var rlo: asmcore.LabelOut = asmcore.fresh_label(s);
        var r_ok: string = rlo.name;
        var rlo2: asmcore.LabelOut = asmcore.fresh_label(rlo.state);
        var r_vec: string = rlo2.name;
        var rlo3: asmcore.LabelOut = asmcore.fresh_label(rlo2.state);
        var r_next: string = rlo3.name;
        var rlo4: asmcore.LabelOut = asmcore.fresh_label(rlo3.state);
        var r_vecdone: string = rlo4.name;
        var rlo5: asmcore.LabelOut = asmcore.fresh_label(rlo4.state);
        var r_tail: string = rlo5.name;
        var rlo6: asmcore.LabelOut = asmcore.fresh_label(rlo5.state);
        var r_loop: string = rlo6.name;
        var rlo7: asmcore.LabelOut = asmcore.fresh_label(rlo6.state);
        var r_none: string = rlo7.name;
        var rlo8: asmcore.LabelOut = asmcore.fresh_label(rlo7.state);
        var r_done: string = rlo8.name;
        s = rlo8.state;
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
        // Unsigned compare against 255 rejects a negative byte and one above
        // the range in a single test. Checked once, so neither loop below
        // needs a per-iteration guard.
        s = s.write("    cmp x1, #255\n    b.hi " + r_none + "\n");
        // Clamp `from` down to the last index; an empty string has none.
        s = s.write("    sub x3, x3, #1\n    cmp x3, #0\n    b.lt " + r_none + "\n");
        s = s.write("    cmp x2, x3\n    b.le " + r_ok + "\n    mov x2, x3\n");
        s = s.write(r_ok + ":\n");
        s = s.write("    dup v1.16b, w1\n");
        // Vector loop while a whole block still fits BELOW the cursor. That
        // bound keeps the load in bounds at the LOW end, where memchr's
        // "16 or more left" keeps it in bounds at the high end. A negative
        // `from` fails this compare and lands on the tail's guard.
        s = s.write("    cmp x2, #15\n    b.lt " + r_tail + "\n");
        s = s.write("    sub x5, x2, #15\n    add x6, x0, x5\n");
        s = s.write(r_vec + ":\n");
        s = s.write("    ld1 {v0.16b}, [x6]\n    cmeq v0.16b, v0.16b, v1.16b\n");
        s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
        s = s.write("    cbz x7, " + r_next + "\n");
        s = s.write("    clz x4, x7\n    mov x3, #63\n    sub x4, x3, x4\n    lsr x4, x4, #2\n");
        s = s.write("    add x2, x5, x4\n    b " + r_done + "\n");
        s = s.write(r_next + ":\n");
        s = s.write("    sub x5, x5, #16\n    cmp x5, #0\n    b.lt " + r_vecdone + "\n");
        s = s.write("    sub x6, x6, #16\n    b " + r_vec + "\n");
