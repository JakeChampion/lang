        s = s.write("    cmp x1, x3\n    b.ge " + s_end + "\n");
        s = s.write("    add x5, x0, x1\n    ldrb w6, [x5]\n");
        s = s.write("    cmp x6, x4\n    b.hs " + s_short_next + "\n");
        s = s.write("    add x5, x2, x6, lsl #3\n    ldr x7, [x5, #8]\n");
        s = s.write("    cmp x7, #0\n    b.ne " + s_hit + "\n");
        s = s.write(s_short_next + ":\n    add x1, x1, #1\n    b " + s_short + "\n");
        s = s.write(s_hit + ":\n    str x1, [sp, #-16]!\n    b " + s_done + "\n");
        s = s.write(s_end + ":\n    str x3, [sp, #-16]!\n");
        s = s.write(s_done + ":\n");
        return s;
    }
    if (o.kind_tag == 253) {  // sum_bytes
