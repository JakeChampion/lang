    // proc_exec: execve over an argv built from the args array.
    if (s.has_need("proc_exec")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec(tgt), s.struct_decls, s);
    }
    // __fern_map_hash_seed() → core/map's per-process string-hash seed
    // (#6194), drawn once via the Fern __fn___fern_random_i32 and cached in the unit-local
    // __fern_map_seed word.
    //
    // Forced nonzero: the word doubles as its own "already drawn" flag, and 0
    // is also core/map's "unseeded" sentinel, so a drawn 0 would both re-draw
    // every call and silently leave that map unseeded.
    if (s.has_need("map_hash_seed")) {
        s = s.write(".globl __fern_map_hash_seed\n");
        s = s.write(".type __fern_map_hash_seed, %function\n");
        s = s.write("__fern_map_hash_seed:\n");
        s = s.write("    adrp x1, __fern_map_seed\n");
        s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
        s = s.write("    ldr w0, [x1]\n");
        s = s.write("    cbnz w0, .Lmapseed_ret\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_random_i32\n");
        s = s.write("    orr w0, w0, #1\n");
        s = s.write("    adrp x1, __fern_map_seed\n");
        s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
        s = s.write("    str w0, [x1]\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write(".Lmapseed_ret:\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_hash_seed, .-__fern_map_hash_seed\n");
    }
    // proc_exec is Fern now (#2649) — see the migrated-helpers section.
    // proc_fork() → 0 in the child, the child's pid in the parent, -errno on
    // failure — the crash-only supervision primitive (docs/CRASH-ONLY-SERVE.md
    // D2', #5686). The kernel's return shape IS the contract.
    //
    // arm64 Linux is Fern (#2649): it has no bare fork(2) and spells it
    // clone(SIGCHLD, 0, 0, 0, 0), which is exactly __syscall5.
    //
    // Darwin cannot be. XNU's fork returns the pid in x0 and marks the child in
    // **x1**, and no __syscall* intrinsic can see a second return register — the
    // carry-flag half would have been free, since darwinize already injects that
    // fold. So this joins monotonic_ns as a hand-written Darwin body, under the
    // __fn___ name its Fern sibling uses: a zero-arg helper's stack and register
    // conventions coincide, so the call site never learns which one it got.
    // Heap-independent, gated by its own need.
    if (s.has_need("proc_fork")) {
        if (darwin) {
            s = s.write(".globl __fn___fern_proc_fork\n");
            s = s.write(".type __fn___fern_proc_fork, %function\n");
            s = s.write("__fn___fern_proc_fork:\n");
            s = s.write("    stp x29, x30, [sp, #-16]!\n");
            s = s.write("    mov x29, sp\n");
            s = s.write("    mov x16, #2\n");
            s = s.write("    svc #0x80\n");
            s = s.write("    b.cc .Lpf_ok\n");
            s = s.write("    neg x0, x0\n");            // carry set: +errno -> -errno
            s = s.write("    b .Lpf_done\n");
            s = s.write(".Lpf_ok:\n");
            s = s.write("    cbz x1, .Lpf_done\n");     // parent: x0 = child pid
            s = s.write("    mov x0, #0\n");            // child
            s = s.write(".Lpf_done:\n");
            s = s.write("    ldp x29, x30, [sp], #16\n");
            s = s.write("    ret\n");
            s = s.write(".size __fn___fern_proc_fork, .-__fn___fern_proc_fork\n");
        } else {
            s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_fork(tgt), s.struct_decls, s);
        }
    }
    // __fern_str_lines is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_lines, emitted (need-gated) in the migrated-helpers
    // section below. The single shared body serves both arm64 AST + IR; its deps
    // are declared by mark_str_lines / runtime_need_deps.
    // __fern_arr_i32_product / _sum are now Fern runtime functions (#2649),
    // compiled through emit_function (see asmcore.rt_src_arr_i32_*). They link
    // as __fn___fern_arr_i32_product / __fn___fern_arr_i32_sum and are called
    // via the ordinary stack convention; the array param is borrowed.
    if (s.has_need("arr_i32_product")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_product(), s.struct_decls, s);
    }
    if (s.has_need("arr_i32_sum")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_sum(), s.struct_decls, s);
    }
    // __fern_arr_i32_index_of is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_i32_index_of. Linear scan returning the first index
    // where arr[i] == target, or -1; called via the stack convention.
    if (s.has_need("arr_i32_index_of")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_index_of(), s.struct_decls, s);
    }
    // __fern_arr_i32_index_of_opt backs xs.index_of(x) (#4387): the raw scan
    // above returns the -1 sentinel and still backs .contains(x); this one
    // carries the Option box in its Fern body, so the IR call site is a plain
    // call. It allocates, so the need also pulls in the heap runtime.
    if (s.has_need("arr_i32_index_of_opt")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_index_of_opt(), s.struct_decls, s);
    }
    // __fern_arr_i32_min_opt / _max_opt back xs.min() / .max() on the IR path
    // (#3457): unlike the raw-extremum __fern_arr_i32_min / _max above (whose
    // empty-array guard and Option box the AST call site open-codes), these carry
    // both in their Fern bodies, so the IR call site is a plain call. Emitted as
    // one module; they allocate, so the need also pulls in the heap runtime.
    if (s.has_need("arr_i32_min_max_opt")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_min_max_opt(), s.struct_decls, s);
    }
    return s;
}

// emit_rt_float_transcendentals emits the f64 transcendental bundle — arm64 has
// no transcendental instruction, so sin/cos/exp/log/pow are calls into these.
// Gated on the "float_transcendentals" need, which the op_funary/op_fbin
// lowerings mark; native arm64 gates the same bundle on usesFloatTranscendentals.
// These are fdlibm's kernels, and they replace polynomials whose own comment
// here claimed "<1e-5 against libm" while measuring 3.2e10 ulp for sin, 4.5e7
// for exp and 9844 for log.
//
// Same reduction and same `frintn` as internal/codegen/arm64's
// emitFloatTranscendentalsRuntime (ties-to-EVEN, matching x86's
// `roundsd …, 0`; the more familiar `frinta` rounds ties away and would
// disagree). The self-host cannot import Go, so the .Lfc_* table below is a
// literal copy of internal/codegen/fdlibm's — whose selfhost_parity_test pins
// it entry for entry. internal/e2e/f64_ulp_test.go is the gate for the native
// pair.
//
// Two things that are corrections rather than refinements:
//
//   - pi/2 is carried as THREE 33-bit chunks (~99 bits). Two is not enough near
//     a zero of sine, where the reduced argument IS the answer, so the
//     reduction's absolute error becomes the result's relative error: sin(pi)
//     measured 285,696 ulp. A fourth chunk makes it worse, not better.
//   - Every function guards its domain: log(0) returned -709.09 and log(-1)
//     returned 0 without it. The domain guard is not what keeps 2^k in range —
//     that is the two half-scales the reconstruction is built from.
//
// fc_pio2_reduce: d0 = x -> x10 = quadrant (k&3), d0 = r with |r| <= pi/4.
// prefix keeps the local labels unique across the two emission sites (sin and
// cos), which previously each carried their own inlined copy of this chain.
//
// |x| >= 2^20 (biased exponent >= 1043) puts k past pio2h's 22 exact mantissa
// bits, so the Cody-Waite chain below reduces against noise there and calls
// __fern_rem_pio2_large instead. The trig guard already returned Inf/NaN, and
// the caller's frame is already pushed.
function fc_pio2_reduce(s: asmcore.EmitState, prefix: string): asmcore.EmitState {
    s = s.write("    fmov x13, d0\n");
    s = s.write("    ubfx x13, x13, #52, #11\n");
    s = s.write("    cmp x13, #1043\n");
    s = s.write("    b.lt .L" + prefix + "_cw\n");
    s = s.write("    bl __fern_rem_pio2_large\n");
    s = s.write("    b .L" + prefix + "_red\n");
    s = s.write(".L" + prefix + "_cw:\n");
    s = emit_ldc(s, "d1", ".Lfc_2opi");
    s = s.write("    fmul d1, d1, d0\n");
    s = s.write("    frintn d1, d1\n");
    s = s.write("    fcvtzs x10, d1\n");
    s = emit_ldc(s, "d2", ".Lfc_pio2h");
    s = s.write("    fmul d2, d1, d2\n");
    s = s.write("    fsub d0, d0, d2\n");
    s = emit_ldc(s, "d2", ".Lfc_pio2m");
    s = s.write("    fmul d2, d1, d2\n");
    s = s.write("    fsub d0, d0, d2\n");
    s = emit_ldc(s, "d2", ".Lfc_pio2l");
    s = s.write("    fmul d1, d1, d2\n");
    s = s.write("    fsub d0, d0, d1\n");
    s = s.write("    and x10, x10, #3\n");
    s = s.write(".L" + prefix + "_red:\n");
    return s;
}

// Arg in d0 (pow also d1), result in d0; x12 is emit_ldc's scratch.
function emit_rt_float_transcendentals(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    .section .rodata\n");
    s = s.write("    .align 8\n");
    s = s.write(".Lfc_one: .double 1.0\n");
    s = s.write(".Lfc_half: .double 0.5\n");
    s = s.write(".Lfc_two: .double 2.0\n");
    s = s.write(".Lfc_sqrt2: .double 1.4142135623730951\n");
    s = s.write(".Lfc_invln2: .double 1.44269504088896338700e+00\n");
    s = s.write(".Lfc_ln2hi: .double 6.93147180369123816490e-01\n");
    s = s.write(".Lfc_ln2lo: .double 1.90821492927058770002e-10\n");
    s = s.write(".Lfc_2opi: .double 6.36619772367581382433e-01\n");
    s = s.write(".Lfc_pio2h: .double 1.57079632673412561417e+00\n");
    s = s.write(".Lfc_pio2m: .double 6.07710050630396597660e-11\n");
    s = s.write(".Lfc_pio2l: .double 2.02226624879595063154e-21\n");
    // pi/2 as an unevaluated double-double, plus the two scales that turn
    // __fern_rem_pio2_large's 126-bit fraction into a double.
    s = s.write(".Lfc_pio2hi: .double 1.5707963267948966\n");
    s = s.write(".Lfc_pio2lo: .double 6.123233995736766e-17\n");
    s = s.write(".Lfc_2m62: .double 2.168404344971009e-19\n");
    s = s.write(".Lfc_2m115: .double 2.407412430484045e-35\n");
    // 2/pi in binary, MSB-first, one limb per 64 fraction bits starting at
    // 2^-1 in limb 1 — the window Payne-Hanek indexes with the argument's own
    // exponent. The leading zero limb lets that index start above 2^-1 without
    // a bounds test; the length covers the largest finite double. Same table
    // as the native backends'.
    s = s.write(".Lfc_2opi_bits:\n");
    s = s.write("    .quad 0x0000000000000000\n    .quad 0xa2f9836e4e441529\n    .quad 0xfc2757d1f534ddc0\n");
    s = s.write("    .quad 0xdb6295993c439041\n    .quad 0xfe5163abdebbc561\n    .quad 0xb7246e3a424dd2e0\n");
    s = s.write("    .quad 0x06492eea09d1921c\n    .quad 0xfe1deb1cb129a73e\n    .quad 0xe88235f52ebb4484\n");
    s = s.write("    .quad 0xe99c7026b45f7e41\n    .quad 0x3991d639835339f4\n    .quad 0x9c845f8bbdf9283b\n");
    s = s.write("    .quad 0x1ff897ffde05980f\n    .quad 0xef2f118b5a0a6d1f\n    .quad 0x6d367ecf27cb09b7\n");
    s = s.write("    .quad 0x4f463f669e5fea2d\n    .quad 0x7527bac7ebe5f17b\n    .quad 0x3d0739f78a5292ea\n");
    s = s.write("    .quad 0x6bfb5fb11f8d5d08\n    .quad 0x56033046fc7b6bab\n    .quad 0xf0cfbc209af4361d\n");
    s = s.write(".Lfc_s1: .double -1.66666666666666324348e-01\n");
    s = s.write(".Lfc_s2: .double 8.33333333332248946124e-03\n");
    s = s.write(".Lfc_s3: .double -1.98412698298579493134e-04\n");
    s = s.write(".Lfc_s4: .double 2.75573137070700676789e-06\n");
    s = s.write(".Lfc_s5: .double -2.50507602534068634195e-08\n");
    s = s.write(".Lfc_s6: .double 1.58969099521155010221e-10\n");
    s = s.write(".Lfc_c1: .double 4.16666666666666019037e-02\n");
    s = s.write(".Lfc_c2: .double -1.38888888888741095749e-03\n");
    s = s.write(".Lfc_c3: .double 2.48015872894767294178e-05\n");
    s = s.write(".Lfc_c4: .double -2.75573143513906633035e-07\n");
    s = s.write(".Lfc_c5: .double 2.08757232129817482790e-09\n");
    s = s.write(".Lfc_c6: .double -1.13596475577881948265e-11\n");
    s = s.write(".Lfc_p1: .double 1.66666666666666019037e-01\n");
    s = s.write(".Lfc_p2: .double -2.77777777770155933842e-03\n");
    s = s.write(".Lfc_p3: .double 6.61375632143793436117e-05\n");
    s = s.write(".Lfc_p4: .double -1.65339022054652515390e-06\n");
    s = s.write(".Lfc_p5: .double 4.13813679705723846039e-08\n");
    s = s.write(".Lfc_lg1: .double 6.666666666666735130e-01\n");
    s = s.write(".Lfc_lg2: .double 3.999999999940941908e-01\n");
    s = s.write(".Lfc_lg3: .double 2.857142874366239149e-01\n");
    s = s.write(".Lfc_lg4: .double 2.222219843214978396e-01\n");
    s = s.write(".Lfc_lg5: .double 1.818357216161805012e-01\n");
    s = s.write(".Lfc_lg6: .double 1.531383769920937332e-01\n");
    s = s.write(".Lfc_lg7: .double 1.479819860511658591e-01\n");
    s = s.write(".Lfc_expovf: .double 709.782712893383973096\n");
    s = s.write(".Lfc_expunf: .double -745.133219101941108420\n");
    s = s.write("    .text\n");
    // __fern_rem_pio2_large(d0 = x, |x| >= 2^20 and finite) -> x10 = k&3,
    // d0 = r. Payne-Hanek: multiplies the significand by the window of 2/pi
    // its exponent selects, keeping 128 bits about the binary point — the top
    // two bits are the quadrant and the rest the fraction of x/(pi/2), which
    // stays fully accurate however large x is. Kept in lockstep with the
    // native arm64 backend's __fern_rem_pio2_large, register for register.
    // Wide masks load through the literal pool: the self-host assembler's
    // logical-immediate path parses 32-bit immediates, so a 52-bit bitmask
    // spelled `and #imm` is refused there — same discipline as this file's
    // other 64-bit constants.
    s = s.write("__fern_rem_pio2_large:\n");
    s = s.write("    fmov x1, d0\n");
    s = s.write("    lsr x2, x1, #63\n");        // sign of x
    s = s.write("    ubfx x3, x1, #52, #11\n");  // biased exponent
    s = s.write("    ldr x0, =0x000fffffffffffff\n");
    s = s.write("    and x4, x1, x0\n");
    s = s.write("    ldr x0, =0x0010000000000000\n");
    s = s.write("    orr x4, x4, x0\n"); // m, the 53-bit significand
    // x = m*2^(e-1075), so the fraction of x*(2/pi) starts at bit
    // (e-1075)+62 of the table once the product is read as a Q126.
    s = s.write("    sub x3, x3, #1013\n");
    s = s.write("    and x5, x3, #63\n");  // bit offset within the limb
    s = s.write("    lsr x3, x3, #6\n");   // limb index
    s = s.write("    adrp x17, .Lfc_2opi_bits\n");
    s = s.write("    add x17, x17, :lo12:.Lfc_2opi_bits\n");
    s = s.write("    add x17, x17, x3, lsl #3\n");
    s = s.write("    ldr x6, [x17]\n");
    s = s.write("    ldr x7, [x17, #8]\n");
    s = s.write("    ldr x1, [x17, #16]\n");
    s = s.write("    ldr x3, [x17, #24]\n");
    // Each 64-bit window is (T[i] << off) | (T[i+1] >> (64-off)). aarch64
    // has no variable EXTR, and lsrv masks its count mod 64, so the right
    // half is spelled as two shifts — a plain >> (64-off) is wrong at off 0.
    s = s.write("    mov x16, #63\n");
    s = s.write("    sub x16, x16, x5\n");
    s = s.write("    lsl x13, x6, x5\n    lsr x0, x7, #1\n    lsr x0, x0, x16\n    orr x13, x13, x0\n"); // w0
    s = s.write("    lsl x14, x7, x5\n    lsr x0, x1, #1\n    lsr x0, x0, x16\n    orr x14, x14, x0\n"); // w1
    s = s.write("    lsl x15, x1, x5\n    lsr x0, x3, #1\n    lsr x0, x0, x16\n    orr x15, x15, x0\n"); // w2
    // acc(128) = lo(m*w0)<<64 + m*w1 + hi(m*w2), i.e. x*(2/pi) as a Q126.
    s = s.write("    mul x7, x4, x13\n");
    s = s.write("    mul x1, x4, x14\n");
    s = s.write("    umulh x3, x4, x14\n");
    s = s.write("    umulh x6, x4, x15\n");
    s = s.write("    adds x1, x1, x6\n");
    s = s.write("    adc x7, x7, x3\n");
    s = s.write("    lsr x10, x7, #62\n"); // quadrant
    s = s.write("    ldr x16, =0x3fffffffffffffff\n");
    s = s.write("    and x7, x7, x16\n");
    // A fraction at or above a half belongs to the next quadrant, as the
    // negative remainder below it — which is what keeps |r| <= pi/4.
    s = s.write("    mov x0, xzr\n"); // frac is negative iff this becomes 1
    s = s.write("    ldr x16, =0x2000000000000000\n");
    s = s.write("    cmp x7, x16\n");
    s = s.write("    b.lo .Lph_pos\n");
    s = s.write("    add x10, x10, #1\n");
    s = s.write("    subs x1, xzr, x1\n"); // negs: sets the borrow sbc needs
    s = s.write("    ldr x6, =0x4000000000000000\n");
    s = s.write("    sbc x7, x6, x7\n");
    s = s.write("    mov x0, #1\n");
    s = s.write(".Lph_pos:\n");
    // >> 11 keeps the low word inside 53 bits so the conversion is exact,
    // matching the other backends bit for bit.
    s = s.write("    lsr x1, x1, #11\n");
    s = s.write("    scvtf d1, x7\n");
    s = emit_ldc(s, "d3", ".Lfc_2m62");
    s = s.write("    fmul d1, d1, d3\n");
    s = s.write("    scvtf d2, x1\n");
    s = emit_ldc(s, "d3", ".Lfc_2m115");
    s = s.write("    fmul d2, d2, d3\n");
    s = s.write("    fadd d1, d1, d2\n");
    s = s.write("    cmp x0, #0\n");
    s = s.write("    b.eq .Lph_nn\n");
    s = s.write("    fneg d1, d1\n");
    s = s.write(".Lph_nn:\n");
    s = s.write("    cmp x2, #0\n");
    s = s.write("    b.eq .Lph_sgn\n");
    s = s.write("    fneg d1, d1\n");
    s = s.write("    neg x10, x10\n");
    s = s.write(".Lph_sgn:\n");
    s = s.write("    and x10, x10, #3\n");
    s = emit_ldc(s, "d3", ".Lfc_pio2hi");
    s = s.write("    fmul d0, d1, d3\n");
    s = emit_ldc(s, "d3", ".Lfc_pio2lo");
    s = s.write("    fmul d1, d1, d3\n");
    s = s.write("    fadd d0, d0, d1\n");
    s = s.write("    ret\n");
    // __fern_ksin(d0=r, |r| <= pi/4) -> sin r. Internal: sin and cos both
    // reach it after reduction, so the kernel exists once.
    s = s.write("__fern_ksin:\n");
    s = s.write("    fmul d1, d0, d0\n");
    s = s.write("    fmul d2, d1, d0\n");
    s = emit_ldc(s, "d3", ".Lfc_s6");
    s = emit_ldc(s, "d20", ".Lfc_s5");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s4");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s3");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s2");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s1");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = s.write("    fmul d3, d3, d2\n");
    s = s.write("    fadd d0, d0, d3\n");
    s = s.write("    ret\n");
    // __fern_kcos(d0=r, |r| <= pi/4) -> cos r. The (1-w)-hz dance recovers the
    // bits 1-hz discards; computing 1 - hz + z*z*p directly costs ~2 ulp.
    s = s.write("__fern_kcos:\n");
    s = s.write("    fmul d1, d0, d0\n");
    s = emit_ldc(s, "d3", ".Lfc_c6");
    s = emit_ldc(s, "d20", ".Lfc_c5");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c4");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c3");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c2");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c1");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fmul d3, d3, d1\n");
    s = emit_ldc(s, "d5", ".Lfc_half");
    s = s.write("    fmul d4, d1, d5\n");
    s = emit_ldc(s, "d5", ".Lfc_one");
    s = s.write("    fsub d6, d5, d4\n");
    s = s.write("    fsub d7, d5, d6\n");
    s = s.write("    fsub d7, d7, d4\n");
    s = s.write("    fadd d7, d7, d3\n");
    s = s.write("    fadd d0, d6, d7\n");
    s = s.write("    ret\n");
    // __fern_sin_f64: quadrant 0..3 -> sin r, cos r, -sin r, -cos r. Odd
    // quadrant picks the cos kernel and quadrant >= 2 flips the sign, so exactly
    // ONE kernel runs where the old code evaluated both and selected.
    s = s.write("    .global __fern_sin_f64\n");
    s = s.write("    .type __fern_sin_f64, %function\n");
    s = s.write("__fern_sin_f64:\n");
    // NaN returns itself; +-Inf becomes NaN. Before the frame, so these
    // arms return without x29/x30 pushed behind them.
    s = s.write("    fcmp d0, d0\n");
    s = s.write("    b.vs .Lsin_gret\n");
    s = s.write("    fmov x14, d0\n");
    s = s.write("    lsl x14, x14, #1\n");
    s = s.write("    ldr x15, =0xffe0000000000000\n");
    s = s.write("    cmp x14, x15\n");
    s = s.write("    b.eq .Lsin_gnan\n");
    s = s.write("    b .Lsin_gok\n");
    s = s.write(".Lsin_gret:\n");
    s = s.write("    ret\n");
    s = s.write(".Lsin_gnan:\n");
    s = s.write("    ldr x14, =0x7ff8000000000000\n");
    s = s.write("    fmov d0, x14\n");
    s = s.write("    ret\n");
    s = s.write(".Lsin_gok:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = fc_pio2_reduce(s, "sin");
    s = s.write("    tbnz x10, #0, .Lsin_usecos\n");
    s = s.write("    bl __fern_ksin\n");
    s = s.write("    b .Lsin_neg\n");
    s = s.write(".Lsin_usecos:\n");
    s = s.write("    bl __fern_kcos\n");
    s = s.write(".Lsin_neg:\n");
    s = s.write("    cmp x10, #2\n");
    s = s.write("    b.lt .Lsin_done\n");
    s = s.write("    fneg d0, d0\n");
    s = s.write(".Lsin_done:\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_sin_f64, .-__fern_sin_f64\n");
    // __fern_cos_f64: quadrant 0..3 -> cos r, -sin r, -cos r, sin r.
    s = s.write("    .global __fern_cos_f64\n");
    s = s.write("    .type __fern_cos_f64, %function\n");
    s = s.write("__fern_cos_f64:\n");
    // NaN returns itself; +-Inf becomes NaN. Before the frame, so these
    // arms return without x29/x30 pushed behind them.
    s = s.write("    fcmp d0, d0\n");
    s = s.write("    b.vs .Lcos_gret\n");
    s = s.write("    fmov x14, d0\n");
    s = s.write("    lsl x14, x14, #1\n");
    s = s.write("    ldr x15, =0xffe0000000000000\n");
    s = s.write("    cmp x14, x15\n");
    s = s.write("    b.eq .Lcos_gnan\n");
    s = s.write("    b .Lcos_gok\n");
    s = s.write(".Lcos_gret:\n");
    s = s.write("    ret\n");
    s = s.write(".Lcos_gnan:\n");
    s = s.write("    ldr x14, =0x7ff8000000000000\n");
    s = s.write("    fmov d0, x14\n");
    s = s.write("    ret\n");
    s = s.write(".Lcos_gok:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = fc_pio2_reduce(s, "cos");
    s = s.write("    tbnz x10, #0, .Lcos_usesin\n");
    s = s.write("    bl __fern_kcos\n");
    s = s.write("    b .Lcos_chk\n");
    s = s.write(".Lcos_usesin:\n");
    s = s.write("    bl __fern_ksin\n");
    s = s.write(".Lcos_chk:\n");
    s = s.write("    cmp x10, #1\n");
    s = s.write("    b.lt .Lcos_done\n");
    s = s.write("    cmp x10, #2\n");
    s = s.write("    b.gt .Lcos_done\n");
    s = s.write("    fneg d0, d0\n");
    s = s.write(".Lcos_done:\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_cos_f64, .-__fern_cos_f64\n");
    // __fern_exp_f64(d0=x) -> e^x. The division is deliberate: a division-free
    // variant needs a degree-13 Taylor to reach 1 ulp, whose dependent chain is
    // longer than the divide it avoids.
    s = s.write("    .global __fern_exp_f64\n");
    s = s.write("    .type __fern_exp_f64, %function\n");
    s = s.write("__fern_exp_f64:\n");
    s = s.write("    fcmp d0, d0\n");
    s = s.write("    b.vs .Lexp_ret\n");
    s = emit_ldc(s, "d1", ".Lfc_expovf");
    s = s.write("    fcmp d0, d1\n");
    s = s.write("    b.gt .Lexp_inf\n");
    s = emit_ldc(s, "d1", ".Lfc_expunf");
    s = s.write("    fcmp d0, d1\n");
    s = s.write("    b.lt .Lexp_zero\n");
    s = emit_ldc(s, "d1", ".Lfc_invln2");
    s = s.write("    fmul d1, d1, d0\n");
    s = s.write("    frintn d1, d1\n");
    s = s.write("    fcvtzs x10, d1\n");
    s = emit_ldc(s, "d2", ".Lfc_ln2hi");
    s = s.write("    fmul d2, d1, d2\n");
    s = s.write("    fsub d3, d0, d2\n");
    s = emit_ldc(s, "d2", ".Lfc_ln2lo");
    s = s.write("    fmul d1, d1, d2\n");
    s = s.write("    fsub d0, d3, d1\n");
    s = s.write("    fmul d4, d0, d0\n");
    s = emit_ldc(s, "d5", ".Lfc_p5");
    s = emit_ldc(s, "d20", ".Lfc_p4");
    s = s.write("    fmul d5, d5, d4\n");
    s = s.write("    fadd d5, d5, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_p3");
    s = s.write("    fmul d5, d5, d4\n");
    s = s.write("    fadd d5, d5, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_p2");
    s = s.write("    fmul d5, d5, d4\n");
    s = s.write("    fadd d5, d5, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_p1");
    s = s.write("    fmul d5, d5, d4\n");
    s = s.write("    fadd d5, d5, d20\n");
    s = s.write("    fmul d5, d5, d4\n");
    s = s.write("    fsub d6, d0, d5\n");
    s = s.write("    fmul d7, d0, d6\n");
    s = emit_ldc(s, "d2", ".Lfc_two");
    s = s.write("    fsub d2, d2, d6\n");
    s = s.write("    fdiv d7, d7, d2\n");
    s = s.write("    fsub d2, d1, d7\n");
    s = s.write("    fsub d2, d2, d3\n");
    s = emit_ldc(s, "d0", ".Lfc_one");
    s = s.write("    fsub d0, d0, d2\n");
    // 2^k as two half-scales; see asm_ir.fern's exp for why one field
    // cannot hold the subnormal band.
    s = s.write("    asr x11, x10, #1\n");
    s = s.write("    sub x10, x10, x11\n");
    s = s.write("    add x11, x11, #1023\n");
    s = s.write("    lsl x11, x11, #52\n");
    s = s.write("    fmov d1, x11\n");
    s = s.write("    add x10, x10, #1023\n");
    s = s.write("    lsl x10, x10, #52\n");
    s = s.write("    fmov d2, x10\n");
    s = s.write("    fmul d0, d0, d1\n");
    s = s.write("    fmul d0, d0, d2\n");
    s = s.write(".Lexp_ret:\n");
    s = s.write("    ret\n");
    s = s.write(".Lexp_inf:\n");
    s = s.write("    ldr x14, =0x7ff0000000000000\n");
    s = s.write("    fmov d0, x14\n");
    s = s.write("    ret\n");
    s = s.write(".Lexp_zero:\n");
    s = s.write("    fmov d0, xzr\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_exp_f64, .-__fern_exp_f64\n");
    // __fern_log_f64(d0=x) -> ln x (x>0). R is two INDEPENDENT chains in w=z^2,
    // so they issue in parallel instead of as one 7-deep Horner.
    s = s.write("    .global __fern_log_f64\n");
    s = s.write("    .type __fern_log_f64, %function\n");
    s = s.write("__fern_log_f64:\n");
    s = s.write("    fcmp d0, d0\n");
    s = s.write("    b.vs .Llog_ret\n");
    s = s.write("    fmov d1, xzr\n");
    s = s.write("    fcmp d0, d1\n");
    s = s.write("    b.lt .Llog_nan\n");
    s = s.write("    b.eq .Llog_neginf\n");
    s = s.write("    ldr x14, =0x7ff0000000000000\n");
    s = s.write("    fmov d1, x14\n");
    s = s.write("    fcmp d0, d1\n");
    s = s.write("    b.eq .Llog_ret\n");
    s = s.write("    fmov x10, d0\n");
    s = s.write("    lsr x11, x10, #52\n");
    s = s.write("    and x11, x11, #0x7ff\n");
    s = s.write("    sub x11, x11, #1023\n");
    s = s.write("    mov x13, #1\n");
    s = s.write("    lsl x13, x13, #52\n");
    s = s.write("    sub x13, x13, #1\n");
    s = s.write("    and x10, x10, x13\n");
    s = s.write("    mov x14, #1023\n");
    s = s.write("    lsl x14, x14, #52\n");
    s = s.write("    orr x10, x10, x14\n");
    s = s.write("    fmov d1, x10\n");
    s = emit_ldc(s, "d2", ".Lfc_sqrt2");
    s = s.write("    fcmp d1, d2\n");
    s = s.write("    b.lt .Llog_noadj\n");
    s = emit_ldc(s, "d3", ".Lfc_half");
    s = s.write("    fmul d1, d1, d3\n");
    s = s.write("    add x11, x11, #1\n");
    s = s.write(".Llog_noadj:\n");
    s = emit_ldc(s, "d4", ".Lfc_one");
    s = s.write("    fsub d1, d1, d4\n");
    s = emit_ldc(s, "d2", ".Lfc_two");
    s = s.write("    fadd d2, d2, d1\n");
    s = s.write("    fdiv d3, d1, d2\n");
    s = s.write("    fmul d4, d3, d3\n");
    s = s.write("    fmul d5, d4, d4\n");
    s = emit_ldc(s, "d6", ".Lfc_lg6");
    s = emit_ldc(s, "d20", ".Lfc_lg4");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_lg2");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d20\n");
    s = s.write("    fmul d6, d6, d5\n");
    s = emit_ldc(s, "d7", ".Lfc_lg7");
    s = emit_ldc(s, "d20", ".Lfc_lg5");
    s = s.write("    fmul d7, d7, d5\n");
    s = s.write("    fadd d7, d7, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_lg3");
    s = s.write("    fmul d7, d7, d5\n");
    s = s.write("    fadd d7, d7, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_lg1");
    s = s.write("    fmul d7, d7, d5\n");
    s = s.write("    fadd d7, d7, d20\n");
    s = s.write("    fmul d7, d7, d4\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = s.write("    fmul d2, d1, d1\n");
    s = emit_ldc(s, "d16", ".Lfc_half");
    s = s.write("    fmul d2, d2, d16\n");
    s = s.write("    scvtf d0, x11\n");
    s = emit_ldc(s, "d16", ".Lfc_ln2lo");
    s = s.write("    fmul d5, d0, d16\n");
    s = s.write("    fadd d6, d6, d2\n");
    s = s.write("    fmul d6, d6, d3\n");
    s = s.write("    fadd d6, d6, d5\n");
    s = s.write("    fsub d2, d2, d6\n");
    s = s.write("    fsub d2, d2, d1\n");
    s = emit_ldc(s, "d16", ".Lfc_ln2hi");
    s = s.write("    fmul d0, d0, d16\n");
    s = s.write("    fsub d0, d0, d2\n");
    s = s.write(".Llog_ret:\n");
    s = s.write("    ret\n");
    s = s.write(".Llog_nan:\n");
    s = s.write("    ldr x14, =0x7ff8000000000000\n");
    s = s.write("    fmov d0, x14\n");
    s = s.write("    ret\n");
    s = s.write(".Llog_neginf:\n");
    s = s.write("    ldr x14, =0xfff0000000000000\n");
    s = s.write("    fmov d0, x14\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_log_f64, .-__fern_log_f64\n");
    // __fern_pow_f64(d0=x, d1=y). Integer-exponent fast path: exp(y*ln x)
    // CANNOT return exactly 9 for pow(3,2) — a 1-ulp error in ln 3, amplified by
    // the exponential, lands just under, so `as i32` truncated to 8. Repeated
    // squaring is exact wherever the result is representable. Integrality is an
    // i64 round-trip, so a NaN or out-of-range y falls out as a huge |n| the range
    // check rejects.
    s = s.write("    .global __fern_pow_f64\n");
    s = s.write("    .type __fern_pow_f64, %function\n");
    s = s.write("__fern_pow_f64:\n");
    s = s.write("    fcvtzs x10, d1\n");
    s = s.write("    scvtf d2, x10\n");
    s = s.write("    fcmp d2, d1\n");
    s = s.write("    b.ne .Lpow_general\n");
    // Re-entered once with a reciprocated base and a negated n; see
    // asm_ir.fern's pow for the overflow retry.
    s = s.write(".Lpow_retry:\n");
    s = s.write("    mov x11, x10\n");
    s = s.write("    cmp x11, #0\n");
    s = s.write("    b.ge .Lpow_abs\n");
    s = s.write("    neg x11, x11\n");
    s = s.write(".Lpow_abs:\n");
    s = s.write("    cmp x11, #1074\n");
    s = s.write("    b.gt .Lpow_general\n");
    s = emit_ldc(s, "d3", ".Lfc_one");
    s = s.write("    fmov d4, d0\n");
    s = s.write(".Lpow_loop:\n");
    s = s.write("    tbz x11, #0, .Lpow_skip\n");
    s = s.write("    fmul d3, d3, d4\n");
    s = s.write(".Lpow_skip:\n");
    s = s.write("    fmul d4, d4, d4\n");
    s = s.write("    lsr x11, x11, #1\n");
    s = s.write("    cmp x11, #0\n");
    s = s.write("    b.ne .Lpow_loop\n");
    s = s.write("    cmp x10, #0\n");
    s = s.write("    b.ge .Lpow_done\n");
    s = emit_ldc(s, "d5", ".Lfc_one");
    s = s.write("    fdiv d5, d5, d3\n");
    s = s.write("    fcmp d5, #0.0\n");
    s = s.write("    b.ne .Lpow_recip\n");
    s = emit_ldc(s, "d5", ".Lfc_one");
    s = s.write("    fdiv d0, d5, d0\n");
    s = s.write("    neg x10, x10\n");
    s = s.write("    b .Lpow_retry\n");
    s = s.write(".Lpow_recip:\n");
    s = s.write("    fmov d3, d5\n");
    s = s.write(".Lpow_done:\n");
    s = s.write("    fmov d0, d3\n");
    s = s.write("    ret\n");
    // General case: x^y = sign * exp(y*ln|x|). ln is defined only for x > 0, so a
    // negative base is split into a sign and |x| first: for an integral y the sign
    // is (-1)^y, and a non-integral y makes the result NaN. Every |y| >= 2^53 is an
    // even integer, which is what leaves pow(x<0, +-Inf) a magnitude rather than a
    // NaN. Stashes y in callee-saved d8 and the sign in d9 across the log call.
    s = s.write(".Lpow_general:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    str d8, [sp, #-16]!\n");
    s = s.write("    str d9, [sp, #-16]!\n");
    s = s.write("    fmov d8, d1\n");
    s = emit_ldc(s, "d9", ".Lfc_one");                  // sign of the result
    s = s.write("    fmov x14, d0\n");
    s = s.write("    tbz x14, #63, .Lpow_mag\n");       // +0 or a positive base
    s = s.write("    lsl x14, x14, #1\n");
    s = s.write("    lsr x14, x14, #1\n");
    s = s.write("    fmov d0, x14\n");                  // |x|
    s = s.write("    fmov x15, d1\n");
    s = s.write("    lsl x15, x15, #1\n");
    s = s.write("    lsr x15, x15, #1\n");              // |y|
    s = s.write("    ldr x16, =0x4340000000000000\n");
    s = s.write("    cmp x15, x16\n");
    s = s.write("    b.lo .Lpow_parity\n");
    s = s.write("    ldr x16, =0x7ff0000000000000\n");
    s = s.write("    cmp x15, x16\n");
    s = s.write("    b.ls .Lpow_mag\n");                // |y| >= 2^53, finite or +-Inf: an even integer
    s = s.write("    b .Lpow_nan\n");                   // y is NaN
    s = s.write(".Lpow_parity:\n");
    s = s.write("    fcvtzs x15, d1\n");
    s = s.write("    scvtf d2, x15\n");
    s = s.write("    fcmp d2, d1\n");
    s = s.write("    b.ne .Lpow_nan\n");                // y is not an integer
    s = s.write("    tbz x15, #0, .Lpow_mag\n");        // even exponent
    s = s.write("    fneg d9, d9\n");
    // |x| == 1 is 1 for every y, including the NaN and +-Inf that exp(y*ln|x|)
    // would turn into NaN through y*0.
    s = s.write(".Lpow_mag:\n");
    s = s.write("    fmov x14, d0\n");
    s = s.write("    ldr x16, =0x3ff0000000000000\n");
    s = s.write("    cmp x14, x16\n");
    s = s.write("    b.eq .Lpow_sign\n");
    s = s.write("    bl __fern_log_f64\n");
    s = s.write("    fmul d0, d8, d0\n");
    s = s.write("    bl __fern_exp_f64\n");
    s = s.write(".Lpow_sign:\n");
    s = s.write("    fmul d0, d0, d9\n");
    s = s.write("    ldr d9, [sp], #16\n");
    s = s.write("    ldr d8, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".Lpow_nan:\n");
    s = s.write("    ldr d9, [sp], #16\n");
    s = s.write("    ldr d8, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ldr x14, =0x7ff8000000000000\n");
    s = s.write("    fmov d0, x14\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_pow_f64, .-__fern_pow_f64\n");
    return s;
}

pub function emit_ir_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    s = emit_rt_clock_and_print(s, darwin);
    s = emit_rt_readiness(s, darwin);
    s = emit_rt_io_and_string(s);
    s = emit_rt_heap(s, darwin);
    s = emit_rt_collections_and_proc(s, darwin);
    return s;
}

// ===================== IR MODULE FRAMERS =====================
// emit_module_ir_gated and emit_module_ir_unit_arm64_flat are the arm64 IR module
// orchestrators (moved from asm_arm64.fern, #3457 slice-5 prep): with the IR
// runtime already here (emit_ir_runtime), the whole arm64 IR emit path now
// lives in asm_arm64_ir.fern, so asm_arm64.fern holds only the AST emitter.

// emit_module_or_error is the arm64 mirror of asm_ir.emit_module_or_error
// (#3457 slice 5): the same parse-error / type-check / lambda-lift prologue as
// asm_arm64.emit_module, then the eligibility gate — but a module the gate
// declines is a hard ERROR here rather than a silent fall-through to the legacy
// AST emitter.
//
// It exists so the arm64 drivers can stop importing `asm_arm64.fern` at all,
// which is what makes that emitter deletable. Declines stay diagnosable:
// FERN_STRICT_IR=1 makes the shared gate exit(3) naming the bail site, so a
// regression says WHICH construct left the subset rather than merely that one
// did. The gate is the fused emit_module_ir_gated (ircore.lower_gated) — the
// SAME verdict the x86 path's gate gives — so a program's routing does not
// differ between the backends; only the instruction selection does.
//
// The prologue is ordered check-then-emit for the reason #4327 records: a gate
// that returns ahead of the type check lets an ill-typed module miscompile
// silently.
pub function emit_module_or_error(mod: parser.Module, darwin: boolean): string {
    var parse_errs: util.Diag[] = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
        eprint(util.format_diags(parse_errs));
        exit(1);
        return "";
    }
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: irlower.struct_tab(mod.structs), funcs: mod.funcs };
    var check_errs: util.Diag[] = asmcore.check_module(mod, s);
    if (check_errs.len() > 0) {
        eprint(util.format_diags(check_errs));
        exit(1);
        return "";
    }
    var g: string = emit_module_ir_gated(ircore.lift_lambdas(mod), darwin);
    if (g != "") { return g; }
    ircore.eprint_ir_ineligible();
    exit(1);
    return "";
}

// ---- The arm64 peephole ---------------------------------------------------
//
// peephole_push_pop_arm64 folds the stack machine's operand round-trips out of
// the emitted text — the arm64 twin of asm_ir.peephole_push_pop, numbered the
// same way as native's. The op loop pushes every result and pops every
// operand, so a value produced by one op and consumed by the next travels
// through memory even when both ends are already in registers. Every rule is
// local — a few contiguous lines — so none touches a genuinely live slot.
//
// P1 — redundant store/reload. `ldr DST, [sp], #16` reads back exactly what
// the line above pushed, so the adjacent pair is `DST := SRC` with sp
// restored, whatever either line was meant for:
//
//     str x0, [sp, #-16]!   ->  (both lines dropped)
//     ldr x0, [sp], #16
//
//     str x0, [sp, #-16]!   ->  mov x1, x0
//     ldr x1, [sp], #16
//
// The shapes are matched EXACTLY, which keeps the frame saves out: `stp` /
// `ldp` push and pop register PAIRS through the same addressing, and the
// `ldr x0, [sp]` peek (tee_local) has no writeback.
//
// P3 — dead push: a push whose slot is freed without being read. Every
// statement-position expression pushes a result nobody wants, and `drop`
// lowers to the stack restore:
//
//     str x0, [sp, #-16]!   ->  (both lines dropped)
//     add sp, sp, #16
//
// P4 — constant operand folded into the immediate form. Instruction
// selection never inspects an operand for constness, so `x + 5` materialises
// the 5 into x0, hands it to x1 and consumes it as a register. Once P1 has
// collapsed the constant's own push/pop pair the tail reads:
//
//     str SRC, [sp, #-16]! / mov x0, #K / mov x1, x0 / ldr x0, [sp], #16 / add x0, x0, x1
//       ->  [mov x0, SRC] / add x0, x0, #K
//
// for add, sub and cmp, whose imm12 takes 0..4095 or a multiple of 4096 up
// to 0xFFF000 — the range arm64_native's encoder accepts. The dropped lines
// leave x0 and sp exactly as the fold does; the only other state they wrote
// is x1, and every consumer of x1 in this backend writes it before reading
// it.
//
// P5 — the operand stack round trip around an undisturbed value. The push
// protects x0 across a materialisation that never touches it, and the pop
// puts it straight back:
//
//     str x0, [sp, #-16]! / ldr x0, [x29, #-8] / mov x1, x0 / ldr x0, [sp], #16
//       ->  ldr x1, [x29, #-8]
//
// The materialisation may be a CHAIN of up to three lines that thread a
// value through x0 — a far frame slot (`sub x16, x29, #N` then `ldr x0,
// [x16]`), a field of a local (`ldr x0, [x29, #-8]` then `ldr x0, [x0, #8]`),
// a string literal's `adrp` / `add :lo12:` pair. The rename writes x1 in
// place of every x0 the chain writes or reads, except a read of x0 on the
// chain's FIRST line, which is a read of the pushed value itself and is
// sound only when the push was of x0. A push of some other register folds
// too, and then owes the `mov x0, SRC` P1 would have made of the pair.
//
// P6 has no arm64 form: a helper call pops its arguments straight into the
// argument registers, so there is no copy out of the accumulator to fold.
//
// x8 and x16 are excluded as pushed or popped registers: `darwinize` keys the
// Mach-O syscall rewrite off a literal `ldr x8, [sp], #16`, and folding that
// line away would silently strip the marker.
//
// Untouched bytes are copied in RUNS, not per line — line-at-a-time copying
// cost 28% of total compile time on the x86-64 twin. Only a line that can
// take part in a rule enters the window; anything else closes it.

const PK_NONE: i32 = 0;
const PK_PUSH: i32 = 1;    // str R, [sp, #-16]!        a..b = R
const PK_POP: i32 = 2;     // ldr R, [sp], #16          a..b = R
const PK_DROP: i32 = 3;    // add sp, sp, #16
const PK_MAT: i32 = 4;     // a chain line: writes x0 (or only x16), reads at most x0 / x29 / x16
const PK_COPY: i32 = 5;    // mov x1, x0
const PK_ALU: i32 = 6;     // add|sub x0, x0, x1 | cmp x0, x1

const PF_MARKER: i32 = 1;  // the register is x8 / x16, darwinize's marker
const PF_X0: i32 = 2;      // the register is exactly x0
const PF_READS0: i32 = 4;  // PK_MAT: the line reads x0 (or w0)
const PF_DEST0: i32 = 8;   // PK_MAT: the line writes x0 (or w0)
const PF_CONST: i32 = 16;  // PK_MAT: `mov x0, #K` or `ldr x0, =K`, with `val` holding K

struct PLine {
    s: string,   // the text the line lives in: `asm` itself, or a rewritten line
    ln: i32,     // line start in s, indentation included; -1 for a rewritten line
    bs: i32,     // first byte of the mnemonic
    me: i32,     // end of the mnemonic
    hi: i32,     // end of the line, exclusive of its newline
    kind: i32,
    a: i32,      // the register the kind names, as a range of s
    b: i32,
    val: i64,    // PF_CONST: the constant
    flags: i32,
}

// The window holds at most PW_CAP lines; when it fills, the oldest PW_DRAIN
// are flushed. The deepest shape, P5's with a three-line chain, is six lines.
const PW_CAP: i32 = 16;
const PW_DRAIN: i32 = 8;

struct Peep {
    asm: string,
    w: PLine[],
    n: i32,
    run_start: i32,  // pending run of untouched bytes of asm, -1 when none
    run_end: i32,
    fired: boolean,
}

// ---- byte-range helpers over one line ----

function pp_is(s: string, lo: i32, hi: i32, lit: string): boolean {
    return hi - lo == lit.len() && asmcore.pp_at(s, lo, hi, lit);
}

function pp_find(s: string, lo: i32, hi: i32, c: i32): i32 {
    var i: i32 = lo;
    while (i < hi) {
        if ((s[i] as i32) == c) { return i; }
        i = i + 1;
    }
    return hi;
}

function pp_contains(s: string, lo: i32, hi: i32, lit: string): boolean {
    var i: i32 = lo;
    while (i + lit.len() <= hi) {
        if (asmcore.pp_at(s, i, hi, lit)) { return true; }
        i = i + 1;
    }
    return false;
}

function pp_is_digit(c: i32): boolean {
    return c >= 48 && c <= 57;
}

function pp_is_hex_digit(c: i32): boolean {
    return pp_is_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
}

// pp_reg0_at reports whether s[i:] starts the register x0 or w0 as a whole
// token: the letter, the digit, and no further digit.
function pp_reg0_at(s: string, i: i32, hi: i32): boolean {
    if (i + 1 >= hi || (s[i] != 120 && s[i] != 119) || s[i + 1] != 48) { return false; }
    return i + 2 >= hi || !pp_is_digit(s[i + 2] as i32);
}

// pp_mentions_reg0 reports whether s[lo:hi] names x0 or w0 anywhere.
function pp_mentions_reg0(s: string, lo: i32, hi: i32): boolean {
    var i: i32 = lo;
    while (i < hi) {
        if (pp_reg0_at(s, i, hi) && (i == lo || !pp_is_alnum(s[i - 1] as i32))) { return true; }
        i = i + 1;
    }
    return false;
}

function pp_is_alnum(c: i32): boolean {
    return pp_is_digit(c) || (c >= 97 && c <= 122) || c == 95;
}

// pp_imm_ok reports whether the literal s[lo:hi] is one util.lit_to_i64 reads
// exactly: an optional `-` and up to eighteen decimal digits, or `0x` and up
// to sixteen hex digits.
function pp_imm_ok(s: string, lo: i32, hi: i32): boolean {
    var i: i32 = lo;
    if (i < hi && s[i] == 45) { i = i + 1; }
    if (i + 1 < hi && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) {
        return pp_digits_ok(s, i + 2, hi, 16, true);
    }
    return pp_digits_ok(s, i, hi, 18, false);
}

function pp_digits_ok(s: string, lo: i32, hi: i32, max: i32, hex: boolean): boolean {
    if (hi - lo < 1 || hi - lo > max) { return false; }
    var i: i32 = lo;
    while (i < hi) {
        var c: i32 = s[i] as i32;
        if (hex && !pp_is_hex_digit(c)) { return false; }
        if (!hex && !pp_is_digit(c)) { return false; }
        i = i + 1;
    }
    return true;
}

// pp_arm64_marker_reg reports whether the register is one darwinize keys on
// (x8, its generic-syscall number marker, and x16, the same line after the
// Mach-O rewrite).
function pp_arm64_marker_reg(asm: string, lo: i32, hi: i32): boolean {
    if (hi - lo == 2 && asm[lo] == 120 && asm[lo + 1] == 56) { return true; }
    if (hi - lo == 3 && asm[lo] == 120 && asm[lo + 1] == 49 && asm[lo + 2] == 54) { return true; }
    return false;
}

// ---- classification ----

function pl_none(s: string, ln: i32, bs: i32, hi: i32): PLine {
    return PLine { s: s, ln: ln, bs: bs, me: bs, hi: hi, kind: PK_NONE, a: 0, b: 0, val: 0i64, flags: 0 };
}

function pl_mnem_is(p: PLine, lit: string): boolean {
    return pp_is(p.s, p.bs, p.me, lit);
}

function pl_reg_flags(s: string, lo: i32, hi: i32): i32 {
    var f: i32 = 0;
    if (pp_arm64_marker_reg(s, lo, hi)) { f = f | PF_MARKER; }
    if (pp_is(s, lo, hi, "x0")) { f = f | PF_X0; }
    return f;
}

// pl_stack classifies the operand-stack lines: the push, the pop, the drop.
// o1 is the first operand's start, cm the end of it (its comma, or hi).
function pl_stack(p: PLine, o1: i32, cm: i32): PLine {
    if (pl_mnem_is(p, "str") && pp_is(p.s, cm, p.hi, ", [sp, #-16]!")) {
        return PLine { ...p, kind: PK_PUSH, a: o1, b: cm, flags: pl_reg_flags(p.s, o1, cm) };
    }
    if (pl_mnem_is(p, "ldr") && pp_is(p.s, cm, p.hi, ", [sp], #16")) {
        return PLine { ...p, kind: PK_POP, a: o1, b: cm, flags: pl_reg_flags(p.s, o1, cm) };
    }
    if (pl_mnem_is(p, "add") && pp_is(p.s, o1, p.hi, "sp, sp, #16")) { return PLine { ...p, kind: PK_DROP }; }
    return p;
}

// pl_mat classifies a materialisation-chain line. The whole line past the
// mnemonic is inspected: the destination must be x0 (w0), or x16 for the far
// frame slot's address, and every other register named must be x0, x29 or
// x16 — the chain's own temporaries and the frame pointer — so that renaming
// x0 to x1 changes nothing else.
function pl_mat(p: PLine, o1: i32, cm: i32): PLine {
    var f: i32 = 0;
    if (pp_reg0_at(p.s, o1, cm) && cm - o1 == 2) { f = PF_DEST0; }
    else if (!pp_is(p.s, o1, cm, "x16") || !pl_mnem_is(p, "sub")) { return p; }
    if (cm >= p.hi) { return p; }
    var rest: i32 = cm + 2;
    if (pp_mentions_reg0(p.s, rest, p.hi)) { f = f | PF_READS0; }
    if (!pl_mat_operands_ok(p, rest)) { return p; }
    var v: i64 = 0i64;
    if (pl_mnem_is(p, "mov") && p.s[rest] == 35 && pp_imm_ok(p.s, rest + 1, p.hi)) {
        f = f | PF_CONST;
        v = util.lit_to_i64(slice_unchecked(p.s, rest + 1, p.hi) + "");
    } else if (pl_mnem_is(p, "ldr") && p.s[rest] == 61 && pp_imm_ok(p.s, rest + 1, p.hi)) {
        f = f | PF_CONST;
        v = util.lit_to_i64(slice_unchecked(p.s, rest + 1, p.hi) + "");
    }
    return PLine { ...p, kind: PK_MAT, a: o1, b: cm, val: v, flags: f };
}

// pl_mat_operands_ok vets the source operands of a chain line: every
// register token there must be x0 / w0, x29 or x16, and nothing may name
// sp or a register list. Anything else — a shift by x1, an indexed load —
// is not a chain line.
function pl_mat_operands_ok(p: PLine, lo: i32): boolean {
    var i: i32 = lo;
    while (i < p.hi) {
        var c: i32 = p.s[i] as i32;
        if ((c == 120 || c == 119 || c == 115) && (i == lo || !pp_is_alnum(p.s[i - 1] as i32))) {
            var e: i32 = i;
            while (e < p.hi && pp_is_alnum(p.s[e] as i32)) { e = e + 1; }
            if (c == 115) { if (pp_is(p.s, i, e, "sp")) { return false; } }
            else if (!pp_is(p.s, i, e, "x0") && !pp_is(p.s, i, e, "w0") && !pp_is(p.s, i, e, "x29") && !pp_is(p.s, i, e, "x16")) { return false; }
            i = e;
        } else {
            i = i + 1;
        }
    }
    return true;
}

// pl_is_mat_mnem: the mnemonics a chain line may carry — pure register
// writes and loads.
function pl_is_mat_mnem(p: PLine): boolean {
    return pl_mnem_is(p, "ldr") || pl_mnem_is(p, "mov") || pl_mnem_is(p, "adrp") || pl_mnem_is(p, "add")
        || pl_mnem_is(p, "sub") || pl_mnem_is(p, "ldrsw") || pl_mnem_is(p, "ldrb") || pl_mnem_is(p, "sxtw");
}

function pl_is_alu_mnem(p: PLine): boolean {
    return pl_mnem_is(p, "add") || pl_mnem_is(p, "sub") || pl_mnem_is(p, "cmp");
}

// pl_classify decodes one indented line of s. Anything it does not recognise
// is PK_NONE, which closes the window.
function pl_classify(s: string, ln: i32, bs: i32, hi: i32): PLine {
    var me: i32 = pp_find(s, bs, hi, 32);
    var p: PLine = PLine { s: s, ln: ln, bs: bs, me: me, hi: hi, kind: PK_NONE, a: 0, b: 0, val: 0i64, flags: 0 };
    if (me + 1 >= hi) { return p; }
    var o1: i32 = me + 1;
    var cm: i32 = pp_find(s, o1, hi, 44);
    var q: PLine = pl_stack(p, o1, cm);
    if (q.kind != PK_NONE) { return q; }
    if (pp_is(s, o1, hi, "x1, x0") && pl_mnem_is(p, "mov")) { return PLine { ...p, kind: PK_COPY }; }
    if (pl_is_alu_mnem(p) && (pp_is(s, o1, hi, "x0, x0, x1") || (pl_mnem_is(p, "cmp") && pp_is(s, o1, hi, "x0, x1")))) {
        return PLine { ...p, kind: PK_ALU };
    }
    if (pl_is_mat_mnem(p)) { return pl_mat(p, o1, cm); }
    return p;
}

function pl_text(l: PLine, lo: i32, hi: i32): string {
    return slice_unchecked(l.s, lo, hi) + "";
}

function pl_operand(l: PLine): string {
    return slice_unchecked(l.s, l.a, l.b) + "";
}

// pl_rename renders chain line `m` with x1 (w1) in place of x0 (w0): the
// destination always, and the reads unless `keep_reads` — the first line of
// a chain, whose x0 is the pushed value the pop restores.
function pl_rename(m: PLine, keep_reads: boolean): string {
    var out: string = "    " + pl_text(m, m.bs, m.me) + " ";
    var i: i32 = m.me + 1;
    var first: boolean = true;
    while (i < m.hi) {
        if (pp_reg0_at(m.s, i, m.hi) && (i == m.me + 1 || !pp_is_alnum(m.s[i - 1] as i32)) && (first || !keep_reads)) {
            if (m.s[i] == 120) { out = out + "x1"; } else { out = out + "w1"; }
            i = i + 2;
        } else {
            out = out + slice_unchecked(m.s, i, i + 1);
            i = i + 1;
        }
        if (m.s[i - 1] == 44) { first = false; }
    }
    return out + "\n";
}

// ---- the window ----

function peep_set(own p: Peep, i: i32, l: PLine): Peep {
    if (i < p.w.len()) { return Peep { ...p, w: p.w.with(i, l) }; }
    return Peep { ...p, w: p.w.append(l) };
}

// peep_emit writes one line out. An original line extends the pending run
// when it starts where the run ended, and otherwise starts a new one; a
// rewritten line closes the run and is written as is.
function peep_emit(own p: Peep, l: PLine): Peep {
    if (l.ln >= 0) {
        if (p.run_start >= 0 && p.run_end == l.ln) { return Peep { ...p, run_end: l.hi + 1 }; }
        p = peep_close_run(p);
        return Peep { ...p, run_start: l.ln, run_end: l.hi + 1 };
    }
    p = peep_close_run(p);
    strbuf_append(l.s);
    return p;
}

function peep_close_run(own p: Peep): Peep {
    if (p.run_start < 0) { return p; }
    var e: i32 = p.run_end;
    if (e > p.asm.len()) { e = p.asm.len(); }
    strbuf_append(slice_unchecked(p.asm, p.run_start, e));
    return Peep { ...p, run_start: 0 - 1, run_end: 0 - 1 };
}

function peep_flush(own p: Peep, k: i32): Peep {
    var i: i32 = 0;
    while (i < k) {
        var l: PLine = p.w[i];
        p = peep_emit(p, l);
        i = i + 1;
    }
    var j: i32 = k;
    var n: i32 = p.n;
    while (j < n) {
        var m: PLine = p.w[j];
        p = peep_set(p, j - k, m);
        j = j + 1;
    }
    return Peep { ...p, n: n - k };
}

function peep_add(own p: Peep, l: PLine): Peep {
    if (p.n == PW_CAP) { p = peep_flush(p, PW_DRAIN); }
    var n: i32 = p.n;
    p = peep_set(p, n, l);
    return Peep { ...p, n: n + 1 };
}

function peep_add_text(own p: Peep, text: string): Peep {
    return peep_add(p, pl_classify(text, 0 - 1, 4, text.len() - 1));
}

function peep_readd(own p: Peep, tail: PLine[]): Peep {
    var i: i32 = 0;
    while (i < tail.len()) {
        p = peep_add(p, tail[i]);
        i = i + 1;
    }
    return p;
}

function peep_tail_from(p: Peep, k: i32): PLine[] {
    var tail: PLine[] = [];
    var i: i32 = k;
    while (i < p.n) {
        tail = tail.append(p.w[i]);
        i = i + 1;
    }
    return tail;
}

// peep_settle re-runs the rules until none rewrites the tail: one rule's
// output is another's input — P1 collapses a constant's push/pop pair into
// the copy that P4 then folds into the immediate. It terminates because
// every rule removes at least one line from the window.
function peep_settle(own p: Peep): Peep {
    p = Peep { ...p, fired: true };
    while (p.fired) {
        p = Peep { ...p, fired: false };
        p = peep_rules(p);
    }
    return p;
}

function peep_rules(own p: Peep): Peep {
    p = peep_p1(p);
    if (p.fired) { return p; }
    p = peep_p3(p);
    if (p.fired) { return p; }
    p = peep_p4(p);
    if (p.fired) { return p; }
    var e: i32 = p.n - 2;
    return peep_p5(p, e);
}

// ---- the rules ----

function peep_p1(own p: Peep): Peep {
    var n: i32 = p.n;
    if (n < 2 || p.w[n - 2].kind != PK_PUSH || p.w[n - 1].kind != PK_POP) { return p; }
    var a: PLine = p.w[n - 2];
    var b: PLine = p.w[n - 1];
    if ((b.flags & PF_MARKER) != 0) { return p; }
    p = Peep { ...p, n: n - 2, fired: true };
    if (pl_operand(a) == pl_operand(b)) { return p; }
    return peep_add_text(p, "    mov " + pl_operand(b) + ", " + pl_operand(a) + "\n");
}

function peep_p3(own p: Peep): Peep {
    var n: i32 = p.n;
    if (n < 2 || p.w[n - 2].kind != PK_PUSH || p.w[n - 1].kind != PK_DROP) { return p; }
    if ((p.w[n - 2].flags & PF_MARKER) != 0) { return p; }
    return Peep { ...p, n: n - 2, fired: true };
}

// peep_chain_start returns the index of the first line of the
// materialisation chain ending at w[e-1] (w[e] is the copy), or -1 when
// w[e-1] is not a chain end or the chain is not headed by a push.
function peep_chain_start(p: Peep, e: i32): i32 {
    if (e < 2 || p.w[e - 1].kind != PK_MAT || (p.w[e - 1].flags & PF_DEST0) == 0) { return 0 - 1; }
    var k: i32 = e - 1;
    while (k > 0 && k > e - 3 && p.w[k - 1].kind == PK_MAT) { k = k - 1; }
    if (k < 1 || p.w[k - 1].kind != PK_PUSH) { return 0 - 1; }
    return k;
}

// peep_restore adds the `mov x0, SRC` a folded push/pop pair still owes
// when the push was not of x0 itself.
function peep_restore(own p: Peep, push: PLine): Peep {
    if ((push.flags & PF_X0) != 0) { return p; }
    return peep_add_text(p, "    mov x0, " + pl_operand(push) + "\n");
}

// peep_head_ok reports whether w[k-1..e] is the shape P4 and P5 share: a
// push, a chain, the copy to x1 and a pop into x0.
function peep_head_ok(p: Peep, k: i32, e: i32): boolean {
    if (k < 1 || p.w[k - 1].kind != PK_PUSH || (p.w[k - 1].flags & PF_MARKER) != 0) { return false; }
    if (p.w[e].kind != PK_COPY || e + 1 >= p.n || p.w[e + 1].kind != PK_POP) { return false; }
    if ((p.w[e + 1].flags & PF_X0) == 0) { return false; }
    // A chain whose first line reads x0 reads the pushed value, which is
    // still in x0 only when the push was of x0.
    return (p.w[k].flags & PF_READS0) == 0 || (p.w[k - 1].flags & PF_X0) != 0;
}

// peep_p4_imm renders constant K as an add/sub/cmp immediate, or "" when
// imm12 cannot hold it: 0..4095, or a multiple of 4096 up to 0xFFF000.
function peep_p4_imm(v: i64): string {
    if (v < 0i64 || v > 16773120i64) { return ""; }
    if (v > 4095i64 && (v & 4095i64) != 0i64) { return ""; }
    return util.i64_to_string(v);
}

function peep_p4(own p: Peep): Peep {
    var n: i32 = p.n;
    if (n < 5 || p.w[n - 1].kind != PK_ALU) { return p; }
    var c: PLine = p.w[n - 4];
    if (c.kind != PK_MAT || (c.flags & PF_CONST) == 0 || !peep_head_ok(p, n - 4, n - 3)) { return p; }
    var imm: string = peep_p4_imm(c.val);
    if (imm.len() == 0) { return p; }
    var u: PLine = p.w[n - 1];
    var line: string = "    " + pl_text(u, u.bs, u.me) + " x0, x0, #" + imm + "\n";
    if (pl_mnem_is(u, "cmp")) { line = "    cmp x0, #" + imm + "\n"; }
    var push: PLine = p.w[n - 5];
    p = Peep { ...p, n: n - 5, fired: true };
    p = peep_restore(p, push);
    return peep_add_text(p, line);
}

// peep_p5 folds the chain ending in the copy at w[e-1] and the pop at w[e]
// — called with e = n-2 from the tail, once P4 has had its chance at the
// line after the pop, and with e = n-1 when a line that cannot join closes
// the window.
function peep_p5(own p: Peep, e: i32): Peep {
    if (e < 3 || e >= p.n || p.w[e - 1].kind != PK_COPY) { return p; }
    var k: i32 = peep_chain_start(p, e - 1);
    if (k < 0 || !peep_head_ok(p, k, e - 1)) { return p; }
    var push: PLine = p.w[k - 1];
    var chain: PLine[] = [];
    var i: i32 = k;
    while (i < e - 1) {
        chain = chain.append(p.w[i]);
        i = i + 1;
    }
    var tail: PLine[] = peep_tail_from(p, e + 1);
    p = Peep { ...p, n: k - 1, fired: true };
    p = peep_restore(p, push);
    var j: i32 = 0;
    while (j < chain.len()) {
        p = peep_add_text(p, pl_rename(chain[j], j == 0));
        j = j + 1;
    }
    return peep_readd(p, tail);
}

// ---- the pass ----

// peep_line feeds one line of asm to the window. A line no rule can use
// closes the window: P5 gets its last chance at the lines before it, then
// everything flushes and the line joins the run.
function peep_line(own p: Peep, ln: i32, bs: i32, hi: i32): Peep {
    var l: PLine = pl_none(p.asm, ln, bs, hi);
    if (bs < hi && p.asm[ln] == 32) { l = pl_classify(p.asm, ln, bs, hi); }
    if (l.kind != PK_NONE) {
        p = peep_add(p, l);
        return peep_settle(p);
    }
    p = Peep { ...p, fired: false };
    var e: i32 = p.n - 1;
    p = peep_p5(p, e);
    var n: i32 = p.n;
    p = peep_flush(p, n);
    return peep_emit(p, l);
}

function peephole_push_pop_arm64(asm: string): string {
    strbuf_reset();
    var p: Peep = Peep { asm: asm, w: [], n: 0, run_start: 0 - 1, run_end: 0 - 1, fired: false };
    var n: i32 = asm.len();
    var ln: i32 = 0;
    var i: i32 = 0;
    while (i <= n) {
        if (i == n || asm[i] == 10) {
            var bs: i32 = ln;
            while (bs < i && asm[bs] == 32) { bs = bs + 1; }
            p = peep_line(p, ln, bs, i);
            ln = i + 1;
        }
        i = i + 1;
    }
    var e: i32 = p.n - 1;
    p = peep_p5(p, e);
    var k: i32 = p.n;
    p = peep_flush(p, k);
    p = peep_close_run(p);
    return strbuf_take();
}

// emit_module_ir_gated is the arm64 twin of asm_ir.emit_module_ir_gated: the
// FUSED eligibility gate + whole-program emit (#4394 lever 3 / #8199). Every
// function is lowered once, judged on that lowering, and emitted from it; the
// whole-program registry set (both interprocedural fixpoints plus
// fn_sigs_for_borrow) is derived once and threaded through the emit. "" is the
// ineligible sentinel — an eligible module always emits at least
// `.globl _start\n    .text`.
pub function emit_module_ir_gated(mod: parser.Module, darwin: boolean): string {
    // script_normalized desugars a SCRIPT-shaped module (top-level statements,
    // no `main`) into `function main(): i32 { … }`. Return types are inferred
    // BEFORE the registries are derived so they see the inferred ones.
    var im: parser.Module = parser.infer_ret_types_module(ircore.script_normalized(mod));
    var imtab: irlower.StructTab = irlower.struct_tab(im.structs);
    var base: irlower.FnSigs = ircore.wp_fn_sigs(im.funcs, imtab);
    var g: ircore.Lowered = ircore.lower_gated(im, imtab, irlower.fn_sigs_with_dyn(base, im.trait_reqs), [], false);
    if (!g.ok) { return ""; }
    return emit_module_ir_flat(im, imtab, darwin, g.cache, base);
}

function emit_module_ir_flat(mod: parser.Module, stab: irlower.StructTab, darwin: boolean, cache: irlower.LowerResult[], base: irlower.FnSigs): string {
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: stab, funcs: mod.funcs };
    // emit_body takes the runtime-dependency closure itself, ahead of the _start
    // it ends with. The seeds below are marker needs with no declared deps, so
    // they need no second pass.
    s = emit_body(mod, s, darwin, cache, base);
    // #4355: replaced-STRING-field admission — this route is single-module
    // whole-program, so mod.funcs IS the full read scope. base.strfld_ok_types
    // is that verdict, and the one the LOWERING routed on (see the x86 twin,
    // asm_ir.emit_module_ir_unit_flat).
    var sfok: string[] = base.strfld_ok_types;
    var sfoi: i32 = 0;
    while (sfoi < sfok.len()) { s = s.need("strfldok:" + sfok[sfoi]); sfoi = sfoi + 1; }
    // #6127: the DIRECT nested-struct / nested-enum field arm (see the x86 twin).
    var nfok: string[] = irlower.structfld_reclaim_ok_types_of(mod.funcs, stab, base.borrowable_params);
    var nfoi: i32 = 0;
    while (nfoi < nfok.len()) { s = s.need("structfldok:" + nfok[nfoi]); nfoi = nfoi + 1; }
    // #5235: plain-fn-pointer-array field registry (see the emit_module_funcs twin).
    var fpk: string[] = irlower.fnptr_arr_fields_of(mod.funcs, stab);
    var fpi: i32 = 0;
    while (fpi < fpk.len()) { s = s.need(fpk[fpi]); fpi = fpi + 1; }
    // Per-type __field_reclaim_<T> / __struct_drop_<T> bodies (#3457).
    s = emit_arm64_reclaim_drop_bodies(s);
    s = emit_ir_runtime(s, darwin);
    return peephole_push_pop_arm64(strbuf_take());
}

// emit_module_ir_unit_arm64_flat is the arm64 mirror of asm_ir.emit_module_ir_unit_flat
// (the per-module-compilation epic, #3451 / #3457 step 0a): it emits ONE
// translation unit's worth of arm64 asm from the IR path. The four knobs match
// x86's: is_entry (emit `_start` + the single shared __fern_* runtime),
// globl_defs (mark each emitted `__fn_<label>` `.globl` so a sibling unit's
// `bl __fn_...` extern resolves at link), str_ns (per-module .rodata namespace
// so two units' string + shape pools co-link without collision), and
// extra_needs (the whole-program runtime-need union, folded into the entry's
// single runtime so a sibling's helper is present). all_funcs/all_structs are
// the whole-program signature view (#3454) driving call/return tagging + struct
// layout; only mod.funcs are EMITTED. The _start is copied verbatim from
// emit_body (the proven single-unit IR path). Caller must have established
// asm_ir.all_eligible_*_known_view(mod) and seeded nothing (we reset here).
// `b` is the whole-program registry base (ircore.wp_fn_sigs over all_funcs /
// all_structs), derived once by the driver and shared by every unit it emits
// (the arm64 twin of asm_ir.emit_module_ir_unit_flat).
pub function emit_module_ir_unit_arm64_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irlower.StructTab, lo: i32, hi: i32, b: irlower.FnSigs): string {
    var stab: irlower.StructTab = irlower.struct_tab(mod.structs);
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // struct_decls is the WHOLE-PROGRAM struct set so a function emitting an
    // imported struct's layout resolves it; str_ns namespaces this unit's pools.
    s = asmcore.EmitState { ...s, struct_decls: all_structs, funcs: mod.funcs, str_ns: str_ns };
    if (is_entry) { s = s.write("    .globl _start\n"); }
    s = s.write("    .text\n");
    // The entry exports its shared runtime entry points (__fern_alloc /
    // __fern_arr_box / …) `.globl` so sibling library units' `bl __fern_*`
    // externs resolve against the single copy it emits. Target-independent
    // symbol list — reused from asm_ir.
    if (is_entry && globl_defs) { s = asmcore.emit_runtime_globls(s); }
    // `b` is the whole-program registry (all_funcs, #3454); only the two
    // module-scoped registries are applied on top, and they are cheap.
    var sg: irlower.FnSigs = irlower.FnSigs {
        ...b,
        closurearr_ret_fns: irlower.closurearr_ret_fns_of(mod.funcs, stab),
        fn_names: irlower.sig_reg_of(irlower.fn_names_of(mod.funcs)),
    };
    // [lo, hi) function-index window (function-sharding, #3425 — the arm64
    // mirror of asm_ir.emit_module_funcs' windowing). A full window (lo=0,
    // hi<0 "to the end") is byte-identical to the unsharded emit; a partial
    // window lets an oversized module emit across separate processes without
    // any single emit's leak-mode heap crossing the arena ceiling.
    var vsigs: irverify.NameIndex = irlower.fn_sig_index(all_funcs);
    var hh: i32 = hi;
    if (hh < 0 || hh > mod.funcs.len()) { hh = mod.funcs.len(); }
    var fi: i32 = lo;
    while (fi < hh) {
        if (globl_defs) {
            var gname: string = mod.funcs[fi].name;
            if (mod.funcs[fi].receiver_type.len() > 0) { gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name; }
            s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n");
        }
        s = emit_function_via_ir(mod.funcs[fi], s, sg, vsigs);
        fi = fi + 1;
    }
    // #4355: admit the replaced-STRING-field arm per type from the
    // WHOLE-PROGRAM read scan (all_funcs — see asm_ir.emit_module_ir_unit's
    // sibling seeding and irlower.strfld_reclaim_ok_types_of).
    // sg.strfld_ok_types is that verdict over the same lists, already computed by
    // the fn_sigs_for_borrow above — so it is the scan the LOWERING routed on,
    // keeping the construction retain and this arm's free paired, and the scan
    // (three whole-program passes, the most-repeated analysis in a compile at 7
    // runs against the nested-struct scan's 1) does not run twice here.
    var sfok: string[] = sg.strfld_ok_types;
    var sfoi: i32 = 0;
    while (sfoi < sfok.len()) { s = s.need("strfldok:" + sfok[sfoi]); sfoi = sfoi + 1; }
    // #6127: the DIRECT nested-struct / nested-enum field arm, whole-program.
    // b.borrowable_params is the same whole-program verdict the base was built
    // from (the counted rows it adds are keyed apart from the param rows the
    // scan looks up).
    var nfok: string[] = irlower.structfld_reclaim_ok_types_of(all_funcs, all_structs, b.borrowable_params);
    var nfoi: i32 = 0;
    while (nfoi < nfok.len()) { s = s.need("structfldok:" + nfok[nfoi]); nfoi = nfoi + 1; }
    // #5235: seed the plain-fn-pointer-array field registry as needs so
    // emit_arm64_struct_drop_one buffer-only-decs those fields (no element walk).
    var fpk: string[] = irlower.fnptr_arr_fields_of(all_funcs, all_structs);
    var fpi: i32 = 0;
    while (fpi < fpk.len()) { s = s.need(fpk[fpi]); fpi = fpi + 1; }
    // Per-type __field_reclaim_<T> + __struct_drop_<T> bodies (#3457). Shared
    // with emit_module's single-unit IR path (so the load_run / emit_module
    // route also emits them — previously only this multi-unit path did, so a
    // reclaimable struct-with-array-field link-failed there).
    s = emit_arm64_reclaim_drop_bodies(s);
    // Fold the whole-program need union (sibling modules' needs) into the entry's
    // single runtime BEFORE _start, so _start's args gating sees a sibling's
    // args() need. Inert (empty) on the single-unit path.
    var en: i32 = 0;
    while (en < extra_needs.len()) { s = s.need(extra_needs[en]); en = en + 1; }
    // Before _start, which gates its envp save on the closed heap need.
    s = s.close_needs();
    // _start belongs only to the entry (one program entry point). This path is
    // Linux-only — see the `emit_ir_runtime(s, false)` below.
    if (is_entry) {
        s = emit_ir_start(s, false);
    }
    // The entry emits the single shared __fern_* runtime (its helpers are already
    // `.globl`, so sibling `bl __fern_*` externs resolve against it) AND its own
    // .rodata pools (emit_runtime calls emit_rodata_pools_arm64). A non-entry
    // module emits ONLY its own pools — no runtime, no _start.
    if (is_entry) {
        s = emit_ir_runtime(s, false);
    } else {
        s = emit_rodata_pools_arm64(s, false);
    }
    return peephole_push_pop_arm64(strbuf_take());
}

// ===================== arm64-darwin post-processor =====================
// darwinize + its darwin_* helpers moved here from asm_arm64.fern (#3457
// slice-5 prep): the arm64-darwin IR path (emit_module_ir(mod, true) threads
// darwin through the runtime, then darwinize reskins the GAS text to Mach-O)
// must keep working once asm_arm64.fern's AST emitter is deleted, so the
// post-processor lives with the rest of the arm64 IR emit path.
// =================== arm64-darwin (Mach-O) ====================
//
// darwinize rewrites the Linux arm64 GAS assembly emitted by
// emit_module into the arm64-apple-darwin (Mach-O) dialect that
// `clang --target=arm64-apple-darwin` assembles and ld64 / lld link
// into a Mach-O executable. The transform is purely lexical plus a
// syscall-number remap — emit_module's instruction selection is
// byte-for-byte identical on both platforms, so the same code
// generator backs the Linux ELF and the Darwin Mach-O target:
//
//   - PC-relative symbol addressing. GNU `adrp Xd, sym` /
//     `add Xd, Xd, :lo12:sym` becomes Apple's `adrp Xd, sym@PAGE` /
//     `add Xd, Xd, sym@PAGEOFF`. Both name the identical ADRP/ADD
//     relocation pair; only the assembler syntax differs. Every
//     emitted `adrp` is paired with an `add ..., :lo12:...` and there
//     are no `ldr [.., :lo12:..]` forms, so the rewrite is unambiguous.
//     Like the `.L` prefix rewrite it skips quoted string operands: a
//     `.ascii` payload is program data, not an addressing mode.
//   - Sections. `.section .rodata` -> `.section __TEXT,__const`;
//     `.bss` / `.section .bss` -> `.section __DATA,__bss`;
//     `.section .text` -> `.text`.
//   - ELF-only directives. `.type` / `.size` / `.note.GNU-stack` are
//     dropped — Mach-O records function-vs-data via section
//     membership, not per-symbol metadata.
//   - Entry symbol. `_start` -> `_main`: ld64 / lld's default
//     executable entry, which dyld invokes via LC_MAIN.
//   - Syscalls. Linux issues `mov x8, #N` + `svc #0`; Darwin BSD
//     issues `mov x16, #M` + `svc #0x80`. We remap the syscalls whose
//     argument + result ABI is number-compatible (read / write /
//     close / openat / lseek / newfstatat / unlinkat / mkdirat /
//     getdents64→getdirentries64 / dup3→dup2 / execve / wait4 / exit /
//     mmap — see darwin_sysno) and flip the trap, normalising the
//     carry-flag errno back to Linux's -errno. Syscalls with no
//     number-compatible Darwin form are emitted directly by the code
//     generator behind its `darwin` flag instead: clock_gettime →
//     gettimeofday (now_unix_ms) / CNTVCT_EL0 (monotonic_ns), getrandom
//     → getentropy (random_i32), nanosleep → select (sleep_ms), and
//     the whole of subprocess, whose pipe() and fork() both report a
//     second value in x1 that no __syscall* op can see. A THIRD
//     shape rides the generic `__syscall3` op (#2649): its number is an
//     operand rather than a literal, so the Fern runtime source bakes in
//     the target's number and darwinize only rewrites the number
//     register + trap — see the `ldr x8, [sp], #16` rule below. The
//     supported surface is the core language (arithmetic, control flow,
//     functions, structs, enums, arrays, strings incl. heap concat,
//     closures, maps), stdin/stdout I/O, the filesystem builtins
//     (read_file / write_file / stat / temp_dir / remove_file /
//     read_dir / remove_dir_all), time + randomness, sleep,
//     subprocess, and the TCP socket primitives (tcp_listen /
//     tcp_accept / tcp_recv / tcp_send / tcp_close — socket 198→97 /
//     bind 200→104 / listen 201→106 / accept 202→30, plus the Darwin
//     sockaddr_in sin_len byte) that std/tcp.fern's HTTP edge-handler
//     loop is built on, and one-shot IPv4 UDP (udp_send — socket /
//     sendto 206→133 / close, dotted-quad host parse).

function darwin_starts_with(s: string, p: string): boolean {
    if (s.len() < p.len()) { return false; }
    return slice_unchecked(s, 0, p.len()) == p;
}

// darwin_lstrip drops leading ASCII spaces.
function darwin_lstrip(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && s[i] == 32) { i = i + 1; }
    return slice_unchecked(s, i, s.len()) + "";
}

// darwin_skip_quoted takes the index of an opening double quote and returns
// the index just past its closing quote (or the line's end when unterminated),
// stepping over backslash escapes.
function darwin_skip_quoted(s: string, i: i32): i32 {
    var n: i32 = s.len();
    var j: i32 = i + 1;
    while (j < n) {
        var c: u8 = s[j];
        if (c == 92 && j + 1 < n) { j = j + 1; }
        else if (c == 34) { return j + 1; }
        j = j + 1;
    }
    return n;
}

// darwin_index_of_unquoted returns the first index of sub in s that is not
// inside a double-quoted string operand, or -1: a `.ascii` payload is program
// data, not an addressing mode.
function darwin_index_of_unquoted(s: string, sub: string): i32 {
    var n: i32 = s.len();
    var m: i32 = sub.len();
    var i: i32 = 0;
    while (i < n) {
        if (s[i] == 34) {
            i = darwin_skip_quoted(s, i);
        } else if (i + m <= n && slice_unchecked(s, i, i + m) == sub) {
            return i;
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

// darwin_sysno maps a Linux arm64 syscall number to its Darwin BSD
// equivalent, for syscalls whose argument + result ABI is identical
// (only the number + trap instruction differ). Returns -1 when there
// is no number-compatible Darwin form.
function darwin_sysno(n: i32): i32 {
    if (n == 63) { return 3; }     // read
    if (n == 64) { return 4; }     // write
    if (n == 57) { return 6; }     // close
    if (n == 56) { return 463; }   // openat
    if (n == 61) { return 344; }   // getdents64 -> getdirentries64
    if (n == 62) { return 199; }   // lseek
    if (n == 79) { return 470; }   // newfstatat -> fstatat64 (same args)
    if (n == 35) { return 472; }   // unlinkat (same args)
    if (n == 34) { return 475; }   // mkdirat (same args)
    if (n == 24) { return 90; }    // dup3(.,.,0) -> dup2 (flags 0 == dup2)
    if (n == 221) { return 59; }   // execve (same args)
    if (n == 260) { return 7; }    // wait4 (same args)
    if (n == 198) { return 97; }   // socket (same args)
    if (n == 200) { return 104; }  // bind (sockaddr_in gets a sin_len byte)
    if (n == 201) { return 106; }  // listen (same args)
    if (n == 202) { return 30; }   // accept (same args)
    if (n == 206) { return 133; }  // sendto (same args)
    if (n == 93) { return 1; }     // exit
    if (n == 94) { return 1; }     // exit_group -> exit
    if (n == 222) { return 197; }  // mmap
    return 0 - 1;
}

// darwin_retarget_locals rewrites ELF's ".L" temporary-symbol prefix to
// Mach-O's bare "L". Only the leading "." is dropped, so ".Lret_3" becomes
// "Lret_3" and every reference changes with the definition.
//
// Without it every local label is a REAL Mach-O symbol, and Mach-O atomizes
// a section at each real symbol: the linker may reorder the pieces, so the
// assembler cannot treat the distance across a label as a compile-time
// constant. The first thing needing such a distance is CFI, where llvm-mc
// rejects the epilogue rule with "invalid CFI advance_loc expression"
// (#8065). The native emitter does the same thing in its printer.
//
// The scan skips quoted regions. That is the lexical rule rather than a
// carve-out: in assembly a ".L" token is a symbol reference EVERYWHERE
// except inside a string operand, and the `.ascii` payloads of a program's
// own string literals flow through this same line loop. A blind replacement
// would silently corrupt any Fern program with ".L" in a literal.
function darwin_retarget_locals(line: string): string {
    var n: i32 = line.len();
    var i: i32 = 0;
    var out: string = "";
    var run: i32 = 0;
    while (i < n) {
        var c: u8 = line[i];
        if (c == 34) {
            i = darwin_skip_quoted(line, i);
            continue;
        } else if (c == 46 && i + 1 < n && line[i + 1] == 76
                   && (i == 0 || !darwin_is_sym_byte(line[i - 1]))) {
            // ".L" at a token boundary: copy everything up to the dot and
            // skip it, leaving the "L".
            out = out + slice_unchecked(line, run, i);
            run = i + 1;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    if (run == 0) { return line; }
    return out + slice_unchecked(line, run, n);
}

// darwin_is_sym_byte reports whether the byte can appear inside an assembler
// symbol name, so ".L" preceded by one is part of a longer name.
function darwin_is_sym_byte(b: u8): boolean {
    if (b == 95 || b == 36 || b == 46) { return true; }     // _ $ .
    if (b >= 48 && b <= 57) { return true; }                // 0-9
    if (b >= 97 && b <= 122) { return true; }               // a-z
    return b >= 65 && b <= 90;                              // A-Z
}

pub function darwinize(asm: string): string {
    // Accumulate through the global strbuf, exactly as EmitState.write does
    // and for the same reason: `out = out + line` is O(n^2) and fatal here.
    // This used to accumulate with `+`, on the stated assumption that "the
    // arm64-darwin surface is small CLI / edge programs whose asm is a few
    // KB". It is not: one ordinary fixture (array_chunks_windows_methods)
    // emits 118,035 lines / 2.7 MB, and copying a string that size once per
    // line exhausted the compiler's arena. 61 of 339 fixtures failed to
    // compile for arm64-darwin on that alone, reported as "out of memory
    // (heap arena exhausted)" with no hint that the container path was at
    // fault.
    //
    // Re-entering strbuf is safe: `asm` is already materialised (the
    // emitter's own strbuf cycle ended in the strbuf_take that produced it),
    // so the buffer is drained before this reset.
    strbuf_reset();
    var n: i32 = asm.len();
    var start: i32 = 0;
    var i: i32 = 0;
    // pend_sys holds the Darwin number of a remapped syscall whose number
    // register we just rewrote, so the `svc` that consumes it knows whether
    // (and how) to flip the trap + normalise the errno. -1 = none. The
    // generic-syscall marker below parks 0 there — not a real Darwin number,
    // just "fallible, normalise" (0 is unused as a BSD syscall number).
    //
    // It is STICKY: only a number-register line or the `svc` itself changes it.
    // It used to be reset by every line, which quietly required the `svc` to
    // come IMMEDIATELY after — and the two abort paths (`.Lalloc_oom` and
    // __fern_oob_abort) load their status between the two, so exit(125) /
    // exit(134) kept a Linux `svc #0` in the Mach-O output and died by trap
    // instead of exiting with the status. An unmappable `mov x8, #N` still
    // CLEARS it, so a syscall with no Darwin form can never inherit the
    // previous one's mapping.
    var pend_sys: i32 = 0 - 1;
    var norm_n: i32 = 0;   // fresh-label counter for errno normalisation
    while (i <= n) {
        if (i == n || asm[i] == 10) {
            var line: str = slice_unchecked(asm, start, i);
            var has_nl: boolean = (i < n);
            var body: string = darwin_lstrip(line);
            var keep: boolean = true;
            var out_line: string = line + "";

            if (darwin_starts_with(body, ".type ") || darwin_starts_with(body, ".size ")) {
                keep = false;
            } else if (darwin_starts_with(body, ".note.GNU-stack")) {
                keep = false;
            } else if (body == ".section .rodata") {
                out_line = "    .section __TEXT,__const";
            } else if (body == ".data" || body == ".section .data") {
                // The static-aggregate-constant blocks (#6149). Left
                // untranslated, `-target arm64-darwin -emit asm` emitted a Linux
                // section directive that clang refuses ("unexpected token in
                // '.section' directive") — so the one tool for splitting an
                // emitter bug from an assembler bug did not work on any
                // program with a constant struct or enum, which is exactly the
                // set #6259 was about.
                out_line = "    .section __DATA,__data";
            } else if (body == ".bss" || body == ".section .bss") {
                out_line = "    .section __DATA,__bss";
            } else if (body == ".section .text") {
                out_line = "    .text";
            } else if (body == ".globl _start" || body == ".global _start") {
                out_line = "    .globl _main";
            } else if (line == "_start:") {
                out_line = "_main:";
            } else if (darwin_starts_with(body, "adrp ")) {
                out_line = line + "@PAGE";
            } else if (darwin_index_of_unquoted(line, ":lo12:") >= 0) {
                var idx: i32 = darwin_index_of_unquoted(line, ":lo12:");
                out_line = slice_unchecked(line, 0, idx) + slice_unchecked(line, idx + 6, line.len()) + "@PAGEOFF";
            } else if (body == "ldr x8, [sp], #16") {
                // The __syscall3 op's number load (#2649) — a generic syscall
                // whose number is an operand, not a literal, so the `mov x8, #N`
                // rule below cannot see it. The number in the operand is already
                // the Darwin one (the rt_src_* source is generated per target),
                // so only the number REGISTER and the trap need rewriting; 0
                // marks it fallible so the `svc` arm normalises the errno.
                out_line = "    ldr x16, [sp], #16";
                pend_sys = 0;
            } else if (darwin_starts_with(body, "mov x8, #")) {
                // Match the LSTRIPPED body, not a literal "    mov x8, #".
                // The emitter's indentation is not uniform — the subprocess
                // helper's `close(fd)` sequences carry two and even three
                // spaces — and an indent-keyed match left those syscalls with
                // their Linux number and a Linux `svc #0` in a Mach-O binary.
                var num: i32 = util.digits_to_i32(slice_unchecked(body, 9, body.len()));
                var m: i32 = darwin_sysno(num);
                pend_sys = m;
                if (m >= 0) {
                    out_line = "    mov x16, #" + util.i32_to_string(m);
                }
            } else if (body == "svc #0") {
                if (pend_sys == 1) {
                    // exit / exit_group: never returns, so no errno
                    // normalisation — just flip the trap.
                    out_line = "    svc #0x80";
                } else if (pend_sys >= 0) {
                    // Fallible syscall. Darwin returns +errno with the
                    // carry flag SET on error; Linux returns -errno. The
                    // self-host's callers test `x0 < 0`, so negate x0 when
                    // carry is set to restore the Linux-shaped -errno.
                    // Mirrors the Go backend's syscall() normalisation.
                    var lbl: string = ".Ldwsc_" + util.i32_to_string(norm_n);
                    norm_n = norm_n + 1;
                    out_line = "    svc #0x80\n    b.cc " + lbl + "\n    neg x0, x0\n" + lbl + ":";
                }
                pend_sys = 0 - 1;
            }

            if (keep) {
                strbuf_append(darwin_retarget_locals(out_line));
                if (has_nl) {
                    strbuf_append("\n");
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return strbuf_take();
}
