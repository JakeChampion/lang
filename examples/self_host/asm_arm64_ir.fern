        var slo2: asmcore.LabelOut = asmcore.fresh_label(slo.state);
        var s_short: string = slo2.name;
        var slo3: asmcore.LabelOut = asmcore.fresh_label(slo2.state);
        var s_short_next: string = slo3.name;
        var slo4: asmcore.LabelOut = asmcore.fresh_label(slo3.state);
        var s_hit: string = slo4.name;
        var slo5: asmcore.LabelOut = asmcore.fresh_label(slo4.state);
        var s_end: string = slo5.name;
        var slo6: asmcore.LabelOut = asmcore.fresh_label(slo5.state);
