        // only x0-x2; this backend's arrays keep len at [arr] and element i
        // at [arr + (i+1)*8], which is why the cursor is biased by one before
        // it is scaled. Base-register FP accesses only: the address is formed
        // with an add, which is the form arm64_native encodes.
        var flo: asmcore.LabelOut = asmcore.fresh_label(s);
        var sf_loop: string = flo.name;
        var flo2: asmcore.LabelOut = asmcore.fresh_label(flo.state);
        var sf_done: string = flo2.name;
        var flo3: asmcore.LabelOut = asmcore.fresh_label(flo2.state);
        var sf_vec: string = flo3.name;
        s = flo3.state;
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    stp x0, x1, [sp, #-16]!\n");
        s = s.write("    ldr x0, [x0]\n    bl __fern_arr_box\n");
        s = s.write("    ldp x2, x1, [sp], #16\n");
        s = s.write("    dup v1.2d, x1\n    mov x3, #0\n    ldr x4, [x2]\n");
