    if (o.kind_tag == 322) {  // scale_f64
        // operand stack [xs, k bits] -> the data pointer of a fresh f64
        // array of xs's length whose element i is xs[i] * k.
        //
        // NEON (§3.4 step 3): fmul over a .2d pair, with the scalar loop as
        // the tail for an odd length. Elementwise, so the lanes reassociate
        // nothing (ARRAY-ALGEBRA.md §3, AA-02).
