        var b_done: string = blo2.name;
        s = blo2.state;
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
        s = s.write("    and x1, x1, #0xffff\n    mov x2, #0\n");
        s = s.write(b_loop + ":\n");
        s = s.write("    cmp x2, x3\n    b.ge " + b_done + "\n");
        s = s.write("    add x5, x0, x2\n    ldrb w6, [x5]\n");
        s = s.write("    lsr x9, x1, #1\n    orr x1, x9, x1, lsl #15\n");
        s = s.write("    add x1, x1, x6\n    and x1, x1, #0xffff\n");
        s = s.write("    add x2, x2, #1\n    b " + b_loop + "\n");
        s = s.write(b_done + ":\n    str x1, [sp, #-16]!\n");
        return s;
    }
    if (o.kind_tag == 327) {  // count_runs
        // operand stack [box, inside, set] (set on top) -> how many runs of
        // set members begin in the string. The set's length is at [set] and
        // its byte i in the 8-byte slot 8 + i*8; a byte past that length is
        // not a member. "Not a member" is kept as 0 or 1, and a run begins
        // where it drops from 1 to 0.
        var clo: asmcore.LabelOut = asmcore.fresh_label(s);
        var c_loop: string = clo.name;
        var clo2: asmcore.LabelOut = asmcore.fresh_label(clo.state);
        var c_flag: string = clo2.name;
        var clo3: asmcore.LabelOut = asmcore.fresh_label(clo2.state);
        var c_done: string = clo3.name;
        s = clo3.state;
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
        s = s.write("    cmp x1, #0\n    cset x9, eq\n");
        s = s.write("    mov x1, #0\n    mov x8, #0\n    ldr x4, [x2]\n");
        s = s.write(c_loop + ":\n");
        s = s.write("    cmp x1, x3\n    b.ge " + c_done + "\n");
        s = s.write("    add x5, x0, x1\n    ldrb w6, [x5]\n");
        s = s.write("    mov x7, #1\n");
        s = s.write("    cmp x6, x4\n    b.hs " + c_flag + "\n");
        s = s.write("    add x5, x2, x6, lsl #3\n    ldr x7, [x5, #8]\n");
        s = s.write("    cmp x7, #0\n    cset x7, eq\n");
        s = s.write(c_flag + ":\n");
        s = s.write("    bic x10, x9, x7\n    add x8, x8, x10\n    mov x9, x7\n");
        s = s.write("    add x1, x1, #1\n    b " + c_loop + "\n");
        s = s.write(c_done + ":\n    str x8, [sp, #-16]!\n");
        return s;
    }
    if (o.kind_tag == 324) {  // scan_set
