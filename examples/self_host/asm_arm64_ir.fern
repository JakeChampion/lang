        // element; the tail picks up the odd one.
        s = s.write("    and x8, x4, #-2\n");
        s = s.write(sf_vec + ":\n");
        s = s.write("    cmp x3, x8\n    b.ge " + sf_loop + "\n");
        s = s.write("    add x5, x3, #1\n    add x6, x2, x5, lsl #3\n    ld1 {v0.2d}, [x6]\n");
        s = s.write("    fmul v0.2d, v0.2d, v1.2d\n    add x7, x0, x5, lsl #3\n    st1 {v0.2d}, [x7]\n");
        s = s.write("    add x3, x3, #2\n    b " + sf_vec + "\n");
        s = s.write(sf_loop + ":\n");
        s = s.write("    cmp x3, x4\n    b.ge " + sf_done + "\n");
        s = s.write("    add x5, x3, #1\n    add x6, x2, x5, lsl #3\n    ldr d0, [x6]\n");
        s = s.write("    fmul d0, d0, d1\n    add x7, x0, x5, lsl #3\n    str d0, [x7]\n");
        s = s.write("    add x3, x3, #1\n    b " + sf_loop + "\n");
        s = s.write(sf_done + ":\n    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
