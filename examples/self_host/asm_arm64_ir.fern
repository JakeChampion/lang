        s = s.write(s_one + ":\n    cmp x5, x8\n    b.hs " + s_end + "\n");
        s = s.write("    ldrb w6, [x5]\n    ldr x7, [x10, x6, lsl #3]\n    cbnz x7, " + hits[0] + "\n");
        s = s.write("    add x5, x5, #1\n    b " + s_one + "\n");
        s = s.write(hits[3] + ":\n    add x5, x5, #1\n");
        s = s.write(hits[2] + ":\n    add x5, x5, #1\n");
