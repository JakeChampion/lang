// examples/self_host/asm_arm64_ir.fern — the arm64 instruction-selector for
// the target-agnostic stack IR (irlower.fern's Op[]). The arm64 sibling of
// asm_ir.fern: it lowers the SAME lowered op stream to arm64 in asm_arm64's
// dialect (__fn_<name> labels, the 16-byte operand rt-stack, x29 frame), so a
// fully-IR-eligible module gets a native-parity Perceus array RC backend on
// arm64 too. The array layout + RC runtime are IDENTICAL to x86's
// (__fern_arr_box: base = [cap, rc, len, e0..], data = base+16, element i at
// data+(i+1)*8) — arm64's heap is the same 8-byte-slot shape — so the SAME
// Op[] produces a compatible layout; only the instruction selection differs.
//
// Reuse: the backend-INDEPENDENT analysis (eligibility, array-return tracking,
// the helper-name map, the control-flow label resolver) lives in asm_ir and is
// shared from there (asm_ir.all_eligible / ir_eligible / array_ret_fns /
// is_fern_helper / ir_helper_symbol / br_target). The heap / RC / alloc runtime
// is reused verbatim from asm_arm64.emit_runtime (asm_arm64 does NOT import
// this file, so there is no cycle — unlike x86, where asm.fern imports asm_ir
// and the runtime had to be duplicated). This file is therefore ONLY the arm64
// codegen for the op stream.
//
// Like asm_ir, this is a SEPARATE module imported only by its differential
// driver (asm_ir_run -target arm64) — asm_arm64.fern and the arm64 bootstrap stay
// untouched until a later fold/flip slice.

import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";
import "./asm_ir";
import "./lexer";

// fr_ldr / fr_str load/store `reg` at the x29-relative frame offset `off`
// (always <= 0 — locals live below the frame pointer). Inlined copies of
// asm_arm64's frame_ldr/frame_str (this module can't import asm_arm64 without a
// cycle): a scaled ldr/str can't encode a negative offset and ldur/stur only
// reach -256, so for a frame with >32 slots materialise the address in x16
// (AAPCS scratch, dead across a frame access here) via sub first.
// fr_sub_imm emits `dst = base - imm`, materialising the immediate in x17 (IP1,
// AAPCS scratch, dead at every caller here) when it exceeds arm64's 12-bit
// add/sub immediate ceiling (#4095). The IR path's large functions blow past it
// — irlower.lower_stmt has ~590 locals → a 4736-byte frame and frame-relative
// offsets to match — which the AST emitter never hits (its frames stay under
// 4 KiB). A single MOVZ covers up to 65535 (>8000 locals), far beyond any real
// function; a frame past that would fail loudly at assembly.
function fr_sub_imm(s: asmcore.EmitState, dst: string, base: string, imm: i32): asmcore.EmitState {
    if (imm <= 4095) {
        s = s.write("    sub " + dst + ", " + base + ", #" + util.i32_to_string(imm) + "\n"); return s;
    }
    s = s.write("    mov x17, #" + util.i32_to_string(imm) + "\n");
    s = s.write("    sub " + dst + ", " + base + ", x17\n"); return s;
}

function fr_ldr(s: asmcore.EmitState, reg: string, off: i32): asmcore.EmitState {
    if (off >= 0 - 256) {
        s = s.write("    ldr " + reg + ", [x29, #" + util.i32_to_string(off) + "]\n"); return s;
    }
    s = fr_sub_imm(s, "x16", "x29", 0 - off);
    s = s.write("    ldr " + reg + ", [x16]\n"); return s;
}

function fr_str(s: asmcore.EmitState, reg: string, off: i32): asmcore.EmitState {
    if (off >= 0 - 256) {
        s = s.write("    str " + reg + ", [x29, #" + util.i32_to_string(off) + "]\n"); return s;
    }
    s = fr_sub_imm(s, "x16", "x29", 0 - off);
    s = s.write("    str " + reg + ", [x16]\n"); return s;
}

// ir_bin_asm renders the arm64 for one IR binary op: lhs in x0, rhs in x1,
// result in x0 — mirroring asm_arm64's own ExprBinary sequences (64-bit ops,
// signed i32 div/rem via sdiv/msub) so the IR and AST paths agree.
function ir_bin_asm(tag: i32, width: i32): string {
    if (tag == 21) { return "    add x0, x0, x1\n"; }
    if (tag == 22) { return "    sub x0, x0, x1\n"; }
    if (tag == 23) { return "    mul x0, x0, x1\n"; }
    // i32 signed division narrows its result back to 32 bits: the operands
    // ride sign-extended in 64-bit regs, and the one quotient that overflows
    // i32 — INT_MIN / -1 = 2^31 — is representable in the 64-bit register, so
    // without the sxtw it stayed positive instead of wrapping to INT_MIN like
    // native, interp, and the x86 IR path's guarded div (#4329). sdiv itself
    // is non-trapping (x/0 = 0), so no guard is needed — only the narrow.
    // rem needs no sxtw: |rem| < |divisor| keeps it in i32 range, and the
    // INT_MIN % -1 msub yields 0 in-register already.
    if (tag == 24 && width != 64) { return "    sdiv x0, x0, x1\n    sxtw x0, w0\n"; }
    if (tag == 24) { return "    sdiv x0, x0, x1\n"; }
    if (tag == 26) { return "    sdiv x2, x0, x1\n    msub x0, x2, x1, x0\n"; }
    // Unsigned 64-bit div/rem (u64, #2904): udiv instead of sdiv.
    if (tag == 25) { return "    udiv x0, x0, x1\n"; }
    if (tag == 27) { return "    udiv x2, x0, x1\n    msub x0, x2, x1, x0\n"; }
    if (tag == 28) { return "    and x0, x0, x1\n"; }
    if (tag == 29) { return "    orr x0, x0, x1\n"; }
    if (tag == 30) { return "    eor x0, x0, x1\n"; }
    // Shift counts mask to the operand width: mod 64 for i64 (the x-form masks
    // the count register to 6 bits in hardware), mod 32 for i32/u32. The i32
    // shifts used to emit the bare x-form, so a count >= 32 wrapped mod 64
    // instead of mod 32 (#4330). Mirror asm_ir.fern's fix: mask the count to 5
    // bits BUT keep the 64-bit shift, so the operand's slot extension is
    // preserved — a u32 rides zero-extended (bit 63 = 0) and an i32
    // sign-extended (bit 63 = bit 31), and `asr`/`lsr`/`lsl` on the full
    // register does the right thing for both. (A w-form `asr` would fill from
    // bit 31, corrupting a u32 `>>` — which lowers through shr_s — whose bit 31
    // is a data bit, not a sign bit.)
    if (width == 64) {
        if (tag == 31) { return "    lsl x0, x0, x1\n"; }
        if (tag == 32) { return "    asr x0, x0, x1\n"; }
        if (tag == 33) { return "    lsr x0, x0, x1\n"; }
    }
    if (tag == 31) { return "    and x1, x1, #31\n    lsl x0, x0, x1\n"; }
    if (tag == 32) { return "    and x1, x1, #31\n    asr x0, x0, x1\n"; }
    if (tag == 33) { return "    and x1, x1, #31\n    lsr x0, x0, x1\n"; }
    if (tag == 35) { return "    cmp x0, x1\n    cset x0, eq\n"; }
    if (tag == 36) { return "    cmp x0, x1\n    cset x0, ne\n"; }
    if (tag == 37) { return "    cmp x0, x1\n    cset x0, lt\n"; }
    if (tag == 38) { return "    cmp x0, x1\n    cset x0, le\n"; }
    if (tag == 39) { return "    cmp x0, x1\n    cset x0, gt\n"; }
    if (tag == 40) { return "    cmp x0, x1\n    cset x0, ge\n"; }
    // Unsigned 64-bit compares (u64, #2904): the lo/ls/hi/hs condition codes
    // read CF instead of the signed N/V flags — correct once bit 63 is set.
    if (tag == 41) { return "    cmp x0, x1\n    cset x0, lo\n"; }
    if (tag == 42) { return "    cmp x0, x1\n    cset x0, ls\n"; }
    if (tag == 43) { return "    cmp x0, x1\n    cset x0, hi\n"; }
    if (tag == 44) { return "    cmp x0, x1\n    cset x0, hs\n"; }
    return "    // ir: unsupported bin " + ir.kind_name(tag) + "\n";
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_function_via_ir's dispatch — see ir.is_str_op_kind). The runtime helpers
// come from asm_arm64.emit_runtime, gated by the mark_* needs set here.
function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 97) {  // str_len
        // pop string box; length is at box+8.
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0, #8]\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 101) {  // str_index
        // pop index (top), string box; box = [data@0, len@8], byte at
        // [data + i]; ldrb zero-extends into w0.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x0, [x0]\n    ldrb w0, [x0, x1]\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 102) {  // str_slice
        // operand stack [src box, start, end] (end on top). Zero-copy view, now
        // rc-HEADERED with an IMMORTAL sentinel (#2649): a 24-byte box
        // [rc=-1@base, data=src.data+start@base+8, len=end-start@base+16], box=base+8
        // so data@box+0 / len@box+8 are unchanged. The bytes stay SHARED with the
        // source (no copy), so rc=-1 makes __fn___fern_str_free (tbnz w,#31 skip) and
        // __fn___fern_rc_inc (high-bit sentinel skip) both treat the view as immortal
        // — never freeing the shared buffer, never clobbering box-8. Closes the last
        // header-less string producer so incing a slice/trim VIEW is a safe no-op.
        // x19/x20/x21 (callee-saved) hold end/start/src across __fern_alloc.
        // Construction-time bounds check (#5419): trap unless
        // 0 <= start <= end <= src len (two unsigned compares) — an oversized
        // `end` otherwise built a view whose bytes extend past the source.
        s = s.mark_heap();
        s = s.write("    ldr x3, [sp], #16\n    ldr x4, [sp], #16\n    ldr x5, [sp], #16\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n    str x21, [sp, #-16]!\n");
        s = s.write("    mov x19, x3\n    mov x20, x4\n    mov x21, x5\n");
        s = s.write("    ldr x1, [x21, #8]\n");       // src len
        s = s.write("    cmp x19, x1\n");
        s = s.write("    b.ls 1f\n    b __fern_oob_abort\n1:\n");   // end > src len (unsigned) → abort
        s = s.write("    cmp x20, x19\n");
        s = s.write("    b.ls 1f\n    b __fern_oob_abort\n1:\n");   // start > end (unsigned) → abort
        s = s.write("    mov x0, #24\n    bl __fern_alloc\n");
        s = s.write("    mov x1, #-1\n    str x1, [x0]\n");
        s = s.write("    ldr x1, [x21]\n    add x1, x1, x20\n    str x1, [x0, #8]\n");
        s = s.write("    sub x1, x19, x20\n    str x1, [x0, #16]\n");
        s = s.write("    add x0, x0, #8\n");
        s = s.write("    ldr x21, [sp], #16\n    ldp x19, x20, [sp], #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 104) {  // str_bytes
        // operand stack [str box]; __fern_str_bytes is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on str_bytes
        // (it appends each byte; mark_str_bytes pulls in arr_push + heap). The box
        // on the stack IS param[0] (at [x29,#16]); call, pop arg, push result.
        s = s.mark_str_bytes();
        s = s.write("    bl __fn___fern_str_bytes\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 105) {  // str_split
        // operand stack [haystack box, sep box] (sep top). Call the Fern-compiled
        // __fn___fern_str_split via the stack ABI: param[0]=haystack on top (+16),
        // param[1]=sep (+32). Shared body, need-gated on str_split. -> string[] in x0.
        s = s.mark_str_split();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_split\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 106 || o.kind_tag == 107) {  // str_to_upper, str_to_lower
        // operand stack [s box]; __fern_str_to_upper/_lower are Fern runtime
        // functions now (#2649): asm_arm64.emit_runtime emits the shared bodies
        // gated on the str_case need. __fn_ stack convention — s on the stack IS
        // param[0] (at [x29,#16]); call, pop arg, push result.
        var cfn: string = "__fn___fern_str_to_upper";
        if (o.kind_tag == 107) { cfn = "__fn___fern_str_to_lower"; }  // str_to_lower
        s = s.mark_str_case();
        s = s.write("    bl " + cfn + "\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 108) {  // str_repeat
        // operand stack [s box, n] (n top). Call the Fern-compiled
        // __fn___fern_str_repeat via the stack ABI: param[0]=s on top (+16),
        // param[1]=n (+32). asm_arm64.emit_runtime emits the shared body,
        // need-gated on str_repeat. -> fresh string box in x0.
        s = s.mark_str_repeat();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_repeat\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 109) {  // str_trim
        // operand stack [s box]; __fern_str_trim is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on the
        // str_trim need (a zero-copy slice; mark_str_trim pulls in heap). The s box
        // already on the stack IS param[0] (at [x29,#16]); call, pop arg, push result.
        s = s.mark_str_trim();
        s = s.write("    bl __fn___fern_str_trim\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 110) {  // str_reverse
        // operand stack [s box] — the arg IS param[0] (+16). Call the
        // Fern-compiled __fn___fern_str_reverse via the stack ABI (shared body,
        // need-gated on str_reverse). -> fresh reversed string box in x0.
        s = s.mark_str_reverse();
        s = s.write("    bl __fn___fern_str_reverse\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 111) {  // str_replace
        // operand stack [haystack, old, new] (new top). Call the Fern-compiled
        // __fn___fern_str_replace via the stack ABI: param[0]=haystack on top
        // (+16), param[1]=old (+32), param[2]=new (+48). Shared body, need-gated
        // on str_replace. -> fresh string box in x0.
        s = s.mark_str_replace();
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_replace\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 112) {  // str_chars
        // operand stack [s box]; __fern_str_chars is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on str_chars
        // (it appends each 1-char slice; mark_str_chars pulls in arr_push + heap).
        // The box on the stack IS param[0] (at [x29,#16]); call, pop arg, push result.
        s = s.mark_str_chars();
        s = s.write("    bl __fn___fern_str_chars\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 113) {  // str_lines
        // operand stack [s box]; __fern_str_lines is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on the
        // str_lines need (it splits + array-slices; mark_str_lines pulls in
        // str_split + arr_slice + heap). The s box on the stack IS param[0] (at
        // [x29,#16]); call, pop arg, push result.
        s = s.mark_str_lines();
        s = s.write("    bl __fn___fern_str_lines\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 114 || o.kind_tag == 115 || o.kind_tag == 116) {  // str_starts_with, str_ends_with, str_index_of
        // operand stack [s, p] (p top); the str_search predicates are now Fern
        // runtime functions (#2649) called via the __fn_ stack convention —
        // re-push so s=param[0] at [x29,#16] and p=param[1] at [x29,#32]. Body
        // from asm_arm64.emit_runtime's (now Fern) str_search block.
        var pfn: string = "__fn___fern_str_starts_with";
        if (o.kind_tag == 115) { pfn = "__fn___fern_str_ends_with"; }  // str_ends_with
        if (o.kind_tag == 116) { pfn = "__fn___fern_str_index_of"; }  // str_index_of
        s = s.mark_str_search();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl " + pfn + "\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 98) {  // str_concat
        // operand stack [A, B] (B on top); __fern_str_concat is a Fern runtime
        // function now (#2649): __fn_ stack convention — A=param[0] at [x29,#16],
        // B=param[1] at [x29,#32]. Re-push so A lands on top.
        s = s.mark_heap();
        s = s.mark_str_concat();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_concat\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 99) {  // str_eq
        // operand stack [A, B] (B top); __fern_str_eq is now a Fern runtime
        // function (#2649) called via the __fn_ stack convention — re-push so
        // A=a is param[0] at [x29,#16] and B=b is param[1] at [x29,#32]. Body
        // from asm_arm64.emit_runtime's (now Fern) str_eq.
        s = s.mark_str_eq();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_eq\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    // str_cmp: operand stack [A, B] (B on top); __fern_str_cmp is now a Fern
    // runtime function (#2649) called via the __fn_ stack convention — re-push so
    // A=a is param[0] at [x29,#16] and B=b is param[1] at [x29,#32]. The body is
    // emitted by asm_arm64.emit_runtime (shared AST+IR runtime).
    s = s.mark_str_cmp();
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_cmp\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
}

// movz_text_ok reports whether an integer literal's SOURCE TEXT can go
// straight into MOVZ's 16-bit immediate instead of the literal pool.
//
// The round-trip through i32_to_string is the safety gate, not a tidiness
// check: util.digits_to_i32 accumulates in i32, so it both WRAPS on overflow
// (`4294967295` parses to -1) and stops silently at the first non-digit. Only
// re-rendering the parsed value proves the parse was exact. It also rejects,
// for free, every form this fast path must not claim — a leading `-` (MOVZ
// zero-fills, where the pool sign-extends), `0x`/`0b` (a different base), and
// leading zeros — because none of those re-render to themselves. So a text
// that passes IS the canonical decimal of a value in [0, 65535], which is
// exactly when `mov x0, #text` loads what `ldr x0, =text` would.
function movz_text_ok(text: string): boolean {
    var v: i32 = util.digits_to_i32(text);
    if (v < 0 || v > 65535) { return false; }
    return util.i32_to_string(v) == text;
}

// emit_const_i32_push materialises a 32-bit constant in x0 and pushes it. A
// constant that fits MOVZ costs one instruction and no pool entry; anything
// else keeps the `ldr x0, =text` literal pool, which is the only encoder here
// that handles the full u32 range, other bases, and negatives (whose 64-bit
// sign extension would need all four movk to rebuild in-register). Splitting
// the wide cases into movz+movk would trade an 8-byte pool entry for a second
// instruction — a wash on size — so the pool keeps them, and the per-function
// `.ltorg` keeps it in reach.
// map_eqfn_x5 loads the derived key-equality function pointer (`o.str`, the
// bare receiver label "K.eq" irlower's map_key_eqfn produces) into x5 for the
// four keyed map runtime entries — the arm64 twin of the x86-64 emitter's %r8.
// A scalar/string key carries "" and gets x5 = 0, which is what the runtime
// tests to pick the pointer/string compare instead. Without this the arm64
// runtime had no way to reach a struct/enum key's @derive(Eq), so a
// `Map[Name, V]` compared its keys by BOX POINTER and a freshly built,
// value-equal key missed every time (#6081).
function map_eqfn_x5(s: asmcore.EmitState, eqfn: string): asmcore.EmitState {
    if (eqfn == "") { return s.write("    mov x5, #0\n"); }
    var eql: string = "__fn_" + asmcore.sanitize_label(eqfn);
    return s.write("    adrp x5, " + eql + "\n    add x5, x5, :lo12:" + eql + "\n");
}

function emit_const_i32_push(s: asmcore.EmitState, text: string, movz_ok: boolean): asmcore.EmitState {
    if (movz_ok) {
        return s.write("    mov x0, #" + text + "\n    str x0, [sp, #-16]!\n");
    }
    return s.write("    ldr x0, =" + text + "\n    str x0, [sp, #-16]!\n");
}

// emit_function_via_ir emits one IR-eligible function as arm64. The frame +
// operand discipline mirrors asm_arm64's emit_function: x29 frame pointer,
// local slot i at [x29, #-8*(i+1)], the operand stack on sp in 16-byte slots
// (str x0,[sp,#-16]! / ldr x0,[sp],#16), params copied from the caller rt-stack
// at [x29, #16+i*16]. Structured control flow → per-function indexed labels
// (.Lira_<fn>_<opidx>), the same OP-STREAM-INDEX scheme asm_ir uses.
pub function emit_function_via_ir(fd: parser.FuncDecl, s: asmcore.EmitState, sg: irlower.FnSigs): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, s.struct_decls, sg, false);

    // Methods get the receiver-type-qualified label `__fn_<Type>.<name>`.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { label_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    var frame: i32 = r.n_locals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = fr_sub_imm(s, "sp", "sp", frame); }

    // Zero-init the body-local slots (Perceus exit-sweep safety): slots
    // [n_params, n_locals) at [x29, #-8*(i+1)] — the contiguous range from
    // -8*n_locals(x29) up, holding (n_locals - n_params) quadwords. x9/x10 are
    // AAPCS scratch, dead here (before the param copy).
    var nbody: i32 = r.n_locals - r.n_params;
    if (nbody > 0) {
        // The zero-init loop labels must be unique per FUNCTION. Two methods
        // sharing a bare name (e.g. a derived `Rec.hash` and core/cmp's
        // `string.hash`, both routing IR with body locals) collide if the label
        // is keyed on `fd.name` alone — the assembler then rejects the duplicate
        // `.Lira_zi_hash`. Key on `label_name` (the receiver-qualified name the
        // function SYMBOL already uses) so each is distinct. The x86 sibling has
        // no such labels (it zero-inits with `rep stosq`), so it never hit this.
        var zlab: string = asmcore.sanitize_label(label_name);
        s = fr_sub_imm(s, "x9", "x29", r.n_locals * 8);
        s = s.write("    mov x10, #" + util.i32_to_string(nbody) + "\n");
        s = s.write(".Lira_zi_" + zlab + ":\n");
        s = s.write("    cbz x10, .Lira_zd_" + zlab + "\n");
        s = s.write("    str xzr, [x9], #8\n");
        s = s.write("    sub x10, x10, #1\n");
        s = s.write("    b .Lira_zi_" + zlab + "\n");
        s = s.write(".Lira_zd_" + zlab + ":\n");
    }

    // Copy params from the caller rt-stack into local slots: param[i] sits at
    // [x29, #16+i*16] (16-byte operand slots, arg0 closest to the saved fp);
    // the IR's load_local i reads [x29, #-8*(i+1)]. r.n_params counts the
    // receiver (slot 0) for a method — the caller passes it as arg 0, so it
    // copies in uniformly.
    var pidx: i32 = 0;
    while (pidx < r.n_params) {
        s = s.write("    ldr x0, [x29, #" + util.i32_to_string(16 + pidx * 16) + "]\n");
        s = fr_str(s, "x0", 0 - 8 * (pidx + 1));
        pidx = pidx + 1;
    }

    var lp: string = ".Lira_" + asmcore.sanitize_label(label_name) + "_";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind_tag == 1) {  // const_i32
            var ctext: string = util.i32_to_string(o.i32_imm);
            s = emit_const_i32_push(s, ctext, o.i32_imm >= 0 && o.i32_imm <= 65535);
        } else if (o.kind_tag == 2) {  // const_i32_text
            // Source text (hex `0x..`, full u32) — movz_text_ok decides whether
            // it can skip the pool, and leaves anything it cannot prove exact.
            s = emit_const_i32_push(s, o.str, movz_text_ok(o.str));
        } else if (o.kind_tag == 3) {  // const_i64
            // 64-bit immediate, also source text, also the pool: a value this
            // wide needs up to four movk to build in-register. i64
            // add/sub/mul/cmp/bitwise reuse the 64-bit x-register bin ops
            // unchanged.
            s = s.write("    ldr x0, =" + o.str + "\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 7 || o.kind_tag == 8) {  // int_extend, int_wrap
            // i32<->i64: signed -> sxtw (sign-extend low word); unsigned -> mov
            // w0,w0 (writing w0 zeroes x0's upper 32).
            s = s.write("    ldr x0, [sp], #16\n");
            if (o.unsigned) { s = s.write("    mov w0, w0\n"); }
            else { s = s.write("    sxtw x0, w0\n"); }
            s = s.write("    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 10) {  // u32_wrap
            // Reduce to the u32 range (writing w0 zeroes x0's upper 32) — wraps a
            // u32 arith result at 2^32 on this 64-bit-register backend.
            s = s.write("    ldr x0, [sp], #16\n    mov w0, w0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 9) {  // int_cast
            // `x as <ty>` int→int width mask/extend — matches asm_arm64's as_<ty>.
            s = s.write("    ldr x0, [sp], #16\n");
            if (o.str == "u8") { s = s.write("    and x0, x0, #255\n"); }
            else if (o.str == "u32") { s = s.write("    mov w0, w0\n"); }
            else if (o.str == "i32") { s = s.write("    sxtw x0, w0\n"); }
            s = s.write("    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 92 || o.kind_tag == 94 || o.kind_tag == 95) {  // arr_push, arr_push_i64, arr_push_f64
            // [arr, val] -> grown array. __fern_arr_push(x0=arr, x1=val) -> x0.
            // arm64 array slots are 8 bytes, so i64/u64/f64 elements ride the SAME
            // helper (x1 holds the full 8-byte value); only wasm needs a distinct
            // 8-byte-stride push.
            s = s.mark_arr_push();
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_arr_push\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 93) {  // arr_push_owned
            // The sole-owner self-append (irlower's !aliased `a = a.append(v)`):
            // reclaims the old buffer on a grow-realloc (the arm64
            // __fern_arr_push_owned wrapper, asm_arm64.emit_runtime — mirrors
            // asm_ir's). Sound because the emit site proved the slot unaliased.
            s = s.mark_arr_push();
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_arr_push_owned\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 77) {  // alloc_u8
            // [n] -> fresh n-element array. __fern_alloc_u8(x0=n) -> x0 (in heap
            // block of asm_arm64.emit_runtime).
            s = s.mark_heap();
            s = s.write("    ldr x0, [sp], #16\n    bl __fern_alloc_u8\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 76) {  // alloc
            // [n] -> bump-alloc n raw bytes, push the usize pointer (core/map's
            // __alloc). __fern_alloc(x0=n) -> x0, the bare-pointer allocator.
            s = s.mark_heap();
            s = s.write("    ldr x0, [sp], #16\n    bl __fern_alloc\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 79) {  // ptr_width
            // () -> heap-pointer width in bytes. 8 on arm64.
            s = s.write("    mov x0, #8\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 103) {  // str_from_bytes
            // [arr] -> string box. The arg IS param[0] (+16); call the
            // Fern-compiled __fn___fern_string_from_bytes via the stack ABI (shared
            // body, need-gated on str_from_bytes). -> x0.
            s = s.mark_str_from_bytes();
            s = s.write("    bl __fn___fern_string_from_bytes\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 74) {  // memcpy
            // [dst, src, n] -> copy n bytes src->dst (byte loop), push dummy 0.
            // n on top (x2), then src (x1), then dst (x0). Mirrors the AST
            // __memcpy emitter in asm_arm64.fern; labels are op-index-unique.
            s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
            s = s.write(lp + "mc" + util.i32_to_string(i) + ":\n");
            s = s.write("    cbz x2, " + lp + "mcd" + util.i32_to_string(i) + "\n");
            s = s.write("    ldrb w3, [x1], #1\n    strb w3, [x0], #1\n    sub x2, x2, #1\n");
            s = s.write("    b " + lp + "mc" + util.i32_to_string(i) + "\n");
            s = s.write(lp + "mcd" + util.i32_to_string(i) + ":\n");
            s = s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 75) {  // memset
            // [dst, byte, n] -> fill n bytes at dst with byte's low byte (byte
            // loop), push dummy 0. n on top (x2), then byte (x1), then dst (x0).
            s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
            s = s.write(lp + "ms" + util.i32_to_string(i) + ":\n");
            s = s.write("    cbz x2, " + lp + "msd" + util.i32_to_string(i) + "\n");
            s = s.write("    strb w1, [x0], #1\n    sub x2, x2, #1\n");
            s = s.write("    b " + lp + "ms" + util.i32_to_string(i) + "\n");
            s = s.write(lp + "msd" + util.i32_to_string(i) + ":\n");
            s = s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 78) {  // free
            // [ptr, size] -> no-op under bump/leak heap; drop both, push dummy 0.
            s = s.write("    ldr x0, [sp], #16\n    ldr x0, [sp], #16\n    mov x0, #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 69) {  // load_i32
            // [addr] -> sign-extended 4-byte load.
            s = s.write("    ldr x0, [sp], #16\n    ldrsw x0, [x0]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 70 || o.kind_tag == 71) {  // load_i64, load_ptr
            // [addr] -> 8-byte load (ptr is heap-pointer width = 8 on arm64).
            s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 72) {  // store_i32
            // [addr, val] -> store low 4 bytes (val on top); push dummy 0.
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str w1, [x0]\n    mov x0, #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 73 || o.kind_tag == 199) {  // store_ptr, store_i64
            // [addr, val] -> store 8 bytes; push dummy 0. i64 and heap-pointer
            // are both 8-byte stores on arm64 (str x1), so they share this arm.
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [x0]\n    mov x0, #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 18) {  // load_local
            s = fr_ldr(s, "x0", 0 - 8 * (o.i32_imm + 1));
            s = s.write("    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 19) {  // store_local
            s = s.write("    ldr x0, [sp], #16\n");
            s = fr_str(s, "x0", 0 - 8 * (o.i32_imm + 1));
        } else if (o.kind_tag == 34) {  // not
            s = s.write("    ldr x0, [sp], #16\n    cmp x0, #0\n    cset x0, eq\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 160) {  // return
            s = s.write("    ldr x0, [sp], #16\n    mov sp, x29\n    ldp x29, x30, [sp], #16\n    ret\n");
        } else if (o.kind_tag == 154) {  // if
            var elseidx: i32 = irlower.find_matching_else(r.ops, i + 1);
            var tgt: string = "";
            if (elseidx >= 0) { tgt = lp + util.i32_to_string(elseidx); }
            else { tgt = lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)); }
            s = s.write("    ldr x0, [sp], #16\n    cbz x0, " + tgt + "\n");
        } else if (o.kind_tag == 155) {  // else
            s = s.write("    b " + lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)) + "\n");
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind_tag == 152) {  // block
            // forward scope: exit label defined at the matching `end`.
        } else if (o.kind_tag == 153) {  // loop
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind_tag == 157) {  // br
            s = s.write("    b " + asm_ir.br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind_tag == 158) {  // brif
            s = s.write("    ldr x0, [sp], #16\n    cbnz x0, " + asm_ir.br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind_tag == 87) {  // arr_make
            // n element values on the operand stack (element n-1 on top).
            // __fern_arr_box(cap=n) → data ptr in x0; element i at [data+(i+1)*8].
            // Pop top-down; x0 (base) stays live across the pops (they touch
            // only the rt-stack), then push it.
            s = s.mark_heap();
            var n: i32 = o.i32_imm;
            s = s.write("    mov x0, #" + util.i32_to_string(n) + "\n    bl __fern_arr_box\n");
            var em: i32 = n - 1;
            while (em >= 0) {
                s = s.write("    ldr x1, [sp], #16\n    str x1, [x0, #" + util.i32_to_string((em + 1) * 8) + "]\n");
                em = em - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 88) {  // arr_get
            // pop idx (top), base; element at [data + (idx+1)*8]. Bounds check
            // first (docs/ARRAY-BOUNDS.md): idx vs the length prefix at [data].
            // The UNSIGNED compare (b.hs) catches both idx >= len and a negative
            // idx (a huge unsigned) with one branch to the shared abort.
            // Elision (#4380 lever 3): i32_imm == 1 (op_arr_get_nc — the foreach
            // counted reads) drops the ldr-len / cmp / b.hs, the `idx < arr_len`
            // guard having run immediately before. The checked path already
            // compares the full x1, so the elided form needs no zero-extend.
            if (o.i32_imm == 1) {
                s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    add x1, x1, #1\n    ldr x0, [x0, x1, lsl #3]\n    str x0, [sp, #-16]!\n");
            } else {
                s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x2, [x0]\n    cmp x1, x2\n    b.lo 1f\n    b __fern_oob_abort\n1:\n    add x1, x1, #1\n    ldr x0, [x0, x1, lsl #3]\n    str x0, [sp, #-16]!\n");
            }
        } else if (o.kind_tag == 89) {  // arr_set
            // pop val (top), idx, base; store at [data + (idx+1)*8]. Same bounds
            // check as arr_get: an out-of-range write aborts, never corrupts.
            s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x3, [x0]\n    cmp x1, x3\n    b.lo 1f\n    b __fern_oob_abort\n1:\n    add x1, x1, #1\n    str x2, [x0, x1, lsl #3]\n");
        } else if (o.kind_tag == 90) {  // arr_len
            // pop base; length header at [data].
            s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 91) {  // arr_rc
            // pop base; 32-bit refcount field at [data-8] (ldur — unscaled neg).
            s = s.write("    ldr x0, [sp], #16\n    ldur w0, [x0, #-8]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 81) {  // raw_alloc
            // Tier-2 floor (#2649): pop n → x0, bl __fern_alloc, push ptr.
            s = s.mark_heap();
            s = s.write("    ldr x0, [sp], #16\n    bl __fern_alloc\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 82) {  // raw_store8
            // pop v (top), off, ptr; store low byte of v at [ptr+off]; push v back.
            s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    add x0, x0, x1\n    strb w2, [x0]\n    str x2, [sp, #-16]!\n");
        } else if (o.kind_tag == 83) {  // raw_load8
            // pop off (top), ptr; zero-extended byte at [ptr+off].
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    add x0, x0, x1\n    ldrb w0, [x0]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 84) {  // raw_store_ptr
            // pop v (top), off, ptr; store word slot at [ptr+off*8]; push v back.
            s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x2, [x0, x1, lsl #3]\n    str x2, [sp, #-16]!\n");
        } else if (o.kind_tag == 85) {  // raw_load_ptr
            // pop off (top), ptr; word slot at [ptr+off*8].
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x0, [x0, x1, lsl #3]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 86) {  // raw_string
            // pop [data, len] (len on top); build an rc-headered box via __fern_str_box
            // (#2649 Option A A1b). len -> x1, data -> x0, call, push the box.
            s = s.mark_heap();
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_str_box\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 204) {  // syscall3
            // Syscall sub-floor (#2649), the arm64 sibling of asm_ir's handler:
            // operand stack [nr, a1, a2, a3] (a3 on top) — a3->x2, a2->x1, a1->x0,
            // nr->x8, `svc #0`, result in x0. No runtime symbol.
            //
            // `ldr x8, [sp], #16` is also the marker darwinize keys the Mach-O
            // rewrite off: it cannot remap a syscall number it only sees at
            // runtime (its `mov x8, #N` rule needs a literal), so it instead
            // rewrites this load to x16, flips the trap to `svc #0x80` and
            // normalises the carry-flag errno. The NUMBER is therefore already
            // the target's — the rt_src_* source is generated per backend with
            // the Darwin BSD number when `darwin` is set. That instruction
            // appears nowhere else in this emitter, so the match is unambiguous.
            s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x8, [sp], #16\n    svc #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 206) {  // syscall4
            // 4-arg sibling of syscall3 (#2649): [nr, a1, a2, a3, a4] with a4 on
            // top. arm64 passes syscall args in x0..x5, so a4 is simply x3 — no
            // x86-64-style %r10 shuffle. Same `ldr x8` number-load marker, so
            // darwinize reskins this sequence for Mach-O exactly as it does
            // syscall3's.
            s = s.write("    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x8, [sp], #16\n    svc #0\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 207) {  // raw_environ
            // env sub-floor (#2649): push the saved process envp pointer, the
            // `char **` _start stashed in __fern_envp. No operands. The .bss slot
            // is emitted with the fs runtime (emit_rt_fs), unconditionally, since
            // _start's save is gated on `heap` rather than on `env`.
            s = s.write("    adrp x0, __fern_envp\n    add x0, x0, :lo12:__fern_envp\n    ldr x0, [x0]\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 223) {  // raw_addr
            // pop off (top), ptr; push ptr+off at full width (#2649). Unlike the
            // `add` op this is NOT followed by the i32 `sxtw` narrow, which is
            // the whole point — a heap address survives it.
            s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    add x0, x0, x1\n    str x0, [sp, #-16]!\n");
        } else if (o.kind_tag == 5) {  // const_str
            // String literal: intern in .rodata, build an rc-headered box via
            // __fern_str_box (#2649 Option A A1b) — data = .rodata label, len = byte
            // count. box = [rc=1][data][len]; data@box+0 / len@box+8 unchanged, so
            // __fern_str_concat / _eq see the same layout, and the rc header lets a
            // fresh literal box (e.g. an accumulator's initial "") be reclaimed.
            s = s.mark_heap();
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            s = lo.state;
            var lolbl: string = asm_ir.str_lit_label(s, lo.idx);
            s = s.write("    adrp x0, " + lolbl + "\n");
            s = s.write("    add x0, x0, :lo12:" + lolbl + "\n");
            s = s.write("    mov x1, #" + util.i32_to_string(o.str.len()) + "\n");
            s = s.write("    bl __fern_str_box\n");
            s = s.write("    str x0, [sp, #-16]!\n");
        } else if (ir.is_str_op_kind(o.kind_tag)) {
            // All string operand-stack ops (len/index/slice/bytes/split/
            // predicates/concat/eq/cmp) are emitted by emit_str_op — factored out
            // to keep this dispatch under the oversized-function threshold (#2720).
            s = emit_str_op(o, s);
        } else if (o.kind_tag == 214) {  // arr_reverse
            // operand stack [arr]; __fern_arr_reverse(x0=arr) -> fresh array in x0.
            // The helper body is already in this file's emit_ir_runtime, gated on
