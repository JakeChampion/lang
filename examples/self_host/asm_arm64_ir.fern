        // low 32 bits and zeroes the top of x7, so the wrap is the register
        // width and the stored value is already the i32 the op promises.
        //
        // x5 is the cursor POINTER, x6 the end, x7 the running sum.
        var slo: asmcore.LabelOut = asmcore.fresh_label(s);
        var sb_loop: string = slo.name;
        var slo2: asmcore.LabelOut = asmcore.fresh_label(slo.state);
        var sb_done: string = slo2.name;
        s = slo2.state;
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
        s = s.write("    mov x7, #0\n");
        s = s.write("    mov x5, x0\n    add x6, x0, x3\n");
        s = s.write(sb_loop + ":\n");
        s = s.write("    cmp x5, x6\n    b.ge " + sb_done + "\n");
        s = s.write("    ldrb w4, [x5]\n    add w7, w7, w4\n");
        s = s.write("    add x5, x5, #1\n    b " + sb_loop + "\n");
        s = s.write(sb_done + ":\n    str x7, [sp, #-16]!\n");
        return s;
    }
    if (o.kind_tag == 309) {  // crc32_cksum
        // operand stack [crc, box] (the box on top) -> the incoming CRC-32
        // with the string's bytes folded in.
        //
        // A CALL rather than an inline body: the fold is ~150 instructions
        // and wants one definition, not one per call site. The helper is
        // emitted once under the "crc32_cksum" need, the shape the float
        // transcendentals already use.
        //
        // The box is popped FIRST because it is the second operand: the crc
        // was pushed before it. Every other kernel in this family pops its
        // string last, which is exactly the shape a port copies wrong.
        s = s.need("crc32_cksum");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_crc32_cksum\n");
        s = s.write("    sxtw x0, w0\n    str x0, [sp, #-16]!\n");
        return s;
    }
    if (o.kind_tag == 227) {  // ascii_run
        // operand stack [box, from] (from on top) -> the index of the first
        // byte at or after `from` with its high bit set, or the LENGTH.
        //
        // NEON as memchr's is, and cheaper — but for the opposite reason to
        // the one x86-64 gets. There pmovmskb already gathers the top bit of
        // each byte, so the COMPARE disappears; NEON has no bitmask and still
        // needs a compare to widen "high bit set" into an all-ones lane, but
        // `cmlt v0.16b, v0.16b, #0` compares against zero, so it is the SPLAT
        // that disappears — there is no operand to broadcast.
        var alo: asmcore.LabelOut = asmcore.fresh_label(s);
        var a_clamped: string = alo.name;
        var alo2: asmcore.LabelOut = asmcore.fresh_label(alo.state);
        var a_vec: string = alo2.name;
        var alo3: asmcore.LabelOut = asmcore.fresh_label(alo2.state);
        var a_next: string = alo3.name;
        var alo4: asmcore.LabelOut = asmcore.fresh_label(alo3.state);
        var a_tail: string = alo4.name;
        var alo5: asmcore.LabelOut = asmcore.fresh_label(alo4.state);
        var a_hit: string = alo5.name;
        var alo6: asmcore.LabelOut = asmcore.fresh_label(alo5.state);
        var a_none: string = alo6.name;
        var alo7: asmcore.LabelOut = asmcore.fresh_label(alo6.state);
        var a_done: string = alo7.name;
        s = alo7.state;
        s = s.write("    ldr x2, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
        s = s.write("    cmp x2, #0\n    b.ge " + a_clamped + "\n    mov x2, #0\n");
        s = s.write(a_clamped + ":\n");
        s = s.write("    cmp x2, x3\n    b.ge " + a_none + "\n");
        s = s.write("    add x5, x0, x2\n    add x6, x0, x3\n");
        s = s.write(a_vec + ":\n");
        s = s.write("    sub x7, x6, x5\n    cmp x7, #16\n    b.lt " + a_tail + "\n");
        s = s.write("    ld1 {v0.16b}, [x5]\n    cmlt v0.16b, v0.16b, #0\n");
        s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
        s = s.write("    cbz x7, " + a_next + "\n");
        s = s.write("    rbit x4, x7\n    clz x4, x4\n    lsr x4, x4, #2\n");
        s = s.write("    add x5, x5, x4\n    sub x2, x5, x0\n    b " + a_done + "\n");
        s = s.write(a_next + ":\n    add x5, x5, #16\n    b " + a_vec + "\n");
        // Scalar tail: the final 0..15 bytes, and the whole algorithm for a
        // string shorter than one block.
        s = s.write(a_tail + ":\n");
        s = s.write("    cmp x5, x6\n    b.ge " + a_none + "\n");
        s = s.write("    ldrb w4, [x5]\n");
        // ldrb zero-extends, so bit 7 is the high bit.
        s = s.write("    tbnz w4, #7, " + a_hit + "\n");
        s = s.write("    add x5, x5, #1\n    b " + a_tail + "\n");
        s = s.write(a_hit + ":\n    sub x2, x5, x0\n    b " + a_done + "\n");
        // The miss value is the LENGTH, not -1.
        s = s.write(a_none + ":\n    mov x2, x3\n");
        s = s.write(a_done + ":\n    str x2, [sp, #-16]!\n");
        return s;
    }
    if (o.kind_tag == 104) {  // str_bytes
        // operand stack [str box]; __fern_str_bytes is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on str_bytes
        // (mark_str_bytes pulls in heap for its pre-sized box). The box on the
        // stack IS param[0] (at [x29,#16]); call, pop arg, push result.
        s = s.mark_str_bytes();
        s = s.write("    bl __fn___fern_str_bytes\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 105) {  // str_split
        // operand stack [haystack box, sep box] (sep top). Call the Fern-compiled
        // __fn___fern_str_split via the stack ABI: param[0]=haystack on top (+16),
        // param[1]=sep (+32). Shared body, need-gated on str_split. -> string[] in x0.
        s = s.mark_str_split();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_split\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 106 || o.kind_tag == 107) {  // str_to_upper, str_to_lower
        // operand stack [s box]; __fern_str_to_upper/_lower are Fern runtime
        // functions now (#2649): asm_arm64.emit_runtime emits the shared bodies
        // gated on the str_case need. __fn_ stack convention — s on the stack IS
        // param[0] (at [x29,#16]); call, pop arg, push result.
        var cfn: string = "__fn___fern_str_to_upper";
        if (o.kind_tag == 107) { cfn = "__fn___fern_str_to_lower"; }  // str_to_lower
        s = s.mark_str_case();
        s = s.write("    bl " + cfn + "\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 108) {  // str_repeat
        // operand stack [s box, n] (n top). Call the Fern-compiled
        // __fn___fern_str_repeat via the stack ABI: param[0]=s on top (+16),
        // param[1]=n (+32). asm_arm64.emit_runtime emits the shared body,
        // need-gated on str_repeat. -> fresh string box in x0.
        s = s.mark_str_repeat();
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_repeat\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 109) {  // str_trim
        // operand stack [s box]; __fern_str_trim is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on the
        // str_trim need (a zero-copy slice; mark_str_trim pulls in heap). The s box
        // already on the stack IS param[0] (at [x29,#16]); call, pop arg, push result.
        s = s.mark_str_trim();
        s = s.write("    bl __fn___fern_str_trim\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 110) {  // str_reverse
        // operand stack [s box] — the arg IS param[0] (+16). Call the
        // Fern-compiled __fn___fern_str_reverse via the stack ABI (shared body,
        // need-gated on str_reverse). -> fresh reversed string box in x0.
        s = s.mark_str_reverse();
        s = s.write("    bl __fn___fern_str_reverse\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 111) {  // str_replace
        // operand stack [haystack, old, new] (new top). Call the Fern-compiled
        // __fn___fern_str_replace via the stack ABI: param[0]=haystack on top
        // (+16), param[1]=old (+32), param[2]=new (+48). Shared body, need-gated
        // on str_replace. -> fresh string box in x0.
        s = s.mark_str_replace();
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_replace\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n"); return s;
    }
    if (o.kind_tag == 113) {  // str_lines
        // operand stack [s box]; __fern_str_lines is a Fern runtime function now
        // (#2649): asm_arm64.emit_runtime emits the shared body gated on the
        // str_lines need (mark_str_lines pulls in arr_push + heap). The s box
        // on the stack IS param[0] (at
        // [x29,#16]); call, pop arg, push result.
        s = s.mark_str_lines();
        s = s.write("    bl __fn___fern_str_lines\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n"); return s;
    }
    // Guarded, so this tail is unreachable rather than a catch-all (#6917) —
    // see the matching note in asm_ir.emit_str_op.
    ircore.unsupported_op_refuse(o.kind_tag, "arm64");
    return s;
}

// movz_text_ok reports whether an integer literal's SOURCE TEXT can go
// straight into MOVZ's 16-bit immediate instead of the literal pool.
//
// The round-trip through i32_to_string is the safety gate, not a tidiness
// check: util.digits_to_i32 accumulates in i32, so it both WRAPS on overflow
// (`4294967295` parses to -1) and stops silently at the first non-digit. Only
// re-rendering the parsed value proves the parse was exact. It also rejects,
// for free, every form this fast path must not claim — a leading `-` (MOVZ
// zero-fills, where the pool sign-extends), `0x`/`0b` (a different base), and
// leading zeros — because none of those re-render to themselves. So a text
// that passes IS the canonical decimal of a value in [0, 65535], which is
// exactly when `mov x0, #text` loads what `ldr x0, =text` would.
function movz_text_ok(text: string): boolean {
    var v: i32 = util.digits_to_i32(text);
    if (v < 0 || v > 65535) { return false; }
    return util.i32_to_string(v) == text;
}

// movn_text_ok reports a canonical decimal in [-65535, -1], which `mov x, #text`
// loads as one MOVN, sign-extended as the pool's `ldr x, =text` is.
function movn_text_ok(text: string): boolean {
    if (text.len() < 2 || text[0] != 45) { return false; }
    var rest: str = slice_unchecked(text, 1, text.len());
    return rest != "0" && movz_text_ok(rest);
}

// emit_const_i32_push materialises a 32-bit constant in x0 and pushes it. A
// constant that fits MOVZ costs one instruction and no pool entry; anything
// else keeps the `ldr x0, =text` literal pool, which is the only encoder here
// that handles the full u32 range, other bases, and negatives (whose 64-bit
// sign extension would need all four movk to rebuild in-register). Splitting
// the wide cases into movz+movk would trade an 8-byte pool entry for a second
// instruction — a wash on size — so the pool keeps them, and the per-function
// `.ltorg` keeps it in reach.
// map_eqfn_x5 loads the derived key-equality function pointer (`o.str`, the
// bare receiver label "K.eq" irlower's map_key_eqfn produces) into x5 for the
// four keyed map runtime entries — the arm64 twin of the x86-64 emitter's %r8.
// A scalar/string key carries "" and gets x5 = 0, which is what the runtime
// tests to pick the pointer/string compare instead. Without this the arm64
// runtime had no way to reach a struct/enum key's @derive(Eq), so a
// `Map[Name, V]` compared its keys by BOX POINTER and a freshly built,
// value-equal key missed every time (#6081).
function map_eqfn_x5(s: asmcore.EmitState, eqfn: string): asmcore.EmitState {
    return map_fn_address(s, "x5", eqfn);
}

// map_fn_address loads the address of the Fern function `name` spells into
// `reg`, or 0 when it spells none.
function map_fn_address(s: asmcore.EmitState, reg: string, name: string): asmcore.EmitState {
    if (name == "") { return s.write("    mov " + reg + ", #0\n"); }
    var sym: string = "__fn_" + asmcore.sanitize_label(name);
    return s.write("    adrp " + reg + ", " + sym + "\n    add " + reg + ", " + reg + ", :lo12:" + sym + "\n");
}

// ---- The SSA backend: one function at a time, on the stack ABI -----------
//
// `-backend ssa` (docs/SELFHOST-SSA-BACKEND.md), the only emitter on this ISA.
// Every lowered function is lifted by ssa_lift.lift_from_ir_prod and emitted
// from SSA form, its values in the linear-scan allocator's registers or in
// frame slots. The frame record, the caller-stack argument convention (param
// i at [x29, #16 + 16*i], result in x0) and every runtime symbol are the ones
// the stack machine this replaced used, so the runtime helpers and the
// flat-op arms it still runs are unchanged.
//
// Registers: x0 and x9..x15 are the caller-saved pool; x19..x28 are the
// callee-saved pool a value live across a call takes, saved in pairs once per
// function. x4..x7 are scratch; x16/x17 belong to fr_ldr and fr_sub_imm. A
// spilled value lives at [x29, #-8*(slot+1)] by its allocator slot.

// Pool index 0 is x0, the register the ABI returns a call's result in, so a
// call result allocated there needs no move at all. The arms that are calls
// may write it, since the allocator never leaves a caller-saved value live
// across one.
function ssa_reg(k: i32): string {
    if (k >= ssa_nregs()) { return "x" + util.i32_to_string(19 + k - ssa_nregs()); }
    if (k == 0) { return "x0"; }
    return "x" + util.i32_to_string(8 + k);
}
function ssa_nregs(): i32 { return 8; }
function ssa_nsaved(): i32 { return 10; }

// ssa_saved_regs is the callee-saved registers a function's allocation uses,
// lowest first; ssa_save_bytes their save area, a 16-byte pair per two.
function ssa_saved_regs(reg_of: i32[]): i32[] {
    var used: i32[] = [];
    var k: i32 = ssa_nregs();
    while (k < ssa_nregs() + ssa_nsaved()) {
        var found: boolean = false;
        for h in reg_of { if (h == k) { found = true; } }
        if (found) { used = used.append(k); }
        k = k + 1;
    }
    return used;
}
function ssa_save_bytes(saved: i32[]): i32 { return ((saved.len() + 1) / 2) * 16; }

// ssa_save_asm pushes the saved registers in pairs below the frame record;
// ssa_epilogue_for restores them in the reverse order after cutting sp back
// to the save area, then returns as the stack machine does.
function ssa_save_asm(saved: i32[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i + 1 < saved.len()) {
        out = out + "    stp " + ssa_reg(saved[i]) + ", " + ssa_reg(saved[i + 1]) + ", [sp, #-16]!\n";
        i = i + 2;
    }
    if (i < saved.len()) { out = out + "    str " + ssa_reg(saved[i]) + ", [sp, #-16]!\n"; }
    return out;
}
function ssa_epilogue_for(saved: i32[]): string {
    if (saved.len() == 0) { return ssa_epilogue(); }
    var out: string = "    .cfi_remember_state\n    sub sp, x29, #" + util.i32_to_string(ssa_save_bytes(saved)) + "\n";
    var i: i32 = saved.len();
    if (i % 2 == 1) { i = i - 1; out = out + "    ldr " + ssa_reg(saved[i]) + ", [sp], #16\n"; }
    while (i >= 2) {
        i = i - 2;
        out = out + "    ldp " + ssa_reg(saved[i]) + ", " + ssa_reg(saved[i + 1]) + ", [sp], #16\n";
    }
    return out + "    ldp x29, x30, [sp], #16\n    .cfi_def_cfa sp, 0\n    ret\n    .cfi_restore_state\n";
}
function ssa_slot_off(v: i32): i32 { return 0 - 8 * (v + 1); }

// ssa_fr_ldr / ssa_fr_str access an SSA frame slot at its x29-relative
// offset. With the function's frame at rest the slot is also at
// [sp, #(frame + off)], a positive offset one scaled ldr/str encodes up to
// 32760, where the x29 form needs the address built in x16 beyond 256 bytes;
// `pushed` is how many bytes of call arguments sit below the frame at the
// access. Past the scaled range, or outside an SSA function, the x29 form.
function ssa_fr_pos(s: asmcore.EmitState, off: i32, pushed: i32): i32 {
    if (s.ssa_frame <= 0) { return 0 - 1; }
    var pos: i32 = s.ssa_frame + off + pushed;
    if (pos < 0 || pos > 32760) { return 0 - 1; }
    return pos;
}
// A slot's x29-relative offset is below the callee-saved registers' save area.
function ssa_fr_ldr(s: asmcore.EmitState, reg: string, off: i32, pushed: i32): asmcore.EmitState {
    var pos: i32 = ssa_fr_pos(s, off - s.ssa_save, pushed);
    if (pos >= 0) { return s.write("    ldr " + reg + ", [sp, #" + util.i32_to_string(pos) + "]\n"); }
    return fr_ldr(s, reg, off - s.ssa_save);
}
function ssa_fr_str(s: asmcore.EmitState, reg: string, off: i32, pushed: i32): asmcore.EmitState {
    var pos: i32 = ssa_fr_pos(s, off - s.ssa_save, pushed);
    if (pos >= 0) { return s.write("    str " + reg + ", [sp, #" + util.i32_to_string(pos) + "]\n"); }
    return fr_str(s, reg, off - s.ssa_save);
}

// ssa_load puts value v in `reg`; ssa_store writes `reg` to value v's home.
// ssa_load_pushed is the load with `pushed` bytes of arguments already on the
// machine stack below the frame.
function ssa_load(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
    return ssa_load_pushed(reg_of, v, reg, 0, s);
}
function ssa_load_pushed(reg_of: i32[], v: i32, reg: string, pushed: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (reg == "x4") {
        if (s.ssa_x0 == v) { return s; }
        s = asmcore.EmitState { ...s, ssa_x0: v };
    }
    if (reg_of[v] < 0) { return ssa_fr_ldr(s, reg, ssa_slot_off(ssa.spill_slot(reg_of[v])), pushed); }
    var home: string = ssa_reg(reg_of[v]);
    if (home == reg) { return s; }
    return s.write("    mov " + reg + ", " + home + "\n");
}
function ssa_store(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
    if (reg == "x4") { s = asmcore.EmitState { ...s, ssa_x0: v }; }
    if (reg_of[v] == 0 - 1) { return s; }
    if (reg_of[v] < 0) { return ssa_fr_str(s, reg, ssa_slot_off(ssa.spill_slot(reg_of[v])), 0); }
    var home: string = ssa_reg(reg_of[v]);
    if (home == reg) { return s; }
    return s.write("    mov " + home + ", " + reg + "\n");
}
// ssa_x0_forget marks x0 as holding no tracked value: at a label, and
// before a sequence that writes x0 on its own.
function ssa_x0_forget(s: asmcore.EmitState): asmcore.EmitState { return asmcore.EmitState { ...s, ssa_x0: 0 - 1 }; }

// ssa_dst is where an instruction this emitter selects itself writes its
// result: the value's register home, or x0 for a value in a frame slot,
// which ssa_store then spills. ssa_src is where an operand is read from: its
// register home, or `scratch` once ssa_load has filled it. An instruction's
// result shares a register with an operand only when it is a phi or one of
// the two-operand integer ops, whose operand is read before the result is
// written; the allocator frees any other operand's register only after the
// instruction that last reads it.
function ssa_dst(reg_of: i32[], v: i32): string {
    if (reg_of[v] >= 0) { return ssa_reg(reg_of[v]); }
    return "x4";
}
function ssa_src(reg_of: i32[], v: i32, scratch: string): string {
    if (reg_of[v] >= 0) { return ssa_reg(reg_of[v]); }
    return scratch;
}
// ssa_read brings a spilled operand into `scratch`, so ssa_src names where it
// is; a register-homed operand is read from its home and needs nothing.
function ssa_read(reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
    if (reg_of[v] >= 0) { return s; }
    return ssa_load(reg_of, v, scratch, s);
}
// The integer ops with a three-operand form, which compute into the result's
// home straight from the operands' homes; division, remainder and the shifts
// keep the scratch path for their extra instructions.
function ssa_direct_bin(tag: i32): boolean {
    return tag == 21 || tag == 22 || tag == 23 || tag == 28 || tag == 29 || tag == 30 || ircore.is_int_cmp_kind(tag);
}
// A shift computes in the destination too, but only with the count known: the
// variable-count form masks the count in place, which would write an operand's
// home.
function ssa_shift_tag(tag: i32): boolean { return tag == 31 || tag == 32 || tag == 33; }
// ssa_bin3_asm is one three-operand integer op: `op d, a, b`, or the compare
// of a and b with the condition set into d.
function ssa_bin3_asm(tag: i32, d: string, a: string, b: string): string {
    if (tag == 21) { return "    add " + d + ", " + a + ", " + b + "\n"; }
    if (tag == 22) { return "    sub " + d + ", " + a + ", " + b + "\n"; }
    if (tag == 23) { return "    mul " + d + ", " + a + ", " + b + "\n"; }
    if (tag == 28) { return "    and " + d + ", " + a + ", " + b + "\n"; }
    if (tag == 29) { return "    orr " + d + ", " + a + ", " + b + "\n"; }
    if (tag == 30) { return "    eor " + d + ", " + a + ", " + b + "\n"; }
    return "    cmp " + a + ", " + b + "\n    cset " + d + ", " + ir_cmp_cond(tag, true) + "\n";
}
// The ops whose right operand, or whose left operand when it can be turned
// round, may be a 12-bit immediate rather than a register: add, sub and the
// compares. mul has no immediate form and the logical ops take bitmask
// immediates, which a 12-bit range does not describe.
function ssa_imm_right(): string[] { return ["add", "sub", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u"]; }
function ssa_imm_left(): string[] { return ["add", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u"]; }
// ssa_rhs is a right operand as the instruction reads it: the immediate for a
// constant that has none, otherwise its home or the scratch; ssa_read_rhs
// fills the scratch only when there is a spilled value to fill it with.
function ssa_rhs(fr: SsaFrame, reg_of: i32[], v: i32, scratch: string): string {
    if (fr.imm.is_imm[v]) { return "#" + util.i64_to_string(fr.imm.value[v]); }
    return ssa_src(reg_of, v, scratch);
}
function ssa_read_rhs(fr: SsaFrame, reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
    if (fr.imm.is_imm[v]) { return s; }
    return ssa_read(reg_of, v, scratch, s);
}
// ssa_bin_in_place emits a three-operand integer op into the result's home,
// each operand read from its own or as an immediate; a spilled operand is
// read through x4 or x5. A constant on the left is only ever one the op can
// take on the right, so the operands swap and a comparison flips.
function ssa_bin_in_place(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
    var tag: i32 = ir.kind_id(ins.str);
    var a: i32 = ins.args[0];
    var b: i32 = ins.args[1];
    if (fr.imm.is_imm[a] && !ssa_shift_tag(tag)) { tag = ircore.flip_int_cmp_kind(tag); a = ins.args[1]; b = ins.args[0]; }
    var dh: string = ssa_dst(reg_of, ins.result);
    s = ssa_read(reg_of, a, "x4", s);
    s = ssa_read_rhs(fr, reg_of, b, "x5", s);
    if (ssa_shift_tag(tag)) {
        s = s.write(shift_imm_asm(tag, ins.imm, fr.imm.value[b], dh, ssa_src(reg_of, a, "x4")));
        return ssa_store(reg_of, ins.result, dh, s);
    }
    s = s.write(ssa_bin3_asm(tag, dh, ssa_src(reg_of, a, "x4"), ssa_rhs(fr, reg_of, b, "x5")));
    return ssa_store(reg_of, ins.result, dh, s);
}
// ssa_wreg is the 32-bit name of an x register.
function ssa_wreg(x: string): string {
    match (x[1:]) { Some(n) => { return "w" + n; }, None => { return "w0"; } }
}
// ssa_const_reg materialises an integer literal in `d`: one MOVZ for a small
// decimal, one MOVN for a small negative one, the pool otherwise.
function ssa_const_reg(text: string, d: string, s: asmcore.EmitState): asmcore.EmitState {
    if (movz_text_ok(text) || movn_text_ok(text)) { return s.write("    mov " + d + ", #" + text + "\n"); }
    return s.write("    ldr " + d + ", =" + text + "\n");
}

// ssa_unary_known is the unary vocabulary lift_from_ir_prod produces.
function ssa_unary_known(what: string): boolean {
    if (what == "!" || what == "int_extend" || what == "int_wrap" || what == "u32_wrap" || what == "load_i32") { return true; }
    return util.str_has_prefix(what, "int_cast:") || ssa_funary_known(what) || ssa_bits_asm(what, "x4") != "";
}

// ssa_funary_known is the f64 unary vocabulary lift_float_prod produces.
function ssa_funary_known(what: string): boolean {
    var un: string[] = ["fsqrt", "ffloor", "fceil", "ftrunc", "fabs", "fround", "fneg", "f64_to_i32", "f64_to_i64", "f32_bits", "f32_from_bits"];
    for x in un { if (x == what) { return true; } }
    return util.str_has_prefix(what, "i32_to_f64:");
}

function ssa_inst_known(ins: ssa.SInst): boolean {
    var k: i32 = ins.kind_tag;
    if (k == 10) { return ssa_unary_known(ins.str); }
    if (k >= 40 && k <= 60) { return true; }
    return k == 1 || k == 3 || k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 11;
}

// ssa_unsupported names the first instruction this emitter has no selection
// for, "" when it can emit the whole function. The production lift emits only
// what ssa_inst_known lists, so a name from here is the lift and the emitter
// disagreeing, reported rather than mis-emitted.
function ssa_unsupported(f: ssa.SFunc): string {
    for blk in f.blocks {
        for ins in blk.insts {
            if (!ssa_inst_known(ins)) { return "ssa " + ssa.kind_name(ins.kind_tag) + " " + ins.str; }
        }
        if (blk.term.kind_tag > 3) { return "ssa terminator " + ssa.term_name(blk.term.kind_tag); }
    }
    return "";
}

// ssa_block_index maps a block id to its position in f.blocks (-1 for an id
// no block carries), built once per function; ssa_block_at reads it. The
// search this replaces ran once per edge.
function ssa_block_index(f: ssa.SFunc): i32[] {
    var most: i32 = 0;
    for blk in f.blocks { if (blk.id > most) { most = blk.id; } }
    var out: i32[] = [];
    var i: i32 = 0;
    while (i <= most) { out = out.append(0 - 1); i = i + 1; }
    var pos: i32 = 0;
    while (pos < f.blocks.len()) { out = out.with(f.blocks[pos].id, pos); pos = pos + 1; }
    return out;
}
function ssa_block_at(fr: SsaFrame, id: i32): i32 {
    if (id < 0 || id >= fr.blk_pos.len()) { return 0 - 1; }
    return fr.blk_pos[id];
}

function ssa_has_phis(f: ssa.SFunc, fr: SsaFrame, id: i32): boolean {
    var ti: i32 = ssa_block_at(fr, id);
    if (ti < 0) { return false; }
    for ins in f.blocks[ti].insts { if (ins.kind_tag == 8) { return true; } }
    return false;
}

// ssa_unary_asm is the stack machine's selection for the width ops, `not`
// and the f64 unaries, in place on `d`. A cast to a type none of the arms name
// moves nothing there either.
function ssa_unary_asm(what: string, unsigned: boolean, d: string): string {
    var w: string = ssa_wreg(d);
    var f: string = ssa_fmath_asm(what, d);
    if (f == "") { f = ssa_fconv_asm(what, unsigned, d); }
    if (f == "") { f = ssa_bits_asm(what, d); }
    if (f != "") { return f; }
    if (what == "load_i32") { return "    ldrsw " + d + ", [" + d + "]\n"; }
    if (what == "!") { return "    cmp " + d + ", #0\n    cset " + d + ", eq\n"; }
    if (what == "u32_wrap" || what == "int_cast:u32") { return "    mov " + w + ", " + w + "\n"; }
    if (what == "int_cast:u8") { return "    and " + d + ", " + d + ", #255\n"; }
    if (what == "int_cast:i32") { return "    sxtw " + d + ", " + w + "\n"; }
    if (what == "int_extend" || what == "int_wrap") {
        if (unsigned) { return "    mov " + w + ", " + w + "\n"; }
        return "    sxtw " + d + ", " + w + "\n";
    }
    return "";
}

// ssa_bits_asm is the bit counts on `d` at the width the name carries, as the
// stack machine's arms select them; "" for any other op.
function ssa_bits_asm(what: string, d: string): string {
    var w: string = ssa_wreg(d);
    if (what == "clz:64") { return "    clz " + d + ", " + d + "\n"; }
    if (what == "clz:32") { return "    clz " + w + ", " + w + "\n"; }
    if (what == "ctz:64") { return "    rbit " + d + ", " + d + "\n    clz " + d + ", " + d + "\n"; }
    if (what == "ctz:32") { return "    rbit " + w + ", " + w + "\n    clz " + w + ", " + w + "\n"; }
    if (what == "popcount:64") { return "    fmov d0, " + d + "\n    cnt v0.8b, v0.8b\n    addv b0, v0.8b\n    fmov " + w + ", s0\n"; }
    if (what == "popcount:32") { return "    fmov s0, " + w + "\n    cnt v0.8b, v0.8b\n    addv b0, v0.8b\n    fmov " + w + ", s0\n"; }
    return "";
}

// ssa_fmath_asm is the single-instruction f64 math on the pattern in `d`, as
// the stack machine's arms select it; "" for any other op.
function ssa_fmath_asm(what: string, d: string): string {
    var op: string = "";
    if (what == "fsqrt") { op = "fsqrt"; } else if (what == "ffloor") { op = "frintm"; }
    else if (what == "fceil") { op = "frintp"; } else if (what == "ftrunc") { op = "frintz"; }
    else if (what == "fround") { op = "frinta"; } else if (what == "fneg") { op = "fneg"; }
    else if (what == "fabs") { op = "fabs"; }
    if (op == "") { return ""; }
    return "    fmov d0, " + d + "\n    " + op + " d0, d0\n    fmov " + d + ", d0\n";
}

// ssa_fconv_asm is the f64 conversions and reinterprets on `d`: the saturating
// fcvtz forms and the width-selected scvtf/ucvtf, as the stack machine's arms
// select them; "" for any other op.
function ssa_fconv_asm(what: string, unsigned: boolean, d: string): string {
    var w: string = ssa_wreg(d);
    if (what == "i32_to_f64:64") {
        if (unsigned) { return "    ucvtf d0, " + d + "\n    fmov " + d + ", d0\n"; }
        return "    scvtf d0, " + d + "\n    fmov " + d + ", d0\n";
    }
    if (what == "i32_to_f64:32") {
        if (unsigned) { return "    ucvtf d0, " + w + "\n    fmov " + d + ", d0\n"; }
        return "    scvtf d0, " + d + "\n    fmov " + d + ", d0\n";
    }
    if (what == "f64_to_i32") {
        if (unsigned) { return "    fmov d0, " + d + "\n    fcvtzu " + w + ", d0\n"; }
        return "    fmov d0, " + d + "\n    fcvtzs " + w + ", d0\n    sxtw " + d + ", " + w + "\n";
    }
    if (what == "f64_to_i64") {
        if (unsigned) { return "    fmov d0, " + d + "\n    fcvtzu " + d + ", d0\n"; }
        return "    fmov d0, " + d + "\n    fcvtzs " + d + ", d0\n";
    }
    if (what == "f32_bits") { return "    fmov d0, " + d + "\n    fcvt s0, d0\n    fmov " + w + ", s0\n    sxtw " + d + ", " + w + "\n"; }
    if (what == "f32_from_bits") { return "    fmov s0, " + w + "\n    fcvt d0, s0\n    fmov " + d + ", d0\n"; }
    return "";
}

// ssa_fbin_asm is one f64 binary with the patterns in x0 (lhs) and x1 (rhs),
// the result pattern or 0/1 in x0; "" for an integer op. fcmp's condition
// codes are NaN-aware, as the stack machine's compare arm relies on.
function ssa_fbin_asm(what: string): string {
    var ld: string = "    fmov d0, x4\n    fmov d1, x5\n";
    var arith: string = "";
    if (what == "fadd") { arith = "fadd"; } else if (what == "fsub") { arith = "fsub"; }
    else if (what == "fmul") { arith = "fmul"; } else if (what == "fdiv") { arith = "fdiv"; }
    if (arith != "") { return ld + "    " + arith + " d0, d0, d1\n    fmov x4, d0\n"; }
    var cc: string = "";
    if (what == "flt") { cc = "mi"; } else if (what == "fle") { cc = "ls"; }
    else if (what == "fgt") { cc = "gt"; } else if (what == "fge") { cc = "ge"; }
    else if (what == "feq") { cc = "eq"; } else if (what == "fne") { cc = "ne"; }
    if (cc == "") { return ""; }
    return ld + "    fcmp d0, d1\n    cset w4, " + cc + "\n";
}

// ssa_fcall_sym is the runtime helper for a transcendental, "" otherwise.
function ssa_fcall_sym(what: string): string {
    if (what == "fsin") { return "__fern_sin_f64"; }
    if (what == "fcos") { return "__fern_cos_f64"; }
    if (what == "fexp") { return "__fern_exp_f64"; }
    if (what == "flog") { return "__fern_log_f64"; }
    if (what == "fpow") { return "__fern_pow_f64"; }
    return "";
}

// ssa_fcall calls a transcendental helper: the operand patterns in d0 (and d1
// for fpow), the result pattern back from d0.
function ssa_fcall(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.need("float_transcendentals");
    s = ssa_load_abi_args(reg_of, ins.args, ["x0", "x1"], s);
    if (ins.args.len() > 1) { s = s.write("    fmov d1, x1\n"); }
    s = s.write("    fmov d0, x0\n    bl " + ssa_fcall_sym(ins.str) + "\n    fmov x0, d0\n");
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}
// With x0 an allocatable home, an arm that fills the ABI's argument
// registers in order can destroy a later argument: loading args[0] into x0
// overwrites whatever lives there. ssa_load_abi_args loads the argument
// homed in x0 first, into its own target, so nothing is read after it is
// written. Only x0 is both a home and an argument register, so one
// reordering is enough.
function ssa_load_abi_args(reg_of: i32[], args: i32[], regs: string[], s: asmcore.EmitState): asmcore.EmitState {
    var first: i32 = 0 - 1;
    var i: i32 = 1;
    while (i < args.len() && i < regs.len()) {
        if (reg_of[args[i]] == 0) { first = i; }
        i = i + 1;
    }
    if (first >= 0) { s = ssa_load(reg_of, args[first], regs[first], s); }
    i = 0;
    while (i < args.len() && i < regs.len()) {
        if (i != first) { s = ssa_load(reg_of, args[i], regs[i], s); }
        i = i + 1;
    }
    return s;
}

// ssa_push_operand stages one call argument: a store straight from the value's
// home when it has a register, so the argument costs one instruction and x0
// keeps whatever it held. A spilled value still reaches the stack through x0.
function ssa_push_operand(reg_of: i32[], v: i32, pushed: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (reg_of[v] >= 0) { return s.write("    str " + ssa_reg(reg_of[v]) + ", [sp, #-16]!\n"); }
    s = ssa_load_pushed(reg_of, v, "x4", pushed, s);
    return s.write("    str x4, [sp, #-16]!\n");
}

// ssa_rc_prim renders one rc primitive inline, in the instructions its stub
// uses, the heap floor compared as a shifted immediate. x5 holds the count,
// x6 the 0/1, and x7 the poison the sanitizer compares against; none is a
// home (those are x0 and x9 upward), so all survive a destination that IS
// the operand's register, and the destination is written after the last read
// of it. Every read of the count carries the poison check, the uniqueness
// test no less than the retain (#9889). ssa.rc_inlined says which calls come
// here and why.
function ssa_rc_prim(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs(ins.str, s);
    s = ssa_read(reg_of, ins.args[0], "x4", s);
    var p: string = ssa_src(reg_of, ins.args[0], "x4");
    var done: string = lp + "rcinc" + util.i32_to_string(ins.result);
    if (ins.str == "__fern_rc_is_unique") { done = lp + "rcuniq" + util.i32_to_string(ins.result); }
    var guard: string = "    tbnz " + p + ", #0, " + done + "\n"
        + "    cmp " + p + ", #16, lsl #12\n    blo " + done + "\n";
    if (ins.str == "__fern_rc_is_unique") {
        var d: string = ssa_dst(reg_of, ins.result);
        s = s.write("    mov x6, #0\n" + guard);
        // w7 rather than the arm's own x4/x5/x6: p, the count and the 0/1
        // answer hold all three across the compare, and x7 is not in the home
        // pool (x0, x9..x15, x19..x28), so the check can borrow it.
        s = s.write("    ldur w5, [" + p + ", #-8]\n");
        s = s.write(san_poison_check("w5", "w7", done + "us"));
        s = s.write("    cmp w5, #1\n    bne " + done + "\n");
        s = s.write("    mov x6, #1\n" + done + ":\n");
        s = s.write("    mov " + d + ", x6\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    s = s.write(guard);
    s = s.write("    ldur w5, [" + p + ", #-8]\n");
    s = s.write(san_poison_check("w5", "w6", done + "sl"));
    s = s.write("    tbnz w5, #31, " + done + "\n");
    s = s.write("    add w5, w5, #1\n    stur w5, [" + p + ", #-8]\n");
    s = s.write(done + ":\n");
    // rc_inc hands the pointer back; a result with no home stores nothing.
    return ssa_store(reg_of, ins.result, p, s);
}

// ssa_helper_call calls a runtime helper through its register entry.
function ssa_helper_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs(ins.str, s);
    var hsrc: i32[] = [];
    var hdst: i32[] = [];
    var ha: i32 = 0;
    while (ha < ins.args.len()) { hsrc = hsrc.append(reg_of[ins.args[ha]]); hdst = hdst.append(ha); ha = ha + 1; }
    s = ssa_parallel_moves(hsrc, hdst, s);
    s = s.write("    bl " + ircore.ir_helper_symbol(ins.str) + ".r\n");
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// ssa_rc_dec renders an array or string release inline where the count
// survives it: below the heap floor (every null), an inline string's tag bit,
// a static box's negative count, and a count above one, decremented in w5 and
// stored back. A count of one (the free) or zero (the underflow the helper
// reports) calls the helper. Either way the pointer is the result, as the
// helper leaves it in x0.
function ssa_rc_dec(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs(ins.str, s);
    s = ssa_read(reg_of, ins.args[0], "x4", s);
    var p: string = ssa_src(reg_of, ins.args[0], "x4");
    var id: string = util.i32_to_string(ins.result);
    var dec: string = lp + "rcdecd" + id;
    var kept: string = lp + "rcdeck" + id;
    var done: string = lp + "rcdece" + id;
    if (ins.str == "__fern_str_free") { s = s.write("    tbnz " + p + ", #0, " + kept + "\n"); }
    s = s.write("    cmp " + p + ", #16, lsl #12\n    blo " + kept + "\n");
    s = s.write("    ldur w5, [" + p + ", #-8]\n    cmp w5, #1\n    bgt " + dec + "\n");
    s = s.write("    tbnz w5, #31, " + kept + "\n");
    s = ssa_helper_call(ins, reg_of, s);
    s = s.write("    b " + done + "\n" + dec + ":\n    sub w5, w5, #1\n    stur w5, [" + p + ", #-8]\n" + kept + ":\n");
    s = ssa_store(reg_of, ins.result, p, s);
    return s.write(done + ":\n");
}

// ssa_call emits one call as the stack machine leaves it: the arguments pushed
// in IR order for a runtime helper and reversed for a user function (arg0 on
// top), the callee, the caller-side pop, and x0 stored.
function ssa_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    if (ssa.rc_inlined(ins)) { return ssa_rc_prim(ins, reg_of, lp, s); }
    s = ssa_x0_forget(s);
    if ((ins.str == "__fern_rc_dec" || ins.str == "__fern_str_free") && ins.args.len() == 1 && !rc_free_debug_on()) { return ssa_rc_dec(ins, reg_of, lp, s); }
    if (ircore.is_fern_helper(ins.str) && ssa_reg_helper(ircore.ir_helper_symbol(ins.str), ins.args.len())) {
        return ssa_helper_call(ins, reg_of, s);
    }
    if (ssa_reg_call(ins, s)) {
        // Only this call's own arguments can be in the pool's registers here:
        // anything live across it is callee-saved or in a slot.
        var srcs: i32[] = [];
        var dsts: i32[] = [];
        var a: i32 = 0;
        while (a < ins.args.len()) { srcs = srcs.append(reg_of[ins.args[a]]); dsts = dsts.append(a); a = a + 1; }
        s = ssa_parallel_moves(srcs, dsts, s);
        s = s.write("    bl __fn_" + asmcore.sanitize_label(ins.str) + ".r\n");
        return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
    }
    var argc: i32 = ins.args.len();
    var helper: boolean = ircore.is_fern_helper(ins.str);
    if (helper) { s = helper_call_needs(ins.str, s); }
    else if (ircore.is_c_call(ins.str)) { s = s.need("ccall:" + ins.str); }
    var i: i32 = 0;
    while (i < argc) {
        var a: i32 = i;
        if (!helper) { a = argc - 1 - i; }
        s = ssa_push_operand(reg_of, ins.args[a], i * 16, s);
        i = i + 1;
    }
    if (helper) { s = s.write("    bl " + ircore.ir_helper_symbol(ins.str) + "\n"); }
    else { s = s.write("    bl __fn_" + asmcore.sanitize_label(ins.str) + "\n"); }
    if (argc > 0) { s = s.write("    add sp, sp, #" + util.i32_to_string(argc * 16) + "\n"); }
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}


// ssa_mem_inst selects the production lift's memory kinds (ssa.fern 40..44)
// with the instructions the stack machine's own arms use, operands in x0/x1/x2.
function ssa_mem_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ins.kind_tag;
    var a: string = ssa_src(reg_of, ins.args[0], "x4");
    s = ssa_load(reg_of, ins.args[0], a, s);
    var d: string = ssa_dst(reg_of, ins.result);
    if (k == 40) {
        s = s.write("    ldr " + d + ", [" + a + ", #" + util.i32_to_string(ins.imm) + "]\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    var b: string = ssa_src(reg_of, ins.args[1], "x5");
    s = ssa_load(reg_of, ins.args[1], b, s);
    if (k == 41 && ins.str == "i32") { return s.write("    str " + ssa_wreg(b) + ", [" + a + "]\n"); }
    if (k == 41) { return s.write("    str " + b + ", [" + a + ", #" + util.i32_to_string(ins.imm) + "]\n"); }
    if (k == 42) {
        if (ins.imm != 1) {
            s = s.mark_heap();
            s = s.write("    ldr x6, [" + a + "]\n    cmp " + b + ", x6\n    b.lo 1f\n    b __fern_oob_abort\n1:\n");
        }
        s = s.write("    add x5, " + b + ", #1\n    ldr " + d + ", [" + a + ", x5, lsl #3]\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    if (k == 44) {
        s = s.mark_heap();
        if (ins.imm != 1) { s = s.write("    ldr x6, [" + a + ", #8]\n    cmp " + b + ", x6\n    b.lo 1f\n    b __fern_oob_abort\n1:\n"); }
        s = s.write("    ldr x6, [" + a + "]\n    ldrb " + ssa_wreg(d) + ", [x6, " + b + "]\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    var c: string = ssa_src(reg_of, ins.args[2], "x6");
    s = ssa_load(reg_of, ins.args[2], c, s);
    s = s.mark_heap();
    return s.write("    ldr x7, [" + a + "]\n    cmp " + b + ", x7\n    b.lo 1f\n    b __fern_oob_abort\n1:\n    add x5, " + b + ", #1\n    str " + c + ", [" + a + ", x5, lsl #3]\n");
}

// ssa_str_call is the stack machine's call of a Fern-compiled runtime helper
// for a string or slice op: arguments pushed with the first on top, the
// helper's need marked as the flat arm marks it.
function ssa_str_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = ssa_str_marks(ins.str, s);
    var argc: i32 = ins.args.len();
    var i: i32 = argc - 1;
    while (i >= 0) {
        s = ssa_push_operand(reg_of, ins.args[i], (argc - 1 - i) * 16, s);
        i = i - 1;
    }
    s = s.write("    bl __fn___fern_" + ssa_str_target(ins.str) + "\n");
    if (argc > 0) { s = s.write("    add sp, sp, #" + util.i32_to_string(argc * 16) + "\n"); }
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

function ssa_str_target(op: string): string {
    if (op == "str_from_bytes") { return "string_from_bytes"; }
    if (op == "read_chunk") { return "reader_read_chunk"; }
    return op;
}

// ssa_host_need is the need a host helper on the stack ABI carries besides
// the heap, "" for an op that is not one; the three that need no heap are
// named by ssa_host_bare.
function ssa_host_need(op: string): string {
    var fs: string[] = ["read_file", "read_file_bytes", "write_file", "write_file_exec", "remove_dir_all", "remove_file",
        "create_dir_all", "read_dir", "read_dir_all", "env", "stat", "lstat", "subprocess", "writer_write"];
    for x in fs { if (x == op) { return op; } }
    if (op == "read_line") { return "str_read_line"; }
    if (op == "read_chunk" || op == "reader_close") { return "reader"; }
    return "";
}
function ssa_host_bare(op: string): boolean {
    return op == "putchar" || op == "monotonic_ns" || op == "now_unix_ms";
}

function ssa_str_marks(op: string, s: asmcore.EmitState): asmcore.EmitState {
    if (op == "temp_dir") { return s.mark_heap().need("monotonic_ns").need("temp_dir"); }
    if (ssa_host_need(op) != "") { return s.mark_heap().need(ssa_host_need(op)); }
    if (ssa_host_bare(op)) { return s.need(op); }
    if (op == "str_concat") { return s.mark_heap().mark_str_concat(); }
    if (op == "str_eq") { return s.mark_str_eq(); }
    if (op == "str_cmp") { return s.mark_str_cmp(); }
    if (op == "arr_slice") { return s.mark_heap().mark_arr_slice(); }
    if (op == "print_str") { return s.need("str_print"); }
    if (op == "eprint_str") { return s.need("eprint"); }
    return s.mark_str_from_bytes();
}

// ssa_host_kind names the register-ABI ops ssa_host_call selects: the raw
// syscalls, exit, the string box stamp and the string builder.
function ssa_host_kind(op: string): boolean {
    return util.str_has_prefix(op, "syscall") || op == "exit" || op == "raw_string" || util.str_has_prefix(op, "strbuf_");
}

// ssa_host_call emits the host-floor ops as the stack machine's arms do. A
// syscall pushes its operands and then runs the flat arm's exact pop
// sequence: its `ldr x8, [sp], #16` is the line darwinize keys the Mach-O
// syscall rewrite off, so the text must not change.
function ssa_host_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    if (util.str_has_prefix(ins.str, "syscall")) {
        var i: i32 = 0;
        while (i < ins.args.len()) {
            s = ssa_push_operand(reg_of, ins.args[i], i * 16, s);
            i = i + 1;
        }
        var a: i32 = ins.args.len() - 2;
        while (a >= 0) { s = s.write("    ldr x" + util.i32_to_string(a) + ", [sp], #16\n"); a = a - 1; }
        s = s.write("    ldr x8, [sp], #16\n    svc #0\n");
        return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
    }
    if (ins.str == "exit") {
        s = ssa_load(reg_of, ins.args[0], "x0", s);
        if (leak_check_on()) { s = s.write("    mov x19, x0\n    bl __fern_lc_report\n    mov x0, x19\n"); }
        s = s.write("    mov x8, #93\n    svc #0\n    mov x0, #0\n");
        return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
    }
    s = s.mark_heap();
    if (ins.str == "raw_string") {
        s = ssa_load_abi_args(reg_of, ins.args, ["x0", "x1"], s);
        s = s.write("    bl __fern_str_box_hdr\n");
        return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
    }
    s = s.need("strbuf");
    if (ins.args.len() > 0) { s = ssa_load(reg_of, ins.args[0], "x0", s); }
    s = s.write("    bl __fern_" + ins.str + "\n");
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// The need whose gate defines a floor symbol, so an address taken outside the
// helpers that already mark it still links.
function sym_addr_need(sym: string): string {
    if (sym == "__fern_scratch") { return "raw_scratch"; }
    if (sym == "__fern_envp") { return "heap"; }
    if (sym == "__fern_splice_pipe") { return "raw_splice_pipe"; }
    return "";
}

// ssa_sym_addr is a static symbol's address, or the word at it (imm 1).
function ssa_sym_addr(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    if (util.str_has_prefix(ins.str, "__fern_arr_push_")) { s = s.mark_heap(); }
    if (sym_addr_need(ins.str) != "") { s = s.need(sym_addr_need(ins.str)); }
    var d: string = ssa_dst(reg_of, ins.result);
    s = s.write("    adrp " + d + ", " + ins.str + "\n    add " + d + ", " + d + ", :lo12:" + ins.str + "\n");
    if (ins.imm == 1) { s = s.write("    ldr " + d + ", [" + d + "]\n"); }
    return ssa_store(reg_of, ins.result, d, s);
}

// ssa_rt_call is the stack machine's call of a runtime routine on the register
// ABI: the arguments in x0, x1, the result in x0.
function ssa_rt_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.mark_heap();
    var sym: string = "__fern_alloc";
    if (ins.str == "alloc_u8") { sym = "__fern_alloc_u8"; }
    else if (ins.str == "struct_copy") { sym = "__fn___fern_struct_copy"; }
    else if (ins.str == "raw_arr_box") { sym = "__fern_arr_box"; }
    else if (ins.str == "map_new") { s = s.need("maps"); sym = "__fern_map_new"; }
    else if (ins.str == "args") { s = s.need("args"); sym = "__fern_args"; }
    else if (ins.str == "map_hash_seed") { s = s.need("random_i32").need("map_hash_seed"); sym = "__fern_map_hash_seed"; }
    else if (util.str_has_prefix(ins.str, "arr_push_owned")) { s = s.mark_arr_push(); sym = "__fern_arr_push_owned"; }
    else if (util.str_has_prefix(ins.str, "arr_push")) { s = s.mark_arr_push(); sym = "__fern_arr_push"; }
    s = ssa_load_abi_args(reg_of, ins.args, ["x0", "x1"], s);
    // raw_alloc asks for 24 bytes more and hands back the pointer past them,
    // the string box header a buffer may later grow (#7351).
    if (ins.str == "raw_alloc") {
        s = s.write("    tbz w0, #31, 1f\n    b __fern_alloc_size_abort\n1:\n");
        s = s.write("    add x0, x0, #24\n");
    }
    if (util.str_has_prefix(ins.str, "arr_push") && ins.result >= 0 && !rc_free_debug_on()) { s = s.write(arr_push_inline(sym, lp + "apush" + util.i32_to_string(ins.result))); }
    else { s = s.write("    bl " + sym + "\n"); }
    if (ins.str == "raw_alloc") { s = s.write("    add x0, x0, #24\n"); }
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// arr_push_inline is arr_push_fast at the call site, calling `sym` only when
// the receiver has no free slot or is shared.
function arr_push_inline(sym: string, l: string): string {
    return "    ldr x2, [x0]\n    ldur x3, [x0, #-16]\n    cmp x2, x3\n    b.ge " + l + "s\n"
        + "    ldur x3, [x0, #-8]\n    cmp x3, #1\n    b.eq " + l + "o\n"
        + "    tbz x3, #31, " + l + "s\n"
        + l + "o:\n    add x2, x2, #1\n    str x1, [x0, x2, lsl #3]\n    str x2, [x0]\n    b " + l + "e\n"
        + l + "s:\n    bl " + sym + "\n" + l + "e:\n";
}

// ssa_view_slots gives each frame-resident string view (kind 51, imm 1) the
// index of its three frame words, in instruction order, and -1 to every other
// value; ssa_view_count is how many there are. The words sit after the spill
// slots.
function ssa_view_slots(f: ssa.SFunc): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < f.nvals) { out = out.append(0 - 1); i = i + 1; }
    var n: i32 = 0;
    for blk in f.blocks {
        for ins in blk.insts {
            if (ins.kind_tag == 51 && ins.imm == 1) { out = out.with(ins.result, n); n = n + 1; }
        }
    }
    return out;
}
function ssa_view_count(views: i32[]): i32 {
    var n: i32 = 0;
    for v in views { if (v >= 0) { n = n + 1; } }
    return n;
}

// ssa_str_view is the string slice kernel of emit_str_op with register
// operands: the two bounds checks, then the {rc -1, data + lo, hi - lo} box
// either in the frame words this site owns or freshly allocated. The operands
// are read before the allocation and carried across it on the machine stack,
// since the call clobbers every register they could live in.
function ssa_str_view(ins: ssa.SInst, reg_of: i32[], base_off: i32, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.mark_heap();
    s = ssa_load_abi_args(reg_of, ins.args, ["x0", "x1", "x2"], s);
    s = s.write("    ldr x3, [x0, #8]\n    cmp x2, x3\n    b.ls 1f\n    b __fern_oob_abort\n1:\n    cmp x1, x2\n    b.ls 1f\n    b __fern_oob_abort\n1:\n");
    s = s.write("    sub x2, x2, x1\n    ldr x3, [x0]\n    add x1, x3, x1\n");
    if (ins.imm == 1) {
        s = fr_sub_imm(s, "x0", "x29", 0 - base_off);
    } else {
        s = s.write("    stp x1, x2, [sp, #-16]!\n    mov x0, #24\n    bl __fern_alloc\n    ldp x1, x2, [sp], #16\n");
    }
    s = s.write("    mov x3, #-1\n    str x3, [x0]\n    str x1, [x0, #8]\n    str x2, [x0, #16]\n    add x0, x0, #8\n");
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// SsaFrame is the frame below the values: three words per frame-resident
// string view after the values. ssa_view_off is the offset of a view's lowest
// word, the base the view kernel writes at.
struct SsaFrame { nspill: i32, views: i32[], blk_pos: i32[], uses: i32[], nsave: i32, epilogue: string, imm: ssa.Imms }

// SsaFuse is a block's compare consumed as flags by its branch: `n` trailing
// instructions (the compare, and the `not` between it and the branch when
// `inverted`) are not materialised; the branch tests the condition of
// compare `tag` on operands `a` and `b` instead. A `not` of a plain boolean
// fuses too: `tag` is 0, the branch tests `a` for zero and takes the true
// edge when it is. An inline uniqueness test of `a` fuses as `unique`: its
// guards leave the flags an equality compare would. n is 0 when the block
// ends some other way.
struct SsaFuse { n: i32, tag: i32, inverted: boolean, a: i32, b: i32, unique: boolean }

function ssa_no_fuse(): SsaFuse { return SsaFuse { n: 0, tag: 0, inverted: false, a: 0, b: 0, unique: false }; }

// ssa_fuse finds the compare a block's brif can read as flags: the block's
// last instruction is an integer compare read only by the branch, or a `not`
// read only by the branch whose operand is such a compare read only by it. A
// `not` over anything else is the value test with the edges swapped.
function ssa_fuse(fr: SsaFrame, blk: ssa.SBlock): SsaFuse {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag != 3 || t.t == t.f || blk.insts.len() == 0) { return ssa_no_fuse(); }
    var last: ssa.SInst = blk.insts[blk.insts.len() - 1];
    if (last.result != t.cond || fr.uses[last.result] != 1) { return ssa_no_fuse(); }
    var cmp: ssa.SInst = last;
    var n: i32 = 1;
    var inverted: boolean = false;
    if (last.kind_tag == 10 && last.str == "!") {
        var value_test: SsaFuse = SsaFuse { n: 1, tag: 0, inverted: true, a: last.args[0], b: 0, unique: false };
        if (blk.insts.len() < 2) { return value_test; }
        cmp = blk.insts[blk.insts.len() - 2];
        if (cmp.result != last.args[0] || fr.uses[cmp.result] != 1) { return value_test; }
        if (!ssa_unique_test(cmp) && (cmp.kind_tag != 9 || !ircore.is_int_cmp_kind(ir.kind_id(cmp.str)))) { return value_test; }
        n = 2;
        inverted = true;
    }
    if (ssa_unique_test(cmp)) { return SsaFuse { n: n, tag: ir.kind_id("eq"), inverted: inverted, a: cmp.args[0], b: 0, unique: true }; }
    if (cmp.kind_tag != 9 || !ircore.is_int_cmp_kind(ir.kind_id(cmp.str))) { return ssa_no_fuse(); }
    if (fr.imm.is_imm[cmp.args[0]]) {
        return SsaFuse { n: n, tag: ircore.flip_int_cmp_kind(ir.kind_id(cmp.str)), inverted: inverted, a: cmp.args[1], b: cmp.args[0], unique: false };
    }
    return SsaFuse { n: n, tag: ir.kind_id(cmp.str), inverted: inverted, a: cmp.args[0], b: cmp.args[1], unique: false };
}

// ssa_join is the label a block's fused test joins at; a rotated latch
// re-runs its header's test under its own.
function ssa_join(lp: string, blk: i32): string { return lp + "uq" + util.i32_to_string(blk); }

function ssa_unique_test(ins: ssa.SInst): boolean {
    return ssa.rc_inlined(ins) && ins.str == "__fern_rc_is_unique";
}

function ssa_view_off(fr: SsaFrame, v: i32): i32 {
    var first: i32 = fr.nspill + 3 * fr.views[v];
    return 0 - 8 * (first + 3) - fr.nsave;
}

// ssa_raw_inst selects the raw memory floor (52..55): unchecked 8-byte and
// byte loads and stores at base + idx.
function ssa_raw_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ins.kind_tag;
    var a: string = ssa_src(reg_of, ins.args[0], "x4");
    s = ssa_load(reg_of, ins.args[0], a, s);
    var b: string = ssa_src(reg_of, ins.args[1], "x5");
    s = ssa_load(reg_of, ins.args[1], b, s);
    var d: string = ssa_dst(reg_of, ins.result);
    if (k == 52) { s = s.write("    ldr " + d + ", [" + a + ", " + b + ", lsl #3]\n"); return ssa_store(reg_of, ins.result, d, s); }
    if (k == 54) { s = s.write("    ldrb " + ssa_wreg(d) + ", [" + a + ", " + b + "]\n"); return ssa_store(reg_of, ins.result, d, s); }
    var c: string = ssa_src(reg_of, ins.args[2], "x6");
    s = ssa_load(reg_of, ins.args[2], c, s);
    if (k == 53) { return s.write("    str " + c + ", [" + a + ", " + b + ", lsl #3]\n"); }
    return s.write("    strb " + ssa_wreg(c) + ", [" + a + ", " + b + "]\n");
}

// ssa_call_ind is the stack machine's call through a function value: the
// arguments pushed with the first on top, the target in x9, which nothing
// live can occupy at a call.
function ssa_call_ind(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var argc: i32 = ins.args.len() - 1;
    var i: i32 = argc;
    while (i >= 1) {
        s = ssa_push_operand(reg_of, ins.args[i], (argc - i) * 16, s);
        i = i - 1;
    }
    s = ssa_load_pushed(reg_of, ins.args[0], "x9", argc * 16, s);
    s = s.write("    blr x9\n");
    if (argc > 0) { s = s.write("    add sp, sp, #" + util.i32_to_string(argc * 16) + "\n"); }
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// ssa_agg_lit is the address of a static record, variant or capture-free
// function-value box the lowering folded whole (ir.const_struct_* /
// ir.const_closure), interned as the flat arm interns it.
function ssa_agg_lit(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var pk: asmcore.ConstAggPack = asmcore.const_agg_pack(s, ins.str);
    s = pk.state;
    var kout: asmcore.ConstAggOut = asmcore.add_const_agg(s, pk.text);
    s = kout.state;
    var klbl: string = asmcore.const_agg_label(s, kout.idx);
    var d: string = ssa_dst(reg_of, ins.result);
    s = s.write("    adrp " + d + ", " + klbl + "\n    add " + d + ", " + d + ", :lo12:" + klbl + "\n");
    return ssa_store(reg_of, ins.result, d, s);
}

// ssa_addr_inst selects the label addresses and the box allocation (45..48).
function ssa_addr_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var k: i32 = ins.kind_tag;
    var label: string = "";
    if (k == 45) { label = "__fn_" + asmcore.sanitize_label(ins.str); }
    else if (k == 46) {
        var sh: asmcore.ShapeRefOut = asmcore.shape_ref(s, ins.str);
        s = sh.state;
        label = sh.label;
    } else if (k == 47) {
        s = s.mark_heap();
        var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, ins.str);
        s = lo.state;
        label = asmcore.str_box_label(s, lo.idx);
    } else {
        s = s.mark_heap();
        s = s.write("    mov x0, #" + util.i32_to_string(ins.imm) + "\n    bl __fern_arr_box\n");
        return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
    }
    var d: string = ssa_dst(reg_of, ins.result);
    s = s.write("    adrp " + d + ", " + label + "\n    add " + d + ", " + d + ", :lo12:" + label + "\n");
    return ssa_store(reg_of, ins.result, d, s);
}

function ssa_inst(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, lp: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ins.kind_tag;
    if (k == 11) { return ssa_call(ins, reg_of, lp, s); }
    if (k == 59) { return ssa_flat_op(ins, reg_of, lp, r, s); }
    if (k == 60) { return ssa_dyn_dispatch(ins, reg_of, lp, s); }
    if (k == 51) { return ssa_str_view(ins, reg_of, ssa_view_off(fr, ins.result), s); }
    if (k >= 40 && k <= 44) { return ssa_mem_inst(ins, reg_of, s); }
    if (k >= 45 && k <= 48) { return ssa_addr_inst(ins, reg_of, s); }
    if (k == 49) { return ssa_str_call(ins, reg_of, s); }
    if (k == 50 && ssa_fcall_sym(ins.str) != "") { return ssa_fcall(ins, reg_of, s); }
    if (k == 50 && ssa_host_kind(ins.str)) { return ssa_host_call(ins, reg_of, s); }
    if (k == 50) { return ssa_rt_call(ins, reg_of, lp, s); }
    if (k == 58) { return ssa_sym_addr(ins, reg_of, s); }
    if (k >= 52 && k <= 55) { return ssa_raw_inst(ins, reg_of, s); }
    if (k == 56) { return ssa_call_ind(ins, reg_of, s); }
    if (k == 57) { return ssa_agg_lit(ins, reg_of, s); }
    if ((k == 1 || k == 3) && fr.imm.is_imm[ins.result]) { return s; }
    var d: string = ssa_dst(reg_of, ins.result);
    if (k == 1) { s = ssa_const_reg(util.i32_to_string(ins.imm), d, s); }
    else if (k == 3) { s = ssa_const_reg(ins.str, d, s); }
    else if (k == 4) { s = s.write("    ldr " + d + ", =" + ins.str + "\n"); }
    else if (k == 7) { s = ssa_load(reg_of, ins.args[0], d, s); }
    else if (k == 9 && ssa_direct_bin(ir.kind_id(ins.str))) { return ssa_bin_in_place(ins, reg_of, fr, s); }
    else if (k == 9 && ssa_shift_tag(ir.kind_id(ins.str)) && fr.imm.is_imm[ins.args[1]]) { return ssa_bin_in_place(ins, reg_of, fr, s); }
    else if (k == 9) {
        d = "x4";
        s = ssa_load(reg_of, ins.args[0], "x4", s);
        s = ssa_load(reg_of, ins.args[1], "x5", s);
        var fb: string = ssa_fbin_asm(ins.str);
        if (fb != "") { s = s.write(fb); } else { s = s.write(ir_bin_asm(ir.kind_id(ins.str), ins.imm, "x4", "x5", "x6")); }
    } else {
        s = ssa_load(reg_of, ins.args[0], d, s);
        s = s.write(ssa_unary_asm(ins.str, ins.imm == 1, d));
    }
    return ssa_store(reg_of, ins.result, d, s);
}

// ssa_phi_moves emits the copies of the edge from block `pred` into block
// `succ`: each of succ's phis takes its operand for pred. A phi whose operand
// already sits in its home, or which nothing reads, moves nothing.
function ssa_phi_moves(f: ssa.SFunc, fr: SsaFrame, reg_of: i32[], pred: i32, succ: i32, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var ti: i32 = ssa_block_at(fr, succ);
    if (ti < 0) { return s; }
    var tb: ssa.SBlock = f.blocks[ti];
    var sl: i32 = ssa.pred_slot(tb, pred);
    var srcs: i32[] = [];
    var dsts: i32[] = [];
    for ins in tb.insts {
        if (ins.kind_tag == 8 && reg_of[ins.result] != 0 - 1 && reg_of[ins.args[sl]] != reg_of[ins.result]) {
            srcs = srcs.append(reg_of[ins.args[sl]]);
            dsts = dsts.append(reg_of[ins.result]);
        }
    }
    return ssa_parallel_moves(srcs, dsts, s);
}

// ssa_parallel_moves emits moves between locations (a register index or a
// spill code, as reg_of holds them) that happen at once: every source is read
// before any destination it names is written. They are a phi edge's copies, a
// register call's arguments and a register entry's parameters. A move whose
// destination no pending move still reads goes first, in one instruction when
// either side is a register, or two through x5 between two slots. When every
// pending destination is still read, the moves form a cycle: one source is
// parked in x4 and every move reading it takes it from there, which frees
// that location to be written.
function ssa_parallel_moves(srcs: i32[], dsts: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var done: boolean[] = [];
    for src in srcs { done = done.append(false); }
    var parking: boolean = false;
    var parked: i32 = 0;
    var left: i32 = srcs.len();
    while (left > 0) {
        var progressed: boolean = false;
        var i: i32 = 0;
        while (i < srcs.len()) {
            if (!done[i] && !ssa_move_blocked(srcs, dsts, done, i, parking, parked)) {
                if (parking && srcs[i] == parked) { s = ssa_loc_str(dsts[i], "x4", s); }
                else { s = ssa_move(srcs[i], dsts[i], s); }
                done = done.with(i, true);
                left = left - 1;
                progressed = true;
            }
            i = i + 1;
        }
        if (!progressed) {
            var j: i32 = 0;
            while (done[j]) { j = j + 1; }
            s = ssa_loc_ldr(srcs[j], "x4", s);
            parking = true;
            parked = srcs[j];
        }
    }
    return ssa_x0_forget(s);
}
// A move is blocked while another pending move still reads its destination
// from that location rather than from the parked copy.
function ssa_move_blocked(srcs: i32[], dsts: i32[], done: boolean[], i: i32, parking: boolean, parked: i32): boolean {
    var k: i32 = 0;
    while (k < srcs.len()) {
        if (k != i && !done[k] && srcs[k] == dsts[i] && !(parking && srcs[k] == parked)) { return true; }
        k = k + 1;
    }
    return false;
}
function ssa_move(src: i32, dst: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (src == dst) { return s; }
    if (src >= 0) { return ssa_loc_str(dst, ssa_reg(src), s); }
    if (dst >= 0) { return ssa_loc_ldr(src, ssa_reg(dst), s); }
    s = ssa_loc_ldr(src, "x5", s);
    return ssa_loc_str(dst, "x5", s);
}
// ssa_loc_ldr / ssa_loc_str copy a location into / out of a register.
function ssa_loc_ldr(loc: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
    if (loc >= 0) { return s.write("    mov " + reg + ", " + ssa_reg(loc) + "\n"); }
    return ssa_fr_ldr(s, reg, ssa_slot_off(ssa.spill_slot(loc)), 0);
}
function ssa_loc_str(loc: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
    if (loc >= 0) { return s.write("    mov " + ssa_reg(loc) + ", " + reg + "\n"); }
    return ssa_fr_str(s, reg, ssa_slot_off(ssa.spill_slot(loc)), 0);
}

function ssa_epilogue(): string {
    return "    .cfi_remember_state\n    mov sp, x29\n    ldp x29, x30, [sp], #16\n    .cfi_def_cfa sp, 0\n    ret\n    .cfi_restore_state\n";
}

// ssa_jump is the branch to block `to`, or nothing when `to` is the block
// emitted next and control falls into it.
function ssa_jump(lp: string, to: i32, next: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (to == next) { return s; }
    return s.write("    b " + lp + util.i32_to_string(to) + "\n");
}

// ssa_brif branches on a value, or on the flags a fused compare left (fu.n
// above 0), in which case the false edge is the compare's inverse; a fused
// `not` (fu.tag 0) is the value test with the edges swapped. An edge
// whose target has phis lands on a stub carrying that edge's moves, since
// the moves of the two edges differ.
function ssa_brif(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
    var t: ssa.STerm = blk.term;
    // A value test reads the value where it lives, through x4 only when spilled.
    var tv: i32 = t.cond;
    if (fu.n > 0) { tv = fu.a; }
    if (fu.n == 0) { s = ssa_read(reg_of, t.cond, "x4", s); }
    var tr: string = ssa_src(reg_of, tv, "x4");
    if (t.t == t.f) {
        s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
        return ssa_jump(lp, t.t, next, s);
    }
    var fl: string = lp + util.i32_to_string(t.f);
    var stub: boolean = ssa_has_phis(f, fr, t.f);
    if (stub) { fl = lp + "e" + util.i32_to_string(blk.id) + "_" + util.i32_to_string(t.f); }
    // When the false target is the next block and neither edge carries phi
    // moves, branch on the condition itself and fall through.
    if (!stub && t.f == next && !ssa_has_phis(f, fr, t.t)) {
        var tl: string = lp + util.i32_to_string(t.t);
        if (fu.n > 0 && fu.tag == 0) { return s.write("    cbz " + tr + ", " + tl + "\n"); }
        if (fu.n > 0) { return s.write("    b." + ir_cmp_cond(fu.tag, !fu.inverted) + " " + tl + "\n"); }
        return s.write("    cbnz " + tr + ", " + tl + "\n");
    }
    if (fu.n > 0 && fu.tag == 0) {
        s = s.write("    cbnz " + tr + ", " + fl + "\n");
    } else if (fu.n > 0) {
        s = s.write("    b." + ir_cmp_cond(fu.tag, fu.inverted) + " " + fl + "\n");
    } else {
        s = s.write("    cbz " + tr + ", " + fl + "\n");
    }
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
    if (stub) {
        s = s.write("    b " + lp + util.i32_to_string(t.t) + "\n");
        s = ssa_x0_forget(s);
        s = s.write(fl + ":\n");
        s = ssa_phi_moves(f, fr, reg_of, blk.id, t.f, s);
        return ssa_jump(lp, t.f, next, s);
    }
    return ssa_jump(lp, t.t, next, s);
}

// ssa_fused_test sets the flags a block's fused compare leaves for its branch
// (or brings a fused `not`'s operand into a register, for the value test).
// `join` names the label a fused uniqueness test's guards meet at.
function ssa_fused_test(fr: SsaFrame, reg_of: i32[], fu: SsaFuse, join: string, s: asmcore.EmitState): asmcore.EmitState {
    if (fu.n > 0 && fu.tag == 0) { return ssa_read(reg_of, fu.a, "x4", s); }
    if (fu.n == 0) { return s; }
    if (fu.unique) { return ssa_unique_flags(reg_of, fu.a, join, s); }
    s = ssa_read(reg_of, fu.a, "x4", s);
    s = ssa_read_rhs(fr, reg_of, fu.b, "x5", s);
    return s.write("    cmp " + ssa_src(reg_of, fu.a, "x4") + ", " + ssa_rhs(fr, reg_of, fu.b, "x5") + "\n");
}

// ssa_unique_flags is ssa_rc_prim's uniqueness test as flags: Z is set only
// when the count is exactly one. Each guard's early exit already leaves Z
// clear (a set tag bit; a pointer below, so unequal to, the floor), which is
// why the tag test is a tst rather than the tbnz that sets no flags.
function ssa_unique_flags(reg_of: i32[], v: i32, join: string, s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs("__fern_rc_is_unique", s);
    s = ssa_read(reg_of, v, "x4", s);
    var p: string = ssa_src(reg_of, v, "x4");
    s = s.write("    tst " + p + ", #1\n    b.ne " + join + "\n    cmp " + p + ", #16, lsl #12\n    b.lo " + join + "\n");
    s = s.write("    ldur w5, [" + p + ", #-8]\n" + san_poison_check("w5", "w7", join + "us") + "    cmp w5, #1\n" + join + ":\n");
    return s;
}

// ssa_rotates reports whether a branch from the block at position `from` to
// block `to` can re-run `to`'s test in place of jumping to it: `to` is at or
// before `from` (a back edge), holds nothing but phis and the test (and the
// immediates it reads), and
// neither of its successors has phis, so its branch carries no moves of its
// own. A loop then costs one branch per iteration rather than two.
function ssa_rotates(f: ssa.SFunc, fr: SsaFrame, from: i32, to: i32): boolean {
    var ti: i32 = ssa_block_at(fr, to);
    if (ti < 0 || ti > from) { return false; }
    var h: ssa.SBlock = f.blocks[ti];
    if (h.term.kind_tag != 3 || h.term.t == h.term.f) { return false; }
    if (ssa_has_phis(f, fr, h.term.t) || ssa_has_phis(f, fr, h.term.f)) { return false; }
    var n: i32 = 0;
    for ins in h.insts {
        // A constant the test reads as an immediate is never materialised.
        var imm: boolean = (ins.kind_tag == 1 || ins.kind_tag == 3) && fr.imm.is_imm[ins.result];
        if (ins.kind_tag != 8 && !imm) { n = n + 1; }
    }
    return n == ssa_fuse(fr, h).n;
}

function ssa_term(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag == 1) {
        s = ssa_load(reg_of, t.value, "x0", s);
        return s.write(fr.epilogue);
    }
    if (t.kind_tag == 2) {
        s = ssa_phi_moves(f, fr, reg_of, blk.id, t.target, s);
        if (ssa_rotates(f, fr, ssa_block_at(fr, blk.id), t.target)) {
            var h: ssa.SBlock = f.blocks[ssa_block_at(fr, t.target)];
            var hfu: SsaFuse = ssa_fuse(fr, h);
            return ssa_brif(f, fr, h, reg_of, lp, next, hfu, ssa_fused_test(fr, reg_of, hfu, ssa_join(lp, blk.id), s));
        }
        return ssa_jump(lp, t.target, next, s);
    }
    if (t.kind_tag == 3) { return ssa_brif(f, fr, blk, reg_of, lp, next, fu, s); }
    // A block the lift left unterminated is one nothing reaches; the stack
    // machine's fallback return keeps the text well formed here too.
    return s.write("    mov x0, #0\n" + fr.epilogue);
}

// ssa_load_params moves each parameter from the caller's slot to its home;
// value p is parameter p.
// The first ssa_nregs() parameters arrive in the pool's registers, in order
// (a stack caller's are loaded there by the entry shim); the rest stay in the
// caller's slots. The register moves go first, since a later parameter's home
// may be a register still holding an earlier one.
function ssa_load_params(f: ssa.SFunc, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ssa_reg_params(f);
    var srcs: i32[] = [];
    var dsts: i32[] = [];
    var p: i32 = 0;
    while (p < k) {
        if (reg_of[p] != 0 - 1) { srcs = srcs.append(p); dsts = dsts.append(reg_of[p]); }
        p = p + 1;
    }
    s = ssa_parallel_moves(srcs, dsts, s);
    while (p < f.nparams) {
        // Straight into the home, not through a scratch: x0 is an allocatable
        // home now, so staging every parameter through it overwrote whichever
        // parameter had been given it.
        var d: string = ssa_dst(reg_of, p);
        s = s.write("    ldr " + d + ", [x29, #" + util.i32_to_string(16 + p * 16) + "]\n");
        s = ssa_store(reg_of, p, d, s);
        p = p + 1;
    }
    return s;
}

// ssa_reg_params is how many of f's parameters arrive in registers.
function ssa_reg_params(f: ssa.SFunc): i32 {
    if (f.nparams < ssa_nregs()) { return f.nparams; }
    return ssa_nregs();
}

// ssa_entry_shim is a function's two entries. `__fn_<name>`, the stack-ABI
// entry every caller outside this unit's direct calls uses, loads the first
// ssa_reg_params() arguments from the caller's 16-byte stack slots into the
// pool registers and falls through into `__fn_<name>.r`, where a register-ABI
// caller enters with them already there. A function with no parameters has
// one entry.
function ssa_entry_shim(f: ssa.SFunc, name: string): string {
    var k: i32 = ssa_reg_params(f);
    if (k == 0) { return ""; }
    var out: string = "";
    var p: i32 = 0;
    while (p < k) {
        out = out + "    ldr " + ssa_reg(p) + ", [sp, #" + util.i32_to_string(16 * p) + "]\n";
        p = p + 1;
    }
    return out + "__fn_" + name + ".r:\n";
}

// ssa_reg_helper names the hand-written runtime helpers with a register
// entry, by argument count: their stack entry loads the arguments into the
// pool's first registers, which is where the `.r` entry reads them.
function ssa_reg_helper(sym: string, argc: i32): boolean {
    if (argc == 2) { return sym == "__fn___fern_str_eq"; }
    return argc == 1 && (sym == "__fn___fern_arr_dec" || sym == "__fn___fern_str_free" || sym == "__fn___fern_arr_inc_elems");
}

// ssa_reg_call reports whether a direct call passes its arguments in
// registers: the callee has a register entry in this unit and takes between
// one and ssa_nregs() arguments.
function ssa_reg_call(ins: ssa.SInst, s: asmcore.EmitState): boolean {
    var argc: i32 = ins.args.len();
    if (ins.kind_tag != 11 || argc == 0 || argc > ssa_nregs() || ssa.rc_inlined(ins)) { return false; }
    if (ircore.is_fern_helper(ins.str) || ircore.is_c_call(ins.str)) { return false; }
    return irlower.sig_reg_has_exact(s.reg_entries, asmcore.sanitize_label(ins.str));
}

// ssa_arg_prefs asks the allocator for the register each parameter arrives in
// and each register call's argument leaves in, so neither needs a move when
// the value has nowhere better to be.
function ssa_arg_prefs(f: ssa.SFunc, s: asmcore.EmitState): i32[] {
    var pref: i32[] = [];
    var i: i32 = 0;
    while (i < f.nvals) { pref = pref.append(0 - 1); i = i + 1; }
    var p: i32 = 0;
    while (p < ssa_reg_params(f)) { pref = pref.with(p, p); p = p + 1; }
    for blk in f.blocks {
        for ins in blk.insts {
            if (!ssa_reg_call(ins, s)) { continue; }
            var a: i32 = 0;
            while (a < ins.args.len()) {
                var v: i32 = ins.args[a];
                if (v >= 0 && v < pref.len() && pref[v] < 0) { pref = pref.with(v, a); }
                a = a + 1;
            }
        }
    }
    return pref;
}

// emit_ssa_function_arm64 emits one lifted function: the stack machine's frame
// record, the parameters loaded from the caller's slots into their homes, each
// block behind its label, and the literal pool the constants may have used.
// The lift gives every declared local a zero and every loop a phi per local,
// most of them never read; prune_dead takes those out before the allocator
// sees them.
function emit_ssa_function_arm64(lifted: ssa.SFunc, label_name: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    var f: ssa.SFunc = ssa.thread_forwarding(ssa.prune_dead(ssa.prune_trivial_phis(lifted)));
    var imm: ssa.Imms = ssa.imm_operands(f, 0i64, 4095i64, ssa_imm_right(), ssa_imm_left());
    var reg_of: i32[] = ssa.regalloc_linear(f, ssa_nregs(), ssa_nsaved(), 0, false, imm.is_imm, ssa_arg_prefs(f, s));
    var lp: string = ".Lssa_" + asmcore.sanitize_label(label_name) + "_";
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n    .cfi_startproc\n");
    s = s.write(ssa_entry_shim(f, asmcore.sanitize_label(label_name)));
    s = s.write("    stp x29, x30, [sp, #-16]!\n    .cfi_def_cfa_offset 16\n    .cfi_offset x29, -16\n    .cfi_offset x30, -8\n    mov x29, sp\n    .cfi_def_cfa_register x29\n");
    var saved: i32[] = ssa_saved_regs(reg_of);
    var save: i32 = ssa_save_bytes(saved);
    s = s.write(ssa_save_asm(saved));
    var views: i32[] = ssa_view_slots(f);
    var fr: SsaFrame = SsaFrame { nspill: ssa.spill_count(reg_of), views: views, blk_pos: ssa_block_index(f), uses: ssa.use_counts(f), nsave: save, epilogue: ssa_epilogue_for(saved), imm: imm };
    var frame: i32 = (fr.nspill + 3 * ssa_view_count(views)) * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = fr_sub_imm(s, "sp", "sp", frame); }
    s = asmcore.EmitState { ...s, ssa_frame: frame + save, ssa_save: save };
    s = ssa_load_params(f, reg_of, s);
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var blk: ssa.SBlock = f.blocks[bi];
        var next: i32 = 0 - 1;
        if (bi + 1 < f.blocks.len()) { next = f.blocks[bi + 1].id; }
        s = ssa_x0_forget(s);
        s = s.write(lp + util.i32_to_string(blk.id) + ":\n");
        var fu: SsaFuse = ssa_fuse(fr, blk);
        var ii: i32 = 0;
        while (ii < blk.insts.len() - fu.n) {
            var ins: ssa.SInst = blk.insts[ii];
            if (ins.kind_tag != 6 && ins.kind_tag != 8) { s = ssa_inst(ins, reg_of, fr, lp, r, s); }
            ii = ii + 1;
        }
        s = ssa_fused_test(fr, reg_of, fu, ssa_join(lp, blk.id), s);
        s = ssa_term(f, fr, blk, reg_of, lp, next, fu, s);
        bi = bi + 1;
    }
    s = asmcore.EmitState { ...s, ssa_frame: 0, ssa_save: 0 };
    return s.write("    .cfi_endproc\n    .ltorg\n");
}

// emit_ssa_function emits one lowered function through the register path,
// which is the only emitter: a function the lift or the emitter cannot take
// is refused naming the op (ircore.ssa_refuse). Every op the lowering
// produces has an arm, so a refusal here is a compiler bug, not a program
// the backend does not cover.
function emit_ssa_function(r: irlower.LowerResult, label_name: string, s: asmcore.EmitState): asmcore.EmitState {
    var t_lift: i64 = monotonic_ns();
    var lifted: ssa_lift.LResult = ssa_lift.lift_from_ir_prod(label_name, r.n_params, r.n_locals, r.ops);
    var why: string = lifted.bail;
    if (lifted.ok) {
        var collision: i32 = ssa.repeated_block_id(lifted.func);
        if (collision >= 0) { ircore.ssa_block_id_collision(label_name, collision); }
        why = ssa_unsupported(lifted.func);
    }
    if (why != "") { ircore.ssa_refuse(label_name, why); }
    var lift_ms: i64 = (monotonic_ns() - t_lift) / 1000000i64;
    var t_emit: i64 = monotonic_ns();
    s = emit_ssa_function_arm64(ssa.inline_leaves(lifted.func, s.leaves), label_name, r, s);
    // Under the report, a function whose lift or emit took over 200 ms is
    // named with both times: the whole-compiler build is where a phase's
    // cost shows, and this is how a slow one is found.
    var emit_ms: i64 = (monotonic_ns() - t_emit) / 1000000i64;
    if (ircore.ssa_report_on() && lift_ms + emit_ms > 200i64) {
        eprint("FERN_SSA: time " + label_name + ": lift " + util.i32_to_string((lift_ms as i32)) + " ms, emit " + util.i32_to_string((emit_ms as i32)) + " ms, " + util.i32_to_string(r.ops.len()) + " ops, " + util.i32_to_string(r.n_locals) + " slots\n");
    }
    return s;
}

// emit_function_via_ir lowers one function to the stack IR and emits it
// through the register path, as arm64: x29 frame pointer, params read from
// the caller's rt-stack at [x29, #16+i*16], the result in x0.
pub function emit_function_via_ir(fd: parser.FuncDecl, s: asmcore.EmitState, sg: irlower.FnSigs, vsigs: irverify.NameIndex): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, s.struct_decls, sg, false);
    return emit_function_via_ir_pre(r, fd, s, vsigs);
}

// emit_function_via_ir_pre is the emit half of emit_function_via_ir, split at
// the lower_func boundary (the x86 twin is asm_ir.emit_function_via_ir_pre) so
// the fused gate+emit path emits from the LowerResult it already judged.
pub function emit_function_via_ir_pre(r: irlower.LowerResult, fd: parser.FuncDecl, s: asmcore.EmitState, vsigs: irverify.NameIndex): asmcore.EmitState {
    // Methods get the receiver-type-qualified label `__fn_<Type>.<name>`.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { label_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    return emit_function_via_ir_named(r, label_name, false, s, vsigs);
}

// emit_function_via_ir_named is the body above with the label supplied rather
// than read from a declaration, so a body the semantic pipeline produced — which
// carries its own name — emits through the same path. The x86 twin is
// asm_ir.emit_function_via_ir_named.
pub function emit_function_via_ir_named(r: irlower.LowerResult, label_name: string, weak: boolean, s: asmcore.EmitState, vsigs: irverify.NameIndex): asmcore.EmitState {
    if (weak) { s = s.write(".weak __fn_" + asmcore.sanitize_label(label_name) + "\n"); }
    ircore.lower_failed_refuse(label_name, r);
    irverifygate.verify_or_refuse(label_name, r.ops, r.n_params, r.n_locals, vsigs);
    return emit_ssa_function(r, label_name, s);
}

// emit_stack_op emits one op on the machine stack, as asm_ir.fern's does:
// operands popped, the result pushed. The register path runs it, between a
// push of the operands and a pop of the result (ssa_flat_op), for every op
// the lift has no instruction of its own; an op the lift lowers itself has
// no arm here.
// fern-lint: allow cyclomatic-complexity
// The arm64 half of the same op table as asm_ir.fern, one guard per op.
function emit_stack_op(o: ir.Op, i: i32, lp: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 79) {  // ptr_width
        // () -> heap-pointer width in bytes. 8 on arm64.
        s = s.write("    mov x0, #8\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 74) {  // memcpy
        s = emit_arm64_op_memcpy(o, i, lp, s);
    } else if (o.kind_tag == 75) {  // memset
        s = emit_arm64_op_memset(i, lp, s);
    } else if (o.kind_tag == 78) {  // free
        // [ptr, size] -> return the raw block to its size class; push dummy 0.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_raw_free\n    mov x0, #0\n    str x0, [sp, #-16]!\n");
        s = s.need("heap");
    } else if (o.kind_tag == 91) {  // arr_rc
        // pop base; 32-bit refcount field at [data-8] (ldur — unscaled neg).
        s = s.write("    ldr x0, [sp], #16\n    ldur w0, [x0, #-8]\n    str x0, [sp, #-16]!\n");
    } else if (ir.is_str_op_kind(o.kind_tag)) {
        // All string operand-stack ops (len/index/slice/bytes/split/
        // predicates/concat/eq/cmp) are emitted by emit_str_op — factored out
        // to keep this dispatch under the oversized-function threshold (#2720).
        s = emit_str_op(o, s);
    } else if (o.kind_tag == 185) {  // random_bytes
        // [n] IS param[0]; call the Fern-compiled __fn___fern_random_bytes
        // (asmcore.rt_src_random_bytes, #2649) via the stack ABI, mirroring
        // asm_ir's handler. The body fills a scratch buffer through the
        // __syscall3 sub-floor and spreads the bytes into a fresh u8[] box
        // (__raw_arr_box — so the result carries the rc header
        // __fern_arr_box writes).
        s = s.mark_heap();
        s = s.need("random_bytes");
        s = s.write("    bl __fn___fern_random_bytes\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 186) {  // random_i32
        // no operands; the Fern-compiled __fn___fern_random_i32() -> i32 in
        // x0. Zero args, so the stack ABI needs no push and no cleanup.
        s = s.need("random_i32");
        s = s.write("    bl __fn___fern_random_i32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 211) {  // proc_fork
        // no operands; __fern_proc_fork() -> i32 in x0 (0 child / pid parent
        // / -errno). Helper gated by the need, like random_i32 (#5686).
        s = s.need("proc_fork");
        s = s.write("    bl __fn___fern_proc_fork\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 212) {  // proc_waitpid
        // [pid] IS param[0] already; the stack ABI needs no marshalling.
        s = s.need("proc_waitpid");
        s = s.write("    bl __fn___fern_proc_waitpid\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 286) {  // proc_waitpid_nohang
        // [pid] -> __fern_proc_waitpid_nohang(x0 = pid) -> the decoded
        // status, -1 when the child is still running, or -errno.
        s = s.need("proc_waitpid_nohang");
        s = s.write("    bl __fn___fern_proc_waitpid_nohang\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 213) {  // proc_exec
        // [pathbox, argsbox] -> __fern_proc_exec(path, args). Only returns
        // on failure (-errno), so the push is that value.
        s = s.need("heap"); s = s.need("proc_exec");
        // args is on top but param[0] is path, so swap before the call.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_proc_exec\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 280) {  // proc_exec_as
        // [pathbox, argvbox, envpbox] -> __fern_proc_exec_as(path, argv,
        // envp), envp on top. Only returns on failure (-errno). No `env`
        // need: the environment is an operand, not __raw_environ().
        s = s.need("heap"); s = s.need("proc_exec_as");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_proc_exec_as\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 80) {  // heap_bump_bytes
        s = emit_arm64_op_heap_bump_bytes(o, s);
    } else if (o.kind_tag == 315) {  // heap_alloc_count
        s = emit_arm64_op_heap_alloc_count(o, s);
    } else if (o.kind_tag == 229) {  // heap_mark
        // The arena checkpoint: the cursor, plus a snapshot of BOTH freelist
        // head tables into their .bss shadows. Snapshotted rather than
        // cleared — a block allocated AND freed inside the window leaves a
        // head above the mark, which a later pop and a later bump would both
        // hand out; restoring the pre-mark heads drops exactly those and
        // keeps the older entries reusable. One live mark at a time (the
        // shadow is a single buffer, so marks do not nest). x9-x12 are AAPCS
        // scratch and dead here — the operand stack lives on sp.
        s = s.mark_heap();
        s = s.write("    adrp x0, __fern_heap_ptr\n    add x0, x0, :lo12:__fern_heap_ptr\n    ldr x0, [x0]\n");
        s = arm64_copy_words(s, "__fern_freelist", "__fern_freelist_shadow", 65536);
        s = arm64_copy_words(s, "__fern_large_freelist", "__fern_large_freelist_shadow", 2560);
        s = s.write("    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 230) {  // heap_release_to
        s = emit_arm64_op_heap_release_to(o, s);
    } else if (o.kind_tag == 183) {  // now_ns
        // no operands; __fn___fern_now_ns() -> i64 in x0, the nanosecond
        // twin of now_unix_ms. Fern on every native target.
        s = s.need("now_ns");
        s = s.write("    bl __fn___fern_now_ns\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 187) {  // poll
        // operand stack [fds, timeout]; pop timeout (x1, top) then fds box
        // ptr (x0), call __fern_poll (ppoll(2) over the fd set) -> i32 ready
        // index (or -1) in x0. Gated helper in asm_arm64.emit_runtime.
        // timeout is on top but param[0] is fds, so swap before the call.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_poll\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("poll");
    } else if (o.kind_tag == 188) {  // timer_fd
        // [ms] -> __fern_timer_fd(x0=ms) -> CLOCK_MONOTONIC timerfd fd in x0.
        s = s.write("    bl __fn___fern_timer_fd\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        s = s.need("timer_fd");
    } else if (o.kind_tag == 312) {  // termios_get
        // [fd] -> __fern_termios_get(x0=fd) -> Result[i64[], IoError].
        // The runtime body appends to an i64[], so the array push it
        // lowers to has to be emitted too.
        s = s.need("heap"); s = s.need("termios_get"); s = s.need("arr_push_owned");
        s = s.write("    bl __fn___fern_termios_get\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 313) {  // termios_set
        // [fd][when][words] with the words on top; param[0] (fd) has to be
        // LOWEST, so the three are popped and re-pushed reversed, as
        // proc_exec_as is. Without it the fd arrives where the array
        // belongs and reading its length faults.
        s = s.need("heap"); s = s.need("termios_set");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_termios_set\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 314) {  // set_window_size
        // [fd][rows][cols] with cols on top; the same three-operand
        // marshalling termios_set needs — param[0] (fd) LOWEST.
        s = s.need("heap"); s = s.need("set_window_size");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_set_window_size\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 276) {  // window_size
        // [fd] -> __fern_window_size(x0=fd) -> Result[WinSize, IoError].
        s = s.need("heap"); s = s.need("window_size");
        s = s.write("    bl __fn___fern_window_size\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 232) {  // isatty
        // [fd] -> __fern_isatty(x0=fd) -> 1 when fd is a terminal, else 0.
        s = s.write("    bl __fn___fern_isatty\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        s = s.need("isatty");
    } else if (o.kind_tag == 271) {  // process_alive
        // [pid] -> __fern_process_alive(x0=pid) -> 1 when a process with
        // that pid exists, else 0.
        s = s.write("    bl __fn___fern_process_alive\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        s = s.need("process_alive");
    } else if (o.kind_tag == 285) {  // signal_send
        // [pid][sig] (sig on top) -> Result[void, IoError]. Two operands
        // in param order but on the wrong end of the stack, so pop both
        // and re-push with param[0] (pid) on top.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_signal_send\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("signal_send");
    } else if (o.kind_tag == 284) {  // set_process_group
        // [pid][pgid] (pgid on top) -> Result[void, IoError]. The same
        // two-operand marshalling signal_send needs: pop both and
        // re-push with param[0] (pid) on top.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_set_process_group\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("set_process_group");
    } else if (o.kind_tag == 282) {  // priority
        // no args -> __fern_priority() -> this process's nice value in x0.
        // Nothing is boxed, so no heap need.
        s = s.write("    bl __fn___fern_priority\n    str x0, [sp, #-16]!\n");
        s = s.need("priority");
    } else if (o.kind_tag == 283) {  // set_priority
        // [nice] IS param[0] -> Result[void, IoError].
        s = s.write("    bl __fn___fern_set_priority\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("set_priority");
    } else if (o.kind_tag == 272) {  // rlimit_nofile
        // no args -> __fern_rlimit_nofile() -> the soft RLIMIT_NOFILE as a
        // full-width i64 in x0.
        s = s.write("    bl __fn___fern_rlimit_nofile\n    str x0, [sp, #-16]!\n");
        s = s.need("rlimit_nofile");
    } else if (o.kind_tag == 243 || o.kind_tag == 244) {  // signal_ignore / signal_default
        // [sig] -> __fern_signal_{ignore,default}(x0=sig) -> the sigaction
        // return, pushed so the statement-level drop balances.
        var sig_fn: string = "signal_ignore";
        if (o.kind_tag == 244) { sig_fn = "signal_default"; }
        s = s.write("    bl __fn___fern_" + sig_fn + "\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        s = s.need(sig_fn);
    } else if (o.kind_tag == 237) {  // access
        // [pathbox][mode] -> Result[void, IoError]. The stack ABI wants
        // param[0] on top, so re-push the popped pair in reverse — the
        // same shuffle write_file does.
        s = s.need("heap"); s = s.need("access");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_access\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 240) {  // hostname
        // no args -> __fn___fern_hostname: the node name in ONE fresh
        // rc-headered string box, pushed in x0.
        s = s.write("    bl __fn___fern_hostname\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("hostname");
    } else if (o.kind_tag == 250) {  // uname_field
        // [index] -> __fn___fern_uname_field: one utsname field in ONE
        // fresh rc-headered string box, pushed in x0.
        s = s.write("    bl __fn___fern_uname_field\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("uname_field");
    } else if (o.kind_tag == 251) {  // getcwd
        s = s.write("    bl __fn___fern_getcwd\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("getcwd");
    } else if (o.kind_tag == 252) {  // cpu_count
        s = s.write("    bl __fn___fern_cpu_count\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("cpu_count");
    } else if (o.kind_tag == 238) {  // geteuid
        s = s.write("    bl __fn___fern_geteuid\n    str x0, [sp, #-16]!\n");
        s = s.need("geteuid");
    } else if (o.kind_tag == 239) {  // getegid
        s = s.write("    bl __fn___fern_getegid\n    str x0, [sp, #-16]!\n");
        s = s.need("getegid");
    } else if (o.kind_tag == 246) {  // getuid
        s = s.write("    bl __fn___fern_getuid\n    str x0, [sp, #-16]!\n");
        s = s.need("getuid");
    } else if (o.kind_tag == 247) {  // getgid
        s = s.write("    bl __fn___fern_getgid\n    str x0, [sp, #-16]!\n");
        s = s.need("getgid");
    } else if (o.kind_tag == 248) {  // getgroups
        // no args -> __fn___fern_getgroups: a fresh i64[] of the
        // supplementary group set, pushed in x0.
        s = s.write("    bl __fn___fern_getgroups\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("getgroups");
    } else if (o.kind_tag == 249) {  // environ
        // no args -> __fn___fern_environ: a fresh string[] of the whole
        // environment, read off the same __fern_envp global env walks.
        s = s.write("    bl __fn___fern_environ\n    str x0, [sp, #-16]!\n");
        s = s.need("heap"); s = s.need("environ");
    } else if (o.kind_tag == 189) {  // wasm_timer_pollable
        // [ns] -> __fern_wasm_timer_pollable(x0=ns) -> -1 (native shim) in x0.
        s = s.write("    ldr x0, [sp], #16\n    bl __fern_wasm_timer_pollable\n    str x0, [sp, #-16]!\n");
        s = s.need("wasm_timer_pollable");
    } else if (o.kind_tag == 190) {  // wasm_pollable_drop
        // [p] -> __fern_wasm_pollable_drop(x0=p) -> 0 (native shim) in x0.
        s = s.write("    ldr x0, [sp], #16\n    bl __fern_wasm_pollable_drop\n    str x0, [sp, #-16]!\n");
        s = s.need("wasm_pollable_drop");
    } else if (o.kind_tag == 191) {  // wasm_block
        // [p] -> __fern_wasm_block(x0=p) -> 0 (native shim; no pollable to wait
        // on, a deadline uses poll(2)) in x0.
        s = s.write("    ldr x0, [sp], #16\n    bl __fern_wasm_block\n    str x0, [sp, #-16]!\n");
        s = s.need("wasm_block");
    } else if (o.kind_tag == 192) {  // wasm_poll
        // [pollables ptr] -> __fern_wasm_poll(x0=ptr) -> -1 (native shim; no
        // real pollables, readiness uses poll(2)) in x0.
        s = s.write("    ldr x0, [sp], #16\n    bl __fern_wasm_poll\n    str x0, [sp, #-16]!\n");
        s = s.need("wasm_poll");
    } else if (o.kind_tag == 193) {  // tcp_connect
        // [host_be, port] -> __fern_tcp_connect(x0=host_be, x1=port) -> fd.
        s = s.need("heap");
        // port is on top but param[0] is host_be, so swap before the call.
        s = s.need("tcp_connect");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_tcp_connect\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 114) {  // tcp_send
        // [fd, str box] -> __fern_tcp_send(fd, s) -> bytes / -errno. No
        // allocation any more (the helper writes out of the string's own
        // buffer), so this needs the helper and not the heap runtime.
        s = s.need("tcp_send");
        // the box is on top but param[0] is fd, so swap before the call.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_tcp_send\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 208) {  // udp_send
        // [host, port, data] with data on top; the stack ABI wants param[0]
        // (host) lowest, so pop and re-push reversed. Before #6917 this op had
        // no case at all: the op fell through to the comment fallback, which
        // dropped the call, while a hand-written body was emitted that nothing
        // ever branched to.
        s = s.need("udp_send");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_udp_send\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 115) {  // tcp_recv
        // [fd, max] -> __fern_tcp_recv(fd, max) -> fresh u8[] box (#5714).
        // Allocates (calls __fern_alloc), so the heap runtime must be present.
        s = s.need("heap");
        s = s.need("tcp_recv");
        // max is on top but param[0] is fd, so swap before the call.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_tcp_recv\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 116) {  // tcp_close
        // [fd] IS param[0] already, so the stack ABI needs no marshalling.
        // -> 0 / -errno. The need is marked (as x86-64 always did) because
        // the Fern helper is emitted need-gated, outside emit_rt_net.
        s = s.need("heap");
        s = s.need("tcp_close");
        s = s.write("    bl __fn___fern_tcp_close\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 112) {  // tcp_pollable
        // [fd] -> __fern_tcp_pollable(x0=fd) -> fd (native identity).
        s = s.need("heap");
        s = s.write("    ldr x0, [sp], #16\n    bl __fern_tcp_pollable\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 200) {  // tcp_listen (#4371)
        // [port] -> __fern_tcp_listen(x0=port) -> listener fd / -errno.
        s = s.need("heap");
        s = s.need("tcp_listen");
        s = s.write("    bl __fn___fern_tcp_listen\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 201) {  // tcp_accept (#4371)
        // [listener fd] IS param[0] already. -> connection fd / -errno.
        s = s.need("heap");
        s = s.need("tcp_accept");
        s = s.write("    bl __fn___fern_tcp_accept\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 320) {  // tcp_local_port
        // [fd] IS param[0] already. -> the bound port / -errno. No "heap"
        // need, unlike the socket arms above: the helper is emitted from
        // emit_rt_collections_and_proc, which runs whether or not the heap
        // block does, and the __fern_scratch it writes into has its own
        // gate. Marking heap would hand a program whose only socket call is
        // this one the whole arena/rc/fs bundle — x86-64 marks nothing here.
        s = s.need("tcp_local_port");
        s = s.write("    bl __fn___fern_tcp_local_port\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 308) {  // write_some (#9231)
        // [fd, str box], marshalled exactly as writer_write's are, into
        // __fn___fern_writer_write_some(fd, s) -> a fresh
        // Result[i64, IoError]. Body in the fs bundle below.
        s = s.need("heap"); s = s.need("write_some");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_writer_write_some\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 203) {  // open_file (#4372)
        // [path box] -> __fern_open_res(x0=path, x1=flags(imm), x2=mode) -> a
        // fresh Result[Reader|Writer, IoError] box. Body emitted in the fs
        // bundle below, gated on open_file.
        //
        // 0600 for the EXCLUSIVE opener, 0666 for the rest — see the
        // x86-64 emitter for why. 193 is the canonical x86-64 flag word
        // the helper translates per target.
        s = s.need("heap"); s = s.need("open_file");
        var open_mode: i32 = 438;
        if (o.i32_imm == 193) { open_mode = 384; }
        s = s.write("    ldr x0, [sp], #16\n    mov x1, #" + util.i32_to_string(o.i32_imm) + "\n    mov x2, #" + util.i32_to_string(open_mode) + "\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_open_res\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 304 || o.kind_tag == 305) {  // open_reader_with / open_writer_with
        // [path box, flags] -> __fern_open_with(x0=path, x1=flags, x2=write)
        // -> a fresh Result[Reader|Writer, IoError] box, through open_res.
        s = s.need("heap"); s = s.need("open_file"); s = s.need("open_with");
        var open_write: i32 = 0;
        if (o.kind_tag == 305) { open_write = 1; }
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    mov x2, #" + util.i32_to_string(open_write) + "\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_open_with\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 161 || o.kind_tag == 162) {  // print_int, print_i64
        // [n] IS param[0]; call the Fern-compiled __fn___fern_print_int (#2649)
        // via the stack ABI. Push x0 (the write return) so the statement-level
        // drop balances.
        //
        // Both ops route here: the helper takes an i64, and an i32 reaches the
        // stack slot already sign-extended. print_i64 had no case at all before,
        // so `print_int` on an i64 emitted an unsupported-op comment and printed
        // nothing.
        s = s.need("print_int");
        s = s.write("    bl __fn___fern_print_int\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 167) {  // read_int
        // no args -> call the Fern-compiled __fn___fern_read_int (#2649) and
        // push x0 (the value). A zero-arg helper's stack and register
        // conventions coincide, so there is nothing to marshal.
        s = s.need("read_int");
        s = s.write("    bl __fn___fern_read_int\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 209) {  // read_all_stdin
        // no args -> call the Fern-compiled __fn___fern_read_all_stdin (#2649):
        // fd 0 to EOF in ONE fresh rc-headered string box, pushed in x0. The
        // _rc name is gone with the AST body it was distinguished from.
        s = s.need("heap"); s = s.need("read_all_stdin");
        s = s.write("    bl __fn___fern_read_all_stdin\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 260) {  // create_dir
        // [pathbox][mode] -> Result[void, IoError]. The same
        // two-operand shuffle `access` does: the stack ABI wants
        // param[0] on top, so re-push the popped pair in reverse.
        s = s.need("heap"); s = s.need("create_dir");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_create_dir\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 261) {  // remove_dir
        // [pathbox] IS param[0] — one rmdir(2), ENOTEMPTY included.
        s = s.need("heap"); s = s.need("remove_dir");
        s = s.write("    bl __fn___fern_remove_dir\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 277) {  // chdir
        // [pathbox] IS param[0] — one chdir(2).
        s = s.need("heap"); s = s.need("chdir");
        s = s.write("    bl __fn___fern_chdir\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 316) {  // chroot
        // [pathbox] IS param[0] — one chroot(2), same shape.
        s = s.need("heap"); s = s.need("chroot");
        s = s.write("    bl __fn___fern_chroot\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 317) {  // setuid
        // [id] IS param[0]; the helper range-checks before the syscall.
        s = s.need("heap"); s = s.need("setuid");
        s = s.write("    bl __fn___fern_setuid\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 318) {  // setgid
        s = s.need("heap"); s = s.need("setgid");
        s = s.write("    bl __fn___fern_setgid\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 319) {  // setgroups
        // [gidsbox] IS param[0]; the helper packs it to 32-bit gids.
        s = s.need("heap"); s = s.need("setgroups");
        s = s.write("    bl __fn___fern_setgroups\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 278) {  // signal_mask
        // [how][mask] with mask on top; param[0] is how, so swap.
        s = s.need("signal_mask");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_signal_mask\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 279) {  // signal_disposition
        // [sig] IS param[0]; the stack ABI needs no marshalling.
        s = s.need("signal_disposition");
        s = s.write("    bl __fn___fern_signal_disposition\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 262) {  // create_link
        // [targetbox][pathbox] -> Result[void, IoError].
        s = s.need("heap"); s = s.need("create_link");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_create_link\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 267) {  // rename
        // [oldbox][newbox] -> Result[void, IoError].
        s = s.need("heap"); s = s.need("rename");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_rename\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 263) {  // create_symlink
        s = s.need("heap"); s = s.need("create_symlink");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_create_symlink\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 264) {  // read_link
        // [pathbox] IS param[0] — pushes a fresh Result[string, IoError]
        // holding the link's target.
        s = s.need("heap"); s = s.need("read_link");
        s = s.write("    bl __fn___fern_read_link\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 268) {  // chmod
        // [pathbox][mode] (mode on top) -> Result[void, IoError]. The
        // operands are in param order but on the wrong end of the stack,
        // so pop both and re-push with param[0] (path) on top.
        s = s.need("heap"); s = s.need("chmod");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_chmod\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 274) {  // mknod
        // [pathbox][mode][major][minor] (minor on top) ->
        // Result[void, IoError]. Same reversal as chmod, over four.
        s = s.need("heap"); s = s.need("mknod");
        s = s.write("    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x3, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_mknod\n    add sp, sp, #64\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 275) {  // chown_at
        // [pathbox][uid][gid][follow] (follow on top) -> Result[void,
        // IoError]. Same reversal as mknod's, over the same four slots.
        s = s.need("heap"); s = s.need("chown_at");
        s = s.write("    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x3, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_chown_at\n    add sp, sp, #64\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 321) {  // chmod_at
        // [pathbox][mode][follow] (follow on top) -> Result[void,
        // IoError]. Three operands, reversed the way set_window_size's
        // are: param[0] (path) lowest.
        s = s.need("heap"); s = s.need("chmod_at");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_chmod_at\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 273) {  // truncate
        // [pathbox][length] (length on top) -> Result[void, IoError].
        // Same reversal as chmod; the length is a full 64-bit word.
        s = s.need("heap"); s = s.need("truncate");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_truncate\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 269) {  // set_file_times
        // [pathbox][asec][ansec][msec][mnsec][flags] (flags on top) ->
        // Result[void, IoError]. Six operands, reversed the same way.
        s = s.need("heap"); s = s.need("set_file_times");
        s = s.write("    ldr x5, [sp], #16\n    ldr x4, [sp], #16\n    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x5, [sp, #-16]!\n    str x4, [sp, #-16]!\n    str x3, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_set_file_times\n    add sp, sp, #96\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 265) {  // umask
        // [mask] IS param[0] — one syscall, the previous mask in x0.
        // Nothing is boxed, so no heap need.
        s = s.need("umask");
        s = s.write("    bl __fn___fern_umask\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 270) {  // statfs
        // [pathbox] IS param[0]; same stack ABI as stat, pushing a fresh
        // Result[FsStat, IoError] whose shape label is pre-interned below.
        s = s.need("heap"); s = s.need("statfs");
        s = s.write("    bl __fn___fern_statfs\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 299) {  // fd_fsync
        // [fd] IS param[0]; __fn___fern_fd_fsync pushes a fresh
        // Option[IoError], None once the write-back is scheduled.
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_fsync");
        s = s.write("    bl __fn___fern_fd_fsync\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 300) {  // fd_fdatasync
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_fdatasync");
        s = s.write("    bl __fn___fern_fd_fdatasync\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 301) {  // fd_syncfs
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_syncfs");
        s = s.write("    bl __fn___fern_fd_syncfs\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 298) {  // sync
        // No operands. sync(2) cannot fail, but its return is pushed for
        // the statement-position drop, as sleep_ns's is.
        s = s.need("sync");
        s = s.write("    bl __fn___fern_sync\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 241) {  // fd_stat
        // [fd] IS param[0]; the Fern-compiled __fn___fern_fd_stat pushes a
        // fresh Result[FileStat, IoError].
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_stat");
        s = s.write("    bl __fn___fern_fd_stat\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 311) {  // fd_dup_onto
        // [fd][newfd] -> Option[IoError]. newfd is on top but param[0] is
        // fd, so swap before the call, as writer_truncate does.
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_dup_onto");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_fd_dup_onto\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 307) {  // fd_flags
        // [fd] IS param[0], like fd_stat; __fn___fern_fd_flags pushes a
        // fresh Result[i64, IoError].
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_flags");
        s = s.write("    bl __fn___fern_fd_flags\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 242) {  // reader_seek
        // [fd][offset][whence] (whence on top) -> Result[i64, IoError]:
        // pop all three and re-push with param[0] (fd) on top, as
        // subprocess does.
        s = s.need("heap"); s = s.need("reader"); s = s.need("reader_seek");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_reader_seek\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 330) {  // reader_splice
        // [fd][out_fd][max] (max on top) -> Result[i64, IoError], re-pushed
        // with param[0] (fd) on top as reader_seek is.
        s = s.need("heap"); s = s.need("reader"); s = s.need("reader_splice");
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_reader_splice\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 281) {  // writer_truncate
        // [fd][length] -> Option[IoError]. The length is on top but
        // param[0] is fd, so swap before the call, as writer_write does.
        s = s.need("heap"); s = s.need("reader"); s = s.need("writer_truncate");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_writer_truncate\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    } else if ((o.kind_tag >= 291 && o.kind_tag <= 297) || o.kind_tag == 306 || o.kind_tag == 325 || o.kind_tag == 326 || o.kind_tag == 328) {  // the buf_* builder
        s = emit_arm64_op_buf(o, s);
    } else if (o.kind_tag == 181) {  // sleep_ms
        // [ms] -> nanosleep(ms). Push x0 for the drop.
        s = s.need("sleep_ms");
        s = s.write("    bl __fn___fern_sleep_ms\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 266) {  // sleep_ns
        // [ns] -> the same pause at full resolution. Same stack ABI as
        // sleep_ms — one word in, x0 pushed for the drop.
        s = s.need("sleep_ns");
        s = s.write("    bl __fn___fern_sleep_ns\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag >= 125 && o.kind_tag <= 137) {  // the map ops
        s = emit_arm64_op_map(o, i, lp, s);
    } else if (o.kind_tag == 146) {  // dyn_box
        s = emit_arm64_op_dyn_box(o, s);
    } else if (o.kind_tag == 148) {  // dyn_downcast
        s = emit_arm64_op_dyn_downcast(o, i, lp, s);
    } else {
        ircore.flat_arm_missing(o);
    }
    return s;
}

// emit_arm64_op_memset: [dst, byte, n] -> fill n bytes at dst with byte's low
// byte (byte loop), push dummy 0. n on top (x2), then byte (x1), then dst (x0).
function emit_arm64_op_memset(i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write(lp + "ms" + util.i32_to_string(i) + ":\n");
    s = s.write("    cbz x2, " + lp + "msd" + util.i32_to_string(i) + "\n");
    s = s.write("    strb w1, [x0], #1\n    sub x2, x2, #1\n");
    s = s.write("    b " + lp + "ms" + util.i32_to_string(i) + "\n");
    s = s.write(lp + "msd" + util.i32_to_string(i) + ":\n");
    return s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");
}

// ssa_dyn_dispatch runs the dyn dispatch chain on the register path, each
// argument read from its home: a register, or its spill slot at its
// x29-relative offset, which the arms' pushes do not move. x0 is the chain's
// own scratch, so a value living there moves to x4 first; the allocator
// counts the instruction as a call, so nothing live across it is in a
// caller-saved register.
function ssa_dyn_dispatch(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var args: asmcore.DynArg[] = [];
    var moved: boolean = false;
    for v in ins.args {
        if (reg_of[v] >= 0) {
            var home: string = ssa_reg(reg_of[v]);
            if (home == "x0") {
                if (!moved) { s = s.write("    mov x4, x0\n"); moved = true; }
                home = "x4";
            }
            args = args.append(asmcore.DynArg { reg: home, off: 0 });
        } else {
            args = args.append(asmcore.DynArg { reg: "", off: ssa_slot_off(ssa.spill_slot(reg_of[v])) - s.ssa_save });
        }
    }
    s = emit_dyn_dispatch_chain(ins.str, args, ins.imm, lp, s);
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// ssa_flat_op runs the stack machine's own arm for op `o` (the byte kernels,
// the map ops, the byte-buffer builder) between a push of the operands and a
// pop of the result. The allocator treats the op as a call, so the arm's
// registers hold nothing live; its labels take the op's index under the SSA
// function's prefix.
function ssa_flat_op(ins: ssa.SInst, reg_of: i32[], lp: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    if (asmcore.buf_helper(r.ops[ins.imm].kind_tag) != "") { return ssa_buf_call(ins, reg_of, asmcore.buf_helper(r.ops[ins.imm].kind_tag), s); }
    s = ssa_x0_forget(s);
    var outer: usize = s.capture;
    var h: usize = buf_new(256);
    s = emit_stack_op(r.ops[ins.imm], ins.imm, lp, r, asmcore.EmitState { ...s, capture: h });
    var arm: string = buf_take(h);
    s = asmcore.EmitState { ...s, capture: outer };
    var pops: string[] = ssa_leading_pops(arm, ins.args.len());
    if (!ssa_pops_ordered(ins, reg_of, pops)) { pops = []; }
    var stacked: i32 = ins.args.len() - pops.len();
    var i: i32 = 0;
    while (i < stacked) {
        s = ssa_push_operand(reg_of, ins.args[i], i * 16, s);
        i = i + 1;
    }
    for k in ssa_pop_order(ins, reg_of, pops) {
        s = ssa_load_pushed(reg_of, ins.args[ins.args.len() - 1 - k], pops[k], stacked * 16, s);
    }
    var body: string = slice_unchecked(arm, ssa_pops_len(pops), arm.len()) + "";
    var result: string = ssa_trailing_push(body);
    if (result != "") {
        s = s.write(slice_unchecked(body, 0, body.len() - ssa_push_line(result).len()) + "");
        return ssa_store(reg_of, ins.result, result, ssa_x0_forget(s));
    }
    s = s.write(body + "    ldr x0, [sp], #16\n");
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

// An arm starts by popping its operands, the last operand first. The register
// path loads those operands into the registers the pops name instead, and
// runs the rest of the arm; operands the arm does not pop that way are pushed
// as before, beneath where the pops would have read.
function ssa_pop_line(reg: string): string { return "    ldr " + reg + ", [sp], #16\n"; }
function ssa_push_line(reg: string): string { return "    str " + reg + ", [sp, #-16]!\n"; }

function ssa_pops_len(pops: string[]): i32 {
    var n: i32 = 0;
    for p in pops { n = n + ssa_pop_line(p).len(); }
    return n;
}

// ssa_leading_pops lists the registers the arm's first lines pop into, at
// most `limit` of them.
function ssa_leading_pops(arm: string, limit: i32): string[] {
    var out: string[] = [];
    var at: i32 = 0;
    while (out.len() < limit) {
        var reg: string = ssa_line_reg(arm, at, "    ldr x", ", [sp], #16\n");
        if (reg == "") { return out; }
        out = out.append(reg);
        at = at + ssa_pop_line(reg).len();
    }
    return out;
}

// ssa_trailing_push is the register a body's last line pushes, "" when its
// last line is anything else.
function ssa_trailing_push(body: string): string {
    var at: i32 = body.len() - 1;
    if (at < 0 || body[at] != 10) { return ""; }
    at = at - 1;
    while (at >= 0 && body[at] != 10) { at = at - 1; }
    var reg: string = ssa_line_reg(body, at + 1, "    str x", ", [sp, #-16]!\n");
    if (reg == "" || at + 1 + ssa_push_line(reg).len() != body.len()) { return ""; }
    return reg;
}

// ssa_line_reg reads `xN` from a line at `at` that is `prefix`, the register's
// digits and `suffix`, or "".
function ssa_line_reg(text: string, at: i32, prefix: string, suffix: string): string {
    if (at + prefix.len() > text.len()) { return ""; }
    if (slice_unchecked(text, at, at + prefix.len()) != prefix) { return ""; }
    var end: i32 = at + prefix.len();
    while (end < text.len() && text[end] >= 48 && text[end] <= 57) { end = end + 1; }
    if (end == at + prefix.len() || end + suffix.len() > text.len()) { return ""; }
    if (slice_unchecked(text, end, end + suffix.len()) != suffix) { return ""; }
    return "x" + slice_unchecked(text, at + prefix.len(), end);
}

// ssa_pops_ordered says the loads into the popped registers can go as one
// parallel move with no cycle: ssa_pop_order then names an order in which no
// load overwrites a register a later load still reads.
function ssa_pops_ordered(ins: ssa.SInst, reg_of: i32[], pops: string[]): boolean {
    return ssa_pop_order(ins, reg_of, pops).len() == pops.len();
}

function ssa_pop_order(ins: ssa.SInst, reg_of: i32[], pops: string[]): i32[] {
    var srcs: string[] = [];
    var k: i32 = 0;
    while (k < pops.len()) {
        var v: i32 = ins.args[ins.args.len() - 1 - k];
        var src: string = "";
        if (reg_of[v] >= 0) { src = ssa_reg(reg_of[v]); }
        srcs = srcs.append(src);
        k = k + 1;
    }
    var done: boolean[] = [];
    for p in pops { done = done.append(false); }
    var order: i32[] = [];
    var progressed: boolean = true;
    while (progressed && order.len() < pops.len()) {
        progressed = false;
        var i: i32 = 0;
        while (i < pops.len()) {
            if (!done[i] && !ssa_still_read(srcs, done, pops[i], i)) {
                order = order.append(i);
                done = done.with(i, true);
                progressed = true;
            }
            i = i + 1;
        }
    }
    return order;
}

function ssa_still_read(srcs: string[], done: boolean[], reg: string, self: i32): boolean {
    var j: i32 = 0;
    while (j < srcs.len()) {
        if (j != self && !done[j] && srcs[j] == reg) { return true; }
        j = j + 1;
    }
    return false;
}

// ssa_buf_call calls a builder helper with its operands loaded straight into
// x0.. in order. Only x0 can be a home, so it loads last.
function ssa_buf_call(ins: ssa.SInst, reg_of: i32[], sym: string, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.mark_heap();
    s = s.need("buf");
    var i: i32 = ins.args.len() - 1;
    while (i >= 0) {
        s = ssa_load(reg_of, ins.args[i], "x" + util.i32_to_string(i), s);
        i = i - 1;
    }
    s = s.write("    bl " + sym + "\n");
    return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

function emit_arm64_op_memcpy(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    // [dst, src, n] -> copy n bytes src->dst, push dummy 0. n on top
    // (x2), then src (x1), then dst (x0); labels are op-index-unique.
    //
    // Size-classed. At 8 bytes and up, an 8-byte loop runs until the
    // rest fits in one more 8-byte access, which is then taken at the
    // END of each operand — so the two accesses overlap and no length
    // pays for a residue loop. Below 8, a bounded (<= 7 iteration)
    // byte loop covers it. Regions must not overlap each other.
    //
    // x3/x4/x9/x10 are free: this emitter keeps operands on the
    // machine stack, so nothing above x2 is live across an op.
    //
    // The x86-64 sibling deliberately keeps `rep movsb`. Measured over
    // examples/bench, this shape is a 2.1x win here and a 10% LOSS
    // there, where ERMSB covers the whole supported CPU baseline.
    var mi: string = util.i32_to_string(i);
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = arm64_copy_bytes(s, CopyRegs { dst: "x0", src: "x1", n: "x2", tmp: "x4", src_end: "x9", dst_end: "x10" }, lp + "mc" + mi, lp + "mct" + mi, lp + "mcb" + mi, lp + "mcd" + mi);
    s = s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");

    return s;
}


// The registers `arm64_copy_bytes` copies through: the three operands, which
// it advances, and three scratch registers it clobbers.
struct CopyRegs { dst: string, src: string, n: string, tmp: string, src_end: string, dst_end: string }

// arm64_copy_bytes copies `n` bytes from `src` to `dst`, the two regions
// disjoint, in the size-classed shape emit_arm64_op_memcpy describes. The four
// labels are the word loop, its overlapping last word, the byte loop taken
// below 8 bytes, and the end.
function arm64_copy_bytes(s: asmcore.EmitState, r: CopyRegs, words: string, tail: string, bytes: string, done: string): asmcore.EmitState {
    var tb: string = "w" + slice_unchecked(r.tmp, 1, r.tmp.len());
    s = s.write("    cbz " + r.n + ", " + done + "\n");
    s = s.write("    cmp " + r.n + ", #8\n    b.lo " + bytes + "\n");
    s = s.write("    add " + r.src_end + ", " + r.src + ", " + r.n + "\n    sub " + r.src_end + ", " + r.src_end + ", #8\n");
    s = s.write("    add " + r.dst_end + ", " + r.dst + ", " + r.n + "\n    sub " + r.dst_end + ", " + r.dst_end + ", #8\n");
    s = s.write(words + ":\n");
    s = s.write("    cmp " + r.dst + ", " + r.dst_end + "\n    b.hs " + tail + "\n");
    s = s.write("    ldr " + r.tmp + ", [" + r.src + "], #8\n    str " + r.tmp + ", [" + r.dst + "], #8\n");
    s = s.write("    b " + words + "\n");
    s = s.write(tail + ":\n");
    s = s.write("    ldr " + r.tmp + ", [" + r.src_end + "]\n    str " + r.tmp + ", [" + r.dst_end + "]\n");
    s = s.write("    b " + done + "\n");
    s = s.write(bytes + ":\n");
    s = s.write("    ldrb " + tb + ", [" + r.src + "], #1\n    strb " + tb + ", [" + r.dst + "], #1\n    sub " + r.n + ", " + r.n + ", #1\n");
    s = s.write("    cbnz " + r.n + ", " + bytes + "\n");
    return s.write(done + ":\n");
}
function emit_arm64_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // bump high-water mark = (__fern_heap_ptr == 0) ? 0 : ptr − base.
    // The arena is mmap'd lazily; its base is recoverable from the
    // recorded end (__fern_heap_end = base + heap_size), so base =
    // end − heap_size and ptr − base = ptr − end + heap_size. The
    // cursor is 0 until the first alloc, so guard that to report 0.
    s = s.mark_heap();
    s = s.write("    adrp x0, __fern_heap_ptr\n    add x0, x0, :lo12:__fern_heap_ptr\n    ldr x0, [x0]\n");   // cursor (0 if uninit)
    s = s.write("    adrp x1, __fern_heap_end\n    add x1, x1, :lo12:__fern_heap_end\n    ldr x1, [x1]\n");   // arena end
    s = s.write("    sub x2, x0, x1\n");                  // ptr − end
    s = s.write("    mov x3, #1\n    lsl x3, x3, #34\n");// heap_size = 0x400000000 (16 GiB, lockstep with asm_arm64.fern), built via mov+lsl (32-bit literal parser)
    s = s.write("    add x2, x2, x3\n");                  // ptr − base
    s = s.write("    cmp x0, #0\n");
    s = s.write("    csel x2, x2, xzr, ne\n");            // 0 if uninit, else ptr−base
    s = s.write("    str x2, [sp, #-16]!\n");

    return s;
}

// emit_arm64_op_heap_alloc_count reads the allocator's call count (#9596),
// ticked at __fern_alloc's entry so the freelist-pop path is counted exactly
// like the bump path. Inline for heap_bump_bytes's reason: it reads a runtime
// word, and a call would only add an ABI. The `alloc_count` need is what puts
// the word and the tick into the runtime, so a program that never asks for
// the number emits neither.
function emit_arm64_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    s = s.mark_heap();
    s = s.need("alloc_count");
    s = s.write("    adrp x0, __fern_alloc_count\n    add x0, x0, :lo12:__fern_alloc_count\n    ldr x0, [x0]\n");
    s = s.write("    str x0, [sp, #-16]!\n");

    return s;
}

function emit_arm64_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // Rewind to the mark and restore both head tables. mark == 0 means
    // the mark predates the first allocation, i.e. no checkpoint — leave
    // the cursor alone rather than zero it and hand out the arena base.
    // Sound only when nothing allocated after the mark is still
    // reachable; the caller owns that, as it owns malloc/free pairing.
    var hro: asmcore.LabelOut = asmcore.fresh_label(s);
    var hr_done: string = hro.name;
    s = hro.state;
    s = s.mark_heap();
    s = s.write("    ldr x0, [sp], #16\n");
    s = s.write("    cbz x0, " + hr_done + "\n");
    s = s.write("    adrp x1, __fern_heap_ptr\n    add x1, x1, :lo12:__fern_heap_ptr\n    str x0, [x1]\n");
    s = arm64_copy_words(s, "__fern_freelist_shadow", "__fern_freelist", 65536);
    s = arm64_copy_words(s, "__fern_large_freelist_shadow", "__fern_large_freelist", 2560);
    s = s.write(hr_done + ":\n");
    // Push the mark back — the one-value-per-expression invariant, as on
    // x86-64. x0 survives both paths (arm64_copy_words uses x9-x12).
    s = s.write("    str x0, [sp, #-16]!\n");

    return s;
}

// emit_arm64_op_buf emits the capacity-carrying string builder's seven ops
// (#8773). The __fern_buf_* bundle takes the register ABI, so the operands pop
// straight into x0.. in order. Each arm pushes x0: the handle, the length or
// the string box for the value ops, and the helper's return as the dummy a
// statement-level drop takes for the rest. buf_new / buf_take allocate and
// buf_free returns blocks to the freelists, so all seven pull the heap in.
function emit_arm64_op_buf(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    s = s.mark_heap(); s = s.need("buf");
    var k: i32 = asmcore.buf_arity(o.kind_tag);
    while (k > 0) {
        k = k - 1;
        s = s.write("    ldr x" + util.i32_to_string(k) + ", [sp], #16\n");
    }
    return s.write("    bl " + asmcore.buf_helper(o.kind_tag) + "\n    str x0, [sp, #-16]!\n");
}

// emit_arm64_op_map and emit_arm64_op_map_read select the map ops, the
// writes and lookups first, the reads and the iterator in the second.
function emit_arm64_op_map(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 125) {  // map_set
        s = emit_arm64_op_map_set(o, s);
    } else if (o.kind_tag == 126) {  // map_len
        // pop map; len = keys-array length ([[map]]).
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0]\n    ldr x0, [x0]\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 127) {  // map_get
        s = s.need("maps");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = map_eqfn_x5(s, o.str);
        s = s.write("    mov x2, #" + util.i32_to_string(o.i32_imm) + "\n    bl __fern_map_get\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 128) {  // map_has
        s = s.need("maps");
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
        s = map_eqfn_x5(s, o.str);
        s = s.write("    mov x2, #" + util.i32_to_string(o.i32_imm) + "\n    bl __fern_map_has\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 130) {  // map_delete
        s = emit_arm64_op_map_delete(o, s);
    } else if (o.kind_tag == 129) {  // map_get_or
        s = emit_arm64_op_map_get_or(o, i, lp, s);
    }
    return emit_arm64_op_map_read(o, i, lp, s);
}

// [map, key] -> __fn___fern_map_delete(map, key, keykind, eqfn) -> the
// (map, existed) tuple box (`m.without(k)`). The helper is Fern (#2649), so
// this is the stack ABI: arguments pushed in REVERSE in 16-byte slots, leaving
// arg0 (the map) on top, every slot dropped after. A delete that releases what
// it removes (#9970) takes __fern_map_delete_rel instead, with the key-free
// flag, the value kind and the two releases behind the four — the key's and
// the value's as ir.map_op_symbols splits them, 0 where the op names none.
function emit_arm64_op_map_delete(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    var syms: string[] = ir.map_op_symbols(o);
    var rel: boolean = ir.map_delete_releases(o);
    s = s.need("maps");
    s = s.need("map_delete");
    if (rel) { s = s.need("map_delete_rel"); }
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    var argc: i32 = 4;
    if (rel) {
        argc = 8;
        s = map_fn_address(s, "x7", syms[1]);
        s = s.write("    str x7, [sp, #-16]!\n");
        if (o.i32_imm == 2) { s = map_fn_address(s, "x7", syms[2]); } else { s = map_fn_address(s, "x7", ""); }
        s = s.write("    str x7, [sp, #-16]!\n");
        s = s.write("    mov x7, #" + util.i32_to_string((o.width / 16) % 4) + "\n    str x7, [sp, #-16]!\n");
        s = s.write("    mov x7, #" + util.i32_to_string((o.width / 2) % 2) + "\n    str x7, [sp, #-16]!\n");
    }
    if (o.i32_imm == 2) { s = map_eqfn_x5(s, syms[0]); } else { s = map_eqfn_x5(s, ""); }
    s = s.write("    mov x2, #" + util.i32_to_string(o.i32_imm) + "\n");
    s = s.write("    str x5, [sp, #-16]!\n    str x2, [sp, #-16]!\n");
    s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    if (rel) { s = s.write("    bl __fn___fern_map_delete_rel\n"); } else { s = s.write("    bl __fn___fern_map_delete\n"); }
    return s.write("    add sp, sp, #" + util.i32_to_string(argc * 16) + "\n    str x0, [sp, #-16]!\n");
}

function emit_arm64_op_map_read(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 131) {  // map_keys
        s = emit_arm64_op_map_keys(o, s);
    } else if (o.kind_tag == 132) {  // map_values
        s = emit_arm64_op_map_values(o, s);
    } else if (o.kind_tag == 133) {  // map_iter
        // m.iter() -> a two-slot array box [map_ptr@8, cursor@16] off the data
        // pointer, so it carries an rc header and the typed lowering's release
        // (__fern_arr_dec) frees it. arm64 has no central op_allocates heap
        // gate, so mark_heap explicitly.
        s = s.mark_heap();
        s = s.write("    mov x0, #2\n    bl __fern_arr_box\n");
        s = s.write("    ldr x1, [sp], #16\n    str x1, [x0, #8]\n    mov x1, #0\n    str x1, [x0, #16]\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 134) {  // mapiter_has_next
        // cursor < keys.len: keys[] at map@0, len at keys@0 (asm_arm64.fern:1255).
        s = s.write("    ldr x0, [sp], #16\n    ldr x1, [x0, #16]\n    ldr x2, [x0, #8]\n");
        s = s.write("    ldr x2, [x2]\n    ldr x2, [x2]\n");
        s = s.write("    cmp x1, x2\n    cset x0, lt\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 135) {  // mapiter_key
        // keys[cursor]: keys[] at map@0, element[cursor] at keys[cursor+1].
        s = s.write("    ldr x0, [sp], #16\n    ldr x1, [x0, #16]\n    ldr x2, [x0, #8]\n    ldr x2, [x2]\n");
        s = s.write("    add x1, x1, #1\n    ldr x0, [x2, x1, lsl #3]\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 136) {  // mapiter_value
        // values[cursor]: values[] at map@8, element[cursor] at values[cursor+1].
        s = s.write("    ldr x0, [sp], #16\n    ldr x1, [x0, #16]\n    ldr x2, [x0, #8]\n    ldr x2, [x2, #8]\n");
        s = s.write("    add x1, x1, #1\n    ldr x0, [x2, x1, lsl #3]\n    str x0, [sp, #-16]!\n");
    } else if (o.kind_tag == 137) {  // mapiter_advance
        // bump the stored cursor; push a dummy result for the statement drop.
        s = s.write("    ldr x0, [sp], #16\n    ldr x1, [x0, #16]\n    add x1, x1, #1\n    str x1, [x0, #16]\n    mov x0, #0\n    str x0, [sp, #-16]!\n");
    }
    return s;
}

function emit_arm64_op_map_set(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // [map, key, val] (val on top) -> __fern_map_set(x0=map,x1=k,x2=v,x3=keykind,x4=flags).
    s = s.need("maps");
    // vretain (o.width bit 3, #6880): the VALUE is an aliased array and
    // this runtime stores the pointer with no rc-inc, so the store owes
    // it a retain — the exit dec-sweep releases every array slot, and
    // without this the map's column is left naming a freed block.
    // Emitted before the pops, off the stack top, so the value's own
    // slot is untouched.
    if ((o.width / 8) % 2 == 1) {
        s = s.write("    ldr x9, [sp]\n    str x9, [sp, #-16]!\n    bl __fn___fern_rc_inc\n    add sp, sp, #16\n");
    }
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    // x4 = per-insert flag bits (mirrors the x86-IR %r9):
    //   bit 0 = kconsume: the KEY arg is a fresh sole-owned string temp
    //     (o.width bit 1, from irlower's is_fresh_str_temp) — map_set frees
    //     the discarded key on an overwrite so a recurring computed key
    //     doesn't leak (the arm64 twin of the x86-IR fix).
    //   bit 1 = owncols (o.width bit 2, #4353): i32-key AND i32-value map
    //     — its keys()/values() reads snapshot (kinds 131/132 flag 0), so
    //     the grow path may free the superseded buffer (arr_push_owned).
    // i32/interned keys are never fresh and string/pointer columns never
    // set owncols → x4=0 → old behaviour for the compiler's own maps.
    //   bits 2/3 = vkind (o.width bits 4/5, #9300): the value column owns one
    //     unit per live entry, so the superseded value on an overwrite is
    //     released — 1 through __fern_str_free, 2 through __fern_str_arr_free,
    //     3 through the function in x6, which o.str names.
    var x4bits: i32 = 0;
    if ((o.width / 2) % 2 == 1) { x4bits = x4bits + 1; }
    if ((o.width / 4) % 2 == 1) { x4bits = x4bits + 2; }
    if ((o.width / 16) % 2 == 1) { x4bits = x4bits + 4; }
    if ((o.width / 32) % 2 == 1) { x4bits = x4bits + 8; }
    if (x4bits >= 4) { s = s.need("map_vfree"); }
    s = s.write("    mov x4, #" + util.i32_to_string(x4bits) + "\n");
    // x5 = derived K.eq for a struct/enum key, x6 = the value release of a
    // column of boxes (vkind 3), x7 = the key release of a keyed column, each
    // 0 where the op names none (ir.map_op_symbols splits the three, #9962).
    var syms: string[] = ir.map_op_symbols(o);
    if (o.i32_imm == 2) { s = map_eqfn_x5(s, syms[0]); } else { s = map_eqfn_x5(s, ""); }
    s = map_fn_address(s, "x6", syms[1]);
    if (o.i32_imm == 2) { s = map_fn_address(s, "x7", syms[2]); } else { s = map_fn_address(s, "x7", ""); }
    s = s.write("    mov x3, #" + util.i32_to_string(o.i32_imm) + "\n    bl __fern_map_set\n    str x0, [sp, #-16]!\n");

    return s;
}

function emit_arm64_op_map_get_or(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = s.need("maps");
    var golbl: string = lp + "go" + util.i32_to_string(i);
    // [map, k, default] (default top) -> __fern_map_get, payload or default.
    s = s.write("    ldr x3, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");   // default(x3), k(x1), map(x0)
    s = s.write("    str x3, [sp, #-16]!\n");   // save default across the call (x3 is caller-saved)
    s = map_eqfn_x5(s, o.str);
    s = s.write("    mov x2, #" + util.i32_to_string(o.i32_imm) + "\n    bl __fern_map_get\n");
    s = s.write("    ldr x3, [sp], #16\n");      // restore default
    // Release the Option box __fern_map_get allocated — it is consumed
    // right here (#4357's ~16 B/call get_or leak). Extract tag +
    // payload FIRST, then release through __fern_arr_dec: the box
    // carries an rc header, and a headered block threaded straight onto
    // the freelist corrupts it. x3/x4/x6 are caller-saved and live
    // across the call; x6 is paired with itself to keep sp 16-byte
    // aligned, so its partner pops into a scratch register.
    s = s.write("    ldr x4, [x0]\n    ldr x6, [x0, #8]\n");   // tag, payload
    s = s.write("    stp x3, x4, [sp, #-16]!\n    stp x6, x6, [sp, #-16]!\n");
    s = s.write("    str x0, [sp, #-16]!\n    bl __fn___fern_arr_dec\n    add sp, sp, #16\n");
    s = s.write("    ldp x6, x9, [sp], #16\n    ldp x3, x4, [sp], #16\n");
    s = s.write("    cbnz x4, " + golbl + "_d\n");   // tag != 0 -> default
    s = s.write("    mov x0, x6\n    b " + golbl + "_e\n");
    s = s.write(golbl + "_d:\n    mov x0, x3\n" + golbl + "_e:\n    str x0, [sp, #-16]!\n");

    return s;
}

function emit_arm64_op_map_keys(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // parallel-array map: keys[] pointer at box+0. Scalar column
    // (i32_imm 0, #4353): SNAPSHOT into a fresh rc=1 copy via
    // __fern_map_snapshot_col (asm_arm64.fern map runtime) so the read
    // is an owned array — the exit sweep reclaims the copy, and
    // map_set's owned grow can free the superseded live buffer without
    // dangling it. Pointer/string column (i32_imm 1): the historical
    // raw-buffer alias (slice 3). The helper allocates (__fern_arr_box),
    // so mark the heap + maps needs like map_iter does.
    if (o.i32_imm == 0) {
        s = s.need("maps");
        s = s.mark_heap();
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0]\n    bl __fern_map_snapshot_col\n    str x0, [sp, #-16]!\n");
    } else if (o.i32_imm == 2) {
        // String column (#4353 slice 3): snapshot + per-element
        // rc-inc; the SARR post-loop release deep-frees the copy.
        s = s.need("maps");
        s = s.mark_heap();
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0]\n    bl __fern_map_snapshot_col_str\n    str x0, [sp, #-16]!\n");
    } else {
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0]\n    str x0, [sp, #-16]!\n");
    }

    return s;
}

function emit_arm64_op_map_values(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // parallel-array map: values[] pointer at box+8. Same scalar-column
    // snapshot / string-column retain-snapshot / pointer-column alias
    // split as map_keys above.
    if (o.i32_imm == 0) {
        s = s.need("maps");
        s = s.mark_heap();
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0, #8]\n    bl __fern_map_snapshot_col\n    str x0, [sp, #-16]!\n");
    } else if (o.i32_imm == 2) {
        s = s.need("maps");
        s = s.mark_heap();
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0, #8]\n    bl __fern_map_snapshot_col_str\n    str x0, [sp, #-16]!\n");
    } else {
        s = s.write("    ldr x0, [sp], #16\n    ldr x0, [x0, #8]\n    str x0, [sp, #-16]!\n");
    }

    return s;
}

// helper_call_needs marks the runtime bodies a call to the helper `name`
// requires, for both emits of a call_direct: the stack machine's and the
// SSA backend's. A call_direct does not imply a need, so without these a
// call site is emitted against a body the runtime never writes.
function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
    s = s.mark_heap();
    // i32.to_string()'s decimal helper needs its body emitted (the
    // stack-ABI __fn___fern_i32_to_string wrapper in asm_arm64.emit_runtime,
    // gated on this need).
    if (name == "__fern_i32_to_string") { s = s.mark_i32_to_string(); }
    // u32.to_string()'s UNSIGNED decimal helper (#2649) — the x86 IR path
    // marks this (asm_ir), but the arm64 IR path was missing it, so a
    // module reaching u32_to_string on the arm64 IR path emitted the call
    // without its body → "undefined reference to __fn___fern_u32_to_string"
    // at link (e.g. u32_arith through the self-host arm64 stdtest gate).
    if (name == "__fern_u32_to_string") { s = s.mark_u32_to_string(); }
    // The WIDE siblings (#5826). asm_arm64.emit_runtime already emits
    // both bodies gated on these needs; only the IR-path mark was
    // missing, exactly as it was for u32 above.
    if (name == "__fern_i64_to_string") { s = s.mark_i64_to_string(); }
    if (name == "__fern_u64_to_string") { s = s.mark_u64_to_string(); }
    // str_to_i32(s)'s decimal-parse helper — gated on this need (the
    // stack-ABI __fn___fern_str_to_i32 wrapper in asm_arm64.emit_runtime).
    if (name == "__fern_str_to_i32") { s = s.mark_str_to_i32(); }
    // chr(n)'s 1-char-box helper — gated on this need (the self-contained
    // stack-ABI __fn___fern_chr in asm_arm64.emit_runtime).
    if (name == "__fern_chr") { s = s.mark_chr(); }
    // The i32 builtin helpers irlower lowers for EVERY backend (#3457):
    // xs.sum() / .product() / .index_of() / .contains(), n.pow(k),
    // n.gcd(m) / n.lcm(m), and
    // xs.min() / .max(). Their bodies are need-gated in
    // asm_arm64.emit_runtime, and the arm64 IR path marked none of them —
    // so `bl __fn___fern_arr_i32_sum` was emitted against nothing and the
    // link failed with an undefined reference (the same gap u32_to_string
    // had above; the x86 IR path marks its equivalents in asm_ir).
    if (name == "__fern_arr_i32_sum") { s = s.mark_arr_i32_sum(); }
    if (name == "__fern_arr_i32_product") { s = s.mark_arr_i32_product(); }
    if (name == "__fern_i32_pow") { s = s.mark_i32_pow(); }
    // n.gcd(m) / n.lcm(m). The BODIES were already emitted below (gated
    // on has_need), fed by all_runtime_need_roots in the per-module entry
    // — but nothing marked the need from a call site, because irlower had
    // no lowering for these two until now and so no call site existed.
    // close_needs carries i32_lcm → i32_gcd, so marking lcm alone would
    // still emit gcd's body; both are marked for symmetry with the x86
    // pair in asm_ir.
    // __fern_map_find's body is in the maps bundle; a call to it from
    // __fern_map_delete's Fern body must pull that bundle in, since call_direct
    // does not imply a need.
    if (name == "__fern_map_find") { s = s.need("maps"); }
    if (name == "__fern_i32_gcd") { s = s.mark_i32_gcd(); }
    if (name == "__fern_i32_lcm") { s = s.mark_i32_lcm(); }
    if (name == "__fern_arr_i32_index_of") { s = s.mark_arr_i32_index_of(); }
    if (name == "__fern_arr_i32_index_of_opt") { s = s.mark_arr_i32_index_of_opt(); }
    // min/max return a freshly allocated Option box, so unlike the fold
    // helpers they need the heap runtime as well as their own bodies.
    if (name == "__fern_arr_i32_min_opt" || name == "__fern_arr_i32_max_opt") {
        s = s.mark_heap();
        s = s.need("arr_i32_min_max_opt");
    }
    // arr.join(sep) (#5328): mark_arr_str_join sets the arr_str_join + heap
    // needs; the bodies come from asm_arm64.emit_runtime
    // (which asm_arm64_ir reuses verbatim — the arr_str_join block already
    // exists there), so only the call site needs marking here.
    if (name == "__fern_arr_str_join") { s = s.mark_arr_str_join(); }
    // arr-of-arr reclaim helpers (#4355 slice 9) — bodies gated on these
    // needs in asm_arm64's runtime writer, mirroring the x86 asm_ir
    // gating: an unrelated binary must not carry the strarrarr body's
    // inner `bl __fn___fern_str_arr_free` (negative asm-grep contracts).
    if (name == "__fern_arrarr_free") { s = s.need("arrarr_free"); }
    if (name == "__fern_arr_inc_elems") { s = s.need("arr_inc_elems"); }
    // The VIEW-aware string[] element walk (#6544), gated the same way:
    // a binary that never reclaims a builtin string[] must not carry a
    // body whose inner `bl __fn___fern_str_view_free` the negative
    // asm-grep contracts would see.
    // The box-VALUE-column map frees (#4353 item 3) free that column
    // through __fern_arrarr_free, so they pull in its body as well as
    // their own.
    if (name == "__fern_map_free_va" || name == "__fern_map_free_ksva") {
        s = s.need("arrarr_free"); s = s.need("map_free_va");
    }
    // The box-KEY members (#9966) free the key column through
    // __fern_arrarr_free, so they pull in its body as well as their own; _kavsa
    // frees its value column through __fern_strarrarr_free on top of that.
    if (name == "__fern_map_free_ka") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("map_free_ka");
    }
    if (name == "__fern_map_free_kavs") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("map_free_kavs");
    }
    if (name == "__fern_map_free_kava") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("map_free_kava");
    }
    if (name == "__fern_map_free_kavsa") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("strarrarr_free"); s = s.need("map_free_kavsa");
    }
    // The string[]-VALUE-column pair frees that column through
    // __fern_strarrarr_free, so they pull in its body as well as their own.
    if (name == "__fern_map_free_vsa" || name == "__fern_map_free_ksvsa") {
        s = s.need("strarrarr_free"); s = s.need("map_free_vsa");
    }
    if (name == "__fern_map_free_vf" || name == "__fern_map_free_ksvf") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("map_free_vf");
    }
    // The keyed-column members (#9962), each its own body; _kfvsa frees its
    // value column through __fern_strarrarr_free on top of its own walk.
    if (name == "__fern_map_free_kf") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("map_free_kf");
    }
    if (name == "__fern_map_free_kfvs") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("map_free_kfvs");
    }
    if (name == "__fern_map_free_kfvsa") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("strarrarr_free"); s = s.need("map_free_kfvsa");
    }
    if (name == "__fern_map_free_kfvf") {
        s = s.mark_heap(); s = s.need("maps"); s = s.need("map_free_kfvf");
    }
    // The shallow and string-column frees are emitted with the maps bundle, and
    // a release reached without a map_new in the same unit — a produced
    // callee's, or a drop helper's — has to pull that bundle in.
    if (name == "__fern_map_free" || name == "__fern_map_free_vs" || name == "__fern_map_free_ks" || name == "__fern_map_free_kvs") {
        s = s.mark_heap(); s = s.need("maps");
    }
    if (name == "__fern_strarrarr_free") { s = s.need("strarrarr_free"); }
    if (name == "__fern_optarrarr_free") { s = s.need("optarrarr_free"); }
    // __map_vals_struct_drop_<T>: the struct-VALUE column walk a reclaimable
    // map takes before __fern_map_free_va; its body pulls in the element walk.
    if (ircore.is_map_vals_struct_drop_name(name)) { s = s.mark_heap(); s = s.need("map_vals_struct_drop:" + ircore.map_vals_struct_drop_type(name)); }
    // __field_reclaim_<T> (#3457): record the type so emit_module_ir_unit_arm64_flat
    // emits a per-type pass-through body. arm64 does NOT deep-drop struct
    // fields yet (leak-safe pass-through); still needs the heap runtime.
    // (__fern_snapshot_dec — the shallow consume-rebind free — IS real on
    // arm64 now; only the per-type deep-drop helpers remain pass-throughs.)
    if (ircore.is_field_reclaim_name(name)) { s = s.mark_heap(); s = s.need("field_reclaim:" + ircore.field_reclaim_type(name)); }
    // __struct_drop_<T> (#3457): record the type so emit_module_ir_unit_arm64_flat
    // emits a per-type pass-through body (leak-safe; arm64 does NOT deep-drop
    // yet, mirroring __field_reclaim). Still needs the heap runtime.
    if (ircore.is_struct_drop_name(name)) { s = s.mark_heap(); s = s.need("struct_drop:" + ircore.struct_drop_type(name)); }
    return s;
}

// dyn_arg_load loads a `dyn Trait` call's argument into `reg`: from its
// register, or from its frame slot relative to x29, which no push moves.
function dyn_arg_load(s: asmcore.EmitState, reg: string, a: asmcore.DynArg): asmcore.EmitState {
    if (a.reg.len() > 0) {
        if (a.reg == reg) { return s; }
        return s.write("    mov " + reg + ", " + a.reg + "\n");
    }
    return fr_ldr(s, reg, a.off);
}

// emit_dyn_dispatch_chain is a `dyn Trait` method call: it reads the
// receiver's shape pointer (x1) and dispatches to the matching
// `<Type>.<method>` through a compare-branch chain over every module method
// named `method` with a struct receiver, mirroring asm_arm64.fern. Each
// matched arm pushes the arguments (arg0/receiver on top, the arm64 ABI)
// from where `args` says they are, calls, and leaves the result in x0. x1
// and x2 are scratch.
function emit_dyn_dispatch_chain(method: string, args: asmcore.DynArg[], i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    var dargc: i32 = args.len();
    s = dyn_arg_load(s, "x0", args[0]);
    s = s.write("    ldr x1, [x0]\n");
    var dend: string = lp + "dynend" + util.i32_to_string(i);
    var dfi: i32 = 0;
    var darmn: i32 = 0;
    while (dfi < s.funcs.len()) {
        var dfd: parser.FuncDecl = s.funcs[dfi];
        var ddbn: string = util.base_type_name(dfd.receiver_type);
        // Dispatch arms: struct receivers (value carries its shape) AND
        // primitive/string receivers (value heap-boxed at coercion —
        // docs/DYN-TRAITS.md §4.2.3). A primitive arm UNBOXES: the receiver
        // holds the box pointer, so arg0 is reloaded from box+8.
        var dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
        if (irlower.dyn_arm_matches(dfd, method, s.funcs) && dfd.receiver_type.len() > 0
                && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
            var dbn: string = ddbn;
            var dlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, dbn);
            s = dlit.state;
            var dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
            s = s.write("    adrp x2, " + dlit.label + "\n");
            s = s.write("    add x2, x2, :lo12:" + dlit.label + "\n");
            s = s.write("    cmp x1, x2\n    b.ne " + dnext + "\n");
            var dk: i32 = dargc - 1;
            while (dk >= 0) {
                if (dk == 0 && dprim) {
                    // arg0 is the receiver: unbox the value from box+8.
                    s = dyn_arg_load(s, "x0", args[0]);
                    s = s.write("    ldr x0, [x0, #8]\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                } else {
                    s = dyn_arg_load(s, "x0", args[dk]);
                    s = s.write("    str x0, [sp, #-16]!\n");
                }
                dk = dk - 1;
            }
            s = s.write("    bl __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
            s = s.write("    add sp, sp, #" + util.i32_to_string(dargc * 16) + "\n");
            s = s.write("    b " + dend + "\n");
            s = s.write(dnext + ":\n");
            darmn = darmn + 1;
        }
        // ENUM-receiver arm (`impl Trait for <Enum>`, #4785): an enum
        // value's offset-0 shape is its VARIANT's interned shape (the
        // same identity op_variant_is reads), never the enum name
        // itself, so the struct-arm compare above can never identify
        // it. Match the receiver against EVERY variant of the enum;
        // on any hit call `<Enum>.<method>` with the variant box as
        // the receiver (its body's `match (self)` re-reads the
        // variant). Keyed per-variant so two enums implementing the
        // same trait dispatch to their own impls. recv_is_array
        // excludes an array method's `T[]` receiver (base_type_name
        // strips the `[]`, which would otherwise mis-read as an
        // enum — #2766). Mirrors the x86 asm_ir arm.
        if (irlower.dyn_arm_matches(dfd, method, s.funcs) && dfd.receiver_type.len() > 0
                && !asmcore.recv_is_array(dfd.receiver_type)
                && irlower.decl_is_enum(s.struct_decls, ddbn)) {
            var dehit: string = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
            var denext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
            var dvi: i32 = 0;
            while (dvi < s.struct_decls.decls.len()) {
                if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
                    var vlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, s.struct_decls.decls[dvi].name);
                    s = vlit.state;
                    s = s.write("    adrp x2, " + vlit.label + "\n");
                    s = s.write("    add x2, x2, :lo12:" + vlit.label + "\n");
                    s = s.write("    cmp x1, x2\n    b.eq " + dehit + "\n");
                }
                dvi = dvi + 1;
            }
            s = s.write("    b " + denext + "\n");
            s = s.write(dehit + ":\n");
            var dek: i32 = dargc - 1;
            while (dek >= 0) {
                s = dyn_arg_load(s, "x0", args[dek]);
                s = s.write("    str x0, [sp, #-16]!\n");
                dek = dek - 1;
            }
            s = s.write("    bl __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
            s = s.write("    add sp, sp, #" + util.i32_to_string(dargc * 16) + "\n");
            s = s.write("    b " + dend + "\n");
            s = s.write(denext + ":\n");
            darmn = darmn + 1;
        }
        dfi = dfi + 1;
    }
    // No arm matched. Unreachable for a well-typed dyn value, so abort
    // (exit 134, like __fern_oob_abort) rather than answer 0.
    s = s.write("    mov x8, #93\n    mov x0, #134\n    svc #0\n");
    s = s.write(dend + ":\n");
    return s;
}

function emit_arm64_op_dyn_box(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // Heap-box a primitive/string value coerced into a `dyn Trait` slot
    // (docs/DYN-TRAITS.md §4.2.3). Cell = [shape@0, value@8], 2 words;
    // shape = the interned primitive type name (the SAME .S label struct
    // shapes use). The cell is rc-HEADERED via __fern_arr_box(cap=2) —
    // exactly like opt_make — so a fresh, non-escaping prim/string dyn
    // local can be freed by the exit sweep's __fern_rc_dec (#4351; the
    // former raw __fern_alloc cell had no header, so it could never be
    // reclaimed). Offsets unchanged (arr_box's len@0 is overwritten by
    // the shape; cap@data-16 drives the free size). The value (one word)
    // waits on the operand stack (memory, callee-preserved) across the
    // alloc and is popped after — opt_make's alloc-then-store discipline.
    var dbl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
    s = dbl.state;
    s = s.mark_heap();
    s = s.write("    mov x0, #2\n    bl __fern_arr_box\n");  // x0 = cell ptr
    s = s.write("    adrp x2, " + dbl.label + "\n");
    s = s.write("    add x2, x2, :lo12:" + dbl.label + "\n");
    s = s.write("    str x2, [x0]\n");                       // shape @0
    s = s.write("    ldr x1, [sp], #16\n    str x1, [x0, #8]\n");   // value @8
    s = s.write("    str x0, [sp, #-16]!\n");                // push cell ptr

    return s;
}

function emit_arm64_op_dyn_downcast(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    // `e as? T` downcast (docs/DYN-TRAITS.md §9). The `dyn` value (a heap
    // pointer carrying its concrete shape @0) is on top of the operand
    // stack. Read its shape and compare to T's interned shape (the SAME
    // .S label struct_make / dyn_dispatch use, so pointer identity
    // holds): equal → Some(value) box [tag0@0, payload@8]; else → None
    // box [tag1@0, 0@8] — the ordinary Option box `match` reads. The dyn
    // value stays on the operand stack (which __fern_alloc preserves)
    // across the alloc, so the hit path reloads it as the Some payload.
    s = s.mark_heap();
    var dcl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
    s = dcl.state;
    var dcmiss: string = lp + "dcmiss" + util.i32_to_string(i);
    var dcend: string = lp + "dcend" + util.i32_to_string(i);
    s = s.write("    ldr x0, [sp]\n");                       // peek dyn ptr (left on stack)
    s = s.write("    ldr x1, [x0]\n");                       // shape @0
    s = s.write("    adrp x2, " + dcl.label + "\n");
    s = s.write("    add x2, x2, :lo12:" + dcl.label + "\n");
    s = s.write("    cmp x1, x2\n    b.ne " + dcmiss + "\n");
    // hit: Some(value) — alloc, tag 0, reload+store the dyn ptr payload.
    s = s.write("    mov x0, #16\n    bl __fern_alloc\n");
    s = s.write("    mov x1, #0\n    str x1, [x0]\n");
    s = s.write("    ldr x1, [sp], #16\n    str x1, [x0, #8]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    b " + dcend + "\n");
    // miss: None — discard the dyn ptr, build a payloadless tag-1 box.
    s = s.write(dcmiss + ":\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    mov x0, #16\n    bl __fern_alloc\n");
    s = s.write("    mov x1, #1\n    str x1, [x0]\n    str xzr, [x0, #8]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write(dcend + ":\n");

    return s;
}

// emit_body emits the arm64 program body for an all-i32-eligible module via
// the IR path: the .text header, each function from the stack IR, and a
// `_start` that calls __fn_main and exits with its result. It does NOT emit
// the heap/RC runtime and does NOT reset/take the strbuf — the CALLER
// (asm_arm64.emit_module, or the differential driver) appends asm_arm64's own
// emit_runtime and materialises the output. Keeping the runtime on the caller
// side is what lets asm_arm64 import this module (for the use_ir dispatch)
// without a cycle: asm_arm64_ir never imports asm_arm64. Caller must have
// judged the module eligible (ircore.lower_gated) and seeded `s`
// (struct_decls / funcs).
// emit_ir_start writes the program entry: capture argc / argv / envp, push a
// frame, call __fn_main, exit with its result. Both IR emitters use it — the
// whole-program emit_body and the per-module emit_module_ir_unit_arm64_flat, which
// carried a verbatim copy.
//
// The capture convention is the one thing that differs by platform, and it is
// a total divergence rather than a syscall renumbering, so darwinize cannot
// reskin it:
//
//   Linux: the kernel jumps to `_start` with sp pointing at
//   [argc, argv[0..], NULL, envp[0..], NULL, auxv], so argc is at [sp],
//   argv at sp+8, and envp at sp + 16 + argc*8.
//
//   Darwin: dyld CALLS `_main(argc, argv, envp, apple)` per AAPCS64 — argc in
//   x0, argv in x1, envp in x2 — and the stack carries no SVR4-shaped layout
//   at all. Reading [sp] there yields garbage: it lands in __fern_envp, and
//   the first env() walk dereferences it (#6042's audit — the same
//   Linux-value-on-the-darwin-path class as the arena mmap flags).
// emit_ir_reloc emits the startup self-relocation loop (#7112).
//
// A static aggregate constant's shape word and a static string box's data word
// are ABSOLUTE pointers sitting in `.data`. `-target arm64-android` is a static
// PIE — ET_DYN, no PT_DYNAMIC, no relocations — so the kernel maps it at a base
// the linker never knew and those words arrive stale by the slide. A shape
// compare then never matches (`match` on a const aggregate took no arm and the
// program returned 0), and a string box's bytes pointer faults.
//
// The slide comes from `.Lfern_relanchor`, whose `.quad` names itself: the
// linker writes that word's LINK-TIME address, `adrp` computes its RUNTIME one,
// and the difference is the slide. Nothing here needs a relocation to bootstrap.
//
// Emitted on both ELF targets rather than gated on the PIE one, which keeps
// `-emit asm` identical between arm64-linux and arm64-android: ET_EXEC links and
// loads at the same address, so the slide is 0 and `cbz` skips the walk.
//
// Mach-O is excluded instead of relied on to cancel. LC_DYLD_INFO rebase opcodes
// already add the slide to every one of these words, so a second pass would
// double it — and the anchor is itself rebased, which is exactly what would make
// that look safe (slide reads as 0) without it being verifiable from here.
//
// The regions are walked rather than tabulated: string boxes are a fixed 24-byte
// stride, and a const-aggregate block carries its own length in the `cap` word
// the walk strides by. Only the whole-program pool is contiguous and complete,
// which is the only shape `-target arm64-android` produces; a per-module unit
// (str_ns != "") emits its pool piecewise and gets no loop.
// reloc_wanted decides, for BOTH the relocation loop and the data it walks,
// whether either exists. They have to agree: scaffolding without a loop is dead
// weight that still changes the image (a `.data` section appearing in a program
// that has no data is enough to fail a container assertion), and a loop without
// scaffolding does not assemble.
//
// Mach-O is out because LC_DYLD_INFO rebase opcodes already add the slide.
// A per-module unit is out because it emits its pool piecewise, while the walk
// assumes the single contiguous pool only a whole-program emit produces — and
// because several units link into one image, so the labels would collide.
pub function reloc_wanted(s: asmcore.EmitState, darwin: boolean): boolean {
    return !darwin && s.str_ns.len() == 0;
}

function emit_ir_reloc(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    if (!reloc_wanted(s, darwin)) { return s; }
    s = s.write("    adrp x9, .Lfern_relanchor\n");
    s = s.write("    add x9, x9, :lo12:.Lfern_relanchor\n");
    s = s.write("    ldr x10, [x9]\n");
    s = s.write("    sub x9, x9, x10\n");            // x9 = load slide
    s = s.write("    cbz x9, .Lfern_reloc_done\n");
    // String boxes: [rc][data][len], 24 bytes, data word at +8.
    s = s.write("    adrp x11, .Lfern_sbox_begin\n");
    s = s.write("    add x11, x11, :lo12:.Lfern_sbox_begin\n");
    s = s.write("    adrp x12, .Lfern_sbox_end\n");
    s = s.write("    add x12, x12, :lo12:.Lfern_sbox_end\n");
    s = s.write(".Lfern_sbox_loop:\n");
    s = s.write("    cmp x11, x12\n");
    s = s.write("    b.hs .Lfern_sbox_done\n");
    s = s.write("    ldr x13, [x11, #8]\n");
    s = s.write("    add x13, x13, x9\n");
    s = s.write("    str x13, [x11, #8]\n");
    s = s.write("    add x11, x11, #24\n");
    s = s.write("    b .Lfern_sbox_loop\n");
    s = s.write(".Lfern_sbox_done:\n");
    // Const-aggregate blocks: [cap][rc][shape][val…], shape word at +16, and
    // the block spans 16 + cap*8 bytes.
    s = s.write("    adrp x11, .Lfern_cagg_begin\n");
    s = s.write("    add x11, x11, :lo12:.Lfern_cagg_begin\n");
    s = s.write("    adrp x12, .Lfern_cagg_end\n");
    s = s.write("    add x12, x12, :lo12:.Lfern_cagg_end\n");
    s = s.write(".Lfern_cagg_loop:\n");
    s = s.write("    cmp x11, x12\n");
    s = s.write("    b.hs .Lfern_reloc_done\n");
    s = s.write("    ldr x13, [x11, #16]\n");
    s = s.write("    add x13, x13, x9\n");
    s = s.write("    str x13, [x11, #16]\n");
    s = s.write("    ldr x14, [x11]\n");
    s = s.write("    add x11, x11, #16\n");
    s = s.write("    add x11, x11, x14, lsl #3\n");
    s = s.write("    b .Lfern_cagg_loop\n");
    s = s.write(".Lfern_reloc_done:\n");
    return s;
}

function emit_ir_start(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    s = s.write("_start:\n");
    // Before anything that could read a relocated pointer.
    s = emit_ir_reloc(s, darwin);
    if (darwin) {
        // x0 / x1 / x2 already hold argc / argv / envp; x3 is the scratch that
        // keeps the address materialisation off them.
        if (s.has_need("args")) {
            s = s.write("    adrp x3, __fern_argc\n");
            s = s.write("    add x3, x3, :lo12:__fern_argc\n");
            s = s.write("    str x0, [x3]\n");
            s = s.write("    adrp x3, __fern_argv\n");
            s = s.write("    add x3, x3, :lo12:__fern_argv\n");
            s = s.write("    str x1, [x3]\n");
        }
        if (s.has_need("heap")) {
            s = s.write("    adrp x3, __fern_envp\n");
            s = s.write("    add x3, x3, :lo12:__fern_envp\n");
            s = s.write("    str x2, [x3]\n");
        }
    } else {
        // args() reads __fern_argc / __fern_argv; save them from the SysV entry
        // stack BEFORE the frame push. Gated on the args need so a non-args
        // program is byte-identical. __fern_args / __fern_arg_at come from
        // emit_runtime (also gated on the args need).
        if (s.has_need("args")) {
            s = s.write("    ldr x0, [sp]\n");
            s = s.write("    adrp x1, __fern_argc\n");
            s = s.write("    add x1, x1, :lo12:__fern_argc\n");
            s = s.write("    str x0, [x1]\n");
            s = s.write("    add x0, sp, #8\n");
            s = s.write("    adrp x1, __fern_argv\n");
            s = s.write("    add x1, x1, :lo12:__fern_argv\n");
            s = s.write("    str x0, [x1]\n");
        }
        // Save envp for env() / subprocess, gated on the heap need so
        // __fern_envp is declared iff this saves it. Without this the IR-path
        // _start left it null and env()'s walk (`.Lenv_loop: ldr x1, [x19]`)
        // dereferenced a null base. sp is unchanged by the args block above,
        // so the SysV offset holds.
        if (s.has_need("heap")) {
            s = s.write("    ldr x0, [sp]\n");            // argc
            s = s.write("    lsl x0, x0, #3\n");          // argc*8
            s = s.write("    add x0, x0, #16\n");         // + 16 (argc slot + argv NULL)
            s = s.write("    add x0, sp, x0\n");          // envp base
            s = s.write("    adrp x1, __fern_envp\n");
            s = s.write("    add x1, x1, :lo12:__fern_envp\n");
            s = s.write("    str x0, [x1]\n");
        }
    }
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    bl __fn_main\n");
    if (leak_check_on()) {
        // Census (#5362): the exit() builtin bypasses this epilogue and
        // reports at its own site; a returning main reports here.
        s = s.write("    mov x19, x0\n");
        s = s.write("    bl __fern_lc_report\n");
        s = s.write("    mov x0, x19\n");
    }
    s = s.write("    mov x8, #93\n");      // sys_exit (Linux arm64); darwinize remaps the number + svc
    s = s.write("    svc #0\n");
    return s;
}

// emit_body emits the whole-program function bodies and `_start`. `mod` must
// already carry inferred return types (the caller derived `base` over it).
// `base` is the whole-program registry the caller derived once (wp_fn_sigs);
// only this module's trait_reqs are folded in here. `cache`, when non-empty, is
// the caller's per-function lowering — indexed by mod.funcs position — emitted
// from directly instead of lowering each function a second time.
pub function emit_body(mod: parser.Module, s: asmcore.EmitState, darwin: boolean, cache: irlower.LowerResult[], base: irlower.FnSigs): asmcore.EmitState {
    s = asmcore.EmitState { ...s, funcs: mod.funcs };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    var sg: irlower.FnSigs = irlower.fn_sigs_with_dyn(base, mod.trait_reqs);
    var vsigs: irverify.NameIndex = irlower.fn_sig_index(mod.funcs);
    ircore.check_fip_claims(mod.funcs, 0, mod.funcs.len(), cache, s.struct_decls, sg, false);
    s = asmcore.EmitState { ...s, reg_entries: irlower.sig_reg_of(asmcore.unit_labels(mod, 0, mod.funcs.len(), cache)), leaves: asmcore.unit_leaves(mod, 0, mod.funcs.len(), cache) };
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (cache.len() == 0) {
            s = emit_function_via_ir(mod.funcs[fi], s, sg, vsigs);
        } else if (!cache[fi].superseded) {
            // A template the substitution superseded has no body: its
            // instances are on the cache tail.
            s = emit_function_via_ir_pre(cache[fi], mod.funcs[fi], s, vsigs);
        }
        fi = fi + 1;
    }
    // Cache entries past the declarations are bodies with no FuncDecl, each
    // naming the symbol it defines.
    var xi: i32 = mod.funcs.len();
    while (xi < cache.len()) {
        s = emit_function_via_ir_named(cache[xi], cache[xi].name, true, s, vsigs);
        xi = xi + 1;
    }
    // Ahead of _start, which gates its envp save on the heap need. close_needs
    // is what turns a root like str_concat into that heap need, so reading it
    // first would leave __fern_envp null in a program that still gets the heap
    // runtime.
    s = s.close_needs();
    return emit_ir_start(s, darwin);
}

// ---- moved verbatim from asm_arm64.fern (#3457 slice 4 untangle) ----
// The per-type __field_reclaim_<T> / __struct_drop_<T> helper bodies are
// IR-path-only (emitted by emit_module_ir_unit_arm64_flat + emit_module_ir_gated) and
// depend only on asmcore / irlower / util / asm_ir — so they live here in the
// IR selector, mirroring the x86 asm_ir.emit_ir_struct_drop_one layout, not in
// the AST emitter asm_arm64.fern that #3457 deletes.
// emit_ir_runtime_fern_fn is the arm64 sibling of asm_ir.emit_ir_runtime_fern_fn:
// a runtime helper written in Fern (an asmcore.rt_src_* body) is lowered through
// the IR selector (emit_function_via_ir) rather than the AST emit_function that
// asm_arm64.emit_runtime_fern_fn uses. This is what lets the arm64 IR path emit
// its Fern runtime helpers WITHOUT the AST emitter (#3457 slice 4a) — the
// remaining transitive coupling of emit_module_ir_unit_arm64_flat to asm_arm64.fern.
// The helper bodies are self-contained (fully annotated, call no other helper),
// so the per-helper side-tables computed over the helper's own funcs suffice.
// Byte-equivalence with the AST path is NOT expected (emit_function and
// emit_function_via_ir select different instructions for the same source) — the
// arm64 differential + fixpoint gate this, not the byte-identity gate.
// rt_arm64_str_eq is __fn___fern_str_eq: 1 when two string boxes hold equal
// bytes, else 0. The x86-64 twin (asm_ir.rt_x86_str_eq) carries the measurement
// that made both hand-written rather than the shared Fern body they replaced —
// the cost is a per-call frame, not per byte, and no Fern body avoids one.
//
// The __fn_ stack convention on arm64 uses 16-byte operand slots and the caller
// pushes b then a, so after `stp x29, x30` the arguments are at [x29, #16] and
// [x29, #32]. A string box is [data ptr, length]; the result goes in x0.
//
// x29/x30 are saved even though nothing else needs a frame: __fern_report walks
// the frame chain to print a backtrace.
function rt_arm64_str_eq(): string {
    // The stack entry loads both boxes into x0/x9, where the register entry
    // `.r` takes them; equality is symmetric, so their order is not.
    var s: string = "__fn___fern_str_eq:\n";
    s = s + "    ldr x0, [sp]\n    ldr x9, [sp, #16]\n";
    s = s + "__fn___fern_str_eq.r:\n";
    s = s + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    s = s + "    mov x2, x0\n    mov x3, x9\n";
    // Same box: interned literals, which is most of what a compiler compares.
    s = s + "    cmp x2, x3\n    b.eq .Lseq_yes\n";
    s = s + "    ldr x4, [x2, #8]\n    ldr x5, [x3, #8]\n    cmp x4, x5\n    b.ne .Lseq_no\n";
    s = s + "    ldr x2, [x2]\n    ldr x3, [x3]\n";
    // Same buffer, equal length: a slice and its source compare equal here.
    s = s + "    cmp x2, x3\n    b.eq .Lseq_yes\n";
    s = s + "    add x6, x2, x4\n    add x7, x3, x4\n";
    s = s + "    cmp x4, #8\n    b.lo .Lseq_short\n";
    s = s + "    sub x6, x6, #8\n    sub x7, x7, #8\n";
    s = s + ".Lseq_word:\n";
    s = s + "    ldr x0, [x2]\n    ldr x1, [x3]\n    cmp x0, x1\n    b.ne .Lseq_no\n";
    s = s + "    add x2, x2, #8\n    add x3, x3, #8\n";
    s = s + "    cmp x2, x6\n    b.lo .Lseq_word\n";
    // The final word is anchored at the END of each string and overlaps whatever
    // the loop already read, so a length that is not a multiple of eight costs
    // one load rather than a byte loop.
    s = s + "    ldr x0, [x6]\n    ldr x1, [x7]\n    cmp x0, x1\n    b.ne .Lseq_no\n";
    s = s + "    b .Lseq_yes\n";
    // 0..7 bytes. Four-byte pairs overlap the same way; under four, byte 0, the
    // last byte and (at length three) byte 1 are every byte there is.
    s = s + ".Lseq_short:\n";
    s = s + "    cbz x4, .Lseq_yes\n";
    s = s + "    cmp x4, #4\n    b.lo .Lseq_byte\n";
    s = s + "    ldr w0, [x2]\n    ldr w1, [x3]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
    s = s + "    sub x6, x6, #4\n    sub x7, x7, #4\n";
    s = s + "    ldr w0, [x6]\n    ldr w1, [x7]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
    s = s + "    b .Lseq_yes\n";
    s = s + ".Lseq_byte:\n";
    s = s + "    ldrb w0, [x2]\n    ldrb w1, [x3]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
    s = s + "    sub x6, x6, #1\n    sub x7, x7, #1\n";
    s = s + "    ldrb w0, [x6]\n    ldrb w1, [x7]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
    s = s + "    cmp x4, #3\n    b.lo .Lseq_yes\n";
    s = s + "    ldrb w0, [x2, #1]\n    ldrb w1, [x3, #1]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
    s = s + ".Lseq_yes:\n    mov x0, #1\n    ldp x29, x30, [sp], #16\n    ret\n";
    s = s + ".Lseq_no:\n    mov x0, #0\n    ldp x29, x30, [sp], #16\n    ret\n";
    s = s + ".size __fn___fern_str_eq, .-__fn___fern_str_eq\n";
    return s;
}

// runtime_ast_bodies is the AST lowering of a runtime helper's functions, with
// side tables computed over the helper alone. They read its own functions as
// the whole program, so a read-only string or array parameter is borrowed and
// takes no release that would free the caller's value.
function runtime_ast_bodies(fns: parser.FuncDecl[], all_structs: irlower.StructTab, s: asmcore.EmitState): irlower.LowerResult[] {
    var bparams: string[] = irlower.borrowable_params_interproc(fns, all_structs);
    var sg: irlower.FnSigs = irlower.FnSigs {
        ...irlower.fn_sigs_for_borrow(fns, all_structs, ircore.array_ret_fns_of(fns), bparams),
        consume_safe_params: irlower.consume_safe_params_interproc(fns, bparams),
        // These two resolve against the EmitState's struct view, not all_structs.
        opt_fresh_ret_fns: irlower.sig_reg_of(irlower.opt_fresh_ret_fns_of(fns, s.struct_decls, irlower.str_fresh_ret_fns_of(fns))),
        strfld_ok_types: irlower.strfld_reclaim_ok_types_of(fns, s.struct_decls, bparams),
    };
    var out: irlower.LowerResult[] = [];
    for fd in fns { out = out.append(irlower.lower_func(fd, s.struct_decls, sg, false)); }
    return out;
}

pub function emit_ir_runtime_fern_fn(src: string, all_structs: irlower.StructTab, s: asmcore.EmitState): asmcore.EmitState {
    var m: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
    var fns: parser.FuncDecl[] = m.funcs;
    var vsigs: irverify.NameIndex = irlower.fn_sig_index(fns);
    var lit0: i32 = s.string_lits.len();
    var agg0: i32 = s.const_aggs.len();
    var sh0: i32 = s.shape_lits.len();
    var bodies: irlower.LowerResult[] = s.rt_lower(src);
    if (bodies.len() != fns.len()) { bodies = runtime_ast_bodies(fns, all_structs, s); }
    var i: i32 = 0;
    while (i < fns.len()) {
        s = emit_function_via_ir_pre(bodies[i], fns[i], s, vsigs);
        i = i + 1;
    }
    if (s.shape_lits.len() > sh0) {
        s = asmcore.emit_shape_lits_from(s, sh0);
        s = s.write("    .text\n");
    }
    if (s.const_aggs.len() > agg0) {
        s = asmcore.emit_const_agg_data_from(s, agg0);
        s = s.write("    .text\n");
    }
    if (s.string_lits.len() > lit0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = lit0;
        while (li < s.string_lits.len()) {
            s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
        s = asmcore.emit_str_box_data_from(s, lit0);
        s = s.write("    .text\n");
    }
    return s;
}

// emit_arm64_reclaim_drop_bodies emits this unit's per-type __field_reclaim_<T>
// + __struct_drop_<T> helper bodies (#3457), `.weak` (link-deduped across units).
// Called by BOTH arm64 IR emit paths — emit_module_ir_unit_arm64_flat (multi-unit)
// and emit_module's single-unit IR dispatch — so a reclaimable struct with an
// rc-array field links on either. Both are now REAL: __struct_drop the deep-drop
// (slice 1a), __field_reclaim the consume-rebind replaced-field reclaim (slice
// 1b, now that arm64's __fern_snapshot_dec frees the old box).
pub function emit_arm64_reclaim_drop_bodies(s: asmcore.EmitState): asmcore.EmitState {
    var fri: i32 = 0;
    while (fri < s.needed.len()) {
        var frnd: string = s.needed[fri];
        if (frnd.len() > 14 && slice_unchecked(frnd, 0, 14) == "field_reclaim:") {
            s = emit_arm64_field_reclaim_one(s, slice_unchecked(frnd, 14, frnd.len()));
        }
        fri = fri + 1;
    }
    var sdi: i32 = 0;
    while (sdi < s.needed.len()) {
        var sdnd: string = s.needed[sdi];
        // One index-driven loop over both prefixes so the transitive needs
        // (arr_elems -> struct_drop, and a struct_drop k_box arm -> arr_elems) are all
        // absorbed as they are appended, regardless of discovery order.
        if (sdnd.len() > 22 && slice_unchecked(sdnd, 0, 22) == "struct_arr_elems_drop:") {
            s = emit_arm64_struct_arr_elems_drop_one(s, slice_unchecked(sdnd, 22, sdnd.len()));
        } else if (sdnd.len() > 20 && slice_unchecked(sdnd, 0, 20) == "enum_arr_elems_drop:") {
            s = emit_arm64_enum_arr_elems_drop_one(s, slice_unchecked(sdnd, 20, sdnd.len()));
        } else if (sdnd.len() > 10 && slice_unchecked(sdnd, 0, 10) == "enum_drop:") {
            s = emit_arm64_enum_drop_one(s, slice_unchecked(sdnd, 10, sdnd.len()));
        } else if (sdnd.len() > 21 && slice_unchecked(sdnd, 0, 21) == "map_vals_struct_drop:") {
            s = emit_arm64_map_vals_struct_drop_one(s, slice_unchecked(sdnd, 21, sdnd.len()));
        } else if (sdnd.len() > 12 && slice_unchecked(sdnd, 0, 12) == "struct_drop:") {
            s = emit_arm64_struct_drop_one(s, slice_unchecked(sdnd, 12, sdnd.len()));
        }
        sdi = sdi + 1;
    }
    return s;
}

// emit_arm64_map_vals_struct_drop_one is the arm64 transcription of
// asm_ir.emit_ir_map_vals_struct_drop_one: __map_vals_struct_drop_<T>(box) -> box
// walks the VALUE column of a reclaimable struct-valued map through
// __struct_arr_elems_drop_<T> so each sole-owned value box releases its own rc
// fields before __fern_map_free_va's one-dec walk frees the boxes.
function emit_arm64_map_vals_struct_drop_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    s = s.need("struct_arr_elems_drop:" + sty);
    s = s.write(".weak __fn___map_vals_struct_drop_" + san + "\n");
    s = s.write("__fn___map_vals_struct_drop_" + san + ":\n");
    s = s.write("    ldr x0, [sp]\n");                     // box
    s = s.write("    cmp x0, #16, lsl #12\n");             // null / low-addr -> nothing to walk
    s = s.write("    blo .Lmvsd_" + san + "_ret\n");
    s = s.write("    stp x19, x30, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");
    s = s.write("    ldr x0, [x19, #8]\n");                // vals = box[8]
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___struct_arr_elems_drop_" + san + "\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    mov x0, x19\n");                      // return box (caller drops)
    s = s.write("    ldp x19, x30, [sp], #16\n");
    s = s.write(".Lmvsd_" + san + "_ret:\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_field_reclaim_one emits one __field_reclaim_<sty> body, the arm64
// transcription of asm_ir.emit_ir_field_reclaim_one. Stack-arg ABI: [sp]=snap,
// [sp+16]=old, [sp+32]=new. For each rc-array field (offset (k+1)*8 off the
// struct box) it SHALLOW-frees old.field_k via __fern_arr_dec iff it differs from
// new.field_k (cow) AND, when snap != 0, from snap.field_k (the caller's
// original); then frees the old BOX via __fern_snapshot_dec(new, old, snap) and
// returns `new` in x0. x10/x11/x12 hold new/old/snap across the field loop —
// __fern_arr_dec clobbers only x0..x3,x9, so they survive (snapshot_dec is the
// last call, after the loop). The uniq arm's __fn___fern_rc_is_unique touches
// only x0/x2/x9/w3, so it keeps x1 (the field value) across its own bl too.
// stp x29,x30 saves LR for the bls; the low-addr guard uses
// `cmp #16, lsl #12` (= 0x10000).
function emit_arm64_field_reclaim_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    s = s.write(".weak __fn___field_reclaim_" + san + "\n");
    s = s.write("__fn___field_reclaim_" + san + ":\n");
    s = s.write("    ldr x10, [sp, #32]\n");            // new
    s = s.write("    ldr x11, [sp, #16]\n");            // old
    s = s.write("    ldr x12, [sp]\n");                 // snap
    s = s.write("    stp x29, x30, [sp, #-16]!\n");     // save LR for the nested bls
    s = s.write("    cmp x11, #16, lsl #12\n");         // old null/low -> skip fields
    s = s.write("    blo .Lafr_" + san + "_box\n");
    s = s.write("    cmp x11, x10\n");                  // same box: nothing replaced
    s = s.write("    beq .Lafr_" + san + "_box\n");
    var ops: asmcore.RcOp[] = asmcore.field_reclaim_field_ops(s, sty);
    var oi: i32 = 0;
    while (oi < ops.len()) {
        var op: asmcore.RcOp = ops[oi];
        var off: string = util.i32_to_string((op.idx + 1) * 8);
        var ks: string = util.i32_to_string(op.idx);
        s = s.write("    ldr x1, [x11, #" + off + "]\n");      // old.field_k
        if (op.cow) {
            s = s.write("    ldr x2, [x10, #" + off + "]\n");  // new.field_k
            s = s.write("    cmp x1, x2\n");                   // == new? (cow)
            s = s.write("    beq .Lafr_" + san + "_skip" + ks + "\n");
        } else if (op.uniq) {
            // Carried nested struct / enum: released, because the base copy's
            // inc left it at rc>=2 and the old box's claim dies here. Unless it
            // is UNIQUE — then no inc was taken and the pointers coincide for
            // another reason (#8198: the callee reused the field's box in place
            // and handed it back), so this dec would free the new binding's box.
            s = s.write("    ldr x2, [x10, #" + off + "]\n");  // new.field_k
            s = s.write("    cmp x1, x2\n");
            s = s.write("    bne .Lafr_" + san + "_ne" + ks + "\n");
            s = s.write("    str x1, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_rc_is_unique\n");
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    cbnz x0, .Lafr_" + san + "_skip" + ks + "\n");
            s = s.write(".Lafr_" + san + "_ne" + ks + ":\n");
        }
        s = s.write("    cbz x12, .Lafr_" + san + "_dec" + ks + "\n");  // snap == 0 (local)?
        s = s.write("    ldr x2, [x12, #" + off + "]\n");      // snap.field_k
        s = s.write("    cmp x1, x2\n");                       // == snap? (caller's)
        s = s.write("    beq .Lafr_" + san + "_skip" + ks + "\n");
        s = s.write(".Lafr_" + san + "_dec" + ks + ":\n");
        if (op.kind == "arrarr_free" || op.kind == "arrarr_free_enum") {
            if (op.ty.len() > 0) {
                var esan: string = asmcore.sanitize_label(op.ty);
                var ewalk: string = "struct_arr_elems_drop";
                if (op.kind == "arrarr_free_enum") { ewalk = "enum_arr_elems_drop"; }
                s = s.need(ewalk + ":" + op.ty);
                s = s.write("    str x1, [sp, #-16]!\n");          // buffer
                s = s.write("    bl __fn___" + ewalk + "_" + esan + "\n");
                s = s.write("    add sp, sp, #16\n");
                s = s.write("    ldr x10, [sp, #48]\n");           // reload new
                s = s.write("    ldr x11, [sp, #32]\n");           // reload old
                s = s.write("    ldr x12, [sp, #16]\n");           // reload snap
                s = s.write("    ldr x1, [x11, #" + off + "]\n");  // reload buffer
            }
            s = s.need("arrarr_free");
            s = s.write("    str x1, [sp, #-16]!\n");          // old.field_k (buffer)
            s = s.write("    bl __fn___fern_arrarr_free\n");   // element walk at rc==1, then the buffer
            s = s.write("    add sp, sp, #16\n");
        } else {
            if (op.kind == "deep_enum_dec") {
                // A DIRECT enum field's live-variant rc payloads, before the dec
                // below frees the box holding them (#8567). __enum_drop_ applies
                // the rc==1 gate itself; it does not preserve x1, so reload the
                // frame and the field after it.
                var edsan: string = asmcore.sanitize_label(op.ty);
                s = s.need("enum_drop:" + op.ty);
                s = s.write("    str x1, [sp, #-16]!\n");
                s = s.write("    bl __fn___enum_drop_" + edsan + "\n");
                s = s.write("    add sp, sp, #16\n");
                s = s.write("    ldr x10, [sp, #48]\n");             // new
                s = s.write("    ldr x11, [sp, #32]\n");             // old
                s = s.write("    ldr x12, [sp, #16]\n");             // snap
                s = s.write("    ldr x1, [x11, #" + off + "]\n");    // old.field_k
            }
            if (op.kind == "deep_struct_dec") {
                // The nested struct's OWN rc children, before the dec below frees
                // the box holding them (#8538). Gated on rc==1: a SHARED inner
                // keeps its fields for its other owner. __fern_rc_is_unique
                // leaves x1 alone; __struct_drop_<ty> does not, so reload the
                // frame and the field after it.
                var dsan: string = asmcore.sanitize_label(op.ty);
                s = s.need("struct_drop:" + op.ty);
                s = s.write("    str x1, [sp, #-16]!\n");
                s = s.write("    bl __fn___fern_rc_is_unique\n");
                s = s.write("    add sp, sp, #16\n");
                s = s.write("    cbz x0, .Lafr_" + san + "_nodeep" + ks + "\n");
                s = s.write("    str x1, [sp, #-16]!\n");
                s = s.write("    bl __fn___struct_drop_" + dsan + "\n");
                s = s.write("    add sp, sp, #16\n");
                s = s.write("    ldr x10, [sp, #48]\n");             // new
                s = s.write("    ldr x11, [sp, #32]\n");             // old
                s = s.write("    ldr x12, [sp, #16]\n");             // snap
                s = s.write("    ldr x1, [x11, #" + off + "]\n");    // old.field_k
                s = s.write(".Lafr_" + san + "_nodeep" + ks + ":\n");
            }
            s = s.write("    str x1, [sp, #-16]!\n");
            if (op.kind == "str_free" || op.kind == "str_arr_free") {
                if (op.kind == "str_free") {
                    s = s.write("    bl __fn___fern_str_free\n");  // rc-aware string free (data buffer + box)
                } else {
                    s = s.write("    bl __fn___fern_str_arr_free\n");  // deep string[] free (rc-guarded)
                }
                s = s.write("    add sp, sp, #16\n");
                s = s.write("    ldr x10, [sp, #48]\n");           // new
                s = s.write("    ldr x11, [sp, #32]\n");           // old
                s = s.write("    ldr x12, [sp, #16]\n");           // snap
            } else {
                s = s.write("    bl __fn___fern_arr_dec\n");       // shallow dec/free the dead buffer
                s = s.write("    add sp, sp, #16\n");
            }
        }
        s = s.write(".Lafr_" + san + "_skip" + ks + ":\n");
        oi = oi + 1;
    }
    s = s.write(".Lafr_" + san + "_box:\n");
    // snapshot_dec(new, old, snap): push so [sp]=snap, [sp+16]=old, [sp+32]=new.
    s = s.write("    str x10, [sp, #-16]!\n");          // new
    s = s.write("    str x11, [sp, #-16]!\n");          // old
    s = s.write("    str x12, [sp, #-16]!\n");          // snap
    s = s.write("    bl __fn___fern_snapshot_dec\n");   // free old box (cow + snap guarded); x0 = new
    s = s.write("    add sp, sp, #48\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_struct_drop_one emits one __struct_drop_<sty>(box) -> box body, the
// arm64 transcription of asm_ir.emit_ir_struct_drop_one. Stack-arg ABI: [sp]=box.
// For each rc-tracked ARRAY field (offset (k+1)*8 off the box's data pointer) it
// releases the field BUFFER via __fn___fern_arr_dec (rc-guarded shallow dec/free);
// for a struct/enum-array field __fn___fern_arrarr_free does the same one level
// deeper: the element boxes when the buffer is uniquely owned, then the buffer.
// Returns `box` in x0 (the call site drops it). x10 holds box across the field
// loop — __fern_arr_dec and __fern_arrarr_free preserve it, and the helpers that
// do not (__fern_str_free, __struct_drop_*) reload it from the stack arg; the
// low-addr guard uses `cmp #16, lsl #12` (= 0x10000) to avoid tying up x9
// across the calls. The nested bls need LR saved, hence the stp x29,x30 frame;
// each call's arg is pushed at [sp] (the helpers' frameless ABI) then popped.
// IR array layout: len at buffer[0], element i at buffer[(i+1)*8], rc at buffer-8.
function emit_arm64_struct_drop_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    s = s.write(".weak __fn___struct_drop_" + san + "\n");
    s = s.write("__fn___struct_drop_" + san + ":\n");
    s = s.write("    ldr x10, [sp]\n");                 // box (read before the frame push)
    s = s.write("    mov x0, x10\n");                   // default return = box
    s = s.write("    stp x29, x30, [sp, #-16]!\n");     // save LR/FP for the nested bls
    s = s.write("    cmp x10, #16, lsl #12\n");         // box null / low-addr -> skip fields
    s = s.write("    blo .Lasd_" + san + "_ret\n");
    // Which arm each field takes is asmcore.struct_drop_field_ops' call (#7736);
    // this loop is only the arm64 selection for each directive it hands back.
    var ops: asmcore.RcOp[] = asmcore.struct_drop_field_ops(s, sty);
    var oi: i32 = 0;
    while (oi < ops.len()) {
        var op: asmcore.RcOp = ops[oi];
        var off: string = util.i32_to_string((op.idx + 1) * 8);
        var ks: string = util.i32_to_string(op.idx);
        if (op.kind == "elems_drop_struct") {
            // MULTI-LEVEL array-element deep-drop (#2649): release each element's
            // OWN rc fields before the element/buffer decs below free the boxes.
            var esan: string = asmcore.sanitize_label(op.ty);
            s = s.need("struct_arr_elems_drop:" + op.ty);
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // buffer
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___struct_arr_elems_drop_" + esan + "\n");
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box (helper clobbered x10)
        } else if (op.kind == "elems_drop_enum") {
            // The ENUM-array sibling: shape-dispatch each element and dec its
            // leak-safe-array payloads before the box decs below.
            var easan: string = asmcore.sanitize_label(op.ty);
            s = s.need("enum_arr_elems_drop:" + op.ty);
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // buffer
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___enum_arr_elems_drop_" + easan + "\n");
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box (helper clobbered x10)
        } else if (op.kind == "box_walk_dec") {
            // __fern_arrarr_free IS this directive: sole-owner gate, one
            // __fern_arr_dec per element, then the buffer freed by arr_dec's own
            // rc==1 path. Its immortal / shared / underflow arms answer exactly
            // as the open-coded walk's rc_is_unique + trailing arr_dec did.
            s = s.need("arrarr_free");
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // buffer = box.field_k
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_arrarr_free\n");        // element walk at rc==1, then the buffer
            s = s.write("    add sp, sp, #16\n");
        } else if (op.kind == "deep_struct_drop") {
            var fsan: string = asmcore.sanitize_label(op.ty);
            s = s.need("struct_drop:" + op.ty);
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // inner = box.field_k
            s = s.write("    cmp x0, #16, lsl #12\n");              // null / low -> skip field-release
            s = s.write("    blo .Lasd_" + san + "_sdf" + ks + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_rc_is_unique\n");       // shared (rc>1) -> skip field-release
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    cbz x0, .Lasd_" + san + "_sdf" + ks + "\n");
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // reload inner (x10 valid here)
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___struct_drop_" + fsan + "\n");  // release inner's rc fields (clobbers x10)
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box (struct_drop clobbered x10)
            s = s.write(".Lasd_" + san + "_sdf" + ks + ":\n");
        } else if (op.kind == "deep_enum_drop") {
            // A direct enum field's live-variant rc payloads; __enum_drop_ applies
            // the rc==1 gate and the null guard itself, and the arr_dec directive
            // that follows frees the enum box. It clobbers x10, so reload the box.
            var edsan: string = asmcore.sanitize_label(op.ty);
            s = s.need("enum_drop:" + op.ty);
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // enum box = box.field_k
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___enum_drop_" + edsan + "\n");
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box
        } else if (op.kind == "str_free") {
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // box.field_k string box
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_str_free\n");           // rc-aware: free rc==1, dec rc>1, skip view/literal rc<0
            s = s.write("    add sp, sp, #16\n");
            // str_free clobbers x10 (freelist-head scratch) — reload the box
            // from the frame-relative stack arg so a LATER field's arm reads
            // a valid pointer. Before this, a string field ordered BEFORE
            // another rc field left x10 stale and the next arm freed through
            // garbage (the .ret reload only covered the RETURN, not the loop).
            s = s.write("    ldr x10, [sp, #16]\n");
        } else if (op.kind == "str_arr_free") {
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // box.field_k string[] buffer
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_str_arr_free\n");       // deep at rc==1 (elements + buffer); shared -> dec
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box (helper clobbers x10/x11/x12)
        } else if (op.kind == "arr_dec") {
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // box.field_k buffer / nested box / enum box / closure box / fn-ptr array buffer (shallow, no element walk)
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_arr_dec\n");
            s = s.write("    add sp, sp, #16\n");
        }
        oi = oi + 1;
    }
    s = s.write(".Lasd_" + san + "_ret:\n");
    // Return the BOX (the documented contract) by reloading the stack arg —
    // NOT `mov x0, x10`: __fern_str_free and a nested __struct_drop_* bl
    // clobber x10/x11/x12 (the slice-2 field-reclaim lesson), so a string /
    // deep-struct field release left x10 stale and the enum-payload deep-drop
    // (which CONSUMES this return for its payload-box free) dec'd a garbage /
    // already-freed pointer. The arg sits at [sp, #16] under the stp frame.
    s = s.write("    ldr x0, [sp, #16]\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_struct_arr_elems_drop_one is the arm64 transcription of
// asm_ir.emit_ir_struct_arr_elems_drop_one: __struct_arr_elems_drop_<E>(buffer) walks a
// uniquely-owned buffer and, per uniquely-owned element box, calls __struct_drop_<E> to
// release the element's OWN rc fields (the level the shallow k_box walk leaked). It frees
// neither the element boxes nor the buffer — the k_box caller's arr_dec does that. Stack-
// arg ABI: [sp]=buffer at entry (at [sp, #32] after the two stp saves). x19=buffer,
// x20=index are callee-saved so they survive the nested __struct_drop_<E> call (which
// clobbers x10/x11/x12) and the arr_dec/is_unique calls (x0..x3,x9). Buffer + each element
// are is_unique-gated. `.weak`, per-unit, needs __struct_drop_<E>.
function emit_arm64_struct_arr_elems_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.need("struct_drop:" + ety);
    s = s.write(".weak __fn___struct_arr_elems_drop_" + san + "\n");
    s = s.write("__fn___struct_arr_elems_drop_" + san + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");             // save FP/LR for the bls
    s = s.write("    stp x19, x20, [sp, #-16]!\n");             // save callee-saved x19/x20
    s = s.write("    ldr x19, [sp, #32]\n");                    // buffer (arg + 32 for two stp saves)
    s = s.write("    cmp x19, #16, lsl #12\n");                 // null / low -> nothing to walk
    s = s.write("    blo .Lsaed_" + san + "_ret\n");
    s = s.write("    str x19, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");           // shared buffer -> elements shared -> skip
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Lsaed_" + san + "_ret\n");
    s = s.write("    mov x20, #0\n");                           // i = 0
    s = s.write(".Lsaed_" + san + "_loop:\n");
    s = s.write("    ldr x0, [x19]\n");                         // len = buffer[0]
    s = s.write("    cmp x20, x0\n");
    s = s.write("    bge .Lsaed_" + san + "_ret\n");            // i >= len -> done
    s = s.write("    add x1, x20, #1\n");
    s = s.write("    ldr x0, [x19, x1, lsl #3]\n");             // elem = buffer[(i+1)*8]
    s = s.write("    cmp x0, #16, lsl #12\n");                  // null / low -> skip
    s = s.write("    blo .Lsaed_" + san + "_next\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");           // shared element (aliased out) -> skip
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Lsaed_" + san + "_next\n");
    s = s.write("    add x1, x20, #1\n");                       // recompute elem (x1 clobbered by call)
    s = s.write("    ldr x0, [x19, x1, lsl #3]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___struct_drop_" + san + "\n");     // release elem's OWN rc fields
    s = s.write("    add sp, sp, #16\n");
    s = s.write(".Lsaed_" + san + "_next:\n");
    s = s.write("    add x20, x20, #1\n");
    s = s.write("    b .Lsaed_" + san + "_loop\n");
    s = s.write(".Lsaed_" + san + "_ret:\n");
    s = s.write("    mov x0, x19\n");                           // return buffer (caller dec's it)
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_enum_arr_elems_drop_one is the arm64 transcription of
// asm_ir.emit_ir_enum_arr_elems_drop_one: __enum_arr_elems_drop_<E>(buffer)
// walks a uniquely-owned enum-array buffer, shape-dispatches each uniquely-
// owned element (box@0 against the interned variant labels) and decs the
// matched variant's leak-safe-array payload fields via the rc-guarded
// __fern_arr_dec. x19=buffer, x20=index, x21=element survive the calls.
// emit_arm64_enum_variant_payload_decs is emit_ir_enum_variant_payload_decs'
// arm64 twin: the tag dispatch releasing enum `ety`'s rc payloads for the box in
// `reg`, branching to `done` once a matching variant is handled. `reg` must be
// callee-saved — the helper calls out per payload.
function emit_arm64_enum_variant_payload_decs(s: asmcore.EmitState, ety: string, reg: string, lp: string, done: string): asmcore.EmitState {
    var vi: i32 = 0;
    var vlabel: i32 = 0;
    while (vi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[vi].enum_owner == ety) {
            var offs: i32[] = irlower.enum_walk_payload_offsets(s.struct_decls, s.struct_decls.decls[vi].name);
            if (offs.len() > 0) {
                var vlo: asmcore.ShapeRefOut = asmcore.shape_ref(s, s.struct_decls.decls[vi].name);
                s = vlo.state;
                var vls: string = util.i32_to_string(vlabel);
                s = s.write("    ldr x0, [" + reg + "]\n");     // shape ptr @0
                s = s.write("    adrp x1, " + vlo.label + "\n");
                s = s.write("    add x1, x1, :lo12:" + vlo.label + "\n");
                s = s.write("    cmp x0, x1\n");
                s = s.write("    bne " + lp + "_v" + vls + "\n");
                var oi: i32 = 0;
                while (oi < offs.len()) {
                    s = s.write("    ldr x0, [" + reg + ", #" + util.i32_to_string(offs[oi]) + "]\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.write("    bl __fn___fern_arr_dec\n");
                    s = s.write("    add sp, sp, #16\n");
                    oi = oi + 1;
                }
                s = s.write("    b " + done + "\n");
                s = s.write(lp + "_v" + vls + ":\n");
                vlabel = vlabel + 1;
            }
        }
        vi = vi + 1;
    }
    return s;
}

// emit_arm64_enum_drop_one emits __enum_drop_<E>(box) -> box, the arm64 twin of
// emit_ir_enum_drop_one: release ONE enum box's live-variant rc payloads, sole-
// ownership gated, leaving the box itself to the caller's dec (#8567).
function emit_arm64_enum_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.write(".weak __fn___enum_drop_" + san + "\n");
    s = s.write("__fn___enum_drop_" + san + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    ldr x19, [sp, #32]\n");                    // box (arg + 32 for two stp saves)
    s = s.write("    cmp x19, #16, lsl #12\n");
    s = s.write("    blo .Led_" + san + "_ret\n");
    s = s.write("    str x19, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Led_" + san + "_ret\n");
    s = emit_arm64_enum_variant_payload_decs(s, ety, "x19", ".Led_" + san, ".Led_" + san + "_ret");
    s = s.write(".Led_" + san + "_ret:\n");
    s = s.write("    mov x0, x19\n");                           // return box (caller decs it)
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

function emit_arm64_enum_arr_elems_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.write(".weak __fn___enum_arr_elems_drop_" + san + "\n");
    s = s.write("__fn___enum_arr_elems_drop_" + san + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    stp x21, x22, [sp, #-16]!\n");
    s = s.write("    ldr x19, [sp, #48]\n");                    // buffer (arg + 48 for three stp saves)
    s = s.write("    cmp x19, #16, lsl #12\n");
    s = s.write("    blo .Leaed_" + san + "_ret\n");
    s = s.write("    str x19, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");           // shared buffer -> elements shared -> skip
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Leaed_" + san + "_ret\n");
    s = s.write("    mov x20, #0\n");                           // i = 0
    s = s.write(".Leaed_" + san + "_loop:\n");
    s = s.write("    ldr x0, [x19]\n");                         // len = buffer[0]
    s = s.write("    cmp x20, x0\n");
    s = s.write("    bge .Leaed_" + san + "_ret\n");
    s = s.write("    add x1, x20, #1\n");
    s = s.write("    ldr x21, [x19, x1, lsl #3]\n");            // elem = buffer[(i+1)*8]
    s = s.write("    cmp x21, #16, lsl #12\n");
    s = s.write("    blo .Leaed_" + san + "_next\n");
    s = s.write("    str x21, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");           // shared element (aliased out) -> skip
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Leaed_" + san + "_next\n");
    s = emit_arm64_enum_variant_payload_decs(s, ety, "x21", ".Leaed_" + san, ".Leaed_" + san + "_next");
    s = s.write(".Leaed_" + san + "_next:\n");
    s = s.write("    add x20, x20, #1\n");
    s = s.write("    b .Leaed_" + san + "_loop\n");
    s = s.write(".Leaed_" + san + "_ret:\n");
    s = s.write("    mov x0, x19\n");                           // return buffer (caller decs it)
    s = s.write("    ldp x21, x22, [sp], #16\n");
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// ======================= IR-PATH RUNTIME =======================
// emit_ir_runtime is the arm64 IR path's copy of the runtime-library helper
// bodies (the sibling of x86's asm_ir.emit_ir_runtime), a near-verbatim copy
// of asm_arm64.emit_runtime differing only in that its Fern-source helpers
// lower through emit_ir_runtime_fern_fn (the IR selector) rather than the AST
// emit_function. emit_ldc / emit_ccall_shim1_arm64 / emit_ccall_shims_arm64 /
// emit_rodata_pools_arm64 live alongside it because emit_ir_runtime calls them.

function emit_ldc(s: asmcore.EmitState, reg: string, lbl: string): asmcore.EmitState {
    s = s.write("    adrp x12, " + lbl + "\n");
    s = s.write("    add x12, x12, :lo12:" + lbl + "\n");
    s = s.write("    ldr " + reg + ", [x12]\n");
    return s;
}

function emit_ccall_shim1_arm64(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
    s = s.write("\n__fn_" + variant + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
    s = s.write("    ldr x9, [x29, #16]\n");
    if (n >= 1) { s = s.write("    ldr x0, [x29, #32]\n"); }
    if (n >= 2) { s = s.write("    ldr x1, [x29, #48]\n"); }
    if (n >= 3) { s = s.write("    ldr x2, [x29, #64]\n"); }
    if (n >= 4) { s = s.write("    ldr x3, [x29, #80]\n"); }
    s = s.write("    blr x9\n");
    s = s.write("    ldp x29, x30, [sp], #16\n    ret\n");
    return s;
}

function emit_ccall_shims_arm64(s: asmcore.EmitState): asmcore.EmitState {
    var ca: i32 = 0;
    while (ca <= 4) {
        var cbase: string = "__c_call" + util.i32_to_string(ca);
        if (s.has_need("ccall:" + cbase)) { s = emit_ccall_shim1_arm64(s, cbase, ca); }
        if (s.has_need("ccall:" + cbase + "_f32")) { s = emit_ccall_shim1_arm64(s, cbase + "_f32", ca); }
        if (s.has_need("ccall:" + cbase + "_f64")) { s = emit_ccall_shim1_arm64(s, cbase + "_f64", ca); }
        ca = ca + 1;
    }
    return s;
}

pub function emit_rodata_pools_arm64(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // The self-relocation anchor and the bounds of the two regions holding
    // absolute pointers, read by emit_ir_reloc's startup loop (#7112). The
    // anchor's `.quad` names ITSELF, so it holds this image's LINK-TIME base
    // for that word while `adrp` yields the runtime one — their difference is
    // the load slide, with no relocation needed to learn it.
    //
    // Gated on the SAME condition as the loop that reads them. A per-module
    // build links several units into one image and runs this per unit, so an
    // ungated emit defines every one of these labels once per unit and the
    // assembler rejects the duplicates.
    var reloc: boolean = reloc_wanted(s, darwin);
    if (reloc) {
        s = s.write("    .section .data\n    .align 8\n");
        s = s.write(".Lfern_relanchor:\n    .quad .Lfern_relanchor\n");
    }
    // Each region's begin label repeats the `.align 8` its blocks are emitted
    // under, so the label lands ON the first block rather than on the padding
    // before it — `.align n` is 2^n, so that is 256 bytes of slack, and a walk
    // starting in it reads zeroes as a block header.
    if (reloc) { s = s.write("    .align 8\n.Lfern_sbox_begin:\n"); }
    if (s.string_lits.len() > 0) {
        s = asmcore.emit_str_box_data_from(s, 0);
    }
    if (reloc) { s = s.write("    .section .data\n.Lfern_sbox_end:\n"); }
    // .data: one block per static aggregate constant (#6149), after the string
    // pool because a block's first word is a shape POINTER into it.
    if (reloc) { s = s.write("    .align 8\n.Lfern_cagg_begin:\n"); }
    s = asmcore.emit_const_agg_data(s);
    if (reloc) { s = s.write("    .section .data\n.Lfern_cagg_end:\n"); }
    s = asmcore.emit_shape_lits_from(s, 0);
    // Hand back `.text`, which every caller emitting code after this one needs
    // and the per-module pool site already restores by hand. It used to hold by
    // accident: a program with no pooled data emitted nothing here and never
    // left `.text` in the first place. The anchor above always emits, so a
    // runtime helper appended after this would have been assembled INTO `.data`
    // — its label then is not a text label, and the `bl` at its call site fails
    // to resolve rather than mis-linking silently.
    s = s.write("    .text\n");
    return s;
}

// emit_rt_clock_and_print emits the FFI call shims, print_int, and the clock / sleep helpers
// (now_unix_ms, monotonic_ns, now_ns, sleep_ms, sleep_ns), which every module gets.
function emit_rt_clock_and_print(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // FFI __c_call<n> shims (#4375): allocation-free arg-marshal + `blr fn`.
    s = emit_ccall_shims_arm64(s);
    // __fern_print_int, __fern_print_str, __fern_putchar and __fern_eprint_str are
    // Fern runtime functions now (#2649): asmcore.rt_src_print_int /
    // rt_src_print_str / rt_src_putchar / rt_src_eprint_str, lowered through the IR
    // pipeline via emit_ir_runtime_fern_fn below. They are emitted HERE, with the
    // clocks, rather than in emit_rt_io_and_string, because that function takes no
    // `darwin` and the syscall number has to be baked per target — and because they
    // allocate nothing, so a print-only program must link without the heap runtime.
    // The clocks are Fern runtime functions now (#2649):
    // asmcore.rt_src_clock, need-gated, lowered through the IR pipeline as
    // __fn___fern_{monotonic_ns,now_unix_ms,now_ns}. They are emitted HERE
    // rather than with the fs bundle because they are heap-independent — a
    // pure-scalar program that times something must still link — and because
    // emit_rt_clock_and_print runs before the fs bundle, which is what lets
    // op_temp_dir's monotonic_ns need reach them.
    //
    // __fern_scratch is the fixed buffer the kernel writes the timespec /
    // timeval / struct stat into (reused, never freed, so no per-call leak),
    // reached through the __raw_scratch op. It moved out of emit_rt_fs for the
    // same heap-independence reason: gating it on the fs runtime left a scalar
    // timing program referencing a slot nothing defined. Same gate as asm_ir's.
    var ctgt: string = "arm64-linux";
    if (darwin) { ctgt = "arm64-darwin"; }
    if (s.any_need([
        "monotonic_ns", "now_unix_ms", "now_ns", "stat", "lstat",
        "read_file", "read_file_bytes", "random_i32", "sleep_ms",
        "sleep_ns", "set_file_times", "statfs", "poll", "proc_waitpid",
        "proc_waitpid_nohang",
        "timer_fd", "tcp_listen", "tcp_local_port", "tcp_connect", "print_int", "putchar",
        "eprint", "read_int", "udp_send", "isatty", "window_size", "set_window_size", "termios_get", "termios_set",
        "rlimit_nofile", "signal_ignore", "signal_default", "signal_mask",
        "signal_disposition", "access",
        "geteuid", "getegid", "getuid", "getgid", "getgroups", "environ",
        "fd_stat", "raw_scratch", "fd_fsync", "fd_fdatasync", "fd_syncfs", "sync"
    ])) {
        s = s.write("    .section .bss\n    .align 8\n__fern_scratch: .skip " + asmcore.scratch_size(ctgt, s.has_need("statfs")) + "\n    .section .text\n");
    }
    if (!darwin && s.any_need(["reader_splice", "raw_splice_pipe"])) {
        s = s.write("    .section .bss\n    .p2align 3\n__fern_splice_pipe: .quad 0, 0\n    .text\n");
    }
    if (s.has_need("read_int")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_read_int(ctgt), s.struct_decls, s);
    }
    if (s.has_need("read_all_stdin")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_read_all_stdin(ctgt), s.struct_decls, s);
    }
    if (s.has_need("str_read_line")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_read_line(ctgt), s.struct_decls, s);
    }
    if (s.has_need("str_print")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_print_str(ctgt), s.struct_decls, s);
    }
    if (s.has_need("print_int")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_print_int(ctgt), s.struct_decls, s);
    }
    if (s.has_need("putchar")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_putchar(ctgt), s.struct_decls, s);
    }
    if (s.has_need("eprint")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_eprint_str(ctgt), s.struct_decls, s);
    }
    if (s.has_need("now_unix_ms")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock("now_unix_ms", ctgt), s.struct_decls, s);
    }
    if (s.has_need("now_ns")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock("now_ns", ctgt), s.struct_decls, s);
    }
    if (s.has_need("monotonic_ns")) {
        if (darwin) {
            // The one clock with no Fern form. XNU has no clock_gettime
            // syscall, and its monotonic clock on Apple Silicon is not a
            // syscall at all: mach_absolute_time reads the architectural
            // counter CNTVCT_EL0 (EL0-readable) and scales it by CNTFRQ_EL0
            // (24 MHz on Apple Silicon). Fern has no system-register-read
            // intrinsic, so this stays hand-written — under the __fn___ name
            // the Fern siblings use, since a zero-arg helper's stack and
            // register conventions coincide and the call site should not have
            // to know which one it got.
            //
            // ns = (count/freq)*1e9 + ((count%freq)*1e9)/freq, split that way
            // to avoid the u64 overflow a bare count*1e9 hits over long uptimes.
            s = s.write("__fn___fern_monotonic_ns:\n");
            s = s.write("    stp x29, x30, [sp, #-16]!\n");
            s = s.write("    mov x29, sp\n");
            s = s.write("    mrs x9, cntvct_el0\n");      // count
            s = s.write("    mrs x10, cntfrq_el0\n");     // freq (Hz)
            s = s.write("    udiv x11, x9, x10\n");       // sec = count / freq
            s = s.write("    msub x12, x11, x10, x9\n");  // rem = count - sec*freq
            s = s.write("    ldr x13, =1000000000\n");
            s = s.write("    mul x11, x11, x13\n");       // sec * 1e9
            s = s.write("    mul x12, x12, x13\n");       // rem * 1e9
            s = s.write("    udiv x12, x12, x10\n");      // (rem*1e9) / freq
            s = s.write("    add x0, x11, x12\n");        // ns
            s = s.write("    ldp x29, x30, [sp], #16\n");
            s = s.write("    ret\n");
        } else {
            s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock("monotonic_ns", ctgt), s.struct_decls, s);
        }
    }
    return s;
}

// emit_rt_hostname_darwin is `hostname()` on arm64-darwin, under the __fn___
// name the Fern-compiled Linux body carries so the call site cannot tell
// them apart. XNU has no uname syscall — libc builds one out of sysctl — so
// this asks sysctl({CTL_KERN, KERN_HOSTNAME}) (BSD 202) directly, six
// arguments and the carry flag for failure, which is why it is not a
// __syscallN body: the widest intrinsic takes five. The name lands in a
// stack buffer; the box is built exactly as `__raw_alloc` + `__raw_string`
// compile — one 24-byte-headed block from __fern_alloc, bytes copied in,
// __fern_str_box_hdr stamping the fused header. A refused sysctl is an
// empty name.
//
// Frame: mib (8) + oldlen (8) + 400 bytes of name = 416 below the saved
// callee registers.
function emit_rt_hostname_darwin(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fn___fern_hostname:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    sub sp, sp, #416\n");
    s = s.write("    mov w0, #1\n");                 // CTL_KERN
    s = s.write("    mov w1, #10\n");                // KERN_HOSTNAME
    s = s.write("    stp w0, w1, [sp]\n");           // mib[2]
    s = s.write("    mov x0, #384\n");
    s = s.write("    str x0, [sp, #8]\n");           // oldlen = buffer room
    s = s.write("    mov x0, sp\n");                 // name
    s = s.write("    mov x1, #2\n");                 // namelen
    s = s.write("    add x2, sp, #16\n");            // oldp
    s = s.write("    add x3, sp, #8\n");             // oldlenp
    s = s.write("    mov x4, #0\n");                 // newp
    s = s.write("    mov x5, #0\n");                 // newlen
    s = s.write("    mov x16, #202\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    mov x20, #0\n");                // length
    s = s.write("    b.cs .Lhostname_box\n");        // carry set = error: empty
    s = s.write("    add x19, sp, #16\n");           // name bytes
    s = s.write(".Lhostname_strlen:\n");
    s = s.write("    ldrb w0, [x19, x20]\n");
    s = s.write("    cbz w0, .Lhostname_box\n");
    s = s.write("    add x20, x20, #1\n");
    s = s.write("    b .Lhostname_strlen\n");
    s = s.write(".Lhostname_box:\n");
    s = s.write("    add x0, x20, #24\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    add x0, x0, #24\n");            // data (raw_alloc's shape)
    s = s.write("    mov x1, #0\n");
    s = s.write(".Lhostname_copy:\n");
    s = s.write("    cmp x1, x20\n");
    s = s.write("    b.hs .Lhostname_copied\n");
    s = s.write("    ldrb w2, [x19, x1]\n");
    s = s.write("    strb w2, [x0, x1]\n");
    s = s.write("    add x1, x1, #1\n");
    s = s.write("    b .Lhostname_copy\n");
    s = s.write(".Lhostname_copied:\n");
    s = s.write("    mov x1, x20\n");
    s = s.write("    bl __fern_str_box_hdr\n");       // x0 = box
    s = s.write("    add sp, sp, #416\n");
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_rt_uname_field_darwin is `uname_field(i)` on arm64-darwin, the sibling
// of emit_rt_hostname_darwin: XNU has no uname syscall, so the record is five
// sysctl names and the index picks one. Six arguments and the carry flag for
// failure, which is why it is not a __syscallN body. The argument arrives on
// the operand stack, at #48 once the three callee-saved slots are pushed. An
// index naming no field leaves the length at zero, so the copy is skipped and
// the answer is the empty string — the same answer a refused sysctl gets.
//
// Frame: mib (8) + oldlen (8) + 400 bytes of value = 416 below the saved
// callee registers.
function emit_rt_uname_field_darwin(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fn___fern_uname_field:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    str x21, [sp, #-16]!\n");
    s = s.write("    ldr x21, [sp, #48]\n");        // the field index
    s = s.write("    sub sp, sp, #416\n");
    s = s.write("    mov x20, #0\n");               // length
    s = s.write("    cmp w21, #0\n");
    s = s.write("    b.lt .Lunamef_box\n");
    s = s.write("    cmp w21, #5\n");
    s = s.write("    b.ge .Lunamef_box\n");
    s = s.write("    mov w0, #1\n");                // CTL_KERN
    s = s.write("    mov w1, #1\n");                // 0: kern.ostype
    s = s.write("    cmp w21, #1\n");
    s = s.write("    b.ne .Lunamef_m2\n");
    s = s.write("    mov w1, #10\n");               // 1: kern.hostname
    s = s.write("    b .Lunamef_mib\n");
    s = s.write(".Lunamef_m2:\n");
    s = s.write("    cmp w21, #2\n");
    s = s.write("    b.ne .Lunamef_m3\n");
    s = s.write("    mov w1, #2\n");                // 2: kern.osrelease
    s = s.write("    b .Lunamef_mib\n");
    s = s.write(".Lunamef_m3:\n");
    s = s.write("    cmp w21, #3\n");
    s = s.write("    b.ne .Lunamef_m4\n");
    s = s.write("    mov w1, #4\n");                // 3: kern.version
    s = s.write("    b .Lunamef_mib\n");
    s = s.write(".Lunamef_m4:\n");
    s = s.write("    cmp w21, #4\n");
    s = s.write("    b.ne .Lunamef_mib\n");
    s = s.write("    mov w0, #6\n");                // 4: hw.machine
    s = s.write("    mov w1, #1\n");
    s = s.write(".Lunamef_mib:\n");
    s = s.write("    stp w0, w1, [sp]\n");          // mib[2]
    s = s.write("    mov x0, #384\n");
    s = s.write("    str x0, [sp, #8]\n");          // oldlen = buffer room
    s = s.write("    mov x0, sp\n");                // name
    s = s.write("    mov x1, #2\n");                // namelen
    s = s.write("    add x2, sp, #16\n");           // oldp
    s = s.write("    add x3, sp, #8\n");            // oldlenp
    s = s.write("    mov x4, #0\n");                // newp
    s = s.write("    mov x5, #0\n");                // newlen
    s = s.write("    mov x16, #202\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    b.cs .Lunamef_box\n");         // carry set = error: empty
    s = s.write("    add x19, sp, #16\n");
    s = s.write(".Lunamef_strlen:\n");
    s = s.write("    ldrb w0, [x19, x20]\n");
    s = s.write("    cbz w0, .Lunamef_box\n");
    s = s.write("    add x20, x20, #1\n");
    s = s.write("    b .Lunamef_strlen\n");
    s = s.write(".Lunamef_box:\n");
    s = s.write("    add x0, x20, #24\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    add x0, x0, #24\n");           // data (raw_alloc's shape)
    s = s.write("    mov x1, #0\n");
    s = s.write(".Lunamef_copy:\n");
    s = s.write("    cmp x1, x20\n");
    s = s.write("    b.hs .Lunamef_copied\n");
    s = s.write("    ldrb w2, [x19, x1]\n");
    s = s.write("    strb w2, [x0, x1]\n");
    s = s.write("    add x1, x1, #1\n");
    s = s.write("    b .Lunamef_copy\n");
    s = s.write(".Lunamef_copied:\n");
    s = s.write("    mov x1, x20\n");
    s = s.write("    bl __fern_str_box_hdr\n");     // x0 = box
    s = s.write("    add sp, sp, #416\n");
    s = s.write("    ldr x21, [sp], #16\n");
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_rt_cpu_count_darwin is `cpu_count()` on arm64-darwin. XNU has no
// affinity mask; `hw.activecpu` is the same question there, and is what
// sysconf(_SC_NPROCESSORS_ONLN) reads. A refused sysctl answers 0, which is
// the builtin's "cannot say".
//
// Frame: mib (8) + oldlen (8) + the int (4, padded) = 32.
function emit_rt_cpu_count_darwin(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fn___fern_cpu_count:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    sub sp, sp, #32\n");
    s = s.write("    mov w0, #6\n");                // CTL_HW
    s = s.write("    mov w1, #25\n");               // HW_AVAILCPU
    s = s.write("    stp w0, w1, [sp]\n");          // mib[2]
    s = s.write("    mov x0, #4\n");
    s = s.write("    str x0, [sp, #8]\n");          // oldlen = sizeof(int)
    s = s.write("    mov x0, sp\n");                // name
    s = s.write("    mov x1, #2\n");                // namelen
    s = s.write("    add x2, sp, #16\n");           // oldp
    s = s.write("    add x3, sp, #8\n");            // oldlenp
    s = s.write("    mov x4, #0\n");                // newp
    s = s.write("    mov x5, #0\n");                // newlen
    s = s.write("    mov x16, #202\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    mov w0, #0\n");
    s = s.write("    b.cs .Lcpucount_done\n");      // carry set = error: 0
    s = s.write("    ldr w0, [sp, #16]\n");
    s = s.write(".Lcpucount_done:\n");
    s = s.write("    add sp, sp, #32\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_rt_readiness emits the readiness primitives — poll, timer_fd, and the wasm
// pollable shims (timer_pollable, pollable_drop, block, poll).
function emit_rt_readiness(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // poll: builds the pollfd[] and calls ppoll (arm64 Linux has no poll(2)).
    // Fern now — asmcore.rt_src_poll, need-gated below with the other migrated
    // helpers. Darwin has neither call in reach, and its arm answers -1 exactly
    // as the hand-asm did.
    // timer_fd is Fern now (#2649) — see the migrated-helpers section below.
    if (s.has_need("wasm_timer_pollable")) {
        s = s.write(".globl __fern_wasm_timer_pollable\n");
        s = s.write(".type __fern_wasm_timer_pollable, %function\n");
        s = s.write("__fern_wasm_timer_pollable:\n");
        s = s.write("    mov x0, #-1\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_wasm_timer_pollable, .-__fern_wasm_timer_pollable\n");
    }
    // __fern_wasm_pollable_drop(x0 = p) -> 0: a pollable is just an fd on native
    // (closed via tcp_close), nothing to drop. Portability shim for fetch_future.
    if (s.has_need("wasm_pollable_drop")) {
        s = s.write(".globl __fern_wasm_pollable_drop\n");
        s = s.write(".type __fern_wasm_pollable_drop, %function\n");
        s = s.write("__fern_wasm_pollable_drop:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_wasm_pollable_drop, .-__fern_wasm_pollable_drop\n");
    }
    // __fern_wasm_block(x0 = p) -> 0: no native pollable to wait on (a deadline
    // uses poll(2)'s timeout arg), so blocking is a 0 no-op. Portability shim
    // for the reactor's with_deadline.
    if (s.has_need("wasm_block")) {
        s = s.write(".globl __fern_wasm_block\n");
        s = s.write(".type __fern_wasm_block, %function\n");
        s = s.write("__fern_wasm_block:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_wasm_block, .-__fern_wasm_block\n");
    }
    // __fern_wasm_poll(x0 = pollables) -> -1: no real native pollables (readiness
    // uses poll(2) directly), so nothing is ready; ignores its array arg.
    // Portability shim for the wasm reactor's poll.
    if (s.has_need("wasm_poll")) {
        s = s.write(".globl __fern_wasm_poll\n");
        s = s.write(".type __fern_wasm_poll, %function\n");
        s = s.write("__fern_wasm_poll:\n");
        s = s.write("    mov x0, #-1\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_wasm_poll, .-__fern_wasm_poll\n");
    }
    return s;
}

// emit_rt_io_and_string emits stdin/stdout helpers and the string runtime — read_int,
// str_print, putchar, concat / eq / cmp / search, the int-to-string family,
// chr, case folding, repeat, eprint.
function emit_rt_io_and_string(s: asmcore.EmitState): asmcore.EmitState {
    // __fern_read_int and __fern_read_all_stdin are Fern runtime functions (#2649):
    // asmcore.rt_src_read_int / rt_src_read_all_stdin, emitted with the clocks in
    // emit_rt_clock_and_print, which is where the per-target syscall number is
    // available.
    // __fern_print_str and __fern_putchar are Fern runtime functions (#2649):
    // asmcore.rt_src_print_str / rt_src_putchar, emitted with the clocks in
    // emit_rt_clock_and_print, which is where the per-target syscall number is
    // available.
    // __fern_str_concat is now a Fern runtime function (#2649, via the raw-memory
    // intrinsics): see asmcore.rt_src_str_concat. The single shared body serves
    // both arm64 AST + IR; called via the __fn_ stack convention. heap-only dep.
    if (s.has_need("str_concat")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_concat(), s.struct_decls, s);
    }
    // __fern_str_eq: hand-written, see rt_arm64_str_eq for why. One
    // __fn___fern_str_eq body serves both the arm64 AST and IR call sites
    // (shared emit_runtime) and the hand-asm map/arr_str internals (all set
    // x0=A/x1=B before the call).
    if (s.has_need("str_eq")) {
        s = s.write(rt_arm64_str_eq());
    }
    // __fern_map_find (#2649): the map runtime's shared key search — one Fern
    // body where map_set, map_get and map_has each carried a string, an i32 and
    // a struct/enum copy of the same loop in hand-asm, and __fern_map_delete a
    // fourth in Fern. Gated on `maps` rather than a need of its own, unlike
    // map_delete: all three hand-asm bodies in the maps bundle call it.
    if (s.has_need("maps")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_map_find(), s.struct_decls, s);
    }
    // __fern_map_delete (#2649): `m.without(k)` as a Fern helper rather than
    // hand-asm, the same single source the x86 backend emits. Gated on its own
    // need rather than on `maps` — see the x86 twin for why.
    if (s.has_need("map_delete_rel")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_map_delete_rel(), s.struct_decls, s);
    }
    if (s.has_need("map_delete")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_map_delete(), s.struct_decls, s);
    }
    // __fern_str_cmp is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_cmp, lowered through asm_arm64's normal function
    // emitter. The single __fn___fern_str_cmp body serves BOTH the arm64 AST and
    // IR call sites (they share this emit_runtime).
    if (s.has_need("str_cmp")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_cmp(), s.struct_decls, s);
    }
    // __fern_read_line is a Fern runtime function (#2649): asmcore.rt_src_read_line,
    // emitted with the other stdin leaves. Its one-byte-per-syscall loop (#6052) and
    // 256-byte cap are preserved; the Option and string boxes are rc-headered now.
    // __fern_i32_to_string is now a Fern runtime function (#2649, via the
    // raw-memory intrinsics): see asmcore.rt_src_i32_to_string. The single shared
    // __fn___fern_i32_to_string body serves both arm64 AST + IR, replacing the old
    // register-ABI body + its stack-arg IR wrapper. heap-only dep.
    if (s.has_need("i32_to_string")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_to_string(), s.struct_decls, s);
    }
    // __fern_u32_to_string (#2649): the UNSIGNED sibling for `(u32).to_string()`.
    // Single shared body for arm64 AST + IR; heap-only dep. See
    // asmcore.rt_src_u32_to_string.
    if (s.has_need("u32_to_string")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_u32_to_string(), s.struct_decls, s);
    }
    // __fern_i64_to_string / __fern_u64_to_string: width-correct siblings for
    // 64-bit `.to_string()` receivers; heap-only deps. See asmcore.rt_src_*.
    if (s.has_need("i64_to_string")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i64_to_string(), s.struct_decls, s);
    }
    if (s.has_need("u64_to_string")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_u64_to_string(), s.struct_decls, s);
    }
    // __fern_str_to_i32 is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_to_i32, lowered through asm_arm64's normal function
    // emitter. The single __fn___fern_str_to_i32 body serves BOTH the arm64 AST
    // and IR call sites (they share this emit_runtime), replacing the old
    // register-ABI body + its stack-arg IR wrapper.
    if (s.has_need("str_to_i32")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_i32(), s.struct_decls, s);
    }
    // __fern_chr is now a Fern runtime function (#2649): see asmcore.rt_src_chr,
    // emitted (need-gated on chr) in the migrated-helpers section below via the
    // raw-memory intrinsics. The single shared body serves both arm64 AST + IR.
    if (s.has_need("chr")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_chr(), s.struct_decls, s);
    }
    // __fern_str_to_upper / __fern_str_to_lower — Fern runtime functions (#2649)
    // via the raw-memory intrinsics; both gated on the single str_case need (the
    // shared body serves arm64 AST + IR).
    if (s.has_need("str_case")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_upper(), s.struct_decls, s);
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_lower(), s.struct_decls, s);
    }
    // __fern_str_repeat — Fern runtime function (#2649) via the raw-memory
    // intrinsics; single shared body for arm64 AST + IR. heap-only dep.
    if (s.has_need("str_repeat")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_repeat(), s.struct_decls, s);
    }
    // __fern_eprint_str is a Fern runtime function (#2649): asmcore.rt_src_eprint_str,
    // emitted with the clocks in emit_rt_clock_and_print. Its newline byte comes from
    // the static __fern_scratch rather than a stack slot — which also retires the
    // `strb w1, [sp, #-16]!` hazard of #6083: the in-process assembler has no
    // byte-store encoder for that pre-index writeback, so it dropped the `!`, left sp
    // unchanged, and the paired `add sp, sp, #16` then raised sp by 16.
    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted
    // after this pool, inside the needs_heap block) can reference its
    // shape-name label. The helper's own add_string_lit dedups to this
    // slot; without the early intern the label would be undefined for
    // programs that never mention stat() themselves. Same for the
    // __fern_subprocess helper's "ProcessResult" shape name.
    return s;
}

// emit_rt_heap emits the heap: the lazily-mmap'd arena, the allocator, and the
// whole reference-counting runtime (retain / release / the per-shape drop and
// free helpers). By far the largest phase.
// emit_rt_arena_and_alloc emits the arena and the allocator: the lazily-mmap'd 16 GiB region,
// __fern_alloc and its freelist, the array / string box constructors, and the
// strbuf accumulator.
// emit_lc_report emits __fern_lc_report() — the census summary, cribbed from
// the NATIVE arm64 emitter's body (internal/codegen/arm64 emitLcReportRuntime)
// with its syscall abstraction replaced by the self-host mov x8 / svc form
// that darwinize already reskins for Mach-O. One stderr line:
//
//     leakcheck: allocs=<N> frees=<M> live_bytes=<K>
//
// K = alloc_bytes - free_bytes, signed, so an over-free shows negative
// rather than wrapping. Called from the _start epilogue and the exit()
// builtin, which park the exit code in x19 across the call — the helper and
// its two local subroutines touch caller-saved registers only. .globl: the
// exit op is emitted into ORDINARY generated code, which under
// -per-module-emit-all lands in a different unit from this (the entry's).
// Entry-only, alongside the counters it reads.
function emit_lc_report(s: asmcore.EmitState): asmcore.EmitState {
    if (!leak_check_on()) { return s; }
    // The counters live here rather than in the arena's .bss block: the
    // exit op calls the report in every program, heap-free ones included
    // (the x86 hev block's precedent), so nothing here may sit behind the
    // "heap" need.
    s = s.write("    .bss\n");
    s = s.write("    .align 3\n");
    s = s.write("__fern_lc_alloc_count: .quad 0\n");
    s = s.write("__fern_lc_alloc_bytes: .quad 0\n");
    s = s.write("__fern_lc_free_count: .quad 0\n");
    s = s.write("__fern_lc_free_bytes: .quad 0\n");
    s = s.write("    .section .rodata\n");
    s = s.write(".Llc_a:\n    .ascii \"leakcheck: allocs=\"\n");
    s = s.write(".Llc_f:\n    .ascii \" frees=\"\n");
    s = s.write(".Llc_l:\n    .ascii \" live_bytes=\"\n");
    s = s.write(".Llc_nl:\n    .ascii \"\\n\"\n");
    if (sanitize_on()) {
        // The texts must match the native backends' byte-for-byte: a
        // `fern-sanitizer:` line must not tell you which compiler built it.
        s = s.write(".Lsan_leak:\n    .ascii \"fern-sanitizer: leak \"\n");
        s = s.write(".Lsan_bytesin:\n    .ascii \" bytes in \"\n");
        s = s.write(".Lsan_blocks:\n    .ascii \" blocks\"\n");
    }
    s = s.write("    .text\n");
    s = s.write("    .globl __fern_lc_report\n");
    s = s.write("__fern_lc_report:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    adrp x1, .Llc_a\n");
    s = s.write("    add x1, x1, :lo12:.Llc_a\n");
    s = s.write("    mov x2, #18\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x9, __fern_lc_alloc_count\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_count\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Llc_f\n");
    s = s.write("    add x1, x1, :lo12:.Llc_f\n");
    s = s.write("    mov x2, #7\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x9, __fern_lc_free_count\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_free_count\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Llc_l\n");
    s = s.write("    add x1, x1, :lo12:.Llc_l\n");
    s = s.write("    mov x2, #12\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x9, __fern_lc_alloc_bytes\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_bytes\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    adrp x9, __fern_lc_free_bytes\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_free_bytes\n");
    s = s.write("    ldr x1, [x9]\n");
    s = s.write("    sub x0, x0, x1\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Llc_nl\n");
    s = s.write("    add x1, x1, :lo12:.Llc_nl\n");
    s = s.write("    mov x2, #1\n");
    s = s.write("    bl .Llc_write\n");
    if (sanitize_on()) {
        // Sanitizer leak VERDICT, after the summary. Only a POSITIVE balance
        // is a leak: zero is clean, and a negative one is an over-free, which
        // the over-release report names at the offending dec — calling that a
        // leak would be wrong twice over.
        s = s.write("    adrp x9, __fern_lc_alloc_bytes\n");
        s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_bytes\n");
        // x10 carries live_bytes across the writes: the two local subroutines
        // touch x0..x8 only, and x19 is the caller's parked exit code.
        s = s.write("    ldr x10, [x9]\n");
        s = s.write("    adrp x9, __fern_lc_free_bytes\n");
        s = s.write("    add x9, x9, :lo12:__fern_lc_free_bytes\n");
        s = s.write("    ldr x9, [x9]\n");
        s = s.write("    subs x10, x10, x9\n");     // live_bytes
        s = s.write("    b.le .Lsan_leak_done\n");
        s = s.write("    adrp x1, .Lsan_leak\n");
        s = s.write("    add x1, x1, :lo12:.Lsan_leak\n");
        s = s.write("    mov x2, #21\n");
        s = s.write("    bl .Llc_write\n");
        s = s.write("    mov x0, x10\n");
        s = s.write("    bl .Llc_wrnum\n");
        s = s.write("    adrp x1, .Lsan_bytesin\n");
        s = s.write("    add x1, x1, :lo12:.Lsan_bytesin\n");
        s = s.write("    mov x2, #10\n");
        s = s.write("    bl .Llc_write\n");
        s = s.write("    adrp x9, __fern_lc_alloc_count\n");
        s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_count\n");
        s = s.write("    ldr x0, [x9]\n");
        s = s.write("    adrp x9, __fern_lc_free_count\n");
        s = s.write("    add x9, x9, :lo12:__fern_lc_free_count\n");
        s = s.write("    ldr x9, [x9]\n");
        s = s.write("    sub x0, x0, x9\n");
        s = s.write("    bl .Llc_wrnum\n");
        s = s.write("    adrp x1, .Lsan_blocks\n");
        s = s.write("    add x1, x1, :lo12:.Lsan_blocks\n");
        s = s.write("    mov x2, #7\n");
        s = s.write("    bl .Llc_write\n");
        s = s.write("    adrp x1, .Llc_nl\n");
        s = s.write("    add x1, x1, :lo12:.Llc_nl\n");
        s = s.write("    mov x2, #1\n");
        s = s.write("    bl .Llc_write\n");
        s = s.write(".Lsan_leak_done:\n");
    }
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // .Llc_write(x1 = buf, x2 = len): one write(2) to stderr. Leaf — no bl
    // inside, so x30 (the report's return-into-report address) survives.
    s = s.write(".Llc_write:\n");
    s = s.write("    mov x0, #2\n");
    s = s.write("    mov x8, #64\n");
    s = s.write("    svc #0\n");
    s = s.write("    ret\n");
    // .Llc_wrnum(x0 = signed i64): decimal itoa, digits built backwards from
    // the end of a 32-byte stack buffer, then one write(2) to stderr. Leaf.
    s = s.write(".Llc_wrnum:\n");
    s = s.write("    sub sp, sp, #48\n");
    s = s.write("    add x3, sp, #32\n");
    s = s.write("    mov x4, #10\n");
    s = s.write("    mov x5, #0\n");
    s = s.write("    cmp x0, #0\n");
    s = s.write("    b.ge .Llc_wrnum_loop\n");
    s = s.write("    neg x0, x0\n");
    s = s.write("    mov x5, #1\n");
    s = s.write(".Llc_wrnum_loop:\n");
    s = s.write("    udiv x6, x0, x4\n");
    s = s.write("    msub x7, x6, x4, x0\n");
    s = s.write("    add x7, x7, #48\n");
    s = s.write("    sub x3, x3, #1\n");
    s = s.write("    strb w7, [x3]\n");
    s = s.write("    mov x0, x6\n");
    s = s.write("    cbnz x0, .Llc_wrnum_loop\n");
    s = s.write("    cbz x5, .Llc_wrnum_emit\n");
    s = s.write("    mov x7, #45\n");
    s = s.write("    sub x3, x3, #1\n");
    s = s.write("    strb w7, [x3]\n");
    s = s.write(".Llc_wrnum_emit:\n");
    s = s.write("    add x2, sp, #32\n");
    s = s.write("    sub x2, x2, x3\n");
    s = s.write("    mov x1, x3\n");
    s = s.write("    mov x0, #2\n");
    s = s.write("    mov x8, #64\n");
    s = s.write("    svc #0\n");
    s = s.write("    add sp, sp, #48\n");
    s = s.write("    ret\n");
    return s;
}

// sanitize_on — FERN_SANITIZE read at emit time (the compiler process), the
// arm64 port of ast.SanitizeEnabled and the sibling of asm_ir.sanitize_on.
// One opt-in over the heap detectors, so you can reach for it before knowing
// which check will fire: the leak census (leak_check_on below folds it in),
// the rc over-release report, and the use-after-free quarantine.
//
// One gap versus the native arm64 backend, a declared subset rather than
// silently-different behaviour:
//
//   - No backtrace under either report. Native routes through __fern_report,
//     which walks the frame-pointer chain; there is no such helper here, so
//     the message is the whole diagnostic.
//
// It deliberately does NOT imply FERN_RC_TRACE: per-heap-event output is a
// probe you point at a reduced repro, not a standing mode.
function sanitize_on(): boolean {
    match (env("FERN_SANITIZE")) {
        Some(_) => { return true; },
        None => { return false; }
    }
}

// rc_free_debug_on reports whether the use-after-free QUARANTINE is on —
// FERN_RC_FREE_DEBUG, or implied by FERN_SANITIZE (ast.ApplySanitize parity).
// Under it NOTHING is recycled: every free site writes ast.RcPoison over the
// rc word where the block has one and declines its freelist push — a recycled
// block would overwrite its own poison — so __fern_alloc just keeps bumping,
// and the rc helpers die with a named report the moment a stale reference
// touches a poisoned block. A quarantined block still counts as a FREE for the
// census, so the two detectors compose instead of every correct free reading
// as a leak.
function rc_free_debug_on(): boolean {
    if (sanitize_on()) { return true; }
    match (env("FERN_RC_FREE_DEBUG")) {
        Some(_) => { return true; },
        None => { return false; }
    }
}

// rc_poison is ast.RcPoison (0x7EEDFACE), the marker a quarantined block
// carries in its rc word. The self-host cannot import the Go constant, so the
// two are pinned equal by a test rather than by a shared declaration (#9883);
// asm_ir.rc_poison is the x86-64 spelling of the same number.
function rc_poison(): i32 { return 2129525454; }

// rc_poison_into materialises rc_poison() in a w-register. Two halves because
// no 32-bit move immediate reaches this value in one.
function rc_poison_into(w: string): string {
    var v: i32 = rc_poison();
    return "    movz " + w + ", #" + util.i32_to_string(v & 65535) + "\n"
        + "    movk " + w + ", #" + util.i32_to_string((v >> 16) & 65535) + ", lsl #16\n";
}

// quarantine_rc: the rc-word store a free path writes as it releases the block
// — ast.RcPoison under the quarantine (nothing pushes the block, so the poison
// survives to the next toucher), the defensive 0 otherwise. `addr` is the
// store's addressing text and `w` a w-register the site is free to clobber.
function quarantine_rc(addr: string, w: string): string {
    if (rc_free_debug_on()) { return rc_poison_into(w) + "    stur " + w + ", " + addr + "\n"; }
    return "    stur wzr, " + addr + "\n";
}

// arr_push_fast is the append both __fern_arr_push and __fern_arr_push_owned
// start with: a receiver with a free slot that this push may mutate (sole
// owner, or the bit-31 immortal sentinel) takes the value in place, with no
// frame and no register but x2 and x3 touched. Anything else, and every push
// under the sanitizer, which checks the count first, goes to `slow`.
function arr_push_fast(slow: string): string {
    if (rc_free_debug_on()) { return ""; }
    var ok: string = slow + "_ok";
    return "    ldr x2, [x0]\n    ldur x3, [x0, #-16]\n    cmp x2, x3\n    b.ge " + slow + "\n"
        + "    ldur x3, [x0, #-8]\n    cmp x3, #1\n    b.eq " + ok + "\n"
        + "    tbz x3, #31, " + slow + "\n"
        + ok + ":\n    add x2, x2, #1\n    str x1, [x0, x2, lsl #3]\n    str x2, [x0]\n    ret\n";
}

// san_poison_check: the UAF trap after an rc-word load. `rc` holds the word,
// `w` is a clobberable w-register and `live` the site's "not poisoned, carry
// on" continuation. ast.RcPoison is a large POSITIVE value precisely so the
// immortal (bit 31) guard cannot swallow it; only this explicit compare sees
// it. The abort never returns, so the `bl` is free to clobber x30 — and it is
// a `bl` rather than a conditional branch to the symbol because
// __fern_san_abort_uaf is emitted in the ENTRY unit while these rc helpers go
// into ordinary generated code, so the edge has to survive as an extern.
function san_poison_check(rc: string, w: string, live: string): string {
    if (!rc_free_debug_on()) { return ""; }
    return rc_poison_into(w)
        + "    cmp " + rc + ", " + w + "\n"
        + "    b.ne " + live + "\n"
        + "    bl __fern_san_abort_uaf\n"
        + live + ":\n";
}

// san_underflow_abort emits the fatal report that follows an
// __fern_rc_underflow bump under FERN_SANITIZE, so an over-release dies AT the
// offending dec instead of only incrementing a counter that nothing reads
// until the run is over. Empty when the flag is off, which is what keeps an
// ordinary build's asm byte-identical to one from a compiler without the mode.
function san_underflow_abort(): string {
    if (sanitize_on()) { return "    bl __fern_san_abort\n"; }
    return "";
}

// emit_san_abort emits __fern_san_abort — one write(2) of the over-release
// diagnostic and exit 124 (ExitSanitizer). The text matches the native
// backends' byte-for-byte: a `fern-sanitizer:` line must not tell you which
// compiler produced the binary. Never returns, so it is free to clobber:
// every caller is a dec that has already established it is over-releasing.
function emit_san_abort(s: asmcore.EmitState): asmcore.EmitState {
    if (!sanitize_on()) { return s; }
    s = s.write("    .section .rodata\n");
    s = s.write(".Lsan_df:\n    .ascii \"fern-sanitizer: rc over-release (double free)\\n\"\n");
    s = s.write("    .text\n");
    s = s.write("    .globl __fern_san_abort\n");
    s = s.write("__fern_san_abort:\n");
    s = s.write("    adrp x1, .Lsan_df\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_df\n");
    s = s.write("    mov x2, #46\n");
    s = s.write("    mov x0, #2\n");
    s = s.write("    mov x8, #64\n");
    s = s.write("    svc #0\n");
    s = s.write("    mov x0, #124\n");
    s = s.write("    mov x8, #93\n");
    s = s.write("    svc #0\n");
    return s;
}

// emit_san_uaf_abort emits __fern_san_abort_uaf — the quarantine's fatal
// report. Self-contained (its own write(2) + exit 124 rather than the census
// writer) so FERN_RC_FREE_DEBUG works standalone, without leakcheck. .globl
// because the rc helpers that branch here are emitted into ORDINARY generated
// code, which under -per-module-emit-all lands in a different unit from this.
function emit_san_uaf_abort(s: asmcore.EmitState): asmcore.EmitState {
    if (!rc_free_debug_on()) { return s; }
    s = s.write("    .section .rodata\n");
    s = s.write(".Lsan_uaf:\n    .ascii \"fern-sanitizer: use-after-free (touched a quarantined block)\\n\"\n");
    s = s.write("    .text\n");
    s = s.write("    .globl __fern_san_abort_uaf\n");
    s = s.write("__fern_san_abort_uaf:\n");
    s = s.write("    adrp x1, .Lsan_uaf\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_uaf\n");
    s = s.write("    mov x2, #61\n");
    s = s.write("    mov x0, #2\n");
    s = s.write("    mov x8, #64\n");
    s = s.write("    svc #0\n");
    s = s.write("    mov x0, #124\n");
    s = s.write("    mov x8, #93\n");
    s = s.write("    svc #0\n");
    return s;
}

// leak_check_on — FERN_LEAKCHECK read at emit time (the compiler process),
// the arm64 half of the census (#5362; the x86 self-host precedent), folded
// with FERN_SANITIZE as the x86 backend folds it. The fold is only honest
// because this backend also carries the over-release report and the
// quarantine: a "sanitize" build that printed a census alone would misreport
// what it checks. The census counts at 8-byte-word granularity on both sides —
// __fern_alloc's rounded request and each free site's logical size are the
// same number for the same block — so a block's alloc and eventual free
// cancel exactly. The capacity a block is rounded up to (__fern_capw, the
// large tier) is deliberately NOT counted: the free side never sees it.
function leak_check_on(): boolean {
    if (sanitize_on()) { return true; }
    match (env("FERN_LEAKCHECK")) {
        Some(_) => { return true; },
        None => { return false; }
    }
}

// lc_bump_alloc: count one allocation of x0 (rounded-8) bytes. Emitted at
// __fern_alloc's entry, after the rounding and BEFORE the large tier
// re-rounds x0 to its class capacity. x1/x2 are inside __fern_alloc's
// documented x0..x3 clobber set and dead at that point.
// alloc_count_bump: tick the allocator's call count (#9596). Emitted at the
// same point as the census bump below — after the rounding, ahead of the
// class check — so the freelist pop and the bump are counted alike. x1/x2 are
// the census's scratch here and dead at this point for the same reason.
function alloc_count_bump(s: asmcore.EmitState): asmcore.EmitState {
    if (!s.has_need("alloc_count")) { return s; }
    s = s.write("    adrp x1, __fern_alloc_count\n");
    s = s.write("    add x1, x1, :lo12:__fern_alloc_count\n");
    s = s.write("    ldr x2, [x1]\n");
    s = s.write("    add x2, x2, #1\n");
    s = s.write("    str x2, [x1]\n");
    return s;
}

function lc_bump_alloc(s: asmcore.EmitState): asmcore.EmitState {
    if (!leak_check_on()) { return s; }
    s = s.write("    adrp x1, __fern_lc_alloc_count\n");
    s = s.write("    add x1, x1, :lo12:__fern_lc_alloc_count\n");
    s = s.write("    ldr x2, [x1]\n");
    s = s.write("    add x2, x2, #1\n");
    s = s.write("    str x2, [x1]\n");
    s = s.write("    adrp x1, __fern_lc_alloc_bytes\n");
    s = s.write("    add x1, x1, :lo12:__fern_lc_alloc_bytes\n");
    s = s.write("    ldr x2, [x1]\n");
    s = s.write("    add x2, x2, x0\n");
    s = s.write("    str x2, [x1]\n");
    return s;
}

// lc_bump_free_add: count one freed block — count += 1, bytes += <addend>.
// Emitted immediately BEFORE the site's freelist push / large_push handoff,
// where t1/t2 — the push's own address and head registers — are still dead,
// so no site widens its documented clobber set. `addend` is the operand tail
// of the bytes add: a words register with ", lsl #3", a bytes register bare,
// or a byte literal for the fixed-size boxes.
function lc_bump_free_add(s: asmcore.EmitState, addend: string, t1: string, t2: string): asmcore.EmitState {
    if (!leak_check_on()) { return s; }
    s = s.write("    adrp " + t1 + ", __fern_lc_free_count\n");
    s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_free_count\n");
    s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
    s = s.write("    add " + t2 + ", " + t2 + ", #1\n");
    s = s.write("    str " + t2 + ", [" + t1 + "]\n");
    s = s.write("    adrp " + t1 + ", __fern_lc_free_bytes\n");
    s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_free_bytes\n");
    s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
    s = s.write("    add " + t2 + ", " + t2 + ", " + addend + "\n");
    s = s.write("    str " + t2 + ", [" + t1 + "]\n");
    return s;
}

// lc_bump_free_words: the common case — the block size is a class/words
// register, bytes = words*8.
function lc_bump_free_words(s: asmcore.EmitState, words: string, t1: string, t2: string): asmcore.EmitState {
    return lc_bump_free_add(s, words + ", lsl #3", t1, t2);
}

// buf_block_free emits the inline release of one BARE byte block — the string
// builder's buffer, or its control block — onto the size-class freelist
// __fern_alloc pops from, `ptr` naming the block and `words` its class. The
// same stores __fn___fern_str_free's data-buffer arm makes, with the fused
// arm's large-tier branch; neither block carries an rc word, so there is no rc
// to clear first — and none to poison, so declining the push is the whole
// quarantine treatment for both. `ptr` and `words` must avoid x1..x4, which __fern_large_push
// clobbers; x3 / x9 / x10 are this helper's own scratch. `lbl` distinguishes
// one call site's labels from another's.
// freelist_push emits the push of the block at `ptr` onto the small-tier
// freelist. `words` holds the block's logical size and comes out as its class,
// the capacity __fern_capw rounds it to, which is the size __fern_alloc bumped
// the block at. `base` and `tmp` are scratch. x30 is saved around the call,
// since several of these sites sit in helpers that return through it.
function freelist_push(s: asmcore.EmitState, ptr: string, words: string, base: string, tmp: string): asmcore.EmitState {
    s = s.write("    stp " + words + ", x30, [sp, #-16]!\n");
    s = s.write("    bl __fern_capw\n");
    s = s.write("    ldp " + words + ", x30, [sp], #16\n");
    s = s.write("    adrp " + base + ", __fern_freelist\n");
    s = s.write("    add " + base + ", " + base + ", :lo12:__fern_freelist\n");
    s = s.write("    ldr " + tmp + ", [" + base + ", " + words + ", lsl #3]\n");
    s = s.write("    str " + tmp + ", [" + ptr + "]\n");
    s = s.write("    str " + ptr + ", [" + base + ", " + words + ", lsl #3]\n");
    return s;
}

function buf_block_free(s: asmcore.EmitState, ptr: string, words: string, lbl: string): asmcore.EmitState {
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp " + words + ", x9\n");
    s = s.write("    b.hs ." + lbl + "_large\n");
    s = lc_bump_free_words(s, words, "x3", "x10");
    if (!rc_free_debug_on()) {
    s = freelist_push(s, ptr, words, "x3", "x10");
    }
    s = s.write("    b ." + lbl + "_done\n");
    s = s.write("." + lbl + "_large:\n");
    s = s.write("    mov x1, " + ptr + "\n");
    s = s.write("    lsl x2, " + words + ", #3\n");
    s = s.write("    bl __fern_large_push\n");
    s = s.write("." + lbl + "_done:\n");
    return s;
}

// mov_fused_marker materialises the 32-bit word a FUSED string box carries at
// base+4 — the four bytes the rc word's 8-byte slot has always had spare —
// saying its data buffer is inside the same block, so __fn___fern_str_free
// returns ONE allocation (#7351). The separate-buffer __fern_str_box leaves it 0.
// Two instructions because no 32-bit immediate reaches this value in one.
//
// A magic value rather than 1, and not a positional `data == box + 16` test:
// both a stale 1 in a recycled block and an allocator that happens to hand a
// separate buffer the block right after its box would read as fused, and the
// consequence is not a fault but a block returned to the freelist ONCE where it
// was taken twice — a phantom leak that hides whatever is really
// wrong. The value spells 7351 in its high half; asm_ir.fused_marker is the
// x86-64 sibling and the two must agree only with themselves, never across
// backends.
function mov_fused_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
    s = s.write("    mov " + reg + ", #32781\n");            // 0x800D
    return s.write("    movk " + reg + ", #29519, lsl #16\n");  // 0x734F -> 0x734F800D
}

function emit_rt_arena_and_alloc(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // 16 GiB heap arena, lazily mmap'd at hint 0x10000000 on the first
    // allocation (mirrors the native arm64 emitAllocRuntime) rather than
    // reserved as a huge `.bss` in the loaded image. Two payoffs: the
    // R+W data segment stays tiny (so the binary can be a position-
    // independent ET_DYN loaded at any base — `-target arm64-android`),
    // and the mapping is lazy so untouched pages cost nothing (the hint
    // must stay 0x10000000 — the NATIVE backend's below-heap rc guards
    // key on it, and the two backends' binaries interoperate in the
    // differential suites). Heap
    // pointers may now exceed 4 GiB (the historical 32-bit-safe-range
    // guideline was retired when the stage-2 self-compile's ~3.95 GiB
    // live set outgrew every arena a 32-bit range can hold — the value
    // plumbing is 64-bit throughout, as arm64-darwin's high heap already
    // exercises). Matches the native arm64 backend's heapBytes
    // (lockstep). The size (16 GiB = 1 << 34) is built in-asm via
    // `mov #1; lsl #34` below rather than a `ldr =N` literal.
    s = s.write("    .bss\n");
    s = s.write("    .align 3\n");
    // .globl for the same reason as __fern_arr_push_shared below:
    // __heap_bump_bytes lowers to an INLINE adrp/add/ldr of BOTH words
    // (kind_tag 80), not to a call through a global accessor, so a file-local
    // symbol is unreachable from any unit but the one holding the runtime.
    // See the x86-64 comment in asm_ir.fern.
    s = s.write("    .globl __fern_heap_ptr\n");
    s = s.write("__fern_heap_ptr: .quad 0\n");       // bump cursor (0 until first mmap)
    if (s.has_need("alloc_count")) {
        // The allocator's call count (#9596), read inline by kind_tag 315 —
        // .globl for the cursor pair's reason, since the read is an inline
        // adrp/add/ldr from whichever unit asked for it.
        s = s.write("    .align 3\n");
        s = s.write("    .globl __fern_alloc_count\n");
        s = s.write("__fern_alloc_count: .quad 0\n");
    }
    s = s.write("    .align 3\n");
    s = s.write("    .globl __fern_heap_end\n");
    s = s.write("__fern_heap_end: .quad 0\n");        // arena end (base + heap_size)
    s = s.write("    .align 3\n");
    // arena BASE (mmap return), set once at first alloc — the freeable-range
    // lower bound so __fern_str_free frees a heap string's data buffer but
    // skips a static LITERAL's .rodata pointer (below the arena). #2649.
    s = s.write("__fern_heap_base: .quad 0\n");
    s = s.write("    .align 3\n");
    // RC over-release (underflow) detector — Phase 0c. Bumped by
    // __fern_rc_dec when it sees rc <= 0 before decrementing; read
    // back by __fern_rc_underflow_count(). Mirrors the x86-64
    // backend + the native detector.
    s = s.write("__fern_rc_underflow: .quad 0\n");
    s = s.write("    .align 3\n");
    // core/map's per-process string-hash seed (#6194). Read and filled only
    // by __fern_map_hash_seed, which lives in this same unit, so it needs no
    // .globl (unlike the cliff counter below, which ops read inline).
    s = s.write("__fern_map_seed: .quad 0\n");
    s = s.write("    .align 3\n");
    // The rc==1 append cliff counter (#6023): appends that copied a buffer
    // which still had spare capacity, so the copy was bought by an extra
    // reference rather than a full buffer. Bumped on the un-share path in
    // __fern_arr_push, read by __arr_push_shared_count. 0 on a healthy run.
    // Mirrors the x86-64 backend + the native detector.
    //
    // .globl for the same reason as the x86-64 sibling: __arr_push_shared_count
    // lowers to an INLINE adrp/add/ldr of this word, not to a call through a
    // global accessor, so a file-local symbol is unreachable from another unit
    // under -per-module-emit-all. See the x86-64 comment in asm_ir.fern.
    s = s.write("    .globl __fern_arr_push_shared\n");
    s = s.write("__fern_arr_push_shared: .quad 0\n");
    s = s.write("    .align 8\n");
    // The same crossings WEIGHTED by the bytes they copied (len * 8 — the
    // self-host array model is uniform 8-byte slots), read by
    // __arr_push_shared_bytes. .globl for the same inline-read reason as
    // the counter above (#6058, #6066).
    s = s.write("    .globl __fern_arr_push_copied\n");
    s = s.write("__fern_arr_push_copied: .quad 0\n");
    s = s.write("    .align 3\n");
    // Phase 3 size-class freelist (mirror of x86-64): head pointers indexed by
    // __fern_capw(words), below 65536 words. Pushed by the free sites, popped by
    // __fern_alloc before bumping.
    s = s.write("__fern_freelist: .skip 524288\n");
    s = s.write("    .align 8\n");
    // Large-tier freelist (#3425): the 65536-word __fern_freelist above recycles
    // blocks <512 KiB exactly; blocks >=512 KiB previously LEAKED, exhausting the
    // arena on a long emit. LINEAR 512-KiB classes: class = round_up(size,512KiB)
    // >> 19 (1..2048), 2560 slots for headroom. The arm64 twin of asm_ir.fern's
    // tier (bsr/variable-shift-free — built from 1<<19 to avoid arm64's tight
    // immediate/wide-literal encoding, like the existing round-to-8 lsr/lsl).
    s = s.write("__fern_large_freelist: .skip 20480\n");
    // Shadows for the arena checkpoint (#6728) — the arm64 twin of asm_ir's.
    // .bss, so they cost image size nothing and are zero-filled.
    s = s.write("    .align 3\n");
    s = s.write("__fern_freelist_shadow: .skip 524288\n");
    s = s.write("    .align 3\n");
    s = s.write("__fern_large_freelist_shadow: .skip 20480\n");
    s = s.write("    .text\n");
    // __fern_capw(words) -> class, in place in its one stack slot: the small
    // tier's size class for a block of `words` 8-byte words, which is also the
    // capacity __fern_alloc bumps the block at. Exact up to 256 words (2 KiB),
    // then native's 3-significant-bit capacities, so a buffer that grows a
    // little at a time finds the block it just freed rather than a new class
    // per step. Clamped below 65536, where the large tier takes over. Preserves
    // every register but x30, which `bl` set.
    s = s.write(".globl __fern_capw\n");
    s = s.write("__fern_capw:\n");
    s = s.write("    stp x9, x10, [sp, #-32]!\n");
    s = s.write("    str x11, [sp, #16]\n");
    s = s.write("    ldr x9, [sp, #32]\n");
    s = s.write("    cmp x9, #256\n");
    s = s.write("    b.ls .Lcapw_ret\n");
    s = s.write("    clz x10, x9\n");
    s = s.write("    mov x11, #61\n");
    s = s.write("    sub x10, x11, x10\n");            // msb - 2
    s = s.write("    mov x11, #1\n");
    s = s.write("    lsl x11, x11, x10\n");            // granule
    s = s.write("    add x9, x9, x11\n");
    s = s.write("    sub x9, x9, #1\n");
    s = s.write("    neg x11, x11\n");
    s = s.write("    and x9, x9, x11\n");              // round up to the granule
    s = s.write("    mov x10, #0x10000\n");
    s = s.write("    cmp x9, x10\n");
    s = s.write("    b.lo .Lcapw_store\n");
    s = s.write("    mov x9, #65535\n");
    s = s.write(".Lcapw_store:\n");
    s = s.write("    str x9, [sp, #32]\n");
    s = s.write(".Lcapw_ret:\n");
    s = s.write("    ldr x11, [sp, #16]\n");
    s = s.write("    ldp x9, x10, [sp], #32\n");
    s = s.write("    ret\n");
    s = s.write(".globl __fern_alloc\n");
    s = s.write(".type __fern_alloc, %function\n");
    s = s.write("__fern_alloc:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    // Round request up to a multiple of 8, then try the freelist (idx =
    // __fern_capw(size/8); pop the class head if non-empty). Clobbers only
    // x0..x3 like the bump path below.
    s = s.write("    add x0, x0, #7\n");
    s = s.write("    lsr x3, x0, #3\n");        // idx = roundup8(size)/8
    s = s.write("    lsl x0, x3, #3\n");        // rounded size = idx*8
    s = lc_bump_alloc(s);
    s = alloc_count_bump(s);
    s = s.write("    mov x2, #0x10000\n");      // freelist class cap (65536); reg form (shifted cmp imm may be unsupported)
    s = s.write("    cmp x3, x2\n");
    s = s.write("    b.hs .Lalloc_large\n");
    // The small tier bumps a block at its class's capacity, so any freed block
    // of the class satisfies any request that rounds to it. x30 is in the frame.
    s = s.write("    str x3, [sp, #-16]!\n");
    s = s.write("    bl __fern_capw\n");
    s = s.write("    ldr x3, [sp], #16\n");
    s = s.write("    lsl x0, x3, #3\n");              // capacity bytes, for the bump
    s = s.write("    adrp x1, __fern_freelist\n");
    s = s.write("    add x1, x1, :lo12:__fern_freelist\n");
    s = s.write("    ldr x2, [x1, x3, lsl #3]\n");   // head = freelist[idx]
    s = s.write("    cbz x2, .Lalloc_nofl\n");
    s = s.write("    ldr x0, [x2]\n");               // next = *head
    s = s.write("    str x0, [x1, x3, lsl #3]\n");   // freelist[idx] = next
    s = s.write("    mov x0, x2\n");                 // return head
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // Large tier (#3425): x0 = rounded-8 size (>=512 KiB), x3 = idx. Round the
    // size up to a 512-KiB multiple (the class capacity — bump AT it so every
    // block in a class has one size), class = cap>>19, pop the large freelist;
    // empty falls through to the bump with x0 = cap. >1 GiB is bump-only. Only
    // x0..x3 used (alloc's clobber contract). 512 KiB is built as 1<<19 to avoid
    // wide immediates.
    s = s.write(".Lalloc_large:\n");
    s = s.write("    mov x1, #1\n");
    s = s.write("    lsl x1, x1, #30\n");            // x1 = 1 GiB
    s = s.write("    cmp x0, x1\n");
    s = s.write("    b.hi .Lalloc_nofl\n");          // > 1 GiB: bump exact, no freelist
    s = s.write("    mov x1, #1\n");
    s = s.write("    lsl x1, x1, #19\n");            // x1 = 512 KiB
    s = s.write("    sub x1, x1, #1\n");             // x1 = 512 KiB - 1
    s = s.write("    add x0, x0, x1\n");             // size + (512 KiB - 1)
    s = s.write("    lsr x3, x0, #19\n");            // class = round_up(size,512KiB) >> 19  (1..2048)
    s = s.write("    lsl x0, x3, #19\n");            // cap = class << 19 = bytes to bump
    s = s.write("    adrp x1, __fern_large_freelist\n");
    s = s.write("    add x1, x1, :lo12:__fern_large_freelist\n");
    s = s.write("    ldr x2, [x1, x3, lsl #3]\n");   // head
    s = s.write("    cbz x2, .Lalloc_nofl\n");       // empty class: bump at cap (x0)
    s = s.write("    ldr x0, [x2]\n");               // next = *head
    s = s.write("    str x0, [x1, x3, lsl #3]\n");   // freelist[class] = next
    s = s.write("    mov x0, x2\n");                 // return reused block
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_nofl:\n");                  // x0 = rounded size
    s = s.write("    adrp x1, __fern_heap_ptr\n");
    s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
    s = s.write("    ldr x2, [x1]\n");
    s = s.write("    cbnz x2, .Lalloc_inited\n");
    // First allocation: lazily mmap the arena at hint 0x10000000
    // (MAP_PRIVATE|MAP_ANONYMOUS, R+W). This runs once. The syscall
    // clobbers x0..x5/x8 plus x9 (size save), so save/restore those
    // beyond the x0..x3 contract callers rely on.
    s = s.write("    stp x4, x5, [sp, #-16]!\n");
    s = s.write("    stp x8, x9, [sp, #-16]!\n");
    s = s.write("    mov x9, x0\n");                  // save rounded size
    s = s.write("    mov x0, #1\n");
    s = s.write("    lsl x0, x0, #28\n");             // hint = 0x10000000 — keep in lockstep with the NATIVE arm64 backend, whose below-heap rc guards classify `ptr >= 0x10000000` as heap (a lower base no-ops every native rc inc/dec)
    // length = 16 GiB = 0x400000000 = 1 << 34. Built with mov+lsl, not a
    // `ldr =N` literal: the in-process assembler's literal parser is
    // 32-bit (arm64_gas_atoi), so a wide constant would sign-extend and
    // mmap would fail with ENOMEM. Raised from 3.5 GiB when the arm64
    // stage-2 self-compile crossed the exit-137 alloc trap (the arm64
    // twin of the x86 wall — see asm.fern's heap_size history): the
    // live set measured ~3.95 GiB, past ANY arena a 32-bit-safe range
    // can hold, so the historical "heap pointers stay < 4 GiB"
    // guideline is retired here — the emit's pointer paths are 64-bit
    // (x-registers, 8-byte slots; arm64-darwin's high heap already
    // exercises >32-bit heap pointers through the same value plumbing),
    // and the stage-2 fixpoint + the arm64 e2e matrix gate the change.
    s = s.write("    mov x1, #1\n");
    s = s.write("    lsl x1, x1, #34\n");             // length = 0x400000000 (16 GiB)
    s = s.write("    mov x2, #3\n");                  // PROT_READ | PROT_WRITE
    // mmap FLAGS are per-OS, and unlike the syscall NUMBER nothing downstream
    // translates them: darwin_sysno maps 222 -> 197 and darwinize rewrites
    // `mov x8` -> `mov x16` / `svc #0` -> `svc #0x80`, but `#0x4022` is a plain
    // immediate and passed through untouched. On XNU MAP_ANON is 0x1000 (not
    // Linux's 0x20), so 0x4022 asked for a FILE mapping with fd = -1: mmap
    // failed, `b.mi` took .Lalloc_oom, and every arm64-darwin binary died
    // "heap arena exhausted" (exit 137) on its first allocation — a lie about
    // the cause, since the arena was never mapped at all (#6042). Mirrors the
    // native backend's split at internal/codegen/arm64/arm64.go.
    if (darwin) {
        // MAP_ANON (0x1000) | MAP_PRIVATE (0x2). No NORESERVE: macOS does not
        // strictly account anonymous private reservations.
        s = s.write("    mov x3, #0x1002\n");
    } else {
        s = s.write("    mov x3, #0x4022\n");         // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE (exempt from overcommit accounting; see native arm64 heapBytes comment)
    }
    s = s.write("    mov x4, #0\n");
    s = s.write("    sub x4, x4, #1\n");              // x4 = -1 (fd)
    s = s.write("    mov x5, #0\n");                  // offset
    s = s.write("    mov x8, #222\n");               // __NR_mmap
    s = s.write("    svc #0\n");
    s = s.write("    cmn x0, #0\n");                  // mmap returns -errno on failure
    s = s.write("    b.mi .Lalloc_oom\n");
    s = s.write("    adrp x1, __fern_heap_ptr\n");
    s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
    s = s.write("    str x0, [x1]\n");                // heap_ptr = arena base
    s = s.write("    adrp x1, __fern_heap_base\n");   // record arena base (freeable-range lower bound)
    s = s.write("    add x1, x1, :lo12:__fern_heap_base\n");
    s = s.write("    str x0, [x1]\n");
    s = s.write("    mov x2, #1\n");
    s = s.write("    lsl x2, x2, #34\n");             // 16 GiB
    s = s.write("    add x2, x0, x2\n");              // arena end
    s = s.write("    adrp x3, __fern_heap_end\n");
    s = s.write("    add x3, x3, :lo12:__fern_heap_end\n");
    s = s.write("    str x2, [x3]\n");                // heap_end = base + heap_size
    s = s.write("    mov x0, x9\n");                  // restore rounded size
    s = s.write("    ldp x8, x9, [sp], #16\n");
    s = s.write("    ldp x4, x5, [sp], #16\n");
    s = s.write("    adrp x1, __fern_heap_ptr\n");    // x1 was clobbered
    s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
    s = s.write(".Lalloc_inited:\n");
    s = s.write("    ldr x2, [x1]\n");                // x2 = heap_ptr
    s = s.write("    add x3, x2, x0\n");              // x3 = new cursor
    // Bounds check against the mmap'd arena end (a bump heap has no GC,
    // so overflowing would run past the arena and segfault; trap with a
    // clean, recognisable exit code 137 instead). x4 is saved/restored so
    // __fern_alloc keeps its x0..x3 clobber contract; the ldr restoring
    // x4 doesn't disturb the cmp's flags.
    s = s.write("    str x4, [sp, #-16]!\n");
    s = s.write("    adrp x4, __fern_heap_end\n");
    s = s.write("    add x4, x4, :lo12:__fern_heap_end\n");
    s = s.write("    ldr x4, [x4]\n");                // x4 = heap_end
    s = s.write("    cmp x3, x4\n");
    s = s.write("    ldr x4, [sp], #16\n");
    s = s.write("    b.hi .Lalloc_oom\n");
    s = s.write("    str x3, [x1]\n");
    s = s.write("    mov x0, x2\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_oom:\n");
    s = s.write("    mov x8, #93\n");
    // 125, not 137: 137 is 128+9, what a shell reports for SIGKILL, so an
    // arena trap could not be told apart from the kernel OOM-killer.
    // Lockstep with the native backends' ExitArenaExhausted and asm_ir.
    s = s.write("    mov x0, #125\n");
    s = s.write("    svc #0\n");
    s = s.write(".size __fern_alloc, .-__fern_alloc\n");

    // __fern_oob_abort — shared out-of-bounds trap for arr_get / arr_set on
    // the IR path (asm_arm64_ir.fern kind_tag 88/89). Aborts with exit 134,
    // matching the x86-64 backend + docs/ARRAY-BOUNDS.md ("an out-of-bounds
    // index aborts before producing a value; never returns a garbage
    // value"). A single shared routine keeps each access to a cmp + a b.hs.
    s = s.write(".globl __fern_oob_abort\n");
    s = s.write(".type __fern_oob_abort, %function\n");
    s = s.write("__fern_oob_abort:\n");
    s = s.write("    mov x8, #93\n");
    s = s.write("    mov x0, #134\n");
    s = s.write("    svc #0\n");
    s = s.write(".size __fern_oob_abort, .-__fern_oob_abort\n");

    // __fern_alloc_size_abort — a raw_alloc size that is negative as an i32,
    // which is how a helper's `la + lb` looks once it wraps past 2 GiB. The
    // message and exit 134 match the native backends' allocation-size abort.
    s = s.write("    .section .rodata\n");
    s = s.write(".Lalloc_size_msg:\n    .ascii \"fern: allocation size out of range\\n\"\n");
    s = s.write("    .text\n");
    s = s.write(".globl __fern_alloc_size_abort\n");
    s = s.write(".type __fern_alloc_size_abort, %function\n");
    s = s.write("__fern_alloc_size_abort:\n");
    s = s.write("    adrp x1, .Lalloc_size_msg\n");
    s = s.write("    add x1, x1, :lo12:.Lalloc_size_msg\n");
    s = s.write("    mov x2, #35\n");
    s = s.write("    mov x0, #2\n");
    s = s.write("    mov x8, #64\n");
    s = s.write("    svc #0\n");
    s = s.write("    mov x8, #93\n");
    s = s.write("    mov x0, #134\n");
    s = s.write("    svc #0\n");
    s = s.write(".size __fern_alloc_size_abort, .-__fern_alloc_size_abort\n");

    // __fern_arr_box(x0 = cap element count) -> x0 = array data
    // pointer. Centralises the array box layout (mirrors the x86-64
    // backend; docs/RC-PERCEUS-SELF-HOST-PORT.md Phase 0a/0b).
    // Perceus rc-header layout: base = [cap, rc, len, e0, ...]; the
    // returned data pointer is base+16 (at the len slot), so rc is
    // at [data-8] (the uniform offset __fern_rc_inc/dec/is_unique
    // read), cap at [data-16], and element i stays at [data+(i+1)*8]
    // — unchanged from the pre-rc layout (readers index off data).
    // Inits rc = 1, writes cap and len = cap; callers overwrite len
    // when it differs (push) and fill the elements. Clobbers only
    // x0/x1/x2 — exactly what __fern_alloc already clobbers — so it
    // is a drop-in at every call site.
    s = s.write("__fern_arr_box:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    str x0, [sp, #-16]!\n");      // save cap (16B aligned)
    s = s.write("    add x0, x0, #3\n");           // cap + 3 header words (cap, rc, len)
    s = s.write("    lsl x0, x0, #3\n");           // * 8 bytes
    s = s.write("    bl __fern_alloc\n");          // base in x0
    s = s.write("    ldr x1, [sp]\n");             // reload cap
    s = s.write("    str x1, [x0]\n");             // cap at base+0   (= data-16)
    s = s.write("    mov w2, #1\n");
    s = s.write("    str w2, [x0, #8]\n");         // rc = 1 at base+8 (= data-8)
    s = s.write("    str x1, [x0, #16]\n");        // len = cap at base+16 (= data)
    s = s.write("    add x0, x0, #16\n");          // data ptr = base+16
    s = s.write("    add sp, sp, #16\n");          // pop saved cap
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // __fn___fern_struct_copy(x0 = src box data, x1 = nf) -> x0 = fresh box that is a
    // shallow word-for-word copy of src (shape@0 + nf field slots). Allocates via
    // __fern_arr_box(cap = nf+1) so the copy has a fresh rc=1 header + the same
    // free size, byte-identical to struct_make's box; copies nf+1 words src -> dst
    // (field pointers shared, matching the inline base-copy). The compact base copy
    // of `T { ...base, f: v }` (#4650) — one bl instead of nf ldr/str pairs/site.
    s = s.write("__fn___fern_struct_copy:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x0, x1, [sp, #-16]!\n");   // save src, nf
    s = s.write("    add x0, x1, #1\n");            // cap = nf+1 words
    s = s.write("    bl __fern_arr_box\n");         // x0 = dst data (rc=1)
    s = s.write("    ldp x2, x3, [sp], #16\n");     // x2=src, x3=nf
    s = s.write("    add x3, x3, #1\n");            // nf+1 words (shape + fields)
    s = s.write("    mov x4, #0\n");                // i = 0
    s = s.write(".Lfern_scp_loop:\n");
    s = s.write("    cmp x4, x3\n");
    s = s.write("    b.ge .Lfern_scp_done\n");
    s = s.write("    ldr x5, [x2, x4, lsl #3]\n");
    s = s.write("    str x5, [x0, x4, lsl #3]\n");
    s = s.write("    add x4, x4, #1\n");
    s = s.write("    b .Lfern_scp_loop\n");
    s = s.write(".Lfern_scp_done:\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // __fern_str_box(x0 = data, x1 = len) -> x0 = box (rc-HEADERED, #2649 Option A
    // A1b). Block = [rc=1@base, fused=0@base+4, data@base+8, len@base+16] (24B,
    // freelist class 3); box = base+8, so data@box+0 / len@box+8 are UNCHANGED
    // (every string consumer is untouched) and rc@box-8 is the SAME 32-bit rc
    // word arrays use (__fn___fern_rc_is_unique / rc_inc read [ptr,#-8]). Freed by
    // the rc-aware __fn___fern_str_free at rc==1.
    //
    // This is the SEPARATE-BUFFER form, for data the box does not own the block of:
    // argv entries, the strbuf drain, the subprocess pipe buffers. Data that came
    // from __raw_alloc goes through __fern_str_box_hdr instead and costs no second
    // allocation; the `fused` word at base+4 (zeroed here by the 64-bit rc store)
    // is what tells __fn___fern_str_free the two apart. The arm64 sibling of the
    // x86 __fern_str_box.
    s = s.write("__fern_str_box:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x0, x1, [sp, #-16]!\n");   // save data, len
    s = s.write("    mov x0, #24\n");
    s = s.write("    bl __fern_alloc\n");           // x0 = base
    s = s.write("    mov x2, #1\n");
    s = s.write("    str x2, [x0]\n");              // rc = 1 @ base (64-bit write zeroes the word)
    s = s.write("    ldp x2, x3, [sp], #16\n");     // x2 = data, x3 = len
    s = s.write("    str x2, [x0, #8]\n");          // data @ base+8
    s = s.write("    str x3, [x0, #16]\n");         // len  @ base+16
    s = s.write("    add x0, x0, #8\n");            // box = base+8
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // __fern_str_box_hdr(x0 = data, x1 = len) -> x0 = box — the FUSED form (#7351),
    // the arm64 sibling of the x86 __fern_str_box_hdr. `data` is a __raw_alloc
    // pointer, which reserves 24 bytes ahead of itself for exactly this box, so the
    // whole string is ONE block: rc and the fused marker at data-24, data/len where
    // every consumer already reads them, box = data-16. Allocates nothing, so it is
    // a leaf (no frame) and produces no heap-census event — the one __raw_alloc
    // already accounted for the block. The fused marker is what tells
    // __fn___fern_str_free to return that single 24+len block. Clobbers x2..x4;
    // its one call site is an operand-stack op with nothing live in registers.
    s = s.write("__fern_str_box_hdr:\n");
    s = s.write("    sub x2, x0, #24\n");           // base = data - 24
    s = s.write("    mov w3, #1\n");
    s = s.write("    str w3, [x2]\n");              // rc = 1 @ base
    s = mov_fused_marker(s, "w4");
    s = s.write("    stur w4, [x2, #4]\n");         // fused marker @ base+4
    s = s.write("    str x0, [x2, #8]\n");          // data @ base+8
    s = s.write("    str x1, [x2, #16]\n");         // len  @ base+16
    s = s.write("    add x0, x2, #8\n");            // box = base+8 = data-16
    s = s.write("    ret\n");

    // Global string-builder primitive — the amortised-O(1) output
    // accumulator (strbuf_reset / strbuf_append / strbuf_take), gated on the
    // strbuf need its op sites mark. The buffer is a heap block that doubles
    // (from 64 KiB) when an append would not fit, so the accumulated output
    // has no fixed ceiling. Three .bss words: len, data ptr, cap. A string is a 16-byte
    // view {data@0, len@8} over the 24-byte rc-headered block __fern_str_box
    // builds.
    if (s.has_need("strbuf")) {
        s = s.write("    .bss\n");
        s = s.write("    .align 3\n");
        s = s.write("__fern_strbuf_len: .quad 0\n");
        s = s.write("__fern_strbuf_ptr: .quad 0\n");
        s = s.write("__fern_strbuf_cap: .quad 0\n");
        s = s.write("    .text\n");
        // reset: len = 0. The buffer stays allocated for the next build.
        s = s.write(".globl __fern_strbuf_reset\n");
        s = s.write(".type __fern_strbuf_reset, %function\n");
        s = s.write("__fern_strbuf_reset:\n");
        s = s.write("    adrp x1, __fern_strbuf_len\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_len\n");
        s = s.write("    str xzr, [x1]\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_reset, .-__fern_strbuf_reset\n");
        // grow(need in x0): replace the buffer with one of at least `need`
        // bytes and copy the live bytes across. The old buffer is left to the
        // arena, like the wasm runtime's strbuf. x19 = need / new buffer,
        // x20 = new cap, across the __fern_alloc call.
        s = s.write(".globl __fern_strbuf_grow\n");
        s = s.write(".type __fern_strbuf_grow, %function\n");
        s = s.write("__fern_strbuf_grow:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    adrp x1, __fern_strbuf_cap\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_cap\n");
        s = s.write("    ldr x20, [x1]\n");
        s = s.write("    cbnz x20, .Lsbgrow_dbl\n");
        s = s.write("    mov x20, #0x10000\n");
        s = s.write(".Lsbgrow_dbl:\n");
        s = s.write("    cmp x20, x19\n");
        s = s.write("    b.hs .Lsbgrow_alloc\n");
        s = s.write("    lsl x20, x20, #1\n");
        s = s.write("    b .Lsbgrow_dbl\n");
        s = s.write(".Lsbgrow_alloc:\n");
        s = s.write("    mov x0, x20\n");
        s = s.write("    bl __fern_alloc\n");
        if (leak_check_on()) {
            // The builder's buffer is runtime state the program never holds,
            // so the census leaves it out as it left out the .bss reservation
            // it replaced. x20 is a power of two >= 64 KiB, already 16-rounded.
            s = s.write("    adrp x1, __fern_lc_alloc_count\n");
            s = s.write("    add x1, x1, :lo12:__fern_lc_alloc_count\n");
            s = s.write("    ldr x2, [x1]\n");
            s = s.write("    sub x2, x2, #1\n");
            s = s.write("    str x2, [x1]\n");
            s = s.write("    adrp x1, __fern_lc_alloc_bytes\n");
            s = s.write("    add x1, x1, :lo12:__fern_lc_alloc_bytes\n");
            s = s.write("    ldr x2, [x1]\n");
            s = s.write("    sub x2, x2, x20\n");
            s = s.write("    str x2, [x1]\n");
        }
        s = s.write("    mov x19, x0\n");                       // new buffer
        s = s.write("    adrp x1, __fern_strbuf_ptr\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_ptr\n");
        s = s.write("    ldr x1, [x1]\n");                      // old buffer (0 on the first grow)
        s = s.write("    adrp x2, __fern_strbuf_len\n");
        s = s.write("    add x2, x2, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x2, [x2]\n");                      // live bytes (0 while old is null)
        s = s.write("    mov x3, x19\n");
        s = s.write("    cbz x2, .Lsbgrow_copied\n");
        s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lsbgrow_copy_w", ".Lsbgrow_copy_t", ".Lsbgrow_copy_b", ".Lsbgrow_copy_d");
        s = s.write(".Lsbgrow_copied:\n");
        s = s.write("    adrp x1, __fern_strbuf_ptr\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_ptr\n");
        s = s.write("    str x19, [x1]\n");
        s = s.write("    adrp x1, __fern_strbuf_cap\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_cap\n");
        s = s.write("    str x20, [x1]\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_grow, .-__fern_strbuf_grow\n");
        // append(box in x0): grow if box.len more bytes do not fit, copy them
        // from box.data to strbuf_ptr + strbuf_len, then bump len. x19 holds
        // the box across the grow call.
        s = s.write(".globl __fern_strbuf_append\n");
        s = s.write(".type __fern_strbuf_append, %function\n");
        s = s.write("__fern_strbuf_append:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    ldr x2, [x19, #8]\n");                 // src len
        s = s.write("    adrp x4, __fern_strbuf_len\n");
        s = s.write("    add x4, x4, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x5, [x4]\n");
        s = s.write("    add x0, x5, x2\n");                    // bytes needed after this append
        s = s.write("    adrp x6, __fern_strbuf_cap\n");
        s = s.write("    add x6, x6, :lo12:__fern_strbuf_cap\n");
        s = s.write("    ldr x6, [x6]\n");
        s = s.write("    cmp x0, x6\n");
        s = s.write("    b.ls .Lsbapp_fits\n");
        s = s.write("    bl __fern_strbuf_grow\n");
        s = s.write(".Lsbapp_fits:\n");
        s = s.write("    ldr x1, [x19]\n");                     // src data ptr
        s = s.write("    ldr x2, [x19, #8]\n");                 // src len
        s = s.write("    cbz x2, .Lsbapp_done\n");
        s = s.write("    adrp x3, __fern_strbuf_ptr\n");
        s = s.write("    add x3, x3, :lo12:__fern_strbuf_ptr\n");
        s = s.write("    ldr x3, [x3]\n");
        s = s.write("    adrp x4, __fern_strbuf_len\n");
        s = s.write("    add x4, x4, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x5, [x4]\n");
        s = s.write("    add x3, x3, x5\n");                    // dst = ptr + len
        s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lsbapp_loop_w", ".Lsbapp_loop_t", ".Lsbapp_loop_b", ".Lsbapp_loop_d");
        s = s.write(".Lsbapp_done:\n");
        s = s.write("    ldr x2, [x19, #8]\n");                 // reload src len
        s = s.write("    adrp x4, __fern_strbuf_len\n");
        s = s.write("    add x4, x4, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x5, [x4]\n");
        s = s.write("    add x5, x5, x2\n");
        s = s.write("    str x5, [x4]\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_append, .-__fern_strbuf_append\n");
        // take(): alloc data + 16-byte box, copy bytes, reset, return
        // box ptr in x0. Live values (len, data ptr) held in callee-
        // saved x19/x20 across the __fern_alloc calls.
        s = s.write(".globl __fern_strbuf_take\n");
        s = s.write(".type __fern_strbuf_take, %function\n");
        s = s.write("__fern_strbuf_take:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    adrp x19, __fern_strbuf_len\n");
        s = s.write("    add x19, x19, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x19, [x19]\n");                    // x19 = len
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x20, x0\n");                       // x20 = data ptr
        s = s.write("    adrp x1, __fern_strbuf_ptr\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_ptr\n");
        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    mov x2, x20\n");                       // dst
        s = s.write("    mov x3, x19\n");                       // count
        s = s.write("    cbz x3, .Lsbtake_box\n");
        s = arm64_copy_bytes(s, CopyRegs { dst: "x2", src: "x1", n: "x3", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lsbtake_loop_w", ".Lsbtake_loop_t", ".Lsbtake_loop_b", ".Lsbtake_loop_d");
        s = s.write(".Lsbtake_box:\n");
        // Result box via __fern_str_box, not a bare __fern_alloc(16) — see the
        // x86-64 sibling for why: the drained string is owned, so a drop reaches
        // __fn___fern_str_free, which reads the refcount at box-8.
        s = s.write("    mov x0, x20\n");                       // data
        s = s.write("    mov x1, x19\n");                       // len
        s = s.write("    bl __fern_str_box\n");
        s = s.write("    adrp x1, __fern_strbuf_len\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_len\n");
        s = s.write("    str xzr, [x1]\n");                     // reset
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_take, .-__fern_strbuf_take\n");
    }

    // The capacity-carrying string builder (#8773) — the accumulator above with
    // the handle made explicit, so any number of builders are live at once and
    // they nest. A handle is the address of a 32-byte control block:
    //   [H +  0] data     — the buffer, 0 when a take left the builder unarmed
    //   [H +  8] len      — bytes accumulated so far
    //   [H + 16] cap      — bytes the buffer holds before it has to grow
    //   [H + 24] reserve  — the capacity a re-arm after a take starts from
    // The arm64 twin of asm_ir's bundle, register ABI like the strbuf helpers.
    // The buffer is a bare byte block; a take copies the accumulated bytes
    // into a block of their own length and boxes that, so every block frees
    // at the class it was bumped at (#9179) and the builder keeps its buffer.
    //
    // Unlike the strbuf above, a grown-past buffer is RETURNED to the freelist
    // rather than left to the arena: a builder that doubles its way up from the
    // floor would otherwise strand every prefix it passed through.
    if (s.has_need("buf")) {
        // __fern_buf_new(x0 = cap) -> x0 = handle. The floor gives the doubling
        // something to double.
        s = s.write(".globl __fern_buf_new\n");
        s = s.write(".type __fern_buf_new, %function\n");
        s = s.write("__fern_buf_new:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    cmp x19, #16\n");
        s = s.write("    b.hs .Lbufnew_cap\n");
        s = s.write("    mov x19, #16\n");
        s = s.write(".Lbufnew_cap:\n");
        s = s.write("    mov x0, #32\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x20, x0\n");                       // control block
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x0, [x20]\n");                     // data
        s = s.write("    str xzr, [x20, #8]\n");                // len
        s = s.write("    str x19, [x20, #16]\n");               // cap
        s = s.write("    str x19, [x20, #24]\n");               // reserve
        s = s.write("    mov x0, x20\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_new, .-__fern_buf_new\n");
        // __fern_buf_reserve(x0 = H, x1 = need): replace the buffer with one of
        // at least `need` bytes, doubling from the current capacity (or from
        // the reserve, when a take left the builder unarmed), and carry the
        // live bytes across. Internal — no Fern builtin reaches it.
        s = s.write(".globl __fern_buf_reserve\n");
        s = s.write(".type __fern_buf_reserve, %function\n");
        s = s.write("__fern_buf_reserve:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");                       // H
        s = s.write("    mov x20, x1\n");                       // need
        s = s.write("    ldr x21, [x19, #16]\n");               // cap
        s = s.write("    cbnz x21, .Lbufres_dbl\n");
        s = s.write("    ldr x21, [x19, #24]\n");               // reserve
        s = s.write("    cbnz x21, .Lbufres_dbl\n");
        s = s.write("    mov x21, #64\n");
        s = s.write(".Lbufres_dbl:\n");
        s = s.write("    cmp x21, x20\n");
        s = s.write("    b.hs .Lbufres_alloc\n");
        s = s.write("    lsl x21, x21, #1\n");
        s = s.write("    b .Lbufres_dbl\n");
        s = s.write(".Lbufres_alloc:\n");
        s = s.write("    mov x0, x21\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x22, x0\n");                       // new buffer
        s = s.write("    ldr x2, [x19, #8]\n");                 // live bytes
        s = s.write("    cbz x2, .Lbufres_nocopy\n");
        s = s.write("    ldr x1, [x19]\n");                     // old buffer
        s = s.write("    mov x3, x22\n");
        s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lbufres_copy_w", ".Lbufres_copy_t", ".Lbufres_copy_b", ".Lbufres_copy_d");
        s = s.write(".Lbufres_nocopy:\n");
        s = s.write("    ldr x5, [x19]\n");                     // old buffer
        s = s.write("    cbz x5, .Lbufres_store\n");
        s = s.write("    ldr x6, [x19, #16]\n");                // at the OLD capacity
        s = s.write("    add x6, x6, #7\n");
        s = s.write("    lsr x6, x6, #3\n");
        s = buf_block_free(s, "x5", "x6", "Lbufres_old");
        s = s.write(".Lbufres_store:\n");
        s = s.write("    str x22, [x19]\n");
        s = s.write("    str x21, [x19, #16]\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_reserve, .-__fern_buf_reserve\n");
        // __fern_buf_push(x0 = H, x1 = string box): append every byte of the
        // box's data. Box form only, like __fern_strbuf_append's operand.
        s = s.write(".globl __fern_buf_push\n");
        s = s.write(".type __fern_buf_push, %function\n");
        s = s.write("__fern_buf_push:\n");
        s = s.write("    ldr x3, [x1, #8]\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    b __fern_buf_push_range\n");
        s = s.write(".size __fern_buf_push, .-__fern_buf_push\n");
        // __fern_buf_push_range(x0 = H, x1 = box, x2 = lo, x3 = hi): append
        // s[lo:hi] with no intermediate string. An empty or inverted range is a
        // no-op; the bounds are the caller's, as with slice_unchecked. A push
        // that fits is a leaf with no frame; only a growth saves the operands
        // across the reserve.
        s = s.write(".globl __fern_buf_push_range\n");
        s = s.write(".type __fern_buf_push_range, %function\n");
        s = s.write("__fern_buf_push_range:\n");
        s = s.write("    sub x3, x3, x2\n");
        s = s.write("    cmp x3, #0\n");
        s = s.write("    b.le .Lbufrange_done\n");
        s = s.write("    ldr x4, [x0, #8]\n");
        s = s.write("    add x5, x4, x3\n");
        s = s.write("    ldr x6, [x0, #16]\n");
        s = s.write("    cmp x5, x6\n");
        s = s.write("    b.hi .Lbufrange_grow\n");
        s = s.write(".Lbufrange_copy:\n");
        s = s.write("    str x5, [x0, #8]\n");
        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    add x1, x1, x2\n");
        s = s.write("    ldr x6, [x0]\n");
        s = s.write("    add x6, x6, x4\n");
        s = s.write("    mov x2, x3\n");
        s = arm64_copy_bytes(s, CopyRegs { dst: "x6", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lbufrange_loop_w", ".Lbufrange_loop_t", ".Lbufrange_loop_b", ".Lbufrange_done");
        s = s.write("    ret\n");
        s = s.write(".Lbufrange_grow:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x0, x1, [sp, #-16]!\n");
        s = s.write("    stp x2, x3, [sp, #-16]!\n");
        s = s.write("    mov x1, x5\n");
        s = s.write("    bl __fern_buf_reserve\n");
        s = s.write("    ldp x2, x3, [sp], #16\n");
        s = s.write("    ldp x0, x1, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ldr x4, [x0, #8]\n");
        s = s.write("    add x5, x4, x3\n");
        s = s.write("    b .Lbufrange_copy\n");
        s = s.write(".size __fern_buf_push_range, .-__fern_buf_push_range\n");
        // __fern_buf_push_mapped(x0 = H, x1 = box, x2 = table): append
        // table[c] for each byte c of the box's data, or c itself when it is
        // past the table's length at [table]. Entry i of the table is the low
        // byte of the 8-byte slot 8 + i*8; a table covering every byte value
        // takes the loop with no length check.
        s = s.write(".globl __fern_buf_push_mapped\n");
        s = s.write(".type __fern_buf_push_mapped, %function\n");
        s = s.write("__fern_buf_push_mapped:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x20, x1\n");
        s = s.write("    mov x21, x2\n");                       // table
        s = s.write("    ldr x22, [x20, #8]\n");                // n
        s = s.write("    cbz x22, .Lbufmap_done\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    add x0, x0, x22\n");
        s = s.write("    ldr x1, [x19, #16]\n");
        s = s.write("    cmp x0, x1\n");
        s = s.write("    b.ls .Lbufmap_fits\n");
        s = s.write("    mov x1, x0\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_buf_reserve\n");
        s = s.write(".Lbufmap_fits:\n");
        s = s.write("    ldr x1, [x20]\n");                     // src data
        s = s.write("    ldr x3, [x19]\n");
        s = s.write("    ldr x4, [x19, #8]\n");
        s = s.write("    add x3, x3, x4\n");                    // dst = data + len
        s = s.write("    ldr x4, [x21]\n");                     // table length
        s = s.write("    mov x2, x22\n");
        s = s.write("    cmp x4, #256\n");
        s = s.write("    b.lo .Lbufmap_short\n");
        s = s.write(".Lbufmap_full:\n");
        s = s.write("    ldrb w5, [x1], #1\n");
        s = s.write("    add x6, x21, x5, lsl #3\n");
        s = s.write("    ldrb w5, [x6, #8]\n");
        s = s.write("    strb w5, [x3], #1\n");
        s = s.write("    sub x2, x2, #1\n");
        s = s.write("    cbnz x2, .Lbufmap_full\n");
        s = s.write("    b .Lbufmap_len\n");
        s = s.write(".Lbufmap_short:\n");
        s = s.write("    ldrb w5, [x1], #1\n");
        s = s.write("    cmp x5, x4\n");
        s = s.write("    b.hs .Lbufmap_keep\n");
        s = s.write("    add x6, x21, x5, lsl #3\n");
        s = s.write("    ldrb w5, [x6, #8]\n");
        s = s.write(".Lbufmap_keep:\n");
        s = s.write("    strb w5, [x3], #1\n");
        s = s.write("    sub x2, x2, #1\n");
        s = s.write("    cbnz x2, .Lbufmap_short\n");
        s = s.write(".Lbufmap_len:\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    add x0, x0, x22\n");
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write(".Lbufmap_done:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_push_mapped, .-__fern_buf_push_mapped\n");
        // __fern_buf_push_filtered(x0 = H, x1 = box, x2 = drop): append each
