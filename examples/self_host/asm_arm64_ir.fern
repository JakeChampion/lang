        s = s.write(".globl __fern_buf_push_filtered\n");
        s = s.write(".type __fern_buf_push_filtered, %function\n");
        s = s.write("__fern_buf_push_filtered:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x20, x1\n");
        s = s.write("    mov x21, x2\n");                       // drop
        s = s.write("    ldr x22, [x20, #8]\n");                // n
        s = s.write("    cbz x22, .Lbuffilt_done\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    add x0, x0, x22\n");
        s = s.write("    ldr x1, [x19, #16]\n");
        s = s.write("    cmp x0, x1\n");
        s = s.write("    b.ls .Lbuffilt_fits\n");
        s = s.write("    mov x1, x0\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_buf_reserve\n");
        s = s.write(".Lbuffilt_fits:\n");
        s = s.write("    ldr x1, [x20]\n");                     // src data
        s = s.write("    ldr x3, [x19]\n");
        s = s.write("    ldr x4, [x19, #8]\n");
        s = s.write("    add x3, x3, x4\n");                    // dst = data + len
        s = s.write("    ldr x4, [x21]\n");                     // table length
        s = s.write("    mov x2, x22\n");
        s = s.write("    mov x7, #0\n");                        // kept
        s = s.write(".Lbuffilt_loop:\n");
        s = s.write("    ldrb w5, [x1], #1\n");
        s = s.write("    cmp x5, x4\n");
        s = s.write("    b.hs .Lbuffilt_keep\n");
        s = s.write("    add x6, x21, x5, lsl #3\n");
        s = s.write("    ldrb w6, [x6, #8]\n");
        s = s.write("    cbnz w6, .Lbuffilt_next\n");
        s = s.write(".Lbuffilt_keep:\n");
        s = s.write("    strb w5, [x3], #1\n");
        s = s.write("    add x7, x7, #1\n");
        s = s.write(".Lbuffilt_next:\n");
        s = s.write("    sub x2, x2, #1\n");
        s = s.write("    cbnz x2, .Lbuffilt_loop\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    add x0, x0, x7\n");
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write(".Lbuffilt_done:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_push_filtered, .-__fern_buf_push_filtered\n");
        // __fern_buf_push_expanded(x0 = H, x1 = box, x2 = table): append each
        // byte c of the box's data as the record at table[c*8], a length
        // (above 7 counts as 7) and then the bytes, or c itself when its
        // record is not wholly inside the table. Entry i of the table is the
        // low byte of the 8-byte slot 8 + i*8, so byte c's record starts at
        // table + 8 + c*64. A push of 256 bytes or more through a table of
        // every record first packs the records into 2 KiB of frame, then
        // copies each as one eight-byte store.
        s = s.write(".globl __fern_buf_push_expanded\n");
        s = s.write(".type __fern_buf_push_expanded, %function\n");
        s = s.write("__fern_buf_push_expanded:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x20, x1\n");
        s = s.write("    mov x21, x2\n");                       // table
        s = s.write("    ldr x22, [x20, #8]\n");                // n
        s = s.write("    cbz x22, .Lbufexp_done\n");
        s = s.write("    lsl x0, x22, #3\n");
        s = s.write("    add x0, x0, #8\n");                    // a whole record stored per byte
        s = s.write("    ldr x1, [x19, #8]\n");
        s = s.write("    add x0, x0, x1\n");
        s = s.write("    ldr x1, [x19, #16]\n");
        s = s.write("    cmp x0, x1\n");
        s = s.write("    b.ls .Lbufexp_fits\n");
        s = s.write("    mov x1, x0\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_buf_reserve\n");
        s = s.write(".Lbufexp_fits:\n");
        s = s.write("    ldr x1, [x20]\n");                     // src data
        s = s.write("    ldr x3, [x19]\n");
        s = s.write("    ldr x4, [x19, #8]\n");
        s = s.write("    add x3, x3, x4\n");                    // dst = data + len
        s = s.write("    ldr x4, [x21]\n");
        s = s.write("    lsr x4, x4, #3\n");                    // whole records
        s = s.write("    mov x2, x22\n");
        s = s.write("    cmp x4, #256\n    b.lo .Lbufexp_loop\n");
        s = s.write("    cmp x2, #256\n    b.lo .Lbufexp_loop\n");
        s = s.write("    sub sp, sp, #2048\n    add x6, x21, #8\n    mov x7, #0\n");
        s = s.write(".Lbufexp_pack:\n");
        s = s.write("    ldr x8, [x6, x7, lsl #3]\n    strb w8, [sp, x7]\n");
        s = s.write("    add x7, x7, #1\n    cmp x7, #2048\n    b.lo .Lbufexp_pack\n");
        s = s.write("    mov x9, #7\n");
        s = s.write(".Lbufexp_fast:\n");
        s = s.write("    ldrb w5, [x1], #1\n    ldr x8, [sp, x5, lsl #3]\n");
        s = s.write("    and x7, x8, #255\n    cmp x7, x9\n    csel x7, x7, x9, ls\n");
        s = s.write("    lsr x8, x8, #8\n    str x8, [x3]\n    add x3, x3, x7\n");
        s = s.write("    subs x2, x2, #1\n    b.ne .Lbufexp_fast\n");
        s = s.write("    add sp, sp, #2048\n    b .Lbufexp_len\n");
        s = s.write(".Lbufexp_loop:\n");
        s = s.write("    cbz x2, .Lbufexp_len\n");
        s = s.write("    ldrb w5, [x1], #1\n");
        s = s.write("    cmp x5, x4\n");
        s = s.write("    b.hs .Lbufexp_keep\n");
        s = s.write("    add x6, x21, x5, lsl #6\n");
        s = s.write("    ldr x7, [x6, #8]\n");                  // the record's length
        s = s.write("    cmp x7, #7\n");
        s = s.write("    b.ls .Lbufexp_room\n");
        s = s.write("    mov x7, #7\n");
        s = s.write(".Lbufexp_room:\n");
        s = s.write("    add x6, x6, #16\n");
        s = s.write(".Lbufexp_byte:\n");
        s = s.write("    cbz x7, .Lbufexp_next\n");
        s = s.write("    ldr x8, [x6], #8\n");
        s = s.write("    strb w8, [x3], #1\n");
        s = s.write("    sub x7, x7, #1\n");
        s = s.write("    b .Lbufexp_byte\n");
        s = s.write(".Lbufexp_keep:\n");
        s = s.write("    strb w5, [x3], #1\n");
        s = s.write(".Lbufexp_next:\n");
        s = s.write("    sub x2, x2, #1\n");
        s = s.write("    b .Lbufexp_loop\n");
        s = s.write(".Lbufexp_len:\n");
        s = s.write("    ldr x0, [x19]\n");
        s = s.write("    sub x3, x3, x0\n");                    // the new length
        s = s.write("    str x3, [x19, #8]\n");
        s = s.write(".Lbufexp_done:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_push_expanded, .-__fern_buf_push_expanded\n");
        // __fern_buf_push_byte(x0 = H, x1 = x): append the low byte of x, as a
        // leaf unless the buffer grows.
        s = s.write(".globl __fern_buf_push_byte\n");
        s = s.write(".type __fern_buf_push_byte, %function\n");
        s = s.write("__fern_buf_push_byte:\n");
        s = s.write("    ldr x4, [x0, #8]\n");
        s = s.write("    add x5, x4, #1\n");
        s = s.write("    ldr x6, [x0, #16]\n");
        s = s.write("    cmp x5, x6\n");
        s = s.write("    b.hi .Lbufbyte_grow\n");
        s = s.write(".Lbufbyte_fits:\n");
        s = s.write("    ldr x6, [x0]\n");
        s = s.write("    strb w1, [x6, x4]\n");
        s = s.write("    str x5, [x0, #8]\n");
        s = s.write("    ret\n");
        s = s.write(".Lbufbyte_grow:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x0, x1, [sp, #-16]!\n");
        s = s.write("    mov x1, x5\n");
        s = s.write("    bl __fern_buf_reserve\n");
        s = s.write("    ldp x0, x1, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ldr x4, [x0, #8]\n");
        s = s.write("    add x5, x4, #1\n");
        s = s.write("    b .Lbufbyte_fits\n");
        s = s.write(".size __fern_buf_push_byte, .-__fern_buf_push_byte\n");
        // __fern_buf_push_u64(x0 = H, x1 = v): append the eight bytes of v,
        // least significant first.
        s = s.write(".globl __fern_buf_push_u64\n");
        s = s.write(".type __fern_buf_push_u64, %function\n");
        s = s.write("__fern_buf_push_u64:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x20, x1\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    add x0, x0, #8\n");
        s = s.write("    ldr x1, [x19, #16]\n");
        s = s.write("    cmp x0, x1\n");
        s = s.write("    b.ls .Lbufu64_fits\n");
        s = s.write("    mov x1, x0\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_buf_reserve\n");
        s = s.write(".Lbufu64_fits:\n");
        s = s.write("    ldr x0, [x19]\n");
        s = s.write("    ldr x1, [x19, #8]\n");
        s = s.write("    add x0, x0, x1\n");
        s = s.write("    str x20, [x0]\n");
        s = s.write("    add x1, x1, #8\n");
        s = s.write("    str x1, [x19, #8]\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_push_u64, .-__fern_buf_push_u64\n");
        // __fern_buf_len(x0 = H) -> x0 = len.
        s = s.write(".globl __fern_buf_len\n");
        s = s.write(".type __fern_buf_len, %function\n");
        s = s.write("__fern_buf_len:\n");
        s = s.write("    ldr x0, [x0, #8]\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_len, .-__fern_buf_len\n");
        // __fern_buf_take(x0 = H) -> x0 = string box over a COPY of the
        // accumulated bytes, sized to them, so the block frees at the class
        // it was bumped at (#9179); the builder keeps its buffer at full
        // width with nothing in it. An empty build answers a box over a null
        // buffer — __fn___fern_str_free's low-address guard skips it.
        s = s.write(".globl __fern_buf_take\n");
        s = s.write(".type __fern_buf_take, %function\n");
        s = s.write("__fern_buf_take:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    ldr x20, [x19, #8]\n");                // len
        s = s.write("    cbz x20, .Lbuftake_empty\n");
        s = s.write("    mov x0, x20\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x21, x0\n");                       // the copy
        s = s.write("    ldr x1, [x19]\n");                     // data
        s = s.write("    mov x3, x21\n");
        s = s.write("    mov x2, x20\n");
        s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lbuftake_copy_w", ".Lbuftake_copy_t", ".Lbuftake_copy_b", ".Lbuftake_copy_d");
        s = s.write("    str xzr, [x19, #8]\n");
        s = s.write("    mov x0, x21\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_str_box\n");
        s = s.write("    b .Lbuftake_ret\n");
        s = s.write(".Lbuftake_empty:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    bl __fern_str_box\n");
        s = s.write(".Lbuftake_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_take, .-__fern_buf_take\n");
        // __fern_buf_free(x0 = H): release the buffer (when the builder still
        // owns one) and the control block. A builder is not refcounted and has
        // no drop, so a handle that is never freed leaks, exactly as an fd that
        // is never closed does.
        s = s.write(".globl __fern_buf_free\n");
        s = s.write(".type __fern_buf_free, %function\n");
        s = s.write("__fern_buf_free:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    cbz x19, .Lbuffree_ret\n");
        s = s.write("    ldr x5, [x19]\n");
        s = s.write("    cbz x5, .Lbuffree_ctl\n");
        s = s.write("    ldr x6, [x19, #16]\n");
        s = s.write("    add x6, x6, #7\n");
        s = s.write("    lsr x6, x6, #3\n");
        s = buf_block_free(s, "x5", "x6", "Lbuffree_data");
        s = s.write(".Lbuffree_ctl:\n");
        s = s.write("    mov x5, x19\n");
        s = s.write("    mov x6, #4\n");                        // 32 bytes = 4 words
        s = buf_block_free(s, "x5", "x6", "Lbuffree_ctlblk");
        s = s.write(".Lbuffree_ret:\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_buf_free, .-__fern_buf_free\n");
    }

    // Low-level memory intrinsics (`__alloc` / `__free` / the
    // `__load_*` / `__store_*` pokes / `__ptr_width` / `__memset`)
    // and the RC intrinsics (`__fern_rc_inc` / `__fern_arr_dec` /
    // `__fern_drop_arr_ptr`). Plain runtime functions under the
    // self-host's stack-arg ABI (param[0] at [x29, #16], result in
    // x0). They exist so a program that imports `std/json` /
    // `core/map` links: that map implementation's source pokes raw
    // memory through these names. The self-host's own `Map[K,V]`
    // lowers to the native `__fern_map_*` runtime, so the
    // `core/map` bodies are never actually called — but their
    // symbols must resolve. RC + `__free` are no-ops, consistent
    // with the leak-everything bump heap (nothing is reclaimed).
    s = s.write("__fn___alloc:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___free:\n");
    s = s.write("    ret\n");
    s = s.write("__fn___memset:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");     // dst
    s = s.write("    ldr x1, [x29, #32]\n");     // fill byte
    s = s.write("    ldr x2, [x29, #48]\n");     // count
    s = s.write("    cbz x2, .Lfnmemset_done\n");
    s = s.write(".Lfnmemset_loop:\n");
    s = s.write("    strb w1, [x0], #1\n");
    s = s.write("    subs x2, x2, #1\n");
    s = s.write("    bne .Lfnmemset_loop\n");
    s = s.write(".Lfnmemset_done:\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___load_i32:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");
    s = s.write("    ldrsw x0, [x0]\n");          // i32 load, sign-extended
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___store_i32:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");     // addr
    s = s.write("    ldr x1, [x29, #32]\n");     // val
    s = s.write("    str w1, [x0]\n");            // store low 4 bytes
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___load_i64:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");
    s = s.write("    ldr x0, [x0]\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___load_ptr:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");
    s = s.write("    ldr x0, [x0]\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___store_ptr:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    ldr x0, [x29, #16]\n");     // addr
    s = s.write("    ldr x1, [x29, #32]\n");     // val
    s = s.write("    str x1, [x0]\n");            // store 8 bytes
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___ptr_width:\n");
    s = s.write("    mov x0, #8\n");
    s = s.write("    ret\n");
    // RC intrinsics — Phase 0c real bodies (ported from the native
    // arm64 backend, internal/codegen/arm64/arm64.go). The rc word
    // is a 32-bit count at [data-8]; data is the value pointer
    // callers hold. Guard chain: null -> SSO inline-tag (low bit) ->
    // low-address (< 0x10000) -> static sentinel (rc high bit). Static /
    // immortal cells are distinguished by the rc high-bit sentinel (not by
    // address), so the < 0x10000 guard only filters null-ish / sub-page
    // values; the heap now lives at the 0x10000000 mmap hint and passes it.
    // Frameless: param[0] at [sp]; result in x0 (the input ptr).
    // No free path yet (safe-leak); __fern_arr_dec /
    // __fern_drop_arr_ptr stay no-ops until the layout migration.
    s = s.write("__fn___fern_rc_inc:\n");
    s = s.write("    ldr x0, [sp]\n");            // ptr (also return)
    s = s.write("    cbz x0, .Lshrcinc_ret\n");
    s = s.write("    tbnz x0, #0, .Lshrcinc_ret\n");   // SSO inline tag
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .Lshrcinc_ret\n");        // low-address guard
    s = s.write("    ldur w1, [x0, #-8]\n");       // rc
    s = s.write(san_poison_check("w1", "w9", ".Lshrcinc_live"));
    s = s.write("    tbnz w1, #31, .Lshrcinc_ret\n");  // static sentinel
    s = s.write("    add w1, w1, #1\n");
    s = s.write("    stur w1, [x0, #-8]\n");
    s = s.write(".Lshrcinc_ret:\n");
    s = s.write("    ret\n");
    s = s.write("__fn___fern_rc_dec:\n");
    s = s.write("    ldr x0, [sp]\n");            // ptr (also return)
    s = s.write("    cbz x0, .Lshrcdec_ret\n");
    s = s.write("    tbnz x0, #0, .Lshrcdec_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .Lshrcdec_ret\n");
    s = s.write("    ldur w1, [x0, #-8]\n");
    s = s.write(san_poison_check("w1", "w9", ".Lshrcdec_live"));
    s = s.write("    tbnz w1, #31, .Lshrcdec_ret\n");  // static sentinel
    s = s.write("    cmp w1, #0\n");
    s = s.write("    bgt .Lshrcdec_dec\n");        // rc > 0: normal
    // rc <= 0: over-release — bump the detector.
    s = s.write("    adrp x10, __fern_rc_underflow\n");
    s = s.write("    add x10, x10, :lo12:__fern_rc_underflow\n");
    s = s.write("    ldr w11, [x10]\n");
    s = s.write("    add w11, w11, #1\n");
    s = s.write("    str w11, [x10]\n");
    s = s.write(san_underflow_abort());
    s = s.write(".Lshrcdec_dec:\n");
    s = s.write("    sub w1, w1, #1\n");
    s = s.write("    stur w1, [x0, #-8]\n");
    s = s.write(".Lshrcdec_ret:\n");
    s = s.write("    ret\n");
    // __fern_rc_is_unique(ptr) -> i32 — 1 iff a live heap object
    // with rc == 1; null / inline / low-address / sentinel => 0.
    s = s.write("__fn___fern_rc_is_unique:\n");
    s = s.write("    ldr x2, [sp]\n");            // ptr
    s = s.write("    mov x0, #0\n");              // default: not unique
    s = s.write("    cbz x2, .Lshuniq_ret\n");
    s = s.write("    tbnz x2, #0, .Lshuniq_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x2, x9\n");
    s = s.write("    blo .Lshuniq_ret\n");
    s = s.write("    ldur w3, [x2, #-8]\n");      // rc
    s = s.write(san_poison_check("w3", "w9", ".Lshuniq_live"));
    s = s.write("    tbnz w3, #31, .Lshuniq_ret\n");   // sentinel => immortal
    s = s.write("    cmp w3, #1\n");
    s = s.write("    bne .Lshuniq_ret\n");
    s = s.write("    mov x0, #1\n");
    s = s.write(".Lshuniq_ret:\n");
    s = s.write("    ret\n");
    // __fern_arr_inc_elems(arr) -> arr: one guarded __fn___fern_rc_inc per
    // element of a pointer-element array, the arm64 sibling of the x86-64
    // body in asm_ir.emit_ir_runtime. irlower emits it ahead of a copy of a
    // pointer-element buffer so both buffers hold a count of each element.
    // Same guard chain as the deep-free walks; x19/x20/x21 hold arr/len/i
    // across the bl (callee-saved, x30 saved too). Gated on its need like
    // the x86-64 body.
    if (s.has_need("arr_inc_elems")) {
    s = s.write("__fn___fern_arr_inc_elems:\n");
    s = s.write("    ldr x0, [sp]\n");              // arr (also the result)
    s = s.write("__fn___fern_arr_inc_elems.r:\n");
    s = s.write("    cbz x0, .Laie_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .Laie_ret\n");
    s = s.write("    ldur w1, [x0, #-8]\n");        // rc
    s = s.write(san_poison_check("w1", "w9", ".Laie_live"));
    s = s.write("    tbnz w1, #31, .Laie_ret\n");   // immortal buffer: its elements are too
    s = s.write("    stp x19, x30, [sp, #-16]!\n");
    s = s.write("    stp x20, x21, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");               // arr
    s = s.write("    ldr x20, [x19]\n");            // len @ [arr]
    s = s.write("    mov x21, #0\n");               // i
    s = s.write(".Laie_loop:\n");
    s = s.write("    cmp x21, x20\n");
    s = s.write("    bge .Laie_done\n");
    s = s.write("    add x9, x21, #1\n");
    s = s.write("    ldr x0, [x19, x9, lsl #3]\n"); // element i @ [arr+(i+1)*8]
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_inc\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    add x21, x21, #1\n");
    s = s.write("    b .Laie_loop\n");
    s = s.write(".Laie_done:\n");
    s = s.write("    mov x0, x19\n");
    s = s.write("    ldp x20, x21, [sp], #16\n");
    s = s.write("    ldp x19, x30, [sp], #16\n");
    s = s.write(".Laie_ret:\n");
    s = s.write("    ret\n");
    }
    // __fern_alloc_reuse(token@[sp,#16], slots@[sp]) -> x0 = data — the
    // FBIP reuse-degrade primitive (#4350), arm64 mirror of the x86
    // __fn___fern_alloc_reuse. Same arr-box layout (cap@data-16, rc@data-8):
    // null token -> fresh __fern_arr_box(slots); cap match -> hand the SAME
    // block back (rc stays 1 — the caller's __fern_rc_is_unique gate
    // guaranteed sole ownership; the caller overwrites the shape slot before
    // any read); cap mismatch -> return the donor block to its word-indexed
    // freelist class (the __fn___fern_snapshot_dec free idiom: clear rc,
    // *base = head, freelist[cap+3] = base; >= 65536 words leaks, matching
    // __fern_alloc's no-freelist tier) and alloc fresh. Clobbers x0..x6, x9.
    s = s.write("__fn___fern_alloc_reuse:\n");
    s = s.write("    ldr x0, [sp, #16]\n");        // token (donor data ptr, or 0)
    s = s.write("    cbz x0, .Lsarelo_fresh\n");
    s = s.write("    ldr x1, [sp]\n");             // slots (payload words: struct nf+1 incl. shape, tuple arity)
    s = s.write("    ldur x2, [x0, #-16]\n");      // donor cap
    s = s.write("    cmp x2, x1\n");
    s = s.write("    beq .Lsarelo_ret\n");         // reuse: return token in x0
    s = s.write("    add x3, x2, #3\n");           // block words = donor cap + 3
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x3, x9\n");
    s = s.write("    bhs .Lsarelo_fresh\n");       // oversize tier: leak
    // Quarantine (rc_free_debug_on): the mispaired donor is freed here, so it
    // gets the same poison-and-decline every other free path applies.
    s = s.write(quarantine_rc("[x0, #-8]", "w6"));  // release the rc word
    s = s.write("    sub x4, x0, #16\n");          // block base
    s = lc_bump_free_words(s, "x3", "x2", "x9");
    if (!rc_free_debug_on()) {
    s = freelist_push(s, "x4", "x3", "x5", "x6");
    }
    s = s.write(".Lsarelo_fresh:\n");
    s = s.write("    ldr x0, [sp]\n");             // slots = arr_box cap
    // TAIL-branch (not bl): arr_box returns straight to OUR caller with
    // the fresh data ptr in x0 — no frame needed, and the emitted text
    // stays free of an extra `bl __fern_arr_box` line (the reuse contract
    // tests count that exact string in the whole asm).
    s = s.write("    b __fern_arr_box\n");
    s = s.write(".Lsarelo_ret:\n");
    s = s.write("    ret\n");
    // __fern_rc_underflow_count() -> i32 — read the detector.
    s = s.write("__fn___fern_rc_underflow_count:\n");
    s = s.write("    adrp x10, __fern_rc_underflow\n");
    s = s.write("    add x10, x10, :lo12:__fern_rc_underflow\n");
    s = s.write("    ldr w0, [x10]\n");
    s = s.write("    ret\n");
    // __fern_snapshot_dec(new, old, snap) -> new (#3456 slice 2). Frees `old`
    // (rc-guarded SHALLOW box release, the __fern_arr_dec free path) only when
    // it differs from BOTH `new` (cow) AND `snap` (the caller's original, never
    // freed). Returns `new` in x0. arm64 mirror of asm_ir.emit_ir_runtime's
    // body — same heap layout as __fern_arr_dec below (rc @ [old-8], cap @
    // [old-16], base = old-16, idx = cap+3, freelist word-indexed, class cap
    // 65536). Stack-arg ABI: [sp]=snap, [sp+16]=old, [sp+32]=new. Clobbers
    // x0..x6, x9.
    s = s.write("__fn___fern_snapshot_dec:\n");
    s = s.write("    ldr x0, [sp, #32]\n");        // new (return value)
    s = s.write("    ldr x1, [sp, #16]\n");        // old
    s = s.write("    cmp x1, x0\n");               // old == new? (cow)
    s = s.write("    beq .Lsd_ret\n");
    s = s.write("    ldr x2, [sp]\n");             // snap
    s = s.write("    cmp x1, x2\n");               // old == snap? (caller's original)
    s = s.write("    beq .Lsd_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x1, x9\n");               // old < 0x10000? (low-addr / SSO)
    s = s.write("    blo .Lsd_ret\n");
    s = s.write("    ldur w3, [x1, #-8]\n");       // old rc
    s = s.write(san_poison_check("w3", "w9", ".Lsd_live"));
    s = s.write("    tbnz w3, #31, .Lsd_ret\n");   // static sentinel (rc<0)
    s = s.write("    cmp w3, #1\n");
    s = s.write("    bne .Lsd_ret\n");             // shared/other — leave (defensive)
    s = s.write("    ldur x4, [x1, #-16]\n");      // old cap
    s = s.write("    add x4, x4, #3\n");           // idx = cap + 3
    s = s.write("    mov x9, #0x10000\n");         // freelist class cap (65536)
    s = s.write("    cmp x4, x9\n");
    s = s.write("    bhs .Lsd_large\n");           // large tier -> recycle via __fern_large_push
    s = s.write(quarantine_rc("[x1, #-8]", "w9"));  // release the rc word
    s = s.write("    sub x5, x1, #16\n");          // base = old - 16
    s = lc_bump_free_words(s, "x4", "x2", "x3");
    if (!rc_free_debug_on()) {
    s = freelist_push(s, "x5", "x4", "x6", "x9");
    }
    s = s.write(".Lsd_ret:\n");
    s = s.write("    ret\n");                      // x0 = new
    // Large tier (#3425): recycle the >=512 KiB old box (base = old-16, bytes =
    // idx*8) instead of leaking. snapshot_dec is a leaf, but the large path is
    // terminal, so TAIL-branch: __fern_large_push preserves x0 (= new, the
    // return value) and its ret returns to snapshot_dec's caller (x30 untouched).
    s = s.write(".Lsd_large:\n");
    s = s.write(quarantine_rc("[x1, #-8]", "w9"));  // release the rc word (x1 = old)
    s = s.write("    lsl x2, x4, #3\n");           // bytes = idx*8
    s = s.write("    sub x1, x1, #16\n");          // base = old-16
    s = s.write("    b __fern_large_push\n");      // tail: rets to caller, x0 = new preserved
    return s;
}

// emit_rt_large_tier_and_rc emits the large-block tier (__fern_large_push and the >=512 KiB
// recycling bins) and the reference-counting release helpers, including the
// need-gated nested-array frees.
function emit_rt_large_tier_and_rc(s: asmcore.EmitState): asmcore.EmitState {
    // __fern_large_push(base=x1, bytes=x2): return a freed >=512 KiB block to
    // the large tier (#3425), arm64 twin of asm_ir's helper. Bins by the same
    // linear round-up __fern_alloc uses (class = round_up(bytes,512KiB)>>19) and
    // pushes (successor in the block's first word). >1 GiB is dropped. Clobbers
    // x1..x4, PRESERVES x0 (so a caller mid-free — e.g. str_free with box in x0 —
    // survives). A caller that only ret's after can TAIL-BRANCH here (b, not bl),
    // so its ret-addr in x30 flows straight through.
    s = s.write("__fern_large_push:\n");
    s = s.write("    mov x3, #1\n");
    s = s.write("    lsl x3, x3, #30\n");           // 1 GiB
    s = s.write("    cmp x2, x3\n");
    s = s.write("    b.hi .Llpush_ret\n");          // > 1 GiB: drop (leak, matches alloc)
    // Census (#5362): the large tier's single choke point — one bump covers
    // every >=512 KiB free, at the CALLER-passed bytes (the logical size),
    // before the class rounding below mutates x2. Placed after the >1 GiB
    // test: that block is dropped, i.e. a leak, not a free.
    s = lc_bump_free_add(s, "x2", "x3", "x4");
    // Quarantine (rc_free_debug_on): the large tier's single choke point —
    // one decline covers every >=512 KiB free, including the arms that
    // tail-branch here. Callers with an rc word have already poisoned it at
    // their own rc store, and recycling the block would overwrite that poison.
    if (!rc_free_debug_on()) {
    s = s.write("    mov x3, #1\n");
    s = s.write("    lsl x3, x3, #19\n");           // 512 KiB
    s = s.write("    sub x3, x3, #1\n");            // 512 KiB - 1
    s = s.write("    add x2, x2, x3\n");            // bytes + (512 KiB - 1)
    s = s.write("    lsr x2, x2, #19\n");           // class = round_up(bytes,512KiB) >> 19
    s = s.write("    adrp x3, __fern_large_freelist\n");
    s = s.write("    add x3, x3, :lo12:__fern_large_freelist\n");
    s = s.write("    ldr x4, [x3, x2, lsl #3]\n");  // old head
    s = s.write("    str x4, [x1]\n");              // *base = old head
    s = s.write("    str x1, [x3, x2, lsl #3]\n");  // heads[class] = base
    }
    s = s.write(".Llpush_ret:\n");
    s = s.write("    ret\n");
    // __fern_raw_free(x0 = block, x1 = bytes) — the return path for a block
    // `__fern_alloc` handed out raw, with no rc header: core/map's buffers, and
    // whatever else reaches the `__free` builtin. The block's own first word is
    // the freelist link, so one too small to hold it is dropped, exactly as the
    // allocator's classing assumes. buf_block_free carries both tiers, and its
    // large arm calls out, so this frame saves the link register.
    s = s.write("__fern_raw_free:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    cbz x0, .Lrawfree_done\n");
    s = s.write("    add x1, x1, #7\n");
    s = s.write("    lsr x5, x1, #3\n");
    s = s.write("    cbz x5, .Lrawfree_done\n");
    s = buf_block_free(s, "x0", "x5", "Lrawfree_b");
    s = s.write(".Lrawfree_done:\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write("__fn___fern_arr_dec:\n");
    s = s.write("    ldr x0, [sp]\n");
    s = s.write("__fn___fern_arr_dec.r:\n");
    s = s.write("    cbz x0, .Larrdec_ret\n");
    s = s.write("    cmp x0, #16, lsl #12\n");
    s = s.write("    blo .Larrdec_ret\n");
    s = s.write("    ldur w1, [x0, #-8]\n");      // rc
    s = s.write(san_poison_check("w1", "w9", ".Larrdec_live"));
    s = s.write("    tbnz w1, #31, .Larrdec_ret\n");   // static sentinel
    s = s.write("    cmp w1, #1\n");
    s = s.write("    beq .Larrdec_free\n");
    s = s.write("    bgt .Larrdec_dec\n");        // rc > 1
    s = s.write("    adrp x2, __fern_rc_underflow\n");   // rc <= 0
    s = s.write("    add x2, x2, :lo12:__fern_rc_underflow\n");
    s = s.write("    ldr w3, [x2]\n");
    s = s.write("    add w3, w3, #1\n");
    s = s.write("    str w3, [x2]\n");
    s = s.write(san_underflow_abort());
    s = s.write("    b .Larrdec_ret\n");
    s = s.write(".Larrdec_dec:\n");
    s = s.write("    sub w1, w1, #1\n");
    s = s.write("    stur w1, [x0, #-8]\n");
    s = s.write("    b .Larrdec_ret\n");
    s = s.write(".Larrdec_free:\n");
    s = s.write(quarantine_rc("[x0, #-8]", "w9"));  // release the rc word
    s = s.write("    ldur x1, [x0, #-16]\n");      // cap
    s = s.write("    add x1, x1, #3\n");           // idx = cap + 3
    s = s.write("    mov x9, #0x10000\n");         // freelist class cap (65536)
    s = s.write("    cmp x1, x9\n");
    s = s.write("    bhs .Larrdec_large\n");
    s = s.write("    sub x2, x0, #16\n");          // base = data - 16
    s = lc_bump_free_words(s, "x1", "x3", "x9");
    if (!rc_free_debug_on()) {
    s = freelist_push(s, "x2", "x1", "x3", "x9");
    }
    s = s.write(".Larrdec_ret:\n");
    s = s.write("    ret\n");
    // Large tier (#3425): recycle the >=512 KiB array block (base=data-16, bytes
    // =idx*8) via __fern_large_push instead of leaking. Tail-branch (b): the
    // helper's ret returns to arr_dec's caller, x30 flows through untouched.
    s = s.write(".Larrdec_large:\n");
    s = s.write("    lsl x2, x1, #3\n");           // bytes = idx * 8
    s = s.write("    sub x1, x0, #16\n");          // base = data - 16
    s = s.write("    b __fern_large_push\n");
    // __fern_str_free(box) — RC-AWARE release of a HEAP string box (#2649), the
    // arm64 sibling of the x86-64 body in asm_ir.emit_ir_runtime. A self-host
    // heap string is the 24-byte block __fern_str_box builds ({rc@base,
    // data@base+8, len@base+16}, box = base+8), so rc<0 = immortal/view (skip),
    // rc>1 = shared (dec, keep), rc==1 = sole owner (free the data buffer at
    // class ceil(len/8) words AND the box at class 3), rc==0 = double free
    // (underflow counter, no heap corruption). Safe to call on any string box.
    // x0=box, x1=data, x2=len/words, x3=freelist, x9/x10 scratch.
    s = s.write("__fn___fern_str_free:\n");
    s = s.write("    ldr x0, [sp]\n");             // box
    s = s.write("__fn___fern_str_free.r:\n");
    s = s.write("    cbz x0, .Lstrfree_ret\n");
    s = s.write("    tbnz x0, #0, .Lstrfree_ret\n");   // tagged / SSO sentinel (defensive)
    // x9 is both the heap floor here and the freelist class cap below.
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .Lstrfree_ret\n");        // low-addr guard
    // rc word @ box-8 (#2649 Option A A1b rc-headered box): negative = immortal
    // sentinel (skip); rc>1 decrements without freeing; rc==1 frees data + box;
    // rc==0 is a double-free, caught by __fern_rc_underflow (matching arr_dec)
    // rather than corrupting the heap. w4 holds rc across the free (x1/x2 = data/len).
    s = s.write("    ldur w4, [x0, #-8]\n");       // rc
    s = s.write(san_poison_check("w4", "w10", ".Lstrfree_live"));
    s = s.write("    tbnz w4, #31, .Lstrfree_ret\n");  // negative = immortal -> skip
    s = s.write("    cmp w4, #1\n");
    s = s.write("    bgt .Lstrfree_dec\n");        // rc>1 -> dec, keep
    s = s.write("    blt .Lstrfree_uf\n");         // rc==0 -> underflow (double free)
    // rc==1, FUSED box (#7351): data lives inside this block, so there is one
    // 24+len-byte allocation to return, not a box and a buffer. x2 is reloaded with
    // len on both arms.
    s = s.write("    ldur w2, [x0, #-4]\n");       // fused marker @ box-4
    s = mov_fused_marker(s, "w3");
    s = s.write("    cmp w2, w3\n");
    s = s.write("    beq .Lstrfree_fused\n");
    // rc==1: sole owner -> free data buffer (heap-guarded) then the 24-byte box.
    s = s.write("    ldr x1, [x0]\n");             // data = box[0]
    s = s.write("    ldr x2, [x0, #8]\n");         // len  = box[8]
    s = s.write("    cmp x1, x9\n");               // data null/low -> skip buffer free
    s = s.write("    blo .Lstrfree_box\n");
    // Free the data buffer ONLY when it is a heap allocation, in
    // [__fern_heap_base, __fern_heap_end). A string LITERAL's data is in
    // .rodata (below the arena), so skip it — freeing it would push a
    // read-only address onto the freelist and fault when written. This lets
    // the accumulator's initial "" literal pass __fern_str_free harmlessly
    // (its 16-byte box is still freed). x11/x12 scratch.
    s = s.write("    adrp x11, __fern_heap_base\n");
    s = s.write("    add x11, x11, :lo12:__fern_heap_base\n");
    s = s.write("    ldr x11, [x11]\n");           // heap_base
    s = s.write("    cmp x1, x11\n");              // data < heap_base -> literal/.rodata, skip
    s = s.write("    blo .Lstrfree_box\n");
    s = s.write("    adrp x12, __fern_heap_end\n");
    s = s.write("    add x12, x12, :lo12:__fern_heap_end\n");
    s = s.write("    ldr x12, [x12]\n");           // heap_end
    s = s.write("    cmp x1, x12\n");              // data >= heap_end -> not our arena, skip
    s = s.write("    bhs .Lstrfree_box\n");
    s = s.write("    cmp x2, #0\n");               // len <= 0 -> skip buffer free (leak, sound)
    s = s.write("    ble .Lstrfree_box\n");
    s = s.write("    add x2, x2, #7\n");           // words = ceil(len/8)
    s = s.write("    lsr x2, x2, #3\n");
    s = s.write("    cmp x2, x9\n");               // large tier (>=65536) -> leak buffer
    s = s.write("    bhs .Lstrfree_box\n");
    s = lc_bump_free_words(s, "x2", "x3", "x10");
    // Quarantine (rc_free_debug_on): the DATA buffer carries no rc word, so
    // declining the push is the whole treatment for it.
    if (!rc_free_debug_on()) {
    s = freelist_push(s, "x1", "x2", "x3", "x10");
    }
    s = s.write(".Lstrfree_box:\n");
    // The rc-headered block is base = box-8 (24 bytes = class 3). Clear rc first
    // (defensive vs a re-free reading a live rc), then push base onto freelist[3].
    s = s.write(quarantine_rc("[x0, #-8]", "w10"));  // release the rc word
    s = s.write("    sub x1, x0, #8\n");           // base = box-8
    s = lc_bump_free_add(s, "#24", "x3", "x10");
    if (!rc_free_debug_on()) {
    s = s.write("    adrp x3, __fern_freelist\n");
    s = s.write("    add x3, x3, :lo12:__fern_freelist\n");
    s = s.write("    ldr x10, [x3, #24]\n");       // freelist[3] (24-byte block = 3 words)
    s = s.write("    str x10, [x1]\n");            // *base = old head
    s = s.write("    str x1, [x3, #24]\n");        // freelist[3] = base
    }
    s = s.write("    b .Lstrfree_ret\n");
    // Fused block (#7351): base = box-8 = data-24, size = the 24-byte header plus
    // the buffer, so class = 3 + ceil(len/8) words. len is the LOGICAL length; a
    // producer that over-allocated (read_all_stdin's 32 MiB for a short read) hands
    // the freelist a block bigger than the class it lands in, which wastes the
    // slack but never overruns — the same trade the separate-buffer path above has
    // always made when it freed at ceil(len/8). Unlike that path a large block is
    // RECYCLED rather than leaked: the whole string is one allocation now, so
    // leaking it would leak the box with it.
    s = s.write(".Lstrfree_fused:\n");
    s = s.write("    ldr x2, [x0, #8]\n");         // len = box[8]
    s = s.write("    add x2, x2, #7\n");           // words = ceil(len/8) + 3
    s = s.write("    lsr x2, x2, #3\n");
    s = s.write("    add x2, x2, #3\n");
    s = s.write(quarantine_rc("[x0, #-8]", "w10"));  // release the rc word
    s = s.write("    sub x1, x0, #8\n");           // base = box-8
    s = s.write("    cmp x2, x9\n");               // large tier (>=65536 words)
    s = s.write("    bhs .Lstrfree_fused_large\n");
    s = lc_bump_free_words(s, "x2", "x3", "x10");
    if (!rc_free_debug_on()) {
    s = freelist_push(s, "x1", "x2", "x3", "x10");
    }
    s = s.write("    b .Lstrfree_ret\n");
    // Tail-branch to __fern_large_push (x1 = base, x2 = bytes), as .Larrdec_large
    // does: x30 flows through, and the census bump lives INSIDE that helper, so
    // this arm must not emit its own.
    s = s.write(".Lstrfree_fused_large:\n");
    s = s.write("    lsl x2, x2, #3\n");           // bytes = words * 8
    s = s.write("    b __fern_large_push\n");
    s = s.write(".Lstrfree_dec:\n");
    s = s.write("    sub w4, w4, #1\n");
    s = s.write("    stur w4, [x0, #-8]\n");
    s = s.write("    b .Lstrfree_ret\n");
    s = s.write(".Lstrfree_uf:\n");
    s = s.write("    adrp x2, __fern_rc_underflow\n");
    s = s.write("    add x2, x2, :lo12:__fern_rc_underflow\n");
    s = s.write("    ldr w3, [x2]\n");
    s = s.write("    add w3, w3, #1\n");
    s = s.write("    str w3, [x2]\n");
    s = s.write(san_underflow_abort());
    s = s.write(".Lstrfree_ret:\n");
    s = s.write("    ret\n");
    // __fern_str_view_free(box) — release a string result that may be a zero-copy
    // VIEW (#6544), the arm64 sibling of the x86-64 body in
    // asm_ir.emit_ir_runtime. `s[a:b]` builds a 24-byte box over the SOURCE's
    // bytes and stamps rc = -1, the immortal sentinel, precisely so no reclaim
    // path frees the shared data — which leaves the box itself unreclaimable,
    // one per call of every borrowing string method.
    //
    // An IMMORTAL rc frees the 24-byte box ALONE (class 3), data untouched; any
    // other rc tail-branches to __fn___fern_str_free (x30 flows through, as at
    // .Larrdec_large). The heap-range guard on the BOX BASE is what makes the
    // sentinel exact: the frame form of this op and the `.data` const-aggregate
    // blocks carry the same sentinel and are outside the arena.
    s = s.write("__fn___fern_str_view_free:\n");
    s = s.write("    ldr x0, [sp]\n");             // box
    s = s.write("    cbz x0, .Lstrvfree_ret\n");
    s = s.write("    tbnz x0, #0, .Lstrvfree_ret\n");  // tagged / SSO sentinel (defensive)
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .Lstrvfree_ret\n");       // low-addr guard
    s = s.write("    ldur w4, [x0, #-8]\n");       // rc
    s = s.write(san_poison_check("w4", "w10", ".Lstrvfree_live"));
    s = s.write("    tbnz w4, #31, .Lstrvfree_view\n");  // negative = immortal -> the view case
    s = s.write("    b __fn___fern_str_free\n");   // otherwise: the ordinary rc-aware release
    s = s.write(".Lstrvfree_view:\n");
    s = s.write("    sub x1, x0, #8\n");           // base = box-8
    s = s.write("    adrp x11, __fern_heap_base\n");
    s = s.write("    add x11, x11, :lo12:__fern_heap_base\n");
    s = s.write("    ldr x11, [x11]\n");
    s = s.write("    cmp x1, x11\n");              // base < heap_base -> frame / .data box, skip
    s = s.write("    blo .Lstrvfree_ret\n");
    s = s.write("    adrp x12, __fern_heap_end\n");
    s = s.write("    add x12, x12, :lo12:__fern_heap_end\n");
    s = s.write("    ldr x12, [x12]\n");
    s = s.write("    cmp x1, x12\n");              // base >= heap_end -> not our arena, skip
    s = s.write("    bhs .Lstrvfree_ret\n");
    s = s.write(quarantine_rc("[x0, #-8]", "w10"));  // release the rc word (defensive vs a re-free)
    s = lc_bump_free_add(s, "#24", "x3", "x10");
    if (!rc_free_debug_on()) {
    s = s.write("    adrp x3, __fern_freelist\n");
    s = s.write("    add x3, x3, :lo12:__fern_freelist\n");
    s = s.write("    ldr x10, [x3, #24]\n");       // freelist[3] (24-byte block = 3 words)
    s = s.write("    str x10, [x1]\n");            // *base = old head
    s = s.write("    str x1, [x3, #24]\n");        // freelist[3] = base
    }
    s = s.write(".Lstrvfree_ret:\n");
    s = s.write("    ret\n");
    // __fern_str_arr_free(arr) — string[] ELEMENT reclaim (#4355), the arm64
    // sibling of the x86-64 body in asm_ir.emit_ir_runtime and the element-
    // walking sibling of __fn___fern_arr_dec. rc@[arr-8]: negative = immortal
    // (skip); rc>1 -> dec, elements untouched; rc==0 -> underflow detector;
    // rc==1 -> __fn___fern_str_free every element box (each fully rc-guarded)
    // then free the buffer to its size-class freelist (base=arr-16,
    // class=cap+3), exactly as __fn___fern_arr_dec's free path. Array layout
    // (__fern_arr_box): cap@[arr-16], rc@[arr-8], len@[arr], element i @
    // [arr+8+i*8]. Called ONLY on irlower-proven fresh string[] locals
    // (slot_is_reclaimable_strarr). Stack-arg ABI (arr at [sp]); x19/x20/x21
    // hold arr/len/i across the bl calls (callee-saved; x30 saved too —
    // __fn___fern_str_free is a leaf and preserves them).
    s = emit_arm64_arr_deep_free_variant(s, "str_arr_free", "saf", arm64_arr_deep_free_call("str_free"));
    // __fern_arrarr_free(arr) — one rc-guarded dec per element, then the buffer
    // (#4355 slice 9), the arm64 sibling of the x86-64 body in
    // asm_ir.emit_ir_runtime: identical shell to __fn___fern_str_arr_free above,
    // but each element is released fully by one rc-guarded __fn___fern_arr_dec.
    // Same two callers as x86 — an arr-of-arr local (elements are inner scalar
    // buffers) and the struct/enum-array field release in __struct_drop_<T> /
    // __field_reclaim_<T> (elements are struct/enum boxes). Same register
    // discipline (x19/x20/x21 + x30 saved across the bl). Gated on need (seeded
    // at both), mirroring the x86 gating: an unrelated binary must not carry the
    // strarrarr body's `bl __fn___fern_str_arr_free` (negative asm-grep
    // contracts, e.g. strarr-elem-alias-excluded).
    if (s.has_need("arrarr_free")) {
    s = emit_arm64_arr_deep_free_variant(s, "arrarr_free", "aaf", arm64_arr_deep_free_call("arr_dec"));
    }
    // __fern_strarrarr_free(arr) — string[][] reclaim (#4355 slice 9): each
    // element is a string[] INNER buffer released fully by
    // __fn___fern_str_arr_free (string boxes + inner buffer, rc-guarded).
    // Same need-gating rationale as __fn___fern_arrarr_free above.
    if (s.has_need("strarrarr_free")) {
    s = emit_arm64_arr_deep_free_variant(s, "strarrarr_free", "ssaf", arm64_arr_deep_free_call("str_arr_free"));
    }
    // __fern_optarrarr_free(arr) — Option[<scalar-arr>][] reclaim (#4365),
    // the arm64 sibling of the x86-64 body: per element (an rc-headered
    // [tag@0, payload@8] option box), a UNIQUELY-owned box first decs its
    // Some-payload buffer (tag 0), then the box is arr_dec'd (rc-guarded),
    // then the outer buffer is freed like __fn___fern_arrarr_free. Same
    // register discipline and need-gating rationale as the bodies above.
    if (s.has_need("optarrarr_free")) {
    s = emit_arm64_arr_deep_free_variant(s, "optarrarr_free", "oaf", arm64_optarrarr_elem());
    }
    // __fern_map_free(box) — release one unit of a map, the arm64 sibling of
    // the x86-64 body in asm_ir.emit_ir_runtime. The box is a two-word
    // {keys@0, vals@8} __fern_arr_box, so it carries a count: a shared box is
    // decremented and left whole, and the last unit frees both columns
    // (rc-guarded, via __fn___fern_arr_dec — no-op if aliased by a
    // keys()/values() view) THEN returns the box to its class. The AST lowering
    // calls it only on compile-time-proven fresh, non-escaping, non-iterated map
    // locals (irlower slot_is_reclaimable_map), whose count is always 1; the
    // semantic lowering shares a box and releases it by count. Null / low-addr
    // guarded (a null slot / the precise-drop + exit-sweep double-call are safe
    // no-ops). In THIS variant both columns are shallow, so boxes they hold leak
    // one level (sound; a credited column takes a deep variant below instead).
    // Stack-arg ABI (box at [sp]); x19 holds the box across the nested arr_dec
    // calls (callee-saved; __fern_arr_dec uses no bl so x30 survives too, but
    // both are saved for safety). x9 scratch. Need-gated with the rest of the
    // map runtime: a program with no map carries none of the family.
    if (s.has_need("maps")) {
    s = emit_arm64_map_free_variant(s, "",     "arr_dec",      "arr_dec",      "mapfree");
    // The deep-release variants (#4353), the arm64 siblings of the x86-64 family:
    // a credited fresh-string column is freed per element via __fern_str_arr_free,
    // a credited fresh one-dec-BOX column (scalar-element array / all-scalar
    // struct) via __fern_arrarr_free. Called only on irlower-proven columns
    // (MAPVS: / MAPKS: / MAPVA:), where the map is the sole rc=1 owner of every
    // element.
    s = emit_arm64_map_free_variant(s, "_vs",   "arr_dec",      "str_arr_free", "mapfvs");
    s = emit_arm64_map_free_variant(s, "_ks",   "str_arr_free", "arr_dec",      "mapfks");
    s = emit_arm64_map_free_variant(s, "_kvs",  "str_arr_free", "str_arr_free", "mapfkvs");
    }
    // Need-gated: these name __fn___fern_arrarr_free, whose own body is need-gated.
    if (s.has_need("map_free_va")) {
    s = emit_arm64_map_free_variant(s, "_va",   "arr_dec",      "arrarr_free",  "mapfva");
    s = emit_arm64_map_free_variant(s, "_ksva", "str_arr_free", "arrarr_free",  "mapfksva");
    }
    // The BOX-KEY siblings (#9966), the arm64 half: a struct- or enum-keyed
    // column is a column of boxes exactly as a MAPVA: value column is, so it
    // takes the same __fern_arrarr_free. Need-gated one by one for the same
    // reason as the pair above — each names __fn___fern_arrarr_free, and
    // _kavsa __fn___fern_strarrarr_free on top of it.
    if (s.has_need("map_free_ka")) {
    s = emit_arm64_map_free_variant(s, "_ka",    "arrarr_free",  "arr_dec",        "mapfka");
    }
    if (s.has_need("map_free_kavs")) {
    s = emit_arm64_map_free_variant(s, "_kavs",  "arrarr_free",  "str_arr_free",   "mapfkavs");
    }
    if (s.has_need("map_free_kava")) {
    s = emit_arm64_map_free_variant(s, "_kava",  "arrarr_free",  "arrarr_free",    "mapfkava");
    }
    if (s.has_need("map_free_kavsa")) {
    s = emit_arm64_map_free_variant(s, "_kavsa", "arrarr_free",  "strarrarr_free", "mapfkavsa");
    }
    // A string[] value column: each value released whole by __fern_str_arr_free,
    // which is __fern_strarrarr_free's element walk. Need-gated like the pair above.
    if (s.has_need("map_free_vsa")) {
    s = emit_arm64_map_free_variant(s, "_vsa",   "arr_dec",      "strarrarr_free", "mapfvsa");
    s = emit_arm64_map_free_variant(s, "_ksvsa", "str_arr_free", "strarrarr_free", "mapfksvsa");
    }
    // A column of boxes: each value is released by the function the caller
    // passes, then the column buffer is freed shallow.
    if (s.has_need("map_free_vf")) {
    s = emit_arm64_map_free_fn_variant(s, "_vf",   false, "arr_dec",      true, "arr_dec", "mapfvf");
    s = emit_arm64_map_free_fn_variant(s, "_ksvf", false, "str_arr_free", true, "arr_dec", "mapfksvf");
    }
    // A KEYED column (#9962): each key is released by the function the caller
    // passes, the value column as its own suffix says — `_kfvf` takes the
    // value's release as a third argument. Need-gated one by one: `_kfvsa`
    // names __fn___fern_strarrarr_free, whose body is need-gated too.
    if (s.has_need("map_free_kf")) {
    s = emit_arm64_map_free_fn_variant(s, "_kf",    true, "arr_dec", false, "arr_dec",        "mapfkf");
    }
    if (s.has_need("map_free_kfvs")) {
    s = emit_arm64_map_free_fn_variant(s, "_kfvs",  true, "arr_dec", false, "str_arr_free",   "mapfkfvs");
    }
    if (s.has_need("map_free_kfvsa")) {
    s = emit_arm64_map_free_fn_variant(s, "_kfvsa", true, "arr_dec", false, "strarrarr_free", "mapfkfvsa");
    }
    if (s.has_need("map_free_kfvf")) {
    s = emit_arm64_map_free_fn_variant(s, "_kfvf",  true, "arr_dec", true,  "arr_dec",        "mapfkfvf");
    }
    s = s.write("__fn___fern_drop_arr_ptr:\n");
    s = s.write("    ret\n");

    return s;
}

// emit_rt_fs emits the filesystem and environment surface: the chunked reader,
// read/write_file, envp / env, temp_dir, stat, read_dir, and the
// remove_file / remove_dir_all walkers.
// emit_arm64_map_free_variant is the arm64 sibling of asm_ir's
// emit_ir_map_free_variant: `__fern_map_free<suffix>(box)` frees the KEYS buffer
// (box[0]) via __fn___fern_<kfree>, the VALUES buffer (box[8]) via
// __fn___fern_<vfree>, then returns the raw 16-byte box to the size-classed
// freelist (class 2). The six members differ only in those two symbols; `lbl` is
// the local-label stem keeping their guard jumps distinct. Stack-arg ABI (box at
// [sp]); x19 holds the box across both column calls, x9 is scratch.
// emit_arm64_arr_deep_free_variant writes one member of the array DEEP-FREE
// family (#2649) — the arm64 twin of asm_ir.emit_ir_arr_deep_free_variant. The
// four members (string[], arr-of-arr, string[][], Option[]-array) differ ONLY in
// the symbol, the local-label stem keeping their guard jumps distinct, and
// `elem`: the asm consuming the element the loop has already loaded into x0
// (with its slot index in x9).
//
// Array layout: cap@[arr-16], rc@[arr-8], len@[arr], element i @ [arr+(i+1)*8].
// Stack-arg ABI (arr at [sp]); x19/x20/x21 hold arr/len/i across the
// per-element calls and x30 is saved in the frame, so `elem` may `bl` freely.
function emit_arm64_arr_deep_free_variant(s: asmcore.EmitState, sym: string, lbl: string, elem: string): asmcore.EmitState {
    s = s.write("__fn___fern_" + sym + ":\n");
    s = s.write("    ldr x0, [sp]\n");              // arr
    s = s.write("    cbz x0, .L" + lbl + "_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .L" + lbl + "_ret\n");     // low-addr guard
    s = s.write("    ldur w1, [x0, #-8]\n");        // rc
    s = s.write(san_poison_check("w1", "w10", ".L" + lbl + "_sanlive"));
    s = s.write("    tbnz w1, #31, .L" + lbl + "_ret\n"); // negative = immortal -> skip
    s = s.write("    cmp w1, #1\n");
    s = s.write("    bgt .L" + lbl + "_dec\n");     // rc>1 -> dec, keep
    s = s.write("    blt .L" + lbl + "_uf\n");      // rc==0 -> underflow (double free)
    // rc==1: sole owner -> release every element, then the buffer.
    s = s.write("    stp x19, x30, [sp, #-16]!\n"); // save callee-saved + link
    s = s.write("    stp x20, x21, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");               // arr
    s = s.write("    ldr x20, [x19]\n");            // len @ [arr]
    s = s.write("    mov x21, #0\n");               // i
    s = s.write(".L" + lbl + "_loop:\n");
    s = s.write("    cmp x21, x20\n");
    s = s.write("    bge .L" + lbl + "_freebuf\n");
    s = s.write("    add x9, x21, #1\n");
    s = s.write(elem);
    s = s.write("    add x21, x21, #1\n");
    s = s.write("    b .L" + lbl + "_loop\n");
    s = s.write(".L" + lbl + "_freebuf:\n");
    // buffer free: __fn___fern_arr_dec's rc==1 path (base=arr-16, class=cap+3).
    s = s.write(quarantine_rc("[x19, #-8]", "w10"));  // release the rc word (defensive vs re-free)
    s = s.write("    ldur x1, [x19, #-16]\n");      // cap
    s = s.write("    add x1, x1, #3\n");            // class = cap + 3 words
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x1, x9\n");
    s = s.write("    bhs .L" + lbl + "_large\n");   // large tier -> __fern_large_push
    s = s.write("    sub x2, x19, #16\n");          // base = arr - 16
    s = lc_bump_free_words(s, "x1", "x3", "x9");
    if (!rc_free_debug_on()) {
    s = freelist_push(s, "x2", "x1", "x3", "x9");
    }
    s = s.write(".L" + lbl + "_pop:\n");
    s = s.write("    ldp x20, x21, [sp], #16\n");
    s = s.write("    ldp x19, x30, [sp], #16\n");
    s = s.write("    b .L" + lbl + "_ret\n");
    s = s.write(".L" + lbl + "_dec:\n");
    s = s.write("    sub w1, w1, #1\n");
    s = s.write("    stur w1, [x0, #-8]\n");
    s = s.write("    b .L" + lbl + "_ret\n");
    s = s.write(".L" + lbl + "_uf:\n");
    s = s.write("    adrp x2, __fern_rc_underflow\n");
    s = s.write("    add x2, x2, :lo12:__fern_rc_underflow\n");
    s = s.write("    ldr w3, [x2]\n");
    s = s.write("    add w3, w3, #1\n");
    s = s.write("    str w3, [x2]\n");
    s = s.write(san_underflow_abort());
    s = s.write(".L" + lbl + "_ret:\n");
    s = s.write("    ret\n");
    // Large tier (#3425): recycle the >=512 KiB outer buffer (base = arr-16,
    // bytes = class*8) via __fern_large_push instead of leaking. x30 is saved in
    // the frame (restored at _pop), so the bl is safe; large_push preserves
    // x19/x20/x21. Accumulates across a -per-module-emit-all batch otherwise.
    s = s.write(".L" + lbl + "_large:\n");
    s = s.write("    lsl x2, x1, #3\n");            // bytes = class*8
    s = s.write("    sub x1, x19, #16\n");          // base = arr-16
    s = s.write("    bl __fern_large_push\n");
    s = s.write("    b .L" + lbl + "_pop\n");
    return s;
}

// arm64_arr_deep_free_call is the one-element body shared by the three simple
// members: hand the element to `target` under the stack ABI and drop the slot.
function arm64_arr_deep_free_call(target: string): string {
    var e: string = "    ldr x0, [x19, x9, lsl #3]\n"; // element i @ [arr+(i+1)*8]
    e = e + "    str x0, [sp, #-16]!\n";               // push stack arg (16-aligned)
    e = e + "    bl __fn___fern_" + target + "\n";
    return e + "    add sp, sp, #16\n";
}

// arm64_optarrarr_elem is the Option[]-array element body: unwrap a SOLE-OWNED
// Some far enough to release its payload buffer, then release the Option box. A
// shared box (rc>1) skips the payload — another owner still reads it.
function arm64_optarrarr_elem(): string {
    var e: string = "    ldr x0, [x19, x9, lsl #3]\n";   // e = option box
    e = e + "    cbz x0, .Loaf_next\n";
    e = e + "    mov x9, #0x10000\n    cmp x0, x9\n    blo .Loaf_next\n";
    e = e + "    str x0, [sp, #-16]!\n    bl __fn___fern_rc_is_unique\n    add sp, sp, #16\n";
    e = e + "    cbz x0, .Loaf_box\n";
    e = e + "    add x9, x21, #1\n";
    e = e + "    ldr x0, [x19, x9, lsl #3]\n";           // reload e
    e = e + "    ldr w1, [x0]\n";                        // tag @ e+0 (0 = Some/Ok)
    e = e + "    cbnz w1, .Loaf_box\n";
    e = e + "    ldr x0, [x0, #8]\n";                    // payload buffer @ e+8
    e = e + "    str x0, [sp, #-16]!\n    bl __fn___fern_arr_dec\n    add sp, sp, #16\n";
    e = e + ".Loaf_box:\n";
    e = e + "    add x9, x21, #1\n";
    e = e + "    ldr x0, [x19, x9, lsl #3]\n";
    e = e + "    str x0, [sp, #-16]!\n    bl __fn___fern_arr_dec\n    add sp, sp, #16\n";
    return e + ".Loaf_next:\n";
}


// A map free releases ONE unit of the box (asm_ir.map_free_shared_guard): a
// shared box is decremented and left whole, and only the last unit walks the
// columns. `__fn___fern_arr_dec` does the decrement, the underflow count of a
// dead box, and the block's return to its class. x0 is the box; x10 is
// scratch, x9 keeps the low-address bound the callers still compare against.
function arm64_map_free_shared_guard(s: asmcore.EmitState, lbl: string): asmcore.EmitState {
    s = s.write("    ldur w10, [x0, #-8]\n");
    s = s.write("    cmp w10, #1\n");
    s = s.write("    b.eq .L" + lbl + "_last\n");
    s = s.write("    str x30, [sp, #-16]!\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_arr_dec\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    ldr x30, [sp], #16\n");
    s = s.write("    b .L" + lbl + "_ret\n");
    s = s.write(".L" + lbl + "_last:\n");
    return s;
}

function arm64_map_free_block(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    str x19, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_arr_dec\n");
    s = s.write("    add sp, sp, #16\n");
    return s;
}

function emit_arm64_map_free_variant(s: asmcore.EmitState, suffix: string, kfree: string, vfree: string, lbl: string): asmcore.EmitState {
    s = s.write("__fn___fern_map_free" + suffix + ":\n");
    s = s.write("    ldr x0, [sp]\n");                  // box
    s = s.write("    cbz x0, .L" + lbl + "_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .L" + lbl + "_ret\n");         // low-addr guard
    s = arm64_map_free_shared_guard(s, lbl);
    s = s.write("    stp x19, x30, [sp, #-16]!\n");     // save callee-saved + link
    s = s.write("    mov x19, x0\n");                   // box
    s = s.write("    ldr x0, [x19]\n");                 // keys = box[0]
    s = s.write("    str x0, [sp, #-16]!\n");           // push stack arg (16-aligned)
    s = s.write("    bl __fn___fern_" + kfree + "\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    ldr x0, [x19, #8]\n");             // vals = box[8]
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_" + vfree + "\n");
    s = s.write("    add sp, sp, #16\n");
    s = arm64_map_free_block(s);
    s = s.write("    mov x0, x19\n");                   // return box (caller drops)
    s = s.write("    ldp x19, x30, [sp], #16\n");
    s = s.write(".L" + lbl + "_ret:\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_map_free_fn_variant emits the members of the map free family
// whose column of boxes holds a shape only the caller knows, the arm64 sibling
// of asm_ir.emit_ir_map_free_fn_variant: `__fern_map_free<suffix>` takes the
// box, then the key's release when `krel`, then the value's when `vrel` —
// each a stack-ABI Fern function of one argument, pushed in that order in
// 16-byte slots so the last sits at [sp]. Every non-null entry of a walked
// column is handed to its release, then the columns are freed as `kfree` /
// `vfree` say (shallow for a walked column) and the box goes back to its
// freelist. x19/x20/x21/x22 hold the box, the column, the release and the
// index across the calls.
function emit_arm64_map_free_fn_variant(s: asmcore.EmitState, suffix: string, krel: boolean, kfree: string, vrel: boolean, vfree: string, lbl: string): asmcore.EmitState {
    var nargs: i32 = 1;
    if (krel) { nargs = nargs + 1; }
    if (vrel) { nargs = nargs + 1; }
    // The arguments as seen after the three save pairs below (48 bytes): the
    // box is the deepest, the value release (when passed) on top, the key
    // release (when passed) directly under it.
    var vrel_at: i32 = 48;
    var krel_at: i32 = 48;
    if (vrel) { krel_at = 64; }
    s = s.write("__fn___fern_map_free" + suffix + ":\n");
    s = s.write("    ldr x0, [sp, #" + util.i32_to_string(16 * (nargs - 1)) + "]\n");   // box
    s = s.write("    cbz x0, .L" + lbl + "_ret\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .L" + lbl + "_ret\n");         // low-addr guard
    s = arm64_map_free_shared_guard(s, lbl);
    s = s.write("    stp x19, x30, [sp, #-16]!\n");     // save callee-saved + link
    s = s.write("    stp x20, x21, [sp, #-16]!\n");
    s = s.write("    stp x22, x23, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");                   // box
    if (krel) { s = arm64_map_free_column_walk(s, 0, krel_at, lbl + "k"); }
    if (vrel) { s = arm64_map_free_column_walk(s, 8, vrel_at, lbl + "v"); }
    s = s.write("    ldr x0, [x19]\n");                 // keys = box[0]
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_" + kfree + "\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    ldr x0, [x19, #8]\n");             // vals = box[8]
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_" + vfree + "\n");
    s = s.write("    add sp, sp, #16\n");
    s = arm64_map_free_block(s);
    s = s.write("    mov x0, x19\n");                   // return box (caller drops)
    s = s.write("    ldp x22, x23, [sp], #16\n");
    s = s.write("    ldp x20, x21, [sp], #16\n");
    s = s.write("    ldp x19, x30, [sp], #16\n");
    s = s.write(".L" + lbl + "_ret:\n");
    s = s.write("    ret\n");
    return s;
}

// arm64_map_free_column_walk hands every non-null element of the column at
// `col_off` in the box (x19) to the release at [sp, rel_at]. The column
// pointer and the release ride x20 and x21, the index x22, and the element is
// pushed as the one stack argument.
function arm64_map_free_column_walk(s: asmcore.EmitState, col_off: i32, rel_at: i32, lbl: string): asmcore.EmitState {
    s = s.write("    ldr x21, [sp, #" + util.i32_to_string(rel_at) + "]\n");   // release
    s = s.write("    ldr x20, [x19, #" + util.i32_to_string(col_off) + "]\n");  // column
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x20, x9\n");
    s = s.write("    blo .L" + lbl + "_done\n");
    s = s.write("    mov x22, #0\n");                   // i = 0
    s = s.write(".L" + lbl + "_loop:\n");
    s = s.write("    ldr x9, [x20]\n");                 // len = col[0]
    s = s.write("    cmp x22, x9\n");
    s = s.write("    b.ge .L" + lbl + "_done\n");
    s = s.write("    add x10, x22, #1\n");
    s = s.write("    ldr x0, [x20, x10, lsl #3]\n");    // element = col[(i+1)*8]
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x0, x9\n");
    s = s.write("    blo .L" + lbl + "_next\n");
    s = s.write("    str x0, [sp, #-16]!\n");           // push stack arg (16-aligned)
    s = s.write("    blr x21\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write(".L" + lbl + "_next:\n");
    s = s.write("    add x22, x22, #1\n");
    s = s.write("    b .L" + lbl + "_loop\n");
    s = s.write(".L" + lbl + "_done:\n");
    return s;
}

function emit_rt_fs(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // The target key the migrated Fern helpers below are built for — same
    // derivation as emit_rt_clock_and_print's ctgt.
    var tgt: string = "arm64-linux";
    if (darwin) { tgt = "arm64-darwin"; }
    // __fern_reader_read_chunk and __fern_reader_close are Fern runtime functions
    // (#2649): asmcore.rt_src_reader_read_chunk / rt_src_reader_close, emitted
    // need-gated below. Their Option and string boxes come from ordinary lowering
    // now, so they carry the rc header at box-8 that the hand-written bare
    // __fern_alloc boxes lacked.

    // The register-ABI hand-asm __fern_io_error used to live here. Every fs
    // leaf that called it is Fern now (#2649) and calls the bundled
    // __fn___fern_io_error instead, so it had no callers left — it was emitted
    // into every arm64 binary with an fs runtime and never reached.

    // __fern_read_file and __fern_write_file used to live here; both are Fern
    // runtime functions now (#2649), emitted need-gated in the fs bundle below
    // from asmcore.rt_src_read_file / rt_src_write_file over the __syscall3 /
    // __syscall4 sub-floor. Their syscall numbers, AT_FDCWD and open flag-set
    // come from asmcore.sysno / at_fdcwd / oflag keyed by the target, so the
    // Linux and Darwin bodies are one source instead of a `darwin` fork.

    // __fern_envp: the `char **` _start stashes for env() and subprocess.
    // Emitted unconditionally because _start's save is gated on `heap`, not on
    // `env` — a heap program that never calls env() still stores here.
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_envp: .quad 0\n");
    // __fern_scratch lives in emit_rt_clock_and_print now, not here: the
    // clocks use it too and are heap-independent, so a slot gated on the fs
    // runtime left a pure-scalar timing program referencing an undefined label.
    s = s.write("    .section .text\n");
    // __fern_env itself is a Fern runtime function now (#2649):
    // asmcore.rt_src_env, emitted need-gated in the fs bundle below. It reads
    // this slot through the __raw_environ op.

    // __fern_temp_dir is a Fern runtime function now (#2649) too —
    // asmcore.rt_src_temp_dir, emitted in the fs bundle.

    // __fern_stat is a Fern runtime function now (#2649): asmcore.rt_src_stat,
    // emitted in the fs bundle. It unifies on the 4-arg fstatat family and reads
    // st_mode / st_size at asmcore.statoff offsets, so Linux and Darwin share
    // one body — no `darwin` fork, and no hand-interned FileStat shape (the
    // pre-intern below still runs; the lowering dedups to it).

    // __fern_read_dir and __fern_remove_dir_all are Fern runtime functions now
    // (#2649): asmcore.rt_src_read_dir / rt_src_remove_dir_all, emitted in the
    // fs bundle above rather than here. They were the last two entries on the
    // "shape-diverging, needs a per-target body" list, and both grounds turned
    // out to be table rows over the existing floor — Darwin's getdirentries64
    // 4th out-param is just __syscall4, and its dirent name offset is a
    // direntoff row.

    // __fern_remove_file is a Fern runtime function now (#2649) too — see the
    // note above __fern_read_file; emitted in the fs bundle, not here.

    return s;
}

// emit_rt_subprocess emits Darwin's __fn___fern_subprocess: fork / exec / wait
// with the pipe plumbing that collects the child's stdout and stderr.
//
// arm64 LINUX does not come here — it lowers asmcore.rt_src_subprocess through
// the IR like every other migrated helper (#2649). This body survives for the
// one target the floor cannot reach: XNU has no pipe2, and its pipe() reports
// the second fd in x1, which no __syscall* intrinsic can see — the same limit
// that keeps proc_fork hand-written here.
//
// It answers to the STACK ABI under the __fn___ name its Fern sibling uses, so
// the op site never learns which body it got: param[0] (cmd) is at [sp],
// param[1] (args) at [sp, #16], param[2] (stdin) at [sp, #32] on entry.
//
// The ABI-identical syscalls go through darwinize's number remap (close 57→6,
// read 63→3, write 64→4, exit 93→1, dup3 24→dup2 90, execve 221→59,
// wait4 260→7). The BSD WIFEXITED/WTERMSIG status encoding matches Linux, so
// the decode below is the same one the Fern helper does.
function emit_rt_subprocess(s: asmcore.EmitState): asmcore.EmitState {
    var prLitA: asmcore.ShapeRefOut = asmcore.shape_ref(s, "ProcessResult");
    s = prLitA.state;
    s = s.write(".globl __fn___fern_subprocess\n");
    s = s.write(".type __fn___fern_subprocess, %function\n");
    s = s.write("__fn___fern_subprocess:\n");
    // Read the three stack-ABI params before the frame moves sp.
    s = s.write("    ldr x0, [sp]\n");
    s = s.write("    ldr x1, [sp, #16]\n");
    s = s.write("    ldr x2, [sp, #32]\n");
    // Big frame: x29/x30 + 5 callee-saved pairs (x19..x28) + 128
    // bytes of locals = 224 bytes. Layout (from sp = x29):
    //   [sp+ 0]  saved x29
    //   [sp+ 8]  saved x30
    //   [sp+16]  saved x19  (cmd box)
    //   [sp+24]  saved x20  (args box)
    //   [sp+32]  saved x21  (stdin box)
    //   [sp+40]  saved x22  (scratch / child pid)
    //   [sp+48]  saved x23  (cmdz)
    //   [sp+56]  saved x24  (argv)
    //   [sp+64]  saved x25  (stdout buf)
    //   [sp+72]  saved x26  (stdout len)
    //   [sp+80]  saved x27  (stderr buf)
    //   [sp+88]  saved x28  (stderr len)
    //   [sp+96..119]  6 pipe fds (4 bytes each)
    //   [sp+120..123] wait4 status (4 bytes)
    //   [sp+124..223] scratch / padding
    s = s.write("    sub sp, sp, #224\n");
    s = s.write("    stp x29, x30, [sp, #0]\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x19, x20, [sp, #16]\n");
    s = s.write("    stp x21, x22, [sp, #32]\n");
    s = s.write("    stp x23, x24, [sp, #48]\n");
    s = s.write("    stp x25, x26, [sp, #64]\n");
    s = s.write("    stp x27, x28, [sp, #80]\n");
    // Save input boxes into callee-saved regs.
    s = s.write("    mov x19, x0\n");    // cmd box
    s = s.write("    mov x20, x1\n");    // args box
    s = s.write("    mov x21, x2\n");    // stdin box
    // Build cmdz: NUL-terminated cmd string. cmd_len + 1 bytes.
    s = s.write("    ldr x22, [x19, #8]\n");   // cmd_len
    s = s.write("    add x0, x22, #1\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x23, x0\n");          // cmdz
    s = s.write("    ldr x9, [x19]\n");        // cmd data
    s = s.write("    mov x10, #0\n");
    s = s.write(".Lsp_ccmd:\n");
    s = s.write("    cmp x10, x22\n");
    s = s.write("    b.ge .Lsp_ccmd_d\n");
    s = s.write("    ldrb w11, [x9, x10]\n");
    s = s.write("    strb w11, [x23, x10]\n");
    s = s.write("    add x10, x10, #1\n");
    s = s.write("    b .Lsp_ccmd\n");
    s = s.write(".Lsp_ccmd_d:\n");
    s = s.write("    mov w11, #0\n");
    s = s.write("    strb w11, [x23, x22]\n");
    // Build argv: (nargs + 2) * 8 bytes ptr slots.
    s = s.write("    ldr x22, [x20]\n");       // nargs
    s = s.write("    add x0, x22, #2\n");
    s = s.write("    lsl x0, x0, #3\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x24, x0\n");          // argv
    // argv[0] = cmdz
    s = s.write("    str x23, [x24]\n");
    // argv[i+1] = NUL-terminated copy of args[i] for i in 0..nargs.
    s = s.write("    mov x25, #0\n");          // i (reuses x25 — restored later if needed; safe before stdout buf)
    s = s.write(".Lsp_arg:\n");
    s = s.write("    cmp x25, x22\n");
    s = s.write("    b.ge .Lsp_arg_d\n");
    s = s.write("    add x9, x25, #1\n");
    s = s.write("    ldr x10, [x20, x9, lsl #3]\n");   // args[i] box
    s = s.write("    ldr x26, [x10, #8]\n");           // arg_len
    s = s.write("    add x0, x26, #1\n");
    s = s.write("    str x10, [sp, #128]\n");          // spill arg box
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    ldr x10, [sp, #128]\n");          // reload arg box
    s = s.write("    ldr x9, [x10]\n");                // arg data
    s = s.write("    mov x11, #0\n");
    s = s.write(".Lsp_acopy:\n");
    s = s.write("    cmp x11, x26\n");
    s = s.write("    b.ge .Lsp_acopy_d\n");
    s = s.write("    ldrb w12, [x9, x11]\n");
    s = s.write("    strb w12, [x0, x11]\n");
    s = s.write("    add x11, x11, #1\n");
    s = s.write("    b .Lsp_acopy\n");
    s = s.write(".Lsp_acopy_d:\n");
    s = s.write("    mov w12, #0\n");
    s = s.write("    strb w12, [x0, x26]\n");
    s = s.write("    add x9, x25, #1\n");
    s = s.write("    str x0, [x24, x9, lsl #3]\n");
    s = s.write("    add x25, x25, #1\n");
    s = s.write("    b .Lsp_arg\n");
    s = s.write(".Lsp_arg_d:\n");
    // argv[nargs + 1] = NULL.
    s = s.write("    add x9, x22, #1\n");
    s = s.write("    mov x10, #0\n");
    s = s.write("    str x10, [x24, x9, lsl #3]\n");
    // Create 3 pipes. pipe() (sysno 42) returns the read fd in x0 and
    // the write fd in x1 — the reason this body is not the Fern one —
    // stored into the [read@+0, write@+4] slots the rest reads.
    s = s.write("    mov x16, #42\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    str w0, [sp, #96]\n");    // in_r
    s = s.write("    str w1, [sp, #100]\n");   // in_w
    s = s.write("    mov x16, #42\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    str w0, [sp, #104]\n");   // out_r
    s = s.write("    str w1, [sp, #108]\n");   // out_w
    s = s.write("    mov x16, #42\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    str w0, [sp, #112]\n");   // err_r
    s = s.write("    str w1, [sp, #116]\n");   // err_w
    // fork (sysno 2) returns the pid in x0 with x1=0 in the parent and
    // x1=1 in the child; normalise to x0=0-in-the-child so the dispatch
    // below is the ordinary one. That x1 is the other half of why this
    // target keeps a hand-written body.
    s = s.write("    mov x16, #2\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    cbz x1, .Lsp_forked\n");  // x1==0 → parent, keep pid
    s = s.write("    mov x0, #0\n");           // x1==1 → child
    s = s.write(".Lsp_forked:\n");
    s = s.write("    cbnz x0, .Lsp_parent\n");
    // ---------- CHILD ----------
    // dup3(in_r, 0, 0); dup3(out_w, 1, 0); dup3(err_w, 2, 0).
    s = s.write("    ldr w0, [sp, #96]\n");    // in_r
    s = s.write("    mov x1, #0\n");
    s = s.write("    mov x2, #0\n");
    s = s.write("    mov x8, #24\n");
    s = s.write("    svc #0\n");
    s = s.write("    ldr w0, [sp, #108]\n");   // out_w
    s = s.write("    mov x1, #1\n");
    s = s.write("    mov x2, #0\n");
    s = s.write("    mov x8, #24\n");
    s = s.write("    svc #0\n");
    s = s.write("    ldr w0, [sp, #116]\n");   // err_w
    s = s.write("    mov x1, #2\n");
    s = s.write("    mov x2, #0\n");
    s = s.write("    mov x8, #24\n");
    s = s.write("    svc #0\n");
    // Close all 6 original pipe fds.
    s = s.write("    ldr w0, [sp, #96]\n  mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #100]\n  mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #104]\n  mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #108]\n  mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #112]\n  mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #116]\n  mov x8, #57\n  svc #0\n");
    // execve(cmdz, argv, envp). envp is the value of __fern_envp.
    s = s.write("    mov x0, x23\n");                         // cmdz
    s = s.write("    mov x1, x24\n");                         // argv
    s = s.write("    adrp x9, __fern_envp\n");
    s = s.write("    add x9, x9, :lo12:__fern_envp\n");
    s = s.write("    ldr x2, [x9]\n");                        // envp
    s = s.write("    mov x8, #221\n");
    s = s.write("    svc #0\n");
    // execve only returns on failure. Fall back to /bin/<cmd> and
    // /usr/bin/<cmd> so bare names like "echo" / "sh" / "cat"
    // resolve without re-implementing $PATH search.
    // Compute cmd_len (cmdz length).
    s = s.write("    mov x22, #0\n");                         // cmd_len
    s = s.write(".Lsp_clen:\n");
    s = s.write("    ldrb w9, [x23, x22]\n");
    s = s.write("    cbz w9, .Lsp_clen_d\n");
    s = s.write("    add x22, x22, #1\n");
    s = s.write("    b .Lsp_clen\n");
    s = s.write(".Lsp_clen_d:\n");
    // Try /bin/<cmd> (5 + cmd_len + 1).
    s = s.write("    add x0, x22, #6\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x25, x0\n");                         // path buf
    s = s.write("    mov w9, #47\n  strb w9, [x25]\n");       // '/'
    s = s.write("    mov w9, #98\n  strb w9, [x25, #1]\n");   // 'b'
    s = s.write("    mov w9, #105\n strb w9, [x25, #2]\n");   // 'i'
    s = s.write("    mov w9, #110\n strb w9, [x25, #3]\n");   // 'n'
    s = s.write("    mov w9, #47\n  strb w9, [x25, #4]\n");   // '/'
    s = s.write("    mov x10, #0\n");
    s = s.write(".Lsp_bcopy:\n");
    s = s.write("    cmp x10, x22\n");
    s = s.write("    b.ge .Lsp_bcopy_d\n");
    s = s.write("    ldrb w11, [x23, x10]\n");
    s = s.write("    add x9, x10, #5\n");
    s = s.write("    strb w11, [x25, x9]\n");
    s = s.write("    add x10, x10, #1\n");
    s = s.write("    b .Lsp_bcopy\n");
    s = s.write(".Lsp_bcopy_d:\n");
    s = s.write("    add x9, x22, #5\n");
    s = s.write("    mov w11, #0\n");
    s = s.write("    strb w11, [x25, x9]\n");                 // NUL
    s = s.write("    mov x0, x25\n");
    s = s.write("    mov x1, x24\n");
    s = s.write("    adrp x9, __fern_envp\n");
    s = s.write("    add x9, x9, :lo12:__fern_envp\n");
    s = s.write("    ldr x2, [x9]\n");
    s = s.write("    mov x8, #221\n");
    s = s.write("    svc #0\n");
    // Try /usr/bin/<cmd> (9 + cmd_len + 1).
    s = s.write("    add x0, x22, #10\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x25, x0\n");
    s = s.write("    mov w9, #47\n  strb w9, [x25]\n");
    s = s.write("    mov w9, #117\n strb w9, [x25, #1]\n");   // 'u'
    s = s.write("    mov w9, #115\n strb w9, [x25, #2]\n");   // 's'
    s = s.write("    mov w9, #114\n strb w9, [x25, #3]\n");   // 'r'
    s = s.write("    mov w9, #47\n  strb w9, [x25, #4]\n");
    s = s.write("    mov w9, #98\n  strb w9, [x25, #5]\n");
    s = s.write("    mov w9, #105\n strb w9, [x25, #6]\n");
    s = s.write("    mov w9, #110\n strb w9, [x25, #7]\n");
    s = s.write("    mov w9, #47\n  strb w9, [x25, #8]\n");
    s = s.write("    mov x10, #0\n");
    s = s.write(".Lsp_ucopy:\n");
    s = s.write("    cmp x10, x22\n");
    s = s.write("    b.ge .Lsp_ucopy_d\n");
    s = s.write("    ldrb w11, [x23, x10]\n");
    s = s.write("    add x9, x10, #9\n");
    s = s.write("    strb w11, [x25, x9]\n");
    s = s.write("    add x10, x10, #1\n");
    s = s.write("    b .Lsp_ucopy\n");
    s = s.write(".Lsp_ucopy_d:\n");
    s = s.write("    add x9, x22, #9\n");
    s = s.write("    mov w11, #0\n");
    s = s.write("    strb w11, [x25, x9]\n");
    s = s.write("    mov x0, x25\n");
    s = s.write("    mov x1, x24\n");
    s = s.write("    adrp x9, __fern_envp\n");
    s = s.write("    add x9, x9, :lo12:__fern_envp\n");
    s = s.write("    ldr x2, [x9]\n");
    s = s.write("    mov x8, #221\n");
    s = s.write("    svc #0\n");
    // All execve attempts failed → exit(127).
    s = s.write("    mov x0, #127\n");
    s = s.write("    mov x8, #93\n");
    s = s.write("    svc #0\n");
    // ---------- PARENT ----------
    s = s.write(".Lsp_parent:\n");
    s = s.write("    mov x22, x0\n");                         // child pid
    // Close child ends: in_r, out_w, err_w.
    s = s.write("    ldr w0, [sp, #96]\n   mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #108]\n  mov x8, #57\n  svc #0\n");
    s = s.write("    ldr w0, [sp, #116]\n  mov x8, #57\n  svc #0\n");
    // Write stdin payload (if any) to in_w, then close in_w.
    s = s.write("    ldr x2, [x21, #8]\n");                   // stdin len
    s = s.write("    cbz x2, .Lsp_close_in\n");
    s = s.write("    ldr w0, [sp, #100]\n");                  // in_w
    s = s.write("    ldr x1, [x21]\n");                       // stdin data
    s = s.write("    mov x8, #64\n");                         // write
    s = s.write("    svc #0\n");
    s = s.write(".Lsp_close_in:\n");
    s = s.write("    ldr w0, [sp, #100]\n  mov x8, #57\n  svc #0\n");
    // Read stdout to EOF into 64 KiB buf. x25 = buf, x26 = total.
    s = s.write("    mov x0, #65536\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x25, x0\n");
    s = s.write("    mov x26, #0\n");
    s = s.write(".Lsp_rdo:\n");
    s = s.write("    mov x2, #65536\n");
    s = s.write("    sub x2, x2, x26\n");
    s = s.write("    cmp x2, #0\n");
    s = s.write("    b.le .Lsp_rdo_d\n");
    s = s.write("    ldr w0, [sp, #104]\n");                  // out_r
    s = s.write("    add x1, x25, x26\n");
    s = s.write("    mov x8, #63\n");                         // read
    s = s.write("    svc #0\n");
    s = s.write("    cmp x0, #0\n");
    s = s.write("    b.le .Lsp_rdo_d\n");
    s = s.write("    add x26, x26, x0\n");
    s = s.write("    b .Lsp_rdo\n");
    s = s.write(".Lsp_rdo_d:\n");
    s = s.write("    ldr w0, [sp, #104]\n  mov x8, #57\n  svc #0\n");
    // Read stderr similarly. x27 = buf, x28 = total.
    s = s.write("    mov x0, #65536\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x27, x0\n");
    s = s.write("    mov x28, #0\n");
    s = s.write(".Lsp_rde:\n");
    s = s.write("    mov x2, #65536\n");
    s = s.write("    sub x2, x2, x28\n");
    s = s.write("    cmp x2, #0\n");
    s = s.write("    b.le .Lsp_rde_d\n");
    s = s.write("    ldr w0, [sp, #112]\n");                  // err_r
    s = s.write("    add x1, x27, x28\n");
    s = s.write("    mov x8, #63\n");
    s = s.write("    svc #0\n");
    s = s.write("    cmp x0, #0\n");
    s = s.write("    b.le .Lsp_rde_d\n");
    s = s.write("    add x28, x28, x0\n");
    s = s.write("    b .Lsp_rde\n");
    s = s.write(".Lsp_rde_d:\n");
    s = s.write("    ldr w0, [sp, #112]\n  mov x8, #57\n  svc #0\n");
    // wait4(pid, &status, 0, NULL).
    s = s.write("    mov x0, x22\n");
    s = s.write("    add x1, sp, #120\n");
    s = s.write("    mov x2, #0\n");
    s = s.write("    mov x3, #0\n");
    s = s.write("    mov x8, #260\n");
    s = s.write("    svc #0\n");
    // Decode exit status.
    s = s.write("    ldr w9, [sp, #120]\n");
    s = s.write("    and w10, w9, #127\n");                  // sig
    s = s.write("    cbnz w10, .Lsp_signaled\n");
    s = s.write("    lsr w9, w9, #8\n");
    s = s.write("    and w9, w9, #255\n");
    s = s.write("    b .Lsp_have_exit\n");
    s = s.write(".Lsp_signaled:\n");
    s = s.write("    and w9, w9, #127\n");
    s = s.write("    add w9, w9, #128\n");
    s = s.write(".Lsp_have_exit:\n");
    s = s.write("    mov x22, x9\n");                         // exit_code (full reg, x22)
    // Build the two stream strings and the result struct through the
    // rc-headered constructors — __fern_str_box for a string, __fern_arr_box
    // with cap = nf+1 for a struct, exactly what struct_make emits. Both used to
    // be a bare __fern_alloc'd block with no refcount at box-8, so a dec of one
    // read the last word of the preceding allocation (#6921). Both clobber only
    // x0..x3, so the callee-saved holders below stay live across them.
    s = s.write("    mov x0, x25\n");                         // stdout data
    s = s.write("    mov x1, x26\n");                         // stdout len
    s = s.write("    bl __fern_str_box\n");
    s = s.write("    mov x25, x0\n");                         // stdout box
    s = s.write("    mov x0, x27\n");                         // stderr data
    s = s.write("    mov x1, x28\n");                         // stderr len
    s = s.write("    bl __fern_str_box\n");
    s = s.write("    mov x27, x0\n");                         // stderr box
    // ProcessResult: [shape, stdout, stderr, exit_code] — 3 fields, cap 4.
    s = s.write("    mov x0, #4\n");
    s = s.write("    bl __fern_arr_box\n");
    s = s.write("    adrp x9, " + prLitA.label + "\n");
    s = s.write("    add x9, x9, :lo12:" + prLitA.label + "\n");
    s = s.write("    str x9, [x0]\n");
    s = s.write("    str x25, [x0, #8]\n");
    s = s.write("    str x27, [x0, #16]\n");
    s = s.write("    str x22, [x0, #24]\n");
    // Epilogue.
    s = s.write("    ldp x27, x28, [sp, #80]\n");
    s = s.write("    ldp x25, x26, [sp, #64]\n");
    s = s.write("    ldp x23, x24, [sp, #48]\n");
    s = s.write("    ldp x21, x22, [sp, #32]\n");
    s = s.write("    ldp x19, x20, [sp, #16]\n");
    s = s.write("    ldp x29, x30, [sp, #0]\n");
    s = s.write("    add sp, sp, #224\n");
    s = s.write("    ret\n");
    s = s.write(".size __fn___fern_subprocess, .-__fn___fern_subprocess\n");

    // ---- TCP sockets ------------------------------------------------
    // The raw primitives std/tcp.fern's tcp_serve() composes into the
    // HTTP edge-handler loop. Linux aarch64 syscalls: socket=198,
    // bind=200, listen=201, accept=202, read=63, write=64, close=57.
    // Darwin remaps the numbers via darwin_sysno (97/104/106/30 +
    // 3/4/6) and the sockaddr_in gets a leading sin_len byte; both are
    // handled below. C-style API: callers test `if (fd < 0)`.

    // __fern_tcp_listen(x0 = port) → listener fd or -errno.
    // socket(AF_INET, SOCK_STREAM, 0); bind to 0.0.0.0:port; listen(128).
    s = s.write(".globl __fern_tcp_listen\n");
    s = s.write(".type __fern_tcp_listen, %function\n");
    return s;
}

// emit_rt_net emits the socket primitives (tcp listen / accept / recv / send /
// close / connect / pollable, udp_send) plus __fern_alloc_u8.
function emit_rt_net(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // tcp_listen is Fern now (#2649) — see the migrated-helpers section.

    // tcp_recv is Fern now (#2649) — see the migrated-helpers section.

    // tcp_send is Fern now (#2649) — see the migrated-helpers section.


    // tcp_connect is Fern now (#2649) — see the migrated-helpers section. Its
    // Darwin number comes from asmcore.sysno rather than darwin_sysno, which
    // has no row for connect (203) and so left the Mach-O emit issuing a Linux
    // syscall through the Linux trap.

    // __fern_tcp_pollable(x0 = fd) → fd: a socket's readiness token IS its
    // fd on native (ppoll takes fds directly), so identity.
    s = s.write(".globl __fern_tcp_pollable\n");
    s = s.write(".type __fern_tcp_pollable, %function\n");
    s = s.write("__fern_tcp_pollable:\n");
    s = s.write("    ret\n");                    // fd already in x0
    s = s.write(".size __fern_tcp_pollable, .-__fern_tcp_pollable\n");

    // __fern_udp_send is a Fern runtime function (#2649, #6917):
    // asmcore.rt_src_udp_send, emitted need-gated with the other net helpers. The
    // hand-written body that used to sit here was emitted but never called — the
    // op had no kind_tag case on either backend.

    // __fern_alloc_u8(x0 = n) → fresh n-element array (cap header,
    // 8-byte slots, returned base+8), its slots cleared: a block off the
    // free list keeps its last owner's bytes.
    s = s.write(".globl __fern_alloc_u8\n");
    s = s.write(".type __fern_alloc_u8, %function\n");
    s = s.write("__fern_alloc_u8:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");           // n
    s = s.write("    mov x0, x19\n");           // cap = n
    s = s.write("    bl __fern_arr_box\n");      // -> data ptr in x0 (cap + len written)
    s = s.write("    add x2, x0, #8\n");        // slot 0; the length is at [x0]
    s = s.write("    mov w1, w19\n");           // n is an i32
    s = s.write(".Lfern_alloc_u8_zero:\n");
    s = s.write("    cbz x1, .Lfern_alloc_u8_done\n");
    s = s.write("    str xzr, [x2], #8\n");
    s = s.write("    sub x1, x1, #1\n");
    s = s.write("    b .Lfern_alloc_u8_zero\n");
    s = s.write(".Lfern_alloc_u8_done:\n");
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_alloc_u8, .-__fern_alloc_u8\n");

    // __fern_string_from_bytes and __fern_random_bytes used to live here; both
    // are Fern runtime functions now (#2649), emitted need-gated in the
    // migrated-helpers section from asmcore.rt_src_string_from_bytes /
    // rt_src_random_bytes. random_bytes is no longer forked on `darwin` either:
    // the shared source is generated with the target's entropy syscall number
    // (getrandom 278 / getentropy 500) and fills the buffer in <= 256-byte
    // chunks, which is what getentropy's per-call limit needed the fork for.

    // __fern_i32_gcd / __fern_i32_lcm are now Fern runtime functions (#2649):
    // see asmcore.rt_src_i32_gcd / _lcm, emitted (need-gated) in the migrated-
    // helpers section below. Pure scalar, so no longer in this heap block.
    return s;
}

function emit_rt_heap(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    if (s.has_need("heap")) {
        var fsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FileStat");
        s = fsPre.state;
        var prPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "ProcessResult");
        s = prPre.state;
        if (s.has_need("statfs")) {
            var fvPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FsStat");
            s = fvPre.state;
        }
        // WinSize for __fern_window_size's shape label, gated the way FsStat is.
        if (s.has_need("window_size")) {
            var wsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "WinSize");
            s = wsPre.state;
        }
    }
    // .rodata: emit each interned string literal as a
    // labelled `.ascii` directive. GAS interprets the escape
    // sequences in the quoted string, so a `\n` byte in the
    // source string lands as a single LF in the resulting
    // .rodata bytes.
    s = emit_rodata_pools_arm64(s, darwin);
    // Heap allocator (arm64): 1 MiB .bss buffer + bump pointer.
    // Same shape as the x86-64 backend; instructions translated
    // to aarch64. Sets x0 = old ptr (return), advances the
    // ptr by x0 (the size arg).
    //
    // "heap" gates the whole native runtime block, not just the allocator: the
    // fs / subprocess / socket helpers below all reach __fern_alloc, so they
    // cannot be emitted without it and there is no separate need to key them
    // on. That means every op site calling one of them must mark "heap" — the
    // socket sites did not, on a comment claiming their bodies were emitted
    // unconditionally, so a program that used a socket and allocated nothing
    // else emitted `bl __fern_tcp_listen` with no definition and the in-process
    // assembler refused the module (#6164). The x86-64 emitter gates each
    // helper on its own need instead, which is why it never had the hole.
    if (s.has_need("heap")) {
        s = emit_rt_arena_and_alloc(s, darwin);
        s = emit_rt_large_tier_and_rc(s);
        s = emit_rt_fs(s, darwin);
        // subprocess (#2649) is Fern on arm64 Linux and hand-written on Darwin
        // (see emit_rt_subprocess). Need-gated on BOTH legs: the hand-asm used to
        // be gated on the bare `heap` gate, so every allocating program carried ~400
        // instructions nothing branched to — the same unconditional emission the
        // Reader bodies had (#6921).
        if (s.has_need("subprocess")) {
            if (darwin) {
                s = emit_rt_subprocess(s);
            } else {
                s = emit_ir_runtime_fern_fn(asmcore.rt_src_subprocess("arm64-linux"), s.struct_decls, s);
            }
        }
        s = emit_rt_net(s, darwin);
    }
    // Census report (#5362): OUTSIDE the heap gate — the exit op calls
    // __fern_lc_report in every program under FERN_LEAKCHECK, and a heap-free
    // program must still link. Emits nothing when the flag is off.
    s = emit_lc_report(s);
    // The UAF quarantine's fatal report. Self-contained — its own write(2) +
    // exit(124) rather than the census writer — so FERN_RC_FREE_DEBUG works
    // standalone, without leakcheck. Entry-only, like the census above, and
    // silent when the flag is off so an ordinary build's asm is unchanged.
    s = emit_san_uaf_abort(s);
    s = emit_san_abort(s);
    // Map runtime (string-keyed, 8-byte values). Mirror of asm.fern's
    // x86-64 runtime. A Map is a 16-byte box [keys: string[] @0,
    // values: T[] @8]; linear scan + str_eq; set/get grow via
    // __fern_arr_push. Gated on (arr_push && str_eq), both marked at
    // every map op.
    return s;
}

// emit_rt_collections_and_proc emits the array runtime (push / slice / concat / reverse / join /
// the fold helpers), the map helpers, the integer-math helpers, the remaining
// string builtins, argv, random, and the subprocess primitives.
function emit_rt_collections_and_proc(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // The map runtime, gated on the need its op sites mark — as x86-64 gates it.
    // arm64 marked `maps` at every one of those sites and then never read it,
    // keying the bundle on `arr_push && str_eq` instead. Those are `maps`'s own
    // declared dependencies (runtime_need_deps), so the proxy could never
    // under-emit — but it over-emits: any program that appends to an array and
    // compares two strings carried the whole seven-helper bundle with no map
    // anywhere in it.
    if (s.has_need("maps")) {
        // __fern_map_new(x0 = capacity hint, ignored) → empty map box.
        s = s.write(".globl __fern_map_new\n");
        s = s.write(".type __fern_map_new, %function\n");
        s = s.write("__fern_map_new:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x0, #2\n");
        s = s.write("    bl __fern_arr_box\n");        // mapbox: a counted two-word box
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    bl __fern_alloc_u8\n");        // empty keys
        s = s.write("    str x0, [x19]\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    bl __fern_alloc_u8\n");        // empty values
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_new, .-__fern_map_new\n");

        // __fern_map_snapshot_col(x0 = column buffer) → x0 = fresh rc=1 copy.
        // #4353 scalar keys()/values() snapshot (the arm64 mirror of asm_ir's
        // x86-64 helper): allocates a fresh __fern_arr_box of the column's
        // length (cap = len, rc = 1), copies the len elements (slots 1..len),
        // and returns the copy. The IR path's kinds 131/132 call it for a
        // scalar (i32) column so the read result is an OWNED array: the exit
        // sweep's arr_dec reclaims the copy, and map_set's owned grow can free
        // the superseded live buffer without dangling the read. Elements are
        // copied bit-for-bit and NOT rc-inc'd — scalar columns only; the
        // string-column snapshot (element inc + deep free) is slice 3.
        s = s.write(".globl __fern_map_snapshot_col\n");
        s = s.write(".type __fern_map_snapshot_col, %function\n");
        s = s.write("__fern_map_snapshot_col:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");             // src column
        s = s.write("    ldr x20, [x19]\n");          // len
        s = s.write("    mov x0, x20\n");
        s = s.write("    bl __fern_arr_box\n");       // -> data ptr (cap=len, rc=1, len=cap)
        s = s.write("    str x20, [x0]\n");           // len = src len (cap == len already)
        s = s.write("    mov x9, #1\n");              // slot index 1..len
        s = s.write(".Lmsc_copy:\n");
        s = s.write("    cmp x9, x20\n");
        s = s.write("    b.gt .Lmsc_done\n");
        s = s.write("    ldr x10, [x19, x9, lsl #3]\n");
        s = s.write("    str x10, [x0, x9, lsl #3]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lmsc_copy\n");
        s = s.write(".Lmsc_done:\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_snapshot_col, .-__fern_map_snapshot_col\n");

        // __fern_map_snapshot_col_str(x0 = column buffer) → x0 = fresh rc=1
        // copy with each STRING element retained (#4353 slice 3 — the arm64
        // mirror of asm_ir's x86-64 helper). After the bit copy each element
        // is __fn___fern_rc_inc'd (its guards skip NULL / SSO-tagged /
        // low-address / static-literal values), so the snapshot co-owns
        // every string and the deep __fern_str_arr_free release (rc-aware
        // per-element __fern_str_free, then the buffer) balances exactly.
        s = s.write(".globl __fern_map_snapshot_col_str\n");
        s = s.write(".type __fern_map_snapshot_col_str, %function\n");
        s = s.write("__fern_map_snapshot_col_str:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");             // src column
        s = s.write("    ldr x20, [x19]\n");          // len
        s = s.write("    mov x0, x20\n");
        s = s.write("    bl __fern_arr_box\n");       // -> data ptr (cap=len, rc=1)
        s = s.write("    str x20, [x0]\n");           // len = src len
        s = s.write("    mov x21, x0\n");             // dest (callee-saved across incs)
        s = s.write("    mov x22, #1\n");             // slot index 1..len
        s = s.write(".Lmscs_copy:\n");
        s = s.write("    cmp x22, x20\n");
        s = s.write("    b.gt .Lmscs_done\n");
        s = s.write("    ldr x10, [x19, x22, lsl #3]\n");
        s = s.write("    str x10, [x21, x22, lsl #3]\n");
        s = s.write("    str x10, [sp, #-16]!\n");    // stack arg for __fn___fern_rc_inc
        s = s.write("    bl __fn___fern_rc_inc\n");   // retain element (guards skip literals/SSO/null)
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lmscs_copy\n");
        s = s.write(".Lmscs_done:\n");
        s = s.write("    mov x0, x21\n");             // return dest
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_snapshot_col_str, .-__fern_map_snapshot_col_str\n");

        // __fern_map_set(x0 = mapbox, x1 = key, x2 = val, x3 = keykind,
        // x4 = flags, x5 = derived K.eq or 0, x6 = the value release of a
        // column of boxes or 0, x7 = the key release of a keyed column or 0)
        // → mapbox.
        // Updates in place on a key hit, else appends.
        s = s.write(".globl __fern_map_set\n");
        s = s.write(".type __fern_map_set, %function\n");
        s = s.write("__fern_map_set:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    stp x25, x26, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // mapbox
        s = s.write("    mov x20, x1\n");           // key
        s = s.write("    mov x21, x2\n");           // val
        s = s.write("    mov x25, x6\n");           // value release (vkind 3), callee-saved across the probe
        s = s.write("    mov x26, x7\n");           // key release (keykind 2), likewise
        s = s.write("    mov x22, x3\n");           // key kind, likewise
        // x24 = per-insert flag bits (bit 0 = kconsume: the incoming KEY is a
        // fresh sole-owned string temp, from irlower o.width bit 1; bit 1 =
        // owncols: i32/string-column map whose keys()/values() reads ALL
        // snapshot, so the map solely owns its column buffers — #4353/#5335).
        // x24 is
        // callee-saved (already stp'd) and otherwise unused here, so it survives
        // the __fern_map_find call without extra saves; bit 0 is
        // tested at .Lms_found to free the DISCARDED new key on an overwrite
        // (the arm64 twin of the x86-IR #4881 fix — a recurring computed key,
        // e.g. word-count `m.set(word, n)`, otherwise leaks one key box each);
        // bit 1 is tested at .Lms_append to pick the reclaim-on-grow
        // __fern_arr_push_owned over the leak-only __fern_arr_push.
        s = s.write("    mov x24, x4\n");           // flag bits
        // The key search is __fern_map_find's (#2649) — the one body the whole
        // map runtime shares, in place of the string / i32 / struct triple this
        // function, map_get and map_has each carried. Stack ABI: args pushed in
        // REVERSE so arg0 (the keys array) lands on top, in 16-byte slots, all
        // four dropped after. A miss answers -1, which is this function's
        // append. The derived @derive(Eq) call the struct arm makes compares
        // keys BY VALUE, so a freshly built key whose string field lives in
        // another buffer still hits (#6081).
        s = s.write("    str x5, [sp, #-16]!\n");    // arg3 = derived K.eq, or 0
        s = s.write("    str x3, [sp, #-16]!\n");    // arg2 = keykind
        s = s.write("    str x1, [sp, #-16]!\n");    // arg1 = key
        s = s.write("    ldr x9, [x19]\n");          // arg0 = keys arr
        s = s.write("    str x9, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_map_find\n");
        s = s.write("    add sp, sp, #64\n");
        s = s.write("    mov x23, x0\n");            // i, or -1 on a miss
        s = s.write("    cmp x23, #0\n");
        s = s.write("    b.lt .Lms_append\n");
        s = s.write(".Lms_found:\n");
        // An overwrite REPLACES the value pointer, and the reclaim helper only
        // ever reaches entries still in the column, so a superseded value is
        // freed here or never (#9300). x24 bits 2/3 name the column's release:
        // the map owns one unit per live entry, so releasing what it drops is
        // exactly balanced. Both helpers are rc-aware and null-safe, and the
        // slot address is recomputed after the call rather than held across it
        // — x19 / x23 / x21 are callee-saved, so its three inputs survive.
        // vkind 0, which is what the AST path passes, skips the block.
        // Gated on the need for the reason the x86-IR twin gives: the
        // `bl __fn___fern_str_arr_free` text trips the negative asm-grep
        // contracts in every unrelated program.
        if (s.has_need("map_vfree")) {
        s = s.write("    tst x24, #12\n");           // bits 2|3 = vkind
        s = s.write("    b.eq .Lms_found_novf\n");
        s = s.write("    ldr x9, [x19, #8]\n");      // values arr
        s = s.write("    add x10, x23, #1\n");
        s = s.write("    ldr x9, [x9, x10, lsl #3]\n");  // superseded value
        s = s.write("    str x9, [sp, #-16]!\n");
        s = s.write("    tbz x24, #3, .Lms_found_vs\n");    // vkind 1: a string
        s = s.write("    tbz x24, #2, .Lms_found_vsa\n");   // vkind 2: a string array
        s = s.write("    blr x25\n");                       // vkind 3: the named release
        s = s.write("    b .Lms_found_vfdone\n");
        s = s.write(".Lms_found_vs:\n");
        s = s.write("    bl __fn___fern_str_free\n");
        s = s.write("    b .Lms_found_vfdone\n");
        s = s.write(".Lms_found_vsa:\n");
        s = s.write("    bl __fn___fern_str_arr_free\n");
        s = s.write(".Lms_found_vfdone:\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write(".Lms_found_novf:\n");
        }
        s = s.write("    ldr x9, [x19, #8]\n");      // values arr
        s = s.write("    add x10, x23, #1\n");
        s = s.write("    str x21, [x9, x10, lsl #3]\n");  // values[i+1] = val
        // Overwrite keeps the EXISTING key; the incoming key x20 is discarded. When
        // it is a fresh sole-owned temp (kconsume), free it — a string key via the
        // rc-aware __fern_str_free (a literal's .rodata data / an rc>1 aliased key
        // are handled by str_free's guards), a keyed column's box via the key
        // release in x26, or the shallow dec when the op site passed none. Every
        // release here preserves x19/x20 (callee-saved), so the mapbox return is
        // intact. An aliased key (kconsume 0) is left untouched — its source
        // local's sweep owns it.
        s = s.write("    tbz x24, #0, .Lms_found_nokf\n");   // bit 0 = kconsume
        s = s.write("    str x20, [sp, #-16]!\n");   // discarded fresh key (16-byte aligned push)
        s = s.write("    cmp x22, #2\n");            // keyed column?
        s = s.write("    b.ne .Lms_found_kstr\n");
        s = s.write("    cbz x26, .Lms_found_kbox\n");
        s = s.write("    blr x26\n");
        s = s.write("    b .Lms_found_kfdone\n");
        s = s.write(".Lms_found_kbox:\n");
        s = s.write("    bl __fn___fern_arr_dec\n");
        s = s.write("    b .Lms_found_kfdone\n");
        s = s.write(".Lms_found_kstr:\n");
        s = s.write("    bl __fn___fern_str_free\n");
        s = s.write(".Lms_found_kfdone:\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write(".Lms_found_nokf:\n");
        s = s.write("    b .Lms_ret\n");
        s = s.write(".Lms_append:\n");
        // owncols (x24 bit 1, #4353/#5335): a map whose columns ALL snapshot on
        // read (i32 → __fern_map_snapshot_col, string →
        // __fern_map_snapshot_col_str) is the sole owner of its column buffers —
        // route the appends through the reclaim-on-grow __fern_arr_push_owned
        // (frees the superseded rc==1 buffer, closing the cap-0 grow-leak
        // #4877). Flag-1 alias columns (i64/f64/struct/generic) keep the
        // LEAK-ONLY __fern_arr_push: their keys()/values() still return the RAW
        // buffer (an uncounted alias) that an owned grow would free from under a
        // live read.
        s = s.write("    tbnz x24, #1, .Lms_append_owned\n");
        s = s.write("    ldr x0, [x19]\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_arr_push\n");      // keys.append(key)
        s = s.write("    str x0, [x19]\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    mov x1, x21\n");
        s = s.write("    bl __fern_arr_push\n");      // values.append(val)
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write("    b .Lms_ret\n");
        s = s.write(".Lms_append_owned:\n");
        s = s.write("    ldr x0, [x19]\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_arr_push_owned\n"); // keys.append(key), frees old buffer on grow
        s = s.write("    str x0, [x19]\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    mov x1, x21\n");
        s = s.write("    bl __fern_arr_push_owned\n"); // values.append(val), frees old buffer on grow
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write(".Lms_ret:\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    ldp x25, x26, [sp], #16\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_set, .-__fern_map_set\n");

        // __fern_map_delete is now a Fern runtime function (#2649): see
        // asmcore.rt_src_map_delete, the same single source the x86 backend
        // emits, lowered here as __fn___fern_map_delete. The op site passes the
        // derived-eq address as an ordinary stack argument rather than in x5.

        // __fern_map_get(x0 = mapbox, x1 = key, x2 = keykind,
        // x5 = derived K.eq or 0) → Option[V]:
        // Some(values[i]) on hit, None otherwise.
        s = s.write(".globl __fern_map_get\n");
        s = s.write(".type __fern_map_get, %function\n");
        s = s.write("__fern_map_get:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // mapbox
        // Key search via __fern_map_find (#2649). Stack ABI: args pushed in
        // REVERSE so arg0 (the keys array) lands on top, in 16-byte slots, all
        // four dropped after.
        s = s.write("    str x5, [sp, #-16]!\n");    // arg3 = derived K.eq, or 0
        s = s.write("    str x2, [sp, #-16]!\n");    // arg2 = keykind
        s = s.write("    str x1, [sp, #-16]!\n");    // arg1 = key
        s = s.write("    ldr x9, [x19]\n");          // arg0 = keys arr
        s = s.write("    str x9, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_map_find\n");
        s = s.write("    add sp, sp, #64\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lmg_none\n");
        s = s.write("    ldr x9, [x19, #8]\n");      // values arr
        s = s.write("    add x10, x0, #1\n");
        s = s.write("    ldr x20, [x9, x10, lsl #3]\n");  // values[i+1]
        s = s.write("    mov x0, #2\n");
        s = s.write("    bl __fern_arr_box\n");        // Some box (rc-headered)
        s = s.write("    mov x9, #0\n");
        s = s.write("    str x9, [x0]\n");             // tag = Some
        s = s.write("    str x20, [x0, #8]\n");        // payload
        s = s.write("    b .Lmg_ret\n");
        s = s.write(".Lmg_none:\n");
        s = s.write("    mov x0, #2\n");
        s = s.write("    bl __fern_arr_box\n");        // None box (rc-headered)
        s = s.write("    mov x9, #1\n");
        s = s.write("    str x9, [x0]\n");             // tag = None
        s = s.write("    str xzr, [x0, #8]\n");
        s = s.write(".Lmg_ret:\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_get, .-__fern_map_get\n");

        // __fern_map_has(x0 = mapbox, x1 = key, x2 = keykind,
        // x5 = derived K.eq or 0) → 0/1.
        s = s.write(".globl __fern_map_has\n");
        s = s.write(".type __fern_map_has, %function\n");
        s = s.write("__fern_map_has:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        // Same __fern_map_find call as map_get (#2649); only the answer differs,
        // so nothing here outlives the call and no register needs saving.
        s = s.write("    str x5, [sp, #-16]!\n");    // arg3 = derived K.eq, or 0
        s = s.write("    str x2, [sp, #-16]!\n");    // arg2 = keykind
        s = s.write("    str x1, [sp, #-16]!\n");    // arg1 = key
        s = s.write("    ldr x9, [x0]\n");           // arg0 = keys arr
        s = s.write("    str x9, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_map_find\n");
        s = s.write("    add sp, sp, #64\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lmh_no\n");
        s = s.write("    mov x0, #1\n");
        s = s.write("    b .Lmh_ret\n");
        s = s.write(".Lmh_no:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write(".Lmh_ret:\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_has, .-__fern_map_has\n");
    }
    if (s.has_need("float_transcendentals")) {
        s = emit_rt_float_transcendentals(s);
    }
    // The CRC fold. Its own gate rather than the heap one: a program that
    // hashes a borrowed string allocates nothing, and would otherwise
    // `bl __fern_crc32_cksum` with no definition anywhere in the link.
    if (s.has_need("crc32_cksum")) {
        s = emit_rt_crc32_cksum(s);
    }

    // Command-line args. Mirror of asm.fern.
    if (s.has_need("args")) {
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_argc: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_argv: .quad 0\n");
        s = s.write("    .section .text\n");
        // __fern_arg_at: x0 = i32 index -> rc-headered string box of argv[i], the
        // separate-buffer __fern_str_box form (the bytes stay in the initial-stack
        // argv area, which __fn___fern_str_free's arena guard skips). The elements of
        // the args() array need the header too: one the program reads out is a value
        // the rc pass incs and decs, and on a headerless box laid back to back with
        // its neighbours that inc lands on the previous argument's length word.
        s = s.write("__fern_arg_at:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    adrp x1, __fern_argv\n");
        s = s.write("    add x1, x1, :lo12:__fern_argv\n");
        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    ldr x19, [x1, x0, lsl #3]\n");   // argv[i]
        s = s.write("    mov x2, x19\n");
        s = s.write("    mov x20, #0\n");
        s = s.write(".Larg_strlen:\n");
        s = s.write("    ldrb w0, [x2]\n");
        s = s.write("    cbz w0, .Larg_done\n");
        s = s.write("    add x2, x2, #1\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    b .Larg_strlen\n");
        s = s.write(".Larg_done:\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_str_box\n");           // rc-headered string box
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        // __fern_args: → string[] of all argv entries. Builds the
        // cap-header array layout ([cap, len, e0…] at base B, returned
        // B+8) and fills it with one rc-headered __fern_arg_at box per argument.
        s = s.write("__fern_args:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    adrp x19, __fern_argc\n");
        s = s.write("    add x19, x19, :lo12:__fern_argc\n");
        s = s.write("    ldr x19, [x19]\n");        // argc
        s = s.write("    mov x0, x19\n");           // cap = argc
        s = s.write("    bl __fern_arr_box\n");      // -> data ptr in x0 (cap + len written)
        s = s.write("    mov x20, x0\n");           // arr data ptr
        s = s.write("    mov x21, #0\n");           // i
        s = s.write(".Largs_loop:\n");
        s = s.write("    cmp x21, x19\n");
        s = s.write("    b.ge .Largs_done\n");
        s = s.write("    mov x0, x21\n");
        s = s.write("    bl __fern_arg_at\n");
        s = s.write("    add x22, x21, #1\n");
        s = s.write("    str x0, [x20, x22, lsl #3]\n");  // arr[i+1] = box
        s = s.write("    add x21, x21, #1\n");
        s = s.write("    b .Largs_loop\n");
        s = s.write(".Largs_done:\n");
        s = s.write("    mov x0, x20\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_push: append an 8-byte payload to an array.
    // x0 = arr ptr (returned form, [len@0, e_i@(i+1)*8]; rc hidden at
    // -8, capacity at -16), x1 = value. Amortised O(1): mutate in place
    // when len < cap, else alloc a doubled buffer via __fern_arr_box,
    // copy, return the new pointer. Mirrors the x86-64 emitter;
    // replaces the old O(N²) fresh-copy-every-push.
    if (s.has_need("arr_push")) {
        s = s.write("__fern_arr_push:\n");
        s = s.write(arr_push_fast(".Larr_push_slow"));
        s = s.write(".Larr_push_slow:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // arr ptr
        s = s.write("    mov x20, x1\n");           // value
        s = s.write("    ldr x21, [x19]\n");        // len
        s = s.write("    ldur x22, [x19, #-16]\n"); // cap (hidden at -16; rc at -8)
        // Past the fast path, the receiver is shared or full: both grow.
        if (!rc_free_debug_on()) { s = s.write("    b .Larr_push_grow\n"); }
        // #4873 containment gate — the arm64 twin of the x86 gate: an
        // rc >= 2 receiver is shared, so take the fresh-box copy path even
        // when capacity fits; rc == 1 / the bit-31 immortal sentinel keep
        // the in-place fast path.
        s = s.write("    ldur x2, [x19, #-8]\n");   // rc word
        s = s.write(san_poison_check("w2", "w10", ".Larr_push_sanlive"));
        s = s.write("    cmp x2, #1\n");
        s = s.write("    b.eq .Larr_push_rc_ok\n");
        s = s.write("    tbnz x2, #31, .Larr_push_rc_ok\n");
        s = s.write("    b .Larr_push_grow\n");     // shared → copy (#4873)
        s = s.write(".Larr_push_rc_ok:\n");
        s = s.write("    cmp x21, x22\n");
        s = s.write("    b.ge .Larr_push_grow\n");  // len >= cap → grow
        // In place: store value at slot (len+1), bump len.
        s = s.write("    add x1, x21, #1\n");
        s = s.write("    str x20, [x19, x1, lsl #3]\n");
        s = s.write("    add x21, x21, #1\n");
        s = s.write("    str x21, [x19]\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    b .Larr_push_ret\n");
        s = s.write(".Larr_push_grow:\n");
        // newcap = cap == 0 ? 4 : cap * 2 — except a SHARED receiver with
        // spare capacity (len < cap, #4873 un-share copy) keeps the same cap
        // instead of doubling, halving the copy's arena footprint (the
        // leak-mode self-compile is arena-bound, #3425). The x86 gate has
        // the same len < cap keep-cap branch.
        s = s.write("    mov x2, x22\n");
        s = s.write("    cmp x21, x22\n");
        s = s.write("    b.lt .Larr_push_shared_cliff\n");
        s = s.write("    cmp x22, #0\n");
        s = s.write("    b.ne .Larr_push_dbl\n");
        s = s.write("    mov x2, #4\n");
        s = s.write("    b .Larr_push_cap\n");
        // len < cap here is only reachable from the rc-shared branch above (the
        // rc-ok path arrives only on len >= cap), so this IS the cliff: a copy
        // bought by an extra reference, not by a full buffer. Count it, then
        // fall through with the cap undoubled — an un-share copy needs no
        // growth. Mirrors .Larr_push_shared_cliff on x86-64.
        s = s.write(".Larr_push_shared_cliff:\n");
        s = s.write("    adrp x3, __fern_arr_push_shared\n");
        s = s.write("    add x3, x3, :lo12:__fern_arr_push_shared\n");
        s = s.write("    ldr x4, [x3]\n");
        s = s.write("    add x4, x4, #1\n");
        s = s.write("    str x4, [x3]\n");
        // Weight the crossing by the len * 8 bytes the copy is about to move.
        // x3/x4 are the scratch this arm already owns (x2 holds the newcap
        // .Larr_push_cap consumes, so it stays untouched).
        s = s.write("    adrp x3, __fern_arr_push_copied\n");
        s = s.write("    add x3, x3, :lo12:__fern_arr_push_copied\n");
        s = s.write("    ldr x4, [x3]\n");
        s = s.write("    add x4, x4, x21, lsl #3\n");
        s = s.write("    str x4, [x3]\n");
        s = s.write("    b .Larr_push_cap\n");
        s = s.write(".Larr_push_dbl:\n");
        s = s.write("    lsl x2, x22, #1\n");
        s = s.write(".Larr_push_cap:\n");
        s = s.write("    mov x22, x2\n");           // x22 = newcap
        s = s.write("    mov x0, x2\n");            // cap = newcap
        s = s.write("    bl __fern_arr_box\n");      // -> data ptr in x0 (cap + len=cap written)
        s = s.write("    add x1, x21, #1\n");
        s = s.write("    str x1, [x0]\n");           // new len = old+1 (overwrite box's len)
        // Copy old elements (slots 1..len) from old arr to new, four to the
        // iteration through post-indexed pairs: two instructions per element
        // against the six a one-element-per-branch loop costs. The scratch is
        // x2..x8 — x0 (the new buffer, the return value), x19, x20 and x21 all
        // outlive this and are untouched. A word-count tail finishes the run.
        s = s.write("    add x2, x19, #8\n");        // src cursor
        s = s.write("    add x3, x0, #8\n");         // dst cursor
        s = s.write("    mov x4, x21\n");            // elements remaining
        s = s.write(".Larr_push_copy4:\n");
        s = s.write("    cmp x4, #4\n");
        s = s.write("    b.lt .Larr_push_copy1\n");
        s = s.write("    ldp x5, x6, [x2], #16\n");
        s = s.write("    ldp x7, x8, [x2], #16\n");
        s = s.write("    stp x5, x6, [x3], #16\n");
        s = s.write("    stp x7, x8, [x3], #16\n");
        s = s.write("    sub x4, x4, #4\n");
        s = s.write("    b .Larr_push_copy4\n");
        s = s.write(".Larr_push_copy1:\n");
        s = s.write("    cbz x4, .Larr_push_copy_done\n");
        s = s.write(".Larr_push_copy1_loop:\n");
        s = s.write("    ldr x5, [x2], #8\n");
        s = s.write("    str x5, [x3], #8\n");
        s = s.write("    subs x4, x4, #1\n");
        s = s.write("    b.ne .Larr_push_copy1_loop\n");
        s = s.write(".Larr_push_copy_done:\n");
        // Store the new value at slot (len+1).
        s = s.write("    add x1, x21, #1\n");
        s = s.write("    str x20, [x0, x1, lsl #3]\n");
        s = s.write(".Larr_push_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        // __fern_arr_push_owned — the sole-owner self-append (irlower's !aliased
        // `a = a.append(v)`). Wraps __fern_arr_push and, iff the push GREW
        // (reallocated, result != old), frees the dead old buffer onto its size
        // class (the __fern_arr_dec free path: rc-guarded, sole-owner, ≤512 KiB
        // tier). Sound only because the emit site proved the slot unaliased, so
        // the superseded old buffer has no surviving reference. Same heap layout
        // as __fern_arr_dec (rc @ [old-8], cap @ [old-16], base = old-16, idx =
        // cap+3, freelist word-indexed, class cap 65536). arm64 mirror of asm_ir's
        // __fern_arr_push_owned; co-emitted with __fern_arr_push (its dependency).
        s = s.write("__fern_arr_push_owned:\n");
        s = s.write(arr_push_fast(".Lapo_slow"));
        s = s.write(".Lapo_slow:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");             // save old arr ptr
        // x0 = new (grew) or old (in place); the fast path already declined.
        if (rc_free_debug_on()) { s = s.write("    bl __fern_arr_push\n"); } else { s = s.write("    bl .Larr_push_slow\n"); }
        s = s.write("    cmp x0, x19\n");
        s = s.write("    beq .Lapo_ret\n");            // in place — nothing freed
        s = s.write("    mov x9, #0x10000\n");
        s = s.write("    cmp x19, x9\n");              // grew: free the dead old box
        s = s.write("    blo .Lapo_ret\n");            // low-addr / SSO sentinel
        s = s.write("    ldur w1, [x19, #-8]\n");      // old rc
        s = s.write(san_poison_check("w1", "w10", ".Lapo_live"));
        s = s.write("    tbnz w1, #31, .Lapo_ret\n");  // static sentinel (rc<0)
        s = s.write("    cmp w1, #1\n");
        s = s.write("    bne .Lapo_ret\n");            // not sole owner — leave (defensive)
        s = s.write("    ldur x1, [x19, #-16]\n");     // old cap
        s = s.write("    add x1, x1, #3\n");           // idx = cap + 3
        s = s.write("    mov x9, #0x10000\n");         // freelist class cap (65536)
        s = s.write("    cmp x1, x9\n");
        s = s.write("    bhs .Lapo_large\n");          // large tier -> recycle via __fern_large_push
        s = s.write(quarantine_rc("[x19, #-8]", "w10"));  // release the rc word
        s = s.write("    sub x2, x19, #16\n");         // old box base
        s = lc_bump_free_words(s, "x1", "x3", "x9");
        if (!rc_free_debug_on()) {
        s = freelist_push(s, "x2", "x1", "x3", "x9");
        }
        s = s.write(".Lapo_ret:\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");                      // x0 = new
        // Large tier (#3425): recycle the >=512 KiB superseded old buffer (base =
        // old-16, bytes = idx*8) instead of leaking. x30 is saved in the frame
        // (restored at .Lapo_ret) so the bl is safe; large_push preserves x0 (= new).
        s = s.write(".Lapo_large:\n");
        s = s.write(quarantine_rc("[x19, #-8]", "w10"));  // release the rc word
        s = s.write("    lsl x2, x1, #3\n");           // bytes = idx*8
        s = s.write("    sub x1, x19, #16\n");         // base = old-16
        s = s.write("    bl __fern_large_push\n");
        s = s.write("    b .Lapo_ret\n");
    }
    // __fern_arr_slice is a Fern runtime function now (#2649):
    // asmcore.rt_src_arr_slice, emitted need-gated in the migrated-helpers
    // section over the __raw_arr_box + __raw_array pair. It takes a `tgt`, and
    // only because its bounds trap (#5419) is exit(134) through __syscall3 and
    // the exit number is per-target.
    // __fern_arr_str_join is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_str_join. It fills one exact-size block, so the heap
    // is its only dep and mark_arr_str_join declares it.
    if (s.has_need("arr_str_join")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_str_join(), s.struct_decls, s);
    }
    // __fern_arr_i32_min / _max are now Fern runtime functions (#2649): see
    // asmcore.rt_src_arr_i32_min / _max. Each takes a non-empty borrowed array
    // (the call site handles the empty→None case) and returns the extremum;
    // called via the stack convention.
    if (s.has_need("arr_i32_min_max")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_min(), s.struct_decls, s);
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_max(), s.struct_decls, s);
    }
    // __fern_i32_pow is the first runtime helper written in Fern instead of a
    // hand-written asm string (#2649): emit_runtime_fern_fn compiles its source
    // (shared in asmcore) through the normal function emitter, so it links as
    // __fn___fern_i32_pow and is called via the ordinary stack convention (see
    // the `pow` call site). Negative exp returns 1 (UB-ish, matching the
    // language's no-runtime-check stance — i32 pow with negative exp is UB).
    if (s.has_need("i32_pow")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_pow(), s.struct_decls, s);
    }
    // __fern_i32_gcd / __fern_i32_lcm — Fern runtime functions (#2649), pure
    // scalar (Tier 0). lcm's body calls `.gcd()`, so emit gcd first; close_needs
    // pulls in i32_gcd whenever i32_lcm is needed (runtime_need_deps edge).
    if (s.has_need("i32_gcd")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_gcd(), s.struct_decls, s);
    }
    if (s.has_need("i32_lcm")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_lcm(), s.struct_decls, s);
    }
    // __fern_str_trim — Fern runtime function (#2649), Tier-1: returns the
    // zero-copy sub-slice s[start:end] after skipping leading/trailing
    // whitespace. The slice box allocates (heap dep via mark_str_trim).
    if (s.has_need("str_trim")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_trim(), s.struct_decls, s);
    }
    // __fern_str_lines — Fern runtime function (#2649), Tier-1. Shared by
    // arm64 AST + IR. Deps pre-marked by mark_str_lines.
    if (s.has_need("str_lines")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_lines(), s.struct_decls, s);
    }
    // __fern_str_bytes — Fern runtime function (#2649), Tier-1: builds the byte
    // i32[] by appending each byte (arr_push). Shared by arm64 AST + IR.
    if (s.has_need("str_bytes")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_bytes(), s.struct_decls, s);
    }
    // __fern_str_reverse — Fern runtime function (#2649) via the raw-memory
    // intrinsics; single shared body for arm64 AST + IR. heap-only dep.
    if (s.has_need("str_reverse")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_reverse(), s.struct_decls, s);
    }
    // __fern_str_replace — Fern runtime function (#2649) via the raw-memory
    // intrinsics; single shared body for arm64 AST + IR. heap-only dep.
    if (s.has_need("str_replace")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_replace(), s.struct_decls, s);
    }
    // __fern_string_from_bytes — Fern runtime function (#2649) via the raw-memory
    // intrinsics; single shared body for arm64 AST + IR. heap-only dep.
    if (s.has_need("str_from_bytes")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_string_from_bytes(), s.struct_decls, s);
    }
    // __fern_str_split — Fern runtime function (#2649) via .append() + string
    // slices; single shared body for arm64 AST + IR. heap + arr_push dep.
    if (s.has_need("str_split")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_split(), s.struct_decls, s);
    }
    // The syscall leaves that are Fern on arm64 (#2649). Everything they need to
    // differ on between arm64-linux and arm64-darwin — syscall numbers, AT_FDCWD,
    // the open flag-set — comes from asmcore.sysno / at_fdcwd / oflag keyed by
    // `tgt`, so each is ONE source rather than a `darwin`-forked pair of hand-asm
    // bodies. darwinize cannot remap a number the emitter only has at runtime
    // (its rule needs a literal `mov x8, #N`), which is why the target's number
    // is baked into the source here instead.
    var tgt: string = "arm64-linux";
    if (darwin) { tgt = "arm64-darwin"; }
    // random_bytes: fill a scratch buffer through __syscall3, spread the bytes
    // into a fresh u8[] box (__raw_arr_box).
    if (s.has_need("random_bytes")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_random_bytes(tgt), s.struct_decls, s);
    }
    // a[start:end] — takes `tgt`: its bounds trap is exit(134) through
    // __syscall3, and Darwin's exit is 1 where Linux's is 93.
    if (s.has_need("arr_slice")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_slice(tgt), s.struct_decls, s);
    }
    // The migrated fs leaves — read_file / write_file / remove_file / temp_dir —
    // share ONE errno→IoError classifier and are emitted as a single bundle
    // module so the inter-procedural RC analysis threads each helper's call to
    // io_error as an ordinary call-graph edge (io_error consumes its fresh path
    // arg; the helpers hand it a fresh copy, never their borrowed `path`). This
    // mirrors asm_ir's bundle exactly. read_dir / remove_dir_all joined it: the
    // 4th out-param Darwin's getdirentries64 wants is just __syscall4, and the
    // dirent name offset is a direntoff row. open_res joined it once open_file
    // started returning a Result (#7758) — it calls io_error like every other
    // leaf, so it has to share the bundle's call graph rather than sit alone.
    // writer_write joined for the same reason once its own result became an
    // Option[IoError] (#7926), and reader_close once it started reporting a
    // failing close instead of discarding it.
    if (needs_fs_runtime(s)) {
        var fs_src: string = asmcore.rt_src_io_error(tgt);
        if (s.has_need("stat")) { fs_src = fs_src + " " + asmcore.rt_src_stat(tgt); }
        if (s.has_need("statfs")) { fs_src = fs_src + " " + asmcore.rt_src_statfs(tgt); }
        if (s.has_need("access")) { fs_src = fs_src + " " + asmcore.rt_src_access(tgt); }
        if (s.has_need("lstat")) { fs_src = fs_src + " " + asmcore.rt_src_lstat(tgt); }
        if (s.has_need("read_file")) { fs_src = fs_src + " " + asmcore.rt_src_utf8_valid() + " " + asmcore.rt_src_read_file(tgt); }
        if (s.has_need("read_file_bytes")) { fs_src = fs_src + " " + asmcore.rt_src_read_file_bytes(tgt); }
        if (s.has_need("write_file")) { fs_src = fs_src + " " + asmcore.rt_src_write_file(tgt); }
        if (s.has_need("write_file_exec")) { fs_src = fs_src + " " + asmcore.rt_src_write_file_exec(tgt); }
        if (s.has_need("remove_file")) { fs_src = fs_src + " " + asmcore.rt_src_remove_file(tgt); }
        if (s.has_need("create_dir_all")) { fs_src = fs_src + " " + asmcore.rt_src_create_dir_all(tgt); }
        if (s.has_need("create_dir")) { fs_src = fs_src + " " + asmcore.rt_src_create_dir(tgt); }
        if (s.has_need("remove_dir")) { fs_src = fs_src + " " + asmcore.rt_src_remove_dir(tgt); }
        if (s.has_need("chdir")) { fs_src = fs_src + " " + asmcore.rt_src_chdir(tgt); }
        if (s.has_need("chroot")) { fs_src = fs_src + " " + asmcore.rt_src_chroot(tgt); }
        if (s.has_need("setuid")) { fs_src = fs_src + " " + asmcore.rt_src_setuid(tgt); }
        if (s.has_need("setgid")) { fs_src = fs_src + " " + asmcore.rt_src_setgid(tgt); }
        if (s.has_need("setgroups")) { fs_src = fs_src + " " + asmcore.rt_src_setgroups(tgt); }
        if (s.has_need("create_link")) { fs_src = fs_src + " " + asmcore.rt_src_create_link(tgt); }
        if (s.has_need("create_symlink")) { fs_src = fs_src + " " + asmcore.rt_src_create_symlink(tgt); }
        if (s.has_need("rename")) { fs_src = fs_src + " " + asmcore.rt_src_rename(tgt); }
        if (s.has_need("chmod")) { fs_src = fs_src + " " + asmcore.rt_src_chmod(tgt); }
        if (s.has_need("signal_send")) { fs_src = fs_src + " " + asmcore.rt_src_signal_send(tgt); }
        if (s.has_need("set_process_group")) { fs_src = fs_src + " " + asmcore.rt_src_set_process_group(tgt); }
        if (s.has_need("set_priority")) { fs_src = fs_src + " " + asmcore.rt_src_set_priority(tgt); }
        if (s.has_need("truncate")) { fs_src = fs_src + " " + asmcore.rt_src_truncate(tgt); }
        if (s.has_need("mknod")) { fs_src = fs_src + " " + asmcore.rt_src_mknod(tgt); }
        if (s.has_need("window_size")) { fs_src = fs_src + " " + asmcore.rt_src_window_size(tgt); }
        if (s.has_need("set_window_size")) { fs_src = fs_src + " " + asmcore.rt_src_set_window_size(tgt); }
        if (s.has_need("chown_at")) { fs_src = fs_src + " " + asmcore.rt_src_chown_at(tgt); }
        if (s.has_need("chmod_at")) { fs_src = fs_src + " " + asmcore.rt_src_chmod_at(tgt); }
        if (s.has_need("set_file_times")) { fs_src = fs_src + " " + asmcore.rt_src_set_file_times(tgt); }
        if (s.has_need("read_link")) { fs_src = fs_src + " " + asmcore.rt_src_read_link(tgt); }
        if (s.has_need("umask")) { fs_src = fs_src + " " + asmcore.rt_src_umask(tgt); }
        if (s.has_need("priority")) { fs_src = fs_src + " " + asmcore.rt_src_priority(tgt); }
        if (s.has_need("temp_dir")) { fs_src = fs_src + " " + asmcore.rt_src_temp_dir(tgt); }
        if (s.has_need("read_dir")) { fs_src = fs_src + " " + asmcore.rt_src_read_dir(tgt); }
        if (s.has_need("read_dir_all")) { fs_src = fs_src + " " + asmcore.rt_src_read_dir_all(tgt); }
        if (s.has_need("remove_dir_all")) { fs_src = fs_src + " " + asmcore.rt_src_remove_dir_all(tgt); }
        if (s.has_need("open_file")) { fs_src = fs_src + " " + asmcore.rt_src_open_res(tgt); }
        if (s.has_need("open_with")) { fs_src = fs_src + " " + asmcore.rt_src_open_with(tgt); }
        if (s.has_need("writer_write")) { fs_src = fs_src + " " + asmcore.rt_src_writer_write(tgt); }
        if (s.has_need("write_some")) { fs_src = fs_src + " " + asmcore.rt_src_writer_write_some(tgt); }
        if (s.has_need("reader")) { fs_src = fs_src + " " + asmcore.rt_src_reader_read_chunk(tgt) + " " + asmcore.rt_src_reader_close(tgt); }
        if (s.has_need("fd_stat")) { fs_src = fs_src + " " + asmcore.rt_src_fd_stat(tgt); }
        fs_src = fs_src + asmcore.rt_src_sync_family(s, tgt);
        if (s.has_need("reader_seek")) { fs_src = fs_src + " " + asmcore.rt_src_reader_seek(tgt); }
        if (s.has_need("reader_splice")) { fs_src = fs_src + " " + asmcore.rt_src_reader_splice(tgt); }
        if (s.has_need("fd_flags")) { fs_src = fs_src + " " + asmcore.rt_src_fd_flags(tgt); }
        if (s.has_need("fd_dup_onto")) { fs_src = fs_src + " " + asmcore.rt_src_fd_dup_onto(tgt); }
        if (s.has_need("writer_truncate")) { fs_src = fs_src + " " + asmcore.rt_src_writer_truncate(tgt); }
        s = emit_ir_runtime_fern_fn(fs_src, s.struct_decls, s);
    }
    // env is the odd one out: no syscall at all, so it needs none of `tgt` and
    // does not join the fs bundle — it calls no io_error (a missing variable is
    // None, not an error). It reads __fern_envp through the __raw_environ op.
    if (s.has_need("env")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_env(), s.struct_decls, s);
    }
    // environ is env's whole-list sibling and reads the same slot the same way,
    // so it is target-independent for the same reason.
    if (s.has_need("environ")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_environ(), s.struct_decls, s);
    }
    // __fern_str_bytes is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_bytes, emitted (need-gated) in the migrated-helpers
    // section below. The single shared body serves both arm64 AST + IR. It builds
    // the i32[] by appending each byte (arr_push) — its deps are declared by
    // mark_str_bytes / runtime_need_deps.
    // random_i32: four bytes from the CSPRNG into __fern_scratch, reloaded as an
    // i32. Heap-independent — gated by its own need (NOT the heap block) so a
    // random_i32-only program still links it. Linux getrandom / Darwin
    // getentropy differ only in the number, which `tgt` supplies.
    if (s.has_need("random_i32")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_random_i32(tgt), s.struct_decls, s);
    }
    // tcp_close / tcp_accept / tcp_local_port: the three socket leaves that take
    // only an fd (#2649). Need-gated HERE rather than in emit_rt_net, which runs
    // only under the heap gate and emits its helpers unconditionally — none of
    // these allocates, so a program that closes a socket, or asks one its port,
    // without otherwise touching the heap must still get them.
    if (s.has_need("tcp_close")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_close(tgt), s.struct_decls, s);
    }
    if (s.has_need("tcp_accept")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_accept(tgt), s.struct_decls, s);
    }
    if (s.has_need("tcp_local_port")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_local_port(tgt), s.struct_decls, s);
    }
    // sleep_ms: nanosleep on Linux, select on Darwin (XNU has no nanosleep) —
    // the first __syscall5 consumer. Writes its timespec/timeval into
    // __fern_scratch, so it joins that gate; allocation-free, so it is emitted
    // outside the heap block.
    if (s.has_need("sleep_ms")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_sleep_ms(tgt), s.struct_decls, s);
    }
    // sleep_ns: the same two calls, split by 1e9 instead of 1e3 — and on Darwin
    // the leftover nanoseconds round UP into select's microsecond timeval.
    if (s.has_need("sleep_ns")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_sleep_ns(tgt), s.struct_decls, s);
    }
    // poll: ppoll over a freshly built pollfd[] on Linux, a bare -1 on Darwin.
    // It allocates, so it is heap-dependent — but emitted here beside the other
    // migrated leaves rather than in emit_rt_readiness, which the hand-asm used.
    if (s.has_need("poll")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_poll(tgt), s.struct_decls, s);
    }
    // proc_waitpid: wait4 into __fern_scratch plus the status decode. Same body
    // on every target — only the number moves — so no `darwin` fork here.
    if (s.has_need("proc_waitpid")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_waitpid(tgt), s.struct_decls, s);
    }
    if (s.has_need("proc_waitpid_nohang")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_waitpid_nohang(tgt), s.struct_decls, s);
    }
    // timer_fd: timerfd_create + timerfd_settime over an itimerspec in
    // __fern_scratch. Darwin has no timerfd and answers -1, as its hand-asm did.
    if (s.has_need("timer_fd")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_timer_fd(tgt), s.struct_decls, s);
    }
    // isatty: one terminal-attribute ioctl, whose request number is the only
    // per-target difference (TCGETS vs TIOCGETA).
    if (s.has_need("geteuid")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_getid(tgt, "geteuid"), s.struct_decls, s);
    }
    if (s.has_need("getegid")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_getid(tgt, "getegid"), s.struct_decls, s);
    }
    if (s.has_need("getuid")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_getid(tgt, "getuid"), s.struct_decls, s);
    }
    if (s.has_need("getgid")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_getid(tgt, "getgid"), s.struct_decls, s);
    }
    if (s.has_need("getgroups")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_getgroups(tgt), s.struct_decls, s);
    }
    // Through this path rather than the batched fs_src string, for the reason
    // getgroups is: the read half appends to an i64[], so its body reaches
    // __fern_arr_push_owned and only this one marks what a body needs.
    if (s.has_need("termios_get")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_termios_get(tgt), s.struct_decls, s);
    }
    if (s.has_need("termios_set")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_termios_set(tgt), s.struct_decls, s);
    }
    if (s.has_need("hostname")) {
        if (darwin) {
            s = emit_rt_hostname_darwin(s);
        } else {
            s = emit_ir_runtime_fern_fn(asmcore.rt_src_hostname(tgt), s.struct_decls, s);
        }
    }
    if (s.has_need("uname_field")) {
        if (darwin) {
            s = emit_rt_uname_field_darwin(s);
        } else {
            s = emit_ir_runtime_fern_fn(asmcore.rt_src_uname_field(tgt), s.struct_decls, s);
        }
    }
    if (s.has_need("getcwd")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_getcwd(tgt), s.struct_decls, s);
    }
    if (s.has_need("cpu_count")) {
        if (darwin) {
            s = emit_rt_cpu_count_darwin(s);
        } else {
            s = emit_ir_runtime_fern_fn(asmcore.rt_src_cpu_count(tgt), s.struct_decls, s);
        }
    }
    if (s.has_need("isatty")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_isatty(tgt), s.struct_decls, s);
    }
    if (s.has_need("process_alive")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_process_alive(tgt), s.struct_decls, s);
    }
    if (s.has_need("rlimit_nofile")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_rlimit_nofile(tgt), s.struct_decls, s);
    }
    if (s.has_need("signal_mask")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_signal_mask(tgt), s.struct_decls, s);
    }
    if (s.has_need("signal_disposition")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_signal_disposition_read(tgt), s.struct_decls, s);
    }
    if (s.has_need("signal_ignore")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_signal_disposition(tgt, "signal_ignore", "1"), s.struct_decls, s);
    }
    if (s.has_need("signal_default")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_signal_disposition(tgt, "signal_default", "0"), s.struct_decls, s);
    }
    // tcp_listen: socket + bind + listen. The sockaddr_in's only per-target
    // difference is its first two bytes (XNU has sin_len), which sockaddr_head
    // supplies.
    if (s.has_need("tcp_listen")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_listen(tgt), s.struct_decls, s);
    }
    // tcp_connect: the same sockaddr_in as tcp_listen with the address filled in.
    if (s.has_need("udp_send")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_udp_send(tgt), s.struct_decls, s);
    }
    if (s.has_need("tcp_connect")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_connect(tgt), s.struct_decls, s);
    }
    // tcp_recv: read(2) into a scratch buffer, spread into a fresh u8[] box.
    if (s.has_need("tcp_recv")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_recv(tgt), s.struct_decls, s);
    }
    // tcp_send: sendto(2) with MSG_NOSIGNAL from the string's buffer, via __raw_data.
    if (s.has_need("tcp_send")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_send(tgt), s.struct_decls, s);
    }
    // proc_exec: execve over an argv built from the args array.
    if (s.has_need("proc_exec")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec(tgt), s.struct_decls, s);
    }
    // proc_exec_as: the same execve with the caller's argv and envp.
    if (s.has_need("proc_exec_as")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec_as(tgt), s.struct_decls, s);
    }
    // __fern_map_hash_seed() → core/map's per-process string-hash seed
    // (#6194), drawn once via the Fern __fn___fern_random_i32 and cached in the unit-local
    // __fern_map_seed word.
    //
    // Forced nonzero: the word doubles as its own "already drawn" flag, and 0
    // is also core/map's "unseeded" sentinel, so a drawn 0 would both re-draw
    // every call and silently leave that map unseeded.
    if (s.has_need("map_hash_seed")) {
        s = s.write(".globl __fern_map_hash_seed\n");
        s = s.write(".type __fern_map_hash_seed, %function\n");
        s = s.write("__fern_map_hash_seed:\n");
        s = s.write("    adrp x1, __fern_map_seed\n");
        s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
        s = s.write("    ldr w0, [x1]\n");
        s = s.write("    cbnz w0, .Lmapseed_ret\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_random_i32\n");
        s = s.write("    orr w0, w0, #1\n");
        s = s.write("    adrp x1, __fern_map_seed\n");
        s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
        s = s.write("    str w0, [x1]\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write(".Lmapseed_ret:\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_hash_seed, .-__fern_map_hash_seed\n");
    }
    // proc_exec is Fern now (#2649) — see the migrated-helpers section.
    // proc_fork() → 0 in the child, the child's pid in the parent, -errno on
    // failure — the crash-only supervision primitive (docs/CRASH-ONLY-SERVE.md
    // D2', #5686). The kernel's return shape IS the contract.
    //
    // arm64 Linux is Fern (#2649): it has no bare fork(2) and spells it
    // clone(SIGCHLD, 0, 0, 0, 0), which is exactly __syscall5.
    //
    // Darwin cannot be. XNU's fork returns the pid in x0 and marks the child in
    // **x1**, and no __syscall* intrinsic can see a second return register — the
    // carry-flag half would have been free, since darwinize already injects that
    // fold. So this joins monotonic_ns as a hand-written Darwin body, under the
    // __fn___ name its Fern sibling uses: a zero-arg helper's stack and register
    // conventions coincide, so the call site never learns which one it got.
    // Heap-independent, gated by its own need.
    if (s.has_need("proc_fork")) {
        if (darwin) {
            s = s.write(".globl __fn___fern_proc_fork\n");
            s = s.write(".type __fn___fern_proc_fork, %function\n");
            s = s.write("__fn___fern_proc_fork:\n");
            s = s.write("    stp x29, x30, [sp, #-16]!\n");
            s = s.write("    mov x29, sp\n");
            s = s.write("    mov x16, #2\n");
            s = s.write("    svc #0x80\n");
            s = s.write("    b.cc .Lpf_ok\n");
            s = s.write("    neg x0, x0\n");            // carry set: +errno -> -errno
            s = s.write("    b .Lpf_done\n");
            s = s.write(".Lpf_ok:\n");
            s = s.write("    cbz x1, .Lpf_done\n");     // parent: x0 = child pid
            s = s.write("    mov x0, #0\n");            // child
            s = s.write(".Lpf_done:\n");
            s = s.write("    ldp x29, x30, [sp], #16\n");
            s = s.write("    ret\n");
            s = s.write(".size __fn___fern_proc_fork, .-__fn___fern_proc_fork\n");
        } else {
            s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_fork(tgt), s.struct_decls, s);
        }
    }
    // __fern_str_lines is now a Fern runtime function (#2649): see
    // asmcore.rt_src_str_lines, emitted (need-gated) in the migrated-helpers
    // section below. The single shared body serves both arm64 AST + IR; its deps
    // are declared by mark_str_lines / runtime_need_deps.
    // __fern_arr_i32_product / _sum are now Fern runtime functions (#2649),
    // compiled through emit_function (see asmcore.rt_src_arr_i32_*). They link
    // as __fn___fern_arr_i32_product / __fn___fern_arr_i32_sum and are called
    // via the ordinary stack convention; the array param is borrowed.
    if (s.has_need("arr_i32_product")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_product(), s.struct_decls, s);
    }
    if (s.has_need("arr_i32_sum")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_sum(), s.struct_decls, s);
    }
    // __fern_arr_i32_index_of is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_i32_index_of. Linear scan returning the first index
    // where arr[i] == target, or -1; called via the stack convention.
    if (s.has_need("arr_i32_index_of")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_index_of(), s.struct_decls, s);
    }
    // __fern_arr_i32_index_of_opt backs xs.index_of(x) (#4387): the raw scan
    // above returns the -1 sentinel and still backs .contains(x); this one
    // carries the Option box in its Fern body, so the IR call site is a plain
    // call. It allocates, so the need also pulls in the heap runtime.
    if (s.has_need("arr_i32_index_of_opt")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_index_of_opt(), s.struct_decls, s);
    }
    // __fern_arr_i32_min_opt / _max_opt back xs.min() / .max() on the IR path
    // (#3457): unlike the raw-extremum __fern_arr_i32_min / _max above (whose
    // empty-array guard and Option box the AST call site open-codes), these carry
    // both in their Fern bodies, so the IR call site is a plain call. Emitted as
    // one module; they allocate, so the need also pulls in the heap runtime.
    if (s.has_need("arr_i32_min_max_opt")) {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_i32_min_max_opt(), s.struct_decls, s);
    }
    return s;
}

// emit_rt_crc32_cksum emits `__fern_crc32_cksum(crc, box) -> i32`: the bytes of
// the string box folded into the running CRC-32 that cksum(1) prints (poly
// 0x04C11DB7, MSB first, unreflected, no final complement).
//
// The pmull fold, register for register the native arm64 backend's kernel.
// pmull/pmull2 multiply the low and high doublewords, so the fold constants
// sit as K2 in element 0 and K1 in element 1 — the opposite order from the
// x86-64 twin, where an immediate selects the halves instead.
//
// No constant pool: rev64 + ext does the 16-byte reverse in registers and the
// fold constants are built with movz/movk and inserted with `ins`. That is not
// stylistic — this assembler encodes neither adrp nor `ldr q`, which a probe
// of every instruction the kernel needs established before any of it was
// written. ld1/st1 carry the block loads for the same reason.
//
// `.arch_extension aes` is for the EXTERNAL toolchain only: pmull's .1q form
// is FEAT_PMULL, which GNU as does not enable at its default architecture even
// though the declared baseline has it. An extension directive rather than a
// whole `.arch` because this emitter declares none, and adding a feature
// cannot take one away from the code around it.
//
// FOUR accumulators, 64 bytes a step: one chain runs at the multiply's
// latency rather than its throughput.
//
// x1 is the string BOX, not an SSO string — this emitter's strings are two
// words, [data@0, len@8].
function emit_rt_crc32_cksum(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    .arch_extension aes\n");
    s = s.write("    .global __fern_crc32_cksum\n");
    s = s.write("    .type __fern_crc32_cksum, %function\n");
    s = s.write("__fern_crc32_cksum:\n");
    s = s.write("    stp x29, x30, [sp, #-64]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    mov w10, w0\n");
    s = s.write("    ldr x6, [x1, #8]\n");
    s = s.write("    ldr x7, [x1]\n");
    s = s.write("    mov x8, x7\n");
    s = s.write("    add x9, x7, w6, uxtw\n");
    s = s.write("    mov w0, w10\n");
    s = s.write("    sub x11, x9, x8\n");
    s = s.write("    cmp x11, #16\n");
    s = s.write("    b.lo .Lcrc32_tail\n");
    s = s.write("    movz w12, #0x5605\n");
    s = s.write("    movk w12, #0xe8a4, lsl #16\n");
    s = s.write("    movz w13, #0xcd4c\n");
    s = s.write("    movk w13, #0xc5b9, lsl #16\n");
    s = s.write("    movi v2.2d, #0\n");
    s = s.write("    ins v2.d[0], x12\n");
    s = s.write("    ins v2.d[1], x13\n");
    s = s.write("    ld1 {v0.16b}, [x8]\n");
    s = s.write("    rev64 v0.16b, v0.16b\n");
    s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
    s = s.write("    lsl x14, x10, #32\n");
    s = s.write("    movi v1.2d, #0\n");
    s = s.write("    ins v1.d[1], x14\n");
    s = s.write("    eor v0.16b, v0.16b, v1.16b\n");
    s = s.write("    mov w0, wzr\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    sub x11, x9, x8\n");
    s = s.write("    cmp x11, #112\n");
    s = s.write("    b.lo .Lcrc32_fold1\n");
    s = s.write("    ld1 {v6.16b}, [x8]\n");
    s = s.write("    rev64 v6.16b, v6.16b\n");
    s = s.write("    ext v6.16b, v6.16b, v6.16b, #8\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    ld1 {v7.16b}, [x8]\n");
    s = s.write("    rev64 v7.16b, v7.16b\n");
    s = s.write("    ext v7.16b, v7.16b, v7.16b, #8\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    ld1 {v16.16b}, [x8]\n");
    s = s.write("    rev64 v16.16b, v16.16b\n");
    s = s.write("    ext v16.16b, v16.16b, v16.16b, #8\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    movz w12, #0x8b11\n");
    s = s.write("    movk w12, #0xe622, lsl #16\n");
    s = s.write("    movz w13, #0x794c\n");
    s = s.write("    movk w13, #0x8833, lsl #16\n");
    s = s.write("    movi v17.2d, #0\n");
    s = s.write("    ins v17.d[0], x12\n");
    s = s.write("    ins v17.d[1], x13\n");
    s = s.write(".Lcrc32_fold4:\n");
    s = s.write("    sub x11, x9, x8\n");
    s = s.write("    cmp x11, #64\n");
    s = s.write("    b.lo .Lcrc32_combine\n");
    s = s.write("    pmull2 v3.1q, v0.2d, v17.2d\n");
    s = s.write("    pmull v4.1q, v0.1d, v17.1d\n");
    s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
    s = s.write("    ld1 {v5.16b}, [x8]\n");
    s = s.write("    rev64 v5.16b, v5.16b\n");
    s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
    s = s.write("    eor v0.16b, v0.16b, v5.16b\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    pmull2 v3.1q, v6.2d, v17.2d\n");
    s = s.write("    pmull v4.1q, v6.1d, v17.1d\n");
    s = s.write("    eor v6.16b, v3.16b, v4.16b\n");
    s = s.write("    ld1 {v5.16b}, [x8]\n");
    s = s.write("    rev64 v5.16b, v5.16b\n");
    s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
    s = s.write("    eor v6.16b, v6.16b, v5.16b\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    pmull2 v3.1q, v7.2d, v17.2d\n");
    s = s.write("    pmull v4.1q, v7.1d, v17.1d\n");
    s = s.write("    eor v7.16b, v3.16b, v4.16b\n");
    s = s.write("    ld1 {v5.16b}, [x8]\n");
    s = s.write("    rev64 v5.16b, v5.16b\n");
    s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
    s = s.write("    eor v7.16b, v7.16b, v5.16b\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    pmull2 v3.1q, v16.2d, v17.2d\n");
    s = s.write("    pmull v4.1q, v16.1d, v17.1d\n");
    s = s.write("    eor v16.16b, v3.16b, v4.16b\n");
    s = s.write("    ld1 {v5.16b}, [x8]\n");
    s = s.write("    rev64 v5.16b, v5.16b\n");
    s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
    s = s.write("    eor v16.16b, v16.16b, v5.16b\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    b .Lcrc32_fold4\n");
    s = s.write(".Lcrc32_combine:\n");
    s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
    s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
    s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
    s = s.write("    eor v0.16b, v0.16b, v6.16b\n");
    s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
    s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
    s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
    s = s.write("    eor v0.16b, v0.16b, v7.16b\n");
    s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
    s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
    s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
    s = s.write("    eor v0.16b, v0.16b, v16.16b\n");
    s = s.write(".Lcrc32_fold1:\n");
    s = s.write("    sub x11, x9, x8\n");
    s = s.write("    cmp x11, #16\n");
    s = s.write("    b.lo .Lcrc32_reduce\n");
    s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
    s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
    s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
    s = s.write("    ld1 {v5.16b}, [x8]\n");
    s = s.write("    rev64 v5.16b, v5.16b\n");
    s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
    s = s.write("    eor v0.16b, v0.16b, v5.16b\n");
    s = s.write("    add x8, x8, #16\n");
    s = s.write("    b .Lcrc32_fold1\n");
    s = s.write(".Lcrc32_reduce:\n");
    s = s.write("    rev64 v0.16b, v0.16b\n");
    s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
    s = s.write("    add x15, x29, #48\n");
    s = s.write("    st1 {v0.16b}, [x15]\n");
    s = s.write("    mov x16, xzr\n");
    s = s.write(".Lcrc32_red:\n");
    s = s.write("    cmp x16, #16\n");
    s = s.write("    b.hs .Lcrc32_tail\n");
    s = s.write("    ldrb w17, [x15, x16]\n");
    s = s.write("    lsl w17, w17, #24\n");
    s = s.write("    eor w0, w0, w17\n");
    s = s.write("    mov w12, #8\n");
    s = s.write("    movz w13, #0x1db7\n");
    s = s.write("    movk w13, #0x04c1, lsl #16\n");
    s = s.write(".Lcrc32_redbit:\n");
    s = s.write("    asr w14, w0, #31\n");
    s = s.write("    and w14, w14, w13\n");
    s = s.write("    lsl w0, w0, #1\n");
    s = s.write("    eor w0, w0, w14\n");
    s = s.write("    sub w12, w12, #1\n");
    s = s.write("    cbnz w12, .Lcrc32_redbit\n");
    s = s.write("    add x16, x16, #1\n");
    s = s.write("    b .Lcrc32_red\n");
    s = s.write(".Lcrc32_tail:\n");
    s = s.write("    cmp x8, x9\n");
    s = s.write("    b.hs .Lcrc32_ret\n");
    s = s.write("    ldrb w17, [x8]\n");
    s = s.write("    lsl w17, w17, #24\n");
    s = s.write("    eor w0, w0, w17\n");
    s = s.write("    mov w12, #8\n");
    s = s.write("    movz w13, #0x1db7\n");
    s = s.write("    movk w13, #0x04c1, lsl #16\n");
    s = s.write(".Lcrc32_tailbit:\n");
    s = s.write("    asr w14, w0, #31\n");
    s = s.write("    and w14, w14, w13\n");
    s = s.write("    lsl w0, w0, #1\n");
    s = s.write("    eor w0, w0, w14\n");
    s = s.write("    sub w12, w12, #1\n");
    s = s.write("    cbnz w12, .Lcrc32_tailbit\n");
    s = s.write("    add x8, x8, #1\n");
    s = s.write("    b .Lcrc32_tail\n");
    s = s.write(".Lcrc32_ret:\n");
    s = s.write("    ldp x29, x30, [sp], #64\n");
    s = s.write("    ret\n");
    s = s.write("    .size __fern_crc32_cksum, .-__fern_crc32_cksum\n");
    return s;
}

// emit_rt_float_transcendentals emits the f64 transcendental bundle — arm64 has
// no transcendental instruction, so sin/cos/exp/log/pow are calls into these.
// Gated on the "float_transcendentals" need, which the op_funary/op_fbin
// lowerings mark; native arm64 gates the same bundle on usesFloatTranscendentals.
// These are fdlibm's kernels, and they replace polynomials whose own comment
// here claimed "<1e-5 against libm" while measuring 3.2e10 ulp for sin, 4.5e7
// for exp and 9844 for log.
//
// Same reduction and same `frintn` as internal/codegen/arm64's
// emitFloatTranscendentalsRuntime (ties-to-EVEN, matching x86's
// `roundsd …, 0`; the more familiar `frinta` rounds ties away and would
// disagree). The self-host cannot import Go, so the .Lfc_* table below is a
// literal copy of internal/codegen/fdlibm's — whose selfhost_parity_test pins
// it entry for entry. internal/e2e/f64_ulp_test.go is the gate for the native
// pair.
//
// Two things that are corrections rather than refinements:
//
//   - pi/2 is carried as THREE 33-bit chunks (~99 bits). Two is not enough near
//     a zero of sine, where the reduced argument IS the answer, so the
//     reduction's absolute error becomes the result's relative error: sin(pi)
//     measured 285,696 ulp. A fourth chunk makes it worse, not better.
//   - Every function guards its domain: log(0) returned -709.09 and log(-1)
//     returned 0 without it. The domain guard is not what keeps 2^k in range —
//     that is the two half-scales the reconstruction is built from.
//
// fc_pio2_reduce: d0 = x -> x10 = quadrant (k&3), d0 = r with |r| <= pi/4.
// prefix keeps the local labels unique across the two emission sites (sin and
// cos), which previously each carried their own inlined copy of this chain.
//
// |x| >= 2^20 (biased exponent >= 1043) puts k past pio2h's 22 exact mantissa
// bits, so the Cody-Waite chain below reduces against noise there and calls
// __fern_rem_pio2_large instead. The trig guard already returned Inf/NaN, and
// the caller's frame is already pushed.
function fc_pio2_reduce(s: asmcore.EmitState, prefix: string): asmcore.EmitState {
    s = s.write("    fmov x13, d0\n");
    s = s.write("    ubfx x13, x13, #52, #11\n");
    s = s.write("    cmp x13, #1043\n");
    s = s.write("    b.lt .L" + prefix + "_cw\n");
    s = s.write("    bl __fern_rem_pio2_large\n");
    s = s.write("    b .L" + prefix + "_red\n");
    s = s.write(".L" + prefix + "_cw:\n");
    s = emit_ldc(s, "d1", ".Lfc_2opi");
    s = s.write("    fmul d1, d1, d0\n");
    s = s.write("    frintn d1, d1\n");
    s = s.write("    fcvtzs x10, d1\n");
    s = emit_ldc(s, "d2", ".Lfc_pio2h");
    s = s.write("    fmul d2, d1, d2\n");
    s = s.write("    fsub d0, d0, d2\n");
    s = emit_ldc(s, "d2", ".Lfc_pio2m");
    s = s.write("    fmul d2, d1, d2\n");
    s = s.write("    fsub d0, d0, d2\n");
    s = emit_ldc(s, "d2", ".Lfc_pio2l");
    s = s.write("    fmul d1, d1, d2\n");
    s = s.write("    fsub d0, d0, d1\n");
    s = s.write("    and x10, x10, #3\n");
    s = s.write(".L" + prefix + "_red:\n");
    return s;
}

// Arg in d0 (pow also d1), result in d0; x12 is emit_ldc's scratch.
function emit_rt_float_transcendentals(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    .section .rodata\n");
    s = s.write("    .align 8\n");
    s = s.write(".Lfc_one: .double 1.0\n");
    s = s.write(".Lfc_half: .double 0.5\n");
    s = s.write(".Lfc_two: .double 2.0\n");
    s = s.write(".Lfc_sqrt2: .double 1.4142135623730951\n");
    s = s.write(".Lfc_invln2: .double 1.44269504088896338700e+00\n");
    s = s.write(".Lfc_ln2hi: .double 6.93147180369123816490e-01\n");
    s = s.write(".Lfc_ln2lo: .double 1.90821492927058770002e-10\n");
    s = s.write(".Lfc_2opi: .double 6.36619772367581382433e-01\n");
    s = s.write(".Lfc_pio2h: .double 1.57079632673412561417e+00\n");
    s = s.write(".Lfc_pio2m: .double 6.07710050630396597660e-11\n");
    s = s.write(".Lfc_pio2l: .double 2.02226624879595063154e-21\n");
    // pi/2 as an unevaluated double-double, plus the two scales that turn
    // __fern_rem_pio2_large's 126-bit fraction into a double.
    s = s.write(".Lfc_pio2hi: .double 1.5707963267948966\n");
    s = s.write(".Lfc_pio2lo: .double 6.123233995736766e-17\n");
    s = s.write(".Lfc_2m62: .double 2.168404344971009e-19\n");
    s = s.write(".Lfc_2m115: .double 2.407412430484045e-35\n");
    // 2/pi in binary, MSB-first, one limb per 64 fraction bits starting at
    // 2^-1 in limb 1 — the window Payne-Hanek indexes with the argument's own
    // exponent. The leading zero limb lets that index start above 2^-1 without
    // a bounds test; the length covers the largest finite double. Same table
    // as the native backends'.
    s = s.write(".Lfc_2opi_bits:\n");
    s = s.write("    .quad 0x0000000000000000\n    .quad 0xa2f9836e4e441529\n    .quad 0xfc2757d1f534ddc0\n");
    s = s.write("    .quad 0xdb6295993c439041\n    .quad 0xfe5163abdebbc561\n    .quad 0xb7246e3a424dd2e0\n");
    s = s.write("    .quad 0x06492eea09d1921c\n    .quad 0xfe1deb1cb129a73e\n    .quad 0xe88235f52ebb4484\n");
    s = s.write("    .quad 0xe99c7026b45f7e41\n    .quad 0x3991d639835339f4\n    .quad 0x9c845f8bbdf9283b\n");
    s = s.write("    .quad 0x1ff897ffde05980f\n    .quad 0xef2f118b5a0a6d1f\n    .quad 0x6d367ecf27cb09b7\n");
    s = s.write("    .quad 0x4f463f669e5fea2d\n    .quad 0x7527bac7ebe5f17b\n    .quad 0x3d0739f78a5292ea\n");
    s = s.write("    .quad 0x6bfb5fb11f8d5d08\n    .quad 0x56033046fc7b6bab\n    .quad 0xf0cfbc209af4361d\n");
    s = s.write(".Lfc_s1: .double -1.66666666666666324348e-01\n");
    s = s.write(".Lfc_s2: .double 8.33333333332248946124e-03\n");
    s = s.write(".Lfc_s3: .double -1.98412698298579493134e-04\n");
    s = s.write(".Lfc_s4: .double 2.75573137070700676789e-06\n");
    s = s.write(".Lfc_s5: .double -2.50507602534068634195e-08\n");
    s = s.write(".Lfc_s6: .double 1.58969099521155010221e-10\n");
    s = s.write(".Lfc_c1: .double 4.16666666666666019037e-02\n");
    s = s.write(".Lfc_c2: .double -1.38888888888741095749e-03\n");
    s = s.write(".Lfc_c3: .double 2.48015872894767294178e-05\n");
    s = s.write(".Lfc_c4: .double -2.75573143513906633035e-07\n");
    s = s.write(".Lfc_c5: .double 2.08757232129817482790e-09\n");
    s = s.write(".Lfc_c6: .double -1.13596475577881948265e-11\n");
    s = s.write(".Lfc_p1: .double 1.66666666666666019037e-01\n");
    s = s.write(".Lfc_p2: .double -2.77777777770155933842e-03\n");
    s = s.write(".Lfc_p3: .double 6.61375632143793436117e-05\n");
    s = s.write(".Lfc_p4: .double -1.65339022054652515390e-06\n");
    s = s.write(".Lfc_p5: .double 4.13813679705723846039e-08\n");
    s = s.write(".Lfc_lg1: .double 6.666666666666735130e-01\n");
    s = s.write(".Lfc_lg2: .double 3.999999999940941908e-01\n");
    s = s.write(".Lfc_lg3: .double 2.857142874366239149e-01\n");
    s = s.write(".Lfc_lg4: .double 2.222219843214978396e-01\n");
    s = s.write(".Lfc_lg5: .double 1.818357216161805012e-01\n");
    s = s.write(".Lfc_lg6: .double 1.531383769920937332e-01\n");
    s = s.write(".Lfc_lg7: .double 1.479819860511658591e-01\n");
    // log's subnormal prescale. A subnormal stores exponent 0 — its magnitude
    // is in the mantissa's leading zeros — so the reduction x = 2^k*m has to
    // scale it into the normal range first and take the 54 back off k.
    s = s.write(".Lfc_two54: .double 1.80143985094819840000e+16\n");
    s = s.write(".Lfc_minnorm: .double 2.2250738585072014e-308\n");
    s = s.write(".Lfc_expovf: .double 709.782712893383973096\n");
    s = s.write(".Lfc_expunf: .double -745.133219101941108420\n");
    s = s.write("    .text\n");
    // __fern_rem_pio2_large(d0 = x, |x| >= 2^20 and finite) -> x10 = k&3,
    // d0 = r. Payne-Hanek: multiplies the significand by the window of 2/pi
    // its exponent selects, keeping 128 bits about the binary point — the top
    // two bits are the quadrant and the rest the fraction of x/(pi/2), which
    // stays fully accurate however large x is. Kept in lockstep with the
    // native arm64 backend's __fern_rem_pio2_large, register for register.
    // Wide masks load through the literal pool: the self-host assembler's
    // logical-immediate path parses 32-bit immediates, so a 52-bit bitmask
    // spelled `and #imm` is refused there — same discipline as this file's
    // other 64-bit constants.
    s = s.write("__fern_rem_pio2_large:\n");
    s = s.write("    fmov x1, d0\n");
    s = s.write("    lsr x2, x1, #63\n");        // sign of x
    s = s.write("    ubfx x3, x1, #52, #11\n");  // biased exponent
    s = s.write("    ldr x0, =0x000fffffffffffff\n");
    s = s.write("    and x4, x1, x0\n");
    s = s.write("    ldr x0, =0x0010000000000000\n");
    s = s.write("    orr x4, x4, x0\n"); // m, the 53-bit significand
    // x = m*2^(e-1075), so the fraction of x*(2/pi) starts at bit
    // (e-1075)+62 of the table once the product is read as a Q126.
    s = s.write("    sub x3, x3, #1013\n");
    s = s.write("    and x5, x3, #63\n");  // bit offset within the limb
    s = s.write("    lsr x3, x3, #6\n");   // limb index
    s = s.write("    adrp x17, .Lfc_2opi_bits\n");
    s = s.write("    add x17, x17, :lo12:.Lfc_2opi_bits\n");
    s = s.write("    add x17, x17, x3, lsl #3\n");
    s = s.write("    ldr x6, [x17]\n");
    s = s.write("    ldr x7, [x17, #8]\n");
    s = s.write("    ldr x1, [x17, #16]\n");
    s = s.write("    ldr x3, [x17, #24]\n");
    // Each 64-bit window is (T[i] << off) | (T[i+1] >> (64-off)). aarch64
    // has no variable EXTR, and lsrv masks its count mod 64, so the right
    // half is spelled as two shifts — a plain >> (64-off) is wrong at off 0.
    s = s.write("    mov x16, #63\n");
    s = s.write("    sub x16, x16, x5\n");
    s = s.write("    lsl x13, x6, x5\n    lsr x0, x7, #1\n    lsr x0, x0, x16\n    orr x13, x13, x0\n"); // w0
    s = s.write("    lsl x14, x7, x5\n    lsr x0, x1, #1\n    lsr x0, x0, x16\n    orr x14, x14, x0\n"); // w1
    s = s.write("    lsl x15, x1, x5\n    lsr x0, x3, #1\n    lsr x0, x0, x16\n    orr x15, x15, x0\n"); // w2
    // acc(128) = lo(m*w0)<<64 + m*w1 + hi(m*w2), i.e. x*(2/pi) as a Q126.
    s = s.write("    mul x7, x4, x13\n");
    s = s.write("    mul x1, x4, x14\n");
    s = s.write("    umulh x3, x4, x14\n");
    s = s.write("    umulh x6, x4, x15\n");
    s = s.write("    adds x1, x1, x6\n");
    s = s.write("    adc x7, x7, x3\n");
    s = s.write("    lsr x10, x7, #62\n"); // quadrant
    s = s.write("    ldr x16, =0x3fffffffffffffff\n");
    s = s.write("    and x7, x7, x16\n");
    // A fraction at or above a half belongs to the next quadrant, as the
    // negative remainder below it — which is what keeps |r| <= pi/4.
    s = s.write("    mov x0, xzr\n"); // frac is negative iff this becomes 1
    s = s.write("    ldr x16, =0x2000000000000000\n");
    s = s.write("    cmp x7, x16\n");
    s = s.write("    b.lo .Lph_pos\n");
    s = s.write("    add x10, x10, #1\n");
    s = s.write("    subs x1, xzr, x1\n"); // negs: sets the borrow sbc needs
    s = s.write("    ldr x6, =0x4000000000000000\n");
    s = s.write("    sbc x7, x6, x7\n");
    s = s.write("    mov x0, #1\n");
    s = s.write(".Lph_pos:\n");
    // >> 11 keeps the low word inside 53 bits so the conversion is exact,
    // matching the other backends bit for bit.
    s = s.write("    lsr x1, x1, #11\n");
    s = s.write("    scvtf d1, x7\n");
    s = emit_ldc(s, "d3", ".Lfc_2m62");
    s = s.write("    fmul d1, d1, d3\n");
    s = s.write("    scvtf d2, x1\n");
    s = emit_ldc(s, "d3", ".Lfc_2m115");
    s = s.write("    fmul d2, d2, d3\n");
    s = s.write("    fadd d1, d1, d2\n");
    s = s.write("    cmp x0, #0\n");
    s = s.write("    b.eq .Lph_nn\n");
    s = s.write("    fneg d1, d1\n");
    s = s.write(".Lph_nn:\n");
    s = s.write("    cmp x2, #0\n");
    s = s.write("    b.eq .Lph_sgn\n");
    s = s.write("    fneg d1, d1\n");
    s = s.write("    neg x10, x10\n");
    s = s.write(".Lph_sgn:\n");
    s = s.write("    and x10, x10, #3\n");
    s = emit_ldc(s, "d3", ".Lfc_pio2hi");
    s = s.write("    fmul d0, d1, d3\n");
    s = emit_ldc(s, "d3", ".Lfc_pio2lo");
    s = s.write("    fmul d1, d1, d3\n");
    s = s.write("    fadd d0, d0, d1\n");
    s = s.write("    ret\n");
    // __fern_ksin(d0=r, |r| <= pi/4) -> sin r. Internal: sin and cos both
    // reach it after reduction, so the kernel exists once.
    s = s.write("__fern_ksin:\n");
    s = s.write("    fmul d1, d0, d0\n");
    s = s.write("    fmul d2, d1, d0\n");
    s = emit_ldc(s, "d3", ".Lfc_s6");
    s = emit_ldc(s, "d20", ".Lfc_s5");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s4");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s3");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s2");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_s1");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = s.write("    fmul d3, d3, d2\n");
    s = s.write("    fadd d0, d0, d3\n");
    s = s.write("    ret\n");
    // __fern_kcos(d0=r, |r| <= pi/4) -> cos r. The (1-w)-hz rewrite recovers the
    // bits 1-hz discards; computing 1 - hz + z*z*p directly costs ~2 ulp.
    s = s.write("__fern_kcos:\n");
    s = s.write("    fmul d1, d0, d0\n");
    s = emit_ldc(s, "d3", ".Lfc_c6");
    s = emit_ldc(s, "d20", ".Lfc_c5");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c4");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c3");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c2");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = emit_ldc(s, "d20", ".Lfc_c1");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fadd d3, d3, d20\n");
    s = s.write("    fmul d3, d3, d1\n");
    s = s.write("    fmul d3, d3, d1\n");
    s = emit_ldc(s, "d5", ".Lfc_half");
    s = s.write("    fmul d4, d1, d5\n");
    s = emit_ldc(s, "d5", ".Lfc_one");
    s = s.write("    fsub d6, d5, d4\n");
    s = s.write("    fsub d7, d5, d6\n");
    s = s.write("    fsub d7, d7, d4\n");
    s = s.write("    fadd d7, d7, d3\n");
    s = s.write("    fadd d0, d6, d7\n");
