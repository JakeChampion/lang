        s = s.write("    ldr x0, [x21, x9, lsl #3]\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_eq\n    add sp, sp, #32\n");
        s = s.write("    cbnz x0, .Lmh_yes\n");
        s = s.write("    add x22, x22, #1\n");
