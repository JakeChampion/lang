// examples/self_host/fern_toml.fern — a fern.toml / fern.lock reader for
// the self-hosted compiler's module loader, mirroring the native
// internal/manifest + internal/mvs for the DISK-resolvable dependency
// forms.
//
// Covered: [package] name/lib; [dependencies] `path`, `workspace = true`,
// and `version` (bare "1.2.0" or { version = "…" }) deps; [workspace]
// members; and fern.lock `[[package]]` entries with a `path` source. All
// of these resolve from disk with no network or cache lookup.
//
// Covered since #4949: url+hash deps, and versioned deps whose lock
// source is a `url` — both parse to their `sha256:<hex>` hash here, and
// the loader (modloader.load_from_store) resolves them from the
// per-machine content-addressed store via the `env` runtime builtin
// (read-only; population + verification stay `fern -fetch`).
//
// Uses only the self-host emitter's subset (string index/slice/len/
// append, ==, match, Option, while, structs), so it compiles with either
// compiler. Additive: the loader consults it only when a fern.toml /
// fern.lock is present, so a manifest-less build (every current compiler
// source) is byte-for-byte unchanged.

// Dep is one declared dependency. `kind` tags the form the loader must
// resolve: "path" (dir given by `path`), "workspace" (a sibling
// workspace member, located by name), "version" (an MVS dependency
// resolved through fern.lock — `path` unused, the lock pins the source),
// or "url" (a url+hash dep resolved from the per-machine content-
// addressed store by `hash` — the loader never touches the network;
// #4949). `hash` is the manifest's `sha256:<hex>` for a url dep, ""
// otherwise.
//
// `governed` records whether the entry carried a `capabilities` key at
// all, which is a different question from what `caps` holds: an empty
// grant list (`capabilities = []`) denies everything, while no key at
// all is warn-and-allow (docs/PACKAGE-CAPABILITIES-BRIEF.md, #6634).
pub struct Dep {
    name: string,
    kind: string,
    path: string,
    hash: string,
    version: string,
    governed: boolean,
    caps: string[],
}

// Manifest is the subset the loader reads: the [package] name + lib
// module (empty lib ⇒ default "lib.fern"), the declared dependencies,
// and the [workspace] members list (empty ⇒ not a workspace).
//
// `index` is the [package] index path — the version authority MVS resolves
// versioned dependencies against (empty ⇒ none). `excl_pkg` / `excl_ver`
// are the [exclude] table as parallel arrays, one pair per banned version;
// only the ROOT manifest's excludes reach resolution, which is what keeps
// it deterministic.
pub struct Manifest {
    name: string,
    lib: string,
    index: string,
    deps: Dep[],
    members: string[],
    excl_pkg: string[],
    excl_ver: string[],
}

// trim strips leading and trailing ASCII spaces and tabs.
function trim(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && (s[a] == 32 || s[a] == 9)) { a = a + 1; }
    while (b > a && (s[b - 1] == 32 || s[b - 1] == 9)) { b = b - 1; }
    return s[a:b] + "";
}

// index_of returns the first index of the single-char needle `c` in `s`
// at or after `from`, or -1.
function index_of(s: string, c: i32, from: i32): i32 {
    var i: i32 = from;
    while (i < s.len()) {
        if ((s[i] as i32) == c) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// index_of_str returns the first index of substring `sub` in `s`, or -1.
function index_of_str(s: string, sub: string): i32 {
    if (sub.len() == 0) { return 0; }
    var i: i32 = 0;
    while (i + sub.len() <= s.len()) {
        if (s[i:i + sub.len()] == sub) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// quoted_value extracts the first double-quoted string's contents that
// appears at or after `from` in `s`, or None.
function quoted_value(s: string, from: i32): Option[string] {
    var q1: i32 = index_of(s, 34, from);   // '"'
    if (q1 < 0) { return None; }
    var q2: i32 = index_of(s, 34, q1 + 1);
    if (q2 < 0) { return None; }
    return Some(s[q1 + 1:q2] + "");
}

// split_lines splits `src` on '\n'.
function split_lines(src: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < src.len()) {
        if (src[i] == 10) {   // '\n'
            out = out.append(src[start:i] + "");
            start = i + 1;
        }
        i = i + 1;
    }
    out = out.append(src[start:src.len()] + "");
    return out;
}

// parse reads a fern.toml source into a Manifest: the [package] lib key
// and every [dependencies] `name = { path = "..." }` entry. Non-path
// dependency forms (url/workspace/version) are skipped here — the loader
// handles those natively or falls back to on-disk resolution.
pub function parse(src: string): Manifest {
    var name: string = "";
    var lib: string = "lib.fern";
    var index: string = "";
    var deps: Dep[] = [];
    var members: string[] = [];
    var excl_pkg: string[] = [];
    var excl_ver: string[] = [];
    var section: string = "";
    var lines: string[] = split_lines(src);
    var li: i32 = 0;
    while (li < lines.len()) {
        var line: string = trim(lines[li]);
        li = li + 1;
        if (line.len() == 0) { continue; }
        if (line[0] == 35) { continue; }        // '#' comment
        if (line[0] == 91) {                     // '[' section header
            var close: i32 = index_of(line, 93, 0);   // ']'
            if (close > 0) { section = line[1:close] + ""; }
            continue;
        }
        var eq: i32 = index_of(line, 61, 0);     // '='
        if (eq < 0) { continue; }
        var key: string = trim(line[0:eq]);
        var val: string = trim(line[eq + 1:line.len()]);
        if (section == "package") {
            if (key == "name") {
                match (quoted_value(val, 0)) { Some(v) => { name = v; }, None => { } }
            }
            if (key == "lib") {
                match (quoted_value(val, 0)) { Some(v) => { lib = v; }, None => { } }
            }
            if (key == "index") {
                match (quoted_value(val, 0)) { Some(v) => { index = v; }, None => { } }
            }
            continue;
        }
        if (section == "workspace") {
            if (key == "members") { members = parse_str_array(val); }
            continue;
        }
        if (section == "exclude") {
            var banned: string[] = parse_str_array(val);
            var bi: i32 = 0;
            while (bi < banned.len()) {
                excl_pkg = excl_pkg.append(key + "");
                excl_ver = excl_ver.append(banned[bi] + "");
                bi = bi + 1;
            }
            continue;
        }
        if (section == "dependencies") {
            deps = deps.append(parse_dep(key, val));
        }
    }
    return Manifest {
        name: name, lib: lib, index: index, deps: deps, members: members,
        excl_pkg: excl_pkg, excl_ver: excl_ver,
    };
}

// parse_dep classifies a dependency value line into a Dep. A bare quoted
// string ("1.2.0") or `{ version = "..." }` is a version dep; an inline
// table with `workspace = true` is a workspace dep; one with `path = "..."`
// is a path dep. Anything else (url/hash) parses to kind "" (native-only;
// the loader falls back to on-disk resolution).
function parse_dep(name: string, val: string): Dep {
    var governed: boolean = false;
    var caps: string[] = [];
    var cp: i32 = index_of_str(val, "capabilities");
    if (cp >= 0) {
        var open: i32 = index_of(val, 91, cp);    // '[' after the key
        if (open >= 0) {
            var close: i32 = index_of(val, 93, open);   // ']'
            if (close > open) {
                governed = true;
                caps = parse_str_array(val[open:close] + "");
            }
        }
    }
    // Bare quoted string ⇒ version dep.
    if (val.len() > 0 && val[0] == 34) {   // '"'
        var bare: string = "";
        match (quoted_value(val, 0)) { Some(v) => { bare = v; }, None => { } }
        return Dep { name: name, kind: "version", path: "", hash: "", version: bare, governed: governed, caps: caps };
    }
    if (index_of_str(val, "workspace") >= 0 && index_of_str(val, "true") >= 0) {
        return Dep { name: name, kind: "workspace", path: "", hash: "", version: "", governed: governed, caps: caps };
    }
    // url+hash dep: `{ url = "https://…", hash = "sha256:…" }` (#4949).
    // Checked before the `version`/`path` substring probes because a URL
    // VALUE can contain either word (".../versions/x.tar.gz"); requiring
    // the `hash` key + a sha256-prefixed value keeps a stray "url" inside
    // a path value from misclassifying (that value has no hash key).
    var up: i32 = index_of_str(val, "url");
    var hp: i32 = index_of_str(val, "hash");
    if (up >= 0 && hp >= 0) {
        var heq: i32 = index_of(val, 61, hp);   // '=' after hash
        if (heq >= 0) {
            match (quoted_value(val, heq)) {
                Some(hv) => {
                    if (hv.len() >= 8 && hv[0:7] == "sha256:") {
                        return Dep { name: name, kind: "url", path: "", hash: hv, version: "", governed: governed, caps: caps };
                    }
                },
                None => { },
            }
        }
    }
    var vp: i32 = index_of_str(val, "version");
    if (vp >= 0) {
        var veq: i32 = index_of(val, 61, vp);   // '=' after version
        var vv: string = "";
        if (veq >= 0) {
            match (quoted_value(val, veq)) { Some(v) => { vv = v; }, None => { } }
        }
        return Dep { name: name, kind: "version", path: "", hash: "", version: vv, governed: governed, caps: caps };
    }
    var p: i32 = index_of_str(val, "path");
    if (p >= 0) {
        var eq2: i32 = index_of(val, 61, p);   // '=' after path
        if (eq2 >= 0) {
            match (quoted_value(val, eq2)) {
                Some(pv) => { return Dep { name: name, kind: "path", path: pv, hash: "", version: "", governed: governed, caps: caps }; },
                None => { },
            }
        }
    }
    return Dep { name: name, kind: "", path: "", hash: "", version: "", governed: governed, caps: caps };   // unrecognised form
}

// parse_str_array parses a single-line inline array of quoted strings:
// `["a", "b/c"]` → ["a", "b/c"].
function parse_str_array(val: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < val.len()) {
        if (val[i] == 34) {   // '"'
            var j: i32 = index_of(val, 34, i + 1);
            if (j < 0) { return out; }
            out = out.append(val[i + 1:j] + "");
            i = j + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

// dep_path returns the declared PATH of a path dependency `name`, or
// None. Iterates m.deps directly (no Option[Dep] intermediary): a struct-
// payload Option (Some(dep)) is outside the self-host IR emitter's lowered
// subset, so returning the primitive Option[string] keeps this module
// per-module-IR-eligible.
pub function dep_path(m: Manifest, name: string): Option[string] {
    var i: i32 = 0;
    while (i < m.deps.len()) {
        if (m.deps[i].name == name && m.deps[i].kind == "path") {
            return Some(m.deps[i].path + "");
        }
        i = i + 1;
    }
    return None;
}

// dep_kind returns the kind of dependency `name` ("path"/"workspace"/
// "version"/""), or "" when undeclared. Iterates m.deps directly (see
// dep_path on why no Option[Dep] intermediary).
pub function dep_kind(m: Manifest, name: string): string {
    var i: i32 = 0;
    while (i < m.deps.len()) {
        if (m.deps[i].name == name) { return m.deps[i].kind + ""; }
        i = i + 1;
    }
    return "";
}

// dep_names lists every declared dependency, in manifest order.
pub function dep_names(m: Manifest): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < m.deps.len()) {
        out = out.append(m.deps[i].name + "");
        i = i + 1;
    }
    return out;
}

// dep_governed reports whether dependency `name`'s entry carries a
// `capabilities` key — the question that decides whether reaching outside
// the grant is an error or a warning (#6634).
pub function dep_governed(m: Manifest, name: string): boolean {
    var i: i32 = 0;
    while (i < m.deps.len()) {
        if (m.deps[i].name == name) { return m.deps[i].governed; }
        i = i + 1;
    }
    return false;
}

// dep_caps returns the capabilities granted to dependency `name`, empty
// when undeclared or ungoverned. Same primitive-return shape as dep_kind.
pub function dep_caps(m: Manifest, name: string): string[] {
    var i: i32 = 0;
    while (i < m.deps.len()) {
        if (m.deps[i].name == name) { return m.deps[i].caps; }
        i = i + 1;
    }
    var empty: string[] = [];
    return empty;
}

// dep_hash returns the `sha256:<hex>` hash of a url dependency `name`,
// or None (undeclared, or not a url dep). Same primitive-Option shape as
// dep_path.
pub function dep_hash(m: Manifest, name: string): Option[string] {
    var i: i32 = 0;
    while (i < m.deps.len()) {
        if (m.deps[i].name == name && m.deps[i].kind == "url" && m.deps[i].hash.len() > 0) {
            return Some(m.deps[i].hash + "");
        }
        i = i + 1;
    }
    return None;
}

// LockEntry is one resolved dependency from fern.lock: the package name
// plus, for a `path`-sourced version, its directory, and for a
// `url`-sourced version, its `sha256:<hex>` hash — resolved from the
// per-machine content-addressed store (#4949).
pub struct LockEntry {
    name: string,
    path: string,
    hash: string,
}

// parse_lock reads a fern.lock's `[[package]]` entries, keeping the name
// plus the `path` directory (path-sourced) or the `hash` (url-sourced).
pub function parse_lock(src: string): LockEntry[] {
    var out: LockEntry[] = [];
    var name: string = "";
    var path: string = "";
    var hash: string = "";
    var have: boolean = false;
    var lines: string[] = split_lines(src);
    var li: i32 = 0;
    while (li < lines.len()) {
        var line: string = trim(lines[li]);
        li = li + 1;
        if (line.len() == 0) { continue; }
        if (line[0] == 35) { continue; }              // '#'
        if (line == "[[package]]") {
            if (have) { out = out.append(LockEntry { name: name, path: path, hash: hash }); }
            name = "";
            path = "";
            hash = "";
            have = true;
            continue;
        }
        var eq: i32 = index_of(line, 61, 0);          // '='
        if (eq < 0) { continue; }
        var key: string = trim(line[0:eq]);
        var val: string = trim(line[eq + 1:line.len()]);
        if (key == "name") {
            match (quoted_value(val, 0)) { Some(v) => { name = v; }, None => { } }
        }
        if (key == "path") {
            match (quoted_value(val, 0)) { Some(v) => { path = v; }, None => { } }
        }
        if (key == "hash") {
            match (quoted_value(val, 0)) { Some(v) => { hash = v; }, None => { } }
        }
    }
    if (have) { out = out.append(LockEntry { name: name, path: path, hash: hash }); }
    return out;
}

// lock_path_of returns the resolved directory of a `path`-sourced locked
// dependency `name`, or None (undeclared, or a url source the self-host
// can't reach).
pub function lock_path_of(entries: LockEntry[], name: string): Option[string] {
    var i: i32 = 0;
    while (i < entries.len()) {
        if (entries[i].name == name && entries[i].path.len() > 0) {
            return Some(entries[i].path + "");
        }
        i = i + 1;
    }
    return None;
}

// lock_hash_of returns the `sha256:<hex>` hash of a url-sourced locked
// dependency `name`, or None — the store-resolution counterpart of
// lock_path_of (#4949).
pub function lock_hash_of(entries: LockEntry[], name: string): Option[string] {
    var i: i32 = 0;
    while (i < entries.len()) {
        if (entries[i].name == name && entries[i].hash.len() > 0) {
            return Some(entries[i].hash + "");
        }
        i = i + 1;
    }
    return None;
}
