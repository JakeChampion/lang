// examples/self_host/ssa_lift_irlower_run.fern — the production-shaped driver
// for the stack-IR -> SSA lift: it reads a Fern SOURCE on stdin and lowers it
// the way the real compiler does — AST -> ir.Op[] via `irlower.lower_func_for`
// (the same per-function lowering the asm_ir backend consumes) — then LIFTS
// that real IR to SSA (`ssa_lift.lift_from_ir`), optimises it, and emits
// x86-64 / arm64 via the existing SSA backends. Where ssa_lift_emit_run drives
// hand-built ir.Op[], this drives the ACTUAL irlower output, closing the loop
// toward the lift becoming a real lowering path (not a proof-of-concept over
// synthetic ops).
//
// Out-of-subset programs (anything whose lowered IR uses an op the lift doesn't
// handle yet — heap / strings / structs / floats / RC) make lift_from_ir return
// ok=false; the driver exits non-zero so the Go gate only asserts in-subset
// programs (its differential oracle is the interpreter).
//
// `-target arm64-linux` selects the backend; `-regalloc` the linear-scan allocator.

import "std/io";
import "./lexer";
import "./parser";
import "./ssa";
import "./ssa_x86";
import "./ssa_arm64";
import "./irlower";
import "./ssa_lift";

function main(): i32 {
    var av: string[] = args();
    var target: string = "x86-64-linux";
    var use_regalloc: boolean = false;
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-regalloc") { use_regalloc = true; }
        else if (av[ai] == "-target") { ai = ai + 1; if (ai < av.len()) { target = av[ai]; } }
        ai = ai + 1;
    }

    var mod: parser.Module = parser.parse_module(lexer.tokenize(io.read_all_stdin()));
    mod = parser.fill_default_args_module(mod);
    // Hoist inline lambdas to top-level `<fn>$clo(__env, params…)` functions
    // (irlower's env-FIRST closure ABI), exactly as the production asm_ir path
    // does — otherwise a `const_func` referencing a lambda would dangle, since
    // the per-function loop below only lowers what is in `mod.funcs`.
    mod = irlower.lift_lambdas(mod);

    var empty: string[] = [];
    var funcs: ssa.SFunc[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fn: parser.FuncDecl = mod.funcs[i];
        // Real per-function lowering: AST -> ir.Op[] (the asm_ir backend's input).
        var lr: irlower.LowerResult = irlower.lower_func_for(fn, [], mod.structs, mod.funcs);
        // Bails are LOUD (#5452): a silent exit 3/4 gave the harness nothing
        // to compare when a driver behaves differently across environments —
        // the failure message now names the function and the bail reason.
        if (!lr.ok) { eprint("ssa_lift_irlower: irlower bail in " + fn.name + "\n"); return 3; }
        // Lift the real IR to SSA. nslots = params + declared locals.
        var lf: ssa_lift.LResult = ssa_lift.lift_from_ir(ssa.fn_sym(fn), lr.n_params, lr.n_params + lr.n_locals, lr.ops, mod.structs);
        if (!lf.ok) { eprint("ssa_lift_irlower: lift bail in " + fn.name + ": " + lf.bail + "\n"); return 4; }
        funcs = funcs.append(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(lf.func, empty), empty)));
        i = i + 1;
    }

    // The lift emits calls to the pure-Fern runtime helpers (__ssa_arr_push /
    // __ssa_arr_slice) for the array-append / slice ops — the same helpers
    // build_func's `.append` / `a[lo:hi]` lowerings call. They are NOT lifted
    // (they use __new_array, a build_func-only intrinsic irlower never emits), so
    // build them the way ssa_emit_run does: parse ssa_helpers_src, and for each
    // helper the lifted program actually calls, build_func_seeded + append it.
    // Built on the same low bump heap (empty ptr_ret keeps 32-bit pointers, one
    // memory model with the lifted code).
    //
    // Gate the whole block on a cheap pre-scan: parsing ssa_helpers_src is a big
    // bump-heap allocation, and doing it unconditionally starves emit_program of
    // arena for heavier programs (a composite + branch merge segfaulted). Only a
    // program that actually appends / slices needs the helpers, so skip the parse
    // entirely otherwise — restoring the original heap headroom for every
    // non-append program.
    if (ssa.calls_func(funcs, "__ssa_arr_push") || ssa.calls_func(funcs, "__ssa_arr_slice")) {
        var hmod: parser.Module = parser.parse_module(lexer.tokenize(ssa.ssa_helpers_src()));
        var hseed: ssa.Seed = ssa.build_seed(mod.funcs);
        var hi: i32 = 0;
        while (hi < hmod.funcs.len()) {
            if (ssa.calls_func(funcs, hmod.funcs[hi].name)) {
                var hr: ssa.BResult = ssa.build_func_seeded(hmod.funcs[hi], mod.structs, hseed);
                if (hr.ok) { funcs = funcs.append(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(hr.func, empty), empty))); }
            }
            hi = hi + 1;
        }
    }

    if (target == "arm64-linux") { write(ssa_arm64.emit_program(funcs, use_regalloc)); }
    else { write(ssa_x86.emit_program(funcs, use_regalloc)); }
    return 0;
}
