// examples/self_host/ir_kind_run.fern — round-trip driver for the integer
// op-kind registry (ir.fern's kind_id / kind_name, issue #4394 lever 2).
//
// It walks the WHOLE registry (ids 1..kind_count(), plus the named extension
// tags beyond it) and asserts the id<->name bijection —
// kind_id(kind_name(id)) == id and kind_name(id) is never the "invalid"
// sentinel — so a new op kind added to one direction but not the other (or a
// duplicate id) fails here rather than silently miscompiling a backend once
// the int tag is wired. Those two sweeps between them name every tag kind_id
// knows, so the round trip is EXHAUSTIVE, not a sample. It also pins the
// KIND_INVALID contract (unknown tag -> 0, out-of-range / 0 id -> "invalid"),
// a negative sweep over near-miss tags that probes kind_id's (length, first
// byte) narrowing from the other side, and the int-keyed classifier predicates
// (is_const_kind / is_terminator_kind / is_foldable_binary_kind /
// is_commutative_kind), and ends with every registered tag's id so the golden
// pins the numbering itself.
//
// The companion Go test (internal/e2eselfhost/self_host_ir_kind_test.go)
// asserts the exact stdout (the id table against testdata/ir-kind-ids.txt)
// and an exit code of 0 (zero bijection failures), pinning the registry
// end-to-end through the self-host -> native pipeline (proving the registry
// compiles + round-trips, not just type-checks).

import "./ir";
import "./util";

function b2s(b: boolean): string {
    if (b) { return "1"; }
    return "0";
}

function main(): i32 {
    var n: i32 = ir.kind_count();

    // 1. Full-table bijection sweep. Every id in 1..n must render to a
    //    non-"invalid" tag that maps back to the same id.
    var failures: i32 = 0;
    var ok: i32 = 0;
    var id: i32 = 1;
    while (id <= n) {
        var name: string = ir.kind_name(id);
        var back: i32 = ir.kind_id(name);
        if (name == "invalid" || back != id) {
            failures = failures + 1;
        } else {
            ok = ok + 1;
        }
        id = id + 1;
    }

    // 1b. Extension-tag sweep — the registered ids BEYOND kind_count()
    //     (struct_copy=198 … lstat=236). Each must sit past
    //     the dense table and round-trip through kind_name, so a tag reachable
    //     from kind_id but unrendered by kind_name (the #5452 skew, which made
    //     ssa_lift's struct_copy bail read "invalid") fails here.
    //
    //     Adding an extension tag means adding it HERE too: `oob` below probes
    //     ext_max + 1, so an unregistered tag silently becomes the
    //     "past every registered id" probe and reports its own name where the
    //     invalid sentinel belongs.
    var ext_names: string[] = [
        "struct_copy", "store_i64", "tcp_listen", "tcp_accept", "writer_write",
        "open_file", "syscall3", "raw_scratch", "syscall4", "raw_environ",
        "udp_send", "read_all_stdin", "arg_at", "proc_fork", "proc_waitpid",
        "proc_exec", "arr_push_shared_count",
        "arr_push_shared_bytes", "const_struct", "clz", "ctz", "popcount",
        "map_hash_seed", "raw_addr", "raw_arr_box", "memchr",
        "write_file_exec", "ascii_run", "syscall5", "heap_mark",
        "heap_release_to", "create_dir_all", "isatty", "read_file_bytes",
        "rmemchr", "count_byte", "lstat"
    ];
    var ext_max: i32 = n;
    var ext_ok: i32 = 0;
    var ext_failures: i32 = 0;
    var ei: i32 = 0;
    while (ei < ext_names.len()) {
        var eid: i32 = ir.kind_id(ext_names[ei]);
        if (eid > ext_max) { ext_max = eid; }
        if (eid <= n || ir.kind_name(eid) != ext_names[ei]) { ext_failures = ext_failures + 1; }
        else { ext_ok = ext_ok + 1; }
        ei = ei + 1;
    }

    var out: string = "";
    out = out + "kind_count=" + util.i32_to_string(n) + "\n";
    out = out + "bijection_ok=" + util.i32_to_string(ok) + "\n";
    out = out + "bijection_failures=" + util.i32_to_string(failures) + "\n";
    out = out + "ext_ok=" + util.i32_to_string(ext_ok) + "\n";
    out = out + "ext_failures=" + util.i32_to_string(ext_failures) + "\n";

    // 1c. Negative sweep. kind_id narrows on the tag's (length, first byte)
    //     before it compares a string (#8258), so "returns 0" has to be proved
    //     against tags that pass one guard and fail the other: a near miss
    //     inside a populated bucket ("adz" against add/and, "fadz" against the
    //     twelve four-byte f-ops), a first byte no bucket of that length has
    //     ("zadd"), a real tag one byte short or long ("call_direc",
    //     "call_directt"), a length no tag has at all (17 and 20 bytes, which
    //     no kind_id_lenN owns), the empty string, and a one-byte tag. Every
    //     one of them must be KIND_INVALID.
    var neg_names: string[] = [
        "", "a", "adz", "fadz", "zadd", "or_", "brif_", "call_direc",
        "tcp_connecx", "call_directt", "arr_push_shared_bytez",
        "aaaaaaaaaaaaaaaaa", "aaaaaaaaaaaaaaaaaaaa", "ADD"
    ];
    var neg_ok: i32 = 0;
    var neg_failures: i32 = 0;
    var ni: i32 = 0;
    while (ni < neg_names.len()) {
        if (ir.kind_id(neg_names[ni]) == 0) { neg_ok = neg_ok + 1; }
        else { neg_failures = neg_failures + 1; }
        ni = ni + 1;
    }
    out = out + "neg_ok=" + util.i32_to_string(neg_ok) + "\n";
    out = out + "neg_failures=" + util.i32_to_string(neg_failures) + "\n";

    // 2. KIND_INVALID contract: unknown tag -> 0, and 0 / past-every-
    //    registered-id (extension tags included) -> the "invalid" sentinel.
    out = out + "unknown_id=" + util.i32_to_string(ir.kind_id("not_an_op_kind")) + "\n";
    out = out + "id0=" + ir.kind_name(0) + "\n";
    out = out + "oob=" + ir.kind_name(ext_max + 1) + "\n";

    // 3. Spot-check a few tags round-trip to the right names (locks the actual
    //    ids down for the golden, so a reorder that still bijects is visible).
    out = out + "const_i32=" + util.i32_to_string(ir.kind_id("const_i32")) + "\n";
    out = out + "add=" + util.i32_to_string(ir.kind_id("add")) + "\n";
    out = out + "call_direct=" + util.i32_to_string(ir.kind_id("call_direct")) + "\n";
    out = out + "return=" + util.i32_to_string(ir.kind_id("return")) + "\n";

    // 4. int-keyed classifier predicates.
    out = out + "is_const const_i32=" + b2s(ir.is_const_kind(ir.kind_id("const_i32")))
        + " const_str=" + b2s(ir.is_const_kind(ir.kind_id("const_str")))
        + " add=" + b2s(ir.is_const_kind(ir.kind_id("add"))) + "\n";
    out = out + "is_term return=" + b2s(ir.is_terminator_kind(ir.kind_id("return")))
        + " br=" + b2s(ir.is_terminator_kind(ir.kind_id("br")))
        + " exit=" + b2s(ir.is_terminator_kind(ir.kind_id("exit")))
        + " brif=" + b2s(ir.is_terminator_kind(ir.kind_id("brif"))) + "\n";
    out = out + "is_fold add=" + b2s(ir.is_foldable_binary_kind(ir.kind_id("add")))
        + " div_s=" + b2s(ir.is_foldable_binary_kind(ir.kind_id("div_s")))
        + " ge_s=" + b2s(ir.is_foldable_binary_kind(ir.kind_id("ge_s")))
        + " fadd=" + b2s(ir.is_foldable_binary_kind(ir.kind_id("fadd"))) + "\n";
    out = out + "is_commute add=" + b2s(ir.is_commutative_kind(ir.kind_id("add")))
        + " xor=" + b2s(ir.is_commutative_kind(ir.kind_id("xor")))
        + " sub=" + b2s(ir.is_commutative_kind(ir.kind_id("sub")))
        + " shl=" + b2s(ir.is_commutative_kind(ir.kind_id("shl"))) + "\n";

    // 5. Constructor-baked kind_tag consistency. Op no longer carries a string
    //    kind — every constructor stamps only a kind_tag (a baked literal id
    //    for the fixed-kind ops, kind_id(kind) for the variable-kind ones), and
    //    all backends dispatch on it. Assert each constructor bakes the tag its
    //    name maps to (kind_tag == kind_id(EXPECTED)) across a representative
    //    spread — a wrong literal or a registry reorder desyncs this and fails
    //    here rather than silently misdispatching a backend.
    var probe: ir.Op[] = [
        ir.op_const_i32(42), ir.op_const_str("x"), ir.op_load_local(0),
        ir.op_store_local(0), ir.op_tee_local(0), ir.op_bin("add", 0, false),
        ir.op_bin("ge_u", 0, true), ir.op_fbin("fadd"), ir.op_funary("fsqrt"),
        ir.op_load(ir.width_ptr()), ir.op_store(ir.width_ptr()), ir.op_alloc(),
        ir.op_arr_make(2, 0), ir.op_str_concat(), ir.op_map_len(),
        ir.op_struct_make("S", 1, 0 - 1), ir.op_call_direct("f", 1), ir.op_if(0),
        ir.op_br(1), ir.op_drop(), ir.op_return(),
        ir.op_clz(32), ir.op_ctz(64), ir.op_popcount(32),
        ir.op_map_hash_seed(), ir.op_raw_addr(), ir.op_raw_arr_box(),
        ir.op_memchr(), ir.op_write_file_exec(), ir.op_ascii_run(),
        ir.op_syscall5(), ir.op_create_dir_all(), ir.op_isatty(),
        ir.op_rmemchr(), ir.op_count_byte(), ir.op_lstat()
    ];
    var names: string[] = [
        "const_i32", "const_str", "load_local",
        "store_local", "tee_local", "add",
        "ge_u", "fadd", "fsqrt",
        "load", "store", "alloc",
        "arr_make", "str_concat", "map_len",
        "struct_make", "call_direct", "if",
        "br", "drop", "return",
        "clz", "ctz", "popcount",
        "map_hash_seed", "raw_addr", "raw_arr_box",
        "memchr", "write_file_exec", "ascii_run", "syscall5",
        "create_dir_all", "isatty", "rmemchr", "count_byte", "lstat"
    ];
    var tag_ok: i32 = 0;
    var tag_bad: i32 = 0;
    var j: i32 = 0;
    while (j < probe.len()) {
        if (probe[j].kind_tag == ir.kind_id(names[j])) { tag_ok = tag_ok + 1; }
        else { tag_bad = tag_bad + 1; }
        j = j + 1;
    }
    out = out + "tag_consistency ok=" + util.i32_to_string(tag_ok)
        + " bad=" + util.i32_to_string(tag_bad) + "\n";

    // 6. Every registered tag's id, in id order (the golden pins the whole
    //    table, not a spot-check: the backends dispatch on literal ids, so a
    //    renumbering that still bijects is a miscompile).
    var tid: i32 = 1;
    while (tid <= ext_max) {
        var tname: string = ir.kind_name(tid);
        if (tname != "invalid") {
            out = out + tname + "=" + util.i32_to_string(ir.kind_id(tname)) + "\n";
        }
        tid = tid + 1;
    }

    // Every line above already carries its own trailing "\n", so emit the
    // accumulated buffer with `write` (no extra newline) rather than `print`.
    write(out);

    // Exit code is the total failure count (bijection + extension sweep +
    // negative sweep + tag consistency): 0 on a clean sweep.
    return failures + ext_failures + neg_failures + tag_bad;
}
