// Ownership inference: which of a function's reference parameters it CONSUMES.
//
// A consumed parameter is counted — the caller hands over a unit and the
// callee releases it, so a reader reclaims its argument when it holds the last
// reference. A parameter the frame only reads stays borrowed, because the
// retain and the release would cancel: a balanced pair on a value that cannot
// outlive the call moves rc traffic and nothing else. This is Koka's borrow
// inference and native's `paramVerdict` ladder
// (docs/OWNERSHIP-INFERENCE-PLAN.md, sub-slice 2d).
//
// Both halves are needed together. Counting every reference parameter with no
// inference is slower on nine of the twenty-nine bench programs and faster on
// none — 1.901x on `ordmap_insert`, 1.079x on `enum_match`, whose `weigh`
// never lets its argument leave the frame
// (docs/rc-log/2026-09-21-owned-by-default-alone-is-a-regression.md).
//
// The analysis reads the PRODUCED graphs rather than the declarations.
// `semsource` never branches on a parameter's mode while it builds a body — it
// appends the mode and hands it back untouched — so the graph is the same
// whichever answer this reaches, and an escape is far easier to see on the
// typed IR than on the AST.
//
// The least fixpoint starts parameters lent and counts the uses that carry
// them out. Read-only call cycles stay lent. A constructor-tail loop also
// counts the parameter it advances through: releasing each visited cell
// lets the next output allocation recycle it instead of retaining the whole
// input until the call returns. The typed loop's phis and hole operations
// identify that case without changing unrelated read-only parameters.
import "./ssa";
import "./ssasem";
import "./util";

// One row per produced symbol: whether each parameter leaves the frame.
// `lends` says a slot the row leaves uncounted may still be kept as a borrow in
// what the callee returns (lent_values); a builtin whose result holds no
// reference cannot keep one.
pub struct Escapes { name: string, bits: boolean[], lends: boolean }

// Rows by name, chained per hash bucket in ascending row order. A round
// rewrites a row's bits and never its name, so one index built over the
// finished rows serves every round.
pub struct Index { head: i32[], next: i32[] }

pub function index(rows: Escapes[]): Index {
  var nb: i32 = rows.len() * 2 + 1;
  var head: i32[] = [];
  while (head.len() < nb) {
    head = head.append(0 - 1);
  }
  var next: i32[] = [];
  while (next.len() < rows.len()) {
    next = next.append(0 - 1);
  }
  var k: i32 = rows.len() - 1;
  while (k >= 0) {
    var b: i32 = util.hash_bucket(rows[k].name, nb);
    next = next.with(k, head[b]);
    head = head.with(b, k);
    k = k - 1;
  }
  return Index { head: head, next: next };
}

// The first row named `name`, or -1.
pub function find(rows: Escapes[], ix: Index, name: string): i32 {
  var i: i32 = ix.head[util.hash_bucket(name, ix.head.len())];
  while (i >= 0) {
    if (rows[i].name == name) {
      return i;
    }
    i = ix.next[i];
  }
  return 0 - 1;
}

// Whether parameter `at` of `name` is consumed, for the ANALYSIS: a symbol
// with no row — a template, a body this boundary declined, a closure — answers
// "yes", so an operand handed to one is read as leaving the frame. A builtin
// has a fixed row, its contract's own modes. That is the conservative direction here, and only here: a caller
// deciding what to REWRITE must ask `find` first, because "no row" means
// "this symbol keeps the mode it declared", not "count it".
pub function consumed(rows: Escapes[], ix: Index, name: string, at: i32): boolean {
  var i: i32 = find(rows, ix, name);
  if (i < 0) {
    return true;
  }
  if (at < 0 || at >= rows[i].bits.len()) {
    return true;
  }
  return rows[i].bits[at];
}

// The bodies any function VALUE names. A counted parameter is spelled in the
// type `ssasem.closure_type` builds, and that type is what every call through
// the box is checked against — so inferring one counted on a body someone
// takes the address of rewrites the type out from under its call sites
// ("closure signature"). Native has the same rung for the opposite reason:
// `OpCallIndirect` has no callee name, so no retain is emitted there at all.
// Either way the answer is that such a body keeps the modes it declared.
pub function address_taken(f: ssasem.Func, seen: string[]): string[] {
  var out: string[] = seen;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new() && ins.str != "") {
        out = out.append(ins.str);
      }
    }
  }
  return out;
}

pub function names_has(xs: string[], name: string): boolean {
  for x in xs {
    if (x == name) {
      return true;
    }
  }
  return false;
}

function all_true(n: i32): boolean[] {
  var out: boolean[] = [];
  var i: i32 = 0;
  while (i < n) {
    out = out.append(true);
    i = i + 1;
  }
  return out;
}

// The operations that put a value somewhere this frame does not control: a
// container or box built here and handed back, and a store into a cell, into
// a map the frame may not be the only holder of, or into a hole. An `append` or
// a `with` answers a NEW container holding the stored value, so the value goes
// out with it — the receiver does not, which is why those two are read operand
// by operand below rather than whole.
function builds_out(kind: i32): boolean {
  return kind == ssasem.array_new() || kind == ssasem.tuple_new() || kind == ssasem.record_new()
    || kind == ssasem.variant_new() || kind == ssasem.closure_new() || kind == ssasem.cell_new()
    || kind == ssasem.cell_set() || kind == ssasem.map_insert() || kind == ssasem.dyn_box()
    || kind == ssasem.hole_fill();
}

// A store whose RECEIVER is operand 0 and whose stored value is every operand
// after it: the receiver is consumed by the operation, not carried out of the
// frame, and counting it here is what would make every `a = a.with(i, x)` on a
// parameter look like an escape.
function stores_after_receiver(kind: i32): boolean {
  return kind == ssasem.append() || kind == ssasem.with();
}

// Mark `v` and everything it is anchored to. A projection's chain is already
// transitive in `dependencies`, so one pass over it reaches the root.
function carry(own out: boolean[], a: ssasem.Analysis, v: i32): boolean[] {
  if (v < 0 || v >= out.len()) {
    return out;
  }
  out = out.with(v, true);
  for dep in a.dependencies[v] {
    if (dep >= 0 && dep < out.len()) {
      out = out.with(dep, true);
    }
  }
  return out;
}

// The operands a direct call consumes: the slots its callee's contract counts.
// The contract's own modes are stale by construction here — they are what this
// analysis is computing — so the CURRENT round's answer is read instead, which
// is what makes the fixpoint close over a call graph rather than a tree.
//
// A dyn call has no row, and needs none: semsource admits one only where
// every implementation lends every operand, and those keep the modes they
// declared (`semsource.dyn_arms`).
function call_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index): boolean[] {
  if (ssasem.is_dyn_call(ins.str)) {
    return out;
  }
  if (ins.str == f.graph.name && !ssasem.reference(f.result)) {
    return out;
  }
  var rebuilds: boolean = ins.str == f.graph.name && constructed_result(f, ins.result);
  var i: i32 = 0;
  while (i < ins.args.len()) {
    if (ssasem.reference(f.values[ins.args[i]]) && (consumed(rows, ix, ins.str, i)
      || rebuilds && projected_parameter(f, a, ins.args[i]))) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

// A recursive result stored in a newly built value is a rebuilding walk.
// Count only arguments projected from a parameter, leaving unchanged reader
// arguments lent. The normal lent-out guard still protects borrowed results.
function constructed_result(f: ssasem.Func, value: i32): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (builds_out(ins.kind_tag) && util.index_of_i32(ins.args, value) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function projected_parameter(f: ssasem.Func, a: ssasem.Analysis, value: i32): boolean {
  for dep in a.dependencies[value] {
    if (dep >= 0 && dep < f.params.len() && dep != value) {
      return true;
    }
  }
  return false;
}

// A call THROUGH a function value reads its slots off the type the box hands
// out, and this boundary has no declaration to consult for it, so every
// reference operand is taken as consumed.
function indirect_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst): boolean[] {
  for arg in ins.args {
    if (ssasem.reference(f.values[arg])) {
      out = carry(out, a, arg);
    }
  }
  return out;
}

// A phi `ssasem.tail_recursion` left for parameter `imm` of the call `str` is
// that call's slot: every operand after the first is an argument a call
// passed, carried as `call_carried` would carry it, and the first is the
// parameter itself, which whatever carries the phi carries too (`continued`).
// Read as a plain loop instead, a walk that rebuilds its input would never
// consume it.
function slot_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index, rebuilds: boolean): boolean[] {
  if (ins.str == f.graph.name && !ssasem.reference(f.result)) {
    return out;
  }
  if (!consumed(rows, ix, ins.str, ins.imm) && !recycling_slot(f, a, ins, rebuilds)) {
    return out;
  }
  var i: i32 = 1;
  while (i < ins.args.len()) {
    if (ssasem.reference(f.values[ins.args[i]])) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function slot_phi(ins: ssa.SInst): boolean {
  return ins.kind_tag == 8 && ins.str != "";
}

// The constructor-tail rewrite marks the chain with hole_fill and each
// parameter phi with the original call slot. A projected next argument is
// anchored to that phi; an unchanged parameter is the phi itself and must
// remain lent. This preference is independent of the call-graph fixpoint.
function recycling_slot(f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rebuilds: boolean): boolean {
  if (!rebuilds || ins.str != f.graph.name) {
    return false;
  }
  var i: i32 = 1;
  while (i < ins.args.len()) {
    var arg: i32 = ins.args[i];
    if (arg >= 0 && arg != ins.result && ssasem.reference(f.values[arg])
      && util.index_of_i32(a.dependencies[arg], ins.result) >= 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function rebuilds_chain(f: ssasem.Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.hole_fill()) {
        return true;
      }
    }
  }
  return false;
}

function continued(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis): boolean[] {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (slot_phi(ins) && out[ins.result]) {
        out = carry(out, a, ins.args[0]);
      }
    }
  }
  return out;
}

function instruction_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index, rebuilds: boolean): boolean[] {
  if (ins.kind_tag == ssasem.call()) {
    return call_carried(out, f, a, ins, rows, ix);
  }
  if (slot_phi(ins)) {
    return slot_carried(out, f, a, ins, rows, ix, rebuilds);
  }
  if (ins.kind_tag == ssasem.call_value()) {
    return indirect_carried(out, f, a, ins);
  }
  if (builds_out(ins.kind_tag)) {
    for arg in ins.args {
      if (ssasem.reference(f.values[arg])) {
        out = carry(out, a, arg);
      }
    }
    return out;
  }
  if (stores_after_receiver(ins.kind_tag)) {
    var i: i32 = 1;
    while (i < ins.args.len()) {
      if (ssasem.reference(f.values[ins.args[i]])) {
        out = carry(out, a, ins.args[i]);
      }
      i = i + 1;
    }
  }
  return out;
}

// The values a callee may keep a borrow of. A slot the callee does NOT count
// is lent, and nothing here can see what the callee does with what it was
// lent: `hands_out` models a call result as a FRESH unit, which severs the
// result's dependency on the argument, so a callee that puts a lent value in
// the thing it returns is invisible from the caller.
//
// That is only a leak while the caller borrows the container too. Once the
// caller OWNS it, the caller also drops it — and the drop frees a box the
// result still points at. `semsource.stmt` is the shape: every arm destructures
// `st` and hands a payload on (`declare(st, v, s)`, `discard(e.value, s)`)
// before the frame's drop of `st` runs, which segfaulted the compiler at
// `semtypes.numeric_equal` reading a null type.
//
// So a parameter with a value of its own in a lent slot is not counted. The
// container stays borrowed, nobody drops it, and the callee's borrow stays
// good — which is what happened before this pass existed.
function lent_values(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index): boolean[] {
  var at: i32 = find(rows, ix, ins.str);
  if (at >= 0 && !rows[at].lends) {
    return out;
  }
  var i: i32 = 0;
  while (i < ins.args.len()) {
    if (ssasem.reference(f.values[ins.args[i]]) && !consumed(rows, ix, ins.str, i)) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function lent_out(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean[] {
  var out: boolean[] = [];
  var i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append(false);
    i = i + 1;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        out = lent_values(out, f, a, ins, rows, ix);
      }
    }
  }
  return out;
}

// The values this frame lets out, under the current round's answers. A
// return lets out the returned value and not what it is anchored to: the
// planner retains a projection of a borrowed parameter to hand it back, so a
// reader such as `p.toks[p.pos]` keeps `p` lent, and a returned view reads its
// root without taking a unit at all.
function carried_values(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean[] {
  var out: boolean[] = [];
  var i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append(false);
    i = i + 1;
  }
  var rebuilds: boolean = rebuilds_chain(f);
  for b in f.graph.blocks {
    for ins in b.insts {
      out = instruction_carried(out, f, a, ins, rows, ix, rebuilds);
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, true);
    }
  }
  return continued(out, f, a);
}

// Parameter `i` is value `i` — `ssasem`'s parameter instruction pins
// `result == imm` — so the carried set is read off its own slot.
//
// The analysis is the caller's to hold rather than this function's to make:
// it does not depend on `rows`, and remaking it every round cost 23% of the
// whole compiler's build time when it was made here.
pub function escaping(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean[] {
  // A function this boundary cannot analyse keeps every declared mode.
  if (!a.ok) {
    return all_true(f.params.len());
  }
  var carried: boolean[] = carried_values(f, a, rows, ix);
  var lent: boolean[] = lent_out(f, a, rows, ix);
  var out: boolean[] = [];
  var i: i32 = 0;
  while (i < f.params.len()) {
    out = out.append(i < carried.len() && carried[i] && !(i < lent.len() && lent[i]));
    i = i + 1;
  }
  return out;
}
