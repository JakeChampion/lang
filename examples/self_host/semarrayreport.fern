pub function storage_aliased_arguments(): i32 {
  return 10;
}

pub function kernel_scale_kernel(): i32 {
  return 0;
}

pub function kernel_disabled(): i32 {
  return 1;
}

pub function kernel_layout_unknown(): i32 {
  return 2;
}

pub function kernel_layout_strided(): i32 {
  return 3;
}

pub function kernel_layout_row_major(): i32 {
  return 4;
}

pub function kernel_element_fn_unresolved(): i32 {
  return 5;
}

pub function kernel_element_fn_captures(): i32 {
  return 6;
}

pub function kernel_element_not_literal_scale(): i32 {
  return 7;
}

pub function kernel_constructor_unavailable(): i32 {
  return 8;
