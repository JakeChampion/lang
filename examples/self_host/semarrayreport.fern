// Primary compiler array decisions. The rewriting passes supply the sites;
// this module only formats them and counts their closed reason tags.
import "./util";

pub struct Site { owner: string, stage: string, plan: string, reason: i32, storage: string }

pub function enabled(): boolean {
  match (env("FERN_ARRAY_REPORT")) {
    Some(v) => {
      return v == "1";
    },
    None => {
      return false;
    }
  }
}

// Named ordinals keep planner decisions tied to the closed diagnostic tags.
pub function fusion_fused(): i32 {
  return 0;
}

pub function fusion_no_producer(): i32 {
  return 1;
}

pub function fusion_intermediate_shared(): i32 {
  return 2;
}

pub function fusion_control_flow_boundary(): i32 {
  return 3;
}

pub function fusion_effect_boundary(): i32 {
  return 4;
}

pub function fusion_element_fn_unresolved(): i32 {
  return 5;
}

pub function fusion_element_fn_effectful(): i32 {
  return 6;
}

pub function fusion_non_scalar(): i32 {
  return 7;
}

pub function fusion_result_escapes(): i32 {
  return 8;
}

pub function fusion_no_reduction_sink(): i32 {
  return 9;
}

pub function fusion_operator_outside_algebra(): i32 {
  return 10;
}

pub function fusion_disabled(): i32 {
  return 11;
}

pub function storage_guarded_reuse(): i32 {
  return 0;
}

pub function storage_reuse_disabled(): i32 {
  return 1;
}

pub function storage_shape_unsupported(): i32 {
  return 2;
}

pub function storage_borrow_linked_result(): i32 {
