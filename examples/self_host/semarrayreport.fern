pub function kernel_inner_mul_add_kernel(): i32 {
  return 14;
}

pub function kernel_element_not_binary_add(): i32 {
  return 15;
}

// Stable ordinals are shared by the decision and its diagnostic. A successful
// rewrite has its own tag; refusals never predict a rewrite.
pub function reasons(): string[] {
  return ["fused", "no-producer", "intermediate-shared", "control-flow-boundary", "effect-boundary", "element-fn-unresolved", "element-fn-effectful", "non-scalar", "result-escapes", "no-reduction-sink", "operator-outside-algebra", "disabled"];
}

pub function render(sites: Site[]): string {
  return render_kind("typed semantic fusion", reasons(), sites);
}

pub function storage_reasons(): string[] {
  return ["guarded-reuse", "reuse-disabled", "shape-unsupported", "borrow-linked-result", "receiver-not-consumed-param", "receiver-still-live", "receiver-supplied", "element-fn-unresolved", "element-fn-captures", "element-fn-effectful", "aliased-arguments"];
}

pub function kernel_reasons(): string[] {
  return ["scale-kernel", "disabled", "layout-unknown", "layout-strided", "layout-row-major", "element-fn-unresolved", "element-fn-captures", "element-not-literal-scale", "constructor-unavailable", "builtin-shadowed", "unsupported-operation", "unsupported-element-type", "outer-mul-kernel", "element-not-binary-multiply", "inner-mul-add-kernel", "element-not-binary-add"];
}

pub function scale_storage_guarded_reuse(): i32 {
  return 0;
}

pub function scale_storage_reuse_disabled(): i32 {
  return 1;
}

pub function scale_storage_receiver_borrowed(): i32 {
  return 2;
}

pub function scale_storage_receiver_still_live(): i32 {
  return 3;
}

pub function scale_storage_receiver_supplied(): i32 {
  return 4;
}

pub function scale_storage_borrow_linked_result(): i32 {
  return 5;
}

pub function scale_storage_builtin_shadowed(): i32 {
  return 6;
}

pub function scale_storage_shape_unsupported(): i32 {
