// examples/self_host/interp_run.fern — stdin-driven driver for
// interp.fern's tree-walking evaluator. Reads Fern source from
// stdin, runs lexer + parser + interp.eval_module, and exits
// with the program's VInt return value (or 254 if the program
// failed / returned non-i32). Companion to asm_run.fern
// (#672+); used by the cross-validation test to assert
// interp / vm / asm all agree on the same source.

import "./lexer";
import "./parser";
import "./rundriver";
import "./interp";

function main(): i32 {
    var mod: parser.Module = rundriver.parse_stdin("interp_run");
    var result: interp.Value = interp.eval_module(mod);
    match (result) {
        interp.VInt(i) => { return i.v; },
        interp.VBool(b) => {
            if (b.v) { return 1; }
            return 0;
        },
        _ => { return 254; }
    }
    return 254;
}
