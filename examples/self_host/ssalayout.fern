// Structured layout of a reducible control-flow graph: every natural loop is
// a contiguous span headed by its header, nested loops are contiguous inside
// their parent, and everything else is in a forward order. Stack-IR emitters
// need exactly this to place `loop` and `block` labels.
import "./ssa";
import "./ssadeps";

// order holds block POSITIONS (indices into f.blocks) in emission order.
// loop_end[i] is the last order index of the loop headed at order index i,
// or -1 when order[i] heads no loop. Only reachable blocks are laid out.
pub struct Layout { ok: boolean, order: i32[], loop_end: i32[] }

// at maps a block id to its position (-1 for an id no block carries); succ
// lists each position's successor positions.
struct Loops { n: i32, header: boolean[], members: boolean[], at: i32[], succ: i32[][] }

function flags(n: i32, bit: boolean): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(bit);
    i = i + 1;
  }
  return out;
}

function positions(f: ssa.SFunc): i32[] {
  let top: i32 = 0;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let out: i32[] = [];
  let i: i32 = 0;
  while (i <= top) {
    out = out.append(0 - 1);
    i = i + 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    if (f.blocks[i].id >= 0) {
      out = out.with(f.blocks[i].id, i);
    }
    i = i + 1;
  }
  return out;
}

function position(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id];
}

function successor_table(f: ssa.SFunc, at: i32[]): i32[][] {
  let out: i32[][] = [];
  for b in f.blocks {
    let t: ssa.STerm = b.term;
    if (t.kind_tag == 2) {
      out = out.append([position(at, t.target)]);
    } else if (t.kind_tag == 3 && t.t == t.f) {
      out = out.append([position(at, t.t)]);
    } else if (t.kind_tag == 3) {
      out = out.append([position(at, t.t), position(at, t.f)]);
    } else {
      out = out.append([]);
    }
  }
  return out;
}

// The natural loop of a back edge: the header plus every block that reaches
// the edge's source without passing through the header.
function absorb(f: ssa.SFunc, own l: Loops, h: i32, u: i32, reachable: boolean[]): Loops {
  let work: i32[] = [u];
  while (work.len() > 0) {
    let x: i32 = work[work.len() - 1];
    work = prefix(work, work.len() - 1);
    if (x == h || l.members[h * l.n + x]) {
      continue;
    }
    l = Loops { ...l, members: l.members.with(h * l.n + x, true) };
    for pred in f.blocks[x].preds {
      let pi: i32 = position(l.at, pred);
      if (reachable[pi]) {
        work = work.append(pi);
      }
    }
  }
  return l;
}

function prefix(xs: i32[], n: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

function find_loops(f: ssa.SFunc, reachable: boolean[], dom: ssadeps.Dom): Loops {
  let n: i32 = f.blocks.len();
  let at: i32[] = positions(f);
  let l: Loops = Loops { n: n, header: flags(n, false), members: flags(n * n, false), at: at, succ: successor_table(f, at) };
  let u: i32 = 0;
  while (u < n) {
    if (reachable[u]) {
      for h in l.succ[u] {
        if (ssadeps.dom_holds(dom, u, h)) {
          l = Loops { ...l, header: l.header.with(h, true), members: l.members.with(h * n + h, true) };
          l = absorb(f, l, h, u, reachable);
        }
      }
    }
    u = u + 1;
  }
  return l;
}

// A region is one loop body (or the whole function). Inner loops collapse to
// their headers while the region is ordered, then expand in place.
// representatives maps every position to the lowest outermost header whose loop
// holds it, else to itself, once per region: the ordering below asks for it once
// per edge per round.
function representatives(l: Loops, region: boolean[], root: i32): i32[] {
  let out: i32[] = [];
  let x: i32 = 0;
  while (x < l.n) {
    out = out.append(x);
    x = x + 1;
  }
  let taken: boolean[] = flags(l.n, false);
  let h: i32 = 0;
  while (h < l.n) {
    if (h != root && region[h] && l.header[h] && outermost(l, region, root, h)) {
      x = 0;
      while (x < l.n) {
        if (!taken[x] && l.members[h * l.n + x]) {
          out = out.with(x, h);
          taken = taken.with(x, true);
        }
        x = x + 1;
      }
    }
    h = h + 1;
  }
  return out;
}

function outermost(l: Loops, region: boolean[], root: i32, h: i32): boolean {
  let other: i32 = 0;
  while (other < l.n) {
    if (other != root && other != h && region[other] && l.header[other] && l.members[other * l.n + h]) {
      return false;
    }
    other = other + 1;
  }
  return true;
}

function pending_edges(l: Loops, region: boolean[], root: i32, reps: i32[]): i32[] {
  let pending: i32[] = [];
  let i: i32 = 0;
  while (i < l.n) {
    pending = pending.append(0);
    i = i + 1;
  }
  let x: i32 = 0;
  while (x < l.n) {
    if (region[x]) {
      let rx: i32 = reps[x];
      for y in l.succ[x] {
        if (!region[y] || y == root) {
          continue;
        }
        let ry: i32 = reps[y];
        if (rx != ry) {
          pending = pending.with(ry, pending[ry] + 1);
        }
      }
    }
    x = x + 1;
  }
  return pending;
}

function release(l: Loops, region: boolean[], root: i32, chosen: i32, own pending: i32[], reps: i32[]): i32[] {
  let x: i32 = 0;
  while (x < l.n) {
    if (region[x] && reps[x] == chosen) {
      for y in l.succ[x] {
        if (!region[y] || y == root) {
          continue;
        }
        let ry: i32 = reps[y];
        if (ry != chosen) {
          pending = pending.with(ry, pending[ry] - 1);
        }
      }
    }
    x = x + 1;
  }
  return pending;
}

function next_ready(l: Loops, region: boolean[], pending: i32[], done: boolean[], reps: i32[]): i32 {
  let x: i32 = 0;
  while (x < l.n) {
    if (region[x] && !done[x] && reps[x] == x && pending[x] == 0) {
      return x;
    }
    x = x + 1;
  }
  return 0 - 1;
}

function row(l: Loops, h: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < l.n) {
    out = out.append(l.members[h * l.n + i]);
    i = i + 1;
  }
  return out;
}

function irreducible(): Layout {
  return Layout { ok: false, order: [], loop_end: [] };
}

function complete(l: Loops, region: boolean[], done: boolean[], reps: i32[]): boolean {
  let x: i32 = 0;
  while (x < l.n) {
    if (region[x] && !done[reps[x]]) {
      return false;
    }
    x = x + 1;
  }
  return true;
}

function region_order(l: Loops, region: boolean[], root: i32, out: Layout): Layout {
  let start: i32 = out.order.len();
  let reps: i32[] = representatives(l, region, root);
  let pending: i32[] = pending_edges(l, region, root, reps);
  let done: boolean[] = flags(l.n, false);
  let chosen: i32 = root;
  while (chosen >= 0) {
    done = done.with(chosen, true);
    if (chosen != root && l.header[chosen]) {
      out = region_order(l, row(l, chosen), chosen, out);
      if (!out.ok) {
        return out;
      }
    } else {
      out = Layout { ok: true, order: out.order.append(chosen), loop_end: out.loop_end.append(0 - 1) };
    }
    pending = release(l, region, root, chosen, pending, reps);
    chosen = next_ready(l, region, pending, done, reps);
  }
  if (!complete(l, region, done, reps)) {
    return irreducible();
  }
  if (l.header[root]) {
    out = Layout { ...out, loop_end: out.loop_end.with(start, out.order.len() - 1) };
  }
  return out;
}

// A failed layout means the reachable graph has a cycle without a single
// dominating header, which no structured `loop` can express.
pub function compute(f: ssa.SFunc): Layout {
  let reachable: boolean[] = ssadeps.reachable_blocks(f);
  let l: Loops = find_loops(f, reachable, ssadeps.dominates(f));
  return region_order(l, reachable, position(l.at, f.entry), Layout { ok: true, order: [], loop_end: [] });
}
