// x86_gas_rep_ok reports whether a rep/repne prefix may precede the mnemonic.
// That is the string ops plus `rep ret` and `rep nop`, the two idioms gas also
// takes; anything else it rejects outright, and the prefix would otherwise be
// emitted in front of an instruction that ignores it.
function x86_gas_rep_ok(mnem: string): boolean {
  if (mnem == "ret") {
    return true;
  }
  if (mnem == "nop") {
    return true;
  }
  if (mnem == "movsb") {
    return true;
  }
  if (mnem == "movsw") {
    return true;
  }
  if (mnem == "movsd" || mnem == "movsl") {
    return true;
  }
  if (mnem == "movsq") {
    return true;
  }
  if (mnem == "stosb") {
    return true;
  }
  if (mnem == "stosw") {
    return true;
  }
  if (mnem == "stosl") {
    return true;
  }
  if (mnem == "stosq") {
    return true;
  }
  if (mnem == "lodsb") {
    return true;
  }
  if (mnem == "lodsw") {
    return true;
  }
  if (mnem == "lodsl") {
    return true;
  }
  if (mnem == "lodsq") {
    return true;
  }
  if (mnem == "scasb") {
    return true;
  }
  if (mnem == "scasw") {
    return true;
  }
  if (mnem == "scasl") {
    return true;
  }
  if (mnem == "scasq") {
    return true;
  }
  if (mnem == "cmpsb") {
    return true;
  }
  if (mnem == "cmpsw") {
    return true;
  }
  if (mnem == "cmpsd" || mnem == "cmpsl") {
    return true;
  }
  if (mnem == "cmpsq") {
    return true;
  }
  return false;
}

