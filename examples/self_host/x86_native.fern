    if (ops.len() != 3 || size == 8) { return x86_gas_bad(a, mnem + " " + rest); }
    var rs: i32 = x86_gas_reg_w(ops[1], size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    var by_cl: boolean = (ops[0] == "%cl");
    if (!by_cl && (ops[0].len() == 0 || ops[0][0] != b'$')) { return x86_gas_bad(a, mnem + " " + rest); }
    var op: i32 = opimm;
    if (by_cl) { op = opimm + 1; }
    var imm: i32 = 0;
    var tail: i32 = 0;
    if (!by_cl) { imm = x86_gas_atoi(ops[0]); tail = 1; }
    if (x86_str_contains(ops[2], "(")) {
        var m: GasMem = x86_gas_parse_mem(ops[2]);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + ops[2]); }
        a = x86_gas_mem_op(a, size, true, op, rs, m, false, tail);
        if (!by_cl) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
        return a;
    }
    var rd: i32 = x86_gas_reg_w(ops[2], size);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    a = X86Asm { ...a, code: x86_op0f_rr(a.code, size, op, rs, rd) };
    if (!by_cl) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
