// x86_gas_movdq: movdqu (F3) / movdqa (66) with the direction picked by
// which side is memory: 0F 6F loads/copies, 0F 7F stores. The store was
// missing before this port — the operands written backwards through 6F
// would have READ from the store address instead.
function x86_gas_movdq(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
    var pfx: i32 = x86_gas_movdq_pfx(mnem);
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        var xs: i32 = x86_gas_xmm(src);
