// x86_gas_movext assembles one extend, register or memory source. The source
// register is parsed at the width the opcode reads — a byte for B6/BE, a word
// for B7/BF — so a token of the wrong width is refused rather than folded in.
//
// The register path is not optional: reading a register token as a memory
// operand encodes a LOAD from whatever base the parse falls back to, which is
// a valid instruction reading the wrong place (#8083).
function x86_gas_movext(own a: X86Asm, op: i32, size: i32, src: string, dst: string): X86Asm {
  let w: i32 = 0;
  if (size == 64) {
    w = 1;
  }
  let d: i32 = x86_gas_reg_w(dst, size);
  if (d < 0) {
    return x86_gas_bad(a, "movext " + src + ", " + dst);
  }
  // A 16-bit destination is the 32-bit encoding under an operand-size
  // prefix; no REX.W is involved either way.
  if (size == 16) {
    x86_push_arr(a.code, x86_osz([], 16));
  }
  if (x86_gas_has_paren(src)) {
    let m: GasMem = x86_gas_parse_mem(src);
    if (m.no_base) {
      return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + src) };
    }
    if (m.is_rip) {
      return X86Asm { ...a, unknown: a.unknown.append("rip-relative operand not encoded here: " + src) };
    }
    x86_push_arr(a.code, x86_movext_mem([], op, w, d, m.base, m.has_index, m.index, m.scale, m.disp));
    return a;
  }
  let sr: i32 = x86_gas_reg8(src);
  if (op == 191 || op == 183) {
    sr = x86_gas_reg16(src);
  }
  if (sr < 0) {
    return x86_gas_bad(a, "movext " + src + ", " + dst);
  }
  x86_push_arr(a.code, x86_movext_reg([], op, w, d, sr));
  return a;
}

// ---- suffix-family machinery ----
//
// The AT&T mnemonic surface is organised as families keyed on the base
// mnemonic (suffix stripped) with the operand width taken from the suffix.
// Anything a family cannot encode is RECORDED (SH-005) — a wrong-width
// encode is the silent-widening class #3544/#7886 fixed.

// x86_gas_bad records an unsupported instruction shape (SH-005).
function x86_gas_bad(own a: X86Asm, what: string): X86Asm {
  return X86Asm { ...a, unknown: a.unknown.append(what) };
}

// x86_gas_mem_ok rejects the operand shapes the sized encoders do not
// take: the no-base SIB form and any register token that failed to parse
// (which would otherwise mask to a real register and encode silently).
function x86_gas_mem_ok(m: GasMem): boolean {
  if (m.is_rip) {
    return true;
  }
  if (m.no_base || m.base < 0) {
    return false;
  }
  if (m.has_index && m.index < 0) {
    return false;
  }
  return true;
}

// x86_gas_mem_rex appends the REX (when needed) for an op with a memory rm
// operand. `force8` marks an 8-bit REGISTER in the reg field (spl..dil
// force a REX).
function x86_gas_mem_rex(own buf: i32[], size: i32, reg: i32, m: GasMem, force8: boolean): i32[] {
  let ix: i32 = 0;
  let bs: i32 = 0;
  if (!m.is_rip) {
    if (m.has_index) {
      ix = m.index;
    }
    bs = m.base;
  }
  let rex: i32 = x86_rex(x86_rex_w_of(size), reg, ix, bs);
  if (rex != 64 || force8) {
    buf = buf.append(rex);
  }
  return buf;
}

// x86_gas_membytes appends the ModR/M (+SIB+disp) for `m` — or, for a
// rip-relative operand, the mod=00 rm=101 form with a placeholder disp32
// and a queued fixup. `tail` is the immediate byte count following the
// disp32 (a rip displacement is measured from the END of the instruction).
function x86_gas_membytes(own a: X86Asm, reg: i32, m: GasMem, tail: i32): X86Asm {
  if (m.is_rip) {
    // Every path returns a construction, never `return a`: a bare
    // param return makes every caller's result borrow-tainted
    // (findReturnsFreshBox), which un-eligibles the caller's own
    // state param — one leaked X86Asm per assembled instruction and
    // a whole-.text copy per append through the leaked reference.
    buf_push_byte(a.code, x86_modrm(0, reg, 5));
    x86_push_arr(a.code, x86_le32([], 0));
    let patch_off: i32 = buf_len(a.code) - 4;
    if (tail > 0) {
      a = x86_queue_fixup(a, patch_off, 4, m.label);
      a = X86Asm { ...a, fix_tail_offs: a.fix_tail_offs.append(patch_off) };
      return X86Asm { ...a, fix_tail_bytes: a.fix_tail_bytes.append(tail) };
    }
    return x86_queue_fixup(a, patch_off, 4, m.label);
  }
  x86_push_arr(a.code, x86_byte_mem_operand([], reg, m.base, m.has_index, m.index, m.scale, m.disp));
  return a;
}

// x86_gas_mem_op emits `[66] [REX] [0F] <op>` then the memory rm — the
// shared tail of every sized memory form.
function x86_gas_mem_op(own a: X86Asm, size: i32, op0f: boolean, op: i32, reg: i32, m: GasMem, force8: boolean, tail: i32): X86Asm {
  if (!m.is_rip) {
    x86_push_arr(a.code, x86_mem_op_bytes([], size, op0f, op, reg, m, force8));
    return a;
  }
  x86_push_arr(a.code, x86_osz([], size));
  x86_push_arr(a.code, x86_gas_mem_rex([], size, reg, m, force8));
  if (op0f) {
    buf_push_byte(a.code, 15);
  }
  buf_push_byte(a.code, op);
  return x86_gas_membytes(a, reg, m, tail);
}

// x86_mem_op_bytes is x86_gas_mem_op for an operand that is not rip-relative.
function x86_mem_op_bytes(own buf: i32[], size: i32, op0f: boolean, op: i32, reg: i32, m: GasMem, force8: boolean): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_gas_mem_rex(buf, size, reg, m, force8);
  if (op0f) {
    buf = buf.append(15);
  }
  buf = buf.append(op);
  return x86_byte_mem_operand(buf, reg, m.base, m.has_index, m.index, m.scale, m.disp);
}

// ---- record forms ----
//
// An emitter writing a binary hands the assembler encoded instructions for the
// shapes generated code writes most. The forms by register number are the
// emitter's: the bytes the text would assemble to, from the same encoders,
// with a memory operand as a displacement off a base register. The forms by
// operand text are the assembler's own arms': they parse the text and return
// its bytes, or [] when it falls outside the shapes they cover, and the arm
// then goes on to the rip-relative forms and the refusals.
function x86_mem_at(base: i32, disp: i32): GasMem {
  return GasMem { is_rip: false, label: "", base: base, disp: disp, has_index: false, index: 0, scale: 1, no_base: false };
}

// x86_rec_mov_rr is `mov src, dst` between registers at `size` bits.
pub function x86_rec_mov_rr(size: i32, dst: i32, src: i32): i32[] {
  return x86_op_rr([], size, 136, src, dst);
}

// x86_rec_mov_rm is the load `mov disp(base), reg` or the store `mov reg,
// disp(base)`.
pub function x86_rec_mov_rm(size: i32, load: boolean, reg: i32, base: i32, disp: i32): i32[] {
  let op: i32 = 136;
  if (load) {
    op = 138;
  }
  return x86_mem_op_bytes([], size, false, x86_opsel(op, size), reg, x86_mem_at(base, disp), x86_rex8_force(size, reg));
}

// x86_rec_alu_rr, _ir, _im and _rm are the group-1 op `ext` (add 0, or 1,
// and 4, sub 5, xor 6, cmp 7) between two registers, from an immediate
// into a register or memory, and between a register and memory (`load`:
// memory is the source).
pub function x86_rec_alu_rr(ext: i32, size: i32, src: i32, dst: i32): i32[] {
  return x86_op_rr([], size, ext * 8, src, dst);
}

pub function x86_rec_alu_ir(ext: i32, size: i32, imm: i32, dst: i32): i32[] {
  return x86_grp1_imm_r([], size, ext, dst, imm);
}

pub function x86_rec_alu_im(ext: i32, size: i32, imm: i32, base: i32, disp: i32): i32[] {
  if (size == 8 || x86_imm_fits8(imm)) {
    let opi: i32 = 131;  // 83 /ext ib
    if (size == 8) {  // 80 /ext ib
      opi = 128;
    }
    return x86_mem_op_bytes([], size, false, opi, ext, x86_mem_at(base, disp), false).append(imm & 255);
  }
  return x86_imm_wide(x86_mem_op_bytes([], size, false, 129, ext, x86_mem_at(base, disp), false), size, imm);
}

pub function x86_rec_alu_rm(ext: i32, size: i32, load: boolean, reg: i32, base: i32, disp: i32): i32[] {
  let op: i32 = ext * 8;  // store form: opbase, reg = source
  if (load) {
    op = op | 2;  // load form: opbase|2, reg = destination
  }
  return x86_mem_op_bytes([], size, false, x86_opsel(op, size), reg, x86_mem_at(base, disp), x86_rex8_force(size, reg));
}

// x86_rec_test_rr and _ir are `test` between two registers and from an
// immediate into a register.
pub function x86_rec_test_rr(size: i32, src: i32, dst: i32): i32[] {
  return x86_op_rr([], size, 132, src, dst);
}

pub function x86_rec_test_ir(size: i32, imm: i32, dst: i32): i32[] {
  return x86_test_imm_r([], size, dst, imm);
}

// x86_rec_push_r, x86_rec_pop_r and x86_rec_push_m are `pushq reg`, `popq
// reg` and `pushq disp(base)`.
pub function x86_rec_push_r(reg: i32): i32[] {
  return x86_push_r64([], reg);
}

pub function x86_rec_pop_r(reg: i32): i32[] {
  return x86_pop_r64([], reg);
}

pub function x86_rec_push_m(base: i32, disp: i32): i32[] {
  return x86_push_mem([], base, false, 0, 1, disp);
}

// x86_rec_ret and x86_rec_leave are the one-byte `ret` and `leave`.
pub function x86_rec_ret(): i32[] {
  return [195];
}

pub function x86_rec_leave(): i32[] {
  return [201];
}

// x86_rec_lea_rm is `leaq disp(base), dst`.
pub function x86_rec_lea_rm(dst: i32, base: i32, disp: i32): i32[] {
  return x86_lea_load([], 64, dst, base, false, 0, 1, disp);
}

// x86_rec_call is `call sym` and x86_rec_lea_rip `leaq sym(%rip), dst`,
// each with its rel32 unpatched: the bytes of a named record, whose last
// four the assembler patches to the symbol.
pub function x86_rec_call(): i32[] {
  return x86_call_rel32([], 0);
}

pub function x86_rec_lea_rip(dst: i32): i32[] {
  return x86_le32([x86_rex(1, dst, 0, 0), 141, x86_modrm(0, dst, 5)], 0);
}

// x86_rec_movslq_rr is `movslq src32, dst`.
pub function x86_rec_movslq_rr(dst: i32, src: i32): i32[] {
  return x86_movslq_rr([], dst, src);
}

// x86_rec_mov_rmi is the load `mov disp(base,index,scale), reg` or the
// store `mov reg, disp(base,index,scale)`.
pub function x86_rec_mov_rmi(size: i32, load: boolean, reg: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
  let op: i32 = 136;
  if (load) {
    op = 138;
  }
  let m: GasMem = GasMem { is_rip: false, label: "", base: base, disp: disp, has_index: true, index: index, scale: scale, no_base: false };
  return x86_mem_op_bytes([], size, false, x86_opsel(op, size), reg, m, x86_rex8_force(size, reg));
}

// x86_rec_movzb_mi is `movzbl disp(base,index), dst` (`w` 0) or its
// `movzbq` form (`w` 1).
pub function x86_rec_movzb_mi(w: i32, dst: i32, base: i32, index: i32, disp: i32): i32[] {
  return x86_movzb_mem([], w, dst, base, true, index, 1, disp);
}

// x86_rec_mov_ir is `mov $imm, reg`: B8+rd id at 32 bits, which zero-extends,
// and the sign-extending REX.W C7 /0 id at 64, the text arm's own choices.
pub function x86_rec_mov_ir(size: i32, imm: i32, dst: i32): i32[] {
  if (size == 64) {
    return x86_mov_r64_imm32([], dst, imm);
  }
  let b: i32[] = x86_rex_r(x86_osz([], size), size, dst);
  b = b.append(184 + (dst & 7));
  return x86_imm_wide(b, size, imm);
}

// x86_rec_mov_im is `mov $imm, disp(base)` at 32 or 64 bits (C7 /0 id).
pub function x86_rec_mov_im(size: i32, imm: i32, base: i32, disp: i32): i32[] {
  return x86_imm_wide(x86_mem_op_bytes([], size, false, x86_opsel(198, size), 0, x86_mem_at(base, disp), false), size, imm);
}

// x86_rec_inc_r is `incq reg` (REX.W FF /0).
pub function x86_rec_inc_r(dst: i32): i32[] {
  return x86_unary_r([], 64, 254, 0, dst);
}

// x86_rec_mov is `mov` at `size` bits between general registers, or between
// a register and a memory operand that is not rip-relative: the bytes
// x86_gas_mov_rm lays down.
pub function x86_rec_mov(size: i32, src: string, dst: string): i32[] {
  if (src.len() == 0 || src[0] == b'$' || x86_gas_is_xmm(src) || x86_gas_is_xmm(dst)) {
    return [];
  }
  let src_mem: boolean = x86_gas_has_paren(src);
  let dst_mem: boolean = x86_gas_has_paren(dst);
  if (src_mem && dst_mem) {
    return [];
  }
  if (src_mem || dst_mem) {
    let mt: string = dst;
    let rt: string = src;
    let op: i32 = 136;  // store: 88/89, ModRM.reg = source
    if (src_mem) {
      mt = src;
      rt = dst;
      op = 138;  // load: 8A/8B, ModRM.reg = destination
    }
    let m: GasMem = x86_gas_parse_mem(mt);
    let r: i32 = x86_gas_reg_w(rt, size);
    if (!x86_gas_mem_ok(m) || m.is_rip || r < 0) {
      return [];
    }
    return x86_mem_op_bytes([], size, false, x86_opsel(op, size), r, m, x86_rex8_force(size, r));
  }
  let r1: i32 = x86_gas_reg_w(src, size);
  let r2: i32 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0) {
    return [];
  }
  return x86_rec_mov_rr(size, r2, r1);
}

// x86_gas_mov_rm encodes the width-generic mov shapes at 8/16/32/64 bits:
// 88/89 (reg -> r/m), 8A/8B (r/m -> reg), C6/C7 /0 (imm -> r/m) and B0/B8+r
// (imm -> reg). The per-width entry points strip what is NOT generic off the
// front first — movq's xmm forms and its imm32-or-movabs choice — and the
// rip-relative label emitters differ per width, so they are dispatched here
// by size rather than folded in.
function x86_gas_mov_rm(own a: X86Asm, mnem: string, size: i32, src: string, dst: string): X86Asm {
  let b: i32[] = x86_rec_mov(size, src, dst);
  if (b.len() > 0) {
    x86_push_arr(a.code, b);
    return a;
  }
  if (src.len() > 0 && src[0] == b'$') {
    let imm: i32 = x86_gas_atoi(src);
    let tail: i32 = 4;
    if (size == 8) {
      tail = 1;
    }
    if (size == 16) {
      tail = 2;
    }
    if (x86_gas_has_paren(dst)) {
      let mi: GasMem = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi)) {
        return x86_gas_bad(a, mnem + " " + src + ", " + dst);
      }
      if (mi.is_rip) {
        // x86_store_imm_rip_label writes no operand-size prefix.
        if (size == 16) {
          return x86_gas_bad(a, mnem + " " + src + ", " + dst);
        }
        return x86_store_imm_rip_label(a, x86_opsel(198, size), x86_rex_w_of(size), mi.label, imm, tail);
      }
      a = x86_gas_mem_op(a, size, false, x86_opsel(198, size), 0, mi, false, tail);
      if (size == 8) {
        buf_push_byte(a.code, imm & 255);
        return a;
      }
      x86_push_arr(a.code, x86_imm_wide([], size, imm));
      return a;
    }
    let rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    if (size == 64) {
      // 64 bits must SIGN-extend (REX.W C7 /0 id), not take the
      // zero-extending B8+r id — `movq $-1, %rax` is -1, not
      // 4294967295. An immediate too wide for a signed 32-bit field
      // takes the 10-byte movabsq.
      let iv: i64 = x86_gas_atoi64(src);
      if (iv >= (0 - 2147483648) as i64 && iv <= 2147483647 as i64) {
        x86_push_arr(a.code, x86_mov_r64_imm32([], rd, iv as i32));
        return a;
      }
      x86_push_arr(a.code, x86_movabsq([], rd, iv));
      return a;
    }
    x86_push_arr(a.code, x86_osz([], size));
    x86_push_arr(a.code, x86_rex_r([], size, rd));
    if (size == 8) {
      buf_push_byte(a.code, 176 + (rd & 7));  // B0+rb ib
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    buf_push_byte(a.code, 184 + (rd & 7));  // B8+rd
    x86_push_arr(a.code, x86_imm_wide([], size, imm));
    return a;
  }
  // What is left is a rip-relative operand or a refusal.
  let src_mem: boolean = x86_gas_has_paren(src);
  let dst_mem: boolean = x86_gas_has_paren(dst);
  if (src_mem && !dst_mem) {
    let ml: GasMem = x86_gas_parse_mem(src);
    let rl: i32 = x86_gas_reg_w(dst, size);
    if (x86_gas_mem_ok(ml) && rl >= 0 && size == 64) {
      return x86_mov_load_rip_label(a, rl, ml.label);
    }
    if (x86_gas_mem_ok(ml) && rl >= 0 && size == 32) {
      return x86_movl_load_rip_label(a, rl, ml.label);
    }
  }
  if (dst_mem && !src_mem) {
    let ms: GasMem = x86_gas_parse_mem(dst);
    let rs: i32 = x86_gas_reg_w(src, size);
    if (x86_gas_mem_ok(ms) && rs >= 0 && size == 64) {
      return x86_mov_store_rip_label(a, rs, ms.label);
    }
    if (x86_gas_mem_ok(ms) && rs >= 0 && size == 32) {
      return x86_movl_store_rip_label(a, rs, ms.label);
    }
  }
  return x86_gas_bad(a, mnem + " " + src + ", " + dst);
}

// x86_gas_split_ops splits an operand list on top-level commas (commas
// inside `(%b,%i,s)` do not separate operands), trimming each piece.
function x86_gas_split_ops(rest: string): string[] {
  let out: string[] = [];
  let s: string = rest;
  let c: i32 = x86_gas_top_comma(s);
  while (c >= 0) {
    out = out.append(x86_gas_trim(slice_unchecked(s, 0, c)));
    s = slice_unchecked(s, c + 1, s.len()) + "";
    c = x86_gas_top_comma(s);
  }
  return out.append(x86_gas_trim(s));
}

// BEGIN GENERATED GPR GROUP TABLES (cmd/x86tblgen) — do not edit by hand.
// x86_gas_alu_ext maps an ALU base mnemonic to its group-1 /digit; the
// family's MR opcode row is ext*8 (add 00, or 08, adc 10, sbb 18, and 20,
// sub 28, xor 30, cmp 38).
function x86_gas_alu_ext(mnem: string): i32 {
  match (mnem) {
    "add" => {
      return 0;
    },
    "or" => {
      return 1;
    },
    "adc" => {
      return 2;
    },
    "sbb" => {
      return 3;
    },
    "and" => {
      return 4;
    },
    "sub" => {
      return 5;
    },
    "xor" => {
      return 6;
    },
    "cmp" => {
      return 7;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// x86_gas_unary_ext maps an F6/F7-group base mnemonic to its /digit.
function x86_gas_unary_ext(mnem: string): i32 {
  match (mnem) {
    "not" => {
      return 2;
    },
    "neg" => {
      return 3;
    },
    "mul" => {
      return 4;
    },
    "imul" => {
      return 5;
    },
    "div" => {
      return 6;
    },
    "idiv" => {
      return 7;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// x86_gas_incdec_ext maps inc/dec to their FE/FF-group /digit.
function x86_gas_incdec_ext(mnem: string): i32 {
  match (mnem) {
    "inc" => {
      return 0;
    },
    "dec" => {
      return 1;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// x86_gas_shift_ext maps a shift/rotate base mnemonic to its C0..D3-group
// /digit. sal is gas's alias for shl and takes shl's /4.
function x86_gas_shift_ext(mnem: string): i32 {
  match (mnem) {
    "rol" => {
      return 0;
    },
    "ror" => {
      return 1;
    },
    "rcl" => {
      return 2;
    },
    "rcr" => {
      return 3;
    },
    "shl" => {
      return 4;
    },
    "sal" => {
      return 4;
    },
    "shr" => {
      return 5;
    },
    "sar" => {
      return 7;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// x86_gas_bt_idx maps the bit-test family to its index: the register-form
// opcode is 0xA3 + idx*8 and the immediate-form /digit is 4 + idx.
function x86_gas_bt_idx(mnem: string): i32 {
  match (mnem) {
    "bt" => {
      return 0;
    },
    "bts" => {
      return 1;
    },
    "btr" => {
      return 2;
    },
    "btc" => {
      return 3;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// x86_gas_lockable: the base mnemonics the F0 lock prefix may precede —
// anything else is #UD at runtime, so it is refused at assembly.
function x86_gas_lockable(mnem: string): boolean {
  let names: string[] = [
    "adc",
    "add",
    "and",
    "btc",
    "btr",
    "bts",
    "cmpxchg",
    "dec",
    "inc",
    "neg",
    "not",
    "or",
    "sbb",
    "sub",
    "xadd",
    "xchg",
    "xor",
  ];
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == mnem) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

