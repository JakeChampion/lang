// x86_gas_emit_packed appends a packed fixed-byte sequence.
function x86_gas_emit_packed(own a: X86Asm, packed: i32): X86Asm {
  let n: i32 = packed / 16777216;
  buf_push_byte(a.code, packed & 255);
  if (n >= 2) {
    buf_push_byte(a.code, packed / 256 & 255);
  }
  if (n >= 3) {
    buf_push_byte(a.code, packed / 65536 & 255);
  }
  return a;
}

// ---- integer families ----

// x86_gas_alu_family assembles one sized ALU instruction (AT&T src, dst):
// reg/reg, memory source, memory destination, and the immediate forms with
// the 83 short-immediate selection — mirroring the native alu().
function x86_gas_alu_family(own a: X86Asm, mnem: string, ext: i32, size: i32, src: string, dst: string): X86Asm {
  let b: i32[] = x86_rec_alu(ext, size, src, dst);
  if (b.len() > 0) {
    x86_push_arr(a.code, b);
    return a;
  }
  // What is left is a rip-relative operand or a refusal.
  if (src.len() > 0 && src[0] == b'$') {
    if (!x86_gas_has_paren(dst)) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    let mi: GasMem = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(mi)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    let imm: i32 = x86_gas_atoi(src);
    if (size == 8 || x86_imm_fits8(imm)) {
      let opi: i32 = 131;  // 83 /ext ib
      if (size == 8) {  // 80 /ext ib
        opi = 128;
      }
      a = x86_gas_mem_op(a, size, false, opi, ext, mi, false, 1);
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    let ib: i32 = 4;
    if (size == 16) {
      ib = 2;
    }
    a = x86_gas_mem_op(a, size, false, 129, ext, mi, false, ib);
    x86_push_arr(a.code, x86_imm_wide([], size, imm));
    return a;
  }
  let src_mem: boolean = x86_gas_has_paren(src);
  let dst_mem: boolean = x86_gas_has_paren(dst);
  if (src_mem != dst_mem) {
    let mt: string = dst;
    let rt: string = src;
    let op: i32 = ext * 8;  // store form: opbase, reg = source
    if (src_mem) {
      mt = src;
      rt = dst;
      op = op | 2;  // load form: opbase|2, reg = destination
    }
    let m: GasMem = x86_gas_parse_mem(mt);
    let r: i32 = x86_gas_reg_w(rt, size);
    if (x86_gas_mem_ok(m) && r >= 0) {
      return x86_gas_mem_op(a, size, false, x86_opsel(op, size), r, m, x86_rex8_force(size, r), 0);
    }
  }
  return x86_gas_bad(a, mnem + " " + src + ", " + dst);
}

// x86_rec_alu is the group-1 op `ext` (add, or, adc, sbb, and, sub, xor, cmp)
// at `size` bits from an immediate, a register or a memory operand that is not
// rip-relative.
pub function x86_rec_alu(ext: i32, size: i32, src: string, dst: string): i32[] {
  let opbase: i32 = ext * 8;
  if (src.len() > 0 && src[0] == b'$') {
    let imm: i32 = x86_gas_atoi(src);
    if (x86_gas_has_paren(dst)) {
      let mi: GasMem = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi) || mi.is_rip) {
        return [];
      }
      if (size == 8 || x86_imm_fits8(imm)) {
        let opi: i32 = 131;  // 83 /ext ib
        if (size == 8) {  // 80 /ext ib
          opi = 128;
        }
        return x86_mem_op_bytes([], size, false, opi, ext, mi, false).append(imm & 255);
      }
      return x86_imm_wide(x86_mem_op_bytes([], size, false, 129, ext, mi, false), size, imm);
    }
    let rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return [];
    }
    return x86_rec_alu_ir(ext, size, imm, rd);
  }
  let src_mem: boolean = x86_gas_has_paren(src);
  let dst_mem: boolean = x86_gas_has_paren(dst);
  if (src_mem && dst_mem) {
    return [];
  }
  if (src_mem || dst_mem) {
    let mt: string = dst;
    let rt: string = src;
    let op: i32 = opbase;  // store form: opbase, reg = source
    if (src_mem) {
      mt = src;
      rt = dst;
      op = opbase | 2;  // load form: opbase|2, reg = destination
    }
    let m: GasMem = x86_gas_parse_mem(mt);
    let r: i32 = x86_gas_reg_w(rt, size);
    if (!x86_gas_mem_ok(m) || m.is_rip || r < 0) {
      return [];
    }
    return x86_mem_op_bytes([], size, false, x86_opsel(op, size), r, m, x86_rex8_force(size, r));
  }
  let r1: i32 = x86_gas_reg_w(src, size);
  let r2: i32 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0) {
    return [];
  }
  return x86_rec_alu_rr(ext, size, r1, r2);
}

// x86_push_arr appends an encoder's bytes to the builder `b`.
function x86_push_arr(b: usize, xs: i32[]): void {
  for x in xs {
    buf_push_byte(b, x);
  }
}

// x86_gas_test_family: test at every width — reg/reg (84/85 MR), a memory
// operand on either side, and the F6/F7 /0 immediate forms.
function x86_gas_test_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
  let b: i32[] = x86_rec_test(size, src, dst);
  if (b.len() > 0) {
    x86_push_arr(a.code, b);
    return a;
  }
  // What is left is a rip-relative operand or a refusal.
  if (src.len() > 0 && src[0] == b'$') {
    if (!x86_gas_has_paren(dst)) {
      return x86_gas_bad(a, "test " + src + ", " + dst);
    }
    let mi: GasMem = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(mi)) {
      return x86_gas_bad(a, "test " + dst);
    }
    let imm: i32 = x86_gas_atoi(src);
    let ib: i32 = 4;
    if (size == 8) {
      ib = 1;
    }
    if (size == 16) {
      ib = 2;
    }
    a = x86_gas_mem_op(a, size, false, x86_opsel(246, size), 0, mi, false, ib);
    if (size == 8) {
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    x86_push_arr(a.code, x86_imm_wide([], size, imm));
    return a;
  }
  let src_mem: boolean = x86_gas_has_paren(src);
  if (src_mem != x86_gas_has_paren(dst)) {
    let mop: string = src;
    let rop: string = dst;
    if (!src_mem) {
      mop = dst;
      rop = src;
    }
    let m2: GasMem = x86_gas_parse_mem(mop);
    let rr: i32 = x86_gas_reg_w(rop, size);
    if (x86_gas_mem_ok(m2) && rr >= 0) {
      return x86_gas_mem_op(a, size, false, x86_opsel(132, size), rr, m2, x86_rex8_force(size, rr), 0);
    }
  }
  return x86_gas_bad(a, "test " + src + ", " + dst);
}

// x86_rec_test is `test` at `size` bits from an immediate, a register or a
// memory operand that is not rip-relative.
pub function x86_rec_test(size: i32, src: string, dst: string): i32[] {
  if (src.len() > 0 && src[0] == b'$') {
    let imm: i32 = x86_gas_atoi(src);
    if (x86_gas_has_paren(dst)) {
      let mi: GasMem = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi) || mi.is_rip) {
        return [];
      }
      let mb: i32[] = x86_mem_op_bytes([], size, false, x86_opsel(246, size), 0, mi, false);
      if (size == 8) {
        return mb.append(imm & 255);
      }
      return x86_imm_wide(mb, size, imm);
    }
    let rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return [];
    }
    return x86_rec_test_ir(size, imm, rd);
  }
  let src_mem: boolean = x86_gas_has_paren(src);
  let dst_mem: boolean = x86_gas_has_paren(dst);
  if (src_mem && dst_mem) {
    return [];
  }
  if (src_mem || dst_mem) {  // one memory side: 84/85 with reg = the register
    let mop: string = src;
    let rop: string = dst;
    if (dst_mem) {
      mop = dst;
      rop = src;
    }
    let m2: GasMem = x86_gas_parse_mem(mop);
    let rr: i32 = x86_gas_reg_w(rop, size);
    if (!x86_gas_mem_ok(m2) || m2.is_rip || rr < 0) {
      return [];
    }
    return x86_mem_op_bytes([], size, false, x86_opsel(132, size), rr, m2, x86_rex8_force(size, rr));
  }
  let r1: i32 = x86_gas_reg_w(src, size);
  let r2: i32 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0) {
    return [];
  }
  return x86_rec_test_rr(size, r1, r2);
}

// x86_gas_unary_family: the F6/F7 (opbase 246) and FE/FF (opbase 254)
// one-operand groups, register or sized memory (rip included).
function x86_gas_unary_family(own a: X86Asm, mnem: string, opbase: i32, ext: i32, size: i32, op: string): X86Asm {
  if (x86_gas_has_paren(op)) {
    let m: GasMem = x86_gas_parse_mem(op);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + op);
    }
    return x86_gas_mem_op(a, size, false, x86_opsel(opbase, size), ext, m, false, 0);
  }
  let r: i32 = x86_gas_reg_w(op, size);
  if (r < 0) {
    return x86_gas_bad(a, mnem + " " + op);
  }
  x86_push_arr(a.code, x86_unary_r([], size, opbase, ext, r));
  return a;
}

// x86_gas_shift_family: shifts and rotates — count in %cl (D2/D3), $1
// (D0/D1, the form GNU as selects for a count of one), or $imm8 (C0/C1) —
// on a register or sized memory destination.
function x86_gas_shift_family(own a: X86Asm, mnem: string, ext: i32, size: i32, src: string, dst: string): X86Asm {
  let by_cl: boolean = src == "%cl";
  if (!by_cl && (src.len() == 0 || src[0] != b'$')) {
    return x86_gas_bad(a, mnem + " " + src);
  }
  let imm: i32 = 0;
  if (!by_cl) {
    imm = x86_gas_atoi(src);
  }
  if (x86_gas_has_paren(dst)) {
    let m: GasMem = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    let op: i32 = x86_opsel(210, size);  // D2/D3 %cl
    let tail: i32 = 0;
    if (!by_cl) {
      if (imm == 1) {
        op = x86_opsel(208, size);
      } else {
        op = x86_opsel(192, size);
        tail = 1;
      }
    }
    a = x86_gas_mem_op(a, size, false, op, ext, m, false, tail);
    if (tail == 1) {
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    return a;
  }
  let r: i32 = x86_gas_reg_w(dst, size);
  if (r < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (by_cl) {
    x86_push_arr(a.code, x86_shift_r_cl([], size, ext, r));
    return a;
  }
  x86_push_arr(a.code, x86_shift_r_imm([], size, ext, r, imm));
  return a;
}

// x86_gas_shld_family: shld (0F A4/A5) / shrd (0F AC/AD) — the
// double-precision shifts: `$imm|%cl, %src, r/m-dst`. ModRM.reg is the
// SOURCE, the reverse of the usual direction. No 8-bit form.
function x86_gas_shld_family(own a: X86Asm, mnem: string, opimm: i32, size: i32, rest: string): X86Asm {
  let ops: string[] = x86_gas_split_ops(rest);
  if (ops.len() != 3 || size == 8) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let rs: i32 = x86_gas_reg_w(ops[1], size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let by_cl: boolean = ops[0] == "%cl";
  if (!by_cl && (ops[0].len() == 0 || ops[0][0] != b'$')) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let op: i32 = opimm;
  if (by_cl) {
    op = opimm + 1;
  }
  let imm: i32 = 0;
  let tail: i32 = 0;
  if (!by_cl) {
    imm = x86_gas_atoi(ops[0]);
    tail = 1;
  }
  if (x86_gas_has_paren(ops[2])) {
    let m: GasMem = x86_gas_parse_mem(ops[2]);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + ops[2]);
    }
    a = x86_gas_mem_op(a, size, true, op, rs, m, false, tail);
    if (!by_cl) {
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    return a;
  }
  let rd: i32 = x86_gas_reg_w(ops[2], size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  x86_push_arr(a.code, x86_op0f_rr([], size, op, rs, rd));
  if (!by_cl) {
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  return a;
}

// x86_gas_bt_family: bt/bts/btr/btc — `%reg|$imm8, r/m` (AT&T: the bit
// index comes first). Register form 0F A3/AB/B3/BB with reg = the index;
// immediate form 0F BA /4../7 ib. No 8-bit form.
function x86_gas_bt_family(own a: X86Asm, mnem: string, idx: i32, size: i32, src: string, dst: string): X86Asm {
  if (size == 8) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (src.len() > 0 && src[0] == b'$') {
    let imm: i32 = x86_gas_atoi(src);
    if (x86_gas_has_paren(dst)) {
      let mi: GasMem = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi)) {
        return x86_gas_bad(a, mnem + " " + dst);
      }
      a = x86_gas_mem_op(a, size, true, 186, 4 + idx, mi, false, 1);
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    let rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    x86_push_arr(a.code, x86_op0f_rr([], size, 186, 4 + idx, rd));
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  let rs: i32 = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let regop: i32 = 163 + idx * 8;
  if (x86_gas_has_paren(dst)) {
    let m: GasMem = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    return x86_gas_mem_op(a, size, true, regop, rs, m, false, 0);
  }
  let rd2: i32 = x86_gas_reg_w(dst, size);
  if (rd2 < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  x86_push_arr(a.code, x86_op0f_rr([], size, regop, rs, rd2));
  return a;
}

// x86_gas_rmw_family: xadd (0F C0/C1) and cmpxchg (0F B0/B1) — reg source
// in ModRM.reg, register or memory destination.
function x86_gas_rmw_family(own a: X86Asm, mnem: string, opbase: i32, size: i32, src: string, dst: string): X86Asm {
  let rs: i32 = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let op: i32 = x86_opsel(opbase, size);
  if (x86_gas_has_paren(dst)) {
    let m: GasMem = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    return x86_gas_mem_op(a, size, true, op, rs, m, x86_rex8_force(size, rs), 0);
  }
  let rd: i32 = x86_gas_reg_w(dst, size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  x86_push_arr(a.code, x86_op0f_rr([], size, op, rs, rd));
  return a;
}

// x86_gas_xchg_family: xchg (86/87) — reg/reg or a memory operand on
// either side (the memory form is implicitly locked by the CPU).
function x86_gas_xchg_family(own a: X86Asm, mnem: string, size: i32, src: string, dst: string): X86Asm {
  let src_mem: boolean = x86_gas_has_paren(src);
  let dst_mem: boolean = x86_gas_has_paren(dst);
  if (src_mem != dst_mem) {
    let mop: string = src;
    let rop: string = dst;
    if (dst_mem) {
      mop = dst;
      rop = src;
    }
    let m: GasMem = x86_gas_parse_mem(mop);
    let rr: i32 = x86_gas_reg_w(rop, size);
    if (!x86_gas_mem_ok(m) || rr < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_mem_op(a, size, false, x86_opsel(134, size), rr, m, x86_rex8_force(size, rr), 0);
  }
  let r1: i32 = x86_gas_reg_w(src, size);
  let r2: i32 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0 || src_mem) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  x86_push_arr(a.code, x86_op_rr([], size, 134, r1, r2));
  return a;
}

// x86_gas_cmov_family: cmov<cc> with the full condition table and W/L/W16
// widths. A bare condition spelling (`cmovne`) takes its width from the
// destination register; a trailing size suffix (`cmovneq`) is explicit.
function x86_gas_cmov_family(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
  let cond: string = slice_unchecked(mnem, 4, mnem.len()) + "";
  let size: i32 = 0;
  let cc: i32 = x86_gas_cc_code(cond);
  if (cc >= 0) {
    size = 64;
    if (x86_gas_reg32(dst) >= 0) {
      size = 32;
    }
    if (x86_gas_reg16(dst) >= 0) {
      size = 16;
    }
  } else {
    size = x86_gas_suffix_size(mnem);
    if (size == 0 || size == 8) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    cc = x86_gas_cc_code(slice_unchecked(cond, 0, cond.len() - 1) + "");
    if (cc < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
  }
  let rd: i32 = x86_gas_reg_w(dst, size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (x86_gas_has_paren(src)) {
    let m: GasMem = x86_gas_parse_mem(src);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + src);
    }
    return x86_gas_mem_op(a, size, true, 64 + cc, rd, m, false, 0);
  }
  let rs: i32 = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  x86_push_arr(a.code, x86_cmovcc_rr([], size, cc, rd, rs));
  return a;
}

// x86_gas_imul_family: imul at 1 operand (the widening F6/F7 /5 form), 2
// operands (0F AF /r, reg = dst, register or memory source), or 3 operands
// (`$imm, %src, %dst` — 6B /r ib or 69 /r iw/id). No 8-bit two/three-op form.
function x86_gas_imul_family(own a: X86Asm, mnem: string, size: i32, rest: string): X86Asm {
  let ops: string[] = x86_gas_split_ops(rest);
  if (ops.len() == 1) {
    return x86_gas_unary_family(a, mnem, 246, 5, size, ops[0]);
  }
  if (size == 8) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  if (ops.len() == 2) {
    let rd: i32 = x86_gas_reg_w(ops[1], size);
    if (rd < 0) {
      return x86_gas_bad(a, mnem + " " + rest);
    }
    if (x86_gas_has_paren(ops[0])) {
      let m: GasMem = x86_gas_parse_mem(ops[0]);
      if (!x86_gas_mem_ok(m)) {
        return x86_gas_bad(a, mnem + " " + ops[0]);
      }
      return x86_gas_mem_op(a, size, true, 175, rd, m, false, 0);
    }
    let rs: i32 = x86_gas_reg_w(ops[0], size);
    if (rs < 0) {
      return x86_gas_bad(a, mnem + " " + rest);
    }
    x86_push_arr(a.code, x86_op0f_rr([], size, 175, rd, rs));
    return a;
  }
  if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let imm: i32 = x86_gas_atoi(ops[0]);
  let rs3: i32 = x86_gas_reg_w(ops[1], size);
  let rd3: i32 = x86_gas_reg_w(ops[2], size);
  if (rs3 < 0 || rd3 < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  x86_push_arr(a.code, x86_osz([], size));
  x86_push_arr(a.code, x86_rex_rr([], size, rd3, rs3));
  if (x86_imm_fits8(imm)) {
    buf_push_byte(a.code, 107);  // 6B /r ib
    buf_push_byte(a.code, x86_modrm(3, rd3, rs3));
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  buf_push_byte(a.code, 105);  // 69 /r iw/id
  buf_push_byte(a.code, x86_modrm(3, rd3, rs3));
  x86_push_arr(a.code, x86_imm_wide([], size, imm));
  return a;
}

// x86_gas_bswap: bswap r32/r64 (0F C8+rd). The 16-bit form is
// architecturally undefined and there is no byte form — both refuse.
function x86_gas_bswap(own a: X86Asm, mnem: string, size: i32, op: string): X86Asm {
  if (size != 32 && size != 64) {
    return x86_gas_bad(a, mnem + " " + op);
  }
  let r: i32 = x86_gas_reg_w(op, size);
  if (r < 0) {
    return x86_gas_bad(a, mnem + " " + op);
  }
  let rex: i32 = x86_rex(x86_rex_w_of(size), 0, 0, r);
  if (rex != 64) {
    buf_push_byte(a.code, rex);
  }
  buf_push_byte(a.code, 15);
  buf_push_byte(a.code, 200 + (r & 7));
  return a;
}

// x86_gas_crc32_family: `crc32{b,w,l,q} src, r32/r64` — 66? F2 0F 38 F0/F1
// /r; the suffix names the SOURCE width (the 66 for a word source precedes
// the mandatory F2), REX.W follows the destination. A 64-bit destination
// pairs only with byte and qword sources; a 32-bit one with b/w/l.
function x86_gas_crc32_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
  let dsize: i32 = 32;
  let rd: i32 = x86_gas_reg32(dst);
  if (rd < 0) {
    rd = x86_gas_reg64(dst);
    dsize = 64;
  }
  if (rd < 0) {
    return x86_gas_bad(a, "crc32 " + dst);
  }
  if (dsize == 64 && size != 8 && size != 64) {
    return x86_gas_bad(a, "crc32 " + src + ", " + dst);
  }
  if (dsize == 32 && size == 64) {
    return x86_gas_bad(a, "crc32 " + src + ", " + dst);
  }
  let op: i32 = 241;
  if (size == 8) {
    op = 240;
  }
  if (size == 16) {
    buf_push_byte(a.code, 102);
  }
  buf_push_byte(a.code, 242);
  if (x86_gas_has_paren(src)) {
    let m: GasMem = x86_gas_parse_mem(src);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, "crc32 " + src);
    }
    x86_push_arr(a.code, x86_gas_mem_rex([], dsize, rd, m, false));
    buf_push_byte(a.code, 15);
    buf_push_byte(a.code, 56);
    buf_push_byte(a.code, op);
    return x86_gas_membytes(a, rd, m, 0);
  }
  let rs: i32 = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, "crc32 " + src + ", " + dst);
  }
  let rex: i32 = x86_rex(x86_rex_w_of(dsize), rd, 0, rs);
  if (rex != 64 || x86_rex8_force(size, rs)) {
    buf_push_byte(a.code, rex);
  }
  buf_push_byte(a.code, 15);
  buf_push_byte(a.code, 56);
  buf_push_byte(a.code, op);
  buf_push_byte(a.code, x86_modrm(3, rd, rs));
  return a;
}

// ---- SSE tables and emitters ----

// BEGIN GENERATED SSE TABLES (cmd/x86tblgen) — do not edit by hand.
// x86_gas_sse_fp_op: the scalar/packed FLOAT half of the two-byte-opcode
// SSE table (`[pfx] 0F op /r`, xmm destination), packed as pfx*256+op;
// -1 when absent.
function x86_gas_sse_fp_op(mnem: string): i32 {
  match (mnem) {
    "addsd" => {
      return 242 * 256 + 88;
    },
    "subsd" => {
      return 242 * 256 + 92;
    },
    "mulsd" => {
      return 242 * 256 + 89;
    },
    "divsd" => {
      return 242 * 256 + 94;
    },
    "sqrtsd" => {
      return 242 * 256 + 81;
    },
    "minsd" => {
      return 242 * 256 + 93;
    },
    "maxsd" => {
      return 242 * 256 + 95;
    },
    "addss" => {
      return 243 * 256 + 88;
    },
    "subss" => {
      return 243 * 256 + 92;
    },
    "mulss" => {
      return 243 * 256 + 89;
    },
    "divss" => {
      return 243 * 256 + 94;
    },
    "sqrtss" => {
      return 243 * 256 + 81;
    },
    "minss" => {
      return 243 * 256 + 93;
    },
    "maxss" => {
      return 243 * 256 + 95;
    },
    "ucomisd" => {
      return 102 * 256 + 46;
    },
    "comisd" => {
      return 102 * 256 + 47;
    },
    "ucomiss" => {
      return 46;
    },
    "comiss" => {
      return 47;
    },
    "cvtss2sd" => {
      return 243 * 256 + 90;
    },
    "cvtsd2ss" => {
      return 242 * 256 + 90;
    },
    "movapd" => {
      return 102 * 256 + 40;
    },
    "movaps" => {
      return 40;
    },
    "xorpd" => {
      return 102 * 256 + 87;
    },
    "xorps" => {
      return 87;
    },
    "andpd" => {
      return 102 * 256 + 84;
    },
    "andps" => {
      return 84;
    },
    "andnpd" => {
      return 102 * 256 + 85;
    },
    "andnps" => {
      return 85;
    },
    "orpd" => {
      return 102 * 256 + 86;
    },
    "orps" => {
      return 86;
    },
    "addpd" => {
      return 102 * 256 + 88;
    },
    "subpd" => {
      return 102 * 256 + 92;
    },
    "mulpd" => {
      return 102 * 256 + 89;
    },
    "divpd" => {
      return 102 * 256 + 94;
    },
    "sqrtpd" => {
      return 102 * 256 + 81;
    },
    "minpd" => {
      return 102 * 256 + 93;
    },
    "maxpd" => {
      return 102 * 256 + 95;
    },
    "addps" => {
      return 88;
    },
    "subps" => {
      return 92;
    },
    "mulps" => {
      return 89;
    },
    "divps" => {
      return 94;
    },
    "sqrtps" => {
      return 81;
    },
    "minps" => {
