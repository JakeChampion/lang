// x86_gas_sse_op consults both halves of the SSE table.
function x86_gas_sse_op(mnem: string): i32 {
    var v: i32 = x86_gas_sse_fp_op(mnem);
    if (v >= 0) { return v; }
    return x86_gas_sse_int_op(mnem);
}





// x86_gas_sse_mem: `[pfx] [REX] 0F <op>` + memory rm (rip included) — the
// memory side of the SSE table ops and the movdq/mov10 directions.
function x86_gas_sse_mem(own a: X86Asm, pfx: i32, op: i32, reg: i32, m: GasMem, tail: i32): X86Asm {
    if (pfx != 0) { a = X86Asm { ...a, code: a.code.append(pfx) }; }
    a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, 32, reg, m, false) };
    a = X86Asm { ...a, code: a.code.append(15) };
    a = X86Asm { ...a, code: a.code.append(op) };
    return x86_gas_membytes(a, reg, m, tail);
