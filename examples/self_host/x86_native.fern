// x86_gas_bt_family: bt/bts/btr/btc — `%reg|$imm8, r/m` (AT&T: the bit
// index comes first). Register form 0F A3/AB/B3/BB with reg = the index;
// immediate form 0F BA /4../7 ib. No 8-bit form.
function x86_gas_bt_family(own a: X86Asm, mnem: string, idx: i32, size: i32, src: string, dst: string): X86Asm {
    if (size == 8) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (src.len() > 0 && src[0] == b'$') {
        var imm: i32 = x86_gas_atoi(src);
        if (x86_str_contains(dst, "(")) {
            var mi: GasMem = x86_gas_parse_mem(dst);
            if (!x86_gas_mem_ok(mi)) { return x86_gas_bad(a, mnem + " " + dst); }
            a = x86_gas_mem_op(a, size, true, 186, 4 + idx, mi, false, 1);
            return X86Asm { ...a, code: a.code.append(imm & 255) };
        }
        var rd: i32 = x86_gas_reg_w(dst, size);
        if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_op0f_rr(a.code, size, 186, 4 + idx, rd) };
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    var regop: i32 = 163 + idx * 8;
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + dst); }
        return x86_gas_mem_op(a, size, true, regop, rs, m, false, 0);
    }
    var rd2: i32 = x86_gas_reg_w(dst, size);
    if (rd2 < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op0f_rr(a.code, size, regop, rs, rd2) };
}

// x86_gas_rmw_family: xadd (0F C0/C1) and cmpxchg (0F B0/B1) — reg source
// in ModRM.reg, register or memory destination.
function x86_gas_rmw_family(own a: X86Asm, mnem: string, opbase: i32, size: i32, src: string, dst: string): X86Asm {
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    var op: i32 = x86_opsel(opbase, size);
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + dst); }
        return x86_gas_mem_op(a, size, true, op, rs, m, x86_rex8_force(size, rs), 0);
    }
    var rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op0f_rr(a.code, size, op, rs, rd) };
}

// x86_gas_xchg_family: xchg (86/87) — reg/reg or a memory operand on
// either side (the memory form is implicitly locked by the CPU).
function x86_gas_xchg_family(own a: X86Asm, mnem: string, size: i32, src: string, dst: string): X86Asm {
    var src_mem: boolean = x86_str_contains(src, "(");
    var dst_mem: boolean = x86_str_contains(dst, "(");
    if (src_mem != dst_mem) {
        var mop: string = src;
        var rop: string = dst;
        if (dst_mem) { mop = dst; rop = src; }
        var m: GasMem = x86_gas_parse_mem(mop);
        var rr: i32 = x86_gas_reg_w(rop, size);
        if (!x86_gas_mem_ok(m) || rr < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return x86_gas_mem_op(a, size, false, x86_opsel(134, size), rr, m, x86_rex8_force(size, rr), 0);
    }
    var r1: i32 = x86_gas_reg_w(src, size);
    var r2: i32 = x86_gas_reg_w(dst, size);
    if (r1 < 0 || r2 < 0 || src_mem) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op_rr(a.code, size, 134, r1, r2) };
}

// x86_gas_cmov_family: cmov<cc> with the full condition table and W/L/W16
// widths. A bare condition spelling (`cmovne`) takes its width from the
// destination register; a trailing size suffix (`cmovneq`) is explicit.
function x86_gas_cmov_family(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
    var cond: string = slice_unchecked(mnem, 4, mnem.len()) + "";
    var size: i32 = 0;
    var cc: i32 = x86_gas_cc_code(cond);
    if (cc >= 0) {
        size = 64;
        if (x86_gas_reg32(dst) >= 0) { size = 32; }
        if (x86_gas_reg16(dst) >= 0) { size = 16; }
    } else {
        size = x86_gas_suffix_size(mnem);
        if (size == 0 || size == 8) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        cc = x86_gas_cc_code(slice_unchecked(cond, 0, cond.len() - 1) + "");
        if (cc < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    }
    var rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + src); }
        return x86_gas_mem_op(a, size, true, 64 + cc, rd, m, false, 0);
    }
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_cmovcc_rr(a.code, size, cc, rd, rs) };
}

// x86_gas_imul_family: imul at 1 operand (the widening F6/F7 /5 form), 2
// operands (0F AF /r, reg = dst, register or memory source), or 3 operands
// (`$imm, %src, %dst` — 6B /r ib or 69 /r iw/id). No 8-bit two/three-op form.
function x86_gas_imul_family(own a: X86Asm, mnem: string, size: i32, rest: string): X86Asm {
    var ops: string[] = x86_gas_split_ops(rest);
    if (ops.len() == 1) { return x86_gas_unary_family(a, mnem, 246, 5, size, ops[0]); }
    if (size == 8) { return x86_gas_bad(a, mnem + " " + rest); }
    if (ops.len() == 2) {
        var rd: i32 = x86_gas_reg_w(ops[1], size);
        if (rd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
        if (x86_str_contains(ops[0], "(")) {
            var m: GasMem = x86_gas_parse_mem(ops[0]);
            if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + ops[0]); }
            return x86_gas_mem_op(a, size, true, 175, rd, m, false, 0);
        }
        var rs: i32 = x86_gas_reg_w(ops[0], size);
        if (rs < 0) { return x86_gas_bad(a, mnem + " " + rest); }
        return X86Asm { ...a, code: x86_op0f_rr(a.code, size, 175, rd, rs) };
    }
    if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') { return x86_gas_bad(a, mnem + " " + rest); }
    var imm: i32 = x86_gas_atoi(ops[0]);
    var rs3: i32 = x86_gas_reg_w(ops[1], size);
    var rd3: i32 = x86_gas_reg_w(ops[2], size);
    if (rs3 < 0 || rd3 < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    a = X86Asm { ...a, code: x86_osz(a.code, size) };
    a = X86Asm { ...a, code: x86_rex_rr(a.code, size, rd3, rs3) };
    if (x86_imm_fits8(imm)) {
        a = X86Asm { ...a, code: a.code.append(107) }; // 6B /r ib
        a = X86Asm { ...a, code: a.code.append(x86_modrm(3, rd3, rs3)) };
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    a = X86Asm { ...a, code: a.code.append(105) };     // 69 /r iw/id
    a = X86Asm { ...a, code: a.code.append(x86_modrm(3, rd3, rs3)) };
    return X86Asm { ...a, code: x86_imm_wide(a.code, size, imm) };
}

// x86_gas_bswap: bswap r32/r64 (0F C8+rd). The 16-bit form is
// architecturally undefined and there is no byte form — both refuse.
function x86_gas_bswap(own a: X86Asm, mnem: string, size: i32, op: string): X86Asm {
    if (size != 32 && size != 64) { return x86_gas_bad(a, mnem + " " + op); }
    var r: i32 = x86_gas_reg_w(op, size);
    if (r < 0) { return x86_gas_bad(a, mnem + " " + op); }
    var rex: i32 = x86_rex(x86_rex_w_of(size), 0, 0, r);
    if (rex != 64) { a = X86Asm { ...a, code: a.code.append(rex) }; }
    a = X86Asm { ...a, code: a.code.append(15) };
    return X86Asm { ...a, code: a.code.append(200 + (r & 7)) };
}

// x86_gas_crc32_family: `crc32{b,w,l,q} src, r32/r64` — 66? F2 0F 38 F0/F1
// /r; the suffix names the SOURCE width (the 66 for a word source precedes
// the mandatory F2), REX.W follows the destination. A 64-bit destination
// pairs only with byte and qword sources; a 32-bit one with b/w/l.
function x86_gas_crc32_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
    var dsize: i32 = 32;
    var rd: i32 = x86_gas_reg32(dst);
    if (rd < 0) { rd = x86_gas_reg64(dst); dsize = 64; }
    if (rd < 0) { return x86_gas_bad(a, "crc32 " + dst); }
    if (dsize == 64 && size != 8 && size != 64) { return x86_gas_bad(a, "crc32 " + src + ", " + dst); }
    if (dsize == 32 && size == 64) { return x86_gas_bad(a, "crc32 " + src + ", " + dst); }
    var op: i32 = 241;
    if (size == 8) { op = 240; }
    if (size == 16) { a = X86Asm { ...a, code: a.code.append(102) }; }
    a = X86Asm { ...a, code: a.code.append(242) };
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, "crc32 " + src); }
        a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, dsize, rd, m, false) };
        a = X86Asm { ...a, code: a.code.append(15) };
        a = X86Asm { ...a, code: a.code.append(56) };
        a = X86Asm { ...a, code: a.code.append(op) };
        return x86_gas_membytes(a, rd, m, 0);
    }
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, "crc32 " + src + ", " + dst); }
    var rex: i32 = x86_rex(x86_rex_w_of(dsize), rd, 0, rs);
    if (rex != 64 || x86_rex8_force(size, rs)) { a = X86Asm { ...a, code: a.code.append(rex) }; }
    a = X86Asm { ...a, code: a.code.append(15) };
    a = X86Asm { ...a, code: a.code.append(56) };
    a = X86Asm { ...a, code: a.code.append(op) };
    return X86Asm { ...a, code: a.code.append(x86_modrm(3, rd, rs)) };
