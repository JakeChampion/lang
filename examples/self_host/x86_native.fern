// ---- AVX2: the VEX-encoded forms the runtime kernels use ----
//
// Native's avx.go vocabulary — vmovdqu (load), vpbroadcastb, vpcmpeqb,
// vpmovmskb and vzeroupper over a 256-bit ymm — plus the vmovdqu store,
// kept out of the shared x86tbl tables, which assume legacy encoding
// throughout. AVX2 is inside the x86-64-v3 baseline, so nothing here is
// guarded.

// x86_vex appends the VEX prefix: the 2-byte form (C5) whenever it can
// carry the instruction — the 0F map, W clear, neither X nor B needed —
// which is what GNU as emits, and the 3-byte form (C4) otherwise. rex_r,
// rex_x and rex_b are the REX bits the instruction would carry without VEX
// and are stored inverted; vvvv is the second source register, inverted
// too, 0 when unused.
function x86_vex(own buf: i32[], rex_r: boolean, rex_x: boolean, rex_b: boolean, mmmmm: i32, w: boolean, vvvv: i32, l: boolean, pp: i32): i32[] {
  let vinv: i32 = (15 - (vvvv & 15)) * 8;
  let lbit: i32 = 0;
  if (l) {
    lbit = 4;
  }
  if (mmmmm == 1 && !w && !rex_x && !rex_b) {
    let b2: i32 = pp & 3 | lbit | vinv;
    if (!rex_r) {
      b2 = b2 | 128;
    }
    buf = buf.append(197);
    return buf.append(b2);
  }
  let c2: i32 = mmmmm & 31;
  if (!rex_r) {
    c2 = c2 | 128;
  }
  if (!rex_x) {
    c2 = c2 | 64;
  }
  if (!rex_b) {
    c2 = c2 | 32;
  }
  let c3: i32 = pp & 3 | lbit | vinv;
  if (w) {
    c3 = c3 | 128;
  }
  buf = buf.append(196);
  buf = buf.append(c2);
  return buf.append(c3);
}

// x86_gas_vex_rm emits one VEX instruction whose ModRM.rm is a memory
// operand or a register: the prefix from the operand's REX bits, the
// opcode, then the ModRM (+SIB+disp).
function x86_gas_vex_rm(own a: X86Asm, mnem: string, mmmmm: i32, pp: i32, vvvv: i32, op: i32, reg: i32, rm: string): X86Asm {
  if (x86_gas_has_paren(rm)) {
    let m: GasMem = x86_gas_parse_mem(rm);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + rm);
    }
    let ix: boolean = false;
    let bs: boolean = false;
    if (!m.is_rip) {
      if (m.has_index) {
        ix = m.index >= 8;
      }
      bs = m.base >= 8;
    }
    x86_push_arr(a.code, x86_vex([], reg >= 8, ix, bs, mmmmm, false, vvvv, true, pp));
    buf_push_byte(a.code, op);
    return x86_gas_membytes(a, reg, m, 0);
  }
  let rr: i32 = x86_gas_ymm(rm);
  if (rr < 0) {
    return x86_gas_bad(a, mnem + " " + rm);
  }
  x86_push_arr(a.code, x86_vex([], reg >= 8, false, rr >= 8, mmmmm, false, vvvv, true, pp));
  buf_push_byte(a.code, op);
  buf_push_byte(a.code, x86_modrm(3, reg, rr));
  return a;
}

// x86_gas_vex_two: the two-operand AVX2 forms, AT&T `src, dst` —
// `vmovdqu ymm/m256, %ymm` (VEX.256.F3.0F 6F /r), its store `vmovdqu
// %ymm, m256` (VEX.256.F3.0F 7F /r), `vpbroadcastb %xmm, %ymm`
// (VEX.256.66.0F38 78 /r) and `vpmovmskb %ymm, %r32` (VEX.256.66.0F D7
// /r). A 64-bit vpmovmskb destination is not a form the kernels use, so it
// is refused.
function x86_gas_vex_two(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
  if (mnem == "vmovdqu" && x86_gas_has_paren(dst)) {
    let ys0: i32 = x86_gas_ymm(src);
    if (ys0 < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_vex_rm(a, mnem, 1, 2, 0, 127, ys0, dst);
  }
  if (mnem == "vmovdqu") {
    let yd: i32 = x86_gas_ymm(dst);
    if (yd < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_vex_rm(a, mnem, 1, 2, 0, 111, yd, src);
  }
  if (mnem == "vpbroadcastb") {
    let bd: i32 = x86_gas_ymm(dst);
    let bx: i32 = x86_gas_xmm(src);
    if (bd < 0 || bx < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    x86_push_arr(a.code, x86_vex([], bd >= 8, false, bx >= 8, 2, false, 0, true, 1));
    buf_push_byte(a.code, 120);
    buf_push_byte(a.code, x86_modrm(3, bd, bx));
    return a;
  }
  let rd: i32 = x86_gas_reg32(dst);
  let ys: i32 = x86_gas_ymm(src);
  if (rd < 0 || ys < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  x86_push_arr(a.code, x86_vex([], rd >= 8, false, ys >= 8, 1, false, 0, true, 1));
  buf_push_byte(a.code, 215);
  buf_push_byte(a.code, x86_modrm(3, rd, ys));
  return a;
}

function x86_gas_is_vex_two(mnem: string): boolean {
  return mnem == "vmovdqu" || mnem == "vpbroadcastb" || mnem == "vpmovmskb";
}

// x86_gas_vpcmpeqb: the three-operand `vpcmpeqb src2, %ymm_src1, %ymm_dst`
// (VEX.256.66.0F 74 /r), src2 a ymm or memory; src1 rides in VEX.vvvv.
function x86_gas_vpcmpeqb(own a: X86Asm, mnem: string, rest: string): X86Asm {
  let ops: string[] = x86_gas_split_ops(rest);
  if (ops.len() != 3) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let y1: i32 = x86_gas_ymm(ops[1]);
  let yd: i32 = x86_gas_ymm(ops[2]);
  if (y1 < 0 || yd < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  return x86_gas_vex_rm(a, mnem, 1, 1, y1, 116, yd, ops[0]);
}

// ---- fixed-byte mnemonics ----

function x86_pack1(b0: i32): i32 {
  return 16777216 + b0;
}

function x86_pack2(b0: i32, b1: i32): i32 {
  return 33554432 + b1 * 256 + b0;
}

function x86_pack3(b0: i32, b1: i32, b2: i32): i32 {
  return 50331648 + b2 * 65536 + b1 * 256 + b0;
}

