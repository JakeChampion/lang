// examples/self_host/x86_native.fern — the x86-64 Linux native-binary
// backend as a single module: the x86-64 machine-code encoder + named-
// label assembler (was x86_encode.fern) and the GAS-text front-end (was
// x86_gas.fern). Merged into one module so the unified fern CLI can
// `import "./x86_native"` and drive emit -> assemble -> ELF without
// cross-module bare references — the same reason arm64_native.fern is one
// module. The container half is elf.fern. The pieces stay logically
// separable; the section banners below mark the former file boundaries.

// ============================================================
// PART 1 — x86-64 encoder + named-label assembler
// ============================================================

// Formerly examples/self_host/x86_encode.fern — x86-64 machine-code
// encoding primitives for the self-hosted *native* backend (slice 2a of the
// native-binary track; the container half is elf.fern). This is the
// assembler half: it turns instructions into the raw bytes an ELF .text
// section holds, mirroring internal/native/x86_64/asm.go.
//
// Strategy (matching the wasm binary track): the eventual native emitter
// will *assemble the already-tested asm.fern text* — tokenize → parse →
// encode — rather than duplicate asm.fern's instruction selection. This
// slice provides the lowest layer that work builds on: the byte-level
// encoders for a core integer + syscall instruction subset, enough to
// assemble (with elf.fern) a runnable exit(N) program end-to-end.
//
// Conventions (matching leb128.fern / wat_encode.fern / elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each encoder
//     appends to it and returns the (possibly grown) buffer.
//   * This module is intentionally **import-free** so the native emitter
//     can `import "./x86_encode"` and the unit test can concatenate it
//     with a driver `main()` for the single-module wasm_run driver.
//
// Register numbering (System V / Intel low-3-bit encoding, shared between
// the 32-bit eXX and 64-bit rXX views — only the prefix/opcode picks the
// operand size). Slice 2a covers the 8 base registers (0..7); the
// extended registers r8..r15 (which need REX.R / REX.B) come in a later
// slice.


function x86_rax(): i32 { return 0; }
function x86_rcx(): i32 { return 1; }
function x86_rdx(): i32 { return 2; }
function x86_rbx(): i32 { return 3; }
function x86_rsp(): i32 { return 4; }
function x86_rbp(): i32 { return 5; }
function x86_rsi(): i32 { return 6; }
function x86_rdi(): i32 { return 7; }

// x86_rex_w is the REX.W prefix (0x48): "this is a 64-bit operation" with
// no extended-register bits (the operands are r0..r7).
function x86_rex_w(): i32 { return 72; }

// x86_rex builds a REX prefix byte 0x40 | W<<3 | R<<2 | X<<1 | B, setting
// the extension bits from the register numbers: REX.R for a ModR/M reg
// field >= 8, REX.X for a SIB index >= 8, REX.B for the ModR/M rm / SIB
// base / opcode-embedded register >= 8. Pass w=1 for 64-bit ops. Registers
// r8..r15 are numbered 8..15; the low 3 bits go in the ModR/M / SIB
// fields (which already mask with & 7).
function x86_rex(w: i32, reg: i32, index: i32, base: i32): i32 {
    var v: i32 = 64; // 0x40
    if (w != 0) { v = v | 8; }
    if (reg >= 8) { v = v | 4; }
    if (index >= 8) { v = v | 2; }
    if (base >= 8) { v = v | 1; }
    return v;
}

// x86_le32 appends the 4 bytes of `v`, little-endian (for imm32 / disp32).
// `>>` is arithmetic; the `& 255` after each shift discards sign-extended
// high bits, so the result is correct for any 32-bit value.
function x86_le32(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 24) & 255);
    return buf;
}

// x86_modrm builds a ModR/M byte: (mod << 6) | (reg << 3) | rm. mod=3
// (0b11) selects the register-direct form (rm names a register, not a
// memory operand).
function x86_modrm(md: i32, reg: i32, rm: i32): i32 {
    return ((md & 3) << 6) | ((reg & 7) << 3) | (rm & 7);
}

// ---- instruction encoders ----

// x86_mov_r32_imm32: `mov <reg32>, imm32` — opcode 0xB8+rd then imm32.
// The 32-bit write zero-extends into the full 64-bit register, which is
// the cheapest way to load a small constant (e.g. a syscall number). For
// r8..r15 a REX.B prefix (no W) extends the embedded register.
function x86_mov_r32_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    buf = buf.append(184 + (reg & 7)); // 0xB8 + rd
    return x86_le32(buf, imm);
}

// x86_mov_r64_imm32: `movq $imm, <reg>` — REX.W + 0xC7 /0 id. The immediate
// is SIGN-extended; x86_mov_r32_imm32 above zero-extends and is correct only
// for immediates known non-negative.
function x86_mov_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    buf = buf.append(x86_rex(1, 0, 0, reg));
    buf = buf.append(199); // 0xC7
    buf = buf.append(x86_modrm(3, 0, reg));
    return x86_le32(buf, imm);
}

// x86_mov_r64_r64: `mov <dst>, <src>` (64-bit) — REX.W + 0x89 /r, where
// the ModR/M reg field is the source and r/m is the destination.
function x86_mov_r64_r64(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, dst));
    buf = buf.append(137); // 0x89
    buf = buf.append(x86_modrm(3, src, dst));
    return buf;
}

// x86_add_r64_r64: `add <dst>, <src>` (64-bit) — REX.W + 0x01 /r.
function x86_add_r64_r64(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, dst));
    buf = buf.append(1); // 0x01
    buf = buf.append(x86_modrm(3, src, dst));
    return buf;
}

// x86_sub_r64_r64: `sub <dst>, <src>` (64-bit) — REX.W + 0x29 /r.
function x86_sub_r64_r64(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, dst));
    buf = buf.append(41); // 0x29
    buf = buf.append(x86_modrm(3, src, dst));
    return buf;
}

// x86_push_r64: `push <reg>` — 0x50+rd (a REX.B prefix for r8..r15;
// push defaults to 64-bit, so no REX.W).
function x86_push_r64(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B = 0x41
    }
    return buf.append(80 + (reg & 7)); // 0x50 + rd
}

// x86_push_imm32: `push $imm` (0x68 id) — push a sign-extended imm32.
function x86_push_imm32(buf: i32[], imm: i32): i32[] {
    buf = buf.append(104); // 0x68
    return x86_le32(buf, imm);
}

// x86_pop_r64: `pop <reg>` — 0x58+rd (REX.B for r8..r15).
function x86_pop_r64(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    return buf.append(88 + (reg & 7)); // 0x58 + rd
}

// x86_syscall: the 2-byte `syscall` instruction (0x0F 0x05).
function x86_syscall(buf: i32[]): i32[] {
    buf = buf.append(15); // 0x0F
    buf = buf.append(5);  // 0x05
    return buf;
}

// x86_ret: `ret` (0xC3).
function x86_ret(buf: i32[]): i32[] {
    return buf.append(195); // 0xC3
}


// ---- width-generic integer encoders ----
//
// `size` is the operand width in bits (8/16/32/64), taken from the AT&T
// mnemonic suffix. Shared rules, mirroring internal/native/x86_64: a
// 16-bit op carries the 0x66 prefix, an 8-bit op selects the byte opcode
// (opbase without |1), and a byte register 4..7 (spl..dil) forces an
// otherwise-empty REX — unprefixed, the same numbers select ah..bh.

// x86_opsel returns the width-selected opcode: opbase for 8-bit, opbase|1
// for the wider sizes.
function x86_opsel(opbase: i32, size: i32): i32 {
    if (size == 8) { return opbase; }
    return opbase | 1;
}

// x86_osz appends the 0x66 operand-size prefix for 16-bit operations.
function x86_osz(buf: i32[], size: i32): i32[] {
    if (size == 16) { return buf.append(102); }
    return buf;
}

// x86_rex8_force: an 8-bit register operand spl/bpl/sil/dil needs a REX.
function x86_rex8_force(size: i32, reg: i32): boolean {
    return size == 8 && reg >= 4 && reg <= 7;
}

// x86_rex_w_of maps a size to the REX.W bit.
function x86_rex_w_of(size: i32): i32 {
    if (size == 64) { return 1; }
    return 0;
}

// x86_rex_rr appends the REX for a two-register form (ModRM reg + rm).
function x86_rex_rr(buf: i32[], size: i32, reg: i32, rm: i32): i32[] {
    var rex: i32 = x86_rex(x86_rex_w_of(size), reg, 0, rm);
    if (rex != 64 || x86_rex8_force(size, reg) || x86_rex8_force(size, rm)) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_rex_r appends the REX for a form whose only register is ModRM.rm.
function x86_rex_r(buf: i32[], size: i32, reg: i32): i32[] {
    var rex: i32 = x86_rex(x86_rex_w_of(size), 0, 0, reg);
    if (rex != 64 || x86_rex8_force(size, reg)) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_op_rr: `[66] [REX] op /r`, ModR/M direct — the shape every
// two-register group op shares (mov 0x88, the ALU rows, test 0x84,
// xchg 0x86).
function x86_op_rr(buf: i32[], size: i32, opbase: i32, reg: i32, rm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_rr(buf, size, reg, rm);
    buf = buf.append(x86_opsel(opbase, size));
    return buf.append(x86_modrm(3, reg, rm));
}

// x86_op0f_rr: `[66] [REX] 0F op /r`, ModR/M direct — cmovcc / bt / imul /
// xadd / cmpxchg. `op` arrives fully width-selected.
function x86_op0f_rr(buf: i32[], size: i32, op: i32, reg: i32, rm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_rr(buf, size, reg, rm);
    buf = buf.append(15);
    buf = buf.append(op);
    return buf.append(x86_modrm(3, reg, rm));
}

// x86_imm_fits8 reports whether the sign-extended-imm8 short forms
// (83 /ext, 6B /r, 6A) can carry `v`.
function x86_imm_fits8(v: i32): boolean {
    return v >= (0 - 128) && v <= 127;
}

// x86_imm_wide appends an immediate at the operation width — imm16 for the
// 66-prefixed forms, imm32 otherwise (byte forms append directly).
function x86_imm_wide(buf: i32[], size: i32, imm: i32): i32[] {
    if (size == 16) {
        buf = buf.append(imm & 255);
        return buf.append((imm >> 8) & 255);
    }
    return x86_le32(buf, imm);
}

// x86_grp1_imm_r: `<alu> $imm, %reg` — 80 /ext ib for a byte register, else
// 83 /ext ib when the immediate fits signed 8 bits, else 81 /ext iw/id.
// Using 83/81 for a byte operand would silently widen it (#3544's class).
//
// The accumulator has its own one-byte-shorter opcodes, 04+8*ext for AL and
// 05+8*ext for AX/EAX/RAX, which carry no ModR/M. They only pay past the 83
// form, which is shorter still for an immediate that fits signed 8 bits.
function x86_grp1_imm_r(buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    if (size == 8) {
        // x86_gas_reg8 cannot spell ah/ch/dh/bh, so reg 0 is always al.
        if (reg == 0) {
            buf = buf.append(4 + ext * 8);
            return buf.append(imm & 255);
        }
        buf = buf.append(128);
        buf = buf.append(x86_modrm(3, ext, reg));
        return buf.append(imm & 255);
    }
    if (x86_imm_fits8(imm)) {
        buf = buf.append(131);
        buf = buf.append(x86_modrm(3, ext, reg));
        return buf.append(imm & 255);
    }
    if (reg == 0) {
        buf = buf.append(5 + ext * 8);
        return x86_imm_wide(buf, size, imm);
    }
    buf = buf.append(129);
    buf = buf.append(x86_modrm(3, ext, reg));
    return x86_imm_wide(buf, size, imm);
}

// x86_unary_r: the one-operand groups on a register — F6/F7 (not /2, neg
// /3, mul /4, imul /5, div /6, idiv /7) and FE/FF (inc /0, dec /1).
function x86_unary_r(buf: i32[], size: i32, opbase: i32, ext: i32, reg: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    buf = buf.append(x86_opsel(opbase, size));
    return buf.append(x86_modrm(3, ext, reg));
}

// x86_test_imm_r: `test $imm, %reg` — F6 /0 ib or F7 /0 iw/id (test has no
// sign-extended-imm8 short form), and A8 ib / A9 iw|id for the accumulator,
// which carries no ModR/M.
function x86_test_imm_r(buf: i32[], size: i32, reg: i32, imm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    if (reg == 0) {
        buf = buf.append(x86_opsel(168, size));
        if (size == 8) { return buf.append(imm & 255); }
        return x86_imm_wide(buf, size, imm);
    }
    buf = buf.append(x86_opsel(246, size));
    buf = buf.append(x86_modrm(3, 0, reg));
    if (size == 8) { return buf.append(imm & 255); }
    return x86_imm_wide(buf, size, imm);
}

// x86_shift_r_imm: the C0/C1 shift-and-rotate group on a register, using
// the D0/D1 short form when the count is 1 (what GNU as selects).
function x86_shift_r_imm(buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    if (imm == 1) {
        buf = buf.append(x86_opsel(208, size)); // D0/D1
        return buf.append(x86_modrm(3, ext, reg));
    }
    buf = buf.append(x86_opsel(192, size)); // C0/C1
    buf = buf.append(x86_modrm(3, ext, reg));
    return buf.append(imm & 255);
}

// x86_shift_r_cl: the D2/D3 variable-count (%cl) shift form on a register.
function x86_shift_r_cl(buf: i32[], size: i32, ext: i32, reg: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    buf = buf.append(x86_opsel(210, size)); // D2/D3
    return buf.append(x86_modrm(3, ext, reg));
}

// x86_cmovcc_rr: `cmov<cc> %src, %dst` ([66] [REX] 0F 40+cc /r; reg=dst).
function x86_cmovcc_rr(buf: i32[], size: i32, cc: i32, dst: i32, src: i32): i32[] {
    return x86_op0f_rr(buf, size, 64 + (cc & 15), dst, src);
}

// x86_cqo: `cqo` (0x48 0x99) — sign-extend rax into rdx:rax before idiv.
function x86_cqo(buf: i32[]): i32[] {
    buf = buf.append(x86_rex_w());
    buf = buf.append(153); // 0x99
    return buf;
}

// ---- memory operands (slice 2e) ----
//
// A memory operand `[base + disp]` is encoded by the ModR/M byte's mod/rm
// fields plus an optional SIB byte and displacement. Two registers need
// special handling:
//   * rsp (rm=100) is the SIB escape — any `[rsp + …]` needs a SIB byte
//     (scale=0, index=100=none, base=100=rsp);
//   * rbp (rm=101) can't use mod=00 (that encoding means RIP-relative), so
//     `[rbp]` is emitted as mod=01 with a zero disp8.
// mod selects the displacement size: 00 = none, 01 = disp8, 10 = disp32.
// Slice 2e covers the base registers (0..7); index/scale addressing is a
// later need.

// x86_sib builds a SIB byte: (scale << 6) | (index << 3) | base.
function x86_sib(scale: i32, index: i32, base: i32): i32 {
    return ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7);
}

// x86_emit_mem appends the ModR/M (+ optional SIB + displacement) for a
// memory operand `[base + disp]` with the given ModR/M `reg` field (the
// other operand — a register for load/store).
function x86_emit_mem(buf: i32[], reg: i32, base: i32, disp: i32): i32[] {
    var b: i32 = base & 7;
    var is_rsp: boolean = (b == 4); // SIB escape
    var is_rbp: boolean = (b == 5); // no mod=00 form

    var md: i32 = 2;        // default: disp32
    var has_disp8: boolean = false;
    if (disp == 0 && !is_rbp) {
        md = 0;             // no displacement
    } else if (disp >= (0 - 128) && disp <= 127) {
        md = 1;             // disp8
        has_disp8 = true;
    }

    buf = buf.append(x86_modrm(md, reg, b));
    if (is_rsp) {
        buf = buf.append(x86_sib(0, 4, 4)); // [rsp], no index
    }
    if (has_disp8) {
        buf = buf.append(disp & 255);
    } else {
        if (md == 2) {
            buf = x86_le32(buf, disp);
        }
    }
    return buf;
}

// x86_mov_load_r64: `mov <dst>, [base + disp]` — REX.W + 0x8B /r.
function x86_mov_load_r64(buf: i32[], dst: i32, base: i32, disp: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, 0, base));
    buf = buf.append(139); // 0x8B
    return x86_emit_mem(buf, dst, base, disp);
}

// x86_mov_store_r64: `mov [base + disp], <src>` — REX.W + 0x89 /r.
function x86_mov_store_r64(buf: i32[], base: i32, disp: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, base));
    buf = buf.append(137); // 0x89
    return x86_emit_mem(buf, src, base, disp);
}

// ---- SIB index addressing (slice 2j) ----
//
// `[base + index*scale + disp]` needs a SIB byte (ModR/M rm = 100). The
// scale field encodes 1/2/4/8 as 0/1/2/3. base rbp/r13 still forces a
// disp8 (no mod=00 form), as in x86_emit_mem.

// x86_lea_idx_nobase: `lea disp(,%index,scale), <dst>` — REX.W 8D with a
// SIB whose base field is 101 (no base) and mod=00, so a disp32 always
// follows. Element-offset computation.
// x86_lea_load emits `lea` at any destination width: 0x8D with the same
// reg-mem operand as the ALU loads, under an operand-size prefix for 16 and
// REX.W for 64. The REX byte is emitted only when it carries something —
// a bare 0x40 is legal but not what gas writes, and the differential
// compares bytes.
function x86_lea_load(buf: i32[], size: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = x86_osz(buf, size);
    var w: i32 = 0;
    if (size == 64) { w = 1; }
    var rex: i32 = x86_rex(w, dst, ix, base);
    if (rex != 64) { buf = buf.append(rex); }
    buf = buf.append(141); // 0x8D
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

function x86_lea_idx_nobase(buf: i32[], dst: i32, index: i32, scale: i32, disp: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, index, 0));
    buf = buf.append(141); // 0x8D
    buf = buf.append(x86_modrm(0, dst, 4)); // SIB follows
    buf = buf.append(x86_sib(x86_scale_bits(scale), index, 5)); // base 101 = none
    return x86_le32(buf, disp);
}

// x86_scale_bits maps a scale (1/2/4/8) to its 2-bit SIB field.
function x86_scale_bits(scale: i32): i32 {
    if (scale == 2) { return 1; }
    if (scale == 4) { return 2; }
    if (scale == 8) { return 3; }
    return 0; // scale 1 (or default)
}

// x86_emit_mem_idx appends the ModR/M + SIB (+ displacement) for
// `[base + index*scale + disp]` with the given ModR/M `reg` field.
function x86_emit_mem_idx(buf: i32[], reg: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
    var b: i32 = base & 7;
    var is_rbp: boolean = (b == 5);
    var md: i32 = 2;
    var has_disp8: boolean = false;
    if (disp == 0 && !is_rbp) {
        md = 0;
    } else {
        if (disp >= (0 - 128) && disp <= 127) {
            md = 1;
            has_disp8 = true;
        }
    }
    buf = buf.append(x86_modrm(md, reg, 4)); // rm = 100 -> SIB
    buf = buf.append(x86_sib(x86_scale_bits(scale), index, base));
    if (has_disp8) {
        buf = buf.append(disp & 255);
    } else {
        if (md == 2) {
            buf = x86_le32(buf, disp);
        }
    }
    return buf;
}

// x86_mov_load_r64_idx: `mov <dst>, [base + index*scale + disp]`.
function x86_mov_load_r64_idx(buf: i32[], dst: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, index, base));
    buf = buf.append(139); // 0x8B
    return x86_emit_mem_idx(buf, dst, base, index, scale, disp);
}

// x86_mov_store_r64_idx: `mov [base + index*scale + disp], <src>`.
function x86_mov_store_r64_idx(buf: i32[], base: i32, index: i32, scale: i32, disp: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, index, base));
    buf = buf.append(137); // 0x89
    return x86_emit_mem_idx(buf, src, base, index, scale, disp);
}

// ---- byte ops (slice 2k) ----
//
// Byte (8-bit) memory ops reuse the ModR/M + SIB encoding (x86_emit_mem /
// _idx) with byte opcodes and a W=0 REX that's emitted only when needed
// (an extended reg/base/index, or — for a byte register operand — when it
// is spl..dil (4..7), which require a REX to disambiguate from ah..bh).
// movzbq's destination is 64-bit, so it always carries REX.W.

// x86_byte_mem_rex emits the (optional) REX for a byte memory op.
function x86_byte_mem_rex(buf: i32[], w: i32, reg: i32, has_index: boolean, index: i32, base: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    var rex: i32 = x86_rex(w, reg, ix, base);
    var force: boolean = (w == 0 && reg >= 4 && reg <= 7); // spl..dil
    if (rex != 64 || force) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_byte_mem_operand appends the ModR/M (+SIB+disp), index or not.
function x86_byte_mem_operand(buf: i32[], reg: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    if (has_index) {
        return x86_emit_mem_idx(buf, reg, base, index, scale, disp);
    }
    return x86_emit_mem(buf, reg, base, disp);
}

// x86_movb_imm_mem: `movb $imm8, mem` (0xC6 /0 ib).
function x86_movb_imm_mem(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32, imm: i32): i32[] {
    buf = x86_byte_mem_rex(buf, 0, 0, has_index, index, base);
    buf = buf.append(198); // 0xC6
    buf = x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
    return buf.append(imm & 255);
}

// x86_movb_reg_mem: `movb <reg8>, mem` (0x88 /r) — byte store.
function x86_movb_reg_mem(buf: i32[], reg8: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    buf = x86_byte_mem_rex(buf, 0, reg8, has_index, index, base);
    buf = buf.append(136); // 0x88
    return x86_byte_mem_operand(buf, reg8, base, has_index, index, scale, disp);
}

// x86_movzb_mem: `movzb{l,q} mem, <dst>` (0F B6 /r) — zero-extend a
// byte load into a 64-bit register.
function x86_movzb_mem(buf: i32[], w: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    return x86_movext_mem(buf, 182, w, dst, base, has_index, index, scale, disp);
}

// x86_movext_mem is x86_movext_reg's memory-source form.
// Verified vs gas: movsbl (%rax),%ecx = 0F BE 08, movsbq (%r9),%r11 =
// 4D 0F BE 19, movswl (%rax),%ecx = 0F BF 08.
function x86_movext_mem(buf: i32[], op: i32, w: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    // Not x86_byte_mem_rex: its force rule exists for a BYTE register
    // operand, and here the reg field is the 32-/64-bit destination while the
    // narrow value lives in memory. Forcing on `dst` 4..7 would put a bare
    // 0x40 in front of `movzbl (%rax), %esi`, which gas does not.
    var rex: i32 = x86_rex(w, dst, ix, base);
    if (rex != 64) { buf = buf.append(rex); }
    buf = buf.append(15); // 0x0F
    buf = buf.append(op);
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_movzb_reg: `movzb{l,q} <src8>, <dst>` (0F B6 /r, reg-direct), `w`
// selecting the 64-bit destination. A byte SOURCE of spl/bpl/sil/dil needs a
// REX of its own even when nothing else does, or those numbers name ah/ch/dh/bh.
function x86_movzb_reg(buf: i32[], w: i32, dst: i32, src8: i32): i32[] {
    return x86_movext_reg(buf, 182, w, dst, src8);
}

// x86_movext_reg is the whole extend family, reg-direct: `op` is 0F B6/B7 for
// the zero-extending byte/word loads and 0F BE/BF for the sign-extending
// ones, and `w` selects a 64-bit destination.
//
// Verified vs gas: movsbl %al,%ecx = 0F BE C8, movsbq %al,%rcx = 48 0F BE C8,
// movswl %ax,%ecx = 0F BF C8, movswq %ax,%rcx = 48 0F BF C8.
function x86_movext_reg(buf: i32[], op: i32, w: i32, dst: i32, src: i32): i32[] {
    var rex: i32 = x86_rex(w, dst, 0, src);
    // A byte SOURCE of spl/bpl/sil/dil needs a REX of its own even when
    // nothing else does, or those numbers name ah/ch/dh/bh. A WORD source
    // has no such ambiguity, so the force applies only to the byte opcodes.
    var force: boolean = (op == 182 || op == 190) && x86_rex8_force(8, src);
    if (rex != 64 || force) { buf = buf.append(rex); }
    buf = buf.append(15); // 0x0F
    buf = buf.append(op);
    return buf.append(x86_modrm(3, dst, src));
}

// ---- push/pop memory (slice 2l) ----

// x86_push_mem: `push mem` (0xFF /6) — push a memory operand.
function x86_push_mem(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    var rex: i32 = x86_rex(0, 0, ix, base);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(255); // 0xFF
    return x86_byte_mem_operand(buf, 6, base, has_index, index, scale, disp);
}

// x86_pop_mem: `pop mem` (0x8F /0).
function x86_pop_mem(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    var rex: i32 = x86_rex(0, 0, ix, base);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(143); // 0x8F
    return x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
}

// x86_setcc_reg8: `set<cc> <reg8>` (0F 90+cc /0) — store the condition
// flag as a 0/1 byte. `op` is the second opcode byte (e.g. 0x9C setl).
// reg8 spl..dil (4..7) need a REX to disambiguate from ah..bh.
function x86_setcc_reg8(buf: i32[], op: i32, reg8: i32): i32[] {
    var rex: i32 = x86_rex(0, 0, 0, reg8);
    var force: boolean = (reg8 >= 4 && reg8 <= 7);
    if (rex != 64 || force) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(op);
    buf = buf.append(x86_modrm(3, 0, reg8));
    return buf;
}

// x86_alu_load_r64: `<op> <dst>, mem` with a memory *source* — the
// load-form ALU (add 0x03, sub 0x2B, cmp 0x3B; reg=dst, r/m=mem).
function x86_alu_load_r64(buf: i32[], opcode: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, dst, ix, base));
    buf = buf.append(opcode);
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// ---- SSE double + .double constants (slice 2n) ----
//
// asm.fern uses scalar-double SSE for f64: a `.double` constant in
// .rodata loaded with `movsd sym(%rip)`, the value shuttled to/from a GPR
// with `movq %xmm,%gpr` / `movq %gpr,%xmm`, arithmetic with
// addsd/subsd/mulsd/divsd, and int<->float conversions cvttsd2si /
// cvtsi2sd. xmm registers are numbered 0..15 (REX.R/.B for xmm8..15).

// x86_le64_i64 appends the 8 little-endian bytes of an i64 (e.g. the
// IEEE-754 bits of a .double constant).
function x86_le64_i64(buf: i32[], v: i64): i32[] {
    buf = buf.append((v & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 32) & 255) as i32);
    buf = buf.append(((v >> 40) & 255) as i32);
    buf = buf.append(((v >> 48) & 255) as i32);
    buf = buf.append(((v >> 56) & 255) as i32);
    return buf;
}

// x86_movq_gpr_to_xmm: `movq <gpr>, <xmm>` (66 REX.W 0F 6E /r) — move the
// raw 64 bits from a GPR into an xmm (reg=xmm, r/m=gpr).
function x86_movq_gpr_to_xmm(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    buf = buf.append(x86_rex(1, xmm, 0, gpr));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(110); // 0x6E
    buf = buf.append(x86_modrm(3, xmm, gpr));
    return buf;
}

// x86_movq_xmm_to_gpr: `movq <xmm>, <gpr>` (66 REX.W 0F 7E /r).
function x86_movq_xmm_to_gpr(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    buf = buf.append(x86_rex(1, xmm, 0, gpr));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(126); // 0x7E
    buf = buf.append(x86_modrm(3, xmm, gpr));
    return buf;
}

// x86_sse_any_rr: `[pfx] [REX] 0F <op> /r` with a direct ModR/M — the
// whole two-byte-opcode SSE surface in one shape. The mandatory prefix
// selects the operand flavour (F2 scalar double, F3 scalar single, 66
// packed double / packed integer, 0 = none, the ps forms) and goes BEFORE
// the REX. ModRM.reg is the first register (usually the xmm destination;
// pmovmskb/movmsk pass the GPR destination there).
function x86_sse_any_rr(buf: i32[], pfx: i32, opcode: i32, reg: i32, rm: i32): i32[] {
    if (pfx != 0) { buf = buf.append(pfx); }
    var rex: i32 = x86_rex(0, reg, 0, rm);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(opcode);
    return buf.append(x86_modrm(3, reg, rm));
}

// x86_sse_3a_imm: `66 [REX] 0F 3A <op> /r ib` direct — roundsd/roundss,
// pcmpistri/pcmpestri, and the pextr/pinsr register forms. `w` sets REX.W
// (pextrq/pinsrq).
function x86_sse_3a_imm(buf: i32[], w: i32, opcode: i32, reg: i32, rm: i32, imm: i32): i32[] {
    buf = buf.append(102); // 0x66
    var rex: i32 = x86_rex(w, reg, 0, rm);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(58); // 0x3A
    buf = buf.append(opcode);
    buf = buf.append(x86_modrm(3, reg, rm));
    return buf.append(imm & 255);
}

// x86_movd_gpr_to_xmm: `movd <xmm>, <gpr32>` (66 0F 6E /r) — the 32-bit
// sibling of x86_movq_gpr_to_xmm.
function x86_movd_gpr_to_xmm(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    var rex: i32 = x86_rex(0, xmm, 0, gpr);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15);  // 0x0F
    buf = buf.append(110); // 0x6E
    return buf.append(x86_modrm(3, xmm, gpr));
}

// x86_movd_xmm_to_gpr: `movd <gpr32>, <xmm>` (66 0F 7E /r) — the inverse.
function x86_movd_xmm_to_gpr(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    var rex: i32 = x86_rex(0, xmm, 0, gpr);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15);  // 0x0F
    buf = buf.append(126); // 0x7E
    return buf.append(x86_modrm(3, xmm, gpr));
}

// ---- packed SSE2 (the fused vector kernels of ATLAS-PLATFORM-PLAN §3) ----
//
// Before these this assembler had no packed surface at all — only the scalar
// float ops that shuttle an f64 through xmm. That gap is §3.3a's rule: check
// the assembler for every target a vector kernel is about to be emitted on,
// and land the encodings first. Its failure mode here is a refusal (the
// mnemonic lands on `unknown` and the driver rejects the output), not a wrong
// answer — but a refusal to compile is still a break.
//
// SSE2 is inside the declared x86-64 baseline (Haswell-class), so a selected
// instruction is a hard requirement and there is nothing to feature-detect.

// x86_bitscan_r32: the `[REX] 0F <op> /r` direct-ModR/M shape shared by bsf
// (0xBC) and bsr (0xBD). Both set ZF when the source is zero and leave the
// destination undefined, which is why callers branch on ZF first.
function x86_bitscan_r32(buf: i32[], opcode: i32, dst: i32, src: i32): i32[] {
    return x86_bitscan_rr(buf, 0, opcode, 0, dst, src);
}

// x86_bitscan_rr is the shape every bit scan and count shares:
// [pfx] [REX.W] 0F <op> /r, direct ModR/M. pfx is 0 for bsf/bsr and F3 for
// the BMI1/POPCNT counts.
function x86_bitscan_rr(buf: i32[], pfx: i32, opcode: i32, w: i32, dst: i32, src: i32): i32[] {
    if (pfx != 0) { buf = buf.append(pfx); }
    var rex: i32 = x86_rex(w, dst, 0, src);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(opcode);
    return buf.append(x86_modrm(3, dst, src));
}

// x86_bsf_r32: `bsfl <src32>, <dst32>` (0F BC /r) — the index of the LOWEST
// set bit. NOT tzcnt: that is BMI1, and below the baseline its F3 prefix is
// ignored so it decodes as this instruction anyway.
function x86_bsf_r32(buf: i32[], dst: i32, src: i32): i32[] {
    return x86_bitscan_r32(buf, 188, dst, src); // 0xBC
}

// x86_bsr_r32: `bsrl <src32>, <dst32>` (0F BD /r) — the index of the HIGHEST
// set bit, which over a pmovmskb mask is the RIGHTMOST matching byte. That is
// the one instruction separating __rmemchr's vector body from __memchr's;
// lzcnt is the BMI1 sibling and returns a leading-zero COUNT rather than a bit
// index, so it is not a drop-in even where the baseline allows it.
function x86_bsr_r32(buf: i32[], dst: i32, src: i32): i32[] {
    return x86_bitscan_r32(buf, 189, dst, src); // 0xBD
}

// ---- bit-count (Haswell baseline: BMI1 + SSE4.2) ----
//
// lzcnt / tzcnt / popcnt share one shape: F3 [REX.W] 0F <op> /r, direct
// ModR/M. Below the baseline LZCNT/TZCNT decode as bsr/bsf and give wrong
// answers silently, where POPCNT faults — see docs/BACKEND-PARITY.md.
function x86_bitcnt_rr(buf: i32[], opcode: i32, w: i32, dst: i32, src: i32): i32[] {
    return x86_bitscan_rr(buf, 243, opcode, w, dst, src);
}

function x86_lzcnt_rr(buf: i32[], w: i32, dst: i32, src: i32): i32[] {
    return x86_bitcnt_rr(buf, 189, w, dst, src); // 0xBD
}

function x86_tzcnt_rr(buf: i32[], w: i32, dst: i32, src: i32): i32[] {
    return x86_bitcnt_rr(buf, 188, w, dst, src); // 0xBC
}

function x86_popcnt_rr(buf: i32[], w: i32, dst: i32, src: i32): i32[] {
    return x86_bitcnt_rr(buf, 184, w, dst, src); // 0xB8
}

// The scalar int<->float converts are one encoding with two operand
// directions. `pfx` picks the precision — F2 double, F3 single — and `op`
// picks the operation: 2C truncating float->int, 2D rounding float->int, 2A
// int->float. In every one of them `w` is load-bearing rather than a choice
// of encoding: the 32-bit form reads or writes only the low half.
//   F2|F3 [REX.W] 0F <op> /r
//
// Verified vs gas: cvttsd2si %xmm1,%eax = F2 0F 2C C1,
// cvtsd2si %xmm1,%rax = F2 48 0F 2D C1, cvtss2si %xmm1,%eax = F3 0F 2D C1,
// cvttss2si %xmm9,%r11 = F3 4D 0F 2C D9, cvtsi2ss %rax,%xmm1 = F3 48 0F 2A C8.
function x86_cvt_to_gpr(buf: i32[], pfx: i32, op: i32, w: i32, gpr: i32, xmm: i32): i32[] {
    buf = buf.append(pfx);
    var rex: i32 = x86_rex(w, gpr, 0, xmm);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(op);
    return buf.append(x86_modrm(3, gpr, xmm));
}
function x86_cvt_to_xmm(buf: i32[], pfx: i32, w: i32, xmm: i32, gpr: i32): i32[] {
    buf = buf.append(pfx);
    var rex: i32 = x86_rex(w, xmm, 0, gpr);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(42); // 0x2A
    return buf.append(x86_modrm(3, xmm, gpr));
}

// x86_cvttsd2si truncates a double to a signed 64-bit integer.
function x86_cvttsd2si(buf: i32[], gpr: i32, xmm: i32): i32[] {
    return x86_cvt_to_gpr(buf, 242, 44, 1, gpr, xmm);
}
function x86_cvttsd2si_w(buf: i32[], w: i32, gpr: i32, xmm: i32): i32[] {
    return x86_cvt_to_gpr(buf, 242, 44, w, gpr, xmm);
}

// x86_cvtsi2sd converts a signed integer to a double.
function x86_cvtsi2sd(buf: i32[], w: i32, xmm: i32, gpr: i32): i32[] {
    return x86_cvt_to_xmm(buf, 242, w, xmm, gpr);
}

// ---- immediate ALU (slice 2b) ----

// x86_alu_r64_imm32 encodes the `<op> <reg>, imm32` group-1 form:
// REX.W + 0x81 /digit, where `slash` is the opcode-extension in the
// ModR/M reg field (0 = add, 5 = sub, 7 = cmp). imm32 little-endian.
// The full imm32 form (vs the compact 0x83 /digit imm8) keeps the
// encoder uniform for any constant.
function x86_alu_r64_imm32(buf: i32[], slash: i32, reg: i32, imm: i32): i32[] {
    buf = buf.append(x86_rex(1, 0, 0, reg)); // reg in rm field
    buf = buf.append(129); // 0x81
    buf = buf.append(x86_modrm(3, slash, reg));
    return x86_le32(buf, imm);
}

// x86_add_r64_imm32: `add <reg>, imm32` (0x81 /0).
function x86_add_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    return x86_alu_r64_imm32(buf, 0, reg, imm);
}

// x86_sub_r64_imm32: `sub <reg>, imm32` (0x81 /5).
function x86_sub_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    return x86_alu_r64_imm32(buf, 5, reg, imm);
}

// x86_cmp_r64_imm32: `cmp <reg>, imm32` (0x81 /7).
function x86_cmp_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    return x86_alu_r64_imm32(buf, 7, reg, imm);
}

// x86_cmp_r64_r64: `cmp <a>, <b>` (64-bit) — REX.W + 0x39 /r.
function x86_cmp_r64_r64(buf: i32[], a: i32, b: i32): i32[] {
    buf = buf.append(x86_rex(1, b, 0, a));
    buf = buf.append(57); // 0x39
    buf = buf.append(x86_modrm(3, b, a));
    return buf;
}

// ---- control flow (slice 2b) ----
//
// Near branches take a 32-bit displacement relative to the *next*
// instruction: rel32 = target_offset - (branch_offset + branch_length).
// Backward branches (target already emitted) can compute this directly;
// forward branches need a fixup pass (a later slice's label table).

// Condition codes for the 0F 8x near-jcc opcodes.
function x86_cc_e(): i32 { return 4; }   // je  / jz
function x86_cc_ne(): i32 { return 5; }  // jne / jnz
function x86_cc_l(): i32 { return 12; }  // jl  (signed <)
function x86_cc_ge(): i32 { return 13; } // jge (signed >=)
function x86_cc_le(): i32 { return 14; } // jle (signed <=)
function x86_cc_g(): i32 { return 15; }  // jg  (signed >)
function x86_cc_b(): i32 { return 2; }   // jb  (unsigned <,  CF=1)
function x86_cc_ae(): i32 { return 3; }  // jae (unsigned >=, CF=0)
function x86_cc_be(): i32 { return 6; }  // jbe (unsigned <=)
function x86_cc_a(): i32 { return 7; }   // ja  (unsigned >)
function x86_cc_s(): i32 { return 8; }   // js  (sign set)
function x86_cc_ns(): i32 { return 9; }  // jns (sign clear)
function x86_cc_p(): i32 { return 10; }  // jp  (parity, NaN tests)

// x86_movabsq: `movabs <reg>, imm64` (REX.W 0xB8+rd io) — load a full
// 64-bit immediate (heap addresses, IEEE-754 bit patterns, wide masks).
function x86_movabsq(buf: i32[], reg: i32, imm: i64): i32[] {
    buf = buf.append(x86_rex(1, 0, 0, reg)); // REX.W (+ REX.B for r8..r15)
    buf = buf.append(184 + (reg & 7));       // 0xB8 + rd
    return x86_le64_i64(buf, imm);
}

// ---- 32-bit ALU + extends + cmov (slice 2q) ----
//
// asm.fern's runtime uses 32-bit (`l`-suffixed) ops for the alloc bump /
// map probing / byte-string scanning, plus cmov for min/max and the
// sign/zero-extend loads. 32-bit ops carry a REX only when an operand is
// r8..r15 (no REX.W); the result zero-extends into the full 64-bit reg.

// x86_mov_load_rip_label: `movq sym(%rip), <dst>` (REX.W 8B /r, ModR/M
// mod=00 rm=101) with a deferred rip-relative fixup — the form asm.fern
// uses to load a .bss/.data global (e.g. the heap pointer).
function x86_mov_load_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: a.code.append(x86_rex(1, dst, 0, 0)) };
    a = X86Asm { ...a, code: a.code.append(139) }; // 0x8B
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, dst, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(4) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_movl_load_rip_label: `movl sym(%rip), <dst32>` (8B /r, no REX.W,
// ModR/M mod=00 rm=101) with a deferred rip-relative fixup — the 32-bit
// sibling of x86_mov_load_rip_label. asm.fern reads the
// __fern_rc_underflow counter this way.
function x86_movl_load_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: x86_rex_opt(a.code, dst, 0, 0) };
    a = X86Asm { ...a, code: a.code.append(139) }; // 0x8B
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, dst, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(4) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_store_imm_rip_label emits `mov $imm, sym(%rip)` at one of the three
// widths: `opcode` is 0xC7 (movq / movl) or 0xC6 (movb), `w` sets REX.W, and
// `imm_bytes` is the immediate's width — 4 for movq / movl, 1 for movb.
//
// This is the one rip-relative shape whose instruction continues past its
// disp32, so the displacement is registered with the immediate's width as a
// tail: x86_resolve measures from the end of the instruction, not the end of
// the displacement, and without that the store lands `imm_bytes` too far on.
function x86_store_imm_rip_label(own a: X86Asm, opcode: i32, w: i32, name: string, imm: i32, imm_bytes: i32): X86Asm {
    if (w != 0) { a = X86Asm { ...a, code: a.code.append(x86_rex(1, 0, 0, 0)) }; }
    a = X86Asm { ...a, code: a.code.append(opcode) };
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, 0, 5) ) };   // RIP-relative, /0
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(4) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name + "") };
    a = X86Asm { ...a, fix_tail_offs: a.fix_tail_offs.append(patch_off) };
    a = X86Asm { ...a, fix_tail_bytes: a.fix_tail_bytes.append(imm_bytes) };
    if (imm_bytes == 1) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
    return X86Asm { ...a, code: x86_le32(a.code, imm) };
}

// x86_fix_tail returns the instruction bytes following the disp32 patched at
// `patch_off` — 0 for every fixup but an immediate store to a rip-relative
// global.
function x86_fix_tail(a: X86Asm, patch_off: i32): i32 {
    var i: i32 = 0;
    while (i < a.fix_tail_offs.len()) {
        if (a.fix_tail_offs[i] == patch_off) { return a.fix_tail_bytes[i]; }
        i = i + 1;
    }
    return 0;
}

// x86_mov_store_rip_label: `movq <src>, sym(%rip)` (REX.W 89 /r, ModR/M
// mod=00 rm=101) with a deferred rip-relative fixup.
function x86_mov_store_rip_label(own a: X86Asm, src: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: a.code.append(x86_rex(1, src, 0, 0)) };
    a = X86Asm { ...a, code: a.code.append(137) }; // 0x89
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, src, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(4) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_movl_store_rip_label: `movl <src32>, sym(%rip)` (89 /r, no REX.W) —
// the 32-bit sibling of x86_mov_store_rip_label, for a 32-bit global.
function x86_movl_store_rip_label(own a: X86Asm, src: i32, name: string): X86Asm {
    if (src >= 8) {
        a = X86Asm { ...a, code: a.code.append(x86_rex(0, src, 0, 0)) }; // REX.R
    }
    a = X86Asm { ...a, code: a.code.append(137) }; // 0x89
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, src, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(4) };
    return X86Asm { ...a, fix_names: a.fix_names.append(name) };
}

// x86_rex_opt pushes a REX byte only if any extension bit is set (w must
// be 0 here — used for the 32-bit / byte ops whose default size needs no
// prefix unless an extended register is involved).
function x86_rex_opt(buf: i32[], reg: i32, index: i32, base: i32): i32[] {
    var rex: i32 = x86_rex(0, reg, index, base);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_mov_r32_r32: `movl <src>, <dst>` (0x89 /r, 32-bit).
function x86_mov_r32_r32(buf: i32[], dst: i32, src: i32): i32[] {
    buf = x86_rex_opt(buf, src, 0, dst);
    buf = buf.append(137); // 0x89
    return buf.append(x86_modrm(3, src, dst));
}

// x86_movl_load: `movl mem, <dst>` (0x8B /r) — 32-bit load (zero-extends).
function x86_movl_load(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = x86_rex_opt(buf, dst, ix, base);
    buf = buf.append(139); // 0x8B
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_movslq_load: `movslq mem, <dst>` (REX.W 0x63 /r) — sign-extend a
// 32-bit memory operand into a 64-bit register.
function x86_movslq_load(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, dst, ix, base));
    buf = buf.append(99); // 0x63
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_movslq_rr: `movslq <src32>, <dst64>` (REX.W 0x63 /r, reg-direct) —
// sign-extend a 32-bit register into a 64-bit one (asm.fern widens the
// i32 `.len()` result with `movslq %eax, %rax`).
function x86_movslq_rr(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, 0, src));
    buf = buf.append(99); // 0x63
    return buf.append(x86_modrm(3, dst, src));
}

// x86_movzwq_load: `movzwq mem, <dst>` (REX.W 0F B7 /r) — zero-extend a
// 16-bit memory operand into a 64-bit register.
function x86_movzwq_load(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, dst, ix, base));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(183); // 0xB7
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_nop_fill appends the n-byte (1..11) NOP GNU as fills .text alignment
// padding with (binutils' alt_patt: 0F 1F multi-byte NOPs, prefix-padded).
function x86_nop_fill(buf: i32[], n: i32): i32[] {
    if (n == 1) { return buf.append(144); }                    // 90
    if (n == 2) { buf = buf.append(102); return buf.append(144); } // 66 90
    if (n >= 9 || n == 6) { buf = buf.append(102); }           // leading 66s
    if (n == 11) { buf = buf.append(102); }
    if (n >= 10) { buf = buf.append(46); }                     // 2E cs override
    buf = buf.append(15);  // 0F
    buf = buf.append(31);  // 1F
    if (n == 3) { return buf.append(0); }                      // 0F 1F 00
    if (n == 4) { buf = buf.append(64); return buf.append(0); } // 0F 1F 40 00
    if (n == 5 || n == 6) {
        buf = buf.append(68);                                  // 0F 1F 44 00 00
        buf = buf.append(0);
        return buf.append(0);
    }
    if (n == 7) { buf = buf.append(128); } else { buf = buf.append(132); }
    if (n != 7) { buf = buf.append(0); }                       // SIB 00
    buf = buf.append(0);
    buf = buf.append(0);
    buf = buf.append(0);
    return buf.append(0);
}

// x86_nop_pad pads with the longest (11-byte) fill repeated, then one
// shorter fill — the sequence gas emits for large paddings.
function x86_nop_pad(buf: i32[], n: i32): i32[] {
    while (n > 11) {
        buf = x86_nop_fill(buf, 11);
        n = n - 11;
    }
    if (n > 0) { buf = x86_nop_fill(buf, n); }
    return buf;
}

// x86_jcc_rel32: a near conditional jump (0F 80+cc) with a 32-bit
// signed displacement. 6 bytes total.
function x86_jcc_rel32(buf: i32[], cc: i32, rel: i32): i32[] {
    buf = buf.append(15);             // 0x0F
    buf = buf.append(128 + (cc & 15)); // 0x80 + cc
    return x86_le32(buf, rel);
}

// x86_je_rel32 / x86_jne_rel32: the two most common conditionals.
function x86_je_rel32(buf: i32[], rel: i32): i32[] {
    return x86_jcc_rel32(buf, x86_cc_e(), rel);
}
function x86_jne_rel32(buf: i32[], rel: i32): i32[] {
    return x86_jcc_rel32(buf, x86_cc_ne(), rel);
}

// x86_jmp_rel32: an unconditional near jump (0xE9 cd). 5 bytes total.
function x86_jmp_rel32(buf: i32[], rel: i32): i32[] {
    buf = buf.append(233); // 0xE9
    return x86_le32(buf, rel);
}

// x86_branch_rel computes the rel32 a branch at `branch_off` (the offset
// of its first opcode byte) needs to reach `target_off`, given the
// branch's total encoded length `branch_len` (6 for jcc, 5 for jmp/call).
function x86_branch_rel(target_off: i32, branch_off: i32, branch_len: i32): i32 {
    return target_off - (branch_off + branch_len);
}

// ---- forward references (slice 2c) ----
//
// A forward branch can't know its rel32 when emitted (the target isn't
// laid down yet). The standard fix: emit a placeholder rel32 (zeros),
// remember where the rel32 field starts, and patch it once the target
// offset is known. x86_patch_rel32 is that patch; the label/fixup table a
// text assembler needs is built on top of it.

// x86_call_rel32: a near `call` (0xE8 cd) with a 32-bit signed
// displacement. 5 bytes total — same rel math as jmp.
function x86_call_rel32(buf: i32[], rel: i32): i32[] {
    buf = buf.append(232); // 0xE8
    return x86_le32(buf, rel);
}

// x86_patch_rel32 overwrites the 4 little-endian rel32 bytes already in
// `buf` starting at offset `at` (the rel32 field of a previously-emitted
// branch placeholder). Used to resolve a forward reference once its
// target offset is known.
//
// `own buf` is what makes the patch path linear rather than O(code_len^2).
// A BORROWED array parameter forces every `.with` down the copy-on-write
// path — the callee cannot know the caller has no other reader — so each
// patched branch cloned the whole .text buffer. Every caller must therefore
// pass a fresh value, another `own` parameter, or a self-reassign
// `code = x86_patch_rel32(code, …)` (E051), which is why the two patch
// loops below lift the buffer out of the struct first.
function x86_patch_rel32(own buf: i32[], at: i32, rel: i32): i32[] {
    buf = buf.with(at, rel & 255);
    buf = buf.with(at + 1, (rel >> 8) & 255);
    buf = buf.with(at + 2, (rel >> 16) & 255);
    buf = buf.with(at + 3, (rel >> 24) & 255);
    return buf;
}

// x86_rel_to computes the rel32 to patch into a placeholder whose rel32
// field starts at `patch_off`, to reach `target_off`. The branch's next
// instruction is 4 bytes past the rel32 field, so
// rel = target_off - (patch_off + 4) — independent of opcode length, so
// it works for jcc / jmp / call alike given that branch's rel32 offset.
function x86_rel_to(target_off: i32, patch_off: i32): i32 {
    return target_off - (patch_off + 4);
}

// ---- named-label assembler (slice 2d) ----
//
// A reusable label/fixup table over the patch primitive: this is the API
// a text assembler (asm.fern GAS text -> bytes) calls instead of doing
// offset bookkeeping by hand. Branches name a label; backward labels (the
// target already has an offset) are patched immediately, forward ones are
// queued and resolved by x86_resolve once every label is placed.
//
// State lives in an X86Asm struct: the code buffer, parallel label
// name/offset arrays (linear lookup — label counts per function are
// small), and parallel fixup patch-offset / target-name arrays. Raw
// instructions still go straight through the encoders into `a.code`
// (`a.code = x86_mov_r32_imm32(a.code, ...)`); only branches that target a
// label go through this layer.

pub struct X86Asm {
    code: i32[],
    rodata: i32[],
    bss_size: i32,
    // Absolute 8-byte data relocations — a `.quad <label>` in .rodata, how
    // a constant aggregate holds a pointer to a string literal. Unlike the
    // rel32 code fixups these need the virtual address, so x86_resolve_data
    // resolves them separately once the load address is known.
    dfix_offs: i32[],
    dfix_names: string[],
    lab_names: string[],
    lab_secs: i32[],
    lab_offs: i32[],
    // Name index over lab_names, so a lookup is a bucket walk rather than a
    // scan of every label placed so far. lab_head/lab_tail hold the first and
    // last lab_names index in each bucket (-1 when empty) and lab_next chains
    // one entry to the next WITHIN a bucket, in insertion order — which is
    // what keeps a duplicate name resolving to its FIRST definition, exactly
    // as the linear scan did.
    lab_head: i32[],
    lab_tail: i32[],
    lab_next: i32[],
    fix_offs: i32[],
    fix_names: string[],
    // fix_widths[i] is how many bytes fix_offs[i] patches: 4 for a rel32 /
    // rip-relative displacement, 1 for a relaxed rel8 branch (#7949).
    fix_widths: i32[],
    // Branch relaxation state. br_long[k] pins the k-th relaxable branch
    // (jcc / jmp to a label, in emission order) to its rel32 form; br_n is
    // the ordinal handed to the next one. x86_gas_assemble re-emits with a
    // grow-only br_long until it stops changing, so a pass reads the
    // PREVIOUS pass's decisions and records what this one needs.
    // relaxing is set only on the x86_gas_assemble path. The raw encoder
    // API (x86_jcc_label and friends, used directly by drivers and the
    // encode self-tests) keeps its original contract: rel32 always, and a
    // backward branch patched on the spot. Relaxation needs the whole text
    // and several passes, neither of which a single API call has.
    relaxing: boolean,
    br_long: boolean[],
    br_n: i32,
    br_offs: i32[],
    br_names: string[],
    br_shorts: boolean[],
    // Patch offsets whose instruction continues PAST the disp32 — an
    // immediate store to a rip-relative global (`movq $0, sym(%rip)`) is the
    // only shape that does. A rip displacement is measured from the end of
    // the whole instruction, so those need the trailing immediate's width
    // subtracted; every other fixup ends at its disp32 and is absent here.
    fix_tail_offs: i32[],
    fix_tail_bytes: i32[],
    // Mnemonics (or mnemonic+operand shapes) the GAS front-end did not
    // recognise. A non-empty list means the byte stream is INCOMPLETE —
    // instructions were dropped — so drivers must fail instead of writing
    // the corrupt executable (SH-005; the arm64 assembler's `p.unknown`
    // is the model — see fern.fern's -target arm64-linux check).
    unknown: string[],
    // Call-frame information from `.cfi_*` directives (cfi.fern), rendered
    // as .eh_frame by x86_eh_frame. Offsets are final: the relaxation
    // re-emits every pass from scratch, so the last pass's are the bytes'.
    cfi: CfiState,
}

// x86_label_buckets is the bucket count of the label-name index. Prime, so
// unrelated hash strides do not alias onto one bucket. Sized for the ~14k
// labels a whole-compiler module places: a few names per bucket.
function x86_label_buckets(): i32 { return 4093; }

// x86_name_bucket hashes a label name to a bucket. The accumulator is masked
// to 23 bits each step and reduced once at the end: `h * 131` then stays under
// 2^31, so the hash still needs no wrapping arithmetic, without paying an
// integer division per character.
function x86_name_bucket(name: string): i32 {
    var h: i32 = 0;
    var i: i32 = 0;
    var n: i32 = name.len();
    while (i < n) {
        h = ((h * 131) + (name[i] as i32)) & 8388607;
        i = i + 1;
    }
    return h % 4093;
}

// x86_empty_buckets is a bucket array of `x86_label_buckets()` empty slots.
function x86_empty_buckets(): i32[] {
    var b: i32[] = [];
    var i: i32 = 0;
    var n: i32 = x86_label_buckets();
    while (i < n) {
        b = b.append(0 - 1);
        i = i + 1;
    }
    return b;
}

// x86_asm_new returns an empty assembler state for the raw encoder API,
// which emits every branch rel32 and never relaxes.
function x86_asm_new(): X86Asm {
    return x86_asm_new_for(false, []);
}

// x86_asm_new_for returns an empty assembler state for a relaxation pass:
// `relaxing` selects the rel8-capable branch emitters and `longs` pins the
// branches an earlier pass proved cannot reach their target in rel8. The
// decisions are part of the initial construction rather than an update
// applied to a fresh X86Asm, so nothing in the assembler ever holds a second
// reference to the struct it is threading.
function x86_asm_new_for(relaxing: boolean, longs: boolean[]): X86Asm {
    return X86Asm { code: [], rodata: [], bss_size: 0, dfix_offs: [], dfix_names: [], lab_names: [], lab_secs: [], lab_offs: [], lab_head: x86_empty_buckets(), lab_tail: x86_empty_buckets(), lab_next: [], fix_offs: [], fix_names: [], fix_widths: [], fix_tail_offs: [], fix_tail_bytes: [], relaxing: relaxing, br_long: x86_bools_copy(longs), br_n: 0, br_offs: [], br_names: [], br_shorts: [], unknown: [], cfi: cfi_new(cfi_profile_x86()) };
}


// x86_eh_frame renders the recorded CFI as the .eh_frame of an image whose
// .text is at text_vaddr and whose .eh_frame is at eh_vaddr; empty when
// the program carried none.
pub function x86_eh_frame(a: X86Asm, text_vaddr: i64, eh_vaddr: i64): i32[] {
    return cfi_eh_frame(a.cfi, cfi_profile_x86(), text_vaddr, eh_vaddr);
}

// x86_eh_frame_hdr_len is the size of the .eh_frame_hdr the program needs,
// 0 without CFI — known before either image is rendered.
pub function x86_eh_frame_hdr_len(a: X86Asm): i32 {
    return cfi_eh_frame_hdr_len(a.cfi);
}

// x86_eh_frame_hdr renders the search table PT_GNU_EH_FRAME points at.
pub function x86_eh_frame_hdr(a: X86Asm, text_vaddr: i64, eh_vaddr: i64, hdr_vaddr: i64): i32[] {
    return cfi_eh_frame_hdr(a.cfi, cfi_profile_x86(), text_vaddr, eh_vaddr, hdr_vaddr);
}

// x86_align8 rounds `n` up to the next multiple of 8 — the .text/.rodata
// boundary the ELF data image uses (so a rip-relative reference to .rodata
// resolves to the same offset the loader maps it at).
function x86_align8(n: i32): i32 {
    var p: i32 = n;
    while ((p % 8) != 0) {
        p = p + 1;
    }
    return p;
}

// x86_align4 rounds `n` up to the next multiple of 4, .eh_frame_hdr's
// alignment.
function x86_align4(n: i32): i32 {
    var p: i32 = n;
    while ((p % 4) != 0) {
        p = p + 1;
    }
    return p;
}

// x86_add_label records `name` in section `sec` at in-section offset `off`,
// appending to the parallel label arrays and threading the new entry onto the
// TAIL of its name bucket. Appending at the tail (rather than the cheaper
// push-front) is what makes x86_label_idx's bucket walk visit definitions in
// the order they were placed, so a repeated name still resolves to the first.
function x86_add_label(own a: X86Asm, name: string, sec: i32, off: i32): X86Asm {
    var at: i32 = a.lab_names.len();
    var b: i32 = x86_name_bucket(name);
    var prev: i32 = a.lab_tail[b];
    a = X86Asm { ...a, lab_names: a.lab_names.append(name) };
    a = X86Asm { ...a, lab_secs: a.lab_secs.append(sec) };
    a = X86Asm { ...a, lab_offs: a.lab_offs.append(off) };
    a = X86Asm { ...a, lab_next: a.lab_next.append(0 - 1) };
    if (prev < 0) {
        a = X86Asm { ...a, lab_head: a.lab_head.with(b, at) };
    } else {
        a = X86Asm { ...a, lab_next: a.lab_next.with(prev, at) };
    }
    a = X86Asm { ...a, lab_tail: a.lab_tail.with(b, at) };
    return a;
}

// x86_label records `name` at the current .text offset (section 0).
function x86_label(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.code.len();
    return x86_add_label(a, name, 0, off);
}

// x86_rodata_label records `name` at the current .rodata offset (section
// 1); follow it with bytes pushed onto a.rodata (e.g. via x86_rodata_quad).
function x86_rodata_label(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.rodata.len();
    return x86_add_label(a, name, 1, off);
}

// x86_rodata_quad appends `v` as 8 little-endian bytes to .rodata — a `.quad`
// constant. The value is i64 because a `.quad` is: taking it as an i32 half and
// a separately-supplied high half meant every caller had to know the sign, and
// the one caller passed a hardcoded zero (#6458).
function x86_rodata_quad(own a: X86Asm, v: i64): X86Asm {
    return X86Asm { ...a, rodata: x86_le64_i64(a.rodata, v) };
}

// x86_bss_label records `name` at the current .bss offset (section 2).
// .bss is zero-init memory not present in the file: only the running size
// advances (x86_bss_skip), and the ELF sets p_memsz > p_filesz.
function x86_bss_label(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.bss_size;
    return x86_add_label(a, name, 2, off);
}

// x86_bss_skip advances the .bss size by `n` bytes (a `.skip`/`.quad`/
// `.align` reservation in the .bss section).
function x86_bss_skip(own a: X86Asm, n: i32): X86Asm {
    a = X86Asm { ...a, bss_size: a.bss_size + n };
    return a;
}

// x86_label_idx returns the index of `name` in the label table, or -1.
// Walks that name's bucket rather than the whole table: the scan it replaces
// was 37% of a whole-compiler assemble, one pass over ~14k names per branch
// fixup and again per resolve (#6911).
function x86_label_idx(a: X86Asm, name: string): i32 {
    var i: i32 = a.lab_head[x86_name_bucket(name)];
    while (i >= 0) {
        if (a.lab_names[i] == name) {
            return i;
        }
        i = a.lab_next[i];
    }
    return 0 - 1;
}

// x86_label_off returns the in-section offset of a .text label `name`, or
// -1 if not yet placed. (Used for the immediate backward-branch patch,
// which only targets .text — .rodata offsets aren't final until resolve.)
pub function x86_label_off(a: X86Asm, name: string): i32 {
    var i: i32 = x86_label_idx(a, name);
    if (i < 0 || a.lab_secs[i] != 0) {
        return 0 - 1;
    }
    return a.lab_offs[i];
}

// x86_final_off resolves `name` to its offset (from .text start) in the
// final image, given the two section bases: the padded .text length
// (where .rodata starts) and where .bss starts (just past .rodata),
// matching the ELF's in-memory layout (.bss is the zero-init region after
// the file content). .text labels keep their offset.
//
// bss_base is passed rather than derived from `a.rodata.len()` because the
// patch loops below hold .rodata as a uniquely-owned local while they run —
// the struct's own field is empty there, so deriving it would read 0.
function x86_final_off(a: X86Asm, name: string, padded_text: i32, bss_base: i32): i32 {
    var i: i32 = x86_label_idx(a, name);
    if (i < 0) {
        return 0 - 1;
    }
    if (a.lab_secs[i] == 1) {
        return padded_text + a.lab_offs[i];
    }
    if (a.lab_secs[i] == 2) {
        return bss_base + a.lab_offs[i];
    }
    return a.lab_offs[i];
}

// x86_fixup_or_patch handles the rel32 of a branch placeholder just
// emitted into a.code: the rel32 field starts at a.code.len()-4. If the
// target is an already-placed .text label, patch immediately; otherwise
// queue a fixup for x86_resolve.
// x86_fixup_or_patch queues the rel32 just emitted for resolution.
//
// It used to patch a BACKWARD branch on the spot, since the target was
// already placed. Relaxation ended that: a displacement baked in mid-emit is
// computed against the layout at that moment, and a later pass that shortens
// anything between the branch and its target silently invalidates it, in
// code nothing revisits. Every branch is queued now and every displacement
// is computed once, at resolve, against the final layout (#7949).
function x86_fixup_or_patch(own a: X86Asm, name: string): X86Asm {
    var at: i32 = a.code.len() - 4;
    if (!a.relaxing) {
        var target: i32 = x86_label_off(a, name);
        if (target >= 0) {
            // Take the buffer OUT of the struct before patching: `a.code`
            // read while `a` still holds it is a second reference, which
            // sends the `.with` down the copy path — one .text clone per
            // backward branch.
            var code: i32[] = a.code;
            a = X86Asm { ...a, code: [] };
            code = x86_patch_rel32(code, at, x86_rel_to(target, at));
            return X86Asm { ...a, code: code };
        }
    }
    return x86_queue_fixup(a, at, 4, name);
}

// x86_queue_fixup records one displacement to patch at resolve: `width`
// bytes starting at `at`, reaching `name`.
function x86_queue_fixup(own a: X86Asm, at: i32, width: i32, name: string): X86Asm {
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(at) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(width) };
    return X86Asm { ...a, fix_names: a.fix_names.append(name) };
}

// x86_branch_long reports whether the next relaxable branch must take its
// rel32 form, per the previous pass's decisions. An ordinal past the end is
// a branch this pass reached and the last one did not (the first pass
// reaches them all with no decisions at all), and starts SHORT: the fixpoint
// only ever grows, so an optimistic start is the one that converges downward
// onto the layout gas picks.
function x86_branch_long(a: X86Asm, k: i32): boolean {
    if (k >= a.br_long.len()) { return false; }
    return a.br_long[k];
}

// x86_branch_record notes the k-th relaxable branch for the relaxation pass:
// where its displacement sits, what it targets, and whether this pass took
// the short form.
function x86_branch_record(own a: X86Asm, at: i32, name: string, short: boolean): X86Asm {
    a = X86Asm { ...a, br_offs: a.br_offs.append(at) };
    a = X86Asm { ...a, br_names: a.br_names.append(name) };
    a = X86Asm { ...a, br_shorts: a.br_shorts.append(short) };
    return X86Asm { ...a, br_n: a.br_n + 1 };
}

// x86_lea_rip_label emits `lea <dst>, [rip + label]` (REX.W 8D /r, ModR/M
// mod=00 rm=101 = RIP-relative) with a placeholder disp32, and queues a
// fixup. The displacement is rip-relative to the next instruction —
// exactly x86_rel_to's math — so it shares the resolve path with branches.
// Always deferred: a .rodata target's final offset isn't known until the
// whole .text is emitted.
function x86_lea_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: a.code.append(x86_rex(1, dst, 0, 0)) };
    a = X86Asm { ...a, code: a.code.append(141) }; // 0x8D
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, dst, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) }; // placeholder disp32
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_widths: a.fix_widths.append(4) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_jcc_label emits a conditional jump to a (possibly forward) label.
function x86_jcc_label(own a: X86Asm, cc: i32, name: string): X86Asm {
    var k: i32 = a.br_n;
    if (a.relaxing && !x86_branch_long(a, k)) { // 0x70+cc ib
        a = X86Asm { ...a, code: a.code.append(112 + (cc & 15)) };
        a = X86Asm { ...a, code: a.code.append(0) }; // placeholder rel8
        var at: i32 = a.code.len() - 1;
        a = x86_queue_fixup(a, at, 1, name);
        return x86_branch_record(a, at, name, true);
    }
    a = X86Asm { ...a, code: x86_jcc_rel32(a.code, cc, 0) }; // placeholder rel32
    var at4: i32 = a.code.len() - 4;
    a = x86_fixup_or_patch(a, name);
    return x86_branch_record(a, at4, name, false);
}

// x86_jmp_label emits an unconditional jump to a label.
function x86_jmp_label(own a: X86Asm, name: string): X86Asm {
    var k: i32 = a.br_n;
    if (a.relaxing && !x86_branch_long(a, k)) { // 0xEB ib
        a = X86Asm { ...a, code: a.code.append(235) };
        a = X86Asm { ...a, code: a.code.append(0) }; // placeholder rel8
        var at: i32 = a.code.len() - 1;
        a = x86_queue_fixup(a, at, 1, name);
        return x86_branch_record(a, at, name, true);
    }
    a = X86Asm { ...a, code: x86_jmp_rel32(a.code, 0) };
    var at4: i32 = a.code.len() - 4;
    a = x86_fixup_or_patch(a, name);
    return x86_branch_record(a, at4, name, false);
}

// x86_call_reg: `call *<reg>` — FF /2, direct ModR/M. Closure and dyn-trait
// dispatch land here.
function x86_call_reg(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    buf = buf.append(255); // 0xFF
    return buf.append(x86_modrm(3, 2, reg));
}

// x86_jmp_reg: `jmp *<reg>` — FF /4, the tail-call sibling of x86_call_reg.
function x86_jmp_reg(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    buf = buf.append(255); // 0xFF
    return buf.append(x86_modrm(3, 4, reg));
}

// x86_call_label emits a call to a label.
function x86_call_label(own a: X86Asm, name: string): X86Asm {
    a = X86Asm { ...a, code: x86_call_rel32(a.code, 0) };
    return x86_fixup_or_patch(a, name);
}

// x86_gas_is_symbol reports whether a directive operand names a label
// rather than a numeric literal — i.e. it starts with a character that
// cannot begin a number (`.L0`, `.S3`, `__fn_main`).
function x86_gas_is_symbol(tok: string): boolean {
    if (tok.len() == 0) { return false; }
    var c: i32 = tok[0] as i32;
    if (c == 45 || c == 36) { return false; }             // '-' / '$'
    if (c >= 48 && c <= 57) { return false; }             // '0'..'9'
    return true;
}

// x86_rodata_quad_sym lays down an 8-byte placeholder in .rodata and
// queues an absolute relocation against `name`, patched by
// x86_resolve_data once the load address is known.
function x86_rodata_quad_sym(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.rodata.len();
    a = X86Asm { ...a, rodata: x86_le64_i64(a.rodata, 0) };
    a = X86Asm { ...a, dfix_offs: a.dfix_offs.append(off) };
    return X86Asm { ...a, dfix_names: a.dfix_names.append(name) };
}

// x86_unwind_hdr_len / x86_unwind_eh_len are the sizes of the unwind
// sections the program's `.cfi_*` directives render, 0 without any. Neither
// depends on where the image loads, which is what lets the data base be
// fixed before the sections are rendered.
function x86_unwind_hdr_len(a: X86Asm): i32 { return cfi_eh_frame_hdr_len(a.cfi); }
function x86_unwind_eh_len(a: X86Asm): i32 {
    if (cfi_empty(a.cfi)) { return 0; }
    return cfi_eh_frame(a.cfi, cfi_profile_x86(), 0 as i64, 0 as i64).len();
}

// x86_data_base is the text-relative offset the data blob starts at: past
// .text, then the 4-aligned .eh_frame_hdr and 8-aligned .eh_frame when the
// program has unwind data, 8-aligned. This restates elf_program_x86's
// layout (elf.fern cannot be imported here); TestSelfHostUnwindData holds
// the two to the same answer.
pub function x86_data_base(a: X86Asm): i32 {
    var end: i32 = a.code.len();
    var hdr_len: i32 = x86_unwind_hdr_len(a);
    var eh_len: i32 = x86_unwind_eh_len(a);
    if (hdr_len > 0 && eh_len > 0) {
        end = x86_align8(x86_align4(end) + hdr_len) + eh_len;
    }
    return x86_align8(end);
}

// x86_resolve_data patches the absolute `.quad <label>` relocations, which
// x86_resolve cannot: a rel32 branch needs only body offsets, an absolute
// pointer needs the virtual address the image loads at. Call after
// x86_resolve with the .text vaddr; body offsets map linearly onto virtual
// addresses from there, because .text and the data blob share one PT_LOAD.
// An unresolvable name is recorded, not patched as 0.
pub function x86_resolve_data(own a: X86Asm, text_vaddr: i32): X86Asm {
    var padded_text: i32 = x86_data_base(a);
    var bss_base: i32 = padded_text + a.rodata.len();
    var rodata: i32[] = a.rodata;
    a = X86Asm { ...a, rodata: [] };
    var i: i32 = 0;
    while (i < a.dfix_offs.len()) {
        var name: string = a.dfix_names[i];
        var target: i32 = x86_final_off(a, name, padded_text, bss_base);
        if (target < 0) {
            a = X86Asm { ...a, unknown: a.unknown.append(".quad " + name) };
        } else {
            var at: i32 = a.dfix_offs[i];
            var abs: i64 = (text_vaddr as i64) + (target as i64);
            var j: i32 = 0;
            while (j < 8) {
                rodata = rodata.with(at + j, ((abs >> ((j * 8) as i64)) & (255 as i64)) as i32);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return X86Asm { ...a, rodata: rodata };
}

// x86_resolve patches every queued fixup (forward branches and all
// rip-relative lea references) now that every label is placed. .rodata
// targets resolve against the padded .text length — the offset the ELF
// data image places .rodata at. Call once after emitting the whole
// program; afterwards a.code + a.rodata are the final sections.
function x86_resolve(own a: X86Asm): X86Asm {
    var padded_text: i32 = x86_data_base(a);
    var bss_base: i32 = padded_text + a.rodata.len();
    // The buffer is pulled out of the struct ONCE and threaded through the
    // whole fixup loop as a uniquely-owned local, then folded back. Patching
    // it in place inside the struct cloned the entire .text per fixup.
    var code: i32[] = a.code;
    a = X86Asm { ...a, code: [] };
    var i: i32 = 0;
    while (i < a.fix_offs.len()) {
        var patch_off: i32 = a.fix_offs[i];
        var target: i32 = x86_final_off(a, a.fix_names[i], padded_text, bss_base);
        // A missing label is -1; patching that as a displacement branches
        // into the ELF header, so refuse rather than emit it (#6045).
        if (target < 0) {
            a = X86Asm { ...a, unknown: a.unknown.append("unresolved symbol " + a.fix_names[i]) };
        } else if (a.fix_widths[i] == 1) {
            // A relaxed branch: one byte, and the next instruction is one
            // byte past the displacement rather than four.
            var rel8: i32 = target - (patch_off + 1);
            if (rel8 < (0 - 128) || rel8 > 127) {
                // The relaxation fixpoint is meant to have pinned this one
                // long already; reaching here means the layout moved under
                // it, which would silently branch somewhere else.
                a = X86Asm { ...a, unknown: a.unknown.append("rel8 out of range for " + a.fix_names[i]) };
            } else {
                code = code.with(patch_off, rel8 & 255);
            }
        } else {
            code = x86_patch_rel32(code, patch_off, x86_rel_to(target, patch_off) - x86_fix_tail(a, patch_off));
        }
        i = i + 1;
    }
    return X86Asm { ...a, code: code };
}

// ============================================================
// PART 2 — GAS-text front-end
// ============================================================

// ---- string helpers ----
//
// Hand-rolled rather than taken from std/string, as arm64_native.fern does:
// this module must work both as an import and concatenated into a driver by
// its unit tests, and an `import "std/string"` breaks the second.

function x86_str_indexof(s: string, sub: string): i32 {
    var n: i32 = s.len();
    var m: i32 = sub.len();
    if (m == 0) { return 0; }
    if (m > n) { return 0 - 1; }
    // The assembler's hot searches are single characters (`:`, ` `, `(`) over
    // lines that mostly do not hold them, which IS __memchr's shape
    // (docs/ATLAS-PLATFORM-PLAN.md §3), so both paths below locate the
    // needle's first byte with it rather than a compare and a bump per
    // position.
    var c0: u8 = sub[0];
    if (m == 1) { return __memchr(s, c0 as i32, 0); }
    var last: i32 = n - m;
    var i: i32 = 0;
    while (i <= last) {
        i = __memchr(s, c0 as i32, i);
        if (i < 0 || i > last) { return 0 - 1; }
        var j: i32 = 1;
        while (j < m && s[i + j] == sub[j]) { j = j + 1; }
        if (j == m) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function x86_str_starts_with(s: string, pre: string): boolean {
    var m: i32 = pre.len();
    if (m > s.len()) { return false; }
    var i: i32 = 0;
    while (i < m) {
        if (s[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

function x86_str_contains(s: string, sub: string): boolean {
    return x86_str_indexof(s, sub) >= 0;
}

function x86_str_split(s: string, sep: string): string[] {
    var out: string[] = [];
    var m: i32 = sep.len();
    if (m == 0) { out = out.append(s); return out; }
    var n: i32 = s.len();
    var c0: u8 = sep[0];
    var last: i32 = n - m;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= last) {
        var hit: boolean = false;
        if (s[i] == c0) {
            var j: i32 = 1;
            while (j < m && s[i + j] == sep[j]) { j = j + 1; }
            hit = j == m;
        }
        if (hit) {
            out = out.append(slice_unchecked(s, start, i));
            i = i + m;
            start = i;
        } else {
            i = i + 1;
        }
    }
    out = out.append(slice_unchecked(s, start, n));
    return out;
}

// Formerly examples/self_host/x86_gas.fern — a GAS (AT&T) assembly
// front-end for the self-hosted x86-64 backend.
// It tokenizes the assembly text asm.fern emits and drives the byte
// encoders + label/.rodata API in x86_native.fern, producing an X86Asm
// whose `code` / `rodata` sections elf.fern wraps into a runnable binary —
// the final wiring that removes the external `as` + `ld` step.
//
// Coverage mirrors internal/native/x86_64's surface (#7886/#7893): the
// integer families at all four operand widths (ALU with carry/borrow, the
// F6/F7 and FE/FF one-operand groups, shifts/rotates and shld/shrd, the
// bt group, xadd/cmpxchg/xchg and the validated lock prefix, the string
// ops), jmp/jCC, setCC, the full cmovCC table, the bit-count group
// (lzcnt/tzcnt/popcnt — Haswell baseline, see docs/BACKEND-PARITY.md),
// and SSE/SSE2/SSE4 through that baseline (scalar and packed float math,
// the packed-integer table, vector shifts, shuffles, pextr/pinsr,
// pcmp*stri, crc32, the mask gathers). Operand forms: `%reg`, `$imm`,
// `disp(%base)`, `disp(%base,%index,scale)`, `sym(%rip)`, and bare
// branch-target labels. AT&T operand order is `op src, dst` (the reverse
// of the encoder's dst,src), and the mnemonic suffix (b/w/l/q) selects
// the operand width.
//
// Anything not recognised — mnemonic, operand shape, or directive — is
// recorded in `unknown` rather than dropped (SH-005): a dropped instruction
// is a corrupt byte stream, not a missing feature, so drivers must refuse to
// write the executable.
//
// Import-free, like the other native-binary modules: the eventual emitter
// `import`s x86_encode + this, and the unit test concatenates them.

// GasMem is a parsed memory operand: rip-relative (`sym(%rip)`, carrying
// the label), or `disp(%base)`, or `disp(%base,%index,scale)` (has_index).
struct GasMem {
    is_rip: boolean,
    label: string,
    base: i32,
    disp: i32,
    has_index: boolean,
    index: i32,
    scale: i32,
    // `disp(,%index,scale)` — index and scale with no base register, encoded
    // as a SIB with base field 101, mod=00 and a disp32. A distinct
    // addressing mode, not base 0: the empty base parses to -1, which the
    // encoders would mask to a real register.
    no_base: boolean,
}

// x86_gas_trim strips leading/trailing spaces (32) AND tabs (9). The
// self-host string `trim` only removes spaces, but asm.fern indents with
// tabs, so the mnemonic-splitting relies on this.
function x86_gas_trim(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && (s[a] == b' ' || s[a] == b'\t')) {
        a = a + 1;
    }
    while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t')) {
        b = b - 1;
    }
    return slice_unchecked(s, a, b) + "";
}

// x86_gas_reg maps a register token (`%rax` or `rax`) to its number, or -1.
function x86_gas_reg(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "rax") { return 0; }
    if (s == "rcx") { return 1; }
    if (s == "rdx") { return 2; }
    if (s == "rbx") { return 3; }
    if (s == "rsp") { return 4; }
    if (s == "rbp") { return 5; }
    if (s == "rsi") { return 6; }
    if (s == "rdi") { return 7; }
    if (s == "r8") { return 8; }
    if (s == "r9") { return 9; }
    if (s == "r10") { return 10; }
    if (s == "r11") { return 11; }
    if (s == "r12") { return 12; }
    if (s == "r13") { return 13; }
    if (s == "r14") { return 14; }
    if (s == "r15") { return 15; }
    // 32-bit GP register names (`%eax`, …) map to the same register numbers as
    // their 64-bit counterparts — asm.fern emits the 32-bit form for e.g. the
    // cvttsd2si destination (`cvttsd2si %xmm0, %eax`). Without these the token
    // resolved to -1, encoding a garbage reg field (7) + REX.R, so the truncated
    // result landed in %rdi not %eax (the capstone float / int-convert path).
    if (s == "eax") { return 0; }
    if (s == "ecx") { return 1; }
    if (s == "edx") { return 2; }
    if (s == "ebx") { return 3; }
    if (s == "esp") { return 4; }
    if (s == "ebp") { return 5; }
    if (s == "esi") { return 6; }
    if (s == "edi") { return 7; }
    if (s == "r8d") { return 8; }
    if (s == "r9d") { return 9; }
    if (s == "r10d") { return 10; }
    if (s == "r11d") { return 11; }
    if (s == "r12d") { return 12; }
    if (s == "r13d") { return 13; }
    if (s == "r14d") { return 14; }
    if (s == "r15d") { return 15; }
    return 0 - 1;
}

// x86_gas_reg8 maps an 8-bit register token (`%al`, `al`, …) to its
// number, or -1. spl/bpl/sil/dil (4..7) and r8b..r15b (8..15) included.
function x86_gas_reg8(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "al") { return 0; }
    if (s == "cl") { return 1; }
    if (s == "dl") { return 2; }
    if (s == "bl") { return 3; }
    if (s == "spl") { return 4; }
    if (s == "bpl") { return 5; }
    if (s == "sil") { return 6; }
    if (s == "dil") { return 7; }
    if (s == "r8b") { return 8; }
    if (s == "r9b") { return 9; }
    if (s == "r10b") { return 10; }
    if (s == "r11b") { return 11; }
    if (s == "r12b") { return 12; }
    if (s == "r13b") { return 13; }
    if (s == "r14b") { return 14; }
    if (s == "r15b") { return 15; }
    return 0 - 1;
}

// x86_gas_reg32 maps a 32-bit register token (`%eax`, `%r8d`, …) to its
// number 0..15, or -1.
function x86_gas_reg32(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "eax") { return 0; }
    if (s == "ecx") { return 1; }
    if (s == "edx") { return 2; }
    if (s == "ebx") { return 3; }
    if (s == "esp") { return 4; }
    if (s == "ebp") { return 5; }
    if (s == "esi") { return 6; }
    if (s == "edi") { return 7; }
    if (s == "r8d") { return 8; }
    if (s == "r9d") { return 9; }
    if (s == "r10d") { return 10; }
    if (s == "r11d") { return 11; }
    if (s == "r12d") { return 12; }
    if (s == "r13d") { return 13; }
    if (s == "r14d") { return 14; }
    if (s == "r15d") { return 15; }
    return 0 - 1;
}

// x86_gas_reg16 maps a 16-bit register token (`%ax`, `%r8w`, …) to its
// number 0..15, or -1.
function x86_gas_reg16(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "ax") { return 0; }
    if (s == "cx") { return 1; }
    if (s == "dx") { return 2; }
    if (s == "bx") { return 3; }
    if (s == "sp") { return 4; }
    if (s == "bp") { return 5; }
    if (s == "si") { return 6; }
    if (s == "di") { return 7; }
    if (s == "r8w") { return 8; }
    if (s == "r9w") { return 9; }
    if (s == "r10w") { return 10; }
    if (s == "r11w") { return 11; }
    if (s == "r12w") { return 12; }
    if (s == "r13w") { return 13; }
    if (s == "r14w") { return 14; }
    if (s == "r15w") { return 15; }
    return 0 - 1;
}

// x86_gas_reg64 is the width-STRICT 64-bit parser the suffix families use:
// only the rXX names. (x86_gas_reg also tolerates the 32-bit spellings for
// the pre-family handlers, which must not leak into a width check — a
// `q`-suffixed op naming %eax is an operand-size mismatch, not a 64-bit op.)
function x86_gas_reg64(tok: string): i32 {
    if (x86_gas_reg32(tok) >= 0) { return 0 - 1; }
    return x86_gas_reg(tok);
}

// x86_gas_reg_w parses a register token at the width the suffix selected.
function x86_gas_reg_w(tok: string, size: i32): i32 {
    if (size == 8) { return x86_gas_reg8(tok); }
    if (size == 16) { return x86_gas_reg16(tok); }
    if (size == 32) { return x86_gas_reg32(tok); }
    return x86_gas_reg64(tok);
}

// x86_gas_suffix_size maps a mnemonic's AT&T size-suffix character to its
// width in bits, or 0 when the last character is not a size suffix.
function x86_gas_suffix_size(mnem: string): i32 {
    if (mnem.len() < 2) { return 0; }
    var c: u8 = mnem[mnem.len() - 1];
    if (c == b'b') { return 8; }
    if (c == b'w') { return 16; }
    if (c == b'l') { return 32; }
    if (c == b'q') { return 64; }
    return 0;
}

// x86_gas_strip_suffix drops the mnemonic's final character.
function x86_gas_strip_suffix(mnem: string): string {
    return slice_unchecked(mnem, 0, mnem.len() - 1) + "";
}

// x86_gas_is_xmm reports whether a token names an xmm register.
function x86_gas_is_xmm(tok: string): boolean {
    return x86_str_contains(tok, "xmm");
}

// x86_gas_xmm maps an xmm token (`%xmm0`, `xmm12`, …) to its number 0..15,
// or -1.
function x86_gas_xmm(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s.len() < 4) {
        return 0 - 1;
    }
    if (s[0] != b'x' || s[1] != b'm' || s[2] != b'm') {
        return 0 - 1;
    }
    var v: i32 = 0;
    var i: i32 = 3;
    while (i < s.len()) {
        var c: i32 = s[i] as i32;
        if (c >= 48 && c <= 57) {
            v = v * 10 + (c - 48);
        }
        i = i + 1;
    }
    return v;
}

// Correctly-rounding decimal -> f64 (SH-004): round-to-nearest, ties to
// even, bit-exact with strtod / the GNU-as path. Mirrored VERBATIM from
// watbin.fern's parse_f64 machinery (pf64_*) — the assemblers are
// deliberately import-free, so the algorithm is kept in sync by hand,
// like the emit layers. See watbin.fern for the algorithm commentary.
// pf64_div2 halves the fraction buffer 0.B (grade-school left-to-right),
// returning the new buffer. May append one digit; drops a leading zero by
// signalling via the first element sentinel — the caller adjusts dp, so
// this returns the raw halved digits INCLUDING a possible leading zero.
function pf64_div2(b: i32[]): i32[] {
    var out: i32[] = [];
    var r: i32 = 0;
    var i: i32 = 0;
    while (i < b.len()) {
        var cur: i32 = r * 10 + b[i];
        out = out.append(cur / 2);
        r = cur % 2;
        i = i + 1;
    }
    if (r != 0) { out = out.append(5); }
    return out;
}

// pf64_mul2 doubles the fraction buffer 0.B (right-to-left with carry).
// A carry out of the front means the value reached [1, 2): the caller
// consumes it as the next binary digit. Returns carry * 1000000 + ... no —
// Fern has no multi-return here; the carry is prepended as a FIRST element
// (0 or 1) and the caller splits it off.
function pf64_mul2(b: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(0); i = i + 1; }
    var carry: i32 = 0;
    var j: i32 = b.len() - 1;
    while (j >= 0) {
        var cur: i32 = b[j] * 2 + carry;
        out = out.with(j, cur % 10);
        carry = cur / 10;
        j = j - 1;
    }
    var res: i32[] = [carry];
    var k: i32 = 0;
    while (k < out.len()) { res = res.append(out[k]); k = k + 1; }
    return res;
}

// pf64_sub returns b[from : upto) as a fresh array (slices are a distinct
// type here, so buffer trims copy).
function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = from;
    while (i < upto) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// pf64_all_zero reports whether every digit in b is zero.
function pf64_all_zero(b: i32[]): boolean {
    var i: i32 = 0;
    while (i < b.len()) {
        if (b[i] != 0) { return false; }
        i = i + 1;
    }
    return true;
}

function parse_f64_bits(s: string): i64 {
    var i: i32 = 0;
    var neg: boolean = false;
    if (s.len() > 0 && s[0] == b'-') { neg = true; i = 1; }
    else if (s.len() > 0 && s[0] == b'+') { i = 1; }
    var signbit: i64 = 0;
    if (neg) { var one: i64 = 1; signbit = one << 63; }
    // Collect significant digits and the decimal point position:
    // value = 0.digits × 10^dp. The 800-digit cap is what makes dropping the
    // rest into a sticky bit safe: an exact ULP tie needs at most 751
    // significant decimal digits anywhere in the binary64 range (the smallest,
    // 2^-1075, is 5^1075 / 10^1075), so an input with a non-zero digit past
    // 800 cannot be a tie and rounding up off the round bit is correct.
    var digits: i32[] = [];
    var dp: i32 = 0;
    var sticky: boolean = false;
    var started: boolean = false;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
        var d: i32 = (s[i] as i32) - 48;
        if (started || d != 0) {
            started = true;
            if (digits.len() < 800) { digits = digits.append(d); }
            else { if (d != 0) { sticky = true; } }
            dp = dp + 1;
        }
        i = i + 1;
    }
    if (i < s.len() && s[i] == b'.') {
        i = i + 1;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            var fd: i32 = (s[i] as i32) - 48;
            if (started || fd != 0) {
                started = true;
                if (digits.len() < 800) { digits = digits.append(fd); }
                else { if (fd != 0) { sticky = true; } }
            } else {
                dp = dp - 1;                // leading fraction zero shifts the point
            }
            i = i + 1;
        }
    }
    if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == b'-') { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == b'+') { i = i + 1; }
        var exp: i32 = 0;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            if (exp < 100000) { exp = exp * 10 + ((s[i] as i32) - 48); }
            i = i + 1;
        }
        if (eneg) { dp = dp - exp; } else { dp = dp + exp; }
    }
    // Trailing zeros in the significand carry no information; trimming
    // keeps the sticky/remainder tests honest.
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
        digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) { return signbit; }          // ±0.0
    // Decimal-magnitude clamps keep the shift loops bounded: |value| is in
    // [10^(dp-1), 10^dp), so dp > 310 overflows every double and dp < -350
    // underflows below half the minimum subnormal.
    if (dp > 310) { var inf: i64 = 2047; return signbit | (inf << 52); }
    if (dp < 0 - 350) { return signbit; }
    // Binary-normalize 0.digits × 10^dp into v × 2^bexp with v in [0.5, 1).
    // While the decimal point is right of the front (value >= 1), halve;
    // while the value is below 0.5, double. dp reaches 0 first, then the
    // leading-digit test finishes the job.
    var bexp: i32 = 0;
    while (dp > 0) {
        var hb: i32[] = pf64_div2(digits);
        if (hb.len() > 0 && hb[0] == 0) {
            digits = pf64_sub(hb, 1, hb.len());
            dp = dp - 1;
        } else {
            digits = hb;
        }
        bexp = bexp + 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
    }
    while (dp < 0 || (digits.len() > 0 && digits[0] < 5)) {
        var db: i32[] = pf64_mul2(digits);
        if (db[0] != 0) {
            // Carry out of the fraction: 2×0.D >= 1, i.e. C.D' × 10^dp.
            // Renormalize as 0.(C D') × 10^(dp+1) — the carry becomes the
            // new leading digit and the point advances. (Only reachable
            // while dp < 0: at dp == 0 the loop only runs when the lead
            // digit is < 5, so doubling cannot carry.)
            digits = db;
            dp = dp + 1;
        } else {
            digits = pf64_sub(db, 1, db.len());
        }
        bexp = bexp - 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
        if (digits.len() == 0) { return signbit; }
    }
    // v in [0.5, 1), value = v × 2^bexp = 1.f × 2^(bexp-1): biased exponent
    // E = bexp + 1022. E >= 2047 overflows; E <= 0 goes subnormal with
    // 52 + E mantissa bits; below -1 it is under half the minimum
    // subnormal and rounds to zero.
    var e: i32 = bexp + 1022;
    if (e >= 2047) { var inf2: i64 = 2047; return signbit | (inf2 << 52); }
    var nbits: i32 = 53;
    if (e <= 0) { nbits = 52 + e; }
    if (nbits < 0) { return signbit; }
    var mant: i64 = 0;
    var k2: i32 = 0;
    while (k2 < nbits) {
        var mb: i32[] = pf64_mul2(digits);
        mant = mant * 2 + (mb[0] as i64);
        digits = pf64_sub(mb, 1, mb.len());
        k2 = k2 + 1;
    }
    // Round to nearest, ties to even: round bit is the next binary digit;
    // sticky is any remainder (or parse-time truncation).
    var rb: i32[] = pf64_mul2(digits);
    var roundbit: i32 = rb[0];
    var rest: i32[] = pf64_sub(rb, 1, rb.len());
    var st: boolean = sticky || !pf64_all_zero(rest);
    if (roundbit == 1 && (st || (mant & 1) == 1)) { mant = mant + 1; }
    if (e <= 0) {
        // Subnormal: the E field is 0 and `bits = mant` — and a subnormal
        // that rounded up to 2^52 IS the smallest normal (E=1, f=0), which
        // this encoding produces arithmetically.
        return signbit | mant;
    }
    var full: i64 = 1;
    full = full << 53;
    if (mant == full) {
        // 1.111…1 rounded up to 10.00…0: renormalize.
        mant = mant / 2;
        e = e + 1;
        if (e >= 2047) { var inf3: i64 = 2047; return signbit | (inf3 << 52); }
    }
    var hidden: i64 = 1;
    hidden = hidden << 52;
    return signbit | ((e as i64) << 52) | (mant - hidden);
}

// x86_gas_parse_f64 parses a `.double` operand into the nearest f64.
function x86_gas_parse_f64(s: string): f64 {
    return f64_from_bits(parse_f64_bits(s));
}

// x86_gas_escape decodes the escape whose backslash is at `line[i]`, returning
// the byte it stands for and how many characters it spans.
//
// The octal form is the one that matters: asmcore.escape_for_ascii writes every
// byte below 0x20, and 0x7f, as `\NNN`, and GAS reads `\` followed by one to
// three octal digits. Recognising only `\0` and passing every other digit
// through as itself left two stray characters in .rodata per control byte and
// shifted the rest of the literal — `"A\x01B"` assembled to `A`, NUL, `0`, `1`,
// `B` and was then truncated at the length the emitter recorded, so it read
// back as `A`, NUL, `0`. Only the two GAS assemblers were affected; the wasm
// path spells the same bytes as WAT hex escapes and always round-tripped.
function x86_gas_escape(line: string, i: i32): (i32, i32) {
    var e: i32 = line[i + 1] as i32;
    if (e == 110) { return (10, 2); }        // \n
    if (e == 116) { return (9, 2); }         // \t
    if (e == 114) { return (13, 2); }        // \r
    if (e >= 48 && e <= 55) {                // \N, \NN, \NNN — octal
        var v: i32 = e - 48;
        var n: i32 = 2;
        while (n < 4 && i + n < line.len()) {
            var d: i32 = line[i + n] as i32;
            if (d < 48 || d > 55) { break; }
            v = v * 8 + (d - 48);
            n = n + 1;
        }
        return (v & 255, n);
    }
    return (e, 2);                           // \\ , \" and any other
}

// x86_gas_ascii appends the bytes of a `.ascii "…"` directive's string to
// `buf`, processing the escapes x86_gas_escape decodes. The string is the part
// between the first `"` and the closing unescaped `"`.
function x86_gas_ascii(buf: i32[], line: string): i32[] {
    var q1: i32 = x86_str_indexof(line, "\"");
    if (q1 < 0) {
        return buf;
    }
    var i: i32 = q1 + 1;
    while (i < line.len()) {
        var c: i32 = line[i] as i32;
        if (c == 34) { // closing '"'
            return buf;
        }
        if (c == 92 && i + 1 < line.len()) { // backslash escape
            var (eb, span) = x86_gas_escape(line, i);
            c = eb;
            i = i + span - 1;
        }
        buf = buf.append(c & 255);
        i = i + 1;
    }
    return buf;
}

// x86_gas_atoi parses a decimal integer token, tolerating a leading `$`
// (immediate sigil) and a leading `-`.
function x86_gas_atoi(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'$') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == b'-') {
        neg = true;
        i = 1;
    }
    var v: i32 = 0;
    // `0x…` hex (mirrors x86_gas_atoi64). Without this the `x` was skipped as a
    // non-digit and the hex digits read as DECIMAL — e.g. `$0x22` (the mmap
    // MAP_PRIVATE|MAP_ANONYMOUS flags asm.fern emits) parsed to 22, not 34, so
    // the heap mmap got bad flags (EBADF) and every alloc-using program's
    // runtime OOM-exited 137 (the capstone string / heap cases).
    if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + d; }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            if (c >= 48 && c <= 57) {
                v = v * 10 + (c - 48);
            }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// x86_gas_atoi64 parses a signed 64-bit integer token (decimal or `0x…`
// hex, optional `$` sigil and `-`), for movabsq's imm64. Two's-complement
// wraps give the right bits for INT64_MIN.
function x86_gas_atoi64(tok: string): i64 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'$') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == b'-') {
        neg = true;
        i = 1;
    }
    var v: i64 = 0;
    if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + (d as i64); }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            if (c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// x86_gas_parse_mem parses a memory operand `disp(%base)` / `(%base)` /
// `disp(%base,%index,scale)` / `sym(%rip)`.
function x86_gas_parse_mem(op: string): GasMem {
    var lp: i32 = x86_str_indexof(op, "(");
    if (lp < 0) {
        // Not a memory operand — defensive fallback (avoids an op[0:-1]
        // corrupt slice); callers gate on `.contains("(")` so this is rare.
        return GasMem { is_rip: false, label: "", base: x86_gas_reg(op), disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
    }
    var disp_str: str = slice_unchecked(op, 0, lp);
    var inner: str = slice_unchecked(op, lp + 1, op.len() - 1); // between ( and )
    if (inner == "%rip") {
        return GasMem { is_rip: true, label: disp_str + "", base: 0, disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
    }
    var d: i32 = 0;
    if (disp_str.len() > 0) {
        d = x86_gas_atoi(disp_str);
    }
    var parts: string[] = x86_str_split(inner, ",");
    if (parts.len() >= 3) {
        var b0: string = x86_gas_trim(parts[0]);
        var bb: i32 = x86_gas_reg(b0);
        var ix: i32 = x86_gas_reg(x86_gas_trim(parts[1]));
        var sc: i32 = x86_gas_atoi(x86_gas_trim(parts[2]));
        return GasMem { is_rip: false, label: "", base: bb, disp: d, has_index: true, index: ix, scale: sc, no_base: b0.len() == 0 };
    }
    // Two-element SIB `(%base,%index)` — an implicit scale of 1 (asm.fern emits
    // this for byte-element indexing, e.g. `movzbl (%rax,%rcx), %eax`). Without
    // this the whole `%base,%index` string resolved to a single -1 register.
    if (parts.len() == 2) {
        var bb2: i32 = x86_gas_reg(x86_gas_trim(parts[0]));
        var ix2: i32 = x86_gas_reg(x86_gas_trim(parts[1]));
        return GasMem { is_rip: false, label: "", base: bb2, disp: d, has_index: true, index: ix2, scale: 1, no_base: x86_gas_trim(parts[0]).len() == 0 };
    }
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(x86_gas_trim(inner)), disp: d, has_index: false, index: 0, scale: 1, no_base: false };
}

// x86_gas_movq dispatches the movq operand shapes (AT&T src, dst),
// including the SSE forms movq %gpr,%xmm and movq %xmm,%gpr.
