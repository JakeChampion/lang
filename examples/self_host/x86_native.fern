// examples/self_host/x86_native.fern — the x86-64 Linux native-binary
// backend as a single module: the x86-64 machine-code encoder + named-
// label assembler (was x86_encode.fern) and the GAS-text front-end (was
// x86_gas.fern). Merged into one module so the unified fern CLI can
// `import "./x86_native"` and drive emit -> assemble -> ELF without
// cross-module bare references — the same reason arm64_native.fern is one
// module. The container half is elf.fern. The pieces stay logically
// separable; the section banners below mark the former file boundaries.

// ============================================================
// PART 1 — x86-64 encoder + named-label assembler
// ============================================================

// Formerly examples/self_host/x86_encode.fern — x86-64 machine-code
// encoding primitives for the self-hosted *native* backend (slice 2a of the
// native-binary track; the container half is elf.fern). This is the
// assembler half: it turns instructions into the raw bytes an ELF .text
// section holds, mirroring internal/native/x86_64/asm.go.
//
// Strategy (matching the wasm binary track): the eventual native emitter
// will *assemble the already-tested asm.fern text* — tokenize → parse →
// encode — rather than duplicate asm.fern's instruction selection. This
// slice provides the lowest layer that work builds on: the byte-level
// encoders for a core integer + syscall instruction subset, enough to
// assemble (with elf.fern) a runnable exit(N) program end-to-end.
//
// Conventions (matching leb128.fern / wat_encode.fern / elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each encoder
//     appends to it and returns the (possibly grown) buffer.
//   * This module is intentionally **import-free** so the native emitter
//     can `import "./x86_encode"` and the unit test can concatenate it
//     with a driver `main()` for the single-module wasm_run driver.
//
// Register numbering (System V / Intel low-3-bit encoding, shared between
// the 32-bit eXX and 64-bit rXX views — only the prefix/opcode picks the
// operand size). Slice 2a covers the 8 base registers (0..7); the
// extended registers r8..r15 (which need REX.R / REX.B) come in a later
// slice.

function x86_rax(): i32 { return 0; }
function x86_rcx(): i32 { return 1; }
function x86_rdx(): i32 { return 2; }
function x86_rbx(): i32 { return 3; }
function x86_rsp(): i32 { return 4; }
function x86_rbp(): i32 { return 5; }
function x86_rsi(): i32 { return 6; }
function x86_rdi(): i32 { return 7; }

// x86_rex_w is the REX.W prefix (0x48): "this is a 64-bit operation" with
// no extended-register bits (the operands are r0..r7).
function x86_rex_w(): i32 { return 72; }

// x86_rex builds a REX prefix byte 0x40 | W<<3 | R<<2 | X<<1 | B, setting
// the extension bits from the register numbers: REX.R for a ModR/M reg
// field >= 8, REX.X for a SIB index >= 8, REX.B for the ModR/M rm / SIB
// base / opcode-embedded register >= 8. Pass w=1 for 64-bit ops. Registers
// r8..r15 are numbered 8..15; the low 3 bits go in the ModR/M / SIB
// fields (which already mask with & 7).
function x86_rex(w: i32, reg: i32, index: i32, base: i32): i32 {
    var v: i32 = 64; // 0x40
    if (w != 0) { v = v | 8; }
    if (reg >= 8) { v = v | 4; }
    if (index >= 8) { v = v | 2; }
    if (base >= 8) { v = v | 1; }
    return v;
}

// x86_le32 appends the 4 bytes of `v`, little-endian (for imm32 / disp32).
// `>>` is arithmetic; the `& 255` after each shift discards sign-extended
// high bits, so the result is correct for any 32-bit value.
function x86_le32(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 24) & 255);
    return buf;
}

// x86_modrm builds a ModR/M byte: (mod << 6) | (reg << 3) | rm. mod=3
// (0b11) selects the register-direct form (rm names a register, not a
// memory operand).
function x86_modrm(md: i32, reg: i32, rm: i32): i32 {
    return ((md & 3) << 6) | ((reg & 7) << 3) | (rm & 7);
}

// ---- instruction encoders ----

// x86_mov_r32_imm32: `mov <reg32>, imm32` — opcode 0xB8+rd then imm32.
// The 32-bit write zero-extends into the full 64-bit register, which is
// the cheapest way to load a small constant (e.g. a syscall number). For
// r8..r15 a REX.B prefix (no W) extends the embedded register.
function x86_mov_r32_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    buf = buf.append(184 + (reg & 7)); // 0xB8 + rd
    return x86_le32(buf, imm);
}

// x86_mov_r64_imm32: `movq $imm, <reg>` — REX.W + 0xC7 /0 id. The immediate
// is SIGN-extended; x86_mov_r32_imm32 above zero-extends and is correct only
// for immediates known non-negative.
function x86_mov_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    buf = buf.append(x86_rex(1, 0, 0, reg));
    buf = buf.append(199); // 0xC7
    buf = buf.append(x86_modrm(3, 0, reg));
    return x86_le32(buf, imm);
}

// x86_mov_r64_r64: `mov <dst>, <src>` (64-bit) — REX.W + 0x89 /r, where
// the ModR/M reg field is the source and r/m is the destination.
function x86_mov_r64_r64(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, dst));
    buf = buf.append(137); // 0x89
    buf = buf.append(x86_modrm(3, src, dst));
    return buf;
}

// x86_add_r64_r64: `add <dst>, <src>` (64-bit) — REX.W + 0x01 /r.
function x86_add_r64_r64(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, dst));
    buf = buf.append(1); // 0x01
    buf = buf.append(x86_modrm(3, src, dst));
    return buf;
}

// x86_sub_r64_r64: `sub <dst>, <src>` (64-bit) — REX.W + 0x29 /r.
function x86_sub_r64_r64(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, dst));
    buf = buf.append(41); // 0x29
    buf = buf.append(x86_modrm(3, src, dst));
    return buf;
}

// x86_push_r64: `push <reg>` — 0x50+rd (a REX.B prefix for r8..r15;
// push defaults to 64-bit, so no REX.W).
function x86_push_r64(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B = 0x41
    }
    return buf.append(80 + (reg & 7)); // 0x50 + rd
}

// x86_push_imm32: `push $imm` (0x68 id) — push a sign-extended imm32.
function x86_push_imm32(buf: i32[], imm: i32): i32[] {
    buf = buf.append(104); // 0x68
    return x86_le32(buf, imm);
}

// x86_pop_r64: `pop <reg>` — 0x58+rd (REX.B for r8..r15).
function x86_pop_r64(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    return buf.append(88 + (reg & 7)); // 0x58 + rd
}

// x86_syscall: the 2-byte `syscall` instruction (0x0F 0x05).
function x86_syscall(buf: i32[]): i32[] {
    buf = buf.append(15); // 0x0F
    buf = buf.append(5);  // 0x05
    return buf;
}

// x86_ret: `ret` (0xC3).
function x86_ret(buf: i32[]): i32[] {
    return buf.append(195); // 0xC3
}


// ---- width-generic integer encoders ----
//
// `size` is the operand width in bits (8/16/32/64), taken from the AT&T
// mnemonic suffix. Shared rules, mirroring internal/native/x86_64: a
// 16-bit op carries the 0x66 prefix, an 8-bit op selects the byte opcode
// (opbase without |1), and a byte register 4..7 (spl..dil) forces an
// otherwise-empty REX — unprefixed, the same numbers select ah..bh.

// x86_opsel returns the width-selected opcode: opbase for 8-bit, opbase|1
// for the wider sizes.
function x86_opsel(opbase: i32, size: i32): i32 {
    if (size == 8) { return opbase; }
    return opbase | 1;
}

// x86_osz appends the 0x66 operand-size prefix for 16-bit operations.
function x86_osz(buf: i32[], size: i32): i32[] {
    if (size == 16) { return buf.append(102); }
    return buf;
}

// x86_rex8_force: an 8-bit register operand spl/bpl/sil/dil needs a REX.
function x86_rex8_force(size: i32, reg: i32): boolean {
    return size == 8 && reg >= 4 && reg <= 7;
}

// x86_rex_w_of maps a size to the REX.W bit.
function x86_rex_w_of(size: i32): i32 {
    if (size == 64) { return 1; }
    return 0;
}

// x86_rex_rr appends the REX for a two-register form (ModRM reg + rm).
function x86_rex_rr(buf: i32[], size: i32, reg: i32, rm: i32): i32[] {
    var rex: i32 = x86_rex(x86_rex_w_of(size), reg, 0, rm);
    if (rex != 64 || x86_rex8_force(size, reg) || x86_rex8_force(size, rm)) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_rex_r appends the REX for a form whose only register is ModRM.rm.
function x86_rex_r(buf: i32[], size: i32, reg: i32): i32[] {
    var rex: i32 = x86_rex(x86_rex_w_of(size), 0, 0, reg);
    if (rex != 64 || x86_rex8_force(size, reg)) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_op_rr: `[66] [REX] op /r`, ModR/M direct — the shape every
// two-register group op shares (mov 0x88, the ALU rows, test 0x84,
// xchg 0x86).
function x86_op_rr(buf: i32[], size: i32, opbase: i32, reg: i32, rm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_rr(buf, size, reg, rm);
    buf = buf.append(x86_opsel(opbase, size));
    return buf.append(x86_modrm(3, reg, rm));
}

// x86_op0f_rr: `[66] [REX] 0F op /r`, ModR/M direct — cmovcc / bt / imul /
// xadd / cmpxchg. `op` arrives fully width-selected.
function x86_op0f_rr(buf: i32[], size: i32, op: i32, reg: i32, rm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_rr(buf, size, reg, rm);
    buf = buf.append(15);
    buf = buf.append(op);
    return buf.append(x86_modrm(3, reg, rm));
}

// x86_imm_fits8 reports whether the sign-extended-imm8 short forms
// (83 /ext, 6B /r, 6A) can carry `v`.
function x86_imm_fits8(v: i32): boolean {
    return v >= (0 - 128) && v <= 127;
}

// x86_imm_wide appends an immediate at the operation width — imm16 for the
// 66-prefixed forms, imm32 otherwise (byte forms append directly).
function x86_imm_wide(buf: i32[], size: i32, imm: i32): i32[] {
    if (size == 16) {
        buf = buf.append(imm & 255);
        return buf.append((imm >> 8) & 255);
    }
    return x86_le32(buf, imm);
}

// x86_grp1_imm_r: `<alu> $imm, %reg` — 80 /ext ib for a byte register, else
// 83 /ext ib when the immediate fits signed 8 bits, else 81 /ext iw/id.
// Using 83/81 for a byte operand would silently widen it (#3544's class).
function x86_grp1_imm_r(buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    if (size == 8) {
        buf = buf.append(128);
        buf = buf.append(x86_modrm(3, ext, reg));
        return buf.append(imm & 255);
    }
    if (x86_imm_fits8(imm)) {
        buf = buf.append(131);
        buf = buf.append(x86_modrm(3, ext, reg));
        return buf.append(imm & 255);
    }
    buf = buf.append(129);
    buf = buf.append(x86_modrm(3, ext, reg));
    return x86_imm_wide(buf, size, imm);
}

// x86_unary_r: the one-operand groups on a register — F6/F7 (not /2, neg
// /3, mul /4, imul /5, div /6, idiv /7) and FE/FF (inc /0, dec /1).
function x86_unary_r(buf: i32[], size: i32, opbase: i32, ext: i32, reg: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    buf = buf.append(x86_opsel(opbase, size));
    return buf.append(x86_modrm(3, ext, reg));
}

// x86_test_imm_r: `test $imm, %reg` — F6 /0 ib or F7 /0 iw/id (test has no
// sign-extended-imm8 short form).
function x86_test_imm_r(buf: i32[], size: i32, reg: i32, imm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    buf = buf.append(x86_opsel(246, size));
    buf = buf.append(x86_modrm(3, 0, reg));
    if (size == 8) { return buf.append(imm & 255); }
    return x86_imm_wide(buf, size, imm);
}

// x86_shift_r_imm: the C0/C1 shift-and-rotate group on a register, using
// the D0/D1 short form when the count is 1 (what GNU as selects).
function x86_shift_r_imm(buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    if (imm == 1) {
        buf = buf.append(x86_opsel(208, size)); // D0/D1
        return buf.append(x86_modrm(3, ext, reg));
    }
    buf = buf.append(x86_opsel(192, size)); // C0/C1
    buf = buf.append(x86_modrm(3, ext, reg));
    return buf.append(imm & 255);
}

// x86_shift_r_cl: the D2/D3 variable-count (%cl) shift form on a register.
function x86_shift_r_cl(buf: i32[], size: i32, ext: i32, reg: i32): i32[] {
    buf = x86_osz(buf, size);
    buf = x86_rex_r(buf, size, reg);
    buf = buf.append(x86_opsel(210, size)); // D2/D3
    return buf.append(x86_modrm(3, ext, reg));
}

// x86_cmovcc_rr: `cmov<cc> %src, %dst` ([66] [REX] 0F 40+cc /r; reg=dst).
function x86_cmovcc_rr(buf: i32[], size: i32, cc: i32, dst: i32, src: i32): i32[] {
    return x86_op0f_rr(buf, size, 64 + (cc & 15), dst, src);
}

// x86_cqo: `cqo` (0x48 0x99) — sign-extend rax into rdx:rax before idiv.
function x86_cqo(buf: i32[]): i32[] {
    buf = buf.append(x86_rex_w());
    buf = buf.append(153); // 0x99
    return buf;
}

// ---- memory operands (slice 2e) ----
//
// A memory operand `[base + disp]` is encoded by the ModR/M byte's mod/rm
// fields plus an optional SIB byte and displacement. Two registers need
// special handling:
//   * rsp (rm=100) is the SIB escape — any `[rsp + …]` needs a SIB byte
//     (scale=0, index=100=none, base=100=rsp);
//   * rbp (rm=101) can't use mod=00 (that encoding means RIP-relative), so
//     `[rbp]` is emitted as mod=01 with a zero disp8.
// mod selects the displacement size: 00 = none, 01 = disp8, 10 = disp32.
// Slice 2e covers the base registers (0..7); index/scale addressing is a
// later need.

// x86_sib builds a SIB byte: (scale << 6) | (index << 3) | base.
function x86_sib(scale: i32, index: i32, base: i32): i32 {
    return ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7);
}

// x86_emit_mem appends the ModR/M (+ optional SIB + displacement) for a
// memory operand `[base + disp]` with the given ModR/M `reg` field (the
// other operand — a register for load/store).
function x86_emit_mem(buf: i32[], reg: i32, base: i32, disp: i32): i32[] {
    var b: i32 = base & 7;
    var is_rsp: boolean = (b == 4); // SIB escape
    var is_rbp: boolean = (b == 5); // no mod=00 form

    var md: i32 = 2;        // default: disp32
    var has_disp8: boolean = false;
    if (disp == 0 && !is_rbp) {
        md = 0;             // no displacement
    } else if (disp >= (0 - 128) && disp <= 127) {
        md = 1;             // disp8
        has_disp8 = true;
    }

    buf = buf.append(x86_modrm(md, reg, b));
    if (is_rsp) {
        buf = buf.append(x86_sib(0, 4, 4)); // [rsp], no index
    }
    if (has_disp8) {
        buf = buf.append(disp & 255);
    } else {
        if (md == 2) {
            buf = x86_le32(buf, disp);
        }
    }
    return buf;
}

// x86_mov_load_r64: `mov <dst>, [base + disp]` — REX.W + 0x8B /r.
function x86_mov_load_r64(buf: i32[], dst: i32, base: i32, disp: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, 0, base));
    buf = buf.append(139); // 0x8B
    return x86_emit_mem(buf, dst, base, disp);
}

// x86_mov_store_r64: `mov [base + disp], <src>` — REX.W + 0x89 /r.
function x86_mov_store_r64(buf: i32[], base: i32, disp: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, 0, base));
    buf = buf.append(137); // 0x89
    return x86_emit_mem(buf, src, base, disp);
}

// x86_mov_store_imm32: `movq $imm32, disp(%base[,%index,scale])` — a 64-bit
// immediate-to-memory store (REX.W C7 /0 + mem operand + sign-extended imm32).
// asm.fern emits it for the array-box header init (`movq $1, 8(%rax)` — the
// refcount) and similar constant stores. x86_gas_movq previously mis-routed a
// `$imm` source into its immediate-to-REGISTER branch regardless of the
// destination, so `movq $1, 8(%rax)` emitted `mov $1, %edi` (clobbering %rdi)
// and dropped the store — corrupting every freshly-boxed array's count field,
// which crashed the string-keyed-map compare (mapstr).
function x86_mov_store_imm32(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32, imm: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, 0, ix, base));
    buf = buf.append(199); // 0xC7 /0
    buf = x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
    return x86_le32(buf, imm);
}

// x86_movl_store_imm32: `movl $imm32, disp(%base)` (C7 /0 m32 id, no
// REX.W) — the 32-bit sibling of x86_mov_store_imm32. asm.fern emits it
// to zero a freed box's 32-bit refcount field (`movl $0, -8(%rax)`).
function x86_movl_store_imm32(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32, imm: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = x86_rex_opt(buf, 0, ix, base);
    buf = buf.append(199); // 0xC7 /0
    buf = x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
    return x86_le32(buf, imm);
}

// ---- SIB index addressing (slice 2j) ----
//
// `[base + index*scale + disp]` needs a SIB byte (ModR/M rm = 100). The
// scale field encodes 1/2/4/8 as 0/1/2/3. base rbp/r13 still forces a
// disp8 (no mod=00 form), as in x86_emit_mem.

// x86_lea_idx_nobase: `lea disp(,%index,scale), <dst>` — REX.W 8D with a
// SIB whose base field is 101 (no base) and mod=00, so a disp32 always
// follows. Element-offset computation.
function x86_lea_idx_nobase(buf: i32[], dst: i32, index: i32, scale: i32, disp: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, index, 0));
    buf = buf.append(141); // 0x8D
    buf = buf.append(x86_modrm(0, dst, 4)); // SIB follows
    buf = buf.append(x86_sib(x86_scale_bits(scale), index, 5)); // base 101 = none
    return x86_le32(buf, disp);
}

// x86_scale_bits maps a scale (1/2/4/8) to its 2-bit SIB field.
function x86_scale_bits(scale: i32): i32 {
    if (scale == 2) { return 1; }
    if (scale == 4) { return 2; }
    if (scale == 8) { return 3; }
    return 0; // scale 1 (or default)
}

// x86_emit_mem_idx appends the ModR/M + SIB (+ displacement) for
// `[base + index*scale + disp]` with the given ModR/M `reg` field.
function x86_emit_mem_idx(buf: i32[], reg: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
    var b: i32 = base & 7;
    var is_rbp: boolean = (b == 5);
    var md: i32 = 2;
    var has_disp8: boolean = false;
    if (disp == 0 && !is_rbp) {
        md = 0;
    } else {
        if (disp >= (0 - 128) && disp <= 127) {
            md = 1;
            has_disp8 = true;
        }
    }
    buf = buf.append(x86_modrm(md, reg, 4)); // rm = 100 -> SIB
    buf = buf.append(x86_sib(x86_scale_bits(scale), index, base));
    if (has_disp8) {
        buf = buf.append(disp & 255);
    } else {
        if (md == 2) {
            buf = x86_le32(buf, disp);
        }
    }
    return buf;
}

// x86_mov_load_r64_idx: `mov <dst>, [base + index*scale + disp]`.
function x86_mov_load_r64_idx(buf: i32[], dst: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, index, base));
    buf = buf.append(139); // 0x8B
    return x86_emit_mem_idx(buf, dst, base, index, scale, disp);
}

// x86_mov_store_r64_idx: `mov [base + index*scale + disp], <src>`.
function x86_mov_store_r64_idx(buf: i32[], base: i32, index: i32, scale: i32, disp: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, src, index, base));
    buf = buf.append(137); // 0x89
    return x86_emit_mem_idx(buf, src, base, index, scale, disp);
}

// ---- byte ops (slice 2k) ----
//
// Byte (8-bit) memory ops reuse the ModR/M + SIB encoding (x86_emit_mem /
// _idx) with byte opcodes and a W=0 REX that's emitted only when needed
// (an extended reg/base/index, or — for a byte register operand — when it
// is spl..dil (4..7), which require a REX to disambiguate from ah..bh).
// movzbq's destination is 64-bit, so it always carries REX.W.

// x86_byte_mem_rex emits the (optional) REX for a byte memory op.
function x86_byte_mem_rex(buf: i32[], w: i32, reg: i32, has_index: boolean, index: i32, base: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    var rex: i32 = x86_rex(w, reg, ix, base);
    var force: boolean = (w == 0 && reg >= 4 && reg <= 7); // spl..dil
    if (rex != 64 || force) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_byte_mem_operand appends the ModR/M (+SIB+disp), index or not.
function x86_byte_mem_operand(buf: i32[], reg: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    if (has_index) {
        return x86_emit_mem_idx(buf, reg, base, index, scale, disp);
    }
    return x86_emit_mem(buf, reg, base, disp);
}

// x86_movb_imm_mem: `movb $imm8, mem` (0xC6 /0 ib).
function x86_movb_imm_mem(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32, imm: i32): i32[] {
    buf = x86_byte_mem_rex(buf, 0, 0, has_index, index, base);
    buf = buf.append(198); // 0xC6
    buf = x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
    return buf.append(imm & 255);
}

// x86_movb_reg_mem: `movb <reg8>, mem` (0x88 /r) — byte store.
function x86_movb_reg_mem(buf: i32[], reg8: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    buf = x86_byte_mem_rex(buf, 0, reg8, has_index, index, base);
    buf = buf.append(136); // 0x88
    return x86_byte_mem_operand(buf, reg8, base, has_index, index, scale, disp);
}

// x86_movb_mem_reg: `movb mem, <reg8>` (0x8A /r) — byte load.
function x86_movb_mem_reg(buf: i32[], reg8: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    buf = x86_byte_mem_rex(buf, 0, reg8, has_index, index, base);
    buf = buf.append(138); // 0x8A
    return x86_byte_mem_operand(buf, reg8, base, has_index, index, scale, disp);
}

// x86_movzbq_mem: `movzbq mem, <dst64>` (REX.W 0F B6 /r) — zero-extend a
// byte load into a 64-bit register.
function x86_movzbq_mem(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    buf = x86_byte_mem_rex(buf, 1, dst, has_index, index, base);
    buf = buf.append(15);  // 0x0F
    buf = buf.append(182); // 0xB6
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_movzbq_reg: `movzbq <src8>, <dst64>` (REX.W 0F B6 /r, reg-direct).
function x86_movzbq_reg(buf: i32[], dst: i32, src8: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, 0, src8));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(182); // 0xB6
    buf = buf.append(x86_modrm(3, dst, src8));
    return buf;
}

// ---- push/pop memory (slice 2l) ----

// x86_push_mem: `push mem` (0xFF /6) — push a memory operand.
function x86_push_mem(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    var rex: i32 = x86_rex(0, 0, ix, base);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(255); // 0xFF
    return x86_byte_mem_operand(buf, 6, base, has_index, index, scale, disp);
}

// x86_pop_mem: `pop mem` (0x8F /0).
function x86_pop_mem(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    var rex: i32 = x86_rex(0, 0, ix, base);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(143); // 0x8F
    return x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
}

// x86_setcc_reg8: `set<cc> <reg8>` (0F 90+cc /0) — store the condition
// flag as a 0/1 byte. `op` is the second opcode byte (e.g. 0x9C setl).
// reg8 spl..dil (4..7) need a REX to disambiguate from ah..bh.
function x86_setcc_reg8(buf: i32[], op: i32, reg8: i32): i32[] {
    var rex: i32 = x86_rex(0, 0, 0, reg8);
    var force: boolean = (reg8 >= 4 && reg8 <= 7);
    if (rex != 64 || force) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(op);
    buf = buf.append(x86_modrm(3, 0, reg8));
    return buf;
}

// x86_alu_load_r64: `<op> <dst>, mem` with a memory *source* — the
// load-form ALU (add 0x03, sub 0x2B, cmp 0x3B; reg=dst, r/m=mem).
function x86_alu_load_r64(buf: i32[], opcode: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, dst, ix, base));
    buf = buf.append(opcode);
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// ---- SSE double + .double constants (slice 2n) ----
//
// asm.fern uses scalar-double SSE for f64: a `.double` constant in
// .rodata loaded with `movsd sym(%rip)`, the value shuttled to/from a GPR
// with `movq %xmm,%gpr` / `movq %gpr,%xmm`, arithmetic with
// addsd/subsd/mulsd/divsd, and int<->float conversions cvttsd2si /
// cvtsi2sd. xmm registers are numbered 0..15 (REX.R/.B for xmm8..15).

// x86_le64_i64 appends the 8 little-endian bytes of an i64 (e.g. the
// IEEE-754 bits of a .double constant).
function x86_le64_i64(buf: i32[], v: i64): i32[] {
    buf = buf.append((v & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 32) & 255) as i32);
    buf = buf.append(((v >> 40) & 255) as i32);
    buf = buf.append(((v >> 48) & 255) as i32);
    buf = buf.append(((v >> 56) & 255) as i32);
    return buf;
}

// x86_movq_gpr_to_xmm: `movq <gpr>, <xmm>` (66 REX.W 0F 6E /r) — move the
// raw 64 bits from a GPR into an xmm (reg=xmm, r/m=gpr).
function x86_movq_gpr_to_xmm(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    buf = buf.append(x86_rex(1, xmm, 0, gpr));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(110); // 0x6E
    buf = buf.append(x86_modrm(3, xmm, gpr));
    return buf;
}

// x86_movq_xmm_to_gpr: `movq <xmm>, <gpr>` (66 REX.W 0F 7E /r).
function x86_movq_xmm_to_gpr(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    buf = buf.append(x86_rex(1, xmm, 0, gpr));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(126); // 0x7E
    buf = buf.append(x86_modrm(3, xmm, gpr));
    return buf;
}

// x86_sse_any_rr: `[pfx] [REX] 0F <op> /r` with a direct ModR/M — the
// whole two-byte-opcode SSE surface in one shape. The mandatory prefix
// selects the operand flavour (F2 scalar double, F3 scalar single, 66
// packed double / packed integer, 0 = none, the ps forms) and goes BEFORE
// the REX. ModRM.reg is the first register (usually the xmm destination;
// pmovmskb/movmsk pass the GPR destination there).
function x86_sse_any_rr(buf: i32[], pfx: i32, opcode: i32, reg: i32, rm: i32): i32[] {
    if (pfx != 0) { buf = buf.append(pfx); }
    var rex: i32 = x86_rex(0, reg, 0, rm);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(opcode);
    return buf.append(x86_modrm(3, reg, rm));
}

// x86_sse_3a_imm: `66 [REX] 0F 3A <op> /r ib` direct — roundsd/roundss,
// pcmpistri/pcmpestri, and the pextr/pinsr register forms. `w` sets REX.W
// (pextrq/pinsrq).
function x86_sse_3a_imm(buf: i32[], w: i32, opcode: i32, reg: i32, rm: i32, imm: i32): i32[] {
    buf = buf.append(102); // 0x66
    var rex: i32 = x86_rex(w, reg, 0, rm);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(58); // 0x3A
    buf = buf.append(opcode);
    buf = buf.append(x86_modrm(3, reg, rm));
    return buf.append(imm & 255);
}

// x86_movd_gpr_to_xmm: `movd <xmm>, <gpr32>` (66 0F 6E /r) — the 32-bit
// sibling of x86_movq_gpr_to_xmm.
function x86_movd_gpr_to_xmm(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    var rex: i32 = x86_rex(0, xmm, 0, gpr);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15);  // 0x0F
    buf = buf.append(110); // 0x6E
    return buf.append(x86_modrm(3, xmm, gpr));
}

// x86_movd_xmm_to_gpr: `movd <gpr32>, <xmm>` (66 0F 7E /r) — the inverse.
function x86_movd_xmm_to_gpr(buf: i32[], xmm: i32, gpr: i32): i32[] {
    buf = buf.append(102); // 0x66
    var rex: i32 = x86_rex(0, xmm, 0, gpr);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15);  // 0x0F
    buf = buf.append(126); // 0x7E
    return buf.append(x86_modrm(3, xmm, gpr));
}

// ---- packed SSE2 (the fused vector kernels of ATLAS-PLATFORM-PLAN §3) ----
//
// Before these this assembler had no packed surface at all — only the scalar
// float ops that shuttle an f64 through xmm. That gap is §3.3a's rule: check
// the assembler for every target a vector kernel is about to be emitted on,
// and land the encodings first. Its failure mode here is a refusal (the
// mnemonic lands on `unknown` and the driver rejects the output), not a wrong
// answer — but a refusal to compile is still a break.
//
// SSE2 is inside the declared x86-64 baseline (Haswell-class), so a selected
// instruction is a hard requirement and there is nothing to feature-detect.

// x86_bitscan_r32: the `[REX] 0F <op> /r` direct-ModR/M shape shared by bsf
// (0xBC) and bsr (0xBD). Both set ZF when the source is zero and leave the
// destination undefined, which is why callers branch on ZF first.
function x86_bitscan_r32(buf: i32[], opcode: i32, dst: i32, src: i32): i32[] {
    var rex: i32 = x86_rex(0, dst, 0, src);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(opcode);
    return buf.append(x86_modrm(3, dst, src));
}

// x86_bsf_r32: `bsfl <src32>, <dst32>` (0F BC /r) — the index of the LOWEST
// set bit. NOT tzcnt: that is BMI1, and below the baseline its F3 prefix is
// ignored so it decodes as this instruction anyway.
function x86_bsf_r32(buf: i32[], dst: i32, src: i32): i32[] {
    return x86_bitscan_r32(buf, 188, dst, src); // 0xBC
}

// x86_bsr_r32: `bsrl <src32>, <dst32>` (0F BD /r) — the index of the HIGHEST
// set bit, which over a pmovmskb mask is the RIGHTMOST matching byte. That is
// the one instruction separating __rmemchr's vector body from __memchr's;
// lzcnt is the BMI1 sibling and returns a leading-zero COUNT rather than a bit
// index, so it is not a drop-in even where the baseline allows it.
function x86_bsr_r32(buf: i32[], dst: i32, src: i32): i32[] {
    return x86_bitscan_r32(buf, 189, dst, src); // 0xBD
}

// ---- bit-count (Haswell baseline: BMI1 + SSE4.2) ----
//
// lzcnt / tzcnt / popcnt share one shape: F3 [REX.W] 0F <op> /r, direct
// ModR/M. Below the baseline LZCNT/TZCNT decode as bsr/bsf and give wrong
// answers silently, where POPCNT faults — see docs/BACKEND-PARITY.md.
function x86_bitcnt_rr(buf: i32[], opcode: i32, w: i32, dst: i32, src: i32): i32[] {
    buf = buf.append(243); // 0xF3
    var rex: i32 = x86_rex(w, dst, 0, src);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(opcode);
    return buf.append(x86_modrm(3, dst, src));
}

function x86_lzcnt_rr(buf: i32[], w: i32, dst: i32, src: i32): i32[] {
    return x86_bitcnt_rr(buf, 189, w, dst, src); // 0xBD
}

function x86_tzcnt_rr(buf: i32[], w: i32, dst: i32, src: i32): i32[] {
    return x86_bitcnt_rr(buf, 188, w, dst, src); // 0xBC
}

function x86_popcnt_rr(buf: i32[], w: i32, dst: i32, src: i32): i32[] {
    return x86_bitcnt_rr(buf, 184, w, dst, src); // 0xB8
}

// x86_cvttsd2si: `cvttsd2si <gpr>, <xmm>` (F2 REX.W 0F 2C /r) — truncate a
// double to a signed 64-bit integer.
function x86_cvttsd2si(buf: i32[], gpr: i32, xmm: i32): i32[] {
    return x86_cvttsd2si_w(buf, 1, gpr, xmm);
}

// x86_cvttsd2si_w is x86_cvttsd2si with an explicit operand width. The
// 32-bit form truncates to 32 bits and zeroes the upper half, so the width
// is load-bearing, not a choice of encoding.
function x86_cvttsd2si_w(buf: i32[], w: i32, gpr: i32, xmm: i32): i32[] {
    buf = buf.append(242); // 0xF2
    var rex: i32 = x86_rex(w, gpr, 0, xmm);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(44); // 0x2C
    return buf.append(x86_modrm(3, gpr, xmm));
}

// x86_cvtsi2sd: `cvtsi2sd{l,q} <xmm>, <gpr>` (F2 [REX.W] 0F 2A /r) —
// convert a signed integer to a double; `w` selects the 64-bit source
// (the 32-bit form reads only the low half, so the width is load-bearing).
function x86_cvtsi2sd(buf: i32[], w: i32, xmm: i32, gpr: i32): i32[] {
    buf = buf.append(242); // 0xF2
    var rex: i32 = x86_rex(w, xmm, 0, gpr);
    if (w == 1 || rex != 64) {
        buf = buf.append(rex);
    }
    buf = buf.append(15); // 0x0F
    buf = buf.append(42); // 0x2A
    buf = buf.append(x86_modrm(3, xmm, gpr));
    return buf;
}

// ---- immediate ALU (slice 2b) ----

// x86_alu_r64_imm32 encodes the `<op> <reg>, imm32` group-1 form:
// REX.W + 0x81 /digit, where `slash` is the opcode-extension in the
// ModR/M reg field (0 = add, 5 = sub, 7 = cmp). imm32 little-endian.
// The full imm32 form (vs the compact 0x83 /digit imm8) keeps the
// encoder uniform for any constant.
function x86_alu_r64_imm32(buf: i32[], slash: i32, reg: i32, imm: i32): i32[] {
    buf = buf.append(x86_rex(1, 0, 0, reg)); // reg in rm field
    buf = buf.append(129); // 0x81
    buf = buf.append(x86_modrm(3, slash, reg));
    return x86_le32(buf, imm);
}

// x86_add_r64_imm32: `add <reg>, imm32` (0x81 /0).
function x86_add_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    return x86_alu_r64_imm32(buf, 0, reg, imm);
}

// x86_sub_r64_imm32: `sub <reg>, imm32` (0x81 /5).
function x86_sub_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    return x86_alu_r64_imm32(buf, 5, reg, imm);
}

// x86_cmp_r64_imm32: `cmp <reg>, imm32` (0x81 /7).
function x86_cmp_r64_imm32(buf: i32[], reg: i32, imm: i32): i32[] {
    return x86_alu_r64_imm32(buf, 7, reg, imm);
}

// x86_cmp_r64_r64: `cmp <a>, <b>` (64-bit) — REX.W + 0x39 /r.
function x86_cmp_r64_r64(buf: i32[], a: i32, b: i32): i32[] {
    buf = buf.append(x86_rex(1, b, 0, a));
    buf = buf.append(57); // 0x39
    buf = buf.append(x86_modrm(3, b, a));
    return buf;
}

// ---- control flow (slice 2b) ----
//
// Near branches take a 32-bit displacement relative to the *next*
// instruction: rel32 = target_offset - (branch_offset + branch_length).
// Backward branches (target already emitted) can compute this directly;
// forward branches need a fixup pass (a later slice's label table).

// Condition codes for the 0F 8x near-jcc opcodes.
function x86_cc_e(): i32 { return 4; }   // je  / jz
function x86_cc_ne(): i32 { return 5; }  // jne / jnz
function x86_cc_l(): i32 { return 12; }  // jl  (signed <)
function x86_cc_ge(): i32 { return 13; } // jge (signed >=)
function x86_cc_le(): i32 { return 14; } // jle (signed <=)
function x86_cc_g(): i32 { return 15; }  // jg  (signed >)
function x86_cc_b(): i32 { return 2; }   // jb  (unsigned <,  CF=1)
function x86_cc_ae(): i32 { return 3; }  // jae (unsigned >=, CF=0)
function x86_cc_be(): i32 { return 6; }  // jbe (unsigned <=)
function x86_cc_a(): i32 { return 7; }   // ja  (unsigned >)
function x86_cc_s(): i32 { return 8; }   // js  (sign set)
function x86_cc_ns(): i32 { return 9; }  // jns (sign clear)
function x86_cc_p(): i32 { return 10; }  // jp  (parity, NaN tests)

// x86_movabsq: `movabs <reg>, imm64` (REX.W 0xB8+rd io) — load a full
// 64-bit immediate (heap addresses, IEEE-754 bit patterns, wide masks).
function x86_movabsq(buf: i32[], reg: i32, imm: i64): i32[] {
    buf = buf.append(x86_rex(1, 0, 0, reg)); // REX.W (+ REX.B for r8..r15)
    buf = buf.append(184 + (reg & 7));       // 0xB8 + rd
    return x86_le64_i64(buf, imm);
}

// ---- 32-bit ALU + extends + cmov (slice 2q) ----
//
// asm.fern's runtime uses 32-bit (`l`-suffixed) ops for the alloc bump /
// map probing / byte-string scanning, plus cmov for min/max and the
// sign/zero-extend loads. 32-bit ops carry a REX only when an operand is
// r8..r15 (no REX.W); the result zero-extends into the full 64-bit reg.

// x86_mov_load_rip_label: `movq sym(%rip), <dst>` (REX.W 8B /r, ModR/M
// mod=00 rm=101) with a deferred rip-relative fixup — the form asm.fern
// uses to load a .bss/.data global (e.g. the heap pointer).
function x86_mov_load_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: a.code.append(x86_rex(1, dst, 0, 0)) };
    a = X86Asm { ...a, code: a.code.append(139) }; // 0x8B
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, dst, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_movl_load_rip_label: `movl sym(%rip), <dst32>` (8B /r, no REX.W,
// ModR/M mod=00 rm=101) with a deferred rip-relative fixup — the 32-bit
// sibling of x86_mov_load_rip_label. asm.fern reads the
// __fern_rc_underflow counter this way.
function x86_movl_load_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: x86_rex_opt(a.code, dst, 0, 0) };
    a = X86Asm { ...a, code: a.code.append(139) }; // 0x8B
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, dst, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_store_imm_rip_label emits `mov $imm, sym(%rip)` at one of the three
// widths: `opcode` is 0xC7 (movq / movl) or 0xC6 (movb), `w` sets REX.W, and
// `imm_bytes` is the immediate's width — 4 for movq / movl, 1 for movb.
//
// This is the one rip-relative shape whose instruction continues past its
// disp32, so the displacement is registered with the immediate's width as a
// tail: x86_resolve measures from the end of the instruction, not the end of
// the displacement, and without that the store lands `imm_bytes` too far on.
function x86_store_imm_rip_label(own a: X86Asm, opcode: i32, w: i32, name: string, imm: i32, imm_bytes: i32): X86Asm {
    if (w != 0) { a = X86Asm { ...a, code: a.code.append(x86_rex(1, 0, 0, 0)) }; }
    a = X86Asm { ...a, code: a.code.append(opcode) };
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, 0, 5) ) };   // RIP-relative, /0
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name + "") };
    a = X86Asm { ...a, fix_tail_offs: a.fix_tail_offs.append(patch_off) };
    a = X86Asm { ...a, fix_tail_bytes: a.fix_tail_bytes.append(imm_bytes) };
    if (imm_bytes == 1) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
    return X86Asm { ...a, code: x86_le32(a.code, imm) };
}

// x86_fix_tail returns the instruction bytes following the disp32 patched at
// `patch_off` — 0 for every fixup but an immediate store to a rip-relative
// global.
function x86_fix_tail(a: X86Asm, patch_off: i32): i32 {
    var i: i32 = 0;
    while (i < a.fix_tail_offs.len()) {
        if (a.fix_tail_offs[i] == patch_off) { return a.fix_tail_bytes[i]; }
        i = i + 1;
    }
    return 0;
}

// x86_mov_store_rip_label: `movq <src>, sym(%rip)` (REX.W 89 /r, ModR/M
// mod=00 rm=101) with a deferred rip-relative fixup.
function x86_mov_store_rip_label(own a: X86Asm, src: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: a.code.append(x86_rex(1, src, 0, 0)) };
    a = X86Asm { ...a, code: a.code.append(137) }; // 0x89
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, src, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_movl_store_rip_label: `movl <src32>, sym(%rip)` (89 /r, no REX.W) —
// the 32-bit sibling of x86_mov_store_rip_label, for a 32-bit global.
function x86_movl_store_rip_label(own a: X86Asm, src: i32, name: string): X86Asm {
    if (src >= 8) {
        a = X86Asm { ...a, code: a.code.append(x86_rex(0, src, 0, 0)) }; // REX.R
    }
    a = X86Asm { ...a, code: a.code.append(137) }; // 0x89
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, src, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) };
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    return X86Asm { ...a, fix_names: a.fix_names.append(name) };
}

// x86_rex_opt pushes a REX byte only if any extension bit is set (w must
// be 0 here — used for the 32-bit / byte ops whose default size needs no
// prefix unless an extended register is involved).
function x86_rex_opt(buf: i32[], reg: i32, index: i32, base: i32): i32[] {
    var rex: i32 = x86_rex(0, reg, index, base);
    if (rex != 64) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_mov_r32_r32: `movl <src>, <dst>` (0x89 /r, 32-bit).
function x86_mov_r32_r32(buf: i32[], dst: i32, src: i32): i32[] {
    buf = x86_rex_opt(buf, src, 0, dst);
    buf = buf.append(137); // 0x89
    return buf.append(x86_modrm(3, src, dst));
}

// x86_movl_store: `movl <src>, mem` (0x89 /r) — 32-bit store.
function x86_movl_store(buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32, src: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = x86_rex_opt(buf, src, ix, base);
    buf = buf.append(137); // 0x89
    return x86_byte_mem_operand(buf, src, base, has_index, index, scale, disp);
}

// x86_movl_load: `movl mem, <dst>` (0x8B /r) — 32-bit load (zero-extends).
function x86_movl_load(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = x86_rex_opt(buf, dst, ix, base);
    buf = buf.append(139); // 0x8B
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_movslq_load: `movslq mem, <dst>` (REX.W 0x63 /r) — sign-extend a
// 32-bit memory operand into a 64-bit register.
function x86_movslq_load(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, dst, ix, base));
    buf = buf.append(99); // 0x63
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_movslq_rr: `movslq <src32>, <dst64>` (REX.W 0x63 /r, reg-direct) —
// sign-extend a 32-bit register into a 64-bit one (asm.fern widens the
// i32 `.len()` result with `movslq %eax, %rax`).
function x86_movslq_rr(buf: i32[], dst: i32, src: i32): i32[] {
    buf = buf.append(x86_rex(1, dst, 0, src));
    buf = buf.append(99); // 0x63
    return buf.append(x86_modrm(3, dst, src));
}

// x86_movzwq_load: `movzwq mem, <dst>` (REX.W 0F B7 /r) — zero-extend a
// 16-bit memory operand into a 64-bit register.
function x86_movzwq_load(buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
    var ix: i32 = 0;
    if (has_index) { ix = index; }
    buf = buf.append(x86_rex(1, dst, ix, base));
    buf = buf.append(15);  // 0x0F
    buf = buf.append(183); // 0xB7
    return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

// x86_nop_fill appends the n-byte (1..11) NOP GNU as fills .text alignment
// padding with (binutils' alt_patt: 0F 1F multi-byte NOPs, prefix-padded).
function x86_nop_fill(buf: i32[], n: i32): i32[] {
    if (n == 1) { return buf.append(144); }                    // 90
    if (n == 2) { buf = buf.append(102); return buf.append(144); } // 66 90
    if (n >= 9 || n == 6) { buf = buf.append(102); }           // leading 66s
    if (n == 11) { buf = buf.append(102); }
    if (n >= 10) { buf = buf.append(46); }                     // 2E cs override
    buf = buf.append(15);  // 0F
    buf = buf.append(31);  // 1F
    if (n == 3) { return buf.append(0); }                      // 0F 1F 00
    if (n == 4) { buf = buf.append(64); return buf.append(0); } // 0F 1F 40 00
    if (n == 5 || n == 6) {
        buf = buf.append(68);                                  // 0F 1F 44 00 00
        buf = buf.append(0);
        return buf.append(0);
    }
    if (n == 7) { buf = buf.append(128); } else { buf = buf.append(132); }
    if (n != 7) { buf = buf.append(0); }                       // SIB 00
    buf = buf.append(0);
    buf = buf.append(0);
    buf = buf.append(0);
    return buf.append(0);
}

// x86_nop_pad pads with the longest (11-byte) fill repeated, then one
// shorter fill — the sequence gas emits for large paddings.
function x86_nop_pad(buf: i32[], n: i32): i32[] {
    while (n > 11) {
        buf = x86_nop_fill(buf, 11);
        n = n - 11;
    }
    if (n > 0) { buf = x86_nop_fill(buf, n); }
    return buf;
}

// x86_jcc_rel32: a near conditional jump (0F 80+cc) with a 32-bit
// signed displacement. 6 bytes total.
function x86_jcc_rel32(buf: i32[], cc: i32, rel: i32): i32[] {
    buf = buf.append(15);             // 0x0F
    buf = buf.append(128 + (cc & 15)); // 0x80 + cc
    return x86_le32(buf, rel);
}

// x86_je_rel32 / x86_jne_rel32: the two most common conditionals.
function x86_je_rel32(buf: i32[], rel: i32): i32[] {
    return x86_jcc_rel32(buf, x86_cc_e(), rel);
}
function x86_jne_rel32(buf: i32[], rel: i32): i32[] {
    return x86_jcc_rel32(buf, x86_cc_ne(), rel);
}

// x86_jmp_rel32: an unconditional near jump (0xE9 cd). 5 bytes total.
function x86_jmp_rel32(buf: i32[], rel: i32): i32[] {
    buf = buf.append(233); // 0xE9
    return x86_le32(buf, rel);
}

// x86_branch_rel computes the rel32 a branch at `branch_off` (the offset
// of its first opcode byte) needs to reach `target_off`, given the
// branch's total encoded length `branch_len` (6 for jcc, 5 for jmp/call).
function x86_branch_rel(target_off: i32, branch_off: i32, branch_len: i32): i32 {
    return target_off - (branch_off + branch_len);
}

// ---- forward references (slice 2c) ----
//
// A forward branch can't know its rel32 when emitted (the target isn't
// laid down yet). The standard fix: emit a placeholder rel32 (zeros),
// remember where the rel32 field starts, and patch it once the target
// offset is known. x86_patch_rel32 is that patch; the label/fixup table a
// text assembler needs is built on top of it.

// x86_call_rel32: a near `call` (0xE8 cd) with a 32-bit signed
// displacement. 5 bytes total — same rel math as jmp.
function x86_call_rel32(buf: i32[], rel: i32): i32[] {
    buf = buf.append(232); // 0xE8
    return x86_le32(buf, rel);
}

// x86_patch_rel32 overwrites the 4 little-endian rel32 bytes already in
// `buf` starting at offset `at` (the rel32 field of a previously-emitted
// branch placeholder). Used to resolve a forward reference once its
// target offset is known.
//
// `own buf` is what makes the patch path linear rather than O(code_len^2).
// A BORROWED array parameter forces every `.with` down the copy-on-write
// path — the callee cannot know the caller has no other reader — so each
// patched branch cloned the whole .text buffer. Every caller must therefore
// pass a fresh value, another `own` parameter, or a self-reassign
// `code = x86_patch_rel32(code, …)` (E051), which is why the two patch
// loops below lift the buffer out of the struct first.
function x86_patch_rel32(own buf: i32[], at: i32, rel: i32): i32[] {
    buf = buf.with(at, rel & 255);
    buf = buf.with(at + 1, (rel >> 8) & 255);
    buf = buf.with(at + 2, (rel >> 16) & 255);
    buf = buf.with(at + 3, (rel >> 24) & 255);
    return buf;
}

// x86_rel_to computes the rel32 to patch into a placeholder whose rel32
// field starts at `patch_off`, to reach `target_off`. The branch's next
// instruction is 4 bytes past the rel32 field, so
// rel = target_off - (patch_off + 4) — independent of opcode length, so
// it works for jcc / jmp / call alike given that branch's rel32 offset.
function x86_rel_to(target_off: i32, patch_off: i32): i32 {
    return target_off - (patch_off + 4);
}

// ---- named-label assembler (slice 2d) ----
//
// A reusable label/fixup table over the patch primitive: this is the API
// a text assembler (asm.fern GAS text -> bytes) calls instead of doing
// offset bookkeeping by hand. Branches name a label; backward labels (the
// target already has an offset) are patched immediately, forward ones are
// queued and resolved by x86_resolve once every label is placed.
//
// State lives in an X86Asm struct: the code buffer, parallel label
// name/offset arrays (linear lookup — label counts per function are
// small), and parallel fixup patch-offset / target-name arrays. Raw
// instructions still go straight through the encoders into `a.code`
// (`a.code = x86_mov_r32_imm32(a.code, ...)`); only branches that target a
// label go through this layer.

pub struct X86Asm {
    code: i32[],
    rodata: i32[],
    bss_size: i32,
    // Absolute 8-byte data relocations — a `.quad <label>` in .rodata, how
    // a constant aggregate holds a pointer to a string literal. Unlike the
    // rel32 code fixups these need the virtual address, so x86_resolve_data
    // resolves them separately once the load address is known.
    dfix_offs: i32[],
    dfix_names: string[],
    lab_names: string[],
    lab_secs: i32[],
    lab_offs: i32[],
    // Name index over lab_names, so a lookup is a bucket walk rather than a
    // scan of every label placed so far. lab_head/lab_tail hold the first and
    // last lab_names index in each bucket (-1 when empty) and lab_next chains
    // one entry to the next WITHIN a bucket, in insertion order — which is
    // what keeps a duplicate name resolving to its FIRST definition, exactly
    // as the linear scan did.
    lab_head: i32[],
    lab_tail: i32[],
    lab_next: i32[],
    fix_offs: i32[],
    fix_names: string[],
    // Patch offsets whose instruction continues PAST the disp32 — an
    // immediate store to a rip-relative global (`movq $0, sym(%rip)`) is the
    // only shape that does. A rip displacement is measured from the end of
    // the whole instruction, so those need the trailing immediate's width
    // subtracted; every other fixup ends at its disp32 and is absent here.
    fix_tail_offs: i32[],
    fix_tail_bytes: i32[],
    // Mnemonics (or mnemonic+operand shapes) the GAS front-end did not
    // recognise. A non-empty list means the byte stream is INCOMPLETE —
    // instructions were dropped — so drivers must fail instead of writing
    // the corrupt executable (SH-005; the arm64 assembler's `p.unknown`
    // is the model — see fern.fern's -target arm64-linux check).
    unknown: string[],
}

// x86_label_buckets is the bucket count of the label-name index. Prime, so
// unrelated hash strides do not alias onto one bucket. Sized for the ~14k
// labels a whole-compiler module places: a few names per bucket.
function x86_label_buckets(): i32 { return 4093; }

// x86_name_bucket hashes a label name to a bucket. Folded by the modulus at
// every step rather than at the end, so the accumulator stays under 2^20 and
// the hash needs no wrapping arithmetic.
function x86_name_bucket(name: string): i32 {
    var h: i32 = 0;
    var i: i32 = 0;
    var n: i32 = name.len();
    while (i < n) {
        h = ((h * 131) + (name[i] as i32)) % 4093;
        i = i + 1;
    }
    return h;
}

// x86_empty_buckets is a bucket array of `x86_label_buckets()` empty slots.
function x86_empty_buckets(): i32[] {
    var b: i32[] = [];
    var i: i32 = 0;
    var n: i32 = x86_label_buckets();
    while (i < n) {
        b = b.append(0 - 1);
        i = i + 1;
    }
    return b;
}

// x86_asm_new returns an empty assembler state.
function x86_asm_new(): X86Asm {
    return X86Asm { code: [], rodata: [], bss_size: 0, dfix_offs: [], dfix_names: [], lab_names: [], lab_secs: [], lab_offs: [], lab_head: x86_empty_buckets(), lab_tail: x86_empty_buckets(), lab_next: [], fix_offs: [], fix_names: [], fix_tail_offs: [], fix_tail_bytes: [], unknown: [] };
}

// x86_align8 rounds `n` up to the next multiple of 8 — the .text/.rodata
// boundary the ELF data image uses (so a rip-relative reference to .rodata
// resolves to the same offset the loader maps it at).
function x86_align8(n: i32): i32 {
    var p: i32 = n;
    while ((p % 8) != 0) {
        p = p + 1;
    }
    return p;
}

// x86_add_label records `name` in section `sec` at in-section offset `off`,
// appending to the parallel label arrays and threading the new entry onto the
// TAIL of its name bucket. Appending at the tail (rather than the cheaper
// push-front) is what makes x86_label_idx's bucket walk visit definitions in
// the order they were placed, so a repeated name still resolves to the first.
function x86_add_label(own a: X86Asm, name: string, sec: i32, off: i32): X86Asm {
    var at: i32 = a.lab_names.len();
    var b: i32 = x86_name_bucket(name);
    var prev: i32 = a.lab_tail[b];
    a = X86Asm { ...a, lab_names: a.lab_names.append(name) };
    a = X86Asm { ...a, lab_secs: a.lab_secs.append(sec) };
    a = X86Asm { ...a, lab_offs: a.lab_offs.append(off) };
    a = X86Asm { ...a, lab_next: a.lab_next.append(0 - 1) };
    if (prev < 0) {
        a = X86Asm { ...a, lab_head: a.lab_head.with(b, at) };
    } else {
        a = X86Asm { ...a, lab_next: a.lab_next.with(prev, at) };
    }
    a = X86Asm { ...a, lab_tail: a.lab_tail.with(b, at) };
    return a;
}

// x86_label records `name` at the current .text offset (section 0).
function x86_label(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.code.len();
    return x86_add_label(a, name, 0, off);
}

// x86_rodata_label records `name` at the current .rodata offset (section
// 1); follow it with bytes pushed onto a.rodata (e.g. via x86_rodata_quad).
function x86_rodata_label(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.rodata.len();
    return x86_add_label(a, name, 1, off);
}

// x86_rodata_quad appends `v` as 8 little-endian bytes to .rodata — a `.quad`
// constant. The value is i64 because a `.quad` is: taking it as an i32 half and
// a separately-supplied high half meant every caller had to know the sign, and
// the one caller passed a hardcoded zero (#6458).
function x86_rodata_quad(own a: X86Asm, v: i64): X86Asm {
    return X86Asm { ...a, rodata: x86_le64_i64(a.rodata, v) };
}

// x86_bss_label records `name` at the current .bss offset (section 2).
// .bss is zero-init memory not present in the file: only the running size
// advances (x86_bss_skip), and the ELF sets p_memsz > p_filesz.
function x86_bss_label(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.bss_size;
    return x86_add_label(a, name, 2, off);
}

// x86_bss_skip advances the .bss size by `n` bytes (a `.skip`/`.quad`/
// `.align` reservation in the .bss section).
function x86_bss_skip(own a: X86Asm, n: i32): X86Asm {
    a = X86Asm { ...a, bss_size: a.bss_size + n };
    return a;
}

// x86_label_idx returns the index of `name` in the label table, or -1.
// Walks that name's bucket rather than the whole table: the scan it replaces
// was 37% of a whole-compiler assemble, one pass over ~14k names per branch
// fixup and again per resolve (#6911).
function x86_label_idx(a: X86Asm, name: string): i32 {
    var i: i32 = a.lab_head[x86_name_bucket(name)];
    while (i >= 0) {
        if (a.lab_names[i] == name) {
            return i;
        }
        i = a.lab_next[i];
    }
    return 0 - 1;
}

// x86_label_off returns the in-section offset of a .text label `name`, or
// -1 if not yet placed. (Used for the immediate backward-branch patch,
// which only targets .text — .rodata offsets aren't final until resolve.)
pub function x86_label_off(a: X86Asm, name: string): i32 {
    var i: i32 = x86_label_idx(a, name);
    if (i < 0 || a.lab_secs[i] != 0) {
        return 0 - 1;
    }
    return a.lab_offs[i];
}

// x86_final_off resolves `name` to its offset (from .text start) in the
// final image, given the two section bases: the padded .text length
// (where .rodata starts) and where .bss starts (just past .rodata),
// matching the ELF's in-memory layout (.bss is the zero-init region after
// the file content). .text labels keep their offset.
//
// bss_base is passed rather than derived from `a.rodata.len()` because the
// patch loops below hold .rodata as a uniquely-owned local while they run —
// the struct's own field is empty there, so deriving it would read 0.
function x86_final_off(a: X86Asm, name: string, padded_text: i32, bss_base: i32): i32 {
    var i: i32 = x86_label_idx(a, name);
    if (i < 0) {
        return 0 - 1;
    }
    if (a.lab_secs[i] == 1) {
        return padded_text + a.lab_offs[i];
    }
    if (a.lab_secs[i] == 2) {
        return bss_base + a.lab_offs[i];
    }
    return a.lab_offs[i];
}

// x86_fixup_or_patch handles the rel32 of a branch placeholder just
// emitted into a.code: the rel32 field starts at a.code.len()-4. If the
// target is an already-placed .text label, patch immediately; otherwise
// queue a fixup for x86_resolve.
function x86_fixup_or_patch(own a: X86Asm, name: string): X86Asm {
    var patch_off: i32 = a.code.len() - 4;
    var target: i32 = x86_label_off(a, name);
    if (target >= 0) {
        // Take the buffer OUT of the struct before patching. `a.code` read
        // while `a` still holds it is a second reference, which sends the
        // `.with` inside x86_patch_rel32 down the copy path — one full
        // .text clone per backward branch.
        var code: i32[] = a.code;
        a = X86Asm { ...a, code: [] };
        code = x86_patch_rel32(code, patch_off, x86_rel_to(target, patch_off));
        a = X86Asm { ...a, code: code };
    } else {
        a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
        a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    }
    return a;
}

// x86_lea_rip_label emits `lea <dst>, [rip + label]` (REX.W 8D /r, ModR/M
// mod=00 rm=101 = RIP-relative) with a placeholder disp32, and queues a
// fixup. The displacement is rip-relative to the next instruction —
// exactly x86_rel_to's math — so it shares the resolve path with branches.
// Always deferred: a .rodata target's final offset isn't known until the
// whole .text is emitted.
function x86_lea_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: a.code.append(x86_rex(1, dst, 0, 0)) };
    a = X86Asm { ...a, code: a.code.append(141) }; // 0x8D
    a = X86Asm { ...a, code: a.code.append(x86_modrm(0, dst, 5)) }; // RIP-relative
    a = X86Asm { ...a, code: x86_le32(a.code, 0) }; // placeholder disp32
    var patch_off: i32 = a.code.len() - 4;
    a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
    return a;
}

// x86_jcc_label emits a conditional jump to a (possibly forward) label.
function x86_jcc_label(own a: X86Asm, cc: i32, name: string): X86Asm {
    a = X86Asm { ...a, code: x86_jcc_rel32(a.code, cc, 0) }; // placeholder rel32
    return x86_fixup_or_patch(a, name);
}

// x86_jmp_label emits an unconditional jump to a label.
function x86_jmp_label(own a: X86Asm, name: string): X86Asm {
    a = X86Asm { ...a, code: x86_jmp_rel32(a.code, 0) };
    return x86_fixup_or_patch(a, name);
}

// x86_call_reg: `call *<reg>` — FF /2, direct ModR/M. Closure and dyn-trait
// dispatch land here.
function x86_call_reg(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    buf = buf.append(255); // 0xFF
    return buf.append(x86_modrm(3, 2, reg));
}

// x86_jmp_reg: `jmp *<reg>` — FF /4, the tail-call sibling of x86_call_reg.
function x86_jmp_reg(buf: i32[], reg: i32): i32[] {
    if (reg >= 8) {
        buf = buf.append(x86_rex(0, 0, 0, reg)); // REX.B
    }
    buf = buf.append(255); // 0xFF
    return buf.append(x86_modrm(3, 4, reg));
}

// x86_call_label emits a call to a label.
function x86_call_label(own a: X86Asm, name: string): X86Asm {
    a = X86Asm { ...a, code: x86_call_rel32(a.code, 0) };
    return x86_fixup_or_patch(a, name);
}

// x86_gas_is_symbol reports whether a directive operand names a label
// rather than a numeric literal — i.e. it starts with a character that
// cannot begin a number (`.L0`, `.S3`, `__fn_main`).
function x86_gas_is_symbol(tok: string): boolean {
    if (tok.len() == 0) { return false; }
    var c: i32 = tok[0] as i32;
    if (c == 45 || c == 36) { return false; }             // '-' / '$'
    if (c >= 48 && c <= 57) { return false; }             // '0'..'9'
    return true;
}

// x86_rodata_quad_sym lays down an 8-byte placeholder in .rodata and
// queues an absolute relocation against `name`, patched by
// x86_resolve_data once the load address is known.
function x86_rodata_quad_sym(own a: X86Asm, name: string): X86Asm {
    var off: i32 = a.rodata.len();
    a = X86Asm { ...a, rodata: x86_le64_i64(a.rodata, 0) };
    a = X86Asm { ...a, dfix_offs: a.dfix_offs.append(off) };
    return X86Asm { ...a, dfix_names: a.dfix_names.append(name) };
}

// x86_resolve_data patches the absolute `.quad <label>` relocations, which
// x86_resolve cannot: a rel32 branch needs only body offsets, an absolute
// pointer needs the virtual address the image loads at. Call after
// x86_resolve with the .text vaddr; body offsets map linearly onto virtual
// addresses from there, because .text and the data blob share one PT_LOAD.
// An unresolvable name is recorded, not patched as 0.
pub function x86_resolve_data(own a: X86Asm, text_vaddr: i32): X86Asm {
    var padded_text: i32 = x86_align8(a.code.len());
    var bss_base: i32 = padded_text + a.rodata.len();
    var rodata: i32[] = a.rodata;
    a = X86Asm { ...a, rodata: [] };
    var i: i32 = 0;
    while (i < a.dfix_offs.len()) {
        var name: string = a.dfix_names[i];
        var target: i32 = x86_final_off(a, name, padded_text, bss_base);
        if (target < 0) {
            a = X86Asm { ...a, unknown: a.unknown.append(".quad " + name) };
        } else {
            var at: i32 = a.dfix_offs[i];
            var abs: i64 = (text_vaddr as i64) + (target as i64);
            var j: i32 = 0;
            while (j < 8) {
                rodata = rodata.with(at + j, ((abs >> ((j * 8) as i64)) & (255 as i64)) as i32);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return X86Asm { ...a, rodata: rodata };
}

// x86_resolve patches every queued fixup (forward branches and all
// rip-relative lea references) now that every label is placed. .rodata
// targets resolve against the padded .text length — the offset the ELF
// data image places .rodata at. Call once after emitting the whole
// program; afterwards a.code + a.rodata are the final sections.
function x86_resolve(own a: X86Asm): X86Asm {
    var padded_text: i32 = x86_align8(a.code.len());
    var bss_base: i32 = padded_text + a.rodata.len();
    // The buffer is pulled out of the struct ONCE and threaded through the
    // whole fixup loop as a uniquely-owned local, then folded back. Patching
    // it in place inside the struct cloned the entire .text per fixup.
    var code: i32[] = a.code;
    a = X86Asm { ...a, code: [] };
    var i: i32 = 0;
    while (i < a.fix_offs.len()) {
        var patch_off: i32 = a.fix_offs[i];
        var target: i32 = x86_final_off(a, a.fix_names[i], padded_text, bss_base);
        // A missing label is -1; patching that as a displacement branches
        // into the ELF header, so refuse rather than emit it (#6045).
        if (target < 0) {
            a = X86Asm { ...a, unknown: a.unknown.append("unresolved symbol " + a.fix_names[i]) };
        } else {
            code = x86_patch_rel32(code, patch_off, x86_rel_to(target, patch_off) - x86_fix_tail(a, patch_off));
        }
        i = i + 1;
    }
    return X86Asm { ...a, code: code };
}

// ============================================================
// PART 2 — GAS-text front-end
// ============================================================

// ---- string helpers ----
//
// Hand-rolled rather than taken from std/string, as arm64_native.fern does:
// this module must work both as an import and concatenated into a driver by
// its unit tests, and an `import "std/string"` breaks the second.

function x86_str_indexof(s: string, sub: string): i32 {
    var n: i32 = s.len();
    var m: i32 = sub.len();
    if (m == 0) { return 0; }
    if (m > n) { return 0 - 1; }
    var i: i32 = 0;
    while (i <= n - m) {
        var j: i32 = 0;
        var ok: boolean = true;
        while (j < m) {
            if (s[i + j] != sub[j]) { ok = false; j = m; }
            else { j = j + 1; }
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function x86_str_starts_with(s: string, pre: string): boolean {
    var m: i32 = pre.len();
    if (m > s.len()) { return false; }
    var i: i32 = 0;
    while (i < m) {
        if (s[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

function x86_str_contains(s: string, sub: string): boolean {
    return x86_str_indexof(s, sub) >= 0;
}

function x86_str_split(s: string, sep: string): string[] {
    var out: string[] = [];
    var m: i32 = sep.len();
    if (m == 0) { out = out.append(s); return out; }
    var n: i32 = s.len();
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= n - m) {
        var hit: boolean = true;
        var j: i32 = 0;
        while (j < m) {
            if (s[i + j] != sep[j]) { hit = false; j = m; }
            else { j = j + 1; }
        }
        if (hit) {
            out = out.append(slice_unchecked(s, start, i));
            i = i + m;
            start = i;
        } else {
            i = i + 1;
        }
    }
    out = out.append(slice_unchecked(s, start, n));
    return out;
}

// Formerly examples/self_host/x86_gas.fern — a GAS (AT&T) assembly
// front-end for the self-hosted x86-64 backend.
// It tokenizes the assembly text asm.fern emits and drives the byte
// encoders + label/.rodata API in x86_native.fern, producing an X86Asm
// whose `code` / `rodata` sections elf.fern wraps into a runnable binary —
// the final wiring that removes the external `as` + `ld` step.
//
// Coverage mirrors internal/native/x86_64's surface (#7886/#7893): the
// integer families at all four operand widths (ALU with carry/borrow, the
// F6/F7 and FE/FF one-operand groups, shifts/rotates and shld/shrd, the
// bt group, xadd/cmpxchg/xchg and the validated lock prefix, the string
// ops), jmp/jCC, setCC, the full cmovCC table, the bit-count group
// (lzcnt/tzcnt/popcnt — Haswell baseline, see docs/BACKEND-PARITY.md),
// and SSE/SSE2/SSE4 through that baseline (scalar and packed float math,
// the packed-integer table, vector shifts, shuffles, pextr/pinsr,
// pcmp*stri, crc32, the mask gathers). Operand forms: `%reg`, `$imm`,
// `disp(%base)`, `disp(%base,%index,scale)`, `sym(%rip)`, and bare
// branch-target labels. AT&T operand order is `op src, dst` (the reverse
// of the encoder's dst,src), and the mnemonic suffix (b/w/l/q) selects
// the operand width.
//
// Anything not recognised — mnemonic, operand shape, or directive — is
// recorded in `unknown` rather than dropped (SH-005): a dropped instruction
// is a corrupt byte stream, not a missing feature, so drivers must refuse to
// write the executable.
//
// Import-free, like the other native-binary modules: the eventual emitter
// `import`s x86_encode + this, and the unit test concatenates them.

// GasMem is a parsed memory operand: rip-relative (`sym(%rip)`, carrying
// the label), or `disp(%base)`, or `disp(%base,%index,scale)` (has_index).
struct GasMem {
    is_rip: boolean,
    label: string,
    base: i32,
    disp: i32,
    has_index: boolean,
    index: i32,
    scale: i32,
    // `disp(,%index,scale)` — index and scale with no base register, encoded
    // as a SIB with base field 101, mod=00 and a disp32. A distinct
    // addressing mode, not base 0: the empty base parses to -1, which the
    // encoders would mask to a real register.
    no_base: boolean,
}

// x86_gas_trim strips leading/trailing spaces (32) AND tabs (9). The
// self-host string `trim` only removes spaces, but asm.fern indents with
// tabs, so the mnemonic-splitting relies on this.
function x86_gas_trim(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && (s[a] == b' ' || s[a] == b'\t')) {
        a = a + 1;
    }
    while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t')) {
        b = b - 1;
    }
    return slice_unchecked(s, a, b) + "";
}

// x86_gas_reg maps a register token (`%rax` or `rax`) to its number, or -1.
function x86_gas_reg(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "rax") { return 0; }
    if (s == "rcx") { return 1; }
    if (s == "rdx") { return 2; }
    if (s == "rbx") { return 3; }
    if (s == "rsp") { return 4; }
    if (s == "rbp") { return 5; }
    if (s == "rsi") { return 6; }
    if (s == "rdi") { return 7; }
    if (s == "r8") { return 8; }
    if (s == "r9") { return 9; }
    if (s == "r10") { return 10; }
    if (s == "r11") { return 11; }
    if (s == "r12") { return 12; }
    if (s == "r13") { return 13; }
    if (s == "r14") { return 14; }
    if (s == "r15") { return 15; }
    // 32-bit GP register names (`%eax`, …) map to the same register numbers as
    // their 64-bit counterparts — asm.fern emits the 32-bit form for e.g. the
    // cvttsd2si destination (`cvttsd2si %xmm0, %eax`). Without these the token
    // resolved to -1, encoding a garbage reg field (7) + REX.R, so the truncated
    // result landed in %rdi not %eax (the capstone float / int-convert path).
    if (s == "eax") { return 0; }
    if (s == "ecx") { return 1; }
    if (s == "edx") { return 2; }
    if (s == "ebx") { return 3; }
    if (s == "esp") { return 4; }
    if (s == "ebp") { return 5; }
    if (s == "esi") { return 6; }
    if (s == "edi") { return 7; }
    if (s == "r8d") { return 8; }
    if (s == "r9d") { return 9; }
    if (s == "r10d") { return 10; }
    if (s == "r11d") { return 11; }
    if (s == "r12d") { return 12; }
    if (s == "r13d") { return 13; }
    if (s == "r14d") { return 14; }
    if (s == "r15d") { return 15; }
    return 0 - 1;
}

// x86_gas_reg8 maps an 8-bit register token (`%al`, `al`, …) to its
// number, or -1. spl/bpl/sil/dil (4..7) and r8b..r15b (8..15) included.
function x86_gas_reg8(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "al") { return 0; }
    if (s == "cl") { return 1; }
    if (s == "dl") { return 2; }
    if (s == "bl") { return 3; }
    if (s == "spl") { return 4; }
    if (s == "bpl") { return 5; }
    if (s == "sil") { return 6; }
    if (s == "dil") { return 7; }
    if (s == "r8b") { return 8; }
    if (s == "r9b") { return 9; }
    if (s == "r10b") { return 10; }
    if (s == "r11b") { return 11; }
    if (s == "r12b") { return 12; }
    if (s == "r13b") { return 13; }
    if (s == "r14b") { return 14; }
    if (s == "r15b") { return 15; }
    return 0 - 1;
}

// x86_gas_reg32 maps a 32-bit register token (`%eax`, `%r8d`, …) to its
// number 0..15, or -1.
function x86_gas_reg32(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "eax") { return 0; }
    if (s == "ecx") { return 1; }
    if (s == "edx") { return 2; }
    if (s == "ebx") { return 3; }
    if (s == "esp") { return 4; }
    if (s == "ebp") { return 5; }
    if (s == "esi") { return 6; }
    if (s == "edi") { return 7; }
    if (s == "r8d") { return 8; }
    if (s == "r9d") { return 9; }
    if (s == "r10d") { return 10; }
    if (s == "r11d") { return 11; }
    if (s == "r12d") { return 12; }
    if (s == "r13d") { return 13; }
    if (s == "r14d") { return 14; }
    if (s == "r15d") { return 15; }
    return 0 - 1;
}

// x86_gas_reg16 maps a 16-bit register token (`%ax`, `%r8w`, …) to its
// number 0..15, or -1.
function x86_gas_reg16(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "ax") { return 0; }
    if (s == "cx") { return 1; }
    if (s == "dx") { return 2; }
    if (s == "bx") { return 3; }
    if (s == "sp") { return 4; }
    if (s == "bp") { return 5; }
    if (s == "si") { return 6; }
    if (s == "di") { return 7; }
    if (s == "r8w") { return 8; }
    if (s == "r9w") { return 9; }
    if (s == "r10w") { return 10; }
    if (s == "r11w") { return 11; }
    if (s == "r12w") { return 12; }
    if (s == "r13w") { return 13; }
    if (s == "r14w") { return 14; }
    if (s == "r15w") { return 15; }
    return 0 - 1;
}

// x86_gas_reg64 is the width-STRICT 64-bit parser the suffix families use:
// only the rXX names. (x86_gas_reg also tolerates the 32-bit spellings for
// the pre-family handlers, which must not leak into a width check — a
// `q`-suffixed op naming %eax is an operand-size mismatch, not a 64-bit op.)
function x86_gas_reg64(tok: string): i32 {
    if (x86_gas_reg32(tok) >= 0) { return 0 - 1; }
    return x86_gas_reg(tok);
}

// x86_gas_reg_w parses a register token at the width the suffix selected.
function x86_gas_reg_w(tok: string, size: i32): i32 {
    if (size == 8) { return x86_gas_reg8(tok); }
    if (size == 16) { return x86_gas_reg16(tok); }
    if (size == 32) { return x86_gas_reg32(tok); }
    return x86_gas_reg64(tok);
}

// x86_gas_suffix_size maps a mnemonic's AT&T size-suffix character to its
// width in bits, or 0 when the last character is not a size suffix.
function x86_gas_suffix_size(mnem: string): i32 {
    if (mnem.len() < 2) { return 0; }
    var c: u8 = mnem[mnem.len() - 1];
    if (c == b'b') { return 8; }
    if (c == b'w') { return 16; }
    if (c == b'l') { return 32; }
    if (c == b'q') { return 64; }
    return 0;
}

// x86_gas_strip_suffix drops the mnemonic's final character.
function x86_gas_strip_suffix(mnem: string): string {
    return slice_unchecked(mnem, 0, mnem.len() - 1) + "";
}

// x86_gas_movl dispatches movl: $imm->reg, reg->reg, mem->reg (load),
// reg->mem (store), all 32-bit.
function x86_gas_movl(own a: X86Asm, src: string, dst: string): X86Asm {
    if (src.len() > 0 && src[0] == b'$') { // $imm -> reg or mem
        if (x86_str_contains(dst, "(")) { // `movl $imm, disp(%base)` (C7 /0 m32 id)
            var mi: GasMem = x86_gas_parse_mem(dst);
            if (mi.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + dst) }; }
            if (mi.is_rip) { return x86_store_imm_rip_label(a, 199, 0, mi.label, x86_gas_atoi(src), 4); }   // C7 /0, no REX.W
            a = X86Asm { ...a, code: x86_movl_store_imm32(a.code, mi.base, mi.has_index, mi.index, mi.scale, mi.disp, x86_gas_atoi(src)) };
            return a;
        }
        a = X86Asm { ...a, code: x86_mov_r32_imm32(a.code, x86_gas_reg32(dst), x86_gas_atoi(src)) };
        return a;
    }
    var src_mem: boolean = x86_str_contains(src, "(");
    var dst_mem: boolean = x86_str_contains(dst, "(");
    if (!src_mem && !dst_mem) { // reg -> reg
        a = X86Asm { ...a, code: x86_mov_r32_r32(a.code, x86_gas_reg32(dst), x86_gas_reg32(src)) };
        return a;
    }
    if (src_mem && !dst_mem) { // mem -> reg (load)
        var m: GasMem = x86_gas_parse_mem(src);
        if (m.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + src) }; }
        if (m.is_rip) { // `movl sym(%rip), %reg32` — rip-relative + fixup
            return x86_movl_load_rip_label(a, x86_gas_reg32(dst), m.label);
        }
        a = X86Asm { ...a, code: x86_movl_load(a.code, x86_gas_reg32(dst), m.base, m.has_index, m.index, m.scale, m.disp) };
        return a;
    }
    if (!src_mem && dst_mem) { // reg -> mem (store)
        var m2: GasMem = x86_gas_parse_mem(dst);
        if (m2.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + dst) }; }
        if (m2.is_rip) { // `movl %reg32, sym(%rip)`
            return x86_movl_store_rip_label(a, x86_gas_reg32(src), m2.label);
        }
        a = X86Asm { ...a, code: x86_movl_store(a.code, m2.base, m2.has_index, m2.index, m2.scale, m2.disp, x86_gas_reg32(src)) };
        return a;
    }
    return a;
}

// x86_gas_is_xmm reports whether a token names an xmm register.
function x86_gas_is_xmm(tok: string): boolean {
    return x86_str_contains(tok, "xmm");
}

// x86_gas_xmm maps an xmm token (`%xmm0`, `xmm12`, …) to its number 0..15,
// or -1.
function x86_gas_xmm(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'%') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s.len() < 4) {
        return 0 - 1;
    }
    if (s[0] != b'x' || s[1] != b'm' || s[2] != b'm') {
        return 0 - 1;
    }
    var v: i32 = 0;
    var i: i32 = 3;
    while (i < s.len()) {
        var c: i32 = s[i] as i32;
        if (c >= 48 && c <= 57) {
            v = v * 10 + (c - 48);
        }
        i = i + 1;
    }
    return v;
}

// Correctly-rounding decimal -> f64 (SH-004): round-to-nearest, ties to
// even, bit-exact with strtod / the GNU-as path. Mirrored VERBATIM from
// watbin.fern's parse_f64 machinery (pf64_*) — the assemblers are
// deliberately import-free, so the algorithm is kept in sync by hand,
// like the emit layers. See watbin.fern for the algorithm commentary.
// pf64_div2 halves the fraction buffer 0.B (grade-school left-to-right),
// returning the new buffer. May append one digit; drops a leading zero by
// signalling via the first element sentinel — the caller adjusts dp, so
// this returns the raw halved digits INCLUDING a possible leading zero.
function pf64_div2(b: i32[]): i32[] {
    var out: i32[] = [];
    var r: i32 = 0;
    var i: i32 = 0;
    while (i < b.len()) {
        var cur: i32 = r * 10 + b[i];
        out = out.append(cur / 2);
        r = cur % 2;
        i = i + 1;
    }
    if (r != 0) { out = out.append(5); }
    return out;
}

// pf64_mul2 doubles the fraction buffer 0.B (right-to-left with carry).
// A carry out of the front means the value reached [1, 2): the caller
// consumes it as the next binary digit. Returns carry * 1000000 + ... no —
// Fern has no multi-return here; the carry is prepended as a FIRST element
// (0 or 1) and the caller splits it off.
function pf64_mul2(b: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(0); i = i + 1; }
    var carry: i32 = 0;
    var j: i32 = b.len() - 1;
    while (j >= 0) {
        var cur: i32 = b[j] * 2 + carry;
        out = out.with(j, cur % 10);
        carry = cur / 10;
        j = j - 1;
    }
    var res: i32[] = [carry];
    var k: i32 = 0;
    while (k < out.len()) { res = res.append(out[k]); k = k + 1; }
    return res;
}

// pf64_sub returns b[from : upto) as a fresh array (slices are a distinct
// type here, so buffer trims copy).
function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = from;
    while (i < upto) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// pf64_all_zero reports whether every digit in b is zero.
function pf64_all_zero(b: i32[]): boolean {
    var i: i32 = 0;
    while (i < b.len()) {
        if (b[i] != 0) { return false; }
        i = i + 1;
    }
    return true;
}

function parse_f64_bits(s: string): i64 {
    var i: i32 = 0;
    var neg: boolean = false;
    if (s.len() > 0 && s[0] == b'-') { neg = true; i = 1; }
    else if (s.len() > 0 && s[0] == b'+') { i = 1; }
    var signbit: i64 = 0;
    if (neg) { var one: i64 = 1; signbit = one << 63; }
    // Collect significant digits and the decimal point position:
    // value = 0.digits × 10^dp. The 800-digit cap is what makes dropping the
    // rest into a sticky bit safe: an exact ULP tie needs at most 751
    // significant decimal digits anywhere in the binary64 range (the smallest,
    // 2^-1075, is 5^1075 / 10^1075), so an input with a non-zero digit past
    // 800 cannot be a tie and rounding up off the round bit is correct.
    var digits: i32[] = [];
    var dp: i32 = 0;
    var sticky: boolean = false;
    var started: boolean = false;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
        var d: i32 = (s[i] as i32) - 48;
        if (started || d != 0) {
            started = true;
            if (digits.len() < 800) { digits = digits.append(d); }
            else { if (d != 0) { sticky = true; } }
            dp = dp + 1;
        }
        i = i + 1;
    }
    if (i < s.len() && s[i] == b'.') {
        i = i + 1;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            var fd: i32 = (s[i] as i32) - 48;
            if (started || fd != 0) {
                started = true;
                if (digits.len() < 800) { digits = digits.append(fd); }
                else { if (fd != 0) { sticky = true; } }
            } else {
                dp = dp - 1;                // leading fraction zero shifts the point
            }
            i = i + 1;
        }
    }
    if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == b'-') { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == b'+') { i = i + 1; }
        var exp: i32 = 0;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            if (exp < 100000) { exp = exp * 10 + ((s[i] as i32) - 48); }
            i = i + 1;
        }
        if (eneg) { dp = dp - exp; } else { dp = dp + exp; }
    }
    // Trailing zeros in the significand carry no information; trimming
    // keeps the sticky/remainder tests honest.
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
        digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) { return signbit; }          // ±0.0
    // Decimal-magnitude clamps keep the shift loops bounded: |value| is in
    // [10^(dp-1), 10^dp), so dp > 310 overflows every double and dp < -350
    // underflows below half the minimum subnormal.
    if (dp > 310) { var inf: i64 = 2047; return signbit | (inf << 52); }
    if (dp < 0 - 350) { return signbit; }
    // Binary-normalize 0.digits × 10^dp into v × 2^bexp with v in [0.5, 1).
    // While the decimal point is right of the front (value >= 1), halve;
    // while the value is below 0.5, double. dp reaches 0 first, then the
    // leading-digit test finishes the job.
    var bexp: i32 = 0;
    while (dp > 0) {
        var hb: i32[] = pf64_div2(digits);
        if (hb.len() > 0 && hb[0] == 0) {
            digits = pf64_sub(hb, 1, hb.len());
            dp = dp - 1;
        } else {
            digits = hb;
        }
        bexp = bexp + 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
    }
    while (dp < 0 || (digits.len() > 0 && digits[0] < 5)) {
        var db: i32[] = pf64_mul2(digits);
        if (db[0] != 0) {
            // Carry out of the fraction: 2×0.D >= 1, i.e. C.D' × 10^dp.
            // Renormalize as 0.(C D') × 10^(dp+1) — the carry becomes the
            // new leading digit and the point advances. (Only reachable
            // while dp < 0: at dp == 0 the loop only runs when the lead
            // digit is < 5, so doubling cannot carry.)
            digits = db;
            dp = dp + 1;
        } else {
            digits = pf64_sub(db, 1, db.len());
        }
        bexp = bexp - 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
        if (digits.len() == 0) { return signbit; }
    }
    // v in [0.5, 1), value = v × 2^bexp = 1.f × 2^(bexp-1): biased exponent
    // E = bexp + 1022. E >= 2047 overflows; E <= 0 goes subnormal with
    // 52 + E mantissa bits; below -1 it is under half the minimum
    // subnormal and rounds to zero.
    var e: i32 = bexp + 1022;
    if (e >= 2047) { var inf2: i64 = 2047; return signbit | (inf2 << 52); }
    var nbits: i32 = 53;
    if (e <= 0) { nbits = 52 + e; }
    if (nbits < 0) { return signbit; }
    var mant: i64 = 0;
    var k2: i32 = 0;
    while (k2 < nbits) {
        var mb: i32[] = pf64_mul2(digits);
        mant = mant * 2 + (mb[0] as i64);
        digits = pf64_sub(mb, 1, mb.len());
        k2 = k2 + 1;
    }
    // Round to nearest, ties to even: round bit is the next binary digit;
    // sticky is any remainder (or parse-time truncation).
    var rb: i32[] = pf64_mul2(digits);
    var roundbit: i32 = rb[0];
    var rest: i32[] = pf64_sub(rb, 1, rb.len());
    var st: boolean = sticky || !pf64_all_zero(rest);
    if (roundbit == 1 && (st || (mant & 1) == 1)) { mant = mant + 1; }
    if (e <= 0) {
        // Subnormal: the E field is 0 and `bits = mant` — and a subnormal
        // that rounded up to 2^52 IS the smallest normal (E=1, f=0), which
        // this encoding produces arithmetically.
        return signbit | mant;
    }
    var full: i64 = 1;
    full = full << 53;
    if (mant == full) {
        // 1.111…1 rounded up to 10.00…0: renormalize.
        mant = mant / 2;
        e = e + 1;
        if (e >= 2047) { var inf3: i64 = 2047; return signbit | (inf3 << 52); }
    }
    var hidden: i64 = 1;
    hidden = hidden << 52;
    return signbit | ((e as i64) << 52) | (mant - hidden);
}

// x86_gas_parse_f64 parses a `.double` operand into the nearest f64.
function x86_gas_parse_f64(s: string): f64 {
    return f64_from_bits(parse_f64_bits(s));
}

// x86_gas_ascii appends the bytes of a `.ascii "…"` directive's string to
// `buf`, processing the common C escapes (\n \t \r \0 \\ \"). The string
// is the part between the first `"` and the closing unescaped `"`.
function x86_gas_ascii(buf: i32[], line: string): i32[] {
    var q1: i32 = x86_str_indexof(line, "\"");
    if (q1 < 0) {
        return buf;
    }
    var i: i32 = q1 + 1;
    while (i < line.len()) {
        var c: i32 = line[i] as i32;
        if (c == 34) { // closing '"'
            return buf;
        }
        if (c == 92 && i + 1 < line.len()) { // backslash escape
            i = i + 1;
            var e: i32 = line[i] as i32;
            if (e == 110) { c = 10; }        // \n
            else { if (e == 116) { c = 9; }  // \t
            else { if (e == 114) { c = 13; } // \r
            else { if (e == 48) { c = 0; }   // \0
            else { c = e; } } } }            // \\ \" and any other -> literal
        }
        buf = buf.append(c & 255);
        i = i + 1;
    }
    return buf;
}

// x86_gas_atoi parses a decimal integer token, tolerating a leading `$`
// (immediate sigil) and a leading `-`.
function x86_gas_atoi(tok: string): i32 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'$') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == b'-') {
        neg = true;
        i = 1;
    }
    var v: i32 = 0;
    // `0x…` hex (mirrors x86_gas_atoi64). Without this the `x` was skipped as a
    // non-digit and the hex digits read as DECIMAL — e.g. `$0x22` (the mmap
    // MAP_PRIVATE|MAP_ANONYMOUS flags asm.fern emits) parsed to 22, not 34, so
    // the heap mmap got bad flags (EBADF) and every alloc-using program's
    // runtime OOM-exited 137 (the capstone string / heap cases).
    if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + d; }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            if (c >= 48 && c <= 57) {
                v = v * 10 + (c - 48);
            }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// x86_gas_atoi64 parses a signed 64-bit integer token (decimal or `0x…`
// hex, optional `$` sigil and `-`), for movabsq's imm64. Two's-complement
// wraps give the right bits for INT64_MIN.
function x86_gas_atoi64(tok: string): i64 {
    var s: string = tok;
    if (s.len() > 0 && s[0] == b'$') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == b'-') {
        neg = true;
        i = 1;
    }
    var v: i64 = 0;
    if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + (d as i64); }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            if (c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// x86_gas_parse_mem parses a memory operand `disp(%base)` / `(%base)` /
// `disp(%base,%index,scale)` / `sym(%rip)`.
function x86_gas_parse_mem(op: string): GasMem {
    var lp: i32 = x86_str_indexof(op, "(");
    if (lp < 0) {
        // Not a memory operand — defensive fallback (avoids an op[0:-1]
        // corrupt slice); callers gate on `.contains("(")` so this is rare.
        return GasMem { is_rip: false, label: "", base: x86_gas_reg(op), disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
    }
    var disp_str: str = slice_unchecked(op, 0, lp);
    var inner: str = slice_unchecked(op, lp + 1, op.len() - 1); // between ( and )
    if (inner == "%rip") {
        return GasMem { is_rip: true, label: disp_str + "", base: 0, disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
    }
    var d: i32 = 0;
    if (disp_str.len() > 0) {
        d = x86_gas_atoi(disp_str);
    }
    var parts: string[] = x86_str_split(inner, ",");
    if (parts.len() >= 3) {
        var b0: string = x86_gas_trim(parts[0]);
        var bb: i32 = x86_gas_reg(b0);
        var ix: i32 = x86_gas_reg(x86_gas_trim(parts[1]));
        var sc: i32 = x86_gas_atoi(x86_gas_trim(parts[2]));
        return GasMem { is_rip: false, label: "", base: bb, disp: d, has_index: true, index: ix, scale: sc, no_base: b0.len() == 0 };
    }
    // Two-element SIB `(%base,%index)` — an implicit scale of 1 (asm.fern emits
    // this for byte-element indexing, e.g. `movzbl (%rax,%rcx), %eax`). Without
    // this the whole `%base,%index` string resolved to a single -1 register.
    if (parts.len() == 2) {
        var bb2: i32 = x86_gas_reg(x86_gas_trim(parts[0]));
        var ix2: i32 = x86_gas_reg(x86_gas_trim(parts[1]));
        return GasMem { is_rip: false, label: "", base: bb2, disp: d, has_index: true, index: ix2, scale: 1, no_base: x86_gas_trim(parts[0]).len() == 0 };
    }
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(x86_gas_trim(inner)), disp: d, has_index: false, index: 0, scale: 1, no_base: false };
}

// x86_gas_movq dispatches the movq operand shapes (AT&T src, dst),
// including the SSE forms movq %gpr,%xmm and movq %xmm,%gpr.
function x86_gas_movq(own a: X86Asm, src: string, dst: string): X86Asm {
    var src_xmm: boolean = x86_gas_is_xmm(src);
    var dst_xmm: boolean = x86_gas_is_xmm(dst);
    if (dst_xmm && src_xmm) { // movq %xmm, %xmm — F3 0F 7E /r, reg = dst
        a = X86Asm { ...a, code: x86_sse_any_rr(a.code, 243, 126, x86_gas_xmm(dst), x86_gas_xmm(src)) };
        return a;
    }
    if (dst_xmm && !src_xmm) { // movq r/m, %xmm — 66 REX.W 0F 6E /r
        if (x86_str_contains(src, "(")) {
            var xm: GasMem = x86_gas_parse_mem(src);
            if (!x86_gas_mem_ok(xm)) { return x86_gas_bad(a, "movq " + src + ", " + dst); }
            a = X86Asm { ...a, code: a.code.append(102) };
            a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, 64, x86_gas_xmm(dst), xm, false) };
            a = X86Asm { ...a, code: a.code.append(15) };
            a = X86Asm { ...a, code: a.code.append(110) };
            return x86_gas_membytes(a, x86_gas_xmm(dst), xm, 0);
        }
        var gs: i32 = x86_gas_reg(src);
        if (gs < 0) { return x86_gas_bad(a, "movq " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_movq_gpr_to_xmm(a.code, x86_gas_xmm(dst), gs) };
        return a;
    }
    if (src_xmm && !dst_xmm) { // movq %xmm, r/m — 66 REX.W 0F 7E /r
        if (x86_str_contains(dst, "(")) {
            var xm2: GasMem = x86_gas_parse_mem(dst);
            if (!x86_gas_mem_ok(xm2)) { return x86_gas_bad(a, "movq " + src + ", " + dst); }
            a = X86Asm { ...a, code: a.code.append(102) };
            a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, 64, x86_gas_xmm(src), xm2, false) };
            a = X86Asm { ...a, code: a.code.append(15) };
            a = X86Asm { ...a, code: a.code.append(126) };
            return x86_gas_membytes(a, x86_gas_xmm(src), xm2, 0);
        }
        var gd: i32 = x86_gas_reg(dst);
        if (gd < 0) { return x86_gas_bad(a, "movq " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_movq_xmm_to_gpr(a.code, x86_gas_xmm(src), gd) };
        return a;
    }
    if (src.len() > 0 && src[0] == b'$') { // $imm -> reg or mem
        if (x86_str_contains(dst, "(")) { // $imm -> mem (e.g. `movq $1, 8(%rax)`)
            var mi: GasMem = x86_gas_parse_mem(dst);
            if (mi.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + dst) }; }
            if (mi.is_rip) { return x86_store_imm_rip_label(a, 199, 1, mi.label, x86_gas_atoi(src), 4); }   // REX.W C7 /0
            a = X86Asm { ...a, code: x86_mov_store_imm32(a.code, mi.base, mi.has_index, mi.index, mi.scale, mi.disp, x86_gas_atoi(src)) };
            return a;
        }
        // Must SIGN-extend (REX.W C7 /0 id), not the zero-extending 32-bit
        // B8+r id — `movq $-1, %rax` is -1, not 4294967295. An immediate too
        // wide for a signed 32-bit field takes the 10-byte movabsq.
        var iv: i64 = x86_gas_atoi64(src);
        if (iv >= (0 - 2147483648) as i64 && iv <= (2147483647) as i64) {
            a = X86Asm { ...a, code: x86_mov_r64_imm32(a.code, x86_gas_reg(dst), iv as i32) };
        } else {
            a = X86Asm { ...a, code: x86_movabsq(a.code, x86_gas_reg(dst), iv) };
        }
        return a;
    }
    var src_mem: boolean = x86_str_contains(src, "(");
    var dst_mem: boolean = x86_str_contains(dst, "(");
    if (!src_mem && !dst_mem) { // reg -> reg
        a = X86Asm { ...a, code: x86_mov_r64_r64(a.code, x86_gas_reg(dst), x86_gas_reg(src)) };
        return a;
    }
    if (src_mem && !dst_mem) { // mem -> reg (load)
        var m: GasMem = x86_gas_parse_mem(src);
        if (m.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + src) }; }
        if (m.is_rip) {
            return x86_mov_load_rip_label(a, x86_gas_reg(dst), m.label);
        }
        if (m.has_index) {
            a = X86Asm { ...a, code: x86_mov_load_r64_idx(a.code, x86_gas_reg(dst), m.base, m.index, m.scale, m.disp) };
        } else {
            a = X86Asm { ...a, code: x86_mov_load_r64(a.code, x86_gas_reg(dst), m.base, m.disp) };
        }
        return a;
    }
    if (!src_mem && dst_mem) { // reg -> mem (store)
        var m2: GasMem = x86_gas_parse_mem(dst);
        if (m2.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + dst) }; }
        if (m2.is_rip) {
            return x86_mov_store_rip_label(a, x86_gas_reg(src), m2.label);
        }
        if (m2.has_index) {
            a = X86Asm { ...a, code: x86_mov_store_r64_idx(a.code, m2.base, m2.index, m2.scale, m2.disp, x86_gas_reg(src)) };
        } else {
            a = X86Asm { ...a, code: x86_mov_store_r64(a.code, m2.base, m2.disp, x86_gas_reg(src)) };
        }
        return a;
    }
    // mem -> mem has no x86 encoding, so reaching here means the operand
    // shapes were misparsed; record rather than drop (SH-005).
    return X86Asm { ...a, unknown: a.unknown.append("movq " + src + ", " + dst) };
}

// x86_gas_top_comma returns the index of the first comma at paren depth 0
// (the operand separator), or -1. A comma inside `(%base,%index,scale)`
// must not split the operands, so this skips parenthesised commas.
function x86_gas_top_comma(s: string): i32 {
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        var c: u8 = s[i];
        if (c == b'(') {
            depth = depth + 1;
        } else {
            if (c == b')') {
                depth = depth - 1;
            } else {
                if (c == b',' && depth == 0) {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// x86_gas_movb dispatches movb (AT&T src, dst): $imm->mem, $imm->reg8
// (B0+rb ib), reg8<->mem, and reg8->reg8 (88 /r). The two register-target
// shapes previously fell into the memory paths, where the unparsed operand
// masked to base %rdi — `movb $1, %cl` silently became a store through rdi.
function x86_gas_movb(own a: X86Asm, src: string, dst: string): X86Asm {
    if (src.len() > 0 && src[0] == b'$') { // $imm -> mem or reg8
        if (x86_str_contains(dst, "(")) {
            var m: GasMem = x86_gas_parse_mem(dst);
            if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, "movb " + dst); }
            if (m.is_rip) { return x86_store_imm_rip_label(a, 198, 0, m.label, x86_gas_atoi(src), 1); }   // C6 /0
            a = X86Asm { ...a, code: x86_movb_imm_mem(a.code, m.base, m.has_index, m.index, m.scale, m.disp, x86_gas_atoi(src)) };
            return a;
        }
        var ri: i32 = x86_gas_reg8(dst);
        if (ri < 0) { return x86_gas_bad(a, "movb " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_rex_r(a.code, 8, ri) };
        a = X86Asm { ...a, code: a.code.append(176 + (ri & 7)) }; // B0+rb
        return X86Asm { ...a, code: a.code.append(x86_gas_atoi(src) & 255) };
    }
    if (x86_str_contains(src, "(")) { // mem -> reg8 (load)
        var ms: GasMem = x86_gas_parse_mem(src);
        var rl: i32 = x86_gas_reg8(dst);
        if (!x86_gas_mem_ok(ms) || ms.is_rip || rl < 0) { return x86_gas_bad(a, "movb " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_movb_mem_reg(a.code, rl, ms.base, ms.has_index, ms.index, ms.scale, ms.disp) };
        return a;
    }
    if (x86_str_contains(dst, "(")) { // reg8 -> mem (store)
        var md: GasMem = x86_gas_parse_mem(dst);
        var rs: i32 = x86_gas_reg8(src);
        if (!x86_gas_mem_ok(md) || md.is_rip || rs < 0) { return x86_gas_bad(a, "movb " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_movb_reg_mem(a.code, rs, md.base, md.has_index, md.index, md.scale, md.disp) };
        return a;
    }
    var r1: i32 = x86_gas_reg8(src);
    var r2: i32 = x86_gas_reg8(dst);
    if (r1 < 0 || r2 < 0) { return x86_gas_bad(a, "movb " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op_rr(a.code, 8, 136, r1, r2) }; // 88 /r
}

// x86_gas_movzbq dispatches movzbq: mem->reg64 or reg8->reg64.
function x86_gas_movzbq(own a: X86Asm, src: string, dst: string): X86Asm {
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (m.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + src) }; }
        if (m.is_rip) { return X86Asm { ...a, unknown: a.unknown.append("rip-relative operand not encoded here: " + src) }; }
        a = X86Asm { ...a, code: x86_movzbq_mem(a.code, x86_gas_reg(dst), m.base, m.has_index, m.index, m.scale, m.disp) };
        return a;
    }
    a = X86Asm { ...a, code: x86_movzbq_reg(a.code, x86_gas_reg(dst), x86_gas_reg8(src)) };
    return a;
}

// ---- suffix-family machinery ----
//
// The AT&T mnemonic surface is organised as families keyed on the base
// mnemonic (suffix stripped) with the operand width taken from the suffix,
// mirroring internal/native/x86_64's per-family encoders. Anything a
// family cannot encode is RECORDED (SH-005) — a wrong-width encode is the
// silent-widening class the native side fixed in #3544/#7886.

// x86_gas_bad records an unsupported instruction shape (SH-005).
function x86_gas_bad(own a: X86Asm, what: string): X86Asm {
    return X86Asm { ...a, unknown: a.unknown.append(what) };
}

// x86_gas_mem_ok rejects the operand shapes the sized encoders do not
// take: the no-base SIB form and any register token that failed to parse
// (which would otherwise mask to a real register and encode silently).
function x86_gas_mem_ok(m: GasMem): boolean {
    if (m.is_rip) { return true; }
    if (m.no_base || m.base < 0) { return false; }
    if (m.has_index && m.index < 0) { return false; }
    return true;
}

// x86_gas_mem_rex appends the REX (when needed) for an op with a memory rm
// operand. `force8` marks an 8-bit REGISTER in the reg field (spl..dil
// force a REX).
function x86_gas_mem_rex(buf: i32[], size: i32, reg: i32, m: GasMem, force8: boolean): i32[] {
    var ix: i32 = 0;
    var bs: i32 = 0;
    if (!m.is_rip) {
        if (m.has_index) { ix = m.index; }
        bs = m.base;
    }
    var rex: i32 = x86_rex(x86_rex_w_of(size), reg, ix, bs);
    if (rex != 64 || force8) {
        buf = buf.append(rex);
    }
    return buf;
}

// x86_gas_membytes appends the ModR/M (+SIB+disp) for `m` — or, for a
// rip-relative operand, the mod=00 rm=101 form with a placeholder disp32
// and a queued fixup. `tail` is the immediate byte count following the
// disp32 (a rip displacement is measured from the END of the instruction).
function x86_gas_membytes(own a: X86Asm, reg: i32, m: GasMem, tail: i32): X86Asm {
    if (m.is_rip) {
        a = X86Asm { ...a, code: a.code.append(x86_modrm(0, reg, 5)) };
        a = X86Asm { ...a, code: x86_le32(a.code, 0) };
        var patch_off: i32 = a.code.len() - 4;
        a = X86Asm { ...a, fix_offs: a.fix_offs.append(patch_off) };
        a = X86Asm { ...a, fix_names: a.fix_names.append(m.label) };
        if (tail > 0) {
            a = X86Asm { ...a, fix_tail_offs: a.fix_tail_offs.append(patch_off) };
            a = X86Asm { ...a, fix_tail_bytes: a.fix_tail_bytes.append(tail) };
        }
        return a;
    }
    return X86Asm { ...a, code: x86_byte_mem_operand(a.code, reg, m.base, m.has_index, m.index, m.scale, m.disp) };
}

// x86_gas_mem_op emits `[66] [REX] [0F] <op>` then the memory rm — the
// shared tail of every sized memory form.
function x86_gas_mem_op(own a: X86Asm, size: i32, op0f: boolean, op: i32, reg: i32, m: GasMem, force8: boolean, tail: i32): X86Asm {
    a = X86Asm { ...a, code: x86_osz(a.code, size) };
    a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, size, reg, m, force8) };
    if (op0f) { a = X86Asm { ...a, code: a.code.append(15) }; }
    a = X86Asm { ...a, code: a.code.append(op) };
    return x86_gas_membytes(a, reg, m, tail);
}

// x86_gas_split_ops splits an operand list on top-level commas (commas
// inside `(%b,%i,s)` do not separate operands), trimming each piece.
function x86_gas_split_ops(rest: string): string[] {
    var out: string[] = [];
    var s: string = rest;
    var c: i32 = x86_gas_top_comma(s);
    while (c >= 0) {
        out = out.append(x86_gas_trim(slice_unchecked(s, 0, c)));
        s = slice_unchecked(s, c + 1, s.len()) + "";
        c = x86_gas_top_comma(s);
    }
    return out.append(x86_gas_trim(s));
}

// x86_gas_alu_ext maps an ALU base mnemonic to its group-1 /digit; the
// family's MR opcode row is ext*8 (add 00, or 08, adc 10, sbb 18, and 20,
// sub 28, xor 30, cmp 38).
function x86_gas_alu_ext(mnem: string): i32 {
    if (mnem == "add") { return 0; }
    if (mnem == "or") { return 1; }
    if (mnem == "adc") { return 2; }
    if (mnem == "sbb") { return 3; }
    if (mnem == "and") { return 4; }
    if (mnem == "sub") { return 5; }
    if (mnem == "xor") { return 6; }
    if (mnem == "cmp") { return 7; }
    return 0 - 1;
}

// x86_gas_unary_ext maps an F6/F7-group base mnemonic to its /digit.
function x86_gas_unary_ext(mnem: string): i32 {
    if (mnem == "not") { return 2; }
    if (mnem == "neg") { return 3; }
    if (mnem == "mul") { return 4; }
    if (mnem == "imul") { return 5; }
    if (mnem == "div") { return 6; }
    if (mnem == "idiv") { return 7; }
    return 0 - 1;
}

// x86_gas_incdec_ext maps inc/dec to their FE/FF-group /digit.
function x86_gas_incdec_ext(mnem: string): i32 {
    if (mnem == "inc") { return 0; }
    if (mnem == "dec") { return 1; }
    return 0 - 1;
}

// x86_gas_shift_ext maps a shift/rotate base mnemonic to its C0..D3-group
// /digit.
function x86_gas_shift_ext(mnem: string): i32 {
    if (mnem == "rol") { return 0; }
    if (mnem == "ror") { return 1; }
    if (mnem == "rcl") { return 2; }
    if (mnem == "rcr") { return 3; }
    if (mnem == "shl") { return 4; }
    if (mnem == "shr") { return 5; }
    if (mnem == "sar") { return 7; }
    return 0 - 1;
}

// x86_gas_bt_idx maps the bit-test family to its index: the register-form
// opcode is 0xA3 + idx*8 and the immediate-form /digit is 4 + idx.
function x86_gas_bt_idx(mnem: string): i32 {
    if (mnem == "bt") { return 0; }
    if (mnem == "bts") { return 1; }
    if (mnem == "btr") { return 2; }
    if (mnem == "btc") { return 3; }
    return 0 - 1;
}

// x86_gas_cc_code maps a condition-suffix spelling to its 4-bit condition
// code (shared by jcc 0F 80+cc, setcc 0F 90+cc, cmovcc 0F 40+cc).
function x86_gas_cc_code(cond: string): i32 {
    if (cond == "o") { return 0; }
    if (cond == "no") { return 1; }
    if (cond == "b" || cond == "c" || cond == "nae") { return 2; }
    if (cond == "ae" || cond == "nb" || cond == "nc") { return 3; }
    if (cond == "e" || cond == "z") { return 4; }
    if (cond == "ne" || cond == "nz") { return 5; }
    if (cond == "be" || cond == "na") { return 6; }
    if (cond == "a" || cond == "nbe") { return 7; }
    if (cond == "s") { return 8; }
    if (cond == "ns") { return 9; }
    if (cond == "p") { return 10; }
    if (cond == "np") { return 11; }
    if (cond == "l" || cond == "nge") { return 12; }
    if (cond == "ge" || cond == "nl") { return 13; }
    if (cond == "le" || cond == "ng") { return 14; }
    if (cond == "g" || cond == "nle") { return 15; }
    return 0 - 1;
}

// x86_gas_lockable: the base mnemonics the F0 lock prefix may precede —
// anything else is #UD at runtime, so it is refused at assembly.
function x86_gas_lockable(mnem: string): boolean {
    if (x86_gas_alu_ext(mnem) >= 0) { return mnem != "cmp"; }
    if (x86_gas_incdec_ext(mnem) >= 0) { return true; }
    if (mnem == "not" || mnem == "neg") { return true; }
    if (mnem == "xadd" || mnem == "cmpxchg" || mnem == "xchg") { return true; }
    return x86_gas_bt_idx(mnem) >= 1; // bts/btr/btc, not bt
}

// ---- fixed-byte mnemonics ----

function x86_pack1(b0: i32): i32 { return 16777216 + b0; }
function x86_pack2(b0: i32, b1: i32): i32 { return 33554432 + (b1 * 256) + b0; }
function x86_pack3(b0: i32, b1: i32, b2: i32): i32 { return 50331648 + (b2 * 65536) + (b1 * 256) + b0; }

// x86_gas_fixed_op maps a no-operand mnemonic to its bytes, little-endian
// with the byte count in the top byte; -1 when not fixed. The cbtw group
// are the AT&T spellings of cbw/cwde/cdqe/cwd/cdq/cqo.
function x86_gas_fixed_op(mnem: string): i32 {
    if (mnem == "ret") { return x86_pack1(195); }
    if (mnem == "syscall") { return x86_pack2(15, 5); }
    if (mnem == "leave") { return x86_pack1(201); }
    if (mnem == "cld") { return x86_pack1(252); }
    if (mnem == "std") { return x86_pack1(253); }
    if (mnem == "nop") { return x86_pack1(144); }
    if (mnem == "int3") { return x86_pack1(204); }
    if (mnem == "pause") { return x86_pack2(243, 144); }
    if (mnem == "mfence") { return x86_pack3(15, 174, 240); }
    if (mnem == "lfence") { return x86_pack3(15, 174, 232); }
    if (mnem == "sfence") { return x86_pack3(15, 174, 248); }
    if (mnem == "cbtw") { return x86_pack2(102, 152); }
    if (mnem == "cwtl") { return x86_pack1(152); }
    if (mnem == "cltq") { return x86_pack2(72, 152); }
    if (mnem == "cwtd") { return x86_pack2(102, 153); }
    if (mnem == "cltd") { return x86_pack1(153); }
    if (mnem == "cqto") { return x86_pack2(72, 153); }
    return 0 - 1;
}

// x86_gas_string_op maps a bare string-op mnemonic (AT&T movsl = Intel
// movsd, etc.) to its packed bytes; also consulted for the `rep` prefix.
function x86_gas_string_op(mnem: string): i32 {
    if (mnem == "movsb") { return x86_pack1(164); }
    if (mnem == "movsw") { return x86_pack2(102, 165); }
    if (mnem == "movsl") { return x86_pack1(165); }
    if (mnem == "movsq") { return x86_pack2(72, 165); }
    if (mnem == "stosb") { return x86_pack1(170); }
    if (mnem == "stosw") { return x86_pack2(102, 171); }
    if (mnem == "stosl") { return x86_pack1(171); }
    if (mnem == "stosq") { return x86_pack2(72, 171); }
    if (mnem == "lodsb") { return x86_pack1(172); }
    if (mnem == "lodsw") { return x86_pack2(102, 173); }
    if (mnem == "lodsl") { return x86_pack1(173); }
    if (mnem == "lodsq") { return x86_pack2(72, 173); }
    if (mnem == "scasb") { return x86_pack1(174); }
    if (mnem == "scasw") { return x86_pack2(102, 175); }
    if (mnem == "scasl") { return x86_pack1(175); }
    if (mnem == "scasq") { return x86_pack2(72, 175); }
    if (mnem == "cmpsb") { return x86_pack1(166); }
    if (mnem == "cmpsw") { return x86_pack2(102, 167); }
    if (mnem == "cmpsl") { return x86_pack1(167); }
    if (mnem == "cmpsq") { return x86_pack2(72, 167); }
    return 0 - 1;
}

// x86_gas_emit_packed appends a packed fixed-byte sequence.
function x86_gas_emit_packed(own a: X86Asm, packed: i32): X86Asm {
    var n: i32 = packed / 16777216;
    a = X86Asm { ...a, code: a.code.append(packed & 255) };
    if (n >= 2) { a = X86Asm { ...a, code: a.code.append((packed / 256) & 255) }; }
    if (n >= 3) { a = X86Asm { ...a, code: a.code.append((packed / 65536) & 255) }; }
    return a;
}

// ---- integer families ----

// x86_gas_alu_family assembles one sized ALU instruction (AT&T src, dst):
// reg/reg, memory source, memory destination, and the immediate forms with
// the 83 short-immediate selection — mirroring the native alu().
function x86_gas_alu_family(own a: X86Asm, mnem: string, ext: i32, size: i32, src: string, dst: string): X86Asm {
    var opbase: i32 = ext * 8;
    if (src.len() > 0 && src[0] == b'$') {
        var imm: i32 = x86_gas_atoi(src);
        if (x86_str_contains(dst, "(")) {
            var mi: GasMem = x86_gas_parse_mem(dst);
            if (!x86_gas_mem_ok(mi)) { return x86_gas_bad(a, mnem + " " + dst); }
            if (size == 8 || x86_imm_fits8(imm)) {
                var opi: i32 = 131; // 83 /ext ib
                if (size == 8) { opi = 128; } // 80 /ext ib
                a = x86_gas_mem_op(a, size, false, opi, ext, mi, false, 1);
                return X86Asm { ...a, code: a.code.append(imm & 255) };
            }
            var ib: i32 = 4;
            if (size == 16) { ib = 2; }
            a = x86_gas_mem_op(a, size, false, 129, ext, mi, false, ib);
            return X86Asm { ...a, code: x86_imm_wide(a.code, size, imm) };
        }
        var rd: i32 = x86_gas_reg_w(dst, size);
        if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return X86Asm { ...a, code: x86_grp1_imm_r(a.code, size, ext, rd, imm) };
    }
    var src_mem: boolean = x86_str_contains(src, "(");
    var dst_mem: boolean = x86_str_contains(dst, "(");
    if (src_mem && !dst_mem) { // load form: opbase|2, reg = destination
        var ml: GasMem = x86_gas_parse_mem(src);
        var rl: i32 = x86_gas_reg_w(dst, size);
        if (!x86_gas_mem_ok(ml) || rl < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return x86_gas_mem_op(a, size, false, x86_opsel(opbase | 2, size), rl, ml, x86_rex8_force(size, rl), 0);
    }
    if (dst_mem && !src_mem) { // store form: opbase, reg = source
        var ms: GasMem = x86_gas_parse_mem(dst);
        var rs: i32 = x86_gas_reg_w(src, size);
        if (!x86_gas_mem_ok(ms) || rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return x86_gas_mem_op(a, size, false, x86_opsel(opbase, size), rs, ms, x86_rex8_force(size, rs), 0);
    }
    var r1: i32 = x86_gas_reg_w(src, size);
    var r2: i32 = x86_gas_reg_w(dst, size);
    if (r1 < 0 || r2 < 0 || src_mem) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op_rr(a.code, size, opbase, r1, r2) };
}

// x86_gas_test_family: test at every width — reg/reg (84/85 MR), a memory
// operand on either side, and the F6/F7 /0 immediate forms.
function x86_gas_test_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
    if (src.len() > 0 && src[0] == b'$') {
        var imm: i32 = x86_gas_atoi(src);
        if (x86_str_contains(dst, "(")) {
            var mi: GasMem = x86_gas_parse_mem(dst);
            if (!x86_gas_mem_ok(mi)) { return x86_gas_bad(a, "test " + dst); }
            var ib: i32 = 4;
            if (size == 8) { ib = 1; }
            if (size == 16) { ib = 2; }
            a = x86_gas_mem_op(a, size, false, x86_opsel(246, size), 0, mi, false, ib);
            if (size == 8) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
            return X86Asm { ...a, code: x86_imm_wide(a.code, size, imm) };
        }
        var rd: i32 = x86_gas_reg_w(dst, size);
        if (rd < 0) { return x86_gas_bad(a, "test " + src + ", " + dst); }
        return X86Asm { ...a, code: x86_test_imm_r(a.code, size, rd, imm) };
    }
    var src_mem: boolean = x86_str_contains(src, "(");
    var dst_mem: boolean = x86_str_contains(dst, "(");
    if (src_mem != dst_mem) { // one memory side: 84/85 with reg = the register
        var mop: string = src;
        var rop: string = dst;
        if (dst_mem) { mop = dst; rop = src; }
        var m2: GasMem = x86_gas_parse_mem(mop);
        var rr: i32 = x86_gas_reg_w(rop, size);
        if (!x86_gas_mem_ok(m2) || rr < 0) { return x86_gas_bad(a, "test " + src + ", " + dst); }
        return x86_gas_mem_op(a, size, false, x86_opsel(132, size), rr, m2, x86_rex8_force(size, rr), 0);
    }
    var r1: i32 = x86_gas_reg_w(src, size);
    var r2: i32 = x86_gas_reg_w(dst, size);
    if (r1 < 0 || r2 < 0 || src_mem) { return x86_gas_bad(a, "test " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op_rr(a.code, size, 132, r1, r2) };
}

// x86_gas_unary_family: the F6/F7 (opbase 246) and FE/FF (opbase 254)
// one-operand groups, register or sized memory (rip included).
function x86_gas_unary_family(own a: X86Asm, mnem: string, opbase: i32, ext: i32, size: i32, op: string): X86Asm {
    if (x86_str_contains(op, "(")) {
        var m: GasMem = x86_gas_parse_mem(op);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + op); }
        return x86_gas_mem_op(a, size, false, x86_opsel(opbase, size), ext, m, false, 0);
    }
    var r: i32 = x86_gas_reg_w(op, size);
    if (r < 0) { return x86_gas_bad(a, mnem + " " + op); }
    return X86Asm { ...a, code: x86_unary_r(a.code, size, opbase, ext, r) };
}

// x86_gas_shift_family: shifts and rotates — count in %cl (D2/D3), $1
// (D0/D1, the form GNU as selects for a count of one), or $imm8 (C0/C1) —
// on a register or sized memory destination.
function x86_gas_shift_family(own a: X86Asm, mnem: string, ext: i32, size: i32, src: string, dst: string): X86Asm {
    var by_cl: boolean = (src == "%cl");
    if (!by_cl && (src.len() == 0 || src[0] != b'$')) { return x86_gas_bad(a, mnem + " " + src); }
    var imm: i32 = 0;
    if (!by_cl) { imm = x86_gas_atoi(src); }
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + dst); }
        var op: i32 = x86_opsel(210, size); // D2/D3 %cl
        var tail: i32 = 0;
        if (!by_cl) {
            if (imm == 1) { op = x86_opsel(208, size); } else { op = x86_opsel(192, size); tail = 1; }
        }
        a = x86_gas_mem_op(a, size, false, op, ext, m, false, tail);
        if (tail == 1) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
        return a;
    }
    var r: i32 = x86_gas_reg_w(dst, size);
    if (r < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (by_cl) { return X86Asm { ...a, code: x86_shift_r_cl(a.code, size, ext, r) }; }
    return X86Asm { ...a, code: x86_shift_r_imm(a.code, size, ext, r, imm) };
}

// x86_gas_shld_family: shld (0F A4/A5) / shrd (0F AC/AD) — the
// double-precision shifts: `$imm|%cl, %src, r/m-dst`. ModRM.reg is the
// SOURCE, the reverse of the usual direction. No 8-bit form.
function x86_gas_shld_family(own a: X86Asm, mnem: string, opimm: i32, size: i32, rest: string): X86Asm {
    var ops: string[] = x86_gas_split_ops(rest);
    if (ops.len() != 3 || size == 8) { return x86_gas_bad(a, mnem + " " + rest); }
    var rs: i32 = x86_gas_reg_w(ops[1], size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    var by_cl: boolean = (ops[0] == "%cl");
    if (!by_cl && (ops[0].len() == 0 || ops[0][0] != b'$')) { return x86_gas_bad(a, mnem + " " + rest); }
    var op: i32 = opimm;
    if (by_cl) { op = opimm + 1; }
    var imm: i32 = 0;
    var tail: i32 = 0;
    if (!by_cl) { imm = x86_gas_atoi(ops[0]); tail = 1; }
    if (x86_str_contains(ops[2], "(")) {
        var m: GasMem = x86_gas_parse_mem(ops[2]);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + ops[2]); }
        a = x86_gas_mem_op(a, size, true, op, rs, m, false, tail);
        if (!by_cl) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
        return a;
    }
    var rd: i32 = x86_gas_reg_w(ops[2], size);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    a = X86Asm { ...a, code: x86_op0f_rr(a.code, size, op, rs, rd) };
    if (!by_cl) { return X86Asm { ...a, code: a.code.append(imm & 255) }; }
    return a;
}

// x86_gas_bt_family: bt/bts/btr/btc — `%reg|$imm8, r/m` (AT&T: the bit
// index comes first). Register form 0F A3/AB/B3/BB with reg = the index;
// immediate form 0F BA /4../7 ib. No 8-bit form.
function x86_gas_bt_family(own a: X86Asm, mnem: string, idx: i32, size: i32, src: string, dst: string): X86Asm {
    if (size == 8) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (src.len() > 0 && src[0] == b'$') {
        var imm: i32 = x86_gas_atoi(src);
        if (x86_str_contains(dst, "(")) {
            var mi: GasMem = x86_gas_parse_mem(dst);
            if (!x86_gas_mem_ok(mi)) { return x86_gas_bad(a, mnem + " " + dst); }
            a = x86_gas_mem_op(a, size, true, 186, 4 + idx, mi, false, 1);
            return X86Asm { ...a, code: a.code.append(imm & 255) };
        }
        var rd: i32 = x86_gas_reg_w(dst, size);
        if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_op0f_rr(a.code, size, 186, 4 + idx, rd) };
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    var regop: i32 = 163 + idx * 8;
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + dst); }
        return x86_gas_mem_op(a, size, true, regop, rs, m, false, 0);
    }
    var rd2: i32 = x86_gas_reg_w(dst, size);
    if (rd2 < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op0f_rr(a.code, size, regop, rs, rd2) };
}

// x86_gas_rmw_family: xadd (0F C0/C1) and cmpxchg (0F B0/B1) — reg source
// in ModRM.reg, register or memory destination.
function x86_gas_rmw_family(own a: X86Asm, mnem: string, opbase: i32, size: i32, src: string, dst: string): X86Asm {
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    var op: i32 = x86_opsel(opbase, size);
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + dst); }
        return x86_gas_mem_op(a, size, true, op, rs, m, x86_rex8_force(size, rs), 0);
    }
    var rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op0f_rr(a.code, size, op, rs, rd) };
}

// x86_gas_xchg_family: xchg (86/87) — reg/reg or a memory operand on
// either side (the memory form is implicitly locked by the CPU).
function x86_gas_xchg_family(own a: X86Asm, mnem: string, size: i32, src: string, dst: string): X86Asm {
    var src_mem: boolean = x86_str_contains(src, "(");
    var dst_mem: boolean = x86_str_contains(dst, "(");
    if (src_mem != dst_mem) {
        var mop: string = src;
        var rop: string = dst;
        if (dst_mem) { mop = dst; rop = src; }
        var m: GasMem = x86_gas_parse_mem(mop);
        var rr: i32 = x86_gas_reg_w(rop, size);
        if (!x86_gas_mem_ok(m) || rr < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return x86_gas_mem_op(a, size, false, x86_opsel(134, size), rr, m, x86_rex8_force(size, rr), 0);
    }
    var r1: i32 = x86_gas_reg_w(src, size);
    var r2: i32 = x86_gas_reg_w(dst, size);
    if (r1 < 0 || r2 < 0 || src_mem) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_op_rr(a.code, size, 134, r1, r2) };
}

// x86_gas_cmov_family: cmov<cc> with the full condition table and W/L/W16
// widths. A bare condition spelling (`cmovne`) takes its width from the
// destination register; a trailing size suffix (`cmovneq`) is explicit.
function x86_gas_cmov_family(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
    var cond: string = slice_unchecked(mnem, 4, mnem.len()) + "";
    var size: i32 = 0;
    var cc: i32 = x86_gas_cc_code(cond);
    if (cc >= 0) {
        size = 64;
        if (x86_gas_reg32(dst) >= 0) { size = 32; }
        if (x86_gas_reg16(dst) >= 0) { size = 16; }
    } else {
        size = x86_gas_suffix_size(mnem);
        if (size == 0 || size == 8) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        cc = x86_gas_cc_code(slice_unchecked(cond, 0, cond.len() - 1) + "");
        if (cc < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    }
    var rd: i32 = x86_gas_reg_w(dst, size);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + src); }
        return x86_gas_mem_op(a, size, true, 64 + cc, rd, m, false, 0);
    }
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_cmovcc_rr(a.code, size, cc, rd, rs) };
}

// x86_gas_imul_family: imul at 1 operand (the widening F6/F7 /5 form), 2
// operands (0F AF /r, reg = dst, register or memory source), or 3 operands
// (`$imm, %src, %dst` — 6B /r ib or 69 /r iw/id). No 8-bit two/three-op form.
function x86_gas_imul_family(own a: X86Asm, mnem: string, size: i32, rest: string): X86Asm {
    var ops: string[] = x86_gas_split_ops(rest);
    if (ops.len() == 1) { return x86_gas_unary_family(a, mnem, 246, 5, size, ops[0]); }
    if (size == 8) { return x86_gas_bad(a, mnem + " " + rest); }
    if (ops.len() == 2) {
        var rd: i32 = x86_gas_reg_w(ops[1], size);
        if (rd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
        if (x86_str_contains(ops[0], "(")) {
            var m: GasMem = x86_gas_parse_mem(ops[0]);
            if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + ops[0]); }
            return x86_gas_mem_op(a, size, true, 175, rd, m, false, 0);
        }
        var rs: i32 = x86_gas_reg_w(ops[0], size);
        if (rs < 0) { return x86_gas_bad(a, mnem + " " + rest); }
        return X86Asm { ...a, code: x86_op0f_rr(a.code, size, 175, rd, rs) };
    }
    if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') { return x86_gas_bad(a, mnem + " " + rest); }
    var imm: i32 = x86_gas_atoi(ops[0]);
    var rs3: i32 = x86_gas_reg_w(ops[1], size);
    var rd3: i32 = x86_gas_reg_w(ops[2], size);
    if (rs3 < 0 || rd3 < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    a = X86Asm { ...a, code: x86_osz(a.code, size) };
    a = X86Asm { ...a, code: x86_rex_rr(a.code, size, rd3, rs3) };
    if (x86_imm_fits8(imm)) {
        a = X86Asm { ...a, code: a.code.append(107) }; // 6B /r ib
        a = X86Asm { ...a, code: a.code.append(x86_modrm(3, rd3, rs3)) };
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    a = X86Asm { ...a, code: a.code.append(105) };     // 69 /r iw/id
    a = X86Asm { ...a, code: a.code.append(x86_modrm(3, rd3, rs3)) };
    return X86Asm { ...a, code: x86_imm_wide(a.code, size, imm) };
}

// x86_gas_bswap: bswap r32/r64 (0F C8+rd). The 16-bit form is
// architecturally undefined and there is no byte form — both refuse.
function x86_gas_bswap(own a: X86Asm, mnem: string, size: i32, op: string): X86Asm {
    if (size != 32 && size != 64) { return x86_gas_bad(a, mnem + " " + op); }
    var r: i32 = x86_gas_reg_w(op, size);
    if (r < 0) { return x86_gas_bad(a, mnem + " " + op); }
    var rex: i32 = x86_rex(x86_rex_w_of(size), 0, 0, r);
    if (rex != 64) { a = X86Asm { ...a, code: a.code.append(rex) }; }
    a = X86Asm { ...a, code: a.code.append(15) };
    return X86Asm { ...a, code: a.code.append(200 + (r & 7)) };
}

// x86_gas_crc32_family: `crc32{b,w,l,q} src, r32/r64` — 66? F2 0F 38 F0/F1
// /r; the suffix names the SOURCE width (the 66 for a word source precedes
// the mandatory F2), REX.W follows the destination. A 64-bit destination
// pairs only with byte and qword sources; a 32-bit one with b/w/l.
function x86_gas_crc32_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
    var dsize: i32 = 32;
    var rd: i32 = x86_gas_reg32(dst);
    if (rd < 0) { rd = x86_gas_reg64(dst); dsize = 64; }
    if (rd < 0) { return x86_gas_bad(a, "crc32 " + dst); }
    if (dsize == 64 && size != 8 && size != 64) { return x86_gas_bad(a, "crc32 " + src + ", " + dst); }
    if (dsize == 32 && size == 64) { return x86_gas_bad(a, "crc32 " + src + ", " + dst); }
    var op: i32 = 241;
    if (size == 8) { op = 240; }
    if (size == 16) { a = X86Asm { ...a, code: a.code.append(102) }; }
    a = X86Asm { ...a, code: a.code.append(242) };
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, "crc32 " + src); }
        a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, dsize, rd, m, false) };
        a = X86Asm { ...a, code: a.code.append(15) };
        a = X86Asm { ...a, code: a.code.append(56) };
        a = X86Asm { ...a, code: a.code.append(op) };
        return x86_gas_membytes(a, rd, m, 0);
    }
    var rs: i32 = x86_gas_reg_w(src, size);
    if (rs < 0) { return x86_gas_bad(a, "crc32 " + src + ", " + dst); }
    var rex: i32 = x86_rex(x86_rex_w_of(dsize), rd, 0, rs);
    if (rex != 64 || x86_rex8_force(size, rs)) { a = X86Asm { ...a, code: a.code.append(rex) }; }
    a = X86Asm { ...a, code: a.code.append(15) };
    a = X86Asm { ...a, code: a.code.append(56) };
    a = X86Asm { ...a, code: a.code.append(op) };
    return X86Asm { ...a, code: a.code.append(x86_modrm(3, rd, rs)) };
}

// ---- SSE tables and emitters ----

// x86_gas_sse_fp_op: the scalar/packed FLOAT half of the two-byte-opcode
// SSE table (`[pfx] 0F op /r`, xmm destination), packed as pfx*256+op;
// -1 when absent. Mirrors internal/native/x86_64's sseOps.
function x86_gas_sse_fp_op(mnem: string): i32 {
    if (mnem == "addsd") { return 242 * 256 + 88; }
    if (mnem == "subsd") { return 242 * 256 + 92; }
    if (mnem == "mulsd") { return 242 * 256 + 89; }
    if (mnem == "divsd") { return 242 * 256 + 94; }
    if (mnem == "sqrtsd") { return 242 * 256 + 81; }
    if (mnem == "minsd") { return 242 * 256 + 93; }
    if (mnem == "maxsd") { return 242 * 256 + 95; }
    if (mnem == "addss") { return 243 * 256 + 88; }
    if (mnem == "subss") { return 243 * 256 + 92; }
    if (mnem == "mulss") { return 243 * 256 + 89; }
    if (mnem == "divss") { return 243 * 256 + 94; }
    if (mnem == "sqrtss") { return 243 * 256 + 81; }
    if (mnem == "minss") { return 243 * 256 + 93; }
    if (mnem == "maxss") { return 243 * 256 + 95; }
    if (mnem == "ucomisd") { return 102 * 256 + 46; }
    if (mnem == "comisd") { return 102 * 256 + 47; }
    if (mnem == "ucomiss") { return 46; }
    if (mnem == "comiss") { return 47; }
    if (mnem == "cvtss2sd") { return 243 * 256 + 90; }
    if (mnem == "cvtsd2ss") { return 242 * 256 + 90; }
    if (mnem == "movapd") { return 102 * 256 + 40; }
    if (mnem == "movaps") { return 40; }
    if (mnem == "xorpd") { return 102 * 256 + 87; }
    if (mnem == "xorps") { return 87; }
    if (mnem == "andpd") { return 102 * 256 + 84; }
    if (mnem == "andps") { return 84; }
    if (mnem == "andnpd") { return 102 * 256 + 85; }
    if (mnem == "andnps") { return 85; }
    if (mnem == "orpd") { return 102 * 256 + 86; }
    if (mnem == "orps") { return 86; }
    if (mnem == "addpd") { return 102 * 256 + 88; }
    if (mnem == "subpd") { return 102 * 256 + 92; }
    if (mnem == "mulpd") { return 102 * 256 + 89; }
    if (mnem == "divpd") { return 102 * 256 + 94; }
    if (mnem == "sqrtpd") { return 102 * 256 + 81; }
    if (mnem == "minpd") { return 102 * 256 + 93; }
    if (mnem == "maxpd") { return 102 * 256 + 95; }
    if (mnem == "addps") { return 88; }
    if (mnem == "subps") { return 92; }
    if (mnem == "mulps") { return 89; }
    if (mnem == "divps") { return 94; }
    if (mnem == "sqrtps") { return 81; }
    if (mnem == "minps") { return 93; }
    if (mnem == "maxps") { return 95; }
    if (mnem == "unpcklpd") { return 102 * 256 + 20; }
    if (mnem == "unpckhpd") { return 102 * 256 + 21; }
    if (mnem == "cvtdq2ps") { return 91; }
    if (mnem == "cvtps2dq") { return 102 * 256 + 91; }
    if (mnem == "cvttps2dq") { return 243 * 256 + 91; }
    if (mnem == "cvtdq2pd") { return 243 * 256 + 230; }
    if (mnem == "cvtpd2dq") { return 242 * 256 + 230; }
    if (mnem == "cvttpd2dq") { return 102 * 256 + 230; }
    return 0 - 1;
}

// x86_gas_sse_int_op: the packed-INTEGER half of the SSE table (all
// 66-prefixed). The psll/psrl/psra entries here are the by-%xmm-count
// forms; the by-immediate forms are the 0F 71/72/73 groups
// (x86_gas_vshift_op).
function x86_gas_sse_int_op(mnem: string): i32 {
    if (mnem == "pcmpeqb") { return 102 * 256 + 116; }
    if (mnem == "pcmpeqw") { return 102 * 256 + 117; }
    if (mnem == "pcmpeqd") { return 102 * 256 + 118; }
    if (mnem == "pcmpgtb") { return 102 * 256 + 100; }
    if (mnem == "pcmpgtw") { return 102 * 256 + 101; }
    if (mnem == "pcmpgtd") { return 102 * 256 + 102; }
    if (mnem == "punpcklbw") { return 102 * 256 + 96; }
    if (mnem == "punpcklwd") { return 102 * 256 + 97; }
    if (mnem == "punpckldq") { return 102 * 256 + 98; }
    if (mnem == "punpcklqdq") { return 102 * 256 + 108; }
    if (mnem == "punpckhbw") { return 102 * 256 + 104; }
    if (mnem == "punpckhwd") { return 102 * 256 + 105; }
    if (mnem == "punpckhdq") { return 102 * 256 + 106; }
    if (mnem == "punpckhqdq") { return 102 * 256 + 109; }
    if (mnem == "por") { return 102 * 256 + 235; }
    if (mnem == "pand") { return 102 * 256 + 219; }
    if (mnem == "pxor") { return 102 * 256 + 239; }
    if (mnem == "pandn") { return 102 * 256 + 223; }
    if (mnem == "paddb") { return 102 * 256 + 252; }
    if (mnem == "paddw") { return 102 * 256 + 253; }
    if (mnem == "paddd") { return 102 * 256 + 254; }
    if (mnem == "paddq") { return 102 * 256 + 212; }
    if (mnem == "psubb") { return 102 * 256 + 248; }
    if (mnem == "psubw") { return 102 * 256 + 249; }
    if (mnem == "psubd") { return 102 * 256 + 250; }
    if (mnem == "psubq") { return 102 * 256 + 251; }
    if (mnem == "paddusb") { return 102 * 256 + 220; }
    if (mnem == "psubusb") { return 102 * 256 + 216; }
    if (mnem == "paddsb") { return 102 * 256 + 236; }
    if (mnem == "psubsb") { return 102 * 256 + 232; }
    if (mnem == "pavgb") { return 102 * 256 + 224; }
    if (mnem == "pminub") { return 102 * 256 + 218; }
    if (mnem == "pmaxub") { return 102 * 256 + 222; }
    if (mnem == "pminsw") { return 102 * 256 + 234; }
    if (mnem == "pmaxsw") { return 102 * 256 + 238; }
    if (mnem == "pmullw") { return 102 * 256 + 213; }
    if (mnem == "pmulhw") { return 102 * 256 + 229; }
    if (mnem == "pmulhuw") { return 102 * 256 + 228; }
    if (mnem == "pmuludq") { return 102 * 256 + 244; }
    if (mnem == "psadbw") { return 102 * 256 + 246; }
    if (mnem == "packsswb") { return 102 * 256 + 99; }
    if (mnem == "packuswb") { return 102 * 256 + 103; }
    if (mnem == "packssdw") { return 102 * 256 + 107; }
    if (mnem == "psllw") { return 102 * 256 + 241; }
    if (mnem == "pslld") { return 102 * 256 + 242; }
    if (mnem == "psllq") { return 102 * 256 + 243; }
    if (mnem == "psrlw") { return 102 * 256 + 209; }
    if (mnem == "psrld") { return 102 * 256 + 210; }
    if (mnem == "psrlq") { return 102 * 256 + 211; }
    if (mnem == "psraw") { return 102 * 256 + 225; }
    if (mnem == "psrad") { return 102 * 256 + 226; }
    return 0 - 1;
}

// x86_gas_sse_op consults both halves of the SSE table.
function x86_gas_sse_op(mnem: string): i32 {
    var v: i32 = x86_gas_sse_fp_op(mnem);
    if (v >= 0) { return v; }
    return x86_gas_sse_int_op(mnem);
}

// x86_gas_sse38_op: the 66 0F 38 <op> /r forms (SSE4.1 packed min/max,
// pmulld, ptest — inside the Haswell baseline); -1 when absent.
function x86_gas_sse38_op(mnem: string): i32 {
    if (mnem == "ptest") { return 23; }
    if (mnem == "pmulld") { return 64; }
    if (mnem == "pminsb") { return 56; }
    if (mnem == "pminsd") { return 57; }
    if (mnem == "pminuw") { return 58; }
    if (mnem == "pminud") { return 59; }
    if (mnem == "pmaxsb") { return 60; }
    if (mnem == "pmaxsd") { return 61; }
    if (mnem == "pmaxuw") { return 62; }
    if (mnem == "pmaxud") { return 63; }
    return 0 - 1;
}

// x86_gas_vshift_op: the shift-by-immediate 0F 71/72/73 groups, packed as
// ext*256+op. pslldq/psrldq exist ONLY here — a register count on those
// has no encoding and lands on `unknown`.
function x86_gas_vshift_op(mnem: string): i32 {
    if (mnem == "psrlw") { return 2 * 256 + 113; }
    if (mnem == "psraw") { return 4 * 256 + 113; }
    if (mnem == "psllw") { return 6 * 256 + 113; }
    if (mnem == "psrld") { return 2 * 256 + 114; }
    if (mnem == "psrad") { return 4 * 256 + 114; }
    if (mnem == "pslld") { return 6 * 256 + 114; }
    if (mnem == "psrlq") { return 2 * 256 + 115; }
    if (mnem == "psllq") { return 6 * 256 + 115; }
    if (mnem == "psrldq") { return 3 * 256 + 115; }
    if (mnem == "pslldq") { return 7 * 256 + 115; }
    return 0 - 1;
}

// x86_gas_imm3a_op: the 66 0F 3A <op> /r ib three-operand forms.
function x86_gas_imm3a_op(mnem: string): i32 {
    if (mnem == "roundss") { return 10; }
    if (mnem == "roundsd") { return 11; }
    if (mnem == "pcmpestri") { return 97; }
    if (mnem == "pcmpistri") { return 99; }
    return 0 - 1;
}

// x86_gas_shuf_op: the [pfx] 0F <op> /r ib shuffles, packed pfx*256+op.
function x86_gas_shuf_op(mnem: string): i32 {
    if (mnem == "pshufd") { return 102 * 256 + 112; }
    if (mnem == "shufps") { return 198; }
    if (mnem == "shufpd") { return 102 * 256 + 198; }
    return 0 - 1;
}

// x86_gas_sse_mem: `[pfx] [REX] 0F <op>` + memory rm (rip included) — the
// memory side of the SSE table ops and the movdq/mov10 directions.
function x86_gas_sse_mem(own a: X86Asm, pfx: i32, op: i32, reg: i32, m: GasMem, tail: i32): X86Asm {
    if (pfx != 0) { a = X86Asm { ...a, code: a.code.append(pfx) }; }
    a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, 32, reg, m, false) };
    a = X86Asm { ...a, code: a.code.append(15) };
    a = X86Asm { ...a, code: a.code.append(op) };
    return x86_gas_membytes(a, reg, m, tail);
}

// x86_gas_sse_table: a two-byte-opcode SSE table op, `src, %xmm` with an
// xmm or memory (rip included) source.
function x86_gas_sse_table(own a: X86Asm, mnem: string, pfx: i32, op: i32, src: string, dst: string): X86Asm {
    var xd: i32 = x86_gas_xmm(dst);
    if (xd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + src); }
        return x86_gas_sse_mem(a, pfx, op, xd, m, 0);
    }
    var xs: i32 = x86_gas_xmm(src);
    if (xs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_sse_any_rr(a.code, pfx, op, xd, xs) };
}

// x86_gas_movdq: movdqu (F3) / movdqa (66) with the direction picked by
// which side is memory: 0F 6F loads/copies, 0F 7F stores. The store was
// missing before this port — the operands written backwards through 6F
// would have READ from the store address instead.
function x86_gas_movdq(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
    var pfx: i32 = 243;
    if (mnem == "movdqa") { pfx = 102; }
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        var xs: i32 = x86_gas_xmm(src);
        if (!x86_gas_mem_ok(m) || xs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return x86_gas_sse_mem(a, pfx, 127, xs, m, 0);
    }
    return x86_gas_sse_table(a, mnem, pfx, 111, src, dst);
}

// x86_gas_sse_mov10: the 0F 10/0F 11 move family — movsd (F2), movups (no
// prefix), movupd (66): load into an xmm (10), store from one (11), or a
// register copy (10). The rip-relative load is how a `.double` constant
// arrives from .rodata.
function x86_gas_sse_mov10(own a: X86Asm, mnem: string, pfx: i32, src: string, dst: string): X86Asm {
    if (x86_str_contains(dst, "(")) {
        var m: GasMem = x86_gas_parse_mem(dst);
        var xs: i32 = x86_gas_xmm(src);
        if (!x86_gas_mem_ok(m) || xs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        return x86_gas_sse_mem(a, pfx, 17, xs, m, 0);
    }
    return x86_gas_sse_table(a, mnem, pfx, 16, src, dst);
}

// x86_gas_movmsk: pmovmskb (66 0F D7), movmskps (0F 50), movmskpd
// (66 0F 50) — sign-bit gathers into a 32- or 64-bit GPR destination.
function x86_gas_movmsk(own a: X86Asm, mnem: string, pfx: i32, op: i32, src: string, dst: string): X86Asm {
    var rd: i32 = x86_gas_reg32(dst);
    if (rd < 0) { rd = x86_gas_reg64(dst); }
    var xs: i32 = x86_gas_xmm(src);
    if (rd < 0 || xs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_sse_any_rr(a.code, pfx, op, rd, xs) };
}

// x86_gas_vshift_imm: `psll/psrl/psra $imm8, %xmm` — 66 [REX.B] 0F 71/72/73
// /ext ib, the shifted register in ModRM.rm.
function x86_gas_vshift_imm(own a: X86Asm, mnem: string, packed: i32, src: string, dst: string): X86Asm {
    var xr: i32 = x86_gas_xmm(dst);
    if (xr < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    a = X86Asm { ...a, code: a.code.append(102) };
    var rex: i32 = x86_rex(0, 0, 0, xr);
    if (rex != 64) { a = X86Asm { ...a, code: a.code.append(rex) }; }
    a = X86Asm { ...a, code: a.code.append(15) };
    a = X86Asm { ...a, code: a.code.append(packed & 255) };
    a = X86Asm { ...a, code: a.code.append(x86_modrm(3, packed / 256, xr)) };
    return X86Asm { ...a, code: a.code.append(x86_gas_atoi(src) & 255) };
}

// x86_gas_sse38: `66 [REX] 0F 38 <op> /r` (xmm, xmm).
function x86_gas_sse38(own a: X86Asm, mnem: string, op: i32, src: string, dst: string): X86Asm {
    var xd: i32 = x86_gas_xmm(dst);
    var xs: i32 = x86_gas_xmm(src);
    if (xd < 0 || xs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    a = X86Asm { ...a, code: a.code.append(102) };
    var rex: i32 = x86_rex(0, xd, 0, xs);
    if (rex != 64) { a = X86Asm { ...a, code: a.code.append(rex) }; }
    a = X86Asm { ...a, code: a.code.append(15) };
    a = X86Asm { ...a, code: a.code.append(56) };
    a = X86Asm { ...a, code: a.code.append(op) };
    return X86Asm { ...a, code: a.code.append(x86_modrm(3, xd, xs)) };
}

// x86_gas_sse_imm3: the `$imm8, %src, %dst` three-operand forms — the
// 66 0F 3A group (roundsd/roundss/pcmpistri/pcmpestri) and the shuffles
// (pshufd/shufps/shufpd). The caller guarantees one lookup hits.
function x86_gas_sse_imm3(own a: X86Asm, mnem: string, rest: string): X86Asm {
    var ops: string[] = x86_gas_split_ops(rest);
    if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') { return x86_gas_bad(a, mnem + " " + rest); }
    var imm: i32 = x86_gas_atoi(ops[0]);
    var xs: i32 = x86_gas_xmm(ops[1]);
    var xd: i32 = x86_gas_xmm(ops[2]);
    if (xs < 0 || xd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    var op3a: i32 = x86_gas_imm3a_op(mnem);
    if (op3a >= 0) {
        return X86Asm { ...a, code: x86_sse_3a_imm(a.code, 0, op3a, xd, xs, imm) };
    }
    var sh: i32 = x86_gas_shuf_op(mnem);
    a = X86Asm { ...a, code: x86_sse_any_rr(a.code, sh / 256, sh & 255, xd, xs) };
    return X86Asm { ...a, code: a.code.append(imm & 255) };
}

// x86_gas_pextr: `pextr{b,w,d,q} $imm, %xmm, r/m` — extract one lane.
// pextrw with a register destination is the legacy 66 0F C5 /r ib (reg =
// the GPR); the others are 66 0F 3A 14/16 /r ib with ModRM.rm = the
// DESTINATION and reg = the xmm source (REX.W selects the q width). A
// memory destination always takes the 3A form (pextrw's is 3A 15).
function x86_gas_pextr(own a: X86Asm, mnem: string, rest: string): X86Asm {
    var ops: string[] = x86_gas_split_ops(rest);
    if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') { return x86_gas_bad(a, mnem + " " + rest); }
    var imm: i32 = x86_gas_atoi(ops[0]);
    var xs: i32 = x86_gas_xmm(ops[1]);
    if (xs < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    var op: i32 = 20; // pextrb 3A 14
    var w: i32 = 0;
    var dsize: i32 = 32;
    if (mnem == "pextrw") { op = 21; }
    if (mnem == "pextrd") { op = 22; }
    if (mnem == "pextrq") { op = 22; w = 1; dsize = 64; }
    if (x86_str_contains(ops[2], "(")) {
        var m: GasMem = x86_gas_parse_mem(ops[2]);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + ops[2]); }
        a = X86Asm { ...a, code: a.code.append(102) };
        var msz: i32 = 32;
        if (w == 1) { msz = 64; }
        a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, msz, xs, m, false) };
        a = X86Asm { ...a, code: a.code.append(15) };
        a = X86Asm { ...a, code: a.code.append(58) };
        a = X86Asm { ...a, code: a.code.append(op) };
        a = x86_gas_membytes(a, xs, m, 1);
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    var rd: i32 = x86_gas_reg_w(ops[2], dsize);
    if (rd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    if (mnem == "pextrw") {
        a = X86Asm { ...a, code: x86_sse_any_rr(a.code, 102, 197, rd, xs) };
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    return X86Asm { ...a, code: x86_sse_3a_imm(a.code, w, op, xs, rd, imm) };
}

// x86_gas_pinsr: `pinsr{b,w,d,q} $imm, r/m, %xmm` — insert into one lane.
// pinsrw is the legacy 66 0F C4 /r ib; the others 66 0F 3A 20/22 /r ib
// (REX.W selects q). ModRM.reg is the xmm destination throughout.
function x86_gas_pinsr(own a: X86Asm, mnem: string, rest: string): X86Asm {
    var ops: string[] = x86_gas_split_ops(rest);
    if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') { return x86_gas_bad(a, mnem + " " + rest); }
    var imm: i32 = x86_gas_atoi(ops[0]);
    var xd: i32 = x86_gas_xmm(ops[2]);
    if (xd < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    var w: i32 = 0;
    var ssize: i32 = 32;
    var op: i32 = 32; // pinsrb 3A 20
    if (mnem == "pinsrd") { op = 34; }
    if (mnem == "pinsrq") { op = 34; w = 1; ssize = 64; }
    var legacy: boolean = (mnem == "pinsrw");
    if (x86_str_contains(ops[1], "(")) {
        var m: GasMem = x86_gas_parse_mem(ops[1]);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + ops[1]); }
        a = X86Asm { ...a, code: a.code.append(102) };
        var msz: i32 = 32;
        if (w == 1) { msz = 64; }
        a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, msz, xd, m, false) };
        a = X86Asm { ...a, code: a.code.append(15) };
        if (legacy) {
            a = X86Asm { ...a, code: a.code.append(196) };
        } else {
            a = X86Asm { ...a, code: a.code.append(58) };
            a = X86Asm { ...a, code: a.code.append(op) };
        }
        a = x86_gas_membytes(a, xd, m, 1);
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    var rs: i32 = x86_gas_reg_w(ops[1], ssize);
    if (rs < 0) { return x86_gas_bad(a, mnem + " " + rest); }
    if (legacy) {
        a = X86Asm { ...a, code: x86_sse_any_rr(a.code, 102, 196, xd, rs) };
        return X86Asm { ...a, code: a.code.append(imm & 255) };
    }
    return X86Asm { ...a, code: x86_sse_3a_imm(a.code, w, op, xd, rs, imm) };
}

// x86_gas_emit assembles one instruction line (mnemonic + operand text).
function x86_gas_emit(own a: X86Asm, mnem: string, rest: string): X86Asm {
    // no-operand mnemonics (incl. the AT&T string ops) — fixed byte lists.
    if (rest.len() == 0) {
        var fx: i32 = x86_gas_fixed_op(mnem);
        if (fx < 0) { fx = x86_gas_string_op(mnem); }
        if (fx >= 0) { return x86_gas_emit_packed(a, fx); }
    }
    // rep prefix: F3 + a string op. A dropped string-op leaves memory
    // uninitialised, surfacing far from here — record, not ignore (SH-005).
    if (mnem == "rep") {
        var sop: i32 = x86_gas_string_op(rest);
        if (sop < 0) { return x86_gas_bad(a, "rep " + rest); }
        a = X86Asm { ...a, code: a.code.append(243) };
        return x86_gas_emit_packed(a, sop);
    }
    // lock prefix: F0, validated against the lockable set — a lock on
    // anything else is #UD at runtime, so it is refused at assembly.
    if (mnem == "lock") {
        var lsp: i32 = x86_str_indexof(rest, " ");
        var lm: string = rest;
        var lr: string = "";
        if (lsp >= 0) {
            lm = slice_unchecked(rest, 0, lsp) + "";
            lr = x86_gas_trim(slice_unchecked(rest, lsp + 1, rest.len()));
        }
        var lb: string = lm;
        if (x86_gas_suffix_size(lm) > 0) { lb = x86_gas_strip_suffix(lm); }
        if (!x86_gas_lockable(lb)) { return x86_gas_bad(a, "lock " + rest); }
        a = X86Asm { ...a, code: a.code.append(240) };
        return x86_gas_emit(a, lm, lr);
    }
    // setCC <reg8>: store a condition flag as 0/1.
    if (mnem == "sete" || mnem == "setz") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 148, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setne" || mnem == "setnz") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 149, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setl") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 156, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setle") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 158, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setg") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 159, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setge") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 157, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setb") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 146, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setbe") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 150, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "seta") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 151, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setae") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 147, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "sets") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 152, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setp") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 154, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setnp") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 155, x86_gas_reg8(rest)) }; return a; }
    if (mnem == "setns") { a = X86Asm { ...a, code: x86_setcc_reg8(a.code, 153, x86_gas_reg8(rest)) }; return a; }
    // branch / call: one operand = a label
    // A `*` operand means INDIRECT — through a register or stack slot — not
    // a branch to a label of that name.
    if (mnem == "call" || mnem == "jmp") {
        if (rest.len() > 0 && rest[0] == b'*') {
            var ind: string = x86_gas_trim(slice_unchecked(rest, 1, rest.len()));
            var ext: i32 = 2; // call FF /2
            if (mnem == "jmp") { ext = 4; } // jmp FF /4
            if (x86_str_contains(ind, "(")) {
                // `*disp(%base[,%index,scale])` and `*sym(%rip)` — FF /2 //4
                // over a memory operand (a callee pointer in a stack slot or
                // a rip-addressed table). The operand size is fixed 64-bit.
                var cm: GasMem = x86_gas_parse_mem(ind);
                if (!x86_gas_mem_ok(cm)) { return x86_gas_bad(a, mnem + " " + rest); }
                a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, 32, 0, cm, false) };
                a = X86Asm { ...a, code: a.code.append(255) }; // 0xFF
                return x86_gas_membytes(a, ext, cm, 0);
            }
            var ireg: i32 = x86_gas_reg(ind);
            if (ireg < 0) { return x86_gas_bad(a, mnem + " " + rest); }
            if (mnem == "jmp") { a = X86Asm { ...a, code: x86_jmp_reg(a.code, ireg) }; }
            else { a = X86Asm { ...a, code: x86_call_reg(a.code, ireg) }; }
            return a;
        }
        if (mnem == "jmp") { return x86_jmp_label(a, rest); }
        return x86_call_label(a, rest);
    }
    if (mnem == "je" || mnem == "jz") { return x86_jcc_label(a, x86_cc_e(), rest); }
    if (mnem == "jne" || mnem == "jnz") { return x86_jcc_label(a, x86_cc_ne(), rest); }
    if (mnem == "jge") { return x86_jcc_label(a, x86_cc_ge(), rest); }
    if (mnem == "jl") { return x86_jcc_label(a, x86_cc_l(), rest); }
    if (mnem == "jle") { return x86_jcc_label(a, x86_cc_le(), rest); }
    if (mnem == "jg") { return x86_jcc_label(a, x86_cc_g(), rest); }
    if (mnem == "jb" || mnem == "jc") { return x86_jcc_label(a, x86_cc_b(), rest); }
    if (mnem == "jae" || mnem == "jnc") { return x86_jcc_label(a, x86_cc_ae(), rest); }
    if (mnem == "jbe") { return x86_jcc_label(a, x86_cc_be(), rest); }
    if (mnem == "ja") { return x86_jcc_label(a, x86_cc_a(), rest); }
    if (mnem == "js") { return x86_jcc_label(a, x86_cc_s(), rest); }
    if (mnem == "jns") { return x86_jcc_label(a, x86_cc_ns(), rest); }
    if (mnem == "jp") { return x86_jcc_label(a, x86_cc_p(), rest); }
    // one-operand: push/pop take a register or a memory operand
    if (mnem == "pushq") {
        if (rest.len() > 0 && rest[0] == b'$') { // $imm — 6A ib when it fits
            var pv: i32 = x86_gas_atoi(rest);
            if (x86_imm_fits8(pv)) {
                a = X86Asm { ...a, code: a.code.append(106) };
                a = X86Asm { ...a, code: a.code.append(pv & 255) };
                return a;
            }
            a = X86Asm { ...a, code: x86_push_imm32(a.code, pv) };
        } else {
            if (x86_str_contains(rest, "(")) {
                var pm: GasMem = x86_gas_parse_mem(rest);
                if (pm.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + rest) }; }
                if (pm.is_rip) { return X86Asm { ...a, unknown: a.unknown.append("rip-relative operand not encoded here: " + rest) }; }
                a = X86Asm { ...a, code: x86_push_mem(a.code, pm.base, pm.has_index, pm.index, pm.scale, pm.disp) };
            } else {
                a = X86Asm { ...a, code: x86_push_r64(a.code, x86_gas_reg(rest)) };
            }
        }
        return a;
    }
    if (mnem == "popq") {
        if (x86_str_contains(rest, "(")) {
            var qm: GasMem = x86_gas_parse_mem(rest);
            if (qm.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + rest) }; }
            if (qm.is_rip) { return X86Asm { ...a, unknown: a.unknown.append("rip-relative operand not encoded here: " + rest) }; }
            a = X86Asm { ...a, code: x86_pop_mem(a.code, qm.base, qm.has_index, qm.index, qm.scale, qm.disp) };
        } else {
            a = X86Asm { ...a, code: x86_pop_r64(a.code, x86_gas_reg(rest)) };
        }
        return a;
    }
    // Suffixed families that split their own operands (any arity), plus
    // the one-operand groups. Each lookup falls through when it misses, so
    // an unmatched mnemonic still reaches the two-operand dispatch below.
    var sfx: i32 = x86_gas_suffix_size(mnem);
    if (sfx > 0) {
        var bse: string = x86_gas_strip_suffix(mnem);
        if (bse == "imul") { return x86_gas_imul_family(a, mnem, sfx, rest); }
        var ue: i32 = x86_gas_unary_ext(bse);
        if (ue >= 0) { return x86_gas_unary_family(a, mnem, 246, ue, sfx, rest); }
        var ide: i32 = x86_gas_incdec_ext(bse);
        if (ide >= 0) { return x86_gas_unary_family(a, mnem, 254, ide, sfx, rest); }
        if (bse == "bswap") { return x86_gas_bswap(a, mnem, sfx, rest); }
        if (bse == "shld") { return x86_gas_shld_family(a, mnem, 164, sfx, rest); }
        if (bse == "shrd") { return x86_gas_shld_family(a, mnem, 172, sfx, rest); }
    }
    // three-operand SSE ($imm first): rounds/pcmp*stri + the shuffles, and
    // the lane extract/insert group.
    if (x86_gas_imm3a_op(mnem) >= 0 || x86_gas_shuf_op(mnem) >= 0) { return x86_gas_sse_imm3(a, mnem, rest); }
    if (mnem == "pextrb" || mnem == "pextrw" || mnem == "pextrd" || mnem == "pextrq") { return x86_gas_pextr(a, mnem, rest); }
    if (mnem == "pinsrb" || mnem == "pinsrw" || mnem == "pinsrd" || mnem == "pinsrq") { return x86_gas_pinsr(a, mnem, rest); }
    // two-operand (split on the top-level comma, skipping (%b,%i,s) commas)
    var ci: i32 = x86_gas_top_comma(rest);
    if (ci < 0) {
        // Unknown / unsupported single-operand mnemonic: RECORD it (SH-005).
        // Dropping the instruction silently produced a corrupt executable
        // with no diagnostic; drivers check `a.unknown` after assembly.
        return X86Asm { ...a, unknown: a.unknown.append(mnem) };
    }
    var src: string = x86_gas_trim(slice_unchecked(rest, 0, ci));
    var dst: string = x86_gas_trim(slice_unchecked(rest, ci + 1, rest.len()));
    if (mnem == "leaq") {
        var m: GasMem = x86_gas_parse_mem(src);
        if (m.is_rip) { // `leaq sym(%rip), %reg`
            return x86_lea_rip_label(a, x86_gas_reg(dst), m.label);
        }
        // `leaq disp(%base)` / `disp(%base,%index,scale)` — a plain address
        // computation (lea 0x8D, same reg-mem encoding as the ALU loads). asm.fern
        // emits this for stack-local addresses, e.g. `leaq -32(%rbp), %rdi` (the
        // buffer __fern_str_eq zeroes with rep stosq). This handler previously
        // assumed EVERY leaq source was a rip-relative label, so a base+disp lea
        // got a bogus rip fixup (an empty label → address 0) and loaded a garbage
        // pointer — which crashed the string-keyed-map compare (mapstr).
        if (m.no_base) { // `leaq disp(,%index,scale), %reg` — index/scale only
            a = X86Asm { ...a, code: x86_lea_idx_nobase(a.code, x86_gas_reg(dst), m.index, m.scale, m.disp) };
            return a;
        }
        a = X86Asm { ...a, code: x86_alu_load_r64(a.code, 141, x86_gas_reg(dst), m.base, m.has_index, m.index, m.scale, m.disp) };
        return a;
    }
    if (mnem == "movq") { return x86_gas_movq(a, src, dst); }
    if (mnem == "movabsq" || mnem == "movabs") { a = X86Asm { ...a, code: x86_movabsq(a.code, x86_gas_reg(dst), x86_gas_atoi64(src)) }; return a; }
    // Packed 16-byte moves (both directions) and the 0F 10/11 move family.
    if (mnem == "movdqu" || mnem == "movdqa") { return x86_gas_movdq(a, mnem, src, dst); }
    if (mnem == "movsd") { return x86_gas_sse_mov10(a, mnem, 242, src, dst); }
    if (mnem == "movups") { return x86_gas_sse_mov10(a, mnem, 0, src, dst); }
    if (mnem == "movupd") { return x86_gas_sse_mov10(a, mnem, 102, src, dst); }
    // Sign-bit gathers: the destination is a GPR, not an xmm.
    if (mnem == "pmovmskb") { return x86_gas_movmsk(a, mnem, 102, 215, src, dst); }
    if (mnem == "movmskps") { return x86_gas_movmsk(a, mnem, 0, 80, src, dst); }
    if (mnem == "movmskpd") { return x86_gas_movmsk(a, mnem, 102, 80, src, dst); }
    if (mnem == "bsfl") { a = X86Asm { ...a, code: x86_bsf_r32(a.code, x86_gas_reg32(dst), x86_gas_reg32(src)) }; return a; }
    if (mnem == "bsrl") { a = X86Asm { ...a, code: x86_bsr_r32(a.code, x86_gas_reg32(dst), x86_gas_reg32(src)) }; return a; }
    // The `l` forms are not routed to the `q` ones the way testl is: the
    // count differs by width (lzcntl counts from bit 31, lzcntq from 63).
    if (mnem == "lzcntl") { a = X86Asm { ...a, code: x86_lzcnt_rr(a.code, 0, x86_gas_reg32(dst), x86_gas_reg32(src)) }; return a; }
    if (mnem == "lzcntq") { a = X86Asm { ...a, code: x86_lzcnt_rr(a.code, 1, x86_gas_reg(dst), x86_gas_reg(src)) }; return a; }
    if (mnem == "tzcntl") { a = X86Asm { ...a, code: x86_tzcnt_rr(a.code, 0, x86_gas_reg32(dst), x86_gas_reg32(src)) }; return a; }
    if (mnem == "tzcntq") { a = X86Asm { ...a, code: x86_tzcnt_rr(a.code, 1, x86_gas_reg(dst), x86_gas_reg(src)) }; return a; }
    if (mnem == "popcntl") { a = X86Asm { ...a, code: x86_popcnt_rr(a.code, 0, x86_gas_reg32(dst), x86_gas_reg32(src)) }; return a; }
    if (mnem == "popcntq") { a = X86Asm { ...a, code: x86_popcnt_rr(a.code, 1, x86_gas_reg(dst), x86_gas_reg(src)) }; return a; }
    // movd moves f32 bits between a GPR and an xmm; which direction depends on
    // which operand is the xmm.
    if (mnem == "movd") {
        if (x86_gas_is_xmm(dst)) {
            a = X86Asm { ...a, code: x86_movd_gpr_to_xmm(a.code, x86_gas_xmm(dst), x86_gas_reg32(src)) };
        } else {
            a = X86Asm { ...a, code: x86_movd_xmm_to_gpr(a.code, x86_gas_xmm(src), x86_gas_reg32(dst)) };
        }
        return a;
    }
    if (mnem == "movb") { return x86_gas_movb(a, src, dst); }
    if (mnem == "movzbq") { return x86_gas_movzbq(a, src, dst); }
    // movzbl (byte -> 32-bit dest, zero-extended) — asm.fern emits it for the
    // char/byte load `s[i]`. The zero-extended value is identical to movzbq's
    // (the upper 32 bits are cleared either way), so route to the same encoder;
    // without this the mnemonic was unhandled and no load was emitted.
    if (mnem == "movzbl") { return x86_gas_movzbq(a, src, dst); }
    // cvttsd2si's destination is a GPR of either width; the 32-bit spelling
    // (`%eax`) is the one the emitter writes almost always.
    if (mnem == "cvttsd2si") {
        var d32: i32 = x86_gas_reg32(dst);
        if (d32 >= 0) { // `%eax` — 32-bit destination, no REX.W
            a = X86Asm { ...a, code: x86_cvttsd2si_w(a.code, 0, d32, x86_gas_xmm(src)) };
            return a;
        }
        var d64: i32 = x86_gas_reg(dst);
        if (d64 < 0) { return X86Asm { ...a, unknown: a.unknown.append("cvttsd2si " + dst) }; }
        a = X86Asm { ...a, code: x86_cvttsd2si_w(a.code, 1, d64, x86_gas_xmm(src)) };
        return a;
    }
    // cvtsi2sd's unsuffixed spelling is the 64-bit form the emitter writes;
    // the `l` suffix selects the 32-bit source (no REX.W). A memory source
    // used to fall into the register parser and encode reg 7 silently.
    if (mnem == "cvtsi2sd" || mnem == "cvtsi2sdq" || mnem == "cvtsi2sdl") {
        var cw: i32 = 1;
        if (mnem == "cvtsi2sdl") { cw = 0; }
        var cxd: i32 = x86_gas_xmm(dst);
        if (cxd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        if (x86_str_contains(src, "(")) {
            var cm2: GasMem = x86_gas_parse_mem(src);
            if (!x86_gas_mem_ok(cm2)) { return x86_gas_bad(a, mnem + " " + src); }
            var csz: i32 = 32;
            if (cw == 1) { csz = 64; }
            a = X86Asm { ...a, code: a.code.append(242) };
            a = X86Asm { ...a, code: x86_gas_mem_rex(a.code, csz, cxd, cm2, false) };
            a = X86Asm { ...a, code: a.code.append(15) };
            a = X86Asm { ...a, code: a.code.append(42) };
            return x86_gas_membytes(a, cxd, cm2, 0);
        }
        var crs: i32 = x86_gas_reg64(src);
        if (cw == 0) { crs = x86_gas_reg32(src); }
        if (crs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
        a = X86Asm { ...a, code: x86_cvtsi2sd(a.code, cw, cxd, crs) };
        return a;
    }
    if (mnem == "movl") { return x86_gas_movl(a, src, dst); }
    // Two-operand suffix families: the ALU rows, test, shifts/rotates, the
    // bit-test group, the RMW atomics, xchg, and crc32.
    if (sfx > 0) {
        var bse2: string = x86_gas_strip_suffix(mnem);
        var ae: i32 = x86_gas_alu_ext(bse2);
        if (ae >= 0) { return x86_gas_alu_family(a, mnem, ae, sfx, src, dst); }
        if (bse2 == "test") { return x86_gas_test_family(a, sfx, src, dst); }
        var she: i32 = x86_gas_shift_ext(bse2);
        if (she >= 0) { return x86_gas_shift_family(a, mnem, she, sfx, src, dst); }
        var bti: i32 = x86_gas_bt_idx(bse2);
        if (bti >= 0) { return x86_gas_bt_family(a, mnem, bti, sfx, src, dst); }
        if (bse2 == "xadd") { return x86_gas_rmw_family(a, mnem, 192, sfx, src, dst); }
        if (bse2 == "cmpxchg") { return x86_gas_rmw_family(a, mnem, 176, sfx, src, dst); }
        if (bse2 == "xchg") { return x86_gas_xchg_family(a, mnem, sfx, src, dst); }
        if (bse2 == "crc32") { return x86_gas_crc32_family(a, sfx, src, dst); }
    }
    // cmovcc: the full condition table, width from suffix or register.
    if (x86_str_starts_with(mnem, "cmov")) { return x86_gas_cmov_family(a, mnem, src, dst); }
    // SSE vector shift by immediate, then the two-byte-opcode SSE tables
    // and the 66 0F 38 group.
    var vsp: i32 = x86_gas_vshift_op(mnem);
    if (vsp >= 0 && src.len() > 0 && src[0] == b'$') { return x86_gas_vshift_imm(a, mnem, vsp, src, dst); }
    var sse: i32 = x86_gas_sse_op(mnem);
    if (sse >= 0) { return x86_gas_sse_table(a, mnem, sse / 256, sse & 255, src, dst); }
    var s38: i32 = x86_gas_sse38_op(mnem);
    if (s38 >= 0) { return x86_gas_sse38(a, mnem, s38, src, dst); }
    // movsxd is the AT&T spelling GNU as also accepts for movslq — same
    // sign-extending 32-to-64 load (REX.W 63 /r), so it shares the handler.
    if (mnem == "movslq" || mnem == "movsxd") {
        if (x86_str_contains(src, "(")) {
            var sm: GasMem = x86_gas_parse_mem(src);
            if (sm.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + src) }; }
            if (sm.is_rip) { return X86Asm { ...a, unknown: a.unknown.append("rip-relative operand not encoded here: " + src) }; }
            a = X86Asm { ...a, code: x86_movslq_load(a.code, x86_gas_reg(dst), sm.base, sm.has_index, sm.index, sm.scale, sm.disp) };
        } else {
            a = X86Asm { ...a, code: x86_movslq_rr(a.code, x86_gas_reg(dst), x86_gas_reg32(src)) };
        }
        return a;
    }
    if (mnem == "movzwq") {
        var zm: GasMem = x86_gas_parse_mem(src);
        if (zm.no_base) { return X86Asm { ...a, unknown: a.unknown.append("no-base SIB operand not encoded here: " + src) }; }
        if (zm.is_rip) { return X86Asm { ...a, unknown: a.unknown.append("rip-relative operand not encoded here: " + src) }; }
        a = X86Asm { ...a, code: x86_movzwq_load(a.code, x86_gas_reg(dst), zm.base, zm.has_index, zm.index, zm.scale, zm.disp) };
        return a;
    }
    // Unsupported two-operand mnemonic (grown in later slices): RECORD it
    // (SH-005) — a dropped instruction means the byte stream is corrupt,
    // so drivers fail on `a.unknown` instead of writing the executable.
    return X86Asm { ...a, unknown: a.unknown.append(mnem) };
}

// x86_gas_directive_ignorable reports whether a directive can be dropped
// without shifting anything: symbol-table metadata (`.globl` / `.weak` /
// `.type` / `.size`) the in-process linker does not consume. Everything
// else must be handled or recorded.
function x86_gas_directive_ignorable(line: string): boolean {
    return x86_str_starts_with(line, ".globl") || x86_str_starts_with(line, ".weak")
        || x86_str_starts_with(line, ".type") || x86_str_starts_with(line, ".size")
        || x86_str_starts_with(line, ".file") || x86_str_starts_with(line, ".ident");
}

// x86_gas_align applies .align/.balign (a byte count on x86 GAS) and
// .p2align (a power-of-two exponent): NOP-fill in .text (the multi-byte
// NOPs GNU as uses, honouring the optional max-skip third argument),
// zero-fill in .rodata/.bss. The optional second argument (a fill value)
// is ignored, as in the native assembler — .text padding is always
// executable NOPs.
function x86_gas_align(own a: X86Asm, section: i32, line: string): X86Asm {
    var sp: i32 = x86_str_indexof(line, " ");
    if (sp < 0) { return x86_gas_bad(a, line); }
    var parts: string[] = x86_str_split(slice_unchecked(line, sp + 1, line.len()) + "", ",");
    var n: i32 = x86_gas_atoi(x86_gas_trim(parts[0]));
    var align: i32 = n;
    if (x86_str_starts_with(line, ".p2align")) {
        if (n > 30) { return x86_gas_bad(a, line); }
        align = 1;
        var k: i32 = 0;
        while (k < n) { align = align * 2; k = k + 1; }
    }
    if (align <= 1) { return a; }
    if (section == 2) {
        while ((a.bss_size % align) != 0) { a = x86_bss_skip(a, 1); }
        return a;
    }
    if (section == 1) {
        while ((a.rodata.len() % align) != 0) { a = X86Asm { ...a, rodata: a.rodata.append(0) }; }
        return a;
    }
    var pad: i32 = (align - (a.code.len() % align)) % align;
    if (pad == 0) { return a; }
    if (parts.len() >= 3) {
        var ms: string = x86_gas_trim(parts[2]);
        if (ms.len() > 0 && pad > x86_gas_atoi(ms)) { return a; }
    }
    return X86Asm { ...a, code: x86_nop_pad(a.code, pad) };
}

// x86_gas_comment_start returns the index of the `#` that begins a comment,
// or -1. A `#` inside a string literal is data: truncating there shortens
// the string and shifts every .rodata symbol after it.
function x86_gas_comment_start(line: string): i32 {
    var i: i32 = 0;
    var in_str: boolean = false;
    while (i < line.len()) {
        var c: i32 = line[i] as i32;
        if (in_str) {
            // A backslash escapes the next character, so an escaped quote
            // does not end the string.
            if (c == 92) { i = i + 2; continue; }
            if (c == 34) { in_str = false; }
        } else {
            if (c == 34) { in_str = true; }
            else if (c == 35) { return i; } // '#'
        }
        i = i + 1;
    }
    return 0 - 1;
}

// x86_gas_assemble parses a whole GAS program and returns the resolved
// X86Asm (code + rodata). Lines are classified as label (`name:`),
// directive (`.…`), or instruction; `#` begins a comment.
pub function x86_gas_assemble(src: string): X86Asm {
    var a: X86Asm = x86_asm_new();
    var section: i32 = 0; // 0 = .text, 1 = .rodata
    var lines: string[] = x86_str_split(src, "\n");
    var li: i32 = 0;
    while (li < lines.len()) {
        var raw: string = lines[li];
        li = li + 1;
        var hash: i32 = x86_gas_comment_start(raw);
        if (hash >= 0) {
            raw = slice_unchecked(raw, 0, hash) + "";
        }
        var line: string = x86_gas_trim(raw);
        if (line.len() == 0) {
            continue;
        }
        // label prefix: `name:` possibly followed by more on the same
        // line (asm.fern emits `.L0: .double 84.0`). A label is a single
        // token (no space / paren / comma) before the first ':'.
        var colon: i32 = x86_str_indexof(line, ":");
        if (colon > 0) {
            var before: str = slice_unchecked(line, 0, colon);
            if (x86_str_indexof(before, " ") < 0 && x86_str_indexof(before, "(") < 0 && x86_gas_top_comma(before) < 0) {
                if (section == 1) {
                    a = x86_rodata_label(a, before);
                } else if (section == 2) {
                    a = x86_bss_label(a, before);
                } else {
                    a = x86_label(a, before);
                }
                line = x86_gas_trim(slice_unchecked(line, colon + 1, line.len()));
                if (line.len() == 0) {
                    continue;
                }
            }
        }
        // directive: `.…`
        if (line[0] == b'.') {
            if (x86_str_starts_with(line, ".section")) {
                if (x86_str_contains(line, ".rodata")) {
                    section = 1;
                } else if (x86_str_contains(line, ".bss")) {
                    section = 2;
                } else if (x86_str_contains(line, ".data")) {
                    section = 1; // initialised data -> emit bytes like rodata
                } else {
                    section = 0;
                }
            } else if (line == ".text") {
                section = 0;
            } else if (line == ".bss") {
                // The bare section shorthands, alongside `.section .bss`.
                section = 2;
            } else if (line == ".data") {
                section = 1;
            } else if (x86_str_starts_with(line, ".quad")) {
                var qop: string = x86_gas_trim(slice_unchecked(line, 6, line.len()));
                if (section == 2) {
                    a = x86_bss_skip(a, 8); // zero-init quad reserves 8 bytes
                } else if (x86_gas_is_symbol(qop)) {
                    // `.quad <label>` — an absolute pointer to another
                    // symbol. Queued as a relocation; read as a number it
                    // would be 0.
                    a = x86_rodata_quad_sym(a, qop);
                } else {
                    // Parsed as i64, not i32: a `.quad` holds the full 64-bit
                    // value, and reading it narrow lost both ends. A negative
                    // one came back zero-extended (a const-struct `i32` field of
                    // -5 read as 4294967291, #6458) and anything past 2^32
                    // simply truncated.
                    a = x86_rodata_quad(a, x86_gas_atoi64(qop));
                }
            } else if (x86_str_starts_with(line, ".long")) {
                // `.long a, b, …`: each comma-separated value as 4 little-endian
                // bytes. The IR emitters lay an f64 constant down as two `.long`
                // halves (exact bits, so the encoding is assembler-independent —
                // see const_f64). Splitting the comma list keeps a single
                // labelled directive; ignoring it (the pre-#5434 behaviour)
                // silently dropped the 8 rodata bytes and shifted everything
                // after — the SH-005 hazard class.
                var lrest: string = x86_gas_trim(slice_unchecked(line, 6, line.len()));
                var ltok: string = "";
                var lci: i32 = 0;
                while (lci < lrest.len()) {
                    if (lrest[lci] == b',') {
                        a = X86Asm { ...a, rodata: x86_le32(a.rodata, x86_gas_atoi(x86_gas_trim(ltok))) };
                        ltok = "";
                    } else {
                        ltok = ltok + slice_unchecked(lrest, lci, lci + 1);
                    }
                    lci = lci + 1;
                }
                if (x86_gas_trim(ltok).len() > 0) {
                    a = X86Asm { ...a, rodata: x86_le32(a.rodata, x86_gas_atoi(x86_gas_trim(ltok))) };
                }
            } else if (x86_str_starts_with(line, ".double")) {
                a = X86Asm { ...a, rodata: x86_le64_i64(a.rodata, f64_bits(x86_gas_parse_f64(x86_gas_trim(slice_unchecked(line, 8, line.len()))))) };
            } else if (x86_str_starts_with(line, ".ascii")) {
                a = X86Asm { ...a, rodata: x86_gas_ascii(a.rodata, line) };
            } else if (x86_str_starts_with(line, ".skip") || x86_str_starts_with(line, ".zero") || x86_str_starts_with(line, ".space")) {
                // Reserve N zero bytes; `.zero` / `.space` are the SSA
                // backend's spellings. In an initialised section the bytes
                // must be laid down, or every later symbol shifts.
                var zn: i32 = x86_gas_atoi(x86_gas_trim(slice_unchecked(line, x86_str_indexof(line, " "), line.len())));
                if (section == 2) {
                    a = x86_bss_skip(a, zn);
                } else if (section == 1) {
                    var zi: i32 = 0;
                    while (zi < zn) { a = X86Asm { ...a, rodata: a.rodata.append(0) }; zi = zi + 1; }
                }
            } else if (x86_str_starts_with(line, ".byte")) {
                // A single byte of initialised data; dropping it shifts
                // every later .rodata symbol (SH-005).
                a = X86Asm { ...a, rodata: a.rodata.append(x86_gas_atoi(x86_gas_trim(slice_unchecked(line, 5, line.len()))) & 255) };
            } else if (x86_str_starts_with(line, ".align") || x86_str_starts_with(line, ".balign") || x86_str_starts_with(line, ".p2align")) {
                a = x86_gas_align(a, section, line);
            } else if (!x86_gas_directive_ignorable(line)) {
                // Every directive above either lays bytes down or moves a
                // section cursor, so an unrecognised one that silently does
                // neither shifts every symbol after it (SH-005).
                a = X86Asm { ...a, unknown: a.unknown.append(line) };
            }
            continue;
        }
        // instruction: mnemonic + operand text
        var sp: i32 = x86_str_indexof(line, " ");
        var mnem: string = line;
        var rest: string = "";
        if (sp >= 0) {
            mnem = slice_unchecked(line, 0, sp) + "";
            rest = x86_gas_trim(slice_unchecked(line, sp + 1, line.len()));
        }
        a = x86_gas_emit(a, mnem, rest);
    }
    a = x86_resolve(a);
    return a;
}
