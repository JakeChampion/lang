            a = X86Asm { ...a, fix_names: a.fix_names.append(m.label) };
            a = X86Asm { ...a, fix_tail_offs: a.fix_tail_offs.append(patch_off) };
            return X86Asm { ...a, fix_tail_bytes: a.fix_tail_bytes.append(tail) };
        }
        return X86Asm { ...a, fix_names: a.fix_names.append(m.label) };
    }
    return X86Asm { ...a, code: x86_byte_mem_operand(a.code, reg, m.base, m.has_index, m.index, m.scale, m.disp) };
