    "cvttpd2dq" => {
      return 102 * 256 + 230;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// x86_gas_sse_int_op: the packed-INTEGER half of the SSE table (all
// 66-prefixed). The psll/psrl/psra entries here are the by-%xmm-count
// forms; the by-immediate forms are the 0F 71/72/73 groups
// (x86_gas_vshift_op).
function x86_gas_sse_int_op(mnem: string): i32 {
  match (mnem) {
    "pcmpeqb" => {
      return 102 * 256 + 116;
    },
    "pcmpeqw" => {
      return 102 * 256 + 117;
    },
    "pcmpeqd" => {
      return 102 * 256 + 118;
    },
    "pcmpgtb" => {
      return 102 * 256 + 100;
    },
    "pcmpgtw" => {
      return 102 * 256 + 101;
    },
    "pcmpgtd" => {
      return 102 * 256 + 102;
    },
    "punpcklbw" => {
      return 102 * 256 + 96;
    },
    "punpcklwd" => {
      return 102 * 256 + 97;
    },
    "punpckldq" => {
      return 102 * 256 + 98;
    },
    "punpcklqdq" => {
      return 102 * 256 + 108;
    },
    "punpckhbw" => {
      return 102 * 256 + 104;
    },
    "punpckhwd" => {
      return 102 * 256 + 105;
    },
    "punpckhdq" => {
      return 102 * 256 + 106;
    },
    "punpckhqdq" => {
      return 102 * 256 + 109;
    },
    "por" => {
      return 102 * 256 + 235;
    },
    "pand" => {
      return 102 * 256 + 219;
    },
    "pxor" => {
      return 102 * 256 + 239;
    },
    "pandn" => {
      return 102 * 256 + 223;
    },
    "paddb" => {
      return 102 * 256 + 252;
    },
    "paddw" => {
      return 102 * 256 + 253;
    },
    "paddd" => {
      return 102 * 256 + 254;
    },
    "paddq" => {
      return 102 * 256 + 212;
    },
    "psubb" => {
      return 102 * 256 + 248;
    },
    "psubw" => {
      return 102 * 256 + 249;
    },
    "psubd" => {
      return 102 * 256 + 250;
    },
    "psubq" => {
      return 102 * 256 + 251;
    },
    "paddusb" => {
      return 102 * 256 + 220;
    },
    "psubusb" => {
      return 102 * 256 + 216;
    },
    "paddsb" => {
      return 102 * 256 + 236;
    },
    "psubsb" => {
      return 102 * 256 + 232;
    },
    "pavgb" => {
      return 102 * 256 + 224;
    },
    "pminub" => {
      return 102 * 256 + 218;
    },
    "pmaxub" => {
      return 102 * 256 + 222;
    },
    "pminsw" => {
      return 102 * 256 + 234;
    },
    "pmaxsw" => {
      return 102 * 256 + 238;
    },
    "pmullw" => {
      return 102 * 256 + 213;
    },
    "pmulhw" => {
      return 102 * 256 + 229;
    },
    "pmulhuw" => {
      return 102 * 256 + 228;
    },
    "pmuludq" => {
      return 102 * 256 + 244;
    },
    "psadbw" => {
      return 102 * 256 + 246;
    },
    "packsswb" => {
      return 102 * 256 + 99;
    },
    "packuswb" => {
      return 102 * 256 + 103;
    },
    "packssdw" => {
      return 102 * 256 + 107;
    },
    "psllw" => {
