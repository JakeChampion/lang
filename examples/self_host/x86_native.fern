// x86_gas_sse_table: a two-byte-opcode SSE table op, `src, %xmm` with an
// xmm or memory (rip included) source.
function x86_gas_sse_table(own a: X86Asm, mnem: string, pfx: i32, op: i32, src: string, dst: string): X86Asm {
    var xd: i32 = x86_gas_xmm(dst);
    if (xd < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    if (x86_str_contains(src, "(")) {
        var m: GasMem = x86_gas_parse_mem(src);
        if (!x86_gas_mem_ok(m)) { return x86_gas_bad(a, mnem + " " + src); }
        return x86_gas_sse_mem(a, pfx, op, xd, m, 0);
    }
    var xs: i32 = x86_gas_xmm(src);
    if (xs < 0) { return x86_gas_bad(a, mnem + " " + src + ", " + dst); }
    return X86Asm { ...a, code: x86_sse_any_rr(a.code, pfx, op, xd, xs) };
