// examples/self_host/irverify.fern — an independent well-formedness
// checker for the self-host IR, mirroring native's internal/ir/verify.go.
//
// The point is that this is NOT the compiler. Every backend trusts the IR
// it is handed, so a lowering bug becomes machine code that is structurally
// wrong — a local index past the end of the frame, a branch depth that
// leaves the enclosing scope, a call with the wrong argument count — and
// the first symptom is a SIGSEGV or a silent miscompile several stages
// downstream. A verifier turns that class into an error naming the
// malformed op: a second, simpler program whose only job is to disbelieve
// the first.
//
// That matters more here than it does natively. docs/TEST-GATES.md records
// that the fixpoint is self-referential and structurally blind to a stable
// miscompile — #6018 passed the per-module fixpoint AND all 335 fixtures
// AND the native suite while segfaulting the driver. This pass is not
// self-referential: it does not care whether the compiler reproduces
// itself, only whether the ops it emitted can be lowered at all.
//
// This file checks STRUCTURE. Operand-stack discipline is its sibling
// irverifystack.fern (#6639 slice 2), which reuses this file's Problem and
// stands down wherever the two overlap — a malformed scope or an
// out-of-range branch depth is reported here and only here. Native's
// verifyprovided.go still has no counterpart (slice 4).

import "./ir";
import "./util";

// ---- problems ----------------------------------------------------------

// Problem is one violation, located precisely enough to fix. `op` indexes
// into the function's op stream, or is -1 for a whole-function problem.
pub struct Problem {
    fn_name: string,
    op: i32,
    kind: string,
    msg: string,
}

pub function problem_str(p: Problem): string {
    if (p.op < 0) { return p.fn_name + ": " + p.msg; }
    return p.fn_name + ": op " + util.i32_to_string(p.op) + " (" + p.kind + "): " + p.msg;
}

// format_problems renders problems for a failure message, capped so a
// systemic break reports a readable sample rather than thousands of lines.
pub function format_problems(ps: Problem[], max: i32): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < ps.len()) {
        if (i == max) {
            return out + "\n    ... and " + util.i32_to_string(ps.len() - max) + " more";
        }
        out = out + "\n    " + problem_str(ps[i]);
        i = i + 1;
    }
    return out;
}

// ---- callee signatures -------------------------------------------------

// FnSig is the arity of a function the module defines. Only DEFINED
// functions are listed: an unresolved callee name is left alone rather than
// reported, because the self-host has no counterpart to native's
// internal/caps inventory, so it cannot tell a builtin from a typo. That
// check is #6639 slice 4 and arrives with the inventory it needs.
pub struct FnSig { name: string, n_params: i32 }

function sig_params_of(sigs: FnSig[], name: string): i32 {
    var i: i32 = 0;
    while (i < sigs.len()) {
        if (sigs[i].name == name) { return sigs[i].n_params; }
        i = i + 1;
    }
    return 0 - 1;
}

// ---- the pass ----------------------------------------------------------

// verify_fn checks one lowered function's op stream and returns every
// problem found, in op order.
//
// `n_locals` is the WHOLE frame — slots [0, n_params) are the parameters and
// [n_params, n_locals) the body locals, which is how the register backends
// size it (`frame = n_locals * 8`). The wasm backend appends five private
// scratch slots at n_locals..n_locals+4 during emission; those do not exist
// in the IR, so an op stream referencing one is a lowering bug, not a wasm
// detail leaking in.
//
// `sigs` may be empty, which skips the call-arity check.
pub function verify_fn(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, sigs: FnSig[]): Problem[] {
    var out: Problem[] = [];

    var k_load: i32 = ir.kind_id("load_local");
    var k_store: i32 = ir.kind_id("store_local");
    var k_tee: i32 = ir.kind_id("tee_local");
    var k_block: i32 = ir.kind_id("block");
    var k_loop: i32 = ir.kind_id("loop");
    var k_if: i32 = ir.kind_id("if");
    var k_else: i32 = ir.kind_id("else");
    var k_end: i32 = ir.kind_id("end");
    var k_br: i32 = ir.kind_id("br");
    var k_brif: i32 = ir.kind_id("brif");
    var k_calld: i32 = ir.kind_id("call_direct");
    var k_calli: i32 = ir.kind_id("call_indirect");
    var k_callc: i32 = ir.kind_id("call_closure_direct");

    // The open-scope stack, as parallel arrays with an explicit depth so a
    // pop is O(1) — an array-slice pop would make the walk quadratic on the
    // compiler's own long functions.
    var st_kind: i32[] = [];
    var st_at: i32[] = [];
    var st_else: i32[] = [];
    var depth: i32 = 0;

    var i: i32 = 0;
    while (i < ops.len()) {
        var op: ir.Op = ops[i];
        var kt: i32 = op.kind_tag;

        if (kt == k_load || kt == k_store || kt == k_tee) {
            if (op.i32_imm < 0 || op.i32_imm >= n_locals) {
                out = out.append(Problem {
                    fn_name: fn_name, op: i, kind: ir.kind_name(kt),
                    msg: "local index " + util.i32_to_string(op.i32_imm)
                        + " is outside the frame (" + util.i32_to_string(n_params)
                        + " params + " + util.i32_to_string(n_locals - n_params)
                        + " locals = " + util.i32_to_string(n_locals) + " slots)"
                });
            }
        } else if (kt == k_block || kt == k_loop || kt == k_if) {
            if (depth < st_kind.len()) {
                st_kind = st_kind.with(depth, kt);
                st_at = st_at.with(depth, i);
                st_else = st_else.with(depth, 0 - 1);
            } else {
                st_kind = st_kind.append(kt);
                st_at = st_at.append(i);
                st_else = st_else.append(0 - 1);
            }
            depth = depth + 1;
        } else if (kt == k_else) {
            if (depth == 0) {
                out = out.append(Problem { fn_name: fn_name, op: i, kind: "else", msg: "else with no open scope" });
            } else if (st_kind[depth - 1] != k_if) {
                out = out.append(Problem {
                    fn_name: fn_name, op: i, kind: "else",
                    msg: "else closes a " + ir.kind_name(st_kind[depth - 1])
                        + " opened at op " + util.i32_to_string(st_at[depth - 1]) + ", not an if"
                });
            } else if (st_else[depth - 1] >= 0) {
                out = out.append(Problem {
                    fn_name: fn_name, op: i, kind: "else",
                    msg: "second else for the if opened at op " + util.i32_to_string(st_at[depth - 1])
                        + " (first at op " + util.i32_to_string(st_else[depth - 1]) + ")"
                });
            } else {
                st_else = st_else.with(depth - 1, i);
            }
        } else if (kt == k_end) {
            if (depth == 0) {
                out = out.append(Problem { fn_name: fn_name, op: i, kind: "end", msg: "end with no open scope" });
            } else {
                depth = depth - 1;
            }
        } else if (kt == k_br || kt == k_brif) {
            // A branch names a scope by RELATIVE depth: 0 is the innermost
            // open scope. depth == the number of open scopes targets the
            // implicit function-body scope, which is how a lowered
            // `return`-shaped branch leaves the outermost block; anything
            // beyond that has no target at all, and a backend will emit a
            // jump to whatever happens to be there.
            if (op.i32_imm < 0 || op.i32_imm > depth) {
                out = out.append(Problem {
                    fn_name: fn_name, op: i, kind: ir.kind_name(kt),
                    msg: "branch depth " + util.i32_to_string(op.i32_imm)
                        + " has no target - only " + util.i32_to_string(depth) + " scopes are open"
                });
            }
        } else if (kt == k_calld) {
            if (op.i32_imm < 0) {
                // Report the impossible count and stop: an arity comparison
                // against it would only add noise.
                out = out.append(Problem {
                    fn_name: fn_name, op: i, kind: "call_direct",
                    msg: "negative argument count " + util.i32_to_string(op.i32_imm)
                });
            } else if (op.str.len() == 0) {
                out = out.append(Problem { fn_name: fn_name, op: i, kind: "call_direct", msg: "call with no callee name" });
            } else {
                var np: i32 = sig_params_of(sigs, op.str);
                // A closure target also receives its environment pointer, so
                // the callee may declare one more parameter than the call
                // site pushes.
                if (np >= 0 && op.i32_imm != np && op.i32_imm != np - 1) {
                    out = out.append(Problem {
                        fn_name: fn_name, op: i, kind: "call_direct",
                        msg: "calls " + op.str + " with " + util.i32_to_string(op.i32_imm)
                            + " args, but it declares " + util.i32_to_string(np) + " parameters"
                    });
                }
            }
        } else if (kt == k_calli || kt == k_callc) {
            if (op.i32_imm < 0) {
                out = out.append(Problem {
                    fn_name: fn_name, op: i, kind: ir.kind_name(kt),
                    msg: "negative argument count " + util.i32_to_string(op.i32_imm)
                });
            }
        }
        i = i + 1;
    }

    var d: i32 = 0;
    while (d < depth) {
        out = out.append(Problem {
            fn_name: fn_name, op: st_at[d], kind: ir.kind_name(st_kind[d]),
            msg: "scope is never closed - the function ends with it still open"
        });
        d = d + 1;
    }
    return out;
}
