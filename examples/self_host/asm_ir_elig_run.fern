// examples/self_host/asm_ir_elig_run.fern — lean IR-eligibility probe driver.
// Reads a Fern program on stdin and exits 1 if every function is IR-eligible
// (asm_ir.all_eligible over the builtin-injected module), else 0. It imports
// only the front-end + asm_ir — NOT the full backend — so its linked binary is
// small and caches cheaply, unlike a whole-compiler driver. The six self-host
// IR-eligibility probe tests share it (see eligBits in
// internal/e2e/self_host_unified_driver_test.go).
import "std/io";
import "./lexer";
import "./parser";
import "./asm_ir";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    if (asm_ir.all_eligible(parser.module_with_builtins(mod))) { return 1; }
    return 0;
}
