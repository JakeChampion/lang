// examples/self_host/ssa_wasm_emit_run.fern — driver for the SSA → wasm
// backend (ssa_wasm.fern). Reads a program on stdin, lowers each in-subset
// function to SSA (build_func), optimises it, and prints the emitted WAT to
// stdout. The companion Go test (self_host_ssa_wasm_test.go) validates the
// WAT and runs it under wasmtime, asserting the process exit code matches
// the program's value — end-to-end proof that AST → SSA → optimise →
// WAT → execute preserves semantics. Mirrors ssa_emit_run.fern (the native
// backends' driver); the only difference is the final emit call.

import "core/no_prelude";
import "std/io";
import "./lexer";
import "./parser";
import "./ssa";
import "./ssa_wasm";

function main(): i32 {
    var mod: parser.Module = parser.parse_module(lexer.tokenize(io.read_all_stdin()));
    // Pointer-returning functions get a 64-bit call result on the native
    // backends; on wasm32 every value is i32, but mark_ptr_calls still needs
    // the ptr_ret set, so derive it the same way the native driver does.
    var ptr_ret: string[] = [];
    var pi: i32 = 0;
    while (pi < mod.funcs.len()) {
        if (ssa.is_ptr_type(mod.funcs[pi].ret_type) || ssa.is_struct_type(mod.funcs[pi].ret_type, mod.structs)) { ptr_ret = ptr_ret.push(ssa.fn_sym(mod.funcs[pi])); }
        pi = pi + 1;
    }
    // Some lowerings emit calls to injected runtime helpers (__ssa_* — array
    // push / slice, the map ops) defined in pure Fern. Parse them so their
    // pointer-returning signatures join ptr_ret; each body is built + emitted
    // only if the program actually calls it (below).
    var hmod: parser.Module = parser.parse_module(lexer.tokenize(ssa.ssa_helpers_src()));
    var hi0: i32 = 0;
    while (hi0 < hmod.funcs.len()) {
        if (ssa.is_ptr_type(hmod.funcs[hi0].ret_type)) { ptr_ret = ptr_ret.push(hmod.funcs[hi0].name); }
        hi0 = hi0 + 1;
    }
    // No-capture lambdas lift to top-level functions and are called directly;
    // build them like any user function so lambda programs are in the subset.
    var lifted: parser.FuncDecl[] = ssa.collect_lambdas(mod.funcs);
    var li0: i32 = 0;
    while (li0 < lifted.len()) {
        if (ssa.is_ptr_type(lifted[li0].ret_type) || ssa.is_struct_type(lifted[li0].ret_type, mod.structs)) { ptr_ret = ptr_ret.push(lifted[li0].name); }
        li0 = li0 + 1;
    }
    // f64-returning functions: mark_float_calls tags calls to them so the
    // result local is typed f64 (the wasm backend lowers f64).
    var float_ret: string[] = [];
    var fri: i32 = 0;
    while (fri < mod.funcs.len()) {
        if (mod.funcs[fri].ret_type == "f64") { float_ret = float_ret.push(ssa.fn_sym(mod.funcs[fri])); }
        fri = fri + 1;
    }
    var frl: i32 = 0;
    while (frl < lifted.len()) {
        if (lifted[frl].ret_type == "f64") { float_ret = float_ret.push(lifted[frl].name); }
        frl = frl + 1;
    }
    var seed: ssa.Seed = ssa.build_seed(mod.funcs);
    var funcs: ssa.SFunc[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var r: ssa.BResult = ssa.build_func_seeded(mod.funcs[i], mod.structs, seed);
        if (r.ok) { funcs = funcs.push(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(r.func, ptr_ret), float_ret))); }
        i = i + 1;
    }
    var li: i32 = 0;
    while (li < lifted.len()) {
        var lr: ssa.BResult = ssa.build_func_seeded(lifted[li], mod.structs, seed);
        if (lr.ok) { funcs = funcs.push(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(lr.func, ptr_ret), float_ret))); }
        li = li + 1;
    }
    // Inject each runtime helper body the program actually calls.
    var hi: i32 = 0;
    while (hi < hmod.funcs.len()) {
        if (ssa.calls_func(funcs, hmod.funcs[hi].name)) {
            var hr: ssa.BResult = ssa.build_func_seeded(hmod.funcs[hi], mod.structs, seed);
            if (hr.ok) { funcs = funcs.push(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(hr.func, ptr_ret), float_ret))); }
        }
        hi = hi + 1;
    }
    write(ssa_wasm.emit_program(funcs));
    return 0;
}
