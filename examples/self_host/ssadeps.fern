// Validate SSA value availability for semantic lifetime dependencies before
// feeding them to ssalive. This proves neither reference counts nor uniqueness.
import "./ssa";
import "./ssalive";

function flags(n: i32, bit: boolean): boolean[] {
    var out: boolean[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(bit); i = i + 1; }
    return out;
}

function indices(n: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(0 - 1); i = i + 1; }
    return out;
}

function contains(values: i32[], value: i32): boolean {
    for v in values { if (v == value) { return true; } }
    return false;
}

// position_of maps a block id to its position in f.blocks, -1 for an id no
// block carries: one table, so no walk below searches the block list.
function position_of(f: ssa.SFunc): i32[] {
    var top: i32 = 0;
    for b in f.blocks { if (b.id > top) { top = b.id; } }
    var out: i32[] = indices(top + 1);
    var i: i32 = 0;
    while (i < f.blocks.len()) { out = out.with(f.blocks[i].id, i); i = i + 1; }
    return out;
}

// successor_positions is block bi's successors by position, in branch order.
function successor_positions(f: ssa.SFunc, at: i32[], bi: i32): i32[] {
    var term: ssa.STerm = f.blocks[bi].term;
    if (term.kind_tag == 2) { return [at[term.target]]; }
    if (term.kind_tag == 3) { return [at[term.t], at[term.f]]; }
    return [];
}

// Requires a structurally verified graph with an existing entry block.
pub function reachable_blocks(f: ssa.SFunc): boolean[] {
    var at: i32[] = position_of(f);
    var reachable: boolean[] = flags(f.blocks.len(), false);
    var entry: i32 = at[f.entry];
    reachable = reachable.with(entry, true);
    var work: i32[] = [entry];
    var depth: i32 = 1;
    while (depth > 0) {
        depth = depth - 1;
        var bi: i32 = work[depth];
        for sb in successor_positions(f, at, bi) {
            if (!reachable[sb]) { reachable = reachable.with(sb, true); work = push_at(work, depth, sb); depth = depth + 1; }
        }
    }
    return reachable;
}

// Dom is the dominator tree of a function's reachable blocks, by position:
// `pre` and `post` number each block in a walk of the tree, so a block
// dominates another exactly when its interval contains the other's. -1 marks
// an unreachable block, which dominates nothing and is dominated by nothing.
pub struct Dom { pre: i32[], post: i32[] }

// dom_holds reports whether position di dominates position bi.
pub function dom_holds(d: Dom, bi: i32, di: i32): boolean {
    if (d.pre[bi] < 0 || d.pre[di] < 0) { return false; }
    return d.pre[di] <= d.pre[bi] && d.post[bi] <= d.post[di];
}

// dominates computes the tree with Cooper, Harvey and Kennedy's iteration over
// reverse postorder: each block's immediate dominator is the intersection of
// its processed predecessors' dominator paths, found by walking the two up
// by postorder number. It settles in a few rounds on a reducible graph, where
// the n-by-n dataflow it replaces cost a pass over every block pair per round.
pub function dominates(f: ssa.SFunc): Dom {
    var n: i32 = f.blocks.len();
    var at: i32[] = position_of(f);
    var entry: i32 = at[f.entry];
    // Postorder by an explicit stack: a block is numbered once all its
    // successors are.
    var po: i32[] = indices(n);
    var order: i32[] = [];
    var seen: boolean[] = flags(n, false);
    var stack: i32[] = [entry];
    var sp: i32 = 1;
    var next_succ: i32[] = indices(n);
    seen = seen.with(entry, true);
    while (sp > 0) {
        var bi: i32 = stack[sp - 1];
        var succ: i32[] = successor_positions(f, at, bi);
        var k: i32 = next_succ[bi] + 1;
        while (k < succ.len() && seen[succ[k]]) { k = k + 1; }
        next_succ = next_succ.with(bi, k);
        if (k < succ.len()) {
            seen = seen.with(succ[k], true);
            stack = push_at(stack, sp, succ[k]);
            sp = sp + 1;
        } else {
            po = po.with(bi, order.len());
            order = order.append(bi);
            sp = sp - 1;
        }
    }
    var idom: i32[] = indices(n);
    idom = idom.with(entry, entry);
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var r: i32 = order.len() - 1;
        while (r >= 0) {
            var bi: i32 = order[r];
            r = r - 1;
            if (bi == entry) { continue; }
            var nd: i32 = 0 - 1;
            for pid in f.blocks[bi].preds {
                var p: i32 = at[pid];
                if (p < 0 || idom[p] < 0) { continue; }
                if (nd < 0) { nd = p; } else { nd = intersect(idom, po, p, nd); }
            }
            if (nd >= 0 && idom[bi] != nd) { idom = idom.with(bi, nd); changed = true; }
        }
    }
    // Number the tree: children lists, then an explicit-stack walk.
    var first_child: i32[] = indices(n);
    var next_sibling: i32[] = indices(n);
    var bi: i32 = 0;
    while (bi < n) {
        if (bi != entry && idom[bi] >= 0) {
            next_sibling = next_sibling.with(bi, first_child[idom[bi]]);
            first_child = first_child.with(idom[bi], bi);
        }
        bi = bi + 1;
    }
    var pre: i32[] = indices(n);
    var post: i32[] = indices(n);
    var clock: i32 = 0;
    var walk: i32[] = [entry];
    var wp: i32 = 1;
    var cursor: i32[] = indices(n);
    pre = pre.with(entry, clock);
    clock = clock + 1;
    while (wp > 0) {
        var top: i32 = walk[wp - 1];
        var c: i32 = first_child[top];
        if (cursor[top] >= 0) { c = next_sibling[cursor[top]]; }
        if (c >= 0) {
            cursor = cursor.with(top, c);
            pre = pre.with(c, clock);
            clock = clock + 1;
            walk = push_at(walk, wp, c);
            wp = wp + 1;
        } else {
            post = post.with(top, clock);
            clock = clock + 1;
            wp = wp - 1;
        }
    }
    return Dom { pre: pre, post: post };
}

// push_at writes v at stack depth d, growing the array only past its length.
function push_at(own stack: i32[], d: i32, v: i32): i32[] {
    if (d < stack.len()) { return stack.with(d, v); }
    return stack.append(v);
}

function intersect(idom: i32[], po: i32[], a: i32, b: i32): i32 {
    var x: i32 = a;
    var y: i32 = b;
    while (x != y) {
        while (po[x] < po[y]) { x = idom[x]; }
        while (po[y] < po[x]) { y = idom[y]; }
    }
    return x;
}

function available(value: i32, block: i32, pos: i32, defs: i32[], positions: i32[], dom: Dom): boolean {
    var definition: i32 = defs[value];
    if (definition < 0) { return false; }
    if (definition == block) { return positions[value] < pos; }
    return dom_holds(dom, block, definition);
}

function use_error(value: i32, block: i32, pos: i32, f: ssa.SFunc, dependencies: i32[][], defs: i32[], positions: i32[], dom: Dom): string {
    if (value < 0) { return ""; }
    if (!available(value, block, pos, defs, positions, dom)) { return "value unavailable at use"; }
    for dep in dependencies[value] {
        if (!available(dep, block, pos, defs, positions, dom)) { return "dependency unavailable at use"; }
    }
    return "";
}

// The ownership planner's lifetime entry must validate these prerequisites
// before receiving any live sets. Exact semantic types and counted-unit
// verification remain separate obligations of that planner's typed input.
pub function analyze(f: ssa.SFunc, dependencies: i32[][]): ssalive.Flow {
    var why: string = verify(f, dependencies);
    if (why != "") { return ssalive.Flow { ok: false, why: why, words: 0, live_in: [], live_out: [], at: [] }; }
    return ssalive.compute(f, dependencies);
}

// Dependencies contain their full transitive closure and are keyed by values,
// not mutable source bindings. Phi results receive independent units in the
// later planner; their incoming borrows are checked on the incoming edges.
pub function verify(f: ssa.SFunc, dependencies: i32[][]): string {
    var err: string = ssalive.input_error(f, dependencies);
    if (err != "") { return err; }
    if (f.blocks.len() > 2147483647 / f.blocks.len()) { return "dominator matrix overflow"; }
    if (f.nparams < 0 || f.nparams > f.nvals) { return "parameter dimensions"; }
    var at: i32[] = position_of(f);
    if (f.blocks[at[f.entry]].preds.len() > 0) { return "entry has predecessors"; }
    var defs: i32[] = indices(f.nvals);
    var positions: i32[] = indices(f.nvals);
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var pos: i32 = 0;
        var seen_regular: boolean = false;
        for ins in f.blocks[bi].insts {
            if (ins.kind_tag == 6 && (f.blocks[bi].id != f.entry || ins.imm < 0 || ins.imm >= f.nparams)) { return "invalid parameter definition"; }
            if (ins.kind_tag == 8) {
                if (seen_regular || ins.result < 0) { return "invalid phi definition"; }
            } else { seen_regular = true; }
            if (ins.result >= 0) {
                if (defs[ins.result] >= 0) { return "duplicate value definition"; }
                defs = defs.with(ins.result, bi);
                positions = positions.with(ins.result, pos);
            }
            pos = pos + 1;
        }
        bi = bi + 1;
    }
    // Definitions must exist even in unreachable blocks. Dominance below is
    // meaningful only for reachable uses and executable predecessor edges.
    for b in f.blocks {
        for ins in b.insts {
            for arg in ins.args { if (defs[arg] < 0) { return "undefined value"; } }
        }
        var used: i32 = 0 - 1;
        if (b.term.kind_tag == 1) { used = b.term.value; }
        if (b.term.kind_tag == 3) { used = b.term.cond; }
        if (used >= 0 && defs[used] < 0) { return "undefined value"; }
    }
    var value: i32 = 0;
    while (value < f.nvals) {
        if (dependencies[value].len() > 0 && defs[value] < 0) { return "undefined dependency source"; }
        for dep in dependencies[value] {
            if (defs[dep] < 0) { return "undefined dependency"; }
            if (dep == value) { return "cyclic dependency"; }
            for transitive in dependencies[dep] {
                if (transitive == value) { return "cyclic dependency"; }
                if (!contains(dependencies[value], transitive)) { return "incomplete dependency closure"; }
            }
        }
        value = value + 1;
    }
    var reachable: boolean[] = reachable_blocks(f);
    var dom: Dom = dominates(f);
    bi = 0;
    while (bi < f.blocks.len()) {
        var b: ssa.SBlock = f.blocks[bi];
        if (reachable[bi]) {
            var pos: i32 = 0;
            for ins in b.insts {
                if (ins.kind_tag == 8) {
                    var pi: i32 = 0;
                    while (pi < b.preds.len()) {
                        var pb: i32 = at[b.preds[pi]];
                        if (reachable[pb]) {
                            err = use_error(ins.args[pi], pb, f.blocks[pb].insts.len(), f, dependencies, defs, positions, dom);
                            if (err != "") { return err; }
                        }
                        pi = pi + 1;
                    }
                } else {
                    for arg in ins.args {
                        err = use_error(arg, bi, pos, f, dependencies, defs, positions, dom);
                        if (err != "") { return err; }
                    }
                }
                pos = pos + 1;
            }
            var used: i32 = 0 - 1;
            if (b.term.kind_tag == 1) { used = b.term.value; }
            if (b.term.kind_tag == 3) { used = b.term.cond; }
            err = use_error(used, bi, b.insts.len(), f, dependencies, defs, positions, dom);
            if (err != "") { return err; }
        }
        bi = bi + 1;
    }
    return "";
}
