// examples/self_host/checker.fern — third concrete step of the
// self-host port. Imports lexer.fern + parser.fern and walks the
// Stmt[] / Expr tree from `parser.parse_program(toks)`, assigning
// a type to every expression and verifying the program is
// well-typed under a tiny static type system.
//
// This is the *minimal* checker — the Go checker in
// internal/checker/checker.go is ~6700 LOC and handles unions,
// generics, monomorphisation entry points, exhaustiveness, struct
// methods, receiver visibility, and a host of other rules. This
// port handles only:
//
//   - Primitive types: i32, bool, string (plus an `unknown`
//     sentinel for nodes the parser couldn't fully resolve)
//   - Variable bindings via `var x = expr;`
//   - Binary operators: + - * / % (numeric), < <= > >= ==
//     != (compare → bool), && || (bool-only)
//   - Unary `-` (numeric) and `!` (bool)
//   - String concatenation (`+` on two strings → string)
//   - Identifier lookup through a flat scope (no nesting in this
//     cut — there's no block-introducing stmt to scope yet)
//
// The point isn't completeness — it's demonstrating the
// architectural pattern works end-to-end: `parser.ExprBinary(b)`
// pattern-matches across module boundaries, `b.left` /
// `b.right` recurse through `parser.Expr` cleanly, and the
// resulting Type[] aligns row-for-row with the input Stmt[].
//
// Out of scope (the next iteration grows them):
//   - Generics, type parameters, monomorphisation
//   - Unions, enums, match exhaustiveness
//   - Structs, methods, receiver dispatch
//   - Function declarations + calls with arity / signature checks
//   - Control flow (`if` / `while` / `for`) — parser stub
//     doesn't emit them yet either
//   - Float types (the parser flags `is_float` but the checker
//     just lumps both into a numeric kind for now)

import "./util";
import "./lexer";
import "./parser";

// =================== TYPE SYSTEM ====================

// TypeI32 models EVERY integer width — i32 / i64 / u32 / u64 — distinguished
// by (width, unsigned). The checker stays width-LENIENT for assignability
// (type_eq treats all integer types as interchangeable, matching the port's
// long-standing loose-int behaviour), but width is carried so method DISPATCH
// keys (which compare the declared receiver-type spelling) can recover "i64" /
// "u32" / "u64" at a call site. Actual codegen width lives in asmcore's `Ty`.
pub struct TypeI32 { tag: i32, width: i32, unsigned: boolean }
pub struct TypeBool { tag: i32 }      // payload — variants need a
pub struct TypeString { tag: i32 }    // shape; the field is unused.
pub struct TypeFloat { tag: i32 }     // f64 — `f32` aliases the same
                                      // type in this cut (no width
                                      // distinction in the checker).
// Array of homogeneous elements. elem can itself be any Type, so
// `i32[][]` is representable. An empty literal `[]` defaults to
// TypeArray { elem: TypeUnknown(...) } — the checker rejects it
// in inference contexts because it can't infer a concrete elem
// type.
pub struct TypeArray { elem: Type }
// TypeStruct references a user-declared struct by name. The
// full field list lives in the StructTable (built once per
// module); this variant is just the nominal handle.
pub struct TypeStruct { name: string, args: Type[] }
// TypeTuple carries a fixed-arity heterogeneous element-type
// list. Field access via `.0` / `.1` / … reads the elem type
// at that position; out-of-range indices surface unknown.
pub struct TypeTuple { elements: Type[] }
// TypeFunc is the static type of a callable value — `function
// (a: T, b: T): RT { … }` or a binding to one. param_types
// captures the declared parameter types in order; ret_type is
// the body's declared return type.
pub struct TypeFunc { param_types: Type[], ret_type: Type }
// TypeMap models `Map[K, V]` — a runtime hash-map keyed by K
// values yielding V values. The actual runtime + method
// dispatch is a follow-up; the checker only knows enough to
// give a Map-typed binding a structural identity and route
// `==` comparisons / type assignability.
pub struct TypeMap { key: Type, value: Type }
// TypeUnion references a user-declared type alias by name —
// `pub type Shape = Circle | Square`. Variant resolution lives
// in the UnionTable (parallel to StructTable). The checker uses
// the union name for assignability: a variant value (TypeStruct
// "Circle") is assignable to a TypeUnion "Shape" if Circle
// appears in Shape's variant list.
pub struct TypeUnion { name: string }
// A `dyn Trait` object type. `traits` is the trait-set text after the
// `dyn ` prefix — "Greet" for `dyn Greet`, "A + B" for `dyn A + B`. In this
// partial type system a dyn value's concrete Self isn't tracked (native
// resolves it at monomorphisation / vtable-dispatch time), so assignability
// into a dyn slot is lenient — a value of ANY value type may flow in, exactly
// as a generic parameter accepts any argument. The coded conformance passes
// (E021 object-safety, E059/E060 downcast, E062 ambiguous-method) run
// independently off the annotation TEXT, so real dyn errors still surface;
// this Type only stops the uncoded silent over-reject of a `dyn` binding
// (#4346 piece 2). Method dispatch THROUGH a dyn value is not yet typed —
// `d.hi()` still infers unknown — a deliberately-deferred follow-up.
pub struct TypeDyn { traits: string }
pub struct TypeUnknown { reason: string }

pub type Type = TypeI32 | TypeBool | TypeString | TypeFloat | TypeArray | TypeStruct | TypeTuple | TypeFunc | TypeMap | TypeUnion | TypeDyn | TypeUnknown;

// Helper wraps: same pattern as elsewhere in the port — putting
// the struct literal in return-position lets the implicit
// struct→union wrap fire. Inline `var t: Type = TypeI32 { ... };`
// inside a non-return position doesn't always trigger the wrap.
function t_i32(): Type { return TypeI32 { tag: 0, width: 32, unsigned: false }; }
function t_i64(): Type { return TypeI32 { tag: 0, width: 64, unsigned: false }; }
function t_u32(): Type { return TypeI32 { tag: 0, width: 32, unsigned: true }; }
function t_u64(): Type { return TypeI32 { tag: 0, width: 64, unsigned: true }; }
// int_label recovers the source spelling of an integer TypeI32 from its
// (width, unsigned) so method dispatch + diagnostics name the right type.
function int_label(t: TypeI32): string {
    if (t.unsigned) {
        if (t.width == 64) { return "u64"; }
        return "u32";
    }
    if (t.width == 64) { return "i64"; }
    return "i32";
}
function t_bool(): Type { return TypeBool { tag: 0 }; }
function t_string(): Type { return TypeString { tag: 0 }; }
function t_float(): Type { return TypeFloat { tag: 0 }; }
function t_array(elem: Type): Type { return TypeArray { elem: elem }; }
function t_struct(name: string): Type { var noargs: Type[] = []; return TypeStruct { name: name, args: noargs }; }
// t_struct_g builds a struct type carrying its generic instantiation args
// (`Box[i32]` → TypeStruct{"Box", [i32]}). The args are used ONLY to
// substitute a field's type parameter at field access (#4346 piece 2);
// type_eq / type_assignable compare structs by name and ignore args, so a
// name-only struct (args=[]) and an instantiated one stay interchangeable
// wherever assignability is checked.
function t_struct_g(name: string, args: Type[]): Type { return TypeStruct { name: name, args: args }; }
function t_tuple(elements: Type[]): Type { return TypeTuple { elements: elements }; }
function t_func(param_types: Type[], ret_type: Type): Type {
    return TypeFunc { param_types: param_types, ret_type: ret_type };
}
function t_map(key: Type, value: Type): Type {
    return TypeMap { key: key, value: value };
}

// digit_string_to_i32 parses a decimal-digit string. Returns
// -1 on the empty string or any non-digit byte. Used only for
// tuple-index field names like "0" / "1" / "42".
function digit_string_to_i32(s: string): i32 {
    var n: i32 = s.len();
    if (n == 0) { return 0 - 1; }
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return 0 - 1; }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    return acc;
}
function t_union(name: string): Type { return TypeUnion { name: name }; }
function t_dyn(traits: string): Type { return TypeDyn { traits: traits }; }
function t_unknown(reason: string): Type { return TypeUnknown { reason: reason }; }

// type_debug renders a Type to a compact, unambiguous debug spelling — the Type
// analogue of asmcore's ty_tag. Recursive over the composite variants so the
// full decoded shape (array element, tuple elements, map key/value, and the
// carried names / unknown reasons) is visible. Used by the type-resolver golden
// (SH-021) to pin type_from_name* decode results across the byte-scan → TypeRef
// migration; a wrong sub-type shows as a differing rendering rather than a silent
// mis-resolution.
pub function type_debug(t: Type): string {
    match (t) {
        TypeI32(x) => { return int_label(x); },
        TypeBool(_) => { return "bool"; },
        TypeString(_) => { return "string"; },
        TypeFloat(_) => { return "f64"; },
        TypeArray(a) => { return "array<" + type_debug(a.elem) + ">"; },
        TypeStruct(st) => { return "struct:" + st.name; },
        TypeTuple(tp) => {
            var out: string = "tuple<";
            var i: i32 = 0;
            while (i < tp.elements.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + type_debug(tp.elements[i]);
                i = i + 1;
            }
            return out + ">";
        },
        TypeFunc(f) => { return "fn"; },
        TypeMap(m) => { return "map<" + type_debug(m.key) + ", " + type_debug(m.value) + ">"; },
        TypeUnion(u) => { return "union:" + u.name; },
        TypeDyn(d) => { return "dyn:" + d.traits; },
        TypeUnknown(uk) => { return "unknown(" + uk.reason + ")"; }
    }
    return "?";
}

// type_eq: structural equality on the type union. Returns true
// only for matching variants; mismatched variants and Unknown
// on either side return false (Unknown is a "couldn't resolve"
// marker, not a wildcard).
function type_eq(a: Type, b: Type): boolean {
    match (a) {
        TypeI32(_) => {
            match (b) {
                TypeI32(_) => { return true; },
                _ => { return false; }
            }
        },
        TypeBool(_) => {
            match (b) {
                TypeBool(_) => { return true; },
                _ => { return false; }
            }
        },
        TypeString(_) => {
            match (b) {
                TypeString(_) => { return true; },
                _ => { return false; }
            }
        },
        TypeFloat(_) => {
            match (b) {
                TypeFloat(_) => { return true; },
                _ => { return false; }
            }
        },
        TypeArray(ae) => {
            match (b) {
                TypeArray(be) => { return type_eq(ae.elem, be.elem); },
                _ => { return false; }
            }
        },
        TypeStruct(an) => {
            match (b) {
                TypeStruct(bn) => { return an.name == bn.name; },
                _ => { return false; }
            }
        },
        TypeTuple(at) => {
            match (b) {
                TypeTuple(bt) => {
                    if (at.elements.len() != bt.elements.len()) { return false; }
                    var i: i32 = 0;
                    while (i < at.elements.len()) {
                        if (!type_eq(at.elements[i], bt.elements[i])) { return false; }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        TypeFunc(af) => {
            match (b) {
                TypeFunc(bf) => {
                    if (af.param_types.len() != bf.param_types.len()) { return false; }
                    if (!type_eq(af.ret_type, bf.ret_type)) { return false; }
                    var fi: i32 = 0;
                    while (fi < af.param_types.len()) {
                        if (!type_eq(af.param_types[fi], bf.param_types[fi])) { return false; }
                        fi = fi + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        TypeMap(am) => {
            match (b) {
                TypeMap(bm) => {
                    return type_eq(am.key, bm.key) && type_eq(am.value, bm.value);
                },
                _ => { return false; }
            }
        },
        TypeUnion(an) => {
            match (b) {
                TypeUnion(bn) => { return an.name == bn.name; },
                _ => { return false; }
            }
        },
        TypeDyn(ad) => {
            match (b) {
                TypeDyn(bd) => { return ad.traits == bd.traits; },
                _ => { return false; }
            }
        },
        TypeUnknown(_) => { return false; }
    }
    return false;
}

function is_unknown(t: Type): boolean {
    match (t) {
        TypeUnknown(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// type_contains_unknown reports whether `t` is unknown or has any unknown
// component anywhere in its shape — an array whose element, a tuple whose
// member, a map whose key/value, a struct whose instantiation arg, or a
// function whose param/return is unknown. In this partial type system a
// generic struct's type parameters erase to unknown when its field types are
// collected, so a field spelled with a type parameter — bare (`v: T` →
// unknown) OR nested (`items: T[]` → array<unknown>, `kv: (K, V)` →
// tuple<unknown, unknown>) — leaves an unknown somewhere in the collected
// field type. Constructing such a field can't be verified (the arg's concrete
// type isn't tracked at collect time), so the struct-literal check skips it,
// exactly as the bare-`T` case did before this generalisation (#4346 piece 2).
function type_contains_unknown(t: Type): boolean {
    match (t) {
        TypeUnknown(_) => { return true; },
        TypeArray(ae) => { return type_contains_unknown(ae.elem); },
        TypeTuple(tt) => {
            var i: i32 = 0;
            while (i < tt.elements.len()) {
                if (type_contains_unknown(tt.elements[i])) { return true; }
                i = i + 1;
            }
            return false;
        },
        TypeMap(m) => { return type_contains_unknown(m.key) || type_contains_unknown(m.value); },
        TypeStruct(sn) => {
            var j: i32 = 0;
            while (j < sn.args.len()) {
                if (type_contains_unknown(sn.args[j])) { return true; }
                j = j + 1;
            }
            return false;
        },
        TypeFunc(f) => {
            if (type_contains_unknown(f.ret_type)) { return true; }
            var k: i32 = 0;
            while (k < f.param_types.len()) {
                if (type_contains_unknown(f.param_types[k])) { return true; }
                k = k + 1;
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// is_composite_type reports whether `t` is a struct / enum (union) /
// array / tuple — a heap value whose `==` would otherwise mean
// pointer identity. The native compiler routes composite `==` to the
// type's structural `Eq` impl; the self-host compiler has no trait /
// derive support yet, so it rejects composite `==` (matching the
// native E041 the way the scalar-mismatch case already does) rather
// than silently comparing heap pointers.
function is_composite_type(t: Type): boolean {
    match (t) {
        TypeStruct(_) => { return true; },
        TypeUnion(_) => { return true; },
        TypeArray(_) => { return true; },
        TypeTuple(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// is_primitive_type reports whether t is one of the scalar primitives
// (i32 / bool / string / f64). Used by the E034 array-element check to
// stay conservative — it only compares element types when both are
// primitives, leaving struct / enum / array / tuple unification (which
// the Go checker widens through unions) untouched.
function is_primitive_type(t: Type): boolean {
    match (t) {
        TypeI32(_) => { return true; },
        TypeBool(_) => { return true; },
        TypeString(_) => { return true; },
        TypeFloat(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// as_cast_allowed decides whether `src as tgt` is a legal cast for the
// scalar types the self-host models (i32 / f64 / bool / string), mirroring
// the Go checker's E033 rule over those types: identity, numeric↔numeric
// (i32 / f64), and the string↔i32 data-pointer hop (either direction) are
// allowed; everything else (any bool↔non-bool, f64↔string) is rejected.
// Callers guard with `is_primitive_type` on both sides, so struct / array
// pointer hops and wider-int targets are never reached here.
function as_cast_allowed(src: Type, tgt: Type): boolean {
    if (type_eq(src, tgt)) { return true; }
    var src_num: boolean = type_eq(src, t_i32()) || type_eq(src, t_float());
    var tgt_num: boolean = type_eq(tgt, t_i32()) || type_eq(tgt, t_float());
    if (src_num && tgt_num) { return true; }
    if (type_eq(src, t_string()) && type_eq(tgt, t_i32())) { return true; }
    if (type_eq(src, t_i32()) && type_eq(tgt, t_string())) { return true; }
    return false;
}

// type_from_name accepts an optional `[]` suffix on the type
// name string (the parser currently only captures the first
// token, but a future extension that captures `i32[]` should
// flow through here cleanly). For now bare names only.

// =================== SCOPE ====================

// Function signature table entry — captured once per FuncDecl in
// the module, then read at every ExprCall site. ret_type is a
// Type (post type-name resolution); param_types parallels the
// FuncDecl's params in declaration order.
// param_bound runs PARALLEL to param_types: param_bound[i] holds the
// `+`-joined trait bound(s) when parameter i's declared type is exactly a
// bounded type parameter (`x: T` where `T: Tr`), else "". Drives the E021
// generic-bound conformance check at call sites (#4842) — see call_diags.
pub struct FuncSig { name: string, param_types: Type[], ret_type: Type, type_param_count: i32, param_bound: string[], ret_type_name: string, param_type_names: string[] }

// StructSig: nominal handle for a declared struct. Parallel
// arrays describe the field list in declaration order: each
// index i holds (field_names[i], field_types[i]).
pub struct StructSig { name: string, field_names: string[], field_types: Type[], type_params: string[], field_type_names: string[] }

// MethodSig: nominal handle for a declared receiver method
// `function (recv: RecvType) name(p1, p2): RT`. The receiver
// is implicit at the call site (`obj.name(a, b)`) so it's
// stored separately from param_types. Plain functions live
// in the FuncSig table; the two tables don't overlap.
pub struct MethodSig { name: string, receiver_type: string, param_types: Type[], ret_type: Type, ret_type_name: string }

// UnionSig: nominal handle for a declared type alias —
// `pub type Shape = Circle | Square`. Variants are captured
// as bare type-name strings; variant resolution lives in
// type_assignable, which walks the variant list at use sites.
pub struct UnionSig { name: string, variants: string[] }

// A flat name → type map plus the function signature table
// plus the struct-decl table plus the union-alias table.
// Parallel arrays keep the implementation trivial.
pub struct Scope {
    names: string[],
    types: Type[],
    sigs: FuncSig[],
    structs: StructSig[],
    unions: UnionSig[],
    methods: MethodSig[],
    // loop_depth tracks nesting depth for break / continue
    // validation. Incremented inside StmtWhile / StmtFor
    // bodies. break / continue at depth 0 surface t_unknown.
    loop_depth: i32,
    // ret_type is the declared return type of the enclosing
    // function body. Populated by check_func_body before walking
    // stmts; StmtReturn compares its value type against this
    // to catch return-type mismatches. TypeUnknown means
    // "no enclosing function" (top-level stmts) — returns there
    // skip the check.
    ret_type: Type,
    // impls / trait_reqs carry the module's `impl … for …` table and its
    // trait requirement records, populated (via with_impls) only on the
    // scope used for the call-diagnostic walk. They drive the E021
    // generic-bound conformance check at call sites (#4842): a bounded
    // type param `T: Tr` whose call-site argument type neither has an
    // `impl Tr` nor provides Tr's required methods (e.g. via @derive) is
    // flagged. Empty on every other scope (the check no-ops).
    impls: parser.ImplInfo[],
    trait_reqs: parser.TraitReq[]
}

function new_scope(): Scope {
    var ns: string[] = [];
    var ts: Type[] = [];
    var fs: FuncSig[] = [];
    var ss: StructSig[] = [];
    var us: UnionSig[] = [];
    var ms: MethodSig[] = [];
    return Scope { names: ns, types: ts, sigs: fs, structs: ss, unions: us, methods: ms, loop_depth: 0, ret_type: t_unknown("no enclosing function"), impls: [], trait_reqs: [] };
}

function new_scope_with_sigs(sigs: FuncSig[]): Scope {
    var ns: string[] = [];
    var ts: Type[] = [];
    var ss: StructSig[] = [];
    var us: UnionSig[] = [];
    var ms: MethodSig[] = [];
    return Scope { names: ns, types: ts, sigs: sigs, structs: ss, unions: us, methods: ms, loop_depth: 0, ret_type: t_unknown("no enclosing function"), impls: [], trait_reqs: [] };
}

function new_scope_with_sigs_structs(sigs: FuncSig[], structs: StructSig[]): Scope {
    var ns: string[] = [];
    var ts: Type[] = [];
    var us: UnionSig[] = [];
    var ms: MethodSig[] = [];
    return Scope { names: ns, types: ts, sigs: sigs, structs: structs, unions: us, methods: ms, loop_depth: 0, ret_type: t_unknown("no enclosing function"), impls: [], trait_reqs: [] };
}

function new_scope_with_sigs_structs_unions(sigs: FuncSig[], structs: StructSig[], unions: UnionSig[]): Scope {
    var ns: string[] = [];
    var ts: Type[] = [];
    var ms: MethodSig[] = [];
    return Scope { names: ns, types: ts, sigs: sigs, structs: structs, unions: unions, methods: ms, loop_depth: 0, ret_type: t_unknown("no enclosing function"), impls: [], trait_reqs: [] };
}

function new_scope_full(sigs: FuncSig[], structs: StructSig[], unions: UnionSig[], methods: MethodSig[]): Scope {
    var ns: string[] = [];
    var ts: Type[] = [];
    return Scope { names: ns, types: ts, sigs: sigs, structs: structs, unions: unions, methods: methods, loop_depth: 0, ret_type: t_unknown("no enclosing function"), impls: [], trait_reqs: [] };
}

function (s: Scope) bind(name: string, t: Type): Scope {
    var ns: string[] = s.names.append(name);
    var ts: Type[] = s.types.append(t);
    return Scope { names: ns, types: ts, sigs: s.sigs, structs: s.structs, unions: s.unions, methods: s.methods, loop_depth: s.loop_depth, ret_type: s.ret_type, impls: s.impls, trait_reqs: s.trait_reqs };
}
// with_impls attaches the module's impl table + trait requirement records
// to a scope so call_diags can run the E021 generic-bound conformance
// check (#4842). Applied to the func-body scope in check_module.
function (s: Scope) with_impls(impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
    return Scope { names: s.names, types: s.types, sigs: s.sigs, structs: s.structs, unions: s.unions, methods: s.methods, loop_depth: s.loop_depth, ret_type: s.ret_type, impls: impls, trait_reqs: trait_reqs };
}

// defines reports whether `name` is bound in scope (param, receiver,
// local var, loop variable, or match-payload binding) — distinct from
// `lookup`, which returns the bound type and can't tell "not in scope"
// apart from "in scope with an unknown type". E001 (undefined name) needs
// the membership test, not the type.
function (s: Scope) defines(name: string): boolean {
    var i: i32 = s.names.len() - 1;
    while (i >= 0) {
        if (s.names[i] == name) { return true; }
        i = i - 1;
    }
    return false;
}

// name_has_comma reports whether a binding name encodes multiple names
// (a `for (k, v)` loop var or a `var (a, b)` destructure).
function name_has_comma(name: string): boolean {
    var i: i32 = 0;
    while (i < name.len()) { if (name[i] == 44) { return true; } i = i + 1; }
    return false;
}

// bind_names binds one or more variable names into the scope. A `for
// (k, v) in m` loop variable and a `var (a, b) = …` tuple destructure are
// both encoded by the parser as a single comma-joined name ("k,v" /
// "a,b"); split on the comma and bind each. Types are unknown here (the
// E001 membership check only needs the names to be in scope).
function bind_names(s: Scope, name: string): Scope {
    var start: i32 = 0;
    var i: i32 = 0;
    var out: Scope = s;
    while (i <= name.len()) {
        if (i == name.len() || name[i] == 44) {
            if (i > start) { out = out.bind(name[start:i], t_unknown("binding")); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// is_builtin_variant reports whether `name` is a variant of an enum the
// front-end auto-injects (Option / Result, plus JsonValue / IoError via
// parser.inject_builtin_enums) — these can be referenced bare (e.g.
// `return None;`) without a local declaration, so E001 must not flag them.
// Derived from the single variant→enum table in mx_builtin_enum_of so the
// builtin-variant list lives in exactly one place (SH-046).
function is_builtin_variant(name: string): boolean {
    return mx_builtin_enum_of(name).len() > 0;
}

// is_reserved_enum_name reports whether `name` is one of the enums the
// front-end injects as built-ins (see checker.go's builtinEnumDecls). A
// user `enum` declaration shadowing one of these is E010.
function is_reserved_enum_name(name: string): boolean {
    return name == "Option" || name == "Result" || name == "IoError" || name == "JsonValue";
}

// variant_in_unions reports whether `name` is a variant of ANY declared
// enum/union in scope.
function variant_in_unions(name: string, unions: UnionSig[]): boolean {
    var i: i32 = 0;
    while (i < unions.len()) {
        if (util.has_str(unions[i].variants, name)) { return true; }
        i = i + 1;
    }
    return false;
}

// is_nopayload_builtin_variant reports whether `name` is a NO-payload variant
// of a front-end-injected builtin enum — the only builtin variants that appear
// bare as a value (`None`, `JNull`, and every `IoError` variant). The payload
// builtins (`Some` / `Ok` / `Err` / the `J*` data variants) instead appear as
// constructor CALLS (`Some(3)`), handled in check_call_expr; resolving them
// bare would mistype a `Some(3)` callee as a value and trip a "calling
// non-function value" E038 (#4346 piece 2).
function is_nopayload_builtin_variant(name: string): boolean {
    if (name == "None") { return true; }
    if (name == "JNull") { return true; }
    if (name == "NotFound" || name == "PermissionDenied" || name == "AlreadyExists" || name == "InvalidUtf8" || name == "Interrupted" || name == "Unsupported" || name == "Other") { return true; }
    return false;
}

// union_of_variant returns the name of the first declared enum/union in scope
// that lists `name` as a variant, or "" when none does. Used by check_expr to
// type a bare no-payload enum variant used as a value (#4346 piece 2).
function union_of_variant(name: string, unions: UnionSig[]): string {
    var i: i32 = 0;
    while (i < unions.len()) {
        if (util.has_str(unions[i].variants, name)) { return unions[i].name; }
        i = i + 1;
    }
    return "";
}

// is_resolvable_value reports whether a bare identifier in VALUE position
// resolves to something defined: a local / param / loop / match binding, a
// free function or 0-arg const (used as a value), an enum/union variant
// (declared or builtin), or a struct name. Anything else is E001. Builtin
// FUNCTIONS (print / read_file / …) are only ever called, never read as a
// bare value, so they don't need to be listed here — call callees are
// checked separately (and aren't flagged by this value-position pass).
function is_resolvable_value(name: string, s: Scope): boolean {
    if (s.defines(name)) { return true; }
    if (s.lookup_sig(name).name.len() > 0) { return true; }
    if (variant_in_unions(name, s.unions)) { return true; }
    if (is_builtin_variant(name)) { return true; }
    // A bare STRUCT type name is NOT a value — `return P` / `var x = P` for a
    // standalone struct P is E001 in the Go checker (you construct with the
    // `P { … }` literal, an ExprStructLit, which never reaches here). Union
    // members and enum-variant constructors are caught above by
    // variant_in_unions / is_builtin_variant, so dropping the struct-name case
    // only rejects pure type names — matching Go, with no new false positive
    // (Go flags the same bare names). Struct CALLS (none exist — there's no
    // `P(...)` form) go through is_resolvable_callee, which never consulted
    // lookup_struct either.
    // A function — user or builtin — may also be referenced as a bare
    // value (e.g. `var w = write;` or passing a function by name).
    if (name.len() >= 2 && name[0:2] == "__") { return true; }
    if (is_builtin_function(name)) { return true; }
    return false;
}

// is_builtin_function reports whether `name` is a compiler builtin that can
// be called without a declaration — the front-end's intrinsics + runtime
// helpers. Used by the call-callee E001 check. Runtime intrinsics are all
// `__`-prefixed (handled by the caller's prefix test); this is the
// user-facing / lowered-helper set, a superset of the Go checker's
// FuncSigs builtins and the self-host emitter's dispatched names.
// Over-inclusion is safe (it only suppresses E001 for that name), so the
// list errs toward completeness.
function builtin_function_names(): string[] {
    return [
        // I/O + process + environment
        "print", "write", "eprint", "print_int", "eprint_int", "putchar",
        "exit", "args", "arg_at", "args_count", "env", "subprocess",
        // stdin / readers
        "stdin", "stdout", "stderr", "read_line", "read_int", "read_all_stdin",
        "open_reader", "open_writer", "open_appender",
        // filesystem
        "read_file", "write_file", "read_dir", "remove_dir_all", "remove_file",
        "stat", "temp_dir",
        // clocks + randomness + sleep + reactor readiness
        "now_unix_ms", "now_ns", "monotonic_ns", "sleep_ms", "random_bytes",
        "random_i32", "poll", "timer_fd", "wasm_timer_pollable",
        "wasm_pollable_drop", "wasm_block", "wasm_poll",
        // maps + string builder + bytes + the free-function `len(a)` form.
        // (`len` is a self-host emitter builtin — the self-host accepts both
        // `a.len()` and `len(a)`. The Go checker only accepts `a.len()` and
        // reports E001 on `len(a)`, so this is a deliberate leniency vs Go,
        // like the `bool`/`boolean` one; not differentially tested.)
        "map_new", "map_new_i32", "strbuf_append", "strbuf_reset",
        "strbuf_take", "string_from_bytes", "chr", "len",
        // Cell[T] constructor (docs/CELL-TYPE-PLAN.md): cell_new(v) is a
        // front-end builtin (like map_new); get/set are method calls, not
        // bare names, so only the constructor needs the E001 suppression.
        "cell_new",
        // float / int bit reinterprets
        "f64_bits", "f64_from_bits", "f32_bits", "f32_from_bits",
        // networking
        "tcp_listen", "tcp_accept", "tcp_recv", "tcp_send", "tcp_close",
        "udp_send", "tcp_connect", "tcp_pollable"
    ];
}

function is_builtin_function(name: string): boolean {
    return util.index_of_str(builtin_function_names(), name) >= 0;
}

// is_resolvable_callee reports whether a bare-identifier CALL target
// resolves: a local (closure value), a free function, a variant
// constructor (declared or builtin), a runtime intrinsic (`__`-prefixed),
// or a builtin function. Anything else is an undefined call → E001.
function is_resolvable_callee(name: string, s: Scope): boolean {
    if (s.defines(name)) { return true; }
    if (s.lookup_sig(name).name.len() > 0) { return true; }
    if (variant_in_unions(name, s.unions)) { return true; }
    if (is_builtin_variant(name)) { return true; }
    if (name.len() >= 2 && name[0:2] == "__") { return true; }
    if (is_builtin_function(name)) { return true; }
    return false;
}

// for_iter_is_range reports whether a for-loop iter is the synthetic
// `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call the parser emits
// for `for i in LOW..HIGH` / `for i in LOW..=HIGH`. The checker uses it
// to bind the loop var to i32; irlower carries its own copy (different
// module) to drive the counted-loop lowering (half-open vs closed).
function for_iter_is_range(iter: parser.Expr): boolean {
    match (iter) {
        parser.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "__range" || id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

function (s: Scope) enter_loop(): Scope {
    return Scope { names: s.names, types: s.types, sigs: s.sigs, structs: s.structs, unions: s.unions, methods: s.methods, loop_depth: s.loop_depth + 1, ret_type: s.ret_type, impls: s.impls, trait_reqs: s.trait_reqs };
}

function (s: Scope) with_ret_type(rt: Type): Scope {
    return Scope { names: s.names, types: s.types, sigs: s.sigs, structs: s.structs, unions: s.unions, methods: s.methods, loop_depth: s.loop_depth, ret_type: rt, impls: s.impls, trait_reqs: s.trait_reqs };
}

// Linear scan — newest binding wins so shadowing works
// naturally in a single flat scope.
function (s: Scope) lookup(name: string): Type {
    var i: i32 = s.names.len() - 1;
    while (i >= 0) {
        if (s.names[i] == name) { return s.types[i]; }
        i = i - 1;
    }
    return t_unknown("undefined identifier:" + name);
}

function (s: Scope) lookup_sig(name: string): FuncSig {
    var i: i32 = 0;
    while (i < s.sigs.len()) {
        if (s.sigs[i].name == name) { return s.sigs[i]; }
        i = i + 1;
    }
    // Sentinel: empty name + empty param list + unknown ret_type
    // tells callers the name isn't a function.
    var empty: Type[] = [];
    var nob: string[] = [];
    var non: string[] = [];
    return FuncSig { name: "", param_types: empty, ret_type: t_unknown("undefined function:" + name), type_param_count: 0, param_bound: nob, ret_type_name: "", param_type_names: non };
}

// tp_bound_for returns the `+`-joined trait bound(s) on the type parameter
// a parameter's declared type names, when that type is EXACTLY a bare
// bounded type param (`x: T` with `T: Tr`), else "". type_params and
// bound_traits run parallel (parser.parse_func_decl); a promoted unbounded
// param has an empty bound_traits entry and yields "". Conservative by
// design — anything but a bare `T` (e.g. `T[]`, `Box[T]`) yields "" and is
// not conformance-checked, so the call-site check (#4842) never fires on a
// shape whose concrete type argument it can't read directly.
function tp_bound_for(ptype: string, type_params: string[], bound_traits: string[]): string {
    var k: i32 = 0;
    while (k < type_params.len()) {
        if (type_params[k] == ptype) {
            if (k < bound_traits.len()) { return bound_traits[k]; }
            return "";
        }
        k = k + 1;
    }
    return "";
}

// e021_trait_idx returns the index of trait `tr`'s requirement record in
// trait_reqs, or -1 if `tr` names no trait declared in this module. The
// E021 call-site conformance check (#4842) gates on a hit so a bound whose
// trait name doesn't resolve here (e.g. an import-qualified spelling that
// never matched a local trait) is skipped rather than mis-flagged.
function e021_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
    var i: i32 = 0;
    while (i < trait_reqs.len()) {
        if (trait_reqs[i].trait_name == tr) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// e021_conforms decides whether concrete type `cty` satisfies trait bound
// `tr` — the parity-faithful conformance test. True when the module has an
// explicit `impl tr for cty`, OR `cty` provides every required (abstract)
// method of `tr` as a receiver method. The method-set arm captures
// @derive(tr) — which synthesises exactly those methods — the same way the
// native checker treats a derived impl as conformance. Biased toward TRUE
// (a trait with no required methods relies solely on the explicit impl),
// so it never flags a type the native checker would accept.
function e021_conforms(s: Scope, tr: string, treq_idx: i32, cty: string): boolean {
    if (e021_scope_has_impl(s.impls, tr, cty)) { return true; }
    var reqs: string[] = s.trait_reqs[treq_idx].methods;
    if (reqs.len() == 0) { return false; }
    var mi: i32 = 0;
    while (mi < reqs.len()) {
        if (s.lookup_method(reqs[mi], cty).name.len() == 0) { return false; }
        mi = mi + 1;
    }
    return true;
}

// e021_type_known reports whether `cty` is a type this module knows well
// enough to reason about conformance for: a primitive, or a declared
// struct / enum (union) name. The check stays silent on anything else,
// keeping it from firing on an opaque or externally-defined type.
function e021_type_known(cty: string, at: Type, s: Scope): boolean {
    if (is_primitive_type(at)) { return true; }
    var i: i32 = 0;
    while (i < s.structs.len()) { if (s.structs[i].name == cty) { return true; } i = i + 1; }
    var j: i32 = 0;
    while (j < s.unions.len()) { if (s.unions[j].name == cty) { return true; } j = j + 1; }
    return false;
}

// e021_scope_has_impl is the scope-carried analogue of e021_has_impl: does
// the module contain `impl <trait_name> for <impl_type>`?
function e021_scope_has_impl(impls: parser.ImplInfo[], trait_name: string, impl_type: string): boolean {
    var i: i32 = 0;
    while (i < impls.len()) {
        if (impls[i].trait_name == trait_name && impls[i].impl_type == impl_type) { return true; }
        i = i + 1;
    }
    return false;
}

// e021_bound_call_diag emits E021 for a generic-bound conformance failure
// at a call site (#4842): parameter `x: T` with `T: Tr` (pbound is the
// `+`-joined bound list) whose call-site argument has concrete type `at`
// that does not conform to Tr (no `impl Tr` and not @derive-provided).
// Conservative gates (declared trait, known concrete type, bare-name
// argument, method-set conformance) keep it from false-firing on the
// self-host bundle's own pervasive bounded-generic calls, which all carry
// their impls or derives. Mirrors native checker.go's call-site E021 arm.
function e021_bound_call_diag(pbound: string, at: Type, s: Scope, ln: i32, cl: i32): Diag[] {
    var out: Diag[] = [];
    var cty: string = type_label(at);
    if (cty.len() == 0) { return out; }
    // A composite label (`Foo[]`, tuple/fn/map) can't be a bare type
    // argument we look up an impl for — skip.
    var bi: i32 = 0;
    while (bi < cty.len()) { if (cty[bi] == 91) { return out; } bi = bi + 1; }
    if (!e021_type_known(cty, at, s)) { return out; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= pbound.len()) {
        if (i == pbound.len() || pbound[i] == 43) {
            if (i > start) {
                var tr: str = pbound[start:i];
                var tidx: i32 = e021_trait_idx(tr, s.trait_reqs);
                if (tidx >= 0 && !e021_conforms(s, tr, tidx, cty)) {
                    out = out.append(dg_at("E021", "type argument " + cty + " does not implement trait " + tr, ln, cl));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// has_array_method reports whether an auto-discovered std/array method
// `__method_Array_<field>` is in scope. The function is in scope only when
// std/array is imported; the bundler (flatten.bundle) mangles it to
// `<mod>__` + `__method_Array_<field>`, so the in-scope sig is either the bare
// convention name (the native modload path, which keeps `__method_` bare) or a
// mangled name ENDING in it. Match both so the array-method-existence check
// resolves an imported method whichever loader built the table.
function (s: Scope) has_array_method(field: string): boolean {
    var target: string = "__method_Array_" + field;
    var tn: i32 = target.len();
    var i: i32 = 0;
    while (i < s.sigs.len()) {
        var nm: string = s.sigs[i].name;
        if (nm == target) { return true; }
        if (nm.len() > tn && nm[nm.len() - tn : nm.len()] == target) { return true; }
        i = i + 1;
    }
    return false;
}

// try_array_method_type resolves the result type of an array method call
// `a.<field>(...)` where `a` is an array. The std/array helpers are free
// functions named `__method_Array_<field>` (or the `<mod>__`-mangled form
// the bundler emits, which still ends in that convention name), discovered
// the same suffix-matching way has_array_method finds them. Returns the
// helper's declared return type, or t_unknown when no such helper is in
// scope — at which point check_call_expr falls through to its normal
// "receiver isn't a typed value" handling so a genuine unknown array
// method still surfaces as unknown rather than a wrong concrete type.
// `append` / `with` are the built-in array growers and return the array
// itself (the receiver type), short-circuited ahead of the sig scan.
function (s: Scope) array_method_ret_type(recv_ty: Type, field: string): Type {
    match (recv_ty) {
        TypeArray(_) => {
            if (field == "append" || field == "with") { return recv_ty; }
            var target: string = "__method_Array_" + field;
            var tn: i32 = target.len();
            var i: i32 = 0;
            while (i < s.sigs.len()) {
                var nm: string = s.sigs[i].name;
                if (nm == target) { return s.sigs[i].ret_type; }
                if (nm.len() > tn && nm[nm.len() - tn : nm.len()] == target) { return s.sigs[i].ret_type; }
                i = i + 1;
            }
            return t_unknown("no array method `" + field + "`");
        },
        _ => { return t_unknown("array_method_ret_type: receiver isn't an array"); }
    }
}

function (s: Scope) lookup_struct(name: string): StructSig {
    var i: i32 = 0;
    while (i < s.structs.len()) {
        if (s.structs[i].name == name) { return s.structs[i]; }
        i = i + 1;
    }
    // Sentinel: empty name signals "no such struct".
    var empty_n: string[] = [];
    var empty_t: Type[] = [];
    var empty_tp: string[] = [];
    var empty_ftn: string[] = [];
    return StructSig { name: "", field_names: empty_n, field_types: empty_t, type_params: empty_tp, field_type_names: empty_ftn };
}

// field_index returns the index of `name` in a struct sig's field list,
// or -1 when absent. Used by the E043 field-value-type check to line a
// provided field up with its declared type.
function field_index(ssig: StructSig, name: string): i32 {
    var i: i32 = 0;
    while (i < ssig.field_names.len()) {
        if (ssig.field_names[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// variant_binding_type returns the type to bind a variant pattern's
// payload name to. A payload-bearing ENUM variant `V(T)` is lowered (in
// the parser) to a struct `V` carrying a single marker field `__ev: T`, so
// the pattern `V(n)` binds the PAYLOAD value of type T — read T off the
// `__ev` field, NOT the wrapper struct. (Binding it as `t_struct("V")`
// false-positived E038 when the payload was passed to a typed function,
// and E003 on assignment to it.) A struct-union member `type U = A | B` is
// a genuine user struct with no `__ev` marker, so its binding is the whole
// struct — `t_struct(name)`, matching the Go checker.
//
// A built-in payload variant (`Some` / `Ok` / `Err` and the payload
// `JsonValue` variants) has NO struct sig at all: its inner type isn't
// recoverable here because a built-in generic enum resolves name-only
// (`Option[i32]` → the bare union `Option`, dropping the i32 — see
// type_from_ref_su). Binding such a payload as `t_struct("Some")` mis-typed
// it as the variant WRAPPER, which spuriously tripped E003 on a downstream
// `x = <payload>` (e.g. `match (n.checked_mul(b)) { Some(v) => { r = v; } }`
// where `r` is i32) — #5205. With the payload type unknowable, bind it as
// unknown so those walks skip it, matching the Go checker's practical
// outcome (no spurious diagnostic).
function variant_binding_type(s: Scope, type_name: string): Type {
    var ss: StructSig = s.lookup_struct(type_name);
    if (ss.name.len() == 0) { return t_unknown("built-in variant payload `" + type_name + "`"); }
    var i: i32 = 0;
    while (i < ss.field_names.len()) {
        if (ss.field_names[i] == "__ev") { return ss.field_types[i]; }
        i = i + 1;
    }
    return t_struct(type_name);
}

// variant_payload_type_at returns the type of a variant's idx-th payload —
// field `__ev` (idx 0), `__ev1` (idx 1), `__ev2` (idx 2), … — the multi-payload
// naming variant_payload_count relies on. Falls back to the wrapper struct type
// when the field is absent (a bare / struct-union variant), exactly like
// variant_binding_type (which is the idx==0 case).
function variant_payload_type_at(s: Scope, type_name: string, idx: i32): Type {
    var ss: StructSig = s.lookup_struct(type_name);
    if (ss.name.len() == 0) { return t_unknown("built-in variant payload `" + type_name + "`"); }
    var want: string = "__ev";
    if (idx > 0) { want = "__ev" + util.i32_to_string(idx); }
    var i: i32 = 0;
    while (i < ss.field_names.len()) {
        if (ss.field_names[i] == want) { return ss.field_types[i]; }
        i = i + 1;
    }
    return t_struct(type_name);
}

// bind_variant_payloads brings EVERY payload binding of a matched variant into
// the arm scope `arm`: the first (pv.binding) typed as `__ev`, then each of
// pv.extra_bindings typed as `__ev1`, `__ev2`, … . `look` is the scope carrying
// the struct sigs (the outer/match scope). Bare `_` and empty names stay out of
// scope, each position independently (so `Rect(_, h)` binds only `h`). Before
// this only pv.binding was bound, so a multi-binding payload pattern
// (`Rect(w, h)`) rejected the 2nd+ name as an undefined E001 (#4345).
function bind_variant_payloads(arm: Scope, look: Scope, pv: parser.PatVariant): Scope {
    var sc: Scope = arm;
    if (pv.binding.len() > 0 && pv.binding != "_") {
        sc = sc.bind(pv.binding, variant_binding_type(look, pv.type_name));
    }
    var k: i32 = 0;
    while (k < pv.extra_bindings.len()) {
        var nm: string = pv.extra_bindings[k];
        if (nm.len() > 0 && nm != "_") {
            sc = sc.bind(nm, variant_payload_type_at(look, pv.type_name, k + 1));
        }
        k = k + 1;
    }
    return sc;
}

function (s: Scope) lookup_method(name: string, recv_type: string): MethodSig {
    var i: i32 = 0;
    while (i < s.methods.len()) {
        var rt_match: boolean = s.methods[i].receiver_type == recv_type;
        // A generic receiver method stores its receiver spelling WITH the
        // type parameters (`function (b: Box[T]) get()` → "Box[T]"), but the
        // call site names the base struct ("Box"). Match on the base so an
        // instantiation (`Box[i32]`) dispatches its generic methods — the
        // #4346-piece-2 companion to the generic-method return substitution.
        if (!rt_match && parser.parse_type_ref(s.methods[i].receiver_type).base == recv_type) {
            rt_match = true;
        }
        // `bool` and `boolean` are interchangeable in source —
        // accept either spelling at the call site.
        if (!rt_match && recv_type == "bool" && s.methods[i].receiver_type == "boolean") {
            rt_match = true;
        }
        // Union-receiver methods: a method declared on a union
        // (e.g. `function (sh: Shape) area()`) matches when the
        // receiver is one of the union's variant structs.
        if (!rt_match && is_variant_of(recv_type, s.methods[i].receiver_type, s.unions)) {
            rt_match = true;
        }
        if (s.methods[i].name == name && rt_match) {
            return s.methods[i];
        }
        i = i + 1;
    }
    var empty_pt: Type[] = [];
    return MethodSig { name: "", receiver_type: "", param_types: empty_pt, ret_type: t_unknown("no such method"), ret_type_name: "" };
}

function (s: Scope) lookup_union(name: string): UnionSig {
    var i: i32 = 0;
    while (i < s.unions.len()) {
        if (s.unions[i].name == name) { return s.unions[i]; }
        i = i + 1;
    }
    // Sentinel: empty name signals "no such union".
    var empty_v: string[] = [];
    return UnionSig { name: "", variants: empty_v };
}

// is_variant_of: is the named struct one of the variants of the
// named union? Used by type_assignable to allow a struct value
// to flow into a union-typed slot.
function is_variant_of(struct_name: string, union_name: string, unions: UnionSig[]): boolean {
    var i: i32 = 0;
    while (i < unions.len()) {
        if (unions[i].name == union_name) {
            var j: i32 = 0;
            while (j < unions[i].variants.len()) {
                if (unions[i].variants[j] == struct_name) { return true; }
                j = j + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// type_assignable: is `from` usable where `to` is expected?
// Same as type_eq for primitives + structs + arrays. The
// extra rule is the variant→union widening: a TypeStruct "C"
// is assignable to a TypeUnion "U" iff C appears in U's
// variant list.
function type_assignable(from: Type, to: Type, unions: UnionSig[]): boolean {
    if (type_eq(from, to)) { return true; }
    match (to) {
        TypeArray(te) => {
            match (from) {
                TypeArray(fe) => {
                    // An empty / uninferred array literal types to
                    // `unknown[]`; it flows into any concrete `T[]` slot.
                    // Symmetrically, a generic parameter `T[]` erases to
                    // `unknown[]` on the TO side, so a concrete `string[]`
                    // flows into it — this is what lets a concrete array
                    // argument satisfy a generic array parameter, e.g.
                    // `sort_by(arr, cmp)` with `arr: string[]` against
                    // `sort_by[T](arr: T[], …)` (std/sort delegating its
                    // string sorts to the generic comparator form — #4829).
                    // (Scalar `unknown` is NOT treated as a wildcard — a
                    // genuinely unresolved value should still surface its
                    // assignment error, e.g. `var s: string = badcall()`.)
                    if (is_unknown(fe.elem) || is_unknown(te.elem)) { return true; }
                    return type_assignable(fe.elem, te.elem, unions);
                },
                _ => { return false; }
            }
        },
        TypeTuple(te) => {
            match (from) {
                TypeTuple(fe) => {
                    // Same arity, element-wise assignable. An unknown source
                    // element is a wildcard (mirrors the array / map rule) so a
                    // generic tuple `(T, U)` — whose params erase to `unknown` —
                    // flows into any concrete tuple slot, and a literal whose
                    // element infers `unknown` doesn't false-positive.
                    if (fe.elements.len() != te.elements.len()) { return false; }
                    var i: i32 = 0;
                    while (i < te.elements.len()) {
                        if (!is_unknown(fe.elements[i]) && !type_assignable(fe.elements[i], te.elements[i], unions)) { return false; }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        TypeUnion(un) => {
            match (from) {
                TypeStruct(sn) => { return is_variant_of(sn.name, un.name, unions); },
                _ => { return false; }
            }
        },
        TypeMap(tm) => {
            match (from) {
                TypeMap(fm) => {
                    // `map_new[_i32](n)` (the desugar of a `Map { … }` literal,
                    // including the empty `Map {}`) types to a map with
                    // `unknown` key / value — the self-host doesn't infer
                    // K / V from a literal's entries — so an unknown side is a
                    // wildcard that flows into any concrete `Map[K, V]` slot
                    // (mirroring the empty-array rule above). A concrete side
                    // must be assignable.
                    var kok: boolean = is_unknown(fm.key) || type_assignable(fm.key, tm.key, unions);
                    var vok: boolean = is_unknown(fm.value) || type_assignable(fm.value, tm.value, unions);
                    return kok && vok;
                },
                _ => { return false; }
            }
        },
        TypeDyn(_) => {
            // Any value may be coerced into a `dyn Trait` slot — the concrete
            // Self isn't tracked here, so conformance is left to the coded
            // E021/E059/E060 passes (which key off the annotation text). An
            // `unknown` source (e.g. a not-yet-typed dyn method call) is also
            // accepted so it can't false-positive. Mirrors how a generic
            // parameter accepts any argument (#4346 piece 2, dyn Trait).
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// type_from_name resolves a parser-side bare type-name string to
// a Type. Unrecognised names surface as TypeUnknown so the checker
// can flag bogus signatures without hard-failing the whole check.
// Every type-name resolver below maps i32 / i64 / u32 / u64 to a width-tagged
// TypeI32 (see the struct comment). Before this, the wider widths resolved to
// t_unknown, so a receiver method on one (`function (x: i64) …`) tripped the
// E021 "method receiver references unknown struct" gate, and a call site
// couldn't recover the width to dispatch.
function type_from_name(name: string): Type {
    if (name == "i32") { return t_i32(); }
    if (name == "i64") { return t_i64(); }
    if (name == "u32") { return t_u32(); }
    if (name == "u64") { return t_u64(); }
    if (name == "bool" || name == "boolean") { return t_bool(); }
    if (name == "string") { return t_string(); }
    if (name == "f64" || name == "f32" || name == "float") { return t_float(); }
    return t_unknown("unrecognised type name: " + name);
}

// =================== CHECKER ====================

// check_expr returns the inferred type. Errors surface as
// TypeUnknown with a `reason` string so callers can inspect them
// without an exception channel.
// check_call_expr types an ExprCall (plain / closure / method call).
// Extracted verbatim from check_expr's ExprCall arm to keep check_expr
// under the self-host oversized-function compile threshold (#2720); the
// body is self-contained on c + s.
function check_call_expr(c: parser.ExprCall, s: Scope): Type {
    // A desugared value if/match-expression is a 0-arg call of a
    // 0-param lambda whose single-statement body is a StmtIf / StmtMatch
    // returning each branch's value. Its value type is the branches'
    // common type. Return it (instead of `unknown`) so assignment /
    // return / argument checks see the real type — closing E003/E002
    // on `var x: string = if (…) { 1 } else { 2 }` and the match form.
    // Only when EVERY branch agrees (type_eq); a mixed-type set (e.g. a
    // numeric i32/f64 widening, which the Go checker unifies but this
    // port's type_assignable doesn't) falls back to `unknown` so it
    // can't false-positive. Arm-type *consistency* itself is E031,
    // checked separately.
    if (c.args.len() == 0) {
        match (c.callee) {
            parser.ExprLambda(lm) => {
                if (lm.params.len() == 0 && lm.body.len() == 1) {
                    var bts: Type[] = [];
                    match (lm.body[0]) {
                        parser.StmtIf(f) => { bts = mx_if_branch_types(f, s); },
                        parser.StmtMatch(m) => { bts = mx_match_arm_types(m, s); },
                        _ => { }
                    }
                    if (bts.len() > 0) {
                        var all_same: boolean = true;
                        var bi: i32 = 1;
                        while (bi < bts.len()) {
                            if (!type_eq(bts[bi], bts[0])) { all_same = false; }
                            bi = bi + 1;
                        }
                        if (all_same && !is_unknown(bts[0])) { return bts[0]; }
                    }
                }
            },
            _ => { }
        }
    }
    // Bare-ident callee → plain function call.
    // FieldAccess callee → method call: type-check the
    // receiver, look up the method by (name, recv_type).
    var name: string = "";
    var is_method: boolean = false;
    var recv_type_name: string = "";
    var recv_ty: Type = t_unknown("__noreceiver__");
    match (c.callee) {
        parser.ExprIdent(id) => { name = id.name; },
        parser.ExprFieldAccess(fa) => {
            // Qualified-name call: `Ns.func(…)` resolves
            // to a plain function named "Ns.func" when
            // such a sig exists. Otherwise fall through
            // to method-dispatch semantics.
            var qhandled: boolean = false;
            match (fa.obj) {
                parser.ExprIdent(ns_id) => {
                    var qname: string = ns_id.name + "." + fa.field;
                    var qsig: FuncSig = s.lookup_sig(qname);
                    if (qsig.name.len() > 0) {
                        name = qname;
                        qhandled = true;
                    }
                },
                _ => { }
            }
            if (!qhandled) {
                name = fa.field;
                is_method = true;
                recv_ty = check_expr(fa.obj, s);
                // Array method-syntax dispatch: `a.<field>(...)` on an
                // array resolves to the std/array `__method_Array_<field>`
                // helper's return type (or the built-in append/with growers).
                // Done ahead of the recv_type_name match below because an
                // array receiver has no nominal type-name and would
                // otherwise fall into the `_` "isn't a typed value" arm.
                var arr_mt: Type = s.array_method_ret_type(recv_ty, name);
                if (!is_unknown(arr_mt)) { return arr_mt; }
                // Receiver type-name comes from the receiver
                // expression's static type. Primitive types
                // use their type-keyword spelling so methods
                // declared on them dispatch correctly.
                match (recv_ty) {
                    TypeStruct(sn) => { recv_type_name = sn.name; },
                    TypeString(_) => { recv_type_name = "string"; },
                    TypeI32(it) => { recv_type_name = int_label(it); },
                    TypeBool(_) => { recv_type_name = "bool"; },
                    TypeFloat(_) => { recv_type_name = "f64"; },
                    TypeMap(_) => { recv_type_name = "Map"; },
                    _ => { return t_unknown("method call: receiver isn't a typed value"); }
                }
            }
        },
        _ => { return t_unknown("call target is not an identifier"); }
    }
    // Builtins: `len(x)` returns i32 for any array or
    // string. Checked separately because the sig table
    // doesn't enumerate them.
    if (!is_method && name == "len") {
        if (c.args.len() != 1) { return t_unknown("len takes 1 argument"); }
        var at: Type = check_expr(c.args[0], s);
        match (at) {
            TypeArray(_) => { return t_i32(); },
            TypeString(_) => { return t_i32(); },
            TypeMap(_) => { return t_i32(); },
            _ => { return t_unknown("len: argument must be array, string, or map"); }
        }
        return t_unknown("unreachable len arm");
    }
    // map_new(cap) builtin — returns a TypeMap with
    // TypeUnknown key/value types since the call site
    // has no inference for them. The surrounding
    // type-annotation (e.g. `var m: Map[K, V] = …`)
    // pins them via assignability.
    if (!is_method && name == "map_new") {
        return t_map(t_unknown("map_new key"), t_unknown("map_new value"));
    }
    // cell_new(v) builtin — the Cell[T] constructor
    // (docs/CELL-TYPE-PLAN.md). T is the argument's type; the
    // result is modelled as a nominal `Cell` struct handle. Typing
    // it (rather than leaving it unknown) lets a nested
    // `cell_new(cell_new(x))` see the inner cell as a composite
    // element, which is the E057 case the call-diag walk flags.
    if (!is_method && name == "cell_new") {
        return t_struct("Cell");
    }
    // Built-in VMap method dispatch — handled ahead of
    // the user MethodSig lookup.
    if (is_method) {
        match (recv_ty) {
            TypeMap(mt) => {
                if (name == "insert") {
                    if (c.args.len() != 2) { return t_unknown("map.set: 2 args"); }
                    return recv_ty;
                }
                if (name == "get_or") {
                    if (c.args.len() != 2) { return t_unknown("map.get_or: 2 args"); }
                    return mt.value;
                }
                if (name == "has") {
                    if (c.args.len() != 1) { return t_unknown("map.has: 1 arg"); }
                    return t_bool();
                }
                if (name == "without") {
                    if (c.args.len() != 1) { return t_unknown("map.delete: 1 arg"); }
                    return t_tuple([recv_ty, t_bool()]);
                }
                if (name == "len") {
                    if (c.args.len() != 0) { return t_unknown("map.len: 0 args"); }
                    return t_i32();
                }
                if (name == "keys") { return t_array(mt.key); }
                if (name == "values") { return t_array(mt.value); }
            },
            _ => { }
        }
        var msig: MethodSig = s.lookup_method(name, recv_type_name);
        if (msig.name.len() == 0) {
            return t_unknown("undefined method `" + name + "` on `" + recv_type_name + "`");
        }
        if (c.args.len() != msig.param_types.len()) {
            return t_unknown("arity mismatch calling method `" + name + "`");
        }
        var mi: i32 = 0;
        while (mi < c.args.len()) {
            var mat: Type = check_expr(c.args[mi], s);
            if (!type_assignable(mat, msig.param_types[mi], s.unions)) {
                return t_unknown("arg-type mismatch calling method `" + name + "`");
            }
            mi = mi + 1;
        }
        // Generic-receiver method return substitution (#4346 piece 2): a method
        // whose declared return type names one of the receiver struct's type
        // parameters (`function (b: Box[T]) get(): T`, or a nested `T[]`)
        // resolves that spelling to `unknown` at collect time. When the receiver
        // is a concrete instantiation (`Box[i32]`, carrying args [i32]),
        // substitute the struct's type parameters with those args throughout the
        // return spelling — so `b.get()` is i32, not the erased unknown. Mirrors
        // the field-access substitution; reuses type_from_ref_subst.
        if (type_contains_unknown(msig.ret_type) && msig.ret_type_name.len() > 0) {
            match (recv_ty) {
                TypeStruct(rsn) => {
                    if (rsn.args.len() > 0) {
                        var rssig: StructSig = s.lookup_struct(rsn.name);
                        if (rssig.name.len() > 0 && rssig.type_params.len() > 0) {
                            var rref: parser.TypeRef = parser.parse_type_ref(msig.ret_type_name);
                            return type_from_ref_subst(rref, rssig.type_params, rsn.args, s.structs, s.unions);
                        }
                    }
                },
                _ => { }
            }
        }
        return msig.ret_type;
    }
    // If the ident is bound in scope to a TypeFunc,
    // dispatch as a closure call rather than a plain
    // function lookup. Otherwise fall through to the
    // function-sig table.
    var bound_ty: Type = s.lookup(name);
    match (bound_ty) {
        TypeFunc(tf) => {
            if (c.args.len() != tf.param_types.len()) {
                return t_unknown("arity mismatch calling closure `" + name + "`");
            }
            var ci: i32 = 0;
            while (ci < c.args.len()) {
                var cat: Type = check_expr(c.args[ci], s);
                if (!type_assignable(cat, tf.param_types[ci], s.unions)) {
                    return t_unknown("arg-type mismatch calling closure `" + name + "`");
                }
                ci = ci + 1;
            }
            return tf.ret_type;
        },
        _ => { }
    }
    // Variant constructors (#4346 piece 2): `Some(x)` / `Ok(x)` / `Err(e)`
    // (and a user enum's payload variant `A(x)`) aren't functions — they
    // construct their enum. Type the call to the enum's name-only union so
    // `var o: Option[i32] = Some(3);` type-checks. A DECLARED enum/union in
    // scope wins over the builtin table, so a user enum that reuses a builtin
    // variant name (`enum E { Ok(i32), … }`) types `Ok(1)` as `E`, not
    // `Result`. Arity / payload-type errors remain the province of the
    // dedicated variant diagnostic passes; here we only supply the value type.
    var ctor_user: string = union_of_variant(name, s.unions);
    if (ctor_user.len() > 0) { return t_union(ctor_user); }
    var ctor_enum: string = mx_builtin_enum_of(name);
    if (ctor_enum.len() > 0) { return t_union(ctor_enum); }
    var sig: FuncSig = s.lookup_sig(name);
    if (sig.name.len() == 0) {
        return t_unknown("undefined function: " + name);
    }
    if (c.args.len() != sig.param_types.len()) {
        return t_unknown("arity mismatch calling `" + name + "`");
    }
    var i: i32 = 0;
    while (i < c.args.len()) {
        var at: Type = check_expr(c.args[i], s);
        // An unknown PARAM type is an opaque generic parameter (`f[T](x: T)`,
        // where T erases to unknown) — the arg can't be checked against it, so
        // skip rather than mis-flag a mismatch (mirrors the E038 diag pass,
        // #4346 piece 2). A concrete param is still checked.
        if (!is_unknown(sig.param_types[i]) && !type_assignable(at, sig.param_types[i], s.unions)) {
            return t_unknown("arg-type mismatch calling `" + name + "`");
        }
        i = i + 1;
    }
    // Generic-call return-type inference (#4346 piece 2): a generic function's
    // declared return type erases to unknown here (it names a type parameter).
    // When the return type NAME also names a parameter's type — the pervasive
    // `ident[T](v: T): T`, `first[T, U](a: T, b: U): T` shape — the concrete
    // return is that argument's type. Without this a non-generic caller of a
    // generic function over-rejected on the unknown result (`return ident(3);`).
    // (A return type param that appears only nested — `Option[T]` — or in no
    // parameter isn't inferred here and stays unknown, a further slice.)
    if (sig.type_param_count > 0 && is_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
        var k: i32 = 0;
        while (k < sig.param_type_names.len()) {
            if (sig.param_type_names[k] == sig.ret_type_name && k < c.args.len()) {
                return check_expr(c.args[k], s);
            }
            k = k + 1;
        }
    }
    return sig.ret_type;
}

function check_expr(e: parser.Expr, s: Scope): Type {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return t_float(); }
            return t_i32();
        },
        parser.ExprBool(_) => { return t_bool(); },
        parser.ExprString(_) => { return t_string(); },
        parser.ExprIdent(id) => {
            var bound: Type = s.lookup(id.name);
            if (!is_unknown(bound)) { return bound; }
            // Fallback (#4346 piece 2): a bare no-payload enum variant used as
            // a value types to its enum's union. A local of the same name
            // shadows (handled above by the successful lookup). Payload
            // variants reach the checker as calls (`Some(3)`) / struct
            // literals and carry a backing struct with an `__ev` field, so we
            // resolve ONLY when the variant's struct has ZERO fields — exactly
            // a unit (no-payload) variant like `Red` under
            // `enum Color { Red, Green }`. Builtin Option/Result variants
            // aren't registered as unions here, so they stay unknown (their
            // generic payloads are a separate slice).
            var un: string = union_of_variant(id.name, s.unions);
            if (un.len() > 0 && s.lookup_struct(id.name).field_names.len() == 0) {
                return t_union(un);
            }
            // Builtin no-payload variants (`None`, `JNull`, the IoError set)
            // aren't in the declared-union table but the front-end injects them
            // (#4346 piece 2). Restricted to the no-payload set so a payload
            // builtin (`Some` / `Ok` / …) stays unknown here and is typed at
            // its constructor call in check_call_expr — resolving it bare would
            // mistype a `Some(3)` callee as a value.
            if (is_nopayload_builtin_variant(id.name)) {
                return t_union(mx_builtin_enum_of(id.name));
            }
            return bound;
        },
        parser.ExprBinary(b) => {
            var lt: Type = check_expr(b.left, s);
            var rt: Type = check_expr(b.right, s);
            // `+` is overloaded across i32 (arithmetic) and string
            // (concatenation). Other arithmetic ops are i32-only.
            if (b.op == "+") {
                if (type_eq(lt, t_string()) && type_eq(rt, t_string())) {
                    return t_string();
                }
                if (type_eq(lt, t_i32()) && type_eq(rt, t_i32())) {
                    return t_i32();
                }
                if (type_eq(lt, t_float()) && type_eq(rt, t_float())) {
                    return t_float();
                }
                return t_unknown("`+` operands type mismatch");
            }
            if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
                if (type_eq(lt, t_i32()) && type_eq(rt, t_i32())) {
                    return t_i32();
                }
                // `%` on floats isn't supported — interp surfaces
                // VErr; checker is lenient and just rejects it.
                if (b.op != "%" && type_eq(lt, t_float()) && type_eq(rt, t_float())) {
                    return t_float();
                }
                return t_unknown("arithmetic op `" + b.op + "` requires matching i32 or f64 operands");
            }
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                if (type_eq(lt, t_i32()) && type_eq(rt, t_i32())) {
                    return t_bool();
                }
                if (type_eq(lt, t_float()) && type_eq(rt, t_float())) {
                    return t_bool();
                }
                return t_unknown("comparison op `" + b.op + "` requires matching i32 or f64 operands");
            }
            if (b.op == "==" || b.op == "!=") {
                if (type_eq(lt, rt) && !is_unknown(lt)) {
                    return t_bool();
                }
                return t_unknown("equality op `" + b.op + "` requires same-typed operands");
            }
            if (b.op == "&&" || b.op == "||") {
                if (type_eq(lt, t_bool()) && type_eq(rt, t_bool())) {
                    return t_bool();
                }
                return t_unknown("logical op `" + b.op + "` requires bool operands");
            }
            return t_unknown("unknown binary op:" + b.op);
        },
        parser.ExprUnary(u) => {
            var ot: Type = check_expr(u.operand, s);
            if (u.op == "-") {
                if (type_eq(ot, t_i32())) { return t_i32(); }
                if (type_eq(ot, t_float())) { return t_float(); }
                return t_unknown("unary `-` requires i32 or f64 operand");
            }
            if (u.op == "!") {
                if (type_eq(ot, t_bool())) { return t_bool(); }
                return t_unknown("unary `!` requires bool operand");
            }
            // `x as T` desugars to the unary op `as_<T>`. The result type
            // is the target type (matching the Go checker, which returns
            // n.Target even when the cast is invalid). Unrecognised target
            // names (wider ints u32 / i64 / …) resolve to unknown, which is
            // conservatively accepted downstream.
            if (u.op.len() > 3 && u.op[0:3] == "as_") {
                return type_from_name(u.op[3:u.op.len()]);
            }
            return t_unknown("unknown unary op:" + u.op);
        },
        parser.ExprCall(c) => { return check_call_expr(c, s); },
        parser.ExprTuple(t) => {
            var elems: Type[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) {
                elems = elems.append(check_expr(t.elements[i], s));
                i = i + 1;
            }
            return t_tuple(elems);
        },
        parser.ExprArray(a) => {
            if (a.elements.len() == 0) {
                // Empty literal — element type undecidable at this
                // site. Future improvement: propagate expected
                // type from context.
                return t_array(t_unknown("empty array literal"));
            }
            var first: Type = check_expr(a.elements[0], s);
            var i: i32 = 1;
            while (i < a.elements.len()) {
                var et: Type = check_expr(a.elements[i], s);
                if (!type_eq(et, first)) {
                    return t_unknown("array elements have mixed types");
                }
                i = i + 1;
            }
            return t_array(first);
        },
        parser.ExprIndex(x) => {
            var at: Type = check_expr(x.array, s);
            var it: Type = check_expr(x.index, s);
            if (!type_eq(it, t_i32())) {
                return t_unknown("array index must be i32");
            }
            match (at) {
                TypeArray(ta) => { return ta.elem; },
                // String indexing returns the byte as i32 — same
                // semantics as the production Fern pipeline.
                TypeString(_) => { return t_i32(); },
                _ => { return t_unknown("can only index into an array or string"); }
            }
            return t_unknown("unreachable index arm");
        },
        parser.ExprSlice(sl) => {
            var at: Type = check_expr(sl.array, s);
            var st: Type = check_expr(sl.start, s);
            var et: Type = check_expr(sl.end, s);
            if (!type_eq(st, t_i32())) { return t_unknown("slice start must be i32"); }
            if (!type_eq(et, t_i32())) { return t_unknown("slice end must be i32"); }
            match (at) {
                TypeArray(_) => { return at; },
                TypeString(_) => { return at; },
                _ => { return t_unknown("can only slice array or string"); }
            }
            return t_unknown("unreachable slice arm");
        },
        parser.ExprStructLit(sl) => {
            // Look up the struct decl. Verify the literal's
            // fields cover the declared shape — same field
            // names, in declaration order, with matching types.
            var ssig: StructSig = s.lookup_struct(sl.type_name);
            if (ssig.name.len() == 0) {
                return t_unknown("undefined struct: " + sl.type_name);
            }
            if (sl.has_base) {
                // Struct-update `Name { ...base, f: v }`: the base
                // supplies the un-overridden fields, so completeness
                // and declaration-order are relaxed — a subset of
                // overrides is legal. The base must itself be a value
                // of the same struct type. Each override must name a
                // declared field with a matching type.
                var bt: Type = check_expr(sl.base, s);
                if (!type_eq(bt, t_struct(sl.type_name))) {
                    return t_unknown("struct " + sl.type_name + " update base type mismatch");
                }
                var ui: i32 = 0;
                while (ui < sl.field_names.len()) {
                    var uname: string = sl.field_names[ui];
                    var found: boolean = false;
                    var ufi: i32 = 0;
                    while (ufi < ssig.field_names.len()) {
                        if (ssig.field_names[ufi] == uname) {
                            found = true;
                            var uft: Type = check_expr(sl.field_values[ui], s);
                            // A field whose declared type erases a type
                            // parameter to unknown — bare (`Box[T] { v: T }`) or
                            // nested (`Wrapper[T] { items: T[] }`) — is an
                            // opaque generic field; any value is acceptable, so
                            // skip rather than mis-flag a mismatch (#4346 piece
                            // 2, mirrors the opaque-param skips elsewhere).
                            if (!type_contains_unknown(ssig.field_types[ufi]) && !type_eq(uft, ssig.field_types[ufi])) {
                                return t_unknown("struct " + sl.type_name + " field `" + uname + "` type mismatch");
                            }
                        }
                        ufi = ufi + 1;
                    }
                    if (!found) {
                        return t_unknown("struct " + sl.type_name + " has no field `" + uname + "`");
                    }
                    ui = ui + 1;
                }
                return t_struct(sl.type_name);
            }
            if (sl.field_names.len() != ssig.field_names.len()) {
                return t_unknown("struct " + sl.type_name + " field count mismatch");
            }
            var sli: i32 = 0;
            while (sli < sl.field_names.len()) {
                if (sl.field_names[sli] != ssig.field_names[sli]) {
                    return t_unknown("struct " + sl.type_name + " field name mismatch at index " + sl.field_names[sli]);
                }
                var ft: Type = check_expr(sl.field_values[sli], s);
                // An opaque generic field — bare (`Box[T] { v: T }`, T →
                // unknown) or nested (`items: T[]` → array<unknown>) — accepts
                // any value; skip the check (#4346 piece 2).
                if (!type_contains_unknown(ssig.field_types[sli]) && !type_eq(ft, ssig.field_types[sli])) {
                    return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` type mismatch");
                }
                sli = sli + 1;
            }
            return t_struct(sl.type_name);
        },
        parser.ExprFieldAccess(fa) => {
            var ot: Type = check_expr(fa.obj, s);
            match (ot) {
                TypeStruct(sn) => {
                    var fsig: StructSig = s.lookup_struct(sn.name);
                    if (fsig.name.len() == 0) {
                        return t_unknown("undefined struct: " + sn.name);
                    }
                    var fai: i32 = 0;
                    while (fai < fsig.field_names.len()) {
                        if (fsig.field_names[fai] == fa.field) {
                            // Generic field substitution (#4346 piece 2): when
                            // the receiver carries concrete instantiation args
                            // (`Box[i32]`) substitute the struct's type
                            // parameters with them throughout the field's
                            // declared spelling — so a bare type-param field
                            // (`v: T` → i32), a nested one (`items: T[]` →
                            // i32[], `kv: (K, V)` → (i32, string), `m:
                            // Map[string, T]` → map<string, i32>) all resolve
                            // to the instantiated field type rather than the
                            // erased unknown.
                            if (fai < fsig.field_type_names.len() && fsig.type_params.len() > 0 && sn.args.len() > 0) {
                                var fref: parser.TypeRef = parser.parse_type_ref(fsig.field_type_names[fai]);
                                return type_from_ref_subst(fref, fsig.type_params, sn.args, s.structs, s.unions);
                            }
                            return fsig.field_types[fai];
                        }
                        fai = fai + 1;
                    }
                    return t_unknown("struct " + sn.name + " has no field `" + fa.field + "`");
                },
                TypeTuple(tt) => {
                    // Tuple field is `.0` / `.1` / … — parse the
                    // digit string back to an i32 index.
                    var idx: i32 = digit_string_to_i32(fa.field);
                    if (idx < 0 || idx >= tt.elements.len()) {
                        return t_unknown("tuple index `" + fa.field + "` out of range");
                    }
                    return tt.elements[idx];
                },
                _ => { return t_unknown("can only field-access a struct or tuple"); }
            }
            return t_unknown("unreachable field-access arm");
        },
        parser.ExprLambda(lm) => {
            // Resolve param + ret types through the existing
            // struct + union tables. The body is type-checked
            // in a derived scope where params are bound. Free
            // idents in the body still resolve against the
            // surrounding scope (lexical capture).
            var pts: Type[] = [];
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                pts = pts.append(type_from_name_with_structs_unions(lm.params[pi].type_name, s.structs, s.unions));
                pi = pi + 1;
            }
            var rt: Type = type_from_name_with_structs_unions(lm.ret_type, s.structs, s.unions);
            // Walk the body for side-effect checks. The body's
            // returns are checked against the lambda's own
            // ret_type (when one is declared), not the enclosing
            // function's.
            var body_scope: Scope = s;
            if (lm.ret_type.len() > 0) {
                body_scope = body_scope.with_ret_type(rt);
            } else {
                body_scope = body_scope.with_ret_type(t_unknown("no enclosing function"));
            }
            var bi: i32 = 0;
            while (bi < lm.params.len()) {
                body_scope = body_scope.bind(lm.params[bi].name, pts[bi]);
                bi = bi + 1;
            }
            check_block(lm.body, body_scope);
            return t_func(pts, rt);
        },
        parser.ExprUnknown(u) => { return t_unknown("parser-side unknown:" + u.kind); }
    }
    return t_unknown("unhandled Expr variant");
}

// check_stmt returns the updated scope (StmtVar binds a new name)
// and the inferred type of the contained expression, packaged so
// the validation harness can assert per-statement.
pub struct CheckResult { scope: Scope, ty: Type }

function check_stmt(st: parser.Stmt, s: Scope): CheckResult {
    match (st) {
        // StmtDefer is lowered away before emit; check its action.
        parser.StmtDefer(d) => { return check_stmt(d.action, s); },
        parser.StmtVar(v) => {
            // A local function `function f(...) { ... }` desugars to
            // `var f = function(...) { ... }`; its own name must be in
            // scope within the body so a recursive self-call resolves
            // (matching the Go checker's recursive-local handling, and the
            // hoist pass that lifts it). Bind f to its function type before
            // checking the init. (For a plain non-recursive lambda the
            // binding is simply unused.)
            var init_scope: Scope = s;
            match (v.init) {
                parser.ExprLambda(lm) => {
                    var lpts: Type[] = [];
                    var lpi: i32 = 0;
                    while (lpi < lm.params.len()) {
                        lpts = lpts.append(type_from_name_with_structs_unions(lm.params[lpi].type_name, s.structs, s.unions));
                        lpi = lpi + 1;
                    }
                    var lrt: Type = type_from_name_with_structs_unions(lm.ret_type, s.structs, s.unions);
                    init_scope = s.bind(v.name, t_func(lpts, lrt));
                },
                _ => { }
            }
            var t: Type = check_expr(v.init, init_scope);
            // If the source carries a `: Type` annotation,
            // resolve it via the scope's struct + union tables
            // and use it as the binding's type. The init type
            // must be assignable to the annotation (so a
            // variant value flows into a union slot via the
            // existing type_assignable widening).
            if (v.type_name.len() > 0) {
                var declared: Type = type_from_name_with_structs_unions(v.type_name, s.structs, s.unions);
                if (is_unknown(declared)) {
                    return CheckResult { scope: s.bind(v.name, declared), ty: declared };
                }
                if (!type_assignable(t, declared, s.unions)) {
                    var err: Type = t_unknown("var `" + v.name + "`: init type doesn't match annotation `" + v.type_name + "`");
                    return CheckResult { scope: s.bind(v.name, declared), ty: err };
                }
                return CheckResult { scope: s.bind(v.name, declared), ty: declared };
            }
            var s2: Scope = s.bind(v.name, t);
            return CheckResult { scope: s2, ty: t };
        },
        parser.StmtReturn(r) => {
            var t: Type = check_expr(r.value, s);
            // Compare against the enclosing function's declared
            // ret_type when one is set (top-level stmts have an
            // "no enclosing function" sentinel and skip the
            // check). If the declared ret_type itself is unknown
            // (unresolved type name) we already surfaced that at
            // the FuncSig collection step — skip the comparison
            // to avoid double-reporting.
            match (s.ret_type) {
                TypeUnknown(_) => { return CheckResult { scope: s, ty: t }; },
                _ => { }
            }
            if (is_unknown(t)) {
                return CheckResult { scope: s, ty: t };
            }
            if (!type_assignable(t, s.ret_type, s.unions)) {
                return CheckResult { scope: s, ty: t_unknown("return type doesn't match declaration") };
            }
            return CheckResult { scope: s, ty: t };
        },
        parser.StmtExpr(x) => {
            var t: Type = check_expr(x.value, s);
            return CheckResult { scope: s, ty: t };
        },
        parser.StmtIf(ifs) => {
            // cond must be bool. Branches type-check in fresh
            // scopes that share `s` as parent — bindings inside a
            // branch don't leak out (the Scope passed back from
            // check_stmt for the branch's stmts is intentionally
            // discarded). The if-statement itself surfaces
            // TypeBool on success and TypeUnknown on a non-bool
            // cond — there's no enclosing-expression type yet
            // (no `if`-expression form in the parser stub), so
            // the type slot is just a checker-side bookkeeping
            // value.
            var ct: Type = check_expr(ifs.cond, s);
            if (!type_eq(ct, t_bool())) {
                check_block(ifs.then_body, s);
                check_block(ifs.else_body, s);
                return CheckResult { scope: s, ty: t_unknown("if cond not bool") };
            }
            var thenOk: boolean = check_block(ifs.then_body, s);
            var elseOk: boolean = check_block(ifs.else_body, s);
            if (!thenOk || !elseOk) {
                return CheckResult { scope: s, ty: t_unknown("if: ill-typed branch") };
            }
            return CheckResult { scope: s, ty: t_bool() };
        },
        parser.StmtWhile(w) => {
            // Same shape as if: cond must be bool, body walks in a
            // derived scope. The body sees loop_depth+1 so any
            // break / continue inside type-checks. Loop control
            // flow has no static type; the checker surfaces
            // TypeBool on success / TypeUnknown on a non-bool cond.
            var wt: Type = check_expr(w.cond, s);
            var body_scope: Scope = s.enter_loop();
            if (!type_eq(wt, t_bool())) {
                check_block(w.body, body_scope);
                return CheckResult { scope: s, ty: t_unknown("while cond not bool") };
            }
            var bodyOk: boolean = check_block(w.body, body_scope);
            if (!bodyOk) {
                return CheckResult { scope: s, ty: t_unknown("while: ill-typed body") };
            }
            return CheckResult { scope: s, ty: t_bool() };
        },
        parser.StmtAssign(a) => {
            // Target must already be bound; types of LHS and RHS
            // must match. Type-mismatched or undefined-target
            // assigns surface TypeUnknown so a future "collect-
            // errors" pass can harvest them. The scope is
            // unchanged — assignment doesn't introduce a new
            // binding.
            var existing: Type = s.lookup(a.target);
            if (is_unknown(existing)) {
                return CheckResult { scope: s, ty: t_unknown("assign to undefined `" + a.target + "`") };
            }
            var vt: Type = check_expr(a.value, s);
            if (!type_eq(existing, vt)) {
                return CheckResult { scope: s, ty: t_unknown("type mismatch in assign to `" + a.target + "`") };
            }
            return CheckResult { scope: s, ty: vt };
        },
        parser.StmtMatch(m) => {
            // Type-check the scrutinee. An ill-typed scrutinee
            // surfaces as TypeUnknown and the whole match is
            // marked unknown — we still walk arm bodies so a
            // later "collect-errors" pass can harvest inner
            // diagnostics.
            var sct: Type = check_expr(m.scrutinee, s);
            var ok: boolean = !is_unknown(sct);
            // If the scrutinee is a TypeUnion, the union's
            // variant list is the authoritative set; PatVariant
            // arms must reference a member. If it's a TypeStruct,
            // PatVariant arms must reference that struct name
            // (anything else is a never-match).
            var union_name: string = "";
            var struct_name: string = "";
            match (sct) {
                TypeUnion(u) => { union_name = u.name; },
                TypeStruct(sn) => { struct_name = sn.name; },
                _ => { }
            }
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[i];
                // Derived scope per arm — bindings die at the
                // arm's close. The outer scope `s` is what we
                // return after the match.
                var armScope: Scope = s;
                match (arm.pattern) {
                    parser.PatWildcard(_) => { },
                    parser.PatVariant(pv) => {
                        var ss: StructSig = s.lookup_struct(pv.type_name);
                        if (ss.name.len() == 0) {
                            ok = false;
                        } else {
                            // Variant must be compatible with
                            // the scrutinee's type. For a union
                            // scrutinee: variant must be in the
                            // union's variant list. For a struct
                            // scrutinee: variant must match the
                            // struct's name.
                            if (union_name.len() > 0) {
                                if (!is_variant_of(pv.type_name, union_name, s.unions)) {
                                    ok = false;
                                }
                            } else if (struct_name.len() > 0) {
                                if (struct_name != pv.type_name) { ok = false; }
                            }
                            // Bring the payload bindings into the arm's
                            // scope, each typed as the matching `__ev` field.
                            // Bare names and `_` bindings stay out of scope.
                            armScope = bind_variant_payloads(armScope, s, pv);
                        }
                    }
                }
                if (!check_block(arm.body, armScope)) { ok = false; }
                i = i + 1;
            }
            if (!ok) {
                return CheckResult { scope: s, ty: t_unknown("match: ill-typed arm or scrutinee") };
            }
            return CheckResult { scope: s, ty: t_bool() };
        },
        parser.StmtBreak(_) => {
            if (s.loop_depth == 0) {
                return CheckResult { scope: s, ty: t_unknown("break outside loop") };
            }
            return CheckResult { scope: s, ty: t_bool() };
        },
        parser.StmtContinue(_) => {
            if (s.loop_depth == 0) {
                return CheckResult { scope: s, ty: t_unknown("continue outside loop") };
            }
            return CheckResult { scope: s, ty: t_bool() };
        },
        parser.StmtFor(f) => {
            // Iter expr must be a TypeArray. Walk the body in
            // a scope where var_name is bound to the array's
            // elem type, and loop_depth+1 so inner break /
            // continue type-check.
            //
            // Range form `for i in LOW..HIGH` arrives as a synthetic
            // `__range(LOW, HIGH)` call (parser desugar). The loop var
            // is an i32 over the half-open interval; bind it directly
            // instead of typing the (function-less) `__range` callee.
            // LOW / HIGH are still walked for E001 etc. by call_diags.
            var elem_ty: Type = t_unknown("for-in iter not an array");
            var ok: boolean = true;
            if (for_iter_is_range(f.iter)) {
                elem_ty = t_i32();
            } else {
                var it: Type = check_expr(f.iter, s);
                match (it) {
                    TypeArray(ta) => { elem_ty = ta.elem; },
                    _ => { ok = false; }
                }
            }
            var body_scope: Scope = s.enter_loop().bind(f.var_name, elem_ty);
            var fOk: boolean = check_block(f.body, body_scope);
            if (!ok) {
                return CheckResult { scope: s, ty: t_unknown("for-in: iter not array") };
            }
            if (!fOk) {
                return CheckResult { scope: s, ty: t_unknown("for-in: ill-typed body") };
            }
            return CheckResult { scope: s, ty: t_bool() };
        },
        parser.StmtUnknown(u) => { return CheckResult { scope: s, ty: t_unknown("parser-side unknown stmt:" + u.kind) }; }
    }
    return CheckResult { scope: s, ty: t_unknown("unhandled Stmt variant") };
}

// check_block walks a body in a derived scope. The scope's
// bindings don't escape — the parent caller threads its own
// pre-block scope forward unchanged. Errors inside the block
// don't propagate up either; they'd surface as TypeUnknown on
// the offending statement, which a future "collect-errors" pass
// could harvest. For this minimal cut we just walk for the side
// effect of validating sub-expressions.
function check_block(body: parser.Stmt[], s: Scope): boolean {
    var cur: Scope = s;
    var ok: boolean = true;
    var i: i32 = 0;
    while (i < body.len()) {
        var r: CheckResult = check_stmt(body[i], cur);
        cur = r.scope;
        if (is_unknown(r.ty)) { ok = false; }
        i = i + 1;
    }
    return ok;
}

// check_program threads the scope through every statement in
// source order. Returns parallel arrays: one inferred type per
// statement so callers can spot-check the shape.
pub struct ProgramTypes { tys: Type[] }

function check_program(prog: parser.Stmt[]): ProgramTypes {
    var s: Scope = new_scope();
    var tys: Type[] = [];
    var i: i32 = 0;
    while (i < prog.len()) {
        var r: CheckResult = check_stmt(prog[i], s);
        s = r.scope;
        tys = tys.append(r.ty);
        i = i + 1;
    }
    return ProgramTypes { tys: tys };
}

// collect_func_sigs builds the function-signature table from the
// module's FuncDecls. Resolves the parser's bare type-name strings
// to Types via type_from_name. The table is built in one pass and
// then passed to check_module's per-function body walk so calls
// (including recursive / mutually-recursive ones) can resolve.
function collect_func_sigs(funcs: parser.FuncDecl[], structs: StructSig[], unions: UnionSig[]): FuncSig[] {
    var out: FuncSig[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var fd: parser.FuncDecl = funcs[i];
        // Skip receiver methods — they live in MethodSig table.
        if (fd.receiver_name.len() > 0) { i = i + 1; continue; }
        var pts: Type[] = [];
        var pbnd: string[] = [];
        var ptn: string[] = [];
        var j: i32 = 0;
        while (j < fd.params.len()) {
            pts = pts.append(type_from_name_with_structs_unions(fd.params[j].type_name, structs, unions));
            pbnd = pbnd.append(tp_bound_for(fd.params[j].type_name, fd.type_params, fd.bound_traits));
            ptn = ptn.append(fd.params[j].type_name);
            j = j + 1;
        }
        out = out.append(FuncSig {
            name: fd.name,
            param_types: pts,
            ret_type: type_from_name_with_structs_unions(fd.ret_type, structs, unions),
            type_param_count: fd.type_param_count,
            param_bound: pbnd,
            ret_type_name: fd.ret_type,
            param_type_names: ptn
        });
        i = i + 1;
    }
    return out;
}

// collect_method_sigs builds the method-sig table from the
// module's FuncDecls — picking up only those with a non-empty
// receiver_name. Param types resolve through the same
// structs + unions tables as func sigs.
function collect_method_sigs(funcs: parser.FuncDecl[], structs: StructSig[], unions: UnionSig[]): MethodSig[] {
    var out: MethodSig[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var fd: parser.FuncDecl = funcs[i];
        if (fd.receiver_name.len() > 0) {
            var pts: Type[] = [];
            var j: i32 = 0;
            while (j < fd.params.len()) {
                pts = pts.append(type_from_name_with_structs_unions(fd.params[j].type_name, structs, unions));
                j = j + 1;
            }
            out = out.append(MethodSig {
                name: fd.name,
                receiver_type: fd.receiver_type,
                param_types: pts,
                ret_type: type_from_name_with_structs_unions(fd.ret_type, structs, unions),
                ret_type_name: fd.ret_type
            });
        }
        i = i + 1;
    }
    return out;
}

// collect_struct_sigs builds the struct-decl table from the
// module's StructDecls. Field types are resolved via the same
// type_from_name path used for function params — bare strings
// like "i32" / "bool" / "string", plus references to other
// declared structs.
function collect_struct_sigs(structs: parser.StructDecl[], union_names: string[]): StructSig[] {
    var out: StructSig[] = [];
    // First pass: build a name-only table so type_from_name
    // can resolve struct → struct references (e.g. a `Box`
    // with an `inner: Point` field needs Point already known).
    var names: string[] = [];
    var i: i32 = 0;
    while (i < structs.len()) {
        names = names.append(structs[i].name);
        i = i + 1;
    }
    // Second pass: resolve fields with the full name set
    // available. Struct-to-struct field references resolve via
    // the name set; union-typed fields (`f: SomeUnion`, `xs:
    // SomeUnion[]`) resolve via union_names so they don't fall
    // through to `unknown` and trip the field-value E043 check.
    var k: i32 = 0;
    while (k < structs.len()) {
        var sd: parser.StructDecl = structs[k];
        var fnames: string[] = [];
        var ftypes: Type[] = [];
        var ftnames: string[] = [];
        var j: i32 = 0;
        while (j < sd.fields.len()) {
            fnames = fnames.append(sd.fields[j].name);
            ftypes = ftypes.append(type_from_name_with_names_and_unions(sd.fields[j].type_name, names, union_names));
            // The field's raw declared type spelling — kept so field access on
            // a generic-struct instantiation can recognise a field typed by a
            // type parameter (`v: T`) and substitute the concrete arg (#4346
            // piece 2).
            ftnames = ftnames.append(sd.fields[j].type_name);
            j = j + 1;
        }
        out = out.append(StructSig { name: sd.name, field_names: fnames, field_types: ftypes, type_params: sd.type_params, field_type_names: ftnames });
        k = k + 1;
    }
    return out;
}

// type_from_name_with_structs / type_from_name_with_struct_names
// extend type_from_name with struct-name resolution. The
// `_with_struct_names` variant takes just the name set
// (cheaper to build up-front); the `_with_structs` variant
// takes the full StructSig[] for callers that already have it.
pub function type_from_name_with_structs(name: string, structs: StructSig[]): Type {
    // Array suffix `Elem[]` → TypeArray of the recursively-resolved element, one
    // `[]` per level. Detected via the structured TypeRef (SH-021 — parse_type_ref
    // peels the trailing `[]`s into array_depth) instead of the magic-byte
    // `[`(91)/`]`(93) scan; byte-identical (both detect a literal trailing `[]`,
    // and a depth-0 name — incl. a generic/tuple that ends in `]`/`)` — resolves
    // by its full spelling exactly as before).
    var r: parser.TypeRef = parser.parse_type_ref(name);
    if (r.array_depth > 0) {
        var elem: parser.TypeRef = parser.TypeRef { base: r.base, args: r.args, array_depth: r.array_depth - 1, is_tuple: r.is_tuple };
        return t_array(type_from_name_with_structs(parser.render_type_ref(elem), structs));
    }
    if (name == "i32") { return t_i32(); }
    if (name == "i64") { return t_i64(); }
    if (name == "u32") { return t_u32(); }
    if (name == "u64") { return t_u64(); }
    if (name == "bool" || name == "boolean") { return t_bool(); }
    if (name == "string") { return t_string(); }
    if (name == "f64" || name == "f32" || name == "float") { return t_float(); }
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return t_struct(name); }
        i = i + 1;
    }
    return t_unknown("unrecognised type name: " + name);
}

pub function type_from_name_with_struct_names(name: string, struct_names: string[]): Type {
    // Array suffix `Elem[]` → TypeArray of the recursively-resolved element (incl.
    // cross-module `mod__T[]`), via the structured TypeRef's array_depth (SH-021)
    // rather than the magic-byte `[`/`]` scan. Byte-identical.
    var r: parser.TypeRef = parser.parse_type_ref(name);
    if (r.array_depth > 0) {
        var elem: parser.TypeRef = parser.TypeRef { base: r.base, args: r.args, array_depth: r.array_depth - 1, is_tuple: r.is_tuple };
        return t_array(type_from_name_with_struct_names(parser.render_type_ref(elem), struct_names));
    }
    if (name == "i32") { return t_i32(); }
    if (name == "i64") { return t_i64(); }
    if (name == "u32") { return t_u32(); }
    if (name == "u64") { return t_u64(); }
    if (name == "bool" || name == "boolean") { return t_bool(); }
    if (name == "string") { return t_string(); }
    if (name == "f64" || name == "f32" || name == "float") { return t_float(); }
    var i: i32 = 0;
    while (i < struct_names.len()) {
        if (struct_names[i] == name) { return t_struct(name); }
        i = i + 1;
    }
    return t_unknown("unrecognised type name: " + name);
}

// type_from_name_with_structs_unions / _with_names_and_unions
// extend the resolver to recognise union aliases. Order of
// resolution: primitives → structs → unions → unknown. A
// struct name and an alias name can't collide because
// collect_union_sigs rejects the overlap at module build time.
pub function type_from_name_with_structs_unions(name: string, structs: StructSig[], unions: UnionSig[]): Type {
    // A `dyn Trait` annotation ("dyn Greet", "dyn A + B", or an array
    // `dyn Greet[]`) resolves to a TypeDyn carrying the trait-set text after
    // the `dyn ` prefix — parse_type_ref doesn't model the `dyn ` keyword, and
    // without this the annotation collapsed to unknown and over-rejected every
    // `var d: dyn Greet = …` (#4346 piece 2). Trailing `[]` peels to an array
    // of dyn so `dyn Greet[]` is TypeArray<TypeDyn>.
    if (name.len() >= 5 && name[0:4] == "dyn ") {
        var tail: str = name[4:name.len()];
        var depth: i32 = 0;
        while (tail.len() >= 2 && tail[tail.len() - 2] == 91 && tail[tail.len() - 1] == 93) {
            tail = tail[0:tail.len() - 2];
            depth = depth + 1;
        }
        var dt: Type = t_dyn(tail + "");
        while (depth > 0) {
            dt = t_array(dt);
            depth = depth - 1;
        }
        return dt;
    }
    return type_from_ref_su(parser.parse_type_ref(name), structs, unions);
}

// type_from_ref_su is type_from_name_with_structs_unions over the structured
// TypeRef (SH-021): parse the spelling once, then pattern-match on the tree
// instead of the former array-suffix / tuple / `Map[` first-comma byte scans. It
// is byte-identical to that scan — the resolution order (primitives → array →
// tuple → Map → struct → union → unknown) and every fallthrough are preserved,
// and the `unrecognised type name: <spelling>` reasons render the same spelling
// the scan sliced. `render_type_ref(r)` recovers a node's canonical spelling for
// the scalar / struct / union name compares and the unknown reason; for canonical
// inputs (what the parser feeds every caller) this equals the original substring.
function type_from_ref_su(r: parser.TypeRef, structs: StructSig[], unions: UnionSig[]): Type {
    // Array suffix `Elem[]` → TypeArray of the element, one `[]` peeled per level
    // (so `X[][]` nests), exactly as the old array branch (checked FIRST, so a
    // `Map[…][]` / `(A, B)[]` array wraps its element rather than being read as a
    // generic / tuple).
    if (r.array_depth > 0) {
        var elem: parser.TypeRef = parser.TypeRef { base: r.base, args: r.args, array_depth: r.array_depth - 1, is_tuple: r.is_tuple };
        return t_array(type_from_ref_su(elem, structs, unions));
    }
    // array_depth == 0 below. `name` is this node's canonical spelling — the
    // primitive / struct / union key and the unknown-reason text.
    var name: string = parser.render_type_ref(r);
    if (name == "i32") { return t_i32(); }
    if (name == "i64") { return t_i64(); }
    if (name == "u32") { return t_u32(); }
    if (name == "u64") { return t_u64(); }
    if (name == "bool" || name == "boolean") { return t_bool(); }
    if (name == "string") { return t_string(); }
    if (name == "f64" || name == "f32" || name == "float") { return t_float(); }
    // Tuple `(A, B, …)` → TypeTuple of its elements. Needs ≥2 elements (a single
    // `(T)` / `()` is not a tuple — it falls through to the name lookups → unknown,
    // matching the old `parts.len() >= 2` gate).
    if (r.is_tuple) {
        if (r.args.len() >= 2) {
            var elems: Type[] = [];
            var pi: i32 = 0;
            while (pi < r.args.len()) {
                elems = elems.append(type_from_ref_su(r.args[pi], structs, unions));
                pi = pi + 1;
            }
            return t_tuple(elems);
        }
    } else if (r.base == "Map" && r.args.len() == 2) {
        // `Map[K, V]` → TypeMap. (The recursively-resolved key/value are passed
        // straight into t_map's return-position wrap — an intermediate
        // `var: Type = <recursive call>` doesn't reliably trigger the struct→union
        // wrap here; see the t_i32 note.)
        return t_map(type_from_ref_su(r.args[0], structs, unions), type_from_ref_su(r.args[1], structs, unions));
    } else if (r.base == "Map" && r.args.len() > 2) {
        // A (never-emitted) 3+ arg `Map[K, A, B]`: the old first-comma split made
        // the value "everything after the first comma" — the trailing args
        // re-joined and resolved as one name (→ unknown) — reproduced here.
        var v_name: string = parser.render_type_ref(r.args[1]);
        var vk: i32 = 2;
        while (vk < r.args.len()) { v_name = v_name + ", " + parser.render_type_ref(r.args[vk]); vk = vk + 1; }
        return t_map(type_from_ref_su(r.args[0], structs, unions), type_from_name_with_structs_unions(v_name, structs, unions));
    }
    // Builtin generic enums (#4346 piece 2): `Option[T]` / `Result[T, E]` (and
    // the bare `JsonValue` / `IoError`) resolve to a NAME-ONLY union — the
    // generic arguments are dropped, exactly as user enums are name-only in
    // this partial type system. Keyed off r.base (the pre-bracket name), so
    // both `Option` and `Option[i32]` land here. Without this the full
    // spelling `Option[i32]` matches no struct/union below and the annotation
    // collapsed to unknown, over-rejecting every `var o: Option[i32] = …`.
    if (is_reserved_enum_name(r.base)) { return t_union(r.base); }
    // User generic struct / union-alias instantiation (#4346 piece 2):
    // `Box[i32]` / `Foo[T]` resolves to the NAME-ONLY struct / union off
    // r.base, dropping the generic args (this partial type system carries
    // none — the same way builtin enums and non-generic names are name-only).
    // Without this the full spelling `Box[i32]` matched no declared name below
    // and collapsed to unknown, over-rejecting every `var b: Box[i32] = …`.
    // Only fires for an actual instantiation (args present); a bare `Box`
    // resolves through the full-spelling loop as before.
    if (r.args.len() > 0) {
        var gsi: i32 = 0;
        while (gsi < structs.len()) {
            if (structs[gsi].name == r.base) {
                // Carry the resolved instantiation args so field access can
                // substitute a type-parameter field (`Box[i32].v` → i32);
                // assignability still ignores them (#4346 piece 2).
                var gargs: Type[] = [];
                var gai: i32 = 0;
                while (gai < r.args.len()) {
                    gargs = gargs.append(type_from_ref_su(r.args[gai], structs, unions));
                    gai = gai + 1;
                }
                return t_struct_g(r.base, gargs);
            }
            gsi = gsi + 1;
        }
        var gui: i32 = 0;
        while (gui < unions.len()) {
            if (unions[gui].name == r.base) { return t_union(r.base); }
            gui = gui + 1;
        }
    }
    // Any other shape (a bare name, a single-element tuple, a Map with <2 args, a
    // non-Map generic whose base names no declared type) resolves by its full
    // spelling: struct → union → unknown.
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return t_struct(name); }
        i = i + 1;
    }
    var j: i32 = 0;
    while (j < unions.len()) {
        if (unions[j].name == name) { return t_union(name); }
        j = j + 1;
    }
    // Unknown-BASE generic `Foo[T]` (non-tuple, non-Map, base declared
    // nowhere): the Go checker's resolveType keeps this shape as an
    // `ast.EnumType{Foo}` — an *unknown enum* — so a match / if-let /
    // let-else on a value of this type draws E023 ("unknown enum") rather
    // than dissolving to unknown and staying silent. Mirror it: resolve to
    // a name-only union carrying the BASE name; `lookup_union` misses for
    // it, which is exactly the state the E023 emission keys off. A generic
    // whose base IS a declared struct or union keeps today's conservative
    // unknown resolution (the Go checker resolves those to the declared
    // type — no E023 — so they must not take this branch).
    if (!r.is_tuple && r.args.len() > 0 && r.base != "Map" && r.base != "Cell") {
        var bk: boolean = false;
        var bs: i32 = 0;
        while (bs < structs.len()) {
            if (structs[bs].name == r.base) { bk = true; }
            bs = bs + 1;
        }
        var bu: i32 = 0;
        while (bu < unions.len()) {
            if (unions[bu].name == r.base) { bk = true; }
            bu = bu + 1;
        }
        if (!bk) { return t_union(r.base); }
    }
    return t_unknown("unrecognised type name: " + name);
}

// type_from_ref_subst resolves a field's declared type spelling against a
// struct's concrete instantiation args — substituting each type-parameter leaf
// with the matching arg Type throughout the spelling (#4346 piece 2, nested
// generic field spellings). It mirrors type_from_ref_su's shape recursion
// (array peel, tuple, Map) but, at a bare non-generic leaf whose name is one of
// `tparams`, returns the corresponding `targs` entry instead of resolving the
// name. So for `Box[i32]` (v: T) `.v` is i32, for `Wrapper[i32]` (items: T[])
// `.items` is i32[], and for `Pair[i32, string]` (kv: (K, V)) `.kv` is
// (i32, string). Any leaf that is NOT a type parameter resolves through the
// plain resolver, so mixed spellings (`(T, i32)`) work. A nested generic-struct
// arg (`inner: Box[T]`) falls to the plain name-only resolution — its args are
// erased, matching how this partial type system carries no generic args on a
// bare name.
function type_from_ref_subst(r: parser.TypeRef, tparams: string[], targs: Type[], structs: StructSig[], unions: UnionSig[]): Type {
    if (r.array_depth > 0) {
        var elem: parser.TypeRef = parser.TypeRef { base: r.base, args: r.args, array_depth: r.array_depth - 1, is_tuple: r.is_tuple };
        return t_array(type_from_ref_subst(elem, tparams, targs, structs, unions));
    }
    if (!r.is_tuple && r.args.len() == 0) {
        var tpi: i32 = util.index_of_str(tparams, r.base);
        if (tpi >= 0 && tpi < targs.len()) {
            return targs[tpi];
        }
    }
    if (r.is_tuple && r.args.len() >= 2) {
        var elems: Type[] = [];
        var pi: i32 = 0;
        while (pi < r.args.len()) {
            elems = elems.append(type_from_ref_subst(r.args[pi], tparams, targs, structs, unions));
            pi = pi + 1;
        }
        return t_tuple(elems);
    }
    if (r.base == "Map" && r.args.len() == 2) {
        return t_map(type_from_ref_subst(r.args[0], tparams, targs, structs, unions), type_from_ref_subst(r.args[1], tparams, targs, structs, unions));
    }
    return type_from_ref_su(r, structs, unions);
}


pub function type_from_name_with_names_and_unions(name: string, struct_names: string[], union_names: string[]): Type {
    // Array suffix `Elem[]` → TypeArray via the structured TypeRef's array_depth
    // (SH-021), replacing the magic-byte `[`/`]` scan. Byte-identical.
    var r: parser.TypeRef = parser.parse_type_ref(name);
    if (r.array_depth > 0) {
        var elem: parser.TypeRef = parser.TypeRef { base: r.base, args: r.args, array_depth: r.array_depth - 1, is_tuple: r.is_tuple };
        return t_array(type_from_name_with_names_and_unions(parser.render_type_ref(elem), struct_names, union_names));
    }
    if (name == "i32") { return t_i32(); }
    if (name == "i64") { return t_i64(); }
    if (name == "u32") { return t_u32(); }
    if (name == "u64") { return t_u64(); }
    if (name == "bool" || name == "boolean") { return t_bool(); }
    if (name == "string") { return t_string(); }
    if (name == "f64" || name == "f32" || name == "float") { return t_float(); }
    var i: i32 = 0;
    while (i < struct_names.len()) {
        if (struct_names[i] == name) { return t_struct(name); }
        i = i + 1;
    }
    var j: i32 = 0;
    while (j < union_names.len()) {
        if (union_names[j] == name) { return t_union(name); }
        j = j + 1;
    }
    return t_unknown("unrecognised type name: " + name);
}

// collect_union_sigs builds the union-alias table from the
// module's TypeAlias list. Variants are stored as bare names;
// resolution-time validation (each variant must be a declared
// struct) happens in `validate_union_sigs` after both tables
// exist. An alias whose name collides with a declared struct
// is silently dropped — collect_struct_sigs runs first and the
// duplicate-name check would otherwise need a tri-state.
function collect_union_sigs(aliases: parser.TypeAlias[], struct_names: string[]): UnionSig[] {
    var out: UnionSig[] = [];
    var i: i32 = 0;
    while (i < aliases.len()) {
        var a: parser.TypeAlias = aliases[i];
        // Skip aliases that shadow a declared struct — the
        // struct wins, and the alias is treated as a no-op.
        var k: i32 = 0;
        var dup: boolean = false;
        while (k < struct_names.len()) {
            if (struct_names[k] == a.name) { dup = true; break; }
            k = k + 1;
        }
        if (!dup) {
            out = out.append(UnionSig { name: a.name, variants: a.variants });
        }
        i = i + 1;
    }
    return out;
}

// validate_union_sigs walks each alias's variant list and
// returns false if any variant fails to resolve to a declared
// struct (the only variant shape supported in this slice).
// Primitives + nested unions as variants are a follow-up.
function validate_union_sigs(unions: UnionSig[], struct_names: string[]): boolean {
    var i: i32 = 0;
    while (i < unions.len()) {
        var u: UnionSig = unions[i];
        var v: i32 = 0;
        while (v < u.variants.len()) {
            var name: string = u.variants[v];
            var k: i32 = 0;
            var found: boolean = false;
            while (k < struct_names.len()) {
                if (struct_names[k] == name) { found = true; break; }
                k = k + 1;
            }
            if (!found) { return false; }
            v = v + 1;
        }
        i = i + 1;
    }
    return true;
}

// check_func_body type-checks a function's body in a scope
// pre-bound to its parameters. Errors inside the body surface as
// TypeUnknown on the offending statement — we walk for side
// effects and don't return them yet. Returns true if every body
// stmt type-checked (no TypeUnknown anywhere); the caller can
// use that to count well-typed function bodies for diagnostics.
// build_func_scope seeds a fresh scope for a function body: the declared
// ret_type (so StmtReturn arms can compare against it), the receiver (for
// methods), then the parameters. Shared by check_func_body and the
// coded-diagnostic walks so they bind names identically.
function build_func_scope(fd: parser.FuncDecl, sigs: FuncSig[], structs: StructSig[], unions: UnionSig[], methods: MethodSig[]): Scope {
    var s: Scope = new_scope_full(sigs, structs, unions, methods);
    if (fd.ret_type.len() > 0) {
        s = s.with_ret_type(type_from_name_with_structs_unions(fd.ret_type, structs, unions));
    }
    if (fd.receiver_name.len() > 0) {
        s = s.bind(fd.receiver_name, type_from_name_with_structs_unions(fd.receiver_type, structs, unions));
    }
    var i: i32 = 0;
    while (i < fd.params.len()) {
        s = s.bind(fd.params[i].name, type_from_name_with_structs_unions(fd.params[i].type_name, structs, unions));
        i = i + 1;
    }
    return s;
}

function check_func_body(fd: parser.FuncDecl, sigs: FuncSig[], structs: StructSig[], unions: UnionSig[], methods: MethodSig[]): boolean {
    var s: Scope = build_func_scope(fd, sigs, structs, unions, methods);
    // A GENERIC function's body operates on opaque-typed values — its type
    // parameters erase to unknown in this partial type system, so `v: T`
    // binds `v` to unknown and any expression over it infers unknown. That's
    // expected, not an error: native defers such checks to monomorphisation
    // and accepts the body. So a TypeUnknown statement here must NOT mark the
    // module ill-typed (which over-rejected `ident[T](v: T): T { return v; }`
    // under `-check`, #4346 piece 2). The CODED diagnostic passes still run —
    // and already skip opaque-generic param types when flagging E038 / E003 —
    // so genuine errors are unaffected; only the uncoded over-reject signal is
    // suppressed for generic bodies. Non-generic bodies keep the strict check.
    var generic: boolean = fd.type_params.len() > 0 || fd.type_param_count > 0;
    // A generic-RECEIVER method (`function (b: Box[T]) get(): T`) binds its
    // type parameters through the receiver spelling, not the method's own
    // `[...]` list, so type_param_count is 0 — yet its body operates on
    // opaque-typed values (`b.v` is `T` → unknown) exactly like a generic
    // function's. Detect it: the resolved receiver type carries an unknown
    // component (the erased `[T]`), so treat the body as generic and suppress
    // the uncoded over-reject, the same way a `[T]` function does (#4346
    // piece 2). A concrete receiver resolves without unknown and stays strict.
    if (!generic && fd.receiver_type.len() > 0) {
        if (type_contains_unknown(type_from_name_with_structs_unions(fd.receiver_type, structs, unions))) {
            generic = true;
        }
    }
    var ok: boolean = true;
    var j: i32 = 0;
    while (j < fd.body.len()) {
        var r: CheckResult = check_stmt(fd.body[j], s);
        s = r.scope;
        if (!generic && is_unknown(r.ty)) { ok = false; }
        j = j + 1;
    }
    return ok;
}

// type_label renders a Type as a friendly name for a diagnostic message
// (messages aren't part of the differential gate — codes are — so this is
// best-effort).
function type_label(t: Type): string {
    match (t) {
        TypeI32(it) => { return int_label(it); },
        TypeBool(_) => { return "bool"; },
        TypeString(_) => { return "string"; },
        TypeFloat(_) => { return "f64"; },
        TypeArray(a) => { return type_label(a.elem) + "[]"; },
        TypeStruct(sd) => { return sd.name; },
        TypeTuple(_) => { return "tuple"; },
        TypeFunc(_) => { return "fn"; },
        TypeMap(_) => { return "map"; },
        TypeUnion(u) => { return u.name; },
        TypeDyn(d) => { return "dyn " + d.traits; },
        TypeUnknown(_) => { return "unknown"; },
    }
    return "unknown";
}

// e042_ret_label renders a known-primitive declared return type with the
// native checker's ast spelling: bool prints "boolean" there (TS-heritage
// keyword), everything else matches type_label. Callers guard with
// is_primitive_type, so no other variant reaches the fallthrough.
function e042_ret_label(t: Type): string {
    match (t) {
        TypeBool(_) => { return "boolean"; },
        _ => { return type_label(t); }
    }
    return type_label(t);
}

// append_diags concatenates two diagnostic lists.
function append_diags(a: Diag[], b: Diag[]): Diag[] {
    var i: i32 = 0;
    while (i < b.len()) { a = a.append(b[i]); i = i + 1; }
    return a;
}

// ret_diags walks a function body (recursing through if / while / for /
// match / defer sub-bodies, threading scope so a return can see locals
// declared earlier in the same block) and emits E002 for each return
// whose value type isn't assignable to the function's declared return
// type. It reuses the SAME `type_assignable` predicate check_stmt uses to
// flag the mismatch, so it introduces no new false positives — it only
// attaches the stable code. Branch-local bindings don't leak (each
// sub-body re-threads from the scope at the block), and a return value /
// ret_type that infers `unknown` is skipped (a separate error already).
function ret_diags(stmts: parser.Stmt[], s: Scope, ret_ty: Type, unions: UnionSig[]): Diag[] {
    var out: Diag[] = [];
    if (is_unknown(ret_ty)) { return out; }
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtReturn(r) => {
                // A bare `return;` parses to a `punct:;` placeholder value.
                // In a function with a (non-void) declared return type —
                // the only context ret_diags runs in — that's E012.
                var bare: boolean = false;
                match (r.value) {
                    parser.ExprUnknown(u) => { if (u.kind == "punct:;") { bare = true; } },
                    _ => { }
                }
                if (bare) {
                    out = out.append(dg_at("E012", "return without value in function returning " + type_label(ret_ty), r.line, r.col));
                } else {
                    var t: Type = check_expr(r.value, cur);
                    if (!is_unknown(t) && !type_assignable(t, ret_ty, unions)) {
                        out = out.append(dg_at("E002", "return type mismatch: function returns " + type_label(ret_ty) + " but expression is " + type_label(t), r.line, r.col));
                    }
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, ret_diags(f.then_body, cur, ret_ty, unions));
                out = append_diags(out, ret_diags(f.else_body, cur, ret_ty, unions));
            },
            parser.StmtWhile(w) => { out = append_diags(out, ret_diags(w.body, cur, ret_ty, unions)); },
            parser.StmtFor(fr) => { out = append_diags(out, ret_diags(fr.body, cur, ret_ty, unions)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, ret_diags(m.arms[a].body, cur, ret_ty, unions)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, ret_diags(one, cur, ret_ty, unions));
            },
            _ => { }
        }
        // Advance the scope so a later return sees bindings from a `var`.
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// void_ret_diags is the `void`-return counterpart of ret_diags: a function
// declared `: void` must not return a value, so every `return <expr>;` with
// a real value is E002 (a bare `return;` is fine). Mirrors the Go checker,
// which rejects a value returned from a void function. Recurses into nested
// blocks the same way ret_diags does; the scope is threaded so a returned
// expression sees earlier `var` bindings (it's still type-checked for the
// message, though any concrete type is a mismatch against void).
function void_ret_diags(stmts: parser.Stmt[], s: Scope, unions: UnionSig[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtReturn(r) => {
                var bare: boolean = false;
                match (r.value) {
                    parser.ExprUnknown(u) => { if (u.kind == "punct:;") { bare = true; } },
                    _ => { }
                }
                if (!bare) {
                    var t: Type = check_expr(r.value, cur);
                    out = out.append(dg_at("E002", "return type mismatch: function returns void but expression is " + type_label(t), r.line, r.col));
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, void_ret_diags(f.then_body, cur, unions));
                out = append_diags(out, void_ret_diags(f.else_body, cur, unions));
            },
            parser.StmtWhile(w) => { out = append_diags(out, void_ret_diags(w.body, cur, unions)); },
            parser.StmtFor(fr) => { out = append_diags(out, void_ret_diags(fr.body, cur, unions)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, void_ret_diags(m.arms[a].body, cur, unions)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, void_ret_diags(one, cur, unions));
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// name_in reports whether `name` appears in `list` — the membership test
// the slice-escape walk uses to classify identifiers.
function name_in(name: string, list: string[]): boolean {
    var i: i32 = 0;
    while (i < list.len()) { if (list[i] == name) { return true; } i = i + 1; }
    return false;
}

// slc_src_is_local reports whether `e` names storage owned by the current
// function (so a slice of it dangles once the frame is reclaimed): an
// array literal, a local owned-array binding (`localarr`), or a local
// slice binding that itself views local storage (`tainted`). A sub-slice
// inherits its source's origin. Parameters / receivers are never added to
// either list, so membership alone excludes them — the caller owns them.
function slc_src_is_local(e: parser.Expr, localarr: string[], tainted: string[]): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprSlice(s2) => { return slc_src_is_local(s2.array, localarr, tainted); },
        parser.ExprIdent(id) => { return name_in(id.name, localarr) || name_in(id.name, tainted); },
        _ => { return false; }
    }
    return false;
}

// slc_expr_escapes reports whether `e` evaluates to a `[T]` slice that
// views function-local storage. A string slice copies into a fresh owned
// string (`__str_slice`) so it never dangles; a bare reference to a
// tainted local slice does.
function slc_expr_escapes(e: parser.Expr, cur: Scope, localarr: string[], tainted: string[]): boolean {
    match (e) {
        parser.ExprSlice(sl) => {
            match (check_expr(sl.array, cur)) {
                TypeString(_) => { return false; },
                _ => { }
            }
            return slc_src_is_local(sl.array, localarr, tainted);
        },
        parser.ExprIdent(id) => { return name_in(id.name, tainted); },
        _ => { return false; }
    }
    return false;
}

// slc_walk is the E063 body walk: it threads the scope (so a slice's
// source type resolves) plus two name sets — `localarr` (locals bound to
// an owned array literal) and `tainted` (locals bound to a slice that
// views local storage) — and flags every `return` of a slice viewing
// local storage. Conservative and false-positive-free: a local whose
// init is a slice of a *parameter* lands in neither set, so returning it
// (or a sub-slice of it) is not flagged. Mirrors the native checker's
// checkSliceEscape (internal/checker/checker.go).
function slc_walk(stmts: parser.Stmt[], s: Scope, localarr: string[], tainted: string[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => {
                match (v.init) {
                    parser.ExprArray(_) => { localarr = localarr.append(v.name); },
                    _ => {
                        if (slc_expr_escapes(v.init, cur, localarr, tainted)) { tainted = tainted.append(v.name); }
                    }
                }
            },
            parser.StmtReturn(r) => {
                if (slc_expr_escapes(r.value, cur, localarr, tainted)) {
                    out = out.append(dg_at("E063", "returning a `[T]` slice that views function-local storage: the backing array is reclaimed when the function returns, leaving a dangling view", r.line, r.col));
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, slc_walk(f.then_body, cur, localarr, tainted));
                out = append_diags(out, slc_walk(f.else_body, cur, localarr, tainted));
            },
            parser.StmtWhile(w) => { out = append_diags(out, slc_walk(w.body, cur, localarr, tainted)); },
            parser.StmtFor(fr) => { out = append_diags(out, slc_walk(fr.body, cur, localarr, tainted)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, slc_walk(m.arms[a].body, cur, localarr, tainted)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, slc_walk(one, cur, localarr, tainted));
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// slice_escape_diags is the E063 entry point: seed empty name sets and
// walk a function body. See slc_walk.
function slice_escape_diags(stmts: parser.Stmt[], s: Scope): Diag[] {
    var localarr: string[] = [];
    var tainted: string[] = [];
    return slc_walk(stmts, s, localarr, tainted);
}

// ---------------------------------------------------------------------------
// E067 — `@must_consume` obligation checking (docs/MUST-CONSUME.md).
// Port of the native walk in internal/checker/mustconsume.go: a value whose
// struct/enum type carries `@must_consume` must be CONSUMED at least once on
// every control-flow path before its binding leaves scope. Consuming uses:
// call-argument position, `return x`, `match (x)`, `var y = x` / `y = x`
// (the obligation transfers), or storing into another marked type. Storing
// into an UNMARKED container (array/tuple literal, unmarked struct/enum) is
// a violation at the store site (the obligation would be laundered out of
// the checked world), as is capturing the binding in a lambda. Loop bodies
// are opaque to the path analysis; `own` params are exempt (the own checker
// makes the callee the sink). Function names mirror the native mc* family.

// mc_any_marked reports whether the module declares ANY @must_consume type —
// the fast path that keeps the walk free for the (overwhelmingly common)
// unmarked-module case, e.g. the self-host compiler's own sources.
function mc_any_marked(structs: parser.StructDecl[], enums: parser.EnumDecl[]): boolean {
    var i: i32 = 0;
    while (i < structs.len()) { if (structs[i].must_consume) { return true; } i = i + 1; }
    var j: i32 = 0;
    while (j < enums.len()) { if (enums[j].must_consume) { return true; } j = j + 1; }
    return false;
}

// mc_struct_marked reports whether `name` is a declared struct carrying
// `@must_consume` (the native mustConsumeStructName).
function mc_struct_marked(name: string, structs: parser.StructDecl[]): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return structs[i].must_consume; }
        i = i + 1;
    }
    return false;
}

// mc_enum_marked reports whether `name` is a declared enum carrying
// `@must_consume`.
function mc_enum_marked(name: string, enums: parser.EnumDecl[]): boolean {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (enums[i].name == name) { return enums[i].must_consume; }
        i = i + 1;
    }
    return false;
}

// mc_marked_type_name resolves a type-annotation spelling to the marked
// struct/enum name it denotes, or "" when the type isn't marked. Exact
// nominal match only — `Ticket[]` (an array OF a marked type) is not itself
// marked, same as the native mustConsumeTypeName (StructType/EnumType only).
function mc_marked_type_name(tn: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
    if (tn.len() == 0) { return ""; }
    if (mc_struct_marked(tn, structs)) { return tn; }
    if (mc_enum_marked(tn, enums)) { return tn; }
    return "";
}

// mc_is_binding reports whether `e` is the bare binding ident.
function mc_is_binding(e: parser.Expr, name: string): boolean {
    match (e) {
        parser.ExprIdent(id) => { return id.name == name; },
        _ => { return false; }
    }
    return false;
}

// mc_mentions_list / mc_mentions_expr / mc_mentions_stmts report whether the
// expression / statement tree references `name` at all — the lambda-capture
// test (the native mcMentions).
function mc_mentions_list(list: parser.Expr[], name: string): boolean {
    var i: i32 = 0;
    while (i < list.len()) { if (mc_mentions_expr(list[i], name)) { return true; } i = i + 1; }
    return false;
}

function mc_mentions_expr(e: parser.Expr, name: string): boolean {
    match (e) {
        parser.ExprIdent(id) => { return id.name == name; },
        parser.ExprBinary(b) => { return mc_mentions_expr(b.left, name) || mc_mentions_expr(b.right, name); },
        parser.ExprUnary(u) => { return mc_mentions_expr(u.operand, name); },
        parser.ExprCall(c) => { return mc_mentions_expr(c.callee, name) || mc_mentions_list(c.args, name); },
        parser.ExprArray(ar) => { return mc_mentions_list(ar.elements, name); },
        parser.ExprTuple(tp) => { return mc_mentions_list(tp.elements, name); },
        parser.ExprIndex(ix) => { return mc_mentions_expr(ix.array, name) || mc_mentions_expr(ix.index, name); },
        parser.ExprSlice(sl) => { return mc_mentions_expr(sl.array, name) || mc_mentions_expr(sl.start, name) || mc_mentions_expr(sl.end, name); },
        parser.ExprStructLit(st) => {
            if (st.has_base && mc_mentions_expr(st.base, name)) { return true; }
            return mc_mentions_list(st.field_values, name);
        },
        parser.ExprFieldAccess(fa) => { return mc_mentions_expr(fa.obj, name); },
        parser.ExprLambda(lm) => { return mc_mentions_stmts(lm.body, name); },
        _ => { return false; }
    }
    return false;
}

function mc_mentions_stmts(stmts: parser.Stmt[], name: string): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { if (mc_mentions_expr(v.init, name)) { return true; } },
            parser.StmtReturn(r) => { if (mc_mentions_expr(r.value, name)) { return true; } },
            parser.StmtExpr(es) => { if (mc_mentions_expr(es.value, name)) { return true; } },
            parser.StmtAssign(a) => {
                if (a.target == name) { return true; }
                if (mc_mentions_expr(a.value, name)) { return true; }
            },
            parser.StmtIf(f) => {
                if (mc_mentions_expr(f.cond, name)) { return true; }
                if (mc_mentions_stmts(f.then_body, name)) { return true; }
                if (mc_mentions_stmts(f.else_body, name)) { return true; }
            },
            parser.StmtWhile(w) => {
                if (mc_mentions_expr(w.cond, name)) { return true; }
                if (mc_mentions_stmts(w.body, name)) { return true; }
            },
            parser.StmtFor(fr) => {
                if (mc_mentions_expr(fr.iter, name)) { return true; }
                if (mc_mentions_stmts(fr.body, name)) { return true; }
            },
            parser.StmtMatch(m) => {
                if (mc_mentions_expr(m.scrutinee, name)) { return true; }
                var a2: i32 = 0;
                while (a2 < m.arms.len()) {
                    if (m.arms[a2].has_guard && mc_mentions_expr(m.arms[a2].guard, name)) { return true; }
                    if (mc_mentions_stmts(m.arms[a2].body, name)) { return true; }
                    a2 = a2 + 1;
                }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                if (mc_mentions_stmts(one, name)) { return true; }
            },
            _ => { }
        }
        i = i + 1;
    }
    return false;
}

// mc_list_consumes scans an expression list for a consuming use (recursing —
// the direct bare-binding checks happen in the callers before this).
function mc_list_consumes(list: parser.Expr[], name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, Diag[]) {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < list.len()) {
        var (c2, d2) = mc_expr_consumes(list[i], name, tname, report, structs, enums);
        out = append_diags(out, d2);
        if (c2) { return (true, out); }
        i = i + 1;
    }
    return (false, out);
}

// mc_call_consumes: a bare binding in ARGUMENT position transfers the
// obligation to the callee. A variant-constructor call (`Reply(t)`) is the
// self-host spelling of the native EnumLit: storing into a MARKED enum
// consumes; an unmarked enum launders the obligation (violation at the
// store site, still treated as consuming so it reports exactly once).
function mc_call_consumes(c: parser.ExprCall, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, Diag[]) {
    var none: Diag[] = [];
    var owner: string = "";
    match (c.callee) {
        parser.ExprIdent(cid) => {
            owner = mx_enum_of(cid.name, enums);
            if (owner.len() == 0) { owner = mx_builtin_enum_of(cid.name); }
        },
        _ => { }
    }
    var i: i32 = 0;
    while (i < c.args.len()) {
        if (mc_is_binding(c.args[i], name)) {
            if (owner.len() == 0 || mc_enum_marked(owner, enums)) { return (true, none); }
            var d: Diag[] = [];
            if (report) {
                d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked enum \"" + owner + "\" — the consumption obligation is lost; mark \"" + owner + "\" @must_consume or consume the value directly", c.line, c.col));
            }
            return (true, d);
        }
        i = i + 1;
    }
    // An immediately-invoked lambda — the parser's desugar of a
    // value-position `match` / `if` expression, `(function(): RT { … })()`
    // — runs its body exactly once inline, so a consuming use in the body
    // counts (the native MatchExpr-tag rule), NOT as a closure capture.
    // Consumption must hold on all body paths (mc_seq), which covers the
    // dominant shape: a value-match destructuring the binding itself.
    match (c.callee) {
        parser.ExprLambda(ilm) => {
            var (bc, bdv, bd) = mc_seq(ilm.body, 0, name, tname, structs, enums);
            if (report) { return (bc, bd); }
            return (bc, none);
        },
        _ => { }
    }
    var (kc, kd) = mc_expr_consumes(c.callee, name, tname, report, structs, enums);
    if (kc) { return (true, kd); }
    return mc_list_consumes(c.args, name, tname, report, structs, enums);
}

// mc_structlit_consumes: storing the binding into a MARKED struct consumes;
// an unmarked struct launders (violation at the store site). The `...base`
// spread is neutral for the bare binding (a functional update reads the old
// value, it doesn't discharge it) — only recursed for nested uses.
function mc_structlit_consumes(sl: parser.ExprStructLit, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, Diag[]) {
    var none: Diag[] = [];
    var i: i32 = 0;
    while (i < sl.field_values.len()) {
        if (mc_is_binding(sl.field_values[i], name)) {
            if (mc_struct_marked(sl.type_name, structs)) { return (true, none); }
            var d: Diag[] = [];
            if (report) {
                d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked struct \"" + sl.type_name + "\" — the consumption obligation is lost; mark \"" + sl.type_name + "\" @must_consume or consume the value directly", sl.line, sl.col));
            }
            return (true, d);
        }
        i = i + 1;
    }
    if (sl.has_base) {
        var (bc, bd) = mc_expr_consumes(sl.base, name, tname, report, structs, enums);
        if (bc) { return (true, bd); }
    }
    return mc_list_consumes(sl.field_values, name, tname, report, structs, enums);
}

// mc_expr_consumes scans an expression tree for a consuming use of the bare
// binding (the native mcExprConsumes). Laundering into an array/tuple
// literal and lambda capture are violations reported here, treated as
// consuming so each misuse reports exactly once. Field reads are neutral.
function mc_expr_consumes(e: parser.Expr, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, Diag[]) {
    var none: Diag[] = [];
    match (e) {
        parser.ExprCall(c) => { return mc_call_consumes(c, name, tname, report, structs, enums); },
        parser.ExprStructLit(sl) => { return mc_structlit_consumes(sl, name, tname, report, structs, enums); },
        parser.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) {
                if (mc_is_binding(ar.elements[i], name)) {
                    var d: Diag[] = [];
                    if (report) {
                        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into an array literal — arrays cannot carry consumption obligations; consume the value directly", expr_line(ar.elements[i]), expr_col(ar.elements[i])));
                    }
                    return (true, d);
                }
                i = i + 1;
            }
            return mc_list_consumes(ar.elements, name, tname, report, structs, enums);
        },
        parser.ExprTuple(tp) => {
            var j: i32 = 0;
            while (j < tp.elements.len()) {
                if (mc_is_binding(tp.elements[j], name)) {
                    var d2: Diag[] = [];
                    if (report) {
                        d2 = d2.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into a tuple — tuples cannot carry consumption obligations; consume the value directly", tp.line, tp.col));
                    }
                    return (true, d2);
                }
                j = j + 1;
            }
            return mc_list_consumes(tp.elements, name, tname, report, structs, enums);
        },
        parser.ExprLambda(lm) => {
            if (mc_mentions_stmts(lm.body, name)) {
                var d3: Diag[] = [];
                if (report) {
                    d3 = d3.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" captured by a closure — obligations cannot flow into closures; consume the value directly", 0, 0));
                }
                return (true, d3);
            }
            return (false, none);
        },
        parser.ExprBinary(b) => {
            var (lc, ld) = mc_expr_consumes(b.left, name, tname, report, structs, enums);
            if (lc) { return (true, ld); }
            var (rc, rd) = mc_expr_consumes(b.right, name, tname, report, structs, enums);
            return (rc, append_diags(ld, rd));
        },
        parser.ExprUnary(u) => { return mc_expr_consumes(u.operand, name, tname, report, structs, enums); },
        parser.ExprIndex(ix) => {
            var (ac, ad) = mc_expr_consumes(ix.array, name, tname, report, structs, enums);
            if (ac) { return (true, ad); }
            return mc_expr_consumes(ix.index, name, tname, report, structs, enums);
        },
        parser.ExprSlice(sl2) => {
            var (sc, sd) = mc_expr_consumes(sl2.array, name, tname, report, structs, enums);
            if (sc) { return (true, sd); }
            var (stc, std) = mc_expr_consumes(sl2.start, name, tname, report, structs, enums);
            if (stc) { return (true, std); }
            return mc_expr_consumes(sl2.end, name, tname, report, structs, enums);
        },
        parser.ExprFieldAccess(fa) => { return mc_expr_consumes(fa.obj, name, tname, report, structs, enums); },
        _ => { return (false, none); }
    }
    return (false, none);
}

// mc_stmt_consumes reports whether the statement definitely contains a
// consuming use of the binding (the native mcStmtConsumesImpl). `report`
// false is the detection-only variant the overwrite re-scan uses.
function mc_stmt_consumes(st: parser.Stmt, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, Diag[]) {
    var none: Diag[] = [];
    match (st) {
        parser.StmtExpr(es) => { return mc_expr_consumes(es.value, name, tname, report, structs, enums); },
        parser.StmtVar(v) => {
            // `var y = x;` — the obligation transfers to y (tracked at its
            // own binding site when its type is marked).
            if (mc_is_binding(v.init, name)) { return (true, none); }
            return mc_expr_consumes(v.init, name, tname, report, structs, enums);
        },
        parser.StmtReturn(r) => {
            if (mc_is_binding(r.value, name)) { return (true, none); }
            return mc_expr_consumes(r.value, name, tname, report, structs, enums);
        },
        parser.StmtAssign(a) => {
            // `y = x;` — the obligation transfers to y (the native Assign
            // case of mcExprConsumes; assignment is a statement here).
            if (mc_is_binding(a.value, name)) { return (true, none); }
            return mc_expr_consumes(a.value, name, tname, report, structs, enums);
        },
        parser.StmtMatch(m) => {
            if (mc_is_binding(m.scrutinee, name)) { return (true, none); }
            return (false, none);
        },
        _ => { return (false, none); }
    }
    return (false, none);
}

// mc_seq returns (consumed_on_all_paths, diverged_unconsumed, diags) for the
// statement sequence starting at `from` (the native mcSeq). A path that
// returns / breaks / continues out of the scope without a consuming use sets
// the second flag; falling off the end unconsumed reports false for the
// first (the caller decides that's the scope-exit violation). Loop bodies
// are opaque; defer is neutral.
function mc_seq(stmts: parser.Stmt[], from: i32, name: string, tname: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, boolean, Diag[]) {
    var out: Diag[] = [];
    var i: i32 = from;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        var (con, cd) = mc_stmt_consumes(st, name, tname, true, structs, enums);
        out = append_diags(out, cd);
        if (con) { return (true, false, out); }
        match (st) {
            parser.StmtReturn(_) => { return (false, true, out); },
            parser.StmtBreak(_) => { return (false, true, out); },
            parser.StmtContinue(_) => { return (false, true, out); },
            parser.StmtIf(f) => {
                var (tc, tv, td) = mc_seq(f.then_body, 0, name, tname, structs, enums);
                out = append_diags(out, td);
                var ec: boolean = false;
                var ev: boolean = false;
                if (f.else_body.len() > 0) {
                    var (ec2, ev2, ed) = mc_seq(f.else_body, 0, name, tname, structs, enums);
                    out = append_diags(out, ed);
                    ec = ec2;
                    ev = ev2;
                }
                if (tv || ev) { return (false, true, out); }
                if (tc && f.else_body.len() > 0 && ec) { return (true, false, out); }
                // Some path through the if did not consume — the rest of
                // the sequence must cover it (at-least-once checker).
            },
            parser.StmtMatch(m) => {
                // The scrutinee-is-binding case already returned via
                // mc_stmt_consumes above. A parser-desugared if-let /
                // let-else (origin != "") mirrors the native IfLet/LetElse:
                // only the source-destructure consumes; its arms don't
                // participate in the all-arms path logic.
                if (m.origin == "") {
                    var all: boolean = m.arms.len() > 0;
                    var a: i32 = 0;
                    while (a < m.arms.len()) {
                        var (ac, av, ad) = mc_seq(m.arms[a].body, 0, name, tname, structs, enums);
                        out = append_diags(out, ad);
                        if (av) { return (false, true, out); }
                        if (!ac) { all = false; }
                        a = a + 1;
                    }
                    if (all) { return (true, false, out); }
                }
            },
            _ => { }
        }
        i = i + 1;
    }
    return (false, false, out);
}

// mc_check_binding runs the at-least-once analysis for one binding over the
// remainder of its scope, plus the straight-line overwrite scan (the native
// mcCheckBinding).
function mc_check_binding(stmts: parser.Stmt[], from: i32, name: string, tname: string, bline: i32, bcol: i32, structs: parser.StructDecl[], enums: parser.EnumDecl[]): Diag[] {
    var (con, div, out) = mc_seq(stmts, from, name, tname, structs, enums);
    if (!con || div) {
        out = out.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" bound to \"" + name + "\" may go out of scope without being consumed — pass it, return it, match on it, or store it into another @must_consume type on every path", bline, bcol));
        return out;
    }
    // Overwrite scan (same block, straight-line): re-assigning the binding
    // before any consuming use silently drops the old value. Detection-only
    // (report=false) — the pass above already emitted any laundering /
    // capture errors for these statements.
    var i: i32 = from;
    while (i < stmts.len()) {
        var (q, qd) = mc_stmt_consumes(stmts[i], name, tname, false, structs, enums);
        if (q) { return out; }
        match (stmts[i]) {
            parser.StmtAssign(a) => {
                if (a.target == name) {
                    out = out.append(dg_at("E067", "overwriting \"" + name + "\" while it still holds an unconsumed @must_consume \"" + tname + "\" value — consume the old value first", a.line, a.col));
                    return out;
                }
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// mc_var_type_name resolves the marked type name of a `var` binding: the
// annotation when present, otherwise the inferred init type (the native
// falls back to info.VarTypes). Returns "" when the type isn't marked.
function mc_var_type_name(v: parser.StmtVar, cur: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
    var tn: string = v.type_name;
    if (tn.len() == 0) {
        match (check_expr(v.init, cur)) {
            TypeStruct(ts) => { tn = ts.name; },
            TypeUnion(tu) => { tn = tu.name; },
            _ => { return ""; }
        }
    }
    return mc_marked_type_name(tn, structs, enums);
}

// mc_walk_body finds marked-type `var` bindings at every block depth and
// checks each against the remainder of ITS block (the native mcWalkBlock).
// The scope is threaded like slc_walk so an unannotated binding's init type
// resolves.
function mc_walk_body(stmts: parser.Stmt[], s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => {
                var tn: string = mc_var_type_name(v, cur, structs, enums);
                if (tn.len() > 0) {
                    out = append_diags(out, mc_check_binding(stmts, i + 1, v.name, tn, v.line, v.col, structs, enums));
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, mc_walk_body(f.then_body, cur, structs, enums));
                out = append_diags(out, mc_walk_body(f.else_body, cur, structs, enums));
            },
            parser.StmtWhile(w) => { out = append_diags(out, mc_walk_body(w.body, cur, structs, enums)); },
            parser.StmtFor(fr) => { out = append_diags(out, mc_walk_body(fr.body, cur, structs, enums)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    out = append_diags(out, mc_walk_body(m.arms[a].body, cur, structs, enums));
                    a = a + 1;
                }
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// must_consume_diags is the per-function E067 entry point (the native
// checkMustConsume): parameters of marked type carry the obligation in from
// the caller (their scope is the whole body) — EXCEPT `own` params, whose
// function is the value's sink (E050/E051 enforce affine use there; the
// caller-side at-least-once plus the sink-side at-most-once compose to
// exactly-once across the call boundary). Then walk the body for local
// bindings.
function must_consume_diags(fn: parser.FuncDecl, s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): Diag[] {
    var out: Diag[] = [];
    var pi: i32 = 0;
    while (pi < fn.params.len()) {
        var p: parser.ParamDecl = fn.params[pi];
        if (!p.own) {
            var tn: string = mc_marked_type_name(p.type_name, structs, enums);
            if (tn.len() > 0) {
                out = append_diags(out, mc_check_binding(fn.body, 0, p.name, tn, fn.line, fn.col, structs, enums));
            }
        }
        pi = pi + 1;
    }
    out = append_diags(out, mc_walk_body(fn.body, s, structs, enums));
    return out;
}

// lret_expr walks an expression looking for lambdas and, for each one
// that declares a return type, checks the lambda body's `return`s against
// THAT type (not the enclosing function's) by reusing ret_diags. This is
// the lambda-body counterpart of the top-level ret_diags pass: ret_diags
// itself recurses through if/while/for/match/defer sub-bodies but stops at
// a lambda boundary (a nested function has its own return contract), so
// without this pass a `var f = function(): i32 { return "x"; }` would go
// unflagged. The lambda's scope is the surrounding scope plus its params
// (lexical capture keeps free idents resolving outward); when `self_name`
// is non-empty the lambda is a recursive local (`var f = function…`) and
// its own name is pre-bound to its function type so a self-call inside the
// body resolves rather than inferring unknown. After checking the lambda's
// own returns it recurses into the body via lret_stmts for nested lambdas.
function lret_expr(e: parser.Expr, cur: Scope, unions: UnionSig[], self_name: string): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprLambda(lm) => {
            var pts: Type[] = [];
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                pts = pts.append(type_from_name_with_structs_unions(lm.params[pi].type_name, cur.structs, cur.unions));
                pi = pi + 1;
            }
            var rt: Type = type_from_name_with_structs_unions(lm.ret_type, cur.structs, cur.unions);
            var lsc: Scope = cur;
            if (self_name.len() > 0) { lsc = lsc.bind(self_name, t_func(pts, rt)); }
            var bi: i32 = 0;
            while (bi < lm.params.len()) {
                lsc = lsc.bind(lm.params[bi].name, pts[bi]);
                bi = bi + 1;
            }
            if (lm.ret_type.len() > 0) {
                out = append_diags(out, ret_diags(lm.body, lsc, rt, unions));
            }
            out = append_diags(out, lret_stmts(lm.body, lsc, unions));
        },
        parser.ExprBinary(b) => {
            out = append_diags(lret_expr(b.left, cur, unions, ""), lret_expr(b.right, cur, unions, ""));
        },
        parser.ExprUnary(u) => { out = lret_expr(u.operand, cur, unions, ""); },
        parser.ExprCall(c) => {
            // An immediately-invoked lambda — (function(): RT { … })() — is
            // how the parser desugars a `match` / `if` used in value
            // position. Its RT is a COARSE heuristic tag (if_expr_rt picks it
            // from the first arm's literal shape, defaulting to "i32"), NOT a
            // user-declared return type — so running ret_diags against it
            // would false-positive E002 whenever the arms aren't i32-literals
            // (e.g. a match returning strings, or an arm that's a call). Skip
            // the IIFE's own return check; still recurse into its body for any
            // genuinely-nested lambdas.
            match (c.callee) {
                parser.ExprLambda(lm) => {
                    var lsc: Scope = cur;
                    var pi: i32 = 0;
                    while (pi < lm.params.len()) {
                        lsc = lsc.bind(lm.params[pi].name, type_from_name_with_structs_unions(lm.params[pi].type_name, cur.structs, cur.unions));
                        pi = pi + 1;
                    }
                    out = append_diags(out, lret_stmts(lm.body, lsc, unions));
                },
                _ => { out = append_diags(out, lret_expr(c.callee, cur, unions, "")); }
            }
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, lret_expr(c.args[i], cur, unions, "")); i = i + 1; }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, lret_expr(a.elements[i], cur, unions, "")); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, lret_expr(t.elements[i], cur, unions, "")); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(lret_expr(ix.array, cur, unions, ""), lret_expr(ix.index, cur, unions, ""));
        },
        parser.ExprSlice(s2) => {
            out = append_diags(lret_expr(s2.array, cur, unions, ""), append_diags(lret_expr(s2.start, cur, unions, ""), lret_expr(s2.end, cur, unions, "")));
        },
        parser.ExprFieldAccess(fa) => { out = lret_expr(fa.obj, cur, unions, ""); },
        parser.ExprStructLit(sl) => {
            var fv: i32 = 0;
            while (fv < sl.field_values.len()) { out = append_diags(out, lret_expr(sl.field_values[fv], cur, unions, "")); fv = fv + 1; }
            if (sl.has_base) { out = append_diags(out, lret_expr(sl.base, cur, unions, "")); }
        },
        _ => { }
    }
    return out;
}

// lret_stmts walks a statement list, threading scope (so a lambda sees
// `var`s declared earlier in the same block, exactly as ret_diags does)
// and dispatching every contained expression through lret_expr. A
// `var f = function…` passes its own name as self_name so a recursive
// local resolves inside its body.
function lret_stmts(stmts: parser.Stmt[], s: Scope, unions: UnionSig[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => { out = append_diags(out, lret_expr(v.init, cur, unions, v.name)); },
            parser.StmtReturn(r) => { out = append_diags(out, lret_expr(r.value, cur, unions, "")); },
            parser.StmtExpr(x) => { out = append_diags(out, lret_expr(x.value, cur, unions, "")); },
            parser.StmtAssign(a) => { out = append_diags(out, lret_expr(a.value, cur, unions, "")); },
            parser.StmtIf(f) => {
                out = append_diags(out, lret_expr(f.cond, cur, unions, ""));
                out = append_diags(out, lret_stmts(f.then_body, cur, unions));
                out = append_diags(out, lret_stmts(f.else_body, cur, unions));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, lret_expr(w.cond, cur, unions, ""));
                out = append_diags(out, lret_stmts(w.body, cur, unions));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, lret_expr(fr.iter, cur, unions, ""));
                out = append_diags(out, lret_stmts(fr.body, cur, unions));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, lret_expr(m.scrutinee, cur, unions, ""));
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, lret_stmts(m.arms[a].body, cur, unions)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, lret_stmts(one, cur, unions));
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// ============ E031: match/if-expression arm-type unification ============
//
// A `match` / `if` used in VALUE position is desugared by the parser into
// an immediately-invoked closure — (function(): RT { <match|if with
// returning arms> })() — so the type system never sees a real
// match/if-expression node and the arm-type consistency check the Go
// checker performs (E031) was missing. These passes recognise that IIFE
// shape, type each arm's result expression, and emit E031 when the arms
// aren't all mutually compatible.
//
// The compatibility predicate (`mx_arm_compatible`) mirrors the Go
// checker's `unifyIfArms`: two arms coexist when they're equal
// (`type_eq`), assignable either way (covers an empty-array literal vs a
// typed array, and a struct that's a member of a union arm), both numeric
// (i32/f64 mix freely — the self-host analogue of Go's polymorphic-numeric
// widening), element-wise-compatible tuples / arrays / maps, or two struct
// values of the SAME enum family. The enum-family rule is the subtle one:
// the Go checker types an enum variant constructor as its ENUM type, so
// `A(1)` and `B("y")` of one `enum E` unify, whereas the members of a
// struct-union (`type U = A | B`) keep their distinct struct types and do
// NOT unify (Go reports E031). The self-host types BOTH as `t_struct(name)`,
// so the names are mapped back to their family via the user `enum` decls
// (`mx_enum_of`) and the built-in enums (`mx_builtin_enum_of`, Option /
// Result / JsonValue / IoError) — but NOT via union aliases, so union
// members correctly stay incompatible. Bare no-payload variants (`None`,
// `Empty`) resolve to `unknown` in the self-host and so are handled by the
// unknown-skip below (matching Go, which sees them as the compatible enum
// type). If ANY arm types to `unknown` the check is skipped entirely (a bad
// arm is its own error — Go reports E001 there, not E031).

// mx_is_numeric reports whether a type is one of the numeric scalars
// (i32 / f64), which mix freely as match/if-expression arms.
function mx_is_numeric(t: Type): boolean {
    match (t) {
        TypeI32(_) => { return true; },
        TypeFloat(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// mx_builtin_enum_of returns the built-in enum a variant name belongs to
// (Option / Result / JsonValue / IoError), or "" if it isn't a built-in
// variant. Two struct arms in the same non-empty family unify.
function mx_builtin_enum_of(name: string): string {
    if (name == "Some" || name == "None") { return "Option"; }
    if (name == "Ok" || name == "Err") { return "Result"; }
    if (name == "JNull" || name == "JBool" || name == "JNumber" || name == "JString" || name == "JArray" || name == "JObject") { return "JsonValue"; }
    if (name == "NotFound" || name == "PermissionDenied" || name == "AlreadyExists" || name == "InvalidUtf8" || name == "Interrupted" || name == "Unsupported" || name == "Other") { return "IoError"; }
    return "";
}

// mx_enum_of returns the user `enum` whose variant list contains `name`, or
// "" if none. Used to recognise that two distinct variant structs of one
// enum unify. NOT consulted for union aliases (`type U = A | B`): union
// members keep their distinct struct types and do not unify (Go E031).
function mx_enum_of(name: string, enums: parser.EnumDecl[]): string {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (util.has_str(enums[i].variant_names, name)) { return enums[i].name; }
        i = i + 1;
    }
    return "";
}

// mx_same_enum_family reports whether two struct names are variant
// constructors of the same enum (built-in or user-declared).
function mx_same_enum_family(an: string, bn: string, enums: parser.EnumDecl[]): boolean {
    if (an == bn) { return true; }
    var ab: string = mx_builtin_enum_of(an);
    if (ab.len() > 0 && ab == mx_builtin_enum_of(bn)) { return true; }
    var au: string = mx_enum_of(an, enums);
    if (au.len() > 0 && au == mx_enum_of(bn, enums)) { return true; }
    return false;
}

// mx_arm_compatible reports whether two arm result types may coexist,
// mirroring the Go checker's unifyIfArms (see the section header).
function mx_arm_compatible(a: Type, b: Type, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
    if (type_eq(a, b)) { return true; }
    if (type_assignable(a, b, unions) || type_assignable(b, a, unions)) { return true; }
    if (mx_is_numeric(a) && mx_is_numeric(b)) { return true; }
    match (a) {
        TypeTuple(ta) => {
            match (b) {
                TypeTuple(tb) => {
                    if (ta.elements.len() != tb.elements.len()) { return false; }
                    var i: i32 = 0;
                    while (i < ta.elements.len()) {
                        if (!mx_arm_compatible(ta.elements[i], tb.elements[i], unions, enums)) { return false; }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        TypeArray(aa) => {
            match (b) {
                TypeArray(ba) => { return mx_arm_compatible(aa.elem, ba.elem, unions, enums); },
                _ => { return false; }
            }
        },
        TypeMap(ma) => {
            match (b) {
                TypeMap(mb) => { return mx_arm_compatible(ma.key, mb.key, unions, enums) && mx_arm_compatible(ma.value, mb.value, unions, enums); },
                _ => { return false; }
            }
        },
        TypeStruct(sa) => {
            match (b) {
                TypeStruct(sb) => { return mx_same_enum_family(sa.name, sb.name, enums); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// mx_e031 emits one E031 if the collected arm types aren't all mutually
// compatible. Skips when fewer than two arms or any arm is `unknown`.
function mx_e031(types: Type[], unions: UnionSig[], enums: parser.EnumDecl[], line: i32, col: i32): Diag[] {
    var out: Diag[] = [];
    if (types.len() < 2) { return out; }
    var i: i32 = 0;
    while (i < types.len()) {
        if (is_unknown(types[i])) { return out; }
        i = i + 1;
    }
    var t0: Type = types[0];
    var j: i32 = 1;
    while (j < types.len()) {
        if (!mx_arm_compatible(t0, types[j], unions, enums)) {
            out = out.append(dg_at("E031", "match/if-expression arms have incompatible types: " + type_label(t0) + " vs " + type_label(types[j]), line, col));
            return out;
        }
        j = j + 1;
    }
    return out;
}

// mx_match_arm_types types each arm's result expression of a value
// match-expression (whose arms are single `return E` statements), binding
// each variant pattern's payload in the arm scope so the result resolves.
function mx_match_arm_types(m: parser.StmtMatch, s: Scope): Type[] {
    var out: Type[] = [];
    var a: i32 = 0;
    while (a < m.arms.len()) {
        var armScope: Scope = s;
        match (m.arms[a].pattern) {
            parser.PatVariant(pv) => {
                armScope = bind_variant_payloads(armScope, s, pv);
            },
            _ => { }
        }
        if (m.arms[a].body.len() == 1) {
            match (m.arms[a].body[0]) {
                parser.StmtReturn(r) => { out = out.append(check_expr(r.value, armScope)); },
                _ => { }
            }
        }
        a = a + 1;
    }
    return out;
}

// mx_if_branch_types collects an if-expression's branch result types,
// recursing through an `else if` chain (the else arm is itself a StmtIf).
function mx_if_branch_types(f: parser.StmtIf, s: Scope): Type[] {
    var out: Type[] = [];
    if (f.then_body.len() == 1) {
        match (f.then_body[0]) {
            parser.StmtReturn(r) => { out = out.append(check_expr(r.value, s)); },
            _ => { }
        }
    }
    if (f.else_body.len() == 1) {
        match (f.else_body[0]) {
            parser.StmtReturn(r) => { out = out.append(check_expr(r.value, s)); },
            parser.StmtIf(nf) => {
                var nested: Type[] = mx_if_branch_types(nf, s);
                var k: i32 = 0;
                while (k < nested.len()) { out = out.append(nested[k]); k = k + 1; }
            },
            _ => { }
        }
    }
    return out;
}

// mx_expr walks an expression, emitting E031 for any value match/if-
// expression IIFE it finds and recursing into sub-expressions (so nested
// match/if-expressions, and ones inside calls / operators / literals, are
// all covered).
function mx_expr(e: parser.Expr, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprCall(c) => {
            // Recognise the desugared value match/if-expression: a 0-arg
            // call of a 0-param lambda whose body is a single StmtMatch or
            // StmtIf (arms/branches return their value).
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lm) => {
                        if (lm.params.len() == 0 && lm.body.len() == 1) {
                            match (lm.body[0]) {
                                parser.StmtMatch(m) => {
                                    out = append_diags(out, mx_e031(mx_match_arm_types(m, s), unions, enums, expr_line(m.scrutinee), expr_col(m.scrutinee)));
                                },
                                parser.StmtIf(f) => {
                                    out = append_diags(out, mx_e031(mx_if_branch_types(f, s), unions, enums, expr_line(f.cond), expr_col(f.cond)));
                                },
                                _ => { }
                            }
                        }
                    },
                    _ => { }
                }
            }
            out = append_diags(out, mx_expr(c.callee, s, unions, enums));
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, mx_expr(c.args[i], s, unions, enums)); i = i + 1; }
        },
        parser.ExprLambda(lm) => {
            var lsc: Scope = s;
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                lsc = lsc.bind(lm.params[pi].name, type_from_name_with_structs_unions(lm.params[pi].type_name, s.structs, s.unions));
                pi = pi + 1;
            }
            out = append_diags(out, mx_stmts(lm.body, lsc, unions, enums));
        },
        parser.ExprBinary(b) => {
            out = append_diags(mx_expr(b.left, s, unions, enums), mx_expr(b.right, s, unions, enums));
        },
        parser.ExprUnary(u) => { out = mx_expr(u.operand, s, unions, enums); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, mx_expr(a.elements[i], s, unions, enums)); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, mx_expr(t.elements[i], s, unions, enums)); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(mx_expr(ix.array, s, unions, enums), mx_expr(ix.index, s, unions, enums));
        },
        parser.ExprSlice(s2) => {
            out = append_diags(mx_expr(s2.array, s, unions, enums), append_diags(mx_expr(s2.start, s, unions, enums), mx_expr(s2.end, s, unions, enums)));
        },
        parser.ExprFieldAccess(fa) => { out = mx_expr(fa.obj, s, unions, enums); },
        parser.ExprStructLit(sl) => {
            var fv: i32 = 0;
            while (fv < sl.field_values.len()) { out = append_diags(out, mx_expr(sl.field_values[fv], s, unions, enums)); fv = fv + 1; }
            if (sl.has_base) { out = append_diags(out, mx_expr(sl.base, s, unions, enums)); }
        },
        _ => { }
    }
    return out;
}

// mx_stmts walks a statement list, threading scope (so a match/if-
// expression sees earlier locals and a match arm sees its payload binding)
// and dispatching every contained expression through mx_expr. It also emits
// E061 for a value-position block with no trailing value (the marker
// StmtUnknown parse_branch_body leaves), reached here because the walk
// descends into the value-if/match IIFE lambda bodies where that marker lives.
function mx_stmts(stmts: parser.Stmt[], s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => { out = append_diags(out, mx_expr(v.init, cur, unions, enums)); },
            parser.StmtReturn(r) => { out = append_diags(out, mx_expr(r.value, cur, unions, enums)); },
            parser.StmtExpr(x) => { out = append_diags(out, mx_expr(x.value, cur, unions, enums)); },
            parser.StmtAssign(a) => { out = append_diags(out, mx_expr(a.value, cur, unions, enums)); },
            parser.StmtIf(f) => {
                out = append_diags(out, mx_expr(f.cond, cur, unions, enums));
                out = append_diags(out, mx_stmts(f.then_body, cur, unions, enums));
                out = append_diags(out, mx_stmts(f.else_body, cur, unions, enums));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, mx_expr(w.cond, cur, unions, enums));
                out = append_diags(out, mx_stmts(w.body, cur, unions, enums));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, mx_expr(fr.iter, cur, unions, enums));
                out = append_diags(out, mx_stmts(fr.body, cur, unions, enums));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, mx_expr(m.scrutinee, cur, unions, enums));
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    var armScope: Scope = cur;
                    match (m.arms[a].pattern) {
                        parser.PatVariant(pv) => {
                            armScope = bind_variant_payloads(armScope, cur, pv);
                        },
                        _ => { }
                    }
                    out = append_diags(out, mx_stmts(m.arms[a].body, armScope, unions, enums));
                    a = a + 1;
                }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, mx_stmts(one, cur, unions, enums));
            },
            parser.StmtUnknown(u) => {
                // E061: a value-position block (an if/match value-branch) whose
                // last element is a `;`-terminated statement has no trailing
                // value. parse_branch_body tags exactly that case with this
                // marker StmtUnknown (the only producer of this kind), so
                // detecting it here — inside the same value-if/match IIFE walk
                // that drives E031 — matches the Go checker, which reports E061
                // when a value-position block has no tail expression.
                if (u.kind == "value branch has no trailing expression") {
                    out = out.append(dg("E061", "block-expression has no trailing value"));
                }
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// name_in reports whether `n` is one of `names`.
// name_in -> util.has_str (SH-020).

// find_struct_sig returns the struct sig named `name`, or an empty-named
// sentinel when there's no such struct.
function find_struct_sig(structs: StructSig[], name: string): StructSig {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return structs[i]; }
        i = i + 1;
    }
    var none: string[] = [];
    var nonet: Type[] = [];
    var none_tp: string[] = [];
    var none_ftn: string[] = [];
    return StructSig { name: "", field_names: none, field_types: nonet, type_params: none_tp, field_type_names: none_ftn };
}

// slit_diags recurses through an expression and emits E005 for every
// non-update struct literal that omits a declared field. The struct table
// is module-global, so this needs no scope — and recursing into field
// values + lambda bodies catches nested literals. A literal whose type
// isn't a known struct is skipped (a separate error / a variant
// constructor), as is a struct-update `Name { ...base, … }` (partial
// overrides are legal).
function slit_diags(e: parser.Expr, structs: StructSig[]): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprStructLit(sl) => {
            var fv: i32 = 0;
            while (fv < sl.field_values.len()) { out = append_diags(out, slit_diags(sl.field_values[fv], structs)); fv = fv + 1; }
            // E043: a struct-literal field whose name isn't declared on the
            // struct. Mirrors the Go checker (per-literal-field "struct S has no
            // field f"). Runs for update literals too (`S { ...b, bad: 1 }`) —
            // you can't set an unknown field. A non-struct / unknown type name
            // (generic instantiation, variant) finds no sig and is skipped.
            var usig: StructSig = find_struct_sig(structs, sl.type_name);
            if (usig.name.len() > 0) {
                var uf: i32 = 0;
                while (uf < sl.field_names.len()) {
                    if (!util.has_str(usig.field_names, sl.field_names[uf])) {
                        out = out.append(dg_at("E043", "struct " + sl.type_name + " has no field \"" + sl.field_names[uf] + "\"", sl.line, sl.col));
                    }
                    uf = uf + 1;
                }
            }
            if (sl.has_base) {
                out = append_diags(out, slit_diags(sl.base, structs));
            } else {
                var ssig: StructSig = find_struct_sig(structs, sl.type_name);
                if (ssig.name.len() > 0) {
                    var d: i32 = 0;
                    while (d < ssig.field_names.len()) {
                        if (!util.has_str(sl.field_names, ssig.field_names[d])) {
                            out = out.append(dg_at("E005", "struct literal missing field \"" + ssig.field_names[d] + "\"", sl.line, sl.col));
                        }
                        d = d + 1;
                    }
                }
            }
        },
        parser.ExprBinary(b) => {
            out = append_diags(slit_diags(b.left, structs), slit_diags(b.right, structs));
        },
        parser.ExprUnary(u) => { out = slit_diags(u.operand, structs); },
        parser.ExprCall(c) => {
            out = slit_diags(c.callee, structs);
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, slit_diags(c.args[i], structs)); i = i + 1; }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, slit_diags(a.elements[i], structs)); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, slit_diags(t.elements[i], structs)); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(slit_diags(ix.array, structs), slit_diags(ix.index, structs));
        },
        parser.ExprSlice(s2) => {
            out = append_diags(slit_diags(s2.array, structs), append_diags(slit_diags(s2.start, structs), slit_diags(s2.end, structs)));
        },
        parser.ExprFieldAccess(fa) => { out = slit_diags(fa.obj, structs); },
        parser.ExprLambda(lm) => { out = stmts_slit_diags(lm.body, structs); },
        _ => { }
    }
    return out;
}

// stmts_slit_diags walks a statement list (recursing into nested blocks
// and lambda bodies via slit_diags) collecting the struct-literal E005s
// from every expression it contains.
function stmts_slit_diags(stmts: parser.Stmt[], structs: StructSig[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { out = append_diags(out, slit_diags(v.init, structs)); },
            parser.StmtReturn(r) => { out = append_diags(out, slit_diags(r.value, structs)); },
            parser.StmtExpr(x) => { out = append_diags(out, slit_diags(x.value, structs)); },
            parser.StmtAssign(a) => { out = append_diags(out, slit_diags(a.value, structs)); },
            parser.StmtIf(f) => {
                out = append_diags(out, slit_diags(f.cond, structs));
                out = append_diags(out, stmts_slit_diags(f.then_body, structs));
                out = append_diags(out, stmts_slit_diags(f.else_body, structs));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, slit_diags(w.cond, structs));
                out = append_diags(out, stmts_slit_diags(w.body, structs));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, slit_diags(fr.iter, structs));
                out = append_diags(out, stmts_slit_diags(fr.body, structs));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, slit_diags(m.scrutinee, structs));
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, stmts_slit_diags(m.arms[a].body, structs)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, stmts_slit_diags(one, structs));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// loop_diags emits E011 for a `break` / `continue` that isn't inside a
// loop, and E058 for a labeled `break L` / `continue L` whose `L` names no
// enclosing loop. It threads only the enclosing-loop label stack (no value
// scope): `while` / `for` bodies recurse with in_loop = true.
// block_exits reports whether a statement block is guaranteed to leave
// its function (return) on every path — an under-approximation mirroring
// the Go checker's funcBodyExits, used by E052. Only the LAST statement
// matters: a `return`, an `if` whose both arms exit, a `while (true)`
// (divergent — breaks are ignored, a breakable loop that needs a value
// keeps a trailing return the surrounding block catches), or a `match`
// whose every arm body exits. `if let` is already desugared
// to an if/else chain by the parser, so it needs no special case here.
function block_exits(stmts: parser.Stmt[]): boolean {
    if (stmts.len() == 0) { return false; }
    var last: parser.Stmt = stmts[stmts.len() - 1];
    match (last) {
        parser.StmtReturn(_) => { return true; },
        parser.StmtIf(f) => {
            return block_exits(f.then_body) && block_exits(f.else_body);
        },
        parser.StmtWhile(w) => {
            match (w.cond) {
                parser.ExprBool(b) => { return b.value; },
                _ => { return false; }
            }
        },
        parser.StmtMatch(m) => {
            if (m.arms.len() == 0) { return false; }
            // A `let … else` desugar folds the rest of the enclosing block
            // into its success arm (arm[0]); the trailing `_` arm is the else
            // branch, which is REQUIRED to diverge (enforced separately by
            // E022). So the construct's only fall-through path is the success
            // arm — exits iff that arm exits, regardless of the else arm. (A
            // non-diverging else is E022, not a missing-return E052.)
            if (m.origin == "let_else") {
                return block_exits(m.arms[0].body);
            }
            var i: i32 = 0;
            while (i < m.arms.len()) {
                if (!block_exits(m.arms[i].body)) { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// label_in_scope reports whether `name` is one of the enclosing loop
// labels (mirrors the Go checker's labelInScope over its loopLabels stack).
// A labeled `break`/`continue` may only target a loop it is nested inside.
function label_in_scope(labels: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < labels.len()) {
        if (labels[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// with in_loop = true, while `if` / `match` / `defer` pass the flag
// through unchanged — so a `break` in a match arm is legal only when that
// match is itself inside a loop (matching the Go checker).
//
// `labels` is the stack of enclosing loop labels (a labeled `while`/`for`
// pushes its label onto the stack for its body). A labeled `break L` /
// `continue L` whose `L` names no enclosing loop is E058 — but only when
// it IS inside a loop, since an out-of-loop break is already E011 (the Go
// checker reports E058 in the `else` branch after the E011 check, so the
// two never both fire on one statement).
function loop_diags(stmts: parser.Stmt[], in_loop: boolean, labels: string[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtBreak(bk) => {
                if (!in_loop) { out = out.append(dg_at("E011", "break outside of a loop", bk.line, bk.col)); }
                else if (bk.label.len() > 0 && !label_in_scope(labels, bk.label)) {
                    out = out.append(dg_at("E058", "break label does not match any enclosing loop", bk.line, bk.col));
                }
            },
            parser.StmtContinue(ck) => {
                if (!in_loop) { out = out.append(dg_at("E011", "continue outside of a loop", ck.line, ck.col)); }
                else if (ck.label.len() > 0 && !label_in_scope(labels, ck.label)) {
                    out = out.append(dg_at("E058", "continue label does not match any enclosing loop", ck.line, ck.col));
                }
            },
            parser.StmtWhile(w) => {
                var wl: string[] = labels;
                if (w.label.len() > 0) { wl = labels.append(w.label); }
                out = append_diags(out, loop_diags(w.body, true, wl));
            },
            parser.StmtFor(fr) => {
                var fl: string[] = labels;
                if (fr.label.len() > 0) { fl = labels.append(fr.label); }
                out = append_diags(out, loop_diags(fr.body, true, fl));
            },
            parser.StmtIf(f) => {
                out = append_diags(out, loop_diags(f.then_body, in_loop, labels));
                out = append_diags(out, loop_diags(f.else_body, in_loop, labels));
            },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, loop_diags(m.arms[a].body, in_loop, labels)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, loop_diags(one, in_loop, labels));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// count_type_args returns the number of top-level type arguments a
// `Name[A, B, …]` annotation supplies to its head generic (2 for `Map[K, V]`,
// 1 for `Box[i32]`), or -1 when the annotation is not a top-level generic
// instantiation (a bare name, a tuple, or an array). Decodes via the structured
// TypeRef (SH-021, docs/SELF-HOST-AUDIT.md T2) instead of a first-`[` + trailing-
// `]` window with a depth-tracking top-level-comma count; parse_type_ref already
// splits the args without letting a nested generic's / tuple's inner commas
// confuse the count. An ARRAY (`Box[i32][]`, array_depth > 0) is a value of array
// type, not a generic instantiation, so it returns -1 (the former scan treated a
// trailing `[]` as a 0-arg generic bracket — a value only reachable on an array
// annotation, which is never a struct's own generic head for the E019 arity check
// this feeds; the fixpoints confirm the arity diagnostics are unchanged).
pub function count_type_args(t: string): i32 {
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.is_tuple || r.array_depth > 0 || r.args.len() == 0) { return 0 - 1; }
    return r.args.len();
}

// struct_type_param_count returns how many type parameters the struct
// `name` declares, or -1 if there's no such struct.
function struct_type_param_count(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return structs[i].type_params.len(); }
        i = i + 1;
    }
    return 0 - 1;
}

// struct_decl_line / struct_decl_col return the declaration position of a
// named struct (0 when absent). E019 is reported at the struct's
// definition (Go's `sd.P`), not the use site.
function struct_decl_line(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return structs[i].line; }
        i = i + 1;
    }
    return 0;
}
function struct_decl_col(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return structs[i].col; }
        i = i + 1;
    }
    return 0;
}

// type_base strips a `[...]` suffix from a type annotation: `Box[i32]` ->
// `Box`, `P` -> `P`.
// type_base -> util.base_type_name (SH-020).

// dot_index returns the byte index of the first '.' in s, or -1. A
// variant pattern that still carries a dot at check time is qualified by
// an *enum* name (module qualifiers are mangled to `__` by flatten before
// the checker runs), which the E029 check keys off.
function dot_index(s: string): i32 {
    var i: i32 = 0;
    while (i < s.len()) { if (s[i] == 46) { return i; } i = i + 1; }
    return 0 - 1;
}

// type_arity_diag checks one type annotation: if it supplies an explicit
// `[...]` argument list whose count doesn't match the named struct's
// declared type-parameter count, it's E019. Checked at param + struct-
// field positions (where the Go checker reports E019 on its own); a `var`
// / return annotation with the wrong arity additionally trips E003 / E002
// in Go, so those positions are left out to keep the code sets matching.
function type_arity_diag(t: string, structs: parser.StructDecl[]): Diag[] {
    var out: Diag[] = [];
    var nargs: i32 = count_type_args(t);
    if (nargs >= 0) {
        var tpc: i32 = struct_type_param_count(structs, util.base_type_name(t));
        if (tpc >= 0 && nargs != tpc) {
            out = out.append(dg_at("E019", "struct " + util.base_type_name(t) + " has " + itoa_nn(tpc) + " type parameter(s), " + itoa_nn(nargs) + " supplied", struct_decl_line(structs, util.base_type_name(t)), struct_decl_col(structs, util.base_type_name(t))));
        }
    }
    return out;
}

// match_diags emits the structural `match`-arm diagnostics (no types
// needed): E026 when a wildcard `_` arm isn't the last arm, and E028 when
// a variant pattern repeats one covered by an earlier arm. Recurses into
// nested blocks + arm bodies.
// variant_payload_count returns 1 for a payload-bearing enum variant — its
// synthesized struct carries the `__ev` marker field — and -1 otherwise (skip
// the E015 check). A struct WITHOUT `__ev` is ambiguous: it could be a
// no-payload enum variant (`Nil`) OR a struct-union member (`type U = A | B`,
// where `A(a)` binds the whole struct, not a payload), and the two aren't
// distinguishable here, so we conservatively skip rather than risk a false
// E015. The self-host models at most one payload per variant.
function variant_payload_count(name: string, structs: StructSig[]): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) {
            if (util.has_str(structs[i].field_names, "__ev")) {
                // A multi-payload variant carries `__ev`, `__ev1`, … — count every
                // `__ev`-prefixed field so the E015 arity check allows a matching
                // multi-binding `V(a, b)`.
                var c: i32 = 0;
                var j: i32 = 0;
                while (j < structs[i].field_names.len()) {
                    var fn: string = structs[i].field_names[j];
                    if (fn.len() >= 4 && fn[0:4] == "__ev") { c = c + 1; }
                    j = j + 1;
                }
                return c;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

function match_diags(stmts: parser.Stmt[], structs: StructSig[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtMatch(m) => {
                var seen: string[] = [];
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    match (m.arms[a].pattern) {
                        parser.PatWildcard(_) => {
                            if (a < m.arms.len() - 1) {
                                out = out.append(dg_at("E026", "wildcard `_` arm must be last in the match", m.arms[a].line, m.arms[a].col));
                            }
                        },
                        parser.PatVariant(pv) => {
                            if (pv.type_name.len() > 0) {
                                if (util.has_str(seen, pv.type_name)) {
                                    out = out.append(dg_at("E028", "variant \"" + pv.type_name + "\" already covered earlier in this match", m.arms[a].line, m.arms[a].col));
                                } else if (!m.arms[a].has_guard) {
                                    // Only an UNGUARDED arm fully covers its variant. A
                                    // guarded arm (`V(x) when cond =>`) may fall through, so
                                    // it must NOT mark V covered — the standard
                                    // guarded-then-unguarded shape (`Red when.. =>, Red =>`)
                                    // is legal, and E030 still requires the later unguarded
                                    // arm. Mirrors native checker.go:8318-8331 (#4344).
                                    seen = seen.append(pv.type_name);
                                }
                                // E015: payload-binding arity. A known variant's
                                // binding count must equal its payload count.
                                var pc: i32 = variant_payload_count(pv.type_name, structs);
                                if (pc >= 0) {
                                    var nb: i32 = pv.extra_bindings.len();
                                    if (pv.binding.len() > 0) { nb = nb + 1; }
                                    if (nb != pc) {
                                        out = out.append(dg_at("E015", "variant " + pv.type_name + " has " + itoa_nn(pc) + " payload(s), got " + itoa_nn(nb) + " binding(s)", m.arms[a].line, m.arms[a].col));
                                    }
                                }
                            }
                        },
                    }
                    out = append_diags(out, match_diags(m.arms[a].body, structs));
                    a = a + 1;
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, match_diags(f.then_body, structs));
                out = append_diags(out, match_diags(f.else_body, structs));
            },
            parser.StmtWhile(w) => { out = append_diags(out, match_diags(w.body, structs)); },
            parser.StmtFor(fr) => { out = append_diags(out, match_diags(fr.body, structs)); },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, match_diags(one, structs));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// dupvar_diags emits the structural `var`-declaration diagnostics, per
// block: E013 for a name already declared by an earlier `var` IN THE SAME
// BLOCK (each block — function body, branch, loop / match-arm body — gets
// a fresh name set, so shadowing across nested blocks / over a parameter
// is allowed, matching the Go checker), and E020 for an un-annotated
// `var x = []` whose empty-array initializer can't infer an element type.
// digits_fit_i32 reports whether a non-negative decimal digit string is
// <= i32's max (2147483647). Equal-length digit strings compare
// lexicographically the same as numerically, so the 10-digit case is a
// char-by-char compare against the max.
function digits_fit_i32(text: string): boolean {
    var n: i32 = text.len();
    if (n < 10) { return true; }
    if (n > 10) { return false; }
    var maxs: string = "2147483647";
    var i: i32 = 0;
    while (i < 10) {
        var tc: i32 = text[i];
        var mc: i32 = maxs[i];
        if (tc < mc) { return true; }
        if (tc > mc) { return false; }
        i = i + 1;
    }
    return true;
}

function dupvar_diags(stmts: parser.Stmt[]): Diag[] {
    var out: Diag[] = [];
    var declared: string[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                if (util.has_str(declared, v.name)) {
                    out = out.append(dg_at("E013", "variable \"" + v.name + "\" already declared in this scope", v.line, v.col));
                } else {
                    declared = declared.append(v.name);
                }
                if (v.type_name.len() == 0) {
                    match (v.init) {
                        parser.ExprArray(arr) => {
                            if (arr.elements.len() == 0) {
                                out = out.append(dg_at("E020", "empty array literal needs a type annotation", v.line, v.col));
                            }
                        },
                        _ => { }
                    }
                }
                // E047: an integer literal assigned to an i32 var that
                // doesn't fit i32's range.
                if (v.type_name == "i32") {
                    match (v.init) {
                        parser.ExprNumber(num) => {
                            if (!num.is_float && num.suffix.len() == 0 && !digits_fit_i32(num.text)) {
                                out = out.append(dg_at("E047", "literal " + num.text + " does not fit in i32", num.line, num.col));
                            }
                        },
                        _ => { }
                    }
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, dupvar_diags(f.then_body));
                out = append_diags(out, dupvar_diags(f.else_body));
            },
            parser.StmtWhile(w) => { out = append_diags(out, dupvar_diags(w.body)); },
            parser.StmtFor(fr) => { out = append_diags(out, dupvar_diags(fr.body)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, dupvar_diags(m.arms[a].body)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, dupvar_diags(one));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// itoa_nn renders a non-negative i32 as decimal (checker.fern has no
// int→string, and diagnostic messages aren't part of the differential
// gate, but a faithful count reads better).
pub function itoa_nn(n: i32): string {
    if (n == 0) { return "0"; }
    var digits: string = "0123456789";
    var s: string = "";
    var v: i32 = n;
    while (v > 0) {
        var d: i32 = v % 10;
        s = digits[d:d + 1] + s;
        v = v / 10;
    }
    return s;
}

// call_diags recurses through an expression (scope-threaded) emitting the
// expression-level diagnostics: E004 for a FREE function call whose
// argument count doesn't match the declared parameter count, E038 for a
// matching-arity free call whose argument types don't match, and E009 for
// a `&&` / `||` / `!` operand that isn't boolean. The call checks are
// conservative — a callee name that's a local binding (parameter, `var`,
// or closure) is skipped, so only a real module function sig is checked
// (method / closure arity + argument types are left to later slices).
// mlit_is_base reports whether an expression is the base constructor call
// of a desugared map literal — `map_new(n)` (string keys) or
// `map_new_i32(n)` (integer keys), which the parser's parse_map_lit emits
// before chaining `.insert(k, v)` per entry. Used to find a map literal's
// FIRST `.insert` (whose object is this base) so its key type can be
// checked (E045).
function mlit_is_base(e: parser.Expr): boolean {
    match (e) {
        parser.ExprCall(bc) => {
            match (bc.callee) {
                parser.ExprIdent(bid) => { return bid.name == "map_new" || bid.name == "map_new_i32"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function call_diags(e: parser.Expr, s: Scope): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprCall(c) => {
            // A method-call callee (`obj.m(...)`) is an ExprFieldAccess
            // whose field names a METHOD, not a field — recurse only into
            // the object so it isn't mis-flagged as an unknown field (E043).
            match (c.callee) {
                parser.ExprFieldAccess(mfa) => {
                    out = call_diags(mfa.obj, s);
                    // E045: a map literal `Map { k: v, … }` desugars to
                    // `map_new[_i32](n).insert(k0, v0).insert(…)…`. The FIRST
                    // insert (its object is the base constructor) carries the
                    // literal's first key, which fixes the map's key type — it
                    // must be i32 or string (the only key kinds the runtime's
                    // hash/compare supports). Reported at the key, matching the
                    // Go checker, which checks `MapLit.Entries[0].Key`.
                    if (mfa.field == "insert" && mlit_is_base(mfa.obj) && c.args.len() >= 1) {
                        var kt: Type = check_expr(c.args[0], s);
                        if (!is_unknown(kt) && !type_eq(kt, t_i32()) && !type_eq(kt, t_string())) {
                            out = out.append(dg_at("E045", "map key type " + type_label(kt) + " is not yet supported (use i32 or string)", expr_line(c.args[0]), expr_col(c.args[0])));
                        }
                    }
                },
                parser.ExprIdent(cid) => {
                    // E001: a call to an undefined function. A bare-ident
                    // callee that resolves to nothing — not a local (closure),
                    // a free function, a variant constructor, a runtime
                    // intrinsic (`__`-prefixed), or a builtin function — is an
                    // undefined call, reported at the callee.
                    if (!is_resolvable_callee(cid.name, s)) {
                        out = out.append(dg_at("E001", "undefined function \"" + cid.name + "\"", cid.line, cid.col));
                    }
                },
                _ => { out = call_diags(c.callee, s); }
            }
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, call_diags(c.args[i], s)); i = i + 1; }
            // E038: calling a NON-FUNCTION value (`x(3)` where x is an i32 /
            // string / etc.). The callee's type, when known and not a function
            // type, isn't callable. Mirrors the Go checker (callee type not a
            // FuncType -> E038 at the call). A free function / variant
            // constructor / builtin callee types as unknown here (it's not a
            // scope binding), so only a value-typed callee is flagged. A
            // FieldAccess callee (a method, or a function-valued field) is left
            // to the method path — a method on a non-struct is E043, not E038.
            match (c.callee) {
                parser.ExprFieldAccess(_) => { },
                _ => {
                    var calleet: Type = check_expr(c.callee, s);
                    var callee_is_fn: boolean = false;
                    match (calleet) {
                        TypeFunc(_) => { callee_is_fn = true; },
                        _ => { }
                    }
                    if (!is_unknown(calleet) && !callee_is_fn) {
                        out = out.append(dg_at("E038", "calling non-function value of type " + type_label(calleet), c.line, c.col));
                    }
                }
            }
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // E048: a field assignment `obj.field = v` is desugared
                    // by the parser to `__set_field(obj, "field", v)`. Fields
                    // are immutable after construction (the immutable-data
                    // rule that keeps RC cycle-free), so any such call is
                    // E048, reported at the object — matching the Go checker,
                    // which flags the field-access lvalue. No false positives:
                    // __set_field is a parser-internal builtin that no
                    // hand-written source names, and the self-host + stdlib
                    // were migrated off field mutation to functional updates.
                    if (id.name == "__set_field" && c.args.len() == 3) {
                        var fld: string = "field";
                        match (c.args[1]) {
                            parser.ExprString(fs) => { fld = fs.value; },
                            _ => { }
                        }
                        out = out.append(dg_at("E048", "cannot assign to field \"" + fld + "\": fields are immutable after construction; rebuild with a struct-update literal", expr_line(c.args[1]), expr_col(c.args[1])));
                    }
                    // E056: `arr[i] = v` is desugared by the parser to
                    // `__set_index(arr, idx, rhs)`. Array elements are
                    // immutable after construction (the subscript counterpart
                    // of E048), so any such call is E056, reported at the
                    // array. Same no-false-positives argument as E048:
                    // __set_index is parser-internal and the self-host +
                    // stdlib were migrated off subscript assignment to
                    // `arr = arr.with(i, v)`.
                    if (id.name == "__set_index" && c.args.len() == 3) {
                        out = out.append(dg_at("E056", "cannot assign to an array element: subscripts are read-only after construction; use `arr = arr.with(i, value)`", expr_line(c.args[0]), expr_col(c.args[0])));
                    }
                    // E057: cell_new(v) — a Cell's element type must be
                    // cycle-free, i.e. a scalar (i32/i64/f64/bool) or string.
                    // A composite / reference value (struct, array, tuple,
                    // another Cell, …) could reconstruct a reference cycle,
                    // which the immutable-data model forbids so Perceus RC
                    // needs no cycle collector (docs/CELL-TYPE-PLAN.md).
                    // Reported at the argument, matching the Go checker
                    // (n.Args[0].Pos()). An unresolved arg type is skipped.
                    if (id.name == "cell_new" && c.args.len() == 1) {
                        var cnat: Type = check_expr(c.args[0], s);
                        if (!is_unknown(cnat) && !is_primitive_type(cnat)) {
                            out = out.append(dg_at("E057", "Cell[" + type_label(cnat) + "] is not allowed: a cell's element type must be a scalar (i32/i64/f64/bool) or string; a composite/reference type could form a cycle, which immutable data structures forbid", expr_line(c.args[0]), expr_col(c.args[0])));
                        }
                    }
                    if (is_unknown(s.lookup(id.name))) {
                        var sig: FuncSig = s.lookup_sig(id.name);
                        // E040: a GENERIC function called with explicit
                        // call-site type arguments whose count doesn't match
                        // its declared type-parameter count. Only fires for an
                        // actually-generic function (type_param_count > 0) when
                        // type args were written (`f[i32](x)`); a bare call
                        // relies on inference, and type args on a non-generic
                        // function are ignored (matching the Go checker).
                        if (sig.name.len() > 0 && sig.type_param_count > 0 && c.type_argc > 0 && c.type_argc != sig.type_param_count) {
                            out = out.append(dg_at("E040", id.name + " expects " + itoa_nn(sig.type_param_count) + " type argument(s), got " + itoa_nn(c.type_argc), c.line, c.col));
                        }
                        if (sig.name.len() > 0) {
                            if (c.args.len() != sig.param_types.len()) {
                                out = out.append(dg_at("E004", "function expects " + itoa_nn(sig.param_types.len()) + " arguments, got " + itoa_nn(c.args.len()), c.line, c.col));
                            } else {
                                // E038: per-argument type mismatch (only when
                                // the arity matches, so indices line up).
                                var ai: i32 = 0;
                                while (ai < c.args.len()) {
                                    var at: Type = check_expr(c.args[ai], s);
                                    // E021 (#4842): generic-bound conformance. When
                                    // param ai is a bare bounded type param `x: T`
                                    // (T: Tr), the argument's concrete type must
                                    // provide `impl Tr`. Runs before the E038 skip
                                    // because a bounded param's declared type is the
                                    // erased-unknown T (E038 itself skips it).
                                    if (ai < sig.param_bound.len() && sig.param_bound[ai].len() > 0 && !is_unknown(at)) {
                                        out = append_diags(out, e021_bound_call_diag(sig.param_bound[ai], at, s, expr_line(c.args[ai]), expr_col(c.args[ai])));
                                    }
                                    // An unknown PARAM type is an opaque generic
                                    // parameter (`f[T](x: T)`, where T erases to
                                    // unknown) — the arg can't be checked against
                                    // it, so skip rather than mis-flag E038. (An
                                    // unknown ARG is already skipped above.)
                                    if (!is_unknown(at) && !is_unknown(sig.param_types[ai]) && !type_assignable(at, sig.param_types[ai], s.unions)) {
                                        out = out.append(dg_at("E038", "argument " + itoa_nn(ai + 1) + ": expected " + type_label(sig.param_types[ai]) + ", got " + type_label(at), expr_line(c.args[ai]), expr_col(c.args[ai])));
                                    }
                                    // E034: a composite-array literal argument's
                                    // elements checked against the parameter's
                                    // declared element type (the array as a whole
                                    // is assignable, so the E038 above stays
                                    // silent — this catches a bad element).
                                    out = append_diags(out, array_elem_check(array_elem_type_of(sig.param_types[ai]), c.args[ai], s));
                                    ai = ai + 1;
                                }
                            }
                        }
                    }
                },
                parser.ExprFieldAccess(mfa) => {
                    // E004 for a method call `obj.m(args)`: when `obj` is a
                    // known struct with a USER-DEFINED method `m`, the
                    // explicit-argument count must match the method's
                    // declared parameter count (the receiver is stored
                    // separately, so param_types already excludes `self`).
                    // Built-in methods (.len / .push / .write …) and
                    // non-struct receivers aren't in the method table, so
                    // lookup returns empty and they're left alone.
                    var recv: Type = check_expr(mfa.obj, s);
                    match (recv) {
                        // E043: a method call on a numeric scalar receiver
                        // (`x.m(...)` where x is i32 or f64) for which no method
                        // `m` is declared on that type. Fern allows user-defined
                        // methods on primitives (`function (n: i32) twice()`), so
                        // we only flag the call when the method table has no such
                        // method — then it's a field access on a non-struct,
                        // mirroring the Go checker, which resolves the method,
                        // finds none, and reports E043. The lookup keys on the
                        // receiver's width-aware label (int_label) so a method
                        // declared on i64 / u32 / u64 resolves too, not just i32.
                        // A declared method, and string / array / map receivers
                        // (whose builtin methods route elsewhere), stay clean.
                        TypeI32(it) => {
                            if (s.lookup_method(mfa.field, int_label(it)).name.len() == 0) {
                                out = out.append(dg_at("E043", "field access on non-struct value of type " + type_label(recv), mfa.line, mfa.col));
                            }
                        },
                        TypeFloat(_) => {
                            if (s.lookup_method(mfa.field, "f64").name.len() == 0) {
                                out = out.append(dg_at("E043", "field access on non-struct value of type " + type_label(recv), mfa.line, mfa.col));
                            }
                        },
                        TypeString(_) => {
                            // E043: a string carries exactly two builtin methods
                            // — `len` and `as_bytes` (mirrors registerStringMethod
                            // in the Go checker). Any other method must be
                            // user-defined (in scope via a `function (s: string)
                            // m()` decl, typically from std/string); when it's
                            // neither builtin nor user-defined, it's a call to a
                            // non-existent method — same shape as the numeric-
                            // scalar case above.
                            if (mfa.field != "len" && mfa.field != "as_bytes" && s.lookup_method(mfa.field, "string").name.len() == 0) {
                                out = out.append(dg_at("E043", "field access on non-struct value of type " + type_label(recv), mfa.line, mfa.col));
                            }
                        },
                        TypeArray(ar) => {
                            // E038: a built-in array method whose argument must
                            // match the element type. `append(elem)` takes the
                            // element; `with(i32, elem)` replaces at an index, so
                            // its second argument is the element. Mirrors the Go
                            // checker, which types these builtins and reports a
                            // per-argument mismatch. An unknown element type
                            // (uninferred receiver) or unknown arg is skipped.
                            if (mfa.field == "append" && c.args.len() == 1 && !is_unknown(ar.elem)) {
                                var aat: Type = check_expr(c.args[0], s);
                                if (!is_unknown(aat) && !type_assignable(aat, ar.elem, s.unions)) {
                                    out = out.append(dg_at("E038", "argument 1 to \"append\": expected " + type_label(ar.elem) + ", got " + type_label(aat), expr_line(c.args[0]), expr_col(c.args[0])));
                                }
                            }
                            if (mfa.field == "with" && c.args.len() == 2 && !is_unknown(ar.elem)) {
                                var wvt: Type = check_expr(c.args[1], s);
                                if (!is_unknown(wvt) && !type_assignable(wvt, ar.elem, s.unions)) {
                                    out = out.append(dg_at("E038", "argument 2 to \"with\": expected " + type_label(ar.elem) + ", got " + type_label(wvt), expr_line(c.args[1]), expr_col(c.args[1])));
                                }
                            }
                            // E043 (array method existence): only `append` / `with`
                            // / `len` are unconditional array builtins. Every other
                            // method is an auto-discovered std/array function —
                            // `__method_Array_<name>`, in scope only when std/array
                            // is imported — or a user-defined array method. When the
                            // call is none of those it names a non-existent method.
                            // Mirrors the Go checker, which registers append/with/len
                            // unconditionally and resolves the rest from the imported
                            // module (so `a.sum()` without `import "std/array"` is
                            // E043, but resolves with it). User methods on a raw
                            // array type aren't a case — Go forbids them (E021) — so
                            // only the builtins + auto-discovered functions count.
                            if (mfa.field != "append" && mfa.field != "with" && mfa.field != "len"
                                    && !s.has_array_method(mfa.field)) {
                                out = out.append(dg_at("E043", "field access on non-struct value of type " + type_label(recv), mfa.line, mfa.col));
                            }
                        },
                        TypeStruct(sn) => {
                            var msig: MethodSig = s.lookup_method(mfa.field, sn.name);
                            if (msig.name.len() > 0) {
                                if (c.args.len() != msig.param_types.len()) {
                                    out = out.append(dg_at("E004", "method \"" + mfa.field + "\" expects " + itoa_nn(msig.param_types.len()) + " argument(s), got " + itoa_nn(c.args.len()), c.line, c.col));
                                } else {
                                    // E038: per-argument type mismatch on a
                                    // user-defined method. Now that
                                    // type_assignable resolves array / struct /
                                    // union / qualified types and treats
                                    // `unknown` as a wildcard, the full
                                    // assignability check is sound on real code
                                    // (verified across all self-host modules) —
                                    // no longer restricted to primitives.
                                    var mi: i32 = 0;
                                    while (mi < c.args.len()) {
                                        var mat: Type = check_expr(c.args[mi], s);
                                        // Skip an opaque generic param type (see
                                        // the free-function E038 note above).
                                        if (!is_unknown(mat) && !is_unknown(msig.param_types[mi]) && !type_assignable(mat, msig.param_types[mi], s.unions)) {
                                            out = out.append(dg_at("E038", "argument " + itoa_nn(mi + 1) + " to \"" + mfa.field + "\": expected " + type_label(msig.param_types[mi]) + ", got " + type_label(mat), expr_line(c.args[mi]), expr_col(c.args[mi])));
                                        }
                                        // E034: composite-array method argument
                                        // elements vs the parameter element type.
                                        out = append_diags(out, array_elem_check(array_elem_type_of(msig.param_types[mi]), c.args[mi], s));
                                        mi = mi + 1;
                                    }
                                }
                            } else {
                                // A call `obj.m(...)` on a known struct with no
                                // method `m`. Resolve `m` as a field (mirroring
                                // the Go checker, which falls through to the
                                // field after the method lookup misses):
                                //   - not a field        → E043 (no such member)
                                //   - field, function-typed → ok (closure-field
                                //     call: `p.handler()` where handler: () => T)
                                //   - field, non-function → E038 (calling a
                                //     non-function value)
                                // A present, function-typed field is the only
                                // valid case, so neither diagnostic false-fires
                                // on real method or closure-field calls.
                                var fsig: StructSig = s.lookup_struct(sn.name);
                                if (fsig.name.len() > 0) {
                                    var fldi: i32 = field_index(fsig, mfa.field);
                                    if (fldi < 0) {
                                        out = out.append(dg_at("E043", "struct " + sn.name + " has no field \"" + mfa.field + "\"", mfa.line, mfa.col));
                                    } else {
                                        var fldt: Type = fsig.field_types[fldi];
                                        var fld_is_fn: boolean = false;
                                        match (fldt) {
                                            TypeFunc(_) => { fld_is_fn = true; },
                                            _ => { }
                                        }
                                        if (!fld_is_fn) {
                                            out = out.append(dg_at("E038", "calling non-function value of type " + type_label(fldt), mfa.line, mfa.col));
                                        }
                                    }
                                }
                            }
                        },
                        _ => { }
                    }
                },
                _ => { }
            }
        },
        parser.ExprBinary(b) => {
            out = append_diags(call_diags(b.left, s), call_diags(b.right, s));
            // E009: `&&` / `||` require both operands to be boolean.
            if (b.op == "&&" || b.op == "||") {
                var lt: Type = check_expr(b.left, s);
                if (!is_unknown(lt) && !type_eq(lt, t_bool())) {
                    out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(lt), b.line, b.col));
                }
                var rt: Type = check_expr(b.right, s);
                if (!is_unknown(rt) && !type_eq(rt, t_bool())) {
                    out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(rt), b.line, b.col));
                }
            }
            // E041: `==` / `!=` require same-typed operands (the same rule
            // check_expr applies). Ordering ops on mismatched types are
            // E009 instead, so they're not handled here.
            if (b.op == "==" || b.op == "!=") {
                var elt: Type = check_expr(b.left, s);
                var ert: Type = check_expr(b.right, s);
                if (!is_unknown(elt) && !is_unknown(ert) && !type_eq(elt, ert)) {
                    out = out.append(dg_at("E041", "cannot compare " + type_label(elt) + " and " + type_label(ert), b.line, b.col));
                } else if (!is_unknown(elt) && type_eq(elt, ert) && is_composite_type(elt)) {
                    // Composite `==` / `!=` would mean heap-pointer identity,
                    // not value equality. Reject it (the native compiler
                    // routes it to a structural `Eq` impl; the self-host has
                    // no traits yet).
                    out = out.append(dg_at("E041", "cannot compare " + type_label(elt) + " values with \"" + b.op + "\": composite (struct / enum / array / tuple) equality is not supported", b.line, b.col));
                }
            }
            // E009: `+` is overloaded — both string (concat), both i32, or
            // both f64; anything else is an operand error. `-` / `*` / `/`
            // need matching i32 or f64, `%` matching i32 only. Same rules
            // check_expr applies, so this fires only where it already
            // rejects the operands (no new false positives).
            if (b.op == "+") {
                var pl: Type = check_expr(b.left, s);
                var pr: Type = check_expr(b.right, s);
                if (!is_unknown(pl) && !is_unknown(pr)) {
                    var oks: boolean = type_eq(pl, t_string()) && type_eq(pr, t_string());
                    var oki2: boolean = type_eq(pl, t_i32()) && type_eq(pr, t_i32());
                    var okf2: boolean = type_eq(pl, t_float()) && type_eq(pr, t_float());
                    if (!oks && !oki2 && !okf2) {
                        out = out.append(dg_at("E009", "operator \"+\" requires matching numeric or string operands, got " + type_label(pl) + " and " + type_label(pr), b.line, b.col));
                    }
                }
            }
            if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
                var alt: Type = check_expr(b.left, s);
                var art: Type = check_expr(b.right, s);
                if (!is_unknown(alt) && !is_unknown(art)) {
                    var oki: boolean = type_eq(alt, t_i32()) && type_eq(art, t_i32());
                    var okf: boolean = b.op != "%" && type_eq(alt, t_float()) && type_eq(art, t_float());
                    if (!oki && !okf) {
                        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching numeric operands, got " + type_label(alt) + " and " + type_label(art), b.line, b.col));
                    }
                }
            }
            // E009: shift / bitwise ops (`<<` `>>` `&` `|` `^`) require both
            // operands to be integers. Mirrors the Go checker's requireInteger
            // for `case "%", "&", "|", "^", "<<", ">>"` (`%` is in the numeric
            // group above). `&&` / `||` are the logical ops, handled separately.
            if (b.op == "<<" || b.op == ">>" || b.op == "&" || b.op == "|" || b.op == "^") {
                var slt: Type = check_expr(b.left, s);
                var srt: Type = check_expr(b.right, s);
                if (!is_unknown(slt) && !type_eq(slt, t_i32())) {
                    out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(slt), b.line, b.col));
                } else if (!is_unknown(srt) && !type_eq(srt, t_i32())) {
                    out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(srt), b.line, b.col));
                }
            }
            // E009: ordering ops (`<` `>` `<=` `>=`) require both operands to be
            // the same numeric type (both i32 or both f64). Mirrors the Go
            // checker (requireInteger, or requireFloat when either side is
            // float). `==` / `!=` (equality, E041) are handled above.
            if (b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") {
                var olt: Type = check_expr(b.left, s);
                var ort: Type = check_expr(b.right, s);
                if (!is_unknown(olt) && !is_unknown(ort)) {
                    var oki_o: boolean = type_eq(olt, t_i32()) && type_eq(ort, t_i32());
                    var okf_o: boolean = type_eq(olt, t_float()) && type_eq(ort, t_float());
                    if (!oki_o && !okf_o) {
                        if (type_eq(olt, ort) && is_composite_type(olt)) {
                            // E041: ordering two values of the SAME composite
                            // type (struct / enum / array / tuple) would mean a
                            // structural comparison the self-host has no `Ord`
                            // for. Mirrors the Go checker, which routes
                            // same-composite ordering to E041 — mixed
                            // composite/scalar operands, or two differing types,
                            // stay E009 (verified against the Go checker).
                            out = out.append(dg_at("E041", "cannot order " + type_label(olt) + " values with \"" + b.op + "\": composite (struct / enum / array / tuple) ordering is not supported", b.line, b.col));
                        } else {
                            out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching numeric operands, got " + type_label(olt) + " and " + type_label(ort), b.line, b.col));
                        }
                    }
                }
            }
        },
        parser.ExprUnary(u) => {
            out = call_diags(u.operand, s);
            // E009: `!` requires a boolean operand.
            if (u.op == "!") {
                var ot: Type = check_expr(u.operand, s);
                if (!is_unknown(ot) && !type_eq(ot, t_bool())) {
                    out = out.append(dg_at("E009", "operator \"!\" requires boolean, got " + type_label(ot), u.line, u.col));
                }
            }
            // E009: unary `-` (negation) requires a numeric (i32 / f64) operand.
            // Mirrors the Go checker (requireInteger / requireFloat for unary
            // minus); a string / bool / composite operand is rejected.
            if (u.op == "-") {
                var nt: Type = check_expr(u.operand, s);
                if (!is_unknown(nt) && !type_eq(nt, t_i32()) && !type_eq(nt, t_float())) {
                    out = out.append(dg_at("E009", "operator \"-\" requires a numeric type, got " + type_label(nt), u.line, u.col));
                }
            }
            // E033: an invalid `as` cast. `x as T` desugars to the
            // unary op `as_<T>` (operand = x). The Go checker allows
            // numeric↔numeric casts plus the string↔i32 data-pointer
            // hops; everything else is E033. The self-host models a
            // sound, zero-false-positive subset over the scalar types it
            // knows (i32 / f64 / bool / string): identity, numeric↔numeric
            // and string↔i32 are accepted (`as_cast_allowed`); any
            // bool↔non-bool or f64↔string is E033. Both sides are guarded
            // by `is_primitive_type`, so struct / array / string→i32
            // pointer hops and wider-int targets (u32 / i64 → unknown)
            // are left to the Go checker — no false positives. Positioned
            // at the `as` keyword to match the Go checker (whose CastExpr
            // position is the `as` token).
            if (u.op.len() > 3 && u.op[0:3] == "as_") {
                var tgt: Type = type_from_name(u.op[3:u.op.len()]);
                var cot: Type = check_expr(u.operand, s);
                if (is_primitive_type(tgt) && is_primitive_type(cot)) {
                    // E069 (#5053): reinterpreting a 32-bit-only value (i32 /
                    // u32) as `string` via `as` truncates a pointer — the high
                    // 32 bits were lost when the value became i32, so this
                    // recovers a corrupt pointer once the heap exceeds 4 GiB
                    // (arm64-darwin). A `usize` source is pointer-width and
                    // stays allowed — but `usize` types to `unknown` here (not
                    // a primitive), so it never reaches this arm: the guard is
                    // zero-false-positive over the primitives the self-host
                    // knows. Only the `string` target is modelled (an array /
                    // struct target is not is_primitive_type here), matching the
                    // sound-subset conservatism of E033/E042 above; the Go
                    // checker carries the full array/struct-target rule.
                    if (type_eq(tgt, t_string()) && (type_eq(cot, t_i32()) || type_eq(cot, t_u32()))) {
                        out = out.append(dg_at("E069", "reinterpreting a 32-bit " + type_label(cot) + " value as the pointer-shaped type string via `as` truncates the address; carry pointer-shaped values in a usize local/param instead", u.line, u.col));
                    }
                    else if (!as_cast_allowed(cot, tgt)) {
                        out = out.append(dg_at("E033", "cannot cast " + type_label(cot) + " to " + type_label(tgt) + "; only numeric casts (and [u8]/u8[]/string ↔ i32 data-pointer hops, plus i32 → T[]) are supported", u.line, u.col));
                    }
                }
            }
            // E059: an `as?` downcast (`x as? T`, parsed as the unary op
            // `as?_<T>`) requires a `dyn Trait` value on the left. The self-
            // host has no dyn-trait Type — a real `dyn Trait` value resolves
            // to `unknown` here — so a CONCRETE scalar primitive operand
            // (i32 / f64 / bool / string) can never be a dyn value and is
            // flagged, while an unknown (possibly-dyn) operand is left alone.
            // Same sound, zero-false-positive conservatism as E033 / E042.
            if (u.op.len() > 4 && u.op[0:4] == "as?_") {
                var aot: Type = check_expr(u.operand, s);
                if (is_primitive_type(aot)) {
                    out = out.append(dg_at("E059", "`as?` downcast requires a `dyn Trait` value on the left, got " + type_label(aot), u.line, u.col));
                }
            }
            // E042: the `?` try operator (parsed as the unary op `try_`)
            // requires an Option or Result operand. The self-host models a
            // sound, zero-false-positive subset: when the operand is a known
            // scalar primitive (i32 / bool / string / f64) it can never be an
            // Option/Result, so flag it. Option/Result-typed operands type to
            // struct / union / unknown here (never a primitive), so legal `?`
            // uses are left untouched — mirroring the E033/E034 conservatism.
            if (u.op == "try_") {
                var trt: Type = check_expr(u.operand, s);
                if (is_primitive_type(trt)) {
                    out = out.append(dg_at("E042", "`?` operator requires an Option or Result value, got " + type_label(trt), u.line, u.col));
                }
                // E042 return-shape (#4363 item 1): `?` on a KNOWN
                // Option/Result operand additionally requires the
                // surrounding function to return the same builtin enum.
                // Sound subset of the Go rule: only fires when the
                // declared return type resolved to a KNOWN primitive —
                // never a possible Option/Result — so an unknown / union
                // / struct / undeclared return is left to the Go checker
                // and every legal `?` (whose return types to the matching
                // name-only union) is untouched. Mismatched-enum returns
                // (`?` on Option in a Result-returning fn) are also left
                // to the Go checker: the name-only union can't render the
                // return's generic args the way the native message does.
                else {
                    match (trt) {
                        TypeUnion(tu) => {
                            if (tu.name == "Option" && is_primitive_type(s.ret_type)) {
                                out = out.append(dg_at("E042", "`?` on Option requires the surrounding function to return Option[_], got " + e042_ret_label(s.ret_type), u.line, u.col));
                            }
                            else if (tu.name == "Result" && is_primitive_type(s.ret_type)) {
                                out = out.append(dg_at("E042", "`?` on Result requires the surrounding function to return Result[_, E], got " + e042_ret_label(s.ret_type), u.line, u.col));
                            }
                        },
                        _ => { }
                    }
                }
            }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, call_diags(a.elements[i], s)); i = i + 1; }
            // E034: heterogeneous array literal. Anchor on the first
            // element's type and flag the first later element whose type
            // differs. Conservative: only fires when every type involved
            // is a known PRIMITIVE (i32 / bool / string / f64), so it
            // never trips on arrays of structs / enums / nested arrays
            // (whose union-widening the Go checker handles and this port
            // doesn't yet). The Go checker reports E034 at the element.
            if (a.elements.len() >= 2) {
                var et0: Type = check_expr(a.elements[0], s);
                if (is_primitive_type(et0)) {
                    var k: i32 = 1;
                    var flagged: boolean = false;
                    while (k < a.elements.len() && !flagged) {
                        var etk: Type = check_expr(a.elements[k], s);
                        if (is_primitive_type(etk) && !type_eq(etk, et0)) {
                            out = out.append(dg_at("E034", "array element type " + type_label(etk) + ", expected " + type_label(et0), expr_line(a.elements[k]), expr_col(a.elements[k])));
                            flagged = true;
                        }
                        k = k + 1;
                    }
                }
            }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, call_diags(t.elements[i], s)); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(call_diags(ix.array, s), call_diags(ix.index, s));
            // E034: an array / string index must be an i32. Mirrors the Go
            // checker's Index case (index type != i32 -> E034 at the index
            // position). A missing / unknown index type is skipped (no cascade).
            var ixt: Type = check_expr(ix.index, s);
            if (!is_unknown(ixt) && !type_eq(ixt, t_i32())) {
                out = out.append(dg_at("E034", "index must be an integer, got " + type_label(ixt), expr_line(ix.index), expr_col(ix.index)));
            }
            // E034: the indexed value must be an array or string. Mirrors the Go
            // checker ("indexing non-array value"); a non-array/string (i32 /
            // struct / map / …) operand is rejected. Unknown is skipped.
            var iarrt: Type = check_expr(ix.array, s);
            var idxable: boolean = false;
            match (iarrt) {
                TypeArray(_) => { idxable = true; },
                TypeString(_) => { idxable = true; },
                _ => { }
            }
            if (!is_unknown(iarrt) && !idxable) {
                out = out.append(dg_at("E034", "indexing non-array value of type " + type_label(iarrt), expr_line(ix.array), expr_col(ix.array)));
            }
        },
        parser.ExprSlice(s2) => {
            out = append_diags(call_diags(s2.array, s), append_diags(call_diags(s2.start, s), call_diags(s2.end, s)));
            // E037: a present slice bound must be i32. A missing bound
            // (`s[:]`, `s[a:]`) parses to an unknown placeholder — skip it.
            var sbt: Type = check_expr(s2.start, s);
            if (!is_unknown(sbt) && !type_eq(sbt, t_i32())) {
                out = out.append(dg_at("E037", "slice low bound must be i32, got " + type_label(sbt), expr_line(s2.start), expr_col(s2.start)));
            }
            var ebt: Type = check_expr(s2.end, s);
            if (!is_unknown(ebt) && !type_eq(ebt, t_i32())) {
                out = out.append(dg_at("E037", "slice high bound must be i32, got " + type_label(ebt), expr_line(s2.end), expr_col(s2.end)));
            }
            // E037: the sliced value must be an array or string. Mirrors the Go
            // checker ("cannot slice value of type T").
            var sarrt: Type = check_expr(s2.array, s);
            var sliceable: boolean = false;
            match (sarrt) {
                TypeArray(_) => { sliceable = true; },
                TypeString(_) => { sliceable = true; },
                _ => { }
            }
            if (!is_unknown(sarrt) && !sliceable) {
                out = out.append(dg_at("E037", "cannot slice value of type " + type_label(sarrt), expr_line(s2.array), expr_col(s2.array)));
            }
        },
        parser.ExprFieldAccess(fa) => {
            // A qualified reference `Enum.Variant` — the object names a declared
            // enum/union (registered as a UnionSig) or a built-in enum (Option /
            // Result / …). This is NOT a value field-read: the object is a type
            // qualifier, not a resolvable value, so recursing into it would
            // mis-fire E001 ("undefined name"). When the field IS one of the
            // enum's variants the reference is well-formed and silent (the Go
            // checker accepts `O.None` / `Color.Red`); when it ISN'T, it's a
            // bad qualified variant — E036, matching Go ("enum X has no variant
            // Y"). Either way the object recursion is skipped. A name bound as a
            // local shadows the enum, so it's a genuine field access — left to
            // the normal path. (Module-qualified names like `parser.Foo` never
            // reach here — modload mangles them to bare names before checking.)
            var is_qual_ref: boolean = false;
            match (fa.obj) {
                parser.ExprIdent(oid) => {
                    if (is_unknown(s.lookup(oid.name))) {
                        var ou: UnionSig = s.lookup_union(oid.name);
                        if (ou.name.len() > 0) {
                            is_qual_ref = true;
                            if (!util.has_str(ou.variants, fa.field)) {
                                out = out.append(dg_at("E036", "enum " + oid.name + " has no variant \"" + fa.field + "\"", fa.line, fa.col));
                            }
                        } else if (is_reserved_enum_name(oid.name)) {
                            is_qual_ref = true;
                            if (mx_builtin_enum_of(fa.field) != oid.name) {
                                out = out.append(dg_at("E036", "enum " + oid.name + " has no variant \"" + fa.field + "\"", fa.line, fa.col));
                            }
                        }
                    }
                },
                _ => { }
            }
            if (is_qual_ref) { return out; }
            out = call_diags(fa.obj, s);
            // E043: a field READ on a struct that has no such field (and no
            // method of that name). Method-call callees never reach here
            // (the ExprCall arm above recurses only into the object), so a
            // field access here is a genuine read.
            var ot: Type = check_expr(fa.obj, s);
            match (ot) {
                TypeStruct(sn) => {
                    var fsig: StructSig = s.lookup_struct(sn.name);
                    if (fsig.name.len() > 0
                            && !util.has_str(fsig.field_names, fa.field)
                            && s.lookup_method(fa.field, sn.name).name.len() == 0) {
                        out = out.append(dg_at("E043", "struct " + sn.name + " has no field \"" + fa.field + "\"", fa.line, fa.col));
                    }
                },
                TypeTuple(tt) => {
                    // E046: a tuple field must be a numeric index in range.
                    var idx: i32 = digit_string_to_i32(fa.field);
                    if (idx < 0) {
                        out = out.append(dg_at("E046", "tuple field access requires a numeric index, got \"" + fa.field + "\"", fa.line, fa.col));
                    } else if (idx >= tt.elements.len()) {
                        out = out.append(dg_at("E046", "tuple has " + itoa_nn(tt.elements.len()) + " elements; index " + itoa_nn(idx) + " is out of range", fa.line, fa.col));
                    }
                },
                // E043: a field READ on a non-struct, non-tuple value (an i32 /
                // string / array / … has no fields). Mirrors the Go checker
                // (`tt` not a StructType -> "field access on non-struct value").
                // An unknown object type is skipped (no cascade). This is a
                // genuine read; method calls (`x.m()`) are an ExprCall callee and
                // never reach here.
                _ => {
                    if (!is_unknown(ot)) {
                        out = out.append(dg_at("E043", "field access on non-struct value of type " + type_label(ot), fa.line, fa.col));
                    }
                }
            }
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) { out = append_diags(out, call_diags(sl.field_values[i], s)); i = i + 1; }
            if (sl.has_base) { out = append_diags(out, call_diags(sl.base, s)); }
            // E043: a provided field's value must be assignable to the
            // declared field type. Only for a known struct; an unresolved
            // value type (`unknown`) is skipped, as is any field name not
            // in the declaration (E005 / unknown-field paths own those).
            var ssig: StructSig = s.lookup_struct(sl.type_name);
            if (ssig.name.len() > 0) {
                var fi: i32 = 0;
                while (fi < sl.field_names.len()) {
                    var fidx: i32 = field_index(ssig, sl.field_names[fi]);
                    if (fidx >= 0) {
                        var ft: Type = ssig.field_types[fidx];
                        var vt: Type = check_expr(sl.field_values[fi], s);
                        if (!is_unknown(ft) && !is_unknown(vt) && !type_assignable(vt, ft, s.unions)) {
                            out = out.append(dg_at("E043", "field \"" + sl.field_names[fi] + "\": expected " + type_label(ft) + ", got " + type_label(vt), expr_line(sl.field_values[fi]), expr_col(sl.field_values[fi])));
                        }
                        // E034: a struct-literal field of composite-array type
                        // whose value is an array literal — its elements checked
                        // against the field's declared element type. The array as
                        // a whole is assignable to the field type, so the E043
                        // above stays silent; this catches a bad element. Same
                        // composite-only + union-widening discipline as the other
                        // positions; runs for plain and update (`...base`) literals.
                        out = append_diags(out, array_elem_check(array_elem_type_of(ft), sl.field_values[fi], s));
                    }
                    fi = fi + 1;
                }
            }
        },
        parser.ExprLambda(lm) => {
            // The lambda body sees the enclosing scope (lexical capture)
            // plus its own params — bind the params so a reference to one
            // isn't mis-flagged as E001.
            var lsc: Scope = s;
            var li: i32 = 0;
            while (li < lm.params.len()) {
                lsc = lsc.bind(lm.params[li].name, type_from_name_with_structs_unions(lm.params[li].type_name, s.structs, s.unions));
                li = li + 1;
            }
            // A return inside the lambda returns from the LAMBDA — thread
            // its declared return type (or unknown when undeclared) so the
            // E042 return-shape check and the return-value walks don't read
            // the enclosing function's return type. Mirrors the lambda-body
            // scope in check_expr's ExprLambda arm.
            if (lm.ret_type.len() > 0) {
                lsc = lsc.with_ret_type(type_from_name_with_structs_unions(lm.ret_type, s.structs, s.unions));
            } else {
                lsc = lsc.with_ret_type(t_unknown("no enclosing function"));
            }
            out = stmts_call_diags(lm.body, lsc);
        },
        parser.ExprIdent(id) => {
            // E036: a payload-bearing variant referenced bare — a union member
            // (`type U = P | Q`, P a struct) or an enum variant with a payload
            // (`A(i32)`) used as a value WITHOUT calling its constructor. Both
            // are registered as a union variant whose backing struct has >= 1
            // field, so `variant_in_unions` is true and the struct has fields;
            // a nullary variant has no backing fields and stays a valid bare
            // value. The constructor CALL form (`P(...)` / `A(5)`) is an
            // ExprCall callee handled elsewhere, so it isn't flagged. Mirrors
            // the Go checker ("variant X expects a payload; call it as X(...)").
            // Checked before E001 — these names DO resolve (as variants), so
            // is_resolvable_value would otherwise let them pass silently.
            if (variant_in_unions(id.name, s.unions) && s.lookup_struct(id.name).field_names.len() > 0) {
                out = out.append(dg_at("E036", "variant " + id.name + " expects a payload; call it as " + id.name + "(...)", id.line, id.col));
            } else if (!is_resolvable_value(id.name, s)) {
                // E001: a bare identifier in VALUE position that resolves to
                // nothing — not a local / param / loop / match binding, a free
                // function or const, an enum/union variant (declared or
                // builtin), or any other value. Call callees are handled in the
                // ExprCall arm (a bare-ident callee is skipped here), so this
                // fires only on value reads, matching where the Go checker's
                // errIdent reports E001.
                out = out.append(dg_at("E001", "undefined name \"" + id.name + "\"", id.line, id.col));
            }
        },
        _ => { }
    }
    return out;
}

// is_collection_mutator names the value-returning collection methods whose
// result must be used — the immutable-looking vocabulary
// (docs/PURE-COLLECTION-API-PLAN.md §3a). Mirrors the Go checker's
// pureCollectionMutators set.
function is_collection_mutator(field: string): boolean {
    return field == "insert" || field == "without" || field == "cleared"
        || field == "with" || field == "append";
}

// e055_diag reports E055 when a bare statement is a value-returning collection
// mutator whose result is discarded (`m.insert(k, v);`, `arr.append(x);`, …).
// Under CoW that silently loses the write the moment an alias exists
// (docs/PURE-COLLECTION-API-PLAN.md §1); the result must be threaded back
// (`m = m.insert(k, v)`) or explicitly dropped (`var _ = …`). Only fires when
// the receiver is a Map or array, so a user method that happens to share the
// name (e.g. HeaderMap.append) is left alone — matching the Go checker's
// narrow scope.
function e055_diag(e: parser.Expr, s: Scope): Diag[] {
    var none: Diag[] = [];
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if (!is_collection_mutator(fa.field)) { return none; }
                    var is_coll: boolean = false;
                    match (check_expr(fa.obj, s)) {
                        TypeMap(_) => { is_coll = true; },
                        TypeArray(_) => { is_coll = true; },
                        _ => { }
                    }
                    if (!is_coll) { return none; }
                    var d: Diag[] = [dg_at("E055", "result of `." + fa.field + "(...)` is unused; assign it back (e.g. `x = x." + fa.field + "(...)`) — collection operations return a new value, they do not mutate in place", fa.line, fa.col)];
                    return d;
                },
                _ => { return none; }
            }
        },
        _ => { return none; }
    }
    return none;
}

// stmts_call_diags walks a statement list, threading scope (so a callee
// name shadowed by a local `var` is recognised as a local, not the
// function) and collecting the E004s from every expression.
// typed_array_elem_diags reports E034 for a typed array-literal binding
// `var x: Elem[] = [ ... ]` whose declared element type is a COMPOSITE
// (struct / enum / union / array / tuple / map) and some element isn't
// assignable to it. Primitive-element arrays (`i32[]`, `string[]`, …) are
// already covered by the first-element-anchored E034 in call_diags, so we
// skip them here to avoid a duplicate diagnostic; this fills the composite
// gap that anchor check deliberately left open. The annotation's element
// type is matched with the union-widening `type_assignable`, so a
// heterogeneous-but-widening literal — e.g. `var xs: Stmt[] = [StmtVar{…},
// StmtReturn{…}]`, ubiquitous in this very compiler — stays clean. Mirrors
// the Go checker, which checks each element against the expected element
// type and reports at the offending element.
// array_elem_type_of returns t's array element type, or `unknown` when t
// isn't an array — the "expected element" feeding array_elem_check.
function array_elem_type_of(t: Type): Type {
    match (t) {
        TypeArray(ad) => { return ad.elem; },
        _ => { return t_unknown("not an array"); }
    }
    return t_unknown("not an array");
}

// array_elem_check is the position-independent core of the typed
// composite-array E034: given the EXPECTED element type and an expression
// that may be an array literal, flag (E034) every element not assignable
// to it. Scoped to COMPOSITE element types — primitive-element arrays are
// covered by the first-element-anchored E034 in call_diags, so they're
// skipped here to avoid a duplicate. Uses the union-widening
// type_assignable, so a heterogeneous-but-widening literal (a `Stmt[]` of
// distinct variant structs) stays clean. Reused from every position where
// the expected element type is statically known: a `: T[]` var binding, a
// `T[]`-returning function's `return`, an assignment to a `T[]` variable,
// and a `T[]` call argument.
function array_elem_check(elem_ty: Type, init: parser.Expr, s: Scope): Diag[] {
    var out: Diag[] = [];
    if (is_unknown(elem_ty) || is_primitive_type(elem_ty)) { return out; }
    match (init) {
        parser.ExprArray(arr) => {
            var k: i32 = 0;
            while (k < arr.elements.len()) {
                var ekt: Type = check_expr(arr.elements[k], s);
                if (!is_unknown(ekt) && !type_assignable(ekt, elem_ty, s.unions)) {
                    out = out.append(dg_at("E034", "array element type " + type_label(ekt) + ", expected " + type_label(elem_ty), expr_line(arr.elements[k]), expr_col(arr.elements[k])));
                }
                k = k + 1;
            }
        },
        _ => { }
    }
    return out;
}

function typed_array_elem_diags(type_name: string, init: parser.Expr, s: Scope): Diag[] {
    if (type_name.len() == 0) { return []; }
    var declared: Type = type_from_name_with_structs_unions(type_name, s.structs, s.unions);
    return array_elem_check(array_elem_type_of(declared), init, s);
}

function stmts_call_diags(stmts: parser.Stmt[], s: Scope): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => {
                // A function-valued local (`var f = function(...) {...}`,
                // including a desugared local function declaration) must be
                // in scope inside its own body — so a recursive self-call
                // resolves rather than reporting E001 — and for the
                // statements that follow it. Bind it to its function type
                // before walking the init.
                var vsc: Scope = cur;
                match (v.init) {
                    parser.ExprLambda(lm) => {
                        var fpts: Type[] = [];
                        var fpi: i32 = 0;
                        while (fpi < lm.params.len()) {
                            fpts = fpts.append(type_from_name_with_structs_unions(lm.params[fpi].type_name, cur.structs, cur.unions));
                            fpi = fpi + 1;
                        }
                        vsc = cur.bind(v.name, t_func(fpts, type_from_name_with_structs_unions(lm.ret_type, cur.structs, cur.unions)));
                        cur = vsc;
                    },
                    _ => { }
                }
                out = append_diags(out, call_diags(v.init, vsc));
                out = append_diags(out, typed_array_elem_diags(v.type_name, v.init, vsc));
            },
            parser.StmtReturn(r) => {
                out = append_diags(out, call_diags(r.value, cur));
                // E034: a composite-array `return` value's elements checked
                // against the function's declared element type (top-level
                // stmts carry an unknown ret_type sentinel and are skipped).
                out = append_diags(out, array_elem_check(array_elem_type_of(cur.ret_type), r.value, cur));
            },
            parser.StmtExpr(x) => {
                out = append_diags(out, call_diags(x.value, cur));
                out = append_diags(out, e055_diag(x.value, cur));
            },
            parser.StmtAssign(a) => {
                out = append_diags(out, call_diags(a.value, cur));
                // E034: reassigning a composite-array literal — its elements
                // checked against the target variable's declared element type.
                out = append_diags(out, array_elem_check(array_elem_type_of(cur.lookup(a.target)), a.value, cur));
            },
            parser.StmtIf(f) => {
                out = append_diags(out, call_diags(f.cond, cur));
                out = append_diags(out, stmts_call_diags(f.then_body, cur));
                out = append_diags(out, stmts_call_diags(f.else_body, cur));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, call_diags(w.cond, cur));
                out = append_diags(out, stmts_call_diags(w.body, cur));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, call_diags(fr.iter, cur));
                // Bind the loop variable(s) so a read of one inside the body
                // isn't mis-flagged as E001.
                out = append_diags(out, stmts_call_diags(fr.body, bind_names(cur, fr.var_name)));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, call_diags(m.scrutinee, cur));
                // E035: a `match` on a non-enum (primitive) scrutinee only
                // accepts literal patterns or `_`. A named variant pattern
                // (`Foo`, `Some(x)`) over an i32 / string / f64 / bool
                // scrutinee is the error, reported at the arm. Literal
                // patterns parse to empty-name variants (skipped here), and
                // `true` / `false` are literal bool patterns (also skipped),
                // so this fires only on genuine variant patterns.
                var mst: Type = check_expr(m.scrutinee, cur);
                // E022 / E023: a match synthesised from `if let` / `let … else`
                // (origin != "") carries the dedicated pattern-binding
                // diagnostics the Go checker emits on the LetElse / IfLet nodes,
                // rather than the generic E035 the desugared shape would draw.
                // The scrutinee must be an enum value (typed TypeUnion here —
                // enums register as union sigs); a primitive / struct source is
                // E022. For `let … else`, the else branch (the trailing wildcard
                // arm) must additionally diverge.
                if (m.origin == "if_let" || m.origin == "let_else") {
                    var src_is_enum: boolean = false;
                    var src_unknown_enum: boolean = false;
                    match (mst) {
                        TypeUnion(su) => {
                            src_is_enum = true;
                            // E023: the source types to an enum the checker
                            // doesn't know — the unknown-BASE generic
                            // annotation shape (`s: Statuus[i32]`), which
                            // type_from_ref_su resolves to a name-only union
                            // that lookup_union misses. The Go checker reports
                            // E023 at the source and skips the binding checks.
                            // Reserved builtin enums (Option/Result/…) are
                            // always known to the Go checker — never E023.
                            if (cur.lookup_union(su.name).name.len() == 0 && !is_reserved_enum_name(su.name)) {
                                src_unknown_enum = true;
                                out = out.append(dg_at("E023", "unknown enum \"" + su.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
                            }
                        },
                        _ => { }
                    }
                    var kind_label: string = "if-let";
                    if (m.origin == "let_else") { kind_label = "let-else"; }
                    if (!src_is_enum && !is_unknown(mst)) {
                        out = out.append(dg_at("E022", kind_label + " source must be an enum value, got " + type_label(mst), expr_line(m.scrutinee), expr_col(m.scrutinee)));
                    } else if (m.origin == "let_else" && src_is_enum && !src_unknown_enum) {
                        // The else block is the synthesised trailing `_` arm; it
                        // must diverge (return / break / continue) so the
                        // bindings are live for the fall-through path.
                        var le_last: i32 = m.arms.len() - 1;
                        if (le_last >= 0 && !block_exits(m.arms[le_last].body)) {
                            out = out.append(dg_at("E022", "let-else: else branch must diverge (return / break / continue)", m.line, m.col));
                        }
                    }
                }
                if (is_primitive_type(mst) && m.origin == "") {
                    var ea: i32 = 0;
                    while (ea < m.arms.len()) {
                        match (m.arms[ea].pattern) {
                            parser.PatVariant(epv) => {
                                if (epv.type_name.len() > 0 && epv.type_name != "true" && epv.type_name != "false") {
                                    out = out.append(dg_at("E035", "match on non-enum value `" + type_label(mst) + "` only accepts literal patterns or `_`", m.arms[ea].line, m.arms[ea].col));
                                }
                            },
                            _ => { }
                        }
                        ea = ea + 1;
                    }
                }
                // E030: a `match` on a union scrutinee must cover every
                // variant or carry a `_` arm. Reported at the `match`
                // keyword (Go's `n.P`). Each uncovered variant is one
                // diagnostic (matching Go). Scrutinees that don't resolve to
                // a known union are skipped, so this never fires on the
                // union matches throughout the bundle (all exhaustive or
                // wildcarded) — verified across every self-host module.
                match (mst) {
                    TypeUnion(mun) => {
                        var usig: UnionSig = cur.lookup_union(mun.name);
                        // E023: a plain `match` on a value whose type is an
                        // enum the checker doesn't know (the unknown-BASE
                        // generic annotation shape — see type_from_ref_su).
                        // Reported at the scrutinee, like the Go checker's
                        // checkMatch/checkMatchExpr; the arm checks below are
                        // skipped (usig missed). if-let / let-else report
                        // theirs in the origin block above — don't double up.
                        if (usig.name.len() == 0 && !is_reserved_enum_name(mun.name) && m.origin == "") {
                            out = out.append(dg_at("E023", "unknown enum \"" + mun.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
                        }
                        if (usig.name.len() > 0) {
                            var saw_wild: boolean = false;
                            var covered: string[] = [];
                            var ca: i32 = 0;
                            while (ca < m.arms.len()) {
                                match (m.arms[ca].pattern) {
                                    parser.PatWildcard(_) => { saw_wild = true; },
                                    parser.PatVariant(cpv) => {
                                        if (cpv.type_name.len() > 0) {
                                            var cdp: i32 = dot_index(cpv.type_name);
                                            if (cdp >= 0) {
                                                // Qualified pattern `Qual.Variant`.
                                                var cqual: str = cpv.type_name[0:cdp];
                                                var cbare: str = cpv.type_name[cdp + 1:cpv.type_name.len()];
                                                if (cqual == mun.name) {
                                                    // Correctly qualified — an UNGUARDED arm covers
                                                    // the bare variant. A guarded arm may fall
                                                    // through, so it does NOT count toward
                                                    // exhaustiveness (#4344).
                                                    if (!m.arms[ca].has_guard) { covered = covered.append(cbare); }
                                                    if (!util.has_str(usig.variants, cbare)) {
                                                        out = out.append(dg_at("E014", "variant \"" + cbare + "\" is not part of enum " + mun.name, m.arms[ca].line, m.arms[ca].col));
                                                    }
                                                } else if (cur.lookup_union(cqual).name.len() > 0) {
                                                    // E029: qualifier is a known enum/union, but
                                                    // not the scrutinee's.
                                                    out = out.append(dg_at("E029", "variant pattern qualifier \"" + cqual + "\" does not match scrutinee enum " + mun.name, m.arms[ca].line, m.arms[ca].col));
                                                }
                                                // (unknown qualifier: Go reports a module-source
                                                // mismatch this port doesn't model — left alone.)
                                            } else {
                                                // Only an UNGUARDED arm covers its variant for
                                                // exhaustiveness; a guarded arm may fall through
                                                // (#4344). E014 (below) still fires for a guarded
                                                // arm naming a foreign variant.
                                                if (!m.arms[ca].has_guard) { covered = covered.append(cpv.type_name); }
                                                // E014: a variant pattern that names
                                                // something outside the scrutinee's
                                                // enum/union, reported at the arm.
                                                if (!util.has_str(usig.variants, cpv.type_name)) {
                                                    out = out.append(dg_at("E014", "variant \"" + cpv.type_name + "\" is not part of enum " + mun.name, m.arms[ca].line, m.arms[ca].col));
                                                }
                                            }
                                        }
                                    },
                                }
                                ca = ca + 1;
                            }
                            if (!saw_wild) {
                                var vi: i32 = 0;
                                while (vi < usig.variants.len()) {
                                    if (!util.has_str(covered, usig.variants[vi])) {
                                        out = out.append(dg_at("E030", "match is not exhaustive — variant " + usig.variants[vi] + " of enum " + mun.name + " is not covered (add an arm or use `_`)", m.line, m.col));
                                    }
                                    vi = vi + 1;
                                }
                            }
                        }
                    },
                    _ => { }
                }
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    // Bring the variant payload binding into the arm's
                    // scope (as `TypeStruct(variant)`) before walking the
                    // body, so a field access on it (`TokIdent(t) => t.name`)
                    // resolves against the right struct instead of tripping
                    // a spurious E043. Mirrors the body-check path's binding.
                    var armScope: Scope = cur;
                    match (m.arms[a].pattern) {
                        parser.PatVariant(apv) => {
                            // Don't bind the payloads of a FOREIGN variant
                            // (one not in the scrutinee union) — their reads
                            // are then genuinely undefined (E001), matching
                            // the Go checker, which reports both E014 (bad
                            // variant) and E001 (the now-undefined binding).
                            var foreign: boolean = false;
                            match (mst) {
                                TypeUnion(amu) => {
                                    var ausig: UnionSig = cur.lookup_union(amu.name);
                                    if (ausig.name.len() > 0 && !util.has_str(ausig.variants, apv.type_name)) {
                                        foreign = true;
                                    }
                                },
                                _ => { }
                            }
                            if (!foreign) {
                                armScope = bind_variant_payloads(armScope, cur, apv);
                            }
                        },
                        _ => { }
                    }
                    // E027: a match-arm guard (`Pat if <expr> =>`) must be
                    // boolean. Typed in the arm scope so a guard referencing
                    // the pattern binding (`Has(n) if n > 0`) resolves.
                    if (m.arms[a].has_guard) {
                        var gt: Type = check_expr(m.arms[a].guard, armScope);
                        if (!is_unknown(gt) && !type_eq(gt, t_bool())) {
                            out = out.append(dg_at("E027", "match guard must be boolean, got " + type_label(gt), expr_line(m.arms[a].guard), expr_col(m.arms[a].guard)));
                        }
                        out = append_diags(out, call_diags(m.arms[a].guard, armScope));
                    }
                    out = append_diags(out, stmts_call_diags(m.arms[a].body, armScope));
                    a = a + 1;
                }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, stmts_call_diags(one, cur));
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        // A `var (a, b) = …` tuple destructure is encoded as the single
        // name "a,b"; check_stmt binds that literal name, so bind the split
        // names too for subsequent reads of `a` / `b` (E001). ONLY for a
        // comma name — rebinding a normal var here would shadow the precise
        // type check_stmt already gave it (lookup is newest-first) and break
        // type-dependent diagnostics downstream.
        match (st) {
            parser.StmtVar(dv) => {
                if (name_has_comma(dv.name)) { cur = bind_names(cur, dv.name); }
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// ambiguous_variants returns the variant names that are declared in TWO
// OR MORE enums — an unqualified reference to one of them is ambiguous
// (E036). (A variant repeated within ONE enum is E017, counted once per
// enum here so it doesn't masquerade as cross-enum ambiguity.)
function ambiguous_variants(enums: parser.EnumDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < enums.len()) {
        var vn: string[] = enums[i].variant_names;
        var k: i32 = 0;
        while (k < vn.len()) {
            var cnt: i32 = 0;
            var j: i32 = 0;
            while (j < enums.len()) {
                if (util.has_str(enums[j].variant_names, vn[k])) { cnt = cnt + 1; }
                j = j + 1;
            }
            // Ambiguous if the name is declared in 2+ USER enums, OR in a user
            // enum AND a BUILT-IN enum (Option / Result / JsonValue / IoError):
            // e.g. `enum O { Some(i32), None }` collides with Option's
            // Some / None, so a bare `None` must be qualified. Mirrors the Go
            // checker, which carries the built-in enums in the same variant
            // table the user enums register into. (cnt is >= 1 here — the
            // current enum contains vn[k].)
            var also_builtin: boolean = mx_builtin_enum_of(vn[k]).len() > 0;
            if ((cnt >= 2 || also_builtin) && !util.has_str(out, vn[k])) { out = out.append(vn[k]); }
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

// vref_expr recurses an expression and emits E036 for a bare reference to
// a variant name that's declared in multiple enums (so it must be
// qualified). A name bound as a local (parameter / var) is skipped, and a
// QUALIFIED reference `Enum.Variant` is an ExprFieldAccess whose field
// isn't visited as a bare ident, so it's fine.
function vref_expr(e: parser.Expr, s: Scope, ambig: string[]): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprIdent(id) => {
            if (util.has_str(ambig, id.name) && is_unknown(s.lookup(id.name))) {
                out = out.append(dg_at("E036", "variant \"" + id.name + "\" is declared in multiple enums — qualify the reference", id.line, id.col));
            }
        },
        parser.ExprBinary(b) => { out = append_diags(vref_expr(b.left, s, ambig), vref_expr(b.right, s, ambig)); },
        parser.ExprUnary(u) => { out = vref_expr(u.operand, s, ambig); },
        parser.ExprCall(c) => {
            out = vref_expr(c.callee, s, ambig);
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, vref_expr(c.args[i], s, ambig)); i = i + 1; }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, vref_expr(a.elements[i], s, ambig)); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, vref_expr(t.elements[i], s, ambig)); i = i + 1; }
        },
        parser.ExprIndex(ix) => { out = append_diags(vref_expr(ix.array, s, ambig), vref_expr(ix.index, s, ambig)); },
        parser.ExprSlice(s2) => { out = append_diags(vref_expr(s2.array, s, ambig), append_diags(vref_expr(s2.start, s, ambig), vref_expr(s2.end, s, ambig))); },
        parser.ExprFieldAccess(fa) => { out = vref_expr(fa.obj, s, ambig); },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) { out = append_diags(out, vref_expr(sl.field_values[i], s, ambig)); i = i + 1; }
            if (sl.has_base) { out = append_diags(out, vref_expr(sl.base, s, ambig)); }
        },
        parser.ExprLambda(lm) => { out = vref_stmts(lm.body, s, ambig); },
        _ => { }
    }
    return out;
}

// vref_stmts is the scope-threaded statement walk behind vref_expr (so a
// variant name shadowed by a local `var` isn't flagged).
function vref_stmts(stmts: parser.Stmt[], s: Scope, ambig: string[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => { out = append_diags(out, vref_expr(v.init, cur, ambig)); },
            parser.StmtReturn(r) => { out = append_diags(out, vref_expr(r.value, cur, ambig)); },
            parser.StmtExpr(x) => { out = append_diags(out, vref_expr(x.value, cur, ambig)); },
            parser.StmtAssign(a) => { out = append_diags(out, vref_expr(a.value, cur, ambig)); },
            parser.StmtIf(f) => {
                out = append_diags(out, vref_expr(f.cond, cur, ambig));
                out = append_diags(out, vref_stmts(f.then_body, cur, ambig));
                out = append_diags(out, vref_stmts(f.else_body, cur, ambig));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, vref_expr(w.cond, cur, ambig));
                out = append_diags(out, vref_stmts(w.body, cur, ambig));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, vref_expr(fr.iter, cur, ambig));
                out = append_diags(out, vref_stmts(fr.body, cur, ambig));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, vref_expr(m.scrutinee, cur, ambig));
                var a2: i32 = 0;
                while (a2 < m.arms.len()) { out = append_diags(out, vref_stmts(m.arms[a2].body, cur, ambig)); a2 = a2 + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, vref_stmts(one, cur, ambig));
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        i = i + 1;
    }
    return out;
}

// stmts_assign_diags walks a statement list (scope-threaded, recursing
// into nested blocks) emitting statement-level type diagnostics: E003
// when a value isn't assignable to its target (an annotated `var x: T = v`
// whose init type doesn't match T, or an assignment `x = v` whose value
// type doesn't match x's declared type), and E008 when an `if` / `while`
// condition isn't boolean. It reuses the same predicates check_stmt uses,
// so it fires exactly where the checker already flags the problem (no new
// false positives); unknown types are skipped.
function stmts_assign_diags(stmts: parser.Stmt[], s: Scope, unions: UnionSig[]): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        var st: parser.Stmt = stmts[i];
        match (st) {
            parser.StmtVar(v) => {
                if (v.type_name.len() > 0) {
                    var declared: Type = type_from_name_with_structs_unions(v.type_name, cur.structs, cur.unions);
                    var initt: Type = check_expr(v.init, cur);
                    if (!is_unknown(declared) && !is_unknown(initt) && !type_assignable(initt, declared, unions)) {
                        out = out.append(dg_at("E003", "cannot assign " + type_label(initt) + " to variable of type " + type_label(declared), v.line, v.col));
                    }
                }
                // E024: a tuple destructure `var (a, b) = E` (the parser
                // encodes the names as "a,b") requires E to be a tuple whose
                // element count matches the number of names.
                var ncommas: i32 = 0;
                var ci: i32 = 0;
                while (ci < v.name.len()) { if (v.name[ci] == 44) { ncommas = ncommas + 1; } ci = ci + 1; }
                if (ncommas > 0) {
                    var nnames: i32 = ncommas + 1;
                    var dit: Type = check_expr(v.init, cur);
                    match (dit) {
                        TypeTuple(dtt) => {
                            if (dtt.elements.len() != nnames) {
                                out = out.append(dg_at("E024", "tuple has " + itoa_nn(dtt.elements.len()) + " elements, but " + itoa_nn(nnames) + " names given", v.line, v.col));
                            }
                        },
                        TypeUnknown(_) => { },
                        _ => {
                            out = out.append(dg_at("E024", "tuple destructure needs a tuple expression, got " + type_label(dit), v.line, v.col));
                        }
                    }
                }
            },
            parser.StmtAssign(a) => {
                if (!cur.defines(a.target)) {
                    // E001: assignment to an undeclared name. An assignment
                    // LHS can only be a local / param / loop / match binding
                    // (field & index assignments are desugared to
                    // __set_field / __set_index calls elsewhere), so a target
                    // not in scope is unambiguously undefined — no function /
                    // variant / builtin to confuse it with, hence no
                    // allowlist needed. Reported at the `=` token (the
                    // assignment position the parser captured).
                    out = out.append(dg_at("E001", "undefined name \"" + a.target + "\"", a.target_line, a.target_col));
                } else {
                    var tt: Type = cur.lookup(a.target);
                    var vt: Type = check_expr(a.value, cur);
                    if (!is_unknown(tt) && !is_unknown(vt) && !type_assignable(vt, tt, unions)) {
                        out = out.append(dg_at("E003", "cannot assign " + type_label(vt) + " to " + type_label(tt), a.line, a.col));
                    }
                }
            },
            parser.StmtIf(f) => {
                var ic: Type = check_expr(f.cond, cur);
                if (!is_unknown(ic) && !type_eq(ic, t_bool())) {
                    out = out.append(dg_at("E008", "if condition must be boolean, got " + type_label(ic), expr_line(f.cond), expr_col(f.cond)));
                }
                out = append_diags(out, stmts_assign_diags(f.then_body, cur, unions));
                out = append_diags(out, stmts_assign_diags(f.else_body, cur, unions));
            },
            parser.StmtWhile(w) => {
                var wc: Type = check_expr(w.cond, cur);
                if (!is_unknown(wc) && !type_eq(wc, t_bool())) {
                    out = out.append(dg_at("E008", "while condition must be boolean, got " + type_label(wc), expr_line(w.cond), expr_col(w.cond)));
                }
                out = append_diags(out, stmts_assign_diags(w.body, cur, unions));
            },
            parser.StmtFor(fr) => {
                // Bind the loop variable(s) so an assignment to one inside
                // the body isn't mis-flagged as E001 (same as the read walk).
                out = append_diags(out, stmts_assign_diags(fr.body, bind_names(cur, fr.var_name), unions));
            },
            parser.StmtMatch(m) => {
                var a2: i32 = 0;
                while (a2 < m.arms.len()) {
                    // Bind the arm's payload (if any) so an assignment to it
                    // inside the body isn't mis-flagged as E001.
                    var asc: Scope = cur;
                    match (m.arms[a2].pattern) {
                        parser.PatVariant(apv) => {
                            // A scalar-payload variant like `Has(i32)` binds
                            // the inner value (the `__ev` payload type), not
                            // the wrapper struct — bind_variant_payloads reads
                            // the precise per-payload type so an assignment to
                            // any payload binding type-checks the same way the
                            // Go checker does (and a struct-union member still
                            // binds its struct).
                            asc = bind_variant_payloads(asc, cur, apv);
                        },
                        _ => { }
                    }
                    out = append_diags(out, stmts_assign_diags(m.arms[a2].body, asc, unions));
                    a2 = a2 + 1;
                }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, stmts_assign_diags(one, cur, unions));
            },
            _ => { }
        }
        cur = check_stmt(st, cur).scope;
        // Bind a `var (a, b) = …` destructure's split names for subsequent
        // assignments to `a` / `b` (only for comma names — rebinding a normal
        // var here would shadow its precise type; see the read walk).
        match (st) {
            parser.StmtVar(dv) => {
                if (name_has_comma(dv.name)) { cur = bind_names(cur, dv.name); }
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// check_module is the new entry point for sources that declare
// functions. Builds the sig table, walks each function body,
// and (separately) type-checks top-level stmts in a scope that
// has the sigs available — so `function main(): i32 { … }` and
// loose `var x = add(1, 2);` both resolve `add`.
pub struct ModuleTypes { sigs: FuncSig[], top_tys: Type[], all_well_typed: boolean, diags: Diag[] }

// Diag is a coded diagnostic — the stable `E0XX` code (matching the Go
// checker's `internal/checker` codes) plus a human message and an
// optional 1-based source position (line/col, 0 when no position is
// available yet). Positions are being threaded through the AST node by
// node; a diagnostic emitted from a node that already carries a position
// renders `line:col: error[E0XX]: …` like the Go checker, the rest still
// render `error[E0XX]: …`. See docs/SELFHOST-CHECKER-PORT.md.
pub struct Diag { code: string, message: string, line: i32, col: i32 }

// is_immutability_code reports whether `code` is one of the immutable-data
// cycle rules — E048 (field assign), E049 (reference-capture write-back),
// E055 (discarded pure-collection result), E056 (subscript assign), E057
// (Cell[T] element must be cycle-free — a composite/reference element could
// reconstruct a cycle). These are the diagnostics the self-host compiler
// enforces at the build gate (the rest of the checker is a partial port and
// may false-positive, so the gate filters to this set). E057 belongs here
// for the same cycle-freedom reason as the others, and matches the native
// compiler, which rejects a Cell[composite] before codegen via its full
// pre-codegen check. See docs/IMMUTABILITY-MIGRATION-PLAN.md §4.
pub function is_immutability_code(code: string): boolean {
    return code == "E048" || code == "E049" || code == "E055" || code == "E056" || code == "E057";
}

// filter_immutability keeps only the immutable-data cycle diagnostics.
pub function filter_immutability(diags: Diag[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < diags.len()) {
        if (is_immutability_code(diags[i].code)) { out = out.append(diags[i]); }
        i = i + 1;
    }
    return out;
}

// format_diags renders diagnostics one-per-line as
// `error[CODE]: message (line:col)` — the self-host counterpart of the Go
// driver's diag.Format. Used by the checking drivers to surface a rejection
// to stderr before exiting non-zero (bootstrap error-reporting).
pub function format_diags(diags: Diag[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < diags.len()) {
        var d: Diag = diags[i];
        out = out + "error[" + d.code + "]: " + d.message + " (" + itoa_nn(d.line) + ":" + itoa_nn(d.col) + ")\n";
        i = i + 1;
    }
    return out;
}

// dg builds a position-less diagnostic; dg_at attaches a 1-based source
// position. Most emitters use dg today and migrate to dg_at as their AST
// node gains a position.
function dg(code: string, message: string): Diag {
    return Diag { code: code, message: message, line: 0, col: 0 };
}
function dg_at(code: string, message: string, line: i32, col: i32): Diag {
    return Diag { code: code, message: message, line: line, col: col };
}

// expr_line / expr_col read the 1-based source position off a positioned
// expression node (0 when the node doesn't yet carry one). Used by
// argument-level diagnostics (E038) that the Go checker reports at the
// argument's own position rather than the call's.
function expr_line(e: parser.Expr): i32 {
    match (e) {
        parser.ExprNumber(n) => { return n.line; },
        parser.ExprString(st) => { return st.line; },
        parser.ExprIdent(id) => { return id.line; },
        parser.ExprFieldAccess(fa) => { return fa.line; },
        parser.ExprCall(c) => { return c.line; },
        parser.ExprStructLit(s) => { return s.line; },
        _ => { return 0; }
    }
}
function expr_col(e: parser.Expr): i32 {
    match (e) {
        parser.ExprNumber(n) => { return n.col; },
        parser.ExprString(st) => { return st.col; },
        parser.ExprIdent(id) => { return id.col; },
        parser.ExprFieldAccess(fa) => { return fa.col; },
        parser.ExprCall(c) => { return c.col; },
        parser.ExprStructLit(s) => { return s.col; },
        _ => { return 0; }
    }
}

// dup_name_before reports whether names[idx] already appears at a lower
// index — the duplicate test shared by the declaration-level rules.
function dup_name_before(names: string[], idx: i32): boolean {
    var j: i32 = 0;
    while (j < idx) {
        if (names[j] == names[idx]) { return true; }
        j = j + 1;
    }
    return false;
}

// collect_decl_diags emits the declaration-level coded diagnostics that
// are detectable from the decl tables alone (no positions, no type
// inference): E007 (a struct field name repeated) and E018 (a function
// parameter name repeated). These mirror the Go checker's E007 / E018.
// receiver_type_ok reports whether a method's receiver type names a valid
// receiver — a primitive, or a declared struct / enum / union (alias). A
// generic / Map / array receiver (`X[...]`) or a `dyn Trait` object is
// skipped conservatively (so the E021 check never trips on shapes this
// port resolves coarsely). The base name is taken modulo `[...]`.
function receiver_type_ok(rt: string, mod: parser.Module): boolean {
    if (rt.len() == 0) { return true; }
    if (rt == "i32" || rt == "i64" || rt == "u32" || rt == "u64" || rt == "bool" || rt == "boolean" || rt == "string" || rt == "f64" || rt == "f32" || rt == "float") { return true; }
    var bi: i32 = 0;
    while (bi < rt.len()) { if (rt[bi] == 91) { return true; } bi = bi + 1; }   // '[' → generic/Map/array
    if (rt.len() >= 4 && rt[0:4] == "dyn ") { return true; }
    var base: string = util.base_type_name(rt);
    var i: i32 = 0;
    while (i < mod.structs.len()) { if (mod.structs[i].name == base) { return true; } i = i + 1; }
    var j: i32 = 0;
    while (j < mod.enums.len()) { if (mod.enums[j].name == base) { return true; } j = j + 1; }
    var k: i32 = 0;
    while (k < mod.aliases.len()) { if (mod.aliases[k].name == base) { return true; } k = k + 1; }
    return false;
}

function collect_decl_diags(mod: parser.Module): Diag[] {
    var out: Diag[] = [];
    // E007: duplicate field within a struct (enum-variant structs carry at
    // most one `__ev` field, so they never trip this).
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var sd: parser.StructDecl = mod.structs[si];
        var fnames: string[] = [];
        var fi: i32 = 0;
        while (fi < sd.fields.len()) { fnames = fnames.append(sd.fields[fi].name); fi = fi + 1; }
        var fk: i32 = 0;
        while (fk < fnames.len()) {
            if (dup_name_before(fnames, fk)) {
                out = out.append(dg_at("E007", "duplicate field \"" + fnames[fk] + "\" in struct " + sd.name, sd.line, sd.col));
            }
            fk = fk + 1;
        }
        si = si + 1;
    }
    // E018: duplicate parameter within a function.
    var ui: i32 = 0;
    while (ui < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[ui];
        var pnames: string[] = [];
        var pi: i32 = 0;
        while (pi < fd.params.len()) { pnames = pnames.append(fd.params[pi].name); pi = pi + 1; }
        var pk: i32 = 0;
        while (pk < pnames.len()) {
            if (dup_name_before(pnames, pk)) {
                out = out.append(dg_at("E018", "duplicate parameter \"" + pnames[pk] + "\"", fd.line, fd.col));
            }
            pk = pk + 1;
        }
        ui = ui + 1;
    }
    // E006: a free function redeclared (same name, both receiver-less), or
    // a method redeclared (same name AND receiver type). The redeclaration
    // SITE — the second + occurrences — is flagged, matching the Go
    // checker. Enum / struct redeclaration aren't covered yet: the parser
    // desugars enums into variant structs and drops the enum name, so a
    // struct name in `mod.structs` can't be told apart from a variant (a
    // later slice handles them once that grouping is recovered).
    var di: i32 = 0;
    while (di < mod.funcs.len()) {
        var f2: parser.FuncDecl = mod.funcs[di];
        var earlier: boolean = false;
        var ej: i32 = 0;
        while (ej < di) {
            var pe: parser.FuncDecl = mod.funcs[ej];
            // Key redeclaration on the receiver TYPE, not the receiver NAME:
            // an ASSOCIATED function (`impl Default for i32 { function default()
            // }`) has an empty receiver_name (no `self`) but a SET receiver_type
            // (`i32`). Keying on receiver_name mis-merged every type's `default`
            // into one "free function" and flagged E006 across distinct impls
            // (i32.default vs i64.default …). Free functions have NO receiver
            // type on either side; type-associated decls (methods OR associated
            // fns) collide only when name AND receiver type both match.
            if (f2.receiver_type.len() == 0 && pe.receiver_type.len() == 0 && pe.name == f2.name) {
                earlier = true;
            }
            if (f2.receiver_type.len() > 0 && pe.receiver_type.len() > 0 && pe.name == f2.name
                    && util.base_type_name(pe.receiver_type) == util.base_type_name(f2.receiver_type)) {
                earlier = true;
            }
            ej = ej + 1;
        }
        if (earlier) {
            if (f2.receiver_type.len() == 0) {
                out = out.append(dg_at("E006", "function \"" + f2.name + "\" redeclared", f2.line, f2.col));
            } else {
                out = out.append(dg_at("E006", "method \"" + f2.name + "\" on " + util.base_type_name(f2.receiver_type) + " redeclared", f2.line, f2.col));
            }
        }
        // E021: a method whose receiver type isn't a known struct / enum /
        // union (or a primitive / generic / dyn receiver), reported at the
        // method declaration.
        if (f2.receiver_name.len() > 0 && !receiver_type_ok(f2.receiver_type, mod)) {
            out = out.append(dg_at("E021", "method receiver references unknown struct \"" + util.base_type_name(f2.receiver_type) + "\"", f2.line, f2.col));
        }
        di = di + 1;
    }
    // E006: struct redeclared (#4363 item 4 — the func/method/enum forms
    // below predate it). mod.structs is the FLAT table: enum variant
    // payloads land there too (tagged with their owning enum via
    // enum_owner), and desugars synthesize `__`-prefixed entries — both are
    // skipped so only genuine user struct declarations collide.
    var sn2: i32 = 0;
    while (sn2 < mod.structs.len()) {
        var s2: parser.StructDecl = mod.structs[sn2];
        var user_struct: boolean = s2.enum_owner.len() == 0
            && !(s2.name.len() >= 2 && s2.name[0:2] == "__");
        if (user_struct) {
            var sdup: boolean = false;
            var sj2: i32 = 0;
            while (sj2 < sn2) {
                if (mod.structs[sj2].enum_owner.len() == 0 && mod.structs[sj2].name == s2.name) { sdup = true; }
                sj2 = sj2 + 1;
            }
            if (sdup) {
                out = out.append(dg_at("E006", "struct \"" + s2.name + "\" redeclared", s2.line, s2.col));
            }
        }
        sn2 = sn2 + 1;
    }
    // E006: enum redeclared, and E017: duplicate variant within an enum.
    // These need the enum -> variants grouping the parser preserves in
    // mod.enums (the flat struct table can't tell a variant from a
    // struct).
    var en: i32 = 0;
    while (en < mod.enums.len()) {
        var edup: boolean = false;
        var ej2: i32 = 0;
        while (ej2 < en) {
            if (mod.enums[ej2].name == mod.enums[en].name) { edup = true; }
            ej2 = ej2 + 1;
        }
        if (edup) {
            out = out.append(dg_at("E006", "enum \"" + mod.enums[en].name + "\" redeclared", mod.enums[en].line, mod.enums[en].col));
        }
        // E010: a user enum shadowing a reserved built-in enum name.
        if (is_reserved_enum_name(mod.enums[en].name)) {
            out = out.append(dg_at("E010", "enum \"" + mod.enums[en].name + "\" is a reserved built-in name and cannot be redeclared", mod.enums[en].line, mod.enums[en].col));
        }
        var vn: string[] = mod.enums[en].variant_names;
        var vk: i32 = 0;
        while (vk < vn.len()) {
            if (dup_name_before(vn, vk)) {
                out = out.append(dg_at("E017", "duplicate variant \"" + vn[vk] + "\" in enum " + mod.enums[en].name, mod.enums[en].line, mod.enums[en].col));
            }
            vk = vk + 1;
        }
        en = en + 1;
    }
    // E016: a `type X = …` union alias whose name collides with a declared
    // struct of the same name, reported at the alias's `type` keyword (the
    // struct wins; the alias is otherwise dropped). A collision with an
    // enum is the Go checker's E006 (enum redeclared), not E016, so only
    // the struct case is handled here.
    var ai016: i32 = 0;
    while (ai016 < mod.aliases.len()) {
        var aname: string = mod.aliases[ai016].name;
        var hit_struct: boolean = false;
        var si016: i32 = 0;
        while (si016 < mod.structs.len()) {
            if (mod.structs[si016].name == aname) { hit_struct = true; }
            si016 = si016 + 1;
        }
        if (hit_struct) {
            out = out.append(dg_at("E016", "union \"" + aname + "\" collides with a struct of the same name", mod.aliases[ai016].line, mod.aliases[ai016].col));
        }
        ai016 = ai016 + 1;
    }
    // E054: an `@export(...)` function bound to a WIT world export cannot be
    // generic (a world export is lifted with a single concrete canonical
    // ABI) and cannot be a method (the export surface is for top-level
    // functions). The binding is recorded on mod.exports by func name; we
    // look the function up to read its type-param count + receiver.
    var xi: i32 = 0;
    while (xi < mod.exports.len()) {
        var ename: string = mod.exports[xi].func_name;
        var xfj: i32 = 0;
        while (xfj < mod.funcs.len()) {
            var xfd: parser.FuncDecl = mod.funcs[xfj];
            if (xfd.name == ename) {
                if (xfd.type_param_count > 0) {
                    out = out.append(dg_at("E054", "@export function \"" + xfd.name + "\" cannot be generic (a world export has a single concrete ABI)", xfd.line, xfd.col));
                }
                if (xfd.receiver_name.len() > 0) {
                    out = out.append(dg_at("E054", "@export cannot be applied to a method (\"" + xfd.name + "\"); use a top-level function", xfd.line, xfd.col));
                }
            }
            xfj = xfj + 1;
        }
        xi = xi + 1;
    }
    return out;
}

// strip_generic_args drops a `[...]` argument list from a (possibly
// generic) receiver/type spelling: `Box[T]` -> `Box`, `P` -> `P`. Used so
// a method's receiver identity and message render by base struct name.
// strip_generic_args -> util.base_type_name (SH-020).

// ===================== owned-parameter move checking (E050/E051) =========
// Affine analysis for `own` parameters: using an owned value after it has
// been consumed (moved) is E050; passing a non-owned value to an `own`
// parameter is E051. A "consume" is a whole-value use of the bare owned
// param (returned, passed as a call argument, matched, bound); a "borrow"
// is a projection (`x.field`, `x[i]`, a method receiver `x.m()`, a call
// callee) which reads through without ending its life. Ports the core of
// the Go checker's checkOwnedParams; conservative where the self-host
// lacks the type detail (no match-payload ownership transfer, no
// dyn-trait consuming methods) — it under-reports rather than over-reports.
pub struct OwnFunc { name: string, flags: boolean[] }
struct MovedEntry { mname: string, mline: i32 }
struct OwnWalk { moved: MovedEntry[], diags: Diag[] }
// `admit` names the ONE local admitted as an owned argument while
// walking the RHS of a self-reassign `x = f(..., x, ...)` (#4873 step 0
// — the old binding dies at the assignment, so its exactly-once
// own-position occurrence is a transfer). "" outside that walk. The
// exactly-once check (ow_self_move_admits) makes name-keying equivalent
// to the native checker's node-keying within the RHS subtree.
struct OwnCtx { owned: string[], ofuncs: OwnFunc[], structs: parser.StructDecl[], admit: string }

function ow_moved_has(m: MovedEntry[], name: string): boolean {
    var i: i32 = 0;
    while (i < m.len()) { if (m[i].mname == name) { return true; } i = i + 1; }
    return false;
}
function ow_moved_line(m: MovedEntry[], name: string): i32 {
    var i: i32 = 0;
    while (i < m.len()) { if (m[i].mname == name) { return m[i].mline; } i = i + 1; }
    return 0;
}
function ow_moved_add(m: MovedEntry[], name: string, line: i32): MovedEntry[] {
    if (ow_moved_has(m, name)) { return m; }
    return m.append(MovedEntry { mname: name, mline: line });
}
// ow_moved_join merges a non-diverging branch's consumes into dst (first
// consume wins). A diverging branch (returns on every path) never reaches
// the join, so its consumes don't constrain the fall-through.
function ow_moved_join(dst: MovedEntry[], branch: MovedEntry[], diverges: boolean): MovedEntry[] {
    if (diverges) { return dst; }
    var out: MovedEntry[] = dst;
    var i: i32 = 0;
    while (i < branch.len()) { out = ow_moved_add(out, branch[i].mname, branch[i].mline); i = i + 1; }
    return out;
}

function ow_is_owned(ctx: OwnCtx, name: string): boolean { return util.has_str(ctx.owned, name); }

function ow_func_flags(ofuncs: OwnFunc[], name: string): boolean[] {
    var i: i32 = 0;
    while (i < ofuncs.len()) { if (ofuncs[i].name == name) { return ofuncs[i].flags; } i = i + 1; }
    var empty: boolean[] = [];
    return empty;
}
function ow_is_own_func(ofuncs: OwnFunc[], name: string): boolean {
    var i: i32 = 0;
    while (i < ofuncs.len()) { if (ofuncs[i].name == name) { return true; } i = i + 1; }
    return false;
}

// ow_struct_known reports whether `name` is a declared struct/variant — a
// call to one is a fresh (owned) construction.
function ow_struct_known(structs: parser.StructDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) { if (structs[i].name == name) { return true; } i = i + 1; }
    return false;
}

// ow_is_owned_expr: a value the caller owns and may transfer into an `own`
// parameter — a fresh construction (struct/tuple/array literal, string
// concat) or another owned parameter, or a variant-constructor call.
// Anything else (borrowed param, projection, plain local, ordinary call)
// is not provably owned → E051.
function ow_is_owned_expr(e: parser.Expr, ctx: OwnCtx): boolean {
    match (e) {
        parser.ExprStructLit(_) => { return true; },
        parser.ExprArray(_) => { return true; },
        parser.ExprTuple(_) => { return true; },
        parser.ExprBinary(b) => { return b.op == "+"; },
        parser.ExprIdent(id) => {
            if (ctx.admit.len() > 0 && ctx.admit == id.name) { return true; }
            return ow_is_owned(ctx, id.name);
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => { return ow_struct_known(ctx.structs, cid.name); },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// ow_count_ident counts occurrences of `name` as a bare ident anywhere
// in `e` — the exactly-once probe for the self-reassign move admission.
// Mirrors mc_mentions_expr's variant coverage; an unhandled variant
// counts 0, which under-counts and therefore REJECTS (fails safe: the
// admission needs exactly 1 and a direct-arg hit).
function ow_count_ident_list(list: parser.Expr[], name: string): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < list.len()) { n = n + ow_count_ident(list[i], name); i = i + 1; }
    return n;
}

function ow_count_ident(e: parser.Expr, name: string): i32 {
    match (e) {
        parser.ExprIdent(id) => { if (id.name == name) { return 1; } return 0; },
        parser.ExprBinary(b) => { return ow_count_ident(b.left, name) + ow_count_ident(b.right, name); },
        parser.ExprUnary(u) => { return ow_count_ident(u.operand, name); },
        parser.ExprCall(c) => { return ow_count_ident(c.callee, name) + ow_count_ident_list(c.args, name); },
        parser.ExprArray(ar) => { return ow_count_ident_list(ar.elements, name); },
        parser.ExprTuple(tp) => { return ow_count_ident_list(tp.elements, name); },
        parser.ExprIndex(ix) => { return ow_count_ident(ix.array, name) + ow_count_ident(ix.index, name); },
        parser.ExprSlice(sl) => { return ow_count_ident(sl.array, name) + ow_count_ident(sl.start, name) + ow_count_ident(sl.end, name); },
        parser.ExprStructLit(st) => {
            var n: i32 = 0;
            if (st.has_base) { n = ow_count_ident(st.base, name); }
            return n + ow_count_ident_list(st.field_values, name);
        },
        parser.ExprFieldAccess(fa) => { return ow_count_ident(fa.obj, name); },
        _ => { return 0; }
    }
    return 0;
}

// ow_self_move_admits recognizes the #4873 step-0 shape for
// `target = <value>`: value is a plain-ident-callee call to an own-func,
// target occurs EXACTLY ONCE in the whole RHS (excluding the top-level
// callee ident), and that occurrence is a direct bare-ident argument in
// an `own` position. Byte-matches the native SelfReassignOwnMoveArg so
// the two checkers admit identical programs.
function ow_self_move_admits(target: string, value: parser.Expr, ctx: OwnCtx): boolean {
    match (value) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (!ow_is_own_func(ctx.ofuncs, cid.name)) { return false; }
                    if (ow_count_ident_list(c.args, target) != 1) { return false; }
                    var flags: boolean[] = ow_func_flags(ctx.ofuncs, cid.name);
                    var i: i32 = 0;
                    while (i < c.args.len() && i < flags.len()) {
                        match (c.args[i]) {
                            parser.ExprIdent(aid) => {
                                if (aid.name == target) { return flags[i]; }
                            },
                            _ => { }
                        }
                        i = i + 1;
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// ow_guard_call: E051 — each argument passed to an `own` parameter of a
// plain (ident-callee) callee must be an owned value.
function ow_guard_call(c: parser.ExprCall, ctx: OwnCtx): Diag[] {
    var out: Diag[] = [];
    match (c.callee) {
        parser.ExprIdent(id) => {
            if (ow_is_own_func(ctx.ofuncs, id.name)) {
                var flags: boolean[] = ow_func_flags(ctx.ofuncs, id.name);
                var i: i32 = 0;
                while (i < c.args.len() && i < flags.len()) {
                    if (flags[i] && !ow_is_owned_expr(c.args[i], ctx)) {
                        out = out.append(dg_at("E051", "argument to owned parameter must be an owned value (a fresh construction or another `own` parameter), not a borrowed one", c.line, c.col));
                    }
                    i = i + 1;
                }
            }
        },
        _ => { }
    }
    return out;
}

// ow_call_arg_flags returns the callee's per-parameter `own` flags for a
// plain (ident-callee) call, or an empty list when the callee is not an
// own-func or not a plain ident (a method / closure callee borrows its args).
// Drives the precise affine model: an argument is consumed only at an `own`
// position.
function ow_call_arg_flags(callee: parser.Expr, ctx: OwnCtx): boolean[] {
    match (callee) {
        parser.ExprIdent(id) => {
            if (ow_is_own_func(ctx.ofuncs, id.name)) { return ow_func_flags(ctx.ofuncs, id.name); }
            return [];
        },
        _ => { return []; }
    }
}

// ru_borrow processes a borrow-position expression: a bare owned ident is
// a borrow (no consume) but using it after a move is still E050; anything
// else is processed as an ordinary (consume-position) expression.
function ru_borrow(e: parser.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
    match (e) {
        parser.ExprIdent(id) => {
            var d: Diag[] = [];
            if (ow_is_owned(ctx, id.name) && ow_moved_has(moved, id.name)) {
                d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + itoa_nn(ow_moved_line(moved, id.name)) + ")", id.line, id.col));
            }
            return OwnWalk { moved: moved, diags: d };
        },
        _ => { return ru_expr(e, moved, ctx); }
    }
}

// ru_expr processes a consume-position expression left-to-right, threading
// the moved set: a bare owned ident is consumed (or E050 if already
// moved); projections/call-callees/receivers borrow their target.
function ru_expr(e: parser.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
    match (e) {
        parser.ExprIdent(id) => {
            var d: Diag[] = [];
            var m: MovedEntry[] = moved;
            if (ow_is_owned(ctx, id.name)) {
                if (ow_moved_has(moved, id.name)) {
                    d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + itoa_nn(ow_moved_line(moved, id.name)) + ")", id.line, id.col));
                } else {
                    m = ow_moved_add(moved, id.name, id.line);
                }
            }
            return OwnWalk { moved: m, diags: d };
        },
        parser.ExprFieldAccess(fa) => { return ru_borrow(fa.obj, moved, ctx); },
        parser.ExprIndex(ix) => {
            var r1: OwnWalk = ru_borrow(ix.array, moved, ctx);
            var r2: OwnWalk = ru_expr(ix.index, r1.moved, ctx);
            return OwnWalk { moved: r2.moved, diags: append_diags(r1.diags, r2.diags) };
        },
        parser.ExprSlice(sl) => {
            var r1: OwnWalk = ru_borrow(sl.array, moved, ctx);
            var r2: OwnWalk = ru_expr(sl.start, r1.moved, ctx);
            var r3: OwnWalk = ru_expr(sl.end, r2.moved, ctx);
            return OwnWalk { moved: r3.moved, diags: append_diags(append_diags(r1.diags, r2.diags), r3.diags) };
        },
        parser.ExprCall(c) => {
            // IIFE — a 0-arg call of a 0-param lambda runs its body in
            // place (the parser desugars match-/if-EXPRESSIONS to this), so
            // its consumes belong to the enclosing scope. Analyse the body
            // directly rather than treating it as an opaque closure.
            match (c.callee) {
                parser.ExprLambda(lm) => {
                    if (lm.params.len() == 0 && c.args.len() == 0) {
                        return ow_stmts(lm.body, moved, ctx);
                    }
                },
                _ => { }
            }
            var d0: Diag[] = ow_guard_call(c, ctx);
            // The callee is a borrow (function ref / closure / method receiver).
            var rc: OwnWalk = ru_borrow(c.callee, moved, ctx);
            var m: MovedEntry[] = rc.moved;
            var d: Diag[] = append_diags(d0, rc.diags);
            // Precise affine model: an owned value is CONSUMED only when passed
            // to an `own` parameter; an argument to a borrowed parameter is a
            // read (borrow), not a move — so a borrowing helper can be passed an
            // owned value and the value still used / consumed afterwards.
            var flags: boolean[] = ow_call_arg_flags(c.callee, ctx);
            var i: i32 = 0;
            while (i < c.args.len()) {
                var ra: OwnWalk = ru_borrow(c.args[i], m, ctx);
                if (i < flags.len() && flags[i]) { ra = ru_expr(c.args[i], m, ctx); }
                m = ra.moved;
                d = append_diags(d, ra.diags);
                i = i + 1;
            }
            return OwnWalk { moved: m, diags: d };
        },
        parser.ExprBinary(b) => {
            var r1: OwnWalk = ru_expr(b.left, moved, ctx);
            var r2: OwnWalk = ru_expr(b.right, r1.moved, ctx);
            return OwnWalk { moved: r2.moved, diags: append_diags(r1.diags, r2.diags) };
        },
        parser.ExprUnary(u) => { return ru_expr(u.operand, moved, ctx); },
        parser.ExprArray(a) => {
            var m: MovedEntry[] = moved;
            var d: Diag[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { var r: OwnWalk = ru_expr(a.elements[i], m, ctx); m = r.moved; d = append_diags(d, r.diags); i = i + 1; }
            return OwnWalk { moved: m, diags: d };
        },
        parser.ExprTuple(t) => {
            var m: MovedEntry[] = moved;
            var d: Diag[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { var r: OwnWalk = ru_expr(t.elements[i], m, ctx); m = r.moved; d = append_diags(d, r.diags); i = i + 1; }
            return OwnWalk { moved: m, diags: d };
        },
        parser.ExprStructLit(s) => {
            var m: MovedEntry[] = moved;
            var d: Diag[] = [];
            if (s.has_base) { var rb: OwnWalk = ru_expr(s.base, m, ctx); m = rb.moved; d = append_diags(d, rb.diags); }
            var i: i32 = 0;
            while (i < s.field_values.len()) { var r: OwnWalk = ru_expr(s.field_values[i], m, ctx); m = r.moved; d = append_diags(d, r.diags); i = i + 1; }
            return OwnWalk { moved: m, diags: d };
        },
        _ => { return OwnWalk { moved: moved, diags: [] }; }
    }
}

// ow_loop walks a loop body once from the entry state and flags any owned
// param it consumes that was live at entry — a later iteration would use
// it after move. The fall-through state is left unchanged (the loop may
// run zero times).
function ow_loop(body: parser.Stmt[], moved: MovedEntry[], ctx: OwnCtx): Diag[] {
    var r: OwnWalk = ow_stmts(body, moved, ctx);
    var out: Diag[] = r.diags;
    var i: i32 = 0;
    while (i < r.moved.len()) {
        var nm: string = r.moved[i].mname;
        if (!ow_moved_has(moved, nm)) {
            out = out.append(dg_at("E050", "owned parameter \"" + nm + "\" is consumed inside a loop; a later iteration would use it after move", r.moved[i].mline, 0));
        }
        i = i + 1;
    }
    return out;
}

function ow_stmt(st: parser.Stmt, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
    match (st) {
        parser.StmtVar(v) => { return ru_expr(v.init, moved, ctx); },
        parser.StmtReturn(r) => { return ru_expr(r.value, moved, ctx); },
        parser.StmtExpr(e) => { return ru_expr(e.value, moved, ctx); },
        parser.StmtAssign(a) => {
            // Reassigning the bare owned param rebinds it to a fresh value, so
            // its consumed state resets; otherwise the rhs is a consume.
            // Self-reassign move admission (#4873 step 0): `x = f(..., x, ...)`
            // with local x passed exactly once, directly, in an `own`
            // position — admit that occurrence for the RHS walk only.
            var actx: OwnCtx = ctx;
            if (!ow_is_owned(ctx, a.target) && ow_self_move_admits(a.target, a.value, ctx)) {
                actx = OwnCtx { owned: ctx.owned, ofuncs: ctx.ofuncs, structs: ctx.structs, admit: a.target };
            }
            var rv: OwnWalk = ru_expr(a.value, moved, actx);
            if (ow_is_owned(ctx, a.target)) {
                return OwnWalk { moved: ow_moved_del(rv.moved, a.target), diags: rv.diags };
            }
            return rv;
        },
        parser.StmtIf(f) => {
            var rc: OwnWalk = ru_expr(f.cond, moved, ctx);
            var rt: OwnWalk = ow_stmts(f.then_body, rc.moved, ctx);
            var re: OwnWalk = ow_stmts(f.else_body, rc.moved, ctx);
            var m: MovedEntry[] = ow_moved_join(rc.moved, rt.moved, block_exits(f.then_body));
            m = ow_moved_join(m, re.moved, f.else_body.len() > 0 && block_exits(f.else_body));
            return OwnWalk { moved: m, diags: append_diags(append_diags(rc.diags, rt.diags), re.diags) };
        },
        parser.StmtWhile(w) => {
            var rc: OwnWalk = ru_expr(w.cond, moved, ctx);
            var ld: Diag[] = ow_loop(w.body, rc.moved, ctx);
            return OwnWalk { moved: rc.moved, diags: append_diags(rc.diags, ld) };
        },
        parser.StmtFor(fr) => {
            var ri: OwnWalk = ru_borrow(fr.iter, moved, ctx);
            var ld: Diag[] = ow_loop(fr.body, ri.moved, ctx);
            return OwnWalk { moved: ri.moved, diags: append_diags(ri.diags, ld) };
        },
        parser.StmtMatch(m) => {
            var rs: OwnWalk = ru_expr(m.scrutinee, moved, ctx);
            var mv: MovedEntry[] = rs.moved;
            var d: Diag[] = rs.diags;
            var a: i32 = 0;
            while (a < m.arms.len()) {
                var ra: OwnWalk = ow_stmts(m.arms[a].body, rs.moved, ctx);
                d = append_diags(d, ra.diags);
                mv = ow_moved_join(mv, ra.moved, block_exits(m.arms[a].body));
                a = a + 1;
            }
            return OwnWalk { moved: mv, diags: d };
        },
        parser.StmtDefer(dd) => {
            var one: parser.Stmt[] = [dd.action];
            return ow_stmts(one, moved, ctx);
        },
        _ => { return OwnWalk { moved: moved, diags: [] }; }
    }
}

function ow_stmts(stmts: parser.Stmt[], moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
    var m: MovedEntry[] = moved;
    var d: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        var r: OwnWalk = ow_stmt(stmts[i], m, ctx);
        m = r.moved;
        d = append_diags(d, r.diags);
        i = i + 1;
    }
    return OwnWalk { moved: m, diags: d };
}

function ow_moved_del(m: MovedEntry[], name: string): MovedEntry[] {
    var out: MovedEntry[] = [];
    var i: i32 = 0;
    while (i < m.len()) { if (m[i].mname != name) { out = out.append(m[i]); } i = i + 1; }
    return out;
}

// collect_own_funcs records every function that has at least one `own`
// parameter, with a per-parameter owned-flag list (for the E051 guard).
function collect_own_funcs(funcs: parser.FuncDecl[]): OwnFunc[] {
    var out: OwnFunc[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var any_own: boolean = false;
        var flags: boolean[] = [];
        var j: i32 = 0;
        while (j < funcs[i].params.len()) {
            var o: boolean = funcs[i].params[j].own;
            flags = flags.append(o);
            if (o) { any_own = true; }
            j = j + 1;
        }
        if (any_own && funcs[i].receiver_name.len() == 0) {
            out = out.append(OwnFunc { name: funcs[i].name, flags: flags });
        }
        i = i + 1;
    }
    return out;
}

// own_diags runs the affine move-check over every function whose body
// could exercise it: those with owned params (the E050 walk) and — once
// any owned-param function exists — every function (the E051 call-site
// guard). No-op when the module declares no `own` parameter anywhere, so
// ordinary programs are untouched.
pub function own_diags(mod: parser.Module): Diag[] {
    var ofuncs: OwnFunc[] = collect_own_funcs(mod.funcs);
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fn: parser.FuncDecl = mod.funcs[i];
        var owned: string[] = [];
        var p: i32 = 0;
        while (p < fn.params.len()) { if (fn.params[p].own) { owned = owned.append(fn.params[p].name); } p = p + 1; }
        if (owned.len() > 0 || ofuncs.len() > 0) {
            var ctx: OwnCtx = OwnCtx { owned: owned, ofuncs: ofuncs, structs: mod.structs, admit: "" };
            var nomoved: MovedEntry[] = [];
            var r: OwnWalk = ow_stmts(fn.body, nomoved, ctx);
            out = append_diags(out, r.diags);
        }
        i = i + 1;
    }
    return out;
}

// ===================== captured reference reassignment (E049) ============
// Assigning to a reference-typed (pointer) variable that a closure
// captures from an enclosing scope is E049: such a capture is read-only
// (rebinding it inside the closure could close a reference cycle and never
// takes effect in the outer scope) — return the new value instead. Scalar
// captures (i32 / bool / f64 …) live in the env block and may be
// reassigned freely, so they are exempt. The classification is by the
// declared type-name; an unannotated capture is conservatively skipped.
struct NameTy { nm: string, ty: string }

function e049_append_nt(a: NameTy[], b: NameTy[]): NameTy[] {
    var out: NameTy[] = a;
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// e049_is_ref classifies a capture's TYPE NAME as reference-shaped (E049
// applies) vs scalar (exempt). The scalar set must match native's
// ast.IsPointerType exactly (internal/ast) — everything IsPointerType calls
// false is exempt here: every numeric width (i32/i64 and the unsigned
// u8/u32/u64/usize) plus boolean. IsPointerType-true names (string, arrays,
// structs, enums, tuples, maps, dyn) fall through to `true`. An empty name
// (an unannotated `var`) is handled by the caller (e049_scope infers the
// init's shape); reaching here with "" stays conservatively scalar.
function e049_is_ref(tn: string): boolean {
    if (tn.len() == 0) { return false; }
    if (tn == "i32" || tn == "i64" || tn == "u8" || tn == "u32" || tn == "u64" || tn == "usize"
        || tn == "bool" || tn == "boolean" || tn == "f64" || tn == "f32") { return false; }
    return true;
}

// e049_ref_capture reports whether `name` names a reference-typed variable
// in the enclosing scope (so assigning it inside a closure is E049).
function e049_ref_capture(enclosing: NameTy[], name: string): boolean {
    var i: i32 = 0;
    while (i < enclosing.len()) {
        if (enclosing[i].nm == name) { return e049_is_ref(enclosing[i].ty); }
        i = i + 1;
    }
    return false;
}

// e049_init_ref_ty infers a reference-shaped type marker for an UNANNOTATED
// `var x = <init>` whose init is an unambiguously pointer-shaped LITERAL —
// a string / array / struct / tuple literal, each of which native's full
// inference types as a reference (so a write-back capture of it is E049).
// Returns "" for a scalar literal or any non-literal init (call / ident /
// binary): those stay conservatively scalar here, matching the standalone
// e049 pass's lack of full type inference. This closes the common
// unannotated-capture parity gap (`var s = "x"`) against native without
// threading the whole type environment into this pass. Returns a sentinel
// e049_is_ref classifies as ref; the concrete name is irrelevant (NameTy.ty
// is read only through e049_is_ref).
function e049_init_ref_ty(init: parser.Expr): string {
    match (init) {
        parser.ExprString(_) => { return "string"; },
        parser.ExprArray(_) => { return "__e049_ref"; },
        parser.ExprStructLit(_) => { return "__e049_ref"; },
        parser.ExprTuple(_) => { return "__e049_ref"; },
        _ => { return ""; }
    }
    return "";
}

// e049_scope collects (name, type) for every `var` declared in stmts,
// descending into control blocks but NOT into lambda bodies — the
// function-level scope a directly-nested closure captures from. An
// unannotated var's type is inferred from an obvious pointer-shaped literal
// init (e049_init_ref_ty) so its write-back capture matches native.
function e049_scope(stmts: parser.Stmt[]): NameTy[] {
    var out: NameTy[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                var vty: string = v.type_name;
                if (vty.len() == 0) { vty = e049_init_ref_ty(v.init); }
                out = out.append(NameTy { nm: v.name, ty: vty });
            },
            parser.StmtIf(f) => { out = e049_append_nt(out, e049_scope(f.then_body)); out = e049_append_nt(out, e049_scope(f.else_body)); },
            parser.StmtWhile(w) => { out = e049_append_nt(out, e049_scope(w.body)); },
            parser.StmtFor(fr) => { out = e049_append_nt(out, e049_scope(fr.body)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = e049_append_nt(out, e049_scope(m.arms[a].body)); a = a + 1; }
            },
            parser.StmtDefer(d) => { var one: parser.Stmt[] = [d.action]; out = e049_append_nt(out, e049_scope(one)); },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// e049_lambda_locals collects a lambda's own bound names (params + body
// var decls, not descending into nested lambdas) — names that shadow an
// enclosing capture.
function e049_lambda_locals(lm: parser.ExprLambda): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < lm.params.len()) { out = out.append(lm.params[i].name); i = i + 1; }
    var sv: NameTy[] = e049_scope(lm.body);
    var j: i32 = 0;
    while (j < sv.len()) { out = out.append(sv[j].nm); j = j + 1; }
    return out;
}

// e049_check_assigns flags assignments inside a lambda body whose target
// is a reference-typed enclosing capture not shadowed by a lambda local.
// Descends into control blocks but not nested lambdas (those are checked
// separately from the enclosing function's scope).
function e049_check_assigns(stmts: parser.Stmt[], enclosing: NameTy[], locals: string[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtAssign(a) => {
                if (!util.has_str(locals, a.target) && e049_ref_capture(enclosing, a.target)) {
                    out = out.append(dg_at("E049", "cannot assign to captured \"" + a.target + "\": a reference-typed closure capture is read-only (return the new value from the closure instead)", a.target_line, a.target_col));
                }
            },
            parser.StmtIf(f) => { out = append_diags(out, e049_check_assigns(f.then_body, enclosing, locals)); out = append_diags(out, e049_check_assigns(f.else_body, enclosing, locals)); },
            parser.StmtWhile(w) => { out = append_diags(out, e049_check_assigns(w.body, enclosing, locals)); },
            parser.StmtFor(fr) => { out = append_diags(out, e049_check_assigns(fr.body, enclosing, locals)); },
            parser.StmtMatch(m) => {
                var a2: i32 = 0;
                while (a2 < m.arms.len()) { out = append_diags(out, e049_check_assigns(m.arms[a2].body, enclosing, locals)); a2 = a2 + 1; }
            },
            parser.StmtDefer(d) => { var one: parser.Stmt[] = [d.action]; out = append_diags(out, e049_check_assigns(one, enclosing, locals)); },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// e049_expr_lambdas finds lambdas in an expression and checks each one's
// body for captured-reference assignments.
function e049_expr_lambdas(e: parser.Expr, enclosing: NameTy[]): Diag[] {
    match (e) {
        parser.ExprLambda(lm) => { return e049_check_assigns(lm.body, enclosing, e049_lambda_locals(lm)); },
        parser.ExprCall(c) => {
            var out: Diag[] = e049_expr_lambdas(c.callee, enclosing);
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, e049_expr_lambdas(c.args[i], enclosing)); i = i + 1; }
            return out;
        },
        parser.ExprBinary(b) => { return append_diags(e049_expr_lambdas(b.left, enclosing), e049_expr_lambdas(b.right, enclosing)); },
        parser.ExprUnary(u) => { return e049_expr_lambdas(u.operand, enclosing); },
        parser.ExprArray(a) => {
            var out: Diag[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, e049_expr_lambdas(a.elements[i], enclosing)); i = i + 1; }
            return out;
        },
        parser.ExprTuple(t) => {
            var out: Diag[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, e049_expr_lambdas(t.elements[i], enclosing)); i = i + 1; }
            return out;
        },
        parser.ExprIndex(ix) => { return append_diags(e049_expr_lambdas(ix.array, enclosing), e049_expr_lambdas(ix.index, enclosing)); },
        parser.ExprFieldAccess(fa) => { return e049_expr_lambdas(fa.obj, enclosing); },
        parser.ExprStructLit(s) => {
            var out: Diag[] = [];
            var i: i32 = 0;
            while (i < s.field_values.len()) { out = append_diags(out, e049_expr_lambdas(s.field_values[i], enclosing)); i = i + 1; }
            return out;
        },
        _ => { var none: Diag[] = []; return none; }
    }
}

// e049_find walks a statement list for lambda-bearing expressions (var
// inits, returns, expr/assign values) and control blocks, checking each
// lambda against the function-level enclosing scope.
function e049_find(stmts: parser.Stmt[], enclosing: NameTy[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { out = append_diags(out, e049_expr_lambdas(v.init, enclosing)); },
            parser.StmtReturn(r) => { out = append_diags(out, e049_expr_lambdas(r.value, enclosing)); },
            parser.StmtExpr(e) => { out = append_diags(out, e049_expr_lambdas(e.value, enclosing)); },
            parser.StmtAssign(a) => { out = append_diags(out, e049_expr_lambdas(a.value, enclosing)); },
            parser.StmtIf(f) => { out = append_diags(out, e049_find(f.then_body, enclosing)); out = append_diags(out, e049_find(f.else_body, enclosing)); },
            parser.StmtWhile(w) => { out = append_diags(out, e049_find(w.body, enclosing)); },
            parser.StmtFor(fr) => { out = append_diags(out, e049_find(fr.body, enclosing)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, e049_find(m.arms[a].body, enclosing)); a = a + 1; }
            },
            parser.StmtDefer(d) => { var one: parser.Stmt[] = [d.action]; out = append_diags(out, e049_find(one, enclosing)); },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

pub function e049_diags(mod: parser.Module): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fn: parser.FuncDecl = mod.funcs[i];
        var encl: NameTy[] = [];
        var p: i32 = 0;
        while (p < fn.params.len()) { encl = encl.append(NameTy { nm: fn.params[p].name, ty: fn.params[p].type_name }); p = p + 1; }
        encl = e049_append_nt(encl, e049_scope(fn.body));
        out = append_diags(out, e049_find(fn.body, encl));
        i = i + 1;
    }
    return out;
}

// e064_unknown_bare reports whether `type_name` is a BARE NOMINAL identifier
// that names no declared type — the E064 case. It is deliberately conservative
// so it never false-positives on the self-host bundle (which would break the
// fixpoint):
//   - empty / inferred annotations and the `void` / `Self` pseudo-types the
//     name resolver doesn't model are skipped;
//   - only a plain identifier ([A-Za-z0-9_]) is considered. Any other shape —
//     an array (`X[]`), generic instantiation (`Box[i32]`), function type
//     (`() => i32`), tuple, `dyn Trait`, or dotted cross-module name — is
//     skipped, because its surface text may legitimately mention an erased
//     generic parameter, a builtin, or syntax the simple resolver doesn't
//     model. Callers further restrict this to NON-generic declarations.
function e064_unknown_bare(type_name: string, struct_names: string[], union_names: string[]): boolean {
    if (type_name.len() == 0) { return false; }
    if (type_name == "void" || type_name == "Self") { return false; }
    // Builtin type keywords the simple name resolver
    // (`type_from_name_with_names_and_unions`) doesn't enumerate — it only
    // knows i32/i64/u32/u64 among integers. u8/usize: the parser accepts
    // them (parser.go parseType), the Go checker treats them as real types,
    // and the stdlib uses them pervasively (`var b: u8` in std/string,
    // `var p: usize` scratch pointers in core/int), so flagging them would
    // diverge from the oracle on every program importing those modules.
    // `str` (the borrowed-string view, #4813): the self-host parser erases
    // a BARE `str` to "string" at the parse boundary, but a `str` inside a
    // generic argument (`Option[str]`) keeps its verbatim spelling — a real
    // native type, so the generic-arg widening must not flag it.
    // byte/char/isize/i8/i16/u16 are intentionally absent: not valid types,
    // so the Go checker rejects them and the self-host must keep flagging.
    if (type_name == "u8" || type_name == "usize" || type_name == "str") { return false; }
    // The parser coarses a function type (`() => R`) to the tag "fn" and some
    // shapes to "tuple"; neither is a user nominal, so don't flag them.
    if (type_name == "fn" || type_name == "tuple") { return false; }
    var i: i32 = 0;
    while (i < type_name.len()) {
        var ch: i32 = type_name[i];
        var alpha: boolean = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
        var digit: boolean = ch >= 48 && ch <= 57;
        if (!alpha && !digit && ch != 95) { return false; }
        i = i + 1;
    }
    return is_unknown(type_from_name_with_names_and_unions(type_name, struct_names, union_names));
}

// e064_unknown_name is the recursive form of the E064 check (#4363 item 3): it
// returns the FIRST unknown bare nominal name reachable through `type_name`'s
// array-element and generic-argument structure, or "" when none is unknown. The
// Go checker reports E064 for `Nope[]` (array element) and `Map[string, Nope]`
// (generic arg) exactly as for a bare `Nope`, naming the inner "Nope";
// e064_unknown_bare deliberately bailed on any non-identifier text, so those
// inner positions went unflagged. Returning the inner NAME (not the outer
// spelling) keeps the emitted message byte-matching native's `unknown type
// "Nope"`.
//
// Decomposition (via parser.parse_type_ref, the single type-spelling scanner):
//   - an array `E[]` reduces to its element E (so `E[][]` and `G[a][]` reduce
//     correctly);
//   - a generic instantiation `G[a, b]` checks each ARGUMENT — never the base
//     G, because a builtin generic container (Map / Cell / Option / Result / a
//     user generic struct) is not in struct_names and would false-positive;
//   - a tuple is skipped (out of item-3 scope, and the simple resolver doesn't
//     model tuple element text);
//   - a bare leaf falls through to the same conservative e064_unknown_bare.
// The callers restrict this to NON-generic, NON-method decls, so an inner bare
// name is never an erased type parameter — a genuine typo, matching the oracle.
function e064_unknown_name(type_name: string, struct_names: string[], union_names: string[], extra_known: string[]): string {
    return e064_unknown_name_tref(parser.parse_type_ref(type_name), struct_names, union_names, extra_known);
}

function e064_unknown_name_tref(tr: parser.TypeRef, struct_names: string[], union_names: string[], extra_known: string[]): string {
    // Array `E[]` → element E (peel one level, keeping the base/args).
    if (tr.array_depth > 0) {
        var elem: parser.TypeRef = parser.TypeRef { base: tr.base, args: tr.args, array_depth: tr.array_depth - 1, is_tuple: tr.is_tuple };
        return e064_unknown_name_tref(elem, struct_names, union_names, extra_known);
    }
    // Tuple: out of scope for the array/generic-arg widening.
    if (tr.is_tuple) { return ""; }
    // Generic instantiation `G[a, b]`: check the BASE, then each arg. The
    // Go checker's checkTypeKnown flags an undeclared generic base
    // (`Statuus[i32]` → E064 "Statuus") exactly like a bare unknown name —
    // knownTypeName accepts any declared struct / enum / trait / resource.
    // The builtin generic containers (Map / Cell) and the reserved builtin
    // enums (Option / Result / …) are registered types natively, so they are
    // allowlisted here; declared traits and resources arrive via extra_known
    // (they aren't in the struct/union name sets this resolver models).
    if (tr.args.len() > 0) {
        if (tr.base != "Map" && tr.base != "Cell" && !is_reserved_enum_name(tr.base)) {
            var kx: boolean = false;
            var xi: i32 = 0;
            while (xi < extra_known.len()) {
                if (extra_known[xi] == tr.base) { kx = true; }
                xi = xi + 1;
            }
            if (!kx && e064_unknown_bare(tr.base, struct_names, union_names)) { return tr.base; }
        }
        var i: i32 = 0;
        while (i < tr.args.len()) {
            var u: string = e064_unknown_name_tref(tr.args[i], struct_names, union_names, extra_known);
            if (u.len() > 0) { return u; }
            i = i + 1;
        }
        return "";
    }
    // Bare leaf: the original conservative identifier check names the type.
    if (e064_unknown_bare(tr.base, struct_names, union_names)) { return tr.base; }
    return "";
}

// e064_var_diags walks a (non-generic, non-method) function body and reports
// E064 for any `var x: T` annotation whose bare nominal type is undefined. It
// recurses into control-flow blocks the same way dupvar_diags does, but not
// into nested function / lambda bodies — those carry their own scope. The
// caller restricts this to functions with no type parameters, so a plain
// identifier that resolves to unknown is a genuine typo, never an erased
// generic parameter.
function e064_var_diags(stmts: parser.Stmt[], struct_names: string[], union_names: string[], extra_known: string[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                var vu: string = e064_unknown_name(v.type_name, struct_names, union_names, extra_known);
                if (vu.len() > 0) {
                    out = out.append(dg_at("E064", "unknown type \"" + vu + "\"", v.line, v.col));
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, e064_var_diags(f.then_body, struct_names, union_names, extra_known));
                out = append_diags(out, e064_var_diags(f.else_body, struct_names, union_names, extra_known));
            },
            parser.StmtWhile(w) => { out = append_diags(out, e064_var_diags(w.body, struct_names, union_names, extra_known)); },
            parser.StmtFor(fr) => { out = append_diags(out, e064_var_diags(fr.body, struct_names, union_names, extra_known)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, e064_var_diags(m.arms[a].body, struct_names, union_names, extra_known)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, e064_var_diags(one, struct_names, union_names, extra_known));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// e057_cell_elem_ok reports whether a TypeRef is a permitted `Cell[T]`
// element — the self-host analog of the native isCellElemType
// (checker.go): a cycle-free scalar (i32/i64/u32/u64/f64/boolean) or
// string. Everything else — struct / enum / array / tuple / another Cell /
// generic instantiation / `str` view — could reconstruct a reference
// cycle, which the immutable-data model forbids (docs/CELL-TYPE-PLAN.md).
function e057_cell_elem_ok(a: parser.TypeRef): boolean {
    if (a.array_depth > 0 || a.is_tuple || a.args.len() > 0) { return false; }
    if (a.base == "i32" || a.base == "i64" || a.base == "u32" || a.base == "u64") { return true; }
    return a.base == "f64" || a.base == "boolean" || a.base == "string";
}

// e057_annot_labels_tref walks a parsed annotation and collects the
// rendered element spelling of every `Cell[X]` whose element is not a
// permitted cell element — the ANNOTATION form of E057 (#4363 item 2).
// Mirrors native resolveType's recursion into generic arguments and tuple
// elements, so a Cell nested anywhere in the spelling (`Option[Cell[P]]`,
// `(i32, Cell[P])`, `Cell[P][]`) fires. The caller restricts this to
// contexts with no type parameter in scope (the E064 scoping), so a
// generic's `Cell[T]` — which native admits as a ParamType element — is
// never flagged.
function e057_annot_labels_tref(tr: parser.TypeRef): string[] {
    var out: string[] = [];
    if (!tr.is_tuple && tr.base == "Cell" && tr.args.len() == 1 && !e057_cell_elem_ok(tr.args[0])) {
        out = out.append(parser.render_type_ref(tr.args[0]));
    }
    var i: i32 = 0;
    while (i < tr.args.len()) {
        var inner: string[] = e057_annot_labels_tref(tr.args[i]);
        var k: i32 = 0;
        while (k < inner.len()) { out = out.append(inner[k]); k = k + 1; }
        i = i + 1;
    }
    return out;
}

// e057_annot_diags parses one annotation spelling and emits E057 (at the
// caller-supplied anchor) for each offending `Cell[X]` in it, byte-matching
// the native message. An empty / un-annotated spelling emits nothing.
function e057_annot_diags(type_name: string, line: i32, col: i32): Diag[] {
    var out: Diag[] = [];
    if (type_name.len() == 0) { return out; }
    var labels: string[] = e057_annot_labels_tref(parser.parse_type_ref(type_name));
    var i: i32 = 0;
    while (i < labels.len()) {
        out = out.append(dg_at("E057", "Cell[" + labels[i] + "] is not allowed: a cell's element type must be a scalar (i32/i64/f64/bool) or string; a composite/reference type could form a cycle, which immutable data structures forbid", line, col));
        i = i + 1;
    }
    return out;
}

// e057_var_diags walks a (non-generic, non-method) function body and
// reports the annotation-form E057 for any `var x: T` annotation embedding
// a `Cell[<composite>]`. Recurses into control-flow blocks exactly like
// e064_var_diags (not into nested function / lambda bodies).
function e057_var_diags(stmts: parser.Stmt[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                out = append_diags(out, e057_annot_diags(v.type_name, v.line, v.col));
            },
            parser.StmtIf(f) => {
                out = append_diags(out, e057_var_diags(f.then_body));
                out = append_diags(out, e057_var_diags(f.else_body));
            },
            parser.StmtWhile(w) => { out = append_diags(out, e057_var_diags(w.body)); },
            parser.StmtFor(fr) => { out = append_diags(out, e057_var_diags(fr.body)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, e057_var_diags(m.arms[a].body)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, e057_var_diags(one));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

// e044_diags ports the Go checker's capture-eligibility rule (E044): a
// closure may capture scalars and pointer-shaped values, but NOT a value
// with no runtime representation — natively ast.VoidType (a `void` call
// result bound to a var) or ast.ParamType (an erased generic type
// parameter), the only two shapes the native captureSink rejects
// (checker.go E044). The self-host type model erases both to `unknown`,
// so this walk works SYNTACTICALLY and stays deliberately narrow (it must
// never false-positive on the bundle):
//   - void suspect: a body `var x = f();` whose callee is a declared free
//     function with an explicit `void` return type;
//   - param-type suspect: in a GENERIC function only, a parameter or body
//     var whose annotation is a bare unknown identifier — a generic's
//     `x: T` is exactly the shape the native checker types as ParamType.
// A lambda (incl. a desugared local `function`) that mentions a suspect —
// without a same-named lambda param shadowing it — draws E044 at the
// enclosing statement, naming the suspect's annotation spelling like
// native ("T" / "void"). Nested blocks re-walk with a copy of the suspect
// set so block-scoped vars don't leak.
function e044_lambda_check(lam: parser.ExprLambda, line: i32, col: i32, suspects: string[], labels: string[]): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < suspects.len()) {
        var shadowed: boolean = false;
        var pi: i32 = 0;
        while (pi < lam.params.len()) {
            if (lam.params[pi].name == suspects[i]) { shadowed = true; }
            pi = pi + 1;
        }
        if (!shadowed && parser.stmts_mention(lam.body, suspects[i])) {
            out = out.append(dg_at("E044", "captured variable \"" + suspects[i] + "\" has unsupported type " + labels[i], line, col));
        }
        i = i + 1;
    }
    return out;
}

function e044_expr(e: parser.Expr, line: i32, col: i32, suspects: string[], labels: string[]): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprLambda(lm) => {
            // Report and stop: stmts_mention already recursed into any
            // nested lambda, so descending again would double-report.
            out = append_diags(out, e044_lambda_check(lm, line, col, suspects, labels));
        },
        parser.ExprBinary(b) => {
            out = append_diags(out, e044_expr(b.left, line, col, suspects, labels));
            out = append_diags(out, e044_expr(b.right, line, col, suspects, labels));
        },
        parser.ExprUnary(u) => { out = append_diags(out, e044_expr(u.operand, line, col, suspects, labels)); },
        parser.ExprCall(c) => {
            out = append_diags(out, e044_expr(c.callee, line, col, suspects, labels));
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, e044_expr(c.args[i], line, col, suspects, labels)); i = i + 1; }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, e044_expr(a.elements[i], line, col, suspects, labels)); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, e044_expr(t.elements[i], line, col, suspects, labels)); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(out, e044_expr(ix.array, line, col, suspects, labels));
            out = append_diags(out, e044_expr(ix.index, line, col, suspects, labels));
        },
        parser.ExprSlice(sl) => {
            out = append_diags(out, e044_expr(sl.array, line, col, suspects, labels));
            out = append_diags(out, e044_expr(sl.start, line, col, suspects, labels));
            out = append_diags(out, e044_expr(sl.end, line, col, suspects, labels));
        },
        parser.ExprFieldAccess(fa) => { out = append_diags(out, e044_expr(fa.obj, line, col, suspects, labels)); },
        parser.ExprStructLit(s) => {
            if (s.has_base) { out = append_diags(out, e044_expr(s.base, line, col, suspects, labels)); }
            var i: i32 = 0;
            while (i < s.field_values.len()) { out = append_diags(out, e044_expr(s.field_values[i], line, col, suspects, labels)); i = i + 1; }
        },
        _ => { }
    }
    return out;
}

function e044_stmts(stmts: parser.Stmt[], is_generic: boolean, struct_names: string[], union_names: string[], void_fns: string[], suspects0: string[], labels0: string[]): Diag[] {
    var out: Diag[] = [];
    var suspects: string[] = suspects0;
    var labels: string[] = labels0;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                out = append_diags(out, e044_expr(v.init, v.line, v.col, suspects, labels));
                // A `var x = f();` binding of a void call is a void suspect.
                var is_void_init: boolean = false;
                match (v.init) {
                    parser.ExprCall(c) => {
                        match (c.callee) {
                            parser.ExprIdent(id) => {
                                var vfi: i32 = 0;
                                while (vfi < void_fns.len()) {
                                    if (void_fns[vfi] == id.name) { is_void_init = true; }
                                    vfi = vfi + 1;
                                }
                            },
                            _ => { }
                        }
                    },
                    _ => { }
                }
                if (is_void_init && v.type_name.len() == 0) {
                    suspects = suspects.append(v.name);
                    labels = labels.append("void");
                } else if (is_generic && e064_unknown_bare(v.type_name, struct_names, union_names)) {
                    suspects = suspects.append(v.name);
                    labels = labels.append(v.type_name);
                }
            },
            parser.StmtReturn(r) => { out = append_diags(out, e044_expr(r.value, r.line, r.col, suspects, labels)); },
            parser.StmtExpr(e) => { out = append_diags(out, e044_expr(e.value, 0, 0, suspects, labels)); },
            parser.StmtAssign(a) => { out = append_diags(out, e044_expr(a.value, a.line, a.col, suspects, labels)); },
            parser.StmtIf(f) => {
                out = append_diags(out, e044_expr(f.cond, 0, 0, suspects, labels));
                out = append_diags(out, e044_stmts(f.then_body, is_generic, struct_names, union_names, void_fns, suspects, labels));
                out = append_diags(out, e044_stmts(f.else_body, is_generic, struct_names, union_names, void_fns, suspects, labels));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, e044_expr(w.cond, 0, 0, suspects, labels));
                out = append_diags(out, e044_stmts(w.body, is_generic, struct_names, union_names, void_fns, suspects, labels));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, e044_expr(fr.iter, 0, 0, suspects, labels));
                out = append_diags(out, e044_stmts(fr.body, is_generic, struct_names, union_names, void_fns, suspects, labels));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, e044_expr(m.scrutinee, m.line, m.col, suspects, labels));
                var a: i32 = 0;
                while (a < m.arms.len()) {
                    out = append_diags(out, e044_stmts(m.arms[a].body, is_generic, struct_names, union_names, void_fns, suspects, labels));
                    a = a + 1;
                }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, e044_stmts(one, is_generic, struct_names, union_names, void_fns, suspects, labels));
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

function e044_diags(efn: parser.FuncDecl, struct_names: string[], union_names: string[], void_fns: string[]): Diag[] {
    var suspects: string[] = [];
    var labels: string[] = [];
    var is_generic: boolean = efn.type_params.len() > 0 || efn.type_param_count > 0;
    if (is_generic) {
        var pi: i32 = 0;
        while (pi < efn.params.len()) {
            if (e064_unknown_bare(efn.params[pi].type_name, struct_names, union_names)) {
                suspects = suspects.append(efn.params[pi].name);
                labels = labels.append(efn.params[pi].type_name);
            }
            pi = pi + 1;
        }
    }
    return e044_stmts(efn.body, is_generic, struct_names, union_names, void_fns, suspects, labels);
}

// ---- E053: `fip` fully-in-place verification -------------------------------
// Port of the native checkFipFunctions (checker.go): a `fip function` carries
// a CHECKED no-heap-allocation guarantee, verified as a sound conservative
// subset. Default-deny: anything not proven heap-neutral is rejected.
// Allowed: scalars, arithmetic/comparison/logic, field & index reads, control
// flow, (re)binding locals, `recv.with(i, v)` / index writes rooted at an
// `own` array parameter (the COW unique-in-place branch), calls to other
// `fip` functions and the whitelisted non-allocating builtin method (`len`).
// Rejected: array / tuple / struct literals, payload-carrying enum variant
// construction, string concatenation (incl. the f-string `+`-chain desugar),
// calls to non-`fip` functions, any other method call, indirect calls, and
// index/field writes not rooted at an `own` parameter.
function e053_root_len(target: string): i32 {
    // `xs[0]` / `p.f` → byte length of the base identifier being written
    // through, or -1 for a bare local rebind (no `[` / `.`), which
    // allocates nothing. Index-based (no slicing) so this stays free of
    // the str-view producer surface.
    var i: i32 = 0;
    while (i < target.len()) {
        var ch: i32 = target[i];
        if (ch == 91 || ch == 46) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function e053_root_is_own(target: string, rl: i32, own: string[]): boolean {
    var oi: i32 = 0;
    while (oi < own.len()) {
        if (own[oi].len() == rl) {
            var eq: boolean = true;
            var k: i32 = 0;
            while (k < rl) {
                if (own[oi][k] != target[k]) { eq = false; }
                k = k + 1;
            }
            if (eq) { return true; }
        }
        oi = oi + 1;
    }
    return false;
}

function e053_stringish(e: parser.Expr, cur: Scope): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        _ => { }
    }
    match (check_expr(e, cur)) {
        TypeString(_) => { return true; },
        _ => { return false; }
    }
}

function e053_expr(e: parser.Expr, fname: string, fips: string[], variants: string[], own: string[], cur: Scope): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprArray(a) => {
            out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not allocate (array literal)", 0, 0));
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, e053_expr(a.elements[i], fname, fips, variants, own, cur)); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not allocate (tuple literal)", t.line, t.col));
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, e053_expr(t.elements[i], fname, fips, variants, own, cur)); i = i + 1; }
        },
        parser.ExprStructLit(sl) => {
            out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not allocate (struct literal \"" + sl.type_name + "\")", sl.line, sl.col));
            if (sl.has_base) { out = append_diags(out, e053_expr(sl.base, fname, fips, variants, own, cur)); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { out = append_diags(out, e053_expr(sl.field_values[i], fname, fips, variants, own, cur)); i = i + 1; }
        },
        parser.ExprBinary(b) => {
            if (b.op == "+" && (e053_stringish(b.left, cur) || e053_stringish(b.right, cur))) {
                out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not allocate (string concatenation)", b.line, b.col));
            }
            out = append_diags(out, e053_expr(b.left, fname, fips, variants, own, cur));
            out = append_diags(out, e053_expr(b.right, fname, fips, variants, own, cur));
        },
        parser.ExprUnary(u) => { out = append_diags(out, e053_expr(u.operand, fname, fips, variants, own, cur)); },
        parser.ExprCall(c) => {
            var args_checked: boolean = false;
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    // Method call. `recv.with(i, v)` on an `own` receiver is
                    // the in-place element set; `len` is the whitelisted
                    // non-allocating read. Everything else is unproven.
                    var recv_root: string = "";
                    match (fa.obj) {
                        parser.ExprIdent(ro) => { recv_root = ro.name; },
                        _ => { }
                    }
                    var root_own: boolean = false;
                    var oi: i32 = 0;
                    while (oi < own.len()) { if (own[oi] == recv_root) { root_own = true; } oi = oi + 1; }
                    if (fa.field == "with" && root_own) {
                        // allowed
                    } else if (fa.field == "len") {
                        // allowed
                    } else {
                        out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not call method \"" + fa.field + "\" (not proven allocation-free)", fa.line, fa.col));
                    }
                    out = append_diags(out, e053_expr(fa.obj, fname, fips, variants, own, cur));
                },
                parser.ExprIdent(id) => {
                    var is_variant: boolean = false;
                    var vi: i32 = 0;
                    while (vi < variants.len()) { if (variants[vi] == id.name) { is_variant = true; } vi = vi + 1; }
                    if (is_variant) {
                        if (c.args.len() > 0) {
                            out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not allocate (enum variant construction)", c.line, c.col));
                        }
                    } else {
                        var is_fip: boolean = false;
                        var fi: i32 = 0;
                        while (fi < fips.len()) { if (fips[fi] == id.name) { is_fip = true; } fi = fi + 1; }
                        if (!is_fip) {
                            out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may only call other `fip` functions, not \"" + id.name + "\"", c.line, c.col));
                        }
                    }
                },
                _ => {
                    out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not make an indirect call (not proven allocation-free)", c.line, c.col));
                    out = append_diags(out, e053_expr(c.callee, fname, fips, variants, own, cur));
                }
            }
            var ai: i32 = 0;
            while (ai < c.args.len()) { out = append_diags(out, e053_expr(c.args[ai], fname, fips, variants, own, cur)); ai = ai + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(out, e053_expr(ix.array, fname, fips, variants, own, cur));
            out = append_diags(out, e053_expr(ix.index, fname, fips, variants, own, cur));
        },
        parser.ExprSlice(sl) => {
            out = append_diags(out, e053_expr(sl.array, fname, fips, variants, own, cur));
            out = append_diags(out, e053_expr(sl.start, fname, fips, variants, own, cur));
            out = append_diags(out, e053_expr(sl.end, fname, fips, variants, own, cur));
        },
        parser.ExprFieldAccess(fa) => { out = append_diags(out, e053_expr(fa.obj, fname, fips, variants, own, cur)); },
        _ => { }
    }
    return out;
}

function e053_stmts(stmts: parser.Stmt[], fname: string, fips: string[], variants: string[], own: string[], s: Scope): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { out = append_diags(out, e053_expr(v.init, fname, fips, variants, own, cur)); },
            parser.StmtReturn(r) => { out = append_diags(out, e053_expr(r.value, fname, fips, variants, own, cur)); },
            parser.StmtExpr(e) => { out = append_diags(out, e053_expr(e.value, fname, fips, variants, own, cur)); },
            parser.StmtAssign(a) => {
                // (Re)binding a local slot allocates nothing; an index/field
                // write is in-place only when rooted at an `own` parameter —
                // otherwise it triggers a copy-on-write.
                var trl: i32 = e053_root_len(a.target);
                if (trl >= 0 && !e053_root_is_own(a.target, trl, own)) {
                    out = out.append(dg_at("E053", "`fip` function \"" + fname + "\" may not write to a non-`own` heap value (triggers a copy-on-write)", a.line, a.col));
                }
                out = append_diags(out, e053_expr(a.value, fname, fips, variants, own, cur));
            },
            parser.StmtIf(f) => {
                out = append_diags(out, e053_expr(f.cond, fname, fips, variants, own, cur));
                out = append_diags(out, e053_stmts(f.then_body, fname, fips, variants, own, cur));
                out = append_diags(out, e053_stmts(f.else_body, fname, fips, variants, own, cur));
            },
            parser.StmtWhile(w) => {
                out = append_diags(out, e053_expr(w.cond, fname, fips, variants, own, cur));
                out = append_diags(out, e053_stmts(w.body, fname, fips, variants, own, cur));
            },
            parser.StmtFor(fr) => {
                out = append_diags(out, e053_expr(fr.iter, fname, fips, variants, own, cur));
                out = append_diags(out, e053_stmts(fr.body, fname, fips, variants, own, cur));
            },
            parser.StmtMatch(m) => {
                out = append_diags(out, e053_expr(m.scrutinee, fname, fips, variants, own, cur));
                var a2: i32 = 0;
                while (a2 < m.arms.len()) { out = append_diags(out, e053_stmts(m.arms[a2].body, fname, fips, variants, own, cur)); a2 = a2 + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, e053_stmts(one, fname, fips, variants, own, cur));
            },
            _ => { }
        }
        cur = check_stmt(stmts[i], cur).scope;
        i = i + 1;
    }
    return out;
}

function e053_diags(efn: parser.FuncDecl, fips: string[], variants: string[], s: Scope): Diag[] {
    var own: string[] = [];
    var pi: i32 = 0;
    while (pi < efn.params.len()) {
        if (efn.params[pi].own) { own = own.append(efn.params[pi].name); }
        pi = pi + 1;
    }
    return e053_stmts(efn.body, efn.name, fips, variants, own, s);
}

// ---- E065: returning a `str` view of a function-local string ---------------
// Port of the native checkStrEscape (checker.go): a function whose declared
// return type is `str` (recorded on FuncDecl.ret_str before the parse-time
// erasure) must not return a view of a function-LOCAL owned string — the
// backing box is reclaimed when the frame drops. Mirrors the native chase:
// a string literal is immortal, a parameter caller-owned; a local owned
// `string` IS the backing storage; a local `str` binding (StmtVar.is_str)
// views whatever its initializer views. Calls / slices are not chased (the
// native rule's documented hole — both tighten together later). `sbacked`
// accumulates locals known to be (views of) local string storage.
function e065_ident_in(name: string, xs: string[]): boolean {
    var i: i32 = 0;
    while (i < xs.len()) { if (xs[i] == name) { return true; } i = i + 1; }
    return false;
}

function e065_stmts(stmts: parser.Stmt[], fname: string, params: string[], str_ret_names: string[], sbacked: string[], s: Scope): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                if (v.is_str) {
                    // A `str` binding views its initializer: tainted only
                    // when the init is (a view of) local string storage —
                    // a backed ident, or a slice whose SOURCE is backed
                    // (the P2 flip makes s[a:b] a view, and the native
                    // chase follows it to the backing local).
                    match (v.init) {
                        parser.ExprIdent(id) => {
                            if (!e065_ident_in(id.name, params) && e065_ident_in(id.name, sbacked)) { sbacked = sbacked.append(v.name); }
                        },
                        parser.ExprSlice(vsl) => {
                            match (vsl.array) {
                                parser.ExprIdent(sid) => {
                                    if (!e065_ident_in(sid.name, params) && e065_ident_in(sid.name, sbacked)) { sbacked = sbacked.append(v.name); }
                                },
                                _ => { }
                            }
                        },
                        _ => { }
                    }
                } else if (v.type_name == "string") {
                    // An annotated owned `string` local IS backing storage.
                    sbacked = sbacked.append(v.name);
                } else if (v.type_name.len() == 0) {
                    // Unannotated: infer the native way — a string literal,
                    // a (copying) string slice, or an alias of known local
                    // storage makes an owned StringType local; a call to a
                    // `str`-returning function makes a view (not chased).
                    match (v.init) {
                        parser.ExprString(_) => { sbacked = sbacked.append(v.name); },
                        parser.ExprSlice(sl) => {
                            // A string slice is a VIEW (P2): backed only when
                            // its source is a backed local, mirroring the
                            // native chase (a slice of a parameter is safe).
                            match (sl.array) {
                                parser.ExprIdent(sid) => {
                                    if (!e065_ident_in(sid.name, params) && e065_ident_in(sid.name, sbacked)) { sbacked = sbacked.append(v.name); }
                                },
                                _ => { }
                            }
                        },
                        parser.ExprIdent(id) => {
                            if (e065_ident_in(id.name, sbacked)) { sbacked = sbacked.append(v.name); }
                        },
                        parser.ExprCall(c) => {
                            var callee_name: string = "";
                            match (c.callee) {
                                parser.ExprIdent(cid) => { callee_name = cid.name; },
                                parser.ExprFieldAccess(cfa) => { callee_name = cfa.field; },
                                _ => { }
                            }
                            if (!e065_ident_in(callee_name, str_ret_names)) {
                                match (check_expr(v.init, cur)) {
                                    TypeString(_) => { sbacked = sbacked.append(v.name); },
                                    _ => { }
                                }
                            }
                        },
                        _ => { }
                    }
                }
            },
            parser.StmtReturn(r) => {
                match (r.value) {
                    parser.ExprIdent(id) => {
                        if (!e065_ident_in(id.name, params) && e065_ident_in(id.name, sbacked)) {
                            out = out.append(dg_at("E065", "returning a `str` view of a function-local string: the backing string is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned `string` (materialise with .to_owned()) or view a parameter instead", r.line, r.col));
                        }
                    },
                    _ => { }
                }
            },
            parser.StmtIf(f) => {
                out = append_diags(out, e065_stmts(f.then_body, fname, params, str_ret_names, sbacked, cur));
                out = append_diags(out, e065_stmts(f.else_body, fname, params, str_ret_names, sbacked, cur));
            },
            parser.StmtWhile(w) => { out = append_diags(out, e065_stmts(w.body, fname, params, str_ret_names, sbacked, cur)); },
            parser.StmtFor(fr) => { out = append_diags(out, e065_stmts(fr.body, fname, params, str_ret_names, sbacked, cur)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, e065_stmts(m.arms[a].body, fname, params, str_ret_names, sbacked, cur)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, e065_stmts(one, fname, params, str_ret_names, sbacked, cur));
            },
            _ => { }
        }
        cur = check_stmt(stmts[i], cur).scope;
        i = i + 1;
    }
    return out;
}

function e065_diags(efn: parser.FuncDecl, str_ret_names: string[], s: Scope): Diag[] {
    var params: string[] = [];
    var pi: i32 = 0;
    while (pi < efn.params.len()) { params = params.append(efn.params[pi].name); pi = pi + 1; }
    if (efn.receiver_name.len() > 0) { params = params.append(efn.receiver_name); }
    var none: string[] = [];
    return e065_stmts(efn.body, efn.name, params, str_ret_names, none, s);
}

// ---- E032: `use` binding-type inference ------------------------------------
// Port of the native inferUseParam (checker.go): `use BIND <- CALLEE(args);`
// with no `: TYPE` annotation infers BIND's type from CALLEE's signature —
// the trailing function-typed parameter's first argument. The parser marks
// the synthesised callback lambda with use_infer; this walk verifies the
// inference has a signature to read: the callee must be a bare identifier
// with a known signature whose last parameter is a function type taking at
// least one argument. (The native generic-unification failure arm is not
// ported — the self-host's erased-generics model has no substitution to
// fail; that arm stays native-only until the checker grows unification.)
function e032_call_check(c: parser.ExprCall, lastfn: string[], cur: Scope): Diag[] {
    var out: Diag[] = [];
    if (c.args.len() == 0) { return out; }
    var infer: boolean = false;
    match (c.args[c.args.len() - 1]) {
        parser.ExprLambda(lm) => {
            if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) { infer = true; }
        },
        _ => { }
    }
    if (!infer) { return out; }
    var callee_name: string = "";
    match (c.callee) {
        parser.ExprIdent(id) => { callee_name = id.name; },
        _ => {
            out = out.append(dg_at("E032", "use: cannot infer binding type for non-identifier source — add an explicit `: TYPE` annotation", c.line, c.col));
            return out;
        }
    }
    // Resolve the callee: a module-level signature, or a local
    // function-typed binding (a closure-valued var). The self-host type
    // model coarses a function-type PARAMETER to the tag "fn" (its arity
    // is not retained), so the last-parameter-is-a-function test reads
    // the `lastfn` side table built from the parsed decls; the native
    // "callback takes no arguments" arity arm is not decidable here and
    // stays native-only (like the generic-unification arm).
    var sig: FuncSig = cur.lookup_sig(callee_name);
    var have_sig: boolean = sig.name.len() > 0;
    if (have_sig) {
        if (sig.param_types.len() == 0) {
            out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", c.line, c.col));
            return out;
        }
        var lf: boolean = false;
        var li: i32 = 0;
        while (li < lastfn.len()) { if (lastfn[li] == callee_name) { lf = true; } li = li + 1; }
        if (!lf) {
            out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", c.line, c.col));
        }
        return out;
    }
    match (cur.lookup(callee_name)) {
        TypeFunc(ft) => {
            if (ft.param_types.len() == 0) {
                out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", c.line, c.col));
                return out;
            }
            match (ft.param_types[ft.param_types.len() - 1]) {
                TypeFunc(cb) => {
                    if (cb.param_types.len() == 0) {
                        out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", c.line, c.col));
                    }
                },
                _ => {
                    out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", c.line, c.col));
                }
            }
            return out;
        },
        _ => { }
    }
    out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", c.line, c.col));
    return out;
}

function e032_expr(e: parser.Expr, lastfn: string[], cur: Scope): Diag[] {
    var out: Diag[] = [];
    match (e) {
        parser.ExprCall(c) => {
            out = append_diags(out, e032_call_check(c, lastfn, cur));
            out = append_diags(out, e032_expr(c.callee, lastfn, cur));
            var i: i32 = 0;
            while (i < c.args.len()) { out = append_diags(out, e032_expr(c.args[i], lastfn, cur)); i = i + 1; }
        },
        parser.ExprBinary(b) => {
            out = append_diags(out, e032_expr(b.left, lastfn, cur));
            out = append_diags(out, e032_expr(b.right, lastfn, cur));
        },
        parser.ExprUnary(u) => { out = append_diags(out, e032_expr(u.operand, lastfn, cur)); },
        parser.ExprLambda(lm) => { out = append_diags(out, e032_stmts(lm.body, lastfn, cur)); },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = append_diags(out, e032_expr(a.elements[i], lastfn, cur)); i = i + 1; }
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = append_diags(out, e032_expr(t.elements[i], lastfn, cur)); i = i + 1; }
        },
        parser.ExprIndex(ix) => {
            out = append_diags(out, e032_expr(ix.array, lastfn, cur));
            out = append_diags(out, e032_expr(ix.index, lastfn, cur));
        },
        parser.ExprSlice(sl) => { out = append_diags(out, e032_expr(sl.array, lastfn, cur)); },
        parser.ExprFieldAccess(fa) => { out = append_diags(out, e032_expr(fa.obj, lastfn, cur)); },
        parser.ExprStructLit(sx) => {
            if (sx.has_base) { out = append_diags(out, e032_expr(sx.base, lastfn, cur)); }
            var i: i32 = 0;
            while (i < sx.field_values.len()) { out = append_diags(out, e032_expr(sx.field_values[i], lastfn, cur)); i = i + 1; }
        },
        _ => { }
    }
    return out;
}

function e032_stmts(stmts: parser.Stmt[], lastfn: string[], s: Scope): Diag[] {
    var out: Diag[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { out = append_diags(out, e032_expr(v.init, lastfn, cur)); },
            parser.StmtReturn(r) => { out = append_diags(out, e032_expr(r.value, lastfn, cur)); },
            parser.StmtExpr(e) => { out = append_diags(out, e032_expr(e.value, lastfn, cur)); },
            parser.StmtAssign(a) => { out = append_diags(out, e032_expr(a.value, lastfn, cur)); },
            parser.StmtIf(f) => {
                out = append_diags(out, e032_expr(f.cond, lastfn, cur));
                out = append_diags(out, e032_stmts(f.then_body, lastfn, cur));
                out = append_diags(out, e032_stmts(f.else_body, lastfn, cur));
            },
            parser.StmtWhile(w) => { out = append_diags(out, e032_stmts(w.body, lastfn, cur)); },
            parser.StmtFor(fr) => { out = append_diags(out, e032_stmts(fr.body, lastfn, cur)); },
            parser.StmtMatch(m) => {
                var a: i32 = 0;
                while (a < m.arms.len()) { out = append_diags(out, e032_stmts(m.arms[a].body, lastfn, cur)); a = a + 1; }
            },
            parser.StmtDefer(d) => {
                var one: parser.Stmt[] = [d.action];
                out = append_diags(out, e032_stmts(one, lastfn, cur));
            },
            _ => { }
        }
        cur = check_stmt(stmts[i], cur).scope;
        i = i + 1;
    }
    return out;
}

// e021_diags reports E021 (#4347): an `impl Trait for Type` block that omits a
// REQUIRED (abstract, non-defaulted) trait method. mod.trait_reqs carries each
// trait's abstract method set; mod.impls records each impl's explicitly-provided
// methods. For every impl, every required method of its trait that the impl
// doesn't provide draws E021 — matching native's `Type does not implement
// Trait: missing method "m"`. A defaulted method is never in trait_reqs (the
// default is synthesised onto the impl), so a complete-via-default impl is
// never falsely flagged. This is the first slice of the E021 family; arity /
// object-safety / supertrait / bound conformance (+ E060 / E062) are follow-ups.
// e021_recv_method_idx returns the index in mod.funcs of the receiver method
// named `m` on base type `ty`, or -1. This is the impl's PROVIDING method — a
// written impl method OR an inherent method an empty impl adopts (a builtin like
// i32.to_string from core/int, matching native's "empty impls adopt the existing
// method" rule: `impl Display for i32 { }` is valid because i32 already carries
// to_string). A -1 with no in-block method_names entry is the missing-method
// E021; a hit additionally drives the signature check.
function e021_recv_method_idx(mod: parser.Module, ty: string, m: string): i32 {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[i];
        if (f.receiver_type.len() > 0 && f.name == m && util.base_type_name(f.receiver_type) == ty) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// e021_sig_matches compares a trait's required method signature `req` against
// the impl's providing method `impl_fn` (Self resolved to impl_type). It is
// DELIBERATELY conservative — returns true (no diagnostic) whenever it can't
// compare with certainty — so it never false-positives on the self-host bundle:
//   - only receiver-shaped trait methods (a leading `self` param) are compared;
//     associated functions (Default.default etc.) are skipped;
//   - a generic trait method OR impl method (type params present) is skipped,
//     since a bare type-name string compare can't see the erased params;
// otherwise the trait's post-`self` param type list + return type (each rewritten
// Self -> impl_type via the same parser.subst_self finalize_impl_method used on
// the impl side) must equal the impl method's params + return, or it's a
// mismatch (native E021 "wrong signature").
function e021_sig_matches(req: parser.FuncDecl, impl_fn: parser.FuncDecl, impl_type: string): boolean {
    if (req.type_params.len() > 0 || req.type_param_count > 0) { return true; }
    if (impl_fn.type_params.len() > 0 || impl_fn.type_param_count > 0) { return true; }
    if (req.params.len() == 0) { return true; }
    if (req.params[0].name != "self") { return true; }
    // Trait's post-self param count must equal the impl method's param count
    // (the impl peeled its own `self` into the receiver).
    if (req.params.len() - 1 != impl_fn.params.len()) { return false; }
    var i: i32 = 1;
    while (i < req.params.len()) {
        var want: string = parser.subst_self(req.params[i].type_name, impl_type);
        if (want != impl_fn.params[i - 1].type_name) { return false; }
        i = i + 1;
    }
    if (parser.subst_self(req.ret_type, impl_type) != impl_fn.ret_type) { return false; }
    return true;
}

// e021_has_impl reports whether the module contains an `impl <trait_name> for
// <impl_type>` — used for the supertrait-conformance check (#4347 slice 3).
function e021_has_impl(mod: parser.Module, trait_name: string, impl_type: string): boolean {
    var i: i32 = 0;
    while (i < mod.impls.len()) {
        if (mod.impls[i].trait_name == trait_name && mod.impls[i].impl_type == impl_type) { return true; }
        i = i + 1;
    }
    return false;
}

function e021_diags(mod: parser.Module): Diag[] {
    var out: Diag[] = [];
    var i: i32 = 0;
    while (i < mod.impls.len()) {
        var im: parser.ImplInfo = mod.impls[i];
        var ti: i32 = 0;
        while (ti < mod.trait_reqs.len()) {
            if (mod.trait_reqs[ti].trait_name == im.trait_name) {
                // Supertrait conformance: `impl B for T` where `trait B: A`
                // requires a separate `impl A for T` (#4347 slice 3).
                var sup: string[] = mod.trait_reqs[ti].supertraits;
                var si: i32 = 0;
                while (si < sup.len()) {
                    if (!e021_has_impl(mod, sup[si], im.impl_type)) {
                        out = out.append(dg("E021", "impl " + im.trait_name + " for " + im.impl_type + " also requires `impl " + sup[si] + " for " + im.impl_type + "` (supertrait of " + im.trait_name + ")"));
                    }
                    si = si + 1;
                }
                var reqs: string[] = mod.trait_reqs[ti].methods;
                var sigs: parser.FuncDecl[] = mod.trait_reqs[ti].req_sigs;
                var ri: i32 = 0;
                while (ri < reqs.len()) {
                    // Satisfied if the impl block writes it OR the type already
                    // has an inherent / cross-impl method of that name (native's
                    // "adopt the existing method" rule).
                    var midx: i32 = e021_recv_method_idx(mod, im.impl_type, reqs[ri]);
                    if (!name_in(reqs[ri], im.method_names) && midx < 0) {
                        out = out.append(dg("E021", im.impl_type + " does not implement " + im.trait_name + ": missing method \"" + reqs[ri] + "\""));
                    } else if (midx >= 0 && ri < sigs.len()) {
                        // Provided as a receiver method — check its signature
                        // against the trait's declaration (#4347 slice 2).
                        if (!e021_sig_matches(sigs[ri], mod.funcs[midx], im.impl_type)) {
                            out = out.append(dg("E021", im.impl_type + "." + reqs[ri] + " has the wrong signature for trait " + im.trait_name));
                        }
                    }
                    ri = ri + 1;
                }
            }
            ti = ti + 1;
        }
        i = i + 1;
    }
    return out;
}

// e021_derive_field_known reports whether a derive-field type name is
// one the conformance pre-check can reason about: a primitive scalar or
// a declared struct / enum name. Composite shapes (`i32[]`, tuples,
// maps, closures) and unknown names stay silent — matching the native
// pre-check, which skips any type it cannot name.
function e021_derive_field_known(mod: parser.Module, fty: string): boolean {
    if (fty == "i32" || fty == "i64" || fty == "u32" || fty == "u64"
        || fty == "f32" || fty == "f64" || fty == "boolean" || fty == "string") { return true; }
    var i: i32 = 0;
    while (i < mod.structs.len()) { if (mod.structs[i].name == fty) { return true; } i = i + 1; }
    var j: i32 = 0;
    while (j < mod.enums.len()) { if (mod.enums[j].name == fty) { return true; } j = j + 1; }
    return false;
}

// e021_derive_conforms reports whether derive-field type `fty` satisfies
// trait `tr` (requirement record at `treq_idx`): an explicit `impl tr
// for fty`, or fty providing every required trait method as a receiver
// method — which captures both an inherent method set and a field type
// whose OWN @derive already synthesised the methods at parse time.
// Mirrors e021_conforms' bias: a trait with no required methods
// conforms only via the explicit impl.
function e021_derive_conforms(mod: parser.Module, tr: string, treq_idx: i32, fty: string): boolean {
    if (e021_has_impl(mod, tr, fty)) { return true; }
    var reqs: string[] = mod.trait_reqs[treq_idx].methods;
    if (reqs.len() == 0) { return false; }
    var mi: i32 = 0;
    while (mi < reqs.len()) {
        if (e021_recv_method_idx(mod, fty, reqs[mi]) < 0) { return false; }
        mi = mi + 1;
    }
    return true;
}

// e021_derive_one_diag returns the E021 for ONE @derive(tr) on type
// `tname` (struct fields or flattened enum variant payloads: labels[i]
// names types[i] in the message), or none. Gates mirror the native
// pre-check (#5392): only the field-wise-comparing kinds Eq / Ord /
// Hash, only a trait declared in this module, only known non-generic
// field types; the first non-conforming field draws the single
// diagnostic at the deriving decl.
function e021_derive_one_diag(mod: parser.Module, tr: string, tname: string, labels: string[], ftys: string[], tps: string[], ln: i32, cl: i32): Diag[] {
    var kind: string = parser.derive_simple_name(tr);
    if (kind != "Eq" && kind != "Ord" && kind != "Hash") { return []; }
    var tidx: i32 = e021_trait_idx(tr, mod.trait_reqs);
    if (tidx < 0) { return []; }
    var fi: i32 = 0;
    while (fi < ftys.len()) {
        var fty: string = ftys[fi];
        if (!name_in(fty, tps) && e021_derive_field_known(mod, fty)) {
            if (!e021_derive_conforms(mod, tr, tidx, fty)) {
                return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[fi] + " of type " + fty + " does not implement " + tr + " — add `impl " + tr + " for " + fty + "` (or remove the derive)", ln, cl)];
            }
        }
        fi = fi + 1;
    }
    return [];
}

// e021_derive_field_diags reports E021 (#5392) for a struct/enum
// @derive(Eq/Ord/Hash) whose field (variant payload) type does not
// implement the derived trait — the self-host mirror of the native
// checker's preCheckDeriveFields. One diagnostic per (type, trait),
// at the deriving declaration.
function e021_derive_field_diags(mod: parser.Module): Diag[] {
    var out: Diag[] = [];
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var sd: parser.StructDecl = mod.structs[si];
        if (sd.enum_owner.len() == 0 && sd.derives.len() > 0) {
            var labels: string[] = [];
            var ftys: string[] = [];
            var fj: i32 = 0;
            while (fj < sd.fields.len()) {
                labels = labels.append("field " + sd.fields[fj].name);
                ftys = ftys.append(sd.fields[fj].type_name);
                fj = fj + 1;
            }
            var di: i32 = 0;
            while (di < sd.derives.len()) {
                out = append_diags(out, e021_derive_one_diag(mod, sd.derives[di], sd.name, labels, ftys, sd.type_params, sd.line, sd.col));
                di = di + 1;
            }
        }
        si = si + 1;
    }
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        var ed: parser.EnumDecl = mod.enums[ei];
        var elabels: string[] = [];
        var eftys: string[] = [];
        var ederives: string[] = [];
        var vi: i32 = 0;
        while (vi < mod.structs.len()) {
            var vs: parser.StructDecl = mod.structs[vi];
            if (vs.enum_owner == ed.name) {
                if (ederives.len() == 0) { ederives = vs.derives; }
                var pk: i32 = 0;
                while (pk < vs.fields.len()) {
                    elabels = elabels.append("variant " + vs.name + " payload");
                    eftys = eftys.append(vs.fields[pk].type_name);
                    pk = pk + 1;
                }
            }
            vi = vi + 1;
        }
        var edi: i32 = 0;
        while (edi < ederives.len()) {
            out = append_diags(out, e021_derive_one_diag(mod, ederives[edi], ed.name, elabels, eftys, ed.type_params, ed.line, ed.col));
            edi = edi + 1;
        }
        ei = ei + 1;
    }
    return out;
}

// e021_object_unsafe_method returns the name of a required method that makes
// `trait_name` NOT object-safe (so it can't be used as `dyn T`), or "" when the
// trait is object-safe or unknown. A trait method breaks object-safety when it
// is an associated function (no leading `self` receiver), returns `Self`, or is
// generic — a `dyn` value has no statically-known Self, so none of those can
// dispatch through a vtable. Conservative: only the trait's ABSTRACT methods
// (trait_reqs.req_sigs) are inspected, so a default method that happens to be
// object-unsafe is not caught here (never a false positive).
function e021_object_unsafe_method(mod: parser.Module, trait_name: string): string {
    var ti: i32 = 0;
    while (ti < mod.trait_reqs.len()) {
        if (mod.trait_reqs[ti].trait_name == trait_name) {
            var sigs: parser.FuncDecl[] = mod.trait_reqs[ti].req_sigs;
            var si: i32 = 0;
            while (si < sigs.len()) {
                var f: parser.FuncDecl = sigs[si];
                if (f.params.len() == 0 || f.params[0].name != "self") { return f.name; }
                if (f.ret_type == "Self") { return f.name; }
                if (f.type_params.len() > 0 || f.type_param_count > 0) { return f.name; }
                si = si + 1;
            }
            return "";
        }
        ti = ti + 1;
    }
    return "";
}

// e021_dyn_target returns the trait name of a `dyn T` type annotation (the text
// after the `dyn ` prefix), or "" for any non-dyn type. A trailing `[]` (a
// `dyn T[]` array) is stripped so the element trait is classified.
function e021_dyn_target(type_name: string): string {
    if (type_name.len() < 5 || type_name[0:4] != "dyn ") { return ""; }
    var t: str = type_name[4:type_name.len()];
    while (t.len() >= 2 && t[t.len() - 2] == 91 && t[t.len() - 1] == 93) { t = t[0:t.len() - 2]; }
    return t + "";
}

// e021_object_safety_diags reports E021 for a `dyn T` annotation whose trait T
// is not object-safe (#4347 slice 4). Scans function param + return type
// positions — the sites the Go checker flags (a `dyn T` struct field is NOT
// flagged there, so it's deliberately excluded to keep parity). A dyn of an
// object-safe or unknown trait is left alone.
function e021_object_safety_diags(mod: parser.Module): Diag[] {
    var out: Diag[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var fn: parser.FuncDecl = mod.funcs[fi];
        var pi: i32 = 0;
        while (pi < fn.params.len()) {
            var pt: string = e021_dyn_target(fn.params[pi].type_name);
            if (pt.len() > 0) {
                var pm: string = e021_object_unsafe_method(mod, pt);
                if (pm.len() > 0) { out = out.append(dg("E021", "trait " + pt + " is not object-safe: method \"" + pm + "\"")); }
            }
            pi = pi + 1;
        }
        var rt: string = e021_dyn_target(fn.ret_type);
        if (rt.len() > 0) {
            var rm: string = e021_object_unsafe_method(mod, rt);
            if (rm.len() > 0) { out = out.append(dg("E021", "trait " + rt + " is not object-safe: method \"" + rm + "\"")); }
        }
        fi = fi + 1;
    }
    return out;
}

// --- E060 / E062: dyn downcast target + ambiguous dyn method (#4347) --------
//
// Both checks key on a local/param whose ANNOTATION is a `dyn` type ("dyn A" /
// "dyn A + B") — the self-host checker has no dyn-trait Type (a dyn value
// types `unknown`), so the textual annotation is the authoritative, zero-
// false-positive source of the trait set, exactly like e021_dyn_target's use
// for object-safety. A name annotated dyn MORE than once, or re-declared with
// any other type, is blanked (shadowing could change the set).

// e060_dyn_set_of returns the "A" / "A + B" tail of a dyn annotation, or ""
// for any non-dyn type (a `dyn T[]` ARRAY is excluded — its element, not the
// ident, is the dyn value; neither check applies to the array ident).
function e060_dyn_set_of(type_name: string): string {
    if (type_name.len() < 5 || type_name[0:4] != "dyn ") { return ""; }
    var t: str = type_name[4:type_name.len()];
    if (t.len() >= 2 && t[t.len() - 2] == 91 && t[t.len() - 1] == 93) { return ""; }   // "[]"
    return t + "";
}

// e060_split_traits splits "A + B [+ C…]" into trait names (trimmed on the
// literal " + " separator the parser's dyn annotation spelling uses).
function e060_split_traits(set: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i + 3 <= set.len()) {
        if (set[i:i + 3] == " + ") {
            out = out.append(set[start:i]);
            start = i + 3;
            i = i + 3;
        } else { i = i + 1; }
    }
    return out.append(set[start:set.len()]);
}

// e060_trait_known: the trait appears in trait_reqs (declared in the merged
// module) — the gate that keeps both checks silent when any trait in the set
// is unknown here (an impl could exist beyond what mod records).
function e060_trait_known(mod: parser.Module, trait_name: string): boolean {
    var i: i32 = 0;
    while (i < mod.trait_reqs.len()) {
        if (mod.trait_reqs[i].trait_name == trait_name) { return true; }
        i = i + 1;
    }
    return false;
}

// e060_trait_declares: trait `trait_name` declares method `m` — its ABSTRACT
// method set only (trait_reqs.methods); a defaulted method isn't recorded, so
// an ambiguity involving one is conservatively missed, never invented.
function e060_trait_declares(mod: parser.Module, trait_name: string, m: string): boolean {
    var i: i32 = 0;
    while (i < mod.trait_reqs.len()) {
        if (mod.trait_reqs[i].trait_name == trait_name) { return name_in(m, mod.trait_reqs[i].methods); }
        i = i + 1;
    }
    return false;
}

// e060_collect_dyn_locals records `name|set` for each param / var whose
// annotation is a dyn type, recursing nested blocks; a name bound MORE than
// once anywhere in the function (dyn or not) is blanked to "name|" so
// shadowing never mislabels a value. Assignment (`d = other`) keeps the
// declared annotation, matching the type system.
function e060_collect_dyn_locals(stmts: parser.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => {
                var seen: i32 = 0;
                var k: i32 = 0;
                while (k < a.len()) {
                    var e: string = a[k];
                    var bar: i32 = 0;
                    while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
                    if (e[0:bar] == v.name) { a = a.with(k, v.name + "|"); seen = 1; }
                    k = k + 1;
                }
                if (seen == 0) { a = a.append(v.name + "|" + e060_dyn_set_of(v.type_name)); }
            },
            parser.StmtIf(f) => { a = e060_collect_dyn_locals(f.then_body, a); a = e060_collect_dyn_locals(f.else_body, a); },
            parser.StmtWhile(w) => { a = e060_collect_dyn_locals(w.body, a); },
            parser.StmtFor(fo) => { a = e060_collect_dyn_locals(fo.body, a); },
            parser.StmtMatch(m) => { var mi: i32 = 0; while (mi < m.arms.len()) { a = e060_collect_dyn_locals(m.arms[mi].body, a); mi = mi + 1; } },
            parser.StmtDefer(d) => { a = e060_collect_dyn_locals([d.action], a); },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

// e060_set_of_name looks `name` up in the collected `name|set` entries.
function e060_set_of_name(dyns: string[], name: string): string {
    var i: i32 = 0;
    while (i < dyns.len()) {
        var e: string = dyns[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }
        if (e[0:bar] == name) { return e[bar + 1:e.len()] + ""; }
        i = i + 1;
    }
    return "";
}

// e060_is_primitive_name: a spelling that can NEVER be a struct/enum — the
// definitely-wrong `as?` targets the target-shape arm flags. Mirrors the
// zero-false-positive primitive gates of E033/E042/E059.
function e060_is_primitive_name(t: string): boolean {
    return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64"
        || t == "f32" || t == "f64" || t == "boolean" || t == "string" || t == "usize";
}

// e060_e062_expr walks one expression, flagging:
//   E060 — `d as? T` where d is a dyn-annotated ident: T a primitive → the
//   target-shape arm; T a declared plain struct / enum missing an `impl` for
//   any trait in d's set (every trait known) → the not-implementing arm, with
//   the missing traits joined " + " exactly like native's missingDynTraits.
//   E062 — `d.m(args)` where d's set has 2+ traits and 2+ of them declare m.
function e060_e062_expr(e: parser.Expr, dyns: string[], mod: parser.Module, acc: Diag[]): Diag[] {
    var out: Diag[] = acc;
    match (e) {
        parser.ExprUnary(u) => {
            if (u.op.len() > 4 && u.op[0:4] == "as?_") {
                match (u.operand) {
                    parser.ExprIdent(id) => {
                        var set: string = e060_set_of_name(dyns, id.name);
                        if (set.len() > 0) {
                            var tgt: str = u.op[4:u.op.len()];
                            if (e060_is_primitive_name(tgt)) {
                                out = out.append(dg_at("E060", "'as?' downcast target must be a concrete struct or enum type (slice 1), got " + tgt, u.line, u.col));
                            } else if ((e060_decl_is_plain_struct(mod, tgt) || e060_decl_is_enum(mod, tgt))) {
                                var trs: string[] = e060_split_traits(set);
                                var all_known: boolean = true;
                                var missing: string = "";
                                var ti: i32 = 0;
                                while (ti < trs.len()) {
                                    if (!e060_trait_known(mod, trs[ti])) { all_known = false; }
                                    else if (!e021_has_impl(mod, trs[ti], tgt)) {
                                        if (missing.len() > 0) { missing = missing + " + "; }
                                        missing = missing + trs[ti];
                                    }
                                    ti = ti + 1;
                                }
                                if (all_known && missing.len() > 0) {
                                    out = out.append(dg_at("E060", tgt + " does not implement " + missing + ", so a 'dyn " + set + "' cannot downcast to it", u.line, u.col));
                                }
                            }
                        }
                    },
                    _ => {}
                }
            }
            return e060_e062_expr(u.operand, dyns, mod, out);
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        parser.ExprIdent(rid) => {
                            var rset: string = e060_set_of_name(dyns, rid.name);
                            if (rset.len() > 0) {
                                var rtrs: string[] = e060_split_traits(rset);
                                if (rtrs.len() >= 2) {
                                    var declaring: string = "";
                                    var n_decl: i32 = 0;
                                    var di: i32 = 0;
                                    while (di < rtrs.len()) {
                                        if (e060_trait_declares(mod, rtrs[di], fa.field)) {
                                            if (n_decl > 0) { declaring = declaring + ", "; }
                                            declaring = declaring + rtrs[di];
                                            n_decl = n_decl + 1;
                                        }
                                        di = di + 1;
                                    }
                                    if (n_decl >= 2) {
                                        out = out.append(dg_at("E062", "ambiguous method \"" + fa.field + "\" on `dyn " + rset + "`: declared by traits " + declaring, fa.line, fa.col));
                                    }
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            out = e060_e062_expr(c.callee, dyns, mod, out);
            var ai: i32 = 0;
            while (ai < c.args.len()) { out = e060_e062_expr(c.args[ai], dyns, mod, out); ai = ai + 1; }
            return out;
        },
        parser.ExprBinary(b) => {
            out = e060_e062_expr(b.left, dyns, mod, out);
            return e060_e062_expr(b.right, dyns, mod, out);
        },
        parser.ExprIndex(ix) => {
            out = e060_e062_expr(ix.array, dyns, mod, out);
            return e060_e062_expr(ix.index, dyns, mod, out);
        },
        parser.ExprFieldAccess(fa2) => { return e060_e062_expr(fa2.obj, dyns, mod, out); },
        parser.ExprArray(ar) => {
            var i: i32 = 0;
            while (i < ar.elements.len()) { out = e060_e062_expr(ar.elements[i], dyns, mod, out); i = i + 1; }
            return out;
        },
        parser.ExprTuple(tu) => {
            var i: i32 = 0;
            while (i < tu.elements.len()) { out = e060_e062_expr(tu.elements[i], dyns, mod, out); i = i + 1; }
            return out;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) { out = e060_e062_expr(sl.field_values[i], dyns, mod, out); i = i + 1; }
            if (sl.has_base) { out = e060_e062_expr(sl.base, dyns, mod, out); }
            return out;
        },
        _ => { return out; }
    }
    return out;
}

function e060_e062_stmts(stmts: parser.Stmt[], dyns: string[], mod: parser.Module, acc: Diag[]): Diag[] {
    var out: Diag[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { out = e060_e062_expr(v.init, dyns, mod, out); },
            parser.StmtAssign(a) => { out = e060_e062_expr(a.value, dyns, mod, out); },
            parser.StmtReturn(r) => { out = e060_e062_expr(r.value, dyns, mod, out); },
            parser.StmtExpr(ex) => { out = e060_e062_expr(ex.value, dyns, mod, out); },
            parser.StmtIf(f) => {
                out = e060_e062_expr(f.cond, dyns, mod, out);
                out = e060_e062_stmts(f.then_body, dyns, mod, out);
                out = e060_e062_stmts(f.else_body, dyns, mod, out);
            },
            parser.StmtWhile(w) => {
                out = e060_e062_expr(w.cond, dyns, mod, out);
                out = e060_e062_stmts(w.body, dyns, mod, out);
            },
            parser.StmtFor(fo) => {
                out = e060_e062_expr(fo.iter, dyns, mod, out);
                out = e060_e062_stmts(fo.body, dyns, mod, out);
            },
            parser.StmtMatch(m) => {
                out = e060_e062_expr(m.scrutinee, dyns, mod, out);
                var mi: i32 = 0;
                while (mi < m.arms.len()) {
                    if (m.arms[mi].has_guard) { out = e060_e062_expr(m.arms[mi].guard, dyns, mod, out); }
                    out = e060_e062_stmts(m.arms[mi].body, dyns, mod, out);
                    mi = mi + 1;
                }
            },
            parser.StmtDefer(d) => { out = e060_e062_stmts([d.action], dyns, mod, out); },
            _ => {}
        }
        i = i + 1;
    }
    return out;
}

// e060_decl_is_plain_struct: `name` is a declared plain struct (a decl by that
// name with NO enum_owner — a variant decl records its owner, and must not be
// admitted as an `as?` target here; native reports variants differently).
function e060_decl_is_plain_struct(mod: parser.Module, name: string): boolean {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == name && mod.structs[i].enum_owner.len() == 0) { return true; }
        i = i + 1;
    }
    return false;
}

// e060_decl_is_enum: `name` is a declared enum (some decl records it as its
// enum_owner) — mirrors irlower.decl_is_enum.
function e060_decl_is_enum(mod: parser.Module, name: string): boolean {
    if (name.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].enum_owner == name) { return true; }
        i = i + 1;
    }
    return false;
}

// e060_e062_diags: per function, collect the dyn-annotated params/locals then
// walk the body for the two expression-level checks.
function e060_e062_diags(mod: parser.Module): Diag[] {
    var out: Diag[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var fn: parser.FuncDecl = mod.funcs[fi];
        var dyns: string[] = [];
        var pi: i32 = 0;
        while (pi < fn.params.len()) {
            dyns = dyns.append(fn.params[pi].name + "|" + e060_dyn_set_of(fn.params[pi].type_name));
            pi = pi + 1;
        }
        dyns = e060_collect_dyn_locals(fn.body, dyns);
        out = e060_e062_stmts(fn.body, dyns, mod, out);
        fi = fi + 1;
    }
    return out;
}

pub function check_module(mod: parser.Module): ModuleTypes {
    // Collect struct decls first; func sigs + union aliases
    // both use them to resolve names. Union aliases come next
    // so func sigs can reference union-typed params / returns.
    // Union NAMES are needed before the struct sigs so a struct field
    // typed as a union (or union array) resolves rather than going
    // unknown. The full UnionSig table (with variants) still comes after.
    var alias_names: string[] = [];
    var an: i32 = 0;
    while (an < mod.aliases.len()) { alias_names = alias_names.append(mod.aliases[an].name); an = an + 1; }
    var structs: StructSig[] = collect_struct_sigs(mod.structs, alias_names);
    var struct_names: string[] = [];
    var sn: i32 = 0;
    while (sn < structs.len()) { struct_names = struct_names.append(structs[sn].name); sn = sn + 1; }
    var unions: UnionSig[] = collect_union_sigs(mod.aliases, struct_names);
    // Register enum decls as union sigs (variants = variant names) so an
    // enum-typed scrutinee types to TypeUnion and the E030 exhaustiveness
    // check (plus union-variant assignability) covers enums the same way
    // it covers `type X = A | B` aliases. The self-host's own source uses
    // no enum decls, so this is inert on the bundle; it lights up
    // exhaustiveness for user / corpus enum matches.
    var een: i32 = 0;
    while (een < mod.enums.len()) {
        unions = unions.append(UnionSig { name: mod.enums[een].name, variants: mod.enums[een].variant_names });
        een = een + 1;
    }
    var well_typed: boolean = true;
    if (!validate_union_sigs(unions, struct_names)) { well_typed = false; }
    var sigs: FuncSig[] = collect_func_sigs(mod.funcs, structs, unions);
    var methods: MethodSig[] = collect_method_sigs(mod.funcs, structs, unions);
    var body_diags: Diag[] = [];
    var ambig: string[] = ambiguous_variants(mod.enums);
    // E067 runs only when the module declares a @must_consume type — the
    // fast path that keeps the obligation walk free for unmarked modules
    // (e.g. the self-host compiler's own sources).
    var mc_on: boolean = mc_any_marked(mod.structs, mod.enums);
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!check_func_body(mod.funcs[i], sigs, structs, unions, methods)) { well_typed = false; }
        var dbody: parser.Stmt[] = mod.funcs[i].body;
        // E002: return-type mismatch, per function (recursing into nested
        // blocks). Only meaningful when a return type is declared.
        if (mod.funcs[i].ret_type == "void") {
            // A `void` function returns nothing: it needs no `return` (so no
            // E052 — falling off the end is the normal exit) and must not
            // return a value (E002 on any `return <expr>;`). Matches the Go
            // checker, which treats void specially on both fronts.
            var vsc: Scope = build_func_scope(mod.funcs[i], sigs, structs, unions, methods);
            body_diags = append_diags(body_diags, void_ret_diags(dbody, vsc, unions));
        } else if (mod.funcs[i].ret_type.len() > 0) {
            var fsc: Scope = build_func_scope(mod.funcs[i], sigs, structs, unions, methods);
            body_diags = append_diags(body_diags, ret_diags(dbody, fsc, fsc.ret_type, unions));
            // E052: a non-void function whose body can fall off the end
            // without returning, reported at the function declaration.
            if (!block_exits(mod.funcs[i].body)) {
                body_diags = body_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + mod.funcs[i].ret_type + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
            }
        }
        // E063: returning a `[T]` slice that views function-local storage
        // (a use-after-free once the frame is reclaimed). Runs for every
        // function — a slice can escape from an inferred-return body too.
        body_diags = append_diags(body_diags, slice_escape_diags(dbody, build_func_scope(mod.funcs[i], sigs, structs, unions, methods)));
        // E067: a value of a @must_consume struct/enum type must be consumed
        // on every path before its binding leaves scope (the native
        // checkMustConsume — docs/MUST-CONSUME.md).
        if (mc_on) {
            body_diags = append_diags(body_diags, must_consume_diags(mod.funcs[i], build_func_scope(mod.funcs[i], sigs, structs, unions, methods), mod.structs, mod.enums));
        }
        // E002 (lambda bodies): return-type mismatch inside a lambda is
        // checked against the lambda's own declared return type, not the
        // enclosing function's. Runs for every function (even void ones —
        // a lambda can be declared anywhere), scope-threaded so a lambda
        // sees earlier locals.
        body_diags = append_diags(body_diags, lret_stmts(dbody, build_func_scope(mod.funcs[i], sigs, structs, unions, methods), unions));
        // E031: match/if-expression arms must have compatible types
        // (scope-threaded so an arm sees earlier locals + its payload).
        body_diags = append_diags(body_diags, mx_stmts(dbody, build_func_scope(mod.funcs[i], sigs, structs, unions, methods), unions, mod.enums));
        // E005: struct literal missing a declared field (any expression in
        // the body, struct table is module-global so no scope needed).
        body_diags = append_diags(body_diags, stmts_slit_diags(dbody, structs));
        // E004: free-function call arity (scope-threaded so a shadowing
        // local isn't mistaken for the function).
        body_diags = append_diags(body_diags, stmts_call_diags(dbody, build_func_scope(mod.funcs[i], sigs, structs, unions, methods).with_impls(mod.impls, mod.trait_reqs)));
        // E003: assignment / annotated-var type mismatch (scope-threaded).
        body_diags = append_diags(body_diags, stmts_assign_diags(dbody, build_func_scope(mod.funcs[i], sigs, structs, unions, methods), unions));
        // E011 / E058: break / continue outside a loop, and a labeled
        // break/continue whose label names no enclosing loop (structural).
        body_diags = append_diags(body_diags, loop_diags(dbody, false, []));
        // E013: duplicate `var` in the same block (structural, no scope).
        body_diags = append_diags(body_diags, dupvar_diags(dbody));
        // E026 / E028: structural match-arm errors (wildcard order, dup
        // variant).
        body_diags = append_diags(body_diags, match_diags(dbody, structs));
        // E019: explicit type-argument arity on a generic-struct reference
        // in a parameter type.
        var pai2: i32 = 0;
        while (pai2 < mod.funcs[i].params.len()) {
            body_diags = append_diags(body_diags, type_arity_diag(mod.funcs[i].params[pai2].type_name, mod.structs));
            pai2 = pai2 + 1;
        }
        // E036: unqualified reference to a variant shared by 2+ enums.
        if (ambig.len() > 0) {
            body_diags = append_diags(body_diags, vref_stmts(dbody, build_func_scope(mod.funcs[i], sigs, structs, unions, methods), ambig));
        }
        i = i + 1;
    }
    var s: Scope = new_scope_full(sigs, structs, unions, methods);
    var top_tys: Type[] = [];
    var j: i32 = 0;
    while (j < mod.top_stmts.len()) {
        var r: CheckResult = check_stmt(mod.top_stmts[j], s);
        s = r.scope;
        if (is_unknown(r.ty)) { well_typed = false; }
        top_tys = top_tys.append(r.ty);
        j = j + 1;
    }
    var dtop: parser.Stmt[] = mod.top_stmts;
    body_diags = append_diags(body_diags, lret_stmts(dtop, new_scope_full(sigs, structs, unions, methods), unions));
    body_diags = append_diags(body_diags, mx_stmts(dtop, new_scope_full(sigs, structs, unions, methods), unions, mod.enums));
    body_diags = append_diags(body_diags, stmts_slit_diags(dtop, structs));
    body_diags = append_diags(body_diags, stmts_call_diags(dtop, new_scope_full(sigs, structs, unions, methods)));
    body_diags = append_diags(body_diags, stmts_assign_diags(dtop, new_scope_full(sigs, structs, unions, methods), unions));
    if (ambig.len() > 0) {
        body_diags = append_diags(body_diags, vref_stmts(dtop, new_scope_full(sigs, structs, unions, methods), ambig));
    }
    body_diags = append_diags(body_diags, loop_diags(dtop, false, []));
    body_diags = append_diags(body_diags, dupvar_diags(dtop));
    body_diags = append_diags(body_diags, match_diags(dtop, structs));
    // E019: generic-struct type-argument arity in struct field types.
    var sfi: i32 = 0;
    while (sfi < mod.structs.len()) {
        var fj2: i32 = 0;
        while (fj2 < mod.structs[sfi].fields.len()) {
            body_diags = append_diags(body_diags, type_arity_diag(mod.structs[sfi].fields[fj2].type_name, mod.structs));
            fj2 = fj2 + 1;
        }
        sfi = sfi + 1;
    }
    // E064: a type annotation that names no declared type (the self-host
    // counterpart of the native checker's unknown-type rule). Scoped to bare
    // identifiers in NON-generic, NON-method functions and NON-generic,
    // NON-enum-variant structs — contexts with no type parameter in scope —
    // so a genuine typo (`var x: Wibble`) is reported while an erased generic
    // parameter is never mistaken for one. Resolves against the same struct +
    // union/enum name sets the rest of check_module uses.
    var union_names: string[] = [];
    var uni: i32 = 0;
    while (uni < unions.len()) { union_names = union_names.append(unions[uni].name); uni = uni + 1; }
    // Known-in-another-role names for the E064 generic-BASE check: declared
    // trait names (via requirement records and impl headers) and resource
    // names. The Go checker's knownTypeName accepts any declared struct /
    // enum / trait / resource, so the base check must not flag these.
    var e064_extra: string[] = [];
    var xtri: i32 = 0;
    while (xtri < mod.trait_reqs.len()) { e064_extra = e064_extra.append(mod.trait_reqs[xtri].trait_name); xtri = xtri + 1; }
    var ximi: i32 = 0;
    while (ximi < mod.impls.len()) { e064_extra = e064_extra.append(mod.impls[ximi].trait_name); ximi = ximi + 1; }
    var xrsi: i32 = 0;
    while (xrsi < mod.resources.len()) { e064_extra = e064_extra.append(mod.resources[xrsi].name); xrsi = xrsi + 1; }
    var efi: i32 = 0;
    while (efi < mod.funcs.len()) {
        var efn: parser.FuncDecl = mod.funcs[efi];
        // Skip generic functions: unbounded generics (`id[T]`) record their
        // parameters in type_param_count rather than type_params, so both must
        // be zero. Methods are skipped too — their receiver may bind type
        // parameters that aren't in scope for this resolver.
        if (efn.type_params.len() == 0 && efn.type_param_count == 0 && efn.receiver_name.len() == 0) {
            var epi: i32 = 0;
            while (epi < efn.params.len()) {
                var pu: string = e064_unknown_name(efn.params[epi].type_name, struct_names, union_names, e064_extra);
                if (pu.len() > 0) {
                    body_diags = body_diags.append(dg_at("E064", "unknown type \"" + pu + "\"", efn.line, efn.col));
                }
                // E057 annotation form: a `Cell[<composite>]` anywhere in a
                // parameter annotation (same conservative non-generic scope,
                // so a generic's `Cell[T]` is never flagged).
                body_diags = append_diags(body_diags, e057_annot_diags(efn.params[epi].type_name, efn.line, efn.col));
                epi = epi + 1;
            }
            var ru: string = e064_unknown_name(efn.ret_type, struct_names, union_names, e064_extra);
            if (ru.len() > 0) {
                body_diags = body_diags.append(dg_at("E064", "unknown type \"" + ru + "\"", efn.line, efn.col));
            }
            body_diags = append_diags(body_diags, e057_annot_diags(efn.ret_type, efn.line, efn.col));
            // Body `var x: T` annotations (same non-generic scope).
            body_diags = append_diags(body_diags, e064_var_diags(efn.body, struct_names, union_names, e064_extra));
            body_diags = append_diags(body_diags, e057_var_diags(efn.body));
        }
        efi = efi + 1;
    }
    // E044: a closure capture of a value with no runtime representation —
    // a `void` call result or an erased generic type parameter. Runs for
    // EVERY function (generic ones are where the ParamType shape lives).
    var e044_void_fns: string[] = [];
    var vfj: i32 = 0;
    while (vfj < mod.funcs.len()) {
        if (mod.funcs[vfj].receiver_name.len() == 0 && mod.funcs[vfj].ret_type == "void") {
            e044_void_fns = e044_void_fns.append(mod.funcs[vfj].name);
        }
        vfj = vfj + 1;
    }
    var e44i: i32 = 0;
    while (e44i < mod.funcs.len()) {
        body_diags = append_diags(body_diags, e044_diags(mod.funcs[e44i], struct_names, union_names, e044_void_fns));
        e44i = e44i + 1;
    }
    // E053 (`fip` no-allocation verification), E065 (`str` view escaping a
    // function-local string), and E032 (`use` binding-type inference).
    var fip_names: string[] = [];
    var str_ret_names: string[] = [];
    var fni: i32 = 0;
    while (fni < mod.funcs.len()) {
        if (mod.funcs[fni].fip) { fip_names = fip_names.append(mod.funcs[fni].name); }
        if (mod.funcs[fni].ret_str) { str_ret_names = str_ret_names.append(mod.funcs[fni].name); }
        fni = fni + 1;
    }
    var e032_lastfn: string[] = [];
    var lfi: i32 = 0;
    while (lfi < mod.funcs.len()) {
        var lfd: parser.FuncDecl = mod.funcs[lfi];
        if (lfd.params.len() > 0 && lfd.params[lfd.params.len() - 1].type_name == "fn") {
            e032_lastfn = e032_lastfn.append(lfd.name);
        }
        lfi = lfi + 1;
    }
    var e053_variants: string[] = [];
    var uvi: i32 = 0;
    while (uvi < unions.len()) {
        var vvj: i32 = 0;
        while (vvj < unions[uvi].variants.len()) { e053_variants = e053_variants.append(unions[uvi].variants[vvj]); vvj = vvj + 1; }
        uvi = uvi + 1;
    }
    var exi: i32 = 0;
    while (exi < mod.funcs.len()) {
        var xfn: parser.FuncDecl = mod.funcs[exi];
        if (xfn.fip) {
            body_diags = append_diags(body_diags, e053_diags(xfn, fip_names, e053_variants, build_func_scope(xfn, sigs, structs, unions, methods)));
        }
        if (xfn.ret_str) {
            body_diags = append_diags(body_diags, e065_diags(xfn, str_ret_names, build_func_scope(xfn, sigs, structs, unions, methods)));
        }
        body_diags = append_diags(body_diags, e032_stmts(xfn.body, e032_lastfn, build_func_scope(xfn, sigs, structs, unions, methods)));
        exi = exi + 1;
    }
    var esi: i32 = 0;
    while (esi < mod.structs.len()) {
        var esd: parser.StructDecl = mod.structs[esi];
        if (esd.type_params.len() == 0 && esd.enum_owner.len() == 0) {
            var efj: i32 = 0;
            while (efj < esd.fields.len()) {
                var fu: string = e064_unknown_name(esd.fields[efj].type_name, struct_names, union_names, e064_extra);
                if (fu.len() > 0) {
                    body_diags = body_diags.append(dg_at("E064", "unknown type \"" + fu + "\"", esd.line, esd.col));
                }
                // E057 annotation form for a struct FIELD (`c: Cell[P]`),
                // same non-generic, non-enum-variant scope as E064.
                body_diags = append_diags(body_diags, e057_annot_diags(esd.fields[efj].type_name, esd.line, esd.col));
                efj = efj + 1;
            }
        }
        esi = esi + 1;
    }
    // own_diags (E050/E051) and e049_diags (E049) walk whole-function bodies
    // for move / capture analysis.
    var dd: Diag[] = append_diags(append_diags(append_diags(append_diags(append_diags(append_diags(append_diags(collect_decl_diags(mod), body_diags), own_diags(mod)), e049_diags(mod)), e021_diags(mod)), e021_derive_field_diags(mod)), e021_object_safety_diags(mod)), e060_e062_diags(mod));
    if (dd.len() > 0) { well_typed = false; }
    return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: well_typed, diags: dd };
}

// ill_typed_hint returns a best-effort fallback diagnostic for a module that
// check_module marked ill-typed but produced NO coded diagnostic for — an
// expression collapsed to TypeUnknown because the partial `Type` union can't
// yet model an enum value, Option/Result, generic, or `dyn` type (#4346). The
// `-check` driver calls this ONLY when `all_well_typed` is false and `diags`
// is empty, so a rejection is never silent. Two deliberate properties keep it
// safe: (1) it is a driver-only helper — check_module, checker_run, and the
// differential codes gate (which drives check_module / checker_codes_run and
// keys on E0NN codes) never invoke it, so parity is untouched; (2) the code is
// the lowercase tag "type", never an E0NN, so even if some future path did run
// it through a code scraper the tag would not be mistaken for a native code.
// Rebuilds the same name environment check_module builds (kept in sync with
// its head), then reports the first function whose body has an un-inferable
// expression (at its declaration), else the first offending top-level
// statement, else a module-level note.
pub function ill_typed_hint(mod: parser.Module): Diag[] {
    var alias_names: string[] = [];
    var an: i32 = 0;
    while (an < mod.aliases.len()) { alias_names = alias_names.append(mod.aliases[an].name); an = an + 1; }
    var structs: StructSig[] = collect_struct_sigs(mod.structs, alias_names);
    var struct_names: string[] = [];
    var sn: i32 = 0;
    while (sn < structs.len()) { struct_names = struct_names.append(structs[sn].name); sn = sn + 1; }
    var unions: UnionSig[] = collect_union_sigs(mod.aliases, struct_names);
    var een: i32 = 0;
    while (een < mod.enums.len()) {
        unions = unions.append(UnionSig { name: mod.enums[een].name, variants: mod.enums[een].variant_names });
        een = een + 1;
    }
    var sigs: FuncSig[] = collect_func_sigs(mod.funcs, structs, unions);
    var methods: MethodSig[] = collect_method_sigs(mod.funcs, structs, unions);
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!check_func_body(mod.funcs[i], sigs, structs, unions, methods)) {
            return [dg_at("type", "\"" + mod.funcs[i].name + "\": an expression has a type the self-host checker cannot represent yet (enum value, Option/Result, generic, or dyn); it type-checks under the native `fern` — see issue #4346", mod.funcs[i].line, mod.funcs[i].col)];
        }
        i = i + 1;
    }
    var s: Scope = new_scope_full(sigs, structs, unions, methods);
    var j: i32 = 0;
    while (j < mod.top_stmts.len()) {
        var r: CheckResult = check_stmt(mod.top_stmts[j], s);
        s = r.scope;
        if (is_unknown(r.ty)) {
            return [dg_at("type", "a top-level expression has a type the self-host checker cannot represent yet (enum value, Option/Result, generic, or dyn); it type-checks under the native `fern` — see issue #4346", 0, 0)];
        }
        j = j + 1;
    }
    return [dg_at("type", "type checking failed but no specific diagnostic is available (self-host checker limitation, #4346)", 0, 0)];
}

// =================== VALIDATION ====================

function main(): i32 {
    // Well-typed program:
    //   var a = 1 + 2 * 3;            // a: i32 = 7
    //   var b = "hi" + " there";      // b: string
    //   var c = a < 10;               // c: bool
    //   var d = !c;                   // d: bool
    //   return a + 1;                 // i32
    var src1: string = "var a = 1 + 2 * 3; var b = \"hi\" + \" there\"; var c = a < 10; var d = !c; return a + 1;";
    var toks1: lexer.Token[] = lexer.tokenize(src1);
    var stmts1: parser.Stmt[] = parser.parse_program(toks1);
    var pt1: ProgramTypes = check_program(stmts1);
    if (pt1.tys.len() != 5) { return 1; }
    if (!type_eq(pt1.tys[0], t_i32())) { return 10; }
    if (!type_eq(pt1.tys[1], t_string())) { return 11; }
    if (!type_eq(pt1.tys[2], t_bool())) { return 12; }
    if (!type_eq(pt1.tys[3], t_bool())) { return 13; }
    if (!type_eq(pt1.tys[4], t_i32())) { return 14; }

    // Ill-typed program: mixing types in arithmetic.
    //   var x = 1 + "no";            // Unknown — `+` mismatch
    var src2: string = "var x = 1 + \"no\";";
    var toks2: lexer.Token[] = lexer.tokenize(src2);
    var stmts2: parser.Stmt[] = parser.parse_program(toks2);
    var pt2: ProgramTypes = check_program(stmts2);
    if (pt2.tys.len() != 1) { return 20; }
    if (!is_unknown(pt2.tys[0])) { return 21; }

    // Ident lookup: forward reference fails, backward reference resolves.
    //   var p = q;                   // q undefined → Unknown
    //   var q = 5;                   // i32
    //   var r = q;                   // i32 (q now in scope)
    var src3: string = "var p = q; var q = 5; var r = q;";
    var toks3: lexer.Token[] = lexer.tokenize(src3);
    var stmts3: parser.Stmt[] = parser.parse_program(toks3);
    var pt3: ProgramTypes = check_program(stmts3);
    if (pt3.tys.len() != 3) { return 30; }
    if (!is_unknown(pt3.tys[0])) { return 31; }
    if (!type_eq(pt3.tys[1], t_i32())) { return 32; }
    if (!type_eq(pt3.tys[2], t_i32())) { return 33; }

    // Logical / comparison ops with bool operands.
    //   var f = true && false;       // bool
    //   var g = (1 < 2) || f;        // bool
    var src4: string = "var f = true && false; var g = (1 < 2) || f;";
    var toks4: lexer.Token[] = lexer.tokenize(src4);
    var stmts4: parser.Stmt[] = parser.parse_program(toks4);
    var pt4: ProgramTypes = check_program(stmts4);
    if (pt4.tys.len() != 2) { return 40; }
    if (!type_eq(pt4.tys[0], t_bool())) { return 41; }
    if (!type_eq(pt4.tys[1], t_bool())) { return 42; }

    // Module-level: well-typed function decls + a call.
    var src5: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
    var mod5: parser.Module = parser.parse_module(lexer.tokenize(src5));
    var mt5: ModuleTypes = check_module(mod5);
    if (!mt5.all_well_typed) { return 50; }
    if (mt5.sigs.len() != 2) { return 51; }
    if (mt5.sigs[0].name != "add") { return 52; }
    if (mt5.sigs[0].param_types.len() != 2) { return 53; }
    if (!type_eq(mt5.sigs[0].param_types[0], t_i32())) { return 54; }
    if (!type_eq(mt5.sigs[0].ret_type, t_i32())) { return 55; }

    // Ill-typed call: arity mismatch.
    var src6: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }";
    var mod6: parser.Module = parser.parse_module(lexer.tokenize(src6));
    var mt6: ModuleTypes = check_module(mod6);
    if (mt6.all_well_typed) { return 60; }

    // Ill-typed call: wrong arg type (string into i32 param).
    var src7: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1, \"x\"); }";
    var mod7: parser.Module = parser.parse_module(lexer.tokenize(src7));
    var mt7: ModuleTypes = check_module(mod7);
    if (mt7.all_well_typed) { return 70; }

    // Recursive call (factorial) is well-typed.
    var src8: string = "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }";
    var mod8: parser.Module = parser.parse_module(lexer.tokenize(src8));
    var mt8: ModuleTypes = check_module(mod8);
    if (!mt8.all_well_typed) { return 80; }

    // Array literal: `var a = [1, 2, 3]; return a[0];` → i32.
    var src9: string = "var a = [1, 2, 3]; return a[0];";
    var stmts9: parser.Stmt[] = parser.parse_program(lexer.tokenize(src9));
    var pt9: ProgramTypes = check_program(stmts9);
    if (pt9.tys.len() != 2) { return 90; }
    // First stmt's type is the array type.
    match (pt9.tys[0]) {
        TypeArray(ae) => {
            if (!type_eq(ae.elem, t_i32())) { return 91; }
        },
        _ => { return 92; }
    }
    // Second stmt (return a[0]) types as i32.
    if (!type_eq(pt9.tys[1], t_i32())) { return 93; }

    // len() builtin on array → i32.
    var src10: string = "var a = [\"x\", \"y\"]; return len(a);";
    var stmts10: parser.Stmt[] = parser.parse_program(lexer.tokenize(src10));
    var pt10: ProgramTypes = check_program(stmts10);
    if (!type_eq(pt10.tys[1], t_i32())) { return 100; }

    // Mixed-type array literal → TypeUnknown.
    var src11: string = "var a = [1, \"oops\"]; return a[0];";
    var stmts11: parser.Stmt[] = parser.parse_program(lexer.tokenize(src11));
    var pt11: ProgramTypes = check_program(stmts11);
    if (!is_unknown(pt11.tys[0])) { return 110; }

    // String indexing: `s[0]` types as i32 (the byte).
    var src12: string = "var s = \"hi\"; return s[0];";
    var stmts12: parser.Stmt[] = parser.parse_program(lexer.tokenize(src12));
    var pt12: ProgramTypes = check_program(stmts12);
    if (!type_eq(pt12.tys[1], t_i32())) { return 120; }

    // String slicing preserves type: `s[1:4]` is still TypeString.
    var src13: string = "var s = \"hello\"; var t = s[1:4]; return 0;";
    var stmts13: parser.Stmt[] = parser.parse_program(lexer.tokenize(src13));
    var pt13: ProgramTypes = check_program(stmts13);
    if (!type_eq(pt13.tys[1], t_string())) { return 130; }

    // Struct lit + field access well-typed.
    var src14: string = "struct Point { x: i32, y: i32 } function main(): i32 { var p = Point { x: 3, y: 4 }; return p.x + p.y; }";
    var mod14: parser.Module = parser.parse_module(lexer.tokenize(src14));
    var mt14: ModuleTypes = check_module(mod14);
    if (!mt14.all_well_typed) { return 140; }

    // Wrong field type: y wants i32 but a string is passed.
    var src15: string = "struct Point { x: i32, y: i32 } function main(): i32 { var p = Point { x: 3, y: \"oops\" }; return 0; }";
    var mod15: parser.Module = parser.parse_module(lexer.tokenize(src15));
    var mt15: ModuleTypes = check_module(mod15);
    if (mt15.all_well_typed) { return 150; }

    // Missing field on access: Point has no `z`.
    var src16: string = "struct Point { x: i32, y: i32 } function main(): i32 { var p = Point { x: 3, y: 4 }; return p.z; }";
    var mod16: parser.Module = parser.parse_module(lexer.tokenize(src16));
    var mt16: ModuleTypes = check_module(mod16);
    if (mt16.all_well_typed) { return 160; }

    // Field count mismatch: literal supplies only one field.
    var src17: string = "struct Point { x: i32, y: i32 } function main(): i32 { var p = Point { x: 3 }; return 0; }";
    var mod17: parser.Module = parser.parse_module(lexer.tokenize(src17));
    var mt17: ModuleTypes = check_module(mod17);
    if (mt17.all_well_typed) { return 170; }

    // Nested struct field type.
    var src18: string = "struct Inner { v: i32 } struct Outer { i: Inner } function main(): i32 { var o = Outer { i: Inner { v: 5 } }; return o.i.v; }";
    var mod18: parser.Module = parser.parse_module(lexer.tokenize(src18));
    var mt18: ModuleTypes = check_module(mod18);
    if (!mt18.all_well_typed) { return 180; }

    // Well-typed union alias: both variants resolve to declared
    // structs. Function takes a `Shape` param and the body
    // returns 0 — alias is referenced through the signature.
    var src19: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function area(_s: Shape): i32 { return 0; } function main(): i32 { return area(Circle { r: 3 }); }";
    var mod19: parser.Module = parser.parse_module(lexer.tokenize(src19));
    var mt19: ModuleTypes = check_module(mod19);
    if (!mt19.all_well_typed) { return 190; }

    // Variant→union subtyping: passing a Square into a Shape
    // slot is fine because Square is in Shape's variant list.
    var src20: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function area(_s: Shape): i32 { return 0; } function main(): i32 { return area(Square { s: 4 }); }";
    var mod20: parser.Module = parser.parse_module(lexer.tokenize(src20));
    var mt20: ModuleTypes = check_module(mod20);
    if (!mt20.all_well_typed) { return 200; }

    // Non-variant struct in a union slot is rejected. Triangle
    // is declared but not a variant of Shape.
    var src21: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } pub type Shape = Circle | Square; function area(_s: Shape): i32 { return 0; } function main(): i32 { return area(Triangle { b: 5 }); }";
    var mod21: parser.Module = parser.parse_module(lexer.tokenize(src21));
    var mt21: ModuleTypes = check_module(mod21);
    if (mt21.all_well_typed) { return 210; }

    // Alias variant resolution: unknown variant name is
    // rejected at module-build time. NotAStruct never gets
    // declared, so validate_union_sigs reports failure.
    var src22: string = "struct Circle { r: i32 } pub type Bad = Circle | NotAStruct; function main(): i32 { return 0; }";
    var mod22: parser.Module = parser.parse_module(lexer.tokenize(src22));
    var mt22: ModuleTypes = check_module(mod22);
    if (mt22.all_well_typed) { return 220; }

    // Union same-type equality: equality through type_eq holds
    // when the union names match. Two `Shape`-typed slots are
    // compatible without further widening.
    var src23: string = "struct Circle { r: i32 } pub type Shape = Circle; function id(s: Shape): Shape { return s; } function main(): i32 { return 0; }";
    var mod23: parser.Module = parser.parse_module(lexer.tokenize(src23));
    var mt23: ModuleTypes = check_module(mod23);
    if (!mt23.all_well_typed) { return 230; }

    // Match scrutinee + variant patterns over a union — variant
    // arms reference real members of Shape and the binding is
    // typed as the variant's TypeStruct. Function-parameter
    // type annotations are honoured by the parser; local `var`
    // annotations are still dropped, so route the union through
    // a parameter.
    var src24: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function dispatch(sh: Shape): i32 { match (sh) { Circle(c) => { return c.r; }, Square(sq) => { return sq.s; } } return 0; } function main(): i32 { return dispatch(Circle { r: 3 }); }";
    var mod24: parser.Module = parser.parse_module(lexer.tokenize(src24));
    var mt24: ModuleTypes = check_module(mod24);
    if (!mt24.all_well_typed) { return 240; }

    // Match over a union with a wildcard catch-all is well-typed.
    var src25: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function go(sh: Shape): i32 { match (sh) { Circle(_) => { return 1; }, _ => { return 0; } } return 0; } function main(): i32 { return go(Circle { r: 1 }); }";
    var mod25: parser.Module = parser.parse_module(lexer.tokenize(src25));
    var mt25: ModuleTypes = check_module(mod25);
    if (!mt25.all_well_typed) { return 250; }

    // Match over a union with a non-member variant arm is
    // rejected. Triangle is a known struct but not a variant
    // of Shape — flag it.
    var src26: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } pub type Shape = Circle | Square; function go(sh: Shape): i32 { match (sh) { Triangle(_) => { return 1; }, _ => { return 0; } } return 0; } function main(): i32 { return go(Circle { r: 1 }); }";
    var mod26: parser.Module = parser.parse_module(lexer.tokenize(src26));
    var mt26: ModuleTypes = check_module(mod26);
    if (mt26.all_well_typed) { return 260; }

    // Match arm body type-checks under the pattern binding.
    // `c.r` is a known i32 field on Circle (accessed via the
    // binding `c`), so the arm body is well-typed.
    var src27: string = "struct Circle { r: i32 } pub type Shape = Circle; function go(sh: Shape): i32 { match (sh) { Circle(c) => { return c.r; } } return 0; } function main(): i32 { return go(Circle { r: 4 }); }";
    var mod27: parser.Module = parser.parse_module(lexer.tokenize(src27));
    var mt27: ModuleTypes = check_module(mod27);
    if (!mt27.all_well_typed) { return 270; }

    // Match against a struct (non-union) scrutinee: the only
    // valid PatVariant target is the struct's own name. Anything
    // else is a never-match and gets flagged.
    var src28: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { var c = Circle { r: 1 }; match (c) { Square(_) => { return 1; } } return 0; }";
    var mod28: parser.Module = parser.parse_module(lexer.tokenize(src28));
    var mt28: ModuleTypes = check_module(mod28);
    if (mt28.all_well_typed) { return 280; }

    // Pattern binding lifetime: the binding is in scope inside
    // the arm body only. Referencing it outside the match is
    // an undefined identifier — fold the StmtAssign approach by
    // using c.r inside the arm and a separate var outside.
    var src29: string = "struct Circle { r: i32 } function main(): i32 { var c = Circle { r: 1 }; match (c) { Circle(x) => { return x.r; } } return 0; }";
    var mod29: parser.Module = parser.parse_module(lexer.tokenize(src29));
    var mt29: ModuleTypes = check_module(mod29);
    if (!mt29.all_well_typed) { return 290; }

    // Var type annotation honoured: `var sh: Shape = Circle{…}`
    // binds `sh` as Shape, so a match over `sh` accepts both
    // Circle and Square arms. Previously the parser dropped the
    // annotation and `sh` inferred to TypeStruct("Circle"),
    // making the Square arm a never-match.
    var src30: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function main(): i32 { var sh: Shape = Circle { r: 3 }; match (sh) { Circle(c) => { return c.r; }, Square(sq) => { return sq.s; } } return 0; }";
    var mod30: parser.Module = parser.parse_module(lexer.tokenize(src30));
    var mt30: ModuleTypes = check_module(mod30);
    if (!mt30.all_well_typed) { return 300; }

    // Var annotation type-mismatch: `var n: i32 = "hi"` is
    // rejected — the init type isn't assignable to the
    // declared type.
    var src31: string = "function main(): i32 { var n: i32 = \"hi\"; return 0; }";
    var mod31: parser.Module = parser.parse_module(lexer.tokenize(src31));
    var mt31: ModuleTypes = check_module(mod31);
    if (mt31.all_well_typed) { return 310; }

    // Var annotation with primitive type: well-typed.
    var src32: string = "function main(): i32 { var n: i32 = 7; var b: bool = true; var s: string = \"x\"; return n; }";
    var mod32: parser.Module = parser.parse_module(lexer.tokenize(src32));
    var mt32: ModuleTypes = check_module(mod32);
    if (!mt32.all_well_typed) { return 320; }

    // Var annotation unknown type: rejected. `var w: NotAType`
    // resolves the annotation to TypeUnknown so well-typed
    // flips false.
    var src33: string = "function main(): i32 { var w: NotAType = 1; return 0; }";
    var mod33: parser.Module = parser.parse_module(lexer.tokenize(src33));
    var mt33: ModuleTypes = check_module(mod33);
    if (mt33.all_well_typed) { return 330; }

    // Receiver method call: `c.area()` type-checks via the
    // method-sig table when the receiver is a TypeStruct
    // matching the method's declared receiver_type.
    var src34: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function main(): i32 { var k: Circle = Circle { r: 5 }; return k.area(); }";
    var mod34: parser.Module = parser.parse_module(lexer.tokenize(src34));
    var mt34: ModuleTypes = check_module(mod34);
    if (!mt34.all_well_typed) { return 340; }

    // Method with an arg — arg type-checks against the
    // method's param_types.
    var src35: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { var x: Box = Box { v: 4 }; return x.scale(3); }";
    var mod35: parser.Module = parser.parse_module(lexer.tokenize(src35));
    var mt35: ModuleTypes = check_module(mod35);
    if (!mt35.all_well_typed) { return 350; }

    // Method-args type mismatch: passing a string where i32
    // is expected is rejected.
    var src36: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { var x: Box = Box { v: 4 }; return x.scale(\"oops\"); }";
    var mod36: parser.Module = parser.parse_module(lexer.tokenize(src36));
    var mt36: ModuleTypes = check_module(mod36);
    if (mt36.all_well_typed) { return 360; }

    // Method on wrong receiver type — no Square.area method.
    var src37: string = "struct Circle { r: i32 } struct Square { s: i32 } function (c: Circle) area(): i32 { return c.r; } function main(): i32 { var sq: Square = Square { s: 7 }; return sq.area(); }";
    var mod37: parser.Module = parser.parse_module(lexer.tokenize(src37));
    var mt37: ModuleTypes = check_module(mod37);
    if (mt37.all_well_typed) { return 370; }

    // Plain function name + method name don't collide. Both
    // calls type-check independently — the plain `area()` and
    // the method `k.area()` resolve to different sigs.
    var src38: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function area(): i32 { return 100; } function main(): i32 { var k: Circle = Circle { r: 5 }; var m: i32 = area(); var n: i32 = k.area(); return m + n; }";
    var mod38: parser.Module = parser.parse_module(lexer.tokenize(src38));
    var mt38: ModuleTypes = check_module(mod38);
    if (!mt38.all_well_typed) { return 380; }

    // Float literal + arithmetic — well-typed. var f: f64
    // catches the annotation; 1.5 + 2.5 type-checks via the
    // new f64 arm.
    var src39: string = "function main(): i32 { var f: f64 = 1.5 + 2.5; var g: f64 = f * 2.0; return 0; }";
    var mod39: parser.Module = parser.parse_module(lexer.tokenize(src39));
    var mt39: ModuleTypes = check_module(mod39);
    if (!mt39.all_well_typed) { return 390; }

    // Mixed-numeric `+` rejected: `1 + 2.5` doesn't unify.
    var src40: string = "function main(): i32 { var f: f64 = 1 + 2.5; return 0; }";
    var mod40: parser.Module = parser.parse_module(lexer.tokenize(src40));
    var mt40: ModuleTypes = check_module(mod40);
    if (mt40.all_well_typed) { return 400; }

    // Float comparison — well-typed, returns bool.
    var src41: string = "function main(): i32 { var b: bool = 3.14 > 3.0; return 0; }";
    var mod41: parser.Module = parser.parse_module(lexer.tokenize(src41));
    var mt41: ModuleTypes = check_module(mod41);
    if (!mt41.all_well_typed) { return 410; }

    // `%` on floats rejected.
    var src42: string = "function main(): i32 { var f: f64 = 5.5 % 2.0; return 0; }";
    var mod42: parser.Module = parser.parse_module(lexer.tokenize(src42));
    var mt42: ModuleTypes = check_module(mod42);
    if (mt42.all_well_typed) { return 420; }

    // For-in: iter is a TypeArray; body type-checks under a
    // scope where the loop var has the array's elem type.
    var src43: string = "function main(): i32 { var arr = [1, 2, 3]; var s: i32 = 0; for n in arr { s = s + n; } return s; }";
    var mod43: parser.Module = parser.parse_module(lexer.tokenize(src43));
    var mt43: ModuleTypes = check_module(mod43);
    if (!mt43.all_well_typed) { return 430; }

    // For-in iter not an array — rejected.
    var src44: string = "function main(): i32 { for n in 7 { } return 0; }";
    var mod44: parser.Module = parser.parse_module(lexer.tokenize(src44));
    var mt44: ModuleTypes = check_module(mod44);
    if (mt44.all_well_typed) { return 440; }

    // Tuple literal — type-checks as TypeTuple, field access
    // via `.0` reads the elem type at that index.
    var src45: string = "function main(): i32 { var t = (1, 2, 3); return t.0; }";
    var mod45: parser.Module = parser.parse_module(lexer.tokenize(src45));
    var mt45: ModuleTypes = check_module(mod45);
    if (!mt45.all_well_typed) { return 450; }

    // Heterogeneous tuple — `.0` returns i32, `.1` returns
    // string. Both arms of the tuple type-check.
    var src46: string = "function main(): i32 { var t = (42, \"hi\"); var s: string = t.1; return t.0; }";
    var mod46: parser.Module = parser.parse_module(lexer.tokenize(src46));
    var mt46: ModuleTypes = check_module(mod46);
    if (!mt46.all_well_typed) { return 460; }

    // Tuple field type-mismatch: `var s: string = t.0` where
    // t.0 is i32 — rejected.
    var src47: string = "function main(): i32 { var t = (42, 100); var s: string = t.0; return 0; }";
    var mod47: parser.Module = parser.parse_module(lexer.tokenize(src47));
    var mt47: ModuleTypes = check_module(mod47);
    if (mt47.all_well_typed) { return 470; }

    // Tuple index out of range — rejected.
    var src48: string = "function main(): i32 { var t = (1, 2); return t.5; }";
    var mod48: parser.Module = parser.parse_module(lexer.tokenize(src48));
    var mt48: ModuleTypes = check_module(mod48);
    if (mt48.all_well_typed) { return 480; }

    // break inside a while is well-typed.
    var src49: string = "function main(): i32 { var i: i32 = 0; while (i < 10) { if (i == 3) { break; } i = i + 1; } return i; }";
    var mod49: parser.Module = parser.parse_module(lexer.tokenize(src49));
    var mt49: ModuleTypes = check_module(mod49);
    if (!mt49.all_well_typed) { return 490; }

    // continue inside a for is well-typed.
    var src50: string = "function main(): i32 { var s: i32 = 0; for n in [1, 2, 3] { if (n == 2) { continue; } s = s + n; } return s; }";
    var mod50: parser.Module = parser.parse_module(lexer.tokenize(src50));
    var mt50: ModuleTypes = check_module(mod50);
    if (!mt50.all_well_typed) { return 500; }

    // break outside any loop — rejected.
    var src51: string = "function main(): i32 { break; return 0; }";
    var mod51: parser.Module = parser.parse_module(lexer.tokenize(src51));
    var mt51: ModuleTypes = check_module(mod51);
    if (mt51.all_well_typed) { return 510; }

    // continue outside any loop — rejected.
    var src52: string = "function main(): i32 { continue; return 0; }";
    var mod52: parser.Module = parser.parse_module(lexer.tokenize(src52));
    var mt52: ModuleTypes = check_module(mod52);
    if (mt52.all_well_typed) { return 520; }

    // Method on a primitive receiver — well-typed.
    var src53: string = "function (s: string) doubled(): string { return s + s; } function main(): i32 { var v: string = \"ab\"; var w: string = v.doubled(); return 0; }";
    var mod53: parser.Module = parser.parse_module(lexer.tokenize(src53));
    var mt53: ModuleTypes = check_module(mod53);
    if (!mt53.all_well_typed) { return 530; }

    // Method on i32 receiver — well-typed.
    var src54: string = "function (n: i32) twice(): i32 { return n * 2; } function main(): i32 { var x: i32 = 21; return x.twice(); }";
    var mod54: parser.Module = parser.parse_module(lexer.tokenize(src54));
    var mt54: ModuleTypes = check_module(mod54);
    if (!mt54.all_well_typed) { return 540; }

    // Method on wrong primitive receiver — rejected. The
    // method is declared on `string`; calling on i32 fails.
    var src55: string = "function (s: string) doubled(): string { return s + s; } function main(): i32 { var x: i32 = 5; var y: string = x.doubled(); return 0; }";
    var mod55: parser.Module = parser.parse_module(lexer.tokenize(src55));
    var mt55: ModuleTypes = check_module(mod55);
    if (mt55.all_well_typed) { return 550; }

    // Union-receiver method: a method declared on a union
    // type-checks when called on any of its variant structs.
    var src56: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function (sh: Shape) tag(): i32 { return 1; } function main(): i32 { var c = Circle { r: 3 }; return c.tag(); }";
    var mod56: parser.Module = parser.parse_module(lexer.tokenize(src56));
    var mt56: ModuleTypes = check_module(mod56);
    if (!mt56.all_well_typed) { return 560; }

    // Lambda + invocation: `var f = function (x: i32): i32 { …
    // }; f(41)` type-checks; f's call dispatches via the
    // TypeFunc-binding path.
    var src57: string = "function main(): i32 { var f = function (x: i32): i32 { return x + 1; }; return f(41); }";
    var mod57: parser.Module = parser.parse_module(lexer.tokenize(src57));
    var mt57: ModuleTypes = check_module(mod57);
    if (!mt57.all_well_typed) { return 570; }

    // Lambda arg-type mismatch — `f("hi")` where f expects i32.
    var src58: string = "function main(): i32 { var f = function (x: i32): i32 { return x + 1; }; return f(\"hi\"); }";
    var mod58: parser.Module = parser.parse_module(lexer.tokenize(src58));
    var mt58: ModuleTypes = check_module(mod58);
    if (mt58.all_well_typed) { return 580; }

    // Generic Map[K, V] param annotation type-checks as a
    // TypeMap. The function body is type-unaware of map ops
    // (no method dispatch), so we just return 0.
    var src59: string = "function lookup(m: Map[string, i32], k: string): i32 { return 0; } function main(): i32 { return 0; }";
    var mod59: parser.Module = parser.parse_module(lexer.tokenize(src59));
    var mt59: ModuleTypes = check_module(mod59);
    if (!mt59.all_well_typed) { return 590; }

    // Map method dispatch — `.get_or(k, default)` on `Map[K, V]`
    // returns V. The body's `var s = m.get_or(...)` resolves
    // to i32 via TypeMap value.
    var src60: string = "function lookup(m: Map[string, i32], k: string): i32 { return m.get_or(k, 0 - 1); } function main(): i32 { return 0; }";
    var mod60: parser.Module = parser.parse_module(lexer.tokenize(src60));
    var mt60: ModuleTypes = check_module(mod60);
    if (!mt60.all_well_typed) { return 600; }

    // Map method `.has(k)` returns bool.
    var src61: string = "function check(m: Map[string, i32], k: string): bool { return m.has(k); } function main(): i32 { return 0; }";
    var mod61: parser.Module = parser.parse_module(lexer.tokenize(src61));
    var mt61: ModuleTypes = check_module(mod61);
    if (!mt61.all_well_typed) { return 610; }

    // Map method `.len()` returns i32.
    var src62: string = "function size(m: Map[string, i32]): i32 { return m.len(); } function main(): i32 { return 0; }";
    var mod62: parser.Module = parser.parse_module(lexer.tokenize(src62));
    var mt62: ModuleTypes = check_module(mod62);
    if (!mt62.all_well_typed) { return 620; }

    // Return-type matching: a `: i32` function returning a string
    // is rejected.
    var src63: string = "function f(): i32 { return \"hello\"; } function main(): i32 { return 0; }";
    var mod63: parser.Module = parser.parse_module(lexer.tokenize(src63));
    var mt63: ModuleTypes = check_module(mod63);
    if (mt63.all_well_typed) { return 630; }

    // Return-type matching: nested return inside if/while is also
    // checked. `: i32` with `return true;` in the then-arm is a
    // mismatch.
    var src64: string = "function f(x: i32): i32 { if (x < 0) { return true; } return x; } function main(): i32 { return 0; }";
    var mod64: parser.Module = parser.parse_module(lexer.tokenize(src64));
    var mt64: ModuleTypes = check_module(mod64);
    if (mt64.all_well_typed) { return 640; }

    // Return-type matching: variant→union widening is allowed.
    // A `: Shape` function returning a `Circle` is well-typed
    // when Shape = Circle | Square.
    var src65: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function f(): Shape { return Circle { r: 5 }; } function main(): i32 { return 0; }";
    var mod65: parser.Module = parser.parse_module(lexer.tokenize(src65));
    var mt65: ModuleTypes = check_module(mod65);
    if (!mt65.all_well_typed) { return 650; }

    // Return-type matching: returning a non-variant struct from
    // a union-typed function is rejected.
    var src66: string = "struct Circle { r: i32 } struct Triangle { b: i32 } pub type Shape = Circle; function f(): Shape { return Triangle { b: 3 }; } function main(): i32 { return 0; }";
    var mod66: parser.Module = parser.parse_module(lexer.tokenize(src66));
    var mt66: ModuleTypes = check_module(mod66);
    if (mt66.all_well_typed) { return 660; }

    // Return-type matching: methods are checked too. `(c: Circle)
    // area(): bool { return c.r; }` declares bool but returns i32.
    var src67: string = "struct Circle { r: i32 } function (c: Circle) area(): bool { return c.r; } function main(): i32 { return 0; }";
    var mod67: parser.Module = parser.parse_module(lexer.tokenize(src67));
    var mt67: ModuleTypes = check_module(mod67);
    if (mt67.all_well_typed) { return 670; }

    return 0;
}

// ---------------------------------------------------------------------------
// Typed-IR annotation pass (#5531, docs/TYPED-IR-REWRITE.md)
//
// The lowering (irlower.fern) re-derives the type of nearly every expression at
// codegen time with structural predicates, because parser.Expr nodes carry no
// resolved type. This pass closes that gap for CALL expressions: it walks the
// module with a threaded Scope (the same scope build_func_scope / check_stmt
// use), asks check_expr for each ExprCall's inferred result type, and stamps the
// result into ExprCall.ty in irlower's string tag vocabulary. Lowering then READS
// c.ty instead of re-deriving. An unresolved / non-scalar result stamps "" so
// lowering falls back to its structural walk — the pass never widens what lowers,
// only removes re-derivation. Drivers that do not run it (asm_ir_run, native
// cmd/fern) leave every ty "" and are unaffected.
//
// The pass is a faithful AST rebuild (parser.Expr is immutable): every node is
// reconstructed, changing only ExprCall.ty. Any dropped/altered field would show
// as a codegen divergence under the byte-identical self-compile fixpoint.

// type_to_irtag serialises a resolved Type to irlower's scalar/string tag
// vocabulary. Only the tags a lowering predicate reads are produced; every
// composite / unresolved type maps to "" (unannotated → structural fallback).
// Note: TypeFloat covers both f64 and f32 (the checker does not distinguish
// them), so the tag is "f64" — the value irlower's expr_is_f64 keys on; the
// strict f32/f64 split stays structural (expr_is_f32).
function type_to_irtag(t: Type): string {
    match (t) {
        TypeFloat(_) => { return "f64"; },
        TypeI32(x) => { return int_label(x); },
        TypeString(_) => { return "string"; },
        TypeBool(_) => { return "boolean"; },
        // A struct-valued call carries its nominal type NAME as the tag, so
        // irlower's expr_struct_type can read it instead of re-deriving via the
        // struct_ret_fns registry. A struct name never collides with a scalar tag
        // (f64/i32/... are reserved), and the scalar predicates that read c.ty
        // compare it to their own keyword, so a struct name reads false there —
        // matching the structural walk's false for a struct call.
        TypeStruct(st) => { return st.name; },
        // A map-valued call: the "Map[K, V]" tag irlower's expr_map_type_tag reads
        // (its own canonical spelling — see the "Map[" + ktag + ", " + vtag + "]"
        // constructor). Only when both K and V serialise to a scalar/string tag;
        // a composite key/value yields "" (unannotated → structural fallback).
        TypeMap(m) => {
            var kt: string = type_to_irtag(m.key);
            var vt: string = type_to_irtag(m.value);
            if (kt == "" || vt == "") { return ""; }
            return "Map[" + kt + ", " + vt + "]";
        },
        _ => { return ""; }
    }
    return "";
}

// ModuleTables is the four name-resolution tables the checker builds per module.
// build_module_tables mirrors the head of check_module (structs → union names →
// enums → func sigs → methods); it is duplicated rather than shared so the
// annotate pass cannot perturb check_module's byte-identity-critical body.
pub struct ModuleTables { structs: StructSig[], unions: UnionSig[], sigs: FuncSig[], methods: MethodSig[] }
function build_module_tables(mod: parser.Module): ModuleTables {
    var alias_names: string[] = [];
    var an: i32 = 0;
    while (an < mod.aliases.len()) { alias_names = alias_names.append(mod.aliases[an].name); an = an + 1; }
    var structs: StructSig[] = collect_struct_sigs(mod.structs, alias_names);
    var struct_names: string[] = [];
    var sn: i32 = 0;
    while (sn < structs.len()) { struct_names = struct_names.append(structs[sn].name); sn = sn + 1; }
    var unions: UnionSig[] = collect_union_sigs(mod.aliases, struct_names);
    var een: i32 = 0;
    while (een < mod.enums.len()) {
        unions = unions.append(UnionSig { name: mod.enums[een].name, variants: mod.enums[een].variant_names });
        een = een + 1;
    }
    var sigs: FuncSig[] = collect_func_sigs(mod.funcs, structs, unions);
    var methods: MethodSig[] = collect_method_sigs(mod.funcs, structs, unions);
    return ModuleTables { structs: structs, unions: unions, sigs: sigs, methods: methods };
}

// annotate_advance threads the block scope from one statement to the next,
// reproducing exactly the scope check_stmt returns: only a StmtVar changes it
// (binding its name to the declared type, or the inferred init type when
// unannotated); every other statement's bindings are block-local and do not
// escape, so the scope passes through unchanged. This is the cheap half of
// check_stmt (no diagnostics), so annotation does not re-run the full checker.
function annotate_advance(st: parser.Stmt, s: Scope): Scope {
    match (st) {
        parser.StmtVar(v) => {
            if (v.type_name.len() > 0) {
                return s.bind(v.name, type_from_name_with_structs_unions(v.type_name, s.structs, s.unions));
            }
            return s.bind(v.name, check_expr(v.init, s));
        },
        parser.StmtDefer(d) => { return annotate_advance(d.action, s); },
        _ => { return s; }
    }
    return s;
}

// annotate_expr rebuilds `e`, stamping ExprCall.ty with the checker-inferred
// result tag. Recurses through every composite so a nested call is reached.
function annotate_expr(e: parser.Expr, s: Scope): parser.Expr {
    match (e) {
        parser.ExprBinary(b) => {
            return parser.ExprBinary { op: b.op, left: annotate_expr(b.left, s), right: annotate_expr(b.right, s), line: b.line, col: b.col };
        },
        parser.ExprUnary(u) => {
            return parser.ExprUnary { op: u.op, operand: annotate_expr(u.operand, s), line: u.line, col: u.col };
        },
        parser.ExprCall(c) => {
            var nargs: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { nargs = nargs.append(annotate_expr(c.args[i], s)); i = i + 1; }
            var tag: string = type_to_irtag(check_expr(e, s));
            return parser.ExprCall { callee: annotate_expr(c.callee, s), args: nargs, line: c.line, col: c.col, type_argc: c.type_argc, ty: tag };
        },
        parser.ExprFieldAccess(fa) => {
            return parser.ExprFieldAccess { obj: annotate_expr(fa.obj, s), field: fa.field, line: fa.line, col: fa.col };
        },
        parser.ExprIndex(x) => {
            return parser.ExprIndex { array: annotate_expr(x.array, s), index: annotate_expr(x.index, s), unchecked: x.unchecked };
        },
        parser.ExprSlice(sl) => {
            return parser.ExprSlice { array: annotate_expr(sl.array, s), start: annotate_expr(sl.start, s), end: annotate_expr(sl.end, s) };
        },
        parser.ExprArray(a) => {
            var na: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { na = na.append(annotate_expr(a.elements[i], s)); i = i + 1; }
            return parser.ExprArray { elements: na };
        },
        parser.ExprTuple(t) => {
            var nt: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { nt = nt.append(annotate_expr(t.elements[i], s)); i = i + 1; }
            return parser.ExprTuple { elements: nt, line: t.line, col: t.col };
        },
        parser.ExprStructLit(sli) => {
            var nfv: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < sli.field_values.len()) { nfv = nfv.append(annotate_expr(sli.field_values[i], s)); i = i + 1; }
            var nbase: parser.Expr = sli.base;
            if (sli.has_base) { nbase = annotate_expr(sli.base, s); }
            return parser.ExprStructLit { type_name: sli.type_name, field_names: sli.field_names, field_values: nfv, has_base: sli.has_base, base: nbase, line: sli.line, col: sli.col };
        },
        parser.ExprLambda(lm) => {
            var ls: Scope = s;
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                ls = ls.bind(lm.params[pi].name, type_from_name_with_structs_unions(lm.params[pi].type_name, s.structs, s.unions));
                pi = pi + 1;
            }
            return parser.ExprLambda { params: lm.params, ret_type: lm.ret_type, body: annotate_block(lm.body, ls), use_infer: lm.use_infer };
        },
        _ => { return e; }
    }
    return e;
}

// annotate_block rebuilds a statement list, threading scope statement-to-statement
// via annotate_advance. Nested control-flow bodies are rebuilt with the enclosing
// scope; a for-loop variable / match-arm payload binding is NOT re-introduced, so
// a call over one stays unannotated ("") and falls back to the structural walk —
// a later slice can thread those bindings to widen coverage.
function annotate_block(body: parser.Stmt[], s: Scope): parser.Stmt[] {
    var out: parser.Stmt[] = [];
    var cur: Scope = s;
    var i: i32 = 0;
    while (i < body.len()) {
        out = out.append(annotate_stmt(body[i], cur));
        cur = annotate_advance(body[i], cur);
        i = i + 1;
    }
    return out;
}

function annotate_stmt(st: parser.Stmt, s: Scope): parser.Stmt {
    match (st) {
        parser.StmtVar(v) => {
            return parser.StmtVar { name: v.name, type_name: v.type_name, init: annotate_expr(v.init, s), line: v.line, col: v.col, is_str: v.is_str };
        },
        parser.StmtReturn(r) => {
            return parser.StmtReturn { value: annotate_expr(r.value, s), line: r.line, col: r.col };
        },
        parser.StmtExpr(x) => {
            return parser.StmtExpr { value: annotate_expr(x.value, s) };
        },
        parser.StmtIf(f) => {
            return parser.StmtIf { cond: annotate_expr(f.cond, s), then_body: annotate_block(f.then_body, s), else_body: annotate_block(f.else_body, s) };
        },
        parser.StmtWhile(w) => {
            return parser.StmtWhile { cond: annotate_expr(w.cond, s), body: annotate_block(w.body, s), label: w.label };
        },
        parser.StmtAssign(a) => {
            return parser.StmtAssign { target: a.target, value: annotate_expr(a.value, s), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
        },
        parser.StmtMatch(m) => {
            var narms: parser.MatchArm[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[i];
                narms = narms.append(parser.MatchArm { pattern: arm.pattern, body: annotate_block(arm.body, s), line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard });
                i = i + 1;
            }
            return parser.StmtMatch { scrutinee: annotate_expr(m.scrutinee, s), arms: narms, line: m.line, col: m.col, origin: m.origin };
        },
        parser.StmtFor(fr) => {
            return parser.StmtFor { var_name: fr.var_name, iter: annotate_expr(fr.iter, s), body: annotate_block(fr.body, s), label: fr.label };
        },
        parser.StmtDefer(d) => {
            return parser.StmtDefer { action: annotate_stmt(d.action, s), on_error: d.on_error };
        },
        _ => { return st; }
    }
    return st;
}

function annotate_func(fd: parser.FuncDecl, mt: ModuleTables): parser.FuncDecl {
    var s: Scope = build_func_scope(fd, mt.sigs, mt.structs, mt.unions, mt.methods);
    return parser.FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: annotate_block(fd.body, s), line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count, bound_traits: fd.bound_traits, fip: fd.fip, ret_str: fd.ret_str };
}

// annotate_module stamps every function body's call expressions with their
// checker-inferred result type. Top-level statements are left unannotated for
// now (they lower rarely and via a distinct path); a later slice can extend.
pub function annotate_module(mod: parser.Module): parser.Module {
    var mt: ModuleTables = build_module_tables(mod);
    var nfuncs: parser.FuncDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        nfuncs = nfuncs.append(annotate_func(mod.funcs[i], mt));
        i = i + 1;
    }
    return parser.Module { funcs: nfuncs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}
