// The command line of the rg port: the options and their parse.
//
// The flags, their values and their messages are those of ripgrep 14.1.0.
import "core/cmp";
import "std/result";
import "std/string";
import "./colors";
import "./encoding";
import "./hyperlink";

// What rg does: write the selected lines, count them, name the files with
// or without a selected line, list the files to search, or list the types.
@derive(cmp.Eq)
pub enum Mode {
  Lines,
  Count,
  CountMatches,
  Files,
  Without,
  List,
  TypeList,
  Generate,
}

pub struct Options {
  patterns: string[],
  paths: string[],
  // The switches that are on, one bit for each entry of SWITCHES.
  on: i64,
  mode: Mode,
  // 0 is case sensitive, 1 is -i and 2 is -S.
  case: i32,
  // -1 is the default, 0 is -N and 1 is -n.
  line_number: i32,
  after: i32,
  before: i32,
  context: i32,
  color: string,
  with_filename: i32,
  heading: i32,
  // -1 is the default, 0 is --no-mmap and 1 is --mmap.
  mmap: i32,
  // 0 is the default, 1 is --binary and 2 is -a.
  binary: i32,
  threads: i32,
  max_count: i32,
  max_depth: i32,
  unrestricted: i32,
  // "" is no sort.
  sort: string,
  sort_reverse: boolean,
  path_separator: string,
  globs: string[],
  iglobs: string[],
  // Each change to the types in order: "+name", "-name", "add:def" or
  // "clear:name".
  types: string[],
  ignore_files: string[],
  // The largest file that the walk searches, in bytes, or -1.
  max_filesize: i64,
  // The line between groups of context, or None for no line.
  context_separator: Option[string],
  // The files of -f, and for each the count of -e patterns before it.
  pattern_files: string[],
  pattern_file_at: i32[],
  // The template of -r, or None.
  replace: Option[string],
  // The encoding of -E, as encoding.label gives it, or "" for the default.
  encoding: string,
  // -M, or 0 for no limit.
  max_columns: i32,
  // The line terminator: "\n", "\r\n" for --crlf, or NUL for --null-data.
  eol: string,
  colors: colors.Colors,
  hyperlink: hyperlink.Format,
  // The program that writes the host name, or "".
  hostname_bin: string,
  // The separators after the fields of a context line and a match line.
  field_context: string,
  field_match: string,
  // The command of --pre, or "", and the globs of the files it reads.
  pre: string,
  pre_globs: string[],
  // "default", "pcre2" or "auto".
  engine: string,
  // The limits of the DFA and of the compiled regex in bytes, or -1.
  dfa_size_limit: i64,
  regex_size_limit: i64,
  // 0 is the default, 1 is --line-buffered and 2 is --block-buffered.
  buffer: i32,
  // A mode that writes text before any other check: "help", "help-long",
  // "version", "version-long" or "pcre2-version", or "".
  special: string,
  // The kind of --generate for the mode Generate.
  generate: string,
}

struct Step { o: Options, next: i32 }

// The switches that are one bit of `Options.on`: the long name, the long
// name that turns the switch off ("" for none), and the short letter.
pub const INVERT: i32 = 0;

pub const WORD: i32 = 1;

pub const FIXED: i32 = 2;

pub const ONLY: i32 = 3;

pub const HIDDEN: i32 = 4;

pub const FOLLOW: i32 = 5;

pub const NO_IGNORE_DOT: i32 = 6;

pub const NO_IGNORE_VCS: i32 = 7;

pub const NO_IGNORE_PARENT: i32 = 8;

pub const NO_IGNORE_EXCLUDE: i32 = 9;

pub const NO_IGNORE_GLOBAL: i32 = 10;

pub const NO_IGNORE_FILES: i32 = 11;

pub const NO_REQUIRE_GIT: i32 = 12;

pub const NULL: i32 = 13;

pub const QUIET: i32 = 14;

pub const LINE: i32 = 15;

pub const GLOB_CASE: i32 = 16;

pub const IGNORE_FILE_CASE: i32 = 17;

pub const NO_MESSAGES: i32 = 18;

pub const NO_IGNORE_MESSAGES: i32 = 19;

pub const INCLUDE_ZERO: i32 = 20;

pub const COLUMN: i32 = 21;

pub const BYTE_OFFSET: i32 = 22;

pub const VIMGREP: i32 = 23;

pub const PASSTHRU: i32 = 24;

pub const PREVIEW: i32 = 25;

pub const TRIM: i32 = 26;

pub const STOP_ON_NONMATCH: i32 = 27;

pub const STATS: i32 = 28;

pub const JSON: i32 = 29;

pub const NO_UNICODE: i32 = 30;

pub const MULTILINE: i32 = 31;

pub const DOTALL: i32 = 32;

pub const ONE_FILE_SYSTEM: i32 = 33;

pub const SEARCH_ZIP: i32 = 34;

pub const NO_CONFIG: i32 = 35;

