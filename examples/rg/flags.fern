  "pcre2", "no-pcre2", "auto-hybrid-regex", "no-auto-hybrid-regex", "no-pcre2-unicode", "pcre2-unicode",
  "line-buffered", "no-line-buffered", "block-buffered", "no-block-buffered", "debug", "trace",
  "pcre2-version", "no-pre",
