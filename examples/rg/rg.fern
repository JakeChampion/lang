// rg — search files for a regular expression.
//
// A port of ripgrep (github.com/BurntSushi/ripgrep) with std/regex. It
// searches the files on the command line, or the standard input. In a
// directory, it searches each file that the ignore rules of ripgrep keep.
//
//   $ rg PATTERN                # the matching lines under the current directory
//   $ rg -n -C2 PATTERN FILE    # with line numbers and two lines of context
//   $ rg -c -e A -e B DIR       # the count of lines that match A or B
//   $ rg -t rust -g '!target' --files
//   $ cmd | rg -o PATTERN       # each match of the standard input
import "core/cmp";
import "std/encoding" as whatwg;
import "std/io";
import "std/process";
import "std/regex";
import "std/worker";
import "./decompress";
import "./encoding";
import "./flags";
import "./help";
import "./hyperlink";
import "./ignore";
import "./jsonl";
import "./search";
import "./walk";

const FLUSH_BYTES: i32 = 65536;

const NOTHING_SEARCHED: string = "No files were searched, which means ripgrep probably applied a filter you didn't expect.\nRunning with --debug will show why files are being skipped.";

// What a search of files needs: the printer, the pattern, how to name,
// read and decode each file, and which messages to write.
struct Ctx {
  p: search.Printer,
  pattern: string,
  implicit: boolean,
  mmap: boolean,
  binary: i32,
  threads: i32,
  quiet: boolean,
  messages: boolean,
  ignore_messages: boolean,
  encoding: string,
  decoder: whatwg.Decoder,
  // The command of --pre, or "", and the globs of --pre-glob.
  pre: string,
  pre_globs: ignore.Matcher,
  // -z: decompress the files with the extensions of compressed data.
  search_zip: boolean,
  // Write the output after each file: with --line-buffered, or by default
  // on a terminal.
  line_buffered: boolean,
}

// What the searches of some files counted for --stats: the files searched
// and the files with a match, the time of the searches, and for --json the
// counts of the files that it writes.
struct Totals { all: jsonl.Counts, json: jsonl.Counts, nanos: i64 }

// The result of a search of some files: the output, the error messages,
// whether a file matched, whether an error happened, whether a file was
// searched, and the totals.
struct Part { out: string, errors: string[], matched: boolean, failed: boolean, searched: boolean, totals: Totals }

// Writes the buffer when it is full, or when `all` is true.
function flush(h: usize, all: boolean): boolean {
  if (!all && buf_len(h) < FLUSH_BYTES) {
    return true;
  }
  if let Err(_) = stdout().write_bytes(buf_take_bytes(h)) {
    return false;
  }
  return true;
}

const MULTILINE_HINT: string = "Consider enabling multiline mode with the --multiline flag (or -U for short).\nWhen multiline mode is enabled, new line characters can be matched.";

// The bytes that a pattern cannot have as a literal without -U, as in
// ripgrep: the line terminator, and with --crlf the carriage return.
function banned(o: flags.Options): u8[] {
  if (o.has(flags.MULTILINE)) {
    return [];
  }
  if (o.eol == "\x00") {
    return [0u8];
  }
  return if (o.eol == "\r\n") { [10u8, 13u8] } else { [10u8] };
}

function byte_name(b: u8): string {
  if (b == 0u8) {
    return "\\0";
  }
  return if (b == 13u8) { "\\r" } else { "\\n" };
}

// The port behaves as ripgrep built without PCRE2.
const NO_PCRE2: string = "PCRE2 is not available in this build of ripgrep.";

// The message of an error of the default engine. With --engine auto,
// ripgrep then tries PCRE2, and names both errors.
function engine_error(o: flags.Options, text: string): string {
  if (o.engine != "auto") {
    return text;
  }
  let line = "~".repeat(79);
  return "regex could not be compiled with either the default regex engine or with PCRE2.\n\ndefault regex engine error:\n" + line + "\n" + text + "\n" + line + "\n\nPCRE2 regex engine error:\n" + NO_PCRE2;
}

function compiled(o: flags.Options, pattern: string, banned: u8[]): Option[regex.Regex] {
  if (o.engine == "pcre2") {
    eprint("rg: " + NO_PCRE2);
    return None;
  }
  if let Some(e) = regex.check(flags.joined(o), !o.has(flags.NO_UNICODE)) {
    eprint("rg: " + engine_error(o, e.report()));
    return None;
  }
  match (regex.compile(pattern)) {
    Ok(re) => {
      for b in banned {
        if (re.has_literal_byte(b)) {
          eprint("rg: the literal \"" + byte_name(b) + "\" is not allowed in a regex\n\n" + MULTILINE_HINT);
          return None;
        }
      }
      return Some(re);
    },
    Err(e) => {
      eprint("rg: " + engine_error(o, "regex parse error: " + e.to_string()));
      return None;
    }
  }
  return None;
}

function read_input(path: string): Result[u8[], IoError] {
  if (path == "-") {
    return io.read_all_stdin_bytes();
  }
  return read_file_bytes(path);
}

function no_counts(): jsonl.Counts {
  return jsonl.Counts { matches: 0, lines: 0, printed: 0i64, searched: 0i64, searches: 0, with_match: 0 };
}

function no_totals(): Totals {
  return Totals { all: no_counts(), json: no_counts(), nanos: 0i64 };
}

function add(a: jsonl.Counts, b: jsonl.Counts): jsonl.Counts {
  return jsonl.Counts {
    matches: a.matches + b.matches, lines: a.lines + b.lines, printed: a.printed + b.printed, searched: a.searched + b.searched,
    searches: a.searches + b.searches, with_match: a.with_match + b.with_match,
  };
}

// The totals with the search of one more file. --json counts only the
// files that it writes.
function tally(ctx: Ctx, t: Totals, out: search.Outcome, nanos: i64): Totals {
  let s = out.stats;
  let c = jsonl.Counts {
    matches: s.matches, lines: s.lines, printed: s.printed, searched: s.searched, searches: 1,
    with_match: if (out.matched) { 1 } else { 0 },
  };
  let json = if (ctx.p.json && s.printed > 0i64) { add(t.json, c) } else { t.json };
  return Totals { all: add(t.all, c), json: json, nanos: t.nanos + nanos };
}

// The name of a file in the output. Without a path on the command line,
// ripgrep drops the leading "./".
function display_name(ctx: Ctx, path: string): string {
  if (path == "-") {
    return "<stdin>";
  }
  if (ctx.implicit) {
    return ignore.strip_dot(path);
  }
  return path;
}

// How ripgrep reads a file, with the line buffer of capacity `cap`. -a and
// --null-data turn off the search for binary data, and --binary searches a
// walked file as one on the command line. A decoded file, and the output
// of a program, are read in buffers.
function source(ctx: Ctx, it: walk.Item, cap: i32, buffered: boolean): search.Source {
  let mapped = ctx.mmap && it.path != "-" && !buffered;
  let detect = if (ctx.binary == 2 || ctx.p.term == 0) {
    search.DETECT_NONE
  } else if (it.explicit || ctx.binary == 1) {
    search.DETECT_CONVERT
  } else {
    search.DETECT_QUIT
  };
  return search.Source { mapped: mapped, detect: detect, cap: cap };
}

// Searches the files of `items` in order, and writes their output to `h`.
// A message of the walk goes to the standard error at its place.
function search_items(ctx: Ctx, re: regex.Regex, items: walk.Item[], h: usize): Part {
  let r = empty_part();
  let written = false;
  let cap = search.BUFFER;
  for it in items {
    if (it.path == "") {
      r = note(ctx, r, it.message, it.error);
      continue;
    }
    r = Part { ...r, searched: true };
    let f = search_file(ctx, re, it, cap, h, written);
    for e in f.errors {
      r = note(ctx, r, e, true);
    }
    if let Some(out) = f.out {
      written = out.written;
      cap = out.cap;
      r = Part { ...r, matched: r.matched || out.matched, totals: tally(ctx, r.totals, out, f.nanos) };
    }
    if (!flush(h, ctx.line_buffered)) {
      return Part { ...r, failed: true };
    }
    if (r.matched && ctx.quiet) {
      break;
    }
  }
  return r;
}

// The search of one file: its outcome, or None when it was not searched,
// the time of the search, and the messages of its errors.
struct Searched { out: Option[search.Outcome], nanos: i64, errors: string[] }

// The bytes that the search of a file reads: the file, the output of the
// preprocessor of --pre, or the file that -z decompresses. `prefix` and
// `late` are the message of a program that failed after its output.
// `piped` says that ripgrep reads the bytes from a program, not from a
// map of the file.
struct Haystack { bytes: u8[], prefix: string, late: string, piped: boolean }

// Searches the file of `it`, and writes its output to `h`.
function search_file(ctx: Ctx, re: regex.Regex, it: walk.Item, cap: i32, h: usize, written: boolean): Searched {
  let name = display_name(ctx, it.path);
  let none: string[] = [];
  let hay = match (haystack(ctx, it.path, name)) {
    Ok(v) => v,
    Err(why) => {
      return Searched { out: None, nanos: 0i64, errors: [name + ": " + why] };
    },
  };
  let p = ctx.p;
  if (hay.late != "" && counted(p.mode)) {
    return Searched { out: None, nanos: 0i64, errors: [name + ": " + hay.prefix + hay.late] };
  }
  let t0 = monotonic_ns();
  let (text, decoded) = encoding.decode(hay.bytes, ctx.encoding, ctx.decoder);
  let out = search.search(linked(ctx, it.path), re, text, name, source(ctx, it, cap, decoded || hay.piped), h, written);
  let prefix = if (p.mode == flags.Files && out.matched) { "" } else { hay.prefix };
  let errors = if (hay.late == "") { none } else { [name + ": " + prefix + hay.late] };
  return Searched { out: Some(out), nanos: monotonic_ns() - t0, errors: errors };
}

// Whether the output is a count for each file, which ripgrep does not
// write when the program of the file fails.
function counted(mode: flags.Mode): boolean {
  return mode == flags.Count || mode == flags.CountMatches || mode == flags.Without;
}

// The bytes to search for `path`, or the message of an error.
function haystack(ctx: Ctx, path: string, name: string): Result[Haystack, string] {
  if (path != "-" && ctx.pre != "" && preprocessed(ctx, name)) {
    return preprocess(ctx, path, name);
  }
  let bytes = match (read_input(path)) {
    Ok(b) => b,
    Err(e) => {
      return Err(ignore.os_error(e));
    },
  };
  let prog = if (ctx.search_zip && path != "-") { decompress.program(path) } else { "" };
  if (prog == "") {
    return Ok(Haystack { bytes: bytes, prefix: "", late: "", piped: false });
  }
  let (out, why) = decompress.decompressed(prog, name, bytes);
  return Ok(Haystack { bytes: out, prefix: "", late: if (why == "") { "" } else { stderr_text(why) }, piped: true });
}

// Whether --pre runs for the file: with no --pre-glob, or when the globs
// of --pre-glob do not ignore it.
function preprocessed(ctx: Ctx, name: string): boolean {
  return ctx.pre_globs.rules.len() == 0 || ctx.pre_globs.override(name, false) != ignore.IGNORE;
}

// The output of the preprocessor of --pre for the file. The preprocessor
// reads the file on its standard input and gets its path as an argument.
function preprocess(ctx: Ctx, path: string, name: string): Result[Haystack, string] {
  if let Err(e) = open_reader(path) {
    return Err(ignore.os_error(e));
  }
  let cmd = debug_arg(ctx.pre) + " " + debug_arg(name);
  let out = match (process.run(ctx.pre, [name], path)) {
    Ok(v) => v,
    Err(e) => {
      return Err("preprocessor command could not start: '" + cmd + "': " + ignore.os_error(e));
    },
  };
  let late = if (out.status == 0) { "" } else { stderr_text(unsafe { string_from_bytes_unchecked(out.stderr) }) };
  return Ok(Haystack { bytes: out.stdout, prefix: "preprocessor command failed: '" + cmd + "': ", late: late, piped: true });
}

// An argument in quotes, as Rust writes it for debug.
function debug_arg(text: string): string {
  return "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r") + "\"";
}

// The standard error of a command that failed, as ripgrep writes it.
function stderr_text(err: string): string {
  let msg = err.trim();
  if (msg == "") {
    return "<stderr is empty>";
  }
  let line = "-".repeat(79);
  return "\n" + line + "\n" + msg + "\n" + line;
}

function empty_part(): Part {
  let none: string[] = [];
  return Part { out: "", errors: none, matched: false, failed: false, searched: false, totals: no_totals() };
}

// Writes a message now, and records an error.
function note(ctx: Ctx, r: Part, text: string, error: boolean): Part {
  if (ctx.messages && (error || ctx.ignore_messages)) {
    eprint("rg: " + text);
  }
  return Part { ...r, failed: r.failed || error };
}

// The search of one run of files in a worker. The output comes back as
// text, and the parent writes it.
function search_part(ctx: Ctx, items: walk.Item[]): Part {
  let Ok(re) = regex.compile(ctx.pattern) else {
    return Part { ...empty_part(), failed: true };
  };
  let h = buf_new(FLUSH_BYTES);
  let r = search_buffered(ctx, re, items, h);
  let out = buf_take(h);
  buf_free(h);
  return Part { ...r, out: out };
}

// As search_items, but the output stays in the buffer.
function search_buffered(ctx: Ctx, re: regex.Regex, items: walk.Item[], h: usize): Part {
  let r = empty_part();
  let written = false;
  let cap = search.BUFFER;
  for it in items {
    r = Part { ...r, searched: true };
    let f = search_file(ctx, re, it, cap, h, written);
    if (f.errors.len() > 0) {
      r = Part { ...r, errors: r.errors.concat(f.errors), failed: true };
    }
    if let Some(out) = f.out {
      written = out.written;
      cap = out.cap;
      r = Part { ...r, matched: r.matched || out.matched, totals: tally(ctx, r.totals, out, f.nanos) };
    }
    if (r.matched && ctx.quiet) {
      break;
    }
  }
  return r;
}

// The runs of files for `n` workers: file k goes to run k mod n, so that
// each run has files from each part of the tree.
function runs_of(items: walk.Item[], n: i32): walk.Item[][] {
  let runs: walk.Item[][] = [];
  for _ in 0..n {
    let empty: walk.Item[] = [];
    runs = runs.append(empty);
  }
  for i in 0..items.len() {
    let k = i % n;
    runs = runs.with(k, runs[k].append(items[i]));
  }
  return runs;
}

// The parts of the runs from `k` on. A worker searches each run but the
// last, which the parent searches.
function parts(ctx: Ctx, runs: walk.Item[][], k: i32): Part[] {
  if (k == runs.len() - 1) {
    return [search_part(ctx, runs[k])];
  }
  let run = runs[k];
  let w = worker.spawn((): Part => search_part(ctx, run));
  let rest = parts(ctx, runs, k + 1);
  return [w.join()].concat(rest);
}

// Searches the files with `threads` workers. The messages of the walk come
// first, then the output of each worker in turn.
function search_parallel(ctx: Ctx, items: walk.Item[], threads: i32): Part {
  let r = empty_part();
  let files: walk.Item[] = [];
  for it in items {
    if (it.path == "") {
      r = note(ctx, r, it.message, it.error);
    } else {
      files = files.append(it);
    }
  }
  let n = if (files.len() < threads) { files.len() } else { threads };
  if (n == 0) {
    return r;
  }
  for part in parts(ctx, runs_of(files, n), 0) {
    r = merge(ctx, r, part);
  }
  return r;
}

// Writes the output and the messages of a worker after those of the
// earlier workers. `r.out` keeps "x" once any output is written.
function merge(ctx: Ctx, r0: Part, part: Part): Part {
  let r = r0;
  for e in part.errors {
    r = note(ctx, r, e, true);
  }
  if (part.out != "") {
    let sep = search.file_separator(ctx.p);
    if (r.out != "" && sep != "") {
      print_raw(sep);
    }
    print_raw(part.out);
    r = Part { ...r, out: "x" };
  }
  return Part {
    ...r, matched: r.matched || part.matched, failed: r.failed || part.failed, searched: r.searched || part.searched,
    totals: Totals { all: add(r.totals.all, part.totals.all), json: add(r.totals.json, part.totals.json), nanos: r.totals.nanos + part.totals.nanos },
  };
}

function print_raw(text: string): void {
  let _ = stdout().write(text);
}

// 0 when a line is selected, 1 when none is, and 2 after an error. With
// -q, a match gives 0 also after an error.
function status(matched: boolean, failed: boolean, quiet: boolean): i32 {
  if (matched && (quiet || !failed)) {
    return 0;
  }
  if (failed) {
    return 2;
  }
  return 1;
}

// Whether the standard input can be read: a file, a pipe or a socket, as
// ripgrep's heuristic asks.
function stdin_readable(): boolean {
  let Ok(st) = stdin().stat() else {
    return false;
  };
  let kind = st.mode & 0o170000u32;
  return kind == 0o100000u32 || kind == 0o010000u32 || kind == 0o140000u32;
}

function is_file(path: string): boolean {
  let Ok(st) = stat(path) else {
    return false;
  };
  return st.is_file;
}

// Whether ripgrep maps the files into memory: with --mmap, or by default
// for at most ten paths that are all files.
function maps(o: flags.Options, paths: string[]): boolean {
  if (o.mmap >= 0) {
    return o.mmap == 1;
  }
  if (paths.len() > 10) {
    return false;
  }
  for p in paths {
    if (!is_file(p)) {
      return false;
    }
  }
  return true;
}

// The rules of the walk, or the message of a glob or a type that is not
// valid.
function config(o: flags.Options): Result[ignore.Config, string] {
  let cwd = match (getcwd()) {
    Ok(d) => d,
    Err(_) => "",
  };
  let ov = ignore.overrides(cwd, o.globs, o.iglobs, o.has(flags.GLOB_CASE))?;
  let ty = ignore.build_types(o.types)?;
  let ci = o.has(flags.IGNORE_FILE_CASE);
  let none: ignore.Matcher[] = [];
  return Ok(ignore.Config {
    skip_hidden: !o.has(flags.HIDDEN),
    dot: !o.has(flags.NO_IGNORE_DOT),
    vcs: !o.has(flags.NO_IGNORE_VCS),
    exclude: !o.has(flags.NO_IGNORE_VCS) && !o.has(flags.NO_IGNORE_EXCLUDE),
    global: !o.has(flags.NO_IGNORE_VCS) && !o.has(flags.NO_IGNORE_GLOBAL),
    parents: !o.has(flags.NO_IGNORE_PARENT),
    require_git: !o.has(flags.NO_REQUIRE_GIT),
    ci: ci,
    overrides: ov,
    types: ty,
    explicit: none,
    global_rules: ignore.empty(""),
  });
}

// The global gitignore and the --ignore-file rules, with their messages.
function with_files(ctx: Ctx, o: flags.Options, cfg: ignore.Config): ignore.Config {
  let c = cfg;
  if (cfg.global) {
    let g = ignore.global(cfg.ci);
    c = ignore.Config { ...c, global_rules: g.m };
    for e in g.errors {
      note_now(ctx, e);
    }
  }
  if (o.has(flags.NO_IGNORE_FILES)) {
    return c;
  }
  let explicit: ignore.Matcher[] = [];
  for path in o.ignore_files {
    let l = ignore.explicit_file(path, cfg.ci);
    if (l.errors.len() > 0) {
      note_now(ctx, l.errors.join("\n"));
    }
    explicit = explicit.append(l.m);
  }
  return ignore.Config { ...c, explicit: explicit };
}

function note_now(ctx: Ctx, text: string): void {
  if (ctx.messages && ctx.ignore_messages) {
    eprint("rg: " + text);
  }
}

// The stat time that --sort and --sortr order by, or None.
function time_of(path: string, kind: string): Option[(i64, i64)] {
  let Ok(st) = stat(path) else {
    return None;
  };
  return match (kind) {
    "modified" => Some((st.mtime, st.mtime_nsec)),
    "accessed" => Some((st.atime, st.atime_nsec)),
    _ => Some((st.btime, st.btime_nsec)),
  };
}

// The files in the order of --sortr path, or of a sort by a time. The
// messages come first. Ascending times put a file with no time last.
function sorted(o: flags.Options, items: walk.Item[]): walk.Item[] {
  let msgs: walk.Item[] = [];
  let files: walk.Item[] = [];
  for it in items {
    if (it.path == "") {
      msgs = msgs.append(it);
    } else {
      files = files.append(it);
    }
  }
  if (o.sort == "path") {
    let by = cmp.sort_by(files, (a: walk.Item, b: walk.Item): i32 => path_order(b.path, a.path));
    return msgs.concat(by);
  }
  let keyed = cmp.sort_by(files, (a: walk.Item, b: walk.Item): i32 => time_order(time_of(a.path, o.sort), time_of(b.path, o.sort), o.sort_reverse));
  return msgs.concat(keyed);
}

function time_order(a: Option[(i64, i64)], b: Option[(i64, i64)], reverse: boolean): i32 {
  let c = match (a) {
    Some(x) => match (b) {
      Some(y) => compare_times(x, y),
      None => -1,
    },
    None => if (b == None) { 0 } else { 1 },
  };
  return if (reverse) { -c } else { c };
}

function compare_times(x: (i64, i64), y: (i64, i64)): i32 {
  if (x.0 != y.0) {
    return if (x.0 < y.0) { -1 } else { 1 };
  }
  if (x.1 != y.1) {
    return if (x.1 < y.1) { -1 } else { 1 };
  }
  return 0;
}

// The order of two paths by their parts, as Rust's Path compares them.
function path_order(a: string, b: string): i32 {
  let x = a.split("/");
  let y = b.split("/");
  let n = if (x.len() < y.len()) { x.len() } else { y.len() };
  for i in 0..n {
    if (x[i] != y[i]) {
      return if (cmp.lt(x[i], y[i])) { -1 } else { 1 };
    }
  }
  return x.len() - y.len();
}

// --files: each file to search, one on each line.
function list_files(ctx: Ctx, items: walk.Item[], o: flags.Options): i32 {
  let h = buf_new(FLUSH_BYTES);
  let r = empty_part();
  let term = if (o.has(flags.NULL)) { "\x00" } else { "\n" };
  for it in items {
    if (it.path == "") {
      r = note(ctx, r, it.message, it.error);
      continue;
    }
    r = Part { ...r, matched: true };
    if (ctx.quiet) {
      break;
    }
    search.push_path(linked(ctx, it.path), h, display_name(ctx, it.path));
    buf_push(h, term);
    if (!flush(h, ctx.line_buffered)) {
      break;
    }
  }
  let _ = flush(h, true);
  buf_free(h);
  return status(r.matched, r.failed, ctx.quiet);
}

function type_list(o: flags.Options): i32 {
  match (ignore.build_types(o.types)) {
    Ok(t) => {
      for line in t.listing() {
        print(line);
      }
      return 0;
    },
    Err(why) => {
      eprint("rg: " + why);
      return 2;
    }
  }
  return 2;
}

// The file of the standard output, which a walk skips.
function stdout_file(): (i64, i64) {
  let Ok(st) = stdout().stat() else {
    return (0i64, 0i64);
  };
  if (!st.is_file) {
    return (0i64, 0i64);
  }
  return (st.ino, st.dev);
}

function threads_of(o: flags.Options, one_file: boolean): i32 {
  if (o.sort != "" || one_file) {
    return 1;
  }
  if (o.threads > 0) {
    return o.threads;
  }
  let n = cpu_count() as i32;
  return if (n > 12) { 12 } else { n };
}

// The paths to search. With none, ripgrep searches the standard input when
// it can be read, and the current directory when not.
function paths_of(o: flags.Options): string[] {
  if (o.paths.len() > 0) {
    return o.paths;
  }
  return if (o.searches() && stdin_readable()) { ["-"] } else { ["./"] };
}

function context_of(o: flags.Options, paths: string[]): Ctx {
  let one_file = paths.len() == 1 && (paths[0] == "-" || is_file(paths[0]));
  let threads = threads_of(o, one_file);
  let pattern = if (o.searches()) { flags.pattern(o) } else { "" };
  return Ctx {
    p: with_links(search.printer(o, isatty(1), term_color(), one_file), o), pattern: pattern, implicit: o.paths.len() == 0, mmap: maps(o, paths),
    binary: o.binary, threads: threads, quiet: o.has(flags.QUIET), messages: !o.has(flags.NO_MESSAGES),
    ignore_messages: !o.has(flags.NO_IGNORE_MESSAGES), encoding: o.encoding, decoder: encoding.decoder(o.encoding),
    pre: o.pre, pre_globs: pre_globs(o), search_zip: o.has(flags.SEARCH_ZIP),
    line_buffered: o.buffer == 1 || o.buffer == 0 && isatty(1),
  };
}

// The printer with the host name of its links, when the output has links.
function with_links(p: search.Printer, o: flags.Options): search.Printer {
  if (!p.color || p.hyperlink.is_empty()) {
    return p;
  }
  return search.Printer { ...p, hyperlink: hyperlink.with_host(p.hyperlink, o.hostname_bin) };
}

// The printer for the file at `path`, with the path of its links. The
// standard input has no link.
function linked(ctx: Ctx, path: string): search.Printer {
  if (!ctx.p.color || ctx.p.hyperlink.is_empty() || path == "-") {
    return ctx.p;
  }
  let real = hyperlink.canonical(path);
  if (real == "") {
    return ctx.p;
  }
  return search.Printer { ...ctx.p, link: hyperlink.encode(real) };
}

// The globs of --pre-glob, as globs of -g.
function pre_globs(o: flags.Options): ignore.Matcher {
  let cwd = match (getcwd()) {
    Ok(d) => d,
    Err(_) => "",
  };
  return match (ignore.overrides(cwd, o.pre_globs, [], false)) {
    Ok(m) => m,
    Err(_) => ignore.empty(""),
  };
}

// Whether the terminal takes color, as termcolor asks for --color auto: a
// TERM that is not "dumb", and no NO_COLOR.
function term_color(): boolean {
  let term = match (env("TERM")) {
    Some(t) => t,
    None => "",
  };
  return term != "" && term != "dumb" && env("NO_COLOR") == None;
}

// The files to search and the messages of the walk, in the order of
// --sort or --sortr.
function items_of(ctx: Ctx, o: flags.Options, cfg: ignore.Config, paths: string[]): walk.Item[] {
  let (ino, dev) = stdout_file();
  let w = walk.Walk {
    cfg: cfg, max_filesize: o.max_filesize, follow: o.has(flags.FOLLOW), max_depth: o.max_depth, sorted: o.sort == "path" && !o.sort_reverse,
    threads: ctx.threads, stdout_ino: if (o.searches()) { ino } else { 0i64 }, stdout_dev: dev,
    same_fs: o.has(flags.ONE_FILE_SYSTEM), root_dev: 0i64,
  };
  let items = walk.walk(w, paths);
  if (o.sort != "" && (o.sort_reverse || o.sort != "path")) {
    return sorted(o, items);
  }
  return items;
}

function run(o: flags.Options, t0: i64): i32 {
  let paths = paths_of(o);
  let ctx = context_of(o, paths);
  let cfg = match (config(o)) {
    Ok(c) => c,
    Err(why) => {
      eprint("rg: " + why);
      return 2;
    },
  };
  let items = items_of(ctx, o, with_files(ctx, o, cfg), paths);
  if (!o.searches()) {
    return list_files(ctx, items, o);
  }
  let Some(re) = compiled(o, ctx.pattern, banned(o)) else {
    return 2;
  };
  let r = if (ctx.threads > 1) { search_parallel(ctx, items, ctx.threads) } else { search_serial(ctx, re, items) };
  if (ctx.implicit && !r.searched) {
    r = note(ctx, r, NOTHING_SEARCHED, true);
  }
  print_totals(ctx, o, r.totals, monotonic_ns() - t0);
  return status(r.matched, r.failed, ctx.quiet);
}

// The last message of --json, or the lines of --stats.
function print_totals(ctx: Ctx, o: flags.Options, t: Totals, total: i64): void {
  if (ctx.p.json && o.mode == flags.Lines && !ctx.quiet) {
    print_raw(jsonl.summary(t.json, t.nanos, total));
  } else if (o.has(flags.STATS)) {
    print_raw(stats_text(t, total));
  }
}

// The lines of --stats, after an empty line.
function stats_text(t: Totals, total: i64): string {
  let c = t.all;
  let out = "\n" + c.matches.to_string() + " matches\n" + c.lines.to_string() + " matched lines\n";
  out += c.with_match.to_string() + " files contained matches\n" + c.searches.to_string() + " files searched\n";
  out += c.printed.to_string() + " bytes printed\n" + c.searched.to_string() + " bytes searched\n";
  return out + jsonl.seconds(t.nanos) + " seconds spent searching\n" + jsonl.seconds(total) + " seconds\n";
}

function search_serial(ctx: Ctx, re: regex.Regex, items: walk.Item[]): Part {
  let h = buf_new(FLUSH_BYTES);
  let r = search_items(ctx, re, items, h);
  if (!flush(h, true)) {
    r = Part { ...r, failed: true };
  }
  buf_free(h);
  return r;
}

// The options with the patterns of the -f files in their place among the
// -e patterns. A line terminator, and a CR before it, end each pattern.
function with_pattern_files(o: flags.Options): Result[flags.Options, string] {
  let patterns: string[] = [];
  let k = 0;
  for i in 0..o.patterns.len() + 1 {
    while (k < o.pattern_files.len() && o.pattern_file_at[k] == i) {
      patterns = patterns.concat(read_patterns(o.pattern_files[k])?);
      k += 1;
    }
    if (i < o.patterns.len()) {
      patterns = patterns.append(o.patterns[i]);
    }
  }
  return Ok(flags.Options { ...o, patterns: patterns });
}

function read_patterns(path: string): Result[string[], string] {
  let bytes = match (read_input(path)) {
    Ok(b) => b,
    Err(e) => {
      return Err(path + ": " + ignore.os_error(e));
    },
  };
  let text = unsafe { string_from_bytes_unchecked(bytes) };
  let out: string[] = [];
  let start = 0;
  let n = 1;
  while (start < text.len()) {
    let nl = __memchr(text, 10, start);
    let end = if (nl < 0) { text.len() } else { nl };
    let stop = if (end > start && text[end - 1] == 13u8) { end - 1 } else { end };
    let line = slice_unchecked(text, start, stop).to_owned();
    let bad = encoding.invalid_at(line);
    if (bad >= 0) {
      let hex = encoding.escaped(slice_unchecked(line, bad, bad + 1).to_owned());
      return Err(f"{path}:{n}: found invalid UTF-8 in pattern at byte offset {bad}: {encoding.escaped(line)} (disable Unicode mode and use hex escape sequences to match arbitrary bytes in a pattern, e.g., '(?-u){hex}')");
    }
    out = out.append(line);
    start = end + 1;
    n += 1;
  }
  return Ok(out);
}

// The text of a special mode, which rg writes with no other check.
function special(mode: string): i32 {
  let text = match (mode) {
    "help" => help.HELP_SHORT,
    "help-long" => help.HELP_LONG,
    "version" => "ripgrep 14.1.0\n",
    "version-long" => version_long(),
    _ => NO_PCRE2,
  };
  print_raw(text.trim_end() + "\n");
  return if (mode == "pcre2-version") { 1 } else { 0 };
}

function version_long(): string {
  let simd = if (target_arch() == "x86-64") {
    "simd(compile):+SSE2,-SSSE3,-AVX2\nsimd(runtime):+SSE2,+SSSE3,+AVX2\n"
  } else if (target_arch() == "arm64") {
    "simd(compile):+NEON\nsimd(runtime):+NEON\n"
  } else {
    ""
  };
  return "ripgrep 14.1.0\n\nfeatures:-simd-accel,-pcre2\n" + simd + "\n" + NO_PCRE2 + "\n";
}

// The output of --generate.
function generate(kind: string): i32 {
  print_raw(match (kind) {
    "man" => help.MAN,
    "complete-bash" => help.COMPLETE_BASH,
    "complete-zsh" => help.COMPLETE_ZSH,
    "complete-fish" => help.COMPLETE_FISH,
    _ => help.COMPLETE_POWERSHELL,
  });
  return 0;
}

// The arguments of the file that RIPGREP_CONFIG_PATH names: each line that
// is not empty and does not start with `#`, without the white space around
// it.
function config_args(messages: boolean): string[] {
  let none: string[] = [];
  let Some(path) = env("RIPGREP_CONFIG_PATH") else {
    return none;
  };
  if (path == "") {
    return none;
  }
  let text = match (read_file_bytes(path)) {
    Ok(b) => unsafe { string_from_bytes_unchecked(b) },
    Err(e) => {
      if (messages) {
        eprint("rg: failed to read the file specified in RIPGREP_CONFIG_PATH: " + path + ": " + ignore.os_error(e));
      }
      return none;
    },
  };
  let out: string[] = [];
  for raw in text.split("\n") {
    let line = raw.trim();
    if (line != "" && line[0] != b'#') {
      out = out.append(line);
    }
  }
  return out;
}

// The options of the command line, after the arguments of the config file
// unless --no-config.
function options_of(cli: string[]): Result[flags.Options, string] {
  let low = flags.parse_flags(cli)?;
  if (low.special != "" || low.has(flags.NO_CONFIG)) {
    return flags.finish(low);
  }
  let extra = config_args(!low.has(flags.NO_MESSAGES));
  if (extra.len() == 0) {
    return flags.finish(low);
  }
  return flags.finish(flags.parse_flags(extra.concat(cli))?);
}

function main(): i32 {
  let t0 = monotonic_ns();
  let argv = args();
  let parsed = match (options_of(argv.drop(1))) {
    Ok(v) => v,
    Err(why) => {
      eprint("rg: " + why);
      return 2;
    },
  };
  if (parsed.special != "") {
    return special(parsed.special);
  }
  let o = match (with_pattern_files(parsed)) {
    Ok(v) => v,
    Err(why) => {
      eprint("rg: " + why);
      return 2;
    },
  };
  if (o.mode == flags.TypeList) {
    return type_list(o);
  }
  if (o.mode == flags.Generate) {
    return generate(o.generate);
  }
  if (o.searches() && o.max_count == 0) {
    return 1;
  }
  return run(o, t0);
}
