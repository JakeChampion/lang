// The programs of -z in the rg port.
//
// As ripgrep 14.1.0 does, the port runs gzip, bzip2, xz, lz4, brotli, zstd
// or uncompress on a file with a name that ends with one of their
// extensions, and searches the output.
import "std/array";

// The extensions of the files that -z decompresses, and the command that
// ripgrep runs for each, without the path of the file.
const EXTENSIONS: string[] = [".gz", ".tgz", ".bz2", ".tbz2", ".xz", ".txz", ".lz4", ".lzma", ".br", ".zst", ".zstd", ".Z"];

const COMMANDS: string[][] = [
  ["gzip", "-d", "-c"],
  ["gzip", "-d", "-c"],
  ["bzip2", "-d", "-c"],
  ["bzip2", "-d", "-c"],
  ["xz", "-d", "-c"],
  ["xz", "-d", "-c"],
  ["lz4", "-d", "-c"],
  ["xz", "--format=lzma", "-d", "-c"],
  ["brotli", "-d", "-c"],
  ["zstd", "-q", "-d", "-c"],
  ["zstd", "-q", "-d", "-c"],
  ["uncompress", "-c"],
];

// The command for a file name, its program first, or an empty list for a
// file that -z does not decompress.
pub function command(name: string): string[] {
  for k in 0..EXTENSIONS.len() {
    if (name.ends_with(EXTENSIONS[k])) {
      return COMMANDS[k];
    }
  }
  let none: string[] = [];
  return none;
}
