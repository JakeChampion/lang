// The directory walk of the rg port: the files that ripgrep 14.1.0 searches
// for the paths of a command line, in its order with one thread.
import "core/cmp";
import "./ignore";
import "./logs";

// One item of a walk: a file to search, or a message. An error message
// makes the exit status 2.
// A log line of --debug is a message with `log`, which rg writes as it is.
pub struct Item { path: string, explicit: boolean, message: string, error: boolean, log: boolean }

// The settings of a walk. `threads` decides the form of an error message.
// `stdout_ino` and `stdout_dev` name the file that the standard output
// writes to, which the walk skips (0 for none).
pub struct Walk {
  cfg: ignore.Config,
  // The largest file to search, in bytes, or -1.
  max_filesize: i64,
  follow: boolean,
  max_depth: i32,
  sorted: boolean,
  threads: i32,
  stdout_ino: i64,
  stdout_dev: i64,
  // --one-file-system, and the device of the root of the walk.
  same_fs: boolean,
  root_dev: i64,
  // The level of the logs of --debug and --trace.
  log: i32,
}

// The kinds of DirEntry.kind: the file type bits of st_mode, or 0 when
// readdir does not know the type.
const DT_UNKNOWN: u32 = 0;

const DT_DIR: u32 = 0o040000u32;

const DT_REG: u32 = 0o100000u32;

const DT_LNK: u32 = 0o120000u32;

function file(path: string, explicit: boolean): Item {
  return Item { path: path, explicit: explicit, message: "", error: false, log: false };
}

// A log line of the walk.
function logged(module: string, file: string, line: i32, text: string): Item {
  return Item { path: "", explicit: false, message: f"rg: DEBUG|{module}|{file}:{line}: {text}", error: false, log: true };
}

// The log of the decision of the walk for an entry: an entry that a rule
// ignores or keeps.
function decision_log(w: Walk, stack: ignore.Stack, path: string, is_dir: boolean, own items: Item[]): Item[] {
  if (w.log == 0) {
    return items;
  }
  let (v, text) = ignore.reason(stack, w.cfg, path, is_dir);
  if (text == "") {
    return items;
  }
  let file = logs.source("ignore-0.4.22", "walk.rs");
  if (v == ignore.IGNORE) {
    return items.append(logged("ignore::walk", file, 1799, "ignoring " + path + ": " + text));
  }
  return items.append(logged("ignore::walk", file, 1802, "whitelisting " + path + ": " + text));
}

// The log of an entry that is not a file or a directory, such as a link,
// with its metadata as Rust writes it with {:?}.
function filtered_log(path: string): Item {
  let Ok(st) = lstat(path) else {
    return message("", false);
  };
  let mode = (st.mode as i64).to_string();
  let kind = ((st.mode & 0o170000u32) as i64).to_string();
  let times = "modified: Ok(" + system_time(st.mtime, st.mtime_nsec) + "), accessed: Ok(" + system_time(st.atime, st.atime_nsec) + "), created: Ok(" + system_time(st.btime, st.btime_nsec) + ")";
  let text = "ignoring " + path + ": failed to pass haystack filter: file type: Some(FileType(FileType { mode: " + kind + " })), metadata: Ok(Metadata { file_type: FileType(FileType { mode: " + mode + " }), is_dir: false, is_file: false, permissions: Permissions(FilePermissions { mode: " + mode + " }), " + times + ", .. })";
  return logged("rg::haystack", "crates/core/haystack.rs", 70, text);
}

// Whether `path` is a directory or a link to one, which ripgrep does not
// log.
function points_to_dir(path: string): boolean {
  return match (stat(path)) {
    Ok(st) => st.is_dir,
    Err(_) => false,
  };
}

function system_time(sec: i64, nsec: i64): string {
  return "SystemTime { tv_sec: " + sec.to_string() + ", tv_nsec: " + nsec.to_string() + " }";
}

// The logs of the glob sets of the ignore files of a level, in the order
// that the ignore crate reads them.
function level_logs(w: Walk, l: ignore.Level, own items: Item[]): Item[] {
  if (w.log == 0) {
    return items;
  }
  for m in [l.custom, l.dot, l.git, l.exclude] {
    let text = m.glob_log();
    if (text != "") {
      items = items.append(logged("globset", logs.source("globset-0.4.14", "lib.rs"), 453, text));
    }
  }
  return items;
}

function message(text: string, error: boolean): Item {
  return Item { path: "", explicit: false, message: text, error: error, log: false };
}

// The message for a path that the walk cannot read. With one thread,
// ripgrep's walk names the operation.
pub function io_message(w: Walk, path: string, e: IoError): string {
  if (w.threads == 1) {
    return path + ": IO error for operation on " + path + ": " + ignore.os_error(e);
  }
  return path + ": " + ignore.os_error(e);
}

// The kind of an entry: DT_DIR, DT_REG, or another kind. An unknown kind
// comes from lstat.
function kind_of(path: string, e: DirEntry): u32 {
  if (e.kind != DT_UNKNOWN) {
    return e.kind;
  }
  let Ok(st) = lstat(path) else {
    return DT_UNKNOWN;
  };
  if (st.is_dir) {
    return DT_DIR;
  }
  if (st.is_file) {
    return DT_REG;
  }
  return st.mode & 0o170000u32;
}

// Whether the file is larger than --max-filesize.
function too_big(w: Walk, path: string): boolean {
  if (w.max_filesize < 0i64) {
    return false;
  }
  let Ok(st) = stat(path) else {
    return false;
  };
  return st.size > w.max_filesize;
}

// Whether `path` is the file of the standard output.
function is_stdout(w: Walk, path: string, ino: i64): boolean {
  if (w.stdout_ino == 0i64 || ino != w.stdout_ino) {
    return false;
  }
  let Ok(st) = stat(path) else {
    return false;
  };
  return st.dev == w.stdout_dev;
}

// The entries of `dir`, by name with --sort path.
function entries(w: Walk, dir: string): Result[DirEntry[], IoError] {
  let list = read_dir_ino(dir)?;
  if (w.sorted) {
    return Ok(cmp.sort_by_key(list, (e: DirEntry): string => e.name));
  }
  return Ok(list);
}

// The kind of the target of a link for -L, or an error message.
function follow_kind(w: Walk, path: string): Result[u32, string] {
  match (stat(path)) {
    Ok(st) => {
      if (st.is_dir) {
        return Ok(DT_DIR);
      }
      return Ok(if (st.is_file) { DT_REG } else { DT_UNKNOWN });
    },
    Err(e) => {
      return Err(io_message(w, path, e));
    }
  }
  return Ok(DT_UNKNOWN);
}

// The kind of an entry, with -L the kind of the target of a link.
function resolved_kind(w: Walk, path: string, e: DirEntry): Result[u32, string] {
  let kind = kind_of(path, e);
  if (kind == DT_LNK && w.follow) {
    return follow_kind(w, path);
  }
  return Ok(kind);
}

// Adds the items of one entry of a directory at `depth`.
function entry(w: Walk, dir: string, e: DirEntry, stack: ignore.Stack, depth: i32, own items: Item[]): Item[] {
  if (w.max_depth >= 0 && depth > w.max_depth) {
    return items;
  }
  let path = ignore.join(dir, e.name);
  let kind = match (resolved_kind(w, path, e)) {
    Ok(k) => k,
    Err(why) => {
      return items.append(message(why, true));
    },
  };
  let is_dir = kind == DT_DIR;
  items = decision_log(w, stack, path, is_dir, items);
  if (ignore.verdict(stack, w.cfg, path, is_dir) == ignore.IGNORE) {
    if (is_dir && w.log > 0) {
      // ripgrep reads the ignore files of a directory that it skips.
      let (skipped, why) = ignore.level(w.cfg, path, false);
      items = level_logs(w, skipped, items);
    }
    return items;
  }
  if (is_dir) {
    return descend(w, path, stack, depth + 1, items);
  }
  if (kind != DT_REG && w.log > 0 && !points_to_dir(path)) {
    return items.append(filtered_log(path));
  }
  if (kind != DT_REG || is_stdout(w, path, e.ino)) {
    return items;
  }
  if (too_big(w, path)) {
    if (w.log > 0) {
      let size = match (stat(path)) {
        Ok(st) => st.size,
        Err(_) => 0i64,
      };
      items = items.append(logged("ignore::walk", logs.source("ignore-0.4.22", "walk.rs"), 1786, f"ignoring {path}: {size} bytes"));
    }
    return items;
  }
  return items.append(file(path, false));
}

// Adds the items of a directory below the root, which --one-file-system
// skips on another device.
function descend(w: Walk, dir: string, parent: ignore.Stack, depth: i32, own items: Item[]): Item[] {
  if (w.same_fs && !on_device(dir, w.root_dev)) {
    return items;
  }
  return directory(w, dir, parent, depth, items);
}

function on_device(path: string, dev: i64): boolean {
  let Ok(st) = stat(path) else {
    return true;
  };
  return st.dev == dev;
}

// Adds the items of the directory `dir`, whose entries are at `depth`.
function directory(w: Walk, dir: string, parent: ignore.Stack, depth: i32, own items: Item[]): Item[] {
  let (l, why) = ignore.level(w.cfg, dir, false);
  items = level_logs(w, l, items);
  if (why != "") {
    items = items.append(message(why, false));
  }
  let stack = parent.push(l);
  match (entries(w, dir)) {
    Ok(list) => {
      for e in list {
        items = entry(w, dir, e, stack, depth, items);
      }
    },
    Err(err) => {
      items = items.append(message(io_message(w, dir, err), true));
    }
  }
  return items;
}

// The items of a walk of `roots` in order. A root that is not a directory
// is searched whatever the ignore rules say.
pub function walk(w: Walk, roots: string[]): Item[] {
  let items: Item[] = [];
  for root in roots {
    if (root == "-") {
      items = items.append(file(root, true));
      continue;
    }
    match (stat(root)) {
      Ok(st) => {
        if (!st.is_dir) {
          items = items.append(file(root, true));
          continue;
        }
        let (stack, why) = ignore.parents(w.cfg, root);
        for l in stack.levels {
          items = level_logs(w, l, items);
        }
        if (why != "") {
          items = items.append(message(why, true));
        }
        items = directory(Walk { ...w, root_dev: st.dev }, root, stack, 1, items);
      },
      Err(e) => {
        items = items.append(message(io_message(w, root, e), true));
      }
    }
  }
  return items;
}
