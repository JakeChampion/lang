// The encodings of -E in the rg port: the labels, and the decode of a file
// to the UTF-8 text that the search reads.
//
// ripgrep 14.1.0 decodes with encoding_rs, and the port decodes with
// std/encoding, which gives the same text.
import "std/encoding" as whatwg;
import "std/string";

const HEX: string = "0123456789ABCDEF";

// The name of the encoding of a label, "none" for `none`, or "" for a
// label that the port does not know. For a label of the standard, the case
// and the white space around the label do not count.
pub function label(text: string): string {
  if (text == "none") {
    return "none";
  }
  return whatwg.label(text);
}

// The decoder of the encoding `name`. The search of each file uses it.
pub function decoder(name: string): whatwg.Decoder {
  return whatwg.decoder(if (name == "" || name == "none") { "UTF-8" } else { name });
}

// The text of a file with the encoding of `d`, and whether it is decoded.
// `name` is the name of the encoding, "none" or "". A byte order mark of
// UTF-8 or UTF-16 takes precedence over the encoding, and the text does not
// keep it. "none" keeps the bytes, and "" decodes only a file with a byte
// order mark. A decode makes each malformed sequence U+FFFD, but the bytes
// after a byte order mark of UTF-8 stay as they are.
pub function decode(own bytes: u8[], name: string, d: whatwg.Decoder): (string, boolean) {
  if (name == "none") {
    return (raw(bytes), false);
  }
  if (starts(bytes, [239u8, 187u8, 191u8])) {
    let n = bytes.len();
    return (slice_unchecked(raw(bytes), 3, n).to_owned(), true);
  }
  if (starts(bytes, [255u8, 254u8])) {
    return (whatwg.decoder("UTF-16LE").decode(bytes.drop(2)), true);
  }
  if (starts(bytes, [254u8, 255u8])) {
    return (whatwg.decoder("UTF-16BE").decode(bytes.drop(2)), true);
  }
  if (name == "") {
    return (raw(bytes), false);
  }
  return (d.decode(bytes), true);
}

function starts(bytes: u8[], mark: u8[]): boolean {
  if (bytes.len() < mark.len()) {
    return false;
  }
  for k in 0..mark.len() {
    if (bytes[k] != mark[k]) {
      return false;
    }
  }
  return true;
}

function raw(own bytes: u8[]): string {
  return unsafe { string_from_bytes_unchecked(bytes) };
}

function finish(h: usize): string {
  let out = buf_take(h);
  buf_free(h);
  return out;
}

// The range of the second byte after the lead byte `b`, as low and high,
// and the count of bytes, or a count of 0 for a byte that leads nothing.
function utf8_lead(b: i32): (i32, i32, i32) {
  if (b < 128) {
    return (0, 0, 1);
  }
  if (b < 194 || b > 244) {
    return (0, 0, 0);
  }
  if (b < 224) {
    return (128, 191, 2);
  }
  if (b < 240) {
    return (if (b == 224) { 160 } else { 128 }, if (b == 237) { 159 } else { 191 }, 3);
  }
  return (if (b == 240) { 144 } else { 128 }, if (b == 244) { 143 } else { 191 }, 4);
}

// The count of the bytes of the valid character at `i`, or 0.
function utf8_valid_len(bytes: string, i: i32): i32 {
  let (lo, hi, n) = utf8_lead(bytes[i] as i32);
  if (n <= 1) {
    return n;
  }
  if (i + n > bytes.len() || bytes[i + 1] as i32 < lo || bytes[i + 1] as i32 > hi) {
    return 0;
  }
  for k in 2..n {
    if (bytes[i + k] < 128u8 || bytes[i + k] > 191u8) {
      return 0;
    }
  }
  return n;
}

// The offset of the first byte of `text` that does not start a valid UTF-8
// character, or -1.
pub function invalid_at(text: string): i32 {
  let i = 0;
  while (i < text.len()) {
    let n = utf8_valid_len(text, i);
    if (n == 0) {
      return i;
    }
    i += n;
  }
  return -1;
}

// `text` with each byte that is not part of a valid UTF-8 character written
// as `\xHH`, as ripgrep shows a pattern.
pub function escaped(text: string): string {
  let h = buf_new(text.len());
  let i = 0;
  while (i < text.len()) {
    let n = utf8_valid_len(text, i);
    if (n > 0) {
      buf_push_range(h, text, i, i + n);
      i += n;
    } else {
      buf_push(h, "\\x");
      buf_push_byte(h, HEX[text[i] as i32 >> 4] as i32);
      buf_push_byte(h, HEX[text[i] as i32 & 15] as i32);
      i += 1;
    }
  }
  return finish(h);
}
