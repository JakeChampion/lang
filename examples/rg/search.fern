// The options, the pattern, the search and the output of the rg port.
//
// The output is that of ripgrep 14.1.0 when its standard output is not a
// terminal: no heading, and no line numbers unless -n.
import "std/regex";
import "std/string";

pub enum Mode {
  Lines,
  Count,
  Files,
}

pub struct Options {
  patterns: string[],
  paths: string[],
  ignore_case: boolean,
  invert: boolean,
  word: boolean,
  fixed: boolean,
  line_number: boolean,
  mode: Mode,
  only_matching: boolean,
  after: i32,
  before: i32,
  context: i32,
  color: string,
  with_filename: i32,
  threads: i32,
}

// How one file is written. `show_name` and `color` are already resolved.
pub struct Printer {
  mode: Mode,
  invert: boolean,
  only_matching: boolean,
  line_number: boolean,
  after: i32,
  before: i32,
  color: boolean,
  show_name: boolean,
}

// The result of one file: whether it has a selected line, and whether the
// output so far holds any bytes.
pub struct Outcome { matched: boolean, written: boolean }

struct Step { o: Options, next: i32 }

const SHORT_FLAGS: string = "isvwFnNcloHIABCej";

const LONG_FLAGS: string[] = [
  "ignore-case", "case-sensitive", "invert-match", "word-regexp", "fixed-strings",
  "line-number", "no-line-number", "count", "files-with-matches", "only-matching",
  "with-filename", "no-filename", "after-context", "before-context", "context",
  "regexp", "threads", "color",
];

const VALUE_FLAGS: string[] = ["after-context", "before-context", "context", "regexp", "threads", "color"];

const PATH_COLOR: string = "\x1b[0m\x1b[35m";

const LINE_COLOR: string = "\x1b[0m\x1b[32m";

const MATCH_COLOR: string = "\x1b[0m\x1b[1m\x1b[31m";

const RESET: string = "\x1b[0m";

const META: string = "\\.+*?()|[]{}^$";

pub function defaults(): Options {
  return Options {
    patterns: [], paths: [], ignore_case: false, invert: false, word: false, fixed: false,
    line_number: false, mode: Lines, only_matching: false, after: -1, before: -1, context: -1,
    color: "auto", with_filename: -1, threads: 0,
  };
}

// The long name of a short flag, or "".
function long_name(c: u8): string {
  let i = __memchr(SHORT_FLAGS, c as i32, 0);
  if (i < 0) {
    return "";
  }
  return LONG_FLAGS[i];
}

function takes_value(name: string): boolean {
  for v in VALUE_FLAGS {
    if (v == name) {
      return true;
    }
  }
  return false;
}

function known(name: string): boolean {
  for v in LONG_FLAGS {
    if (v == name) {
      return true;
    }
  }
  return false;
}

function set_match_switch(o: Options, name: string): Options {
  if (name == "ignore-case") {
    return Options { ...o, ignore_case: true };
  }
  if (name == "case-sensitive") {
    return Options { ...o, ignore_case: false };
  }
  if (name == "invert-match") {
    return Options { ...o, invert: true };
  }
  if (name == "word-regexp") {
    return Options { ...o, word: true };
  }
  return Options { ...o, fixed: true };
}

function set_switch(o: Options, name: string): Options {
  if (name == "line-number") {
    return Options { ...o, line_number: true };
  }
  if (name == "no-line-number") {
    return Options { ...o, line_number: false };
  }
  if (name == "count") {
    return Options { ...o, mode: Count };
  }
  if (name == "files-with-matches") {
    return Options { ...o, mode: Files };
  }
  if (name == "only-matching") {
    return Options { ...o, only_matching: true };
  }
  if (name == "with-filename") {
    return Options { ...o, with_filename: 1 };
  }
  if (name == "no-filename") {
    return Options { ...o, with_filename: 0 };
  }
  return set_match_switch(o, name);
}

// A decimal count as ripgrep reads it, or the reason it is not one.
pub function parse_count(text: string): Result[i32, string] {
  if (text.len() == 0) {
    return Err("cannot parse integer from empty string");
  }
  let n = 0u64;
  for i in 0..text.len() {
    let d = text[i] as i32 - 48;
    if (d < 0 || d > 9) {
      return Err("invalid digit found in string");
    }
    if (n > 1844674407370955161u64 || n == 1844674407370955161u64 && d > 5) {
      return Err("number too large to fit in target type");
    }
    n = n * 10u64 + d as u64;
  }
  if (n > 2147483647u64) {
    return Ok(2147483647);
  }
  return Ok(n as i32);
}

function set_color(o: Options, flag: string, value: string): Result[Options, string] {
  if (value != "never" && value != "auto" && value != "always" && value != "ansi") {
    return Err("error parsing flag " + flag + ": choice '" + value + "' is unrecognized");
  }
  return Ok(Options { ...o, color: value });
}

function set_value(o: Options, name: string, flag: string, value: string): Result[Options, string] {
  if (name == "regexp") {
    return Ok(Options { ...o, patterns: o.patterns.append(value) });
  }
  if (name == "color") {
    return set_color(o, flag, value);
  }
  let n = match (parse_count(value)) {
    Ok(v) => v,
    Err(why) => {
      return Err("error parsing flag " + flag + ": value is not a valid number: " + why);
    },
  };
  return Ok(set_count(o, name, n));
}

function set_count(o: Options, name: string, n: i32): Options {
  if (name == "after-context") {
    return Options { ...o, after: n };
  }
  if (name == "before-context") {
    return Options { ...o, before: n };
  }
  if (name == "context") {
    return Options { ...o, context: n };
  }
  return Options { ...o, threads: n };
}

function missing(flag: string): string {
  return "missing value for flag " + flag + ": missing argument for option '" + flag + "'";
}

// `--name` or `--name=value` at args[at - 1].
function long_flag(o: Options, args: string[], at: i32): Result[Step, string] {
  let arg = args[at - 1];
  let eq = __memchr(arg, 61, 2);
  let name = slice_unchecked(arg, 2, arg.len()).to_owned();
  if (eq >= 0) {
    name = slice_unchecked(arg, 2, eq).to_owned();
  }
  let flag = "--" + name;
  if (!known(name)) {
    return Err("unrecognized flag " + flag);
  }
  if (!takes_value(name)) {
    if (eq >= 0) {
      return Err("invalid CLI arguments: unexpected argument for option '" + flag + "': \"" + slice_unchecked(arg, eq + 1, arg.len()) + "\"");
    }
    return Ok(Step { o: set_switch(o, name), next: at });
  }
  if (eq >= 0) {
    let next = set_value(o, name, flag, slice_unchecked(arg, eq + 1, arg.len()).to_owned())?;
    return Ok(Step { o: next, next: at });
  }
  if (at >= args.len()) {
    return Err(missing(flag));
  }
  let next = set_value(o, name, flag, args[at])?;
  return Ok(Step { o: next, next: at + 1 });
}

// A cluster such as `-in` or `-nA1` at args[at - 1].
function short_flags(o: Options, args: string[], at: i32): Result[Step, string] {
  let arg = args[at - 1];
  let opts = o;
  for j in 1..arg.len() {
    let name = long_name(arg[j]);
    let flag = "-" + slice_unchecked(arg, j, j + 1);
    if (name == "") {
      return Err("unrecognized flag " + flag);
    }
    if (takes_value(name)) {
      if (j + 1 < arg.len()) {
        let next = set_value(opts, name, flag, slice_unchecked(arg, j + 1, arg.len()).to_owned())?;
        return Ok(Step { o: next, next: at });
      }
      if (at >= args.len()) {
        return Err(missing(flag));
      }
      let next = set_value(opts, name, flag, args[at])?;
      return Ok(Step { o: next, next: at + 1 });
    }
    opts = set_switch(opts, name);
  }
  return Ok(Step { o: opts, next: at });
}

// The options of a command line without its program name. The error is the
// message after "rg: ".
pub function parse(args: string[]): Result[Options, string] {
  let o = defaults();
  let positional: string[] = [];
  let flags = true;
  let at = 0;
  while (at < args.len()) {
    let arg = args[at];
    at += 1;
    if (!flags || arg == "-" || !arg.starts_with("-")) {
      positional = positional.append(arg);
    } else if (arg == "--") {
      flags = false;
    } else {
      let step = if (arg.starts_with("--")) { long_flag(o, args, at)? } else { short_flags(o, args, at)? };
      o = step.o;
      at = step.next;
    }
  }
  return with_patterns(o, positional);
}

// Without -e, the first positional argument is the pattern.
function with_patterns(o: Options, positional: string[]): Result[Options, string] {
  if (o.patterns.len() > 0) {
    return Ok(Options { ...o, paths: positional });
  }
  if (positional.len() == 0) {
    return Err("ripgrep requires at least one pattern to execute a search");
  }
  return Ok(Options { ...o, patterns: [positional[0]], paths: positional.drop(1) });
}

// `text` with each metacharacter escaped, for -F.
pub function escape(text: string): string {
  let out = "";
  for i in 0..text.len() {
    if (__memchr(META, text[i] as i32, 0) >= 0) {
      out += "\\";
    }
    out += slice_unchecked(text, i, i + 1);
  }
  return out;
}

// One pattern for std/regex from the -e patterns and the flags.
pub function pattern(o: Options): string {
  let parts: string[] = [];
  for p in o.patterns {
    if (o.fixed) {
      parts = parts.append(escape(p));
    } else {
      parts = parts.append(p);
    }
  }
  let body = parts[0];
  if (parts.len() > 1) {
    body = "(?:" + parts.join(")|(?:") + ")";
  }
  if (o.word) {
    body = "\\b{start-half}(?:" + body + ")\\b{end-half}";
  }
  if (o.ignore_case) {
    body = "(?i)" + body;
  }
  return body;
}

pub function printer(o: Options, tty: boolean): Printer {
  let after = o.after;
  if (after < 0) {
    after = if (o.context < 0) { 0 } else { o.context };
  }
  let before = o.before;
  if (before < 0) {
    before = if (o.context < 0) { 0 } else { o.context };
  }
  let color = o.color == "always" || o.color == "ansi" || o.color == "auto" && tty;
  let show_name = if (o.with_filename < 0) { o.paths.len() > 1 } else { o.with_filename == 1 };
  return Printer {
    mode: o.mode, invert: o.invert, only_matching: o.only_matching, line_number: o.line_number,
    after: after, before: before, color: color, show_name: show_name,
  };
}

function push_path(p: Printer, h: usize, name: string): void {
  if (p.color) {
    buf_push(h, PATH_COLOR);
    buf_push(h, name);
    buf_push(h, RESET);
  } else {
    buf_push(h, name);
  }
}

function push_prefix(p: Printer, h: usize, name: string, ln: i32, sep: string): void {
  if (p.show_name) {
    push_path(p, h, name);
    buf_push(h, sep);
  }
  if (p.line_number) {
    if (p.color) {
      buf_push(h, LINE_COLOR);
      buf_push(h, ln.to_string());
      buf_push(h, RESET);
    } else {
      buf_push(h, ln.to_string());
    }
    buf_push(h, sep);
  }
}

// The next match in `line` at or after `from`. As in ripgrep, an empty match
// that starts where the last match ended does not count.
pub function next_match(re: regex.Regex, line: string, from: i32, last_end: i32): Option[regex.Match] {
  let at = from;
  while (at <= line.len()) {
    let Some(m) = re.find_at(line, at) else {
      return None;
    };
    if (m.start < m.end || m.start != last_end) {
      return Some(m);
    }
    at = m.start + 1;
  }
  return None;
}

function count_matches(re: regex.Regex, line: string): i32 {
  let count = 0;
  let at = 0;
  let last = -1;
  while (true) {
    let Some(m) = next_match(re, line, at, last) else {
      return count;
    };
    count += 1;
    at = m.end;
    last = m.end;
  }
  return count;
}

function push_matched(h: usize, line: string, lo: i32, hi: i32): void {
  buf_push(h, MATCH_COLOR);
  buf_push_range(h, line, lo, hi);
  buf_push(h, RESET);
}

// `line` with each match in color.
function push_colored(re: regex.Regex, h: usize, line: string): void {
  let at = 0;
  let last = -1;
  let done = 0;
  while (true) {
    let Some(m) = next_match(re, line, at, last) else {
      buf_push_range(h, line, done, line.len());
      return;
    };
    if (m.end > m.start) {
      buf_push_range(h, line, done, m.start);
      push_matched(h, line, m.start, m.end);
      done = m.end;
    }
    at = m.end;
    last = m.end;
  }
}

function push_line(p: Printer, re: regex.Regex, h: usize, name: string, ln: i32, sep: string, line: string): void {
  push_prefix(p, h, name, ln, sep);
  if (p.color) {
    push_colored(re, h, line);
  } else {
    buf_push(h, line);
  }
  buf_push(h, "\n");
}

// Each match of a selected line on a line of its own, for -o.
function push_only(p: Printer, re: regex.Regex, h: usize, name: string, ln: i32, line: string): void {
  let at = 0;
  let last = -1;
  while (true) {
    let Some(m) = next_match(re, line, at, last) else {
      return;
    };
    push_prefix(p, h, name, ln, ":");
    if (p.color && m.end > m.start) {
      push_matched(h, line, m.start, m.end);
    } else {
      buf_push_range(h, line, m.start, m.end);
    }
    buf_push(h, "\n");
    at = m.end;
    last = m.end;
  }
}

function line_end(text: string, start: i32): i32 {
  let end = __memchr(text, 10, start);
  if (end < 0) {
    return text.len();
  }
  return end;
}

// The start of the line before the line that starts at `start`.
function previous_line(text: string, start: i32): i32 {
  if (start < 2) {
    return 0;
  }
  return __rmemchr(text, 10, start - 2) + 1;
}

// A line of the text: where it starts, its number, and the next offset at
// which a match can start. A candidate past the end means that no match
// is left.
struct Cursor { start: i32, ln: i32, cand: i32 }

function begin(): Cursor {
  return Cursor { start: 0, ln: 0, cand: -1 };
}

function candidate(re: regex.Regex, text: string, c: Cursor): i32 {
  if (c.cand >= c.start) {
    return c.cand;
  }
  let at = re.next_candidate(text, c.start);
  if (at < 0) {
    return text.len() + 1;
  }
  return at;
}

// The cursor at the line of the next candidate. The lines before it hold no
// match.
function jump(re: regex.Regex, text: string, c: Cursor): Cursor {
  let cand = candidate(re, text, c);
  if (cand > text.len()) {
    return Cursor { start: text.len(), ln: c.ln, cand: cand };
  }
  let start = c.start;
  if (cand > start) {
    start = __rmemchr(text, 10, cand - 1) + 1;
  }
  let skipped = __count_byte(slice_unchecked(text, c.start, start), 10);
  return Cursor { start: start, ln: c.ln + skipped, cand: cand };
}

// Whether the line from `c.start` to `end` is selected. The cursor keeps the
// candidate that it found.
function selected(re: regex.Regex, text: string, c: Cursor, end: i32, invert: boolean): (boolean, Cursor) {
  let cand = candidate(re, text, c);
  let next = Cursor { ...c, cand: cand };
  if (cand > end) {
    return (invert, next);
  }
  return (re.is_match(slice_unchecked(text, c.start, end)) != invert, next);
}

// The cursor at the line after the line that ends at `end`.
function advance(c: Cursor, end: i32): Cursor {
  return Cursor { ...c, start: end + 1, ln: c.ln + 1 };
}

function binary_message(p: Printer, h: usize, name: string, offset: i32): void {
  if (p.show_name) {
    push_path(p, h, name);
    buf_push(h, ": ");
  }
  buf_push(h, "binary file matches (found \"\\0\" byte around offset " + offset.to_string() + ")\n");
}

// The count of the selected lines, or with -o of their matches. The second
// value is false when no line is selected.
function count(p: Printer, re: regex.Regex, text: string): (i32, boolean) {
  let lines = 0;
  let matches = 0;
  let c = begin();
  while (c.start < text.len()) {
    if (!p.invert) {
      c = jump(re, text, c);
      if (c.start >= text.len()) {
        break;
      }
    }
    let end = line_end(text, c.start);
    let (yes, next) = selected(re, text, c, end, p.invert);
    if (yes) {
      lines += 1;
      if (p.only_matching && !p.invert) {
        matches += count_matches(re, slice_unchecked(text, c.start, end));
      }
    }
    c = advance(next, end);
  }
  if (p.only_matching) {
    return (matches, lines > 0);
  }
  return (lines, lines > 0);
}

function any_selected(p: Printer, re: regex.Regex, text: string): boolean {
  let c = begin();
  while (c.start < text.len()) {
    if (!p.invert) {
      c = jump(re, text, c);
      if (c.start >= text.len()) {
        return false;
      }
    }
    let end = line_end(text, c.start);
    let (yes, next) = selected(re, text, c, end, p.invert);
    if (yes) {
      return true;
    }
    c = advance(next, end);
  }
  return false;
}

// Writes the lines before line `ln`, from line `first`, as context.
function push_before(p: Printer, re: regex.Regex, h: usize, name: string, text: string, start: i32, ln: i32, first: i32): void {
  let starts: i32[] = [];
  let at = start;
  for _ in first..ln {
    at = previous_line(text, at);
    starts = starts.append(at);
  }
  let k = starts.len() - 1;
  while (k >= 0) {
    let s = starts[k];
    push_line(p, re, h, name, ln - 1 - k, "-", slice_unchecked(text, s, line_end(text, s)));
    k -= 1;
  }
}

function push_selected(p: Printer, re: regex.Regex, h: usize, name: string, ln: i32, line: string): void {
  if (p.only_matching && !p.invert) {
    push_only(p, re, h, name, ln, line);
  } else {
    push_line(p, re, h, name, ln, ":", line);
  }
}

// The selected lines and their context.
// The context state of a file: the number of the last line written, the
// count of after-context lines still to write, and whether any output is
// written.
struct Group { last: i32, after_left: i32, wrote: boolean }

// Writes a selected line with its before-context, and a separator when the
// line starts a new group.
function push_group(p: Printer, re: regex.Regex, h: usize, name: string, text: string, start: i32, ln: i32, g: Group): Group {
  let first = ln - p.before;
  if (first <= g.last) {
    first = g.last + 1;
  }
  let context = p.after > 0 || p.before > 0;
  if (context && g.wrote && (g.last == 0 || first > g.last + 1)) {
    buf_push(h, "--\n");
  }
  push_before(p, re, h, name, text, start, ln, first);
  push_selected(p, re, h, name, ln, slice_unchecked(text, start, line_end(text, start)));
  return Group { last: ln, after_left: p.after, wrote: true };
}

function search_lines(p: Printer, re: regex.Regex, text: string, name: string, h: usize, written: boolean): Outcome {
  let g = Group { last: 0, after_left: 0, wrote: written };
  let matched = false;
  let c = begin();
  while (c.start < text.len()) {
    if (!p.invert && g.after_left == 0) {
      c = jump(re, text, c);
      if (c.start >= text.len()) {
        break;
      }
    }
    let start = c.start;
    let end = line_end(text, start);
    let ln = c.ln + 1;
    let (yes, next) = selected(re, text, c, end, p.invert);
    c = advance(next, end);
    if (yes) {
      matched = true;
      g = push_group(p, re, h, name, text, start, ln, g);
    } else if (g.after_left > 0) {
      push_line(p, re, h, name, ln, "-", slice_unchecked(text, start, end));
      g = Group { ...g, last: ln, after_left: g.after_left - 1 };
    }
  }
  return Outcome { matched: matched, written: g.wrote };
}

// Searches the text of one file and writes its output to `h`. `written` says
// whether an earlier file wrote output.
pub function search(p: Printer, re: regex.Regex, text: string, name: string, h: usize, written: boolean): Outcome {
  match (p.mode) {
    Files => {
      if (!any_selected(p, re, text)) {
        return Outcome { matched: false, written: written };
      }
      push_path(p, h, name);
      buf_push(h, "\n");
      return Outcome { matched: true, written: true };
    },
    Count => {
      let (n, matched) = count(p, re, text);
      if (!matched) {
        return Outcome { matched: false, written: written };
      }
      if (p.show_name) {
        push_path(p, h, name);
        buf_push(h, ":");
      }
      buf_push(h, n.to_string() + "\n");
      return Outcome { matched: true, written: true };
    },
    Lines => {
      let nul = __memchr(text, 0, 0);
      if (nul < 0) {
        return search_lines(p, re, text, name, h, written);
      }
      if (!any_selected(p, re, text)) {
        return Outcome { matched: false, written: written };
      }
      binary_message(p, h, name, nul);
      return Outcome { matched: true, written: true };
    }
  }
  return Outcome { matched: false, written: written };
}
