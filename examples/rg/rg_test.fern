// The options, the pattern, the ignore rules and the output of the rg port.
import "std/test";
import "std/regex";
import "./flags";
import "./ignore";
import "./search";

function mode_name(m: flags.Mode): string {
  return match (m) {
    flags.Lines => "lines",
    flags.Count => "count",
    flags.CountMatches => "count-matches",
    flags.Files => "files",
    flags.Without => "without",
    flags.List => "list",
    flags.TypeList => "type-list",
  };
}

function switches(o: flags.Options): string {
  let out = "";
  if (o.case == 1) {
    out += "i";
  }
  if (o.has(flags.INVERT)) {
    out += "v";
  }
  if (o.has(flags.WORD)) {
    out += "w";
  }
  if (o.has(flags.FIXED)) {
    out += "F";
  }
  if (o.line_number) {
    out += "n";
  }
  if (o.has(flags.ONLY)) {
    out += "o";
  }
  return out;
}

// The options of `args` in one line, or the error.
function options(args: string[]): string {
  match (flags.parse(args)) {
    Ok(o) => {
      return switches(o) + " " + mode_name(o.mode) + " A" + o.after.to_string() + " B" + o.before.to_string()
        + " C" + o.context.to_string() + " " + o.color + " H" + o.with_filename.to_string() + " j" + o.threads.to_string()
        + " [" + o.patterns.join(",") + "] [" + o.paths.join(",") + "]";
    },
    Err(why) => {
      return "error: " + why;
    }
  }
  return "";
}

function test_parse(): test.TestOutcome {
  let got = [
    options(["foo"]),
    options(["foo", "a", "b"]),
    options(["-inv", "foo", "a"]),
    options(["-nA1", "foo"]),
    options(["-C", "2", "-B0", "x"]),
    options(["--context=3", "--after-context", "1", "x"]),
    options(["-e", "a", "x", "-e", "b", "y"]),
    options(["-efoo", "--regexp=bar"]),
    options(["--", "-foo", "-"]),
    options(["-c", "-l", "x"]),
    options(["-l", "-c", "x"]),
    options(["-n", "-N", "-H", "-I", "x"]),
    options(["--color", "always", "--color=ansi", "-j1", "--threads", "8", "x"]),
    options(["-wFs", "--ignore-case", "--only-matching", "x"]),
  ];
  return test.assert_eq_array(got, [
    " lines A-1 B-1 C-1 auto H-1 j0 [foo] []",
    " lines A-1 B-1 C-1 auto H-1 j0 [foo] [a,b]",
    "ivn lines A-1 B-1 C-1 auto H-1 j0 [foo] [a]",
    "n lines A1 B-1 C-1 auto H-1 j0 [foo] []",
    " lines A-1 B0 C2 auto H-1 j0 [x] []",
    " lines A1 B-1 C3 auto H-1 j0 [x] []",
    " lines A-1 B-1 C-1 auto H-1 j0 [a,b] [x,y]",
    " lines A-1 B-1 C-1 auto H-1 j0 [foo,bar] []",
    " lines A-1 B-1 C-1 auto H-1 j0 [-foo] [-]",
    " files A-1 B-1 C-1 auto H-1 j0 [x] []",
    " count A-1 B-1 C-1 auto H-1 j0 [x] []",
    " lines A-1 B-1 C-1 auto H0 j0 [x] []",
    " lines A-1 B-1 C-1 ansi H-1 j8 [x] []",
    "iwFo lines A-1 B-1 C-1 auto H-1 j0 [x] []",
  ]);
}

function test_parse_errors(): test.TestOutcome {
  let got = [
    options([]),
    options(["-n"]),
    options(["-Z", "x"]),
    options(["--bogus=1", "x"]),
    options(["--count=1", "x"]),
    options(["-A"]),
    options(["x", "--color"]),
    options(["-A", "x", "y"]),
    options(["-C1foo", "y"]),
    options(["--after-context", "", "y"]),
    options(["-B", "99999999999999999999", "y"]),
    options(["--color=bogus", "y"]),
  ];
  return test.assert_eq_array(got, [
    "error: ripgrep requires at least one pattern to execute a search",
    "error: ripgrep requires at least one pattern to execute a search",
    "error: unrecognized flag -Z",
    "error: unrecognized flag --bogus",
    "error: invalid CLI arguments: unexpected argument for option '--count': \"1\"",
    "error: missing value for flag -A: missing argument for option '-A'",
    "error: missing value for flag --color: missing argument for option '--color'",
    "error: error parsing flag -A: value is not a valid number: invalid digit found in string",
    "error: error parsing flag -C: value is not a valid number: invalid digit found in string",
    "error: error parsing flag --after-context: value is not a valid number: cannot parse integer from empty string",
    "error: error parsing flag -B: value is not a valid number: number too large to fit in target type",
    "error: error parsing flag --color: choice 'bogus' is unrecognized",
  ]);
}

function pattern_of(args: string[]): string {
  let Ok(o) = flags.parse(args) else {
    return "error";
  };
  return flags.pattern(o);
}

function test_pattern(): test.TestOutcome {
  let got = [
    pattern_of(["a.b"]),
    pattern_of(["-F", "a.b(c)|[d]{2}^$*+?\\"]),
    pattern_of(["-e", "a", "-e", "b"]),
    pattern_of(["-w", "-e", "a", "-e", "b"]),
    pattern_of(["-iwF", "x.y"]),
  ];
  return test.assert_eq_array(got, [
    "a.b",
    "a\\.b\\(c\\)\\|\\[d\\]\\{2\\}\\^\\$\\*\\+\\?\\\\",
    "(?:a)|(?:b)",
    "\\b{start-half}(?:(?:a)|(?:b))\\b{end-half}",
    "(?i)\\b{start-half}(?:x\\.y)\\b{end-half}",
  ]);
}

// The context, the file names and the color that `args` give.
function printer_of(args: string[], tty: boolean): string {
  let Ok(o) = flags.parse(args) else {
    return "error";
  };
  let p = search.printer(o, tty, o.paths.len() <= 1);
  return "A" + p.after.to_string() + " B" + p.before.to_string() + " names " + p.show_name.to_string() + " color " + p.color.to_string();
}

function test_printer(): test.TestOutcome {
  let got = [
    printer_of(["-C2", "-A0", "x", "a", "b"], false),
    printer_of(["--color", "auto", "x", "a"], true),
    printer_of(["--color", "auto", "x", "a"], false),
    printer_of(["--color", "never", "-H", "x", "a"], true),
    printer_of(["-I", "-B3", "x", "a", "b"], false),
  ];
  return test.assert_eq_array(got, [
    "A0 B2 names true color false",
    "A0 B0 names false color true",
    "A0 B0 names false color false",
    "A0 B0 names true color false",
    "A0 B3 names false color false",
  ]);
}

// The output of rg with `args` on a file `a` that holds `text`, then the
// exit status that the outcome gives.
function run(args: string[], text: string): string {
  return run_from(args, text, MAPPED);
}

// A file on the command line that ripgrep maps into memory.
const MAPPED: search.Source = search.Source { mapped: true, detect: search.DETECT_CONVERT, cap: search.BUFFER };

// The output of rg with `args` on a file `a` that holds `text` and that
// ripgrep reads from `src`, then the exit status.
function run_from(args: string[], text: string, src: search.Source): string {
  let Ok(o) = flags.parse(args) else {
    return "error";
  };
  let Ok(re) = regex.compile(flags.pattern(o)) else {
    return "bad pattern";
  };
  let p = search.printer(o, false, o.paths.len() <= 1);
  let h = buf_new(256);
  let first = search.search(p, re, text, "a", src, h, false);
  let out = buf_take(h);
  buf_free(h);
  if (first.matched) {
    return out + "0";
  }
  return out + "1";
}

const TEXT: string = "alpha beta\ngamma foo\nfoo bar foo\nnothing here\nFoo again\nlast foo";

function test_lines(): test.TestOutcome {
  let got = [
    run(["foo", "a"], TEXT),
    run(["-n", "foo", "a", "b"], TEXT),
    run(["-v", "foo", "a"], TEXT),
    run(["-i", "-w", "foo", "a"], "foobar\nFOO!\n"),
    run(["zzz", "a"], TEXT),
    run(["foo", "a"], ""),
    run(["two", "a"], "one\r\ntwo\r\n"),
  ];
  return test.assert_eq_array(got, [
    "gamma foo\nfoo bar foo\nlast foo\n0",
    "a:2:gamma foo\na:3:foo bar foo\na:6:last foo\n0",
    "alpha beta\nnothing here\nFoo again\n0",
    "FOO!\n0",
    "1",
    "1",
    "two\r\n0",
  ]);
}

function test_only_matching(): test.TestOutcome {
  let got = [
    run(["-o", "-n", "o+", "a"], "foo bar\nxo\n"),
    run(["-o", "x*", "a"], "axb\n"),
    run(["-ov", "foo", "a"], "foo\nbar\n"),
  ];
  return test.assert_eq_array(got, ["1:oo\n2:o\n0", "\nx\n\n0", "bar\n0"]);
}

function test_counts(): test.TestOutcome {
  let got = [
    run(["-c", "foo", "a"], TEXT),
    run(["-c", "foo", "a", "b"], TEXT),
    run(["-co", "foo", "a"], TEXT),
    run(["-cv", "foo", "a"], TEXT),
    run(["-cov", "foo", "a"], TEXT),
    run(["-c", "zzz", "a", "b"], TEXT),
    run(["-l", "foo", "a"], TEXT),
    run(["-lv", "foo", "a"], "foo\n"),
  ];
  return test.assert_eq_array(got, ["3\n0", "a:3\n0", "4\n0", "3\n0", "0\n0", "1", "a\n0", "1"]);
}

function test_context(): test.TestOutcome {
  let got = [
    run(["-n", "-A1", "foo", "a"], TEXT),
    run(["-B1", "Foo", "a"], TEXT),
    run(["-C1", "-n", "nothing", "a", "b"], TEXT),
    run(["-C0", "foo", "a"], TEXT),
    run(["-B1", "-o", "-n", "foo", "a"], TEXT),
  ];
  return test.assert_eq_array(got, [
    "2:gamma foo\n3:foo bar foo\n4-nothing here\n--\n6:last foo\n0",
    "nothing here\nFoo again\n0",
    "a-3-foo bar foo\na:4:nothing here\na-5-Foo again\n0",
    "gamma foo\nfoo bar foo\nlast foo\n0",
    "1-alpha beta\n2:foo\n3:foo\n3:foo\n--\n5-Foo again\n6:foo\n0",
  ]);
}

function test_separator_between_files(): test.TestOutcome {
  let Ok(o) = flags.parse(["-A1", "foo", "a", "b"]) else {
    return test.fail("parse");
  };
  let Ok(re) = regex.compile(flags.pattern(o)) else {
    return test.fail("bad pattern");
  };
  let p = search.printer(o, false, false);
  let h = buf_new(256);
  let first = search.search(p, re, "x\n", "a", MAPPED, h, false);
  let second = search.search(p, re, "foo\nbar\n", "b", MAPPED, h, first.written);
  let third = search.search(p, re, "foo\n", "c", MAPPED, h, second.written);
  let out = buf_take(h);
  buf_free(h);
  return test.assert_true(!first.matched && second.matched && third.written && out == "b:foo\nb-bar\n--\nc:foo\n");
}

function test_color(): test.TestOutcome {
  let got = [
    run(["--color", "always", "-n", "foo", "a", "b"], "a foo foo\n"),
    run(["--color=always", "-o", "o+", "a"], "foo\n"),
    run(["--color=always", "-c", "foo", "a", "b"], "foo\n"),
    run(["--color=always", "x*", "a"], "axb\n"),
  ];
  return test.assert_eq_array(got, [
    "\x1b[0m\x1b[35ma\x1b[0m:\x1b[0m\x1b[32m1\x1b[0m:a \x1b[0m\x1b[1m\x1b[31mfoo\x1b[0m \x1b[0m\x1b[1m\x1b[31mfoo\x1b[0m\n0",
    "\x1b[0m\x1b[1m\x1b[31moo\x1b[0m\n0",
    "\x1b[0m\x1b[35ma\x1b[0m:1\n0",
    "a\x1b[0m\x1b[1m\x1b[31mx\x1b[0mb\n0",
  ]);
}

function test_binary(): test.TestOutcome {
  let got = [
    run(["foo", "a"], "foo\nab\x00c\n"),
    run(["-H", "foo", "a"], "ab\x00c foo\n"),
    run(["-c", "foo", "a"], "foo\x00foo\nfoo\n"),
    run(["zzz", "a"], "a\x00b\n"),
    run(["-v", "foo", "a"], "a\x00foo\n"),
  ];
  return test.assert_eq_array(got, [
    "binary file matches (found \"\\0\" byte around offset 6)\n0",
    "a: binary file matches (found \"\\0\" byte around offset 2)\n0",
    "2\n0",
    "1",
    "1",
  ]);
}

// The walk options of `args` in one line, or the error.
function walk_options(args: string[]): string {
  match (flags.parse(args)) {
    Ok(o) => {
      let bits = "";
      for b in 0..21 {
        bits += if (o.has(b)) { "1" } else { "0" };
      }
      return f"{mode_name(o.mode)} {bits} case{o.case} m{o.max_count} d{o.max_depth} u{o.unrestricted} bin{o.binary} mmap{o.mmap} head{o.heading} sort[{o.sort}{if (o.sort_reverse) { "r" } else { "" }}] sep[{o.path_separator}] g[{o.globs.join(",")}] ig[{o.iglobs.join(",")}] t[{o.types.join(",")}] f[{o.ignore_files.join(",")}] p[{o.patterns.join(",")}] [{o.paths.join(",")}]";
    },
    Err(why) => {
      return "error: " + why;
    }
  }
  return "";
}

function test_parse_walk(): test.TestOutcome {
  let got = [
    walk_options(["--hidden", "-L", "x"]),
    walk_options(["-uuu", "x"]),
    walk_options(["--no-ignore", "--ignore-vcs", "x"]),
    walk_options(["-g", "*.rs", "--glob=!t/**", "--iglob", "*.C", "-tRust", "-T", "c", "--type-add", "a:*.a", "--type-clear", "b", "x"]),
    walk_options(["--sort", "path", "--sortr=modified", "-m1", "-d", "2", "x"]),
    walk_options(["--sort-files", "--maxdepth", "3", "--sort", "none", "x"]),
    walk_options(["--files", "--null", "-q", "-x", "dir"]),
    walk_options(["--files-without-match", "--heading", "--no-heading", "--mmap", "--no-mmap", "x"]),
    walk_options(["-a", "--binary", "--path-separator", "\\", "--ignore-file", "i", "-S", "x"]),
    walk_options(["--type-list"]),
    walk_options(["--count-matches", "-v", "x"]),
    walk_options(["-c", "-o", "x"]),
  ];
  return test.assert_eq_array(got, [
    "lines 000011000000000000000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[x] []",
    "lines 000010111110000000000 case0 m-1 d-1 u3 bin1 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[x] []",
    "lines 000000101110000000000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[x] []",
    "lines 000000000000000000000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[*.rs,!t/**] ig[*.C] t[+Rust,-c,add:a:*.a,clear:b] f[] p[x] []",
    "lines 000000000000000000000 case0 m1 d2 u0 bin0 mmap-1 head-1 sort[modifiedr] sep[] g[] ig[] t[] f[] p[x] []",
    "lines 000000000000000000000 case0 m-1 d3 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[x] []",
    "list 000000000000011100000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[] [dir]",
    "without 000000000000000000000 case0 m-1 d-1 u0 bin0 mmap0 head0 sort[] sep[] g[] ig[] t[] f[] p[x] []",
    "lines 000000000000000000000 case2 m-1 d-1 u0 bin1 mmap-1 head-1 sort[] sep[\\] g[] ig[] t[] f[i] p[x] []",
    "type-list 000000000000000000000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[] []",
    "count 100000000000000000000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[x] []",
    "count-matches 000100000000000000000 case0 m-1 d-1 u0 bin0 mmap-1 head-1 sort[] sep[] g[] ig[] t[] f[] p[x] []",
  ]);
}

function test_parse_walk_errors(): test.TestOutcome {
  let got = [
    walk_options(["-uuuu", "x"]),
    walk_options(["--sort", "size", "x"]),
    walk_options(["--sortr"]),
    walk_options(["--path-separator", "ab", "x"]),
    walk_options(["-m", "x", "y"]),
    walk_options(["--hidden=1", "x"]),
    walk_options(["--max-depth=-1", "x"]),
  ];
  return test.assert_eq_array(got, [
    "error: error parsing flag -u: flag can only be repeated up to 3 times",
    "error: error parsing flag --sort: choice 'size' is unrecognized",
    "error: missing value for flag --sortr: missing argument for option '--sortr'",
    "error: error parsing flag --path-separator: A path separator must be exactly one byte, but the given separator is 2 bytes: ab\nIn some shells on Windows '/' is automatically expanded. Use '//' instead.",
    "error: error parsing flag -m: value is not a valid number: invalid digit found in string",
    "error: invalid CLI arguments: unexpected argument for option '--hidden': \"1\"",
    "error: error parsing flag --max-depth: value is not a valid number: invalid digit found in string",
  ]);
}

function test_smart_case(): test.TestOutcome {
  let got = [
    pattern_of(["-S", "foo"]),
    pattern_of(["-S", "Foo"]),
    pattern_of(["-S", "\\Wfoo"]),
    pattern_of(["-S", "-e", "a", "-e", "B"]),
    pattern_of(["-S", "-i", "Foo"]),
    pattern_of(["-x", "a|b"]),
  ];
  return test.assert_eq_array(got, ["(?i)foo", "Foo", "(?i)\\Wfoo", "(?:a)|(?:B)", "(?i)Foo", "^(?:a|b)$"]);
}

// The answers of the rules of `text`, from the root `root`, for each path.
// A path that ends with `/` is a directory.
function answers(root: string, text: string, paths: string[]): string {
  let l = ignore.parse(root, text, false, "gi");
  let out = "";
  for p in paths {
    let dir = p.ends_with("/");
    let path = if (dir) { slice_unchecked(p, 0, p.len() - 1).to_owned() } else { p };
    out += ["-", "I", "K"][l.m.matched(path, dir)];
  }
  return out + " " + l.errors.join(";");
}

function test_gitignore(): test.TestOutcome {
  let got = [
    answers("./", "*.log\n!keep.log\n", ["a.log", "keep.log", "d/a.log", "a.txt"]),
    answers("./", "/build/\n", ["build/", "build", "src/build/", "build/x"]),
    answers("./", "doc/*.txt\n", ["doc/a.txt", "doc/x/a.txt", "x/doc/a.txt"]),
    answers("./", "**/foo\nbar/**\n", ["foo", "x/y/foo", "bar", "bar/a", "bar/a/b"]),
    answers("./", "\\#x\n\\!y\n# z\n#w\n", ["#x", "!y", "# z", "#w"]),
    answers("./", "a  \nb\\ \n", ["a", "b ", "b"]),
    answers("sub", "x/y\n", ["sub/x/y", "x/y", "subx/y"]),
    answers("./", "a[\nok\n{b\n", ["ok", "a["]),
    answers("./", "\u{FEFF}bom\r\ncr\r\n", ["bom", "cr"]),
  ];
  return test.assert_eq_array(got, [
    "IKI- ",
    "I--- ",
    "I-- ",
    "II-II ",
    "II-- ",
    "II- ",
    "III ",
    "I- gi: line 1: error parsing glob 'a[': unclosed character class; missing ']';gi: line 3: error parsing glob '{b': unclosed alternate group; missing '}' (maybe escape '{' with '[{]'?)",
    "II ",
  ]);
}

function test_overrides(): test.TestOutcome {
  let Ok(keep) = ignore.overrides("/w", ["*.rs", "!t/**"], ["*.C"], false) else {
    return test.fail("globs");
  };
  let Ok(skip) = ignore.overrides("/w", ["!*.rs"], [], false) else {
    return test.fail("negated globs");
  };
  let got = [
    keep.override("src/a.rs", false),
    keep.override("t/a.rs", false),
    keep.override("a.c", false),
    keep.override("b.txt", false),
    keep.override("src", true),
    skip.override("a.rs", false),
    skip.override("a.txt", false),
  ];
  let bad = match (ignore.overrides("/w", ["["], [], false)) {
    Ok(_) => "",
    Err(why) => why,
  };
  return test.assert_true(got == [ignore.KEEP, ignore.IGNORE, ignore.KEEP, ignore.IGNORE, ignore.NONE, ignore.IGNORE, ignore.NONE]
    && bad == "error parsing glob '[': unclosed character class; missing ']'");
}

function type_answers(changes: string[], paths: string[]): string {
  match (ignore.build_types(changes)) {
    Ok(t) => {
      let out = "";
      for p in paths {
        out += ["-", "I", "K"][t.matched(p, false)];
      }
      return out;
    },
    Err(why) => {
      return why;
    }
  }
  return "";
}

function test_types(): test.TestOutcome {
  let Ok(all) = ignore.build_types([]) else {
    return test.fail("defaults");
  };
  let rust: string[] = [];
  for line in all.listing() {
    if (line.starts_with("rust:")) {
      rust = rust.append(line);
    }
  }
  let got = [
    type_answers(["+rust"], ["src/a.rs", "a.c", "Makefile"]),
    type_answers(["-rust"], ["src/a.rs", "a.c"]),
    type_answers(["+c", "-c"], ["a.c", "a.h"]),
    type_answers(["+make", "+c"], ["Makefile", "x/GNUmakefile", "a.c", "a.rs"]),
    type_answers(["add:foo:*.foo", "+foo"], ["a.foo", "a.bar"]),
    type_answers(["add:foo:*.foo", "add:both:include:foo,rust", "+both"], ["a.foo", "a.rs", "a.c"]),
    type_answers(["clear:rust", "+rust"], ["a.rs"]),
    type_answers(["+nosuch"], ["a"]),
    type_answers(["add:foo"], ["a"]),
    type_answers(["add:all:*.x"], ["a"]),
    type_answers(["add:x:include:nosuch"], ["a"]),
  ];
  return test.assert_eq_array(rust.concat(got), [
    "rust: *.rs", "KII", "I-", "II", "KKKI", "KI", "KKI",
    "unrecognized file type: rust", "unrecognized file type: nosuch",
    "invalid definition (format is type:glob, e.g., html:*.html)",
    "invalid definition (format is type:glob, e.g., html:*.html)",
    "invalid definition (format is type:glob, e.g., html:*.html)",
  ]);
}

// A level of the directory `dir` with the rules of three ignore files.
function level_of(dir: string, custom: string, dot: string, git: string, has_git: boolean): ignore.Level {
  return ignore.Level {
    dir: dir, custom: ignore.parse(dir, custom, false, "r").m, dot: ignore.parse(dir, dot, false, "d").m,
    git: ignore.parse(dir, git, false, "g").m, exclude: ignore.empty(dir), has_git: has_git, absolute: false,
  };
}

function walk_config(require_git: boolean, skip_hidden: boolean): ignore.Config {
  let none = ignore.empty("/w");
  let types = match (ignore.build_types([])) {
    Ok(t) => t,
    Err(_) => {
      return walk_config(require_git, skip_hidden);
    },
  };
  let explicit: ignore.Matcher[] = [];
  return ignore.Config {
    skip_hidden: skip_hidden, dot: true, vcs: true, exclude: true, global: true, parents: true,
    require_git: require_git, ci: false, overrides: none, types: types, explicit: explicit, global_rules: ignore.empty(""),
  };
}

// The precedence of the ignore files: .rgignore over .ignore over
// .gitignore, an inner directory over an outer one, and .gitignore only in
// a git repository and not above its root.
function test_precedence(): test.TestOutcome {
  let outer = level_of("./", "", "", "*.a\n*.c\n", true);
  let inner = level_of("./sub", "!x.b\n", "*.b\n!y.a\n", "!*.c\n", false);
  let stack = ignore.Stack { levels: [outer, inner], base: "" };
  let cfg = walk_config(true, true);
  let got = [
    ignore.verdict(stack, cfg, "./sub/z.a", false),
    ignore.verdict(stack, cfg, "./sub/y.a", false),
    ignore.verdict(stack, cfg, "./sub/z.b", false),
    ignore.verdict(stack, cfg, "./sub/x.b", false),
    ignore.verdict(stack, cfg, "./sub/z.c", false),
    ignore.verdict(stack, cfg, "./sub/.h", false),
    ignore.verdict(stack, walk_config(true, false), "./sub/.h", false),
  ];
  let repo = ignore.Stack { levels: [level_of("./", "", "", "*.a\n", false), level_of("./sub", "", "", "", true)], base: "" };
  let plain = ignore.Stack { levels: [level_of("./", "", "", "*.a\n", false), level_of("./sub", "", "", "", false)], base: "" };
  let git = [
    ignore.verdict(repo, cfg, "./sub/z.a", false),
    ignore.verdict(plain, cfg, "./sub/z.a", false),
    ignore.verdict(plain, walk_config(false, true), "./sub/z.a", false),
    ignore.verdict(ignore.Stack { levels: [outer], base: "" }, cfg, "./.y.a", false),
  ];
  return test.assert_eq_array(got.concat(git), [
    ignore.IGNORE, ignore.KEEP, ignore.IGNORE, ignore.KEEP, ignore.KEEP, ignore.IGNORE, ignore.NONE,
    ignore.NONE, ignore.NONE, ignore.IGNORE, ignore.IGNORE,
  ]);
}

function test_max_count(): test.TestOutcome {
  let text = "a1\na2\nb\na3\nc\nd\n";
  let got = [
    run(["-n", "-m1", "-A2", "a", "a"], text),
    run(["-n", "-m2", "-A3", "a", "a"], text),
    run(["-m1", "-c", "a", "a"], text),
    run(["-m1", "-v", "a", "a"], text),
    run(["-m2", "-l", "a", "a"], text),
  ];
  return test.assert_eq_array(got, ["1:a1\n2:a2\n3-b\n0", "1:a1\n2:a2\n3-b\n4:a3\n5-c\n0", "1\n0", "b\n0", "a\n0"]);
}

function test_heading_and_null(): test.TestOutcome {
  let text = "foo\nbar\nfoo\n";
  let got = [
    run(["--heading", "-n", "foo", "a", "b"], text),
    run(["--heading", "foo", "a"], text),
    run(["--null", "-n", "foo", "a", "b"], text),
    run(["--null", "--heading", "foo", "a", "b"], text),
    run(["--null", "-l", "foo", "a", "b"], text),
    run(["--null", "-c", "foo", "a", "b"], text),
    run(["--files-without-match", "zzz", "a", "b"], text),
    run(["--files-without-match", "foo", "a", "b"], text),
    run(["-q", "foo", "a"], text),
    run(["--path-separator", "\\", "-c", "foo", "a", "b"], text),
  ];
  return test.assert_eq_array(got, [
    "a\n1:foo\n3:foo\n0", "foo\nfoo\n0", "a\x001:foo\na\x003:foo\n0", "a\x00foo\nfoo\n0", "a\x000", "a\x002\n0",
    "a\n0", "1", "0", "a:2\n0",
  ]);
}

// A text of more than 64 KiB with a NUL byte after the first buffer.
function late_nul(): string {
  let text = "foo first\n";
  while (text.len() < 70000) {
    text += "filler line of text\n";
  }
  return text + "a\x00b\nfoo last\n";
}

function test_binary_buffers(): test.TestOutcome {
  let text = late_nul();
  let read = search.Source { mapped: false, detect: search.DETECT_CONVERT, cap: search.BUFFER };
  let walked = search.Source { mapped: false, detect: search.DETECT_QUIT, cap: search.BUFFER };
  let grown = search.Source { ...walked, cap: search.BUFFER * 3 };
  let got = [
    run(["foo", "a"], text),
    run_from(["foo", "a"], text, read),
    run_from(["foo", "a"], text, walked),
    run_from(["-c", "foo", "a"], text, walked),
    run_from(["-l", "foo", "a"], text, walked),
    run_from(["foo", "a"], text, grown),
    run_from(["-c", "foo", "a"], text, read),
  ];
  let at = (text.len() - 12).to_string();
  return test.assert_eq_array(got, [
    "foo first\nfoo last\n0",
    "foo first\nbinary file matches (found \"\\0\" byte around offset " + at + ")\n0",
    "foo first\nWARNING: stopped searching binary file after match (found \"\\0\" byte around offset " + at + ")\n0",
    "1",
    "a\n0",
    "1",
    "2\n0",
  ]);
}

function main(): i32 {
  let r = test.new("rg");
  r = r.it("parse walk flags", test_parse_walk);
  r = r.it("parse walk flag errors", test_parse_walk_errors);
  r = r.it("smart case and line regexp", test_smart_case);
  r = r.it("gitignore rules", test_gitignore);
  r = r.it("globs", test_overrides);
  r = r.it("types", test_types);
  r = r.it("ignore precedence", test_precedence);
  r = r.it("max count", test_max_count);
  r = r.it("heading and null", test_heading_and_null);
  r = r.it("binary buffers", test_binary_buffers);
  r = r.it("parse", test_parse);
  r = r.it("parse errors", test_parse_errors);
  r = r.it("pattern", test_pattern);
  r = r.it("printer", test_printer);
  r = r.it("lines", test_lines);
  r = r.it("only matching", test_only_matching);
  r = r.it("counts", test_counts);
  r = r.it("context", test_context);
  r = r.it("separator between files", test_separator_between_files);
  r = r.it("color", test_color);
  r = r.it("binary", test_binary);
  return r.finish();
}
