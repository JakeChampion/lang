// The options, the pattern and the output of the rg port.
import "std/test";
import "std/regex";
import "./search";

function mode_name(m: search.Mode): string {
  match (m) {
    search.Lines => {
      return "lines";
    },
    search.Count => {
      return "count";
    },
    search.Files => {
      return "files";
    }
  }
  return "";
}

function flags(o: search.Options): string {
  let out = "";
  if (o.ignore_case) {
    out += "i";
  }
  if (o.invert) {
    out += "v";
  }
  if (o.word) {
    out += "w";
  }
  if (o.fixed) {
    out += "F";
  }
  if (o.line_number) {
    out += "n";
  }
  if (o.only_matching) {
    out += "o";
  }
  return out;
}

// The options of `args` in one line, or the error.
function options(args: string[]): string {
  match (search.parse(args)) {
    Ok(o) => {
      return flags(o) + " " + mode_name(o.mode) + " A" + o.after.to_string() + " B" + o.before.to_string()
        + " C" + o.context.to_string() + " " + o.color + " H" + o.with_filename.to_string() + " j" + o.threads.to_string()
        + " [" + o.patterns.join(",") + "] [" + o.paths.join(",") + "]";
    },
    Err(why) => {
      return "error: " + why;
    }
  }
  return "";
}

function test_parse(): test.TestOutcome {
  let got = [
    options(["foo"]),
    options(["foo", "a", "b"]),
    options(["-inv", "foo", "a"]),
    options(["-nA1", "foo"]),
    options(["-C", "2", "-B0", "x"]),
    options(["--context=3", "--after-context", "1", "x"]),
    options(["-e", "a", "x", "-e", "b", "y"]),
    options(["-efoo", "--regexp=bar"]),
    options(["--", "-foo", "-"]),
    options(["-c", "-l", "x"]),
    options(["-l", "-c", "x"]),
    options(["-n", "-N", "-H", "-I", "x"]),
    options(["--color", "always", "--color=ansi", "-j1", "--threads", "8", "x"]),
    options(["-wFs", "--ignore-case", "--only-matching", "x"]),
  ];
  return test.assert_eq_array(got, [
    " lines A-1 B-1 C-1 auto H-1 j0 [foo] []",
    " lines A-1 B-1 C-1 auto H-1 j0 [foo] [a,b]",
    "ivn lines A-1 B-1 C-1 auto H-1 j0 [foo] [a]",
    "n lines A1 B-1 C-1 auto H-1 j0 [foo] []",
    " lines A-1 B0 C2 auto H-1 j0 [x] []",
    " lines A1 B-1 C3 auto H-1 j0 [x] []",
    " lines A-1 B-1 C-1 auto H-1 j0 [a,b] [x,y]",
    " lines A-1 B-1 C-1 auto H-1 j0 [foo,bar] []",
    " lines A-1 B-1 C-1 auto H-1 j0 [-foo] [-]",
    " files A-1 B-1 C-1 auto H-1 j0 [x] []",
    " count A-1 B-1 C-1 auto H-1 j0 [x] []",
    " lines A-1 B-1 C-1 auto H0 j0 [x] []",
    " lines A-1 B-1 C-1 ansi H-1 j8 [x] []",
    "iwFo lines A-1 B-1 C-1 auto H-1 j0 [x] []",
  ]);
}

function test_parse_errors(): test.TestOutcome {
  let got = [
    options([]),
    options(["-n"]),
    options(["-Z", "x"]),
    options(["--bogus=1", "x"]),
    options(["--count=1", "x"]),
    options(["-A"]),
    options(["x", "--color"]),
    options(["-A", "x", "y"]),
    options(["-C1foo", "y"]),
    options(["--after-context", "", "y"]),
    options(["-B", "99999999999999999999", "y"]),
    options(["--color=bogus", "y"]),
  ];
  return test.assert_eq_array(got, [
    "error: ripgrep requires at least one pattern to execute a search",
    "error: ripgrep requires at least one pattern to execute a search",
    "error: unrecognized flag -Z",
    "error: unrecognized flag --bogus",
    "error: invalid CLI arguments: unexpected argument for option '--count': \"1\"",
    "error: missing value for flag -A: missing argument for option '-A'",
    "error: missing value for flag --color: missing argument for option '--color'",
    "error: error parsing flag -A: value is not a valid number: invalid digit found in string",
    "error: error parsing flag -C: value is not a valid number: invalid digit found in string",
    "error: error parsing flag --after-context: value is not a valid number: cannot parse integer from empty string",
    "error: error parsing flag -B: value is not a valid number: number too large to fit in target type",
    "error: error parsing flag --color: choice 'bogus' is unrecognized",
  ]);
}

function pattern_of(args: string[]): string {
  let Ok(o) = search.parse(args) else {
    return "error";
  };
  return search.pattern(o);
}

function test_pattern(): test.TestOutcome {
  let got = [
    pattern_of(["a.b"]),
    pattern_of(["-F", "a.b(c)|[d]{2}^$*+?\\"]),
    pattern_of(["-e", "a", "-e", "b"]),
    pattern_of(["-w", "-e", "a", "-e", "b"]),
    pattern_of(["-iwF", "x.y"]),
  ];
  return test.assert_eq_array(got, [
    "a.b",
    "a\\.b\\(c\\)\\|\\[d\\]\\{2\\}\\^\\$\\*\\+\\?\\\\",
    "(?:a)|(?:b)",
    "\\b{start-half}(?:(?:a)|(?:b))\\b{end-half}",
    "(?i)\\b{start-half}(?:x\\.y)\\b{end-half}",
  ]);
}

// The context, the file names and the color that `args` give.
function printer_of(args: string[], tty: boolean): string {
  let Ok(o) = search.parse(args) else {
    return "error";
  };
  let p = search.printer(o, tty);
  return "A" + p.after.to_string() + " B" + p.before.to_string() + " names " + p.show_name.to_string() + " color " + p.color.to_string();
}

function test_printer(): test.TestOutcome {
  let got = [
    printer_of(["-C2", "-A0", "x", "a", "b"], false),
    printer_of(["--color", "auto", "x", "a"], true),
    printer_of(["--color", "auto", "x", "a"], false),
    printer_of(["--color", "never", "-H", "x", "a"], true),
    printer_of(["-I", "-B3", "x", "a", "b"], false),
  ];
  return test.assert_eq_array(got, [
    "A0 B2 names true color false",
    "A0 B0 names false color true",
    "A0 B0 names false color false",
    "A0 B0 names true color false",
    "A0 B3 names false color false",
  ]);
}

// The output of rg with `args` on a file `a` that holds `text`, then the
// exit status that the outcome gives.
function run(args: string[], text: string): string {
  let Ok(o) = search.parse(args) else {
    return "error";
  };
  let Ok(re) = regex.compile(search.pattern(o)) else {
    return "bad pattern";
  };
  let p = search.printer(o, false);
  let h = buf_new(256);
  let first = search.search(p, re, text, "a", h, false);
  let out = buf_take(h);
  buf_free(h);
  if (first.matched) {
    return out + "0";
  }
  return out + "1";
}

const TEXT: string = "alpha beta\ngamma foo\nfoo bar foo\nnothing here\nFoo again\nlast foo";

function test_lines(): test.TestOutcome {
  let got = [
    run(["foo", "a"], TEXT),
    run(["-n", "foo", "a", "b"], TEXT),
    run(["-v", "foo", "a"], TEXT),
    run(["-i", "-w", "foo", "a"], "foobar\nFOO!\n"),
    run(["zzz", "a"], TEXT),
    run(["foo", "a"], ""),
    run(["two", "a"], "one\r\ntwo\r\n"),
  ];
  return test.assert_eq_array(got, [
    "gamma foo\nfoo bar foo\nlast foo\n0",
    "a:2:gamma foo\na:3:foo bar foo\na:6:last foo\n0",
    "alpha beta\nnothing here\nFoo again\n0",
    "FOO!\n0",
    "1",
    "1",
    "two\r\n0",
  ]);
}

function test_only_matching(): test.TestOutcome {
  let got = [
    run(["-o", "-n", "o+", "a"], "foo bar\nxo\n"),
    run(["-o", "x*", "a"], "axb\n"),
    run(["-ov", "foo", "a"], "foo\nbar\n"),
  ];
  return test.assert_eq_array(got, ["1:oo\n2:o\n0", "\nx\n\n0", "bar\n0"]);
}

function test_counts(): test.TestOutcome {
  let got = [
    run(["-c", "foo", "a"], TEXT),
    run(["-c", "foo", "a", "b"], TEXT),
    run(["-co", "foo", "a"], TEXT),
    run(["-cv", "foo", "a"], TEXT),
    run(["-cov", "foo", "a"], TEXT),
    run(["-c", "zzz", "a", "b"], TEXT),
    run(["-l", "foo", "a"], TEXT),
    run(["-lv", "foo", "a"], "foo\n"),
  ];
  return test.assert_eq_array(got, ["3\n0", "a:3\n0", "4\n0", "3\n0", "0\n0", "1", "a\n0", "1"]);
}

function test_context(): test.TestOutcome {
  let got = [
    run(["-n", "-A1", "foo", "a"], TEXT),
    run(["-B1", "Foo", "a"], TEXT),
    run(["-C1", "-n", "nothing", "a", "b"], TEXT),
    run(["-C0", "foo", "a"], TEXT),
    run(["-B1", "-o", "-n", "foo", "a"], TEXT),
  ];
  return test.assert_eq_array(got, [
    "2:gamma foo\n3:foo bar foo\n4-nothing here\n--\n6:last foo\n0",
    "nothing here\nFoo again\n0",
    "a-3-foo bar foo\na:4:nothing here\na-5-Foo again\n0",
    "gamma foo\nfoo bar foo\nlast foo\n0",
    "1-alpha beta\n2:foo\n3:foo\n3:foo\n--\n5-Foo again\n6:foo\n0",
  ]);
}

function test_separator_between_files(): test.TestOutcome {
  let Ok(o) = search.parse(["-A1", "foo", "a", "b"]) else {
    return test.fail("parse");
  };
  let Ok(re) = regex.compile(search.pattern(o)) else {
    return test.fail("bad pattern");
  };
  let p = search.printer(o, false);
  let h = buf_new(256);
  let first = search.search(p, re, "x\n", "a", h, false);
  let second = search.search(p, re, "foo\nbar\n", "b", h, first.written);
  let third = search.search(p, re, "foo\n", "c", h, second.written);
  let out = buf_take(h);
  buf_free(h);
  return test.assert_true(!first.matched && second.matched && third.written && out == "b:foo\nb-bar\n--\nc:foo\n");
}

function test_color(): test.TestOutcome {
  let got = [
    run(["--color", "always", "-n", "foo", "a", "b"], "a foo foo\n"),
    run(["--color=always", "-o", "o+", "a"], "foo\n"),
    run(["--color=always", "-c", "foo", "a", "b"], "foo\n"),
    run(["--color=always", "x*", "a"], "axb\n"),
  ];
  return test.assert_eq_array(got, [
    "\x1b[0m\x1b[35ma\x1b[0m:\x1b[0m\x1b[32m1\x1b[0m:a \x1b[0m\x1b[1m\x1b[31mfoo\x1b[0m \x1b[0m\x1b[1m\x1b[31mfoo\x1b[0m\n0",
    "\x1b[0m\x1b[1m\x1b[31moo\x1b[0m\n0",
    "\x1b[0m\x1b[35ma\x1b[0m:1\n0",
    "a\x1b[0m\x1b[1m\x1b[31mx\x1b[0mb\n0",
  ]);
}

function test_binary(): test.TestOutcome {
  let got = [
    run(["foo", "a"], "foo\nab\x00c\n"),
    run(["-H", "foo", "a"], "ab\x00c foo\n"),
    run(["-c", "foo", "a"], "foo\x00foo\nfoo\n"),
    run(["zzz", "a"], "a\x00b\n"),
    run(["-v", "foo", "a"], "a\x00foo\n"),
  ];
  return test.assert_eq_array(got, [
    "binary file matches (found \"\\0\" byte around offset 6)\n0",
    "a: binary file matches (found \"\\0\" byte around offset 2)\n0",
    "2\n0",
    "1",
    "1",
  ]);
}

function main(): i32 {
  let r = test.new("rg");
  r = r.it("parse", test_parse);
  r = r.it("parse errors", test_parse_errors);
  r = r.it("pattern", test_pattern);
  r = r.it("printer", test_printer);
  r = r.it("lines", test_lines);
  r = r.it("only matching", test_only_matching);
  r = r.it("counts", test_counts);
  r = r.it("context", test_context);
  r = r.it("separator between files", test_separator_between_files);
  r = r.it("color", test_color);
  r = r.it("binary", test_binary);
  return r.finish();
}
