// regex_bench — time std/regex on a file without the rest of rg.
//
//   $ regex_bench lines PATTERN FILE   # lines with a match, as rg -c
//   $ regex_bench find PATTERN FILE    # matches in the whole text, as rg -co
//
// The program writes the count and the milliseconds of the search.
import "std/regex";

function count_lines(re: regex.Regex, text: string): i32 {
  let count = 0;
  let start = 0;
  let n = text.len();
  while (start < n) {
    let end = __memchr(text, 10, start);
    if (end < 0) {
      end = n;
    }
    if (re.is_match(slice_unchecked(text, start, end))) {
      count += 1;
    }
    start = end + 1;
  }
  return count;
}

function main(): i32 {
  let argv = args();
  if (argv.len() != 4) {
    eprint("usage: regex_bench lines|find PATTERN FILE");
    return 2;
  }
  let Ok(re) = regex.compile(argv[2]) else {
    eprint("regex_bench: the pattern does not compile");
    return 2;
  };
  let Ok(bytes) = read_file_bytes(argv[3]) else {
    eprint("regex_bench: cannot read " + argv[3]);
    return 2;
  };
  let text = unsafe { string_from_bytes_unchecked(bytes) };
  let t0 = monotonic_ns();
  let count = 0;
  if (argv[1] == "lines") {
    count = count_lines(re, text);
  } else {
    count = re.count(text);
  }
  let ms = (monotonic_ns() - t0) / 1000000i64;
  print(count.to_string() + " " + ms.to_string() + " ms");
  return 0;
}
