# Copy this file and replace the hostname before public deployment.
FERN_SITE_ADDRESS=examples.example.com
FERN_SHOWCASE_IMAGE=fern-showcase:latest
FERN_HTTP_PORT=80
FERN_HTTPS_PORT=443
# With --profile walkie: the image of the walkie-talkie room server, and the
# directory of the issuer of the Caddy certificate.
FERN_WALKIE_IMAGE=fern-walkie:latest
FERN_WALKIE_ISSUER=acme-v02.api.letsencrypt.org-directory
