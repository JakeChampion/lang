// A reproduction of #5942 — a FRESH string temporary handed straight to a
// string-RETURNING call was never reclaimed — now FIXED. The two functions
// below differ only in whether the intermediate has a name, and are balanced
// either way:
//
//   FERN_LEAKCHECK=1 fern -target x86-64 -o /tmp/p examples/probes/string_arg_temp_leak.fern
//   /tmp/p    # stderr, before: leakcheck: allocs=195 frees=156 live_bytes=1248
//             # stderr, after:  leakcheck: allocs=195 frees=195 live_bytes=0
//
// `-target arm64` reports the same numbers. Before the fix, one block leaked per
// call of temp(), unbounded in a loop; bound() alone was already 195/195.
//
// TWO gates had to open, and each alone left the leak in place.
//
// 1. The stage-(b) arg-temp reclaim (ir.go, `reclaimArgTemps`) was gated on
//    `resultCannotAliasArg` — a concrete scalar result — because the post-call
//    dec fires immediately. `pad_start` really can hand its receiver back:
//
//        pub function (s: string) pad_start(n: i32, ch: string): string {
//            var sl: i32 = s.len();
//            if (sl >= n) { return s; }        // <-- result IS the argument
//
//    But that alias is COUNTED: `return <param>` emits the return-transfer inc,
//    and a param is never an isOwnedRcLocal, so move-on-return cannot cancel it
//    away. After the call the temp's rc is 2 on the pass-through path and 1 on
//    the fresh path, so ONE post-call dec nets both to a single owner — freeing
//    the temp only when the result does not reference it. That is
//    `resultIsCountedStringAlias`, restricted to concrete string results and
//    user-declared callees: widening to pointer results in general is what
//    segfaulted the differential oracle in an earlier attempt.
//
// 2. `ownedCallResultType` refuses to reclaim a `__`-prefixed method result
//    unless the callee is PROVEN fresh-returning, and the whole int-to-string
//    family was unproven — `int_to_string` / `__int_to_string_u64` /
//    `int_to_string_radix` all end in `string_from_bytes_unchecked`, a builtin
//    absent from the fixpoint set, so `exprNoParamEscape` rejected it and the
//    verdict propagated up through `to_string` / `to_hex` / `to_binary`. That
//    call always COPIES (the same fact #5931's allocator untaint rests on),
//    which is now stated where the fixpoint can use it.
//
// NOTE on why this hid for so long: on the single-word (x86-64 native) string
// ABI a <= 7-byte string is SSO-inline, so short intermediates allocate nothing
// and there is no block to lose. The two-word ABI (arm64 / TwoWordOverride,
// wasm) heap-allocates them — which is why `to_rgb_hex`, three
// `to_hex().pad_start(2, "0")` chains, reported a leak on arm64 and a clean run
// on x86-64 for byte-identical source. The strings below exceed the SSO window
// so both backends show it. Any new rc/string fixture should do the same, or it
// under-reports by however much fits inline.
//
// STILL OPEN: the concat half. A `"#" + a + b` operand is an *ast.Binary, not a
// Call, so it never reaches the arg-temp reclaim — `to_rgb_hex` is at 425 of 542
// on arm64, the remaining 117 being 3 per iteration, one per concat step.
//
// Regression gate: TestX86_64LeakCheckStringArgTempReclaim and its arm64 mirror,
// whose pass-through leg is the over-release half — a buffer freed while the
// result still needed it shows up as a wrong exit code, not as a leak.
import "std/i32";
import "std/string";

function temp(): i32 {
    var acc: i32 = 0;
    var k: i32 = 1;
    while (k < 40) {
        var s: string = (k * 66049).to_binary().pad_start(40, "0");
        var i: i32 = 0;
        while (i < s.len()) { acc = (acc * 31 + (s[i] as i32)) % 100003; i = i + 1; }
        k = k + 1;
    }
    return acc % 251;
}

function bound(): i32 {
    var acc: i32 = 0;
    var k: i32 = 1;
    while (k < 40) {
        var h: string = (k * 66049).to_binary();
        var s: string = h.pad_start(40, "0");
        var i: i32 = 0;
        while (i < s.len()) { acc = (acc * 31 + (s[i] as i32)) % 100003; i = i + 1; }
        k = k + 1;
    }
    return acc % 251;
}

function main(): i32 {
    // Same value from both — the leak is pure accounting, not a wrong answer.
    if (temp() != bound()) { return 1; }
    return 0;
}
