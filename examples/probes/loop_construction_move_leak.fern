// Repro for the move-on-construction loop-body leak (#3457 investigation).
//
// Build each shape with FERN_LEAKCHECK=1 and run it; the binary prints
//   leakcheck: allocs=<N> frees=<M> live_bytes=<K>
// at the exit seam. Measured on x86-64 at HEAD 9e27eda5:
//
//   leaks()      3 iterations -> allocs=6 frees=4 live_bytes=64   LEAKS
//   fresh()      3 iterations -> allocs=6 frees=6 live_bytes=0    clean
//   toplevel()                -> allocs=2 frees=2 live_bytes=0    clean
//
// The only difference between leaks() and fresh() is whether the array
// reaches the tuple as a bare IDENT or as a fresh literal. A bare ident at
// its last use is supposed to be MOVED into the construction — the inc is
// skipped and __drop_tuple releases the element — but markConstructionMoves
// only walks the function's TOP-LEVEL statements, so inside a loop body the
// move never fires. The alias-inc is emitted, nothing releases the source's
// own reference per iteration, and one array leaks per iteration.
//
// toplevel() is the same construction outside a loop: the move fires there,
// which is why it is clean and why the shape looks correct in every existing
// non-loop test.

function leaks(): i32 {
    var s: i32 = 0;
    var k: i32 = 0;
    while (k < 3) {
        var xs: i32[] = [1, 2, 3];
        var t = (xs, 99);
        s = s + t.0[2];
        k = k + 1;
    }
    return s;
}

function fresh(): i32 {
    var s: i32 = 0;
    var k: i32 = 0;
    while (k < 3) {
        var t = ([1, 2, 3], 99);
        s = s + t.0[2];
        k = k + 1;
    }
    return s;
}

function toplevel(): i32 {
    var xs: i32[] = [1, 2, 3];
    var t = (xs, 99);
    return t.0[2];
}

function main(): i32 {
    return (leaks() + fresh() + toplevel()) % 7;
}
