import "std/http";
import "std/http/router";
import "std/http/accesslog";
import "std/serve";
import "std/platform";
import "std/fetch";

pub function routes[P: platform.Platform](): router.Router[P] {
  return router.new[P]().get("/users/{id}", user).get("/healthz", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => Ok(http.ok("ok")));
}

function user[P: platform.Platform](req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] {
  use logged <- accesslog.logged(req, plat);
  let id: string = params.param("id")?;
  let resp: HttpResponse = plat.http(fetch.get("http://directory.internal/users/" + id))?;
  return Ok(http.json_status(resp.status, resp.body_string()));
}

function main(): i32 {
  return serve.exit_code(serve.supervise_shutdown(8080, serve.config(), routes[platform.Host]().handler(), (reason: string): void => eprint("api: stopped, " + reason)));
}
