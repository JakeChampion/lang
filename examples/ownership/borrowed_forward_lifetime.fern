import "std/i64";

@noinline
function update(own xs: i32[], n: i32): i32[] {
  xs = xs.with(0, n);
  return xs;
}

@noinline
function forward(xs: i32[], rounds: i32): i32[] {
  for i in 0..rounds {
    xs = update(xs, i);
  }
  return xs;
}

@noinline
function churn(calls: i32): i32 {
  for _ in 0..calls {
    let xs = [1, 2, 3];
    let next = forward(xs, 32);
    if (xs[0] != 1 || xs[1] != 2 || xs[2] != 3) {
      return 1;
    }
    if (next[0] != 31 || next[1] != 2 || next[2] != 3) {
      return 2;
    }
  }
  return 0;
}

function main(): i32 {
  let rounds = 8;
  let argv = args();
  if (argv.len() > 1) {
    rounds = 0;
    for c in argv[1] {
      let digit = c as i32 - b'0' as i32;
      if (digit < 0 || digit > 9 || rounds > 10000) {
        return 10;
      }
      rounds = rounds * 10 + digit;
    }
  }
  if (rounds < 1) {
    return 10;
  }
  if (churn(rounds) != 0) {
    return 11;
  }
  let before = __heap_bump_bytes();
  if (churn(rounds) != 0) {
    return 12;
  }
  let after = __heap_bump_bytes();
  let underflows = __rc_underflow_count();
  print((after - before).to_string());
  print((underflows as i64).to_string());
  if (underflows != 0) {
    return 99;
  }
  return 0;
}
