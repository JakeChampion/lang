import "std/http";
import "std/http/multipart";
import "std/platform";

function handle(req: HttpRequest, plat: platform.Host): HttpResponse {
  return http.respond(describe(req));
}

function describe(req: HttpRequest): Result[HttpResponse, multipart.MultipartError] {
  let out = "";
  let r = multipart.open(req, multipart.limits())?;
  loop {
    match (r.next()?) {
      NextPart(part, r1) => {
        if (part.filename.len() > 0) {
          let (line, r2) = sized(part, r1)?;
          out += line;
          r = r2;
        } else {
          let (content, r2) = r1.content()?;
          out += f"{part.name} = {unsafe { string_from_bytes_unchecked(content) }}\n";
          r = r2;
        }
      },
      NoMoreParts => {
        break;
      }
    }
  }
  return Ok(http.ok(out));
}

function sized(part: multipart.Part, r: multipart.Reader): Result[(string, multipart.Reader), multipart.MultipartError] {
  let bytes = 0;
  let pieces = 0;
  let cur = r;
  loop {
    let (chunk, last, next) = cur.read(4)?;
    bytes += chunk.len();
    pieces += 1;
    cur = next;
    if (last) {
      break;
    }
  }
  return Ok((f"{part.name} = {part.filename} ({part.content_type}, {bytes} bytes in {pieces} pieces)\n", cur));
}

function main(): i32 {
  let body = multipart.builder_with("example").field("title", "holiday").file("photo", "beach.png", "image/png", "PNG image".bytes()).field("tags", "sea, sand");
  let resp = handle(body.request("POST", "/upload"), platform.host());
  print(resp.body_text_lossy());
  if (resp.status != 200) {
    return 1;
  }
  return 0;
}
