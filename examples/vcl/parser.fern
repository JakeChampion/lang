import "std/string";
import "std/i32";
import "std/array";
import "core/cmp";
import "./ast";
import "./diag";
import "./lexer";

pub struct ParseResult { decls: ast.Decl[], diags: diag.Diag[] }

function no_diag(): diag.Diag {
  return diag.at("", 0, 0);
}

function at(toks: lexer.Tok[], i: i32): lexer.Tok {
  if (i >= toks.len()) {
    return toks[toks.len() - 1];
  }
  return toks[i];
}

function describe(t: lexer.Tok): string {
  if (t.is_eof()) {
    return "end of input";
  }
  if (t.is_string()) {
    return "a string";
  }
  return f"'{t.text}'";
}

struct EParse { node: ast.Expr, pos: i32, ok: boolean, err: diag.Diag }

function eok(n: ast.Expr, pos: i32): EParse {
  return EParse { node: n, pos: pos, ok: true, err: no_diag() };
}

function eerr(msg: string, t: lexer.Tok, pos: i32): EParse {
  let dummy = ENumber(ast.NumLit { text: "0", line: t.line, col: t.col });
  return EParse { node: dummy, pos: pos, ok: false, err: diag.at(msg, t.line, t.col) };
}

struct AParse { args: ast.Expr[], pos: i32, ok: boolean, err: diag.Diag }

function parse_args(toks: lexer.Tok[], i: i32): AParse {
  let args: ast.Expr[] = [];
  let pos = i + 1;
  if (at(toks, pos).punct(")")) {
    return AParse { args: args, pos: pos + 1, ok: true, err: no_diag() };
  }
  loop {
    let a = parse_expr(toks, pos);
    if (!a.ok) {
      return AParse { args: args, pos: a.pos, ok: false, err: a.err };
    }
    args = args.append(a.node);
    pos = a.pos;
    if (at(toks, pos).punct(",")) {
      pos += 1;
    } else {
      break;
    }
  }
  if (!at(toks, pos).punct(")")) {
    let t = at(toks, pos);
    return AParse { args: args, pos: pos, ok: false, err: diag.at("expected ')' to close the argument list, found " + describe(t), t.line, t.col) };
  }
  return AParse { args: args, pos: pos + 1, ok: true, err: no_diag() };
}

function parse_ident_expr(toks: lexer.Tok[], i: i32): EParse {
  let t = at(toks, i);
  if (t.text == "true" || t.text == "false") {
    return eok(EBool(ast.BoolLit { value: t.text == "true", line: t.line, col: t.col }), i + 1);
  }
  if (at(toks, i + 1).punct("(")) {
    let a = parse_args(toks, i + 1);
    if (!a.ok) {
      return EParse { node: EVar(ast.VarRef { name: t.text, line: t.line, col: t.col }), pos: a.pos, ok: false, err: a.err };
    }
    return eok(ECall(ast.CallExpr { callee: t.text, args: a.args, line: t.line, col: t.col }), a.pos);
  }
  return eok(EVar(ast.VarRef { name: t.text, line: t.line, col: t.col }), i + 1);
}

function parse_primary(toks: lexer.Tok[], i: i32): EParse {
  let t = at(toks, i);
  if (t.punct("(")) {
    let inner = parse_expr(toks, i + 1);
    if (!inner.ok) {
      return inner;
    }
    if (!at(toks, inner.pos).punct(")")) {
      let bad = at(toks, inner.pos);
      return eerr("expected ')', found " + describe(bad), bad, inner.pos);
    }
    return eok(EParen(inner.node), inner.pos + 1);
  }
  match (t.kind) {
    TString => {
      return eok(EString(ast.StrLit { value: t.text, form: t.aux, line: t.line, col: t.col }), i + 1);
    },
    TNumber => {
      return eok(ENumber(ast.NumLit { text: t.text, line: t.line, col: t.col }), i + 1);
    },
    TDuration => {
      return eok(EDuration(ast.QtyLit { text: t.text, unit: t.aux, line: t.line, col: t.col }), i + 1);
    },
    TBytes => {
      return eok(EBytes(ast.QtyLit { text: t.text, unit: t.aux, line: t.line, col: t.col }), i + 1);
    },
    TIdent => {
      return parse_ident_expr(toks, i);
    },
    _ => {
      return eerr("expected an expression, found " + describe(t), t, i);
    }
  }
}

function comparison_ops(): string[] {
  return ["==", "!=", "<", "<=", ">", ">=", "~", "!~"];
}

function parse_or(toks: lexer.Tok[], i: i32): EParse {
  let left = parse_and(toks, i);
  if (!left.ok) {
    return left;
  }
  let node = left.node;
  let pos = left.pos;
  while (at(toks, pos).punct("||")) {
    let op = at(toks, pos);
    let right = parse_and(toks, pos + 1);
    if (!right.ok) {
      return right;
    }
    node = EBinary(ast.BinExpr { op: op.text, lhs: node, rhs: right.node, line: op.line, col: op.col });
    pos = right.pos;
  }
  return eok(node, pos);
}

function parse_and(toks: lexer.Tok[], i: i32): EParse {
  let left = parse_not(toks, i);
  if (!left.ok) {
    return left;
  }
  let node = left.node;
  let pos = left.pos;
  while (at(toks, pos).punct("&&")) {
    let op = at(toks, pos);
    let right = parse_not(toks, pos + 1);
    if (!right.ok) {
      return right;
    }
    node = EBinary(ast.BinExpr { op: op.text, lhs: node, rhs: right.node, line: op.line, col: op.col });
    pos = right.pos;
  }
  return eok(node, pos);
}

function parse_not(toks: lexer.Tok[], i: i32): EParse {
  let t = at(toks, i);
  if (t.punct("!")) {
    let operand = parse_not(toks, i + 1);
    if (!operand.ok) {
      return operand;
    }
    return eok(EUnary(ast.UnExpr { op: "!", operand: operand.node, line: t.line, col: t.col }), operand.pos);
  }
  return parse_cmp(toks, i);
}

function parse_cmp(toks: lexer.Tok[], i: i32): EParse {
  let left = parse_add(toks, i);
  if (!left.ok) {
    return left;
  }
  let op = at(toks, left.pos);
  if (!op.is_punct() || !cmp.contains(comparison_ops(), op.text)) {
    return left;
  }
  let right = parse_add(toks, left.pos + 1);
  if (!right.ok) {
    return right;
  }
  let node = EBinary(ast.BinExpr { op: op.text, lhs: left.node, rhs: right.node, line: op.line, col: op.col });
  return eok(node, right.pos);
}

function parse_add(toks: lexer.Tok[], i: i32): EParse {
  return parse_left_assoc(toks, i, ["+", "-"], true);
}

function parse_mul(toks: lexer.Tok[], i: i32): EParse {
  return parse_left_assoc(toks, i, ["*", "/"], false);
}

function parse_left_assoc(toks: lexer.Tok[], i: i32, ops: string[], additive: boolean): EParse {
  let left = parse_operand(toks, i, additive);
  if (!left.ok) {
    return left;
  }
  let node = left.node;
  let pos = left.pos;
  while (at(toks, pos).is_punct() && cmp.contains(ops, at(toks, pos).text)) {
    let op = at(toks, pos);
    let right = parse_operand(toks, pos + 1, additive);
    if (!right.ok) {
      return right;
    }
    node = EBinary(ast.BinExpr { op: op.text, lhs: node, rhs: right.node, line: op.line, col: op.col });
    pos = right.pos;
  }
  return eok(node, pos);
}

function parse_operand(toks: lexer.Tok[], i: i32, additive: boolean): EParse {
  if (additive) {
    return parse_mul(toks, i);
  }
  return parse_neg(toks, i);
}

function parse_neg(toks: lexer.Tok[], i: i32): EParse {
  let t = at(toks, i);
  if (t.punct("-")) {
    let operand = parse_neg(toks, i + 1);
    if (!operand.ok) {
      return operand;
    }
    return eok(EUnary(ast.UnExpr { op: "-", operand: operand.node, line: t.line, col: t.col }), operand.pos);
  }
  return parse_primary(toks, i);
}

pub function parse_expr(toks: lexer.Tok[], i: i32): EParse {
  return parse_or(toks, i);
}

struct SParse { node: ast.Stmt, pos: i32, ok: boolean, err: diag.Diag, errs: diag.Diag[] }

function sok(n: ast.Stmt, pos: i32): SParse {
  let none: diag.Diag[] = [];
  return SParse { node: n, pos: pos, ok: true, err: no_diag(), errs: none };
}

function sok_with(n: ast.Stmt, pos: i32, errs: diag.Diag[]): SParse {
  return SParse { node: n, pos: pos, ok: true, err: no_diag(), errs: errs };
}

function serr(msg: string, t: lexer.Tok, pos: i32): SParse {
  let dummy = SCall(ast.CallStmt { name: "", line: t.line, col: t.col });
  let none: diag.Diag[] = [];
  return SParse { node: dummy, pos: pos, ok: false, err: diag.at(msg, t.line, t.col), errs: none };
}

function serr_from(d: diag.Diag, pos: i32): SParse {
  let dummy = SCall(ast.CallStmt { name: "", line: d.line, col: d.col });
  let none: diag.Diag[] = [];
  return SParse { node: dummy, pos: pos, ok: false, err: d, errs: none };
}

struct BParse { blk: ast.Block, pos: i32, ok: boolean, err: diag.Diag, errs: diag.Diag[] }

function expect_semi(toks: lexer.Tok[], pos: i32, what: string): SParse {
  let t = at(toks, pos);
  if (!t.punct(";")) {
    return serr(f"expected ';' after {what}, found {describe(t)}", t, pos);
  }
  return sok(SCall(ast.CallStmt { name: "", line: 0, col: 0 }), pos + 1);
}

function parse_set(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let target = at(toks, i + 1);
  if (!target.is_ident()) {
    return serr("expected a variable name after 'set', found " + describe(target), target, i + 1);
  }
  let op = at(toks, i + 2);
  if (!op.punct("=") && !op.punct("+=") && !op.punct("-=") && !op.punct("*=") && !op.punct("/=")) {
    return serr(f"expected an assignment operator after '{target.text}', found {describe(op)}", op, i + 2);
  }
  let v = parse_expr(toks, i + 3);
  if (!v.ok) {
    return serr_from(v.err, v.pos);
  }
  let semi = expect_semi(toks, v.pos, "the assignment");
  if (!semi.ok) {
    return semi;
  }
  let s = SSet(ast.SetStmt { target: target.text, op: op.text, value: v.node, line: kw.line, col: kw.col });
  return sok(s, semi.pos);
}

function parse_unset(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let target = at(toks, i + 1);
  if (!target.is_ident()) {
    return serr("expected a variable name after 'unset', found " + describe(target), target, i + 1);
  }
  let semi = expect_semi(toks, i + 2, f"'unset {target.text}'");
  if (!semi.ok) {
    return semi;
  }
  return sok(SUnset(ast.UnsetStmt { target: target.text, line: kw.line, col: kw.col }), semi.pos);
}

function parse_return(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let empty: ast.Expr[] = [];
  if (at(toks, i + 1).punct(";")) {
    let bare = SReturn(ast.ReturnStmt { action: "", args: empty, has_args: false, line: kw.line, col: kw.col });
    return sok(bare, i + 2);
  }
  if (!at(toks, i + 1).punct("(")) {
    let t = at(toks, i + 1);
    return serr("expected '(' or ';' after 'return', found " + describe(t), t, i + 1);
  }
  let action = at(toks, i + 2);
  if (!action.is_ident()) {
    return serr("expected a return action, found " + describe(action), action, i + 2);
  }
  let args = empty;
  let has_args = false;
  let pos = i + 3;
  if (at(toks, pos).punct("(")) {
    let a = parse_args(toks, pos);
    if (!a.ok) {
      return serr_from(a.err, a.pos);
    }
    args = a.args;
    has_args = true;
    pos = a.pos;
  }
  if (!at(toks, pos).punct(")")) {
    let bad = at(toks, pos);
    return serr("expected ')' to close 'return (', found " + describe(bad), bad, pos);
  }
  let semi = expect_semi(toks, pos + 1, "the return action");
  if (!semi.ok) {
    return semi;
  }
  let r = SReturn(ast.ReturnStmt { action: action.text, args: args, has_args: has_args, line: kw.line, col: kw.col });
  return sok(r, semi.pos);
}

function parse_call(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return serr("expected a subroutine name after 'call', found " + describe(name), name, i + 1);
  }
  let semi = expect_semi(toks, i + 2, f"'call {name.text}'");
  if (!semi.ok) {
    return semi;
  }
  return sok(SCall(ast.CallStmt { name: name.text, line: kw.line, col: kw.col }), semi.pos);
}

function parse_new(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return serr("expected an object name after 'new', found " + describe(name), name, i + 1);
  }
  if (!at(toks, i + 2).punct("=")) {
    let t = at(toks, i + 2);
    return serr(f"expected '=' after 'new {name.text}', found {describe(t)}", t, i + 2);
  }
  let init = parse_expr(toks, i + 3);
  if (!init.ok) {
    return serr_from(init.err, init.pos);
  }
  let semi = expect_semi(toks, init.pos, "the object constructor");
  if (!semi.ok) {
    return semi;
  }
  return sok(SNew(ast.NewStmt { name: name.text, init: init.node, line: kw.line, col: kw.col }), semi.pos);
}

function parse_include(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let path = at(toks, i + 1);
  if (!path.is_string()) {
    return serr("expected a quoted path after 'include', found " + describe(path), path, i + 1);
  }
  let semi = expect_semi(toks, i + 2, "the include path");
  if (!semi.ok) {
    return semi;
  }
  return sok(SInclude(ast.IncludeStmt { path: path.text, line: kw.line, col: kw.col }), semi.pos);
}

function parse_expr_stmt(toks: lexer.Tok[], i: i32): SParse {
  let t = at(toks, i);
  let e = parse_expr(toks, i);
  if (!e.ok) {
    return serr_from(e.err, e.pos);
  }
  let semi = expect_semi(toks, e.pos, "the expression");
  if (!semi.ok) {
    return semi;
  }
  return sok(SExpr(ast.ExprStmt { value: e.node, line: t.line, col: t.col }), semi.pos);
}

function arm_keyword(toks: lexer.Tok[], i: i32): Option[string] {
  let t = at(toks, i);
  if (t.word("elseif")) {
    return Some("elseif");
  }
  if (t.word("elsif")) {
    return Some("elsif");
  }
  if (t.word("else") && at(toks, i + 1).word("if")) {
    return Some("else if");
  }
  return None;
}

function parse_if(toks: lexer.Tok[], i: i32): SParse {
  let kw = at(toks, i);
  let arms: ast.IfArm[] = [];
  let inner: diag.Diag[] = [];
  let pos = i;
  let spelling = "if";
  loop {
    let head = at(toks, pos);
    pos += if (spelling == "else if") { 2 } else { 1 };
    if (!at(toks, pos).punct("(")) {
      let t = at(toks, pos);
      return serr(f"expected '(' after '{spelling}', found {describe(t)}", t, pos);
    }
    let cond = parse_expr(toks, pos + 1);
    if (!cond.ok) {
      return serr_from(cond.err, cond.pos);
    }
    if (!at(toks, cond.pos).punct(")")) {
      let bad = at(toks, cond.pos);
      return serr("expected ')' to close the condition, found " + describe(bad), bad, cond.pos);
    }
    let body = parse_block(toks, cond.pos + 1);
    if (!body.ok) {
      return serr_from(body.err, body.pos);
    }
    inner = array.concat(inner, body.errs);
    arms = arms.append(ast.IfArm { cond: cond.node, body: body.blk, kw: spelling, line: head.line, col: head.col });
    pos = body.pos;
    let Some(next) = arm_keyword(toks, pos) else {
      break;
    };
    spelling = next;
  }
  return finish_if(toks, pos, arms, kw, inner);
}

function finish_if(toks: lexer.Tok[], pos: i32, arms: ast.IfArm[], kw: lexer.Tok, inner: diag.Diag[]): SParse {
  let no_stmts: ast.Stmt[] = [];
  let empty = ast.Block { stmts: no_stmts, line: 0, col: 0 };
  if (!at(toks, pos).word("else")) {
    let plain = SIf(ast.IfStmt { arms: arms, else_blk: empty, has_else: false, line: kw.line, col: kw.col });
    return sok_with(plain, pos, inner);
  }
  let eb = parse_block(toks, pos + 1);
  if (!eb.ok) {
    return serr_from(eb.err, eb.pos);
  }
  let withelse = SIf(ast.IfStmt { arms: arms, else_blk: eb.blk, has_else: true, line: kw.line, col: kw.col });
  return sok_with(withelse, eb.pos, array.concat(inner, eb.errs));
}

function parse_keyword_stmt(toks: lexer.Tok[], i: i32, w: string): SParse {
  match (w) {
    "set" => {
      return parse_set(toks, i);
    },
    "unset" => {
      return parse_unset(toks, i);
    },
    "if" => {
      return parse_if(toks, i);
    },
    "return" => {
      return parse_return(toks, i);
    },
    "call" => {
      return parse_call(toks, i);
    },
    "new" => {
      return parse_new(toks, i);
    },
    _ => {
      return parse_include(toks, i);
    }
  }
}

function stmt_keywords(): string[] {
  return ["set", "unset", "if", "return", "call", "new", "include"];
}

function is_keyword_stmt(w: string): boolean {
  return cmp.contains(stmt_keywords(), w);
}

pub function parse_stmt(toks: lexer.Tok[], i: i32): SParse {
  let t = at(toks, i);
  if (t.punct("{")) {
    let b = parse_block(toks, i);
    if (!b.ok) {
      return serr_from(b.err, b.pos);
    }
    return sok_with(SBlock(b.blk), b.pos, b.errs);
  }
  match (t.kind) {
    TCSource => {
      return sok(SCSource(ast.CSourceStmt { code: t.text, line: t.line, col: t.col }), i + 1);
    },
    TIdent => {
      if (is_keyword_stmt(t.text)) {
        return parse_keyword_stmt(toks, i, t.text);
      }
      return parse_expr_stmt(toks, i);
    },
    _ => {
      return serr("expected a statement, found " + describe(t), t, i);
    }
  }
}

function recover_stmt(toks: lexer.Tok[], i: i32): i32 {
  let pos = i;
  while (!at(toks, pos).is_eof()) {
    if (at(toks, pos).punct(";")) {
      return pos + 1;
    }
    if (at(toks, pos).punct("}")) {
      return pos;
    }
    pos += 1;
  }
  return pos;
}

pub function parse_block(toks: lexer.Tok[], i: i32): BParse {
  let open = at(toks, i);
  let stmts: ast.Stmt[] = [];
  let errs: diag.Diag[] = [];
  if (!open.punct("{")) {
    let blk = ast.Block { stmts: stmts, line: open.line, col: open.col };
    return BParse { blk: blk, pos: i, ok: false, err: diag.at("expected '{', found " + describe(open), open.line, open.col), errs: errs };
  }
  let pos = i + 1;
  while (!at(toks, pos).punct("}")) {
    if (at(toks, pos).is_eof()) {
      let partial = ast.Block { stmts: stmts, line: open.line, col: open.col };
      return BParse { blk: partial, pos: pos, ok: false, err: diag.at("unclosed '{' opened here", open.line, open.col), errs: errs };
    }
    let s = parse_stmt(toks, pos);
    errs = array.concat(errs, s.errs);
    if (s.ok) {
      stmts = stmts.append(s.node);
      pos = s.pos;
    } else {
      errs = errs.append(s.err);
      pos = recover_stmt(toks, s.pos);
    }
  }
  let done = ast.Block { stmts: stmts, line: open.line, col: open.col };
  return BParse { blk: done, pos: pos + 1, ok: true, err: no_diag(), errs: errs };
}

struct PParse { blk: ast.PropBlock, pos: i32, ok: boolean, err: diag.Diag }

function perr(msg: string, t: lexer.Tok, pos: i32, props: ast.Prop[]): PParse {
  let blk = ast.PropBlock { props: props, line: t.line, col: t.col };
  return PParse { blk: blk, pos: pos, ok: false, err: diag.at(msg, t.line, t.col) };
}

function parse_prop_block(toks: lexer.Tok[], i: i32): PParse {
  let open = at(toks, i);
  let props: ast.Prop[] = [];
  if (!open.punct("{")) {
    return perr("expected '{', found " + describe(open), open, i, props);
  }
  let pos = i + 1;
  while (!at(toks, pos).punct("}")) {
    if (at(toks, pos).is_eof()) {
      return perr("unclosed '{' opened here", open, pos, props);
    }
    let one = parse_prop(toks, pos, props);
    if (!one.ok) {
      return one;
    }
    props = one.blk.props;
    pos = one.pos;
  }
  let blk = ast.PropBlock { props: props, line: open.line, col: open.col };
  return PParse { blk: blk, pos: pos + 1, ok: true, err: no_diag() };
}

function parse_prop(toks: lexer.Tok[], i: i32, props: ast.Prop[]): PParse {
  let name = at(toks, i);
  if (!name.is_ident() || !name.text.starts_with(".")) {
    return perr("expected a '.property' name, found " + describe(name), name, i, props);
  }
  if (!at(toks, i + 1).punct("=")) {
    let t = at(toks, i + 1);
    return perr(f"expected '=' after '{name.text}', found {describe(t)}", t, i + 1, props);
  }
  if (at(toks, i + 2).punct("{")) {
    let nested = parse_prop_block(toks, i + 2);
    if (!nested.ok) {
      return nested;
    }
    let pos = nested.pos;
    if (at(toks, pos).punct(";")) {
      pos += 1;
    }
    let bp = ast.Prop { name: name.text, value: PVBlock(nested.blk), line: name.line, col: name.col };
    return PParse { blk: ast.PropBlock { props: props.append(bp), line: name.line, col: name.col }, pos: pos, ok: true, err: no_diag() };
  }
  let v = parse_expr(toks, i + 2);
  if (!v.ok) {
    return PParse { blk: ast.PropBlock { props: props, line: name.line, col: name.col }, pos: v.pos, ok: false, err: v.err };
  }
  if (!at(toks, v.pos).punct(";")) {
    let bad = at(toks, v.pos);
    return perr(f"expected ';' after the value of '{name.text}', found {describe(bad)}", bad, v.pos, props);
  }
  let ep = ast.Prop { name: name.text, value: PVExpr(v.node), line: name.line, col: name.col };
  return PParse { blk: ast.PropBlock { props: props.append(ep), line: name.line, col: name.col }, pos: v.pos + 1, ok: true, err: no_diag() };
}

struct DParse { decl: ast.Decl, pos: i32, ok: boolean, err: diag.Diag, errs: diag.Diag[] }

function dok(d: ast.Decl, pos: i32, errs: diag.Diag[]): DParse {
  return DParse { decl: d, pos: pos, ok: true, err: no_diag(), errs: errs };
}

function derr(msg: string, t: lexer.Tok, pos: i32): DParse {
  let dummy = DVcl(ast.VclDecl { version: "", line: t.line, col: t.col });
  let none: diag.Diag[] = [];
  return DParse { decl: dummy, pos: pos, ok: false, err: diag.at(msg, t.line, t.col), errs: none };
}

function derr_from(d: diag.Diag, pos: i32): DParse {
  let dummy = DVcl(ast.VclDecl { version: "", line: d.line, col: d.col });
  let none: diag.Diag[] = [];
  return DParse { decl: dummy, pos: pos, ok: false, err: d, errs: none };
}

function no_errs(): diag.Diag[] {
  let none: diag.Diag[] = [];

  return none;
}

function parse_vcl(toks: lexer.Tok[], i: i32): DParse {
  let kw = at(toks, i);
  let ver = at(toks, i + 1);
  match (ver.kind) {
    TNumber => {
      if (!at(toks, i + 2).punct(";")) {
        let t = at(toks, i + 2);
        return derr("expected ';' after the VCL version, found " + describe(t), t, i + 2);
      }
      let d = DVcl(ast.VclDecl { version: ver.text, line: kw.line, col: kw.col });
      return dok(d, i + 3, no_errs());
    },
    _ => {
      return derr("expected a VCL version number, found " + describe(ver), ver, i + 1);
    }
  }
}

function parse_import(toks: lexer.Tok[], i: i32): DParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return derr("expected a VMOD name after 'import', found " + describe(name), name, i + 1);
  }
  let from = "";
  let has_from = false;
  let pos = i + 2;
  if (at(toks, pos).word("from")) {
    let path = at(toks, pos + 1);
    if (!path.is_string()) {
      return derr("expected a quoted path after 'from', found " + describe(path), path, pos + 1);
    }
    from = path.text;
    has_from = true;
    pos += 2;
  }
  if (!at(toks, pos).punct(";")) {
    let t = at(toks, pos);
    return derr("expected ';' after the import, found " + describe(t), t, pos);
  }
  let d = DImport(ast.ImportDecl { module: name.text, from: from, has_from: has_from, line: kw.line, col: kw.col });
  return dok(d, pos + 1, no_errs());
}

function parse_backend(toks: lexer.Tok[], i: i32): DParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return derr("expected a backend name, found " + describe(name), name, i + 1);
  }
  let no_props: ast.Prop[] = [];
  if (at(toks, i + 2).word("none")) {
    if (!at(toks, i + 3).punct(";")) {
      let t = at(toks, i + 3);
      return derr(f"expected ';' after 'backend {name.text} none', found {describe(t)}", t, i + 3);
    }
    let empty = ast.PropBlock { props: no_props, line: name.line, col: name.col };
    let nd = DBackend(ast.BackendDecl { name: name.text, props: empty, none: true, line: kw.line, col: kw.col });
    return dok(nd, i + 4, no_errs());
  }
  let body = parse_prop_block(toks, i + 2);
  if (!body.ok) {
    return derr_from(body.err, body.pos);
  }
  let d = DBackend(ast.BackendDecl { name: name.text, props: body.blk, none: false, line: kw.line, col: kw.col });
  return dok(d, body.pos, no_errs());
}

function parse_probe(toks: lexer.Tok[], i: i32): DParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return derr("expected a probe name, found " + describe(name), name, i + 1);
  }
  let body = parse_prop_block(toks, i + 2);
  if (!body.ok) {
    return derr_from(body.err, body.pos);
  }
  let d = DProbe(ast.ProbeDecl { name: name.text, props: body.blk, line: kw.line, col: kw.col });
  return dok(d, body.pos, no_errs());
}

function parse_sub(toks: lexer.Tok[], i: i32): DParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return derr("expected a subroutine name, found " + describe(name), name, i + 1);
  }
  let body = parse_block(toks, i + 2);
  if (!body.ok) {
    return derr_from(body.err, body.pos);
  }
  let d = DSub(ast.SubDecl { name: name.text, body: body.blk, line: kw.line, col: kw.col });
  return dok(d, body.pos, body.errs);
}

struct EntryParse { entry: ast.AclEntry, pos: i32, ok: boolean, err: diag.Diag }

function parse_acl_entry(toks: lexer.Tok[], i: i32): EntryParse {
  let start = at(toks, i);
  let pos = i;
  let negated = false;
  if (at(toks, pos).punct("!")) {
    negated = true;
    pos += 1;
  }
  let parens = false;
  if (at(toks, pos).punct("(")) {
    parens = true;
    pos += 1;
  }
  let host = at(toks, pos);
  if (!host.is_string()) {
    let blank = ast.AclEntry { negated: negated, parens: parens, host: "", mask: "", line: host.line, col: host.col };
    return EntryParse { entry: blank, pos: pos, ok: false, err: diag.at("expected a quoted host in the ACL, found " + describe(host), host.line, host.col) };
  }
  pos += 1;
  let mask = "";
  if (at(toks, pos).punct("/")) {
    let bits = at(toks, pos + 1);
    match (bits.kind) {
      TNumber => {
        mask = bits.text;
        pos += 2;
      },
      _ => {
        let b2 = ast.AclEntry { negated: negated, parens: parens, host: host.text, mask: "", line: start.line, col: start.col };
        return EntryParse { entry: b2, pos: pos, ok: false, err: diag.at("expected a mask width after '/', found " + describe(bits), bits.line, bits.col) };
      }
    }
  }
  let entry = ast.AclEntry { negated: negated, parens: parens, host: host.text, mask: mask, line: start.line, col: start.col };
  if (parens) {
    if (!at(toks, pos).punct(")")) {
      let t = at(toks, pos);
      return EntryParse { entry: entry, pos: pos, ok: false, err: diag.at("expected ')' to close the ACL entry, found " + describe(t), t.line, t.col) };
    }
    pos += 1;
  }
  if (!at(toks, pos).punct(";")) {
    let semi = at(toks, pos);
    return EntryParse { entry: entry, pos: pos, ok: false, err: diag.at("expected ';' after the ACL entry, found " + describe(semi), semi.line, semi.col) };
  }
  return EntryParse { entry: entry, pos: pos + 1, ok: true, err: no_diag() };
}

function parse_acl(toks: lexer.Tok[], i: i32): DParse {
  let kw = at(toks, i);
  let name = at(toks, i + 1);
  if (!name.is_ident()) {
    return derr("expected an ACL name, found " + describe(name), name, i + 1);
  }
  if (!at(toks, i + 2).punct("{")) {
    let t = at(toks, i + 2);
    return derr(f"expected '{{' after 'acl {name.text}', found {describe(t)}", t, i + 2);
  }
  let entries: ast.AclEntry[] = [];
  let pos = i + 3;
  while (!at(toks, pos).punct("}")) {
    if (at(toks, pos).is_eof()) {
      return derr("unclosed '{' opened here", at(toks, i + 2), pos);
    }
    let e = parse_acl_entry(toks, pos);
    if (!e.ok) {
      return derr_from(e.err, e.pos);
    }
    entries = entries.append(e.entry);
    pos = e.pos;
  }
  let d = DAcl(ast.AclDecl { name: name.text, entries: entries, line: kw.line, col: kw.col });
  return dok(d, pos + 1, no_errs());
}

function parse_top_include(toks: lexer.Tok[], i: i32): DParse {
  let s = parse_include(toks, i);
  if (!s.ok) {
    return derr_from(s.err, s.pos);
  }
  let SInclude(inc) = s.node else {
    return derr("expected an include", at(toks, i), i);
  };
  return dok(DInclude(inc), s.pos, no_errs());
}

function decl_keywords(): string[] {
  return ["vcl", "import", "include", "backend", "probe", "acl", "sub"];
}

function parse_decl(toks: lexer.Tok[], i: i32): DParse {
  let t = at(toks, i);
  match (t.kind) {
    TCSource => {
      let c = DCSource(ast.CSourceStmt { code: t.text, line: t.line, col: t.col });
      return dok(c, i + 1, no_errs());
    },
    TIdent => {
      return parse_decl_keyword(toks, i, t);
    },
    _ => {
      return derr("expected a top-level declaration, found " + describe(t), t, i);
    }
  }
}

function parse_decl_keyword(toks: lexer.Tok[], i: i32, t: lexer.Tok): DParse {
  match (t.text) {
    "vcl" => {
      return parse_vcl(toks, i);
    },
    "import" => {
      return parse_import(toks, i);
    },
    "include" => {
      return parse_top_include(toks, i);
    },
    "backend" => {
      return parse_backend(toks, i);
    },
    "probe" => {
      return parse_probe(toks, i);
    },
    "acl" => {
      return parse_acl(toks, i);
    },
    "sub" => {
      return parse_sub(toks, i);
    },
    _ => {
      return derr("expected a top-level declaration, found " + describe(t), t, i);
    }
  }
}

function recover_decl(toks: lexer.Tok[], from: i32, at_least: i32): i32 {
  let pos = if (from < at_least) { at_least } else { from };
  let kws = decl_keywords();
  while (!at(toks, pos).is_eof()) {
    let t = at(toks, pos);
    if (t.is_ident() && cmp.contains(kws, t.text)) {
      return pos;
    }
    pos += 1;
  }
  return pos;
}

pub function parse(src: string): ParseResult {
  let lr = lexer.lex(src);
  let diags = lr.diags;
  let decls: ast.Decl[] = [];
  let pos = 0;
  while (!at(lr.toks, pos).is_eof()) {
    let d = parse_decl(lr.toks, pos);
    diags = array.concat(diags, d.errs);
    if (d.ok) {
      decls = decls.append(d.decl);
      pos = d.pos;
    } else {
      diags = diags.append(d.err);
      pos = recover_decl(lr.toks, d.pos, pos + 1);
    }
  }
  return ParseResult { decls: decls, diags: diags };
}
