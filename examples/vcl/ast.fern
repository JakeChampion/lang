pub struct StrLit { value: string, form: string, line: i32, col: i32 }

pub struct NumLit { text: string, line: i32, col: i32 }

pub struct QtyLit { text: string, unit: string, line: i32, col: i32 }

pub struct BoolLit { value: boolean, line: i32, col: i32 }

pub struct VarRef { name: string, line: i32, col: i32 }

pub struct CallExpr { callee: string, args: Expr[], line: i32, col: i32 }

pub struct BinExpr { op: string, lhs: Expr, rhs: Expr, line: i32, col: i32 }

pub struct UnExpr { op: string, operand: Expr, line: i32, col: i32 }

pub enum Expr { EString(StrLit), ENumber(NumLit), EDuration(QtyLit), EBytes(QtyLit), EBool(BoolLit), EVar(VarRef), ECall(CallExpr), EBinary(BinExpr), EUnary(UnExpr), EParen(Expr) }

pub struct Block { stmts: Stmt[], line: i32, col: i32 }

pub struct SetStmt { target: string, op: string, value: Expr, line: i32, col: i32 }

pub struct UnsetStmt { target: string, line: i32, col: i32 }

pub struct IfArm { cond: Expr, body: Block, kw: string, line: i32, col: i32 }

pub struct IfStmt { arms: IfArm[], else_blk: Block, has_else: boolean, line: i32, col: i32 }

pub struct ReturnStmt { action: string, args: Expr[], has_args: boolean, line: i32, col: i32 }

pub struct CallStmt { name: string, line: i32, col: i32 }

pub struct NewStmt { name: string, init: Expr, line: i32, col: i32 }

pub struct ExprStmt { value: Expr, line: i32, col: i32 }

pub struct IncludeStmt { path: string, line: i32, col: i32 }

pub struct CSourceStmt { code: string, line: i32, col: i32 }

pub enum Stmt { SSet(SetStmt), SUnset(UnsetStmt), SIf(IfStmt), SReturn(ReturnStmt), SCall(CallStmt), SNew(NewStmt), SExpr(ExprStmt), SInclude(IncludeStmt), SCSource(CSourceStmt), SBlock(Block) }

pub struct VclDecl { version: string, line: i32, col: i32 }

pub struct ImportDecl { module: string, from: string, has_from: boolean, line: i32, col: i32 }

pub struct Prop { name: string, value: PropValue, line: i32, col: i32 }

pub struct PropBlock { props: Prop[], line: i32, col: i32 }

pub enum PropValue { PVExpr(Expr), PVBlock(PropBlock) }

pub struct BackendDecl { name: string, props: PropBlock, none: boolean, line: i32, col: i32 }

pub struct ProbeDecl { name: string, props: PropBlock, line: i32, col: i32 }

pub struct AclEntry { negated: boolean, parens: boolean, host: string, mask: string, line: i32, col: i32 }

pub struct AclDecl { name: string, entries: AclEntry[], line: i32, col: i32 }

pub struct SubDecl { name: string, body: Block, line: i32, col: i32 }

pub enum Decl { DVcl(VclDecl), DImport(ImportDecl), DInclude(IncludeStmt), DBackend(BackendDecl), DProbe(ProbeDecl), DAcl(AclDecl), DSub(SubDecl), DCSource(CSourceStmt) }
