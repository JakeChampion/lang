// examples/vcl/eval.fern — the VCL evaluator: expressions and statements.
//
// Everything threads a `Txn` through and returns a new one, so the whole
// evaluator is a pure function of (program, transaction, subroutine) and
// nothing hides in a mutable cell. That is not a Fern workaround — it is
// what makes the state machine in `machine.fern` able to hand a
// transaction to one subroutine, take the result, and hand it to the
// next, with the intermediate states still in hand for the log.
//
// Two VCL details drive the shape here:
//
//   * `~` is overloaded. Against a string it is a regex match; against an
//     ACL name it is a subnet membership test. They are distinguished
//     SYNTACTICALLY — an identifier naming an `acl` block — because there
//     is no value that could tell them apart afterwards.
//   * A bare identifier can be a variable, a backend name, or an ACL
//     name, and only the program can say which.
import "std/i32";
import "std/string";
import "std/i64";
import "std/f64";
import "std/regex";
import "std/option";
import "core/cmp";
import "./ast";
import "./value";
import "./runtime";
import "./vars";

pub struct Ctx { decls: ast.Decl[] }

pub struct Action { name: string, status: i64, reason: string }

pub function action(name: string): Action {
  return Action { name: name, status: 0, reason: "" };
}

pub enum Flow { FNext, FReturn(Action) }

pub struct EvalOut { txn: runtime.Txn, val: value.Value, ok: boolean, err: string }

pub function fell_through(t: runtime.Txn): ExecOut {
  return ExecOut { txn: t, flow: FNext, ok: true, err: "" };
}

pub function returned(t: runtime.Txn, a: Action): ExecOut {
  return ExecOut { txn: t, flow: FReturn(a), ok: true, err: "" };
}

pub function failed(t: runtime.Txn, msg: string): ExecOut {
  return ExecOut { txn: t, flow: FNext, ok: false, err: msg };
}

pub function synth_action(name: string, status: i64, reason: string): Action {
  return Action { name: name, status: status, reason: reason };
}

pub struct ExecOut { txn: runtime.Txn, flow: Flow, ok: boolean, err: string }

function eok(t: runtime.Txn, v: value.Value): EvalOut {
  return EvalOut { txn: t, val: v, ok: true, err: "" };
}

function eerr(t: runtime.Txn, msg: string): EvalOut {
  return EvalOut { txn: t, val: VNone, ok: false, err: msg };
}

function xok(t: runtime.Txn, f: Flow): ExecOut {
  return ExecOut { txn: t, flow: f, ok: true, err: "" };
}

function xerr(t: runtime.Txn, msg: string): ExecOut {
  return ExecOut { txn: t, flow: FNext, ok: false, err: msg };
}

pub function find_sub(ctx: Ctx, name: string): Option[ast.Block] {
  for d in ctx.decls {
    if let DSub(s) = d {
      if (s.name == name) {
        return Some(s.body);
      }
    }
  }
  return None;
}

pub function find_acl(ctx: Ctx, name: string): Option[ast.AclDecl] {
  for d in ctx.decls {
    if let DAcl(a) = d {
      if (a.name == name) {
        return Some(a);
      }
    }
  }
  return None;
}

pub function has_acl(ctx: Ctx, name: string): boolean {
  return find_acl(ctx, name).is_some();
}

pub function has_backend(ctx: Ctx, name: string): boolean {
  for d in ctx.decls {
    if let DBackend(b) = d {
      if (b.name == name) {
        return true;
      }
    }
  }
  return false;
}

pub function parse_ipv4(s: string): Option[i64] {
  if (s == "localhost") {
    return Some(2130706433);
  }
  let parts = s.split(".");
  if (parts.len() != 4) {
    return None;
  }
  let acc: i64 = 0;
  for part in parts {
    let Ok(n) = i32.parse_i32(part) else {
      return None;
    };
    if (n < 0 || n > 255) {
      return None;
    }
    acc = acc * 256 + n as i64;
  }
  return Some(acc);
}

pub function mask_of(bits: i32): i64 {
  if (bits <= 0) {
    return 0;
  }
  if (bits >= 32) {
    return 4294967295;
  }
  let low: i64 = 1;
  low = low << 32 - bits;
  return 4294967295 - (low - 1);
}

struct EntryHit { covers: boolean, bits: i32 }

function entry_matches(e: ast.AclEntry, ip: i64): Result[EntryHit, string] {
  let Some(base) = parse_ipv4(e.host) else {
    return Err(f"ACL entry '{e.host}' is not an IPv4 address or 'localhost'");
  };
  let bits = 32;
  if (e.mask != "") {
    let Ok(b) = i32.parse_i32(e.mask) else {
      return Err(f"ACL mask '{e.mask}' is not a number");
    };
    bits = b;
  }
  if (bits < 0 || bits > 32) {
    return Err(f"ACL mask /{e.mask} is out of range");
  }
  let m = mask_of(bits);
  return Ok(EntryHit { covers: (base & m) == (ip & m), bits: bits });
}

pub function acl_match(ctx: Ctx, name: string, addr: string): Result[boolean, string] {
  let Some(a) = find_acl(ctx, name) else {
    return Err(f"unknown ACL '{name}'");
  };
  let Some(ip) = parse_ipv4(addr) else {
    return Err(f"'{addr}' is not an IPv4 address");
  };
  return acl_walk(a, ip);
}

function acl_walk(a: ast.AclDecl, ip: i64): Result[boolean, string] {
  let best_bits = -1;
  let best_negated = false;
  for e in a.entries {
    let h = entry_matches(e, ip)?;
    if (h.covers && h.bits > best_bits) {
      best_bits = h.bits;
      best_negated = e.negated;
    }
  }
  if (best_bits < 0) {
    return Ok(false);
  }
  return Ok(!best_negated);
}

function vcl_template(repl: string): string {
  let out = "";
  let i = 0;
  while (i < repl.len()) {
    let b = repl[i];
    if (b == b'$') {
      out += "$$";
    } else if (b == b'\\' && i + 1 < repl.len() && repl[i + 1] >= b'0' && repl[i + 1] <= b'9') {
      out = out + "$" + slice_unchecked(repl, i + 1, i + 2);
      i += 1;
    } else {
      out += slice_unchecked(repl, i, i + 1);
    }
    i += 1;
  }
  return out;
}

function arg_str(args: value.Value[], i: i32): string {
  if (i >= args.len()) {
    return "";
  }
  return value.to_str(args[i]);
}

pub function builtin_names(): string[] {
  return ["regsub", "regsuball", "std.tolower", "std.toupper", "std.integer", "std.log", "hash_data", "synthetic"];
}

pub function is_builtin(name: string): boolean {
  return cmp.contains(builtin_names(), name);
}

function call_text_builtin(name: string, args: value.Value[]): Option[value.Value] {
  match (name) {
    "std.tolower" => {
      return Some(VString(arg_str(args, 0).to_ascii_lower()));
    },
    "std.toupper" => {
      return Some(VString(arg_str(args, 0).to_ascii_upper()));
    },
    "std.integer" => {
      return Some(integer_or(arg_str(args, 0), args));
    },
    _ => {
      return None;
    }
  }
}

function integer_or(text: string, args: value.Value[]): value.Value {
  if let Ok(n) = i32.parse_i32(text) {
    return VInt(n as i64);
  }
  if (args.len() > 1) {
    return args[1];
  }
  return VInt(0);
}

function call_regex(t: runtime.Txn, name: string, args: value.Value[]): EvalOut {
  match (regex.compile(arg_str(args, 1))) {
    Err(e) => {
      return eerr(t, e.to_string());
    },
    Ok(pattern) => {
      let subject = arg_str(args, 0);
      let template = vcl_template(arg_str(args, 2));
      let result = if (name == "regsub") { pattern.replace_groups(subject, template) } else { pattern.replace_all_groups(subject, template) };
      return match (result) { Ok(text) => eok(t, VString(text)), Err(e) => eerr(t, f"{name}: {e}") };
    }
  }
}

pub function call_builtin(t: runtime.Txn, name: string, args: value.Value[]): EvalOut {
  if (name == "regsub" || name == "regsuball") {
    return call_regex(t, name, args);
  }
  if let Some(v) = call_text_builtin(name, args) {
    return eok(t, v);
  }
  match (name) {
    "std.log" => {
      return eok(t.note("std.log: " + arg_str(args, 0)), VNone);
    },
    "hash_data" => {
      return eok(t.add_hash(arg_str(args, 0)), VNone);
    },
    "synthetic" => {
      return eok(t.note("synthetic: " + arg_str(args, 0)), VNone);
    },
    _ => {
      return eerr(t, f"unsupported function '{name}'");
    }
  }
}

function number_of(text: string): Result[value.Value, string] {
  if (text.contains(".")) {
    return match (f64.parse_f64(text)) { Ok(f) => Ok(VReal(f)), Err(_) => Err(f"malformed real '{text}'") };
  }
  return match (i32.parse_i32(text)) { Ok(n) => Ok(VInt(n as i64)), Err(_) => Err(f"malformed integer '{text}'") };
}

function qty_number(text: string): f64 {
  return match (f64.parse_f64(text)) { Ok(f) => f, Err(_) => 0.0 };
}

function eval_name(ctx: Ctx, t: runtime.Txn, sub: string, name: string): EvalOut {
  if (vars.is_var(name)) {
    return match (vars.read(t, sub, name)) { Ok(v) => eok(t, v), Err(m) => eerr(t, m) };
  }
  if (has_backend(ctx, name)) {
    return eok(t, VBackend(name));
  }
  if (has_acl(ctx, name)) {
    return eok(t, VAcl(name));
  }
  return eerr(t, f"unknown name '{name}'");
}

function eval_call(ctx: Ctx, t: runtime.Txn, sub: string, c: ast.CallExpr): EvalOut {
  let cur = t;
  let out: value.Value[] = [];
  for arg in c.args {
    let r = eval_expr(ctx, cur, sub, arg);
    if (!r.ok) {
      return r;
    }
    cur = r.txn;
    out = out.append(r.val);
  }
  return call_builtin(cur, c.callee, out);
}

function acl_operand(ctx: Ctx, e: ast.Expr): Option[string] {
  if let EVar(v) = e {
    if (has_acl(ctx, v.name)) {
      return Some(v.name);
    }
  }
  return None;
}

function eval_match(ctx: Ctx, t: runtime.Txn, sub: string, b: ast.BinExpr): EvalOut {
  let negate = b.op == "!~";
  let acl = acl_operand(ctx, b.rhs);
  let left = eval_expr(ctx, t, sub, b.lhs);
  if (!left.ok) {
    return left;
  }
  if let Some(name) = acl {
    return match (acl_match(ctx, name, value.to_str(left.val))) { Err(m) => eerr(left.txn, m), Ok(hit) => eok(left.txn, VBool(hit != negate)) };
  }
  let right = eval_expr(ctx, left.txn, sub, b.rhs);
  if (!right.ok) {
    return right;
  }
  return match (match_pattern(value.to_str(right.val), value.to_str(left.val), negate)) { Ok(result) => eok(right.txn, result), Err(message) => eerr(right.txn, message) };
}

function eval_logical(ctx: Ctx, t: runtime.Txn, sub: string, b: ast.BinExpr): EvalOut {
  let left = eval_expr(ctx, t, sub, b.lhs);
  if (!left.ok) {
    return left;
  }
  let lv = value.to_bool(left.val);
  if (b.op == "&&" && !lv) {
    return eok(left.txn, VBool(false));
  }
  if (b.op == "||" && lv) {
    return eok(left.txn, VBool(true));
  }
  let right = eval_expr(ctx, left.txn, sub, b.rhs);
  if (!right.ok) {
    return right;
  }
  return eok(right.txn, VBool(value.to_bool(right.val)));
}

function ordering_holds(op: string, c: i32): boolean {
  return match (op) { "<" => c < 0, "<=" => c <= 0, ">" => c > 0, _ => c >= 0 };
}

function eval_compare(op: string, lv: value.Value, rv: value.Value): Result[value.Value, string] {
  return match (op) { "==" => Ok(VBool(value.equal(lv, rv))), "!=" => Ok(VBool(!value.equal(lv, rv))), _ => Ok(VBool(ordering_holds(op, value.compare(lv, rv)?))) };
}

// fern-lint: allow cyclomatic-complexity
pub function op_class(op: string): string {
  return match (op) { "~" | "!~" => "match", "&&" | "||" => "logical", "==" | "!=" | "<" | "<=" | ">" | ">=" => "compare", _ => "arith" };
}

function eval_binary(ctx: Ctx, t: runtime.Txn, sub: string, b: ast.BinExpr): EvalOut {
  let cls = op_class(b.op);
  if (cls == "match") {
    return eval_match(ctx, t, sub, b);
  }
  if (cls == "logical") {
    return eval_logical(ctx, t, sub, b);
  }
  let left = eval_expr(ctx, t, sub, b.lhs);
  if (!left.ok) {
    return left;
  }
  let right = eval_expr(ctx, left.txn, sub, b.rhs);
  if (!right.ok) {
    return right;
  }
  let r = if (cls == "compare") { eval_compare(b.op, left.val, right.val) } else { value.arith(b.op, left.val, right.val) };
  return match (r) { Err(m) => eerr(right.txn, m), Ok(v) => eok(right.txn, v) };
}

// fern-lint: allow cyclomatic-complexity
pub function eval_expr(ctx: Ctx, t: runtime.Txn, sub: string, e: ast.Expr): EvalOut {
  match (e) {
    EString(s) => {
      return eok(t, VString(s.value));
    },
    EBool(b) => {
      return eok(t, VBool(b.value));
    },
    EParen(inner) => {
      return eval_expr(ctx, t, sub, inner);
    },
    EVar(v) => {
      return eval_name(ctx, t, sub, v.name);
    },
    ECall(c) => {
      return eval_call(ctx, t, sub, c);
    },
    EBinary(b) => {
      return eval_binary(ctx, t, sub, b);
    },
    EUnary(u) => {
      return eval_unary(ctx, t, sub, u);
    },
    ENumber(n) => {
      return match (number_of(n.text)) { Ok(v) => eok(t, v), Err(m) => eerr(t, m) };
    },
    EDuration(q) => {
      return match (value.duration_seconds(qty_number(q.text), q.unit)) { Ok(secs) => eok(t, VDuration(secs)), Err(m) => eerr(t, m) };
    },
    EBytes(q) => {
      return match (value.byte_count(qty_number(q.text), q.unit)) { Ok(n) => eok(t, VBytes(n)), Err(m) => eerr(t, m) };
    }
  }
}

function eval_unary(ctx: Ctx, t: runtime.Txn, sub: string, u: ast.UnExpr): EvalOut {
  let r = eval_expr(ctx, t, sub, u.operand);
  if (!r.ok) {
    return r;
  }
  if (u.op == "!") {
    return eok(r.txn, VBool(!value.to_bool(r.val)));
  }
  return match (value.arith("-", VInt(0), r.val)) { Ok(v) => eok(r.txn, v), Err(m) => eerr(r.txn, m) };
}

function max_call_depth(): i32 {
  return 32;
}

function compound_op(op: string): string {
  return slice_unchecked(op, 0, op.len() - 1).to_owned();
}

function exec_set(ctx: Ctx, t: runtime.Txn, sub: string, s: ast.SetStmt): ExecOut {
  let r = eval_expr(ctx, t, sub, s.value);
  if (!r.ok) {
    return xerr(r.txn, r.err);
  }
  let v = r.val;
  let cur = r.txn;
  if (s.op != "=") {
    match (combine(cur, sub, s, v)) {
      Err(m) => {
        return xerr(cur, m);
      },
      Ok(combined) => {
        v = combined;
      }
    }
  }
  return match (vars.assign(cur, sub, s.target, v)) { Err(m) => xerr(cur, m), Ok(next) => xok(next, FNext) };
}

function combine(t: runtime.Txn, sub: string, s: ast.SetStmt, v: value.Value): Result[value.Value, string] {
  let old = vars.read(t, sub, s.target)?;
  return value.arith(compound_op(s.op), old, v);
}

function exec_return(ctx: Ctx, t: runtime.Txn, sub: string, s: ast.ReturnStmt): ExecOut {
  if (s.action == "") {
    return xok(t, FReturn(action("none")));
  }
  if (!s.has_args || s.args.len() == 0) {
    return xok(t, FReturn(action(s.action)));
  }
  let first = eval_expr(ctx, t, sub, s.args[0]);
  if (!first.ok) {
    return xerr(first.txn, first.err);
  }
  let status = match (first.val) { VInt(n) => n, _ => 0 };
  let cur = first.txn;
  let reason = "";
  if (s.args.len() > 1) {
    let second = eval_expr(ctx, cur, sub, s.args[1]);
    if (!second.ok) {
      return xerr(second.txn, second.err);
    }
    cur = second.txn;
    reason = value.to_str(second.val);
  }
  return xok(cur, FReturn(Action { name: s.action, status: status, reason: reason }));
}

function exec_if(ctx: Ctx, t: runtime.Txn, sub: string, s: ast.IfStmt, depth: i32): ExecOut {
  let cur = t;
  for arm in s.arms {
    let c = eval_expr(ctx, cur, sub, arm.cond);
    if (!c.ok) {
      return xerr(c.txn, c.err);
    }
    cur = c.txn;
    if (value.to_bool(c.val)) {
      return exec_block(ctx, cur, sub, arm.body, depth);
    }
  }
  if (s.has_else) {
    return exec_block(ctx, cur, sub, s.else_blk, depth);
  }
  return xok(cur, FNext);
}

function exec_call(ctx: Ctx, t: runtime.Txn, sub: string, s: ast.CallStmt, depth: i32): ExecOut {
  if (depth >= max_call_depth()) {
    return xerr(t, f"call nesting too deep at '{s.name}' (recursive subroutines?)");
  }
  let Some(body) = find_sub(ctx, s.name) else {
    return xerr(t, f"call to undefined subroutine '{s.name}'");
  };
  let out = exec_block(ctx, t, sub, body, depth + 1);
  if (!out.ok) {
    return out;
  }
  if let FReturn(a) = out.flow {
    if (a.name == "none") {
      return xok(out.txn, FNext);
    }
  }
  return out;
}

// fern-lint: allow cyclomatic-complexity
pub function exec_stmt(ctx: Ctx, t: runtime.Txn, sub: string, s: ast.Stmt, depth: i32): ExecOut {
  match (s) {
    SSet(x) => {
      return exec_set(ctx, t, sub, x);
    },
    SUnset(x) => {
      return match (vars.unset(t, sub, x.target)) { Err(m) => xerr(t, m), Ok(next) => xok(next, FNext) };
    },
    SIf(x) => {
      return exec_if(ctx, t, sub, x, depth);
    },
    SReturn(x) => {
      return exec_return(ctx, t, sub, x);
    },
    SCall(x) => {
      return exec_call(ctx, t, sub, x, depth);
    },
    SExpr(x) => {
      let r = eval_expr(ctx, t, sub, x.value);
      if (!r.ok) {
        return xerr(r.txn, r.err);
      }
      return xok(r.txn, FNext);
    },
    SBlock(b) => {
      return exec_block(ctx, t, sub, b, depth);
    },
    SNew(x) => {
      return xerr(t, f"'new {x.name}' needs VMOD objects, which this evaluator does not implement");
    },
    SInclude(x) => {
      return xerr(t, "'include' is resolved before evaluation, not during it");
    },
    SCSource(x) => {
      return xerr(t, "inline C cannot be evaluated");
    }
  }
}

pub function exec_block(ctx: Ctx, t: runtime.Txn, sub: string, b: ast.Block, depth: i32): ExecOut {
  let cur = t;
  for stmt in b.stmts {
    let r = exec_stmt(ctx, cur, sub, stmt, depth);
    if (!r.ok) {
      return r;
    }
    cur = r.txn;
    if let FReturn(_) = r.flow {
      return r;
    }
  }
  return xok(cur, FNext);
}

pub function run_sub(ctx: Ctx, t: runtime.Txn, name: string): ExecOut {
  let Some(body) = find_sub(ctx, name) else {
    return xok(t, FNext);
  };
  return exec_block(ctx, t, name, body, 0);
}

// Match errors use the evaluator's existing error channel.
pub function match_pattern(pattern: string, text: string, negate: boolean): Result[value.Value, string] {
  return match (regex.compile(pattern)) { Ok(compiled) => Ok(VBool(compiled.is_match(text) != negate)), Err(e) => Err(e.to_string()) };
}
