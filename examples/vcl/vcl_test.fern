import "std/test";
import "std/string";
import "std/i32";
import "./ast";
import "./diag";
import "./lexer";
import "./parser";
import "./printer";

function roundtrip(src: string): string {
  let r: parser.ParseResult = parser.parse(src);
  if (r.diags.len() > 0) {
    return "ERR:" + r.diags[0].msg;
  }
  return printer.print_program(r.decls);
}

function diag_count(src: string): i32 {
  return parser.parse(src).diags.len();
}

function tok_texts(src: string): string[] {
  let toks: lexer.Tok[] = lexer.lex(src).toks;
  let out: string[] = [];
  let i: i32 = 0;
  while (i < toks.len() - 1) {
    out = out.append(toks[i].text);
    i = i + 1;
  }
  return out;
}

function test_dashed_header_is_one_token(): test.TestOutcome {
  return test.assert_eq_array(tok_texts("req.http.X-Forwarded-For"), ["req.http.X-Forwarded-For"]);
}

function test_spaced_minus_is_an_operator(): test.TestOutcome {
  return test.assert_eq_array(tok_texts("a - b"), ["a", "-", "b"]);
}

function test_property_name_is_one_token(): test.TestOutcome {
  return test.assert_eq_array(tok_texts(".first_byte_timeout = 5s;"), [".first_byte_timeout", "=", "5", ";"]);
}

function test_ms_beats_m(): test.TestOutcome {
  let toks: lexer.Tok[] = lexer.lex("100ms").toks;
  return test.assert_eq(toks[0].text + "|" + toks[0].aux, "100|ms");
}

function test_byte_unit(): test.TestOutcome {
  let toks: lexer.Tok[] = lexer.lex("256KB").toks;
  return test.assert_eq(toks[0].text + "|" + toks[0].aux, "256|KB");
}

function test_unit_needs_a_boundary(): test.TestOutcome {
  return test.assert_eq_array(tok_texts("10secs"), ["10", "secs"]);
}

function test_comment_forms(): test.TestOutcome {
  return test.assert_eq_array(tok_texts("a # hash\nb // slash\n/* block\nspans */ c"), ["a", "b", "c"]);
}

function test_position_after_block_comment(): test.TestOutcome {
  let toks: lexer.Tok[] = lexer.lex("/* one\ntwo\n*/ here").toks;
  return test.assert_eq(toks[0].line.to_string() + ":" + toks[0].col.to_string(), "3:4");
}

function test_unterminated_string_reports(): test.TestOutcome {
  let r: lexer.LexResult = lexer.lex("sub s { set x = \"oops;\n}");
  return test.assert_eq(r.diags.len(), 1);
}

function test_vcl_version(): test.TestOutcome {
  return test.assert_eq(roundtrip("vcl 4.1;"), "vcl 4.1;\n");
}

function test_import_from(): test.TestOutcome {
  return test.assert_eq(roundtrip("import kv from \"/l/libvmod_kv.so\";"), "import kv from \"/l/libvmod_kv.so\";\n");
}

function test_backend_none(): test.TestOutcome {
  return test.assert_eq(roundtrip("backend broken none;"), "backend broken none;\n");
}

function test_backend_with_inline_probe(): test.TestOutcome {
  return test.assert_eq(roundtrip("backend b { .host = \"1.2.3.4\"; .probe = { .url = \"/\"; } }"), "backend b {\n    .host = \"1.2.3.4\";\n    .probe = {\n        .url = \"/\";\n    }\n}\n");
}

function test_acl_entry_forms(): test.TestOutcome {
  return test.assert_eq(roundtrip("acl a { \"localhost\"; \"192.0.2.0\"/24; ! \"192.0.2.23\"; (\"www.example.com\"); }"), "acl a {\n    \"localhost\";\n    \"192.0.2.0\"/24;\n    ! \"192.0.2.23\";\n    ( \"www.example.com\" );\n}\n");
}

function test_empty_sub(): test.TestOutcome {
  return test.assert_eq(roundtrip("sub vcl_recv { }"), "sub vcl_recv { }\n");
}

function test_top_level_layout(): test.TestOutcome {
  return test.assert_eq(roundtrip("vcl 4.1; import std; import directors;"), "vcl 4.1;\n\nimport std;\nimport directors;\n");
}

function test_set_compound_op(): test.TestOutcome {
  return test.assert_contains(roundtrip("sub s { set req.http.X += \"more\"; }"), "set req.http.X += \"more\";");
}

function test_return_forms(): test.TestOutcome {
  let out: string = roundtrip("sub s { return (hash); } sub t { return (synth(750, \"Moved\")); } sub u { return; }");
  if (!out.contains("return (hash);")) {
    return test.fail("bare action lost: " + out);
  }
  if (!out.contains("return (synth(750, \"Moved\"));")) {
    return test.fail("synth args lost: " + out);
  }
  if (!out.contains("return;\n")) {
    return test.fail("bare return lost: " + out);
  }
  return test.pass();
}

function test_new_and_method_call(): test.TestOutcome {
  let out: string = roundtrip("sub vcl_init { new rr = directors.round_robin(); rr.add_backend(o); }");
  if (!out.contains("new rr = directors.round_robin();")) {
    return test.fail(out);
  }
  if (!out.contains("rr.add_backend(o);")) {
    return test.fail(out);
  }
  return test.pass();
}

function test_unset_and_call(): test.TestOutcome {
  let out: string = roundtrip("sub s { unset req.http.Cookie; call helper; }");
  if (!out.contains("unset req.http.Cookie;")) {
    return test.fail(out);
  }
  if (!out.contains("call helper;")) {
    return test.fail(out);
  }
  return test.pass();
}

function test_elseif_spellings_preserved(): test.TestOutcome {
  let src: string = "sub s { if (a) { call x; } elseif (b) { call y; } elsif (c) { call z; } else if (d) { call w; } else { call v; } }";
  let out: string = roundtrip(src);
  if (!out.contains("} elseif (b) {")) {
    return test.fail("elseif lost: " + out);
  }
  if (!out.contains("} elsif (c) {")) {
    return test.fail("elsif lost: " + out);
  }
  if (!out.contains("} else if (d) {")) {
    return test.fail("else if lost: " + out);
  }
  if (!out.contains("} else {")) {
    return test.fail("else lost: " + out);
  }
  return test.pass();
}

function test_inline_c_block(): test.TestOutcome {
  return test.assert_contains(roundtrip("sub s { C{ VRT_synth(ctx, 1); }C }"), "C{ VRT_synth(ctx, 1); }C");
}

function shape(e: ast.Expr): string {
  match (e) {
    EBinary(b) => {
      return "(" + b.op + " " + shape(b.lhs) + " " + shape(b.rhs) + ")";
    },
    EUnary(u) => {
      return "(" + u.op + " " + shape(u.operand) + ")";
    },
    EParen(inner) => {
      return "[" + shape(inner) + "]";
    },
    ECall(c) => {
      return "(call " + c.callee + ")";
    },
    EVar(v) => {
      return v.name;
    },
    _ => {
      return printer.print_expr(e);
    }
  }
}

function cond_shape(src: string): string {
  let r: parser.ParseResult = parser.parse("sub s { if (" + src + ") { call x; } }");
  if (r.diags.len() > 0) {
    return "ERR:" + r.diags[0].msg;
  }
  match (r.decls[0]) {
    DSub(sub) => {
      match (sub.body.stmts[0]) {
        SIf(i) => {
          return shape(i.arms[0].cond);
        },
        _ => {
          return "ERR:not an if";
        }
      }
    },
    _ => {
      return "ERR:not a sub";
    }
  }
}

function test_and_binds_tighter_than_or(): test.TestOutcome {
  return test.assert_eq(cond_shape("a || b && c"), "(|| a (&& b c))");
}

function test_comparison_and_additive_precedence(): test.TestOutcome {
  return test.assert_eq(cond_shape("a + b == c && d"), "(&& (== (+ a b) c) d)");
}

function test_binary_operators_are_left_associative(): test.TestOutcome {
  return test.assert_eq(cond_shape("a - b - c"), "(- (- a b) c)");
}

function test_parens_regroup_the_tree(): test.TestOutcome {
  return test.assert_eq(cond_shape("(a || b) && c"), "(&& [(|| a b)] c)");
}

function test_not_binds_looser_than_match(): test.TestOutcome {
  return test.assert_eq(cond_shape("!client.ip ~ purgers"), "(! (~ client.ip purgers))");
}

function test_not_does_not_swallow_and(): test.TestOutcome {
  return test.assert_eq(cond_shape("!a && b"), "(&& (! a) b)");
}

function test_numeric_negation_binds_tightly(): test.TestOutcome {
  return test.assert_eq(cond_shape("-a + b"), "(+ (- a) b)");
}

function test_parens_restore_tight_not(): test.TestOutcome {
  return test.assert_eq(cond_shape("(!a) ~ b"), "(~ [(! a)] b)");
}

function test_written_parens_survive(): test.TestOutcome {
  return test.assert_contains(roundtrip("sub s { if ((a || b) && c) { call x; } }"), "if ((a || b) && c)");
}

function test_regex_match_operators(): test.TestOutcome {
  let out: string = roundtrip("sub s { if (req.url ~ \"^/a\" && req.url !~ \"^/b\") { call x; } }");
  return test.assert_contains(out, "if (req.url ~ \"^/a\" && req.url !~ \"^/b\")");
}

function test_acl_match_and_negation(): test.TestOutcome {
  return test.assert_contains(roundtrip("sub s { if (!client.ip ~ purgers) { call x; } }"), "if (!client.ip ~ purgers)");
}

function test_long_string_forms(): test.TestOutcome {
  let out: string = roundtrip("sub s { set a = {\"has \" quote\"}; set b = \"\"\"triple\"\"\"; set c = \"plain\"; }");
  if (!out.contains("{\"has \" quote\"}")) {
    return test.fail("brace form lost: " + out);
  }
  if (!out.contains("\"\"\"triple\"\"\"")) {
    return test.fail("triple form lost: " + out);
  }
  if (!out.contains("\"plain\"")) {
    return test.fail("short form lost: " + out);
  }
  return test.pass();
}

function test_duration_and_bytes_survive(): test.TestOutcome {
  let out: string = roundtrip("sub s { set beresp.ttl = 1h; set x = 256KB; set y = 100ms; }");
  if (!out.contains("= 1h;")) {
    return test.fail(out);
  }
  if (!out.contains("= 256KB;")) {
    return test.fail(out);
  }
  if (!out.contains("= 100ms;")) {
    return test.fail(out);
  }
  return test.pass();
}

function test_recovers_within_a_block(): test.TestOutcome {
  return test.assert_eq(diag_count("sub s { set = 1; unset ; call ; set ok = 1; }"), 3);
}

function test_recovers_across_declarations(): test.TestOutcome {
  let r: parser.ParseResult = parser.parse("backend { .host = \"x\"; } sub vcl_recv { call ok; }");
  if (r.diags.len() == 0) {
    return test.fail("expected a diagnostic for the unnamed backend");
  }
  return test.assert_eq(r.decls.len(), 1);
}

function test_error_inside_if_body_is_reported(): test.TestOutcome {
  return test.assert_eq(diag_count("sub s { if (a) { set = 1; } }"), 1);
}

function test_diagnostic_position(): test.TestOutcome {
  let r: parser.ParseResult = parser.parse("sub s {\n  set = 1;\n}");
  if (r.diags.len() != 1) {
    return test.fail("expected one diagnostic");
  }
  return test.assert_eq(r.diags[0].render("f.vcl"), "f.vcl:2:7: expected a variable name after 'set', found '='");
}

function test_unclosed_brace_reports(): test.TestOutcome {
  return test.assert_contains(roundtrip("sub s { call x;"), "ERR:unclosed '{'");
}

function test_print_is_a_fixed_point(): test.TestOutcome {
  let src: string = "vcl 4.1;\nimport std;\nbackend b { .host = \"1.2.3.4\"; .probe = { .url = \"/\"; } }\nacl a { ! \"10.0.0.0\"/8; }\nsub vcl_recv {\n  if (req.url ~ \"^/x\" || (a && b)) { set req.http.H = \"v\"; return (pass); }\n  elseif (c) { unset req.http.H; }\n  else { std.log({\"long\"}); }\n}\n";
  let once: string = roundtrip(src);
  let twice: string = roundtrip(once);
  return test.assert_eq(twice, once);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("vcl");
  r = r.it("dashed header is one token", test_dashed_header_is_one_token);
  r = r.it("spaced minus is an operator", test_spaced_minus_is_an_operator);
  r = r.it("property name is one token", test_property_name_is_one_token);
  r = r.it("ms beats m", test_ms_beats_m);
  r = r.it("byte unit", test_byte_unit);
  r = r.it("unit needs a boundary", test_unit_needs_a_boundary);
  r = r.it("comment forms", test_comment_forms);
  r = r.it("position after block comment", test_position_after_block_comment);
  r = r.it("unterminated string reports", test_unterminated_string_reports);
  r = r.it("vcl version", test_vcl_version);
  r = r.it("import from", test_import_from);
  r = r.it("backend none", test_backend_none);
  r = r.it("backend with inline probe", test_backend_with_inline_probe);
  r = r.it("acl entry forms", test_acl_entry_forms);
  r = r.it("empty sub", test_empty_sub);
  r = r.it("top level layout", test_top_level_layout);
  r = r.it("set compound op", test_set_compound_op);
  r = r.it("return forms", test_return_forms);
  r = r.it("new and method call", test_new_and_method_call);
  r = r.it("unset and call", test_unset_and_call);
  r = r.it("elseif spellings preserved", test_elseif_spellings_preserved);
  r = r.it("inline c block", test_inline_c_block);
  r = r.it("and binds tighter than or", test_and_binds_tighter_than_or);
  r = r.it("comparison and additive precedence", test_comparison_and_additive_precedence);
  r = r.it("binary operators are left associative", test_binary_operators_are_left_associative);
  r = r.it("parens regroup the tree", test_parens_regroup_the_tree);
  r = r.it("not binds looser than match", test_not_binds_looser_than_match);
  r = r.it("not does not swallow and", test_not_does_not_swallow_and);
  r = r.it("numeric negation binds tightly", test_numeric_negation_binds_tightly);
  r = r.it("parens restore tight not", test_parens_restore_tight_not);
  r = r.it("written parens survive", test_written_parens_survive);
  r = r.it("regex match operators", test_regex_match_operators);
  r = r.it("acl match and negation", test_acl_match_and_negation);
  r = r.it("long string forms", test_long_string_forms);
  r = r.it("duration and bytes survive", test_duration_and_bytes_survive);
  r = r.it("recovers within a block", test_recovers_within_a_block);
  r = r.it("recovers across declarations", test_recovers_across_declarations);
  r = r.it("error inside if body is reported", test_error_inside_if_body_is_reported);
  r = r.it("diagnostic position", test_diagnostic_position);
  r = r.it("unclosed brace reports", test_unclosed_brace_reports);
  r = r.it("print is a fixed point", test_print_is_a_fixed_point);
  return r.finish();
}
