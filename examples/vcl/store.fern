import "std/string";
import "std/i32";
import "std/i64";
import "std/f64";
import "./runtime";

struct Cur { at: i32, ok: boolean }

function field(s: string): string {
  return f"{s.len()}\n{s}";
}

pub function encode(c: runtime.Cache): string {
  let out = f"{c.entries.len()}\n";
  for e in c.entries {
    out += field(e.key);
    out += field(e.status.to_string());
    out += field(e.reason);
    out += f"{e.headers.names.len()}\n";
    for j in 0..e.headers.names.len() {
      out += field(e.headers.names[j]) + field(e.headers.values[j]);
    }
    out += field(e.body);
    out += field(e.ttl.to_string());
    out += field(e.hits.to_string());
  }
  return out;
}

struct IntRead { value: i32, cur: Cur }

function newline_from(s: string, at: i32): Option[i32] {
  for i in at..s.len() {
    if (s[i] == b'\n') {
      return Some(i);
    }
  }
  return None;
}

function read_int(s: string, cur: Cur): IntRead {
  if (!cur.ok) {
    return IntRead { value: 0, cur: cur };
  }
  let failed = IntRead { value: 0, cur: Cur { at: cur.at, ok: false } };
  let Some(nl) = newline_from(s, cur.at) else {
    return failed;
  };
  let digits = slice_unchecked(s, cur.at, nl).to_owned();
  return match (i32.parse_i32(digits)) { Ok(n) => IntRead { value: n, cur: Cur { at: nl + 1, ok: true } }, Err(_) => failed };
}

struct StrRead { value: string, cur: Cur }

function read_field(s: string, cur: Cur): StrRead {
  let n = read_int(s, cur);
  if (!n.cur.ok) {
    return StrRead { value: "", cur: n.cur };
  }
  let end = n.cur.at + n.value;
  if (n.value < 0 || end > s.len()) {
    return StrRead { value: "", cur: Cur { at: n.cur.at, ok: false } };
  }
  return StrRead { value: slice_unchecked(s, n.cur.at, end).to_owned(), cur: Cur { at: end, ok: true } };
}

function to_i64(s: string): i64 {
  return match (i32.parse_i32(s)) { Ok(n) => n as i64, Err(_) => 0 };
}

function to_f64(s: string): f64 {
  return match (f64.parse_f64(s)) { Ok(f) => f, Err(_) => 0.0 };
}

struct EntryRead { entry: runtime.CacheEntry, cur: Cur }

function read_entry(s: string, cur: Cur): EntryRead {
  let blank = runtime.CacheEntry { key: "", status: 0, reason: "", headers: runtime.headers_new(), body: "", ttl: 0.0, hits: 0 };
  let key = read_field(s, cur);
  let status = read_field(s, key.cur);
  let reason = read_field(s, status.cur);
  let nh = read_int(s, reason.cur);
  if (!nh.cur.ok) {
    return EntryRead { entry: blank, cur: nh.cur };
  }
  let h = runtime.headers_new();
  let c = nh.cur;
  for _ in 0..nh.value {
    let name = read_field(s, c);
    let value = read_field(s, name.cur);
    if (!value.cur.ok) {
      return EntryRead { entry: blank, cur: value.cur };
    }
    h = h.set(name.value, value.value);
    c = value.cur;
  }
  let body = read_field(s, c);
  let ttl = read_field(s, body.cur);
  let hits = read_field(s, ttl.cur);
  if (!hits.cur.ok) {
    return EntryRead { entry: blank, cur: hits.cur };
  }
  let e = runtime.CacheEntry { key: key.value, status: to_i64(status.value), reason: reason.value, headers: h, body: body.value, ttl: to_f64(ttl.value), hits: to_i64(hits.value) };
  return EntryRead { entry: e, cur: hits.cur };
}

pub function decode(s: string): runtime.Cache {
  if (s.len() == 0) {
    return runtime.cache_new();
  }
  let n = read_int(s, Cur { at: 0, ok: true });
  if (!n.cur.ok) {
    return runtime.cache_new();
  }
  let out: runtime.CacheEntry[] = [];
  let c = n.cur;
  for _ in 0..n.value {
    let e = read_entry(s, c);
    if (!e.cur.ok) {
      return runtime.cache_new();
    }
    out = out.append(e.entry);
    c = e.cur;
  }
  return runtime.Cache { entries: out };
}
