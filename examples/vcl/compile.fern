// examples/vcl/compile.fern — compile VCL to Fern source.
//
// Fern does not emit C and will not, so the route to a native binary runs
// through Fern itself: this module turns a checked VCL program into a Fern
// module, and `fern` turns that into machine code. No new backend, no C.
//
// What compiling actually buys, over the tree-walk in `eval.fern`:
//
//   * A variable becomes a STRUCT FIELD READ. `req.url` compiles to
//     `t.req.url`, not a lookup of "req.url" in a table followed by a
//     scope check. The check has already happened — `check.fern` proved
//     the name legal in that subroutine — so none of it survives to run
//     time.
//   * Control flow becomes Fern control flow. An `if` is an `if`, not a
//     walk over an arm list.
//   * Constants fold. `1h` is `VDuration(3600.0)` in the output, and an
//     ACL's `/24` becomes a pre-computed mask in a generated function.
//
// Expressions are emitted in A-normal form: each subexpression lands in
// its own local, and anything that can fail is followed by an explicit
// check. That is more verbose than nesting calls, and it is what keeps
// compiled and interpreted behaviour identical — `&&` short-circuits
// through a real `if`, and an arithmetic type error returns the same
// diagnostic the interpreter would, rather than being swallowed.
//
// The state machine is NOT generated: `machine.fern` takes a `Driver`, and
// generated code supplies its own dispatcher. The graph is the same for
// every policy, so there is one copy of it.
import "std/i32";
import "std/string";
import "std/utf8";
import "std/i64";
import "std/f64";
import "std/array";
import "core/cmp";
import "./ast";
import "./value";
import "./vars";
import "./eval";
import "./machine";

pub function quote(s: string): string {
  let out = "\"";
  for i in 0..s.len() {
    match (s[i]) {
      b'"' => {
        out += "\\\"";
      },
      b'\\' => {
        out += "\\\\";
      },
      b'\n' => {
        out += "\\n";
      },
      b'\t' => {
        out += "\\t";
      },
      b'\r' => {
        out += "\\r";
      },
      _ => {
        if (utf8.is_char_boundary(s, i)) {
          out += slice_unchecked(s, i, utf8.ceil_char_boundary(s, i + 1));
        }
      }
    }
  }
  return out + "\"";
}

function object_of(name: string): string {
  if (name.starts_with("req.")) {
    return "req";
  }
  if (name.starts_with("bereq.")) {
    return "bereq";
  }
  if (name.starts_with("beresp.")) {
    return "beresp";
  }
  if (name.starts_with("resp.")) {
    return "resp";
  }
  if (name.starts_with("obj.")) {
    return "obj";
  }
  return "";
}

function header_key(name: string): string {
  let obj = object_of(name);
  let prefix = obj + ".http.";
  return slice_unchecked(name, prefix.len(), name.len()).to_owned();
}

function is_header(name: string): boolean {
  return name.contains(".http.");
}

// fern-lint: allow cyclomatic-complexity
pub function read_code(name: string): string {
  if (is_header(name)) {
    return f"t.{object_of(name)}.headers.get({quote(header_key(name))})";
  }
  match (name) {
    "req.method" => {
      return "VString(t.req.method)";
    },
    "req.url" => {
      return "VString(t.req.url)";
    },
    "req.proto" => {
      return "VString(t.req.proto)";
    },
    "req.backend_hint" => {
      return "VBackend(t.backend_hint)";
    },
    "bereq.method" => {
      return "VString(t.bereq.method)";
    },
    "bereq.url" => {
      return "VString(t.bereq.url)";
    },
    "bereq.proto" => {
      return "VString(t.bereq.proto)";
    },
    "beresp.status" => {
      return "VInt(t.beresp.status)";
    },
    "beresp.reason" => {
      return "VString(t.beresp.reason)";
    },
    "beresp.proto" => {
      return "VString(t.beresp.proto)";
    },
    "beresp.ttl" => {
      return "VDuration(t.beresp_ttl)";
    },
    "beresp.grace" => {
      return "VDuration(t.beresp_grace)";
    },
    "beresp.keep" => {
      return "VDuration(t.beresp_keep)";
    },
    "beresp.uncacheable" => {
      return "VBool(t.beresp_uncacheable)";
    },
    "resp.status" => {
      return "VInt(t.resp.status)";
    },
    "resp.reason" => {
      return "VString(t.resp.reason)";
    },
    "resp.proto" => {
      return "VString(t.resp.proto)";
    },
    "obj.status" => {
      return "VInt(t.obj.status)";
    },
    "obj.reason" => {
      return "VString(t.obj.reason)";
    },
    "obj.ttl" => {
      return "VDuration(t.obj_ttl)";
    },
    "obj.hits" => {
      return "VInt(t.obj_hits)";
    },
    "client.ip" => {
      return "VString(t.client_ip)";
    },
    _ => {
      return "VString(t.server_ip)";
    }
  }
}

function msg_update(obj: string, field: string, expr: string): string {
  return f"t = runtime.Txn {{ ...t, {obj}: runtime.Msg {{ ...t.{obj}, {field}: {expr} }} }};";
}

function txn_update(field: string, expr: string): string {
  return f"t = runtime.Txn {{ ...t, {field}: {expr} }};";
}

// fern-lint: allow cyclomatic-complexity
pub function write_code(name: string, v: string): string {
  if (is_header(name)) {
    let obj = object_of(name);
    return msg_update(obj, "headers", f"t.{obj}.headers.set({quote(header_key(name))}, value.to_str({v}))");
  }
  match (name) {
    "req.method" => {
      return msg_update("req", "method", f"value.to_str({v})");
    },
    "req.url" => {
      return msg_update("req", "url", f"value.to_str({v})");
    },
    "req.backend_hint" => {
      return txn_update("backend_hint", f"value.to_str({v})");
    },
    "bereq.method" => {
      return msg_update("bereq", "method", f"value.to_str({v})");
    },
    "bereq.url" => {
      return msg_update("bereq", "url", f"value.to_str({v})");
    },
    "bereq.proto" => {
      return msg_update("bereq", "proto", f"value.to_str({v})");
    },
    "beresp.status" => {
      return msg_update("beresp", "status", f"vars.as_int({v})");
    },
    "beresp.reason" => {
      return msg_update("beresp", "reason", f"value.to_str({v})");
    },
    "beresp.proto" => {
      return msg_update("beresp", "proto", f"value.to_str({v})");
    },
    "beresp.ttl" => {
      return txn_update("beresp_ttl", f"vars.as_secs({v})");
    },
    "beresp.grace" => {
      return txn_update("beresp_grace", f"vars.as_secs({v})");
    },
    "beresp.keep" => {
      return txn_update("beresp_keep", f"vars.as_secs({v})");
    },
    "beresp.uncacheable" => {
      return txn_update("beresp_uncacheable", f"value.to_bool({v})");
    },
    "resp.status" => {
      return msg_update("resp", "status", f"vars.as_int({v})");
    },
    "resp.reason" => {
      return msg_update("resp", "reason", f"value.to_str({v})");
    },
    _ => {
      return msg_update("resp", "proto", f"value.to_str({v})");
    }
  }
}

pub function unset_code(name: string): string {
  let obj = object_of(name);
  return msg_update(obj, "headers", f"t.{obj}.headers.unset({quote(header_key(name))})");
}

struct Emit { code: string, name: string, next: i32, ok: boolean, err: string }

function emit_err(msg: string): Emit {
  return Emit { code: "", name: "", next: 0, ok: false, err: msg };
}

function tmp(n: i32): string {
  return f"v{n}";
}

function bind(ind: string, n: i32, expr: string): Emit {
  return Emit { code: f"{ind}let {tmp(n)}: value.Value = {expr};\n", name: tmp(n), next: n + 1, ok: true, err: "" };
}

function bind_checked(ind: string, n: i32, expr: string): Emit {
  let res = f"r{n}";
  let out = tmp(n);
  let code = f"{ind}let {res}: Result[value.Value, string] = {expr};\n{ind}let {out}: value.Value = VNone;\n{ind}match ({res}) {{\n{ind}  Err(m) => {{\n{ind}    return eval.failed(t, m);\n{ind}  }},\n{ind}  Ok(ok{n}) => {{\n{ind}    {out} = ok{n};\n{ind}  }}\n{ind}}}\n";
  return Emit { code: code, name: out, next: n + 1, ok: true, err: "" };
}

function num_literal(text: string): Option[string] {
  if (text.contains(".")) {
    return match (f64.parse_f64(text)) { Ok(f) => Some(f"VReal({f})"), Err(_) => None };
  }
  return match (i32.parse_i32(text)) { Ok(v) => Some(f"VInt({v})"), Err(_) => None };
}

function qty_number(text: string): f64 {
  return match (f64.parse_f64(text)) { Ok(f) => f, Err(_) => 0.0 };
}

// fern-lint: allow cyclomatic-complexity
function literal_code(e: ast.Expr): Result[string, string] {
  match (e) {
    EString(s) => {
      return Ok(f"VString({quote(s.value)})");
    },
    EBool(b) => {
      return Ok(if (b.value) { "VBool(true)" } else { "VBool(false)" });
    },
    ENumber(n) => {
      return match (num_literal(n.text)) { Some(code) => Ok(code), None => Err(f"malformed number '{n.text}'") };
    },
    EDuration(q) => {
      let secs = value.duration_seconds(qty_number(q.text), q.unit)?;
      return Ok(f"VDuration({secs})");
    },
    EBytes(q) => {
      let count = value.byte_count(qty_number(q.text), q.unit)?;
      return Ok(f"VBytes({count})");
    },
    _ => {
      return Err("not a literal");
    }
  }
}

pub struct Env { acls: string[], backends: machine.Backend[] }

function has_backend(env: Env, name: string): boolean {
  for b in env.backends {
    if (b.name == name) {
      return true;
    }
  }
  return false;
}

function name_code(env: Env, name: string): Result[string, string] {
  if (vars.is_var(name)) {
    return Ok(read_code(name));
  }
  if (has_backend(env, name)) {
    return Ok(f"VBackend({quote(name)})");
  }
  if (cmp.contains(env.acls, name)) {
    return Ok(f"VAcl({quote(name)})");
  }
  if (name == "true") {
    return Ok("VBool(true)");
  }
  if (name == "false") {
    return Ok("VBool(false)");
  }
  return Err(f"unknown name '{name}'");
}

function is_ordering(op: string): boolean {
  return op == "<" || op == "<=" || op == ">" || op == ">=";
}

function acl_operand(env: Env, e: ast.Expr): Option[string] {
  if let EVar(v) = e {
    if (cmp.contains(env.acls, v.name)) {
      return Some(v.name);
    }
  }
  return None;
}

struct Seq { code: string, names: string[], next: i32, ok: boolean, err: string }

function emit_seq(env: Env, es: ast.Expr[], ind: string, n: i32): Seq {
  let code = "";
  let names: string[] = [];
  let cur = n;
  for x in es {
    let e = emit_expr(env, x, ind, cur);
    if (!e.ok) {
      return Seq { code: "", names: names, next: cur, ok: false, err: e.err };
    }
    code += e.code;
    names = names.append(e.name);
    cur = e.next;
  }
  return Seq { code: code, names: names, next: cur, ok: true, err: "" };
}

function emit_call(env: Env, c: ast.CallExpr, ind: string, n: i32): Emit {
  let args = emit_seq(env, c.args, ind, n);
  if (!args.ok) {
    return emit_err(args.err);
  }
  let cur = args.next;
  let lst = args.names.join(", ");
  let res = f"c{cur}";
  let out = tmp(cur);
  let code = f"{args.code}{ind}let a{cur}: value.Value[] = [{lst}];\n{ind}let {res}: eval.EvalOut = eval.call_builtin(t, {quote(c.callee)}, a{cur});\n{ind}if (!{res}.ok) {{\n{ind}  return eval.failed({res}.txn, {res}.err);\n{ind}}}\n{ind}t = {res}.txn;\n{ind}let {out}: value.Value = {res}.val;\n";
  return Emit { code: code, name: out, next: cur + 1, ok: true, err: "" };
}

function emit_logical(env: Env, b: ast.BinExpr, ind: string, n: i32): Emit {
  let left = emit_expr(env, b.lhs, ind, n);
  if (!left.ok) {
    return left;
  }
  let out = tmp(left.next);
  let inner = left.next + 1;
  let and = b.op == "&&";
  let seed = if (and) { "VBool(false)" } else { "VBool(true)" };
  let gate = if (and) { f"if (value.to_bool({left.name}))" } else { f"if (!value.to_bool({left.name}))" };
  let right = emit_expr(env, b.rhs, ind + "  ", inner);
  if (!right.ok) {
    return right;
  }
  let code = f"{left.code}{ind}let {out}: value.Value = {seed};\n{ind}{gate} {{\n{right.code}{ind}  {out} = VBool(value.to_bool({right.name}));\n{ind}}}\n";
  return Emit { code: code, name: out, next: right.next, ok: true, err: "" };
}

function emit_match(env: Env, b: ast.BinExpr, ind: string, n: i32): Emit {
  let negated = b.op == "!~";
  let left = emit_expr(env, b.lhs, ind, n);
  if (!left.ok) {
    return left;
  }
  if let Some(acl) = acl_operand(env, b.rhs) {
    let negate = if (negated) { "!" } else { "" };
    let hit = bind(ind, left.next, f"VBool({negate}acl_{acl}(value.to_str({left.name})))");
    return Emit { code: left.code + hit.code, name: hit.name, next: hit.next, ok: true, err: "" };
  }
  let right = emit_expr(env, b.rhs, ind, left.next);
  if (!right.ok) {
    return right;
  }
  let m = bind_checked(ind, right.next, f"eval.match_pattern(value.to_str({right.name}), value.to_str({left.name}), {negated})");
  return Emit { code: left.code + right.code + m.code, name: m.name, next: m.next, ok: true, err: "" };
}

function emit_binary(env: Env, b: ast.BinExpr, ind: string, n: i32): Emit {
  let cls = eval.op_class(b.op);
  if (cls == "match") {
    return emit_match(env, b, ind, n);
  }
  if (cls == "logical") {
    return emit_logical(env, b, ind, n);
  }
  let left = emit_expr(env, b.lhs, ind, n);
  if (!left.ok) {
    return left;
  }
  let right = emit_expr(env, b.rhs, ind, left.next);
  if (!right.ok) {
    return right;
  }
  let pre = left.code + right.code;
  if (cls == "compare" && !is_ordering(b.op)) {
    let neg = if (b.op == "!=") { "!" } else { "" };
    let eq = bind(ind, right.next, f"VBool({neg}value.equal({left.name}, {right.name}))");
    return Emit { code: pre + eq.code, name: eq.name, next: eq.next, ok: true, err: "" };
  }
  if (is_ordering(b.op)) {
    return emit_ordering(pre, b.op, left.name, right.name, ind, right.next);
  }
  let ar = bind_checked(ind, right.next, f"value.arith({quote(b.op)}, {left.name}, {right.name})");
  return Emit { code: pre + ar.code, name: ar.name, next: ar.next, ok: true, err: "" };
}

function emit_ordering(pre: string, op: string, l: string, r: string, ind: string, n: i32): Emit {
  let res = f"o{n}";
  let out = tmp(n);
  let code = f"{ind}let {res}: Result[i32, string] = value.compare({l}, {r});\n{ind}let {out}: value.Value = VNone;\n{ind}match ({res}) {{\n{ind}  Err(m) => {{\n{ind}    return eval.failed(t, m);\n{ind}  }},\n{ind}  Ok({res}v) => {{\n{ind}    {out} = VBool({res}v {op} 0);\n{ind}  }}\n{ind}}}\n";
  return Emit { code: pre + code, name: out, next: n + 1, ok: true, err: "" };
}

// fern-lint: allow cyclomatic-complexity
pub function emit_expr(env: Env, e: ast.Expr, ind: string, n: i32): Emit {
  match (e) {
    EVar(v) => {
      return match (name_code(env, v.name)) { Ok(code) => bind(ind, n, code), Err(m) => emit_err(m) };
    },
    ECall(c) => {
      return emit_call(env, c, ind, n);
    },
    EBinary(b) => {
      return emit_binary(env, b, ind, n);
    },
    EUnary(u) => {
      let inner = emit_expr(env, u.operand, ind, n);
      if (!inner.ok) {
        return inner;
      }
      if (u.op == "!") {
        let not = bind(ind, inner.next, f"VBool(!value.to_bool({inner.name}))");
        return Emit { code: inner.code + not.code, name: not.name, next: not.next, ok: true, err: "" };
      }
      let neg = bind_checked(ind, inner.next, f"value.arith(\"-\", VInt(0), {inner.name})");
      return Emit { code: inner.code + neg.code, name: neg.name, next: neg.next, ok: true, err: "" };
    },
    EParen(inner) => {
      return emit_expr(env, inner, ind, n);
    },
    _ => {
      return match (literal_code(e)) { Ok(code) => bind(ind, n, code), Err(m) => emit_err(m) };
    }
  }
}

struct Stmts { code: string, next: i32, ok: boolean, err: string }

function stmts_err(msg: string): Stmts {
  return Stmts { code: "", next: 0, ok: false, err: msg };
}

function emit_set(env: Env, s: ast.SetStmt, ind: string, n: i32): Stmts {
  let v = emit_expr(env, s.value, ind, n);
  if (!v.ok) {
    return stmts_err(v.err);
  }
  let code = v.code;
  let src = v.name;
  let cur = v.next;
  if (s.op != "=") {
    let op = slice_unchecked(s.op, 0, s.op.len() - 1).to_owned();
    let old = bind(ind, cur, read_code(s.target));
    let combined = bind_checked(ind, old.next, f"value.arith({quote(op)}, {old.name}, {src})");
    code += old.code + combined.code;
    src = combined.name;
    cur = combined.next;
  }
  return Stmts { code: f"{code}{ind}{write_code(s.target, src)}\n", next: cur, ok: true, err: "" };
}

function emit_return(env: Env, s: ast.ReturnStmt, ind: string, n: i32): Stmts {
  if (s.action == "") {
    return Stmts { code: ind + "return eval.returned(t, eval.action(\"none\"));\n", next: n, ok: true, err: "" };
  }
  if (!s.has_args || s.args.len() == 0) {
    return Stmts { code: f"{ind}return eval.returned(t, eval.action({quote(s.action)}));\n", next: n, ok: true, err: "" };
  }
  let args = emit_seq(env, s.args, ind, n);
  if (!args.ok) {
    return stmts_err(args.err);
  }
  let status = if (args.names.len() > 0) { f"vars.as_int({args.names[0]})" } else { "0" };
  let reason = if (args.names.len() > 1) { f"value.to_str({args.names[1]})" } else { "\"\"" };
  let code = f"{args.code}{ind}return eval.returned(t, eval.synth_action({quote(s.action)}, {status}, {reason}));\n";
  return Stmts { code: code, next: args.next, ok: true, err: "" };
}

function emit_call_stmt(s: ast.CallStmt, ind: string, n: i32): Stmts {
  let res = f"s{n}";
  let code = f"{ind}let {res}: eval.ExecOut = sub_{s.name}(t);\n{ind}if (!{res}.ok) {{\n{ind}  return {res};\n{ind}}}\n{ind}t = {res}.txn;\n{ind}match ({res}.flow) {{\n{ind}  FReturn(a{n}) => {{\n{ind}    if (a{n}.name != \"none\") {{\n{ind}      return {res};\n{ind}    }}\n{ind}  }},\n{ind}  FNext => {{}}\n{ind}}}\n";
  return Stmts { code: code, next: n + 1, ok: true, err: "" };
}

function emit_if(env: Env, s: ast.IfStmt, ind: string, n: i32): Stmts {
  return emit_arm(env, s, 0, ind, n);
}

function emit_arm(env: Env, s: ast.IfStmt, idx: i32, ind: string, n: i32): Stmts {
  if (idx >= s.arms.len()) {
    if (s.has_else) {
      return emit_block(env, s.else_blk, ind, n);
    }
    return Stmts { code: "", next: n, ok: true, err: "" };
  }
  let arm = s.arms[idx];
  let cond = emit_expr(env, arm.cond, ind, n);
  if (!cond.ok) {
    return stmts_err(cond.err);
  }
  let body = emit_block(env, arm.body, ind + "  ", cond.next);
  if (!body.ok) {
    return body;
  }
  let rest = emit_arm(env, s, idx + 1, ind + "  ", body.next);
  if (!rest.ok) {
    return rest;
  }
  let code = f"{cond.code}{ind}if (value.to_bool({cond.name})) {{\n{body.code}{ind}}}";
  if (rest.code == "") {
    return Stmts { code: code + "\n", next: rest.next, ok: true, err: "" };
  }
  return Stmts { code: f"{code} else {{\n{rest.code}{ind}}}\n", next: rest.next, ok: true, err: "" };
}

// fern-lint: allow cyclomatic-complexity
function emit_stmt(env: Env, s: ast.Stmt, ind: string, n: i32): Stmts {
  match (s) {
    SSet(x) => {
      return emit_set(env, x, ind, n);
    },
    SUnset(x) => {
      return Stmts { code: f"{ind}{unset_code(x.target)}\n", next: n, ok: true, err: "" };
    },
    SIf(x) => {
      return emit_if(env, x, ind, n);
    },
    SReturn(x) => {
      return emit_return(env, x, ind, n);
    },
    SCall(x) => {
      return emit_call_stmt(x, ind, n);
    },
    SExpr(x) => {
      let e = emit_expr(env, x.value, ind, n);
      if (!e.ok) {
        return stmts_err(e.err);
      }
      return Stmts { code: e.code, next: e.next, ok: true, err: "" };
    },
    SBlock(b) => {
      return emit_block(env, b, ind, n);
    },
    SNew(x) => {
      return stmts_err(f"'new {x.name}' needs VMOD objects, which are not implemented");
    },
    SInclude(x) => {
      return stmts_err("'include' must be resolved before compiling");
    },
    SCSource(x) => {
      return stmts_err("inline C cannot be compiled");
    }
  }
}

function emit_block(env: Env, b: ast.Block, ind: string, n: i32): Stmts {
  let code = "";
  let cur = n;
  for stmt in b.stmts {
    let s = emit_stmt(env, stmt, ind, cur);
    if (!s.ok) {
      return s;
    }
    code += s.code;
    cur = s.next;
  }
  return Stmts { code: code, next: cur, ok: true, err: "" };
}

function emit_acl(a: ast.AclDecl): Result[string, string] {
  let code = f"// ACL `{a.name}`, compiled: masks folded, longest prefix wins.\nfunction acl_{a.name}(addr: string): boolean {{\n" + "  match (eval.parse_ipv4(addr)) {\n" + "    None => {\n      return false;\n    },\n" + "    Some(ip) => {\n" + "      let best: i32 = 0 - 1;\n" + "      let neg: boolean = false;\n";
  for e in a.entries {
    let Some(base) = eval.parse_ipv4(e.host) else {
      return Err(f"ACL entry '{e.host}' is not an IPv4 address or 'localhost'");
    };
    let bits = 32;
    if (e.mask != "") {
      let Ok(b) = i32.parse_i32(e.mask) else {
        return Err(f"ACL mask '{e.mask}' is not a number");
      };
      bits = b;
    }
    if (bits < 0 || bits > 32) {
      return Err(f"ACL mask /{e.mask} is out of range");
    }
    let m = eval.mask_of(bits);
    let masked = base & m;
    code += f"      if ((ip & {m}) == {masked} && {bits} > best) {{\n        best = {bits};\n        neg = {e.negated};\n      }}\n";
  }
  return Ok(code + "      if (best < 0) {\n        return false;\n      }\n" + "      return !neg;\n    }\n  }\n}\n");
}

function emit_sub(env: Env, s: ast.SubDecl): Result[string, string] {
  let body = emit_block(env, s.body, "  ", 0);
  if (!body.ok) {
    return Err(f"in sub {s.name}: {body.err}");
  }
  return Ok(f"function sub_{s.name}(t0: runtime.Txn): eval.ExecOut {{\n  let t: runtime.Txn = t0;\n{body.code}  return eval.fell_through(t);\n}}\n");
}

pub function env_of(decls: ast.Decl[]): Env {
  let acls: string[] = [];
  for d in decls {
    if let DAcl(a) = d {
      acls = acls.append(a.name);
    }
  }
  return Env { acls: acls, backends: machine.backends_of(decls) };
}

function sub_names(decls: ast.Decl[]): string[] {
  let out: string[] = [];
  for d in decls {
    if let DSub(s) = d {
      out = out.append(s.name);
    }
  }
  return out;
}

function emit_dispatch(names: string[]): string {
  let code = "// The dispatcher `machine.Driver` calls. A subroutine this policy does\n" + "// not define falls through, so the built-in default applies.\n" + "function run_sub(name: string, t: runtime.Txn): eval.ExecOut {\n";
  for name in names {
    code += f"  if (name == {quote(name)}) {{\n    return sub_{name}(t);\n  }}\n";
  }
  return code + "  return eval.fell_through(t);\n}\n";
}

function backend_list(env: Env): string {
  let lits: string[] = [];
  for b in env.backends {
    lits = lits.append(f"machine.Backend {{ name: {quote(b.name)}, host: {quote(b.host)}, port: {b.port} }}");
  }
  if (lits.len() == 0) {
    return "let __b: machine.Backend[] = [];";
  }
  return f"let __b: machine.Backend[] = [{lits.join(", ")}];";
}

pub function compile(decls: ast.Decl[], prefix: string): Result[string, string] {
  let env = env_of(decls);
  let out = "// Generated from VCL by examples/vcl/compile.fern. Do not edit.\n" + "//\n" + "// Variable reads are struct field accesses: the scoping check ran at\n" + "// compile time, so none of it survives here.\n" + "import \"std/string\";\nimport \"std/i64\";\nimport \"std/f64\";\n" + f"import {quote(prefix + "value")};\nimport {quote(prefix + "runtime")};\nimport {quote(prefix + "vars")};\n" + f"import {quote(prefix + "eval")};\nimport {quote(prefix + "machine")};\nimport {quote(prefix + "report")};\n\n";
  for d in decls {
    match (d) {
      DAcl(a) => {
        out += emit_acl(a)? + "\n";
      },
      DSub(s) => {
        out += emit_sub(env, s)? + "\n";
      },
      _ => {}
    }
  }
  out += emit_dispatch(sub_names(decls)) + "\n";
  return Ok(out + main_code(env));
}

function main_code(env: Env): string {
  return "// The policy's own entry point: same command line as vclrun, with this\n" + "// policy compiled in rather than parsed at startup.\n" + "function main(): i32 {\n" + "  let argv: string[] = args();\n" + f"  {backend_list(env)}\n" + "  let d: machine.Driver = machine.Driver { run_sub: run_sub, backends: __b, fetch: machine.mock_fetch };\n" + "  return report.drive(d, argv);\n" + "}\n";
}
