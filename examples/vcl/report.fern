// examples/vcl/report.fern — the request command line and the transaction
// report, shared by `vclrun` and by every compiled policy.
//
// A compiled policy is a program in its own right and needs the same
// front door as the interpreter's driver: parse a method, a URL, optional
// headers, and run. Putting that here means the two cannot drift, and a
// compiled policy's output can be diffed against the interpreter's
// directly — which is exactly how the differential test checks that
// compiling changed nothing.
import "std/string";
import "std/i64";
import "std/float";
import "./runtime";
import "./machine";

pub struct Args { method: string, url: string, client_ip: string, names: string[], values: string[], repeat: i32, ok: boolean }

// parse_args reads `METHOD URL [CLIENT_IP] [Name:Value ...] [-n COUNT]`
// starting at `first`.
pub function parse_args(argv: string[], first: i32): Args {
  var n: string[] = [];
  var v: string[] = [];
  var bad: Args = Args { method: "", url: "", client_ip: "", names: n, values: v, repeat: 1, ok: false };
  if (argv.len() < first + 2) {
    return bad;
  }
  var a: Args = Args { method: argv[first], url: argv[first + 1], client_ip: "127.0.0.1", names: n, values: v, repeat: 1, ok: true };
  var i: i32 = first + 2;
  while (i < argv.len()) {
    var arg: string = argv[i];
    if (arg == "-n" && i + 1 < argv.len()) {
      match (argv[i + 1].parse_int()) {
        Some(c) => {
          a = Args { ...a, repeat: c };
        },
        None => {
          return bad;
        }
      }
      i = i + 2;
    } else if (arg.contains(":")) {
      match (arg.split_once(":")) {
        Some(pair) => {
          a = Args { ...a, names: a.names.append(pair.0), values: a.values.append(pair.1) };
        },
        None => {}
      }
      i = i + 1;
    } else {
      a = Args { ...a, client_ip: arg };
      i = i + 1;
    }
  }
  return a;
}

pub function join(items: string[], sep: string): string {
  var out: string = "";
  var i: i32 = 0;
  while (i < items.len()) {
    if (i > 0) {
      out = out + sep;
    }
    out = out + items[i];
    i = i + 1;
  }
  return out;
}

function print_headers(h: runtime.Headers, indent: string): void {
  var i: i32 = 0;
  while (i < h.names.len()) {
    print(indent + h.names[i] + ": " + h.values[i]);
    i = i + 1;
  }
}

// print_outcome reports one transaction. The subroutine path leads,
// because it is the explanation for everything below it.
pub function print_outcome(o: machine.Outcome, n: i32): void {
  print("--- request " + n.to_string() + " ---");
  print("  path:        " + join(o.steps, " -> "));
  var hit: string = "miss";
  if (o.hit) {
    hit = "HIT";
  }
  print("  disposition: " + o.disposition + " (" + hit + ")");
  print("  status:      " + o.txn.resp.status.to_string() + " " + o.txn.resp.reason);
  print("  response headers:");
  print_headers(o.txn.resp.headers, "    ");
  if (o.txn.log.len() > 0) {
    print("  log:");
    var i: i32 = 0;
    while (i < o.txn.log.len()) {
      print("    " + o.txn.log[i]);
      i = i + 1;
    }
  }
}

// run_all drives `repeat` requests against one cache, so a second
// identical request can hit what the first stored.
pub function run_all(d: machine.Driver, a: Args): i32 {
  var cache: runtime.Cache = runtime.cache_new();
  var i: i32 = 0;
  while (i < a.repeat) {
    var o: machine.Outcome = machine.run_with(d, a.method, a.url, a.client_ip, a.names, a.values, cache);
    if (!o.ok) {
      eprint("vcl: " + o.err);
      eprint("     after " + join(o.steps, " -> "));
      return 1;
    }
    print_outcome(o, i + 1);
    cache = o.cache;
    i = i + 1;
  }
  return 0;
}

// drive is the whole command line for a compiled policy: argv[0] is the
// program name, so the request starts at 1.
pub function drive(d: machine.Driver, argv: string[]): i32 {
  var a: Args = parse_args(argv, 1);
  if (!a.ok) {
    eprint("usage: POLICY METHOD URL [CLIENT_IP] [Name:Value ...] [-n COUNT]");
    return 2;
  }
  return run_all(d, a);
}
