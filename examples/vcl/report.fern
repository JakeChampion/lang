// examples/vcl/report.fern — the request command line and the transaction
// report, shared by `vclrun` and by every compiled policy.
//
// A compiled policy is a program in its own right and needs the same
// entry point as the interpreter's driver: parse a method, a URL, optional
// headers, and run. Putting that here means the two cannot drift, and a
// compiled policy's output can be diffed against the interpreter's
// directly — which is exactly how the differential test checks that
// compiling changed nothing.
import "std/i32";
import "std/string";
import "std/i64";
import "std/f64";
import "std/array";
import "./runtime";
import "./machine";

pub struct Args { method: string, url: string, client_ip: string, names: string[], values: string[], repeat: i32, ok: boolean }

pub function parse_args(argv: string[], first: i32): Args {
  let n: string[] = [];
  let v: string[] = [];
  let bad = Args { method: "", url: "", client_ip: "", names: n, values: v, repeat: 1, ok: false };
  if (argv.len() < first + 2) {
    return bad;
  }
  let a = Args { method: argv[first], url: argv[first + 1], client_ip: "127.0.0.1", names: n, values: v, repeat: 1, ok: true };
  let i = first + 2;
  while (i < argv.len()) {
    let arg = argv[i];
    if (arg == "-n" && i + 1 < argv.len()) {
      let Ok(c) = i32.parse_i32(argv[i + 1]) else {
        return bad;
      };
      a = Args { ...a, repeat: c };
      i += 2;
    } else if (arg.contains(":")) {
      if let Some(pair) = arg.split_once(":") {
        a = Args { ...a, names: a.names.append(pair.0), values: a.values.append(pair.1) };
      }
      i += 1;
    } else {
      a = Args { ...a, client_ip: arg };
      i += 1;
    }
  }
  return a;
}

function print_headers(h: runtime.Headers, indent: string): void {
  for i in 0..h.names.len() {
    print(f"{indent}{h.names[i]}: {h.values[i]}");
  }
}

pub function print_outcome(o: machine.Outcome, n: i32): void {
  print(f"--- request {n} ---");
  print("  path:        " + o.steps.join(" -> "));
  let hit = if (o.hit) { "HIT" } else { "miss" };
  print(f"  disposition: {o.disposition} ({hit})");
  print(f"  status:      {o.txn.resp.status} {o.txn.resp.reason}");
  print("  response headers:");
  print_headers(o.txn.resp.headers, "    ");
  if (o.txn.log.len() > 0) {
    print("  log:");
    for line in o.txn.log {
      print("    " + line);
    }
  }
}

pub function run_all(d: machine.Driver, a: Args): i32 {
  let cache = runtime.cache_new();
  for i in 0..a.repeat {
    let o = machine.run_with(d, a.method, a.url, a.client_ip, a.names, a.values, cache);
    if (!o.ok) {
      eprint("vcl: " + o.err);
      eprint("     after " + o.steps.join(" -> "));
      return 1;
    }
    print_outcome(o, i + 1);
    cache = o.cache;
  }
  return 0;
}

pub function drive(d: machine.Driver, argv: string[]): i32 {
  let a = parse_args(argv, 1);
  if (!a.ok) {
    eprint("usage: POLICY METHOD URL [CLIENT_IP] [Name:Value ...] [-n COUNT]");
    return 2;
  }
  return run_all(d, a);
}
