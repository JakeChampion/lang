import "std/string";
import "std/i64";
import "std/f64";

pub enum Value { VString(string), VInt(i64), VReal(f64), VDuration(f64), VBytes(i64), VBool(boolean), VBackend(string), VAcl(string), VNone }

pub function type_name(v: Value): string {
  match (v) {
    VString(_) => {
      return "STRING";
    },
    VInt(_) => {
      return "INT";
    },
    VReal(_) => {
      return "REAL";
    },
    VDuration(_) => {
      return "DURATION";
    },
    VBytes(_) => {
      return "BYTES";
    },
    VBool(_) => {
      return "BOOL";
    },
    VBackend(_) => {
      return "BACKEND";
    },
    VAcl(_) => {
      return "ACL";
    },
    VNone => {
      return "NULL";
    }
  }
}

// fern-lint: allow cyclomatic-complexity
pub function to_str(v: Value): string {
  match (v) {
    VString(s) => {
      return s;
    },
    VInt(n) => {
      return n.to_string();
    },
    VReal(r) => {
      return r.to_string_prec(3);
    },
    VDuration(d) => {
      return d.to_string_prec(3);
    },
    VBytes(b) => {
      return b.to_string();
    },
    VBool(true) => {
      return "true";
    },
    VBool(false) => {
      return "false";
    },
    VBackend(n) => {
      return n;
    },
    VAcl(n) => {
      return n;
    },
    VNone => {
      return "";
    }
  }
}

pub function to_bool(v: Value): boolean {
  return match (v) { VBool(b) => b, VNone => false, VInt(n) => n != 0, _ => true };
}

function is_string(v: Value): boolean {
  return match (v) { VString(_) | VNone => true, _ => false };
}

function as_f64(v: Value): f64 {
  return match (v) { VInt(n) => n as f64, VBytes(b) => b as f64, VReal(r) => r, VDuration(d) => d, VBool(true) => 1.0, VBool(false) => 0.0, _ => 0.0 };
}

function as_i64(v: Value): i64 {
  return match (v) { VInt(n) => n, VBytes(b) => b, _ => 0 };
}

function is_int(v: Value): boolean {
  return match (v) { VInt(_) | VBytes(_) => true, _ => false };
}

function is_duration(v: Value): boolean {
  return match (v) { VDuration(_) => true, _ => false };
}

function wrap_real(x: f64, a: Value, b: Value): Value {
  if (is_duration(a) || is_duration(b)) {
    return VDuration(x);
  }
  return VReal(x);
}

pub function arith(op: string, a: Value, b: Value): Result[Value, string] {
  if (op == "+" && (is_string(a) || is_string(b))) {
    return Ok(VString(to_str(a) + to_str(b)));
  }
  if (is_string(a) || is_string(b)) {
    return Err(f"cannot apply '{op}' to {type_name(a)} and {type_name(b)}");
  }
  if (is_int(a) && is_int(b)) {
    return arith_int(op, as_i64(a), as_i64(b), a, b);
  }
  return arith_real(op, as_f64(a), as_f64(b), a, b);
}

function arith_int(op: string, x: i64, y: i64, a: Value, b: Value): Result[Value, string] {
  match (op) {
    "+" => {
      return Ok(retag_int(x + y, a, b));
    },
    "-" => {
      return Ok(retag_int(x - y, a, b));
    },
    "*" => {
      return Ok(retag_int(x * y, a, b));
    },
    "/" => {
      return if (y == 0) { Err("division by zero") } else { Ok(retag_int(x / y, a, b)) };
    },
    _ => {
      return Err(f"unknown arithmetic operator '{op}'");
    }
  }
}

function retag_int(x: i64, a: Value, b: Value): Value {
  if let VBytes(_) = a {
    return VBytes(x);
  }
  if let VBytes(_) = b {
    return VBytes(x);
  }
  return VInt(x);
}

function arith_real(op: string, x: f64, y: f64, a: Value, b: Value): Result[Value, string] {
  match (op) {
    "+" => {
      return Ok(wrap_real(x + y, a, b));
    },
    "-" => {
      return Ok(wrap_real(x - y, a, b));
    },
    "*" => {
      return Ok(wrap_real(x * y, a, b));
    },
    "/" => {
      return if (y == 0.0) { Err("division by zero") } else { Ok(wrap_real(x / y, a, b)) };
    },
    _ => {
      return Err(f"unknown arithmetic operator '{op}'");
    }
  }
}

pub function equal(a: Value, b: Value): boolean {
  if (is_string(a) || is_string(b)) {
    return to_str(a) == to_str(b);
  }
  if let VBool(_) = a {
    return to_bool(a) == to_bool(b);
  }
  if (is_int(a) && is_int(b)) {
    return as_i64(a) == as_i64(b);
  }
  return as_f64(a) == as_f64(b);
}

pub function compare(a: Value, b: Value): Result[i32, string] {
  if (is_string(a) || is_string(b)) {
    return Err(f"cannot order {type_name(a)} and {type_name(b)}");
  }
  let x = as_f64(a);
  let y = as_f64(b);
  if (x < y) {
    return Ok(-1);
  }
  if (x > y) {
    return Ok(1);
  }
  return Ok(0);
}

pub function duration_seconds(n: f64, unit: string): Result[f64, string] {
  match (unit) {
    "ms" => {
      return Ok(n / 1000.0);
    },
    "s" => {
      return Ok(n);
    },
    "m" => {
      return Ok(n * 60.0);
    },
    "h" => {
      return Ok(n * 3600.0);
    },
    "d" => {
      return Ok(n * 86400.0);
    },
    "w" => {
      return Ok(n * 604800.0);
    },
    "y" => {
      return Ok(n * 31536000.0);
    },
    _ => {
      return Err(f"unknown duration unit '{unit}'");
    }
  }
}

pub function byte_count(n: f64, unit: string): Result[i64, string] {
  match (unit) {
    "B" => {
      return Ok(n as i64);
    },
    "KB" => {
      return Ok((n * 1024.0) as i64);
    },
    "MB" => {
      return Ok((n * 1048576.0) as i64);
    },
    "GB" => {
      return Ok((n * 1073741824.0) as i64);
    },
    "TB" => {
      return Ok((n * 1099511627776.0) as i64);
    },
    _ => {
      return Err(f"unknown size unit '{unit}'");
    }
  }
}
