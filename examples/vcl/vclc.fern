import "std/string";
import "std/i64";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./check";
import "./compile";

function report_diags(path: string, diags: diag.Diag[]): void {
  for d in diags {
    eprint(d.render(path));
  }
}

function report_problems(path: string, ps: check.Problem[]): void {
  for p in ps {
    eprint(p.render(path));
  }
}

struct Opts { path: string, prefix: string, ok: boolean }

function parse_opts(argv: string[]): Opts {
  let o = Opts { path: "", prefix: "./", ok: false };
  let i = 1;
  while (i < argv.len()) {
    if (argv[i] == "-p" && i + 1 < argv.len()) {
      o = Opts { ...o, prefix: argv[i + 1] };
      i += 2;
    } else {
      o = Opts { ...o, path: argv[i], ok: true };
      i += 1;
    }
  }
  return o;
}

function main(): i32 {
  let o = parse_opts(args());
  if (!o.ok) {
    eprint("usage: vclc [-p IMPORT_PREFIX] FILE.vcl");
    return 2;
  }
  let Ok(src) = io.read_input(o.path) else {
    eprint(f"vclc: {o.path}: cannot read");
    return 2;
  };
  let p = parser.parse(src);
  if (p.diags.len() > 0) {
    report_diags(o.path, p.diags);
    return 2;
  }
  let problems = check.check(p.decls);
  if (problems.len() > 0) {
    report_problems(o.path, problems);
    return 1;
  }
  match (compile.compile(p.decls, o.prefix)) {
    Err(m) => {
      eprint(f"vclc: {o.path}: {m}");
      return 1;
    },
    Ok(code) => {
      print(code);
      return 0;
    }
  }
}
