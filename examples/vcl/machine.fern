// examples/vcl/machine.fern — the VCL request state machine.
//
// This is the part that makes VCL a language rather than a config format:
// subroutines do not run top to bottom, they are STATES, and the value a
// subroutine returns picks the next one. `vcl_recv` returning `hash`
// takes the request to the cache; returning `pass` routes it to the
// backend without ever looking. What each subroutine may see (`vars.fern`)
// follows from where it sits in this graph.
//
// The built-in subroutines are modelled too, and that is not a detail:
// in Varnish, a `vcl_recv` that falls off the end WITHOUT returning
// continues into the built-in `vcl_recv`, which passes any request with
// a Cookie or Authorization header. VCL authors are caught by this
// constantly. Here `run_stage` runs the user's subroutine and applies the
// built-in default only when the user's fell through, which reproduces
// it.
//
// The backend is a mock (`fetch`): it never opens a socket. A URL of the
// form `/status/NNN` comes back with that status, which is the hook the
// tests use to drive the error paths.
import "std/i32";
import "std/string";
import "std/i64";
import "std/f64";
import "std/array";
import "core/cmp";
import "./ast";
import "./value";
import "./runtime";
import "./vars";
import "./eval";

pub struct Outcome { txn: runtime.Txn, cache: runtime.Cache, disposition: string, hit: boolean, steps: string[], ok: boolean, err: string }

pub struct Backend { name: string, host: string, port: i32 }

pub struct FetchOut { status: i64, reason: string, headers: runtime.Headers, body: string, ttl: f64, ok: boolean, err: string }

pub struct Driver { run_sub: (string, runtime.Txn) => eval.ExecOut, backends: Backend[], fetch: (Backend, runtime.Txn) => FetchOut }

function prop_string(props: ast.PropBlock, name: string): string {
  for pr in props.props {
    if (pr.name == name) {
      let PVExpr(e) = pr.value else {
        return "";
      };
      return match (e) { EString(sl) => sl.value, ENumber(n) => n.text, _ => "" };
    }
  }
  return "";
}

pub function backends_of(decls: ast.Decl[]): Backend[] {
  let out: Backend[] = [];
  for d in decls {
    if let DBackend(b) = d {
      let named = prop_string(b.props, ".host");
      let host = if (named == "") { "127.0.0.1" } else { named };
      let port = match (i32.parse_i32(prop_string(b.props, ".port"))) { Ok(n) => n, Err(_) => 80 };
      out = out.append(Backend { name: b.name, host: host, port: port });
    }
  }
  return out;
}

pub function interpreting(decls: ast.Decl[]): Driver {
  let ctx = eval.Ctx { decls: decls };
  let runner = (name: string, t: runtime.Txn): eval.ExecOut => eval.run_sub(ctx, t, name);
  return Driver { run_sub: runner, backends: backends_of(decls), fetch: mock_fetch };
}

struct Run { txn: runtime.Txn, cache: runtime.Cache, steps: string[], ok: boolean, err: string }

function fail(r: Run, msg: string): Run {
  return Run { ...r, ok: false, err: msg };
}

function max_restarts(): i32 {
  return 4;
}

struct Staged { run: Run, act: eval.Action }

function run_stage(ctx: Driver, r: Run, name: string): Staged {
  let stepped = Run { ...r, steps: r.steps.append(name) };
  let out = ctx.run_sub(name, stepped.txn);
  if (!out.ok) {
    return Staged { run: fail(Run { ...stepped, txn: out.txn }, f"{name}: {out.err}"), act: eval.action("") };
  }
  let next = Run { ...stepped, txn: out.txn };
  if let FReturn(a) = out.flow {
    if (a.name != "none") {
      return Staged { run: next, act: a };
    }
  }
  return Staged { run: next, act: eval.action("") };
}

function known_methods(): string[] {
  return ["GET", "HEAD", "PUT", "POST", "TRACE", "OPTIONS", "DELETE"];
}

function builtin_recv(t: runtime.Txn): string {
  let m = t.req.method;
  if (m == "PRI") {
    return "synth";
  }
  if (!cmp.contains(known_methods(), m)) {
    return "pipe";
  }
  if (m != "GET" && m != "HEAD") {
    return "pass";
  }
  if (t.req.headers.has("Authorization") || t.req.headers.has("Cookie")) {
    return "pass";
  }
  return "hash";
}

function builtin_backend_response(r: Run): string {
  if (r.txn.beresp_ttl <= 0.0) {
    return "deliver-uncacheable";
  }
  return "deliver";
}

function resolve(act: eval.Action, fallback: string): string {
  if (act.name == "") {
    return fallback;
  }
  return act.name;
}

pub function mock_fetch(b: Backend, t: runtime.Txn): FetchOut {
  let url = t.bereq.url;
  let status: i64 = 200;
  let reason = "OK";
  if (url.starts_with("/status/")) {
    if let Ok(n) = i32.parse_i32(slice_unchecked(url, 8, url.len()).to_owned()) {
      status = n as i64;
      reason = "Synthetic";
    }
  }
  let h = runtime.headers_new().set("Content-Type", "text/plain").set("X-Backend", b.name);
  return FetchOut { status: status, reason: reason, headers: h, body: f"mock origin {b.name} {url}\n", ttl: -1.0, ok: true, err: "" };
}

function apply_fetch(ctx: Driver, r: Run, b: Backend): Run {
  let out = ctx.fetch(b, r.txn);
  if (!out.ok) {
    return fail(r, f"fetch from {b.name} failed: {out.err}");
  }
  let resp = runtime.Msg { method: "", url: "", proto: "HTTP/1.1", status: out.status, reason: out.reason, headers: out.headers, body: out.body };
  let ttl = if (out.ttl >= 0.0) { out.ttl } else { 120.0 };
  let t = runtime.Txn { ...r.txn, beresp: resp, beresp_ttl: ttl, beresp_uncacheable: false };
  return Run { ...r, txn: t.note(f"fetch {b.name} -> {out.status}") };
}

function backend_for(ctx: Driver, t: runtime.Txn): Backend {
  if (t.backend_hint != "") {
    for b in ctx.backends {
      if (b.name == t.backend_hint) {
        return b;
      }
    }
  }
  if (ctx.backends.len() > 0) {
    return ctx.backends[0];
  }
  return Backend { name: "", host: "127.0.0.1", port: 80 };
}

function hash_key(t: runtime.Txn): string {
  if (t.hash_parts.len() == 0) {
    return f"{t.req.url}|{value.to_str(t.req.headers.get("Host"))}";
  }
  return t.hash_parts.join("|");
}

function start_bereq(r: Run): Run {
  let b = runtime.Msg { method: r.txn.req.method, url: r.txn.req.url, proto: r.txn.req.proto, status: 0, reason: "", headers: r.txn.req.headers, body: r.txn.req.body };
  return Run { ...r, txn: runtime.Txn { ...r.txn, bereq: b } };
}

function deliver_from_beresp(r: Run): Run {
  let resp = runtime.Msg { method: "", url: "", proto: r.txn.beresp.proto, status: r.txn.beresp.status, reason: r.txn.beresp.reason, headers: r.txn.beresp.headers, body: r.txn.beresp.body };
  return Run { ...r, txn: runtime.Txn { ...r.txn, resp: resp } };
}

function deliver_from_obj(r: Run, e: runtime.CacheEntry): Run {
  let obj = runtime.Msg { method: "", url: "", proto: "HTTP/1.1", status: e.status, reason: e.reason, headers: e.headers, body: e.body };
  let resp = runtime.Msg { ...obj };
  let t = runtime.Txn { ...r.txn, obj: obj, resp: resp, obj_ttl: e.ttl, obj_hits: e.hits };
  return Run { ...r, txn: t };
}

function store_object(r: Run, key: string): Run {
  let e = runtime.CacheEntry { key: key, status: r.txn.beresp.status, reason: r.txn.beresp.reason, headers: r.txn.beresp.headers, body: r.txn.beresp.body, ttl: r.txn.beresp_ttl, hits: 0 };
  return Run { ...r, cache: r.cache.store(e), txn: r.txn.note(f"store {key} ttl={r.txn.beresp_ttl.to_string_prec(3)}") };
}

function synth(ctx: Driver, r: Run, a: eval.Action): Outcome {
  let status = if (a.status == 0) { 503 } else { a.status };
  let resp = runtime.Msg { method: "", url: "", proto: "HTTP/1.1", status: status, reason: a.reason, headers: runtime.headers_new(), body: "" };
  let withresp = Run { ...r, txn: runtime.Txn { ...r.txn, resp: resp } };
  let s = run_stage(ctx, withresp, "vcl_synth");
  if (!s.run.ok) {
    return outcome_err(s.run);
  }
  return done(s.run, "synth", false);
}

function outcome_err(r: Run): Outcome {
  return Outcome { txn: r.txn, cache: r.cache, disposition: "error", hit: false, steps: r.steps, ok: false, err: r.err };
}

function done(r: Run, disposition: string, hit: boolean): Outcome {
  return Outcome { txn: r.txn, cache: r.cache, disposition: disposition, hit: hit, steps: r.steps, ok: true, err: "" };
}

function backend_side(ctx: Driver, r0: Run, key: string, store: boolean): Outcome {
  let r = start_bereq(r0);
  let bf = run_stage(ctx, r, "vcl_backend_fetch");
  if (!bf.run.ok) {
    return outcome_err(bf.run);
  }
  if (resolve(bf.act, "fetch") == "abandon") {
    return done(bf.run, "abandon", false);
  }

  let fetched = apply_fetch(ctx, bf.run, backend_for(ctx, bf.run.txn));
  if (!fetched.ok) {
    return outcome_err(fetched);
  }
  let br = run_stage(ctx, fetched, "vcl_backend_response");
  if (!br.run.ok) {
    return outcome_err(br.run);
  }
  let act = resolve(br.act, builtin_backend_response(br.run));
  if (act == "abandon") {
    return done(br.run, "abandon", false);
  }
  if (act == "retry") {
    return done(br.run, "retry", false);
  }

  let stored = if (should_store(act, store, br.run.txn)) { store_object(br.run, key) } else { br.run };
  return client_deliver(ctx, deliver_from_beresp(stored), false);
}

function should_store(act: string, inserts: boolean, t: runtime.Txn): boolean {
  if (act != "deliver" || !inserts) {
    return false;
  }
  return !t.beresp_uncacheable && t.beresp_ttl > 0.0;
}

function client_deliver(ctx: Driver, r: Run, hit: boolean): Outcome {
  let d = run_stage(ctx, r, "vcl_deliver");
  if (!d.run.ok) {
    return outcome_err(d.run);
  }
  let act = resolve(d.act, "deliver");
  if (act == "synth") {
    return synth(ctx, d.run, d.act);
  }
  return done(d.run, "deliver", hit);
}

function lookup_side(ctx: Driver, r: Run, key: string): Outcome {
  match (r.cache.lookup(key)) {
    Some(e) => {
      let bumped = r.cache.touch(key);
      let touched = Run { ...r, cache: bumped };
      let onhit = deliver_from_obj(touched, runtime.CacheEntry { ...e, hits: e.hits + 1 });
      let h = run_stage(ctx, onhit, "vcl_hit");
      if (!h.run.ok) {
        return outcome_err(h.run);
      }
      let act = resolve(h.act, "deliver");
      if (act == "pass") {
        return backend_side(ctx, h.run, key, false);
      }
      if (act == "synth") {
        return synth(ctx, h.run, h.act);
      }
      return client_deliver(ctx, h.run, true);
    },
    None => {
      let m = run_stage(ctx, r, "vcl_miss");
      if (!m.run.ok) {
        return outcome_err(m.run);
      }
      let mact = resolve(m.act, "fetch");
      if (mact == "pass") {
        return backend_side(ctx, m.run, key, false);
      }
      if (mact == "synth") {
        return synth(ctx, m.run, m.act);
      }
      return backend_side(ctx, m.run, key, true);
    }
  }
}

function purge(ctx: Driver, r: Run, key: string): Outcome {
  let evicted = Run { ...r, cache: r.cache.evict(key), txn: r.txn.note("purge " + key) };
  let p = run_stage(ctx, evicted, "vcl_purge");
  if (!p.run.ok) {
    return outcome_err(p.run);
  }
  return synth(ctx, p.run, eval.Action { name: "synth", status: 200, reason: "Purged" });
}

function dispatch(ctx: Driver, r: Run, act: string, a: eval.Action): Outcome {
  if (act == "pipe") {
    let p = run_stage(ctx, start_bereq(r), "vcl_pipe");
    if (!p.run.ok) {
      return outcome_err(p.run);
    }
    return done(p.run, "pipe", false);
  }
  if (act == "synth") {
    return synth(ctx, r, a);
  }
  let hashed = run_stage(ctx, r, "vcl_hash");
  if (!hashed.run.ok) {
    return outcome_err(hashed.run);
  }
  let key = hash_key(hashed.run.txn);
  if (act == "purge") {
    return purge(ctx, hashed.run, key);
  }
  if (act == "pass") {
    let ps = run_stage(ctx, hashed.run, "vcl_pass");
    if (!ps.run.ok) {
      return outcome_err(ps.run);
    }
    if (resolve(ps.act, "fetch") == "synth") {
      return synth(ctx, ps.run, ps.act);
    }
    return backend_side(ctx, ps.run, key, false);
  }
  return lookup_side(ctx, hashed.run, key);
}

function one_pass(ctx: Driver, r: Run): Outcome {
  let recv = run_stage(ctx, r, "vcl_recv");
  if (!recv.run.ok) {
    return outcome_err(recv.run);
  }
  let act = resolve(recv.act, builtin_recv(recv.run.txn));
  if (act == "restart") {
    return done(recv.run, "restart", false);
  }
  return dispatch(ctx, recv.run, act, recv.act);
}

pub function run_request(ctx: Driver, method: string, url: string, client_ip: string, names: string[], values: string[], body: string, cache: runtime.Cache): Outcome {
  return run_inner(ctx, method, url, client_ip, names, values, body, cache);
}

pub function run_with(ctx: Driver, method: string, url: string, client_ip: string, names: string[], values: string[], cache: runtime.Cache): Outcome {
  return run_inner(ctx, method, url, client_ip, names, values, "", cache);
}

function run_inner(ctx: Driver, method: string, url: string, client_ip: string, names: string[], values: string[], body: string, cache: runtime.Cache): Outcome {
  let empty: string[] = [];
  let t = runtime.txn_new(method, url, client_ip);
  let h = t.req.headers;
  let i = 0;
  while (i < names.len() && i < values.len()) {
    h = h.set(names[i], values[i]);
    i += 1;
  }
  let seeded = runtime.Txn { ...t, req: runtime.Msg { ...t.req, headers: h, body: body } };
  let r = Run { txn: seeded, cache: cache, steps: empty, ok: true, err: "" };
  for _ in 0..=max_restarts() {
    let o = one_pass(ctx, r);
    if (!o.ok || o.disposition != "restart") {
      return o;
    }
    r = Run { txn: runtime.Txn { ...o.txn, hash_parts: empty }, cache: o.cache, steps: o.steps, ok: true, err: "" };
  }
  return Outcome { txn: r.txn, cache: r.cache, disposition: "error", hit: false, steps: r.steps, ok: false, err: "too many restarts" };
}

pub function run_with_headers(decls: ast.Decl[], method: string, url: string, client_ip: string, names: string[], values: string[], cache: runtime.Cache): Outcome {
  return run_with(interpreting(decls), method, url, client_ip, names, values, cache);
}

pub function run(decls: ast.Decl[], method: string, url: string, client_ip: string, cache: runtime.Cache): Outcome {
  let none: string[] = [];
  return run_with_headers(decls, method, url, client_ip, none, none, cache);
}
