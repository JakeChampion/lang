import "std/string";
import "std/i32";
import "std/array";
import "./ast";

function indent(n: i32): string {
  return "    ".repeat(n);
}

function quote(s: ast.StrLit): string {
  return match (s.form) { "brace" => f"{{\"{s.value}\"}}", "triple" => f"\"\"\"{s.value}\"\"\"", _ => f"\"{s.value}\"" };
}

function join_args(args: ast.Expr[]): string {
  return array.map(args, print_expr).join(", ");
}

// fern-lint: allow cyclomatic-complexity
pub function print_expr(e: ast.Expr): string {
  match (e) {
    EString(s) => {
      return quote(s);
    },
    ENumber(n) => {
      return n.text;
    },
    EDuration(q) => {
      return q.text + q.unit;
    },
    EBytes(q) => {
      return q.text + q.unit;
    },
    EBool(b) => {
      return if (b.value) { "true" } else { "false" };
    },
    EVar(v) => {
      return v.name;
    },
    ECall(c) => {
      return f"{c.callee}({join_args(c.args)})";
    },
    EBinary(b) => {
      return f"{print_expr(b.lhs)} {b.op} {print_expr(b.rhs)}";
    },
    EUnary(u) => {
      return u.op + print_expr(u.operand);
    },
    EParen(inner) => {
      return f"({print_expr(inner)})";
    }
  }
}

function print_return(r: ast.ReturnStmt): string {
  if (r.action == "") {
    return "return;";
  }
  if (r.has_args) {
    return f"return ({r.action}({join_args(r.args)}));";
  }
  return f"return ({r.action});";
}

function print_if(s: ast.IfStmt, depth: i32): string {
  let out = "";
  for i in 0..s.arms.len() {
    let arm = s.arms[i];
    if (i == 0) {
      out += f"{indent(depth)}if ({print_expr(arm.cond)}) ";
    } else {
      out += f" {arm.kw} ({print_expr(arm.cond)}) ";
    }
    out += print_block(arm.body, depth);
  }
  if (s.has_else) {
    out += " else " + print_block(s.else_blk, depth);
  }
  return out;
}

pub function print_block(b: ast.Block, depth: i32): string {
  if (b.stmts.len() == 0) {
    return "{ }";
  }
  let out = "{\n";
  for stmt in b.stmts {
    out += print_stmt(stmt, depth + 1) + "\n";
  }
  return out + indent(depth) + "}";
}

// fern-lint: allow cyclomatic-complexity
pub function print_stmt(s: ast.Stmt, depth: i32): string {
  match (s) {
    SSet(x) => {
      return f"{indent(depth)}set {x.target} {x.op} {print_expr(x.value)};";
    },
    SUnset(x) => {
      return f"{indent(depth)}unset {x.target};";
    },
    SIf(x) => {
      return print_if(x, depth);
    },
    SReturn(x) => {
      return indent(depth) + print_return(x);
    },
    SCall(x) => {
      return f"{indent(depth)}call {x.name};";
    },
    SNew(x) => {
      return f"{indent(depth)}new {x.name} = {print_expr(x.init)};";
    },
    SExpr(x) => {
      return f"{indent(depth)}{print_expr(x.value)};";
    },
    SInclude(x) => {
      return f"{indent(depth)}include \"{x.path}\";";
    },
    SCSource(x) => {
      return f"{indent(depth)}C{{{x.code}}}C";
    },
    SBlock(b) => {
      return indent(depth) + print_block(b, depth);
    }
  }
}

function print_props(p: ast.PropBlock, depth: i32): string {
  let out = "{\n";
  for prop in p.props {
    out += f"{indent(depth + 1)}{prop.name} = ";
    match (prop.value) {
      PVExpr(e) => {
        out += print_expr(e) + ";\n";
      },
      PVBlock(b) => {
        out += print_props(b, depth + 1) + "\n";
      }
    }
  }
  return out + indent(depth) + "}";
}

function print_acl_entry(e: ast.AclEntry): string {
  let bang = if (e.negated) { "! " } else { "" };
  let body = f"\"{e.host}\"";
  if (e.mask != "") {
    body += "/" + e.mask;
  }
  if (e.parens) {
    body = f"( {body} )";
  }
  return f"{bang}{body};";
}

function print_acl(a: ast.AclDecl): string {
  let out = f"acl {a.name} {{\n";
  for entry in a.entries {
    out += f"{indent(1)}{print_acl_entry(entry)}\n";
  }
  return out + "}";
}

function print_backend(b: ast.BackendDecl): string {
  if (b.none) {
    return f"backend {b.name} none;";
  }
  return f"backend {b.name} {print_props(b.props, 0)}";
}

pub function print_decl(d: ast.Decl): string {
  match (d) {
    DVcl(v) => {
      return f"vcl {v.version};";
    },
    DImport(im) => {
      if (im.has_from) {
        return f"import {im.module} from \"{im.from}\";";
      }
      return f"import {im.module};";
    },
    DInclude(inc) => {
      return f"include \"{inc.path}\";";
    },
    DBackend(b) => {
      return print_backend(b);
    },
    DProbe(p) => {
      return f"probe {p.name} {print_props(p.props, 0)}";
    },
    DAcl(a) => {
      return print_acl(a);
    },
    DSub(s) => {
      return f"sub {s.name} {print_block(s.body, 0)}";
    },
    DCSource(c) => {
      return f"C{{{c.code}}}C";
    }
  }
}

function decl_kind(d: ast.Decl): string {
  return match (d) { DVcl(_) => "vcl", DImport(_) => "import", DInclude(_) => "include", _ => "block" };
}

pub function print_program(decls: ast.Decl[]): string {
  let out = "";
  for i in 0..decls.len() {
    if (i > 0) {
      let same = decl_kind(decls[i]) == decl_kind(decls[i - 1]);
      if (!same || decl_kind(decls[i]) == "block") {
        out += "\n";
      }
    }
    out += print_decl(decls[i]) + "\n";
  }
  return out;
}
