import "std/string";
import "std/utf8";
import "std/i32";
import "./diag";

pub enum TokKind { TIdent, TString, TNumber, TDuration, TBytes, TPunct, TCSource, TEOF }

pub struct Tok { kind: TokKind, text: string, aux: string, line: i32, col: i32 }

pub struct LexResult { toks: Tok[], diags: diag.Diag[] }

struct Pos { i: i32, line: i32, col: i32 }

// True when the bytes of `t` are in `src` at byte offset `i`.
function has_at(src: string, i: i32, t: string): boolean {
  if (i + t.len() > src.len()) {
    return false;
  }
  for k in 0..t.len() {
    if (src[i + k] != t[k]) {
      return false;
    }
  }
  return true;
}

function advance(src: string, p: Pos, to: i32): Pos {
  let line = p.line;
  let col = p.col;
  for i in p.i..to {
    if (src[i] == b'\n') {
      line += 1;
      col = 1;
    } else {
      col += 1;
    }
  }
  return Pos { i: to, line: line, col: col };
}

function is_digit(b: u8): boolean {
  return b >= b'0' && b <= b'9';
}

function is_alpha(b: u8): boolean {
  return b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z' || b == b'_';
}

function is_alphanumeric(b: u8): boolean {
  return is_alpha(b) || is_digit(b);
}

function ident_end(src: string, i: i32): i32 {
  let start = if (i < src.len() && src[i] == b'.') { i + 1 } else { i };
  for j in start..src.len() {
    let b = src[j];
    let dashed = b == b'-' && j + 1 < src.len() && is_alphanumeric(src[j + 1]);
    if (!is_alphanumeric(b) && b != b'.' && !dashed) {
      return j;
    }
  }
  return src.len();
}

function number_end(src: string, i: i32): i32 {
  let j = i;
  while (j < src.len() && is_digit(src[j])) {
    j += 1;
  }
  if (j + 1 < src.len() && src[j] == b'.' && is_digit(src[j + 1])) {
    j += 1;
    while (j < src.len() && is_digit(src[j])) {
      j += 1;
    }
  }
  return j;
}

function duration_units(): string[] {
  return ["ms", "s", "m", "h", "d", "w", "y"];
}

function byte_units(): string[] {
  return ["KB", "MB", "GB", "TB", "B"];
}

function match_unit(src: string, i: i32, units: string[]): string {
  for unit in units {
    let e = i + unit.len();
    if (has_at(src, i, unit) && (e == src.len() || !is_alphanumeric(src[e]))) {
      return unit;
    }
  }
  return "";
}

struct Run { start: i32, end: i32, close: i32, ok: boolean }

function delimited(src: string, from: i32, closer: string): Run {
  for j in from..=src.len() - closer.len() {
    if (has_at(src, j, closer)) {
      return Run { start: from, end: j, close: j + closer.len(), ok: true };
    }
  }
  return Run { start: from, end: src.len(), close: src.len(), ok: false };
}

function short_string(src: string, from: i32): Run {
  let j = from;
  while (j < src.len() && src[j] != b'"' && src[j] != b'\n') {
    j += 1;
  }
  if (j >= src.len() || src[j] == b'\n') {
    return Run { start: from, end: j, close: j, ok: false };
  }
  return Run { start: from, end: j, close: j + 1, ok: true };
}

function comment_end(src: string, i: i32): Option[i32] {
  let b = src[i];
  if (b == b'#') {
    return Some(line_end(src, i));
  }
  if (b != b'/' || i + 1 >= src.len()) {
    return None;
  }
  return match (src[i + 1]) { b'/' => Some(line_end(src, i)), b'*' => Some(delimited(src, i + 2, "*/").close), _ => None };
}

function is_space(b: u8): boolean {
  return b == b' ' || b == b'\t' || b == b'\r' || b == b'\n';
}

function skip_trivia(src: string, p: Pos): Pos {
  let cur = p;
  while (cur.i < src.len()) {
    if (is_space(src[cur.i])) {
      cur = advance(src, cur, cur.i + 1);
    } else {
      let Some(ce) = comment_end(src, cur.i) else {
        return cur;
      };
      cur = advance(src, cur, ce);
    }
  }
  return cur;
}

function line_end(src: string, i: i32): i32 {
  let j = i;
  while (j < src.len() && src[j] != b'\n') {
    j += 1;
  }
  return j;
}

function two_byte_ops(): string[] {
  return ["==", "!=", "<=", ">=", "&&", "||", "!~", "+=", "-=", "*=", "/="];
}

function punct_bytes(): string {
  return "{}();,=<>~!+-*/&|";
}

function is_punct_byte(b: u8): boolean {
  for c in punct_bytes() {
    if (c == b) {
      return true;
    }
  }
  return false;
}

struct Scan { tok: Tok, next: Pos, ok: boolean, err: diag.Diag }

function scanned(t: Tok, next: Pos): Scan {
  return Scan { tok: t, next: next, ok: true, err: diag.at("", 0, 0) };
}

function scan_failed(t: Tok, next: Pos, msg: string, at: Pos): Scan {
  return Scan { tok: t, next: next, ok: false, err: diag.at(msg, at.line, at.col) };
}

function scan_number(src: string, p: Pos): Scan {
  let e = number_end(src, p.i);
  let text = slice_unchecked(src, p.i, e).to_owned();
  let bu = match_unit(src, e, byte_units());
  if (bu != "") {
    let t = Tok { kind: TBytes, text: text, aux: bu, line: p.line, col: p.col };
    return scanned(t, advance(src, p, e + bu.len()));
  }
  let du = match_unit(src, e, duration_units());
  if (du != "") {
    let d = Tok { kind: TDuration, text: text, aux: du, line: p.line, col: p.col };
    return scanned(d, advance(src, p, e + du.len()));
  }
  let n = Tok { kind: TNumber, text: text, aux: "", line: p.line, col: p.col };
  return scanned(n, advance(src, p, e));
}

function scan_string(src: string, p: Pos): Scan {
  let form = "short";
  let open = p.i + 1;
  let closer = "\"";
  if (src[p.i] == b'{') {
    form = "brace";
    open = p.i + 2;
    closer = "\"}";
  } else if (has_at(src, p.i, "\"\"\"")) {
    form = "triple";
    open = p.i + 3;
    closer = "\"\"\"";
  }
  let sp = if (form == "short") { short_string(src, open) } else { delimited(src, open, closer) };
  let tok = Tok { kind: TString, text: slice_unchecked(src, sp.start, sp.end).to_owned(), aux: form, line: p.line, col: p.col };
  if (!sp.ok) {
    return scan_failed(tok, advance(src, p, sp.close), "unterminated string literal", p);
  }
  return scanned(tok, advance(src, p, sp.close));
}

function scan_punct(src: string, p: Pos): Scan {
  for op in two_byte_ops() {
    if (has_at(src, p.i, op)) {
      let t2 = Tok { kind: TPunct, text: op, aux: "", line: p.line, col: p.col };
      return scanned(t2, advance(src, p, p.i + 2));
    }
  }
  let t1 = Tok { kind: TPunct, text: slice_unchecked(src, p.i, p.i + 1).to_owned(), aux: "", line: p.line, col: p.col };
  return scanned(t1, advance(src, p, p.i + 1));
}

function scan_c_source(src: string, p: Pos): Scan {
  let sp = delimited(src, p.i + 2, "}C");
  let tok = Tok { kind: TCSource, text: slice_unchecked(src, sp.start, sp.end).to_owned(), aux: "", line: p.line, col: p.col };
  if (!sp.ok) {
    return scan_failed(tok, advance(src, p, sp.close), "unterminated C{ … }C block", p);
  }
  return scanned(tok, advance(src, p, sp.close));
}

function at_c_source(src: string, i: i32): boolean {
  return src[i] == b'C' && i + 1 < src.len() && src[i + 1] == b'{';
}

function at_brace_string(src: string, i: i32): boolean {
  return src[i] == b'{' && i + 1 < src.len() && src[i + 1] == b'"';
}

function scan_one(src: string, p: Pos): Scan {
  let b = src[p.i];
  if (at_c_source(src, p.i)) {
    return scan_c_source(src, p);
  }
  if (at_brace_string(src, p.i) || b == b'"') {
    return scan_string(src, p);
  }
  if (is_digit(b)) {
    return scan_number(src, p);
  }
  if (is_alpha(b)) {
    let e = ident_end(src, p.i);
    let id = Tok { kind: TIdent, text: slice_unchecked(src, p.i, e).to_owned(), aux: "", line: p.line, col: p.col };
    return scanned(id, advance(src, p, e));
  }
  if (b == b'.' && p.i + 1 < src.len() && is_alpha(src[p.i + 1])) {
    let pe = ident_end(src, p.i);
    let prop = Tok { kind: TIdent, text: slice_unchecked(src, p.i, pe).to_owned(), aux: "", line: p.line, col: p.col };
    return scanned(prop, advance(src, p, pe));
  }
  if (is_punct_byte(b)) {
    return scan_punct(src, p);
  }
  let end = utf8.ceil_char_boundary(src, p.i + 1);
  let bad = Tok { kind: TPunct, text: slice_unchecked(src, p.i, end).to_owned(), aux: "", line: p.line, col: p.col };
  return scan_failed(bad, advance(src, p, end), f"unexpected character '{bad.text}'", p);
}

pub function lex(src: string): LexResult {
  let toks: Tok[] = [];
  let diags: diag.Diag[] = [];
  let cur = Pos { i: 0, line: 1, col: 1 };
  loop {
    cur = skip_trivia(src, cur);
    if (cur.i >= src.len()) {
      toks = toks.append(Tok { kind: TEOF, text: "", aux: "", line: cur.line, col: cur.col });
      return LexResult { toks: toks, diags: diags };
    }
    let s = scan_one(src, cur);
    if (!s.ok) {
      diags = diags.append(s.err);
    }
    toks = toks.append(s.tok);
    cur = s.next;
  }
}

pub function (t: Tok) is_eof(): boolean {
  return match (t.kind) { TEOF => true, _ => false };
}

pub function (t: Tok) is_ident(): boolean {
  return match (t.kind) { TIdent => true, _ => false };
}

pub function (t: Tok) is_string(): boolean {
  return match (t.kind) { TString => true, _ => false };
}

pub function (t: Tok) is_punct(): boolean {
  return match (t.kind) { TPunct => true, _ => false };
}

pub function (t: Tok) punct(s: string): boolean {
  return t.is_punct() && t.text == s;
}

pub function (t: Tok) word(s: string): boolean {
  return t.is_ident() && t.text == s;
}
