// examples/vcl/vclrun.fern — run a request through a VCL program.
//
//   $ fern -interp vclrun.fern -- testdata/policy.vcl GET /admin
//   $ fern -interp vclrun.fern -- policy.vcl GET / 192.0.2.10 Cookie:a=1
//   $ fern -interp vclrun.fern -- policy.vcl GET / -n 2      # miss, then hit
//
// The policy is checked before it runs, as `varnishd` does at load time.
// The command line and the report come from `report.fern`, which a
// COMPILED policy uses too — so the two can be diffed directly, and are.
//
// Exit status is 0 when every request completed, 1 on a VCL problem (found
// by the checker, or hit at run time), and 2 when the file could not be
// read or parsed.
import "std/string";
import "std/i64";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./check";
import "./machine";
import "./report";

function report_diags(path: string, diags: diag.Diag[]): void {
  var i: i32 = 0;
  while (i < diags.len()) {
    eprint(diags[i].render(path));
    i = i + 1;
  }
}

function report_problems(path: string, ps: check.Problem[]): void {
  var i: i32 = 0;
  while (i < ps.len()) {
    eprint(path + ":" + ps[i].line.to_string() + ":" + ps[i].col.to_string() + ": [" + ps[i].entry + "] " + ps[i].msg);
    i = i + 1;
  }
}

function main(): i32 {
  // args()[0] is the program name; argv[1] is the policy, and the request
  // starts at argv[2].
  var argv: string[] = args();
  var a: report.Args = report.parse_args(argv, 2);
  if (argv.len() < 4 || !a.ok) {
    eprint("usage: vclrun FILE.vcl METHOD URL [CLIENT_IP] [Name:Value ...] [-n COUNT]");
    return 2;
  }
  var path: string = argv[1];
  match (io.read_input(path)) {
    Err(e) => {
      eprint("vclrun: " + path + ": cannot read");
      return 2;
    },
    Ok(src) => {
      var p: parser.ParseResult = parser.parse(src);
      if (p.diags.len() > 0) {
        report_diags(path, p.diags);
        return 2;
      }
      var problems: check.Problem[] = check.check(p.decls);
      if (problems.len() > 0) {
        report_problems(path, problems);
        return 1;
      }
      return report.run_all(machine.interpreting(p.decls), a);
    }
  }
}
