import "std/string";
import "std/i64";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./check";
import "./machine";
import "./report";

function report_diags(path: string, diags: diag.Diag[]): void {
  for d in diags {
    eprint(d.render(path));
  }
}

function report_problems(path: string, ps: check.Problem[]): void {
  for p in ps {
    eprint(p.render(path));
  }
}

function main(): i32 {
  let argv = args();
  let a = report.parse_args(argv, 2);
  if (argv.len() < 4 || !a.ok) {
    eprint("usage: vclrun FILE.vcl METHOD URL [CLIENT_IP] [Name:Value ...] [-n COUNT]");
    return 2;
  }
  let path = argv[1];
  let Ok(src) = io.read_input(path) else {
    eprint(f"vclrun: {path}: cannot read");
    return 2;
  };
  let p = parser.parse(src);
  if (p.diags.len() > 0) {
    report_diags(path, p.diags);
    return 2;
  }
  let problems = check.check(p.decls);
  if (problems.len() > 0) {
    report_problems(path, problems);
    return 1;
  }
  return report.run_all(machine.interpreting(p.decls), a);
}
