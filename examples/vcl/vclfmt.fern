import "std/string";
import "std/i32";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./printer";

function report(path: string, diags: diag.Diag[]): void {
  let i: i32 = 0;
  while (i < diags.len()) {
    eprint(diags[i].render(path));
    i = i + 1;
  }
}

function main(): i32 {
  let argv: string[] = args();
  if (argv.len() < 2) {
    eprint("usage: vclfmt FILE.vcl");
    return 2;
  }
  let path: string = argv[1];
  match (io.read_input(path)) {
    Err(e) => {
      eprint("vclfmt: " + path + ": cannot read");
      return 2;
    },
    Ok(src) => {
      let r: parser.ParseResult = parser.parse(src);
      if (r.diags.len() > 0) {
        report(path, r.diags);
        return 1;
      }
      print(printer.print_program(r.decls));
      return 0;
    }
  }
}
