import "std/string";
import "std/i32";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./printer";

function report(path: string, diags: diag.Diag[]): void {
  for d in diags {
    eprint(d.render(path));
  }
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 2) {
    eprint("usage: vclfmt FILE.vcl");
    return 2;
  }
  let path = argv[1];
  let Ok(src) = io.read_input(path) else {
    eprint(f"vclfmt: {path}: cannot read");
    return 2;
  };
  let r = parser.parse(src);
  if (r.diags.len() > 0) {
    report(path, r.diags);
    return 1;
  }
  print(printer.print_program(r.decls));
  return 0;
}
