import "std/test";
import "std/string";
import "std/i32";
import "std/i64";
import "std/fetch";
import "std/http";
import "std/headers";
import "./runtime";
import "./wire";
import "./store";

function req_msg(method: string, url: string): runtime.Msg {
  return runtime.Msg { method: method, url: url, proto: "HTTP/1.1", status: 0, reason: "", headers: runtime.headers_new(), body: "" };
}

function test_method_and_url(): test.TestOutcome {
  let req = wire.request_of(req_msg("GET", "/p"), "http://origin:80");
  if (req.method != "GET") {
    return test.fail("bad method: " + req.method);
  }
  return test.assert_eq(req.url, "http://origin:80/p");
}

function test_headers_are_forwarded(): test.TestOutcome {
  let m = req_msg("GET", "/");
  let h = m.headers.set("X-Trace", "abc");
  return test.assert_eq(header_of(wire.request_of(runtime.Msg { ...m, headers: h }, "http://h"), "X-Trace"), "abc");
}

function header_of(req: fetch.Request, name: string): string {
  return match (req.headers.get(name)) { Some(v) => v, None => "<unset>" };
}

function test_hop_by_hop_headers_are_stripped(): test.TestOutcome {
  let m = req_msg("GET", "/");
  let h = m.headers.set("Connection", "keep-alive").set("Transfer-Encoding", "chunked").set("Host", "client-supplied").set("Content-Length", "999");
  let req = wire.request_of(runtime.Msg { ...m, headers: h }, "http://real-origin");
  if (req.headers.len() != 0) {
    return test.fail("a hop-by-hop header was relayed: " + req.headers.names[0]);
  }
  return test.pass();
}

function test_the_body_is_sent_as_the_policy_left_it(): test.TestOutcome {
  let m = req_msg("POST", "/submit");
  let req = wire.request_of(runtime.Msg { ...m, body: "hello" }, "http://h");
  match (req.body) {
    BodyText(s) => {
      return test.assert_eq(s, "hello");
    },
    _ => {
      return test.fail("the body is not the text the policy left");
    }
  }
}

function test_response_headers_become_the_proxys(): test.TestOutcome {
  let h = headers.new().append("X-A", "1").append("X-B", "two words");
  let out = wire.headers_of(h);
  let VString(a) = out.get("X-A") else {
    return test.fail("X-A lost");
  };
  if (a != "1") {
    return test.fail("X-A = " + a);
  }
  let VString(b) = out.get("X-B") else {
    return test.fail("X-B lost");
  };
  return test.assert_eq(b, "two words");
}

function test_max_age_is_read(): test.TestOutcome {
  let Some(v) = wire.max_age("public, max-age=600") else {
    return test.fail("max-age not found");
  };
  return test.assert_eq(v, 600.0);
}

function test_no_store_is_zero(): test.TestOutcome {
  let Some(v) = wire.max_age("no-store") else {
    return test.fail("no-store should be 0");
  };
  return test.assert_eq(v, 0.0);
}

function test_absent_cache_control_has_no_opinion(): test.TestOutcome {
  if let Some(_) = wire.max_age("public") {
    return test.fail("expected no opinion");
  }
  return test.pass();
}

function entry(key: string, body: string): runtime.CacheEntry {
  let h = runtime.headers_new().set("Content-Type", "text/plain");
  return runtime.CacheEntry { key: key, status: 200, reason: "OK", headers: h, body: body, ttl: 60.0, hits: 3 };
}

function test_roundtrip_preserves_an_entry(): test.TestOutcome {
  let c = runtime.cache_new().store(entry("/a", "hello"));
  let back = store.decode(store.encode(c));
  if (back.entries.len() != 1) {
    return test.fail("lost the entry");
  }
  let e = back.entries[0];
  if (e.key != "/a" || e.body != "hello" || e.status != 200 || e.hits != 3) {
    return test.fail(f"field lost: {e.key}/{e.body}/{e.status}");
  }
  return test.assert_eq(e.ttl, 60.0);
}

function test_roundtrip_survives_a_body_that_looks_like_the_encoding(): test.TestOutcome {
  let nasty = "5\nhello\n3\nabc\n\n42\n\r\n\r\n0\n";
  let c = runtime.cache_new().store(entry("/x", nasty));
  let back = store.decode(store.encode(c));
  if (back.entries.len() != 1) {
    return test.fail("lost the entry");
  }
  return test.assert_eq(back.entries[0].body, nasty);
}

function test_roundtrip_preserves_several_entries(): test.TestOutcome {
  let c = runtime.cache_new();
  c = c.store(entry("/a", "one"));
  c = c.store(entry("/b", "two"));
  c = c.store(entry("/c", ""));
  let back = store.decode(store.encode(c));
  if (back.entries.len() != 3) {
    return test.fail(f"expected 3, got {back.entries.len()}");
  }
  return test.assert_eq(back.entries[2].key, "/c");
}

function test_roundtrip_preserves_headers(): test.TestOutcome {
  let c = runtime.cache_new().store(entry("/h", "b"));
  let back = store.decode(store.encode(c));
  let VString(v) = back.entries[0].headers.get("Content-Type") else {
    return test.fail("header lost");
  };
  return test.assert_eq(v, "text/plain");
}

function test_empty_cache_roundtrips(): test.TestOutcome {
  return test.assert_eq(store.decode(store.encode(runtime.cache_new())).entries.len(), 0);
}

function test_empty_string_decodes_to_an_empty_cache(): test.TestOutcome {
  return test.assert_eq(store.decode("").entries.len(), 0);
}

function test_corrupt_input_decodes_to_an_empty_cache(): test.TestOutcome {
  if (store.decode("9\nnot a cache").entries.len() != 0) {
    return test.fail("truncated input decoded");
  }
  return test.assert_eq(store.decode("notanumber").entries.len(), 0);
}

function main(): i32 {
  let r = test.new("vcl-wire");
  r = r.it("method and url", test_method_and_url);
  r = r.it("headers are forwarded", test_headers_are_forwarded);
  r = r.it("hop by hop headers are stripped", test_hop_by_hop_headers_are_stripped);
  r = r.it("the body is sent as the policy left it", test_the_body_is_sent_as_the_policy_left_it);
  r = r.it("response headers become the proxy's", test_response_headers_become_the_proxys);
  r = r.it("max age is read", test_max_age_is_read);
  r = r.it("no store is zero", test_no_store_is_zero);
  r = r.it("absent cache control has no opinion", test_absent_cache_control_has_no_opinion);
  r = r.it("roundtrip preserves an entry", test_roundtrip_preserves_an_entry);
  r = r.it("roundtrip survives a body that looks like the encoding", test_roundtrip_survives_a_body_that_looks_like_the_encoding);
  r = r.it("roundtrip preserves several entries", test_roundtrip_preserves_several_entries);
  r = r.it("roundtrip preserves headers", test_roundtrip_preserves_headers);
  r = r.it("empty cache roundtrips", test_empty_cache_roundtrips);
  r = r.it("empty string decodes to an empty cache", test_empty_string_decodes_to_an_empty_cache);
  r = r.it("corrupt input decodes to an empty cache", test_corrupt_input_decodes_to_an_empty_cache);
  return r.finish();
}
