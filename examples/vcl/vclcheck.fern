import "std/string";
import "std/i64";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./check";

function report_parse(path: string, diags: diag.Diag[]): void {
  for d in diags {
    eprint(d.render(path));
  }
}

function report_problems(path: string, ps: check.Problem[]): void {
  for p in ps {
    eprint(p.render(path));
  }
}

function report_unreachable(names: string[]): void {
  for name in names {
    eprint(f"note: subroutine '{name}' is never called");
  }
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 2) {
    eprint("usage: vclcheck FILE.vcl");
    return 2;
  }
  let path = argv[1];
  let Ok(src) = io.read_input(path) else {
    eprint(f"vclcheck: {path}: cannot read");
    return 2;
  };
  let p = parser.parse(src);
  if (p.diags.len() > 0) {
    report_parse(path, p.diags);
    return 2;
  }
  let problems = check.check(p.decls);
  report_unreachable(check.unreachable_subs(p.decls));
  if (problems.len() == 0) {
    print("ok: " + path);
    return 0;
  }
  report_problems(path, problems);
  return 1;
}
