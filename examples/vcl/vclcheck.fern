import "std/string";
import "std/i64";
import "std/io";
import "./ast";
import "./diag";
import "./parser";
import "./check";

function render(path: string, p: check.Problem): string {
  return path + ":" + p.line.to_string() + ":" + p.col.to_string() + ": [" + p.entry + "] " + p.msg;
}

function report_parse(path: string, diags: diag.Diag[]): void {
  let i: i32 = 0;
  while (i < diags.len()) {
    eprint(diags[i].render(path));
    i = i + 1;
  }
}

function report_problems(path: string, ps: check.Problem[]): void {
  let i: i32 = 0;
  while (i < ps.len()) {
    eprint(render(path, ps[i]));
    i = i + 1;
  }
}

function report_unreachable(names: string[]): void {
  let i: i32 = 0;
  while (i < names.len()) {
    eprint("note: subroutine '" + names[i] + "' is never called");
    i = i + 1;
  }
}

function main(): i32 {
  let argv: string[] = args();
  if (argv.len() < 2) {
    eprint("usage: vclcheck FILE.vcl");
    return 2;
  }
  let path: string = argv[1];
  match (io.read_input(path)) {
    Err(e) => {
      eprint("vclcheck: " + path + ": cannot read");
      return 2;
    },
    Ok(src) => {
      let p: parser.ParseResult = parser.parse(src);
      if (p.diags.len() > 0) {
        report_parse(path, p.diags);
        return 2;
      }
      let problems: check.Problem[] = check.check(p.decls);
      report_unreachable(check.unreachable_subs(p.decls));
      if (problems.len() == 0) {
        print("ok: " + path);
        return 0;
      }
      report_problems(path, problems);
      return 1;
    }
  }
}
