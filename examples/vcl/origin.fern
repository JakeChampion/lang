import "std/string";
import "std/i32";
import "std/http";
import "std/serve";
import "std/platform";

function main(): i32 {
  let argv = args();
  let port = 9000;
  if (argv.len() > 1) {
    let Ok(n) = i32.parse_i32(argv[1]) else {
      eprint(f"origin: bad port '{argv[1]}'");
      return 2;
    };
    port = n;
  }
  let served = cell_new(0);
  let handler: (HttpRequest, platform.Host) => HttpResponse = (req: HttpRequest, plat: platform.Host): HttpResponse => {
    served.set(served.get() + 1);
    let body = f"origin-hit={served.get()} path={req.path}\n";
    return http.ok(body).with_header("Cache-Control", "max-age=60");
  };
  eprint(f"origin: serving on port {port}");
  return serve.exit_code(serve.run(port, serve.config(), handler));
}
