import "std/string";
import "std/i32";
import "std/http";
import "std/serve";
import "std/platform";

function main(): i32 {
  let argv: string[] = args();
  let port: i32 = 9000;
  if (argv.len() > 1) {
    match (i32.parse_i32(argv[1])) {
      Ok(n) => {
        port = n;
      },
      Err(_) => {
        eprint("origin: bad port '" + argv[1] + "'");
        return 2;
      }
    }
  }
  let served: Cell[i32] = cell_new(0);
  let handler: (HttpRequest, platform.Host) => HttpResponse = (req: HttpRequest, plat: platform.Host): HttpResponse => {
    served.set(served.get() + 1);
    let body: string = "origin-hit=" + served.get().to_string() + " path=" + req.path + "\n";
    return http.ok(body).with_header("Cache-Control", "max-age=60");
  };
  eprint("origin: serving on port " + port.to_string());
  return serve.run(port, serve.config(), handler);
}
