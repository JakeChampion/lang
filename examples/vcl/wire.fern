import "std/string";
import "std/i64";
import "std/i32";
import "std/f64";
import "std/fetch";
import "std/headers";
import "std/array";
import "./runtime";

function hop_by_hop(): string[] {
  return ["connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade", "host", "content-length"];
}

function is_hop_by_hop(name: string): boolean {
  return array.any(hop_by_hop(), (hop: string) => name.eq_ignore_ascii_case(hop));
}

pub function request_of(m: runtime.Msg, base: string): fetch.Request {
  let method = if (m.method == "") { "GET" } else { m.method };
  let url = if (m.url == "") { "/" } else { m.url };
  let req = fetch.request(method, base + url);
  for i in 0..m.headers.names.len() {
    let n = m.headers.names[i];
    if (!is_hop_by_hop(n)) {
      req = req.with_header(n, m.headers.values[i]);
    }
  }
  return req.with_text(m.body);
}

pub function headers_of(h: HeaderMap): runtime.Headers {
  let out = runtime.headers_new();
  for i in 0..h.names.len() {
    out = out.set(h.names[i], h.values[i]);
  }
  return out;
}

function leading_digits(s: string): string {
  let out = "";
  for i in 0..s.len() {
    let b = s[i];
    if (b < b'0' || b > b'9') {
      return out;
    }
    out += slice_unchecked(s, i, i + 1);
  }
  return out;
}

pub function max_age(cc: string): Option[f64] {
  let lower = cc.to_ascii_lower();
  if (lower.contains("no-store") || lower.contains("no-cache") || lower.contains("private")) {
    return Some(0.0);
  }
  let Some(at) = lower.index_of("max-age=") else {
    return None;
  };
  let digits = leading_digits(slice_unchecked(lower, at + 8, lower.len()).to_owned());
  if (digits.len() == 0) {
    return None;
  }
  return match (i32.parse_i32(digits)) { Ok(n) => Some(n as f64), Err(_) => None };
}
