import "std/string";
import "std/i64";
import "std/i32";
import "std/f64";
import "std/fetch";
import "std/headers";
import "./runtime";

function hop_by_hop(): string[] {
  return ["connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade", "host", "content-length"];
}

function is_hop_by_hop(name: string): boolean {
  let hops: string[] = hop_by_hop();
  let i: i32 = 0;
  while (i < hops.len()) {
    if (name.eq_ignore_ascii_case(hops[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function request_of(m: runtime.Msg, base: string): fetch.Request {
  let method: string = m.method;
  if (method == "") {
    method = "GET";
  }
  let url: string = m.url;
  if (url == "") {
    url = "/";
  }
  let req: fetch.Request = fetch.request(method, base + url);
  let i: i32 = 0;
  while (i < m.headers.names.len()) {
    let n: string = m.headers.names[i];
    if (!is_hop_by_hop(n)) {
      req = req.with_header(n, m.headers.values[i]);
    }
    i = i + 1;
  }
  return req.with_text(m.body);
}

pub function headers_of(h: HeaderMap): runtime.Headers {
  let out: runtime.Headers = runtime.headers_new();
  let i: i32 = 0;
  while (i < h.names.len()) {
    out = out.set(h.names[i], h.values[i]);
    i = i + 1;
  }
  return out;
}

function leading_digits(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    let b: u8 = s[i];
    if (b < 48 || b > 57) {
      return out;
    }
    out = out + slice_unchecked(s, i, i + 1);
    i = i + 1;
  }
  return out;
}

pub function max_age(cc: string): Option[f64] {
  let lower: string = cc.to_ascii_lower();
  if (lower.contains("no-store") || lower.contains("no-cache") || lower.contains("private")) {
    return Some(0.0);
  }
  let Some(at) = lower.index_of("max-age=") else {
    return None;
  };
  let digits: string = leading_digits(slice_unchecked(lower, at + 8, lower.len()).to_owned());
  if (digits.len() == 0) {
    return None;
  }
  match (digits.parse_int()) {
    Some(n) => {
      return Some(n as f64);
    },
    None => {
      return None;
    }
  }
}
