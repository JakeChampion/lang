// examples/vcl/wire.fern — between the proxy's messages and std/fetch.
//
// The mock origin in `machine.fern` fabricates a response struct. A real
// one is reached through `std/fetch`, so something has to turn `bereq`
// into a `fetch.Request` and the response's headers back into the proxy's
// own. That is this module, and it is deliberately free of any I/O: it is
// value in, value out, which is what lets it be tested under the
// interpreter while the sockets around it can only run natively.
import "std/string";
import "std/i64";
import "std/i32";
import "std/float";
import "std/fetch";
import "std/headers";
import "./runtime";

// hop_by_hop names the headers that belong to a single connection and must
// not be forwarded (RFC 9110 §7.6.1), and the two the client rebuilds:
// `Host` from the backend, `Content-Length` from the body it sends.
function hop_by_hop(): string[] {
  return ["connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade", "host", "content-length"];
}

function is_hop_by_hop(name: string): boolean {
  var hops: string[] = hop_by_hop();
  var i: i32 = 0;
  while (i < hops.len()) {
    if (name.eq_ignore_ascii_case(hops[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// request_of turns `bereq` into the request the client sends to `base`
// (`http://host:port`): the method and URL, the end-to-end headers, and
// the body as the policy left it, whose length the client recomputes
// because a policy may have rewritten the body.
pub function request_of(m: runtime.Msg, base: string): fetch.Request {
  var method: string = m.method;
  if (method == "") {
    method = "GET";
  }
  var url: string = m.url;
  if (url == "") {
    url = "/";
  }
  var req: fetch.Request = fetch.request(method, base + url);
  var i: i32 = 0;
  while (i < m.headers.names.len()) {
    var n: string = m.headers.names[i];
    if (!is_hop_by_hop(n)) {
      req = req.with_header(n, m.headers.values[i]);
    }
    i = i + 1;
  }
  return req.with_text(m.body);
}

// headers_of turns a response's headers into the proxy's own, the last
// value of a repeated field winning as `Headers.set` has it.
pub function headers_of(h: HeaderMap): runtime.Headers {
  var out: runtime.Headers = runtime.headers_new();
  var i: i32 = 0;
  while (i < h.names.len()) {
    out = out.set(h.names[i], h.values[i]);
    i = i + 1;
  }
  return out;
}

// leading_digits returns the run of ASCII digits at the start of `s`.
function leading_digits(s: string): string {
  var out: string = "";
  var i: i32 = 0;
  while (i < s.len()) {
    var b: u8 = s[i];
    if (b < 48 || b > 57) {
      return out;
    }
    out = out + slice_unchecked(s, i, i + 1);
    i = i + 1;
  }
  return out;
}

// max_age reads `Cache-Control: ... max-age=N ...`, which is how a real
// origin says how long its answer may be kept. `no-store` and `no-cache`
// answer 0, which the built-in caching rule then reads as uncacheable.
pub function max_age(cc: string): Option[f64] {
  var lower: string = cc.to_ascii_lower();
  if (lower.contains("no-store") || lower.contains("no-cache") || lower.contains("private")) {
    return Some(0.0);
  }
  var at: i32 = lower.index_of("max-age=");
  if (at < 0) {
    return None;
  }
  var digits: string = leading_digits(slice_unchecked(lower, at + 8, lower.len()).to_owned());
  if (digits.len() == 0) {
    return None;
  }
  match (digits.parse_int()) {
    Some(n) => {
      return Some(n as f64);
    },
    None => {
      return None;
    }
  }
}
