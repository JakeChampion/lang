import "std/string";
import "std/i32";
import "std/i64";
import "std/io";
import "std/http";
import "std/serve";
import "std/fetch";
import "std/headers";
import "std/platform";
import "./ast";
import "./diag";
import "./parser";
import "./check";
import "./runtime";
import "./eval";
import "./machine";
import "./wire";
import "./store";

function fetch_failed(msg: string): machine.FetchOut {
  return machine.FetchOut { status: 0, reason: "", headers: runtime.headers_new(), body: "", ttl: -1.0, ok: false, err: msg };
}

function real_fetch(b: machine.Backend, t: runtime.Txn): machine.FetchOut {
  let host = if (b.host.contains(":")) { f"[{b.host}]" } else { b.host };
  let req = wire.request_of(t.bereq, f"http://{host}:{b.port}");
  let resp = match (fetch.send(req)) { Ok(r) => r, Err(e) => { return fetch_failed(f"backend '{b.name}': {e.message()}"); } };
  let Ok(body) = resp.body_text() else {
    return fetch_failed(f"backend '{b.name}' returned a response that is not valid UTF-8");
  };
  let h = wire.headers_of(resp.headers);
  let ttl = -1.0;
  if let Some(cc) = resp.headers.get("Cache-Control") {
    if let Some(secs) = wire.max_age(cc) {
      ttl = secs;
    }
  }
  return machine.FetchOut { status: resp.status as i64, reason: http.status_text(resp.status), headers: h, body: body, ttl: ttl, ok: true, err: "" };
}

function client_ip_of(h: HeaderMap): string {
  let Some(v) = h.get("X-Forwarded-For") else {
    return "127.0.0.1";
  };
  if let Some(comma) = v.index_of(",") {
    if (comma > 0) {
      return slice_unchecked(v, 0, comma).to_owned().trim().to_owned();
    }
  }
  return v.trim().to_owned();
}

function to_response(o: machine.Outcome): HttpResponse {
  let h = headers.new();
  for i in 0..o.txn.resp.headers.names.len() {
    let n = o.txn.resp.headers.names[i];
    if (!n.eq_ignore_ascii_case("content-length") && !n.eq_ignore_ascii_case("connection")) {
      h = h.set(n, o.txn.resp.headers.values[i]);
    }
  }
  let raw = o.txn.resp.status as i32;
  let status = if (raw == 0) { 200 } else { raw };
  return HttpResponse { status: status, body: BodyText(o.txn.resp.body), headers: h, trailers: headers.new(), background: None };
}

function error_response(o: machine.Outcome): HttpResponse {
  let h = headers.new().set("Content-Type", "text/plain");
  return HttpResponse { status: 503, body: BodyText(f"VCL error: {o.err}\n"), headers: h, trailers: headers.new(), background: None };
}

function report_diags(path: string, diags: diag.Diag[]): void {
  for d in diags {
    eprint(d.render(path));
  }
}

function report_problems(path: string, ps: check.Problem[]): void {
  for p in ps {
    eprint(p.render(path));
  }
}

function serve(decls: ast.Decl[], port: i32): i32 {
  let d = machine.Driver { run_sub: machine.interpreting(decls).run_sub, backends: machine.backends_of(decls), fetch: real_fetch };
  let cache = cell_new("");
  let handler: (HttpRequest, platform.Host) => HttpResponse = (req: HttpRequest, plat: platform.Host): HttpResponse => {
    let names = req.headers.names;
    let values = req.headers.values;
    let body = match (req.body_text()) { Ok(text) => text, Err(e) => { return e.to_response(); } };
    let o = machine.run_request(d, req.method, req.path, client_ip_of(req.headers), names, values, body, store.decode(cache.get()));
    if (!o.ok) {
      eprint("vclproxy: " + o.err);
      return error_response(o);
    }
    cache.set(store.encode(o.cache));
    return to_response(o);
  };
  return serve.exit_code(serve.run(port, serve.config(), handler));
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 2) {
    eprint("usage: vclproxy FILE.vcl [PORT]");
    return 2;
  }
  let path = argv[1];
  let port = 8080;
  if (argv.len() > 2) {
    let Ok(n) = i32.parse_i32(argv[2]) else {
      eprint(f"vclproxy: bad port '{argv[2]}'");
      return 2;
    };
    port = n;
  }
  let Ok(src) = io.read_input(path) else {
    eprint(f"vclproxy: {path}: cannot read");
    return 2;
  };
  let p = parser.parse(src);
  if (p.diags.len() > 0) {
    report_diags(path, p.diags);
    return 2;
  }
  let problems = check.check(p.decls);
  if (problems.len() > 0) {
    report_problems(path, problems);
    return 1;
  }
  eprint(f"vclproxy: serving {path} on port {port}");
  return serve(p.decls, port);
}
