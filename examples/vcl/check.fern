import "std/string";
import "std/i64";
import "std/array";
import "core/cmp";
import "./ast";
import "./vars";
import "./eval";

pub struct Problem { msg: string, line: i32, col: i32, entry: string }

struct Ck { decls: ast.Decl[], entry: string }

pub function (p: Problem) render(path: string): string {
  return f"{path}:{p.line}:{p.col}: [{p.entry}] {p.msg}";
}

function problem(c: Ck, msg: string, line: i32, col: i32): Problem {
  return Problem { msg: msg, line: line, col: col, entry: c.entry };
}

pub function entry_points(): string[] {
  return ["vcl_init", "vcl_recv", "vcl_pipe", "vcl_pass", "vcl_hash", "vcl_purge", "vcl_miss", "vcl_hit", "vcl_deliver", "vcl_synth", "vcl_backend_fetch", "vcl_backend_response", "vcl_backend_error", "vcl_fini"];
}

// fern-lint: allow cyclomatic-complexity
function actions_for(entry: string): string[] {
  match (entry) {
    "vcl_recv" => {
      return ["hash", "pass", "pipe", "purge", "synth", "restart", "fail"];
    },
    "vcl_pipe" => {
      return ["pipe", "synth", "fail"];
    },
    "vcl_pass" => {
      return ["fetch", "synth", "restart", "fail"];
    },
    "vcl_hash" => {
      return ["lookup"];
    },
    "vcl_purge" => {
      return ["synth", "restart", "fail"];
    },
    "vcl_miss" => {
      return ["fetch", "pass", "synth", "restart", "fail"];
    },
    "vcl_hit" => {
      return ["deliver", "miss", "pass", "synth", "restart", "fail"];
    },
    "vcl_deliver" => {
      return ["deliver", "restart", "synth", "fail"];
    },
    "vcl_synth" => {
      return ["deliver", "restart", "fail"];
    },
    "vcl_backend_fetch" => {
      return ["fetch", "abandon", "error"];
    },
    "vcl_backend_response" => {
      return ["deliver", "retry", "abandon", "error", "pass"];
    },
    "vcl_backend_error" => {
      return ["deliver", "retry", "abandon"];
    },
    _ => {
      return [];
    }
  }
}

function check_name(c: Ck, name: string, line: i32, col: i32, out: Problem[]): Problem[] {
  if let Some(s) = vars.find_spec(name) {
    if (!cmp.contains(s.read_in, c.entry)) {
      return out.append(problem(c, f"'{name}' is not readable in {c.entry}", line, col));
    }
    return out;
  }
  let ctx = eval.Ctx { decls: c.decls };
  if (eval.has_backend(ctx, name) || eval.has_acl(ctx, name)) {
    return out;
  }
  if (name == "true" || name == "false") {
    return out;
  }
  return out.append(problem(c, f"unknown name '{name}'", line, col));
}

function check_call(c: Ck, callee: string, line: i32, col: i32, out: Problem[]): Problem[] {
  if (!eval.is_builtin(callee)) {
    return out.append(problem(c, f"unknown function '{callee}'", line, col));
  }
  if (callee == "hash_data" && c.entry != "vcl_hash") {
    return out.append(problem(c, "hash_data() is only meaningful in vcl_hash", line, col));
  }
  return out;
}

function check_exprs(c: Ck, es: ast.Expr[], out: Problem[]): Problem[] {
  let acc = out;
  for e in es {
    acc = check_expr(c, e, acc);
  }
  return acc;
}

function check_expr(c: Ck, e: ast.Expr, out: Problem[]): Problem[] {
  match (e) {
    EVar(v) => {
      return check_name(c, v.name, v.line, v.col, out);
    },
    ECall(call) => {
      let acc = check_call(c, call.callee, call.line, call.col, out);
      return check_exprs(c, call.args, acc);
    },
    EBinary(b) => {
      let acc = check_expr(c, b.lhs, out);
      return check_expr(c, b.rhs, acc);
    },
    EUnary(u) => {
      return check_expr(c, u.operand, out);
    },
    EParen(inner) => {
      return check_expr(c, inner, out);
    },
    _ => {
      return out;
    }
  }
}

function check_set(c: Ck, s: ast.SetStmt, out: Problem[]): Problem[] {
  let acc = check_expr(c, s.value, out);
  let Some(spec) = vars.find_spec(s.target) else {
    return acc.append(problem(c, f"unknown variable '{s.target}'", s.line, s.col));
  };
  if (spec.write_in.len() == 0) {
    return acc.append(problem(c, f"'{s.target}' is read-only", s.line, s.col));
  }
  if (!cmp.contains(spec.write_in, c.entry)) {
    return acc.append(problem(c, f"'{s.target}' is not writable in {c.entry}", s.line, s.col));
  }
  return acc;
}

function check_unset(c: Ck, s: ast.UnsetStmt, out: Problem[]): Problem[] {
  let Some(spec) = vars.find_spec(s.target) else {
    return out.append(problem(c, f"unknown variable '{s.target}'", s.line, s.col));
  };
  if (!spec.is_prefix) {
    return out.append(problem(c, f"'{s.target}' is not a header and cannot be unset", s.line, s.col));
  }
  if (!cmp.contains(spec.write_in, c.entry)) {
    return out.append(problem(c, f"'{s.target}' is not writable in {c.entry}", s.line, s.col));
  }
  return out;
}

function check_return(c: Ck, s: ast.ReturnStmt, in_custom: boolean, out: Problem[]): Problem[] {
  let acc = check_exprs(c, s.args, out);
  if (s.action == "") {
    if (in_custom) {
      return acc;
    }
    return acc.append(problem(c, "'return' needs an action in " + c.entry, s.line, s.col));
  }
  let allowed = actions_for(c.entry);
  if (cmp.contains(allowed, s.action)) {
    return acc;
  }
  return acc.append(problem(c, f"'{s.action}' is not a valid return from {c.entry} (expected one of: {allowed.join(", ")})", s.line, s.col));
}

function check_if(c: Ck, s: ast.IfStmt, in_custom: boolean, depth: i32, out: Problem[]): Problem[] {
  let acc = out;
  for arm in s.arms {
    acc = check_expr(c, arm.cond, acc);
    acc = check_block(c, arm.body, in_custom, depth, acc);
  }
  if (s.has_else) {
    acc = check_block(c, s.else_blk, in_custom, depth, acc);
  }
  return acc;
}

function check_call_stmt(c: Ck, s: ast.CallStmt, depth: i32, out: Problem[]): Problem[] {
  let ctx = eval.Ctx { decls: c.decls };
  let Some(body) = eval.find_sub(ctx, s.name) else {
    return out.append(problem(c, f"call to undefined subroutine '{s.name}'", s.line, s.col));
  };
  if (depth <= 0) {
    return out.append(problem(c, f"subroutine calls nest too deeply at '{s.name}'", s.line, s.col));
  }
  return check_block(c, body, true, depth - 1, out);
}

// fern-lint: allow cyclomatic-complexity
function check_stmt(c: Ck, s: ast.Stmt, in_custom: boolean, depth: i32, out: Problem[]): Problem[] {
  match (s) {
    SSet(x) => {
      return check_set(c, x, out);
    },
    SUnset(x) => {
      return check_unset(c, x, out);
    },
    SIf(x) => {
      return check_if(c, x, in_custom, depth, out);
    },
    SReturn(x) => {
      return check_return(c, x, in_custom, out);
    },
    SCall(x) => {
      return check_call_stmt(c, x, depth, out);
    },
    SExpr(x) => {
      return check_expr(c, x.value, out);
    },
    SBlock(b) => {
      return check_block(c, b, in_custom, depth, out);
    },
    SNew(x) => {
      if (c.entry != "vcl_init") {
        return out.append(problem(c, "'new' is only allowed in vcl_init", x.line, x.col));
      }
      return out.append(problem(c, f"'new {x.name}' needs VMOD objects, which are not implemented", x.line, x.col));
    },
    SInclude(x) => {
      return out.append(problem(c, "'include' must be resolved before checking", x.line, x.col));
    },
    SCSource(x) => {
      return out.append(problem(c, "inline C cannot be checked or evaluated", x.line, x.col));
    }
  }
}

function check_block(c: Ck, b: ast.Block, in_custom: boolean, depth: i32, out: Problem[]): Problem[] {
  let acc = out;
  for stmt in b.stmts {
    acc = check_stmt(c, stmt, in_custom, depth, acc);
  }
  return acc;
}

function check_declarations(decls: ast.Decl[], out: Problem[]): Problem[] {
  let acc = out;
  let seen: string[] = [];
  let c = Ck { decls: decls, entry: "" };
  for d in decls {
    if let DSub(s) = d {
      if (cmp.contains(seen, s.name)) {
        acc = acc.append(problem(c, f"subroutine '{s.name}' is defined more than once", s.line, s.col));
      }
      seen = seen.append(s.name);
      if (s.name.starts_with("vcl_") && !cmp.contains(entry_points(), s.name)) {
        acc = acc.append(problem(c, f"'{s.name}' is not a Varnish subroutine, so it would never run", s.line, s.col));
      }
    }
  }
  return acc;
}

function max_call_depth(): i32 {
  return 32;
}

pub function check(decls: ast.Decl[]): Problem[] {
  let out: Problem[] = [];
  out = check_declarations(decls, out);
  let ctx = eval.Ctx { decls: decls };
  for entry in entry_points() {
    if let Some(body) = eval.find_sub(ctx, entry) {
      let c = Ck { decls: decls, entry: entry };
      out = check_block(c, body, false, max_call_depth(), out);
    }
  }
  return out;
}

pub function unreachable_subs(decls: ast.Decl[]): string[] {
  let reached: string[] = [];
  let ctx = eval.Ctx { decls: decls };
  for entry in entry_points() {
    if let Some(body) = eval.find_sub(ctx, entry) {
      reached = mark_reached(ctx, body, reached, max_call_depth());
    }
  }
  let out: string[] = [];
  for d in decls {
    if let DSub(s) = d {
      if (!s.name.starts_with("vcl_") && !cmp.contains(reached, s.name)) {
        out = out.append(s.name);
      }
    }
  }
  return out;
}

function mark_reached(ctx: eval.Ctx, b: ast.Block, reached: string[], depth: i32): string[] {
  let acc = reached;
  if (depth <= 0) {
    return acc;
  }
  for stmt in b.stmts {
    acc = mark_reached_stmt(ctx, stmt, acc, depth);
  }
  return acc;
}

function mark_reached_stmt(ctx: eval.Ctx, s: ast.Stmt, reached: string[], depth: i32): string[] {
  match (s) {
    SCall(x) => {
      if (cmp.contains(reached, x.name)) {
        return reached;
      }
      let acc = reached.append(x.name);
      return match (eval.find_sub(ctx, x.name)) { Some(body) => mark_reached(ctx, body, acc, depth - 1), None => acc };
    },
    SIf(x) => {
      let acc = reached;
      for arm in x.arms {
        acc = mark_reached(ctx, arm.body, acc, depth);
      }
      if (x.has_else) {
        acc = mark_reached(ctx, x.else_blk, acc, depth);
      }
      return acc;
    },
    SBlock(b) => {
      return mark_reached(ctx, b, reached, depth);
    },
    _ => {
      return reached;
    }
  }
}
