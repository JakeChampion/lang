import "core/cmp";
import "std/array";
import "std/string";
import "std/i32";
import "std/io";

struct Counts { lines: i32, words: i32, bytes: i32, chars: i32 }

@derive(cmp.Eq)
struct Show { lines: boolean, words: boolean, bytes: boolean, chars: boolean }

function count(text: string): Counts {
  let lines = 0;
  let chars = 0;
  for b in text.as_bytes() {
    if (b == b'\n') {
      lines += 1;
    }
    if (b < 128 || b >= 192) {
      chars += 1;
    }
  }
  return Counts { lines: lines, words: text.fields().len(), bytes: text.len(), chars: chars };
}

function add(a: Counts, b: Counts): Counts {
  return Counts { lines: a.lines + b.lines, words: a.words + b.words, bytes: a.bytes + b.bytes, chars: a.chars + b.chars };
}

function format_row(c: Counts, sh: Show, label: string): string {
  let out = "";
  if (sh.lines) {
    out += c.lines.to_string().pad_start(7, ' ');
  }
  if (sh.words) {
    out += c.words.to_string().pad_start(8, ' ');
  }
  if (sh.bytes) {
    out += c.bytes.to_string().pad_start(8, ' ');
  }
  if (sh.chars) {
    out += c.chars.to_string().pad_start(8, ' ');
  }
  if (!label.is_empty()) {
    out += f" {label}";
  }
  return out.trim_start().to_owned();
}

function main(): i32 {
  let argv = args();
  let none = Show { lines: false, words: false, bytes: false, chars: false };
  let sh = none;
  let inputs: string[] = [];

  for a in array.drop(argv, 1) {
    match (a) {
      "-l" => {
        sh = Show { ...sh, lines: true };
      },
      "-w" => {
        sh = Show { ...sh, words: true };
      },
      "-c" => {
        sh = Show { ...sh, bytes: true };
      },
      "-m" => {
        sh = Show { ...sh, chars: true };
      },
      _ => {
        inputs = inputs.append(a);
      }
    }
  }
  if (sh == none) {
    sh = Show { lines: true, words: true, bytes: true, chars: false };
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let total = Counts { lines: 0, words: 0, bytes: 0, chars: 0 };
  let nfiles = 0;
  let status = 0;

  for input in inputs {
    let label = if (input == "-") { "" } else { input };
    match (io.read_input(input)) {
      Ok(text) => {
        let c = count(text);
        print(format_row(c, sh, label));
        total = add(total, c);
        nfiles += 1;
      },
      Err(_) => {
        eprint(f"wc: {input}: No such file or directory");
        status = 1;
      }
    }
  }
  if (nfiles > 1) {
    print(format_row(total, sh, "total"));
  }
  return status;
}
