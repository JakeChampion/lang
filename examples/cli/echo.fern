import "std/string";
import "std/utf8";
import "std/array";

function unescape(s: string): string {
  let n = s.len();
  let out = "";
  let i = 0;
  while (i < n) {
    if (s[i] == b'\\' && i + 1 < n) {
      let end = i + 2;
      match (s[i + 1]) {
        b'n' => {
          out += "\n";
        },
        b't' => {
          out += "\t";
        },
        b'r' => {
          out += "\r";
        },
        b'\\' => {
          out += "\\";
        },
        b'0' => {
          out += "\x00";
        },
        _ => {
          end = utf8.ceil_char_boundary(s, end);
          out += slice_unchecked(s, i, end);
        }
      }
      i = end;
    } else {
      let end = utf8.ceil_char_boundary(s, i + 1);
      out += slice_unchecked(s, i, end);
      i = end;
    }
  }
  return out;
}

function main(): i32 {
  let argv = args();
  let newline = true;
  let escapes = false;
  let words: string[] = [];

  let still_flags = true;
  for a in array.drop(argv, 1) {
    if (still_flags && a == "-n") {
      newline = false;
    } else if (still_flags && a == "-e") {
      escapes = true;
    } else if (still_flags && (a == "-ne" || a == "-en")) {
      newline = false;
      escapes = true;
    } else {
      still_flags = false;
      words = words.append(a);
    }
  }

  let joined = words.join(" ");
  let line = if (escapes) { unescape(joined) } else { joined };
  if (newline) {
    print(line);
  } else {
    write(line);
  }
  return 0;
}
