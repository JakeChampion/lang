import "std/string";
import "std/array";

function unescape(s: string): string {
  let n: i32 = s.len();
  let out: string = "";
  let i: i32 = 0;
  while (i < n) {
    if (s[i] == 92 && i + 1 < n) {
      let c: i32 = s[i + 1] as i32;
      if (c == 110) {
        out = out + "\n";
      } else if (c == 116) {
        out = out + "\t";
      } else if (c == 114) {
        out = out + "\r";
      } else if (c == 92) {
        out = out + "\\";
      } else if (c == 48) {
        out = out + "\x00";
      } else {
        out = out + slice_unchecked(s, i, i + 2);
      }
      i = i + 2;
    } else {
      out = out + slice_unchecked(s, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

function main(): i32 {
  let argv: string[] = args();
  let newline: boolean = true;
  let escapes: boolean = false;
  let words: string[] = [];

  let i: i32 = 1;
  let still_flags: boolean = true;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (still_flags && a == "-n") {
      newline = false;
    } else if (still_flags && a == "-e") {
      escapes = true;
    } else if (still_flags && (a == "-ne" || a == "-en")) {
      newline = false;
      escapes = true;
    } else {
      still_flags = false;
      words = words.append(a);
    }
    i = i + 1;
  }

  let line: string = words.join(" ");
  if (escapes) {
    line = unescape(line);
  }
  if (newline) {
    print(line);
  } else {
    write(line);
  }
  return 0;
}
