import "std/string";
import "std/array";

function unescape(s: string): string {
  let n = s.len();
  let out = "";
  let i = 0;
  while (i < n) {
    if (s[i] == 92 && i + 1 < n) {
      let c = s[i + 1] as i32;
      if (c == 110) {
        out += "\n";
      } else if (c == 116) {
        out += "\t";
      } else if (c == 114) {
        out += "\r";
      } else if (c == 92) {
        out += "\\";
      } else if (c == 48) {
        out += "\x00";
      } else {
        out += slice_unchecked(s, i, i + 2);
      }
      i += 2;
    } else {
      out += slice_unchecked(s, i, i + 1);
      i += 1;
    }
  }
  return out;
}

function main(): i32 {
  let argv = args();
  let newline = true;
  let escapes = false;
  let words: string[] = [];

  let i = 1;
  let still_flags = true;
  while (i < argv.len()) {
    let a = argv[i];
    if (still_flags && a == "-n") {
      newline = false;
    } else if (still_flags && a == "-e") {
      escapes = true;
    } else if (still_flags && (a == "-ne" || a == "-en")) {
      newline = false;
      escapes = true;
    } else {
      still_flags = false;
      words = words.append(a);
    }
    i += 1;
  }

  let line = words.join(" ");
  if (escapes) {
    line = unescape(line);
  }
  if (newline) {
    print(line);
  } else {
    write(line);
  }
  return 0;
}
