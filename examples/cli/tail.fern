// tail.fern — print the trailing part of each input, like `tail(1)`.
//
//   -n N   print the last N lines (default 10)
//   -c N   print the last N bytes (overrides -n)
//
// Accepts the same `-n N` / `-nN` / `-N` flag shapes as `head`. With
// multiple files each is preceded by a `==> name <==` banner.
//
//   $ ./tail -n 3 file.txt
//   $ seq 100 | ./tail -5
//
// Showcases: slicing from the end of an array / string, shared
// flag-parsing shape with head.fern.
import "std/result";
import "std/string";
import "std/i32";
import "std/io";

struct Opts { count: i32, by_bytes: boolean }

function emit(text: string, o: Opts): void {
  if (o.by_bytes) {
    write(text.drop(text.len() - o.count));
    return;
  }
  let lines = text.lines();
  for i in (lines.len() - o.count).max(0)..lines.len() {
    print(lines[i]);
  }
}

function main(): i32 {
  let argv = args();
  let o = Opts { count: 10, by_bytes: false };
  let inputs: string[] = [];
  let status = 0;

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-n" && i + 1 < argv.len()) {
      o = Opts { ...o, count: i32.parse_i32(argv[i + 1]).unwrap_or(10), by_bytes: false };
      i += 1;
    } else if (a == "-c" && i + 1 < argv.len()) {
      o = Opts { ...o, count: i32.parse_i32(argv[i + 1]).unwrap_or(10), by_bytes: true };
      i += 1;
    } else if (a.starts_with("-n")) {
      o = Opts { ...o, count: i32.parse_i32(a.drop(2)).unwrap_or(10), by_bytes: false };
    } else if (a.starts_with("-c")) {
      o = Opts { ...o, count: i32.parse_i32(a.drop(2)).unwrap_or(10), by_bytes: true };
    } else if (a.len() > 1 && a[0] == b'-' && a[1].is_ascii_digit()) {
      o = Opts { ...o, count: i32.parse_i32(a.drop(1)).unwrap_or(10), by_bytes: false };
    } else {
      inputs = inputs.append(a);
    }
    i += 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let multi = inputs.len() > 1;
  for j in 0..inputs.len() {
    let input = inputs[j];
    match (io.read_input(input)) {
      Ok(text) => {
        if (multi) {
          if (j > 0) {
            print("");
          }
          print(f"==> {input} <==");
        }
        emit(text, o);
      },
      Err(_) => {
        eprint(f"tail: cannot open '{input}' for reading");
        status = 1;
      }
    }
  }
  return status;
}
