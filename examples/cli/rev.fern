import "std/string";
import "std/io";
import "std/array";

function reverse_bytes(s: string): string {
  let n = s.len();
  let out = "";
  let i = n - 1;
  while (i >= 0) {
    out += slice_unchecked(s, i, i + 1);
    i -= 1;
  }
  return out;
}

function main(): i32 {
  let argv = args();
  let inputs = array.drop(argv, 1);
  let status = 0;
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  for input in inputs {
    match (io.read_input(input)) {
      Ok(text) => {
        for line in text.lines() {
          print(reverse_bytes(line));
        }
      },
      Err(_) => {
        eprint("rev: cannot open " + input);
        status = 1;
      }
    }
  }
  return status;
}
