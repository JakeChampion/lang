// rev.fern — reverse the bytes of each line, like `rev(1)`.
//
// Each line is emitted with its byte order reversed; line order is
// preserved. Operates on raw bytes (so multi-byte UTF-8 sequences are
// reversed byte-wise, matching util-linux `rev`).
//
//   $ printf 'hello\nworld\n' | ./rev
//   olleh
//   dlrow
//
// Showcases: building a string by walking another backwards, the
// single-byte slice idiom `s[i:i+1]`.
import "std/string";
import "std/io";

function reverse_bytes(s: string): string {
  let n: i32 = s.len();
  let out: string = "";
  let i: i32 = n - 1;
  while (i >= 0) {
    out = out + slice_unchecked(s, i, i + 1);
    i = i - 1;
  }
  return out;
}

function main(): i32 {
  let argv: string[] = args();
  let inputs: string[] = [];
  let status: i32 = 0;
  let i: i32 = 1;
  while (i < argv.len()) {
    inputs = inputs.append(argv[i]);
    i = i + 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let j: i32 = 0;
  while (j < inputs.len()) {
    match (io.read_input(inputs[j])) {
      Ok(text) => {
        let lines: string[] = text.lines();
        let k: i32 = 0;
        while (k < lines.len()) {
          print(reverse_bytes(lines[k]));
          k = k + 1;
        }
      },
      Err(_) => {
        eprint("rev: cannot open " + inputs[j]);
        status = 1;
      }
    }
    j = j + 1;
  }
  return status;
}
