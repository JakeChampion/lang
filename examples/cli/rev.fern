import "std/string";
import "std/io";

function reverse_bytes(s: string): string {
  let n = s.len();
  let out = "";
  let i = n - 1;
  while (i >= 0) {
    out += slice_unchecked(s, i, i + 1);
    i -= 1;
  }
  return out;
}

function main(): i32 {
  let argv = args();
  let inputs: string[] = [];
  let status = 0;
  let i = 1;
  while (i < argv.len()) {
    inputs = inputs.append(argv[i]);
    i += 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let j = 0;
  while (j < inputs.len()) {
    match (io.read_input(inputs[j])) {
      Ok(text) => {
        let lines = text.lines();
        let k = 0;
        while (k < lines.len()) {
          print(reverse_bytes(lines[k]));
          k += 1;
        }
      },
      Err(_) => {
        eprint("rev: cannot open " + inputs[j]);
        status = 1;
      }
    }
    j += 1;
  }
  return status;
}
