import "std/string";
import "std/utf8";
import "std/io";
import "std/array";

function reversed(s: string): string {
  let out = "";
  let end = s.len();
  while (end > 0) {
    let start = utf8.floor_char_boundary(s, end - 1);
    out += slice_unchecked(s, start, end);
    end = start;
  }
  return out;
}

function main(): i32 {
  let argv = args();
  let inputs = array.drop(argv, 1);
  let status = 0;
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  for input in inputs {
    match (io.read_input(input)) {
      Ok(text) => {
        for line in text.lines() {
          print(reversed(line));
        }
      },
      Err(_) => {
        eprint("rev: cannot open " + input);
        status = 1;
      }
    }
  }
  return status;
}
