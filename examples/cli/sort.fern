import "std/string";
import "std/i32";
import "std/io";
import "core/cmp";
import "std/array";

function fold_order(a: string, b: string): i32 {
  return a.cmp_ignore_ascii_case(b);
}

struct Opts { reverse: boolean, numeric: boolean, uniq: boolean, fold: boolean }

function slurp(path: string): string {
  match (io.read_input(path)) {
    Ok(contents) => {
      return contents;
    },
    Err(_) => {
      return "";
    }
  }
}

function leading_int(s: string): i32 {
  let t = s.trim_start();
  match (i32.parse_i32(t)) {
    Ok(n) => {
      return n;
    },
    Err(_) => {
      return 0;
    }
  }
}

function main(): i32 {
  let argv = args();
  let o = Opts { reverse: false, numeric: false, uniq: false, fold: false };
  let inputs: string[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-r") {
      o = Opts { ...o, reverse: true };
    } else if (a == "-n") {
      o = Opts { ...o, numeric: true };
    } else if (a == "-u") {
      o = Opts { ...o, uniq: true };
    } else if (a == "-f") {
      o = Opts { ...o, fold: true };
    } else {
      inputs = inputs.append(a);
    }
    i += 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let lines: string[] = [];
  let j = 0;
  while (j < inputs.len()) {
    let ls = slurp(inputs[j]).lines();
    let k = 0;
    while (k < ls.len()) {
      lines = lines.append(ls[k]);
      k += 1;
    }
    j += 1;
  }

  let sorted: string[] = [];
  if (o.numeric) {
    let keys: i32[] = [];
    let m = 0;
    while (m < lines.len()) {
      keys = keys.append(leading_int(lines[m]));
      m += 1;
    }
    let a = 1;
    while (a < lines.len()) {
      let kv = keys[a];
      let lv = lines[a];
      let b = a - 1;
      while (b >= 0 && keys[b] > kv) {
        keys = keys.with(b + 1, keys[b]);
        lines = lines.with(b + 1, lines[b]);
        b -= 1;
      }
      keys = keys.with(b + 1, kv);
      lines = lines.with(b + 1, lv);
      a += 1;
    }
    sorted = lines;
  } else if (o.fold) {
    sorted = cmp.sort_by(lines, fold_order);
  } else {
    sorted = cmp.sort(lines);
  }

  if (o.reverse) {
    sorted = sorted.reverse();
  }

  let prev = "";
  let have_prev = false;
  let p = 0;
  while (p < sorted.len()) {
    let line = sorted[p];
    if (o.uniq && have_prev && line == prev) {
      p += 1;
      continue;
    }
    print(line);
    prev = line;
    have_prev = true;
    p += 1;
  }
  return 0;
}
