import "std/result";
import "std/string";
import "std/i32";
import "std/io";
import "core/cmp";
import "std/array";

function fold_order(a: string, b: string): i32 {
  return a.cmp_ignore_ascii_case(b);
}

struct Opts { reverse: boolean, numeric: boolean, uniq: boolean, fold: boolean }

function slurp(path: string): string {
  return io.read_input(path).unwrap_or("");
}

function leading_int(s: string): i32 {
  return i32.parse_i32(s.trim_start()).unwrap_or(0);
}

function sort_numeric(lines: string[]): string[] {
  let keys = lines |> array.map(leading_int);
  for a in 1..lines.len() {
    let kv = keys[a];
    let lv = lines[a];
    let b = a - 1;
    while (b >= 0 && keys[b] > kv) {
      keys = keys.with(b + 1, keys[b]);
      lines = lines.with(b + 1, lines[b]);
      b -= 1;
    }
    keys = keys.with(b + 1, kv);
    lines = lines.with(b + 1, lv);
  }
  return lines;
}

function main(): i32 {
  let argv = args();
  let o = Opts { reverse: false, numeric: false, uniq: false, fold: false };
  let inputs: string[] = [];

  for a in array.drop(argv, 1) {
    match (a) {
      "-r" => {
        o = Opts { ...o, reverse: true };
      },
      "-n" => {
        o = Opts { ...o, numeric: true };
      },
      "-u" => {
        o = Opts { ...o, uniq: true };
      },
      "-f" => {
        o = Opts { ...o, fold: true };
      },
      _ => {
        inputs = inputs.append(a);
      }
    }
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let lines: string[] = [];
  for input in inputs {
    for line in slurp(input).lines() {
      lines = lines.append(line);
    }
  }

  let sorted = if (o.numeric) { sort_numeric(lines) } else if (o.fold) { cmp.sort_by(lines, fold_order) } else { cmp.sort(lines) };

  if (o.reverse) {
    sorted = sorted.reverse();
  }

  let prev = "";
  let have_prev = false;
  for line in sorted {
    if (o.uniq && have_prev && line == prev) {
      continue;
    }
    print(line);
    prev = line;
    have_prev = true;
  }
  return 0;
}
