// fold.fern — wrap input lines to a fixed width, like `fold(1)`.
//
//   -w N    wrap at N columns (default 80)
//   -s      break at the last space within the width, when possible
//
//   $ printf 'aaaaaaaa\n' | ./fold -w 3
//   aaa
//   aaa
//   aa
//   $ echo 'the quick brown fox' | ./fold -s -w 10
//   the quick
//   brown fox
//
// Showcases: chunking a string to a width, optional word-boundary
// breaking via `last_index_of`.
import "std/result";
import "std/string";
import "std/i32";
import "std/io";

function slurp(path: string): string {
  return io.read_input(path).unwrap_or("");
}

function fold_line(line: string, width: i32, at_spaces: boolean): void {
  if (width <= 0) {
    print(line);
    return;
  }
  let rest: str = line;
  while (rest.len() > width) {
    let brk = width;
    if (at_spaces) {
      let head = rest.take(width);
      if let Some(sp) = head.last_index_of(" ") {
        if (sp > 0) {
          brk = sp + 1;
        }
      }
    }
    print(rest.take(brk));
    rest = rest.drop(brk);
  }
  print(rest);
}

function main(): i32 {
  let argv = args();
  let width = 80;
  let at_spaces = false;
  let inputs: string[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-w" && i + 1 < argv.len()) {
      width = i32.parse_i32(argv[i + 1]).unwrap_or(width);
      i += 1;
    } else if (a.starts_with("-w")) {
      width = i32.parse_i32(a.drop(2)).unwrap_or(width);
    } else if (a == "-s") {
      at_spaces = true;
    } else {
      inputs = inputs.append(a);
    }
    i += 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  for input in inputs {
    for line in slurp(input).lines() {
      fold_line(line, width, at_spaces);
    }
  }
  return 0;
}
