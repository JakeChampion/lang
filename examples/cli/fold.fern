// fold.fern — wrap input lines to a fixed width, like `fold(1)`.
//
//   -w N    wrap at N columns (default 80)
//   -s      break at the last space within the width, when possible
//
//   $ printf 'aaaaaaaa\n' | ./fold -w 3
//   aaa
//   aaa
//   aa
//   $ echo 'the quick brown fox' | ./fold -s -w 10
//   the quick
//   brown fox
//
// Showcases: chunking a string to a width, optional word-boundary
// breaking via `last_index_of`.
import "core/no_prelude";
import "std/string";
import "std/i32";
import "std/io";

function slurp(path: string): string {
  match (io.read_input(path)) {
    Ok(contents) => {
      return contents;
    },
    Err(_) => {
      return "";
    }
  }
}

function fold_line(line: string, width: i32, at_spaces: boolean): void {
  if (width <= 0) {
    print(line);
    return;
  }
  var rest: string = line;
  while (rest.len() > width) {
    var brk: i32 = width;
    if (at_spaces) {
      // Prefer the last space within the first `width` columns.
      var head: string = rest.take(width);
      var sp: i32 = head.last_index_of(" ");
      if (sp > 0) {
        brk = sp + 1;
      }
    }
    print(rest.take(brk));
    rest = rest.drop(brk);
  }
  print(rest);
}

function main(): i32 {
  var argv: string[] = args();
  var width: i32 = 80;
  var at_spaces: boolean = false;
  var inputs: string[] = [];

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "-w" && i + 1 < argv.len()) {
      width = argv[i + 1].parse_int_or(width);
      i = i + 1;
    } else if (a.starts_with("-w")) {
      width = a.drop(2).parse_int_or(width);
    } else if (a == "-s") {
      at_spaces = true;
    } else {
      inputs = inputs.append(a);
    }
    i = i + 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  var j: i32 = 0;
  while (j < inputs.len()) {
    var lines: string[] = slurp(inputs[j]).lines();
    var k: i32 = 0;
    while (k < lines.len()) {
      fold_line(lines[k], width, at_spaces);
      k = k + 1;
    }
    j = j + 1;
  }
  return 0;
}
