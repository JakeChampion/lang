import "std/string";
import "std/i32";
import "std/io";

function slurp(path: string): string {
  match (io.read_input(path)) {
    Ok(contents) => {
      return contents;
    },
    Err(_) => {
      return "";
    }
  }
}

function fold_line(line: string, width: i32, at_spaces: boolean): void {
  if (width <= 0) {
    print(line);
    return;
  }
  let rest: str = line;
  while (rest.len() > width) {
    let brk: i32 = width;
    if (at_spaces) {
      let head: str = rest.take(width);
      if let Some(sp) = head.last_index_of(" ") {
        if (sp > 0) {
          brk = sp + 1;
        }
      }
    }
    print(rest.take(brk));
    rest = rest.drop(brk);
  }
  print(rest);
}

function main(): i32 {
  let argv: string[] = args();
  let width: i32 = 80;
  let at_spaces: boolean = false;
  let inputs: string[] = [];

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-w" && i + 1 < argv.len()) {
      width = argv[i + 1].parse_int_or(width);
      i = i + 1;
    } else if (a.starts_with("-w")) {
      width = a.drop(2).parse_int_or(width);
    } else if (a == "-s") {
      at_spaces = true;
    } else {
      inputs = inputs.append(a);
    }
    i = i + 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let j: i32 = 0;
  while (j < inputs.len()) {
    let lines: string[] = slurp(inputs[j]).lines();
    let k: i32 = 0;
    while (k < lines.len()) {
      fold_line(lines[k], width, at_spaces);
      k = k + 1;
    }
    j = j + 1;
  }
  return 0;
}
