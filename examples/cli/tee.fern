// tee.fern — copy stdin to stdout and to each named file, like
// `tee(1)`.
//
//   -a   append to the files instead of truncating
//
//   $ echo hi | ./tee a.txt b.txt        # writes hi to stdout, a, b
//   $ printf 'more\n' | ./tee -a a.txt    # appends to a.txt
//
// `tee` buffers all of stdin and then fans it out, so it uses the
// one-shot `read_file` / `write_file` builtins rather than a
// streaming Writer: append is just "read what's there, concatenate,
// write it back". For a short-lived filter that's simpler and avoids
// holding extra descriptors open.
//
// Showcases: reading all of stdin, fanning one buffer out to stdout
// plus N files, `read_file` + `write_file`, and reporting per-file
// errors without aborting the whole run.
import "std/string";
import "std/io";
import "std/array";

function existing(path: string): string {
  match (read_file(path)) {
    Ok(contents) => {
      return contents;
    },
    Err(_) => {
      return "";
    }
  }
}

function main(): i32 {
  let argv: string[] = args();
  let append: boolean = false;
  let files: string[] = [];

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-a" || a == "--append") {
      append = true;
    } else {
      files = files.append(a);
    }
    i = i + 1;
  }

  let data: string = io.read_all_stdin();
  // Always echo to stdout first.
  write(data);

  let status: i32 = 0;
  let j: i32 = 0;
  while (j < files.len()) {
    let path: string = files[j];
    let payload: string = data;
    if (append) {
      payload = existing(path) + data;
    }
    match (write_file(path, payload)) {
      Err(_) => {
        eprint("tee: " + path + ": cannot write");
        status = 1;
      },
      Ok(_) => {}
    }
    j = j + 1;
  }
  return status;
}
