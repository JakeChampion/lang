import "std/io";
import "std/array";

function open_output(path: string, append: boolean): Result[Writer, IoError] {
  if (append) {
    return open_appender(path);
  }
  return open_writer(path);
}

function write_output(path: string, append: boolean, bytes: u8[]): Result[void, IoError] {
  let w = open_output(path, append)?;
  let written = w.write_bytes(bytes);
  let closed = w.close();
  if let Err(e) = written {
    return Err(e);
  }
  return closed;
}

function copy_outputs(data: u8[], files: string[], append: boolean): i32 {
  let status = 0;
  if let Err(_) = stdout().write_bytes(data) {
    eprint("tee: cannot write stdout");
    status = 1;
  }
  for path in files {
    if let Err(_) = write_output(path, append, data) {
      eprint("tee: " + path + ": cannot write");
      status = 1;
    }
  }
  return status;
}

function main(): i32 {
  let argv = args();
  let append = false;
  let files: string[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-a" || a == "--append") {
      append = true;
    } else {
      files = files.append(a);
    }
    i += 1;
  }

  match (io.read_all_stdin_bytes()) {
    Err(_) => {
      eprint("tee: cannot read stdin");
      return 1;
    },
    Ok(data) => {
      return copy_outputs(data, files, append);
    }
  }
}
