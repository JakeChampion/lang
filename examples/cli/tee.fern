// tee.fern — copy stdin to stdout and to each named file, like
// `tee(1)`.
//
//   -a   append to the files instead of truncating
//
//   $ echo hi | ./tee a.txt b.txt        # writes hi to stdout, a, b
//   $ printf 'more\n' | ./tee -a a.txt    # appends to a.txt
//
// `tee` buffers stdin as raw bytes, then writes the buffer to each output.
// Append opens the file in append mode, preserving its existing bytes.
//
// Showcases: reading all of stdin, fanning one buffer out to stdout
// plus N files, raw Writer operations, and reporting per-file
// errors without aborting the whole run.
import "std/io";
import "std/array";

function open_output(path: string, append: boolean): Result[Writer, IoError] {
  if (append) {
    return open_appender(path);
  }
  return open_writer(path);
}

function write_output(path: string, append: boolean, bytes: u8[]): Option[IoError] {
  match (open_output(path, append)) {
    Err(e) => {
      return Some(e);
    },
    Ok(w) => {
      let written: Option[IoError] = w.write_bytes(bytes);
      let closed: Option[IoError] = w.close();
      match (written) {
        Some(e) => {
          return Some(e);
        },
        None => {
          return closed;
        }
      }
    }
  }
}

function copy_outputs(data: u8[], files: string[], append: boolean): i32 {
  let status: i32 = 0;
  match (stdout().write_bytes(data)) {
    Some(_) => {
      eprint("tee: cannot write stdout");
      status = 1;
    },
    None => {}
  }
  for path in files {
    match (write_output(path, append, data)) {
      Some(_) => {
        eprint("tee: " + path + ": cannot write");
        status = 1;
      },
      None => {}
    }
  }
  return status;
}

function main(): i32 {
  let argv: string[] = args();
  let append: boolean = false;
  let files: string[] = [];

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-a" || a == "--append") {
      append = true;
    } else {
      files = files.append(a);
    }
    i = i + 1;
  }

  match (io.read_all_stdin_bytes()) {
    Err(_) => {
      eprint("tee: cannot read stdin");
      return 1;
    },
    Ok(data) => {
      return copy_outputs(data, files, append);
    }
  }
}
