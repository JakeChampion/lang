// seq.fern — print a sequence of integers, like `seq(1)`.
//
//   seq LAST              1, 2, ... LAST
//   seq FIRST LAST        FIRST .. LAST  (step +1)
//   seq FIRST STEP LAST   FIRST, FIRST+STEP, ... not past LAST
//
//   -s STR   separator between numbers (default newline)
//   -w       equal-width, zero-padded to the widest value
//
//   $ ./seq 5
//   $ ./seq 2 2 10
//   $ ./seq -s , 1 5      ->  1,2,3,4,5
//
// Showcases: positional integer operands, descending sequences
// (negative step), `-w` width computation.
import "core/no_prelude";
import "std/string";
import "std/i32";

// Width (in characters, including a leading '-') of an i32 rendered
// as decimal — used by -w to zero-pad every value to the widest.
function width_of(n: i32): i32 {
  return n.to_string().len();
}

function main(): i32 {
  var argv: string[] = args();
  var sep: string = "\n";
  var equal_width: boolean = false;
  var nums: i32[] = [];

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "-s" && i + 1 < argv.len()) {
      sep = argv[i + 1];
      i = i + 1;
    } else if (a == "-w") {
      equal_width = true;
    } else {
      match (a.parse_int()) {
        Some(n) => {
          nums = nums.append(n);
        },
        None => {
          eprint("seq: invalid integer argument: " + a);
          return 1;
        }
      }
    }
    i = i + 1;
  }

  var first: i32 = 1;
  var step: i32 = 1;
  var last: i32 = 0;
  if (nums.len() == 1) {
    last = nums[0];
  } else if (nums.len() == 2) {
    first = nums[0];
    last = nums[1];
  } else if (nums.len() == 3) {
    first = nums[0];
    step = nums[1];
    last = nums[2];
  } else {
    eprint("usage: seq [-w] [-s sep] [first [step]] last");
    return 1;
  }
  if (step == 0) {
    eprint("seq: step must be non-zero");
    return 1;
  }

  // Compute pad width from the two endpoints (good enough for the
  // common ranges; GNU seq scans every value, but endpoints bound
  // the digit count for a monotonic sequence).
  var pad: i32 = 0;
  if (equal_width) {
    pad = width_of(first);
    if (width_of(last) > pad) {
      pad = width_of(last);
    }
  }

  var out: string = "";
  var n: i32 = first;
  var count: i32 = 0;
  // Ascending when step > 0, descending when step < 0.
  while (step > 0 && n <= last || step < 0 && n >= last) {
    var piece: string = n.to_string();
    if (equal_width) {
      piece = piece.pad_start(pad, "0");
    }
    if (count > 0) {
      out = out + sep;
    }
    out = out + piece;
    n = n + step;
    count = count + 1;
  }
  if (count > 0) {
    print(out);
  }
  return 0;
}
