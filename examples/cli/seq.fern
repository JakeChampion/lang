import "std/string";
import "std/i32";

function width_of(n: i32): i32 {
  return n.to_string().len();
}

function main(): i32 {
  let argv = args();
  let sep = "\n";
  let equal_width = false;
  let nums: i32[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-s" && i + 1 < argv.len()) {
      sep = argv[i + 1];
      i += 1;
    } else if (a == "-w") {
      equal_width = true;
    } else {
      match (i32.parse_i32(a)) {
        Ok(n) => {
          nums = nums.append(n);
        },
        Err(_) => {
          eprint("seq: invalid integer argument: " + a);
          return 1;
        }
      }
    }
    i += 1;
  }

  let first = 1;
  let step = 1;
  let last = 0;
  if (nums.len() == 1) {
    last = nums[0];
  } else if (nums.len() == 2) {
    first = nums[0];
    last = nums[1];
  } else if (nums.len() == 3) {
    first = nums[0];
    step = nums[1];
    last = nums[2];
  } else {
    eprint("usage: seq [-w] [-s sep] [first [step]] last");
    return 1;
  }
  if (step == 0) {
    eprint("seq: step must be non-zero");
    return 1;
  }

  let pad = 0;
  if (equal_width) {
    pad = width_of(first);
    if (width_of(last) > pad) {
      pad = width_of(last);
    }
  }

  let out = "";
  let n = first;
  let count = 0;
  while (step > 0 && n <= last || step < 0 && n >= last) {
    let piece = n.to_string();
    if (equal_width) {
      piece = piece.pad_start(pad, '0');
    }
    if (count > 0) {
      out += sep;
    }
    out += piece;
    n += step;
    count += 1;
  }
  if (count > 0) {
    print(out);
  }
  return 0;
}
