import "std/string";
import "std/i32";

function width_of(n: i32): i32 {
  return n.to_string().len();
}

function main(): i32 {
  let argv = args();
  let sep = "\n";
  let equal_width = false;
  let nums: i32[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-s" && i + 1 < argv.len()) {
      sep = argv[i + 1];
      i += 1;
    } else if (a == "-w") {
      equal_width = true;
    } else {
      let Ok(n) = i32.parse_i32(a) else {
        eprint("seq: invalid integer argument: " + a);
        return 1;
      };
      nums = nums.append(n);
    }
    i += 1;
  }

  let (first, step, last) = match (nums.len()) { 1 => (1, 1, nums[0]), 2 => (nums[0], 1, nums[1]), 3 => (nums[0], nums[1], nums[2]), _ => { eprint("usage: seq [-w] [-s sep] [first [step]] last"); return 1; } };
  if (step == 0) {
    eprint("seq: step must be non-zero");
    return 1;
  }

  let pad = if (equal_width) { width_of(first).max(width_of(last)) } else { 0 };

  let out = "";
  let n = first;
  let count = 0;
  while (step > 0 && n <= last || step < 0 && n >= last) {
    let piece = if (equal_width) { n.to_string().pad_start(pad, '0') } else { n.to_string() };
    if (count > 0) {
      out += sep;
    }
    out += piece;
    n += step;
    count += 1;
  }
  if (count > 0) {
    print(out);
  }
  return 0;
}
