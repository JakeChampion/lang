import "std/result";
import "std/string";
import "std/i32";
import "std/io";
import "std/array";

function parse_list(spec: string): (i32, i32)[] {
  let out: (i32, i32)[] = [];
  for p in spec.split(",") {
    if let Some((los, his)) = p.split_once("-") {
      let lo = i32.parse_i32(los).unwrap_or(1);
      let hi = i32.parse_i32(his).unwrap_or(0);
      out = out.append((lo, hi));
    } else if let Ok(n) = i32.parse_i32(p) {
      out = out.append((n, n));
    }
  }
  return out;
}

function selected(pos: i32, ranges: (i32, i32)[]): boolean {
  for r in ranges {
    let (lo, hi) = r;
    if (pos >= lo && (hi == 0 || pos <= hi)) {
      return true;
    }
  }
  return false;
}

function cut_fields(line: string, delim: string, ranges: (i32, i32)[]): string {
  if (!line.contains(delim)) {
    return line;
  }
  let fields = line.split(delim);
  let picked: string[] = [];
  for i in 0..fields.len() {
    if (selected(i + 1, ranges)) {
      picked = picked.append(fields[i]);
    }
  }
  return picked.join(delim);
}

function cut_chars(line: string, ranges: (i32, i32)[]): string {
  let out = "";
  for i in 0..line.len() {
    if (selected(i + 1, ranges)) {
      out += slice_unchecked(line, i, i + 1);
    }
  }
  return out;
}

function slurp(path: string): string {
  return io.read_input(path).unwrap_or("");
}

function main(): i32 {
  let argv = args();
  let delim = "\t";
  let spec = "";
  let mode = "";
  let inputs: string[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-d" && i + 1 < argv.len()) {
      delim = argv[i + 1];
      i += 1;
    } else if (a == "-f" && i + 1 < argv.len()) {
      mode = "f";
      spec = argv[i + 1];
      i += 1;
    } else if (a == "-c" && i + 1 < argv.len()) {
      mode = "c";
      spec = argv[i + 1];
      i += 1;
    } else {
      inputs = inputs.append(a);
    }
    i += 1;
  }

  if (mode == "") {
    eprint("usage: cut -f LIST [-d DELIM] | -c LIST [FILE...]");
    return 2;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }
  let ranges = parse_list(spec);

  for input in inputs {
    for line in slurp(input).lines() {
      if (mode == "f") {
        print(cut_fields(line, delim, ranges));
      } else {
        print(cut_chars(line, ranges));
      }
    }
  }
  return 0;
}
