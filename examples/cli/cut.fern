import "std/string";
import "std/i32";
import "std/io";
import "std/array";

function parse_list(spec: string): (i32, i32)[] {
  let out: (i32, i32)[] = [];
  let parts: string[] = spec.split(",");
  let i: i32 = 0;
  while (i < parts.len()) {
    let p: string = parts[i];
    match (p.split_once("-")) {
      Some(bounds) => {
        let los: string = bounds.0;
        let his: string = bounds.1;
        let lo: i32 = 1;
        let hi: i32 = 0;
        if (!los.is_empty()) {
          match (i32.parse_i32(los)) {
            Ok(n) => {
              lo = n;
            },
            Err(_) => {}
          }
        }
        if (!his.is_empty()) {
          match (i32.parse_i32(his)) {
            Ok(n) => {
              hi = n;
            },
            Err(_) => {}
          }
        }
        out = out.append((lo, hi));
      },
      None => {
        match (i32.parse_i32(p)) {
          Ok(n) => {
            out = out.append((n, n));
          },
          Err(_) => {}
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function selected(pos: i32, ranges: (i32, i32)[]): boolean {
  let i: i32 = 0;
  while (i < ranges.len()) {
    let r: (i32, i32) = ranges[i];
    let lo: i32 = r.0;
    let hi: i32 = r.1;
    if (pos >= lo && (hi == 0 || pos <= hi)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function cut_fields(line: string, delim: string, ranges: (i32, i32)[]): string {
  if (!line.contains(delim)) {
    return line;
  }
  let fields: string[] = line.split(delim);
  let picked: string[] = [];
  let i: i32 = 0;
  while (i < fields.len()) {
    if (selected(i + 1, ranges)) {
      picked = picked.append(fields[i]);
    }
    i = i + 1;
  }
  return picked.join(delim);
}

function cut_chars(line: string, ranges: (i32, i32)[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < line.len()) {
    if (selected(i + 1, ranges)) {
      out = out + slice_unchecked(line, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

function slurp(path: string): string {
  match (io.read_input(path)) {
    Ok(contents) => {
      return contents;
    },
    Err(_) => {
      return "";
    }
  }
}

function main(): i32 {
  let argv: string[] = args();
  let delim: string = "\t";
  let spec: string = "";
  let mode: string = "";
  let inputs: string[] = [];

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-d" && i + 1 < argv.len()) {
      delim = argv[i + 1];
      i = i + 1;
    } else if (a == "-f" && i + 1 < argv.len()) {
      mode = "f";
      spec = argv[i + 1];
      i = i + 1;
    } else if (a == "-c" && i + 1 < argv.len()) {
      mode = "c";
      spec = argv[i + 1];
      i = i + 1;
    } else {
      inputs = inputs.append(a);
    }
    i = i + 1;
  }

  if (mode == "") {
    eprint("usage: cut -f LIST [-d DELIM] | -c LIST [FILE...]");
    return 2;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }
  let ranges: (i32, i32)[] = parse_list(spec);

  let j: i32 = 0;
  while (j < inputs.len()) {
    let lines: string[] = slurp(inputs[j]).lines();
    let k: i32 = 0;
    while (k < lines.len()) {
      if (mode == "f") {
        print(cut_fields(lines[k], delim, ranges));
      } else {
        print(cut_chars(lines[k], ranges));
      }
      k = k + 1;
    }
    j = j + 1;
  }
  return 0;
}
