import "std/string";
import "std/io";

function main(): i32 {
  let argv: string[] = args();
  let inputs: string[] = [];
  let i: i32 = 1;
  while (i < argv.len()) {
    inputs = inputs.append(argv[i]);
    i = i + 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let all: string[] = [];
  let status: i32 = 0;
  let j: i32 = 0;
  while (j < inputs.len()) {
    match (io.read_input(inputs[j])) {
      Ok(text) => {
        let lines: string[] = text.lines();
        let k: i32 = 0;
        while (k < lines.len()) {
          all = all.append(lines[k]);
          k = k + 1;
        }
      },
      Err(_) => {
        eprint("tac: " + inputs[j] + ": No such file or directory");
        status = 1;
      }
    }
    j = j + 1;
  }

  let idx: i32 = all.len() - 1;
  while (idx >= 0) {
    print(all[idx]);
    idx = idx - 1;
  }
  return status;
}
