import "std/string";
import "std/io";
import "std/array";

function main(): i32 {
  let argv = args();
  let inputs = array.drop(argv, 1);
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let all: string[] = [];
  let status = 0;
  for input in inputs {
    match (io.read_input(input)) {
      Ok(text) => {
        for line in text.lines() {
          all = all.append(line);
        }
      },
      Err(_) => {
        eprint(f"tac: {input}: No such file or directory");
        status = 1;
      }
    }
  }

  let idx = all.len() - 1;
  while (idx >= 0) {
    print(all[idx]);
    idx -= 1;
  }
  return status;
}
