// tac.fern — concatenate and print files in reverse, like `tac(1)`.
//
// `tac` is `cat` spelled backwards: it prints the lines of each input
// in reverse order (last line first). With multiple inputs the files
// are still processed in argv order, but every line ever read is
// emitted in one reversed stream — matching GNU tac's default.
//
//   $ printf 'one\ntwo\nthree\n' | ./tac
//   three
//   two
//   one
//
// Showcases: reading all input up front, accumulating into a
// `string[]`, and walking an array backwards.
import "core/no_prelude";
import "std/string";
import "std/io";

function slurp(path: string): Option[string] {
  if (path == "-" || path == "") {
    return Some(io.read_all_stdin());
  }
  match (read_file(path)) {
    Ok(contents) => {
      return Some(contents);
    },
    Err(_) => {
      return None;
    }
  }
}

function main(): i32 {
  var argv: string[] = args();
  var inputs: string[] = [];
  var i: i32 = 1;
  while (i < argv.len()) {
    inputs = inputs.append(argv[i]);
    i = i + 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  var all: string[] = [];
  var status: i32 = 0;
  var j: i32 = 0;
  while (j < inputs.len()) {
    match (slurp(inputs[j])) {
      Some(text) => {
        var lines: string[] = text.lines();
        var k: i32 = 0;
        while (k < lines.len()) {
          all = all.append(lines[k]);
          k = k + 1;
        }
      },
      None => {
        eprint("tac: " + inputs[j] + ": No such file or directory");
        status = 1;
      }
    }
    j = j + 1;
  }

  var idx: i32 = all.len() - 1;
  while (idx >= 0) {
    print(all[idx]);
    idx = idx - 1;
  }
  return status;
}
