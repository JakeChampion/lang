import "std/string";
import "std/i32";
import "std/io";
import "std/array";

struct Opts { number: boolean, number_nonblank: boolean, squeeze: boolean, show_ends: boolean, show_tabs: boolean }

function render_line(line: string, o: Opts): string {
  let body = line;
  if (o.show_tabs) {
    body = body.replace("\t", "^I");
  }
  if (o.show_ends) {
    body += "$";
  }
  return body;
}

function emit(text: string, o: Opts, counter: i32, prev_blank: boolean): (i32, boolean) {
  for line in text.lines() {
    let is_blank = line.is_empty();
    if (o.squeeze && is_blank && prev_blank) {
      continue;
    }
    prev_blank = is_blank;
    let rendered = render_line(line, o);
    let want_number = if (o.number_nonblank) { !is_blank } else { o.number };
    if (want_number) {
      counter += 1;
      let num = counter.to_string().pad_start(6, ' ');
      print(f"{num}\t{rendered}");
    } else {
      print(rendered);
    }
  }
  return (counter, prev_blank);
}

function main(): i32 {
  let argv = args();
  let o = Opts { number: false, number_nonblank: false, squeeze: false, show_ends: false, show_tabs: false };
  let inputs: string[] = [];
  let status = 0;

  for a in array.drop(argv, 1) {
    match (a) {
      "-n" | "--number" => {
        o = Opts { ...o, number: true };
      },
      "-b" | "--number-nonblank" => {
        o = Opts { ...o, number_nonblank: true };
      },
      "-s" | "--squeeze-blank" => {
        o = Opts { ...o, squeeze: true };
      },
      "-E" | "--show-ends" => {
        o = Opts { ...o, show_ends: true };
      },
      "-T" | "--show-tabs" => {
        o = Opts { ...o, show_tabs: true };
      },
      _ => {
        inputs = inputs.append(a);
      }
    }
  }

  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let counter = 0;
  let prev_blank = false;
  for input in inputs {
    match (io.read_input(input)) {
      Ok(text) => {
        let (n, blank) = emit(text, o, counter, prev_blank);
        counter = n;
        prev_blank = blank;
      },
      Err(_) => {
        eprint(f"cat: {input}: No such file or directory");
        status = 1;
      }
    }
  }
  return status;
}
