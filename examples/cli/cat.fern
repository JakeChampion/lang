import "std/string";
import "std/i32";
import "std/io";

struct Opts { number: boolean, number_nonblank: boolean, squeeze: boolean, show_ends: boolean, show_tabs: boolean }

function render_line(line: string, o: Opts): string {
  let body: string = line;
  if (o.show_tabs) {
    body = body.replace("\t", "^I");
  }
  if (o.show_ends) {
    body = body + "$";
  }
  return body;
}

function emit(text: string, o: Opts, counter: i32, prev_blank: boolean): (i32, boolean) {
  let lines: string[] = text.lines();
  let n: i32 = lines.len();
  let i: i32 = 0;
  while (i < n) {
    let line: string = lines[i];
    let is_blank: boolean = line.is_empty();
    if (o.squeeze && is_blank && prev_blank) {
      i = i + 1;
      continue;
    }
    prev_blank = is_blank;
    let rendered: string = render_line(line, o);
    let want_number: boolean = false;
    if (o.number_nonblank) {
      want_number = !is_blank;
    } else if (o.number) {
      want_number = true;
    }
    if (want_number) {
      counter = counter + 1;
      let num: string = counter.to_string().pad_start(6, ' ');
      print(num + "\t" + rendered);
    } else {
      print(rendered);
    }
    i = i + 1;
  }
  return (counter, prev_blank);
}

function main(): i32 {
  let argv: string[] = args();
  let o: Opts = Opts { number: false, number_nonblank: false, squeeze: false, show_ends: false, show_tabs: false };
  let inputs: string[] = [];
  let status: i32 = 0;

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-n" || a == "--number") {
      o = Opts { ...o, number: true };
    } else if (a == "-b" || a == "--number-nonblank") {
      o = Opts { ...o, number_nonblank: true };
    } else if (a == "-s" || a == "--squeeze-blank") {
      o = Opts { ...o, squeeze: true };
    } else if (a == "-E" || a == "--show-ends") {
      o = Opts { ...o, show_ends: true };
    } else if (a == "-T" || a == "--show-tabs") {
      o = Opts { ...o, show_tabs: true };
    } else {
      inputs = inputs.append(a);
    }
    i = i + 1;
  }

  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let counter: i32 = 0;
  let prev_blank: boolean = false;
  let j: i32 = 0;
  while (j < inputs.len()) {
    match (io.read_input(inputs[j])) {
      Ok(text) => {
        let st: (i32, boolean) = emit(text, o, counter, prev_blank);
        counter = st.0;
        prev_blank = st.1;
      },
      Err(_) => {
        eprint("cat: " + inputs[j] + ": No such file or directory");
        status = 1;
      }
    }
    j = j + 1;
  }
  return status;
}
