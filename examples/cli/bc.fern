import "std/string";
import "std/i32";
import "std/i64";
import "std/f64";
import "std/io";
import "std/array";

struct Eval { val: f64, pos: i32 }

function skip_ws(s: string, pos: i32): i32 {
  let p = pos;
  while (p < s.len() && (s[p] == b' ' || s[p] == b'\t')) {
    p += 1;
  }
  return p;
}

function parse_primary(s: string, pos: i32): Option[Eval] {
  let p = skip_ws(s, pos);
  if (p >= s.len()) {
    return None;
  }
  if (s[p] == b'(') {
    let inner = parse_expr(s, p + 1)?;
    let q = skip_ws(s, inner.pos);
    if (q >= s.len() || s[q] != b')') {
      return None;
    }
    return Some(Eval { val: inner.val, pos: q + 1 });
  }
  let v = 0.0;
  let saw_digit = false;
  while (p < s.len() && s[p].is_ascii_digit()) {
    v = v * 10.0 + (s[p] - b'0') as f64;
    saw_digit = true;
    p += 1;
  }
  if (p < s.len() && s[p] == b'.') {
    p += 1;
    let scale = 0.1;
    while (p < s.len() && s[p].is_ascii_digit()) {
      v += (s[p] - b'0') as f64 * scale;
      scale /= 10.0;
      saw_digit = true;
      p += 1;
    }
  }
  if (!saw_digit) {
    return None;
  }
  return Some(Eval { val: v, pos: p });
}

function parse_unary(s: string, pos: i32): Option[Eval] {
  let p = skip_ws(s, pos);
  if (p < s.len() && s[p] == b'-') {
    let e = parse_unary(s, p + 1)?;
    return Some(Eval { val: 0.0 - e.val, pos: e.pos });
  }
  if (p < s.len() && s[p] == b'+') {
    return parse_unary(s, p + 1);
  }
  return parse_primary(s, p);
}

function parse_power(s: string, pos: i32): Option[Eval] {
  let base = parse_unary(s, pos)?;
  let p = skip_ws(s, base.pos);
  if (p < s.len() && s[p] == b'^') {
    let exp = parse_power(s, p + 1)?;
    let n = exp.val as i32;
    let k = if (n < 0) { -n } else { n };
    let result = 1.0;
    for _ in 0..k {
      result *= base.val;
    }
    if (n < 0) {
      result = 1.0 / result;
    }
    return Some(Eval { val: result, pos: exp.pos });
  }
  return Some(base);
}

function parse_term(s: string, pos: i32): Option[Eval] {
  let left = parse_power(s, pos)?;
  let acc = left.val;
  let p = left.pos;
  loop {
    let q = skip_ws(s, p);
    if (q >= s.len()) {
      break;
    }
    let op = s[q];
    if (op != b'*' && op != b'/' && op != b'%') {
      break;
    }
    let rhs = parse_power(s, q + 1)?;
    match (op) {
      b'*' => {
        acc *= rhs.val;
      },
      b'/' => {
        if (rhs.val == 0.0) {
          return None;
        }
        acc /= rhs.val;
      },
      _ => {
        if (rhs.val == 0.0) {
          return None;
        }
        let t = (acc / rhs.val).trunc();
        acc -= t * rhs.val;
      }
    }
    p = rhs.pos;
  }
  return Some(Eval { val: acc, pos: p });
}

function parse_expr(s: string, pos: i32): Option[Eval] {
  let left = parse_term(s, pos)?;
  let acc = left.val;
  let p = left.pos;
  loop {
    let q = skip_ws(s, p);
    if (q >= s.len()) {
      break;
    }
    let op = s[q];
    if (op != b'+' && op != b'-') {
      break;
    }
    let rhs = parse_term(s, q + 1)?;
    if (op == b'+') {
      acc += rhs.val;
    } else {
      acc -= rhs.val;
    }
    p = rhs.pos;
  }
  return Some(Eval { val: acc, pos: p });
}

function format_result(v: f64): string {
  let t = v.trunc();
  if (t == v && v < 9e+15 && v > -9e+15) {
    return (v as i64).to_string();
  }
  return v.to_string();
}

function eval_line(line: string): boolean {
  let t = line.trim();
  if (t.is_empty()) {
    return true;
  }
  if let Some(e) = parse_expr(t, 0) {
    if (skip_ws(t, e.pos) == t.len()) {
      print(format_result(e.val));
      return true;
    }
  }
  eprint("bc: invalid expression: " + line);
  return false;
}

function main(): i32 {
  let argv = args();
  let ok = true;

  if (argv.len() > 1) {
    for a in array.drop(argv, 1) {
      if (!eval_line(a)) {
        ok = false;
      }
    }
    if (ok) {
      return 0;
    }
    return 1;
  }

  let Ok(text) = io.read_all_stdin() else {
    eprint("bc: cannot read UTF-8 stdin");
    return 1;
  };
  for line in text.lines() {
    if (!eval_line(line)) {
      ok = false;
    }
  }
  if (ok) {
    return 0;
  }
  return 1;
}
