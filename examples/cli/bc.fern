import "std/string";
import "std/i32";
import "std/i64";
import "std/f64";
import "std/io";

struct Eval { val: f64, pos: i32, ok: boolean }

function fail(pos: i32): Eval {
  return Eval { val: 0.0, pos: pos, ok: false };
}

function skip_ws(s: string, pos: i32): i32 {
  let p = pos;
  while (p < s.len() && (s[p] == 32 || s[p] == 9)) {
    p += 1;
  }
  return p;
}

function parse_primary(s: string, pos: i32): Eval {
  let p = skip_ws(s, pos);
  if (p >= s.len()) {
    return fail(p);
  }
  if (s[p] == 40) {
    let inner = parse_expr(s, p + 1);
    if (!inner.ok) {
      return inner;
    }
    let q = skip_ws(s, inner.pos);
    if (q >= s.len() || s[q] != 41) {
      return fail(q);
    }
    return Eval { val: inner.val, pos: q + 1, ok: true };
  }
  let start = p;
  let v: f64 = 0.0;
  let saw_digit = false;
  while (p < s.len() && s[p].is_ascii_digit()) {
    v = v * 10.0 + (s[p] - 48) as f64;
    saw_digit = true;
    p += 1;
  }
  if (p < s.len() && s[p] == 46) {
    p += 1;
    let scale: f64 = 0.1;
    while (p < s.len() && s[p].is_ascii_digit()) {
      v = v + (s[p] - 48) as f64 * scale;
      scale /= 10.0;
      saw_digit = true;
      p += 1;
    }
  }
  if (!saw_digit) {
    return fail(start);
  }
  return Eval { val: v, pos: p, ok: true };
}

function parse_unary(s: string, pos: i32): Eval {
  let p = skip_ws(s, pos);
  if (p < s.len() && s[p] == 45) {
    let e = parse_unary(s, p + 1);
    if (!e.ok) {
      return e;
    }
    return Eval { val: 0.0 - e.val, pos: e.pos, ok: true };
  }
  if (p < s.len() && s[p] == 43) {
    return parse_unary(s, p + 1);
  }
  return parse_primary(s, p);
}

function parse_power(s: string, pos: i32): Eval {
  let base = parse_unary(s, pos);
  if (!base.ok) {
    return base;
  }
  let p = skip_ws(s, base.pos);
  if (p < s.len() && s[p] == 94) {
    let exp = parse_power(s, p + 1);
    if (!exp.ok) {
      return exp;
    }
    let n = exp.val as i32;
    let result: f64 = 1.0;
    let b = base.val;
    let k = n;
    if (k < 0) {
      k = -k;
    }
    let i = 0;
    while (i < k) {
      result *= b;
      i += 1;
    }
    if (n < 0) {
      result = 1.0 / result;
    }
    return Eval { val: result, pos: exp.pos, ok: true };
  }
  return base;
}

function parse_term(s: string, pos: i32): Eval {
  let left = parse_power(s, pos);
  if (!left.ok) {
    return left;
  }
  let acc = left.val;
  let p = left.pos;
  while (true) {
    let q = skip_ws(s, p);
    if (q >= s.len()) {
      break;
    }
    let op = s[q] as i32;
    if (op != 42 && op != 47 && op != 37) {
      break;
    }
    let rhs = parse_power(s, q + 1);
    if (!rhs.ok) {
      return rhs;
    }
    if (op == 42) {
      acc *= rhs.val;
    } else if (op == 47) {
      if (rhs.val == 0.0) {
        return fail(q);
      }
      acc /= rhs.val;
    } else {
      if (rhs.val == 0.0) {
        return fail(q);
      }
      let t = (acc / rhs.val).trunc();
      acc = acc - t * rhs.val;
    }
    p = rhs.pos;
  }
  return Eval { val: acc, pos: p, ok: true };
}

function parse_expr(s: string, pos: i32): Eval {
  let left = parse_term(s, pos);
  if (!left.ok) {
    return left;
  }
  let acc = left.val;
  let p = left.pos;
  while (true) {
    let q = skip_ws(s, p);
    if (q >= s.len()) {
      break;
    }
    let op = s[q] as i32;
    if (op != 43 && op != 45) {
      break;
    }
    let rhs = parse_term(s, q + 1);
    if (!rhs.ok) {
      return rhs;
    }
    if (op == 43) {
      acc += rhs.val;
    } else {
      acc -= rhs.val;
    }
    p = rhs.pos;
  }
  return Eval { val: acc, pos: p, ok: true };
}

function format_result(v: f64): string {
  let t = v.trunc();
  if (t == v && v < 9e+15 && v > 0.0 - 9e+15) {
    return (v as i64).to_string();
  }
  return v.to_string();
}

function eval_line(line: string): boolean {
  let t: str = line.trim();
  if (t.is_empty()) {
    return true;
  }
  let e = parse_expr(t, 0);
  let end = skip_ws(t, e.pos);
  if (!e.ok || end != t.len()) {
    eprint("bc: invalid expression: " + line);
    return false;
  }
  print(format_result(e.val));
  return true;
}

function main(): i32 {
  let argv = args();
  let ok = true;

  if (argv.len() > 1) {
    let i = 1;
    while (i < argv.len()) {
      if (!eval_line(argv[i])) {
        ok = false;
      }
      i += 1;
    }
    if (ok) {
      return 0;
    }
    return 1;
  }

  let text = "";
  match (io.read_all_stdin()) {
    Ok(input) => {
      text = input;
    },
    Err(_) => {
      eprint("bc: cannot read UTF-8 stdin");
      return 1;
    }
  }
  let lines = text.lines();
  let j = 0;
  while (j < lines.len()) {
    if (!eval_line(lines[j])) {
      ok = false;
    }
    j += 1;
  }
  if (ok) {
    return 0;
  }
  return 1;
}
