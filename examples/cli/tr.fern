import "std/array";

function expand_set(s: string): u8[] {
  let n = s.len();
  let out: u8[] = [];
  let i = 0;
  while (i < n) {
    if (i + 2 < n && s[i + 1] == b'-' && s[i] <= s[i + 2]) {
      for c in s[i] as i32..=s[i + 2] as i32 {
        out = out.append(c as u8);
      }
      i += 3;
    } else {
      out = out.append(s[i]);
      i += 1;
    }
  }
  return out;
}

function transform(set1: u8[], set2: u8[], del: boolean, squeeze: boolean): i32 {
  let member = __alloc_u8(256);
  let mapped = __alloc_u8(256);
  for i in 0..256 {
    mapped = mapped.with(i, i as u8);
  }
  for i in 0..set1.len() {
    let b = set1[i] as i32;
    if (member[b] == 0) {
      member = member.with(b, 1u8);
      let k = if (i >= set2.len()) { set2.len() - 1 } else { i };
      if (set2.len() > 0) {
        mapped = mapped.with(b, set2[k]);
      }
    }
  }
  let reader = stdin();
  let writer = stdout();
  let out = buf_new(4096);
  let prev = -1;
  loop {
    match (reader.read_chunk_bytes(4096)) {
      Err(_) => {
        buf_free(out);
        eprint("tr: input read failed");
        return 1;
      },
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        for byte in chunk {
          let b = byte as i32;
          let in_set = member[b] != 0;
          if (del) {
            if (!in_set) {
              buf_push_byte(out, b);
            }
          } else if (squeeze) {
            if (!in_set || b != prev) {
              buf_push_byte(out, b);
            }
            prev = b;
          } else if (!in_set || set2.len() > 0) {
            buf_push_byte(out, mapped[b] as i32);
          }
        }
        let bytes = buf_take_bytes(out);
        if let Err(_) = writer.write_bytes(bytes) {
          buf_free(out);
          eprint("tr: output write failed");
          return 1;
        }
      }
    }
  }
  buf_free(out);
  return 0;
}

function main(): i32 {
  let argv = args();
  let del = false;
  let squeeze = false;
  let sets: string[] = [];

  for a in array.drop(argv, 1) {
    match (a) {
      "-d" => {
        del = true;
      },
      "-s" => {
        squeeze = true;
      },
      _ => {
        sets = sets.append(a);
      }
    }
  }

  if (sets.len() == 0) {
    eprint("usage: tr [-d|-s] SET1 [SET2]");
    return 2;
  }

  if (!del && !squeeze && sets.len() < 2) {
    eprint(f"tr: missing operand after '{sets[0]}'");
    return 2;
  }
  let set2: u8[] = if (sets.len() >= 2) { expand_set(sets[1]) } else { [] };
  return transform(expand_set(sets[0]), set2, del, squeeze);
}
