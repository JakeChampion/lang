// tr.fern — translate or delete bytes, like `tr(1)`.
//
//   tr SET1 SET2     map each byte in SET1 to the byte at the same
//                    position in SET2 (SET2's last byte repeats if
//                    SET1 is longer, like GNU tr)
//   tr -d SET1       delete every byte that appears in SET1
//   tr -s SET1       squeeze repeats of bytes in SET1 to one
//
//   $ printf 'hello\n' | ./tr a-z A-Z   ->  HELLO   (see note)
//   $ printf 'hello\n' | ./tr l L       ->  heLLo
//   $ printf 'heeello\n' | ./tr -s e    ->  hello
//   $ printf 'h3ll0\n' | ./tr -d 0-9    ->  hll
//
// Range expansion (`a-z`) is supported for SET arguments. Reads
// stdin only (the classic `tr` interface — it never takes file
// operands).
//
// Showcases: building a translation table over bytes, range
// expansion, the delete / squeeze variants.
import "std/string";
import "std/io";

// Expand `a-z` style ranges in a SET argument into the full byte
// sequence. A literal `-` at the start or end is kept as-is.
function expand_set(s: string): string {
  var n: i32 = s.len();
  var out: string = "";
  var i: i32 = 0;
  while (i < n) {
    if (i + 2 < n && s[i + 1] == 45 && s[i] <= s[i + 2]) {
      // range lo '-' hi
      var lo: i32 = s[i] as i32;
      var hi: i32 = s[i + 2] as i32;
      var c: i32 = lo;
      while (c <= hi) {
        out = out + (c as i32).to_ascii_string();
        c = c + 1;
      }
      i = i + 3;
    } else {
      out = out + s[i:i + 1];
      i = i + 1;
    }
  }
  return out;
}

function translate(text: string, set1: string, set2: string): string {
  var n: i32 = text.len();
  var out: string = "";
  var i: i32 = 0;
  while (i < n) {
    var b: i32 = text[i] as i32;
    var pos: i32 = set1.index_of((b as i32).to_ascii_string());
    if (pos >= 0) {
      // Map to the same position in set2; clamp to its last byte.
      var k: i32 = pos;
      if (k >= set2.len()) {
        k = set2.len() - 1;
      }
      if (set2.len() > 0) {
        out = out + set2[k:k + 1];
      }
    } else {
      out = out + text[i:i + 1];
    }
    i = i + 1;
  }
  return out;
}

function delete_set(text: string, set1: string): string {
  return text.without_chars(set1);
}

function squeeze_set(text: string, set1: string): string {
  var n: i32 = text.len();
  var out: string = "";
  var prev: i32 = 0 - 1;
  var i: i32 = 0;
  while (i < n) {
    var b: i32 = text[i] as i32;
    var in_set: boolean = set1.index_of((b as i32).to_ascii_string()) >= 0;
    if (in_set && b == prev) {
      i = i + 1;
      continue;
    }
    out = out + text[i:i + 1];
    prev = b;
    i = i + 1;
  }
  return out;
}

function main(): i32 {
  var argv: string[] = args();
  var del: boolean = false;
  var squeeze: boolean = false;
  var sets: string[] = [];

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "-d") {
      del = true;
    } else if (a == "-s") {
      squeeze = true;
    } else {
      sets = sets.append(expand_set(a));
    }
    i = i + 1;
  }

  if (sets.len() == 0) {
    eprint("usage: tr [-d|-s] SET1 [SET2]");
    return 2;
  }

  var text: string = io.read_all_stdin();
  var result: string = text;
  if (del) {
    result = delete_set(text, sets[0]);
  } else if (squeeze) {
    result = squeeze_set(text, sets[0]);
  } else if (sets.len() >= 2) {
    result = translate(text, sets[0], sets[1]);
  } else {
    eprint("tr: missing operand after '" + sets[0] + "'");
    return 2;
  }
  write(result);
  return 0;
}
