// tr.fern — translate or delete bytes, like `tr(1)`.
//
//   tr SET1 SET2     map each byte in SET1 to the byte at the same
//                    position in SET2 (SET2's last byte repeats if
//                    SET1 is longer, like GNU tr)
//   tr -d SET1       delete every byte that appears in SET1
//   tr -s SET1       squeeze repeats of bytes in SET1 to one
//
//   $ printf 'hello\n' | ./tr a-z A-Z   ->  HELLO   (see note)
//   $ printf 'hello\n' | ./tr l L       ->  heLLo
//   $ printf 'heeello\n' | ./tr -s e    ->  hello
//   $ printf 'h3ll0\n' | ./tr -d 0-9    ->  hll
//
// Range expansion (`a-z`) is supported for SET arguments. Reads
// stdin only (the classic `tr` interface — it never takes file
// operands).
//
// Showcases: building a translation table over bytes, range
// expansion, the delete / squeeze variants.

// Expand `a-z` style ranges in a SET argument into the full byte
// sequence. A literal `-` at the start or end is kept as-is.
function expand_set(s: string): u8[] {
  var n: i32 = s.len();
  var out: u8[] = [];
  var i: i32 = 0;
  while (i < n) {
    if (i + 2 < n && s[i + 1] == 45 && s[i] <= s[i + 2]) {
      // range lo '-' hi
      var lo: i32 = s[i] as i32;
      var hi: i32 = s[i + 2] as i32;
      var c: i32 = lo;
      while (c <= hi) {
        out = out.append(c as u8);
        c = c + 1;
      }
      i = i + 3;
    } else {
      out = out.append(s[i]);
      i = i + 1;
    }
  }
  return out;
}

// Build the byte lookup once, then stream raw chunks through a reusable buffer.
// The first occurrence in SET1 wins, matching the previous index_of lookup.
function transform(set1: u8[], set2: u8[], del: boolean, squeeze: boolean): i32 {
  var member: u8[] = __alloc_u8(256);
  var mapped: u8[] = __alloc_u8(256);
  var i: i32 = 0;
  while (i < 256) {
    mapped = mapped.with(i, i as u8);
    i = i + 1;
  }
  i = 0;
  while (i < set1.len()) {
    var b: i32 = set1[i] as i32;
    if (member[b] == 0) {
      member = member.with(b, 1 as u8);
      var k: i32 = i;
      if (k >= set2.len()) {
        k = set2.len() - 1;
      }
      if (set2.len() > 0) {
        mapped = mapped.with(b, set2[k]);
      }
    }
    i = i + 1;
  }
  var reader = stdin();
  var writer = stdout();
  var out: usize = buf_new(4096);
  var prev: i32 = 0 - 1;
  while (true) {
    match (reader.read_chunk_bytes(4096)) {
      Err(_) => {
        buf_free(out);
        eprint("tr: input read failed");
        return 1;
      },
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        i = 0;
        while (i < chunk.len()) {
          var b: i32 = chunk[i] as i32;
          var in_set: boolean = member[b] != 0;
          if (del) {
            if (!in_set) {
              buf_push_byte(out, b);
            }
          } else if (squeeze) {
            if (!in_set || b != prev) {
              buf_push_byte(out, b);
            }
            prev = b;
          } else if (!in_set || set2.len() > 0) {
            buf_push_byte(out, mapped[b] as i32);
          }
          i = i + 1;
        }
        var bytes = buf_take_bytes(out);
        match (writer.write_bytes(bytes)) {
          Some(_) => {
            buf_free(out);
            eprint("tr: output write failed");
            return 1;
          },
          None => {}
        }
      }
    }
  }
  buf_free(out);
  return 0;
}

function main(): i32 {
  var argv: string[] = args();
  var del: boolean = false;
  var squeeze: boolean = false;
  var sets: string[] = [];

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "-d") {
      del = true;
    } else if (a == "-s") {
      squeeze = true;
    } else {
      sets = sets.append(a);
    }
    i = i + 1;
  }

  if (sets.len() == 0) {
    eprint("usage: tr [-d|-s] SET1 [SET2]");
    return 2;
  }

  if (!del && !squeeze && sets.len() < 2) {
    eprint("tr: missing operand after '" + sets[0] + "'");
    return 2;
  }
  var set2: u8[] = [];
  if (sets.len() >= 2) {
    set2 = expand_set(sets[1]);
  }
  return transform(expand_set(sets[0]), set2, del, squeeze);
}
