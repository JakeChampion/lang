import "std/string";
import "std/i32";
import "std/io";

struct Opts { count: boolean, only_dups: boolean, only_unique: boolean, ignore_case: boolean }

function slurp(path: string): string {
  match (io.read_input(path)) {
    Ok(contents) => {
      return contents;
    },
    Err(_) => {
      return "";
    }
  }
}

function same(a: string, b: string, ci: boolean): boolean {
  if (ci) {
    return a.eq_ignore_ascii_case(b);
  }
  return a == b;
}

function main(): i32 {
  let argv: string[] = args();
  let o: Opts = Opts { count: false, only_dups: false, only_unique: false, ignore_case: false };
  let path: string = "-";

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-c") {
      o = Opts { ...o, count: true };
    } else if (a == "-d") {
      o = Opts { ...o, only_dups: true };
    } else if (a == "-u") {
      o = Opts { ...o, only_unique: true };
    } else if (a == "-i") {
      o = Opts { ...o, ignore_case: true };
    } else {
      path = a;
    }
    i = i + 1;
  }

  let lines: string[] = slurp(path).lines();
  let n: i32 = lines.len();
  let idx: i32 = 0;
  while (idx < n) {
    let rep: i32 = 1;
    while (idx + rep < n && same(lines[idx], lines[idx + rep], o.ignore_case)) {
      rep = rep + 1;
    }
    let show: boolean = true;
    if (o.only_dups && rep < 2) {
      show = false;
    }
    if (o.only_unique && rep > 1) {
      show = false;
    }
    if (show) {
      if (o.count) {
        print(rep.to_string().pad_start(7, ' ') + " " + lines[idx]);
      } else {
        print(lines[idx]);
      }
    }
    idx = idx + rep;
  }
  return 0;
}
