import "std/result";
import "std/string";
import "std/i32";
import "std/io";
import "std/array";

struct Opts { count: boolean, only_dups: boolean, only_unique: boolean, ignore_case: boolean }

function slurp(path: string): string {
  return io.read_input(path).unwrap_or("");
}

function same(a: string, b: string, ci: boolean): boolean {
  if (ci) {
    return a.eq_ignore_ascii_case(b);
  }
  return a == b;
}

function main(): i32 {
  let argv = args();
  let o = Opts { count: false, only_dups: false, only_unique: false, ignore_case: false };
  let path = "-";

  for a in array.drop(argv, 1) {
    match (a) {
      "-c" => {
        o = Opts { ...o, count: true };
      },
      "-d" => {
        o = Opts { ...o, only_dups: true };
      },
      "-u" => {
        o = Opts { ...o, only_unique: true };
      },
      "-i" => {
        o = Opts { ...o, ignore_case: true };
      },
      _ => {
        path = a;
      }
    }
  }

  let lines = slurp(path).lines();
  let n = lines.len();
  let idx = 0;
  while (idx < n) {
    let rep = 1;
    while (idx + rep < n && same(lines[idx], lines[idx + rep], o.ignore_case)) {
      rep += 1;
    }
    let show = !(o.only_dups && rep < 2) && !(o.only_unique && rep > 1);
    if (show) {
      if (o.count) {
        print(rep.to_string().pad_start(7, ' ') + " " + lines[idx]);
      } else {
        print(lines[idx]);
      }
    }
    idx += rep;
  }
  return 0;
}
