import "std/string";
import "std/i32";
import "std/io";
import "std/array";

struct Opts { ignore_case: boolean, invert: boolean, show_num: boolean, count_only: boolean }

function matches(line: string, pat: string, ci: boolean): boolean {
  if (ci) {
    return line.contains_ci(pat);
  }
  return line.contains(pat);
}

function main(): i32 {
  let argv = args();
  let o = Opts { ignore_case: false, invert: false, show_num: false, count_only: false };
  let pat = "";
  let have_pat = false;
  let inputs: string[] = [];

  for a in array.drop(argv, 1) {
    if (a.starts_with("-") && a.len() > 1 && !have_pat) {
      for f in 1..a.len() {
        match (a[f]) {
          b'i' => {
            o = Opts { ...o, ignore_case: true };
          },
          b'v' => {
            o = Opts { ...o, invert: true };
          },
          b'n' => {
            o = Opts { ...o, show_num: true };
          },
          b'c' => {
            o = Opts { ...o, count_only: true };
          },
          _ => {
            eprint(f"grep: invalid option -- '{slice_unchecked(a, f, f + 1)}'");
            return 2;
          }
        }
      }
    } else if (!have_pat) {
      pat = a;
      have_pat = true;
    } else {
      inputs = inputs.append(a);
    }
  }

  if (!have_pat) {
    eprint("usage: grep [-ivnc] PATTERN [FILE...]");
    return 2;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let multi = inputs.len() > 1;
  let any_match = false;
  let status = 1;

  for name in inputs {
    match (io.read_input(name)) {
      Ok(text) => {
        let lines = text.lines();
        let hits = 0;
        for ln in 0..lines.len() {
          let found = matches(lines[ln], pat, o.ignore_case);
          let hit = if (o.invert) { !found } else { found };
          if (hit) {
            hits += 1;
            any_match = true;
            if (!o.count_only) {
              let prefix = if (multi) { name + ":" } else { "" };
              if (o.show_num) {
                prefix += f"{ln + 1}:";
              }
              print(prefix + lines[ln]);
            }
          }
        }
        if (o.count_only) {
          if (multi) {
            print(f"{name}:{hits}");
          } else {
            print(hits.to_string());
          }
        }
      },
      Err(_) => {
        eprint(f"grep: {name}: No such file or directory");
        status = 2;
      }
    }
  }
  if (any_match) {
    return 0;
  }
  return status;
}
