import "std/string";
import "std/i32";
import "std/io";

struct Opts { ignore_case: boolean, invert: boolean, show_num: boolean, count_only: boolean }

function matches(line: string, pat: string, ci: boolean): boolean {
  if (ci) {
    return line.contains_ci(pat);
  }
  return line.contains(pat);
}

function main(): i32 {
  let argv = args();
  let o = Opts { ignore_case: false, invert: false, show_num: false, count_only: false };
  let pat = "";
  let have_pat = false;
  let inputs: string[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a.starts_with("-") && a.len() > 1 && !have_pat) {
      let f = 1;
      while (f < a.len()) {
        let c = a[f] as i32;
        if (c == 105) {
          o = Opts { ...o, ignore_case: true };
        } else if (c == 118) {
          o = Opts { ...o, invert: true };
        } else if (c == 110) {
          o = Opts { ...o, show_num: true };
        } else if (c == 99) {
          o = Opts { ...o, count_only: true };
        } else {
          eprint("grep: invalid option -- '" + slice_unchecked(a, f, f + 1) + "'");
          return 2;
        }
        f += 1;
      }
    } else if (!have_pat) {
      pat = a;
      have_pat = true;
    } else {
      inputs = inputs.append(a);
    }
    i += 1;
  }

  if (!have_pat) {
    eprint("usage: grep [-ivnc] PATTERN [FILE...]");
    return 2;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let multi = inputs.len() > 1;
  let any_match = false;
  let status = 1;

  let j = 0;
  while (j < inputs.len()) {
    let name = inputs[j];
    match (io.read_input(name)) {
      Ok(text) => {
        let lines = text.lines();
        let hits = 0;
        let ln = 0;
        while (ln < lines.len()) {
          let hit = matches(lines[ln], pat, o.ignore_case);
          if (o.invert) {
            hit = !hit;
          }
          if (hit) {
            hits += 1;
            any_match = true;
            if (!o.count_only) {
              let prefix = "";
              if (multi) {
                prefix = name + ":";
              }
              if (o.show_num) {
                prefix = prefix + (ln + 1).to_string() + ":";
              }
              print(prefix + lines[ln]);
            }
          }
          ln += 1;
        }
        if (o.count_only) {
          if (multi) {
            print(name + ":" + hits.to_string());
          } else {
            print(hits.to_string());
          }
        }
      },
      Err(_) => {
        eprint("grep: " + name + ": No such file or directory");
        status = 2;
      }
    }
    j += 1;
  }
  if (any_match) {
    return 0;
  }
  return status;
}
