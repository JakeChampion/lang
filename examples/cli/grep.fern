// grep.fern — print lines matching a fixed pattern, like `grep(1)`
// (specifically `grep -F`, fixed-string substring matching — no
// regular expressions).
//
//   -i   case-insensitive match
//   -v   invert: print lines that do NOT match
//   -n   prefix each match with its 1-based line number
//   -c   print only a count of matching lines per file
//   -w   print the matching files' names with a colon prefix when
//        more than one file is given (auto-enabled for multi-file)
//
//   $ ./grep error log.txt
//   $ printf 'a\nbAb\nc\n' | ./grep -i b
//   $ ./grep -vn foo file.txt
//
// Showcases: substring search (`contains` / `contains_ci`), invert
// + count modes, multi-file output prefixes.
import "std/string";
import "std/i32";
import "std/io";

struct Opts { ignore_case: boolean, invert: boolean, show_num: boolean, count_only: boolean }

function matches(line: string, pat: string, ci: boolean): boolean {
  if (ci) {
    return line.contains_ci(pat);
  }
  return line.contains(pat);
}

function main(): i32 {
  var argv: string[] = args();
  var o: Opts = Opts { ignore_case: false, invert: false, show_num: false, count_only: false };
  var pat: string = "";
  var have_pat: boolean = false;
  var inputs: string[] = [];

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a.starts_with("-") && a.len() > 1 && !have_pat) {
      // Bundle of single-char flags, e.g. `-iv`.
      var f: i32 = 1;
      while (f < a.len()) {
        var c: i32 = a[f] as i32;
        if (c == 105) {
          o = Opts { ...o, ignore_case: true };  // i
        } else if (c == 118) {
          o = Opts { ...o, invert: true };  // v
        } else if (c == 110) {
          o = Opts { ...o, show_num: true };  // n
        } else if (c == 99) {
          o = Opts { ...o, count_only: true };  // c
        } else {
          eprint("grep: invalid option -- '" + a[f:f + 1] + "'");
          return 2;
        }
        f = f + 1;
      }
    } else if (!have_pat) {
      pat = a;
      have_pat = true;
    } else {
      inputs = inputs.append(a);
    }
    i = i + 1;
  }

  if (!have_pat) {
    eprint("usage: grep [-ivnc] PATTERN [FILE...]");
    return 2;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  var multi: boolean = inputs.len() > 1;
  var any_match: boolean = false;
  var status: i32 = 1;  // grep exits 1 when nothing matches

  var j: i32 = 0;
  while (j < inputs.len()) {
    var name: string = inputs[j];
    match (io.read_input(name)) {
      Ok(text) => {
        var lines: string[] = text.lines();
        var hits: i32 = 0;
        var ln: i32 = 0;
        while (ln < lines.len()) {
          var hit: boolean = matches(lines[ln], pat, o.ignore_case);
          if (o.invert) {
            hit = !hit;
          }
          if (hit) {
            hits = hits + 1;
            any_match = true;
            if (!o.count_only) {
              var prefix: string = "";
              if (multi) {
                prefix = name + ":";
              }
              if (o.show_num) {
                prefix = prefix + (ln + 1).to_string() + ":";
              }
              print(prefix + lines[ln]);
            }
          }
          ln = ln + 1;
        }
        if (o.count_only) {
          if (multi) {
            print(name + ":" + hits.to_string());
          } else {
            print(hits.to_string());
          }
        }
      },
      Err(_) => {
        eprint("grep: " + name + ": No such file or directory");
        status = 2;
      }
    }
    j = j + 1;
  }
  if (any_match) {
    return 0;
  }
  return status;
}
