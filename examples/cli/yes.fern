import "std/string";
import "std/i32";
import "std/array";

function main(): i32 {
  let argv = args();
  let limit: i32 = -1;
  let words: string[] = [];

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-n" && i + 1 < argv.len()) {
      match (i32.parse_i32(argv[i + 1])) {
        Ok(n) => {
          limit = n;
        },
        Err(_) => {}
      }
      i += 1;
    } else {
      words = words.append(a);
    }
    i += 1;
  }

  let line = "y";
  if (words.len() > 0) {
    line = words.join(" ");
  }

  let count = 0;
  while (limit < 0 || count < limit) {
    print(line);
    count += 1;
  }
  return 0;
}
