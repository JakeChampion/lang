// yes.fern — repeatedly print a line, like `yes(1)`.
//
// With no operands it prints "y" forever; with operands it prints
// them joined by spaces, forever. As an example program (CI only
// *builds* these, never runs them unbounded) it also honours an
// optional `-n COUNT` cap so you can demo it without a pipe to kill:
//
//   $ ./yes | head -3        # y / y / y
//   $ ./yes hello there      # hello there  (until the pipe closes)
//   $ ./yes -n 3 ok          # ok / ok / ok, then exits
//
// Showcases: joining argv into a payload, an unbounded emit loop,
// and an opt-in bound for safe demonstration.
import "std/string";
import "std/i32";
import "std/array";

function main(): i32 {
  var argv: string[] = args();
  var limit: i32 = 0 - 1;  // -1 means "no limit"
  var words: string[] = [];

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "-n" && i + 1 < argv.len()) {
      match (argv[i + 1].parse_int()) {
        Some(n) => {
          limit = n;
        },
        None => {}
      }
      i = i + 1;
    } else {
      words = words.append(a);
    }
    i = i + 1;
  }

  var line: string = "y";
  if (words.len() > 0) {
    line = words.join(" ");
  }

  var count: i32 = 0;
  while (limit < 0 || count < limit) {
    print(line);
    count = count + 1;
  }
  return 0;
}
