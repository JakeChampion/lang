import "std/string";
import "std/i32";
import "std/array";

function main(): i32 {
  let argv: string[] = args();
  let limit: i32 = 0 - 1;
  let words: string[] = [];

  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "-n" && i + 1 < argv.len()) {
      match (argv[i + 1].parse_int()) {
        Some(n) => {
          limit = n;
        },
        None => {}
      }
      i = i + 1;
    } else {
      words = words.append(a);
    }
    i = i + 1;
  }

  let line: string = "y";
  if (words.len() > 0) {
    line = words.join(" ");
  }

  let count: i32 = 0;
  while (limit < 0 || count < limit) {
    print(line);
    count = count + 1;
  }
  return 0;
}
