// head.fern — print the leading part of each input, like `head(1)`.
//
//   -n N   print the first N lines (default 10)
//   -c N   print the first N bytes (overrides -n)
//
// Both `-n N` (two args) and `-nN` (glued) are accepted, as is the
// bare `-N` shorthand GNU head allows. When more than one file is
// given, each is preceded by a `==> name <==` banner, just like the
// real tool.
//
//   $ ./head -n 3 file.txt
//   $ ./head -c 20 file.txt
//   $ seq 100 | ./head -5
//
// Showcases: numeric flag parsing (split / glued / shorthand),
// byte- vs line-oriented slicing, multi-file banners.
import "std/string";
import "std/i32";
import "std/io";

struct Opts { count: i32, by_bytes: boolean }

function emit(text: string, o: Opts): void {
  if (o.by_bytes) {
    write(text.take(o.count));
    return;
  }
  var lines: string[] = text.lines();
  var n: i32 = o.count;
  if (n > lines.len()) {
    n = lines.len();
  }
  var i: i32 = 0;
  while (i < n) {
    print(lines[i]);
    i = i + 1;
  }
}

function main(): i32 {
  var argv: string[] = args();
  var o: Opts = Opts { count: 10, by_bytes: false };
  var inputs: string[] = [];
  var status: i32 = 0;

  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "-n" && i + 1 < argv.len()) {
      o = Opts { ...o, count: argv[i + 1].parse_int_or(10), by_bytes: false };
      i = i + 1;
    } else if (a == "-c" && i + 1 < argv.len()) {
      o = Opts { ...o, count: argv[i + 1].parse_int_or(10), by_bytes: true };
      i = i + 1;
    } else if (a.starts_with("-n")) {
      o = Opts { ...o, count: a.drop(2).parse_int_or(10), by_bytes: false };
    } else if (a.starts_with("-c")) {
      o = Opts { ...o, count: a.drop(2).parse_int_or(10), by_bytes: true };
    } else if (a.len() > 1 && a[0] == 45 && (a[1] as i32).is_ascii_digit()) {
      // `-5` shorthand for `-n 5`.
      o = Opts { ...o, count: a.drop(1).parse_int_or(10), by_bytes: false };
    } else {
      inputs = inputs.append(a);
    }
    i = i + 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  var multi: boolean = inputs.len() > 1;
  var j: i32 = 0;
  while (j < inputs.len()) {
    match (io.read_input(inputs[j])) {
      Ok(text) => {
        if (multi) {
          if (j > 0) {
            print("");
          }
          print("==> " + inputs[j] + " <==");
        }
        emit(text, o);
      },
      Err(_) => {
        eprint("head: cannot open '" + inputs[j] + "' for reading");
        status = 1;
      }
    }
    j = j + 1;
  }
  return status;
}
