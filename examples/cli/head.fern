// head.fern — print the leading part of each input, like `head(1)`.
//
//   -n N   print the first N lines (default 10)
//   -c N   print the first N bytes (overrides -n)
//
// Both `-n N` (two args) and `-nN` (glued) are accepted, as is the
// bare `-N` shorthand GNU head allows. When more than one file is
// given, each is preceded by a `==> name <==` banner, just like the
// real tool.
//
//   $ ./head -n 3 file.txt
//   $ ./head -c 20 file.txt
//   $ seq 100 | ./head -5
//
// Showcases: numeric flag parsing (split / glued / shorthand),
// byte- vs line-oriented slicing, multi-file banners.
import "std/result";
import "std/string";
import "std/i32";
import "std/io";

struct Opts { count: i32, by_bytes: boolean }

function emit(text: string, o: Opts): void {
  if (o.by_bytes) {
    write(text.take(o.count));
    return;
  }
  let lines = text.lines();
  for i in 0..o.count.min(lines.len()) {
    print(lines[i]);
  }
}

function main(): i32 {
  let argv = args();
  let o = Opts { count: 10, by_bytes: false };
  let inputs: string[] = [];
  let status = 0;

  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "-n" && i + 1 < argv.len()) {
      o = Opts { ...o, count: i32.parse_i32(argv[i + 1]).unwrap_or(10), by_bytes: false };
      i += 1;
    } else if (a == "-c" && i + 1 < argv.len()) {
      o = Opts { ...o, count: i32.parse_i32(argv[i + 1]).unwrap_or(10), by_bytes: true };
      i += 1;
    } else if (a.starts_with("-n")) {
      o = Opts { ...o, count: i32.parse_i32(a.drop(2)).unwrap_or(10), by_bytes: false };
    } else if (a.starts_with("-c")) {
      o = Opts { ...o, count: i32.parse_i32(a.drop(2)).unwrap_or(10), by_bytes: true };
    } else if (a.len() > 1 && a[0] == b'-' && a[1].is_ascii_digit()) {
      // `-5` shorthand for `-n 5`.
      o = Opts { ...o, count: i32.parse_i32(a.drop(1)).unwrap_or(10), by_bytes: false };
    } else {
      inputs = inputs.append(a);
    }
    i += 1;
  }
  if (inputs.len() == 0) {
    inputs = inputs.append("-");
  }

  let multi = inputs.len() > 1;
  for j in 0..inputs.len() {
    let input = inputs[j];
    match (io.read_input(input)) {
      Ok(text) => {
        if (multi) {
          if (j > 0) {
            print("");
          }
          print(f"==> {input} <==");
        }
        emit(text, o);
      },
      Err(_) => {
        eprint(f"head: cannot open '{input}' for reading");
        status = 1;
      }
    }
  }
  return status;
}
