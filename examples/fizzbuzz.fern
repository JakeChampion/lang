function divisible(n: i32, by: i32): boolean {
  return n % by == 0;
}

function main(): i32 {
  for i in 1..=15 {
    if (divisible(i, 15)) {
      putchar(b'F');
      putchar(b'B');
    } else if (divisible(i, 3)) {
      putchar(b'F');
    } else if (divisible(i, 5)) {
      putchar(b'B');
    } else {
      putchar(b'.');
    }
    putchar(b'\n');
  }
  return 0;
}
