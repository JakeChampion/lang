function divisible(n: i32, by: i32): boolean {
  return n - n / by * by == 0;
}

function main(): i32 {
  let i: i32 = 1;
  while (i <= 15) {
    if (divisible(i, 15)) {
      putchar(70);
      putchar(66);
    } else if (divisible(i, 3)) {
      putchar(70);
    } else if (divisible(i, 5)) {
      putchar(66);
    } else {
      putchar(46);
    }
    putchar(10);
    i = i + 1;
  }
  return 0;
}
