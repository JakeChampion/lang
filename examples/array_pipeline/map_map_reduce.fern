// examples/array_pipeline/map_map_reduce.fern — pipeline 1 of #9728.
//
// `xs.map(f).map(g).reduce(h)` against the hand-written `while` loop that
// computes the same answer. Same cardinality at every stage and no control
// flow, so this is producer/consumer fusion in its simplest form: whatever a
// fusion pass would have to do here, it would have to do everywhere.
//
// Three variants, because "the pipeline allocates and the loop does not" does
// not say which half of the pipeline costs what:
//
//   pipeline      xs.map(f).map(g).reduce(h)
//   closure_loop  one loop, no intermediate arrays, but `f`/`g`/`h` still
//                 reached through function values, one indirect call each
//                 per element
//   call_loop     one loop that CALLS the same element functions, so the
//                 comparison isolates fusion from inlining
//   loop          one loop with the arithmetic written inline
//
// pipeline - closure_loop is what the intermediate arrays cost; closure_loop -
// loop is what the per-element indirect call costs. Reporting only the first
// and last would leave the two summed and unattributable.
//
// All three print the same checksum. That agreement is the differential test:
// a variant that fused away work it should have done cannot report a win for
// computing something else.
import "std/i32";
import "std/result";
import "core/cmp";
import "std/bench";
import "std/string";

function modulus(): i64 {
  return 1000003 as i64;
}

function elem_f(x: i64): i64 {
  return (x * (3 as i64) + 1 as i64) % modulus();
}

function elem_g(x: i64): i64 {
  return (x * (5 as i64) + 7 as i64) % modulus();
}

function combine(a: i64, b: i64): i64 {
  return (a + b) % modulus();
}

function build_input(n: i32): i64[] {
  let xs: i64[] = [];
  let i: i32 = 0;
  while (i < n) {
    xs = xs.append(i as i64 * (2654435761 as i64) % modulus());
    i = i + 1;
  }
  return xs;
}

function run_pipeline(xs: i64[]): i64 {
  let out: Option[i64] = xs.map((x: i64): i64 => elem_f(x)).map((x: i64): i64 => elem_g(x)).reduce((a: i64, b: i64): i64 => combine(a, b));
  match (out) {
    Some(v) => {
      return v;
    },
    None => {
      return 0 as i64;
    }
  }
}

function pick_f(sel: i32): (i64) => i64 {
  if (sel == 1) {
    return (x: i64): i64 => elem_f(x + 0 as i64);
  }
  return (x: i64): i64 => elem_f(x);
}

function pick_g(sel: i32): (i64) => i64 {
  if (sel == 1) {
    return (x: i64): i64 => elem_g(x + 0 as i64);
  }
  return (x: i64): i64 => elem_g(x);
}

function pick_h(sel: i32): (i64, i64) => i64 {
  if (sel == 1) {
    return (a: i64, b: i64): i64 => combine(a + 0 as i64, b);
  }
  return (a: i64, b: i64): i64 => combine(a, b);
}

function run_closure_loop(sel: i32, xs: i64[]): i64 {
  let f: (i64) => i64 = pick_f(sel);
  let g: (i64) => i64 = pick_g(sel);
  let h: (i64, i64) => i64 = pick_h(sel);
  if (xs.len() == 0) {
    return 0 as i64;
  }
  let acc: i64 = g(f(xs[0]));
  let i: i32 = 1;
  while (i < xs.len()) {
    acc = h(acc, g(f(xs[i])));
    i = i + 1;
  }
  return acc;
}

function run_loop(xs: i64[]): i64 {
  if (xs.len() == 0) {
    return 0 as i64;
  }
  let m: i64 = modulus();
  let acc: i64 = ((xs[0] * (3 as i64) + 1 as i64) % m * (5 as i64) + 7 as i64) % m;
  let i: i32 = 1;
  while (i < xs.len()) {
    let v: i64 = ((xs[i] * (3 as i64) + 1 as i64) % m * (5 as i64) + 7 as i64) % m;
    acc = (acc + v) % m;
    i = i + 1;
  }
  return acc;
}

function run_call_loop(xs: i64[]): i64 {
  if (xs.len() == 0) {
    return 0 as i64;
  }
  let acc: i64 = elem_g(elem_f(xs[0]));
  let i: i32 = 1;
  while (i < xs.len()) {
    acc = combine(acc, elem_g(elem_f(xs[i])));
    i = i + 1;
  }
  return acc;
}

function dispatch(variant: i32, sel: i32, xs: i64[]): i64 {
  if (variant == 0) {
    return run_pipeline(xs);
  }
  if (variant == 1) {
    return run_closure_loop(sel, xs);
  }
  if (variant == 2) {
    return run_loop(xs);
  }
  return run_call_loop(xs);
}

function main(): i32 {
  let argv: string[] = args();
  let name: string = "pipeline";
  if (argv.len() > 1) {
    name = argv[1];
  }
  let variant: i32 = 0;
  if (name == "closure_loop") {
    variant = 1;
  }
  if (name == "loop") {
    variant = 2;
  }
  if (name == "call_loop") {
    variant = 3;
  }

  let n: i32 = 4096;
  if (argv.len() > 2) {
    n = i32.parse_i32(argv[2]).unwrap_or(4096);
  }
  let rounds: i32 = 200;
  if (argv.len() > 3) {
    rounds = i32.parse_i32(argv[3]).unwrap_or(200);
  }

  let sel: i32 = 0;
  if (argv.len() > 4) {
    sel = 1;
  }

  let xs: i64[] = build_input(n);

  let samples: i64[] = [];
  let p: i32 = 0;
  while (p < rounds) {
    samples = samples.append(0 as i64);
    p = p + 1;
  }

  let cold_a0: i64 = bench.alloc_count();
  let cold_b0: i64 = bench.bump_bytes();
  let checksum: i64 = dispatch(variant, sel, xs);
  let cold_allocs: i64 = bench.allocs_after(cold_a0);
  let cold_fresh: i64 = bench.fresh_bytes_after(cold_b0);

  let at_allocs: i64 = bench.alloc_count();
  let at_fresh: i64 = bench.bump_bytes();
  let started_ns: i64 = monotonic_ns();
  let r: i32 = 0;
  while (r < rounds) {
    let t0: i64 = monotonic_ns();
    checksum = (checksum * (31 as i64) + dispatch(variant, sel, xs)) % modulus();
    samples = samples.with(r, monotonic_ns() - t0);
    r = r + 1;
  }
  let elapsed_ns: i64 = monotonic_ns() - started_ns;
  let allocs: i64 = bench.allocs_after(at_allocs);
  let fresh: i64 = bench.fresh_bytes_after(at_fresh);

  let rep: bench.Report = bench.Report { name: name, iterations: rounds, wall_ns: elapsed_ns, samples_ns: cmp.sort(samples), allocs: allocs, fresh_bytes: fresh };
  let elements: i64 = rounds as i64 * (n as i64);
  print("{\"program\":\"map_map_reduce\"" + ",\"variant\":\"" + name + "\"" + ",\"n\":" + n.to_string() + ",\"rounds\":" + rounds.to_string() + ",\"checksum\":" + checksum.to_string() + ",\"cold_allocs\":" + cold_allocs.to_string() + ",\"cold_fresh_bytes\":" + cold_fresh.to_string() + ",\"steady_allocs\":" + allocs.to_string() + ",\"steady_fresh_bytes\":" + fresh.to_string() + ",\"allocs_per_round_milli\":" + (allocs * (1000 as i64) / (rounds as i64)).to_string() + ",\"fresh_bytes_per_round\":" + (fresh / (rounds as i64)).to_string() + ",\"fresh_bytes_per_element_milli\":" + (fresh * (1000 as i64) / elements).to_string() + ",\"ns_per_round\":" + (elapsed_ns / (rounds as i64)).to_string() + ",\"ns_per_element_milli\":" + (elapsed_ns * (1000 as i64) / elements).to_string() + ",\"round_p50_ns\":" + rep.p50_ns().to_string() + ",\"round_p99_ns\":" + rep.p99_ns().to_string() + "}");
  return 0;
}
