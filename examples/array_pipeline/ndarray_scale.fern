// Compile the same source with and without FERN_NO_SCALE_KERNEL=1.
// Input size and round count are runtime parameters. Both builds must print
// the same checksum. Counters include the handle's metadata, not just data.
import "std/i32";
import "std/result";
import "std/ndarray";
import "std/string";

@noinline
function scale(xs: f64[]): ndarray.NdArray[f64] {
  return ndarray.from_flat(xs, [xs.len()]).map((x: f64): f64 => x * 2.0);
}

function checksum(a: ndarray.NdArray[f64]): i64 {
  let result = 0i64;
  for x in a.to_flat() {
    result += x as i64;
  }
  return result;
}

function main(): i32 {
  let argv = args();
  let n = if (argv.len() > 1) { i32.parse_i32(argv[1]).unwrap_or(1000) } else { 1000 };
  let rounds = if (argv.len() > 2) { i32.parse_i32(argv[2]).unwrap_or(2) } else { 2 };
  if (n < 1 || rounds < 1) {
    return 1;
  }
  let xs: f64[] = [];
  for i in 0..n {
    xs = xs.append((i % 127) as f64);
  }

  let cold_a = __heap_alloc_count();
  let cold_b = __heap_bump_bytes();
  let first = scale(xs);
  let cold_allocs = __heap_alloc_count() - cold_a;
  let cold_bytes = __heap_bump_bytes() - cold_b;
  let expected = checksum(first);

  let mark_a = __heap_alloc_count();
  let mark_b = __heap_bump_bytes();
  let elapsed = 0i64;
  let sum = 0i64;
  for _ in 0..rounds {
    let start = monotonic_ns();
    let out = scale(xs);
    elapsed += monotonic_ns() - start;
    let got = checksum(out);
    if (got != expected) {
      return 2;
    }
    sum += got;
  }
  let allocs = __heap_alloc_count() - mark_a;
  let bytes = __heap_bump_bytes() - mark_b;
  if (checksum(first) != expected || xs[0] != 0.0) {
    return 3;
  }
  print("{\"n\":" + n.to_string() + ",\"rounds\":" + rounds.to_string() + ",\"checksum\":" + sum.to_string() + ",\"cold_allocs\":" + cold_allocs.to_string() + ",\"cold_bytes\":" + cold_bytes.to_string() + ",\"steady_allocs\":" + allocs.to_string() + ",\"steady_bytes\":" + bytes.to_string() + ",\"ns_per_round\":" + (elapsed / (rounds as i64)).to_string() + "}");
  return 0;
}
