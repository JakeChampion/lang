// Run n rounds shared, with shared either 0 (unique) or 1 (a live alias).
// Measure only the scale call. Verify every result and live alias outside
// that timer. Both allocation counters include the handle's metadata.
import "std/i32";
import "std/result";
import "std/ndarray";
import "std/string";

@noinline
function scale(own a: ndarray.NdArray[f64]): ndarray.NdArray[f64] {
  return a.map((x: f64): f64 => x * 2.0);
}

function build(n: i32): ndarray.NdArray[f64] {
  let xs: f64[] = [];
  for i in 0..n {
    xs = xs.append((i % 127 + 1) as f64);
  }
  return ndarray.from_flat(xs, [n]);
}

function correct(a: ndarray.NdArray[f64], n: i32, factor: f64): boolean {
  if (a.len() != n || a.shape()[0] != n || !a.is_packed()) {
    return false;
  }
  let xs = a.to_flat();
  for i in 0..n {
    let expected = (i % 127 + 1) as f64 * factor;
    if (xs[i] != expected) {
      return false;
    }
  }
  return true;
}

function main(): i32 {
  let argv = args();
  let n = if (argv.len() > 1) { i32.parse_i32(argv[1]).unwrap_or(1000) } else { 1000 };
  let rounds = if (argv.len() > 2) { i32.parse_i32(argv[2]).unwrap_or(2) } else { 2 };
  let shared = argv.len() > 3 && argv[3] == "1";
  if (n < 1 || rounds < 1 || rounds > 1000) {
    return 1;
  }
  let current = build(n);
  let mark_calls = __heap_alloc_count();
  let mark_bytes = __heap_bump_bytes();
  let elapsed = 0i64;
  let factor = 1.0;
  for _ in 0..rounds {
    if (shared) {
      let alias = current;
      let start = monotonic_ns();
      current = scale(current);
      elapsed += monotonic_ns() - start;
      if (!correct(alias, n, factor)) {
        return 2;
      }
    } else {
      let start = monotonic_ns();
      current = scale(current);
      elapsed += monotonic_ns() - start;
    }
    factor *= 2.0;
    if (!correct(current, n, factor)) {
      return 3;
    }
  }
  let calls = __heap_alloc_count() - mark_calls;
  let bytes = __heap_bump_bytes() - mark_bytes;
  let mode = if (shared) { "shared" } else { "unique" };
  print("{\"n\":" + n.to_string() + ",\"rounds\":" + rounds.to_string() + ",\"mode\":\"" + mode + "\",\"alloc_calls\":" + calls.to_string() + ",\"fresh_bytes\":" + bytes.to_string() + ",\"ns_per_map\":" + (elapsed / (rounds as i64)).to_string() + "}");
  return 0;
}
