// examples/array_pipeline/own_map_inplace.fern — pipeline 3 of #9728.
//
// Not a fusion question. The result of a same-shape `map` has to exist, so
// what is being asked is whether it can BE the input's buffer: an `own` array
// in, a same-shape transform, an array of the same length back out. Pipelines
// 1 and 2 ask whether an intermediate can disappear; this one asks whether the
// donor can be taken over.
//
// Three variants, threaded the same way — `xs = transform(xs)` each round, so
// the argument dies at the call and reaches the callee unique:
//
//   map_own        `own xs` handed straight to `xs.map(f)`
//   with_own       the hand-written same-shape loop, `xs = xs.with(i, f(xs[i]))`
//   with_borrowed  the same loop over a BORROWED parameter, which is what
//                  `.with` costs when the receiver is not uniquely owned
//
// The answer is yes: #9733 rewrites `map_own` to write through the donor's
// buffer, and it reaches with_own's zero.
//
// with_borrowed is the control. Without it "with_own allocates nothing" is
// satisfiable by a `.with` that never copies for anyone, and the reuse would
// not have been demonstrated to depend on ownership at all.
//
// `with_own` is annotated `fip`, so the E068 pass is asserting the space claim
// at compile time rather than the measurement asserting it after the fact.
// internal/testing/e2e/array_inplace_fip_test.go is `map_own` annotated `fip`.
import "std/i32";
import "std/result";
import "core/cmp";
import "std/bench";
import "std/string";

fip function modulus(): i64 {
  return 1000003 as i64;
}

fip function elem_f(x: i64): i64 {
  return (x * (3 as i64) + 1 as i64) % modulus();
}

function build_input(n: i32): i64[] {
  let xs: i64[] = [];
  for i in 0..n {
    xs = xs.append(i as i64 * 2654435761 % modulus());
  }
  return xs;
}

function via_map_own(own xs: i64[]): i64[] {
  return xs.map((x: i64): i64 => elem_f(x));
}

fip function via_with_own(own xs: i64[], n: i32): i64[] {
  let i = 0;
  while (i < n) {
    xs = xs.with(i, elem_f(xs[i]));
    i += 1;
  }
  return xs;
}

@noinline
function via_with_borrowed(xs: i64[], n: i32): i64[] {
  let out = xs;
  let i = 0;
  while (i < n) {
    out = out.with(i, elem_f(out[i]));
    i += 1;
  }
  return out;
}

function apply(variant: i32, own xs: i64[], n: i32): i64[] {
  if (variant == 0) {
    return via_map_own(xs);
  }
  if (variant == 1) {
    return via_with_own(xs, n);
  }
  let out = via_with_borrowed(xs, n);
  if (out.len() != xs.len()) {
    return xs;
  }
  return out;
}

function digest(xs: i64[]): i64 {
  let d: i64 = 0;
  for x in xs {
    d = (d * 31 + x) % modulus();
  }
  return d;
}

function main(): i32 {
  let argv = args();
  let name = if (argv.len() > 1) { argv[1] } else { "map_own" };
  let variant = match (name) { "with_own" => 1, "with_borrowed" => 2, _ => 0 };

  let n = if (argv.len() > 2) { i32.parse_i32(argv[2]).unwrap_or(4096) } else { 4096 };
  let rounds = if (argv.len() > 3) { i32.parse_i32(argv[3]).unwrap_or(200) } else { 200 };

  let xs = build_input(n);

  let samples: i64[] = [];
  for _ in 0..rounds {
    samples = samples.append(0);
  }

  let cold_a0 = bench.alloc_count();
  let cold_b0 = bench.bump_bytes();
  xs = apply(variant, xs, n);
  let cold_allocs = bench.allocs_after(cold_a0);
  let cold_fresh = bench.fresh_bytes_after(cold_b0);

  let at_allocs = bench.alloc_count();
  let at_fresh = bench.bump_bytes();
  let started_ns = monotonic_ns();
  for r in 0..rounds {
    let t0 = monotonic_ns();
    xs = apply(variant, xs, n);
    samples = samples.with(r, monotonic_ns() - t0);
  }
  let elapsed_ns = monotonic_ns() - started_ns;
  let allocs = bench.allocs_after(at_allocs);
  let fresh = bench.fresh_bytes_after(at_fresh);
  let checksum = digest(xs);

  let rep = bench.Report { name: name, iterations: rounds, wall_ns: elapsed_ns, samples_ns: cmp.sort(samples), allocs: allocs, fresh_bytes: fresh };
  let elements = rounds as i64 * (n as i64);
  print("{\"program\":\"own_map_inplace\"" + ",\"variant\":\"" + name + "\"" + ",\"n\":" + n.to_string() + ",\"rounds\":" + rounds.to_string() + ",\"checksum\":" + checksum.to_string() + ",\"cold_allocs\":" + cold_allocs.to_string() + ",\"cold_fresh_bytes\":" + cold_fresh.to_string() + ",\"steady_allocs\":" + allocs.to_string() + ",\"steady_fresh_bytes\":" + fresh.to_string() + ",\"allocs_per_round_milli\":" + (allocs * (1000 as i64) / (rounds as i64)).to_string() + ",\"fresh_bytes_per_round\":" + (fresh / (rounds as i64)).to_string() + ",\"fresh_bytes_per_element_milli\":" + (fresh * (1000 as i64) / elements).to_string() + ",\"ns_per_round\":" + (elapsed_ns / (rounds as i64)).to_string() + ",\"ns_per_element_milli\":" + (elapsed_ns * (1000 as i64) / elements).to_string() + ",\"round_p50_ns\":" + rep.p50_ns().to_string() + ",\"round_p99_ns\":" + rep.p99_ns().to_string() + "}");
  return 0;
}
