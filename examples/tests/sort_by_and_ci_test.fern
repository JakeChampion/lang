import "std/test";
import "std/sort";
// examples/tests/sort_by_and_ci_test.fern — pure-Fern coverage of the
// std/sort surface NOT exercised by sort_wider_test (which does the
// monomorphic wider-int + ascending-string sorts). This covers the
// comparator / case-insensitive / projection-key half:
//   string_cmp / string_cmp_ci  (the ordering primitives)
//   sort_strings_desc           (descending monomorphic string sort)
//   sort_strings_asc_ci         (case-insensitive ascending)
//   sort_by[T]                  (generic comparator-driven sort — closure arg)
//   is_sorted_by[T]             (the verification companion)
//   sort_by_i32_key[T]          (Schwartzian projection sort)
// The generic comparator/key shapes are the interesting ones — a closure
// arg over a generic `T[]`. The Go-side suite unit-tests these; this is
// the migration-shaped (pure-Fern, std/test-driven, self-host-gated)
// companion.

function test_string_cmp(): test.TestOutcome {
    // "apple" < "banana" → negative; equal → 0; reverse → positive.
    var lt: boolean = sort.string_cmp("apple", "banana") < 0;
    var eq: boolean = sort.string_cmp("pear", "pear") == 0;
    var gt: boolean = sort.string_cmp("pear", "apple") > 0;
    return test.assert_true(lt && eq && gt);
}

function test_string_cmp_ci(): test.TestOutcome {
    // Case-insensitive: "Apple" and "apple" compare equal; "Banana" > "apple".
    var eq: boolean = sort.string_cmp_ci("Apple", "apple") == 0;
    var lt: boolean = sort.string_cmp_ci("apple", "Banana") < 0;
    return test.assert_true(eq && lt);
}

function test_sort_strings_desc(): test.TestOutcome {
    var xs: string[] = ["banana", "apple", "cherry"];
    return test.assert_eq_array(sort.sort_strings_desc(xs), ["cherry", "banana", "apple"]);
}

function test_sort_strings_asc_ci(): test.TestOutcome {
    // Mixed case must not fragment: "Banana"/"apple"/"Cherry" → apple, Banana, Cherry.
    var xs: string[] = ["Banana", "apple", "Cherry"];
    return test.assert_eq_array(sort.sort_strings_asc_ci(xs), ["apple", "Banana", "Cherry"]);
}

function test_sort_by_desc(): test.TestOutcome {
    // Generic comparator: sort i32 descending via b - a.
    var xs: i32[] = [3, 1, 4, 1, 5, 9, 2, 6];
    var out = sort.sort_by(xs, function (a: i32, b: i32): i32 { return b - a; });
    return test.assert_eq_array(out, [9, 6, 5, 4, 3, 2, 1, 1]);
}

function test_sort_by_stable(): test.TestOutcome {
    // Already-ascending input stays put under an ascending comparator.
    var xs: i32[] = [1, 2, 3, 4, 5];
    var out = sort.sort_by(xs, function (a: i32, b: i32): i32 { return a - b; });
    return test.assert_eq_array(out, [1, 2, 3, 4, 5]);
}

function test_is_sorted_by_true(): test.TestOutcome {
    var xs: i32[] = [1, 3, 3, 7, 10];
    return test.assert_true(sort.is_sorted_by(xs, function (a: i32, b: i32): i32 { return a - b; }));
}

function test_is_sorted_by_false(): test.TestOutcome {
    var xs: i32[] = [1, 3, 2, 7];
    return test.assert_false(sort.is_sorted_by(xs, function (a: i32, b: i32): i32 { return a - b; }));
}

function test_sort_by_i32_key(): test.TestOutcome {
    // Projection: sort by the negated value → descending order.
    var xs: i32[] = [4, 2, 8, 6];
    var out = sort.sort_by_i32_key(xs, function (x: i32): i32 { return 0 - x; });
    return test.assert_eq_array(out, [8, 6, 4, 2]);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/sort comparator + ci");
    r = r.it("string_cmp",          test_string_cmp());
    r = r.it("string_cmp_ci",       test_string_cmp_ci());
    r = r.it("sort_strings_desc",   test_sort_strings_desc());
    r = r.it("sort_strings_asc_ci", test_sort_strings_asc_ci());
    r = r.it("sort_by desc",        test_sort_by_desc());
    r = r.it("sort_by stable",      test_sort_by_stable());
    r = r.it("is_sorted_by true",   test_is_sorted_by_true());
    r = r.it("is_sorted_by false",  test_is_sorted_by_false());
    r = r.it("sort_by_i32_key",     test_sort_by_i32_key());
    return r.finish();
}
