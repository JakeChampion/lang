import "std/test";
import "std/array";
// examples/tests/array_hof_test.fern — pure-Fern coverage of the std/array
// higher-order combinators NOT already covered by array_combinators_test
// (which does map / filter / fold / any / all / find): flat_map, reduce
// (→ Option[T]), and sort_by (a comparator closure). All are generic over the
// element type with closure args — the same generic-method-on-array + closure
// shape that lowers through the self-host IR. The Go-side suite unit-tests
// these; this is the migration-shaped (pure-Fern, std/test-driven,
// self-host-gated) companion.

function test_flat_map(): test.TestOutcome {
    var xs: i32[] = [1, 2, 3];
    var out = xs.flat_map(function (x: i32): i32[] { return [x, x * 10]; });
    return test.assert_eq_array(out, [1, 10, 2, 20, 3, 30]);
}

function test_flat_map_empty(): test.TestOutcome {
    var xs: i32[] = [];
    var out = xs.flat_map(function (x: i32): i32[] { return [x]; });
    return test.assert_eq(out.len(), 0);
}

function test_reduce_sum(): test.TestOutcome {
    var xs: i32[] = [1, 2, 3, 4];
    match (xs.reduce(function (a: i32, b: i32): i32 { return a + b; })) {
        Some(v) => { return test.assert_eq(v, 10); },
        None => { return test.fail("reduce of non-empty expected Some"); }
    }
}

function test_reduce_single(): test.TestOutcome {
    var xs: i32[] = [5];
    match (xs.reduce(function (a: i32, b: i32): i32 { return a + b; })) {
        Some(v) => { return test.assert_eq(v, 5); },
        None => { return test.fail("reduce of single expected Some"); }
    }
}

function test_reduce_empty(): test.TestOutcome {
    var xs: i32[] = [];
    match (xs.reduce(function (a: i32, b: i32): i32 { return a + b; })) {
        Some(v) => { return test.fail("reduce of empty expected None"); },
        None => { return test.pass(); }
    }
}

function test_reduce_max(): test.TestOutcome {
    var xs: i32[] = [3, 7, 2, 9, 4];
    match (xs.reduce(function (a: i32, b: i32): i32 { if (a > b) { return a; } return b; })) {
        Some(v) => { return test.assert_eq(v, 9); },
        None => { return test.fail("expected Some"); }
    }
}

function test_sort_by_asc(): test.TestOutcome {
    var xs: i32[] = [3, 1, 2, 5, 4];
    var out = xs.sort_by(function (a: i32, b: i32): i32 { return a - b; });
    return test.assert_eq_array(out, [1, 2, 3, 4, 5]);
}

function test_sort_by_desc(): test.TestOutcome {
    var xs: i32[] = [3, 1, 2, 5, 4];
    var out = xs.sort_by(function (a: i32, b: i32): i32 { return b - a; });
    return test.assert_eq_array(out, [5, 4, 3, 2, 1]);
}

function test_intersperse(): test.TestOutcome {
    var xs: i32[] = [1, 2, 3];
    return test.assert_eq_array(xs.intersperse(0), [1, 0, 2, 0, 3]);
}

function test_intersperse_single(): test.TestOutcome {
    // A single element has no gap to fill — returned unchanged.
    var xs: i32[] = [7];
    return test.assert_eq_array(xs.intersperse(0), [7]);
}

function test_intersperse_empty(): test.TestOutcome {
    var xs: i32[] = [];
    return test.assert_eq(xs.intersperse(0).len(), 0);
}

function test_intersperse_strings(): test.TestOutcome {
    // Structural (no callback) → works for any element type.
    var xs: string[] = ["a", "b", "c"];
    return test.assert_eq_array(xs.intersperse("-"), ["a", "-", "b", "-", "c"]);
}

function flatten_is_even(x: i32): boolean { return x % 2 == 0; }
function flatten_add(a: i32, x: i32): i32 { return a + x; }

function test_flatten(): test.TestOutcome {
    // Nested arrays concatenate in order; inner empties vanish.
    return test.assert_eq_array(array.flatten([[1, 2], [], [3, 4]]), [1, 2, 3, 4]);
}

function test_flatten_empty(): test.TestOutcome {
    var empty: i32[][] = [];
    return test.assert_eq(array.flatten(empty).len(), 0);
}

function test_partition(): test.TestOutcome {
    // kept = matches (in order), rejected = the rest (in order).
    var pr: (i32[], i32[]) = array.partition([1, 2, 3, 4, 5], flatten_is_even);
    if (pr.1.len() != 3) { return test.fail("rejected len"); }
    return test.assert_eq_array(pr.0, [2, 4]);
}

function test_partition_method(): test.TestOutcome {
    var pr: (i32[], i32[]) = [1, 2, 3, 4].partition(flatten_is_even);
    return test.assert_eq_array(pr.1, [1, 3]);
}

function test_scan(): test.TestOutcome {
    // Running left fold; same length as input, final == fold.
    return test.assert_eq_array(array.scan([1, 2, 3, 4], 0, flatten_add), [1, 3, 6, 10]);
}

function test_scan_method(): test.TestOutcome {
    return test.assert_eq_array([5, 5, 5].scan(0, flatten_add), [5, 10, 15]);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/array higher-order");
    r = r.it("flat_map",         test_flat_map);
    r = r.it("flat_map empty",   test_flat_map_empty);
    r = r.it("reduce sum",       test_reduce_sum);
    r = r.it("reduce single",    test_reduce_single);
    r = r.it("reduce empty",     test_reduce_empty);
    r = r.it("reduce max",       test_reduce_max);
    r = r.it("sort_by asc",      test_sort_by_asc);
    r = r.it("sort_by desc",     test_sort_by_desc);
    r = r.it("intersperse",         test_intersperse);
    r = r.it("intersperse single",  test_intersperse_single);
    r = r.it("intersperse empty",   test_intersperse_empty);
    r = r.it("intersperse strings", test_intersperse_strings);
    r = r.it("flatten",           test_flatten);
    r = r.it("flatten empty",     test_flatten_empty);
    r = r.it("partition",         test_partition);
    r = r.it("partition method",  test_partition_method);
    r = r.it("scan",              test_scan);
    r = r.it("scan method",       test_scan_method);
    return r.finish();
}
