import "std/test";
import "std/u64" as u64m;
// examples/tests/u64_roots_test.fern — pure-Fern coverage of std/u64's
// sqrt_floor / is_power_of_2 / next_power_of_2 / log2_floor: unsigned root and
// power helpers. Being unsigned they carry no negative-input cases and span the
// full u64 range — sqrt_floor is exact up to (2^32-1)^2, the power helpers reach
// 2^63, and log2_floor spans 0..63. The Go-side TestU64Roots pins these across
// all four backends; this is the migration-shaped companion. Scalar-only, so
// self-host clean.

function test_sqrt_floor(): test.TestOutcome {
    if ((100 as u64).sqrt_floor() != (10 as u64)) { return test.fail("sqrt 100"); }
    if ((99 as u64).sqrt_floor() != (9 as u64)) { return test.fail("sqrt 99"); }
    return test.assert_true((0 as u64).sqrt_floor() == (0 as u64));
}

function two63(): u64 {
    // 2^63 built as a shift; a bare 9223372036854775808 literal exceeds the
    // signed range the lexer stores numbers in (and trips the formatter).
    return (1 as u64) << (63 as u64);
}

function test_sqrt_floor_large(): test.TestOutcome {
    // (2^32 - 1)^2 = 18446744065119617025; its floor-sqrt is 2^32 - 1. Built by
    // squaring rather than as a bare (over-i64-range) literal.
    var big: u64 = (4294967295 as u64) * (4294967295 as u64);
    return test.assert_true(big.sqrt_floor() == (4294967295 as u64));
}

function test_is_power_of_2(): test.TestOutcome {
    if (!two63().is_power_of_2()) { return test.fail("2^63"); }
    if ((6 as u64).is_power_of_2()) { return test.fail("6"); }
    if ((0 as u64).is_power_of_2()) { return test.fail("0"); }
    return test.assert_true((1 as u64).is_power_of_2());
}

function test_next_power_of_2(): test.TestOutcome {
    if ((5 as u64).next_power_of_2() != (8 as u64)) { return test.fail("5 -> 8"); }
    if ((16 as u64).next_power_of_2() != (16 as u64)) { return test.fail("16 -> 16"); }
    return test.assert_true((1 as u64).next_power_of_2() == (1 as u64));
}

function test_next_power_of_2_cap(): test.TestOutcome {
    // 2^63 is the largest representable power; above it returns 0.
    if (two63().next_power_of_2() != two63()) { return test.fail("2^63 unchanged"); }
    return test.assert_true((two63() + (1 as u64)).next_power_of_2() == (0 as u64));
}

function test_log2_floor(): test.TestOutcome {
    if (two63().log2_floor() != 63) { return test.fail("2^63 -> 63"); }
    if ((1 as u64).log2_floor() != 0) { return test.fail("1 -> 0"); }
    return test.assert_true((0 as u64).log2_floor() == (0 - 1));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/u64 roots");
    r = r.it("sqrt_floor",          test_sqrt_floor);
    r = r.it("sqrt_floor large",    test_sqrt_floor_large);
    r = r.it("is_power_of_2",       test_is_power_of_2);
    r = r.it("next_power_of_2",     test_next_power_of_2);
    r = r.it("next_power_of_2 cap", test_next_power_of_2_cap);
    r = r.it("log2_floor",          test_log2_floor);
    return r.finish();
}
