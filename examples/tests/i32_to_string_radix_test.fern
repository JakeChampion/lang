import "std/test";
import "std/i32";
import "std/string";
// examples/tests/i32_to_string_radix_test.fern — pure-Fern coverage of
// std/i32.to_string_radix(base): render an i32 in an arbitrary base (2..36,
// digits 0-9a-z, signed), the general form behind to_binary/to_oct/to_hex and
// the write-side inverse of string.parse_int_radix. Covers several bases, sign,
// zero, out-of-range base, and a parse_int_radix round-trip. Kept as its own
// suite so the self-host merged bundle stays under the asm_ir IR budget; uses
// assert_true. The i32 -> string render self-hosts cleanly (like to_hex), so the
// suite is self-host-gated in full. The Go-side TestI32ToStringRadix pins native
// compilation on all four backends.

function test_hex(): test.TestOutcome {
    return test.assert_true((255).to_string_radix(16) == "ff");
}

function test_binary(): test.TestOutcome {
    return test.assert_true((5).to_string_radix(2) == "101");
}

function test_octal(): test.TestOutcome {
    return test.assert_true((511).to_string_radix(8) == "777");
}

function test_base36(): test.TestOutcome {
    return test.assert_true((35).to_string_radix(36) == "z");
}

function test_negative(): test.TestOutcome {
    return test.assert_true((0 - 26).to_string_radix(16) == "-1a");
}

function test_zero(): test.TestOutcome {
    return test.assert_true((0).to_string_radix(10) == "0");
}

function test_bad_base(): test.TestOutcome {
    if ((5).to_string_radix(1) != "") { return test.fail("base 1"); }
    return test.assert_true((5).to_string_radix(37) == "");
}

function test_round_trip(): test.TestOutcome {
    // to_string_radix then parse_int_radix at the same base recovers n.
    var s: string = (1234567).to_string_radix(36);
    match (s.parse_int_radix(36)) {
        Some(v) => { return test.assert_true(v == 1234567); },
        None => { return test.fail("round-trip parse failed"); }
    }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/i32 to_string_radix");
    r = r.it("hex",        test_hex());
    r = r.it("binary",     test_binary());
    r = r.it("octal",      test_octal());
    r = r.it("base36",     test_base36());
    r = r.it("negative",   test_negative());
    r = r.it("zero",       test_zero());
    r = r.it("bad base",   test_bad_base());
    r = r.it("round trip", test_round_trip());
    return r.finish();
}
