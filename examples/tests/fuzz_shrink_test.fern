import "std/fuzz";
import "std/test";
import "std/string";
import "std/array";
// examples/tests/fuzz_shrink_test.fern — `r.fuzz_shrink`
// walkthrough. Same shape as the base `r.fuzz` but on a
// failure the harness minimises the offending input before
// reporting, so the failure log shows a clean reproducer
// rather than the wild mutated buffer that happened to fire.
//
// Properties here pass — the shrinker is exercised in the
// failure-shape Go gate
// (`TestRunnerFuzzShrinkSurfacesMinimisedInput`) and in
// the dedicated reducer probes below.

// Property that holds: `input.len() >= 0` for every byte
// array. This shouldn't ever fire — the shrinker still runs
// the mutation pass but never gets to minimise anything.
function check_len_nonneg(input: u8[]): test.TestOutcome {
    if (input.len() >= 0) { return test.pass(); }
    return test.fail("len returned negative");
}

// Property that holds: reversing the bytes twice is the
// identity — checked directly on the `u8[]` input, no text
// bridge needed. The fuzz_default_iterations loop puts the
// byte-level mutator through its paces; if the round-trip
// ever broke, the shrinker would localise the trigger to a
// minimal byte sequence.
function check_reverse_idempotent(input: u8[]): test.TestOutcome {
    return test.assert_eq_array(input.reverse().reverse(), input);
}

// Property that holds: every byte in `to_lower(s)` is
// outside the uppercase range [65, 90]. The scan is
// byte-level and holds for invalid UTF-8 too, so the bridge
// is `string_from_bytes_unchecked`.
function check_to_lower_no_upper(input: u8[]): test.TestOutcome {
    var s: string = string_from_bytes_unchecked(input);
    var lowered: string = s.to_lower();
    var i: i32 = 0;
    while (i < lowered.len()) {
        var b: i32 = lowered[i] as i32;
        if (b >= 65 && b <= 90) {
            return test.fail("uppercase byte " + b.to_string() +
                        " at " + i.to_string() + " after to_lower");
        }
        i = i + 1;
    }
    return test.pass();
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("fuzz shrink");

    r = r.fuzz_shrink("len non-negative",
                      ["".bytes(), "x".bytes(), "abc".bytes()], 50,
                      check_len_nonneg);

    r = r.fuzz_shrink("reverse_bytes idempotent",
                      ["".bytes(), "a".bytes(), "abc".bytes(), "hello world".bytes()],
                      fuzz.fuzz_default_iterations(),
                      check_reverse_idempotent);

    r = r.fuzz_shrink("to_lower has no uppercase",
                      ["".bytes(), "Hello".bytes(), "MIXED".bytes(), "ALLCAPS".bytes()],
                      100,
                      check_to_lower_no_upper);

    return r.finish();
}
