import "std/test";
import "std/array";
// examples/tests/array_binary_search_test.fern — pure-Fern coverage of
// std/array's binary_search[T: cmp.Ord] (free + method forms): O(log n) search
// of an ascending-sorted array, returning Some(index) or None. Covers found
// (first / middle / last), absent (in-range / below / above), empty, single,
// and STRING elements (lexicographic order). Kept as its own suite so the
// self-host merged bundle stays under the asm_ir IR budget; uses assert_true +
// match (no scalar assert_eq[i32]).
//
// The return is Option[i32] (scalar payload) regardless of the element type, so
// unlike the T[]/Option[T]-returning generics the string case lowers on the
// self-host IR path too — this suite is self-host-gated in full. The Go-side
// TestArrayBinarySearch pins native compilation on all four backends.

function idx(o: Option[i32]): i32 {
    match (o) { Some(v) => { return v; }, None => { return 0 - 1; } }
}

function test_found_middle(): test.TestOutcome {
    return test.assert_true(idx([1, 3, 5, 7, 9, 11].binary_search(7)) == 3);
}

function test_found_first(): test.TestOutcome {
    return test.assert_true(idx([1, 3, 5, 7, 9, 11].binary_search(1)) == 0);
}

function test_found_last(): test.TestOutcome {
    return test.assert_true(idx([1, 3, 5, 7, 9, 11].binary_search(11)) == 5);
}

function test_absent_in_range(): test.TestOutcome {
    match ([1, 3, 5, 7, 9, 11].binary_search(4)) {
        Some(v) => { return test.fail("expected None for absent target"); },
        None => { return test.pass(); }
    }
}

function test_absent_below(): test.TestOutcome {
    return test.assert_true(idx([1, 3, 5].binary_search(0)) == 0 - 1);
}

function test_absent_above(): test.TestOutcome {
    return test.assert_true(idx([1, 3, 5].binary_search(20)) == 0 - 1);
}

function test_free_fn(): test.TestOutcome {
    return test.assert_true(idx(array.binary_search([1, 3, 5, 7], 5)) == 2);
}

function test_empty(): test.TestOutcome {
    var e: i32[] = [];
    match (e.binary_search(1)) {
        Some(v) => { return test.fail("expected None for empty"); },
        None => { return test.pass(); }
    }
}

function test_single(): test.TestOutcome {
    if (idx([42].binary_search(42)) != 0) { return test.fail("single found"); }
    return test.assert_true(idx([42].binary_search(1)) == 0 - 1);
}

function test_strings(): test.TestOutcome {
    // Lexicographically sorted; cmp.Ord uses the string ordering.
    var ss: string[] = ["apple", "banana", "cherry", "date"];
    if (idx(ss.binary_search("cherry")) != 2) { return test.fail("cherry at 2"); }
    return test.assert_true(idx(ss.binary_search("fig")) == 0 - 1);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/array binary_search");
    r = r.it("found middle",    test_found_middle());
    r = r.it("found first",     test_found_first());
    r = r.it("found last",      test_found_last());
    r = r.it("absent in range", test_absent_in_range());
    r = r.it("absent below",    test_absent_below());
    r = r.it("absent above",    test_absent_above());
    r = r.it("free fn",         test_free_fn());
    r = r.it("empty",           test_empty());
    r = r.it("single",          test_single());
    r = r.it("strings",         test_strings());
    return r.finish();
}
