import "std/test";
// examples/tests/set_eq_test.fern — order-independent
// (multiset) array assertions for cases where the
// production order isn't observable. Typical use sites:
// `Map.keys()`, `read_dir(...)`, parallel-set-difference
// output.
//
// "Multiset" because duplicates count: `[1, 1, 2]` and
// `[1, 2, 2]` are NOT set-equal here — both element counts
// must match. Use `assert_subset_*` when one array should
// just CONTAIN the other.

function test_set_eq_i32_same_order(): test.TestOutcome {
    return test.assert_set_eq([1, 2, 3], [1, 2, 3]);
}

function test_set_eq_i32_reversed(): test.TestOutcome {
    return test.assert_set_eq([3, 2, 1], [1, 2, 3]);
}

function test_set_eq_i32_multiset(): test.TestOutcome {
    // Duplicates must match: two 1s on each side.
    return test.assert_set_eq([1, 1, 2], [2, 1, 1]);
}

function test_set_eq_i32_multiset_mismatch(): test.TestOutcome {
    // `[1, 1, 2]` has two 1s; `[1, 2, 2]` has only one.
    // Must fail.
    match (test.assert_set_eq([1, 1, 2], [1, 2, 2])) {
        Fail(_) => { return test.pass(); },
        Pass => { return test.fail("expected multiset mismatch to fail"); }
    }
    return test.pass();
}

function test_set_eq_strings(): test.TestOutcome {
    return test.assert_set_eq(["b", "a", "c"], ["c", "a", "b"]);
}

function test_set_eq_length_mismatch(): test.TestOutcome {
    match (test.assert_set_eq([1, 2], [1, 2, 3])) {
        Fail(msg) => {
            if (!msg.contains("length differs")) {
                return test.fail("missing `length differs` in: " + msg);
            }
            return test.pass();
        },
        Pass => { return test.fail("expected length mismatch"); }
    }
    return test.pass();
}

function test_subset_i32_pass(): test.TestOutcome {
    return test.assert_subset([1, 2, 3, 4, 5], [4, 2]);
}

function test_subset_i32_requires_multiplicity(): test.TestOutcome {
    // Subset has two 1s but the superset only has one —
    // must fail.
    match (test.assert_subset([1, 2, 3], [1, 1])) {
        Fail(msg) => {
            if (!msg.contains("not in superset")) {
                return test.fail("missing reason in: " + msg);
            }
            return test.pass();
        },
        Pass => { return test.fail("expected subset to need multiplicity"); }
    }
    return test.pass();
}

function test_subset_string_pass(): test.TestOutcome {
    return test.assert_subset(["apple", "banana", "cherry"], ["banana"]);
}

function test_subset_empty_subset_always_passes(): test.TestOutcome {
    // Empty subset is vacuously a subset of anything, including itself.
    // (The empty array needs a type annotation: a bare `[]` can't infer
    // the element type for the generic `assert_subset[T]`.)
    var empty: i32[] = [];
    return test.assert_subset([1, 2, 3], empty);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("set eq");
    r = r.it("set_eq i32 same order",            test_set_eq_i32_same_order);
    r = r.it("set_eq i32 reversed",              test_set_eq_i32_reversed);
    r = r.it("set_eq i32 multiset matches",      test_set_eq_i32_multiset);
    r = r.it("set_eq i32 multiset mismatch fails", test_set_eq_i32_multiset_mismatch);
    r = r.it("set_eq strings",                   test_set_eq_strings);
    r = r.it("set_eq length mismatch reported",  test_set_eq_length_mismatch);
    r = r.it("subset i32 pass",                  test_subset_i32_pass);
    r = r.it("subset i32 multiplicity required", test_subset_i32_requires_multiplicity);
    r = r.it("subset string pass",               test_subset_string_pass);
    r = r.it("subset empty is vacuous",          test_subset_empty_subset_always_passes);
    return r.finish();
}
