import "std/test";
// examples/tests/json_detail_test.fern — batch 33
// additions to std/test:
//   * `test.assert_json_has_key(json_text, key)` /
//     `test.assert_json_lacks_key(json_text, key)` — top-
//     level JObject key presence checks.
//   * `test.assert_json_array_len(json_text, n)` /
//     `test.assert_json_object_size(json_text, n)` —
//     cardinality checks.
//
// All four delegate to `std/json`'s `json_parse` and report
// distinct diagnostics for invalid JSON, wrong top-level
// type, and missing/extra entries.

function test_has_key_pass(): test.TestOutcome {
    return test.assert_json_has_key("{\"name\":\"alice\",\"age\":30}", "name");
}

function test_has_key_missing(): test.TestOutcome {
    match (test.assert_json_has_key("{\"name\":\"alice\"}", "age")) {
        Pass => { return test.fail("missing key should fail"); },
        Fail(msg) => {
            if (!msg.contains("\"age\"") || !msg.contains("size 1")) {
                return test.fail("expected key + size in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_has_key_invalid_json(): test.TestOutcome {
    match (test.assert_json_has_key("not-json{", "x")) {
        Pass => { return test.fail("invalid JSON should fail"); },
        Fail(msg) => {
            if (!msg.contains("not valid JSON")) {
                return test.fail("expected 'not valid JSON': " + msg);
            }
            return test.pass();
        }
    }
}

function test_has_key_array_top_level(): test.TestOutcome {
    // Top-level array, not object — distinct diagnostic.
    match (test.assert_json_has_key("[1, 2, 3]", "0")) {
        Pass => { return test.fail("array top-level should fail has_key"); },
        Fail(msg) => {
            if (!msg.contains("array, not object")) {
                return test.fail("expected 'array, not object': " + msg);
            }
            return test.pass();
        }
    }
}

function test_has_key_null_top_level(): test.TestOutcome {
    match (test.assert_json_has_key("null", "x")) {
        Pass => { return test.fail("null top-level should fail has_key"); },
        Fail(msg) => {
            if (!msg.contains("null, not object")) {
                return test.fail("expected 'null, not object': " + msg);
            }
            return test.pass();
        }
    }
}

function test_lacks_key_pass(): test.TestOutcome {
    return test.assert_json_lacks_key("{\"name\":\"alice\"}", "password");
}

function test_lacks_key_present_fails(): test.TestOutcome {
    match (test.assert_json_lacks_key("{\"name\":\"alice\",\"password\":\"x\"}",
                                  "password")) {
        Pass => { return test.fail("present key should fail lacks_key"); },
        Fail(msg) => {
            if (!msg.contains("unexpectedly present")) {
                return test.fail("expected 'unexpectedly present': " + msg);
            }
            return test.pass();
        }
    }
}

function test_array_len_pass(): test.TestOutcome {
    return test.assert_json_array_len("[1, 2, 3, 4, 5]", 5);
}

function test_array_len_empty(): test.TestOutcome {
    return test.assert_json_array_len("[]", 0);
}

function test_array_len_wrong(): test.TestOutcome {
    match (test.assert_json_array_len("[1, 2]", 5)) {
        Pass => { return test.fail("wrong length should fail"); },
        Fail(msg) => {
            if (!msg.contains("expected length 5") || !msg.contains("got 2")) {
                return test.fail("expected both lengths in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_array_len_object_top_level(): test.TestOutcome {
    match (test.assert_json_array_len("{\"k\":\"v\"}", 0)) {
        Pass => { return test.fail("object top-level should fail array_len"); },
        Fail(msg) => {
            if (!msg.contains("object, not array")) {
                return test.fail("expected 'object, not array': " + msg);
            }
            return test.pass();
        }
    }
}

function test_object_size_pass(): test.TestOutcome {
    return test.assert_json_object_size("{\"a\":1,\"b\":2,\"c\":3}", 3);
}

function test_object_size_empty(): test.TestOutcome {
    return test.assert_json_object_size("{}", 0);
}

function test_object_size_wrong(): test.TestOutcome {
    match (test.assert_json_object_size("{\"a\":1}", 5)) {
        Pass => { return test.fail("wrong size should fail"); },
        Fail(msg) => {
            if (!msg.contains("expected 5 keys") || !msg.contains("got 1")) {
                return test.fail("expected both counts in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("JSON detail assertions");
    r = r.it("has_key pass",                     test_has_key_pass);
    r = r.it("has_key missing names size",       test_has_key_missing);
    r = r.it("has_key invalid JSON diag",        test_has_key_invalid_json);
    r = r.it("has_key array top-level rejected", test_has_key_array_top_level);
    r = r.it("has_key null top-level rejected",  test_has_key_null_top_level);
    r = r.it("lacks_key pass",                   test_lacks_key_pass);
    r = r.it("lacks_key present fails",          test_lacks_key_present_fails);
    r = r.it("array_len pass",                   test_array_len_pass);
    r = r.it("array_len empty",                  test_array_len_empty);
    r = r.it("array_len wrong shows both",       test_array_len_wrong);
    r = r.it("array_len object rejected",        test_array_len_object_top_level);
    r = r.it("object_size pass",                 test_object_size_pass);
    r = r.it("object_size empty",                test_object_size_empty);
    r = r.it("object_size wrong shows both",     test_object_size_wrong);
    return r.finish();
}
