import "std/test";
import "std/array" as array;
// examples/tests/array_vector_test.fern — pure-Fern coverage of std/array's
// dot_f64 (dot product, running to the shorter length on a mismatch) and
// norm_f64 (Euclidean / L2 norm = sqrt(dot(self, self))). Both return a plain
// f64, so this rides all four native backends and both self-host gates. The
// Go-side TestArrayVector pins the native backends; this is the
// migration-shaped companion.

function near(a: f64, b: f64): boolean {
    var d: f64 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d < 0.0001;
}

function test_dot(): test.TestOutcome {
    var a: f64[] = [1.0, 2.0, 3.0];
    var b: f64[] = [4.0, 5.0, 6.0];
    // 1*4 + 2*5 + 3*6 = 32
    return test.assert_eq_f64_near(array.dot_f64(a, b), 32.0, 0.0001);
}

function test_dot_negatives(): test.TestOutcome {
    // 1*3 + (-2)*4 = 3 - 8 = -5
    return test.assert_eq_f64_near(array.dot_f64([1.0, 0.0 - 2.0], [3.0, 4.0]), 0.0 - 5.0, 0.0001);
}

function test_dot_mismatch(): test.TestOutcome {
    var a: f64[] = [1.0, 2.0, 3.0];
    var c: f64[] = [1.0, 1.0];
    // runs to the shorter length: 1*1 + 2*1 = 3
    if (!near(array.dot_f64(a, c), 3.0)) { return test.fail("a,c"); }
    return test.assert_eq_f64_near(array.dot_f64(c, a), 3.0, 0.0001);
}

function test_norm(): test.TestOutcome {
    if (!near(array.norm_f64([3.0, 4.0]), 5.0)) { return test.fail("3-4-5"); }
    return test.assert_eq_f64_near(array.norm_f64([1.0, 2.0, 2.0]), 3.0, 0.0001);
}

function test_empty(): test.TestOutcome {
    var empty: f64[] = [];
    if (!near(array.dot_f64(empty, empty), 0.0)) { return test.fail("dot empty"); }
    return test.assert_eq_f64_near(array.norm_f64(empty), 0.0, 0.0001);
}

function test_identity(): test.TestOutcome {
    // norm(x)^2 == dot(x, x)
    var x: f64[] = [1.0, 2.0, 3.0];
    return test.assert_eq_f64_near(array.norm_f64(x) * array.norm_f64(x), array.dot_f64(x, x), 0.0001);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/array f64 vector");
    r = r.it("dot",           test_dot());
    r = r.it("dot negatives", test_dot_negatives());
    r = r.it("dot mismatch",  test_dot_mismatch());
    r = r.it("norm",          test_norm());
    r = r.it("empty",         test_empty());
    r = r.it("norm^2 == dot", test_identity());
    return r.finish();
}
