import "std/test";
import "std/task";

// examples/tests/async_task_fn_test.fern — exercises the Phase-3b
// task-function CPS transform (docs/ASYNC-IMPLEMENTATION-PLAN.md): spawn
// targets are written as ORDINARY functions with a suspending `await` in the
// body, and the parser desugars each into the std/task `(Reactor, args…) ->
// (Step, Reactor)` protocol automatically — no hand-written state machine.
// Where async_concurrent_test.fern hand-writes the `(Step, Reactor)` form, this
// file writes plain functions and lets the compiler generate the continuation.
//
// Run:  fern -interp examples/tests/async_task_fn_test.fern

// A single straight-line await: register `simulated`, resume by adding `addend`.
// The compiler splits this at the `await` into the register + Wait(token, resume)
// state machine, with `resume` capturing `addend`.
function start_add(simulated: i32, addend: i32): i32 {
    var woken = await simulated;
    return woken + addend;
}

// Setup before the await + extra work after it — exercises the pre-await section
// and a non-trivial post-await continuation body.
function start_scaled(base: i32, factor: i32): i32 {
    var seed = base + 1;
    var woken = await seed;
    var scaled = woken * factor;
    return scaled;
}

// Two-task fan-out joined with `await` inside the concurrent block.
function test_fanout(): test.TestOutcome {
    concurrent {
        var a = spawn start_add(10, 1);   // -> 11
        var b = spawn start_add(20, 2);   // -> 22
        if (await a != 11) { return test.fail("a wrong: " + a.to_string()); }
        return test.assert_eq(await b, 22);
    }
}

// A single spawn of an ordinary-form task → 42.
function test_single(): test.TestOutcome {
    concurrent {
        var only = spawn start_add(40, 2);   // (40)+2 = 42
        return test.assert_eq(await only, 42);
    }
}

// Pre-await setup + post-await arithmetic: (6+1)*6 = 42.
function test_scaled(): test.TestOutcome {
    concurrent {
        var s = spawn start_scaled(6, 6);   // seed=7, woken=7, 7*6=42
        return test.assert_eq(await s, 42);
    }
}

// Two SEQUENTIAL awaits (slice 2): the compiler nests a second continuation
// inside the first. `await a` then `await b`, finish with their sum + carry.
function start_seq(a: i32, b: i32, carry: i32): i32 {
    var x = await a;
    var y = await b;
    return x + y + carry;
}

function test_sequential(): test.TestOutcome {
    concurrent {
        var t = spawn start_seq(20, 20, 2);   // 20 + 20 + 2 = 42
        return test.assert_eq(await t, 42);
    }
}

// An `await` inside a terminating `if/else` (slice 3a): each branch is its own
// continuation, sharing the reactor; both branches end in `return`. The compiler
// splits each branch independently.
function start_branch(pick: i32, a: i32, b: i32): i32 {
    if (pick > 0) {
        var x = await a;
        return x + 2;
    } else {
        var y = await b;
        return y;
    }
}

function test_branch_then(): test.TestOutcome {
    concurrent {
        var t = spawn start_branch(1, 40, 99);   // pick>0 → await 40 → 40+2 = 42
        return test.assert_eq(await t, 42);
    }
}

function test_branch_else(): test.TestOutcome {
    concurrent {
        var t = spawn start_branch(0, 99, 42);   // pick==0 → await 42 → 42
        return test.assert_eq(await t, 42);
    }
}

// A guard clause with an `await` (slice 3b): the await-bearing `if` (no else)
// RETURNS, so the code after it is the fall-through, reached only when the guard
// is not taken. Both the guard branch and the fall-through can await.
function start_guard(v: i32, hi: i32): i32 {
    var got = await v;
    if (got > 100) {
        var y = await hi;     // guard branch awaits + returns
        return y;
    }
    return got + 2;            // fall-through (!guard), same reactor scope
}

function test_guard_fallthrough(): test.TestOutcome {
    concurrent {
        var t = spawn start_guard(40, 99);   // got=40, not >100 → 40+2 = 42
        return test.assert_eq(await t, 42);
    }
}

function test_guard_taken(): test.TestOutcome {
    concurrent {
        var t = spawn start_guard(200, 42);  // got=200>100 → await 42 → 42
        return test.assert_eq(await t, 42);
    }
}

// A TRUE MERGE (slice 3c): the await-bearing `if` branch does NOT return — it
// mutates `got` and FALLS THROUGH to the shared `return got`. The compiler pushes
// the post-if continuation into each branch, so the awaiting path's mutation and
// its use of `return got` are co-located in one resume.
function start_merge(v: i32, bonus: i32): i32 {
    var got = await v;
    if (got < 40) {
        var b = await bonus;       // await (binding), then...
        got = got + b;             // ...mutate, and fall through
    }
    return got;                    // merge point — uses mutated got
}

function test_merge_taken(): test.TestOutcome {
    concurrent {
        var t = spawn start_merge(10, 32);  // got=10<40 → got = 10 + await 32 = 42
        return test.assert_eq(await t, 42);
    }
}

function test_merge_skipped(): test.TestOutcome {
    concurrent {
        var t = spawn start_merge(42, 99);  // got=42, not <40 → return 42 (bonus unused)
        return test.assert_eq(await t, 42);
    }
}

// An `await` inside a `while` LOOP (loops slice 1): the loop becomes a recursive
// function whose loop-carried vars (acc, i) are threaded as params, so mutation
// survives across iterations. Each turn awaits and accumulates.
function start_sum(n: i32, step: i32): i32 {
    var acc = 0;
    var i = 0;
    while (i < n) {
        var x = await step;     // suspends each iteration
        acc = acc + x;
        i = i + 1;
    }
    return acc;
}

function test_loop(): test.TestOutcome {
    concurrent {
        var t = spawn start_sum(3, 14);   // 14 + 14 + 14 = 42
        return test.assert_eq(await t, 42);
    }
}

// Zero-iteration loop: the loop carried-state passes straight to the exit.
function test_loop_zero(): test.TestOutcome {
    concurrent {
        var t = spawn start_sum(0, 99);   // loop never runs → acc stays 0
        return test.assert_eq(await t, 0);
    }
}

// An `await` inside a RANGE `for` loop (`for i in 0..n`, which parses to a
// C-style `for` → rewritten to a `while`). Same recursive-loop lowering.
function start_range(n: i32, step: i32): i32 {
    var acc = 0;
    for i in 0..n {
        var x = await step;
        acc = acc + x;
    }
    return acc;
}

function test_range_loop(): test.TestOutcome {
    concurrent {
        var t = spawn start_range(3, 14);   // 14 + 14 + 14 = 42
        return test.assert_eq(await t, 42);
    }
}

// An `await` inside an ARRAY `for x in xs` loop. The array (immutable) is captured
// by the recursive loop closure; only the mutated accumulator/index are threaded.
function start_arrsum(xs: i32[], bonus: i32): i32 {
    var acc = 0;
    for x in xs {
        var b = await bonus;
        acc = acc + x + b;
    }
    return acc;
}

function test_array_loop(): test.TestOutcome {
    concurrent {
        var t = spawn start_arrsum([10, 20, 9], 1);   // (10+1)+(20+1)+(9+1) = 42
        return test.assert_eq(await t, 42);
    }
}

// `await` in EXPRESSION positions (assignment RHS, return expr, if cond) — each
// is hoisted to a preceding `var __await_h = await …;` binding before the CPS
// transform runs, left-to-right.
function start_expr(a: i32, b: i32): i32 {
    var acc = await a;
    acc = acc + await b;          // assignment RHS
    if (await a > 0) {            // if condition
        return acc + await b;     // return expression
    }
    return acc;
}

function test_expr_await(): test.TestOutcome {
    concurrent {
        var t = spawn start_expr(10, 11);  // acc=10; acc+=11→21; (10>0) → 21+11 = 32
        return test.assert_eq(await t, 32);
    }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("async-task-fn");
    r = r.it("expr_await", test_expr_await());
    r = r.it("fanout", test_fanout());
    r = r.it("single", test_single());
    r = r.it("scaled", test_scaled());
    r = r.it("sequential", test_sequential());
    r = r.it("branch_then", test_branch_then());
    r = r.it("branch_else", test_branch_else());
    r = r.it("guard_fallthrough", test_guard_fallthrough());
    r = r.it("guard_taken", test_guard_taken());
    r = r.it("merge_taken", test_merge_taken());
    r = r.it("merge_skipped", test_merge_skipped());
    r = r.it("loop", test_loop());
    r = r.it("loop_zero", test_loop_zero());
    r = r.it("range_loop", test_range_loop());
    r = r.it("array_loop", test_array_loop());
    return r.finish();
}
