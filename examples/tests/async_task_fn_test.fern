import "std/test";
import "std/task";

// examples/tests/async_task_fn_test.fern — exercises the Phase-3b
// task-function CPS transform (docs/ASYNC-IMPLEMENTATION-PLAN.md): spawn
// targets are written as ORDINARY functions with a suspending `await` in the
// body, and the parser desugars each into the std/task `(Reactor, args…) ->
// (Step, Reactor)` protocol automatically — no hand-written state machine.
// Where async_concurrent_test.fern hand-writes the `(Step, Reactor)` form, this
// file writes plain functions and lets the compiler generate the continuation.
//
// Run:  fern -interp examples/tests/async_task_fn_test.fern

// A single straight-line await: register `simulated`, resume by adding `addend`.
// The compiler splits this at the `await` into the register + Wait(token, resume)
// state machine, with `resume` capturing `addend`.
function start_add(simulated: i32, addend: i32): i32 {
    var woken = await simulated;
    return woken + addend;
}

// Setup before the await + extra work after it — exercises the pre-await section
// and a non-trivial post-await continuation body.
function start_scaled(base: i32, factor: i32): i32 {
    var seed = base + 1;
    var woken = await seed;
    var scaled = woken * factor;
    return scaled;
}

// Two-task fan-out joined with `await` inside the concurrent block.
function test_fanout(): test.TestOutcome {
    concurrent {
        var a = spawn start_add(10, 1);   // -> 11
        var b = spawn start_add(20, 2);   // -> 22
        if (await a != 11) { return test.fail("a wrong: " + a.to_string()); }
        return test.assert_eq(await b, 22);
    }
}

// A single spawn of an ordinary-form task → 42.
function test_single(): test.TestOutcome {
    concurrent {
        var only = spawn start_add(40, 2);   // (40)+2 = 42
        return test.assert_eq(await only, 42);
    }
}

// Pre-await setup + post-await arithmetic: (6+1)*6 = 42.
function test_scaled(): test.TestOutcome {
    concurrent {
        var s = spawn start_scaled(6, 6);   // seed=7, woken=7, 7*6=42
        return test.assert_eq(await s, 42);
    }
}

// Two SEQUENTIAL awaits (slice 2): the compiler nests a second continuation
// inside the first. `await a` then `await b`, finish with their sum + carry.
function start_seq(a: i32, b: i32, carry: i32): i32 {
    var x = await a;
    var y = await b;
    return x + y + carry;
}

function test_sequential(): test.TestOutcome {
    concurrent {
        var t = spawn start_seq(20, 20, 2);   // 20 + 20 + 2 = 42
        return test.assert_eq(await t, 42);
    }
}

// An `await` inside a terminating `if/else` (slice 3a): each branch is its own
// continuation, sharing the reactor; both branches end in `return`. The compiler
// splits each branch independently.
function start_branch(pick: i32, a: i32, b: i32): i32 {
    if (pick > 0) {
        var x = await a;
        return x + 2;
    } else {
        var y = await b;
        return y;
    }
}

function test_branch_then(): test.TestOutcome {
    concurrent {
        var t = spawn start_branch(1, 40, 99);   // pick>0 → await 40 → 40+2 = 42
        return test.assert_eq(await t, 42);
    }
}

function test_branch_else(): test.TestOutcome {
    concurrent {
        var t = spawn start_branch(0, 99, 42);   // pick==0 → await 42 → 42
        return test.assert_eq(await t, 42);
    }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("async-task-fn");
    r = r.it("fanout", test_fanout());
    r = r.it("single", test_single());
    r = r.it("scaled", test_scaled());
    r = r.it("sequential", test_sequential());
    r = r.it("branch_then", test_branch_then());
    r = r.it("branch_else", test_branch_else());
    return r.finish();
}
