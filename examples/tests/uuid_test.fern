import "std/test";
import "std/uuid" as uuid;
import "std/string";
// examples/tests/uuid_test.fern — pure-Fern coverage of std/uuid's
// generators. The output is random, so the assertions check the
// *structure* (length, hyphen positions, version + variant nibbles,
// is_uuid shape, distinctness) — all of which hold for every draw, so
// the TAP output is deterministic and the self-host differential gate
// (which compares self-host vs interp output byte-for-byte) still
// applies even though the bytes differ run to run. The module is built
// from string-concat + sliced hex-digit literals (no chr / byte-array
// round-trip), so it lowers through the self-host IR path. The Go-side
// suite unit-tests the bytes; this is the migration-shaped companion.

function test_v4_len(): test.TestOutcome {
    return test.assert_eq(uuid.uuid_v4().len(), 36);
}

function test_v4_is_uuid(): test.TestOutcome {
    return test.assert_true(uuid.uuid_v4().is_uuid());
}

function test_v4_hyphens(): test.TestOutcome {
    var u: string = uuid.uuid_v4();
    // '-' is 45, at the 8-4-4-4-12 boundaries.
    return test.assert_true(u[8] == 45 && u[13] == 45 && u[18] == 45 && u[23] == 45);
}

function test_v4_version(): test.TestOutcome {
    // The version nibble is the first char of the third group (index 14):
    // '4' is 52.
    return test.assert_eq(uuid.uuid_v4()[14], 52);
}

function test_v4_variant(): test.TestOutcome {
    // The variant nibble (index 19) is one of 8/9/a/b for RFC 4122.
    var c: i32 = (uuid.uuid_v4()[19] as i32);
    return test.assert_true(c == 56 || c == 57 || c == 97 || c == 98);
}

function test_v4_distinct(): test.TestOutcome {
    // Two draws are overwhelmingly likely distinct (122 random bits).
    return test.assert_true(uuid.uuid_v4() != uuid.uuid_v4());
}

function test_v7_len(): test.TestOutcome {
    return test.assert_eq(uuid.uuid_v7().len(), 36);
}

function test_v7_is_uuid(): test.TestOutcome {
    return test.assert_true(uuid.uuid_v7().is_uuid());
}

function test_v7_version(): test.TestOutcome {
    // v7 carries version '7' (55) in the same nibble slot.
    return test.assert_eq(uuid.uuid_v7()[14], 55);
}

function test_nil(): test.TestOutcome {
    if (uuid.uuid_nil() != "00000000-0000-0000-0000-000000000000") { return test.fail("nil value"); }
    if (!uuid.uuid_is_nil(uuid.uuid_nil())) { return test.fail("is_nil on nil"); }
    // A generated v4 is never nil.
    return test.assert_false(uuid.uuid_is_nil(uuid.uuid_v4()));
}

function test_version_extract(): test.TestOutcome {
    // Version comes from index 14: v4 → 4, v7 → 7, nil → 0.
    if (uuid.uuid_version(uuid.uuid_v4()) != 4) { return test.fail("v4"); }
    if (uuid.uuid_version(uuid.uuid_v7()) != 7) { return test.fail("v7"); }
    return test.assert_eq(uuid.uuid_version(uuid.uuid_nil()), 0);
}

function test_version_malformed(): test.TestOutcome {
    // Wrong length / missing hyphens / empty → -1.
    if (uuid.uuid_version("not-a-uuid") != -1) { return test.fail("short"); }
    if (uuid.uuid_version("f47ac10b58cc4372a5670e02b2c3d479") != -1) { return test.fail("no hyphens"); }
    return test.assert_eq(uuid.uuid_version(""), -1);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/uuid");
    r = r.it("v4 length 36",       test_v4_len());
    r = r.it("v4 is_uuid shape",   test_v4_is_uuid());
    r = r.it("v4 hyphen positions", test_v4_hyphens());
    r = r.it("v4 version nibble",   test_v4_version());
    r = r.it("v4 variant nibble",   test_v4_variant());
    r = r.it("v4 distinct draws",   test_v4_distinct());
    r = r.it("v7 length 36",       test_v7_len());
    r = r.it("v7 is_uuid shape",   test_v7_is_uuid());
    r = r.it("v7 version nibble",   test_v7_version());
    r = r.it("nil + is_nil",        test_nil());
    r = r.it("version extract",     test_version_extract());
    r = r.it("version malformed",   test_version_malformed());
    return r.finish();
}
