import "std/test";
// examples/tests/quiet_mode_test.fern — exercises the
// new --quiet mode added to std/test:
//   * `test.test_new_quiet(suite)` — constructor that enables
//     quiet mode from the start.
//   * `(r).with_quiet()` — flip the mode on an existing
//     runner.
//   * `test.parse_quiet_from_args(argv)` — pull the boolean
//     off `--quiet` in `args()`.
//
// Quiet mode contract:
//   * `ok N - name` lines are suppressed for passes and
//     skips.
//   * `not ok N - name` lines + their YAML-ish diagnostic
//     block STILL print (the whole point of quiet mode
//     is to surface failures).
//   * The `1..N` plan line and the summary footer still
//     print so TAP consumers reconstruct the count.
//   * Counters (passed / failed / skipped) are unaffected
//     — quiet only changes what gets printed, not what
//     gets recorded.
//
// We exercise these via an isolated child runner whose
// post-run counters we inspect, same pattern as
// `fail_fast_test.fern` — keeps the outer suite's exit
// code clean while still pinning the behaviour.

function trivial_pass(): test.TestOutcome { return test.pass(); }

function test_quiet_preserves_counters(): test.TestOutcome {
    // Build a quiet runner with 3 passes; counters
    // should reflect the work even though no per-case
    // lines were printed.
    var sub: test.TestRunner = test.test_new_quiet("quiet-counters");
    sub = sub.it("p1", trivial_pass);
    sub = sub.it("p2", trivial_pass);
    sub = sub.it("p3", trivial_pass);
    if (sub.passed != 3 || sub.failed != 0 || sub.skipped != 0) {
        return test.fail("quiet counters off: p=" + sub.passed.to_string() +
                    " f=" + sub.failed.to_string() +
                    " s=" + sub.skipped.to_string());
    }
    return test.pass();
}

function test_quiet_skip_still_counted(): test.TestOutcome {
    // A skip in quiet mode still increments `skipped`
    // even though the SKIP line is suppressed.
    var sub: test.TestRunner = test.test_new_quiet("quiet-skip");
    sub = sub.skip("p1", "manual skip");
    if (sub.skipped == 1 && sub.passed == 0) { return test.pass(); }
    return test.fail("skip counter off in quiet mode");
}

function test_parse_quiet_present(): test.TestOutcome {
    var argv: string[] = ["lang", "-interp", "test.fern", "--", "--quiet"];
    if (test.parse_quiet_from_args(argv)) { return test.pass(); }
    return test.fail("--quiet not detected in argv");
}

function test_parse_quiet_absent(): test.TestOutcome {
    var argv: string[] = ["lang", "-interp", "test.fern"];
    if (!test.parse_quiet_from_args(argv)) { return test.pass(); }
    return test.fail("false-positive: detected --quiet in clean argv");
}

function test_with_quiet_preserves_filter(): test.TestOutcome {
    var r0: test.TestRunner = test.test_new_filtered("with-q", "x");
    var r1: test.TestRunner = r0.with_quiet();
    if (r1.filter == "x" && r1.quiet) { return test.pass(); }
    return test.fail("with_quiet clobbered an unrelated field");
}

function test_with_quiet_preserves_fail_fast(): test.TestOutcome {
    // Quiet + fail-fast should be orthogonal — setting one
    // must not affect the other.
    var r0: test.TestRunner = test.test_new_fail_fast("with-q-ff");
    var r1: test.TestRunner = r0.with_quiet();
    if (r1.fail_fast && r1.quiet) { return test.pass(); }
    return test.fail("with_quiet did not preserve fail_fast=true");
}

function test_test_new_quiet_constructor(): test.TestOutcome {
    var r: test.TestRunner = test.test_new_quiet("ctor-quiet");
    if (r.quiet) { return test.pass(); }
    return test.fail("test_new_quiet did not enable quiet field");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("quiet mode");
    r = r.it("quiet preserves counters across passes",
             test_quiet_preserves_counters);
    r = r.it("skip in quiet still increments counter",
             test_quiet_skip_still_counted);
    r = r.it("parse_quiet detects --quiet",
             test_parse_quiet_present);
    r = r.it("parse_quiet no false-positive",
             test_parse_quiet_absent);
    r = r.it("with_quiet preserves filter",
             test_with_quiet_preserves_filter);
    r = r.it("with_quiet preserves fail_fast",
             test_with_quiet_preserves_fail_fast);
    r = r.it("test_new_quiet enables flag",
             test_test_new_quiet_constructor);
    return r.finish();
}
