import "std/test";
import "std/i32" as i32m;
// examples/tests/i32_roots_prime_test.fern — pure-Fern coverage of std/i32's
// next_power_of_2 and is_prime at the top of the signed 32-bit range, where
// both used to compute their loop condition in i32 and wrap (#8467). 2^30 is
// the largest power of two a signed i32 holds, so next_power_of_2 returns the 0
// sentinel above it — the same convention as the i64 / u32 / u64 twins —
// instead of doubling past the sign boundary into a loop with no exit; is_prime
// bounds its trial divisor by `i <= n / i`, which cannot overflow, so M31
// reports prime. The Go-side TestI32RootsPrime pins these across all four
// backends; this is the migration-shaped companion. Scalar-only, so self-host
// clean. A regression here hangs rather than failing.

function test_next_power_of_2(): test.TestOutcome {
    if ((0).next_power_of_2() != 1) { return test.fail("0 -> 1"); }
    if ((5).next_power_of_2() != 8) { return test.fail("5 -> 8"); }
    return test.assert_true((16).next_power_of_2() == 16);
}

function test_next_power_of_2_cap(): test.TestOutcome {
    // 2^30 is the largest representable power; above it returns 0.
    if ((1073741823).next_power_of_2() != 1073741824) {
        return test.fail("2^30 - 1 -> 2^30");
    }
    if ((1073741824).next_power_of_2() != 1073741824) {
        return test.fail("2^30 unchanged");
    }
    if ((1073741825).next_power_of_2() != 0) { return test.fail("2^30 + 1 -> 0"); }
    return test.assert_true((2147483647).next_power_of_2() == 0);
}

function test_is_prime_small(): test.TestOutcome {
    if (!(2).is_prime()) { return test.fail("2"); }
    if (!(3).is_prime()) { return test.fail("3"); }
    if ((1).is_prime()) { return test.fail("1"); }
    if ((0 - 7).is_prime()) { return test.fail("-7"); }
    if (!(7919).is_prime()) { return test.fail("7919"); }
    return test.assert_true(!(7917).is_prime());
}

function test_is_prime_at_root(): test.TestOutcome {
    // Composites whose smallest factor sits at the i32 square root, where
    // `i * i` would wrap: 46337 * 46327, and 46327 squared.
    if (!(46337).is_prime()) { return test.fail("46337"); }
    if ((2146654199).is_prime()) { return test.fail("46337 * 46327"); }
    return test.assert_true(!(2146190929).is_prime());
}

function test_is_prime_top_of_range(): test.TestOutcome {
    if (!(2147483647).is_prime()) { return test.fail("M31"); }
    if (!(2147483629).is_prime()) { return test.fail("2147483629"); }
    if (!(2147483587).is_prime()) { return test.fail("2147483587"); }
    if ((2147483645).is_prime()) { return test.fail("2147483645"); }
    return test.assert_true(!(2147483646).is_prime());
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/i32 roots + prime");
    r = r.it("next_power_of_2",      test_next_power_of_2);
    r = r.it("next_power_of_2 cap",  test_next_power_of_2_cap);
    r = r.it("is_prime small",       test_is_prime_small);
    r = r.it("is_prime at root",     test_is_prime_at_root);
    r = r.it("is_prime top of range", test_is_prime_top_of_range);
    return r.finish();
}
