import "core/map";
import "std/test";
import "std/headers";

// examples/tests/header_map_migrated_test.fern —
// Fern port of `TestInterpScriptHeaderMap` from
// `internal/e2e/interp_script_test.go`.
//
// The Go original was a 5-case table-driven test where
// each subcase spawned a `fern -interp` subprocess, ran
// a different inline program, and grep-asserted exit
// code + stdout. The migrated form folds all 5 cases
// into one Fern file: each `r.it(...)` exercises the
// same surface but asserts on the returned value
// directly via `assert_eq` / `_i32` / the new
// `assert_is_some_eq_string` (no subprocess, no
// print-then-grep).
//
// Needs `import "std/headers";`.

function test_case_insensitive_get(): test.TestOutcome {
    var h: HeaderMap = headers.header_map_new();
    h = h.set("Content-Type", "application/json");
    return test.assert_is_some_eq_string(h.get("CONTENT-TYPE"),
                                    "application/json");
}

function test_get_all_preserves_insertion_order(): test.TestOutcome {
    var h: HeaderMap = headers.header_map_new();
    h = h.append("Set-Cookie", "a=1");
    h = h.append("Set-Cookie", "b=2");
    h = h.append("Set-Cookie", "c=3");
    // Original verified via print-each-line + grep on
    // stdout; here we assert the returned array directly
    // so the failure message localises the first
    // divergence by index.
    return test.assert_eq_array(h.get_all("set-cookie"),
                                  ["a=1", "b=2", "c=3"]);
}

function test_set_replaces_then_size_2(): test.TestOutcome {
    var h: HeaderMap = headers.header_map_new();
    h = h.append("X", "first");
    h = h.append("Y", "y1");
    h = h.append("X", "second");
    h = h.set("x", "replaced");
    // After set("x"), X has exactly one value
    // ("replaced") and Y is still there → size == 2.
    return test.assert_eq(h.len(), 2);
}

function test_set_replaces_get_returns_new(): test.TestOutcome {
    var h: HeaderMap = headers.header_map_new();
    h = h.append("X", "first");
    h = h.append("Y", "y1");
    h = h.append("X", "second");
    h = h.set("x", "replaced");
    return test.assert_is_some_eq_string(h.get("x"), "replaced");
}

function test_set_on_absent_appends(): test.TestOutcome {
    var h: HeaderMap = headers.header_map_new();
    h = h.set("X-First", "1");
    return test.assert_eq(h.len(), 1);
}

function test_get_all_on_missing_is_empty(): test.TestOutcome {
    var h: HeaderMap = headers.header_map_new();
    h = h.append("X", "1");
    return test.assert_eq((h.get_all("Y")).len(), 0);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("HeaderMap (migrated)");
    r = r.it("case-insensitive get",
             test_case_insensitive_get);
    r = r.it("get_all preserves insertion order",
             test_get_all_preserves_insertion_order);
    r = r.it("set replaces drops dupes (size=2)",
             test_set_replaces_then_size_2);
    r = r.it("set replaces; get returns new value",
             test_set_replaces_get_returns_new);
    r = r.it("set on absent name appends",
             test_set_on_absent_appends);
    r = r.it("get_all on missing name is empty",
             test_get_all_on_missing_is_empty);
    return r.finish();
}
