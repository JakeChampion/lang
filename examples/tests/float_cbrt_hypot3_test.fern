import "std/test";
import "std/float" as float;
// examples/tests/float_cbrt_hypot3_test.fern — pure-Fern coverage of
// std/float.cbrt (real cube root, defined for negatives) and hypot3 (3-D
// Euclidean length sqrt(x²+y²+z²), overflow-safe). Both f64 and f32. The
// Go-side TestFloatCbrt and TestFloatHypot3 pin these across the native
// backends (cbrt's wasmbin leg skips libm pow, hypot3 covers all four); this is
// the migration-shaped companion. cbrt / hypot3 lower on the self-host asm_ir
// path, so this rides both self-host gates too.

function test_cbrt_perfect(): test.TestOutcome {
    if (!float_near((27.0).cbrt(), 3.0)) { return test.fail("cbrt 27"); }
    return test.assert_eq_f64_near((8.0).cbrt(), 2.0, 0.001);
}

function test_cbrt_negative(): test.TestOutcome {
    return test.assert_eq_f64_near((0.0 - 8.0).cbrt(), 0.0 - 2.0, 0.001);
}

function test_cbrt_fractional(): test.TestOutcome {
    return test.assert_eq_f64_near((0.125).cbrt(), 0.5, 0.001);
}

function test_hypot3_pythagorean(): test.TestOutcome {
    // The 2-3-6 and 1-2-2 Pythagorean-like quadruples give exact integers.
    if (!float_near((2.0).hypot3(3.0, 6.0), 7.0)) { return test.fail("2,3,6 -> 7"); }
    return test.assert_eq_f64_near((1.0).hypot3(2.0, 2.0), 3.0, 0.0001);
}

function test_hypot3_zero_and_2d(): test.TestOutcome {
    if (!float_near((0.0).hypot3(0.0, 0.0), 0.0)) { return test.fail("origin"); }
    return test.assert_eq_f64_near((3.0).hypot3(4.0, 0.0), 5.0, 0.0001);
}

function test_f32(): test.TestOutcome {
    if (!float_near((27.0 as f32).cbrt() as f64, 3.0)) { return test.fail("cbrt f32"); }
    return test.assert_eq_f64_near((2.0 as f32).hypot3(3.0 as f32, 6.0 as f32) as f64, 7.0, 0.001);
}

function float_near(a: f64, b: f64): boolean {
    var d: f64 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d < 0.001;
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/float cbrt/hypot3");
    r = r.it("cbrt perfect cube",   test_cbrt_perfect());
    r = r.it("cbrt negative",       test_cbrt_negative());
    r = r.it("cbrt fractional",     test_cbrt_fractional());
    r = r.it("hypot3 pythagorean",  test_hypot3_pythagorean());
    r = r.it("hypot3 zero and 2d",  test_hypot3_zero_and_2d());
    r = r.it("f32",                 test_f32());
    return r.finish();
}
