// examples/tests/array_at_and_f32_range_test.lang — batch 28
// additions to std/test:
//   * `assert_at_i32(arr, idx, expected)` /
//     `assert_at_string` / `assert_at_i64` — single-
//     position spot check with bounds-aware diagnostics.
//   * `assert_in_range_f32(v, lo, hi)` — f32 mirror of
//     the existing `_i32` / `_i64` / `_f64` range
//     helpers; NaN inputs always fail.

function test_at_i32_pass(): Option[string] {
    return assert_at_i32([10, 20, 30, 40], 2, 30);
}

function test_at_i32_first(): Option[string] {
    return assert_at_i32([10, 20, 30], 0, 10);
}

function test_at_i32_last(): Option[string] {
    return assert_at_i32([10, 20, 30], 2, 30);
}

function test_at_i32_wrong_value(): Option[string] {
    match (assert_at_i32([10, 20, 30], 1, 99)) {
        None => { return fail("wrong value should fail"); },
        Some(msg) => {
            if (!msg.contains("at index 1") || !msg.contains("expected 99") || !msg.contains("got 20")) {
                return Some("expected index + both values: " + msg);
            }
            return None;
        }
    }
}

function test_at_i32_out_of_bounds_high(): Option[string] {
    match (assert_at_i32([10, 20, 30], 5, 0)) {
        None => { return fail("OOB high should fail"); },
        Some(msg) => {
            // Distinct diagnostic from value-mismatch so the
            // mode is obvious in CI logs.
            if (!msg.contains("out of bounds") || !msg.contains("length 3")) {
                return Some("expected 'out of bounds' + 'length 3': " + msg);
            }
            return None;
        }
    }
}

function test_at_i32_out_of_bounds_negative(): Option[string] {
    match (assert_at_i32([10, 20, 30], 0 - 1, 0)) {
        None => { return fail("negative OOB should fail"); },
        Some(msg) => {
            if (!msg.contains("out of bounds")) {
                return Some("expected 'out of bounds': " + msg);
            }
            return None;
        }
    }
}

function test_at_i32_empty_array(): Option[string] {
    var empty: i32[] = [];
    match (assert_at_i32(empty, 0, 0)) {
        None => { return fail("empty array, idx 0 should fail OOB"); },
        Some(_) => { return None; }
    }
}

function test_at_string_pass(): Option[string] {
    return assert_at_string(["alpha", "beta", "gamma"], 1, "beta");
}

function test_at_string_wrong_value_quotes_both(): Option[string] {
    match (assert_at_string(["alpha", "beta"], 0, "ALPHA")) {
        None => { return fail("wrong value should fail"); },
        Some(msg) => {
            if (!msg.contains("\"ALPHA\"") || !msg.contains("\"alpha\"")) {
                return Some("expected both quoted: " + msg);
            }
            return None;
        }
    }
}

function test_at_i64_pass(): Option[string] {
    var arr: i64[] = [100 as i64, 200 as i64, 300 as i64];
    return assert_at_i64(arr, 2, 300 as i64);
}

function test_at_i64_wrong_value(): Option[string] {
    var arr: i64[] = [100 as i64, 200 as i64];
    match (assert_at_i64(arr, 0, 999 as i64)) {
        None => { return fail("expected mismatch fail"); },
        Some(msg) => {
            if (!msg.contains("expected 999") || !msg.contains("got 100")) {
                return Some("expected both values: " + msg);
            }
            return None;
        }
    }
}

function test_in_range_f32_pass(): Option[string] {
    var v: f32 = 1.5 as f32;
    var lo: f32 = 1.0 as f32;
    var hi: f32 = 2.0 as f32;
    return assert_in_range_f32(v, lo, hi);
}

function test_in_range_f32_inclusive_bounds(): Option[string] {
    var lo: f32 = 1.0 as f32;
    var hi: f32 = 2.0 as f32;
    match (assert_in_range_f32(lo, lo, hi)) {
        Some(msg) => { return Some("lo should be in range: " + msg); },
        None => {}
    }
    return assert_in_range_f32(hi, lo, hi);
}

function test_in_range_f32_below(): Option[string] {
    var v: f32 = 0.5 as f32;
    var lo: f32 = 1.0 as f32;
    var hi: f32 = 2.0 as f32;
    match (assert_in_range_f32(v, lo, hi)) {
        None => { return fail("below-range should fail"); },
        Some(msg) => {
            if (!msg.contains("lower bound")) {
                return Some("expected 'lower bound': " + msg);
            }
            return None;
        }
    }
}

function test_in_range_f32_nan_fails(): Option[string] {
    var z: f32 = 0.0 as f32;
    var nan: f32 = z / z;
    var lo: f32 = 0.0 as f32;
    var hi: f32 = 1.0 as f32;
    match (assert_in_range_f32(nan, lo, hi)) {
        None => { return fail("NaN should fail range check"); },
        Some(msg) => {
            if (!msg.contains("NaN")) {
                return Some("expected 'NaN' in failure: " + msg);
            }
            return None;
        }
    }
}

function main(): i32 {
    var r: TestRunner = test_new("array_at + in_range_f32");
    r = r.it("at_i32 middle",                test_at_i32_pass());
    r = r.it("at_i32 first",                 test_at_i32_first());
    r = r.it("at_i32 last",                  test_at_i32_last());
    r = r.it("at_i32 wrong value diag",      test_at_i32_wrong_value());
    r = r.it("at_i32 out-of-bounds high",    test_at_i32_out_of_bounds_high());
    r = r.it("at_i32 negative index",        test_at_i32_out_of_bounds_negative());
    r = r.it("at_i32 empty array OOB",       test_at_i32_empty_array());
    r = r.it("at_string pass",               test_at_string_pass());
    r = r.it("at_string quoted diff",        test_at_string_wrong_value_quotes_both());
    r = r.it("at_i64 pass",                  test_at_i64_pass());
    r = r.it("at_i64 wrong value",           test_at_i64_wrong_value());
    r = r.it("in_range_f32 pass",            test_in_range_f32_pass());
    r = r.it("in_range_f32 inclusive bounds", test_in_range_f32_inclusive_bounds());
    r = r.it("in_range_f32 below names side", test_in_range_f32_below());
    r = r.it("in_range_f32 NaN fails",        test_in_range_f32_nan_fails());
    return r.finish();
}
