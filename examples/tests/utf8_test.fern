import "std/test";
import "std/utf8" as utf8;
import "std/string";
// examples/tests/utf8_test.fern — std/utf8 codepoint decode / encode /
// count / validate (#4416). Multibyte inputs are built from explicit
// byte sequences via string_from_bytes_unchecked (so decode is tested against
// known bytes, not against encode), and encode is checked by its output
// byte length + a decode round-trip. Reference values:
//   'A'  U+0041   [65]                     1 byte
//   'é'  U+00E9   [195, 169]               2 bytes  (cp 233)
//   '€'  U+20AC   [226, 130, 172]          3 bytes  (cp 8364)
//   '😀' U+1F600  [240, 159, 152, 128]     4 bytes  (cp 128512)

function mixed(): string {
    // "A" + é + € + 😀 — 10 bytes, 4 codepoints.
    var b: u8[] = [65 as u8, 195 as u8, 169 as u8, 226 as u8, 130 as u8,
        172 as u8, 240 as u8, 159 as u8, 152 as u8, 128 as u8];
    return string_from_bytes_unchecked(b);
}

function decode_cp(s: string, i: i32): i32 {
    match (utf8.utf8_decode_at(s, i)) { Some(p) => { return p.0; }, None => { return 0 - 1; } }
}

function decode_len(s: string, i: i32): i32 {
    match (utf8.utf8_decode_at(s, i)) { Some(p) => { return p.1; }, None => { return 0 - 1; } }
}

function test_decode_ascii(): test.TestOutcome {
    return test.assert_true(decode_cp("A", 0) == 65 && decode_len("A", 0) == 1);
}

function test_decode_two_byte(): test.TestOutcome {
    var s: string = string_from_bytes_unchecked([195 as u8, 169 as u8]);   // é
    return test.assert_true(decode_cp(s, 0) == 233 && decode_len(s, 0) == 2);
}

function test_decode_three_byte(): test.TestOutcome {
    var s: string = string_from_bytes_unchecked([226 as u8, 130 as u8, 172 as u8]);  // €
    return test.assert_true(decode_cp(s, 0) == 8364 && decode_len(s, 0) == 3);
}

function test_decode_four_byte(): test.TestOutcome {
    var s: string = string_from_bytes_unchecked([240 as u8, 159 as u8, 152 as u8, 128 as u8]);  // 😀
    return test.assert_true(decode_cp(s, 0) == 128512 && decode_len(s, 0) == 4);
}

function test_decode_at_offset(): test.TestOutcome {
    // The € starts at byte 3 of the mixed string.
    return test.assert_true(decode_cp(mixed(), 3) == 8364 && decode_len(mixed(), 3) == 3);
}

function test_decode_stray_continuation(): test.TestOutcome {
    // A lone 0x80 continuation byte is invalid.
    var s: string = string_from_bytes_unchecked([128 as u8]);
    return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_decode_truncated(): test.TestOutcome {
    // First two bytes of a 3-byte sequence — no third byte.
    var s: string = string_from_bytes_unchecked([226 as u8, 130 as u8]);
    return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_decode_overlong(): test.TestOutcome {
    // Overlong encoding of U+0000 (C0 80) must be rejected.
    var s: string = string_from_bytes_unchecked([192 as u8, 128 as u8]);
    return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_decode_surrogate(): test.TestOutcome {
    // U+D800 encoded as ED A0 80 — a surrogate, not a scalar value.
    var s: string = string_from_bytes_unchecked([237 as u8, 160 as u8, 128 as u8]);
    return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_encode_lengths(): test.TestOutcome {
    // Each width encodes to the expected number of bytes.
    return test.assert_true(
        utf8.utf8_encode((65) as char).len() == 1
        && utf8.utf8_encode((233) as char).len() == 2
        && utf8.utf8_encode((8364) as char).len() == 3
        && utf8.utf8_encode((128512) as char).len() == 4);
}

function test_encode_decode_roundtrip(): test.TestOutcome {
    // Encode then decode recovers the codepoint, for every width.
    return test.assert_true(
        decode_cp(utf8.utf8_encode((8364) as char), 0) == 8364
        && decode_cp(utf8.utf8_encode((128512) as char), 0) == 128512);
}

function test_encode_invalid_is_replacement(): test.TestOutcome {
    // Out-of-range / surrogate codepoints encode as U+FFFD (65533).
    // The bad values go through i32 LOCALS, not literal `as char` casts:
    // a literal outside the scalar range is E071 now (#5629 slice 5), and
    // the point here is the runtime sanitiser, which still has to hold —
    // a cast of a runtime value stays unchecked on purpose.
    var neg: i32 = 0 - 1;
    var surrogate: i32 = 55296;
    var too_big: i32 = 1114112;
    return test.assert_true(
        decode_cp(utf8.utf8_encode(neg as char), 0) == 65533
        && decode_cp(utf8.utf8_encode(surrogate as char), 0) == 65533
        && decode_cp(utf8.utf8_encode(too_big as char), 0) == 65533);
}

function test_char_from_i32(): test.TestOutcome {
    // The checked constructor: Some for a scalar value, None for the two
    // ways an integer can fail to be one.
    var ok_ascii: boolean = match (utf8.char_from_i32(65)) { Some(c) => { c as i32 == 65 }, None => { false } };
    var ok_max: boolean = match (utf8.char_from_i32(1114111)) { Some(c) => { c as i32 == 1114111 }, None => { false } };
    var no_big: boolean = match (utf8.char_from_i32(1114112)) { Some(_) => { false }, None => { true } };
    var no_lo: boolean = match (utf8.char_from_i32(55296)) { Some(_) => { false }, None => { true } };
    var no_hi: boolean = match (utf8.char_from_i32(57343)) { Some(_) => { false }, None => { true } };
    var no_neg: boolean = match (utf8.char_from_i32(0 - 1)) { Some(_) => { false }, None => { true } };
    return test.assert_true(ok_ascii && ok_max && no_big && no_lo && no_hi && no_neg);
}

function test_codepoint_count(): test.TestOutcome {
    // Byte length is 10 but there are 4 codepoints.
    return test.assert_true(mixed().len() == 10 && utf8.codepoint_count(mixed()) == 4);
}

function test_codepoints_array(): test.TestOutcome {
    var cps: char[] = utf8.codepoints(mixed());
    if (cps.len() != 4) { return test.fail("codepoint count"); }
    return test.assert_true((cps[0] as i32) == 65 && (cps[1] as i32) == 233
        && (cps[2] as i32) == 8364 && (cps[3] as i32) == 128512);
}

function test_is_valid(): test.TestOutcome {
    // A well-formed mixed string is valid; a stray continuation isn't.
    var bad: string = string_from_bytes_unchecked([65 as u8, 128 as u8]);
    return test.assert_true(utf8.is_valid_utf8(mixed()) && !utf8.is_valid_utf8(bad));
}

function test_encode_all_roundtrip(): test.TestOutcome {
    // encode_all(codepoints(s)) == s for valid UTF-8.
    return test.assert_eq(utf8.encode_all(utf8.codepoints(mixed())), mixed());
}

// The individual characters of mixed(), built from their bytes so the
// char_at / substring expectations don't depend on encode.
function e_acute(): string { return string_from_bytes_unchecked([195 as u8, 169 as u8]); }               // é
function euro(): string { return string_from_bytes_unchecked([226 as u8, 130 as u8, 172 as u8]); }        // €
function emoji(): string { return string_from_bytes_unchecked([240 as u8, 159 as u8, 152 as u8, 128 as u8]); }  // 😀

function cp_or(s: string, i: i32): i32 {
    match (utf8.codepoint_at(s, i)) { Some(c) => { return c as i32; }, None => { return 0 - 1; } }
}

function char_or(s: string, i: i32): string {
    match (utf8.char_at(s, i)) { Some(c) => { return c; }, None => { return "<none>"; } }
}

function test_codepoint_at(): test.TestOutcome {
    // Byte-indexed: byte 0 is 'A', byte 3 starts the € (3-byte) char.
    return test.assert_true(
        cp_or(mixed(), 0) == 65
        && cp_or(mixed(), 3) == 8364
        && cp_or(mixed(), 100) == 0 - 1);
}

function test_char_at(): test.TestOutcome {
    // Codepoint-indexed: the Nth character, whole and exact.
    if (char_or(mixed(), 0) != "A") { return test.fail("char 0"); }
    if (char_or(mixed(), 1) != e_acute()) { return test.fail("char 1 (é)"); }
    if (char_or(mixed(), 2) != euro()) { return test.fail("char 2 (€)"); }
    return test.assert_eq(char_or(mixed(), 3), emoji());
}

function test_char_at_bounds(): test.TestOutcome {
    // Past the last codepoint (there are 4) and negative both give None.
    return test.assert_true(char_or(mixed(), 4) == "<none>" && char_or(mixed(), 0 - 1) == "<none>");
}

function test_substring(): test.TestOutcome {
    // Codepoint-range slice: [1,3) is é+€; the full range is the input;
    // an over-long end clamps; end <= start and start-past-end are "".
    if (utf8.substring(mixed(), 1, 3) != e_acute() + euro()) { return test.fail("[1,3)"); }
    if (utf8.substring(mixed(), 0, 4) != mixed()) { return test.fail("full range"); }
    if (utf8.substring(mixed(), 2, 100) != euro() + emoji()) { return test.fail("clamped end"); }
    if (utf8.substring(mixed(), 3, 1) != "") { return test.fail("end <= start"); }
    return test.assert_eq(utf8.substring(mixed(), 10, 12).to_owned(), "");
}

// mixed() is A(1) + é(2) + €(3) + 😀(4) = 10 bytes, so its character
// boundaries are exactly {0, 1, 3, 6, 10} and every other index in
// 0..10 sits inside a multibyte encoding.
function test_is_char_boundary(): test.TestOutcome {
    var s: string = mixed();
    if (!utf8.is_char_boundary(s, 0)) { return test.fail("0 is a boundary"); }
    if (!utf8.is_char_boundary(s, 1)) { return test.fail("1 is a boundary"); }
    if (!utf8.is_char_boundary(s, 3)) { return test.fail("3 is a boundary"); }
    if (!utf8.is_char_boundary(s, 6)) { return test.fail("6 is a boundary"); }
    if (!utf8.is_char_boundary(s, 10)) { return test.fail("len is a boundary"); }
    var i: i32 = 0;
    while (i < 10) {
        var inside: boolean = i == 2 || (i >= 4 && i <= 5) || (i >= 7 && i <= 9);
        if (inside && utf8.is_char_boundary(s, i)) { return test.fail("interior byte reported as a boundary"); }
        i = i + 1;
    }
    return test.assert_true(true);
}

function test_is_char_boundary_edges(): test.TestOutcome {
    // Out of range in either direction is not a boundary; the empty
    // string has exactly one (index 0 == len); ASCII is all boundaries.
    if (utf8.is_char_boundary(mixed(), 0 - 1)) { return test.fail("negative"); }
    if (utf8.is_char_boundary(mixed(), 11)) { return test.fail("past the end"); }
    if (!utf8.is_char_boundary("", 0)) { return test.fail("empty string at 0"); }
    if (utf8.is_char_boundary("", 1)) { return test.fail("empty string past the end"); }
    return test.assert_true(utf8.is_char_boundary("abc", 0) && utf8.is_char_boundary("abc", 1)
        && utf8.is_char_boundary("abc", 2) && utf8.is_char_boundary("abc", 3));
}

function test_floor_char_boundary(): test.TestOutcome {
    var s: string = mixed();
    // An index already on a boundary is returned unchanged.
    if (utf8.floor_char_boundary(s, 6) != 6) { return test.fail("boundary is its own floor"); }
    // Interior indices snap back to the start of their character.
    if (utf8.floor_char_boundary(s, 2) != 1) { return test.fail("inside é"); }
    if (utf8.floor_char_boundary(s, 5) != 3) { return test.fail("inside €"); }
    if (utf8.floor_char_boundary(s, 9) != 6) { return test.fail("inside 😀"); }
    // Both ends clamp.
    if (utf8.floor_char_boundary(s, 0 - 4) != 0) { return test.fail("negative clamps to 0"); }
    return test.assert_eq(utf8.floor_char_boundary(s, 99), 10);
}

function test_ceil_char_boundary(): test.TestOutcome {
    var s: string = mixed();
    if (utf8.ceil_char_boundary(s, 6) != 6) { return test.fail("boundary is its own ceil"); }
    // Interior indices advance to the end of their character.
    if (utf8.ceil_char_boundary(s, 2) != 3) { return test.fail("inside é"); }
    if (utf8.ceil_char_boundary(s, 4) != 6) { return test.fail("inside €"); }
    if (utf8.ceil_char_boundary(s, 7) != 10) { return test.fail("inside 😀"); }
    if (utf8.ceil_char_boundary(s, 0 - 4) != 0) { return test.fail("negative clamps to 0"); }
    return test.assert_eq(utf8.ceil_char_boundary(s, 99), 10);
}

// The property that makes these safe to slice with: every index the
// two snappers return IS a boundary, floor never grows the index and
// ceil never shrinks it, and slicing at a snapped pair yields valid
// UTF-8 even when the raw pair would have split a character.
function test_boundary_snap_is_valid(): test.TestOutcome {
    var s: string = mixed();
    var a: i32 = 0;
    while (a <= 10) {
        var lo: i32 = utf8.floor_char_boundary(s, a);
        var hi: i32 = utf8.ceil_char_boundary(s, a);
        if (!utf8.is_char_boundary(s, lo)) { return test.fail("floor is not a boundary"); }
        if (!utf8.is_char_boundary(s, hi)) { return test.fail("ceil is not a boundary"); }
        if (lo > a) { return test.fail("floor grew the index"); }
        if (hi < a) { return test.fail("ceil shrank the index"); }
        var b: i32 = a;
        while (b <= 10) {
            var cut: str = s[utf8.floor_char_boundary(s, a) : utf8.ceil_char_boundary(s, b)];
            if (!utf8.is_valid_utf8(cut.to_owned())) { return test.fail("snapped slice is not valid UTF-8"); }
            b = b + 1;
        }
        a = a + 1;
    }
    // The raw, unsnapped slice is exactly what these guard against.
    return test.assert_true(!utf8.is_valid_utf8(s[0 : 2].to_owned()));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/utf8");
    r = r.it("decode ascii",            test_decode_ascii());
    r = r.it("decode 2-byte",           test_decode_two_byte());
    r = r.it("decode 3-byte",           test_decode_three_byte());
    r = r.it("decode 4-byte",           test_decode_four_byte());
    r = r.it("decode at offset",        test_decode_at_offset());
    r = r.it("decode stray continuation", test_decode_stray_continuation());
    r = r.it("decode truncated",        test_decode_truncated());
    r = r.it("decode overlong",         test_decode_overlong());
    r = r.it("decode surrogate",        test_decode_surrogate());
    r = r.it("encode lengths",          test_encode_lengths());
    r = r.it("encode/decode round trip", test_encode_decode_roundtrip());
    r = r.it("encode invalid -> U+FFFD", test_encode_invalid_is_replacement());
    r = r.it("char_from_i32",           test_char_from_i32());
    r = r.it("codepoint count",         test_codepoint_count());
    r = r.it("codepoints array",        test_codepoints_array());
    r = r.it("is_valid_utf8",           test_is_valid());
    r = r.it("encode_all round trip",   test_encode_all_roundtrip());
    r = r.it("codepoint_at",            test_codepoint_at());
    r = r.it("char_at",                 test_char_at());
    r = r.it("char_at bounds",          test_char_at_bounds());
    r = r.it("substring",               test_substring());
    r = r.it("is_char_boundary",        test_is_char_boundary());
    r = r.it("is_char_boundary edges",  test_is_char_boundary_edges());
    r = r.it("floor_char_boundary",     test_floor_char_boundary());
    r = r.it("ceil_char_boundary",      test_ceil_char_boundary());
    r = r.it("boundary snap is valid",  test_boundary_snap_is_valid());
    return r.finish();
}
