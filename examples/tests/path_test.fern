import "std/test";
import "std/path" as path;
// examples/tests/path_test.fern — pure-Fern coverage of the std/path
// POSIX path helpers (string-level, no FS interaction): path_join /
// path_parent / path_file_name / path_extension, including the
// separator-collapsing, root-preservation, trailing-slash and
// hidden-file edge cases. The Go-side suites unit-test the prelude
// origins; this is the migration-shaped (pure-Fern, std/test-driven)
// companion, driven end-to-end through the runner.

function test_join(): test.TestOutcome {
    return test.assert_eq(path.path_join(["a", "b", "c"]), "a/b/c");
}

function test_join_collapses(): test.TestOutcome {
    // Trailing sep on the left + leading sep on the right collapse to one.
    return test.assert_eq(path.path_join(["a/", "/b"]), "a/b");
}

function test_join_root(): test.TestOutcome {
    // The root "/" is preserved as a separator-sentinel.
    return test.assert_eq(path.path_join(["/", "etc", "hosts"]), "/etc/hosts");
}

function test_join_empty_parts(): test.TestOutcome {
    return test.assert_eq(path.path_join(["", "b"]), "b");
}

function test_join_none(): test.TestOutcome {
    return test.assert_eq(path.path_join([]), "");
}

function test_parent(): test.TestOutcome {
    return test.assert_eq(path.path_parent("/a/b/c").to_owned(), "/a/b");
}

function test_parent_relative(): test.TestOutcome {
    return test.assert_eq(path.path_parent("a/b").to_owned(), "a");
}

function test_parent_no_sep(): test.TestOutcome {
    return test.assert_eq(path.path_parent("foo").to_owned(), "");
}

function test_parent_root(): test.TestOutcome {
    return test.assert_eq(path.path_parent("/").to_owned(), "/");
}

function test_parent_top(): test.TestOutcome {
    return test.assert_eq(path.path_parent("/a").to_owned(), "/");
}

function test_file_name(): test.TestOutcome {
    return test.assert_eq(path.path_file_name("/a/b/c").to_owned(), "c");
}

function test_file_name_trailing(): test.TestOutcome {
    return test.assert_eq(path.path_file_name("a/b/").to_owned(), "b");
}

function test_file_name_bare(): test.TestOutcome {
    return test.assert_eq(path.path_file_name("foo").to_owned(), "foo");
}

function test_extension(): test.TestOutcome {
    return test.assert_eq(path.path_extension("a/b/file.txt").to_owned(), "txt");
}

function test_extension_last_dot(): test.TestOutcome {
    // Extension is the substring after the LAST dot.
    return test.assert_eq(path.path_extension("archive.tar.gz").to_owned(), "gz");
}

function test_extension_hidden(): test.TestOutcome {
    // A leading-dot file has no extension.
    return test.assert_eq(path.path_extension(".bashrc").to_owned(), "");
}

function test_extension_none(): test.TestOutcome {
    return test.assert_eq(path.path_extension("noext").to_owned(), "");
}

function test_clean_dots(): test.TestOutcome {
    // `.` elements and duplicate separators collapse.
    return test.assert_eq(path.path_clean("a/./b//c"), "a/b/c");
}

function test_clean_dotdot(): test.TestOutcome {
    // `..` resolves against the preceding element.
    return test.assert_eq(path.path_clean("a/b/../c"), "a/c");
}

function test_clean_rooted_above_root(): test.TestOutcome {
    // A `..` cannot climb above the root of a rooted path.
    return test.assert_eq(path.path_clean("/../a"), "/a");
}

function test_clean_relative_climb(): test.TestOutcome {
    // A leading `..` in a relative path is kept.
    return test.assert_eq(path.path_clean("foo/../../bar"), "../bar");
}

function test_clean_empty(): test.TestOutcome {
    // Empty input cleans to the current dir ".".
    return test.assert_eq(path.path_clean(""), ".");
}

function test_clean_to_dot(): test.TestOutcome {
    // A path that cancels out cleans to ".".
    return test.assert_eq(path.path_clean("a/.."), ".");
}

function test_clean_root(): test.TestOutcome {
    // The bare root is preserved (and keeps its trailing slash).
    return test.assert_eq(path.path_clean("///"), "/");
}

function test_clean_trailing_slash(): test.TestOutcome {
    // A trailing separator is dropped for non-root paths.
    return test.assert_eq(path.path_clean("/a/b/"), "/a/b");
}

function test_is_absolute(): test.TestOutcome {
    if (!path.path_is_absolute("/etc/hosts")) { return test.fail("rooted"); }
    if (path.path_is_absolute("etc/hosts")) { return test.fail("relative"); }
    if (path.path_is_absolute("")) { return test.fail("empty"); }
    return test.assert_false(path.path_is_absolute("./x"));
}

function test_stem(): test.TestOutcome {
    if (path.path_stem("a/b/foo.txt").to_owned() != "foo") { return test.fail("simple"); }
    // Only the final extension is stripped.
    if (path.path_stem("archive.tar.gz").to_owned() != "archive.tar") { return test.fail("multi ext"); }
    // A leading-dot file has no extension, so the whole name is the stem.
    if (path.path_stem(".bashrc").to_owned() != ".bashrc") { return test.fail("hidden"); }
    return test.assert_eq(path.path_stem("foo").to_owned(), "foo");
}

function test_with_extension(): test.TestOutcome {
    if (path.path_with_extension("a/b/foo.txt", "md") != "a/b/foo.md") { return test.fail("replace"); }
    // No existing extension: the new one is appended.
    if (path.path_with_extension("foo", "md") != "foo.md") { return test.fail("append"); }
    // An empty extension drops the final extension entirely.
    if (path.path_with_extension("archive.tar.gz", "") != "archive.tar") { return test.fail("drop"); }
    // A hidden file has no extension, so ext is appended.
    return test.assert_eq(path.path_with_extension(".bashrc", "txt"), ".bashrc.txt");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/path");
    r = r.it("join",                    test_join);
    r = r.it("join collapses seps",     test_join_collapses);
    r = r.it("join preserves root",     test_join_root);
    r = r.it("join skips empty parts",  test_join_empty_parts);
    r = r.it("join of nothing",         test_join_none);
    r = r.it("parent",                  test_parent);
    r = r.it("parent relative",         test_parent_relative);
    r = r.it("parent no separator",     test_parent_no_sep);
    r = r.it("parent of root",          test_parent_root);
    r = r.it("parent of top-level",     test_parent_top);
    r = r.it("file_name",               test_file_name);
    r = r.it("file_name trailing slash", test_file_name_trailing);
    r = r.it("file_name bare",          test_file_name_bare);
    r = r.it("extension",               test_extension);
    r = r.it("extension last dot",      test_extension_last_dot);
    r = r.it("extension hidden file",   test_extension_hidden);
    r = r.it("extension none",          test_extension_none);
    r = r.it("clean dots + dup seps",   test_clean_dots);
    r = r.it("clean dotdot",            test_clean_dotdot);
    r = r.it("clean rooted above root", test_clean_rooted_above_root);
    r = r.it("clean relative climb",    test_clean_relative_climb);
    r = r.it("clean empty",             test_clean_empty);
    r = r.it("clean cancels to dot",    test_clean_to_dot);
    r = r.it("clean bare root",         test_clean_root);
    r = r.it("clean trailing slash",    test_clean_trailing_slash);
    r = r.it("is_absolute",             test_is_absolute);
    r = r.it("stem",                    test_stem);
    r = r.it("with_extension",          test_with_extension);
    return r.finish();
}
