import "std/test";
// examples/tests/wide_numerics_test.fern — i64 / u32 / u64
// assertion family. The corresponding i32 helpers are
// covered by `arithmetic_test.fern`; this file specifically
// exercises the wider widths so a regression in the interp's
// `__int_to_string_u64` override would surface here.

function test_i64_addition(): test.TestOutcome {
    var a: i64 = 5000000000;
    var b: i64 = 3000000000;
    return test.assert_eq(a + b, 8000000000);
}

function test_i64_max(): test.TestOutcome {
    var max: i64 = 9223372036854775807;
    return test.assert_eq(max, 9223372036854775807);
}

function test_u32_max(): test.TestOutcome {
    var max: u32 = 4294967295u32;
    return test.assert_eq(max, 4294967295u32);
}

function test_u64_max(): test.TestOutcome {
    var max: u64 = 18446744073709551615u64;
    return test.assert_eq(max, 18446744073709551615u64);
}

function test_u64_neq(): test.TestOutcome {
    return test.assert_neq(0u64, 1u64);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("wide-numerics");
    r = r.it("i64 addition",  test_i64_addition);
    r = r.it("i64 max",       test_i64_max);
    r = r.it("u32 max",       test_u32_max);
    r = r.it("u64 max",       test_u64_max);
    r = r.it("u64 neq",       test_u64_neq);
    return r.finish();
}
