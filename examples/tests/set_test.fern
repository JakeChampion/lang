import "std/test";
import "std/set" as set;
// examples/tests/set_test.fern — pure-Fern coverage of std/set: the
// generic, value-semantic Set[T] (membership, add/remove dedup,
// union/intersect/difference, subset/equals, insertion-order
// to_array). The most important contract exercised here is VALUE
// SEMANTICS: an operation returns a new set and never mutates its
// receiver — asserted explicitly in test_add_is_pure, the regression
// guard for the aliasing/CoW hazard a wrapper struct over a heap array
// is prone to. Both i32 and string element types are covered.

function test_set_of_dedup(): test.TestOutcome {
    // Duplicates collapse; first occurrence order is kept.
    var s: set.Set[i32] = set.set_of([1, 2, 2, 3, 1]);
    if (s.len() != 3) { return test.fail("len " + s.len().to_string() + " != 3"); }
    return test.assert_eq_array(s.to_array(), [1, 2, 3]);
}

function test_contains(): test.TestOutcome {
    var s: set.Set[i32] = set.set_of([10, 20, 30]);
    return test.assert_true(s.contains(20) && !s.contains(25));
}

function test_add(): test.TestOutcome {
    var s: set.Set[i32] = set.set_new();
    s = s.add(1);
    s = s.add(2);
    s = s.add(1);          // dup — no-op
    return test.assert_eq_array(s.to_array(), [1, 2]);
}

// The value-semantics contract: add returns a NEW set, the receiver is
// untouched. Regression guard for in-place mutation of a shared array
// field (the copy-on-write aliasing hazard).
function test_add_is_pure(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2]);
    var b: set.Set[i32] = a.add(3);
    if (a.len() != 2) { return test.fail("add mutated receiver: a.len = " + a.len().to_string()); }
    if (b.len() != 3) { return test.fail("add result wrong: b.len = " + b.len().to_string()); }
    return test.assert_true(!a.contains(3) && b.contains(3));
}

function test_remove(): test.TestOutcome {
    var s: set.Set[i32] = set.set_of([1, 2, 3, 4]);
    var r: set.Set[i32] = s.remove(2);
    if (s.len() != 4) { return test.fail("remove mutated receiver"); }
    if (r.contains(2)) { return test.fail("remove left the element"); }
    return test.assert_eq_array(r.to_array(), [1, 3, 4]);
}

function test_remove_absent(): test.TestOutcome {
    // Removing an absent element is a no-op that returns an equal set.
    var s: set.Set[i32] = set.set_of([1, 2]);
    return test.assert_eq_array(s.remove(9).to_array(), [1, 2]);
}

function test_union(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2, 3]);
    var b: set.Set[i32] = set.set_of([3, 4, 5]);
    // a's order first, then b's new elements.
    return test.assert_eq_array(a.union(b).to_array(), [1, 2, 3, 4, 5]);
}

function test_intersect(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2, 3, 4]);
    var b: set.Set[i32] = set.set_of([2, 4, 6]);
    return test.assert_eq_array(a.intersect(b).to_array(), [2, 4]);
}

function test_difference(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2, 3, 4]);
    var b: set.Set[i32] = set.set_of([2, 4]);
    return test.assert_eq_array(a.difference(b).to_array(), [1, 3]);
}

function test_subset_and_equals(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2, 3]);
    var sub: set.Set[i32] = set.set_of([3, 1]);
    if (!sub.is_subset(a)) { return test.fail("expected subset"); }
    if (a.is_subset(sub)) { return test.fail("superset wrongly reported subset"); }
    // equals is order-insensitive.
    if (!a.equals(set.set_of([3, 2, 1]))) { return test.fail("equals ignores order"); }
    return test.assert_false(a.equals(set.set_of([1, 2])));
}

function test_empty(): test.TestOutcome {
    var e: set.Set[i32] = set.set_new();
    var a: set.Set[i32] = set.set_of([1, 2]);
    if (!e.is_empty()) { return test.fail("new set not empty"); }
    if (a.is_empty()) { return test.fail("non-empty set reported empty"); }
    // the empty set is a subset of everything and of itself.
    return test.assert_true(e.is_subset(a) && e.is_subset(e));
}

function test_string_elems(): test.TestOutcome {
    var s: set.Set[string] = set.set_of(["a", "b", "a", "c"]);
    if (s.len() != 3) { return test.fail("string dedup len " + s.len().to_string()); }
    if (!s.contains("b")) { return test.fail("missing b"); }
    s = s.remove("a");
    return test.assert_true(!s.contains("a") && s.contains("c"));
}

function test_superset_and_disjoint(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2, 3]);
    var sub: set.Set[i32] = set.set_of([2, 3]);
    var e: set.Set[i32] = set.set_new();
    // is_superset is the mirror of is_subset.
    if (!a.is_superset(sub) || sub.is_superset(a)) { return test.fail("superset"); }
    if (!a.is_superset(e)) { return test.fail("superset of empty"); }
    // is_disjoint: shares nothing.
    if (a.is_disjoint(sub)) { return test.fail("a and sub overlap"); }
    return test.assert_true(a.is_disjoint(set.set_of([7, 8])) && a.is_disjoint(e));
}

function test_symmetric_difference(): test.TestOutcome {
    var a: set.Set[i32] = set.set_of([1, 2, 3]);
    var b: set.Set[i32] = set.set_of([2, 3, 4]);
    // (a-b) ∪ (b-a) = {1} ∪ {4}, a's uniques first.
    var sd: set.Set[i32] = a.symmetric_difference(b);
    if (!sd.equals(set.set_of([1, 4]))) { return test.fail("sym diff value"); }
    var arr: i32[] = sd.to_array();
    if (arr[0] != 1 || arr[1] != 4) { return test.fail("sym diff order"); }
    // Symmetric difference with self is empty; with empty is identity.
    var e: set.Set[i32] = set.set_new();
    return test.assert_true(a.symmetric_difference(a).is_empty() &&
                            a.symmetric_difference(e).equals(a));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/set");
    r = r.it("set_of dedup + order", test_set_of_dedup);
    r = r.it("contains",            test_contains);
    r = r.it("add dedup",           test_add);
    r = r.it("add is pure",         test_add_is_pure);
    r = r.it("remove",              test_remove);
    r = r.it("remove absent",       test_remove_absent);
    r = r.it("union",               test_union);
    r = r.it("intersect",           test_intersect);
    r = r.it("difference",          test_difference);
    r = r.it("subset and equals",   test_subset_and_equals);
    r = r.it("empty",               test_empty);
    r = r.it("string elements",     test_string_elems);
    r = r.it("superset + disjoint",  test_superset_and_disjoint);
    r = r.it("symmetric difference", test_symmetric_difference);
    return r.finish();
}
