import "std/test";
// examples/tests/all_substring_array_test.fern — batch 24
// additions to std/test:
//   * `test.assert_all_starts_with(arr, prefix)` /
//     `test.assert_all_ends_with(arr, suffix)` /
//     `test.assert_all_contain(arr, needle)` — substring
//     property must hold across every element of the
//     string array.
//   * `test.assert_starts_with_any(s, prefixes)` /
//     `test.assert_ends_with_any(s, suffixes)` — single string
//     matches at least one of the supplied options.

function test_all_starts_with_pass(): test.TestOutcome {
    return test.assert_all_starts_with(
        ["[INFO] starting", "[INFO] ready", "[INFO] done"],
        "[INFO]");
}

function test_all_starts_with_empty_array_vacuous(): test.TestOutcome {
    var empty: string[] = [];
    return test.assert_all_starts_with(empty, "anything");
}

function test_all_starts_with_first_violation_reports(): test.TestOutcome {
    match (test.assert_all_starts_with(
        ["[INFO] ok", "[WARN] bad", "[INFO] still ok"],
        "[INFO]")) {
        Pass => { return test.fail("violation missed"); },
        Fail(msg) => {
            // First non-matching index is 1.
            if (!msg.contains("index 1")) {
                return test.fail("expected 'index 1' in failure: " + msg);
            }
            // Failure should also embed the offending value
            // so the test reader can pinpoint the bad line.
            if (!msg.contains("[WARN] bad")) {
                return test.fail("expected '[WARN] bad' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_all_ends_with_pass(): test.TestOutcome {
    return test.assert_all_ends_with(
        ["main.fern", "test.fern", "util.fern"],
        ".fern");
}

function test_all_ends_with_violation(): test.TestOutcome {
    match (test.assert_all_ends_with(
        ["a.fern", "b.txt"], ".fern")) {
        Pass => { return test.fail("violation missed"); },
        Fail(msg) => {
            if (!msg.contains("index 1") || !msg.contains("b.txt")) {
                return test.fail("expected 'index 1' + 'b.txt': " + msg);
            }
            return test.pass();
        }
    }
}

function test_all_contain_pass(): test.TestOutcome {
    return test.assert_all_contain(
        ["trace=abc op=read", "trace=abc op=write", "trace=abc op=close"],
        "trace=abc");
}

function test_all_contain_violation(): test.TestOutcome {
    match (test.assert_all_contain(
        ["ok one", "ok two", "bad three"], "ok")) {
        Pass => { return test.fail("violation missed"); },
        Fail(msg) => {
            if (!msg.contains("index 2") || !msg.contains("bad three")) {
                return test.fail("expected 'index 2' + 'bad three': " + msg);
            }
            return test.pass();
        }
    }
}

function test_starts_with_any_pass(): test.TestOutcome {
    return test.assert_starts_with_any("https://example.com/foo",
                                  ["http://", "https://"]);
}

function test_starts_with_any_first_option(): test.TestOutcome {
    return test.assert_starts_with_any("alpha-1",
                                  ["alpha-", "beta-", "gamma-"]);
}

function test_starts_with_any_no_match_reports(): test.TestOutcome {
    match (test.assert_starts_with_any("ftp://example.com",
                                  ["http://", "https://"])) {
        Pass => { return test.fail("no-match should fail"); },
        Fail(msg) => {
            if (!msg.contains("ftp://example.com")) {
                return test.fail("expected value in failure: " + msg);
            }
            // The failure renders "matches none of N prefixes"
            // — locking in the count rendering so a regression
            // would surface immediately.
            if (!msg.contains("none of 2")) {
                return test.fail("expected 'none of 2' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_starts_with_any_empty_options_fails(): test.TestOutcome {
    var empty: string[] = [];
    match (test.assert_starts_with_any("anything", empty)) {
        Pass => { return test.fail("empty options should fail"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_ends_with_any_pass(): test.TestOutcome {
    return test.assert_ends_with_any("main.fern",
                                [".fern", ".ll", ".s"]);
}

function test_ends_with_any_no_match(): test.TestOutcome {
    match (test.assert_ends_with_any("README",
                                [".md", ".txt", ".rst"])) {
        Pass => { return test.fail("README has no extension match"); },
        Fail(_) => { return test.pass(); }
    }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("all-substring + multi-option substring");
    r = r.it("all_starts_with pass",            test_all_starts_with_pass);
    r = r.it("all_starts_with empty vacuous",   test_all_starts_with_empty_array_vacuous);
    r = r.it("all_starts_with first violation", test_all_starts_with_first_violation_reports);
    r = r.it("all_ends_with pass",              test_all_ends_with_pass);
    r = r.it("all_ends_with violation",         test_all_ends_with_violation);
    r = r.it("all_contain pass",                test_all_contain_pass);
    r = r.it("all_contain violation",           test_all_contain_violation);
    r = r.it("starts_with_any second matches",  test_starts_with_any_pass);
    r = r.it("starts_with_any first matches",   test_starts_with_any_first_option);
    r = r.it("starts_with_any no match + count", test_starts_with_any_no_match_reports);
    r = r.it("starts_with_any empty list fails", test_starts_with_any_empty_options_fails);
    r = r.it("ends_with_any pass",              test_ends_with_any_pass);
    r = r.it("ends_with_any no match",          test_ends_with_any_no_match);
    return r.finish();
}
