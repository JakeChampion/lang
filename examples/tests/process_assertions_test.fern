import "std/test";
// examples/tests/process_assertions_test.fern — end-to-end
// spawn + assert flow using `exec`, `temp_dir`, and the
// std/test process assertion helpers. This is the shape the
// e2e suite migration will land in: the runner spawns the
// compiler binary, redirects stdin, captures stdout / stderr
// / exit code, and asserts.
//
// To keep the example deterministic this file spawns ordinary
// POSIX commands (`echo`, `cat`, `sh`) rather than `fern`
// itself. The migration's compiler-binary tests follow the
// same pattern with `subprocess("/path/to/fern", ["-interp", ...],
// "")`.

function test_echo_stdout_eq(): test.TestOutcome {
    var r: ProcessResult = subprocess("echo", ["hello"], "");
    return test.assert_stdout_eq(r, "hello\n");
}

function test_echo_exit_code(): test.TestOutcome {
    var r: ProcessResult = subprocess("echo", ["x"], "");
    return test.assert_exit(r, 0);
}

function test_cat_passthrough(): test.TestOutcome {
    var r: ProcessResult = subprocess("cat", [], "piped\n");
    return test.assert_process(r, 0, "piped");
}

function test_sh_nonzero_exit(): test.TestOutcome {
    var r: ProcessResult = subprocess("sh", ["-c", "exit 7"], "");
    return test.assert_exit(r, 7);
}

function test_sh_stderr_contains(): test.TestOutcome {
    var r: ProcessResult = subprocess("sh", ["-c", "echo err-line 1>&2; exit 0"], "");
    return test.assert_stderr_contains(r, "err-line");
}

function test_spawn_missing_binary(): test.TestOutcome {
    var r: ProcessResult = subprocess("this-binary-definitely-does-not-exist-7349", [], "");
    // Spawn failure → exit_code = 127 per POSIX convention,
    // with the OS error message in stderr.
    return test.assert_exit(r, 127);
}

function test_temp_dir_writes_and_reads(): test.TestOutcome {
    match (temp_dir("lang-process-assert")) {
        Ok(dir) => {
            var path: string = dir + "/fixture.txt";
            match (write_file(path, "hello tempdir")) {
                None => { },
                Some(_) => { return test.fail("write_file failed under " + dir); }
            }
            // Confirm `cat` reads what we just wrote.
            var r: ProcessResult = subprocess("cat", [path], "");
            return test.assert_process(r, 0, "hello tempdir");
        },
        Err(_) => { return test.fail("temp_dir returned Err"); }
    }
    return test.pass();
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("process assertions");

    // Gate the whole suite on having a POSIX shell — every
    // case here spawns `echo` / `cat` / `sh`. On hosts where
    // those aren't on $PATH (rare for Fern's actual targets,
    // but possible in stripped CI images) the suite skips
    // cleanly instead of cascading false failures.
    var probe: ProcessResult = subprocess("sh", ["-c", "exit 0"], "");
    if (probe.exit_code == 127) {
        r = r.skip("posix tools probe", "sh / echo / cat not on $PATH");
        return r.finish();
    }

    r = r.it("echo stdout eq",          test_echo_stdout_eq);
    r = r.it("echo exit code",          test_echo_exit_code);
    r = r.it("cat passthrough",         test_cat_passthrough);
    r = r.it("sh nonzero exit",         test_sh_nonzero_exit);
    r = r.it("sh stderr contains",      test_sh_stderr_contains);
    r = r.it("spawn missing binary",    test_spawn_missing_binary);
    r = r.it("temp_dir writes + reads", test_temp_dir_writes_and_reads);

    return r.finish();
}
