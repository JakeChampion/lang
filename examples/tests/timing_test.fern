import "std/test";
// examples/tests/timing_test.fern — exercises the time
// builtins (`now_unix_ms`, `monotonic_ns`, `sleep_ms`) and
// the elapsed-time assertion helpers.
//
// The "completes within N ms" pattern is the bread-and-butter
// of perf-regression tests: stamp `monotonic_ns()` before the
// operation, pass the stamp + deadline to `assert_elapsed_lt_ms`
// after. Use `monotonic_ns` (not `now_unix_ms`) for the
// timestamps so NTP-style clock adjustments don't move the
// goalposts mid-test.

function test_now_unix_ms_advances(): test.TestOutcome {
    // Wall-clock reads at least don't go BACKWARDS (modulo NTP
    // step backwards; we ignore that case for the test).
    var a: i64 = now_unix_ms();
    sleep_ms(2 as i64);
    var b: i64 = now_unix_ms();
    if (b < a) {
        return test.fail("now_unix_ms went backwards: " +
                    a.to_string() + " then " + b.to_string());
    }
    return test.pass();
}

function test_monotonic_ns_advances(): test.TestOutcome {
    var a: i64 = monotonic_ns();
    var b: i64 = monotonic_ns();
    if (b < a) {
        return test.fail("monotonic_ns went backwards");
    }
    return test.pass();
}

function test_sleep_actually_sleeps(): test.TestOutcome {
    // Sleeping for 5ms should elapse at least 4ms of wall time.
    // We probe both `now_unix_ms` (might step under NTP, but
    // typical CI is steady) and `monotonic_ns` (guaranteed
    // forward).
    var start_ns: i64 = monotonic_ns();
    sleep_ms(5 as i64);
    var elapsed_ms: i64 = (monotonic_ns() - start_ns) / (1000000 as i64);
    if (elapsed_ms < (4 as i64)) {
        return test.fail("sleep_ms(5) only elapsed " + elapsed_ms.to_string() + "ms");
    }
    return test.pass();
}

function test_assert_elapsed_lt_ms_pass(): test.TestOutcome {
    var start: i64 = monotonic_ns();
    // Trivial work — must complete in < 100ms on any sane host.
    var sum: i32 = 0;
    var i: i32 = 0;
    while (i < 1000) { sum = sum + i; i = i + 1; }
    return test.assert_elapsed_lt_ms(start, 100 as i64);
}

function test_assert_elapsed_lt_ms_fail_message(): test.TestOutcome {
    var start: i64 = monotonic_ns();
    sleep_ms(10 as i64);
    // Deadline of 1ms — guaranteed to miss after a 10ms sleep.
    match (test.assert_elapsed_lt_ms(start, 1 as i64)) {
        Fail(msg) => {
            if (!msg.contains("ms elapsed")) {
                return test.fail("missing `ms elapsed` in: " + msg);
            }
            if (!msg.contains("expected < 1ms")) {
                return test.fail("missing expected bound in: " + msg);
            }
            return test.pass();
        },
        Pass => { return test.fail("expected elapsed-bound to fail"); }
    }
    return test.pass();
}

function test_negative_sleep_is_immediate(): test.TestOutcome {
    var start: i64 = monotonic_ns();
    sleep_ms(0 - 5 as i64);
    return test.assert_elapsed_lt_ms(start, 50 as i64);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("timing");
    r = r.it("now_unix_ms advances",                test_now_unix_ms_advances);
    r = r.it("monotonic_ns is non-decreasing",      test_monotonic_ns_advances);
    r = r.it("sleep_ms actually sleeps",            test_sleep_actually_sleeps);
    r = r.it("assert_elapsed_lt_ms pass",           test_assert_elapsed_lt_ms_pass);
    r = r.it("elapsed failure embeds context",      test_assert_elapsed_lt_ms_fail_message);
    r = r.it("negative sleep returns immediately",  test_negative_sleep_is_immediate);
    return r.finish();
}
