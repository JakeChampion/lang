// examples/tests/sorted_unique_range_test.fern — exercises
// the batch-19 additions to std/test:
//   * `assert_in_range_f64(v, lo, hi)` — inclusive float
//     range. NaN always fails.
//   * `assert_sorted_asc_i32(arr)` /
//     `assert_sorted_asc_string(arr)` — monotonically
//     non-decreasing order. Empty / single-element arrays
//     are vacuously sorted.
//   * `assert_unique_i32(arr)` / `assert_unique_string(arr)`
//     — every element appears at most once.

function test_in_range_f64_pass(): Option[string] {
    return assert_in_range_f64(2.5, 1.0, 3.0);
}

function test_in_range_f64_inclusive_lo(): Option[string] {
    return assert_in_range_f64(1.0, 1.0, 3.0);
}

function test_in_range_f64_inclusive_hi(): Option[string] {
    return assert_in_range_f64(3.0, 1.0, 3.0);
}

function test_in_range_f64_below(): Option[string] {
    match (assert_in_range_f64(0.5, 1.0, 3.0)) {
        None => { return fail("expected below-range fail"); },
        Some(msg) => {
            // Verify the diagnostic names the offending side.
            if (!msg.contains("lower bound")) {
                return Some("expected 'lower bound' in failure: " + msg);
            }
            return None;
        }
    }
}

function test_in_range_f64_above(): Option[string] {
    match (assert_in_range_f64(3.5, 1.0, 3.0)) {
        None => { return fail("expected above-range fail"); },
        Some(msg) => {
            if (!msg.contains("upper bound")) {
                return Some("expected 'upper bound' in failure: " + msg);
            }
            return None;
        }
    }
}

function test_in_range_f64_nan_fails(): Option[string] {
    var z: f64 = 0.0;
    var nan: f64 = z / z;
    match (assert_in_range_f64(nan, 0.0, 1.0)) {
        None => { return fail("NaN should fail range check"); },
        Some(_) => { return None; }
    }
}

function test_sorted_i32_pass(): Option[string] {
    return assert_sorted_asc_i32([1, 2, 3, 5, 8]);
}

function test_sorted_i32_empty(): Option[string] {
    var empty: i32[] = [];
    return assert_sorted_asc_i32(empty);
}

function test_sorted_i32_single(): Option[string] {
    return assert_sorted_asc_i32([42]);
}

function test_sorted_i32_equal_runs(): Option[string] {
    // Non-decreasing — equal adjacent pairs are OK.
    return assert_sorted_asc_i32([1, 1, 2, 2, 3]);
}

function test_sorted_i32_inversion(): Option[string] {
    match (assert_sorted_asc_i32([1, 3, 2, 4])) {
        None => { return fail("inversion missed"); },
        Some(msg) => {
            // The diagnostic should embed the index so the
            // first violation is locatable.
            if (!msg.contains("index 2")) {
                return Some("expected 'index 2': " + msg);
            }
            return None;
        }
    }
}

function test_sorted_string_pass(): Option[string] {
    return assert_sorted_asc_string(["alpha", "beta", "gamma"]);
}

function test_sorted_string_inversion(): Option[string] {
    match (assert_sorted_asc_string(["b", "a"])) {
        None => { return fail("inversion missed"); },
        Some(_) => { return None; }
    }
}

function test_unique_i32_pass(): Option[string] {
    return assert_unique_i32([1, 2, 3, 5, 8]);
}

function test_unique_i32_unsorted_input(): Option[string] {
    // Uniqueness is order-independent — the helper sorts
    // internally, so a scrambled input still works.
    return assert_unique_i32([7, 2, 9, 4]);
}

function test_unique_i32_duplicate_fails(): Option[string] {
    match (assert_unique_i32([1, 2, 3, 2, 5])) {
        None => { return fail("duplicate 2 should fail"); },
        Some(msg) => {
            if (!msg.contains("2")) {
                return Some("expected duplicate value in failure: " + msg);
            }
            return None;
        }
    }
}

function test_unique_string_pass(): Option[string] {
    return assert_unique_string(["alpha", "beta", "gamma"]);
}

function test_unique_string_duplicate_fails(): Option[string] {
    match (assert_unique_string(["alpha", "beta", "alpha"])) {
        None => { return fail("duplicate alpha should fail"); },
        Some(msg) => {
            if (!msg.contains("alpha")) {
                return Some("expected 'alpha' in failure: " + msg);
            }
            return None;
        }
    }
}

function test_unique_empty_is_vacuous(): Option[string] {
    var empty: i32[] = [];
    return assert_unique_i32(empty);
}

function main(): i32 {
    var r: TestRunner = test_new("sorted / unique / range");
    r = r.it("in_range_f64 pass",                test_in_range_f64_pass());
    r = r.it("in_range_f64 inclusive lo",        test_in_range_f64_inclusive_lo());
    r = r.it("in_range_f64 inclusive hi",        test_in_range_f64_inclusive_hi());
    r = r.it("in_range_f64 below names bound",   test_in_range_f64_below());
    r = r.it("in_range_f64 above names bound",   test_in_range_f64_above());
    r = r.it("in_range_f64 NaN fails",           test_in_range_f64_nan_fails());
    r = r.it("sorted_asc_i32 pass",              test_sorted_i32_pass());
    r = r.it("sorted_asc_i32 empty vacuous",     test_sorted_i32_empty());
    r = r.it("sorted_asc_i32 single vacuous",    test_sorted_i32_single());
    r = r.it("sorted_asc_i32 equal runs ok",     test_sorted_i32_equal_runs());
    r = r.it("sorted_asc_i32 inversion + index", test_sorted_i32_inversion());
    r = r.it("sorted_asc_string pass",           test_sorted_string_pass());
    r = r.it("sorted_asc_string inversion",      test_sorted_string_inversion());
    r = r.it("unique_i32 pass",                  test_unique_i32_pass());
    r = r.it("unique_i32 unsorted input",        test_unique_i32_unsorted_input());
    r = r.it("unique_i32 duplicate fails",       test_unique_i32_duplicate_fails());
    r = r.it("unique_string pass",               test_unique_string_pass());
    r = r.it("unique_string duplicate fails",    test_unique_string_duplicate_fails());
    r = r.it("unique empty vacuous",             test_unique_empty_is_vacuous());
    return r.finish();
}
