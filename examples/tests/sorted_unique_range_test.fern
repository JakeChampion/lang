import "std/test";
// examples/tests/sorted_unique_range_test.fern — exercises
// the batch-19 additions to std/test:
//   * `test.assert_in_range_f64(v, lo, hi)` — inclusive float
//     range. NaN always fails.
//   * `test.assert_sorted_asc(arr)` /
//     `test.assert_sorted_asc(arr)` — monotonically
//     non-decreasing order. Empty / single-element arrays
//     are vacuously sorted.
//   * `test.assert_unique(arr)` / `test.assert_unique(arr)`
//     — every element appears at most once.

function test_in_range_f64_pass(): test.TestOutcome {
    return test.assert_in_range_f64(2.5, 1.0, 3.0);
}

function test_in_range_f64_inclusive_lo(): test.TestOutcome {
    return test.assert_in_range_f64(1.0, 1.0, 3.0);
}

function test_in_range_f64_inclusive_hi(): test.TestOutcome {
    return test.assert_in_range_f64(3.0, 1.0, 3.0);
}

function test_in_range_f64_below(): test.TestOutcome {
    match (test.assert_in_range_f64(0.5, 1.0, 3.0)) {
        Pass => { return test.fail("expected below-range fail"); },
        Fail(msg) => {
            // Verify the diagnostic names the offending side.
            if (!msg.contains("lower bound")) {
                return test.fail("expected 'lower bound' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_in_range_f64_above(): test.TestOutcome {
    match (test.assert_in_range_f64(3.5, 1.0, 3.0)) {
        Pass => { return test.fail("expected above-range fail"); },
        Fail(msg) => {
            if (!msg.contains("upper bound")) {
                return test.fail("expected 'upper bound' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_in_range_f64_nan_fails(): test.TestOutcome {
    var z: f64 = 0.0;
    var nan: f64 = z / z;
    match (test.assert_in_range_f64(nan, 0.0, 1.0)) {
        Pass => { return test.fail("NaN should fail range check"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_sorted_i32_pass(): test.TestOutcome {
    return test.assert_sorted_asc([1, 2, 3, 5, 8]);
}

function test_sorted_i32_empty(): test.TestOutcome {
    var empty: i32[] = [];
    return test.assert_sorted_asc(empty);
}

function test_sorted_i32_single(): test.TestOutcome {
    return test.assert_sorted_asc([42]);
}

function test_sorted_i32_equal_runs(): test.TestOutcome {
    // Non-decreasing — equal adjacent pairs are OK.
    return test.assert_sorted_asc([1, 1, 2, 2, 3]);
}

function test_sorted_i32_inversion(): test.TestOutcome {
    match (test.assert_sorted_asc([1, 3, 2, 4])) {
        Pass => { return test.fail("inversion missed"); },
        Fail(msg) => {
            // The diagnostic should embed the index so the
            // first violation is locatable.
            if (!msg.contains("index 2")) {
                return test.fail("expected 'index 2': " + msg);
            }
            return test.pass();
        }
    }
}

function test_sorted_string_pass(): test.TestOutcome {
    return test.assert_sorted_asc(["alpha", "beta", "gamma"]);
}

function test_sorted_string_inversion(): test.TestOutcome {
    match (test.assert_sorted_asc(["b", "a"])) {
        Pass => { return test.fail("inversion missed"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_unique_i32_pass(): test.TestOutcome {
    return test.assert_unique([1, 2, 3, 5, 8]);
}

function test_unique_i32_unsorted_input(): test.TestOutcome {
    // Uniqueness is order-independent — the helper sorts
    // internally, so a scrambled input still works.
    return test.assert_unique([7, 2, 9, 4]);
}

function test_unique_i32_duplicate_fails(): test.TestOutcome {
    match (test.assert_unique([1, 2, 3, 2, 5])) {
        Pass => { return test.fail("duplicate 2 should fail"); },
        Fail(msg) => {
            if (!msg.contains("2")) {
                return test.fail("expected duplicate value in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_unique_string_pass(): test.TestOutcome {
    return test.assert_unique(["alpha", "beta", "gamma"]);
}

function test_unique_string_duplicate_fails(): test.TestOutcome {
    match (test.assert_unique(["alpha", "beta", "alpha"])) {
        Pass => { return test.fail("duplicate alpha should fail"); },
        Fail(msg) => {
            if (!msg.contains("alpha")) {
                return test.fail("expected 'alpha' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_unique_empty_is_vacuous(): test.TestOutcome {
    var empty: i32[] = [];
    return test.assert_unique(empty);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("sorted / unique / range");
    r = r.it("in_range_f64 pass",                test_in_range_f64_pass);
    r = r.it("in_range_f64 inclusive lo",        test_in_range_f64_inclusive_lo);
    r = r.it("in_range_f64 inclusive hi",        test_in_range_f64_inclusive_hi);
    r = r.it("in_range_f64 below names bound",   test_in_range_f64_below);
    r = r.it("in_range_f64 above names bound",   test_in_range_f64_above);
    r = r.it("in_range_f64 NaN fails",           test_in_range_f64_nan_fails);
    r = r.it("sorted_asc_i32 pass",              test_sorted_i32_pass);
    r = r.it("sorted_asc_i32 empty vacuous",     test_sorted_i32_empty);
    r = r.it("sorted_asc_i32 single vacuous",    test_sorted_i32_single);
    r = r.it("sorted_asc_i32 equal runs ok",     test_sorted_i32_equal_runs);
    r = r.it("sorted_asc_i32 inversion + index", test_sorted_i32_inversion);
    r = r.it("sorted_asc_string pass",           test_sorted_string_pass);
    r = r.it("sorted_asc_string inversion",      test_sorted_string_inversion);
    r = r.it("unique_i32 pass",                  test_unique_i32_pass);
    r = r.it("unique_i32 unsorted input",        test_unique_i32_unsorted_input);
    r = r.it("unique_i32 duplicate fails",       test_unique_i32_duplicate_fails);
    r = r.it("unique_string pass",               test_unique_string_pass);
    r = r.it("unique_string duplicate fails",    test_unique_string_duplicate_fails);
    r = r.it("unique empty vacuous",             test_unique_empty_is_vacuous);
    return r.finish();
}
