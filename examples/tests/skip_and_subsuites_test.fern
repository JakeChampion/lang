import "std/test";
// examples/tests/skip_and_subsuites_test.fern — exercise the
// skip / skip_if / subsuite / merge surface added on top of
// the std/test base.
//
// The runner is single-threaded and value-semantic, so a
// subsuite is just a child test.TestRunner with the parent's
// prefix + running count threaded through. The parent
// `merge`s the child back when its cases are done. Skipped
// cases print as `ok N - name # SKIP reason` per TAP-13 and
// don't affect the exit code.

function test_pass(): test.TestOutcome { return test.assert_eq(1, 1); }

function test_addition(): test.TestOutcome { return test.assert_eq(2 + 2, 4); }
function test_subtraction(): test.TestOutcome { return test.assert_eq(10 - 3, 7); }

function test_to_upper(): test.TestOutcome {
    return test.assert_eq("hello".to_upper(), "HELLO");
}
function test_to_lower(): test.TestOutcome {
    return test.assert_eq("HELLO".to_lower(), "hello");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("skip-and-subsuites");

    // A top-level case before any subsuite — sanity check that
    // the parent's numbering starts at 1.
    r = r.it("top-level pass", test_pass);

    // Unconditional skip — toolchain missing, OS-conditional.
    r = r.skip("wasmtime-only", "wasmtime not on $PATH");

    // skip_if — the cond is true so the test doesn't run.
    r = r.skip_if(true, "ci-only", "not running under CI", test_pass);

    // skip_if — the cond is false so the test runs normally.
    r = r.skip_if(false, "always-runs", "(unused reason)", test_pass);

    // Subsuite: nested grouping. Cases print with the
    // "arithmetic / " prefix; the bottom-of-stream summary
    // shows the prefixed names.
    var arith: test.TestRunner = r.subsuite("arithmetic");
    arith = arith.it("addition", test_addition);
    arith = arith.it("subtraction", test_subtraction);
    arith = arith.skip("multiplication", "out of scope for this slice");
    r = r.merge(arith);

    // Two subsuites can be opened consecutively as long as
    // each is merged back before the next sibling case runs.
    var str: test.TestRunner = r.subsuite("strings");
    str = str.it("to_upper", test_to_upper);
    str = str.it("to_lower", test_to_lower);
    r = r.merge(str);

    // Another top-level case after the subsuites — numbering
    // continues from where the last subsuite finished.
    r = r.it("trailing top-level", test_pass);

    return r.finish();
}
