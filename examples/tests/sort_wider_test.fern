import "core/cmp";
import "std/test";

// examples/tests/sort_wider_test.fern — exercises core/cmp's generic
// `sort` / `sort_desc` over the wider integer widths (i64, u32, u64),
// the width-specific coverage that the retired per-width `sort_i64_asc`
// / `sort_i64_desc` / `sort_u32_asc` / `sort_u64_asc` zoo used to carry
// (#5397). The `T: Ord` monomorphisation must still pick the UNSIGNED
// compare for u32 / u64 (a near-u64-max sentinel sorts LAST, not first)
// and the full-width signed compare for i64.
function test_i64_asc(): test.TestOutcome {
  var arr: i64[] = [3 as i64, 1 as i64, 4 as i64, 1 as i64, 5 as i64, 9 as i64, 2 as i64, 6 as i64];
  var sorted: i64[] = cmp.sort(arr);
  var i: i32 = 1;
  while (i < sorted.len()) {
    if (sorted[i] < sorted[i - 1]) {
      return test.fail("not sorted at " + i.to_string() + ": " + sorted[i - 1].to_string() + " > " + sorted[i].to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_i64_desc(): test.TestOutcome {
  var arr: i64[] = [1 as i64, 5 as i64, 2 as i64, 9 as i64, 3 as i64];
  var sorted: i64[] = cmp.sort_desc(arr);
  var i: i32 = 1;
  while (i < sorted.len()) {
    if (sorted[i] > sorted[i - 1]) {
      return test.fail("not descending at " + i.to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_u32_asc(): test.TestOutcome {
  var arr: u32[] = [3u32, 1u32, 4u32, 1u32, 5u32];
  var sorted: u32[] = cmp.sort(arr);
  var i: i32 = 1;
  while (i < sorted.len()) {
    if (sorted[i] < sorted[i - 1]) {
      return test.fail("u32 sort wrong at " + i.to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_u64_asc_with_large_values(): test.TestOutcome {
  // Use values near u64-max to make sure unsigned compare
  // (not sign-extended i64) is what drives the order.
  var arr: u64[] = [-1u64, 0u64, 1u64];
  var sorted: u64[] = cmp.sort(arr);
  return test.assert_eq(sorted[0], 0u64);
}

function test_i64_asc_large(): test.TestOutcome {
  // 100 descending elements — crosses several merge widths
  // (1,2,4,...,64), unlike the short literal arrays above.
  var arr: i64[] = [];
  var i: i32 = 0;
  while (i < 100) {
    arr = arr.append((100 - i) as i64);
    i = i + 1;
  }
  var sorted: i64[] = cmp.sort(arr);
  if (sorted.len() != 100) {
    return test.fail("length changed: " + sorted.len().to_string());
  }
  i = 0;
  while (i < 100) {
    if (sorted[i] != (i + 1) as i64) {
      return test.fail("wrong value at " + i.to_string() + ": " + sorted[i].to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_i64_desc_large(): test.TestOutcome {
  // Ascending input, descending sort — the desc body is its own copy,
  // so it needs its own multi-width case.
  var arr: i64[] = [];
  var i: i32 = 0;
  while (i < 100) {
    arr = arr.append((i + 1) as i64);
    i = i + 1;
  }
  var sorted: i64[] = cmp.sort_desc(arr);
  i = 0;
  while (i < 100) {
    if (sorted[i] != (100 - i) as i64) {
      return test.fail("desc wrong at " + i.to_string() + ": " + sorted[i].to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_u32_asc_large(): test.TestOutcome {
  // 96 elements from a deterministic stride pattern, crossing merge
  // widths 1..64 with duplicates (values mod 37).
  var arr: u32[] = [];
  var i: i32 = 0;
  while (i < 96) {
    arr = arr.append(((i * 61) % 37) as u32);
    i = i + 1;
  }
  var sorted: u32[] = cmp.sort(arr);
  if (sorted.len() != 96) {
    return test.fail("length changed: " + sorted.len().to_string());
  }
  i = 1;
  while (i < 96) {
    if (sorted[i] < sorted[i - 1]) {
      return test.fail("u32 large not sorted at " + i.to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_u64_asc_large(): test.TestOutcome {
  // 80 elements, descending with a near-u64-max sentinel mixed in so
  // unsigned compare drives the multi-width merges too.
  var arr: u64[] = [];
  var i: i32 = 0;
  while (i < 79) {
    arr = arr.append((79 - i) as u64);
    i = i + 1;
  }
  arr = arr.append(-1u64);
  var sorted: u64[] = cmp.sort(arr);
  if (sorted.len() != 80) {
    return test.fail("length changed: " + sorted.len().to_string());
  }
  i = 1;
  while (i < 80) {
    if (sorted[i] < sorted[i - 1]) {
      return test.fail("u64 large not sorted at " + i.to_string());
    }
    i = i + 1;
  }
  if (sorted[0] != 1u64) {
    return test.fail("u64 smallest wrong");
  }
  if (sorted[79] != -1u64) {
    return test.fail("u64 max sentinel not last");
  }
  return test.pass();
}

function test_i64_empty(): test.TestOutcome {
  var arr: i64[] = [];
  var sorted: i64[] = cmp.sort(arr);
  if (sorted.len() != 0) {
    return test.fail("empty sort grew: " + sorted.len().to_string());
  }
  return test.pass();
}

function test_i64_single(): test.TestOutcome {
  var arr: i64[] = [42 as i64];
  var sorted: i64[] = cmp.sort(arr);
  return test.assert_eq(sorted[0], 42 as i64);
}

function main(): i32 {
  var r: test.TestRunner = test.test_new("wider sorts");
  r = r.it("sort_i64_asc", test_i64_asc);
  r = r.it("sort_i64_desc", test_i64_desc);
  r = r.it("sort_u32_asc", test_u32_asc);
  r = r.it("sort_u64_asc near u64-max", test_u64_asc_with_large_values);
  r = r.it("sort_i64_asc 100 elements", test_i64_asc_large);
  r = r.it("sort_i64_desc 100 elements", test_i64_desc_large);
  r = r.it("sort_u32_asc 96 elements", test_u32_asc_large);
  r = r.it("sort_u64_asc 80 elements", test_u64_asc_large);
  r = r.it("sort_i64_asc empty input", test_i64_empty);
  r = r.it("sort_i64_asc singleton", test_i64_single);
  return r.finish();
}
