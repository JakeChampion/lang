import "std/test";
import "std/url" as url;
import "core/map";
// examples/tests/url_test.fern — pure-Fern coverage of std/url's
// RFC 3986 percent-encoding (url_encode / url_decode) and the
// best-effort url_parse decomposition. Covers unreserved pass-through,
// reserved-char escaping, case-insensitive + truncated decode, a
// round-trip, and url_parse's scheme/host/port/path/query/fragment
// split (plus the empty-input None). The Go-side suite unit-tests the
// prelude origin; this is the migration-shaped (pure-Fern) companion.

function test_encode_space(): test.TestOutcome {
    return test.assert_eq(url.url_encode("a b"), "a%20b");
}

function test_encode_unreserved(): test.TestOutcome {
    // A-Z a-z 0-9 and - . _ ~ pass through untouched.
    return test.assert_eq(url.url_encode("aZ9-._~"), "aZ9-._~");
}

function test_encode_reserved(): test.TestOutcome {
    // '/'=%2F '?'=%3F '&'=%26 '='=%3D (uppercase hex).
    return test.assert_eq(url.url_encode("/?&="), "%2F%3F%26%3D");
}

function test_decode_space(): test.TestOutcome {
    return test.assert_eq(url.url_decode("a%20b"), "a b");
}

function test_decode_lowercase_hex(): test.TestOutcome {
    // Decode accepts lower-case hex digits.
    return test.assert_eq(url.url_decode("%2f"), "/");
}

function test_decode_truncated(): test.TestOutcome {
    // A truncated escape at end-of-string is left literal.
    return test.assert_eq(url.url_decode("%2"), "%2");
}

function test_roundtrip(): test.TestOutcome {
    return test.assert_eq(url.url_decode(url.url_encode("a b/c?d=e&f")), "a b/c?d=e&f");
}

function test_parse_full(): test.TestOutcome {
    match (url.url_parse("http://example.com:8080/path?q=1#frag")) {
        Some(u) => {
            return test.assert_true(u.scheme == "http" && u.host == "example.com"
                && u.port == 8080 && u.path == "/path" && u.query == "q=1"
                && u.fragment == "frag");
        },
        None => { return test.fail("url_parse(full) expected Some"); }
    }
}

function test_parse_minimal(): test.TestOutcome {
    match (url.url_parse("https://host.com/")) {
        Some(u) => {
            return test.assert_true(u.scheme == "https" && u.host == "host.com"
                && u.port == 0 && u.path == "/" && u.query == "" && u.fragment == "");
        },
        None => { return test.fail("url_parse(minimal) expected Some"); }
    }
}

function test_parse_empty(): test.TestOutcome {
    match (url.url_parse("")) {
        Some(u) => { return test.fail("url_parse(\"\") expected None"); },
        None => { return test.pass(); }
    }
}

// ---- application/x-www-form-urlencoded (#4384 item 5) ----

// form_decode maps '+' to a space and still handles %-escapes.
function test_form_decode_plus(): test.TestOutcome {
    return test.assert_eq(url.form_decode("a+b%20c"), "a b c");
}

// The RFC-3986 url_decode leaves '+' literal — the contrast that
// makes form_decode necessary for query/form bodies.
function test_url_decode_keeps_plus(): test.TestOutcome {
    return test.assert_eq(url.url_decode("a+b"), "a+b");
}

// form_encode maps a space to '+' (not %20) and %-escapes the rest.
function test_form_encode_space(): test.TestOutcome {
    return test.assert_eq(url.form_encode("a b/c"), "a+b%2Fc");
}

// form_encode / form_decode round-trip.
function test_form_roundtrip(): test.TestOutcome {
    return test.assert_eq(url.form_decode(url.form_encode("hello world & q=1")),
        "hello world & q=1");
}

// query_encode builds a deterministic ordered query string,
// form-encoding each key/value.
function test_query_encode(): test.TestOutcome {
    var pairs: (string, string)[] = [("q", "a b"), ("n", "1")];
    return test.assert_eq(url.query_encode(pairs), "q=a+b&n=1");
}

// query_encode edges — locks in the byte-identical output of the
// two-pass preallocated-buffer rewrite (#4379): several pairs so the
// `&` separators exercise the growing path, a reserved byte that
// %-escapes (`&` → %26), multi-byte UTF-8 (é → %C3%A9), and empty
// keys/values.
function test_query_encode_edges(): test.TestOutcome {
    var many: (string, string)[] = [("k1", "v1"), ("k2", "v&2"), ("k3", "café")];
    var empties: (string, string)[] = [("", ""), ("x", "")];
    return test.assert_true(
        url.query_encode(many) == "k1=v1&k2=v%262&k3=caf%C3%A9"
        && url.query_encode(empties) == "=&x="
        && url.query_encode([("only", "one value")]) == "only=one+value");
}

// query_parse now form-decodes, so a '+' value is a space.
function test_query_parse_plus(): test.TestOutcome {
    var m: Map[string, string[]] = url.query_parse("q=a+b");
    match (m.get("q")) {
        Some(arr) => { return test.assert_eq(arr[0], "a b"); },
        None => { return test.fail("expected key q"); }
    }
}

// Single-key query accessors: query_get first-value / None / bare-flag,
// with form-decoding of both key and value.
function test_query_get(): test.TestOutcome {
    match (url.query_get("a=1&b=2", "b")) {
        Some(v) => { if (v != "2") { return test.fail("b=2"); } },
        None => { return test.fail("expected b"); }
    }
    // Repeated key → the first value; bare flag → Some("").
    match (url.query_get("a=1&a=2", "a")) {
        Some(v) => { if (v != "1") { return test.fail("first a"); } },
        None => { return test.fail("expected a"); }
    }
    // %20 in key, + in value both decode.
    match (url.query_get("a%20b=c+d", "a b")) {
        Some(v) => { return test.assert_eq(v, "c d"); },
        None => { return test.fail("expected decoded key"); }
    }
}

function test_query_get_missing(): test.TestOutcome {
    // A missing key and an empty query both yield None.
    match (url.query_get("a=1", "z")) {
        Some(v) => { return test.fail("unexpected value"); },
        None => {}
    }
    match (url.query_get("", "a")) {
        Some(v) => { return test.fail("empty query has no keys"); },
        None => { return test.pass(); }
    }
}

function test_query_has_and_all(): test.TestOutcome {
    if (!url.query_has("a=1&b=2", "b") || url.query_has("a=1", "z")) { return test.fail("has"); }
    // get_all preserves order across repeated keys.
    var all: string[] = url.query_get_all("a=1&b=2&a=3", "a");
    if (all.len() != 2 || all[0] != "1" || all[1] != "3") { return test.fail("get_all order"); }
    return test.assert_eq(url.query_get_all("a=1", "z").len(), 0);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/url");
    r = r.it("encode space",            test_encode_space());
    r = r.it("encode unreserved",       test_encode_unreserved());
    r = r.it("encode reserved",         test_encode_reserved());
    r = r.it("decode space",            test_decode_space());
    r = r.it("decode lowercase hex",    test_decode_lowercase_hex());
    r = r.it("decode truncated escape", test_decode_truncated());
    r = r.it("round-trip",              test_roundtrip());
    r = r.it("parse full URL",          test_parse_full());
    r = r.it("parse minimal URL",       test_parse_minimal());
    r = r.it("parse empty is None",     test_parse_empty());
    r = r.it("form_decode plus",        test_form_decode_plus());
    r = r.it("url_decode keeps plus",   test_url_decode_keeps_plus());
    r = r.it("form_encode space",       test_form_encode_space());
    r = r.it("form round-trip",         test_form_roundtrip());
    r = r.it("query_encode",            test_query_encode());
    r = r.it("query_encode edges",      test_query_encode_edges());
    r = r.it("query_parse plus",        test_query_parse_plus());
    r = r.it("query_get",               test_query_get());
    r = r.it("query_get missing",       test_query_get_missing());
    r = r.it("query_has + get_all",     test_query_has_and_all());
    return r.finish();
}
