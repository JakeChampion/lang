import "std/test";
import "core/cmp" as cmp;
// examples/tests/cmp_helpers_test.fern — pure-Fern coverage of core/cmp's
// generic free helpers over the primitive `Ord` / `Eq` impls: min / max /
// clamp / lt / gte / sort / is_sorted (Ord) and contains / index_of /
// distinct / eq_arrays (Eq). `derive_test.fern` covers `@derive`; this covers
// the free functions, driven through the std/test runner (migration-shaped).

function test_min(): test.TestOutcome { return test.assert_eq(cmp.min(8, 3), 3); }
function test_max(): test.TestOutcome { return test.assert_eq(cmp.max(8, 3), 8); }
function test_clamp_hi(): test.TestOutcome { return test.assert_eq(cmp.clamp(15, 0, 10), 10); }
function test_clamp_lo(): test.TestOutcome { return test.assert_eq(cmp.clamp(0 - 4, 0, 10), 0); }
function test_clamp_in(): test.TestOutcome { return test.assert_eq(cmp.clamp(5, 0, 10), 5); }

function test_lt(): test.TestOutcome { return test.assert_true(cmp.lt(2, 9)); }
function test_gte(): test.TestOutcome { return test.assert_true(cmp.gte(9, 9)); }
function test_lt_false(): test.TestOutcome { return test.assert_false(cmp.lt(9, 2)); }

function test_sort(): test.TestOutcome {
    var s = cmp.sort([3, 1, 2]);
    return test.assert_true(s[0] == 1 && s[1] == 2 && s[2] == 3);
}

function test_is_sorted(): test.TestOutcome { return test.assert_true(cmp.is_sorted([1, 2, 3])); }
function test_is_sorted_false(): test.TestOutcome { return test.assert_false(cmp.is_sorted([3, 1])); }

function test_contains(): test.TestOutcome { return test.assert_true(cmp.contains([10, 20, 30], 20)); }
function test_index_of(): test.TestOutcome {
    match (cmp.index_of([10, 20, 30], 20)) {
        Some(i) => { return test.assert_eq(i, 1); },
        None => { return test.fail("index_of expected Some(1), got None"); }
    }
}
function test_index_of_absent(): test.TestOutcome {
    match (cmp.index_of([10, 20, 30], 99)) {
        Some(i) => { return test.fail("index_of expected None for absent value"); },
        None => { return test.assert_true(true); }
    }
}

function test_distinct(): test.TestOutcome {
    var d = cmp.distinct([1, 1, 2, 3, 3, 3]);
    return test.assert_true(d.len() == 3 && d[0] == 1 && d[1] == 2 && d[2] == 3);
}

function test_eq_arrays(): test.TestOutcome { return test.assert_true(cmp.eq_arrays([1, 2], [1, 2])); }
function test_eq_arrays_false(): test.TestOutcome { return test.assert_false(cmp.eq_arrays([1, 2], [1])); }

// String works too (lexicographic Ord + Eq).
function test_string_sort(): test.TestOutcome {
    var s = cmp.sort(["b", "a", "c"]);
    return test.assert_true(s[0] == "a" && s[2] == "c");
}

// Debug for string escapes the ASCII specials and passes multibyte
// content through byte-exact.
function test_string_debug_multibyte(): test.TestOutcome {
    var s: string = "a\"é\nb";
    return test.assert_eq(s.to_debug(), "\"a\\\"é\\nb\"");
}

// Floats: `Ord` is IEEE 754 totalOrder and `Eq` is bit equality, so every NaN
// and both signed zeros have one place. The NaNs come from `from_bits` because
// an arithmetic NaN's sign is target-dependent.
function pos_nan(): f64 { return f64_from_bits(9221120237041090560 as i64); }                    // 0x7FF8000000000000
function neg_nan(): f64 { return f64_from_bits(0 - 2251799813685248 as i64); }                   // 0xFFF8000000000000
function neg_zero(): f64 { return f64_from_bits((0 - 9223372036854775807 as i64) - 1 as i64); } // 0x8000000000000000
function pos_inf(): f64 { return 1.0 / 0.0; }
function total_order(): f64[] {
    return [neg_nan(), 0.0 - pos_inf(), neg_zero(), 0.0, 1.0, 3.0, pos_inf(), pos_nan()];
}
function shuffled(): f64[] {
    return [3.0, pos_nan(), 0.0, 0.0 - pos_inf(), 1.0, pos_inf(), neg_nan(), neg_zero()];
}

function test_f64_sort_total_order(): test.TestOutcome {
    return test.assert_true(cmp.eq_arrays(cmp.sort(shuffled()), total_order()));
}
function test_f64_sort_desc_total_order(): test.TestOutcome {
    var want: f64[] = [pos_nan(), pos_inf(), 3.0, 1.0, 0.0, neg_zero(), 0.0 - pos_inf(), neg_nan()];
    return test.assert_true(cmp.eq_arrays(cmp.sort_desc(shuffled()), want));
}
function test_f64_is_sorted_nan(): test.TestOutcome {
    if (!cmp.is_sorted(total_order())) { return test.fail("the total order is sorted"); }
    return test.assert_false(cmp.is_sorted([3.0, pos_nan(), 1.0]));
}
function test_f64_nan_extremes(): test.TestOutcome {
    var hi: f64 = cmp.max(pos_inf(), pos_nan());
    var lo: f64 = cmp.min(0.0 - pos_inf(), neg_nan());
    if (!hi.eq(pos_nan())) { return test.fail("+NaN is above +inf"); }
    if (!lo.eq(neg_nan())) { return test.fail("-NaN is below -inf"); }
    return test.assert_eq(pos_nan().cmp(neg_nan()), 1);
}
function test_f64_signed_zero(): test.TestOutcome {
    var z: f64 = 0.0;
    var nz: f64 = neg_zero();
    if (nz.cmp(z) != 0 - 1) { return test.fail("-0.0 is below +0.0"); }
    if (nz.eq(z)) { return test.fail("-0.0 is not +0.0 under Eq"); }
    return test.assert_true(f64_bits(cmp.min(z, nz)) != 0 as i64);
}
function test_f64_nan_eq(): test.TestOutcome {
    if (!cmp.contains([1.0, pos_nan()], pos_nan())) { return test.fail("contains finds NaN"); }
    if (cmp.distinct([pos_nan(), pos_nan(), neg_nan()]).len() != 2) { return test.fail("distinct keeps one NaN per sign"); }
    // NaNs of one sign order by payload and differ under Eq.
    var payload: f64 = f64_from_bits(9221120237041090561 as i64);
    if (payload.eq(pos_nan())) { return test.fail("payload NaN is not the quiet NaN"); }
    return test.assert_eq(pos_nan().cmp(payload), 0 - 1);
}

function pos_nan32(): f32 { return f32_from_bits(2143289344); }             // 0x7FC00000
function neg_nan32(): f32 { return f32_from_bits(0 - 4194304); }            // 0xFFC00000
function neg_zero32(): f32 { return f32_from_bits((0 - 2147483647) - 1); }  // 0x80000000

function test_f32_sort_total_order(): test.TestOutcome {
    var one: f32 = 1.0 as f32;
    var zero: f32 = 0.0 as f32;
    var neg_one: f32 = (0.0 - 1.0) as f32;
    var xs: f32[] = [one, pos_nan32(), zero, neg_nan32(), neg_zero32(), neg_one];
    var want: f32[] = [neg_nan32(), neg_one, neg_zero32(), zero, one, pos_nan32()];
    if (!cmp.eq_arrays(cmp.sort(xs), want)) { return test.fail("f32 total order"); }
    var inverted: f32[] = [pos_nan32(), one];
    return test.assert_false(cmp.is_sorted(inverted));
}
function test_f32_nan_eq(): test.TestOutcome {
    var nans: f32[] = [pos_nan32(), pos_nan32()];
    if (cmp.distinct(nans).len() != 1) { return test.fail("distinct folds equal f32 NaNs"); }
    var zero: f32[] = [0.0 as f32];
    var nzero: f32[] = [neg_zero32()];
    return test.assert_false(cmp.eq_arrays(zero, nzero));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("core/cmp helpers");
    r = r.it("min",                 test_min);
    r = r.it("max",                 test_max);
    r = r.it("clamp above hi",      test_clamp_hi);
    r = r.it("clamp below lo",      test_clamp_lo);
    r = r.it("clamp in range",      test_clamp_in);
    r = r.it("lt",                  test_lt);
    r = r.it("gte",                 test_gte);
    r = r.it("lt false",            test_lt_false);
    r = r.it("sort",                test_sort);
    r = r.it("is_sorted",           test_is_sorted);
    r = r.it("is_sorted false",     test_is_sorted_false);
    r = r.it("contains",            test_contains);
    r = r.it("index_of",            test_index_of);
    r = r.it("index_of absent",     test_index_of_absent);
    r = r.it("distinct",            test_distinct);
    r = r.it("eq_arrays",           test_eq_arrays);
    r = r.it("eq_arrays false",     test_eq_arrays_false);
    r = r.it("string sort",         test_string_sort);
    r = r.it("string debug multibyte", test_string_debug_multibyte);
    r = r.it("f64 sort total order",      test_f64_sort_total_order);
    r = r.it("f64 sort_desc total order", test_f64_sort_desc_total_order);
    r = r.it("f64 is_sorted with NaN",    test_f64_is_sorted_nan);
    r = r.it("f64 NaN extremes",          test_f64_nan_extremes);
    r = r.it("f64 signed zero",           test_f64_signed_zero);
    r = r.it("f64 NaN eq",                test_f64_nan_eq);
    r = r.it("f32 sort total order",      test_f32_sort_total_order);
    r = r.it("f32 NaN eq",                test_f32_nan_eq);
    return r.finish();
}
