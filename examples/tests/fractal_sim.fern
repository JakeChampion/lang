import "std/sim";
import "std/sim_fetch";
import "std/sim_platform";
import "std/http";
import "std/http/router";
import "../fractal/server";

function main(): i32 {
  let d = sim.new(7);
  let plat = sim_platform.new(d, sim_fetch.new(d));
  let s = server.stats("sim", 0, 0, "sim-version");
  let r = server.routes[sim_platform.SimPlatform](s, "web", []);
  if (!tile_is_png(r.handle(http.request("GET", "/tile/sim-version/2/1/1"), plat))) {
    return 1;
  }
  if (r.handle(http.request("GET", "/tile/sim-version/2/4/0"), plat).status != 400 || r.handle(http.request("GET", "/tile/sim-version/43/0/0"), plat).status != 400) {
    return 2;
  }
  if (!r.handle(http.request("GET", "/api/stats"), plat).body_text_lossy().contains("\"tiles\":1,")) {
    return 3;
  }
  if (r.handle(http.request("GET", "/healthz"), plat).body_text_lossy() != "ok") {
    return 4;
  }
  if (r.handle(http.request("POST", "/tile/sim-version/2/1/1"), plat).status != 405) {
    return 5;
  }
  return 0;
}

function tile_is_png(resp: HttpResponse): boolean {
  let png = resp.body_bytes();
  if (resp.status != 200 || png.len() < 8) {
    return false;
  }
  if (png[1] != b'P' || png[2] != b'N' || png[3] != b'G') {
    return false;
  }
  return resp.headers.get("Server-Timing").unwrap_or("").starts_with("render;dur=");
}
