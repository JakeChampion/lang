import "std/test";
import "std/http";

// examples/tests/http_request_headers_migrated_test.fern —
// Fern port of `TestInterpScriptHttpRequestHeaders` from
// `internal/e2e/interp_script_test.go`. Pins the
// HeaderMap → HttpRequest wiring
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §2):
// `http_parse_request` populates `req.headers` from the
// wire header block; the handler reads values back via
// the case-insensitive `HeaderMap.get` surface.
//
// The Go original spawned three `fern -interp`
// subprocesses, each running an inline parse-and-print
// program. The migrated form folds them into one Fern
// file with assertions on the parsed shape directly —
// no subprocess, no print-then-grep.

function test_parsed_headers_reachable_on_req(): test.TestOutcome {
    var wire: string = "GET /x HTTP/1.1\r\nHost: example.com\r\nContent-Type: application/json\r\nContent-Length: 0\r\n\r\n";
    match (http.http_parse_request(wire)) {
        Some(req) => {
            // Case-insensitive get against "content-type"
            // (request had "Content-Type") returns the
            // value.
            return test.assert_is_some_eq_string(
                req.headers.get("content-type"),
                "application/json");
        },
        None => {
            return test.fail("parse failed on well-formed request");
        }
    }
    return test.fail("unreachable");
}

function test_parsed_header_count_is_3(): test.TestOutcome {
    var wire: string = "GET /x HTTP/1.1\r\nHost: example.com\r\nContent-Type: application/json\r\nContent-Length: 0\r\n\r\n";
    match (http.http_parse_request(wire)) {
        Some(req) => {
            // Three headers in the wire (Host, Content-
            // Type, Content-Length) → size() == 3.
            return test.assert_eq(req.headers.len(), 3);
        },
        None => { return test.fail("parse failed"); }
    }
    return test.fail("unreachable");
}

function test_duplicate_header_insertion_order(): test.TestOutcome {
    var wire: string = "GET / HTTP/1.1\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\nContent-Length: 0\r\n\r\n";
    match (http.http_parse_request(wire)) {
        Some(req) => {
            // Original verified via print-each + grep on
            // stdout; here we assert the array shape
            // directly so a divergence localises by
            // index.
            return test.assert_eq_array(
                req.headers.get_all("Set-Cookie"),
                ["a=1", "b=2"]);
        },
        None => { return test.fail("parse failed"); }
    }
    return test.fail("unreachable");
}

function test_missing_header_returns_none(): test.TestOutcome {
    var wire: string = "GET / HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n";
    match (http.http_parse_request(wire)) {
        Some(req) => {
            return test.assert_is_none_string(req.headers.get("X-Absent"));
        },
        None => { return test.fail("parse failed"); }
    }
    return test.fail("unreachable");
}

function test_get_all_on_missing_is_empty(): test.TestOutcome {
    var wire: string = "GET / HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n";
    match (http.http_parse_request(wire)) {
        Some(req) => {
            return test.assert_eq((req.headers.get_all("X-Absent")).len(), 0);
        },
        None => { return test.fail("parse failed"); }
    }
    return test.fail("unreachable");
}

// ---- request-smuggling / framing hardening (#4383) ----

// An `X-*-Content-Length` header must NOT be mistaken for the real
// Content-Length. The wire has no real CL, so the body is empty —
// the trailing bytes are not consumed as this request's body. (The
// old raw substring scan matched `X-Custom-Content-Length:` first
// and read a 5-byte body — the classic desync.)
function test_x_prefixed_cl_not_content_length(): test.TestOutcome {
    var wire: string = "GET / HTTP/1.1\r\nX-Custom-Content-Length: 5\r\n\r\nhello";
    match (http.http_parse_request(wire)) {
        Some(req) => { return test.assert_eq(req.body, ""); },
        None => { return test.fail("well-formed request wrongly rejected"); }
    }
    return test.fail("unreachable");
}

// Duplicate Content-Length is an unrecoverable framing error → reject.
function test_duplicate_content_length_rejected(): test.TestOutcome {
    var wire: string = "POST / HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello!";
    match (http.http_parse_request(wire)) {
        Some(req) => { return test.fail("duplicate Content-Length must be rejected"); },
        None => { return test.pass(); }
    }
    return test.fail("unreachable");
}

// Transfer-Encoding (chunked unsupported; TE+CL is the desync vector) → reject.
function test_transfer_encoding_rejected(): test.TestOutcome {
    var wire: string = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\nhello";
    match (http.http_parse_request(wire)) {
        Some(req) => { return test.fail("Transfer-Encoding must be rejected"); },
        None => { return test.pass(); }
    }
    return test.fail("unreachable");
}

// http_header_value now routes through the same HeaderMap the
// request parser builds (#4381): case-insensitive, value trimmed,
// first match — no parallel raw re-scan.
function test_http_header_value_via_headermap(): test.TestOutcome {
    var block: string = "Host: example.com\r\nContent-Type:  application/json  ";
    return test.assert_is_some_eq_string(
        http.http_header_value(block, "content-type"),
        "application/json");
}

function test_http_header_value_missing_is_none(): test.TestOutcome {
    return test.assert_is_none_string(
        http.http_header_value("Host: e\r\n", "X-Absent"));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("HTTP request headers (migrated)");
    r = r.it("Content-Type reachable case-insensitively",
             test_parsed_headers_reachable_on_req);
    r = r.it("3 wire headers -> size() = 3",
             test_parsed_header_count_is_3);
    r = r.it("duplicate Set-Cookie preserves insertion order",
             test_duplicate_header_insertion_order);
    r = r.it("missing header returns None",
             test_missing_header_returns_none);
    r = r.it("get_all on missing returns []",
             test_get_all_on_missing_is_empty);
    r = r.it("X-*-Content-Length is not the body length",
             test_x_prefixed_cl_not_content_length);
    r = r.it("duplicate Content-Length rejected",
             test_duplicate_content_length_rejected);
    r = r.it("Transfer-Encoding rejected",
             test_transfer_encoding_rejected);
    r = r.it("http_header_value via HeaderMap",
             test_http_header_value_via_headermap);
    r = r.it("http_header_value missing returns None",
             test_http_header_value_missing_is_none);
    return r.finish();
}
