import "std/test";
import "std/http";
import "std/json";
import "std/mock_platform";
import "std/error";
import "std/fetch";
import "std/net";

// examples/tests/http_respond_test.fern — a handler that fails with `?`
// (#9854): its helpers answer `Result[HttpResponse, http.HttpError]`, and
// `http.respond` turns the failure into the RFC 9457 problem reply.

function lookup(path: string): Result[string, http.HttpError] {
  if (path == "/items/1") {
    return Ok("first");
  }
  if (path == "/items/locked") {
    return Err(http.HttpError { status: 403, title: "Locked", detail: "item 'locked' is read-only" });
  }
  return Err(http.fail(404, "no item at " + path));
}

function serve(req: HttpRequest): Result[HttpResponse, http.HttpError] {
  let name: string = lookup(req.path)?;
  return Ok(http.ok(name));
}

function handle(req: HttpRequest, plat: Platform): HttpResponse {
  return http.respond(serve(req));
}

function test_ok_passes_through(): test.TestOutcome {
  let m: MockPlatform = mock_platform.mock_platform_new();
  let resp: HttpResponse = handle(http.request("GET", "/items/1"), m.as_platform());
  match (test.assert_status(resp, 200)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_body(resp, "first");
}

function test_fail_answers_a_problem(): test.TestOutcome {
  let m: MockPlatform = mock_platform.mock_platform_new();
  let resp: HttpResponse = handle(http.request("GET", "/items/9"), m.as_platform());
  match (test.assert_status(resp, 404)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  match (test.assert_header(resp, "content-type", "application/problem+json")) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Not Found\",\"status\":404,\"detail\":\"no item at /items/9\"}");
}

function test_error_keeps_its_own_title_and_escapes(): test.TestOutcome {
  let m: MockPlatform = mock_platform.mock_platform_new();
  let resp: HttpResponse = handle(http.request("GET", "/items/locked"), m.as_platform());
  match (test.assert_status(resp, 403)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Locked\",\"status\":403,\"detail\":\"item 'locked' is read-only\"}");
}

function test_problem_quotes_its_text(): test.TestOutcome {
  let resp: HttpResponse = http.problem(422, "Bad \"name\"", "line\nbreak");
  match (test.assert_status(resp, 422)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Bad \\\"name\\\"\",\"status\":422,\"detail\":\"line\\nbreak\"}");
}

function test_problem_without_detail(): test.TestOutcome {
  let resp: HttpResponse = http.problem(503, "", "");
  return test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Service Unavailable\",\"status\":503}");
}

function decode(text: string): Result[HttpResponse, json.JsonError] {
  let v: JsonValue = json.json_parse_result(text)?;
  return Ok(http.ok("parsed"));
}

function test_json_error_answers_400(): test.TestOutcome {
  let resp: HttpResponse = http.respond(decode("{\"n\": "));
  match (test.assert_status(resp, 400)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  match (test.assert_header(resp, "content-type", "application/problem+json")) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  let body: string = resp.body_string();
  if (!body.contains("\"title\":\"Malformed JSON\"")) {
    return test.fail("body: " + body);
  }
  if (!body.contains(" at line 1, column ")) {
    return test.fail("body: " + body);
  }
  return test.assert_status(http.respond(decode("{\"n\": 1}")), 200);
}

function failing(): Result[HttpResponse, string] {
  return Err("the database is on fire");
}

function test_string_error_answers_500_without_the_message(): test.TestOutcome {
  let resp: HttpResponse = http.respond(failing());
  match (test.assert_status(resp, 500)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Internal Server Error\",\"status\":500}");
}

function counted(n: i32, ok: boolean): (i32, Result[HttpResponse, http.HttpError]) {
  if (!ok) {
    return (n, Err(http.fail(409, "conflict")));
  }
  return (n + 1, Ok(http.ok("counted")));
}

function test_respond_with_keeps_the_state(): test.TestOutcome {
  let good: (i32, HttpResponse) = http.respond_with(counted(1, true));
  if (good.0 != 2) {
    return test.fail("state after Ok: " + good.0.to_string());
  }
  match (test.assert_body(good.1, "counted")) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  let bad: (i32, HttpResponse) = http.respond_with(counted(2, false));
  if (bad.0 != 2) {
    return test.fail("state after Err: " + bad.0.to_string());
  }
  return test.assert_status(bad.1, 409);
}

struct Boom { what: string }

impl error.Error for Boom {
  function message(self: Boom): string {
    return "boom: " + self.what;
  }
}

function exploding(): Result[HttpResponse, dyn error.Error] {
  return Err(Boom { what: "the cache" });
}

function test_dyn_error_answers_500_and_logs_the_message(): test.TestOutcome {
  let m: MockPlatform = mock_platform.mock_platform_new();
  let resp: HttpResponse = http.respond_error(exploding(), m.as_platform());
  match (test.assert_status(resp, 500)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  match (test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Internal Server Error\",\"status\":500}")) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  match (m.find_call("log")) {
    Some(c) => {
      return test.assert_eq(c.args, "handler error: boom: the cache");
    },
    None => {
      return test.fail("nothing was logged");
    }
  }
}

function counted_dyn(n: i32, ok: boolean): (i32, Result[HttpResponse, dyn error.Error]) {
  if (!ok) {
    return (n, Err(Boom { what: "the count" }));
  }
  return (n + 1, Ok(http.ok("counted")));
}

function test_respond_error_with_keeps_the_state(): test.TestOutcome {
  let m: MockPlatform = mock_platform.mock_platform_new();
  let good: (i32, HttpResponse) = http.respond_error_with(counted_dyn(1, true), m.as_platform());
  if (good.0 != 2) {
    return test.fail("state after Ok: " + good.0.to_string());
  }
  if (m.call_count() != 0) {
    return test.fail("an Ok answer was logged");
  }
  let bad: (i32, HttpResponse) = http.respond_error_with(counted_dyn(2, false), m.as_platform());
  if (bad.0 != 2) {
    return test.fail("state after Err: " + bad.0.to_string());
  }
  match (test.assert_status(bad.1, 500)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_eq(m.call_count(), 1);
}

// A handler that fetches upstream, standing in for `plat.http` with the
// failure it is handed.
function proxied(failure: fetch.FetchError): Result[HttpResponse, fetch.FetchError] {
  let upstream: Result[string, fetch.FetchError] = Err(failure);
  let body: string = upstream?;
  return Ok(http.ok(body));
}

function test_fetch_timeout_answers_504(): test.TestOutcome {
  return test.assert_status(http.respond(proxied(fetch.Timeout(fetch.Inactivity))), 504);
}

function test_fetch_failure_answers_502_without_the_message(): test.TestOutcome {
  let resp: HttpResponse = http.respond(proxied(fetch.Connect(net.ConnectionRefused)));
  match (test.assert_status(resp, 502)) {
    Fail(msg) => {
      return test.fail(msg);
    },
    Pass => {}
  }
  return test.assert_body(resp, "{\"type\":\"about:blank\",\"title\":\"Bad Gateway\",\"status\":502}");
}

function test_fetch_bad_request_answers_500(): test.TestOutcome {
  return test.assert_status(http.respond(proxied(fetch.InvalidUrl("no scheme"))), 500);
}

function main(): i32 {
  let t: test.TestRunner = test.test_new("HTTP respond");
  t = t.it("an Ok response passes through", test_ok_passes_through);
  t = t.it("a failed lookup answers a problem", test_fail_answers_a_problem);
  t = t.it("an error keeps its own title, and the detail is quoted", test_error_keeps_its_own_title_and_escapes);
  t = t.it("problem quotes its title and detail", test_problem_quotes_its_text);
  t = t.it("a problem without detail leaves the member out", test_problem_without_detail);
  t = t.it("a JSON error answers 400 with where the text broke", test_json_error_answers_400);
  t = t.it("a string error answers 500 without the message", test_string_error_answers_500_without_the_message);
  t = t.it("respond_with keeps the state beside the answer", test_respond_with_keeps_the_state);
  t = t.it("a dyn error.Error answers 500 and logs the message", test_dyn_error_answers_500_and_logs_the_message);
  t = t.it("respond_error_with keeps the state beside the answer", test_respond_error_with_keeps_the_state);
  t = t.it("a fetch timeout answers 504", test_fetch_timeout_answers_504);
  t = t.it("a failed fetch answers 502 without the message", test_fetch_failure_answers_502_without_the_message);
  t = t.it("a fetch the handler built wrong answers 500", test_fetch_bad_request_answers_500);
  return t.finish();
}
