import "std/test";
import "std/i32";
// examples/tests/i32_bit_length_test.fern — pure-Fern coverage of
// std/i32.bit_length: the number of bits needed to represent the MAGNITUDE |n|
// (highest set bit + 1). Covers zero, small values, powers of two and their
// neighbours, negatives (magnitude), i32::MAX, and the i32::MIN widen-to-i64
// edge. Kept as its own suite so the self-host merged bundle stays under the
// asm_ir IR budget; uses assert_true (no scalar assert_eq[i32]). The Go-side
// TestI32BitLength pins these across all four backends; this is the
// migration-shaped companion.

function test_zero(): test.TestOutcome {
    return test.assert_true((0).bit_length() == 0);
}

function test_one(): test.TestOutcome {
    return test.assert_true((1).bit_length() == 1);
}

function test_five(): test.TestOutcome {
    return test.assert_true((5).bit_length() == 3);   // 101
}

function test_powers(): test.TestOutcome {
    // 255 (11111111) -> 8; 256 (1_00000000) -> 9.
    if ((255).bit_length() != 8) { return test.fail("255"); }
    return test.assert_true((256).bit_length() == 9);
}

function test_negative(): test.TestOutcome {
    // Uses the magnitude, so -5 matches 5.
    return test.assert_true((0 - 5).bit_length() == 3);
}

function test_max(): test.TestOutcome {
    return test.assert_true((2147483647).bit_length() == 31);
}

function test_min(): test.TestOutcome {
    // i32::MIN magnitude is 2^31 -> 32 bits.
    var min: i32 = (0 - 2147483647) - 1;
    return test.assert_true(min.bit_length() == 32);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/i32 bit_length");
    r = r.it("zero",             test_zero());
    r = r.it("one",              test_one());
    r = r.it("five",             test_five());
    r = r.it("powers of two",    test_powers());
    r = r.it("negative",         test_negative());
    r = r.it("i32 max",          test_max());
    r = r.it("i32 min",          test_min());
    return r.finish();
}
