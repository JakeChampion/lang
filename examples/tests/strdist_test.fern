import "std/test";
import "std/strdist" as strdist;
// examples/tests/strdist_test.fern — pure-Fern coverage of std/strdist:
// Levenshtein edit distance (classic reference cases + code-point
// awareness) and the normalised similarity ratio.

function test_levenshtein_basic(): test.TestOutcome {
    if (strdist.levenshtein("", "") != 0) { return test.fail("empty/empty"); }
    if (strdist.levenshtein("abc", "abc") != 0) { return test.fail("identical"); }
    if (strdist.levenshtein("a", "") != 1) { return test.fail("a/empty"); }
    if (strdist.levenshtein("", "abc") != 3) { return test.fail("empty/abc"); }
    return test.pass();
}

function test_levenshtein_reference(): test.TestOutcome {
    // The canonical worked examples.
    if (strdist.levenshtein("kitten", "sitting") != 3) { return test.fail("kitten/sitting"); }
    if (strdist.levenshtein("flaw", "lawn") != 2) { return test.fail("flaw/lawn"); }
    return test.assert_eq(strdist.levenshtein("book", "back"), 2);
}

function test_codepoint_aware(): test.TestOutcome {
    // 'é' vs 'e' is ONE substitution over code points (not two bytes).
    if (strdist.levenshtein("café", "cafe") != 1) { return test.fail("café/cafe"); }
    return test.assert_eq(strdist.levenshtein("Ελλάδα", "Ελλάδα"), 0);
}

function test_similarity(): test.TestOutcome {
    if (strdist.similarity("abc", "abc") != 1.0) { return test.fail("identical != 1"); }
    if (strdist.similarity("", "") != 1.0) { return test.fail("both empty != 1"); }
    if (strdist.similarity("abc", "xyz") != 0.0) { return test.fail("disjoint != 0"); }
    // kitten/sitting → 1 - 3/7 ≈ 0.5714
    return test.assert_eq_f64_near(strdist.similarity("kitten", "sitting"), 0.5714, 0.001);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/strdist");
    r = r.it("levenshtein basic",     test_levenshtein_basic);
    r = r.it("levenshtein reference", test_levenshtein_reference);
    r = r.it("codepoint aware",       test_codepoint_aware);
    r = r.it("similarity",            test_similarity);
    return r.finish();
}
