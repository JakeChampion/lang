import "std/test";
import "std/option";
// examples/tests/option_combinators_test.fern — pure-Fern coverage of the
// std/option COMBINATOR surface (distinct from option_and_set_ops_test, which
// covers the std/test Option assertion helpers): is_some / is_none /
// unwrap_or / unwrap_or_else / map / and_then / or_else / filter / ok_or /
// map_or / is_some_and / or / and — the Rust-parity vocabulary (#2691), as
// ordinary generic methods on Option[T] with closure args. The Go-side suite
// unit-tests these; this is the migration-shaped (pure-Fern, std/test-driven,
// self-host-gated) companion.

function test_is_some_is_none(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var n: Option[i32] = None;
    return test.assert_true(s.is_some() && !s.is_none() && n.is_none() && !n.is_some());
}

function test_unwrap_or(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var n: Option[i32] = None;
    return test.assert_true(s.unwrap_or(0) == 5 && n.unwrap_or(42) == 42);
}

function test_unwrap_or_else(): test.TestOutcome {
    var n: Option[i32] = None;
    return test.assert_eq(n.unwrap_or_else(function (): i32 { return 7; }), 7);
}

function test_map(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var m = s.map(function (x: i32): i32 { return x * 2; });
    return test.assert_eq(m.unwrap_or(0), 10);
}

function test_map_none(): test.TestOutcome {
    var n: Option[i32] = None;
    var m = n.map(function (x: i32): i32 { return x * 2; });
    return test.assert_eq(m.unwrap_or(0 - 1), 0 - 1);
}

function test_and_then(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var r = s.and_then(function (x: i32): Option[i32] { return Some(x + 1); });
    return test.assert_eq(r.unwrap_or(0), 6);
}

function test_or_else(): test.TestOutcome {
    var n: Option[i32] = None;
    var r = n.or_else(function (): Option[i32] { return Some(9); });
    return test.assert_eq(r.unwrap_or(0), 9);
}

function test_filter_keep(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var r = s.filter(function (x: i32): boolean { return x > 3; });
    return test.assert_eq(r.unwrap_or(0), 5);
}

function test_filter_drop(): test.TestOutcome {
    var s: Option[i32] = Some(2);
    var r = s.filter(function (x: i32): boolean { return x > 3; });
    return test.assert_true(r.is_none());
}

function test_map_or(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var n: Option[i32] = None;
    var a = s.map_or(0, function (x: i32): i32 { return x * 10; });
    var b = n.map_or(0, function (x: i32): i32 { return x * 10; });
    return test.assert_true(a == 50 && b == 0);
}

function test_is_some_and(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    return test.assert_true(s.is_some_and(function (x: i32): boolean { return x > 3; }));
}

function test_or(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var n: Option[i32] = None;
    return test.assert_true(s.or(Some(9)).unwrap_or(0) == 5 && n.or(Some(9)).unwrap_or(0) == 9);
}

function test_and(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var n: Option[i32] = None;
    return test.assert_true(s.and(Some(9)).unwrap_or(0) == 9 && n.and(Some(9)).is_none());
}

function test_ok_or(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    match (s.ok_or("missing")) {
        Ok(v) => { return test.assert_eq(v, 5); },
        Err(e) => { return test.fail("expected Ok"); }
    }
}

function test_ok_or_else(): test.TestOutcome {
    // None takes the lazy error arm; Some ignores it and yields Ok.
    var n: Option[i32] = None;
    match (n.ok_or_else(function (): i32 { return 99; })) {
        Ok(v) => { return test.fail("expected Err for None"); },
        Err(e) => { return test.assert_eq(e, 99); }
    }
}

function test_map_or_else(): test.TestOutcome {
    // Some routes through `f`; None computes the lazy default.
    var s: Option[i32] = Some(5);
    var n: Option[i32] = None;
    var a: i32 = s.map_or_else(function (): i32 { return 0; }, function (x: i32): i32 { return x + 1; });
    var b: i32 = n.map_or_else(function (): i32 { return 0; }, function (x: i32): i32 { return x + 1; });
    return test.assert_true(a == 6 && b == 0);
}

function test_zip(): test.TestOutcome {
    var a: Option[i32] = Some(1);
    var b: Option[i32] = Some(2);
    var n: Option[i32] = None;
    // Both present -> Some((1, 2)); either None -> None.
    match (a.zip(b)) {
        Some(p) => {
            if (!(p.0 == 1 && p.1 == 2)) { return test.fail("zip pair wrong"); }
        },
        None => { return test.fail("expected Some pair"); }
    }
    return test.assert_true(a.zip(n).is_none() && n.zip(a).is_none());
}

function test_unzip(): test.TestOutcome {
    // unzip is the inverse of zip: Some((7,"hi")) -> (Some(7), Some("hi")).
    var some: Option[(i32, string)] = Some((7, "hi"));
    var sa: (Option[i32], Option[string]) = some.unzip();
    if (sa.0.unwrap_or(0) != 7) { return test.fail("first"); }
    if (sa.1.unwrap_or("") != "hi") { return test.fail("second"); }
    // None -> (None, None).
    var none: Option[(i32, string)] = None;
    var na: (Option[i32], Option[string]) = none.unzip();
    return test.assert_true(na.0.is_none() && na.1.is_none());
}

function test_xor(): test.TestOutcome {
    var s: Option[i32] = Some(5);
    var t: Option[i32] = Some(9);
    var n: Option[i32] = None;
    // Exactly one present -> that one; both or neither -> None.
    return test.assert_true(
        s.xor(n).unwrap_or(0) == 5
        && n.xor(s).unwrap_or(0) == 5
        && s.xor(t).is_none()
        && n.xor(n).is_none());
}

function test_flatten(): test.TestOutcome {
    var s: Option[Option[i32]] = Some(Some(7));
    var inner_none: Option[Option[i32]] = Some(None);
    var outer_none: Option[Option[i32]] = None;
    // Some(Some(x)) -> Some(x); Some(None) and None both -> None.
    return test.assert_true(
        s.flatten().unwrap_or(0) == 7
        && inner_none.flatten().is_none()
        && outer_none.flatten().is_none());
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/option combinators");
    r = r.it("is_some / is_none",   test_is_some_is_none);
    r = r.it("unwrap_or",           test_unwrap_or);
    r = r.it("unwrap_or_else",      test_unwrap_or_else);
    r = r.it("map",                 test_map);
    r = r.it("map over None",       test_map_none);
    r = r.it("and_then",            test_and_then);
    r = r.it("or_else",             test_or_else);
    r = r.it("filter keep",         test_filter_keep);
    r = r.it("filter drop",         test_filter_drop);
    r = r.it("map_or",              test_map_or);
    r = r.it("is_some_and",         test_is_some_and);
    r = r.it("or",                  test_or);
    r = r.it("and",                 test_and);
    r = r.it("ok_or",               test_ok_or);
    r = r.it("ok_or_else",          test_ok_or_else);
    r = r.it("map_or_else",         test_map_or_else);
    r = r.it("zip",                 test_zip);
    r = r.it("unzip",               test_unzip);
    r = r.it("xor",                 test_xor);
    r = r.it("flatten",             test_flatten);
    return r.finish();
}
