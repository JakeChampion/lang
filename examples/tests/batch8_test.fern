import "core/map";
import "std/test";
// examples/tests/batch8_test.fern — exercises the additions
// from the eighth test-runner-migration tranche:
//   - argv passthrough (`args()` populated from `fern -interp
//     FILE.fern -- ARGS...`)
//   - `--filter PATTERN` test-case selection via the runner's
//     built-in `parse_filter_from_args` + `test_new_filtered`
//   - golden-file assertions (`assert_matches_golden` /
//     `_strict`)
//   - Map assertions (len / has / lacks for i32-i32 + string-
//     string)

function test_argv_basic(): test.TestOutcome {
    // args()[0] is conventionally the program path; subsequent
    // entries come from `-- ...` on the Fern command line. We
    // can't pin a specific argv shape here (this file is
    // invoked from CI via `fern -interp FILE`), so just check
    // the call doesn't crash and returns a string array.
    var a: string[] = args();
    if (a.len() < 1) {
        return test.fail("args() returned empty (expected at least argv[0])");
    }
    return test.pass();
}

function test_map_len_string_string(): test.TestOutcome {
    var m: Map[string, string] = map_new(8);
    m = m.insert("a", "alpha");
    m = m.insert("b", "beta");
    return test.assert_map_len(m, 2);
}

function test_map_has_string_string(): test.TestOutcome {
    var m: Map[string, string] = map_new(4);
    m = m.insert("ok", "yes");
    return test.assert_map_has(m, "ok", "yes");
}

function test_map_lacks_string_string(): test.TestOutcome {
    var m: Map[string, string] = map_new(4);
    m = m.insert("ok", "yes");
    return test.assert_map_lacks(m, "missing");
}

function test_map_has_i32_i32(): test.TestOutcome {
    var m: Map[i32, i32] = map_new(4);
    m = m.insert(1, 100);
    m = m.insert(2, 200);
    return test.assert_map_has(m, 1, 100);
}

function test_map_has_wrong_value_reports(): test.TestOutcome {
    var m: Map[string, string] = map_new(4);
    m = m.insert("k", "actual");
    match (test.assert_map_has(m, "k", "expected")) {
        Fail(msg) => {
            // Values render via Display (unquoted) now that the helper
            // is generic over K/V.
            if (!msg.contains("actual")) {
                return test.fail("missing actual value in msg: " + msg);
            }
            if (!msg.contains("expected")) {
                return test.fail("missing expected value in msg: " + msg);
            }
            return test.pass();
        },
        Pass => { return test.fail("expected wrong-value to fail"); }
    }
    return test.pass();
}

function test_golden_bootstrap_and_compare(r: test.TestRunner): test.TestRunner {
    var (dir, rr) = test.must_temp_dir(r, "golden");
    if (dir == "") { return rr; }
    var path: string = dir + "/golden.txt";
    var actual: string = "line 1\nline 2\n";
    // First call: file missing → bootstrap (writes + passes).
    rr = rr.it("bootstrap golden",      () => test.assert_matches_golden(path, actual));
    // Second call: file present → compare equal.
    rr = rr.it("compare existing",      () => test.assert_matches_golden(path, actual));
    // Strict mode on a missing file must fail.
    rr = rr.it("strict missing fails",
               () => invert_pass_b8(test.assert_matches_golden_strict(dir + "/no-such.txt", "x")));
    return rr;
}

function invert_pass_b8(result: test.TestOutcome): test.TestOutcome {
    match (result) {
        Fail(_) => { return test.pass(); },
        Pass => { return test.fail("expected failure"); }
    }
    return test.pass();
}

function main(): i32 {
    // Lift `--filter PATTERN` off the command line. Falls back
    // to "" (no filter) when the flag is absent, which makes
    // `test_new_filtered` behave identically to `test_new`.
    var filter: string = test.parse_filter_from_args(args());
    var r: test.TestRunner = test.test_new_filtered("batch 8", filter);

    r = r.it("argv populated",                  test_argv_basic);
    r = r.it("map len string-string",           test_map_len_string_string);
    r = r.it("map has string-string",           test_map_has_string_string);
    r = r.it("map lacks string-string",         test_map_lacks_string_string);
    r = r.it("map has i32-i32",                 test_map_has_i32_i32);
    r = r.it("map has wrong-value diagnostic",  test_map_has_wrong_value_reports);

    r = test_golden_bootstrap_and_compare(r);

    return r.finish();
}
