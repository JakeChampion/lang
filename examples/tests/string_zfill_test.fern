import "std/test";
import "std/string";
// examples/tests/string_zfill_test.fern — pure-Fern coverage of
// std/string.zfill(width): left-pad a numeric string with '0' to at least
// `width` bytes, keeping a leading sign ('+' / '-') in FRONT of the zeros
// (Python's str.zfill), unlike pad_start. Covers unsigned, both signs, already
// wide, empty, lone sign, width 0, and non-numeric. Kept as its own suite so the
// self-host merged bundle stays under the asm_ir IR budget; uses assert_true.
// The Go-side TestStringZfill pins these across all four backends; this is the
// migration-shaped (pure-Fern, std/test-driven) companion.

function test_unsigned(): test.TestOutcome {
    return test.assert_true("42".zfill(5) == "00042");
}

function test_negative(): test.TestOutcome {
    // Sign stays in front of the zeros.
    return test.assert_true("-42".zfill(5) == "-0042");
}

function test_positive_sign(): test.TestOutcome {
    return test.assert_true("+42".zfill(5) == "+0042");
}

function test_already_wide(): test.TestOutcome {
    if ("5".zfill(1) != "5") { return test.fail("width 1"); }
    return test.assert_true("123".zfill(3) == "123");
}

function test_empty(): test.TestOutcome {
    return test.assert_true("".zfill(3) == "000");
}

function test_lone_sign(): test.TestOutcome {
    return test.assert_true("-".zfill(4) == "-000");
}

function test_width_zero(): test.TestOutcome {
    return test.assert_true("7".zfill(0) == "7");
}

function test_non_numeric(): test.TestOutcome {
    // No leading sign → plain zero-pad.
    return test.assert_true("abc".zfill(5) == "00abc");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/string zfill");
    r = r.it("unsigned",      test_unsigned());
    r = r.it("negative",      test_negative());
    r = r.it("positive sign", test_positive_sign());
    r = r.it("already wide",  test_already_wide());
    r = r.it("empty",         test_empty());
    r = r.it("lone sign",     test_lone_sign());
    r = r.it("width zero",    test_width_zero());
    r = r.it("non numeric",   test_non_numeric());
    return r.finish();
}
