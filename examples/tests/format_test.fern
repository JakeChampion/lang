import "std/test";
import "std/format" as format;

// examples/tests/format_test.fern — exercise std/format's dynamic
// template substitution and the human-readable byte / duration
// formatters through the test runner. std/format had only Go-side
// coverage; this is the pure-Fern, std/test-driven shape, gated through
// the self-host IR path (TestSelfHostStdTestE2E) so the string-build /
// integer-division lowering is proven end to end on the self-hosted
// compiler.

// ---- format(fmt, args) — positional `{}` substitution ----

function test_format_positional(): test.TestOutcome {
    return test.assert_eq(format.format("{} + {} = {}", ["1", "2", "3"]), "1 + 2 = 3");
}

function test_format_no_placeholders(): test.TestOutcome {
    return test.assert_eq(format.format("plain text", []), "plain text");
}

// `{{` / `}}` escape to literal braces (Python/Rust convention).
function test_format_escaped_braces(): test.TestOutcome {
    return test.assert_eq(format.format("{{}} literal", []), "{} literal");
}

// Width specs: `{:>w}` right-aligns, `{:<w}` left-aligns to width w.
function test_format_right_align(): test.TestOutcome {
    return test.assert_eq(format.format("{:>5}", ["42"]), "   42");
}

function test_format_left_align(): test.TestOutcome {
    return test.assert_eq(format.format("{:<5}", ["42"]), "42   ");
}

// Center-align `{:^w}` splits the padding, and a custom fill char
// (`{:*^w}`) replaces the default space — both exercise __repeat_char,
// the padding builder rewritten to the two-pass exact-size buffer
// (#4379) so wide fields no longer recopy the growing pad each step.
function test_format_center_align(): test.TestOutcome {
    return test.assert_eq(format.format("{:^8}", ["hi"]), "   hi   ");
}

function test_format_custom_fill_center(): test.TestOutcome {
    return test.assert_eq(format.format("{:*^9}", ["ab"]), "***ab****");
}

function test_format_custom_fill_right(): test.TestOutcome {
    return test.assert_eq(format.format("{:.>5}", ["x"]), "....x");
}

// Sign flag `+`: forces a leading `+` on a non-negative number; a
// value that already carries `-`, or a non-numeric one, is untouched.
function test_format_sign_plus(): test.TestOutcome {
    return test.assert_eq(format.format("{:+}", ["42"]), "+42");
}

function test_format_sign_negative_untouched(): test.TestOutcome {
    return test.assert_eq(format.format("{:+}", ["-42"]), "-42");
}

function test_format_sign_nonnumeric_untouched(): test.TestOutcome {
    return test.assert_eq(format.format("{:+}", ["ok"]), "ok");
}

// Zero-pad flag `0`: sign-aware — zeros pad after a leading sign,
// and the sign counts toward the width.
function test_format_zero_pad(): test.TestOutcome {
    return test.assert_eq(format.format("{:05}", ["42"]), "00042");
}

function test_format_zero_pad_negative(): test.TestOutcome {
    return test.assert_eq(format.format("{:05}", ["-42"]), "-0042");
}

function test_format_sign_zero_pad(): test.TestOutcome {
    return test.assert_eq(format.format("{:+06}", ["42"]), "+00042");
}

// The `0` flag overrides fill/align (matching Rust), so a left-align
// spec still right-pads with zeros.
function test_format_zero_pad_overrides_align(): test.TestOutcome {
    return test.assert_eq(format.format("{:<05}", ["42"]), "00042");
}

// ---- format_bytes(n) — binary IEC units (B / KiB / MiB / GiB) ----

function test_bytes_below_kib(): test.TestOutcome {
    return test.assert_eq(format.format_bytes(0), "0 B");
}

function test_bytes_just_below_kib(): test.TestOutcome {
    return test.assert_eq(format.format_bytes(1023), "1023 B");
}

function test_bytes_one_kib(): test.TestOutcome {
    return test.assert_eq(format.format_bytes(1024), "1 KiB");
}

function test_bytes_one_mib(): test.TestOutcome {
    return test.assert_eq(format.format_bytes(1048576), "1 MiB");
}

function test_bytes_negative(): test.TestOutcome {
    return test.assert_eq(format.format_bytes(0 - 2048), "-2 KiB");
}

// ---- format_duration_ms(ms) — h/m/s/ms, non-zero components only ----

function test_duration_zero(): test.TestOutcome {
    return test.assert_eq(format.format_duration_ms(0), "0ms");
}

function test_duration_sub_second(): test.TestOutcome {
    return test.assert_eq(format.format_duration_ms(500), "500ms");
}

function test_duration_seconds_and_ms(): test.TestOutcome {
    return test.assert_eq(format.format_duration_ms(1500), "1s 500ms");
}

function test_duration_minutes(): test.TestOutcome {
    return test.assert_eq(format.format_duration_ms(65000), "1m 5s");
}

function test_duration_full(): test.TestOutcome {
    return test.assert_eq(format.format_duration_ms(3661001), "1h 1m 1s 1ms");
}

// A longer, mixed template that exercises the growable-u8[] output buffer
// across several reallocations in one call (#4379): a long literal run, many
// placeholders, an escaped-brace pair, a non-placeholder `{"k":..}` JSON run
// that renders verbatim, a missing-arg placeholder emitted as-is, and a
// multi-byte UTF-8 literal — the branches that each append to the buffer
// differently. Pins the byte-for-byte output of the rewrite.
function test_format_mixed_long(): test.TestOutcome {
    var got: string = format.format(
        "user={} role={} {{n}}={} cfg={\"k\":1} tail={} name={} done",
        ["alice", "admin", "7", "Þórin"]);
    return test.assert_eq(got,
        "user=alice role=admin {n}=7 cfg={\"k\":1} tail=Þórin name={} done");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/format");
    r = r.it("format positional", test_format_positional);
    r = r.it("format no placeholders", test_format_no_placeholders);
    r = r.it("format escaped braces", test_format_escaped_braces);
    r = r.it("format right-align", test_format_right_align);
    r = r.it("format left-align", test_format_left_align);
    r = r.it("format center-align", test_format_center_align);
    r = r.it("format custom fill center", test_format_custom_fill_center);
    r = r.it("format custom fill right", test_format_custom_fill_right);
    r = r.it("format sign +", test_format_sign_plus);
    r = r.it("format sign negative untouched", test_format_sign_negative_untouched);
    r = r.it("format sign non-numeric untouched", test_format_sign_nonnumeric_untouched);
    r = r.it("format zero-pad", test_format_zero_pad);
    r = r.it("format zero-pad negative", test_format_zero_pad_negative);
    r = r.it("format sign + zero-pad", test_format_sign_zero_pad);
    r = r.it("format zero-pad overrides align", test_format_zero_pad_overrides_align);
    r = r.it("bytes below KiB", test_bytes_below_kib);
    r = r.it("bytes just below KiB", test_bytes_just_below_kib);
    r = r.it("bytes one KiB", test_bytes_one_kib);
    r = r.it("bytes one MiB", test_bytes_one_mib);
    r = r.it("bytes negative", test_bytes_negative);
    r = r.it("duration zero", test_duration_zero);
    r = r.it("duration sub-second", test_duration_sub_second);
    r = r.it("duration seconds and ms", test_duration_seconds_and_ms);
    r = r.it("duration minutes", test_duration_minutes);
    r = r.it("duration full", test_duration_full);
    r = r.it("format mixed long", test_format_mixed_long);
    return r.finish();
}
