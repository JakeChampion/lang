import "std/test";
import "std/deflate" as deflate;
import "std/hex" as hex;
import "std/hash" as hash;
import "std/utf8" as utf8;
import "core/int";

// examples/tests/deflate_test.fern — std/deflate against streams Python's
// zlib produced: a stored block, a fixed-Huffman block, a dynamic block,
// a 60 KB corpus whose matches reach 32 KB back, a gzip member with every
// optional header field, two members in one stream, a zlib stream, and
// the refusals (truncation, a bad checksum, a reserved block type, a
// preset dictionary, the output cap).

function text(r: Result[deflate.Inflated, deflate.InflateError]): string {
  match (r) {
    Ok(inflated) => {
      match (utf8.from_bytes(inflated.out)) {
        Some(s) => {
          return s;
        },
        None => {
          return "<not utf-8>";
        }
      }
    },
    Err(e) => {
      return "error: " + e.message();
    }
  }
  return "";
}

function bytes_text(r: Result[u8[], deflate.InflateError]): string {
  match (r) {
    Ok(out) => {
      match (utf8.from_bytes(out)) {
        Some(s) => {
          return s;
        },
        None => {
          return "<not utf-8>";
        }
      }
    },
    Err(e) => {
      return "error: " + e.message();
    }
  }
  return "";
}

function test_stored_block(): test.TestOutcome {
  return test.assert_eq(text(deflate.inflate(hex.hex_decode("010300fcff616263"), 1024)), "abc");
}

function test_fixed_block(): test.TestOutcome {
  return test.assert_eq(text(deflate.inflate(hex.hex_decode("cb48cdc9c957c8402701"), 1024)), "hello hello hello hello");
}

function test_dynamic_block(): test.TestOutcome {
  let want: string = "";
  let i: i32 = 0;
  while (i < 12) {
    want = want + "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. ";
    i = i + 1;
  }
  return test.assert_eq(text(deflate.inflate(hex.hex_decode("edcebb1580201044d156a6026b31a0013f08a8b08a8062f56e0926641bcf9b73aeb21a6776d38631d21db0d08335fbe302151d9178de87b76226d341358bfb813b5f317274bb64b1b8a2797a75c0eece4c91bfe66a4910af78c52b5ef18a57bc7fbd1f"), 65536)), want);
}

function test_consumed(): test.TestOutcome {
  let stream: u8[] = hex.hex_decode("cb48cdc9c957c8402701");
  match (deflate.inflate(stream.append(255 as u8), 1024)) {
    Ok(inflated) => {
      return test.assert_eq(inflated.consumed, stream.len());
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// `__appended(out, line)` — `out` with the line's bytes on its end, one
// append per byte so the array grows in place.
function __appended(own out: u8[], line: string): u8[] {
  let bs: u8[] = line.bytes();
  let i: i32 = 0;
  while (i < bs.len()) {
    out = out.append(bs[i]);
    i = i + 1;
  }
  return out;
}

// 3000 numbered lines: dynamic blocks with matches up to the window's
// full 32 KB back, checked byte for byte and by CRC-32 against the source.
function test_corpus_gzip(): test.TestOutcome {
  let want: u8[] = [];
  let i: i32 = 0;
  while (i < 3000) {
    want = __appended(want, "line " + int.int_to_string(i) + " of the corpus\n");
    i = i + 1;
  }
  match (deflate.gunzip(hex.hex_decode(""), 1048576)) {
    Ok(out) => {
      if (out.len() != want.len()) {
        return test.fail("length " + int.int_to_string(out.len()) + ", want " + int.int_to_string(want.len()));
      }
      let k: i32 = 0;
      while (k < out.len()) {
        if (out[k] != want[k]) {
          return test.fail("byte " + int.int_to_string(k) + " differs");
        }
        k = k + 1;
      }
      return test.assert_eq(hash.crc32_new().update_bytes(out[:]).finish() == 524053769 as u32, true);
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function test_gzip_header_fields(): test.TestOutcome {
  return test.assert_eq(bytes_text(deflate.gunzip(hex.hex_decode("1f8b081e000000000003040001020000612e747874006e6f7465006de14bcb494c4f4f4d0100c11f521707000000"), 1024)), "flagged");
}

function test_gzip_two_members(): test.TestOutcome {
  return test.assert_eq(bytes_text(deflate.gunzip(hex.hex_decode("1f8b08000000000000034bcb2c2a2ed10100d7364715060000001f8b08000000000000032b4e4dcecf4b010069111fb606000000"), 1024)), "first,second");
}

function test_zlib(): test.TestOutcome {
  return test.assert_eq(bytes_text(deflate.zlib_decode(hex.hex_decode("78daabcac94c52482b4acc4d4d010019b90441"), 1024)), "zlib framed");
}

function test_adler32(): test.TestOutcome {
  // RFC 1950's own example value for "Wikipedia".
  return test.assert_eq(deflate.adler32("Wikipedia".bytes()) == 300286872 as u32, true);
}

function test_output_limit(): test.TestOutcome {
  if (bytes_text(deflate.gunzip(hex.hex_decode("1f8b08000000000000034bcb2c2a2ed10100d7364715060000001f8b08000000000000032b4e4dcecf4b010069111fb606000000"), 11)) != "error: the decompressed data is past its limit") {
    return test.fail("a cap below the output: " + bytes_text(deflate.gunzip(hex.hex_decode("1f8b08000000000000034bcb2c2a2ed10100d7364715060000001f8b08000000000000032b4e4dcecf4b010069111fb606000000"), 11)));
  }
  return test.assert_eq(bytes_text(deflate.gunzip(hex.hex_decode("1f8b08000000000000034bcb2c2a2ed10100d7364715060000001f8b08000000000000032b4e4dcecf4b010069111fb606000000"), 12)), "first,second");
}

function test_truncated(): test.TestOutcome {
  return test.assert_eq(bytes_text(deflate.gunzip(hex.hex_decode("1f8b080000000000000305c1510e00100c44c1abbcaba11b24b489d487db9b29acf08e3c6e1fd4b0470655e4b9de4aca984e0eb1"), 1024)), "error: the compressed data ends early");
}

function test_bad_checksums(): test.TestOutcome {
  if (bytes_text(deflate.gunzip(hex.hex_decode("1f8b08000000000000034b2e4a5648ce484dce06006237cc2b09000000"), 1024)) != "error: the checksum does not match the decompressed data") {
    return test.fail("gzip CRC-32: " + bytes_text(deflate.gunzip(hex.hex_decode("1f8b08000000000000034b2e4a5648ce484dce06006237cc2b09000000"), 1024)));
  }
  return test.assert_eq(bytes_text(deflate.zlib_decode(hex.hex_decode("78daabcac94c52482b4acc4d4d010019b90440"), 1024)), "error: the checksum does not match the decompressed data");
}

function test_bad_headers(): test.TestOutcome {
  if (bytes_text(deflate.gunzip("not gzip".bytes(), 1024)) != "error: unsupported compressed data: not gzip") {
    return test.fail("gzip magic: " + bytes_text(deflate.gunzip("not gzip".bytes(), 1024)));
  }
  if (bytes_text(deflate.zlib_decode(hex.hex_decode("7820abcac94c52482b4acc4d4d010019b90441"), 1024)) != "error: unsupported compressed data: a zlib preset dictionary") {
    return test.fail("zlib FDICT: " + bytes_text(deflate.zlib_decode(hex.hex_decode("7820abcac94c52482b4acc4d4d010019b90441"), 1024)));
  }
  return test.assert_eq(text(deflate.inflate(hex.hex_decode("07"), 1024)), "error: malformed compressed data: a reserved block type");
}

// Two inputs no encoder writes, each reaching a guard the Python-made
// vectors above never do: a fixed block whose length code is cut off
// mid-symbol, and a fixed block whose first pair copies from before the
// output starts.
function test_hand_rolled_refusals(): test.TestOutcome {
  if (text(deflate.inflate(hex.hex_decode("8b24c0"), 1024)) != "error: the compressed data ends early") {
    return test.fail("cut-off symbol: " + text(deflate.inflate(hex.hex_decode("8b24c0"), 1024)));
  }
  return test.assert_eq(text(deflate.inflate(hex.hex_decode("0303"), 1024)), "error: malformed compressed data: a distance before the start of the output");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/deflate");
  r = r.it("stored block", test_stored_block);
  r = r.it("fixed block", test_fixed_block);
  r = r.it("dynamic block", test_dynamic_block);
  r = r.it("consumed stops at the stream's end", test_consumed);
  r = r.it("corpus gzip", test_corpus_gzip);
  r = r.it("gzip header fields", test_gzip_header_fields);
  r = r.it("gzip two members", test_gzip_two_members);
  r = r.it("zlib", test_zlib);
  r = r.it("adler32", test_adler32);
  r = r.it("output limit", test_output_limit);
  r = r.it("truncated", test_truncated);
  r = r.it("bad checksums", test_bad_checksums);
  r = r.it("bad headers", test_bad_headers);
  r = r.it("hand-rolled refusals", test_hand_rolled_refusals);
  return r.finish();
}
