import "std/array";
import "std/num";
import "core/cmp";
import "std/test";
// examples/tests/array_reductions_test.fern — wider-int /
// float array reductions.
//
// The per-width `sum_*` / `max_*` / `min_*` zoo std/array once
// carried was retired (#5349) in favour of the generic bounded
// verbs: `num.sum[T: Add + Zero]` and `cmp.max_of` /
// `cmp.min_of[T: Ord]`. These cases pin the width-specific
// behaviours that mattered — i64 / u32 wrapping-add sums, the
// near-u64-max unsigned max compare, f64 sum + max — now driven
// through the generic forms monomorphised to each width. `avg_i64`
// / `avg_f64` (no generic equivalent) stay in std/array.

function test_sum_i64(): test.TestOutcome {
    var arr: i64[] = [1 as i64, 2 as i64, 3 as i64, 4 as i64];
    return test.assert_eq(num.sum(arr), 10 as i64);
}

function test_sum_i64_empty(): test.TestOutcome {
    var arr: i64[] = [];
    return test.assert_eq(num.sum(arr), 0 as i64);
}

function test_max_i64(): test.TestOutcome {
    var arr: i64[] = [3 as i64, 1 as i64, 4 as i64, 1 as i64, 5 as i64];
    match (cmp.max_of(arr)) {
        Some(m) => { return test.assert_eq(m, 5 as i64); },
        None => { return test.fail("max_i64 returned None on non-empty input"); }
    }
    return test.pass();
}

function test_min_i64(): test.TestOutcome {
    var arr: i64[] = [3 as i64, 1 as i64, 4 as i64];
    match (cmp.min_of(arr)) {
        Some(m) => { return test.assert_eq(m, 1 as i64); },
        None => { return test.fail("min_i64 returned None on non-empty input"); }
    }
    return test.pass();
}

function test_max_i64_empty(): test.TestOutcome {
    var arr: i64[] = [];
    match (cmp.max_of(arr)) {
        Some(_) => { return test.fail("expected None on empty"); },
        None => { return test.pass(); }
    }
    return test.pass();
}

function test_avg_i64(): test.TestOutcome {
    var arr: i64[] = [2 as i64, 4 as i64, 6 as i64];
    match (array.avg_i64(arr)) {
        Some(m) => { return test.assert_eq(m, 4 as i64); },
        None => { return test.fail("avg_i64 returned None"); }
    }
    return test.pass();
}

function test_sum_u32(): test.TestOutcome {
    var arr: u32[] = [10u32, 20u32, 30u32];
    return test.assert_eq(num.sum(arr), 60u32);
}

function test_max_u64_unsigned(): test.TestOutcome {
    // Values near u64-max — `max` must drive its compare
    // with unsigned semantics. If sign-extension contaminated
    // the compare, 18446744073709551615u64 would look smaller
    // than 1u64 (because as signed it's -1).
    var arr: u64[] = [18446744073709551615u64, 1u64, 1000u64];
    match (cmp.max_of(arr)) {
        Some(m) => { return test.assert_eq(m, 18446744073709551615u64); },
        None => { return test.fail("max_u64 returned None"); }
    }
    return test.pass();
}

function test_sum_f64(): test.TestOutcome {
    var arr: f64[] = [1.5, 2.5, 3.0];
    return test.assert_eq_f64_near(num.sum(arr), 7.0, 0.0);
}

function test_max_f64(): test.TestOutcome {
    var arr: f64[] = [1.5, 3.14, 2.5];
    match (cmp.max_of(arr)) {
        Some(m) => { return test.assert_eq_f64_near(m, 3.14, 0.0); },
        None => { return test.fail("max_f64 returned None"); }
    }
    return test.pass();
}

function test_avg_f64(): test.TestOutcome {
    // Mean of [1.0, 2.0, 3.0, 4.0] = 2.5
    var arr: f64[] = [1.0, 2.0, 3.0, 4.0];
    match (array.avg_f64(arr)) {
        Some(m) => { return test.assert_eq_f64_near(m, 2.5, 0.0001); },
        None => { return test.fail("avg_f64 returned None"); }
    }
    return test.pass();
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("array reductions");
    r = r.it("sum_i64",                   test_sum_i64);
    r = r.it("sum_i64 empty returns 0",   test_sum_i64_empty);
    r = r.it("max_i64",                   test_max_i64);
    r = r.it("min_i64",                   test_min_i64);
    r = r.it("max_i64 empty returns None", test_max_i64_empty);
    r = r.it("avg_i64",                   test_avg_i64);
    r = r.it("sum_u32",                   test_sum_u32);
    r = r.it("max_u64 unsigned semantics", test_max_u64_unsigned);
    r = r.it("sum_f64",                   test_sum_f64);
    r = r.it("max_f64",                   test_max_f64);
    r = r.it("avg_f64",                   test_avg_f64);
    return r.finish();
}
