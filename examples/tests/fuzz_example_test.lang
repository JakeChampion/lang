// examples/tests/fuzz_example_test.lang — `std/fuzz` walkthrough.
//
// Each fuzz target is a `(string) => Option[string]` function:
//   None       — the property held for this input
//   Some(msg)  — the property was violated; the runner records
//                the offending input alongside the message
//
// Inputs come from a seed corpus plus byte-level mutations
// (flip / drop / insert / unchanged). The harness runs every
// seed verbatim first, then iterates `iterations` mutated
// variants. Failures stop the loop and report a reproducer.

// Trivial "always passes" target — exercises the loop machinery
// without flagging any input. Use this to confirm a fuzz target
// doesn't crash on the supplied corpus before adding property
// checks.
function check_always_ok(input: string): Option[string] {
    return None;
}

// Property: len(input) is non-negative — always true, but
// useful as a smoke test of the integer-comparison path.
function check_len_nonneg(input: string): Option[string] {
    if (input.len() >= 0) { return None; }
    return Some("len returned negative for input of " + input.len().to_string() + " bytes");
}

// Property: an idempotent transform — `to_upper(to_upper(s))`
// equals `to_upper(s)`. Pure-Lang invariant, no external state.
function check_to_upper_idempotent(input: string): Option[string] {
    var once: string = input.to_upper();
    var twice: string = once.to_upper();
    if (once == twice) { return None; }
    return Some("to_upper is not idempotent: \"" + once + "\" vs \"" + twice + "\"");
}

// Property: trim() output never starts or ends with a space.
// The corpus seeds whitespace at both ends so the mutation
// path is exercising both sides.
function check_trim_strips_spaces(input: string): Option[string] {
    var trimmed: string = input.trim();
    if (trimmed.len() == 0) { return None; }
    if (trimmed[0] == 32) {
        return Some("trim left a leading space: \"" + trimmed + "\"");
    }
    if (trimmed[trimmed.len() - 1] == 32) {
        return Some("trim left a trailing space: \"" + trimmed + "\"");
    }
    return None;
}

function main(): i32 {
    var r: TestRunner = test_new("fuzz examples");

    r = r.fuzz("trivial",
               ["", "a", "hello world"],
               fuzz_default_iterations(),
               check_always_ok);

    r = r.fuzz("len is non-negative",
               ["", "x", "abc"],
               50,
               check_len_nonneg);

    r = r.fuzz("to_upper idempotent",
               ["", "abc", "Hello World", "MIXED case 123"],
               100,
               check_to_upper_idempotent);

    r = r.fuzz("trim strips edge spaces",
               ["   leading", "trailing   ", "  both  ", "no_space"],
               100,
               check_trim_strips_spaces);

    return r.finish();
}
