import "std/test";
// examples/tests/option_and_set_ops_test.fern — batch 26
// additions to std/test:
//   * Option result assertions:
//     `assert_is_some_i32` / `_string`,
//     `assert_is_none_i32` / `_string`,
//     `assert_is_some_eq_i32` / `_string`
//   * Array set-relation assertions:
//     `assert_array_intersects_i32` / `_string`,
//     `assert_array_disjoint_i32` / `_string`

// A toy lookup helper used as the "function under test".
function lookup(k: i32): Option[i32] {
    if (k == 1) { return Some(100); }
    if (k == 2) { return Some(200); }
    return None;
}

function test_is_some_i32_pass(): test.TestOutcome {
    return test.assert_is_some_i32(lookup(1));
}

function test_is_some_i32_none_fails(): test.TestOutcome {
    match (test.assert_is_some_i32(lookup(99))) {
        Pass => { return test.fail("expected None to fail is_some"); },
        Fail(msg) => {
            if (!msg.contains("got None")) {
                return test.fail("expected 'got None': " + msg);
            }
            return test.pass();
        }
    }
}

function test_is_none_i32_pass(): test.TestOutcome {
    return test.assert_is_none_i32(lookup(99));
}

function test_is_none_i32_some_fails_with_value(): test.TestOutcome {
    match (test.assert_is_none_i32(lookup(1))) {
        Pass => { return test.fail("expected Some to fail is_none"); },
        Fail(msg) => {
            // Failure must embed the unexpected payload.
            if (!msg.contains("Some(100)")) {
                return test.fail("expected 'Some(100)' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_is_some_eq_i32_pass(): test.TestOutcome {
    return test.assert_is_some_eq_i32(lookup(1), 100);
}

function test_is_some_eq_i32_wrong_value(): test.TestOutcome {
    match (test.assert_is_some_eq_i32(lookup(1), 999)) {
        Pass => { return test.fail("wrong-value should fail"); },
        Fail(msg) => {
            if (!msg.contains("got Some(100)") || !msg.contains("expected Some(999)")) {
                return test.fail("expected both Somes in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_is_some_eq_i32_none_fails(): test.TestOutcome {
    match (test.assert_is_some_eq_i32(lookup(99), 1)) {
        Pass => { return test.fail("None should fail is_some_eq"); },
        Fail(msg) => {
            // Distinct diagnostic from value-mismatch ("got
            // None, expected Some(...)") so the regression
            // mode is readable.
            if (!msg.contains("got None")) {
                return test.fail("expected 'got None': " + msg);
            }
            return test.pass();
        }
    }
}

function lookup_str(k: string): Option[string] {
    if (k == "hi") { return Some("hello"); }
    return None;
}

function test_is_some_eq_string_pass(): test.TestOutcome {
    return test.assert_is_some_eq_string(lookup_str("hi"), "hello");
}

function test_is_some_string_pass(): test.TestOutcome {
    return test.assert_is_some_string(lookup_str("hi"));
}

function test_is_none_string_pass(): test.TestOutcome {
    return test.assert_is_none_string(lookup_str("nope"));
}

function test_is_none_string_some_quotes_value(): test.TestOutcome {
    match (test.assert_is_none_string(lookup_str("hi"))) {
        Pass => { return test.fail("Some should fail is_none_string"); },
        Fail(msg) => {
            if (!msg.contains("Some(\"hello\")")) {
                return test.fail("expected quoted payload: " + msg);
            }
            return test.pass();
        }
    }
}

function test_intersects_i32_pass(): test.TestOutcome {
    return test.assert_array_intersects_i32([1, 2, 3], [3, 4, 5]);
}

function test_intersects_i32_no_overlap_fails(): test.TestOutcome {
    match (test.assert_array_intersects_i32([1, 2, 3], [4, 5, 6])) {
        Pass => { return test.fail("disjoint should fail intersects"); },
        Fail(msg) => {
            // Failure should mention the array lengths.
            if (!msg.contains("length 3 and 3")) {
                return test.fail("expected 'length 3 and 3': " + msg);
            }
            return test.pass();
        }
    }
}

function test_intersects_i32_empty_fails(): test.TestOutcome {
    var empty: i32[] = [];
    match (test.assert_array_intersects_i32(empty, [1, 2, 3])) {
        Pass => { return test.fail("empty A should fail intersects"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_intersects_string_pass(): test.TestOutcome {
    return test.assert_array_intersects_string(["a", "b"], ["b", "c"]);
}

function test_disjoint_i32_pass(): test.TestOutcome {
    return test.assert_array_disjoint_i32([1, 2, 3], [4, 5, 6]);
}

function test_disjoint_i32_shared_fails(): test.TestOutcome {
    match (test.assert_array_disjoint_i32([1, 2, 3], [3, 5, 7])) {
        Pass => { return test.fail("shared elem should fail disjoint"); },
        Fail(msg) => {
            if (!msg.contains("shared element 3")) {
                return test.fail("expected 'shared element 3': " + msg);
            }
            return test.pass();
        }
    }
}

function test_disjoint_i32_empty_vacuous(): test.TestOutcome {
    var empty: i32[] = [];
    return test.assert_array_disjoint_i32(empty, [1, 2, 3]);
}

function test_disjoint_string_pass(): test.TestOutcome {
    return test.assert_array_disjoint_string(["a", "b"], ["c", "d"]);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("Options + array set ops");
    r = r.it("is_some_i32 pass",                  test_is_some_i32_pass);
    r = r.it("is_some_i32 None fails",            test_is_some_i32_none_fails);
    r = r.it("is_none_i32 pass",                  test_is_none_i32_pass);
    r = r.it("is_none_i32 Some fails with value", test_is_none_i32_some_fails_with_value);
    r = r.it("is_some_eq_i32 pass",               test_is_some_eq_i32_pass);
    r = r.it("is_some_eq_i32 wrong value",        test_is_some_eq_i32_wrong_value);
    r = r.it("is_some_eq_i32 None distinct msg",  test_is_some_eq_i32_none_fails);
    r = r.it("is_some_eq_string pass",            test_is_some_eq_string_pass);
    r = r.it("is_some_string pass",               test_is_some_string_pass);
    r = r.it("is_none_string pass",               test_is_none_string_pass);
    r = r.it("is_none_string quotes payload",     test_is_none_string_some_quotes_value);
    r = r.it("intersects_i32 pass",               test_intersects_i32_pass);
    r = r.it("intersects_i32 no overlap + lens",  test_intersects_i32_no_overlap_fails);
    r = r.it("intersects_i32 empty fails",        test_intersects_i32_empty_fails);
    r = r.it("intersects_string pass",            test_intersects_string_pass);
    r = r.it("disjoint_i32 pass",                 test_disjoint_i32_pass);
    r = r.it("disjoint_i32 shared names value",   test_disjoint_i32_shared_fails);
    r = r.it("disjoint_i32 empty vacuous",        test_disjoint_i32_empty_vacuous);
    r = r.it("disjoint_string pass",              test_disjoint_string_pass);
    return r.finish();
}
