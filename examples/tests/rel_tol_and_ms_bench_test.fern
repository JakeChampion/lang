import "std/test";
// examples/tests/rel_tol_and_ms_bench_test.fern — exercises
// the two batch-18 additions to std/test:
//   * `test.assert_eq_f64_rel(actual, expected, rel_tol)` —
//     relative-tolerance float compare. Use when the test
//     covers values spanning many orders of magnitude and
//     a fixed absolute epsilon would be either too tight at
//     large scales or too loose at small ones.
//   * `(r).bench_max_ms(name, iter, fn, budget_ms)` —
//     millisecond-budget wrapper around `bench_max_us` so
//     test authors writing frame-budget-shaped assertions
//     ("under 16 ms") don't have to hand-multiply by 1000.

function test_rel_tol_passes_within_ratio(): test.TestOutcome {
    // 1% relative tolerance: 100.0 vs 100.5 is 0.5%.
    return test.assert_eq_f64_rel(100.5, 100.0, 0.01);
}

function test_rel_tol_fails_outside_ratio(): test.TestOutcome {
    // 0.1% tolerance against a 1% diff — must fail.
    match (test.assert_eq_f64_rel(101.0, 100.0, 0.001)) {
        Pass => { return test.fail("expected rel_tol mismatch to be reported"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_rel_tol_scale_invariance(): test.TestOutcome {
    // The whole point of relative tolerance: 1% works
    // across both microscale and gigascale magnitudes.
    // (Lexer doesn't take scientific notation yet, so we
    // compose the scales by multiplication.)
    var small_base: f64 = 0.000001;             // 1e-6
    var small_diff: f64 = 0.000000001;          // 1e-9, i.e. 0.1% of base
    var lo: test.TestOutcome = test.assert_eq_f64_rel(small_base + small_diff, small_base, 0.01);
    match (lo) {
        Fail(msg) => { return test.fail("small-scale: " + msg); },
        Pass => {}
    }
    var big_base: f64 = 1000000000.0;           // 1e9
    var big_diff: f64 = 1000000.0;              // 1e6, i.e. 0.1% of base
    return test.assert_eq_f64_rel(big_base + big_diff, big_base, 0.01);
}

function test_rel_tol_zero_expected_falls_back_to_abs(): test.TestOutcome {
    // expected == 0.0 makes the ratio undefined; helper
    // compares |actual| directly against rel_tol.
    return test.assert_eq_f64_rel(0.0001, 0.0, 0.001);
}

function test_rel_tol_zero_expected_with_too_large_actual(): test.TestOutcome {
    match (test.assert_eq_f64_rel(0.5, 0.0, 0.001)) {
        Pass => { return test.fail("expected 0.5 vs 0 to fail at rel_tol=0.001"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_rel_tol_nan_actual_fails(): test.TestOutcome {
    var z: f64 = 0.0;
    var nan: f64 = z / z;
    match (test.assert_eq_f64_rel(nan, 1.0, 0.01)) {
        Pass => { return test.fail("NaN actual should fail rel compare"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_rel_tol_nan_expected_fails(): test.TestOutcome {
    var z: f64 = 0.0;
    var nan: f64 = z / z;
    match (test.assert_eq_f64_rel(1.0, nan, 0.01)) {
        Pass => { return test.fail("NaN expected should fail rel compare"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_rel_tol_negative_expected(): test.TestOutcome {
    // |denom| not denom itself — must work for negative
    // expecteds.
    return test.assert_eq_f64_rel(0.0 - 1000.0, 0.0 - 999.0, 0.01);
}

function test_rel_tol_f32_mirror(): test.TestOutcome {
    var actual: f32 = 1005.0 as f32;
    var expected: f32 = 1000.0 as f32;
    return test.assert_eq_f32_rel(actual, expected, 0.01 as f32);
}

function workload_tiny(): void {
    var i: i32 = 0;
    var sum: i32 = 0;
    while (i < 100) { sum = sum + i; i = i + 1; }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("rel-tol + ms-bench");
    r = r.it("rel_tol passes within ratio",
             test_rel_tol_passes_within_ratio());
    r = r.it("rel_tol fails outside ratio",
             test_rel_tol_fails_outside_ratio());
    r = r.it("rel_tol scale invariance (1e-9 + 1e9)",
             test_rel_tol_scale_invariance());
    r = r.it("rel_tol zero expected falls back to abs",
             test_rel_tol_zero_expected_falls_back_to_abs());
    r = r.it("rel_tol zero expected with too-large actual",
             test_rel_tol_zero_expected_with_too_large_actual());
    r = r.it("rel_tol NaN actual fails",
             test_rel_tol_nan_actual_fails());
    r = r.it("rel_tol NaN expected fails",
             test_rel_tol_nan_expected_fails());
    r = r.it("rel_tol handles negative expected",
             test_rel_tol_negative_expected());
    r = r.it("rel_tol f32 mirror",
             test_rel_tol_f32_mirror());

    // ms-budget bench — 1000 ms is plenty for a 100-iter
    // tiny arithmetic loop. Same generous slack as the
    // bench_test.fern sibling for the same reason: shared
    // CI runners occasionally pause. Tightening this is
    // tempting but consistently flaky.
    r = r.bench_max_ms("tiny loop under 1000ms budget",
                      10, workload_tiny, 1000 as i64);
    return r.finish();
}
