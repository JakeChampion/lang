import "std/test";
import "std/textwrap" as textwrap;
// examples/tests/textwrap_test.fern — pure-Fern coverage of
// std/textwrap.word_wrap: greedy wrapping at word boundaries, the
// exact-fit boundary, long words on their own line, hard-newline /
// blank-line preservation, space collapsing, and the edge widths.

function test_greedy_wrap(): test.TestOutcome {
    return test.assert_eq(textwrap.word_wrap("the quick brown fox", 10), "the quick\nbrown fox");
}

function test_fits_on_one_line(): test.TestOutcome {
    return test.assert_eq(textwrap.word_wrap("the quick brown fox", 100), "the quick brown fox");
}

function test_boundary(): test.TestOutcome {
    // "aa bb" is 5 wide: fits at width 5, breaks at width 4.
    if (textwrap.word_wrap("aa bb", 5) != "aa bb") { return test.fail("width 5 should fit"); }
    return test.assert_eq(textwrap.word_wrap("aa bb", 4), "aa\nbb");
}

function test_long_word(): test.TestOutcome {
    // A word longer than the width goes on its own line, unbroken.
    return test.assert_eq(textwrap.word_wrap("supercalifragilistic hi", 5), "supercalifragilistic\nhi");
}

function test_preserves_hard_newlines(): test.TestOutcome {
    // Existing newlines are hard breaks; a blank line stays blank.
    return test.assert_eq(textwrap.word_wrap("a b\n\nc d", 10), "a b\n\nc d");
}

function test_collapses_spaces_and_edges(): test.TestOutcome {
    if (textwrap.word_wrap("a   b", 10) != "a b") { return test.fail("collapse runs of spaces"); }
    if (textwrap.word_wrap("", 10) != "") { return test.fail("empty"); }
    // A non-positive width returns the input unchanged.
    return test.assert_eq(textwrap.word_wrap("a b c", 0), "a b c");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/textwrap");
    r = r.it("greedy wrap",        test_greedy_wrap);
    r = r.it("fits one line",      test_fits_on_one_line);
    r = r.it("boundary",           test_boundary);
    r = r.it("long word",          test_long_word);
    r = r.it("hard newlines",      test_preserves_hard_newlines);
    r = r.it("collapse + edges",   test_collapses_spaces_and_edges);
    return r.finish();
}
