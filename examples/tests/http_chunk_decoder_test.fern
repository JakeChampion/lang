import "std/test";
import "std/http";

// examples/tests/http_chunk_decoder_test.fern — `http.ChunkDecoder`, the
// chunked body decoded as it arrives (docs/NET-P3-SUSPENSION-PLAN.md
// §3.9), against the whole-request parser: every fixture fed whole, a
// byte at a time and in uneven pieces must answer what the parser answers
// for the same bytes — the decoded data, the trailers, how much lies past
// the body, or the refusing status — since the decoder is the parser's
// walk through the parser's own helpers.
//
// Run:  fern -interp examples/tests/http_chunk_decoder_test.fern

const HEAD: string = "POST /up HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n";

// `walked(body, limits)` — the parser's answer for a request carrying
// `body` (the chunked bytes and whatever follows them).
function walked(body: string, limits: http.HttpLimits): string {
  let wire: string = HEAD + body;
  match (http.http_parse_request_framed_from(wire.bytes(), 0, limits)) {
    http.Framed(f) => {
      return "ok:" + string_from_bytes_unchecked(f.request.body_bytes()) + "|" + fields(f.request.trailers) + "|rest=" + (wire.len() - f.len).to_string();
    },
    http.Incomplete => {
      return "incomplete";
    },
    http.Continue => {
      return "continue";
    },
    http.Malformed(status) => {
      return "refused:" + status.to_string();
    }
  }
  return "?";
}

// `decoded(body, piece, limits)` — the decoder's answer for `body` fed
// `piece` bytes at a time (whole when 0).
function decoded(body: string, piece: i32, limits: http.HttpLimits): string {
  let bytes: u8[] = body.bytes();
  let d: http.ChunkDecoder = http.chunk_decoder(limits);
  let data: u8[] = [];
  let at: i32 = 0;
  while (at < bytes.len() || at == 0) {
    let end: i32 = bytes.len();
    if (piece > 0 && at + piece < end) {
      end = at + piece;
    }
    match (d.feed(slice_bytes(bytes, at, end))) {
      http.ChunkData(next, got) => {
        d = next;
        data = data.concat(got);
      },
      http.ChunkEnd(got, trailers, rest) => {
        // What the feed answered as past the body, and what was never fed.
        return "ok:" + string_from_bytes_unchecked(data.concat(got)) + "|" + fields(trailers) + "|rest=" + (rest.len() + bytes.len() - end).to_string();
      },
      http.ChunkRefused(status) => {
        return "refused:" + status.to_string();
      }
    }
    at = end;
    if (bytes.len() == 0) {
      return "incomplete";
    }
  }
  return "incomplete";
}

function slice_bytes(bytes: u8[], from: i32, end: i32): u8[] {
  let out: u8[] = [];
  let i: i32 = from;
  while (i < end) {
    out = out.append(bytes[i]);
    i = i + 1;
  }
  return out;
}

function fields(h: HeaderMap): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < h.names.len()) {
    out = out + h.names[i] + "=" + h.values[i] + ";";
    i = i + 1;
  }
  return out;
}

// `agree(body, limits)` — the parser's answer when every feeding agrees
// with it, else the disagreement.
function agree(body: string, limits: http.HttpLimits): string {
  let want: string = walked(body, limits);
  for piece in [0, 1, 3, 7] {
    let got: string = decoded(body, piece, limits);
    if (got != want) {
      return "piece " + piece.to_string() + ": " + got + " != " + want;
    }
  }
  return want;
}

function limits(): http.HttpLimits {
  return http.http_limits();
}

function test_extensions_trailers_and_a_pipelined_request(): test.TestOutcome {
  let body: string = "5;ext=\"x\"\r\nhello\r\n06\r\n world\r\n0\r\nX-Sum: 11\r\n\r\nGET /next HTTP/1.1\r\nHost: h\r\n\r\n";
  return test.assert_eq(agree(body, limits()), "ok:hello world|X-Sum=11;|rest=31");
}

function test_sizes_with_leading_zeros(): test.TestOutcome {
  return test.assert_eq(agree("0A\r\n0123456789\r\n000\r\n\r\n", limits()), "ok:0123456789||rest=0");
}

function test_empty_body(): test.TestOutcome {
  return test.assert_eq(agree("0\r\n\r\n", limits()), "ok:||rest=0");
}

function test_extension_after_whitespace(): test.TestOutcome {
  return test.assert_eq(agree("5 ;a=b\r\nhello\r\n0\r\n\r\n", limits()), "ok:hello||rest=0");
}

function test_one_byte_chunks(): test.TestOutcome {
  return test.assert_eq(agree("1\r\na\r\n1\r\nb\r\n1\r\nc\r\n0\r\n\r\n", limits()), "ok:abc||rest=0");
}

function test_a_byte_where_the_crlf_must_be(): test.TestOutcome {
  return test.assert_eq(agree("5\r\nhelloX\r\n0\r\n\r\n", limits()), "refused:400");
}

function test_no_hex_digit(): test.TestOutcome {
  return test.assert_eq(agree("zz\r\nab\r\n0\r\n\r\n", limits()), "refused:400");
}

function test_an_empty_extension(): test.TestOutcome {
  return test.assert_eq(agree("5;\r\nhello\r\n0\r\n\r\n", limits()), "refused:400");
}

function test_a_bare_lf(): test.TestOutcome {
  return test.assert_eq(agree("5\nhello\r\n0\r\n\r\n", limits()), "refused:400");
}

function test_a_chunk_past_the_body_cap(): test.TestOutcome {
  let small: http.HttpLimits = http.HttpLimits { ...limits(), body: 4 };
  return test.assert_eq(agree("5\r\nhello\r\n0\r\n\r\n", small), "refused:413");
}

function test_chunks_adding_up_past_the_body_cap(): test.TestOutcome {
  let small: http.HttpLimits = http.HttpLimits { ...limits(), body: 8 };
  return test.assert_eq(agree("5\r\nhello\r\n5\r\nworld\r\n0\r\n\r\n", small), "refused:413");
}

function test_a_size_line_past_the_framing_budget(): test.TestOutcome {
  let tight: http.HttpLimits = http.HttpLimits { ...limits(), header_bytes: 48 };
  let ext: string = "5;aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa=b\r\n";
  return test.assert_eq(agree(ext + "hello\r\n0\r\n\r\n", tight), "refused:431");
}

function test_a_trailer_without_a_colon(): test.TestOutcome {
  return test.assert_eq(agree("5\r\nhello\r\n0\r\nX-Sum 11\r\n\r\n", limits()), "refused:400");
}

function test_a_body_cut_short_is_incomplete(): test.TestOutcome {
  return test.assert_eq(agree("5\r\nhel", limits()), "incomplete");
}

function test_data_is_answered_before_its_crlf(): test.TestOutcome {
  // The decoder passes a chunk's data on as it arrives, without waiting
  // for the CRLF after it, so a large chunk is never held.
  match (http.chunk_decoder(limits()).feed("5\r\nhel".bytes())) {
    http.ChunkData(next, got) => {
      return test.assert_eq(string_from_bytes_unchecked(got), "hel");
    },
    http.ChunkEnd(got, trailers, rest) => {
      return test.fail("ended");
    },
    http.ChunkRefused(status) => {
      return test.fail("refused " + status.to_string());
    }
  }
  return test.fail("unreachable");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("http.ChunkDecoder against the parser");
  r = r.it("extensions, trailers and a pipelined request", test_extensions_trailers_and_a_pipelined_request);
  r = r.it("sizes with leading zeros", test_sizes_with_leading_zeros);
  r = r.it("an empty body", test_empty_body);
  r = r.it("an extension after whitespace", test_extension_after_whitespace);
  r = r.it("one-byte chunks", test_one_byte_chunks);
  r = r.it("a byte where the CRLF must be", test_a_byte_where_the_crlf_must_be);
  r = r.it("no hex digit", test_no_hex_digit);
  r = r.it("an empty extension", test_an_empty_extension);
  r = r.it("a bare LF", test_a_bare_lf);
  r = r.it("a chunk past the body cap", test_a_chunk_past_the_body_cap);
  r = r.it("chunks adding up past the body cap", test_chunks_adding_up_past_the_body_cap);
  r = r.it("a size line past the framing budget", test_a_size_line_past_the_framing_budget);
  r = r.it("a trailer without a colon", test_a_trailer_without_a_colon);
  r = r.it("a body cut short is incomplete", test_a_body_cut_short_is_incomplete);
  r = r.it("data is answered before its CRLF", test_data_is_answered_before_its_crlf);
  return r.finish();
}
