import "std/test";
import "std/base64" as base64;

// examples/tests/base64_test.fern — exercise the deterministic
// std/base64 encoder/decoder through the test runner. std/base64 had
// only Go-side coverage; this is the pure-Fern, std/test-driven shape,
// gated through the self-host IR path (TestSelfHostStdTestE2E) so the
// byte/string lowering is proven end to end on the self-hosted compiler.
// (std/hex has its own sibling suite, hex_test.fern.)

// Three-byte groups encode to four base64 chars with no padding.
function test_encode_no_pad(): test.TestOutcome {
    return test.assert_eq(base64.base64_encode("Man"), "TWFu");
}

// A two-byte tail leaves one `=` pad; a one-byte tail leaves two.
function test_encode_one_pad(): test.TestOutcome {
    return test.assert_eq(base64.base64_encode("Ma"), "TWE=");
}

function test_encode_two_pad(): test.TestOutcome {
    return test.assert_eq(base64.base64_encode("M"), "TQ==");
}

function test_encode_longer(): test.TestOutcome {
    return test.assert_eq(base64.base64_encode("hello"), "aGVsbG8=");
}

function test_encode_empty(): test.TestOutcome {
    return test.assert_eq(base64.base64_encode(""), "");
}

function test_decode_no_pad(): test.TestOutcome {
    return test.assert_eq(base64.base64_decode("TWFu"), "Man");
}

function test_decode_one_pad(): test.TestOutcome {
    return test.assert_eq(base64.base64_decode("TWE="), "Ma");
}

function test_decode_two_pad(): test.TestOutcome {
    return test.assert_eq(base64.base64_decode("TQ=="), "M");
}

function test_decode_empty(): test.TestOutcome {
    return test.assert_eq(base64.base64_decode(""), "");
}

// decode . encode is the identity on arbitrary text.
function test_roundtrip(): test.TestOutcome {
    var s = "The quick brown fox jumps over the lazy dog.";
    return test.assert_eq(base64.base64_decode(base64.base64_encode(s)), s);
}

// base64_decode_strict returns Some(bytes) on well-formed input.
function test_decode_strict_valid(): test.TestOutcome {
    match (base64.base64_decode_strict("Zm9vYmFy")) {
        Some(v) => { return test.assert_eq(v, "foobar"); },
        None => { return test.assert_true(false); },
    }
}
// ...and None on malformed input, instead of the lenient variant's silent
// truncation (#4384): a bad char mid-token, a char after padding, and bare
// padding all reject.
function b64_is_none(s: string): boolean {
    match (base64.base64_decode_strict(s)) { Some(v) => { return false; }, None => { return true; } }
}
function test_decode_strict_rejects(): test.TestOutcome {
    return test.assert_true(
        b64_is_none("!!!invalid!!!")
        && b64_is_none("Zm9v!")
        && b64_is_none("=="));
}

// URL-safe variant: the `-`/`_` alphabet, no `=` padding.
function test_url_alphabet(): test.TestOutcome {
    // 0xFFFFFF → standard "////" → url-safe "____"; no '+' '/' '=' anywhere.
    var s: string = string_from_bytes([255 as u8, 255 as u8, 255 as u8]);
    return test.assert_eq(base64.base64url_encode(s), "____");
}

function test_url_no_padding(): test.TestOutcome {
    // "Hi" is 2 bytes → standard "SGk=" (one pad); url-safe drops it.
    return test.assert_eq(base64.base64url_encode("Hi"), "SGk");
}

function test_url_roundtrip(): test.TestOutcome {
    var payload: string = "Hello, World! ~ tokens+need/url-safety";
    var enc: string = base64.base64url_encode(payload);
    // Decoding accepts the unpadded url-safe form back to the original.
    return test.assert_true(base64.base64url_decode(enc) == payload &&
                            base64.base64url_decode("SGk=") == "Hi");  // padded input tolerated
}

// base64url_decode_strict: url round-trips; malformed / non-url-safe rejects.
function b64url_opt(o: Option[string], fb: string): string {
    match (o) { Some(v) => { return v; }, None => { return fb; } }
}
function b64url_is_none(s: string): boolean {
    match (base64.base64url_decode_strict(s)) { Some(v) => { return false; }, None => { return true; } }
}

function test_url_decode_strict_valid(): test.TestOutcome {
    // Unpadded "Hi" → "SGk"; empty → Some("").
    if (b64url_opt(base64.base64url_decode_strict("SGk"), "X") != "Hi") { return test.fail("SGk"); }
    if (b64url_opt(base64.base64url_decode_strict(base64.base64url_encode("Hello")), "X") != "Hello") { return test.fail("roundtrip"); }
    return test.assert_eq(b64url_opt(base64.base64url_decode_strict(""), "X"), "");
}

function test_url_decode_strict_rejects(): test.TestOutcome {
    // The non-url-safe +// chars reject, and so does junk / bad padding.
    if (!b64url_is_none("SGVsbG8+")) { return test.fail("plus"); }
    if (!b64url_is_none("SGVs/bG8")) { return test.fail("slash"); }
    return test.assert_true(b64url_is_none("SG!k") && b64url_is_none("A"));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/base64");
    r = r.it("encode (no pad)", test_encode_no_pad());
    r = r.it("encode (one pad)", test_encode_one_pad());
    r = r.it("encode (two pad)", test_encode_two_pad());
    r = r.it("encode (longer)", test_encode_longer());
    r = r.it("encode (empty)", test_encode_empty());
    r = r.it("decode (no pad)", test_decode_no_pad());
    r = r.it("decode (one pad)", test_decode_one_pad());
    r = r.it("decode (two pad)", test_decode_two_pad());
    r = r.it("decode (empty)", test_decode_empty());
    r = r.it("roundtrip", test_roundtrip());
    r = r.it("decode_strict valid", test_decode_strict_valid());
    r = r.it("decode_strict rejects", test_decode_strict_rejects());
    r = r.it("url alphabet", test_url_alphabet());
    r = r.it("url no padding", test_url_no_padding());
    r = r.it("url roundtrip", test_url_roundtrip());
    r = r.it("url decode_strict valid", test_url_decode_strict_valid());
    r = r.it("url decode_strict rejects", test_url_decode_strict_rejects());
    return r.finish();
}
