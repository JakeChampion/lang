import "std/test";
import "std/http";
import "std/stream";
import "std/string";

// examples/tests/http_body_test.fern — the five bodies an HttpResponse
// carries (#9854): text and bytes held whole, a Stream's remainder, a
// file the serve loop streams as it writes the response
// (`http_materialize` reads one whole for a test), a missing file
// answered 404 in its place, and the chunks a producer answers.

function test_text_body(): test.TestOutcome {
  let resp: HttpResponse = http.ok("hello");
  if (resp.body_len() != 5) {
    return test.fail("len: " + resp.body_len().to_string());
  }
  if (!http.http_serialize_response(resp).ends_with("\r\n\r\nhello")) {
    return test.fail("wire: " + http.http_serialize_response(resp));
  }
  return test.assert_body(resp, "hello");
}

function test_bytes_body(): test.TestOutcome {
  let bs: u8[] = [104u8, 105u8];
  let resp: HttpResponse = http.bytes(201, bs);
  if (resp.body_len() != 2) {
    return test.fail("len: " + resp.body_len().to_string());
  }
  if (resp.body_bytes().len() != 2) {
    return test.fail("bytes: " + resp.body_bytes().len().to_string());
  }
  return test.assert_body(resp, "hi");
}

function test_stream_body_from_its_cursor(): test.TestOutcome {
  let s: Stream = stream.stream_from_bytes("skip me".bytes());
  let taken: (u8[], Stream) = s.read_n(5);
  let resp: HttpResponse = http.stream(200, taken.1);
  if (resp.body_len() != 2) {
    return test.fail("len: " + resp.body_len().to_string());
  }
  return test.assert_body(resp, "me");
}

function scratch(name: string): string {
  match (temp_dir("fern_http_body")) {
    Ok(dir) => {
      return dir + "/" + name;
    },
    Err(e) => {
      return name;
    }
  }
  return name;
}

function test_file_body_is_read_by_the_loop(): test.TestOutcome {
  let path: string = scratch("present.txt");
  match (write_file(path, "from a file")) {
    Ok(v) => {},
    Err(e) => {
      return test.fail("write_file failed");
    }
  }
  let resp: HttpResponse = http.file(path);
  if (resp.body_len() != 0) {
    return test.fail("a file body has no length before the loop reads it");
  }
  if (resp.body_string() != "") {
    return test.fail("a file body is not read by the handler");
  }
  let whole: HttpResponse = http.http_materialize(resp);
  if (whole.status != 200) {
    return test.fail("status: " + whole.status.to_string());
  }
  if (whole.body_len() != 11) {
    return test.fail("len: " + whole.body_len().to_string());
  }
  return test.assert_body(whole, "from a file");
}

function test_a_missing_file_is_a_404(): test.TestOutcome {
  let resp: HttpResponse = http.http_materialize(http.file(scratch("missing.txt")));
  if (resp.status != 404) {
    return test.fail("status: " + resp.status.to_string());
  }
  return test.assert_body(resp, "Not Found");
}

function three_chunks(i: i32): Option[u8[]] {
  if (i >= 3) {
    return None;
  }
  return Some(("c" + i.to_string()).bytes());
}

function test_a_chunks_body_reads_as_its_chunks_joined(): test.TestOutcome {
  let resp: HttpResponse = http.chunks(200, three_chunks);
  if (resp.body_len() != 6) {
    return test.fail("len: " + resp.body_len().to_string());
  }
  if (!http.http_serialize_response(resp).ends_with("\r\n\r\nc0c1c2")) {
    return test.fail("wire: " + http.http_serialize_response(resp));
  }
  return test.assert_body(resp, "c0c1c2");
}

function test_other_bodies_pass_through_materialize(): test.TestOutcome {
  let resp: HttpResponse = http.http_materialize(http.ok("as is"));
  return test.assert_body(resp, "as is");
}

function main(): i32 {
  let t: test.TestRunner = test.test_new("HttpResponse bodies");
  t = t.it("a text body", test_text_body);
  t = t.it("a bytes body", test_bytes_body);
  t = t.it("a stream body is its remainder", test_stream_body_from_its_cursor);
  t = t.it("a file body is read by the loop", test_file_body_is_read_by_the_loop);
  t = t.it("a missing file is a 404", test_a_missing_file_is_a_404);
  t = t.it("a chunks body reads as its chunks joined", test_a_chunks_body_reads_as_its_chunks_joined);
  t = t.it("other bodies pass through materialize", test_other_bodies_pass_through_materialize);
  return t.finish();
}
