import "std/test";
// examples/tests/string_prelude_migrated_test.fern —
// Proof-of-concept Fern port of `TestInterpScriptStringPrelude`
// from `internal/e2e/interp_script_test.go`.
//
// The original Go test pinned the same surface by piping
// an inline Fern program through `fern -interp` and
// checking the exit code + stdout. The migration replaces
// that subprocess-and-grep shape with direct in-process
// assertions: the program *IS* the test, and the
// test.TestRunner reports each property as its own TAP case.
//
// Coverage matched against the Go version:
//   1. `s.bytes()` length is 5
//   2. `s.bytes()[0]` is 'H' (72)
//   3. `s.bytes()[4]` is 'o' (111)
//   4. `s.as_bytes()` length is 5
//   5. `s.as_bytes()[0]` is 'H'
//   6. `s.to_upper()` is "HELLO"
//   7. `s.to_lower()` is "hello"
//   8. `string_from_bytes_unchecked(s.bytes())` round-trips to "Hello"
//
// The Go test also checked stdout was exactly
// `Hello\nHELLO\nhello\n`. We drop that piece: the
// migrated test exercises the same print()-able strings
// via direct equality (cases 6–8), so the only thing the
// stdout check would catch is print() itself being
// broken — and the runner's TAP output already depends
// on print() working.

function test_bytes_len_is_5(): test.TestOutcome {
    var s: string = "Hello";
    var bs: u8[] = s.bytes();
    return test.assert_eq(bs.len(), 5);
}

function test_bytes_first_byte_is_H(): test.TestOutcome {
    var s: string = "Hello";
    var bs: u8[] = s.bytes();
    return test.assert_eq(bs[0] as i32, 72);
}

function test_bytes_last_byte_is_lowercase_o(): test.TestOutcome {
    var s: string = "Hello";
    var bs: u8[] = s.bytes();
    return test.assert_eq(bs[4] as i32, 111);
}

function test_as_bytes_len_is_5(): test.TestOutcome {
    var s: string = "Hello";
    var ab: [u8] = s.as_bytes();
    return test.assert_eq(ab.len(), 5);
}

function test_as_bytes_first_byte_is_H(): test.TestOutcome {
    var s: string = "Hello";
    var ab: [u8] = s.as_bytes();
    return test.assert_eq(ab[0] as i32, 72);
}

function test_to_upper_HELLO(): test.TestOutcome {
    var s: string = "Hello";
    return test.assert_eq(s.to_upper(), "HELLO");
}

function test_to_lower_hello(): test.TestOutcome {
    var s: string = "Hello";
    return test.assert_eq(s.to_lower(), "hello");
}

function test_string_from_bytes_roundtrip(): test.TestOutcome {
    var s: string = "Hello";
    var rt: string = string_from_bytes_unchecked(s.bytes());
    return test.assert_eq(rt, "Hello");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("string prelude (migrated)");
    r = r.it("s.bytes() length is 5",
             test_bytes_len_is_5());
    r = r.it("s.bytes()[0] is 'H' (72)",
             test_bytes_first_byte_is_H());
    r = r.it("s.bytes()[4] is 'o' (111)",
             test_bytes_last_byte_is_lowercase_o());
    r = r.it("s.as_bytes() length is 5",
             test_as_bytes_len_is_5());
    r = r.it("s.as_bytes()[0] is 'H'",
             test_as_bytes_first_byte_is_H());
    r = r.it("s.to_upper() returns HELLO",
             test_to_upper_HELLO());
    r = r.it("s.to_lower() returns hello",
             test_to_lower_hello());
    r = r.it("string_from_bytes_unchecked(s.bytes()) round-trips",
             test_string_from_bytes_roundtrip());
    return r.finish();
}
