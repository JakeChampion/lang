import "std/test";
import "std/json" as json;
// examples/tests/json_roundtrip_test.fern — pure-Fern coverage of std/json's
// parse → typed-get → encode surface. json_detail_test / json_field_eq_test
// exercise std/json only INDIRECTLY through std/test's assert_json_* helpers
// (has_key / eq_field_bool|string / array_len / object_size); this drives the
// raw API directly:
//   json_parse                       (string → Option[JsonValue])
//   json_get_string / _bool / _i32   (typed field extraction → Option[T])
//   json_get + json_is_null          (the JNull predicate)
//   json_get_array                   (JArray navigation → JsonValue[])
//   json_encode                      (JsonValue → string; the parse inverse)
// The typed getters return Option[primitive] so the suite never names a
// JsonValue variant directly; json_encode walks the JArray array-payload-enum
// variant, the path the assert_json_* helpers don't reach. The Go-side suite
// unit-tests these; this is the migration-shaped (pure-Fern, std/test-driven,
// self-host-gated) companion.

function doc(): string {
    return "{\"name\":\"fern\",\"age\":3,\"active\":true,\"tags\":[\"a\",\"b\"],\"meta\":null}";
}

// ---- typed field extraction ----

function test_get_string(): test.TestOutcome {
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get_string(obj, "name")) {
                Some(v) => { return test.assert_eq(v, "fern"); },
                None => { return test.fail("expected Some(name)"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

function test_get_i32(): test.TestOutcome {
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get_i32(obj, "age")) {
                Some(v) => { return test.assert_eq(v, 3); },
                None => { return test.fail("expected Some(age)"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

function test_get_bool(): test.TestOutcome {
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get_bool(obj, "active")) {
                Some(v) => { return test.assert_true(v); },
                None => { return test.fail("expected Some(active)"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

function test_get_missing(): test.TestOutcome {
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get_string(obj, "nope")) {
                Some(v) => { return test.fail("expected None for missing key"); },
                None => { return test.pass(); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

function test_get_wrong_type(): test.TestOutcome {
    // "name" is a string → json_get_i32 must return None, not coerce.
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get_i32(obj, "name")) {
                Some(v) => { return test.fail("expected None for non-number"); },
                None => { return test.pass(); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

// ---- null predicate ----

function test_is_null(): test.TestOutcome {
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get(obj, "meta")) {
                Some(v) => { return test.assert_true(json.json_is_null(v)); },
                None => { return test.fail("expected meta key"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

// ---- array navigation (JArray payload) ----

function test_get_array(): test.TestOutcome {
    match (json.json_parse(doc())) {
        Some(obj) => {
            match (json.json_get_array(obj, "tags")) {
                Some(arr) => {
                    // two elements; encode the first back to its JSON text.
                    return test.assert_true(arr.len() == 2 && json.json_encode(arr[0]) == "\"a\"");
                },
                None => { return test.fail("expected tags array"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

// ---- encode (the parse inverse) ----

function test_encode_array_round_trip(): test.TestOutcome {
    // Array order is deterministic, so the round-trip is exact.
    match (json.json_parse("[1,2,3]")) {
        Some(v) => { return test.assert_eq(json.json_encode(v), "[1,2,3]"); },
        None => { return test.fail("parse failed"); }
    }
}

function test_encode_scalars(): test.TestOutcome {
    var ok: boolean = true;
    match (json.json_parse("true")) {
        Some(v) => { ok = ok && json.json_encode(v) == "true"; },
        None => { return test.fail("parse true failed"); }
    }
    match (json.json_parse("null")) {
        Some(v) => { ok = ok && json.json_encode(v) == "null"; },
        None => { return test.fail("parse null failed"); }
    }
    match (json.json_parse("42")) {
        Some(v) => { ok = ok && json.json_encode(v) == "42"; },
        None => { return test.fail("parse 42 failed"); }
    }
    return test.assert_true(ok);
}

function test_encode_string_escape(): test.TestOutcome {
    // A quote inside the string must re-escape on encode.
    match (json.json_parse("\"a\\\"b\"")) {
        Some(v) => { return test.assert_eq(json.json_encode(v), "\"a\\\"b\""); },
        None => { return test.fail("parse failed"); }
    }
}

// Every escape branch back-to-back — the five named escapes (" \ \n \r \t) plus
// a control byte (, the 6-byte branch) — re-encodes byte-for-byte. Guards
// the two-pass exact-size buffer: a miscount would corrupt or truncate here.
function test_encode_string_escape_all(): test.TestOutcome {
    var j: string = "\"a\\\"b\\\\c\\nd\\re\\tf\\u0001g\"";
    match (json.json_parse(j)) {
        Some(v) => { return test.assert_eq(json.json_encode(v), j); },
        None => { return test.fail("parse failed"); }
    }
}

// The string-value PARSER decode path (#4379): a `\uXXXX` BMP escape, an astral
// surrogate PAIR (😀 → U+1F600, the 4-byte UTF-8 emit), a lone/
// mismatched surrogate falling back to U+FFFD, and a long literal run that grows
// the decode buffer across reallocations — all decoded into the u8[] accumulator
// and re-encoded byte-for-byte. Guards the surrogate-combine + codepoint-emit
// branches a buffer miscount would corrupt.
function __reencode(input: string): string {
    match (json.json_parse(input)) {
        Some(v) => { return json.json_encode(v); },
        None => { return "PARSE_FAIL"; }
    }
}

function test_parse_string_decode_paths(): test.TestOutcome {
    // BMP escape é (U+00E9) + astral 😀 (U+1F600, surrogate pair) re-encode as
    // their raw UTF-8 (json_encode only escapes the mandatory set, not printable
    // multibyte), so a decode→encode round-trip yields the literal characters.
    if (__reencode("\"x\\u00e9y\\ud83d\\ude00z\"") != "\"xéy😀z\"") {
        return test.fail("astral/bmp decode: " + __reencode("\"x\\u00e9y\\ud83d\\ude00z\""));
    }
    // A lone high surrogate with no following low → U+FFFD (replacement char,
    // UTF-8 EF BF BD).
    var fffd: string = string_from_bytes([239 as u8, 191 as u8, 189 as u8]);
    var lone: string = __reencode("\"a\\ud83db\"");
    if (lone != "\"a" + fffd + "b\"") { return test.fail("lone surrogate decode: " + lone); }
    // A long literal run (buffer grows across reallocations) decodes intact.
    var long_in: string = "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"";
    return test.assert_eq(__reencode(long_in), long_in);
}

// A nested array-of-objects with mixed scalars re-encodes byte-for-byte through
// the recursive JArray + JObject arms — the ones whose per-level accumulation
// moved from `out = out + …` to the growable-u8[] buffer (#4379). Exercises the
// comma separators, quoted+escaped keys, and the nested-object recursion in one
// shot; a buffer miscount here would reorder or truncate the output.
function test_encode_nested_round_trip(): test.TestOutcome {
    var j: string = "{\"items\":[{\"id\":1,\"tag\":\"a\\\"b\"},{\"id\":2,\"kids\":[3,4]}],\"ok\":true}";
    match (json.json_parse(j)) {
        Some(v) => { return test.assert_eq(json.json_encode(v), j); },
        None => { return test.fail("parse failed"); }
    }
}

function test_parse_invalid(): test.TestOutcome {
    // Trailing garbage → None.
    match (json.json_parse("{\"a\":1} trailing")) {
        Some(v) => { return test.fail("expected None for trailing garbage"); },
        None => { return test.pass(); }
    }
}

// nest(n) builds n open brackets followed by n close brackets —
// an n-deep JSON array `[[[…]]]`. Used by the recursion-depth tests.
function nest(n: i32): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < n) { out = out + "["; i = i + 1; }
    i = 0;
    while (i < n) { out = out + "]"; i = i + 1; }
    return out;
}

// Reasonable nesting (well under the 128-deep cap) still
// parses — the cap must not reject legitimate documents.
function test_depth_ok(): test.TestOutcome {
    match (json.json_parse(nest(50))) {
        Some(v) => { return test.pass(); },
        None => { return test.fail("50-deep array should parse"); }
    }
}

// A body nested past the cap is rejected with None rather than
// recursing without bound and overflowing the stack (#4384 item 3
// — DoS on an untrusted deeply-nested request body).
function test_depth_limit(): test.TestOutcome {
    match (json.json_parse(nest(500))) {
        Some(v) => { return test.fail("500-deep array should be rejected"); },
        None => { return test.pass(); }
    }
}

// ---- float accessor + integer overflow signalling (#4384 item 4) ----

// json_get_f64 extracts a fractional number the integer getters reject.
function test_get_f64(): test.TestOutcome {
    match (json.json_parse("{\"x\":3.5}")) {
        Some(v) => {
            match (json.json_get_f64(v, "x")) {
                Some(f) => {
                    var d: f64 = f - 3.5;
                    if (d < 0.0) { d = 0.0 - d; }
                    return test.assert_true(d < 0.0001);
                },
                None => { return test.fail("expected Some(f64)"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

// json_get_f64 also decodes exponent form.
function test_get_f64_exp(): test.TestOutcome {
    match (json.json_parse("{\"x\":1.5e3}")) {
        Some(v) => {
            match (json.json_get_f64(v, "x")) {
                Some(f) => {
                    var d: f64 = f - 1500.0;
                    if (d < 0.0) { d = 0.0 - d; }
                    return test.assert_true(d < 0.001);
                },
                None => { return test.fail("expected Some(f64)"); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

// json_get_i32 signals overflow as None instead of wrapping:
// 2147483648 = i32 max + 1.
function test_get_i32_overflow(): test.TestOutcome {
    match (json.json_parse("{\"x\":2147483648}")) {
        Some(v) => {
            match (json.json_get_i32(v, "x")) {
                Some(x) => { return test.fail("expected None on i32 overflow"); },
                None => { return test.pass(); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

// json_get_i64 signals overflow as None: a 20-digit body can't fit i64.
function test_get_i64_overflow(): test.TestOutcome {
    match (json.json_parse("{\"x\":99999999999999999999}")) {
        Some(v) => {
            match (json.json_get_i64(v, "x")) {
                Some(x) => { return test.fail("expected None on i64 overflow"); },
                None => { return test.pass(); }
            }
        },
        None => { return test.fail("parse failed"); }
    }
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/json roundtrip");
    r = r.it("get_string",        test_get_string());
    r = r.it("get_i32",           test_get_i32());
    r = r.it("get_bool",          test_get_bool());
    r = r.it("get missing",       test_get_missing());
    r = r.it("get wrong type",    test_get_wrong_type());
    r = r.it("is_null",           test_is_null());
    r = r.it("get_array",         test_get_array());
    r = r.it("encode array round trip", test_encode_array_round_trip());
    r = r.it("encode scalars",    test_encode_scalars());
    r = r.it("encode string escape", test_encode_string_escape());
    r = r.it("encode string escape all", test_encode_string_escape_all());
    r = r.it("parse string decode paths", test_parse_string_decode_paths());
    r = r.it("encode nested round trip", test_encode_nested_round_trip());
    r = r.it("parse invalid",     test_parse_invalid());
    r = r.it("depth ok",          test_depth_ok());
    r = r.it("depth limit",       test_depth_limit());
    r = r.it("get_f64",           test_get_f64());
    r = r.it("get_f64 exp",       test_get_f64_exp());
    r = r.it("get_i32 overflow",  test_get_i32_overflow());
    r = r.it("get_i64 overflow",  test_get_i64_overflow());
    return r.finish();
}
