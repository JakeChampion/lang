import "std/test";
// examples/tests/process_output_shortcuts_test.fern — batch
// 31 additions to std/test:
//   * `test.assert_exit_zero(proc)` / `test.assert_exit_nonzero(proc)`
//     — sugar for the most common exit-code checks.
//   * `test.assert_stdout_lines(proc, lines[])` /
//     `test.assert_stderr_lines(proc, lines[])` — multi-line
//     compare (delegates to `assert_lines_eq` so the diff
//     message wording is identical to file/in-memory).
//   * `test.assert_stdout_line_count(proc, n)` /
//     `test.assert_stderr_line_count(proc, n)` — line
//     cardinality without pinning content.

function test_exit_zero_pass(): test.TestOutcome {
    var res: ProcessResult = subprocess("true", [], "");
    return test.assert_exit_zero(res);
}

function test_exit_zero_fail_reports(): test.TestOutcome {
    var res: ProcessResult = subprocess("false", [], "");
    match (test.assert_exit_zero(res)) {
        Pass => { return test.fail("non-zero exit should fail"); },
        Fail(_) => { return test.pass(); }
    }
}

function test_exit_nonzero_pass(): test.TestOutcome {
    var res: ProcessResult = subprocess("false", [], "");
    return test.assert_exit_nonzero(res);
}

function test_exit_nonzero_zero_fails(): test.TestOutcome {
    var res: ProcessResult = subprocess("true", [], "");
    match (test.assert_exit_nonzero(res)) {
        Pass => { return test.fail("exit 0 should fail nonzero check"); },
        Fail(msg) => {
            if (!msg.contains("exited 0")) {
                return test.fail("expected 'exited 0' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_stdout_lines_pass(): test.TestOutcome {
    var res: ProcessResult = subprocess("printf",
        ["alpha\nbeta\ngamma\n"], "");
    return test.assert_stdout_lines(res, ["alpha", "beta", "gamma"]);
}

function test_stdout_lines_mismatch(): test.TestOutcome {
    var res: ProcessResult = subprocess("printf",
        ["alpha\nWRONG\ngamma\n"], "");
    match (test.assert_stdout_lines(res, ["alpha", "beta", "gamma"])) {
        Pass => { return test.fail("mismatch should fail"); },
        Fail(msg) => {
            // assert_lines_eq names the differing line.
            if (!msg.contains("line 2")) {
                return test.fail("expected 'line 2' in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_stderr_lines_pass(): test.TestOutcome {
    // Send something to stderr via sh -c.
    var res: ProcessResult = subprocess("sh",
        ["-c", "printf 'err1\\nerr2\\n' >&2"], "");
    return test.assert_stderr_lines(res, ["err1", "err2"]);
}

function test_stdout_line_count_pass(): test.TestOutcome {
    var res: ProcessResult = subprocess("printf",
        ["x\ny\nz\n"], "");
    return test.assert_stdout_line_count(res, 3);
}

function test_stdout_line_count_wrong_reports(): test.TestOutcome {
    var res: ProcessResult = subprocess("printf",
        ["x\ny\n"], "");
    match (test.assert_stdout_line_count(res, 5)) {
        Pass => { return test.fail("expected count mismatch"); },
        Fail(msg) => {
            if (!msg.contains("got 2") || !msg.contains("expected 5")) {
                return test.fail("expected both counts in failure: " + msg);
            }
            return test.pass();
        }
    }
}

function test_stderr_line_count_pass(): test.TestOutcome {
    var res: ProcessResult = subprocess("sh",
        ["-c", "printf 'a\\nb\\nc\\n' >&2"], "");
    return test.assert_stderr_line_count(res, 3);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("process output shortcuts");
    r = r.it("exit_zero pass",                test_exit_zero_pass);
    r = r.it("exit_zero on non-zero fails",   test_exit_zero_fail_reports);
    r = r.it("exit_nonzero pass",             test_exit_nonzero_pass);
    r = r.it("exit_nonzero on 0 names code",  test_exit_nonzero_zero_fails);
    r = r.it("stdout_lines pass",             test_stdout_lines_pass);
    r = r.it("stdout_lines mismatch line N",  test_stdout_lines_mismatch);
    r = r.it("stderr_lines pass",             test_stderr_lines_pass);
    r = r.it("stdout_line_count pass",        test_stdout_line_count_pass);
    r = r.it("stdout_line_count wrong reports", test_stdout_line_count_wrong_reports);
    r = r.it("stderr_line_count pass",        test_stderr_line_count_pass);
    return r.finish();
}
