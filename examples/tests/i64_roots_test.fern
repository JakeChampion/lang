import "std/test";
import "std/i64" as i64m;
// examples/tests/i64_roots_test.fern — pure-Fern coverage of std/i64's
// sqrt_floor / is_power_of_2 / is_perfect_square: the i64 siblings of the
// std/i32 root/power predicates, exact into the i64 range where the i32
// versions would overflow. sqrt_floor is Newton's method (floor of √n),
// is_power_of_2 is the n&(n-1) bit trick, is_perfect_square is sqrt_floor(n)²==n.
// The Go-side TestI64Roots pins these across all four backends; this is the
// migration-shaped companion. Scalar-only, so it's self-host clean.

function test_sqrt_floor_exact(): test.TestOutcome {
    return test.assert_true((100 as i64).sqrt_floor() == (10 as i64));
}

function test_sqrt_floor_inexact(): test.TestOutcome {
    return test.assert_true((99 as i64).sqrt_floor() == (9 as i64));
}

function test_sqrt_floor_large(): test.TestOutcome {
    // 10^10, well past the i32 range.
    return test.assert_true((10000000000 as i64).sqrt_floor() == (100000 as i64));
}

function test_sqrt_floor_zero(): test.TestOutcome {
    return test.assert_true((0 as i64).sqrt_floor() == (0 as i64));
}

function test_power_of_2_true(): test.TestOutcome {
    // 2^62.
    return test.assert_true((4611686018427387904 as i64).is_power_of_2());
}

function test_power_of_2_false(): test.TestOutcome {
    if ((6 as i64).is_power_of_2()) { return test.fail("6 is not a power of 2"); }
    if ((0 as i64).is_power_of_2()) { return test.fail("0 is not a power of 2"); }
    if (((0 as i64) - 8).is_power_of_2()) { return test.fail("-8 is not a power of 2"); }
    return test.assert_true(true);
}

function test_perfect_square_true(): test.TestOutcome {
    // (10^6)^2 = 10^12, past the i32 range.
    return test.assert_true((1000000000000 as i64).is_perfect_square());
}

function test_perfect_square_false(): test.TestOutcome {
    if ((1000001 as i64).is_perfect_square()) { return test.fail("1000001 is not a square"); }
    if (((0 as i64) - 4).is_perfect_square()) { return test.fail("-4 is not a square"); }
    return test.assert_true(true);
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/i64 roots");
    r = r.it("sqrt_floor exact",     test_sqrt_floor_exact());
    r = r.it("sqrt_floor inexact",   test_sqrt_floor_inexact());
    r = r.it("sqrt_floor large",     test_sqrt_floor_large());
    r = r.it("sqrt_floor zero",      test_sqrt_floor_zero());
    r = r.it("power of 2 true",      test_power_of_2_true());
    r = r.it("power of 2 false",     test_power_of_2_false());
    r = r.it("perfect square true",  test_perfect_square_true());
    r = r.it("perfect square false", test_perfect_square_false());
    return r.finish();
}
