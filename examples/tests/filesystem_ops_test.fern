import "core/cmp";
import "std/test";
// examples/tests/filesystem_ops_test.fern — exercises the
// `read_dir` / `remove_file` / `remove_dir_all` builtins and
// the runner's `defer_cleanup(path)` hook. Together these
// give a migrated test enough fs vocabulary to create a
// fixture tree, walk it, point a subprocess at it, then
// scrub everything at the end of the run.

function test_temp_dir_returns_abs_path(): test.TestOutcome {
    match (temp_dir("fs-ops")) {
        Ok(dir) => {
            // Best-effort absolute-path check: every supported
            // OS roots its temp dir under `/`. (Windows isn't
            // a Fern target; on POSIX-likes the prefix holds.)
            var ok: boolean = dir.starts_with("/") || dir.starts_with("\\");
            // Don't leak: remove the directory we just made.
            match (remove_dir_all(dir)) { Ok(_) => { }, Err(_) => { } }
            if (ok) { return test.pass(); }
            return test.fail("temp_dir returned non-absolute path \"" + dir + "\"");
        },
        Err(_) => { return test.fail("temp_dir returned Err"); }
    }
    return test.pass();
}

function test_read_dir_lists_what_we_wrote(): test.TestOutcome {
    match (temp_dir("readdir-fixture")) {
        Ok(dir) => {
            // Write three files, then list. Sort the output so
            // the comparison is order-independent (read_dir
            // promises only the set of names, not the order).
            match (write_file(dir + "/a.txt", "a")) { Ok(_) => {}, Err(_) => { return test.fail("write a failed"); } }
            match (write_file(dir + "/b.txt", "b")) { Ok(_) => {}, Err(_) => { return test.fail("write b failed"); } }
            match (write_file(dir + "/c.txt", "c")) { Ok(_) => {}, Err(_) => { return test.fail("write c failed"); } }
            match (read_dir(dir)) {
                Ok(names) => {
                    var sorted: string[] = cmp.sort(names);
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.assert_eq_array(sorted, ["a.txt", "b.txt", "c.txt"]);
                },
                Err(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.fail("read_dir returned Err");
                }
            }
        },
        Err(_) => { return test.fail("temp_dir setup failed"); }
    }
    return test.pass();
}

function test_remove_file_removes_a_single_file(): test.TestOutcome {
    match (temp_dir("rmfile-fixture")) {
        Ok(dir) => {
            var keep: string = dir + "/keep.txt";
            var doomed: string = dir + "/doomed.txt";
            match (write_file(keep, "keep")) { Ok(_) => {}, Err(_) => { return test.fail("write keep failed"); } }
            match (write_file(doomed, "doomed")) { Ok(_) => {}, Err(_) => { return test.fail("write doomed failed"); } }
            match (remove_file(doomed)) { Ok(_) => {}, Err(_) => {
                match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                return test.fail("remove_file returned Err");
            } }
            // After the targeted unlink, only keep.txt is left.
            match (read_dir(dir)) {
                Ok(names) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.assert_eq_array(names, ["keep.txt"]);
                },
                Err(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.fail("post-rm read_dir failed");
                }
            }
        },
        Err(_) => { return test.fail("temp_dir setup failed"); }
    }
    return test.pass();
}

function test_remove_file_on_missing_target_is_an_error(): test.TestOutcome {
    // Match Go's `os.Remove` semantics: removing a path that
    // doesn't exist returns an error. Callers that don't care
    // about that distinction should ignore the return value.
    match (remove_file("/tmp/lang-this-file-definitely-does-not-exist-83274")) {
        Ok(_) => { return test.fail("expected error on missing target, got None"); },
        Err(_) => { return test.pass(); }
    }
    return test.pass();
}

function test_create_dir_all_builds_a_missing_chain(): test.TestOutcome {
    match (temp_dir("mkdirp-fixture")) {
        Ok(dir) => {
            var leaf: string = dir + "/one/two/three";
            match (create_dir_all(leaf)) { Ok(_) => {}, Err(_) => {
                match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                return test.fail("create_dir_all returned Err");
            } }
            // A write into the leaf is the proof the whole chain
            // exists: a walk that created only the last component
            // leaves a path write_file cannot reach.
            match (write_file(leaf + "/deep.txt", "deep")) { Ok(_) => {}, Err(_) => {
                match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                return test.fail("write into the created chain failed");
            } }
            match (read_dir(dir + "/one/two")) {
                Ok(names) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.assert_eq_array(names, ["three"]);
                },
                Err(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.fail("read_dir of the created parent failed");
                }
            }
        },
        Err(_) => { return test.fail("temp_dir setup failed"); }
    }
    return test.pass();
}

function test_create_dir_all_on_existing_path_is_ok(): test.TestOutcome {
    // `mkdir -p` semantics: an existing directory is not an error,
    // so a caller can create unconditionally rather than stat first.
    match (temp_dir("mkdirp-exists")) {
        Ok(dir) => {
            match (create_dir_all(dir)) {
                Ok(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.pass();
                },
                Err(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.fail("create_dir_all over an existing directory returned Err");
                }
            }
        },
        Err(_) => { return test.fail("temp_dir setup failed"); }
    }
    return test.pass();
}

function test_create_dir_all_under_a_file_is_an_error(): test.TestOutcome {
    // The failure that is still a failure: a component of the path
    // exists as a regular file, so the chain cannot be built.
    match (temp_dir("mkdirp-notdir")) {
        Ok(dir) => {
            var blocker: string = dir + "/blocker";
            match (write_file(blocker, "x")) { Ok(_) => {}, Err(_) => {
                match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                return test.fail("write blocker failed");
            } }
            match (create_dir_all(blocker + "/inner")) {
                Ok(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.fail("expected Err under a regular file, got Ok");
                },
                Err(_) => {
                    match (remove_dir_all(dir)) { Ok(_) => {}, Err(_) => {} }
                    return test.pass();
                }
            }
        },
        Err(_) => { return test.fail("temp_dir setup failed"); }
    }
    return test.pass();
}

function test_remove_dir_all_silently_ok_on_missing_target(): test.TestOutcome {
    // Mirrors Go's `os.RemoveAll`: missing target is fine —
    // the postcondition (path does not exist) is already
    // satisfied.
    match (remove_dir_all("/tmp/lang-this-dir-definitely-does-not-exist-83274")) {
        Ok(_) => { return test.pass(); },
        Err(_) => { return test.fail("expected None on missing target, got Err"); }
    }
    return test.pass();
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("filesystem ops");
    r = r.it("temp_dir returns absolute path",          test_temp_dir_returns_abs_path);
    r = r.it("read_dir lists what we wrote",            test_read_dir_lists_what_we_wrote);
    r = r.it("remove_file removes a single file",       test_remove_file_removes_a_single_file);
    r = r.it("remove_file on missing target errors",    test_remove_file_on_missing_target_is_an_error);
    r = r.it("remove_dir_all on missing target is ok",  test_remove_dir_all_silently_ok_on_missing_target);
    r = r.it("create_dir_all builds a missing chain",   test_create_dir_all_builds_a_missing_chain);
    r = r.it("create_dir_all on an existing path is ok", test_create_dir_all_on_existing_path_is_ok);
    r = r.it("create_dir_all under a file errors",      test_create_dir_all_under_a_file_is_an_error);
    return r.finish();
}
