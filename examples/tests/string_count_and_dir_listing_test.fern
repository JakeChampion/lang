// examples/tests/string_count_and_dir_listing_test.fern —
// batch 35 additions to std/test:
//   * `assert_string_count(haystack, needle, n)` —
//     `needle` appears exactly `n` times (non-overlapping)
//     in `haystack`.
//   * `assert_eq_dir_listing(dir, expected_names)` —
//     directory listing equals the expected multiset of
//     file/subdir names (`readdir` order not observable
//     so the helper sorts both sides before compare).

function test_string_count_pass(): Option[string] {
    return assert_string_count(
        "[ERROR] one\n[ERROR] two\n[INFO] three\n",
        "[ERROR]", 2);
}

function test_string_count_zero(): Option[string] {
    return assert_string_count("hello world", "xyz", 0);
}

function test_string_count_single_char(): Option[string] {
    return assert_string_count("a-b-c-d", "-", 3);
}

function test_string_count_overlap_non_overlap(): Option[string] {
    // "aaa" with needle "aa" — non-overlapping count is 1
    // (not 2 — overlap would consume the same byte twice).
    return assert_string_count("aaa", "aa", 1);
}

function test_string_count_wrong_reports(): Option[string] {
    match (assert_string_count("hello world hello", "hello", 5)) {
        None => { return fail("wrong count should fail"); },
        Some(msg) => {
            // Diagnostic should embed observed AND expected.
            if (!msg.contains("appears 2 times") ||
                !msg.contains("expected 5")) {
                return Some("expected both counts in msg: " + msg);
            }
            return None;
        }
    }
}

function test_string_count_empty_haystack(): Option[string] {
    return assert_string_count("", "x", 0);
}

function test_dir_listing_pass(r: TestRunner): TestRunner {
    var (dir, rr) = must_temp_dir(r, "listing-pass");
    if (dir == "") { return rr; }
    // Write three files in arbitrary order.
    match (write_file(dir + "/zebra.txt", "z")) {
        Some(_) => { return rr.it("write fixture", fail("io")); },
        None => {}
    }
    match (write_file(dir + "/alpha.txt", "a")) {
        Some(_) => { return rr.it("write fixture", fail("io")); },
        None => {}
    }
    match (write_file(dir + "/mid.txt", "m")) {
        Some(_) => { return rr.it("write fixture", fail("io")); },
        None => {}
    }
    // Expected list in different order — sort-then-compare
    // means this still matches.
    return rr.it("listing matches multiset (sorted)",
                 assert_eq_dir_listing(dir,
                     ["mid.txt", "zebra.txt", "alpha.txt"]));
}

function test_dir_listing_empty_dir(r: TestRunner): TestRunner {
    var (dir, rr) = must_temp_dir(r, "listing-empty");
    if (dir == "") { return rr; }
    var empty: string[] = [];
    return rr.it("empty dir matches empty list",
                 assert_eq_dir_listing(dir, empty));
}

function test_dir_listing_extra_file_fails(r: TestRunner): TestRunner {
    var (dir, rr) = must_temp_dir(r, "listing-extra");
    if (dir == "") { return rr; }
    match (write_file(dir + "/a.txt", "")) {
        Some(_) => { return rr.it("write fixture", fail("io")); },
        None => {}
    }
    match (write_file(dir + "/b.txt", "")) {
        Some(_) => { return rr.it("write fixture", fail("io")); },
        None => {}
    }
    // Expected lacks b.txt — must fail.
    match (assert_eq_dir_listing(dir, ["a.txt"])) {
        None => { return rr.it("missing-from-expected", fail("missed")); },
        Some(msg) => {
            if (!msg.contains("length differs")) {
                return rr.it("listing diff length msg", fail("got: " + msg));
            }
            return rr.it("extra file flagged via length diff", None);
        }
    }
}

function test_dir_listing_missing_dir(): Option[string] {
    match (assert_eq_dir_listing(
        "/tmp/lang-no-such-dir-batch35-zztop",
        ["x"])) {
        None => { return fail("missing dir should fail"); },
        Some(msg) => {
            if (!msg.contains("failed to read")) {
                return Some("expected 'failed to read': " + msg);
            }
            return None;
        }
    }
}

function main(): i32 {
    var r: TestRunner = test_new("string count + dir listing");
    r = r.it("string_count multiple matches",     test_string_count_pass());
    r = r.it("string_count zero matches",         test_string_count_zero());
    r = r.it("string_count single char",          test_string_count_single_char());
    r = r.it("string_count non-overlapping",      test_string_count_overlap_non_overlap());
    r = r.it("string_count wrong reports both",   test_string_count_wrong_reports());
    r = r.it("string_count empty haystack",       test_string_count_empty_haystack());
    r = test_dir_listing_pass(r);
    r = test_dir_listing_empty_dir(r);
    r = test_dir_listing_extra_file_fails(r);
    r = r.it("dir_listing missing dir",           test_dir_listing_missing_dir());
    return r.finish();
}
