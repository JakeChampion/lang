import "std/test";
import "std/crypto" as crypto;
import "std/string";
// examples/tests/digest_sha224_test.fern — std/crypto's streaming SHA-224 (FIPS 180-4)
// against the standard known-answer vectors (empty, "abc", the 56-byte
// multi-block message, one million 'a'), fed through the pending-block logic in
// every way that matters: whole strings, 1000 updates of 1000 bytes, and 7-byte
// updates that straddle each block boundary, cross-checked against the one-shot form.

// __pseudo builds the 10,003-byte fixed pattern byte i = (i * 7 + 3) & 255:
// long enough that 7-byte updates straddle every block boundary offset, and
// not valid UTF-8, so the hasher is fed raw bytes.
function __pseudo(): u8[] {
    var b: u8[] = __alloc_u8(10003);
    var i: i32 = 0;
    while (i < 10003) { b = b.with(i, ((i * 7 + 3) & 255) as u8); i = i + 1; }
    return b;
}

// __thousand_a is 1000 'a's, the unit of the million-'a' vector.
function __thousand_a(): string {
    var b: u8[] = __alloc_u8(1000);
    var i: i32 = 0;
    while (i < 1000) { b = b.with(i, 97 as u8); i = i + 1; }
    return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
    return test.assert_eq(crypto.sha224_new().final_hex(), "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f");
}

function test_abc(): test.TestOutcome {
    return test.assert_eq(crypto.sha224_new().update("abc").final_hex(), "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7");
}

function test_multiblock(): test.TestOutcome {
    return test.assert_eq(crypto.sha224_new().update("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq").final_hex(),
        "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525");
}

function test_bytes_len(): test.TestOutcome {
    return test.assert_eq(crypto.sha224_new().update("abc").final_bytes().len(), 28);
}

// One million 'a' as 1000 updates of 1000 bytes: 1000 is not a multiple of the
// block size, so every update leaves a partial block pending.
function test_million_a_chunked(): test.TestOutcome {
    var h: crypto.Sha256 = crypto.sha224_new();
    var chunk: string = __thousand_a();
    var i: i32 = 0;
    while (i < 1000) { h = h.update(chunk); i = i + 1; }
    return test.assert_eq(h.final_hex(), "20794655980c91d8bbb4c1ea97618a4bf03f42581948b2ee4ee7ad67");
}

// 7-byte view slices over the fixed pattern, against the whole message fed as a
// string and the reference value.
function test_seven_byte_updates(): test.TestOutcome {
    var msg: u8[] = __pseudo();
    var h: crypto.Sha256 = crypto.sha224_new();
    var i: i32 = 0;
    while (i + 7 <= 10003) { h = h.update_bytes(msg[i:i + 7]); i = i + 7; }
    h = h.update_bytes(msg[i:10003]);
    var chunked: string = h.final_hex();
    var whole: string = crypto.sha224_new().update(string_from_bytes_unchecked(msg)).final_hex();
    if (chunked != "180cc94fa2f8fa787e1d0a7e4e33a351c7a97dae474735c9f91d558e") { return test.fail("chunked: " + chunked); }
    return test.assert_eq(chunked, whole);
}

// update_bytes takes the same bytes as u8[]; the one-shot helpers agree.
function test_update_bytes_and_oneshot(): test.TestOutcome {
    var via_bytes: string = crypto.sha224_new().update_bytes("abc".bytes()).final_hex();
    if (via_bytes != crypto.sha224_hex("abc")) { return test.fail("one-shot differs: " + via_bytes); }
    return test.assert_eq(via_bytes, "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/crypto SHA-224");
    r = r.it("empty", test_empty);
    r = r.it("abc", test_abc);
    r = r.it("multi-block", test_multiblock);
    r = r.it("final_bytes len", test_bytes_len);
    r = r.it("million a, 1000x1000", test_million_a_chunked);
    r = r.it("7-byte updates", test_seven_byte_updates);
    r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
    return r.finish();
}
