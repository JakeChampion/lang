// examples/tests/json_field_eq_test.lang — batch 34
// additions to std/test:
//   * `assert_json_eq_field_string(json_text, key, exp)`
//     — top-level object's key is a JString equal to exp.
//   * `assert_json_eq_field_i32(json_text, key, exp)` —
//     top-level object's key is a JNumber parseable to
//     i32 and equal to exp.
//   * `assert_json_eq_field_bool(json_text, key, exp)` —
//     top-level object's key is a JBool equal to exp.

function test_field_string_pass(): Option[string] {
    return assert_json_eq_field_string(
        "{\"name\":\"alice\",\"city\":\"NYC\"}",
        "name", "alice");
}

function test_field_string_wrong_value(): Option[string] {
    match (assert_json_eq_field_string(
        "{\"name\":\"alice\"}", "name", "bob")) {
        None => { return fail("wrong value should fail"); },
        Some(msg) => {
            if (!msg.contains("at \"name\"") ||
                !msg.contains("\"alice\"") ||
                !msg.contains("\"bob\"")) {
                return Some("expected key + both values: " + msg);
            }
            return None;
        }
    }
}

function test_field_string_wrong_type(): Option[string] {
    match (assert_json_eq_field_string(
        "{\"count\":42}", "count", "42")) {
        None => { return fail("wrong type should fail"); },
        Some(msg) => {
            if (!msg.contains("number, not string")) {
                return Some("expected 'number, not string': " + msg);
            }
            return None;
        }
    }
}

function test_field_string_missing_key(): Option[string] {
    match (assert_json_eq_field_string(
        "{\"a\":\"x\"}", "missing", "y")) {
        None => { return fail("missing key should fail"); },
        Some(msg) => {
            if (!msg.contains("\"missing\" not present")) {
                return Some("expected 'not present': " + msg);
            }
            return None;
        }
    }
}

function test_field_string_invalid_json(): Option[string] {
    match (assert_json_eq_field_string("not-json", "k", "v")) {
        None => { return fail("invalid JSON should fail"); },
        Some(msg) => {
            if (!msg.contains("not valid JSON")) {
                return Some("expected 'not valid JSON': " + msg);
            }
            return None;
        }
    }
}

function test_field_i32_pass(): Option[string] {
    return assert_json_eq_field_i32(
        "{\"count\":42,\"name\":\"x\"}",
        "count", 42);
}

function test_field_i32_wrong_value(): Option[string] {
    match (assert_json_eq_field_i32(
        "{\"count\":42}", "count", 99)) {
        None => { return fail("wrong value should fail"); },
        Some(msg) => {
            if (!msg.contains("expected 99") || !msg.contains("got 42")) {
                return Some("expected both values: " + msg);
            }
            return None;
        }
    }
}

function test_field_i32_wrong_type(): Option[string] {
    match (assert_json_eq_field_i32(
        "{\"count\":\"42\"}", "count", 42)) {
        None => { return fail("string-value should fail"); },
        Some(msg) => {
            if (!msg.contains("string, not number")) {
                return Some("expected 'string, not number': " + msg);
            }
            return None;
        }
    }
}

function test_field_i32_non_integer_number(): Option[string] {
    // Decimals aren't i32-parseable — must report the
    // parse failure, not silently truncate.
    match (assert_json_eq_field_i32(
        "{\"count\":3.14}", "count", 3)) {
        None => { return fail("decimal should not parse as i32"); },
        Some(msg) => {
            if (!msg.contains("not i32-parseable")) {
                return Some("expected parse-failure diag: " + msg);
            }
            return None;
        }
    }
}

function test_field_i32_negative(): Option[string] {
    return assert_json_eq_field_i32(
        "{\"delta\":-7}", "delta", 0 - 7);
}

function test_field_bool_true_pass(): Option[string] {
    return assert_json_eq_field_bool(
        "{\"ok\":true}", "ok", true);
}

function test_field_bool_false_pass(): Option[string] {
    return assert_json_eq_field_bool(
        "{\"flag\":false}", "flag", false);
}

function test_field_bool_wrong_value(): Option[string] {
    match (assert_json_eq_field_bool(
        "{\"ok\":true}", "ok", false)) {
        None => { return fail("wrong bool should fail"); },
        Some(msg) => {
            if (!msg.contains("expected false") || !msg.contains("got true")) {
                return Some("expected both true/false: " + msg);
            }
            return None;
        }
    }
}

function test_field_bool_wrong_type(): Option[string] {
    match (assert_json_eq_field_bool(
        "{\"ok\":\"true\"}", "ok", true)) {
        None => { return fail("string-true should fail"); },
        Some(msg) => {
            if (!msg.contains("string, not bool")) {
                return Some("expected 'string, not bool': " + msg);
            }
            return None;
        }
    }
}

function main(): i32 {
    var r: TestRunner = test_new("JSON field extraction");
    r = r.it("field_string pass",              test_field_string_pass());
    r = r.it("field_string wrong value diag",  test_field_string_wrong_value());
    r = r.it("field_string wrong type rejected", test_field_string_wrong_type());
    r = r.it("field_string missing key",       test_field_string_missing_key());
    r = r.it("field_string invalid JSON",      test_field_string_invalid_json());
    r = r.it("field_i32 pass",                 test_field_i32_pass());
    r = r.it("field_i32 wrong value shows both", test_field_i32_wrong_value());
    r = r.it("field_i32 wrong type rejected",  test_field_i32_wrong_type());
    r = r.it("field_i32 decimal rejected",     test_field_i32_non_integer_number());
    r = r.it("field_i32 negative",             test_field_i32_negative());
    r = r.it("field_bool true pass",           test_field_bool_true_pass());
    r = r.it("field_bool false pass",          test_field_bool_false_pass());
    r = r.it("field_bool wrong value diag",    test_field_bool_wrong_value());
    r = r.it("field_bool wrong type rejected", test_field_bool_wrong_type());
    return r.finish();
}
