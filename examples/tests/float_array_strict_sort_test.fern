// examples/tests/float_array_strict_sort_test.fern — batch
// 20 additions to std/test:
//   * `assert_eq_f64_array_near(actual, expected, eps)` /
//     `assert_eq_f32_array_near` — element-wise float-array
//     compare with tolerance.
//   * `assert_sorted_desc_i32` / `_string` — descending
//     order verification (pair with sort_*_desc output).
//   * `assert_strictly_sorted_asc_i32` / `_string` — strict
//     monotonic (sorted AND unique in one helper).

function test_f64_array_pass(): Option[string] {
    var actual: f64[] = [1.0, 2.5, 3.7];
    var expected: f64[] = [1.0, 2.5, 3.7];
    return assert_eq_f64_array_near(actual, expected, 0.0001);
}

function test_f64_array_within_tolerance(): Option[string] {
    // Cumulative-rounding-style drift the tolerance must
    // absorb.
    var actual: f64[] = [1.0 + 0.0001, 2.5, 3.7 - 0.0001];
    var expected: f64[] = [1.0, 2.5, 3.7];
    return assert_eq_f64_array_near(actual, expected, 0.001);
}

function test_f64_array_outside_tolerance(): Option[string] {
    var actual: f64[] = [1.0, 5.0, 3.0];
    var expected: f64[] = [1.0, 2.5, 3.0];
    match (assert_eq_f64_array_near(actual, expected, 0.1)) {
        None => { return fail("expected mismatch"); },
        Some(msg) => {
            if (!msg.contains("index 1")) {
                return Some("expected 'index 1' in failure: " + msg);
            }
            return None;
        }
    }
}

function test_f64_array_length_mismatch(): Option[string] {
    var actual: f64[] = [1.0, 2.0];
    var expected: f64[] = [1.0, 2.0, 3.0];
    match (assert_eq_f64_array_near(actual, expected, 0.001)) {
        None => { return fail("expected length-mismatch fail"); },
        Some(msg) => {
            if (!msg.contains("length differs")) {
                return Some("expected 'length differs': " + msg);
            }
            return None;
        }
    }
}

function test_f64_array_nan_fails(): Option[string] {
    var z: f64 = 0.0;
    var nan: f64 = z / z;
    var actual: f64[] = [1.0, nan, 3.0];
    var expected: f64[] = [1.0, 2.0, 3.0];
    match (assert_eq_f64_array_near(actual, expected, 100.0)) {
        None => { return fail("NaN should fail array compare"); },
        Some(msg) => {
            if (!msg.contains("NaN")) {
                return Some("expected 'NaN' in failure: " + msg);
            }
            return None;
        }
    }
}

function test_f32_array_pass(): Option[string] {
    var actual: f32[] = [(1.0 as f32), (2.0 as f32)];
    var expected: f32[] = [(1.0 as f32), (2.0 as f32)];
    return assert_eq_f32_array_near(actual, expected, 0.0001 as f32);
}

function test_sorted_desc_i32_pass(): Option[string] {
    return assert_sorted_desc_i32([9, 5, 3, 1]);
}

function test_sorted_desc_i32_equal_runs_ok(): Option[string] {
    return assert_sorted_desc_i32([5, 5, 3, 3, 1]);
}

function test_sorted_desc_i32_fails_on_inversion(): Option[string] {
    match (assert_sorted_desc_i32([9, 3, 5, 1])) {
        None => { return fail("inversion missed"); },
        Some(msg) => {
            if (!msg.contains("index 2")) {
                return Some("expected 'index 2': " + msg);
            }
            return None;
        }
    }
}

function test_sorted_desc_string_pass(): Option[string] {
    return assert_sorted_desc_string(["gamma", "beta", "alpha"]);
}

function test_strict_asc_i32_pass(): Option[string] {
    return assert_strictly_sorted_asc_i32([1, 2, 3, 5, 8]);
}

function test_strict_asc_i32_fails_on_dupe(): Option[string] {
    // Non-strict assert_sorted_asc would accept [1, 2, 2, 3]
    // — the strict variant must reject it.
    match (assert_strictly_sorted_asc_i32([1, 2, 2, 3])) {
        None => { return fail("strict sort should reject equal pair"); },
        Some(msg) => {
            if (!msg.contains("not strict")) {
                return Some("expected 'not strict' in msg: " + msg);
            }
            return None;
        }
    }
}

function test_strict_asc_i32_empty_vacuous(): Option[string] {
    var empty: i32[] = [];
    return assert_strictly_sorted_asc_i32(empty);
}

function test_strict_asc_string_pass(): Option[string] {
    return assert_strictly_sorted_asc_string(["alpha", "beta", "gamma"]);
}

function test_strict_asc_string_fails_on_dupe(): Option[string] {
    match (assert_strictly_sorted_asc_string(["alpha", "alpha", "beta"])) {
        None => { return fail("strict string sort should reject equal pair"); },
        Some(_) => { return None; }
    }
}

function main(): i32 {
    var r: TestRunner = test_new("float arrays + strict / desc sort");
    r = r.it("f64 array near pass",                test_f64_array_pass());
    r = r.it("f64 array within tolerance",         test_f64_array_within_tolerance());
    r = r.it("f64 array outside tolerance + idx",  test_f64_array_outside_tolerance());
    r = r.it("f64 array length mismatch",          test_f64_array_length_mismatch());
    r = r.it("f64 array NaN fails",                test_f64_array_nan_fails());
    r = r.it("f32 array near pass",                test_f32_array_pass());
    r = r.it("sorted_desc_i32 pass",               test_sorted_desc_i32_pass());
    r = r.it("sorted_desc_i32 equal runs ok",      test_sorted_desc_i32_equal_runs_ok());
    r = r.it("sorted_desc_i32 inversion + index",  test_sorted_desc_i32_fails_on_inversion());
    r = r.it("sorted_desc_string pass",            test_sorted_desc_string_pass());
    r = r.it("strict_asc_i32 pass",                test_strict_asc_i32_pass());
    r = r.it("strict_asc_i32 rejects equal pair",  test_strict_asc_i32_fails_on_dupe());
    r = r.it("strict_asc_i32 empty vacuous",       test_strict_asc_i32_empty_vacuous());
    r = r.it("strict_asc_string pass",             test_strict_asc_string_pass());
    r = r.it("strict_asc_string rejects equal",    test_strict_asc_string_fails_on_dupe());
    return r.finish();
}
