import "std/test";
// examples/tests/lang_binary_e2e_test.fern — end-to-end
// migration pattern: a Fern test file that drives the `fern`
// binary itself, asserts on its (exit_code, stdout, stderr)
// triple, and scrubs its tempdir at the end via
// `defer_cleanup`.
//
// This is the shape the migrated Go-side e2e suite will land
// in. The test reads the path to the binary under test from
// `$LANG_BIN`; CI exports it after `go build`, dev laptops
// can `LANG_BIN=$PWD/fern go test`-style. When the env var
// isn't set the whole suite skips cleanly rather than
// cascading false failures.

function test_interp_returns_exit_code(lang_bin: string): test.TestOutcome {
    var src: string = "function main(): i32 { return 7; }";
    var r: ProcessResult = subprocess(lang_bin, ["-interp", "-"], src);
    return test.assert_exit(r, 7);
}

function test_interp_stdout_contains(lang_bin: string): test.TestOutcome {
    var src: string = "function main(): i32 { print(\"from-lang-test\"); return 0; }";
    var r: ProcessResult = subprocess(lang_bin, ["-interp", "-"], src);
    return test.assert_process(r, 0, "from-lang-test");
}

function test_check_passes_clean_program(lang_bin: string): test.TestOutcome {
    var src: string = "function add(a: i32, b: i32): i32 { return a + b; } function main(): i32 { return add(2, 3); }";
    var r: ProcessResult = subprocess(lang_bin, ["-check", "-"], src);
    return test.assert_exit(r, 0);
}

function test_check_rejects_type_error(lang_bin: string): test.TestOutcome {
    var src: string = "function main(): i32 { return \"not an int\"; }";
    var r: ProcessResult = subprocess(lang_bin, ["-check", "-"], src);
    // -check exits non-zero on errors; the exact code isn't
    // contractual but we know it's not 0.
    if (r.exit_code == 0) {
        return test.fail("expected non-zero exit on type error, got 0");
    }
    // The diagnostic should mention the violation. We probe
    // for "error" rather than pinning the exact wording so
    // a small phrasing tweak ("type error" → "return type
    // mismatch") doesn't break the test. Codes (`error[E002]:`)
    // and the plain `error:` shape both match.
    if (!r.stderr.contains("error")) {
        return test.fail("stderr missing `error`:\n" + r.stderr);
    }
    return test.pass();
}

function test_interp_reads_a_file(lang_bin: string, dir: string): test.TestOutcome {
    // Write a fixture to the tempdir, then point Fern at it
    // via `-interp <path>` rather than stdin. Verifies the
    // file-path entry point + working-directory handling.
    var src_path: string = dir + "/prog.fern";
    var src: string = "function main(): i32 { print(\"file-mode\"); return 42; }";
    match (write_file(src_path, src)) {
        Ok(_) => { },
        Err(_) => { return test.fail("write_file failed for " + src_path); }
    }
    var r: ProcessResult = subprocess(lang_bin, ["-interp", src_path], "");
    return test.assert_process(r, 42, "file-mode");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("lang binary e2e");

    // Gate the suite on $LANG_BIN being set + pointing at an
    // executable. A best-effort sanity probe spawns `fern
    // -interp -` with an empty stdin and inspects the exit
    // code; spawn failure (binary missing, not executable)
    // surfaces as 127 per the subprocess builtin's
    // POSIX-shell convention.
    var lang_bin: string = "";
    match (env("LANG_BIN")) {
        Some(p) => { lang_bin = p; },
        None => {
            r = r.skip("lang binary suite", "LANG_BIN not set");
            return r.finish();
        }
    }
    var probe: ProcessResult = subprocess(lang_bin, ["-interp", "-"],
                                          "function main(): i32 { return 0; }");
    if (probe.exit_code == 127) {
        r = r.skip("lang binary suite", "spawn $LANG_BIN failed: " + probe.stderr);
        return r.finish();
    }

    // Allocate a tempdir for the file-mode test + register
    // cleanup. defer_cleanup at the runner level scrubs the
    // directory regardless of test outcome.
    var dir: string = "";
    match (temp_dir("lang-e2e")) {
        Ok(d) => {
            dir = d;
            r = r.defer_cleanup(d);
        },
        Err(_) => {
            r = r.skip("lang binary suite", "temp_dir failed");
            return r.finish();
        }
    }

    r = r.it("interp returns exit code",     () => test_interp_returns_exit_code(lang_bin));
    r = r.it("interp stdout contains",       () => test_interp_stdout_contains(lang_bin));
    r = r.it("check passes clean program",   () => test_check_passes_clean_program(lang_bin));
    r = r.it("check rejects type error",     () => test_check_rejects_type_error(lang_bin));
    r = r.it("interp reads a file",          () => test_interp_reads_a_file(lang_bin, dir));

    return r.finish();
}
