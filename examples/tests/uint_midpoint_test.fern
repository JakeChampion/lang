import "std/test";
import "std/u32" as u32m;
import "std/u64" as u64m;
// examples/tests/uint_midpoint_test.fern — pure-Fern coverage of
// std/u32.midpoint and std/u64.midpoint: the overflow-safe unsigned average
// (a & b) + ((a ^ b) >> 1) (logical shift). The naive (a+b)/2 wraps for large
// unsigned operands (the classic binary-search bug); this form never does, so
// the near-MAX cases are the crux. The Go-side TestUintMidpoint pins these
// across all four NATIVE backends; this is the migration-shaped companion.
// Both interp- AND self-host-gated (x86-64 / arm64 / wasm IR). This was once
// interp-only, blamed on a "u32 self-host gap" (an arithmetic/sign-extending
// `>>`); the real cause was irlower's expr_recv_prim_type having no u32 branch,
// so `(a as u32).midpoint(...)` dispatched to the SIGNED std/i32.midpoint (whose
// `>>` is arithmetic) instead of std/u32.midpoint. Fixed — the self-host
// compilers now match the interpreter on the near-u32::MAX case.

function test_u32_basic(): test.TestOutcome {
    if ((4 as u32).midpoint(6 as u32) != (5 as u32)) { return test.fail("4,6"); }
    if ((2 as u32).midpoint(4 as u32) != (3 as u32)) { return test.fail("2,4"); }
    return test.assert_true((7 as u32).midpoint(7 as u32) == (7 as u32));
}

function test_u32_no_overflow(): test.TestOutcome {
    // near u32::MAX; (a+b)/2 would wrap.
    if ((4294967295 as u32).midpoint(4294967293 as u32) != (4294967294 as u32)) {
        return test.fail("near MAX");
    }
    return test.assert_true((3000000000 as u32).midpoint(3000000002 as u32) == (3000000001 as u32));
}

function test_u64_basic(): test.TestOutcome {
    return test.assert_true((4 as u64).midpoint(6 as u64) == (5 as u64));
}

function test_u64_no_overflow(): test.TestOutcome {
    if ((10000000000 as u64).midpoint(10000000000 as u64) != (10000000000 as u64)) {
        return test.fail("large equal");
    }
    return test.assert_true((10000000000 as u64).midpoint(10000000004 as u64) == (10000000002 as u64));
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("std/uint midpoint");
    r = r.it("u32 basic",       test_u32_basic());
    r = r.it("u32 no overflow", test_u32_no_overflow());
    r = r.it("u64 basic",       test_u64_basic());
    r = r.it("u64 no overflow", test_u64_no_overflow());
    return r.finish();
}
