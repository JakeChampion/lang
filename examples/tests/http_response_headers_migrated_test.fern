import "std/test";
import "std/http";

// examples/tests/http_response_headers_migrated_test.fern
// — Fern port of `TestInterpScriptHttpResponseHeaders`
// from `internal/e2e/interp_script_test.go`. Pins the
// HeaderMap → HttpResponse wiring +
// `http_serialize_response` emission behaviour
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §2):
//
//   * Handlers can `resp.headers.set/append` and those
//     headers land in the wire ahead of the auto-emitted
//     Content-Length / Connection block.
//   * The auto block always wins for those two names so
//     a misconfigured handler can't ship a malformed
//     response.
//
// The Go original was 4 table-driven subprocess cases.
// Migrated to one Fern file: instead of print-then-grep
// the serialized wire, we assert directly on it via
// `assert_eq` (whole-wire compare) and the new
// `assert_contains` / `assert_not_contains` for
// invariants that span multiple cases.

function test_user_headers_before_auto_block(): test.TestOutcome {
    var r: HttpResponse = http.http_response_ok("hello");
    r = r.with_header("X-Trace-Id", "abc123");
    r = r.with_header("Cache-Control", "no-store");
    var wire: string = http.http_serialize_response(r);
    return test.assert_eq(wire,
        "HTTP/1.1 200 OK\r\n" +
        "x-trace-id: abc123\r\n" +
        "cache-control: no-store\r\n" +
        "Content-Length: 5\r\n" +
        "Connection: close\r\n" +
        "\r\n" +
        "hello");
}

function test_redirect_sets_location_header(): test.TestOutcome {
    var r: HttpResponse = http.http_response_redirect("/login");
    return test.assert_is_some_eq_string(r.headers.get("location"),
                                    "/login");
}

function test_user_content_length_is_ignored(): test.TestOutcome {
    var r: HttpResponse = http.http_response_ok("hi");
    // Handler tries to claim 9999 bytes — the auto block
    // must override with the real length (2).
    r = r.with_header("Content-Length", "9999");
    var wire: string = http.http_serialize_response(r);
    return test.assert_eq(wire,
        "HTTP/1.1 200 OK\r\n" +
        "Content-Length: 2\r\n" +
        "Connection: close\r\n" +
        "\r\n" +
        "hi");
}

function test_user_content_length_does_not_leak_into_wire(): test.TestOutcome {
    // Stronger negative form: the bogus "9999" must NOT
    // appear anywhere in the serialized output.
    var r: HttpResponse = http.http_response_ok("hi");
    r = r.with_header("Content-Length", "9999");
    var wire: string = http.http_serialize_response(r);
    return test.assert_not_contains(wire, "9999");
}

function test_duplicate_set_cookie_via_append(): test.TestOutcome {
    var r: HttpResponse = http.http_response_ok("hi");
    r = r.with_appended_header("Set-Cookie", "a=1");
    r = r.with_appended_header("Set-Cookie", "b=2");
    var wire: string = http.http_serialize_response(r);
    return test.assert_eq(wire,
        "HTTP/1.1 200 OK\r\n" +
        "set-cookie: a=1\r\n" +
        "set-cookie: b=2\r\n" +
        "Content-Length: 2\r\n" +
        "Connection: close\r\n" +
        "\r\n" +
        "hi");
}

function test_duplicate_set_cookie_both_in_order(): test.TestOutcome {
    // Order invariant: a=1 must come before b=2.
    var r: HttpResponse = http.http_response_ok("hi");
    r = r.with_appended_header("Set-Cookie", "a=1");
    r = r.with_appended_header("Set-Cookie", "b=2");
    var wire: string = http.http_serialize_response(r);
    return test.assert_contains_in_order(wire,
        ["set-cookie: a=1", "set-cookie: b=2"]);
}

// ---- status-line reason phrases (#4381) ----

// The serializer's reason table used to be a narrow duplicate of
// http_status_text that only knew 13 codes, so a 429 / 502 shipped
// the bogus phrase "Status". Now both share one table.
function test_status_reason_for_extended_codes(): test.TestOutcome {
    var wire: string = http.http_serialize_response(http.http_response_text(429, "slow"));
    return test.assert_contains(wire, "429 Too Many Requests");
}

// An unknown code still gets the generic "Status" fallback.
function test_status_reason_unknown_falls_back(): test.TestOutcome {
    var wire: string = http.http_serialize_response(http.http_response_text(599, ""));
    return test.assert_contains(wire, "599 Status");
}

function main(): i32 {
    var r: test.TestRunner = test.test_new("HTTP response headers (migrated)");
    r = r.it("user-set headers before auto block",
             test_user_headers_before_auto_block);
    r = r.it("redirect helper sets Location",
             test_redirect_sets_location_header);
    r = r.it("user Content-Length overridden by auto",
             test_user_content_length_is_ignored);
    r = r.it("bogus Content-Length absent from wire",
             test_user_content_length_does_not_leak_into_wire);
    r = r.it("duplicate Set-Cookie both appear",
             test_duplicate_set_cookie_via_append);
    r = r.it("duplicate Set-Cookie preserves order",
             test_duplicate_set_cookie_both_in_order);
    r = r.it("status reason for extended codes",
             test_status_reason_for_extended_codes);
    r = r.it("unknown status falls back to Status",
             test_status_reason_unknown_falls_back);
    return r.finish();
}
