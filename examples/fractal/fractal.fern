import "std/png";
import "std/result";
import "./linear";
import "./kernel";

pub const SIZE: i32 = 256;

const ROW_BYTES: i32 = SIZE * 3;

pub const MAX_ZOOM: i32 = 42;

pub enum RenderError { InvalidTile, Cancelled, Image(png.EncodeError) }

pub struct Tile {
  png: u8[],
  iterations: i64,
  compute_ns: i64,
  color_ns: i64,
  png_ns: i64,
}

pub fip function valid(z: i32, x: i64, y: i64): boolean {
  if (z < 0 || z > MAX_ZOOM) {
    return false;
  }
  let tiles_per_side = 1 as i64 << z as i64;
  return x >= 0 && y >= 0 && x < tiles_per_side && y < tiles_per_side;
}

pub fip function max_iterations(z: i32): i32 {
  let limit = 256 + 64 * z;
  if (limit > 3000) {
    return 3000;
  }
  return limit;
}

pub function render_reference(z: i32, x: i64, y: i64): Result[Tile, RenderError] {
  return render_batch(z, x, y, (): boolean => false, false);
}

function render_batch(z: i32, x: i64, y: i64, stop: () => boolean, fast: boolean): Result[Tile, RenderError] {
  let started = now_ns();
  if (!valid(z, x, y)) {
    return Err(InvalidTile);
  }
  let step = 4.0 / ((1 as i64 << (z + 8) as i64) as f64);
  let counts = __alloc_i32(SIZE * SIZE);
  let magnitudes = __alloc_i64(SIZE * SIZE);
  let result = EscapeBatch {
    limit: max_iterations(z),
    magnitude0: -1.0, magnitude1: -1.0, magnitude2: -1.0, magnitude3: -1.0,
    steps0: 0, steps1: 0, steps2: 0, steps3: 0,
  };
  let iterations: i64 = 0;
  for row in 0..SIZE {
    if (stop()) {
      return Err(Cancelled);
    }
    let imaginary = 2.0 - ((y * (SIZE as i64) + row as i64) as f64 + 0.5) * step;
    let column = 0;
    while (column < SIZE) {
      let real0 = -2.5 + ((x * (SIZE as i64) + column as i64) as f64 + 0.5) * step;
      let real1 = -2.5 + ((x * (SIZE as i64) + (column + 1) as i64) as f64 + 0.5) * step;
      let real2 = -2.5 + ((x * (SIZE as i64) + (column + 2) as i64) as f64 + 0.5) * step;
      let real3 = -2.5 + ((x * (SIZE as i64) + (column + 3) as i64) as f64 + 0.5) * step;
      result = escape_batch(result, real0, real1, real2, real3, imaginary);
      iterations += result.steps0 as i64 + result.steps1 as i64 + result.steps2 as i64 + result.steps3 as i64;
      counts = counts.with(row * SIZE + column + 0, result.steps0);
      magnitudes = magnitudes.with(row * SIZE + column + 0, f64_bits(result.magnitude0));
      counts = counts.with(row * SIZE + column + 1, result.steps1);
      magnitudes = magnitudes.with(row * SIZE + column + 1, f64_bits(result.magnitude1));
      counts = counts.with(row * SIZE + column + 2, result.steps2);
      magnitudes = magnitudes.with(row * SIZE + column + 2, f64_bits(result.magnitude2));
      counts = counts.with(row * SIZE + column + 3, result.steps3);
      magnitudes = magnitudes.with(row * SIZE + column + 3, f64_bits(result.magnitude3));
      column += 4;
    }
  }
  return finish(kernel.Pixels { counts: counts, magnitudes: magnitudes, iterations: iterations }, started, stop, fast);
}

pub function render(z: i32, x: i64, y: i64): Result[Tile, RenderError] {
  return render_cancellable(z, x, y, (): boolean => false);
}

pub function render_cancellable(z: i32, x: i64, y: i64, stop: () => boolean): Result[Tile, RenderError] {
  return render_kernel(z, x, y, true, stop);
}

pub function render_exact(z: i32, x: i64, y: i64): Result[Tile, RenderError] {
  return render_kernel(z, x, y, false, (): boolean => false);
}

fip function short_orbit(real: f64, imaginary: f64): boolean {
  let zr = 0.0;
  let zi = 0.0;
  let steps = 0;
  while (steps < 16) {
    let rr = zr * zr;
    let ii = zi * zi;
    if (rr + ii > 65536.0) {
      return true;
    }
    zi = 2.0 * zr * zi + imaginary;
    zr = rr - ii + real;
    steps += 1;
  }
  return false;
}

function render_kernel(z: i32, x: i64, y: i64, approximate: boolean, stop: () => boolean): Result[Tile, RenderError] {
  let started = now_ns();
  if (stop()) {
    return Err(Cancelled);
  }
  if (!valid(z, x, y)) {
    return Err(InvalidTile);
  }
  if (z < 12) {
    return render_batch(z, x, y, stop, approximate && z >= 20);
  }
  let step = 4.0 / ((1 as i64 << (z + 8) as i64) as f64);
  let view = kernel.View { size: SIZE, x: x * (SIZE as i64), y: y * (SIZE as i64), step: step, limit: max_iterations(z) };
  let real = -2.5 + ((view.x + 128) as f64 + 0.5) * step;
  let imaginary = 2.0 - ((view.y + 128) as f64 + 0.5) * step;
  if (short_orbit(real, imaginary)) {
    return render_batch(z, x, y, stop, approximate && z >= 20);
  }
  let reference: Option[linear.Reference] = None;
  let reference_work: i64 = 0;
  if (approximate && z >= 20) {
    let ref = linear.reference(real, imaginary, 182.0 * step, view.limit, 1e-8);
    reference_work = ref.zr.len() as i64 - 1;
    let corner = linear.prefix(ref, -2.5 + (view.x as f64 + 0.5) * step, 2.0 - (view.y as f64 + 0.5) * step, view.limit);
    if (ref.series.steps >= view.limit) {
      let counts = __alloc_i32(SIZE * SIZE);
      let magnitudes = __alloc_i64(SIZE * SIZE);
      return finish(kernel.Pixels { counts: counts, magnitudes: magnitudes, iterations: reference_work }, started, stop, approximate && z >= 20);
    }
    if (corner.steps >= 64) {
      reference = Some(ref);
    }
  }
  let pixels = kernel.render_cancellable(view, reference, stop).map_err((error: kernel.RenderError): RenderError => Cancelled)?;
  return finish(kernel.Pixels { ...pixels, iterations: pixels.iterations + reference_work }, started, stop, approximate && z >= 20);
}

function finish(pixels: kernel.Pixels, started: i64, stop: () => boolean, fast: boolean): Result[Tile, RenderError] {
  let compute_ns = now_ns() - started;
  let color_start = now_ns();
  let raw = __alloc_u8(SIZE * ROW_BYTES);
  for row in 0..SIZE {
    if (stop()) {
      return Err(Cancelled);
    }
    for at in row * SIZE..(row + 1) * SIZE {
      if (pixels.counts[at] > 0) {
        raw = color_pixel(raw, at * 3, f64_from_bits(pixels.magnitudes[at]), pixels.counts[at]);
      }
    }
  }
  let color_ns = now_ns() - color_start;
  if (stop()) {
    return Err(Cancelled);
  }
  let png_start = now_ns();
  let opts = png.options();
  if (fast) {
    opts = png.Options { ...opts, compression: png.Compression.Fast };
  }
  let bytes = png.encode_rgb8_with_options(SIZE, SIZE, raw, opts).map_err((error: png.EncodeError): RenderError => Image(error))?;
  return Ok(Tile { png: bytes, iterations: pixels.iterations, compute_ns: compute_ns, color_ns: color_ns, png_ns: now_ns() - png_start });
}

struct EscapeBatch {
  limit: i32,
  magnitude0: f64,
  magnitude1: f64,
  magnitude2: f64,
  magnitude3: f64,
  steps0: i32,
  steps1: i32,
  steps2: i32,
  steps3: i32,
}

fip function known_interior(real: f64, imaginary: f64): boolean {
  let imaginary_squared = imaginary * imaginary;
  let cardioid_x = real - 0.25;
  let bulb_x = real + 1.0;
  let q = cardioid_x * cardioid_x + imaginary_squared;
  return q * (q + real - 0.25) <= 0.25 * imaginary_squared || bulb_x * bulb_x + imaginary_squared <= 0.0625;
}

// fern-lint: allow cyclomatic-complexity
fip function escape_batch(own result: EscapeBatch, real0: f64, real1: f64, real2: f64, real3: f64, imaginary: f64): EscapeBatch {
  let done = 0;
  let steps0 = result.limit;
  let magnitude0 = -1.0;
  if (known_interior(real0, imaginary)) {
    done |= 1;
    steps0 = 0;
  }
  let steps1 = result.limit;
  let magnitude1 = -1.0;
  if (known_interior(real1, imaginary)) {
    done |= 2;
    steps1 = 0;
  }
  let steps2 = result.limit;
  let magnitude2 = -1.0;
  if (known_interior(real2, imaginary)) {
    done |= 4;
    steps2 = 0;
  }
  let steps3 = result.limit;
  let magnitude3 = -1.0;
  if (known_interior(real3, imaginary)) {
    done |= 8;
    steps3 = 0;
  }
  let imaginary_vector = __f64x2_splat(imaginary);
  let two = __f64x2_splat(2.0);
  let radius = __f64x2_splat(65536.0);
  let real01 = __f64x2_of(real0, real1);
  let real23 = __f64x2_of(real2, real3);
  let z_real01 = __f64x2_splat(0.0);
  let z_imaginary01 = z_real01;
  let z_real23 = z_real01;
  let z_imaginary23 = z_real01;
  let saved_real01 = z_real01;
  let saved_imaginary01 = z_real01;
  let saved_real23 = z_real01;
  let saved_imaginary23 = z_real01;
  let checkpoint = 16;
  let steps = 0;
  while (steps < result.limit && done != 15) {
    let first_real01 = z_real01;
    let first_imaginary01 = z_imaginary01;
    let first_real23 = z_real23;
    let first_imaginary23 = z_imaginary23;
    let end = steps + 4;
    if (end > result.limit) {
      end = result.limit;
    }
    let first = steps;
    if (steps + 4 <= result.limit) {
      {
        let rr01 = z_real01 * z_real01;
        let ii01 = z_imaginary01 * z_imaginary01;
        z_imaginary01 = two * z_real01 * z_imaginary01 + imaginary_vector;
        z_real01 = rr01 - ii01 + real01;
        let rr23 = z_real23 * z_real23;
        let ii23 = z_imaginary23 * z_imaginary23;
        z_imaginary23 = two * z_real23 * z_imaginary23 + imaginary_vector;
        z_real23 = rr23 - ii23 + real23;
      }
      {
        let rr01 = z_real01 * z_real01;
        let ii01 = z_imaginary01 * z_imaginary01;
        z_imaginary01 = two * z_real01 * z_imaginary01 + imaginary_vector;
        z_real01 = rr01 - ii01 + real01;
        let rr23 = z_real23 * z_real23;
        let ii23 = z_imaginary23 * z_imaginary23;
        z_imaginary23 = two * z_real23 * z_imaginary23 + imaginary_vector;
        z_real23 = rr23 - ii23 + real23;
      }
      {
        let rr01 = z_real01 * z_real01;
        let ii01 = z_imaginary01 * z_imaginary01;
        z_imaginary01 = two * z_real01 * z_imaginary01 + imaginary_vector;
        z_real01 = rr01 - ii01 + real01;
        let rr23 = z_real23 * z_real23;
        let ii23 = z_imaginary23 * z_imaginary23;
        z_imaginary23 = two * z_real23 * z_imaginary23 + imaginary_vector;
        z_real23 = rr23 - ii23 + real23;
      }
      {
        let rr01 = z_real01 * z_real01;
        let ii01 = z_imaginary01 * z_imaginary01;
        z_imaginary01 = two * z_real01 * z_imaginary01 + imaginary_vector;
        z_real01 = rr01 - ii01 + real01;
        let rr23 = z_real23 * z_real23;
        let ii23 = z_imaginary23 * z_imaginary23;
        z_imaginary23 = two * z_real23 * z_imaginary23 + imaginary_vector;
        z_real23 = rr23 - ii23 + real23;
      }
      steps += 4;
    } else {
      while (steps < end) {
        let rr01 = z_real01 * z_real01;
        let ii01 = z_imaginary01 * z_imaginary01;
        z_imaginary01 = two * z_real01 * z_imaginary01 + imaginary_vector;
        z_real01 = rr01 - ii01 + real01;
        let rr23 = z_real23 * z_real23;
        let ii23 = z_imaginary23 * z_imaginary23;
        z_imaginary23 = two * z_real23 * z_imaginary23 + imaginary_vector;
        z_real23 = rr23 - ii23 + real23;
        steps += 1;
      }
    }
    let mag01 = z_real01 * z_real01 + z_imaginary01 * z_imaginary01;
    let mag23 = z_real23 * z_real23 + z_imaginary23 * z_imaginary23;
    let escaped = (__f64x2_bitmask(__f64x2_lt(radius, mag01)) | __f64x2_bitmask(__f64x2_lt(radius, mag23)) << 2) & (15 ^ done);
    if (escaped != 0) {
      if ((escaped & 1) != 0) {
        let zr = __f64x2_lane(first_real01, 0);
        let zi = __f64x2_lane(first_imaginary01, 0);
        let count = first;
        while (count < end) {
          let rr = zr * zr;
          let ii = zi * zi;
          if (rr + ii > 65536.0) {
            magnitude0 = rr + ii;
            steps0 = count;
            done |= 1;
            break;
          }
          zi = 2.0 * zr * zi + imaginary;
          zr = rr - ii + real0;
          count += 1;
        }
      }
      if ((escaped & 2) != 0) {
        let zr = __f64x2_lane(first_real01, 1);
        let zi = __f64x2_lane(first_imaginary01, 1);
        let count = first;
        while (count < end) {
          let rr = zr * zr;
          let ii = zi * zi;
          if (rr + ii > 65536.0) {
            magnitude1 = rr + ii;
            steps1 = count;
            done |= 2;
            break;
          }
          zi = 2.0 * zr * zi + imaginary;
          zr = rr - ii + real1;
          count += 1;
        }
      }
      if ((escaped & 4) != 0) {
        let zr = __f64x2_lane(first_real23, 0);
        let zi = __f64x2_lane(first_imaginary23, 0);
        let count = first;
        while (count < end) {
          let rr = zr * zr;
          let ii = zi * zi;
          if (rr + ii > 65536.0) {
            magnitude2 = rr + ii;
            steps2 = count;
            done |= 4;
            break;
          }
          zi = 2.0 * zr * zi + imaginary;
          zr = rr - ii + real2;
          count += 1;
        }
      }
      if ((escaped & 8) != 0) {
        let zr = __f64x2_lane(first_real23, 1);
        let zi = __f64x2_lane(first_imaginary23, 1);
        let count = first;
        while (count < end) {
          let rr = zr * zr;
          let ii = zi * zi;
          if (rr + ii > 65536.0) {
            magnitude3 = rr + ii;
            steps3 = count;
            done |= 8;
            break;
          }
          zi = 2.0 * zr * zi + imaginary;
          zr = rr - ii + real3;
          count += 1;
        }
      }
    }
    if ((steps & 15) == 0) {
      if ((done & 1) == 0 && __f64x2_lane(z_real01, 0) == __f64x2_lane(saved_real01, 0) && __f64x2_lane(z_imaginary01, 0) == __f64x2_lane(saved_imaginary01, 0)) {
        steps0 = steps;
        done |= 1;
      }
      if ((done & 2) == 0 && __f64x2_lane(z_real01, 1) == __f64x2_lane(saved_real01, 1) && __f64x2_lane(z_imaginary01, 1) == __f64x2_lane(saved_imaginary01, 1)) {
        steps1 = steps;
        done |= 2;
      }
      if ((done & 4) == 0 && __f64x2_lane(z_real23, 0) == __f64x2_lane(saved_real23, 0) && __f64x2_lane(z_imaginary23, 0) == __f64x2_lane(saved_imaginary23, 0)) {
        steps2 = steps;
        done |= 4;
      }
      if ((done & 8) == 0 && __f64x2_lane(z_real23, 1) == __f64x2_lane(saved_real23, 1) && __f64x2_lane(z_imaginary23, 1) == __f64x2_lane(saved_imaginary23, 1)) {
        steps3 = steps;
        done |= 8;
      }
      if (steps == checkpoint) {
        saved_real01 = z_real01;
        saved_imaginary01 = z_imaginary01;
        saved_real23 = z_real23;
        saved_imaginary23 = z_imaginary23;
        checkpoint *= 2;
      }
    }
  }
  return EscapeBatch {
    ...result,
    magnitude0: magnitude0, magnitude1: magnitude1, magnitude2: magnitude2, magnitude3: magnitude3,
    steps0: steps0, steps1: steps1, steps2: steps2, steps3: steps3,
  };
}

function color_pixel(own raw: u8[], offset: i32, magnitude_squared: f64, steps: i32): u8[] {
  let red: u8 = 0;
  let green: u8 = 0;
  let blue: u8 = 0;
  if (magnitude_squared >= 0.0) {
    let smooth_count = steps as f64 + 1.0 - (0.5 * magnitude_squared.log()).log2();
    let position = smooth_count.sqrt() * 0.09;
    position -= position.floor();
    red = channel(position, 0);
    green = channel(position, 1);
    blue = channel(position, 2);
  }
  return write_pixel(raw, offset, red, green, blue);
}

fip function write_pixel(own raw: u8[], offset: i32, red: u8, green: u8, blue: u8): u8[] {
  return raw.with(offset, red).with(offset + 1, green).with(offset + 2, blue);
}

const STOPS: f64[] = [0.0, 0.16, 0.42, 0.6425, 0.8575, 1.0];

const RGB: f64[] = [
  0.0, 7.0, 100.0,
  32.0, 107.0, 203.0,
  237.0, 255.0, 255.0,
  255.0, 170.0, 0.0,
  0.0, 2.0, 0.0,
  0.0, 7.0, 100.0,
];

fip function channel(position: f64, component: i32): u8 {
  let stop = 0;
  while (position >= STOPS[stop + 1]) {
    stop += 1;
  }
  let fraction = (position - STOPS[stop]) / (STOPS[stop + 1] - STOPS[stop]);
  let start = RGB[3 * stop + component];
  let end = RGB[3 * stop + 3 + component];
  return (start + (end - start) * fraction) as u8;
}
