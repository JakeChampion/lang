// Serve Mandelbrot tiles over HTTP and WebSocket.
// The CDN caches HTTP tiles. WebSocket responses include render times.
// Browser assets live in web/.
import "std/http";
import "std/http/router";
import "std/http/static";
import "std/http/websocket";
import "std/json";
import "std/platform";
import "std/serve";
import "std/parse";
import "std/result";
import "std/binary";
import "./fractal";
import "./source";

const PORT: i32 = 8080;

// Each server instance tracks its own counters.
pub struct Stats {
  instance: string,
  started_ms: i64,
  binary_bytes: i64,
  tiles: Cell[i64],
  iterations: Cell[i64],
  render_ns: Cell[i64],
  sockets: Cell[i64],
}

@derive(json.Json)
struct StatsView {
  instance: string,
  binary_bytes: i64,
  uptime_ms: i64,
  tiles: i64,
  iterations: i64,
  render_ms: i64,
  sockets: i64,
  max_zoom: i32,
}

pub function stats(instance: string, started_ms: i64, binary_bytes: i64): Stats {
  return Stats {
    instance: instance,
    started_ms: started_ms,
    binary_bytes: binary_bytes,
    tiles: cell_new(0 as i64),
    iterations: cell_new(0 as i64),
    render_ns: cell_new(0 as i64),
    sockets: cell_new(0 as i64),
  };
}

function (state: Stats) view(now_ms: i64): StatsView {
  return StatsView {
    instance: state.instance,
    binary_bytes: state.binary_bytes,
    uptime_ms: now_ms - state.started_ms,
    tiles: state.tiles.get(),
    iterations: state.iterations.get(),
    render_ms: state.render_ns.get() / 1000000,
    sockets: state.sockets.get(),
    max_zoom: fractal.MAX_ZOOM,
  };
}

struct Rendered {
  tile: fractal.Tile,
  elapsed_ns: i64,
}

function (state: Stats) render(z: i32, x: i64, y: i64): Result[Rendered, fractal.RenderError] {
  let started_ns: i64 = now_ns();
  let tile: fractal.Tile = fractal.render(z, x, y)?;
  let elapsed_ns: i64 = now_ns() - started_ns;
  state.tiles.set(state.tiles.get() + 1);
  state.iterations.set(state.iterations.get() + tile.iterations);
  state.render_ns.set(state.render_ns.get() + elapsed_ns);
  return Ok(Rendered { tile: tile, elapsed_ns: elapsed_ns });
}

pub function routes[P: platform.Platform](state: Stats, web: string, sources: source.Page[]): router.Router[P] {
  let app: router.Router[P] = router.new[P]();
  app = app.get("/tile/{z}/{x}/{y}", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => tile(state, params));
  app = app.get("/ws", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => Ok(http.respond(websocket.accept(req, websocket.options(), session(state)))));
  app = app.get("/api/stats", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => Ok(http.json_of(state.view(plat.now_ms())).with_header("Cache-Control", "no-store")));
  app = app.get("/healthz", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => Ok(http.ok("ok")));
  app = app.get("/_src", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => Ok(http.redirect("/_src/")));
  app = app.get("/_src/{path...}", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => {
    let path: string = params.param("path")?;
    return Ok(source.serve(sources, path));
  });
  return app.get("/{path...}", (req: HttpRequest, params: router.Params, plat: P): Result[HttpResponse, dyn http.ToResponse] => Ok(static.serve(req, static.dir(web), plat)));
}

function tile(state: Stats, params: router.Params): Result[HttpResponse, dyn http.ToResponse] {
  let z: i32 = params.int("z")?;
  let x: i64 = coordinate(params, "x")?;
  let y: i64 = coordinate(params, "y")?;
  if (!fractal.valid(z, x, y)) {
    return Ok(http.bad_request("no such tile"));
  }
  let rendered: Rendered = state.render(z, x, y).map_err((error: fractal.RenderError): http.HttpError => http.fail(500, "tile renderer failed"))?;
  let response: HttpResponse = http.bytes(200, rendered.tile.png).with_content_type("image/png");
  response = response.with_header("Cache-Control", "public, max-age=31536000, immutable");
  response = response.with_header("Netlify-CDN-Cache-Control", "public, durable, max-age=31536000, immutable");
  response = response.with_header("Server-Timing", "render;dur=" + millis(rendered.elapsed_ns));
  response = response.with_header("X-Fern-Instance", state.instance);
  return Ok(response.with_header("X-Fern-Iterations", rendered.tile.iterations.to_string()));
}

// The client sends "id z x y" as text.
// Each binary response contains a 20-byte header followed by the PNG.
// The session opens with this container's stats as JSON.
function session(state: Stats): websocket.Handlers {
  return websocket.Handlers {
    open: (connection: websocket.Conn): void => {
      state.sockets.set(state.sockets.get() + 1);
      let sent: websocket.SendResult = connection.send_text(state.view(now_unix_ms()).to_json());
    },
    message: (connection: websocket.Conn, message: websocket.Message): void => on_message(state, connection, message),
    drain: (connection: websocket.Conn): void => {},
    close: (connection: websocket.Conn, code: i32, reason: string): void => { state.sockets.set(state.sockets.get() - 1); },
  };
}

function on_message(state: Stats, connection: websocket.Conn, message: websocket.Message): void {
  match (message) {
    Text(request) => {
      match (answer(state, request)) {
        Ok(response) => {
          let sent: websocket.SendResult = connection.send_binary(response);
        },
        Err(Rendering(_)) => {
          connection.close(1011, "tile renderer failed");
        },
        Err(_) => {
          connection.close(1008, "invalid tile request");
        }
      }
    },
    Binary(bytes) => {
      connection.close(1003, "send tile requests as text");
    }
  }
}

pub struct TileRequest { id: u32, z: i32, x: i64, y: i64 }

pub enum RequestError {
  InvalidFields,
  InvalidNumber(string, parse.IntError),
  OutOfRange,
  Rendering(fractal.RenderError),
}

pub function parse_request(request: string): Result[TileRequest, RequestError] {
  let fields: string[] = request.split(" ");
  if (fields.len() != 4) {
    return Err(InvalidFields);
  }
  let id: i64 = request_integer(fields[0], "id")?;
  let z: i64 = request_integer(fields[1], "zoom")?;
  let x: i64 = request_integer(fields[2], "x")?;
  let y: i64 = request_integer(fields[3], "y")?;
  if (!request_range(id, z) || !fractal.valid(z as i32, x, y)) {
    return Err(OutOfRange);
  }
  return Ok(TileRequest { id: id as u32, z: z as i32, x: x, y: y });
}

// Check the wider integers before narrowing the protocol fields.
fip function request_range(id: i64, z: i64): boolean {
  return id >= 0 && id <= 4294967295 && z >= 0 && z <= fractal.MAX_ZOOM as i64;
}

function answer(state: Stats, request: string): Result[u8[], RequestError] {
  let tile: TileRequest = parse_request(request)?;
  let rendered: Rendered = state.render(tile.z, tile.x, tile.y).map_err((error: fractal.RenderError): RequestError => Rendering(error))?;
  let response: u8[] = binary.append_u32_be([], tile.id);
  // The 20-byte header contains id:u32, microseconds:u32, iterations:u64, and tiles:u32, all big-endian.
  response = binary.append_u32_be(response, (rendered.elapsed_ns / 1000) as u32);
  response = binary.append_u64_be(response, rendered.tile.iterations as u64);
  response = binary.append_u32_be(response, state.tiles.get() as u32);
  return Ok(binary.append_bytes(response, rendered.tile.png));
}

function request_integer(text: string, field: string): Result[i64, RequestError] {
  match (parse.int64(text)) {
    Ok(value) => {
      return Ok(value);
    },
    Err(error) => {
      return Err(InvalidNumber(field, error));
    }
  }
}

function coordinate(params: router.Params, name: string): Result[i64, http.HttpError] {
  let text: string = params.param(name)?;
  match (parse.int64(text)) {
    Ok(value) => {
      return Ok(value);
    },
    Err(_) => {
      return Err(http.fail(400, "path parameter " + name + " is not an integer"));
    }
  }
}

// Format nanoseconds as milliseconds with three decimal places.
function millis(nanoseconds: i64): string {
  let microseconds: i64 = nanoseconds / 1000;
  let fraction: string = (1000 + microseconds % 1000).to_string();
  return (microseconds / 1000).to_string() + "." + fraction.drop(1);
}

function hex6(value: i32): string {
  let digits: string = "0123456789abcdef";
  let result: string = "";
  let index: i32 = 0;
  while (index < 6) {
    let digit: i32 = value >> 20 - 4 * index & 15;
    result = result + digits.drop(digit).take(1);
    index = index + 1;
  }
  return result;
}

// Return the binary size, or 0 when the host does not expose it.
function own_size(): i64 {
  match (read_file_bytes("/proc/self/exe")) {
    Ok(bytes) => {
      return bytes.len() as i64;
    },
    Err(error) => {
      return 0;
    }
  }
}

function main(): i32 {
  let state: Stats = stats(hex6(random_i32()), now_unix_ms(), own_size());
  match (source.load(".")) {
    Ok(sources) => {
      let handler: (HttpRequest, platform.Host) => HttpResponse = routes[platform.Host](state, "web", sources).handler();
      return serve.run_shutdown(PORT, serve.config(), handler, (reason: string): void => eprint("server: stopped, " + reason));
    },
    Err(message) => {
      eprint("server: " + message);
      return 1;
    }
  }
}
