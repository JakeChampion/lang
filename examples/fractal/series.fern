import "std/f64";

const ORDER: i32 = 16;

pub struct Model {
  steps: i32,
  radius: f64,
  real: f64,
  imaginary: f64,
  cr: f64[],
  ci: f64[],
  error: f64,
}

function norm(real: f64, imaginary: f64): f64 {
  return (real * real + imaginary * imaginary).sqrt();
}

pub function build(zr: f64[], zi: f64[], radius: f64, tolerance: f64): Model {
  let cr: f64[] = [];
  let ci: f64[] = [];
  for _ in 0..ORDER {
    cr = cr.append(0.0);
    ci = ci.append(0.0);
  }
  let best = Model { steps: 0, radius: radius, real: 0.0, imaginary: 0.0, cr: cr, ci: ci, error: 0.0 };
  let error = 0.0;
  let bound = 0.0;
  let n = 0;
  while (n + 1 < zr.len() && radius > 0.0) {
    let sizes: f64[] = [];
    for j in 0..ORDER {
      sizes = sizes.append(norm(cr[j], ci[j]));
    }
    let tail = 0.0;
    for j in 0..ORDER {
      for q in ORDER - 1 - j..ORDER {
        tail += sizes[j] * sizes[q];
      }
    }
    let center = norm(zr[n], zi[n]);
    error = (2.0 * center + 2.0 * bound) * error + error * error + tail
      + 1.5e-14 * (2.0 * center * bound + bound * bound + radius);
    let nr: f64[] = [];
    let ni: f64[] = [];
    bound = 0.0;
    for k in 0..ORDER {
      let r = 2.0 * (zr[n] * cr[k] - zi[n] * ci[k]);
      let i = 2.0 * (zr[n] * ci[k] + zi[n] * cr[k]);
      if (k == 0) {
        r += radius;
      }
      for j in 0..k {
        let q = k - 1 - j;
        r = r + cr[j] * cr[q] - ci[j] * ci[q];
        i = i + cr[j] * ci[q] + ci[j] * cr[q];
      }
      nr = nr.append(r);
      ni = ni.append(i);
      bound += norm(r, i);
    }
    n += 1;
    if (!(bound < 1.0 && error <= tolerance * bound + 1e-30 && norm(zr[n], zi[n]) + bound + error < 256.0)) {
      break;
    }
    cr = nr;
    ci = ni;
    best = Model { steps: n, radius: radius, real: zr[n], imaginary: zi[n], cr: cr, ci: ci, error: error };
  }
  return best;
}

pub struct Value { real: f64, imaginary: f64 }

pub function evaluate(model: Model, real: f64, imaginary: f64): Value {
  let tr = real / model.radius;
  let ti = imaginary / model.radius;
  let r = 0.0;
  let i = 0.0;
  let k = model.cr.len() - 1;
  while (k >= 0) {
    let next = r * tr - i * ti + model.cr[k];
    i = r * ti + i * tr + model.ci[k];
    r = next;
    k -= 1;
  }
  return Value { real: r * tr - i * ti, imaginary: r * ti + i * tr };
}
