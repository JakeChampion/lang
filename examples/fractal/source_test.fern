import "std/test";
import "std/http";
import "std/platform";
import "std/option";
import "std/result";
import "./source";
import "./server";

function test_highlight(): test.TestOutcome {
  let html: string = source.highlight("pub fip function write(own value: u32): u32 { return 42; }");
  return test.assert_true(
    html.contains("<span class=\"k\">fip</span>") && html.contains("<span class=\"k\">own</span>")
      && html.contains("<span class=\"t\">u32</span>") && html.contains("<span class=\"n\">42</span>"),
  );
}

function test_imports(): test.TestOutcome {
  let html: string = source.highlight("  import \"./fractal\" as tiles; // use the renderer");
  return test.assert_true(
    html.starts_with("  ") && html.contains("href=\"/_src/fractal.fern\"")
      && html.contains("<span class=\"s\">&quot;./fractal&quot;</span></a>")
      && html.contains("<span class=\"k\">as</span> tiles;") && html.contains("<span class=\"c\">// use the renderer</span>")
      && source.highlight("import\t\"std/binary\";").contains("/internal/stdlib/std/binary.fern.md\""),
  );
}

function test_import_targets(): test.TestOutcome {
  return test.assert_true(
    source.import_href("././source.fern").unwrap_or("") == "/_src/source.fern"
      && source.import_href("std/http").unwrap_or("") == "https://github.com/JakeChampion/lang/blob/main/internal/stdlib/std/http.fern.md"
      && source.import_href("../../compiler/weave").unwrap_or("") == "https://github.com/JakeChampion/lang/blob/main/compiler/weave.fern"
      && source.import_href("std/option").unwrap_or("").ends_with("/std/option.fern.md")
      && source.import_href("./missing").is_none() && source.import_href("../../../etc/passwd").is_none(),
  );
}

function test_fake_imports(): test.TestOutcome {
  return test.assert_true(
    !source.highlight("// import \"./fractal\";").contains("<a ")
      && !source.highlight("let text: string = \"import ./fractal\";").contains("<a ")
      && !source.highlight("import \"./fractal").contains("<a ")
      && !source.highlight("important \"./fractal\";").contains("<a "),
  );
}

function test_escape_html(): test.TestOutcome {
  let html: string = source.render("<title>&", "// </code></pre><script>alert('x')</script>\nlet text: string = \"<&>\";\n");
  return test.assert_true(
    !html.contains("<script>") && html.contains("&lt;script&gt;") && html.contains("&lt;title&gt;&amp;")
      && html.contains("&lt;&amp;&gt;"),
  );
}

function test_line_links(): test.TestOutcome {
  let html: string = source.render("fractal.fern", "// first\n\nlet count: i32 = 3;\n");
  return test.assert_true(
    html.contains("id=\"L1\"") && html.contains("id=\"L2\"") && html.contains("id=\"L3\"")
      && html.contains("href=\"#L3\"") && !html.contains("id=\"L4\"")
      && html.contains("aria-current=\"page\">fractal.fern"),
  );
}

function test_routes(): test.TestOutcome {
  let pages: source.Page[] = [source.Page { name: "fractal.fern", html: source.render("fractal.fern", "pub const SIZE: i32 = 256;\n") }];
  let routes = server.routes[platform.Host](server.stats("test", 0, 0, "test-version"), "web", pages);
  let index: HttpResponse = routes.handle(http.request("GET", "/_src/"), platform.host());
  let file: HttpResponse = routes.handle(http.request("GET", "/_src/fractal.fern"), platform.host());
  let missing: HttpResponse = routes.handle(http.request("GET", "/_src/missing.fern"), platform.host());
  let redirect: HttpResponse = routes.handle(http.request("GET", "/_src"), platform.host());
  return test.assert_true(
    index.status == 200 && index.body_string().contains("Application source")
      && file.status == 200 && file.body_string().contains("<span class=\"k\">const</span>")
      && file.headers.get("Content-Type").unwrap_or("") == "text/html; charset=utf-8"
      && file.headers.get("Cache-Control").unwrap_or("") == "no-cache"
      && missing.status == 404 && redirect.headers.get("Location").unwrap_or("") == "/_src/",
  );
}

function test_unknown_paths(): test.TestOutcome {
  let pages: source.Page[] = [];
  return test.assert_true(
    source.serve(pages, "../server.fern").status == 404
      && source.serve(pages, "/etc/passwd").status == 404
      && source.serve(pages, "server.fern\x00").status == 404,
  );
}

function test_request_errors(): test.TestOutcome {
  match (server.parse_request("4294967295 42 4398046511103 4398046511103")) {
    Ok(tile) => {
      if (tile.id != 4294967295 as u32 || tile.z != 42 || tile.x != 4398046511103) {
        return test.fail("valid request changed during parsing");
      }
    },
    Err(_) => {
      return test.fail("valid request was rejected");
    }
  }
  for request in ["", "1 2 3", "1 2 3 4 5", "-1 0 0 0", "4294967296 0 0 0", "1 4294967296 0 0", "1 42 9223372036854775808 0", "1 42 -1 0", "1 0 0 x", "1 42 4398046511104 0"] {
    if (server.parse_request(request).is_ok()) {
      return test.fail("malformed request was accepted");
    }
  }
  let routes = server.routes[platform.Host](server.stats("test", 0, 0, "test-version"), "web", []);
  for path in ["/tile/test-version/0/9223372036854775808/0", "/tile/test-version/42/-1/0", "/tile/test-version/43/0/0", "/tile/test-version/0/x/0"] {
    if (routes.handle(http.request("GET", path), platform.host()).status != 400) {
      return test.fail("malformed tile route did not return 400");
    }
  }
  return test.pass();
}

function test_version_and_cancel(): test.TestOutcome {
  let state: server.Stats = server.stats("test", 0, 1, "test-version");
  let routes = server.routes[platform.Host](state, "web", []);
  let config: HttpResponse = routes.handle(http.request("GET", "/api/config"), platform.host());
  let old: HttpResponse = routes.handle(http.request("GET", "/tile/42/0/0"), platform.host());
  let wrong: HttpResponse = routes.handle(http.request("GET", "/tile/old-version/42/0/0"), platform.host());
  if (config.status != 200 || !config.body_string().contains("test-version") || config.headers.get("Cache-Control").unwrap_or("") != "no-store") {
    return test.fail("renderer configuration is missing or cacheable");
  }
  if (old.headers.get("Location").unwrap_or("") != "/tile/test-version/42/0/0" || old.headers.get("Cache-Control").unwrap_or("") != "no-store" || wrong.status != 404) {
    return test.fail("renderer versions share a cache URL");
  }
  let session_id: string = "0123456789abcdef";
  let cancelled: HttpResponse = routes.handle(http.request("POST", "/cancel/" + session_id + "/1"), platform.host());
  let request: HttpRequest = http.request("GET", "/tile/test-version/42/0/0").with_header("X-Fern-Session", session_id).with_header("X-Fern-Request", "1");
  let refused: HttpResponse = routes.handle(request, platform.host());
  if (cancelled.status != 204 || refused.status != 499 || state.tiles.get() != 0 || state.cancelled.get().len() != 0) {
    return test.fail("cancelled work was rendered or retained");
  }
  let rendered: HttpResponse = routes.handle(http.request("GET", "/tile/test-version/42/0/0"), platform.host());
  if (rendered.status != 200 || rendered.headers.get("X-Fern-Renderer").unwrap_or("") != "test-version"
    || !rendered.headers.get("Server-Timing").unwrap_or("").contains("png;dur=")
    || rendered.headers.get("Cache-Control").unwrap_or("") != "public, max-age=31536000, immutable") {
    return test.fail("versioned PNG response metadata differs");
  }
  if (server.request_key(session_id, "4294967295").unwrap_or("") != session_id + ":4294967295"
    || server.request_key(session_id, "4294967296").is_ok() || server.request_key("short", "1").is_ok()
    || server.request_key("0123456789abcdef/", "1").is_ok() || server.request_key(session_id, "0").is_ok()) {
    return test.fail("cancellation token bounds differ");
  }
  let no_binary = server.routes[platform.Host](server.stats("test", 0, 0, "source-version"), "web", []);
  let uncacheable: HttpResponse = no_binary.handle(http.request("GET", "/tile/source-version/42/0/0"), platform.host());
  if (uncacheable.headers.get("Cache-Control").unwrap_or("") != "no-store") {
    return test.fail("fallback identity received an immutable cache policy");
  }
  let invalid_token: HttpRequest = http.request("GET", "/tile/test-version/42/0/0").with_header("X-Fern-Session", "short");
  if (routes.handle(invalid_token, platform.host()).status != 400) {
    return test.fail("malformed cancellation headers were ignored");
  }
  return test.pass();
}

function main(): i32 {
  let runner: test.TestRunner = test.test_new("fractal source browser");
  runner = runner.it("Fern tokens", test_highlight);
  runner = runner.it("import links and aliases", test_imports);
  runner = runner.it("local and library targets", test_import_targets);
  runner = runner.it("comments, strings, and malformed imports", test_fake_imports);
  runner = runner.it("HTML escaping", test_escape_html);
  runner = runner.it("line anchors and active file", test_line_links);
  runner = runner.it("source routes before static files", test_routes);
  runner = runner.it("unknown and traversal paths", test_unknown_paths);
  runner = runner.it("typed request errors and HTTP 400", test_request_errors);
  runner = runner.it("renderer cache versions and cancellation", test_version_and_cancel);
  return runner.finish();
}
