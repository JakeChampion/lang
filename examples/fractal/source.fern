import "std/string";
import "../../compiler/literate";
import "../../compiler/util";
import "../../compiler/weave";

const FILES: string[] = ["server.fern", "fractal.fern", "linear.fern", "series.fern", "kernel.fern", "acceleration_test.fern", "source.fern", "fractal_test.fern", "source_test.fern"];

const REPOSITORY: string = "https://github.com/JakeChampion/lang/blob/main/";

// These standard modules keep their canonical source in literate documents.
