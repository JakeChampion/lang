td/http/auth.fern", "internal/stdlib/std/http/cache.fern", "internal/stdlib/std/http/compress.fern", "internal/stdlib/std/http/cookie.fern", "internal/stdlib/std/http/cors.fern", "internal/stdlib/std/http/form.fern", "internal/stdlib/std/http/forwarded.fern", "internal/stdlib/std/http/grpc.fern", "internal/stdlib/std/http/h2.fern", "internal/stdlib/std/http/h2/frame.fern", "internal/stdlib/std/http/h3.fern", "internal/stdlib/std/http/h3q.fern", "internal/stdlib/std/http/hpack.fern", "internal/stdlib/std/http/huffman.fern", "internal/stdlib/std/http/multipart.fern", "internal/stdlib/std/http/qpack.fern", "internal/stdlib/std/http/requestid.fern", "internal/stdlib/std/http/router.fern", "internal/stdlib/std/http/sse.fern", "internal/stdlib/std/http/static.fern", "internal/stdlib/std/http/trace.fern", "internal/stdlib/std/http/websocket.fern", "internal/stdlib/std/i32.fern", "internal/stdlib/std/i64.fern", "internal/stdlib/std/io.fern", "internal/stdlib/std/io_buffered.fern", "internal/stdlib/std/jni.fern", "internal/stdlib/std/json.fern", "internal/stdlib/std/log.fern", "internal/stdlib/std/math.fern", "internal/stdlib/std/metrics.fern", "internal/stdlib/std/mock_platform.fern", "internal/stdlib/std/ndarray.fern", "internal/stdlib/std/net.fern", "internal/stdlib/std/num.fern", "internal/stdlib/std/number_parse.fern", "internal/stdlib/std/option.fern", "internal/stdlib/std/ordmap.fern", "internal/stdlib/std/ordset.fern", "internal/stdlib/std/path.fern", "internal/stdlib/std/peg.fern", "internal/stdlib/std/platform.fern", "internal/stdlib/std/pmap.fern", "internal/stdlib/std/png.fern", "internal/stdlib/std/protobuf.fern", "internal/stdlib/std/pset.fern", "internal/stdlib/std/pvec.fern", "internal/stdlib/std/quic/conn.fern", "internal/stdlib/std/quic/frames.fern", "internal/stdlib/std/quic/packet.fern", "internal/stdlib/std/quic/params.fern", "internal/stdlib/std/quic/recovery.fern", "internal/stdlib/std/quic/streams.fern", "internal/stdlib/std/rand.fern", "internal/stdlib/std/regex.fern", "internal/stdlib/std/result.fern", "internal/stdlib/std/semver.fern", "internal/stdlib/std/serve.fern", "internal/stdlib/std/signal.fern", "internal/stdlib/std/sim.fern", "internal/stdlib/std/sim_fetch.fern", "internal/stdlib/std/sim_platform.fern", "internal/stdlib/std/simd.fern", "internal/stdlib/std/strdist.fern", "internal/stdlib/std/stream.fern", "internal/stdlib/std/string.fern", "internal/stdlib/std/table.fern", "internal/stdlib/std/test.fern", "internal/stdlib/std/textwrap.fern", "internal/stdlib/std/time.fern", "internal/stdlib/std/tls.fern", "internal/stdlib/std/tls/client.fern", "internal/stdlib/std/tls/der.fern", "internal/stdlib/std/tls/handshake.fern", "internal/stdlib/std/tls/identity.fern", "internal/stdlib/std/tls/keyschedule.fern", "internal/stdlib/std/tls/keyshare.fern", "internal/stdlib/std/tls/ktls.fern", "internal/stdlib/std/tls/message.fern", "internal/stdlib/std/tls/pem.fern", "internal/stdlib/std/tls/record.fern", "internal/stdlib/std/tls/server.fern", "internal/stdlib/std/tls/verify.fern", "internal/stdlib/std/tls/x509.fern", "internal/stdlib/std/tz.fern", "internal/stdlib/std/u32.fern", "internal/stdlib/std/u64.fern", "internal/stdlib/std/url.fern", "internal/stdlib/std/utf8.fern", "internal/stdlib/std/uuid.fern", "internal/stdlib/std/wasi_http.fern", "internal/stdlib/std/wasm/component.fern", "internal/stdlib/std/wasm/convert.fern", "internal/stdlib/std/wasm/encode.fern", "internal/stdlib/std/wasm/imports.fern", "internal/stdlib/std/wasm/inst.fern", "internal/stdlib/std/wasm/leb128.fern", "internal/stdlib/std/wasm/memory.fern", "internal/stdlib/std/wasm/module.fern", "internal/stdlib/std/wasm/numeric.fern", "internal/stdlib/std/wasm/sections.fern", "internal/stdlib/std/zstd.fern"];

pub struct Page {
  name: string,
  html: string,
}

pub function load(root: string): Result[Page[], string] {
  return load_files(root, FILES);
}

pub function load_files(root: string, files: string[]): Result[Page[], string] {
  let pages: Page[] = [];
  for name in files {
    let file = read_file(root + "/" + name);
    if (file.is_err() && name.ends_with(".fern")) {
      file = read_file(root + "/" + name + ".md");
    }
    match (file) {
      Ok(text) => {
        pages = pages.append(Page { name: name, html: render_files(name, text, files) });
      },
      Err(error) => {
        return Err("cannot read source file " + root + "/" + name);
      }
    }
  }
  return Ok(pages);
}

pub function serve(pages: Page[], path: string): HttpResponse {
  if (path.len() == 0 || path.ends_with("/")) {
    let files: string[] = [];
    for page in pages {
      if (page.name.starts_with(path)) {
        files = files.append(page.name);
      }
    }
    if (files.len() == 0) {
      return http.not_found();
    }
    return response(layout("Application source", "<h1>Application source</h1><p>Every application is open. Follow an import to read the next module.</p>" + navigation("", files)));
  }
  for page in pages {
    if (page.name == path || page.name == path + ".md") {
      return response(page.html);
    }
  }
  return http.not_found();
}

function response(html: string): HttpResponse {
  return http.html(html).with_header("Cache-Control", "no-cache").with_header("X-Content-Type-Options", "nosniff");
}

pub function render(name: string, text: string): string {
  return render_files(name, text, FILES);
}

pub function render_files(name: string, text: string, files: string[]): string {
  if (literate.is_program(text)) {
    let html: string = weave.weave_html(text);
    for line in text.split("\n") {
      if (line.trim_start().starts_with("import ")) {
        html = html.replace(weave.highlight_fern(line), highlight_from(line, name, files));
      }
    }
    return html.replace_first("</head>", stored_theme() + "<style>" + theme() + lesson_styles() + "</style></head>").replace_first("<body>", "<body>" + header());
  }
  let body: string = "<h1>" + weave.html_escape(name) + "</h1>" + navigation(name, files) + "<pre class=\"code\"><code>";
  let lines: string[] = text.split("\n");
  let count: i32 = lines.len();
  if (text.ends_with("\n")) {
    count = count - 1;
  }
  let index: i32 = 0;
  while (index < count) {
    let number: string = (index + 1).to_string();
    body = body + "<span class=\"line\" id=\"L" + number + "\"><a class=\"line-number\" href=\"#L" + number
      + "\" aria-label=\"Line " + number + "\">" + number + "</a>" + highlight_from(lines[index], name, files) + "</span>";
    index = index + 1;
  }
  return layout(name, body + "</code></pre>");
}

pub function highlight(line: string): string {
  return highlight_from(line, "fractal.fern", FILES);
}

pub function highlight_from(line: string, name: string, files: string[]): string {
  match (import_markup(line, name, files)) {
    Some(html) => {
      return html;
    },
    None => {
      return weave.highlight_fern(line);
    }
  }
}

function import_markup(line: string, name: string, files: string[]): Option[string] {
  let start: i32 = import_start(line)?;
  let end: i32 = import_end(line, start)?;
  let module: string = line.drop(start + 1).take(end - start - 1);
  let href: string = import_href_from(module, name, files)?;
  return Some(weave.highlight_fern(line.take(start)) + "<a class=\"import\" href=\"" + weave.html_escape(href) + "\">"
    + weave.highlight_fern(line.drop(start).take(end - start + 1)) + "</a>" + weave.highlight_fern(line.drop(end + 1)));
}

function import_start(line: string): Option[i32] {
  let trimmed: string = line.trim_start();
  if (!trimmed.starts_with("import ") && !trimmed.starts_with("import\t") && !trimmed.starts_with("export ") && !trimmed.starts_with("export\t")) {
    return None;
  }
  let start: i32 = line.len() - trimmed.len() + 6;
  while (start < line.len() && (line[start] == b' ' || line[start] == b'\t')) {
    start = start + 1;
  }
  if (start >= line.len()) {
    return None;
  }
  if (line[start] != b'"') {
    let Some(from) = line.index_of(" from ") else {
      return None;
    };
    start = from + 6;
    if (start >= line.len() || line[start] != b'"') {
      return None;
    }
  }
  return Some(start);
}

function import_end(line: string, start: i32): Option[i32] {
  let end: i32 = start + 1;
  while (end < line.len() && line[end] != b'"') {
    if (line[end] == b'\\') {
      return None;
    }
    end = end + 1;
  }
  if (end == line.len()) {
    return None;
  }
  return Some(end);
}

pub function import_href(module: string): Option[string] {
  return import_href_from(module, "fractal.fern", FILES);
}

pub function import_href_from(module: string, current: string, files: string[]): Option[string] {
  let directory: string = "examples/fractal";
  let prefix: string = "examples/fractal/";
  if (current.contains("/")) {
    let parts: string[] = current.split("/");
    directory = "examples/" + parts.take(parts.len() - 1).join("/");
    prefix = "examples/";
  }
  let path: string = util.resolve_path(module, directory, "internal/stdlib");
  if (module.ends_with(".mjs") || module.ends_with(".js")) {
    path = util.clean_path(directory + "/" + module);
  }
  if (module.starts_with("/fractal/")) {
    path = "examples/fractal/web/" + module.drop(9);
  }
  if (module.starts_with("/assets/")) {
    path = "examples/showcase/web/shared/" + module.drop(8);
  }
  for name in files {
    if (path == prefix + name || path + ".md" == prefix + name) {
      return Some("/_src/" + name);
    }
  }
  if (path.starts_with("internal/stdlib/") || path.starts_with("compiler/")) {
    for lesson in STDLIB_LESSONS {
      if (path == lesson) {
        path = path + ".md";
      }
    }
    let encoded: string[] = [];
    for segment in path.split("/") {
      encoded = encoded.append(url.encode(segment));
    }
    return Some(REPOSITORY + encoded.join("/"));
  }
  return None;
}

function navigation(current: string, files: string[]): string {
  let html: string = "<nav aria-label=\"Source files\">";
  for name in files {
    let active: string = "";
    if (name == current) {
      active = " aria-current=\"page\"";
    }
    html = html + "<a href=\"/_src/" + name + "\"" + active + ">" + name + "</a>";
  }
  return html + "</nav>";
}

function layout(title: string, body: string): string {
  return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    + "<title>" + weave.html_escape(title) + " · Fern source</title>" + stored_theme() + "<style>" + theme() + styles() + "</style></head><body>"
    + header() + "<main>" + body + "</main></body></html>";
}

function header(): string {
  return "<header class=\"source-nav\"><a class=\"brand\" href=\"/\">Fern<span>source</span></a>"
    + "<nav><a href=\"/\">All examples</a><a href=\"/_src/\">Application source</a></nav></header>";
}

// The palette and fonts of the Fern documentation site, shared with the showcase.
// Applies the theme the visitor chose in the showcase navigation.
function stored_theme(): string {
  return "<script>try{var t=localStorage.getItem('fern-theme');if(t=='light'||t=='dark')document.documentElement.dataset.theme=t}catch(e){}</script>";
}

function theme(): string {
  return "@font-face{font-family:'Fraunces';font-weight:400 700;font-display:swap;src:url(/assets/fonts/fraunces-400-700-latin.woff2) format('woff2')}"
    + "@font-face{font-family:'IBM Plex Mono';font-weight:400;font-display:swap;src:url(/assets/fonts/ibm-plex-mono-400-latin.woff2) format('woff2')}"
    + ":root{color-scheme:light dark;--bg:light-dark(#faf7f0,#101a15);--nav:light-dark(#f6f2e9,#141f19);--raised:light-dark(#f5f1e7,#131e18);--line:light-dark(#ddd8c9,#2c3d33);"
    + "--text:light-dark(#3b4d43,#b9c8be);--strong:light-dark(#16241d,#f2f7f3);--muted:light-dark(#5d6f64,#8ba394);--accent:light-dark(#2b6a4d,#9ddcbc);--accent-low:light-dark(#d8f3dc,#12291f);"
    + "--spore:light-dark(#8a6520,#b08331);--kw:light-dark(#8a6520,#d9b169);--ty:light-dark(#2b6a4d,#9ddcbc);--st:light-dark(#5b6b1f,#c3d99a);--nu:light-dark(#a4472d,#e0a387);"
    + "--display:'Fraunces',Georgia,serif;--mono:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace}"
    + ":root[data-theme=light]{color-scheme:light}:root[data-theme=dark]{color-scheme:dark}"
    + "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.65 ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif}"
    + "a{color:var(--accent);text-underline-offset:.22em}a:focus-visible{outline:2px solid var(--spore);outline-offset:2px}"
    + "h1,h2,h3{color:var(--strong);font-family:var(--display);font-weight:600;font-variation-settings:'SOFT' 30,'WONK' 1;letter-spacing:-.01em}"
    + ".source-nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.5rem 1rem;min-height:3.5rem;padding:.5rem max(1rem,calc((100% - 100rem)/2));background:var(--nav);border-bottom:1px solid var(--line)}"
    + ".source-nav .brand{display:flex;align-items:baseline;gap:.7rem;color:var(--strong);font:600 1.25rem var(--display);text-decoration:none}"
    + ".source-nav .brand span{padding-left:.7rem;border-left:1px solid var(--line);font:500 .68rem var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}"
    + ".source-nav nav{display:flex;gap:.25rem;margin:0;max-height:none}.source-nav nav a{padding:.35rem .65rem;border:0;border-radius:.35rem;color:var(--text);font:.875rem/1.4 inherit;text-decoration:none}"
    + ".source-nav nav a:hover{color:var(--strong);background:var(--accent-low)}";
}

function styles(): string {
  return "main{max-width:100rem;margin:auto;padding:2rem 1.5rem}h1{font-size:2rem;overflow-wrap:anywhere;margin:.5rem 0}p{color:var(--muted)}"
    + "main nav{display:flex;flex-wrap:wrap;gap:.4rem;margin:1.25rem 0 1.5rem;max-height:12rem;overflow:auto}"
    + "main nav a{padding:.25rem .6rem;border:1px solid var(--line);border-radius:.25rem;color:var(--text);font:.78rem/1.5 var(--mono);text-decoration:none}"
    + "main nav a:hover{border-color:var(--accent);color:var(--strong)}main nav a[aria-current]{background:var(--accent-low);border-color:var(--accent);color:var(--strong)}"
    + ".code{overflow-x:auto;padding:1rem 0;background:var(--raised);border:1px solid var(--line);border-radius:.5rem;color:var(--strong);font:13px/1.7 var(--mono);tab-size:2}"
    + ".line{display:block;min-height:1.7em;padding-right:1rem}.line:target{background:var(--accent-low);box-shadow:inset 2px 0 var(--spore)}"
    + ".line-number{display:inline-block;width:5em;padding-right:1.5em;color:var(--muted);text-align:right;text-decoration:none;user-select:none}"
    + ".code .k{color:var(--kw)}.code .t{color:var(--ty)}.code .s{color:var(--st)}.code .n{color:var(--nu)}.code .c{color:var(--muted);font-style:italic}"
    + ".import{color:inherit;text-decoration:underline;text-decoration-color:var(--line)}.import:hover{background:var(--accent-low)}"
    + "@media(max-width:600px){main{padding:1rem .75rem}.line-number{width:3.5em;padding-right:1em}}";
}

// Maps the woven lesson's own variables and type onto the theme.
function lesson_styles(): string {
  return ":root{--fg:var(--text);--code-bg:var(--raised);--border:var(--line);--type:var(--ty);--str:var(--st);--com:var(--muted);--num:var(--nu)}"
    + "main{padding-top:2.5rem}h1{font-size:2.4rem;border:0;line-height:1.1}"
    + "h2{position:relative;margin-top:2.5em;padding:1.2rem 0 0;border:0;border-top:1px solid var(--line)}"
    + "h2::before{content:'';position:absolute;top:-1px;left:0;width:2.5rem;height:2px;background:var(--spore)}"
    + "code,pre.code code,section.chunk-index li{font-family:var(--mono)}code{border-radius:.25rem}"
    + ".chunk-label{font:500 .75rem/1.5 var(--mono);letter-spacing:.04em}.chunk-name{color:var(--strong)}"
    + "nav.toc{border-radius:.5rem}nav.toc .toc-title{font:500 .68rem var(--mono);letter-spacing:.14em}"
    + "blockquote{border-left:2px solid var(--spore)}";
}
