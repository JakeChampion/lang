import "std/array" as array;

// array_scale_f64 — the elementwise multiply kernel, the first array kernel
// of the fused set (docs/ATLAS-PLATFORM-PLAN.md §3.4, docs/ARRAY-SHAPES.md
// §9): every element of a 4,096-element f64[] (32 KiB, the same footprint as
// the string kernels' haystack) multiplied by one scalar into a fresh array.
//
// There is no early exit and nothing data-dependent in the body: the whole
// input is read and the whole output written on every call, so this measures
// the per-element cost of the loop and the one allocation the result needs,
// nothing else. The factor cycles through five values and the checksum reads
// a different element each round, so a hoisted call or a result computed once
// and reused shows up as a checksum that stops depending on the rounds.
function vector(): f64[] {
    var xs: f64[] = [];
    var i: i32 = 0;
    while (i < 4096) {
        xs = xs.append(((i % 17) as f64) + 0.5);
        i = i + 1;
    }
    return xs;
}

function main(): i32 {
    var xs: f64[] = vector();
    var acc: i64 = 0;
    var r: i32 = 0;
    while (r < 4000) {
        var k: f64 = ((r % 5) + 1) as f64;
        var ys: f64[] = array.scale_f64(xs, k);
        acc = acc + (ys[r % 4096] as i64);
        r = r + 1;
    }
    return (acc % 97i64) as i32;
}
