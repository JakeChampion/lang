import "std/i32";

// string_scan — the self-hosted compiler's dominant shape: a needle compared
// against every entry of a string array until it matches. Exercises string
// equality (`__fern_strcmp`) at the rate a linear symbol table hits it.
function build(n: i32): string[] {
  var out: string[] = [];
  var i: i32 = 0;
  while (i < n) {
    out = out.append("checker__lookup_symbol_" + i.to_string());
    i = i + 1;
  }
  return out;
}

function find(names: string[], needle: string): i32 {
  var i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == needle) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function main(): i32 {
  var names: string[] = build(400);
  var hits: i64 = 0i64;
  var r: i32 = 0;
  while (r < 400) {
    var k: i32 = 0;
    while (k < 20) {
      hits = hits + find(names, "checker__lookup_symbol_" + (k * 19).to_string()) as i64;
      k = k + 1;
    }
    r = r + 1;
  }
  return (hits % 97i64) as i32;
}
