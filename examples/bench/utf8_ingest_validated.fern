// Ingest path WITH the UTF-8 validation the `string` invariant requires:
// bytes -> utf8.from_bytes (validating) -> json_parse.
import "std/json";
import "std/utf8" as utf8;
import "std/string";

function body_bytes(): u8[] {
    var one: string = "{\"id\":1042,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\",\"tags\":[\"engineer\",\"analyst\",\"pioneer\"],\"active\":true,\"score\":99.5,\"note\":\"café — naïve résumé, 中文, 𝄞\"}";
    var out: string = "";
    var i: i32 = 0;
    while (i < 24) { out = out + one; i = i + 1; }
    return out.bytes();
}

function main(): i32 {
    var b: u8[] = body_bytes();
    var acc: i32 = 0;
    var round: i32 = 0;
    while (round < 200) {
        match (utf8.from_bytes(b)) {
            Some(s) => {
                match (json.json_parse(s)) {
                    Some(_) => { acc = acc + 1; },
                    None => { acc = acc + 2; }
                }
            },
            None => { acc = acc + 4; }
        }
        round = round + 1;
    }
    if (acc == 0) { return 1; }
    return 0;
}
