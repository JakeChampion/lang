// tokenize — a lexer-shaped scan over an embedded source string: byte
// classification, identifier slicing and keyword comparison. This is the
// closest proxy in the corpus for the self-hosted compiler's own hot path,
// where __fern_strcmp was measured at 20.5% of runtime.
function is_ident_byte(c: u8): boolean {
  if (c >= 97 as u8 && c <= 122 as u8) {
    return true;
  }
  if (c >= 65 as u8 && c <= 90 as u8) {
    return true;
  }
  if (c >= 48 as u8 && c <= 57 as u8) {
    return true;
  }
  return c == 95 as u8;
}

function scan(src: string): i32 {
  var kw: i32 = 0;
  var i: i32 = 0;
  var n: i32 = src.len();
  while (i < n) {
    if (!is_ident_byte(src[i])) {
      i = i + 1;
      continue;
    }
    var start: i32 = i;
    while (i < n && is_ident_byte(src[i])) {
      i = i + 1;
    }
    var word: str = src[start:i];
    // Keyword comparison — the strcmp-bound half.
    if (word == "function" || word == "return" || word == "while" || word == "var" || word == "if" || word == "else") {
      kw = kw + 1;
    }
  }
  return kw;
}

function main(): i32 {
  var src: string = "function scan(src: string): i32 { var i: i32 = 0; while (i < n) { if (x) { return i; } else { i = i + 1; } } return 0; }";
  var total: i64 = 0i64;
  var r: i32 = 0;
  while (r < 10000) {
    total = total + scan(src) as i64;
    r = r + 1;
  }
  return (total % 97i64) as i32;
}
