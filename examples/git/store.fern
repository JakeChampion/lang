// The objects of a repository: the loose objects and the packfiles.
import "std/array";
import "core/cmp";
import "std/i64";
import "std/hex";
import "./midx";
import "./objects";
import "./pack";

// One packfile and its index `ix`. `data` is the packfile, which the store
// maps when it needs an object of it. A packfile larger than LARGE_PACK is
// not mapped: a read takes only the bytes of one object from the file,
// and `order` holds the offsets of the objects in their order. Each copy
// of a store shares the cache of the bases of the deltas: an update of a
// cache that two stores hold would copy it.
pub struct Packed { path: string, ix: pack.Index, data: string, loaded: boolean, cache: Cell[pack.Cache], order: i64[], reads: i32, file: Reader[], size: i64 }

// A packfile larger than this is never read whole.
const LARGE_PACK: i64 = 1073741824;

// `algo` is the hash of the names. `shallow` holds the commits whose
// parents a shallow clone does not have. With `listed`, `loose` holds the
// name of each loose object in order. `hot` is the packfile that had the
// last object, which is where the next search starts.
// `multi` holds the multi-pack index when the store has one, and `multi_packs`
// gives the place in `packs` of each packfile that it names, or -1.
// `trees` holds the trees that the store read last, with their entries.
// `held` holds the objects that a command makes and does not write. Each
// copy of a store shares them.
pub struct Store { objects: string, width: i32, packs: Packed[], shallow: string[], loose: string[], listed: boolean, hot: i32, multi: midx.Midx[], multi_packs: i32[], trees: Cell[Trees], held: Cell[Map[string, objects.Object]] }

// The last trees that a diff read: a walk of the history compares the tree
// of each commit with the tree of its parent, which the next commit of
// the walk compares again.
pub struct Trees { names: string[], lists: objects.RawTree[] }

const TREES_KEPT: i32 = 16;

// The entries of the tree `name` when the store read it last, or none.
pub function tree_seen(s: Store, name: string): Option[objects.RawTree] {
  let t = s.trees.get();
  for i in 0..t.names.len() {
    if (t.names[i] == name) {
      return Some(t.lists[i]);
    }
  }
  return None;
}

// Keeps the entries of the tree `name`.
pub function keep_tree(s: Store, name: string, list: objects.RawTree): void {
  let t = s.trees.get();
  s.trees.set(Trees { names: [], lists: [] });
  let names = t.names;
  let lists = t.lists;
  if (names.len() >= TREES_KEPT) {
    names = array.slice(names, 1, names.len());
    lists = array.slice(lists, 1, lists.len());
  }
  s.trees.set(Trees { names: names.append(name), lists: lists.append(list) });
}

function no_objects(): Map[string, objects.Object] {
  return Map { };
}

// Holds the object of the kind `kind` with the content `body` in memory,
// as the temporary object directory of git does, and gives its name. An
// object that the store has is not held.
pub function hold(s: Store, kind: string, body: u8[]): string {
  let name = objects.hash_of(s.width, kind, body);
  if (info(s, name).why.len() == 0) {
    return name;
  }
  let held = s.held.get();
  s.held.set(no_objects());
  s.held.set(held.insert(name, objects.Object { kind: kind, body: body }));
  return name;
}

// Drops the objects that the store holds in memory.
pub function release(s: Store): void {
  s.held.set(no_objects());
}

// The result of a read: the object, and the store with the packfile that
// the read loaded.
pub struct Found { store: Store, object: Result[objects.Object, string] }

// The store of the directory `objects`, with the index of each packfile,
// and the multi-pack index when `multi` is true.
pub function open(dir: string, a: i32, multi: boolean): Store {
  let shallow: string[] = [];
  if let Ok(text) = read_file(dir + "/../shallow") {
    shallow = text.split("\n").filter((line: string): boolean => line.len() == 2 * a);
  }
  let packs: Packed[] = [];
  let names = match (read_dir(dir + "/pack")) {
    Ok(ns) => ns,
    Err(_) => {
      return Store { objects: dir, width: a, packs: packs, shallow: shallow, loose: [], listed: false, hot: 0, multi: [], multi_packs: [], trees: cell_new(Trees { names: [], lists: [] }), held: cell_new(no_objects()) };
    },
  };
  for n in names {
    if (n.ends_with(".idx")) {
      let path = dir + "/pack/" + objects.part(n, 0, n.len() - 4) + ".pack";
      if let Ok(bytes) = read_file_bytes(dir + "/pack/" + n) {
        if let Ok(ix) = pack.index_of(bytes, a, path) {
          packs = packs.append(Packed { path: path, ix: ix, data: "", loaded: false, cache: cell_new(pack.cache_new()), order: [], reads: 0, file: [], size: 0 });
        }
      }
    }
  }
  let s = Store { objects: dir, width: a, packs: packs, shallow: shallow, loose: [], listed: false, hot: 0, multi: [], multi_packs: [], trees: cell_new(Trees { names: [], lists: [] }), held: cell_new(no_objects()) };
  if (!multi) {
    return s;
  }
  let Ok(bytes) = read_file_bytes(dir + "/pack/multi-pack-index") else {
    return s;
  };
  let Some(m) = midx.parse(bytes, a) else {
    return s;
  };
  let places: i32[] = [];
  for name in m.packs {
    let path = dir + "/pack/" + objects.part(name, 0, name.len() - 4) + ".pack";
    let place = -1;
    for i in 0..packs.len() {
      if (packs[i].path == path) {
        place = i;
      }
    }
    places = places.append(place);
  }
  return Store { ...s, multi: [m], multi_packs: places };
}

// The least length of a short name, as git sets it: half of the bits of
// the count of packed objects, and 7 or more.
pub function short_length(s: Store): i32 {
  let count = 0;
  for p in s.packs {
    count += p.ix.count;
  }
  let bits = 0;
  while (count > 0) {
    bits += 1;
    count /= 2;
  }
  return ((bits + 1) / 2).max(7);
}

// The parents of the commit `hash` with the content `body`. A commit at the
// edge of a shallow clone has none.
pub function parents(s: Store, hash: string, body: u8[]): string[] {
  if (at_edge(s, hash)) {
    return [];
  }
  return objects.header_values(body, "parent");
}

// True if the commit `hash` is at the edge of a shallow clone.
pub function at_edge(s: Store, hash: string): boolean {
  return s.shallow.contains(hash);
}

// The packfile `i` with its data.
function loaded(s: Store, i: i32): Store {
  if (s.packs[i].loaded) {
    return s;
  }
  let data = match (unsafe { map_file_unchecked(s.packs[i].path) }) {
    Ok(text) => text,
    Err(_) => "",
  };
  return Store { ...s, packs: s.packs.with(i, Packed { ...s.packs[i], data: data, loaded: true }) };
}

// The offsets of the objects of the packfile in their order. The reverse
// index of git (`.rev`, version 1) has that order. Without it, the offsets
// of the index are sorted.
function offsets_in_order(p: Packed): i64[] {
  let n = p.ix.count;
  let offsets: i64[] = [];
  let rev_path = objects.part(p.path, 0, p.path.len() - 5) + ".rev";
  if let Ok(rev) = read_file_bytes(rev_path) {
    if (rev.len() == 12 + 4 * n + 2 * p.ix.width && rev[0] == b'R' && rev[1] == b'I' && rev[2] == b'D' && rev[3] == b'X' && rev[7] == 1) {
      let last: i64 = -1;
      let ok = true;
      for k in 0..n {
        let at = 12 + 4 * k;
        let i = rev[at] as i32 << 24 | rev[at + 1] as i32 << 16 | rev[at + 2] as i32 << 8 | rev[at + 3] as i32;
        let offset = if (i >= 0 && i < n) { pack.offset_at(p.ix, i) } else { -1 };
        ok = ok && offset > last;
        last = offset;
        offsets = offsets.append(offset);
      }
      if (ok) {
        return offsets;
      }
    }
  }
  offsets = [];
  for k in 0..n {
    offsets = offsets.append(pack.offset_at(p.ix, k));
  }
  return cmp.sort(offsets);
}

// The packfile `i` ready for a read: with its data, or with the order of
// its offsets for a read of one object.
function ready(s: Store, i: i32): Store {
  let p = s.packs[i];
  if (p.loaded) {
    return s;
  }
  if (p.order.len() > 0) {
    return s;
  }
  let file: Reader[] = [];
  let size: i64 = 0;
  if let Ok(r) = open_reader(p.path) {
    if let Ok(end) = r.seek(0, 2) {
      size = end;
    }
    file = [r];
  }
  if (size <= LARGE_PACK) {
    for r in file {
      r.close();
    }
    return loaded(s, i);
  }
  return Store { ...s, packs: s.packs.with(i, Packed { ...p, order: offsets_in_order(p), file: file, size: size }) };
}

// The bytes of the object at the offset `from` of the open packfile, `most`
// bytes at most. They end where the next object of `order` starts, or at
// the end of the file.
// The bytes of the open packfile from `from`, `want` bytes at most.
function read_at(file: Reader[], from: i64, want: i32, width: i32): pack.Window {
  let bytes: u8[] = [];
  if (file.len() == 0) {
    return pack.Window { bytes: "", shift: from, width: width };
  }
  let r = file[0];
  if let Ok(_) = r.seek(from, 0) {
    let more = true;
    while (more && bytes.len() < want) {
      let n = (want - bytes.len()).min(1048576);
      match (r.read_chunk_bytes(n)) {
        Ok(chunk) => {
          more = chunk.len() > 0;
          bytes = bytes.concat(chunk);
        },
        Err(_) => {
          more = false;
        }
      }
    }
  }
  return pack.Window { bytes: pack.text_of(bytes), shift: from, width: width };
}

// The bytes of the object at the offset `from` of the open packfile, `most`
// bytes at most. They end where the next object of `order` starts, or at
// the end of the file. A read of a whole object takes no more than its
// header and the largest zlib stream of its size, so a gap in a sparse
// packfile is not read.
function part_at(file: Reader[], order: i64[], from: i64, most: i32, raw: i32): pack.Window {
  let lo = 0;
  let hi = order.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    if (order[mid] <= from) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  let limit = (if (lo < order.len()) { order[lo] - from } else { 2147483647 }).min(most as i64);
  if (most == pack.WHOLE && limit > pack.HEAD_BYTES as i64) {
    let head = read_at(file, from, pack.LINK_BYTES, raw);
    let e = pack.entry_in(head, from);
    if (e.ok) {
      let n = e.size as i64;
      limit = limit.min(e.data_at - from + n + (n >> 12) + (n >> 14) + (n >> 25) + 13);
    }
  }
  return read_at(file, from, limit as i32, raw);
}

// The packfile that has the name `raw` and the offset of the object in it,
// or -1 for each. The multi-pack index comes first, as in git.
function located(s: Store, raw: u8[]): (i32, i64) {
  for m in s.multi {
    let (id, offset) = midx.locate(m, raw);
    if (id >= 0 && s.multi_packs[id] >= 0) {
      return (s.multi_packs[id], offset);
    }
  }
  if (s.hot < s.packs.len()) {
    let at = pack.find(s.packs[s.hot].ix, raw);
    if (at >= 0) {
      return (s.hot, pack.offset_at(s.packs[s.hot].ix, at));
    }
  }
  for i in 0..s.packs.len() {
    if (i != s.hot) {
      let at = pack.find(s.packs[i].ix, raw);
      if (at >= 0) {
        return (i, pack.offset_at(s.packs[i].ix, at));
      }
    }
  }
  return (-1, -1);
}

// The source of the objects of the packfile `p`.
function source_of(p: Packed): pack.Source {
  let ix = p.ix;
  let data = p.data;
  let file = p.file;
  let order = p.order;
  let base = (name: u8[]): i64 => pack.offset_of(ix, name);
  if (p.loaded) {
    return pack.memory(data, base, ix.width);
  }
  return pack.Source { part: (from: i64, most: i32): pack.Window => part_at(file, order, from, most, ix.width), base: base };
}

// The packfile that has the object `name` ready for a read, its place in
// the store, and the offset of the object, or -1 for each.
function packed_at(s: Store, name: string): (Store, i32, i64) {
  let Some(raw) = objects.raw_name(name) else {
    return (s, -1, -1);
  };
  let (i, offset) = located(s, raw);
  if (i < 0) {
    return (s, -1, -1);
  }
  return (Store { ...ready(s, i), hot: i }, i, offset);
}

// The object `name`: the object of a packfile that has the name, or
// the loose object. The error is "missing" when no place has it.
pub function read(s: Store, name: string): Found {
  if let Some(o) = s.held.get().get(name) {
    return Found { store: s, object: Ok(o) };
  }
  let (now, i, offset) = packed_at(s, name);
  if (i < 0) {
    return Found { store: now, object: objects.read_loose(now.objects, name) };
  }
  let p = now.packs[i];
  if (offset < 0) {
    return Found { store: now, object: Err("the index of the packfile of " + name + " has a bad offset") };
  }
  // The cell gives the cache away during the read, so that the read
  // holds the only reference to it.
  let cache = p.cache.get();
  p.cache.set(pack.cache_new());
  let (object, kept) = pack.object_cached(source_of(p), offset, cache);
  p.cache.set(kept);
  return Found { store: Store { ...now, packs: now.packs.with(i, Packed { ...p, reads: p.reads + 1 }) }, object: object };
}

// The kind and the size of an object, and the store after the read. `why`
// is the error, and it is empty for an object that the store has.
pub struct Info { store: Store, kind: string, size: i64, why: string }

// The kind and the size of the object `name`. A packed object is not
// inflated for them.
pub function info(s: Store, name: string): Info {
  if let Some(o) = s.held.get().get(name) {
    return Info { store: s, kind: o.kind, size: o.body.len() as i64, why: "" };
  }
  let (now, i, offset) = packed_at(s, name);
  if (i < 0) {
    return match (objects.loose_info(now.objects, name)) {
      Ok((kind, size)) => Info { store: now, kind: kind, size: size, why: "" },
      Err(why) => Info { store: now, kind: "", size: 0, why: why },
    };
  }
  if (offset < 0) {
    return Info { store: now, kind: "", size: 0, why: "the index of the packfile of " + name + " has a bad offset" };
  }
  return match (pack.info_in(source_of(now.packs[i]), offset)) {
    Ok((kind, size)) => Info { store: now, kind: kind, size: size, why: "" },
    Err(why) => Info { store: now, kind: "", size: 0, why: why },
  };
}

// The loose objects whose name starts with `short`.
function loose_with_prefix(s: Store, short: string, limit: i32): string[] {
  let found: string[] = [];
  if (s.listed) {
    let lo = 0;
    let hi = s.loose.len();
    while (lo < hi) {
      let mid = lo + (hi - lo) / 2;
      if (s.loose[mid].cmp(short) < 0) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    while (lo < s.loose.len() && found.len() < limit && s.loose[lo].starts_with(short)) {
      found = found.append(s.loose[lo]);
      lo += 1;
    }
    return found;
  }
  let names = match (read_dir(s.objects + "/" + objects.part(short, 0, 2))) {
    Ok(ns) => ns,
    Err(_) => {
      return found;
    },
  };
  let rest = objects.part(short, 2, short.len());
  for n in names {
    if (n.len() == 2 * s.width - 2 && n.starts_with(rest)) {
      found = found.append(objects.part(short, 0, 2) + n);
    }
  }
  return found;
}

// The store with the name of each loose object. A caller that asks for
// many short names lists the loose objects one time.
pub function listed(s: Store): Store {
  let names: string[] = [];
  let digits = "0123456789abcdef";
  for a in 0..16 {
    for b in 0..16 {
      let dir = objects.part(digits, a, a + 1) + objects.part(digits, b, b + 1);
      if let Ok(found) = read_dir(s.objects + "/" + dir) {
        for n in found {
          if (n.len() == 2 * s.width - 2) {
            names = names.append(dir + n);
          }
        }
      }
    }
  }
  return Store { ...s, loose: cmp.sort(names), listed: true };
}

// The names that start with the hexadecimal digits `short`, one time each,
// `limit` names at most.
function names_with_prefix(s: Store, short: string, limit: i32): string[] {
  let found = loose_with_prefix(s, short, limit);
  for e in s.held.get().entries() {
    let (name, _) = e;
    if (name.starts_with(short) && !found.contains(name)) {
      found = found.append(name);
    }
  }
  for p in s.packs {
    for name in pack.with_prefix(p.ix, short, limit) {
      if (!found.contains(name)) {
        found = found.append(name);
      }
    }
  }
  return found;
}

// The names that start with the hexadecimal digits `short`. The search
// stops after two names: the caller needs to know one from many.
pub function with_prefix(s: Store, short: string): string[] {
  return names_with_prefix(s, short, 2);
}

// Each name that starts with the hexadecimal digits `short`.
pub function all_with_prefix(s: Store, short: string): string[] {
  return names_with_prefix(s, short, 2147483647);
}
