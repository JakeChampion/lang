// The objects of a repository: the loose objects and the packfiles.
import "std/array";
import "core/cmp";
import "std/hex";
import "./objects";
import "./pack";

// One packfile. `idx` is its index. `data` is the packfile, which the store
// reads when it needs an object of it.
// One packfile. Until `loaded`, a read takes only the bytes of one object
// from the file: `order` holds the offsets of the objects in their order,
// and `reads` counts those reads.
pub struct Packed { path: string, idx: u8[], data: u8[], loaded: boolean, cache: pack.Cache, order: i32[], reads: i32, file: Reader[] }

// A packfile of this size or less is read whole.
const SMALL_PACK: i64 = 1048576;

// `shallow` holds the commits whose parents a shallow clone does not have.
// With `listed`, `loose` holds the name of each loose object in order.
pub struct Store { objects: string, packs: Packed[], shallow: string[], loose: string[], listed: boolean }

// The result of a read: the object, and the store with the packfile that
// the read loaded.
pub struct Found { store: Store, object: Result[objects.Object, string] }

// The store of the directory `objects`, with the index of each packfile.
pub function open(dir: string): Store {
  let shallow: string[] = [];
  if let Ok(text) = read_file(dir + "/../shallow") {
    shallow = text.split("\n").filter((line: string): boolean => line.len() == 40);
  }
  let packs: Packed[] = [];
  let names = match (read_dir(dir + "/pack")) {
    Ok(ns) => ns,
    Err(_) => {
      return Store { objects: dir, packs: packs, shallow: shallow, loose: [], listed: false };
    },
  };
  for n in names {
    if (n.ends_with(".idx")) {
      let path = dir + "/pack/" + objects.part(n, 0, n.len() - 4) + ".pack";
      if let Ok(idx) = read_file_bytes(dir + "/pack/" + n) {
        if (pack.index_ok(idx)) {
          packs = packs.append(Packed { path: path, idx: idx, data: [], loaded: false, cache: pack.cache_new(), order: [], reads: 0, file: [] });
        }
      }
    }
  }
  return Store { objects: dir, packs: packs, shallow: shallow, loose: [], listed: false };
}

// The least length of a short name, as git sets it: half of the bits of
// the count of packed objects, and 7 or more.
pub function short_length(s: Store): i32 {
  let count = 0;
  for p in s.packs {
    count += pack.count(p.idx);
  }
  let bits = 0;
  while (count > 0) {
    bits += 1;
    count /= 2;
  }
  return ((bits + 1) / 2).max(7);
}

// The parents of the commit `hash` with the content `body`. A commit at the
// edge of a shallow clone has none.
pub function parents(s: Store, hash: string, body: u8[]): string[] {
  if (s.shallow.contains(hash)) {
    return [];
  }
  return objects.header_values(body, "parent");
}

// The packfile `i` with its data.
function loaded(s: Store, i: i32): Store {
  if (s.packs[i].loaded) {
    return s;
  }
  let data = match (read_file_bytes(s.packs[i].path)) {
    Ok(bytes) => bytes,
    Err(_) => [],
  };
  return Store { ...s, packs: s.packs.with(i, Packed { ...s.packs[i], data: data, loaded: true }) };
}

// The packfile `i` ready for a read: with its data, or with the order of
// its offsets for a read of one object.
function ready(s: Store, i: i32): Store {
  let p = s.packs[i];
  if (p.loaded) {
    return s;
  }
  if (p.order.len() > 0) {
    // After reads of one object for half of its objects, the whole file
    // is less work than more reads.
    return if (p.reads * 2 >= p.order.len()) { loaded(s, i) } else { s };
  }
  let offsets: i32[] = [];
  for k in 0..pack.count(p.idx) {
    offsets = offsets.append(pack.offset_at(p.idx, k));
  }
  let file: Reader[] = [];
  let size: i64 = 0;
  if let Ok(r) = open_reader(p.path) {
    if let Ok(end) = r.seek(0, 2) {
      size = end;
    }
    file = [r];
  }
  if (size <= SMALL_PACK) {
    for r in file {
      r.close();
    }
    return loaded(s, i);
  }
  return Store { ...s, packs: s.packs.with(i, Packed { ...p, order: cmp.sort(offsets), file: file }) };
}

// The bytes of the object at the offset `from` of the open packfile. They
// end where the next object of `order` starts, or at the end of the file.
function part_at(file: Reader[], order: i32[], from: i32): pack.Window {
  let lo = 0;
  let hi = order.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    if (order[mid] <= from) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  let want = if (lo < order.len()) { order[lo] - from } else { 2147483647 - from };
  let bytes: u8[] = [];
  if (file.len() == 0) {
    return pack.Window { bytes: bytes, shift: from };
  }
  let r = file[0];
  if let Ok(_) = r.seek(from as i64, 0) {
    let more = true;
    while (more && bytes.len() < want) {
      let n = (want - bytes.len()).min(1048576);
      match (r.read_chunk_bytes(n)) {
        Ok(chunk) => {
          more = chunk.len() > 0;
          bytes = bytes.concat(chunk);
        },
        Err(_) => {
          more = false;
        }
      }
    }
  }
  return pack.Window { bytes: bytes, shift: from };
}

// The object `name`: the object of the first packfile that has the name, or
// the loose object. The error is "missing" when no place has it.
pub function read(s: Store, name: string): Found {
  if let Ok(raw) = hex.decode(name) {
    for i in 0..s.packs.len() {
      let at = pack.find(s.packs[i].idx, raw);
      if (at >= 0) {
        s = ready(s, i);
        let p = s.packs[i];
        let offset = pack.offset_at(p.idx, at);
        if (offset < 0) {
          return Found { store: s, object: Err("the packfile of " + name + " is larger than this port reads") };
        }
        let idx = p.idx;
        let data = p.data;
        let file = p.file;
        let order = p.order;
        let part = if (p.loaded) { (from: i32): pack.Window => pack.Window { bytes: data, shift: 0 } } else { (from: i32): pack.Window => part_at(file, order, from) };
        let (object, cache) = pack.object_cached(part, (base: u8[]): i32 => pack.offset_of(idx, base), offset, p.cache);
        return Found { store: Store { ...s, packs: s.packs.with(i, Packed { ...p, cache: cache, reads: p.reads + 1 }) }, object: object };
      }
    }
  }
  return Found { store: s, object: objects.read_loose(s.objects, name) };
}

// The loose objects whose name starts with `short`.
function loose_with_prefix(s: Store, short: string): string[] {
  let found: string[] = [];
  if (s.listed) {
    let lo = 0;
    let hi = s.loose.len();
    while (lo < hi) {
      let mid = lo + (hi - lo) / 2;
      if (s.loose[mid].cmp(short) < 0) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    while (lo < s.loose.len() && found.len() < 2 && s.loose[lo].starts_with(short)) {
      found = found.append(s.loose[lo]);
      lo += 1;
    }
    return found;
  }
  let names = match (read_dir(s.objects + "/" + objects.part(short, 0, 2))) {
    Ok(ns) => ns,
    Err(_) => {
      return found;
    },
  };
  let rest = objects.part(short, 2, short.len());
  for n in names {
    if (n.len() == 38 && n.starts_with(rest)) {
      found = found.append(objects.part(short, 0, 2) + n);
    }
  }
  return found;
}

// The store with the name of each loose object. A caller that asks for
// many short names lists the loose objects one time.
pub function listed(s: Store): Store {
  let names: string[] = [];
  let digits = "0123456789abcdef";
  for a in 0..16 {
    for b in 0..16 {
      let dir = objects.part(digits, a, a + 1) + objects.part(digits, b, b + 1);
      if let Ok(found) = read_dir(s.objects + "/" + dir) {
        for n in found {
          if (n.len() == 38) {
            names = names.append(dir + n);
          }
        }
      }
    }
  }
  return Store { ...s, loose: cmp.sort(names), listed: true };
}

// The names that start with the hexadecimal digits `short`, one time each.
// The search stops after two names: the caller needs to know one from many.
pub function with_prefix(s: Store, short: string): string[] {
  let found = loose_with_prefix(s, short);
  for p in s.packs {
    for name in pack.with_prefix(p.idx, short, 2) {
      if (!found.contains(name)) {
        found = found.append(name);
      }
    }
  }
  return found;
}
