// The diff of a commit as `git log` prints it (diff.c of git): the patch
// of each pair of files, and `--stat`, `--numstat`, `--shortstat` and
// `--summary`. The hunks come from the xdiff engine of std/linediff.
import "std/array";
import "std/linediff";
import "core/map";
import "./attr";
import "./color";
import "./moved";
import "./objects";
import "./store";
import "./treediff";
import "./userdiff";
import "./width";
import "./ws";
import "../../coreutils/lib/bre";

// The forms of the output and their options. `stat_width` is -1 for the
// width of the terminal. `stat_name_width`, `stat_graph_width` and
// `stat_count` are 0 for no limit. `src` and `dst` are the prefixes of
// the two paths. `color` gives the output the colors of git. `raw` is the
// form of `--raw`. `abbrev` is the length of a short name that `--abbrev`
// sets: -1 for the length of git, and 0 for full names. `ws_rule` holds
// the rules of white space of `core.whitespace`. `word_diff` is a form of
// `--word-diff`, and `word_regex` holds the regex of its words, or none.
// `word_regex_error` is a regex of words that is not sound, or "".
// `color_moved` and `color_moved_ws` are the form and the modes of
// `--color-moved` and `--color-moved-ws`. `attrs` holds the
// attributes of the worktree, or none. `drivers` holds the drivers of the
// attribute `diff`.
// `pal` holds the colors of `color.diff.SLOT`. `line_ranges` holds the
// ranges of lines of `-L` of each path of the new side: the patch of such
// a path shows only the lines in its ranges.
pub struct Opts { line_ranges: Map[string, i32[]], pal: color.Palette, attrs: attr.Attrs[], drivers: userdiff.Drivers, color_moved: i32, color_moved_ws: i32, word_diff: i32, word_regex: bre.Bre[], word_regex_error: string, ws_rule: i32, abbrev: i32, raw: boolean, patch: boolean, stat: boolean, numstat: boolean, shortstat: boolean, summary: boolean, context: i32, interhunk: i32, src: string, dst: string, algo: linediff.Options, full_index: boolean, text: boolean, stat_width: i32, stat_name_width: i32, stat_graph_width: i32, stat_count: i32, color: boolean }

pub function defaults(): Opts {
  return Opts { line_ranges: Map { }, pal: color.palette_default(), attrs: [], drivers: userdiff.none(), color_moved: moved.NO, color_moved_ws: 0, word_diff: WORDS_NONE, word_regex: [], word_regex_error: "", ws_rule: ws.DEFAULT_RULE, abbrev: -1, raw: false, patch: false, stat: false, numstat: false, shortstat: false, summary: false, context: 3, interhunk: 0, src: "a/", dst: "b/", algo: linediff.defaults(), full_index: false, text: false, stat_width: -1, stat_name_width: 0, stat_graph_width: 0, stat_count: 0, color: false };
}

// True when the options print a diff.
pub function any(o: Opts): boolean {
  return o.raw || o.patch || o.stat || o.numstat || o.shortstat || o.summary;
}

// The text of a diff, in parts. The graph line of the call `uses[i]` goes
// before the part `i`, or no graph line for -1, and a line end goes after
// it when `ends[i]` is true. `calls` is the count of graph lines that the
// diff asks for, as git asks for one with each `diff_line_prefix`.
// `fatal` is the message of an error that stops the diff, or "".
// `moved` holds the added and the removed lines for `--color-moved`.
pub struct Text { lines: string[], uses: i32[], ends: boolean[], calls: i32, fatal: string, moved: Moved }

// The added and the removed lines of a patch: the part of each in the
// text, its kind (`moved.PLUS` or `moved.MINUS`), its content after the
// sign, the rules of white space of its file, and whether it is a blank
// line at the end of a file.
pub struct Moved { at: i32[], kinds: i32[], texts: string[], rules: i32[], eof: boolean[] }

pub function text_new(): Text {
  return Text { lines: [], uses: [], ends: [], calls: 0, fatal: "", moved: Moved { at: [], kinds: [], texts: [], rules: [], eof: [] } };
}

pub function call(t: Text): (Text, i32) {
  return (Text { ...t, calls: t.calls + 1 }, t.calls);
}

// Adds the part `line` after the graph line of the call `at_call`, or -1,
// with a line end when `end` is true.
pub function push(t: Text, at_call: i32, line: string, end: boolean): Text {
  return Text { ...t, lines: t.lines.append(line), uses: t.uses.append(at_call), ends: t.ends.append(end) };
}

// Adds each line of `text` with the graph line of the call `at_call`.
pub function add(t_in: Text, at_call: i32, text: string): Text {
  let t = t_in;
  let at = 0;
  while (at < text.len()) {
    let nl = __memchr_bytes(text.bytes(), 10, at);
    let end = if (nl < 0) { text.len() } else { nl };
    t = push(t, at_call, objects.part(text, at, end), true);
    at = end + 1;
  }
  return t;
}

// Adds each line of `text`, each with a call of its own.
pub function add_each(t_in: Text, text: string): Text {
  let t = t_in;
  let at = 0;
  while (at < text.len()) {
    let nl = __memchr_bytes(text.bytes(), 10, at);
    let end = if (nl < 0) { text.len() } else { nl };
    let (t1, at_call) = call(t);
    t = push(t1, at_call, objects.part(text, at, end), true);
    at = end + 1;
  }
  return t;
}

// Adds `text` as it is, without graph lines: a part for each line, and
// a last part with no line end when `text` does not end with one.
pub function add_raw(t_in: Text, text: string): Text {
  let t = t_in;
  let at = 0;
  while (at < text.len()) {
    let nl = __memchr_bytes(text.bytes(), 10, at);
    if (nl < 0) {
      return push(t, -1, objects.part(text, at, text.len()), false);
    }
    t = push(t, -1, objects.part(text, at, nl), true);
    at = nl + 1;
  }
  return t;
}

// One side of a pair: no side when `valid` is false.
struct Side { valid: boolean, path: u8[], mode: string, hash: string }

// A pair of files, as `diff_filepair` of git: the change, the old side
// and the new side.
struct Pair { status: u8, score: i32, one: Side, two: Side }

function pair_of(c: treediff.Change): Pair {
  let none = Side { valid: false, path: c.path, mode: "", hash: c.old_hash };
  let old_side = Side { valid: true, path: c.old_path, mode: c.old_mode, hash: c.old_hash };
  let new_side = Side { valid: true, path: c.path, mode: c.new_mode, hash: c.new_hash };
  if (c.status == b'A') {
    return Pair { status: c.status, score: 0, one: Side { ...none, hash: c.old_hash }, two: new_side };
  }
  if (c.status == b'D') {
    return Pair { status: c.status, score: 0, one: old_side, two: Side { ...none, hash: c.new_hash } };
  }
  return Pair { status: c.status, score: c.score, one: old_side, two: new_side };
}

pub function mode6(mode: string): string {
  return mode.pad_start_str(6, "0");
}

function text(b: u8[]): string {
  return unsafe { string_from_bytes_unchecked(b) };
}

function quoted(path: u8[]): string {
  return text(objects.quoted(path));
}

// The prefix and the path as one name, in quotes when one of them needs
// them: `quote_two` of git.
pub function quote_two(prefix: string, path: u8[]): string {
  let joined = prefix.bytes().concat(path);
  if (objects.plain_name(joined)) {
    return text(joined);
  }
  let q = objects.quoted(joined);
  return text(q);
}

// The content of a side, and the store after the read.
function content(s: store.Store, side: Side): (store.Store, u8[]) {
  if (!side.valid) {
    return (s, []);
  }
  if (side.mode == "160000") {
    return (s, ("Subproject commit " + side.hash + "\n").bytes());
  }
  let got = store.read(s, side.hash);
  return match (got.object) {
    Ok(o) => (got.store, o.body),
    Err(_) => (got.store, []),
  };
}

// The content of the blob `hash` of the mode `mode`, or none for an empty
// mode.
pub function blob(s: store.Store, mode: string, hash: string): (store.Store, u8[]) {
  return content(s, Side { valid: mode.len() > 0, path: [], mode: mode, hash: hash });
}

// True when the content is binary for git: a NUL in its first 8000 bytes.
pub function is_binary(data: u8[]): boolean {
  let n = data.len().min(8000);
  for i in 0..n {
    if (data[i] == 0) {
      return true;
    }
  }
  return false;
}

function is_regular(mode: string): boolean {
  return mode == "100644" || mode == "100755";
}

function kind_of(mode: string): i32 {
  if (mode == "120000") {
    return 1;
  }
  if (mode == "160000") {
    return 2;
  }
  return 0;
}

// The short name of `hash` for the index line. A name of zeros has the
// length that no object shares.
pub function abbrev_of(s: store.Store, hash: string, least: i32, full: boolean): string {
  if (full) {
    return hash;
  }
  if (hash == "0".repeat(hash.len())) {
    let n = least;
    while (n < hash.len() && store.with_prefix(s, objects.part(hash, 0, n)).len() > 0) {
      n += 1;
    }
    return objects.part(hash, 0, n);
  }
  let n = least;
  while (n < hash.len() && store.with_prefix(s, objects.part(hash, 0, n)).len() > 1) {
    n += 1;
  }
  return objects.part(hash, 0, n);
}

// The finder of the function lines of a pair with the paths `one` and
// `two`, or None for the default rule of git. The driver of the old path
// comes first, as in `builtin_diff`.
function finder_of(o: Opts, one: string, two: string): Option[userdiff.Finder] {
  let f = match (o.drivers.for_hunks(o.attrs, one)) {
    Some(f) => f,
    None => match (o.drivers.for_hunks(o.attrs, two)) {
      Some(f) => f,
      None => {
        return None;
      },
    },
  };
  return Some(userdiff.finder_of(f));
}

// The lines of the change in one pair, after its header: the hunks, or
// the line for a binary file. Each line ends with a line end. With ranges
// of `-L` for the path `two`, the hunks have the lines of the ranges. The
// text is the message of git when the regex of a driver is not sound.
function hunks(o: Opts, a: u8[], b: u8[], one: u8[], two: u8[]): (u8[], string) {
  let find: Option[(u8[], i32, i32) => (i32, i32)] = None;
  if let Some(finder) = finder_of(o, text(one), text(two)) {
    if (finder.died.len() > 0) {
      return ([], finder.died);
    }
    // The buffer of xdiff for a function line has 80 bytes.
    find = Some((data: u8[], s: i32, e: i32): (i32, i32) => finder.find(data, s, e, 80));
  }
  if let Some(ranges) = o.line_ranges.get(unsafe { string_from_bytes_unchecked(two) }) {
    return (in_ranges(o, a, b, ranges, find), "");
  }
  let ab = a;
  let bb = b;
  if (o.context == 0) {
    let t = linediff.common_tail(a, b);
    ab = array.slice(a, 0, a.len() - t);
    bb = array.slice(b, 0, b.len() - t);
  }
  let la = linediff.lines_of(ab);
  let lb = linediff.lines_of(bb);
  let script = linediff.diff(la, lb, o.algo);
  let out = buf_new(4096);
  linediff.unified(out, la, lb, script, linediff.Emit { context: o.context, interhunk: o.interhunk, funcnames: true, find_func: find });
  return (taken(out), "");
}

// ---- The hunks in the ranges of `-L` (`line_range_callback` of git) ----

// The function line of the old side at or above the line `start`, down to
// the line after `limit`, as xdiff finds it for a hunk header: the name
// that `find` gives, or, with no `find`, the first 80 bytes of a line that
// starts with a letter, `_` or `$`, with no white space at their end. The
// third value is false when there is none.
function func_above(a: linediff.Lines, start: i32, limit: i32, find: Option[(u8[], i32, i32) => (i32, i32)]): (i32, i32, boolean) {
  let l = start;
  while (l != limit && 0 <= l && l < a.count()) {
    let s = a.starts[l];
    let len = a.starts[l + 1] - s;
    match (find) {
      Some(f) => {
        let span = f(a.data, s, s + len);
        if (span.0 >= 0) {
          return (span.0, span.1, true);
        }
      },
      None => {
        if (len > 0) {
          let c = a.data[s];
          if (c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c == b'_' || c == b'$') {
            let n = len.min(80);
            while (n > 0 && objects.is_space(a.data[s + n - 1])) {
              n -= 1;
            }
            return (s, s + n, true);
          }
        }
      }
    }
    l -= 1;
  }
  return (0, 0, false);
}

// The numbers of a hunk header `@@ -A,B +C,D @@`: A, B, C and D, with 1
// for a count that the header leaves out.
function hunk_numbers(line: string): (i32, i32, i32, i32) {
  let parts = line.split(" ");
  let side = (text: string): (i32, i32) => {
    let at = text.index_of(",").unwrap_or(text.len());
    let start = digits_of(objects.part(text, 1, at));
    let count = if (at < text.len()) { digits_of(objects.part(text, at + 1, text.len())) } else { 1 };
    return (start, count);
  };
  let (a, b) = side(parts[1]);
  let (c, d) = side(parts[2]);
  return (a, b, c, d);
}

function digits_of(text: string): i32 {
  let n = 0;
  for i in 0..text.len() {
    n = n * 10 + (text[i] - b'0') as i32;
  }
  return n;
}

// The state of the filter of the lines of xdiff for the ranges of `-L`:
// the range now, the next line of each side, the function line of the
// hunk of xdiff, the hunk of the range that grows, and the removed lines
// that wait for the next line to tell whether they are in a range.
struct RangeHunk { cur: i32, post: i32, pre: i32, func: u8[], active: boolean, changes: boolean, old_begin: i32, old_count: i32, new_begin: i32, new_count: i32, lines: u8[], pending: u8[], pending_count: i32, pending_begin: i32 }

// Writes the hunk of the range with its header, unless it has only lines
// of context (`flush_rhunk`).
function flush_range(out: usize, h_in: RangeHunk): RangeHunk {
  let h = h_in;
  if (!h.active) {
    return h;
  }
  if (h.pending_count > 0) {
    h = RangeHunk { ...h, lines: h.lines.concat(h.pending), old_count: h.old_count + h.pending_count, changes: true, pending: [], pending_count: 0 };
  }
  if (h.changes) {
    buf_push(out, "@@ -" + h.old_begin.to_string() + "," + h.old_count.to_string() + " +" + h.new_begin.to_string() + "," + h.new_count.to_string() + " @@");
    if (h.func.len() > 0) {
      buf_push_byte(out, b' ' as i32);
      buf_push_bytes_range(out, h.func, 0, h.func.len());
    }
    buf_push_byte(out, b'\n' as i32);
    buf_push_bytes_range(out, h.lines, 0, h.lines.len());
  }
  return RangeHunk { ...h, active: false, lines: [] };
}

// The patch of `a` to `b` with only the lines in the ranges `ranges` of
// the new side: the hunks of xdiff with enough context for each range,
// cut at the ends of the ranges, each with a header of its own. A hunk
// of a range with no change does not show.
// fern-lint: allow cyclomatic-complexity
pub function in_ranges(o: Opts, a: u8[], b: u8[], ranges: i32[], find: Option[(u8[], i32, i32) => (i32, i32)]): u8[] {
  let span = 0;
  let k = 0;
  while (k < ranges.len()) {
    span = span.max(ranges[k + 1] - ranges[k]);
    k += 2;
  }
  let la = linediff.lines_of(a);
  let lb = linediff.lines_of(b);
  let script = linediff.diff(la, lb, o.algo);
  let full = buf_new(4096);
  linediff.unified(full, la, lb, script, linediff.Emit { context: o.context.max(span), interhunk: o.interhunk, funcnames: false, find_func: None });
  let text = taken(full);
  let out = buf_new(4096);
  let h = RangeHunk { cur: 0, post: 0, pre: 0, func: [], active: false, changes: false, old_begin: 0, old_count: 0, new_begin: 0, new_count: 0, lines: [], pending: [], pending_count: 0, pending_begin: 0 };
  let funclineprev = -1;
  let at = 0;
  while (at < text.len()) {
    let nl = __memchr_bytes(text, 10, at);
    let next = if (nl < 0) { text.len() } else { nl + 1 };
    let line = array.slice(text, at, next);
    at = next;
    let first = line[0];
    if (first == b'@') {
      let (old_begin, old_count, new_begin, _) = hunk_numbers(unsafe { string_from_bytes_unchecked(line) });
      let s1 = if (old_count != 0) { old_begin - 1 } else { old_begin };
      let (fs, fe, found) = func_above(la, s1 - 1, funclineprev, find);
      funclineprev = s1 - 1;
      h = RangeHunk { ...h, post: new_begin, pre: old_begin, func: if (found) { array.slice(la.data, fs, fe) } else { h.func } };
      continue;
    }
    if (first == b'-') {
      if (h.pending_count == 0) {
        h = RangeHunk { ...h, pending_begin: h.pre };
      }
      h = RangeHunk { ...h, pre: h.pre + 1, pending: h.pending.concat(line), pending_count: h.pending_count + 1 };
      continue;
    }
    if (first == b'\\') {
      if (h.pending_count > 0) {
        h = RangeHunk { ...h, pending: h.pending.concat(line) };
      } else if (h.active) {
        h = RangeHunk { ...h, lines: h.lines.concat(line) };
      }
      continue;
    }
    let lno = h.post - 1;
    let cur_pre = h.pre;
    h = RangeHunk { ...h, post: h.post + 1, pre: if (first == b' ') { h.pre + 1 } else { h.pre } };
    while (h.cur < ranges.len() && lno >= ranges[h.cur + 1]) {
      h = flush_range(out, h);
      h = RangeHunk { ...h, pending: [], pending_count: 0, cur: h.cur + 2 };
    }
    if (h.cur >= ranges.len() || lno < ranges[h.cur]) {
      h = RangeHunk { ...h, pending: [], pending_count: 0 };
      continue;
    }
    if (!h.active) {
      h = RangeHunk { ...h, active: true, changes: false, new_begin: lno + 1, old_begin: if (h.pending_count > 0) { h.pending_begin } else { cur_pre }, old_count: 0, new_count: 0, lines: [] };
    }
    if (h.pending_count > 0) {
      h = RangeHunk { ...h, lines: h.lines.concat(h.pending), old_count: h.old_count + h.pending_count, changes: true, pending: [], pending_count: 0 };
    }
    h = RangeHunk { ...h, lines: h.lines.concat(line), new_count: h.new_count + 1, changes: h.changes || first == b'+', old_count: if (first == b'+') { h.old_count } else { h.old_count + 1 } };
  }
  flush_range(out, h);
  return taken(out);
}

// The bytes of the builder `out`, which is then free: a builder has no
// drop of its own.
function taken(out: usize): u8[] {
  let b = buf_take_bytes(out);
  buf_free(out);
  return b;
}

// ---- The colors of a patch ----

// The line `text` of the header, with its line end.
function meta_line(o: Opts, text: string): string {
  return if (o.color) { o.pal.get(color.META) + text + color.RESET + "\n" } else { text + "\n" };
}

// Each line of `lines`, which end with a line end, as a line of the
// header.
function meta_lines(o: Opts, lines: string): string {
  if (!o.color) {
    return lines;
  }
  let out = "";
  for line in lines.split("\n") {
    if (line.len() > 0) {
      out += meta_line(o, line);
    }
  }
  return out;
}

// The count of the blank lines at the end of `data`:
// `count_trailing_blank` of git.
function trailing_blank(data: u8[]): i32 {
  if (data.len() == 0) {
    return 0;
  }
  let at = data.len() - 1;
  if (data[at] == b'\n') {
    at -= 1;
  }
  let n = 0;
  while (0 < at) {
    let eol = at;
    while (eol >= 0 && data[eol] != b'\n') {
      eol -= 1;
    }
    if (!ws.blank(data, eol + 1, at + 1)) {
      break;
    }
    n += 1;
    at = eol - 1;
  }
  return n;
}

function line_count(data: u8[]): i32 {
  if (data.len() == 0) {
    return 0;
  }
  let n = 0;
  for b in data {
    if (b == b'\n') {
      n += 1;
    }
  }
  return if (data[data.len() - 1] == b'\n') { n } else { n + 1 };
}

// The first line of each side that is in the blank lines that the change
// adds at the end of the file, or 0 for each when it adds none:
// `check_blank_at_eof` of git.
function blank_at_eof(a: u8[], b: u8[]): (i32, i32) {
  let l1 = trailing_blank(a);
  let l2 = trailing_blank(b);
  if (l2 <= l1) {
    return (0, 0);
  }
  return (line_count(a) - l1 + 1, line_count(b) - l2 + 1);
}

// The line `first` and `text` in the color `set`, with a carriage return
// at the end after the color: `emit_line_0` of git.
function line0(set: string, first: string, text: string): string {
  if (text.len() > 0 && text[text.len() - 1] == b'\r') {
    return set + first + objects.part(text, 0, text.len() - 1) + color.RESET + "\r";
  }
  return set + first + text + color.RESET;
}

// The number after `sign` in a hunk header.
function hunk_start(line: string, sign: u8): i32 {
  let at = 0;
  while (at < line.len() && line[at] != sign) {
    at += 1;
  }
  let n = 0;
  at += 1;
  while (at < line.len() && line[at] >= b'0' && line[at] <= b'9') {
    n = n * 10 + (line[at] - b'0') as i32;
    at += 1;
  }
  return n;
}

// The hunk header `line` in its colors: `emit_hunk_header` of git.
function hunk_header(pal: color.Palette, line: string): string {
  let ep = 2;
  while (ep + 1 < line.len() && !(line[ep] == b'@' && line[ep + 1] == b'@')) {
    ep += 1;
  }
  ep += 2;
  let out = pal.get(color.FRAG) + objects.part(line, 0, ep.min(line.len())) + color.RESET;
  let cp = ep;
  while (ep < line.len() && (line[ep] == b' ' || line[ep] == b'\t')) {
    ep += 1;
  }
  if (ep > cp) {
    out += pal.get(color.CONTEXT) + objects.part(line, cp, ep) + color.RESET;
  }
  if (ep < line.len()) {
    out += pal.get(color.FUNC) + objects.part(line, ep, line.len()) + color.RESET;
  }
  return out;
}

// The line of an added or a removed line in the colors of git, with the
// marks of `--color-moved`: `emit_diff_symbol` of git.
function sign_line(pal: color.Palette, kind: i32, rest: string, rule: i32, eof: boolean, marks: i32): string {
  let moved_line = (marks & moved.MOVED) != 0;
  let alt = (marks & moved.ALT) != 0;
  let dim = (marks & moved.DIM) != 0;
  if (kind == moved.MINUS) {
    let set = pal.get(if (!moved_line) { color.OLD } else if (alt && dim) { color.OLD_MOVED_ALT_DIM_SLOT } else if (alt) { color.OLD_MOVED_ALT_SLOT } else if (dim) { color.OLD_MOVED_DIM_SLOT } else { color.OLD_MOVED_SLOT });
    return line0(set, "-", rest);
  }
  let set = pal.get(if (!moved_line) { color.NEW } else if (alt && dim) { color.NEW_MOVED_ALT_DIM_SLOT } else if (alt) { color.NEW_MOVED_ALT_SLOT } else if (dim) { color.NEW_MOVED_DIM_SLOT } else { color.NEW_MOVED_SLOT });
  // A color of white space that is empty shows no errors.
  let ws_color = pal.get(color.WHITESPACE);
  if (ws_color.len() == 0) {
    return line0(set, "+", rest);
  }
  if (eof) {
    return line0(ws_color, "+", rest);
  }
  let (_, text) = ws.check_emit(rest, rule, set, color.RESET, ws_color);
  return line0(set, "+", "") + text;
}

// Adds the lines of the hunks of `a` and `b` in the colors of git, each
// with a graph line of its own, with the errors of white space of the
// added lines (`fn_out_consume` and `emit_diff_symbol` of git). The added
// and the removed lines go in `moved` for `--color-moved`.
function painted(t_in: Text, o: Opts, body: string, a: u8[], b: u8[]): Text {
  let t = t_in;
  let (pre_eof, post_eof) = if ((o.ws_rule & ws.BLANK_AT_EOF) != 0) { blank_at_eof(a, b) } else { (0, 0) };
  let pre = 0;
  let post = 0;
  let at = 0;
  let last = b' ';
  while (at < body.len()) {
    let end = at;
    while (end < body.len() && body[end] != b'\n') {
      end += 1;
    }
    let line = objects.part(body, at, end);
    let first = if (line.len() > 0) { line[0] } else { b' ' };
    let rest = objects.part(line, 1.min(line.len()), line.len());
    let out = "";
    let kind = moved.OTHER;
    let eof = false;
    if (first == b'@') {
      pre = hunk_start(line, b'-');
      post = hunk_start(line, b'+');
      out = hunk_header(o.pal, line);
    } else if (first == b'+') {
      post += 1;
      kind = moved.PLUS;
      eof = pre_eof > 0 && post_eof > 0 && pre_eof <= pre && post_eof <= post && ws.blank(rest.bytes(), 0, rest.len());
      out = sign_line(o.pal, kind, rest, o.ws_rule, eof, 0);
    } else if (first == b'-') {
      pre += 1;
      kind = moved.MINUS;
      out = sign_line(o.pal, kind, rest, o.ws_rule, false, 0);
    } else if (first == b' ') {
      pre += 1;
      post += 1;
      out = line0(o.pal.get(color.CONTEXT), " ", rest);
    } else {
      pre += 1;
      // The line end that an added line does not have is an error.
      let slot = if (last == b'+' && (o.ws_rule & ws.INCOMPLETE_LINE) != 0) { color.WHITESPACE } else { color.CONTEXT };
      out = line0(o.pal.get(slot), "", line);
    }
    last = first;
    let (t1, k) = call(t);
    t = push(t1, k, out, true);
    if (kind != moved.OTHER) {
      let m = t.moved;
      t = Text { ...t, moved: Moved { at: m.at.append(t.lines.len() - 1), kinds: m.kinds.append(kind), texts: m.texts.append(rest + "\n"), rules: m.rules.append(o.ws_rule), eof: m.eof.append(eof) } };
    }
    at = end + 1;
  }
  return t;
}

// The text with the colors of the moved lines: `mark_color_as_moved` of
// git on the added and the removed lines of the whole patch.
function color_moved(t: Text, o: Opts): Text {
  let m = t.moved;
  if (m.at.len() == 0) {
    return t;
  }
  // The lines of the search: a line that is not added or removed comes
  // between two lines that are not next to each other in the text.
  let kinds: i32[] = [];
  let texts: string[] = [];
  let tabs: i32[] = [];
  let index: i32[] = [];
  for j in 0..m.at.len() {
    if (j > 0 && m.at[j - 1] + 1 != m.at[j]) {
      kinds = kinds.append(moved.OTHER);
      texts = texts.append("");
      tabs = tabs.append(8);
      index = index.append(-1);
    }
    kinds = kinds.append(m.kinds[j]);
    texts = texts.append(m.texts[j]);
    tabs = tabs.append(ws.tab_width(m.rules[j]));
    index = index.append(j);
  }
  let marks = moved.mark(kinds, texts, tabs, o.color_moved, o.color_moved_ws);
  let lines = t.lines;
  for i in 0..kinds.len() {
    let j = index[i];
    if (j >= 0 && marks[i] != 0) {
      let rest = objects.part(m.texts[j], 0, m.texts[j].len() - 1);
      lines = lines.with(m.at[j], sign_line(o.pal, m.kinds[j], rest, m.rules[j], m.eof[j], marks[i]));
    }
  }
  return Text { ...t, lines: lines };
}

// The header and the patch of one pair, without a split of a change of
// kind: `fill_metainfo` and `builtin_diff` of git, with their calls for
// the lines of the graph.
function patch_one(s_in: store.Store, o: Opts, p: Pair, one: Side, two: Side, least: i32, t_in: Text): (store.Store, Text) {
  let s = s_in;
  let (t0, meta_use) = call(t_in);
  let (t, head_use) = call(t0);
  let name_a = p.one.path;
  let name_b = p.two.path;
  let a_one = quote_two(o.src, name_a);
  let b_two = quote_two(o.dst, name_b);
  let lbl0 = if (one.valid) { a_one } else { "/dev/null" };
  let lbl1 = if (two.valid) { b_two } else { "/dev/null" };
  let meta = "";
  if (p.status == b'R' || p.status == b'C') {
    let word = if (p.status == b'R') { "rename" } else { "copy" };
    meta += "similarity index " + (p.score * 100 / 60000).to_string() + "%\n";
    meta += word + " from " + quoted(name_a) + "\n";
    meta += word + " to " + quoted(name_b) + "\n";
  }
  if (one.hash != two.hash) {
    let full = o.full_index;
    let n = if (o.abbrev > 0) { o.abbrev } else { least };
    meta += "index " + abbrev_of(s, one.hash, n, full) + ".." + abbrev_of(s, two.hash, n, full);
    if (one.valid && two.valid && one.mode == two.mode) {
      meta += " " + mode6(one.mode);
    }
    meta += "\n";
  }
  meta = meta_lines(o, meta);
  t = add(t, head_use, meta_line(o, "diff --git " + a_one + " " + b_two));
  if (!one.valid) {
    t = add(add(t, head_use, meta_line(o, "new file mode " + mode6(two.mode))), meta_use, meta);
  } else if (!two.valid) {
    t = add(add(t, head_use, meta_line(o, "deleted file mode " + mode6(one.mode))), meta_use, meta);
  } else {
    if (one.mode != two.mode) {
      t = add(t, head_use, meta_line(o, "old mode " + mode6(one.mode)) + meta_line(o, "new mode " + mode6(two.mode)));
    }
    t = add(t, meta_use, meta);
    if (kind_of(one.mode) != kind_of(two.mode)) {
      return (s, t);
    }
  }
  let (s3, a) = content(s, one);
  let (s4, b) = content(s3, two);
  s = s4;
  if (!o.text && (is_binary(a) || is_binary(b))) {
    if (one.hash == two.hash && one.valid && two.valid) {
      return (s, t);
    }
    let (t1, at_call) = call(t);
    return (s, add(t1, at_call, "Binary files " + lbl0 + " and " + lbl1 + " differ\n"));
  }
  let (body, died) = hunks(o, a, b, p.one.path, p.two.path);
  if (died.len() > 0) {
    return (s, Text { ...t_in, fatal: died });
  }
  if (body.len() == 0) {
    // git writes the header of a change of content with its first line
    // of the patch, and the ranges of `-L` can leave no line.
    let must_show = !one.valid || !two.valid || one.mode != two.mode || p.status == b'R' || p.status == b'C';
    return (s, if (must_show) { t } else { t_in });
  }
  let tab0 = if (lbl0.contains(" ")) { "\t" } else { "" };
  let tab1 = if (lbl1.contains(" ")) { "\t" } else { "" };
  if (o.word_diff != WORDS_NONE && o.word_regex_error.len() > 0) {
    return (s, Text { ...t_in, fatal: "invalid regular expression: " + o.word_regex_error });
  }
  if (o.word_diff != WORDS_NONE) {
    let labels = if (o.color) { o.pal.get(color.META) + "--- " + lbl0 + color.RESET + tab0 + "\n" + o.pal.get(color.META) + "+++ " + lbl1 + color.RESET + tab1 + "\n" } else { "--- " + lbl0 + tab0 + "\n+++ " + lbl1 + tab1 + "\n" };
    return (s, word_body(add_each(t, labels), o, text(body)));
  }
  if (o.color) {
    let labels = o.pal.get(color.META) + "--- " + lbl0 + color.RESET + tab0 + "\n" + o.pal.get(color.META) + "+++ " + lbl1 + color.RESET + tab1 + "\n";
    return (s, painted(add_each(t, labels), Opts { ...o, ws_rule: link_rule(rule_of(o, p.one.path), p.two.mode) }, text(body), a, b));
  }
  t = add_each(t, "--- " + lbl0 + tab0 + "\n+++ " + lbl1 + tab1 + "\n" + text(body));
  return (s, t);
}

// ---- The diff of words (`--word-diff`, diff_words_show of git) ----

// The forms of `--word-diff`.
pub const WORDS_NONE: i32 = 0;

pub const WORDS_PLAIN: i32 = 1;

pub const WORDS_COLOR: i32 = 2;

pub const WORDS_PORCELAIN: i32 = 3;

// How one kind of words shows: its color, and the texts before and after.
struct WordStyle { color: string, before: string, after: string }

// The styles of the added words, the removed words and the common words,
// and the text of a line end: `diff_words_styles` of git.
struct WordStyles { added: WordStyle, removed: WordStyle, common: WordStyle, newline: string }

function word_styles(o: Opts): WordStyles {
  let new_color = if (o.color) { o.pal.get(color.NEW) } else { "" };
  let old_color = if (o.color) { o.pal.get(color.OLD) } else { "" };
  let common_color = if (o.color) { o.pal.get(color.CONTEXT) } else { "" };
  if (o.word_diff == WORDS_PORCELAIN) {
    return WordStyles { added: WordStyle { color: new_color, before: "+", after: "\n" }, removed: WordStyle { color: old_color, before: "-", after: "\n" }, common: WordStyle { color: common_color, before: " ", after: "\n" }, newline: "~\n" };
  }
  if (o.word_diff == WORDS_PLAIN) {
    return WordStyles { added: WordStyle { color: new_color, before: "{+", after: "+}" }, removed: WordStyle { color: old_color, before: "[-", after: "-]" }, common: WordStyle { color: common_color, before: "", after: "" }, newline: "\n" };
  }
  return WordStyles { added: WordStyle { color: new_color, before: "", after: "" }, removed: WordStyle { color: old_color, before: "", after: "" }, common: WordStyle { color: common_color, before: "", after: "" }, newline: "\n" };
}

// The words of `text` after an empty word at 0: the start and the end of
// each. A word is a match of the regex of the words, cut at a line end,
// or a run of bytes that are not white space (`find_word_boundaries`).
function words_of(text: u8[], re: bre.Bre[]): (i32[], i32[]) {
  let begins: i32[] = [0];
  let ends: i32[] = [0];
  let i = 0;
  while (i < text.len()) {
    let begin = i;
    let end = -1;
    if (re.len() > 0) {
      while (begin < text.len() && end < 0) {
        let (ms, me) = re[0].search_from_bytes(text, begin, text.len());
        if (ms < 0) {
          return (begins, ends);
        }
        let nl = __memchr_bytes(text, 10, ms);
        let e = if (nl >= 0 && nl < me) { nl } else { me };
        if (ms == e) {
          begin = ms + 1;
        } else {
          begin = ms;
          end = e;
        }
      }
      if (end < 0) {
        return (begins, ends);
      }
    } else {
      while (begin < text.len() && objects.is_space(text[begin])) {
        begin += 1;
      }
      if (begin >= text.len()) {
        return (begins, ends);
      }
      end = begin + 1;
      while (end < text.len() && !objects.is_space(text[end])) {
        end += 1;
      }
    }
    begins = begins.append(begin);
    ends = ends.append(end);
    i = end;
  }
  return (begins, ends);
}

// The words as lines, one word in each, for the diff of the words.
function word_lines(text: u8[], begins: i32[], ends: i32[]): u8[] {
  let out = buf_new(text.len() + begins.len());
  for k in 1..begins.len() {
    buf_push_bytes_range(out, text, begins[k], ends[k]);
    buf_push_byte(out, 10);
  }
  return taken(out);
}

// Adds the bytes `from` to `to` of `text` in the style `st`, and the line
// end of the styles for each line end, with the graph line before each
// line after the first: `fn_out_diff_words_write_helper` of git.
function words_write(t_in: Text, st: WordStyle, newline: string, text: u8[], from: i32, to: i32): Text {
  let t = t_in;
  let print = false;
  let at = from;
  while (at < to) {
    let found = __memchr_bytes(text, 10, at);
    let p = if (found >= 0 && found < to) { found } else { -1 };
    if (print) {
      let (t1, k) = call(t);
      t = push(t1, k, "", false);
    }
    if (p != at) {
      let reset = if (st.color.len() > 0) { color.RESET } else { "" };
      t = add_raw(t, st.color + st.before + objects.part_bytes(text, at, if (p < 0) { to } else { p }) + st.after + reset);
    }
    if (p < 0) {
      return t;
    }
    t = add_raw(t, newline);
    at = p + 1;
    print = true;
  }
  return t;
}

// True when the next words start a line, so that the graph goes before
// them: `color_words_output_graph_prefix` of git.
function words_line_start(plus: u8[], current: i32, last_minus: i32): boolean {
  return last_minus == 0 && current == 0 || current > 0 && plus[current - 1] == b'\n';
}

// The diff of the words of the removed lines `minus` and of the added
// lines `plus`: the common text of `plus`, and the removed and the added
// words in their styles.
function words_show(t_in: Text, o: Opts, minus: u8[], plus: u8[]): Text {
  let sty = word_styles(o);
  let (t, prefix) = call(t_in);
  if (plus.len() == 0) {
    return words_write(push(t, prefix, "", false), sty.removed, sty.newline, minus, 0, minus.len());
  }
  let (mb, me) = words_of(minus, o.word_regex);
  let (pb, pe) = words_of(plus, o.word_regex);
  let ma = word_lines(minus, mb, me);
  let pa = word_lines(plus, pb, pe);
  let tail = linediff.common_tail(ma, pa);
  let la = linediff.lines_of(array.slice(ma, 0, ma.len() - tail));
  let lb = linediff.lines_of(array.slice(pa, 0, pa.len() - tail));
  let plain = linediff.Options { algorithm: linediff.MYERS, minimal: false, indent_heuristic: false };
  let current = 0;
  let last_minus = 0;
  for ch in linediff.diff(la, lb, plain) {
    let (t1, k) = call(t);
    t = t1;
    let minus_first = if (ch.del > 0) { ch.i1 + 1 } else { ch.i1 };
    let plus_first = if (ch.ins > 0) { ch.i2 + 1 } else { ch.i2 };
    let minus_begin = if (ch.del > 0) { mb[minus_first] } else { me[minus_first] };
    let minus_end = if (ch.del > 0) { me[minus_first + ch.del - 1] } else { minus_begin };
    let plus_begin = if (ch.ins > 0) { pb[plus_first] } else { pe[plus_first] };
    let plus_end = if (ch.ins > 0) { pe[plus_first + ch.ins - 1] } else { plus_begin };
    if (words_line_start(plus, current, last_minus)) {
      t = push(t, k, "", false);
    }
    if (current != plus_begin) {
      t = words_write(t, sty.common, sty.newline, plus, current, plus_begin);
    }
    if (minus_begin != minus_end) {
      t = words_write(t, sty.removed, sty.newline, minus, minus_begin, minus_end);
    }
    if (plus_begin != plus_end) {
      t = words_write(t, sty.added, sty.newline, plus, plus_begin, plus_end);
    }
    current = plus_end;
    last_minus = minus_first;
  }
  if (current != plus.len()) {
    if (words_line_start(plus, current, last_minus)) {
      t = push(t, prefix, "", false);
    }
    t = words_write(t, sty.common, sty.newline, plus, current, plus.len());
  }
  return t;
}

// The line `text` in the color `set`, as `emit_line` of git writes it: an
// empty line has no color, and a carriage return goes after the reset.
function emit_line(set: string, reset: string, text: string): string {
  let cr = text.len() > 0 && text[text.len() - 1] == b'\r';
  let body = if (cr) { objects.part(text, 0, text.len() - 1) } else { text };
  if (body.len() == 0) {
    return if (cr) { "\r" } else { "" };
  }
  return set + body + reset + (if (cr) { "\r" } else { "" });
}

// The hunks `body` as a diff of words: the hunk headers, the common lines,
// and the diff of the words of each run of removed and added lines
// (`fn_out_consume` of git with `diff_words`).
function word_body(t_in: Text, o: Opts, body: string): Text {
  let t = t_in;
  let reset = if (o.color) { color.RESET } else { "" };
  let context = if (o.color) { o.pal.get(color.CONTEXT) } else { "" };
  let minus = buf_new(256);
  let plus = buf_new(256);
  let pending = false;
  let at = 0;
  while (at < body.len()) {
    let nl = __memchr_bytes(body.bytes(), 10, at);
    let end = if (nl < 0) { body.len() } else { nl };
    let line = objects.part(body, at, end);
    at = end + 1;
    let first = if (line.len() > 0) { line[0] } else { b' ' };
    if (first == b'-' || first == b'+') {
      buf_push(if (first == b'-') { minus } else { plus }, objects.part(line, 1, line.len()) + "\n");
      pending = true;
      continue;
    }
    if (first == b'\\') {
      continue;
    }
    if (pending) {
      t = words_show(t, o, buf_take_bytes(minus), buf_take_bytes(plus));
      pending = false;
    }
    let (t1, k) = call(t);
    t = t1;
    if (first == b'@') {
      t = push(t, k, if (o.color) { hunk_header(o.pal, line) } else { line }, true);
    } else if (o.word_diff == WORDS_PORCELAIN) {
      t = push(push(t, k, emit_line(context, reset, line), true), -1, "~", true);
    } else {
      t = push(t, k, emit_line(context, reset, objects.part(line, 1.min(line.len()), line.len())), true);
    }
  }
  if (pending) {
    t = words_show(t, o, buf_take_bytes(minus), buf_take_bytes(plus));
  }
  buf_free(minus);
  buf_free(plus);
  return t;
}

// The patch of one pair. A change between a file and a link is a deletion
// and an addition.
function patch_pair(s: store.Store, o: Opts, p: Pair, least: i32, t: Text): (store.Store, Text) {
  if (p.one.valid && p.two.valid && kind_of(p.one.mode) != kind_of(p.two.mode)) {
    let zero = "0".repeat(p.one.hash.len());
    let none_two = Side { valid: false, path: p.two.path, mode: "", hash: zero };
    let none_one = Side { valid: false, path: p.one.path, mode: "", hash: zero };
    let (s1, t1) = patch_one(s, o, Pair { ...p, status: b'D' }, p.one, none_two, least, t);
    return patch_one(s1, o, Pair { ...p, status: b'A' }, none_one, p.two, least, t1);
  }
  return patch_one(s, o, p, p.one, p.two, least, t);
}

// ---- The stat ----

// The counts of one pair for the stat.
struct Stat { name: string, print_name: string, added: i64, deleted: i64, binary: boolean, renamed: boolean }

function count_lines(o: Opts, a: u8[], b: u8[]): (i64, i64) {
  let ab = a;
  let bb = b;
  if (o.context == 0) {
    let t = linediff.common_tail(a, b);
    ab = array.slice(a, 0, a.len() - t);
    bb = array.slice(b, 0, b.len() - t);
  }
  let script = linediff.diff(linediff.lines_of(ab), linediff.lines_of(bb), o.algo);
  let added: i64 = 0;
  let deleted: i64 = 0;
  for c in script {
    added += c.ins as i64;
    deleted += c.del as i64;
  }
  return (added, deleted);
}

// The name of a rename in the stat: the common prefix and suffix of the
// two paths around `{OLD => NEW}`, as `pprint_rename` of git writes it.
pub function pprint_rename(a: u8[], b: u8[]): string {
  if (!objects.plain_name(a) || !objects.plain_name(b)) {
    return quoted(a) + " => " + quoted(b);
  }
  let len_a = a.len();
  let len_b = b.len();
  let pfx = 0;
  let i = 0;
  while (i < len_a && i < len_b && a[i] == b[i]) {
    if (a[i] == b'/') {
      pfx = i + 1;
    }
    i += 1;
  }
  let sfx = 0;
  let adjust = if (pfx > 0) { 1 } else { 0 };
  let oa = len_a;
  let ob = len_b;
  // `oa` and `ob` point at the byte that the loop compares, with the end
  // of each path as a NUL.
  while (pfx - adjust <= oa && pfx - adjust <= ob) {
    let ca = if (oa < len_a) { a[oa] } else { 0 as u8 };
    let cb = if (ob < len_b) { b[ob] } else { 0 as u8 };
    if (ca != cb) {
      break;
    }
    if (ca == b'/') {
      sfx = len_a - oa;
    }
    oa -= 1;
    ob -= 1;
  }
  let a_mid = (len_a - pfx - sfx).max(0);
  let b_mid = (len_b - pfx - sfx).max(0);
  let out = "";
  if (pfx + sfx > 0) {
    out += text(array.slice(a, 0, pfx)) + "{";
  }
  out += text(array.slice(a, pfx, pfx + a_mid)) + " => " + text(array.slice(b, pfx, pfx + b_mid));
  if (pfx + sfx > 0) {
    out += "}" + text(array.slice(a, len_a - sfx, len_a));
  }
  return out;
}

function stat_of(s_in: store.Store, o: Opts, p: Pair): (store.Store, Stat) {
  let (s1, a) = content(s_in, p.one);
  let (s2, b) = content(s1, p.two);
  let renamed = p.status == b'R' || p.status == b'C';
  let name = if (renamed) { pprint_rename(p.one.path, p.two.path) } else { quoted(p.two.path) };
  let st = Stat { name: quoted(p.two.path), print_name: name, added: 0, deleted: 0, binary: false, renamed: renamed };
  let same = p.one.valid && p.two.valid && p.one.hash == p.two.hash;
  if (!o.text && (is_binary(a) || is_binary(b))) {
    if (same) {
      return (s2, Stat { ...st, binary: true });
    }
    return (s2, Stat { ...st, binary: true, added: b.len() as i64, deleted: a.len() as i64 });
  }
  if (same) {
    return (s2, st);
  }
  let (added, deleted) = count_lines(o, a, b);
  return (s2, Stat { ...st, added: added, deleted: deleted });
}

function decimal_width(n: i64): i32 {
  let w = 1;
  let v = n;
  while (v >= 10) {
    v /= 10;
    w += 1;
  }
  return w;
}

function scale_linear(it: i64, width: i64, max_change: i64): i64 {
  if (it == 0) {
    return 0;
  }
  return 1 + it * (width - 1) / max_change;
}

function spaces(n: i64): string {
  return if (n > 0) { " ".repeat(n as i32) } else { "" };
}

function pad_left(text: string, width: i32): string {
  return spaces((width - text.len()) as i64) + text;
}

// The summary line: ` N files changed, N insertions(+), N deletions(-)`.
function summary_line(files: i32, adds: i64, dels: i64): string {
  if (files == 0) {
    return " 0 files changed\n";
  }
  let out = " " + files.to_string() + (if (files == 1) { " file changed" } else { " files changed" });
  if (adds != 0 || dels == 0) {
    out += ", " + adds.to_string() + (if (adds == 1) { " insertion(+)" } else { " insertions(+)" });
  }
  if (dels != 0 || adds == 0) {
    out += ", " + dels.to_string() + (if (dels == 1) { " deletion(-)" } else { " deletions(-)" });
  }
  return out + "\n";
}

function paint(o: Opts, set: string, text: string): string {
  return if (o.color) { set + text + color.RESET } else { text };
}

// The `count` characters `c` of the graph of a stat: `show_graph` of git.
function bar(o: Opts, set: string, c: string, count: i64): string {
  return if (count > 0) { paint(o, set, c.repeat(count as i32)) } else { "" };
}

// The lines of `--stat`: `show_stats` of git. `prefix_width` is the width
// of the graph before each line.
function show_stats(stats: Stat[], o: Opts, prefix_width: i32): string {
  if (stats.len() == 0) {
    return "";
  }
  let count = if (o.stat_count > 0) { o.stat_count.min(stats.len()) } else { stats.len() };
  let max_len: i64 = 0;
  let max_change: i64 = 0;
  let number_width = 0;
  let bin_width = 0;
  for i in 0..count {
    let f = stats[i];
    max_len = max_len.max(f.print_name.len() as i64);
    if (f.binary) {
      let w = 14 + decimal_width(f.added) + decimal_width(f.deleted);
      bin_width = bin_width.max(w);
      number_width = 3;
    } else {
      max_change = max_change.max(f.added + f.deleted);
    }
  }
  number_width = number_width.max(decimal_width(max_change));
  let width = if (o.stat_width == -1) { width.term_columns() - prefix_width } else if (o.stat_width == 0) { 80 } else { o.stat_width };
  if (width < 16 + 6 + number_width) {
    width = 16 + 6 + number_width;
  }
  let graph_width: i64 = if (max_change + 4 > bin_width as i64) { max_change } else { (bin_width - 4) as i64 };
  if (o.stat_graph_width > 0 && o.stat_graph_width as i64 < graph_width) {
    graph_width = o.stat_graph_width as i64;
  }
  let name_width: i64 = if (o.stat_name_width > 0 && o.stat_name_width as i64 < max_len) { o.stat_name_width as i64 } else { max_len };
  let w = width as i64;
  let nw = number_width as i64;
  if (name_width + nw + 6 + graph_width > w) {
    if (graph_width > w * 3 / 8 - nw - 6) {
      graph_width = w * 3 / 8 - nw - 6;
      if (graph_width < 6) {
        graph_width = 6;
      }
    }
    if (o.stat_graph_width > 0 && graph_width > o.stat_graph_width as i64) {
      graph_width = o.stat_graph_width as i64;
    }
    if (name_width > w - nw - 6 - graph_width) {
      name_width = w - nw - 6 - graph_width;
    } else {
      graph_width = w - nw - 6 - name_width;
    }
  }
  let out = "";
  for i in 0..count {
    let f = stats[i];
    let name = f.print_name;
    let prefix = "";
    let len = name_width;
    if (name_width < name.len() as i64) {
      prefix = "...";
      len = (len - 3).max(0);
      let cut = name.len() as i64 - len;
      name = objects.part(name, cut as i32, name.len());
      if let Some(slash) = name.index_of("/") {
        name = objects.part(name, slash, name.len());
      }
    }
    let padding = (len - name.len() as i64).max(0);
    if (f.binary) {
      out += " " + prefix + name + spaces(padding) + " | " + pad_left("Bin", number_width);
      if (f.added == 0 && f.deleted == 0) {
        out += "\n";
      } else {
        out += " " + paint(o, o.pal.get(color.OLD), f.deleted.to_string()) + " -> " + paint(o, o.pal.get(color.NEW), f.added.to_string()) + " bytes\n";
      }
      continue;
    }
    let add = f.added;
    let del = f.deleted;
    if (graph_width <= max_change) {
      let total = scale_linear(add + del, graph_width, max_change);
      if (total < 2 && add > 0 && del > 0) {
        total = 2;
      }
      if (add < del) {
        add = scale_linear(add, graph_width, max_change);
        del = total - add;
      } else {
        del = scale_linear(del, graph_width, max_change);
        add = total - del;
      }
    }
    out += " " + prefix + name + spaces(padding) + " | " + pad_left((f.added + f.deleted).to_string(), number_width) + (if (f.added + f.deleted > 0) { " " } else { "" });
    out += bar(o, o.pal.get(color.NEW), "+", add) + bar(o, o.pal.get(color.OLD), "-", del) + "\n";
  }
  let adds: i64 = 0;
  let dels: i64 = 0;
  for f in stats {
    if (!f.binary) {
      adds += f.added;
      dels += f.deleted;
    }
  }
  if (count < stats.len()) {
    out += " ...\n";
  }
  return out + summary_line(stats.len(), adds, dels);
}

function show_numstat(stats: Stat[]): string {
  let out = "";
  for f in stats {
    if (f.binary) {
      out += "-\t-\t";
    } else {
      out += f.added.to_string() + "\t" + f.deleted.to_string() + "\t";
    }
    out += (if (f.renamed) { f.print_name } else { f.name }) + "\n";
  }
  return out;
}

function show_shortstat(stats: Stat[]): string {
  if (stats.len() == 0) {
    return "";
  }
  let adds: i64 = 0;
  let dels: i64 = 0;
  for f in stats {
    if (!f.binary) {
      adds += f.added;
      dels += f.deleted;
    }
  }
  return summary_line(stats.len(), adds, dels);
}

// The lines of `--summary` for one pair: `diff_summary` of git.
function summary_of(p: Pair): string {
  if (p.status == b'D') {
    return " delete mode " + mode6(p.one.mode) + " " + quoted(p.one.path) + "\n";
  }
  if (p.status == b'A') {
    return " create mode " + mode6(p.two.mode) + " " + quoted(p.two.path) + "\n";
  }
  let out = "";
  let moved_path = p.status == b'R' || p.status == b'C';
  if (moved_path) {
    out += " " + (if (p.status == b'R') { "rename" } else { "copy" }) + " " + pprint_rename(p.one.path, p.two.path) + " (" + (p.score * 100 / 60000).to_string() + "%)\n";
  }
  if (p.one.mode != p.two.mode) {
    out += " mode change " + mode6(p.one.mode) + " => " + mode6(p.two.mode) + (if (moved_path) { "" } else { " " + quoted(p.two.path) }) + "\n";
  }
  return out;
}

// The lines of `--check` for the changes, and true when a line has an
// error: `builtin_checkdiff` of git. The line of a blank line at the end
// of a file has no line of the graph before it, as in git.
pub function check(s_in: store.Store, changes: treediff.Change[], o: Opts): (store.Store, Text, boolean) {
  let s = s_in;
  let t = text_new();
  let failed = false;
  let set = if (o.color) { o.pal.get(color.NEW) } else { "" };
  let reset = if (o.color) { color.RESET } else { "" };
  let bad_color = if (o.color) { o.pal.get(color.WHITESPACE) } else { "" };
  for c in changes {
    let p = pair_of(c);
    let name = text(if (p.one.path != p.two.path) { p.two.path } else { p.one.path });
    let (s1, a) = content(s, p.one);
    let (s2, b) = content(s1, p.two);
    s = s2;
    if (is_binary(b)) {
      continue;
    }
    let rule = link_rule(rule_of(o, if (p.one.path != p.two.path) { p.two.path } else { p.one.path }), p.two.mode);
    let incomplete = (rule & ws.INCOMPLETE_LINE) != 0 && b.len() > 0 && b[b.len() - 1] != b'\n';
    let la = linediff.lines_of(a);
    let lb = linediff.lines_of(b);
    let plain = linediff.Options { algorithm: linediff.MYERS, minimal: false, indent_heuristic: false };
    for ch in linediff.diff(la, lb, plain) {
      for j in ch.i2..ch.i2 + ch.ins {
        let line = objects.part_bytes(lb.data, lb.starts[j], lb.starts[j + 1]);
        let at = name + ":" + (j + 1).to_string() + ": ";
        if (ws.conflict_marker(line, 7)) {
          failed = true;
          t = add_each(t, at + "leftover conflict marker\n");
        }
        let (bad, shown) = ws.check_emit(line, rule, set, reset, bad_color);
        if (bad != 0) {
          failed = true;
          t = add_each(t, at + ws.error_string(bad) + ".\n");
          t = add_each(t, set + "+" + reset + shown + (if (shown.ends_with("\n")) { "" } else { "\n" }));
        }
        if (incomplete && j == lb.count() - 1) {
          failed = true;
          t = add_each(t, at + ws.error_string(ws.INCOMPLETE_LINE) + ".\n");
        }
      }
    }
    if ((rule & ws.BLANK_AT_EOF) != 0) {
      let (_, post) = blank_at_eof(a, b);
      if (post > 0) {
        failed = true;
        t = push(t, -1, name + ":" + post.to_string() + ": " + ws.error_string(ws.BLANK_AT_EOF) + ".", true);
      }
    }
  }
  return (s, t, failed);
}

// The rule `rule` of a file of mode `mode`. A symbolic link has no line end
// at its end, and that is not an error.
function link_rule(rule: i32, mode: string): i32 {
  return if (mode == "120000") { rule & ~ws.INCOMPLETE_LINE } else { rule };
}

// The rules of white space of the file `path`: those of the attribute
// `whitespace`, or those of `core.whitespace` (`whitespace_rule` of git).
pub function rule_of(o: Opts, path: u8[]): i32 {
  if (o.attrs.len() == 0) {
    return o.ws_rule;
  }
  let v = attr.value_of(o.attrs[0], text(path), "whitespace");
  if (v == attr.SET) {
    return ws.all_rules(o.ws_rule);
  }
  if (v == attr.UNSET) {
    return ws.tab_width(o.ws_rule);
  }
  if (v == attr.UNSPECIFIED) {
    return o.ws_rule;
  }
  let (rule, _, _) = ws.parse(v);
  return rule;
}

// The line of `--raw` for one pair: `diff_flush_raw` of git.
function raw_line(s: store.Store, o: Opts, p: Pair, least: i32): string {
  let n = if (o.abbrev > 0) { o.abbrev } else { least };
  let full = o.abbrev == 0;
  let out = ":" + mode6(p.one.mode) + " " + mode6(p.two.mode) + " " + abbrev_of(s, p.one.hash, n, full) + " " + abbrev_of(s, p.two.hash, n, full) + " ";
  out += unsafe { string_from_bytes_unchecked([p.status]) };
  if (p.score > 0) {
    out += (p.score * 100 / 60000).to_string().pad_start_str(3, "0");
  }
  if (p.status == b'R' || p.status == b'C') {
    return out + "\t" + quoted(p.one.path) + "\t" + quoted(p.two.path) + "\n";
  }
  return out + "\t" + quoted(if (p.one.valid) { p.one.path } else { p.two.path }) + "\n";
}

// The diff of the changes: the raw lines, the stats, the summary, a line
// end, and the
// patch, as `diff_flush` of git prints them. `least` is the least length
// of a short name, and `prefix_width` gives the width of the graph line
// of a call. There are no lines when there are no changes.
pub function render(s_in: store.Store, changes: treediff.Change[], o: Opts, least: i32, prefix_width: (i32) => i32): (store.Store, Text) {
  let s = s_in;
  let t = text_new();
  if (changes.len() == 0) {
    return (s, t);
  }
  let pairs = changes.map((c: treediff.Change): Pair => pair_of(c));
  let separator = false;
  if (o.raw) {
    let lines = "";
    for p in pairs {
      lines += raw_line(s, o, p, least);
    }
    t = add_each(t, lines);
    separator = true;
  }
  if (o.stat || o.numstat || o.shortstat) {
    let stats: Stat[] = [];
    for p in pairs {
      let (s1, st) = stat_of(s, o, p);
      s = s1;
      stats = stats.append(st);
    }
    if (o.numstat) {
      t = add_each(t, show_numstat(stats));
    }
    if (o.stat) {
      let (t1, at_call) = call(t);
      t = add_each(t1, show_stats(stats, o, prefix_width(at_call)));
    }
    if (o.shortstat) {
      t = add_each(t, show_shortstat(stats));
    }
    separator = true;
  }
  if (o.summary) {
    let lines = "";
    for p in pairs {
      lines += summary_of(p);
    }
    if (lines.len() > 0) {
      t = add_each(t, lines);
      separator = true;
    }
  }
  if (o.patch) {
    if (separator) {
      let (t2, at_call) = call(t);
      t = push(t2, at_call, "", true);
    }
    for p in pairs {
      if (t.fatal.len() > 0) {
        return (s, t);
      }
      let (s2, t3) = patch_pair(s, o, p, least, t);
      s = s2;
      t = t3;
    }
    if (o.color && o.color_moved != moved.NO) {
      t = color_moved(t, o);
    }
  }
  return (s, t);
}

// ---- Patch ids (diff_get_patch_id of git) ----

function without_space(b: u8[]): u8[] {
  let out: u8[] = [];
  for c in b {
    if (!objects.is_space(c)) {
      out = out.append(c);
    }
  }
  return out;
}

// The text that the patch id of the changes hashes: the names, the
// modes, and the lines of the patch with three lines of context and no
// white space, or the names of the objects of a binary file. Two commits
// with the same text have the same patch id.
pub function patch_id_text(s_in: store.Store, changes: treediff.Change[]): (store.Store, u8[]) {
  let s = s_in;
  let out = buf_new(1024);
  for c in changes {
    let p = pair_of(c);
    let one = without_space(p.one.path);
    let two = without_space(p.two.path);
    buf_push(out, "diff--gita/");
    buf_push_bytes_range(out, one, 0, one.len());
    buf_push(out, "b/");
    buf_push_bytes_range(out, two, 0, two.len());
    if (!p.one.valid) {
      buf_push(out, "newfilemode" + mode6(p.two.mode));
    } else if (!p.two.valid) {
      buf_push(out, "deletedfilemode" + mode6(p.one.mode));
    } else if (p.one.mode != p.two.mode) {
      buf_push(out, "oldmode" + mode6(p.one.mode) + "newmode" + mode6(p.two.mode));
    }
    let (s1, a) = content(s, p.one);
    let (s2, b) = content(s1, p.two);
    s = s2;
    if (is_binary(a) || is_binary(b)) {
      buf_push(out, p.one.hash + p.two.hash);
      continue;
    }
    if (!p.one.valid) {
      buf_push(out, "---/dev/null+++b/");
      buf_push_bytes_range(out, two, 0, two.len());
    } else if (!p.two.valid) {
      buf_push(out, "---a/");
      buf_push_bytes_range(out, one, 0, one.len());
      buf_push(out, "+++/dev/null");
    } else {
      buf_push(out, "---a/");
      buf_push_bytes_range(out, one, 0, one.len());
      buf_push(out, "+++b/");
      buf_push_bytes_range(out, two, 0, two.len());
    }
    let la = linediff.lines_of(a);
    let lb = linediff.lines_of(b);
    let plain = linediff.Options { algorithm: linediff.MYERS, minimal: false, indent_heuristic: false };
    let script = linediff.diff(la, lb, plain);
    let hunk = buf_new(1024);
    linediff.unified(hunk, la, lb, script, linediff.Emit { context: 3, interhunk: 0, funcnames: false, find_func: None });
    let text = taken(hunk);
    // The lines without the hunk headers and the lines that say that a
    // file has no line end at its end.
    let at = 0;
    while (at < text.len()) {
      let nl = __memchr_bytes(text, 10, at);
      let end = if (nl < 0) { text.len() } else { nl + 1 };
      let skip = text[at] == b'@' || end - at > 12 && text[at] == b'\\' && text[at + 1] == b' ';
      if (!skip) {
        let line = without_space(array.slice(text, at, end));
        buf_push_bytes_range(out, line, 0, line.len());
      }
      at = end;
    }
  }
  return (s, taken(out));
}

// ---- Pickaxe (diffcore-pickaxe.c) ----

// The pickaxe of `-S` (kind 1) and `-G` (kind 2), or kind 0 for none.
// `regex` is `--pickaxe-regex`, `all` is `--pickaxe-all`, and `re` holds
// the compiled pattern when the pickaxe has one.
pub struct Pickaxe { kind: i32, needle: string, regex: boolean, all: boolean, icase: boolean, re: bre.Bre[] }

pub function no_pickaxe(): Pickaxe {
  return Pickaxe { kind: 0, needle: "", regex: false, all: false, icase: false, re: [] };
}

function lower(b: u8): u8 {
  return if (b >= b'A' && b <= b'Z') { b + 32 } else { b };
}

// The count of the matches of the pickaxe in `data`, which stops at
// `limit` when it is above 0: `contains` of git.
function count_matches(p: Pickaxe, data: u8[], limit: i32): i32 {
  let cnt = 0;
  if (p.re.len() > 0) {
    let at = 0;
    while (at < data.len()) {
      let (start, end) = p.re[0].search_from_bytes(data, at, data.len());
      if (start < 0) {
        break;
      }
      at = if (end == start) { end + 1 } else { end };
      cnt += 1;
      if (limit > 0 && cnt == limit) {
        return cnt;
      }
    }
    return cnt;
  }
  let n = p.needle.len();
  if (n == 0) {
    return 0;
  }
  let i = 0;
  while (i + n <= data.len()) {
    let same = true;
    let k = 0;
    while (same && k < n) {
      let a = data[i + k];
      let b = p.needle[k];
      same = a == b || p.icase && lower(a) == lower(b);
      k += 1;
    }
    if (same) {
      cnt += 1;
      if (limit > 0 && cnt == limit) {
        return cnt;
      }
      i += n;
    } else {
      i += 1;
    }
  }
  return cnt;
}

// True if a deleted or an added line of the diff of `a` and `b` matches
// the pattern of `-G`: `diff_grep` of git.
function grep_lines(p: Pickaxe, o: Opts, a: u8[], b: u8[]): boolean {
  let la = linediff.lines_of(a);
  let lb = linediff.lines_of(b);
  let script = linediff.diff(la, lb, linediff.Options { ...o.algo, indent_heuristic: false });
  let line_matches = (l: linediff.Lines, i: i32): boolean => {
    let from = l.starts[i];
    let to = l.starts[i + 1];
    let end = if (to > from && l.data[to - 1] == b'\n') { to - 1 } else { to };
    return p.re[0].search_range_bytes(l.data, from, end);
  };
  for c in script {
    for i in c.i1..c.i1 + c.del {
      if (line_matches(la, i)) {
        return true;
      }
    }
    for j in c.i2..c.i2 + c.ins {
      if (line_matches(lb, j)) {
        return true;
      }
    }
  }
  return false;
}

// True if the pair matches the pickaxe: `pickaxe_match` of git.
function pickaxe_match(s_in: store.Store, p: Pickaxe, o: Opts, c: treediff.Change): (store.Store, boolean) {
  let pair = pair_of(c);
  if (pair.one.valid && pair.two.valid && pair.one.hash == pair.two.hash) {
    return (s_in, false);
  }
  let (s1, a) = content(s_in, pair.one);
  let (s2, b) = content(s1, pair.two);
  if (p.kind == 2) {
    if (!o.text && (is_binary(a) || is_binary(b))) {
      return (s2, false);
    }
    return (s2, grep_lines(p, o, a, b));
  }
  let c1 = count_matches(p, a, 0);
  let c2 = count_matches(p, b, c1 + 1);
  return (s2, c1 != c2);
}

// The changes that the pickaxe keeps: the pairs that match, or each pair
// with `--pickaxe-all` when one matches.
pub function pickaxe(s_in: store.Store, changes: treediff.Change[], p: Pickaxe, o: Opts): (store.Store, treediff.Change[]) {
  let s = s_in;
  let kept: treediff.Change[] = [];
  for c in changes {
    let (s1, yes) = pickaxe_match(s, p, o, c);
    s = s1;
    if (yes) {
      if (p.all) {
        return (s, changes);
      }
      kept = kept.append(c);
    }
  }
  return (s, if (p.all) { [] } else { kept });
}
