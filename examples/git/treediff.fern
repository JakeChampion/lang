// Pathspecs and the differences of two trees (tree-diff.c of git).
//
// A pathspec item is a path from the top of the worktree. It names the
// entry at that path and each entry below it. An item with `*`, `?` or `[`
// is a pattern that the whole path matches, as `fnmatch` reads it with no
// flags: `*` matches a `/` also.
import "std/array";
import "std/result";
import "core/cmp";
import "core/map";
import "../../coreutils/lib/fnmatch";
import "./objects";
import "./store";

// One difference: `status` is `A` (added), `D` (deleted), `M` (changed),
// `T` (a change of the kind of file), `R` (a rename from `old_path` with
// the score `score`) or `C` (a copy from `old_path`). A mode is "" and a
// hash is the zero name for a side that has no entry.
pub struct Change { status: u8, path: u8[], old_mode: string, new_mode: string, old_hash: string, new_hash: string, old_path: u8[], score: i32 }

pub function has_wildcard(item: string): boolean {
  for i in 0..item.len() {
    let b = item[i];
    if (b == b'*' || b == b'?' || b == b'[' || b == b'\\') {
      return true;
    }
  }
  return false;
}

// The part of `item` before its first wildcard.
function literal_part(item: string): string {
  for i in 0..item.len() {
    let b = item[i];
    if (b == b'*' || b == b'?' || b == b'[' || b == b'\\') {
      return objects.part(item, 0, i);
    }
  }
  return item;
}

function starts(path: u8[], text: string): boolean {
  if (text.len() > path.len()) {
    return false;
  }
  for i in 0..text.len() {
    if (path[i] != text[i]) {
      return false;
    }
  }
  return true;
}

function text_starts(text: string, path: u8[]): boolean {
  if (path.len() > text.len()) {
    return false;
  }
  for i in 0..path.len() {
    if (path[i] != text[i]) {
      return false;
    }
  }
  return true;
}

// How the entry at `path` is in the pathspec `items`: 0 not in it, 1 in
// it, and 2 when it and each entry below it are in it. No item takes in
// every entry.
pub function interesting(items: string[], path: u8[], is_tree: boolean): i32 {
  if (items.len() == 0) {
    return 2;
  }
  let best = 0;
  for item in items {
    let n = item.len();
    let dir_item = n > 0 && item[n - 1] == b'/';
    let bare = if (dir_item) { objects.part(item, 0, n - 1) } else { item };
    if (!has_wildcard(item)) {
      // The path is the item, or is below it.
      if (starts(path, bare) && (path.len() == bare.len() && (is_tree || !dir_item) || path.len() > bare.len() && path[bare.len()] == b'/')) {
        return 2;
      }
      // The path is a directory on the way to the item.
      if (is_tree && path.len() < bare.len() && text_starts(bare, path) && bare[path.len()] == b'/') {
        best = 1;
      }
    } else {
      let text = unsafe { string_from_bytes_unchecked(path) };
      if (fnmatch.fnmatch(item, text)) {
        return 2;
      }
      let lit = literal_part(item);
      if (is_tree) {
        let with_slash = path.append(b'/');
        if (starts(with_slash, lit) || text_starts(lit, with_slash)) {
          best = 1;
        }
      }
    }
  }
  return best;
}

// The entries of the tree `hash`, or none when there is no such tree.
pub function entries_of(s: store.Store, hash: string): (store.Store, objects.RawTree) {
  if (hash.len() == 0) {
    return (s, objects.raw_tree([], s.width));
  }
  if let Some(t) = store.tree_seen(s, hash) {
    return (s, t);
  }
  let got = store.read(s, hash);
  let t = match (got.object) {
    Ok(o) => if (o.kind == "tree") { objects.raw_tree(o.body, got.store.width) } else { objects.raw_tree([], got.store.width) },
    Err(_) => objects.raw_tree([], got.store.width),
  };
  store.keep_tree(got.store, hash, t);
  return (got.store, t);
}

// The order of the entry `i` of `a` and the entry `j` of `b`, as git
// sorts them: a tree sorts as if its name ends with `/`.
function entry_cmp(a: objects.RawTree, i: i32, b: objects.RawTree, j: i32): i32 {
  let pa = a.name[i];
  let pb = b.name[j];
  let la = a.hash[i] - 1 - pa;
  let lb = b.hash[j] - 1 - pb;
  let n = la.min(lb);
  for k in 0..n {
    let x = a.body[pa + k];
    let y = b.body[pb + k];
    if (x != y) {
      return if (x < y) { -1 } else { 1 };
    }
  }
  let ca: u8 = if (la > n) { a.body[pa + n] } else if (a.is_tree(i)) { b'/' } else { 0 };
  let cb: u8 = if (lb > n) { b.body[pb + n] } else if (b.is_tree(j)) { b'/' } else { 0 };
  return if (ca < cb) { -1 } else if (ca > cb) { 1 } else { 0 };
}

// The differences so far and the store after the reads. With `quick`, the
// walk stops at the first difference.
pub struct Diffed { store: store.Store, changes: Change[] }

function added(d: Diffed, t: objects.RawTree, k: i32, path: u8[], zero: string, items: string[], all: boolean, quick: boolean, adding: boolean): Diffed {
  if (t.is_tree(k)) {
    let (s, sub) = entries_of(d.store, t.hash_hex(k));
    let now = Diffed { store: s, changes: d.changes };
    for c in 0..sub.count() {
      if (quick && now.changes.len() > 0) {
        return now;
      }
      let p = path.append(b'/').concat(sub.entry_name(c));
      let how = if (all) { 2 } else { interesting(items, p, sub.is_tree(c)) };
      if (how > 0) {
        now = added(now, sub, c, p, zero, items, how == 2, quick, adding);
      }
    }
    return now;
  }
  let mode = t.mode(k);
  let hash = t.hash_hex(k);
  let change = if (adding) { Change { status: b'A', path: path, old_mode: "", new_mode: mode, old_hash: zero, new_hash: hash, old_path: path, score: 0 } } else { Change { status: b'D', path: path, old_mode: mode, new_mode: "", old_hash: hash, new_hash: zero, old_path: path, score: 0 } };
  return Diffed { store: d.store, changes: d.changes.append(change) };
}

// The differences between the trees `a` and `b` ("" for no tree) whose
// path is `base`, for the entries in the pathspec `items`.
pub function diff_trees(d: Diffed, a: string, b: string, base: u8[], items: string[], all: boolean, quick: boolean): Diffed {
  let zero = "0".repeat(2 * d.store.width);
  let (s1, left) = entries_of(d.store, a);
  let (s2, right) = entries_of(s1, b);
  let now = Diffed { store: s2, changes: d.changes };
  let i = 0;
  let j = 0;
  let nl = left.count();
  let nr = right.count();
  while (i < nl || j < nr) {
    if (quick && now.changes.len() > 0) {
      return now;
    }
    let c = if (i >= nl) { 1 } else if (j >= nr) { -1 } else { entry_cmp(left, i, right, j) };
    if (c == 0 && objects.same_entry(left, i, right, j)) {
      i += 1;
      j += 1;
      continue;
    }
    let path = if (c <= 0) { base.concat(left.entry_name(i)) } else { base.concat(right.entry_name(j)) };
    let tree = if (c <= 0) { left.is_tree(i) || c == 0 && right.is_tree(j) } else { right.is_tree(j) };
    let how = if (all) { 2 } else { interesting(items, path, tree) };
    if (how == 0) {
      if (c <= 0) {
        i += 1;
      }
      if (c >= 0) {
        j += 1;
      }
      continue;
    }
    if (c < 0) {
      now = added(now, left, i, path, zero, items, how == 2, quick, false);
      i += 1;
    } else if (c > 0) {
      now = added(now, right, j, path, zero, items, how == 2, quick, true);
      j += 1;
    } else {
      let lt = left.is_tree(i);
      let rt = right.is_tree(j);
      if (lt && rt) {
        now = diff_trees(now, left.hash_hex(i), right.hash_hex(j), path.append(b'/'), items, how == 2, quick);
      } else if (lt != rt) {
        now = added(now, left, i, path, zero, items, how == 2, quick, false);
        now = added(now, right, j, path, zero, items, how == 2, quick, true);
      } else {
        let lm = left.mode(i);
        let rm = right.mode(j);
        let kind = mode_kind(lm) != mode_kind(rm);
        now = Diffed { store: now.store, changes: now.changes.append(Change { status: if (kind) { b'T' } else { b'M' }, path: path, old_mode: lm, new_mode: rm, old_hash: left.hash_hex(i), new_hash: right.hash_hex(j), old_path: path, score: 0 }) };
      }
      i += 1;
      j += 1;
    }
  }
  return now;
}

// The kind of a file of a mode: a file, a link or a commit.
function mode_kind(mode: string): i32 {
  if (mode == "120000") {
    return 1;
  }
  if (mode == "160000") {
    return 2;
  }
  return 0;
}

// The differences between the trees `a` and `b` for the pathspec `items`.
pub function changes(s: store.Store, a: string, b: string, items: string[]): (store.Store, Change[]) {
  let d = diff_trees(Diffed { store: s, changes: [] }, a, b, [], items, items.len() == 0, false);
  return (d.store, d.changes);
}

// True if the trees `a` and `b` differ in the pathspec `items`.
pub function differ(s: store.Store, a: string, b: string, items: string[]): (store.Store, boolean) {
  if (a == b) {
    return (s, false);
  }
  let d = diff_trees(Diffed { store: s, changes: [] }, a, b, [], items, items.len() == 0, true);
  return (d.store, d.changes.len() > 0);
}

// ---- Renames (diffcore-rename.c and diffcore-delta.c of git) ----

// The score of a rename: 60000 is a file with no change.
const MAX_SCORE: i32 = 60000;

const MIN_SCORE: i32 = 30000;

// The most sources and destinations on each side of the comparison of
// contents: 1000 by 1000.
const RENAME_LIMIT: i64 = 1000;

// The bytes of a blob, the counts of its spans by hash, and its size.
struct Blob { bytes: u8[], spans: Map[i32, i64], counted: boolean, read: boolean }

// The counts of the spans of `b`: each span ends at a line end or after
// 64 bytes, and its hash is that of `hash_chars` of git. A CR before a LF
// is not counted in a text.
function spans_of(b: u8[]): Map[i32, i64] {
  let text = true;
  let n8000 = b.len().min(8000);
  for i in 0..n8000 {
    if (b[i] == 0) {
      text = false;
    }
  }
  let spans: Map[i32, i64] = Map { };
  let accum1: i64 = 0;
  let accum2: i64 = 0;
  let n = 0;
  let i = 0;
  while (i < b.len()) {
    let c = b[i] as i64;
    i += 1;
    if (text && c == 13 && i < b.len() && b[i] == b'\n') {
      continue;
    }
    let old1 = accum1;
    accum1 = (accum1 << 7 ^ accum2 >> 25) & 4294967295;
    accum2 = (accum2 << 7 ^ old1 >> 25) & 4294967295;
    accum1 = accum1 + c & 4294967295;
    n += 1;
    if (n < 64 && c != 10) {
      continue;
    }
    let hashval = (accum1 + accum2 * 97 & 4294967295) % 107927;
    let key = hashval as i32;
    spans = spans.insert(key, spans.get_or(key, 0) + n as i64);
    n = 0;
    accum1 = 0;
    accum2 = 0;
  }
  return spans;
}

// The bytes that `dst` copies from `src`: `diffcore_count_changes` of git.
function copied(src: Map[i32, i64], dst: Map[i32, i64]): i64 {
  let total: i64 = 0;
  for e in src.entries() {
    let (key, sc) = e;
    let dc = dst.get_or(key, 0);
    total += if (sc < dc) { sc } else { dc };
  }
  return total;
}

function is_regular(mode: string): boolean {
  return mode == "100644" || mode == "100755";
}

// The blobs of the pairs, read the first time that a score needs them.
struct Renames { store: store.Store, blobs: Map[string, Blob] }

function blob_of(r: Renames, hash: string): (Renames, Blob) {
  if let Some(b) = r.blobs.get(hash) {
    if (b.counted) {
      return (r, b);
    }
  }
  let got = store.read(r.store, hash);
  let bytes: u8[] = match (got.object) {
    Ok(o) => o.body,
    Err(_) => [],
  };
  let b = Blob { bytes: bytes, spans: spans_of(bytes), counted: true, read: true };
  return (Renames { store: got.store, blobs: r.blobs.insert(hash, b) }, b);
}

function size_of(r: Renames, hash: string): (Renames, i64) {
  let got = store.info(r.store, hash);
  return (Renames { ...r, store: got.store }, got.size);
}

// The score of the rename of `src` to `dst`: the part of the larger blob
// that the copied spans make, as `estimate_similarity` of git gives it.
function similarity(r_in: Renames, src: Change, dst: Change, minimum: i32): (Renames, i32) {
  let r = r_in;
  if (!is_regular(src.old_mode) || !is_regular(dst.new_mode)) {
    return (r, 0);
  }
  let (r1, ss) = size_of(r, src.old_hash);
  let (r2, ds) = size_of(r1, dst.new_hash);
  r = r2;
  let max_size = if (ss > ds) { ss } else { ds };
  let base_size = if (ss < ds) { ss } else { ds };
  let delta = max_size - base_size;
  if (max_size * ((MAX_SCORE - minimum) as i64) < delta * (MAX_SCORE as i64)) {
    return (r, 0);
  }
  if (ds == 0) {
    return (r, 0);
  }
  let (r3, sb) = blob_of(r, src.old_hash);
  let (r4, db) = blob_of(r3, dst.new_hash);
  let c = copied(sb.spans, db.spans);
  return (r4, (c as f64 * 60000.0 / (max_size as f64)) as i32);
}

// True if the last parts of the two paths are the same.
function basename_same(a: u8[], b: u8[]): boolean {
  let i = a.len();
  let j = b.len();
  while (i > 0 && j > 0) {
    i -= 1;
    j -= 1;
    if (a[i] != b[j]) {
      return false;
    }
    if (a[i] == b'/') {
      return true;
    }
  }
  return (i == 0 || a[i - 1] == b'/') && (j == 0 || b[j - 1] == b'/');
}

function basename(p: u8[]): string {
  let i = p.len();
  while (i > 0 && p[i - 1] != b'/') {
    i -= 1;
  }
  return unsafe { string_from_bytes_unchecked(array.slice(p, i, p.len())) };
}

// A candidate source for a destination.
struct Candidate { dst: i32, src: i32, score: i32, name: i32 }

// The order of two candidates: the higher score first, and the same last
// part of the path first.
function candidate_cmp(a: Candidate, b: Candidate): i32 {
  if (a.dst < 0) {
    return if (b.dst >= 0) { 1 } else { 0 };
  }
  if (b.dst < 0) {
    return -1;
  }
  if (a.score == b.score) {
    return b.name - a.name;
  }
  return b.score - a.score;
}

// The changes with each rename found: a deleted file and an added file
// with the same or a similar content become one change `R` at the place
// of the added file, with the score of the rename.
pub function renames(s: store.Store, changes: Change[]): (store.Store, Change[]) {
  return find_renames(s, changes, true, MIN_SCORE);
}

// The renames and copies of `changes` for `--follow`: the sources may be
// files that stay, so the search of the same last part of a path does not
// run, as in git when it finds copies.
pub function copies(s: store.Store, changes: Change[]): (store.Store, Change[]) {
  return find_renames(s, changes, false, MIN_SCORE);
}

// The search of renames and copies that the options select: `-M`, `-C`,
// `--find-copies-harder`, and the least score of a pair.
pub struct Detect { copies: boolean, harder: boolean, min_score: i32 }

pub function detect_default(): Detect {
  return Detect { copies: false, harder: false, min_score: MIN_SCORE };
}

// The score of `-M<n>` and `-C<n>`: a fraction of the digits, or a
// percent, as `parse_rename_score` of git reads it, and the rest of
// the text after it.
pub function parse_score(text: string): (i32, string) {
  let num: i64 = 0;
  let scale: i64 = 1;
  let dot = false;
  let i = 0;
  while (i < text.len()) {
    let ch = text[i];
    if (!dot && ch == b'.') {
      scale = 1;
      dot = true;
    } else if (ch == b'%') {
      scale = if (dot) { scale * 100 } else { 100 };
      i += 1;
      break;
    } else if (ch >= b'0' && ch <= b'9') {
      if (scale < 100000) {
        scale *= 10;
        num = num * 10 + (ch - b'0') as i64;
      }
    } else {
      break;
    }
    i += 1;
  }
  let score = if (num >= scale) { MAX_SCORE } else { (MAX_SCORE as i64 * num / scale) as i32 };
  return (score, unsafe { string_from_bytes_unchecked(array.slice(text.bytes(), i, text.len())) });
}

// The changes from the tree `base` with the renames, or with the renames
// and the copies of `d`. With `harder`, each file of `base` that does not
// change is also a source of a copy.
pub function detect(s_in: store.Store, found: Change[], d: Detect, base: string, items: string[]): (store.Store, Change[]) {
  if (!d.copies) {
    return find_renames(s_in, found, true, d.min_score);
  }
  let s = s_in;
  let queue = found;
  if (d.harder && base.len() > 0) {
    let (s1, all) = changes(s, "", base, items);
    s = s1;
    let changed: Map[string, boolean] = Map { };
    for c in found {
      if (c.status != b'A') {
        changed = changed.insert(unsafe { string_from_bytes_unchecked(c.path) }, true);
      }
    }
    let same: Change[] = [];
    for c in all {
      if (!changed.contains(unsafe { string_from_bytes_unchecked(c.path) })) {
        same = same.append(Change { ...c, status: b'=', old_mode: c.new_mode, old_hash: c.new_hash, old_path: c.path });
      }
    }
    queue = merged(found, same);
  }
  return find_copies(s, queue, d.min_score);
}

function path_less(a: u8[], b: u8[]): boolean {
  let n = a.len().min(b.len());
  for i in 0..n {
    if (a[i] != b[i]) {
      return a[i] < b[i];
    }
  }
  return a.len() < b.len();
}

// The changes of `a` and of `b` in the order of their paths.
function merged(a: Change[], b: Change[]): Change[] {
  let out: Change[] = [];
  let i = 0;
  let j = 0;
  while (i < a.len() || j < b.len()) {
    if (j >= b.len() || i < a.len() && path_less(a[i].path, b[j].path)) {
      out = out.append(a[i]);
      i += 1;
    } else {
      out = out.append(b[j]);
      j += 1;
    }
  }
  return out;
}

// The renames and the copies of `queue`, whose changes of status `=` are
// files that stay the same: `diffcore_rename` of git with
// `DIFF_DETECT_COPY`. Each file that stays or changes is a source of a
// copy, and a deleted file is the source of a rename for its last
// destination and of a copy for the others.
function find_copies(s: store.Store, queue: Change[], min_score: i32): (store.Store, Change[]) {
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let used = __alloc_i32(queue.len());
  for i in 0..queue.len() {
    let c = queue[i];
    if (c.status == b'A') {
      dsts = dsts.append(i);
    } else {
      srcs = srcs.append(i);
      if (c.status != b'D') {
        used = used.with(i, 1);
      }
    }
  }
  let source_of = __alloc_i32(queue.len()).map((v: i32): i32 => -1);
  let score_of = __alloc_i32(queue.len());
  let r = Renames { store: s, blobs: Map { } };
  if (srcs.len() > 0 && dsts.len() > 0) {
    // Exact copies: the same blob, a source not used yet first.
    for d in dsts {
      let dst = queue[d];
      let best = -1;
      let best_score = -1;
      for k in srcs {
        let src = queue[k];
        let modes_ok = is_regular(src.old_mode) && is_regular(dst.new_mode) || src.old_mode == dst.new_mode;
        if (best_score < 2 && src.old_hash == dst.new_hash && modes_ok) {
          let sc = (if (used[k] == 0) { 1 } else { 0 }) + (if (basename_same(src.path, dst.path)) { 1 } else { 0 });
          if (sc > best_score) {
            best = k;
            best_score = sc;
          }
        }
      }
      if (best >= 0) {
        source_of = source_of.with(d, best);
        score_of = score_of.with(d, MAX_SCORE);
        used = used.with(best, used[best] + 1);
      }
    }
    let left = dsts.filter((d: i32): boolean => source_of[d] < 0);
    if (left.len() > 0 && left.len() as i64 * (srcs.len() as i64) <= RENAME_LIMIT * RENAME_LIMIT) {
      let all: Candidate[] = [];
      for d in left {
        let (r2, best) = candidates_of(r, queue, srcs, d, min_score);
        r = r2;
        all = all.concat(best);
      }
      let places: i32[] = [];
      for i in 0..all.len() {
        places = places.append(i);
      }
      let order = cmp.sort_by(places, (a: i32, b: i32): i32 => if (candidate_cmp(all[a], all[b]) != 0) { candidate_cmp(all[a], all[b]) } else { a - b });
      // The first pass takes the sources that no pair uses, the second
      // pass any source.
      for pass in 0..2 {
        for i in order {
          let c = all[i];
          if (c.dst < 0 || c.score < min_score) {
            break;
          }
          if (source_of[c.dst] < 0 && (pass == 1 || used[c.src] == 0)) {
            source_of = source_of.with(c.dst, c.src);
            score_of = score_of.with(c.dst, c.score);
            used = used.with(c.src, used[c.src] + 1);
          }
        }
      }
    }
  }
  // The status of a pair comes after the pairs: each use of a source
  // but the last is a copy (`diff_resolve_rename_copy` of git).
  let left_uses = used;
  let out: Change[] = [];
  for i in 0..queue.len() {
    let c = queue[i];
    if (c.status == b'A' && source_of[i] >= 0) {
      let k = source_of[i];
      let src = queue[k];
      left_uses = left_uses.with(k, left_uses[k] - 1);
      out = out.append(Change { ...c, status: if (left_uses[k] > 0) { b'C' } else { b'R' }, old_path: src.path, old_mode: src.old_mode, old_hash: src.old_hash, score: score_of[i] });
    } else if (c.status != b'=' && !(c.status == b'D' && used[i] != 0)) {
      out = out.append(c);
    }
  }
  return (r.store, out);
}

// The order in which a `strmap` of git gives the keys `keys`, which it
// got in that order, and the count of the places of its table after
// them. The table starts with `places` places (64 for a new table) and
// grows by 4. The last key of a place comes first.
pub function strmap_order(keys: string[], places: i32): (string[], i32) {
  let size = places;
  let hashes: i64[] = [];
  let table: i32[][] = [];
  for b in 0..size {
    table = table.append([]);
  }
  for k in 0..keys.len() {
    let h: i64 = 2166136261;
    for c in keys[k].bytes() {
      h = h * 16777619 & 4294967295 ^ c as i64;
    }
    hashes = hashes.append(h);
    let b = (h & (size - 1) as i64) as i32;
    table = table.with(b, [k].concat(table[b]));
    if (k + 1 > size * 80 / 100) {
      let wide = size * 4;
      let next: i32[][] = [];
      for b2 in 0..wide {
        next = next.append([]);
      }
      for bucket in table {
        for e in bucket {
          let nb = (hashes[e] & (wide - 1) as i64) as i32;
          next = next.with(nb, [e].concat(next[nb]));
        }
      }
      table = next;
      size = wide;
    }
  }
  let out: string[] = [];
  for bucket in table {
    for e in bucket {
      out = out.append(keys[e]);
    }
  }
  return (out, size);
}

// The values of a directory that one side of a merge removed
// (`dirs_removed` of git): its rename is not needed, is needed for a
// directory above it, or is needed for the directory.
pub const DIR_NOT_RELEVANT: i32 = 0;

pub const DIR_FOR_ANCESTOR: i32 = 1;

pub const DIR_FOR_SELF: i32 = 2;

// The values of a source of a rename in a merge (`relevant_sources` of
// git): the other side changed its content, or only its place counts.
pub const SOURCE_NO_MORE: i32 = 0;

pub const SOURCE_CONTENT: i32 = 1;

pub const SOURCE_LOCATION: i32 = 2;

// The sources that a merge needs, and the directories that the side
// removed. A source that is not in `relevant` gets only an exact rename.
pub struct Scope { relevant: Map[string, i32], dirs_removed: Map[string, i32] }

// The count of the renames from one directory to each new directory,
// with the new directories in the order of their first rename.
struct Counts { dirs: string[], count: Map[string, i32] }

// The count of the renames from the removed directory `dir` to each
// directory of `targets`.
pub struct DirCount { dir: string, targets: string[], counts: i32[] }

// The counts for each old directory (`dir_rename_count` of git), and the
// values of the removed directories.
struct DirRenames { on: boolean, removed: Map[string, i32], counts: Map[string, Counts] }

// The directory that no rename gives yet (`UNKNOWN_DIR` of git).
const UNKNOWN_DIR: string = "/";

function text_of(p: u8[]): string {
  return unsafe { string_from_bytes_unchecked(p) };
}

// The path above `path`, or "" at the top.
pub function dir_of(path: string): string {
  let i = path.len();
  while (i > 0 && path[i - 1] != b'/') {
    i -= 1;
  }
  return if (i == 0) { "" } else { objects.part(path, 0, i - 1) };
}

function counted(d: DirRenames, old_dir: string, new_dir: string): DirRenames {
  let c = d.counts.get_or(old_dir, Counts { dirs: [], count: Map { } });
  let dirs = if (c.count.contains(new_dir)) { c.dirs } else { c.dirs.append(new_dir) };
  return DirRenames { ...d, counts: d.counts.insert(old_dir, Counts { dirs: dirs, count: c.count.insert(new_dir, c.count.get_or(new_dir, 0) + 1) }) };
}

// Counts the rename of `old` to `new` for the removed directories above
// `old` (`update_dir_rename_counts` of git).
function count_rename(d_in: DirRenames, old: string, new: string): DirRenames {
  let d = d_in;
  if (!d.on) {
    return d;
  }
  let old_dir = old;
  let new_dir = new;
  let first = true;
  while (true) {
    let old_part = old_dir;
    old_dir = dir_of(old_dir);
    if (!d.removed.contains(old_dir)) {
      break;
    }
    let new_part = new_dir;
    new_dir = dir_of(new_dir);
    if (!first && objects.part(old_part, if (old_dir.len() > 0) { old_dir.len() + 1 } else { 0 }, old_part.len()) != objects.part(new_part, if (new_dir.len() > 0) { new_dir.len() + 1 } else { 0 }, new_part.len())) {
      break;
    }
    let value = d.removed.get_or(old_dir, DIR_NOT_RELEVANT);
    if (value == DIR_FOR_SELF || first) {
      d = counted(d, old_dir, new_dir);
    }
    first = false;
    if (value == DIR_NOT_RELEVANT || old_dir.len() == 0 || new_dir.len() == 0) {
      break;
    }
  }
  return d;
}

// The new directory with the most renames, the first of them in the
// order of git (`get_highest_rename_path`).
function highest(c: Counts): string {
  let best = "";
  let most = 0;
  let (order, _) = strmap_order(c.dirs, 64);
  for dir in order {
    let n = c.count.get_or(dir, 0);
    if (n > most) {
      most = n;
      best = dir;
    }
  }
  return best;
}

// True when more renames cannot change the new directory with the most
// renames (`dir_rename_already_determinable` of git).
function determinable(c: Counts): boolean {
  let first = 0;
  let second = 0;
  let unknown = 0;
  for dir in c.dirs {
    let n = c.count.get_or(dir, 0);
    if (dir == UNKNOWN_DIR) {
      unknown = n;
    } else if (n >= first) {
      second = first;
      first = n;
    } else if (n >= second) {
      second = n;
    }
  }
  return first > second + unknown;
}

// The options of the search of renames. `basenames` compares first the
// files with the same last part of their path. `limit` is the most
// sources and destinations on each side of the comparison of contents.
// Without `empty`, an empty blob is no source and no destination. `scope`
// holds the parts of a merge, or nothing.
struct Search { basenames: boolean, min_score: i32, limit: i64, empty: boolean, scope: Scope[] }

// The source of each added change, or -1, with its score. `used` is 1
// for each source of a rename. `dir_counts` holds the renames from each
// removed directory that a merge needs. `limited`
// is true when the files are too many for the comparison of contents.
// `relevant` holds the sources of a merge after the search.
struct Paired { store: store.Store, source_of: i32[], score_of: i32[], used: i32[], dir_counts: DirCount[], limited: boolean, relevant: Map[string, i32] }

// The best four sources of the destination `d` among `srcs`
// (`record_if_better` of git).
function candidates_of(r_in: Renames, changes: Change[], srcs: i32[], d: i32, min_score: i32): (Renames, Candidate[]) {
  let r = r_in;
  let best: Candidate[] = [Candidate { dst: -1, src: -1, score: 0, name: 0 }, Candidate { dst: -1, src: -1, score: 0, name: 0 }, Candidate { dst: -1, src: -1, score: 0, name: 0 }, Candidate { dst: -1, src: -1, score: 0, name: 0 }];
  for k in srcs {
    let (r2, sc) = similarity(r, changes[k], changes[d], min_score);
    r = r2;
    let c = Candidate { dst: d, src: k, score: sc, name: if (basename_same(changes[k].path, changes[d].path)) { 1 } else { 0 } };
    let worst = 0;
    for i in 1..4 {
      if (candidate_cmp(best[i], best[worst]) > 0) {
        worst = i;
      }
    }
    if (candidate_cmp(best[worst], c) > 0) {
      best = best.with(worst, c);
    }
  }
  return (r, best);
}

// The renames of the deleted and the added changes of `changes`:
// `diffcore_rename_extended` of git without copies.
function pair(s: store.Store, changes: Change[], o: Search): Paired {
  let empty_blob = objects.hash_of(s.width, "blob", []);
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  for i in 0..changes.len() {
    let c = changes[i];
    if (c.status == b'D' && (o.empty || c.old_hash != empty_blob)) {
      srcs = srcs.append(i);
    } else if (c.status == b'A' && (o.empty || c.new_hash != empty_blob)) {
      dsts = dsts.append(i);
    }
  }
  let source_of = __alloc_i32(changes.len()).map((v: i32): i32 => -1);
  let score_of = __alloc_i32(changes.len());
  let used = __alloc_i32(changes.len());
  if (srcs.len() == 0 || dsts.len() == 0) {
    return Paired { store: s, source_of: source_of, score_of: score_of, used: used, dir_counts: [], limited: false, relevant: if (o.scope.len() > 0) { o.scope[0].relevant } else { Map { } } };
  }
  let r = Renames { store: s, blobs: Map { } };
  // Exact renames: the same blob. git looks at 100 sources at most.
  for d in dsts {
    let dst = changes[d];
    let best = -1;
    let best_score = -1;
    let left = 100;
    for k in srcs {
      let src = changes[k];
      let modes_ok = is_regular(src.old_mode) && is_regular(dst.new_mode) || src.old_mode == dst.new_mode;
      if (left > 0 && best_score < 2 && src.old_hash == dst.new_hash && modes_ok && used[k] == 0) {
        let sc = 1 + (if (basename_same(src.path, dst.path)) { 1 } else { 0 });
        if (sc > best_score) {
          best = k;
          best_score = sc;
        }
        left -= 1;
      }
    }
    if (best >= 0) {
      source_of = source_of.with(d, best);
      score_of = score_of.with(d, MAX_SCORE);
      used = used.with(best, 1);
    }
  }
  let dirs = DirRenames { on: false, removed: Map { }, counts: Map { } };
  let relevant: Map[string, i32] = Map { };
  let merge = o.scope.len() > 0;
  if (merge) {
    dirs = DirRenames { on: true, removed: o.scope[0].dirs_removed, counts: Map { } };
    relevant = o.scope[0].relevant;
  }
  if (o.min_score < MAX_SCORE && o.basenames) {
    srcs = srcs.filter((k: i32): boolean => used[k] == 0);
    // The place of each destination with no source, and the new place of
    // each removed directory, from the exact renames
    // (`initialize_dir_rename_info`).
    let places: Map[string, i32] = Map { };
    let guess: Map[string, string] = Map { };
    if (merge) {
      for d in dsts {
        if (source_of[d] < 0) {
          places = places.insert(text_of(changes[d].path), d);
        } else {
          dirs = count_rename(dirs, text_of(changes[source_of[d]].path), text_of(changes[d].path));
        }
      }
      for e in dirs.counts.entries() {
        let (old_dir, c) = e;
        guess = guess.insert(old_dir, highest(c));
      }
    }
    // Renames to a file with the same last part of its path.
    let src_names: Map[string, i32] = Map { };
    for k in srcs {
      let base = basename(changes[k].path);
      src_names = src_names.insert(base, if (src_names.contains(base)) { -1 } else { k });
    }
    let dst_names: Map[string, i32] = Map { };
    for d in dsts {
      if (source_of[d] < 0) {
        let base = basename(changes[d].path);
        dst_names = dst_names.insert(base, if (dst_names.contains(base)) { -1 } else { d });
      }
    }
    let min_basename = o.min_score + (0.5 * ((MAX_SCORE - o.min_score) as f64)) as i32;
    for k in srcs {
      let path = text_of(changes[k].path);
      if (merge && !relevant.contains(path)) {
        continue;
      }
      let base = basename(changes[k].path);
      if (!dst_names.contains(base)) {
        continue;
      }
      let d = dst_names.get_or(base, -1);
      if (src_names.get_or(base, -1) == -1 || d == -1) {
        // The file of the same name in the new place of its directory
        // (`idx_possible_rename`).
        d = -1;
        if let Some(new_dir) = guess.get(dir_of(path)) {
          d = places.get_or(new_dir + "/" + base, -1);
        }
      }
      if (d == -1 || source_of[d] >= 0) {
        continue;
      }
      let (r1, sc) = similarity(r, changes[k], changes[d], min_basename);
      r = r1;
      if (sc >= min_basename) {
        source_of = source_of.with(d, k);
        score_of = score_of.with(d, sc);
        used = used.with(k, 1);
        dirs = count_rename(dirs, path, text_of(changes[d].path));
      }
    }
    srcs = srcs.filter((k: i32): boolean => used[k] == 0 && (!merge || relevant.contains(text_of(changes[k].path))));
    if (merge) {
      // A source that only gives the place of a removed directory is not
      // needed when the place is sure (`handle_early_known_dir_renames`).
      for k in srcs {
        let old_dir = dir_of(text_of(changes[k].path));
        while (old_dir.len() > 0 && dirs.removed.get_or(old_dir, DIR_NOT_RELEVANT) != DIR_NOT_RELEVANT) {
          dirs = counted(dirs, old_dir, UNKNOWN_DIR);
          old_dir = dir_of(old_dir);
        }
      }
      for e in dirs.counts.entries() {
        let (old_dir, c) = e;
        if (dirs.removed.get_or(old_dir, DIR_NOT_RELEVANT) == DIR_FOR_SELF && determinable(c)) {
          dirs = DirRenames { ...dirs, removed: dirs.removed.insert(old_dir, DIR_FOR_ANCESTOR) };
        }
      }
      let needed: i32[] = [];
      for k in srcs {
        let path = text_of(changes[k].path);
        let removable = relevant.get_or(path, SOURCE_NO_MORE) == SOURCE_LOCATION;
        let dir = dir_of(path);
        while (removable) {
          let value = dirs.removed.get_or(dir, DIR_NOT_RELEVANT);
          if (value == DIR_NOT_RELEVANT) {
            break;
          }
          if (value == DIR_FOR_SELF) {
            removable = false;
          }
          dir = dir_of(dir);
        }
        if (removable) {
          relevant = relevant.insert(path, SOURCE_NO_MORE);
        } else {
          needed = needed.append(k);
        }
      }
      srcs = needed;
    }
  } else {
    srcs = srcs.filter((k: i32): boolean => used[k] == 0);
  }
  let left = dsts.filter((d: i32): boolean => source_of[d] < 0);
  let compare = o.min_score < MAX_SCORE && srcs.len() > 0 && left.len() > 0;
  let limited = compare && left.len() as i64 * (srcs.len() as i64) > o.limit * o.limit;
  if (compare && !limited) {
    let all: Candidate[] = [];
    for d in left {
      let (r2, best) = candidates_of(r, changes, srcs, d, o.min_score);
      r = r2;
      all = all.concat(best);
    }
    let places: i32[] = [];
    for i in 0..all.len() {
      places = places.append(i);
    }
    let order = cmp.sort_by(places, (a: i32, b: i32): i32 => if (candidate_cmp(all[a], all[b]) != 0) { candidate_cmp(all[a], all[b]) } else { a - b });
    let stop = false;
    for i in order {
      let c = all[i];
      if (!stop) {
        if (c.dst < 0 || c.score < o.min_score) {
          stop = true;
        } else if (source_of[c.dst] < 0 && used[c.src] == 0) {
          source_of = source_of.with(c.dst, c.src);
          score_of = score_of.with(c.dst, c.score);
          used = used.with(c.src, 1);
          dirs = count_rename(dirs, text_of(changes[c.src].path), text_of(changes[c.dst].path));
        }
      }
    }
  }
  // The counts of the removed directories that a merge needs
  // (`cleanup_dir_rename_info`).
  let dir_counts: DirCount[] = [];
  for e in dirs.counts.entries() {
    let (old_dir, c) = e;
    if (dirs.removed.get_or(old_dir, DIR_NOT_RELEVANT) != DIR_NOT_RELEVANT) {
      let targets = c.dirs.filter((dir: string): boolean => dir != UNKNOWN_DIR);
      dir_counts = dir_counts.append(DirCount { dir: old_dir, targets: targets, counts: targets.map((dir: string): i32 => c.count.get_or(dir, 0)) });
    }
  }
  return Paired { store: r.store, source_of: source_of, score_of: score_of, used: used, dir_counts: dir_counts, limited: limited, relevant: relevant };
}

// The changes with each pair of `p` as one rename at the place of its
// added file.
function with_renames(changes: Change[], p: Paired): Change[] {
  let out: Change[] = [];
  for i in 0..changes.len() {
    let c = changes[i];
    if (c.status == b'A' && p.source_of[i] >= 0) {
      let src = changes[p.source_of[i]];
      out = out.append(Change { ...c, status: b'R', old_path: src.path, old_mode: src.old_mode, old_hash: src.old_hash, score: p.score_of[i] });
    } else if (!(c.status == b'D' && p.used[i] != 0)) {
      out = out.append(c);
    }
  }
  return out;
}

function find_renames(s: store.Store, changes: Change[], basenames: boolean, min_score: i32): (store.Store, Change[]) {
  let p = pair(s, changes, Search { basenames: basenames, min_score: min_score, limit: RENAME_LIMIT, empty: true, scope: [] });
  return (p.store, with_renames(changes, p));
}

// The renames of one side of a merge. `dir_counts` holds the renames
// from each removed directory that the merge needs. `limited` is true when the files are too many for the comparison of
// contents. `relevant` holds the sources that the merge needs after the
// search.
pub struct MergeRenames { store: store.Store, changes: Change[], dir_counts: DirCount[], limited: boolean, relevant: Map[string, i32] }

// The renames of one side of a merge, whose deleted and added files are
// `changes`: `detect_regular_renames` of merge-ort. `limit` is
// `merge.renameLimit`.
pub function merge_renames(s: store.Store, changes: Change[], limit: i64, scope: Scope): MergeRenames {
  let p = pair(s, changes, Search { basenames: true, min_score: MIN_SCORE, limit: limit, empty: false, scope: [scope] });
  return MergeRenames { store: p.store, changes: with_renames(changes, p), dir_counts: p.dir_counts, limited: p.limited, relevant: p.relevant };
}
