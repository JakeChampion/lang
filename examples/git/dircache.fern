// The index file of a repository (`.git/index`, the "dircache"), versions
// 2 to 4: one entry for each path and stage, in the order of the paths.
//
// An entry has 40 bytes of file data (times, device, inode, mode, user,
// group and size), the name of the object, 2 bytes of flags with the stage
// and the length of the path, and the path. Version 3 adds 2 bytes of
// flags when the extended bit is set. Version 4 keeps only the end of each
// path: a count of bytes to take off the path before it, and the rest.
import "std/array";
import "std/hex";
import "./objects";

pub struct Entry { path: u8[], stage: i32, mode: i32, hash: string }

pub struct Index { entries: Entry[] }

function be32(b: u8[], at: i32): i32 {
  return b[at] as i32 << 24 | b[at + 1] as i32 << 16 | b[at + 2] as i32 << 8 | b[at + 3] as i32;
}

// The entries of the index file `path`, or no entry when there is no
// sound file.
pub function read(path: string, a: i32): Index {
  let Ok(b) = read_file_bytes(path) else {
    return Index { entries: [] };
  };
  return parse(b, a);
}

pub function parse(b: u8[], a: i32): Index {
  let none = Index { entries: [] };
  if (b.len() < 12 || b[0] != b'D' || b[1] != b'I' || b[2] != b'R' || b[3] != b'C') {
    return none;
  }
  let version = be32(b, 4);
  if (version < 2 || version > 4) {
    return none;
  }
  let count = be32(b, 8);
  let raw = a;
  let entries: Entry[] = [];
  let at = 12;
  let last: u8[] = [];
  for k in 0..count {
    let start = at;
    if (at + 40 + raw + 2 > b.len()) {
      return none;
    }
    let mode = be32(b, at + 24);
    let hash = hex.encode(array.slice(b, at + 40, at + 40 + raw));
    let flags = b[at + 40 + raw] as i32 << 8 | b[at + 41 + raw] as i32;
    at += 42 + raw;
    if ((flags & 16384) != 0 && version >= 3) {
      at += 2;
    }
    let path: u8[] = [];
    if (version == 4) {
      let drop = 0;
      let shift = 0;
      let c = 128;
      // The count is a number of git's "offset" form: 7 bits for each
      // byte, the high bits first, and one added for each byte after the
      // first.
      drop = 0;
      let first = true;
      while ((c & 128) != 0) {
        if (at >= b.len()) {
          return none;
        }
        c = b[at] as i32;
        at += 1;
        if (first) {
          drop = c & 127;
          first = false;
        } else {
          drop = drop + 1 << 7 | c & 127;
        }
      }
      let end = at;
      while (end < b.len() && b[end] != 0) {
        end += 1;
      }
      if (drop > last.len() || end >= b.len()) {
        return none;
      }
      path = array.slice(last, 0, last.len() - drop).concat(array.slice(b, at, end));
      at = end + 1;
      shift = 0;
    } else {
      let end = at;
      while (end < b.len() && b[end] != 0) {
        end += 1;
      }
      if (end >= b.len()) {
        return none;
      }
      path = array.slice(b, at, end);
      // The entry has 1 to 8 bytes of zeros after the path, to a
      // multiple of 8 bytes from its start.
      let size = end - start;
      at = start + (size + 8) / 8 * 8;
    }
    last = path;
    entries = entries.append(Entry { path: path, stage: flags >> 12 & 3, mode: mode, hash: hash });
  }
  return Index { entries: entries };
}

function compare(a: u8[], b: u8[]): i32 {
  let n = a.len().min(b.len());
  for i in 0..n {
    if (a[i] != b[i]) {
      return if (a[i] < b[i]) { -1 } else { 1 };
    }
  }
  return if (a.len() < b.len()) { -1 } else if (a.len() > b.len()) { 1 } else { 0 };
}

// The place of the first entry of the path `path`, or of the entry after
// where it would be.
pub function first_of(ix: Index, path: u8[]): i32 {
  let lo = 0;
  let hi = ix.entries.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    if (compare(ix.entries[mid].path, path) < 0) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

// True if the entry at `i` has the path `path`.
pub function has_path(ix: Index, i: i32, path: u8[]): boolean {
  return i < ix.entries.len() && compare(ix.entries[i].path, path) == 0;
}

// The entry of `path` at `stage`, or None. A sparse directory has no
// entry.
pub function find(ix: Index, path: u8[], stage: i32): Option[Entry] {
  let i = first_of(ix, path);
  while (has_path(ix, i, path)) {
    let e = ix.entries[i];
    if (e.stage == stage) {
      return if ((e.mode & 61440) == 16384) { None } else { Some(e) };
    }
    i += 1;
  }
  return None;
}
