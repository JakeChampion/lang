  let buf: u8[] = [];
  let sh = Shown { graph: graph.graph_new(o.patch.color), any: false, missing: false, follow: if (o.follow) { items[0] } else { "" }, hidden: false, failed: false, fatal: "" };
  let p = Pull { w: w, skipped: 0, count: 0, candidates: [] };
