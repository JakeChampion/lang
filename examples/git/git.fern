  // and the commits after the current one, for the visual roots of the
  // graph.
  let boundary: string[] = [];
  let at_boundary = false;
  let following: LogItem[] = [];
  while (true) {
    let item = LogItem { hash: "", parents: [] };
    if (at_boundary) {
      if (boundary.len() == 0) {
        break;
      }
      let (w0, b0) = log_item(p.w, boundary[0], o);
      p = Pull { ...p, w: revwalk.with_flag(w0, b0.hash, revwalk.SHOWN) };
      item = b0;
      boundary = array.slice(boundary, 1, boundary.len());
    } else if (following.len() > 0) {
      item = following[0];
      following = array.slice(following, 1, following.len());
    } else {
      let (p1, next) = log_pull(p, o);
      p = p1;
      if (p.w.failed.len() > 0) {
        put(buf);
        return fatal("Failed to traverse parents of commit " + p.w.failed);
      }
      item = next;
      if (item.hash.len() == 0) {
        if (!o.walk.boundary) {
          break;
        }
        at_boundary = true;
        let (w4, sorted) = boundary_commits(p.w, p.candidates);
        p = Pull { ...p, w: w4 };
        boundary = sorted;
        continue;
      }
    }
    let h = item.hash;
    if (o.reverse) {
      shown = shown.append(h);
      continue;
    }
    while (o.graph && !at_boundary && following.len() < 2) {
      let (p1, next) = log_pull(p, o);
      p = p1;
      if (p.w.failed.len() > 0) {
        put(buf);
        return fatal("Failed to traverse parents of commit " + p.w.failed);
      }
      if (next.hash.len() == 0) {
        break;
      }
      following = following.append(next);
    }
    let (w2, text, after) = log_show(p.w, item, o, decorations, least, sh, [], following);
    p = Pull { ...p, w: w2 };
    sh = after;
    // A commit that gives no text does not count for `-n`.
    if (after.hidden && !at_boundary) {
      p = Pull { ...p, count: p.count - 1 };
    }
    buf = buf.concat(text.bytes());
    if (after.fatal.len() > 0) {
      put(buf);
      return fatal(after.fatal);
    }
    if (buf.len() > 65536) {
      put(buf);
      buf = [];
    }
  }
  w = p.w;
  for h in shown.reverse() {
    let (w3, text, after) = log_show(w, LogItem { hash: h, parents: [] }, o, decorations, least, sh, [], []);
    w = w3;
    sh = after;
    buf = buf.concat(text.bytes());
    if (after.fatal.len() > 0) {
      put(buf);
      return fatal(after.fatal);
    }
    if (buf.len() > 65536) {
      put(buf);
      buf = [];
    }
  }
  put(buf);
  return if (sh.failed) { 2 } else { 0 };
}

// ---- index-pack ----

// A packfile with fewer objects has its names from this process only.
const MIN_PARALLEL: i32 = 32;

// The names of the parts from `part`, in order. A worker makes the names
// of each part but the last, which this process makes.
function index_parts(data: string, offsets: i64[], cuts: i32[], part: i32, raw: i32): string[][] {
  let first = cuts[part];
  let end = cuts[part + 1];
  if (part + 2 >= cuts.len()) {
    return [index.names_part(data, offsets, first, end, raw)];
  }
  let w = worker.spawn((): string[] => index.names_part(data, offsets, first, end, raw));
  let rest = index_parts(data, offsets, cuts, part + 1, raw);
  return [w.join()].concat(rest);
}

// The names of the objects of a packfile: one part for each CPU.
function index_names(data: string, offsets: i64[], raw: i32): string[][] {
  let count = offsets.len() - 1;
  let parts = if (worker.parallel() && count >= MIN_PARALLEL) { (cpu_count() as i32).max(1).min(16) } else { 1 };
  return index_parts(data, offsets, index.parts_of(offsets, parts), 0, raw);
}

const INDEX_PACK_USAGE: string = "usage: git index-pack [-v] [-o <index-file>] [--keep | --keep=<msg>] [--[no-]rev-index] [--verify] [--strict[=<msg-id>=<severity>...]] [--fsck-objects[=<msg-id>=<severity>...]] (<pack-file> | --stdin [--fix-thin] [<pack-file>])";

struct PackArgs { verbose: boolean, verify: boolean, stdin: boolean, thin: boolean, rev: boolean, out: string, file: string, keep: string, keeps: boolean, version: i32, limit: i64, format: string, bad: string, checking: checkpack.Policy, failure: string }

// The number at the start of `text` in base 10, or in the base that the C
// function `strtoul` gives for base 0 when `c` is true: 0x for 16 and 0
// for 8. The second value is the place after the digits.
function number_of(text: string, c: boolean): (i64, i32) {
  let base: i64 = 10;
  let i = 0;
  if (c && (text.starts_with("0x") || text.starts_with("0X"))) {
    base = 16;
    i = 2;
  } else if (c && text.starts_with("0")) {
    base = 8;
  }
  let n: i64 = 0;
  while (i < text.len()) {
    let b = text[i];
    let d: i64 = if (b >= b'0' && b <= b'9') { (b - b'0') as i64 } else if (b >= b'a' && b <= b'f') { (b - b'a') as i64 + 10 } else if (b >= b'A' && b <= b'F') { (b - b'A') as i64 + 10 } else { 99 };
    if (d >= base) {
      break;
    }
    n = n * base + d;
    i += 1;
  }
  return (n, i);
}

function pack_args(argv: string[]): PackArgs {
  let a = PackArgs { verbose: false, verify: false, stdin: false, thin: false, rev: true, out: "", file: "", keep: "", keeps: false, version: 2, limit: 2147483647, format: "", bad: "", checking: checkpack.policy(), failure: "" };
  let i = 0;
  while (i < argv.len()) {
    let x = argv[i];
    if (x == "--stdin") {
      a = PackArgs { ...a, stdin: true };
    } else if (x == "-v") {
      a = PackArgs { ...a, verbose: true };
    } else if (x == "--verify") {
      a = PackArgs { ...a, verify: true };
    } else if (x.starts_with("--threads=")) {
      let text = objects.part(x, 10, x.len());
      let (_, used) = number_of(text, false);
      if (text.len() == 0 || used != text.len()) {
        return PackArgs { ...a, bad: "usage" };
      }
    } else if (x == "--strict" || x.starts_with("--strict=") || x == "--fsck-objects" || x.starts_with("--fsck-objects=")) {
      let strict = x == "--strict" || x.starts_with("--strict=");
      let start = if (strict) { 9 } else { 15 };
      let text = if (x.len() >= start) { objects.part(x, start, x.len()) } else { "" };
      let checked = match (checkpack.configure(a.checking, text)) {
        Ok(p) => p,
        Err(e) => { return PackArgs { ...a, failure: e }; },
      };
      a = PackArgs { ...a, checking: checkpack.Policy { ...checked, enabled: true, strict: checked.strict || strict } };
    } else if (x == "--fix-thin") {
      a = PackArgs { ...a, thin: true };
    } else if (x == "--rev-index") {
      a = PackArgs { ...a, rev: true };
    } else if (x == "--no-rev-index") {
      a = PackArgs { ...a, rev: false };
    } else if (x == "--keep" || x.starts_with("--keep=")) {
      a = PackArgs { ...a, keeps: true, keep: if (x.len() > 7) { objects.part(x, 7, x.len()) } else { "" } };
    } else if (x == "-o" && i + 1 < argv.len() && a.out.len() == 0) {
      i += 1;
      a = PackArgs { ...a, out: argv[i] };
    } else if (x.starts_with("--index-version=")) {
      let text = objects.part(x, 16, x.len());
      let (v, after) = number_of(text, false);
      if (v > 2) {
        return PackArgs { ...a, bad: x };
      }
      a = PackArgs { ...a, version: v as i32 };
      let rest = objects.part(text, after, text.len());
      if (rest.starts_with(",")) {
        let (limit, used) = number_of(objects.part(rest, 1, rest.len()), true);
        a = PackArgs { ...a, limit: limit };
        rest = objects.part(rest, used + 1, rest.len());
      }
      if (rest.len() > 0 || (a.limit & 2147483648) != 0) {
        return PackArgs { ...a, bad: x };
      }
    } else if (x.starts_with("--object-format=")) {
      a = PackArgs { ...a, format: objects.part(x, 16, x.len()) };
    } else if (x.starts_with("-") || a.file.len() > 0) {
      return PackArgs { ...a, bad: "usage" };
    } else {
      a = PackArgs { ...a, file: x };
    }
    i += 1;
  }
  return a;
}

// The file name `name` with the extension `to` in place of `from`, or the
// message of git.
function derived(name: string, from: string, to: string): Result[string, string] {
  if (!name.ends_with("." + from) || name.len() == from.len() + 1) {
    return Err("packfile name '" + name + "' does not end with '." + from + "'");
  }
  return Ok(objects.part(name, 0, name.len() - from.len()) + to);
}

// Writes `bytes` to the file `path`, with the mode 0444 as git gives it.
function write_fixed(path: string, bytes: u8[]): Result[void, string] {
  if let Err(e) = write_file_bytes(path, bytes) {
    return Err("unable to create '" + path + "': " + why(e));
  }
  let _ = chmod_at(path, 292, true);
  return Ok(());
}

// The objects of the repository that a thin pack does not have, or none.
function local_objects(repo: refs.Repo[], thin: boolean): (string) => Option[objects.Object] {
  if (!thin) {
    return (name: string): Option[objects.Object] => None;
  }
  let s = repo[0].store();
  return (name: string): Option[objects.Object] => match (store.read(s, name).object) {
    Ok(o) => Some(o),
    Err(_) => None,
  };
}

// The zlib level of the objects that git writes, from `core.loosecompression`
// or else `core.compression`, or the message of git for a level that is
// not one. The default is 1, and -1 is the default level of zlib.
function zlib_level(r: refs.Repo): Result[i32, string] {
  let level = 1;
  let loose = false;
  for e in r.config.entries {
    if (e.name == "core.compression" || e.name == "core.loosecompression") {
      let v = compression_of(e, r.config.file)?;
      if (e.name == "core.loosecompression" || !loose) {
        level = v;
      }
      loose = loose || e.name == "core.loosecompression";
    }
  }
  return Ok(level);
}

// The zlib level of one entry of the configuration in `file`.
function compression_of(e: config.Entry, file: string): Result[i32, string] {
  let negative = e.value.len() > 1 && e.value[0] == b'-';
  let n = log_number(if (negative) { objects.part(e.value, 1, e.value.len()) } else { e.value });
  if (n < 0) {
    return Err("bad numeric config value '" + e.value + "' for '" + e.name + "' in file " + file + ": invalid unit");
  }
  let v = if (negative) { -n } else { n };
  if (v < -1 || v > 9) {
    return Err("bad zlib compression level " + v.to_string());
  }
  return Ok(if (v == -1) { 6 } else { v });
}

// The names of the index and of the reverse index of the packfile `file`,
// or of the index `out`, or the message of git.
function index_names_of(a: PackArgs): Result[(string, string), string] {
  let idx_name = a.out;
  if (idx_name.len() == 0 && a.file.len() > 0) {
    idx_name = derived(a.file, "pack", "idx")?;
  }
  let rev_name = "";
  if (a.rev && idx_name.len() > 0) {
    rev_name = derived(idx_name, "idx", "rev")?;
  }
  return Ok((idx_name, rev_name));
}

// Writes the `.keep` file of the packfile, and gives what `--stdin` reports:
// "keep" when it wrote the file, or "pack".
function kept(a: PackArgs, stem: string): Result[string, string] {
  if (!a.keeps) {
    return Ok("pack");
  }
  let keep_name = if (a.file.len() > 0) { objects.part(a.file, 0, a.file.len() - 4) + "keep" } else { stem + ".keep" };
  if let Ok(_) = stat(keep_name) {
    return Ok("pack");
  }
  let text = if (a.keep.len() > 0) { a.keep + "\n" } else { "" };
  if let Err(e) = write_file(keep_name, text) {
    return Err("cannot write keep file '" + keep_name + "': " + why(e));
  }
  return Ok("keep");
}

function index_pack(argv: string[]): i32 {
  let a = pack_args(argv);
  if (argv.len() == 1 && argv[0] == "-h") {
    eprint(INDEX_PACK_USAGE);
    return 129;
  }
  // git reads the configuration before the options.
  let repo: refs.Repo[] = [];
  let level = 1;
  if let Ok(r) = refs.find() {
    repo = [r];
    match (zlib_level(r)) {
      Ok(v) => {
        level = v;
      },
      Err(message) => {
        return fatal(message);
      }
    }
  }
  if (a.failure.len() > 0) {
    return fatal(a.failure);
  }
  if (a.bad.len() > 0 && a.bad != "usage") {
    return fatal("bad " + a.bad);
  }
  if (a.bad == "usage" || a.file.len() == 0 && !a.stdin) {
    eprint(INDEX_PACK_USAGE);
    return 129;
  }
  let algo = objects.SHA1;
  if (a.format.len() > 0) {
    algo = objects.width_of(a.format);
    if (algo == 0) {
      return fatal("unknown hash algorithm '" + a.format + "'");
    }
  }
  if (repo.len() > 0 && a.format.len() == 0) {
    algo = repo[0].width;
  }
  if (a.thin && !a.stdin) {
    return fatal("the option '--fix-thin' requires '--stdin'");
  }
  if (a.stdin && repo.len() == 0) {
    return fatal("--stdin requires a git repository");
  }
  if (a.stdin && a.format.len() > 0) {
    return fatal("options '--object-format' and '--stdin' cannot be used together");
  }
  if (a.verify && a.file.len() == 0) {
    return fatal("--verify with no packfile name given");
  }
  let (idx_name, rev_name) = match (index_names_of(a)) {
    Ok(names) => names,
    Err(message) => { return fatal(message); },
  };
  // --verify writes no file: it checks the index of git, and its
  // version gives the version of the index.
  let existing_idx: u8[] = [];
  if (a.verify) {
    let checked_name = if (idx_name.len() > 0) { idx_name } else { a.file };
    let Ok(pack_path) = derived(checked_name, "idx", "pack") else {
      return fatal("Cannot open existing pack file '" + checked_name + "'");
    };
    if let Err(_) = stat(pack_path) {
      return fatal("Cannot open existing pack file '" + checked_name + "'");
    }
    let Ok(old) = read_file_bytes(checked_name) else {
      return fatal("Cannot open existing pack idx file for '" + checked_name + "'");
    };
    match (pack.index_of(old, algo, checked_name)) {
      Ok(ix) => {
        a = PackArgs { ...a, version: ix.version };
      },
      Err(message) => {
        eprint("error: " + message);
        return fatal("Cannot open existing pack idx file for '" + checked_name + "'");
      }
    }
    existing_idx = old;
  }
  // A packfile on the command line is mapped, not read into memory.
  let data = if (a.stdin) {
    match (io.read_all_stdin_bytes()) {
      Ok(b) => Ok(unsafe { string_from_bytes_unchecked(b) }),
      Err(e) => Err(e),
    }
  } else {
    unsafe { map_file_unchecked(a.file) }
  };
  let bytes = match (data) {
    Ok(b) => b,
    Err(e) => {
      return fatal("could not open '" + a.file + "' for reading: " + why(e));
    },
  };
  let raw = algo;
  let started = monotonic_ns();
  let o = index.Options { width: algo, version: a.version, limit: a.limit, level: level };
  let built = match (index.build_with(bytes, o, (d: string, offsets: i64[]): string[][] => index_names(d, offsets, raw), local_objects(repo, a.thin))) {
    Ok(b) => b,
    Err(messages) => {
      eprint(messages);
      return 128;
    },
  };
  if (a.verbose) {
    let _ = stderr().write_bytes(progress_text(built, algo, a.stdin, monotonic_ns() - started).bytes());
  }
  let pending: checkpack.Task[] = [];
  if (a.checking.enabled) {
    let checked = checkpack.validate(built, algo, a.checking, local_objects(repo, repo.len() > 0));
    for line in checked.lines {
      eprint(line);
    }
    if (!checked.ok) {
      return 128;
    }
    pending = checked.delayed;
  }
  if (a.verify) {
    let idx_path = if (idx_name.len() > 0) { idx_name } else { a.file };
    let failure = verified(idx_path, existing_idx, built.idx);
    if (failure.len() > 0) {
      return fatal(failure);
    }
    if (a.rev && rev_name.len() > 0) {
      if let Ok(old_rev) = read_file_bytes(rev_name) {
        let rev_failure = verified(rev_name, old_rev, built.rev);
        if (rev_failure.len() > 0) {
          return fatal(rev_failure);
        }
      }
    }
    if (a.checking.enabled) {
      let checked = checkpack.queued(built, algo, a.checking, pending, local_objects(repo, repo.len() > 0), repo.len() > 0, true);
      for line in checked.lines {
        eprint(line);
      }
      if (!checked.ok) {
        return 128;
      }
    }
    return 0;
  }
  let stem = if (repo.len() > 0) { repo[0].objects() + "/pack/pack-" + built.name } else { "" };
  let report = match (kept(a, stem)) {
    Ok(r) => r,
    Err(message) => {
      return fatal(message);
    },
  };
  if (a.stdin) {
    let pack_name = if (a.file.len() > 0) { a.file } else { stem + ".pack" };
    if let Err(message) = write_fixed(pack_name, built.data.bytes()) {
      return fatal(message);
    }
  }
  let rev_out = if (a.stdin && a.rev && rev_name.len() == 0) { stem + ".rev" } else { rev_name };
  if (rev_out.len() > 0) {
    if let Err(message) = write_fixed(rev_out, built.rev) {
      return fatal(message);
    }
  }
  if let Err(message) = write_fixed(if (idx_name.len() > 0) { idx_name } else { stem + ".idx" }, built.idx) {
    return fatal(message);
  }
  put_line(if (a.stdin) { report + "\t" + built.name } else { built.name });
  if (a.checking.enabled) {
    let final_index = if (idx_name.len() > 0) { idx_name } else { stem + ".idx" };
    let final_pack = if (a.file.len() > 0) { a.file } else { stem + ".pack" };
    let visible = match (derived(final_index, "idx", "pack")) { Ok(path) => path == final_pack, Err(_) => false };
    let checked = checkpack.queued(built, algo, a.checking, pending, local_objects(repo, repo.len() > 0), repo.len() > 0, visible);
    for name in checked.missing_modules {
      put_line(name);
    }
    for line in checked.lines {
      eprint(line);
    }
    if (!checked.ok) {
      return 128;
    }
  }
  return 0;
}

// The message of git when the file `path` with the bytes `old` is not the
// file `new` that index-pack makes, or "": `hashfd_check` of git compares
// the file in blocks of 128 KiB.
function verified(path: string, old: u8[], new: u8[]): string {
  let block = 131072;
  let at = 0;
  while (at < new.len()) {
    let end = (at + block).min(new.len());
    if (old.len() < end) {
      return path + ": sha1 file truncated";
    }
    for i in at..end {
      if (old[i] != new[i]) {
        return "sha1 file '" + path + "' validation error";
      }
    }
    at = end;
  }
  if (old.len() > new.len()) {
    return path + ": sha1 file has trailing garbage";
  }
  return "";
}

// The lines of the progress of a count to `total` with the title `title`,
// as `display_progress` of git writes them to a pipe: a line for each new
// percent from the count `from`, each line after a carriage return, and the
// last line with `end` and a line end. `tail` goes after the counts of the
// last line.
function progress_lines(title: string, from: i64, total: i64, tail: string, end: string): string {
  if (total == 0) {
    return "";
  }
  let out = "";
  let last: i64 = -1;
  let k = from;
  while (k <= total) {
    let percent = k * 100 / total;
    if (percent != last) {
      last = percent;
      out += title + ": " + percent.to_string().pad_start_str(3, " ") + "% (" + k.to_string() + "/" + total.to_string() + ")\r";
    }
    k += 1;
  }
  return out + title + ": 100% (" + total.to_string() + "/" + total.to_string() + ")" + tail + ", " + end + ".\n";
}

// A count of bytes as `strbuf_humanise_bytes` of git writes it.
function humanise(n: i64, rate: boolean): string {
  let units = if (rate) { ["GiB/s", "MiB/s", "KiB/s"] } else { ["GiB", "MiB", "KiB"] };
  let scales: i64[] = [1073741824, 1048576, 1024];
  for k in 0..3 {
    if (n > scales[k]) {
      let x = n / scales[k];
      let frac = n % scales[k] / (scales[k] / 1024) * 100 / 1024;
      return x.to_string() + "." + frac.to_string().pad_start_str(2, "0") + " " + units[k];
    }
  }
  return n.to_string() + (if (rate) { if (n == 1) { " byte/s" } else { " bytes/s" } } else if (n == 1) { " byte" } else { " bytes" });
}

// The progress of `index-pack -v`: the objects, with the bytes and their
// rate from the standard input, and the deltas, as git resolves them in
// one thread.
function progress_text(built: index.Built, width: i32, stdin: boolean, nanos: i64): string {
  let ix = match (pack.index_of(built.idx, width, "")) {
    Ok(v) => v,
    Err(_) => {
      return "";
    },
  };
  let w = pack.whole(built.data, width);
  let deltas: i64 = 0;
  for i in 0..ix.count {
    let e = pack.entry_in(w, pack.offset_at(ix, i));
    if (e.kind == 6 || e.kind == 7) {
      deltas += 1;
    }
  }
  let count = built.input_count as i64;
  let tail = "";
  if (stdin) {
    let misecs = nanos / 1000000 * 1024 / 1000;
    let bytes = built.data.len() as i64;
    tail = ", " + humanise(bytes, false) + " | " + humanise(bytes / (if (misecs > 0) { misecs } else { 1 }) * 1024, true);
  }
  let out = progress_lines(if (stdin) { "Receiving objects" } else { "Indexing objects" }, 1, count, tail, "done");
  return out + progress_lines("Resolving deltas", 0, deltas, "", "done");
}

// ---- verify-pack ----

function plural(n: i32): string {
  return if (n == 1) { " object" } else { " objects" };
}

// The path of the packfile for the path of a packfile or of its index.
function pack_path(file: string): string {
  if (file.ends_with(".idx")) {
    return objects.part(file, 0, file.len() - 4) + ".pack";
  }
  return file;
}

// The places of the index in the order of the offsets in the packfile.
function by_offset(ix: pack.Index): i32[] {
  let order: i32[] = [];
  for i in 0..ix.count {
    order = order.append(i);
  }
  return cmp.sort_by(order, (a: i32, b: i32): i32 => pack.offset_at(ix, a).cmp(pack.offset_at(ix, b)));
}

// The place in `order` of the object at `offset`, or -1.
function at_offset(ix: pack.Index, order: i32[], offset: i64): i32 {
  let lo = 0;
  let hi = order.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    let o = pack.offset_at(ix, order[mid]);
    if (o == offset) {
      return order[mid];
    }
    if (o < offset) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return -1;
}

// True if the two checksums of the files hold: the hash of the packfile at
// its end and in the index, and the hash of the index at its end.
function checksums_ok(a: i32, data: string, idx: u8[]): boolean {
  let n = data.len();
  let m = idx.len();
  let raw = a;
  if (n < 12 + raw || data[0] != b'P' || data[1] != b'A' || data[2] != b'C' || data[3] != b'K') {
    return false;
  }
  let view = data.as_bytes();
  let sum = hex.encode(objects.digest(a, view[0:n - raw]));
  if (sum != hex.encode(view[n - raw:n]) || sum != hex.encode(array.slice(idx, m - 2 * raw, m - raw))) {
    return false;
  }
  return hex.encode(objects.digest(a, array.slice(idx, 0, m - raw))) == hex.encode(array.slice(idx, m - raw, m));
}

// Checks each object of one packfile: its chain of deltas gives an object
// with the name that the index has. With `verbose`, it prints a line for
// each object in the order of the packfile, and the lengths of the chains.
function verify_one(a: i32, file: string, verbose: boolean): boolean {
  let path = pack_path(file);
  let Ok(data) = unsafe { map_file_unchecked(path) } else {
    eprint("fatal: Cannot open existing pack file '" + file + "'");
    return false;
  };
  let idx_path = objects.part(path, 0, path.len() - 5) + ".idx";
  let Ok(idx) = read_file_bytes(idx_path) else {
    eprint("fatal: Cannot open existing pack idx file for '" + file + "'");
    return false;
  };
  let Ok(ix) = pack.index_of(idx, a, idx_path) else {
    return false;
  };
  if (!checksums_ok(a, data, idx)) {
    return false;
  }
  let order = by_offset(ix);
  let text = data;
  let src = pack.memory(text, (name: u8[]): i64 => pack.offset_of(ix, name), a);
  let cache = pack.cache_new();
  let chains: i32[] = [];
  let out: u8[] = [];
  for k in 0..order.len() {
    let name = pack.hex_name_at(ix, order[k]);
    let offset = pack.offset_at(ix, order[k]);
    let Ok(chain) = pack.chain_in(src, offset) else {
      return false;
    };
    let (made, kept) = pack.object_cached(src, offset, cache);
    cache = kept;
    let Ok(o) = made else {
      return false;
    };
    if (objects.hash_of(a, o.kind, o.body) != name) {
      return false;
    }
    let depth = chain.len() - 1;
    while (chains.len() <= depth) {
      chains = chains.append(0);
    }
    chains = chains.with(depth, chains[depth] + 1);
    let end = if (k + 1 < order.len()) { pack.offset_at(ix, order[k + 1]) } else { (data.len() - a) as i64 };
    let line = name + " " + (o.kind + "      ").take(6) + " " + pack.entry_in(pack.whole(text, a), offset).size.to_string() + " " + (end - offset).to_string() + " " + offset.to_string();
    if (depth > 0) {
      let base = at_offset(ix, order, chain[1]);
      line = line + " " + depth.to_string() + " " + pack.hex_name_at(ix, base);
    }
    out = out.concat((line + "\n").bytes());
  }
  if (!verbose) {
    return true;
  }
  put(out);
  put_line("non delta: " + chains[0].to_string() + plural(chains[0]));
  for d in 1..chains.len() {
    if (chains[d] > 0) {
      put_line("chain length = " + d.to_string() + ": " + chains[d].to_string() + plural(chains[d]));
    }
  }
  put_line(path + ": ok");
  return true;
}

function verify_pack(argv: string[]): i32 {
  let verbose = false;
  let files: string[] = [];
  for x in argv {
    if (x == "-v" || x == "--verbose") {
      verbose = true;
    } else if (x.starts_with("-") && x != "--") {
      return usage();
    } else if (x != "--") {
      files = files.append(x);
    }
  }
  if (files.len() == 0) {
    return usage();
  }
  let algo = match (refs.find()) {
    Ok(r) => r.width,
    Err(_) => objects.SHA1,
  };
  let status = 0;
  for file in files {
    if (!verify_one(algo, file, verbose)) {
      if (verbose) {
        put_line(pack_path(file) + ": bad");
      }
      status = 1;
    }
  }
  return status;
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 2) {
    return usage();
  }
  let rest = array.slice(argv, 2, argv.len());
  return match (argv[1]) {
    "hash-object" => hash_object(rest),
    "cat-file" => cat_file(rest),
    "rev-parse" => rev_parse(rest),
    "verify-pack" => verify_pack(rest),
    "ls-tree" => ls_tree(rest),
    "log" => log_command(rest),
    "index-pack" => index_pack(rest),
    _ => {
      eprint("git: '" + argv[1] + "' is not a command of this port.");
      1
    },
  };
}
