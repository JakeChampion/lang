// git — a subset of the plumbing commands of git, on the object store of a
// real repository.
//
//   $ git hash-object [-w] [-t KIND] [--stdin] [FILE...]
//   $ git cat-file (-t | -s | -p | -e) NAME
//   $ git cat-file (--batch | --batch-check)       # names on the standard input
//   $ git rev-parse [--verify] [--short[=N]] [--git-dir] NAME...
//   $ git verify-pack [-v] FILE.idx...
//   $ git ls-tree [-r] [-t] [-d] [-l] [--name-only] [--full-tree] TREE
//
// The port reads loose objects and packfiles, and writes loose objects.
import "std/array";
import "./attr";
import "std/process";
import "std/errno";
import "std/io";
import "std/string";
import "std/u64";
import "std/worker";
import "core/cmp";
import "core/map";
import "std/crypto";
import "std/hex";
import "std/linediff";
import "./color";
import "./combine";
import "./commitgraph";
import "./config";
import "./linelog";
import "./fsck";
import "./checkpack";
import "./graph";
import "./index";
import "./log";
import "./mailmap";
import "./notes";
import "./moved";
import "./objects";
import "./pack";
import "./patch";
import "./refs";
import "./rev";
import "./revwalk";
import "./sig";
import "./treediff";
import "./userdiff";
import "./date";
import "../../coreutils/lib/bre";
import "../../coreutils/lib/fnmatch";
import "./store";
import "./walk";
import "./ws";

const USAGE: string = "usage: git hash-object [-w] [-t KIND] [--stdin] [FILE...]\n   or: git cat-file (-t | -s | -p | -e) NAME\n   or: git cat-file (--batch | --batch-check)\n   or: git rev-parse [--verify] [--short[=N]] [--git-dir] NAME...\n   or: git verify-pack [-v] FILE.idx...\n   or: git ls-tree [-r] [-t] [-d] [-l] [--name-only] [--full-tree] TREE\n   or: git log [-n N] [--oneline] [--format=FORMAT] [NAME]\n   or: git index-pack [-o FILE.idx] FILE.pack";

function fatal(message: string): i32 {
  eprint("fatal: " + message);
  return 128;
}

// The text of the C library for the error, as git writes it.
function why(e: IoError): string {
  let n = errno.of(e);
  if (n == errno.ENOENT) {
    return "No such file or directory";
  }
  if (n == errno.EACCES) {
    return "Permission denied";
  }
  if (n == errno.EISDIR) {
    return "Is a directory";
  }
  return e.message();
}

function usage(): i32 {
  eprint(USAGE);
  return 129;
}

function put(bytes: u8[]): void {
  let _ = stdout().write_bytes(bytes);
}

function put_line(text: string): void {
  put((text + "\n").bytes());
}

// The repository, or the exit status after its message.
function repo_or_fail(): (refs.Repo[], i32) {
  return match (refs.find()) {
    Ok(r) => ([r], 0),
    Err(message) => {
      eprint(message);
      ([], 128)
    },
  };
}

// ---- hash-object ----

struct HashArgs { write: boolean, stdin: boolean, literally: boolean, kind: string, files: string[], bad: string }

function hash_args(argv: string[]): HashArgs {
  let a = HashArgs { write: false, stdin: false, literally: false, kind: "blob", files: [], bad: "" };
  let i = 0;
  let flags = true;
  while (i < argv.len()) {
    let x = argv[i];
    if (flags && x == "--") {
      flags = false;
    } else if (flags && x == "-w") {
      a = HashArgs { ...a, write: true };
    } else if (flags && x == "--stdin") {
      a = HashArgs { ...a, stdin: true };
    } else if (flags && x == "--literally") {
      a = HashArgs { ...a, literally: true };
    } else if (flags && x == "-t" && i + 1 < argv.len()) {
      a = HashArgs { ...a, kind: argv[i + 1] };
      i += 1;
    } else if (flags && x.starts_with("-t") && x.len() > 2) {
      a = HashArgs { ...a, kind: objects.part(x, 2, x.len()) };
    } else if (flags && x.starts_with("-") && x.len() > 1) {
      return HashArgs { ...a, bad: x };
    } else {
      a = HashArgs { ...a, files: a.files.append(x) };
    }
    i += 1;
  }
  return a;
}

// Prints the name of the object with `body`, and writes it when `-w` is set.
// The kind is one of the four. Without `--literally`, a commit, a tree or
// a tag has the form that fsck checks.
function hash_one(a: HashArgs, repo: refs.Repo[], body: u8[]): i32 {
  let algo = if (repo.len() > 0) { repo[0].width } else { objects.SHA1 };
  if (!objects.is_kind(a.kind)) {
    return fatal("invalid object type \"" + a.kind + "\"");
  }
  if (!a.literally) {
    let found = fsck.check(algo, a.kind, body);
    if (found.len() > 0) {
      for line in found {
        eprint(line);
      }
      return fatal("refusing to create malformed object");
    }
  }
  if (!a.write) {
    put_line(objects.hash_of(algo, a.kind, body));
    return 0;
  }
  return match (objects.write_loose(repo[0].objects(), algo, a.kind, body)) {
    Ok(name) => {
      put_line(name);
      0
    },
    Err(message) => fatal(message),
  };
}

function hash_object(argv: string[]): i32 {
  let a = hash_args(argv);
  if (a.bad.len() > 0) {
    return usage();
  }
  let repo: refs.Repo[] = [];
  if (a.write) {
    let (found, status) = repo_or_fail();
    if (status != 0) {
      return status;
    }
    repo = found;
  } else if let Ok(r) = refs.find() {
    repo = [r];
  }
  if (a.stdin) {
    let body = match (io.read_all_stdin_bytes()) {
      Ok(bytes) => bytes,
      Err(e) => {
        return fatal("unable to read the standard input: " + e.message());
      },
    };
    let status = hash_one(a, repo, body);
    if (status != 0) {
      return status;
    }
  }
  for file in a.files {
    let body = match (read_file_bytes(file)) {
      Ok(bytes) => bytes,
      Err(e) => {
        return fatal("could not open '" + shown_path(file) + "' for reading: " + why(e));
      },
    };
    let status = hash_one(a, repo, body);
    if (status != 0) {
      return status;
    }
  }
  return 0;
}

// The path as git names it in a message: from the top of the worktree.
function shown_path(file: string): string {
  if (file.starts_with("/")) {
    return file;
  }
  return match (refs.find()) {
    Ok(r) => r.prefix + file,
    Err(_) => file,
  };
}

// ---- cat-file ----

// The text of `cat-file -p`: the lines of a tree, or the body of each other
// kind.
function pretty(raw: i32, o: objects.Object): Result[u8[], string] {
  if (o.kind == "tree") {
    return objects.tree_text(o.body, raw);
  }
  return Ok(o.body);
}

function cat_one(r: refs.Repo, mode: string, name: string): i32 {
  let found = rev.parse_to_die(r, r.store(), name);
  print_errors(found.errors);
  let hash = found.hash;
  if (found.died.len() > 0) {
    return fatal(found.died);
  }
  if (hash.len() == 0) {
    return fatal(if (found.message.len() > 0) { found.message } else { "Not a valid object name " + name });
  }
  let o = match (store.read(found.store, hash).object) {
    Ok(found) => found,
    Err(message) => {
      if (mode == "-e") {
        return 1;
      }
      if (message != "missing") {
        return fatal(message);
      }
      if (mode == "-p") {
        return fatal("Not a valid object name " + name);
      }
      return fatal("git cat-file: could not get object info");
    },
  };
  if (mode == "-t") {
    put_line(o.kind);
  } else if (mode == "-s") {
    put_line(o.body.len().to_string());
  } else if (mode == "-p") {
    match (pretty(r.width, o)) {
      Ok(text) => {
        put(text);
      },
      Err(message) => {
        return fatal(message);
      }
    }
  }
  return 0;
}

// `--batch` and `--batch-check`: one name for each line of the standard
// input.
function cat_batch(r: refs.Repo, contents: boolean): i32 {
  let input = match (io.read_all_stdin()) {
    Ok(text) => text,
    Err(e) => {
      return fatal("unable to read the standard input: " + e.message());
    },
  };
  let lines = input.split("\n");
  let count = if (input.ends_with("\n") || input.len() == 0) { lines.len() - 1 } else { lines.len() };
  let s = r.store();
  let buf: u8[] = [];
  for i in 0..count {
    let name = lines[i];
    // A full name needs no search: git does not look for a ref of that
    // name in a batch.
    let low = name.to_ascii_lower();
    let hash = "";
    if (objects.is_name(r.width, low)) {
      hash = low;
    } else {
      let named = rev.parse(r, s, name);
      s = named.store;
      hash = named.hash;
    }
    let line = name + " missing";
    let body: u8[] = [];
    let has = false;
    if (hash.len() > 0 && contents) {
      let got = store.read(s, hash);
      s = got.store;
      if let Ok(o) = got.object {
        line = hash + " " + o.kind + " " + o.body.len().to_string();
        body = o.body;
        has = true;
      }
    } else if (hash.len() > 0) {
      // The kind and the size need no content.
      let got = store.info(s, hash);
      s = got.store;
      if (got.why.len() == 0) {
        line = hash + " " + got.kind + " " + got.size.to_string();
      }
    }
    buf = buf.concat(line.bytes()).append(b'\n');
    if (has) {
      put(buf);
      put(body);
      buf = [b'\n'];
    } else if (buf.len() > 65536) {
      put(buf);
      buf = [];
    }
  }
  put(buf);
  return 0;
}

// The status of git when the configuration has a key of a driver of the
// attribute `diff` with no value, after its two lines. 0 for a sound
// configuration.
function driver_config_status(r: refs.Repo): i32 {
  if let Some(e) = userdiff.bad_entry(r.config) {
    eprint("error: " + config.missing_value(e));
    return fatal(r.config.bad(e));
  }
  return 0;
}

function cat_file(argv: string[]): i32 {
  if (argv.len() == 0) {
    return usage();
  }
  let mode = argv[0];
  let batch = mode == "--batch" || mode == "--batch-check";
  let single = mode == "-t" || mode == "-s" || mode == "-p" || mode == "-e";
  if (!(batch && argv.len() == 1) && !(single && argv.len() == 2)) {
    return usage();
  }
  let (repo, status) = repo_or_fail();
  if (status != 0) {
    return status;
  }
  if (driver_config_status(repo[0]) != 0) {
    return 128;
  }
  if (batch) {
    return cat_batch(repo[0], mode == "--batch");
  }
  return cat_one(repo[0], mode, argv[1]);
}

// ---- rev-parse ----

const AMBIGUOUS: string = "': unknown revision or path not in the working tree.\nUse '--' to separate paths from revisions, like this:\n'git <command> [<revision>...] -- [<file>...]'";

// Git reads the decimal prefix with strtoul, narrows it to int and then
// clamps it to the supported object-name lengths.
function short_length(s: store.Store, flag: string): i32 {
  if (!flag.starts_with("--short=")) {
    return store.short_length(s);
  }
  let i = 8;
  while (i < flag.len() && (flag[i] == b' ' || flag[i] >= 9 && flag[i] <= 13)) {
    i += 1;
  }
  let negative = i < flag.len() && flag[i] == b'-';
  if (negative || i < flag.len() && flag[i] == b'+') {
    i += 1;
  }
  let start = i;
  while (i < flag.len() && flag[i] >= b'0' && flag[i] <= b'9') {
    i += 1;
  }
  let Ok(magnitude) = u64.parse_u64(slice_unchecked(flag, start, i)) else {
    return 4;
  };
  let value = if (negative) { 0u64 - magnitude } else { magnitude };
  return (value as i32).max(4).min(2 * s.width);
}

// Prints the lines that git prints while it reads a revision.
function print_errors(lines: string[]): void {
  for line in lines {
    eprint(line);
  }
}

// The lines of a second read of a revision: git reads it again to tell why
// it names nothing, and that read is quiet about refs and short hashes.
function second_errors(lines: string[]): string[] {
  return lines.filter((line: string): boolean => !line.starts_with("warning:") && !line.starts_with("hint:") && !line.starts_with("error: short object ID"));
}

// True if git reads `arg` as a pattern of paths: it has a wildcard or a
// magic word.
function looks_like_pathspec(arg: string): boolean {
  return arg.contains("*") || arg.contains("?") || arg.contains("[") || arg.contains("\\") || arg.starts_with(":(");
}

// True if the path `arg` exists, from the current directory or, after
// `:/`, from the top of the worktree.
function path_exists(r: refs.Repo, arg: string): boolean {
  let path = arg;
  if (arg.starts_with(":/")) {
    if (arg.len() == 2) {
      return true;
    }
    path = r.top + "/" + objects.part(arg, 2, arg.len());
  } else if (arg.starts_with(":!") || arg.starts_with(":^")) {
    if (arg.len() == 2) {
      return true;
    }
    path = objects.part(arg, 2, arg.len());
  }
  return match (stat(path)) {
    Ok(_) => true,
    Err(_) => false,
  };
}

// The status of git for an argument that is no revision and no path, after
// its messages: the reasons of a second read, or the message of an
// argument that is ambiguous.
function no_such_name(r: refs.Repo, arg: string, named: rev.Rev): i32 {
  if (arg.starts_with("-")) {
    return fatal("option '" + arg + "' must come before non-option arguments");
  }
  if (!(arg.starts_with(":") && arg.len() > 1 && !is_alnum(arg[1]))) {
    print_errors(second_errors(named.errors));
    if (named.message.len() > 0) {
      return fatal(named.message);
    }
  }
  return fatal("ambiguous argument '" + arg + AMBIGUOUS);
}

function is_alnum(b: u8): boolean {
  return b >= b'0' && b <= b'9' || b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z';
}

// The options of rev-parse and the store after the reads.
struct RevParse { store: store.Store, short: i32, verify: boolean, quiet: boolean, count: i32, last: string }

// Prints a revision: the hash, or the short hash, with `^` before an
// excluded one.
function show_rev(p: RevParse, hash: string, excluded: boolean): void {
  let shown = if (p.short > 0) { refs.short_of(p.store, hash, p.short) } else { hash };
  put_line(if (excluded) { "^" + shown } else { shown });
}

// The commit that `name` names, for a range: the hash, or "" after the
// errors of git.
function committish(r: refs.Repo, p: RevParse, name: string): (RevParse, string, boolean) {
  let named = rev.parse_with(r, p.store, name, rev.COMMITTISH);
  print_errors(named.errors);
  return (RevParse { ...p, store: named.store }, named.hash, named.died.len() > 0);
}

// `A..B`, `A...B`, `..B` and `A..`: true when `arg` is such a range of
// two revisions, which it prints.
function try_range(r: refs.Repo, p_in: RevParse, arg: string): (RevParse, boolean) {
  let p = p_in;
  let Some(dots) = arg.index_of("..") else {
    return (p, false);
  };
  let symmetric = dots + 2 < arg.len() && arg[dots + 2] == b'.';
  let start = objects.part(arg, 0, dots);
  let end = objects.part(arg, dots + (if (symmetric) { 3 } else { 2 }), arg.len());
  if (start.len() == 0 && end.len() == 0 && !symmetric) {
    return (p, false);
  }
  let (p1, a, _) = committish(r, p, if (start.len() == 0) { "HEAD" } else { start });
  if (a.len() == 0) {
    return (p1, false);
  }
  let (p2, b, _) = committish(r, p1, if (end.len() == 0) { "HEAD" } else { end });
  p = p2;
  if (b.len() == 0) {
    return (p, false);
  }
  show_rev(p, b, false);
  show_rev(p, a, !symmetric);
  if (!symmetric) {
    return (p, true);
  }
  let ca = rev.commit_of(p.store, a);
  print_errors(ca.errors);
  let cb = rev.commit_of(ca.store, b);
  print_errors(cb.errors);
  p = RevParse { ...p, store: cb.store };
  if (ca.hash.len() == 0 || cb.hash.len() == 0) {
    return (p, false);
  }
  let (g, bases) = walk.merge_bases(walk.graph_of(p.store), ca.hash, [cb.hash]);
  p = RevParse { ...p, store: g.store };
  for base in bases {
    show_rev(p, base, true);
  }
  return (p, true);
}

// `A^@`, `A^!` and `A^-N`: true when `arg` is such a revision, which it
// prints.
function try_parents(r: refs.Repo, p_in: RevParse, arg: string): (RevParse, boolean) {
  let p = p_in;
  let at = -1;
  let mode = "";
  let exclude = 0;
  if let Some(i) = arg.index_of("^!") {
    at = i;
    mode = "!";
    if (i + 2 != arg.len()) {
      return (p, false);
    }
  } else if let Some(i) = arg.index_of("^@") {
    at = i;
    mode = "@";
    if (i + 2 != arg.len()) {
      return (p, false);
    }
  } else if let Some(i) = arg.index_of("^-") {
    at = i;
    mode = "-";
    exclude = 1;
    if (i + 2 < arg.len()) {
      let n = log_number(objects.part(arg, i + 2, arg.len()));
      if (n <= 0) {
        return (p, false);
      }
      exclude = n;
    }
  } else {
    return (p, false);
  }
  let (p1, h, _) = committish(r, p, objects.part(arg, 0, at));
  p = p1;
  if (h.len() == 0) {
    return (p, false);
  }
  let c = rev.commit_of(p.store, h);
  print_errors(c.errors);
  p = RevParse { ...p, store: c.store };
  if (c.hash.len() == 0) {
    return (p, false);
  }
  let (g, node) = walk.node(walk.graph_of(p.store), c.hash);
  p = RevParse { ...p, store: g.store };
  if (exclude > node.parents.len()) {
    return (p, false);
  }
  if (mode != "@") {
    show_rev(p, h, false);
  }
  for i in 0..node.parents.len() {
    if (exclude == 0 || i + 1 == exclude) {
      show_rev(p, node.parents[i], mode != "@");
    }
  }
  return (p, true);
}

function rev_parse(argv: string[]): i32 {
  let (repo, status) = repo_or_fail();
  if (status != 0) {
    return status;
  }
  let r = repo[0];
  let p = RevParse { store: r.store(), short: 0, verify: false, quiet: false, count: 0, last: "" };
  let dashdash = argv.contains("--");
  let options = true;
  let as_is = 0;
  for x in argv {
    if (as_is > 0) {
      put_line(x);
      if (as_is < 2 && x.starts_with("-")) {
        return fatal("option '" + x + "' must come before non-option arguments");
      }
      if (as_is < 2 && !looks_like_pathspec(x) && !path_exists(r, x)) {
        return fatal(x + ": no such path in the working tree.\nUse 'git <command> -- <path>...' to specify paths that do not exist locally.");
      }
      continue;
    }
    if (x == "--") {
      if (p.verify) {
        break;
      }
      as_is = 2;
      put_line(x);
      continue;
    }
    if (options && x.starts_with("-")) {
      if (x == "--end-of-options") {
        options = false;
        if (!p.verify) {
          put_line(x);
        }
      } else if (x == "--verify") {
        p = RevParse { ...p, verify: true };
      } else if (x == "-q" || x == "--quiet") {
        p = RevParse { ...p, quiet: true };
      } else if (x == "--short" || x.starts_with("--short=")) {
        p = RevParse { ...p, short: short_length(p.store, x), verify: true };
      } else if (x == "--git-dir") {
        put_line(r.shown);
      } else {
        put_line(x);
        if (p.verify) {
          return no_single(p);
        }
      }
      continue;
    }
    let (p1, ranged) = try_range(r, p, x);
    p = p1;
    if (ranged) {
      continue;
    }
    let (p2, parented) = try_parents(r, p, x);
    p = p2;
    if (parented) {
      continue;
    }
    let excluded = x.starts_with("^");
    let name = if (excluded) { objects.part(x, 1, x.len()) } else { x };
    let named = rev.parse(r, p.store, name);
    p = RevParse { ...p, store: named.store };
    print_errors(named.errors);
    if (named.died.len() > 0) {
      return fatal(named.died);
    }
    if (named.hash.len() > 0) {
      if (p.verify) {
        p = RevParse { ...p, count: p.count + 1, last: if (excluded) { "^" + named.hash } else { named.hash } };
      } else {
        show_rev(p, named.hash, excluded);
      }
      continue;
    }
    if (p.verify) {
      return no_single(p);
    }
    if (dashdash) {
      return fatal("bad revision '" + x + "'");
    }
    as_is = 1;
    put_line(x);
    if (x.starts_with("-") || !looks_like_pathspec(x) && !path_exists(r, x)) {
      return no_such_name(r, x, named);
    }
  }
  if (p.verify) {
    if (p.count == 1) {
      let excluded = p.last.starts_with("^");
      show_rev(p, if (excluded) { objects.part(p.last, 1, p.last.len()) } else { p.last }, excluded);
      return 0;
    }
    return no_single(p);
  }
  return 0;
}

// The end of `--verify` with no single revision: quiet with `-q`.
function no_single(p: RevParse): i32 {
  if (p.quiet) {
    return 1;
  }
  return fatal("Needed a single revision");
}

// ---- ls-tree ----

// The options of ls-tree. `mode` is "", "long", "name" or "object".
// `prefix` is the directory that the names are relative to, and `items`
// are the paths from the top of the worktree that the listing keeps.
struct LsOpts { recurse: boolean, trees: boolean, only_trees: boolean, mode: string, zero: boolean, abbrev: i32, items: string[], prefix: string }

// The lines of a tree so far, and the store after the reads.
struct Listing { store: store.Store, out: u8[], ok: boolean }

// The size column of `ls-tree -l`: seven places, or `-` for an entry that
// is not a blob.
function size_column(st: store.Store, e: objects.TreeEntry): (store.Store, string) {
  if (objects.entry_kind(e.mode) != "blob") {
    return (st, "       -");
  }
  let got = store.info(st, e.hash);
  let size = if (got.why.len() == 0) { got.size.to_string() } else { "-" };
  return (got.store, " " + size.pad_start_str(7, " "));
}

// The lines that wait, with one more: `line`, a tab when `line` has text,
// and the path, and the end of the line. A long text goes to the standard
// output, so the lines that wait stay short.
function ls_out(own out: u8[], line: string, path: u8[], end: u8): u8[] {
  for b in line.bytes() {
    out = out.append(b);
  }
  if (line.len() > 0 && path.len() > 0) {
    out = out.append(b'\t');
  }
  for b in path {
    out = out.append(b);
  }
  out = out.append(end);
  if (out.len() < 4096) {
    return out;
  }
  put(out);
  return [];
}

// The path `path` from the directory `prefix`, as `relative_path` of git
// gives it: `../` for each directory of the prefix that the path is not in.
function relative_to(path: u8[], prefix: string): u8[] {
  let n = path.len();
  let m = prefix.len();
  if (n == 0) {
    return "./".bytes();
  }
  if (m == 0) {
    return path;
  }
  let i = 0;
  let j = 0;
  let prefix_off = 0;
  let in_off = 0;
  while (i < m && j < n && prefix[i] == path[j]) {
    if (prefix[i] == b'/') {
      while (i < m && prefix[i] == b'/') {
        i += 1;
      }
      while (j < n && path[j] == b'/') {
        j += 1;
      }
      prefix_off = i;
      in_off = j;
    } else {
      i += 1;
      j += 1;
    }
  }
  if (i >= m && prefix_off < m) {
    if (j >= n) {
      in_off = n;
    } else if (path[j] == b'/') {
      while (j < n && path[j] == b'/') {
        j += 1;
      }
      in_off = j;
    } else {
      i = prefix_off;
    }
  } else if (j >= n && in_off < n) {
    if (i < m && prefix[i] == b'/') {
      while (i < m && prefix[i] == b'/') {
        i += 1;
      }
      in_off = n;
    }
  }
  let rest = array.slice(path, in_off, n);
  if (i >= m) {
    return if (rest.len() == 0) { "./".bytes() } else { rest };
  }
  let out: u8[] = [];
  while (i < m) {
    if (prefix[i] == b'/') {
      out = out.concat("../".bytes());
      while (i < m && prefix[i] == b'/') {
        i += 1;
      }
    } else {
      i += 1;
    }
  }
  if (prefix[m - 1] != b'/') {
    out = out.concat("../".bytes());
  }
  return out.concat(rest);
}

// Adds the line of the entry `e`, whose path from the top is `path`.
function ls_line(own l: Listing, e: objects.TreeEntry, path: u8[], o: LsOpts): Listing {
  let out = l.out;
  let st = l.store;
  let ok = l.ok;
  let name = relative_to(path, o.prefix);
  let shown = if (o.zero) { name } else { objects.quoted(name) };
  let end: u8 = if (o.zero) { 0 } else { b'\n' };
  let hash = if (o.abbrev > 0) { refs.short_of(st, e.hash, o.abbrev) } else { e.hash };
  if (o.mode == "name") {
    return Listing { store: st, out: ls_out(out, "", shown, end), ok: ok };
  }
  if (o.mode == "object") {
    return Listing { store: st, out: ls_out(out, hash, [], end), ok: ok };
  }
  let head = objects.entry_head(objects.TreeEntry { ...e, hash: hash });
  if (o.mode == "long") {
    let (after, column) = size_column(st, e);
    st = after;
    head += column;
  }
  return Listing { store: st, out: ls_out(out, head, shown, end), ok: ok };
}

// True if one of `items` is the path `path`, or is below the directory
// `path` when the entry is a tree: `match_entry` of git.
function item_matches(items: string[], path: u8[], is_tree: boolean): boolean {
  for item in items {
    if (item.len() >= path.len() && prefix_bytes(item, path)) {
      if (item.len() == path.len()) {
        return true;
      }
      if (item[path.len()] == b'/' && is_tree) {
        return true;
      }
    }
  }
  return false;
}

// True if the directory `base` (with its `/`) is in a directory of one of
// `items`: then each entry below it is in the listing.
function inside_item(items: string[], base: u8[]): boolean {
  for item in items {
    if (base.len() >= item.len() && prefix_of(base, item)) {
      if (item.len() == 0 || base.len() > item.len() && base[item.len()] == b'/' || item[item.len() - 1] == b'/') {
        return true;
      }
    }
  }
  return false;
}

function prefix_bytes(text: string, bytes: u8[]): boolean {
  for i in 0..bytes.len() {
    if (text[i] != bytes[i]) {
      return false;
    }
  }
  return true;
}

function prefix_of(bytes: u8[], text: string): boolean {
  for i in 0..text.len() {
    if (bytes[i] != text[i]) {
      return false;
    }
  }
  return true;
}

// True if the listing goes into the tree `path`: with `-r`, or when an
// item is below it: `show_recursive` of git.
function goes_into(o: LsOpts, path: u8[]): boolean {
  if (o.recurse) {
    return true;
  }
  for item in o.items {
    if (item.len() > path.len() && prefix_bytes(item, path) && item[path.len()] == b'/') {
      return true;
    }
  }
  return false;
}

// Adds the lines of the tree `hash`, whose path from the top is `base`.
// `all` tells that each entry is in the listing.
function ls_walk(own l: Listing, hash: string, base: u8[], all_in: boolean, o: LsOpts): Listing {
  let out = l.out;
  let ok = l.ok;
  let got = store.read(l.store, hash);
  let entries = match (got.object) {
    Ok(t) => if (t.kind == "tree") { objects.tree_entries(t.body, got.store.width) } else { Err("not a tree") },
    Err(why) => Err(why),
  };
  let Ok(list) = entries else {
    return Listing { store: got.store, out: out, ok: false };
  };
  let all = all_in || o.items.len() == 0 || inside_item(o.items, base);
  let now = Listing { store: got.store, out: out, ok: ok };
  for e in list {
    let path = base.concat(e.name);
    let is_tree = e.mode == "40000";
    if (all || item_matches(o.items, path, is_tree)) {
      let into = is_tree && goes_into(o, path);
      let shown = if (is_tree) { !into || o.trees } else { !o.only_trees };
      if (shown) {
        now = ls_line(now, e, path, o);
      }
      if (into) {
        now = ls_walk(now, e.hash, path.append(b'/'), all, o);
      }
    }
  }
  return now;
}

// The path `arg` from the directory `prefix`, with `.`, `..` and the
// doubled slashes taken out, as a pathspec of git holds it. A `/` at the
// end stays. A path above the top of the worktree `top` is the message of
// git.
function item_of(prefix: string, arg: string, top: string): Result[string, string] {
  if (arg.len() == 0) {
    return Err("empty string is not a valid pathspec. please use . instead if you meant to match all paths");
  }
  let parts: string[] = [];
  for p in (prefix + arg).split("/") {
    if (p == "..") {
      if (parts.len() == 0) {
        return Err(arg + ": '" + arg + "' is outside repository at '" + top + "'");
      }
      parts = array.slice(parts, 0, parts.len() - 1);
    } else if (p.len() > 0 && p != ".") {
      parts = parts.append(p);
    }
  }
  let path = parts.join("/");
  let dir = arg.ends_with("/") || arg == "." || arg.ends_with("/.") || arg == ".." || arg.ends_with("/..");
  return Ok(if (dir && path.len() > 0) { path + "/" } else { path });
}

function ls_tree(argv: string[]): i32 {
  let (repo, status) = repo_or_fail();
  if (status != 0) {
    return status;
  }
  let r = repo[0];
  let o = LsOpts { recurse: false, trees: false, only_trees: false, mode: "", zero: false, abbrev: 0, items: [], prefix: "" };
  let full_name = r.prefix.len() == 0;
  let full_tree = false;
  let names: string[] = [];
  let flags = true;
  for x in argv {
    if (flags && x == "--") {
      flags = false;
    } else if (flags && x.starts_with("-") && x.len() > 1 && !x.starts_with("--")) {
      for i in 1..x.len() {
        let c = x[i];
        if (c == b'r') {
          o = LsOpts { ...o, recurse: true };
        } else if (c == b't') {
          o = LsOpts { ...o, trees: true };
        } else if (c == b'd') {
          o = LsOpts { ...o, only_trees: true };
        } else if (c == b'l') {
          o = LsOpts { ...o, mode: "long" };
        } else if (c == b'z') {
          o = LsOpts { ...o, zero: true };
        } else {
          return usage();
        }
      }
    } else if (flags && x == "--long") {
      o = LsOpts { ...o, mode: "long" };
    } else if (flags && (x == "--name-only" || x == "--name-status")) {
      o = LsOpts { ...o, mode: "name" };
    } else if (flags && x == "--object-only") {
      o = LsOpts { ...o, mode: "object" };
    } else if (flags && x == "--full-name") {
      full_name = true;
    } else if (flags && x == "--full-tree") {
      full_tree = true;
    } else if (flags && x == "--abbrev") {
      o = LsOpts { ...o, abbrev: store.short_length(r.store()) };
    } else if (flags && x.starts_with("--abbrev=")) {
      o = LsOpts { ...o, abbrev: log_number(objects.part(x, 9, x.len())).max(4).min(2 * r.width) };
    } else if (flags && x.starts_with("-") && x.len() > 1) {
      return usage();
    } else {
      names = names.append(x);
    }
  }
  if (names.len() == 0) {
    return usage();
  }
  if (o.only_trees && o.recurse) {
    o = LsOpts { ...o, trees: true };
  }
  let prefix = if (full_tree) { "" } else { r.prefix };
  o = LsOpts { ...o, prefix: if (full_name || full_tree) { "" } else { prefix } };
  let items: string[] = [];
  for i in 1..names.len() {
    match (item_of(prefix, names[i], r.top)) {
      Ok(item) => {
        items = items.append(item);
      },
      Err(message) => {
        return fatal(message);
      }
    }
  }
  if (names.len() == 1 && prefix.len() > 0) {
    items = [prefix];
  }
  o = LsOpts { ...o, items: items };
  let named = rev.parse(r, r.store(), names[0]);
  print_errors(named.errors);
  if (named.died.len() > 0) {
    return fatal(named.died);
  }
  if (named.hash.len() == 0) {
    return fatal("Not a valid object name " + names[0]);
  }
  let top = rev.at_path(named.store, named.hash, "");
  if (top.hash.len() == 0) {
    return fatal("not a tree object");
  }
  let listed = ls_walk(Listing { store: top.store, out: [], ok: true }, top.hash, [], false, o);
  put(listed.out);
  if (!listed.ok) {
    return fatal("unable to read a tree of " + names[0]);
  }
  return 0;
}

// ---- log ----

// The count in `text`, or -1 when it is not a count.
function log_number(text: string): i32 {
  let n = 0;
  for i in 0..text.len() {
    if (text[i] < b'0' || text[i] > b'9' || n > 100000000) {
      return -1;
    }
    n = n * 10 + (text[i] - b'0') as i32;
  }
  return if (text.len() == 0) { -1 } else { n };
}

// The digits at the start of `text` as `strtoul` of C reads them, or 0.
function log_digits(text: string): i32 {
  let n = 0;
  let i = 0;
  while (i < text.len() && text[i] >= b'0' && text[i] <= b'9' && n < 100000000) {
    n = n * 10 + (text[i] - b'0') as i32;
    i += 1;
  }
  return n;
}

// The integer `text`, with a sign, or -1 when it is not one.
function log_digits_signed(text: string): i32 {
  if (text.starts_with("-")) {
    let n = log_number(objects.part(text, 1, text.len()));
    return if (n < 0) { -1 } else { -n };
  }
  return log_number(text);
}

// git 2.43 reads a limit that is not a count as 0.
function log_limit(text: string): i32 {
  return log_number(text).max(0);
}

// The options of log. `form` is a built-in form or "format", and `format`
// is the text of the format. `terminator` puts a line end after each
// commit, and its absence puts one between two commits. `diff` is "",
// "name-only" or "name-status", and `patch` holds the other forms of the
// diff. `no_output` is `-s`. `full_diff` shows each path of a commit that
// the pathspec selects, and `renames` finds the renames of the diff.
struct LogOpts { lines: string[], hi: log.Highlight, gpg: sig.Programs, show_signature: boolean, notes: notes.Tree[], notes_given: boolean, show_notes: boolean, notes_default: i32, notes_extra: string[], find: treediff.Detect, moved_default: i32, word_regex: string, merges: string, merges_need: boolean, imply_patch: boolean, pick: patch.Pickaxe, follow: boolean, walk_reflogs: boolean, reflog_names: string[], date_explicit: boolean, left_right: boolean, ancestry_names: string[], mm: mailmap.Mailmap, use_mailmap: boolean, limit: i32, skip: i32, form: string, format: string, terminator: boolean, abbrev_commit: boolean, dates: date.Mode, reverse: boolean, parents: boolean, graph: boolean, diff: string, patch: patch.Opts, no_output: boolean, names_twice: boolean, full_diff: boolean, renames: boolean, decorate: i32, decorate_filter: DecorationFilter, walk: revwalk.Opts, bad: string }

// The patterns of grep as the options give them.
struct GrepArgs { authors: string[], committers: string[], body: string[], all_match: boolean, invert: boolean, icase: boolean, kind: string }

// A form of `--pretty=` or `--format=`.
function log_form(o: LogOpts, text: string, from_format: boolean): LogOpts {
  for f in ["oneline", "short", "medium", "full", "fuller", "raw", "reference"] {
    if (text == f && !from_format || text == f && from_format) {
      return LogOpts { ...o, form: f, terminator: f == "oneline" || f == "reference", format: "" };
    }
  }
  if (text.starts_with("format:")) {
    return LogOpts { ...o, form: "format", format: objects.part(text, 7, text.len()), terminator: false };
  }
  if (text.starts_with("tformat:")) {
    return LogOpts { ...o, form: "format", format: objects.part(text, 8, text.len()), terminator: true };
  }
  if (text.contains("%") || from_format) {
    return LogOpts { ...o, form: "format", format: text, terminator: true };
  }
  return LogOpts { ...o, bad: "invalid --pretty format: " + text };
}

// The value of an option `--NAME=VALUE` or `--NAME VALUE`, and the count
// of arguments that it takes, or ("", 0).
function option_value(argv: string[], i: i32, name: string): (string, i32) {
  let x = argv[i];
  if (x.starts_with(name + "=")) {
    return (objects.part(x, name.len() + 1, x.len()), 1);
  }
  if (x == name && i + 1 < argv.len()) {
    return (argv[i + 1], 2);
  }
  return ("", 0);
}

// A time of `--since` and `--until`: the date that approxidate reads.
function log_time(text: string): i64 {
  let (t, _) = date.approxidate(text);
  return t;
}

// The diff with the form `f` on, and without `-s`.
function with_form(o: LogOpts, d: patch.Opts): LogOpts {
  return LogOpts { ...o, patch: d, no_output: false };
}

// The parts of `--stat=WIDTH,NAME-WIDTH,COUNT`.
function stat_value(d: patch.Opts, v: string): patch.Opts {
  let parts = v.split(",");
  let out = d;
  if (parts.len() > 0 && parts[0].len() > 0) {
    out = patch.Opts { ...out, stat_width: log_limit(parts[0]) };
  }
  if (parts.len() > 1 && parts[1].len() > 0) {
    out = patch.Opts { ...out, stat_name_width: log_limit(parts[1]) };
  }
  if (parts.len() > 2 && parts[2].len() > 0) {
    out = patch.Opts { ...out, stat_count: log_limit(parts[2]) };
  }
  return out;
}

// Reads the option of the diff at `i`, and gives the count of arguments
// that it takes, or 0 when it is not an option of the diff.
function diff_option(o: LogOpts, argv: string[], i: i32): (LogOpts, i32) {
  let x = argv[i];
  let d = o.patch;
  let algo = d.algo;
  if (x == "--color" || x.starts_with("--color=") || x == "--no-color") {
    let choice = if (x == "--no-color") { 0 } else if (x == "--color") { 1 } else { color_when(objects.part(x, 8, x.len())) };
    if (choice < 0) {
      return (LogOpts { ...o, bad: "error: option `color' expects \"always\", \"auto\", or \"never\"" }, 1);
    }
    return (LogOpts { ...o, patch: patch.Opts { ...d, color: wants_color(choice) } }, 1);
  }
  if (x == "--abbrev" || x == "--no-abbrev" || x.starts_with("--abbrev=")) {
    let n = if (x == "--abbrev") { -1 } else if (x == "--no-abbrev") { 0 } else { log_digits(objects.part(x, 9, x.len())).max(4) };
    return (LogOpts { ...o, patch: patch.Opts { ...d, abbrev: n } }, 1);
  }
  if (x == "-m" || x == "-c" || x == "--cc" || x == "--dd" || x == "--no-diff-merges") {
    let m = if (x == "-m") { "separate" } else if (x == "-c") { "combined" } else if (x == "--cc") { "dense-combined" } else if (x == "--dd") { "first-parent" } else { "off" };
    return (LogOpts { ...o, merges: m, merges_need: false, imply_patch: o.imply_patch || x == "-c" || x == "--cc" || x == "--dd" }, 1);
  }
  let (dm, dm_taken) = option_value(argv, i, "--diff-merges");
  if (dm_taken > 0) {
    let m = merges_value(dm);
    if (m.len() == 0) {
      return (LogOpts { ...o, bad: "invalid value for '--diff-merges': '" + dm + "'" }, dm_taken);
    }
    return (LogOpts { ...o, merges: m, merges_need: m != "off" }, dm_taken);
  }
  if (x == "--word-diff" || x.starts_with("--word-diff=")) {
    if (x == "--word-diff") {
      return (LogOpts { ...o, patch: patch.Opts { ...d, word_diff: if (d.word_diff == patch.WORDS_NONE) { patch.WORDS_PLAIN } else { d.word_diff } } }, 1);
    }
    let v = objects.part(x, 12, x.len());
    let forms = ["none", "plain", "color", "porcelain"];
    for k in 0..forms.len() {
      if (v == forms[k]) {
        return (LogOpts { ...o, patch: patch.Opts { ...d, word_diff: k, color: d.color || k == patch.WORDS_COLOR } }, 1);
      }
    }
    return (LogOpts { ...o, bad: "error: bad --word-diff argument: " + v }, 1);
  }
  if (x == "--color-words" || x.starts_with("--color-words=")) {
    let re = if (x == "--color-words") { "" } else { objects.part(x, 14, x.len()) };
    return (LogOpts { ...o, word_regex: re, patch: patch.Opts { ...d, word_diff: patch.WORDS_COLOR, color: true } }, 1);
  }
  let (wr, wr_taken) = option_value(argv, i, "--word-diff-regex");
  if (wr_taken > 0) {
    return (LogOpts { ...o, word_regex: wr, patch: patch.Opts { ...d, word_diff: if (d.word_diff == patch.WORDS_NONE) { patch.WORDS_PLAIN } else { d.word_diff } } }, wr_taken);
  }
  if (x == "--color-moved" || x == "--no-color-moved" || x.starts_with("--color-moved=")) {
    let form = if (x == "--no-color-moved") { moved.NO } else if (x == "--color-moved") { if (o.moved_default != moved.NO) { o.moved_default } else { moved.ZEBRA } } else { moved.parse(objects.part(x, 14, x.len())) };
    if (form < 0) {
      return (LogOpts { ...o, bad: "error: color moved setting must be one of 'no', 'default', 'blocks', 'zebra', 'dimmed-zebra', 'plain'\nerror: bad --color-moved argument: " + objects.part(x, 14, x.len()) }, 1);
    }
    return (LogOpts { ...o, patch: patch.Opts { ...d, color_moved: form } }, 1);
  }
  if (x == "--no-color-moved-ws" || x.starts_with("--color-moved-ws=")) {
    let (mode, errors) = if (x == "--no-color-moved-ws") { (0, []) } else { moved.parse_ws(objects.part(x, 17, x.len())) };
    if (errors.len() > 0) {
      return (LogOpts { ...o, bad: errors.join("\n") + "\nerror: invalid mode '" + objects.part(x, 17, x.len()) + "' in --color-moved-ws" }, 1);
    }
    return (LogOpts { ...o, patch: patch.Opts { ...d, color_moved_ws: mode } }, 1);
  }
  if (x == "--notes" || x == "--show-notes" || x == "--no-notes" || x.starts_with("--notes=") || x.starts_with("--show-notes=")) {
    if (x == "--no-notes") {
      return (LogOpts { ...o, notes_given: true, show_notes: false, notes_default: 0, notes_extra: [] }, 1);
    }
    let eq = x.index_of("=").unwrap_or(-1);
    if (eq < 0) {
      return (LogOpts { ...o, notes_given: true, show_notes: true, notes_default: 1 }, 1);
    }
    let name = notes.expand(objects.part(x, eq + 1, x.len()));
    return (LogOpts { ...o, notes_given: true, show_notes: true, notes_extra: o.notes_extra.append(name) }, 1);
  }
  if (x == "--show-signature" || x == "--no-show-signature") {
    return (LogOpts { ...o, show_signature: x == "--show-signature" }, 1);
  }
  if (x == "--raw" || x == "--patch-with-raw") {
    return (with_form(o, patch.Opts { ...d, raw: true, patch: d.patch || x == "--patch-with-raw" }), 1);
  }
  if (x == "-p" || x == "-u" || x == "--patch") {
    return (with_form(o, patch.Opts { ...d, patch: true }), 1);
  }
  if (x == "-s" || x == "--no-patch") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, raw: false, patch: false, stat: false, numstat: false, shortstat: false, summary: false }, diff: "", no_output: true }, 1);
  }
  if (x == "--stat") {
    return (with_form(o, patch.Opts { ...d, stat: true }), 1);
  }
  if (x.starts_with("--stat=")) {
    return (with_form(o, stat_value(patch.Opts { ...d, stat: true }, objects.part(x, 7, x.len()))), 1);
  }
  if (x == "--numstat") {
    return (with_form(o, patch.Opts { ...d, numstat: true }), 1);
  }
  if (x == "--shortstat") {
    return (with_form(o, patch.Opts { ...d, shortstat: true }), 1);
  }
  if (x == "--summary") {
    return (with_form(o, patch.Opts { ...d, summary: true }), 1);
  }
  if (x == "--patch-with-stat") {
    return (with_form(o, patch.Opts { ...d, patch: true, stat: true }), 1);
  }
  if (x.starts_with("-U") || x.starts_with("--unified=")) {
    let v = if (x.starts_with("-U")) { objects.part(x, 2, x.len()) } else { objects.part(x, 10, x.len()) };
    let n = log_number(v);
    if (v.len() > 0 && n < 0) {
      return (LogOpts { ...o, bad: "--unified expects a numerical value" }, 1);
    }
    return (with_form(o, patch.Opts { ...d, patch: true, context: if (v.len() > 0) { n } else { d.context } }), 1);
  }
  if (x == "--no-prefix") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, src: "", dst: "" } }, 1);
  }
  if (x == "--default-prefix") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, src: "a/", dst: "b/" } }, 1);
  }
  if (x == "--minimal") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, algo: linediff.Options { ...algo, minimal: true } } }, 1);
  }
  if (x == "--patience") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, algo: linediff.Options { ...algo, algorithm: linediff.PATIENCE } } }, 1);
  }
  if (x == "--histogram") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, algo: linediff.Options { ...algo, algorithm: linediff.HISTOGRAM } } }, 1);
  }
  if (x == "--indent-heuristic" || x == "--no-indent-heuristic") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, algo: linediff.Options { ...algo, indent_heuristic: x == "--indent-heuristic" } } }, 1);
  }
  if (x == "--full-index") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, full_index: true } }, 1);
  }
  if (x == "-a" || x == "--text") {
    return (LogOpts { ...o, patch: patch.Opts { ...d, text: true } }, 1);
  }
  if (x == "--full-diff") {
    return (LogOpts { ...o, full_diff: true }, 1);
  }
  if (x == "--no-renames") {
    return (LogOpts { ...o, renames: false }, 1);
  }
  if (x == "--find-copies-harder") {
    return (LogOpts { ...o, renames: true, find: treediff.Detect { ...o.find, copies: true, harder: true } }, 1);
  }
  let renaming = ["-M", "--find-renames=", "--find-renames", "-C", "--find-copies=", "--find-copies"];
  for name in renaming {
    if (x == name || name.ends_with("=") && x.starts_with(name) || name.len() == 2 && x.starts_with(name)) {
      let copies = name.starts_with("-C") || name.starts_with("--find-copies");
      let f = o.find;
      if (x.len() > name.len()) {
        let (score, rest) = treediff.parse_score(objects.part(x, name.len(), x.len()));
        if (rest.len() > 0) {
          return (LogOpts { ...o, bad: "error: invalid argument to " + (if (copies) { "find-copies" } else { "find-renames" }) }, 1);
        }
        f = treediff.Detect { ...f, min_score: score };
      }
      if (copies) {
        f = treediff.Detect { ...f, harder: f.harder || f.copies, copies: true };
      }
      return (LogOpts { ...o, renames: true, find: f }, 1);
    }
  }
  for name in ["--src-prefix", "--dst-prefix", "--diff-algorithm", "--inter-hunk-context", "--stat-width", "--stat-name-width", "--stat-graph-width", "--stat-count"] {
    let (v, taken) = option_value(argv, i, name);
    if (taken > 0) {
      if (name == "--src-prefix") {
        return (LogOpts { ...o, patch: patch.Opts { ...d, src: v } }, taken);
      }
      if (name == "--dst-prefix") {
        return (LogOpts { ...o, patch: patch.Opts { ...d, dst: v } }, taken);
      }
      if (name == "--diff-algorithm") {
        let a = diff_algorithm(algo, v);
        if (a.algorithm < 0) {
          return (LogOpts { ...o, bad: "option diff-algorithm accepts \"myers\", \"minimal\", \"patience\" and \"histogram\"" }, taken);
        }
        return (LogOpts { ...o, patch: patch.Opts { ...d, algo: a } }, taken);
      }
      let n = log_limit(v);
      if (name == "--inter-hunk-context") {
        return (LogOpts { ...o, patch: patch.Opts { ...d, interhunk: n } }, taken);
      }
      let st = patch.Opts { ...d, stat: true };
      if (name == "--stat-width") {
        return (with_form(o, patch.Opts { ...st, stat_width: n }), taken);
      }
      if (name == "--stat-name-width") {
        return (with_form(o, patch.Opts { ...st, stat_name_width: n }), taken);
      }
      if (name == "--stat-graph-width") {
        return (with_form(o, patch.Opts { ...st, stat_graph_width: n }), taken);
      }
      return (with_form(o, patch.Opts { ...st, stat_count: n }), taken);
    }
  }
  return (o, 0);
}

// The value of the path setting `name`, with `~/` as the home directory
// (`git_config_pathname`).
function config_path(r: refs.Repo, name: string, otherwise: string): string {
  let Some(v) = r.config.get(name) else {
    return otherwise;
  };
  if (v.starts_with("~/")) {
    return env("HOME").unwrap_or("") + objects.part(v, 1, v.len());
  }
  return v;
}

// The programs and the settings of the check of a signature. The last of
// `gpg.program` and `gpg.openpgp.program` names the program of gpg.
function gpg_programs(r: refs.Repo): sig.Programs {
  let openpgp = "gpg";
  for e in r.config.entries {
    if (e.name == "gpg.program" || e.name == "gpg.openpgp.program") {
      openpgp = e.value;
    }
  }
  let fault = sig.config_fault(r.config);
  if (openpgp.starts_with("~/")) {
    openpgp = env("HOME").unwrap_or("") + objects.part(openpgp, 1, openpgp.len());
  }
  return sig.Programs { dir: if (r.prefix.len() > 0) { r.top } else { "" }, openpgp: openpgp, x509: config_path(r, "gpg.x509.program", "gpgsm"), ssh: config_path(r, "gpg.ssh.program", "ssh-keygen"), allowed: config_path(r, "gpg.ssh.allowedsignersfile", ""), revocation: config_path(r, "gpg.ssh.revocationfile", ""), min_trust: sig.trust_of(r.config.get("gpg.mintrustlevel").unwrap_or("undefined")).max(0), config_error: fault.0, config_died: fault.1 };
}

// The check of the signature of the commit `body`
// (`check_commit_signature` of git).
function verify_signature(width: i32, body: u8[], programs: sig.Programs): sig.Check {
  let (payload, signature, signed) = sig.split(body, width);
  if (!signed) {
    return sig.unsigned();
  }
  return sig.check(programs, payload, signature, "committer");
}

// The object and the name of the tag `value`, or none for a tag that is
// not sound (`parse_tag_buffer` of git). The lines `object`, `type` and
// `tag` come first, in that order.
function tag_fields(value: u8[], width: i32): string[] {
  let text = unsafe { string_from_bytes_unchecked(value) };
  let hex = 2 * width;
  if (value.len() < hex + 24 || !text.starts_with("object ") || value[7 + hex] != b'\n') {
    return [];
  }
  let object = objects.part(text, 7, 7 + hex).to_ascii_lower();
  for i in 0..hex {
    if (!(object[i] >= b'0' && object[i] <= b'9' || object[i] >= b'a' && object[i] <= b'f')) {
      return [];
    }
  }
  let at = 8 + hex;
  if (!objects.part(text, at, text.len()).starts_with("type ")) {
    return [];
  }
  let Some(nl) = objects.part(text, at + 5, text.len()).index_of("\n") else {
    return [];
  };
  let kind = objects.part(text, at + 5, at + 5 + nl);
  if (kind.len() >= 20) {
    return [];
  }
  if (kind != "blob" && kind != "tree" && kind != "commit" && kind != "tag") {
    eprint("error: unknown tag type '" + kind + "' in " + objects.hash_of(width, "tag", value));
    return [];
  }
  at = at + 6 + nl;
  if (at + 4 >= text.len() || !objects.part(text, at, text.len()).starts_with("tag ")) {
    return [];
  }
  let Some(end) = objects.part(text, at + 4, text.len()).index_of("\n") else {
    return [];
  };
  return [object, objects.part(text, at + 4, at + 4 + end)];
}

// The lines of the signed tags of the merge `c` with `parents` in
// `--show-signature`: the tag and its parent, and the check of its
// signature (`show_one_mergetag` of git).
function mergetag_lines(o: LogOpts, sh_in: Shown, c: log.Commit, parents: string[], width: i32): (Shown, string) {
  let sh = sh_in;
  let out = "";
  for value in objects.extra_headers(c.body, "mergetag") {
    let text = "";
    let fields = tag_fields(value, width);
    if (fields.len() == 0) {
      text = "malformed mergetag\n";
    } else if (parents.len() == 2 && fields[0] == parents[1]) {
      text = "merged tag '" + fields[1] + "'\n";
    } else {
      text = match (parents.index_of(fields[0])) {
        Some(k) => "parent #" + (k + 1).to_string() + ", tagged '" + fields[1] + "'\n",
        None => "tag " + fields[1] + " names a non-parent " + fields[0] + "\n",
      };
    }
    let failed = true;
    let (payload, signature, signed) = sig.split_tag(value, width);
    if (signed) {
      let checked = sig.check(o.gpg, payload, signature, "tagger");
      if (checked.died.len() > 0) {
        return (Shown { ...sh, fatal: checked.died }, out);
      }
      text += if (checked.has_output) { checked.output } else { "No signature\n" };
      failed = checked.failed;
    }
    let (sh1, lines) = signature_lines(o, sh, text, failed);
    sh = sh1;
    out += lines;
  }
  return (sh, out);
}

// The lines of the check of a signature in `--show-signature`, each in the
// color of a good or a bad signature with the graph after it
// (`show_sig_lines` of git).
function signature_lines(o: LogOpts, sh_in: Shown, text: string, failed: boolean): (Shown, string) {
  let sh = sh_in;
  let set = if (!o.patch.color) { "" } else if (failed) { o.patch.pal.get(color.WHITESPACE) } else { o.patch.pal.get(color.FRAG) };
  let reset = if (o.patch.color) { color.RESET } else { "" };
  let out = "";
  let at = 0;
  while (at < text.len()) {
    let nl = __memchr_bytes(text.bytes(), 10, at);
    let end = if (nl < 0) { text.len() } else { nl };
    out += set + objects.part(text, at, end) + reset + (if (nl >= 0) { "\n" } else { "" });
    if (o.graph) {
      let (g, line, _) = graph.next_line(sh.graph);
      sh = Shown { ...sh, graph: g };
      out += line;
    }
    at = if (nl < 0) { text.len() } else { nl + 1 };
  }
  return (sh, out);
}

// The trees of the notes that log shows (`load_display_notes` of git):
// the default ref and the refs of `notes.displayRef`, unless an option
// names refs, and the refs of `--notes=`.
function notes_of(r: refs.Repo, s_in: store.Store, o: LogOpts): (store.Store, notes.Tree[]) {
  let globs: string[] = [];
  let names: string[] = [];
  if (o.notes_default > 0 || o.notes_default == -1 && o.notes_extra.len() == 0) {
    names = names.append(notes.default_ref(r));
    if let Some(v) = env("GIT_NOTES_DISPLAY_REF") {
      globs = v.split(":").filter((part: string): boolean => part.len() > 0);
    } else {
      globs = r.config.all("notes.displayref");
    }
  }
  for glob in globs.concat(o.notes_extra) {
    let (l, warnings) = notes.add_refs(r, s_in, names, glob);
    names = l;
    for line in warnings {
      eprint(line);
    }
  }
  let s = s_in;
  let trees: notes.Tree[] = [];
  for name in names {
    let (s1, t) = notes.load(r, s, name);
    s = s1;
    trees = trees.append(t);
  }
  return (s, trees);
}

// The diff of a merge that a value of `--diff-merges=` names, or "".
function merges_value(v: string): string {
  if (v == "off" || v == "none") {
    return "off";
  }
  if (v == "on" || v == "m" || v == "separate") {
    return "separate";
  }
  if (v == "first-parent" || v == "1") {
    return "first-parent";
  }
  if (v == "combined" || v == "c") {
    return "combined";
  }
  if (v == "dense-combined" || v == "cc") {
    return "dense-combined";
  }
  return "";
}

// The options of the diff that the configuration sets.
// The value of `--color=WHEN`: 0 for never, 1 for always, 2 for auto,
// or -1.
function color_when(v: string): i32 {
  let low = v.to_ascii_lower();
  return if (low == "never") { 0 } else if (low == "always") { 1 } else if (low == "auto") { 2 } else { -1 };
}

// The value of a color setting of the configuration: a value of
// `color_when`, or a boolean, where true is auto (`git_config_colorbool`).
function color_bool(c: config.Config, name: string, v: string): i32 {
  let choice = color_when(v);
  if (choice >= 0) {
    return choice;
  }
  return if (c.flag(name, false)) { 2 } else { 0 };
}

// True when the output has colors: auto gives colors to a terminal.
function wants_color(choice: i32): boolean {
  if (choice != 2) {
    return choice == 1;
  }
  return isatty(1) && env("TERM").unwrap_or("dumb") != "dumb";
}

function diff_config(r: refs.Repo, d: patch.Opts): patch.Opts {
  let c = r.config;
  let out = patch.Opts { ...d, pal: color.palette_of(c.entries.map((e: config.Entry): string => e.name), c.entries.map((e: config.Entry): string => e.value)) };
  let choice = 2;
  for name in ["color.ui", "color.diff", "diff.color"] {
    if let Some(v) = c.get(name) {
      choice = color_bool(c, name, v);
    }
  }
  out = patch.Opts { ...out, color: wants_color(choice) };
  if (c.flag("diff.noprefix", false)) {
    out = patch.Opts { ...out, src: "", dst: "" };
  }
  if let Some(v) = c.get("diff.context") {
    if (log_number(v) >= 0) {
      out = patch.Opts { ...out, context: log_number(v) };
    }
  }
  if let Some(v) = c.get("diff.interhunkcontext") {
    if (log_number(v) >= 0) {
      out = patch.Opts { ...out, interhunk: log_number(v) };
    }
  }
  if let Some(v) = c.get("diff.algorithm") {
    let a = diff_algorithm(out.algo, v);
    if (a.algorithm >= 0) {
      out = patch.Opts { ...out, algo: a };
    }
  }
  out = patch.Opts { ...out, algo: linediff.Options { ...out.algo, indent_heuristic: c.flag("diff.indentheuristic", true) } };
  if let Some(v) = c.get("diff.statnamewidth") {
    out = patch.Opts { ...out, stat_name_width: log_limit(v) };
  }
  if let Some(v) = c.get("diff.statgraphwidth") {
    out = patch.Opts { ...out, stat_graph_width: log_limit(v) };
  }
  return out;
}

// The search that `--diff-algorithm=NAME` selects, with an algorithm of
// -1 for a name that git does not know.
function diff_algorithm(a: linediff.Options, name: string): linediff.Options {
  let n = name.to_ascii_lower();
  if (n == "myers" || n == "default") {
    return linediff.Options { ...a, algorithm: linediff.MYERS };
  }
  if (n == "minimal") {
    return linediff.Options { ...a, algorithm: linediff.MYERS, minimal: true };
  }
  if (n == "patience") {
    return linediff.Options { ...a, algorithm: linediff.PATIENCE };
  }
  if (n == "histogram") {
    return linediff.Options { ...a, algorithm: linediff.HISTOGRAM };
  }
  return linediff.Options { ...a, algorithm: -1 };
}

// Reads the option at `i`, and gives the count of arguments that it takes,
// or 0 when it is not an option of log.
function log_option(o_in: LogOpts, g_in: GrepArgs, argv: string[], i: i32): (LogOpts, GrepArgs, i32) {
  let o = o_in;
  let g = g_in;
  let w = o.walk;
  let x = argv[i];
  let flags = ["--follow", "--pickaxe-all", "--pickaxe-regex", "-g", "--walk-reflogs", "--left-right", "--left-only", "--right-only", "--cherry-pick", "--cherry-mark", "--cherry", "--boundary", "--ancestry-path", "--simplify-by-decoration", "--simplify-merges", "--use-mailmap", "--mailmap", "--no-use-mailmap", "--no-mailmap", "--oneline", "--reverse", "--parents", "--graph", "--name-only", "--name-status", "--check", "--first-parent", "--topo-order", "--date-order", "--author-date-order", "--merges", "--no-merges", "--no-min-parents", "--no-max-parents", "--all-match", "--invert-grep", "-i", "--regexp-ignore-case", "-E", "--extended-regexp", "-F", "--fixed-strings", "--basic-regexp", "--abbrev-commit", "--no-abbrev-commit", "--relative-date", "--decorate", "--no-decorate", "--full-history", "--pretty", "--decorate=short", "--decorate=no", "--decorate=full", "--decorate=auto", "--clear-decorations"];
  if (flags.contains(x)) {
    if (x == "--follow") {
      o = LogOpts { ...o, follow: true };
    } else if (x == "--pickaxe-all") {
      o = LogOpts { ...o, pick: patch.Pickaxe { ...o.pick, all: true } };
    } else if (x == "--pickaxe-regex") {
      o = LogOpts { ...o, pick: patch.Pickaxe { ...o.pick, regex: true } };
    } else if (x == "-g" || x == "--walk-reflogs") {
      o = LogOpts { ...o, walk_reflogs: true };
    } else if (x == "--left-right") {
      o = LogOpts { ...o, left_right: true };
    } else if (x == "--left-only") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, left_only: true } };
    } else if (x == "--right-only") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, right_only: true } };
    } else if (x == "--cherry-pick") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, cherry_pick: true } };
    } else if (x == "--cherry-mark") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, cherry_mark: true } };
    } else if (x == "--cherry") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, right_only: true, cherry_mark: true, max_parents: 1 } };
    } else if (x == "--boundary") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, boundary: true } };
    } else if (x == "--ancestry-path") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, ancestry: true, full_history: true } };
    } else if (x == "--simplify-by-decoration") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, by_decoration: true, simplify_merges: true, topo: true, rewrite: true, full_history: true } };
    } else if (x == "--simplify-merges") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, simplify_merges: true, topo: true, rewrite: true, full_history: true } };
    } else if (x == "--use-mailmap" || x == "--mailmap" || x == "--no-use-mailmap" || x == "--no-mailmap") {
      o = LogOpts { ...o, use_mailmap: !x.starts_with("--no-") };
    } else if (x == "--oneline") {
      o = LogOpts { ...log_form(o, "oneline", false), abbrev_commit: true };
    } else if (x == "--pretty") {
      o = log_form(o, "medium", false);
    } else if (x == "--reverse") {
      o = LogOpts { ...o, reverse: true };
    } else if (x == "--parents") {
      o = LogOpts { ...o, parents: true, walk: revwalk.Opts { ...w, rewrite: true } };
    } else if (x == "--graph") {
      o = LogOpts { ...o, graph: true, walk: revwalk.Opts { ...w, rewrite: true, topo: true } };
    } else if (x == "--name-only" || x == "--name-status" || x == "--check") {
      o = LogOpts { ...o, diff: objects.part(x, 2, x.len()), names_twice: o.names_twice || o.diff.len() > 0 && o.diff != objects.part(x, 2, x.len()) || o.no_output };
    } else if (x == "--first-parent") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, first_parent: true } };
    } else if (x == "--topo-order") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, topo: true, order: revwalk.BY_GRAPH } };
    } else if (x == "--date-order") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, topo: true, order: revwalk.BY_DATE } };
    } else if (x == "--author-date-order") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, topo: true, order: revwalk.BY_AUTHOR } };
    } else if (x == "--merges") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, min_parents: 2 } };
    } else if (x == "--no-merges") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, max_parents: 1 } };
    } else if (x == "--no-min-parents") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, min_parents: 0 } };
    } else if (x == "--no-max-parents") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, max_parents: -1 } };
    } else if (x == "--full-history") {
      o = LogOpts { ...o, walk: revwalk.Opts { ...w, full_history: true } };
    } else if (x == "--all-match") {
      g = GrepArgs { ...g, all_match: true };
    } else if (x == "--invert-grep") {
      g = GrepArgs { ...g, invert: true };
    } else if (x == "-i" || x == "--regexp-ignore-case") {
      g = GrepArgs { ...g, icase: true };
    } else if (x == "-E" || x == "--extended-regexp") {
      g = GrepArgs { ...g, kind: "extended" };
    } else if (x == "-F" || x == "--fixed-strings") {
      g = GrepArgs { ...g, kind: "fixed" };
    } else if (x == "--basic-regexp") {
      g = GrepArgs { ...g, kind: "basic" };
    } else if (x == "--abbrev-commit") {
      o = LogOpts { ...o, abbrev_commit: true };
    } else if (x == "--no-abbrev-commit") {
      o = LogOpts { ...o, abbrev_commit: false };
    } else if (x == "--relative-date") {
      o = LogOpts { ...o, dates: date.Mode { kind: date.RELATIVE, local: false, format: "" }, date_explicit: true };
    } else if (x == "--decorate" || x == "--decorate=short") {
      o = LogOpts { ...o, decorate: 1 };
    } else if (x == "--decorate=full") {
      o = LogOpts { ...o, decorate: 2 };
    } else if (x == "--no-decorate" || x == "--decorate=no" || x == "--decorate=auto") {
      o = LogOpts { ...o, decorate: 0 };
    } else if (x == "--clear-decorations") {
      o = LogOpts { ...o, decorate_filter: DecorationFilter { include: [], exclude: [], config_exclude: [], clear: true } };
    }
    return (o, g, 1);
  }
  let (od, dtaken) = diff_option(o, argv, i);
  if (dtaken > 0) {
    return (od, g, dtaken);
  }
  if (x == "-n" && i + 1 < argv.len()) {
    return (LogOpts { ...o, limit: log_limit(argv[i + 1]) }, g, 2);
  }
  if (x.starts_with("-n") && log_number(objects.part(x, 2, x.len())) >= 0) {
    return (LogOpts { ...o, limit: log_number(objects.part(x, 2, x.len())) }, g, 1);
  }
  if (x.starts_with("-") && !x.starts_with("--") && log_number(objects.part(x, 1, x.len())) >= 0) {
    return (LogOpts { ...o, limit: log_number(objects.part(x, 1, x.len())) }, g, 1);
  }
  if (x.starts_with("-S") || x.starts_with("-G")) {
    let kind = if (x.starts_with("-S")) { 1 } else { 2 };
    if (x.len() > 2) {
      return (LogOpts { ...o, pick: patch.Pickaxe { ...o.pick, kind: kind, needle: objects.part(x, 2, x.len()) } }, g, 1);
    }
    if (i + 1 < argv.len()) {
      return (LogOpts { ...o, pick: patch.Pickaxe { ...o.pick, kind: kind, needle: argv[i + 1] } }, g, 2);
    }
  }
  if (x.starts_with("--ancestry-path=")) {
    return (LogOpts { ...o, ancestry_names: o.ancestry_names.append(objects.part(x, 16, x.len())), walk: revwalk.Opts { ...w, ancestry: true, full_history: true } }, g, 1);
  }
  for name in ["--decorate-refs", "--decorate-refs-exclude"] {
    let (v, taken) = option_value(argv, i, name);
    if (taken > 0) {
      let f = o.decorate_filter;
      let p = ref_pattern(v);
      let nf = if (name == "--decorate-refs") { DecorationFilter { ...f, include: f.include.append(p) } } else { DecorationFilter { ...f, exclude: f.exclude.append(p) } };
      return (LogOpts { ...o, decorate_filter: nf }, g, taken);
    }
  }
  let valued = ["--max-count", "--skip", "--format", "--pretty", "--date", "--since", "--after", "--until", "--before", "--max-age", "--min-age", "--author", "--committer", "--grep", "--min-parents", "--max-parents"];
  // The options of revision.c that take the next argument
  // (`parse_long_opt`) need one.
  let next_valued = ["--max-count", "--skip", "--date", "--since", "--after", "--until", "--before", "--max-age", "--min-age", "--author", "--committer", "--grep"];
  if (next_valued.contains(x) && i + 1 >= argv.len()) {
    return (LogOpts { ...o, bad: "Option '" + x + "' requires a value" }, g, 1);
  }
  for name in valued {
    let (v, taken) = option_value(argv, i, name);
    if (taken > 0 && !(name == "--pretty" && taken == 2)) {
      if (name == "--max-count") {
        o = LogOpts { ...o, limit: log_limit(v) };
      } else if (name == "--skip") {
        o = LogOpts { ...o, skip: log_limit(v) };
      } else if (name == "--format") {
        o = log_form(o, v, true);
      } else if (name == "--pretty") {
        o = log_form(o, v, false);
      } else if (name == "--date") {
        o = match (date.parse_mode(v)) {
          Ok(m) => LogOpts { ...o, dates: m, date_explicit: true },
          Err(message) => LogOpts { ...o, bad: message },
        };
      } else if (name == "--since" || name == "--after") {
        o = LogOpts { ...o, walk: revwalk.Opts { ...w, max_age: log_time(v) } };
      } else if (name == "--until" || name == "--before") {
        o = LogOpts { ...o, walk: revwalk.Opts { ...w, min_age: log_time(v) } };
      } else if (name == "--max-age") {
        o = LogOpts { ...o, walk: revwalk.Opts { ...w, max_age: log_limit(v) as i64 } };
      } else if (name == "--min-age") {
        o = LogOpts { ...o, walk: revwalk.Opts { ...w, min_age: log_limit(v) as i64 } };
      } else if (name == "--author") {
        g = GrepArgs { ...g, authors: g.authors.append(v) };
      } else if (name == "--committer") {
        g = GrepArgs { ...g, committers: g.committers.append(v) };
      } else if (name == "--grep") {
        g = GrepArgs { ...g, body: g.body.append(v) };
      } else if (name == "--min-parents") {
        o = LogOpts { ...o, walk: revwalk.Opts { ...w, min_parents: log_limit(v) } };
      } else if (name == "--max-parents") {
        o = LogOpts { ...o, walk: revwalk.Opts { ...w, max_parents: log_number(v) } };
      }
      return (o, g, taken);
    }
  }
  return (o, g, 0);
}

// The patterns of grep for the colors of their matches, with the colors
// of `color.grep.selected` and `color.grep.matchSelected` (or
// `color.grep.match`).
function highlight_of(r: refs.Repo, g: revwalk.Grep): log.Highlight {
  let conv = (ps: revwalk.Pattern[]): log.HiPattern[] => ps.map((p: revwalk.Pattern): log.HiPattern => if (p.is_fixed) { log.HiPattern { re: [], fixed: p.fixed, icase: p.icase } } else { log.HiPattern { re: [p.re], fixed: "", icase: p.icase } });
  let line = "";
  let matched = "\x1b[1;31m";
  for e in r.config.entries {
    if (e.name == "color.grep.selected") {
      line = color.parse(e.value).unwrap_or(line);
    } else if (e.name == "color.grep.matchselected" || e.name == "color.grep.match") {
      matched = color.parse(e.value).unwrap_or(matched);
    }
  }
  return log.Highlight { body: conv(g.body), authors: conv(g.authors), committers: conv(g.committers), line: line, matched: matched, invert: g.invert };
}

// The compiled patterns of grep, or the message of git for a pattern that
// is not sound.
function grep_of(g: GrepArgs): Result[revwalk.Grep, string] {
  let compile = (text: string): Result[revwalk.Pattern, string] => {
    let syntax = bre.Syntax { ...bre.posix_basic(), extended: g.kind == "extended", icase: g.icase };
    if (g.kind == "fixed") {
      return Ok(revwalk.Pattern { re: bre.bre_compile_syntax("", syntax), fixed: text, is_fixed: true, icase: g.icase });
    }
    let re = bre.bre_compile_syntax(text, syntax);
    if (re.err.len() > 0) {
      return Err("command line, '" + text + "': " + re.err);
    }
    return Ok(revwalk.Pattern { re: re, fixed: "", is_fixed: false, icase: g.icase });
  };
  let out = revwalk.Grep { ...revwalk.no_grep(), all_match: g.all_match, invert: g.invert };
  for a in g.authors {
    out = revwalk.Grep { ...out, authors: out.authors.append(compile(a)?) };
  }
  for c in g.committers {
    out = revwalk.Grep { ...out, committers: out.committers.append(compile(c)?) };
  }
  for b in g.body {
    out = revwalk.Grep { ...out, body: out.body.append(compile(b)?) };
  }
  return Ok(out);
}

// A pattern of `--decorate-refs`: a full ref name with `refs/` before
// it, and with no `/` at its end. A pattern with no wildcard matches the
// refs below it (`normalize_glob_ref` of git).
function ref_pattern(text: string): string {
  let p = if (!text.starts_with("refs/") && text != "HEAD") { "refs/" + text } else { text };
  return if (p.ends_with("/")) { objects.part(p, 0, p.len() - 1) } else { p };
}

function pattern_matches(pattern: string, name: string): boolean {
  if (treediff.has_wildcard(pattern)) {
    return fnmatch.fnmatch(pattern, name);
  }
  return name.starts_with(pattern) && (name.len() == pattern.len() || name[pattern.len()] == b'/');
}

// The filter of the decorations: the patterns of `--decorate-refs`, of
// `--decorate-refs-exclude` and of `log.excludeDecoration`, and whether
// `--clear-decorations` turns off the default set.
struct DecorationFilter { include: string[], exclude: string[], config_exclude: string[], clear: boolean }

// True when the filter shows the ref `name`: `ref_filter_match` of git,
// with the default set of git 2.43 when no pattern is given.
function decorates(f: DecorationFilter, name: string): boolean {
  for p in f.exclude {
    if (pattern_matches(p, name)) {
      return false;
    }
  }
  if (f.include.len() > 0) {
    for p in f.include {
      if (pattern_matches(p, name)) {
        return true;
      }
    }
    return false;
  }
  for p in f.config_exclude {
    if (pattern_matches(p, name)) {
      return false;
    }
  }
  if (f.clear || f.exclude.len() > 0 || f.config_exclude.len() > 0) {
    return true;
  }
  for p in ["refs/heads/", "refs/tags/", "refs/remotes/", "refs/replace/"] {
    if (name.starts_with(p)) {
      return true;
    }
  }
  return name == "HEAD" || name == "refs/stash";
}

// The kind of the decoration of the ref `name`.
function decoration_kind(name: string): i32 {
  if (name.starts_with("refs/heads/")) {
    return color.DECORATION_LOCAL;
  }
  if (name.starts_with("refs/remotes/")) {
    return color.DECORATION_REMOTE;
  }
  if (name.starts_with("refs/tags/")) {
    return color.DECORATION_TAG;
  }
  if (name.starts_with("refs/replace/")) {
    return color.DECORATION_GRAFTED;
  }
  return if (name == "refs/stash") { color.DECORATION_STASH } else { color.DECORATION_NONE };
}

// The decorations of each commit: the refs that name it, as `git log`
// shows them, with `HEAD -> BRANCH` when HEAD names a branch of the
// commit. `full` keeps the whole names of the refs.
function decorations_of(r: refs.Repo, s: store.Store, full: boolean, f: DecorationFilter): (store.Store, Map[string, log.Decoration[]]) {
  let by: Map[string, log.Decoration[]] = Map { };
  let st = s;
  let add = (m: Map[string, log.Decoration[]], hash: string, d: log.Decoration): Map[string, log.Decoration[]] => m.insert(hash, [d].concat(m.get_or(hash, [])));
  for e in refs.all_refs(r) {
    if (decorates(f, e.name)) {
      let short = if (full) { e.name } else if (e.name.starts_with("refs/heads/")) { objects.part(e.name, 11, e.name.len()) } else if (e.name.starts_with("refs/remotes/")) { objects.part(e.name, 13, e.name.len()) } else if (e.name.starts_with("refs/tags/")) { objects.part(e.name, 10, e.name.len()) } else { e.name };
      let shown = log.Decoration { name: short, kind: decoration_kind(e.name), branch: "" };
      let at = e.hash;
      by = add(by, at, shown);
      for step in 0..16 {
        let got = store.read(st, at);
        st = got.store;
        if let Ok(o) = got.object {
          if (o.kind == "tag") {
            let next = objects.header_values(o.body, "object");
            if (next.len() > 0 && e.name.starts_with("refs/tags/")) {
              at = next[0];
              by = add(by, at, shown);
            }
          }
        }
      }
    }
  }
  let head = refs.resolve_ref(r, "HEAD");
  if (head.hash.len() > 0 && decorates(f, "HEAD")) {
    let branch = refs.head_branch(r);
    let list = by.get_or(head.hash, []);
    let short = if (full) { branch } else if (branch.starts_with("refs/heads/")) { objects.part(branch, 11, branch.len()) } else { "" };
    let current = (d: log.Decoration): boolean => d.kind == color.DECORATION_LOCAL && d.name == short;
    if (branch.starts_with("refs/heads/") && list.any(current)) {
      let others: log.Decoration[] = list.filter((d: log.Decoration): boolean => !current(d));
      by = by.insert(head.hash, [log.Decoration { name: "HEAD", kind: color.DECORATION_HEAD, branch: short }].concat(others));
    } else {
      by = by.insert(head.hash, [log.Decoration { name: "HEAD", kind: color.DECORATION_HEAD, branch: "" }].concat(list));
    }
  }
  return (st, by);
}

// The changes of the commit `c` against the commit `parent`, or against
// no commit for "", with the renames and the pickaxe. With `--full-diff`
// the changes are not limited to the pathspec.
function commit_changes(st: store.Store, c: log.Commit, parent: string, o: LogOpts, follow: string): (store.Store, treediff.Change[], string) {
  let (s1, changes, path) = commit_diff(st, c, parent, o, follow);
  if (o.pick.kind == 0) {
    return (s1, changes, path);
  }
  let (s2, kept) = patch.pickaxe(s1, changes, o.pick, o.patch);
  return (s2, kept, path);
}

// The diff of a merge that the options select (`--diff-merges=` of git):
// "off", "first-parent", "separate", "combined" or "dense-combined".
// `--first-parent` gives the diff from the first parent, unless an option
// selects another diff.
function merge_mode(o: LogOpts): string {
  if (o.merges == "" || o.merges == "separate") {
    return if (o.walk.first_parent) { "first-parent" } else if (o.merges == "") { "off" } else { "separate" };
  }
  return o.merges;
}

// The changes of a commit from a parent, and the parent of `-m` for the
// line `commit HASH (from PARENT)`, or "".
struct Diff { from: string, changes: treediff.Change[] }

// The diffs of the commit `c`: one for a commit with one parent or none,
// and for a merge none, one from the first parent, or one from each
// parent with `-m`.
function commit_diffs(st: store.Store, c: log.Commit, parents: string[], o: LogOpts, follow: string): (store.Store, Diff[], string) {
  let mode = merge_mode(o);
  if (parents.len() <= 1 || mode == "first-parent") {
    let (s1, changes, path) = commit_changes(st, c, if (parents.len() > 0) { parents[0] } else { "" }, o, follow);
    return (s1, [Diff { from: "", changes: changes }], path);
  }
  if (mode != "separate") {
    return (st, [], follow);
  }
  let s = st;
  let path = follow;
  let out: Diff[] = [];
  for p in parents {
    let (s2, changes, path2) = commit_changes(s, c, p, o, follow);
    s = s2;
    path = path2;
    out = out.append(Diff { from: p, changes: changes });
  }
  return (s, out, path);
}

// True when a diff has a change.
function any_change(diffs: Diff[]): boolean {
  return diffs.any((d: Diff): boolean => d.changes.len() > 0);
}

// The source of the file `path` that the commit adds, as `--follow` finds
// it: a deleted file or a file that stays, whose content is close enough
// (`try_to_follow_renames` of git). The change is a rename or a copy, or
// none.
function follow_source(st: store.Store, base: string, tree: string, path: u8[]): (store.Store, treediff.Change[]) {
  let (s1, all) = treediff.changes(st, base, tree, []);
  let dst: treediff.Change[] = all.filter((c: treediff.Change): boolean => c.status == b'A' && c.path == path);
  if (dst.len() == 0) {
    return (s1, []);
  }
  // Each file of the parent is a source: a deleted one gives a rename,
  // one that stays gives a copy.
  let (s2, old) = treediff.changes(s1, "", base, []);
  let deleted: Map[string, boolean] = Map { };
  for c in all {
    if (c.status == b'D') {
      deleted = deleted.insert(unsafe { string_from_bytes_unchecked(c.path) }, true);
    }
  }
  let zero = "0".repeat(2 * st.width);
  let sources: treediff.Change[] = [];
  for c in old {
    sources = sources.append(treediff.Change { status: b'D', path: c.path, old_mode: c.new_mode, new_mode: "", old_hash: c.new_hash, new_hash: zero, old_path: c.path, score: 0 });
  }
  let (s3, found) = treediff.copies(s2, dst.concat(sources));
  for c in found {
    if (c.status == b'R' && c.path == path) {
      let stays = !deleted.contains(unsafe { string_from_bytes_unchecked(c.old_path) });
      return (s3, [treediff.Change { ...c, status: if (stays) { b'C' } else { b'R' } }]);
    }
  }
  return (s3, dst);
}

function commit_diff(st: store.Store, c: log.Commit, parent: string, o: LogOpts, follow: string): (store.Store, treediff.Change[], string) {
  let s = st;
  let base = "";
  if (parent.len() > 0) {
    let got = store.read(s, parent);
    s = got.store;
    if let Ok(p) = got.object {
      base = log.commit_of(parent, p.body).tree;
    }
  }
  if (o.follow) {
    let (after, found) = treediff.changes(s, base, c.tree, [follow]);
    // git looks for the source only of a path that is the pathspec.
    if (found.len() == 1 && found[0].status == b'A' && found[0].path == follow.bytes()) {
      let (s2, chosen) = follow_source(after, base, c.tree, found[0].path);
      if (chosen.len() == 1 && chosen[0].status != b'A') {
        return (s2, chosen, unsafe { string_from_bytes_unchecked(chosen[0].old_path) });
      }
      return (s2, found, follow);
    }
    if (!o.renames) {
      return (after, found, follow);
    }
    let (s3, renamed) = treediff.renames(after, found);
    return (s3, renamed, follow);
  }
  let items = if (o.full_diff) { [] } else { o.walk.items };
  let (after, found) = treediff.changes(s, base, c.tree, items);
  if (!o.renames) {
    return (after, found, follow);
  }
  let (s4, renamed) = treediff.detect(after, found, o.find, base, items);
  return (s4, renamed, follow);
}

// The lines of `--name-only` or `--name-status`.
function name_lines(changes: treediff.Change[], o: LogOpts): string {
  let out = "";
  for ch in changes {
    let path = unsafe { string_from_bytes_unchecked(objects.quoted(ch.path)) };
    let status = unsafe { string_from_bytes_unchecked([ch.status]) };
    if (o.diff == "name-only") {
      out += path + "\n";
    } else if (ch.status == b'R' || ch.status == b'C') {
      let old = unsafe { string_from_bytes_unchecked(objects.quoted(ch.old_path)) };
      out += status + (ch.score * 100 / 60000).to_string().pad_start_str(3, "0") + "\t" + old + "\t" + path + "\n";
    } else {
      out += status + "\t" + unsafe { string_from_bytes_unchecked(objects.quoted(ch.old_path)) } + "\n";
    }
  }
  return out;
}

// The pathspec of the paths `args`, from the current directory, or the
// message of git.
function log_items(r: refs.Repo, args: string[]): Result[string[], string] {
  let items: string[] = [];
  for a in args {
    if (a.starts_with(":/")) {
      items = items.append(objects.part(a, 2, a.len()));
    } else {
      items = items.append(item_of(r.prefix, a, r.top)?);
    }
  }
  return Ok(items);
}

// The commit that `text` names, or "", and the message of git when it
// stops.
function log_commit(r: refs.Repo, w: revwalk.Walk, text: string): (revwalk.Walk, string, string) {
  let named = rev.parse_with(r, w.g.store, text, rev.COMMITTISH);
  print_errors(named.errors);
  if (named.hash.len() == 0) {
    return (revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: named.store } }, "", named.died);
  }
  let c = rev.commit_of(named.store, named.hash);
  print_errors(c.errors);
  return (revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: c.store } }, c.hash, "");
}

// Adds the commits that `name` gives to the walk: a range, the shorthands
// for parents, an excluded commit, or one commit. The second value is
// false when `name` is no revision, and the third is the message of git
// when it stops.
function log_rev(r: refs.Repo, w_in: revwalk.Walk, name: string, excluded: boolean, dashdash: boolean): (revwalk.Walk, boolean, string) {
  let w = w_in;
  if (w.opts.reflog_walk) {
    // A walk of the reflogs takes the names of refs, and no ranges.
    let check = name;
    let range = false;
    if let Some(dots) = name.index_of("..") {
      check = objects.part(name, 0, dots);
      range = true;
    } else if (name.starts_with("^")) {
      check = objects.part(name, 1, name.len());
      range = true;
    }
    if (check.len() == 0) {
      check = "HEAD";
    }
    let named = rev.parse_with(r, w.g.store, check, rev.COMMITTISH);
    print_errors(named.errors);
    w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: named.store } };
    if (named.died.len() > 0) {
      return (w, false, named.died);
    }
    if (named.hash.len() == 0) {
      return (w, false, "");
    }
    if (range || excluded) {
      return (w, true, "cannot walk reflogs for " + check);
    }
    return (revwalk.Walk { ...w, pending: w.pending.append(name), names: w.names.append(name) }, true, "");
  }
  let off = if (excluded) { revwalk.UNINTERESTING | revwalk.BOTTOM } else { 0 };
  let on = if (excluded) { 0 } else { revwalk.UNINTERESTING | revwalk.BOTTOM };
  if let Some(dots) = name.index_of("..") {
    let symmetric = dots + 2 < name.len() && name[dots + 2] == b'.';
    let a = objects.part(name, 0, dots);
    let b = objects.part(name, dots + (if (symmetric) { 3 } else { 2 }), name.len());
    if (a.len() > 0 || b.len() > 0 || symmetric) {
      let (w1, ha, da) = log_commit(r, w, if (a.len() == 0) { "HEAD" } else { a });
      w = w1;
      if (da.len() > 0) {
        return (w, false, da);
      }
      let (w2, hb, db) = log_commit(r, w, if (b.len() == 0) { "HEAD" } else { b });
      w = w2;
      if (db.len() > 0) {
        return (w, false, db);
      }
      if (ha.len() > 0 && hb.len() > 0) {
        if (symmetric) {
          let (g, bases) = walk.merge_bases(w.g, ha, [hb]);
          w = revwalk.Walk { ...w, g: g };
          for base in bases {
            w = revwalk.add(w, base, revwalk.UNINTERESTING | revwalk.BOTTOM);
          }
          w = revwalk.add_named(w, ha, off | revwalk.LEFT, if (a.len() == 0) { "HEAD" } else { a });
          w = revwalk.add_named(w, hb, off, if (b.len() == 0) { "HEAD" } else { b });
        } else {
          w = revwalk.add_named(w, ha, on, if (a.len() == 0) { "HEAD" } else { a });
          w = revwalk.add_named(w, hb, off, if (b.len() == 0) { "HEAD" } else { b });
        }
        return (w, true, "");
      }
    }
  }
  for mark in ["^@", "^!", "^-"] {
    if let Some(at) = name.index_of(mark) {
      let tail = objects.part(name, at + 2, name.len());
      let exclude = if (mark == "^-") { if (tail.len() == 0) { 1 } else { log_number(tail) } } else { 0 };
      if (tail.len() == 0 || mark == "^-" && exclude > 0) {
        let (w1, h, d) = log_commit(r, w, objects.part(name, 0, at));
        w = w1;
        if (d.len() > 0) {
          return (w, false, d);
        }
        if (h.len() > 0) {
          let (w2, ps) = revwalk.parents(w, h);
          w = w2;
          if (mark != "^-" || exclude <= ps.len()) {
            for i in 0..ps.len() {
              if (mark != "^-" || i + 1 == exclude) {
                w = revwalk.add_named(w, ps[i], if (mark == "^@") { off } else { on }, name);
              }
            }
            if (mark != "^@") {
              w = revwalk.add_named(w, h, off, objects.part(name, 0, at));
            }
            return (w, true, "");
          }
        }
      }
    }
  }
  let not = name.starts_with("^");
  let plain = if (not) { objects.part(name, 1, name.len()) } else { name };
  let named = rev.parse_with(r, w.g.store, plain, rev.COMMITTISH);
  print_errors(named.errors);
  w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: named.store } };
  if (named.died.len() > 0) {
    return (w, false, named.died);
  }
  if (named.hash.len() == 0) {
    return (w, false, "");
  }
  if (!dashdash && !looks_like_pathspec(name) && path_exists(r, name)) {
    return (w, true, "ambiguous argument '" + name + "': both revision and filename\nUse '--' to separate paths from revisions, like this:\n'git <command> [<revision>...] -- [<file>...]'");
  }
  // A tag that names no commit, a tree and a blob add nothing to the walk.
  let (s, at, kind) = peel_commit(w.g.store, named.hash);
  w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s } };
  if (kind == "commit") {
    w = revwalk.add_named(w, at, if (not) { on } else { off }, plain);
  }
  return (w, true, "");
}

// The object after the tags of `hash`, and its kind.
function peel_commit(s: store.Store, hash: string): (store.Store, string, string) {
  let st = s;
  let at = hash;
  for step in 0..64 {
    let got = store.read(st, at);
    st = got.store;
    let Ok(o) = got.object else {
      return (st, "", "");
    };
    if (o.kind != "tag") {
      return (st, at, o.kind);
    }
    let next = objects.header_values(o.body, "object");
    if (next.len() == 0) {
      return (st, "", "");
    }
    at = next[0];
  }
  return (st, "", "");
}

// The refs of `--all`, `--branches`, `--tags` and `--remotes`.
function ref_option(x: string): string {
  return match (x) {
    "--all" => "refs/",
    "--branches" => "refs/heads/",
    "--tags" => "refs/tags/",
    "--remotes" => "refs/remotes/",
    _ => "",
  };
}

// The ranges of the arguments `args` of `-L` in the one commit that the
// revisions give (`line_log_init`), or the message of git.
function line_log_init(r: refs.Repo, w_in: revwalk.Walk, args: string[]): (revwalk.Walk, string) {
  let w = w_in;
  let start = "";
  let start_name = "";
  for k in 0..w.pending.len() {
    let h = w.pending[k];
    if ((revwalk.flag(w, h) & revwalk.UNINTERESTING) != 0) {
      continue;
    }
    if (start.len() > 0) {
      return (w, "More than one commit to dig from: " + w.names[k] + " and " + start_name + "?");
    }
    start = h;
    start_name = w.names[k];
  }
  if (start.len() == 0) {
    return (w, "No commit specified?");
  }
  let (g, n) = walk.node(w.g, start);
  let (s, entries, died) = linelog.parse(g.store, n.tree, r.prefix, r.top, args, userdiff.from_config(r.config), [attr.load(r)]);
  w = revwalk.Walk { ...w, g: walk.Graph { ...g, store: s } };
  if (died.len() > 0) {
    return (w, died);
  }
  return (revwalk.with_lines(w, start, entries), "");
}

// The state of the output of log: the graph, and whether a commit is shown
// and its text had no line end at its end.
// `follow` is the path that `--follow` follows now.
// `hidden` is true when the last commit gave no text.
struct Shown { graph: graph.Graph, any: boolean, missing: boolean, follow: string, hidden: boolean, failed: boolean, fatal: string }

// The padding of the graph before a line, or "" with no graph.
function graph_pad(o: LogOpts, sh: Shown): (Shown, string) {
  if (!o.graph) {
    return (sh, "");
  }
  let (g, line) = graph.padding_line(sh.graph);
  return (Shown { ...sh, graph: g }, line);
}

// The text of one commit, as `show_log` of git prints it, and the diff of
// `changes`, or no diff when there are no changes.
function entry_text(st: store.Store, c: log.Commit, o: LogOpts, ctx: log.Context, least: i32, sh_in: Shown, changes: treediff.Change[]): (store.Store, string, Shown) {
  let s = st;
  let sh = sh_in;
  let out = "";
  if (sh.any && !o.terminator) {
    if (!sh.missing) {
      let (sh1, p) = graph_pad(o, sh);
      sh = sh1;
      out += p;
    }
    out += "\n";
  }
  sh = Shown { ...sh, any: true };
  if (o.graph) {
    let (g, lines) = graph.show_commit(sh.graph);
    sh = Shown { ...sh, graph: g };
    out += lines;
  }
  let user = o.form == "format" || o.form == "reference";
  if (!user) {
    out += log.first_line(c, ctx, o.form, o.parents);
    if (o.form == "oneline") {
      out += " ";
    } else {
      out += "\n";
      if (o.graph) {
        let (g, line, _) = graph.next_line(sh.graph);
        sh = Shown { ...sh, graph: g };
        out += line;
      }
    }
  }
  // A walk of the reflogs puts its lines after the first line, and
  // `--oneline` shows only the line of the reflog (`show_log` of git).
  let reflog_oneline = ctx.reflog.len() > 0 && o.form == "oneline";
  let text_ctx = ctx;
  if (!user && ctx.reflog.len() > 0 && !reflog_oneline) {
    out += log.reflog_header(ctx.reflog[0]);
    text_ctx = log.Context { ...ctx, reflog: [] };
  }
  if (o.show_signature && !reflog_oneline) {
    let checked = verify_signature(s.width, c.body, o.gpg);
    if (checked.died.len() > 0) {
      return (s, out, Shown { ...sh, fatal: checked.died });
    }
    if (checked.signed) {
      let (sh_sig, text) = signature_lines(o, sh, if (checked.has_output) { checked.output } else { "No signature\n" }, checked.failed);
      sh = sh_sig;
      out += text;
    }
    let (sh_tag, tags) = mergetag_lines(o, sh, c, ctx.parents, s.width);
    sh = sh_tag;
    out += tags;
    if (sh.fatal.len() > 0) {
      return (s, out, sh);
    }
  }
  if (o.form == "format" && log.uses_signature(o.format)) {
    let checked = verify_signature(s.width, c.body, o.gpg);
    if (checked.died.len() > 0) {
      return (s, out, Shown { ...sh, fatal: checked.died });
    }
    text_ctx = log.Context { ...text_ctx, sig: checked };
  }
  let msg = if (o.form == "format") { log.formatted(c, text_ctx, o.format) } else if (o.form == "reference") { log.reference(c, text_ctx) } else { log.pretty(c, text_ctx, o.form) + text_ctx.notes };
  let missing = msg.len() == 0 || msg[msg.len() - 1] != b'\n';
  if (o.graph) {
    let (g, text) = graph.show_msg(sh.graph, msg);
    sh = Shown { ...sh, graph: g };
    out += text;
  } else {
    out += msg;
  }
  let empty = o.form == "format" && o.format.len() == 0;
  if (o.terminator && !empty) {
    if (!missing) {
      let (sh2, p) = graph_pad(o, sh);
      sh = sh2;
      out += p;
    }
    out += "\n";
  }
  sh = Shown { ...sh, missing: missing };
  if (changes.len() == 0) {
    return (s, out, sh);
  }
  if (o.form != "oneline" && !empty) {
    let (sh3, p) = graph_pad(o, sh);
    sh = sh3;
    let dashes = o.diff.len() == 0 && o.patch.patch && o.patch.stat;
    out += p + (if (dashes) { "---" } else { "" }) + "\n";
  }
  if (o.diff == "check") {
    let (s7, checked, failed) = patch.check(s, changes, o.patch);
    let (sh8, text) = text_lines(o, Shown { ...sh, failed: sh.failed || failed }, checked);
    return (s7, out + text, sh8);
  }
  if (o.diff.len() > 0) {
    for line in name_lines(changes, o).split("\n") {
      if (line.len() > 0) {
        let (sh4, p) = graph_pad(o, sh);
        sh = sh4;
        out += p + line + "\n";
      }
    }
    return (s, out, sh);
  }
  let (s5, text, sh5) = diff_text(s, changes, o.patch, least, o, sh);
  return (s5, out + text, sh5);
}

// The text of the diff of `changes` with the forms `d`, with the graph
// before each line.
function diff_text(s: store.Store, changes: treediff.Change[], d: patch.Opts, least: i32, o: LogOpts, sh_in: Shown): (store.Store, string, Shown) {
  // The graph lines that the first calls of the diff take, for the width
  // of the stat.
  let widths: i32[] = [];
  let ahead = sh_in;
  for k in 0..changes.len() + 2 {
    let (sh5, p) = graph_pad(o, ahead);
    ahead = sh5;
    widths = widths.append(p.len());
  }
  let (s5, text) = patch.render(s, changes, d, least, (k: i32): i32 => widths[k.min(widths.len() - 1)]);
  let (sh6, lines) = text_lines(o, sh_in, text);
  return (s5, lines, Shown { ...sh6, fatal: text.fatal });
}

// The parts of `t` with the graph line of each call before them.
function text_lines(o: LogOpts, sh_in: Shown, t: patch.Text): (Shown, string) {
  let sh = sh_in;
  let pads: string[] = [];
  for k in 0..t.calls {
    let (sh1, p) = graph_pad(o, sh);
    sh = sh1;
    pads = pads.append(p);
  }
  let out = "";
  for i in 0..t.lines.len() {
    let u = t.uses[i];
    out += (if (u >= 0) { pads[u] } else { "" }) + t.lines[i] + (if (t.ends[i]) { "\n" } else { "" });
  }
  return (sh, out);
}

// The forms of the diff for a merge: with `--diff-merges=`, a merge has a
// patch when no option gives a form.
function merge_forms(o: LogOpts, merge: boolean): LogOpts {
  if (merge && o.merges_need && o.diff.len() == 0 && !o.no_output && !patch.any(o.patch)) {
    return LogOpts { ...o, patch: patch.Opts { ...o.patch, patch: true } };
  }
  return o;
}

// The text of one commit and its diffs: one text for each diff with a
// change, with `(from PARENT)` for `-m`, or the text alone. `known` holds
// the diffs when the caller has them.
function log_entry(st: store.Store, c: log.Commit, o_in: LogOpts, ctx: log.Context, least: i32, sh_in: Shown, known: Diff[][]): (store.Store, string, Shown) {
  let merge = ctx.parents.len() > 1;
  let o = merge_forms(o_in, merge);
  let mode = merge_mode(o);
  let wanted = o.diff.len() > 0 || !o.no_output && patch.any(o.patch);
  if (!wanted) {
    return entry_text(st, c, o, ctx, least, sh_in, []);
  }
  if (merge && (mode == "combined" || mode == "dense-combined")) {
    return combined_entry(st, c, o, ctx, least, sh_in, mode == "dense-combined");
  }
  let s = st;
  let sh = sh_in;
  let diffs: Diff[] = [];
  if (known.len() > 0) {
    diffs = known[0];
  } else {
    let (s1, found, path) = commit_diffs(s, c, ctx.parents, o, sh.follow);
    s = s1;
    diffs = found;
    sh = Shown { ...sh, follow: path };
  }
  let out = "";
  for d in diffs {
    if (d.changes.len() > 0) {
      let (s2, text, sh2) = entry_text(s, c, o, log.Context { ...ctx, from: d.from }, least, sh, d.changes);
      s = s2;
      sh = sh2;
      out += text;
    }
  }
  if (out.len() > 0) {
    return (s, out, sh);
  }
  return entry_text(s, c, o, ctx, least, sh, []);
}

// The text of a merge with its combined diff (`diff_tree_combined` of
// git): the text, a line end even after one line, the stat from the
// first parent, the raw lines or the names of the paths that change from
// each parent, and their combined patches.
function combined_entry(st: store.Store, c: log.Commit, o: LogOpts, ctx: log.Context, least: i32, sh_in: Shown, dense: boolean): (store.Store, string, Shown) {
  let (s0, head, sh0) = entry_text(st, c, o, ctx, least, sh_in, []);
  let s = s0;
  let sh = sh0;
  let out = head;
  if (o.no_output) {
    return (s, out, sh);
  }
  if (!(o.form == "format" && o.format.len() == 0)) {
    let (sh1, p) = graph_pad(o, sh);
    sh = sh1;
    out += p + "\n";
  }
  let per: treediff.Change[][] = [];
  for p in ctx.parents {
    let (s1, changes, _) = commit_changes(s, c, p, o, sh.follow);
    s = s1;
    per = per.append(changes);
  }
  let d = o.patch;
  let stats = o.diff.len() == 0 && (d.stat || d.numstat || d.shortstat || d.summary);
  if (stats) {
    let (s2, text, sh2) = diff_text(s, per[0], patch.Opts { ...d, raw: false, patch: false }, least, o, sh);
    s = s2;
    sh = sh2;
    out += text;
  }
  let paths = combine.paths(per);
  if (paths.len() == 0) {
    return (s, out, sh);
  }
  let form = if (o.diff == "name-only" || o.diff == "name-status") { o.diff } else if (d.raw && o.diff.len() == 0) { "raw" } else { "" };
  if (form.len() > 0) {
    for p in paths {
      let (sh3, pad) = graph_pad(o, sh);
      sh = sh3;
      out += pad + combine.raw_line(s, p, form, d, least) + "\n";
    }
  }
  if (o.diff.len() > 0 || !d.patch) {
    return (s, out, sh);
  }
  if (form.len() > 0 || stats) {
    let (sh4, pad) = graph_pad(o, sh);
    sh = sh4;
    out += pad + "\n";
  }
  let t = patch.text_new();
  for p in paths {
    let (s5, t5) = combine.show(s, p, d, dense, least, t);
    s = s5;
    t = t5;
  }
  let (sh6, text) = text_lines(o, sh, t);
  return (s, out + text, sh6);
}

// The parents of `h` that the graph draws: the first parent that the walk
// shows, and then each other parent that it shows, unless the walk
// follows the first parents only.
function graph_parents(w_in: revwalk.Walk, h: string, first_parent: boolean): (revwalk.Walk, string[]) {
  let (w1, ps) = revwalk.parents(w_in, h);
  let w = w1;
  let out: string[] = [];
  for i in 0..ps.len() {
    let (w2, yes) = revwalk.interesting(w, ps[i]);
    w = w2;
    if (yes) {
      out = out.append(ps[i]);
    }
    if (first_parent && (i == 0 || out.len() > 0)) {
      return (w, out);
    }
  }
  return (w, out);
}

// A commit of the log, with its parents in the graph when the log has a
// graph.
struct LogItem { hash: string, parents: string[] }

function log_item(w: revwalk.Walk, h: string, o: LogOpts): (revwalk.Walk, LogItem) {
  if (!o.graph || h.len() == 0) {
    return (w, LogItem { hash: h, parents: [] });
  }
  let (after, parents) = graph_parents(w, h, o.walk.first_parent);
  return (after, LogItem { hash: h, parents: parents });
}

// The state of the walk of log: the walk, the counts of the commits that
// `--skip` passed and that `-n` counts, and the parents that can be
// boundary commits.
struct Pull { w: revwalk.Walk, skipped: i32, count: i32, candidates: string[] }

// The next commit that log shows, as `get_revision` of git gives it: after
// `--skip` and within `-n`. With `--boundary`, its parents are marked as
// parents of a shown commit before its parents in the graph come.
function log_pull(p_in: Pull, o: LogOpts): (Pull, LogItem) {
  let p = p_in;
  let none = LogItem { hash: "", parents: [] };
  while (o.limit < 0 || p.count < o.limit) {
    let (w, h) = revwalk.next(p.w);
    p = Pull { ...p, w: w };
    if (w.failed.len() > 0 || h.len() == 0) {
      return (p, none);
    }
    if (p.skipped < o.skip) {
      p = Pull { ...p, skipped: p.skipped + 1 };
      continue;
    }
    p = Pull { ...p, count: p.count + 1 };
    if (o.walk.boundary) {
      let (w1, ps) = revwalk.parents(p.w, h);
      p = Pull { ...p, w: w1 };
      for c in ps {
        if ((revwalk.flag(p.w, c) & (revwalk.CHILD_SHOWN | revwalk.SHOWN)) == 0) {
          p = Pull { ...p, w: revwalk.with_flag(p.w, c, revwalk.CHILD_SHOWN), candidates: p.candidates.append(c) };
        }
      }
    }
    let (w2, item) = log_item(p.w, h, o);
    return (Pull { ...p, w: w2 }, item);
  }
  return (p, none);
}

// The boundary commits of the parents `candidates` of the shown commits:
// those that the walk did not show, in topological order.
function boundary_commits(w_in: revwalk.Walk, candidates: string[]): (revwalk.Walk, string[]) {
  let w = w_in;
  let list: string[] = [];
  for c in candidates {
    let f = revwalk.flag(w, c);
    if ((f & revwalk.CHILD_SHOWN) != 0 && (f & (revwalk.SHOWN | revwalk.BOUNDARY)) == 0) {
      w = revwalk.with_flag(w, c, revwalk.BOUNDARY);
      list = [c].concat(list);
    }
  }
  return revwalk.sorted_topo(w, list);
}

// The mark of a commit before its name, from its flags `f`:
// `get_revision_mark` of git.
function revision_mark(o: LogOpts, f: i32): string {
  if ((f & revwalk.BOUNDARY) != 0) {
    return "-";
  }
  if ((f & revwalk.UNINTERESTING) != 0) {
    return "^";
  }
  if ((f & revwalk.PATCHSAME) != 0) {
    return "=";
  }
  if (o.left_right) {
    return if ((f & revwalk.LEFT) != 0) { "<" } else { ">" };
  }
  if (o.graph) {
    return "*";
  }
  return if (o.walk.cherry_mark) { "+" } else { "" };
}

// The position of a reflog in a walk of `--walk-reflogs`: the name as the
// command line gives it, its entries, and the entry to show next.
struct ReflogPos { name: string, entries: refs.LogEntry[], at: i32 }

// The reflog that the name `text` gives: `NAME`, `NAME@{N}` or `@{N}`,
// as `add_reflog_for_walk` of git reads it, or none.
function reflog_of(r: refs.Repo, text: string): ReflogPos[] {
  let base = text;
  let start = 0;
  if let Some(at) = text.index_of("@{") {
    if (text.ends_with("}")) {
      let n = log_number(objects.part(text, at + 2, text.len() - 1));
      if (n >= 0) {
        base = objects.part(text, 0, at);
        start = n;
      }
    }
  }
  if (base.len() == 0) {
    base = refs.head_branch(r);
    if (base.len() == 0) {
      base = "HEAD";
    }
  }
  let entries = refs.reflog(r, base);
  if (entries.len() == 0) {
    let d = refs.dwim_log(r, base);
    if (d.count == 1) {
      entries = refs.reflog(r, d.name);
    }
  }
  if (entries.len() == 0) {
    return [];
  }
  return [ReflogPos { name: base, entries: entries, at: entries.len() - 1 - start }];
}

// The short form of a ref name for `%gd`.
function short_ref(name: string): string {
  for p in ["refs/heads/", "refs/tags/", "refs/remotes/"] {
    if (name.starts_with(p)) {
      return objects.part(name, p.len(), name.len());
    }
  }
  return name;
}

// The log of the entries of the reflogs of the names `names`, the latest
// entry first: `next_reflog_entry` of git.
function reflog_walk(r: refs.Repo, w_in: revwalk.Walk, o: LogOpts, names: string[]): i32 {
  let w = w_in;
  let logs: ReflogPos[] = [];
  for n in names {
    logs = logs.concat(reflog_of(r, n));
  }
  let needs_shorts = o.abbrev_commit || o.form != "raw" && o.form != "oneline";
  if (needs_shorts) {
    w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: store.listed(w.g.store) } };
  }
  let least = store.short_length(w.g.store);
  let decorations: Map[string, log.Decoration[]] = Map { };
  if (o.decorate > 0 || o.form == "format" && (o.format.contains("%d") || o.format.contains("%D"))) {
    let (s2, by) = decorations_of(r, w.g.store, o.decorate == 2, o.decorate_filter);
    w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s2 } };
    decorations = by;
  }
  let sh = Shown { graph: graph.graph_new(o.patch.color), any: false, missing: false, follow: "", hidden: false, failed: false, fatal: "" };
  let buf: u8[] = [];
  let count = 0;
  let skipped = 0;
  while (o.limit < 0 || count < o.limit) {
    let best = -1;
    for i in 0..logs.len() {
      let l = logs[i];
      let at = l.at;
      while (at >= 0) {
        let info = store.info(w.g.store, l.entries[at].new);
        w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: info.store } };
        if (info.kind == "commit") {
          break;
        }
        at -= 1;
      }
      logs = logs.with(i, ReflogPos { ...l, at: at });
      if (at >= 0 && (best < 0 || l.entries[at].time > logs[best].entries[logs[best].at].time)) {
        best = i;
      }
    }
    if (best < 0) {
      break;
    }
    let l = logs[best];
    let e = l.entries[l.at];
    logs = logs.with(best, ReflogPos { ...l, at: l.at - 1 });
    if (o.walk.max_age != -1 && e.time < o.walk.max_age || o.walk.min_age != -1 && e.time > o.walk.min_age) {
      continue;
    }
    let (w1, yes) = revwalk.reflog_wanted(w, e.new);
    w = w1;
    if (!yes) {
      continue;
    }
    if (skipped < o.skip) {
      skipped += 1;
      continue;
    }
    count += 1;
    let n = (l.entries.len() - 1 - l.at).to_string();
    let inside = if (o.date_explicit) { date.show(e.time, e.zone, o.dates) } else { n };
    let line = log.ReflogLine { selector: l.name + "@{" + inside + "}", short: short_ref(l.name) + "@{" + inside + "}", message: e.message, who: e.who };
    let (w3, item) = log_item(w, e.new, o);
    let (w2, text, after) = log_show(w3, item, o, decorations, least, sh, [line], []);
    w = w2;
    sh = after;
    if (after.hidden) {
      count -= 1;
    }
    buf = buf.concat(text.bytes());
    if (after.fatal.len() > 0) {
      put(buf);
      return fatal(after.fatal);
    }
    if (buf.len() > 65536) {
      put(buf);
      buf = [];
    }
  }
  put(buf);
  return if (sh.failed) { 2 } else { 0 };
}

// The text of a commit, with the graph. `following` holds the commits
// that the log shows next, as far as the lookahead goes.
function log_show(w_in: revwalk.Walk, item: LogItem, o: LogOpts, decorations: Map[string, log.Decoration[]], least: i32, sh_in: Shown, reflog: log.ReflogLine[], following: LogItem[]): (revwalk.Walk, string, Shown) {
  let h = item.hash;
  let w = w_in;
  let sh = Shown { ...sh_in, hidden: false };
  let (g, n) = walk.node(w.g, h);
  w = revwalk.Walk { ...w, g: g };
  if (!n.ok) {
    return (w, "", sh);
  }
  let (g1, c) = walk.commit(w.g, h);
  w = revwalk.Walk { ...w, g: g1 };
  let f = revwalk.flag(w, h);
  let mark = revision_mark(o, f);
  if (o.graph) {
    let next = if (following.len() > 0) { following[0].hash } else { "" };
    let next_root = following.len() > 1 && following[0].parents.len() == 0;
    let g2 = graph.Graph { ...sh.graph, mark: if ((f & revwalk.BOUNDARY) != 0) { "o" } else { mark } };
    sh = Shown { ...sh, graph: graph.update(g2, h, item.parents, next, next_root) };
  }
  let (w2, ps) = revwalk.parents(w, h);
  w = w2;
  let st = w.g.store;
  let side = if ((f & revwalk.BOUNDARY) != 0) { "-" } else if ((f & revwalk.UNINTERESTING) != 0) { "^" } else if ((f & revwalk.PATCHSAME) != 0) { "=" } else if ((f & revwalk.LEFT) != 0) { "<" } else { ">" };
  let commit_least = if (o.patch.abbrev == 0) { 2 * st.width } else if (o.patch.abbrev > 0) { o.patch.abbrev } else { least };
  let (st2, note_text) = if (o.show_notes) { notes.text_of(st, o.notes, h, o.form == "format" || o.form == "reference") } else { (st, "") };
  w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: st2 } };
  let ctx = log.Context { abbrev: (name: string): string => refs.short_of(st, name, commit_least), abbrev_commit: o.abbrev_commit, parents: ps, dates: o.dates, decorations: decorations.get_or(h, []), mailmap: o.mm, use_mailmap: o.use_mailmap, mark: if (o.graph) { "" } else { mark }, side: side, reflog: reflog, color: o.patch.color, pal: o.patch.pal, hi: o.hi, from: "", notes: note_text, notes_shown: o.show_notes, sig: sig.unsigned(), graph_width: if (o.graph) { sh.graph.width } else { 0 } };
  // The diff of `-L` holds the changes that touch a range, each with the
  // ranges of its file (`line_log_queue_pairs`).
  if (o.lines.len() > 0) {
    let changes: treediff.Change[] = [];
    let ranges: Map[string, i32[]] = Map { };
    for e in revwalk.lines_of(w, h) {
      if (e.pair.len() > 0) {
        changes = changes.append(e.pair[0]);
        ranges = ranges.insert(e.path, e.ranges);
      }
    }
    if (o.pick.kind != 0) {
      let (s6, kept) = patch.pickaxe(w.g.store, changes, o.pick, o.patch);
      w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s6 } };
      if (kept.len() == 0) {
        return (w, "", Shown { ...sh, hidden: true });
      }
      changes = kept;
    }
    if (o.diff.len() == 0 && (o.no_output || !patch.any(o.patch))) {
      changes = [];
    }
    let (s7, text2, after2) = entry_text(w.g.store, c, LogOpts { ...o, patch: patch.Opts { ...o.patch, line_ranges: ranges } }, ctx, least, sh, changes);
    return (revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s7 } }, text2, after2);
  }
  // With the pickaxe and with --follow, a commit with no changes is not
  // shown, but the graph still takes it.
  if (o.pick.kind != 0 || o.follow) {
    let (s4, diffs, path) = commit_diffs(w.g.store, c, ps, merge_forms(o, ps.len() > 1), sh.follow);
    w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s4 } };
    sh = Shown { ...sh, follow: path };
    if (!any_change(diffs)) {
      return (w, "", Shown { ...sh, hidden: true });
    }
    let (s5, text1, after1) = log_entry(w.g.store, c, o, ctx, least, sh, [diffs]);
    return (revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s5 } }, text1, after1);
  }
  let (s3, text, after) = log_entry(w.g.store, c, o, ctx, least, sh, []);
  return (revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s3 } }, text, after);
}

// The mailmap of the repository: `.mailmap` at the top of the worktree,
// unless it is a link, the blob of `mailmap.blob` (`HEAD:.mailmap` in a
// bare repository), and the file of `mailmap.file`.
function read_mailmap(r: refs.Repo, s: store.Store): mailmap.Mailmap {
  let m = mailmap.empty();
  if (r.top.len() > 0) {
    let path = r.top + "/.mailmap";
    let link = match (lstat(path)) {
      Ok(st) => (st.mode & 61440) == 40960,
      Err(_) => true,
    };
    if (!link) {
      if let Ok(text) = read_file(path) {
        m = mailmap.add_text(m, text);
      }
    }
  }
  let blob = match (r.config.get("mailmap.blob")) {
    Some(v) => v,
    None => if (r.top.len() == 0) { "HEAD:.mailmap" } else { "" },
  };
  if (blob.len() > 0) {
    let named = rev.parse(r, s, blob);
    if (named.hash.len() > 0) {
      let got = store.read(named.store, named.hash);
      if let Ok(o) = got.object {
        if (o.kind == "blob") {
          m = mailmap.add_text(m, unsafe { string_from_bytes_unchecked(o.body) });
        }
      }
    }
  }
  if let Some(file) = r.config.get("mailmap.file") {
    let path = if (file.starts_with("~/")) { env("HOME").unwrap_or("") + objects.part(file, 1, file.len()) } else if (file.starts_with("/") || r.top.len() == 0) { file } else { r.top + "/" + file };
    if let Ok(text) = read_file(path) {
      m = mailmap.add_text(m, text);
    }
  }
  return m;
}

// The commit graph of the repository, or none when the configuration
// turns it off or the history of the store is not that of its objects:
// a shallow clone, grafts, or replace refs (`commit_graph_compatible`).
function commit_graph(r: refs.Repo, s: store.Store): commitgraph.Graph {
  if (!r.config.flag("core.commitgraph", true) || s.shallow.len() > 0) {
    return commitgraph.none();
  }
  if let Ok(_) = stat(r.common + "/info/grafts") {
    return commitgraph.none();
  }
  for e in refs.all_refs(r) {
    if (e.name.starts_with("refs/replace/")) {
      return commitgraph.none();
    }
  }
  let version = if (!r.config.flag("commitgraph.readchangedpaths", true)) { 0 } else { log_digits_signed(r.config.get("commitgraph.changedpathsversion").unwrap_or("-1")) };
  return commitgraph.open(r.objects(), r.width, if (version < -1 || version > 2) { -1 } else { version });
}

function log_command(argv: string[]): i32 {
  let (repo, status) = repo_or_fail();
  if (status != 0) {
    return status;
  }
  let r = repo[0];
  if (driver_config_status(r) != 0) {
    return 128;
  }
  let o = LogOpts { lines: [], hi: log.no_highlight(), gpg: gpg_programs(r), show_signature: r.config.flag("log.showsignature", false), notes: [], notes_given: false, show_notes: false, notes_default: -1, notes_extra: [], find: treediff.detect_default(), moved_default: moved.NO, word_regex: r.config.get("diff.wordregex").unwrap_or(""), merges: "", merges_need: false, imply_patch: false, pick: patch.no_pickaxe(), follow: false, walk_reflogs: argv.any((a: string): boolean => a == "-g" || a == "--walk-reflogs"), reflog_names: [], date_explicit: false, left_right: false, ancestry_names: [], mm: mailmap.empty(), use_mailmap: r.config.flag("log.mailmap", true), limit: -1, skip: 0, form: "medium", format: "", terminator: false, abbrev_commit: false, dates: date.normal_mode(), reverse: false, parents: false, graph: false, diff: "", patch: patch.defaults(), no_output: false, names_twice: false, full_diff: false, renames: true, decorate: 0, decorate_filter: DecorationFilter { include: [], exclude: [], config_exclude: r.config.all("log.excludedecoration").map((p: string): string => ref_pattern(p)), clear: r.config.get("log.initialdecorationset").unwrap_or("") == "all" }, walk: revwalk.options(), bad: "" };
  let g = GrepArgs { authors: [], committers: [], body: [], all_match: false, invert: false, icase: false, kind: "basic" };
  let renames_value = r.config.get("diff.renames").unwrap_or("true").to_ascii_lower();
  let copies = renames_value == "copies" || renames_value == "copy";
  o = LogOpts { ...o, patch: diff_config(r, o.patch), renames: copies || r.config.flag("diff.renames", true), find: treediff.Detect { ...o.find, copies: copies }, walk: revwalk.Opts { ...o.walk, reflog_walk: o.walk_reflogs } };
  if let Some(v) = r.config.get("diff.colormoved") {
    let form = moved.parse(v);
    if (form >= 0) {
      o = LogOpts { ...o, moved_default: form, patch: patch.Opts { ...o.patch, color_moved: form } };
    }
  }
  if let Some(v) = r.config.get("diff.colormovedws") {
    let (mode, errors) = moved.parse_ws(v);
    if (errors.len() == 0) {
      o = LogOpts { ...o, patch: patch.Opts { ...o.patch, color_moved_ws: mode } };
    }
  }
  if let Some(v) = r.config.get("core.whitespace") {
    let (rule, warnings, failure) = ws.parse(v);
    for line in warnings {
      eprint(line);
    }
    if (failure.len() > 0) {
      return fatal(failure);
    }
    o = LogOpts { ...o, patch: patch.Opts { ...o.patch, ws_rule: rule } };
  }
  let dashdash = -1;
  for k in 0..argv.len() {
    if (dashdash < 0 && argv[k] == "--") {
      dashdash = k;
    }
  }
  let paths: string[] = [];
  let args = argv;
  if (dashdash >= 0) {
    paths = array.slice(argv, dashdash + 1, argv.len());
    args = array.slice(argv, 0, dashdash);
  }
  // Each `-L` before `--` comes out first, as `parse_options` of git
  // takes it before the revisions and the other options.
  let rest: string[] = [];
  let k = 0;
  while (k < args.len()) {
    let x = args[k];
    if (!x.starts_with("-L")) {
      rest = rest.append(x);
    } else if (x.len() > 2) {
      o = LogOpts { ...o, lines: o.lines.append(objects.part(x, 2, x.len())) };
    } else if (k + 1 < args.len()) {
      o = LogOpts { ...o, lines: o.lines.append(args[k + 1]) };
