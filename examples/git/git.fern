  }
  if (o.word_regex.len() > 0 && o.patch.word_diff != patch.WORDS_NONE) {
    let re = bre.bre_compile_syntax(o.word_regex, bre.Syntax { ...bre.posix_basic(), extended: true, newline_anchor: true, multiline: true });
    let d = if (re.err.len() > 0) { patch.Opts { ...o.patch, word_regex_error: o.word_regex } } else { patch.Opts { ...o.patch, word_regex: [re] } };
    o = LogOpts { ...o, patch: d };
  }
  let pretty_given = args.any((a: string): boolean => a == "--oneline" || a.starts_with("--pretty") || a.starts_with("--format"));
  if (!o.notes_given && (!pretty_given || o.form == "format" && o.format.contains("%N"))) {
    o = LogOpts { ...o, show_notes: true };
  }
  if (o.show_notes) {
    let (s6, trees) = notes_of(r, w.g.store, o);
    w = revwalk.Walk { ...w, g: walk.Graph { ...w.g, store: s6 } };
    o = LogOpts { ...o, notes: trees };
  }
  if (o.imply_patch && o.diff.len() == 0 && !o.no_output && !patch.any(o.patch)) {
    o = LogOpts { ...o, patch: patch.Opts { ...o.patch, patch: true } };
  }
  if (o.patch.patch || o.patch.color || o.diff == "check" || o.lines.len() > 0) {
    o = LogOpts { ...o, patch: patch.Opts { ...o.patch, attrs: [attr.load(r)], drivers: userdiff.from_config(r.config) } };
  }
  o = LogOpts { ...o, patch: patch.Opts { ...o.patch, abbrev: o.patch.abbrev.min(2 * st0.width) } };
  let bad_color = if (o.form == "format") { log.bad_color(o.format, o.patch.color) } else { "" };
  if (bad_color.len() > 0) {
