// The parts of the git port that do no I/O: the names of objects, the loose
// object file, the lines of a tree, the deltas, and the text of a commit.
import "std/test";
import "std/array";
import "std/crypto";
import "std/deflate";
import "std/hex";
import "std/result";
import "./color";
import "./config";
import "./checkpack";
import "./checkblob";
import "./date";
import "./width";
import "./fsck";
import "./graph";
import "./index";
import "./log";
import "./mailmap";
import "./objects";
import "./pack";
import "./patch";

function unhex(s: string): u8[] {
  let Ok(b) = hex.decode(s) else {
    return [];
  };
  return b;
}

const HELLO: string = "ce013625030ba8dba906f756967f9e9ca394464a";

const HELLO_256: string = "2cf8d83d9ee29543b34a87727421fdecb7e3f3a183d337639025de576db9ebb4";

function test_names(): test.TestOutcome {
  if (objects.hash_of(objects.SHA1, "blob", "".bytes()) != "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391") {
    return test.fail("the empty blob");
  }
  if (objects.hash_of(objects.SHA1, "blob", "hello\n".bytes()) != "ce013625030ba8dba906f756967f9e9ca394464a") {
    return test.fail("the blob of hello");
  }
  if (objects.hash_of(objects.SHA1, "tree", "".bytes()) != "4b825dc642cb6eb9a060e54bf8d69288fbee4904") {
    return test.fail("the empty tree");
  }
  // The same objects in a repository with SHA-256 names.
  let sha256 = objects.SHA256;
  if (objects.hash_of(sha256, "blob", "".bytes()) != "473a0f4c3be8a93681a267e3b1e9a7dcda1185436fe141f7749120a303721813") {
    return test.fail("the empty blob of SHA-256");
  }
  if (objects.hash_of(sha256, "tree", "".bytes()) != "6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321") {
    return test.fail("the empty tree of SHA-256");
  }
  if (2 * sha256 != 64 || "0".repeat(2 * objects.SHA1) != "0".repeat(40) || !objects.is_name(sha256, "473a0f4c3be8a93681a267e3b1e9a7dcda1185436fe141f7749120a303721813")) {
    return test.fail("the lengths of the names");
  }
  return test.assert_eq(hex.encode(objects.header("blob", 1234)), "626c6f62203132333400");
}

function test_hex_names(): test.TestOutcome {
  if (!objects.is_hex("0123abCDef", 4) || objects.is_hex("abc", 4) || objects.is_hex("abcg", 4) || objects.is_hex("", 0) != true) {
    return test.fail("is_hex");
  }
  if (!objects.is_kind("blob") || !objects.is_kind("tag") || objects.is_kind("bogus")) {
    return test.fail("is_kind");
  }
  return test.assert_eq(objects.loose_path("/r/objects", "ce013625030ba8dba906f756967f9e9ca394464a"), "/r/objects/ce/013625030ba8dba906f756967f9e9ca394464a");
}

// The hash of a repository, from the text of its `config` file.
function test_object_format(): test.TestOutcome {
  let sha256 = "[core]\n\trepositoryformatversion = 1\n\tbare = false\n[extensions]\n\tobjectformat = sha256\n";
  if (objects.object_format(sha256) != "sha256" || objects.object_format("[Extensions]\r\n  ObjectFormat=sha1\r\n") != "sha1") {
    return test.fail("the value of the key");
  }
  if (objects.object_format("[core]\n\tbare = false\n") != "" || objects.object_format("[core]\n\tobjectformat = sha256\n") != "" || objects.object_format("") != "") {
    return test.fail("a file that does not set the key");
  }
  if (objects.object_format("[extensions]\n\tobjectformatx = sha256\n") != "") {
    return test.fail("a key with a longer name");
  }
  if (objects.width_of("") != 20 || objects.width_of("sha1") != 20 || objects.width_of("sha256") != 32 || objects.width_of("bogus") != 0) {
    return test.fail("the width of a hash");
  }
  if (hex.encode(objects.digest(20, "abc".bytes())) != "a9993e364706816aba3e25717850c26c9cd0d89d") {
    return test.fail("the SHA-1 of abc");
  }
  return test.assert_eq(hex.encode(objects.digest(32, "abc".bytes())), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

// A file that `encode` makes gives the same object back. A file with a wrong
// size, a file with no header and a file that is not zlib are refused.
function test_loose_file(): test.TestOutcome {
  let body = "tree and blob\n".repeat(300).bytes();
  let o = match (objects.decode(objects.encode("blob", body), "x")) {
    Ok(found) => found,
    Err(why) => {
      return test.fail("decode: " + why);
    },
  };
  if (o.kind != "blob" || hex.encode(o.body) != hex.encode(body)) {
    return test.fail("the object changed");
  }
  // git wrote this file for the blob "hello\n".
  let real = unhex("78014bcac94f523063c848cdc9c9e702001dc50414");
  if let Ok(h) = objects.decode(real, "x") {
    if (h.kind != "blob" || hex.encode(h.body) != "68656c6c6f0a") {
      return test.fail("the file of git: " + h.kind + " " + hex.encode(h.body));
    }
  } else {
    return test.fail("the file of git is refused");
  }
  if let Ok(_) = objects.decode([1, 2, 3], "x") {
    return test.fail("bytes that are not zlib are accepted");
  }
  if let Ok(_) = objects.decode(objects.encode("blob 99", "abc".bytes()), "x") {
    return test.fail("a wrong size is accepted");
  }
  return test.pass();
}

function entry(mode: string, name: u8[], id: string): u8[] {
  return mode.bytes().append(32).concat(name).append(0).concat(unhex(id));
}

function test_tree_lines(): test.TestOutcome {
  let a = "ce013625030ba8dba906f756967f9e9ca394464a";
  let d = "cc36104798061e54645ea3917607255a93ffe4cf";
  let body = entry("100644", "a.txt".bytes(), a).concat(entry("40000", "d".bytes(), d)).concat(entry("160000", "sub".bytes(), a));
  body = body.concat(entry("100755", [116, 9, 98], a)).concat(entry("120000", [195, 169, 34, 92], a));
  let want = "100644 blob " + a + "\ta.txt\n040000 tree " + d + "\td\n160000 commit " + a + "\tsub\n100755 blob " + a + "\t\"t\\tb\"\n120000 blob " + a + "\t\"\\303\\251\\\"\\\\\"\n";
  let got = match (objects.tree_text(body, 20)) {
    Ok(text) => text,
    Err(why) => {
      return test.fail("tree_text: " + why);
    },
  };
  if (hex.encode(got) != hex.encode(want.bytes())) {
    return test.fail("the lines differ: " + hex.encode(got));
  }
  if let Ok(_) = objects.tree_text(array.slice(body, 0, body.len() - 1), 20) {
    return test.fail("a short tree is accepted");
  }
  // With SHA-256, the name of an entry has 32 bytes.
  let wide = entry("100644", "a.txt".bytes(), HELLO_256).concat(entry("40000", "d".bytes(), HELLO_256));
  let Ok(lines) = objects.tree_text(wide, 32) else {
    return test.fail("a tree with SHA-256 names is refused");
  };
  if (hex.encode(lines) != hex.encode(("100644 blob " + HELLO_256 + "\ta.txt\n040000 tree " + HELLO_256 + "\td\n").bytes())) {
    return test.fail("the lines with SHA-256 names differ: " + hex.encode(lines));
  }
  if let Ok(_) = objects.tree_text(wide, 20) {
    return test.fail("a tree with SHA-256 names is accepted as a tree with SHA-1 names");
  }
  return test.pass();
}

// A delta: the size of the base, the size of the result, and then copy and
// insert instructions.
function test_delta(): test.TestOutcome {
  let base = "0123456789abcdef".bytes();
  // Copy 4 bytes from 10, insert "XY", copy 3 bytes from 0.
  let delta: u8[] = [16, 9, 145, 10, 4, 2, 88, 89, 144, 3];
  let got = match (pack.apply_delta(base, delta)) {
    Ok(bytes) => hex.encode(bytes),
    Err(why) => "error: " + why,
  };
  if (got != hex.encode("abcdXY012".bytes())) {
    return test.fail("the delta gave " + got);
  }
  // A copy with no size byte takes 65536 bytes.
  let big = "ab".repeat(40000).bytes();
  let whole: u8[] = [128, 241, 4, 128, 128, 4, 128];
  if let Ok(out) = pack.apply_delta(big, whole) {
    if (out.len() != 65536 || out[65535] != b'b') {
      return test.fail("the copy of 65536 bytes");
    }
  } else {
    return test.fail("the copy of 65536 bytes is refused");
  }
  let bads: u8[][] = [[15, 9, 145, 10, 4], [16, 9, 145, 14, 4], [16, 9, 0], [16, 9, 2, 88], [16, 2, 145, 10, 4]];
  for bad in bads {
    if let Ok(_) = pack.apply_delta(base, bad) {
      return test.fail("a bad delta is accepted: " + hex.encode(bad));
    }
  }
  return test.pass();
}

// The header of a packed object: the kind, a size in parts of 4 and 7 bits,
// and the offset or the name of the base of a delta.
function test_entry(): test.TestOutcome {
  let zero = __alloc_u8(12);
  // A blob of 5 + 16 * 3 bytes.
  let blob = zero.append(181).append(3);
  let e = pack.entry_in(pack.whole(pack.text_of(blob), 20), 12);
  if (!e.ok || e.kind != 3 || e.size != 53 || e.data_at != 14) {
    return test.fail("the header of a blob");
  }
  // An OFS_DELTA of 7 bytes whose base is 300 bytes before: 0x81 0x2c.
  let ofs = __alloc_u8(400).append(103).append(129).append(44);
  let d = pack.entry_in(pack.whole(pack.text_of(ofs), 20), 400);
  if (!d.ok || d.kind != pack.OFS_DELTA || d.size != 7 || d.base_offset != 100 || d.data_at != 403) {
    return test.fail("the header of an OFS_DELTA: base " + d.base_offset.to_string());
  }
  let ref_delta = zero.append(119).concat(unhex("ce013625030ba8dba906f756967f9e9ca394464a"));
  let r = pack.entry_in(pack.whole(pack.text_of(ref_delta), 20), 12);
  if (!r.ok || r.kind != pack.REF_DELTA || hex.encode(r.base_name) != "ce013625030ba8dba906f756967f9e9ca394464a" || r.data_at != 33) {
    return test.fail("the header of a REF_DELTA");
  }
  // With SHA-256, the name of the base has 32 bytes.
  let wide = pack.entry_in(pack.whole(pack.text_of(zero.append(119).concat(unhex(HELLO_256))), 32), 12);
  if (!wide.ok || hex.encode(wide.base_name) != HELLO_256 || wide.data_at != 45 || pack.entry_in(pack.whole(pack.text_of(ref_delta), 32), 12).ok) {
    return test.fail("the header of a REF_DELTA with a SHA-256 name");
  }
  if (pack.entry_in(pack.whole(pack.text_of(zero.append(181)), 20), 12).ok || pack.entry_in(pack.whole(pack.text_of(blob), 20), 4).ok || pack.entry_in(pack.whole(pack.text_of(zero.append(103).append(140)), 20), 12).ok) {
    return test.fail("a short header is accepted");
  }
  return test.pass();
}

const COMMIT: string = "tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nparent ce013625030ba8dba906f756967f9e9ca394464a\nparent e69de29bb2d1d6434b8b29ae775ad8c2e48c5391\nauthor A B <a@example.com> 1772581567 +0530\ncommitter C D <c@example.com> 1772629567 -0800\n\nfirst line\nsecond line\n\nbody\twith a tab\n\nlast\n";

// The fields of a commit, and the date on the clock of its zone.
function test_commit_fields(): test.TestOutcome {
  let c = log.commit_of("abc", COMMIT.bytes());
  if (c.tree != "4b825dc642cb6eb9a060e54bf8d69288fbee4904" || c.parents.len() != 2 || c.parents[1] != "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391") {
    return test.fail("the tree and the parents");
  }
  if (c.author.name != "A B" || c.author.email != "a@example.com" || c.author.time != 1772581567 || c.author.zone != "+0530") {
    return test.fail("the author: " + c.author.name + "|" + c.author.email + "|" + c.author.zone);
  }
  if (log.date_text(c.author) != "Wed Mar 4 05:16:07 2026 +0530") {
    return test.fail("a date east of Greenwich: " + log.date_text(c.author));
  }
  if (log.date_text(c.committer) != "Wed Mar 4 05:06:07 2026 -0800") {
    return test.fail("a date west of Greenwich: " + log.date_text(c.committer));
  }
  if (log.date_text(log.Person { name: "", email: "", time: 0, zone: "-0100" }) != "Wed Dec 31 23:00:00 1969 -0100") {
    return test.fail("a date before 1970");
  }
  let odd = log.person("no address");
  if (odd.name != "no address" || odd.email != "" || odd.time != 0) {
    return test.fail("a line with no address");
  }
  return test.pass();
}

// The subject, the body, the default text and the placeholders of a format.
// The short names of a test: the first two digits of a name.
function shorts(name: string): string {
  return objects.part(name, 0, 2);
}

function context_of(c: log.Commit): log.Context {
  return log.Context { abbrev: shorts, abbrev_commit: false, parents: c.parents, dates: date.normal_mode(), decorations: [], mailmap: mailmap.empty(), use_mailmap: false, mark: "", side: ">", reflog: [], color: false };
}

// The subject, the body, the built-in forms and the placeholders of a
// format.
function test_commit_text(): test.TestOutcome {
  let c = log.commit_of("abc", COMMIT.bytes());
  let ctx = context_of(c);
  if (log.subject(c.message) != "first line second line") {
    return test.fail("the subject: " + log.subject(c.message));
  }
  if (log.body_of(c.message) != "body\twith a tab\n\nlast\n" || log.body_of("one\n") != "" || log.body_of("one\n\ntwo") != "two" || log.subject("\n\n  a  \nb\t\n\nc") != "  a b") {
    return test.fail("the body");
  }
  let want = "commit abc\nMerge: ce e6\nAuthor: A B <a@example.com>\nDate:   Wed Mar 4 05:16:07 2026 +0530\n\n    first line\n    second line\n    \n    body    with a tab\n    \n    last\n";
  let medium = log.first_line(c, ctx, "medium", false) + "\n" + log.pretty(c, ctx, "medium");
  if (medium != want) {
    return test.fail("the default text: " + medium);
  }
  let short = log.pretty(c, ctx, "short");
  if (short != "Merge: ce e6\nAuthor: A B <a@example.com>\n\n    first line\n    second line\n") {
    return test.fail("the short form: " + short);
  }
  if (log.pretty(c, ctx, "oneline") != "first line second line" || log.reference(c, ctx) != "ab (first line second line, 2026-03-04)") {
    return test.fail("the forms of one line");
  }
  let got = log.formatted(c, ctx, "%H %h %T %t|%P|%p|%an %ae %at|%cn %ce %ct|%s%n%%|%x %|%x41%Cred%C(blue)|%al|%f|%m");
  let wanted = "abc ab 4b825dc642cb6eb9a060e54bf8d69288fbee4904 4b|ce013625030ba8dba906f756967f9e9ca394464a e69de29bb2d1d6434b8b29ae775ad8c2e48c5391|ce e6|A B a@example.com 1772581567|C D c@example.com 1772629567|first line second line\n%|%x %|A|a|first-line|>";
  if (got != wanted) {
    return test.fail("the placeholders: " + got);
  }
  if (log.formatted(c, ctx, "%B") != c.message || log.formatted(c, ctx, "") != "" || log.formatted(c, ctx, "a\n%-d") != "a" || log.formatted(c, ctx, "a%+s") != "a\nfirst line second line" || log.formatted(c, ctx, "a% d.") != "a.") {
    return test.fail("the raw message and the magic of placeholders");
  }
  return test.pass();
}

// Tabs in the default form: a wide character has two columns, a joining
// character none, and a control character stops the expansion.
function test_tabs(): test.TestOutcome {
  let cases: string[][] = [
    ["a\tb", "a       b"],
    ["中\t|", "中      |"],
    ["é\t|", "é       |"],
    ["1234567\t8\t9", "1234567 8       9"],
    ["x\x01\ty", "x\x01\ty"],
  ];
  for c in cases {
    let got = log.tabs_expanded(c[0], 0, c[0].len());
    if (got != c[1]) {
      return test.fail("the tabs of " + c[0] + ": " + got);
    }
  }
  if (width.wcwidth(0x4e2d) != 2 || width.wcwidth(0x301) != 0 || width.wcwidth(7) != -1 || width.wcwidth(65) != 1) {
    return test.fail("the widths of characters");
  }
  return test.pass();
}

// The forms of `--date=`, and the dates that approxidate reads.
function test_dates(): test.TestOutcome {
  let t: i64 = 1772581567;
  let mode = (text: string): date.Mode => date.parse_mode(text).unwrap_or(date.normal_mode());
  let cases: string[][] = [
    ["iso", "2026-03-04 05:16:07 +0530"],
    ["iso-strict", "2026-03-04T05:16:07+05:30"],
    ["rfc", "Wed, 4 Mar 2026 05:16:07 +0530"],
    ["short", "2026-03-04"],
    ["raw", "1772581567 +0530"],
    ["unix", "1772581567"],
    ["default", "Wed Mar 4 05:16:07 2026 +0530"],
    ["format:%Y/%m/%d %H:%M %z", "2026/03/04 05:16 +0530"],
  ];
  for c in cases {
    let got = date.show(t, 530, mode(c[0]));
    if (got != c[1]) {
      return test.fail("--date=" + c[0] + ": " + got);
    }
  }
  let message = (text: string): string => match (date.parse_mode(text)) {
    Ok(_) => "",
    Err(why) => why,
  };
  if (message("bogus") != "unknown date format bogus" || message("format") != "date format missing colon separator: format") {
    return test.fail("the messages for a form of date");
  }
  if (date.relative(t - 3 * 86400, t) != "3 days ago" || date.relative(t - 400 * 86400, t) != "1 year, 1 month ago" || date.relative(t + 10, t) != "in the future" || date.relative(t - 89, t) != "89 seconds ago") {
    return test.fail("the relative dates");
  }
  let reads: string[] = ["2026-03-04 05:16:07 +0530", "Wed, 4 Mar 2026 05:16:07 +0530", "@1772581567 +0530", "1772581567", "2026-03-03T23:46:07Z"];
  for text in reads {
    let (got, bad) = date.approxidate(text);
    if (bad || got != t) {
      return test.fail("approxidate of " + text + ": " + got.to_string());
    }
  }
  let (_, bad) = date.approxidate("no date at all");
  if (!bad) {
    return test.fail("a text with no date is a date");
  }
  return test.pass();
}

// A packfile of one blob with the content `body`, which is shorter than
// 16 bytes.
function tiny_pack(body: u8[], width: i32): u8[] {
  let sum = deflate.adler32(body);
  let data: u8[] = [b'P', b'A', b'C', b'K', 0, 0, 0, 2, 0, 0, 0, 1, (48 + body.len()) as u8, 120, 156];
  data = data.concat(deflate.deflate(body));
  data = data.append((sum >> 24) as u8).append((sum >> 16 & 255) as u8).append((sum >> 8 & 255) as u8).append((sum & 255) as u8);
  return data.concat(objects.digest(width, data));
}

// A packfile of two blobs, each shorter than 16 bytes.
function two_blobs(a: u8[], b: u8[]): u8[] {
  let data: u8[] = [b'P', b'A', b'C', b'K', 0, 0, 0, 2, 0, 0, 0, 2];
  data = data.append((48 + a.len()) as u8).concat(zlib_of(a));
  data = data.append((48 + b.len()) as u8).concat(zlib_of(b));
  return data.concat(crypto.sha1(data));
}

// The bytes of a zlib stream of `body`.
function zlib_of(body: u8[]): u8[] {
  let sum = deflate.adler32(body);
  let out: u8[] = [120, 156];
  out = out.concat(deflate.deflate(body));
  return out.append((sum >> 24) as u8).append((sum >> 16 & 255) as u8).append((sum >> 8 & 255) as u8).append((sum & 255) as u8);
}

// The kind and the size of a packed object, with no inflate of the object.
function test_info(): test.TestOutcome {
  // A blob of 6 bytes at 12, and a delta against it that makes 9 bytes:
  // a copy of 6 bytes from 0, and an insert of 3 bytes.
  let base = zlib_of("hello\n".bytes());
  let delta: u8[] = [6, 9, 144, 6, 3, b'a', b'b', b'c'];
  let data: u8[] = [b'P', b'A', b'C', b'K', 0, 0, 0, 2, 0, 0, 0, 2, 54];
  data = data.concat(base);
  let second = data.len();
  data = data.append((96 + delta.len()) as u8).append((second - 12) as u8).concat(zlib_of(delta));
  let whole = pack.memory(pack.text_of(data), (name: u8[]): i64 => -1, 20);
  let Ok((kind, size)) = pack.info_in(whole, 12) else {
    return test.fail("no kind and size for a blob");
  };
  if (kind != "blob" || size != 6) {
    return test.fail("the kind and the size of a blob: " + kind + " " + size.to_string());
  }
  let Ok((dkind, dsize)) = pack.info_in(whole, second) else {
    return test.fail("no kind and size for a delta");
  };
  if (dkind != "blob" || dsize != 9) {
    return test.fail("the kind and the size of a delta: " + dkind + " " + dsize.to_string());
  }
  let (made, _) = pack.object_cached(whole, second, pack.cache_new());
  let Ok(o) = made else {
    return test.fail("the delta is not applied");
  };
  if (o.body.len() != 9 || o.body[6] != b'a' || o.body[0] != b'h') {
    return test.fail("the object of the delta");
  }
  if let Ok(_) = pack.info_in(whole, 11) {
    return test.fail("an offset in the header is accepted");
  }
  return test.pass();
}

// The index that the port makes for a packfile.
function test_index(): test.TestOutcome {
  return index_case(objects.SHA1, HELLO);
}

function test_index_256(): test.TestOutcome {
  return index_case(objects.SHA256, HELLO_256);
}

// The index of a packfile of the blob "hello\n", whose name is `hello` in
// a repository with names of `width` bytes.
function index_case(width: i32, hello: string): test.TestOutcome {
  let data = tiny_pack("hello\n".bytes(), width);
  let Ok(built) = index.build(pack.text_of(data), index.options(width)) else {
    return test.fail("a packfile of one blob is refused");
  };
  let name = unhex(hello);
  let Ok(ix) = pack.index_of(built.idx, width, "x.idx") else {
    return test.fail("the index of one blob is refused");
  };
  if (ix.version != 2 || ix.count != 1 || pack.offset_of(ix, name) != 12 || pack.hex_name_at(ix, 0) != hello) {
    return test.fail("the index of one blob");
  }
  // An index is not sound for the other width, and has no name of a
  // different length.
  if let Ok(_) = pack.index_of(built.idx, 52 - width, "x.idx") {
    return test.fail("the index with the other width is accepted");
  }
  if (pack.find(ix, array.slice(name, 0, 12)) != -1) {
    return test.fail("a short name is found");
  }
  if (built.name != hex.encode(array.slice(data, data.len() - width, data.len())) || built.rev.len() != 12 + 4 + 2 * width) {
    return test.fail("the checksum and the reverse index");
  }
  // The reverse index names its hash, and each file ends with its checksum.
  if (built.rev[11] != (if (width == objects.SHA256) { 2 } else { 1 }) as u8) {
    return test.fail("the hash of the reverse index");
  }
  let end = built.idx.len() - width;
  if (hex.encode(objects.digest(width, array.slice(built.idx, 0, end))) != hex.encode(array.slice(built.idx, end, end + width))) {
    return test.fail("the checksum of the index");
  }
  let (read, _) = pack.object_cached(pack.memory(pack.text_of(data), (base: u8[]): i64 => pack.offset_of(ix, base), width), 12, pack.cache_new());
  let Ok(o) = read else {
    return test.fail("the object is not read with the index");
  };
  if (o.kind != "blob" || o.body.len() != 6) {
    return test.fail("the object of the index");
  }
  // A short name finds the object, and digits that no name has find none.
  let names = pack.with_prefix(ix, objects.part(hello, 0, 4), 2);
  if (names.len() != 1 || names[0] != hello) {
    return test.fail("the name for the first four digits");
  }
  if (pack.with_prefix(ix, objects.part(hello, 0, 9).to_ascii_upper(), 2).len() != 1 || pack.with_prefix(ix, hello, 2).len() != 1 || pack.with_prefix(ix, hello + "0", 2).len() != 0) {
    return test.fail("the names for capital digits, for each digit, and for one digit more");
  }
  if (pack.with_prefix(ix, objects.part(hello, 0, 3) + "f", 2).len() != 0 || pack.with_prefix(ix, "cd", 2).len() != 0) {
    return test.fail("the names for other digits");
  }
  // A part of the packfile that starts at the object gives the same object.
  let tail = array.slice(data, 12, data.len());
  let (part, cache) = pack.object_cached(pack.Source { part: (at: i64, most: i32): pack.Window => pack.Window { bytes: pack.text_of(tail), shift: 12, width: width }, base: (base: u8[]): i64 => -1 }, 12, pack.cache_new());
  let Ok(same) = part else {
    return test.fail("the object is not read from a part of the packfile");
  };
  if (same.kind != "blob" || hex.encode(same.body) != hex.encode(o.body) || cache.bytes != 0) {
    return test.fail("the object of a part of the packfile");
  }
  if (pack.entry_in(pack.Window { bytes: pack.text_of(tail), shift: 12, width: width }, 11).ok || pack.entry_in(pack.Window { bytes: pack.text_of(tail), shift: 13, width: width }, 12).ok) {
    return test.fail("an offset out of the part is accepted");
  }
  let bad = data.with(14, data[14] ^ 1);
  if let Ok(_) = index.build(pack.text_of(bad), index.options(width)) {
    return test.fail("a packfile with a changed byte is accepted");
  }
  if let Ok(_) = index.build(pack.text_of(data), index.options(52 - width)) {
    return test.fail("a packfile with a checksum of the other hash is accepted");
  }
  if let Ok(_) = index.build(pack.text_of(array.slice(data, 0, 20)), index.options(width)) {
    return test.fail("a short packfile is accepted");
  }
  return test.pass();
}

// The index of version 1, and the index of version 2 with each offset in
// its table of 8-byte offsets, as `--index-version=1` and
// `--index-version=2,0` make them. A packfile with SHA-256 names has an
// index with names of 32 bytes.
function test_index_versions(): test.TestOutcome {
  let data = tiny_pack("hello\n".bytes(), objects.SHA1);
  let name = unhex("ce013625030ba8dba906f756967f9e9ca394464a");
  let sha1 = objects.SHA1;
  let Ok(v1) = index.build(pack.text_of(data), index.Options { width: sha1, version: 1, limit: 2147483647 }) else {
    return test.fail("no index of version 1");
  };
  let Ok(ix1) = pack.index_of(v1.idx, 20, "v1.idx") else {
    return test.fail("the index of version 1 is refused");
  };
  if (ix1.version != 1 || ix1.count != 1 || v1.idx.len() != 1024 + 24 + 40 || pack.offset_of(ix1, name) != 12 || pack.hex_name_at(ix1, 0) != hex.encode(name)) {
    return test.fail("the index of version 1");
  }
  // git refuses an index whose every offset is in the table of 8-byte
  // offsets, which `--index-version=2,0` makes for one object.
  let Ok(all) = index.build(pack.text_of(data), index.Options { width: sha1, version: 2, limit: 0 }) else {
    return test.fail("no index with large offsets");
  };
  match (pack.index_of(all.idx, 20, "all.idx")) {
    Ok(_) => {
      return test.fail("an index with each offset large is accepted");
    },
    Err(why) => {
      if (why != "wrong index v2 file size in all.idx") {
        return test.fail("the message for an index with each offset large: " + why);
      }
    }
  }
  // Two blobs, and the second is past the limit of 12.
  let two = two_blobs("hello\n".bytes(), "world\n".bytes());
  let Ok(wide) = index.build(pack.text_of(two), index.Options { width: sha1, version: 2, limit: 12 }) else {
    return test.fail("no index with a large offset");
  };
  let Ok(ix2) = pack.index_of(wide.idx, 20, "wide.idx") else {
    return test.fail("the index with a large offset is refused");
  };
  let world = unhex(objects.hash_of(sha1, "blob", "world\n".bytes()));
  let second = pack.offset_of(ix2, world);
  if (wide.idx.len() != 1032 + 2 * 28 + 8 + 40 || second <= 12 || pack.offset_of(ix2, name) != 12) {
    return test.fail("the index with a large offset: " + hex.encode(wide.idx));
  }
  // The 4-byte offset of the second name is 0x80000000, the first entry of
  // the table of large offsets. An offset of 2^32 + 5 in that table.
  let place = pack.find(ix2, world);
  let at = 1032 + 2 * 24 + 4 * place;
  let large = 1032 + 2 * 28;
  if (wide.idx[at] != 128 || wide.idx[at + 3] != 0) {
    return test.fail("the 4-byte offset of a large offset");
  }
  let big = wide.idx.with(large + 3, 1).with(large + 7, 5);
  let Ok(ix3) = pack.index_of(big, 20, "big.idx") else {
    return test.fail("the index with an offset past 4 GiB is refused");
  };
  if (pack.offset_at(ix3, place) != 4294967301) {
    return test.fail("an offset past 4 GiB: " + pack.offset_at(ix3, place).to_string());
  }
  if let Ok(_) = pack.index_of(array.slice(wide.idx, 0, wide.idx.len() - 9), 20, "short.idx") {
    return test.fail("an index with a wrong size is accepted");
  }
  let other = v1.idx.with(4, 9);
  match (pack.index_of(array.slice(other, 0, 1000), 20, "p.idx")) {
    Ok(_) => {
      return test.fail("a short index is accepted");
    },
    Err(why) => {
      if (why != "index file p.idx is too small") {
        return test.fail("the message for a short index: " + why);
      }
    }
  }
  // A packfile with SHA-256 names: its trailer is the SHA-256 of its bytes.
  let sha256 = objects.SHA256;
  let body = array.slice(data, 0, data.len() - 20);
  let long = body.concat(crypto.sha256(body));
  let Ok(b256) = index.build(pack.text_of(long), index.options(sha256)) else {
    return test.fail("no index for SHA-256");
  };
  let Ok(ix4) = pack.index_of(b256.idx, 32, "s.idx") else {
    return test.fail("the index for SHA-256 is refused");
  };
  let name256 = objects.hash_of(sha256, "blob", "hello\n".bytes());
  if (ix4.count != 1 || pack.hex_name_at(ix4, 0) != name256 || b256.idx.len() != 1032 + 40 + 64 || b256.rev[11] != 2) {
    return test.fail("the index for SHA-256");
  }
  return test.pass();
}

function fsck_text(kind: string, body: string): string {
  return fsck.check(objects.SHA1, kind, body.bytes()).join("\n");
}

// The checks of `hash-object` for a commit, a tag and a tree, with the
// messages of git.
function test_fsck(): test.TestOutcome {
  let tree = "4b825dc642cb6eb9a060e54bf8d69288fbee4904";
  let good = "tree " + tree + "\nauthor A <a@b> 1 +0000\ncommitter A <a@b> 1 +0000\n\nm\n";
  if (fsck_text("commit", good) != "") {
    return test.fail("a sound commit: " + fsck_text("commit", good));
  }
  let cases: string[][] = [
    ["commit", "tree " + tree + "\n\nm\n", "missingAuthor: invalid format - expected 'author' line"],
    ["commit", "tree 4b82\nauthor A <a@b> 1 +0000\n", "badTreeSha1: invalid 'tree' line format - bad sha1"],
    ["commit", "tree " + tree + "\nauthor A <a@b> 1 +000\ncommitter A <a@b> 1 +0000\n\n", "badTimezone: invalid author/committer line - bad time zone"],
    ["commit", "tree " + tree + "\nauthor A<a@b> 1 +0000\n", "missingSpaceBeforeEmail: invalid author/committer line - missing space before email"],
    ["commit", "tree " + tree + "\nauthor A <a@b> 01 +0000\n", "zeroPaddedDate: invalid author/committer line - zero-padded date"],
    ["commit", "no line end", "unterminatedHeader: unterminated header"],
    ["tag", "object " + tree + "\ntype tree\ntag v1\n\nm\n", "missingTaggerEntry: invalid format - expected 'tagger' line"],
    ["tag", "object " + tree + "\ntype bogus\ntag v1\ntagger A <a@b> 1 +0000\n\nm\n", "badType: invalid 'type' value"],
    ["tag", "object " + tree + "\ntype tree\ntag a..b\ntagger A <a@b> 1 +0000\n\nm\n", "badTagName: invalid 'tag' name: a..b"],
  ];
  for c in cases {
    let want = "error: object fails fsck: " + c[2];
    if (fsck_text(c[0], c[1]) != want) {
      return test.fail(c[0] + " " + c[1] + ": " + fsck_text(c[0], c[1]));
    }
  }
  let id = unhex(tree);
  let unsorted = entry("100644", "b".bytes(), tree).concat(entry("100644", "a".bytes(), tree));
  let found = fsck.check(objects.SHA1, "tree", unsorted);
  if (found.len() != 1 || found[0] != "error: object fails fsck: treeNotSorted: not properly sorted") {
    return test.fail("an unsorted tree: " + found.join("|"));
  }
  let odd = entry("100664", ".git".bytes(), tree).concat(entry("40000", "x".bytes(), tree)).concat(entry("100644", "x".bytes(), tree));
  let all = fsck.check(objects.SHA1, "tree", odd).join("|");
  if (all != "error: object fails fsck: hasDotgit: contains '.git'|error: object fails fsck: badFilemode: contains bad file modes|error: object fails fsck: duplicateEntries: contains duplicate file entries") {
    return test.fail("a tree with three faults: " + all);
  }
  let short = fsck.check(objects.SHA1, "tree", array.slice(odd, 0, 10)).join("|");
  if (short != "error: too-short tree object|error: object fails fsck: badTree: cannot be parsed as a tree" || id.len() != 20) {
    return test.fail("a short tree: " + short);
  }
  if (!fsck.ref_name_ok("refs/tags/v1.0".bytes()) || fsck.ref_name_ok("refs/tags/x.lock".bytes()) || fsck.ref_name_ok("refs/tags/@{x".bytes()) || fsck.ref_name_ok("refs/tags/.x".bytes())) {
    return test.fail("the names of refs");
  }
  return test.pass();
}

// The values of a configuration file, with sections, subsections, quotes
// and comments.
function test_config(): test.TestOutcome {
  let c = config.parse("[core]\n\tBare = false ; a comment\n[Extensions]\n\tobjectFormat = sha256\n[branch \"Main\"]\n\tremote = \"or igin\" # x\n\tflag\n[a.b]\nk = one \\\n two\n");
  if (c.get("core.bare") != Some("false") || c.get("extensions.objectformat") != Some("sha256") || c.get("branch.Main.remote") != Some("or igin")) {
    return test.fail("the values of a configuration");
  }
  if (!c.flag("branch.Main.flag", false) || c.flag("core.bare", true) || c.get("a.b.k") != Some("one  two") || c.get("core.none") != None) {
    return test.fail("the flags of a configuration: " + c.get("a.b.k").unwrap_or("?"));
  }
  return test.pass();
}

// The name of a rename in the stat: the common parts of the two paths
// stay outside the braces.
function test_rename_names(): test.TestOutcome {
  let cases = [["dir/sub/file", "dir/moved", "dir/{sub/file => moved}"], ["a/b/c", "a/x/c", "a/{b => x}/c"], ["x/c", "y/c", "{x => y}/c"], ["long.txt", "long2.txt", "long.txt => long2.txt"], ["t\tb", "c", "\"t\\tb\" => c"]];
  for c in cases {
    let got = patch.pprint_rename(c[0].bytes(), c[1].bytes());
    if (got != c[2]) {
      return test.fail(c[0] + " to " + c[1] + ": " + got);
    }
  }
  return test.pass();
}

// The escape sequences of color specs, as `color_parse_mem` of git gives
// them, and the specs that are not colors.
function test_colors(): test.TestOutcome {
  let cases = [["bold blue", "\x1b[1;34m"], ["reset", "\x1b[m"], ["normal", ""], ["Red ul bold", "\x1b[1;4;31m"], ["#102030 brightblue", "\x1b[38;2;16;32;48;104m"], ["nobold 200 normal", "\x1b[22;38;5;200m"], ["9 default", "\x1b[91;49m"], ["-1 green", "\x1b[42m"], ["no-ul", "\x1b[24m"]];
  for c in cases {
    let got = color.parse(c[0]).unwrap_or("none");
    if (got != c[1]) {
      return test.fail(c[0] + ": " + got.replace("\x1b", "ESC"));
    }
  }
  for bad in ["foo", "red green blue", "256", "#12345", "-2"] {
    if (color.parse(bad).is_some()) {
      return test.fail("not a color: " + bad);
    }
  }
  return test.pass();
}

function graph_roots_text(names: string[], parents: string[][]): string {
  let g = graph.graph_new(false);
  let out = "";
  for i in 0..names.len() {
    let next = if (i + 1 < names.len()) { names[i + 1] } else { "" };
    let next_root = i + 2 < names.len() && parents[i + 1].len() == 0;
    g = graph.update(g, names[i], parents[i], next, next_root);
    let (g1, prefix) = graph.show_commit(g);
    let (g2, message) = graph.show_msg(g1, names[i] + "\n");
    g = g2;
    out += prefix + message;
  }
  return out;
}

function test_graph_roots(): test.TestOutcome {
  if (graph_roots_text(["child", "root", "other"], [["root"], [], []]) != "* child\n \\ \n  * root\n* other\n") {
    return test.fail("chain-root");
  }
  if (graph_roots_text(["root"], [[]]) != "* root\n") {
    return test.fail("single");
  }
  if (graph_roots_text(["r0", "r1"], [[], []]) != "  * r0\n* r1\n") {
    return test.fail("two-roots");
  }
  if (graph_roots_text(["r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9"], [[], [], [], [], [], [], [], [], [], []]) != "* r0\n  * r1\n    * r2\n      * r3\n* r4\n  * r5\n    * r6\n      * r7\n  * r8\n* r9\n") {
    return test.fail("ten-roots");
  }
  if (graph_roots_text(["merge", "side", "child", "root", "other"], [["child", "side"], [], ["root"], [], []]) != "*   merge\n|\\  \n| * side\n* child\n \\ \n  * root\n* other\n") {
    return test.fail("merge-root");
  }
  return test.pass();
}

// Pack bytes for the validation controls, including both hash widths.
function validation_pack(width: i32, kinds: i32[], bodies: u8[][]): string {
  let data: u8[] = [b'P', b'A', b'C', b'K', 0, 0, 0, 2, 0, 0, 0, bodies.len() as u8];
  for i in 0..bodies.len() {
    let size = bodies[i].len();
    data = data.append((kinds[i] << 4 | size & 15 | (if (size >= 16) { 128 } else { 0 })) as u8);
    size >>= 4;
    while (size > 0) {
      data = data.append((size & 127 | (if (size >= 128) { 128 } else { 0 })) as u8);
      size >>= 7;
    }
    data = data.concat(zlib_of(bodies[i]));
  }
  return pack.text_of(data.concat(objects.digest(width, data)));
}

function test_pack_policy(): test.TestOutcome {
  let p = checkpack.policy();
  if (checkpack.level(p, "missingAuthor") != 2 || checkpack.level(p, "hasDot") != 2 || checkpack.level(p, "badFilemode") != 1 || checkpack.level(p, "extraHeaderEntry") != 0) {
    return test.fail("the default severities");
  }
  for text in ["missingAuthor=unknown", "doesNotExist=warn", "missingAuthor", "nulInHeader=warn", "unterminatedHeader=ignore", "missingAuthor=IGNORE"] {
    if let Ok(_) = checkpack.configure(p, text) {
      return test.fail("accepted invalid policy: " + text);
    }
  }
  let Ok(changed) = checkpack.configure(p, "MISSINGAUTHOR:ignore | missingCommitter=warn,missingAuthor=error") else {
    return test.fail("the policy separators and message names");
  };
  if (checkpack.level(changed, "missingAuthor") != 2 || checkpack.level(changed, "missingCommitter") != 1 || checkpack.level(p, "missingCommitter") != 2) {
    return test.fail("the last override or the original policy");
  }
  return test.pass();
}

function test_pack_validation(): test.TestOutcome {
  let no_local = (name: string): Option[objects.Object] => None;
  let base = checkpack.policy();
  let p = checkpack.Policy { ...base, enabled: true };
  let strict = checkpack.Policy { ...p, strict: true };
  for width in [objects.SHA1, objects.SHA256] {
    let unknown = "f".repeat(width * 2);
    let ident = "A <a@example.com> 1700000000 +0000\n";
    let body = ("tree " + unknown + "\nauthor " + ident + "committer " + ident + "\nmessage\n").bytes();
    let Ok(built) = index.build(validation_pack(width, [1], [body]), index.options(width)) else {
      return test.fail("a structurally sound commit pack");
    };
    if (!checkpack.validate(built, width, p, no_local).ok) {
      return test.fail("fsck requires a child that is outside the pack");
    }
    let absent = checkpack.validate(built, width, strict, no_local);
    if (absent.ok || absent.lines != ["fatal: did not receive expected object " + unknown]) {
      return test.fail("strict accepts a missing tree");
    }
    let external = (name: string): Option[objects.Object] => if (name == unknown) { Some(objects.Object { kind: "tree", body: [] }) } else { None };
    if (!checkpack.validate(built, width, strict, external).ok) {
      return test.fail("strict rejects a local tree");
    }
    let wrong = (name: string): Option[objects.Object] => Some(objects.Object { kind: "blob", body: [] });
    let bad = checkpack.validate(built, width, strict, wrong);
    if (bad.ok || bad.lines != ["fatal: object " + unknown + ": expected type tree, found blob"]) {
      return test.fail("strict accepts a wrong local type");
    }
    let empty = objects.hash_of(width, "tree", []);
    let missing_people = ("tree " + empty + "\n\nmessage\n").bytes();
    let Ok(people) = index.build(validation_pack(width, [1], [missing_people]), index.options(width)) else {
      return test.fail("the person control pack");
    };
    let Ok(ignore_author) = checkpack.configure(p, "missingAuthor=ignore") else {
      return test.fail("the author override");
    };
    let second = checkpack.validate(people, width, ignore_author, no_local);
    let name = objects.hash_of(width, "commit", missing_people);
    if (second.ok || second.lines != ["error: object " + name + ": missingCommitter: invalid format - expected 'committer' line", "fatal: fsck error in packed object"]) {
      return test.fail("ignoring the author hides the invalid committer");
    }
    let Ok(warn_committer) = checkpack.configure(ignore_author, "missingCommitter=warn") else {
      return test.fail("the committer override");
    };
    let warned = checkpack.validate(people, width, warn_committer, no_local);
    if (!warned.ok || warned.lines != ["warning: object " + name + ": missingCommitter: invalid format - expected 'committer' line"]) {
      return test.fail("the committer warning");
    }
    let child = entry("160000", "sub".bytes(), unknown);
    let Ok(gitlink) = index.build(validation_pack(width, [2], [child]), index.options(width)) else {
      return test.fail("the gitlink control pack");
    };
    if (!checkpack.validate(gitlink, width, strict, no_local).ok) {
      return test.fail("strict requires submodule objects in the parent repository");
    }
    let thin = unhex(if (width == objects.SHA1) { "" } else { "" });
    let old_body = "not a commit\n".bytes();
    let old_name = objects.hash_of(width, "commit", old_body);
    let old_object = (name: string): Option[objects.Object] => if (name == old_name) { Some(objects.Object { kind: "commit", body: old_body }) } else { None };
    let raw = width;
    let Ok(completed) = index.build_with(pack.text_of(thin), index.options(width), (data: string, offsets: i64[]): string[][] => [index.names_part(data, offsets, 0, offsets.len() - 1, raw)], old_object) else {
      return test.fail("the thin control pack");
    };
    if (completed.input_count != 1 || completed.data.as_bytes()[11] != 2 || !checkpack.validate(completed, width, strict, old_object).ok) {
      return test.fail("an old delta base receives new-object checks");
    }
    let blob = "hello\n".bytes();
    let target = objects.hash_of(width, "blob", blob);
    let tag = ("object " + target + "\ntype tree\ntag v1\ntagger " + ident + "\nmessage\n").bytes();
    let tag_name = objects.hash_of(width, "tag", tag);
    let Ok(bad_tag) = index.build(validation_pack(width, [3, 4], [blob, tag]), index.options(width)) else {
      return test.fail("the tag control pack");
    };
    let refused_tag = checkpack.validate(bad_tag, width, p, no_local);
    if (refused_tag.ok || refused_tag.lines != ["error: object " + target + " is a blob, not a tree", "error: bad tag pointer to " + target + " in " + tag_name, "fatal: invalid tag"]) {
      return test.fail("a tag with a wrong target type");
    }
    let Ok(forward) = index.build(validation_pack(width, [4, 3], [tag, blob]), index.options(width)) else {
      return test.fail("the forward tag control pack");
    };
    let refused_forward = checkpack.validate(forward, width, p, no_local);
    if (refused_forward.ok || refused_forward.lines != ["error: object " + target + " is a tree, not a blob", "fatal: invalid blob object " + target]) {
      return test.fail("a tag before its wrong target");
    }
  }
  return test.pass();
}

function test_special_blobs(): test.TestOutcome {
  for url in ["-evil", "../%0aevil", "..//evil", "https://example.com/%0aevil", "http://example.com:0/x", "https://example.com:65536/x", "https://example.com:bad/x", "http:///x", "http://bad host/x", "http://example.com/%zz", "http://example.com/../x", "http://example.com/%2e%2e/x"] {
    let found = checkblob.inspect("gitmodules", ("[submodule \"x\"]\nurl = " + url + "\n").bytes());
    if (found.len() != 1 || found[0].id != "gitmodulesUrl") {
      return test.fail("accepted submodule URL: " + url);
    }
  }
  for url in ["https://example.com/x", "../x", "./x", "git://example.com/x", "ssh://host/x", "http://user:pass@host:80/x", "https://[::1]:443/x", "http://host/a/../x", "http://host/a/./x", "https::https://host/x", "http::file:///x", "http://host:00080/x"] {
    if (checkblob.inspect("gitmodules", ("[submodule \"x\"]\nurl = " + url + "\n").bytes()).len() != 0) {
      return test.fail("refused submodule URL: " + url);
    }
  }
  let invalid = checkblob.inspect("gitmodules", "[submodule \"x\"\nurl = -evil\n".bytes());
  if (invalid.len() != 1 || invalid[0].id != "gitmodulesParse") {
    return test.fail("values after an invalid config header");
  }
  let later = checkblob.inspect("gitmodules", "[submodule \"x\"]\nurl = -evil\nbad = \"unclosed\n".bytes());
  if (later.len() != 2 || later[0].id != "gitmodulesUrl" || later[1].id != "gitmodulesParse") {
    return test.fail("a value before a config error");
  }
  if (checkblob.inspect("gitattributes", "x".repeat(2047).bytes()).len() != 0 || checkblob.inspect("gitattributes", "x".repeat(2048).bytes()).len() != 1) {
    return test.fail("the attribute line boundary");
  }
  if (checkblob.inspect("gitattributes", ("x\x00" + "y".repeat(2048)).bytes()).len() != 0) {
    return test.fail("attributes after NUL");
  }
  return test.pass();
}

function test_deferred_blobs(): test.TestOutcome {
  let no_local = (name: string): Option[objects.Object] => None;
  let base = checkpack.policy();
  let p = checkpack.Policy { ...base, enabled: true };
  for width in [objects.SHA1, objects.SHA256] {
    let blob = "[submodule \"x\"]\nurl = -evil\n".bytes();
    let name = objects.hash_of(width, "blob", blob);
    let tree = entry("100644", ".gitmodules".bytes(), name);
    let Ok(first) = index.build(validation_pack(width, [3, 2], [blob, tree]), index.options(width)) else {
      return test.fail("the deferred pack");
    };
    let checked = checkpack.validate(first, width, p, no_local);
    if (!checked.ok || checked.delayed.len() != 1 || checked.lines.len() != 0) {
      return test.fail("the blob before its tree");
    }
    let deferred = checkpack.queued(first, width, p, checked.delayed, no_local, true, true);
    if (deferred.ok || deferred.lines != ["error: object " + name + ": gitmodulesUrl: disallowed submodule url: -evil", "fatal: fsck error in pack objects"]) {
      return test.fail("the deferred URL refusal");
    }
    let absent = checkpack.queued(first, width, p, checked.delayed, no_local, true, false);
    if (!absent.ok || absent.missing_modules != [name] || absent.lines.len() != 0) {
      return test.fail("a pack without a matching index name");
    }
    let outside = checkpack.queued(first, width, p, checked.delayed, no_local, false, true);
    if (outside.ok || outside.lines != ["fatal: cannot perform queued object checks outside of a repository"]) {
      return test.fail("deferred checks outside a repository");
    }
    let Ok(last) = index.build(validation_pack(width, [2, 3], [tree, blob]), index.options(width)) else {
      return test.fail("the immediate pack");
    };
    let immediate = checkpack.validate(last, width, p, no_local);
    if (immediate.ok || immediate.lines != ["error: object " + name + ": gitmodulesUrl: disallowed submodule url: -evil", "fatal: fsck error in packed object"]) {
      return test.fail("the blob after its tree");
    }
  }
  return test.pass();
}

function main(): i32 {
  let r = test.new("git");
  r = r.it("the names of objects", test_names);
  r = r.it("hexadecimal names, kinds and paths", test_hex_names);
  r = r.it("the hash of a repository", test_object_format);
  r = r.it("the loose object file", test_loose_file);
  r = r.it("the lines of a tree", test_tree_lines);
  r = r.it("a delta", test_delta);
  r = r.it("the header of a packed object", test_entry);
  r = r.it("the fields of a commit", test_commit_fields);
  r = r.it("the text of a commit", test_commit_text);
  r = r.it("the index of a packfile", test_index);
  r = r.it("the index of a packfile with SHA-256 names", test_index_256);
  r = r.it("the kind and the size of a packed object", test_info);
  r = r.it("the versions of an index", test_index_versions);
  r = r.it("the checks of hash-object", test_fsck);
  r = r.it("a configuration file", test_config);
  r = r.it("the tabs of a message", test_tabs);
  r = r.it("the forms of a date", test_dates);
  r = r.it("the names of renames in a stat", test_rename_names);
  r = r.it("the specs of colors", test_colors);
  r = r.it("the visual roots of a graph", test_graph_roots);
  r = r.it("the packed-object severity policy", test_pack_policy);
  r = r.it("packed-object formats and strict references", test_pack_validation);
  r = r.it("the special blob checks", test_special_blobs);
  r = r.it("the deferred blob checks", test_deferred_blobs);
  return r.finish();
}
