// The repository of the current directory, and the names of its objects:
// full and short hashes, `HEAD`, and the refs.
import "std/string";
import "./objects";
import "./store";

// `dir` is the git directory. `common` holds the objects and the refs: it is
// `dir`, or the directory that a linked worktree names. `prefix` is the path
// from the top of the worktree to the current directory, with a `/` at its
// end, or "". `width` is the count of bytes of a name: 20 with SHA-1, and
// 32 with SHA-256.
pub struct Repo { dir: string, common: string, prefix: string, shown: string, width: i32 }

// The store of the objects of the repository.
pub function (r: Repo) store(): store.Store {
  return store.open(r.objects(), r.width);
}

pub function (r: Repo) objects(): string {
  return r.common + "/objects";
}

function is_dir(path: string): boolean {
  return match (stat(path)) {
    Ok(st) => st.is_dir,
    Err(_) => false,
  };
}

function is_file(path: string): boolean {
  return match (stat(path)) {
    Ok(st) => st.is_file,
    Err(_) => false,
  };
}

function first_line(text: string): string {
  let end = 0;
  while (end < text.len() && text[end] != b'\n' && text[end] != b'\r') {
    end += 1;
  }
  return objects.part(text, 0, end);
}

function parent(path: string): string {
  let i = path.len() - 1;
  while (i > 0 && path[i] != b'/') {
    i -= 1;
  }
  if (i <= 0) {
    return "/";
  }
  return objects.part(path, 0, i);
}

function joined(base: string, path: string): string {
  if (path.starts_with("/")) {
    return path;
  }
  return base + "/" + path;
}

// The directory of the objects and the refs of the git directory `dir`.
function common_of(dir: string): string {
  return match (read_file(dir + "/commondir")) {
    Ok(text) => joined(dir, first_line(text)),
    Err(_) => dir,
  };
}

// The git directory that the entry `.git` of `top` names, or "".
function git_dir_of(top: string): string {
  let entry = top + "/.git";
  if (is_dir(entry)) {
    return entry;
  }
  if let Ok(text) = read_file(entry) {
    let line = first_line(text);
    if (line.starts_with("gitdir: ")) {
      return joined(top, objects.part(line, 8, line.len()));
    }
  }
  return "";
}

// The repository of the git directory `dir`. Its `config` file gives the
// hash of the names.
function repo_of(dir: string, prefix: string, shown: string): Result[Repo, string] {
  let common = common_of(dir);
  let format = match (read_file(common + "/config")) {
    Ok(text) => objects.object_format(text),
    Err(_) => "",
  };
  let width = objects.width_of(format);
  if (width == 0) {
    return Err("error: invalid value for 'extensions.objectformat': '" + format + "'");
  }
  return Ok(Repo { dir: dir, common: common, prefix: prefix, shown: shown, width: width });
}

const NOT_A_REPOSITORY: string = "fatal: not a git repository (or any of the parent directories): .git";

// The repository of the current directory: `GIT_DIR`, or the `.git` of the
// directory or of one of its parents.
pub function find(): Result[Repo, string] {
  if let Some(dir) = env("GIT_DIR") {
    if (!is_dir(dir)) {
      return Err("fatal: not a git repository: '" + dir + "'");
    }
    return repo_of(dir, "", dir);
  }
  let cwd = match (getcwd()) {
    Ok(path) => path,
    Err(_) => {
      return Err(NOT_A_REPOSITORY);
    },
  };
  let top = cwd;
  while (true) {
    let dir = git_dir_of(top);
    if (dir.len() > 0) {
      let prefix = if (top == cwd) { "" } else { objects.part(cwd, top.len() + 1, cwd.len()) + "/" };
      let shown = if (top == cwd && dir == top + "/.git") { ".git" } else { dir };
      return repo_of(dir, prefix, shown);
    }
    if (top == "/") {
      return Err(NOT_A_REPOSITORY);
    }
    top = parent(top);
  }
  return Err(NOT_A_REPOSITORY);
}

// The hash of `name` in the file `packed-refs`, or "".
function packed_ref(r: Repo, name: string): string {
  let text = match (read_file(r.common + "/packed-refs")) {
    Ok(t) => t,
    Err(_) => {
      return "";
    },
  };
  let full = 2 * r.width;
  for line in text.split("\n") {
    if (line.len() > full + 1 && line[0] != b'#' && line[0] != b'^' && objects.part(line, full + 1, line.len()) == name) {
      return objects.part(line, 0, full);
    }
  }
  return "";
}

// The hash that the ref `name` holds, or "". A ref can name a ref.
function ref_hash(r: Repo, name: string, depth: i32): string {
  if (depth > 5) {
    return "";
  }
  let base = if (name.starts_with("refs/")) { r.common } else { r.dir };
  let text = match (read_file(base + "/" + name)) {
    Ok(t) => first_line(t),
    Err(_) => {
      return packed_ref(r, name);
    },
  };
  if (text.starts_with("ref: ")) {
    return ref_hash(r, objects.part(text, 5, text.len()), depth + 1);
  }
  if (text.len() == 2 * r.width && objects.is_hex(text, 2 * r.width)) {
    return text;
  }
  return "";
}

// A name at the top of the git directory is a ref when it has capital
// letters, `_` and `-` only, as `HEAD` and `ORIG_HEAD`.
function top_ref(name: string): boolean {
  for i in 0..name.len() {
    let b = name[i];
    if (!(b >= b'A' && b <= b'Z' || b == b'_' || b == b'-')) {
      return false;
    }
  }
  return name.len() > 0;
}

// The hash of the ref that `name` means: git tries the name, then the name
// under `refs/`, `refs/tags/`, `refs/heads/` and `refs/remotes/`.
function named_ref(r: Repo, name: string): string {
  let tries: string[] = [];
  if (top_ref(name) || name.starts_with("refs/")) {
    tries = tries.append(name);
  }
  for dir in ["refs/", "refs/tags/", "refs/heads/", "refs/remotes/"] {
    tries = tries.append(dir + name);
  }
  tries = tries.append("refs/remotes/" + name + "/HEAD");
  for t in tries {
    let h = ref_hash(r, t, 0);
    if (h.len() > 0) {
      return h;
    }
  }
  return "";
}

// The full hash that `name` means, or "": a full hash, a ref, or a short
// hash of four digits or more that one object has.
pub function resolve(r: Repo, s: store.Store, name: string): string {
  let full = 2 * r.width;
  if (name.len() == full && objects.is_hex(name, full)) {
    return name.to_ascii_lower();
  }
  let h = named_ref(r, name);
  if (h.len() > 0) {
    return h;
  }
  if (name.len() >= 4 && name.len() < full && objects.is_hex(name, 4)) {
    let found = store.with_prefix(s, name.to_ascii_lower());
    if (found.len() == 1) {
      return found[0];
    }
  }
  return "";
}

// The shortest prefix of `hash`, of `least` digits or more, that no other
// object has.
pub function short_of(s: store.Store, hash: string, least: i32): string {
  let n = least;
  while (n < 2 * s.width && store.with_prefix(s, objects.part(hash, 0, n)).len() > 1) {
    n += 1;
  }
  return objects.part(hash, 0, n);
}
