// The repository of the current directory, and the names of its objects:
// full and short hashes, `HEAD`, and the refs.
import "std/option";
import "std/string";
import "core/cmp";
import "core/map";
import "./config";
import "./objects";
import "./store";

// `dir` is the git directory. `common` holds the objects and the refs: it is
// `dir`, or the directory that a linked worktree names. `prefix` is the path
// from the top of the worktree to the current directory, with a `/` at its
// end, or "". `top` is the top of the worktree, or "" for a repository
// that `GIT_DIR` names. `algo` is the hash of the names of the objects.
// `packed` holds the refs of the file `packed-refs`.
pub struct Repo { dir: string, common: string, prefix: string, shown: string, top: string, config: config.Config, width: i32, packed: Map[string, string] }

pub function (r: Repo) objects(): string {
  return r.common + "/objects";
}

// The object store of the repository.
pub function (r: Repo) store(): store.Store {
  return store.open(r.objects(), r.width, r.config.flag("core.multipackindex", true));
}

function is_dir(path: string): boolean {
  return match (stat(path)) {
    Ok(st) => st.is_dir,
    Err(_) => false,
  };
}

function is_file(path: string): boolean {
  return match (stat(path)) {
    Ok(st) => st.is_file,
    Err(_) => false,
  };
}

function first_line(text: string): string {
  let end = 0;
  while (end < text.len() && text[end] != b'\n' && text[end] != b'\r') {
    end += 1;
  }
  return objects.part(text, 0, end);
}

function parent(path: string): string {
  let i = path.len() - 1;
  while (i > 0 && path[i] != b'/') {
    i -= 1;
  }
  if (i <= 0) {
    return "/";
  }
  return objects.part(path, 0, i);
}

function joined(base: string, path: string): string {
  if (path.starts_with("/")) {
    return path;
  }
  return base + "/" + path;
}

// The directory of the objects and the refs of the git directory `dir`.
function common_of(dir: string): string {
  return match (read_file(dir + "/commondir")) {
    Ok(text) => joined(dir, first_line(text)),
    Err(_) => dir,
  };
}

// The git directory that the entry `.git` of `top` names, or "".
function git_dir_of(top: string): string {
  let entry = top + "/.git";
  if (is_dir(entry)) {
    return entry;
  }
  if let Ok(text) = read_file(entry) {
    let line = first_line(text);
    if (line.starts_with("gitdir: ")) {
      return joined(top, objects.part(line, 8, line.len()));
    }
  }
  return "";
}

// The repository of the git directory `dir`, with its configuration. The
// `config` file gives the hash of the names.
function repo_at(dir: string, prefix: string, shown: string, top: string): Result[Repo, string] {
  let common = common_of(dir);
  let format = match (read_file(common + "/config")) {
    Ok(text) => objects.object_format(text),
    Err(_) => "",
  };
  let width = objects.width_of(format);
  if (width == 0) {
    return Err("error: invalid value for 'extensions.objectformat': '" + format + "'");
  }
  let cfg = config.read(common + "/config");
  return Ok(Repo { dir: dir, common: common, prefix: prefix, shown: shown, top: top, config: cfg, width: width, packed: packed_refs(common, width) });
}

const NOT_A_REPOSITORY: string = "fatal: not a git repository (or any of the parent directories): .git";

// The repository of the current directory: `GIT_DIR`, or the `.git` of the
// directory or of one of its parents.
pub function find(): Result[Repo, string] {
  if let Some(dir) = env("GIT_DIR") {
    if (!is_dir(dir)) {
      return Err("fatal: not a git repository: '" + dir + "'");
    }
    return repo_at(dir, "", dir, "");
  }
  let cwd = match (getcwd()) {
    Ok(path) => path,
    Err(_) => {
      return Err(NOT_A_REPOSITORY);
    },
  };
  let top = cwd;
  while (true) {
    let dir = git_dir_of(top);
    if (dir.len() > 0) {
      let prefix = if (top == cwd) { "" } else { objects.part(cwd, top.len() + 1, cwd.len()) + "/" };
      let shown = if (top == cwd && dir == top + "/.git") { ".git" } else { dir };
      return repo_at(dir, prefix, shown, top);
    }
    if (top == "/") {
      return Err(NOT_A_REPOSITORY);
    }
    top = parent(top);
  }
  return Err(NOT_A_REPOSITORY);
}

// The refs of the file `packed-refs`, by name.
function packed_refs(common: string, a: i32): Map[string, string] {
  let found: Map[string, string] = Map { };
  let Ok(text) = read_file(common + "/packed-refs") else {
    return found;
  };
  let n = 2 * a;
  for line in text.split("\n") {
    if (line.len() > n + 1 && line[0] != b'#' && line[0] != b'^' && line[n] == b' ') {
      found = found.insert(objects.part(line, n + 1, line.len()), objects.part(line, 0, n));
    }
  }
  return found;
}

// A ref after the refs that it names: the hash, and the name of the last
// ref. The hash is "" when no ref has the name.
pub struct Resolved { hash: string, name: string }

// The ref `name`, with each `ref: ` followed.
pub function resolve_ref(r: Repo, name: string): Resolved {
  let at = name;
  for depth in 0..6 {
    let base = if (at.starts_with("refs/")) { r.common } else { r.dir };
    let text = match (read_file(base + "/" + at)) {
      Ok(t) => first_line(t),
      Err(_) => {
        return Resolved { hash: r.packed.get_or(at, ""), name: at };
      },
    };
    if (!text.starts_with("ref: ")) {
      return Resolved { hash: if (objects.is_name(r.width, text)) { text } else { "" }, name: at };
    }
    at = objects.part(text, 5, text.len());
  }
  return Resolved { hash: "", name: at };
}

// The ref that HEAD names, as `refs/heads/main`, or "" when HEAD holds a
// hash.
pub function head_branch(r: Repo): string {
  let Ok(text) = read_file(r.dir + "/HEAD") else {
    return "";
  };
  let line = first_line(text);
  return if (line.starts_with("ref: ")) { objects.part(line, 5, line.len()) } else { "" };
}

// A name at the top of the git directory is a ref when it has capital
// letters, `_` and `-` only, as `HEAD` and `ORIG_HEAD`.
function top_ref(name: string): boolean {
  for i in 0..name.len() {
    let b = name[i];
    if (!(b >= b'A' && b <= b'Z' || b == b'_' || b == b'-')) {
      return false;
    }
  }
  return name.len() > 0;
}

// The full names that git tries for `name`, in order: the name, then the
// name under `refs/`, `refs/tags/`, `refs/heads/` and `refs/remotes/`, and
// the HEAD of a remote.
pub function rule_names(name: string): string[] {
  let tries: string[] = [];
  if (top_ref(name) || name.starts_with("refs/")) {
    tries = tries.append(name);
  }
  for dir in ["refs/", "refs/tags/", "refs/heads/", "refs/remotes/"] {
    tries = tries.append(dir + name);
  }
  return tries.append("refs/remotes/" + name + "/HEAD");
}

// The refs that a short name means: the hash and the full name of the
// first, and the count of names that are refs.
pub struct Dwim { hash: string, name: string, count: i32 }

pub function dwim_ref(r: Repo, name: string): Dwim {
  let found = Dwim { hash: "", name: "", count: 0 };
  for t in rule_names(name) {
    let got = resolve_ref(r, t);
    if (got.hash.len() > 0) {
      if (found.count == 0) {
        found = Dwim { hash: got.hash, name: got.name, count: 1 };
      } else {
        found = Dwim { ...found, count: found.count + 1 };
      }
    }
  }
  return found;
}

// The file of the reflog of the ref `name`.
function log_path(r: Repo, name: string): string {
  let base = if (name.starts_with("refs/")) { r.common } else { r.dir };
  return base + "/logs/" + name;
}

pub function reflog_exists(r: Repo, name: string): boolean {
  return is_file(log_path(r, name));
}

// The ref of a short name that has a reflog: the name, or the ref that it
// names when only that ref has one. `hash` is the value of the ref.
pub function dwim_log(r: Repo, name: string): Dwim {
  let found = Dwim { hash: "", name: "", count: 0 };
  for t in rule_names(name) {
    let got = resolve_ref(r, t);
    if (got.hash.len() > 0) {
      let it = if (reflog_exists(r, t)) { t } else if (got.name != t && reflog_exists(r, got.name)) { got.name } else { "" };
      if (it.len() > 0) {
        found = if (found.count == 0) { Dwim { hash: got.hash, name: it, count: 1 } } else { Dwim { ...found, count: found.count + 1 } };
      }
    }
  }
  return found;
}

// One line of a reflog: the old and the new hash, the person, the time,
// the zone and the message.
pub struct LogEntry { old: string, new: string, who: string, time: i64, zone: i32, message: string }

// The entries of the reflog of the ref `name`, the oldest first.
pub function reflog(r: Repo, name: string): LogEntry[] {
  let out: LogEntry[] = [];
  let Ok(text) = read_file(log_path(r, name)) else {
    return out;
  };
  let n = 2 * r.width;
  for line in text.split("\n") {
    if (line.len() > 2 * n + 2) {
      let tab = match (line.index_of("\t")) {
        Some(i) => i,
        None => line.len(),
      };
      let close = objects.part(line, 0, tab).last_index_of(">").unwrap_or(-1);
      let rest = if (close >= 0) { objects.part(line, close + 1, tab).trim() } else { "" };
      let space = rest.index_of(" ").unwrap_or(rest.len());
      let time = digits(objects.part(rest, 0, space));
      let zone_text = if (space < rest.len()) { objects.part(rest, space + 1, rest.len()) } else { "+0000" };
      let z = digits(zone_text) as i32;
      let message = if (tab < line.len()) { objects.part(line, tab + 1, line.len()) } else { "" };
      let who = if (close > 2 * n + 2) { objects.part(line, 2 * n + 2, close + 1) } else { "" };
      out = out.append(LogEntry { old: objects.part(line, 0, n), new: objects.part(line, n + 1, 2 * n + 1), who: who, time: time, zone: if (zone_text.starts_with("-")) { -z } else { z }, message: message });
    }
  }
  return out;
}

function digits(text: string): i64 {
  let n: i64 = 0;
  for i in 0..text.len() {
    if (text[i] >= b'0' && text[i] <= b'9') {
      n = n * 10 + (text[i] - b'0') as i64;
    }
  }
  return n;
}

// Each ref under `refs/` with its hash, in the order of the names. A
// loose ref hides the packed ref of its name.
pub function all_refs(r: Repo): Resolved[] {
  let names = loose_names(r.common + "/refs", "refs");
  let out: Resolved[] = [];
  let seen: Map[string, boolean] = Map { };
  for n in names {
    let got = resolve_ref(r, n);
    seen = seen.insert(n, true);
    if (got.hash.len() > 0) {
      out = out.append(Resolved { hash: got.hash, name: n });
    }
  }
  for e in r.packed.entries() {
    let (name, hash) = e;
    if (!seen.contains(name)) {
      out = out.append(Resolved { hash: hash, name: name });
    }
  }
  return cmp.sort_by(out, (a: Resolved, b: Resolved): i32 => a.name.cmp(b.name));
}

// The names of the files below the directory `dir`, as `prefix/...`.
function loose_names(dir: string, prefix: string): string[] {
  let out: string[] = [];
  let Ok(names) = read_dir(dir) else {
    return out;
  };
  for n in names {
    let path = dir + "/" + n;
    if (is_dir(path)) {
      out = out.concat(loose_names(path, prefix + "/" + n));
    } else {
      out = out.append(prefix + "/" + n);
    }
  }
  return out;
}

// The shortest prefix of `hash`, of `least` digits or more, that no other
// object has.
pub function short_of(s: store.Store, hash: string, least: i32): string {
  let n = least;
  while (n < hash.len() && store.with_prefix(s, objects.part(hash, 0, n)).len() > 1) {
    n += 1;
  }
  return objects.part(hash, 0, n);
}
