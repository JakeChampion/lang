// The file `config` of a repository: sections, keys and values.
//
//   [core]
//       bare = false
//   [branch "main"]
//       remote = origin
//
// A name is `section.key`, or `section.subsection.key`. The section and the
// key have no capital letters in a name. The subsection keeps its case.
import "core/cmp";
import "std/array";
import "std/string";
import "./objects";

// One entry. `line` is the line of the file where its value ends, from 1.
// `bare` is true for a key with no `=`: its value is "true", and git
// refuses it where it needs a text.
pub struct Entry { name: string, value: string, line: i32, bare: boolean }

// `file` is the name of the file as git writes it in a message.
pub struct Config { entries: Entry[], file: string }

pub function empty(): Config {
  return Config { entries: [], file: "" };
}

// The configuration in the file `path`, which a message of git names
// `shown`. A file that does not open gives no entries.
pub function read(path: string, shown: string): Config {
  return match (read_file(path)) {
    Ok(text) => Config { ...parse(text), file: shown },
    Err(_) => empty(),
  };
}

// The message of git when it stops at the entry `e`, whose value the
// caller refuses.
pub function (c: Config) bad(e: Entry): string {
  return "bad config variable '" + e.name + "' in file '" + c.file + "' at line " + e.line.to_string();
}

// The line of the error of git for the entry `e` with no value.
pub function missing_value(e: Entry): string {
  return "missing value for '" + e.name + "'";
}

// The integer of a value of the configuration (`git_parse_int` of git),
// or the reason why git refuses it.
pub function integer(value: string): Result[i64, string] {
  let i = 0;
  while (i < value.len() && (objects.is_space(value[i]) || value[i] == 11 || value[i] == 12)) {
    i += 1;
  }
  let negative = i < value.len() && value[i] == b'-';
  if (negative || i < value.len() && value[i] == b'+') {
    i += 1;
  }
  let base = 10;
  if (i < value.len() && value[i] == b'0') {
    base = 8;
    if (i + 1 < value.len() && (value[i + 1] == b'x' || value[i + 1] == b'X')) {
      base = 16;
      i += 2;
    }
  }
  let digits = i;
  let n: u64 = 0;
  let limit: u64 = 9223372036854775807;
  if (negative) {
    limit += 1;
  }
  while (i < value.len()) {
    let digit = objects.hex_digit(value[i]);
    if (digit < 0 || digit >= base) {
      break;
    }
    if (n > (limit - digit as u64) / (base as u64)) {
      return Err("out of range");
    }
    n = n * (base as u64) + digit as u64;
    i += 1;
  }
  if (i == digits) {
    return Err("invalid unit");
  }
  let unit = objects.part(value, i, value.len()).to_ascii_lower();
  let factor: u64 = if (unit == "") { 1 } else if (unit == "k") { 1024 } else if (unit == "m") { 1048576 } else if (unit == "g") { 1073741824 } else { 0 };
  if (factor == 0) {
    return Err("invalid unit");
  }
  let max_int: u64 = if (negative) { 2147483648 } else { 2147483647 };
  if (n > max_int / factor) {
    return Err("out of range");
  }
  let v = (n * factor) as i64;
  return Ok(if (negative) { -v } else { v });
}

// The default object-name length. Zero selects Git's automatic length.
pub function (c: Config) abbrev(width: i32): Result[i32, string] {
  let length = 0;
  for e in c.entries {
    if (e.name != "core.abbrev") {
      continue;
    }
    if (e.bare) {
      return Err("error: " + missing_value(e) + "\nfatal: " + c.bad(e));
    }
    let low = e.value.to_ascii_lower();
    if (low == "auto") {
      length = 0;
    } else if (low == "" || low == "false" || low == "no" || low == "off") {
      length = width * 2;
    } else {
      match (integer(e.value)) {
        Ok(n) => {
          if (n < 4) {
            return Err("error: abbrev length out of range: " + n.to_string() + "\nfatal: " + c.bad(e));
          }
          length = (n as i32).min(width * 2);
        },
        Err(reason) => {
          return Err("fatal: bad numeric config value '" + e.value + "' for '" + e.name + "' in file " + c.file + ": " + reason);
        }
      }
    }
  }
  return Ok(length);
}

// The last value of the name `name`, or None.
pub function (c: Config) get(name: string): Option[string] {
  let found: Option[string] = None;
  for e in c.entries {
    if (e.name == name) {
      found = Some(e.value);
    }
  }
  return found;
}

// Each value of the name `name`, in the order of the file.
pub function (c: Config) all(name: string): string[] {
  let out: string[] = [];
  for e in c.entries {
    if (e.name == name) {
      out = out.append(e.value);
    }
  }
  return out;
}

// The value of `name` as a boolean, or `otherwise` when it is not set.
pub function (c: Config) flag(name: string, otherwise: boolean): boolean {
  let Some(v) = c.get(name) else {
    return otherwise;
  };
  let low = v.to_ascii_lower();
  if (low == "false" || low == "no" || low == "off" || low == "0") {
    return false;
  }
  return true;
}

function is_space(b: u8): boolean {
  return b == b' ' || b == b'\t' || b == b'\r';
}

function is_key_byte(b: u8): boolean {
  return b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z' || b >= b'0' && b <= b'9' || b == b'-';
}

// The value from `at` to the end of its line, without its comment, with the
// quotes and the escapes of git, and the place after the line.
function value_at(text: string, at: i32): (string, i32) {
  let out: u8[] = [];
  let i = at;
  let quoted = false;
  let kept = 0;
  while (i < text.len() && is_space(text[i])) {
    i += 1;
  }
  while (i < text.len()) {
    let b = text[i];
    if (b == b'\n' && !quoted) {
      break;
    }
    if (!quoted && (b == b'#' || b == b';')) {
      while (i < text.len() && text[i] != b'\n') {
        i += 1;
      }
      break;
    }
    if (b == b'"') {
      quoted = !quoted;
      kept = out.len();
      i += 1;
      continue;
    }
    if (b == b'\\' && i + 1 < text.len()) {
      let next = text[i + 1];
      if (next == b'\n') {
        i += 2;
        continue;
      }
      out = out.append(match (next) {
        b'n' => b'\n',
        b't' => b'\t',
        b'b' => 8,
        _ => next,
      });
      kept = out.len();
      i += 2;
      continue;
    }
    out = out.append(b);
    if (quoted || !is_space(b)) {
      kept = out.len();
    }
    i += 1;
  }
  return (unsafe { string_from_bytes_unchecked(array.slice(out, 0, kept)) }, i + 1);
}

// The section of the header `[...]` at `at`, and the place after the `]`.
function section_at(text: string, at: i32): (string, i32) {
  let i = at + 1;
  let name = "";
  while (i < text.len() && text[i] != b']' && text[i] != b'"' && !is_space(text[i])) {
    i += 1;
  }
  name = slice_unchecked(text, at + 1, i).to_owned().to_ascii_lower();
  while (i < text.len() && is_space(text[i])) {
    i += 1;
  }
  if (i < text.len() && text[i] == b'"') {
    let sub: u8[] = [];
    i += 1;
    while (i < text.len() && text[i] != b'"' && text[i] != b'\n') {
      if (text[i] == b'\\' && i + 1 < text.len()) {
        i += 1;
      }
      sub = sub.append(text[i]);
      i += 1;
    }
    name = name + "." + unsafe { string_from_bytes_unchecked(sub) };
    while (i < text.len() && text[i] != b']' && text[i] != b'\n') {
      i += 1;
    }
  }
  return (name, i + 1);
}

// The entries of the text of a configuration file.
pub function parse(text: string): Config {
  let entries: Entry[] = [];
  let section = "";
  let i = 0;
  // `line` is the line of the byte at `counted`.
  let line = 1;
  let counted = 0;
  while (i < text.len()) {
    let b = text[i];
    if (is_space(b) || b == b'\n') {
      i += 1;
    } else if (b == b'#' || b == b';') {
      while (i < text.len() && text[i] != b'\n') {
        i += 1;
      }
    } else if (b == b'[') {
      let (name, next) = section_at(text, i);
      section = name;
      i = next;
    } else if (is_key_byte(b)) {
      let start = i;
      while (i < text.len() && is_key_byte(text[i])) {
        i += 1;
      }
      let key = slice_unchecked(text, start, i).to_owned().to_ascii_lower();
      while (i < text.len() && is_space(text[i])) {
        i += 1;
      }
      if (i < text.len() && text[i] == b'=') {
        let (value, next) = value_at(text, i + 1);
        line += newlines(text, counted, next - 1);
        counted = next - 1;
        entries = entries.append(Entry { name: section + "." + key, value: value, line: line, bare: false });
        i = next;
      } else {
        while (i < text.len() && text[i] != b'\n') {
          i += 1;
        }
        line += newlines(text, counted, i);
        counted = i;
        entries = entries.append(Entry { name: section + "." + key, value: "true", line: line, bare: true });
      }
    } else {
      while (i < text.len() && text[i] != b'\n') {
        i += 1;
      }
    }
  }
  return Config { entries: entries, file: "" };
}

function newlines(text: string, from: i32, to: i32): i32 {
  let n = 0;
  for k in from..to.min(text.len()) {
    if (text[k] == b'\n') {
      n += 1;
    }
  }
  return n;
}
