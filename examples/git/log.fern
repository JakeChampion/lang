// The fields of a commit and the text that `git log` prints for one
// (pretty.c of git).
import "std/array";
import "std/string";
import "./color";
import "./date";
import "./mailmap";
import "./objects";
import "./width";

// A name, an address, the seconds since 1970 and the zone, as `+0100`.
pub struct Person { name: string, email: string, time: i64, zone: string }

// The fields of a commit. `body` is the whole content of the commit.
pub struct Commit { hash: string, tree: string, parents: string[], author: Person, committer: Person, message: string, body: u8[] }

function digits(text: string, from: i32, to: i32): i64 {
  let n: i64 = 0;
  for i in from..to {
    if (text[i] >= b'0' && text[i] <= b'9') {
      n = n * 10 + (text[i] - b'0') as i64;
    }
  }
  return n;
}

// The person of a header line: `NAME <EMAIL> SECONDS ZONE`.
pub function person(line: string): Person {
  let open = line.len();
  let close = line.len();
  for i in 0..line.len() {
    if (line[i] == b'<' && open == line.len()) {
      open = i;
    }
    if (line[i] == b'>') {
      close = i;
    }
  }
  if (open >= close) {
    return Person { name: line, email: "", time: 0, zone: "+0000" };
  }
  let rest = objects.part(line, close + 1, line.len()).trim();
  let space = match (rest.index_of(" ")) {
    Some(i) => i,
    None => rest.len(),
  };
  let zone = if (space < rest.len()) { objects.part(rest, space + 1, rest.len()) } else { "+0000" };
  return Person { name: objects.part(line, 0, open).trim(), email: objects.part(line, open + 1, close), time: digits(rest, 0, space), zone: zone };
}

// The zone of the person as git's number: -100 for -0100.
pub function (p: Person) zone_number(): i32 {
  return date.zone_number(p.zone);
}

// The text of `body` from `from` to `to`.
function text_of(body: u8[], from: i32, to: i32): string {
  return unsafe { string_from_bytes_unchecked(array.slice(body, from, to)) };
}

// The fields of the commit `hash` with the content `body`. One pass reads
// the header lines, to the first empty line.
pub function commit_of(hash: string, body: u8[]): Commit {
  let tree = "";
  let author = "";
  let committer = "";
  let parents: string[] = [];
  let i = 0;
  while (i < body.len() && body[i] != b'\n') {
    let end = i;
    while (end < body.len() && body[end] != b'\n') {
      end += 1;
    }
    if (end - i > 7 && objects.starts_at(body, i, "parent ")) {
      parents = parents.append(text_of(body, i + 7, end));
    } else if (end - i > 5 && tree.len() == 0 && objects.starts_at(body, i, "tree ")) {
      tree = text_of(body, i + 5, end);
    } else if (end - i > 7 && author.len() == 0 && objects.starts_at(body, i, "author ")) {
      author = text_of(body, i + 7, end);
    } else if (end - i > 10 && committer.len() == 0 && objects.starts_at(body, i, "committer ")) {
      committer = text_of(body, i + 10, end);
    }
    i = end + 1;
  }
  let message = if (i + 1 <= body.len()) { text_of(body, i + 1, body.len()) } else { "" };
  return Commit { hash: hash, tree: tree, parents: parents, author: person(author), committer: person(committer), message: message, body: body };
}

// The date as git prints it by default: `Fri Nov 13 21:05:41 2026 +0000`,
// on the clock of the zone.
pub function date_text(p: Person): string {
  return date.show(p.time, p.zone_number(), date.normal_mode());
}

// ---- Lines of a message ----

// The end of the line at `at`, after its line end, or the end of `text`.
function line_end(text: string, at: i32): i32 {
  let i = at;
  while (i < text.len() && text[i] != b'\n') {
    i += 1;
  }
  return if (i < text.len()) { i + 1 } else { i };
}

// The end of the text of the line from `at` to `end` with no white space
// at its end.
function trim_end(text: string, at: i32, end: i32): i32 {
  let e = end;
  while (e > at && objects.is_space(text[e - 1])) {
    e -= 1;
  }
  return e;
}

// The place after the empty lines at `at`.
function skip_blank(text: string, at_in: i32): i32 {
  let at = at_in;
  while (at < text.len()) {
    let end = line_end(text, at);
    if (trim_end(text, at, end) > at) {
      return at;
    }
    at = end;
  }
  return at;
}

// The first paragraph of the message from `at`, its lines joined with
// `sep`, and the place after it: `format_subject` of git.
function subject_from(text: string, at_in: i32, sep: string): (string, i32) {
  let at = at_in;
  let out = "";
  let first = true;
  while (at < text.len()) {
    let end = line_end(text, at);
    let e = trim_end(text, at, end);
    if (e == at) {
      return (out, end);
    }
    if (!first) {
      out += sep;
    }
    out += objects.part(text, at, e);
    first = false;
    at = end;
  }
  return (out, at);
}

// The first paragraph of the message as one line.
pub function subject(message: string): string {
  let (s, _) = subject_from(message, skip_blank(message, 0), " ");
  return s;
}

// The message after its first paragraph and the empty lines that follow it.
pub function body_of(message: string): string {
  let (_, after) = subject_from(message, skip_blank(message, 0), " ");
  return objects.part(message, skip_blank(message, after), message.len());
}

// The line from `at` to `end` with each tab as spaces up to the next column
// that 8 divides, where a wide character has two columns. A part that is
// not sound UTF-8, or that has a control character, stops the expansion.
pub function tabs_expanded(text: string, at: i32, end: i32): string {
  let b = text.bytes();
  let out = "";
  let from = at;
  let i = at;
  while (i < end) {
    if (b[i] == b'\t') {
      let w = width.width_of(b, from, i);
      if (w < 0) {
        return out + objects.part(text, from, end);
      }
      out += objects.part(text, from, i) + " ".repeat(8 - w % 8);
      from = i + 1;
    }
    i += 1;
  }
  return out + objects.part(text, from, end);
}

// The lines of the message after the header, from `at`: each line with
// `indent` spaces, and the tabs expanded with `tabs`. The empty lines at
// the start go, and `short` stops at the first empty line.
function remainder(text: string, at_in: i32, indent: i32, tabs: boolean, short: boolean): string {
  let at = at_in;
  let out = "";
  let first = true;
  while (at < text.len()) {
    let end = line_end(text, at);
    let e = trim_end(text, at, end);
    if (e == at) {
      if (first) {
        at = end;
        continue;
      }
      if (short) {
        break;
      }
    }
    first = false;
    out += " ".repeat(indent) + (if (tabs) { tabs_expanded(text, at, e) } else { objects.part(text, at, e) }) + "\n";
    at = end;
  }
  return out;
}

// The text with no white space at its end.
function rtrim(text: string): string {
  return objects.part(text, 0, trim_end(text, 0, text.len()));
}

// ---- The forms of a commit ----

// What a form needs besides the commit: the short form of a hash, the
// parents to show (after the simplification of the history), the form of
// the dates, the decorations, and the mailmap, which `%aN` uses and the
// header lines use with `use_mailmap`.
//
// `mark` goes before the name of the commit on its first line, as
// `--left-right`, `--boundary` and `--cherry-mark` give it, and `side` is
// the mark of `%m`.
//
// `reflog` holds the entry of the reflog of a walk of `--walk-reflogs`.
// `color` is true when the output has colors, `from` is the parent of the
// diff of `-m` or "", and `graph_width` is the width of the graph before
// the text, which `%<|(N)` counts. `notes` is the text of the notes of
// the commit when `notes_shown` is true, which `%N` gives.
pub struct Context { abbrev: (string) => string, abbrev_commit: boolean, parents: string[], dates: date.Mode, decorations: Decoration[], mailmap: mailmap.Mailmap, use_mailmap: boolean, mark: string, side: string, reflog: ReflogLine[], color: boolean, from: string, graph_width: i32, notes: string, notes_shown: boolean }

// A ref that names a commit, with its kind (`color.DECORATION_LOCAL` and
// the others). A decoration of `HEAD` that names a branch of the commit
// holds that branch in `branch`, for `HEAD -> BRANCH`.
pub struct Decoration { name: string, kind: i32, branch: string }

// The decorations `ds` between `prefix` and `suffix`, with `, ` between
// two: `format_decorations` of git.
pub function decorations_text(ds: Decoration[], with_color: boolean, prefix: string, suffix: string): string {
  if (ds.len() == 0) {
    return "";
  }
  let commit = if (with_color) { color.YELLOW } else { "" };
  let reset = if (with_color) { color.RESET } else { "" };
  let out = "";
  let before = prefix;
  for d in ds {
    if (before.len() > 0) {
      out += commit + before + reset;
    }
    let c = if (with_color) { color.decoration(d.kind) } else { "" };
    if (d.kind == color.DECORATION_TAG) {
      out += c + "tag: " + reset;
    }
    out += c + d.name + reset;
    if (d.branch.len() > 0) {
      out += commit + " -> " + reset + (if (with_color) { color.decoration(color.DECORATION_LOCAL) } else { "" }) + d.branch + reset;
    }
    before = ", ";
  }
  if (suffix.len() > 0) {
    out += commit + suffix + reset;
  }
  return out;
}

// An entry of a reflog: its selector (`HEAD@{1}`), the selector with a
// short ref name, the message, and the person `NAME <EMAIL>`.
pub struct ReflogLine { selector: string, short: string, message: string, who: string }

// The person of a header line, with the mailmap when the log uses it.
function shown(p: Person, ctx: Context): Person {
  return if (ctx.use_mailmap) { mapped(p, ctx) } else { p };
}

// The person with the proper name and email of the mailmap.
function mapped(p: Person, ctx: Context): Person {
  if (ctx.mailmap.is_empty()) {
    return p;
  }
  let (name, email) = mailmap.map_user(ctx.mailmap, p.name, p.email);
  return Person { ...p, name: name, email: email };
}

function shown_parents(ctx: Context, names: string[]): string {
  let abbrev = ctx.abbrev;
  let out = "";
  for p in names {
    out += " " + abbrev(p);
  }
  return out;
}

function user_line(what: string, p: Person, fuller: boolean): string {
  return what + ": " + (if (fuller) { "    " } else { "" }) + p.name + " <" + p.email + ">\n";
}

// The header lines of a built-in form, after the `commit` line.
function header(c: Commit, ctx: Context, form: string): string {
  if (form == "raw") {
    let end = 0;
    while (end < c.body.len() && !(c.body[end] == b'\n' && (end + 1 >= c.body.len() || c.body[end + 1] == b'\n'))) {
      end += 1;
    }
    return text_of(c.body, 0, (end + 1).min(c.body.len()));
  }
  let out = "";
  if (ctx.parents.len() > 1) {
    out += "Merge:" + shown_parents(ctx, ctx.parents) + "\n";
  }
  out += user_line("Author", shown(c.author, ctx), form == "fuller");
  if (form == "medium") {
    out += "Date:   " + date.show(c.author.time, c.author.zone_number(), ctx.dates) + "\n";
  } else if (form == "fuller") {
    out += "AuthorDate: " + date.show(c.author.time, c.author.zone_number(), ctx.dates) + "\n";
  }
  if (form == "full" || form == "fuller") {
    out += user_line("Commit", shown(c.committer, ctx), form == "fuller");
    if (form == "fuller") {
      out += "CommitDate: " + date.show(c.committer.time, c.committer.zone_number(), ctx.dates) + "\n";
    }
  }
  return out;
}

// The text of a built-in form after its first line, as
// `pretty_print_commit` of git gives it: "oneline" gives the subject, and
// the other forms end with a line end.
pub function pretty(c: Commit, ctx: Context, form: string): string {
  let m = c.message;
  if (ctx.reflog.len() > 0) {
    let e = ctx.reflog[0];
    if (form == "oneline") {
      return e.selector + ": " + e.message;
    }
    return "Reflog: " + e.selector + " (" + e.who + ")\nReflog message: " + e.message + "\n" + pretty(c, Context { ...ctx, reflog: [] }, form);
  }
  if (form == "oneline") {
    let (s, _) = subject_from(m, skip_blank(m, 0), " ");
    return rtrim(s);
  }
  let tabs = form == "medium" || form == "full" || form == "fuller";
  let text = header(c, ctx, form) + "\n" + remainder(m, 0, 4, tabs, form == "short");
  return rtrim(text) + "\n";
}

// The first line of a built-in form: `commit HASH` with the parents and
// the decorations.
pub function first_line(c: Commit, ctx: Context, form: string, with_parents: boolean): string {
  let abbrev = ctx.abbrev;
  let name = if (ctx.abbrev_commit) { abbrev(c.hash) } else { c.hash };
  let mark = if (ctx.mark.len() > 0) { ctx.mark + " " } else { "" };
  let out = if (ctx.color) { color.YELLOW } else { "" };
  out += if (form == "oneline") { mark + name } else { "commit " + mark + name };
  if (with_parents) {
    for p in ctx.parents {
      out += " " + (if (ctx.abbrev_commit) { abbrev(p) } else { p });
    }
  }
  if (ctx.from.len() > 0) {
    out += " (from " + (if (ctx.abbrev_commit) { abbrev(ctx.from) } else { ctx.from }) + ")";
  }
  if (ctx.color) {
    out += color.RESET;
  }
  return out + decorations_text(ctx.decorations, ctx.color, " (", ")");
}

// The form `reference`: `abbrev (subject, date)`.
pub function reference(c: Commit, ctx: Context): string {
  let abbrev = ctx.abbrev;
  return commit_color(abbrev(c.hash), ctx.color) + " (" + subject(c.message) + ", " + date.show(c.author.time, c.author.zone_number(), date.Mode { kind: date.SHORT, local: false, format: "" }) + ")";
}

// ---- The placeholders of a format ----

// The subject as a name of a file: the letters, the digits, `.` and `_`,
// with one `-` for each run of other bytes.
function sanitized(text: string): string {
  let out: u8[] = [];
  let space = 2;
  let i = 0;
  while (i < text.len()) {
    let b = if (text[i] == b'\n') { b' ' } else { text[i] };
    let title = b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z' || b >= b'0' && b <= b'9' || b == b'.' || b == b'_';
    if (title) {
      if (space == 1) {
        out = out.append(b'-');
      }
      space = 0;
      out = out.append(b);
      if (b == b'.') {
        while (i + 1 < text.len() && text[i + 1] == b'.') {
          i += 1;
        }
      }
    } else {
      space |= 1;
    }
    i += 1;
  }
  let n = out.len();
  while (n > 0 && (out[n - 1] == b'.' || out[n - 1] == b'-')) {
    n -= 1;
  }
  return unsafe { string_from_bytes_unchecked(array.slice(out, 0, n)) };
}

function hex_value(b: u8): i32 {
  if (b >= b'0' && b <= b'9') {
    return (b - b'0') as i32;
  }
  if (b >= b'a' && b <= b'f') {
    return (b - b'a') as i32 + 10;
  }
  if (b >= b'A' && b <= b'F') {
    return (b - b'A') as i32 + 10;
  }
  return -1;
}

// The text for the two letters after `%a` or `%c`, or None.
function person_field(raw: Person, letter: u8, ctx: Context): Option[string] {
  let p = if (letter == b'N' || letter == b'E' || letter == b'L') { mapped(raw, ctx) } else { raw };
  let z = p.zone_number();
  let mode = (kind: i32): date.Mode => date.Mode { kind: kind, local: false, format: "" };
  return match (letter) {
    b'n' => Some(p.name),
    b'N' => Some(p.name),
    b'e' => Some(p.email),
    b'E' => Some(p.email),
    b'l' => Some(objects.part(p.email, 0, p.email.index_of("@").unwrap_or(p.email.len()))),
    b'L' => Some(objects.part(p.email, 0, p.email.index_of("@").unwrap_or(p.email.len()))),
    b't' => Some(p.time.to_string()),
    b'd' => Some(date.show(p.time, z, ctx.dates)),
    b'D' => Some(date.show(p.time, z, mode(date.RFC))),
    b'r' => Some(date.show(p.time, z, mode(date.RELATIVE))),
    b'i' => Some(date.show(p.time, z, mode(date.ISO))),
    b'I' => Some(date.show(p.time, z, mode(date.ISO_STRICT))),
    b'h' => Some(date.show(p.time, z, mode(date.HUMAN))),
    b's' => Some(date.show(p.time, z, mode(date.SHORT))),
    _ => None,
  };
}

function commit_color(text: string, auto: boolean): string {
  return if (auto) { color.YELLOW + text + color.RESET } else { text };
}

// The text of the color placeholder at `at` (the `C` after a `%`), and the
// count of bytes that it takes, or 0: `parse_color` of git. With no
// colors, only `%C(always,...)` gives a text. A spec that is not a color
// gives none, and `bad_color` finds it first.
function color_placeholder(format: string, at: i32, want: boolean): (string, i32) {
  if (at + 1 < format.len() && format[at + 1] == b'(') {
    let close = at + 2;
    while (close < format.len() && format[close] != b')') {
      close += 1;
    }
    if (close >= format.len()) {
      return ("", 0);
    }
    let (spec, parsed) = color_spec(objects.part(format, at + 2, close), want);
    let n = close - at + 1;
    if (!parsed) {
      return ("", n);
    }
    return (color.parse(spec).unwrap_or(""), n);
  }
  let rest = objects.part(format, at + 1, format.len());
  let names = ["red", "green", "blue", "reset"];
  let codes = [color.RED, color.GREEN, color.BLUE, color.RESET];
  for i in 0..names.len() {
    if (rest.starts_with(names[i])) {
      return (if (want) { codes[i] } else { "" }, names[i].len() + 1);
    }
  }
  return ("", 0);
}

// The color of a spec of `%C(...)` without its `auto,` or `always,`, and
// false when the spec gives no color.
function color_spec(text: string, want: boolean): (string, boolean) {
  if (text.starts_with("auto,")) {
    return (objects.part(text, 5, text.len()), want);
  }
  if (text.starts_with("always,")) {
    return (objects.part(text, 7, text.len()), true);
  }
  return (text, want);
}

// The first color spec of the format that is not a color, which git
// stops on, or an empty string.
pub function bad_color(format: string, want: boolean): string {
  let i = 0;
  while (i + 1 < format.len()) {
    if (format[i] == b'%' && format[i + 1] == b'%') {
      i += 2;
      continue;
    }
    if (format[i] == b'%' && format[i + 1] == b'C' && i + 2 < format.len() && format[i + 2] == b'(') {
      let close = i + 3;
      while (close < format.len() && format[close] != b')') {
        close += 1;
      }
      let text = objects.part(format, i + 3, close.min(format.len()));
      if (close < format.len() && text != "auto") {
        let (spec, parsed) = color_spec(text, want);
        if (parsed && color.parse(spec).is_none()) {
          return spec;
        }
      }
    }
    i += 1;
  }
  return "";
}

// The text for the placeholder at `at`, which is after a `%`, and the
// count of bytes that it takes. A count of 0 is not a placeholder.
function placeholder(c: Commit, ctx: Context, format: string, at: i32, auto: boolean): (string, i32) {
  let letter = format[at];
  let abbrev = ctx.abbrev;
  if ((letter == b'a' || letter == b'c') && at + 1 < format.len()) {
    let p = if (letter == b'a') { c.author } else { c.committer };
    return match (person_field(p, format[at + 1], ctx)) {
      Some(text) => (text, 2),
      None => ("", 0),
    };
  }
  if (letter == b'g' && at + 1 < format.len()) {
    if (ctx.reflog.len() == 0) {
      let known = match (format[at + 1]) {
        b'd' => true,
        b'D' => true,
        b's' => true,
        b'n' => true,
        b'e' => true,
        b'N' => true,
        b'E' => true,
        _ => false,
      };
      return ("", if (known) { 2 } else { 0 });
    }
    let e = ctx.reflog[0];
    let p = person(e.who + " 0 +0000");
    let m = mapped(p, ctx);
    return match (format[at + 1]) {
      b'd' => (e.short, 2),
      b'D' => (e.selector, 2),
      b's' => (e.message, 2),
      b'n' => (p.name, 2),
      b'e' => (p.email, 2),
      b'N' => (m.name, 2),
      b'E' => (m.email, 2),
      _ => ("", 0),
    };
  }
  if (letter == b'x') {
    if (at + 2 < format.len() && hex_value(format[at + 1]) >= 0 && hex_value(format[at + 2]) >= 0) {
      let v = hex_value(format[at + 1]) * 16 + hex_value(format[at + 2]);
      return (unsafe { string_from_bytes_unchecked([v as u8]) }, 3);
    }
    return ("", 0);
  }
  return match (letter) {
    b'H' => (commit_color(c.hash, auto), 1),
    b'h' => (commit_color(abbrev(c.hash), auto), 1),
    b'T' => (c.tree, 1),
    b't' => (abbrev(c.tree), 1),
    b'P' => (ctx.parents.join(" "), 1),
    b'p' => (ctx.parents.map((p: string): string => abbrev(p)).join(" "), 1),
    b'm' => (ctx.side, 1),
    b'd' => (decorations_text(ctx.decorations, auto, " (", ")"), 1),
    b'D' => (decorations_text(ctx.decorations, auto, "", ""), 1),
    b's' => (subject(c.message), 1),
    b'f' => {
      let first = skip_blank(c.message, 0);
      let end = line_end(c.message, first);
      (sanitized(objects.part(c.message, first, if (end > first && c.message[end - 1] == b'\n') { end - 1 } else { end })), 1)
    },
    b'b' => (body_of(c.message), 1),
    b'B' => (c.message, 1),
    b'e' => ("", 1),
    b'N' => (ctx.notes, if (ctx.notes_shown) { 1 } else { 0 }),
    b'n' => ("\n", 1),
    _ => ("", 0),
  };
}

// ---- The expansion of a format (format_commit_message of git) ----

// The sides that `%<(N)`, `%>(N)`, `%><(N)` and `%>>(N)` pad.
const NO_FLUSH: i32 = 0;

const FLUSH_RIGHT: i32 = 1;

const FLUSH_LEFT: i32 = 2;

const FLUSH_BOTH: i32 = 3;

const FLUSH_LEFT_AND_STEAL: i32 = 4;

// The cuts of a text that is wider than its padding.
const TRUNC_NONE: i32 = 0;

const TRUNC_LEFT: i32 = 1;

const TRUNC_MIDDLE: i32 = 2;

const TRUNC_RIGHT: i32 = 3;

// The largest width and indent that git accepts in a placeholder.
const FORMATTING_LIMIT: i64 = 16384;

// The state of the expansion (`format_commit_context` of git): the text so
// far, the colors of `%C(auto)`, the padding, the side and the cut that the
// next placeholder takes, and the wrap of `%w()` with the start of the text
// that it wraps.
struct Expansion { out: string, auto: boolean, padding: i32, flush: i32, trunc: i32, wrap_start: i32, width: i32, indent1: i32, indent2: i32 }

// The number at `at`, as `strtol` of C reads it: the white space, a sign
// and the digits. It gives the place after the digits, or `at` when there
// are no digits.
function c_number(text: string, at: i32): (i64, i32) {
  let i = at;
  while (i < text.len() && (text[i] == b' ' || text[i] >= 9 && text[i] <= 13)) {
    i += 1;
  }
  let negative = false;
  if (i < text.len() && (text[i] == b'+' || text[i] == b'-')) {
    negative = text[i] == b'-';
    i += 1;
  }
  let start = i;
  let v: i64 = 0;
  while (i < text.len() && text[i] >= b'0' && text[i] <= b'9') {
    if (v < 1000000000) {
      v = v * 10 + (text[i] - b'0') as i64;
    }
    i += 1;
  }
  if (i == start) {
    return (0, at);
  }
  return (if (negative) { -v } else { v }, i);
}

// The text from `wrap_start` wrapped with the last values of `%w()`, and
// the new values: `rewrap_message_tail` of git.
function rewrap(e: Expansion, columns: i32, indent1: i32, indent2: i32): Expansion {
  if (e.width == columns && e.indent1 == indent1 && e.indent2 == indent2) {
    return e;
  }
  let out = e.out;
  if (e.wrap_start < out.len()) {
    let tail = width.wrapped(array.slice(out.bytes(), e.wrap_start, out.len()), e.indent1, e.indent2, e.width);
    out = objects.part(out, 0, e.wrap_start) + unsafe { string_from_bytes_unchecked(tail) };
  }
  return Expansion { ...e, out: out, wrap_start: out.len(), width: columns, indent1: indent1, indent2: indent2 };
}

// `%w(WIDTH,INDENT1,INDENT2)` at `at`, the `w`, and the count of bytes
// that it takes, or 0.
function wrap_placeholder(e: Expansion, format: string, at: i32): (Expansion, i32) {
  if (at + 1 >= format.len() || format[at + 1] != b'(') {
    return (e, 0);
  }
  let start = at + 2;
  let close = start;
  while (close < format.len() && format[close] != b')') {
    close += 1;
  }
  if (close >= format.len()) {
    return (e, 0);
  }
  let values: i64[] = [];
  if (close > start) {
    let (v, next) = c_number(format, start);
    values = values.append(v);
    while (values.len() < 3 && next < close && format[next] == b',') {
      let (v2, after) = c_number(format, next + 1);
      values = values.append(v2);
      next = after;
    }
    if (next != close) {
      return (e, 0);
    }
  }
  while (values.len() < 3) {
    values = values.append(0);
  }
  // strtoul of C reads a negative number as a very large one.
  for v in values {
    if (v < 0 || v > FORMATTING_LIMIT) {
      return (e, 0);
    }
  }
  return (rewrap(e, values[0] as i32, values[1] as i32, values[2] as i32), close - at + 1);
}

// `%<(N)`, `%>(N)`, `%><(N)` or `%>>(N)` at `at`, with `|` for a column
// and a cut after a comma, and the count of bytes that it takes, or 0:
// `parse_padding_placeholder` of git. A cut that git does not know gives
// 0, but the padding stays, as in git.
function padding_placeholder(e: Expansion, format: string, at: i32): (Expansion, i32) {
  let i = at + 1;
  let flush = FLUSH_RIGHT;
  if (format[at] == b'>') {
    flush = FLUSH_LEFT;
    if (i < format.len() && format[i] == b'<') {
      flush = FLUSH_BOTH;
      i += 1;
    } else if (i < format.len() && format[i] == b'>') {
      flush = FLUSH_LEFT_AND_STEAL;
      i += 1;
    }
  }
  let to_column = i < format.len() && format[i] == b'|';
  if (to_column) {
    i += 1;
  }
  if (i >= format.len() || format[i] != b'(') {
    return (e, 0);
  }
  let start = i + 1;
  let end = start;
  while (end < format.len() && format[end] != b',' && format[end] != b')') {
    end += 1;
  }
  if (end >= format.len() || end == start) {
    return (e, 0);
  }
  let (v, next) = c_number(format, start);
  if (v > FORMATTING_LIMIT || next == start || v == 0) {
    return (e, 0);
  }
  let w = v as i32;
  if (w < 0) {
    if (to_column) {
      w += width.term_columns();
    }
    if (w < 0) {
      return (e, 0);
    }
  }
  let set = Expansion { ...e, padding: if (to_column) { -w } else { w }, flush: flush };
  if (format[end] != b',') {
    return (Expansion { ...set, trunc: TRUNC_NONE }, end - at + 1);
  }
  let cut_at = end + 1;
  let close = cut_at;
  while (close < format.len() && format[close] != b')') {
    close += 1;
  }
  if (close >= format.len() || close == cut_at) {
    return (set, 0);
  }
  let cut = objects.part(format, cut_at, close + 1);
  let trunc = if (cut == "trunc)") { TRUNC_RIGHT } else if (cut == "ltrunc)") { TRUNC_LEFT } else if (cut == "mtrunc)") { TRUNC_MIDDLE } else { -1 };
  if (trunc < 0) {
    return (set, 0);
  }
  return (Expansion { ...set, trunc: trunc }, close - at + 1);
}

// The placeholder at `at`, which is after a `%` and its magic, added to the
// text, and the count of bytes that it takes, or 0: `format_commit_one` of
// git.
function expand_one(c: Commit, ctx: Context, e: Expansion, format: string, at: i32): (Expansion, i32) {
  if (at >= format.len()) {
    return (e, 0);
  }
  let letter = format[at];
  if (letter == b'C' && objects.part(format, at, format.len()).starts_with("C(auto)")) {
    let reset = if (ctx.color && e.out.len() > 0) { color.RESET } else { "" };
    return (Expansion { ...e, auto: ctx.color, out: e.out + reset }, 7);
  }
  if (letter == b'C') {
    let (t, n) = color_placeholder(format, at, ctx.color);
    return (Expansion { ...e, out: e.out + t, auto: if (n > 0) { false } else { e.auto } }, n);
  }
  if (letter == b'w') {
    return wrap_placeholder(e, format, at);
  }
  if (letter == b'<' || letter == b'>') {
    return padding_placeholder(e, format, at);
  }
  let (t, n) = placeholder(c, ctx, format, at, e.auto);
  return (Expansion { ...e, out: e.out + t }, n);
}

// The text `sb` without the spaces and the color sequences at its end
// that a text of `len` columns takes for `%>>(N)`, the padding after the
// spaces, and the color sequences to put before the text.
function steal(sb: string, len: i32, padding_in: i32): (string, i32, string) {
  let b = sb.bytes();
  let padding = padding_in;
  let moved = "";
  let ch = b.len() - 1;
  while (len > padding && ch > 0) {
    if (b[ch] == b' ') {
      ch -= 1;
      padding += 1;
      continue;
    }
    if (b[ch] != b'm') {
      break;
    }
    let p = ch - 1;
    while (p > 0 && ch - p < 10 && b[p] != 27) {
      p -= 1;
    }
    if (b[p] != 27 || ch + 1 - p != width.esc_len(b, p)) {
      break;
    }
    moved = objects.part(sb, p, ch + 1) + moved;
    ch = p - 1;
  }
  return (objects.part(sb, 0, ch + 1), padding, moved);
}

// The placeholder at `at` with the padding that the last `%<(N)` or
// `%>(N)` set, and the count of bytes that it takes: `format_and_pad_commit`
// of git. A color placeholder takes the placeholder after it into the
// padding.
function expand_padded(c: Commit, ctx: Context, e: Expansion, format: string, at: i32): (Expansion, i32) {
  let sb = e.out;
  let padding = e.padding;
  if (padding < 0) {
    let start = sb.last_index_of("\n").unwrap_or(0);
    let occupied = width.text_width(array.slice(sb.bytes(), start, sb.len())) + ctx.graph_width;
    padding = -padding - occupied;
  }
  let local = Expansion { ...e, out: "" };
  let total = 0;
  let p = at;
  while (true) {
    let modifier = p < format.len() && format[p] == b'C';
    let (l1, consumed) = expand_one(c, ctx, local, format, p);
    local = l1;
    total += consumed;
    if (!modifier) {
      break;
    }
    p += consumed;
    if (p >= format.len() || format[p] != b'%') {
      break;
    }
    p += 1;
    total += 1;
  }
  let text = local.out.bytes();
  let len = width.text_width(text);
  let flush = local.flush;
  if (flush == FLUSH_LEFT_AND_STEAL) {
    let (cut, more, moved) = steal(sb, len, padding);
    sb = cut;
    padding = more;
    text = moved.bytes().concat(text);
    flush = FLUSH_LEFT;
  }
  if (len > padding) {
    let over = len - (padding - 2);
    if (local.trunc == TRUNC_LEFT) {
      text = width.replaced(text, 0, over, "..");
    } else if (local.trunc == TRUNC_MIDDLE) {
      text = width.replaced(text, padding / 2 - 1, over, "..");
    } else if (local.trunc == TRUNC_RIGHT) {
      text = width.replaced(text, padding - 2, over, "..");
    }
    sb += unsafe { string_from_bytes_unchecked(text) };
  } else {
    let offset = if (flush == FLUSH_LEFT) { padding - len } else if (flush == FLUSH_BOTH) { (padding - len) / 2 } else { 0 };
    let chars = padding - len + text.len();
    sb += " ".repeat(offset) + unsafe { string_from_bytes_unchecked(text) } + " ".repeat(chars - offset - text.len());
  }
  return (Expansion { ...local, out: sb, flush: NO_FLUSH }, total);
}

// The placeholder at `at`, after a `%`, with its magic, and the count of
// bytes that it takes, or 0: `format_commit_item` of git. `%+X` puts a
// line end before a text that is not empty, `% X` a space, and `%-X`
// takes off the line ends before an empty text. The magic takes its byte
// even when no placeholder follows it.
function expand_item(c: Commit, ctx: Context, e: Expansion, format: string, at: i32): (Expansion, i32) {
  let magic = format[at];
  let has_magic = magic == b'+' || magic == b'-' || magic == b' ';
  let p = if (has_magic) { at + 1 } else { at };
  if (has_magic && p < format.len() && format[p] == b'w') {
    return (e, 0);
  }
  let orig = e.out.len();
  let (e1, consumed) = if (e.flush == NO_FLUSH) { expand_one(c, ctx, e, format, p) } else { expand_padded(c, ctx, e, format, p) };
  if (!has_magic) {
    return (e1, consumed);
  }
  let out = e1.out;
  if (orig == out.len() && magic == b'-') {
    let n = out.len();
    while (n > 0 && out[n - 1] == b'\n') {
      n -= 1;
    }
    out = objects.part(out, 0, n);
  } else if (orig != out.len() && magic != b'-') {
    let at_orig = orig.min(out.len());
    out = objects.part(out, 0, at_orig) + (if (magic == b'+') { "\n" } else { " " }) + objects.part(out, at_orig, out.len());
  }
  return (Expansion { ...e1, out: out }, consumed + 1);
}

// The text of the commit in the form `format`, with the placeholders of
// `git log --format`. An unknown placeholder stays as it is.
pub function formatted(c: Commit, ctx: Context, format: string): string {
  let e = Expansion { out: "", auto: false, padding: 0, flush: NO_FLUSH, trunc: TRUNC_NONE, wrap_start: 0, width: 0, indent1: 0, indent2: 0 };
  let i = 0;
  while (i < format.len()) {
    if (format[i] != b'%') {
      let start = i;
      while (i < format.len() && format[i] != b'%') {
        i += 1;
      }
      e = Expansion { ...e, out: e.out + objects.part(format, start, i) };
      continue;
    }
    if (i + 1 < format.len() && format[i + 1] == b'%') {
      e = Expansion { ...e, out: e.out + "%" };
      i += 2;
      continue;
    }
    let (e1, n) = if (i + 1 < format.len()) { expand_item(c, ctx, e, format, i + 1) } else { (e, 0) };
    e = e1;
    if (n == 0) {
      e = Expansion { ...e, out: e.out + "%" };
      i += 1;
    } else {
      i += 1 + n;
    }
  }
  return rewrap(e, 0, 0, 0).out;
}
