// The walk of the commits that `git log` shows (revision.c of git).
//
// The walk takes commits from a list in the order of their committer
// dates, the latest first. A commit that an excluded commit reaches is
// UNINTERESTING. With a pathspec, a commit whose tree is the same as the
// tree of a parent in the pathspec is TREESAME and the walk follows that
// parent only. A walk with UNINTERESTING commits or a sort by topology
// is "limited": it finds each commit before it shows the first one.
import "std/array";
import "core/cmp";
import "core/map";
import "../../coreutils/lib/bre";
import "./commitgraph";
import "./log";
import "./mailmap";
import "./objects";
import "./store";
import "./treediff";
import "./walk";

pub const SEEN: i32 = 1;

pub const UNINTERESTING: i32 = 2;

pub const TREESAME: i32 = 4;

pub const SHOWN: i32 = 8;

pub const ADDED: i32 = 16;

pub const BOTTOM: i32 = 32;

pub const LEFT: i32 = 64;

const PULL_MERGE: i32 = 128;

// The count of extra commits that a limited walk reads after each commit
// that it still has is UNINTERESTING: SLOP of git.
const SLOP: i32 = 5;

// A pattern of `--author`, `--committer` or `--grep`: a regular
// expression, or a fixed string with `-F`.
pub struct Pattern { re: bre.Bre, fixed: string, is_fixed: boolean, icase: boolean }

// `mailmap` gives the names and emails that `--author` and `--committer`
// match.
pub struct Grep { authors: Pattern[], committers: Pattern[], body: Pattern[], all_match: boolean, invert: boolean, mailmap: mailmap.Mailmap }

pub function no_grep(): Grep {
  return Grep { authors: [], committers: [], body: [], all_match: false, invert: false, mailmap: mailmap.empty() };
}

// The sorts of the topological order: the order of the graph, the
// committer date, and the author date.
pub const BY_GRAPH: i32 = 0;

pub const BY_DATE: i32 = 1;

pub const BY_AUTHOR: i32 = 2;

// The options of a walk. `max_age` and `min_age` are `--since` and
// `--until`, or -1. `items` is the pathspec, and `bloom` holds its keys
// in the Bloom filters of the commit graph. `rewrite` keeps the parents
// that link the shown commits, as `--graph` needs.
pub struct Opts { max_age: i64, min_age: i64, first_parent: boolean, topo: boolean, order: i32, items: string[], bloom: i64[][], rewrite: boolean, min_parents: i32, max_parents: i32, grep: Grep, full_history: boolean }

pub function options(): Opts {
  return Opts { max_age: -1, min_age: -1, first_parent: false, topo: false, order: BY_GRAPH, items: [], bloom: [], rewrite: false, min_parents: 0, max_parents: -1, grep: no_grep(), full_history: false };
}

// A commit of the list, with its committer date.
struct Item { hash: string, time: i64 }

// The state of a walk. `parents` holds the parents of the commits whose
// parents the simplification changed. The list of commits to walk is
// `list` from `head` on. A topological walk with the generation numbers
// of the commit graph has `topo` instead.
pub struct Walk { g: walk.Graph, flags: Map[string, i32], parents: Map[string, string[]], list: Item[], head: i32, pending: string[], opts: Opts, limited: boolean, failed: string, topo: Topo[] }

pub function walk_of(g: walk.Graph, o: Opts): Walk {
  return Walk { g: g, flags: Map { }, parents: Map { }, list: [], head: 0, pending: [], opts: o, limited: false, failed: "", topo: [] };
}

pub function flag(w: Walk, h: string): i32 {
  return w.flags.get_or(h, 0);
}

function set(w: Walk, h: string, f: i32): Walk {
  return Walk { ...w, flags: w.flags.insert(h, flag(w, h) | f) };
}

function node(w: Walk, h: string): (Walk, walk.Node) {
  let (g, n) = walk.node(w.g, h);
  return (Walk { ...w, g: g }, n);
}

// The parents of `h` after the simplification.
pub function parents(w: Walk, h: string): (Walk, string[]) {
  if let Some(ps) = w.parents.get(h) {
    return (w, ps);
  }
  let (now, n) = node(w, h);
  return (now, n.parents);
}

function relevant(w: Walk, h: string): boolean {
  return (flag(w, h) & (UNINTERESTING | BOTTOM)) != UNINTERESTING;
}

// The list from `head` on, with `c` after each commit of its date or later.
function by_date(list: Item[], head: i32, c: Item): Item[] {
  let lo = head;
  let hi = list.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    if (list[mid].time >= c.time) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  if (lo == list.len()) {
    return array.slice(list, head, lo).append(c);
  }
  return array.slice(list, head, lo).append(c).concat(array.slice(list, lo, list.len()));
}

function insert(w: Walk, h: string): Walk {
  if (w.topo.len() > 0) {
    return w;
  }
  let (now, n) = node(w, h);
  let c = Item { hash: h, time: n.time };
  if (now.head < now.list.len() / 2 && (now.list.len() == now.head || now.list[now.list.len() - 1].time >= c.time)) {
    return Walk { ...now, list: now.list.append(c) };
  }
  return Walk { ...now, list: by_date(now.list, now.head, c), head: 0 };
}

// The first commit of the list, and the walk without it.
function popped(w: Walk): (Walk, Item) {
  return (Walk { ...w, head: w.head + 1 }, w.list[w.head]);
}

// Adds a commit that the command line names, with `flags`: UNINTERESTING
// and BOTTOM for an excluded commit.
pub function add(w_in: Walk, h: string, flags: i32): Walk {
  let (w, _) = node(w_in, h);
  return Walk { ...set(w, h, flags), pending: w.pending.append(h) };
}

// Each ancestor of `h` that the walk has read is UNINTERESTING.
function mark_parents_uninteresting(w_in: Walk, h: string): Walk {
  let (w1, first) = parents(w_in, h);
  let w = w1;
  let stack: string[] = first;
  while (stack.len() > 0) {
    let p = stack[stack.len() - 1];
    stack = array.slice(stack, 0, stack.len() - 1);
    if ((flag(w, p) & UNINTERESTING) == 0) {
      w = set(w, p, UNINTERESTING);
      if (w.g.nodes.contains(p)) {
        let (w2, ps) = parents(w, p);
        w = w2;
        stack = stack.concat(ps);
      }
    }
  }
  return w;
}

// Puts the parents of `c` on the list: `process_parents` of git. A commit
// that the walk has not read has no parents to put: git reads a parent
// when it puts it on the list, and a walk of first parents does not read
// the other parents.
function process_parents(w_in: Walk, c: string): Walk {
  let w = w_in;
  if ((flag(w, c) & ADDED) != 0) {
    return w;
  }
  w = set(w, c, ADDED);
  if (!w.g.nodes.contains(c)) {
    return w;
  }
  if ((flag(w, c) & UNINTERESTING) != 0) {
    let (w1, ps) = parents(w, c);
    w = w1;
    for p in ps {
      w = set(w, p, UNINTERESTING);
      let (w2, pn) = node(w, p);
      w = w2;
      if (pn.ok) {
        w = mark_parents_uninteresting(w, p);
        if ((flag(w, p) & SEEN) == 0) {
          w = insert(set(w, p, SEEN), p);
        }
      }
    }
    return w;
  }
  w = simplify(w, c);
  let pass = flag(w, c) & LEFT;
  let (w3, ps) = parents(w, c);
  w = w3;
  for p in ps {
    let (w4, pn) = node(w, p);
    w = w4;
    if (!pn.ok) {
      return Walk { ...w, failed: c };
    }
    w = set(w, p, pass);
    if ((flag(w, p) & SEEN) == 0) {
      w = insert(set(w, p, SEEN), p);
    }
    if (w.opts.first_parent) {
      break;
    }
  }
  return w;
}

// True if the trees of `a` and `b` differ in the pathspec.
function differ(w: Walk, a: string, b: string): (Walk, boolean) {
  let (s, d) = treediff.differ(w.g.store, a, b, w.opts.items);
  return (Walk { ...w, g: walk.Graph { ...w.g, store: s } }, d);
}

// Marks `c` TREESAME when its tree is the tree of a parent in the
// pathspec, and keeps only that parent: `try_to_simplify_commit` of git.
function simplify(w_in: Walk, c: string): Walk {
  if (w_in.opts.items.len() == 0) {
    return w_in;
  }
  let (w1, n) = node(w_in, c);
  let w = w1;
  let (w2, ps) = parents(w, c);
  w = w2;
  if (ps.len() == 0) {
    let (w3, d) = differ(w, "", n.tree);
    return if (d) { w3 } else { set(w3, c, TREESAME) };
  }
  let relevant_parents = 0;
  let relevant_change = false;
  let irrelevant_change = false;
  for nth in 0..ps.len() {
    let p = ps[nth];
    if (relevant(w, p)) {
      relevant_parents += 1;
    }
    if (nth == 1 && w.opts.first_parent) {
      break;
    }
    let (w4, pn) = node(w, p);
    let (w5, d) = if (nth == 0 && w4.opts.bloom.len() > 0 && n.pos >= 0 && pn.ok && commitgraph.maybe_changed(w4.g.cg, n.pos, w4.opts.bloom) == 0) { (w4, false) } else { differ(w4, pn.tree, n.tree) };
    w = w5;
    if (!d) {
      if (w.opts.full_history || !relevant(w, p)) {
        continue;
      }
      w = Walk { ...w, parents: w.parents.insert(c, [p]) };
      return set(w, c, TREESAME);
    }
    if (relevant(w, p)) {
      relevant_change = true;
    } else {
      irrelevant_change = true;
    }
    if (nth == 0) {
      w = set(w, c, PULL_MERGE);
    }
  }
  if (if (relevant_parents > 0) { !relevant_change } else { !irrelevant_change }) {
    w = set(w, c, TREESAME);
  }
  return w;
}

// ---- grep ----

function pattern_matches(p: Pattern, line: u8[], from: i32, to: i32): boolean {
  if (p.is_fixed) {
    let n = p.fixed.len();
    if (n == 0) {
      return true;
    }
    let i = from;
    while (i + n <= to) {
      let same = true;
      let k = 0;
      while (same && k < n) {
        let a = line[i + k];
        let b = p.fixed[k];
        same = a == b || p.icase && lower(a) == lower(b);
        k += 1;
      }
      if (same) {
        return true;
      }
      i += 1;
    }
    return false;
  }
  return p.re.search_range_bytes(line, from, to);
}

function lower(b: u8): u8 {
  return if (b >= b'A' && b <= b'Z') { b + 32 } else { b };
}

// The text `NAME <EMAIL>` of a header line from `from` to `stop`, with the
// mailmap, and its bounds.
function person_text(g: Grep, body: u8[], from: i32, stop: i32): (u8[], i32, i32) {
  if (g.mailmap.is_empty() || g.authors.len() + g.committers.len() == 0) {
    return (body, from, stop);
  }
  let text = objects.part_bytes(body, from, stop);
  let p = log.person(text);
  if (p.email.len() == 0 && !text.contains("<")) {
    return (body, from, stop);
  }
  let (name, email) = mailmap.map_user(g.mailmap, p.name, p.email);
  let out = (name + " <" + email + ">").bytes();
  return (out, 0, out.len());
}

// True if the commit with the content `body` matches the patterns of
// `--author`, `--committer` and `--grep`, as `commit_match` of git tells.
function commit_match(g: Grep, body: u8[]): boolean {
  let author_hit = false;
  let committer_hit = false;
  let hits = __alloc_i32(g.body.len());
  let in_body = false;
  let at = 0;
  while (at < body.len()) {
    let end = at;
    while (end < body.len() && body[end] != b'\n') {
      end += 1;
    }
    if (!in_body && end == at) {
      in_body = true;
    } else if (!in_body) {
      let is_author = objects.starts_at(body, at, "author ") && end - at >= 7;
      let is_committer = objects.starts_at(body, at, "committer ") && end - at >= 10;
      if (is_author || is_committer) {
        let from = at + (if (is_author) { 7 } else { 10 });
        let stop = end;
        let k = end - 1;
        while (k > from) {
          if (body[k] == b'>') {
            stop = k + 1;
            break;
          }
          k -= 1;
        }
        let list = if (is_author) { g.authors } else { g.committers };
        let (line, lf, lt) = person_text(g, body, from, stop);
        for p in list {
          if (pattern_matches(p, line, lf, lt)) {
            if (is_author) {
              author_hit = true;
            } else {
              committer_hit = true;
            }
          }
        }
      }
    } else {
      for i in 0..g.body.len() {
        if (hits[i] == 0 && pattern_matches(g.body[i], body, at, end)) {
          hits = hits.with(i, 1);
        }
      }
    }
    at = end + 1;
  }
  if (g.authors.len() > 0 && !author_hit || g.committers.len() > 0 && !committer_hit) {
    return false;
  }
  if (g.body.len() == 0) {
    return true;
  }
  let any = false;
  let all = true;
  for h in hits {
    any = any || h == 1;
    all = all && h == 1;
  }
  if (g.invert) {
    return !any;
  }
  return if (g.all_match) { all } else { any };
}

// ---- The choice of each commit ----

// True if the walk shows `c` now: `get_commit_action` of git.
pub function interesting(w: Walk, c: string): (Walk, boolean) {
  return wanted(w, c);
}

// True if the walk shows `c`: `get_commit_action` of git.
function wanted(w_in: Walk, c: string): (Walk, boolean) {
  let w = w_in;
  let f = flag(w, c);
  if ((f & (SHOWN | UNINTERESTING)) != 0) {
    return (w, false);
  }
  let (w1, n) = node(w, c);
  w = w1;
  if (w.opts.min_age != -1 && n.time > w.opts.min_age) {
    return (w, false);
  }
  let (w2, ps) = parents(w, c);
  w = w2;
  if (ps.len() < w.opts.min_parents || w.opts.max_parents >= 0 && ps.len() > w.opts.max_parents) {
    return (w, false);
  }
  let g = w.opts.grep;
  if (g.authors.len() + g.committers.len() + g.body.len() > 0) {
    let got = store.read(w.g.store, c);
    w = Walk { ...w, g: walk.Graph { ...w.g, store: got.store } };
    let body: u8[] = match (got.object) {
      Ok(o) => o.body,
      Err(_) => [],
    };
    if (!commit_match(g, body)) {
      return (w, false);
    }
  }
  if (w.opts.items.len() > 0 && (f & TREESAME) != 0) {
    if (!w.opts.rewrite) {
      return (w, false);
    }
    let count = 0;
    for p in ps {
      if (relevant(w, p)) {
        count += 1;
      }
    }
    return (w, count >= 2);
  }
  return (w, true);
}

// The parent of the list `ps` to follow through a TREESAME commit, or "".
function one_relevant_parent(w: Walk, ps: string[]): string {
  if (ps.len() == 0) {
    return "";
  }
  if (w.opts.first_parent || ps.len() == 1) {
    return ps[0];
  }
  let found = "";
  for p in ps {
    if (relevant(w, p)) {
      if (found.len() > 0) {
        return "";
      }
      found = p;
    }
  }
  return found;
}

// The parents of the shown commit `c` with each TREESAME commit passed:
// `rewrite_parents` of git.
function rewrite(w_in: Walk, c: string): Walk {
  let (w1, ps) = parents(w_in, c);
  let w = w1;
  let kept: string[] = [];
  for first in ps {
    let p = first;
    let keep = true;
    let done = false;
    while (!done) {
      if (!w.limited) {
        w = process_parents(w, p);
      }
      let f = flag(w, p);
      if ((f & UNINTERESTING) != 0 || (f & TREESAME) == 0) {
        done = true;
      } else {
        let (w2, pps) = parents(w, p);
        w = w2;
        if (pps.len() == 0) {
          keep = false;
          done = true;
        } else {
          let q = one_relevant_parent(w, pps);
          if (q.len() == 0) {
            done = true;
          } else {
            p = q;
          }
        }
      }
    }
    if (keep && !kept.contains(p)) {
      kept = kept.append(p);
    }
  }
  return Walk { ...w, parents: w.parents.insert(c, kept) };
}

// ---- The walk ----

function still_interesting(w: Walk, date: i64, slop: i32): i32 {
  if (w.head >= w.list.len()) {
    return 0;
  }
  if (date <= w.list[w.head].time) {
    return SLOP;
  }
  for i in w.head..w.list.len() {
    if ((flag(w, w.list[i].hash) & UNINTERESTING) == 0) {
      return SLOP;
    }
  }
  return slop - 1;
}

// Finds each commit of a limited walk: `limit_list` of git.
function limit_list(w_in: Walk): Walk {
  let w = w_in;
  let date: i64 = 9223372036854775807;
  let slop = SLOP;
  let out: Item[] = [];
  while (w.head < w.list.len()) {
    let (w0, c) = popped(w);
    w = w0;
    if (w.opts.max_age != -1 && c.time < w.opts.max_age) {
      w = set(w, c.hash, UNINTERESTING);
    }
    w = process_parents(w, c.hash);
    if (w.failed.len() > 0) {
      return w;
    }
    if ((flag(w, c.hash) & UNINTERESTING) != 0) {
      w = mark_parents_uninteresting(w, c.hash);
      slop = still_interesting(w, date, slop);
      if (slop > 0) {
        continue;
      }
      break;
    }
    if (w.opts.min_age != -1 && c.time > w.opts.min_age) {
      continue;
    }
    date = c.time;
    out = out.append(c);
  }
  return Walk { ...w, list: out, head: 0 };
}

// A commit of the queue of the topological sort, with its date and the
// order of its put.
struct Queued { hash: string, time: i64, order: i32 }

function queue_put(q: Queued[], c: Queued, by_time: boolean): Queued[] {
  if (!by_time) {
    return q.append(c);
  }
  let lo = 0;
  let hi = q.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    if (q[mid].time > c.time || q[mid].time == c.time && q[mid].order < c.order) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return array.slice(q, 0, lo).append(c).concat(array.slice(q, lo, q.len()));
}

// The time that the topological sort compares: the committer date, or the
// author date for `--author-date-order`.
function sort_time(w: Walk, h: string): (Walk, i64) {
  if (w.opts.order != BY_AUTHOR) {
    let (now, n) = node(w, h);
    return (now, n.time);
  }
  let got = store.read(w.g.store, h);
  let now = Walk { ...w, g: walk.Graph { ...w.g, store: got.store } };
  return match (got.object) {
    Ok(o) => (now, log.commit_of(h, o.body).author.time),
    Err(_) => (now, 0),
  };
}

// The list in a topological order: each commit before its parents, as
// `sort_in_topological_order` of git sorts it.
function topo_sort(w_in: Walk): Walk {
  let w = w_in;
  let degree: Map[string, i32] = Map { };
  for c in w.list {
    degree = degree.insert(c.hash, 1);
  }
  for c in w.list {
    let (w1, ps) = parents(w, c.hash);
    w = w1;
    for p in ps {
      let d = degree.get_or(p, 0);
      if (d > 0) {
        degree = degree.insert(p, d + 1);
      }
    }
  }
  let by_time = w.opts.order != BY_GRAPH;
  let q: Queued[] = [];
  let counter = 0;
  for c in w.list {
    if (degree.get_or(c.hash, 0) == 1) {
      let (w2, t) = sort_time(w, c.hash);
      w = w2;
      q = queue_put(q, Queued { hash: c.hash, time: t, order: counter }, by_time);
      counter += 1;
    }
  }
  if (!by_time) {
    q = q.reverse();
  }
  let out: Item[] = [];
  while (q.len() > 0) {
    let c = if (by_time) { q[0] } else { q[q.len() - 1] };
    q = if (by_time) { array.slice(q, 1, q.len()) } else { array.slice(q, 0, q.len() - 1) };
    let (w3, ps) = parents(w, c.hash);
    w = w3;
    for p in ps {
      let d = degree.get_or(p, 0);
      if (d > 0) {
        degree = degree.insert(p, d - 1);
        if (d - 1 == 1) {
          let (w4, t) = sort_time(w, p);
          w = w4;
          q = queue_put(q, Queued { hash: p, time: t, order: counter }, by_time);
          counter += 1;
        }
      }
    }
    degree = degree.insert(c.hash, 0);
    let (w5, n) = node(w, c.hash);
    w = w5;
    out = out.append(Item { hash: c.hash, time: n.time });
  }
  return Walk { ...w, list: out, head: 0 };
}

// The walk ready for its first commit: the commits of the command line in
// the order of their dates, and the whole walk when it is limited.
pub function prepare(w_in: Walk): Walk {
  let w = w_in;
  // An excluded commit limits the walk, unless the walk is topological
  // and has generation numbers (`handle_commit` of git).
  let incremental = w.opts.topo && commitgraph.generation_numbers(w.g.cg);
  for h in w.pending {
    if ((flag(w, h) & UNINTERESTING) != 0) {
      w = Walk { ...mark_parents_uninteresting(w, h), limited: w.limited || !incremental };
    }
    if ((flag(w, h) & SEEN) == 0) {
      let (w1, n) = node(set(w, h, SEEN), h);
      w = Walk { ...w1, list: w1.list.append(Item { hash: h, time: n.time }) };
    }
  }
  let list = w.list;
  let places: i32[] = [];
  for i in 0..list.len() {
    places = places.append(i);
  }
  let order = cmp.sort_by(places, (a: i32, b: i32): i32 => if (list[a].time > list[b].time) { -1 } else if (list[a].time < list[b].time) { 1 } else { a - b });
  let sorted: Item[] = [];
  for i in order {
    sorted = sorted.append(list[i]);
  }
  w = Walk { ...w, list: sorted, head: 0 };
  if (incremental && !w.limited) {
    return init_topo(w);
  }
  if (w.opts.topo) {
    w = Walk { ...w, limited: true };
  }
  if (w.limited) {
    w = limit_list(w);
    if (w.opts.topo && w.failed.len() == 0) {
      w = topo_sort(w);
    }
  }
  return w;
}

// The next commit that the walk shows, or "": `get_revision_1` of git.
pub function next(w_in: Walk): (Walk, string) {
  let w = w_in;
  while (w.head < w.list.len() || w.topo.len() > 0) {
    let c = Item { hash: "", time: 0 };
    if (w.topo.len() > 0) {
      let (w1, h) = next_topo(w);
      w = w1;
      if (h.len() == 0) {
        return (w, "");
      }
      let (w2, n) = node(w, h);
      w = w2;
      c = Item { hash: h, time: n.time };
    } else {
      let (w0, item) = popped(w);
      w = w0;
      c = item;
    }
    if (!w.limited) {
      if (w.opts.max_age != -1 && c.time < w.opts.max_age) {
        continue;
      }
      w = if (w.topo.len() > 0) { expand_topo(w, c.hash) } else { process_parents(w, c.hash) };
      if (w.failed.len() > 0) {
        return (w, "");
      }
    }
    let (w1, show) = wanted(w, c.hash);
    w = w1;
    if (show) {
      if (w.opts.items.len() > 0 && w.opts.rewrite) {
        w = rewrite(w, c.hash);
      }
      return (set(w, c.hash, SHOWN), c.hash);
    }
  }
  return (w, "");
}

// ---- The topological walk with generation numbers (revision.c) ----

// A queue of commits: by generation and then by date (GEN_DATE), by date
// (DATE), or the last put first (STACK). Two equal commits come out in
// the order of their puts.
const GEN_DATE: i32 = 0;

const DATE: i32 = 1;

const STACK: i32 = 2;

struct Heap { kind: i32, hashes: string[], gens: i64[], dates: i64[], ctrs: i32[], ctr: i32 }

function heap_new(kind: i32): Heap {
  return Heap { kind: kind, hashes: [], gens: [], dates: [], ctrs: [], ctr: 0 };
}

// True when the entry `i` comes out before the entry `j`.
function before(q: Heap, i: i32, j: i32): boolean {
  if (q.kind == GEN_DATE && q.gens[i] != q.gens[j]) {
    return q.gens[i] > q.gens[j];
  }
  if (q.dates[i] != q.dates[j]) {
    return q.dates[i] > q.dates[j];
  }
  return q.ctrs[i] < q.ctrs[j];
}

function swap(q: Heap, i: i32, j: i32): Heap {
  let h = q.hashes[i];
  let g = q.gens[i];
  let d = q.dates[i];
  let c = q.ctrs[i];
  q = Heap { ...q, hashes: q.hashes.with(i, q.hashes[j]), gens: q.gens.with(i, q.gens[j]), dates: q.dates.with(i, q.dates[j]), ctrs: q.ctrs.with(i, q.ctrs[j]) };
  return Heap { ...q, hashes: q.hashes.with(j, h), gens: q.gens.with(j, g), dates: q.dates.with(j, d), ctrs: q.ctrs.with(j, c) };
}

function heap_put(q: Heap, h: string, generation: i64, date: i64): Heap {
  q = Heap { ...q, hashes: q.hashes.append(h), gens: q.gens.append(generation), dates: q.dates.append(date), ctrs: q.ctrs.append(q.ctr), ctr: q.ctr + 1 };
  if (q.kind == STACK) {
    return q;
  }
  let i = q.hashes.len() - 1;
  while (i > 0) {
    let parent = (i - 1) / 2;
    if (!before(q, i, parent)) {
      break;
    }
    q = swap(q, i, parent);
    i = parent;
  }
  return q;
}

// The first commit of the queue, or "".
function heap_peek(q: Heap): string {
  if (q.hashes.len() == 0) {
    return "";
  }
  return if (q.kind == STACK) { q.hashes[q.hashes.len() - 1] } else { q.hashes[0] };
}

function heap_drop_last(q: Heap): Heap {
  let n = q.hashes.len() - 1;
  return Heap { ...q, hashes: array.slice(q.hashes, 0, n), gens: array.slice(q.gens, 0, n), dates: array.slice(q.dates, 0, n), ctrs: array.slice(q.ctrs, 0, n) };
}

function heap_get(q: Heap): (Heap, string) {
  let n = q.hashes.len();
  if (n == 0) {
    return (q, "");
  }
  if (q.kind == STACK) {
    let h = q.hashes[n - 1];
    return (heap_drop_last(q), h);
  }
  let h = q.hashes[0];
  q = heap_drop_last(swap(q, 0, n - 1));
  let i = 0;
  let m = n - 1;
  while (true) {
    let l = 2 * i + 1;
    if (l >= m) {
      break;
    }
    let best = l;
    if (l + 1 < m && before(q, l + 1, l)) {
      best = l + 1;
    }
    if (!before(q, best, i)) {
      break;
    }
    q = swap(q, i, best);
    i = best;
  }
  return (q, h);
}

// The state of the walk: the queues of the exploration, of the counts of
// children and of the output, the count of the children of each commit
// that the walk has yet to show plus one, and the least generation that
// the counts are known for.
struct Topo { explore: Heap, indegree: Heap, out: Heap, degree: Map[string, i32], explored: Map[string, boolean], counted: Map[string, boolean], min_generation: i64 }

const TOPO_EXPLORED: i32 = 1;

const TOPO_INDEGREE: i32 = 2;

function topo_of(w: Walk): Topo {
  return w.topo[0];
}

function with_topo(w: Walk, t: Topo): Walk {
  return Walk { ...w, topo: [t] };
}

function put_queue(w_in: Walk, which: i32, h: string): Walk {
  let (w, n) = node(w_in, h);
  let t = topo_of(w);
  if (which == TOPO_EXPLORED) {
    if (t.explored.contains(h)) {
      return w;
    }
    return with_topo(w, Topo { ...t, explore: heap_put(t.explore, h, n.generation, n.time), explored: t.explored.insert(h, true) });
  }
  if (t.counted.contains(h)) {
    return w;
  }
  return with_topo(w, Topo { ...t, indegree: heap_put(t.indegree, h, n.generation, n.time), counted: t.counted.insert(h, true) });
}

// One step of the exploration: `explore_walk_step`.
function explore_step(w_in: Walk): Walk {
  let t = topo_of(w_in);
  let (q, c) = heap_get(t.explore);
  let w = with_topo(w_in, Topo { ...t, explore: q });
  if (c.len() == 0) {
    return w;
  }
  let (w1, n) = node(w, c);
  w = w1;
  if (!n.ok) {
    return w;
  }
  if (w.opts.max_age != -1 && n.time < w.opts.max_age) {
    w = set(w, c, UNINTERESTING);
  }
  w = process_parents(w, c);
  if ((flag(w, c) & UNINTERESTING) != 0) {
    w = mark_parents_uninteresting(w, c);
  }
  let (w2, ps) = parents(w, c);
  w = w2;
  for p in ps {
    w = put_queue(w, TOPO_EXPLORED, p);
  }
  return w;
}

function explore_to_depth(w_in: Walk, cutoff: i64): Walk {
  let w = w_in;
  while (true) {
    let h = heap_peek(topo_of(w).explore);
    if (h.len() == 0) {
      return w;
    }
    let (w1, n) = node(w, h);
    w = w1;
    if (n.generation < cutoff) {
      return w;
    }
    w = explore_step(w);
  }
  return w;
}

// One step of the counts of the children: `indegree_walk_step`.
function indegree_step(w_in: Walk): Walk {
  let t = topo_of(w_in);
  let (q, c) = heap_get(t.indegree);
  let w = with_topo(w_in, Topo { ...t, indegree: q });
  if (c.len() == 0) {
    return w;
  }
  let (w1, n) = node(w, c);
  w = w1;
  if (!n.ok) {
    return w;
  }
  w = explore_to_depth(w, n.generation);
  let (w2, ps) = parents(w, c);
  w = w2;
  for p in ps {
    let (w3, pn) = node(w, p);
    w = w3;
    if (!pn.ok) {
      return w;
    }
    let t1 = topo_of(w);
    let d = t1.degree.get_or(p, 0);
    w = with_topo(w, Topo { ...t1, degree: t1.degree.insert(p, if (d != 0) { d + 1 } else { 2 }) });
    w = put_queue(w, TOPO_INDEGREE, p);
    if (w.opts.first_parent) {
      return w;
    }
  }
  return w;
}

function indegrees_to_depth(w_in: Walk, cutoff: i64): Walk {
  let w = w_in;
  while (true) {
    let h = heap_peek(topo_of(w).indegree);
    if (h.len() == 0) {
      return w;
    }
    let (w1, n) = node(w, h);
    w = w1;
    if (n.generation < cutoff) {
      return w;
    }
    w = indegree_step(w);
  }
  return w;
}

// Puts `h` in the output queue.
function put_out(w_in: Walk, h: string): Walk {
  let (w, date) = sort_time(w_in, h);
  let t = topo_of(w);
  return with_topo(w, Topo { ...t, out: heap_put(t.out, h, 0, date) });
}

// The walk ready for its first commit, with the commits of the command
// line in `list`: `init_topo_walk`.
function init_topo(w_in: Walk): Walk {
  let kind = if (w_in.opts.order == BY_GRAPH) { STACK } else { DATE };
  let t = Topo { explore: heap_new(GEN_DATE), indegree: heap_new(GEN_DATE), out: heap_new(kind), degree: Map { }, explored: Map { }, counted: Map { }, min_generation: commitgraph.INFINITY };
  let w = Walk { ...w_in, topo: [t] };
  let starts = w.list;
  w = Walk { ...w, list: [], head: 0 };
  let min_gen = commitgraph.INFINITY;
  for c in starts {
    let (w1, n) = node(w, c.hash);
    w = w1;
    if (n.ok) {
      w = put_queue(put_queue(w, TOPO_EXPLORED, c.hash), TOPO_INDEGREE, c.hash);
      if (n.generation < min_gen) {
        min_gen = n.generation;
      }
      let t1 = topo_of(w);
      w = with_topo(w, Topo { ...t1, degree: t1.degree.insert(c.hash, 1) });
    }
  }
  w = with_topo(w, Topo { ...topo_of(w), min_generation: min_gen });
  w = indegrees_to_depth(w, min_gen);
  for c in starts {
    if (topo_of(w).degree.get_or(c.hash, 0) == 1) {
      w = put_out(w, c.hash);
    }
  }
  if (kind == STACK) {
    let t3 = topo_of(w);
    let out = t3.out;
    w = with_topo(w, Topo { ...t3, out: Heap { ...out, hashes: out.hashes.reverse(), gens: out.gens.reverse(), dates: out.dates.reverse(), ctrs: out.ctrs.reverse() } });
  }
  return w;
}

// The next commit of the topological walk, or "": `next_topo_commit`.
function next_topo(w: Walk): (Walk, string) {
  let t = topo_of(w);
  let (q, h) = heap_get(t.out);
  if (h.len() == 0) {
    return (Walk { ...w, topo: [] }, "");
  }
  return (with_topo(w, Topo { ...t, out: q, degree: t.degree.insert(h, 0) }), h);
}

// Puts each parent of the shown commit `c` in the output when `c` was its
// last child to show: `expand_topo_walk`.
function expand_topo(w_in: Walk, c: string): Walk {
  let w = process_parents(w_in, c);
  if (w.failed.len() > 0) {
    return w;
  }
  let (w1, ps) = parents(w, c);
  w = w1;
  for p in ps {
    if ((flag(w, p) & UNINTERESTING) == 0) {
      let (w2, pn) = node(w, p);
      w = w2;
      if (pn.ok) {
        if (pn.generation < topo_of(w).min_generation) {
          w = with_topo(w, Topo { ...topo_of(w), min_generation: pn.generation });
          w = indegrees_to_depth(w, pn.generation);
        }
        let t = topo_of(w);
        let d = t.degree.get_or(p, 0) - 1;
        w = with_topo(w, Topo { ...t, degree: t.degree.insert(p, d) });
        if (d == 1) {
          w = put_out(w, p);
        }
      }
    }
    if (w.opts.first_parent) {
      return w;
    }
  }
  return w;
}
