// Packfiles and their index.
//
// A packfile is `PACK`, a version, a count, and the objects. Each object has
// a kind and a size in a variable-length number, and then a zlib stream. An
// object of the kind OFS_DELTA or REF_DELTA is a delta against a base object:
// the stream holds copy and insert instructions.
//
// The index (version 2) has a fan-out table of 256 counts, the sorted names,
// a CRC for each object, and the offset of each object in the packfile.
import "std/array";
import "std/deflate";
import "std/hex";
import "core/map";
import "./objects";

pub const OFS_DELTA: i32 = 6;

pub const REF_DELTA: i32 = 7;

// The longest chain of deltas that the port follows.
const MAX_CHAIN: i32 = 4096;

function be32(b: u8[], at: i32): i64 {
  return b[at] as i64 << 24 | b[at + 1] as i64 << 16 | b[at + 2] as i64 << 8 | b[at + 3] as i64;
}

// True if the bytes are an index of version 2 with a complete table.
pub function index_ok(idx: u8[]): boolean {
  if (idx.len() < 1032 + 40 || idx[0] != 255 || idx[1] != b't' || idx[2] != b'O' || idx[3] != b'c' || be32(idx, 4) != 2) {
    return false;
  }
  let n = count(idx);
  return n >= 0 && idx.len() as i64 >= 1032 + n as i64 * 28 + 40;
}

// The number of objects in the index.
pub function count(idx: u8[]): i32 {
  return be32(idx, 8 + 255 * 4) as i32;
}

// The name of the object `i` of the index, as 20 bytes.
function name_at(idx: u8[], i: i32): u8[] {
  return array.slice(idx, 1032 + i * 20, 1052 + i * 20);
}

pub function hex_name_at(idx: u8[], i: i32): string {
  return hex.encode(name_at(idx, i));
}

// The offset in the packfile of the object `i`, or -1 when the offset does
// not fit in 31 bits.
pub function offset_at(idx: u8[], i: i32): i32 {
  let n = count(idx);
  let v = be32(idx, 1032 + n * 24 + i * 4);
  if (v >= 2147483648) {
    return -1;
  }
  return v as i32;
}

function compare(idx: u8[], i: i32, name: u8[]): i32 {
  let at = 1032 + i * 20;
  for k in 0..20 {
    if (idx[at + k] != name[k]) {
      return if (idx[at + k] < name[k]) { -1 } else { 1 };
    }
  }
  return 0;
}

// The first and the end of the objects whose name starts with `byte`.
function bucket(idx: u8[], byte: i32): (i32, i32) {
  let lo = if (byte == 0) { 0 } else { be32(idx, 8 + (byte - 1) * 4) as i32 };
  return (lo, be32(idx, 8 + byte * 4) as i32);
}

// The place in the index of the object with the 20 bytes `name`, or -1.
pub function find(idx: u8[], name: u8[]): i32 {
  let (first, end) = bucket(idx, name[0] as i32);
  let lo = first;
  let hi = end;
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    let c = compare(idx, mid, name);
    if (c == 0) {
      return mid;
    }
    if (c < 0) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return -1;
}

// The value of the hexadecimal digit `c`, or 0.
function digit(c: u8): i32 {
  if (c >= b'a') {
    return (c - b'a') as i32 + 10;
  }
  if (c >= b'A') {
    return (c - b'A') as i32 + 10;
  }
  return (c - b'0') as i32;
}

// The order of the name `i` of the index against the digits `short`: 0 if
// the name starts with them.
function compare_digits(idx: u8[], i: i32, short: string): i32 {
  let at = 1032 + i * 20;
  for k in 0..short.len() {
    let byte = idx[at + k / 2] as i32;
    let have = if (k % 2 == 0) { byte >> 4 } else { byte & 15 };
    let want = digit(short[k]);
    if (have != want) {
      return if (have < want) { -1 } else { 1 };
    }
  }
  return 0;
}

// The names in the index that start with the hexadecimal digits `short`, of
// two digits or more: `limit` names at most.
pub function with_prefix(idx: u8[], short: string, limit: i32): string[] {
  let found: string[] = [];
  if (short.len() < 2 || short.len() > 40) {
    return found;
  }
  let (first, end) = bucket(idx, digit(short[0]) * 16 + digit(short[1]));
  let lo = first;
  let hi = end;
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    if (compare_digits(idx, mid, short) < 0) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  while (lo < end && found.len() < limit && compare_digits(idx, lo, short) == 0) {
    found = found.append(hex_name_at(idx, lo));
    lo += 1;
  }
  return found;
}

// ---- Objects of a packfile ----

// One object as the packfile holds it: its kind, the size of its data, and
// where the zlib stream starts. `base_offset` is the offset of the base of
// an OFS_DELTA, and `base_name` is the name of the base of a REF_DELTA.
pub struct Entry { kind: i32, size: i32, data_at: i32, base_offset: i32, base_name: u8[], ok: boolean }

function no_entry(): Entry {
  return Entry { kind: 0, size: 0, data_at: 0, base_offset: -1, base_name: [], ok: false };
}

// A part of a packfile: `bytes` starts at the offset `shift` of the file.
pub struct Window { bytes: u8[], shift: i32 }

// The header of the object at `offset`.
pub function entry_at(data: u8[], offset: i32): Entry {
  return entry_in(Window { bytes: data, shift: 0 }, offset);
}

// The header of the object at the offset `offset` of the file. `data_at`
// and `base_offset` are offsets of the file also.
pub function entry_in(w: Window, offset: i32): Entry {
  let data = w.bytes;
  if (offset < 12 || offset < w.shift || offset - w.shift >= data.len()) {
    return no_entry();
  }
  let at = offset - w.shift;
  let c = data[at] as i32;
  at += 1;
  let kind = c >> 4 & 7;
  let size = (c & 15) as i64;
  let shift: i64 = 4;
  while ((c & 128) != 0) {
    if (at >= data.len() || shift > 60) {
      return no_entry();
    }
    c = data[at] as i32;
    at += 1;
    size |= (c & 127) as i64 << shift;
    shift += 7;
  }
  if (size > 1073741824) {
    return no_entry();
  }
  let e = Entry { kind: kind, size: size as i32, data_at: at + w.shift, base_offset: -1, base_name: [], ok: true };
  if (kind == REF_DELTA) {
    if (at + 20 > data.len()) {
      return no_entry();
    }
    return Entry { ...e, data_at: at + 20 + w.shift, base_name: array.slice(data, at, at + 20) };
  }
  if (kind != OFS_DELTA) {
    return e;
  }
  if (at >= data.len()) {
    return no_entry();
  }
  c = data[at] as i32;
  at += 1;
  let back = (c & 127) as i64;
  while ((c & 128) != 0) {
    if (at >= data.len() || back > 2147483647) {
      return no_entry();
    }
    c = data[at] as i32;
    at += 1;
    back = back + 1 << 7 | (c & 127) as i64;
  }
  if (back <= 0 || back >= offset as i64) {
    return no_entry();
  }
  return Entry { ...e, data_at: at + w.shift, base_offset: offset - back as i32 };
}

// The data of the entry: the inflated bytes of its zlib stream. The second
// number is the place after the stream.
function inflated(data: u8[], e: Entry): Result[(u8[], i32), string] {
  return inflated_in(Window { bytes: data, shift: 0 }, e);
}

function inflated_in(w: Window, e: Entry): Result[(u8[], i32), string] {
  if (e.data_at - w.shift + 2 > w.bytes.len()) {
    return Err("a packed object has no data");
  }
  return match (deflate.inflate_from(w.bytes, e.data_at - w.shift + 2, e.size)) {
    Ok(got) => {
      if (got.out.len() != e.size) {
        return Err("a packed object has a wrong size");
      }
      Ok((got.out, e.data_at + 2 + got.consumed + 4))
    },
    Err(why) => Err("a packed object is corrupt: " + why.message()),
  };
}

// The place after the object at `offset`: after its zlib stream.
pub function end_of(data: u8[], offset: i32): i32 {
  let e = entry_at(data, offset);
  if (!e.ok) {
    return -1;
  }
  return match (inflated(data, e)) {
    Ok(got) => {
      let (_, end) = got;
      end
    },
    Err(_) => -1,
  };
}

pub function kind_name(kind: i32): string {
  return match (kind) {
    1 => "commit",
    2 => "tree",
    3 => "blob",
    4 => "tag",
    _ => "",
  };
}

// A number of a delta: seven bits for each byte, the low bits first.
function delta_number(delta: u8[], from: i32): (i64, i32) {
  let n: i64 = 0;
  let shift: i64 = 0;
  let at = from;
  while (at < delta.len() && shift < 63) {
    let c = delta[at] as i64;
    at += 1;
    n |= (c & 127) << shift;
    shift += 7;
    if ((c & 128) == 0) {
      return (n, at);
    }
  }
  return (-1, at);
}

// The object that the delta makes from `base`. A copy instruction takes a
// part of the base, and an insert instruction takes bytes of the delta.
pub function apply_delta(base: u8[], delta: u8[]): Result[u8[], string] {
  let (base_size, a) = delta_number(delta, 0);
  let (size, b) = delta_number(delta, a);
  if (base_size != base.len() as i64 || size < 0 || size > 1073741824) {
    return Err("a delta does not fit its base");
  }
  let out: u8[] = [];
  let at = b;
  while (at < delta.len()) {
    let cmd = delta[at] as i32;
    at += 1;
    if (cmd == 0) {
      return Err("a delta has a reserved instruction");
    }
    if ((cmd & 128) == 0) {
      if (at + cmd > delta.len() || out.len() as i64 + cmd as i64 > size) {
        return Err("a delta inserts past its end");
      }
      for k in at..at + cmd {
        out = out.append(delta[k]);
      }
      at += cmd;
      continue;
    }
    let from: i64 = 0;
    let count: i64 = 0;
    for bit in 0..4 {
      if ((cmd & 1 << bit) != 0) {
        if (at >= delta.len()) {
          return Err("a delta copy has no offset");
        }
        from |= delta[at] as i64 << (bit * 8) as i64;
        at += 1;
      }
    }
    for bit in 0..3 {
      if ((cmd & 16 << bit) != 0) {
        if (at >= delta.len()) {
          return Err("a delta copy has no size");
        }
        count |= delta[at] as i64 << (bit * 8) as i64;
        at += 1;
      }
    }
    if (count == 0) {
      count = 65536;
    }
    if (from + count > base.len() as i64 || out.len() as i64 + count > size) {
      return Err("a delta copies past its base");
    }
    let first = from as i32;
    for k in first..first + count as i32 {
      out = out.append(base[k]);
    }
  }
  if (out.len() as i64 != size) {
    return Err("a delta makes a wrong size");
  }
  return Ok(out);
}

// The offset of the object `name` in the packfile of the index, or -1.
pub function offset_of(idx: u8[], name: u8[]): i32 {
  let i = find(idx, name);
  return if (i < 0) { -1 } else { offset_at(idx, i) };
}

// The offsets of the chain of the object at `offset`: the object, then its
// base, to the object that is not a delta. `base` gives the offset of the
// base of a REF_DELTA from its name, or -1.
pub function chain_of(data: u8[], base: (u8[]) => i32, offset: i32): Result[i32[], string] {
  return chain_in((at: i32): Window => Window { bytes: data, shift: 0 }, base, offset);
}

// The chain, as `chain_of` gives it. `part` gives a part of the packfile
// that holds the whole object at an offset.
pub function chain_in(part: (i32) => Window, base: (u8[]) => i32, offset: i32): Result[i32[], string] {
  let chain: i32[] = [offset];
  let at = offset;
  while (chain.len() <= MAX_CHAIN) {
    let e = entry_in(part(at), at);
    if (!e.ok) {
      return Err("a packed object has a bad header");
    }
    if (e.kind == OFS_DELTA) {
      at = e.base_offset;
    } else if (e.kind == REF_DELTA) {
      at = base(e.base_name);
      if (at < 0) {
        return Err("the base " + hex.encode(e.base_name) + " of a delta is not in the packfile");
      }
    } else {
      return Ok(chain);
    }
    chain = chain.append(at);
  }
  return Err("a chain of deltas is too long");
}

// The objects that were the base of a delta, by offset. A chain of deltas
// starts from the nearest base that the cache holds.
pub struct Cache { at: Map[i32, objects.Object], bytes: i64 }

// The most bytes of bases that a cache holds before it starts again.
const CACHE_BYTES: i64 = 100663296;

pub function cache_new(): Cache {
  return Cache { at: Map { }, bytes: 0 };
}

function cached(c: Cache, offset: i32, o: objects.Object): Cache {
  if (c.at.contains(offset)) {
    return c;
  }
  if (c.bytes + o.body.len() as i64 > CACHE_BYTES) {
    let empty: Map[i32, objects.Object] = Map { };
    return Cache { at: empty.insert(offset, o), bytes: o.body.len() as i64 };
  }
  return Cache { at: c.at.insert(offset, o), bytes: c.bytes + o.body.len() as i64 };
}

// The object at `offset`, as `object_at` gives it, and the cache with the
// bases of its chain. `part` gives a part of the packfile that holds the
// whole object at an offset.
pub function object_cached(part: (i32) => Window, base: (u8[]) => i32, offset: i32, c: Cache): (Result[objects.Object, string], Cache) {
  let chain = match (chain_in(part, base, offset)) {
    Ok(offsets) => offsets,
    Err(why) => {
      return (Err(why), c);
    },
  };
  // The nearest object of the chain that the cache holds, or the last one.
  let from = chain.len() - 1;
  let start: Option[objects.Object] = None;
  let found = false;
  for i in 0..chain.len() {
    if (!found) {
      if let Some(o) = c.at.get(chain[i]) {
        start = Some(o);
        from = i;
        found = true;
      }
    }
  }
  let now = match (start) {
    Some(o) => o,
    None => {
      let w = part(chain[from]);
      let first = entry_in(w, chain[from]);
      let name = kind_name(first.kind);
      if (name.len() == 0) {
        return (Err("a packed object has an unknown kind"), c);
      }
      match (inflated_in(w, first)) {
        Ok((body, _)) => objects.Object { kind: name, body: body },
        Err(why) => {
          return (Err(why), c);
        },
      }
    },
  };
  let cache = c;
  let i = from - 1;
  while (i >= 0) {
    cache = cached(cache, chain[i + 1], now);
    let w = part(chain[i]);
    let delta = match (inflated_in(w, entry_in(w, chain[i]))) {
      Ok((bytes, _)) => bytes,
      Err(why) => {
        return (Err(why), cache);
      },
    };
    let body = match (apply_delta(now.body, delta)) {
      Ok(bytes) => bytes,
      Err(why) => {
        return (Err(why), cache);
      },
    };
    now = objects.Object { kind: now.kind, body: body };
    i -= 1;
  }
  return (Ok(now), cache);
}

// The object at `offset` of the packfile `data`, with each delta applied.
pub function object_at(data: u8[], base: (u8[]) => i32, offset: i32): Result[objects.Object, string] {
  let chain = chain_of(data, base, offset)?;
  let last = chain.len() - 1;
  let first = entry_at(data, chain[last]);
  let name = kind_name(first.kind);
  if (name.len() == 0) {
    return Err("a packed object has an unknown kind");
  }
  let (body, _) = inflated(data, first)?;
  let i = last - 1;
  while (i >= 0) {
    let (delta, _) = inflated(data, entry_at(data, chain[i]))?;
    body = apply_delta(body, delta)?;
    i -= 1;
  }
  return Ok(objects.Object { kind: name, body: body });
}
