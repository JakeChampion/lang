function in_table(table: i32[], c: i32): boolean {
  let n = table.len() / 2;
  if (n == 0 || c < table[0] || c > table[2 * n - 1]) {
    return false;
  }
  let lo = 0;
  let hi = n - 1;
  while (lo <= hi) {
    let mid = (lo + hi) / 2;
    if (c > table[2 * mid + 1]) {
      lo = mid + 1;
    } else if (c < table[2 * mid]) {
      hi = mid - 1;
    } else {
      return true;
    }
  }
  return false;
}

// The width of the code point `c`.
pub function wcwidth(c: i32): i32 {
  if (c == 0) {
    return 0;
  }
  if (c < 32 || c >= 127 && c < 160) {
    return -1;
  }
  if (in_table(ZERO_WIDTH, c)) {
    return 0;
  }
  if (in_table(DOUBLE_WIDTH, c)) {
    return 2;
  }
  return 1;
}

// The code point of the UTF-8 character at `at` of `b` before `end`, and
// its length in bytes, or a length of 0 for bytes that are not sound
// UTF-8: `pick_one_utf8_char` of git.
pub function char_at(b: u8[], at: i32, end: i32): (i32, i32) {
  let left = end - at;
  if (left < 1) {
    return (0, 0);
  }
  let s0 = b[at] as i32;
  if (s0 < 128) {
    return (s0, 1);
  }
  if ((s0 & 224) == 192) {
    if (left < 2 || (b[at + 1] as i32 & 192) != 128 || (s0 & 254) == 192) {
      return (0, 0);
    }
    return ((s0 & 31) << 6 | b[at + 1] as i32 & 63, 2);
  }
  if ((s0 & 240) == 224) {
    if (left < 3) {
      return (0, 0);
    }
    let s1 = b[at + 1] as i32;
    let s2 = b[at + 2] as i32;
    if ((s1 & 192) != 128 || (s2 & 192) != 128 || s0 == 224 && (s1 & 224) == 128 || s0 == 237 && (s1 & 224) == 160 || s0 == 239 && s1 == 191 && (s2 & 254) == 190) {
      return (0, 0);
    }
    return ((s0 & 15) << 12 | (s1 & 63) << 6 | s2 & 63, 3);
  }
  if ((s0 & 248) == 240) {
    if (left < 4) {
      return (0, 0);
    }
    let s1 = b[at + 1] as i32;
    let s2 = b[at + 2] as i32;
    let s3 = b[at + 3] as i32;
    if ((s1 & 192) != 128 || (s2 & 192) != 128 || (s3 & 192) != 128 || s0 == 240 && (s1 & 240) == 128 || s0 == 244 && s1 > 143 || s0 > 244) {
      return (0, 0);
    }
    return ((s0 & 7) << 18 | (s1 & 63) << 12 | (s2 & 63) << 6 | s3 & 63, 4);
  }
  return (0, 0);
}

// The width of the bytes of `b` from `from` to `to`, or -1 when they are
// not sound UTF-8 or hold a control character.
pub function width_of(b: u8[], from: i32, to: i32): i32 {
  let width = 0;
  let at = from;
  while (at < to) {
    let (c, n) = char_at(b, at, to);
    if (n == 0) {
      return -1;
    }
    let w = wcwidth(c);
    if (w < 0) {
      return -1;
    }
    width += w;
    at += n;
  }
  return width;
}

// ---- The columns of a text (utf8.c of git) ----

// The bytes of the builder `out`, which is then free: a builder has no
// drop of its own.
function taken(out: usize): u8[] {
  let b = buf_take_bytes(out);
  buf_free(out);
  return b;
}

// The width of the terminal: `COLUMNS`, or 80 (`term_columns` of git
// without a terminal).
pub function term_columns(): i32 {
  if let Some(text) = env("COLUMNS") {
    let n = 0;
    let i = 0;
    while (i < text.len() && text[i] >= b'0' && text[i] <= b'9') {
      n = n * 10 + (text[i] - b'0') as i32;
      i += 1;
    }
    if (i > 0 && n > 0) {
      return n;
    }
  }
  return 80;
}

// The length of the color sequence `ESC [ ... m` at `at`, or 0:
// `display_mode_esc_sequence_len` of git.
pub function esc_len(b: u8[], at: i32): i32 {
  if (at + 1 >= b.len() || b[at] != 27 || b[at + 1] != b'[') {
    return 0;
  }
  let p = at + 2;
  while (p < b.len() && (b[p] >= b'0' && b[p] <= b'9' || b[p] == b';')) {
    p += 1;
  }
  if (p >= b.len() || b[p] != b'm') {
    return 0;
  }
  return p + 1 - at;
}

// The columns of `b` without its color sequences, or the count of its
// bytes when they are not sound UTF-8: `utf8_strnwidth` of git.
pub function text_width(b: u8[]): i32 {
  let w = 0;
  let at = 0;
  while (at < b.len()) {
    let skip = esc_len(b, at);
    while (skip > 0) {
      at += skip;
      skip = esc_len(b, at);
    }
    if (at >= b.len()) {
      break;
    }
    let (c, n) = char_at(b, at, b.len());
    if (n == 0) {
      return b.len();
    }
    let g = wcwidth(c);
    if (g > 0) {
      w += g;
    }
    at += n;
  }
  return w;
}

// The text `b` with `subst` in place of the characters that start in the
// columns from `pos` to `pos + width`, with the color sequences kept, or
// `b` when it is not sound UTF-8: `strbuf_utf8_replace` of git.
pub function replaced(b: u8[], pos: i32, width: i32, subst: string): u8[] {
  let out = buf_new(b.len() + subst.len());
  let pending = true;
  let w = 0;
  let at = 0;
  while (at < b.len()) {
    let skip = esc_len(b, at);
    while (skip > 0) {
      buf_push_bytes_range(out, b, at, at + skip);
      at += skip;
      skip = esc_len(b, at);
    }
    if (at >= b.len()) {
      break;
    }
    let (c, n) = char_at(b, at, b.len());
    if (n == 0) {
      buf_free(out);
      return b;
    }
    let g = wcwidth(c).max(0);
    if (g > 0 && w >= pos && w < pos + width) {
      if (pending) {
        buf_push(out, subst);
        pending = false;
      }
    } else {
      buf_push_bytes_range(out, b, at, at + n);
    }
    w += g;
    at += n;
  }
  return taken(out);
}

function is_alnum(b: u8): boolean {
  return b >= b'0' && b <= b'9' || b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z';
}

function is_space(b: u8): boolean {
  return b == b' ' || b == b'\t' || b == b'\n' || b == b'\r';
}

// Each line of `b` after `indent1` spaces for the first line and `indent2`
// for the others: `strbuf_add_indented_text` of git.
function indented(out: usize, b: u8[], indent1: i32, indent2: i32): void {
  let indent = indent1.max(0);
  let at = 0;
  while (at < b.len()) {
    let nl = __memchr_bytes(b, 10, at);
    let eol = if (nl < 0) { b.len() } else { nl + 1 };
    buf_push(out, " ".repeat(indent));
    buf_push_bytes_range(out, b, at, eol);
    at = eol;
    indent = indent2;
  }
}

// The byte at `i` of `b`, or 0 after its end, as a C string reads it.
function byte_at(b: u8[], i: i32): u8 {
  return if (i < b.len()) { b[i] } else { 0 as u8 };
}

// The state of `wrapped` in the text: the next byte, the start of the
// line, the last space or -1, the indent and the columns of the line.
struct Wrap { text: i32, bol: i32, space: i32, indent: i32, w: i32 }

// The state after a line end: the next line starts after the last space.
function wrap_line(out: usize, b: u8[], s: Wrap, indent2: i32): Wrap {
  buf_push(out, "\n");
  let next = s.space + (if (is_space(byte_at(b, s.space))) { 1 } else { 0 });
  return Wrap { text: next, bol: next, space: -1, indent: indent2, w: indent2 };
}

// The text `b` in lines of `width` columns or fewer, the first line after
// `indent1` spaces and the others after `indent2`: `strbuf_add_wrapped_text`
// of git. A width of 0 or less only indents the lines. A text that is not
// sound UTF-8 takes one column for each byte. The text stops at a NUL, as
// the C string of git does.
pub function wrapped(b_in: u8[], indent1: i32, indent2: i32, width: i32): u8[] {
  let nul = __memchr_bytes(b_in, 0, 0);
  let b = if (nul < 0) { b_in } else { array.slice(b_in, 0, nul) };
  let out = buf_new(b.len() + 64);
  if (width <= 0) {
    indented(out, b, indent1, indent2);
    return taken(out);
  }
  if (wrap_into(out, b, indent1, indent2, width, true)) {
    return taken(out);
  }
  buf_free(out);
  let again = buf_new(b.len() + 64);
  let _ = wrap_into(again, b, indent1, indent2, width, false);
  return taken(again);
}

// The loop of `wrapped`. It gives false when it finds bytes that are not
// sound UTF-8 with `utf8`, and the caller then starts again without it.
function wrap_into(out: usize, b: u8[], indent1: i32, indent2: i32, width: i32, utf8: boolean): boolean {
  let s = Wrap { text: 0, bol: 0, space: -1, indent: indent1, w: indent1 };
  if (indent1 < 0) {
    s = Wrap { ...s, w: -indent1, space: 0 };
  }
  while (true) {
    let skip = esc_len(b, s.text);
    while (skip > 0) {
      s = Wrap { ...s, text: s.text + skip };
      skip = esc_len(b, s.text);
    }
    let c = byte_at(b, s.text);
    if (c != 0 && !is_space(c)) {
      if (!utf8) {
        s = Wrap { ...s, w: s.w + 1, text: s.text + 1 };
        continue;
      }
      let (ch, n) = char_at(b, s.text, b.len());
      if (n == 0) {
        return false;
      }
      s = Wrap { ...s, w: s.w + wcwidth(ch), text: s.text + n };
      continue;
    }
    if (s.w > width && s.space >= 0) {
      s = wrap_line(out, b, s, indent2);
      continue;
    }
    let start = s.bol;
    if (c == 0 && s.text == start) {
      return true;
    }
    if (s.space >= 0) {
      start = s.space;
    } else {
      buf_push(out, " ".repeat(s.indent.max(0)));
    }
    buf_push_bytes_range(out, b, start, s.text);
    if (c == 0) {
      return true;
    }
    s = Wrap { ...s, space: s.text };
    if (c == b'\t') {
      s = Wrap { ...s, w: s.w | 7 };
    } else if (c == b'\n') {
      s = Wrap { ...s, space: s.space + 1 };
      let after = byte_at(b, s.space);
      if (after == b'\n') {
        buf_push(out, "\n");
        s = wrap_line(out, b, s, indent2);
        continue;
      }
      if (!is_alnum(after)) {
        s = wrap_line(out, b, s, indent2);
        continue;
      }
      buf_push(out, " ");
    }
    s = Wrap { ...s, w: s.w + 1, text: s.text + 1 };
  }
  return true;
}
