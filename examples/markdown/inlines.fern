// The inline phase of CommonMark 0.31.2: the text of a paragraph or a
// heading as HTML.
//
// This slice has text, backslash escapes, hard line breaks and soft line
// breaks. Code spans, emphasis, links, images, autolinks, raw HTML and
// entity references are text. The renderer calls `render` for each paragraph
// and heading, with the line segments of the block and the reference
// definitions of the document, so a full inline parser replaces this file
// and changes nothing else.
import "./blocks";
import "./refs";

// The lookup tables of the renderer. `esc` has an eight-byte record for each
// byte below `?`: its length, then the bytes that HTML text holds for it.
// `stop` marks the bytes that the text scan stops at.
pub struct Tables { esc: u8[], stop: u8[] }

function put(t: u8[], c: i32, s: string): u8[] {
  let r = t.with(c * 8, s.len() as u8);
  for i in 0..s.len() {
    r = r.with(c * 8 + 1 + i, s[i]);
  }
  return r;
}

pub function tables(): Tables {
  let esc = __alloc_u8(63 * 8);
  for c in 0..63 {
    esc = esc.with(c * 8, 1 as u8).with(c * 8 + 1, c as u8);
  }
  esc = put(put(put(put(esc, 34, "&quot;"), 38, "&amp;"), 60, "&lt;"), 62, "&gt;");
  let stop = __alloc_u8(93).with(34, 1 as u8).with(38, 1 as u8).with(60, 1 as u8).with(62, 1 as u8).with(92, 1 as u8);
  return Tables { esc: esc, stop: stop };
}

// Writes `s[a:b]` with `"`, `&`, `<` and `>` escaped.
pub function escape(out: usize, s: string, a: i32, b: i32, t: Tables): void {
  if (b > a) {
    buf_push_expanded(out, slice_unchecked(s, a, b), t.esc);
  }
}

// The text with each backslash escape replaced by the character it escapes.
pub function unescape(s: string): string {
  if (__memchr(s, 92, 0) < 0) {
    return s;
  }
  let b = buf_new(s.len());
  let i = 0;
  while (i < s.len()) {
    let c = s[i] as i32;
    if (c == 92 && i + 1 < s.len() && refs.is_punct(s[i + 1] as i32)) {
      i += 1;
      c = s[i] as i32;
    }
    buf_push_byte(b, c);
    i += 1;
  }
  let out = buf_take(b);
  buf_free(b);
  return out;
}

function is_space_or_tab(c: u8): boolean {
  return c == b' ' || c == b'\t';
}

function rtrim(s: string, a: i32, b: i32): i32 {
  let e = b;
  while (e > a && refs.is_space(s[e - 1] as i32)) {
    e -= 1;
  }
  return e;
}

// True when `s[a:b]` ends with a backslash that no backslash escapes.
function ends_with_backslash(s: string, a: i32, b: i32): boolean {
  let k = b;
  while (k > a && s[k - 1] == b'\\') {
    k -= 1;
  }
  return (b - k) % 2 == 1;
}

// Writes the text `s[a:b]` with its backslash escapes. Gives `last` when it
// writes nothing, and otherwise a byte that is not a line feed: the text of
// this slice holds no line feed.
function text(out: usize, s: string, a: i32, b: i32, t: Tables, last: i32): i32 {
  if (b <= a) {
    return last;
  }
  let view = slice_unchecked(s, 0, b);
  let i = a;
  while (i < b) {
    let j = __scan_set(view, i, t.stop);
    if (j > i) {
      buf_push_range(out, s, i, j);
    }
    if (j >= b) {
      break;
    }
    i = j + 1;
    if (s[j] == b'\\' && i < b && refs.is_punct(s[i] as i32)) {
      escape(out, s, i, i + 1, t);
      i += 1;
    } else if (s[j] == b'\\') {
      buf_push_byte(out, 92);
    } else {
      escape(out, s, j, i, t);
    }
  }
  return s[b - 1] as i32;
}

// Writes the inline content of the lines `from` to `to` of `d` as HTML.
// Gives the last byte that it wrote, or -1 when it wrote nothing. A soft
// break and a hard break of two spaces drop the spaces and tabs at the start
// of the next line. A hard break of a backslash keeps them, as in cmark.
pub function render(out: usize, d: blocks.Doc, from: i32, to: i32, t: Tables): i32 {
  let s = d.src;
  let last = -1;
  let keep = true;
  for k in from..to {
    let a = d.segs[k * 3 + 1];
    let b = d.segs[k * 3 + 2];
    if (keep) {
      for _ in 0..d.segs[k * 3] {
        buf_push_byte(out, 32);
        last = 32;
      }
    } else {
      while (a < b && is_space_or_tab(s[a])) {
        a += 1;
      }
    }
    if (k == to - 1) {
      return text(out, s, a, rtrim(s, a, b), t, last);
    }
    keep = line_and_break(out, s, a, b, t);
    last = 10;
  }
  return last;
}

// Writes a line that is not the last line, and the break after it. Gives
// true for a hard break of a backslash.
function line_and_break(out: usize, s: string, a: i32, b: i32, t: Tables): boolean {
  if (ends_with_backslash(s, a, b)) {
    text(out, s, a, b - 1, t, -1);
    buf_push(out, "<br />\n");
    return true;
  }
  text(out, s, a, rtrim(s, a, b), t, -1);
  if (b - a >= 2 && s[b - 1] == b' ' && s[b - 2] == b' ') {
    buf_push(out, "<br />\n");
  } else {
    buf_push_byte(out, 10);
  }
  return false;
}
