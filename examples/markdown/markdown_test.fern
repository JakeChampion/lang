// The CommonMark renderer. Each expected text is the output of cmark 0.30.2
// with --unsafe, except where a comment gives a change of spec 0.31.2. Some
// cases check the shape of the block tree.
import "core/map";
import "std/test";
import "./blocks";
import "./inlines";
import "./markdown";
import "./refs";
import "./tags";

function checks(cases: (string, string)[]): test.TestOutcome {
  for c in cases {
    let (md, want) = c;
    let got = markdown.to_html(md);
    if (got != want) {
      return test.fail("\"" + md + "\": got \"" + got + "\", want \"" + want + "\"");
    }
  }
  return test.pass();
}

const NAMES: string[] = ["doc", "quote", "list", "li", "code", "html", "p", "h", "hr"];

// The blocks from the record `r0` to the end of their container, such as
// `quote(p2),list(li(p1))`: the kind of each block, and the number of lines
// of a leaf. Gives the record after them too.
function shape(d: blocks.Doc, r0: i32): (string, i32) {
  let out = "";
  let r = r0;
  while (r < d.count() && d.kind(r) != blocks.END) {
    if (out.len() > 0) {
      out += ",";
    }
    let k = d.kind(r);
    out += NAMES[k];
    if (k == blocks.QUOTE || k == blocks.LIST || k == blocks.ITEM) {
      let (inner, end) = shape(d, r + 1);
      out += "(" + inner + ")";
      r = end + 1;
    } else {
      if (k != blocks.RULE) {
        out += (d.get(r, blocks.STO) - d.get(r, blocks.SFROM)).to_string();
      }
      r += 1;
    }
  }
  return (out, r);
}

function shapes(cases: (string, string)[]): test.TestOutcome {
  for c in cases {
    let (md, want) = c;
    let (got, _) = shape(blocks.parse(md), 0);
    if (got != want) {
      return test.fail("\"" + md + "\": got " + got + ", want " + want);
    }
  }
  return test.pass();
}

function test_paragraphs(): test.TestOutcome {
  return checks([
    ("", ""),
    ("\n\n", ""),
    ("aaa\n\nbbb\n", "<p>aaa</p>\n<p>bbb</p>\n"),
    ("aaa\n   bbb\n", "<p>aaa\nbbb</p>\n"),
    ("  aaa\n bbb", "<p>aaa\nbbb</p>\n"),
    ("aaa     \nbbb     \n", "<p>aaa<br />\nbbb</p>\n"),
    ("a\\\nb", "<p>a<br />\nb</p>\n"),
    ("a\\\\\nb", "<p>a\\\nb</p>\n"),
    ("a\t \nb\\", "<p>a\nb\\</p>\n"),
    ("\\*a\\* \\q & a < b > \"c\"", "<p>*a* \\q &amp; a &lt; b &gt; &quot;c&quot;</p>\n"),
  ]);
}

function test_headings(): test.TestOutcome {
  return checks([
    ("# foo\n## foo\n###### foo", "<h1>foo</h1>\n<h2>foo</h2>\n<h6>foo</h6>\n"),
    ("####### foo\n#5 bolt", "<p>####### foo\n#5 bolt</p>\n"),
    ("# foo ##   \n### b ###\n# #\n#\n### ###\n# foo#\n# foo \\#", "<h1>foo</h1>\n<h3>b</h3>\n<h1></h1>\n<h1></h1>\n<h3></h3>\n<h1>foo#</h1>\n<h1>foo #</h1>\n"),
    ("    # foo\nbar\n    # baz", "<pre><code># foo\n</code></pre>\n<p>bar\n# baz</p>\n"),
    ("Foo\n===\n\nBar\n  ---  \n", "<h1>Foo</h1>\n<h2>Bar</h2>\n"),
    ("Foo\nbar\n===", "<h1>Foo\nbar</h1>\n"),
    ("Foo\n= =", "<p>Foo\n= =</p>\n"),
    ("> foo\n---", "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n"),
    ("- foo\n---", "<ul>\n<li>foo</li>\n</ul>\n<hr />\n"),
    ("Foo\n    ===", "<p>Foo\n===</p>\n"),
  ]);
}

function test_rules(): test.TestOutcome {
  return checks([
    ("***\n---\n___", "<hr />\n<hr />\n<hr />\n"),
    (" - - -\n**  * ** * ** * **\n-     -      -      -", "<hr />\n<hr />\n<hr />\n"),
    ("--\n**\n+++\n===", "<h1>--\n**\n+++</h1>\n"),
    ("--\n**\n__", "<p>--\n**\n__</p>\n"),
    ("_____________________________________\n    ***", "<hr />\n<pre><code>***\n</code></pre>\n"),
    ("Foo\n***\nbar", "<p>Foo</p>\n<hr />\n<p>bar</p>\n"),
    ("* Foo\n* * *\n* Bar", "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n<ul>\n<li>Bar</li>\n</ul>\n"),
    ("- Foo\n- * * *", "<ul>\n<li>Foo</li>\n<li>\n<hr />\n</li>\n</ul>\n"),
  ]);
}

function test_code(): test.TestOutcome {
  return checks([
    ("    a simple\n      indented code block", "<pre><code>a simple\n  indented code block\n</code></pre>\n"),
    ("    chunk1\n\n    chunk2\n  \n \n \n    chunk3\n", "<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>\n"),
    ("    foo  \n      \n    \n", "<pre><code>foo  \n</code></pre>\n"),
    ("    <a/>\n    *hi*", "<pre><code>&lt;a/&gt;\n*hi*\n</code></pre>\n"),
    ("```\n<\n >\n```", "<pre><code>&lt;\n &gt;\n</code></pre>\n"),
    ("````\naaa\n```\n``````", "<pre><code>aaa\n```\n</code></pre>\n"),
    ("```\n\n  \n```\n```", "<pre><code>\n  \n</code></pre>\n<pre><code></code></pre>\n"),
    ("> ```\n> aaa\n\nbbb", "<blockquote>\n<pre><code>aaa\n</code></pre>\n</blockquote>\n<p>bbb</p>\n"),
    ("   ```\n   aaa\n    aaa\n  aaa\n   ```", "<pre><code>aaa\n aaa\naaa\n</code></pre>\n"),
    ("```ruby startline=3 $%@#$\ndef foo(x)\n```", "<pre><code class=\"language-ruby\">def foo(x)\n</code></pre>\n"),
    ("~~~ a\\*b \"c\" `\nx\n~~~", "<pre><code class=\"language-a*b\">x\n</code></pre>\n"),
    ("```\naaa\n  ```  \n~~~", "<pre><code>aaa\n</code></pre>\n<pre><code></code></pre>\n"),
  ]);
}

function test_quotes(): test.TestOutcome {
  return checks([
    ("> # Foo\n> bar\n> baz", "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n"),
    ("> bar\nbaz\n> foo", "<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n"),
    (">", "<blockquote>\n</blockquote>\n"),
    ("> foo\n\n> bar", "<blockquote>\n<p>foo</p>\n</blockquote>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"),
    ("> > > foo\nbar", "<blockquote>\n<blockquote>\n<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n</blockquote>\n</blockquote>\n"),
    (">     code\n\n>    not code", "<blockquote>\n<pre><code>code\n</code></pre>\n</blockquote>\n<blockquote>\n<p>not code</p>\n</blockquote>\n"),
    ("> - a\n- b", "<blockquote>\n<ul>\n<li>a</li>\n</ul>\n</blockquote>\n<ul>\n<li>b</li>\n</ul>\n"),
  ]);
}

function test_lists(): test.TestOutcome {
  return checks([
    ("- foo\n- bar\n+ baz", "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n"),
    ("1. foo\n2. bar\n3) baz", "<ol>\n<li>foo</li>\n<li>bar</li>\n</ol>\n<ol start=\"3\">\n<li>baz</li>\n</ol>\n"),
    ("- a\n- b\n\n- c", "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>c</p>\n</li>\n</ul>\n"),
    ("- a\n  - b\n\n    c\n- d", "<ul>\n<li>a\n<ul>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ul>\n</li>\n<li>d</li>\n</ul>\n"),
    ("-\n  foo\n-\n  ```\n  bar\n  ```", "<ul>\n<li>foo</li>\n<li>\n<pre><code>bar\n</code></pre>\n</li>\n</ul>\n"),
    ("-\n\n  foo", "<ul>\n<li></li>\n</ul>\n<p>foo</p>\n"),
    ("123456789. ok\n\n1234567890. not ok\n\n0. ok\n\n-1. not ok", "<ol start=\"123456789\">\n<li>ok</li>\n</ol>\n<p>1234567890. not ok</p>\n<ol start=\"0\">\n<li>ok</li>\n</ol>\n<p>-1. not ok</p>\n"),
    ("123456789. ok\n1234567890. lazy\n0. same list", "<ol start=\"123456789\">\n<li>ok\n1234567890. lazy</li>\n<li>same list</li>\n</ol>\n"),
    ("The number of windows in my house is\n14.  The number of doors is 6.", "<p>The number of windows in my house is\n14.  The number of doors is 6.</p>\n"),
    ("-    one\n\n     two", "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n"),
    ("- one\n\n two", "<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n"),
    ("1.     indented code\n\n   paragraph", "<ol>\n<li>\n<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n</li>\n</ol>\n"),
    ("- a\n - b\n  - c\n   - d\n    - e", "<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n<li>d\n- e</li>\n</ul>\n"),
    ("* a\n*\n\n* c", "<ul>\n<li>\n<p>a</p>\n</li>\n<li></li>\n<li>\n<p>c</p>\n</li>\n</ul>\n"),
    ("- a\n- ```\n  b\n\n\n  ```\n- c", "<ul>\n<li>a</li>\n<li>\n<pre><code>b\n\n\n</code></pre>\n</li>\n<li>c</li>\n</ul>\n"),
    ("- foo\n\n\n  bar", "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n"),
  ]);
}

function test_tabs(): test.TestOutcome {
  return checks([
    ("\tfoo\tbaz\t\tbim", "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"),
    ("  - foo\n\n\tbar", "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n"),
    ("- foo\n\n\t\tbar", "<ul>\n<li>\n<p>foo</p>\n<pre><code>  bar\n</code></pre>\n</li>\n</ul>\n"),
    (">\t\tfoo", "<blockquote>\n<pre><code>  foo\n</code></pre>\n</blockquote>\n"),
    ("-\t\tfoo", "<ul>\n<li>\n<pre><code>  foo\n</code></pre>\n</li>\n</ul>\n"),
    ("#\tFoo", "<h1>Foo</h1>\n"),
    ("*\t*\t*\t", "<hr />\n"),
  ]);
}

function test_html_blocks(): test.TestOutcome {
  return checks([
    ("<div>\n*foo*\n\nbar", "<div>\n*foo*\n<p>bar</p>\n"),
    ("<div>\n\n  \n</div>", "<div>\n</div>\n"),
    (" <div>\n  *hello*\n         <foo><a>", " <div>\n  *hello*\n         <foo><a>\n"),
    ("<DIV CLASS=\"foo\">\n\nx", "<DIV CLASS=\"foo\">\n<p>x</p>\n"),
    ("<a href=\"foo\">\n*bar*\n</a>", "<a href=\"foo\">\n*bar*\n</a>\n"),
    ("<Warning>\n*bar*\n</Warning>", "<Warning>\n*bar*\n</Warning>\n"),
    ("<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\n</code></pre>\nokay", "<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\n</code></pre>\n<p>okay</p>\n"),
    ("<style\n  type=\"text/css\">\n\nfoo", "<style\n  type=\"text/css\">\n\nfoo\n"),
    ("<!-- foo -->*bar*\nbaz", "<!-- foo -->*bar*\n<p>baz</p>\n"),
    ("<!-->\nx\n\n<!--\n\n-->", "<!-->\n<p>x</p>\n<!--\n\n-->\n"),
    ("<?php\n\n  echo '>';\n\n?>\nokay", "<?php\n\n  echo '>';\n\n?>\n<p>okay</p>\n"),
    ("<!DOCTYPE html>", "<!DOCTYPE html>\n"),
    ("<![CDATA[\nfunction matchwo(a,b)\n\n]]>\nokay", "<![CDATA[\nfunction matchwo(a,b)\n\n]]>\n<p>okay</p>\n"),
    ("> <div>\n> foo\n\nbar", "<blockquote>\n<div>\nfoo\n</blockquote>\n<p>bar</p>\n"),
    ("- <div>\n- foo", "<ul>\n<li>\n<div>\n</li>\n<li>foo</li>\n</ul>\n"),
    ("<a b c='d' e=f g=\"h\" i:j.k-l_m/>\n</x-y >", "<a b c='d' e=f g=\"h\" i:j.k-l_m/>\n</x-y >\n"),
    ("<pre/>\n<a b=>", "<pre/>\n<a b=>\n"),
  ]);
}

// The blocks of text that holds raw HTML, emphasis, links and definitions.
function test_block_shapes(): test.TestOutcome {
  return shapes([
    ("<table><tr><td>\n<pre>\n**Hello**,\n\n_world_.\n</pre>\n</td></tr></table>\n", "html3,p2,html1"),
    ("Foo\n<a href=\"bar\">\nbaz", "p3"),
    ("Foo\n<div>\nbaz", "p1,html2"),
    ("- a\n</pre>", "list(li(p2))"),
    ("- a\n<x>\n\n<x>", "list(li(p2)),html1"),
    // Spec 0.31.2: `<!` and any letter starts kind 4, `search` is a name of
    // kind 6, and `source` is not.
    ("<!doctype\nhtml>", "html2"),
    ("a\n<search>\nb", "p1,html2"),
    ("a\n<source>\nb", "p3"),
    ("[foo]: /url\n\n[foo]", "p1"),
    ("# [Foo]\n[foo]: /url\n> bar", "h1,quote(p1)"),
    ("- [a]: /u\n\n  b\n- c", "list(li(p1),li(p1))"),
    ("> a\n- b\n\n  c\n> d", "quote(p1),list(li(p1,p1)),quote(p1)"),
  ]);
}

// cmark keeps the spaces at the start of a lazy line after a backslash hard
// break, and does not start an HTML block of kind 7 on a lazy line.
function test_cmark_details(): test.TestOutcome {
  return checks([
    ("> a\\\n  \tb", "<blockquote>\n<p>a<br />\n  \tb</p>\n</blockquote>\n"),
    ("a\x00b", "<p>a�b</p>\n"),
    ("a\r\nb\rc\r\n\r\n    d\r\n", "<p>a\nb\nc</p>\n<pre><code>d\n</code></pre>\n"),
    ("[foo]: /url\n===", "<p>===</p>\n"),
    ("[foo]: /url\nbar\n===", "<h1>bar</h1>\n"),
    ("- [a]: /u\n\n  b\n- c", "<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n"),
  ]);
}

// A byte order mark at the start of the source is not text.
function test_bom(): test.TestOutcome {
  let bom = (0xFEFF as char).to_string();
  return test.assert_eq(markdown.to_html(bom + "# a\n" + bom), "<h1>a</h1>\n<p>" + bom + "</p>\n");
}

function ref_is(d: blocks.Doc, label: string, dest: string, title: string): string {
  match (d.refs.get(label)) {
    Some(r) => {
      if (r.dest != dest || r.title != title) {
        return label + ": got (" + r.dest + ", " + r.title + ")";
      }
      return "";
    },
    None => {
      return label + ": no definition";
    }
  }
}

function test_definitions(): test.TestOutcome {
  let d = blocks.parse("[Foo  Bar]: /url 'the title'\n[ẞ]: <a b>\n[foo bar]: /other\n[t]:\n/u\n\"multi\nline\"\n> [q]: (x) (paren)\n[e]: <>\n[n]: /u \"no\" x\n[x]:\n");
  let errors = [
    ref_is(d, "foo bar", "/url", "'the title'"), ref_is(d, "ss", "a b", ""), ref_is(d, "t", "/u", "\"multi\nline\""), ref_is(d, "q", "(x)", "(paren)"), ref_is(d, "e", "", ""),
  ];
  for e in errors {
    if (e.len() > 0) {
      return test.fail(e);
    }
  }
  if (d.refs.contains("n") || d.refs.contains("x") || d.refs.len() != 5) {
    return test.fail("a line that is not a definition is a definition");
  }
  return checks([
    ("[foo]: /url \"title\"\n\nx", "<p>x</p>\n"),
    ("[foo]: /url \"title\" ok", "<p>[foo]: /url &quot;title&quot; ok</p>\n"),
    ("[foo]: /url\n\"title\" ok", "<p>&quot;title&quot; ok</p>\n"),
    ("[foo]:\n\n[foo]", "<p>[foo]:</p>\n<p>[foo]</p>\n"),
    ("    [foo]: /url", "<pre><code>[foo]: /url\n</code></pre>\n"),
    ("Foo\n[bar]: /baz", "<p>Foo\n[bar]: /baz</p>\n"),
    ("# Foo\n[foo]: /url\n> bar", "<h1>Foo</h1>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"),
    ("[foo]: /foo-url \"foo\"\n[bar]: /bar-url\n  \"bar\"\n[baz]: /baz-url\n\nx", "<p>x</p>\n"),
  ]);
}

function test_normalize(): test.TestOutcome {
  let cases = [("Foo  Bar", "foo bar"), ("  a\t\nb ", "a b"), ("ẞ", "ss"), ("ΑΓΩ", "αγω"), ("x", "x")];
  for c in cases {
    let (label, want) = c;
    if (refs.normalize(label) != want) {
      return test.fail(label + ": got \"" + refs.normalize(label) + "\", want \"" + want + "\"");
    }
  }
  let long = "[" + "x".repeat(1000) + "]";
  if (refs.label_end("[a\\]b]", 0, 6) != 6 || refs.label_end("[a[b]", 0, 5) != -1 || refs.label_end("[a]", 0, 2) != -1 || refs.label_end(long, 0, long.len()) != 1002 || refs.label_end("[x" + long, 0, long.len() + 2) != -1) {
    return test.fail("label_end");
  }
  return test.pass();
}

// A title is the longest match: a quote after a backslash ends it when no
// later quote can.
function test_titles(): test.TestOutcome {
  let cases = [("\"a\"", 3), ("\"a\\\" b", 4), ("\"a\\\" b\"", 7), ("'a\\'", 4), ("(a\\)b)", 6), ("(a(b)", -1), ("(a\\)(b)", 4), ("\"a", -1), ("x", -1)];
  for c in cases {
    let (s, want) = c;
    if (refs.title_end(s, 0, s.len()) != want) {
      return test.fail(s + ": got " + refs.title_end(s, 0, s.len()).to_string());
    }
  }
  if (refs.title_end("\"a\"", 0, 2) != -1 || refs.dest_end("a\x01b c", 0, 5) != 3 || refs.dest_end("(a)b)", 0, 5) != 4) {
    return test.fail("an end of the text, or a destination");
  }
  return test.pass();
}

function test_tags(): test.TestOutcome {
  let opens = [("<a>", 3), ("<a/>", 4), ("<a b='c'>", 9), ("<a b=\"c\" d>", 11), ("<a b=c >", 8), ("<a b=>", -1), ("<1>", -1), ("<a-b_c>", -1), ("<a \"b\">", -1)];
  for c in opens {
    let (s, want) = c;
    if (tags.open_tag_end(s, 0, s.len()) != want) {
      return test.fail(s + ": got " + tags.open_tag_end(s, 0, s.len()).to_string());
    }
  }
  if (tags.closing_tag_end("</a >", 0, 5) != 5 || tags.closing_tag_end("</a b>", 0, 6) != -1) {
    return test.fail("closing_tag_end");
  }
  let starts = [("<script>", 1), ("<TEXTAREA", 1), ("<!-- x", 2), ("<?x", 3), ("<!x", 4), ("<![CDATA[", 5), ("</div>", 6), ("<td/>", 6), ("<x>", 7), ("<x> y", 0), ("<pre/>", 7)];
  for c in starts {
    let (s, want) = c;
    if (tags.block_start(s, 0, s.len(), false) != want) {
      return test.fail(s + ": kind " + tags.block_start(s, 0, s.len(), false).to_string());
    }
  }
  if (tags.block_start("<x>", 0, 3, true) != 0 || !tags.block_end(1, "a </STYLE> b", 0, 12) || tags.block_end(2, "-- >", 0, 4)) {
    return test.fail("a kind 7 start in a paragraph, or an end condition");
  }
  return test.pass();
}

function test_unescape(): test.TestOutcome {
  return test.assert_eq(inlines.unescape("a\\*b\\c\\\\d\\"), "a*b\\c\\d\\");
}

// backslash escapes and entity references
function test_escapes(): test.TestOutcome {
  return checks([
    ("\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~", "<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n"),
    ("\\\t\\A\\a\\ \\3\\φ\\«", "<p>\\\t\\A\\a\\ \\3\\φ\\«</p>\n"),
    ("\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`", "<p>*not emphasized*\n&lt;br/&gt; not a tag\n[not a link](/foo)\n`not code`</p>\n"),
    ("&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;", "<p>\u{00A0} &amp; © Æ Ď\n¾ ℋ ⅆ\n∲ ≧̸</p>\n"),
    ("&#35; &#1234; &#992; &#0; &#x22; &#XD06; &#xcab; &#xD800; &#1114112;", "<p># Ӓ Ϡ � &quot; ആ ಫ � �</p>\n"),
    ("&nbsp &x; &#; &#x;\n&#87654321;\n&#abcdef0;\n&ThisIsNotDefined; &hi?; &copy &MadeUpEntity;", "<p>&amp;nbsp &amp;x; &amp;#; &amp;#x;\n&amp;#87654321;\n&amp;#abcdef0;\n&amp;ThisIsNotDefined; &amp;hi?; &amp;copy &amp;MadeUpEntity;</p>\n"),
    ("&#42;foo&#42;\n*foo*\n&#42; foo\n\nfoo&#10;&#10;bar", "<p>*foo*\n<em>foo</em>\n* foo</p>\n<p>foo\n\nbar</p>\n"),
    ("&lt;&gt;&quot;&amp;&apos; `f&ouml;&ouml;` &a1; &Aacute", "<p>&lt;&gt;&quot;&amp;' <code>f&amp;ouml;&amp;ouml;</code> &amp;a1; &amp;Aacute</p>\n"),
    ("&AElig;&zwnj;&CounterClockwiseContourIntegral;&CounterClockwiseContourIntegralX; &b.; &x1;", "<p>Æ\u{200C}∳&amp;CounterClockwiseContourIntegralX; &amp;b.; &amp;x1;</p>\n"),
    ("[foo](/f&ouml;&ouml; \"f&ouml;&ouml;\") [b](&#92;*) [c](\\&amp;)", "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a> <a href=\"*\">b</a> <a href=\"&amp;\">c</a></p>\n"),
    ("``` f&ouml;&ouml;&#32;x\nfoo\n```", "<pre><code class=\"language-föö\">foo\n</code></pre>\n"),
  ]);
}

// code spans
function test_code_spans(): test.TestOutcome {
  return checks([
    ("`foo` `` foo ` bar `` ` `` ` `  ``  `", "<p><code>foo</code> <code>foo ` bar</code> <code>``</code> <code> `` </code></p>\n"),
    ("` a` ` b `\n` `\n`  `", "<p><code> a</code> <code>b</code>\n<code> </code>\n<code>  </code></p>\n"),
    ("``\nfoo\nbar  \nbaz\n``", "<p><code>foo bar   baz</code></p>\n"),
    ("`foo   bar \nbaz` `foo\\`bar` ``foo`bar``", "<p><code>foo   bar  baz</code> <code>foo\\</code>bar<code> ``foo</code>bar``</p>\n"),
    ("*foo`*` [not a `link](/foo`) `<a href=\"`\">` <a href=\"`\">`", "<p>*foo<code>*</code> [not a <code>link](/foo</code>) <code>&lt;a href=&quot;</code>&quot;&gt;<code> &lt;a href=&quot;</code>&quot;&gt;`</p>\n"),
    ("```foo`` `foo `foo``bar``", "<p>```foo<code> `foo `foo</code>bar``</p>\n"),
    ("> `a\n> b`\n\n- `c\n  d`", "<blockquote>\n<p><code>a b</code></p>\n</blockquote>\n<ul>\n<li><code>c d</code></li>\n</ul>\n"),
  ]);
}

// emphasis and strong emphasis
function test_emphasis(): test.TestOutcome {
  return checks([
    ("*foo bar* a * foo bar* a*\"foo\"* * a * foo*bar* 5*6*78", "<p><em>foo bar</em> a * foo bar* a*&quot;foo&quot;* * a * foo<em>bar</em> 5<em>6</em>78</p>\n"),
    ("_foo bar_ _ foo bar_ foo_bar_ 5_6_78 пристаням_стремятся_ aa_\"bb\"_cc foo-_(bar)_", "<p><em>foo bar</em> _ foo bar_ foo_bar_ 5_6_78 пристаням_стремятся_ aa_&quot;bb&quot;<em>cc foo-</em>(bar)_</p>\n"),
    ("*foo**bar**baz* ***foo** bar* *foo**bar*** foo***bar***baz foo******bar*********baz", "<p><em>foo<strong>bar</strong>baz</em> <em><strong>foo</strong> bar</em> <em>foo<strong>bar</strong></em> foo<em><strong>bar</strong></em>baz foo<strong><strong><strong>bar</strong></strong></strong>***baz</p>\n"),
    ("**foo*bar*baz** *foo**bar* **foo*bar** __foo, __bar__, baz__ __foo_bar__", "<p><strong>foo<em>bar</em>baz</strong> <em>foo**bar</em> <strong>foo*bar</strong> <strong>foo, <strong>bar</strong>, baz</strong> <strong>foo_bar</strong></p>\n"),
    ("*(**foo**)* **Gomphocarpus (*Gomphocarpus physocarpus*, syn.\n*Asclepias physocarpa*)**", "<p><em>(<strong>foo</strong>)</em> <strong>Gomphocarpus (<em>Gomphocarpus physocarpus</em>, syn.\n<em>Asclepias physocarpa</em>)</strong></p>\n"),
    ("*foo _bar* baz_ **foo*bar baz* _foo __bar_ baz__ *a `*`* _a `_`_ **a<http://foo.bar/?q=**>", "<p><em>foo _bar</em> baz_ **foo<em>bar baz</em> <em>foo <em><em>bar</em> baz</em></em> <em>a <code>*</code></em> <em>a <code>_</code></em> **a<a href=\"http://foo.bar/?q=**\">http://foo.bar/?q=**</a></p>\n"),
    ("***foo*** _____foo_____ ****foo* **foo* *foo**** ***foo** foo *foo**", "<p><em><strong>foo</strong></em> <em><strong><strong>foo</strong></strong></em> *<strong><em>foo</em> <em><em>foo</em> <em>foo</em></em></strong> <em><strong>foo</strong> foo <em>foo</em></em></p>\n"),
    ("*a\nb*\n\n_a\n> b_", "<p><em>a\nb</em></p>\n<p>_a</p>\n<blockquote>\n<p>b_</p>\n</blockquote>\n"),
  ]);
}

// links
function test_links(): test.TestOutcome {
  return checks([
    ("[link](/uri \"title\") [link](/uri 'title') [link](/uri (title)) [link]() [link](<>) [](./target.md)", "<p><a href=\"/uri\" title=\"title\">link</a> <a href=\"/uri\" title=\"title\">link</a> <a href=\"/uri\" title=\"title\">link</a> <a href=\"\">link</a> <a href=\"\">link</a> <a href=\"./target.md\"></a></p>\n"),
    ("[link](/my uri) [link](</my uri>) [a](<b)c>) [link](\\(foo\\)) [link](foo(and(bar))) [link](foo(and(bar)) [link](foo\\)\\:)", "<p>[link](/my uri) <a href=\"/my%20uri\">link</a> <a href=\"b)c\">a</a> <a href=\"(foo)\">link</a> <a href=\"foo(and(bar))\">link</a> [link](foo(and(bar)) <a href=\"foo):\">link</a></p>\n"),
    ("[link](#fragment) [link](https://example.com#fragment) [link](foo\\bar) [link](foo%20b&auml;) [link](\"title\")", "<p><a href=\"#fragment\">link</a> <a href=\"https://example.com#fragment\">link</a> <a href=\"foo%5Cbar\">link</a> <a href=\"foo%20b%C3%A4\">link</a> <a href=\"%22title%22\">link</a></p>\n"),
    ("[link](   /uri\n  \"title\"  ) [link] (/uri) [link [foo [bar]]](/uri) [link] bar](/uri) [link [bar](/uri)", "<p><a href=\"/uri\" title=\"title\">link</a> [link] (/uri) <a href=\"/uri\">link [foo [bar]]</a> [link] bar](/uri) [link <a href=\"/uri\">bar</a></p>\n"),
    ("[link *foo **bar** `#`*](/uri) [![moon](moon.jpg)](/uri) [foo [bar](/uri)](/uri) [foo *[bar [baz](/uri)](/uri)*](/uri)", "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a> <a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a> [foo <a href=\"/uri\">bar</a>](/uri) [foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>\n"),
    ("*[foo*](/uri) [foo *bar](baz*) [foo`](/uri)` [foo<http://example.com/?search=](uri)>", "<p>*<a href=\"/uri\">foo*</a> <a href=\"baz*\">foo *bar</a> [foo<code>](/uri)</code> [foo<a href=\"http://example.com/?search=%5D(uri)\">http://example.com/?search=](uri)</a></p>\n"),
    ("[foo][bar] [Foo][BAR] [ẞ][] [Bar][ ] [foo] [foo][] [*foo* bar] [bar]x [baz][bar\\]]\n\n[bar]: /url \"title\"\n[foo]: /f\n[SS]: /ss\n[*foo* bar]: /e\n[bar\\]]: /esc", "<p><a href=\"/url\" title=\"title\">foo</a> <a href=\"/url\" title=\"title\">Foo</a> <a href=\"/ss\">ẞ</a> <a href=\"/url\" title=\"title\">Bar</a> <a href=\"/f\">foo</a> <a href=\"/f\">foo</a> <a href=\"/e\"><em>foo</em> bar</a> <a href=\"/url\" title=\"title\">bar</a>x <a href=\"/esc\">baz</a></p>\n"),
    ("[foo] bar\n[foo]\n[bar][foo\\!]\n[foo!]\n\n[foo]: /url1\n[foo!]: /url3", "<p><a href=\"/url1\">foo</a> bar\n<a href=\"/url1\">foo</a>\n[bar][foo!]\n<a href=\"/url3\">foo!</a></p>\n"),
    ("[a](/u \"x\\\") [b](/u \"x\\\" y) [c](< b >) [d](/u\n'multi\nline') [e](/u \"\")", "<p>[a](/u &quot;x&quot;) [b](/u &quot;x&quot; y) <a href=\"b\">c</a> <a href=\"/u\" title=\"multi\nline\">d</a> <a href=\"/u\" title=\"\">e</a></p>\n"),
    ("[a](/u?a=b&c=d) [b](a'b) [c](<a\"b>) [d](/fö) [e](\\[\\]) [f](</a\\>b>)", "<p><a href=\"/u?a=b&amp;c=d\">a</a> <a href=\"a&#x27;b\">b</a> <a href=\"a%22b\">c</a> <a href=\"/f%C3%B6\">d</a> <a href=\"%5B%5D\">e</a> <a href=\"/a%3Eb\">f</a></p>\n"),
    ("[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2", "<p>[foo]<a href=\"/url1\">bar</a></p>\n"),
  ]);
}

// images
function test_images(): test.TestOutcome {
  return checks([
    ("![foo](/url \"title\") ![foo *bar*](train.jpg \"tr*ai*n\") ![foo ![bar](/url)](/url2) ![foo [bar](/url)](/url2)", "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /> <img src=\"train.jpg\" alt=\"foo bar\" title=\"tr*ai*n\" /> <img src=\"/url2\" alt=\"foo bar\" /> <img src=\"/url2\" alt=\"foo bar\" /></p>\n"),
    ("![a *b* `c` <i>d</i> [e](f) ![g](h) &amp; \\*](i \"j\") ![a\nb  \nc\\\nd](e)", "<p><img src=\"i\" alt=\"a b c &lt;i&gt;d&lt;/i&gt; e g &amp; *\" title=\"j\" /> <img src=\"e\" alt=\"a b c d\" /></p>\n"),
    ("![foo *bar*][] ![Foo][] ![foo] ![[foo]] \\![foo] !\\[foo]\n\n[foo *bar*]: train.jpg \"train & tracks\"\n[foo]: /url", "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /> <img src=\"/url\" alt=\"Foo\" /> <img src=\"/url\" alt=\"foo\" /> ![<a href=\"/url\">foo</a>] !<a href=\"/url\">foo</a> ![foo]</p>\n"),
    ("![<http://a.b> <x@y.z>](/u) ![](/u) ![a](<>)", "<p><img src=\"/u\" alt=\"http://a.b x@y.z\" /> <img src=\"/u\" alt=\"\" /> <img src=\"\" alt=\"a\" /></p>\n"),
  ]);
}

// autolinks
function test_autolinks(): test.TestOutcome {
  return checks([
    ("<http://foo.bar.baz> <https://foo.bar.baz/test?q=hello&id=22&boolean> <irc://foo.bar:2233/baz>", "<p><a href=\"http://foo.bar.baz\">http://foo.bar.baz</a> <a href=\"https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean\">https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean</a> <a href=\"irc://foo.bar:2233/baz\">irc://foo.bar:2233/baz</a></p>\n"),
    ("<MAILTO:FOO@BAR.BAZ> <a+b+c:d> <made-up-scheme://foo,bar> <https://../> <localhost:5001/foo>", "<p><a href=\"MAILTO:FOO@BAR.BAZ\">MAILTO:FOO@BAR.BAZ</a> <a href=\"a+b+c:d\">a+b+c:d</a> <a href=\"made-up-scheme://foo,bar\">made-up-scheme://foo,bar</a> <a href=\"https://../\">https://../</a> <a href=\"localhost:5001/foo\">localhost:5001/foo</a></p>\n"),
    ("<https://foo.bar/baz bim> <https://example.com/\\[\\> <foo@bar.example.com> <foo+special@Bar.baz-bar0.com>", "<p>&lt;https://foo.bar/baz bim&gt; <a href=\"https://example.com/%5C%5B%5C\">https://example.com/\\[\\</a> <a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a> <a href=\"mailto:foo+special@Bar.baz-bar0.com\">foo+special@Bar.baz-bar0.com</a></p>\n"),
    ("<foo\\+@bar.example.com> <> < https://foo.bar > <m:abc> <foo.bar.baz> https://example.com foo@bar.example.com", "<p>&lt;foo+@bar.example.com&gt; &lt;&gt; &lt; https://foo.bar &gt; &lt;m:abc&gt; &lt;foo.bar.baz&gt; https://example.com foo@bar.example.com</p>\n"),
    ("<http://a&amp;b&ouml;> <x@y-.z> <x@-y.z> <a@b.c.> <ab:c> <aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:b> <aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:b>", "<p><a href=\"http://a&amp;b%C3%B6\">http://a&amp;bö</a> &lt;x@y-.z&gt; &lt;x@-y.z&gt; &lt;a@b.c.&gt; <a href=\"ab:c\">ab:c</a> <a href=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:b\">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:b</a> &lt;aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:b&gt;</p>\n"),
  ]);
}

// raw HTML
function test_raw_html(): test.TestOutcome {
  return checks([
    ("<a><bab><c2c> <a/><b2/> <a  /><b2\ndata=\"foo\" > <a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 />", "<p><a><bab><c2c> <a/><b2/> <a  /><b2\ndata=\"foo\" > <a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 /></p>\n"),
    ("Foo <responsive-image src=\"foo.jpg\" /> <33> <__> <a h*#ref=\"hi\"> <a href=\"hi'> <a href=hi'> < a><\nfoo><bar/ > <foo bar=baz\nbim!bop />", "<p>Foo <responsive-image src=\"foo.jpg\" /> &lt;33&gt; &lt;__&gt; &lt;a h*#ref=&quot;hi&quot;&gt; &lt;a href=&quot;hi'&gt; &lt;a href=hi'&gt; &lt; a&gt;&lt;\nfoo&gt;&lt;bar/ &gt; &lt;foo bar=baz\nbim!bop /&gt;</p>\n"),
    ("<a href='bar'title=title> </a></foo > </a href=\"foo\"> foo <?php echo $a; ?> foo <!ELEMENT br EMPTY>", "<p>&lt;a href='bar'title=title&gt; </a></foo > &lt;/a href=&quot;foo&quot;&gt; foo <?php echo $a; ?> foo <!ELEMENT br EMPTY></p>\n"),
    ("foo <![CDATA[>&<]]> foo <a href=\"&ouml;\"> foo <a href=\"\\*\"> <a href=\"\\\"\"> a <![cdata[x]]> b <?x <!X", "<p>foo <![CDATA[>&<]]> foo <a href=\"&ouml;\"> foo <a href=\"\\*\"> &lt;a href=&quot;&quot;&quot;&gt; a <![cdata[x]]> b &lt;?x &lt;!X</p>\n"),
  ]);
}

// hard and soft line breaks
function test_line_breaks(): test.TestOutcome {
  return checks([
    ("foo  \nbaz", "<p>foo<br />\nbaz</p>\n"),
    ("foo\\\nbaz", "<p>foo<br />\nbaz</p>\n"),
    ("foo       \nbaz", "<p>foo<br />\nbaz</p>\n"),
    ("foo  \n     bar", "<p>foo<br />\nbar</p>\n"),
    ("foo\\\n     bar", "<p>foo<br />\nbar</p>\n"),
    ("*foo  \nbar* *foo\\\nbar*", "<p><em>foo<br />\nbar</em> <em>foo<br />\nbar</em></p>\n"),
    ("`code  \nspan` `code\\\nspan`", "<p><code>code   span</code> <code>code\\ span</code></p>\n"),
    ("<a href=\"foo  \nbar\"> <a href=\"foo\\\nbar\">", "<p><a href=\"foo  \nbar\"> <a href=\"foo\\\nbar\"></p>\n"),
    ("foo\\", "<p>foo\\</p>\n"),
    ("foo  ", "<p>foo</p>\n"),
    ("### foo\\", "<h3>foo\\</h3>\n"),
    ("### foo  ", "<h3>foo</h3>\n"),
    ("foo \nbaz", "<p>foo\nbaz</p>\n"),
    ("foo\t\nbar \t \nbaz", "<p>foo\nbar\nbaz</p>\n"),
    ("a\\  \nb", "<p>a\\<br />\nb</p>\n"),
    ("&amp;  \nb", "<p>&amp;<br />\nb</p>\n"),
    ("> a  \n>   b\n\n- c\\\n  d", "<blockquote>\n<p>a<br />\nb</p>\n</blockquote>\n<ul>\n<li>c<br />\nd</li>\n</ul>\n"),
  ]);
}

// Where spec 0.31.2 and cmark 0.30.2 do not agree, the port follows the
// spec. cmark keeps one bottom for the openers of all `_` closers. It does
// not count a symbol such as `£` as punctuation. It has the comments and
// declarations of spec 0.30. It keeps the title of a definition when the
// title is not the end of its line, and the line is text.
function test_spec_over_cmark(): test.TestOutcome {
  return checks([
    ("__)_>__", "<p><strong>)_&gt;</strong></p>\n"),
    ("_a*_*b_ *£*bravo. *€*charlie.", "<p><em>a*</em>*b_ *£*bravo. *€*charlie.</p>\n"),
    ("foo <!-- this is a --\ncomment - with hyphens --> <!--> a --> <!---> b -->", "<p>foo <!-- this is a --\ncomment - with hyphens --> <!--> a --&gt; <!---> b --&gt;</p>\n"),
    ("a <!doctype x> b", "<p>a <!doctype x> b</p>\n"),
    ("[a]: /u\n\"t\" x\n\n[a]", "<p>&quot;t&quot; x</p>\n<p><a href=\"/u\">a</a></p>\n"),
  ]);
}

function main(): i32 {
  let r = test.new("markdown");
  r = r.it("paragraphs, escapes and line breaks", test_paragraphs);
  r = r.it("ATX and setext headings", test_headings);
  r = r.it("thematic breaks", test_rules);
  r = r.it("indented and fenced code blocks", test_code);
  r = r.it("block quotes", test_quotes);
  r = r.it("lists and list items", test_lists);
  r = r.it("tabs", test_tabs);
  r = r.it("HTML blocks", test_html_blocks);
  r = r.it("the block tree of text that needs inlines", test_block_shapes);
  r = r.it("details that cmark gives", test_cmark_details);
  r = r.it("a byte order mark", test_bom);
  r = r.it("link reference definitions", test_definitions);
  r = r.it("label normalization", test_normalize);
  r = r.it("tags and HTML block conditions", test_tags);
  r = r.it("backslash unescaping", test_unescape);
  r = r.it("link titles and destinations", test_titles);
  r = r.it("backslash escapes and entity references", test_escapes);
  r = r.it("code spans", test_code_spans);
  r = r.it("emphasis and strong emphasis", test_emphasis);
  r = r.it("links", test_links);
  r = r.it("images", test_images);
  r = r.it("autolinks", test_autolinks);
  r = r.it("raw HTML", test_raw_html);
  r = r.it("hard and soft line breaks", test_line_breaks);
  r = r.it("spec 0.31.2 where cmark 0.30.2 differs", test_spec_over_cmark);
  return r.finish();
}
